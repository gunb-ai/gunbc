module gunbc.host.bmc_cold_reset

import std.types { Bool, Int, NonEmptyStr, String }
import std.optional { Present, Absent, Optional }
import extdeps.bmc.ipmi_chassis_control { ChassisPowerObservation, ChassisPowerRead, ChassisStatusUndecodable, ChassisUnreadable, chassis_observation_text }
import extdeps.bmc.ipmitool_mc_info { IpmiMcInfoReport, McInfoReported, McInfoUnreadable, ipmitool_mc_info_of, ipmitool_mc_info_firmware_text }
import std.algebra { trim }
import std.measure { Millisecond, millisecond_count, MeasureSubtraction, MeasureDifference, MeasureSubtrahendExceedsMinuend, measure_sub, measure_le }
import extdeps.linux.proc_uptime { ProcUptimeRead, UptimeObserved, UptimeRefused }
import extdeps.bmc.ipmi_session { IpmitoolReadDeadlineExpired, ipmitool_read_failure, ipmitool_lanplus_stderr_shows_an_answer, ipmitool_lanplus_verbose_no_answer_stage, IpmitoolVerbosity, IpmitoolDefaultVerbosity, IpmitoolVerboseOnce }
import extdeps.bmc.ipmitool_mc_reset { IpmitoolMcResetColdReply, McResetColdReportedSent, McResetColdExitedNonzero, McResetColdUnrecognised, ipmitool_mc_reset_cold_reply_text }

// A CONTROLLER COLD RESET ATTEMPT, JUDGED. The pure half of a cold reset (extdeps.bmc.ipmi McResetCold): what one
// mc info poll says, how the watch decides that the controller's availability was lost, then recovered within a
// bound, then STAYED available through a declared window, and what the two endpoint power readings make of it. Nothing here performs a read; a unit's route supplies
// parsed live readings (gunbc.machine_intake.mtcollins1_bmc_cold_reset), and the bound is that unit's policy.
//
// WHAT THE STRONGEST RESULT CLAIMS, AND WHAT IT DOES NOT. ipmitool's reply only says what ipmitool reported
// (extdeps.bmc.ipmitool_mc_reset). The strongest outcome here is that the controller answered available before the
// attempt, was observed to lose availability after it (no response, or a decoded report of initialization), answered
// available again, and then answered available on every poll until the sustained window had elapsed, with host power
// read the same at both endpoints. That is a RECOVERY AFTER THE ATTEMPT, SUSTAINED THROUGH THE WINDOW:
// it is not a proof that the controller restarted, and two equal endpoint power readings cannot see an off-on cycle
// between them. IPMI v2.0 §20.2 promises neither an unaffected host nor an observable outage, so none is claimed.
//
// WHY ONE ANSWER IS NOT ENOUGH (gunbc#16659). Run 44210890542 was accepted on one loss followed by one answering poll,
// and about 45 min later (run 44217632446) the controller was silent again on RMCP+. One answer observes that the
// controller came back; it does not observe that it stays. So the watch has a third phase: after the recovering
// answer, every poll must answer available until the window has ELAPSED on a monotonic clock (side chat on
// gunbc#16668: the window is a span of time, and a count of polls is a span only as long as the polls happen to
// take). A missing response or an initializing report inside it is RecoveredThenLost; a failed probe or an
// undecodable answer inside it establishes nothing and refuses as SustainNotEstablished; a clock that cannot be read
// or reads earlier than before is ClockNotEstablished, and a poll count never stands in for it. The window's length is
// the consumer's need, the unit's policy (for mtcollins1, one boot's controller-dependent span:
// gunbc.machine_intake.mtcollins1_bmc_cold_reset mtcollins1_bmc_cold_reset_sustain_window).
// A controller that stays up through the window and relapses after it IS accepted, by design: the verdict says the
// controller held for that span, and it is not a statement that the controller is healthy.

// HOW LONG THE WATCH WAITS: in polls, for the controller's availability to be lost after the attempt and then to
// recover; in TIME, the sustained window after the recovering answer. Which bounds a unit uses is that unit's policy.
// sustain_polls_at_most is NOT a second measure of the window: the window ends only by elapsed time, and a watch that
// reaches this many window polls without the window having elapsed refuses (its clock advanced less than its paced
// polls did), so the ceiling only terminates the loop. The window is never empty: the sustained phase ends on its
// first answer at the earliest, so a zero window cannot restore the one-answer acceptance.
type ColdResetWatchBounds { drop_polls: Int, answer_polls: Int, sustain: Millisecond, sustain_polls_at_most: Int }

// ── ONE POLL, PARSED ─────────────────────────────────────────────────────────────────────────────
// Four distinct observations, kept apart because they support different conclusions:
// - ControllerAvailable: mc info exited 0 with a decodable report saying Device Available: yes.
// - ControllerInitializing: a decodable report saying Device Available: no. The controller ANSWERED and said it is
//   not ready; that is a loss of availability, not a missing response.
// - ControllerNoResponse: mc info failed in a way that EVIDENCES no answer, and no stderr line shows an answer
//   (extdeps.bmc.ipmi_session ipmitool_lanplus_stderr_shows_an_answer, checked FIRST for every failed poll): ipmitool
//   -v named a stage of the lanplus open that got no reply (ipmitool_lanplus_verbose_no_answer_stage), or, on a read
//   at the DEFAULT verbosity, the read deadline expired (ipmitool_read_failure). An answered line beside exit 124 is a
//   failed probe: the deadline expired after the controller answered.
// - ControllerProbeFailed: mc info failed for any other reason -- the bare "Unable to establish" line naming no
//   stage, a refused credential, a completion code, a local exec failure, and a -v read killed at its deadline with
//   neither an answered line nor a stage line. A failed COMMAND is not a silent CONTROLLER, so it is evidence of
//   neither a loss nor a recovery.
// - ControllerUndecodable: mc info exited 0 but its output did not decode. A response WAS received and could not be
//   read, so it is evidence of neither a loss nor a recovery.
type ColdResetPoll
  = ControllerAvailable { report: IpmiMcInfoReport }
  | ControllerInitializing { report: IpmiMcInfoReport }
  | ControllerNoResponse { cause: NonEmptyStr }
  | ControllerProbeFailed { exit_code: Int, cause: NonEmptyStr }
  | ControllerUndecodable { cause: NonEmptyStr }

fn cold_reset_poll_of(verbosity: IpmitoolVerbosity, success: Bool, exit_code: Int, stdout: String, stderr: String) -> ColdResetPoll {
  if success == false {
    cold_reset_failed_poll(verbosity: verbosity, exit_code: exit_code, stderr: stderr)
  } else {
    match ipmitool_mc_info_of(stdout: stdout) {
      McInfoUnreadable { cause: c } => ControllerUndecodable { cause: join(["mc info exited 0 but did not decode: ", c as String], "") as NonEmptyStr }
      McInfoReported { report: r } =>
        if r.device_available { ControllerAvailable { report: r } } else { ControllerInitializing { report: r } }
    }
  }
}

// A FAILED mc info. Any line showing the controller answered makes it a failed probe, whatever the exit code;
// otherwise a -v stage line naming an unanswered stage becomes ControllerNoResponse, and so does an expired read
// deadline on a read at the default verbosity. Everything else is a failed probe, with ipmitool's stderr kept in the
// cause.
//
// THE -v DEADLINE RULE (decision X on gunbc#16529, msg_4588a441). A -v read runs under the watch-poll row
// (gunbc.machine_intake.bmc_read_policy bmc_ipmi_watch_poll_retry_bound), whose derivation shows a SILENT controller
// ends that read inside the deadline on the stage line naming what went unanswered. So a -v read killed at its
// deadline with neither an answered line nor a stage line was not a silent controller: it is a controller answering
// too slowly to finish, which is a failed probe and never a loss -- reading it as a loss lets a slow controller that
// never reset reach an accepted recovery on its next answer. A read at the default verbosity prints no stage line,
// so for it an expired deadline stays the missing response it is in this unit's capture
// (artifacts/bmc/mtcollins1-boot-run-43040335415/mtcollins1-boot-diagnostics.txt, "exit=124 stdout=[] stderr=[]").
fn cold_reset_failed_poll(verbosity: IpmitoolVerbosity, exit_code: Int, stderr: String) -> ColdResetPoll {
  let said = if trim(s: stderr) == "" { "no stderr" } else { trim(s: stderr) }
  let code = to_string(exit_code)
  if ipmitool_lanplus_stderr_shows_an_answer(stderr: stderr) {
    ControllerProbeFailed { exit_code: exit_code, cause: join(["mc info failed after the controller answered (exit ", code, "): ", said], "") as NonEmptyStr }
  } else {
    match ipmitool_read_failure(exit_code: exit_code, stderr: stderr) {
      IpmitoolReadDeadlineExpired =>
        match verbosity {
          IpmitoolDefaultVerbosity => ControllerNoResponse { cause: join(["mc info got no answer within its read deadline (timeout exit ", code, ")"], "") as NonEmptyStr }
          IpmitoolVerboseOnce =>
            match ipmitool_lanplus_verbose_no_answer_stage(stderr: stderr) {
              Present { value: stage } => ControllerNoResponse { cause: join([stage as String, " (exit ", code, "): ", said], "") as NonEmptyStr }
              Absent => ControllerProbeFailed { exit_code: exit_code, cause: join(["-v mc info reached its read deadline with neither an answered line nor an unanswered stage (timeout exit ", code, "): ", said], "") as NonEmptyStr }
            }
        }
      _ =>
        match ipmitool_lanplus_verbose_no_answer_stage(stderr: stderr) {
          Present { value: stage } => ControllerNoResponse { cause: join([stage as String, " (exit ", code, "): ", said], "") as NonEmptyStr }
          Absent => ControllerProbeFailed { exit_code: exit_code, cause: join(["mc info failed without naming an unanswered stage (exit ", code, "): ", said], "") as NonEmptyStr }
        }
    }
  }
}

fn cold_reset_poll_available(poll: ColdResetPoll) -> Bool {
  match poll {
    ControllerAvailable { report: _ } => true
    _ => false
  }
}

fn cold_reset_poll_text(poll: ColdResetPoll) -> String {
  match poll {
    ControllerAvailable { report: r } => join(["available, firmware ", ipmitool_mc_info_firmware_text(report: r) as String], "")
    ControllerInitializing { report: r } => join(["answered Device Available: no (initializing), firmware ", ipmitool_mc_info_firmware_text(report: r) as String], "")
    ControllerNoResponse { cause: c } => concat("no response: ", c as String)
    ControllerProbeFailed { exit_code: _, cause: c } => concat("probe failed: ", c as String)
    ControllerUndecodable { cause: c } => concat("undecodable: ", c as String)
  }
}

// THE BASELINE AS THE RECEIPT STATES IT. Only a decoded available report establishes the baseline; anything else is
// stated as availability NOT ESTABLISHED, never as the controller being unavailable, because a failed or unreadable
// probe does not say the controller was down.
fn cold_reset_baseline_text(poll: ColdResetPoll) -> String {
  if cold_reset_poll_available(poll: poll) {
    cold_reset_poll_text(poll: poll)
  } else {
    join(["baseline availability was not established (", cold_reset_poll_text(poll: poll), ")"], "")
  }
}

// ── THE WATCH: availability lost, then recovered, then sustained ─────────────────────────────────────────────────
// THE LOSS THAT WAS OBSERVED, retained so the conclusion carries the observation that supports it.
type ColdResetLoss
  = LossNoResponse { cause: NonEmptyStr }
  | LossInitializing { report: IpmiMcInfoReport }

fn cold_reset_loss_text(loss: ColdResetLoss) -> String {
  match loss {
    LossNoResponse { cause: c } => concat("no response (", concat(c as String, ")"))
    LossInitializing { report: _ } => "a decoded report of Device Available: no"
  }
}

type ColdResetWatch
  = WatchingForLoss { polls: Int }
  | WatchingForRecovery { polls_to_loss: Int, loss: ColdResetLoss, polls: Int }
  | WatchingSustained { polls_to_loss: Int, loss: ColdResetLoss, polls_to_recovery: Int, since: Millisecond, polls: Int }

type ColdResetWatchEnd
  = WatchRecoveredSustained { polls_to_loss: Int, loss: ColdResetLoss, polls_to_recovery: Int, sustained_polls: Int, elapsed: Millisecond, report: IpmiMcInfoReport }
  | WatchRecoveredThenLost { polls_to_loss: Int, loss: ColdResetLoss, polls_to_recovery: Int, answered_polls: Int, relapse: ColdResetLoss }
  | WatchSustainNotEstablished { polls_to_loss: Int, loss: ColdResetLoss, polls_to_recovery: Int, answered_polls: Int, last: ColdResetPoll }
  | WatchLossNotObserved { polls: Int, last: ColdResetPoll }
  | WatchRecoveryNotObserved { polls_to_loss: Int, loss: ColdResetLoss, polls: Int, last: ColdResetPoll }
  | WatchPacingNotEstablished { watch: ColdResetWatch }
  | WatchClockNotEstablished { watch: ColdResetWatch, detail: String }

// THE PACING IS PART OF WHAT THE WATCH OBSERVES (side chat on gunbc#16668, F1). The loss and recovery bounds are
// counts of polls, which mean the time a controller is given only because the route sleeps its poll interval before
// each poll; and the window's clock is only meaningful beside polls that are spaced. So the route reads each pacing
// sleep's result before the poll it paces, and a sleep that failed ends the watch here, in whatever phase it was,
// keeping what had been observed; it is never followed by an unpaced poll. In the loss and recovery phases an unpaced
// poll could only shorten a wait into a refusal, but it would name the wrong cause, so every phase ends the same way.
fn cold_reset_watch_text(watch: ColdResetWatch) -> String {
  match watch {
    WatchingForLoss { polls: n } => join(["watching for a loss of availability, ", to_string(n), " poll(s) taken"], "")
    WatchingForRecovery { polls_to_loss: d, loss: l, polls: n } => join(["availability lost after ", to_string(d), " poll(s) (", cold_reset_loss_text(loss: l), "), ", to_string(n), " poll(s) into the recovery wait"], "")
    WatchingSustained { polls_to_loss: d, loss: l, polls_to_recovery: a, since: _, polls: n } => join(["availability lost after ", to_string(d), " poll(s) (", cold_reset_loss_text(loss: l), "), available again after ", to_string(a), " more, ", to_string(n), " answer(s) into the window"], "")
  }
}

type ColdResetWatchStep
  = WatchContinues { watch: ColdResetWatch }
  | WatchEnded { end: ColdResetWatchEnd }

data cold_reset_watch_start: ColdResetWatch = WatchingForLoss { polls: 0 }

// An undecodable poll or a failed probe establishes nothing in the first two phases: it is counted against the
// phase's bound and the watch goes on. Only an evidenced missing response or a decoded initializing report
// establishes the loss, and only a decoded available report establishes the recovery. In the sustained phase every
// poll must be a decoded available report: the same evidence that established the loss, seen again, is a relapse,
// and a poll that establishes nothing ends the window unestablished rather than being skipped, because the window
// claims an answer at each of its polls.
//
// THE WINDOW'S TWO CLOCK READINGS. The route reads the monotonic clock just BEFORE each poll and just AFTER it. The
// window starts at the reading AFTER the recovering poll (no earlier than that answer) and each window poll is timed by
// the reading BEFORE it (no later than its answer), so `before - since >= sustain` bounds the span between the two
// answers from below: the window is never credited with time that is not between them. A refused reading, or one
// earlier than the start, ends the watch as ClockNotEstablished.
fn cold_reset_uptime(read: ProcUptimeRead) -> Millisecond? {
  match read {
    UptimeObserved { uptime: u } => Present { value: u }
    UptimeRefused { detail: _ } => none
  }
}

fn cold_reset_ms_text(m: Millisecond) -> String { concat(to_string(millisecond_count(m: m)), " ms") }

fn cold_reset_uptime_refusal(read: ProcUptimeRead) -> String {
  match read {
    UptimeObserved { uptime: _ } => "the clock was read"
    UptimeRefused { detail: d } => concat("the monotonic clock could not be read: ", d)
  }
}

fn cold_reset_watch_step(watch: ColdResetWatch, poll: ColdResetPoll, before: ProcUptimeRead, after: ProcUptimeRead, bounds: ColdResetWatchBounds) -> ColdResetWatchStep {
  match watch {
    WatchingForLoss { polls: n } =>
      match poll {
        ControllerNoResponse { cause: c } => WatchContinues { watch: WatchingForRecovery { polls_to_loss: n + 1, loss: LossNoResponse { cause: c }, polls: 0 } }
        ControllerInitializing { report: r } => WatchContinues { watch: WatchingForRecovery { polls_to_loss: n + 1, loss: LossInitializing { report: r }, polls: 0 } }
        _ =>
          if n + 1 >= bounds.drop_polls {
            WatchEnded { end: WatchLossNotObserved { polls: n + 1, last: poll } }
          } else {
            WatchContinues { watch: WatchingForLoss { polls: n + 1 } }
          }
      }
    WatchingForRecovery { polls_to_loss: d, loss: l, polls: n } =>
      match poll {
        ControllerAvailable { report: _ } =>
          match cold_reset_uptime(read: after) {
            Absent => WatchEnded { end: WatchClockNotEstablished { watch: watch, detail: concat("at the recovering answer, ", cold_reset_uptime_refusal(read: after)) } }
            Present { value: t } => WatchContinues { watch: WatchingSustained { polls_to_loss: d, loss: l, polls_to_recovery: n + 1, since: t, polls: 0 } }
          }
        _ =>
          if n + 1 >= bounds.answer_polls {
            WatchEnded { end: WatchRecoveryNotObserved { polls_to_loss: d, loss: l, polls: n + 1, last: poll } }
          } else {
            WatchContinues { watch: WatchingForRecovery { polls_to_loss: d, loss: l, polls: n + 1 } }
          }
      }
    WatchingSustained { polls_to_loss: d, loss: l, polls_to_recovery: a, since: t0, polls: n } =>
      match poll {
        ControllerAvailable { report: r } =>
          match cold_reset_uptime(read: before) {
            Absent => WatchEnded { end: WatchClockNotEstablished { watch: watch, detail: concat("before a window poll, ", cold_reset_uptime_refusal(read: before)) } }
            Present { value: t } =>
              match measure_sub(a: t, b: t0) {
                MeasureSubtrahendExceedsMinuend => WatchEnded { end: WatchClockNotEstablished { watch: watch, detail: join(["the monotonic clock read ", cold_reset_ms_text(m: t), " after the window started at ", cold_reset_ms_text(m: t0)], "") } }
                MeasureDifference { value: e } =>
                  if measure_le(a: bounds.sustain, b: e) {
                    WatchEnded { end: WatchRecoveredSustained { polls_to_loss: d, loss: l, polls_to_recovery: a, sustained_polls: n + 1, elapsed: e, report: r } }
                  } else if n + 1 >= bounds.sustain_polls_at_most {
                    WatchEnded { end: WatchClockNotEstablished { watch: watch, detail: join(["after ", to_string(n + 1), " paced window poll(s) the monotonic clock had advanced only ", cold_reset_ms_text(m: e), " of the window's ", cold_reset_ms_text(m: bounds.sustain)], "") } }
                  } else {
                    WatchContinues { watch: WatchingSustained { polls_to_loss: d, loss: l, polls_to_recovery: a, since: t0, polls: n + 1 } }
                  }
              }
          }
        ControllerNoResponse { cause: c } => WatchEnded { end: WatchRecoveredThenLost { polls_to_loss: d, loss: l, polls_to_recovery: a, answered_polls: n, relapse: LossNoResponse { cause: c } } }
        ControllerInitializing { report: r } => WatchEnded { end: WatchRecoveredThenLost { polls_to_loss: d, loss: l, polls_to_recovery: a, answered_polls: n, relapse: LossInitializing { report: r } } }
        _ => WatchEnded { end: WatchSustainNotEstablished { polls_to_loss: d, loss: l, polls_to_recovery: a, answered_polls: n, last: poll } }
      }
  }
}

// ── THE VERDICT ON THE OBSERVATIONS ──────────────────────────────────────────────────────────────
// - ColdResetSustainedPowerEqual: available before, loss observed, recovery observed, available at every poll of the
//   sustained window, power read the same at both endpoints. The strongest outcome, and still only what the header
//   says it is.
// - ColdResetRecoveredUnattributed: the same, except the controller was NOT available before the attempt, so the
//   observed recovery cannot be attributed to the attempt. Never accepted.
// - ColdResetRecoveredThenLost: the controller came back and was lost again inside the window (gunbc#16659).
// - the rest are refusals, each naming what was and was not observed.
type ColdResetVerdict
  = ColdResetSustainedPowerEqual { power_on: Bool, loss: ColdResetLoss, polls_to_loss: Int, polls_to_recovery: Int, sustained_polls: Int, elapsed: Millisecond, report: IpmiMcInfoReport }
  | ColdResetRecoveredUnattributed { baseline: ColdResetPoll, power_on: Bool, loss: ColdResetLoss, polls_to_loss: Int, polls_to_recovery: Int, sustained_polls: Int }
  | ColdResetRecoveredThenLost { loss: ColdResetLoss, polls_to_loss: Int, polls_to_recovery: Int, answered_polls: Int, relapse: ColdResetLoss }
  | ColdResetSustainNotEstablished { loss: ColdResetLoss, polls_to_loss: Int, polls_to_recovery: Int, answered_polls: Int, last: ColdResetPoll }
  | ColdResetPacingNotEstablished { watch: ColdResetWatch }
  | ColdResetClockNotEstablished { watch: ColdResetWatch, detail: String }
  | ColdResetPowerChanged { before_on: Bool, after_on: Bool }
  | ColdResetPowerUnreadAfter { before_on: Bool, after: ChassisPowerObservation }
  | ColdResetRecoveryNotObserved { loss: ColdResetLoss, polls_to_loss: Int, polls: Int, last: ColdResetPoll }
  | ColdResetLossNotObserved { polls: Int, last: ColdResetPoll }

// The power state after is read only once the watch saw the recovery sustained through the window; a controller that
// was lost again, whose window was not established, or whose watch lost its pacing or its clock, is not read for it.
fn cold_reset_verdict(baseline: ColdResetPoll, before_on: Bool, end: ColdResetWatchEnd, after: ChassisPowerObservation?) -> ColdResetVerdict {
  match end {
    WatchLossNotObserved { polls: n, last: p } => ColdResetLossNotObserved { polls: n, last: p }
    WatchRecoveryNotObserved { polls_to_loss: d, loss: l, polls: n, last: p } => ColdResetRecoveryNotObserved { loss: l, polls_to_loss: d, polls: n, last: p }
    WatchRecoveredThenLost { polls_to_loss: d, loss: l, polls_to_recovery: a, answered_polls: k, relapse: x } => ColdResetRecoveredThenLost { loss: l, polls_to_loss: d, polls_to_recovery: a, answered_polls: k, relapse: x }
    WatchSustainNotEstablished { polls_to_loss: d, loss: l, polls_to_recovery: a, answered_polls: k, last: p } => ColdResetSustainNotEstablished { loss: l, polls_to_loss: d, polls_to_recovery: a, answered_polls: k, last: p }
    WatchPacingNotEstablished { watch: w } => ColdResetPacingNotEstablished { watch: w }
    WatchClockNotEstablished { watch: w, detail: x } => ColdResetClockNotEstablished { watch: w, detail: x }
    WatchRecoveredSustained { polls_to_loss: d, loss: l, polls_to_recovery: a, sustained_polls: k, elapsed: e, report: r } =>
      match after {
        Absent => ColdResetPowerUnreadAfter { before_on: before_on, after: ChassisUnreadable }
        Present { value: obs } =>
          match obs {
            ChassisPowerRead { power_on: p } =>
              if p != before_on {
                ColdResetPowerChanged { before_on: before_on, after_on: p }
              } else if cold_reset_poll_available(poll: baseline) {
                ColdResetSustainedPowerEqual { power_on: p, loss: l, polls_to_loss: d, polls_to_recovery: a, sustained_polls: k, elapsed: e, report: r }
              } else {
                ColdResetRecoveredUnattributed { baseline: baseline, power_on: p, loss: l, polls_to_loss: d, polls_to_recovery: a, sustained_polls: k }
              }
            ChassisStatusUndecodable { cause: _ } => ColdResetPowerUnreadAfter { before_on: before_on, after: obs }
            ChassisUnreadable => ColdResetPowerUnreadAfter { before_on: before_on, after: obs }
          }
      }
  }
}

fn cold_reset_power_text(on: Bool) -> String { if on { "on" } else { "off" } }

fn cold_reset_verdict_text(verdict: ColdResetVerdict) -> String {
  match verdict {
    ColdResetSustainedPowerEqual { power_on: p, loss: l, polls_to_loss: d, polls_to_recovery: a, sustained_polls: k, elapsed: e, report: r } =>
      join(["recovered after the attempt and stayed available through the window: available before; availability lost after ", to_string(d), " poll(s) (", cold_reset_loss_text(loss: l), "); available again after ", to_string(a), " more, then available on all ", to_string(k), " poll(s) of the window over ", cold_reset_ms_text(m: e), " on the monotonic clock (firmware ", ipmitool_mc_info_firmware_text(report: r) as String, "); host power read ", cold_reset_power_text(on: p), " at both endpoints (two readings, which cannot see an off-on cycle between them); availability after the window is not observed"], "")
    ColdResetRecoveredUnattributed { baseline: b, power_on: p, loss: l, polls_to_loss: d, polls_to_recovery: a, sustained_polls: k } =>
      join(["REFUSED: ", cold_reset_baseline_text(poll: b), " before the attempt, so its later recovery (lost after ", to_string(d), " poll(s), ", cold_reset_loss_text(loss: l), "; available after ", to_string(a), " more and on all ", to_string(k), " poll(s) of the window; power ", cold_reset_power_text(on: p), " at both endpoints) is not attributable to the attempt"], "")
    ColdResetRecoveredThenLost { loss: l, polls_to_loss: d, polls_to_recovery: a, answered_polls: k, relapse: x } =>
      join(["REFUSED: RECOVERED THEN LOST: availability lost after ", to_string(d), " poll(s) (", cold_reset_loss_text(loss: l), "), available again after ", to_string(a), " more, then lost again after ", to_string(k), " further answer(s) inside the window (", cold_reset_loss_text(loss: x), ")"], "")
    ColdResetClockNotEstablished { watch: w, detail: x } =>
      join(["REFUSED: the window's monotonic clock was not established (", x, "), and a poll count does not stand in for it; the watch stopped there (", cold_reset_watch_text(watch: w), ")"], "")
    ColdResetPacingNotEstablished { watch: w } =>
      join(["REFUSED: a pacing sleep before a poll failed, so the polls taken did not span the intervals the bounds stand for, and the watch stopped there (", cold_reset_watch_text(watch: w), ")"], "")
    ColdResetSustainNotEstablished { loss: l, polls_to_loss: d, polls_to_recovery: a, answered_polls: k, last: p } =>
      join(["REFUSED: availability lost after ", to_string(d), " poll(s) (", cold_reset_loss_text(loss: l), ") and available again after ", to_string(a), " more, but the window was not established: after ", to_string(k), " further answer(s) a poll established nothing (", cold_reset_poll_text(poll: p), ")"], "")
    ColdResetPowerChanged { before_on: b, after_on: a } =>
      join(["REFUSED: host power read differently at the two endpoints (", cold_reset_power_text(on: b), " before, ", cold_reset_power_text(on: a), " after)"], "")
    ColdResetPowerUnreadAfter { before_on: b, after: o } =>
      join(["REFUSED: host power read ", cold_reset_power_text(on: b), " before and could not be read after the controller recovered: ", chassis_observation_text(observation: o)], "")
    ColdResetRecoveryNotObserved { loss: l, polls_to_loss: d, polls: n, last: p } =>
      join(["REFUSED: availability was lost after ", to_string(d), " poll(s) (", cold_reset_loss_text(loss: l), ") and not recovered within the bound (", to_string(n), " polls); last: ", cold_reset_poll_text(poll: p)], "")
    ColdResetLossNotObserved { polls: n, last: p } =>
      join(["REFUSED: no loss of availability was observed in ", to_string(n), " polls after the attempt, so no effect of it was observed; last: ", cold_reset_poll_text(poll: p)], "")
  }
}

// ── THE ATTEMPT: what ipmitool reported, beside what was observed ────────────────────────────────
// An attempt is accepted only when ipmitool reported sending AND the observations reached
// ColdResetSustainedPowerEqual, which requires the sustained window. A nonzero or unrecognised reply leaves the effect UNCERTAIN: the request may still
// have reached the controller, so it is never read as "not sent", and the watch still runs (read-only; nothing is
// sent again). Whatever it observed is reported beside the reply.
type ColdResetAcceptance
  = ColdResetAttemptAccepted
  | ColdResetAttemptNotAccepted { reason: NonEmptyStr }

fn cold_reset_attempt_acceptance(reply: IpmitoolMcResetColdReply, verdict: ColdResetVerdict) -> ColdResetAcceptance {
  let observed = cold_reset_verdict_text(verdict: verdict)
  match reply {
    McResetColdReportedSent =>
      match verdict {
        ColdResetSustainedPowerEqual { power_on: _, loss: _, polls_to_loss: _, polls_to_recovery: _, sustained_polls: _, elapsed: _, report: _ } => ColdResetAttemptAccepted
        _ => ColdResetAttemptNotAccepted { reason: observed as NonEmptyStr }
      }
    _ => ColdResetAttemptNotAccepted { reason: join(["the reset was attempted and its effect is UNCERTAIN: ", ipmitool_mc_reset_cold_reply_text(reply: reply), "; observed afterwards: ", observed], "") as NonEmptyStr }
  }
}
