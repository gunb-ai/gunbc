module gunbc.host.host_identity_assimilation

import std.types { Bool, String, NonEmptyStr }
import std.optional { Present, Absent }
import std.disposition { Disposition }
import std.content_hash { ContentHash, as_content_hash_structural, content_hash_atom }
import std.change { KeyedLeafVerdictFold, keyed_leaf_verdict_fold }
import extdeps.dns.domain_name { DnsLabel }
import product.host_identity { HostIdentity }
import gunbc.ci.ci_deploy_access { DeployAccess }
import gunbc.fleet.fleet_intent { ComputeHost }
import gunbc.deployed_intent_v0 { DeployedIntentV0, deployed_intent_observed_short_hostname, gunbc_srv1_deployed_intent_v0_persisted, gunbc_srv2_deployed_intent_v0_persisted }
import gunbc.deployed_intent_v1 { DeployedIntentV1 }
import gunbc.host.host_effect { HostEffectTransport, NodeControlPlane }
import gunbc.host.host_identity_knob { HostIdentityKnobKey, HostIdentityLeafVerdict, host_identity_knob_key }
import gunbc.host.host_identity_observation { HostIdentityObservation }
import gunbc.host.host_identity_converge {
  host_identity_apply_converged,
  host_identity_apply_gated,
  host_identity_observation_live,
  host_identity_plan_from_verdict,
  host_identity_precondition_is_conflict,
  host_identity_precondition_is_noop,
  host_identity_precondition_verdict,
  host_identity_read_back_matches,
}
import gunbc.host.host_identity_adopt { host_identity_transport_label }


type HostIdentityAssimilationTarget {
  fleet_slot: HostIdentity
  target_host: ComputeHost
  control_plane: NodeControlPlane
  transport: HostEffectTransport
  access: DeployAccess
  persisted_base: DeployedIntentV0
  desired: DeployedIntentV1?
}

type HostIdentityAssimilationReceipt {
  host: HostIdentity
  key: HostIdentityKnobKey
  adopted_base: DeployedIntentV0
  desired_hostname_short: String
  patch: HostIdentityLeafVerdict
  precondition_observed: String
  apply_converged: Bool
  read_back_observed: String
  read_back_converged: Bool
  reapply_noop: Bool
  probed_at: NonEmptyStr
  transport_label: String
  model_hash: ContentHash
}

data gunbc_host_identity_assimilation_scope_disposition: Disposition = std.disposition.Terminal {
  reason: "Closed-loop converge-from-base: host_identity_converge_with_observation takes the PERSISTED DeployedIntentV0 (a committed .dag data row — gunbc.deployed_intent_v0's gunbc_srv1_deployed_intent_v0_persisted / gunbc_srv2_deployed_intent_v0_persisted) as its base ARGUMENT, never re-derives base from a live read. Adoption (gunbc.host.host_identity_adopt, run once, out of band) and converge (this module, run every reconcile pass) are split so a run cannot silently promote drift into the new base — the three-way merge's Conflict arm stays reachable (host_identity_plan_from_verdict maps Conflict to ConflictPlan, whose plan_effect_script is structurally Absent, so host_identity_apply_gated never constructs a shell script for a conflicted leaf — no-shell-on-conflict by construction, not by a runtime check on the Conflict variant)."
}

data gunbc_host_identity_assimilation_model_marker: NonEmptyStr = "gunbc.host_identity_assimilation.v0"

fn host_identity_assimilation_model_hash() -> ContentHash {
  as_content_hash_structural(structural: content_hash_atom(value: gunbc_host_identity_assimilation_model_marker))
}

fn host_identity_assimilation_receipt(
  target: HostIdentityAssimilationTarget,
  desired: DeployedIntentV1,
  patch: HostIdentityLeafVerdict,
  precondition_observed: String,
  apply_converged: Bool,
  read_back_observed: String,
  read_back_converged: Bool,
  reapply_noop: Bool,
  probed_at: NonEmptyStr,
) -> HostIdentityAssimilationReceipt {
  HostIdentityAssimilationReceipt {
    host: target.fleet_slot,
    key: host_identity_knob_key(host: target.fleet_slot),
    adopted_base: target.persisted_base,
    desired_hostname_short: desired.desired_hostname_short as String,
    patch: patch,
    precondition_observed: precondition_observed,
    apply_converged: apply_converged,
    read_back_observed: read_back_observed,
    read_back_converged: read_back_converged,
    reapply_noop: reapply_noop,
    probed_at: probed_at,
    transport_label: host_identity_transport_label(transport: target.transport),
    model_hash: host_identity_assimilation_model_hash(),
  }
}

fn host_identity_converge_with_observation(
  target: HostIdentityAssimilationTarget,
  desired: DeployedIntentV1,
  precondition_obs: HostIdentityObservation,
  probed_at: NonEmptyStr,
) -> HostIdentityAssimilationReceipt? {
  let patch = host_identity_precondition_verdict(
    base: target.persisted_base,
    observed: precondition_obs,
    desired: desired,
  )
  let plan = host_identity_plan_from_verdict(
    verdict: patch,
    base: deployed_intent_observed_short_hostname(d: target.persisted_base) as DnsLabel,
    desired: desired.desired_hostname_short,
  )
  if host_identity_precondition_is_conflict(verdict: patch) {
    none
  } else { if host_identity_precondition_is_noop(verdict: patch) {
    let read_back_ok = host_identity_read_back_matches(
      observed: precondition_obs,
      desired_hostname: desired.desired_hostname_short,
    )
    Present {
      value: host_identity_assimilation_receipt(
        target: target,
        desired: desired,
        patch: patch,
        precondition_observed: precondition_obs.short_hostname,
        apply_converged: false,
        read_back_observed: precondition_obs.short_hostname,
        read_back_converged: read_back_ok,
        reapply_noop: true,
        probed_at: probed_at,
      )
    }
  } else {
    match host_identity_apply_gated(
      access: target.access,
      target: target.control_plane,
      plan: plan,
      transport: target.transport,
      fixture_actor: Absent,
    ) {
      Absent => none
      Present { value: apply_r } =>
        if !host_identity_apply_converged(r: apply_r) {
          none
        } else {
          match host_identity_observation_live(target: target.control_plane, transport: target.transport, probed_at: probed_at) {
            Present { value: read_back_obs } => {
              let read_back_ok = host_identity_read_back_matches(
                observed: read_back_obs,
                desired_hostname: desired.desired_hostname_short,
              )
              let reapply_patch = host_identity_precondition_verdict(
                base: target.persisted_base,
                observed: read_back_obs,
                desired: desired,
              )
              Present {
                value: host_identity_assimilation_receipt(
                  target: target,
                  desired: desired,
                  patch: patch,
                  precondition_observed: precondition_obs.short_hostname,
                  apply_converged: true,
                  read_back_observed: read_back_obs.short_hostname,
                  read_back_converged: read_back_ok,
                  reapply_noop: keyed_leaf_verdict_fold(
                    verdict: reapply_patch,
                    fold: KeyedLeafVerdictFold {
                      unchanged: true,
                      conflict: false,
                      apply_hunk: fn(_, _) { false },
                      added: fn(_) { false },
                      removed: fn(_) { false },
                    },
                  ),
                  probed_at: probed_at,
                )
              }
            }
            Absent => none
          }
        }
    }
  } }
}

// THE PER-HOST WET ENTRIES THAT WERE HERE ARE GONE. `host_identity_assimilation_target_srv1` / `_srv2`
// and `host_identity_assimilate_srv1_wet` / `_srv2_wet` named a machine six times over — a fleet slot, a
// compute host, a control-plane cell, an access row, a committed baseline and an entry each — so joining
// the fleet with a hostname to converge meant editing this module, and the only hosts that could be
// converged were the two that happened to have entries. They are replaced by ONE host-generic mode:
// gunbc.host.host_hostname_converge resolves a target and an executing peer from selectors, reads the
// baseline and the canonical name by the target's handle, and derives the access cell, the control plane
// and the SSH route from the fleet's own reach model. An entry is now a ROW of that mode — a dispatch
// naming a target and a peer — not a declaration per machine
// (gunbc.design_argument::root_generalization). What remains here is the machine-shaped machinery the
// closed loop shares with it: the fold, the gated apply, the read-back and the receipt the loop returns.
// The per-host adoption wrappers beside them are gone with them — gunbc.host.host_identity_adopt's
// host_identity_adopt_srv1_live / _srv2_live, the host-generic driver those two alone fed, and the entry
// that could only ever be satisfied by passing one of them — because adopting a baseline is now the
// The loop's ENTRY POINT went the same way: host_identity_converge_from_base had exactly two callers at
// main 7e57510bb50 — host_identity_assimilate_srv1_wet and _srv2_wet — so deleting those left it caller-less,
// and a caller-less tail is the same red. It is not reusable in its place, and that is not a defect of either:
// it sequences fold -> gated apply -> independent read-back -> no-op re-run in ONE call, while the mode must
// emit those as three separately gated workflow steps (a dry plan the operator reads before anything is
// written, a write behind a second lock, a read-back that only goes red after a confirmed apply) and must
// carry a direction. What stays here is therefore the core it shared with the mode,
// host_identity_converge_with_observation — consumed by gunbc.test.claim.host.host_identity_observation_witness,
// so the independent read-back and the no-op re-run remain in the codebase rather than being re-implemented
// beside them. The mode calls the SAME fold the core calls: host_identity_precondition_verdict is
// host_identity_patch_from_intents over the same DeployedIntentV0 / HostIdentityObservation / DeployedIntentV1
// carriers, so the peer mode and the in-place core cannot disagree about what a state means
// (gunbc.design_argument::single_authority).
