module gunbc.host.boot_medium_reader_key

import std.types { List, NonEmptyStr, String }
import std.optional { Present, Absent }
import extdeps.ssh.keys {
  SshPublicKey, AuthorizedKeyEntry, AuthorizedKeyOption, AuthorizedKeyForcedCommand, authorized_key_forced_command,
  ForcedCommandOption, NoAgentForwardingOption, NoPortForwardingOption, NoPtyOption, NoUserRcOption, NoX11ForwardingOption,
}
import extdeps.cloud.gcp.secret_ref { SecretRef, HashPending }
import extdeps.crypto.hash { sha256sum_file_command }
import extdeps.exec.command { shell_command_render }
import gunbc.fleet.fleet_secrets_config { fleet_secrets_gcp_project }
import gunbc.host.boot_medium { bmc_boot_image_export }

// ── A CREDENTIAL THAT CAN READ ONE DIGEST ON THE EXPORT HOST AND NOTHING ELSE ─────────────────────
// A branch dispatch of mtcollins1_boot may not hold the fleet automation key: that key logs in as the
// fleet's bootstrap principal, with root on every runner host (gunbc.fleet.fleet_bootstrap_principal).
// The boot's one leg on the export host is the served-medium readback (gunbc.host.boot_medium_served_readback),
// which for the runner medium is one sha256sum of the served file. This key is authorized on the export
// host's fleet-automation account with a FORCED COMMAND (extdeps.ssh.keys ForcedCommandOption): sshd runs
// that command whenever the key authenticates and ignores whatever the client asked for, so the key can
// produce one sha256sum line of one fixed path and nothing else, with no pty, no forwarding and no rc.
//
// THE PATH IS FIXED, SO IT IS A LINK. The served file's name is its digest, so it changes with every
// published image, and a forced command cannot take an argument. The runner-medium publish owns
// served_link_path and points it at what it published (gunbc.runner.runner_host_medium_publish); the
// readback over this key compares the digest it reads through the link with the boot medium's own
// digest, so a link at any other image refuses. The target's NAME is never read over this key; when the
// digests agree, the receipt names the medium's image as derived from that match.
//
// THE PUBLIC HALF IS ABSENT UNTIL THE KEY IS MINTED. The mint goes through the approval route and lands
// its public key here; until then there is no authorized entry to converge and no readback over this key,
// and both refuse by that name rather than fall back to the fleet key.

data boot_medium_served_link_name: NonEmptyStr = "served-current.iso"

fn boot_medium_served_link_path() -> NonEmptyStr {
  join([bmc_boot_image_export.dir as String, "/", boot_medium_served_link_name as String], "") as NonEmptyStr
}

// THE PRIVATE HALF'S CUSTODY. Its version is pending until the mint's receipt names the version the
// store assigned; the pin, the public key and its fingerprint then land here together. CONSUMPTION
// (DESIGN section 3c): the mint (gunbc.host.boot_medium_reader_key_mint) adds the version to this
// secret, and the converge grant set binds the mint identity's versionAdder cell on it
// (gunbc.auth.fleet_secret_accessor_roster boot_medium_reader_key_version_adder_row). The boot's own
// accessor cell is the third change of work item adhoc-0abea207-7ec.
data boot_medium_reader_ssh_privkey_secret: SecretRef = SecretRef {
  project: fleet_secrets_gcp_project,
  secret: "boot-medium-reader-ssh-key" as NonEmptyStr,
  version: "pending",
  hash_state: HashPending,
}

data boot_medium_reader_key_comment: String = "boot-medium-reader"

data boot_medium_reader_ssh_key: SshPublicKey? = none

data boot_medium_reader_ssh_key_fingerprint: NonEmptyStr? = none

// THE ONE COMMAND, rendered by the same argv the fleet-key readback sends.
fn boot_medium_reader_forced_command() -> AuthorizedKeyForcedCommand? {
  authorized_key_forced_command(text: shell_command_render(command: sha256sum_file_command(path: boot_medium_served_link_path() as String)))
}

data boot_medium_reader_restrictions: List<AuthorizedKeyOption> = [
  NoAgentForwardingOption, NoPortForwardingOption, NoPtyOption, NoUserRcOption, NoX11ForwardingOption,
]

fn boot_medium_reader_entry_for(key: SshPublicKey) -> AuthorizedKeyEntry? {
  match boot_medium_reader_forced_command() {
    Absent => none
    Present { value: c } => Present { value: AuthorizedKeyEntry { options: concat([ForcedCommandOption { command: c }], boot_medium_reader_restrictions), key: key } }
  }
}

// CONSUMPTION (DESIGN section 3c): a declared frontier. The consumer is the srv2 managed-host file row
// /etc/ssh/authorized_keys.d/<reader principal>, converged from main by gunbc.runner.runner_host_file_converge
// once its subject is generalized to a managed host with declared rows; trigger: the second change of the
// mtcollins1 approval-free branch boot plan (work item adhoc-0abea207-7ec), which also mints the key. Until
// then the public half is absent and this answers none.
fn boot_medium_reader_authorized_entry() -> AuthorizedKeyEntry? {
  match boot_medium_reader_ssh_key {
    Absent => none
    Present { value: k } => boot_medium_reader_entry_for(key: k)
  }
}
