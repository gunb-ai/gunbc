module gunbc.host.boot_medium_reader_key

import std.types { List, NonEmptyStr, String }
import std.optional { Present, Absent, optional_is_absent }
import extdeps.ssh.keys {
  SshPublicKey, AuthorizedKeyEntry, AuthorizedKeyOption, AuthorizedKeyForcedCommand, authorized_key_forced_command,
  ForcedCommandOption, NoAgentForwardingOption, NoPortForwardingOption, NoPtyOption, NoUserRcOption, NoX11ForwardingOption,
}
import extdeps.cloud.gcp.secret_ref { SecretRef, HashPending, HashKnown }
import extdeps.crypto.hash { sha256sum_file_command }
import extdeps.exec.command { shell_command_render }
import gunbc.fleet.fleet_secrets_config { fleet_secrets_gcp_project }
import gunbc.host.boot_medium { bmc_boot_image_export }

// ── A CREDENTIAL THAT CAN READ ONE DIGEST ON THE EXPORT HOST AND NOTHING ELSE ─────────────────────
// A branch dispatch of mtcollins1_boot may not hold the fleet automation key: that key logs in as the
// fleet's bootstrap principal, with root on every runner host (gunbc.fleet.fleet_bootstrap_principal).
// The boot's one leg on the export host is the served-medium readback (gunbc.host.boot_medium_served_readback),
// which for the runner medium is one sha256sum of the served file. This key is authorized on the export
// host's fleet-automation account with a FORCED COMMAND (extdeps.ssh.keys ForcedCommandOption): sshd runs
// that command whenever the key authenticates and ignores whatever the client asked for, so the key can
// produce one sha256sum line of one fixed path and nothing else, with no pty, no forwarding and no rc.
//
// THE PATH IS FIXED, SO IT IS A LINK. The served file's name is its digest, so it changes with every
// published image, and a forced command cannot take an argument. The runner-medium publish owns
// served_link_path and points it at what it published (gunbc.runner.runner_host_medium_publish); the
// readback over this key compares the digest it reads through the link with the boot medium's own
// digest, so a link at any other image refuses. The target's NAME is never read over this key; when the
// digests agree, the receipt names the medium's image as derived from that match.
//
// THE PUBLIC HALF IS ABSENT UNTIL THE KEY IS MINTED. The mint goes through the approval route and lands
// its public key here; until then there is no authorized entry to converge and no readback over this key,
// and both refuse by that name rather than fall back to the fleet key.

data boot_medium_served_link_name: NonEmptyStr = "served-current.iso"

fn boot_medium_served_link_path() -> NonEmptyStr {
  join([bmc_boot_image_export.dir as String, "/", boot_medium_served_link_name as String], "") as NonEmptyStr
}

// THE PRIVATE HALF'S CUSTODY. Its version is pending until the mint's receipt names the version the
// store assigned; the pin, the public key and its fingerprint then land here together. CONSUMPTION
// (DESIGN section 3c): the mint (gunbc.host.boot_medium_reader_key_mint) adds the version to this
// secret, and the converge grant set binds the mint identity's versionAdder cell on it
// (gunbc.auth.fleet_secret_accessor_roster boot_medium_reader_key_version_adder_row). The boot's own
// accessor cell is the third change of work item adhoc-0abea207-7ec.
data boot_medium_reader_ssh_privkey_secret: SecretRef = SecretRef {
  project: fleet_secrets_gcp_project,
  secret: "boot-medium-reader-ssh-key" as NonEmptyStr,
  version: "pending",
  hash_state: HashPending,
}

data boot_medium_reader_key_comment: String = "boot-medium-reader"

data boot_medium_reader_ssh_key: SshPublicKey? = none

data boot_medium_reader_ssh_key_fingerprint: NonEmptyStr? = none

// THE ONE COMMAND, rendered by the same argv the fleet-key readback sends.
fn boot_medium_reader_forced_command() -> AuthorizedKeyForcedCommand? {
  authorized_key_forced_command(text: shell_command_render(command: sha256sum_file_command(path: boot_medium_served_link_path() as String)))
}

data boot_medium_reader_restrictions: List<AuthorizedKeyOption> = [
  NoAgentForwardingOption, NoPortForwardingOption, NoPtyOption, NoUserRcOption, NoX11ForwardingOption,
]

fn boot_medium_reader_entry_for(key: SshPublicKey) -> AuthorizedKeyEntry? {
  match boot_medium_reader_forced_command() {
    Absent => none
    Present { value: c } => Present { value: AuthorizedKeyEntry { options: concat([ForcedCommandOption { command: c }], boot_medium_reader_restrictions), key: key } }
  }
}

// CONSUMPTION (DESIGN section 3c): a declared frontier. The consumer is the srv2 managed-host file row
// /etc/ssh/authorized_keys.d/<reader principal>, converged from main by gunbc.runner.runner_host_file_converge
// once its subject is generalized to a managed host with declared rows; trigger: the second change of the
// mtcollins1 approval-free branch boot plan (work item adhoc-0abea207-7ec), which also mints the key. Until
// then the public half is absent and this answers none.
fn boot_medium_reader_authorized_entry() -> AuthorizedKeyEntry? {
  match boot_medium_reader_ssh_key {
    Absent => none
    Present { value: k } => boot_medium_reader_entry_for(key: k)
  }
}

// IS THIS KEY MINTED? ASKED AS A TYPE, AT THE KEY'S OWN HOME.
// review 87627 (PR #15287) was right: consumers asked whether `version == "pending"`, in two modules, for a
// state that was never declared. A version string is an in-band tag -- whatever the mint happens to write
// ("0", "", an alias the store echoed back) decides a security-relevant branch, and nothing in the type
// system notices if the convention drifts. The mint lands FOUR things together (this module says so above:
// "the pin, the public key and its fingerprint then land here together"), so the state has three typed
// carriers and three states, and the decision is made once, here:
//   Unminted    -- the store holds no pinned version and no hash: there is no receipt. The route that needs
//                  this key must refuse by name, not fall back to the fleet key.
//   Minted      -- a pinned version WITH a hash, the public half, and its fingerprint. All four; this is the
//                  only state that opens anything.
//   HalfMinted -- a hash and version arrived but the public half or its fingerprint did not. That is a
//                  receipt that landed partially, and it is NOT minted: an entry cannot be converged without
//                  the public half, and a readback cannot be authorized without the fingerprint to check it
//                  against. Falling back to Unminted would call a broken mint "not yet done" and let the
//                  route reopen on a key nobody can verify; falling forward would authorize a credential
//                  whose public half is missing. Both refusals name why, and a witness asserts the state.
type BootMediumReaderKeyState
  = Unminted
  | Minted { reference: SecretRef, public_key: SshPublicKey, fingerprint: NonEmptyStr }
  | HalfMinted { why: NonEmptyStr }

// THE DECISION OVER THE THREE CARRIERS, AS A FUNCTION OF THEM. Parameters rather than global reads, so the
// state AFTER the mint converges can be asserted before it happens: the witnesses hand in a receipt of the
// shape gunbc.host.fleet_keypair_mint installs, and check what the route does with it. `boot_medium_reader_key_state` below is the
// only reader of the real standings.
fn boot_medium_reader_key_state_of(reference: SecretRef, public_key: SshPublicKey?, fingerprint: NonEmptyStr?) -> BootMediumReaderKeyState {
  match reference.hash_state {
    HashPending => Unminted
    HashKnown { content_hash: _ } => match public_key {
      Absent => HalfMinted { why: "the store has a pinned version but boot_medium_reader_ssh_key is absent, so there is no public half to converge into authorized_keys" as NonEmptyStr }
      Present { value: k } => match fingerprint {
        Absent => HalfMinted { why: "the public half landed without boot_medium_reader_ssh_key_fingerprint, so nothing can check the private half against it" as NonEmptyStr }
        Present { value: fp } => Minted { reference: reference, public_key: k, fingerprint: fp }
      }
    }
  }
}

fn boot_medium_reader_key_state() -> BootMediumReaderKeyState {
  boot_medium_reader_key_state_of(
    reference: boot_medium_reader_ssh_privkey_secret,
    public_key: boot_medium_reader_ssh_key,
    fingerprint: boot_medium_reader_ssh_key_fingerprint
  )
}

// WHICH FAULT THE KEY HAS, OR NONE WHEN IT HAS NONE. THE ONE MATCH THAT ANSWERS BOTH QUESTIONS -- is it
// minted, and if not why -- so a consumer that refuses on the first can never write the second out again
// (review 88050: the causes belong in a typed carrier, DESIGN.md §4c, and the operator-facing sentences
// belong to a renderer, not to the decision). The alternatives this replaces were a three-arm boolean match
// here and a second three-arm match in gunbc.auth.mtcollins1_branch_boot_trust picking refusal sentences,
// which is DESIGN.md §6b's trigger: two local implementations of one rule, with a dead arm wherever they
// disagree.
//
// `why` is carried verbatim. "Not yet minted" and "the mint landed part of its receipt" are different faults
// with different remedies -- flattening them is how a partially-landed mint gets called harmless, and a route
// reopened on HalfMinted would carry a credential whose public half nobody can check.
type BootMediumReaderKeyFault
  = NotMinted
  | PartlyMinted { why: NonEmptyStr }

fn boot_medium_reader_key_fault(state: BootMediumReaderKeyState) -> BootMediumReaderKeyFault? {
  match state {
    Minted { reference: _, public_key: _, fingerprint: _ } => none
    Unminted => Present { value: NotMinted }
    HalfMinted { why: w } => Present { value: PartlyMinted { why: w } }
  }
}

// IS THE KEY MINTED -- THE ONE PLACE THIS IS DECIDED, and it is decided by the match above: the absence of a
// fault IS minted-ness, so the two can never disagree about which states count. Taking the state as an
// argument is what lets a consumer that was HANDED a credential ask without re-writing the match.
fn boot_medium_reader_key_is_minted_of(state: BootMediumReaderKeyState) -> Bool {
  optional_is_absent(opt: boot_medium_reader_key_fault(state: state))
}

// THE RECEIPT'S REFERENCE, OR NONE. The other question a consumer asks about the three states -- not "is it
// minted" but "give me the pinned version I am supposed to grant against" -- answered here too, so that
// deciding which states are usable is never re-written in a consumer that also needs to destructure one. The
// one that used to match `Minted { reference: r, ... } => ..., Unminted => none, HalfMinted => none` inline is
// gunbc.auth.mtcollins1_branch_boot_trust mtcollins1_boot_branch_reader_grant_over; review 88050 counted that
// as the second local implementation of the minted rule.
fn boot_medium_reader_key_minted_reference(state: BootMediumReaderKeyState) -> SecretRef? {
  match state {
    Minted { reference: r, public_key: _, fingerprint: _ } => Present { value: r }
    Unminted => none
    HalfMinted { why: _ } => none
  }
}

fn boot_medium_reader_key_is_minted() -> Bool {
  boot_medium_reader_key_is_minted_of(state: boot_medium_reader_key_state())
}
