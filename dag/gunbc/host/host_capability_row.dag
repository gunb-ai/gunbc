// THE HOST-GRAIN CAPABILITY ROW: the per-release capability row a host's controller runs, resolved
// by LOOKUP from the firmware release identity the access observation recorded -- never a per-unit
// datum.
//
// A capability row is a fact about a vendor FIRMWARE RELEASE (extdeps.bmc.megarac's release catalog),
// keyed by the exact release identity (family + raw version) and true of every unit running that
// build. It is not a fact about one unit. This module bridges the two grains: it reads the firmware
// release identity the controller REPORTED (from the access observation, which is the per-unit
// reading) and resolves the catalog row for that build. A reflash changes the unit's reported
// release, and the next lookup resolves the new build's row -- or refuses, if that build is not yet
// catalogued. Nothing per-unit edits.
//
// The answer is TYPED at the host grain: the row is known (resolved), the observed build is
// uncatalogued, the observed build is ambiguous in the catalog, or the controller's access is not
// observed at all. No arm collapses to a default row.
module gunbc.host.host_capability_row

import extdeps.bmc.access_profile {
  BmcAccessObservation,
  BmcAccessObservationStanding,
  BmcAccessObserved,
  BmcAccessUnobserved,
  BmcObservedIdentity,
}
import extdeps.bmc.capability { BmcFirmwareReleaseIdentity, BmcFirmwareReleaseCapabilityRow }
import extdeps.bmc.endpoint { BmcControllerEndpoint }
import std.types { Int }
import gunbc.host.bmc_release_capability_catalog {
  MegaRacReleaseCapabilityLookup,
  MegaRacReleaseCapabilityKnown,
  MegaRacReleaseCapabilityUncatalogued,
  MegaRacReleaseCapabilityAmbiguous,
  megarac_release_capability_row_for,
}

// THE HOST-GRAIN STANDING OF A CONTROLLER'S CAPABILITY ROW. The three observed arms mirror the
// per-release catalog lookup (the build the controller reported resolved to a row, or did not); the
// fourth is the host-grain case the catalog cannot see: the controller's access is not observed at
// all, so there is no reported build to look up. No arm is a default row.
type HostCapabilityRowStanding
  = HostCapabilityRowKnown { row: BmcFirmwareReleaseCapabilityRow }
  | HostCapabilityRowUncatalogued { firmware: BmcFirmwareReleaseIdentity }
  | HostCapabilityRowAmbiguous { firmware: BmcFirmwareReleaseIdentity, count: Int }
  | HostCapabilityRowUnobserved { endpoint: BmcControllerEndpoint }
  // The build the controller reported IS catalogued, but that catalog entry's own evidence does not
  // support its version standing. Not the same as Uncatalogued: there the repair is to read the build,
  // here the row itself is wrongly asserted and must be fixed or withdrawn.
  | HostCapabilityRowIncoherent { firmware: BmcFirmwareReleaseIdentity }

// THE LOOKUP. Read the firmware release identity the controller reported (the per-unit reading on the
// access observation) and resolve the per-release catalog row for that build. An unobserved controller
// has no reported build, so it is Unobserved, not a default row.
fn host_capability_row(access: BmcAccessObservationStanding) -> HostCapabilityRowStanding {
  match access {
    BmcAccessUnobserved { endpoint: endpoint } => HostCapabilityRowUnobserved { endpoint: endpoint }
    BmcAccessObserved { observation: observation } =>
      match megarac_release_capability_row_for(firmware: observation.identity.firmware) {
        MegaRacReleaseCapabilityKnown { row: row } => HostCapabilityRowKnown { row: row }
        MegaRacReleaseCapabilityUncatalogued { firmware: firmware } => HostCapabilityRowUncatalogued { firmware: firmware }
        MegaRacReleaseCapabilityAmbiguous { firmware: firmware, count: count } => HostCapabilityRowAmbiguous { firmware: firmware, count: count }
        MegaRacReleaseCapabilityIncoherent { firmware: firmware } => HostCapabilityRowIncoherent { firmware: firmware }
      }
  }
}

// A re-pointed access observation for WITNESSES: the same reading with a different observed firmware
// release. A host whose controller reports a build the catalog has not yet read is uncatalogued --
// its capability row does not resolve and its boot selection refuses, with no per-unit edit. This is
// the reflash grain: the unit's reported build changes, and the lookup follows it.
fn host_access_repoint_firmware(
  access: BmcAccessObservationStanding,
  firmware: BmcFirmwareReleaseIdentity
) -> BmcAccessObservationStanding {
  match access {
    BmcAccessUnobserved { endpoint: endpoint } => BmcAccessUnobserved { endpoint: endpoint }
    BmcAccessObserved { observation: o } =>
      BmcAccessObserved {
        observation: BmcAccessObservation {
          endpoint: o.endpoint,
          identity: BmcObservedIdentity {
            board: o.identity.board,
            chassis_part_number: o.identity.chassis_part_number,
            firmware: firmware,
          },
          discovered_surfaces: o.discovered_surfaces,
          boot_control_routes: o.boot_control_routes,
          redfish_virtual_media_probe: o.redfish_virtual_media_probe,
          successful_read_surfaces: o.successful_read_surfaces,
          successful_write_surfaces: o.successful_write_surfaces,
          raw_response: o.raw_response,
          observed_at: o.observed_at,
        },
      }
  }
}
