module gunbc.host.user_session_runtime

import std.types { String, Int, List, FilePath, NonEmptyStr }
import std.optional { Present, Absent }
import std.env_binding { EnvSet, EnvBinding }
import extdeps.linux.procfs { procfs_status_effective_uid }
import extdeps.systemd.systemd_run { SystemdSetenvBinding }
import extdeps.filesystem.filesystem_io { Filesystem }

// THE USER SYSTEMD MANAGER'S RUNTIME, ONE DERIVATION FOR EVERY CONSUMER. A process that runs `systemd-run
// --user` or `systemctl --user` reaches its user manager through the session bus under that account's
// runtime directory, /run/user/<uid>, at the socket /run/user/<uid>/bus. A process started from a system
// unit through setpriv or sudo (a fleet job; gunbc.runner.runner_host_deploy job_user) inherits neither
// XDG_RUNTIME_DIR nor DBUS_SESSION_BUS_ADDRESS, so it must bind both itself or the client fails with
// "Failed to connect to bus" even when the manager is running (gunbc#14972, instrument-dispatch run
// 40176427408). Two carriers of the same two bindings exist because two different processes need them:
// the CLIENT (systemd-run or systemctl itself, an EnvBinding prefix) and the transient UNIT it starts
// (--setenv). Both read user_session_bus_address, so the socket path is spelled once.
// Lifted from gunbc.instruments.compute_run_unit_cold. Read by its two instruments (compute_run_unit_cold,
// compute_wrong_capture) and the user-session converge (gunbc.runner.runner_user_session).
// Also consumed by a named later change (a declared frontier, DESIGN 3c): gunbc#14972's
// test.claim.dispatch_credential_acquisition_witness systemd rows bind the client env; trigger: the user-session
// converge's readback holds on srv4 from main and its capability label lands.
type UserSessionRuntime
  = UserSessionRuntimeBound { runtime_dir: FilePath }
  | UserSessionRuntimeAbsent

fn user_session_runtime_dir(uid: Int) -> FilePath {
  join(["/run/user/", to_string(value: uid)], "") as FilePath
}

fn user_session_bus_address(runtime_dir: FilePath) -> String {
  join(["unix:path=", runtime_dir as String, "/bus"], "")
}

// THIS PROCESS'S OWN RUNTIME: its effective uid's directory, Bound only when the bus socket is listed there.
fn observe_user_session_runtime() -> UserSessionRuntime {
  let status = Filesystem.Read(path: "/proc/self/status")
  if !status.success {
    UserSessionRuntimeAbsent
  } else {
    match procfs_status_effective_uid(content: status.content) {
      Absent => UserSessionRuntimeAbsent
      Present { value: uid } => {
        let runtime_dir = user_session_runtime_dir(uid: uid)
        let listed = Filesystem.List(path: runtime_dir)
        if listed.success && any(split(s: listed.entries, delimiter: "\n"), n => n == "bus") {
          UserSessionRuntimeBound { runtime_dir: runtime_dir }
        } else {
          UserSessionRuntimeAbsent
        }
      }
    }
  }
}

fn user_session_launcher_env(runtime_dir: FilePath) -> List<EnvBinding> {
  [
    EnvSet { name: "XDG_RUNTIME_DIR", value: runtime_dir as String },
    EnvSet { name: "DBUS_SESSION_BUS_ADDRESS", value: user_session_bus_address(runtime_dir: runtime_dir) },
  ]
}

fn user_session_unit_setenv(runtime_dir: FilePath) -> List<SystemdSetenvBinding> {
  [
    SystemdSetenvBinding { name: "XDG_RUNTIME_DIR", value: runtime_dir as String as NonEmptyStr },
    SystemdSetenvBinding { name: "DBUS_SESSION_BUS_ADDRESS", value: user_session_bus_address(runtime_dir: runtime_dir) as NonEmptyStr },
  ]
}
