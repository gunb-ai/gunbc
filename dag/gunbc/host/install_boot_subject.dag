// gunbc.host.install_boot_subject — may THIS unit, which is not a managed host, be booted once?
//
// PXE 2c. The unit PXE 2c installs is an ARRIVAL UNIT: srv15 has no ManagedHost row and cannot get one
// before it has an OS, because the managed-host admission
// (gunbc.host.managed_host managed_host_admission) adjudicates evidence that includes facts read off the
// running machine, and gunbc.machine_intake.arrival_subject admit_arrival_subject_in REFUSES a wire that is
// also a managed host (ArrivalSubjectIsManagedHostExecutorConfusion). The two memberships are disjoint by
// construction. So the one-shot PXE boot that installs the OS cannot be ordered through the managed-host
// entry, and forging a ManagedHost row to reach it is exactly the membership forgery that entry's
// BootOnceHostNotManaged refusal exists to make unavailable.
//
// THIS MODULE ADDS AN ADMISSION, NOT A PLANNER. There is one planner core on main,
// gunbc.host.managed_host_boot_once plan_boot_once_on_standing, and plan_install_boot_once below calls it.
// A second planner would be a fork: each rule it restated (firmware before target alphabet before bound
// controller; the read-back-before-reset ordering; the intended setting being fixed save the target) could
// then drift from the first. The two entries share that core and differ ONLY in who may stand in front of a
// controller:
//
//   gunbc.host.managed_host_boot_once boot_once_plan_for_managed_host — a managed host, admitted by
//     gunbc.host.managed_host managed_host_admission;
//   this module admit_install_boot_subject + plan_install_boot_once — an admitted arrival subject with a
//     bound, secured controller whose committed write controller admits the boot-device write, for one
//     install.
//
// IDENTITY IS NOT MEMBERSHIP, AND THAT IS THE HONEST ROUTE. Every srv15 fact on main is keyed by HostIdentity
// and none of them is a managed-host row: its controller row
// (gunbc.machine_intake.bmc_write_controller srv15_bmc_write_controller), its baseboard
// (gunbc.fleet.fleet_intent srv15_baseboard), its host NIC MAC
// (gunbc.machine_intake.srv15_host_nic_observation), its target-disk reading
// (gunbc.fleet.machine_target_disk_observations). BmcControlStanding says the same of itself: it "stands for
// an unenrolled unit whose subject is valid ... and does not require a host identity". An unenrolled unit is
// therefore booted by PROVING the four facts below, never by being written into a population it is not in.
//
// THE FOUR FACTS, asked in this fixed order:
//   1. MEMBERSHIP. The wire is an ADMITTED ARRIVAL SUBJECT — a row in the arrival population whose standing
//      operator grant covers the arrival door's effects on that unit's own host (admit_arrival_subject_in).
//      A wire with no row refuses with ArrivalSubjectUnknown; neither this module nor a caller can mint one.
//   2. CONTROL. Its controller is BOUND and SECURED (BmcControlBound, minted only by bmc_control_binding,
//      which requires the observed endpoint to equal the secured endpoint).
//   3. THE SAME CONTROLLER. The controller this run intends to drive IS the bound one; if it is not, the run
//      refuses naming both. The bound endpoint, not the caller's, is what the subject carries.
//   4. AUTHORIZATION TO WRITE. The unit's committed BMC WRITE CONTROLLER admits a boot-device write to that
//      exact endpoint (select_bmc_write_controller). The controller row is committed data derived from the
//      unit's committed baseboard, so "the baseboard names this controller" is checked against the row — a
//      caller cannot hand me the board that makes the check pass.
//
// WHY THE POPULATION AND THE STANDINGS ARE ARGUMENTS. admit_arrival_subject_in takes its population as an
// argument precisely so a witness can drive it with a row that is not committed; this admission does the
// same, and the production caller passes the committed rows. Nothing here decides by looking at a name. And
// no claim may rest on the CURRENT contents of a committed table: srv15's population row and standing grant
// land on another branch (PXE 1d-a), so "the committed population refuses srv15" would be a claim about a
// date rather than about these rules.
module gunbc.host.install_boot_subject

import std.types {
  List,
  NonEmptyStr,
  String
}

import product.host_identity {
  HostIdentity
}
import extdeps.board_authority { BoardAuthorityRef }
import extdeps.bmc.endpoint { BmcControllerEndpoint }
import extdeps.bmc.access_profile { BmcAccessObservationStanding }
import extdeps.bmc.types { RedfishBootSourceOverrideTarget, RedfishBootSourceOverrideMode }
import gunbc.machine_intake.bmc_secure { BmcSecureStanding }
import gunbc.host.bmc_control_binding {
  BmcControlStanding,
  BmcControlBound,
  BmcControlAccessUnobserved,
  BmcControlNotSecured,
  BmcControlEndpointMismatch,
  bmc_control_binding,
}
import gunbc.host.managed_host_boot_once {
  BootOncePlan,
  BoundControllerFound,
  BoundControllerAbsent,
  bound_controller_of,
  plan_boot_once_on_standing
}
import gunbc.machine_intake.arrival_subject {
  ArrivalConvergePopulationRow,
  ArrivalSubjectAdmission,
  ArrivalSubjectInPopulation,
  ArrivalSubjectUnknown,
  ArrivalSubjectIsManagedHostExecutorConfusion,
  ArrivalSubjectOutsideGrant,
  admit_arrival_subject_in,
}
import gunbc.machine_intake.bmc_write_controller {
  BmcWriteControllerSelected,
  BmcWriteControllerRefused,
  BmcWriteControllerRefusal,
  BmcWriteRoute,
  select_bmc_write_controller
}
import gunbc.runner.runner_throughput_qualification { RunnerThroughputAssessment }

// THE ADMITTED SUBJECT. sole_constructor: the ONLY route to one is admit_install_boot_subject below, and its
// fields are unreadable outside this module — so what a caller holds is a subject the four facts were proved
// about, not a bag of endpoints it assembled. The control standing is CARRIED rather than re-derived
// downstream: the controller the admission checked is the controller the planner is given, so the endpoint
// that was authorized and the endpoint that receives the override cannot drift apart.
type InstallBootSubject sole_constructor {
  host: HostIdentity
  controller: BmcControllerEndpoint
  account: NonEmptyStr
  control: BmcControlStanding
}

// WHY A UNIT MAY NOT BE BOOTED ONCE, by named cause. Each names the fact and carries the evidence it came
// from, so the receipt can say which of the four failed without anyone interpreting a string.
type InstallBootSubjectRefusalCause
  // 1. no arrival population row, a malformed wire, a wire that is a managed host, or a row whose grant does
  // not cover the door on this unit's own host. The typed arrival admission is carried verbatim.
  = ArrivalNotAdmitted { subject: HostIdentity, cause: ArrivalSubjectAdmission }
  // 2. the controller is not a bound, secured control route. The standing itself is carried so the receipt
  // says WHICH of the three ways it fails (access unobserved, not secured, endpoints disagree).
  | ControllerNotBound { subject: HostIdentity, standing: BmcControlStanding }
  // 2b. bound in principle but the route names no account: there is no credential to drive it with.
  | ControllerHasNoAccount { subject: HostIdentity }
  // 3. the run named a controller that is not the unit's bound one.
  | ControllerIsNotTheBoundOne {
      subject: HostIdentity
      wanted: BmcControllerEndpoint
      bound: BmcControllerEndpoint
    }
  // 4. the unit's committed write controller refuses a boot-device write to that endpoint — including the
  // case where the unit has no controller row at all, which admits no write.
  | WriteControllerRefused { subject: HostIdentity, cause: BmcWriteControllerRefusal }

type InstallBootSubjectAdmission
  = InstallBootSubjectAdmitted { subject: InstallBootSubject }
  | InstallBootSubjectRefused { cause: InstallBootSubjectRefusalCause }

// THE ADMISSION. The order IS part of the property: membership is asked before any controller is consulted,
// and the write controller is consulted last, immediately before a caller is handed a subject it could act
// with. A unit that is not an admitted arrival never reaches the controller questions, so a mistyped or
// invented wire cannot probe a BMC — which matters most on a unit with a lockout budget.
fn admit_install_boot_subject(
  population: List<ArrivalConvergePopulationRow>,
  managed: List<HostIdentity>,
  subject: HostIdentity,
  intended_controller: BmcControllerEndpoint,
  observed: BmcAccessObservationStanding,
  secured: BmcSecureStanding,
  board: BoardAuthorityRef?,
  route: BmcWriteRoute,
  qualification: RunnerThroughputAssessment<HostIdentity>?
) -> InstallBootSubjectAdmission {
  let arrival = admit_arrival_subject_in(population: population, managed: managed, wire: subject as String)
  let control = bmc_control_binding(observed: observed, secured: secured)
  match arrival {
    ArrivalSubjectUnknown { wire: _ } =>
      InstallBootSubjectRefused { cause: ArrivalNotAdmitted { subject: subject, cause: arrival } }
    ArrivalSubjectIsManagedHostExecutorConfusion { wire: _ } =>
      InstallBootSubjectRefused { cause: ArrivalNotAdmitted { subject: subject, cause: arrival } }
    ArrivalSubjectOutsideGrant { wire: _ } =>
      InstallBootSubjectRefused { cause: ArrivalNotAdmitted { subject: subject, cause: arrival } }
    ArrivalSubjectInPopulation { subject: _ } => match control {
      BmcControlBound { route: _ } => match bound_controller_of(standing: control) {
        BoundControllerFound { endpoint: bound_endpoint, account: account } =>
          if (bound_endpoint.host as String) == (intended_controller.host as String) {
            match select_bmc_write_controller(
              host: subject,
              target: intended_controller,
              board: board,
              route: route,
              qualification: qualification
            ) {
              BmcWriteControllerSelected =>
                InstallBootSubjectAdmitted {
                  subject: InstallBootSubject {
                    host: subject,
                    controller: bound_endpoint,
                    account: account,
                    control: control,
                  }
                }
              BmcWriteControllerRefused { cause: write_cause } => InstallBootSubjectRefused {
                cause: WriteControllerRefused { subject: subject, cause: write_cause },
              }
            }
          } else {
            InstallBootSubjectRefused {
              cause: ControllerIsNotTheBoundOne {
                subject: subject, wanted: intended_controller, bound: bound_endpoint
              }
            }
          }
        BoundControllerAbsent =>
          InstallBootSubjectRefused { cause: ControllerHasNoAccount { subject: subject } }
      }
      BmcControlAccessUnobserved { endpoint: _ } =>
        InstallBootSubjectRefused { cause: ControllerNotBound { subject: subject, standing: control } }
      BmcControlNotSecured { cause: _ } =>
        InstallBootSubjectRefused { cause: ControllerNotBound { subject: subject, standing: control } }
      BmcControlEndpointMismatch { observed: _, secured: _ } =>
        InstallBootSubjectRefused { cause: ControllerNotBound { subject: subject, standing: control } }
    }
  }
}

// THE PLANNER CALL, in one place, so the one-core rule stays checkable by name. A caller cannot reach
// plan_boot_once_on_standing with a standing it assembled; it hands me the admitted subject and I hand the
// core the standing the admission proved. Everything the core guarantees is unchanged for this route: a
// Legacy mode refuses before the controller, only the allowed target alphabet passes, and the result is a
// STAGED plan whose reset is admitted only by settle_boot_once_read_back against the OBSERVED read-back.
fn plan_install_boot_once(
  subject: InstallBootSubject,
  target: RedfishBootSourceOverrideTarget,
  mode: RedfishBootSourceOverrideMode
) -> BootOncePlan {
  plan_boot_once_on_standing(control: subject.control, target: target, mode: mode)
}

// THE SUBJECT'S OWN FACTS, exposed as functions because the fields are sealed. An installer receipt needs
// the controller and the account by name; it may not read a field it was not given.
fn install_boot_subject_host(subject: InstallBootSubject) -> HostIdentity {
  subject.host
}

fn install_boot_subject_controller(subject: InstallBootSubject) -> BmcControllerEndpoint {
  subject.controller
}

fn install_boot_subject_account(subject: InstallBootSubject) -> NonEmptyStr {
  subject.account
}

fn install_boot_subject_control(subject: InstallBootSubject) -> BmcControlStanding {
  subject.control
}
