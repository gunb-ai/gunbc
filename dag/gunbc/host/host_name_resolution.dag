module gunbc.host.host_name_resolution

// HOST IDENTITY BY NAME, WITH SEVERAL TYPED RESOLUTIONS AND NO NICKNAMES (DESIGN §3).
//
// ONE IDENTITY. `HostIdentity` is a branded string — the host's name, nothing else. Nothing in this module
// turns a host identity into a spelling by appending a suffix, because that is exactly how a nickname is
// conjured at a call site and then defended ("everyone knows srv2 means the 10G box"). The identity is
// `srv2`; the spellings below are derived by the fleet's authoritative zone table, and a row states which
// one it means.
//
// SEVERAL RESOLUTIONS, EACH TYPED. `srv2` is addressed by different spellings, by different consumers,
// over different paths, and only a fool treats those as interchangeable (ROADMAP §5 — three names, three
// resolutions, one meaning; DESIGN §3 — a resolution must be a named typed relation, not a string in a
// field called name). The name space is the carrier of WHICH resolution a row means, and every arm carries
// the reason it exists, so the row states its authority rather than leaving a reader to infer it. There are
// two, because the fleet has two paths, and neither is a copy of the other:
//
//   Lan      — the router's DNS/DHCP zone (192.168.1.0/24, resolver 192.168.1.1, zone
//              mynetworksettings.com). THE ONLY NAME SPACE A BMC CAN USE: the mtcollins1 BMC is not a
//              tailnet member, so it has no tailscaled to ask and no route to the tailnet resolver, and the
//              router's own answers are what its stub resolver will see. Cited observation (2026-10-27,
//              direct UDP query to 192.168.1.1, bypassing this container's cache): srv2.mynetworksettings.com
//              -> 192.168.1.201 with rcode 0; srv2.tailecbe08.ts.net -> rcode 3 (NXDOMAIN).
//   Tailnet  — MagicDNS (100.100.100.100, zone tailecbe08.ts.net) over the VPN path. THE ONLY NAME SPACE
//              FLEET OPERATIONS SHOULD USE, because a LAN address is bound to a switch and a netplan file
//              and dies when the operator moves a NIC — which is the event that produced this work item:
//              srv2's 10G address 192.168.1.188 was deleted under a BMC row that named it.
//
// WHAT IS NOT MODELLED HERE, and why that is not a gap: a THIRD space, the out-of-band lab net
// (10.240.0.0/24 on srv2's second 10G port) reached via `srv2-asoc`. It exists, and the firmware's own
// media dialog lists it among the share's allowed sources. But the BMC's OOB interface is disabled
// (observed 2026-10-27: "Network (out of band) Disabled"), and the router does not answer for that
// hostname: srv2-asoc.mynetworksettings.com -> rcode 3 (NXDOMAIN). Modelling it as a name space would
// claim a DNS zone that no citation shows exists (§4d: an unobserved resolution is a coverage obligation,
// not a value). It is also owned by the primary-network-convergence lane (node adhoc-0f63d99c-abf), which
// owns the NIC and netplan config — naming is this module's, wiring is theirs.
//
// THE RULE THIS MODULE ENFORCES, in one sentence: a field that a resolver must answer for holds a
// `ResolvableName` (extdeps.dns.resolver), which is constructed only by an admission that REFUSES an IP
// literal; a field that is a wire value — an allocated address, a netmask, a gateway — keeps its
// `Ipv4Address` type. The distinction is the point: this is not "no IPs anywhere", it is "no IP in a place
// where a NAME is what gets looked up". The witness asserts both directions, so a claim of progress here
// has to keep the legitimate wire values in place while refusing the identity rows.
//
// WHY PREDICATES OVER THESE TYPES ARE GONE (review 87047, fourth finding). An earlier draft asked
// "is it resolved?", "is it fully qualified?", "does it end in this domain?", "can this consumer resolve
// in this space?" and got Bools, each of which matched a variant and threw the shape away. Three of the
// four asked a yes/no question about a state whose name already says the answer, so the consumer is forced
// to re-match anyway to say WHY — the predicate is a detour through information-losing territory. They are
// replaced by functions that hand back the thing itself: `resolvable_name_qualification` returns the
// `NameQualification`, `host_part_of` returns the labels that belong to the host or nothing, and
// resolvability is DATA on the consumer (`ConsumerReach.reaches`, `observed`) rather than a hard-coded
// match on the space, so a second consumer adds a row instead of a branch (§6b, "a new ordinary case is
// data, not control flow").

import std.types { String, Bool, List, Int, NonEmptyStr, Present, Absent, list_length, concat }
import std.algebra { Cons, Empty, FreeSemigroup, non_empty_singleton, take_prefix, list_reverse, skip, zip_eq }
import std.error_primitives { Ok, Err }
import extdeps.network.ipv4 { Ipv4Address, ipv4_address, render_ipv4_address }
import extdeps.dns.domain_name {
  DnsLabel,
  HostName,
  NameQualification,
  FullyQualified,
  PartiallyQualified,
  parse_host_name,
}
import extdeps.dns.resolver {
  Resolver,
  ResolvableName,
  ResolverAnswer,
  NameResolution,
  ResolutionCause,
  Addresses,
  Resolved,
  Unresolved,
  ServerUnreachable,
  NameUnknown,
  AnswerEmpty,
  resolvable_name_admit,
  ResolvableNameAdmitted,
  ResolvableNameRefused,
  ResolvableNameRefusal,
  NotANameIsIpv4Literal,
  NotANameIsIpv6Literal,
  NameMalformed,
  resolvable_name_wire,
  resolvable_name_labels,
  resolvable_name_qualification,
  resolvable_name_label_count,
  resolve_name,
  resolution_from_answer,
}
import product.host_identity { HostIdentity }
import gunbc.fleet.fleet_reach { srv2_lan_ipv4 }
import gunbc.fleet.fleet_tailnet { fleet_tailnet_domain }

// ── THE ZONE A NAME SPACE ANSWERS FOR ────────────────────────────────────────────────────────

// A ZONE IS A PARSED DOMAIN, not a string. An earlier draft kept each space's domain as a `NonEmptyStr` and
// matched names against it by rendering the name back to text, splitting on ".", and comparing the tails
// (`domain_suffix_of`). That is DESIGN §2's "a String leaf hiding named parts": the labels were already
// parsed, by the module that produced the name, and the comparison threw them away and re-derived them with
// a different rule — silently losing the qualification the parser had settled, and leaving "is srv2.com a
// suffix of xrv2.com?" to a string rule no one wrote down. `Zone` is sealed (sole_constructor, admitted only
// from a parsed `HostName`), so a space cannot be configured with an unparsed domain at all.
type Zone sole_constructor {
  labels: List<DnsLabel>
}

type ZoneAdmission
  = ZoneAdmitted { zone: Zone }
  | ZoneRefused { raw: String }

// THE ONE WAY TO CONFIGURE A ZONE: parse it. A spelling the grammar refuses (an IP literal, an empty label,
// a bad character) yields a refusal rather than a zone, so a name space can never be handed something its
// own resolver could not answer for. The qualification is dropped deliberately: a zone is a suffix, and
// whether it was written with a trailing dot is not a fact about the zone.
fn zone_admit(raw: String) -> ZoneAdmission {
  match parse_host_name(raw: raw) {
    Ok { value: h } => ZoneAdmitted { zone: Zone { labels: h.name.labels } }
    Err { value: _ } => ZoneRefused { raw: raw }
  }
}

// LABEL EQUALITY, written once and named. `DnsLabel` is `NonEmptyStr` branded, and the corpus's idiom for
// comparing a branded string is the widening cast — the cast is what says "this is being read as text,
// here, on purpose" (precedent: dag/gunbc/serving/caller_backlog.dag:127, dag/gunbc/design/reference_
// instrument.dag:198).
fn dns_label_eq(a: DnsLabel, b: DnsLabel) -> Bool {
  (a as String) == (b as String)
}

// THE LABELS THAT BELONG TO THE HOST, given a name and a zone: the name's labels with the zone's labels
// removed from the tail. This is the suffix test, and it answers review 87047's third finding — it compares
// the labels `extdeps.dns.domain_name` parsed, and never renders the name to text on the way.
//
// It refuses TWO shapes, and returns Absent for either:
//   - the tails are not the zone's labels, exactly and in order. `zip_eq` over the reversed lists gives
//     exactness, order, and equal length in one step, so "notevil.com" cannot match against "evil.com" and a
//     reordered zone cannot match either — the failure an index walk with an off-by-one is famous for.
//   - the name has no label of its own beyond the zone. `mynetworksettings.com` is the zone, not a machine
//     in it; admitting the bare zone as a host name would let a row vouch for a name that can never resolve
//     to a host. So a name must be strictly longer than its zone.
fn host_part_of(name: ResolvableName, zone: Zone) -> List<DnsLabel>? {
  let name_labels = resolvable_name_labels(name: name)
  let zone_labels = zone.labels
  let name_count = list_length(items: name_labels)
  let zone_count = list_length(items: zone_labels)
  if zone_count >= name_count {
    Absent
  } else {
    let host_count = name_count - zone_count
    if zip_eq(
      a: list_reverse(xs: skip(xs: name_labels, n: host_count)),
      b: list_reverse(xs: zone_labels),
      eq: fn(a, b) { dns_label_eq(a: a, b: b) },
    ) {
      Present { value: take_prefix(name_labels, host_count) }
    } else {
      Absent
    }
  }
}

// THE ZONES, EACH FROM THE ONE PLACE THE FLEET RECORDS IT. What a space carries is a parsed `Zone`, never
// a spelling, and the spelling is not re-minted here either: the tailnet's domain is
// `gunbc.fleet.fleet_tailnet.fleet_tailnet_domain`, whose own comment at fleet_tailnet.dag:13 records
// re-minting that very string as this module's kind of defect. Only the LAN zone is declared here, because
// nothing else in the corpus carries it — and it is declared from observation, cited below, not invented.
data lan_zone_wire: String = "mynetworksettings.com"

fn lan_zone() -> Zone? {
  match zone_admit(raw: lan_zone_wire) {
    ZoneAdmitted { zone: z } => Present { value: z }
    ZoneRefused { raw: _ } => Absent
  }
}

// THE TAILNET'S ZONE, READ FROM THE FLEET AUTHORITY RATHER THAN RESTATED HERE. The authority is optional
// — a fleet with no tailnet domain configured has no tailnet zone, and this returns Absent for exactly
// that reason rather than defaulting to some spelling. That is the honest shape: a name space nobody can
// answer for is unavailable, not quietly empty.
fn tailnet_zone() -> Zone? {
  match fleet_tailnet_domain {
    Absent => Absent
    Present { value: d } =>
      match zone_admit(raw: d as String) {
        ZoneAdmitted { zone: z } => Present { value: z }
        ZoneRefused { raw: _ } => Absent
      }
  }
}

// ── THE NAME SPACE ───────────────────────────────────────────────────────────────────────────

// WHICH RESOLUTION A SPELLING BELONGS TO. Every consumer names one, and every arm carries the reason it is
// legal for the field that names it (`why`), so the row states its authority rather than leaving a reader
// to infer it from a domain suffix they cannot see. The `zone` is DATA in the arm, not a constant behind a
// function: which suffix a space answers for is configuration, and §6b says a new ordinary case is a row,
// not a branch — a third space is added by adding an arm with its own zone and its own reason, not by
// editing a match somewhere else.
type NameSpace
  = Lan { why: String, zone: Zone }
  | Tailnet { why: String, zone: Zone }

// THE ZONE OF A SPACE, read from the row rather than from a table this module keeps.
fn space_zone(space: NameSpace) -> Zone {
  match space {
    Lan { why: _, zone: z } => z
    Tailnet { why: _, zone: z } => z
  }
}

// THE TWO SPACES THE FLEET HAS, built here because `Zone` is sealed and a consumer may not write its
// labels by hand. The `why` strings are the fleet's actual reasons, and they travel into every row filed
// under the space — so "why may this field name a LAN host?" is answered by the row, not by a comment.
fn lan_name_space() -> NameSpace? {
  match lan_zone() {
    Present { value: z } => Present {
      value: Lan {
        why: "the BMC is handed the router (192.168.1.1) as its DNS server and is not a tailnet member, so the router's zone is the only one its stub resolver can be asked about",
        zone: z,
      },
    }
    Absent => Absent
  }
}

fn tailnet_name_space() -> NameSpace? {
  match tailnet_zone() {
    Present { value: z } => Present {
      value: Tailnet {
        why: "fleet SSH and operations ride the VPN path, where MagicDNS answers and a LAN address would pin the row to a switch and a netplan file",
        zone: z,
      },
    }
    Absent => Absent
  }
}

// ── A RESOLUTION THAT CAN BE CITED ───────────────────────────────────────────────────────────

// WHAT WAS OBSERVED ABOUT ONE NAME, BY A NAMED READER, ON A DATE, AND THE REPLY IT WAS DERIVED FROM.
// `outcome` is a `NameResolution` — a CONCLUSION, and the only kind that can be derived out of a
// `ResolverAnswer` reply by the resolver module's single total map. An earlier draft let a row carry a Bool
// "it resolves" next to an uninterpreted reply, which let a green be pasted beside an NXDOMAIN; now the
// conclusion is computed from the reply it cites, so a row whose reply says NXDOMAIN says Unresolved.
//
// `reader` is not decoration: a resolution claim with no named probe behind it is exactly the thing §4d
// refuses to accept as fact, and a blank is visible in a review where "true" is not.
type ResolutionObservation {
  outcome: NameResolution
  answer: ResolverAnswer
  observed_on: NonEmptyStr
  reader: NonEmptyStr
}

// A HOST'S NAME, FILED UNDER A NAME SPACE, WITH ITS OBSERVATION. The record a consumer consults to decide
// which spelling to hand a program. The name is admitted on the way in, so a filed row cannot be a literal.
type HostNameResolution {
  host: HostIdentity
  space: NameSpace
  name: ResolvableName
  grounded: ResolutionObservation
}

type HostNameResolutionAdmission
  = HostNameResolutionAdmitted { resolution: HostNameResolution }
  | HostNameResolutionRefused { host: HostIdentity, cause: String }

// THE ONE ADMISSION. It takes the REPLY, not a conclusion: the conclusion is derived from the reply here, so
// there is no path by which a row asserts resolvability its own cited reply does not support. Three
// refusals, each the way a boot actually breaks:
//   - The name does not sit under the space's own zone. Without this, "srv2" and "srv2.mynetworksettings.com"
//     could both be filed under Tailnet, and the row would vouch for a spelling the tailnet resolver never
//     saw. The test is the parsed-label suffix test above, so it cannot be satisfied by a lookalike suffix.
//   - The name is not fully qualified. Whether it resolves would then depend on a search list this row does
//     not own; a resolution row states the answer it expects, not a suffix that may be appended. The arm is
//     matched on the `NameQualification` itself rather than behind a Bool, because the reason the row is
//     refused is the qualification, and a Bool would make the refusal text a guess about it.
//   - The cited reply does not give addresses. A reply that says NXDOMAIN, NODATA, or silence yields a
//     conclusion that says Unresolved, and the row is refused with the cause the reply actually carried.
// There is deliberately NO arm that guesses a spelling from the host identity.
fn host_name_resolution_admit(
  host: HostIdentity,
  space: NameSpace,
  name: ResolvableName,
  answer: ResolverAnswer,
  observed_on: NonEmptyStr,
  reader: NonEmptyStr,
) -> HostNameResolutionAdmission {
  let zone = space_zone(space: space)
  let conclusion = resolution_from_answer(name: name, answer: answer)
  match host_part_of(name: name, zone: zone) {
    Absent => HostNameResolutionRefused {
      host: host,
      cause: "the name does not belong to the name space it is filed under: it is not the zone's labels at its tail, or it carries no label of its own beyond the zone",
    }
    Present { value: _ } =>
      match resolvable_name_qualification(name: name) {
        PartiallyQualified => HostNameResolutionRefused {
          host: host,
          cause: "the name is not fully qualified, so its resolution depends on a search list this row does not own; state the answer you expect instead of a suffix that may be appended",
        }
        FullyQualified =>
          match conclusion {
            Resolved { name: _, addresses: _ } => HostNameResolutionAdmitted {
              resolution: HostNameResolution {
                host: host,
                space: space,
                name: name,
                grounded: ResolutionObservation {
                  outcome: conclusion,
                  answer: answer,
                  observed_on: observed_on,
                  reader: reader,
                },
              },
            }
            Unresolved { name: _, cause: c } => HostNameResolutionRefused {
              host: host,
              cause: cause_text(cause: c),
            }
          }
      }
  }
}

// THE CAUSE AS A READER READS IT, one arm per reply shape, each naming its own remedy (§5: a failure mode
// names its own remedy; a blended "failed" would push the reader to re-derive which applies). The server is
// rendered into the text because every remedy is about a particular machine, and a cause that cannot name it
// sends the reader to guess.
fn cause_text(cause: ResolutionCause) -> String {
  match cause {
    ServerUnreachable { server: s } =>
      concat(
        "the cited resolver gave no reply at ",
        concat(render_ipv4_address(addr: s) as String, "; the name may be right and the server wrong — check the server before rewriting the name"),
      )
    NameUnknown { server: s } =>
      concat(
        "the cited resolver answered authoritatively that this name is not in its zone (from ",
        concat(render_ipv4_address(addr: s) as String, "); this is the only cause that licenses changing the spelling"),
      )
    AnswerEmpty { server: s } =>
      concat(
        "the cited resolver said the name exists but carries no address record (from ",
        concat(render_ipv4_address(addr: s) as String, "); the name is live and its address data is missing — do not treat this as a wrong name"),
      )
  }
}

// ── WHAT A CONSUMER CAN RESOLVE, AS DATA ─────────────────────────────────────────────────────

// WHICH SPACES A CONSUMER CAN ACTUALLY ASK ABOUT. The finding this answers: an earlier draft decided "can
// this consumer resolve in this space" with a hard-coded match on the space, so a second consumer needed a
// new branch in shared code rather than a new row (§6b). A consumer's resolvability is a property OF THE
// CONSUMER — its path, its membership, the resolver it was configured with — so it is carried here: the
// space it can reach, the resolver it asks, and the answers that resolver has been observed to give.
//
// The BMC's reach is asserted once, from observation, rather than per call site: it is not a tailnet member
// and its stub resolver talks to the router, so its reach has one entry. A row claiming the BMC reaches the
// tailnet space would have to carry a `Resolver` and an observation nobody has cited.
type ConsumerReach {
  consumer: NonEmptyStr
  reaches: List<NameSpace>
  resolver: Resolver
  observed: List<ResolutionObservation>
}

// THE SPACE THIS CONSUMER CAN ASK ABOUT, for a given host — found in its rows rather than decided by a
// match on the space's shape. Absent means the consumer was never given a path to ask about that space, and
// every caller treats Absent as a refusal: an unobserved resolution is a coverage obligation (§4d), not a
// default-allow.
fn reachable_space_for(reach: ConsumerReach, space: NameSpace) -> NameSpace? {
  first_reached(xs: reach.reaches, space: space)
}

fn first_reached(xs: List<NameSpace>, space: NameSpace) -> NameSpace? {
  match xs {
    Empty => Absent
    Cons { head: candidate, tail: rest } =>
      if same_space(a: candidate, b: space) {
        Present { value: candidate }
      } else {
        first_reached(xs: rest, space: space)
      }
  }
}

// ARE TWO NAME SPACES THE SAME SPACE, asked of the ONE fact that decides it: the zone. An earlier draft
// matched the two arms against each other and returned false for the cross cases, which is a hand-written
// equality over a sum type — the same predicate-dissolution error this module's header says it removed,
// and it bought nothing: `Lan` and `Tailnet` answer for different zones, so the arm pair is already
// distinguished by `zone_eq`, and the `why` is documentation about a space rather than part of its
// identity. Comparing zones directly also keeps the rule honest: two `Lan` rows configured with different
// zones are different spaces, which a shape-only comparison would have wrongly called the same.
fn same_space(a: NameSpace, b: NameSpace) -> Bool {
  zone_eq(a: space_zone(space: a), b: space_zone(space: b))
}

fn zone_eq(a: Zone, b: Zone) -> Bool {
  zip_eq(a: a.labels, b: b.labels, eq: fn(x, y) { dns_label_eq(a: x, b: y) })
}

// WHAT THAT CONSUMER'S RESOLVER WAS OBSERVED TO ANSWER FOR THIS NAME, or Absent when nothing was observed.
fn observed_for(reach: ConsumerReach, name: ResolvableName) -> ResolutionObservation? {
  match reach.observed {
    Empty => Absent
    Cons { head: o, tail: rest } =>
      if observed_names_this(outcome: o.outcome, name: name) {
        Present { value: o }
      } else {
        first_matching_observation(xs: rest, name: name)
      }
  }
}

fn first_matching_observation(xs: List<ResolutionObservation>, name: ResolvableName) -> ResolutionObservation? {
  match xs {
    Empty => Absent
    Cons { head: o, tail: rest } =>
      if observed_names_this(outcome: o.outcome, name: name) {
        Present { value: o }
      } else {
        first_matching_observation(xs: rest, name: name)
      }
  }
}

// DOES THIS OBSERVATION ANSWER FOR THIS NAME, by the labels the parser settled — compared with `zip_eq` and
// the named label equality, not by rendering both sides and comparing strings at a call site.
fn observed_names_this(outcome: NameResolution, name: ResolvableName) -> Bool {
  zip_eq(
    a: resolvable_name_labels(name: asked_name(outcome: outcome)),
    b: resolvable_name_labels(name: name),
    eq: fn(x, y) { dns_label_eq(a: x, b: y) },
  )
}

// THE NAME AN OBSERVATION IS ABOUT, out of either conclusion arm. Handed back as the name, not as a field
// pulled through a Bool.
fn asked_name(outcome: NameResolution) -> ResolvableName {
  match outcome {
    Resolved { name: n, addresses: _ } => n
    Unresolved { name: n, cause: _ } => n
  }
}

// ── THE BMC MEDIA SHARE, GATED BEFORE ATTACH ─────────────────────────────────────────────────

// WHAT THE GATE CONCLUDED ABOUT A SHARE'S SERVER FIELD. Six arms because there are six different things that
// can be wrong with a share address, and each has a different remedy — which is the entire reason they are
// not one failure string (§5). Ordered by the CHECK THAT RUNS FIRST, which is also the cheapest and the one
// that needs no network:
//
//   AddressIsNotAName      the field holds an IP literal. Unwritable at the row (the admission refuses it,
//                          and the witness proves a forged literal is a COMPILE error), and this arm exists
//                          for the path that reads a share from a live BMC, where the firmware may still be
//                          holding the old spelling.
//   NeedsLanNameSpace      the row is filed under a space this consumer was never given a path to ask about.
//                          The BMC's reach has one entry, so a tailnet-filed name lands here. This is the
//                          arm that stops the "just use the tailnet name" instinct that would work for every
//                          other consumer in the fleet and fail here.
//   RefusedByConsumerFirmware the name is a name, and this consumer's OWN validator rejects its shape — the
//                          controller refuses a single label, measured against its served bundle. Kept
//                          distinct from the resolver's view deliberately: the router happily answers "srv2",
//                          so "does it resolve" and "is it usable" are two questions with two owners, and
//                          collapsing them would let a passing probe hide a refused field.
//   NamesAnotherHost       the share the boot would write and the row that vouches for it disagree. Caught
//                          before attach, which is what the boot-attach failure was asking for.
//   Unresolved             the consumer can ask, and asked, and the answer said no. Carries the cause, which
//                          names whether to fix the name, the server, or the record.
//   Usable                 the name is a name, is this consumer's to ask, satisfies this consumer's own
//                          field rule, agrees with the row, and was observed to give addresses.
type MediaShareAddressStanding
  = AddressIsNotAName { raw: NonEmptyStr, cause: String }
  | NeedsLanNameSpace { host: HostIdentity, space: NameSpace }
  | RefusedByConsumerFirmware { host: HostIdentity, name: ResolvableName, minimum_labels: Int }
  | NamesAnotherHost { host: HostIdentity, share: String, row: String }
  | ShareNameUnresolved { host: HostIdentity, cause: ResolutionCause }
  | Usable { host: HostIdentity, name: ResolvableName, address: Ipv4Address }

// THE CONSUMER'S OWN FIELD RULE, as data. `minimum_labels: 2` is not a rule this module invented: it is the
// controller's, measured 2026-10-27 by executing the firmware's own client-side validator against the
// address field (it accepts an IPv4/IPv6 literal or an RFC-1123 FQDN, and refuses a single label and a
// trailing dot). Carrying the number rather than a Bool keeps this module from owning a rule it merely
// reports — and a second consumer with a different rule contributes a row, not an arm.
type MediaShareConsumerRule {
  consumer: NonEmptyStr
  minimum_labels: Int
}

data megarac_media_address_rule: MediaShareConsumerRule = MediaShareConsumerRule {
  consumer: "mtcollins1 BMC (AMI MegaRAC) media/general cd_remote_server_address" as NonEmptyStr,
  minimum_labels: 2,
}

// THE GATE. Every check is against a TYPE or a CITATION, and no check asks the network a question a cited
// observation has already answered — the `ask` that reaches `resolve_name` is injected, so production can
// pass a live query and the witness can pass a table (§4d).
//
// The ORDER is load-bearing and asserted by the witness: the literal check runs before anything touches a
// resolver, so a row carrying .188 is refused even when a resolver would happily answer for it. An earlier
// draft could not demonstrate that, and a gate whose order is not asserted is a gate whose order is
// whatever the next refactor finds convenient.
fn media_share_address_gate(
  share_server: NonEmptyStr,
  row: HostNameResolution,
  reach: ConsumerReach,
  rule: MediaShareConsumerRule,
  ask: fn(Ipv4Address, ResolvableName) -> ResolverAnswer,
) -> MediaShareAddressStanding {
  let share_wire = share_server as String
  match resolvable_name_admit(spelling: share_wire) {
    ResolvableNameRefused { refusal: r } => not_a_name_standing(host: row.host, raw: share_server, refusal: r)
    ResolvableNameAdmitted { name: share_name } =>
      // FIRST the consumer's own field rule, then the row's agreement, then resolvability: the two cheap
      // refusals before the one that needs an answer.
      if resolvable_name_label_count(name: share_name) < rule.minimum_labels {
        RefusedByConsumerFirmware { host: row.host, name: share_name, minimum_labels: rule.minimum_labels }
      } else if share_wire != resolvable_name_wire(name: row.name) {
        NamesAnotherHost { host: row.host, share: share_wire, row: resolvable_name_wire(name: row.name) }
      } else {
        match reachable_space_for(reach: reach, space: row.space) {
          Absent => NeedsLanNameSpace { host: row.host, space: row.space }
          Present { value: _ } =>
            match resolve_name(name: share_name, resolver: reach.resolver, ask: ask) {
              // `addresses` is a FreeSemigroup, so there is always one to hand back and this arm cannot
              // invent a failure: no fallback cause, no placeholder, no "shouldn't happen" branch (§5).
              Resolved { name: _, addresses: addrs } =>
                Usable { host: row.host, name: share_name, address: addrs.head }
              Unresolved { name: _, cause: c } => ShareNameUnresolved { host: row.host, cause: c }
            }
        }
      }
  }
}

// THE LITERAL REFUSAL, rendered per arm so the remedy is the one that fits. Three sub-shapes because
// "typo in a name", "you wrote an IPv4 literal" and "you wrote an IPv6 literal" have different fixes, and a
// single blended string would have the reader fix the wrong thing (§5).
fn not_a_name_standing(host: HostIdentity, raw: NonEmptyStr, refusal: ResolvableNameRefusal) -> MediaShareAddressStanding {
  match refusal {
    NotANameIsIpv4Literal { raw: r, address: _ } => AddressIsNotAName {
      raw: raw,
      cause: concat("the share names an IPv4 address (", concat(r, ") where a host name belongs; an address cannot be looked up, cannot be checked before attach, and cannot follow a host that moved — which is what broke boot 40140037654")),
    }
    NotANameIsIpv6Literal { raw: r } => AddressIsNotAName {
      raw: raw,
      cause: concat("the share names an IPv6 literal (", concat(r, ") where a host name belongs; no NFS client in this fleet is reachable over IPv6, so this is a typo rather than a route")),
    }
    NameMalformed { raw: r, error: _ } => AddressIsNotAName {
      raw: raw,
      cause: concat("the share's server field is not a name the DNS grammar accepts (", concat(r, ")); check for an empty label, a leading or trailing hyphen, or a character outside LDH")),
    }
  }
}

// ── THE ONE FILED ROW THIS LANE CAN CITE, AND THE ONE IT CANNOT ──────────────────────────────

// srv2's LAN ADDRESS IS NOT RESTATED HERE. `gunbc.fleet.fleet_reach.srv2_lan_ipv4` is its one home
// (grounded as an Ipv4Address with source net_1g, dhcp, and its reservation Absent — which is precisely
// why a name, not this address, is what belongs in a share row). An earlier draft of this module carried
// its own `ipv4_address(192,168,1,201)`; that was a second source for one fact, and the two were free to
// drift — the exact §3 defect the review named. The address the boot died on (192.168.1.188) is not
// declared at all: it is a historical receipt, recorded in
// docs/probes/bmc_media_share_naming_2026-10-27.md, and a row for it would be dangling (§3c).
//
// THE ROUTER'S ADDRESS IS DECLARED, because nothing else declares it and it is not host identity: it is a
// wire value (a gateway/resolver), which this module's own rule says keeps its Ipv4Address type. It is the
// address the cited probe queried, so it is the server named in every resolution cause.
data router_address: Ipv4Address = ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 1)

// srv2's LAN NAME, FILED — the row the BMC media share is allowed to cite. Built through the admissions and
// grounded by a cited reply, so nothing here is hand-written: the name comes from the admission that refuses
// literals, and the conclusion is derived from the reply the probe recorded.
//
// THE CITATION: a direct UDP query to the router's own resolver at 192.168.1.1 on 2026-10-27, bypassing this
// container's cache, answered srv2.mynetworksettings.com with rcode 0 and one A record, 192.168.1.201. The
// same query for srv2 returned the same address, and for srv2-asoc returned rcode 3 — the observations that
// decide which arms of this module can be filled at all.
fn srv2_lan_name() -> HostNameResolutionAdmission {
  match resolvable_name_admit(spelling: "srv2.mynetworksettings.com") {
    ResolvableNameAdmitted { name: n } =>
      match lan_name_space() {
        Present { value: space } => host_name_resolution_admit(
          host: "srv2" as HostIdentity,
          space: space,
          name: n,
          answer: Addresses { server: router_address, addresses: non_empty_singleton(item: srv2_lan_ipv4) },
          observed_on: "2026-10-27",
          reader: "read-only probe, direct UDP to 192.168.1.1:53 (see docs/probes/bmc_media_share_naming_2026-10-27.md)",
        )
        Absent => HostNameResolutionRefused {
          host: "srv2" as HostIdentity,
          cause: "the LAN zone's own spelling does not parse, so no Lan row can be filed; this is a configuration defect in this module, not a defect in the name",
        }
      }
    ResolvableNameRefused { refusal: r } => HostNameResolutionRefused {
      host: "srv2" as HostIdentity,
      cause: match r {
        NotANameIsIpv4Literal { raw: _, address: _ } => "the configured LAN spelling is an IPv4 literal, so the row cannot be filed"
        NotANameIsIpv6Literal { raw: _ } => "the configured LAN spelling is an IPv6 literal, so the row cannot be filed"
        NameMalformed { raw: _, error: _ } => "the configured LAN spelling does not parse, so the row cannot be filed"
      },
    }
  }
}

// THE PRODUCTION CUT-OVER, DECLARED AS A FRONTIER WITH ITS TRIGGER (DESIGN §3c: "consumed by a named later
// change (a declared frontier, with its trigger)"). The share row at
// gunbc.machine_intake.mtcollins1_boot_run.mtcollins1_media_share still spells its NFS server by address —
// `render_ipv4_address(addr: srv2_lan_ipv4)` — and this module's gate REFUSES that spelling, which the
// witness asserts against the real row rather than against a fabricated string. The row is not cut over in
// this change, and the reason is not inertia: the row is the EXPECTED value of a read-compare the boot
// already performs (megarac_media_attach's ShareMismatch gate), so flipping it before the BMC's own
// `cd_remote_server_address` is repointed turns a gate that passes today into a refusal mid-critical-path.
// The cut-over therefore lands PAIRED with the firmware write, never before it.
//
// TRIGGER — all three, in this order:
//   (1) the boot that must not be disturbed has run (boot 7, at time of writing), so no gate is being
//       changed under a live attach;
//   (2) the BMC's network settings have been READ and its DNS server CITED — the BMC is not on the tailnet,
//       so a LAN name is only as good as the resolver it was told to ask, and writing a name while its
//       resolver is unknown is how a share that resolves from a laptop fails on the controller (§4d: an
//       unobserved resolution is an obligation, not a value);
//   (3) the operator has given the go for the one-time media/general PUT, and THIS session owns pairing
//       that PUT with the row change, so the two cannot land apart.
// WHAT DOES NOT SATISFY THE TRIGGER: the witness going green (it already does, and it is refusing the row);
// the row being changed without the paired firmware write; or the tailnet name being written into the share,
// which the NeedsLanNameSpace arm exists to refuse.
data media_share_name_cutover_frontier: String = "gunbc.machine_intake.mtcollins1_boot_run.mtcollins1_media_share.server_address: cut from render_ipv4_address(addr: srv2_lan_ipv4) to the LAN name srv2.mynetworksettings.com, admitted through resolvable_name_admit and grounded by srv2_lan_name(), in the same change as the one-time media/general PUT that repoints the controller. Lands after boot 7 runs, after the BMC's DNS server is read and cited, and on the operator's go."

// srv2's TAILNET NAME IS NOT FILED, and the absence is the point. This container has no tailnet daemon and
// no `tailscale` binary, so nothing could have been asked about the tailnet spelling and no observation
// exists to cite; per §4d an unobserved resolution is a coverage obligation, not a value. The function
// below returns the refusal a consumer receives today, and the cause names the MISSING READER rather than
// the name — because the name may be perfectly good, and saying so honestly is what keeps the next person
// from "fixing" the spelling when what is missing is a probe.
//
// This also states the asymmetry the whole BMC decision rests on: we can PROVE the BMC must not use the
// tailnet name (the router's NXDOMAIN for srv2.tailecbe08.ts.net is cited in this file's header, and the BMC
// is not a tailnet member), while we cannot yet prove fleet operations resolve it. The first is a fact with
// an observation behind it; the second is an obligation. Only the first is allowed to gate a boot.
fn srv2_tailnet_name_refused() -> HostNameResolutionAdmission {
  HostNameResolutionRefused {
    host: "srv2" as HostIdentity,
    cause: "no resolver reachable from here can answer for the tailnet space, so no observation can be cited for srv2.tailecbe08.ts.net; the row stays unfiled. Remedy: run the query through a tailnet member and carry its answer (ResolutionObservation), then admit through host_name_resolution_admit",
  }
}
