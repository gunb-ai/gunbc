module gunbc.host.path_observation

import std.types { String, Bool, Int, NonEmptyStr, List }
import std.nat { Nat }
import std.algebra { trim }
import gunbc.host_operation_exec { HostOperation, StatFileType, HeadBytes, host_operation_label }
import gunbc.compute.host_occupancy { host_operation_ran, HostOperationRan, HostOperationExited, HostOperationNotRun, HostOperationResultUnreceived, host_operation_exit_unread }
import gunbc.spark.host_effect_quiescence { ArgvRun }

// ── WHAT IS AT A PATH ON A HOST, AND A BOUNDED READ OF IT, AS TYPED LEGS ─────────────────────
//
// THE CONSUMER THIS EXISTS FOR (valiant-crab-775, after review 76640 on #13365): the arm convergence
// observe reads, on each rank, whether a record file is present and what it says, and whether retired
// transaction files remain. It did so in a string-assembled shell body, which is the unmodeled
// realization DESIGN section 6 names; this module is the typed route that body is replaced by. Each
// question is one HostOperation run through the caller's ArgvRun, so the privileged transport is the
// caller's (the same seam gunbc.compute.host_occupancy read_unit_activity uses), and each answer is
// decided here, in .dag, from the exit code and the operation's own output.
//
// THREE ANSWERS, NEVER TWO. A path is a regular file, is something else, or is absent -- and when the
// read itself fails for any other reason it is UNREAD, which is not absent. Collapsing unread into
// absent would answer "no record" for a host whose read was refused, which is the fabricated default
// DESIGN section 5 forbids.

type PathKindRead
  = PathRegularFile
  | PathOtherKind { kind: String }
  | PathAbsent
  | PathKindUnread { cause: String }

// GNU stat(1) %F prints "regular file" or, for a zero-length one, "regular empty file"; both are a
// regular file. Every other word (directory, symbolic link, fifo, ...) is another kind.
data path_stat_regular_words: List<String> = ["regular file", "regular empty file"]

// ABSENCE IS READ FROM THE DIAGNOSTIC, not from the exit code alone. stat exits 1 both for a path that
// does not exist and for one it could not examine, so the exit code cannot separate them; the C
// library's strerror(ENOENT) text, which stat prints, can. It is upstream's wording, not a typed code,
// so a change in it turns an absent path into an unread one -- the safe direction, because unread
// refuses.
data path_enoent_text: String = "No such file or directory"

fn path_kind_of_exit(code: Int, stdout: String, stderr: String, operation: HostOperation) -> PathKindRead {
  if code == 0 {
    let word = trim(s: stdout)
    if any(path_stat_regular_words, w => w == word) { PathRegularFile }
    else if word == "" { PathKindUnread { cause: join([host_operation_label(operation: operation), " printed no file type"], "") } }
    else { PathOtherKind { kind: word } }
  } else if string_contains(s: stderr, pattern: path_enoent_text) { PathAbsent }
  else { PathKindUnread { cause: host_operation_exit_unread(operation: operation, code: code, err: stderr) } }
}

fn path_kind(run: fn(List<String>) -> ArgvRun, path: NonEmptyStr) -> PathKindRead {
  let operation = StatFileType { path: path }
  match host_operation_ran(run: run, operation: operation) {
    HostOperationNotRun { cause: c } => PathKindUnread { cause: c }
    HostOperationResultUnreceived { cause: c } => PathKindUnread { cause: c }
    HostOperationExited { exit_code: code, stdout: out, stderr: err } => path_kind_of_exit(code: code, stdout: out, stderr: err, operation: operation)
  }
}

type SmallFileRead
  = SmallFileText { text: String }
  | SmallFileAbsent
  | SmallFileUnread { cause: String }

// A SMALL FILE, READ AFTER ITS KIND IS KNOWN. Only a regular file is read, and only its first `limit`
// bytes; an absent path is absent; anything else at the path -- a directory where the record should be
// -- is unread, never empty text.
fn small_file_read(run: fn(List<String>) -> ArgvRun, path: NonEmptyStr, limit: Nat) -> SmallFileRead {
  match path_kind(run: run, path: path) {
    PathAbsent => SmallFileAbsent
    PathKindUnread { cause: c } => SmallFileUnread { cause: c }
    PathOtherKind { kind: k } => SmallFileUnread { cause: join([path as String, " is a ", k, ", not a regular file"], "") }
    PathRegularFile => {
      let operation = HeadBytes { path: path, count: limit }
      match host_operation_ran(run: run, operation: operation) {
        HostOperationNotRun { cause: c } => SmallFileUnread { cause: c }
        HostOperationResultUnreceived { cause: c } => SmallFileUnread { cause: c }
        HostOperationExited { exit_code: code, stdout: out, stderr: err } =>
          if code == 0 { SmallFileText { text: out } }
          else { SmallFileUnread { cause: host_operation_exit_unread(operation: operation, code: code, err: err) } }
      }
    }
  }
}
