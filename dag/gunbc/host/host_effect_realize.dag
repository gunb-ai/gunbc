        EnsureActionsRunnerRelease { runner_release: _ } => IncompatibleCell { reason: "host_effect: RunnerLocalHost admits only ProbeToolchainHomeInterference; fleet-addressed effects require HostOs or BmcController." }
        EnsureRunnerSlotDirectory { slot: _, artifact: _ } => IncompatibleCell { reason: "host_effect: RunnerLocalHost admits only ProbeToolchainHomeInterference; fleet-addressed effects require HostOs or BmcController." }
        EnsureRunnerJitWrapper { host_label: _ } => IncompatibleCell { reason: "host_effect: RunnerLocalHost admits only ProbeToolchainHomeInterference; fleet-addressed effects require HostOs or BmcController." }
        EnsureRunnerSystemdTemplate { host_label: _ } => IncompatibleCell { reason: "host_effect: RunnerLocalHost admits only ProbeToolchainHomeInterference; fleet-addressed effects require HostOs or BmcController." }
        EnsureRunnerMemoryCaps { slot: _ } => IncompatibleCell { reason: "host_effect: RunnerLocalHost admits only ProbeToolchainHomeInterference; fleet-addressed effects require HostOs or BmcController." }
        ActivateRunnerSlot { slot: _ } => IncompatibleCell { reason: "host_effect: RunnerLocalHost admits only ProbeToolchainHomeInterference; fleet-addressed effects require HostOs or BmcController." }
        DrainAndMaskRunnerSlot { slot: _ } => IncompatibleCell { reason: "host_effect: RunnerLocalHost admits only ProbeToolchainHomeInterference; fleet-addressed effects require HostOs or BmcController." }
        ReplaceRunnerIncarnation { from: _, cause: _ } => IncompatibleCell { reason: "host_effect: RunnerLocalHost admits only ProbeToolchainHomeInterference; fleet-addressed effects require HostOs or BmcController." }
        ObserveRunnerLocalState { slot: _ } => IncompatibleCell { reason: "host_effect: RunnerLocalHost admits only ProbeToolchainHomeInterference; fleet-addressed effects require HostOs or BmcController." }
        ObserveGitHubRunnerRegistration { slot: _, organization: _ } => IncompatibleCell { reason: "host_effect: RunnerLocalHost admits only ProbeToolchainHomeInterference; fleet-addressed effects require HostOs or BmcController." }
      }
    HostOs { node: n } =>
      match effect {
        OsInstallActuatorToolchainEnsure {} =>
          OsInstallActuatorToolchainOnHost { node: n }
        EnsureBuildCacheInstance { desired: d } =>
          ProvisionBuildCacheOnHost { node: n, desired: d }
        ProvisionCodexRuntime {} =>
          ProvisionCodexRuntimeOnHost { node: n }
        EnsureCompilePoolSlice {} =>
          EnsureCompilePoolSliceOnHost { node: n }
        Srv3ReceiptEmit { lines: lines } =>
          ReceiptEmitOnHost { node: n, lines: lines }
        Srv3BootOnceReadBackSleep =>
          BootOnceReadBackSleepOnHost { node: n }
        Srv3SeededInstallMediaToolchainEnsure =>
          SeededInstallMediaToolchainOnHost { node: n }
