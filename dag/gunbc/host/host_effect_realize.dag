          BmcwebSessionLoginOnHost { node: n, request_body_file: f }
        Srv3BmcwebTokenExtract =>
          BmcwebTokenExtractOnHost { node: n }
        LiveDeployApply { warrant: w } =>
          LiveDeployApplyOnHost { node: n, spec: w.spec, candidate: w.candidate, plan: w.plan }
        LiveDeployRetract { spec: s } =>
          LiveDeployRetractOnHost { node: n, spec: s }
        LiveDeployApprovalBrokerDarkInstall { spec: s, candidate: c } =>
          LiveDeployApprovalBrokerDarkInstallOnHost { node: n, spec: s, candidate: c }
        LiveDeployMicrovmControllerInstall { candidate: c, elevated: e } =>
