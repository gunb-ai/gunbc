type TypedReconcileKind = TypedReconcileFetch | TypedReconcileRemaster

type ResolvedHostEffectCell =
    RedfishOnBmc { node: ComputeHost, action: RedfishSystemAction }
  | ConvergeOnHost { node: ComputeHost, host_converge: HostConverge }
  | TypedReconcileOnHost { node: ComputeHost, kind: TypedReconcileKind }
  | OsInstallActuatorToolchainOnHost { node: ComputeHost }
  | ProvisionBuildCacheOnHost { node: ComputeHost, desired: BuildCacheInstance }
  | ProvisionCodexRuntimeOnHost { node: ComputeHost }
  | EnsureCompilePoolSliceOnHost { node: ComputeHost }
  | HostnameOnHost { node: ComputeHost, hostnamectl_path: NonEmptyStr, base: DnsLabel, desired: DnsLabel }
  | HostnameReadOnHost { node: ComputeHost }
  | NbdProxySessionOnHost {
      node: ComputeHost,
      intent: NbdProxyServeTransportIntent,
      lease_key: NonEmptyStr,
    }
  | CodexSupervisedWorkerTurnOnHost {
      node: ComputeHost,
      intent: CodexAppServerStdioSessionIntent,
      lease_key: NonEmptyStr,
    }
  | ReceiptEmitOnHost { node: ComputeHost, lines: List<String> }
  | BootOnceReadBackSleepOnHost { node: ComputeHost }
  | SeededInstallMediaToolchainOnHost { node: ComputeHost }
  | BmcwebSessionLoginOnHost { node: ComputeHost, request_body_file: NonEmptyStr }
  | BmcwebTokenExtractOnHost { node: ComputeHost }
  | EffectivePrincipalReadOnHost { node: ComputeHost, read: EffectivePosixPrincipalRead }
  | SudoNopasswdExecuteProbeOnHost { node: ComputeHost, probe: SudoNopasswdExecuteProbeShape }
  | SudoNopasswdGrantListProbeOnHost { node: ComputeHost, probe: SudoNopasswdGrantListProbeShape }
  | LiveDeployApplyOnHost { node: ComputeHost, spec: DeploymentSpec, candidate: CandidateRelease, plan: ReleaseEffectPlan }
  | LiveDeployRetractOnHost { node: ComputeHost, spec: DeploymentSpec }
  | LiveDeployApprovalBrokerDarkInstallOnHost { node: ComputeHost, spec: DeploymentSpec, candidate: CandidateRelease }
  | LiveDeployMicrovmControllerInstallOnHost { node: ComputeHost, candidate: CandidateRelease, elevated: HostEffectTransport }
  | LiveDeployEnsureDependencyOnHost { node: ComputeHost, dep: DeploymentDependencyStep }
  | LiveDeployDigestReadbackOnHost { node: ComputeHost, port: Int, expected_digest: Fnv1a64Structural }
  | LiveDeployServeRouteOnHost { node: ComputeHost, endpoint: TailscaleServeEndpoint, enabled: Bool }
  | EnsureActionsRunnerReleaseOnHost { node: ComputeHost, runner_release: ActionsRunnerRelease }
  | EnsureRunnerSlotDirectoryOnHost {
      node: ComputeHost,
      slot: RunnerSlotIdentity,
      artifact: ActionsRunnerBinaryArtifact,
    }
  | EnsureRunnerJitWrapperOnHost { node: ComputeHost, host_label: NonEmptyStr }
  | EnsureRunnerSystemdTemplateOnHost { node: ComputeHost, host_label: NonEmptyStr }
  | EnsureRunnerMemoryCapsOnHost { node: ComputeHost, slot: RunnerSlotIdentity }
  | ActivateRunnerSlotOnHost { node: ComputeHost, slot: RunnerSlotIdentity }
  | DrainAndMaskRunnerSlotOnHost { node: ComputeHost, slot: RunnerSlotIdentity }
  | ReplaceRunnerIncarnationOnHost {
      node: ComputeHost,
      from: LocalRunnerSlotIncarnation,
      cause: RunnerReplacementCause,
    }
  | ObserveRunnerLocalStateOnHost { node: ComputeHost, slot: RunnerSlotIdentity }
  | ObserveGitHubRunnerRegistrationOnHost {
      node: ComputeHost,
      slot: RunnerSlotIdentity,
      organization: NonEmptyStr,
    }
  | ToolchainHomeInterferenceProbeOnHost
  | IncompatibleCell { reason: String }

fn converge_plan_identity_mismatch_reason(node: ComputeHost, policy: HostConverge) -> String {
  concat(
    concat(
      "host_effect: ConvergePlan target identity ",
      node.identity as String
    ),
    concat(" does not match policy identity ", policy.identity as String)
  )
}

fn resolve_host_os_effect_cell_after_direct_arms(n: ComputeHost, effect: HostEffect) -> ResolvedHostEffectCell {
  match effect {
    RedfishAction { action: _ } =>
      IncompatibleCell { reason: "host_effect: RedfishAction is out-of-band (Redfish) and cannot target HostOs (in-band shell/systemd); target BmcController instead. Typed mismatch via total fold, DESIGN section 5." }
    ConvergePlan { policy: p } =>
      if n.identity != p.identity {
        IncompatibleCell { reason: converge_plan_identity_mismatch_reason(node: n, policy: p) }
      } else {
        ConvergeOnHost { node: n, host_converge: p }
      }
    OsInstallActuatorToolchainEnsure {} =>
      OsInstallActuatorToolchainOnHost { node: n }
    EnsureBuildCacheInstance { desired: d } =>
      ProvisionBuildCacheOnHost { node: n, desired: d }
    ProvisionCodexRuntime {} =>
      ProvisionCodexRuntimeOnHost { node: n }
    EnsureCompilePoolSlice {} =>
      EnsureCompilePoolSliceOnHost { node: n }
    Srv3InstallMediaFetch => TypedReconcileOnHost { node: n, kind: TypedReconcileFetch }
    Srv3SeededInstallMediaRemaster => TypedReconcileOnHost { node: n, kind: TypedReconcileRemaster }
    Srv3SeededInstallMediaToolchainEnsure =>
      SeededInstallMediaToolchainOnHost { node: n }
    Srv3BmcwebSessionLogin { request_body_file: f } =>
      BmcwebSessionLoginOnHost { node: n, request_body_file: f }
    Srv3BmcwebTokenExtract =>
      BmcwebTokenExtractOnHost { node: n }
    Srv3BootOnceReadBackSleep =>
      BootOnceReadBackSleepOnHost { node: n }
    Srv3ReceiptEmit { lines: lines } =>
      ReceiptEmitOnHost { node: n, lines: lines }
    SetHostnameCas { hostnamectl_path: p, base: b, desired: d } =>
      HostnameOnHost { node: n, hostnamectl_path: p, base: b, desired: d }
    ReadEffectivePosixPrincipal { read: r } =>
      EffectivePrincipalReadOnHost { node: n, read: r }
    SudoNopasswdExecuteProbe { probe: p } =>
      SudoNopasswdExecuteProbeOnHost { node: n, probe: p }
    SudoNopasswdGrantListProbe { probe: p } =>
      SudoNopasswdGrantListProbeOnHost { node: n, probe: p }
    Srv3NbdProxyServe { intent: i, lease_key: k } =>
      NbdProxySessionOnHost { node: n, intent: i, lease_key: k }
    CodexSupervisedWorkerTurn { intent: i, lease_key: k } =>
      CodexSupervisedWorkerTurnOnHost { node: n, intent: i, lease_key: k }
    HostIdentityShortHostnameRead =>
      HostnameReadOnHost { node: n }
    LiveDeployApply { warrant: w } =>
      LiveDeployApplyOnHost { node: n, spec: w.spec, candidate: w.candidate, plan: w.plan }
    LiveDeployRetract { spec: s } =>
      LiveDeployRetractOnHost { node: n, spec: s }
    LiveDeployApprovalBrokerDarkInstall { spec: s, candidate: c } =>
      LiveDeployApprovalBrokerDarkInstallOnHost { node: n, spec: s, candidate: c }
    LiveDeployMicrovmControllerInstall { candidate: c, elevated: e } =>
      LiveDeployMicrovmControllerInstallOnHost { node: n, candidate: c, elevated: e }
    LiveDeployEnsureDependency { dep: d } =>
      LiveDeployEnsureDependencyOnHost { node: n, dep: d }
    LiveDeployDigestReadback { port: p, expected_digest: d } =>
      LiveDeployDigestReadbackOnHost { node: n, port: p, expected_digest: d }
    LiveDeployServeRoute { endpoint: e, enabled: route_enabled } =>
      LiveDeployServeRouteOnHost { node: n, endpoint: e, enabled: route_enabled }
    EnsureActionsRunnerRelease { runner_release: r } =>
      EnsureActionsRunnerReleaseOnHost { node: n, runner_release: r }
    EnsureRunnerSlotDirectory { slot: s, artifact: a } =>
      EnsureRunnerSlotDirectoryOnHost { node: n, slot: s, artifact: a }
    EnsureRunnerJitWrapper { host_label: l } =>
      EnsureRunnerJitWrapperOnHost { node: n, host_label: l }
    EnsureRunnerSystemdTemplate { host_label: l } =>
      EnsureRunnerSystemdTemplateOnHost { node: n, host_label: l }
    EnsureRunnerMemoryCaps { slot: s } =>
      EnsureRunnerMemoryCapsOnHost { node: n, slot: s }
    ActivateRunnerSlot { slot: s } =>
      ActivateRunnerSlotOnHost { node: n, slot: s }
    DrainAndMaskRunnerSlot { slot: s } =>
      DrainAndMaskRunnerSlotOnHost { node: n, slot: s }
    ReplaceRunnerIncarnation { from: inc, cause: c } =>
      ReplaceRunnerIncarnationOnHost { node: n, from: inc, cause: c }
    ObserveRunnerLocalState { slot: s } =>
      ObserveRunnerLocalStateOnHost { node: n, slot: s }
    ObserveGitHubRunnerRegistration { slot: s, organization: o } =>
      ObserveGitHubRunnerRegistrationOnHost { node: n, slot: s, organization: o }
    ProbeToolchainHomeInterference {} =>
      IncompatibleCell { reason: "host_effect: ProbeToolchainHomeInterference is runner-local and cannot name a fleet HostOs; target RunnerLocalHost instead." }
    DeployAccessPreflight {} =>
      IncompatibleCell {
        reason: "host_effect: DeployAccessPreflight is intent-only (authorization gate record) and cannot be applied; typed mismatch, DESIGN section 5.",
      }
  }
}

fn resolve_bmc_controller_effect_cell_after_direct_arms(n: ComputeHost, effect: HostEffect) -> ResolvedHostEffectCell {
  match effect {
    RedfishAction { action: a } => RedfishOnBmc { node: n, action: a }
    ConvergePlan { policy: _ } =>
      IncompatibleCell { reason: "host_effect: ConvergePlan is in-band (host OS converge) and cannot target BmcController (out-of-band Redfish only); target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    OsInstallActuatorToolchainEnsure {} =>
      IncompatibleCell { reason: "host_effect: OsInstallActuatorToolchainEnsure is in-band (actuator host toolchain) and cannot target BmcController; target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    EnsureBuildCacheInstance { desired: _ } =>
      IncompatibleCell { reason: "host_effect: EnsureBuildCacheInstance is in-band (per-host sccache daemon) and cannot target BmcController; target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    ProvisionCodexRuntime {} =>
      IncompatibleCell { reason: "host_effect: ProvisionCodexRuntime is in-band (per-host provider runtime bundle) and cannot target BmcController; target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    EnsureCompilePoolSlice {} =>
      IncompatibleCell { reason: "host_effect: EnsureCompilePoolSlice is in-band (per-host systemd slice) and cannot target BmcController; target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    Srv3InstallMediaFetch =>
      IncompatibleCell { reason: "host_effect: Srv3InstallMediaFetch is in-band (actuator host typed reconcile) and cannot target BmcController (out-of-band Redfish only); target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    Srv3SeededInstallMediaRemaster =>
      IncompatibleCell { reason: "host_effect: Srv3SeededInstallMediaRemaster is in-band (actuator host typed reconcile) and cannot target BmcController (out-of-band Redfish only); target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    Srv3SeededInstallMediaToolchainEnsure =>
      IncompatibleCell { reason: "host_effect: Srv3SeededInstallMediaToolchainEnsure is in-band (actuator host typed toolchain ensure) and cannot target BmcController (out-of-band Redfish only); target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    Srv3BmcwebSessionLogin { request_body_file: _ } =>
      IncompatibleCell { reason: "host_effect: Srv3BmcwebSessionLogin is in-band (actuator host typed curl login) and cannot target BmcController (out-of-band Redfish only); target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    Srv3BmcwebTokenExtract =>
      IncompatibleCell { reason: "host_effect: Srv3BmcwebTokenExtract is in-band (actuator host typed jq extract + write) and cannot target BmcController (out-of-band Redfish only); target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    Srv3NbdProxyServe { intent: _, lease_key: _ } =>
      IncompatibleCell { reason: "host_effect: Srv3NbdProxyServe is in-band (actuator host long-running session) and cannot target BmcController (out-of-band Redfish only); target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    CodexSupervisedWorkerTurn { intent: _, lease_key: _ } =>
      IncompatibleCell { reason: "host_effect: CodexSupervisedWorkerTurn is in-band (actuator host app-server stdio session) and cannot target BmcController (out-of-band Redfish only); target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    Srv3BootOnceReadBackSleep =>
      IncompatibleCell { reason: "host_effect: Srv3BootOnceReadBackSleep is in-band (actuator host typed sleep) and cannot target BmcController (out-of-band Redfish only); target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    Srv3ReceiptEmit { lines: _ } =>
      IncompatibleCell { reason: "host_effect: Srv3ReceiptEmit is in-band (actuator host typed receipt) and cannot target BmcController (out-of-band Redfish only); target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    SetHostnameCas { hostnamectl_path: _, base: _, desired: _ } =>
      IncompatibleCell { reason: "host_effect: SetHostnameCas is in-band (shell hostnamectl) and cannot target BmcController (out-of-band Redfish only); target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    ReadEffectivePosixPrincipal { read: _ } =>
      IncompatibleCell { reason: "host_effect: ReadEffectivePosixPrincipal is in-band (shell whoami) and cannot target BmcController (out-of-band Redfish only); target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    SudoNopasswdExecuteProbe { probe: _ } =>
      IncompatibleCell { reason: "host_effect: SudoNopasswdExecuteProbe is in-band (shell sudo -n probe) and cannot target BmcController (out-of-band Redfish only); target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    SudoNopasswdGrantListProbe { probe: _ } =>
      IncompatibleCell { reason: "host_effect: SudoNopasswdGrantListProbe is in-band (typed sudo grant-list probe) and cannot target BmcController (out-of-band Redfish only); target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    HostIdentityShortHostnameRead =>
      IncompatibleCell { reason: "host_effect: HostIdentityShortHostnameRead is in-band (shell hostname -s) and cannot target BmcController (out-of-band Redfish only); target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    LiveDeployApply { warrant: _ } =>
      IncompatibleCell { reason: "host_effect: LiveDeployApply is in-band (actuator host shell mutation) and cannot target BmcController (out-of-band Redfish only); target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    LiveDeployRetract { spec: _ } =>
      IncompatibleCell { reason: "host_effect: LiveDeployRetract is in-band (actuator host shell mutation) and cannot target BmcController (out-of-band Redfish only); target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    LiveDeployApprovalBrokerDarkInstall { spec: _, candidate: _ } =>
      IncompatibleCell { reason: "host_effect: LiveDeployApprovalBrokerDarkInstall is in-band (actuator host shell mutation) and cannot target BmcController (out-of-band Redfish only); target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    LiveDeployMicrovmControllerInstall { candidate: _ } =>
      IncompatibleCell { reason: "host_effect: LiveDeployMicrovmControllerInstall is in-band (actuator host shell mutation) and cannot target BmcController (out-of-band Redfish only); target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    LiveDeployEnsureDependency { dep: _ } =>
      IncompatibleCell { reason: "host_effect: LiveDeployEnsureDependency is in-band (actuator host shell mutation) and cannot target BmcController (out-of-band Redfish only); target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    LiveDeployDigestReadback { port: _, expected_digest: _ } =>
      IncompatibleCell { reason: "host_effect: LiveDeployDigestReadback is in-band (actuator host shell readback) and cannot target BmcController (out-of-band Redfish only); target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    LiveDeployServeRoute { endpoint: _, enabled: _ } =>
      IncompatibleCell { reason: "host_effect: LiveDeployServeRoute is in-band (actuator host shell mutation) and cannot target BmcController (out-of-band Redfish only); target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    EnsureActionsRunnerRelease { runner_release: _ } =>
      IncompatibleCell { reason: "host_effect: EnsureActionsRunnerRelease is in-band (runner lifecycle on HostOs) and cannot target BmcController; target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    EnsureRunnerSlotDirectory { slot: _, artifact: _ } =>
      IncompatibleCell { reason: "host_effect: EnsureRunnerSlotDirectory is in-band (runner lifecycle on HostOs) and cannot target BmcController; target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    EnsureRunnerJitWrapper { host_label: _ } =>
      IncompatibleCell { reason: "host_effect: EnsureRunnerJitWrapper is in-band (runner lifecycle on HostOs) and cannot target BmcController; target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    EnsureRunnerSystemdTemplate { host_label: _ } =>
      IncompatibleCell { reason: "host_effect: EnsureRunnerSystemdTemplate is in-band (runner lifecycle on HostOs) and cannot target BmcController; target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    EnsureRunnerMemoryCaps { slot: _ } =>
      IncompatibleCell { reason: "host_effect: EnsureRunnerMemoryCaps is in-band (runner lifecycle on HostOs) and cannot target BmcController; target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    ActivateRunnerSlot { slot: _ } =>
      IncompatibleCell { reason: "host_effect: ActivateRunnerSlot is in-band (runner lifecycle on HostOs) and cannot target BmcController; target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    DrainAndMaskRunnerSlot { slot: _ } =>
      IncompatibleCell { reason: "host_effect: DrainAndMaskRunnerSlot is in-band (runner lifecycle on HostOs) and cannot target BmcController; target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    ReplaceRunnerIncarnation { from: _, cause: _ } =>
      IncompatibleCell { reason: "host_effect: ReplaceRunnerIncarnation is in-band (runner lifecycle on HostOs) and cannot target BmcController; target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    ObserveRunnerLocalState { slot: _ } =>
      IncompatibleCell { reason: "host_effect: ObserveRunnerLocalState is in-band (runner lifecycle on HostOs) and cannot target BmcController; target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    ObserveGitHubRunnerRegistration { slot: _, organization: _ } =>
      IncompatibleCell { reason: "host_effect: ObserveGitHubRunnerRegistration is in-band (runner lifecycle on HostOs) and cannot target BmcController; target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
    ProbeToolchainHomeInterference {} =>
      IncompatibleCell { reason: "host_effect: ProbeToolchainHomeInterference is an in-band concurrent filesystem/tool-execution probe and cannot target BmcController; target HostOs instead." }
    DeployAccessPreflight {} =>
      IncompatibleCell { reason: "host_effect: DeployAccessPreflight is intent-only (authorization gate record) and cannot target BmcController; typed mismatch, DESIGN section 5." }
  }
}

fn resolve_host_effect_cell(target: NodeControlPlane, effect: HostEffect) -> ResolvedHostEffectCell {
  match target {
    RunnerLocalHost =>
      match effect {
        ProbeToolchainHomeInterference {} => ToolchainHomeInterferenceProbeOnHost
        RedfishAction { action: _ } => IncompatibleCell { reason: "host_effect: RunnerLocalHost admits only ProbeToolchainHomeInterference; fleet-addressed effects require HostOs or BmcController." }
        ConvergePlan { policy: _ } => IncompatibleCell { reason: "host_effect: RunnerLocalHost admits only ProbeToolchainHomeInterference; fleet-addressed effects require HostOs or BmcController." }
        OsInstallActuatorToolchainEnsure {} => IncompatibleCell { reason: "host_effect: RunnerLocalHost admits only ProbeToolchainHomeInterference; fleet-addressed effects require HostOs or BmcController." }
        EnsureBuildCacheInstance { desired: _ } => IncompatibleCell { reason: "host_effect: RunnerLocalHost admits only ProbeToolchainHomeInterference; fleet-addressed effects require HostOs or BmcController." }
        ProvisionCodexRuntime {} => IncompatibleCell { reason: "host_effect: RunnerLocalHost admits only ProbeToolchainHomeInterference; fleet-addressed effects require HostOs or BmcController." }
        EnsureCompilePoolSlice {} => IncompatibleCell { reason: "host_effect: RunnerLocalHost admits only ProbeToolchainHomeInterference; fleet-addressed effects require HostOs or BmcController." }
        SetHostnameCas { hostnamectl_path: _, base: _, desired: _ } => IncompatibleCell { reason: "host_effect: RunnerLocalHost admits only ProbeToolchainHomeInterference; fleet-addressed effects require HostOs or BmcController." }
        ReadEffectivePosixPrincipal { read: _ } => IncompatibleCell { reason: "host_effect: RunnerLocalHost admits only ProbeToolchainHomeInterference; fleet-addressed effects require HostOs or BmcController." }
        SudoNopasswdExecuteProbe { probe: _ } => IncompatibleCell { reason: "host_effect: RunnerLocalHost admits only ProbeToolchainHomeInterference; fleet-addressed effects require HostOs or BmcController." }
        SudoNopasswdGrantListProbe { probe: _ } => IncompatibleCell { reason: "host_effect: RunnerLocalHost admits only ProbeToolchainHomeInterference; fleet-addressed effects require HostOs or BmcController." }
        Srv3InstallMediaFetch => IncompatibleCell { reason: "host_effect: RunnerLocalHost admits only ProbeToolchainHomeInterference; fleet-addressed effects require HostOs or BmcController." }
        Srv3SeededInstallMediaRemaster => IncompatibleCell { reason: "host_effect: RunnerLocalHost admits only ProbeToolchainHomeInterference; fleet-addressed effects require HostOs or BmcController." }
        Srv3SeededInstallMediaToolchainEnsure => IncompatibleCell { reason: "host_effect: RunnerLocalHost admits only ProbeToolchainHomeInterference; fleet-addressed effects require HostOs or BmcController." }
        Srv3BmcwebSessionLogin { request_body_file: _ } => IncompatibleCell { reason: "host_effect: RunnerLocalHost admits only ProbeToolchainHomeInterference; fleet-addressed effects require HostOs or BmcController." }
        Srv3BmcwebTokenExtract => IncompatibleCell { reason: "host_effect: RunnerLocalHost admits only ProbeToolchainHomeInterference; fleet-addressed effects require HostOs or BmcController." }
        Srv3NbdProxyServe { intent: _, lease_key: _ } => IncompatibleCell { reason: "host_effect: RunnerLocalHost admits only ProbeToolchainHomeInterference; fleet-addressed effects require HostOs or BmcController." }
