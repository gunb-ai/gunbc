        LiveDeployDigestReadback { port: p, expected_digest: d } =>
          LiveDeployDigestReadbackOnHost { node: n, port: p, expected_digest: d }
        LiveDeployServeRoute { endpoint: e, enabled: route_enabled } =>
          LiveDeployServeRouteOnHost { node: n, endpoint: e, enabled: route_enabled }
        ProbeToolchainHomeInterference {} =>
          IncompatibleCell { reason: "host_effect: ProbeToolchainHomeInterference is runner-local and cannot name a fleet HostOs; target RunnerLocalHost instead." }
        RedfishAction { action: _ } => resolve_host_os_effect_cell_after_direct_arms(n: n, effect: effect)
        ConvergePlan { policy: _ } => resolve_host_os_effect_cell_after_direct_arms(n: n, effect: effect)
        SetHostnameCas { hostnamectl_path: _, base: _, desired: _ } => resolve_host_os_effect_cell_after_direct_arms(n: n, effect: effect)
        ReadEffectivePosixPrincipal { read: _ } => resolve_host_os_effect_cell_after_direct_arms(n: n, effect: effect)
        SudoNopasswdExecuteProbe { probe: _ } => resolve_host_os_effect_cell_after_direct_arms(n: n, effect: effect)
        SudoNopasswdGrantListProbe { probe: _ } => resolve_host_os_effect_cell_after_direct_arms(n: n, effect: effect)
        Srv3InstallMediaFetch => resolve_host_os_effect_cell_after_direct_arms(n: n, effect: effect)
        Srv3SeededInstallMediaRemaster => resolve_host_os_effect_cell_after_direct_arms(n: n, effect: effect)
        Srv3NbdProxyServe { intent: _, lease_key: _ } => resolve_host_os_effect_cell_after_direct_arms(n: n, effect: effect)
        CodexSupervisedWorkerTurn { intent: _, lease_key: _ } => resolve_host_os_effect_cell_after_direct_arms(n: n, effect: effect)
        HostIdentityShortHostnameRead => resolve_host_os_effect_cell_after_direct_arms(n: n, effect: effect)
        DeployAccessPreflight {} => resolve_host_os_effect_cell_after_direct_arms(n: n, effect: effect)
        EnsureActionsRunnerRelease { runner_release: _ } => resolve_host_os_effect_cell_after_direct_arms(n: n, effect: effect)
        EnsureRunnerSlotDirectory { slot: _, artifact: _ } => resolve_host_os_effect_cell_after_direct_arms(n: n, effect: effect)
        EnsureRunnerJitWrapper { host_label: _ } => resolve_host_os_effect_cell_after_direct_arms(n: n, effect: effect)
        EnsureRunnerSystemdTemplate { host_label: _ } => resolve_host_os_effect_cell_after_direct_arms(n: n, effect: effect)
        EnsureRunnerMemoryCaps { slot: _ } => resolve_host_os_effect_cell_after_direct_arms(n: n, effect: effect)
        ActivateRunnerSlot { slot: _ } => resolve_host_os_effect_cell_after_direct_arms(n: n, effect: effect)
        DrainAndMaskRunnerSlot { slot: _ } => resolve_host_os_effect_cell_after_direct_arms(n: n, effect: effect)
        ReplaceRunnerIncarnation { from: _, cause: _ } => resolve_host_os_effect_cell_after_direct_arms(n: n, effect: effect)
        ObserveRunnerLocalState { slot: _ } => resolve_host_os_effect_cell_after_direct_arms(n: n, effect: effect)
        ObserveGitHubRunnerRegistration { slot: _, organization: _ } => resolve_host_os_effect_cell_after_direct_arms(n: n, effect: effect)
      }
    BmcController { node: n } =>
      match effect {
        OsInstallActuatorToolchainEnsure {} =>
          IncompatibleCell { reason: "host_effect: OsInstallActuatorToolchainEnsure is in-band (actuator host toolchain) and cannot target BmcController; target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
        EnsureBuildCacheInstance { desired: _ } =>
          IncompatibleCell { reason: "host_effect: EnsureBuildCacheInstance is in-band (per-host sccache daemon) and cannot target BmcController; target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
        ProvisionCodexRuntime {} =>
          IncompatibleCell { reason: "host_effect: ProvisionCodexRuntime is in-band (per-host provider runtime bundle) and cannot target BmcController; target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
        EnsureCompilePoolSlice {} =>
          IncompatibleCell { reason: "host_effect: EnsureCompilePoolSlice is in-band (per-host systemd slice) and cannot target BmcController; target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
        Srv3NbdProxyServe { intent: _, lease_key: _ } =>
          IncompatibleCell { reason: "host_effect: Srv3NbdProxyServe is in-band (actuator host long-running session) and cannot target BmcController (out-of-band Redfish only); target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
        CodexSupervisedWorkerTurn { intent: _, lease_key: _ } =>
          IncompatibleCell { reason: "host_effect: CodexSupervisedWorkerTurn is in-band (actuator host app-server stdio session) and cannot target BmcController (out-of-band Redfish only); target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
        RedfishAction { action: _ } => resolve_bmc_controller_effect_cell_after_direct_arms(n: n, effect: effect)
        ConvergePlan { policy: _ } => resolve_bmc_controller_effect_cell_after_direct_arms(n: n, effect: effect)
        SetHostnameCas { hostnamectl_path: _, base: _, desired: _ } => resolve_bmc_controller_effect_cell_after_direct_arms(n: n, effect: effect)
        ReadEffectivePosixPrincipal { read: _ } => resolve_bmc_controller_effect_cell_after_direct_arms(n: n, effect: effect)
        SudoNopasswdExecuteProbe { probe: _ } => resolve_bmc_controller_effect_cell_after_direct_arms(n: n, effect: effect)
        SudoNopasswdGrantListProbe { probe: _ } => resolve_bmc_controller_effect_cell_after_direct_arms(n: n, effect: effect)
        Srv3InstallMediaFetch => resolve_bmc_controller_effect_cell_after_direct_arms(n: n, effect: effect)
        Srv3SeededInstallMediaRemaster => resolve_bmc_controller_effect_cell_after_direct_arms(n: n, effect: effect)
        Srv3SeededInstallMediaToolchainEnsure => resolve_bmc_controller_effect_cell_after_direct_arms(n: n, effect: effect)
        Srv3BmcwebSessionLogin { request_body_file: _ } => resolve_bmc_controller_effect_cell_after_direct_arms(n: n, effect: effect)
        Srv3BmcwebTokenExtract => resolve_bmc_controller_effect_cell_after_direct_arms(n: n, effect: effect)
        Srv3BootOnceReadBackSleep => resolve_bmc_controller_effect_cell_after_direct_arms(n: n, effect: effect)
        Srv3ReceiptEmit { lines: _ } => resolve_bmc_controller_effect_cell_after_direct_arms(n: n, effect: effect)
        HostIdentityShortHostnameRead => resolve_bmc_controller_effect_cell_after_direct_arms(n: n, effect: effect)
        LiveDeployApply { warrant: _ } => resolve_bmc_controller_effect_cell_after_direct_arms(n: n, effect: effect)
        LiveDeployRetract { spec: _ } => resolve_bmc_controller_effect_cell_after_direct_arms(n: n, effect: effect)
        LiveDeployApprovalBrokerDarkInstall { spec: _, candidate: _ } => resolve_bmc_controller_effect_cell_after_direct_arms(n: n, effect: effect)
        LiveDeployMicrovmControllerInstall { candidate: _ } => resolve_bmc_controller_effect_cell_after_direct_arms(n: n, effect: effect)
        LiveDeployEnsureDependency { dep: _ } => resolve_bmc_controller_effect_cell_after_direct_arms(n: n, effect: effect)
        LiveDeployDigestReadback { port: _, expected_digest: _ } => resolve_bmc_controller_effect_cell_after_direct_arms(n: n, effect: effect)
        LiveDeployServeRoute { endpoint: _, enabled: _ } => resolve_bmc_controller_effect_cell_after_direct_arms(n: n, effect: effect)
        DeployAccessPreflight {} => resolve_bmc_controller_effect_cell_after_direct_arms(n: n, effect: effect)
        EnsureActionsRunnerRelease { runner_release: _ } => resolve_bmc_controller_effect_cell_after_direct_arms(n: n, effect: effect)
        EnsureRunnerSlotDirectory { slot: _, artifact: _ } => resolve_bmc_controller_effect_cell_after_direct_arms(n: n, effect: effect)
        EnsureRunnerJitWrapper { host_label: _ } => resolve_bmc_controller_effect_cell_after_direct_arms(n: n, effect: effect)
        EnsureRunnerSystemdTemplate { host_label: _ } => resolve_bmc_controller_effect_cell_after_direct_arms(n: n, effect: effect)
        EnsureRunnerMemoryCaps { slot: _ } => resolve_bmc_controller_effect_cell_after_direct_arms(n: n, effect: effect)
        ActivateRunnerSlot { slot: _ } => resolve_bmc_controller_effect_cell_after_direct_arms(n: n, effect: effect)
        DrainAndMaskRunnerSlot { slot: _ } => resolve_bmc_controller_effect_cell_after_direct_arms(n: n, effect: effect)
        ReplaceRunnerIncarnation { from: _, cause: _ } => resolve_bmc_controller_effect_cell_after_direct_arms(n: n, effect: effect)
        ObserveRunnerLocalState { slot: _ } => resolve_bmc_controller_effect_cell_after_direct_arms(n: n, effect: effect)
        ObserveGitHubRunnerRegistration { slot: _, organization: _ } => resolve_bmc_controller_effect_cell_after_direct_arms(n: n, effect: effect)
        ProbeToolchainHomeInterference {} => resolve_bmc_controller_effect_cell_after_direct_arms(n: n, effect: effect)
      }
  }
}

type ShellExecObserved {
  exit_code: Int
  success: Bool
  stdout: String
  stderr: String
}

fn shell_exec_failure_reason_headered(observed: ShellExecObserved, header: String) -> String {
  if observed.stdout == "" && observed.stderr == "" {
    header
  } else {
    concat(
      concat(concat(header, "\n--- stdout ---\n"), observed.stdout),
      concat("\n--- stderr ---\n", observed.stderr)
    )
  }
}

fn shell_exec_failure_reason(observed: ShellExecObserved) -> String {
  shell_exec_failure_reason_headered(
    observed: observed,
    header: concat(
      "host_effect_apply: shell exec returned a nonzero exit code (exit=",
      concat(to_string(observed.exit_code), "); fail-closed, no fabricated convergence"),
    ),
  )
}

fn srv3_shell_reconcile(
  observed: ShellExecObserved,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let grounding = if observed.success {
      Grounds { evidence: ShellEffectApplied { exit_code: observed.exit_code, stdout: observed.stdout, stderr: observed.stderr } }
    } else {
      DoesNotGround {
        reason: shell_exec_failure_reason_headered(
          observed: observed,
          header: "host_effect_apply: srv3 shell exec returned a nonzero exit code; fail-closed",
        ),
      }
    }
  reconcile_grounded(
    apply_effect: intent,
    show_read: ReadObserved { value: observed },
    grounding: grounding
  )
}

fn host_effect_join_lines(lines: List<String>) -> String {
  fold(
    lines,
    init: "",
    f: (acc, line) => if acc == "" { line } else { concat(acc, concat("\n", line)) },
  )
}

fn realize_receipt_emit_on_host(
  lines: List<String>,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  srv3_shell_reconcile(
    observed: ShellExecObserved {
      exit_code: 0,
      success: true,
      stdout: host_effect_join_lines(lines: lines),
      stderr: "",
    },
    intent: intent,
  )
}

fn realize_boot_once_read_back_sleep_body(
  transport: HostEffectTransport,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let seconds = to_string(second_count(s: srv3_boot_once_apply_read_back_sleep))
  match srv3_run_tool_by_name(
    tool: sleep_cli_tool,
    args: [seconds],
    transport: transport,
  ) {
    Srv3PredicateUnobserved { reason: why } =>
      NotConverged {
        reason: concat(
          "host_effect_apply: Srv3BootOnceReadBackSleep could not observe sleep on this transport, so the read-back delay was never taken and no verdict is claimed: ",
          why,
        ),
        applied: intent,
      }
    Srv3PredicateHolds =>
      srv3_shell_reconcile(
        observed: ShellExecObserved { exit_code: 0, success: true, stdout: "", stderr: "" },
        intent: intent,
      )
    Srv3PredicateFails =>
      srv3_shell_reconcile(
        observed: ShellExecObserved {
          exit_code: 1,
          success: false,
          stdout: "",
          stderr: "host_effect_apply: Srv3BootOnceReadBackSleep sleep failed; fail-closed",
        },
        intent: intent,
      )
  }
}

fn realize_boot_once_read_back_sleep_on_host(
  transport: HostEffectTransport,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match transport {
    LocalShell =>
      realize_boot_once_read_back_sleep_body(transport: transport, intent: intent)
    SshShell { ssh_host: _ } =>
      realize_boot_once_read_back_sleep_body(transport: transport, intent: intent)
    FleetSsh { target: _, context: _ } =>
      realize_boot_once_read_back_sleep_body(transport: transport, intent: intent)
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      NotConverged {
        reason: "host_effect_apply: Srv3BootOnceReadBackSleep cannot use EmitArtifactThenThinRun transport; typed mismatch.",
        applied: intent,
      }
  }
}

fn srv3_seeded_install_media_toolchain_receipt_line(outcome: NonEmptyStr) -> String {
  concat(
    concat("InstallMediaRemasterToolchainReceipt: outcome=", outcome as String),
    concat(
      concat(" tool=", xorriso_cli_tool.program.invocation as String),
      concat(" package=", package_xorriso as String),
    ),
  )
}

fn srv3_seeded_install_media_toolchain_privileged_apt_install_is_gated() -> Bool {
  let elevated = sudo_elevate(command: srv3_actuator_toolchain_apt_install_command(package: package_xorriso))
  elevated.bin_path == sudo_program().invocation as String &&
    elevated.args == ["-n", apt_get_binary_path as String, "install", "-y", package_xorriso as String]
}

// THE RECEIPT NAMES WHICH ARM THE ACTUATOR TOOK, so the probe that decides it must run BEFORE
// the ensure. Probing after would make a fresh install re-observe Holds and report "Present",
// collapsing the Present/Installed distinction on exactly the path where it carries information
// -- a receipt that is true about the end state and false about what was done to reach it.
//
// The pre-state probe gets the same three-valued treatment as every other probe here: a
// pre-state that could not be observed refuses the whole effect rather than defaulting to
// was_present: false, which would claim an install happened on a host that was never asked.
// The pre-state probe reaches presence and version through srv3_probe_present_then_version rather
// than srv3_predicate_all: predicate_all takes a LIST, and a list argument is built eagerly, so
// passing both probes to it runs the version probe even when presence has already failed. The
// pre-cut code short-circuited through &&. Same class as the install-in-argument-position
// regression on srv3_ensure_apt_tool -- read-only rather than privileged, so a cost defect not a
// safety one, but DESIGN's bare-minimum-cost rule fixes a proven cost shape regardless of n.
fn realize_seeded_install_media_toolchain_ensure_body(
  transport: HostEffectTransport,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match srv3_probe_present_then_version(tool: xorriso_cli_tool, transport: transport) {
    Srv3PredicateUnobserved { reason: why } =>
      NotConverged {
        reason: concat(
          "host_effect_apply: Srv3SeededInstallMediaToolchainEnsure could not observe xorriso's pre-state on this transport, so no install was attempted and no receipt is claimed: ",
          why,
        ),
        applied: intent,
      }
    Srv3PredicateHolds =>
      srv3_seeded_install_media_toolchain_ensure_after_pre(
        was_present: true,
        transport: transport,
        intent: intent,
      )
    Srv3PredicateFails =>
      srv3_seeded_install_media_toolchain_ensure_after_pre(
        was_present: false,
        transport: transport,
        intent: intent,
      )
  }
}

fn srv3_seeded_install_media_toolchain_ensure_after_pre(
  was_present: Bool,
  transport: HostEffectTransport,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match srv3_ensure_apt_tool(
    tool: xorriso_cli_tool,
    package: package_xorriso,
    require_version_probe: true,
    transport: transport,
  ) {
    Srv3PredicateUnobserved { reason: why } =>
      NotConverged {
        reason: concat(
          "host_effect_apply: Srv3SeededInstallMediaToolchainEnsure could not observe the ensure outcome for xorriso, so no receipt is claimed: ",
          why,
        ),
        applied: intent,
      }
    Srv3PredicateHolds =>
      srv3_seeded_install_media_toolchain_ensure_receipt(
        was_present: was_present,
        ensure_ok: true,
        intent: intent,
      )
    Srv3PredicateFails =>
      srv3_seeded_install_media_toolchain_ensure_receipt(
        was_present: was_present,
        ensure_ok: false,
        intent: intent,
      )
  }
}

fn srv3_seeded_install_media_toolchain_ensure_receipt(
  was_present: Bool,
  ensure_ok: Bool,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let outcome = if was_present { "Present" } else { "Installed" }
  let stdout = srv3_seeded_install_media_toolchain_receipt_line(outcome: outcome as NonEmptyStr)
  srv3_shell_reconcile(
    observed: ShellExecObserved {
      exit_code: if ensure_ok { 0 } else { 1 },
      success: ensure_ok,
      stdout: stdout,
      stderr: if ensure_ok {
        ""
      } else {
        "host_effect_apply: Srv3SeededInstallMediaToolchainEnsure xorriso ensure failed; fail-closed"
      },
    },
    intent: intent,
  )
}

fn realize_seeded_install_media_toolchain_ensure_on_host(
  transport: HostEffectTransport,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match transport {
    LocalShell =>
      realize_seeded_install_media_toolchain_ensure_body(transport: transport, intent: intent)
    SshShell { ssh_host: _ } =>
      realize_seeded_install_media_toolchain_ensure_body(transport: transport, intent: intent)
    FleetSsh { target: _, context: _ } =>
      realize_seeded_install_media_toolchain_ensure_body(transport: transport, intent: intent)
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      NotConverged {
        reason: "host_effect_apply: Srv3SeededInstallMediaToolchainEnsure cannot use EmitArtifactThenThinRun transport; typed mismatch.",
        applied: intent,
      }
  }
}

// The login is a described curl command minted at extdeps.tools.curl (the tool's own module);
// this site supplies only the paths its materialization bracket owns and runs the FLAGS through
// srv3_run_tool_by_name, which resolves the program from the same cited curl_cli_tool row the
// builder's identity carries.
// THE BODY PATH ARRIVES ON THE EFFECT. It names the owner-only file the caller's
// gunbc.auth.private_secret_file bracket created in a per-run private directory and removes when the
// login returns. It used to be the fixed constant /tmp/srv3_bmcweb_login_body.json, written with
// the ambient umask and never removed, so after a login the BMC password stayed in /tmp.
fn realize_bmcweb_session_login_body(
  transport: HostEffectTransport,
  intent: HostEffectIntent,
  request_body_file: NonEmptyStr,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let login = curl_bmcweb_session_login_command(
    bmc_host: asrock_srv3_live_bmc_host,
    request_body_file: request_body_file,
    response_path: srv3_bmcweb_login_response_path as NonEmptyStr,
  )
  match srv3_run_tool_by_name(
    tool: curl_cli_tool,
    args: login.arguments,
    transport: transport,
  ) {
    Srv3PredicateUnobserved { reason: why } =>
      NotConverged {
        reason: concat(
          "host_effect_apply: Srv3BmcwebSessionLogin could not observe curl on this transport, so no login was attempted and no verdict is claimed: ",
          why,
        ),
        applied: intent,
      }
    Srv3PredicateHolds =>
      srv3_shell_reconcile(
        observed: ShellExecObserved { exit_code: 0, success: true, stdout: "", stderr: "" },
        intent: intent,
      )
    Srv3PredicateFails =>
      srv3_shell_reconcile(
        observed: ShellExecObserved {
          exit_code: 1,
          success: false,
          stdout: "",
          stderr: "host_effect_apply: Srv3BmcwebSessionLogin curl login failed; fail-closed",
        },
        intent: intent,
      )
  }
}

fn realize_bmcweb_session_login_on_host(
  transport: HostEffectTransport,
  intent: HostEffectIntent,
  request_body_file: NonEmptyStr,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match transport {
    LocalShell =>
      realize_bmcweb_session_login_body(transport: transport, intent: intent, request_body_file: request_body_file)
    SshShell { ssh_host: _ } =>
      realize_bmcweb_session_login_body(transport: transport, intent: intent, request_body_file: request_body_file)
    FleetSsh { target: _, context: _ } =>
      realize_bmcweb_session_login_body(transport: transport, intent: intent, request_body_file: request_body_file)
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      NotConverged {
        reason: "host_effect_apply: Srv3BmcwebSessionLogin cannot use EmitArtifactThenThinRun transport; typed mismatch.",
        applied: intent,
      }
  }
}

// THE VERDICT IS PRODUCED BEFORE THE WRITE, NOT CHECKED AFTER IT (DESIGN §5).
// This extraction ran a `jq -r` filter of `.token` falling back to `empty` via jq's
// alternative operator (two literal slashes in the filter text, elided here so this
// comment itself stays parseable), and that alternative makes an ABSENT or NULL
// `.token` a run that prints nothing and exits 0 — indistinguishable, at the exit
// status the caller reads, from a token that was found. The realization then wrote
// jq_run.stdout to srv3_bmcweb_token_path unconditionally and reconciled on the WRITE's
// success, so a rejected or malformed BMC login produced an EMPTY CREDENTIAL FILE reported
// as Converged: the fabricated plausible output DESIGN §5 forbids, at a credential seam.
// BmcwebTokenExtraction, not the flag, is the wall. `-e` is loudness at the transport — jq
// exits 1 on a null/false last output and 4 when the filter produced none, so jq itself
// reports the absence instead of leaving the caller to infer it from empty output — but it
// is deliberately NOT what this fold relies on, for two reasons. `-e` reads the LAST OUTPUT,
// so on an arbitrary filter it would convert a legitimate `false` or `null` extraction into
// a failure; that is why it belongs at this site, where a token is required to be a nonempty
// string, and not as a blanket flag on a general extraction operation. And `-e` still admits
// the EMPTY STRING, which is a token this seam must refuse — so the blank arm below is
// load-bearing and the flag is defence in depth. Absence has no path to Filesystem.Write
// under either. The fix is not a
// non-empty check after the write, because such a check concedes the empty file is writable
// and was in fact satisfied by editing nothing (it lived in gunbc.srv3.srv3_os_install_actuate
// `srv3_bmcweb_login` as a shell.Test.IsNonEmpty on the file this fold had just produced,
// and is deleted with this climb per DESIGN §4b dissolution-on-climb).
type BmcwebTokenExtraction =
  | BmcwebTokenExtracted { token: NonEmptyStr }
  | BmcwebTokenExtractRefused { reason: String }

fn bmcweb_token_extract_jq_args(response_path: String) -> List<String> {
  ["-e", "-r", ".token", response_path]
}

fn bmcweb_token_extraction_verdict(jq_success: Bool, jq_stdout: String) -> BmcwebTokenExtraction {
  if jq_success {
    let token = trim(s: jq_stdout)
    if token == "" {
      BmcwebTokenExtractRefused {
        reason: "host_effect_apply: Srv3BmcwebTokenExtract jq -e exited zero but produced no token text for `.token` in the bmcweb login response; fail-closed, no token file written.",
      }
    } else {
      BmcwebTokenExtracted { token: token as NonEmptyStr }
    }
  } else {
    BmcwebTokenExtractRefused {
      reason: "host_effect_apply: Srv3BmcwebTokenExtract jq -e refused: `.token` is absent, null or false in the bmcweb login response (a rejected or malformed BMC login); fail-closed, no token file written.",
    }
  }
}

fn realize_bmcweb_token_extract_body(
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match srv3_tool_bin_path(tool: jq_cli_tool, transport: LocalShell) {
    Srv3TokenObserved { value: jq_path } => {
      let jq_run = gunbc.WitnessBin.Run(
        workdir: "/",
        bin_path: jq_path,
        args: bmcweb_token_extract_jq_args(response_path: srv3_bmcweb_login_response_path),
      )
      match bmcweb_token_extraction_verdict(jq_success: jq_run.success, jq_stdout: jq_run.stdout) {
        BmcwebTokenExtracted { token: token } => {
          let write = Filesystem.Write(path: srv3_bmcweb_token_path, content: token as String)
          srv3_shell_reconcile(
            observed: ShellExecObserved {
              exit_code: if write.success { 0 } else { 1 },
              success: write.success,
              stdout: "",
              stderr: if write.success {
                ""
              } else {
                "host_effect_apply: Srv3BmcwebTokenExtract token write failed; fail-closed"
              },
            },
            intent: intent,
          )
        }
        BmcwebTokenExtractRefused { reason: why } =>
          srv3_shell_reconcile(
            observed: ShellExecObserved {
              exit_code: 1,
              success: false,
              stdout: "",
              stderr: why,
            },
            intent: intent,
          )
      }
    }
    Srv3TokenAbsent =>
      srv3_shell_reconcile(
        observed: ShellExecObserved {
          exit_code: 1,
          success: false,
          stdout: "",
          stderr: "host_effect_apply: Srv3BmcwebTokenExtract jq not found; fail-closed",
        },
        intent: intent,
      )
    Srv3TokenUnobserved { reason: why } =>
      NotConverged {
        reason: concat(
          "host_effect_apply: Srv3BmcwebTokenExtract could not observe jq, so no extraction was attempted and no token file is claimed: ",
          why,
        ),
        applied: intent,
      }
  }
}

fn realize_bmcweb_token_extract_on_host(
  transport: HostEffectTransport,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match transport {
    LocalShell =>
      realize_bmcweb_token_extract_body(intent: intent)
    SshShell { ssh_host: _ } =>
      NotConverged {
        reason: "host_effect_apply: Srv3BmcwebTokenExtract runs typed jq argv + Filesystem.Write on the executor host; SshShell transport is a fail-closed Unimplemented stub until remote extract+write is realized with structured bin invocation.",
        applied: intent,
      }
    FleetSsh { target: _, context: _ } =>
      NotConverged {
        reason: "host_effect_apply: Srv3BmcwebTokenExtract runs typed jq argv + Filesystem.Write on the executor host; SshShell transport is a fail-closed Unimplemented stub until remote extract+write is realized with structured bin invocation.",
        applied: intent,
      }
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      NotConverged {
        reason: "host_effect_apply: Srv3BmcwebTokenExtract cannot use EmitArtifactThenThinRun transport; typed mismatch.",
        applied: intent,
      }
  }
}

data toolchain_ensure_reconcile_located_note: String = "The refusal names the effect that produced it. This fold was written for OsInstallActuatorToolchainEnsure and hardcoded that effect in its failure header; when ProvisionBuildCache started reusing it (P1b:build-cache-provision), every build-cache refusal reported itself as an OS-install-actuator failure — a located diagnostic pointing at the wrong location, which is the §5 'typed, located' bar failing at the second half. The header is now a parameter supplied by each realize arm."

fn toolchain_ensure_reconcile(
  observed: ShellExecObserved,
  intent: HostEffectIntent,
  effect_label: String,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let grounding = if observed.success {
      Grounds { evidence: ShellEffectApplied { exit_code: observed.exit_code, stdout: observed.stdout, stderr: observed.stderr } }
    } else {
      DoesNotGround {
        reason: shell_exec_failure_reason_headered(
          observed: observed,
          header: join(
            [
              "host_effect_apply: ",
              effect_label,
              " synthesized receipt from typed per-tool ensure results; fail-closed",
            ],
            "",
          ),
        ),
      }
    }
  reconcile_grounded(
    apply_effect: intent,
    show_read: ReadObserved { value: observed },
    grounding: grounding
  )
}

fn srv3_toolchain_ensure_reconcile(
  observed: ShellExecObserved,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  toolchain_ensure_reconcile(
    observed: observed,
    intent: intent,
    effect_label: "OsInstallActuatorToolchainEnsure",
  )
}

fn provision_build_cache_reconcile(
  observed: ShellExecObserved,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  toolchain_ensure_reconcile(
    observed: observed,
    intent: intent,
    effect_label: "EnsureBuildCacheInstance",
  )
}

// ProvisionCodexRuntime observe/materialize/read-back replaced the concat-built bash body of the
// now-deleted host_codex_runtime_provision_script.dag with three typed single-command steps:
// LocalShell dispatches through the existing typed argv services gunbc.WitnessBin.Run
// (observe/read-back) and gunbc.Cli.Run (materialize) — argv arrays, not a shell string, so there
// is no branching or receipt-marker text to construct or parse; SshShell/FleetSsh dispatch through
// run_typed_argv_transport with the same argv shape built by
// gunbc.host.host_codex_runtime_provision_verdict codex_runtime_observe_argv and gunbc.cli_invoke
// gunbc_run_transport_argv. The mkdir-release-parent step the old shell body ran before materialize
// is dropped: gunbc.package_delivery release_codex_runtime_bundle_immutable already runs
// shell.Mkdir.Parents on release_parent inside materialize_codex_runtime_bundle's own call chain,
// so a second mkdir ahead of it was redundant work (DESIGN §2), not preserved behavior. Read-back
// reuses the observe step verbatim — 'we ran materialize' is never treated as 'it is installed';
// only a second successful --version probe that satisfies codex_runtime_version_identity_satisfied
// converges.

type CodexRuntimeStepResult
  = CodexRuntimeStepRan { observed: ShellExecObserved }
  | CodexRuntimeStepRefused { reason: String }

fn codex_runtime_typed_argv_step(
  argv: List<String>,
  transport: HostEffectTransport,
) -> CodexRuntimeStepResult {
  match run_typed_argv_transport(argv: argv, transport: transport) {
    TypedArgvExecConverged { result: r } =>
      CodexRuntimeStepRan {
        observed: ShellExecObserved { exit_code: r.exit_code, success: r.success, stdout: r.stdout, stderr: r.stderr },
      }
    TypedArgvExecRefused { reason: why } => CodexRuntimeStepRefused { reason: why }
  }
}

fn codex_runtime_observe_step(
  transport: HostEffectTransport,
  executable: FilePath,
) -> CodexRuntimeStepResult {
  match transport {
    LocalShell => {
      let r = gunbc.WitnessBin.Run(workdir: "/" as FilePath, bin_path: executable, args: ["--version"])
      CodexRuntimeStepRan {
        observed: ShellExecObserved { exit_code: r.exit_code, success: r.success, stdout: r.stdout, stderr: r.stderr },
      }
    }
    SshShell { ssh_host: _ } =>
      codex_runtime_typed_argv_step(
        argv: codex_runtime_observe_argv(executable: executable as String),
        transport: transport,
      )
    FleetSsh { target: _, context: _ } =>
      codex_runtime_typed_argv_step(
        argv: codex_runtime_observe_argv(executable: executable as String),
        transport: transport,
      )
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      CodexRuntimeStepRefused {
        reason: "host_effect_apply: ProvisionCodexRuntime cannot use EmitArtifactThenThinRun transport; typed mismatch.",
      }
  }
}

data codex_runtime_materialize_source_roots: List<String> = ["dag", "src/v2"]
data codex_runtime_materialize_entry: String = "dag/gunbc/host/host_codex_runtime_provision.dag"
data codex_runtime_materialize_function: String = "materialize_codex_runtime_on_local_host"

fn codex_runtime_materialize_step(
  transport: HostEffectTransport,
  gunbc_binary: FilePath,
  gunbc_repo: FilePath,
) -> CodexRuntimeStepResult {
  match transport {
    LocalShell => {
      let r = gunbc.Cli.Run(
        workdir: gunbc_repo,
        bin_path: gunbc_binary,
        source_roots: codex_runtime_materialize_source_roots,
        entry: codex_runtime_materialize_entry,
        function: codex_runtime_materialize_function,
        claim_run: false,
      )
      CodexRuntimeStepRan {
        observed: ShellExecObserved { exit_code: r.exit_code, success: r.success, stdout: r.stdout, stderr: r.stderr },
      }
    }
    SshShell { ssh_host: _ } =>
      codex_runtime_typed_argv_step(
        argv: concat(
          [gunbc_binary as String],
          gunbc_run_transport_argv(
            source_roots: codex_runtime_materialize_source_roots,
            entry: codex_runtime_materialize_entry,
            function: codex_runtime_materialize_function,
            claim_run: false,
          ),
        ),
        transport: transport,
      )
    FleetSsh { target: _, context: _ } =>
      codex_runtime_typed_argv_step(
        argv: concat(
          [gunbc_binary as String],
          gunbc_run_transport_argv(
            source_roots: codex_runtime_materialize_source_roots,
            entry: codex_runtime_materialize_entry,
            function: codex_runtime_materialize_function,
            claim_run: false,
          ),
        ),
        transport: transport,
      )
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      CodexRuntimeStepRefused {
        reason: "host_effect_apply: ProvisionCodexRuntime cannot use EmitArtifactThenThinRun transport; typed mismatch.",
      }
  }
}

fn provision_codex_runtime_refuse(
  host: HostIdentity,
  observed: CodexRuntimeObservation,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match provision_codex_runtime_verdict(host: host, observed: observed) {
    ProvisionConverged { executable: _, version_line: _ } =>
      NotConverged {
        reason: "host_effect_apply: ProvisionCodexRuntime verdict unexpectedly converged from a refusal-classified observation; fail-closed.",
        applied: intent,
      }
    ProvisionRefused { cause: _, reason: reason } =>
      NotConverged { reason: reason as String, applied: intent }
  }
}

fn provision_codex_runtime_reconcile(
  host: HostIdentity,
  executable: FilePath,
  gunbc_binary: FilePath,
  gunbc_repo: FilePath,
  transport: HostEffectTransport,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match codex_runtime_observe_step(transport: transport, executable: executable) {
    CodexRuntimeStepRefused { reason: why } =>
      provision_codex_runtime_refuse(
        host: host,
        observed: CodexRuntimeTransportRefused { reason: why },
        intent: intent,
      )
    CodexRuntimeStepRan { observed: observe_result } =>
      if observe_result.success && codex_runtime_version_identity_satisfied(combined_output: observe_result.stdout) {
        toolchain_ensure_reconcile(observed: observe_result, intent: intent, effect_label: "ProvisionCodexRuntime")
      } else {
        match codex_runtime_materialize_step(transport: transport, gunbc_binary: gunbc_binary, gunbc_repo: gunbc_repo) {
          CodexRuntimeStepRefused { reason: why } =>
            provision_codex_runtime_refuse(
              host: host,
              observed: CodexRuntimeTransportRefused { reason: why },
              intent: intent,
            )
          CodexRuntimeStepRan { observed: materialize_result } =>
            if !materialize_result.success {
              provision_codex_runtime_refuse(
                host: host,
                observed: CodexRuntimeMaterializationFailed { reason: materialize_result.stderr },
                intent: intent,
              )
            } else {
              match codex_runtime_observe_step(transport: transport, executable: executable) {
                CodexRuntimeStepRefused { reason: why } =>
                  provision_codex_runtime_refuse(
                    host: host,
                    observed: CodexRuntimeTransportRefused { reason: why },
                    intent: intent,
                  )
                CodexRuntimeStepRan { observed: read_back_result } =>
                  if read_back_result.success
                    && codex_runtime_version_identity_satisfied(combined_output: read_back_result.stdout)
                  {
                    toolchain_ensure_reconcile(
                      observed: read_back_result,
                      intent: intent,
                      effect_label: "ProvisionCodexRuntime",
                    )
                  } else {
                    provision_codex_runtime_refuse(
                      host: host,
                      observed: CodexRuntimeIdentityMismatch {
                        observed_output: concat(read_back_result.stdout, concat(" ", read_back_result.stderr)),
                      },
                      intent: intent,
                    )
                  }
              }
            }
        }
      }
  }
}

fn provision_codex_runtime_target_host(effect_intent: HostEffectIntent) -> HostIdentity? {
  match effect_intent.target {
    HostOs { node: n } => Present { value: n.identity }
    BmcController { node: _ } => none
    RunnerLocalHost => none
  }
}

fn realize_provision_codex_runtime_body(
  transport: HostEffectTransport,
  effect_intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match provision_codex_runtime_target_host(effect_intent: effect_intent) {
    Absent =>
      NotConverged {
        reason: "host_effect_apply: ProvisionCodexRuntime requires HostOs target with a fleet host identity; fail-closed.",
        applied: effect_intent,
      }
    Present { value: host } =>
      match codex_bundled_executable_for_host(host: host) {
        Absent =>
          NotConverged {
            reason: join(
              [
                "host_effect_apply: ProvisionCodexRuntime refused — no bundled executable placement for host ",
                host as String,
                "; fail-closed.",
              ],
              "",
            ),
            applied: effect_intent,
          }
        Present { value: executable } =>
          match provider_runtime_placement_for_host(host: host) {
            Absent =>
              NotConverged {
                reason: join(
                  [
                    "host_effect_apply: ProvisionCodexRuntime refused — no provider runtime placement for host ",
                    host as String,
                    "; fail-closed.",
                  ],
                  "",
                ),
                applied: effect_intent,
              }
            Present { value: _ } =>
              provision_codex_runtime_reconcile(
                host: host,
                executable: executable,
                gunbc_binary: srv1_gunbc_serve_binary,
                gunbc_repo: srv1_gunbc_repo_root,
                transport: transport,
                intent: effect_intent,
              )
          }
      }
  }
}

fn realize_provision_codex_runtime_wrong_effect(
  effect_intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  NotConverged {
    reason: "host_effect_apply: realize_provision_codex_runtime requires ProvisionCodexRuntime effect",
    applied: effect_intent,
  }
}

fn realize_provision_codex_runtime(
  effect_intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match effect_intent.effect {
    ProvisionCodexRuntime {} =>
      match effect_intent.transport {
        LocalShell =>
          realize_provision_codex_runtime_body(
            transport: effect_intent.transport,
            effect_intent: effect_intent,
          )
        SshShell { ssh_host: _ } =>
          realize_provision_codex_runtime_body(
            transport: effect_intent.transport,
            effect_intent: effect_intent,
          )
        FleetSsh { target: _, context: _ } =>
          realize_provision_codex_runtime_body(
            transport: effect_intent.transport,
            effect_intent: effect_intent,
          )
        EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
          NotConverged {
            reason: "host_effect_apply: ProvisionCodexRuntime cannot use EmitArtifactThenThinRun transport; typed mismatch.",
            applied: effect_intent,
          }
      }
    RedfishAction { action: _ } => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    ConvergePlan { policy: _ } => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    OsInstallActuatorToolchainEnsure {} => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    EnsureBuildCacheInstance { desired: _ } => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    EnsureCompilePoolSlice {} => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    SetHostnameCas { hostnamectl_path: _, base: _, desired: _ } => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    ReadEffectivePosixPrincipal { read: _ } => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    SudoNopasswdExecuteProbe { probe: _ } => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    SudoNopasswdGrantListProbe { probe: _ } => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    Srv3InstallMediaFetch => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    Srv3SeededInstallMediaRemaster => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    Srv3SeededInstallMediaToolchainEnsure => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    Srv3BmcwebSessionLogin { request_body_file: _ } => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    Srv3BmcwebTokenExtract => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    Srv3NbdProxyServe { intent: _, lease_key: _ } => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    CodexSupervisedWorkerTurn { intent: _, lease_key: _ } => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    Srv3BootOnceReadBackSleep => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    Srv3ReceiptEmit { lines: _ } => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    HostIdentityShortHostnameRead => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    LiveDeployApply { warrant: _ } => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    LiveDeployRetract { spec: _ } => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    LiveDeployApprovalBrokerDarkInstall { spec: _, candidate: _ } => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    LiveDeployMicrovmControllerInstall { candidate: _ } => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    LiveDeployEnsureDependency { dep: _ } => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    LiveDeployDigestReadback { port: _, expected_digest: _ } => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    LiveDeployServeRoute { endpoint: _, enabled: _ } => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    DeployAccessPreflight {} => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    EnsureActionsRunnerRelease { runner_release: _ } => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    EnsureRunnerSlotDirectory { slot: _, artifact: _ } => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    EnsureRunnerJitWrapper { host_label: _ } => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    EnsureRunnerSystemdTemplate { host_label: _ } => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    EnsureRunnerMemoryCaps { slot: _ } => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    ActivateRunnerSlot { slot: _ } => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    DrainAndMaskRunnerSlot { slot: _ } => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    ReplaceRunnerIncarnation { from: _, cause: _ } => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    ObserveRunnerLocalState { slot: _ } => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    ObserveGitHubRunnerRegistration { slot: _, organization: _ } => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
    ProbeToolchainHomeInterference {} => realize_provision_codex_runtime_wrong_effect(effect_intent: effect_intent)
  }
}

// realize_os_install_actuator_toolchain_ensure refuses EmitArtifactThenThinRun at entry;
// srv3_actuator_toolchain_emit_artifact_transport_helper_refused false arms are fail-closed
// backstop only — not a silent widen (DESIGN §5). EmitArtifactThenThinRun defers execution to a
// materialized artifact run elsewhere, so an inline bin-witness probe has no host to observe;
// refusing here is a permanent boundary of that transport, not unmigrated debt.\n\nThe five probe
// leaves that used to build a concatenated shell command string (bin-witness success, test -x,
// which-based tool presence, which-based tool bin path, chown) now carry typed operation_argv rows
// and route SshShell and FleetSsh through typed_argv_exec_over_ssh / typed_argv_exec_over_fleet_ssh
// (gunbc.typed_argv_exec), the same wall the principal, sudo-probe and grant-list leaves already
// used. FleetSsh is admitted at realize_os_install_actuator_toolchain_ensure's entry gate.\n\nRUNG,
// STATED HONESTLY BECAUSE THE OBVIOUS READING OVERSTATES IT. The FleetSsh arms are compile-verified
// only: the match is exhaustive and each arm demonstrably reaches typed dispatch, but NO EXECUTING
// WITNESS DISCRIMINATES THEM, and the reason is structural rather than an omission. A
// FleetSshExecutionContext is reachable only through materialize_fleet_known_hosts_anchor, which is
// a `func` using Network, and the KnownHostsAnchor seal admits that one declaration alone -- so a
// pure `test fn` cannot construct the transport these arms match on. THE SEAL THAT MAKES A FLEET
// CONTEXT UNFORGEABLE ALSO MAKES IT UNFIXTURABLE. That is a real cost of the wall and it is
// recorded here rather than paid down by widening the wall, because admitting a test declaration to
// the seal to make one's own change testable is the trade a reviewer should refuse. NEXT-RUNG
// TRIGGER: a fixture route to a context that does not weaken the production seal -- an effect-level
// test harness for the materializer, not a second minter.

// THE THREE-VALUED COLLAPSE IS CLOSED. This is where the roster of five collapse sites and six
// consumers stood, together with its dissolution condition: "DISSOLVES WHEN the sites return an
// observation that preserves TypedArgvExecRefused". They do now -- Srv3HostPredicate and
// Srv3ObservedToken carry Unobserved with the reason the refusal already had -- so the roster and its
// shape check are deleted rather than left standing beside the thing they described.
//
// What the roster was right about, and what it could not make unwritable: it said a repair that
// changed the sites without changing the consumers would only move the collapse one call deeper.
// That is exactly what the first draft of this cut did, using a Bool projection to satisfy the
// typechecker at a call site. The projection is gone; the consumers match all three arms, and
// exhaustiveness is what keeps them matching them.

// A host probe answers one of three things, and the third is not a shade of the second:
// the predicate held, the predicate failed, or the transport could not carry the probe at all.
// Collapsing Unobserved into Fails is what let a refused probe read as "the tool is absent" and
// fall through to a privileged install on a host that had never been reached (DESIGN §5,
// fabricated negative; the empty-observation narrow in the failure-mode list).
type Srv3HostPredicate
  = Srv3PredicateHolds
  | Srv3PredicateFails
  | Srv3PredicateUnobserved { reason: String }

fn srv3_predicate_from_typed_argv(outcome: TypedArgvExecOutcome) -> Srv3HostPredicate {
  match outcome {
    TypedArgvExecConverged { result: r } =>
      if r.success { Srv3PredicateHolds } else { Srv3PredicateFails }
    TypedArgvExecRefused { reason: why } => Srv3PredicateUnobserved { reason: why }
  }
}

// The same three states for a probe whose answer is a VALUE rather than a verdict -- a resolved
// tool path, a uid, a gid: whatever single token the probe printed. Absent and Unobserved differ
// in remedy: the first says the host answered and had nothing, the second says the question was
// never put to the host.
//
// Named for the token and not for the tool path, because two consumers carry numeric ids through
// it. A carrier named Srv3ToolPath with a uid in its `path` field is a name that lies about its
// contents, which is the §3 concern applied to a field rather than a module (review 54189).
type Srv3ObservedToken
  = Srv3TokenObserved { value: String }
  | Srv3TokenAbsent
  | Srv3TokenUnobserved { reason: String }

fn srv3_observed_token_from_typed_argv(outcome: TypedArgvExecOutcome) -> Srv3ObservedToken {
  match outcome {
    TypedArgvExecConverged { result: r } =>
      if r.success {
        let out = trim(s: r.stdout)
        if out == "" { Srv3TokenAbsent } else { Srv3TokenObserved { value: out } }
      } else {
        Srv3TokenAbsent
      }
    TypedArgvExecRefused { reason: why } => Srv3TokenUnobserved { reason: why }
  }
}

data srv3_nonroot_workdir_unobservable_reason: String = "typed_argv_exec over ssh/fleet_ssh carries a bare argv with no working-directory channel, so a non-root workdir cannot be honoured and the probe is not run"

// Same cost shape, same fix as extdeps.sudo.elevation: one append rather than a snoc per element.
fn srv3_argv_with_bin(bin_path: String, args: List<String>) -> List<String> {
  list_append(left: [bin_path], right: args)
}

// typed_argv_exec_over_{ssh,fleet_ssh} carries a bare argv with no shell to `cd` first, so a
// non-root workdir has no typed form to hand it. Every in-tree caller passes workdir: "/" (checked
// at review time), so this arm is unreachable dead debt today -- named rather than folded into the
// workdir == "/" condition so a non-root workdir renders as a located refusal instead of an
// indistinguishable-from-measured `false` (DESIGN §5, fabricated negative). DISSOLVES WHEN a typed
// remote cd/chdir primitive lands and this reroutes to it, or when workdir is dropped from the
// signature because no caller ever varies it.

fn srv3_transport_witness_bin_success(
  transport: HostEffectTransport,
  workdir: String,
  bin_path: String,
  args: List<String>,
) -> Srv3HostPredicate
  admit_callers: [
    decl_ref(module_path: "gunbc.host.host_effect_realize", decl_name: "srv3_elevated_witness_bin_success"),
    decl_ref(module_path: "gunbc.host.host_effect_realize", decl_name: "srv3_apt_tool_version_ok"),
    decl_ref(module_path: "gunbc.host.host_effect_realize", decl_name: "srv3_run_tool_by_name"),
    decl_ref(module_path: "gunbc.host.host_effect_realize", decl_name: "websocat_stage_download"),
    decl_ref(module_path: "gunbc.host.host_effect_realize", decl_name: "srv3_transport_argv_success"),
  ]
{
  match transport {
    LocalShell =>
      if gunbc.WitnessBin.Run(workdir: workdir, bin_path: bin_path, args: args).success {
        Srv3PredicateHolds
      } else {
        Srv3PredicateFails
      }
    SshShell { ssh_host: h } =>
      if workdir == "/" {
        srv3_predicate_from_typed_argv(
          outcome: typed_argv_exec_over_ssh(
            host: h,
            argv: srv3_argv_with_bin(bin_path: bin_path, args: args),
          ),
        )
      } else {
        Srv3PredicateUnobserved { reason: srv3_nonroot_workdir_unobservable_reason }
      }
    FleetSsh { target: t, context: c } =>
      if workdir == "/" {
        srv3_predicate_from_typed_argv(
          outcome: typed_argv_exec_over_fleet_ssh(
            target: t,
            context: c,
            argv: srv3_argv_with_bin(bin_path: bin_path, args: args),
          ),
        )
      } else {
        Srv3PredicateUnobserved { reason: srv3_nonroot_workdir_unobservable_reason }
      }
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      Srv3PredicateUnobserved {
        reason: "EmitArtifactThenThinRun transport has no arm that can run a witness binary",
      }
  }
}

fn srv3_transport_test_executable(path: String, transport: HostEffectTransport) -> Srv3HostPredicate {
  match transport {
    LocalShell =>
      if shell.Test.IsExecutable(path: path).executable {
        Srv3PredicateHolds
      } else {
        Srv3PredicateFails
      }
    SshShell { ssh_host: h } =>
      srv3_predicate_from_typed_argv(
        outcome: typed_argv_exec_over_ssh(host: h, argv: shell_test_is_executable_argv(path: path)),
      )
    FleetSsh { target: t, context: c } =>
      srv3_predicate_from_typed_argv(
        outcome: typed_argv_exec_over_fleet_ssh(
          target: t,
          context: c,
          argv: shell_test_is_executable_argv(path: path),
        ),
      )
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      Srv3PredicateUnobserved {
        reason: "EmitArtifactThenThinRun transport has no arm that can test an executable",
      }
  }
}

// TRANSPORT-CONDITIONED PRESENCE, not a silent fork of one question. LocalShell and SshShell keep
// posix_command_v_check_argv / shell.PosixCommandV.Check: PRESENT ON PATH. FleetSsh cannot carry that
// argv -- the -c payload is not a PortableRemoteWord (spaces, quotes, `$`) -- so it answers a
// different, named question: shell.Test.IsExecutable over extdeps.tools apt_binary_path_of,
// PRESENT AT THE PATH THE TOOL'S SourceApt ROW DECLARES (its bin_dir + binary). Before bin_dir was
// on the row this was a single /usr/bin constant, so an sbin tool (nfct) read absent even after
// apt installed it and the ensure refused on its own readback. A row declaring the wrong
// directory still reads absent -- that is the readback doing its job, not a case to paper over.
//
// Path-presence is the right question for an apt-acquired tool: the installer places the binary
// at that FHS path, and the password-session exec is that argv0. PATH search would accept a
// shadow that apt does not own. srv3_toolchain_rows consumers are unaffected: host_toolchain_ensure
// passes host_identity_ssh_access transport (SshShell), and seeded-install-media toolchain
// ensure uses ci_deploy_srv1_access (LocalShell). Neither production caller uses FleetSsh; both
// still rely on PATH presence. The realize entry gate admits FleetSsh so a later caller would
// inherit this path-presence arm -- that is the caveat, not a current production change.
// A TOOL WITH NO DECLARED APT PATH IS NOT PROBED AT A GUESSED ONE. Over FleetSsh presence is a
// readback of the path the tool's own SourceApt row declares (extdeps.tools apt_binary_path_of).
// A tool declaring no apt source has no such path, so the probe refuses by name instead of testing
// /usr/bin/<name>, searching PATH, or trying a second directory.
fn srv3_undeclared_apt_path_reason(tool: CliTool) -> String {
  concat(
    tool.program.invocation as String,
    " declares no apt source, so it has no declared install path for a FleetSsh readback to test",
  )
}

fn srv3_apt_tool_present(tool: CliTool, transport: HostEffectTransport) -> Srv3HostPredicate {
  match transport {
    LocalShell =>
      if shell.PosixCommandV.Check(command: tool.program.invocation).exists {
        Srv3PredicateHolds
      } else {
        Srv3PredicateFails
      }
    SshShell { ssh_host: h } =>
      srv3_predicate_from_typed_argv(
        outcome: typed_argv_exec_over_ssh(host: h, argv: posix_command_v_check_argv(command: tool.program.invocation)),
      )
    FleetSsh { target: _, context: _ } =>
      match apt_binary_path_of(tool: tool) {
        Present { value: declared } =>
          srv3_transport_test_executable(path: declared as String, transport: transport)
        Absent => Srv3PredicateUnobserved { reason: srv3_undeclared_apt_path_reason(tool: tool) }
      }
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      Srv3PredicateUnobserved {
        reason: "EmitArtifactThenThinRun transport has no arm that can probe tool presence",
      }
  }
}

// FleetSsh resolved path is the same question as srv3_apt_tool_present: executable at
// the declared apt_binary_path_of path, not PATH stdout from command -v. LocalShell and
// SshShell still resolve via command -v. This arm is in scope because srv3_apt_tool_version_ok
// (and srv3_run_tool_by_name) read the path from here; leaving FleetSsh on posix_command_v_check_argv
// would make version_ok Unobserved after a successful path-presence probe -- the install arm would
// never be able to prove the version on FleetSsh. A binary only elsewhere still reads absent.
fn srv3_tool_bin_path(tool: CliTool, transport: HostEffectTransport) -> Srv3ObservedToken {
  match transport {
    LocalShell => {
      let found = shell.PosixCommandV.Check(command: tool.program.invocation)
      if found.exists {
        match found.path {
          Present { value: tool_path } => Srv3TokenObserved { value: tool_path as String }
          Absent => Srv3TokenAbsent
        }
      } else {
        Srv3TokenAbsent
      }
    }
    SshShell { ssh_host: h } =>
      srv3_observed_token_from_typed_argv(
        outcome: typed_argv_exec_over_ssh(host: h, argv: posix_command_v_check_argv(command: tool.program.invocation)),
      )
    FleetSsh { target: _, context: _ } =>
      match apt_binary_path_of(tool: tool) {
        Absent => Srv3TokenUnobserved { reason: srv3_undeclared_apt_path_reason(tool: tool) }
        Present { value: declared } =>
          match srv3_transport_test_executable(path: declared as String, transport: transport) {
            Srv3PredicateHolds => Srv3TokenObserved { value: declared as String }
            Srv3PredicateFails => Srv3TokenAbsent
            Srv3PredicateUnobserved { reason: why } => Srv3TokenUnobserved { reason: why }
          }
      }
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      Srv3TokenUnobserved {
        reason: "EmitArtifactThenThinRun transport has no arm that can resolve a tool path",
      }
  }
}

// One place where "resolve the tool, then run it" is written, so the three states survive the
// composition instead of being flattened once per call site.
fn srv3_run_tool_by_name(
  tool: CliTool,
  args: List<String>,
  transport: HostEffectTransport,
) -> Srv3HostPredicate {
  match srv3_tool_bin_path(tool: tool, transport: transport) {
    Srv3TokenUnobserved { reason: why } => Srv3PredicateUnobserved { reason: why }
    Srv3TokenAbsent => Srv3PredicateFails
    Srv3TokenObserved { value: resolved } =>
      srv3_transport_witness_bin_success(
        transport: transport,
        workdir: "/",
        bin_path: resolved,
        args: args,
      )
  }
}

fn srv3_apt_tool_version_ok(tool: CliTool, transport: HostEffectTransport) -> Srv3HostPredicate {
  match srv3_tool_bin_path(tool: tool, transport: transport) {
    Srv3TokenObserved { value: tool_path } =>
      srv3_transport_witness_bin_success(
        transport: transport,
        workdir: "/",
        bin_path: tool_path,
        args: ["--version"],
      )
    Srv3TokenAbsent => Srv3PredicateFails
    Srv3TokenUnobserved { reason: why } => Srv3PredicateUnobserved { reason: why }
  }
}

// ONE TRANSPORT-AWARE SINGLE-TOKEN READ, given a full argv. srv3_tool_bin_path and the `id`
// probes each had their own transport match over the same four arms; the stat probes this cut adds
// would have made a third. The argv is the parameter because that is exactly what differs --
// everything else about "run this readonly command and take its one line of output" is identical.
// WHAT MAY BE ASKED, not what may be run. Every token read this realizer performs is one of four
// questions about the host, so the caller names the QUESTION and the argv is derived here. Before
// this type existed the entry point took a List<String> and would run whatever it was handed --
// the semantic request and the command serialization were one fact, so a new probe was authored by
// passing a new argv rather than by declaring a new subject, and nothing distinguished a modeled
// read from an arbitrary one.
type Srv3TokenSubject
  = Srv3EffectiveUserId
  | Srv3EffectiveGroupId
  | Srv3PathOwnerUser { path: String }
  | Srv3PathOwnerGroup { path: String }
  | Srv3PathMode { path: String }

// The single public token read. The argv never crosses this boundary in either direction: callers
// hand in a subject and receive a typed observation.
fn srv3_read_token(
  subject: Srv3TokenSubject,
  transport: HostEffectTransport,
) -> Srv3ObservedToken {
  srv3_transport_token(argv: srv3_token_argv(subject: subject), transport: transport)
}

// The serialization half, private to the two decls above by admission rather than by convention.
fn srv3_token_argv(subject: Srv3TokenSubject) -> List<String>
  admit_callers: [
    decl_ref(module_path: "gunbc.host.host_effect_realize", decl_name: "srv3_read_token"),
    decl_ref(module_path: "test.claim.srv3.srv3_token_subject_witness", decl_name: "effective_owner_subjects_derive_the_cited_id_argv"),
    decl_ref(module_path: "test.claim.srv3.srv3_token_subject_witness", decl_name: "path_owner_subjects_derive_the_cited_stat_argv"),
    decl_ref(module_path: "test.claim.srv3.srv3_token_subject_witness", decl_name: "owner_halves_do_not_derive_the_same_command"),
    decl_ref(module_path: "test.claim.srv3.srv3_token_subject_witness", decl_name: "the_path_subject_carries_its_own_path"),
  ]
{
  match subject {
    Srv3EffectiveUserId => id_uid_argv_absolute()
    Srv3EffectiveGroupId => id_gid_argv_absolute()
    Srv3PathOwnerUser { path: p } => stat_owner_user_argv(path: p)
    Srv3PathOwnerGroup { path: p } => stat_owner_group_argv(path: p)
    Srv3PathMode { path: p } => stat_mode_argv(path: p)
  }
}

// SEALED TO THE ONE SUBJECT-TAKING CALLER. This is the arm that will run any argv it is given, so
// admission is what stops a future probe from re-opening the untyped surface: adding a read means
// adding a Srv3TokenSubject variant, not calling through here with a fresh vector.
fn srv3_transport_token(argv: List<String>, transport: HostEffectTransport) -> Srv3ObservedToken
  admit_callers: [
    decl_ref(module_path: "gunbc.host.host_effect_realize", decl_name: "srv3_read_token"),
  ]
{
  match transport {
    LocalShell => srv3_local_token_from_argv(argv: argv)
    SshShell { ssh_host: h } =>
      srv3_observed_token_from_typed_argv(outcome: typed_argv_exec_over_ssh(host: h, argv: argv))
    FleetSsh { target: t, context: c } =>
      srv3_observed_token_from_typed_argv(
        outcome: typed_argv_exec_over_fleet_ssh(target: t, context: c, argv: argv),
      )
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      Srv3TokenUnobserved {
        reason: "EmitArtifactThenThinRun transport has no arm that can read a command's output",
      }
  }
}

// The local witness-bin surface takes a binary and its tail separately, so the argv is split here
// rather than at every caller. An empty argv names no binary and is refused rather than run.
fn srv3_local_token_from_argv(argv: List<String>) -> Srv3ObservedToken {
  match argv {
    Empty =>
      Srv3TokenUnobserved { reason: "srv3 token read: an empty argv names no binary to run" }
    Cons { head: bin, tail: rest } => {
      let r = gunbc.WitnessBin.Run(workdir: "/", bin_path: bin, args: rest)
      srv3_token_from_run(success: r.success, stdout: r.stdout)
    }
  }
}

// EMPTY STDOUT IS ABSENT, NOT AN OBSERVATION OF "". A probe that exits zero having printed nothing
// has not answered the question it was asked, and the caller must decide what that means rather
// than receive an empty token that compares unequal to everything.
//
// LOCAL READS GO THROUGH THE SAME TRIM THE SSH ARMS USE. The local chown arm previously consumed
// `.stdout` raw, so a trailing newline -- which `id` emits and every other arm trims -- was
// concatenated straight into a privileged chown argument.
fn srv3_token_from_run(success: Bool, stdout: String) -> Srv3ObservedToken {
  if success {
    let out = trim(s: stdout)
    if out == "" { Srv3TokenAbsent } else { Srv3TokenObserved { value: out } }
  } else {
    Srv3TokenAbsent
  }
}

// THE GID PROBE SITS INSIDE THE UID ARM, not beside it in a second `let`. Both are readonly, so
// the harm is small, but the shape is the one that produced this file's two worst defects: an
// effectful call outside the branch that decides whether it should happen runs anyway, and nothing
// in the signature says so.
fn srv3_effective_owner(transport: HostEffectTransport) -> Srv3EffectiveOwner {
  match srv3_read_token(subject: Srv3EffectiveUserId, transport: transport) {
    Srv3TokenUnobserved { reason: why } => Srv3EffectiveOwnerUnobserved { reason: why }
    Srv3TokenAbsent =>
      Srv3EffectiveOwnerUnobserved { reason: "srv3 owner: `id -u` produced no output" }
    Srv3TokenObserved { value: uid_text } =>
      match srv3_read_token(subject: Srv3EffectiveGroupId, transport: transport) {
        Srv3TokenUnobserved { reason: why } => Srv3EffectiveOwnerUnobserved { reason: why }
        Srv3TokenAbsent =>
          Srv3EffectiveOwnerUnobserved { reason: "srv3 owner: `id -g` produced no output" }
        Srv3TokenObserved { value: gid_text } =>
          srv3_owner_from_texts(uid_text: uid_text, gid_text: gid_text)
      }
  }
}

// The absolute-path spellings. extdeps.tools.id's bare argv rows resolve through PATH, which is
// right for a remote shell; the local witness-bin surface takes a binary path, and a sudoers rule
// matches on one, so both spellings are real and neither is the other's nickname.
fn id_uid_argv_absolute() -> List<String> {
  [id_binary_path as String, "-u"]
}

fn id_gid_argv_absolute() -> List<String> {
  [id_binary_path as String, "-g"]
}

type Srv3EffectiveOwner
  = Srv3EffectiveOwnerObserved { owner: PosixOwnerSpec }
  | Srv3EffectiveOwnerUnobserved { reason: String }

// AN UNDECODABLE ID REFUSES; IT IS NOT CHOWNED TO. `id` printed SOMETHING and it is not a POSIX
// id, which is a different state from "id printed nothing" and from "id was never run" -- and the
// remedy differs: unparseable output means the probe's assumption about the host is wrong, and
// retrying will produce the same text.
fn srv3_owner_from_texts(uid_text: String, gid_text: String) -> Srv3EffectiveOwner {
  match posix_user_id_from_text(text: uid_text) {
    Absent =>
      Srv3EffectiveOwnerUnobserved {
        reason: concat("srv3 owner: `id -u` output is not a POSIX user id: ", uid_text),
      }
    Present { value: user } =>
      match posix_group_id_from_text(text: gid_text) {
        Absent =>
          Srv3EffectiveOwnerUnobserved {
            reason: concat("srv3 owner: `id -g` output is not a POSIX group id: ", gid_text),
          }
        Present { value: group } =>
          Srv3EffectiveOwnerObserved {
            owner: PosixOwnerSpec { user: user, group: group },
          }
      }
  }
}

// THE PATH'S CURRENT OWNER, read independently of anything this process did to it.
fn srv3_observe_path_owner(path: String, transport: HostEffectTransport) -> PathOwnershipObservation {
  match srv3_read_token(subject: Srv3PathOwnerUser { path: path }, transport: transport) {
    Srv3TokenUnobserved { reason: why } => PathOwnerUnobserved { reason: why }
    Srv3TokenAbsent =>
      PathOwnerUnobserved {
        reason: concat("srv3 owner: `stat -c %u` produced no output for ", path),
      }
    Srv3TokenObserved { value: uid_text } =>
      match srv3_read_token(subject: Srv3PathOwnerGroup { path: path }, transport: transport) {
        Srv3TokenUnobserved { reason: why } => PathOwnerUnobserved { reason: why }
        Srv3TokenAbsent =>
          PathOwnerUnobserved {
            reason: concat("srv3 owner: `stat -c %g` produced no output for ", path),
          }
        Srv3TokenObserved { value: gid_text } =>
          srv3_path_owner_from_texts(uid_text: uid_text, gid_text: gid_text, path: path)
      }
  }
}

fn srv3_observe_path_mode(path: String, transport: HostEffectTransport) -> PathModeObservation {
  match srv3_read_token(subject: Srv3PathMode { path: path }, transport: transport) {
    Srv3TokenUnobserved { reason: why } => PathModeUnobserved { reason: why }
    Srv3TokenAbsent => PathModeUnobserved { reason: concat("srv3 mode: `stat -c %a` produced no output for ", path) }
    Srv3TokenObserved { value: mode_text } => PathModeObserved { mode: mode_text as NonEmptyStr }
  }
}

fn srv3_path_owner_from_texts(
  uid_text: String,
  gid_text: String,
  path: String,
) -> PathOwnershipObservation {
  match srv3_owner_from_texts(uid_text: uid_text, gid_text: gid_text) {
    Srv3EffectiveOwnerUnobserved { reason: why } =>
      PathOwnerUnobserved { reason: concat(concat("srv3 owner of ", path), concat(": ", why)) }
    Srv3EffectiveOwnerObserved { owner: o } => PathOwnerObserved { owner: o }
  }
}

// OWNERSHIP IS ENSURED BY READBACK, NOT BY EXIT STATUS -- and this is the stage where that
// distinction was previously absent. The predecessor ran an elevated chown and returned
// Holds/Fails from the process result, so "the chown exited zero" and "the directory is owned by
// us" were the same claim. They are not: a chown that followed a symlink, or that raced a replaced
// path, or that ran under a sudoers rule permitting the binary but not the target, can exit zero
// having converged nothing.
//
// The chown's own result is deliberately not consulted for the verdict. It cannot be: the verdict
// comes from path_ownership_verdict, which takes the readback and the desired owner and has
// nowhere to put a process result. A failed chown surfaces as the readback disagreeing.
fn srv3_ensure_directory_owned_by_current_user(
  path: String,
  transport: HostEffectTransport,
) -> Srv3HostPredicate {
  match srv3_effective_owner(transport: transport) {
    Srv3EffectiveOwnerUnobserved { reason: why } => Srv3PredicateUnobserved { reason: why }
    Srv3EffectiveOwnerObserved { owner: desired } =>
      srv3_converge_path_owner(
        desired: desired,
        decision: path_ownership_decision(
          desired: desired,
          observed: srv3_observe_path_owner(path: path, transport: transport),
        ),
        path: path,
        transport: transport,
      )
  }
}

// THE ALREADY-SATISFIED ARM PERFORMS NO PRIVILEGED INVOCATION AT ALL, which on a converge that has
// already run is every invocation this stage would have made.
fn srv3_converge_path_owner(
  desired: PosixOwnerSpec,
  decision: PathOwnershipDecision,
  path: String,
  transport: HostEffectTransport,
) -> Srv3HostPredicate {
  match decision {
    OwnershipDecisionRefused { reason: why } => Srv3PredicateUnobserved { reason: why }
    OwnershipAlreadySatisfied { owner: _ } => Srv3PredicateHolds
    OwnershipMutationRequired { current: _, desired: target } =>
      srv3_chown_then_read_back(desired: target, path: path, transport: transport)
  }
}

// THE MUTATION IS SEQUENCED BY A `let` INSIDE THIS ARM, NOT BY ARGUMENT POSITION. An earlier
// revision passed the chown as an argument and defended it in a comment as "deliberately
// load-bearing eagerness". That reinstates exactly the footgun this sequence of cuts exists to
// remove: implicit evaluation order is not a sequencing authority, and the fact that eagerness
// happened to be what I wanted this time does not make it one -- the next reader cannot tell a
// deliberate one from the accident that put a privileged apt install in an argument (side-chat
// review of #8760).
fn srv3_chown_then_read_back(
  desired: PosixOwnerSpec,
  path: String,
  transport: HostEffectTransport,
) -> Srv3HostPredicate {
  let attempt = srv3_chown_attempt(
    outcome: srv3_elevated_witness_bin_success(
      transport: transport,
      command: chown_argv(owner: ChownOwnerIds { spec: desired }, path: path),
    ),
  )
  srv3_readback_after_attempt(
    desired: desired,
    attempt: attempt,
    path: path,
    transport: transport,
  )
}

fn srv3_chown_attempt(outcome: Srv3HostPredicate) -> ChownAttemptObservation {
  match outcome {
    Srv3PredicateHolds => ChownReportedSuccess
    Srv3PredicateFails => ChownReportedFailure
    Srv3PredicateUnobserved { reason: why } => ChownNotDispatched { cause: why }
  }
}

// A CHOWN THAT WAS NEVER DISPATCHED SKIPS THE READBACK. Not as an optimization: a readback there
// would describe a host nobody touched, and reporting its answer as the result of an ensure that
// never ran is the fabrication in miniature. Both DISPATCHED arms read back, and identically --
// a reported failure is no more evidence about the filesystem than a reported success.
fn srv3_readback_after_attempt(
  desired: PosixOwnerSpec,
  attempt: ChownAttemptObservation,
  path: String,
  transport: HostEffectTransport,
) -> Srv3HostPredicate {
  match attempt {
    ChownNotDispatched { cause: why } => Srv3PredicateUnobserved { reason: why }
    ChownReportedSuccess =>
      srv3_path_owner_readback(desired: desired, attempt: attempt, path: path, transport: transport)
    ChownReportedFailure =>
      srv3_path_owner_readback(desired: desired, attempt: attempt, path: path, transport: transport)
  }
}

fn srv3_path_owner_readback(
  desired: PosixOwnerSpec,
  attempt: ChownAttemptObservation,
  path: String,
  transport: HostEffectTransport,
) -> Srv3HostPredicate {
  srv3_predicate_from_ownership_outcome(
    outcome: path_ownership_verdict(
      desired: desired,
      attempt: attempt,
      readback: srv3_observe_path_owner(path: path, transport: transport),
    ),
  )
}

fn srv3_predicate_from_ownership_outcome(outcome: PathOwnershipEnsureOutcome) -> Srv3HostPredicate {
  match outcome {
    PathAlreadyOwned { owner: _ } => Srv3PredicateHolds
    PathOwnershipConvergedAfterAttempt { owner: _, attempt: _ } => Srv3PredicateHolds
    PathOwnershipEnsureRefused { reason: why } => Srv3PredicateUnobserved { reason: why }
  }
}

// EVERY PRIVILEGED LEAF IN THIS FILE GOES THROUGH HERE, so sudo's calling convention is stated
// once. Four call sites each carried `bin_path: "/usr/bin/sudo"` beside an args list beginning
// with a bare "-n"; the binary and the flag are facts about sudo, not about chown, mkdir or
// apt-get, and extdeps.sudo.elevation is where they belong.
// THE EXECUTION SURFACE IS SEALED TO ITS NAMED CALLERS, and the seal's REACH IS MEASURED RATHER
// THAN ASSERTED, because the obvious reading of `admit_callers` overstates what it does.
//
// WHAT IS CLOSED, confirmed by execution: no OTHER MODULE can run an argv on a transport, elevated
// or not. A foreign caller refuses at resolve with a diagnostic naming the permitted set --
// "constructor call admission refused: 'gunbc.host.host_effect_realize.srv3_elevated_witness_bin_success'
// refuses call from 'test.claim.srv3_seal_probe.a_foreign_module_may_not_run_a_privileged_argv' --
// permitted callers: [...]". That is the property this cut is for: a caller outside this module can
// name a semantic operation (ensure this tool, ensure this owner) and cannot name the machinery
// that executes it.
//
// WHAT IS NOT CLOSED, and this is the part a reader would get wrong: the wall does NOT confine
// SAME-MODULE callers. A probe function added to this very module, absent from the admitted list,
// calling srv3_elevated_witness_bin_success with ["/bin/rm", "-rf", "/"], typechecked and resolved
// with no diagnostic at all. Both halves were measured on the same build; reporting only the
// refusal would be the rung inflation DESIGN section 4b names as worse than sitting low.
//
// So the rung is MECHANICALLY PREVENTABLE at the module boundary and NOTHING at all within it. The
// admitted lists below are therefore two facts at once: an enforced wall against foreign callers,
// and a declaration of intent for in-module ones that no mechanism currently checks. NEXT-RUNG
// TRIGGER: admission checked per caller rather than per module. Until that lands, an in-module
// caller added to either of these functions is caught by review or by nothing.
//
// The lists were derived by walking the module rather than by reading the call sites: my first
// hand-read attributed two calls to the wrong enclosing function and invented a fifth caller that
// does not exist. Nothing would have caught that -- an in-module list the compiler does not check
// is a list nothing verifies, which is the second reason the next-rung trigger matters.
// THE ARGV-SHAPED SIBLING. Every extdeps tool row returns a complete argv, and the witness-bin
// surface takes a binary and its tail separately, so each caller was splitting the argv back apart
// by hand at the call site -- or, more often, not building one at all and passing a literal binary
// beside a literal args list. This splits it once.
fn srv3_transport_argv_success(
  transport: HostEffectTransport,
  argv: List<String>,
) -> Srv3HostPredicate
  admit_callers: [
    decl_ref(module_path: "gunbc.host.host_effect_realize", decl_name: "websocat_stage_ensure_executable_mode"),
  ]
{
  match argv {
    Empty =>
      Srv3PredicateUnobserved { reason: "srv3 exec: an empty argv names no binary to run" }
    Cons { head: bin, tail: rest } =>
      srv3_transport_witness_bin_success(
        transport: transport,
        workdir: "/",
        bin_path: bin,
        args: rest,
      )
  }
}

fn srv3_elevated_witness_bin_success(
  transport: HostEffectTransport,
  command: List<String>,
) -> Srv3HostPredicate
  admit_callers: [
    decl_ref(module_path: "gunbc.host.host_effect_realize", decl_name: "srv3_privileged_apt_install"),
    decl_ref(module_path: "gunbc.host.host_effect_realize", decl_name: "srv3_chown_then_read_back"),
    decl_ref(module_path: "gunbc.host.host_effect_realize", decl_name: "websocat_stage_ensure_directory"),
  ]
{
  let elevated = sudo_elevate(command: command)
  srv3_transport_witness_bin_success(
    transport: transport,
    workdir: "/",
    bin_path: elevated.bin_path,
    args: elevated.args,
  )
}

fn srv3_privileged_apt_install(package: NonEmptyStr, transport: HostEffectTransport) -> Srv3HostPredicate {
  srv3_elevated_witness_bin_success(
    transport: transport,
    command: srv3_actuator_toolchain_apt_install_command(package: package),
  )
}

// THE COMMAND, NOT THE ELEVATED INVOCATION. This is the argv apt-get would take unprivileged;
// elevation is applied to it rather than spelled inside it, so "which flag makes sudo
// non-interactive" is not a fact this function has an opinion about.
fn srv3_actuator_toolchain_apt_install_command(package: NonEmptyStr) -> List<String> {
  [
    apt_get_binary_path as String,
    "install",
    "-y",
    package as String,
  ]
}

fn srv3_actuator_toolchain_websocat_release_download_url() -> String {
  websocat_github_release_download_url(
    tag: websocat_github_tag,
    asset: websocat_asset_aarch64,
  )
}

fn srv3_actuator_toolchain_realizer_apt_install_is_privileged_gated() -> Bool {
  let elevated = sudo_elevate(command: srv3_actuator_toolchain_apt_install_command(package: package_curl))
  elevated.bin_path == sudo_program().invocation as String &&
    elevated.args == ["-n", apt_get_binary_path as String, "install", "-y", package_curl as String]
}

fn srv3_actuator_toolchain_realizer_websocat_uses_github_release_not_apt() -> Bool {
  string_contains(
    s: srv3_actuator_toolchain_websocat_release_download_url(),
    pattern: "github.com/vi/websocat/releases/download/",
  )
    && string_contains(s: websocat_install_path as String, pattern: gunbc_bin_dir as String)
}

fn srv3_actuator_toolchain_realizer_websocat_installs_to_modeled_path_with_namespace_upsert() -> Bool {
  string_contains(s: websocat_install_path as String, pattern: concat(gunbc_bin_dir as String, "/"))
}

// THE ARM THIS FUNCTION MUST NOT TAKE is the install arm on an unobserved probe. Previously the
// presence probe returned `Bool`, so a transport that could not run the probe at all answered
// `false` and fell straight through to srv3_privileged_apt_install -- a privileged mutation of a
// host whose current state was never established. `Srv3PredicateUnobserved` now refuses instead,
// carrying the reason the probe could not be made.
// THE INSTALL MUST SIT IN A BRANCH, NEVER IN AN ARGUMENT POSITION.
//
// This body once read srv3_version_gate_then(verdict: ..., otherwise: srv3_apt_install_then_reprobe(...)),
// which reads correctly and is wrong: an argument is evaluated to build the call, so the PRIVILEGED
// APT INSTALL RAN ON EVERY ENSURE of a present, correctly-versioned tool. The pre-cut code
// short-circuited through if/else and never had this defect; the regression came from moving the
// install out of a branch and into a parameter while every type stayed identical. A match arm is a
// branch, so only the selected arm evaluates.
fn srv3_ensure_apt_tool(
  tool: CliTool,
  package: NonEmptyStr,
  require_version_probe: Bool,
  transport: HostEffectTransport,
) -> Srv3HostPredicate {
  srv3_ensure_apt(
    subject: AptBinaryOnPath { tool: tool },
    package: package,
    require_version_probe: require_version_probe,
    transport: transport,
  )
}

// WHAT AN APT ENSURE ASKS IS PRESENT. A tool is asked for by its binary (the password-session
// roster's sshpass); a shared library has no binary to probe, so it is asked for by the package
// itself, read from the dpkg database (the browser toolchain's install-deps set). Both go through
// the ONE fold below -- the probe-before-install, install-in-a-branch and re-probe discipline is
// written once, and a subject kind is an arm here rather than a second ensure.
type AptPresenceSubject
  = AptBinaryOnPath { tool: CliTool }
  | AptPackageInstalled { package: NonEmptyStr }

fn srv3_apt_subject_present(subject: AptPresenceSubject, transport: HostEffectTransport) -> Srv3HostPredicate {
  match subject {
    AptBinaryOnPath { tool: t } => srv3_apt_tool_present(tool: t, transport: transport)
    AptPackageInstalled { package: p } => srv3_dpkg_package_installed(package: p, transport: transport)
  }
}

// A PACKAGE SUBJECT HAS NO VERSION PROBE, and asking for one is refused rather than answered: the
// dpkg status read says installed or not, and inventing a version comparison for it would assert a
// constraint nothing declared.
fn srv3_apt_subject_version_ok(subject: AptPresenceSubject, transport: HostEffectTransport) -> Srv3HostPredicate {
  match subject {
    AptBinaryOnPath { tool: t } => srv3_apt_tool_version_ok(tool: t, transport: transport)
    AptPackageInstalled { package: p } =>
      Srv3PredicateUnobserved {
        reason: concat("a version probe was requested for apt package subject ", concat(p as String, ", which declares no version to read")),
      }
  }
}

// THE PACKAGE READ KEEPS THE QUERY'S WHOLE OUTCOME (side-chat reviews of gunbc#12500). `dpkg -s`
// exits zero for a package removed with its configuration kept, and a token read collapses every
// unsuccessful query into "absent" -- either way an unanswered question could authorize an apt
// install. So the read runs dpkg-query -s over the transport's typed exec, keeping exit code, stdout
// and stderr, and extdeps.package_managers.dpkg dpkg_query_status_verdict_of decides: installed holds; a decoded
// not-installed state or a package unknown to dpkg fails (the ensure may install); anything
// undecidable is Unobserved, which the ensure fold refuses rather than installing on.
//
// The transport dispatch is TOTALLED BY NAME (parent ruling on the 84c0dcf floor refusal):
// LocalShell reaches no srv3 host and EmitArtifactThenThinRun does not run on the target, so both
// read as unobserved -- each variant named, so a fifth transport is a decision here, not silence.
fn srv3_dpkg_package_installed(package: NonEmptyStr, transport: HostEffectTransport) -> Srv3HostPredicate {
  let argv = dpkg_query_status_argv(package: package)
  let outcome = match transport {
    FleetSsh { target: t, context: c } => Present { value: typed_argv_exec_over_fleet_ssh(target: t, context: c, argv: argv) }
    SshShell { ssh_host: h } => Present { value: typed_argv_exec_over_ssh(host: h, argv: argv) }
    LocalShell => none
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } => none
  }
  match outcome {
    Absent => Srv3PredicateUnobserved { reason: "this transport has no typed exec that keeps a query's exit code and stderr, so the package state is not read" }
    Present { value: TypedArgvExecRefused { reason: why } } => Srv3PredicateUnobserved { reason: why }
    Present { value: TypedArgvExecConverged { result: r } } =>
      match dpkg_query_status_verdict_of(exit_code: r.exit_code, stdout: r.stdout, stderr: r.stderr) {
        DpkgPackageInstalled => Srv3PredicateHolds
        DpkgPackageNotInstalled { status: _ } => Srv3PredicateFails
        DpkgPackageUnknown => Srv3PredicateFails
        DpkgQueryUndecidable { reason: why } => Srv3PredicateUnobserved { reason: concat(concat(package as String, ": "), why) }
      }
  }
}

fn srv3_ensure_apt(
  subject: AptPresenceSubject,
  package: NonEmptyStr,
  require_version_probe: Bool,
  transport: HostEffectTransport,
) -> Srv3HostPredicate {
  match srv3_apt_subject_present(subject: subject, transport: transport) {
    Srv3PredicateUnobserved { reason: why } => Srv3PredicateUnobserved { reason: why }
    Srv3PredicateHolds =>
      if require_version_probe == false {
        Srv3PredicateHolds
      } else {
        match srv3_apt_subject_version_ok(subject: subject, transport: transport) {
          Srv3PredicateHolds => Srv3PredicateHolds
          Srv3PredicateUnobserved { reason: why } => Srv3PredicateUnobserved { reason: why }
          Srv3PredicateFails =>
            srv3_apt_install_then_reprobe(
              subject: subject,
              package: package,
              require_version_probe: require_version_probe,
              transport: transport,
            )
        }
      }
    Srv3PredicateFails =>
      srv3_apt_install_then_reprobe(
        subject: subject,
        package: package,
        require_version_probe: require_version_probe,
        transport: transport,
      )
  }
}

fn srv3_probe_present_then_version(
  tool: CliTool,
  transport: HostEffectTransport,
) -> Srv3HostPredicate {
  match srv3_apt_tool_present(tool: tool, transport: transport) {
    Srv3PredicateUnobserved { reason: why } => Srv3PredicateUnobserved { reason: why }
    Srv3PredicateFails => Srv3PredicateFails
    Srv3PredicateHolds =>
      match srv3_apt_tool_version_ok(tool: tool, transport: transport) {
        Srv3PredicateHolds => Srv3PredicateHolds
        Srv3PredicateUnobserved { reason: why } => Srv3PredicateUnobserved { reason: why }
        Srv3PredicateFails => Srv3PredicateFails
      }
  }
}

fn srv3_apt_install_then_reprobe(
  subject: AptPresenceSubject,
  package: NonEmptyStr,
  require_version_probe: Bool,
  transport: HostEffectTransport,
) -> Srv3HostPredicate {
  match srv3_privileged_apt_install(package: package, transport: transport) {
    Srv3PredicateUnobserved { reason: why } => Srv3PredicateUnobserved { reason: why }
    Srv3PredicateFails => Srv3PredicateFails
    Srv3PredicateHolds =>
      match srv3_apt_subject_present(subject: subject, transport: transport) {
        Srv3PredicateUnobserved { reason: why } => Srv3PredicateUnobserved { reason: why }
        Srv3PredicateFails => Srv3PredicateFails
        Srv3PredicateHolds =>
          if require_version_probe == false {
            Srv3PredicateHolds
          } else {
            match srv3_apt_subject_version_ok(subject: subject, transport: transport) {
              Srv3PredicateHolds => Srv3PredicateHolds
              Srv3PredicateUnobserved { reason: why } => Srv3PredicateUnobserved { reason: why }
              Srv3PredicateFails => Srv3PredicateFails
            }
          }
      }
  }
}

// THE SEQUENCE IS A VALUE, SO THE EVIDENCE CAN ASSERT WHAT RAN.
//
// The defect this replaces: srv3_ensure_websocat bound mkdir, chown, curl and chmod as four lets
// and then handed the results to srv3_predicate_all. In a strict language a let executes when it
// is bound, so ALL FOUR MUTATIONS RAN REGARDLESS OF EACH OTHER -- a failed mkdir still downloaded
// the file and chmod'd it -- and the readback sat in the argument list, so it ran after any of
// them failed. srv3_predicate_all then classified the batch correctly AFTER THE FACT. The value
// was right and the execution was wrong, which is why no witness in this file saw it: they all
// assert the returned coproduct, and this class never changes it.
//
// Four of those unconditional mutations predate the three-valued cut; the eagerly-evaluated
// readback was introduced by it. Both are closed here.
//
// The repair separates the SEQUENCING DECISION from the EXECUTION. websocat_after is a pure
// total function -- given a stage and its outcome, what happens next -- so a test can assert the
// whole transition table without a host. The driver performs effects and consumes that single
// authority, which is what keeps the tested decision and the executed decision the same one.
type WebsocatStage
  = ObserveInstalled
  | ResolveCurl
  | EnsureDirectory
  | EnsureOwnership
  | Download
  | EnsureExecutableMode
  | Readback

type WebsocatStep
  = WebsocatContinue { next: WebsocatStage }
  | WebsocatStop { verdict: Srv3HostPredicate }
  | WebsocatAlreadySatisfied

// A stage advances ONLY on Holds. Fails and Unobserved both stop, and they stop carrying their
// own verdict rather than a shared one -- an unreachable host and a genuinely failed mkdir are
// different states with different remedies, which is the distinction the three-valued carrier
// exists to preserve.
// Advancing and stopping are the same two shapes at every stage but the first and last, so they
// are named once. `next` is a pure stage value, not an effect -- passing it as an argument is
// safe, and the distinction is worth stating in a file whose defects were all about effects in
// argument position: eager evaluation only matters when evaluating causes something to happen.
fn websocat_advance(outcome: Srv3HostPredicate, next: WebsocatStage) -> WebsocatStep {
  match outcome {
    Srv3PredicateHolds => WebsocatContinue { next: next }
    Srv3PredicateFails => WebsocatStop { verdict: Srv3PredicateFails }
    Srv3PredicateUnobserved { reason: why } =>
      WebsocatStop { verdict: Srv3PredicateUnobserved { reason: why } }
  }
}

fn websocat_terminal(outcome: Srv3HostPredicate) -> WebsocatStep {
  match outcome {
    Srv3PredicateHolds => WebsocatStop { verdict: Srv3PredicateHolds }
    Srv3PredicateFails => WebsocatStop { verdict: Srv3PredicateFails }
    Srv3PredicateUnobserved { reason: why } =>
      WebsocatStop { verdict: Srv3PredicateUnobserved { reason: why } }
  }
}

// ObserveInstalled IS THE ONLY STAGE WHERE Fails MEANS PROCEED. "Is it already installed"
// answering no is the whole reason to install, so that arm continues; every other stage's Fails is
// a real failure and stops. Unobserved stops at every stage including that one -- a host that could
// not be asked whether the binary exists must not be handed an install.
fn websocat_after(stage: WebsocatStage, outcome: Srv3HostPredicate) -> WebsocatStep {
  match stage {
    ObserveInstalled =>
      match outcome {
        Srv3PredicateHolds => WebsocatAlreadySatisfied
        Srv3PredicateFails => WebsocatContinue { next: ResolveCurl }
        Srv3PredicateUnobserved { reason: why } =>
          WebsocatStop { verdict: Srv3PredicateUnobserved { reason: why } }
      }
    ResolveCurl => websocat_advance(outcome: outcome, next: EnsureDirectory)
    EnsureDirectory => websocat_advance(outcome: outcome, next: EnsureOwnership)
    EnsureOwnership => websocat_advance(outcome: outcome, next: Download)
    Download => websocat_advance(outcome: outcome, next: EnsureExecutableMode)
    EnsureExecutableMode => websocat_advance(outcome: outcome, next: Readback)
    Readback => websocat_terminal(outcome: outcome)
  }
}

// THE ACTION TRACE, derived from the same transition function the driver uses. Given the outcome
// each stage would produce, this yields exactly the stages that execute -- so a witness can assert
// "a failed mkdir means Download never runs" as a claim about EXECUTION rather than about the
// value that came back.
//
// The walk CARRIES the next stage rather than re-deriving it from what already ran. An earlier
// draft of this file derived it, which put the stage order in two places -- websocat_after and the
// deriving function -- and that is the §3 fork this module keeps being about. websocat_after is
// the only thing that knows what follows what.
type WebsocatWalk {
  stages: List<WebsocatStage>
  current: WebsocatStage?
  verdict: Srv3HostPredicate
}

data websocat_walk_start: WebsocatWalk = WebsocatWalk {
  stages: [],
  current: Present { value: ObserveInstalled },
  verdict: Srv3PredicateFails,
}

fn websocat_walk_step(walk: WebsocatWalk, outcome: Srv3HostPredicate) -> WebsocatWalk {
  match walk.current {
    Absent => walk
    Present { value: stage } => {
      let ran = list_snoc_item(xs: walk.stages, item: stage)
      match websocat_after(stage: stage, outcome: outcome) {
        WebsocatAlreadySatisfied =>
          WebsocatWalk { stages: ran, current: none, verdict: Srv3PredicateHolds }
        WebsocatStop { verdict: v } =>
          WebsocatWalk { stages: ran, current: none, verdict: v }
        WebsocatContinue { next: n } =>
          WebsocatWalk { stages: ran, current: Present { value: n }, verdict: walk.verdict }
      }
    }
  }
}

fn websocat_trace_from_outcomes(outcomes: List<Srv3HostPredicate>) -> WebsocatWalk {
  fold_list(
    xs: outcomes,
    empty: websocat_walk_start,
    cons: fn(acc, outcome) { websocat_walk_step(walk: acc, outcome: outcome) },
  )
}

fn websocat_stage_label(stage: WebsocatStage) -> String {
  match stage {
    ObserveInstalled => "observe-installed"
    ResolveCurl => "resolve-curl"
    EnsureDirectory => "ensure-directory"
    EnsureOwnership => "ensure-ownership"
    Download => "download"
    EnsureExecutableMode => "ensure-executable-mode"
    Readback => "readback"
  }
}

fn websocat_trace_labels(walk: WebsocatWalk) -> List<String> {
  list_map(xs: walk.stages, f: fn(st) { websocat_stage_label(stage: st) })
}

// THE DRIVER. Every effect sits inside a match arm, so it executes only when the preceding stage
// held. Nothing is bound with `let` before its turn, and nothing effectful appears in an argument
// or list position -- those were the two shapes that made the previous body run mutations it had
// no business running.
//
// The chain is not a fold: each stage needs a different effect and some need values the previous
// stage produced (the resolved curl path), so a uniform step function would have to carry a union
// of every stage's inputs. The sequencing decision IS folded -- that is websocat_after, which this
// driver and the trace witness both consume.
// THE DRIVER DEPENDS ON THE STAGE websocat_after NAMED, rather than assuming it. This closes a
// real fork that the first cut left open and the first mutation could not see: every driver site
// matched `WebsocatContinue { next: _ }` and then ran the stage it expected, so websocat_after was
// the sole authority for STOP-OR-CONTINUE while the stage EDGE was hardcoded a second time in the
// driver. Rewriting an edge -- EnsureDirectory continuing to Download instead of EnsureOwnership --
// would have reddened the trace, which follows `next`, while production carried on in its original
// order. Two authorities agreeing today is not one authority (raised in side-chat review).
//
// Comparison goes through websocat_stage_label because that fold is already the total, exhaustive
// projection of the stage type; adding a second equality over the same coproduct would be the fork
// this function exists to remove.
fn websocat_edge_admits(actual: WebsocatStage, expected: WebsocatStage) -> Bool {
  websocat_stage_label(stage: actual) == websocat_stage_label(stage: expected)
}

// A DISAGREEMENT REFUSES; IT DOES NOT PROCEED AND IT DOES NOT GUESS. The driver cannot honour a
// transition it does not implement, and running the stage it happens to have code for would be the
// absorbing fallback -- carrying on because carrying on is available.
fn websocat_edge_disagreement(actual: WebsocatStage, expected: WebsocatStage) -> Srv3HostPredicate {
  Srv3PredicateUnobserved {
    reason: join([
      "srv3 websocat: the sequence authority named stage ",
      websocat_stage_label(stage: actual),
      " but this driver site implements ",
      websocat_stage_label(stage: expected),
      " -- the walk and the driver disagree about the stage order, so no host was touched",
    ], ""),
  }
}

fn srv3_ensure_websocat(transport: HostEffectTransport) -> Srv3HostPredicate {
  let install_path = websocat_install_path as String
  match websocat_after(
    stage: ObserveInstalled,
    outcome: srv3_transport_test_executable(path: install_path, transport: transport),
  ) {
    WebsocatAlreadySatisfied => Srv3PredicateHolds
    WebsocatStop { verdict: v } => v
    WebsocatContinue { next: n } =>
      match websocat_edge_admits(actual: n, expected: ResolveCurl) {
        false => websocat_edge_disagreement(actual: n, expected: ResolveCurl)
        true =>
          match srv3_tool_bin_path(tool: curl_cli_tool, transport: transport) {
            Srv3TokenUnobserved { reason: why } => Srv3PredicateUnobserved { reason: why }
            Srv3TokenAbsent => Srv3PredicateFails
            Srv3TokenObserved { value: curl_path } =>
              srv3_websocat_install_from(
                curl_path: curl_path,
                install_path: install_path,
                transport: transport,
              )
          }
      }
  }
}

// ONE FUNCTION PER STAGE, rather than one function nesting five matches. The nesting was not a
// style problem: at depth five, adding the edge check to each site pushed the effect bodies far
// enough right that the thing being guarded stopped being visible beside its guard. Each stage now
// runs its own effect, consults the sequence authority, checks that the authority named the stage
// this chain implements next, and calls it. The stage order therefore appears exactly once as data
// (in websocat_after) and once as a call graph that refuses when the two disagree.
fn srv3_websocat_install_from(
  curl_path: String,
  install_path: String,
  transport: HostEffectTransport,
) -> Srv3HostPredicate {
  websocat_stage_ensure_directory(
    curl_path: curl_path,
    install_path: install_path,
    transport: transport,
  )
}

fn websocat_stage_ensure_directory(
  curl_path: String,
  install_path: String,
  transport: HostEffectTransport,
) -> Srv3HostPredicate {
  let bin_dir = gunbc_bin_dir as String
  match websocat_after(
    stage: EnsureDirectory,
    outcome: srv3_elevated_witness_bin_success(
      transport: transport,
      command: mkdir_parents_argv(path: bin_dir),
    ),
  ) {
    WebsocatAlreadySatisfied => Srv3PredicateHolds
    WebsocatStop { verdict: v } => v
    WebsocatContinue { next: n } =>
      match websocat_edge_admits(actual: n, expected: EnsureOwnership) {
        false => websocat_edge_disagreement(actual: n, expected: EnsureOwnership)
        true =>
          websocat_stage_ensure_ownership(
            curl_path: curl_path,
            install_path: install_path,
            transport: transport,
          )
      }
  }
}

fn websocat_stage_ensure_ownership(
  curl_path: String,
  install_path: String,
  transport: HostEffectTransport,
) -> Srv3HostPredicate {
  match websocat_after(
    stage: EnsureOwnership,
    outcome: srv3_ensure_directory_owned_by_current_user(
      path: gunbc_bin_dir as String,
      transport: transport,
    ),
  ) {
    WebsocatAlreadySatisfied => Srv3PredicateHolds
    WebsocatStop { verdict: v } => v
    WebsocatContinue { next: n } =>
      match websocat_edge_admits(actual: n, expected: Download) {
        false => websocat_edge_disagreement(actual: n, expected: Download)
        true =>
          websocat_stage_download(
            curl_path: curl_path,
            install_path: install_path,
            transport: transport,
          )
      }
  }
}

fn websocat_stage_download(
  curl_path: String,
  install_path: String,
  transport: HostEffectTransport,
) -> Srv3HostPredicate {
  match websocat_after(
    stage: Download,
    outcome: srv3_transport_witness_bin_success(
      transport: transport,
      workdir: "/",
      bin_path: curl_path,
      args: [
        "-fsSL",
        srv3_actuator_toolchain_websocat_release_download_url(),
        "-o",
        install_path,
      ],
    ),
  ) {
    WebsocatAlreadySatisfied => Srv3PredicateHolds
    WebsocatStop { verdict: v } => v
    WebsocatContinue { next: n } =>
      match websocat_edge_admits(actual: n, expected: EnsureExecutableMode) {
        false => websocat_edge_disagreement(actual: n, expected: EnsureExecutableMode)
        true =>
          websocat_stage_ensure_executable_mode(
            install_path: install_path,
            transport: transport,
          )
      }
  }
}

fn websocat_stage_ensure_executable_mode(
  install_path: String,
  transport: HostEffectTransport,
) -> Srv3HostPredicate {
  match websocat_after(
    stage: EnsureExecutableMode,
    outcome: srv3_transport_argv_success(
      transport: transport,
      argv: chmod_add_executable_argv(path: install_path),
    ),
  ) {
    WebsocatAlreadySatisfied => Srv3PredicateHolds
    WebsocatStop { verdict: v } => v
    WebsocatContinue { next: n } =>
      match websocat_edge_admits(actual: n, expected: Readback) {
        false => websocat_edge_disagreement(actual: n, expected: Readback)
        true =>
          websocat_after_readback(
            outcome: srv3_transport_test_executable(
              path: install_path,
              transport: transport,
            ),
          )
      }
  }
}

// The readback is the ONLY thing that admits convergence. A successful chmod is not evidence the
// binary is executable; the previous body treated the batch as the answer and re-observed only as
// one more element of it.
fn websocat_after_readback(outcome: Srv3HostPredicate) -> Srv3HostPredicate {
  match websocat_after(stage: Readback, outcome: outcome) {
    WebsocatAlreadySatisfied => Srv3PredicateHolds
    WebsocatStop { verdict: v } => v
    WebsocatContinue { next: n } => websocat_edge_disagreement(actual: n, expected: Readback)
  }
}

// CONJUNCTION THAT DOES NOT LOSE THE THIRD STATE. `&&` over Bool answered false whether a step
// failed or could not be run; this reports Unobserved if ANY step could not be observed, and
// Fails only when every step was actually observed and one of them said no.
// A SUMMARY, NOT A SEQUENCER, and the name now says so. It folds observations that have ALREADY
// been made independently -- four separate tool ensures, none of which gates another -- and it
// cannot sequence anything, because by the time a list reaches it every element has been
// evaluated. Reading it as "run these in order, stopping on failure" is what let the websocat
// path run four mutations unconditionally. Sequencing lives in websocat_after and nowhere else.
fn srv3_combine_observed_accumulator_with_step(acc: Srv3HostPredicate, step: Srv3HostPredicate) -> Srv3HostPredicate {
  match step {
    Srv3PredicateUnobserved { reason: why } => Srv3PredicateUnobserved { reason: why }
    Srv3PredicateFails => Srv3PredicateFails
    Srv3PredicateHolds => acc
  }
}

fn srv3_summarize_independent_observations(steps: List<Srv3HostPredicate>) -> Srv3HostPredicate {
  fold_list(
    xs: steps,
    empty: Srv3PredicateHolds,
    cons: fn(acc, step) {
      match acc {
        Srv3PredicateUnobserved { reason: why } => Srv3PredicateUnobserved { reason: why }
        Srv3PredicateFails => srv3_combine_observed_accumulator_with_step(acc: acc, step: step)
        Srv3PredicateHolds => srv3_combine_observed_accumulator_with_step(acc: acc, step: step)
      }
    },
  )
}

// Total over all three states, so a receipt line can never render Unobserved as "fail".
fn srv3_predicate_label(p: Srv3HostPredicate) -> String {
  match p {
    Srv3PredicateHolds => "ok"
    Srv3PredicateFails => "fail"
    Srv3PredicateUnobserved { reason: _ } => "unobserved"
  }
}

fn srv3_toolchain_observed(success: Bool, stdout: String) -> ShellExecObserved {
  ShellExecObserved {
    exit_code: if success { 0 } else { 1 },
    success: success,
    stdout: stdout,
    stderr: if success { "" } else { "actuator-toolchain-ensure: one or more tools failed ensure" },
  }
}

// HOW A TOOL IS ACQUIRED IS A ROW, NOT A CALL SITE. Four hand-written ensures sat here, three
// calling the apt path and one calling the websocat path, so "which mechanism installs this tool"
// was expressed only by which function the author happened to call -- and the receipt that reports
// them was a hand-built concat chain naming each tool twice, once as a literal and once as a
// variable. Adding a tool meant editing three places and remembering the fourth.
//
// require_version_probe lives INSIDE the apt variant rather than beside the acquisition, because
// the release path has no version probe to require. As a peer field it was a value one variant
// ignored -- a state the type admitted and the code silently dropped.
type Srv3ToolAcquisition
  = AcquireViaAptPackage { package: NonEmptyStr, require_version_probe: Bool }
  | AcquireViaWebsocatRelease

type Srv3ToolRow {
  tool: CliTool
  acquisition: Srv3ToolAcquisition
}

// THE DISPATCH IS THE ONLY PLACE A MECHANISM IS CHOSEN, and it is total over the acquisition
// coproduct: a new mechanism is a variant, and this match refuses to compile until it is answered.
fn srv3_ensure_tool(row: Srv3ToolRow, transport: HostEffectTransport) -> Srv3HostPredicate {
  match row.acquisition {
    AcquireViaAptPackage { package: p, require_version_probe: needs_version } =>
      srv3_ensure_apt_tool(
        tool: row.tool,
        package: p,
        require_version_probe: needs_version,
        transport: transport,
      )
    AcquireViaWebsocatRelease => srv3_ensure_websocat(transport: transport)
  }
}

fn srv3_toolchain_rows() -> List<Srv3ToolRow> {
  [
    Srv3ToolRow {
      tool: curl_cli_tool,
      acquisition: AcquireViaAptPackage { package: package_curl, require_version_probe: true },
    },
    Srv3ToolRow {
      tool: nbdkit_cli_tool,
      acquisition: AcquireViaAptPackage { package: package_nbdkit, require_version_probe: true },
    },
    Srv3ToolRow {
      tool: socat_cli_tool,
      acquisition: AcquireViaAptPackage { package: package_socat, require_version_probe: false },
    },
    Srv3ToolRow {
      tool: websocat_cli_tool,
      acquisition: AcquireViaWebsocatRelease,
    },
  ]
}

type Srv3ToolObservation {
  tool_name: NonEmptyStr
  verdict: Srv3HostPredicate
}

// THE RECEIPT IS DERIVED FROM THE SAME ROWS THE ENSURE WALKED, so a tool cannot appear in one and
// not the other, and its label cannot disagree with its row.
fn srv3_tool_receipt_entry(observation: Srv3ToolObservation) -> String {
  concat(
    concat(observation.tool_name as String, "="),
    srv3_predicate_label(p: observation.verdict),
  )
}

fn srv3_toolchain_receipt(observations: List<Srv3ToolObservation>) -> String {
  concat(
    "OsInstallActuatorToolchainReceipt: ",
    string_concat_join(fields: observations.map(o => srv3_tool_receipt_entry(observation: o)), separator: " "),
  )
}

fn srv3_realize_os_install_actuator_toolchain_ensure_body(
  transport: HostEffectTransport,
  effect_intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let observations = srv3_toolchain_rows().map(row =>
    Srv3ToolObservation {
      tool_name: row.tool.program.invocation,
      verdict: srv3_ensure_tool(row: row, transport: transport),
    }
  )
  let verdict = srv3_summarize_independent_observations(
    steps: observations.map(o => o.verdict),
  )
  let stdout = srv3_toolchain_receipt(observations: observations)
  match verdict {
    Srv3PredicateUnobserved { reason: why } =>
      NotConverged {
        reason: concat(
          concat(
            "host_effect_apply: Srv3OsInstallActuatorToolchainEnsure could not observe one or more tools on this transport, so no ensure verdict is claimed: ",
            why,
          ),
          concat(" | ", stdout),
        ),
        applied: effect_intent,
      }
    Srv3PredicateHolds =>
      srv3_toolchain_ensure_reconcile(
        observed: srv3_toolchain_observed(success: true, stdout: stdout),
        intent: effect_intent,
      )
    Srv3PredicateFails =>
      srv3_toolchain_ensure_reconcile(
        observed: srv3_toolchain_observed(success: false, stdout: stdout),
        intent: effect_intent,
      )
  }
}

fn realize_os_install_actuator_toolchain_ensure(
  effect_intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match effect_intent.transport {
    LocalShell =>
      srv3_realize_os_install_actuator_toolchain_ensure_body(
        transport: effect_intent.transport,
        effect_intent: effect_intent,
      )
    SshShell { ssh_host: _ } =>
      srv3_realize_os_install_actuator_toolchain_ensure_body(
        transport: effect_intent.transport,
        effect_intent: effect_intent,
      )
    FleetSsh { target: _, context: _ } =>
      srv3_realize_os_install_actuator_toolchain_ensure_body(
        transport: effect_intent.transport,
        effect_intent: effect_intent,
      )
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      NotConverged {
        reason: "host_effect_apply: OsInstallActuatorToolchainEnsure cannot use EmitArtifactThenThinRun transport; typed mismatch.",
        applied: effect_intent,
      }
  }
}

// The ensure arm installs sccache by running the generic verified download-plus-install effect
// (gunbc.host.verified_binary_install) with sccache's boundary values supplied by its adapter
// gunbc.host.sccache_verified_install: pinned release url, per-arch sha256 verified BEFORE anything
// is moved, landing at sccache_installed_binary_path — it does NOT hand-roll a package-manager
// install. The declaration this arm used to call, extdeps.cache.sccache.sccache_install_script, is
// deleted (its script body was a concat-built bash string; a digest mismatch aborted it via set -e,
// which the typed admission now states instead of behaving). Until
// 2026-07-24 this module ran `sudo -n apt-get install -y sccache` and wrote a unit with
// ExecStart=/usr/bin/sccache, a §3 fork of the same concept: P1:runner-deploy-slot installs the
// pinned tarball to /usr/local/bin and then P1b:build-cache-provision pointed its unit at a path
// that install never creates, so the daemon could not start and the read-back refused. Both the
// install and the unit now read ONE path row, so the two phases cannot disagree.

// This ensure body writes a SYSTEM-scope unit (/etc/systemd/system/<intended_unit>,
// WantedBy=multi-user.target, per render_build_cache_unit) rather than the user-scope unit
// (~/.config/systemd/user, enable-linger) the deleted gunbc.host_build_cache_provision_script
// builder used. That earlier form needed `sudo -n loginctl enable-linger "$USER"` to survive the
// provisioning ssh connection closing, which is real shell this render's system scope makes
// unnecessary — a `systemd --user` manager has no login to outlive when the unit is system-scoped.
// This is a consequence of the A5 grain swap (EnsureBuildCacheInstance { desired:
// BuildCacheInstance }), not an independently decided handler choice:
// BuildCacheInstance.intended_unit is a single row ("gunbc-build-cache-ci.service",
// WantedBy=multi-user.target) already grounded on a live srv1 capture, and the render is the single
// authority for the unit body, so writing it anywhere but where the render says WantedBy points is
// a second representation of the same fact. The install/enable/restart sequence reuses
// gunbc.live_deploy.operations' existing typed-argv-backed command builders
// (systemctl_daemon_reload_command / systemctl_enable_command / systemctl_restart_command, each
// privileged: true) rather than hand-spelling new sudo -n systemctl strings, matching the idiom
// already established in gunbc.live_deploy.emit and gunbc.host.host_axis_caps — a further §3 de-fork
// consistent with why this swap exists.

// The misconfigured-fragment classifier is a FOLD over the cited roster
// extdeps.cache.sccache.sccache_misconfigured_log_fragments, not one emitted branch per fragment.
// The roster is data the loop iterates: adding a fragment upstream changes the classifier's coverage
// and nothing else. THE ONE HAZARD THIS SCAN USED TO GUARD, AND NO LONGER CAN: a fragment that
// matches every capture. `string_contains(s:, pattern: "")` is true of everything, so an EMPTY entry
// would classify every unresponsive host as misconfigured -- and that hazard is now closed where it is
// writable, at the declaration: the roster is `List<NonEmptyStr>` upstream, so `""` is a compile error
// (extdeps.cache.sccache). A runtime check for it would be green-by-construction, so there is none here;
// the claims assert what can actually fail, and the classifier's own negative controls (a capture that
// is empty, or that omits every fragment) are what pin the scan. THE EMITTED SHELL WORD LIST IS GONE:
// fragments used to be single-quoted into `for frag in ...`, so a quote in one was a syntax error on the
// host -- nothing splices these into a command any more, and the old shell-safety predicate retired with
// the script that needed it (review 82053: its name promised a shell check while its body had become an
// emptiness check that no input could fail).

// THE READ-BACK FAILS CLOSED, ASSERTED ON THE TYPED ROUTE. What this predicate has always pinned is that a
// post-ensure stats query which does NOT succeed cannot be reported as a converged daemon -- the property
// the script got from `|| { printf read_back=FAILED; exit 1; }`. It is now asserted on the records rather
// than on script text, which is the stronger form: the three cases a text scan could not tell apart (a
// non-zero exit, a read that never ran, and a zero exit with no evidence) are three different arms here,
// and all three must refuse. The old text scan asserted the FAILURE WORDS existed; it could not assert the
// OUTCOME, which is what "fails closed" actually claims.
fn build_cache_provision_read_back_fails_closed() -> Bool {
  let owned = ServerManagedUnitOwned { unit: "sccache-server.service" as NonEmptyStr }
  build_cache_read_back_refuses_capture(
    stdout_: "stats table",
    stderr_: "connection refused",
    owned: owned,
  ) && build_cache_read_back_refuses_unreadable(owned: owned)
    && build_cache_read_back_reports_answered_table(owned: owned)
}

// A NON-ZERO READ-BACK IS NEVER A CONVERGED DAEMON, and the host's bytes reach the reason (stderr is what
// the operator needs, and it is preferred over stdout exactly as the retired read-back preferred it).
fn build_cache_read_back_refuses_capture(stdout_: String, stderr_: String, owned: BuildCacheServerPlacement) -> Bool {
  match build_cache_read_back_observation(
    read_back: Ran {
      observed: BuildCacheHostRunObserved { exit_code: 1, stdout: stdout_, stderr: stderr_ },
    },
    placement: owned,
  ) {
    DaemonUnresponsive { detail: d } => string_contains(s: d as String, pattern: stderr_)
    DaemonStatsOk { stats_line: _, placement: _ } => false
    DaemonMisconfigured { matched_fragment: _, detail: _ } => false
    DaemonAbsent => false
    DaemonPathShadowed { resolved: _, expected: _ } => false
    DaemonUnsupervised { unit: _, unit_state: _ } => false
  }
}

// A READ-BACK THAT COULD NOT RUN IS NEVER A CONVERGED DAEMON EITHER. This arm is the one the receipt
// protocol could not express: the script's classifier saw only "no read_back=ok in the blob", and a blob
// that was empty because the run was refused looks the same as one that was empty because the host was
// silent. Here they are different inputs, and both refuse.
fn build_cache_read_back_refuses_unreadable(owned: BuildCacheServerPlacement) -> Bool {
  match build_cache_read_back_observation(
    read_back: CouldNotRun { phase: "the read-back", reason: "the transport refused" },
    placement: owned,
  ) {
    DaemonUnresponsive { detail: d } => string_contains(s: d as String, pattern: "the transport refused")
    DaemonStatsOk { stats_line: _, placement: _ } => false
    DaemonMisconfigured { matched_fragment: _, detail: _ } => false
    DaemonAbsent => false
    DaemonPathShadowed { resolved: _, expected: _ } => false
    DaemonUnsupervised { unit: _, unit_state: _ } => false
  }
}

// AND A SUCCESSFUL READ-BACK REPORTS THE TABLE IT CAPTURED, rather than a marker it printed about itself:
// the bytes the host produced are what reach placement_verdict as the evidence of a converged instance.
fn build_cache_read_back_reports_answered_table(owned: BuildCacheServerPlacement) -> Bool {
  match build_cache_read_back_observation(
    read_back: Ran { observed: BuildCacheHostRunObserved { exit_code: 0, stdout: "CacheStats", stderr: "" } },
    placement: owned,
  ) {
    DaemonStatsOk { stats_line: line, placement: _ } => line == "CacheStats"
    DaemonUnresponsive { detail: _ } => false
    DaemonMisconfigured { matched_fragment: _, detail: _ } => false
    DaemonAbsent => false
    DaemonPathShadowed { resolved: _, expected: _ } => false
    DaemonUnsupervised { unit: _, unit_state: _ } => false
  }
}

// THE INSTALL BRANCH STILL CITES THE RELEASE AND STILL DOES NOT REACH FOR A PACKAGE MANAGER -- asserted on
// the DERIVED OPS rather than on a script body. Same four assertions the script-era predicate made, and the
// reason to keep all four is that the install legs are now argv built by gunbc.host.verified_binary_install
// from a caller-supplied release row: if a future change pointed the plan at a distro package, or dropped
// the version from the URL, or installed to the distro path, this is the production oracle that notices.
// Rendering the argv is for the ASSERTION only -- the effect never runs a shell (see
// gunbc.host.verified_binary_install for why a joined string is not an execution form).
fn build_cache_install_is_cited_not_package_manager() -> Bool {
  let rendered = build_cache_ensure_ops_rendered(
    instance: ci_cache_instance(host: srv1_host.identity),
    arch_token: "aarch64" as NonEmptyStr,
    digest: sccache_release_0_15_0.digest_aarch64,
    install_needed: true,
  )
  string_contains(s: rendered, pattern: "github.com/mozilla/sccache/releases/download/")
    && string_contains(s: rendered, pattern: sccache_release_0_15_0.version as String)
    && !string_contains(s: rendered, pattern: "apt-get install")
    && !string_contains(s: rendered, pattern: "/usr/bin/sccache")
}

// THE PRESENCE RECORD FOR THE RENDERING ORACLES, which ask for the two legs directly rather than
// reproducing a probe. Not the production route -- production derives this from the probe's own exit code
// through build_cache_binary_presence_of, and an oracle that wants to see the install legs asks for them.
fn build_cache_presence_for_render(install_needed: Bool) -> Optional<VerifiedBinaryInstallPresence> {
  if install_needed {
    Present { value: InstallNeeded { dest_path: sccache_installed_binary_path as String } }
  } else {
    Present { value: AlreadyInstalled { dest_path: sccache_installed_binary_path as String } }
  }
}

// EVERY OP THE ENSURE DERIVES, RENDERED FOR COMPARISON. Used by the production oracles only. The join
// separator is a newline so an assertion cannot accidentally match across two words of one argv (a space
// would let "install -m" and a following "-m" read as one phrase).
fn build_cache_ensure_ops_rendered(
  instance: BuildCacheInstance,
  arch_token: NonEmptyStr,
  digest: Digest,
  install_needed: Bool,
) -> String {
  match build_cache_daemon_ensure_plan(
    instance: instance,
    arch_token: arch_token,
    digest: digest,
    install: build_cache_presence_for_render(install_needed: install_needed),
  ) {
    BuildCachePlanRefused { reason: _ } => ""
    EnsureOps { ops: ops } =>
      fold(
        ops,
        init: "",
        f: (acc, op) =>
          join(
            [acc, if acc == "" { "" } else { "\n" }, shell_command_text_of_argv(argv: argv_words(command: op.argv))],
            "",
          )
      )
  }
}

// THE SCAN SEES EVERY CITED FRAGMENT, ASSERTED ON THE SCAN ITSELF. The retired version grepped the emitted
// classify BODY for each fragment -- an assertion that a string appeared somewhere in a script, which would
// pass even if the loop could never have selected it (a fragment in a comment, or behind an earlier branch)
// and would fail on a legitimate refactor. This asserts the behaviour instead: for every cited fragment, a
// capture containing it yields THAT fragment, so the row and the scan cannot drift -- adding a fragment
// upstream makes it observable here or makes this claim go red.
fn build_cache_classifier_covers_every_cited_fragment() -> Bool {
  fold(
    sccache_misconfigured_log_fragments,
    init: true,
    f: (acc, frag) =>
      acc
        && match build_cache_matched_stats_fragment(capture: join(["noise before ", frag, " noise after"], "")) {
          Present { value: got } => got == frag
          Absent => false
        },
  )
}

// The provisioning script is a function of the TARGET HOST's architecture, not a constant: the
// cited release publishes one musl tarball plus one sha256 per arch, so emitting a script at all
// requires knowing which. Arch comes from the effect target's own ComputeHost
// (compute_host_primary_cpu -> CpuFacts.architecture) and the token/digest selectors in
// extdeps.cache.sccache are partial over the Architecture coproduct — a host whose CPU is
// unreadable, or whose arch the release does not publish, yields NO script and a typed
// NotConverged. There is no default arch: shipping an aarch64 binary to an unlisted host is
// precisely the fabricated-plausible-output §5 forbids.

fn provision_build_cache_host_arch(effect_intent: HostEffectIntent) -> Architecture? {
  match effect_intent.target {
    HostOs { node: host } =>
      match compute_host_primary_cpu(host: host) {
        Present { value: cpu } => Present { value: cpu.catalog.architecture }
        Absent => none
      }
    BmcController { node: _ } => none
    RunnerLocalHost => none
  }
}

fn realize_provision_build_cache_body(
  instance: BuildCacheInstance,
  transport: HostEffectTransport,
  effect_intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match provision_build_cache_host_arch(effect_intent: effect_intent) {
    Absent =>
      NotConverged {
        reason: "host_effect_apply: EnsureBuildCacheInstance cannot derive a target architecture from the effect target (no primary CPU on the ComputeHost, or the target is not HostOs); fail-closed, no default arch.",
        applied: effect_intent,
      }
    Present { value: arch } =>
      match sccache_release_arch_token(arch: arch) {
        Absent =>
          NotConverged {
            reason: join(
              [
                "host_effect_apply: EnsureBuildCacheInstance refused — the cited sccache release ",
                sccache_release_0_15_0.version as String,
                " publishes no musl tarball for architecture ",
                architecture_diagnostic_name(arch: arch) as String,
                "; fail-closed, no default arch.",
              ],
              "",
            ),
            applied: effect_intent,
          }
        Present { value: token } =>
          match sccache_release_digest(rel: sccache_release_0_15_0, arch: arch) {
            Absent =>
              NotConverged {
                reason: join(
                  [
                    "host_effect_apply: EnsureBuildCacheInstance refused — no pinned sha256 in the cited release row for architecture ",
                    architecture_diagnostic_name(arch: arch) as String,
                    "; fail-closed, never install unverified.",
                  ],
                  "",
                ),
                applied: effect_intent,
              }
            Present { value: digest } => {
              let survey = survey_build_cache_endpoint(
                instance: instance,
                reads: build_cache_endpoint_reads(instance: instance, transport: transport),
              )
              let admission = admit_ensure_build_cache_instance(
                desired: instance,
                placement: survey.placement,
                observed_path: survey.path,
                currency: survey.currency,
              )
              match admission {
                EnsureAlreadyConverged { desired: _, unit: u } =>
                  build_cache_already_converged(unit: u, effect_intent: effect_intent)
                EnsureBuildCacheRefused { instance: _, reason: _ } =>
                  NotConverged {
                    reason: join(
                      [
                        "host_effect_apply: EnsureBuildCacheInstance refused before writing anything -- ",
                        ensure_admission_refusal_reason(admission: admission),
                      ],
                      "",
                    ),
                    applied: effect_intent,
                  }
                EnsureBuildCacheAdmitted { desired: _, preflight: pf, unit_file: _ } =>
                  build_cache_unlink_then_ensure(
                    instance: instance,
                    preflight: pf,
                    transport: transport,
                    effect_intent: effect_intent,
                    observed_path: survey.path,
                    currency: survey.currency,
                    token: token,
                    digest: digest,
                  )
              }
            }
          }
      }
  }
}

fn realize_provision_build_cache_wrong_effect(
  effect_intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  NotConverged {
    reason: "host_effect_apply: realize_provision_build_cache requires EnsureBuildCacheInstance effect",
    applied: effect_intent,
  }
}

fn realize_provision_build_cache(
  effect_intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match effect_intent.effect {
    EnsureBuildCacheInstance { desired: instance } =>
      match provision_build_cache_catalog_gate_verdict(catalog_id: instance.implementation) {
        ProvisionBuildCacheCatalogRefused { reason: reason } =>
          NotConverged { reason: reason as String, applied: effect_intent }
        ProvisionBuildCacheCatalogRealizable =>
          match effect_intent.transport {
            LocalShell =>
              realize_provision_build_cache_body(
                instance: instance,
                transport: effect_intent.transport,
                effect_intent: effect_intent,
              )
            SshShell { ssh_host: _ } =>
              realize_provision_build_cache_body(
                instance: instance,
                transport: effect_intent.transport,
                effect_intent: effect_intent,
              )
            FleetSsh { target: _, context: _ } =>
              realize_provision_build_cache_body(
                instance: instance,
                transport: effect_intent.transport,
                effect_intent: effect_intent,
              )
            EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
              NotConverged {
                reason: "host_effect_apply: EnsureBuildCacheInstance cannot use EmitArtifactThenThinRun transport; typed mismatch.",
                applied: effect_intent,
              }
          }
      }
    RedfishAction { action: _ } => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    ConvergePlan { policy: _ } => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    OsInstallActuatorToolchainEnsure {} => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    ProvisionCodexRuntime {} => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    EnsureCompilePoolSlice {} => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    SetHostnameCas { hostnamectl_path: _, base: _, desired: _ } => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    ReadEffectivePosixPrincipal { read: _ } => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    SudoNopasswdExecuteProbe { probe: _ } => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    SudoNopasswdGrantListProbe { probe: _ } => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    Srv3InstallMediaFetch => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    Srv3SeededInstallMediaRemaster => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    Srv3SeededInstallMediaToolchainEnsure => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    Srv3BmcwebSessionLogin { request_body_file: _ } => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    Srv3BmcwebTokenExtract => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    Srv3NbdProxyServe { intent: _, lease_key: _ } => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    CodexSupervisedWorkerTurn { intent: _, lease_key: _ } => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    Srv3BootOnceReadBackSleep => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    Srv3ReceiptEmit { lines: _ } => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    HostIdentityShortHostnameRead => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    LiveDeployApply { warrant: _ } => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    LiveDeployRetract { spec: _ } => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    LiveDeployApprovalBrokerDarkInstall { spec: _, candidate: _ } => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    LiveDeployMicrovmControllerInstall { candidate: _ } => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    LiveDeployEnsureDependency { dep: _ } => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    LiveDeployDigestReadback { port: _, expected_digest: _ } => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    LiveDeployServeRoute { endpoint: _, enabled: _ } => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    DeployAccessPreflight {} => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    EnsureActionsRunnerRelease { runner_release: _ } => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    EnsureRunnerSlotDirectory { slot: _, artifact: _ } => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    EnsureRunnerJitWrapper { host_label: _ } => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    EnsureRunnerSystemdTemplate { host_label: _ } => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    EnsureRunnerMemoryCaps { slot: _ } => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    ActivateRunnerSlot { slot: _ } => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    DrainAndMaskRunnerSlot { slot: _ } => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    ReplaceRunnerIncarnation { from: _, cause: _ } => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    ObserveRunnerLocalState { slot: _ } => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    ObserveGitHubRunnerRegistration { slot: _, organization: _ } => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
    ProbeToolchainHomeInterference {} => realize_provision_build_cache_wrong_effect(effect_intent: effect_intent)
  }
}

fn provision_build_cache_witness_intent() -> HostEffectIntent {
  HostEffectIntent {
    target: HostOs { node: srv1_host },
    effect: EnsureBuildCacheInstance { desired: ci_cache_instance(host: srv1_host.identity) },
    evidence: host_effect_identity_evidence,
    transport: LocalShell,
    privilege_denial: none,
  }
}

// A host the fleet knows by identity but whose processor inventory is empty — the shape a
// freshly-racked srvN has before its BMC read lands (srv4 carried exactly this deferral for
// memory). Realization must REFUSE it, because 'which binary do I install' has no answer. The
// fixture deliberately does NOT fabricate a CPU catalog row for an arch the cited release omits:
// minting a machine that does not exist to test a refusal would be its own §3 violation, so the
// not-published arm is witnessed at the selector (sccache_release_arch_token over Riscv64/Wasm32)
// instead.

fn provision_build_cache_arch_unknown_host_fixture() -> ComputeHost {
  ComputeHost {
    identity: srv1_host.identity,
    baseboard: none,
    processors: [],
    memory: [],
    storage: [],
    network_interfaces: [],
  }
}

fn provision_build_cache_arch_unknown_intent_fixture() -> HostEffectIntent {
  HostEffectIntent {
    target: HostOs { node: provision_build_cache_arch_unknown_host_fixture() },
    effect: EnsureBuildCacheInstance {
      desired: ci_cache_instance(host: provision_build_cache_arch_unknown_host_fixture().identity),
    },
    evidence: host_effect_identity_evidence,
    transport: LocalShell,
    privilege_denial: none,
  }
}

fn provision_build_cache_reconcile_shell_observed(
  observed: ShellExecObserved,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  provision_build_cache_reconcile(
    observed: observed,
    intent: provision_build_cache_witness_intent(),
  )
}

fn run_shell_transport(script: RetainedShellScript, transport: HostEffectTransport) -> ShellExecObserved {
  match transport {
    LocalShell => {
      let result = shell.Exec.Run(script: retained_shell_script_to_transport(rss: script), expect: OutcomeIsData)
      ShellExecObserved {
        exit_code: result.exit_code,
        success: result.success,
        stdout: result.stdout,
        stderr: result.stderr,
      }
    }
    SshShell { ssh_host: h } => {
      if script.body == "" {
        ShellExecObserved {
          exit_code: 1,
          success: false,
          stdout: "host_effect_apply: empty shell script over SshShell; fail-closed",
          stderr: "",
        }
      } else {
        let result = ssh_session_exec_script(host: h, script: script.body)
        ShellExecObserved {
          exit_code: result.exit_code,
          success: result.success,
          stdout: result.stdout,
          stderr: result.stderr,
        }
      }
    }
    FleetSsh { target: t, context: _ } =>
      ShellExecObserved {
        exit_code: 1,
        success: false,
        stdout: join([
          "host_effect_apply: run_shell_transport refuses the FleetSsh transport for endpoint=",
          known_hosts_host_field(address: t.address) as String,
          ". This carrier is a shell script BODY -- a command string, not argv -- and the fleet path admits",
          " only portable remote words, so there is no shaping that preserves the script's meaning. The refusal",
          " is the carrier's shape surfacing, not a missing case: the residue dissolves when the effect reaches",
          " this seam as a typed Do effect rather than as text (DESIGN, shell -> intent).",
        ], ""),
        stderr: "",
      }
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      ShellExecObserved {
        exit_code: 1,
        success: false,
        stdout: "host_effect_apply: retained shell scripts cannot use EmitArtifactThenThinRun transport; typed mismatch — reserved for ConvergePlan (host-effect Phase D).",
        stderr: "",
      }
  }
}

// WHAT A TRANSPORT RUNNER BROUGHT BACK, AS A COPRODUCT (DESIGN 5: the refusal must stay typed). Two
// shapes, kept apart so no caller can read a before-execution refusal as a process result:
// RunArgvTransportObserved carries a ShellExecObserved -- the leg RAN and this is what it returned,
// exit status included; RunArgvTransportRefused carries the portable-word wall's admission text --
// NO LEG RAN, so there is no exit code to report and any "exited N" line about this leg would be
// fabricated. The first draft of this seam folded the refusal into ShellExecObserved{exit_code: 1},
// which made the install fold report that an operation "exited 1" that never started. Callers match
// the arms, so each says which of the two happened.
type RunArgvTransportOutcome
  = RunArgvTransportObserved { observed: ShellExecObserved }
  | RunArgvTransportRefused { reason: String }

// ONE MAPPING FOR BOTH TRANSPORT RUNNERS. run_argv_over_host_effect_transport and
// run_argv_stdin_over_host_effect_transport differ only in which typed call carries the leg; what an
// outcome becomes is the same for both: the wall's refusal becomes the REFUSED arm, carrying the
// admission's own text (plus this edge's "before any ssh leg" marker, so the red names the broken
// wall rather than a connection error), and a converged result becomes the OBSERVED arm -- the
// process's real exit status and streams. The mapping is where the admission's verdict and the
// transport's carrier meet, and it is written once so the two arms cannot drift.
fn typed_argv_outcome_to_transport(typed: TypedArgvExecOutcome) -> RunArgvTransportOutcome {
  match typed {
    TypedArgvExecRefused { reason: why } =>
      RunArgvTransportRefused {
        reason: join(
          [
            "the portable-word wall refused the typed argv before any ssh leg: ",
            why,
          ],
          "",
        ),
      }
    TypedArgvExecConverged { result: result } =>
      RunArgvTransportObserved {
        observed: ShellExecObserved {
          exit_code: result.exit_code,
          success: result.exit_code == 0,
          stdout: result.stdout,
          stderr: result.stderr,
        },
      }
  }
}

// THE LOCALSHELL DECOMPOSITION, AS A PURE FUNCTION (DESIGN 3: the witness discriminates at this
// interface, and the values are supplied -- no process, no exec). An ArgvCommand is one typed value;
// shell.Exec.RunArgv / RunArgvStdin take the program and its arguments as DISTINCT parameters, and
// the split is where the program can be doubled: argv_words(command) already starts with the
// program, so passing it as the argument words hands the op the program twice (the double-sudo shape
// the side chat measured on this very fold). Both wet LocalShell arms delegate here, and the
// witness supplies commands and pins the discriminating property -- the program is the `program`
// parameter and does NOT appear among the argument words. The argument field carries the
// ProcessArgvExpansion the op consumes (the computed-surface carrier, not a raw list: a bare
// List<String> at an argv position is exactly the ambiguity the carrier exists to close); the
// witness projects the words out through process_argv_expansion_surface and cli_surface_arguments
// to check membership. The printf receipts that used to exec printf locally are gone: the floor
// runs changed witnesses hermetically and never reaches an exec, so a receipt that needs a real
// process is not a floor claim.
type RunArgvParameters {
  program: String
  arguments: ProcessArgvExpansion
}

fn run_argv_parameters_of(command: ArgvCommand) -> RunArgvParameters {
  RunArgvParameters {
    program: command.program.invocation,
    arguments: process_argv_expansion(surface: cli_surface_of_literal_words(words: command.arguments)),
  }
}

// THE HOST-EFFECT TRANSPORT TAKES TYPED ARGV. This is run_shell_transport's typed sibling: an
// ArgvCommand already built by cited extdeps builders, run over the same HostEffectTransport arms.
// LocalShell runs shell.Exec.RunArgv -- the program word and the argument words as DISTINCT
// parameters, the state-space collapse the RunArgv op exists to close. The split is factored into
// run_argv_parameters_of (both LocalShell arms delegate), because that split is where the program
// can be doubled: the argument words are command.arguments, NOT argv_words(command) -- argv_words
// re-prepends the program, and passing it here would hand RunArgv the program twice (execve with
// argv[1] = the program path, the double-sudo shape) -- and the witness discriminates at the pure
// function, not at an exec. SshShell routes through typed_argv_exec_over_ssh, which owns both the
// shaping (shape_ssh_shell_exec: host, `--`, words -- the one arm where argv_words is correct,
// because the remote vector starts with the program) and the portable-word wall, so a word the
// remote shell would re-parse refuses here before any ssh leg; there is no empty-script refusal
// arm because there is no script -- an ArgvCommand structurally always names a program (the
// sole_constructor wall's own note at extdeps.exec.command). RunArgv's output carries no success
// field (the no-success-field discipline recorded at extdeps.shell.exec), so success derives from
// the exit status here, where the ShellExecObserved carrier requires it -- the same derivation
// every RunArgv caller makes.
//
// FleetSsh is the same typed-argv mapping as run_typed_argv_transport: portable words through
// typed_argv_exec_over_fleet_ssh (sealed known-hosts context and bound credential). The old
// refusal was fail-closed until that seam existed; it exists, and SshShell already mapped the
// same way through typed_argv_exec_over_ssh. A second path that called the fleet seam from a
// leaf while this dispatcher still refused is the parallel-authority tell. EmitArtifactThenThinRun
// still refuses: it is not a typed argv transport. The stdin sibling maps FleetSsh the same way
// through typed_argv_exec_over_fleet_ssh_with_stdin.
fn run_argv_over_host_effect_transport(command: ArgvCommand, transport: HostEffectTransport) -> RunArgvTransportOutcome {
  match transport {
    LocalShell => {
      let params = run_argv_parameters_of(command: command)
      let result = shell.Exec.RunArgv(program: params.program, arguments: params.arguments)
      RunArgvTransportObserved {
        observed: ShellExecObserved {
          exit_code: result.exit_code,
          success: result.exit_code == 0,
          stdout: result.stdout,
          stderr: result.stderr,
        },
      }
    }
    SshShell { ssh_host: h } =>
      typed_argv_outcome_to_transport(typed: typed_argv_exec_over_ssh(host: h, argv: argv_words(command: command)))
    FleetSsh { target: t, context: c } =>
      typed_argv_outcome_to_transport(typed: typed_argv_exec_over_fleet_ssh(target: t, context: c, argv: argv_words(command: command)))
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      RunArgvTransportRefused {
        reason: "host_effect_apply: typed argv cannot use EmitArtifactThenThinRun transport; reserved for ConvergePlan (host-effect Phase D).",
      }
  }
}

// THE STDIN SIBLING, for the one op in a fold whose payload is DATA rather than words: unit-file
// bytes cross the transport as stdin to dd, never as script text and never as an argv element, so a
// unit body carrying quotes, spaces or metacharacters cannot change the command's meaning whatever
// it contains. Same arms, same refusal posture, same exit-status derivation. FleetSsh admits the
// words exactly as the argv runner does and hands the payload to the leg typed_remote_file_write
// already runs against the same principal (exec_as_fleet_principal_with_stdin): one sealed context,
// one bound credential, the payload never a word.
// THE ELEVATION SPLIT: one fold, two principals. A job that runs ON the host it mutates keeps its
// unelevated legs (downloads, extraction, digests of its own checkout) as the job user, and sends
// every elevated leg to a principal that holds root without the job user holding it -- the fleet
// administrator over its SSH edge (gunbc.fleet.fleet_bootstrap_principal). Which side a leg runs on is
// read from the command itself (extdeps.sudo.elevation argv_command_is_sudo_elevated), never chosen
// per call site, so a leg cannot be elevated on one principal and run on the other. A fold with one
// principal is the route whose two sides are the same transport.
type HostEffectElevationRoute {
  unelevated: HostEffectTransport
  elevated: HostEffectTransport
}

fn one_transport_route(transport: HostEffectTransport) -> HostEffectElevationRoute {
  HostEffectElevationRoute { unelevated: transport, elevated: transport }
}

fn elevation_route_transport(route: HostEffectElevationRoute, command: ArgvCommand) -> HostEffectTransport {
  if argv_command_is_sudo_elevated(command: command) { route.elevated } else { route.unelevated }
}

fn run_argv_over_elevation_route(command: ArgvCommand, transport: HostEffectElevationRoute) -> RunArgvTransportOutcome {
  run_argv_over_host_effect_transport(command: command, transport: elevation_route_transport(route: transport, command: command))
}

fn run_argv_stdin_over_elevation_route(command: ArgvCommand, stdin_payload: String, transport: HostEffectElevationRoute) -> RunArgvTransportOutcome {
  run_argv_stdin_over_host_effect_transport(command: command, stdin_payload: stdin_payload, transport: elevation_route_transport(route: transport, command: command))
}

// THE CAPTURE OF ONE HOST COMMAND, AS A RECORD THE TYPED ENSURE CLASSIFIES. ONE runner for reads and
// writes, because run_argv_over_host_effect_transport and run_argv_stdin_over_host_effect_transport both
// preserve stdout AND stderr on a non-zero exit for LocalShell and SshShell -- which is the property this
// effect needs, and the reason it is NOT routed through build_cache_host_read_observed: that helper's
// LocalShell arm yields an EMPTY stdout on a refused command, which would have emptied the
// misconfigured-fragment scan on exactly the hosts the scan exists for (a fragment appears in the output of
// a query that then exits non-zero). Refusing to run at all is kept distinct from a non-zero exit: there was
// no process, so there is no exit code to report, and the transport's own text is what the operator sees.
fn build_cache_argv_read_outcome(command: ArgvCommand, transport: HostEffectTransport) -> BuildCacheHostRunOutcome {
  match run_argv_over_host_effect_transport(command: command, transport: transport) {
    RunArgvTransportRefused { reason: r } => CouldNotRun { phase: "argv read", reason: r }
    RunArgvTransportObserved { observed: o } =>
      Ran {
        observed: BuildCacheHostRunObserved { exit_code: o.exit_code, stdout: o.stdout, stderr: o.stderr },
      }
  }
}

// THE ENSURE AS EFFECTS, WITH THE STAGED SIBLING DISCARDED IN EVERY ARM. The plan is DERIVED from the
// observe record (so a dry witness can name every argv and the order they run in before anything runs),
// then the ops run in order and the FIRST failure ends it -- what `set -e` did, now named. The discard runs
// whichever arm returns: that is the counterpart of the script's `trap ... EXIT`, which cannot be entrusted
// to the path a script happened to take, and it is an operation rather than a shell trap so a witness can
// see the cleanup exists.
//
// Every arm says something true of a real sequence, and there is no "ran, and here is an invented exit
// code": a transport that refused yields EnsureTransportBlocked with the transport's text, and a failed op
// yields EnsureFailed with the op and its own capture.
fn build_cache_ensure_executed(
  instance: BuildCacheInstance,
  arch_token: NonEmptyStr,
  digest: Digest,
  observe: BuildCacheObserve,
  transport: HostEffectTransport,
) -> BuildCacheEnsureExecuted {
  if !build_cache_ensure_is_needed(observe: observe) {
    EnsureSkipped
  } else {
    let unit_bytes = build_cache_unit_bytes(instance: instance)
    let discard = build_cache_unit_stage_discard_command(instance: instance)
    // The generic effect's parameters, built from the same release row the retired script read its URL
    // and digest from: arch and digest arrive as parameters because which release is current is policy,
    // and policy is not allowed to be baked into an argv.
    let install_params = build_cache_sccache_install_params(arch_token: arch_token, digest: digest)
    match build_cache_daemon_ensure_plan(
      instance: instance,
      arch_token: arch_token,
      digest: digest,
      install: build_cache_binary_presence_of(observe: observe, p: install_params),
    ) {
      BuildCachePlanRefused { reason: r } => EnsurePlanRefused { reason: r }
      EnsureOps { ops: ops } => {
        // PASS ONE RUNS WHAT MAY RUN BEFORE ANYTHING IS KNOWN ABOUT THE DIGEST: for a plan that installs,
        // the fetch and the read and nothing past them; for a plan that does not (the binary is already at
        // the destination), every leg, since there is no gate to wait behind. The fold's carrier comes
        // back with the digest line the read produced, which is the only thing that can decide pass two.
        let prefix = build_cache_ensure_run_legs(
          run: build_cache_ensure_run(ops: ops, digest: digest, observed_digest_line: none),
        )
        let first = build_cache_run_ensure_ops(
          state: BuildCacheEnsureFold { executed: EnsureCompleted, digest_line: none },
          ops: prefix,
          unit_bytes: unit_bytes,
          transport: transport,
          plan: ops,
          digest: digest,
        )
        // ONE DECISION SITE, NOT TWO. Pass two used to consult the gate here, over the line the fold carried
        // back, and so said nothing new -- but a second site consulting the same authority is still a site, and
        // the thing that keeps `build_cache_ensure_run` authoritative is that there is exactly one place a read
        // line is turned into permission or refusal. That place is now the pure step, at the leg where the host
        // answered, which both this loop and the witness fold call. What is left here is not a gate: it is
        // "some prefix leg stopped the sequence, so pass two does not run", which is about the SEQUENCE and is
        // read off the carrier rather than re-derived.
        let outcome =
          if !build_cache_ensure_fold_is_progressing(fold_state: first) {
            // A leg of the prefix itself stopped the sequence — a fetch that could not download, a read that
            // could not hash the file, or the read answering with a digest that is not the pinned one. The arm
            // names the operation and carries the host's own capture or both digests, and pass two does not
            // run, so there is no extraction, no move into /usr/local/bin and no chmod.
            first.executed
          } else {
            // The count comes from the ONE list_length authority, named by module path rather than
            // by bare name. A site-local `list_length` in gunbc.site.aligned_columns was an exact
            // re-mint of std.types.list_length<T>; it broke the bare call here (the whole-corpus
            // effect census refused it: no established callee identity) and was deleted at the root
            // in the same commit, aligned_columns retargeted to this same authority. The
            // qualification STAYS even with the fork gone: a bare name in the flat namespace is
            // green only by ambient coverage that any later re-mint silently breaks — the callee
            // identity is named, not assumed.
            // Authority: dag/std/types.dag `list_length`. Recurring failure mode:
            // bare_name_resolved_only_by_the_flat_namespace.
            let rest = build_cache_plan_remainder(
              all: ops,
              already_run: std.types.list_length(items: prefix)
            )
            build_cache_run_ensure_ops(
              state: first,
              ops: rest,
              unit_bytes: unit_bytes,
              transport: transport,
              plan: ops,
              digest: digest,
            ).executed
          }
        let _ = run_argv_over_host_effect_transport(command: discard, transport: transport)
        outcome
      }
    }
  }
}

// THE OPS, IN ORDER, STOPPING AT THE FIRST FAILURE, and reporting WHICH one it was. The unit write is the
// only op whose payload crosses as stdin, which is what makes the retired heredoc's safety property
// structural rather than a quoting discipline.
//
// THE CARRIER IS RETURNED, NOT JUST THE TERMINAL ARM. A caller cannot tell "nothing ran because the
// sequence was skipped" from "nothing ran because the digest gate refused" without the line the read
// produced, and that distinction is the entire content of the gate — so the fold hands it back rather than
// dropping it at the end of the loop.
//
// THE DISCARD'S OWN OUTCOME IS DELIBERATELY NOT PROPAGATED. The staged sibling is a file this fold created
// moments earlier in a directory it does not otherwise touch; if its removal fails, the operation the
// operator needs to hear about is the one that failed first, and letting a cleanup failure overwrite that
// report would be a worse diagnostic, not a better one. What is NOT done is the reverse: the cleanup is
// never skipped, and never conditional on success.
fn build_cache_run_ensure_ops(
  state: BuildCacheEnsureFold,
  ops: List<BuildCacheEnsureOp>,
  unit_bytes: String,
  transport: HostEffectTransport,
  plan: List<BuildCacheEnsureOp>,
  digest: Digest,
) -> BuildCacheEnsureFold {
  fold(
    ops,
    init: state,
    f: (acc, op) =>
      // THE FOLD'S SHARE OF `set -e`: once a leg has stopped the sequence the legs after it are NOT run,
      // and the terminal arm already carried is the receipt. Without this guard a refused digest would
      // still be followed by the extraction and the move, and what the effect reported would be whichever
      // leg happened to fail last rather than the one that stopped the host.
      if !build_cache_ensure_fold_is_progressing(fold_state: acc) {
        acc
      } else if op.unit_bytes_on_stdin {
        build_cache_fold_op_executed(
          acc: acc,
          op: op,
          ran: run_argv_stdin_over_host_effect_transport(
            command: op.argv,
            stdin_payload: unit_bytes,
            transport: transport,
          ),
          plan: plan,
          digest: digest,
        )
      } else {
        build_cache_fold_op_executed(
          acc: acc,
          op: op,
          ran: run_argv_over_host_effect_transport(command: op.argv, transport: transport),
          plan: plan,
          digest: digest,
        )
      },
  )
}

// ONE LEG, AS THE HOST ANSWERED IT: the operation the effect offered, and what came back. A record rather
// than a tuple because this grammar has no tuple patterns, and a RECORD rather than two parallel lists
// because a fold over two lists that might differ in length is exactly the kind of thing that goes quietly
// wrong -- with this shape, a leg with no outcome is simply absent, and an absent leg never runs.
type BuildCacheEnsureSuppliedOutcome {
  op: BuildCacheEnsureOp
  ran: RunArgvTransportOutcome
}

// THE SAME SEQUENCE, DECIDED WITHOUT A TRANSPORT -- the split realize_live_deploy_ensure_dependency_on_host
// (#14174) landed for the same reason. `build_cache_run_ensure_ops` is the loop that ACTUATES: it asks a
// transport for each leg. This is that sequence with the asking taken out; the outcomes are handed in and
// every rule is the same pure step the loop calls, so the two cannot hold different rules about what stops
// an ensure. It exists because the digest gate has to be testable at all: a fetch that succeeded and a read
// that reported a digest which is not the pinned one is a host state a witness can describe perfectly well,
// and there is no reason it should be reachable only by downloading something -- the mock arm of shell.Exec
// was deleted by operator ruling 2026-08-23, so "supply the outcome" is the ONLY hermetic route to a leg
// that ran and answered. It actuates nothing: no transport, no host, no file, and it is not a second path
// beside the modeled route -- the loop above calls the very same `build_cache_fold_op_executed`.
//
// A SHORTER SUPPLIED LIST IS NOT A SUCCESS: the fold stops where outcomes run out, so a claim can supply the
// two prefix legs and show that no install leg was reached. That asymmetry is the question the gate exists
// to answer, and it is why "no outcome" is absent rather than zero-exit.
fn build_cache_fold_ensure_ops_with_outcomes(
  state: BuildCacheEnsureFold,
  plan: List<BuildCacheEnsureOp>,
  digest: Digest,
  supplied: List<BuildCacheEnsureSuppliedOutcome>,
) -> BuildCacheEnsureFold {
  fold(
    supplied,
    init: state,
    f: (acc, given) =>
      // THE CARRIER DECIDES, at every step -- the same predicate the transport loop asks before it starts a
      // leg, so the two routes cannot disagree about whether a leg happens. Everything below that guard is
      // delegation: `build_cache_fold_op_executed` is the very step the loop calls. This fold holds no rule of
      // its own, which is the entire reason the witnesses over it are about the real route and not a copy.
      if !build_cache_ensure_fold_is_progressing(fold_state: acc) {
        acc
      } else {
        build_cache_fold_op_executed(
          acc: acc,
          op: given.op,
          ran: given.ran,
          plan: plan,
          digest: digest,
        )
      },
  )
}

// THE DIGEST GATE, AT THE POINT THE READ ANSWERED. The line the host printed is not itself permission: it is
// handed to `build_cache_ensure_run`, the single authority in the module that owns this effect, and that
// authority either admits the rest of the plan or refuses it carrying BOTH digests. Repeating its rule here
// would be the DESIGN 3 defect this lane exists to remove -- a second copy could pass every witness while the
// route that actually runs disagreed -- so this site asks, and acts on the answer.
//
// Keeping the ask HERE, at the leg where the host answered, rather than in the transport loop or in the
// executor's pass boundary, is what makes the decision auditable without a host: a witness can hand the fold a
// successful fetch, a read that answered with the wrong digest, and every install leg succeeding as well, and
// still see that no install leg was reached.
fn build_cache_read_leg_gate(
  o: ShellExecObserved,
  plan: List<BuildCacheEnsureOp>,
  digest: Digest,
) -> BuildCacheEnsureFold {
  // THE `Present` IS BUILT AT EACH SITE RATHER THAN BOUND ONCE ABOVE THE MATCH. That is not repetition for
  // its own sake: a `let` here has no declared type to lean on, and the compiler infers the BINDING as
  // `String` (the payload) rather than as the `Optional<String>` the parameter and the two carrier fields
  // both want -- which surfaces as `type mismatch: expected 'Coproduct(Optional)', got 'Primitive(String)'`
  // at the field, an error pointing away from the binding. Writing the constructor where the expected type
  // IS known (the field position) is how the rest of this file does it, e.g. green `digest_line:
  // Present { value: o.stdout }`, and there is no annotated-`let` form in this module to reach for.
  match build_cache_ensure_run(ops: plan, digest: digest, observed_digest_line: Present { value: o.stdout }) {
    Runs { legs: _ } =>
      BuildCacheEnsureFold { executed: EnsureCompleted, digest_line: Present { value: o.stdout } }
    RefusedBeforeInstall { legs: _, op: gate, refusal: why } => BuildCacheEnsureFold {
      executed: EnsureDigestRefused { op: gate, refusal: why },
      digest_line: Present { value: o.stdout },
    }
  }
}

// ONE OP'S OUTCOME, FOLDED INTO THE CARRIER. The terminal arm on the failing path comes from
// build_cache_ensure_leg_verdict, in the module that owns this effect -- it is the single place exit codes
// become receipt arms, and this site only hands it its input and reports what came back. (An earlier revision
// of this comment named a DIFFERENT fn as that source. It was wrong twice over: this fn never called it, and
// that fn was never called by anything at all, so citing it as the authority pointed at dead code while the
// live rule sat one call away. The dead fn is deleted with this correction, and its name is deliberately NOT
// reproduced here -- a bare identifier in a comment that resolves to nothing in the tree reads as a citation
// and is worse than no comment. Its history is in this PR's git blame, which is where history belongs.)
// The carrier's digest_line is updated HERE, against the
// leg's DECLARED kind, so the second pass is decided by a pure fn over a recorded observation rather than
// by an if buried in the loop. A leg of any other kind leaves the line untouched — inventing a digest line
// from a fetch or a chmod would be the same silent default this effect removes.
fn build_cache_fold_op_executed(
  acc: BuildCacheEnsureFold,
  op: BuildCacheEnsureOp,
  ran: RunArgvTransportOutcome,
  plan: List<BuildCacheEnsureOp>,
  digest: Digest,
) -> BuildCacheEnsureFold {

// NO GUARD HERE, DELIBERATELY. "A leg has stopped the sequence, so this leg does not happen" is a rule about
  // the SEQUENCE, and it is asked once by each route that walks one -- by `build_cache_run_ensure_ops` before
  // it starts a transport, and by `build_cache_fold_ensure_ops_with_outcomes` before it applies a supplied
  // answer. Both ask the same predicate, `build_cache_ensure_fold_is_progressing`; a third copy inside the step
  // would be redundancy of exactly the kind DESIGN 3 is about, and it would also make the routes untestable
  // against each other, because mutating one route's guard would be silently covered by the step and no claim
  // could tell. What lives HERE is only what a leg's own answer means, which is why the digest gate is below:
  // it is a rule about an ANSWER, not about a sequence.
  match ran {
    RunArgvTransportRefused { reason: r } =>
      BuildCacheEnsureFold {
        executed: EnsureTransportBlocked { op: op, reason: r },
        digest_line: acc.digest_line,
      }
    // THE `set -e` DECISION IS NOT MADE HERE. It is the cited build_cache_ensure_leg_verdict, in the module
    // that owns the effect: this site turns the transport's outcome into that fn's input and reports what it
    // returned. An `if o.exit_code != 0` written here instead would put the same rule in two places, where
    // the digest gate already sits in one — and the two would be free to disagree, silently, about whether a
    // given leg stops the sequence.
    RunArgvTransportObserved { observed: o } =>
      match build_cache_ensure_leg_verdict(
        op: op,
        observed: BuildCacheHostRunObserved { exit_code: o.exit_code, stdout: o.stdout, stderr: o.stderr },
      ) {
        LegStopped { executed: stopped } =>
          BuildCacheEnsureFold { executed: stopped, digest_line: acc.digest_line }
        LegPassed =>
          // THE DIGEST GATE, AT THE POINT THE READ ANSWERED, AND IN THE ONE PLACE BOTH ROUTES PASS THROUGH.
          // The gate is a function of its own rather than an expression here, and not for tidiness: the
          // decision needs to bind the line before it can ask the authority about it, and a binding in an
          // arm's expression position is not something this grammar accepts (the compiler refuses it with
          // `expected expression, found Eq`). As its own fn it is also the thing a witness can name.
          //
          // THE PARENTHESES ARE LOAD-BEARING, NOT DECORATIVE, AND THIS IS THE THIRD GRAMMAR TRAP IN THIS ONE
          // ARM. With the condition written bare -- `if op.kind == ReadDigest {` -- the compiler reports
          // `expected RParen, found Colon` and the whole module fails to load, pointing at the FIRST LABEL of
          // the call inside the then-block rather than at the condition. The reason is the constructor brace:
          // a condition whose right-hand side is a bare constructor name leaves `{` after it, which the parser
          // takes for the start of a record literal, so the then-block is swallowed as that literal's body and
          // the labelled call inside it is parsed where a record field was expected. Parenthesising ends the
          // expression before the brace. Measured, not guessed: the identical call under `if o.stdout ==
          // "yes" {` compiles, the identical call under a record-literal then-tail compiles, and this shape
          // with the parentheses compiles -- the only variable is the bare `ReadDigest {`. So do not "tidy"
          // the parentheses away; the failure looks nothing like its cause.
          if (op.kind == ReadDigest) {
            build_cache_read_leg_gate(o: o, plan: plan, digest: digest)
          } else {
            BuildCacheEnsureFold { executed: EnsureCompleted, digest_line: acc.digest_line }
          }
      }
  }
}


fn run_argv_stdin_over_host_effect_transport(command: ArgvCommand, stdin_payload: String, transport: HostEffectTransport) -> RunArgvTransportOutcome {
  match transport {
    LocalShell => {
      let params = run_argv_parameters_of(command: command)
      let result = shell.Exec.RunArgvStdin(
        program: params.program,
        arguments: params.arguments,
        stdin_payload: stdin_payload,
      )
      RunArgvTransportObserved {
        observed: ShellExecObserved {
          exit_code: result.exit_code,
          success: result.exit_code == 0,
          stdout: result.stdout,
          stderr: result.stderr,
        },
      }
    }
    SshShell { ssh_host: h } =>
      typed_argv_outcome_to_transport(typed: typed_argv_exec_over_ssh_with_stdin(
        host: h,
        argv: argv_words(command: command),
        stdin_payload: stdin_payload,
      ))
    FleetSsh { target: t, context: c } =>
      typed_argv_outcome_to_transport(typed: typed_argv_exec_over_fleet_ssh_with_stdin(
        target: t,
        context: c,
        argv: argv_words(command: command),
        stdin_payload: stdin_payload,
      ))
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      RunArgvTransportRefused {
        reason: "host_effect_apply: typed argv cannot use EmitArtifactThenThinRun transport; reserved for ConvergePlan (host-effect Phase D).",
      }
  }
}

// CONVERGE DOES NOT APPLY KNOBS ON THE OPERATOR PRINCIPAL, AND THE ABSENCE OF THE CODE PATH IS
// WHAT ENFORCES THAT. The 2026-08-13 operator privilege hold says drop-in authoring,
// daemon-reload, set-property and revert for the per-slot memory-cap axis belong to the deploy
// principal (gunbc.host.host_axis_caps at live_deploy apply under ghrunner sudo), never to
// `gunbc converge` on the operator principal. Until this cut the hold was carried by two
// `data ...: Bool = true` flags whose only readers were witnesses asserting the literal, while the
// arm they described was still wired: gunbc.host_converge_realize interpreted a PerSlotMemoryCap
// knob into a shell body and this function ran it through run_shell_transport and reported
// convergence from its exit status. A flag that asserts itself is not a wall (DESIGN §5's oracle
// rule rejects exactly that shape); a deleted arm is.
//
// So the interpreter module, the flags and the witnesses that read them are gone, and this
// function refuses by construction. That refusal is strictly stronger than the three it replaces
// (unimplemented knob target, zero knobs, multi-knob concatenation): every converge apply for
// every host now refuses, where before a caps-only host would have actuated.
//
// CONVERGE'S ANSWER FOR THIS AXIS IS OBSERVATION, and it already exists:
// gunbc.host.host_runner_memory_cap_verify reads the unit back through
// gunbc.fleet.fleet_show_effective_read per_slot_memory_cap_verdict_from_unit_read. That path is
// untouched by this cut - it is the half that was always correct.
data converge_in_process_apply_withdrawn_reason: String = "host_effect_apply: ConvergePlan in-process apply is WITHDRAWN, not unimplemented — the 2026-08-13 operator privilege hold reserves per-slot memory-cap authoring to the deploy principal (gunbc.host.host_axis_caps at live_deploy apply), so `gunbc converge` on the operator principal has no apply arm to reach. Converge's answer for this axis is the read-back verdict at gunbc.host.host_runner_memory_cap_verify (fleet_show_effective_read per_slot_memory_cap_verdict_from_unit_read), not a mutation."

fn realize_converge_in_process(host_converge: HostConverge, intent: HostEffectIntent) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  NotConverged {
    reason: concat(
      concat(converge_in_process_apply_withdrawn_reason, " (host="),
      concat(host_converge.identity as String, ")"),
    ),
    applied: intent,
  }
}

fn realize_converge_on_host(host_converge: HostConverge, transport: HostEffectTransport, intent: HostEffectIntent) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match transport {
    EmitArtifactThenThinRun { bootstrap: b, invocation: _ } =>
      match gunbc_apply_mode_for_host(host: host_converge.identity) {
        FreshStandup =>
          if bootstrap_fragment_carries_hand_script(f: b) {
            NotConverged {
              reason: "host_effect_apply: a hand-spelled BootstrapFragment.script is not an admitted artifact — the fresh-standup bootstrap route is the Terminal emit(intent,Bash) lane (bootstrap_fragment_script_carrier_scaffold), and thin_invocation_argv_carrier_scaffold is Terminal since the thin run dispatches through the gunbc converge invocation-shape authority; this leg realizes only with an emitted (empty-script) bootstrap fragment.",
              applied: intent,
            }
          } else {
            realize_converge_in_process(host_converge: host_converge, intent: intent)
          }
        ExistingHostQuiescentReload =>
          realize_converge_in_process(host_converge: host_converge, intent: intent)
      }
    LocalShell =>
      realize_converge_in_process(host_converge: host_converge, intent: intent)
    SshShell { ssh_host: _ } =>
      NotConverged {
        reason: "host_effect_apply: ConvergePlan over SshShell is a fail-closed Unimplemented stub; use EmitArtifactThenThinRun or LocalShell for the converge lane.",
        applied: intent,
      }
    FleetSsh { target: _, context: _ } =>
      NotConverged {
        reason: "host_effect_apply: ConvergePlan over SshShell is a fail-closed Unimplemented stub; use EmitArtifactThenThinRun or LocalShell for the converge lane.",
        applied: intent,
      }
  }
}

fn realize_install_media_fetch_in_process(intent: HostEffectIntent) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  // THE MINT GATES THE FETCH: the fetch's paths and parent directory come off the sealed record, and a
  // store that cannot be listed converges nothing -- a fetch that could not confirm its own directory
  // must not publish bytes nobody can read back.
  match install_media_store(tree: host_state_tree()) {
    InstallMediaStoreUnready { detail: d } =>
      NotConverged { reason: concat("install-media-fetch: the install media store refused to open: ", d), applied: intent }
    InstallMediaStoreReady { store: s } => match install_media_fetch_reconcile(store: s, artifact: srv3_ubuntu_install_media_artifact) {
    AcquisitionAlreadyPresent { identity: _, install_path: p } =>
      reconcile_grounded(
        apply_effect: intent,
        show_read: ReadObserved { value: p as String },
        grounding: Grounds {
          evidence: ConvergePlanApplied {
            exit_code: 0,
            stdout: concat("install-media-fetch: already present at ", p as String),
          }
        }
      )
    AcquisitionFetched { identity: _, install_path: p, source: origin } =>
      reconcile_grounded(
        apply_effect: intent,
        show_read: ReadObserved { value: p as String },
        grounding: Grounds {
          evidence: ConvergePlanApplied {
            exit_code: 0,
            stdout: concat(concat("install-media-fetch: fetched from ", origin.identity as String), concat(" to ", p as String)),
          }
        }
      )
    AcquisitionRefused { cause: why } =>
      NotConverged { reason: concat("install-media-fetch: ", acquisition_refusal_text(cause: why)), applied: intent }
  }
  }
}

fn realize_install_media_remaster_in_process(intent: HostEffectIntent) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match srv3_seeded_install_media_publish() {
    SeededImageAlreadyPublished { built: b, path: p } =>
      reconcile_grounded(
        apply_effect: intent,
        show_read: ReadObserved { value: p as String },
        grounding: Grounds {
          evidence: ConvergePlanApplied {
            exit_code: 0,
            stdout: concat("install-media-remaster: already published at ", p as String, " sha256 ", b.output_digest as String),
          }
        }
      )
    SeededImagePublished { built: b, path: p, work: w, staging_residue: residue } =>
      if !scratch_removed(o: w) || match residue { Absent => false Present { value: _ } => true } {
        NotConverged {
          reason: concat(
            "install-media-remaster: published at ", p as String, " sha256 ", b.output_digest as String,
            " but residue remains: ", render_scratch_outcome(label: "work", prefix: "", o: w),
            match residue { Absent => "" Present { value: r } => concat(" staging not removed: ", r) },
          ),
          applied: intent,
        }
      } else {
        reconcile_grounded(
          apply_effect: intent,
          show_read: ReadObserved { value: p as String },
          grounding: Grounds {
            evidence: ConvergePlanApplied {
              exit_code: 0,
              stdout: concat("install-media-remaster: built and published at ", p as String, " sha256 ", b.output_digest as String),
            }
          }
        )
      }
    SeededImagePublishedRecordNotWritten { built: b, path: p, work: w, staging_residue: residue, record: rec } =>
      NotConverged {
        reason: concat(
          "install-media-remaster: published at ", p as String, " sha256 ", b.output_digest as String,
          " but its derivation record ", host_file_write_text(w: rec), "; ", render_scratch_outcome(label: "work", prefix: "", o: w),
          match residue { Absent => "" Present { value: r } => concat(" staging not removed: ", r) },
        ),
        applied: intent,
      }
    SeededImagePublicationRefused { reason: why, work: w } =>
      NotConverged { reason: concat("install-media-remaster: ", why, "; ", render_scratch_outcome(label: "work", prefix: "", o: w)), applied: intent }
  }
}

fn realize_srv3_typed_reconcile(kind: TypedReconcileKind, transport: HostEffectTransport, intent: HostEffectIntent) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match transport {
    LocalShell =>
      match kind {
        TypedReconcileFetch => realize_install_media_fetch_in_process(intent: intent)
        TypedReconcileRemaster => realize_install_media_remaster_in_process(intent: intent)
      }
    SshShell { ssh_host: _ } =>
      NotConverged {
        reason: "host_effect_apply: TypedReconcileOnHost runs in-process on the executor's own host; SshShell transport is a fail-closed Unimplemented stub until the typed reconcile is realized over a remote-observe/apply transport.",
        applied: intent,
      }
    FleetSsh { target: _, context: _ } =>
      NotConverged {
        reason: "host_effect_apply: TypedReconcileOnHost runs in-process on the executor's own host; SshShell transport is a fail-closed Unimplemented stub until the typed reconcile is realized over a remote-observe/apply transport.",
        applied: intent,
      }
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      NotConverged {
        reason: "host_effect_apply: TypedReconcileOnHost runs in-process on the executor's own host; EmitArtifactThenThinRun is a fail-closed Unimplemented stub for this cell until the typed reconcile is realized over that transport.",
        applied: intent,
      }
  }
}

fn reconcile_shell_exec_observed(
  observed: ShellExecObserved,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let grounding = if observed.success {
      Grounds { evidence: ShellEffectApplied { exit_code: observed.exit_code, stdout: observed.stdout, stderr: observed.stderr } }
    } else {
      DoesNotGround { reason: shell_exec_failure_reason(observed: observed) }
    }
  reconcile_grounded(
    apply_effect: intent,
    show_read: ReadObserved { value: observed },
    grounding: grounding
  )
}

fn reconcile_ssh_argv_exec_outcome(
  outcome: TypedArgvExecOutcome,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match outcome {
    TypedArgvExecConverged { result: r } =>
      reconcile_shell_exec_observed(
        observed: ShellExecObserved {
          exit_code: r.exit_code,
          success: r.success,
          stdout: r.stdout,
          stderr: r.stderr,
        },
        intent: intent,
      )
    TypedArgvExecRefused { reason: why } =>
      NotConverged { reason: why, applied: intent }
  }
}

// Executor→target typed remote argv transport binding (codex_runtime_converge_local_shell_locus
// dissolve-on class; review 51883). SshShell routes through typed_argv_exec_over_ssh on the
// transport endpoint; FleetSsh routes through typed_argv_exec_over_fleet_ssh with sealed context.
// LocalShell refuses — remote argv requires a transport that names the target host. Shell script
// bodies use host_effect_realize run_shell_transport instead.

fn run_typed_argv_transport(
  argv: List<String>,
  transport: HostEffectTransport,
) -> TypedArgvExecOutcome {
  match transport {
    LocalShell =>
      TypedArgvExecRefused {
        reason: "run_typed_argv_transport: LocalShell has no remote target — use SshShell or FleetSsh when executor and subject host differ",
      }
    SshShell { ssh_host: h } =>
      typed_argv_exec_over_ssh(host: h, argv: argv)
    FleetSsh { target: t, context: c } =>
      typed_argv_exec_over_fleet_ssh(target: t, context: c, argv: argv)
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      TypedArgvExecRefused {
        reason: "run_typed_argv_transport: EmitArtifactThenThinRun is not a typed argv transport",
      }
  }
}

fn realize_effective_principal_read_on_host(
  read: EffectivePosixPrincipalRead,
  transport: HostEffectTransport,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let argv = posix_effective_principal_read_argv()
  match transport {
    LocalShell => {
      let result = effective_posix_principal_read(read: read)
      reconcile_shell_exec_observed(
        observed: ShellExecObserved {
          exit_code: result.exit_code,
          success: result.success,
          stdout: result.stdout,
          stderr: result.stderr,
        },
        intent: intent,
      )
    }
    SshShell { ssh_host: h } =>
      reconcile_ssh_argv_exec_outcome(
        outcome: typed_argv_exec_over_ssh(host: h, argv: argv),
        intent: intent,
      )
    FleetSsh { target: t, context: c } =>
      reconcile_ssh_argv_exec_outcome(
        outcome: typed_argv_exec_over_fleet_ssh(target: t, context: c, argv: argv),
        intent: intent,
      )
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      NotConverged {
        reason: "host_effect_apply: ReadEffectivePosixPrincipal cannot use EmitArtifactThenThinRun transport; typed mismatch.",
        applied: intent,
      }
  }
}

fn realize_sudo_nopasswd_execute_probe_on_host(
  probe: SudoNopasswdExecuteProbeShape,
  transport: HostEffectTransport,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let argv = sudo_nopasswd_execute_probe_argv(probe: probe)
  match transport {
    LocalShell => {
      let result = sudo.NopasswdExecuteProbe.Check(probe: probe)
      reconcile_shell_exec_observed(
        observed: ShellExecObserved {
          exit_code: if result.success { 0 } else { 1 },
          success: result.success,
          stdout: "",
          stderr: "",
        },
        intent: intent,
      )
    }
    SshShell { ssh_host: h } =>
      reconcile_ssh_argv_exec_outcome(
        outcome: typed_argv_exec_over_ssh(host: h, argv: argv),
        intent: intent,
      )
    FleetSsh { target: t, context: c } =>
      reconcile_ssh_argv_exec_outcome(
        outcome: typed_argv_exec_over_fleet_ssh(target: t, context: c, argv: argv),
        intent: intent,
      )
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      NotConverged {
        reason: "host_effect_apply: SudoNopasswdExecuteProbe cannot use EmitArtifactThenThinRun transport; typed mismatch.",
        applied: intent,
      }
  }
}

fn sudo_nopasswd_grant_list_observed(
  probe: SudoNopasswdGrantListProbeShape,
  exit_code: Int,
  query_success: Bool,
  stdout: String,
  stderr: String,
) -> ShellExecObserved {
  let admitted = query_success
    && sudo_nopasswd_grant_list_admits_probe(listing: stdout, probe: probe)
  let observed_exit_code = if admitted {
    0
  } else if exit_code == 0 {
    1
  } else {
    exit_code
  }
  ShellExecObserved {
    exit_code: observed_exit_code,
    success: admitted,
    stdout: stdout,
    stderr: stderr,
  }
}

fn reconcile_sudo_nopasswd_grant_list_outcome(
  probe: SudoNopasswdGrantListProbeShape,
  outcome: TypedArgvExecOutcome,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match outcome {
    TypedArgvExecConverged { result: r } =>
      reconcile_shell_exec_observed(
        observed: sudo_nopasswd_grant_list_observed(
          probe: probe,
          exit_code: r.exit_code,
          query_success: r.success,
          stdout: r.stdout,
          stderr: r.stderr,
        ),
        intent: intent,
      )
    TypedArgvExecRefused { reason: why } =>
      NotConverged { reason: why, applied: intent }
  }
}

fn realize_sudo_nopasswd_grant_list_probe_on_host(
  probe: SudoNopasswdGrantListProbeShape,
  transport: HostEffectTransport,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let argv = sudo_nopasswd_grant_list_argv()
  match transport {
    LocalShell => {
      let result = sudo.NopasswdGrantList.Read()
      reconcile_shell_exec_observed(
        observed: sudo_nopasswd_grant_list_observed(
          probe: probe,
          exit_code: result.exit_code,
          query_success: result.success,
          stdout: result.stdout,
          stderr: result.stderr,
        ),
        intent: intent,
      )
    }
    SshShell { ssh_host: h } =>
      reconcile_sudo_nopasswd_grant_list_outcome(
        probe: probe,
        outcome: typed_argv_exec_over_ssh(host: h, argv: argv),
        intent: intent,
      )
    FleetSsh { target: t, context: c } =>
      reconcile_sudo_nopasswd_grant_list_outcome(
        probe: probe,
        outcome: typed_argv_exec_over_fleet_ssh(target: t, context: c, argv: argv),
        intent: intent,
      )
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      NotConverged {
        reason: "host_effect_apply: SudoNopasswdGrantListProbe cannot use EmitArtifactThenThinRun transport; typed mismatch.",
        applied: intent,
      }
  }
}

fn realize_shell_on_host(script: RetainedShellScript, transport: HostEffectTransport, intent: HostEffectIntent) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let result = run_shell_transport(script: script, transport: transport)
  reconcile_shell_exec_observed(observed: result, intent: intent)
}

fn realize_set_hostname_cas_on_host(
  hostnamectl_path: NonEmptyStr,
  base: DnsLabel,
  desired: DnsLabel,
  transport: HostEffectTransport,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match hostname_set_cas(
    hostnamectl_path: hostnamectl_path,
    transport: transport,
    base: base,
    desired: desired,
  ) {
    HostnameSetCasApplied =>
      reconcile_shell_exec_observed(
        observed: ShellExecObserved {
          exit_code: 0,
          success: true,
          stdout: desired as String,
          stderr: "",
        },
        intent: intent,
      )
    HostnameSetCasReadRefused { reason: why } =>
      NotConverged {
        reason: concat("host_effect: SetHostnameCas hostname read refused; fail-closed: ", why),
        applied: intent,
      }
    HostnameSetCasBaseMismatch { observed: o, base: b } =>
      NotConverged {
        reason: concat(
          concat("host_effect: SetHostnameCas CAS refused — observed ", o),
          concat(" != base ", b as String),
        ),
        applied: intent,
      }
    HostnameSetCasApplyFailed { stderr: e } =>
      NotConverged {
        reason: concat("host_effect: SetHostnameCas hostnamectl set-hostname failed: ", e),
        applied: intent,
      }
  }
}

fn realize_hostname_read_on_host(
  transport: HostEffectTransport,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match hostname_short_read(transport: transport) {
    HostnameShortCaptured { value: name } =>
      reconcile_shell_exec_observed(
        observed: ShellExecObserved { exit_code: 0, success: true, stdout: name, stderr: "" },
        intent: intent,
      )
    HostnameShortCaptureRefused { reason: why } =>
      reconcile_shell_exec_observed(
        observed: ShellExecObserved {
          exit_code: 1,
          success: false,
          stdout: "",
          stderr: concat("host_effect_apply: HostIdentityShortHostnameRead hostname -s read refused; fail-closed: ", why),
        },
        intent: intent,
      )
  }
}

fn realize_toolchain_home_interference_probe(
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match toolchain_interference_probe_on_host() {
    ToolchainInterferenceDiscriminated =>
      Converged { evidence: ToolchainHomeInterferenceDiscriminated, applied: intent }
    ToolchainInterferenceProbeRefused { cause: c } =>
      NotConverged {
        reason: match c {
          ToolchainPrivateHomeBindingMissing { observed: o, expected: e } =>
            join(["ToolchainPrivateHomeBindingMissing observed=", o, " expected=", e], "")
          ToolchainSharedArmDidNotObserveInterference => "ToolchainSharedArmDidNotObserveInterference"
          ToolchainPrivateHomeIsolationBreached => "ToolchainPrivateHomeIsolationBreached"
          ToolchainInterferenceFixtureFailed { detail: d } =>
            concat("ToolchainInterferenceFixtureFailed ", d)
        },
        applied: intent,
      }
  }
}

fn realize_codex_supervised_worker_turn_on_host(
  intent: CodexAppServerStdioSessionIntent,
  lease_key: NonEmptyStr,
  transport: HostEffectTransport,
  intent_record: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let cmd_id_read = Filesystem.Read(path: intent.client_command_id_path)
  if cmd_id_read.success == false || cmd_id_read.content == "" {
    NotConverged {
      reason: "CodexSupervisedWorkerTurn: client_command_id unreadable at persisted path before session apply",
      applied: intent_record,
    }
  } else {
    match host_effect_codex_supervised_turn_apply(
      intent: intent,
      lease_key: lease_key,
      client_command_id: cmd_id_read.content as NonEmptyStr,
      transport: transport,
    ) {
      CodexSupervisedSessionApplyConverged {
        stdout: out,
        stderr: err,
        exit_code: code,
      } =>
        reconcile_shell_exec_observed(
          observed: ShellExecObserved {
            exit_code: code,
            success: code == 0,
            stdout: out,
            stderr: err,
          },
          intent: intent_record,
        )
      CodexSupervisedSessionApplyRefused { reason: why } =>
        NotConverged { reason: why, applied: intent_record }
    }
  }
}

fn realize_nbd_proxy_session_on_host(
  intent: NbdProxyServeTransportIntent,
  lease_key: NonEmptyStr,
  transport: HostEffectTransport,
  intent_record: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let binding = host_effect_nbd_proxy_serve_session_binding(intent: intent, lease_key: lease_key)
  match host_effect_nbd_proxy_serve_apply(binding: binding, transport: transport) {
    NbdProxyServeApplyConverged { stdout: out } =>
      reconcile_grounded(
        apply_effect: intent_record,
        show_read: ReadObserved {
          value: ShellExecObserved {
            exit_code: 0,
            success: true,
            stdout: out,
            stderr: "",
          },
        },
        grounding: Grounds {
          evidence: ShellEffectApplied { exit_code: 0, stdout: out, stderr: "" },
        },
      )
    NbdProxyServeApplyRefused { reason: why } =>
      NotConverged { reason: why, applied: intent_record }
  }
}

// THE CANDIDATE WAS OBSERVED IN THE DEPLOYING CHECKOUT, SO IT MAY ONLY LABEL A TREE THAT IS THAT
// CHECKOUT. observe_candidate_release reads git HEAD where the deploy program runs. On LocalShell
// the observation locus and the mutation locus are the same filesystem — the CI job installs from
// its own workspace — so the revision it read is the revision it installs, and baking that value
// into ExecStart is a true statement about the resulting process.\n\nOver SshShell they are two
// different machines. The revision came from the LOCAL checkout while the unit is written on the
// REMOTE host, whose tree arrived by some other path and at some other time; nothing in this fold
// establishes that they agree. Emitting the local sha there would produce a process that
// CONFIDENTLY REPORTS a release it may not be running, and readiness would then compare that
// fabricated label against the expectation that produced it and agree — a self-consistent false
// green, which is worse than no identity at all because the wrongness is invisible to every
// downstream check.\n\nSo the SSH arm REFUSES rather than labels. This is not a transport
// allow-list standing in for a model; the admission that is genuinely missing is the agreement
// between candidate observation locus, source transfer locus, and mutation locus, and until a
// source transfer is modeled that PROVES the remote tree is this candidate, refusing is the only
// honest arm (DESIGN section 5: a failure arm must refuse, never widen). EmitArtifactThenThinRun
// refuses for the same reason, one step further removed.\n\nRetract is deliberately not restricted
// here: it installs no release, carries no candidate, and therefore has no locus to agree about.
// DISSOLVES WHEN a modeled source transfer establishes remote-tree identity, at which point this
// arm carries the transferred candidate instead of refusing.

fn live_deploy_apply_candidate_locus_refusal(transport: HostEffectTransport) -> Optional<String> {
  match transport {
    LocalShell => none
    SshShell { ssh_host: h } =>
      Present { value: join([
        "live_deploy apply refused over ssh host=", h,
        ": the candidate release was observed in the LOCAL deploying checkout, and no modeled source transfer proves the remote tree is that candidate. ",
        "Emitting the local revision into the remote unit would publish a release identity the process may not be running.",
      ], "") }
    FleetSsh { target: t, context: _ } =>
      Present { value: join([
        "live_deploy apply refused over fleet ssh endpoint=", known_hosts_host_field(address: t.address) as String,
        ": the candidate release was observed in the LOCAL deploying checkout, and no modeled source transfer proves the remote tree is that candidate. ",
        "Emitting the local revision into the remote unit would publish a release identity the process may not be running.",
      ], "") }
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      Present { value: "live_deploy apply refused over EmitArtifactThenThinRun: the candidate release was observed in the local deploying checkout and no modeled source transfer proves the executing tree is that candidate." }
  }
}

// THE CENSUS, TAKEN OVER THE TRANSPORT THE REALIZER ALREADY HOLDS.
//
// `gunbc.runner.runner_slot_population_census` owns the JUDGMENT: what a `systemctl list-units` outcome
// says about a host's slots, and what an unreadable host means (a refused census, never an empty
// population). The typed-argv decode lives THERE -- slot_census_from_typed_argv_outcome, the one
// decode the census module's own fleet reader (observe_slot_population_over_ssh) and every remote
// arm below share; this fn adds no census judgment of its own and exists because the realizer's
// subject is reached through `HostEffectTransport`, not through a fleet `SshTarget`, so the
// transports the realizer already holds are bound to reads here.
//
// THE LOCAL FLATTEN STAYS BESIDE THE FN THAT HOLDS THE SEAM. The census module decodes the records
// it already imports; the local seam's `ProcessOutcome` is flattened into the classifier's loose
// fields here, where run_shell_command_capture's success convention (output present == exited
// zero) is known. THE RENDERED PROBE BRIDGE IS GONE; THIS IS ITS RETIREMENT RECEIPT.
//
// EVERY NON-LOCAL TRANSPORT RIDES THE ONE TYPED DISPATCH: SshShell and FleetSsh execute the words
// as argv; EmitArtifactThenThinRun is refused by the dispatch, and a refused leg decodes (in the
// census module's one adapter) as a refused census -- unobserved, never an empty population. The
// census's refusal names the transport itself, not the fleet edge: SshShell and FleetSsh share this
// arm, and the refused reason that follows the noun names the concrete endpoint.
//
// Until the commit before this one, the census probe's serialization lived here as a named
// declaration (observe_slot_population_census_script_body) with a std.dissolution
// DeclarationRetires trigger bound to it -- because a row that no declaration names cannot be
// retired by name. This commit discharges that obligation: the census probe now reaches every
// transport as typed argv -- the command spelling lives in extdeps.systemd.systemctl
// (systemctl_list_all_service_units_command) and the word list is derived from it -- so the
// rendering and its trigger deleted together, as the trigger's own comment required: a trigger
// citing an absent declaration is the dead vocabulary this repository removes. What remains is the
// counted removal itself: one RetainedShellScript row off the section 5.E frontier, and the census
// the cap flow consumes no longer unreachable over FleetSsh -- the fleet wall refuses a script
// BODY before any word is examined, but the same words as argv pass it typed.
//
// THE LOCAL ADAPTER: the local seam's observation record, flattened into the classifier's fields.
fn slot_census_from_process_outcome(host: HostIdentity, outcome: ProcessOutcome) -> SlotCensus {
  match outcome {
    ProcessOutputPresent { text: t } =>
      slot_census_from_command_outcome(host: host, success: true, exit_code: 0, stdout: t, stderr: "")
    ProcessOutputAbsent =>
      slot_census_from_command_outcome(host: host, success: true, exit_code: 0, stdout: "", stderr: "")
    ProcessRefused { exit_code: c, stderr: e } =>
      slot_census_from_command_outcome(host: host, success: false, exit_code: c, stdout: "", stderr: e)
  }
}

// TOTALLED BY NAME (parent ruling on the 84c0dcf floor refusal): the typed-argv probe runs the same
// way on every non-local transport -- run_typed_argv_transport dispatches per variant internally --
// but the census must DECIDE each new transport here; the wildcard's silence would have admitted
// one unexamined.
fn observe_slot_population_over_host_effect_transport(
  host: HostIdentity,
  transport: HostEffectTransport,
) -> SlotCensus {
  match transport {
    LocalShell =>
      slot_census_from_process_outcome(
        host: host,
        outcome: run_shell_command_capture(
          command: systemctl_list_all_service_units_command(),
          transport: LocalExec,
        ),
      )
    SshShell { ssh_host: _ } =>
      slot_census_from_typed_argv_outcome(
        host: host,
        outcome: run_typed_argv_transport(
          argv: systemctl_list_all_service_units_argv(),
          transport: transport,
        ),
        edge_noun: "the transport",
      )
    FleetSsh { target: _, context: _ } =>
      slot_census_from_typed_argv_outcome(
        host: host,
        outcome: run_typed_argv_transport(
          argv: systemctl_list_all_service_units_argv(),
          transport: transport,
        ),
        edge_noun: "the transport",
      )
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      slot_census_from_typed_argv_outcome(
        host: host,
        outcome: run_typed_argv_transport(
          argv: systemctl_list_all_service_units_argv(),
          transport: transport,
        ),
        edge_noun: "the transport",
      )
  }
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// THE SHARED DEPLOY PREAMBLE, as TYPED EFFECTS.
//
// Both the apply and the retract route open with this block; the bash preamble it replaced
// (the deploy sudoers install, then the publication principal's ensure) is deleted. The script
// lines it realizes, in order:
//
//   cat > "$_gunbc_stage/gunbc-deploy.sudoers" <<EOF …   -> PreambleStdin  (SudoersStage)
//   sudo -n visudo -cf "$stage" || exit 1                -> PreambleArgv   (SudoersVisudoCheck)
//   sudo -n install -m 0440 "$stage" "$dropin" || exit 1 -> PreambleArgv   (SudoersInstall)
//   sudo -n visudo -c -f "$dropin" || exit 1             -> PreambleArgv   (SudoersPolicyFinal)
//   per privileged command: sudo -n <cmd> || exit 1      -> PreambleEffect (GrantAdmission)
//   id -u -- X >/dev/null || sudo -n useradd -r -s … X   -> PreambleArgv   (PrincipalCheck / Ensure)
//
// Every `|| exit 1` and the frame's `set -e` become a PreambleLegFailed that names its step; no
// failure becomes a silent default. The trap that removed the scratch dir becomes a call on BOTH
// branches of the entry function. Nothing here concatenates a command: each argv comes from an
// admitted upstream builder, and the drop-in body crosses as STDIN payload (data), never as argv.
// ═══════════════════════════════════════════════════════════════════════════════════════════

// One arm per command in the script, so a refusal can name the step it died on. ScratchAcquire and
// ScratchCleanup are the script's `mktemp -d` and its `trap 'rm -rf' EXIT`; PrincipalCheck/PrincipalEnsure
// are its `id -u -- X || useradd`.
type LiveDeployPreambleStep
  = ScratchAcquire
  | SudoersStage
  | SudoersVisudoCheck
  | SudoersInstall
  | SudoersPolicyFinal
  | GrantAdmission
  | PrincipalCheck
  | PrincipalEnsure
  | ScratchCleanup

fn live_deploy_preamble_step_name(step: LiveDeployPreambleStep) -> String {
  match step {
    ScratchAcquire => "scratch-acquire"
    SudoersStage => "sudoers-stage"
    SudoersVisudoCheck => "sudoers-visudo-check"
    SudoersInstall => "sudoers-install"
    SudoersPolicyFinal => "sudoers-policy-final"
    GrantAdmission => "grant-admission"
    PrincipalCheck => "principal-check"
    PrincipalEnsure => "principal-ensure"
    ScratchCleanup => "scratch-cleanup"
  }
}

// A leg is a CLOSED SUM, not a command string: had it carried free text, a policy literal could have
// re-entered argv through the payload. Every argv below is produced by an admitted upstream builder,
// and the payload arm carries DATA (the drop-in body), never a command.
type LiveDeployPreambleLeg
  = PreambleArgv { step: LiveDeployPreambleStep, command: ArgvCommand }
  | PreambleStdin { step: LiveDeployPreambleStep, command: ArgvCommand, payload: String }
  | PreambleEffect { step: LiveDeployPreambleStep, effect: HostEffect }
  // THE SCRIPT'S `A || B` AS ONE LEG, not two. `id -u -- X >/dev/null 2>&1 || sudo -n useradd … X` is
  // a single statement with a single meaning: create the account only when it is missing. Split into
  // two legs it would mean "check, then create anyway", which is a different (and destructive) program.
  | PreambleEither { check_step: LiveDeployPreambleStep, check: ArgvCommand, act_step: LiveDeployPreambleStep, act: ArgvCommand }

// What one leg observed, as a closed sum. It is the value a witness SUPPLIES: every real transport
// answer maps into exactly one of these arms, so the whole fold becomes a pure function of
// (state, leg, result) and its refusal semantics are checkable without a host.
type LiveDeployPreambleLegResult
  = LegObserved { outcome: RunArgvTransportOutcome }
  | LegEffectConverged
  | LegEffectRefused { reason: String }
  // The check of an `A || B` leg PASSED, so the second command was never run. Its own arm rather than
  // LegEffectConverged so a witness can tell "account existed" from "account was created": a leg that
  // ran useradd after a passing check could not report this arm.
  | LegActSkipped
  // The check failed and the second command ran and worked: two calls, not one.
  | LegActRan
  // A failure observed *inside* one leg that spans several commands, where the leg's own step name
  // would blame the wrong command. The `A || B` leg reports the step that actually died, and how many
  // calls it made getting there (1 = the check itself was refused, 2 = the act ran and failed).
  | LegRefusedAt { step: LiveDeployPreambleStep, reason: String, calls: Int }

// HOW MANY transport/executor calls an observation represents. The fold adds this to `observations`,
// which is what separates "the fold stopped" from "the fold ran everything and reported the first
// failure": the same final state can come from either, and only the call count says which.
fn live_deploy_preamble_result_calls(result: LiveDeployPreambleLegResult) -> Int {
  match result {
    LegObserved { outcome: _ } => 1
    LegEffectConverged => 1
    LegEffectRefused { reason: _ } => 1
    LegActSkipped => 1
    LegActRan => 2
    LegRefusedAt { step: _, reason: _, calls: c } => c
  }
}

// `consumed` is how many legs actually ran. It exists so the short-circuit is OBSERVABLE: a fold that
// kept running legs after a refusal would report the same refusal, and only the count distinguishes
// them. The witness pins it.
type LiveDeployPreambleLegState
  = PreambleLegOk { consumed: Int }
  | PreambleLegFailed { step: LiveDeployPreambleStep, reason: String, consumed: Int }

data live_deploy_preamble_leg_ok: LiveDeployPreambleLegState = PreambleLegOk { consumed: 0 }

// The ONE decision the fold makes, as a closed sum — the only piece of its control flow a witness has
// to pin. `ContinueAndRun` is the single arm that lets an impure observation happen; `Stop` means this
// leg and every leg after it is neither run nor observed. A fold that observed after a refusal is
// exactly the defect this seam makes falsifiable.
type LiveDeployPreambleLegDecision = ContinueAndRun | Stop { reason: String }

type LiveDeployPreambleVerdict
  = PreambleConverged { principal: String, dropin: NonEmptyStr, legs_consumed: Int }
  | PreambleRefused { step: LiveDeployPreambleStep, reason: String, legs_consumed: Int }

// The scratch directory. The script used a bare `mktemp -d`; this uses a NAMED template so the
// admitted-prefix check below has a real prefix to check and a leftover on a host is attributable to
// gunbc rather than to every other `tmp.XXXXXX` in /tmp. Uniqueness and privacy are mktemp's job in
// both spellings. The template is a PARAMETER of the builder, and the prefix is spelled from the same
// string the template is, so the two cannot drift apart.
data live_deploy_preamble_scratch_template: NonEmptyStr = "/tmp/gunbc-deploy-preamble.XXXXXX" as NonEmptyStr
data live_deploy_preamble_scratch_prefix: String = "/tmp/gunbc-deploy-preamble."

// Where the staged drop-in lands inside the scratch directory — the script's `$stage` name, kept so an
// operator reading a host sees the same file the bash route wrote.
data live_deploy_preamble_stage_suffix: String = "/gunbc-deploy.sudoers"

// The step a leg belongs to, for the refusal text. Every leg arm carries one, so there is no default.
fn live_deploy_preamble_leg_step(leg: LiveDeployPreambleLeg) -> LiveDeployPreambleStep {
  match leg {
    PreambleArgv { step: s, command: _ } => s
    PreambleStdin { step: s, command: _, payload: _ } => s
    PreambleEffect { step: s, effect: _ } => s
    // The check half is the leg's identity: it is what runs unconditionally; the act half is
    // live_deploy_preamble_either_act_step.
    PreambleEither { check_step: cs, check: _, act_step: _, act: _ } => cs
  }
}

// The act half's step, for a leg that has one. An injected outcome can be aimed at either half of an
// `A || B` leg; a leg with no act half has none, so an outcome aimed at an act step can never be
// mistaken for one aimed at an argv, stdin or effect leg's only step.
fn live_deploy_preamble_either_act_step(leg: LiveDeployPreambleLeg) -> Optional<LiveDeployPreambleStep> {
  match leg {
    PreambleArgv { step: _, command: _ } => Absent
    PreambleStdin { step: _, command: _, payload: _ } => Absent
    PreambleEffect { step: _, effect: _ } => Absent
    PreambleEither { check_step: _, check: _, act_step: as_, act: _ } => Present { value: as_ }
  }
}

fn live_deploy_preamble_aimed_at_act(leg: LiveDeployPreambleLeg, step: LiveDeployPreambleStep) -> Bool {
  match live_deploy_preamble_either_act_step(leg: leg) {
    Present { value: as_ } => as_ == step
    Absent => false
  }
}

// The script ran `id -u -- X || sudo -n useradd -r -s /usr/sbin/nologin X`: a check that could not run
// is refused AS A CHECK, so nobody reading the host thinks the account was provisioned and failed.
// Only the check half of an Either leg earns that prefix; an act failure reports the act's own detail.
// This is the single place the prefix is applied — live_deploy_preamble_observe_leg hands up the raw
// reason, so the pure fold and the impure runner cannot drift apart on it.
fn live_deploy_preamble_leg_detail(
  leg: LiveDeployPreambleLeg,
  step: LiveDeployPreambleStep,
  detail: String,
) -> String {
  match leg {
    PreambleEither { check_step: cs, check: _, act_step: _, act: _ } =>
      if live_deploy_preamble_step_name(step: cs) == live_deploy_preamble_step_name(step: step) {
        join(["precondition check could not run: ", detail], "")
      } else {
        detail
      }
    PreambleArgv { step: _, command: _ } => detail
    PreambleStdin { step: _, command: _, payload: _ } => detail
    PreambleEffect { step: _, effect: _ } => detail
  }
}

// PURE. Nothing after a refusal runs, because nothing after a refusal is even observed — the caller
// asks this before it touches the transport, so a refused grant is never followed by a privileged call
// whose result the fold would then throw away.
fn live_deploy_preamble_leg_decision(state: LiveDeployPreambleLegState) -> LiveDeployPreambleLegDecision {
  match state {
    PreambleLegFailed { step: _, reason: why, consumed: _ } => Stop { reason: why }
    PreambleLegOk { consumed: _ } => ContinueAndRun
  }
}

// PURE, and the only place a leg's verdict is decided. Three ways a leg dies, all named, each carrying
// its STEP: the transport refused to run it; it ran and exited non-zero (the script's `|| exit 1`, with
// exit code and stderr as the detail — never a silent default); or a typed effect did not converge.
// `consumed` advances only on success, so the count is evidence the short-circuit actually stopped.
fn live_deploy_preamble_next_state(
  state: LiveDeployPreambleLegState,
  leg: LiveDeployPreambleLeg,
  result: LiveDeployPreambleLegResult,
) -> LiveDeployPreambleLegState {
  match state {
    PreambleLegFailed { step: s, reason: r, consumed: c } => PreambleLegFailed { step: s, reason: r, consumed: c }
    PreambleLegOk { consumed: n } =>
      match result {
        LegEffectConverged => PreambleLegOk { consumed: n + 1 }
        LegActSkipped => PreambleLegOk { consumed: n + 1 }
        LegActRan => PreambleLegOk { consumed: n + 1 }
        LegEffectRefused { reason: why } => live_deploy_preamble_failed(leg: leg, detail: why, consumed: n)
        LegRefusedAt { step: s, reason: why, calls: _ } =>
          PreambleLegFailed {
            step: s,
            reason: live_deploy_preamble_refusal_text(
              step: s,
              detail: live_deploy_preamble_leg_detail(leg: leg, step: s, detail: why),
            ),
            consumed: n,
          }
        LegObserved { outcome: out } =>
          match out {
            RunArgvTransportRefused { reason: why } => live_deploy_preamble_failed(leg: leg, detail: why, consumed: n)
            RunArgvTransportObserved { observed: o } =>
              if o.success {
                PreambleLegOk { consumed: n + 1 }
              } else {
                live_deploy_preamble_failed(leg: leg, detail: join(["exited ", to_string(o.exit_code), ": ", o.stderr], ""), consumed: n)
              }
          }
      }
  }
}

fn live_deploy_preamble_failed(leg: LiveDeployPreambleLeg, detail: String, consumed: Int) -> LiveDeployPreambleLegState {
  let step = live_deploy_preamble_leg_step(leg: leg)
  PreambleLegFailed {
    step: step,
    reason: live_deploy_preamble_refusal_text(
      step: step,
      detail: live_deploy_preamble_leg_detail(leg: leg, step: step, detail: detail),
    ),
    consumed: consumed,
  }
}

// The refusal shape both my witnesses and W1's pin verbatim: `live_deploy_preamble: <step> refused —
// <detail>; arm=PreambleLeg, step=<step>`. The step appears twice on purpose — once for a human
// reading a log line, once as a keyed field for a claim to match — and it is the only thing that
// survives from the old `|| exit 1` plus the script's poison lines.
fn live_deploy_preamble_refusal_text(step: LiveDeployPreambleStep, detail: String) -> String {
  join(
    [
      "live_deploy_preamble: ",
      live_deploy_preamble_step_name(step: step),
      " refused — ",
      detail,
      "; arm=PreambleLeg, step=",
      live_deploy_preamble_step_name(step: step),
    ],
    "",
  )
}

// The ONLY impure part of the fold, and its caller reaches it only when the pure decision says so.
fn live_deploy_preamble_observe_leg(leg: LiveDeployPreambleLeg, access: DeployAccess) -> LiveDeployPreambleLegResult {
  match leg {
    PreambleArgv { step: _, command: c } => LegObserved { outcome: run_argv_over_host_effect_transport(command: c, transport: access.transport) }
    PreambleStdin { step: _, command: c, payload: p } => LegObserved { outcome: run_argv_stdin_over_host_effect_transport(command: c, stdin_payload: p, transport: access.transport) }
    // The probes are realized by this module's OWN typed leaves, reached through the effects
    // ci_deploy_access already builds. Going through HostEffect rather than minting argv keeps the
    // grant-list CONTENT check (an exit code alone would pass `sudo -n -l` even with the grant absent)
    // and keeps admission inside the typed dispatcher's privilege gate.
    PreambleEffect { step: _, effect: e } =>
      match host_effect_apply(target: HostOs { node: access.host }, effect: e, evidence: host_effect_identity_evidence, transport: access.transport) {
        Converged { evidence: _, applied: _ } => LegEffectConverged
        NotConverged { reason: why, applied: _ } => LegEffectRefused { reason: why }
      }
    // `A || B`, executed as the script executed it: the second command runs ONLY when the first fails,
    // and a satisfied check spends no privileged call at all. A transport that refuses the CHECK is a
    // refusal, not "the account is missing" — running the create on that answer would create an
    // account the script would not have created, which is exactly the silent default this cutover
    // exists to remove. So the check's own transport refusal is reported as one, at the check's step.
    PreambleEither { check_step: cs, check: c, act_step: as_, act: a_ } =>
      match run_argv_over_host_effect_transport(command: c, transport: access.transport) {
        // The raw reason only: live_deploy_preamble_leg_detail is the single place the "could not run
        // as a check" framing is applied, so the pure fold and this runner cannot drift on its wording.
        RunArgvTransportRefused { reason: why } =>
          LegRefusedAt { step: cs, reason: why, calls: 1 }
        RunArgvTransportObserved { observed: o } =>
          if o.success {
            LegActSkipped
          } else {
            match run_argv_over_host_effect_transport(command: a_, transport: access.transport) {
              RunArgvTransportRefused { reason: why } => LegRefusedAt { step: as_, reason: why, calls: 2 }
              RunArgvTransportObserved { observed: o2 } =>
                if o2.success {
                  LegActRan
                } else {
                  LegRefusedAt {
                    step: as_,
                    reason: join(["exited ", to_string(o2.exit_code), ": ", o2.stderr], ""),
                    calls: 2,
                  }
                }
            }
          }
      }
  }
}

// WHAT THE WITNESS INJECTS, in place of a host. Keyed by STEP NAME rather than by position, because
// this language has no safe index into a list and no cons pattern — a positional zip would have to
// decide what to do when the two lists differ in length, and silently dropping the tail would let a leg
// run with no observation at all. Keying on the step means an injection can only ever land on a leg
// that actually has that step, and a leg with no matching injection succeeds.
//
// Each arm is one real way the bash preamble could die, so each is a boundary value the witness
// SUPPLIES: the transport refusing to run the command at all, the command running and exiting non-zero
// (the script's `|| exit 1`), and a typed effect that does not converge.
type LiveDeployPreambleInjected
  = AllLegsSucceed
  | PrincipalAbsent
  | LegTransportRefused { step: LiveDeployPreambleStep, reason: String }
  | LegExited { step: LiveDeployPreambleStep, exit_code: Int, stderr: String }
  | LegEffectRefusedArm { step: LiveDeployPreambleStep, reason: String }

// The answer a leg gets when nothing was injected at it: success, shaped to the kind of leg it is. An
// `A || B` leg reports the account as ALREADY PRESENT, so the default fold exercises the cheapest path
// (one call, no useradd) and a witness has to ask for the create explicitly.
fn live_deploy_preamble_success_result(leg: LiveDeployPreambleLeg) -> LiveDeployPreambleLegResult {
  match leg {
    PreambleArgv { step: _, command: _ } =>
      LegObserved { outcome: RunArgvTransportObserved { observed: ShellExecObserved { exit_code: 0, success: true, stdout: "", stderr: "" } } }
    PreambleStdin { step: _, command: _, payload: _ } =>
      LegObserved { outcome: RunArgvTransportObserved { observed: ShellExecObserved { exit_code: 0, success: true, stdout: "", stderr: "" } } }
    PreambleEffect { step: _, effect: _ } => LegEffectConverged
    PreambleEither { check_step: _, check: _, act_step: _, act: _ } => LegActSkipped
  }
}

fn live_deploy_preamble_injected_result(
  leg: LiveDeployPreambleLeg,
  injected: LiveDeployPreambleInjected,
) -> LiveDeployPreambleLegResult {
  let here = live_deploy_preamble_leg_step(leg: leg)
  match injected {
    AllLegsSucceed => live_deploy_preamble_success_result(leg: leg)
    // The account is missing, so the `A || B` leg runs BOTH its commands: two calls, and the act
    // succeeded. Every other leg is unaffected.
    PrincipalAbsent =>
      match leg {
        PreambleEither { check_step: _, check: _, act_step: _, act: _ } => LegActRan
        _ => live_deploy_preamble_success_result(leg: leg)
      }
    LegTransportRefused { step: s, reason: why } =>
      if here == s {
        LegObserved { outcome: RunArgvTransportRefused { reason: why } }
      } else if live_deploy_preamble_aimed_at_act(leg: leg, step: s) {
        // A transport refusal aimed at the ACT half of an Either leg. Production runs the check first
        // (one call spent) and only then dies on the act, so the result costs two calls — mirroring
        // live_deploy_preamble_observe_leg or the witness and the host disagree about the cost.
        LegRefusedAt { step: s, reason: why, calls: 2 }
      } else {
        live_deploy_preamble_success_result(leg: leg)
      }
    // The command ran and exited non-zero — exactly the script's `|| exit 1`, which is why the exit
    // code and stderr are carried rather than discarded.
    LegExited { step: s, exit_code: c, stderr: err } =>
      if here == s {
        LegObserved { outcome: RunArgvTransportObserved { observed: ShellExecObserved { exit_code: c, success: false, stdout: "", stderr: err } } }
      } else if live_deploy_preamble_aimed_at_act(leg: leg, step: s) {
        // A non-zero exit aimed at the act half: production observes the check succeed, runs the act,
        // and reports the act's exit through LegRefusedAt at two calls — not a bare LegObserved at one.
        LegRefusedAt {
          step: s,
          reason: join(["exited ", to_string(c), ": ", err], ""),
          calls: 2,
        }
      } else {
        live_deploy_preamble_success_result(leg: leg)
      }
    LegEffectRefusedArm { step: s, reason: why } =>
      if here == s {
        LegEffectRefused { reason: why }
      } else {
        live_deploy_preamble_success_result(leg: leg)
      }
  }
}

// THE PURE FOLD — the same two primitives the impure fold below uses, with the host's answers
// SUPPLIED. This is what the witness pins: order, the short-circuit, which step is blamed, how many
// legs succeeded, and how many calls were made.
fn live_deploy_preamble_fold(
  legs: List<LiveDeployPreambleLeg>,
  injected: LiveDeployPreambleInjected,
) -> LiveDeployPreambleRun {
  match_fold_acc(
    acc: fold(
      legs,
      init: live_deploy_preamble_fold_init,
      f: (acc, leg) =>
        match acc {
          PreambleFoldAcc { state: st, observations: obs } =>
            match live_deploy_preamble_leg_decision(state: st) {
              Stop { reason: _ } => PreambleFoldAcc { state: st, observations: obs }
              ContinueAndRun => {
                let result = live_deploy_preamble_injected_result(leg: leg, injected: injected)
                PreambleFoldAcc {
                  state: live_deploy_preamble_next_state(state: st, leg: leg, result: result),
                  observations: obs + live_deploy_preamble_result_calls(result: result),
                }
              }
            }
        },
    ),
  )
}

// The fold's accumulator projected into the observable (state, calls) pair. A function rather than an
// inline `match` on the end of a pipe: a `match` as a pipe lambda's body is not a form this parser
// accepts (it reported the lambda parameter itself as an undefined variable).
fn match_fold_acc(acc: LiveDeployPreambleFoldAcc) -> LiveDeployPreambleRun {
  match acc {
    PreambleFoldAcc { state: st, observations: obs } => LiveDeployPreambleRun { state: st, observations: obs }
  }
}

// How many legs have run, for callers that must report the count without matching the whole state.
fn live_deploy_preamble_consumed(state: LiveDeployPreambleLegState) -> Int {
  match state {
    PreambleLegOk { consumed: n } => n
    PreambleLegFailed { step: _, reason: _, consumed: n } => n
  }
}

// The pair (state, calls) the two folds accumulate. `state` is what the fold decided; `observations`
// counts the transport/executor calls actually attempted, which is what makes the short-circuit
// falsifiable (a fold that kept observing after a refusal would report the same state).
type LiveDeployPreambleRun = LiveDeployPreambleRun { state: LiveDeployPreambleLegState, observations: Int }

// The fold's accumulator. `pending` is gone from the impure fold (it observes on demand) and the pure
// fold supplies results by step name instead, so neither needs a positional carrier.
type LiveDeployPreambleFoldAcc = PreambleFoldAcc { state: LiveDeployPreambleLegState, observations: Int }

data live_deploy_preamble_fold_init: LiveDeployPreambleFoldAcc = PreambleFoldAcc { state: live_deploy_preamble_leg_ok, observations: 0 }

// THE IMPURE FOLD — gate first, observe second, so a refusal costs no later privileged call at all.
// It is the pure fold above with its observations produced on demand, and both go through the same
// live_deploy_preamble_leg_decision / live_deploy_preamble_next_state pair, so what the witness pins is
// what runs.
fn live_deploy_preamble_run_legs(legs: List<LiveDeployPreambleLeg>, access: DeployAccess) -> LiveDeployPreambleRun {
  let walked = fold(
    legs,
    init: live_deploy_preamble_fold_init,
    f: (acc, leg) =>
      match acc {
        PreambleFoldAcc { state: st, observations: obs } =>
          match live_deploy_preamble_leg_decision(state: st) {
            Stop { reason: _ } => PreambleFoldAcc { state: st, observations: obs }
            ContinueAndRun => {
              let result = live_deploy_preamble_observe_leg(leg: leg, access: access)
              PreambleFoldAcc {
                state: live_deploy_preamble_next_state(state: st, leg: leg, result: result),
                observations: obs + live_deploy_preamble_result_calls(result: result),
              }
            }
          }
      },
  )
  match walked { PreambleFoldAcc { state: st, observations: obs } => LiveDeployPreambleRun { state: st, observations: obs } }
}

type LiveDeployPreambleScratch = PreambleScratchPresent { path: String } | PreambleScratchAbsent { reason: String }

// `mktemp -d`, and the ONLY way a scratch path enters this block: admitted_scratch_path is what turns
// observed stdout back into a path this module is willing to write to (prefix, non-empty, no newline,
// no space, no `..`). Anything else is a refusal that says what mktemp actually printed.
fn live_deploy_preamble_acquire_scratch(access: DeployAccess) -> LiveDeployPreambleScratch {
  match run_argv_over_host_effect_transport(command: mktemp_directory_command(template: live_deploy_preamble_scratch_template), transport: access.transport) {
    RunArgvTransportRefused { reason: r } => PreambleScratchAbsent { reason: live_deploy_preamble_refusal_text(step: ScratchAcquire, detail: r) }
    RunArgvTransportObserved { observed: o } =>
      match (if o.success { admitted_scratch_path(prefix: live_deploy_preamble_scratch_prefix, stdout: o.stdout) } else { none }) {
        Absent =>
          PreambleScratchAbsent {
            reason: live_deploy_preamble_refusal_text(
              step: ScratchAcquire,
              detail: join(["mktemp -d did not yield an admitted scratch directory (exit ", to_string(o.exit_code), "): ", o.stdout, o.stderr], ""),
            ),
          }
        Present { value: scratch } => PreambleScratchPresent { path: scratch }
      }
  }
}

// The trap's job: `rm -rf "$_gunbc_stage"`, un-elevated (the deploy principal owns the directory
// mktemp -d made). Returns the detail of a failure, or nothing when the scratch is gone.
fn live_deploy_preamble_cleanup_scratch(scratch: String, access: DeployAccess) -> Optional<String> {
  match run_argv_over_host_effect_transport(command: rm_recursive_force_command(path: scratch), transport: access.transport) {
    RunArgvTransportRefused { reason: r } => Present { value: r }
    RunArgvTransportObserved { observed: o } =>
      if o.success { Absent } else { Present { value: join(["exited ", to_string(o.exit_code), ": ", o.stderr], "") } }
  }
}

// THE ORDER, and it is the script's order. Each leg names its own step; the first refusal stops the
// fold and says which step died.
fn live_deploy_preamble_legs(access: DeployAccess, scratch: String, principal: NonEmptyStr) -> List<LiveDeployPreambleLeg> {
  let staged = join([scratch, live_deploy_preamble_stage_suffix], "")
  let dropin = gunbc_deploy_sudoers_dropin as String
  let stage_legs = [
    // The heredoc's job. The bytes cross as STDIN, never as an argv element, so no byte of the drop-in
    // text can change what the command means. `dd` writes as the DEPLOY principal, which is right: the
    // scratch dir belongs to that principal, and root only ever READS the stage (through install).
    PreambleStdin {
      step: SudoersStage,
      command: dd_overwrite_path_command(path: staged),
      payload: concat(deploy_sudoers_dropin_body(access: access), "\n"),
    },
    // Self-elevating: visudo_check_command already renders `sudo -n /usr/sbin/visudo -cf <file>`, so
    // wrapping it again would run `sudo -n sudo -n visudo`.
    PreambleArgv { step: SudoersVisudoCheck, command: visudo_check_command(file: staged) },
    // The install argv comes from its POLICY OWNER, gunbc.ci.ci_deploy_sudoers — the module that
    // already spells `-m 0440` for this drop-in and reads install from the same roster row the
    // pre-install gate demands (ci_runner_sudo_binary_path SudoInstall). Repeating the mode here would
    // put the same security policy in two files where they can drift, and would let a caller pass a
    // looser one.
    PreambleArgv { step: SudoersInstall, command: deploy_sudoers_install_argv(stage: staged, dropin: dropin) },
    // The script's third command is `visudo -c -f <dropin>` — the SAME builder it used for the staged
    // file, on the installed path. It is deliberately NOT visudo_policy_check_command (`-c -O -P -f`):
    // that variant enforces owner and mode, which is the dark helper's requirement, and the deploy
    // script never asked for it. Substituting it would refuse hosts the script admits.
    PreambleArgv { step: SudoersPolicyFinal, command: visudo_check_command(file: dropin) },
  ]
  let grant_legs = list_map(
    xs: access.privileged_commands,
    // One typed effect per roster row, the same effect gunbc.ci.ci_deploy_access builds for its own
    // preflight: NopasswdGrantListCheck keeps its CONTENT check and NopasswdExecuteCheck keeps the
    // script's `if ! sudo -n <cmd>` refusal — through this module's realized leaves.
    f: pc => PreambleEffect { step: GrantAdmission, effect: deploy_access_sudo_probe_effect(cmd: pc) },
  )
  list_append(left: list_append(left: stage_legs, right: grant_legs), right: live_deploy_preamble_principal_legs(principal: principal))
}

// THE PUBLICATION PRINCIPAL, as the script ran it: `id -u -- <login> >/dev/null 2>&1 || sudo -n useradd
// -r -s /usr/sbin/nologin <login>`. The CHECK is the one
// executor_privileged_operation_precondition declares for EnsureSystemAccount (AccountExistsCheck), and
// extdeps.tools.id is the authority for how it is exec'd — this module holds no argv authority of its
// own. `id` carries no sudo roster row, so it runs as the DEPLOY principal, exactly as the script had
// it; elevating it would spend a grant the drop-in does not contain. If the check converges, the fold
// skips the create leg — no gratuitous privileged call, and no silent create of an account the script
// would have skipped. `NoPrecondition` carries only the create: the sealed op is the authority for
// whether a precondition exists at all.
fn live_deploy_preamble_principal_legs(principal: NonEmptyStr) -> List<LiveDeployPreambleLeg> {
  let op = EnsureSystemAccount { login: principal, shell: fleet_posix_nologin_shell_path }
  let create = PreambleEither {
    check_step: PrincipalCheck,
    check: id_uid_of_command(user: principal),
    act_step: PrincipalEnsure,
    act: executor_privileged_operation_elevated_command(op: op),
  }
  match executor_privileged_operation_precondition(op: op) {
    AccountExistsCheck { login: _ } => [create]
    NoPrecondition => [PreambleArgv { step: PrincipalEnsure, command: executor_privileged_operation_elevated_command(op: op) }]
  }
}

// THE SHARED PREAMBLE, as ONE typed call — one function because apply AND retract consume it, and the
// bash emitter goes only when its last consumer cuts over. It takes exactly what the script took: the
// `DeployAccess` the drop-in body and the grant roster are read from, and the publication principal the
// run must end with (callers pass spec.names.publication_principal). The drop-in PATH and its 0440 MODE
// are NOT parameters: they are this script's policy and they stay in gunbc.ci.ci_deploy_sudoers, where
// they are spelled today. A caller-passed mode would be a second home for the same security claim.
//
// The scratch directory is removed whether the fold converged or refused — the trap's job, done as a
// call on both branches. A cleanup failure never masks the real refusal: the fold's step and reason
// survive and the cleanup detail is appended.
fn live_deploy_apply_preamble_on_host(access: DeployAccess, principal: NonEmptyStr) -> LiveDeployPreambleVerdict {
  match live_deploy_preamble_acquire_scratch(access: access) {
    PreambleScratchAbsent { reason: why } => PreambleRefused { step: ScratchAcquire, reason: why, legs_consumed: 0 }
    PreambleScratchPresent { path: scratch } => {
      let run = live_deploy_preamble_run_legs(legs: live_deploy_preamble_legs(access: access, scratch: scratch, principal: principal), access: access)
      let state = match run { LiveDeployPreambleRun { state: st, observations: _ } => st }
      let cleanup = live_deploy_preamble_cleanup_scratch(scratch: scratch, access: access)
      live_deploy_preamble_verdict(
        state: state,
        cleanup_failure: cleanup,
        scratch: scratch,
        principal: grounded_posix_principal_name(p: access.principal) as String,
      )
    }
  }
}

// THE VERDICT, PURE — the fold's answer plus what cleanup reported, with no host in sight, so the
// mask-precedence rules below are checkable the same way the fold is.
fn live_deploy_preamble_verdict(
  state: LiveDeployPreambleLegState,
  cleanup_failure: Optional<String>,
  scratch: String,
  principal: String,
) -> LiveDeployPreambleVerdict {
  match state {
    // A cleanup failure NEVER replaces the real refusal: the step and reason that stopped the deploy
    // survive and the cleanup detail is appended. Losing "visudo refused" to "rm failed" would send an
    // operator chasing a leftover directory instead of the broken sudoers file.
    PreambleLegFailed { step: s, reason: r, consumed: c } =>
      match cleanup_failure {
        Absent => PreambleRefused { step: s, reason: r, legs_consumed: c }
        Present { value: cr } => PreambleRefused { step: s, reason: join([r, "; scratch cleanup of ", scratch, " also failed: ", cr], ""), legs_consumed: c }
      }
    // But a clean fold that could not remove its scratch is NOT a success either: the trap was part of
    // the script, and a root-readable stage left behind after a deploy is a finding, not a detail.
    PreambleLegOk { consumed: c } =>
      match cleanup_failure {
        Present { value: cr } => PreambleRefused { step: ScratchCleanup, reason: live_deploy_preamble_refusal_text(step: ScratchCleanup, detail: cr), legs_consumed: c }
        Absent => PreambleConverged { principal: principal, dropin: gunbc_deploy_sudoers_dropin, legs_consumed: c }
      }
  }
}

fn realize_live_deploy_apply_on_host(
  spec: DeploymentSpec,
  candidate: CandidateRelease,
  plan: ReleaseEffectPlan,
  transport: HostEffectTransport,
  intent: HostEffectIntent,
  access: DeployAccess,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  live_deploy_apply_orchestrate(
    locus_refusal: live_deploy_apply_candidate_locus_refusal(transport: transport),
    prepare: fn() { live_deploy_apply_prepared_on_host(spec: spec, plan: plan, transport: transport, intent: intent, access: access) },
    principal: spec.names.publication_principal,
    preamble: fn(principal) { live_deploy_apply_preamble_on_host(access: access, principal: principal) },
    host: spec.target.host.identity,
    intent: intent,
  )
}

// WHAT THE APPLY OBSERVES BEFORE IT CAN PLAN, DEFERRED BEHIND THE LOCUS GATE: the orchestration forces
// it only after a local locus is admitted, so a refused locus observes no checkout. The checkout this
// process runs in is read once, and is both the source root the object-source leg observes and the one
// every install reads from. An instance's apply observes no slot census or retirement standing: the
// runner-unit caps and the slice control are host facts, not instance members, and their owners are
// gunbc.runner.runner_host_file_converge and the approval broker's dark install.
fn live_deploy_apply_prepared_on_host(
  spec: DeploymentSpec,
  plan: ReleaseEffectPlan,
  transport: HostEffectTransport,
  intent: HostEffectIntent,
  access: DeployAccess,
) -> DeployApplyPrepared {
  let source_root = git.Inspect.Toplevel().path as String
  DeployApplyPrepared {
    plan: deploy_apply_plan_legs(
      spec: spec,
      plan: plan,
      source_root: source_root,
      oidc_now: tracker_web_oidc_deploy_now_epoch(),
    ),
    ports: deploy_apply_ports_on_host(spec: spec, principal: access.principal, source_root: source_root, transport: transport, intent: intent),
  }
}

// RETRACT LOCUS GATE. A fail-closed narrowing in front of the typed retract legs: the teardown is a
// LOCAL operation over the host-effect transport (principal sudo -n removals, unprivileged observes),
// and it is not modeled over ssh or the thin-run artifact locus, so only the local locus proceeds.
// LocalShell passes (none); SshShell, FleetSsh and EmitArtifactThenThinRun each refuse before any
// step runs. The gate is the typed locus choice; the retract script it once fronted is gone.
fn live_deploy_retract_candidate_locus_refusal(transport: HostEffectTransport) -> Optional<String> {
  match transport {
    LocalShell => none
    SshShell { ssh_host: h } =>
      Present { value: join([
        "live_deploy retract refused over ssh host=", h,
        ": the retract unit teardown is a LOCAL operation over the host-effect transport (principal sudo -n removals, unprivileged observes), and the bash emitter it replaces is not modeled over ssh. ",
        "Refusing the remote locus rather than emit a script to run remotely.",
      ], "") }
    FleetSsh { target: _, context: _ } =>
      Present { value: join([
        "live_deploy retract refused over fleet ssh: the retract unit teardown is a LOCAL operation over the host-effect transport (principal sudo -n removals, unprivileged observes), and the bash emitter it replaces is not modeled over fleet ssh. ",
        "Refusing the remote locus rather than emit a script to run remotely.",
      ], "") }
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      Present { value: "live_deploy retract refused over EmitArtifactThenThinRun: the retract unit teardown is a LOCAL operation over the host-effect transport and the bash emitter it replaces is not modeled over the thin-run artifact locus." }
  }
}

// THE RETRACT, AS TYPED LEGS. deploy_retract_plan_legs (gunbc.live_deploy.retract_legs) decides every
// refusal before any leg runs, as the script's Decide fragments did; the shared preamble then runs; then
// each leg in retract order. The first failing leg stops the fold and names its step. There is no
// script body, no stage directory of its own and no EXIT trap: the preamble owns its scratch and
// removes it on both branches, and no other leg stages anything.
//
// THE ORCHESTRATION IS ONE PURE FUNCTION OVER PORTS (live_deploy_retract_orchestrate). The transport has
// no mock arm (ruling 2026-08-23), so what is effectful -- the preamble, the argv dispatch, the C2
// removal and the LoadState read -- enters as function values: production builds them over the real
// transport here, and a control supplies outcomes through the same orchestration and the same per-leg
// dispatch, so a runner that reports success without executing a leg is observable.
fn realize_live_deploy_retract_on_host(
  spec: DeploymentSpec,
  transport: HostEffectTransport,
  intent: HostEffectIntent,
  access: DeployAccess,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  live_deploy_retract_orchestrate(
    locus_refusal: live_deploy_retract_candidate_locus_refusal(transport: transport),
    plan: deploy_retract_plan_legs(spec: spec),
    principal: spec.names.publication_principal,
    preamble: fn(principal) { live_deploy_apply_preamble_on_host(access: access, principal: principal) },
    ports: deploy_retract_ports_on_host(transport: transport),
    host: spec.target.host.identity,
    intent: intent,
  ).verdict
}

type DeployRetractPorts {
  command: fn(ArgvCommand) -> RunArgvTransportOutcome
  remove: fn(HostRemoveTarget) -> Reconciliation<HostRemoveTarget, HostRemoveEvidence>
  load: fn(NonEmptyStr) -> SystemdPropertyCapture
}

fn deploy_retract_ports_on_host(transport: HostEffectTransport) -> DeployRetractPorts {
  DeployRetractPorts {
    command: fn(c) { run_argv_over_host_effect_transport(command: c, transport: transport) },
    remove: fn(t) { host_remove_on_host(target: t, transport: transport) },
    load: fn(u) { systemctl_show_load_state_read(transport: transport, unit: u) },
  }
}

// THE ORCHESTRATION'S ANSWER CARRIES THE PORT CALLS IT MADE. A control asserting that no leg was
// dispatched reads this record, which is built at the single site that invokes each port
// (retract_run_command / retract_run_remove / retract_run_load), so a preamble refusal that also ran a
// leg shows it here and not only in the return value.
type RetractOrchestration {
  verdict: Reconciliation<HostEffectIntent, HostEffectEvidence>
  calls: List<RetractPortCall>
}

fn live_deploy_retract_orchestrate(
  locus_refusal: Optional<String>,
  plan: DeployRetractPlan,
  principal: NonEmptyStr,
  preamble: fn(NonEmptyStr) -> LiveDeployPreambleVerdict,
  ports: DeployRetractPorts,
  host: NonEmptyStr,
  intent: HostEffectIntent,
) -> RetractOrchestration {
  match locus_refusal {
    Present { value: why } => RetractOrchestration { verdict: NotConverged { reason: why, applied: intent }, calls: [] }
    Absent =>
      match plan {
        RetractPlanRefused { step: s, reason: r } =>
          RetractOrchestration {
            verdict: NotConverged { reason: join(["live_deploy retract refused at step ", s, ": ", r], ""), applied: intent },
            calls: [],
          }
        RetractPlanReady { legs: legs } =>
          match preamble(principal) {
            PreambleRefused { step: ps, reason: pr, legs_consumed: _ } =>
              RetractOrchestration {
                verdict: NotConverged {
                  reason: join(["live_deploy retract refused at preamble step ", live_deploy_preamble_step_name(step: ps), ": ", pr], ""),
                  applied: intent,
                },
                calls: [],
              }
            PreambleConverged { principal: _, dropin: _, legs_consumed: _ } => {
              let run = live_deploy_retract_run_legs(legs: legs, ports: ports)
              RetractOrchestration {
                verdict: live_deploy_retract_verdict(run: run, host: host, intent: intent),
                calls: deploy_retract_run_calls(run: run),
              }
            }
          }
      }
  }
}

type DeployRetractRun
  = RetractRunOk { legs_run: Int, calls: List<RetractPortCall> }
  | RetractRunFailed { step: String, reason: String, legs_run: Int, calls: List<RetractPortCall> }

// ONE PORT INVOCATION, as the dispatch made it: which port and what it was asked.
type RetractPortCall {
  port: String
  subject: String
}

fn deploy_retract_run_calls(run: DeployRetractRun) -> List<RetractPortCall> {
  match run {
    RetractRunOk { legs_run: _, calls: cs } => cs
    RetractRunFailed { step: _, reason: _, legs_run: _, calls: cs } => cs
  }
}

type RetractLoadState
  = RetractUnitNotFound
  | RetractUnitLoaded
  | RetractLoadStateUnreadable { reason: String }

// THE END-OF-FOLD RECEIPT LINE, as the script's `echo live-deploy-receipt ...` printed it.
fn live_deploy_receipt_line(host: NonEmptyStr, fold: String) -> String {
  join(["live-deploy-receipt host=", host as String, " fold=", fold, " verdict=converged\n"], "")
}

// PURE: the run's answer to a Reconciliation, with no host in sight.
fn live_deploy_retract_verdict(
  run: DeployRetractRun,
  host: NonEmptyStr,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match run {
    RetractRunFailed { step: s, reason: r, legs_run: n, calls: _ } =>
      NotConverged {
        reason: join(["live_deploy retract refused at step ", s, " after ", to_string(n), " completed legs: ", r], ""),
        applied: intent,
      }
    RetractRunOk { legs_run: _, calls: _ } =>
      Converged {
        evidence: ShellEffectApplied { exit_code: 0, stdout: live_deploy_receipt_line(host: host, fold: "retract"), stderr: "" },
        applied: intent,
      }
  }
}

// PURE: LoadState is the one observation that tells an ABSENT unit from a present one. An unreadable
// manager is its own state and is never folded into absent (systemctl_show_load_state_argv's rule).
fn deploy_retract_load_state_of(capture: SystemdPropertyCapture) -> RetractLoadState {
  match capture {
    SystemdPropertyCaptured { value: v } =>
      if v == (systemd_unit_load_state_not_found_wire as String) { RetractUnitNotFound } else { RetractUnitLoaded }
    SystemdPropertyBlank => RetractLoadStateUnreadable { reason: "systemctl show printed no LoadState" }
    SystemdPropertyCaptureRefused { reason: r } => RetractLoadStateUnreadable { reason: r }
  }
}

// PURE: one argv leg's failure, if any. A refused transport is never reported as having run.
fn deploy_retract_command_failure(outcome: RunArgvTransportOutcome) -> Optional<String> {
  match outcome {
    RunArgvTransportRefused { reason: r } => Present { value: r }
    RunArgvTransportObserved { observed: o } =>
      if o.exit_code == 0 {
        Absent
      } else {
        Present { value: join(["exit ", to_string(o.exit_code), ": ", o.stderr], "") }
      }
  }
}

fn deploy_retract_remove_failure(verdict: Reconciliation<HostRemoveTarget, HostRemoveEvidence>) -> Optional<String> {
  match verdict {
    Converged { evidence: _, applied: _ } => Absent
    NotConverged { reason: r, applied: _ } => Present { value: r }
  }
}

fn deploy_retract_disable_failure(load: RetractLoadState, disable: RunArgvTransportOutcome) -> Optional<String> {
  match load {
    RetractUnitNotFound => Absent
    RetractLoadStateUnreadable { reason: r } => Present { value: join(["the unit's LoadState was unreadable, so disable --now was not attempted: ", r], "") }
    RetractUnitLoaded => deploy_retract_command_failure(outcome: disable)
  }
}

fn deploy_retract_gone_failure(load: RetractLoadState) -> Optional<String> {
  match load {
    RetractUnitNotFound => Absent
    RetractUnitLoaded => Present { value: "leftover timer still loaded after retire -- LoadState is not not-found (fail-closed)" }
    RetractLoadStateUnreadable { reason: r } => Present { value: join(["leftover timer readback unreadable: ", r], "") }
  }
}

type RetractLegRun {
  failure: Optional<String>
  calls: List<RetractPortCall>
}

type RetractCommandRan {
  outcome: RunArgvTransportOutcome
  call: RetractPortCall
}

type RetractRemoveRan {
  verdict: Reconciliation<HostRemoveTarget, HostRemoveEvidence>
  call: RetractPortCall
}

type RetractLoadRead {
  capture: SystemdPropertyCapture
  call: RetractPortCall
}

fn retract_run_command(ports: DeployRetractPorts, command: ArgvCommand) -> RetractCommandRan {
  let run = ports.command
  RetractCommandRan {
    outcome: run(command),
    call: RetractPortCall { port: "command", subject: join(argv_words(command: command), " ") },
  }
}

fn retract_run_remove(ports: DeployRetractPorts, target: HostRemoveTarget) -> RetractRemoveRan {
  let remove = ports.remove
  RetractRemoveRan {
    verdict: remove(target),
    call: RetractPortCall { port: "remove", subject: join([host_remove_arm_name(target: target), " ", host_remove_path_field(target: target)], "") },
  }
}

fn retract_run_load(ports: DeployRetractPorts, unit: NonEmptyStr) -> RetractLoadRead {
  let load_of = ports.load
  RetractLoadRead {
    capture: load_of(unit),
    call: RetractPortCall { port: "load", subject: unit as String },
  }
}

fn live_deploy_retract_run_leg(leg: DeployRetractLeg, ports: DeployRetractPorts) -> RetractLegRun {
  match leg {
    RetractServeOff { endpoint: e } => {
      let ran = retract_run_command(ports: ports, command: sudo_elevate_command(command: argv_words(command: tailscale_serve_off_command(endpoint: e))))
      RetractLegRun { failure: deploy_retract_command_failure(outcome: ran.outcome), calls: [ran.call] }
    }
    RetractDisableIfLoaded { unit: u } => {
      let read = retract_run_load(ports: ports, unit: u)
      let load = deploy_retract_load_state_of(capture: read.capture)
      match load {
        RetractUnitLoaded => {
          let ran = retract_run_command(ports: ports, command: sudo_elevate_command(command: systemctl_disable_now_argv(unit: u)))
          RetractLegRun {
            failure: deploy_retract_disable_failure(load: load, disable: ran.outcome),
            calls: [read.call, ran.call],
          }
        }
        RetractUnitNotFound => RetractLegRun { failure: Absent, calls: [read.call] }
        RetractLoadStateUnreadable { reason: _ } =>
          RetractLegRun {
            failure: deploy_retract_disable_failure(load: load, disable: RunArgvTransportRefused { reason: "disable not attempted" }),
            calls: [read.call],
          }
      }
    }
    RetractRemoveForce { paths: ps } => retract_remove_leg(ran: retract_run_remove(ports: ports, target: RemoveForce { paths: ps }))
    RetractRemoveEmptyDirectory { path: p } => retract_remove_leg(ran: retract_run_remove(ports: ports, target: RemoveEmptyDirectory { path: p }))
    RetractRemoveRecursive { path: p } => retract_remove_leg(ran: retract_run_remove(ports: ports, target: RemoveForceRecursive { path: p }))
    RetractDaemonReload => {
      let ran = retract_run_command(ports: ports, command: extdeps.systemd.systemctl.systemctl_daemon_reload_command())
      RetractLegRun { failure: deploy_retract_command_failure(outcome: ran.outcome), calls: [ran.call] }
    }
    RetractUnitGoneReadback { unit: u } => {
      let read = retract_run_load(ports: ports, unit: u)
      RetractLegRun { failure: deploy_retract_gone_failure(load: deploy_retract_load_state_of(capture: read.capture)), calls: [read.call] }
    }
  }
}

fn retract_remove_leg(ran: RetractRemoveRan) -> RetractLegRun {
  RetractLegRun { failure: deploy_retract_remove_failure(verdict: ran.verdict), calls: [ran.call] }
}

fn live_deploy_retract_run_legs(legs: List<DeployRetractLeg>, ports: DeployRetractPorts) -> DeployRetractRun {
  live_deploy_retract_run_legs_from(legs: legs, ports: ports, done: 0, calls: [])
}

fn live_deploy_retract_run_legs_from(legs: List<DeployRetractLeg>, ports: DeployRetractPorts, done: Int, calls: List<RetractPortCall>) -> DeployRetractRun {
  match legs {
    Empty => RetractRunOk { legs_run: done, calls: calls }
    Cons { head: leg, tail: rest } => {
      let ran = live_deploy_retract_run_leg(leg: leg, ports: ports)
      let seen = concat(calls, ran.calls)
      match ran.failure {
        Present { value: why } => RetractRunFailed { step: deploy_retract_leg_step(leg: leg), reason: why, legs_run: done, calls: seen }
        Absent => live_deploy_retract_run_legs_from(legs: rest, ports: ports, done: done + 1, calls: seen)
      }
    }
  }
}

// ── THE APPLY FOLD'S RUNNER (gunbc.live_deploy.apply_legs) ───────────────────────────────────────
//
// THE PORTS ARE THE HOST-TOUCHING OPERATIONS AND NOTHING ELSE: one argv through the transport, and
// C1, the directory provider. Production supplies deploy_apply_ports_on_host; a control supplies
// outcomes. The runner is a pure fold over them, so a leg after a failed one is never dispatched.
type DeployApplyPorts {
  command: fn(ArgvCommand) -> RunArgvTransportOutcome
  stdin: fn(ArgvCommand, String) -> RunArgvTransportOutcome
  ensure_directory: fn(OwnedDirectoryTarget) -> OwnedDirectoryEnsureOutcome
  state_directories: fn(ReleaseRevisionBinding) -> Optional<String>
  root_helper_snapshot: fn(HelperLocus, List<String>, ReleaseRevisionBinding, HelperSnapshotAction) -> Optional<String>
  broker_tree: fn(ReleaseRevisionBinding) -> Optional<String>
  dependency: fn(DeploymentDependencyStep) -> Optional<String>
  retract: DeployRetractPorts
  object_source: fn() -> ObjectSourceServeAdmission
}

// THE PLAN AND THE PORTS THAT REALIZE IT, produced together because both read one checkout. The
// orchestration takes them deferred, so a locus refusal is decided before either exists.
type DeployApplyPrepared {
  plan: DeployApplyPlan
  ports: DeployApplyPorts
}

fn deploy_apply_ports_on_host(spec: DeploymentSpec, principal: GroundedPosixPrincipal, source_root: String, transport: HostEffectTransport, intent: HostEffectIntent) -> DeployApplyPorts {
  DeployApplyPorts {
    command: fn(c) { run_argv_over_host_effect_transport(command: c, transport: transport) },
    stdin: fn(c, p) { run_argv_stdin_over_host_effect_transport(command: c, stdin_payload: p, transport: transport) },
    ensure_directory: fn(t) { live_deploy_apply_ensure_directory_on_host(target: t, transport: transport) },
    state_directories: fn(r) { live_deploy_apply_state_directories_on_host(spec: spec, revision: r, principal: principal, source_root: source_root, transport: transport) },
    root_helper_snapshot: fn(locus, spine, r, action) { live_deploy_apply_root_helper_snapshot_on_host(locus: locus, spine: spine, revision: r, action: action, source_root: source_root, transport: transport) },
    broker_tree: fn(r) { live_deploy_apply_broker_tree_on_host(spec: spec, revision: r, source_root: source_root, transport: transport) },
    dependency: fn(d) { live_deploy_apply_dependency_on_host(dep: d, transport: transport, intent: intent) },
    retract: deploy_retract_ports_on_host(transport: transport),
    object_source: fn() { observe_object_source_serve(source: source_root) },
  }
}

// C1: ONE OWNED DIRECTORY, ENSURED THROUGH THE ONE PROVIDER. The reads are the privileged list and stat
// of the directory's parent chain (the same ones gunbc.live_deploy.member_observe makes), each keeping
// its origin typed; the install is the provider's plan as the EnsureOwnedDirectory operation, so its
// words are exactly the ones a job user's sudoers grant names (gunbc.executor_privileged_operation); the verdict is the provider's
// independent second stat, never the install's exit status.
fn deploy_apply_directory_read(op: ExecutorPrivilegedOperation, transport: HostEffectTransport) -> ObserverRead {
  match run_argv_over_host_effect_transport(command: executor_privileged_operation_elevated_command(op: op), transport: transport) {
    RunArgvTransportRefused { reason: r } => ObserverReadFailed { origin: ObserverTransportRefused { cause: r } }
    RunArgvTransportObserved { observed: o } =>
      if o.success {
        ObserverReadOut { stdout: o.stdout }
      } else {
        ObserverReadFailed { origin: ObserverExited { exit_code: o.exit_code, stderr: o.stderr } }
      }
  }
}

fn deploy_apply_directory_observe(path: FilePath, transport: HostEffectTransport) -> EnsureObservation<OwnedDirectoryReading> {
  owned_directory_observe(
    path: path,
    list: p => deploy_apply_directory_read(op: ListDirectoryEntries { path: p as String as NonEmptyStr }, transport: transport),
    stat: p => deploy_apply_directory_read(op: ReadDirectoryIdentity { path: p as String as NonEmptyStr }, transport: transport),
  )
}

fn live_deploy_apply_ensure_directory_on_host(target: OwnedDirectoryTarget, transport: HostEffectTransport) -> OwnedDirectoryEnsureOutcome {
  owned_directory_ensure(
    policy: EnsureMayApply,
    target: target,
    observe: p => deploy_apply_directory_observe(path: p, transport: transport),
    run: plan => match run_argv_over_host_effect_transport(
      command: executor_privileged_operation_elevated_command(op: EnsureOwnedDirectory {
        path: plan.path as String as NonEmptyStr, owner: plan.owner.user, group: plan.owner.group, mode: plan.mode,
      }),
      transport: transport,
    ) {
      RunArgvTransportRefused { reason: _ } => false
      RunArgvTransportObserved { observed: o } => o.success
    },
  )
}

type DeployApplyRun
  = ApplyRunOk { legs_run: Int, reports: List<String> }
  | ApplyRunFailed { step: String, reason: String, legs_run: Int }

// THE BROKER'S STATE DIRECTORIES, through the stage the dark install runs; a DarkFailed becomes the leg's
// refusal naming its step.
fn live_deploy_apply_state_directories_on_host(spec: DeploymentSpec, revision: ReleaseRevisionBinding, principal: GroundedPosixPrincipal, source_root: String, transport: HostEffectTransport) -> Optional<String> {
  match dark_state_directories_install(i: DarkInstallInputs { spec: spec, revision: revision, principal: principal, source_root: source_root, transport: transport }) {
    DarkOk => Absent
    DarkFailed { step: s, reason: r } => Present { value: join(["broker state directories refused at step ", dark_install_step_name(step: s), ": ", r], "") }
  }
}

// A ROOT-OWNED RELEASE SNAPSHOT, installed or retired through the same two stages the broker's helper
// grant runs (dark_helper_snapshot_at, dark_helper_retire_at). The install and the retire are separate
// legs because the units that name the snapshot are installed between them: the superseded snapshot is
// retired only after the new units stand.
fn live_deploy_apply_root_helper_snapshot_on_host(locus: HelperLocus, spine: List<String>, revision: ReleaseRevisionBinding, action: HelperSnapshotAction, source_root: String, transport: HostEffectTransport) -> Optional<String> {
  match (match action {
    HelperSnapshotInstall => dark_helper_snapshot_at(locus: locus, spine: spine, revision: revision, source_root: source_root, transport: transport)
    HelperSnapshotRetireSuperseded => dark_helper_retire_at(locus: locus, revision: revision, transport: transport)
  }) {
    DarkOk => Absent
    DarkFailed { step: s, reason: r } => Present { value: join(["root helper snapshot at ", locus.base, " refused at step ", dark_install_step_name(step: s), ": ", r], "") }
  }
}

// AN ENSURED DEPENDENCY, through the typed ensure-dependency route the deploy's own dependency effect
// runs (probe, then install only on the probe's verdict).
fn live_deploy_apply_dependency_on_host(dep: DeploymentDependencyStep, transport: HostEffectTransport, intent: HostEffectIntent) -> Optional<String> {
  match realize_live_deploy_ensure_dependency_on_host(dep: dep, transport: transport, intent: intent) {
    Converged { evidence: _, applied: _ } => Absent
    NotConverged { reason: r, applied: _ } => Present { value: r }
  }
}

// A DIGEST ENV FILE WRITTEN FROM THE INSTALLED BYTES: sha256sum of the binary as installed, read back over
// the command port, becomes NAME=<hex> written root-installed through the stdin port. A refused read, a
// failed one and a line carrying no digest each stop the leg before anything is written, so an empty or
// fabricated NAME= never reaches the file.
fn deploy_apply_digest_env_failure(binary: String, env_name: String, dest: String, owner: NonEmptyStr, ports: DeployApplyPorts) -> Optional<String> {
  let command = ports.command
  match command(sha256sum_file_command(path: binary)) {
    RunArgvTransportRefused { reason: r } => Present { value: join(["sha256sum of ", binary, " was refused: ", r], "") }
    RunArgvTransportObserved { observed: o } =>
      if o.exit_code != 0 {
        Present { value: join(["sha256sum could not read ", binary, ": exit ", to_string(o.exit_code), ": ", o.stderr], "") }
      } else {
        match sha256sum_line_digest(line: o.stdout) {
          Absent => Present { value: join(["sha256sum printed no digest for ", binary], "") }
          Present { value: d } => {
            let hex: String = d.hex
            deploy_retract_command_failure(outcome: ports.stdin(
              sudo_elevate_command(command: coreutils_install_file_owned_argv(mode: install_file_shared_mode, owner: owner, group: owner, source: "/dev/stdin", dest: dest)),
              join([env_name, "=", hex, "\n"], ""),
            ))
          }
        }
      }
  }
}

// THE CREDSTORE COPY'S BRACKET, RUN ON THE HOST THROUGH THE COMMAND PORT (gunbc.live_deploy.apply_legs
// ApplyLegCredstoreCopy says why it is the host-side realization of gunbc.auth.private_secret_file rather than a
// call). The order is the bracket's: stage, owner-only copy, the one use (the root install), then the removal,
// whose rmdir is the check. No cause carries a path or a command's stderr, because either may name the stage.
fn credstore_copy_succeeded(outcome: RunArgvTransportOutcome) -> Bool {
  match outcome {
    RunArgvTransportRefused { reason: _ } => false
    RunArgvTransportObserved { observed: o } => o.exit_code == 0
  }
}

fn credstore_copy_stage_path(outcome: RunArgvTransportOutcome) -> NonEmptyStr? {
  match outcome {
    RunArgvTransportRefused { reason: _ } => none
    RunArgvTransportObserved { observed: o } => {
      let path = trim(s: o.stdout)
      if o.exit_code == 0 && starts_with(s: path, prefix: "/") && !string_contains(s: path, pattern: "\n") { Present { value: path as NonEmptyStr } } else { none }
    }
  }
}

fn credstore_copy_bracket(source: NonEmptyStr, dest: NonEmptyStr, file_name: NonEmptyStr, run: fn(ArgvCommand) -> RunArgvTransportOutcome) -> CredstoreCopyBracket {
  let staged = run(credstore_copy_stage_command())
  match credstore_copy_stage_path(outcome: staged) {
    Absent =>
      if credstore_copy_succeeded(outcome: staged) {
        CredstoreCopyNotEnteredResidueRemains { cause: "mktemp -d answered but printed no single absolute path, so the stage it may have made cannot be removed" as NonEmptyStr }
      } else {
        CredstoreCopyNotEntered { cause: "no private stage directory could be created for the credential copy, so nothing was copied" as NonEmptyStr }
      }
    Present { value: stage } => {
      let cmds = credstore_copy_commands(stage: stage, source: source, dest: dest, file_name: file_name)
      if credstore_copy_succeeded(outcome: run(cmds.user_copy)) {
        let installed = credstore_copy_succeeded(outcome: run(cmds.root_install))
        let removed = credstore_copy_succeeded(outcome: run(cmds.remove_file)) && credstore_copy_succeeded(outcome: run(cmds.remove_dir))
        if removed { CredstoreCopyCompleted { installed: installed } } else { CredstoreCopyCompletedResidueRemains { installed: installed } }
      } else {
        let removed = credstore_copy_succeeded(outcome: run(cmds.remove_file)) && credstore_copy_succeeded(outcome: run(cmds.remove_dir))
        if removed {
          CredstoreCopyNotEntered { cause: "the custody file could not be copied into the stage as the apply's principal; the stage was removed, so no copy is on disk" as NonEmptyStr }
        } else {
          CredstoreCopyNotEnteredResidueRemains { cause: "the custody file could not be copied into the stage AND the stage could not be removed, so material may remain and requires cleanup" as NonEmptyStr }
        }
      }
    }
  }
}

fn credstore_copy_failure(bracket: CredstoreCopyBracket) -> Optional<String> {
  match bracket {
    CredstoreCopyCompleted { installed: i } =>
      if i { Absent } else { Present { value: "the root install of the worker credential into the credstore failed; the stage was removed" } }
    CredstoreCopyCompletedResidueRemains { installed: i } =>
      Present { value: if i { "the worker credential was installed, but its stage could not be removed, so a copy remains and requires cleanup" } else { "the root install of the worker credential failed AND its stage could not be removed, so a copy remains and requires cleanup" } }
    CredstoreCopyNotEntered { cause: c } => Present { value: c as String }
    CredstoreCopyNotEnteredResidueRemains { cause: c } => Present { value: c as String }
  }
}

// ONE RETRACT LEG ON APPLY (a leftover timer's retirement), through the retract runner itself.
fn deploy_apply_retract_leg_failure(leg: DeployRetractLeg, ports: DeployRetractPorts) -> Optional<String> {
  match live_deploy_retract_run_legs(legs: [leg], ports: ports) {
    RetractRunOk { legs_run: _, calls: _ } => Absent
    RetractRunFailed { step: s, reason: r, legs_run: _, calls: _ } => Present { value: join(["retract leg ", s, ": ", r], "") }
  }
}

// THE BROKER'S RELEASE TREE, through the same per-file install the dark install's broker stage runs.
fn live_deploy_apply_broker_tree_on_host(spec: DeploymentSpec, revision: ReleaseRevisionBinding, source_root: String, transport: HostEffectTransport) -> Optional<String> {
  match approval_broker_tree_install(
    owner: spec.service.service_user,
    base_root: spec.approval_broker.repo_root as String,
    source_root: source_root,
    revision: revision,
    executables: approval_broker_release_locus_executables,
    transport: one_transport_route(transport: transport),
  ) {
    TreeInstallConverged { installed_digest: _, files_installed: _ } => Absent
    TreeInstallRefused { step: ts, reason: r } => Present { value: join(["broker tree refused at tree step ", tree_install_step_name(step: ts), ": ", r], "") }
  }
}

// THE LAST LINES OF A FAILED CONTROL PROCESS'S STATUS, the diagnosis the restart's bare refusal never
// carries. Bounded to the tail so a long journal cannot bury the cause.
fn deploy_apply_status_tail(text: String) -> String {
  let lines = split(s: text, delimiter: "\n")
  let n = count(lines)
  join(if n > 40 { skip(xs: lines, n: n - 40) } else { lines }, "\n")
}

// A COMMAND WHOSE FAILURE IS DIAGNOSED: the failure still fails the leg (a diagnosis, never an escape
// hatch), and carries the status tail read through the diagnosis command. A diagnosis that itself
// cannot run is named in the reason rather than dropped.
fn deploy_apply_diagnosed_failure(why: String, diagnosis: RunArgvTransportOutcome) -> String {
  match diagnosis {
    RunArgvTransportRefused { reason: r } => join([why, " | diagnosis could not run: ", r], "")
    RunArgvTransportObserved { observed: o } =>
      join([why, "\n--- control-process diagnosis ---\n", deploy_apply_status_tail(text: concat(o.stdout, o.stderr))], "")
  }
}

// THE DIGEST OF A FILE ON THE HOST AGAINST THE ONE THE PLAN DECLARED. An unreadable file, an unparseable
// line and a different digest are each their own refusal; none reads as a match.
fn deploy_apply_digest_failure(path: String, digest: Digest, outcome: RunArgvTransportOutcome) -> Optional<String> {
  match outcome {
    RunArgvTransportRefused { reason: r } => Present { value: r }
    RunArgvTransportObserved { observed: o } =>
      if o.exit_code != 0 {
        Present { value: join(["sha256sum could not read ", path, ": exit ", to_string(o.exit_code), ": ", o.stderr], "") }
      } else {
        match sha256sum_line_digest(line: o.stdout) {
          Absent => Present { value: join(["sha256sum printed no digest for ", path], "") }
          Present { value: d } => {
            let seen: String = d.hex
            let planned: String = digest.hex
            if seen == planned {
              Absent
            } else {
              Present { value: join([path, " digest ", seen, " is not the planned ", planned], "") }
            }
          }
        }
      }
  }
}

fn deploy_apply_run_leg(leg: DeployApplyLeg, ports: DeployApplyPorts) -> Optional<String> {
  let command = ports.command
  let ensure = ports.ensure_directory
  match leg {
    ApplyLegEnsureDirectory { target: t } => {
      let outcome = ensure(t)
      if owned_directory_outcome_converged(o: outcome) { Absent } else { Present { value: owned_directory_outcome_detail(o: outcome) } }
    }
    ApplyLegRepairDirectoryEntries { command: c } => deploy_retract_command_failure(outcome: command(c))
    ApplyLegCommand { step: _, command: c } => deploy_retract_command_failure(outcome: command(c))
    ApplyLegInstallFile { step: _, command: c, payload: p } => deploy_retract_command_failure(outcome: ports.stdin(c, p))
    ApplyLegReport { step: _, line: _ } => Absent
    ApplyLegDigestVerify { step: _, path: p, digest: d } => deploy_apply_digest_failure(path: p, digest: d, outcome: command(sha256sum_file_command(path: p)))
    ApplyLegDiagnosedCommand { step: _, command: c, diagnosis: g } =>
      match deploy_retract_command_failure(outcome: command(c)) {
        Absent => Absent
        Present { value: why } => Present { value: deploy_apply_diagnosed_failure(why: why, diagnosis: command(g)) }
      }
    ApplyLegBrokerStateDirectories { revision: r } => ports.state_directories(r)
    ApplyLegRootHelperSnapshot { locus: l, spine: sp, revision: r, action: a } => ports.root_helper_snapshot(l, sp, r, a)
    ApplyLegBrokerTree { revision: r } => ports.broker_tree(r)
    ApplyLegRetract { step: _, leg: l } => deploy_apply_retract_leg_failure(leg: l, ports: ports.retract)
    ApplyLegDependency { dep: d } => ports.dependency(d)
    ApplyLegDigestEnvFile { step: _, binary: b, env_name: n, dest: d, owner: o } => deploy_apply_digest_env_failure(binary: b, env_name: n, dest: d, owner: o, ports: ports)
    ApplyLegCredstoreCopy { step: _, source: s, dest: d, file_name: f } => credstore_copy_failure(bracket: credstore_copy_bracket(source: s, dest: d, file_name: f, run: command))
    ApplyLegObjectSource => {
      let observe = ports.object_source
      match observe() {
        ObjectSourceCanServe { source: _ } => Absent
        ObjectSourceCannotServe { source: s, cause: c } =>
          Present { value: object_source_serve_refusal_text(admission: ObjectSourceCannotServe { source: s, cause: c }) }
        ObjectSourceServeDecideAtApplyPwd => Present { value: "object source standing was not observed (deferred to the host PWD): refusing rather than reading it as servable" }
      }
    }
  }
}

fn deploy_apply_leg_report(leg: DeployApplyLeg) -> List<String> {
  match leg {
    ApplyLegReport { step: _, line: l } => [l]
    ApplyLegEnsureDirectory { target: _ } => []
    ApplyLegRepairDirectoryEntries { command: _ } => []
    ApplyLegCommand { step: _, command: _ } => []
    ApplyLegInstallFile { step: _, command: _, payload: _ } => []
    ApplyLegBrokerStateDirectories { revision: _ } => []
    ApplyLegRootHelperSnapshot { locus: _, spine: _, revision: _, action: _ } => []
    ApplyLegBrokerTree { revision: _ } => []
    ApplyLegRetract { step: _, leg: _ } => []
    ApplyLegDependency { dep: _ } => []
    ApplyLegDigestEnvFile { step: _, binary: _, env_name: _, dest: _, owner: _ } => []
    ApplyLegCredstoreCopy { step: _, source: _, dest: _, file_name: _ } => []
    ApplyLegObjectSource => []
    ApplyLegDigestVerify { step: _, path: _, digest: _ } => []
    ApplyLegDiagnosedCommand { step: _, command: _, diagnosis: _ } => []
  }
}

fn deploy_apply_run_legs_from(legs: List<DeployApplyLeg>, ports: DeployApplyPorts, done: Int, reports: List<String>) -> DeployApplyRun {
  match legs {
    Empty => ApplyRunOk { legs_run: done, reports: reports }
    Cons { head: leg, tail: rest } =>
      match deploy_apply_run_leg(leg: leg, ports: ports) {
        Present { value: why } => ApplyRunFailed { step: deploy_apply_leg_step(leg: leg), reason: why, legs_run: done }
        Absent => deploy_apply_run_legs_from(legs: rest, ports: ports, done: done + 1, reports: list_append(left: reports, right: deploy_apply_leg_report(leg: leg)))
      }
  }
}

fn deploy_apply_run_legs(legs: List<DeployApplyLeg>, ports: DeployApplyPorts) -> DeployApplyRun {
  deploy_apply_run_legs_from(legs: legs, ports: ports, done: 0, reports: [])
}

// THE APPLY VERDICT. A failed run is NotConverged naming the step and the legs already completed; a clean
// run converges with the withheld reports and the receipt line, in that order.
fn live_deploy_apply_verdict(
  run: DeployApplyRun,
  host: NonEmptyStr,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match run {
    ApplyRunFailed { step: s, reason: r, legs_run: n } =>
      NotConverged {
        reason: join(["live_deploy apply refused at step ", s, " after ", to_string(n), " completed legs: ", r], ""),
        applied: intent,
      }
    ApplyRunOk { legs_run: _, reports: rs } =>
      Converged {
        evidence: ShellEffectApplied {
          exit_code: 0,
          stdout: join(concat(list_map(xs: rs, f: l => join([l, "\n"], "")), [live_deploy_receipt_line(host: host, fold: "apply")]), ""),
          stderr: "",
        },
        applied: intent,
      }
  }
}

// THE APPLY ORCHESTRATION, ONE PURE FUNCTION OVER PORTS (mirrors live_deploy_retract_orchestrate).
fn live_deploy_apply_orchestrate(
  locus_refusal: Optional<String>,
  prepare: fn() -> DeployApplyPrepared,
  principal: NonEmptyStr,
  preamble: fn(NonEmptyStr) -> LiveDeployPreambleVerdict,
  host: NonEmptyStr,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match locus_refusal {
    Present { value: why } => NotConverged { reason: why, applied: intent }
    Absent => {
      let prepared = prepare()
      match prepared.plan {
        ApplyPlanRefused { step: s, reason: r } =>
          NotConverged { reason: join(["live_deploy apply refused at step ", s, ": ", r], ""), applied: intent }
        ApplyPlanReady { legs: legs } =>
          match preamble(principal) {
            PreambleRefused { step: ps, reason: pr, legs_consumed: _ } =>
              NotConverged {
                reason: join(["live_deploy apply refused at preamble step ", live_deploy_preamble_step_name(step: ps), ": ", pr], ""),
                applied: intent,
              }
            PreambleConverged { principal: _, dropin: _, legs_consumed: _ } =>
              live_deploy_apply_verdict(run: deploy_apply_run_legs(legs: legs, ports: prepared.ports), host: host, intent: intent)
          }
      }
    }
  }
}

// THE APPROVAL BROKER'S RELEASE TREE, INSTALLED AS A TYPED, FAIL-FAST VERTICAL (W6). One leg of the
// dark install, declared frontier: its consumers are the microVM controller install (W5) and the live_deploy apply (next PR), each landing in its own atomic PR that calls this one function, and until they land only its witness calls it: owner, base_root,
// source_root and revision are PARAMETERS (the owner is never inferred, the source is never the
// process cwd), and every step is an ArgvCommand run through run_argv_over_host_effect_transport --
// no shell, no quoting, no script body. The first failing step stops the line and names itself.
//
// THE RECEIPT IS INDEPENDENT READBACK. After the install the INSTALLED files under the release
// directory are hashed on the host and compared, entry for entry, with the same hashes taken over
// source_root's file set; sorting is bytewise (std.algebra list_sort_by_key over the canonical String
// order, which is LC_ALL=C sort). A single differing file refuses with step "readback", and the
// receipt -- the completeness marker, written last -- is then NOT written. installed_digest is the
// sha256 of the sorted `<hex>  <relative path>` lines, byte-for-byte what the retired shell receipt
// recorded, so gunbc.auth.approval_broker_cutover observe_broker_tree_receipt reads it unchanged.
//
// source_root must be reachable from the transport (the install reads it on the host that runs it):
// over SshShell a source_root absent on the host refuses at the first file install, never installs
// nothing and reports success.
type ApprovalBrokerTreeInstallVerdict
  = TreeInstallConverged { installed_digest: String, files_installed: Int }
  | TreeInstallRefused { step: TreeInstallStep, reason: String }

type TreeFileHash {
  path: String
  hex: String
}

// The closed set of places a tree install can refuse; a caller matches on the variant, never on text.
type TreeInstallStep
  = TreeStepRevision
  | TreeStepSourceObserve
  | TreeStepInstallDirectory
  | TreeStepInstallFile
  | TreeStepInstallBinary
  | TreeStepReadback
  | TreeStepDigest
  | TreeStepReceipt

type TreeInstallStepState
  = TreeStepsOk
  | TreeStepFailed { step: TreeInstallStep, reason: String }

fn tree_file_hash_path(e: TreeFileHash) -> String { e.path }

data tree_path_total_order: TotalOrder<String> = { compare: tree_path_compare }

fn tree_path_compare(a: String, b: String) -> Ordering {
  if a < b { Less } else { if a > b { Greater } else { Equal } }
}

fn sort_tree_file_hashes(entries: List<TreeFileHash>) -> List<TreeFileHash> {
  list_sort_by_key(xs: entries, key: tree_file_hash_path, order: tree_path_total_order)
}

// `<hex>  <path>` lines of sha256sum, the path rebased from the absolute `root` onto `sub`/<relative>.
// A line that is not shaped `<64 hex>  <root>/<relative>` is DROPPED here; the caller
// (observe_tree_hashes) counts the non-empty lines against the parsed entries and refuses on any
// difference, so a dropped line is never a silently smaller tree.
fn tree_file_hashes_of_stdout(stdout: String, root: String, sub: String) -> List<TreeFileHash> {
  let marker = join([root, "/"], "")
  flat_map(split(s: stdout, delimiter: "\n"), line =>
    if string_length(s: line) > 66 + string_length(s: marker) && starts_with(s: substring(s: line, start: 66, end: string_length(s: line)), prefix: marker) {
      [TreeFileHash {
        hex: substring(s: line, start: 0, end: 64),
        path: join([sub, "/", substring(s: line, start: 66 + string_length(s: marker), end: string_length(s: line))], ""),
      }]
    } else { [] }
  )
}

fn tree_hash_lines(entries: List<TreeFileHash>) -> String {
  join(list_map(xs: sort_tree_file_hashes(entries: entries), f: e => join([e.hex, "  ", e.path, "\n"], "")), "")
}

fn tree_entries_agree(source: List<TreeFileHash>, installed: List<TreeFileHash>) -> Bool {
  count(source) == count(installed) && tree_hash_lines(entries: source) == tree_hash_lines(entries: installed)
}

// Every ancestor directory of every file, parents before children (bytewise sort puts a prefix first).
fn tree_ancestor_directories(files: List<TreeFileHash>) -> List<String> {
  let all = flat_map(files, f => tree_path_prefixes(path: f.path))
  // sorted, so duplicates are adjacent: compare with the last kept entry only
  let walked = fold(list_sort_by_key(xs: all, key: fn(p) { p }, order: tree_path_total_order), init: TreeDedupWalk { last: "", out: [] }, f: (w, p) =>
    if w.last == p { w } else { TreeDedupWalk { last: p, out: list_snoc_item(xs: w.out, item: p) } }
  )
  walked.out
}

type TreeDedupWalk {
  last: String
  out: List<String>
}

fn tree_path_prefixes(path: String) -> List<String> {
  let parts = split(s: path, delimiter: "/")
  let n = count(parts)
  let walked = fold(parts, init: TreePrefixWalk { current: "", seen: 0, out: [] }, f: (w, part) => {
    let next = if w.seen == 0 { part } else { join([w.current, "/", part], "") }
    TreePrefixWalk {
      current: next,
      seen: w.seen + 1,
      out: if w.seen + 1 < n { list_snoc_item(xs: w.out, item: next) } else { w.out },
    }
  })
  walked.out
}

type TreePrefixWalk {
  current: String
  seen: Int
  out: List<String>
}

fn tree_step_failure(step: TreeInstallStep, outcome: RunArgvTransportOutcome) -> TreeInstallStepState {
  match outcome {
    RunArgvTransportRefused { reason: r } => TreeStepFailed { step: step, reason: r }
    RunArgvTransportObserved { observed: o } =>
      if o.success { TreeStepsOk } else {
        TreeStepFailed { step: step, reason: join(["exit ", to_string(o.exit_code), ": ", o.stderr], "") }
      }
  }
}

fn tree_run_step(state: TreeInstallStepState, step: TreeInstallStep, command: ArgvCommand, transport: HostEffectElevationRoute) -> TreeInstallStepState {
  match state {
    TreeStepFailed { step: _, reason: _ } => state
    TreeStepsOk => tree_step_failure(step: step, outcome: run_argv_over_elevation_route(command: command, transport: transport))
  }
}

// The hashes of one subdirectory's regular files, as seen by `transport`, or the refusal that names why.
type TreeObservation
  = TreeObserved { entries: List<TreeFileHash> }
  | TreeObservationFailed { reason: String }

fn observe_tree_hashes(root: String, subs: List<String>, transport: HostEffectElevationRoute) -> TreeObservation {
  fold(subs, init: TreeObserved { entries: [] }, f: (acc, sub) =>
    match acc {
      TreeObservationFailed { reason: _ } => acc
      TreeObserved { entries: es } =>
        match run_argv_over_elevation_route(
          command: find_regular_files_sha256_command(root: join([root, "/", sub], "")),
          transport: transport,
        ) {
          RunArgvTransportRefused { reason: r } => TreeObservationFailed { reason: r }
          RunArgvTransportObserved { observed: o } =>
            if !o.success { TreeObservationFailed { reason: join(["find exit ", to_string(o.exit_code), ": ", o.stderr], "") } }
            else {
              let parsed = tree_file_hashes_of_stdout(stdout: o.stdout, root: join([root, "/", sub], ""), sub: sub)
              let lines = count(flat_map(split(s: o.stdout, delimiter: "\n"), l => if string_length(s: l) > 0 { [l] } else { [] }))
              if lines != count(parsed) {
                TreeObservationFailed { reason: join(["find|sha256sum under ", root, "/", sub, " printed ", to_string(lines), " lines but ", to_string(count(parsed)), " parsed as <hex>  <path under root>; a path with a newline or an unexpected line shape is refused, not dropped"], "") }
              } else { TreeObserved { entries: concat(es, parsed) } }
            }
        }
    }
  )
}

fn approval_broker_tree_install(
  owner: NonEmptyStr,
  base_root: String,
  source_root: String,
  revision: ReleaseRevisionBinding,
  executables: List<String>,
  transport: HostEffectElevationRoute,
) -> ApprovalBrokerTreeInstallVerdict {
  approval_broker_tree_install_at(
    owner: owner,
    spine: [base_root, release_locus_releases_dir(root: base_root)],
    locus: release_locus_dir(root: base_root, revision: revision),
    source_root: source_root,
    revision: revision,
    executables: executables,
    transport: transport,
  )
}

// THE SPINE IS EVERY DIRECTORY ABOVE THE LOCUS that must exist, parents first. The release locus and the helper snapshot differ only in that spine (the snapshot has no
// /releases/ segment), so one install serves both rather than a copy per locus.
fn approval_broker_tree_install_at(
  owner: NonEmptyStr,
  spine: List<String>,
  locus: String,
  source_root: String,
  revision: ReleaseRevisionBinding,
  executables: List<String>,
  transport: HostEffectElevationRoute,
) -> ApprovalBrokerTreeInstallVerdict {
  match revision {
    RevisionNotInstalled =>
      TreeInstallRefused { step: TreeStepRevision, reason: "the tree install was asked for RevisionNotInstalled; a release directory is named by the candidate sha" }
    RevisionBoundAtEmission { revision: r } => {
      match observe_tree_hashes(root: source_root, subs: release_locus_tree_subdirs, transport: transport) {
        TreeObservationFailed { reason: why } => TreeInstallRefused { step: TreeStepSourceObserve, reason: why }
        TreeObserved { entries: source } =>
          if count(source) == 0 {
            TreeInstallRefused { step: TreeStepSourceObserve, reason: join(["no regular file under ", source_root, " in ", join(release_locus_tree_subdirs, ", ")], "") }
          } else {
            approval_broker_tree_install_observed(
              owner: owner, spine: spine, source_root: source_root, locus: locus,
              revision: revision, source: sort_tree_file_hashes(entries: source), executables: executables, transport: transport,
            )
          }
      }
    }
  }
}

fn tree_install_directory_step(state: TreeInstallStepState, owner: NonEmptyStr, path: String, transport: HostEffectElevationRoute) -> TreeInstallStepState {
  tree_run_step(state: state, step: TreeStepInstallDirectory, transport: transport, command: sudo_elevate_command(
    command: coreutils_install_directory_owned_argv(mode: install_d_shared_mode, owner: owner, group: owner, path: path)))
}

// ONE READER FOR "the sha256 of a path, observed over a HostEffectTransport". The three ways it can
// be unobserved stay distinct: a refused transport, a run that failed, and a line carrying no digest.
type Sha256UnobservedCause
  = Sha256TransportRefused { reason: String }
  | Sha256RunFailed { stderr: String }
  | Sha256LineUnparsed { stdout: String }

type Sha256Observation
  = Sha256Observed { digest: Digest }
  | Sha256Unobserved { cause: Sha256UnobservedCause }

type Sha256Side = SourceSide | InstalledSide

type Sha256Agreement
  = Sha256Agrees
  | Sha256Differs
  | Sha256SideUnobserved { side: Sha256Side, cause: Sha256UnobservedCause }

fn sha256_observation_of_outcome(outcome: RunArgvTransportOutcome) -> Sha256Observation {
  match outcome {
    RunArgvTransportRefused { reason: r } => Sha256Unobserved { cause: Sha256TransportRefused { reason: r } }
    RunArgvTransportObserved { observed: o } =>
      if o.success == false {
        Sha256Unobserved { cause: Sha256RunFailed { stderr: o.stderr } }
      } else {
        match sha256sum_line_digest(line: o.stdout) {
          Absent => Sha256Unobserved { cause: Sha256LineUnparsed { stdout: o.stdout } }
          Present { value: d } => Sha256Observed { digest: d }
        }
      }
  }
}

fn observe_sha256_over_transport(path: String, transport: HostEffectTransport) -> Sha256Observation {
  sha256_observation_of_outcome(outcome: run_argv_over_host_effect_transport(command: sha256sum_file_command(path: path), transport: transport))
}

fn observe_sha256_over_route(path: String, transport: HostEffectElevationRoute) -> Sha256Observation {
  sha256_observation_of_outcome(outcome: run_argv_over_elevation_route(command: sha256sum_file_command(path: path), transport: transport))
}

fn sha256_unobserved_cause_text(cause: Sha256UnobservedCause) -> String {
  match cause {
    Sha256TransportRefused { reason: r } => r
    Sha256RunFailed { stderr: e } => e
    Sha256LineUnparsed { stdout: _ } => "sha256sum printed no 64-hex digest field"
  }
}

fn sha256_observations_agreement(source: Sha256Observation, installed: Sha256Observation) -> Sha256Agreement {
  match source {
    Sha256Unobserved { cause: c } => Sha256SideUnobserved { side: SourceSide, cause: c }
    Sha256Observed { digest: a } =>
      match installed {
        Sha256Unobserved { cause: c } => Sha256SideUnobserved { side: InstalledSide, cause: c }
        Sha256Observed { digest: b } => if (a.hex as String) == (b.hex as String) { Sha256Agrees } else { Sha256Differs }
      }
  }
}

// The binary is outside the dag/src-v2 tree walk, so it is read back on its own: both sums are
// observed through the transport and must be equal; an unobserved side is a disagreement naming its cause.
fn tree_binary_agreement(source_path: String, installed_path: String, transport: HostEffectElevationRoute) -> Sha256Agreement {
  sha256_observations_agreement(
    source: observe_sha256_over_route(path: source_path, transport: transport),
    installed: observe_sha256_over_route(path: installed_path, transport: transport))
}

fn sha256_side_text(side: Sha256Side) -> String {
  match side {
    SourceSide => "source"
    InstalledSide => "installed"
  }
}

fn sha256_disagreement_text(agreement: Sha256Agreement) -> String? {
  match agreement {
    Sha256Agrees => none
    Sha256Differs => Present { value: "the two sums differ" }
    Sha256SideUnobserved { side: s, cause: c } => Present { value: join([sha256_side_text(side: s), " sum unobserved: ", sha256_unobserved_cause_text(cause: c)], "") }
  }
}

// The first executable whose installed bytes disagree with the source, named; none when every member agrees.
fn tree_executables_disagreement(executables: List<String>, source_root: String, locus: String, transport: HostEffectElevationRoute) -> String? {
  fold(executables, init: none, f: (acc, name) =>
    match acc {
      Present { value: _ } => acc
      Absent =>
        match sha256_disagreement_text(agreement: tree_binary_agreement(
          source_path: join([cargo_default_release_dir(build_root: source_root), "/", name], ""),
          installed_path: join([locus, "/", name], ""),
          transport: transport)) {
          Present { value: why } => Present { value: join([name, ": ", why], "") }
          Absent => none
        }
    })
}

fn approval_broker_tree_install_observed(
  owner: NonEmptyStr,
  spine: List<String>,
  source_root: String,
  locus: String,
  revision: ReleaseRevisionBinding,
  source: List<TreeFileHash>,
  executables: List<String>,
  transport: HostEffectElevationRoute,
) -> ApprovalBrokerTreeInstallVerdict {
  let after_spine = fold(list_snoc_item(xs: spine, item: locus), init: TreeStepsOk, f: (st, d) => tree_install_directory_step(state: st, owner: owner, path: d, transport: transport))
  let after_dirs = fold(tree_ancestor_directories(files: source), init: after_spine, f: (st, d) =>
    tree_install_directory_step(state: st, owner: owner, path: join([locus, "/", d], ""), transport: transport))
  let after_files = fold(source, init: after_dirs, f: (st, e) =>
    tree_run_step(state: st, step: TreeStepInstallFile, transport: transport, command: sudo_elevate_command(
      command: coreutils_install_file_owned_argv(
        mode: install_file_shared_mode, owner: owner, group: owner,
        source: join([source_root, "/", e.path], ""), dest: join([locus, "/", e.path], "")))))
  let after_binary = fold(executables, init: after_files, f: (st, name) =>
    tree_run_step(state: st, step: TreeStepInstallBinary, transport: transport, command: sudo_elevate_command(
      command: coreutils_install_file_owned_argv(
        mode: install_executable_shared_mode, owner: owner, group: owner,
        source: join([cargo_default_release_dir(build_root: source_root), "/", name], ""),
        dest: join([locus, "/", name], "")))))
  match after_binary {
    TreeStepFailed { step: s, reason: why } => TreeInstallRefused { step: s, reason: why }
    TreeStepsOk =>
      match observe_tree_hashes(root: locus, subs: release_locus_tree_subdirs, transport: transport) {
        TreeObservationFailed { reason: why } => TreeInstallRefused { step: TreeStepReadback, reason: why }
        TreeObserved { entries: installed } =>
          match tree_executables_disagreement(executables: executables, source_root: source_root, locus: locus, transport: transport) {
            Present { value: why } =>
              TreeInstallRefused { step: TreeStepReadback, reason: join(["an installed binary under ", locus, " does not hash equal to its source binary (", why, "); no receipt was written"], "") }
            Absent =>
              if !tree_entries_agree(source: source, installed: installed) {
                TreeInstallRefused { step: TreeStepReadback, reason: join([
                  "the installed tree under ", locus, " does not match source_root: installed ", to_string(count(installed)),
                  " files, source ", to_string(count(source)), " (a differing file refuses; no receipt was written)"], "") }
              } else {
                approval_broker_tree_receipt_write(
                  owner: owner, locus: locus, revision: revision, lines: tree_hash_lines(entries: installed),
                  files: count(installed), transport: transport)
              }
          }
      }
  }
}

// THE RECEIPT, LAST: digest the verified lines through sha256sum (stdin, no argv payload), then write
// candidate_revision/installed_digest through install(1) from stdin as the locus owner.
fn approval_broker_tree_receipt_write(
  owner: NonEmptyStr,
  locus: String,
  revision: ReleaseRevisionBinding,
  lines: String,
  files: Int,
  transport: HostEffectElevationRoute,
) -> ApprovalBrokerTreeInstallVerdict {
  match run_argv_stdin_over_elevation_route(
    command: sha256sum_file_command(path: "/dev/stdin"),
    stdin_payload: lines,
    transport: transport,
  ) {
    RunArgvTransportRefused { reason: r } => TreeInstallRefused { step: TreeStepDigest, reason: r }
    RunArgvTransportObserved { observed: o } =>
      match (if o.success { sha256sum_line_digest(line: o.stdout) } else { none }) {
        Absent => TreeInstallRefused { step: TreeStepDigest, reason: join(["sha256sum of the tree lines failed: ", o.stderr], "") }
        Present { value: d } => {
          let digest = d.hex as String
          let body = join(["candidate_revision=", release_revision_execstart_text(binding: revision), "\ninstalled_digest=", digest, "\n"], "")
          match run_argv_stdin_over_elevation_route(
            command: sudo_elevate_command(command: coreutils_install_file_owned_argv(
              mode: install_file_shared_mode, owner: owner, group: owner,
              source: "/dev/stdin", dest: join([locus, "/", release_locus_tree_receipt_name], ""))),
            stdin_payload: body,
            transport: transport,
          ) {
            RunArgvTransportRefused { reason: r } => TreeInstallRefused { step: TreeStepReceipt, reason: r }
            RunArgvTransportObserved { observed: w } =>
              if w.success { TreeInstallConverged { installed_digest: digest, files_installed: files } }
              else { TreeInstallRefused { step: TreeStepReceipt, reason: join(["exit ", to_string(w.exit_code), ": ", w.stderr], "") } }
          }
        }
      }
  }
}

// ── THE APPROVAL BROKER DARK INSTALL, TYPED ───────────────────────────────────────────────────
// Stage 1 of the cutover: the broker's state directories (device store, JWKS cache), the broker's
// tree, slice and unit, a daemon-reload, enable + restart of ONLY the broker unit, and the
// slice-control caps. It touches gunbc-roadmap.service in no
// way: a daemon-reload does not restart running units, so the roadmap keeps its PID and incarnation.
//
// FAIL-FAST, ONE STEP AT A TIME. Each leg is an ArgvCommand run through
// run_argv_over_host_effect_transport -- no shell, no quoting, no script body -- and the first leg
// that refuses stops the line: DarkInstallRefused names the step and NO later leg runs. The retired
// script's refusals that survive the helper grant's removal (cb6548946213) are typed steps: a
// non-owning spec, an uncovered state-directory writer, a slice-control plan the host cannot derive.
// The root-owned snapshot steps (snapshot, readback, retire) are run by the apply's
// root-helper-snapshot leg (live_deploy_apply_root_helper_snapshot_on_host).
type DarkInstallStep
  = DarkStepOwner
  | DarkStepDeviceStore
  | DarkStepSnapshot
  | DarkStepSnapshotReadback
  | DarkStepRetire
  | DarkStepBrokerTree
  | DarkStepSidecarDigest
  | DarkStepSidecarEnv
  | DarkStepSidecarUnit
  | DarkStepSidecarDaemonReload
  | DarkStepSidecarEnable
  | DarkStepSidecarRestart
  | DarkStepSidecarReadback
  | DarkStepSliceUnit
  | DarkStepBrokerUnit
  | DarkStepDaemonReload
  | DarkStepEnable
  | DarkStepRestart
  | DarkStepSliceControl

type DarkInstallVerdict
  = DarkInstallConverged { broker_tree_digest: String }
  | DarkInstallRefused { step: DarkInstallStep, reason: String }

type DarkLeg
  = DarkLegArgv { step: DarkInstallStep, command: ArgvCommand }
  | DarkLegStdin { step: DarkInstallStep, command: ArgvCommand, payload: String }
  | DarkLegExpectEmpty { step: DarkInstallStep, command: ArgvCommand }

type DarkState
  = DarkOk
  | DarkFailed { step: DarkInstallStep, reason: String }

type DarkInstallInputs {
  spec: DeploymentSpec
  revision: ReleaseRevisionBinding
  principal: GroundedPosixPrincipal
  source_root: String
  transport: HostEffectTransport
}

fn dark_failed_of_outcome(step: DarkInstallStep, outcome: RunArgvTransportOutcome) -> DarkState {
  match outcome {
    RunArgvTransportRefused { reason: r } => DarkFailed { step: step, reason: r }
    RunArgvTransportObserved { observed: o } =>
      if o.success { DarkOk } else { DarkFailed { step: step, reason: join(["exit ", to_string(o.exit_code), ": ", o.stderr], "") } }
  }
}

// PURE STEPS OF dark_run_leg: what a leg's observed outcome becomes, separated from observing it so a
// claim can supply the outcome (dark_run_leg calls exactly these).
fn dark_expect_empty_state(step: DarkInstallStep, outcome: RunArgvTransportOutcome) -> DarkState {
  match outcome {
    RunArgvTransportRefused { reason: r } => DarkFailed { step: step, reason: r }
    RunArgvTransportObserved { observed: o } =>
      if !o.success { DarkFailed { step: step, reason: join(["exit ", to_string(o.exit_code), ": ", o.stderr], "") } }
      else if string_length(s: trim(s: o.stdout)) > 0 { DarkFailed { step: step, reason: join(["expected no output, got: ", o.stdout], "") } }
      else { DarkOk }
  }
}

fn dark_run_leg(state: DarkState, leg: DarkLeg, transport: HostEffectTransport) -> DarkState {
  match state {
    DarkFailed { step: _, reason: _ } => state
    DarkOk =>
      match leg {
        DarkLegArgv { step: s, command: c } =>
          dark_failed_of_outcome(step: s, outcome: run_argv_over_host_effect_transport(command: c, transport: transport))
        DarkLegStdin { step: s, command: c, payload: p } =>
          dark_failed_of_outcome(step: s, outcome: run_argv_stdin_over_host_effect_transport(command: c, stdin_payload: p, transport: transport))
        DarkLegExpectEmpty { step: s, command: c } =>
          dark_expect_empty_state(step: s, outcome: run_argv_over_host_effect_transport(command: c, transport: transport))
      }
  }
}

fn dark_run_legs(legs: List<DarkLeg>, transport: HostEffectTransport) -> DarkState {
  fold(legs, init: DarkOk, f: (st, leg) => dark_run_leg(state: st, leg: leg, transport: transport))
}

fn tree_install_step_name(step: TreeInstallStep) -> String {
  match step {
    TreeStepRevision => "revision"
    TreeStepSourceObserve => "source-observe"
    TreeStepInstallDirectory => "install-directory"
    TreeStepInstallFile => "install-file"
    TreeStepInstallBinary => "install-binary"
    TreeStepReadback => "readback"
    TreeStepDigest => "digest"
    TreeStepReceipt => "receipt"
  }
}

fn dark_snapshot_readback_legs_at(locus: HelperLocus, dir: String) -> List<DarkLeg> {
  let root = locus.owner as String
  [
    DarkLegExpectEmpty {
      step: DarkStepSnapshotReadback,
      command: find_untrusted_entries_command(roots: path_ancestors_inclusive(path: locus.base), top_only: true, owner: root),
    },
    DarkLegExpectEmpty {
      step: DarkStepSnapshotReadback,
      command: find_untrusted_entries_command(roots: [dir], top_only: false, owner: root),
    },
  ]
}

fn dark_unit_install_leg(step: DarkInstallStep, dest: String, text: String) -> DarkLeg {
  DarkLegStdin {
    step: step,
    command: sudo_elevate_command(command: coreutils_install_file_owned_argv(
      mode: install_file_shared_mode,
      owner: approval_broker_helper_root_principal, group: approval_broker_helper_root_principal,
      source: "/dev/stdin", dest: dest)),
    payload: text,
  }
}

fn dark_unit_legs(spec: DeploymentSpec, revision: ReleaseRevisionBinding) -> List<DarkLeg> {
  let unit = gunbc_approval_broker_unit_name
  [
    dark_unit_install_leg(
      step: DarkStepSliceUnit, dest: gunbc_approval_broker_slice_unit_path() as String,
      text: serialize_systemd_unit_file(file: approval_broker_slice_unit_file())),
    dark_unit_install_leg(
      step: DarkStepBrokerUnit, dest: gunbc_approval_broker_unit_path() as String,
      text: serialize_systemd_unit_file(file: live_deploy_approval_broker_unit_file_on(spec: spec, revision: revision, port: spec.approval_broker.listen.port))),
    DarkLegArgv { step: DarkStepDaemonReload, command: extdeps.systemd.systemctl.systemctl_daemon_reload_command() },
    DarkLegArgv { step: DarkStepEnable, command: sudo_elevate_command(command: systemctl_enable_argv(unit: unit)) },
    DarkLegArgv { step: DarkStepRestart, command: sudo_elevate_command(command: systemctl_restart_argv(unit: unit)) },
  ]
}

fn dark_slice_control_legs(units: FreeSemigroup<SliceControlUnit>) -> List<DarkLeg> {
  flat_map(non_empty_to_list(xs: units), u =>
    list_map(xs: slice_control_converge_argvs_for_unit(u: u), f: argv =>
      DarkLegArgv { step: DarkStepSliceControl, command: sudo_elevate_command(command: argv) }))
}

fn approval_broker_dark_install(
  spec: DeploymentSpec,
  revision: ReleaseRevisionBinding,
  principal: GroundedPosixPrincipal,
  source_root: String,
  transport: HostEffectTransport,
) -> DarkInstallVerdict {
  if !deployment_owns_the_host_approval_broker(spec: spec) {
    DarkInstallRefused {
      step: DarkStepOwner,
      reason: join(["the dark install was reached with a deployment that does not own this host's broker unit; gunbc-approval-broker.service is a host singleton owned by the spec holding the prod role. instance=", spec.instance_id as String], ""),
    }
  } else {
    match dark_state_directories_install(i: DarkInstallInputs { spec: spec, revision: revision, principal: principal, source_root: source_root, transport: transport }) {
      DarkFailed { step: s, reason: r } => DarkInstallRefused { step: s, reason: r }
      DarkOk => dark_stage_broker_tree(i: DarkInstallInputs { spec: spec, revision: revision, principal: principal, source_root: source_root, transport: transport })
    }
  }
}

// ONE CENSUS ROW AS ITS CONVERGING LEG: `sudo install -d -m <derived> -o <owner> -g <group> <path>` —
// the same single-step ownership install as before, spelled from the row's own declaration (mode derived
// by gunbc.managed_directory managed_directory_permissions, never a literal). Pure, like dark_unit_legs:
// the witness can name the emitted leg without running a transport, which is what makes the census's
// contents a CLAIM rather than a hope.
fn dark_state_directory_leg(d: ManagedDirectory) -> DarkLeg {
  DarkLegArgv {
    step: DarkStepDeviceStore,
    command: sudo_elevate_command(command: broker_state_directory_install_argv(d: d)),
  }
}

// THE EMITTED STATE-DIRECTORY LEGS FOR A SET OF CENSUS ROWS, in census order. THE POSITIVE CONTROL:
// called with the census (dark_state_directory_legs below), this list carries the assertion-counter
// root's argv — delete a row from gunbc.auth.approval_broker_state_directories
// approval_broker_state_directories and the dark-install witness's claim over this list fails.
fn dark_state_directory_legs_for(directories: List<ManagedDirectory>) -> List<DarkLeg> {
  list_map(xs: directories, f: fn(d) { dark_state_directory_leg(d: d) })
}

// THE EMITTED STATE-DIRECTORY LEGS, at the census.
fn dark_state_directory_legs() -> List<DarkLeg> {
  dark_state_directory_legs_for(directories: approval_broker_state_directories())
}

// ONE ADMIT STEP: refuse on the first row whose dependents fail to cover their writes
// (gunbc.managed_directory managed_directory_admit); carry any earlier refusal forward unchanged.
fn dark_state_directory_admit_step(st: DarkState, d: ManagedDirectory) -> DarkState {
  match st {
    DarkFailed { step: s, reason: r } => DarkFailed { step: s, reason: r }
    DarkOk => match managed_directory_admit(d: d) {
      ManagedDirectoryRefused { member: m, path: p, writer: w } =>
        DarkFailed { step: DarkStepDeviceStore, reason: join([m as String, " writer uncovered path=", p as String, " writer=", w as String], "") }
      ManagedDirectoryAdmitted { dir: _ } => DarkOk
    }
  }
}

// THE GATE RUNS BEFORE ANY MUTATION: every census row must admit (no uncovered writer) BEFORE a single
// install -d touches the host. The fold this replaces admitted lazily per row, so a malformed row FIVE
// refused AFTER rows one through four had already mutated the host; fail-closed means nothing is written
// when the plan is bad.
fn dark_state_directories_admit(directories: List<ManagedDirectory>) -> DarkState {
  fold(directories, init: DarkOk, f: (st, d) => dark_state_directory_admit_step(st: st, d: d))
}

// THE BROKER'S STATE DIRECTORIES: EVERY root the census (gunbc.auth.approval_broker_state_directories
// approval_broker_state_directories) declares, each converged to its managed declaration (owner, group,
// derived mode) before the broker's tree is staged. DESIGN 6b root generalization: this was a nested
// match over the device store and the JWKS cache — two roots named by hand — and the assertion-counter
// root 503'd on srv1 for exactly that reason: a new state root could only be provisioned by editing a
// branch here, and nobody edited one. A root now joins by being a row of the census; the fold is the
// only shape, and `install -d` Noops on a directory that already stands at its declaration (the srv1
// counter root the operator created by hand converges as a no-op, not a fight).
fn dark_state_directories_install(i: DarkInstallInputs) -> DarkState {
  let directories = approval_broker_state_directories()
  match dark_state_directories_admit(directories: directories) {
    DarkFailed { step: s, reason: r } => DarkFailed { step: s, reason: r }
    DarkOk => dark_run_legs(legs: dark_state_directory_legs_for(directories: directories), transport: i.transport)
  }
}

fn dark_helper_snapshot_at(locus: HelperLocus, spine: List<String>, revision: ReleaseRevisionBinding, source_root: String, transport: HostEffectTransport) -> DarkState {
  let dir = helper_locus_dir(locus: locus, revision: revision)
  match dark_run_leg(state: DarkOk, transport: transport, leg: DarkLegArgv {
    step: DarkStepSnapshot,
    command: sudo_elevate_command(command: coreutils_rm_force_recursive_argv(path: dir)),
  }) {
    DarkFailed { step: s, reason: r } => DarkFailed { step: s, reason: r }
    DarkOk =>
      match approval_broker_tree_install_at(
        owner: locus.owner,
        spine: spine,
        locus: dir,
        source_root: source_root,
        revision: revision,
        executables: [gunbc_release_bin_name],
        transport: one_transport_route(transport: transport),
      ) {
        TreeInstallRefused { step: ts, reason: r } =>
          DarkFailed { step: DarkStepSnapshot, reason: join(["tree step ", tree_install_step_name(step: ts), ": ", r], "") }
        TreeInstallConverged { installed_digest: _, files_installed: _ } =>
          dark_run_legs(legs: dark_snapshot_readback_legs_at(locus: locus, dir: dir), transport: transport)
      }
  }
}

// The previous release's snapshot is removed once the units that name the new one stand: the sweep is
// confined to the root-owned base and keeps exactly this release's directory.
fn dark_helper_retire_at(locus: HelperLocus, revision: ReleaseRevisionBinding, transport: HostEffectTransport) -> DarkState {
  dark_run_leg(state: DarkOk, transport: transport, leg: DarkLegArgv {
    step: DarkStepRetire,
    command: find_other_children_exec_command(
      root: locus.base,
      keep_name: release_revision_execstart_text(binding: revision),
      exec_argv: sudo_elevate_argv(command: [fleet_rm_binary_path as String, coreutils_rm_force_recursive_flags as String, "--"]),
    ),
  })
}

// THE SIDECAR IS STANDING BEFORE THE BROKER UNIT IS SWAPPED. The broker unit loads the sidecar's digest env file and is
// ordered after the sidecar unit, so a swap that precedes them leaves systemd unable to start it (run 39545280023: the
// locus held only the gunbc binary and the restart failed with "Failed to load environment files"). The order is
// therefore: locus members installed (approval_broker_release_locus_executables) -> digest read off the INSTALLED
// sidecar binary -> env file -> sidecar unit -> reload -> sidecar enable + restart -> readback against the digest ->
// only then the broker's own unit legs. Any refusal before the broker legs leaves the broker running its previous
// release; the sidecar is the only unit touched by then.
fn dark_sidecar_legs(spec: DeploymentSpec, revision: ReleaseRevisionBinding, digest: String) -> List<DarkLeg> {
  let owner = spec.approval_broker.service_user
  let unit = gunbc_device_crypto_sidecar_unit_name
  [
    DarkLegStdin {
      step: DarkStepSidecarEnv,
      command: sudo_elevate_command(command: coreutils_install_file_owned_argv(
        mode: install_file_shared_mode, owner: owner, group: owner, source: "/dev/stdin",
        dest: device_crypto_deployed_digest_env_file_path(root: spec.approval_broker.repo_root as String, revision: revision))),
      payload: join([approval_device_crypto_deployed_digest_env_name as String, "=", digest, "\n"], ""),
    },
    dark_unit_install_leg(
      step: DarkStepSidecarUnit, dest: gunbc_device_crypto_sidecar_unit_path() as String,
      text: serialize_systemd_unit_file(file: live_deploy_device_crypto_sidecar_unit_file(spec: spec, revision: revision))),
    DarkLegArgv { step: DarkStepSidecarDaemonReload, command: extdeps.systemd.systemctl.systemctl_daemon_reload_command() },
    DarkLegArgv { step: DarkStepSidecarEnable, command: sudo_elevate_command(command: systemctl_enable_argv(unit: unit)) },
    DarkLegArgv { step: DarkStepSidecarRestart, command: sudo_elevate_command(command: systemctl_restart_argv(unit: unit)) },
  ]
}

fn dark_stage_broker_tree(i: DarkInstallInputs) -> DarkInstallVerdict {
  match approval_broker_tree_install(
    owner: i.spec.service.service_user,
    base_root: i.spec.approval_broker.repo_root as String,
    source_root: i.source_root,
    revision: i.revision,
    executables: approval_broker_release_locus_executables,
    transport: one_transport_route(transport: i.transport),
  ) {
    TreeInstallRefused { step: ts, reason: r } =>
      DarkInstallRefused { step: DarkStepBrokerTree, reason: join(["tree step ", tree_install_step_name(step: ts), ": ", r], "") }
    TreeInstallConverged { installed_digest: d, files_installed: _ } => dark_stage_sidecar_digest(i: i, tree_digest: d)
  }
}

// THE LOCUS MUST HOLD THE SIDECAR: an installed locus whose sidecar binary cannot be digested refuses here, before any sidecar or broker leg runs.
fn dark_stage_sidecar_digest(i: DarkInstallInputs, tree_digest: String) -> DarkInstallVerdict {
  match observe_sha256_over_transport(path: device_crypto_sidecar_binary_path(spec: i.spec, revision: i.revision), transport: i.transport) {
    Sha256Unobserved { cause: c } =>
      DarkInstallRefused { step: DarkStepSidecarDigest, reason: join(["the installed sidecar binary could not be digested: ", sha256_unobserved_cause_text(cause: c)], "") }
    Sha256Observed { digest: sd } => dark_stage_sidecar(i: i, tree_digest: tree_digest, deployed: sd.hex as String)
  }
}

fn dark_stage_sidecar(i: DarkInstallInputs, tree_digest: String, deployed: String) -> DarkInstallVerdict {
  match dark_run_legs(legs: dark_sidecar_legs(spec: i.spec, revision: i.revision, digest: deployed), transport: i.transport) {
    DarkFailed { step: s, reason: r } => DarkInstallRefused { step: s, reason: r }
    DarkOk =>
      match i.transport {
        LocalShell => dark_stage_sidecar_readback(i: i, tree_digest: tree_digest, deployed: deployed)
        SshShell { ssh_host: _ } => dark_sidecar_readback_not_local()
        FleetSsh { target: _, context: _ } => dark_sidecar_readback_not_local()
        EmitArtifactThenThinRun { bootstrap: _, invocation: _ } => dark_sidecar_readback_not_local()
      }
  }
}

// THE READBACK PROBES THE EVALUATOR'S LOOPBACK (approval_device_crypto_sidecar_endpoint): over any transport that is not the host itself it would read a different sidecar, so it refuses.
fn dark_sidecar_readback_not_local() -> DarkInstallVerdict {
  DarkInstallRefused { step: DarkStepSidecarReadback, reason: "the sidecar readback reaches the evaluator's loopback, not the install target; it runs only over LocalShell, so the broker is not swapped" }
}

fn dark_stage_sidecar_readback(i: DarkInstallInputs, tree_digest: String, deployed: String) -> DarkInstallVerdict {
      match device_crypto_readback_expectation(gate: device_crypto_gate(r: approval_device_crypto_realization), deployed_digest: deployed as NonEmptyStr) {
        Absent => DarkInstallRefused { step: DarkStepSidecarReadback, reason: "the broker's own device-crypto realization is not bound, so it would answer 503 on every device route" }
        Present { value: expectation } =>
          match device_crypto_sidecar_readback(expectation: expectation) {
            SidecarReplied { answer: _, admission: _ } => dark_stage_broker_unit(i: i, tree_digest: tree_digest)
            SidecarReplyFailed { cause: c } =>
              DarkInstallRefused { step: DarkStepSidecarReadback, reason: join(["the running sidecar does not join the installed binary: ", c as String], "") }
          }
      }
}

fn dark_stage_broker_unit(i: DarkInstallInputs, tree_digest: String) -> DarkInstallVerdict {
  match dark_run_legs(legs: dark_unit_legs(spec: i.spec, revision: i.revision), transport: i.transport) {
    DarkFailed { step: s, reason: r } => DarkInstallRefused { step: s, reason: r }
    DarkOk => dark_stage_slice_control(i: i, digest: tree_digest)
  }
}

fn dark_stage_slice_control(i: DarkInstallInputs, digest: String) -> DarkInstallVerdict {
  match slice_control_plan_for(host: i.spec.target.host.identity) {
    SliceControlPlanNotOwed => DarkInstallConverged { broker_tree_digest: digest }
    SliceControlPlanRefused { cause: c } => DarkInstallRefused { step: DarkStepSliceControl, reason: c }
    SliceControlPlanDerived { units: us } =>
      match dark_run_legs(legs: dark_slice_control_legs(units: us), transport: i.transport) {
        DarkOk => DarkInstallConverged { broker_tree_digest: digest }
        DarkFailed { step: s, reason: r } => DarkInstallRefused { step: s, reason: r }
      }
  }
}

fn dark_install_step_name(step: DarkInstallStep) -> String {
  match step {
    DarkStepOwner => "owner"
    DarkStepDeviceStore => "device-store"
    DarkStepSnapshot => "helper-snapshot"
    DarkStepSnapshotReadback => "helper-snapshot-readback"
    DarkStepRetire => "helper-snapshot-retire"
    DarkStepBrokerTree => "broker-tree"
    DarkStepSidecarDigest => "sidecar-digest"
    DarkStepSidecarEnv => "sidecar-digest-env"
    DarkStepSidecarUnit => "sidecar-unit"
    DarkStepSidecarDaemonReload => "sidecar-daemon-reload"
    DarkStepSidecarEnable => "sidecar-enable"
    DarkStepSidecarRestart => "sidecar-restart"
    DarkStepSidecarReadback => "sidecar-readback"
    DarkStepSliceUnit => "broker-slice-unit"
    DarkStepBrokerUnit => "broker-unit"
    DarkStepDaemonReload => "daemon-reload"
    DarkStepEnable => "enable"
    DarkStepRestart => "restart"
    DarkStepSliceControl => "slice-control"
  }
}

fn realize_approval_broker_dark_install_on_host(
  spec: DeploymentSpec,
  candidate: CandidateRelease,
  transport: HostEffectTransport,
  intent: HostEffectIntent,
  access: DeployAccess,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match approval_broker_dark_install(
    spec: spec,
    revision: RevisionBoundAtEmission { revision: candidate.revision },
    principal: access.principal,
    source_root: git.Inspect.Toplevel().path as String,
    transport: transport,
  ) {
    DarkInstallRefused { step: s, reason: r } =>
      NotConverged {
        reason: join(["approval broker dark install refused at step ", dark_install_step_name(step: s), ": ", r], ""),
        applied: intent,
      }
    DarkInstallConverged { broker_tree_digest: d } =>
      Converged {
        evidence: ShellEffectApplied { exit_code: 0, stdout: join(["broker_tree_digest=", d, "\n"], ""), stderr: "" },
        applied: intent,
      }
  }
}

// THE STANDING GUARD: a dependency ensure is a dpkg -s probe whose exit status decides a package
// install; it is NOT a script body. The package leg is the probe-then-conditional-install tree
// the old `ensure_apt_package_step` rendered (probe `dpkg -s`; install only when the probe fails)
// and the marker leg is a staged write plus a mode/owner/group install -- that is the
// realisation, so this arm carries those as typed operations over the transport instead of
// shipping concat-built bash. No RetainedShellScript row is minted here.
//
// WHY A TYPED ARGV ROUTE AND NOT THE OLD CONCAT BODY. The bash the old builder emitted could not
// run on this route at all: its write leg wrote into `$_gunbc_stage`, a variable the bulk-apply
// frame binds with `mktemp -d` and this standalone route never does -- under the frame's `set -u`
// it was an unbound-variable abort waiting to happen. The typed shape below acquires its scratch
// the way that frame did: a process-owned `mktemp -d` directory (mode 0700), its answer
// validated by admitted_scratch_path. That ownership is why the write runs UNELEVATED there
// while only the install into the control directory elevates. Elevation, the package name, the
// marker path/mode/owner/group and the scratch prefix ride as PARAMETERS through extdeps builders
// (probe and install are the extdeps.package_managers builders beside their Operation rows);
// nothing policy-shaped is an argv literal here. TOTAL over dep.subject: both arms answer, no
// silent default.
fn realize_live_deploy_ensure_dependency_on_host(
  dep: DeploymentDependencyStep,
  transport: HostEffectTransport,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match dep.subject {
    EnsuredPackage { package: pkg } =>
      live_deploy_ensure_package_leg(package: pkg, transport: transport, intent: intent)
    EnsuredOwnershipMarker { marker: marker } =>
      live_deploy_ensure_ownership_marker_leg(marker: marker, transport: transport, intent: intent)
  }
}

// THE PROBE-THEN-INSTALL FOLD, over outcomes the legs already ran -- witness-dry by the same
// split the compile-pool install fold documents above. THE DECISION IS THE DPKG MODULE'S OWN
// VERDICT PROCEDURE, NOT AN EXIT-CODE READ: extdeps.package_managers.dpkg declares beside its
// Status row that the probe exits zero for ANY package the database has a record for -- including
// one REMOVED with configuration files kept -- so exit status cannot answer "installed"
// (dpkg.dag's own comment), and `if ! dpkg -s` was reading it wrong. The fold asks
// dpkg_query_status_verdict_of (the module's single answer for that fact; DESIGN §3 "each fact
// lives in exactly one place"): Installed CONVERGES with no install run -- that non-run is the
// idempotence evidence, the probe's own observation, not a replay; NotInstalled and Unknown
// (absent from the database) take the install arm, which decides; Undecidable REFUSES the route
// rather than authorizing an install on nothing established -- a wrong answer is a loud error
// (DESIGN §5), and "Undecidable is never read as absent" is the module's rule. A refused
// operation never started a process, so it is never reported with an exit status and never
// laundered into success: the old `|| exit` after apt-get meant non-zero stops the stage, and
// refusal is the stronger stop.
fn live_deploy_ensure_package_fold(
  package: NonEmptyStr,
  probe: RunArgvTransportOutcome,
  install: RunArgvTransportOutcome,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match probe {
    RunArgvTransportRefused { reason: r } =>
      NotConverged {
        reason: join(
          [
            "host_effect_apply: live-deploy ensure-dependency refused before the install-state probe for package ",
            package as String,
            " ran -- ",
            r,
            "; the install was not attempted either, and neither leg is reported as having run.",
          ],
          "",
        ),
        applied: intent,
      }
    RunArgvTransportObserved { observed: p } =>
      match dpkg_query_status_verdict_of(exit_code: p.exit_code, stdout: p.stdout, stderr: p.stderr) {
        DpkgPackageInstalled =>
          Converged { evidence: ShellEffectApplied { exit_code: p.exit_code, stdout: p.stdout, stderr: p.stderr }, applied: intent }
        DpkgPackageUnknown =>
          live_deploy_ensure_install_fold(package: package, install: install, intent: intent)
        DpkgPackageNotInstalled { status: _ } =>
          live_deploy_ensure_install_fold(package: package, install: install, intent: intent)
        DpkgQueryUndecidable { reason: why } =>
          NotConverged {
            reason: join(
              [
                "host_effect_apply: live-deploy ensure-dependency refused on the probe of package ",
                package as String,
                " because its state could not be read -- ",
                why,
                "; an unreadable state is never read as absent (absent would authorize an install and nothing was established), so the install was not attempted.",
              ],
              "",
            ),
            applied: intent,
          }
      }
  }
}

// THE INSTALL ARM OF THE PACKAGE FOLD: the install's own outcome decides, reported as the install's
// observation. Shared by the verdict's NotInstalled and Unknown answers -- unknown (no record at all)
// is absent, and absent authorizes the install; the leg ran it only for those two answers.
fn live_deploy_ensure_install_fold(
  package: NonEmptyStr,
  install: RunArgvTransportOutcome,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match install {
    RunArgvTransportObserved { observed: i } =>
      if i.exit_code == 0 {
        Converged { evidence: ShellEffectApplied { exit_code: i.exit_code, stdout: i.stdout, stderr: i.stderr }, applied: intent }
      } else {
        NotConverged {
          reason: live_deploy_ensure_step_failure_line(step: "apt-get install", subject: package as String, outcome: install),
          applied: intent,
        }
      }
    RunArgvTransportRefused { reason: _ } =>
      NotConverged {
        reason: live_deploy_ensure_step_failure_line(step: "apt-get install", subject: package as String, outcome: install),
        applied: intent,
      }
  }
}

// THE PACKAGE LEG: probe, and install only when the probe does not answer installed. Both legs
// run UNELEVATED, exactly where the old script ran them -- `ensure_apt_package_step` rendered its
// unelevated form on this route (privileged: false from the old
// `deployment_ensure_dependency_intent`) -- and the elevation question stays with the caller of
// an install op rather than being decided inside an upstream's spelling of its own command.
fn live_deploy_ensure_package_leg(
  package: NonEmptyStr,
  transport: HostEffectTransport,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  // THE PROBE IS THE DPKG MODULE'S OWN QUERY, the builder already PAIRED with the verdict
    // procedure below (dpkg_query_status_command runs the Query row's `dpkg-query -s` and its
    // comment names the verdict as its consumer). Minting a second probe command beside it -- even
    // one derived from this module's Status row -- would be two builders with different program
    // words for one fact, joined only by the unmodelled accident that `dpkg -s` forwards to
    // `dpkg-query -s` (DESIGN §3: each fact lives in exactly one place; the Status row's own
    // comment says its exit-success reading cannot answer "installed"). The command builds
    // unconditionally, so no build-refusal arm exists; a transport refusal still arrives from the
    // run itself.
    let probe_command = dpkg_query_status_command(package: package)
    match run_argv_over_host_effect_transport(command: probe_command, transport: transport) {
        RunArgvTransportRefused { reason: r } =>
          live_deploy_ensure_package_fold(
            package: package,
            probe: RunArgvTransportRefused { reason: r },
            install: live_deploy_leg_not_run_outcome(),
            intent: intent,
          )
        RunArgvTransportObserved { observed: p } =>
          // The SAME verdict procedure the fold reads decides whether to run the install at all --
          // one decision procedure, consulted where the effect actually launches (DESIGN §3). An
          // installed answer means nothing more runs; an UNREADABLE answer means the install must
          // not run either (refuse rather than install on nothing established); only absent (not
          // installed, or unknown to the database) launches it.
          match dpkg_query_status_verdict_of(exit_code: p.exit_code, stdout: p.stdout, stderr: p.stderr) {
            DpkgPackageInstalled =>
              live_deploy_ensure_package_fold(
                package: package,
                probe: RunArgvTransportObserved { observed: p },
                install: live_deploy_leg_not_run_outcome(),
                intent: intent,
              )
            DpkgQueryUndecidable { reason: _ } =>
              live_deploy_ensure_package_fold(
                package: package,
                probe: RunArgvTransportObserved { observed: p },
                install: live_deploy_leg_not_run_outcome(),
                intent: intent,
              )
            DpkgPackageUnknown =>
              live_deploy_ensure_install_leg(package: package, probe: p, transport: transport, intent: intent)
            DpkgPackageNotInstalled { status: _ } =>
              live_deploy_ensure_install_leg(package: package, probe: p, transport: transport, intent: intent)
          }
      }
}

// THE INSTALL LAUNCH, shared by the verdict's two absent answers. A row that will not materialize
// is a refusal carried to the fold typed, never a silently skipped leg.
// An outcome for a leg that did not run. It is a Refused, because nothing ran and Refused is the
// only arm that does not claim an observation: a refusal never started a process and this must
// not be able to masquerade as either. The folds only consult it on paths that report it as
// "did not run".
fn live_deploy_ensure_install_leg(
  package: NonEmptyStr,
  probe: ShellExecObserved,
  transport: HostEffectTransport,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match apt_get_install_command(package: package) {
    AptGetInstallCommandRefused { cause: cause } =>
      live_deploy_ensure_package_fold(
        package: package,
        probe: RunArgvTransportObserved { observed: probe },
        install: RunArgvTransportRefused {
          reason: concat("the install command could not be built from the apt.PackageManager Install row: ", cause),
        },
        intent: intent,
      )
    AptGetInstallCommandReady { command: install_command } =>
      live_deploy_ensure_package_fold(
        package: package,
        probe: RunArgvTransportObserved { observed: probe },
        install: run_argv_over_host_effect_transport(command: install_command, transport: transport),
        intent: intent,
      )
  }
}

fn live_deploy_leg_not_run_outcome() -> RunArgvTransportOutcome {
  RunArgvTransportRefused { reason: "not attempted: an earlier leg decided this route's outcome before this leg" }
}

// THE MARKER FOLD over [scratch acquisition, staged write, elevated install, discard]. Scratch
// acquisition is special: refused OR an answer admitted_scratch_path will not validate means
// NOTHING ran, so nothing needs discarding and the refusal line says so. A failed write or a
// failed install has ALREADY had its discard run by the leg before this fold is called
// (cleanup-before-report, the compile-pool install fold's discipline), so the fold only reports
// both lines. The discard is best-effort on the success path and its outcome is reported either
// way -- the old script's EXIT-trap `rm -rf` was equally unconditional, and a swallowed failed
// cleanup is how a scratch directory becomes a forensic artifact.
fn live_deploy_ensure_ownership_marker_fold(
  marker: FabricStorageOwnershipMarkerSpec,
  scratch: RunArgvTransportOutcome,
  written: RunArgvTransportOutcome,
  installed: RunArgvTransportOutcome,
  discarded: RunArgvTransportOutcome,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match live_deploy_ensure_scratch_dir(outcome: scratch) {
    Absent =>
      NotConverged {
        reason: live_deploy_ensure_scratch_refusal_line(outcome: scratch),
        applied: intent,
      }
    Present { value: _ } =>
      if !run_argv_transport_succeeded(outcome: written) {
        NotConverged {
          reason: join(
            [
              live_deploy_ensure_step_failure_line(step: "stage write", subject: marker.path as String, outcome: written),
              live_deploy_ensure_discard_line(outcome: discarded),
            ],
            "",
          ),
          applied: intent,
        }
      } else if !run_argv_transport_succeeded(outcome: installed) {
        NotConverged {
          reason: join(
            [
              live_deploy_ensure_step_failure_line(step: "install", subject: marker.path as String, outcome: installed),
              live_deploy_ensure_discard_line(outcome: discarded),
            ],
            "",
          ),
          applied: intent,
        }
      } else {
        Converged {
          evidence: ShellEffectApplied {
            exit_code: 0,
            stdout: join(
              [
                "LiveDeployEnsureDependencyReceipt: marker installed at ",
                marker.path as String,
                "; ",
                live_deploy_ensure_discard_line(outcome: discarded),
              ],
              "",
            ),
            stderr: installed_stderr(installed: installed),
          },
          applied: intent,
        }
      }
  }
}

// THE MARKER LEG. Three facts the shape has to keep. (1) The write is UNELEVATED because the
// scratch directory is process-owned -- mode 0700 mktemp, the same reason the old script could
// write its staged file unelevated inside the bulk-apply frame's scratch. (2) Only the install
// into the control directory elevates, and it elevates as a SUDO INSTALL, because the ci-runner
// sudoers vocabulary (fleet_posix_accounts.dag) is a closed coproduct with no dd arm -- an
// elevated write would come back "command not allowed" and the route would always refuse.
// install(1) rather than mv because owner-at-creation means the wrongly-owned intermediate state
// has no moment in which to exist. (3) The marker bytes cross as STDIN DATA to dd (of= truncates
// and overwrites; status=none keeps dd's statistics out of the command log; tee is refused for
// the reason recorded at gunbc.typed_remote_file_write -- it echoes the bytes into their own
// log). The discard rm runs unelevated for the ownership reason of (1).
//
// THE PLAN IS BUILT BY A PURE FUNCTION below from the admitted scratch directory, so the witness
// can pin the route's whole argv surface -- which leg is elevated, what the install carries, what
// crosses as stdin -- without executing anything (the compile-pool split at
// compile_pool_slice_install_staging is the precedent for the shape).
type LiveDeployEnsureMarkerPlan
  = LiveDeployEnsureMarkerReady { stage_write: ArgvCommand, install: ArgvCommand, discard: ArgvCommand }

fn live_deploy_ensure_ownership_marker_plan(
  scratch_dir: String,
  marker: FabricStorageOwnershipMarkerSpec,
) -> LiveDeployEnsureMarkerPlan {
  let staged = concat(scratch_dir, "/store-ownership-marker")
  LiveDeployEnsureMarkerReady {
    stage_write: dd_overwrite_path_command(path: staged),
    install: sudo_elevate_command(
      command: coreutils_install_file_owned_argv(
        mode: live_deploy_ensure_marker_mode_text(mode: marker.mode),
        owner: marker.owner,
        group: marker.group,
        source: staged,
        dest: marker.path as String,
      )
    ),
    discard: rm_recursive_force_one_file_system_command(path: scratch_dir),
  }
}

fn live_deploy_ensure_ownership_marker_leg(
  marker: FabricStorageOwnershipMarkerSpec,
  transport: HostEffectTransport,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let acquired = run_argv_over_host_effect_transport(command: mktemp_directory_command(template: live_deploy_ensure_stage_template), transport: transport)
  match live_deploy_ensure_scratch_dir(outcome: acquired) {
    Absent =>
      live_deploy_ensure_ownership_marker_fold(
        marker: marker,
        scratch: acquired,
        written: live_deploy_leg_not_run_outcome(),
        installed: live_deploy_leg_not_run_outcome(),
        discarded: live_deploy_leg_not_run_outcome(),
        intent: intent,
      )
    Present { value: scratch_dir } => {
      let plan = live_deploy_ensure_ownership_marker_plan(scratch_dir: scratch_dir, marker: marker)
      let written = run_argv_stdin_over_host_effect_transport(
        command: plan.stage_write,
        stdin_payload: marker.content as String,
        transport: transport,
      )
      if !run_argv_transport_succeeded(outcome: written) {
        let discarded = run_argv_over_host_effect_transport(command: plan.discard, transport: transport)
        live_deploy_ensure_ownership_marker_fold(
          marker: marker,
          scratch: acquired,
          written: written,
          installed: live_deploy_leg_not_run_outcome(),
          discarded: discarded,
          intent: intent,
        )
      } else {
        let installed = run_argv_over_host_effect_transport(command: plan.install, transport: transport)
        let discarded = run_argv_over_host_effect_transport(command: plan.discard, transport: transport)
        live_deploy_ensure_ownership_marker_fold(
          marker: marker,
          scratch: acquired,
          written: written,
          installed: installed,
          discarded: discarded,
          intent: intent,
        )
      }
    }
  }
}

// THE SCRATCH PREFIX + TEMPLATE, in the convention install_media_remaster_work_prefix uses: a
// `data` prefix and an X-tailed template, so admitted_scratch_path's prefix test has something
// to admit and mktemp(1) has something to make unique. The prefix names the route, which is what
// makes a stray scratch directory attributable to it.
data live_deploy_ensure_stage_prefix: String = "/tmp/gunbc-live-deploy-ensure-"
data live_deploy_ensure_stage_template: NonEmptyStr = "/tmp/gunbc-live-deploy-ensure-XXXXXXXXXX"

// The mktemp answer is data, not authority: its stdout must be TRIMMED, must start with the
// prefix, must not be the bare prefix, and must carry no newline, no space and no traversal
// segment -- admitted_scratch_path is the house validator for exactly that, so this adds no new
// wall. A refusal here means the scratch dir is not trusted, so nothing touches it.
fn live_deploy_ensure_scratch_dir(outcome: RunArgvTransportOutcome) -> String? {
  match outcome {
    RunArgvTransportRefused { reason: _ } => none
    RunArgvTransportObserved { observed: o } =>
      if o.exit_code == 0 {
        admitted_scratch_path(prefix: live_deploy_ensure_stage_prefix, stdout: o.stdout)
      } else {
        none
      }
  }
}

// The acquisition's own failure line, worded so it never claims a run the fold has decided did
// not happen. Reuses render_scratch_outcome's vocabulary for the observed arm so the discard/
// acquisition phrasing matches the rest of this module's scratch language.
fn live_deploy_ensure_scratch_refusal_line(outcome: RunArgvTransportOutcome) -> String {
  match outcome {
    RunArgvTransportRefused { reason: r } =>
      join(
        [
          "host_effect_apply: live-deploy ensure-dependency refused at scratch acquisition before any leg ran -- ",
          r,
          "; no marker was staged, installed, or discarded.",
        ],
        "",
      )
    RunArgvTransportObserved { observed: o } =>
      if o.exit_code == 0 {
        join(
          [
            "host_effect_apply: live-deploy ensure-dependency refused at scratch acquisition -- mktemp answered 0 with a path this route will not admit (outside ",
            live_deploy_ensure_stage_prefix,
            ", empty, or carrying a newline, a space, or a traversal segment); no marker was staged, installed, or discarded. stdout: ",
            o.stdout,
          ],
          "",
        )
      } else {
        join(
          [
            "host_effect_apply: live-deploy ensure-dependency refused at scratch acquisition -- mktemp exited ",
            to_string(o.exit_code),
            ": ",
            if o.stderr == "" { o.stdout } else { o.stderr },
            "; no marker was staged, installed, or discarded.",
          ],
          "",
        )
      }
  }
}

// Mirrored from compile_pool_install_step_failure_line (foot of this module) with the same
// refusal-vs-observation split: a refusal did not start a process and must not be reported as
// having an exit status.
fn live_deploy_ensure_step_failure_line(step: String, subject: String, outcome: RunArgvTransportOutcome) -> String {
  match outcome {
    RunArgvTransportRefused { reason: r } =>
      join(
        [
          "host_effect_apply: live-deploy ensure-dependency could not run its ",
          step,
          " for ",
          subject,
          " -- ",
          r,
        ],
        "",
      )
    RunArgvTransportObserved { observed: o } =>
      join(
        [
          "host_effect_apply: live-deploy ensure-dependency ran its ",
          step,
          " for ",
          subject,
          " and the operation exited ",
          to_string(o.exit_code),
          ": ",
          if o.stderr == "" { o.stdout } else { o.stderr },
        ],
        "",
      )
  }
}

// Mirrored from compile_pool_install_discard_line: the cleanup is best-effort, but its own
// outcome is reported either way, so a failed discard is visible in the reason instead of
// silent.
fn live_deploy_ensure_discard_line(outcome: RunArgvTransportOutcome) -> String {
  match outcome {
    RunArgvTransportRefused { reason: r } =>
      join(
        [
          "the scratch discard did not run either -- ",
          r,
          "; the scratch directory may survive for later reclamation.",
        ],
        "",
      )
    RunArgvTransportObserved { observed: o } =>
      if o.exit_code == 0 {
        "the scratch directory was discarded"
      } else {
        join(
          [
            "the scratch discard exited ",
            to_string(o.exit_code),
            "; the scratch directory may survive for later reclamation",
          ],
          "",
        )
      }
  }
}

// The marker's declared FileMode as the octal text install(1) takes. The mode arrives from the
// FabricStorageOwnershipMarkerSpec as data -- it is never a literal here -- and file_mode_octal
// is extdeps.access.posix's own spelling of the digits, so no hand-rounded "0600" can drift.
fn live_deploy_ensure_marker_mode_text(mode: FileMode) -> NonEmptyStr {
  file_mode_octal(mode: mode) as NonEmptyStr
}

fn installed_stderr(installed: RunArgvTransportOutcome) -> String {
  match installed {
    RunArgvTransportObserved { observed: o } => o.stderr
    RunArgvTransportRefused { reason: _ } => ""
  }
}

// One serve route written or turned off, as its own gated effect: the tailnet door cutover applies
// the re-point and its restore one at a time, between observations, never inside the bulk apply.
// THE SERVE ROUTE AS A TYPED ARGV, not a retained shell script. The one route the cutover writes
// (gunbc.live_deploy.tailnet_door_cutover) is a single privileged command; its old body was a
// RetainedShellScript whose bash added nothing the words did not say, so it is emitted as an
// ArgvCommand (deployment_serve_route_command: sudo -n tailscale <serve argv>) and run through the
// typed transport. Every refusal the script had survives as a typed NotConverged:
//   - the leg RAN (LocalShell / SshShell) and returned a non-zero exit -> reconcile_shell_exec_observed
//     maps it to NotConverged { shell_exec_failure_reason } exactly as the old realize_shell_on_host did;
//   - the leg RAN and returned 0 -> Converged { ShellEffectApplied } (same evidence the script path produced);
//   - the transport is refused (FleetSsh / EmitArtifactThenThinRun, and the SshShell typed-argv refusal)
//     -> run_argv_over_host_effect_transport yields RunArgvTransportRefused, folded here to NotConverged
//     { reason }. The old script path surfaced those transports as a failed observation; the new typed
//     path names the refusal directly. Neither path converges, and neither falls back to a default.
fn realize_live_deploy_serve_route_on_host(
  endpoint: TailscaleServeEndpoint,
  enabled: Bool,
  transport: HostEffectTransport,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let command = deployment_serve_route_command(endpoint: endpoint, enabled: enabled)
  match run_argv_over_host_effect_transport(command: command, transport: transport) {
    RunArgvTransportObserved { observed } =>
      reconcile_shell_exec_observed(observed: observed, intent: intent)
    RunArgvTransportRefused { reason } =>
      NotConverged { reason: reason, applied: intent }
  }
}

// THE READ VERDICT, as a pure fn on the TYPED GET (success, body) — the §3 boundary-witness
// subject: the witness SUPPLIES each boundary value (success:false and body:"" — the hermetic
// mock's shape; the dispatch body with its digest; an unparseable body) and asserts the leg that
// fires. Leg order and strings are VERBATIM from the dissolved script
// (roadmap_site_readback_curl_digest_check + the node JSON.parse leg):
//   (1) !success -> "roadmap-site-readback: curl failed url=<url>"
//   (2) the body hashes to something other than the dispatch artifact's digest (content_hash_atom
//       is the same FNV-1a-64 over UTF-8 the script's node one-liner ran — offset basis
//       0xcbf29ce484222325, prime 0x100000001b3, the parity node_hash_protocol_witness pins; an
//       empty body hashes to the offset basis, never the dispatch digest, so it refuses HERE)
//       -> "roadmap-site-readback: digest mismatch url=<url>"
//   (3) !json_text_parseable(body) -> "roadmap-site-readback: dispatch json parse failed"
//   (4) else Converged { ShellEffectApplied { 0, body, "" } } — the read-back bytes ARE the
//       evidence, which is more faithful than the script's static receipt echo.
fn live_deploy_digest_readback_verdict(
  intent: HostEffectIntent,
  url: String,
  success: Bool,
  body: String,
  expected: Fnv1a64Structural,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  if !success {
    NotConverged { reason: concat("roadmap-site-readback: curl failed url=", url), applied: intent }
  } else {
    if body == "" || !content_hash_eq_structural(
      left: content_hash_atom(value: body as NonEmptyStr),
      right: expected,
    ) {
      NotConverged { reason: concat("roadmap-site-readback: digest mismatch url=", url), applied: intent }
    } else {
      if !json_text_parseable(s: body) {
        NotConverged { reason: "roadmap-site-readback: dispatch json parse failed", applied: intent }
      } else {
        Converged { evidence: ShellEffectApplied { exit_code: 0, stdout: body, stderr: "" }, applied: intent }
      }
    }
  }
}

fn live_deploy_digest_readback_url(port: Int) -> String {
  concat(concat("http://127.0.0.1:", to_string(port)), roadmap_site_dispatch_url_path as String)
}

// THE SAME GET the script ran, as TYPED ARGV WORDS (DESIGN §0c: argv, not a command string). The
// bound flags come from the kernel (curl_localhost_max_time == the script's --max-time 5); the
// url is a PARAMETER, never a policy literal baked into an argv build.
fn live_deploy_digest_readback_argv(port: Int) -> List<String> {
  http_client_get_argv(
    url: live_deploy_digest_readback_url(port: port) as NonEmptyStr,
    max_time: curl_localhost_max_time,
  )
}

// LiveDeployDigestReadback realization (roadmap static-site dispatch digest read-back; the
// live_deploy readiness poll on the reconcile spine). AN OBSERVATION, and it RUNS on the caller
// (runtime present), so it dissolves to its typed effects the way the landed readiness sibling
// does (DESIGN §3; §0c native-handler arm) — no bash emitter, no retained_srvn, and no
// RetainedShellScript row is minted:
//   - LocalShell takes the NATIVE arm: the http.Client.GetWithin op with the script's 5 s wall
//     passed as a PARAMETER (the op's argv is materializable words — the same arm the sibling
//     probe lands on; GetLocalhostBounded's argv embeds two flag-expression residues, so the
//     parameterized op is the one that reaches this seam as words);
//   - SshShell / FleetSsh route the SAME typed argv through typed_argv_exec_over_{ssh,fleet_ssh}
//     and judge the brought-back (success, stdout): the FleetSsh refusal the SCRIPT CARRIER
//     carried dissolves because typed argv words are exactly what the fleet path admits — the
//     wall the readiness sibling already ran down;
//   - EmitArtifactThenThinRun has no thin argv to run against an observation and keeps its typed
//     refusal, now in the per-effect template's words.
fn realize_live_deploy_digest_readback_on_host(
  port: Int,
  expected_digest: Fnv1a64Structural,
  transport: HostEffectTransport,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let url = live_deploy_digest_readback_url(port: port)
  let expected = expected_digest
  match transport {
    LocalShell => {
      let got = http.Client.GetWithin(
        url: url as NonEmptyStr,
        max_seconds: http_client_max_time_flag(max_time: curl_localhost_max_time),
      )
      live_deploy_digest_readback_verdict(
        intent: intent,
        url: url,
        success: got.success,
        body: got.body,
        expected: expected,
      )
    }
    SshShell { ssh_host: h } =>
      match typed_argv_exec_over_ssh(host: h, argv: live_deploy_digest_readback_argv(port: port)) {
        TypedArgvExecConverged { result: r } =>
          live_deploy_digest_readback_verdict(
            intent: intent,
            url: url,
            success: r.success,
            body: r.stdout,
            expected: expected,
          )
        TypedArgvExecRefused { reason: why } => NotConverged { reason: why, applied: intent }
      }
    FleetSsh { target: t, context: c } =>
      match typed_argv_exec_over_fleet_ssh(
        target: t,
        context: c,
        argv: live_deploy_digest_readback_argv(port: port),
      ) {
        TypedArgvExecConverged { result: r } =>
          live_deploy_digest_readback_verdict(
            intent: intent,
            url: url,
            success: r.success,
            body: r.stdout,
            expected: expected,
          )
        TypedArgvExecRefused { reason: why } => NotConverged { reason: why, applied: intent }
      }
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } => NotConverged {
      reason: "host_effect_apply: LiveDeployDigestReadback cannot use EmitArtifactThenThinRun transport; typed mismatch.",
      applied: intent,
    }
  }
}

// THE UNGATED DISPATCHER HAS NO DeployAccess, so it cannot emit a live-deploy apply, retract or broker
// dark install: every principal-sensitive fact in those scripts (the sudoers preamble and its roster
// probe, the helper sudoers readback owner) derives from the one DeployAccess the gated dispatcher holds.
// Production reaches all three only through host_effect_apply_gated.
data ungated_live_deploy_emission_refusal: String = "host_effect_apply: a live-deploy apply, retract or approval-broker dark install is emitted from the applying DeployAccess, which only host_effect_apply_gated carries; the ungated dispatcher refuses rather than naming one"

fn host_effect_apply(target: NodeControlPlane, effect: HostEffect, evidence: IdempotencyEvidence, transport: HostEffectTransport) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let intent = HostEffectIntent {
    target: target,
    effect: effect,
    evidence: evidence,
    transport: transport,
    privilege_denial: none,
  }
  match resolve_host_effect_cell(target: target, effect: effect) {
    ConvergeOnHost { node: _, host_converge: hc } =>
      realize_converge_on_host(host_converge: hc, transport: transport, intent: intent)
    TypedReconcileOnHost { node: _, kind: k } => realize_srv3_typed_reconcile(kind: k, transport: transport, intent: intent)
    OsInstallActuatorToolchainOnHost { node: _ } =>
      realize_os_install_actuator_toolchain_ensure(effect_intent: intent)
    ProvisionBuildCacheOnHost { node: _, desired: _ } =>
      realize_provision_build_cache(effect_intent: intent)
    ProvisionCodexRuntimeOnHost { node: _ } =>
      realize_provision_codex_runtime(effect_intent: intent)
    EnsureCompilePoolSliceOnHost { node: _ } =>
      realize_ensure_compile_pool_slice(transport: transport, effect_intent: intent)
    HostnameOnHost { node: _, hostnamectl_path: p, base: b, desired: d } =>
      realize_set_hostname_cas_on_host(hostnamectl_path: p, base: b, desired: d, transport: transport, intent: intent)
    HostnameReadOnHost { node: _ } =>
      realize_hostname_read_on_host(transport: transport, intent: intent)
    NbdProxySessionOnHost { node: _, intent: i, lease_key: k } =>
      realize_nbd_proxy_session_on_host(intent: i, lease_key: k, transport: transport, intent_record: intent)
    CodexSupervisedWorkerTurnOnHost { node: _, intent: i, lease_key: k } =>
      realize_codex_supervised_worker_turn_on_host(intent: i, lease_key: k, transport: transport, intent_record: intent)
    ReceiptEmitOnHost { node: _, lines: lines } =>
      realize_receipt_emit_on_host(lines: lines, intent: intent)
    BootOnceReadBackSleepOnHost { node: _ } =>
      realize_boot_once_read_back_sleep_on_host(transport: transport, intent: intent)
    SeededInstallMediaToolchainOnHost { node: _ } =>
      realize_seeded_install_media_toolchain_ensure_on_host(transport: transport, intent: intent)
    BmcwebSessionLoginOnHost { node: _, request_body_file: f } =>
      realize_bmcweb_session_login_on_host(transport: transport, intent: intent, request_body_file: f)
    BmcwebTokenExtractOnHost { node: _ } =>
      realize_bmcweb_token_extract_on_host(transport: transport, intent: intent)
    EffectivePrincipalReadOnHost { node: _, read: r } =>
      realize_effective_principal_read_on_host(read: r, transport: transport, intent: intent)
    SudoNopasswdExecuteProbeOnHost { node: _, probe: p } =>
      realize_sudo_nopasswd_execute_probe_on_host(probe: p, transport: transport, intent: intent)
    SudoNopasswdGrantListProbeOnHost { node: _, probe: p } =>
      realize_sudo_nopasswd_grant_list_probe_on_host(probe: p, transport: transport, intent: intent)
    LiveDeployApplyOnHost { node: _, spec: _, candidate: _, plan: _ } =>
      NotConverged { reason: ungated_live_deploy_emission_refusal, applied: intent }
    LiveDeployRetractOnHost { node: _, spec: _ } =>
      NotConverged { reason: ungated_live_deploy_emission_refusal, applied: intent }
    LiveDeployApprovalBrokerDarkInstallOnHost { node: _, spec: _, candidate: _ } =>
      NotConverged { reason: ungated_live_deploy_emission_refusal, applied: intent }
    LiveDeployMicrovmControllerInstallOnHost { node: _, candidate: c, elevated: e } =>
      realize_microvm_controller_install_on_host(candidate: c, transport: HostEffectElevationRoute { unelevated: transport, elevated: e }, intent: intent)
    LiveDeployEnsureDependencyOnHost { node: _, dep: d } =>
      realize_live_deploy_ensure_dependency_on_host(dep: d, transport: transport, intent: intent)
    LiveDeployDigestReadbackOnHost { node: _, port: p, expected_digest: d } =>
      realize_live_deploy_digest_readback_on_host(port: p, expected_digest: d, transport: transport, intent: intent)
    LiveDeployServeRouteOnHost { node: _, endpoint: e, enabled: route_enabled } =>
      realize_live_deploy_serve_route_on_host(endpoint: e, enabled: route_enabled, transport: transport, intent: intent)
    EnsureActionsRunnerReleaseOnHost { node: _, runner_release: _ } =>
      runner_lifecycle_realize_ensure_actions_runner_release(intent: intent)
    EnsureRunnerSlotDirectoryOnHost { node: _, slot: _, artifact: _ } =>
      runner_lifecycle_realize_ensure_runner_slot_directory(intent: intent)
    EnsureRunnerJitWrapperOnHost { node: _, host_label: _ } =>
      runner_lifecycle_realize_ensure_runner_jit_wrapper(intent: intent)
    EnsureRunnerSystemdTemplateOnHost { node: _, host_label: _ } =>
      runner_lifecycle_realize_ensure_runner_systemd_template(intent: intent)
    EnsureRunnerMemoryCapsOnHost { node: _, slot: _ } =>
      runner_lifecycle_realize_ensure_runner_memory_caps(intent: intent)
    ActivateRunnerSlotOnHost { node: _, slot: _ } =>
      runner_lifecycle_realize_activate_runner_slot(intent: intent)
    DrainAndMaskRunnerSlotOnHost { node: _, slot: _ } =>
      runner_lifecycle_realize_drain_and_mask_runner_slot(intent: intent)
    ReplaceRunnerIncarnationOnHost { node: _, from: _, cause: _ } =>
      runner_lifecycle_realize_replace_runner_incarnation(intent: intent)
    ObserveRunnerLocalStateOnHost { node: _, slot: _ } =>
      runner_lifecycle_realize_observe_runner_local_state(intent: intent)
    ObserveGitHubRunnerRegistrationOnHost { node: _, slot: _, organization: _ } =>
      runner_lifecycle_realize_observe_github_runner_registration(intent: intent)
    ToolchainHomeInterferenceProbeOnHost =>
      match transport {
        LocalShell => realize_toolchain_home_interference_probe(intent: intent)
        SshShell { ssh_host: _ } =>
          NotConverged {
            reason: "host_effect_apply: ProbeToolchainHomeInterference requires LocalShell on RunnerLocalHost; SshShell would record a remote transport while executing the probe locally.",
            applied: intent,
          }
        FleetSsh { target: _, context: _ } =>
          NotConverged {
            reason: "host_effect_apply: ProbeToolchainHomeInterference requires LocalShell on RunnerLocalHost; FleetSsh would record a remote transport while executing the probe locally.",
            applied: intent,
          }
        EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
          NotConverged {
            reason: "host_effect_apply: ProbeToolchainHomeInterference requires LocalShell on RunnerLocalHost; deferred artifact execution cannot observe this job-scoped probe.",
            applied: intent,
          }
      }
    RedfishOnBmc { node: _, action: _ } =>
      NotConverged { reason: "host_effect_apply: RedfishAction realization is a fail-closed Unimplemented stub in Phase A; neat-boar-71 realizes it over RedfishRest in Phase C. No plausible no-op for a power/boot action (DESIGN section 5).", applied: intent }
    IncompatibleCell { reason: why } => NotConverged { reason: why, applied: intent }
  }
}

fn host_effect_privilege_verdict(
  access: DeployAccess,
  fixture_actor: DeployAccessActor?
) -> AccessDecision {
  match fixture_actor {
    Present { value: actor } => deploy_access_check(access: access, actor: actor)
    Absent => deploy_access_check_observed(access: access)
  }
}

fn deploy_access_host_target(access: DeployAccess) -> NodeControlPlane {
  HostOs { node: access.host }
}

fn deploy_access_shell_apply_success_stdout(
  access: DeployAccess,
  effect: HostEffect,
) -> String? {
  match host_effect_apply(
    target: deploy_access_host_target(access: access),
    effect: effect,
    evidence: host_effect_read_evidence,
    transport: access.transport,
  ) {
    Converged { evidence: e, applied: _ } =>
      match e {
        ShellEffectApplied { stdout: out, exit_code: code, stderr: _ } =>
          if code == 0 {
            Present { value: out }
          } else {
            none
          }
        ConvergePlanApplied { stdout: _, exit_code: _ } => Absent
        ToolchainHomeInterferenceDiscriminated => Absent
      }
    NotConverged { reason: _, applied: _ } => Absent
  }
}

fn deploy_access_observed_principal(access: DeployAccess) -> NonEmptyStr? {
  match deploy_access_shell_apply_success_stdout(
    access: access,
    effect: deploy_access_read_principal_effect(),
  ) {
    Present { value: stdout } => deploy_access_principal_line(success: true, stdout: stdout)
    Absent => Absent
  }
}

fn deploy_access_sudo_check_cmd(access: DeployAccess, cmd: PrivilegedCommand) -> Bool {
  match deploy_access_shell_apply_success_stdout(
    access: access,
    effect: deploy_access_sudo_probe_effect(cmd: cmd),
  ) {
    Present { value: _ } => true
    Absent => false
  }
}

fn deploy_access_sudo_all_granted(access: DeployAccess) -> Bool {
  fold_list(
    xs: access.privileged_commands,
    empty: true,
    cons: (acc, cmd) => if !acc { false } else { deploy_access_sudo_check_cmd(access: access, cmd: cmd) }
  )
}

fn deploy_access_observed_actor(access: DeployAccess) -> DeployAccessActor? {
  match deploy_access_observed_principal(access: access) {
    Present { value: observed_name } =>
      Present {
        value: DeployAccessActor {
          observed_name: observed_name,
          sudo_granted: deploy_access_sudo_all_granted(access: access),
        }
      }
    Absent => Absent
  }
}

fn deploy_access_check_observed(access: DeployAccess) -> AccessDecision {
  match deploy_access_observed_actor(access: access) {
    Present { value: actor } => deploy_access_check(access: access, actor: actor)
    Absent =>
      access_policy_refusal(
        profile: "deploy-access-observation", subject: "unobserved", action: "execute", object: "host-effect",
        reason: concat(
            deploy_access_refusal_prefix,
            " — could not observe principal (ReadEffectivePosixPrincipal failed)"
          ),
      )
  }
}

// WHAT A DEPLOY EFFECT MAY DEMAND BEFORE IT RUNS. Apply and retract both open with
// live_deploy_apply_preamble_on_host, whose first legs install the deploy principal's sudoers drop-in
// and then probe the whole roster against it, refusing on a miss before any other mutation. So before them
// the gate demands only what that install spends; demanding the rest would require the grant the
// gated step exists to install. Every other effect installs nothing and is gated on the full roster.
// It narrows the VERDICT only: the scripts are emitted from the full DeployAccess, so the preamble's
// roster probe still demands the whole roster (moved here from gunbc.live_deploy.apply, 2026-10-13, so
// the gate holds one access and derives its own scope rather than receiving a second, narrowed copy).
fn live_deploy_pre_mutation_access(effect: HostEffect, access: DeployAccess) -> DeployAccess {
  match effect {
    LiveDeployApply { warrant: _ } => deploy_access_sudoers_install_scope(access: access)
    LiveDeployRetract { spec: _ } => deploy_access_sudoers_install_scope(access: access)
    RedfishAction { action: _ } => access
    ConvergePlan { policy: _ } => access
    OsInstallActuatorToolchainEnsure {} => access
    EnsureBuildCacheInstance { desired: _ } => access
    ProvisionCodexRuntime {} => access
    EnsureCompilePoolSlice {} => access
    SetHostnameCas { hostnamectl_path: _, base: _, desired: _ } => access
    ReadEffectivePosixPrincipal { read: _ } => access
    SudoNopasswdExecuteProbe { probe: _ } => access
    SudoNopasswdGrantListProbe { probe: _ } => access
    Srv3InstallMediaFetch => access
    Srv3SeededInstallMediaRemaster => access
    Srv3SeededInstallMediaToolchainEnsure => access
    Srv3BmcwebSessionLogin { request_body_file: _ } => access
    Srv3BmcwebTokenExtract => access
    Srv3NbdProxyServe { intent: _, lease_key: _ } => access
    CodexSupervisedWorkerTurn { intent: _, lease_key: _ } => access
    Srv3BootOnceReadBackSleep => access
    Srv3ReceiptEmit { lines: _ } => access
    HostIdentityShortHostnameRead => access
    LiveDeployApprovalBrokerDarkInstall { spec: _, candidate: _ } => access
    LiveDeployMicrovmControllerInstall { candidate: _ } => access
    LiveDeployEnsureDependency { dep: _ } => access
    LiveDeployDigestReadback { port: _, expected_digest: _ } => access
    LiveDeployServeRoute { endpoint: _, enabled: _ } => access
    DeployAccessPreflight {} => access
    EnsureActionsRunnerRelease { runner_release: _ } => access
    EnsureRunnerSlotDirectory { slot: _, artifact: _ } => access
    EnsureRunnerJitWrapper { host_label: _ } => access
    EnsureRunnerSystemdTemplate { host_label: _ } => access
    EnsureRunnerMemoryCaps { slot: _ } => access
    ActivateRunnerSlot { slot: _ } => access
    DrainAndMaskRunnerSlot { slot: _ } => access
    ReplaceRunnerIncarnation { from: _, cause: _ } => access
    ObserveRunnerLocalState { slot: _ } => access
    ObserveGitHubRunnerRegistration { slot: _, organization: _ } => access
    ProbeToolchainHomeInterference {} => access
  }
}

fn host_effect_apply_gated(
  access: DeployAccess,
  target: NodeControlPlane,
  effect: HostEffect,
  evidence: IdempotencyEvidence,
  transport: HostEffectTransport,
  fixture_actor: DeployAccessActor?
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let intent = HostEffectIntent {
    target: target,
    effect: effect,
    evidence: evidence,
    transport: transport,
    privilege_denial: none,
  }
  let verdict = host_effect_privilege_verdict(access: live_deploy_pre_mutation_access(effect: effect, access: access), fixture_actor: fixture_actor)
  match verdict {
    Permit =>
      match resolve_host_effect_cell(target: target, effect: effect) {
        ConvergeOnHost { node: _, host_converge: hc } =>
          realize_converge_on_host(host_converge: hc, transport: transport, intent: intent)
        TypedReconcileOnHost { node: _, kind: k } => realize_srv3_typed_reconcile(kind: k, transport: transport, intent: intent)
        OsInstallActuatorToolchainOnHost { node: _ } =>
          realize_os_install_actuator_toolchain_ensure(effect_intent: intent)
        ProvisionBuildCacheOnHost { node: _, desired: _ } =>
          realize_provision_build_cache(effect_intent: intent)
        ProvisionCodexRuntimeOnHost { node: _ } =>
          realize_provision_codex_runtime(effect_intent: intent)
        EnsureCompilePoolSliceOnHost { node: _ } =>
          realize_ensure_compile_pool_slice(transport: transport, effect_intent: intent)
        HostnameOnHost { node: _, hostnamectl_path: p, base: b, desired: d } =>
          realize_set_hostname_cas_on_host(hostnamectl_path: p, base: b, desired: d, transport: transport, intent: intent)
        HostnameReadOnHost { node: _ } =>
          realize_hostname_read_on_host(transport: transport, intent: intent)
        NbdProxySessionOnHost { node: _, intent: i, lease_key: k } =>
          realize_nbd_proxy_session_on_host(intent: i, lease_key: k, transport: transport, intent_record: intent)
        CodexSupervisedWorkerTurnOnHost { node: _, intent: i, lease_key: k } =>
          realize_codex_supervised_worker_turn_on_host(intent: i, lease_key: k, transport: transport, intent_record: intent)
        ReceiptEmitOnHost { node: _, lines: lines } =>
          realize_receipt_emit_on_host(lines: lines, intent: intent)
        BootOnceReadBackSleepOnHost { node: _ } =>
          realize_boot_once_read_back_sleep_on_host(transport: transport, intent: intent)
        SeededInstallMediaToolchainOnHost { node: _ } =>
          realize_seeded_install_media_toolchain_ensure_on_host(transport: transport, intent: intent)
        BmcwebSessionLoginOnHost { node: _, request_body_file: f } =>
          realize_bmcweb_session_login_on_host(transport: transport, intent: intent, request_body_file: f)
        BmcwebTokenExtractOnHost { node: _ } =>
          realize_bmcweb_token_extract_on_host(transport: transport, intent: intent)
        EffectivePrincipalReadOnHost { node: _, read: r } =>
          realize_effective_principal_read_on_host(read: r, transport: transport, intent: intent)
        SudoNopasswdExecuteProbeOnHost { node: _, probe: p } =>
          realize_sudo_nopasswd_execute_probe_on_host(probe: p, transport: transport, intent: intent)
        SudoNopasswdGrantListProbeOnHost { node: _, probe: p } =>
          realize_sudo_nopasswd_grant_list_probe_on_host(probe: p, transport: transport, intent: intent)
        LiveDeployApplyOnHost { node: _, spec: s, candidate: c, plan: p } =>
          realize_live_deploy_apply_on_host(spec: s, candidate: c, plan: p, transport: transport, intent: intent, access: access)
        LiveDeployRetractOnHost { node: _, spec: s } =>
          realize_live_deploy_retract_on_host(spec: s, transport: transport, intent: intent, access: access)
        LiveDeployApprovalBrokerDarkInstallOnHost { node: _, spec: s, candidate: c } =>
          realize_approval_broker_dark_install_on_host(spec: s, candidate: c, transport: transport, intent: intent, access: access)
        LiveDeployMicrovmControllerInstallOnHost { node: _, candidate: c, elevated: e } =>
          realize_microvm_controller_install_on_host(candidate: c, transport: HostEffectElevationRoute { unelevated: transport, elevated: e }, intent: intent)
        LiveDeployEnsureDependencyOnHost { node: _, dep: d } =>
          realize_live_deploy_ensure_dependency_on_host(dep: d, transport: transport, intent: intent)
        LiveDeployDigestReadbackOnHost { node: _, port: p, expected_digest: d } =>
          realize_live_deploy_digest_readback_on_host(port: p, expected_digest: d, transport: transport, intent: intent)
        LiveDeployServeRouteOnHost { node: _, endpoint: e, enabled: route_enabled } =>
          realize_live_deploy_serve_route_on_host(endpoint: e, enabled: route_enabled, transport: transport, intent: intent)
        EnsureActionsRunnerReleaseOnHost { node: _, runner_release: _ } =>
          runner_lifecycle_realize_ensure_actions_runner_release(intent: intent)
        EnsureRunnerSlotDirectoryOnHost { node: _, slot: _, artifact: _ } =>
          runner_lifecycle_realize_ensure_runner_slot_directory(intent: intent)
        EnsureRunnerJitWrapperOnHost { node: _, host_label: _ } =>
          runner_lifecycle_realize_ensure_runner_jit_wrapper(intent: intent)
        EnsureRunnerSystemdTemplateOnHost { node: _, host_label: _ } =>
          runner_lifecycle_realize_ensure_runner_systemd_template(intent: intent)
        EnsureRunnerMemoryCapsOnHost { node: _, slot: _ } =>
          runner_lifecycle_realize_ensure_runner_memory_caps(intent: intent)
        ActivateRunnerSlotOnHost { node: _, slot: _ } =>
          runner_lifecycle_realize_activate_runner_slot(intent: intent)
        DrainAndMaskRunnerSlotOnHost { node: _, slot: _ } =>
          runner_lifecycle_realize_drain_and_mask_runner_slot(intent: intent)
        ReplaceRunnerIncarnationOnHost { node: _, from: _, cause: _ } =>
          runner_lifecycle_realize_replace_runner_incarnation(intent: intent)
        ObserveRunnerLocalStateOnHost { node: _, slot: _ } =>
          runner_lifecycle_realize_observe_runner_local_state(intent: intent)
        ObserveGitHubRunnerRegistrationOnHost { node: _, slot: _, organization: _ } =>
          runner_lifecycle_realize_observe_github_runner_registration(intent: intent)
        ToolchainHomeInterferenceProbeOnHost =>
          realize_toolchain_home_interference_probe(intent: intent)
        RedfishOnBmc { node: _, action: _ } =>
          NotConverged { reason: "host_effect_apply: RedfishAction realization is a fail-closed Unimplemented stub in Phase A; neat-boar-71 realizes it over RedfishRest in Phase C. No plausible no-op for a power/boot action (DESIGN section 5).", applied: intent }
        IncompatibleCell { reason: why } => NotConverged { reason: why, applied: intent }
      }
    Deny { refusal: _ } =>
      NotConverged {
        reason: deploy_access_decision_reason(d: verdict),
        applied: HostEffectIntent {
          target: target,
          effect: effect,
          evidence: evidence,
          transport: transport,
          privilege_denial: Present { value: verdict },
        },
      }
  }
}

type ConvergeDirective = Settled | ReDrive | Refused { reason: String }

fn not_converged_directive(drive: Drive) -> ConvergeDirective {
  match drive {
    OneShot => Settled
    ConvergeLoop => ReDrive
  }
}

fn host_effect_drive_directive(r: Reconciliation<HostEffectIntent, HostEffectEvidence>) -> ConvergeDirective {
  match r {
    Converged { evidence: _, applied: _ } => Settled
    NotConverged { reason: why, applied: intent } =>
      match intent.privilege_denial {
        Present { value: Deny { refusal: _ } } => Refused { reason: why }
        Present { value: Permit } => not_converged_directive(drive: host_effect_drive(intent: intent))
        Absent =>
          match resolve_host_effect_cell(target: intent.target, effect: intent.effect) {
            IncompatibleCell { reason: inner_why } => Refused { reason: inner_why }
            ConvergeOnHost { node: _, host_converge: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            TypedReconcileOnHost { node: _, kind: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            OsInstallActuatorToolchainOnHost { node: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            ProvisionBuildCacheOnHost { node: _, desired: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            ProvisionCodexRuntimeOnHost { node: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            EnsureCompilePoolSliceOnHost { node: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            HostnameOnHost { node: _, hostnamectl_path: _, base: _, desired: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            HostnameReadOnHost { node: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            NbdProxySessionOnHost { node: _, intent: _, lease_key: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            CodexSupervisedWorkerTurnOnHost { node: _, intent: _, lease_key: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            ReceiptEmitOnHost { node: _, lines: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            BootOnceReadBackSleepOnHost { node: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            SeededInstallMediaToolchainOnHost { node: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            BmcwebSessionLoginOnHost { node: _, request_body_file: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            BmcwebTokenExtractOnHost { node: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            EffectivePrincipalReadOnHost { node: _, read: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            SudoNopasswdExecuteProbeOnHost { node: _, probe: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            SudoNopasswdGrantListProbeOnHost { node: _, probe: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            LiveDeployApplyOnHost { node: _, spec: _, candidate: _, plan: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            LiveDeployRetractOnHost { node: _, spec: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            LiveDeployApprovalBrokerDarkInstallOnHost { node: _, spec: _, candidate: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            LiveDeployMicrovmControllerInstallOnHost { node: _, candidate: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            LiveDeployEnsureDependencyOnHost { node: _, dep: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            LiveDeployDigestReadbackOnHost { node: _, port: _, expected_digest: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            LiveDeployServeRouteOnHost { node: _, endpoint: _, enabled: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            EnsureActionsRunnerReleaseOnHost { node: _, runner_release: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            EnsureRunnerSlotDirectoryOnHost { node: _, slot: _, artifact: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            EnsureRunnerJitWrapperOnHost { node: _, host_label: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            EnsureRunnerSystemdTemplateOnHost { node: _, host_label: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            EnsureRunnerMemoryCapsOnHost { node: _, slot: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            ActivateRunnerSlotOnHost { node: _, slot: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            DrainAndMaskRunnerSlotOnHost { node: _, slot: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            ReplaceRunnerIncarnationOnHost { node: _, from: _, cause: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            ObserveRunnerLocalStateOnHost { node: _, slot: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            ObserveGitHubRunnerRegistrationOnHost { node: _, slot: _, organization: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            ToolchainHomeInterferenceProbeOnHost => not_converged_directive(drive: host_effect_drive(intent: intent))
            RedfishOnBmc { node: _, action: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
          }
      }
  }
}

data provision_observes_before_it_acts_note: String = "THE PREFLIGHT IS NOW THE GATE, AND WHAT IT REPLACED WAS AN UNCONDITIONAL WRITE. Until this landed, realize_provision_build_cache had exactly one check ahead of it -- the catalog gate, which is pure id validation in a third module and never observes a host at all -- and then rendered the unit, installed it, and restarted it on every pass. The two authorities that were supposed to decide whether that was safe (gunbc.build_cache.build_cache_ensure admit_ensure_build_cache_instance, gunbc.host.host_build_cache_provision placement_verdict) had zero production callers, so the refusal named as the remedy for a measured CI-capacity incident was computed by nothing. That is the rung inflation DESIGN section 4b calls worse than sitting low: the witnesses were green, and their greenness established that the fold was correct, not that the class was guarded.\n\nTHE ORDER IS OBSERVE, ADMIT, ACT, AND IT IS LOAD-BEARING RATHER THAN TIDY. Observing after acting would read back the state we just wrote, which is the same fabricated evidence gunbc.host.host_build_cache_provision build_cache_supervision_observation_note measured on srv3: a probe that greens on what it produced rather than on the state the lane exists to establish. Every read here happens BEFORE the first mutation, and the admission decides from those reads alone.\n\nWHAT THIS CHANGES ON A LIVE HOST, in the two arms that matter. A host whose managed unit already owns the endpoint AND IS OBSERVED LISTENING ON IT now converges WITHOUT reinstalling and restarting it (ownership alone is not enough, and was not enough here even before it was written down: gunbc.build_cache.build_cache_ensure ensure_is_a_reconcile_not_an_install_note records the 2026-08-22 correction, under which our own unit holding its socket open without listening REFUSES with the unit named instead of converging over an unreachable cache) -- the most expensive possible no-op, which used to fire on every convergence pass and re-cold every compile on the host. And a host whose endpoint is owned by a runner slot -- srv1 on 2026-08-01, srv1-02 again on 2026-08-07 -- now REFUSES with the owner located, where it previously wrote a unit beside the stranded server and reported success."

fn build_cache_host_read(command: ArgvCommand, transport: HostEffectTransport) -> HostRead {
  match build_cache_host_read_observed(command: command, transport: transport) {
    BuildCacheReadRan { observed: o } =>
      if o.success == true {
        HostReadText { text: o.stdout }
      } else {
        HostReadFailed {
          detail: join(
            [
              "the read exited ",
              to_string(o.exit_code),
              ": ",
              if o.stderr == "" { o.stdout } else { o.stderr },
            ],
            "",
          ) as NonEmptyStr,
        }
      }
    BuildCacheReadRefused { reason: why } => HostReadFailed { detail: why as NonEmptyStr }
  }
}

type BuildCacheReadResult
  = BuildCacheReadRan { observed: ShellExecObserved }
  | BuildCacheReadRefused { reason: String }

// EVERY READ BELOW IS ONE ARGV, NO SHELL. That is not stylistic: this module's build-cache surface
// is a shell-to-dag census A5 row whose standing constraint is that its emitted shell may shrink and
// must not grow -- the reason none of these reads is a concat-built bash body, and no reason to add
// one now that the surface has none. The whole ensure is typed operations in
// gunbc.host.build_cache_daemon_ensure. Routing the reads through the typed argv seam is what made
// that reachable rather than merely adjacent: an observation that arrives as a captured argv result
// can be classified by a typed function, whereas one that arrives as printf receipts had to be
// re-parsed by the shell that printed them.

// IT TAKES A COMMAND RATHER THAN A WORD LIST, for the same reason gunbc.bmc.bmc_netboot_serve's
// executor does: a
// List<String> parameter is a place an argv can be hand-spelled, and one of this function's callers
// was doing exactly that ("stat", "-c", "%i", ...). The ssh arms still need the flat vector, which
// they derive here with argv_words instead of receiving pre-flattened.
fn build_cache_host_read_observed(
  command: ArgvCommand,
  transport: HostEffectTransport,
) -> BuildCacheReadResult {
  match transport {
    LocalShell =>
      match run_shell_command_capture(
        command: command,
        transport: LocalExec,
      ) {
        ProcessOutputPresent { text: t } =>
          BuildCacheReadRan {
            observed: ShellExecObserved { exit_code: 0, success: true, stdout: t, stderr: "" },
          }
        ProcessOutputAbsent =>
          BuildCacheReadRan {
            observed: ShellExecObserved { exit_code: 0, success: true, stdout: "", stderr: "" },
          }
        ProcessRefused { exit_code: code, stderr: err } =>
          BuildCacheReadRan {
            observed: ShellExecObserved { exit_code: code, success: false, stdout: "", stderr: err },
          }
      }
    SshShell { ssh_host: _ } => build_cache_typed_argv_read(argv: argv_words(command: command), transport: transport)
    FleetSsh { target: _, context: _ } => build_cache_typed_argv_read(argv: argv_words(command: command), transport: transport)
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      BuildCacheReadRefused {
        reason: "host_effect_apply: EnsureBuildCacheInstance cannot observe an endpoint over EmitArtifactThenThinRun; typed mismatch.",
      }
  }
}

fn build_cache_typed_argv_read(
  argv: List<String>,
  transport: HostEffectTransport,
) -> BuildCacheReadResult {
  match run_typed_argv_transport(argv: argv, transport: transport) {
    TypedArgvExecConverged { result: r } =>
      BuildCacheReadRan {
        observed: ShellExecObserved { exit_code: r.exit_code, success: r.success, stdout: r.stdout, stderr: r.stderr },
      }
    TypedArgvExecRefused { reason: why } => BuildCacheReadRefused { reason: why }
  }
}

fn build_cache_path_kind_read(
  instance: BuildCacheInstance,
  transport: HostEffectTransport,
) -> EndpointPathKind {
  match instance.endpoint {
    SccacheServerTcpPort { port: _ } => PathKindNoFilesystemPath
    SccacheServerUnixSocket { path: p } =>
      match build_cache_host_read_observed(command: endpoint_path_kind_command(path: p), transport: transport) {
        BuildCacheReadRefused { reason: why } =>
          path_kind_of_socket_test_read(read: HostReadFailed { detail: why as NonEmptyStr }, exit_success: true, parent: ParentListsEntry)
        BuildCacheReadRan { observed: o } =>
          path_kind_of_socket_test_read(
            read: HostReadText { text: o.stdout },
            exit_success: o.success,
            parent: if o.success { ParentListsEntry } else {
              match build_cache_host_read_observed(command: endpoint_parent_listing_command(path: p), transport: transport) {
                BuildCacheReadRefused { reason: why } => ParentListingUnread { detail: concat("the endpoint path's parent listing was refused: ", why) as NonEmptyStr }
                BuildCacheReadRan { observed: l } => endpoint_parent_listing_of(exit_success: l.success, stdout: l.stdout, stderr: l.stderr, name: endpoint_path_name(path: p as String))
              }
            },
          )
      }
  }
}

// ---------------------------------------------------------------------------
// C2 — TYPED HOST REMOVAL. The leaf the live_deploy retract (and the W8 apply cutover)
// consume to remove the gunbc source tree and its unit files, replacing the bash `rm -d` /
// `rm -f` / `rm -rf` leaves under `set -euo pipefail` with an ordered typed sequence whose
// every refusal is typed and names the arm, the step and the path — never a silent default
// and never a widening.
//
// THREE ARMS, ONE PER RM SHAPE (gnu_coreutils.dag keeps `-f` / `-d` / `-rf` as separate names
// because "Choosing -rf where -d was meant turns a loud refusal into silent destruction"):
//   RemoveForce          -> coreutils_rm_force_argv            (rm -f p1 p2 ...)  up to 3 unit files
//   RemoveEmptyDirectory -> coreutils_rm_empty_directory_argv  (rm -d path)        refuses a non-empty dir
//   RemoveForceRecursive -> coreutils_rm_force_recursive_argv  (rm -rf path)       the gunbc source tree
//
// ELEVATION MATCHES THE BASH IT REPLACES: `sudo -n <rm shape>` (sudo_elevate_argv), the same
// shell_privileged_command_text_of_argv the live_deploy script used. The read-back probes are
// UNPRIVILEGED `test -e`: stat is not in the sudo roster (fleet_posix_accounts.dag) and the
// deploy principal itself is unprivileged (emit.dag: "Principal: UNPRIVILEGED ci-runner"), so an
// existence probe needs no elevation and is portable over the SshShell wall (only `-e` + the
// path), unlike `stat -c %F` (the `%` is not a portable word). The verdict is carried by the
// read-back, not by the exit status alone.
//
// THE VERDICT IS A PURE FOLD OVER SUPPLIED OUTCOMES (DESIGN 3): host_remove_verdict takes the
// pre / read-back presence lists and the rm's RunArgvTransportOutcome and returns the
// reconciliation. The witness supplies the boundary values (EmptyDir{absent}, ForceRecursive{absent}
// = NoOp) and the one RED (the non-empty EmptyDir refusal) at this pure interface — no operation, no
// sudo, no filesystem. An EMPTY RemoveForce is not among the boundary values because it is not a
// value at all: see the carrier note below. host_remove_on_host is the thin impure leg:
// pre-observe (test -e per path), dispatch (sudo -n rm), read-back (test -e), verdict. The FIRST
// refusal stops the caller's fold; nothing here absorbs one.
// ---------------------------------------------------------------------------

// RemoveForce carries a FreeSemigroup, not a List: "rm -f with no operand" is not a state this type
// can express, so it is a TYPE ERROR rather than a runtime refusal a caller can forget to write
// (ruling nonemptiness_is_constructed_or_proved; DESIGN §5 -- stronger than catching a wrong state is
// making it unwritable). Up to three unit files go in one rm -f, and there is always at least one.
type HostRemoveTarget
  = RemoveForce { paths: FreeSemigroup<NonEmptyStr> }
  | RemoveEmptyDirectory { path: NonEmptyStr }
  | RemoveForceRecursive { path: NonEmptyStr }

type HostRemoveEvidence
  = RemovedConfirmed { paths: List<String>, exit_code: Int }
  | RemovedNoOp { path: String }

// THE INNER (NOT-YET-ELEVATED) RM ARGV. Pure.
fn host_remove_target_inner_argv(target: HostRemoveTarget) -> List<String> {
  match target {
    RemoveForce { paths: ps } =>
      coreutils_rm_force_argv(paths: list_map(xs: non_empty_to_list(xs: ps), f: fn(p) { p as String }))
    RemoveEmptyDirectory { path: p } =>
      coreutils_rm_empty_directory_argv(path: p as String)
    RemoveForceRecursive { path: p } =>
      coreutils_rm_force_recursive_argv(path: p as String)
  }
}

// THE FLAT ELEVATED ARGV: `sudo -n <rm shape> <paths>`. Pure; the witness reads this back and the
// leaf dispatches it (via sudo_elevate_command on the same inner argv, so the two agree by
// construction).
fn host_remove_target_argv(target: HostRemoveTarget) -> List<String> {
  sudo_elevate_argv(command: host_remove_target_inner_argv(target: target))
}

fn host_remove_arm_name(target: HostRemoveTarget) -> String {
  match target {
    RemoveForce { paths: _ } => "RemoveForce"
    RemoveEmptyDirectory { path: _ } => "RemoveEmptyDirectory"
    RemoveForceRecursive { path: _ } => "RemoveForceRecursive"
  }
}

fn host_remove_step_name(target: HostRemoveTarget) -> String {
  match target {
    RemoveForce { paths: _ } => "remove-force"
    RemoveEmptyDirectory { path: _ } => "remove-empty-dir"
    RemoveForceRecursive { path: _ } => "remove-force-recursive"
  }
}

// THE PATH FIELD FOR THE REASON STRING: the comma-joined target path(s), empty when the arm has
// none (the empty-list refusal).
fn host_remove_path_field(target: HostRemoveTarget) -> String {
  match target {
    RemoveForce { paths: ps } => join(list_map(xs: non_empty_to_list(xs: ps), f: fn(p) { p as String }), ",")
    RemoveEmptyDirectory { path: p } => p as String
    RemoveForceRecursive { path: p } => p as String
  }
}

// EVERY REASON NAMES THE ARM, THE STEP AND THE PATH.
fn host_remove_reason(
  target: HostRemoveTarget,
  verb: String,
  detail: String,
  pathfield: String,
) -> String {
  join(
    [
      "host_remove: ",
      host_remove_arm_name(target: target),
      " ",
      verb,
      " — ",
      detail,
      "; arm=",
      host_remove_arm_name(target: target),
      ", step=",
      host_remove_step_name(target: target),
      ", path=",
      pathfield,
    ],
    "",
  )
}

// THE REMOVAL VERDICT — PURE. pre_present / post_present are the per-target-path read-backs
// (test -e, in target order: the path(s) that would be removed). outcome is the rm's own
// RunArgvTransportOutcome. The boundary values the witness supplies:
//   RemoveForce{paths:[]}            -> empty-list refusal (before any dispatch)
//   RemoveEmptyDirectory on a NON-EMPTY dir -> the loud refusal, never widened to -rf (the RED)
//   RemoveEmptyDirectory on an ABSENT dir   -> refusal (rm -d on an absent dir exits 1; NOT
//                                              idempotent-success)
//   read-back STILL PRESENT after an exit-0 rm -> did-not-converge refusal, names the path
//   RemoveForceRecursive on an ABSENT dir, exit 0 -> Converged RemovedNoOp (rm -rf on absent is
//                                                    idempotent)
fn host_remove_verdict(
  target: HostRemoveTarget,
  pre_state: List<HostRemovePathState>,
  outcome: RunArgvTransportOutcome,
  post_state: List<HostRemovePathState>,
) -> Reconciliation<HostRemoveTarget, HostRemoveEvidence> {
  match host_remove_unreadable_reason(states: pre_state) {
    Present { value: why } =>
      NotConverged {
        reason: host_remove_reason(
          target: target,
          verb: "refused",
          detail: join(["the pre-removal state of a path could not be read, so absence is not established: ", why], ""),
          pathfield: host_remove_path_field(target: target),
        ),
        applied: target,
      }
    Absent =>
      match host_remove_unreadable_reason(states: post_state) {
        Present { value: why } =>
          NotConverged {
            reason: host_remove_reason(
              target: target,
              verb: "did not converge",
              detail: join(["the post-removal state of a path could not be read, so convergence is unproven: ", why], ""),
              pathfield: host_remove_path_field(target: target),
            ),
            applied: target,
          }
        Absent =>
          host_remove_outcome_verdict(
            target: target,
            pre_present: list_map(xs: pre_state, f: fn(st) { host_remove_state_present(state: st) }),
            outcome: outcome,
            post_present: list_map(xs: post_state, f: fn(st) { host_remove_state_present(state: st) }),
          )
      }
  }
}

fn host_remove_outcome_verdict(
  target: HostRemoveTarget,
  pre_present: List<Bool>,
  outcome: RunArgvTransportOutcome,
  post_present: List<Bool>,
) -> Reconciliation<HostRemoveTarget, HostRemoveEvidence> {
  match target {
    RemoveForce { paths: ps } =>
      match outcome {
        RunArgvTransportRefused { reason: why } =>
          NotConverged {
            reason: host_remove_reason(
              target: target,
              verb: "refused",
              detail: join(["the typed transport refused the removal before any dispatch: ", why], ""),
              pathfield: host_remove_path_field(target: target),
            ),
            applied: target,
          }
        RunArgvTransportObserved { observed: o } =>
          if string_contains(s: o.stderr, pattern: "a password is required") {
            NotConverged {
              reason: host_remove_reason(
                target: target,
                verb: "refused",
                detail: "sudo -n elevation unavailable",
                pathfield: host_remove_path_field(target: target),
              ),
              applied: target,
            }
          } else if !o.success {
            NotConverged {
              reason: host_remove_reason(
                target: target,
                verb: "refused",
                detail: join(["rm -f failed (exit ", to_string(o.exit_code), ")"], ""),
                pathfield: host_remove_path_field(target: target),
              ),
              applied: target,
            }
          } else {
            let still = fold_list(xs: post_present, empty: false, cons: (acc, b) => acc || b)
            if still {
              NotConverged {
                reason: host_remove_reason(
                  target: target,
                  verb: "did not converge",
                  detail: join([host_remove_path_field(target: target), " still present after read-back"], ""),
                  pathfield: host_remove_path_field(target: target),
                ),
                applied: target,
              }
            } else {
              Converged {
                evidence: RemovedConfirmed {
                  paths: list_map(xs: non_empty_to_list(xs: ps), f: fn(p) { p as String }),
                  exit_code: o.exit_code,
                },
                applied: target,
              }
            }
          }
      }
    RemoveEmptyDirectory { path: p } => {
    let p_s = p as String
    match outcome {
      RunArgvTransportRefused { reason: why } =>
        NotConverged {
          reason: host_remove_reason(
            target: target,
            verb: "refused",
            detail: join(["the typed transport refused the removal before any dispatch: ", why], ""),
            pathfield: p_s,
          ),
          applied: target,
        }
      RunArgvTransportObserved { observed: o } =>
        if string_contains(s: o.stderr, pattern: "a password is required") {
          NotConverged {
            reason: host_remove_reason(
              target: target,
              verb: "refused",
              detail: "sudo -n elevation unavailable",
              pathfield: p_s,
            ),
            applied: target,
          }
        } else if !o.success {
          NotConverged {
            reason: host_remove_reason(
              target: target,
              verb: "refused",
              detail: join(["rm -d failed (exit ", to_string(o.exit_code), "): ", o.stderr, " (never widened to -rf)"], ""),
              pathfield: p_s,
            ),
            applied: target,
          }
        } else {
          let still = fold_list(xs: post_present, empty: false, cons: (acc, b) => acc || b)
          if still {
            NotConverged {
              reason: host_remove_reason(
                target: target,
                verb: "did not converge",
                detail: join([p_s, " still present after read-back"], ""),
                pathfield: p_s,
              ),
              applied: target,
            }
          } else {
            Converged {
              evidence: RemovedConfirmed { paths: [p_s], exit_code: o.exit_code },
              applied: target,
            }
          }
        }
    }
    }
    RemoveForceRecursive { path: p } => {
    let p_s = p as String
    match outcome {
      RunArgvTransportRefused { reason: why } =>
        NotConverged {
          reason: host_remove_reason(
            target: target,
            verb: "refused",
            detail: join(["the typed transport refused the removal before any dispatch: ", why], ""),
            pathfield: p_s,
          ),
          applied: target,
        }
      RunArgvTransportObserved { observed: o } =>
        if string_contains(s: o.stderr, pattern: "a password is required") {
          NotConverged {
            reason: host_remove_reason(
              target: target,
              verb: "refused",
              detail: "sudo -n elevation unavailable",
              pathfield: p_s,
            ),
            applied: target,
          }
        } else if !o.success {
          NotConverged {
            reason: host_remove_reason(
              target: target,
              verb: "refused",
              detail: join(["rm -rf failed (exit ", to_string(o.exit_code), ")"], ""),
              pathfield: p_s,
            ),
            applied: target,
          }
        } else {
          let still = fold_list(xs: post_present, empty: false, cons: (acc, b) => acc || b)
          if still {
            NotConverged {
              reason: host_remove_reason(
                target: target,
                verb: "did not converge",
                detail: join([p_s, " still present after read-back"], ""),
                pathfield: p_s,
              ),
              applied: target,
            }
          } else {
            let was_absent = fold_list(xs: pre_present, empty: true, cons: (acc, b) => acc && !b)
            if was_absent {
              Converged {
                evidence: RemovedNoOp { path: p_s },
                applied: target,
              }
            } else {
              Converged {
                evidence: RemovedConfirmed { paths: [p_s], exit_code: o.exit_code },
                applied: target,
              }
            }
          }
        }
    }
    }
  }
}

// A PATH'S STATE AS THE UNPRIVILEGED PROBE CAN ESTABLISH IT. `test -e` exits 1 both for an absent path
// and for a path it cannot stat (a parent without search permission), so a false is not absence; only
// containment under a searchable parent is (extdeps.posix.test_utility contained_existence). Any other
// status, or a refused transport, is Unreadable, and Unreadable never folds into Absent.
type HostRemovePathState
  = HostRemovePathPresent
  | HostRemovePathAbsent
  | HostRemovePathUnreadable { reason: String }

fn host_remove_state_present(state: HostRemovePathState) -> Bool {
  match state {
    HostRemovePathPresent => true
    HostRemovePathAbsent => false
    HostRemovePathUnreadable { reason: _ } => false
  }
}

fn host_remove_unreadable_reason(states: List<HostRemovePathState>) -> Optional<String> {
  fold_list(
    xs: states,
    empty: Absent,
    cons: fn(acc, st) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match st {
            HostRemovePathUnreadable { reason: r } => Present { value: r }
            HostRemovePathPresent => Absent
            HostRemovePathAbsent => Absent
          }
      }
    },
  )
}

// PURE: the test status as a reading. Exit 0 present, 1 absent-or-unstattable, anything else (or a
// refused transport) unreadable.
fn host_remove_reading(path: String, outcome: RunArgvTransportOutcome) -> PathExistenceReading {
  match outcome {
    RunArgvTransportRefused { reason: why } =>
      PathExistenceUnreadable { reason: join(["`test` on ", path, " was refused: ", why], "") as NonEmptyStr }
    RunArgvTransportObserved { observed: o } =>
      if o.exit_code == 0 {
        PathPresent
      } else if o.exit_code == 1 {
        PathAbsentOrUnstattable
      } else {
        PathExistenceUnreadable { reason: join(["`test` on ", path, " exited ", to_string(o.exit_code), ": ", o.stderr], "") as NonEmptyStr }
      }
  }
}

// PURE: the state a path reading plus its searchable-parent reading establish.
fn host_remove_state_of(path: String, parent: String, reading: PathExistenceReading, parent_reading: PathExistenceReading) -> HostRemovePathState {
  match contained_existence(path: path, parent: parent, parent_reading: parent_reading, child_reading: reading) {
    ContainedPresent => HostRemovePathPresent
    ContainedAbsent => HostRemovePathAbsent
    ContainedUnreadable { reason: r } => HostRemovePathUnreadable { reason: r as String }
  }
}

fn host_remove_parent_of(path: String) -> String {
  fold_list(
    xs: tree_path_prefixes(path: path),
    empty: "/",
    cons: fn(acc, part) { if part == "" { "/" } else { part } },
  )
}

// THE READ-BACK PROBE, OF THE ENTRY AND NOT ITS REFERENT. Unprivileged `test -L` then `test -e`
// (extdeps.posix.test_utility entry_existence_reading: lstat OR stat), so a symlink is Present whether
// it dangles, points into an unsearchable directory or loops on itself -- `test -e` alone follows the
// link and reads all three as false, and `rm` still removes the entry. A both-false reading is only
// trusted as absence when the parent is searchable (`test -x parent`); the parent is probed only then.
// The runner is a parameter so the same fold is driven by a control over supplied outcomes.
fn host_remove_entry_state(path: String, run: fn(ArgvCommand) -> RunArgvTransportOutcome) -> HostRemovePathState {
  let link = host_remove_reading(path: path, outcome: run(test_symbolic_link_command(path: path)))
  let reading = match link {
    PathPresent => PathPresent
    PathAbsentOrUnstattable => entry_existence_reading(link: link, follow: host_remove_reading(path: path, outcome: run(test_exists_command(path: path))))
    PathExistenceUnreadable { reason: _ } => entry_existence_reading(link: link, follow: host_remove_reading(path: path, outcome: run(test_exists_command(path: path))))
  }
  match reading {
    PathPresent => HostRemovePathPresent
    PathExistenceUnreadable { reason: r } => HostRemovePathUnreadable { reason: r as String }
    PathAbsentOrUnstattable => {
      let parent = host_remove_parent_of(path: path)
      host_remove_state_of(
        path: path,
        parent: parent,
        reading: reading,
        parent_reading: host_remove_reading(path: parent, outcome: run(test_executable_command(path: parent))),
      )
    }
  }
}

fn host_remove_probe_state(path: NonEmptyStr, transport: HostEffectTransport) -> HostRemovePathState {
  host_remove_entry_state(path: path as String, run: fn(c) { run_argv_over_host_effect_transport(command: c, transport: transport) })
}

// Probe every target path in order. A transport refusal is a path's Unreadable state, never absence.
fn host_remove_probe_states(paths: List<NonEmptyStr>, transport: HostEffectTransport) -> List<HostRemovePathState> {
  list_map(xs: paths, f: fn(path) { host_remove_probe_state(path: path, transport: transport) })
}

// THE LEAF — the thin impure leg over the host-effect transport. Ordered: pre-observe
// (unprivileged test per path), dispatch the elevated rm, read back, verdict. An unreadable
// pre-observation refuses BEFORE the rm is dispatched; the post-removal read is judged by the verdict.
fn host_remove_on_host(
  target: HostRemoveTarget,
  transport: HostEffectTransport,
) -> Reconciliation<HostRemoveTarget, HostRemoveEvidence> {
  // NO RUNTIME EMPTY-Roster GUARD. `RemoveForce.paths` is a FreeSemigroup, so a zero-path target
  // cannot be constructed and this leg has no branch for it -- every refusal it can return is one a
  // transport or a filesystem actually produced (review 81100 on #14144; ruling
  // nonemptiness_is_constructed_or_proved).
  let paths: List<NonEmptyStr> = match target {
    RemoveForce { paths: ps } => non_empty_to_list(xs: ps)
    RemoveEmptyDirectory { path: p } => [p]
    RemoveForceRecursive { path: p } => [p]
  }
  let pre_state = host_remove_probe_states(paths: paths, transport: transport)
  match host_remove_unreadable_reason(states: pre_state) {
    Present { value: why } =>
      NotConverged {
        reason: host_remove_reason(
          target: target,
          verb: "refused",
          detail: join(["the pre-removal state of a path could not be read, so no removal was dispatched: ", why], ""),
          pathfield: host_remove_path_field(target: target),
        ),
        applied: target,
      }
    Absent =>
      host_remove_verdict(
        target: target,
        pre_state: pre_state,
        outcome: run_argv_over_host_effect_transport(
          command: sudo_elevate_command(command: host_remove_target_inner_argv(target: target)),
          transport: transport,
        ),
        post_state: host_remove_probe_states(paths: paths, transport: transport),
      )
  }
}

// WHEN NO OWNER RESOLVES, THE OWNER READS ARE NOT PERFORMED AND SAY SO. The alternative -- issuing
// cat /proc//cgroup against a pid that does not exist and letting it fail -- would reach the same
// arms by accident and cost four round trips per pass to do it. Filling them with a
// positively-named HostReadFailed keeps the decode on one path (gunbc.build_cache.build_cache_endpoint_observe
// unreachable_is_a_read_state_not_a_short_circuit_note makes the same move for an unreachable host)
// while making the reason for the absence readable rather than inferred from a contrived errno.

data owner_facts_unread_detail: NonEmptyStr = "no single listening owner resolved at the endpoint, so the owner's cgroup, start time, principal and executable were not read"

// A TCP-ENDPOINT INSTANCE REFUSES RATHER THAN BEING OBSERVED THROUGH THE UNIX CHAIN. /proc/net/unix
// answers for unix sockets only; the TCP equivalent is /proc/net/tcp with its own hex-encoded
// address columns and its own decode, which nothing in this repository has modeled. No
// BuildCacheInstance in the tree carries a TCP endpoint today -- both ci_cache_instance and
// session_cache_instance are unix sockets -- so this is an unbuilt arm rather than a live gap, and
// it is a POSITIVE typed refusal so that the day one is authored it stops the line instead of being
// silently classified through a table that cannot see it. An earlier revision reached ss for both
// shapes, which appeared to support TCP and was never exercised against one; an untested arm that
// answers is worse than one that refuses.

fn build_cache_listen_inode_read(
  instance: BuildCacheInstance,
  transport: HostEffectTransport,
) -> EndpointInodeLookup {
  match instance.endpoint {
    SccacheServerTcpPort { port: _ } =>
      InodeLookupUndecided {
        detail: "this instance's endpoint is a TCP port; endpoint ownership for TCP would be read from /proc/net/tcp, which this repository has not modeled. Refusing rather than reporting an unobserved placement." as NonEmptyStr,
      }
    SccacheServerUnixSocket { path: p } =>
      listen_inode_at_path(
        read: build_cache_host_read(command: proc_net_unix_read_command(), transport: transport),
        path: p,
      )
  }
}

fn build_cache_fd_holder_read(
  listen_inode: EndpointInodeLookup,
  instance: BuildCacheInstance,
  transport: HostEffectTransport,
) -> EndpointListenerRead {
  match listen_inode {
    InodeLookupUndecided { detail: d } => ListenerUndecided { detail: d }
    ListenInodeFound { inode: n } =>
      fd_holder_of_find_output(read: build_cache_socket_holder_read(inode: n, transport: transport))
    NoListenEntryAtPath =>
      match instance.endpoint {
        SccacheServerTcpPort { port: _ } => ListenerNone
        SccacheServerUnixSocket { path: p } =>
          match build_cache_socket_inode_at_path(path: p, transport: transport) {
            Absent => ListenerNone
            Present { value: n } =>
              fd_holder_of_find_output(read: build_cache_socket_holder_read(inode: n, transport: transport))
          }
      }
  }
}

// WHEN THERE IS NO LISTEN ENTRY THE WALK STILL RUNS, against the inode read off the FILE rather
// than off /proc/net/unix, and that is the whole of clause (3). A socket with no LISTEN entry is
// either stale (nothing holds it) or held open by a process that is not listening (unlinking severs
// it). Those two states are indistinguishable without asking whether any descriptor resolves to the
// file's inode, so skipping the walk here because 'nothing is listening' would collapse them -- and
// collapse them in the direction that unlinks a live process's socket.

fn build_cache_socket_inode_at_path(path: NonEmptyStr, transport: HostEffectTransport) -> NonEmptyStr? {
  match build_cache_host_read_observed(command: stat_inode_command(path: path as String), transport: transport) {
    BuildCacheReadRefused { reason: _ } => none
    BuildCacheReadRan { observed: o } =>
      if o.success == true {
        match trim(o.stdout) {
          "" => none
          inode => Present { value: inode as NonEmptyStr }
        }
      } else {
        none
      }
  }
}

fn build_cache_socket_holder_read(inode: NonEmptyStr, transport: HostEffectTransport) -> HostRead {
  match transport {
    LocalShell => {
      let r = shell.Find.SocketInodeHolders(inode: inode)
      if r.success {
        HostReadText { text: r.stdout }
      } else {
        HostReadFailed {
          detail: concat("the /proc fd walk for this endpoint's socket inode failed: ", r.stderr) as NonEmptyStr,
        }
      }
    }
    SshShell { ssh_host: _ } => build_cache_host_read(command: socket_inode_holder_command(inode: inode), transport: transport)
    FleetSsh { target: _, context: _ } => build_cache_host_read(command: socket_inode_holder_command(inode: inode), transport: transport)
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      HostReadFailed {
        detail: "EnsureBuildCacheInstance cannot walk /proc over EmitArtifactThenThinRun; typed mismatch." as NonEmptyStr,
      }
  }
}

// THE `?` WILDCARDS ARE THE BRACKETS, and they are load-bearing rather than sloppy: -lname takes a
// GLOB, so the literal brackets of `socket:[12345]` would be read as a character class and match
// nothing. extdeps.tools.findutils carries that fact beside the flags; this function keeps the
// QUESTION -- which descriptor anywhere in /proc still resolves to this socket's inode -- which is
// the caller's, not findutils'.
fn socket_inode_holder_command(inode: NonEmptyStr) -> ArgvCommand {
  find_symlink_target_glob_command(
    search_root: "/proc",
    max_depth: 3,
    path_glob: "*/fd/*",
    link_target_glob: concat("socket:?", concat(inode as String, "?")),
  )
}

fn build_cache_endpoint_reads(
  instance: BuildCacheInstance,
  transport: HostEffectTransport,
) -> BuildCacheEndpointReads {
  let boot_id = build_cache_host_read(command: boot_id_read_command(), transport: transport)
  let path_kind = build_cache_path_kind_read(instance: instance, transport: transport)
  let listen_inode = build_cache_listen_inode_read(instance: instance, transport: transport)
  let listener = build_cache_fd_holder_read(listen_inode: listen_inode, instance: instance, transport: transport)
  match listener {
    ListenerOwnerPid { pid: pid } =>
      BuildCacheEndpointReads {
        boot_id: boot_id,
        path_kind: path_kind,
        listen_inode: listen_inode,
        listener: listener,
        owner_cgroup: build_cache_host_read(command: owner_cgroup_command(pid: pid), transport: transport),
        owner_proc_stat: build_cache_host_read(command: owner_proc_stat_command(pid: pid), transport: transport),
        owner_principal: build_cache_host_read(command: owner_principal_command(pid: pid), transport: transport),
        owner_executable: build_cache_host_read(command: owner_executable_command(pid: pid), transport: transport),
      }
    ListenerNone =>
      build_cache_reads_without_owner(boot_id: boot_id, path_kind: path_kind, listen_inode: listen_inode, listener: listener)
    ListenerAmbiguous { candidate_count: _ } =>
      build_cache_reads_without_owner(boot_id: boot_id, path_kind: path_kind, listen_inode: listen_inode, listener: listener)
    ListenerUndecided { detail: _ } =>
      build_cache_reads_without_owner(boot_id: boot_id, path_kind: path_kind, listen_inode: listen_inode, listener: listener)
  }
}

fn build_cache_reads_without_owner(
  boot_id: HostRead,
  path_kind: EndpointPathKind,
  listen_inode: EndpointInodeLookup,
  listener: EndpointListenerRead,
) -> BuildCacheEndpointReads {
  BuildCacheEndpointReads {
    boot_id: boot_id,
    path_kind: path_kind,
    listen_inode: listen_inode,
    listener: listener,
    owner_cgroup: HostReadFailed { detail: owner_facts_unread_detail },
    owner_proc_stat: HostReadFailed { detail: owner_facts_unread_detail },
    owner_principal: HostReadFailed { detail: owner_facts_unread_detail },
    owner_executable: HostReadFailed { detail: owner_facts_unread_detail },
  }
}

// THE UNLINK RUNS AS ITS OWN COMMAND BEFORE THE ENSURE, WHICH IS WHAT
// gunbc.build_cache.build_cache_endpoint_path no_unconditional_execstartpre_note REQUIRES. Folding it into the
// unit as ExecStartPre would unlink in every path state rather than the one state where unlinking
// is correct -- harmless under an absent path, destructive under a conflict, and silently fatal
// under a live listener. Here it is reached only from EndpointClearedByUnlink, which
// admit_stale_socket_unlink produces only from an observed stale socket under a current boot id,
// and a failure to remove the file refuses the whole effect rather than proceeding into a bind that
// error 98 would fail anyway.

fn build_cache_unlink_then_ensure(
  instance: BuildCacheInstance,
  preflight: EndpointPreflight,
  transport: HostEffectTransport,
  effect_intent: HostEffectIntent,
  observed_path: EndpointPathState,
  currency: ObservationCurrency,
  token: NonEmptyStr,
  digest: Digest,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match preflight {
    EndpointClearForBind =>
      build_cache_ensure_step(
        instance: instance, transport: transport, effect_intent: effect_intent,
        token: token, digest: digest,
      )
    EndpointClearedByUnlink { stale_detail: _ } =>
      match stale_socket_unlink_command(
        admission: admit_stale_socket_unlink(instance: instance, observed: observed_path, currency: currency),
      ) {
        StaleSocketUnlinkCommandRefused { reason: why } =>
          NotConverged {
            reason: join(
              ["host_effect_apply: EnsureBuildCacheInstance was admitted behind a stale-socket unlink that then refused to build a command -- ", why as String],
              "",
            ),
            applied: effect_intent,
          }
        StaleSocketUnlinkCommandReady { command: cmd } =>
          match build_cache_host_read_observed(command: cmd, transport: transport) {
            BuildCacheReadRefused { reason: why } =>
              NotConverged {
                reason: join(["host_effect_apply: EnsureBuildCacheInstance could not run the admitted stale-socket unlink -- ", why], ""),
                applied: effect_intent,
              }
            BuildCacheReadRan { observed: o } =>
              if o.success == true {
                build_cache_ensure_step(
                  instance: instance, transport: transport, effect_intent: effect_intent,
                  token: token, digest: digest,
                )
              } else {
                NotConverged {
                  reason: join(
                    [
                      "host_effect_apply: EnsureBuildCacheInstance refused -- the admitted stale-socket unlink exited ",
                      to_string(o.exit_code),
                      ", so the endpoint path is still occupied and a bind would fail with address-in-use: ",
                      o.stderr,
                    ],
                    "",
                  ),
                  applied: effect_intent,
                }
              }
          }
      }
  }
}

// TWO AUTHORITIES, TWO DIFFERENT QUESTIONS, ONE EACH SIDE OF THE ACT. gunbc.build_cache.build_cache_ensure
// admit_ensure_build_cache_instance is the PRECONDITION -- may this host be written to at all,
// given who owns the endpoint and what is at the path -- and it runs before the first mutation.
// gunbc.host.host_build_cache_provision provision_build_cache_verdict is the POSTCONDITION -- given what
// the ensure produced, is this host converged -- and it runs after. The shell-to-dag census C-note
// found both unconsumed and called them one wiring job; they are, and this is that job, but they
// are not one check applied twice: the precondition can refuse a host the postcondition would never
// see, and the postcondition catches the case that motivated it, an ensure that reports success
// while the endpoint ends up owned by something other than the unit just written.
//
// THE PLACEMENT IN THE POSTCONDITION IS RE-OBSERVED, NOT CARRIED FORWARD FROM THE PREFLIGHT.
// Reusing the preflight's placement would be asserting a fact measured before the mutation about
// the state after it, which is the read-back that greens on evidence it produced, one step removed.
// So the endpoint is surveyed again and the second survey is what the verdict folds -- which is
// also what makes the check discriminating: the whole point is that the pre-state and the
// post-state can differ.
//
// ONE RESIDUE, NAMED RATHER THAN DISCOVERED IN PRODUCTION: the post-survey races the unit start.
// systemctl restart returns when the unit is active, and the server binds its endpoint during its
// own startup, so there is a window in which the endpoint has no listener yet and the post-survey
// reads ServerPlacementAbsent -- a FALSE RefusalDaemonAbsent. It is bounded in the right direction:
// the failure is a loud refusal on an idempotent operation, so the next converge pass reads the
// settled state and converges, and no host is left silently misreported. It is NOT fixed here
// because fixing it properly means waiting on an observable readiness condition rather than
// sleeping, and a readiness predicate for this endpoint is its own piece of modeling. DISSOLVE-ON:
// an endpoint-readiness observation the ensure step can wait on, at which point the post-survey
// runs after it rather than after systemctl returns.

// THE TWO OPTIONAL READ OUTCOMES, each in a function whose RETURN TYPE is declared. A bare
// `Present { value: x }` / `Absent` pair unifies only where an expected type is pushed into it; inside a
// `let` (and inside a match arm) nothing is pushed, so each branch gets inferred on its own -- one as a
// bare Coproduct over the outcome, the other as a bare Coproduct over Optional -- and the join is
// refused. `Absent as Optional<T>` is not the answer either, being refused as a cast. Routing the two
// arms through declared-return-type functions is how the corpus writes this (extdeps/uri_validation.dag,
// gunbc/witness/witness_row_cost.dag), and it keeps the distinction the observer depends on: SKIPPED is
// its own value, not an empty capture.
fn build_cache_stats_read_present(
  command: ArgvCommand,
  transport: HostEffectTransport,
) -> Optional<BuildCacheHostRunOutcome> {
  Present { value: build_cache_argv_read_outcome(command: command, transport: transport) }
}

fn build_cache_stats_read_skipped() -> Optional<BuildCacheHostRunOutcome> {
  Absent
}

// THE EVIDENCE CARRIER FOR A CONVERGED ENSURE THAT RAN NO SHELL. toolchain_ensure_reconcile needs a
// ShellExecObserved to ground the reconciliation, and the honest one is the read-back the site ran: exit
// code, stdout and stderr exactly as the host produced them, with the converged stats table as the
// stdout the operator is shown. A read-back that could not run grounds NOTHING -- that arm cannot be
// reached from a converged verdict (the classifier refuses before it), and the false keeps that true
// rather than relying on the caller's discipline.
fn read_back_observed_carrier(read_back: Optional<BuildCacheHostRunOutcome>, stats_line: String) -> ShellExecObserved {
  match read_back {
    Present { value: Ran { observed: o } } =>
      ShellExecObserved {
        exit_code: o.exit_code,
        // DERIVED, not asserted. Nothing here claims success because the verdict arrived: success is what
        // the recorded exit code says it is, so a carrier can never be greener than the capture it came
        // from, and the fail-closed branch below stays reachable rather than being papered over.
        success: o.exit_code == 0,
        stdout: o.stdout,
        stderr: o.stderr,
      }
    _ => ShellExecObserved {
      exit_code: 1,
      success: false,
      stdout: stats_line,
      stderr: "host_effect_apply: the build-cache read-back never ran, so there is no capture to ground the convergence on",
    }
  }
}

fn build_cache_ensure_step(
  instance: BuildCacheInstance,
  transport: HostEffectTransport,
  effect_intent: HostEffectIntent,
  token: NonEmptyStr,
  digest: Digest,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let install_params = build_cache_sccache_install_params(arch_token: token, digest: digest)
  let presence = build_cache_daemon_presence_command(p: install_params)
  let stats = build_cache_daemon_stats_command()
  let presence_read = build_cache_argv_read_outcome(command: presence, transport: transport)
  // The script tested `[ -x BIN ]` and only then ran `--show-stats`; when the test failed it fell through
  // with rc 127 and the query never ran. Skipping it here keeps that, and keeps it a SKIP rather than a
  // fabricated empty capture: an absent read is its own arm, so "no stats read happened" can never be read
  // as "the daemon answered with nothing".
  let stats_read =
    match presence_read {
      Ran { observed: p_obs } =>
        if p_obs.exit_code == 0 {
          build_cache_stats_read_present(command: stats, transport: transport)
        } else {
          build_cache_stats_read_skipped()
        }
      CouldNotRun { phase: _, reason: _ } => build_cache_stats_read_skipped()
    }
  let observe = build_cache_observe_observed(presence: presence_read, stats: stats_read)
  let ensure_executed = build_cache_ensure_executed(
    instance: instance,
    arch_token: token,
    digest: digest,
    observe: observe,
    transport: transport,
  )
  // The read-back runs on exactly the paths the script reached it -- every observe outcome except the
  // observe=ok early exit -- and the site asks the SAME predicate the classifier asks, so the two can
  // never disagree about whether the phase happened.
  let read_back =
    if build_cache_ensure_is_needed(observe: observe) {
      build_cache_stats_read_present(command: stats, transport: transport)
    } else {
      build_cache_stats_read_skipped()
    }
  let after = survey_build_cache_endpoint(
    instance: instance,
    reads: build_cache_endpoint_reads(instance: instance, transport: transport),
  )
  match provision_build_cache_verdict(
    catalog_id: instance.implementation,
    observed: build_cache_daemon_ensure_observation(
      observe: observe,
      ensure: ensure_executed,
      read_back: read_back,
      placement: after.placement,
    ),
  ) {
    BuildCacheProvisionRefused { cause: _, reason: why } =>
      NotConverged {
        reason: join(
          ["host_effect_apply: EnsureBuildCacheInstance ran its ensure and the read-back refused -- ", why as String],
          "",
        ),
        applied: effect_intent,
      }
    BuildCacheProvisionConverged { catalog_id: _, stats_line: stats_line } =>
      // No shell ran, so nothing hands back a ShellExecObserved and none is faked: the carrier is built
      // from the captures the site ACTUALLY recorded -- the read-back exit code and the two streams the
      // host produced. That is more truthful than the receipt it replaces, which reported a single blob
      // the shell had assembled. This is the shape the shared reconcile already names ("synthesized
      // receipt from typed per-tool ensure results; fail-closed"), and the stats_line the verdict
      // converged on is the read-back table itself, so the evidence is the host's own bytes.
      provision_build_cache_reconcile(
        observed: read_back_observed_carrier(read_back: read_back, stats_line: stats_line),
        intent: effect_intent,
      )
  }
}

// THE ALREADY-CONVERGED ARM RETURNS ShellEffectApplied WITH exit_code 0 AND NO SHELL HAVING RUN,
// and that is worth stating because it looks like a fabricated receipt and is not.
// HostEffectEvidence has two arms and neither names an observation, so the evidence carrier cannot
// yet distinguish 'a command ran and succeeded' from 'a read established that nothing needed to
// run'. What the receipt carries is the observation itself -- the unit found owning the endpoint --
// rather than invented command output, so a reader sees WHY it converged. DISSOLVE-ON: a
// HostEffectEvidence arm for an observation-grounded convergence, at which point this arm names it
// and the exit_code 0 goes away. Until then the honest thing is to say so here rather than let the
// zero read as a process exit.

// THE COMPILE-POOL SLICE GETS ITS OWN EFFECT RATHER THAN RIDING THE CACHE ENSURE, AND THE SEAM IS THE POINT.
// gunbc.compile_pool_ensure admit_ensure_compile_pool_slice refuses on TOPOLOGY before it observes anything,
// and gunbc_compile_pool_placement is CompilePoolInRunnerSlots today, so folding this admission into
// realize_provision_build_cache_body as a precondition would make EnsureBuildCacheInstance refuse on every
// host in the fleet. A lane that halts another lane to express a dependency has chosen the wrong seam: the
// pool is a separate desired state with a separate unit file, so it is a separate effect whose refusal costs
// nothing that was already converging. (Parent ruling, warm-tern-755, 2026-08-23.)
//
// WHAT IT ANSWERS TODAY, so this is not read as a description of a working fleet: EnsurePoolTopologyUndeclared,
// on every host, naming gunbc_compile_pool_placement as the cause. That is the correct answer and the landing
// state -- no host has a managed slice, and the flip of that row is the change this converger exists to make
// possible. gunbc_compile_pool_placement's own dissolution trigger says to flip it in the same change that
// converges the managed unit AND ITS SLICE; the unit had a converger and the slice had none.
//
// THE EFFECT CARRIES NO PAYLOAD, AND THAT IS DELIBERATE AFTER THE A5 LESSON. EnsureBuildCacheInstance carries
// its BuildCacheInstance because the desired daemon is a row a realizer would otherwise have to guess. The
// pool's desired state is not a row: the slice NAME comes from the topology and the SIZE is derived by
// gunbc.fleet.fleet_host_budget compile_pool_bytes_for (which refuses a separate pool now that the jobserver sizing is retired). Putting either on the effect
// would mint a second answer to a question that already has one authority, so the effect names the target host
// and the derivation happens here from that host's own facts.
// WHICH SLICE IS OBSERVED WHEN THE TOPOLOGY DECLARES NONE. Under CompilePoolInRunnerSlots there is no declared
// slice to read, and the observation is a parameter the admission takes whether or not it consults it -- it
// refuses on topology first. The subject is therefore the slice gunbc.host.host_layout names, which makes the read
// a true statement about the host (that unit really is what a managed pool would be called there) rather than
// a fabricated subject, and keeps the read unconditional so it cannot become a function of the answer it
// feeds. It also produces a real finding for free: on a host where the topology says no pool is managed and
// the slice nevertheless exists, the reading is there in the observation rather than being unasked. Note the
// layout row and the topology row are two authorities on ONE question -- whether a managed pool is declared --
// and they disagree today; that disagreement is a standing hazard recorded on this PR, not something this
// function resolves.
fn compile_pool_observation_subject(placement: CompilePoolPlacement) -> NonEmptyStr {
  match placement {
    CompilePoolSliceDeclared { slice_unit: declared } => declared as NonEmptyStr
    CompilePoolInRunnerSlots => gunbc_managed_compile_pool_slice
  }
}

fn compile_pool_ensure_refusal_detail(reason: CompilePoolEnsureRefusal) -> String {
  match reason {
    EnsurePoolTopologyUndeclared { detail: d } => d as String
    EnsurePoolSizingUnresolved { detail: d } => d as String
    EnsureCachePlacementUnknown { detail: d } => d as String
    EnsurePoolSliceUnobservable { detail: d } => d as String
    EnsurePoolSliceNamedDoesNotMatch { declared: dec, observed: obs } =>
      join(
        ["the declared compile-pool slice is ", dec as String, " but the host answers for ", obs as String],
        "",
      )
  }
}

fn compile_pool_slice_system_path(slice_unit: NonEmptyStr) -> String {
  concat("/etc/systemd/system/", slice_unit as String)
}

// THE STAGING FOLD. The install is five typed operations derived entirely before the first one runs,
// each built by the extdeps builder that owns its tool's flags. EVERY op that touches
// /etc/systemd/system elevates through /usr/bin/sudo -n, dd and the discard included: the staged
// sibling lives in that root-owned directory and the invoking principal is not root (the reviewer's
// catch, review 74182 -- the shape was dry-witnessable and still unrunnable). The unit bytes cross
// as STDIN DATA to sudo dd (of= truncates and overwrites the staged sibling; status=none keeps dd's statistics line out of
// the command log; tee is refused for the reason recorded at gunbc.typed_remote_file_write -- it
// echoes the bytes into their own log); a sudo install -m 0644 moves them into /etc/systemd/system
// (install(1) rather than mv because owner-at-creation means the wrongly-owned intermediate state has
// no moment in which to exist, the same reason the gnu_coreutils install section records; the mode
// rides the install, so there is no separate chmod op); then sudo systemctl daemon-reload and sudo
// systemctl START -- never restart. Stopping a slice kills every process in it (systemd.slice(5)), so
// restarting the compile pool would terminate the compilers it exists to hold, which is the opposite
// of converging it. `start` on an already-active slice re-applies the unit's resource directives and
// kills nothing. The discard rm -f of the staged sibling runs in BOTH arms -- the idempotent
// counterpart of the EXIT trap the shell body used to carry, elevated like the write it undoes.
//
// THE STAGED PATH IS A SIBLING OF THE DESTINATION, NOT A MKTEMP. `dest ++ .gunbc-stage` makes the
// whole op list DERIVABLE BEFORE ANYTHING RUNS -- a dry witness can name every argv and the order the
// fold runs them in, which the mktemp -d the shell body used made structurally impossible (the stage
// directory existed only once the script was mid-flight, so the witness could only describe the
// template). It also makes convergence self-repairing: a staged file left by a crashed run is
// overwritten by the next dd and discarded by the next fold, and the privileged install never crosses
// a filesystem boundary because the rename stays within /etc/systemd/system.
//
// THE BYTES INSTALLED ARE THE BYTES THE ADMISSION ADMITTED. The fold serializes the SystemdUnitFile
// gunbc.build_cache.build_cache_unit rendered from the derived size rather than re-rendering from the same
// inputs. Re-rendering would be a second construction of one artifact, and the failure it admits is
// not hypothetical: the admission could be granted against one size and the file written from
// another with nothing between them to notice.
//
// THE REFUSAL ARM, AND WHY THE UNIT BODY NEEDS NO REFUSAL OF ITS OWN. A slice unit name carrying '/'
// would place the unit outside /etc/systemd/system/; systemd unit names never contain one
// (systemd.unit(5)), so a slash names a malformed unit rather than a path, and the fold refuses at
// staging -- BEFORE any operation exists to run. The unit FILE's bytes need no refusal arm at all:
// they cross as stdin data to dd, so no metacharacter in them can change any command's meaning,
// which is the property the shell body could only approximate by routing every word through
// bash_build serializers.
type CompilePoolInstallStaging
  = CompilePoolInstallReady {
      stage_write: ArgvCommand
      install: ArgvCommand
      daemon_reload: ArgvCommand
      start: ArgvCommand
      discard_stage: ArgvCommand
    }
  | CompilePoolInstallRefused { reason: String }

data compile_pool_slice_file_mode: NonEmptyStr = "0644" as NonEmptyStr

data compile_pool_slice_stage_suffix: String = ".gunbc-stage"

fn compile_pool_slice_install_staging(slice_unit: NonEmptyStr) -> CompilePoolInstallStaging {
  if string_contains(s: slice_unit as String, pattern: "/") {
    CompilePoolInstallRefused {
      reason: "the slice unit name carries '/', which would place the unit outside /etc/systemd/system/; systemd unit names never contain one (systemd.unit(5)), so this is a malformed name rather than a path",
    }
  } else {
    let dest = compile_pool_slice_system_path(slice_unit: slice_unit)
    let staged = concat(dest, compile_pool_slice_stage_suffix)
    CompilePoolInstallReady {
      stage_write: sudo_elevate_command(command: argv_words(command: dd_overwrite_path_command(path: staged))),
      install: sudo_elevate_command(command: coreutils_install_file_argv(mode: compile_pool_slice_file_mode, source: staged, dest: dest)),
      daemon_reload: extdeps.systemd.systemctl.systemctl_daemon_reload_command(),
      start: systemctl_start_command(unit: slice_unit),
      discard_stage: sudo_elevate_command(command: argv_words(command: rm_force_command(path: staged))),
    }
  }
}

fn compile_pool_ensure_admission_for(
  node: ComputeHost,
  transport: HostEffectTransport,
) -> EnsureCompilePoolAdmission {
  let placement = gunbc_compile_pool_placement
  let instance = ci_cache_instance(host: node.identity)
  let survey = survey_build_cache_endpoint(
    instance: instance,
    reads: build_cache_endpoint_reads(instance: instance, transport: transport),
  )
  admit_ensure_compile_pool_slice(
    topology: placement,
    sizing: compile_pool_sizing_for_host(node: node, placement: placement),
    cache_placement: survey.placement,
    observed: observe_compile_pool_slice(
      transport: transport,
      slice_unit: compile_pool_observation_subject(placement: placement),
    ),
  )
}

// The size is DERIVED here from the target host's own facts rather than travelling on the effect, through the
// same compile_pool_bytes_for gunbc.ci.ci_runner_placement uses to shrink the runner pool. The two must agree or
// the host stops conserving, and they agree because there is one derivation, not because two call sites were
// kept in step.
fn compile_pool_sizing_for_host(node: ComputeHost, placement: CompilePoolPlacement) -> CompilePoolResolution {
  compile_pool_bytes_for(placement: placement)
}

// The admission runs TWICE and the second run is not a formality: it is the postcondition, re-derived from a
// FRESH observation of the host rather than from the state we just wrote. A read-back that reused the
// preflight observation would green on evidence it produced -- the exact defect
// provision_observes_before_it_acts_note records from srv3 -- and the whole point is that the pre-state and
// the post-state can differ. Convergence is claimed only when the second admission answers
// EnsureCompilePoolAlreadyConverged, which is the same predicate the preflight uses to skip the write.
// The write arm is the one arm whose failure can leave PARTIAL state behind: dd receiving unit bytes
// on stdin can write some bytes and still exit nonzero, and the staged sibling then survives until
// some later install moves it. So the write-failure arm is not an exception to the discard pair the
// other failure arms run -- cleanup is attempted before reporting, and the discard's own exit status
// rides in the reason, so a failed discard is visible rather than silent.
fn compile_pool_slice_install_step(
  node: ComputeHost,
  slice_unit: NonEmptyStr,
  sized: ByteSize,
  slice_unit_file: SystemdUnitFile,
  transport: HostEffectTransport,
  effect_intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match compile_pool_slice_install_staging(slice_unit: slice_unit) {
    CompilePoolInstallRefused { reason: r } =>
      NotConverged {
        reason: join(
          [
            "host_effect_apply: EnsureCompilePoolSlice refused at staging before any operation ran -- ",
            r as String,
          ],
          "",
        ),
        applied: effect_intent,
      }
    CompilePoolInstallReady { stage_write: write, install: install, daemon_reload: reload, start: start, discard_stage: discard } => {
      let written = run_argv_stdin_over_host_effect_transport(
        command: write,
        stdin_payload: serialize_systemd_unit_file(file: slice_unit_file),
        transport: transport,
      )
      if !run_argv_transport_succeeded(outcome: written) {
        let discarded = run_argv_over_host_effect_transport(command: discard, transport: transport)
        compile_pool_install_failed_step_result(
          failed_step: "stage write",
          slice_unit: slice_unit,
          observed: written,
          discarded: discarded,
          effect_intent: effect_intent,
        )
      } else {
        let installed = run_argv_over_host_effect_transport(command: install, transport: transport)
        if !run_argv_transport_succeeded(outcome: installed) {
          let discarded = run_argv_over_host_effect_transport(command: discard, transport: transport)
          compile_pool_install_failed_step_result(
            failed_step: "install",
            slice_unit: slice_unit,
            observed: installed,
            discarded: discarded,
            effect_intent: effect_intent,
          )
        } else {
          let reloaded = run_argv_over_host_effect_transport(command: reload, transport: transport)
          if !run_argv_transport_succeeded(outcome: reloaded) {
            let discarded = run_argv_over_host_effect_transport(command: discard, transport: transport)
            compile_pool_install_failed_step_result(
              failed_step: "daemon-reload",
              slice_unit: slice_unit,
              observed: reloaded,
              discarded: discarded,
              effect_intent: effect_intent,
            )
          } else {
            let started = run_argv_over_host_effect_transport(command: start, transport: transport)
            let discarded = run_argv_over_host_effect_transport(command: discard, transport: transport)
            match started {
              RunArgvTransportRefused { reason: _ } =>
                compile_pool_install_failed_step_result(
                  failed_step: "start",
                  slice_unit: slice_unit,
                  observed: started,
                  discarded: discarded,
                  effect_intent: effect_intent,
                )
              RunArgvTransportObserved { observed: s } =>
                if !s.success {
                  compile_pool_install_failed_step_result(
                    failed_step: "start",
                    slice_unit: slice_unit,
                    observed: started,
                    discarded: discarded,
                    effect_intent: effect_intent,
                  )
                } else {
                  let after = compile_pool_ensure_admission_for(node: node, transport: transport)
                  if compile_pool_ensure_is_converged(admission: after) {
                    Converged {
                      evidence: ShellEffectApplied {
                        exit_code: s.exit_code,
                        stdout: join(
                          [
                            "CompilePoolSliceReceipt: converged unit=",
                            slice_unit as String,
                            " memory.max=memory.high=",
                            to_string(byte_size_count(b: sized)),
                            " (re-observed after install; the admission answered already-converged)",
                          ],
                          "",
                        ),
                        stderr: s.stderr,
                      },
                      applied: effect_intent,
                    }
                  } else {
                    NotConverged {
                      reason: join(
                        [
                          "host_effect_apply: EnsureCompilePoolSlice installed ",
                          slice_unit as String,
                          " and the read-back did not converge -- ",
                          compile_pool_admission_diagnostic(admission: after),
                        ],
                        "",
                      ),
                      applied: effect_intent,
                    }
                  }
                }
            }
          }
        }
      }
    }
  }
}

// THE STEP-LEVEL FAILURE LINE, one per op so a failed fold names the op that failed rather than
// leaving five exit codes to disambiguate. The old text said "the shell exited"; there is no shell
// on this edge anymore, so the line says the OPERATION exited and which one.
fn compile_pool_install_stage_failure(step: String, slice_unit: NonEmptyStr, observed: ShellExecObserved) -> String {
  join(
    [
      "host_effect_apply: EnsureCompilePoolSlice ran its ",
      step,
      " over ",
      slice_unit as String,
      " and the operation exited ",
      to_string(observed.exit_code),
      ": ",
      if observed.stderr == "" { observed.stdout } else { observed.stderr },
    ],
    "",
  )
}

// THE STEP-LEVEL FAILURE LINE, one per op so a failed fold names the op that failed rather than
// leaving five exit codes to disambiguate, AND TRUTHFUL ABOUT WHICH FAILURE HAPPENED (review: the
// SSH refusal must stay typed). A refused outcome never started a process, so its line says the
// step DID NOT RUN and carries the wall's own admission text; an observed outcome ran, so its line
// says the OPERATION exited and which one, from the observation's real exit status. The old text
// said "the shell exited"; there is no shell on this edge anymore.
fn compile_pool_install_step_failure_line(step: String, slice_unit: NonEmptyStr, outcome: RunArgvTransportOutcome) -> String {
  match outcome {
    RunArgvTransportRefused { reason: why } =>
      join(
        [
          "host_effect_apply: EnsureCompilePoolSlice did not run its ",
          step,
          " over ",
          slice_unit as String,
          " -- ",
          why,
        ],
        "",
      )
    RunArgvTransportObserved { observed: o } =>
      compile_pool_install_stage_failure(step: step, slice_unit: slice_unit, observed: o)
  }
}

// THE DISCARD LEG'S REPORT, same split. An observed discard names its exit status, so a failed
// cleanup is visible rather than silent; a refused discard says so -- the wall stopped that leg
// before any ssh connection, and no exit status exists to report.
fn compile_pool_install_discard_line(outcome: RunArgvTransportOutcome) -> String {
  match outcome {
    RunArgvTransportObserved { observed: o } =>
      join([" (staged bytes discarded, exit ", to_string(o.exit_code), ")"], "")
    RunArgvTransportRefused { reason: why } =>
      join([" (the staged-byte discard did not run either -- ", why, ")"], "")
  }
}

// Whether the transport runner's leg did its job: only an OBSERVED outcome with exit status zero
// counts. A refusal is a failed step for sequencing purposes -- but the failure fold below still
// says what kind of failure it was, which is the whole point of keeping the coproduct.
fn run_argv_transport_succeeded(outcome: RunArgvTransportOutcome) -> Bool {
  match outcome {
    RunArgvTransportRefused { reason: _ } => false
    RunArgvTransportObserved { observed: o } => o.success
  }
}

// THE INSTALL SEQUENCE'S FAILURE DECISION, AS A PURE FOLD OVER SUPPLIED OUTCOMES (DESIGN 3: the
// witness discriminates at this interface, and the values are supplied -- no operation, no ssh, no
// sudo, no network). compile_pool_slice_install_step runs the staged operations in order and, when
// one fails, hands THIS fold the failed step's own outcome and the outcome the discard leg brought
// back. The fold's whole decision is the failure sequence: the cleanup is ATTEMPTED BEFORE the
// failure is reported -- its outcome is a parameter, so a caller that skipped the second leg could
// not produce this call -- and the report carries the failed step plus the discard verdict, each
// routed through its own line so a refused-before-execution leg is never described as a process
// that ran. The wet step is the only side that can run the operations, so it is the only side that
// can supply these values; all four failure arms delegate here, which makes this fold the
// sequence's single decision point -- the witness supplies DESIGNED outcomes (a failed write, a
// failing cleanup, a wall refusal) and pins the same NotConverged the wet fold returns.
fn compile_pool_install_failed_step_result(
  failed_step: String,
  slice_unit: NonEmptyStr,
  observed: RunArgvTransportOutcome,
  discarded: RunArgvTransportOutcome,
  effect_intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  NotConverged {
    reason: join(
      [
        compile_pool_install_step_failure_line(step: failed_step, slice_unit: slice_unit, outcome: observed),
        compile_pool_install_discard_line(outcome: discarded),
      ],
      "",
    ),
    applied: effect_intent,
  }
}


fn compile_pool_admission_diagnostic(admission: EnsureCompilePoolAdmission) -> String {
  match admission {
    EnsureCompilePoolAlreadyConverged { slice_unit: u, sized_bytes: _ } =>
      join(["the slice ", u as String, " is converged"], "")
    EnsureCompilePoolAdmitted { slice_unit: u, sized_bytes: _, slice_unit_file: _ } =>
      join(
        ["the slice ", u as String, " is still admitted for writing, so the installed unit did not take effect on the host"],
        "",
      )
    EnsureCompilePoolRefused { reason: r } => compile_pool_ensure_refusal_detail(reason: r)
  }
}

fn realize_ensure_compile_pool_slice(
  transport: HostEffectTransport,
  effect_intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match effect_intent.target {
    RunnerLocalHost =>
      NotConverged {
        reason: "host_effect_apply: EnsureCompilePoolSlice requires a fleet-addressed HostOs target; fail-closed.",
        applied: effect_intent,
      }
    BmcController { node: _ } =>
      NotConverged {
        reason: "host_effect_apply: EnsureCompilePoolSlice requires a HostOs target; fail-closed.",
        applied: effect_intent,
      }
    HostOs { node: node } =>
      match transport {
        EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
          NotConverged {
            reason: "host_effect_apply: EnsureCompilePoolSlice cannot use EmitArtifactThenThinRun transport; typed mismatch.",
            applied: effect_intent,
          }
        LocalShell => realize_ensure_compile_pool_slice_body(node: node, transport: transport, effect_intent: effect_intent)
        SshShell { ssh_host: _ } => realize_ensure_compile_pool_slice_body(node: node, transport: transport, effect_intent: effect_intent)
        FleetSsh { target: _, context: _ } => realize_ensure_compile_pool_slice_body(node: node, transport: transport, effect_intent: effect_intent)
      }
  }
}

fn realize_ensure_compile_pool_slice_body(
  node: ComputeHost,
  transport: HostEffectTransport,
  effect_intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match compile_pool_ensure_admission_for(node: node, transport: transport) {
    EnsureCompilePoolRefused { reason: r } =>
      NotConverged {
        reason: join(
          [
            "host_effect_apply: EnsureCompilePoolSlice refused before writing anything -- ",
            compile_pool_ensure_refusal_detail(reason: r),
          ],
          "",
        ),
        applied: effect_intent,
      }
    EnsureCompilePoolAlreadyConverged { slice_unit: u, sized_bytes: b } =>
      Converged {
        evidence: ShellEffectApplied {
          exit_code: 0,
          stdout: join(
            [
              "CompilePoolSliceReceipt: already_converged unit=",
              u as String,
              " memory.max=memory.high=",
              to_string(byte_size_count(b: b)),
              " (observed on the host; no unit written, no start issued)",
            ],
            "",
          ),
          stderr: "",
        },
        applied: effect_intent,
      }
    EnsureCompilePoolAdmitted { slice_unit: u, sized_bytes: b, slice_unit_file: f } =>
      compile_pool_slice_install_step(
        node: node,
        slice_unit: u,
        sized: b,
        slice_unit_file: f,
        transport: transport,
        effect_intent: effect_intent,
      )
  }
}

fn build_cache_already_converged(
  unit: NonEmptyStr,
  effect_intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  Converged {
    evidence: ShellEffectApplied {
      exit_code: 0,
      stdout: join(
        [
          "BuildCacheProvisionReceipt: already_converged unit=",
          unit as String,
          " (observed owning AND listening on the configured endpoint; no unit written, no restart issued)",
        ],
        "",
      ),
      stderr: "",
    },
    applied: effect_intent,
  }
}

// ═══════════════════════════════════════════════════════════════════════════
// THE MICROVM CONTROLLER INSTALL AS TYPED EFFECTS (census W5)
//
// This block retires gunbc.live_deploy.emit microvm_controller_install_script
// and the retained_srvn wrapper that carried it. Every leg is argv data run
// through the typed transport runners: there is no shell on this edge, so
// there is no `set -euo pipefail` to carry, no `mktemp -d` stage to clean, and
// no `|| exit 1` to translate. Fail-fast is the fold's shape rather than a
// shell option, and each refusal names the step that refused.
//
// THE SHAPE IS THE ONE THE RETIRED PIPELINE RAN (emit.dag
// microvm_controller_install_intent, in order): the approval-broker tree
// install (W6's vertical, consumed as ONE leg -- approval_broker_tree_install,
// never re-implemented here), the four owner-owned receipt directories, the
// firecracker vmm install, the workspace image install, the slot/executor unit
// writes, the sudoers dispatch grant, and the daemon reload last.
//
// THE W5 INVARIANT, AS A PROPERTY OF THE STEP LIST AND NOT A HOPE: the edge
// writes TEMPLATE units and reloads the manager; it NEVER starts, enables,
// disables, restarts, kills, or masks an instance. That is checked per step by
// microvm_controller_starts_no_instance_refusal, whose text cites systemd(1)
// and this wave's premise (an additive locus + template unit; slot instances
// start at their own edge).
// ═══════════════════════════════════════════════════════════════════════════

// THREE STEP ARMS, because three things can be true of a leg. An ARGV leg is
// words, optionally with bytes on stdin, run and required to exit zero. A
// VERIFY leg is words run, required to exit zero, with its stdout digest field
// compared to a PINNED value -- the typed form of the retired
// `echo '<hex>  <path>' | sha256sum -c -`, which coupled the expected value
// into the command's spelling. A RECEIPT leg observes two paths' digests and
// installs the observed lines as data on stdin. Each carries its name so a
// fold failure says which leg refused.
type MicrovmControllerInstallStep
  = MicrovmControllerArgvStep {
      name: String,
      command: ArgvCommand,
      stdin_payload: String,
    }
  | MicrovmControllerVerifyStep {
      name: String,
      command: ArgvCommand,
      expected: Digest,
      subject: String,
    }
  | MicrovmControllerReceiptStep {
      name: String,
      observe: ArgvCommand,
      observe2: ArgvCommand,
      write: ArgvCommand,
      subject: String,
    }
  // THE TREE COPY, AS ONE LEG OF THIS PLAN. Its argv belongs to W6's vertical
  // (approval_broker_tree_install, PR 14138, witnessed there), so this arm
  // carries NO argv of its own -- which is exactly what makes the witness claim
  // "this edge builds no second tree copy" checkable: the leg is in the plan and
  // spells no words.
  | MicrovmControllerTreeStep {
      name: String,
    }

// THE STAGED PLAN, or the reason there is none. Planning is total: the whole
// step list exists (in order) before any effect runs, so a witness can read
// the shape of the edge without touching a substrate, and a refused plan means
// no effect ran at all.
type MicrovmControllerInstallStaging
  = MicrovmControllerInstallReady { steps: List<MicrovmControllerInstallStep> }
  | MicrovmControllerInstallRefused { reason: String }

// THE EDGE EVERY REFUSAL AND VERDICT NAMES, so a failure says which edge
// refused rather than only that something failed.
data microvm_controller_install_edge: String = "host_effect_apply: MicrovmControllerInstall"

// THE STAGING SUFFIX AND THE TWO WRITES' MODES. The staged path is a
// deterministic sibling of the destination (compile_pool's precedent at
// compile_pool_slice_stage_path) rather than an mktemp -d name: nothing in a
// typed argv can carry a shell variable, so the stage must be a value the
// plan knows and a witness can pin.
data microvm_controller_stage_suffix: String = ".gunbc-stage"
data microvm_controller_unit_mode: NonEmptyStr = "0644" as NonEmptyStr
data microvm_controller_grant_mode: NonEmptyStr = "0440" as NonEmptyStr

// THE TWO CONSTRUCTORS THE STEP LIST USES, so no leg spells an argv arm by
// hand and the "no bytes on stdin" default lives in one place.
fn microvm_controller_argv_step(name: String, command: ArgvCommand) -> MicrovmControllerInstallStep {
  MicrovmControllerArgvStep { name: name, command: command, stdin_payload: "" }
}

fn microvm_controller_stdin_step(name: String, command: ArgvCommand, stdin_payload: String) -> MicrovmControllerInstallStep {
  MicrovmControllerArgvStep { name: name, command: command, stdin_payload: stdin_payload }
}

// THE OWNED-DIRECTORY LEG, ONE PATH PER STEP. install(1) -d sets mode and
// owner AT CREATION, so there is no wrongly-owned intermediate state; each
// path is its own step so a failure names the directory that failed rather
// than a batch. The retired pipeline ran `install -d -m 0755 -o OWNER -g OWNER`
// for each of these via install_d_owned_for_user; the flags are the same words.
fn microvm_controller_owned_dir_argv(path: String) -> List<String> {
  coreutils_install_directory_owned_argv(
    mode: install_d_shared_mode,
    owner: microvm_controller_owner,
    group: microvm_controller_owner,
    path: path,
  )
}

// A CONTENT WRITE AND ITS INSTALL, AS TWO STEPS. The bytes are the command's
// stdin payload -- never a quoted word in a command string, which is where the
// retired `printf '%s' '<content>' > stage` could have had a quoting surface.
// dd writes the staged sibling (O_TRUNC, so a stale stage cannot survive);
// install -m -o -g moves it into place with ownership set at creation, so the
// live path is never briefly world-readable or root-only.
fn microvm_controller_staged_write_steps(name: String, dest: String, mode: NonEmptyStr, content: String) -> List<MicrovmControllerInstallStep> {
  let staged = concat(dest, microvm_controller_stage_suffix)
  [
    microvm_controller_stdin_step(
      name: join([name, " (stage)"], ""),
      command: sudo_elevate_command(command: argv_words(command: dd_overwrite_path_command(path: staged))),
      stdin_payload: content,
    ),
    microvm_controller_argv_step(
      name: join([name, " (install)"], ""),
      command: sudo_elevate_command(command: coreutils_install_file_owned_argv(
        mode: mode,
        owner: microvm_controller_owner,
        group: microvm_controller_owner,
        source: staged,
        dest: dest,
      )),
    ),
  ]
}

// THE STEP ACCESSORS A WITNESS READS THE PLAN THROUGH. Each projects one field
// out of the three arms, so a claim about the plan does not have to match all
// three arms itself (and so a claim cannot quietly inspect only the arm that
// supports it).
fn microvm_controller_step_name(step: MicrovmControllerInstallStep) -> String {
  match step {
    MicrovmControllerArgvStep { name: n } => n
    MicrovmControllerVerifyStep { name: n } => n
    MicrovmControllerReceiptStep { name: n } => n
    MicrovmControllerTreeStep { name: n } => n
  }
}

fn microvm_controller_step_words(step: MicrovmControllerInstallStep) -> List<String> {
  match step {
    MicrovmControllerArgvStep { command: c } => argv_words(command: c)
    MicrovmControllerVerifyStep { command: c } => argv_words(command: c)
    MicrovmControllerReceiptStep { observe: o, observe2: t, write: w } =>
      concat(argv_words(command: o), concat(argv_words(command: t), argv_words(command: w)))
    MicrovmControllerTreeStep { name: _ } => []
  }
}

// THE WORDS A STEP RUNS, AS TEXT -- the surface a shell claim is made against.
// A stdin payload is deliberately NOT included: it is bytes the receiving
// program reads, not words any shell parses, and the claim that distinguishes
// the two is microvm_controller_step_stdin below.
fn microvm_controller_step_text(step: MicrovmControllerInstallStep) -> String {
  join(microvm_controller_step_words(step: step), " ")
}

fn microvm_controller_step_stdin(step: MicrovmControllerInstallStep) -> String {
  match step {
    MicrovmControllerArgvStep { stdin_payload: p } => p
    MicrovmControllerVerifyStep { command: _, expected: _, subject: _ } => ""
    MicrovmControllerReceiptStep { observe: _, observe2: _, write: _ } => ""
    MicrovmControllerTreeStep { name: _ } => ""
  }
}

// THE W5 INVARIANT AS A TYPED REFUSAL. This edge makes units known; starting a
// slot instance belongs to its own edge (systemd(1): `systemctl start`
// "starts (activates) the given units"; this wave's premise is an additive
// locus plus TEMPLATE units). A step whose argv carries a lifecycle verb is a
// defect in this plan, not a host condition, so it refuses at PLAN time --
// before any effect exists to have started something.
data microvm_controller_forbidden_systemd_verbs: List<String> = [
  "start", "starts", "restart", "reloads", "reload-or-restart", "kill", "signal",
  "wake-up", "reboot", "resume", "suspend", "poweroff", "halt",
]

// THE LIFECYCLE-VERB TEST, ONE AUTHORITY. Given a step's words, returns the
// offending verb or "". `daemon-reload` and the read-only verbs are admitted
// explicitly: this edge's own legitimate systemctl leg must survive the check,
// so the check is about the VERB and not about the program's name.
data microvm_controller_readonly_systemd_verbs: List<String> = ["daemon-reload", "status", "is-enabled", "show", "list-units"]

fn microvm_controller_systemd_lifecycle_word(words: List<String>) -> String {
  fold(
    words,
    init: "",
    f: (acc, w) =>
      if acc != "" {
        acc
      } else if any(microvm_controller_readonly_systemd_verbs, v => v == w) {
        acc
      } else if any(microvm_controller_forbidden_systemd_verbs, v => v == w) {
        w
      } else {
        acc
      },
  )
}

// THE WITNESS'S HOOK: does THIS command carry a lifecycle verb? A witness can
// ask it of a command built by the production systemctl builder, so the red
// below is not a string I authored to match my own list.
fn microvm_controller_start_word_reported(command: ArgvCommand) -> Bool {
  microvm_controller_systemd_lifecycle_word(words: argv_words(command: command)) != ""
}

fn microvm_controller_starts_no_instance_refusal(step: MicrovmControllerInstallStep) -> String {
  let words = microvm_controller_step_words(step: step)
  let offending = microvm_controller_systemd_lifecycle_word(words: words)
  if offending == "" {
    ""
  } else {
    join([
      microvm_controller_install_edge, " refuses before any operation ran: step '",
      microvm_controller_step_name(step: step),
      "' carries the systemctl lifecycle verb '", offending
      "', which would start or alter instance state; this edge writes template units and reloads the manager only (systemd(1)), and slot instances start at their own edge",
    ], "")
  }
}

// THE MALFORMED-NAME REFUSALS. A unit name carrying '/' would place the unit
// outside its unit directory; a slot name is a template instance name, so both
// are checked on the plan rather than trusted.
fn microvm_controller_unit_name_refusal(name: String, kind: String) -> String {
  if string_contains(s: name, pattern: "/") {
    join([
      microvm_controller_install_edge, " refused before any operation ran: the ", kind,
      " unit name '", name, "' carries '/', which would place the unit outside its unit directory; systemd unit names never contain one (systemd.unit(5))",
    ], "")
  } else {
    ""
  }
}

// THE PINNED RELEASE DIGEST, AS DATA. The retired script echoed this hex into
// a `sha256sum -c -` string; here it is the expected value of a VerifyStep, and
// an unpinned or unpinnable row refuses the plan rather than skipping the check.
fn microvm_controller_kernel_pinned_digest() -> Digest {
  sha256_digest(hex: firecracker_release_aarch64_tarball_sha256)
}

// THE PINNED-DIGEST REFUSAL. The retired pipeline could not have run with an
// empty pin either -- `echo '  file' | sha256sum -c -` fails -- but it failed
// ON THE HOST, after the download. Here an empty pin refuses the PLAN, so a
// release with nothing to verify against never downloads a binary at all.
// THE GUEST KERNEL'S OWN PIN. The retired builder read
// runner_guest_kernel_artifact.integrity and refused the whole leg with
// `exit 1` when the row was unpinned; here an unpinned row refuses the PLAN
// with the cause in the text, so nothing runs and the reason names the row.
fn microvm_controller_guest_kernel_pinned_digest() -> Digest {
  match runner_guest_kernel_artifact.integrity {
    ArtifactDigestPinned { digest: digest, provenance: _ } => digest
    // Unreachable at any use site: microvm_controller_install_staging refuses the
    // plan when this row is unpinned, so no VerifyStep ever carries these values.
    // The release pin is returned rather than a fabricated digest.
    ArtifactDigestUnpinned { cause: _ } => microvm_controller_kernel_pinned_digest()
    ArtifactDigestNotPinnable { cause: _ } => microvm_controller_kernel_pinned_digest()
  }
}

fn microvm_controller_guest_kernel_pin_refusal() -> String {
  match runner_guest_kernel_artifact.integrity {
    ArtifactDigestPinned { digest: _, provenance: _ } => ""
    ArtifactDigestUnpinned { cause: cause } => join([microvm_controller_install_edge,
      " refused before any operation ran: the guest kernel artifact row is unpinned (", cause,
      "); the retired pipeline emitted `exit 1` here after its earlier legs had already run"], "")
    ArtifactDigestNotPinnable { cause: cause } => join([microvm_controller_install_edge,
      " refused before any operation ran: the guest kernel artifact row is unpinnable (", cause, ")",], "")
  }
}

fn microvm_controller_pinned_digest_refusal() -> String {
  if string_length(s: firecracker_release_aarch64_tarball_sha256 as String) == 64 {
    ""
  } else {
    join([microvm_controller_install_edge,
      " refused before any operation ran: the firecracker release digest pin is not a 64-hex value, so the download would have nothing to verify against"], "")
  }
}

// THE WHOLE PLAN, in the order the retired pipeline ran it. Planning is total:
// every pin and every malformed-name check is answered before any step can run.
// THE CHECKOUT ROOT IS AN INPUT AND MUST BE ABSOLUTE: the staged sources live under the job's
// checkout, and the elevated legs that read them run as another principal whose working directory
// is not the checkout, so a relative staged path would name a different file on that side.
fn microvm_controller_checkout_path(checkout_root: String, relative: String) -> String {
  join([checkout_root, "/", relative], "")
}

fn microvm_controller_install_staging(revision: ReleaseRevisionBinding, checkout_root: String) -> MicrovmControllerInstallStaging {
  let release_dir = microvm_controller_release_dir(revision: revision)
  let slice_name = microvm_controller_slice_unit_name as String
  let slot_name = microvm_slot_unit_template_name as String
  let reserve_name = microvm_slot_reserve_unit_name as String
  let executor_name = workspace_executor_template_name as String
  let name_refusal = if microvm_controller_unit_name_refusal(name: slice_name, kind: "controller slice") != "" {
    microvm_controller_unit_name_refusal(name: slice_name, kind: "controller slice")
  } else if microvm_controller_unit_name_refusal(name: slot_name, kind: "slot template") != "" {
    microvm_controller_unit_name_refusal(name: slot_name, kind: "slot template")
  } else if microvm_controller_unit_name_refusal(name: executor_name, kind: "executor template") != "" {
    microvm_controller_unit_name_refusal(name: executor_name, kind: "executor template")
  } else if microvm_controller_requires_ci_reservation_unit() && microvm_controller_unit_name_refusal(name: reserve_name, kind: "slot reserve") != "" {
    microvm_controller_unit_name_refusal(name: reserve_name, kind: "slot reserve")
  } else {
    ""
  }
  let pin_refusal = if microvm_controller_pinned_digest_refusal() != "" {
    microvm_controller_pinned_digest_refusal()
  } else {
    microvm_controller_guest_kernel_pin_refusal()
  }
  let kernel_digest = microvm_controller_kernel_pinned_digest()
  let guest_kernel_digest = microvm_controller_guest_kernel_pinned_digest()
  let steps = microvm_controller_install_steps(
    revision: revision,
    release_dir: release_dir,
    kernel_digest: kernel_digest,
    guest_kernel_pinned_digest: guest_kernel_digest,
    checkout_root: checkout_root,
  )
  let invariant_refusal = fold(
    steps,
    init: "",
    f: (acc, s) => if acc != "" { acc } else { microvm_controller_starts_no_instance_refusal(step: s) },
  )
  if !starts_with(s: checkout_root, prefix: "/") {
    MicrovmControllerInstallRefused { reason: join([microvm_controller_install_edge, ": the checkout root '", checkout_root, "' is not absolute, so an elevated leg run by another principal could not resolve the staged sources"], "") }
  } else if name_refusal != "" {
    MicrovmControllerInstallRefused { reason: name_refusal }
  } else if pin_refusal != "" {
    MicrovmControllerInstallRefused { reason: pin_refusal }
  } else if invariant_refusal != "" {
    MicrovmControllerInstallRefused { reason: invariant_refusal }
  } else {
    MicrovmControllerInstallReady { steps: steps }
  }
}

fn revision_job_install_file_step(name: String, source: String, dest: String) -> MicrovmControllerInstallStep {
  microvm_controller_argv_step(
    name: name,
    command: sudo_elevate_command(command: coreutils_install_file_owned_argv(
      mode: install_file_shared_mode, owner: microvm_controller_owner, group: microvm_controller_owner, source: source, dest: dest)),
  )
}

fn revision_job_owned_dir_step(name: String, path: String) -> MicrovmControllerInstallStep {
  microvm_controller_argv_step(name: name, command: sudo_elevate_command(command: microvm_controller_owned_dir_argv(path: path)))
}

// THE REVISION JOB'S LEG: its image installed root-owned and verified against the pin, its state
// directories, and its templated unit. Present exactly when the authority declares a revision-job
// slot (gunbc.runner.runner_slot_allocation revision_job_slots). Like every leg here it starts
// nothing: the job unit is started by the granted request, never by the install.
fn microvm_controller_revision_job_steps(release_dir: String, guest_kernel_pinned_digest: Digest, checkout_root: String) -> List<MicrovmControllerInstallStep> {
  if count(revision_job_slots) == 0 {
    []
  } else {
    let root = revision_job_installed_image_root(release_dir: release_dir)
    let kernel = revision_job_installed_kernel(release_dir: release_dir)
    let rootfs = revision_job_installed_rootfs(release_dir: release_dir)
    let toolchain = revision_job_installed_toolchain(release_dir: release_dir)
    let staging = microvm_controller_checkout_path(checkout_root: checkout_root, relative: revision_job_image_staging_root)
    let operator = fleet_posix_operator_user.name
    let instances = map(revision_job_slots, slot => runner_slot_instance_name(slot: slot))
    concat(
      [
        revision_job_owned_dir_step(name: "revision-job image dir", path: root),
        revision_job_install_file_step(name: "revision-job kernel install", source: runner_guest_base_artifact_path(root: staging, artifact: runner_guest_kernel_artifact), dest: kernel),
        MicrovmControllerVerifyStep {
          name: "revision-job guest kernel digest",
          command: sha256sum_file_command(path: kernel),
          expected: guest_kernel_pinned_digest,
          subject: kernel,
        },
        revision_job_install_file_step(name: "revision-job rootfs install", source: revision_job_image_path(root: staging), dest: rootfs),
        MicrovmControllerVerifyStep {
          name: "revision-job rootfs digest",
          command: sha256sum_file_command(path: rootfs),
          expected: sha256_digest(hex: revision_job_image_pinned_sha256 as String),
          subject: rootfs,
        },
        revision_job_install_file_step(name: "revision-job toolchain receipt install", source: revision_job_toolchain_receipt_path(root: staging), dest: toolchain),
        revision_job_owned_dir_step(name: "revision-job state dir", path: revision_job_state_root),
        revision_job_owned_dir_step(name: "revision-job receipt store", path: revision_job_receipt_store),
        microvm_controller_argv_step(
          name: "revision-job spec dir",
          command: sudo_elevate_command(command: coreutils_install_directory_owned_argv(
            mode: install_d_shared_mode, owner: operator, group: operator, path: revision_job_spec_dir)),
        ),
      ],
      concat(
        flat_map(instances, i => [
          revision_job_owned_dir_step(name: concat("revision-job instance dir ", i), path: revision_job_instance_dir(instance: i)),
          revision_job_owned_dir_step(name: concat("revision-job cache dir ", i), path: revision_job_cache_dir(instance: i)),
          revision_job_owned_dir_step(name: concat("revision-job work dir ", i), path: revision_job_work_dir(instance: i)),
        ]),
        microvm_controller_staged_write_steps(
          name: "revision-job runner unit",
          dest: revision_job_runner_unit_path() as String,
          mode: microvm_controller_unit_mode,
          content: serialize_systemd_unit_file(file: microvm_locus_unit_with_workspace_root(
            file: revision_job_runner_unit_file(release_dir: release_dir), release_dir: release_dir)),
        ),
      ),
    )
  }
}

// THE STEP LIST, exactly the retired intent's order. The tree-copy leg is
// W6's vertical and is named here as ONE step (the fold calls the real
// function; see microvm_controller_run_tree_install).
// THE STEP LIST, exactly the retired intent's order, as pure data.
fn microvm_controller_install_steps(
  revision: ReleaseRevisionBinding,
  release_dir: String,
  kernel_digest: Digest,
  guest_kernel_pinned_digest: Digest,
  checkout_root: String,
) -> List<MicrovmControllerInstallStep> {
  let stage = microvm_controller_checkout_path(checkout_root: checkout_root, relative: microvm_controller_stage_dir)
  let tarball = microvm_controller_stage_tarball_path(stage: stage)
  let workspace_staging = microvm_controller_checkout_path(checkout_root: checkout_root, relative: workspace_image_staging_root)
  let image_root = workspace_installed_image_root(release_dir: release_dir, identity: workspace_demo_image_identity())
  let kernel_installed = concat(image_root, concat("/", runner_guest_kernel_artifact.filename as String))
  let rootfs = concat(image_root, "/workspace.ext4")
  let grant_stage = concat(workspace_dispatch_grant_path, microvm_controller_stage_suffix)
  let grant_pending = concat(workspace_dispatch_grant_path, ".pending")
  concat(
    [
      // THE TREE COPY, FIRST -- where the retired intent ran it (its first leg
      // was `cd <checkout> && find <subdirs> -type f | xargs sudo install`). One
      // leg, run by W6's vertical; this module spells none of its words.
      MicrovmControllerTreeStep { name: "approval-broker tree install" },
    ],
    concat(
    [
      // microvm_controller_vmm_install_steps. Elevation matches the retired
      // builder leg for leg: mkdir/curl/tar ran as the deploying user (their
      // text came from shell_command_text_of_argv), while each install went
      // through shell_privileged_command_text_of_argv -- so each install below
      // carries sudo_elevate_command and the three others do not.
      microvm_controller_argv_step(name: "vmm stage dir", command: mkdir_parents_command(path: stage)),
      microvm_controller_argv_step(
        name: "vmm tarball download",
        command: curl_download_command(
          url: firecracker_release_download_url(rel: microvm_controller_firecracker_release),
          destination: tarball,
        ),
      ),
      MicrovmControllerVerifyStep {
        name: "vmm tarball digest",
        command: sha256sum_file_command(path: tarball),
        expected: kernel_digest,
        subject: tarball,
      },
      microvm_controller_argv_step(
        name: "vmm tarball extract",
        command: tar_extract_command(archive: tarball, into_directory: stage, strip_components: 0, existing_directories: TarOverwriteDir),
      ),
      microvm_controller_argv_step(
        name: "vmm binary install",
        command: sudo_elevate_command(command: coreutils_install_file_owned_argv(
          mode: install_executable_shared_mode,
          owner: microvm_controller_owner,
          group: microvm_controller_owner,
          source: join([stage, "/", firecracker_release_binary_path_in_tarball(rel: microvm_controller_firecracker_release)], ""),
          dest: microvm_controller_vmm_binary(release_dir: release_dir),
        )),
      ),
      microvm_controller_argv_step(
        name: "jailer install",
        command: sudo_elevate_command(command: coreutils_install_file_owned_argv(
          mode: install_executable_shared_mode,
          owner: microvm_controller_owner,
          group: microvm_controller_owner,
          source: join([stage, "/", firecracker_release_jailer_path_in_tarball(rel: microvm_controller_firecracker_release)], ""),
          dest: microvm_controller_jailer_binary(release_dir: release_dir),
        )),
      ),
      // The vmm receipt: the two binaries' sha256sum lines, OBSERVED by this
      // edge and installed as stdin data. The retired leg piped sha256sum into
      // `install /dev/stdin`; here the bytes written are the bytes observed, so
      // the receipt records the binaries this edge installed. The reader
      // (apply.dag microvm_controller_vmm_receipt_present) checks both binary
      // names appear, and they do -- each line is sha256sum's own output.
      MicrovmControllerReceiptStep {
        name: "vmm receipt",
        observe: sha256sum_file_command(path: microvm_controller_vmm_binary(release_dir: release_dir)),
        observe2: sha256sum_file_command(path: microvm_controller_jailer_binary(release_dir: release_dir)),
        write: sudo_elevate_command(command: coreutils_install_file_owned_argv(
          mode: install_file_shared_mode,
          owner: microvm_controller_owner,
          group: microvm_controller_owner,
          source: "/dev/stdin",
          dest: microvm_controller_vmm_receipt_path(revision: revision),
        )),
        subject: microvm_controller_vmm_binary(release_dir: release_dir),
      },
    ],
    concat(
      [
        // workspace_image_install_steps, leg for leg. The digests checked here
        // are each file's OWN pinned value (the guest kernel artifact row's
        // integrity, the demo-image identity), not the firecracker release pin,
        // and each check follows the install that produced the file -- the
        // retired builder verified the INSTALLED copy, which is what a host can
        // actually be wrong about. An unpinned artifact row refuses the plan
        // (microvm_controller_install_staging) rather than skipping the check.
        microvm_controller_argv_step(
          name: "workspace image dir",
          command: sudo_elevate_command(command: microvm_controller_owned_dir_argv(path: image_root)),
        ),
        microvm_controller_argv_step(
          name: "workspace kernel install",
          command: sudo_elevate_command(command: coreutils_install_file_owned_argv(
            mode: install_file_shared_mode,
            owner: microvm_controller_owner,
            group: microvm_controller_owner,
            source: runner_guest_base_artifact_path(root: workspace_staging, artifact: runner_guest_kernel_artifact),
            dest: kernel_installed,
          )),
        ),
        MicrovmControllerVerifyStep {
          name: "workspace guest kernel digest",
          command: sha256sum_file_command(path: kernel_installed),
          expected: guest_kernel_pinned_digest,
          subject: kernel_installed,
        },
        microvm_controller_argv_step(
          name: "workspace rootfs install",
          command: sudo_elevate_command(command: coreutils_install_file_owned_argv(
            mode: install_file_shared_mode,
            owner: microvm_controller_owner,
            group: microvm_controller_owner,
            source: workspace_image_path(root: workspace_staging),
            dest: rootfs,
          )),
        ),
        MicrovmControllerVerifyStep {
          name: "workspace rootfs digest",
          command: sha256sum_file_command(path: rootfs),
          expected: sha256_digest(hex: workspace_demo_image_identity()),
          subject: rootfs,
        },
        // install_d_owned_for_user x4 -- one step per directory, each named, so
        // a failure says which store could not be made.
        microvm_controller_argv_step(
          name: "slot controller receipt dir",
          command: sudo_elevate_command(command: microvm_controller_owned_dir_argv(path: microvm_slot_controller_receipt_dir)),
        ),
        microvm_controller_argv_step(
          name: "cell readiness store dir",
          command: sudo_elevate_command(command: microvm_controller_owned_dir_argv(path: cell_readiness_store_location)),
        ),
        microvm_controller_argv_step(
          name: "commissioning store dir",
          command: sudo_elevate_command(command: microvm_controller_owned_dir_argv(path: workspace_commissioning_store_location)),
        ),
        microvm_controller_argv_step(
          name: "runner converged receipt dir",
          command: sudo_elevate_command(command: microvm_controller_owned_dir_argv(path: runner_microvm_converged_receipt_root)),
        ),
      ],
      concat(
        // microvm_slot_unit_write_steps: staged write then owned install, per
        // unit. Templates only -- the invariant check refuses any start verb.
        concat(
          microvm_controller_staged_write_steps(
            name: "controller slice unit",
            dest: microvm_controller_slice_unit_path() as String,
            mode: microvm_controller_unit_mode,
            content: serialize_systemd_unit_file(file: microvm_controller_slice_unit_file()),
          ),
          concat(
            microvm_controller_staged_write_steps(
              name: "slot template unit",
              dest: microvm_slot_unit_path() as String,
              mode: microvm_controller_unit_mode,
              content: serialize_systemd_unit_file(
                file: microvm_slot_unit_file_with_workspace_root(release_dir: release_dir),
              ),
            ),
            if microvm_controller_requires_ci_reservation_unit() {
              microvm_controller_staged_write_steps(
                name: "slot reserve unit",
                dest: microvm_slot_reserve_unit_path() as String,
                mode: microvm_controller_unit_mode,
                content: serialize_systemd_unit_file(
                  file: microvm_locus_unit_with_workspace_root(
                    file: microvm_slot_reserve_unit_file(release_dir: release_dir),
                    release_dir: release_dir,
                  ),
                ),
              )
            } else {
              []
            },
          ),
        ),
        concat(
          // workspace_executor_install_steps.
          concat(
            microvm_controller_staged_write_steps(
              name: "commissioning executor script",
              dest: join([release_dir, "/", workspace_executor_script_name], ""),
              mode: install_executable_shared_mode,
              content: workspace_commissioning_executor_script(),
            ),
            concat(
              microvm_controller_staged_write_steps(
                name: "commissioning helper",
                dest: join([release_dir, "/", workspace_executor_helper_name], ""),
                mode: install_executable_shared_mode,
                content: workspace_executor_helper_script(release_dir: release_dir),
              ),
              microvm_controller_staged_write_steps(
                name: "commissioning executor unit",
                dest: workspace_executor_unit_path() as String,
                mode: install_file_shared_mode,
                content: workspace_executor_unit_text(
                  release_dir: release_dir,
                  fleet_lock: fleet_generation_lock,
                  wait_bound: workspace_executor_wait_bound,
                ),
              ),
            ),
          ),
          concat(
            // workspace_dispatch_grant_steps: stage the sudoers drop-in, visudo
            // -cf the STAGED file, install it 0440 at the pending path, visudo
            // -cf the pending path, rename -T into place (atomic: a reader sees
            // the old grant or the new one, never a partial write), visudo -cf
            // the live path. Every leg is its own named step, so a refusal says
            // which of the five the retired script's six lines would have been.
            [
              microvm_controller_stdin_step(
                name: "dispatch grant (stage)",
                command: sudo_elevate_command(command: argv_words(command: dd_overwrite_path_command(path: grant_stage))),
                stdin_payload: concat(workspace_dispatch_grant_content(
                  release_dir: release_dir as NonEmptyStr,
                ), "\n"),
              ),
              microvm_controller_argv_step(
                name: "dispatch grant visudo check (staged)",
                command: visudo_check_command(file: grant_stage),
              ),
              microvm_controller_argv_step(
                name: "dispatch grant install (pending)",
                command: sudo_elevate_command(command: coreutils_install_file_owned_argv(
                  mode: helper_sudoers_grant_mode,
                  owner: microvm_controller_owner,
                  group: microvm_controller_owner,
                  source: grant_stage,
                  dest: grant_pending,
                )),
              ),
              microvm_controller_argv_step(
                name: "dispatch grant policy check (pending)",
                command: visudo_policy_check_command(file: grant_pending),
              ),
              microvm_controller_argv_step(
                name: "dispatch grant rename",
                command: sudo_elevate_command(command: argv_words(command: mv_exact_destination_command(
                  source: grant_pending,
                  destination: workspace_dispatch_grant_path,
                ))),
              ),
              microvm_controller_argv_step(
                name: "dispatch grant policy check (live)",
                command: visudo_policy_check_command(file: workspace_dispatch_grant_path),
              ),
            ],
            // systemctl daemon-reload, LAST: the units above are templates; the
            // reload makes them known and starts nothing.
            concat(microvm_controller_revision_job_steps(release_dir: release_dir, guest_kernel_pinned_digest: guest_kernel_pinned_digest, checkout_root: checkout_root), [microvm_controller_argv_step(
              name: "systemd daemon-reload",
              command: extdeps.systemd.systemctl.systemctl_daemon_reload_command(),
            )]),
          ),
        ),
      ),
    ),
    ),
  )
}

// ── THE FAIL-FAST FOLD ───────────────────────────────────────────────────────
// Each leg runs over the typed transport seam and its exit status is read as
// data. The retired script's `set -e` / `|| exit 1` discipline survives as a
// NotConverged that names the step and carries its stderr; a refused transport
// (an unsupported transport, an over-long payload) is a refusal of the whole
// edge with the runner's own authority text -- never a success with empty
// output, and never a silent default.
data microvm_controller_run_edge: String = "host_effect_apply: MicrovmControllerInstall"

type MicrovmControllerStepRun
  = StepRan { exit_code: Int, stdout: String, stderr: String }
  | StepRefused { reason: String }

type MicrovmControllerFoldAcc
  = FoldOk { exit_code: Int, stdout: String, stderr: String }
  | FoldFailed { reason: String }

// THE PER-STEP RUNNER. Bytes on stdin go through the stdin seam (which enforces
// the payload bound before any write); words alone go through the plain seam.
// A non-zero exit is returned as data for the fold, not swallowed.
// THE VERIFY LEG: run the digest command, then compare its parsed stdout
// against the PINNED value. Unparseable output and a mismatch are both
// non-zero exits with the reason in stderr, so the fold's failure text says
// why, exactly as the retired `sha256sum -c -` printed which file FAILED OPEN.
fn microvm_controller_run_verify(
  step_name: String,
  command: ArgvCommand,
  subject: String,
  expected: Digest,
  transport: HostEffectElevationRoute,
) -> MicrovmControllerStepRun {
  match microvm_controller_run_argv(name: step_name, command: command, stdin_payload: "", transport: transport) {
    StepRefused { reason: why } => StepRefused { reason: why }
    StepRan { exit_code: code, stdout: out, stderr: err } =>
      if code != 0 {
        StepRan { exit_code: code, stdout: out, stderr: err }
      } else {
        match sha256sum_line_digest(line: out) {
          Absent => StepRan {
            exit_code: 1,
            stdout: out,
            stderr: join([microvm_controller_run_edge, " step '", step_name, "' on '", subject, "': the digest command printed no 64-hex digest field"], ""),
          }
          Present { value: observed } =>
            if observed == expected {
              StepRan { exit_code: 0, stdout: out, stderr: err }
            } else {
              StepRan {
                exit_code: 1,
                stdout: out,
                stderr: join([
                  microvm_controller_run_edge, " step '", step_name, "' on '", subject,
                  "': the artifact's digest is not the pinned release digest; refusing to install an artifact that is not the pinned release",
                ], ""),
              }
            }
        }
      }
  }
}

// THE RUNNER FOR A PLAIN LEG, factored out so verify/receipt can call it
// without re-matching the arm they already know.
fn microvm_controller_run_argv(name: String, command: ArgvCommand, stdin_payload: String, transport: HostEffectElevationRoute) -> MicrovmControllerStepRun {
  let outcome = if stdin_payload == "" {
    run_argv_over_elevation_route(command: command, transport: transport)
  } else {
    run_argv_stdin_over_elevation_route(command: command, stdin_payload: stdin_payload, transport: transport)
  }
  match outcome {
    RunArgvTransportObserved { observed: observed } => StepRan {
      exit_code: observed.exit_code,
      stdout: observed.stdout,
      stderr: observed.stderr,
    }
    RunArgvTransportRefused { reason: why } => StepRefused { reason: why }
  }
}

// THE RECEIPT LEG: observe both installed binaries' digests, then install the
// observed lines as bytes on stdin. The bytes written are the bytes observed
// (stdout carries no shell interpretation), which is what makes the receipt a
// record of what this edge installed rather than a re-spelled expectation.
fn microvm_controller_run_receipt(
  step_name: String,
  observe: ArgvCommand,
  observe2: ArgvCommand,
  write: ArgvCommand,
  subject: String,
  transport: HostEffectElevationRoute,
) -> MicrovmControllerStepRun {
  let first = microvm_controller_run_argv(name: step_name, command: observe, stdin_payload: "", transport: transport)
  match first {
    StepRefused { reason: why } => StepRefused { reason: why }
    StepRan { exit_code: c1, stdout: o1, stderr: e1 } =>
      if c1 != 0 {
        StepRan { exit_code: c1, stdout: o1, stderr: join([microvm_controller_run_edge, " step '", step_name, "': the digest of '", subject, "' failed (exit ", to_string(c1), "): ", e1], "") }
      } else {
        let second = microvm_controller_run_argv(name: step_name, command: observe2, stdin_payload: "", transport: transport)
        match second {
          StepRefused { reason: why } => StepRefused { reason: why }
          StepRan { exit_code: c2, stdout: o2, stderr: e2 } =>
            if c2 != 0 {
              StepRan { exit_code: c2, stdout: o2, stderr: join([microvm_controller_run_edge, " step '", step_name, "': the second digest of '", subject, "' failed (exit ", to_string(c2), "): ", e2], "") }
            } else {
              // Both lines are the observed sha256sum text, joined with the
              // newline the receipt has always had between its two entries.
              microvm_controller_run_argv(
                name: step_name,
                command: write,
                stdin_payload: join([o1, o2], ""),
                transport: transport,
              )
            }
        }
      }
  }
}

// THE TREE-COPY LEG, AS ONE CALL TO W6'S VERTICAL. approval_broker_tree_install
// owns the dir spine, the per-file copy, the binary, and the receipt digest
// (PR 14138, witnessed there). Its refusal becomes this edge's NotConverged
// with the W6 step name in the text; its success is NOT this edge's final
// evidence -- the later legs' ShellEffectApplied is.
// THE TREE COPY'S SOURCE ROOT, AS A TYPED READ. The retired builder baked an
// absolute checkout path into the script's `cd "<path>"`; the typed edge asks
// the host where its checkout is with the git operation instead (git.Inspect
// .Toplevel -> `git rev-parse --show-toplevel`), so no host path is a literal
// in this module. W6 reads source_root THROUGH the transport, so an absolute
// root here makes every leg of the vertical absolute.
fn microvm_controller_source_root() -> String {
  git.Inspect.Toplevel().path as String
}

// THE W6 STEP NAME AS TEXT, so a refusal from the vertical says which of its
// eight legs refused (TreeInstallStep is a closed sum; the mapping is here and
// nowhere else).
fn microvm_controller_tree_step_name(step: TreeInstallStep) -> String {
  match step {
    TreeStepRevision => "revision"
    TreeStepSourceObserve => "source-observe"
    TreeStepInstallDirectory => "install-directory"
    TreeStepInstallFile => "install-file"
    TreeStepInstallBinary => "install-binary"
    TreeStepReadback => "readback"
    TreeStepDigest => "digest"
    TreeStepReceipt => "receipt"
  }
}

// THE FOLD. Plan, then run each step in order over the transport; the first
// non-zero exit or refusal stops the fold and becomes NotConverged naming that
// step. Converged carries the LAST leg's evidence (the daemon reload), the way
// the retired pipeline's final receipt did.
fn realize_microvm_controller_install_on_host(
  candidate: CandidateRelease,
  transport: HostEffectElevationRoute,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let revision = RevisionBoundAtEmission { revision: candidate.revision }
  let source_root = microvm_controller_source_root()
  if source_root == "" {
    return NotConverged {
      reason: join([microvm_controller_run_edge, " tree-copy leg refused: the host reports no checkout root (git rev-parse --show-toplevel returned nothing), so there is no source tree to install from"], ""),
      applied: intent,
    }
  }
  match microvm_controller_install_staging(revision: revision, checkout_root: source_root) {
    MicrovmControllerInstallRefused { reason: why } => NotConverged { reason: why, applied: intent }
    MicrovmControllerInstallReady { steps: steps } => {
      let acc = fold(
        steps,
        init: FoldOk { exit_code: 0, stdout: "", stderr: "" },
        f: (a, s) =>
          match a {
            FoldFailed { reason: why } => FoldFailed { reason: why }
            FoldOk { exit_code: prior_code, stdout: prior_out, stderr: prior_err } =>
              match s {
                MicrovmControllerArgvStep { name: name, command: command, stdin_payload: stdin_text } =>
                  match microvm_controller_run_argv(name: name, command: command, stdin_payload: stdin_text, transport: transport) {
                    StepRefused { reason: why } => FoldFailed { reason: join([microvm_controller_run_edge, " step '", name, "': ", why], "") }
                    StepRan { exit_code: code, stdout: out, stderr: err } =>
                      if code == 0 { FoldOk { exit_code: code, stdout: out, stderr: err } }
                      else { FoldFailed { reason: join([microvm_controller_run_edge, " step '", name, "' failed (exit ", to_string(code), "): ", err], "") } }
                  }
                MicrovmControllerVerifyStep { name: name, command: command, expected: expected, subject: subject } =>
                  match microvm_controller_run_verify(step_name: name, command: command, subject: subject, expected: expected, transport: transport) {
                    StepRefused { reason: why } => FoldFailed { reason: join([microvm_controller_run_edge, " step '", name, "': ", why], "") }
                    StepRan { exit_code: code, stdout: out, stderr: err } =>
                      if code == 0 { FoldOk { exit_code: code, stdout: out, stderr: err } }
                      else { FoldFailed { reason: join([microvm_controller_run_edge, " step '", name, "' refused (exit ", to_string(code), "): ", err], "") } }
                  }
                MicrovmControllerReceiptStep { name: name, observe: observe, observe2: observe2, write: write, subject: subject } =>
                  match microvm_controller_run_receipt(step_name: name, observe: observe, observe2: observe2, write: write, subject: subject, transport: transport) {
                    StepRefused { reason: why } => FoldFailed { reason: join([microvm_controller_run_edge, " step '", name, "': ", why], "") }
                    StepRan { exit_code: code, stdout: out, stderr: err } =>
                      if code == 0 { FoldOk { exit_code: code, stdout: out, stderr: err } }
                      else { FoldFailed { reason: join([microvm_controller_run_edge, " step '", name, "' failed (exit ", to_string(code), "): ", err], "") } }
                  }
                // The tree leg is not run by the fold's own hands: the realizer
                // called W6's vertical ONCE, before the fold, and refused the
                // whole edge if it refused. Its verdict is the fold's initial
                // evidence, so this arm passes the accumulator through -- the
                // leg is in the plan (a witness counts it) but never re-run.
                // THE TREE LEG, wired to W6's vertical: ONE call, in plan
                // position (first), over this edge's own transport. A refusal
                // from the vertical stops the fold exactly as a non-zero exit
                // would, naming which of W6's eight legs refused; its success is
                // this leg's evidence but NOT the edge's final evidence -- the
                // later legs' output wins, as the plan's order decides.
                MicrovmControllerTreeStep { name: name } =>
                  match approval_broker_tree_install(
                    owner: microvm_controller_owner,
                    base_root: microvm_controller_root,
                    source_root: source_root,
                    revision: revision,
                    executables: [gunbc_release_bin_name],
                    transport: transport,
                  ) {
                    TreeInstallConverged { installed_digest: digest, files_installed: files } =>
                      FoldOk {
                        exit_code: 0,
                        stdout: join([microvm_controller_run_edge, " step '", name, "': ", to_string(files), " files installed at receipt digest ", digest], ""),
                        stderr: prior_err,
                      }
                    TreeInstallRefused { step: step, reason: why } => FoldFailed {
                      reason: join([microvm_controller_run_edge, " step '", name, "' refused at ", microvm_controller_tree_step_name(step: step), ": ", why], ""),
                    }
                  }
              }
          },
      )
      match acc {
        FoldFailed { reason: why } => NotConverged { reason: why, applied: intent }
        FoldOk { exit_code: code, stdout: out, stderr: err } => Converged {
          evidence: ShellEffectApplied { exit_code: code, stdout: out, stderr: err },
          applied: intent,
        }
      }
    }
  }
}
