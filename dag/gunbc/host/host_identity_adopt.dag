module gunbc.host.host_identity_adopt

import std.types { Bool, String, NonEmptyStr }
import std.disposition { Disposition }
import std.content_hash { ContentHash, as_content_hash_structural, content_hash_atom }
import extdeps.ssh.known_hosts { known_hosts_host_field }
import product.host_identity { HostIdentity }
import gunbc.fleet.fleet_host_identity {
  operator_host_srv1,
  operator_host_srv2,
  operator_host_srv3,
  operator_host_srv4,
}
import gunbc.fleet.fleet_intent { ComputeHost }
import gunbc.deployed_intent_v0 { DeployedIntentV0, deployed_intent_v0_adopt_observed_base }
import gunbc.host.host_effect { HostEffectTransport, LocalShell, SshShell, FleetSsh, EmitArtifactThenThinRun }
import gunbc.host.host_identity_knob { HostIdentityKnobKey, host_identity_knob_key }
import gunbc.host.host_identity_observation { HostIdentityObservation, host_identity_observation_nonempty }


type HostIdentityAdoptReceipt {
  host: HostIdentity
  key: HostIdentityKnobKey
  observed_short_hostname: String
  probed_at: NonEmptyStr
  transport_label: String
  model_hash: ContentHash
  deployed_intent: DeployedIntentV0
  read_converged: Bool
}

data gunbc_host_identity_adopt_scope_disposition: Disposition = std.disposition.Terminal {
  reason: "ADOPT-BASE phase-0 live consumer: modeled hostname -s read over host_effect SshShell transport -> HostIdentityObservation -> DeployedIntentV0 recording OBSERVED base. Adoption records actual base so a later converge diff is honest; adoption != drift correction. host_identity_adopt_*_wet runs ONCE per host and its receipt is the thing an operator hand-commits as one of the gunbc.deployed_intent_v0 persisted rows (gunbc_srv1_deployed_intent_v0_persisted, gunbc_srv2_deployed_intent_v0_persisted) — converge (gunbc.host.host_identity_assimilation) never calls back into this module's live functions, it takes the persisted DeployedIntentV0 as an argument."
}

data gunbc_host_identity_adopt_model_marker: NonEmptyStr = "gunbc.host_identity_adopt.v0"

fn srv1_host_identity_ssh_transport() -> HostEffectTransport {
  SshShell { ssh_host: operator_host_srv1 as NonEmptyStr }
}

fn srv2_host_identity_ssh_transport() -> HostEffectTransport {
  SshShell { ssh_host: operator_host_srv2 as NonEmptyStr }
}

fn srv3_host_identity_ssh_transport() -> HostEffectTransport {
  SshShell { ssh_host: operator_host_srv3 as NonEmptyStr }
}

fn srv4_host_identity_ssh_transport() -> HostEffectTransport {
  SshShell { ssh_host: operator_host_srv4 as NonEmptyStr }
}

fn host_identity_transport_label(transport: HostEffectTransport) -> String {
  match transport {
    SshShell { ssh_host: h } => concat("SshShell:", h)
    FleetSsh { target: t, context: _ } => concat("FleetSsh:", known_hosts_host_field(address: t.address) as String)
    LocalShell => "LocalShell"
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } => "EmitArtifactThenThinRun"
  }
}

fn host_identity_adopt_model_hash() -> ContentHash {
  as_content_hash_structural(structural: content_hash_atom(value: gunbc_host_identity_adopt_model_marker))
}

fn host_identity_adopt_receipt(
  fleet_slot: HostIdentity,
  target_host: ComputeHost,
  observation: HostIdentityObservation,
  transport: HostEffectTransport,
  read_converged: Bool,
) -> HostIdentityAdoptReceipt {
  HostIdentityAdoptReceipt {
    host: fleet_slot,
    key: host_identity_knob_key(host: fleet_slot),
    observed_short_hostname: observation.short_hostname,
    probed_at: observation.probed_at,
    transport_label: host_identity_transport_label(transport: transport),
    model_hash: host_identity_adopt_model_hash(),
    deployed_intent: deployed_intent_v0_adopt_observed_base(
      fleet_slot: fleet_slot,
      target_host: target_host,
      observation: observation,
    ),
    read_converged: read_converged,
  }
}

fn host_identity_adopt_receipt_is_valid(receipt: HostIdentityAdoptReceipt) -> Bool {
  receipt.read_converged
    && host_identity_observation_nonempty(obs: receipt.deployed_intent.observation)
    && receipt.key.host == receipt.host
}
