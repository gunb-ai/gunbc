// WHICH MegaRAC FIRMWARE RELEASES WE HAVE ESTABLISHED A CAPABILITY SET FOR, AND ON WHAT EVIDENCE.
//
// WHY THIS IS A gunbc MODULE AND NOT extdeps.bmc.megarac. A capability row is a claim WE make about a
// firmware build after observing it: which controls our automation exercised, which run of ours exercised
// them, where that run's artifacts were committed, and who read the version string. DESIGN.md §3
// ("External upstream decomposition") puts observations this repository makes in the OBSERVING layer,
// "not facts of the observed upstream", and says a missing observation is a downstream coverage
// obligation, "never an `Unobserved` property inside the upstream module". The first version of this
// catalog lived in extdeps.bmc.megarac and carried exactly the things that rule out: a fleet-converge run
// id of ours, our artifact directory, a PR number of ours, an operator's reading of a web UI, and the
// sentence "absent here means NOT EXERCISED AT THIS BUILD" — the forbidden Unobserved property wearing
// different clothes. What STAYS upstream is what the vendor states: the release identities
// (extdeps.bmc.megarac.megarac_firmware_0_32, megarac_firmware_0_45_3). Review 81149, finding 1.
//
// THE CITATION POINTS AT OURSELVES, NOT AT THE VENDOR. A FactCitation names an authority for a fact, and
// the 0.45.3 row was first credited to extdeps.bmc.megarac.extdeps_external_authority_anchor — the AMI
// MegaRAC anchor — for a fact AMI never stated. An authority cannot be credited with a statement it did
// not make, so a row of ours cites our own committed receipt bytes instead.
//
// UNESTABLISHED IS TYPED AND NEVER A DEFAULT. A release with no row here resolves to
// MegaRacReleaseCapabilityUncatalogued, which the boot selection refuses by name; a release nobody has
// read is NOT silently given the neighbouring release's capabilities.
module gunbc.host.bmc_release_capability_catalog

import std.types { Bool, Int, List, NonEmptyStr, String }
import std.measure { ObservationInstant, nanosecond, WallClock, SharedMonotonic }
import std.scoped_authorization { AttemptIdentity }
import std.decl_ref { decl_ref }
import gunbc.auth.approval_run_identity { attempt_identity_of }
import extdeps.external_authority { ExternalAuthority, FactCitation }
import extdeps.uri { Uri, Https }
import extdeps.bmc.megarac {
  BmcFirmwareReleaseCapabilityRow, megarac_firmware_0_32, megarac_firmware_0_45_3,
}
import extdeps.bmc.capability {
  BmcCapability, BmcFirmwareReleaseIdentity, bmc_firmware_release_identity_eq,
  CapabilityBootSourceOverride, CapabilityPowerControl, CapabilityOemRemoteMedia,
}

// THE AUTHORITY FOR OUR OWN CAPABILITY OBSERVATIONS IS US, so it is declared HERE, in gunbc, and the
// capability rows of this catalog cite it (review 81149; DESIGN.md §3). It is NOT a file path: a directory
// under artifacts/ is a place bytes sit, not an authority that vouches for a claim, and crediting one is
// the same category error as crediting the firmware vendor with a statement it never made — the first
// version of this catalog did exactly that, pointing the 0.45.3 row at the AMI MegaRAC anchor. The
// authority is the repository that established the fact; WHAT it established is named by a DeclRef into
// this module, per DESIGN.md §2, never by retyping the claim as prose.
//
// The receipt bytes the observation came from are named where they belong — as the evidence's own
// receipt_path / artifact_path, which is a pointer to re-derivable bytes, not a warrant.
data gunbc_capability_observation_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/gunb-ai/gunbc",
  },
}

// HOW WE CAME TO KNOW A RELEASE'S VERSION STRING, and when. A capability row's authority is only as good
// as the standing of the version identity it is keyed by, so the standing travels with the row.
type MegaRacReleaseVersionStanding
  = // A machine read: `ipmitool hpm check` against the controller, whose retained output names the
    // version and the active image. This is the standing a boot does not have to trust a human about.
    MegaRacVersionMachineRead {
      read_from: NonEmptyStr,
    }
  // An operator read: a named human read the BMC web UI firmware page at a named instant and reported
  // what it showed. Stated as what it is and never labelled machine-read, because a boot must be able to
  // tell "the controller told us" from "someone looked at a page".
  | MegaRacVersionOperatorAttested {
    attested_on: ObservationInstant,
    detail: NonEmptyStr,
    upgrade_read: NonEmptyStr,
  }

// HOW A RELEASE'S CAPABILITY SET WAS ESTABLISHED. A SEALED CHOICE, because the two ways differ and one
// field set cannot describe both: an executed run of ours exercised the controls, or a committed file of
// ours records the readback that established them. The first version of this module forced a single
// `run` field on every entry, which made the 0.32 row invent a run that never happened.
type MegaRacCapabilityEvidence
  = // AN EXECUTED RUN OF OURS. The Actions run id, the attempt if it was recorded, the artifact directory
    // its evidence was committed under, and EXACTLY which capabilities that run exercised — everything
    // else about the build is simply not claimed by this row, which is OUR coverage obligation and not a
    // statement about what the build can do.
    MegaRacEvidenceExecutedRun {
      run_id: NonEmptyStr,
      // The Actions attempt number, when the receipt recorded one. Run 38789347052's committed receipt
      // names `attempt=38789347052` (the boot attempt, which is the run id the boot thread carries) and
      // no Actions attempt, so this is Absent for it and the derived AttemptIdentity below is unestablished
      // rather than guessed at "1".
      run_attempt: NonEmptyStr?,
      exercised: List<BmcCapability>,
      // WHAT THE RUN'S OWN COMMITTED BYTES SAY ABOUT THE FIRMWARE IT DROVE. Typed, because "the run read
      // no version" and "the run's bytes name a DIFFERENT release than the row claims" are different facts,
      // and flattening the second into the first would let a row borrow a run as corroboration when the
      // run's own evidence says otherwise.
      firmware_read: MegaRacRunFirmwareReading,
      receipt_path: NonEmptyStr,
    }
  // A COMMITTED FILE OF OURS: a readback retained under artifacts/ that establishes the row without a
  // run. There is no executed run for 0.32; there is a committed hpm-check output, and that is what the
  // row says.
  | MegaRacEvidenceCommittedFile {
    // A POINTER TO COMMITTED BYTES, not a claim about a version. The path's filename happens to contain a
    // version token because that is the name the bytes were committed under; it identifies the file, the
    // way a digest identifies a blob, and is not this record restating a firmware version. The version of
    // record is the boot's observation (gunbc.machine_intake.mtcollins1_access_observation) and this
    // record's release identity is the DeclRef'd upstream identity above. Rewriting the path to hide the
    // token would point at a file that does not exist, which is the worse failure.
    artifact_path: NonEmptyStr,
    read_from: NonEmptyStr,
  }

// WHAT A RUN'S COMMITTED BYTES SAY ABOUT THE FIRMWARE IT DROVE — and there are exactly two admissible
// states, because a capability record is NOT where a firmware version is recorded: the version a boot ran
// against is owned by its observation, gunbc.machine_intake.mtcollins1_access_observation. Either the run
// READ a version and named it (the standing that upgrades a row), or it read no version at all. A third
// case — a run whose bytes name a different release — was drafted here and deleted on the manager's
// ruling: such a run is a data bug in the RUN, and naming another release inside a capability record would
// re-attribute that release to a run that must not be said to have read it.
type MegaRacRunFirmwareReading
  = // The run read the controller's version and the build it named IS this row's release — the strongest
    // case, and the one that upgrades a row from attested to machine-read. It carries the release IDENTITY,
    // DeclRef'd from upstream (extdeps.bmc.megarac.megarac_firmware_0_32 / _0_45_3), never a version string
    // retyped into this record: identity equality is then the corpus's own
    // extdeps.bmc.capability.bmc_firmware_release_identity_eq. NO ROW IN THIS CATALOG POPULATES THIS ARM
    // TODAY — no machine read of any build is committed — so no record here duplicates a version. When the
    // next boot's pre-power hpm check lands, the row is populated by naming the upstream identity, and the
    // version of record stays in the boot's observation
    // (gunbc.machine_intake.mtcollins1_access_observation).
    MegaRacRunReadFirmware { read: BmcFirmwareReleaseIdentity }
  // The run read no version at all. No release name appears in this record, in any wording: the release
  // identity of the row rests entirely on the row's own version standing.
  | MegaRacRunRecordedNoFirmware { why: NonEmptyStr }

// WHETHER EVIDENCE CORROBORATES THE ROW'S OWN RELEASE — the anti-fabrication test a consumer asks before
// trusting a capability row. Only a run that read the version and named THIS release corroborates it; a run
// that read nothing, a run that named another build, and a committed file (which records a readback of a
// version, not an exercise of capabilities) all answer false. Today the 0.45.3 row answers false: its
// capability claims rest on an operator attestation joined to a run that read no version, and a consumer
// must not be able to mistake that for a machine read.
fn megarac_evidence_corroborates_release(evidence: MegaRacCapabilityEvidence, firmware: BmcFirmwareReleaseIdentity) -> Bool {
  match evidence {
    MegaRacEvidenceExecutedRun { run_id: _, run_attempt: _, exercised: _, firmware_read: read, receipt_path: _ } =>
      match read {
        MegaRacRunReadFirmware { read: read } => bmc_firmware_release_identity_eq(a: firmware, b: read)
        MegaRacRunRecordedNoFirmware { why: _ } => false
      }
    MegaRacEvidenceCommittedFile { artifact_path: _, read_from: _ } => false
  }
}

// THE ATTEMPT IDENTITY OF THE RUN THAT ESTABLISHED EVIDENCE, when the evidence IS an executed run and its
// Actions attempt was recorded. The join is the corpus's own mint (std.scoped_authorization.AttemptIdentity
// via the same construction gunbc.auth.approval_run_identity.attempt_identity_of uses), not a string
// comparison: run id and attempt must both be decimal digits, and if either is missing the identity is
// ABSENT — an unrecorded attempt is not attempt "1".
fn megarac_evidence_attempt_identity(evidence: MegaRacCapabilityEvidence) -> AttemptIdentity? {
  match evidence {
    MegaRacEvidenceExecutedRun { run_id: run_id, run_attempt: run_attempt, exercised: _, firmware_read: _, receipt_path: _ } =>
      match run_attempt {
        Present { value: attempt } => attempt_identity_of(run_id: run_id as String, run_attempt: attempt as String)
        Absent => none
      }
    MegaRacEvidenceCommittedFile { artifact_path: _, read_from: _ } => none
  }
}

// ONE RELEASE'S ESTABLISHED CAPABILITY SET: the release identity, the row we established for it, how the
// version was established, the evidence that established the row, and our citation.
type MegaRacReleaseCapabilityEntry {
  // THE SINGLE RELEASE KEY of this catalog row is row.firmware: the release identity the capability
  // row itself declares. There is deliberately no second firmware field here -- an entry keyed by one
  // build while its row describes another is the reflash-staleness defect wearing a different hat, and
  // a coherence check that is not on the only path is a check that will be bypassed. Consumers reach
  // the release identity through the row (entry.row.firmware), so key and fact cannot disagree.
  row: BmcFirmwareReleaseCapabilityRow,
  version: MegaRacReleaseVersionStanding,
  evidence: MegaRacCapabilityEvidence,
  citations: List<FactCitation>,
}

// THE RECEIPT FOR FLEET-CONVERGE RUN 38789347052, the run that took the mtcollins1 boot end to end: power
// control, boot-source override, and the MegaRAC OEM remote-media CD handoff (cd_error_code 0). Its
// evidence is committed under artifacts/bmc/mtcollins1-boot-run-38789347052/ and carried by PR #14117. It
// is a NAMED ROW because it is evidence about a run, not about a release: the same receipt can be joined to
// whichever build a later reading establishes it against, and the 0.45.3 entry below reuses this value
// rather than restating it.
data megarac_run_38789347052_evidence: MegaRacCapabilityEvidence = MegaRacEvidenceExecutedRun {
  run_id: "38789347052",
  run_attempt: none,
  exercised: [
    CapabilityBootSourceOverride,
    CapabilityPowerControl,
    CapabilityOemRemoteMedia,
  ],
  // THE RUN READ NO VERSION. Its pre-power hpm check was skipped because no attempt receipt was named,
  // so this record says only that — it names no release, because a capability record is not where a
  // firmware version is recorded (that is owned by gunbc.machine_intake.mtcollins1_access_observation),
  // and because text a harness PRINTED is not something the run READ: the version that appears in this
  // run's output is the boot harness's own refusal string echoing the observation it was handed.
  firmware_read: MegaRacRunRecordedNoFirmware {
    why: "the pre-power hpm check was skipped (no attempt receipt named), so the run read no version",
  },
  receipt_path: "artifacts/bmc/mtcollins1-boot-run-38789347052/mtcollins1-boot-receipt.txt",
}

// THE CITATION FOR A ROW ESTABLISHED BY OUR OWN OBSERVATION: our declaration, under our receipt authority
// — never the vendor anchor, which never said any of this.
fn bmc_capability_observation_citation(decl_name: String) -> FactCitation {
  FactCitation {
    fact: decl_ref(module_path: "gunbc.host.bmc_release_capability_catalog", decl_name: decl_name),
    authority: gunbc_capability_observation_authority,
  }
}

// THE OPERATOR'S READ OF THE 2026-10-16 BMC web UI firmware page: BMC firmware 0.45.3, build 'Dec 27
// 2023 09:36:21 CDT', Image 1; BIOS 0ACOD014; SCP shown blank. Carried as an ObservationInstant rather
// than a bare epoch-milliseconds literal, because std.measure.ObservationInstant is the carrier the
// corpus already has and a bare scalar with no domain or basis cannot be compared with anything —
// DESIGN.md §2, "net concepts must not grow by re-invention" (review 81149, finding 2).
//
// THE DOMAIN IS THE UNIX EPOCH, not an origin named after the day being read (review 81301, blocking).
// The draft paired a Unix-epoch count with origin "mtcollins1-bmc-web-ui-2026-10-16", which asserted
// the attestation happened 56.8 years AFTER its own origin. Since std.measure.compare_instants only
// orders within one domain, and a same-domain subtraction against that origin would have produced
// nonsense rather than refusing, the origin has to be the thing the count is actually measured from.
// Naming it the epoch makes the count mean what it says and makes the instant comparable with any other
// Unix-epoch instant this repository reads -- the shape gunbc.wall_clock_model already uses for a
// printed wall clock (ModeledWallClock.unix_at_origin: EpochSecs).
//
// PRECISION, stated because the count cannot carry it: the operator's report gave a DATE, not a
// reading-time. So this is the first instant of 2026-10-16 UTC as an EARLIEST BOUND -- "on or after
// 2026-10-16T00:00:00Z" -- and not a claim about the hour. A day-resolution reading stored in a
// nanosecond field is honest only while the field's meaning is recorded, which is what the note below
// is for; a consumer that needs sub-day ordering does not have it here and must not invent it.
data megarac_0_45_3_operator_attestation_instant: ObservationInstant = ObservationInstant {
  domain: SharedMonotonic { origin: "unix-epoch-1970-01-01T00:00:00Z" },
  basis: WallClock,
  // 1792108800 seconds from the epoch = 2026-10-16T00:00:00Z, at nanosecond scale because that is the
  // unit ObservationInstant carries. Derived, not typed from memory: `date -u -d @1792108800` prints
  // exactly that instant, so the count and its origin agree.
  since_origin: nanosecond(count: 1792108800000000000),
}

// THE READING IS DAY-RESOLUTION, AND THAT IS A PROPERTY OF THE READING, NOT OF THE FIELD. Recorded
// here, at the declaration the reader is already looking at, as DESIGN.md Sec 4c requires: a `String`
// declaration whose only purpose is commentary is misplaced or dead data, and `//` is the explicit
// quarantine boundary. The operator's 2026-10-16 web UI read gave a DATE, not a reading-time, so the
// instant above is an EARLIEST BOUND -- "on or after 2026-10-16T00:00:00Z" -- and nothing may treat it
// as sub-day resolution. A question like "was the attestation after run 38789347052?" must come away
// unresolved rather than pick a side; no fold asks it today, which is precisely why the fact is a
// comment rather than a field: a field nothing reads is the dangling row DESIGN.md Sec 3c names, and
// std.measure.measure_clock_basis_note is earlier debt of the same kind, not a precedent to follow.
// If a consumer ever does need sub-day ordering, the resolution becomes a fact worth modelling -- on
// the attestation standing, where an ordering check can read it -- and this comment is where the
// reason it was not modelled now is recorded (review 81312).

// THE CATALOG WE ESTABLISH, keyed by the release identity upstream names. Two rows today, and the
// asymmetry between them is the point: the 0.32 row rests on a committed machine read with no run behind
// it, the 0.45.3 row on an executed run that did not itself read the version plus an operator readback.
data megarac_release_capability_catalog: List<MegaRacReleaseCapabilityEntry> = [
  MegaRacReleaseCapabilityEntry {
    row: BmcFirmwareReleaseCapabilityRow {
      firmware: megarac_firmware_0_32,
      capabilities: [
        CapabilityBootSourceOverride,
        CapabilityPowerControl,
        CapabilityOemRemoteMedia,
      ],
    },
    // The instrument, not the version: this row's release identity is the DeclRef'd upstream identity
    // above, and restating the version string here would be a second representation of it.
    version: MegaRacVersionMachineRead {
      read_from: "ipmitool hpm check, APP component Active column",
    },
    evidence: MegaRacEvidenceCommittedFile {
      artifact_path: "artifacts/bmc/mtcollins1-ipmitool-hpm-check-bmc0.32-2026-10-02.txt",
      read_from: "the 2026-10-02 bring-up readback that established this release",
    },
    citations: [
      bmc_capability_observation_citation(decl_name: "megarac_release_capability_catalog"),
    ],
  },
  // THE 0.45.3 ROW: exactly the three capabilities the named run exercised at this build. Everything else
  // is not claimed here — our coverage obligation, which is precisely the kind of fact that must not live
  // upstream.
  MegaRacReleaseCapabilityEntry {
    row: BmcFirmwareReleaseCapabilityRow {
      firmware: megarac_firmware_0_45_3,
      capabilities: [
        CapabilityBootSourceOverride,
        CapabilityPowerControl,
        CapabilityOemRemoteMedia,
      ],
    },
    version: MegaRacVersionOperatorAttested {
      attested_on: megarac_0_45_3_operator_attestation_instant,
      // What the page showed, minus the version itself: the row's release identity is the DeclRef'd
      // upstream identity above, and a capability record is not where a firmware version is recorded —
      // that is owned by gunbc.machine_intake.mtcollins1_access_observation.
      detail: "operator read of the BMC web UI firmware page: build 'Dec 27 2023 09:36:21 CDT', Image 1; BIOS version 0ACOD014; SCP version shown blank",
      upgrade_read: "the next boot names an attempt receipt and produces the machine-read pre-power hpm check (ipmitool hpm check, APP component Active column), which upgrades this standing",
    },
    evidence: megarac_run_38789347052_evidence,

    citations: [
      bmc_capability_observation_citation(decl_name: "megarac_run_38789347052_evidence"),
    ],
  },
]

// WHETHER A ROW'S VERSION STANDING IS A MACHINE READ, as a question a consumer asks before trusting a
// capability row: an operator attestation is enough to admit a boot, but it is NOT enough to claim the
// controller told us. Today exactly one row answers true (the 0.32 hpm readback); the 0.45.3 row answers
// false, and the boot witness pins that so nobody quietly upgrades it to look machine-verified.
fn megarac_release_version_is_machine_read(entry: MegaRacReleaseCapabilityEntry) -> Bool {
  match entry.version {
    MegaRacVersionMachineRead { read_from: _ } => true
    MegaRacVersionOperatorAttested { attested_on: _, detail: _, upgrade_read: _ } => false
  }
}

// WHETHER A ROW'S VERSION STANDING AND ITS EVIDENCE AGREE — the anti-fabrication invariant, checked
// claim-by-claim in the boot witness. A row may call its version machine-read only if its evidence
// actually records an instrument reading it: a committed readback file, or an executed run that read this
// release. A row resting on an operator's page read must NOT be able to claim a machine read while its own
// evidence says the run read no version at all, and a row backed by a run that read nothing may not be
// quietly relabelled MegaRacVersionMachineRead to make a boot look verified.
fn megarac_release_entry_is_coherent(entry: MegaRacReleaseCapabilityEntry) -> Bool {
  let machine_read = megarac_release_version_is_machine_read(entry: entry)
  match entry.evidence {
    MegaRacEvidenceCommittedFile { artifact_path: _, read_from: _ } => true
    MegaRacEvidenceExecutedRun { run_id: _, run_attempt: _, exercised: _, firmware_read: read, receipt_path: _ } =>
      if machine_read {
        match read {
          MegaRacRunReadFirmware { read: r } => bmc_firmware_release_identity_eq(a: r, b: entry.row.firmware)
          MegaRacRunRecordedNoFirmware { why: _ } => false
        }
      } else {
        true
      }
  }
}

// THE TYPED RELEASE CAPABILITY LOOKUP. Resolve the capability row for an OBSERVED firmware release
// identity against the catalog we establish: one matching entry resolves its row; no entry is a typed
// uncatalogued refusal (never a default); more than one is an ambiguous refusal with its count. This is
// the per-release grain the per-unit row conflated with the unit — a second unit on the same build
// resolves the same row with no new row, and a reflash resolves a different row or refuses.
type MegaRacReleaseCapabilityLookup
  = MegaRacReleaseCapabilityKnown { row: BmcFirmwareReleaseCapabilityRow }
  | MegaRacReleaseCapabilityUncatalogued { firmware: BmcFirmwareReleaseIdentity }
  | MegaRacReleaseCapabilityAmbiguous { firmware: BmcFirmwareReleaseIdentity, count: Int }
    // The release IS catalogued, but its entry's own evidence does not support its version standing.
    // Distinct from Uncatalogued, whose repair is "go read the build": here the row exists and is
    // wrongly asserted, so the repair is to fix or withdraw the entry. Different owner, different
    // action, therefore a different arm — DESIGN's failure-mode list forbids one symbol standing for
    // two conditions whose remedies point at different people.
    | MegaRacReleaseCapabilityIncoherent { firmware: BmcFirmwareReleaseIdentity }

fn megarac_release_capability_row_for(firmware: BmcFirmwareReleaseIdentity) -> MegaRacReleaseCapabilityLookup {
  megarac_release_capability_row_for_in(table: megarac_release_capability_catalog, firmware: firmware)
}

// THE SAME LOOKUP OVER A SUPPLIED TABLE, so the drift refusal is CLAIM-TESTABLE rather than asserted in
// a comment. Review 81287 / manager: a row labelled one release while its evidence read another must
// refuse on BOTH public paths before any effect. That state cannot be built in the shipped table (one
// key, and the shipped rows agree with their evidence), so a witness supplies the drifted table and
// asserts the refusal -- the shape board_soc_edges_for_in set for a supplied edge table. The shipped
// entry point above resolves against the shipped catalog and nothing else, so this is the same
// implementation on both paths, not a second path a consumer could be routed around.
fn megarac_release_capability_row_for_in(
  table: List<MegaRacReleaseCapabilityEntry>,
  firmware: BmcFirmwareReleaseIdentity,
) -> MegaRacReleaseCapabilityLookup {
  let hits = table
    |> filter(entry => bmc_firmware_release_identity_eq(a: entry.row.firmware, b: firmware))
  let n = count(hits)
  if n == 0 {
    MegaRacReleaseCapabilityUncatalogued { firmware: firmware }
  } else if n == 1 {
    fold(
      hits,
      init: MegaRacReleaseCapabilityUncatalogued { firmware: firmware },
      // The ONLY path to a capability row: an entry whose version standing its own evidence does not
      // support is refused rather than returned, so no consumer can be handed a row that drifted from
      // the release it is keyed by, and no separate "check the key matches the row" call is needed
      // somewhere else to keep the two honest.
      f: (_acc, entry) => if megarac_release_entry_is_coherent(entry: entry) {
        MegaRacReleaseCapabilityKnown { row: entry.row }
      } else {
        MegaRacReleaseCapabilityIncoherent { firmware: firmware }
      },
    )
  } else {
    MegaRacReleaseCapabilityAmbiguous { firmware: firmware, count: n }
  }
}
