module gunbc.host.host_fleet_run_step

// THE HOST-FLEET RUN STEPS live here, beside the gunbc.host domain they operate, not in the central
// ci_spec. Each is a GunbcRunStepTarget (its wet entry, function and receipt) beside the invoke that
// wraps it. The only machinery they borrow is shared and imported, never reached through ci_spec:
// gunbc_run_step_script from v2.workflow.gunbc_invoke_step_emit and witness_layer_roots from
// gunbc.ci.ci_layer_roots. fleet_reach_probe lives here too because its entry,
// gunbc.host.host_reach_identity_probe, is host-side.

import std.types { String }
import v2.workflow.gunbc_invoke_step_emit { gunbc_run_step_script }
import gunbc.ci.ci_layer_roots { witness_layer_roots }
import gunbc.ci.ci_run_step_target { GunbcRunStepTarget }
import gunbc.host.host_primary_network_apply { host_primary_network_receipt_path }
import gunbc.host.host_memory_envelope_observe { host_memory_envelope_receipt_path }
import gunbc.host.host_reset_return { host_reset_return_receipt_path }

data gunbc_ci_fleet_reach_probe_target: GunbcRunStepTarget = GunbcRunStepTarget {
  entry: "dag/gunbc/host/host_reach_identity_probe.dag",
  function: "probe_fleet_reach_wet",
}

data gunbc_ci_export_host_reader_converge_target: GunbcRunStepTarget = GunbcRunStepTarget {
  entry: "dag/gunbc/host/export_host_reader_converge.dag",
  function: "export_host_reader_converge_wet",
}

// THE LIVE READER PROBE'S ENTRY (gunbc.host.boot_medium_reader_probe): one wet entry, one receipt path, the
// seven stages and both open facts read inside the run.
data gunbc_ci_boot_medium_reader_probe_target: GunbcRunStepTarget = GunbcRunStepTarget {
  entry: "dag/gunbc/host/boot_medium_reader_probe.dag",
  function: "boot_medium_reader_probe_wet",
}

data gunbc_ci_host_memory_envelope_observe_target: GunbcRunStepTarget = GunbcRunStepTarget {
  entry: "dag/gunbc/host/host_memory_envelope_observe.dag",
  function: "host_memory_envelope_observe_ci_wet",
}

// THE DEPLOY PATH'S BUDGET PREFLIGHT (gunbc.host.host_budget_preflight): read the process cgroup and
// refuse by name, before the fold is paid for, when no limit bounds this process. Read-only; the fold's
// own budget gate stays authoritative.
data gunbc_ci_host_budget_preflight_target: GunbcRunStepTarget = GunbcRunStepTarget {
  entry: "dag/gunbc/host/host_budget_preflight.dag",
  function: "admit_host_budget_declared",
}

data gunbc_ci_host_primary_network_observe_target: GunbcRunStepTarget = GunbcRunStepTarget {
  entry: "dag/gunbc/host/host_primary_network_apply.dag",
  function: "host_primary_network_observe_ci_wet",
}

data gunbc_ci_host_primary_network_converge_target: GunbcRunStepTarget = GunbcRunStepTarget {
  entry: "dag/gunbc/host/host_primary_network_apply.dag",
  function: "host_primary_network_converge_ci_wet",
}

// THE OBSERVER SIDE OF ONE RESET ATTEMPT. It takes no arguments: the dispatch names the OBSERVER, the
// step hands that label over by environment, and the subject is derived from the label through the
// modeled assignment. There is no input of any kind through which a caller could name a subject,
// which is what keeps a reset job from being pointed at its own host.
//
// THE CREDENTIAL ROUTE IS NOT LANDED, and this annotation previously said it was. The entry reads
// gunbc.host.host_reset_return_run host_reset_bmc_credential_path_env and refuses when it is unset,
// but no step in fleet_converge_host_reset_return_job materializes it, so the emitted mode can today
// only reach that first refusal. The materialization has the shape the Spark prelude already
// establishes at gunbc_ci_spark_grant_install_credential_prelude; what is missing is the secret resource
// itself, which is an operator fact and not something this module may invent -- a plausible resource
// name here would render a step that fetches nothing and writes an empty file. The frontier is
// declared in the annotation above gunbc.host.host_reset_return reset_return_verdict_of_mint, and is
// retired by that secret existing, not by any edit here.
data gunbc_ci_host_reset_return_target: GunbcRunStepTarget = GunbcRunStepTarget {
  entry: "dag/gunbc/host/host_reset_return_run.dag",
  function: "host_reset_return_wet",
}

// THE DISPATCH ADMISSION TARGET. It takes no arguments: both values it reads -- the mode and the
// observer label -- arrive by environment on the step, which is the same route the reset entry uses
// for the label. It runs in the BUILD job, after the release binaries exist, because the reset job
// cannot be scheduled at all in the state this refuses.
data gunbc_ci_host_reset_dispatch_admission_target: GunbcRunStepTarget = GunbcRunStepTarget {
  entry: "dag/gunbc/host/host_reset_return_run.dag",
  function: "host_reset_return_dispatch_admission_wet",
}

fn gunbc_ci_fleet_reach_probe_invoke() -> String {
  gunbc_run_step_script(
    source_roots: witness_layer_roots,
    entry: gunbc_ci_fleet_reach_probe_target.entry,
    function: gunbc_ci_fleet_reach_probe_target.function,
    claim_run: false,
    receipt_rel: "target/fleet-reach-probe-receipt.txt"
  )
}

fn gunbc_ci_export_host_reader_converge_invoke() -> String {
  gunbc_run_step_script(
    source_roots: witness_layer_roots,
    entry: gunbc_ci_export_host_reader_converge_target.entry,
    function: gunbc_ci_export_host_reader_converge_target.function,
    claim_run: false,
    receipt_rel: none
  )
}

fn gunbc_ci_boot_medium_reader_probe_invoke() -> String {
  gunbc_run_step_script(
    source_roots: witness_layer_roots,
    entry: gunbc_ci_boot_medium_reader_probe_target.entry,
    function: gunbc_ci_boot_medium_reader_probe_target.function,
    claim_run: false,
    receipt_rel: none
  )
}

fn gunbc_ci_host_primary_network_observe_invoke() -> String {
  gunbc_run_step_script(
    source_roots: witness_layer_roots,
    entry: gunbc_ci_host_primary_network_observe_target.entry,
    function: gunbc_ci_host_primary_network_observe_target.function,
    claim_run: false,
    receipt_rel: host_primary_network_receipt_path
  )
}

fn gunbc_ci_host_primary_network_converge_invoke() -> String {
  gunbc_run_step_script(
    source_roots: witness_layer_roots,
    entry: gunbc_ci_host_primary_network_converge_target.entry,
    function: gunbc_ci_host_primary_network_converge_target.function,
    claim_run: false,
    receipt_rel: host_primary_network_receipt_path
  )
}

fn gunbc_ci_host_memory_envelope_observe_invoke() -> String {
  gunbc_run_step_script(
    source_roots: witness_layer_roots,
    entry: gunbc_ci_host_memory_envelope_observe_target.entry,
    function: gunbc_ci_host_memory_envelope_observe_target.function,
    claim_run: false,
    receipt_rel: host_memory_envelope_receipt_path
  )
}

fn gunbc_ci_host_budget_preflight_invoke() -> String {
  gunbc_run_step_script(
    source_roots: witness_layer_roots,
    entry: gunbc_ci_host_budget_preflight_target.entry,
    function: gunbc_ci_host_budget_preflight_target.function,
    claim_run: false,
    receipt_rel: none
  )
}

fn gunbc_ci_host_reset_return_invoke() -> String {
  gunbc_run_step_script(
    source_roots: witness_layer_roots,
    entry: gunbc_ci_host_reset_return_target.entry,
    function: gunbc_ci_host_reset_return_target.function,
    claim_run: false,
    receipt_rel: host_reset_return_receipt_path as String
  )
}

fn gunbc_ci_host_reset_dispatch_admission_invoke() -> String {
  gunbc_run_step_script(
    source_roots: witness_layer_roots,
    entry: gunbc_ci_host_reset_dispatch_admission_target.entry,
