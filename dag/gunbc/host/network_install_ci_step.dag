module gunbc.host.network_install_ci_step

// THE NETWORK-INSTALL RUN STEPS live here, beside the host network-install domain they operate, not in
// the central ci_spec (gunbc.plans.closure_consolidation P2 -- the pattern of gunbc.fleet.site_pxe_edge_step
// and gunbc.host.hostname_converge_step). The machinery they borrow is shared and imported, never reached
// through the roster: gunbc_run_step_script_for_target from v2.workflow.gunbc_invoke_step_emit and
// witness_layer_roots from gunbc.ci.ci_layer_roots.

import std.types { String }
import v2.workflow.gunbc_invoke_step_emit { gunbc_run_step_script_for_target }
import gunbc.ci.ci_layer_roots { witness_layer_roots }
import gunbc.ci.ci_run_step_target { GunbcRunStepTarget, gunbc_run_step_target }
import v2.std.diagnostic { Outcome }

// THE NETWORK-INSTALL RUN LEAVES ONE ARTEFACT, and it is the receipt the workflow uploads: the dispatch,
// the boot it issued, what the controller read back, what the completion fold said, and whether the edge binding
// was withdrawn. A run that refuses writes the same shape with the refusal in it; there is no silent no-op.
// The path is the STEP's `receipt_rel` — the runner writes the receipt where the step says — so it lives with
// the step, which is also what the workflow's upload step reads. It is deliberately not in
// gunbc.host.network_install_ci, the module that RUNS the install: that module carries the executor's whole
// world, and measuring the artifact gate (gunbc.instruments.generated_artifact_gate) at 12bc0691a427, the two
// readers that needed only this path acquired 70 further dag modules through it. Its sibling facts, the timeout
// and the digest command, already live here. Sibling: gunbc.roadmap.roadmap_launch_deployment_receipt_location.
data managed_host_network_install_receipt_path: String = "target/managed-host-network-install-receipt.txt"

// PXE 2c: the one-shot network install for one admitted arrival unit (bobo/srv15 first). The wet entry named
// here stages the edge binding, boots the unit once, reads the install back through
// gunbc.provisioning.network_install_receipt, and withdraws the binding. It is registered against
// gunbc.host.network_install_ci rather than gunbc.host.network_install because the entry opens an ssh agent,
// reads the workflow environment and writes a receipt, and none of that belongs in the file that declares the
// install's gates, ports and journal; gunbc.host.network_install keeps the gates and never gains an I/O import.
// The entry reads every committed input by lookup and REFUSES srv15 today, naming the missing standing.
data gunbc_ci_managed_host_network_install_target: GunbcRunStepTarget = gunbc_run_step_target(
  module: "gunbc.host.network_install_ci",
  function: "network_install_ci_wet",
)

fn gunbc_ci_managed_host_network_install_invoke() -> Outcome<String> {
  gunbc_run_step_script_for_target(
    source_roots: witness_layer_roots,
    target: gunbc_ci_managed_host_network_install_target,
    claim_run: false,
    receipt_rel: managed_host_network_install_receipt_path
  )
}
