import std.algebra { fold_list }

// WHY THIS EXISTS: host_standup_spine is ONE universal list, and gunbc.host.host_phase_status crossed
// every enrolled host with all of it. That was correct while every enrolled host was the same kind
// of thing -- srv1 through srv4 are Ampere Altra CI runner hosts, provisioned through BMC and
// virtual media, hosting GitHub Actions runner slots and a build cache. It stops being correct the
// moment a host of a DIFFERENT KIND is enrolled: two NVIDIA DGX Spark inference appliances (srv5,
// srv6) have no BMC to converge, no virtual-media OS install, no runner user, no Actions slots and
// no build cache, so crossing them with the universal spine would manufacture obligations that can
// never be satisfied and can never honestly be marked converged. A fleet-completeness number
// computed over invented obligations is worse than no number. THE CORRECTION IS PROGRAM SCOPING,
// NOT AN APPLICABILITY VERDICT: an Applicable-or-NotApplicable arm on the cell would keep the false
// cells and label them, which is the parallel-representation shape (DESIGN section 3) and leaves
// every consumer to remember to filter. A host's participation instead SELECTS which obligations
// exist at all, so an obligation that does not apply is not a cell with a label -- it is not a
// cell.


// The one place a standup phase is bound to what requires it -- an assimilation phase to the
// participations that need it, a prefix phase to the provisioning that owes it -- kept HERE rather
// than as a field on HostStandupStep on purpose. Adding the field would reshape fourteen rows in
// host_standup.dag, which is load-bearing, and that module's own gap-ledger note has already ruled
// that its row-reshaping change stays separable from its status-axis change so the two are
// reviewable apart -- this is the third change in that neighbourhood and it obeys the same ruling.
// The match below is EXHAUSTIVE over both closed phase enums, so a newly added phase does not
// silently default into or out of any program: the compiler refuses until its participations are
// stated. That is the construction half (DESIGN section 5) -- there is no unclassified phase to
// detect after the fact, because an unclassified phase does not compile.

// A PREFIX STEP IS PROVISIONING, AND PROVISIONING FOLLOWS FROM BACKING, NOT FROM ROLE. The four
// Altra steps -- BMC credential convergence, the virtual-media install's mechanism and actuation, and
// the converge policy derived for that install path -- are owed by a host whose OS arrives over BMC
// virtual media, whatever it is enrolled to do. A provider guest owes its adoption instead. An
// appliance that provisions itself through first boot owes no prefix step here: its arrival
// obligations are its own and are authored where that arrival is modeled. The match is exhaustive
// over both enums, so a new phase or a new provisioning path does not compile until it is placed.
fn prefix_phase_applies(p: HostStandupPrefixPhase, backing: HostBacking) -> Bool {
  match backing {
    OwnedMachine { provisioning: OwnedProvisioning { control: c, delivery: d }, unit: _ } => match p {
      BmcCredentialConverge => match c {
        Bmc => true
        NoOutOfBand => false
      }
      OsInstallMechanismResolved => delivery_owes_install(d: d)
      OsInstallActuated => delivery_owes_install(d: d)
      ProviderGuestAdopted => false
      HostConvergePolicyDerived => delivery_owes_install(d: d)
    }
    ProviderGuest { route: _, entitlement: _, resource: _ } => match p {
      BmcCredentialConverge => false
      OsInstallMechanismResolved => false
      OsInstallActuated => false
      ProviderGuestAdopted => true
      HostConvergePolicyDerived => false
    }
  }
}

// ONLY AN OS INSTALLED OVER VIRTUAL MEDIA OWES THE INSTALL STEPS AND A CONVERGE POLICY. An appliance
// image arrives through the appliance's own first boot and a RAM image is booted rather than installed,
// so neither has a mechanism to resolve or an actuation to run. A RAM-image host carries no mutable
// converged state either: its slots and knobs are inputs to the image, owed by the image-baked arm of
// gunbc.host.host_converge fleet_converge_policy_from rather than applied by a converge.
fn delivery_owes_install(d: OwnedOsDelivery) -> Bool {
  match d {
    InstalledViaVirtualMedia => true
    ApplianceImage => false
    RamImageBoot => false
  }
}

// HostIdentityConverge and ReachSecretsNetwork are shared: every enrolled host needs a converged
// identity and an admitted reach path whatever it does for the fleet. ComputeFabricEnroll is shared
// because both kinds offer capacity, though of different shapes -- hardware threads for a runner,
// an inference envelope for an appliance -- and that is the fit-predicate work downstream, not a
// reason to fork the phase. StandupAssimilationComplete is shared because every program needs a
// terminal obligation. RunnerDeploySlot, BuildCacheProvision, CodexRuntimeProvision,
// GreenPlaceReadiness and SessionPlacementEnrollment are CI-runner only: Actions runner slots, an
// sccache build cache, a pinned Codex provider-runtime bundle, dashboard green-place pinning and
// session placement are all facts about executing CI work, and an inference appliance that acquired
// them would be competing with its own serving. InferenceServingProvision is the converse: installing and
// starting the serving engine is owed by an inference-serving host, whether rented or owned, and by no CI
// runner, so a CI-only program stays byte-identical.

fn assimilation_phase_participations(p: HostStandupAssimilationPhase) -> List<FleetParticipation> {
  match p {
    HostIdentityConverge => [CiRunnerParticipation, InferenceServingParticipation]
    ReachSecretsNetwork => [CiRunnerParticipation, InferenceServingParticipation]
    RunnerDeploySlot => [CiRunnerParticipation]
    BuildCacheProvision => [CiRunnerParticipation]
    CodexRuntimeProvision => [CiRunnerParticipation]
    ComputeFabricEnroll => [CiRunnerParticipation, InferenceServingParticipation]
    GreenPlaceReadiness => [CiRunnerParticipation]
    SessionPlacementEnrollment => [InteractiveSessionParticipation]
    InferenceServingProvision => [InferenceServingParticipation]
    StandupAssimilationComplete => [CiRunnerParticipation, InferenceServingParticipation]
  }
}



fn step_serves_participation(step: HostStandupStep, wanted: FleetParticipation) -> Bool {
  match step.phase {
    Prefix { phase: _ } => false
    Assimilation { phase: p } => participation_list_contains(ps: assimilation_phase_participations(p: p), wanted: wanted)
  }
}

fn step_serves_any(step: HostStandupStep, wanted: List<FleetParticipation>) -> Bool {
  fold_list(
    xs: wanted,
    empty: false,
    cons: fn(acc, w) { if acc { true } else { step_serves_participation(step: step, wanted: w) } }
  )
}

// A step is in a host's program when its provisioning owes it (a prefix step) or one of its
// participations does (an assimilation step).
fn step_in_program(step: HostStandupStep, intent: HostEnrollmentIntent) -> Bool {
  match step.phase {
    Prefix { phase: p } => prefix_phase_applies(p: p, backing: intent.backing)
    Assimilation { phase: _ } => step_serves_any(step: step, wanted: intent.participation)
  }
}

// Phases whose participation is modeled but that no REAL fleet enrollment carries yet. This is the
// set the spine-claimed claim keys on (by phase, never by label or count); its frontier row below is
// the declaration that admits them, and deleting the row's phase from this list is how it dissolves.
data phases_awaiting_a_real_enrollment: List<HostStandupAssimilationPhase> = [InferenceServingProvision]

fn step_phase_awaits_a_real_enrollment(step: HostStandupStep, awaiting: List<HostStandupAssimilationPhase>) -> Bool {
  match step.phase {
    Prefix { phase: _ } => false
    Assimilation { phase: p } => any(awaiting, q => q == p)
  }
}

data host_assimilation_program_frontier_rows: List<FrontierRow> = [
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.host.host_assimilation_program", decl_name: "phases_awaiting_a_real_enrollment"),
    reason: "InferenceServingProvision maps to InferenceServingParticipation, and no real gunbc.fleet.fleet_enrollment fleet_enrollments entry carries that participation (the Sparks were sold), so the phase is in no real host program; the spine-claimed claim admits it only through this row",
    dissolution: unbound_dissolution(description: "a real enrollment carries InferenceServingParticipation: the flex wet create (product.fabric.flex_market) produces a RentedAllocationAcquired allocation whose intent gunbc.serving.rented_allocation_host_enrollment derives, or the owned RTX PRO 6000 enrollment lands. SUFFICIENT FOR deleting this row and the phase from phases_awaiting_a_real_enrollment, after which witness_every_spine_step_is_claimed_by_some_participation needs no exception"),
  ),
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.ci.ci_runner_placement", decl_name: "runner_image_baked_deployment_plan"),
    reason: "the image-baked arm (RamImageBoot hosts: fleet_image_baked_offers, ConvergePolicyDerived.image_baked) is derived but no image build input reads it yet: the runner_host_medium publish that bakes a host's slots and knobs into its seeded image is a later change, so the arm's only readers today are its witnesses. The trigger is the declaration gunbc.runner.runner_host_medium runner_host_image_slot_roster that folds runner_image_baked_deployment_plan into that image-build input; it must be executed by a claim that a RamImageBoot host's image carries the derived runner count before this row is deleted",
    dissolution: bound_dissolution(ref: decl_ref(module_path: "gunbc.runner.runner_host_medium", decl_name: "runner_host_image_slot_roster")),
  ),
]

type HostAssimilationProgram {
  identity: NonEmptyStr
  steps: List<HostStandupStep>
}

// The program is DERIVED from the spine by participation, never a second hand-authored step list. A
// hand-authored inference program would be a parallel representation of the spine and would drift
// the first time a phase changed, which is the defect the host_standup gap ledger already records
// against itself. Deriving also gives the refactor its identity guarantee for free: a host enrolled
// for CI participation alone selects every step in the spine, because every phase in the spine
// today exists to serve runner hosts, so srv1 through srv4 keep byte-identical cells rather than
// merely similar ones. That identity is asserted by an executing witness rather than argued here.

fn assimilation_program_for(intent: HostEnrollmentIntent) -> HostAssimilationProgram {
  HostAssimilationProgram {
    identity: host_enrollment_program_identity(intent: intent),
    steps: filter(host_standup_spine, s => step_in_program(step: s, intent: intent)),
  }
}

// Enrollment participation is authored as a non-empty list at every fleet enrollment site today. An
// empty list would yield an empty program identity (invalid NonEmptyStr) and zero completion
// obligations; a NonEmptyList carrier on HostEnrollmentIntent is deferred until enrollment
// validation walls land.

// Participation has SET semantics but is carried as a List, and identity must not be able to tell
// the two apart. Step selection already reads the list as membership -- step_serves_any asks only
// whether SOME participation claims the step -- so order and repetition are invisible to which
// obligations exist. Deriving the identity from the raw list did let them through: [CiRunner,
// InferenceServing] and [InferenceServing, CiRunner] and [CiRunner, CiRunner, InferenceServing]
// select exactly the same steps while producing three different identity strings, which is a second
// representation of one program (DESIGN section 3) and would fork any consumer that keys on
// identity. The correction projects through a FIXED roster instead of reading the caller's list
// order: filtering the roster by membership yields at most one occurrence of each participation, in
// one order, whatever the caller wrote. That is the construction half -- a duplicate or a
// reordering cannot reach the identity, so there is no post-hoc canonicalization check to remember
// to call. The roster's own completeness is the residue this cannot construct away, and it is
// walled by an EXHAUSTIVE match in fleet_participation_in_canonical_roster: a newly added
// participation does not compile until it is stated there, and its witness reds if it is stated but
// left out of the roster.

data fleet_participation_canonical_roster: List<FleetParticipation> = [
  CiRunnerParticipation,
  InferenceServingParticipation,
  InteractiveSessionParticipation,
]

fn fleet_participation_in_canonical_roster(p: FleetParticipation) -> Bool {
  match p {
    CiRunnerParticipation =>
      participation_list_contains(ps: fleet_participation_canonical_roster, wanted: CiRunnerParticipation)
    InferenceServingParticipation =>
      participation_list_contains(ps: fleet_participation_canonical_roster, wanted: InferenceServingParticipation)
    InteractiveSessionParticipation =>
      participation_list_contains(ps: fleet_participation_canonical_roster, wanted: InteractiveSessionParticipation)
  }
}

fn canonical_participation(ps: List<FleetParticipation>) -> List<FleetParticipation> {
  filter(fleet_participation_canonical_roster, c => participation_list_contains(ps: ps, wanted: c))
}

fn host_enrollment_program_identity(intent: HostEnrollmentIntent) -> NonEmptyStr {
  join(
    map(canonical_participation(ps: intent.participation), p => fleet_participation_label(p: p)),
    "+"
  ) as NonEmptyStr
}

fn program_step_count(program: HostAssimilationProgram) -> Int {
  program.steps.length()
}


// Completion inputs derive as the union over enrolled participations, deduplicated by
// AssimilationCompleteInput identity, not as a priority chain over participation kinds. A host
// enrolled for both CI and inference must carry every obligation either role requires; ordering in
// the participation list must not drop CI-only inputs when inference is listed first.

fn assimilation_completion_input_list_contains(
  inputs: List<AssimilationCompleteInput>,
  wanted: AssimilationCompleteInput,
) -> Bool {
  fold_list(
    xs: inputs,
    empty: false,
    cons: fn(acc, r) {
      if acc {
        true
      } else {
        r == wanted
      }
    }
  )
}

fn assimilation_completion_input_append_unique(
  inputs: List<AssimilationCompleteInput>,
  wanted_input: AssimilationCompleteInput,
) -> List<AssimilationCompleteInput> {
  if assimilation_completion_input_list_contains(inputs: inputs, wanted: wanted_input) {
    inputs
  } else {
    append(inputs, [wanted_input])
  }
}

fn assimilation_completion_inputs_union(
  a: List<AssimilationCompleteInput>,
  b: List<AssimilationCompleteInput>,
) -> List<AssimilationCompleteInput> {
  fold_list(
    xs: b,
    empty: a,
    cons: fn(acc, wanted_input) {
      assimilation_completion_input_append_unique(inputs: acc, wanted_input: wanted_input)
    }
  )
}

// Completion obligations are derived from participation beside the phase classification tables
// above, not as fixed fields on AssimilationCompleteGate. CiRunnerParticipation requires all four
// AssimilationCompleteInput arms because a CI runner host must be node-registered,
// resources-present, green-place coherent via the gunbc gate (not merely P3 modeled), and
// runner-slot healthy. InferenceServingParticipation requires only NodeRegistered and
// ResourcesPresent: an inference appliance has no GitHub Actions runner slot to health-check and no
// dashboard green-place pin to coherence-check, so those inputs are not obligations and cannot be
// supplied without fabricating evidence. GreenPlacePinCoherent and RunnerSlotHealthy are CI-only
// because they gate facts about executing CI work (dashboard pin coherence, Actions slot
// enforcement), not generic host readiness.

data shared_completion_inputs: List<AssimilationCompleteInput> = [
  NodeRegistered,
  ResourcesPresent,
]

data ci_runner_only_completion_inputs: List<AssimilationCompleteInput> = [
  GreenPlacePinCoherent,
  RunnerSlotHealthy,
]

fn assimilation_completion_inputs_for_one(p: FleetParticipation) -> List<AssimilationCompleteInput> {
  match p {
    CiRunnerParticipation =>
      append(shared_completion_inputs, items: ci_runner_only_completion_inputs)
    InferenceServingParticipation =>
      shared_completion_inputs
    InteractiveSessionParticipation =>
      shared_completion_inputs
  }
}

data empty_assimilation_complete_input_list: List<AssimilationCompleteInput> = []

fn assimilation_completion_inputs_for(participation: List<FleetParticipation>) -> List<AssimilationCompleteInput> {
  fold_list(
    xs: participation,
    empty: empty_assimilation_complete_input_list,
    cons: fn(acc, p) {
      assimilation_completion_inputs_union(
        a: acc,
        b: assimilation_completion_inputs_for_one(p: p)
      )
    }
  )
}

fn default_unsatisfied_witness_for_input(input: AssimilationCompleteInput) -> AssimilationInputWitness {
  match input {
    NodeRegistered =>
      InputGap { input: NodeRegistered, interim_realization: "ctrl:node_registry.mjs" }
    ResourcesPresent =>
      InputGap { input: ResourcesPresent, interim_realization: "ctrl:resources-present-unmodeled" }
    GreenPlacePinCoherent =>
      assimilation_input_witness_from_green_place(w: host_standup_p3_green_place_input_witness())
    RunnerSlotHealthy =>
      InputGap { input: RunnerSlotHealthy, interim_realization: "gunbc.runner.runner_slot_enforcement until P1 converged" }
  }
}

fn assimilation_gate_unsatisfied_for_participation(participation: List<FleetParticipation>) -> AssimilationCompleteGate {
  AssimilationCompleteGate {
    obligations: map(
      assimilation_completion_inputs_for(participation: participation),
      fn(wanted_input) {
        AssimilationObligation {
          input: wanted_input,
          witness: default_unsatisfied_witness_for_input(input: wanted_input),
        }
      }
    ),
  }
}

fn host_standup_default_assimilation_gate_unsatisfied() -> AssimilationCompleteGate {
  assimilation_gate_unsatisfied_for_participation(participation: ci_runner_enrollment_participation)
}

fn host_standup_p3_fail_closed_blocks_complete() -> Bool {
  !host_standup_p3_gunbc_pinned_tree_landed
    && match assimilation_complete(
      gate: host_standup_default_assimilation_gate_unsatisfied(),
      required: assimilation_completion_inputs_for(participation: ci_runner_enrollment_participation),
    ) {
      AssimilationIncomplete { input: GreenPlacePinCoherent, reason: r } =>
        string_contains(s: r, pattern: "#5948")
      AssimilationComplete => false
      AssimilationIncomplete { input: _, reason: _ } => true
    }
}
