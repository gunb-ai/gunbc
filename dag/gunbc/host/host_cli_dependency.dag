module gunbc.host_cli_dependency

import extdeps.tools { CliTool, install_hint }
import extdeps.tools.npm { npm_cli_tool }
import extdeps.tools.sshpass { sshpass_cli_tool }
import extdeps.shell
import std.types { String, NonEmptyStr }
import v2.std.optional { Optional, Present, Absent, optional_absent, optional_present }

// Host CLI placement for wet witnesses: observe whether an executable is on PATH before attempting
// shell transport. A missing npm on the falsifier runner surfaced as runtime error: failed to
// execute npm (os error 2) and classified as WitnessRed — indistinguishable from a subject failure.
// This module refuses BEFORE execution with a typed wire HostDependencyAbsent with tool and hint
// fields that claim_executor reads structurally (falsifier recovery PR D, run 31685755058 component
// 6). ENROLLMENT ANSWER: codex_wet_materialization_host_cli_requirements on this module; absent npm
// stops as HostDependencyAbsent, never auto-install inside the witness.

// observe_host_cli_dependency keys on shell.PosixCommandV.Check.exists (Bool from exit_success),
// NOT .path: under WET execution .path is a bare stdout string, not Optional, and matching it
// raises non-exhaustive pattern match on the healthy path — the Value::Null / Optional realization
// fork (DESIGN open thread). Same limit as gunbc.roadmap_belt_actuate belt_program_available_note
// and falsifier-recovery PR A. Resolved path is blocked until the split lands; locality is
// unestablished. (This module migrated off shell.Which.Check to shell.PosixCommandV.Check --
// crisp-wren-896, PR #8590 -- because gunbc.ci_fleet's own CI/falsifier runner carries the
// identical distro_or_product: none as srv1-4, so the operational apt-install evidence that once
// justified `which` here does not establish it as a fact the typed model carries; command -v's
// weaker, dominant assumption holds everywhere `which` did and does not depend on that evidence.)

// Part-two wall arithmetic CONFIRMED from floor-component-receipt run 31685755058 (not inherited):
// component 1 cold control wall_ms=3480830 (~58.0 min, 9016 witnesses); component 6 wall_ms=2946579
// (~49.1 min, 16 witnesses, npm absent WitnessRed before this PR); components 7-9 outcome=skipped
// failure_mode=run_incomplete wall_ms=0 witnesses=0 — never executed before the 170-minute step
// cap. Batch-1 cold-control cost is a separate lane; this PR does not raise
// deadline/swap/max-parallel.

// A ROSTER IS A LIST OF THE TOOLS ITSELF, and getting here took two removals in two commits.
// First the enrolled tool was a NonEmptyStr tag resolved back to a CliTool by a hand-rolled
// if-chain, so "a row naming a tool no CliTool owns" was representable and answered by a runtime
// arm; carrying the CliTool made that unwritable and deleted the arm (§5, §4b rung 4).
//
// What survived that climb was its own residue: a HostCliEnrollmentRequirement wrapper whose other
// field, `provision`, existed ONLY to feed the deleted arm. Nothing read it afterwards -- a data
// row no fold reads, which §3c calls dangling and §4b(4) says a climb must dissolve along with the
// machinery it obsoletes. It was also a SECOND INSTALL NARRATIVE beside CliTool.installable_via:
// the row said "apt install sshpass on every runner that executes a password-session leg" while
// every live refusal took its hint from install_hint(sources: tool.installable_via), so the two
// could disagree and only one was ever read.
//
// Dropping it left a single-field wrapper around a type that already exists, which is a concept
// re-invented rather than reused, so the wrapper goes too. THE POPULATION FACT IS NOT LOST: it was
// never in `provision` in any load-bearing way -- it is carried by WHICH ROSTER a tool appears in,
// which is exactly what the separate rosters below are for, and the prose restated their identity
// rather than adding to it.

data codex_wet_materialization_host_cli_requirements: List<CliTool> = [npm_cli_tool]

// SECOND ENROLLMENT ANSWER, and it is a SEPARATE roster rather than a row appended to the one
// above, because the two answer about different runner populations: the codex roster is about the
// falsifier cadence runner image, this one is about whichever runner executes a password-session
// leg. Merging them would make a runner that never opens a password session refuse for a binary it
// has no use for, and would make the npm requirement bind on runners the codex cadence never
// touches -- one name covering two materially different obligations, which is the meaning fork §3
// forbids. A runner that does both simply satisfies both rosters.
//
// MEASURED, not anticipated: mode=spark_grants on runners srv3 and srv4 died with
// `failed to execute 'sshpass': No such file or directory` while srv1 and srv2 carried the binary,
// so the password session's host prerequisite was an unmodeled provisioning accident in exactly the
// way #11039's fleet key was -- invisible for as long as the runners that happened to have it were
// the only ones anyone ran against. The raw exec error is also the WRONG DIAGNOSIS at the point a
// reader sees it: it names a local PATH gap in the vocabulary of a remote session failure, so it
// reads as "the host rejected us". gunbc.fleet_bootstrap_principal_session now refuses BEFORE the
// invocation with a cause naming the binary; this roster is the fact that refusal is derived from.
//
// TWO CONSUMERS, ONE POPULATION. gunbc.bmc_fan_converge asks this same roster, having previously
// hand-rolled shell.PosixCommandV.Check against the literal "sshpass" -- a second authority for
// this fact. It belongs here rather than in a BMC-specific roster because it is the same
// obligation: that leg reaches the BMC through extdeps.bmc.openbmc_password_ssh_transport, whose
// argv also begins `sshpass -d 0 ssh`. "Executes a password-session leg" is the membership test,
// and it is about the TRANSPORT the runner must be able to spawn, not about which fleet the far
// side belongs to.
data password_session_host_cli_requirements: List<CliTool> = [sshpass_cli_tool]

// The absence is its own type, not a variant used in type position. Before this split,
// first_absent_codex_wet_materialization_host_cli_dependency named HostCliDependencyAbsent as its
// element type; the type system has no such thing, so the column widened to the parent coproduct
// and every consumer match was correctly reported non-exhaustive for a sibling that cannot occur
// there. Naming the fact makes both consumer matches exhaustive with the arms they already have.
type HostCliDependencyAbsence {
  tool: NonEmptyStr
  hint: String
}

type HostCliDependencyObservation
  = HostCliDependencyPresent
  | HostCliDependencyAbsent { absence: HostCliDependencyAbsence }

fn observe_host_cli_dependency(tool: CliTool) -> HostCliDependencyObservation {
  let check = shell.PosixCommandV.Check(command: tool.name)
  if check.exists {
    HostCliDependencyPresent
  } else {
    HostCliDependencyAbsent {
      absence: HostCliDependencyAbsence {
        tool: tool.name,
        hint: install_hint(sources: tool.installable_via),
      },
    }
  }
}

// THE FOLD IS PARAMETERIZED BY THE ROSTER rather than copied per roster. The second enrollment
// answer (password sessions) would otherwise have duplicated this whole walk -- the §2 duplication
// that a second roster invites and that the roster split does not require.
fn first_absent_codex_wet_materialization_host_cli_dependency() -> HostCliDependencyAbsence? {
  first_absent_host_cli_dependency(tools: codex_wet_materialization_host_cli_requirements)
}

fn first_absent_password_session_host_cli_dependency() -> HostCliDependencyAbsence? {
  first_absent_host_cli_dependency(tools: password_session_host_cli_requirements)
}

fn first_absent_host_cli_dependency(
  tools: List<CliTool>,
) -> HostCliDependencyAbsence? {
  fold_list(
    xs: tools,
    empty: none,
    cons: fn(acc, tool) {
      match acc {
        Present { value: found } => Present { value: found }
        Absent =>
          match observe_host_cli_dependency(tool: tool) {
            HostCliDependencyAbsent { absence } => Present { value: absence }
            HostCliDependencyPresent => none
          }
      }
    },
  )
}

fn host_dependency_absent_wire(tool: NonEmptyStr, hint: String) -> String {
  concat(
    "HostDependencyAbsent\{tool=",
    concat(tool as String, concat(",hint=", concat(hint, "\}"))),
  )
}

fn host_cli_dependency_failure_receipt(
  observation: HostCliDependencyObservation,
) -> Optional<String> {
  match observation {
    HostCliDependencyPresent => optional_absent()
    HostCliDependencyAbsent { absence } =>
      optional_present(
        value: host_dependency_absent_wire(tool: absence.tool, hint: absence.hint),
      )
  }
}
