module gunbc.host_build_cache_provision

import std.types { String, NonEmptyStr, Bool }
import std.cache_identity { CacheInterfaceId }
import std.disposition { Disposition, Scaffold, SingleAuthority, RealizationDispatch, Terminal }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.process { ProcessExit, exit_failure }
import std.resources { Network }
import extdeps.cache.sccache { sccache_local_id }
import gunbc.host_build_cache_catalog_gate {
  provision_build_cache_catalog_gate_verdict,
  ProvisionBuildCacheCatalogRealizable,
  ProvisionBuildCacheCatalogRefused,
}
import gunbc.host_effect { HostEffect, EnsureBuildCacheInstance }
import gunbc.host_toolchain_ensure { host_toolchain_ensure, BuildCache }
import gunbc.build_cache_instance { ci_cache_instance }
import product.placement_supply { HostIdentity }

data host_build_cache_provision_naming_hazard_note: String = "NAMING HAZARD, RECORD BEFORE TOUCHING EITHER FILE. This module (host_build_cache_provision.dag) and the now-deleted host_build_cache_provision_script.dag differed by one suffix, held unrelated concepts (this one a catalog-gate/verdict fold; that one a concat-shell body builder), and one was edited while the other was deleted in the SAME PR (#8598, the A5 EnsureBuildCacheInstance arm swap) -- a trap the tree itself set, not a naming choice either file made carelessly. It produced a real false-negative: a dependents-census grep answering 'does a disconnected verdict fold exist' checked the deleted file's own leftover state and reported that as though it answered the question about THIS file's fold, which was not re-grepped. The next person doing anything near either name: grep the exact module path, not the shared prefix. The catalog-gate/verdict fold this module used to hold (BuildCacheDaemonObservation / provision_build_cache_verdict / placement_verdict / build_cache_provision_gate_accepts) was a separate finding: zero non-test, non-self-file callers tree-wide, confirmed 2026-08-20, filed in docs/plans/shell-to-dag-residual-census-and-arc-completion.md (C-note) first as a deletion candidate and then, the same day, corrected to the opposite disposition -- an unconsumed authority naming itself as the fix for a live incident class, which must be wired rather than deleted. IT IS WIRED AS OF 2026-08-21, AND IT NO LONGER LIVES HERE -- it moved to gunbc.build_cache_provision_verdict, because wiring it meant gunbc.host_effect_realize had to call it and this module's import of gunbc.host_toolchain_ensure would have closed a cycle through that module. The zero no longer reproduces: gunbc.host_effect_realize build_cache_ensure_step folds provision_build_cache_verdict over the endpoint re-observed AFTER its ensure shell ran, so the fold is the POSTCONDITION on the provisioning path while gunbc.build_cache_ensure admit_ensure_build_cache_instance is the precondition. The sentence is rewritten rather than annotated because a stale 'zero callers' claim in a naming-hazard warning is the exact false-negative this note exists to prevent, pointed the other way."

data lane_e_srv1_ci_noncompletion_root_cause_receipt: String = "LANE E ROOT-CAUSE RECEIPT (2026-08-06 investigation; quarantine mechanism RETIRED 2026-08-07 — see retirement paragraph). SYMPTOM CLASS INVESTIGATED: cargo check -p v1-compiler-tests --tests killed at the 15m compile-gate ceiling while still compiling v1-compiler. HARM MEASURE: count long cancelled jobs as capacity absorption, not only conclusion=failure — a 14m cancelled build costs the same slot-hours as a 15m killed build. EXECUTED EVIDENCE (historical failure): runs 31060400858 (srv1-05) and 31060543168 (srv1-01), killed at 15m mid-Compiling v1-compiler; srv1-02 build cancelled at 14m (still-bat-561 sample). SLOT DISCRIMINANT (Lane E measurement): srv1 is NOT uniformly broken — still-bat-561 measured srv1-04 build success in ~1m and srv1-03 regen success in the same window srv1-01/05 cold-killed at 15m; warm-cache fleet runs complete the compile gate in ~50s–1m. MECHANISM (load-bearing): one CI sccache endpoint per host; cache-miss compiles execute as CHILDREN OF THE SERVER PROCESS (extdeps.cache.sccache sccache_server_process_facts), so the server's cgroup bounds every compile on the host — not the slot that issued the compile. A server stranded in a retired slot's cgroup (pid 3975946 in srv1-10, 2026-08-01 receipt) exported one dead slot's memory ceiling to all live slots on cache miss. FIX AUTHORITY: ServerManagedUnitOwned on the managed compile-pool slice — ServerRunnerOwned on ANY lifecycle (active or retired) must refuse ProvisionConverged (placement_verdict, build_cache_placement_observation_test witness_both_runner_lifecycles_refuse_at_the_verdict). 2026-08-07 STATUS: INCIDENT CLEARED, NOT REPAIRED — pid 3975946 gone; surviving server on srv1 is runner-owned on ACTIVE slot srv1-02 (~90s old at observation), same ServerRunnerOwned class srv2/srv3 already carried per 2026-08-01 receipt; ephemeral runner recycle is the only reason it has not stranded again — the class can strand again the next time a slot retires while holding the server. POST-INCIDENT MEASUREMENT (still-bat-561, 45 completed runs sampled 2026-08-07, kill-shape = non-success with duration 13–18m): srv1 16 jobs / 5 non-success / 0 kill-shape; srv2 26 / 6 / 2; srv3 29 / 12 / 0; srv4 49 / 14 / 1 — srv1 has zero kill-shape failures while srv2 and srv4 still show them; host-scoped CI quarantine would route work toward hosts currently exhibiting the defect. QUARANTINE RETIREMENT: ci-fleet-admit host-label gate (PR #7889) retired rather than merged — premise expired and measurement inverted the remedy; this receipt is the durable home for the investigation."

data host_build_cache_provision_scope_disposition: Disposition = SingleAuthority

data host_build_cache_provision_realize_scaffold: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.host_effect_realize",
    decl_name: "realize_provision_build_cache",
    field: WholeDeclaration,
  }
}

data ci_sccache_opportunistic_detect_scaffold: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "v2.workflow.ci_materialization_emit",
    decl_name: "ci_sccache_provider_shell_injection",
    field: WholeDeclaration,
  }
}
fn provision_build_cache_effect_for_host(host: HostIdentity) -> HostEffect {
  EnsureBuildCacheInstance { desired: ci_cache_instance(host: host) }
}

fn provision_build_cache_default_effect(host: HostIdentity) -> HostEffect {
  provision_build_cache_effect_for_host(host: host)
}

fn provision_build_cache_routes_through_host_effect_apply() -> Bool {
  match host_build_cache_provision_realize_scaffold {
    Scaffold {
      dissolves_to: RealizationDispatch,
      bind: DeclarationRef { module_path: m, decl_name: n, field: _ },
    } =>
      m == "gunbc.host_effect_realize" && n == "realize_provision_build_cache"
    Terminal { reason: _ } => false
  }
}



func provision_build_cache(host: HostIdentity, catalog_id: CacheInterfaceId) -> ProcessExit
  uses net: Network
{
  match provision_build_cache_catalog_gate_verdict(catalog_id: catalog_id) {
    ProvisionBuildCacheCatalogRefused { reason: reason } => exit_failure(reason: reason as String)
    ProvisionBuildCacheCatalogRealizable => host_toolchain_ensure(host: host, kind: BuildCache)
  }
}
