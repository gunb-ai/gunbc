module gunbc.host.memory_envelope_receipt_reading

import std.types { Bool, Int, List, NonEmptyStr, String }
import std.optional { Absent, Present }
import std.measure { ByteSize, byte_size, byte_size_count }
import std.algebra { trim }
import extdeps.linux.cgroup_v2_memory {
  CgroupMemoryLimitValue, CgroupMemoryLimited, CgroupMemoryUnlimited, CgroupMemoryLimitUnparseable, parse_cgroup_memory_limit,
}
import gunbc.host.memory_envelope { MemoryEnvelopeVerdict, EnvelopeHeld, EnvelopeViolated, memory_envelope_verdict }

// THE MEMORY RECEIPT A `gunbc test` SUBJECT STEP PRINTS, READ BACK (gunbc.plans.mtcollins1_ci_service_legs G3a). The
// envelope's requirement, grain and verdict are gunbc.host.memory_envelope's; the seed prints the line at step exit
// (v1_compiler.target_invocation_host memory_envelope_receipt):
//
//   gunbc test: MEMORY RECEIPT grain=<g> cgroup=<dir> limit_max=<m> limit_high=<h> swap_max=<s> peak_bytes=<n> (peak:
//   <prose>) high_events_delta=<n> max_events_delta=<n> oom_kills_delta=<n> swap_current_bytes=<n> swap_peak_delta=<n
//   or prose>
//
// and, when the envelope was violated, the same receipt AFTER a `gunbc test: MEMORY ENVELOPE VIOLATED` sentence on the
// same line. THE KEY SET IS DECLARED HERE, ONCE, IN THE PRINTER'S ORDER, and the reading refuses a key that is missing
// or that appears twice; it never skips a garbled line. Each value is the first word after its key, except the last
// key, whose value is the rest of the line (the printer may write prose there). Two values carry spaces in the
// printer's own text (the peak's parenthetical scope and an unobservable swap peak) and are therefore NOT read as
// words: the scope is not decoded at all, and an unobservable swap peak reads as an absent delta.

data memory_receipt_marker: String = "gunbc test: MEMORY RECEIPT "
data memory_envelope_violated_marker: String = "gunbc test: MEMORY ENVELOPE VIOLATED"

data memory_receipt_keys: List<String> = [
  "grain", "cgroup", "limit_max", "limit_high", "swap_max", "peak_bytes",
  "high_events_delta", "max_events_delta", "oom_kills_delta", "swap_current_bytes", "swap_peak_delta",
]

type MemoryReceiptReading {
  violated: Bool
  grain: NonEmptyStr
  cgroup: NonEmptyStr
  limit_max: CgroupMemoryLimitValue
  limit_high: CgroupMemoryLimitValue
  swap_max: CgroupMemoryLimitValue
  peak: ByteSize
  high_events_delta: Int
  max_events_delta: Int
  oom_kills_delta: Int
  swap_current: ByteSize
  swap_peak_delta: Int?
}

type MemoryReceiptLine
  = NotAMemoryReceipt
  | MemoryReceiptRead { reading: MemoryReceiptReading }
  | MemoryReceiptGarbled { line: String, cause: NonEmptyStr }

fn receipt_garbled(line: String, cause: String) -> MemoryReceiptLine {
  MemoryReceiptGarbled { line: line, cause: cause as NonEmptyStr }
}

// THE PAYLOAD AFTER THE MARKER, prefixed with a space so every key, the first included, is found as " key=".
fn receipt_payload(line: String) -> String? {
  let halves = split(s: line, delimiter: memory_receipt_marker)
  if count(halves) == 2 {
    match halves.skip(n: 1).first() {
      Present { value: p } => Present { value: concat(" ", p) }
      Absent => none
    }
  } else {
    none
  }
}

type ReceiptField
  = ReceiptFieldRead { value: String }
  | ReceiptFieldMissing
  | ReceiptFieldRepeated

fn receipt_field(payload: String, key: String, rest_of_line: Bool) -> ReceiptField {
  let parts = split(s: payload, delimiter: concat(concat(" ", key), "="))
  if count(parts) == 1 {
    ReceiptFieldMissing
  } else if count(parts) > 2 {
    ReceiptFieldRepeated
  } else {
    match parts.skip(n: 1).first() {
      Absent => ReceiptFieldMissing
      Present { value: after } =>
        if rest_of_line {
          ReceiptFieldRead { value: trim(s: after) }
        } else {
          match split(s: after, delimiter: " ").first() {
            Absent => ReceiptFieldMissing
            Present { value: word } => ReceiptFieldRead { value: word }
          }
        }
    }
  }
}

fn receipt_word(payload: String, key: String) -> String? {
  match receipt_field(payload: payload, key: key, rest_of_line: false) {
    ReceiptFieldRead { value: v } => if v == "" { none } else { Present { value: v } }
    ReceiptFieldMissing => none
    ReceiptFieldRepeated => none
  }
}

// A LIMIT IS THE KERNEL'S, decoded by the kernel interface's own authority (extdeps.linux.cgroup_v2_memory
// parse_cgroup_memory_limit): a byte count or `max`, never text compared as text. A body that is neither is no limit.
fn receipt_limit(payload: String, key: String) -> CgroupMemoryLimitValue? {
  match receipt_word(payload: payload, key: key) {
    Absent => none
    Present { value: w } =>
      match parse_cgroup_memory_limit(body: w) {
        CgroupMemoryLimitUnparseable { body: _ } => none
        v => Present { value: v }
      }
  }
}

fn receipt_count(payload: String, key: String) -> Int? {
  match receipt_word(payload: payload, key: key) {
    Absent => none
    Present { value: w } =>
      match parse_int(s: w) {
        Present { value: n } => if n >= 0 { Present { value: n } } else { none }
        Absent => none
      }
  }
}

// THE FIRST KEY THAT IS MISSING, REPEATED OR (for the numeric keys) NOT A NON-NEGATIVE INTEGER, named.
fn receipt_key_fault(payload: String) -> String? {
  match memory_receipt_keys |> filter(k => match receipt_field(payload: payload, key: k, rest_of_line: k == "swap_peak_delta") {
    ReceiptFieldRead { value: v } => v == ""
    ReceiptFieldMissing => true
    ReceiptFieldRepeated => true
  }) |> first() {
    Present { value: k } => Present { value: concat("the receipt's key is missing, repeated or empty: ", k) }
    Absent =>
      match ["peak_bytes", "high_events_delta", "max_events_delta", "oom_kills_delta", "swap_current_bytes"] |> filter(k => match receipt_count(payload: payload, key: k) { Absent => true Present { value: _ } => false }) |> first() {
        Present { value: k } => Present { value: concat("the receipt's value is not a non-negative integer: ", k) }
        Absent => none
      }
  }
}

fn memory_receipt_line(line: String) -> MemoryReceiptLine {
  match receipt_payload(line: line) {
    Absent =>
      if string_contains(s: line, pattern: memory_receipt_marker) { receipt_garbled(line: line, cause: "the receipt marker appears more than once on one line") } else { NotAMemoryReceipt }
    Present { value: payload } =>
      match receipt_key_fault(payload: payload) {
        Present { value: why } => receipt_garbled(line: line, cause: why)
        Absent => receipt_of_words(line: line, payload: payload)
      }
  }
}

// EVERY FIELD IS MATCHED; NO FIELD HAS A FALLBACK. receipt_key_fault has already named the first faulty key, so each
// Absent arm below repeats that refusal for the key it guards rather than inventing a value.
fn receipt_of_words(line: String, payload: String) -> MemoryReceiptLine {
  match receipt_word(payload: payload, key: "grain") { Absent => receipt_garbled(line: line, cause: "grain") Present { value: grain } =>
  match receipt_word(payload: payload, key: "cgroup") { Absent => receipt_garbled(line: line, cause: "cgroup") Present { value: cgroup } =>
  match receipt_limit(payload: payload, key: "limit_max") { Absent => receipt_garbled(line: line, cause: "limit_max is neither a byte count nor max") Present { value: limit_max } =>
  match receipt_limit(payload: payload, key: "limit_high") { Absent => receipt_garbled(line: line, cause: "limit_high is neither a byte count nor max") Present { value: limit_high } =>
  match receipt_limit(payload: payload, key: "swap_max") { Absent => receipt_garbled(line: line, cause: "swap_max is neither a byte count nor max") Present { value: swap_max } =>
  match receipt_count(payload: payload, key: "peak_bytes") { Absent => receipt_garbled(line: line, cause: "peak_bytes") Present { value: peak } =>
  match receipt_count(payload: payload, key: "high_events_delta") { Absent => receipt_garbled(line: line, cause: "high_events_delta") Present { value: high_events } =>
  match receipt_count(payload: payload, key: "max_events_delta") { Absent => receipt_garbled(line: line, cause: "max_events_delta") Present { value: max_events } =>
  match receipt_count(payload: payload, key: "oom_kills_delta") { Absent => receipt_garbled(line: line, cause: "oom_kills_delta") Present { value: oom_kills } =>
  match receipt_count(payload: payload, key: "swap_current_bytes") { Absent => receipt_garbled(line: line, cause: "swap_current_bytes") Present { value: swap_current } =>
    MemoryReceiptRead { reading: MemoryReceiptReading {
      violated: string_contains(s: line, pattern: memory_envelope_violated_marker),
      grain: grain as NonEmptyStr,
      cgroup: cgroup as NonEmptyStr,
      limit_max: limit_max,
      limit_high: limit_high,
      swap_max: swap_max,
      peak: byte_size(peak),
      high_events_delta: high_events,
      max_events_delta: max_events,
      oom_kills_delta: oom_kills,
      swap_current: byte_size(swap_current),
      swap_peak_delta: match receipt_field(payload: payload, key: "swap_peak_delta", rest_of_line: true) {
        ReceiptFieldRead { value: v } => parse_int(s: v)
        ReceiptFieldMissing => none
        ReceiptFieldRepeated => none
      },
    } }
  } } } } } } } } } }
}

// THE ENVELOPE VERDICT IS gunbc.host.memory_envelope's, NOT THIS READER'S (review 86991, DESIGN section 3): the receipt's
// decoded fields are the verdict's four inputs exactly as the printer supplies them (v1_compiler.target_invocation_host
// memory_envelope_receipt) -- the OOM kills this step added, the swap resident at exit, whether the swap peak rose
// (absent where this kernel cannot show it), and whether swap is forbidden (swap_max is exactly 0).
fn memory_receipt_verdict(r: MemoryReceiptReading) -> MemoryEnvelopeVerdict {
  memory_envelope_verdict(
    oom_kills_delta: r.oom_kills_delta,
    swap_current: Present { value: byte_size_count(b: r.swap_current) as Int },
    swap_peak_rose: match r.swap_peak_delta {
      Present { value: d } => Present { value: d > 0 }
      Absent => none
    },
    swap_max_zero: match r.swap_max {
      CgroupMemoryLimited { bytes: b } => byte_size_count(b: b) == 0
      CgroupMemoryUnlimited => false
      CgroupMemoryLimitUnparseable { body: _ } => false
    },
  )
}

// THE PRINTED SENTENCE AND THE VERDICT MUST AGREE. The printer writes MEMORY ENVELOPE VIOLATED exactly when its verdict
// violates, so a receipt whose sentence and recomputed verdict disagree was not written by that printer over these
// numbers: it is its own standing, and it is not held.
type MemoryReceiptStanding
  = MemoryReceiptHeld
  | MemoryReceiptViolated { verdict: MemoryEnvelopeVerdict }
  | MemoryReceiptSentenceDisagrees { printed_violated: Bool, verdict: MemoryEnvelopeVerdict }

fn memory_receipt_standing(r: MemoryReceiptReading) -> MemoryReceiptStanding {
  let verdict = memory_receipt_verdict(r: r)
  match verdict {
    EnvelopeHeld => if r.violated { MemoryReceiptSentenceDisagrees { printed_violated: true, verdict: verdict } } else { MemoryReceiptHeld }
    EnvelopeViolated { oom_kills_delta: _, swap_current: _, swap_peak_rose: _, swap_max_zero: _ } =>
      if r.violated { MemoryReceiptViolated { verdict: verdict } } else { MemoryReceiptSentenceDisagrees { printed_violated: false, verdict: verdict } }
  }
}

fn memory_receipt_held(r: MemoryReceiptReading) -> Bool {
  match memory_receipt_standing(r: r) {
    MemoryReceiptHeld => true
    MemoryReceiptViolated { verdict: _ } => false
    MemoryReceiptSentenceDisagrees { printed_violated: _, verdict: _ } => false
  }
}
