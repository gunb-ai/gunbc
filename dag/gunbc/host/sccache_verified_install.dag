module gunbc.host.sccache_verified_install

import std.types { NonEmptyStr, String }

import extdeps.crypto.hash { Digest }
import extdeps.cache.sccache { SccacheBinaryRelease, sccache_installed_binary_path }
import gunbc.host.verified_binary_install {
  VerifiedBinaryInstallParams,
  verified_binary_install_shell,
  verified_binary_install_admitted_plan,
}

// THE SCCACHE BOUNDARY VALUES, SUPPLIED ONCE.
//
// `gunbc.host.verified_binary_install` is the effect and names no product; this module is the
// adapter that says what an sccache install IS. It exists as one module rather than as two blocks
// of parameter literals at the two call sites because the two sites are the same effect on the same
// binary, and this repository has already been bitten by spelling one concept in two authorities:
// the comment above `sccache_installed_binary_path` records a P1/P1b fork where the runner installed
// `apt-get install -y sccache` to /usr/bin/sccache while the cache module installed a pinned v0.15.0
// tarball to /usr/local/bin, both firing on the same host. Two copies of `https://github.com/mozilla/
// sccache/releases/download/` assembled by hand is that fork waiting to happen again.
//
// WHAT IT READS: `SccacheBinaryRelease` (version + per-arch digests, the cited release row) and
// `sccache_installed_binary_path` (where the pinned release lands). Those are sccache's own
// authority in extdeps.cache.sccache; this adapter composes them into the generic parameter record
// and adds only the staging layout the cited tarball's shape dictates.
//
// WHAT IT DOES NOT DO: decide the refusal. A digest mismatch is refused by
// `verified_binary_install_admitted_plan` in the generic module, which returns
// `RefusedToInstall { reason, expected, observed_line, dest_path, source_url }` — a refusal the
// consumer must report, never an empty list that could be read as "nothing to do". This module is
// where the digest COMES FROM, which is why a witness that changes the digest here is the RED that
// says nothing gets installed.

// THE STAGING LAYOUT OF THE CITED TARBALL. The release publishes
// `sccache-v<version>-<arch>-unknown-linux-musl.tar.gz`, and the archive contains that same
// directory with `sccache` inside it. These are facts of the cited release's layout, and they are
// the reason the generic effect takes member/staged paths as parameters instead of deriving them:
// the derivation belongs to whoever can cite the archive.
fn sccache_release_archive_dir(rel: SccacheBinaryRelease, arch: NonEmptyStr) -> String {
  join(["sccache-", rel.version as String, "-", arch as String, "-unknown-linux-musl"], "")
}

fn sccache_release_archive_url(rel: SccacheBinaryRelease, arch: NonEmptyStr) -> String {
  let dir = sccache_release_archive_dir(rel: rel, arch: arch)
  join(["https://github.com/mozilla/sccache/releases/download/", rel.version as String, "/", dir, ".tar.gz"], "")
}

// THE PARAMETER RECORD BOTH CONSUMERS RUN THE EFFECT THROUGH. `+x` rather than `0755`: the cited
// installer added the executable bit to the file the archive shipped, which is the mode statement
// that survives an archive member whose owner bits are already what they are; a wholesale octal
// would be a different claim. Elevated because /usr/local/bin is not writable by the runner user,
// and the elevation is the non-interactive sudo, so a host without the NOPASSWD grant refuses
// instead of prompting on a tty.
fn sccache_verified_install_params(
  rel: SccacheBinaryRelease,
  arch: NonEmptyStr,
  digest: Digest,
) -> VerifiedBinaryInstallParams {
  let dir = sccache_release_archive_dir(rel: rel, arch: arch)
  VerifiedBinaryInstallParams {
    url: sccache_release_archive_url(rel: rel, arch: arch),
    digest: digest,
    archive_member: join([dir, "/sccache"], ""),
    staged_root: join(["/tmp/", dir], ""),
    staged_binary_path: join(["/tmp/", dir, "/sccache"], ""),
    download_path: "/tmp/sccache.tar.gz",
    extract_root: "/tmp",
    dest_path: sccache_installed_binary_path,
    exec_mode: "+x" as NonEmptyStr,
    elevated: true,
  }
}

// THE FULL SHELL FORM, for a consumer that runs the install as its own script (the runner host
// deploy P1 prereq step, which provisions sccache as a prerequisite and nothing else).
fn sccache_verified_install_script(
  rel: SccacheBinaryRelease,
  arch: NonEmptyStr,
  digest: Digest,
) -> String {
  verified_binary_install_shell(p: sccache_verified_install_params(rel: rel, arch: arch, digest: digest))
}

// THE RED'S ENTRY POINT, AND WHY IT IS HERE RATHER THAN IN THE GENERIC MODULE. The claim "a digest
// mismatch refuses and nothing gets installed" is about sccache's digest, so the test supplies
// sccache's boundary values with the digest swapped and reads back the refusal: the plan is refused,
// its reason names both digests, and `verified_binary_install_plan_steps` on it is empty. Same shape
// for the positive control: with the release row's own digest the plan is Planned with the five
// install steps (extract, move, mode, and the two staging removals).
fn sccache_verified_install_admitted_plan(
  rel: SccacheBinaryRelease,
  arch: NonEmptyStr,
  digest: Digest,
  observed_sha256sum_line: String,
) -> VerifiedBinaryInstallPlan {
  verified_binary_install_admitted_plan(
    p: sccache_verified_install_params(rel: rel, arch: arch, digest: digest),
    observed_sha256sum_line: observed_sha256sum_line,
  )
}
