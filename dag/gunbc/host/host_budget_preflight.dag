module gunbc.host.host_budget_preflight

// THE DEPLOY PATH ASKS THE SLOT THE QUESTION THE FOLD WOULD ASK -- AND EARLIER.
//
// WHAT THIS IS. A read-only admission the dashboard-deploy job runs BEFORE the deploy fold step: read
// /proc/self/cgroup, walk the v2 bounding dirs, probe memory.max and memory.high, and refuse by name
// unless a limit that BOUNDS this process is present. The fold's own gate stays authoritative --
// cli_run's typed_module_cache_cap_derivation refuses an unreadable budget before resolving the
// corpus (src/v1/stage0/src/cli_run/entry_resolve.rs, the HostBudgetUnreadable arms) -- and this
// admission does not replace or widen it. What it changes is WHERE the job learns: today, on a slot
// whose unit drifted from the declared shape (DESIGN recurring_failure_mode
// the_live_runner_unit_memory_shape_drifts_from_the_declared_slot), the job's first budget word arrives
// deep inside the fold's resolve -- after the dispatch has spent the approval gate and a chunk of the
// fold's ~10-minute budget -- and it arrives as one line at the end of a long step. This step answers
// in seconds, at the top of the deploy run, naming every probed file and what it said (limited N,
// unlimited, absent, unreadable), so the operator's converge decision gets a receipt-shaped failure
// instead of a fold post-mortem. This is the earliest unjustified boundary for failure (c) (run
// 38865847078, srv1, HostBudgetUnreadable at resolve): the deploy paid fold-cost on a host whose
// budget was never declared; the admission moves the SAME question earlier, which is moving it
// cheaper, not widening anything (§5).
//
// WHY THE REQUIREMENT IS memory.max (OR ITS v1 ANALOGUE) AND NOT memory.high. The authority is
// gunbc.host.host_budget_source, and this admission asks it the question rather than re-deriving an
// answer: host_budget_source_bounds_this_process is the single place that says which sources constrain
// allocation (memory.max: observed AND enforced; memory.high: an observed throttle that allocation may
// cross while the kernel reclaims; MemTotal/MemAvailable and any environment integer: not bounds at
// all). Probing memory.high only, and calling it an envelope, would be the second representation §3
// forbids -- an envelope that allocation walks through is not an envelope.
//
// WHY THE CACHE-CAP ENVIRONMENT GUARD IS PART OF THE REQUIREMENT.
// GUNBC_TYPED_MODULE_CACHE_MAX_ENTRIES short-circuits the fold's budget gate entirely
// (entry_resolve.rs reads it before any host read). A deploy fold running with that set is NOT running
// under the slot's bound -- it is running under a hand-typed eviction ceiling that hides whether the
// slot exists at all. That is fine for development and disqualifying for the deploy path, so a deploy
// dispatch carrying it is refused by name here, at the same place and for the same reason the fold's
// own gate refuses an unreadable budget. GUNBC_MEMORY_BUDGET_BYTES is NOT refused: per the authority's
// disposition row it may only REQUEST a lower planning ceiling, never replace the observation, so it
// cannot hide an absent envelope.
//
// WHAT IS NOT HERE. No cgroup-v1 walk: the fleet's runners are systemd units on cgroup v2 (the heal
// lane's own cgroup-diag reads memory.max/memory.high paths under actions-runner@<host>.service), so a
// v1 probe would be a second hierarchy model with no live consumer; if a v1 host ever joins the fleet
// the probe list grows by one file name and the authority already has the source arm for it. No bind,
// no create, no write: every effect here is a read. GUNBC_BIND_MEMORY_CGROUP_BYTES stays out -- the
// fleet jobs refuse to self-bind a leaf (memory_envelope_receipt_seed_growth: MemoryCgroupBindRefused,
// designed for containerized remote builds, not fleet hosts), and the slot's limit belongs to the
// unit, not to the step.
//
// THE SEED MIRROR, DECLARED RATHER THAN LEFT IMPLICIT (the pattern this repo uses for every value the
// seed hand-realizes): the files probed, the Unlimited rendering, and the two environment names mirror
// src/v1/stage0/src/memory_governor.rs (read_host_budget_resolution / read_env_declared_bytes / the
// GUNBC_TYPED_MODULE_CACHE_MAX_ENTRIES read in cli_run's typed_module_cache_cap_derivation). A change
// to the seed's budget sources is a change to this probe list; the witness here pins the verdicts the
// seed's arms imply.

import std.types { String, Bool, Int, List, NonEmptyStr }
import std.optional { Optional, Present, Absent }
import std.measure { ByteSize, byte_size_count }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.linux.proc_self_cgroup { proc_self_cgroup_unified_hierarchy_paths }
import extdeps.linux.cgroup_v2 { cgroup_v2_mount_point }
import extdeps.linux.cgroup_v2_memory { CgroupMemoryLimitValue, CgroupMemoryLimited, CgroupMemoryUnlimited, CgroupMemoryLimitUnparseable, parse_cgroup_memory_limit }
import gunbc.host.host_budget_source { HostBudgetSource, BudgetSourceCgroupMemoryMax, BudgetSourceCgroupMemoryHigh, host_budget_source_label, host_budget_source_bounds_this_process }
import gunbc.actions_run_binding { actions_variable_trimmed }

data proc_self_cgroup_path: String = "/proc/self/cgroup"
data cgroup_memory_max_file_name: String = "memory.max"
data cgroup_memory_high_file_name: String = "memory.high"
data gunbc_typed_module_cache_max_entries_env_name: String = "GUNBC_TYPED_MODULE_CACHE_MAX_ENTRIES"

// ONE PROBE RESULT: a (dir, file) pair and what the file said. Unreadable carries the transport's own
// words -- "absent" and "not readable to this process" are different operators' problems and the
// receipt must not blur them.
data BudgetProbe { cgroup_dir: String, file_name: String, value: BudgetProbeValue }

type BudgetProbeValue
  = ProbeLimited { bytes: ByteSize }
  | ProbeUnlimited
  | ProbeUnreadable { detail: String }

type HostBudgetPreflightVerdict
  = PreflightAdmitted { source_label: String, bytes: ByteSize }
  | PreflightCeilingOverrideRefused { env_name: String }
  | PreflightMembershipAbsent { detail: String }
  | PreflightNoBoundingBudget { probes: List<String> }

fn host_budget_probe_source(p: BudgetProbe) -> HostBudgetSource? {
  if p.file_name == cgroup_memory_max_file_name {
    Present { value: BudgetSourceCgroupMemoryMax { cgroup_dir: p.cgroup_dir as NonEmptyStr } }
  } else if p.file_name == cgroup_memory_high_file_name {
    Present { value: BudgetSourceCgroupMemoryHigh { cgroup_dir: p.cgroup_dir as NonEmptyStr } }
  } else {
    Absent
  }
}

// THE RULING, PURE ON THE PROBES. Admission needs a file whose source the authority calls a bound
// (host_budget_source_bounds_this_process -- memory.max or its v1 analogue) AND whose read says a
// number. Anything else -- unlimited, unreadable, high-only, nothing -- refuses with every probe line
// rendered, because the absence is only actionable if it says WHAT IT SAW.
fn admit_host_budget_probes(
  ceiling_override_present: Bool,
  membership_readable: Bool,
  probes: List<BudgetProbe>
) -> HostBudgetPreflightVerdict {
  if ceiling_override_present {
    PreflightCeilingOverrideRefused { env_name: gunbc_typed_module_cache_max_entries_env_name }
  } else if !membership_readable {
    PreflightMembershipAbsent { detail: proc_self_cgroup_path }
  } else {
    let bounding = filter(probes, p => match host_budget_probe_source(p: p) {
      Present { value: source } => host_budget_source_bounds_this_process(s: source)
        && match p.value { ProbeLimited { bytes: _ } => true ProbeUnlimited => false ProbeUnreadable { detail: _ } => false }
      Absent => false
    })
    if length(bounding) > 0 {
      match bounding.first() {
        Present { value: winner } =>
          match host_budget_probe_source(p: winner) {
            Present { value: source } =>
              match winner.value {
                ProbeLimited { bytes: bytes } => PreflightAdmitted { source_label: host_budget_source_label(s: source) as String, bytes: bytes }
                _ => PreflightNoBoundingBudget { probes: render_budget_probes(probes: probes) }
              }
            Absent => PreflightNoBoundingBudget { probes: render_budget_probes(probes: probes) }
          }
        Absent => PreflightNoBoundingBudget { probes: render_budget_probes(probes: probes) }
      }
    } else {
      PreflightNoBoundingBudget { probes: render_budget_probes(probes: probes) }
    }
  }
}

fn budget_probe_text(p: BudgetProbe) -> String {
  let value_text = match p.value {
    ProbeLimited { bytes: bytes } => join(["limited ", to_string(byte_size_count(b: bytes))], "")
    ProbeUnlimited => "unlimited"
    ProbeUnreadable { detail: detail } => join(["unreadable: ", detail], "")
  }
  join([p.cgroup_dir, "/", p.file_name, " = ", value_text], "")
}

fn render_budget_probes(probes: List<BudgetProbe>) -> List<String> {
  map(probes, p => budget_probe_text(p: p))
}

fn host_budget_preflight_refusal(verdict: HostBudgetPreflightVerdict) -> String {
  match verdict {
    PreflightAdmitted { source_label: source_label, bytes: bytes } =>
      join(["host budget preflight admitted: ", source_label, " ", to_string(byte_size_count(b: bytes))], "")
    PreflightCeilingOverrideRefused { env_name: env_name } =>
      join(["host budget preflight refused: the deploy dispatch sets ", env_name, ", which short-circuits the fold's own budget gate before any host read (src/v1/stage0/src/cli_run/entry_resolve.rs reads it first); a fold running under a hand-typed eviction ceiling is not a fold running under the slot's bound, so the deploy path refuses it by name; unset it to deploy"], "")
    PreflightMembershipAbsent { detail: detail } =>
      join(["host budget preflight refused: ", detail, " could not be read, so this process cannot name the cgroup that is supposed to bound it; the fold's own gate refuses the same way (HostBudgetUnreadable) -- this step just says it before the fold is paid for (dag/gunbc/host/host_budget_source.dag)"], "")
    PreflightNoBoundingBudget { probes: probes } =>
      join(["host budget preflight refused: no file probed declares a limit that BOUNDS this process (memory.max or its v1 analogue; memory.high alone is a throttle, not a bound -- gunbc.host.host_budget_source host_budget_source_bounds_this_process). Probes: ", join(probes, " | "), ". This is DESIGN's the_live_runner_unit_memory_shape_drifts_from_the_declared_slot: the runner unit's memory shape, not the deploy, is what needs the fix (operator-dispatched converge)."], "")
  }
}

// THE EFFECTS HALF: read membership, walk the bounding dirs the typed reader yields, probe both files
// under each, hand the pure ruling everything it needs to name the absence. One Read per file; the
// order is the hierarchy's own (innermost first), so the admitted source is the tightest probed bound
// the hierarchy reports -- the fold derives its own cache cap and is authoritative for it.
fn probe_cgroup_memory_file(cgroup_dir: String, file_name: String) -> BudgetProbe {
  let read = Filesystem.Read(path: join([cgroup_dir, "/", file_name], ""))
  if !read.success {
    BudgetProbe { cgroup_dir: cgroup_dir, file_name: file_name, value: ProbeUnreadable { detail: read.error } }
  } else {
    match parse_cgroup_memory_limit(body: read.content) {
      CgroupMemoryLimited { bytes: bytes } => BudgetProbe { cgroup_dir: cgroup_dir, file_name: file_name, value: ProbeLimited { bytes: bytes } }
      CgroupMemoryUnlimited => BudgetProbe { cgroup_dir: cgroup_dir, file_name: file_name, value: ProbeUnlimited }
      CgroupMemoryLimitUnparseable { body: body } => BudgetProbe { cgroup_dir: cgroup_dir, file_name: file_name, value: ProbeUnreadable { detail: join(["unparseable body: ", body], "") } }
    }
  }
}

fn probe_cgroup_dirs(dirs: List<String>) -> List<BudgetProbe> {
  concat(map(dirs, d => [
    probe_cgroup_memory_file(cgroup_dir: d, file_name: cgroup_memory_max_file_name),
    probe_cgroup_memory_file(cgroup_dir: d, file_name: cgroup_memory_high_file_name)
  ]))
}

// THE STEP'S ENTRY. Reads only: /proc/self/cgroup, the two interface files per bounding dir, and two
// environment names. Exits 0 exactly when a bounding limit is present; every refusal names itself and
// carries the probe lines.
fn admit_host_budget_declared() -> ProcessExit {
  let ceiling_override = actions_variable_trimmed(name: gunbc_typed_module_cache_max_entries_env_name as NonEmptyStr) != ""
  let membership = Filesystem.Read(path: proc_self_cgroup_path)
  let dirs = if membership.success {
    map(proc_self_cgroup_unified_hierarchy_paths(content: membership.content), p => concat(cgroup_v2_mount_point as String, p as String))
  } else {
    []
  }
  let verdict = admit_host_budget_probes(
    ceiling_override_present: ceiling_override,
    membership_readable: membership.success,
    probes: probe_cgroup_dirs(dirs: dirs)
  )
  match verdict {
    PreflightAdmitted { source_label: source_label, bytes: bytes } => ExitSuccess
    _ => exit_failure(reason: host_budget_preflight_refusal(verdict: verdict))
  }
}
