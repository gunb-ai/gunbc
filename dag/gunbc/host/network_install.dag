// THE CONTENTS PRECONDITION: what the committed capture says is ON the disk about to be erased.
//
// The install destroys exactly one thing — the target disk — so its precondition is scoped to that disk and
// to nothing else (the unit's host-scoped prior life, such as the in-band BMC credential recovery and the
// hand-edited Aptio setting recorded in artifacts/bmc/srv15-inband-recovery-2026-10-29/00_README.txt, belongs
// to the arrival door's PriorLifeBoundary, not here). The admitting arm is named for WHAT WAS READ rather
// than for a conclusion: the readers on srv15's capture were `lsblk -o NAME,SIZE,FSTYPE,LABEL,PARTLABEL` and
// `sfdisk -l`, which report no partition table and no filesystem. Neither sweeps 931.5 GiB, so the type does
// not claim byte-emptiness, and a reader list is part of what was admitted rather than prose beside it.
type DiskContentsReader = LsblkBlockDeviceReport | SfdiskPartitionTableReport

type TargetDiskContents
  // What the two readers reported on the named artifact at the named instant: no partition table, no
  // filesystem on any partition, nothing the firmware offers as an OS on that disk. THE ONLY ADMITTING ARM.
  = NoPartitionTableOrFilesystemReported {
      captured_in: NonEmptyStr
      read_at: EpochMs
      readers: List<DiskContentsReader>
    }
  // A partition table, or a partition reporting a filesystem. The disk has content; erasing it is a prior-life
  // effect and this workflow does not perform it. Refusal.
  | PartitionTableOrFilesystemReported {
      captured_in: NonEmptyStr
      read_at: EpochMs
      readers: List<DiskContentsReader>
    }
  // Nothing was read, or what was read cannot be attributed to both readers on a named artifact. Refusal:
  // "nobody looked" is not evidence of "nothing there".
  | ContentsNotRead { reason: NonEmptyStr }
  // THE CONTENTS WERE READ FROM A DIFFERENT ARTIFACT THAN THE ONE THAT GAVE THE SERIAL AND MODEL. Refusal: the
  // erase is authorized by ONE capture, and a blank disk read out of some other file does not license erasing
  // the disk this run pinned. This is what keeps "the disk was blank" from drifting onto a stale or borrowed
  // reading as the fleet row is edited over the months.
  | ContentsEvidenceFromAnotherArtifact { reported: NonEmptyStr, identity: NonEmptyStr }

// WHAT THE READERS REPORTED, before admission turns it into a permission. Raw optionals rather than tokens:
// the only thing that turns a report into an admitted TargetDiskContents is admit_target_disk_contents.
type DiskContentsReport {
  captured_in: NonEmptyStr
  read_at: EpochMs
  partition_table_reported: Bool
  filesystems_reported: List<NonEmptyStr>
  readers: List<DiskContentsReader>
}

type TargetDiskContentsAdmission
  = TargetDiskContentsAdmitted { contents: TargetDiskContents }
  | TargetDiskContentsRefused { contents: TargetDiskContents }

// WHICH ARTIFACT AUTHORIZED THIS ERASE. The reading is the evidence 2a's admission was decided on, and its
// captured_in is the only artifact whose "nothing is on that disk" can be trusted for this install. NotRead and
// NoDiskReported name no artifact: they can never have admitted a disk, and the arm below refuses anyway.
fn target_disk_reading_captured_in(reading: TargetDiskReading) -> Optional<NonEmptyStr> {
  match reading {
    DiskReported { captured_in: captured_in } => Present { value: captured_in }
    NoDiskReported { captured_in: captured_in } => Present { value: captured_in }
    NotRead { host: _ } => Absent
  }
}

fn disk_contents_reader_eq(a: DiskContentsReader, b: DiskContentsReader) -> Bool {
  a == b
}

fn disk_contents_report_has_reader(report: DiskContentsReport, reader: DiskContentsReader) -> Bool {
  list_member(xs: report.readers, x: reader, eq: disk_contents_reader_eq)
}

// THE ADMITTING ROUTE. Three things must hold, and each refuses with its own named cause. BOTH READERS must
// be present: lsblk alone cannot rule out a partition table it did not enumerate, and sfdisk alone does not
// report filesystems. The report must come from THE SAME ARTIFACT that reported the serial and model — the
// artifact is passed in rather than trusted from the report's own header, because a report that vouches for
// itself vouches for nothing. And nothing may have been seen: a partition table or any filesystem is content,
// and this workflow does not erase content. Anything short of that is a refusal, and a refusal boots nothing.
fn admit_target_disk_contents(
  report: DiskContentsReport, identity_captured_in: NonEmptyStr
) -> TargetDiskContentsAdmission {
  if disk_contents_report_has_reader(report: report, reader: LsblkBlockDeviceReport) == false {
    TargetDiskContentsRefused {
      contents: ContentsNotRead { reason: "the capture names no lsblk block-device report" }
    }
  } else if disk_contents_report_has_reader(report: report, reader: SfdiskPartitionTableReport) == false {
    TargetDiskContentsRefused {
      contents: ContentsNotRead { reason: "the capture names no sfdisk partition-table report" }
    }
  } else if (report.captured_in as String) != (identity_captured_in as String) {
    TargetDiskContentsRefused {
      contents: ContentsEvidenceFromAnotherArtifact {
        reported: report.captured_in, identity: identity_captured_in
      }
    }
  } else if report.partition_table_reported == true {
    TargetDiskContentsRefused {
      contents: PartitionTableOrFilesystemReported {
        captured_in: report.captured_in,
        read_at: report.read_at,
        readers: report.readers,
      }
    }
  } else if report.filesystems_reported.length() > 0 {
    TargetDiskContentsRefused {
      contents: PartitionTableOrFilesystemReported {
        captured_in: report.captured_in,
        read_at: report.read_at,
        readers: report.readers,
      }
    }
  } else {
    TargetDiskContentsAdmitted {
      contents: NoPartitionTableOrFilesystemReported {
        captured_in: report.captured_in,
        read_at: report.read_at,
        readers: report.readers,
      }
    }
  }
}

// ─────────────────────────────── THE COMPLETION JOURNAL ───────────────────────────────
//
// WHY A JOURNAL AT ALL. The dated disk admission cannot stop a SECOND install: after a successful install the
// fleet row is still inside its window, so a second dispatch would authorize a second erase under the one
// authorization that was issued for the first. "This run already completed" is a fact about the world that
// only survives the run, so it is stored durably — through the compare-and-set store under
// gunbc.host_state_root host_state_tree on srv4, which is the state plane this fleet already uses. It is read
// as the run's FIRST effect, before the BMC is reachable, so a repeat dispatch refuses before any write.
//
// ONE RECORD PER (UNIT, DISK SERIAL), WHICH IS WHY THERE IS NO PARSER. The identity of a completion is in its
// SLOT KEY, not in a payload that has to be decoded: a completion for a unit whose disk was later replaced is
// a different key and does not block reinstalling onto the new disk (which is right — the new disk needs its
// own fresh reading anyway). The payload carries only the completion instant, so the only parsing in this file
// is "are these digits", using the same digits reader the CAS store itself uses.
data network_install_journal_slot_prefix: NonEmptyStr = "network-install-completion/"

fn network_install_journal_slot_key(host: HostIdentity, serial: NonEmptyStr) -> NonEmptyStr {
  concat(network_install_journal_slot_prefix, host as String, "/", serial)
}

// WHAT THE SLOT SAYS. Four readings, because "absent", "unreadable" and "not what we wrote" are three
// different facts with three different answers: only Absent permits an install. Unreadable refuses (an
// exclusive store that cannot be read is not evidence of exclusivity), and Malformed refuses rather than
// guessing that a foreign payload means "not installed".
type NetworkInstallJournalReading
  = JournalSlotAbsent
  | JournalSlotCompleted { completed_at: EpochMs }
  | JournalSlotUnreadable { detail: String }
  | JournalSlotMalformed { payload: String }

// THE PURE READING OF A SLOT PAYLOAD. The wet entry reads the payload out of the CAS store and hands it here;
// keeping the store's probe type out of this function is what lets the claim be driven without a live srv4.
// The payload is the completion instant in DECIMAL and nothing else — the slot key already says which unit
// and which disk this completion belongs to, so there is nothing else to parse, and the one reading used is
// the same digits reader the CAS store itself uses to name a generation.
fn network_install_journal_reading(payload: Optional<String>) -> NetworkInstallJournalReading {
  match payload {
    Absent => JournalSlotAbsent
    Present { value: text } => match cas_generation_of_digits(s: text) {
      Absent => JournalSlotMalformed { payload: text }
      Present { value: digits } => JournalSlotCompleted { completed_at: cas_generation_count(g: digits) }
    }
  }
}

// THE COMPLETION RECORD, and the only route that mints it. It is minted from the two facts that must BOTH
// hold — the install was read back, and the binding was verified gone — so a run that could not withdraw its
// binding cannot record a completion, and the host stays retryable rather than being locked out by its own
// half-finished install. There is no other constructor and no field is writable from outside.
type NetworkInstallCompletion sole_constructor {
  host: HostIdentity
  serial: NonEmptyStr
  completed_at: EpochMs
  install_receipt: NonEmptyStr
  withdrawal_verified: Bool
}

type NetworkInstallCompletionAdmission
  = NetworkInstallCompletionAdmitted { completion: NetworkInstallCompletion }
  // A completion is not written when the install was not read back: nothing proves the erase landed.
  | NetworkInstallCompletionRefusedInstallUnread { host: HostIdentity }
  // A completion is not written when the binding is still being served: the next PXE boot of that client
  // would find an installer, which is the residue this workflow exists to remove.
  | NetworkInstallCompletionRefusedBindingNotWithdrawn { host: HostIdentity, path: NonEmptyStr }

fn admit_network_install_completion(
  host: HostIdentity,
  serial: NonEmptyStr,
  completed_at: EpochMs,
  install_receipt: NonEmptyStr,
  install_read_back: Bool,
  binding_withdrawn_verified: Bool,
  binding_path: NonEmptyStr
) -> NetworkInstallCompletionAdmission {
  if install_read_back == false {
    NetworkInstallCompletionRefusedInstallUnread { host: host }
  } else if binding_withdrawn_verified == false {
    NetworkInstallCompletionRefusedBindingNotWithdrawn { host: host, path: binding_path }
  } else {
    NetworkInstallCompletionAdmitted {
      completion: NetworkInstallCompletion {
        host: host,
        serial: serial,
        completed_at: completed_at,
        install_receipt: install_receipt,
        withdrawal_verified: true,
      }
    }
  }
}

// THE PAYLOAD A COMPLETION WRITES: the completion instant, decimal, and nothing else. The write is a
// compare-and-set against the Absent the run read, so a dispatcher that recorded first wins and this one
// loses the CAS instead of silently rewriting a completion it did not perform.
fn network_install_journal_payload(completion: NetworkInstallCompletion) -> String {
  completion.completed_at as String
}

fn network_install_completion_host(completion: NetworkInstallCompletion) -> HostIdentity {
  completion.host
}

fn network_install_completion_serial(completion: NetworkInstallCompletion) -> NonEmptyStr {
  completion.serial
}

fn network_install_completion_instant(completion: NetworkInstallCompletion) -> EpochMs {
  completion.completed_at
}

// ───────────────────────────── THE DISPATCH ADMISSION ─────────────────────────────
//
// THE ONE QUESTION: may this run erase this disk on this unit, right now? Everything downstream — the edge
// write, the Redfish PATCH, the reset — is admitted only by an answer of Admitted from here, and the answer is
// computed from inputs alone so a witness can drive every refusal without a live BMC, a live edge, or a live
// srv4. The wet entry reads the clock, reads the journal slot and the hold, and hands the results here; it
// acts on nothing until this returns.
//
// THE ORDER IS THE SPECIFICATION. Each step's refusal short-circuits the rest, so an earlier refusal means
// the later questions were never asked — which is what makes "refuses before any BMC write" a property of the
// code rather than of a comment:
//   JOURNAL  a completion for (unit, serial) already exists → InstallAlreadyCompleted, before anything.
//   HOLD     someone else holds the unit, or the store cannot be read → refuse; exclusivity must be PROVEN.
//   SUBJECT  the unit is not an admitted arrival with a bound, authorized controller → refuse, and no BMC
//            endpoint is contacted for a wire that is not an admitted unit.
//   DISK     the dated admission withholds → refuse carrying its typed cause; a pin naming no single disk, or
//            a disk that is not the one this dispatch named → refuse.
//   CONTENTS the capture does not report "no partition table, no filesystem" → refuse; erasing content that
//            was never read is not this workflow's to do.
//   BINDING  the client's install file is not staged AND read back on the edge → refuse. NO REDFISH PATCH IS
//            PLANNED, because a client that boots into no binding gets a prompt, not an installer.
//   OS       an installed OS is POSITIVELY observed on the unit → refuse (an absent observation is not a
//            refusal: a unit being installed is precisely a unit that cannot answer SSH yet).
//   BOOT     only now is the boot-once planned, through 2b's core, and even then it is STAGED: the reset still
//            gates the power action on the OBSERVED read-back in its own boot_readback_verdict.
//
// WHY THE DISPATCH NAMES THE SERIAL. A network install is always for ONE named disk; there is no "install
// onto whatever is in the bay". The journal key needs the serial before the disk is admitted, and the honest
// way to satisfy that is to make the caller state which disk it means and then require the admitted reading
// to agree — so a stale row pointing at a replaced disk refuses with TargetDiskIsNotTheDispatchedOne rather
// than quietly installing onto the new disk under the old disk's authorization.

// WHETHER THE UNIT IS ALREADY BEING INSTALLED BY ANOTHER DISPATCH. Read from the durable exclusive hold
// (std.durable_exclusive_hold, the interlock the arrival door uses). Three readings, and only HoldFree — or a
// hold owned by THIS dispatch, which is what re-entry after a crash looks like — permits the run.
type NetworkInstallHoldReading
  = HoldFree
  | HoldHeldBy { owner: NonEmptyStr }
  | HoldUnreadable { detail: String }

// WHETHER THE CLIENT'S INSTALL BINDING IS BEING SERVED BY THE EDGE, and how that was established. A binding
// that was written but never read back is not a binding: the run cannot know the installer the client will
// fetch is the one it staged.
type NetworkInstallBindingEvidence
  = BindingStagedAndReadBack { client: NonEmptyStr, path: NonEmptyStr }
  | BindingAbsent { client: NonEmptyStr }
  | BindingWriteFailed { client: NonEmptyStr, reason: NonEmptyStr }
  | BindingReadBackMismatch { client: NonEmptyStr, path: NonEmptyStr, reason: NonEmptyStr }

// THE PATH THE EDGE HOLDS, if the read-back named one. "none" is the honest answer for a binding that never
// landed: the receipt must still print a field, and it must not print a path that does not exist.
fn network_install_binding_path(binding: NetworkInstallBindingEvidence) -> NonEmptyStr {
  match binding {
    BindingStagedAndReadBack { client: _, path: path } => path
    BindingReadBackMismatch { client: _, path: path, reason: _ } => path
    BindingAbsent { client: _ } => "none"
    BindingWriteFailed { client: _, reason: _ } => "none"
  }
}

// WHETHER THE UNIT IS ALREADY RUNNING AN INSTALLED OS, as a POSITIVE observation only. The three readings are
// deliberately not collapsed: "observed installed" is a fact that refuses, while "did not answer" is the
// normal state of a machine about to be installed and must not refuse, or no install could ever run.
type NetworkInstallOsObservation
  = InstalledOsObserved { host: HostIdentity, evidence: NonEmptyStr }
  | InstalledOsNotObserved
  | InstalledOsUnreadable { detail: String }

type NetworkInstallDispatchRefusalCause
  // JOURNAL. A completed install for this (unit, disk) exists; a second erase under the same authorization
  // needs a fresh dispatch with a fresh reading, not a repeat of this one.
  = InstallAlreadyCompleted { host: HostIdentity, serial: NonEmptyStr, completed_at: EpochMs }
  | JournalUnreadable { host: HostIdentity, serial: NonEmptyStr, detail: String }
  | JournalPayloadMalformed { host: HostIdentity, serial: NonEmptyStr, payload: String }
  // HOLD. Another dispatch owns the unit, or the store will not answer. Either way this run cannot prove it
  // has the unit to itself, and two dispatches booting one machine is the failure the hold exists to prevent.
  | HostHeldByAnotherDispatch { host: HostIdentity, owner: NonEmptyStr }
  | HostHoldUnreadable { host: HostIdentity, detail: String }
  // SUBJECT. Carries install_boot_subject's own typed cause verbatim — membership, binding, endpoint, or the
  // write controller's refusal — so the receipt says which of the four facts failed.
  | BootSubjectRefused { cause: InstallBootSubjectRefusalCause }
  // DISK. install_target_disk's own typed cause (NeverRead, NoDiskReported, IdentityUnusable,
  // TargetDiskSerialNotReported, ReadingFromTheFuture, ReadingStale{deadline}) carried, never flattened.
  | DiskAdmissionWithheld { cause: InstallTargetDiskWithheldCause }
  // A reading with no serial cannot name one disk to erase; this is the seed-selector refusal at the
  // authorization layer, and it is separate from the disk admission's own causes because it is about the
  // SHAPE of the pin rather than the freshness of the reading.
  | TargetNamesNoSingleDisk { host: HostIdentity }
  // The admitted disk is a different disk from the one this dispatch named.
  | TargetDiskIsNotTheDispatchedOne { host: HostIdentity, expected: NonEmptyStr, reported: NonEmptyStr }
  // The reading that authorized this erase names no artifact at all, so the contents evidence cannot be tied to
  // it. Unreachable behind an admitted disk today; the arm exists because tying the two readings together is
  // what makes the contents precondition mean anything.
  | TargetDiskReadingCarriesNoArtifact { host: HostIdentity }
  // CONTENTS. The carrying value is the refused TargetDiskContents itself, which already says what was seen
  // (a partition table, a filesystem) or what was missing (a reader, an artifact).
  | ContentsNotAdmitted { contents: TargetDiskContents }
  // BINDING. Nothing was staged for this client, or it was not verified — so no PATCH is planned.
  | EdgeBindingNotStaged { host: HostIdentity, client: NonEmptyStr, reason: String }
  // REQUEST. The unit has no install-client row, so no request can be derived and there is nothing to stage
  // at the edge. Distinct from a refused dispatch: this unit is not an install target at all.
  | InstallClientUnknown { host: HostIdentity }
  // CREDENTIAL. The run reached the boot with no credential path. Nothing at the controller was touched — this
  // is the arm that proves a missing secret spends no lockout budget — but the staged binding is still residue
  // and is withdrawn.
  | BootCredentialMissing { host: HostIdentity }
  // OS. A positive observation of an installed OS on a unit this run means to install: almost certainly the
  // wrong unit, or a unit whose completion was never journaled. Refuse and let a human look.
  | InstalledOsAlreadyObserved { host: HostIdentity, evidence: NonEmptyStr }

type NetworkInstallDispatch
  = NetworkInstallDispatchAdmitted {
      host: HostIdentity
      subject: InstallBootSubject
      disk: InstallTargetDisk
      serial: NonEmptyStr
      model: Optional<NonEmptyStr>
      decided_at: EpochMs
      binding: NetworkInstallBindingEvidence
    }
  | NetworkInstallDispatchRefused { cause: NetworkInstallDispatchRefusalCause }

// THE ADMISSION. Named arguments all the way down; every one of these is a fact some effect read, not a
// default this module could invent.
fn network_install_dispatch_admission(
  population: List<ArrivalConvergePopulationRow>,
  managed: List<HostIdentity>,
  host: HostIdentity,
  expected_serial: NonEmptyStr,
  dispatch_owner: NonEmptyStr,
  intended_controller: BmcControllerEndpoint,
  observed: BmcAccessObservationStanding,
  secured: BmcSecureStanding,
  board: BoardAuthorityRef?,
  route: BmcWriteRoute,
  capability_row: BmcFirmwareReleaseCapabilityRow,
  qualification: RunnerThroughputAssessment<HostIdentity>?,
  journal: NetworkInstallJournalReading,
  hold: NetworkInstallHoldReading,
  reading: TargetDiskReading,
  decided_at: EpochMs,
  window: Milliseconds,
  contents_report: DiskContentsReport,
  binding: NetworkInstallBindingEvidence,
  os_observation: NetworkInstallOsObservation
) -> NetworkInstallDispatch {
  match network_install_journal_and_hold_gate(
    journal: journal, hold: hold, host: host, expected_serial: expected_serial, dispatch_owner: dispatch_owner
  ) {
    Absent => network_install_admit_subject(
      population: population, managed: managed, host: host, expected_serial: expected_serial,
      intended_controller: intended_controller, observed: observed, secured: secured, board: board,
      route: route, capability_row: capability_row, qualification: qualification,
      reading: reading, decided_at: decided_at,
      window: window, contents_report: contents_report, binding: binding, os_observation: os_observation
    )
    Present { value: cause } => NetworkInstallDispatchRefused { cause: cause }
  }
}

// THE FIRST TWO GATES, SPEAKABLE ON THEIR OWN. The run must be able to ask "may I touch anything for this
// unit?" BEFORE it stages a binding at the edge, because staging is an effect and a unit that is already
// installed, or is being installed by another dispatch, must not have its client pinned to an installer even
// briefly. This is the ONE statement of those two gates: the dispatch admission above calls it, so the early
// question and the authoritative question cannot drift apart.
fn network_install_journal_and_hold_gate(
  journal: NetworkInstallJournalReading,
  hold: NetworkInstallHoldReading,
  host: HostIdentity,
  expected_serial: NonEmptyStr,
  dispatch_owner: NonEmptyStr
) -> Optional<NetworkInstallDispatchRefusalCause> {
  match journal {
    JournalSlotCompleted { completed_at: completed_at } =>
      Present { value: InstallAlreadyCompleted { host: host, serial: expected_serial, completed_at: completed_at } }
    JournalSlotUnreadable { detail: detail } =>
      Present { value: JournalUnreadable { host: host, serial: expected_serial, detail: detail } }
    JournalSlotMalformed { payload: payload } =>
      Present { value: JournalPayloadMalformed { host: host, serial: expected_serial, payload: payload } }
    JournalSlotAbsent => match hold {
      HoldHeldBy { owner: owner } =>
        if owner == dispatch_owner {
          Absent
        } else {
          Present { value: HostHeldByAnotherDispatch { host: host, owner: owner } }
        }
      HoldUnreadable { detail: detail } => Present { value: HostHoldUnreadable { host: host, detail: detail } }
      HoldFree => Absent
    }
  }
}

// STEP 2 ONWARD. Split out only because the journal and hold gates above must be able to refuse without
// evaluating anything about the BMC; the sequence after this point is the one written in the header.
fn network_install_admit_subject(
  population: List<ArrivalConvergePopulationRow>,
  managed: List<HostIdentity>,
  host: HostIdentity,
  expected_serial: NonEmptyStr,
  intended_controller: BmcControllerEndpoint,
  observed: BmcAccessObservationStanding,
  secured: BmcSecureStanding,
  board: BoardAuthorityRef?,
  route: BmcWriteRoute,
  capability_row: BmcFirmwareReleaseCapabilityRow,
  qualification: RunnerThroughputAssessment<HostIdentity>?,
  reading: TargetDiskReading,
  decided_at: EpochMs,
  window: Milliseconds,
  contents_report: DiskContentsReport,
  binding: NetworkInstallBindingEvidence,
  os_observation: NetworkInstallOsObservation
) -> NetworkInstallDispatch {
  // THE BINDING IS ASKED BEFORE THE BMC. It is a precondition of the boot, not an authorization to erase, and
  // it is the cheapest fact to read: a client the edge is not serving has nothing to boot into, so this run
  // refuses without evaluating one piece of BMC evidence. The erase authorization is still required before any
  // plan exists — moving this gate earlier cannot let an unauthorized disk through, because the plan below is
  // only ever built from an Admitted disk.
  match binding {
    BindingAbsent { client: client } => NetworkInstallDispatchRefused {
      cause: EdgeBindingNotStaged {
        host: host, client: client, reason: "the edge serves no install file for this client"
      }
    }
    BindingWriteFailed { client: client, reason: reason } =>
      NetworkInstallDispatchRefused { cause: EdgeBindingNotStaged { host: host, client: client, reason: reason } }
    BindingReadBackMismatch { client: client, path: _, reason: reason } => NetworkInstallDispatchRefused {
      cause: EdgeBindingNotStaged {
        host: host, client: client,
        reason: concat("the staged file did not read back as written: ", reason),
      }
    }
    BindingStagedAndReadBack { client: _, path: _ } => match admit_install_boot_subject(
      population: population, managed: managed, subject: host, intended_controller: intended_controller,
      observed: observed, secured: secured, board: board, route: route, capability_row: capability_row,
      qualification: qualification
    ) {
      InstallBootSubjectRefused { cause: cause } =>
        NetworkInstallDispatchRefused { cause: BootSubjectRefused { cause: cause } }
      InstallBootSubjectAdmitted { subject: subject } => match admit_install_target_disk(
        reading: reading, decided_at: decided_at, window: window
      ) {
        InstallTargetDiskWithheld { host: _, cause: cause } =>
          NetworkInstallDispatchRefused { cause: DiskAdmissionWithheld { cause: cause } }
        InstallTargetDiskAdmitted { target: disk } => network_install_check_pin(
          host: host, subject: subject, disk: disk, expected_serial: expected_serial, reading: reading,
          contents_report: contents_report, os_observation: os_observation, binding: binding,
          decided_at: decided_at
        )
      }
    }
  }
}

// THE FOUR FACTS ABOUT THE DISK, in the order they are read, each refusing with a cause that names only what
// it checked. THE PIN FIRST: what the disk was admitted WITH is what the seed will render, so "names no single
// disk" and "is not the disk this dispatch named" are both decided against the pin and nothing else — a seed
// that cannot name one disk never reaches a renderer, which is the last place a wipe can be stopped. THEN THE
// ARTIFACT: the contents report must be the one this same capture wrote, because a blank-disk claim borrowed
// from another file authorizes nothing. THEN THE CONTENTS. THEN THE OS, last because it is the only one of the
// four that can be wrong about a machine which is simply not answering yet.
fn network_install_check_pin(
  host: HostIdentity,
  subject: InstallBootSubject,
  disk: InstallTargetDisk,
  expected_serial: NonEmptyStr,
  reading: TargetDiskReading,
  contents_report: DiskContentsReport,
  os_observation: NetworkInstallOsObservation,
  binding: NetworkInstallBindingEvidence,
  decided_at: EpochMs
) -> NetworkInstallDispatch {
  let pin = install_target_disk_pin(disk: disk)
  let reported_serial = device_identification_token_text(token: autoinstall_disk_pin_serial(pin: pin))
  // A pin whose serial is empty could name no disk. 2a's admission refuses that case itself today
  // (TargetDiskSerialNotReported), and the branch stays because a rendering that names no disk must refuse
  // even if the admission upstream is ever widened.
  if (reported_serial as String) == "" {
    NetworkInstallDispatchRefused { cause: TargetNamesNoSingleDisk { host: host } }
  } else if (reported_serial as String) != (expected_serial as String) {
    NetworkInstallDispatchRefused {
      cause: TargetDiskIsNotTheDispatchedOne {
        host: host, expected: expected_serial, reported: reported_serial
      }
    }
  } else {
    match target_disk_reading_captured_in(reading: reading) {
      Absent => NetworkInstallDispatchRefused { cause: TargetDiskReadingCarriesNoArtifact { host: host } }
      Present { value: identity_artifact } => match admit_target_disk_contents(
        report: contents_report, identity_captured_in: identity_artifact
      ) {
        TargetDiskContentsRefused { contents: contents } =>
          NetworkInstallDispatchRefused { cause: ContentsNotAdmitted { contents: contents } }
        TargetDiskContentsAdmitted { contents: _ } =>
          // Only a POSITIVE observation of an installed OS can still refuse here. An unreadable observation
          // does not: a machine about to be installed is exactly one that cannot answer SSH.
          match os_observation {
            InstalledOsObserved { host: _, evidence: evidence } => NetworkInstallDispatchRefused {
              cause: InstalledOsAlreadyObserved { host: host, evidence: evidence },
            }
            InstalledOsNotObserved => network_install_admitted_dispatch(
              host: host, subject: subject, disk: disk, pin: pin, decided_at: decided_at, binding: binding
            )
            InstalledOsUnreadable { detail: _ } => network_install_admitted_dispatch(
              host: host, subject: subject, disk: disk, pin: pin, decided_at: decided_at, binding: binding
            )
          }
      }
    }
  }
}

// STEP 7: THE BOOT STEP. Nothing is PLANNED here and no controller answer is judged here. The binding gate
// above (BindingAbsent / BindingWriteFailed / BindingReadBackMismatch each refuse with a cause naming the
// client) is what proves the edge is serving this client's install file; the boot then goes through the ONE
// live route -- gunbc.machine_intake.oob_boot_handoff, reached through gunbc.host.install_boot_subject
// install_boot_drive_handoff -- whose own verdict on the boot-parameter-5 reading IT took is the SOLE gate on
// the power action. The device and mode are pinned inside that caller (pxe, once, EFI), so no caller of this
// module can name a device, and 2c adds no second judgment over those bytes.
fn network_install_admitted_dispatch(
  host: HostIdentity,
  subject: InstallBootSubject,
  disk: InstallTargetDisk,
  pin: AutoinstallDiskPin,
  decided_at: EpochMs,
  binding: NetworkInstallBindingEvidence
) -> NetworkInstallDispatch {
  NetworkInstallDispatchAdmitted {
    host: host,
    subject: subject,
    disk: disk,
    serial: device_identification_token_text(token: autoinstall_disk_pin_serial(pin: pin)) as String,
    model: network_install_pin_model_text(pin: pin),
    decided_at: decided_at,
    binding: binding,
  }
}

// THE MODEL'S DISK MODEL STRING, carried into the receipt as Optional text: the seed renders match{serial,
// model} when a model was reported, and the receipt must say which of the two the pin held. Absent is not an
// error -- it is a serial-only pin, which is exactly the lever for a disk whose reported model drifts.
fn network_install_pin_model_text(pin: AutoinstallDiskPin) -> Optional<NonEmptyStr> {
  match autoinstall_disk_pin_model(pin: pin) {
    Absent => Absent
    Present { value: model } => Present { value: device_identification_token_text(token: model) }
  }
}

// THE ROUTE'S WORD, RE-NAMED FOR THE INSTALL. The power action was already gated by the route's own verdict;
// this is not a second judgment over those bytes, it is the install decision that FOLLOWS: may this run go on
// to expect an installer on the target disk, and what does the receipt say. Every arm short of an issued
// control withholds the install -- the run then withdraws the edge binding and records a refused receipt, so a
// boot that never happened cannot leave a client pinned to a menu. The controller's own words travel with the
// withholding, because the thing an operator needs after a refusal is what the BMC actually answered.
type NetworkInstallBootVerdict
  = InstallBootProceeds { selected: NonEmptyStr }
  | InstallBootWithheld { reason: String, readback: String }

fn network_install_boot_verdict(outcome: OobBootHandoffOutcome) -> NetworkInstallBootVerdict {
  match outcome {
    BootControlIssued { selected: selected, power: _, admitted: _ } => InstallBootProceeds {
      selected: selected
    }
    BootSelectionRefused => InstallBootWithheld {
      reason: "the controller would not accept the boot-device write at all",
      readback: "no-readback",
    }
    BootSelectionNotApplied { requested: requested, readback: readback } => InstallBootWithheld {
      reason: concat("the override for ", requested as String, " did not take effect"),
      readback: readback,
    }
    BootSelectionUnverifiable { requested: requested, readback: readback } => InstallBootWithheld {
      reason: concat("the read-back for ", requested as String, " could not be decoded"),
      readback: readback,
    }
    BootSelectionFlagInvalid { requested: requested, readback: readback } => InstallBootWithheld {
      reason: concat("the boot flags reported for ", requested as String, " are not valid"),
      readback: readback,
    }
    BootSelectionNotOneShot { requested: requested, readback: readback } => InstallBootWithheld {
      reason: concat("the override reported for ", requested as String, " is not one-shot"),
      readback: readback,
    }
    BootSelectionFirmwareMismatch { requested: requested, readback: readback } => InstallBootWithheld {
      reason: concat("the firmware cannot apply ", requested as String),
      readback: readback,
    }
    PowerStateReadFailed { selected: selected, observed_state: _ } => InstallBootWithheld {
      reason: concat("the chassis state before ", selected as String, " could not be read"),
      readback: "no-readback",
    }
    PowerCommandRefused { selected: selected, action: _ } => InstallBootWithheld {
      reason: concat("the power action for ", selected as String, " was refused"),
      readback: "no-readback",
    }
    PowerCommandAcceptedNoTransition { selected: selected, action: _, progress: _, last_observed: _ } =>
      InstallBootWithheld {
        reason: concat("the chassis never showed the transition for ", selected as String),
        readback: "no-readback",
      }
    BootHandoffNotAdmitted { admission: _ } => InstallBootWithheld {
      reason: "the boot handoff was not admitted for this controller or release",
      readback: "no-readback",
    }
  }
}

// THE RECEIPT. What a run leaves behind, and the reason the run is auditable after the fact rather than
// reconstructed from the machine: the instant that authorized the erase, the disk that was authorized by
// identity, whether a model was part of the pin, whether the override was read back before the reset, and
// whether the binding was verified gone. `install_decided_at` is printed as decimal because the receipt is
// read by a human as well as a parser, and the instant is the one the clock gave at actuation.
type NetworkInstallRunReceipt {
  host: HostIdentity
  serial: NonEmptyStr
  model: Optional<NonEmptyStr>
  decided_at: EpochMs
  binding_path: NonEmptyStr
  // WHETHER THE ROUTE ISSUED THE CONTROL. Not "this module admitted a reset": the route that owns the power
  // action says whether it issued it, and this is what it said.
  boot_issued: Bool
  // WHAT THE CONTROLLER ANSWERED ITS OWN READ-BACK WITH, verbatim, or the literal "no-readback" when the run
  // stopped before a reading existed. A refusal that does not carry the controller's words is unauditable.
  boot_readback: String
  install_read_back: Bool
  install_evidence: String
  binding_withdrawn: Bool
  completion_recorded: Bool
  refused: Bool
  refusal: String
}

fn network_install_receipt_lines(receipt: NetworkInstallRunReceipt) -> List<String> {
  [
    concat("host=", receipt.host as String),
    concat("target_serial=", receipt.serial),
    match receipt.model {
      Absent => "target_model=<not reported: serial-only pin>"
      Present { value: model } => concat("target_model=", model as String)
    },
    concat("install_decided_at=", receipt.decided_at as String),
    concat("edge_binding_path=", receipt.binding_path),
    concat("boot_issued=", if receipt.boot_issued { "true" } else { "false" }),
    concat("boot_readback=", receipt.boot_readback),
    concat("install_read_back=", if receipt.install_read_back { "true" } else { "false" }),
    concat("install_evidence=", receipt.install_evidence),
    concat("edge_binding_withdrawn=", if receipt.binding_withdrawn { "true" } else { "false" }),
    concat("completion_recorded=", if receipt.completion_recorded { "true" } else { "false" }),
    concat("refused=", if receipt.refused { "true" } else { "false" }),
    concat("refusal=", receipt.refusal),
  ]
}

// A RECEIPT FOR A REFUSAL, so a withheld install still produces the artifact — the withheld cause is the
// interesting part of a run that booted nothing, and it is the difference between "the workflow refused" and
// "the workflow refused BECAUSE the reading went stale at read_at+window".
fn network_install_refused_receipt(host: HostIdentity, serial: NonEmptyStr, decided_at: EpochMs, refusal: String) -> NetworkInstallRunReceipt {
  NetworkInstallRunReceipt {
    host: host,
    serial: serial,
    model: Absent,
    decided_at: decided_at,
    binding_path: "none",
    boot_issued: false,
    boot_readback: "no-readback",
    install_read_back: false,
    install_evidence: "none",
    binding_withdrawn: false,
    completion_recorded: false,
    refused: true,
    refusal: refusal,
  }
}

// ─────────────────── THE REQUEST THIS RUN STAGES, DERIVED — NEVER DECLARED PER MACHINE ───────────────────
//
// THE BINDING THIS WORKFLOW STAGES IS NOT A ROW, IT IS A CONSEQUENCE. The 2026-11-11 ruling on this lane
// (msg_40c346af) took the install requests out of gunbc.fleet.site_pxe_edge_converge's standing list — a
// standing list re-renders what it serves, so a machine that had finished installing would have its installer
// file put back by the next converge and could be wiped by a later PXE boot, a repeat path no journal of mine
// can see. The alternative that ruling rejected was a named `srv15_network_install_request` datum, and the
// reason to reject it is the reason this file exists at all: a datum per machine is a datum that can be wrong,
// forgotten, or left behind after the machine is installed. So a request is BUILT here from the two facts that
// already have owners — the unit's install-client NIC and its dated target-disk row — and the next unit is one
// row in the table below plus its rows in those two tables, with no new named anything.
//
// THE TABLE IS A BINDING, NOT A REQUEST. It says which NIC a unit boots its installer from, which is a fact
// about the machine, and nothing about whether an install is allowed. A host missing here has no install
// client, and `network_install_request_for` answers Absent: the run refuses with EdgeBindingNotStaged, because
// there is nothing at the edge to stage.
type NetworkInstallClientRow {
  host: HostIdentity
  mac: NonEmptyStr
  architecture: Architecture
}

data network_install_client_bindings: List<NetworkInstallClientRow> = [
  // bobo, the first unit this workflow installs. Its MAC is the one its 2026-10-29 in-band recovery capture
  // reported for the NIC that is up — enp1s0, "link becomes ready" in that capture's journalctl -k — and the
  // architecture is the one its firmware boots: the capture's efibootmgr shows UEFI entries only, and the BMC's
  // Aptio BIOS has PXE Support enabled by hand over the serial console.
  NetworkInstallClientRow {
    host: operator_host_srv15,
    mac: srv15_host_nic_mac,
    architecture: Aarch64,
  },
]

// A host bound to TWO NICs is a host whose install client is not known, not a host whose installer gets to pick
// one: which NIC the DHCPDISCOVERY arrives on decides which file the edge serves, so an ambiguous binding is
// refused rather than resolved by list order.
fn network_install_client_for(host: HostIdentity) -> Optional<NetworkInstallClientRow> {
  match first_where(xs: network_install_client_bindings, keep: row => row.host == host) {
    Present { value: row } =>
      if count(filter(network_install_client_bindings, other => other.host == host)) == 1 {
        Present { value: row }
      } else {
        Absent
      }
    Absent => Absent
  }
}

// THE ONE REQUEST THIS RUN STAGES, or Absent when the unit cannot be staged at all: no client row, or a client
// row whose MAC does not parse, means there is nothing to bind. The disk reading is NOT filtered here — it is
// admitted once, by admit_install_target_disk, in the dispatch admission that also decides the boot. A request
// whose reading has gone stale is still a well-formed request; what withholds it is the admission, and the
// refusal has to come from there with its own typed cause rather than from a quiet Absent here.
fn network_install_request_for(host: HostIdentity) -> Optional<SitePxeEdgeInstallRequest> {
  match network_install_client_for(host: host) {
    Absent => Absent
    Present { value: row } =>
      let client = parse_mac_address(text: row.mac as String)
      match client {
        MacParsed { address: _ } => Present {
          value: SitePxeEdgeInstallRequest {
            client: client,
            target_disk: target_disk_reading_for(host: host),
            disk_admission_window: site_pxe_edge_disk_identity_admission_window,
            architecture: row.architecture,
          }
        }
        MacParseFailed { error: _ } => Absent
      }
  }
}

// WHAT THE WITHDRAWAL PUSHES AT THE EDGE: nothing. The standing SitePxeEdgeConverge mode serves no install
// binding, and this run's withdraw step converges with this same empty list, which is the only route to the
// removal path d5d8218a2ca added. Stating it once, here, is what keeps a second caller from "helpfully" passing
// a standing list and re-creating the file behind the run's back.
data network_install_no_requests: List<SitePxeEdgeInstallRequest> = []

// THE REQUEST LIST A CONVERGE RUN PUSHES AT THE EDGE, in the shape run_site_pxe_edge takes: the unit's one
// request when it has one, and nothing when it does not. There is no second route to this list, in this module
// or anywhere else — which is what makes the stage/withdraw pair in the wet entry honest, since both halves
// address exactly the files this function can name.
fn network_install_requests_for(host: HostIdentity) -> List<SitePxeEdgeInstallRequest> {
  match network_install_request_for(host: host) {
    Present { value: request } => [request]
    Absent => []
  }
}

// ───────────────────────────── THE ONE-SHOT RUN ─────────────────────────────
//
// THE SEQUENCE, IN CODE, ONCE. The plan item's whole safety case is an ORDER of effects, so the order lives in
// one function rather than in a workflow YAML someone can reorder:
//
//   1. read the journal and the hold. If either refuses, STOP — nothing at the edge, no controller write. This
//      is the same gate the dispatch admission applies (network_install_journal_and_hold_gate), asked early
//      precisely because a unit that is already installed, or is mid-install by another dispatch, must not have
//      its client pinned to an installer even briefly.
//   2. take the durable exclusive hold for this dispatch, and re-apply the gate on what the take answered: a
//      hold that cannot be read refuses (HostHoldUnreadable), and a hold owned by someone else refuses.
//   3. derive the request from the admitted client binding and read the disk (the caller reads the row and the
//      contents capture; both are observations, never literals).
//   4. stage the binding at the edge and READ IT BACK — the port returns the evidence the run saw at the edge,
//      not what it hoped to write.
//   5. the dispatch admission, which re-checks journal and hold, admits the subject, admits the disk
//      (admit_install_target_disk, dated at the instant this run's clock answered), admits the contents,
//      refuses a pin that names no single disk or a different disk, refuses a positive observation of an
//      installed OS, and only then admits the boot step on a proven binding.
//   6. the boot, through the ONE live route (install_boot_drive_handoff). Its own verdict on its own
//      boot-parameter-5 reading gates the power action; this run only maps the outcome arms.
//   7. on any withheld boot: withdraw the binding and record a refused receipt. Nothing is journaled, so the
//      unit stays retryable.
//   8. read the install back. Not read back → withdraw, withheld receipt, nothing journaled.
//   9. withdraw the binding and VERIFY it is gone — before completion, never after.
//  10. admit the completion (which itself refuses unless the install was read back AND the withdrawal verified)
//      and record it through the durable store's compare-and-set. A concurrent dispatcher that recorded first
//      wins the CAS and this run reports the install as unjournaled rather than rewriting a completion.
//  11. the receipt, always — including the refusal that stopped at step 1, carrying the controller's words if
//      the run ever reached a controller.
//
// THE PORTS ARE THE EFFECTS, AND THEY ARE ALL REQUIRED. A run cannot be assembled without saying how each
// effect happens, which is what keeps this function evaluable in a witness: the witness supplies ports whose
// answers are the committed readings, and the ORDER below is what the claims then pin.
type NetworkInstallJournalQuery {
  host: HostIdentity
  serial: NonEmptyStr
}

type NetworkInstallHoldRequest {
  host: HostIdentity
  owner: NonEmptyStr
}

type NetworkInstallInstallQuery {
  host: HostIdentity
  serial: NonEmptyStr
  decided_at: EpochMs
  // THE ATTEMPT THE READINGS ARE FOLDED AGAINST: the pinned chain and the staged binding, so a reading that
  // describes some other machine's install cannot answer for this one.
  subject: NetworkInstallSubject
}

type NetworkInstallRunPorts {
  // THE COMPLETION JOURNAL, as the durable compare-and-set store under the host-state root on srv4 answers it.
  read_journal: fn(NetworkInstallJournalQuery) -> NetworkInstallJournalReading
  // THE DURABLE EXCLUSIVE HOLD, read and taken through std.durable_exclusive_hold's realization.
  read_hold: fn(HostIdentity) -> NetworkInstallHoldReading
  acquire_hold: fn(NetworkInstallHoldRequest) -> NetworkInstallHoldReading
  // THE EDGE. stage takes the ONE request this run derived and reads the edge back; withdraw takes the empty
  // request list (standing converge serves no install binding, so withdrawal is what a converge with nothing
  // to render produces) and the run verifies the file is gone.
  stage_binding: fn(SitePxeEdgeInstallRequest) -> NetworkInstallBindingEvidence
  withdraw_binding: fn(HostIdentity) -> Bool
  // THE READINGS THE COMPLETION FOLD IS FOLDED FROM: what the edge logged this attempt fetched, and what the
  // unit answers about the disk it now boots. The fold below is what decides; this port only reports.
  observe_install: fn(NetworkInstallInstallQuery) -> NetworkInstallReadings
  // THE COMPLETION, through the store's compare-and-set against the Absent this run read.
  commit_completion: fn(NetworkInstallCompletion) -> Bool
}

type NetworkInstallRunOutcome
  // A gate refused before the unit was touched. Nothing at the edge, no controller write, nothing journaled.
  = NetworkInstallRunRefused { receipt: NetworkInstallRunReceipt }
  // The unit was reached and something short of a verified install happened: the binding is withdrawn and the
  // receipt says what the controller answered. Retryable — the journal is still Absent.
  | NetworkInstallRunWithheld { receipt: NetworkInstallRunReceipt }
  // Install read back, binding verified gone, completion recorded.
  | NetworkInstallRunCompleted { receipt: NetworkInstallRunReceipt }

fn network_install_run_completed(outcome: NetworkInstallRunOutcome) -> Bool {
  match outcome {
    NetworkInstallRunCompleted { receipt: _ } => true
    NetworkInstallRunWithheld { receipt: _ } => false
    NetworkInstallRunRefused { receipt: _ } => false
  }
}

fn network_install_run_receipt(outcome: NetworkInstallRunOutcome) -> NetworkInstallRunReceipt {
  match outcome {
    NetworkInstallRunCompleted { receipt: receipt } => receipt
    NetworkInstallRunWithheld { receipt: receipt } => receipt
    NetworkInstallRunRefused { receipt: receipt } => receipt
  }
}

fn network_install_run(
  ports: NetworkInstallRunPorts,
  host: HostIdentity,
  install_subject: NetworkInstallSubject,
  expected_serial: NonEmptyStr,
  dispatch_owner: NonEmptyStr,
  password_file_raw: String,
  request: SitePxeEdgeInstallRequest?,
  population: List<ArrivalConvergePopulationRow>,
  managed: List<HostIdentity>,
  intended_controller: BmcControllerEndpoint,
  observed: BmcAccessObservationStanding,
  secured: BmcSecureStanding,
  board: BoardAuthorityRef?,
  route: BmcWriteRoute,
  capability_row: BmcFirmwareReleaseCapabilityRow,
  qualification: RunnerThroughputAssessment<HostIdentity>?,
  reading: TargetDiskReading,
  decided_at: EpochMs,
  window: Milliseconds,
  contents_report: DiskContentsReport,
  os_observation: NetworkInstallOsObservation
) -> NetworkInstallRunOutcome {
  let journal = ports.read_journal(query: NetworkInstallJournalQuery { host: host, serial: expected_serial })
  let hold = ports.read_hold(host: host)
  match network_install_journal_and_hold_gate(
    journal: journal, hold: hold, host: host, expected_serial: expected_serial, dispatch_owner: dispatch_owner
  ) {
    Present { value: cause } => NetworkInstallRunRefused {
      receipt: network_install_cause_refused_receipt(
        host: host, serial: expected_serial, decided_at: decided_at, cause: cause
      ),
    }
    Absent => match ports.acquire_hold(request: NetworkInstallHoldRequest { host: host, owner: dispatch_owner }) {
      // The take is what matters, not the earlier read: two dispatches can both read an empty journal, and only
      // one of them can hold the unit.
      HoldHeldBy { owner: owner } =>
        if owner == dispatch_owner {
          network_install_run_staged(
            ports: ports, host: host, install_subject: install_subject, expected_serial: expected_serial, dispatch_owner: dispatch_owner,
            password_file_raw: password_file_raw, request: request, population: population, managed: managed,
            intended_controller: intended_controller, observed: observed, secured: secured, board: board,
            route: route, capability_row: capability_row, qualification: qualification, reading: reading,
            decided_at: decided_at, window: window, contents_report: contents_report,
            os_observation: os_observation, journal: journal
          )
        } else {
          NetworkInstallRunRefused {
            receipt: network_install_cause_refused_receipt(
              host: host, serial: expected_serial, decided_at: decided_at,
              cause: HostHeldByAnotherDispatch { host: host, owner: owner }
            ),
          }
        }
      HoldUnreadable { detail: detail } => NetworkInstallRunRefused {
        receipt: network_install_cause_refused_receipt(
          host: host, serial: expected_serial, decided_at: decided_at,
          cause: HostHoldUnreadable { host: host, detail: detail }
        ),
      }
      HoldFree => network_install_run_staged(
        ports: ports, host: host, install_subject: install_subject, expected_serial: expected_serial, dispatch_owner: dispatch_owner,
        password_file_raw: password_file_raw, request: request, population: population, managed: managed,
        intended_controller: intended_controller, observed: observed, secured: secured, board: board,
        route: route, capability_row: capability_row, qualification: qualification, reading: reading,
        decided_at: decided_at, window: window, contents_report: contents_report,
        os_observation: os_observation, journal: journal
      )
    }
  }
}

// STEPS 3-11, reached only with the unit held by this dispatch. A unit with no derived request (no install
// client row, or no disk row) never reaches the edge at all: there is no binding to stage.
fn network_install_run_staged(
  ports: NetworkInstallRunPorts,
  host: HostIdentity,
  install_subject: NetworkInstallSubject,
  expected_serial: NonEmptyStr,
  dispatch_owner: NonEmptyStr,
  password_file_raw: String,
  request: SitePxeEdgeInstallRequest?,
  population: List<ArrivalConvergePopulationRow>,
  managed: List<HostIdentity>,
  intended_controller: BmcControllerEndpoint,
  observed: BmcAccessObservationStanding,
  secured: BmcSecureStanding,
  board: BoardAuthorityRef?,
  route: BmcWriteRoute,
  capability_row: BmcFirmwareReleaseCapabilityRow,
  qualification: RunnerThroughputAssessment<HostIdentity>?,
  reading: TargetDiskReading,
  decided_at: EpochMs,
  window: Milliseconds,
  contents_report: DiskContentsReport,
  os_observation: NetworkInstallOsObservation,
  journal: NetworkInstallJournalReading
) -> NetworkInstallRunOutcome {
  match request {
    Absent => NetworkInstallRunRefused {
      receipt: network_install_cause_refused_receipt(
        host: host, serial: expected_serial, decided_at: decided_at,
        cause: InstallClientUnknown { host: host }
      ),
    }
    Present { value: one_request } =>
      network_install_after_binding(
        subject: install_subject,
        dispatch: network_install_dispatch_admission(
          population: population, managed: managed, host: host, expected_serial: expected_serial,
          dispatch_owner: dispatch_owner, intended_controller: intended_controller, observed: observed,
          secured: secured, board: board, route: route, capability_row: capability_row,
          qualification: qualification, journal: journal,
          hold: HoldHeldBy { owner: dispatch_owner },
          reading: reading, decided_at: decided_at, window: window, contents_report: contents_report,
          binding: ports.stage_binding(request: one_request), os_observation: os_observation
        ),
        ports: ports,
        host: host,
        serial: expected_serial,
        password_file_raw: password_file_raw,
        decided_at: decided_at,
      )
  }
}

// THE BOOT AND WHAT FOLLOWS IT. The withheld arms all converge on the same two duties: withdraw the binding,
// and write a receipt that says so — including when the credential was missing, which is the case where no
// controller was touched at all and the binding is the only residue.
fn network_install_after_binding(
  dispatch: NetworkInstallDispatch,
  ports: NetworkInstallRunPorts,
  subject: NetworkInstallSubject,
  host: HostIdentity,
  serial: NonEmptyStr,
  password_file_raw: String,
  decided_at: EpochMs
) -> NetworkInstallRunOutcome {
  match dispatch {
    NetworkInstallDispatchRefused { cause: cause } => match cause {
      _ => NetworkInstallRunWithheld {
        receipt: network_install_withdrawn_refusal(
          ports: ports, host: host, serial: serial, decided_at: decided_at, cause: cause
        ),
      }
    }
    NetworkInstallDispatchAdmitted {
      host: host,
      subject: subject,
      disk: disk,
      serial: serial,
      model: model,
      decided_at: admitted_at,
      binding: binding,
    } => match install_boot_drive_handoff(subject: subject, password_file_raw: password_file_raw) {
      InstallBootHandoffCredentialMissing { subject: _ } => NetworkInstallRunWithheld {
        receipt: network_install_withdrawn_refusal(
          ports: ports, host: host, serial: serial, decided_at: admitted_at,
          cause: BootCredentialMissing { host: host }
        ),
      }
      InstallBootHandoffDriven { subject: _, outcome: outcome } =>
        match network_install_boot_verdict(outcome: outcome) {
          InstallBootWithheld { reason: reason, readback: readback } => NetworkInstallRunWithheld {
            receipt: network_install_withdrawn_boot_receipt(
              ports: ports, host: host, serial: serial, model: model, decided_at: admitted_at,
              binding: binding, readback: readback, reason: reason
            ),
          }
          InstallBootProceeds { selected: selected } => network_install_after_boot(
            ports: ports, host: host, subject: subject, serial: serial, model: model, decided_at: admitted_at,
            binding: binding, selected: selected
          )
        }
    }
  }
}

// THE INSTALL, THE WITHDRAWAL, THE JOURNAL — IN THAT ORDER. Completion is admitted only after the install was
// read back AND the withdrawal was verified, and it is recorded through the compare-and-set; anything less
// leaves the journal Absent so the next dispatch can try again.
fn network_install_after_boot(
  ports: NetworkInstallRunPorts,
  host: HostIdentity,
  subject: NetworkInstallSubject,
  serial: NonEmptyStr,
  model: Optional<NonEmptyStr>,
  decided_at: EpochMs,
  binding: NetworkInstallBindingEvidence,
  selected: NonEmptyStr
) -> NetworkInstallRunOutcome {
  let binding_path = network_install_binding_path(binding: binding)
  // THE COMPLETION FOLD IS NOT MINE TO INVENT. Whether this attempt installed anything is answered by
  // gunbc.provisioning.network_install_receipt, which folds the readings against the pinned chain and the staged
  // binding and mints a receipt ONLY when no typed gap remains: a client class matching the chain's architecture,
  // every member of it delivered, the seed served, the installed root's MACs carrying the client, the root chain
  // on a whole disk at the target serial, and an installer record completed inside the attempt's window. Nothing
  // here re-decides any of that; completion is admitted on InstalledToDisk and on nothing else.
  let fold = network_install_receipt(
    subject: subject,
    readings: ports.observe_install(query: NetworkInstallInstallQuery {
      host: host,
      serial: serial,
      decided_at: decided_at,
      subject: subject,
    }),
  )
  let established = network_install_fold_established(fold: fold)
  let evidence = network_install_fold_evidence(fold: fold)
  let withdrawn = ports.withdraw_binding(host: host)
  match admit_network_install_completion(
    host: host,
    serial: serial,
    completed_at: decided_at,
    install_receipt: selected,
    install_read_back: established,
    binding_withdrawn_verified: withdrawn,
    binding_path: binding_path
  ) {
    NetworkInstallCompletionRefusedInstallUnread { host: _ } => NetworkInstallRunWithheld {
      receipt: NetworkInstallRunReceipt {
        host: host,
        serial: serial,
        model: model,
        decided_at: decided_at,
        binding_path: binding_path,
        boot_issued: true,
        boot_readback: selected,
        install_read_back: false,
        install_evidence: evidence,
        binding_withdrawn: withdrawn,
        completion_recorded: false,
        refused: false,
        refusal: "",
      },
    }
    NetworkInstallCompletionRefusedBindingNotWithdrawn { host: _, path: path } => NetworkInstallRunWithheld {
      receipt: NetworkInstallRunReceipt {
        host: host,
        serial: serial,
        model: model,
        decided_at: decided_at,
        binding_path: path,
        boot_issued: true,
        boot_readback: selected,
        install_read_back: true,
        install_evidence: evidence,
        binding_withdrawn: false,
        completion_recorded: false,
        refused: false,
        refusal: "the edge still serves the install file; nothing was journaled",
      },
    }
    NetworkInstallCompletionAdmitted { completion: completion } =>
      match ports.commit_completion(completion: completion) {
        true => NetworkInstallRunCompleted {
          receipt: NetworkInstallRunReceipt {
            host: host,
            serial: serial,
            model: model,
            decided_at: decided_at,
            binding_path: binding_path,
            boot_issued: true,
            boot_readback: selected,
            install_read_back: true,
            install_evidence: evidence,
            binding_withdrawn: true,
            completion_recorded: true,
            refused: false,
            refusal: "",
          },
        }
        // The CAS was lost: someone else recorded a completion for this (unit, serial) while this run booted
        // it. That is reported, never overwritten, and the run is not a completion.
        false => NetworkInstallRunWithheld {
          receipt: NetworkInstallRunReceipt {
            host: host,
            serial: serial,
            model: model,
            decided_at: decided_at,
            binding_path: binding_path,
            boot_issued: true,
            boot_readback: selected,
            install_read_back: true,
            install_evidence: evidence,
            binding_withdrawn: true,
            completion_recorded: false,
            refused: false,
            refusal: "another dispatch recorded the completion first; this run journaled nothing",
          },
        }
      }
  }
}

fn network_install_withdrawn_refusal(
  ports: NetworkInstallRunPorts,
  host: HostIdentity,
  serial: NonEmptyStr,
  decided_at: EpochMs,
  cause: NetworkInstallDispatchRefusalCause
) -> NetworkInstallRunReceipt {
  let receipt = network_install_cause_refused_receipt(host: host, serial: serial, decided_at: decided_at, cause: cause)
  NetworkInstallRunReceipt {
    host: receipt.host,
    serial: receipt.serial,
    model: receipt.model,
    decided_at: receipt.decided_at,
    binding_path: receipt.binding_path,
    boot_issued: false,
    boot_readback: "no-readback",
    install_read_back: false,
    install_evidence: "none",
    binding_withdrawn: ports.withdraw_binding(host: host),
    completion_recorded: false,
    refused: true,
    refusal: receipt.refusal,
  }
}

fn network_install_withdrawn_boot_receipt(
  ports: NetworkInstallRunPorts,
  host: HostIdentity,
  serial: NonEmptyStr,
  model: Optional<NonEmptyStr>,
  decided_at: EpochMs,
  binding: NetworkInstallBindingEvidence,
  readback: String,
  reason: String
) -> NetworkInstallRunReceipt {
  NetworkInstallRunReceipt {
    host: host,
    serial: serial,
    model: model,
    decided_at: decided_at,
    binding_path: network_install_binding_path(binding: binding),
    boot_issued: false,
    boot_readback: readback,
    install_read_back: false,
    install_evidence: "none",
    binding_withdrawn: ports.withdraw_binding(host: host),
    completion_recorded: false,
    refused: true,
    refusal: reason,
  }
}

// ───────────────────────────── WHY NOTHING BOOTED, IN ONE LINE ─────────────────────────────
//
// The receipt carries a refusal string, and a refusal string that says "refused" is worth nothing at 3am. Every
// arm names the fact that failed. TOTAL over the cause sum, so a new cause is a compile error here rather than a
// receipt that prints an empty field.
fn network_install_refusal_text(cause: NetworkInstallDispatchRefusalCause) -> String {
  match cause {
    InstallAlreadyCompleted { host: host, serial: serial, completed_at: completed_at } =>
      concat("a completed install for ", host as String, " disk ", serial, " was already recorded at ", completed_at as String)
    JournalUnreadable { host: host, serial: serial, detail: detail } =>
      concat("the completion journal for ", host as String, " disk ", serial, " would not answer (", detail, ")")
    JournalPayloadMalformed { host: host, serial: serial, payload: payload } =>
      concat("the completion journal for ", host as String, " disk ", serial, " answered with a payload that is not an instant (", payload, ")")
    HostHeldByAnotherDispatch { host: host, owner: owner } =>
      concat("another dispatch holds ", host as String, " (owner ", owner, ")")
    HostHoldUnreadable { host: host, detail: detail } =>
      concat("the exclusive hold on ", host as String, " would not answer (", detail, ")")
    BootSubjectRefused { cause: cause } => network_install_boot_subject_cause_text(cause: cause)
    DiskAdmissionWithheld { cause: cause } => network_install_disk_cause_text(cause: cause)
    TargetNamesNoSingleDisk { host: host } =>
      concat("the admitted reading cannot name one disk to erase for ", host as String)
    TargetDiskIsNotTheDispatchedOne { host: host, expected: expected, reported: reported } =>
      concat("the disk this run named (", expected, ") is not the disk the reading reported (", reported, ")")
    TargetDiskReadingCarriesNoArtifact { host: host } =>
      concat("the reading that would authorize an erase for ", host as String, " names no artifact")
    ContentsNotAdmitted { contents: contents } => network_install_contents_cause_text(contents: contents)
    EdgeBindingNotStaged { host: host, client: client, reason: reason } =>
      concat("no install binding is served for client ", client, " of ", host as String, " (", reason, ")")
    InstallClientUnknown { host: host } =>
      concat("no install client row for ", host as String, "; nothing was staged at the edge")
    BootCredentialMissing { host: host } =>
      concat("no credential path for ", host as String, "; the controller was not contacted")
    InstalledOsAlreadyObserved { host: host, evidence: evidence } =>
      concat("an installed OS was observed on ", host as String, " (", evidence, ")")
  }
}

// THE SUBJECT'S OWN REFUSALS, RENDERED. Which of the four facts failed -- membership, the bound and secured
// route, the route naming a controller at all, or the write controller -- is the difference between "this unit
// is not an install target" and "go bind its controller".
fn network_install_boot_subject_cause_text(cause: InstallBootSubjectRefusalCause) -> String {
  match cause {
    ArrivalNotAdmitted { subject: subject, cause: _ } =>
      concat("the unit is not an admitted arrival subject for this door (", subject as String, ")")
    ControllerNotBound { subject: subject, standing: _ } =>
      concat("the controller is not a bound, secured control route (", subject as String, ")")
    ControllerHasNoAccount { subject: subject } =>
      concat("the bound route names no managed account to drive it with (", subject as String, ")")
    ControllerIsNotTheBoundOne { subject: subject, wanted: wanted, bound: bound } =>
      concat("the run named controller ", wanted.host as String, " but the unit is bound to ", bound.host as String)
    WriteControllerRefused { subject: subject, cause: _ } =>
      concat("the unit's committed write controller refuses a boot-device write (", subject as String, ")")
  }
}

// THE DISK'S OWN REFUSALS, RENDERED, including the one the fleet sees most: a reading that reported a model and
// no serial, which names a family of disks and so names none.
fn network_install_disk_cause_text(cause: InstallTargetDiskWithheldCause) -> String {
  match cause {
    TargetDiskNeverRead { host: host, why: why } =>
      concat("the target disk was never read (", host as String, ": ", why, ")")
    NoTargetDiskReported { host: host, source: _, captured_in: captured_in, report: report } =>
      concat("the reading reported no target disk (", host as String, " from ", captured_in, ": ", report, ")")
    TargetDiskIdentityUnusable { host: host, source: _, cause: _ } =>
      concat("the reported identity cannot be used as a match token (", host as String, ")")
    TargetDiskSerialNotReported { host: host, source: _, reported: _ } =>
      concat("the reading reported a model with no serial, which names no single disk (", host as String, ")")
    TargetDiskReadingFromTheFuture { host: host, read_at: read_at, decided_at: decided_at } =>
      concat("the reading is dated after the instant it was decided (", host as String, " read_at ", read_at as String, " > ", decided_at as String, ")")
    TargetDiskReadingStale { host: host, read_at: read_at, decided_at: decided_at, deadline: deadline } =>
      concat("the reading went stale before it was decided (", host as String, " read_at ", read_at as String, " deadline ", deadline as String, " decided ", decided_at as String, ")")
  }
}

// THE CONTENTS' OWN REFUSALS, RENDERED. "A reader was missing" and "the blank came from another artifact" are
// different operators' problems, and neither is "the disk has data on it".
fn network_install_contents_cause_text(contents: TargetDiskContents) -> String {
  match contents {
    NoPartitionTableOrFilesystemReported { captured_in: captured_in, read_at: _, readers: _ } =>
      concat("the target disk reported no partition table and no filesystem (", captured_in, ")")
    PartitionTableOrFilesystemReported { captured_in: captured_in, read_at: _, readers: _ } =>
      concat("the target disk carries a partition table or a filesystem (", captured_in, "); erasing it is a prior-life effect this workflow does not perform")
    ContentsNotRead { reason: reason } =>
      concat("the target disk's contents were never read (", reason, ")")
    ContentsEvidenceFromAnotherArtifact { reported: reported, identity: identity } =>
      concat("the blank disk was read from ", reported, " but the serial and model came from ", identity)
  }
}

// THE CAUSE IS THE TEXT. A dispatch that never reached the edge still gets a receipt, and that receipt carries the
// typed cause exactly as this module renders it — one renderer, so the same refusal never reads two ways.
fn network_install_cause_refused_receipt(
  host: HostIdentity,
  serial: NonEmptyStr,
  decided_at: EpochMs,
  cause: NetworkInstallDispatchRefusalCause
) -> NetworkInstallRunReceipt {
  network_install_refused_receipt(
    host: host,
    serial: serial,
    decided_at: decided_at,
    refusal: network_install_refusal_text(cause: cause),
  )
}

// THE COMPLETION FOLD'S TWO PROJECTIONS. Whether this attempt installed anything is not this module's call — it is
// what gunbc.provisioning.network_install_receipt says — so the run projects that fold into a boolean for the
// journal and a sentence for the receipt, and never re-decides it.
fn network_install_fold_established(fold: NetworkInstallReceipt) -> Bool {
  match fold {
    InstalledToDisk {
      subject: _,
      client_class: _,
      root_chain: _,
      root_disk_serial: _,
      root_created_at: _,
      installer_record_at: _,
      secure_boot: _,
      trust: _,
      observed_at: _,
    } => true
    InstallNotEstablished { subject: _, gaps: gaps } => false
  }
}

fn network_install_fold_evidence(fold: NetworkInstallReceipt) -> String {
  match fold {
    InstalledToDisk {
      subject: _,
      client_class: _,
      root_chain: _,
      root_disk_serial: disk,
      root_created_at: created,
      installer_record_at: record,
      secure_boot: _,
      trust: _,
      observed_at: _,
    } => match disk {
      Present { value: value } => concat("installed-to-disk root-disk-serial=", value)
      Absent => concat("installed-to-disk root-created-at=", created as String)
    }
    InstallNotEstablished { subject: _, gaps: gaps } =>
      concat("install-not-established gaps=", length(xs: gaps) as String)
  }
}
