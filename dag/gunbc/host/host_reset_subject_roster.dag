module gunbc.host_reset_subject_roster

import std.types { Bool, List, NonEmptyStr, String }
import extdeps.bmc.access_profile { BmcAccessObserved, BmcAccessUnobserved }
import gunbc.machine_intake_oob_boot_handoff {
  OobBootHandoffAdmission,
  oob_boot_handoff_admission,
  oob_handoff_is_admitted,
}
import gunbc.managed_host { ManagedHost, managed_hosts }
import gunbc.machine_intake_bmc_secure { bmc_secured_account }
import gunbc.fleet_runner_connectivity { fleet_hosts }

// WHICH HOSTS THIS FLEET MAY DRIVE BACK TO A KNOWN STATE THROUGH THEIR CONTROLLERS, and it is a
// DERIVED SUBSET of gunbc.managed_host managed_hosts() rather than a list anyone maintains.
//
// "MAY HAVE ITS POWER DRIVEN OUT OF BAND" IS NOT "IS AN EXECUTOR FLEET HOST", and conflating the two
// is the §3 meaning fork this module exists to avoid. gunbc.fleet_runner_connectivity fleet_hosts()
// means "commits runner slots" -- its consumers fold it as an eligible host set and to gather
// committed slot identities -- so a host reachable only through its BMC does not belong in it, and a
// host with runner slots is not thereby drivable out of band. Two predicates, two rosters, one
// naming authority underneath both: every identity here comes from gunbc.fleet_intent_network.
//
// MEMBERSHIP IS AN IDENTITY JOIN AGAINST THE ADMISSION THE ACTUATION ARM ALREADY PERFORMS. A managed
// host is a reset subject exactly when its controller access is observed, its secure standing is
// BmcSecured, and oob_boot_handoff_admission -- the same fold gunbc.machine_intake_oob_boot_handoff
// runs before it writes anything to a controller -- admits the observation against its capability row. So the roster cannot drift from the capability it claims to describe,
// and a host whose standings are unobserved is a non-member rather than a member with defaults.
//
// THE FOLD RUNS OVER EVERY MANAGED HOST, ADMITTED OR NOT, so the filter has something to refuse: a
// roster assembled from already-admitted hosts would make its own filter unreachable.
//
// THE ADMISSION OF ONE MANAGED HOST, Absent when its controller access is unobserved or its secure
// standing names no account to drive it as.
fn reset_subject_admission(host: ManagedHost) -> OobBootHandoffAdmission? {
  match bmc_secured_account(standing: host.secure) {
    Absent => none
    Present { value: _ } =>
      match host.access {
        BmcAccessUnobserved { endpoint: _ } => none
        BmcAccessObserved { observation: o } =>
          Present { value: oob_boot_handoff_admission(observation: o, capability_row: host.capability_row) }
      }
  }
}

fn reset_subject_is_admitted(host: ManagedHost) -> Bool {
  match reset_subject_admission(host: host) {
    Absent => false
    Present { value: a } => oob_handoff_is_admitted(admission: a)
  }
}

// THE FILTER IS A PREDICATE, NOT A FAILURE ARM, AND THE DIFFERENCE MATTERS HERE. Dropping a
// candidate whose controller does not admit power control is not an absorbing fallback swallowing a
// diagnostic -- it is the membership condition doing its job, and the dropped host is not a loss but
// a non-member. The refusal that DOES have to be loud is one level up, in
// gunbc.host_reset_return reset_dispatch_options, where an unmintable observer pairing refuses the
// whole option list rather than quietly shrinking it.
fn reset_subject_roster() -> List<NonEmptyStr> {
  fold(
    managed_hosts(),
    init: [],
    f: (acc, c) =>
      if reset_subject_is_admitted(host: c) {
        concat(acc, [c.host as NonEmptyStr])
      } else {
        acc
      },
  )
}

// THE PEERS THAT MAY OBSERVE A RESET are the executor fleet hosts, and this is the one place the two
// rosters legitimately meet: an observer needs a runner to run on, which is exactly what fleet_hosts()
// means. Derived from that authority rather than spelled, so enrolling or retiring an executor host
// moves the observer set with it.
fn reset_observer_peer_roster() -> List<NonEmptyStr> {
  map(fleet_hosts(), h => h as NonEmptyStr)
}

// THE MANAGED HOST FOR ONE SUBJECT LABEL, so a caller that resolved a subject can reach its standings
// without re-walking the roster in its own vocabulary. Absent means the label names no managed host,
// which a caller must treat as a refusal and never as a host it may drive with defaults.
fn reset_subject_for(host: NonEmptyStr) -> ManagedHost? {
  fold(
    managed_hosts(),
    init: none,
    f: (acc, c) => match acc {
      Present { value: _ } => acc
      Absent => if (c.host as String) == (host as String) { Present { value: c } } else { acc }
    },
  )
}
