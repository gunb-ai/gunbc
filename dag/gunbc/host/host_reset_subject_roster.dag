module gunbc.host_reset_subject_roster

import std.types { Bool, List, NonEmptyStr, String }
import product.placement_supply { HostIdentity }
import extdeps.bmc.access_profile { BmcAccessObservation }
import extdeps.bmc.capability { BmcFirmwareReleaseCapabilityRow }
import extdeps.bmc.ipmi_boot_selection { IpmiBootSelection }
import gunbc.machine_intake_oob_boot_handoff {
  OobBootHandoffAdmission,
  oob_boot_handoff_admission,
  oob_handoff_is_admitted,
}
import gunbc.machine_intake_mtcollins1_access_observation {
  mtcollins1_access_observation,
  mtcollins1_capability_row,
}
import gunbc.machine_intake_mtcollins1_actuate {
  mtcollins1_bmc_username,
  mtcollins1_cdrom_selection,
  mtcollins1_power_action,
}
import gunbc.fleet_intent_network { operator_host_mtcollins1 }
import gunbc.fleet_runner_connectivity { fleet_hosts }

// WHICH HOSTS THIS FLEET MAY DRIVE BACK TO A KNOWN STATE THROUGH THEIR CONTROLLERS. Membership is
// derived from the same admission fold the control issuer runs, so the roster cannot authorize a
// controller the operation itself refuses.
//
// THE BOOT POLICY TRAVELS AS ONE TYPED SELECTION. The prior row carried a device string and a
// read-back substring independently, while firmware mode and persistence were absent. That let a
// caller request `cdrom`, accept the matching selector, and silently leave parameter 5 in legacy
// mode. IpmiBootSelection is sole-constructor; this roster can neither forge its wire words nor
// pair Aarch64 with legacy mode.
type ResetSubjectCandidate {
  host: HostIdentity
  observation: BmcAccessObservation
  capability_row: BmcFirmwareReleaseCapabilityRow
  username: NonEmptyStr
  boot_selection: IpmiBootSelection
  power_action: NonEmptyStr
}

fn reset_subject_candidates() -> List<ResetSubjectCandidate> {
  [
    ResetSubjectCandidate {
      host: operator_host_mtcollins1,
      observation: mtcollins1_access_observation,
      capability_row: mtcollins1_capability_row,
      username: mtcollins1_bmc_username,
      boot_selection: mtcollins1_cdrom_selection,
      power_action: mtcollins1_power_action,
    },
  ]
}

fn reset_subject_admission(candidate: ResetSubjectCandidate) -> OobBootHandoffAdmission {
  oob_boot_handoff_admission(
    observation: candidate.observation,
    capability_row: candidate.capability_row,
  )
}

fn reset_subject_roster() -> List<NonEmptyStr> {
  fold(
    reset_subject_candidates(),
    init: [],
    f: (acc, c) =>
      if oob_handoff_is_admitted(admission: reset_subject_admission(candidate: c)) {
        concat(acc, [c.host as NonEmptyStr])
      } else {
        acc
      },
  )
}

// RESET OBSERVERS are executor hosts, not reset subjects by implication. The two sets meet only
// here because observing a reset needs a runner on a peer.
fn reset_observer_peer_roster() -> List<NonEmptyStr> {
  map(fleet_hosts(), h => h as NonEmptyStr)
}

fn reset_subject_candidate_for(host: NonEmptyStr) -> ResetSubjectCandidate? {
  fold(
    reset_subject_candidates(),
    init: none,
    f: (acc, c) => match acc {
      Present { value: _ } => acc
      Absent => if (c.host as String) == (host as String) { Present { value: c } } else { acc }
    },
  )
}
