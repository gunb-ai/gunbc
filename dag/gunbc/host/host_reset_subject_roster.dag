module gunbc.host_reset_subject_roster

import std.types { Bool, List, NonEmptyStr, String }
import extdeps.bmc.ipmi_boot_selection { IpmiBootSelection }
import product.host_identity { HostIdentity }
import gunbc.machine_intake_oob_boot_handoff {
  OobBootHandoffAdmission,
  oob_boot_handoff_admission,
  oob_handoff_is_admitted,
}
import gunbc.managed_host {
  ManagedHost,
  ManagedHostBinding,
  ManagedHostBindingStanding,
  ManagedHostAccessUnobserved,
  ManagedHostBound,
  ManagedHostEndpointMismatch,
  ManagedHostNotSecured,
  ManagedHostMembership,
  OrdinaryMember,
  MemberUnderDeclaredDrop,
  managed_host_binding,
  managed_host_memberships,
}
import gunbc.machine_intake_subject { MachineIntakeSubject }
import std.decl_ref { DeclarationRef }
import gunbc.host_reset_boot_selection { reset_boot_selection }
import gunbc.fleet_runner_connectivity { fleet_hosts }

// WHICH HOSTS THIS FLEET MAY DRIVE BACK TO A KNOWN STATE THROUGH THEIR CONTROLLERS, and it is a
// DERIVED SUBSET of gunbc.managed_host managed_hosts() rather than a list anyone maintains.
//
// "MAY HAVE ITS POWER DRIVEN OUT OF BAND" IS NOT "IS AN EXECUTOR FLEET HOST", and conflating the two
// is the §3 meaning fork this module exists to avoid. gunbc.fleet_runner_connectivity fleet_hosts()
// means "commits runner slots" -- its consumers fold it as an eligible host set and to gather
// committed slot identities -- so a host reachable only through its BMC does not belong in it, and a
// host with runner slots is not thereby drivable out of band. Two predicates, two rosters, one
// naming authority underneath both: every identity here comes from gunbc.fleet_intent_network.
//
// MEMBERSHIP IS THE ADMISSION THE ACTUATION ARM ALREADY PERFORMS, AND NOTHING THE RUN DOES NOT USE.
// A managed host is a reset subject exactly when gunbc.managed_host managed_host_binding binds its
// secured account to an access observation of the same controller, gunbc.host_reset_boot_selection
// gives it a reset selection, and oob_boot_handoff_admission -- the fold
// gunbc.machine_intake_oob_boot_handoff runs before it writes anything to a controller -- admits the
// observation against its capability row. The admitted subject carries the binding and the
// selection, and the run reads both from it, so a roster member can never fail dispatch for want of
// a fact the roster did not check. AdmittedResetSubject is sole_constructor, so admit_reset_subject is
// its only mint and no module can hand the run a subject that skipped this admission.
type AdmittedResetSubject sole_constructor {
  binding: ManagedHostBinding
  boot_selection: IpmiBootSelection
}

type ResetSubjectAdmission
  = ResetSubjectAdmitted { subject: AdmittedResetSubject }
  | ResetSubjectUnbound { standing: ManagedHostBindingStanding }
  | ResetSubjectNoSelection { host: HostIdentity }
  | ResetSubjectControllerNotAdmitted { admission: OobBootHandoffAdmission }

fn admit_reset_subject(host: ManagedHost) -> ResetSubjectAdmission {
  match managed_host_binding(host: host) {
    ManagedHostBound { binding: b } =>
      match reset_boot_selection(host: host) {
        Absent => ResetSubjectNoSelection { host: host.host }
        Present { value: selection } => {
          let admission = oob_boot_handoff_admission(observation: b.observation, capability_row: host.capability_row)
          if oob_handoff_is_admitted(admission: admission) {
            ResetSubjectAdmitted { subject: AdmittedResetSubject { binding: b, boot_selection: selection } }
          } else {
            ResetSubjectControllerNotAdmitted { admission: admission }
          }
        }
      }
    ManagedHostAccessUnobserved { endpoint: e } => ResetSubjectUnbound { standing: ManagedHostAccessUnobserved { endpoint: e } }
    ManagedHostNotSecured { cause: c } => ResetSubjectUnbound { standing: ManagedHostNotSecured { cause: c } }
    ManagedHostEndpointMismatch { observed: o, secured: sc } =>
      ResetSubjectUnbound { standing: ManagedHostEndpointMismatch { observed: o, secured: sc } }
  }
}

// THE FOLD RUNS OVER EVERY HOST IT IS GIVEN, ADMITTED OR NOT, so the filter has something to refuse: a
// roster assembled from already-admitted hosts would make its own filter unreachable.
fn admitted_reset_subjects(hosts: List<ManagedHost>) -> List<AdmittedResetSubject> {
  fold(
    hosts,
    init: [],
    f: (acc, h) => match admit_reset_subject(host: h) {
      ResetSubjectAdmitted { subject: s } => concat(acc, [s])
      ResetSubjectUnbound { standing: _ } => acc
      ResetSubjectNoSelection { host: _ } => acc
      ResetSubjectControllerNotAdmitted { admission: _ } => acc
    },
  )
}

fn reset_subject_roster_of(hosts: List<ManagedHost>) -> List<NonEmptyStr> {
  map(admitted_reset_subjects(hosts: hosts), s => s.binding.host.host as NonEmptyStr)
}

type ResetRosterEntry
  = OrdinaryResetRosterHost { host: NonEmptyStr }
  | ResetRosterHostUnderDeclaredDrop { host: NonEmptyStr, drop: DeclarationRef }

fn reset_roster_hosts(entries: List<ResetRosterEntry>) -> List<NonEmptyStr> {
  map(entries, e => match e {
    OrdinaryResetRosterHost { host: h } => h
    ResetRosterHostUnderDeclaredDrop { host: h, drop: _ } => h
  })
}

type ResetSubjectLookup
  = ResetSubjectNotAdmitted
  | ResetSubjectAdmittedOrdinary { subject: AdmittedResetSubject }
  | ResetSubjectAdmittedUnderDeclaredDrop {
      subject: AdmittedResetSubject
      drop: DeclarationRef
      standing_subject: MachineIntakeSubject
      current_subject: MachineIntakeSubject
    }

fn reset_lookup_subject(lookup: ResetSubjectLookup) -> AdmittedResetSubject? {
  match lookup {
    ResetSubjectNotAdmitted => none
    ResetSubjectAdmittedOrdinary { subject: s } => Present { value: s }
    ResetSubjectAdmittedUnderDeclaredDrop { subject: s, drop: _, standing_subject: _, current_subject: _ } =>
      Present { value: s }
  }
}

fn reset_roster_entries_of(m: ManagedHostMembership) -> List<ResetRosterEntry> {
  match m {
    OrdinaryMember { host: h } =>
      map(reset_subject_roster_of(hosts: [h]), name => OrdinaryResetRosterHost { host: name })
    MemberUnderDeclaredDrop { drop: d, standing_subject: _, current_subject: _, host: h } =>
      map(reset_subject_roster_of(hosts: [h]), name => ResetRosterHostUnderDeclaredDrop { host: name, drop: d })
  }
}

// THE FILTER IS A PREDICATE, NOT A FAILURE ARM, AND THE DIFFERENCE MATTERS HERE. Dropping a
// candidate whose controller does not admit power control is not an absorbing fallback swallowing a
// diagnostic -- it is the membership condition doing its job, and the dropped host is not a loss but
// a non-member. The refusal that DOES have to be loud is one level up, in
// gunbc.host_reset_return reset_dispatch_options, where an unmintable observer pairing refuses the
// whole option list rather than quietly shrinking it.
fn reset_subject_roster() -> List<ResetRosterEntry> {
  fold(managed_host_memberships(), init: [], f: (acc, m) => concat(acc, reset_roster_entries_of(m: m)))
}

// THE PEERS THAT MAY OBSERVE A RESET are the executor fleet hosts, and this is the one place the two
// rosters legitimately meet: an observer needs a runner to run on, which is exactly what fleet_hosts()
// means. Derived from that authority rather than spelled, so enrolling or retiring an executor host
// moves the observer set with it.
fn reset_observer_peer_roster() -> List<NonEmptyStr> {
  map(fleet_hosts(), h => h as NonEmptyStr)
}

// THE ADMITTED SUBJECT FOR ONE LABEL, so a caller that resolved a subject reaches its binding and
// selection without re-walking the roster in its own vocabulary. Absent means the label names no
// admitted subject, which a caller must treat as a refusal and never as a host it may drive with
// defaults.
fn reset_subject_for(host: NonEmptyStr) -> ResetSubjectLookup {
  fold(
    managed_host_memberships(),
    init: ResetSubjectNotAdmitted,
    f: (acc, m) => match acc {
      ResetSubjectAdmittedOrdinary { subject: _ } => acc
      ResetSubjectAdmittedUnderDeclaredDrop { subject: _, drop: _, standing_subject: _, current_subject: _ } => acc
      ResetSubjectNotAdmitted =>
        match m {
          OrdinaryMember { host: h } =>
            fold(admitted_reset_subjects(hosts: [h]), init: ResetSubjectNotAdmitted, f: (inner, s) =>
              if (s.binding.host.host as String) == (host as String) {
                ResetSubjectAdmittedOrdinary { subject: s }
              } else {
                inner
              })
          MemberUnderDeclaredDrop { drop: d, standing_subject: standing, current_subject: current, host: h } =>
            fold(admitted_reset_subjects(hosts: [h]), init: ResetSubjectNotAdmitted, f: (inner, s) =>
              if (s.binding.host.host as String) == (host as String) {
                ResetSubjectAdmittedUnderDeclaredDrop {
                  subject: s,
                  drop: d,
                  standing_subject: standing,
                  current_subject: current,
                }
              } else {
                inner
              })
        }
    },
  )
}
