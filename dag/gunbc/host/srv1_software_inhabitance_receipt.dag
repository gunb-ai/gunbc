type HostSoftwareProbe {
  program: ProgramIdentity
  arguments: List<String>
}

fn host_software_probe_obligation(p: HostSoftwareProbe) -> NonEmptyStr {
  fold(p.arguments, init: p.program.invocation as String, f: (acc, a) => join([acc, " ", a], "")) as NonEmptyStr
}

fn srv1_os_release_probe() -> HostSoftwareProbe {
  HostSoftwareProbe { program: cat_program(), arguments: ["/etc/os-release"] }
}

fn srv1_kernel_release_probe() -> HostSoftwareProbe {
  HostSoftwareProbe { program: uname_program(), arguments: ["-r"] }
}

fn srv1_apparmor_sysctl_probe() -> HostSoftwareProbe {
  HostSoftwareProbe {
    program: sysctl_program(),
    arguments: ["-n", apparmor_restrict_unprivileged_userns_sysctl_name as String],
  }
}

fn srv1_sudo_list_probe() -> HostSoftwareProbe {
  HostSoftwareProbe { program: sudo_program(), arguments: ["-n", "-l"] }
}

fn srv1_procps_probe() -> HostSoftwareProbe {
  HostSoftwareProbe { program: kill_program(), arguments: ["-V"] }
}

fn srv1_timeout_probe() -> HostSoftwareProbe {
  HostSoftwareProbe { program: timeout_program(), arguments: ["--version"] }
}

fn srv1_git_probe() -> HostSoftwareProbe {
  HostSoftwareProbe { program: git_program(), arguments: ["--version"] }
}

fn srv1_jq_probe() -> HostSoftwareProbe {
  HostSoftwareProbe { program: jq_program(), arguments: ["--version"] }
}

fn srv1_systemd_probe() -> HostSoftwareProbe {
  HostSoftwareProbe { program: systemctl_path_resolved_program(), arguments: ["--version"] }
}

fn srv1_cgroup_delegation_probe(uid: Int) -> HostSoftwareProbe {
  HostSoftwareProbe {
    program: cat_program(),
    arguments: [
      join([
        "/sys/fs/cgroup/user.slice/user-",
        to_string(uid),
        ".slice/user@",
        to_string(uid),
        ".service/cgroup.controllers",
      ], ""),
    ],
  }
}

fn srv1_tailscale_probe() -> HostSoftwareProbe {
  HostSoftwareProbe { program: tailscale_program(), arguments: ["version"] }
}

fn srv1_git_path_probe() -> HostSoftwareProbe {
  HostSoftwareProbe { program: git_program(), arguments: [] }
}

fn srv1_jq_path_probe() -> HostSoftwareProbe {
  HostSoftwareProbe { program: jq_program(), arguments: [] }
}

fn srv1_timeout_path_probe() -> HostSoftwareProbe {
  HostSoftwareProbe { program: timeout_program(), arguments: [] }
}

fn srv1_systemd_run_path_probe() -> HostSoftwareProbe {
  HostSoftwareProbe { program: systemd_run_program(), arguments: [] }
}

fn srv1_toolchain_path_probes() -> List<HostSoftwareProbe> {
  [
    srv1_git_path_probe(),
    srv1_jq_path_probe(),
    srv1_timeout_path_probe(),
    srv1_systemd_run_path_probe(),
  ]
}

fn srv1_toolchain_read_obligation() -> NonEmptyStr {
  join([
    host_software_probe_obligation(p: srv1_git_path_probe()) as String,
    "; ",
    host_software_probe_obligation(p: srv1_jq_path_probe()) as String,
    "; ",
    host_software_probe_obligation(p: srv1_timeout_path_probe()) as String,
    "; ",
    host_software_probe_obligation(p: srv1_systemd_run_path_probe()) as String,
  ], "") as NonEmptyStr
}

fn srv1_dpkg_query_probe() -> HostSoftwareProbe {
  HostSoftwareProbe {
    program: dpkg_query_identity(),
    arguments: ["-W", "procps", "coreutils", "git", "jq", "systemd", "tailscale"],
  }
}

