// THE OBSERVER'S SIDE OF ONE RESET ATTEMPT, EXECUTED. The controller operation only issues the
// typed control request; this module independently observes the host go down and return. Neither
// fact substitutes for the other.

data host_reset_return_probe_label: NonEmptyStr = "ssh.Session.Reachability, BatchMode, ConnectTimeout=5"

func host_is_reachable(host: NonEmptyStr) -> Bool
  uses net: std.resources.Network
{
  return ssh.Session.Reachability(host: host).reachable
}

type LivenessWatch
  = WatchSaw { at: EpochMs, samples: Int }
  | WatchTimedOut { samples: Int, watched_until: EpochMs }
  | WatchClockRefused { detail: String }

type WatchFold {
  outcome: LivenessWatch?
  samples: Int
  last_seen_at: EpochMs
}

func watch_step(acc: WatchFold, want_reachable: Bool, host: NonEmptyStr) -> WatchFold
  uses net: std.resources.Network
{
  return match acc.outcome {
    Present { value: _ } => acc
    Absent =>
      match clock_unix_millis_read() {
        ClockUnixMillisRefused { detail: d } =>
          WatchFold {
            outcome: Present { value: WatchClockRefused { detail: d } },
            samples: acc.samples,
            last_seen_at: acc.last_seen_at,
          }
        ClockUnixMillisObserved { millis: now } =>
          if host_is_reachable(host: host) == want_reachable {
            WatchFold {
              outcome: Present { value: WatchSaw { at: now, samples: acc.samples + 1 } },
              samples: acc.samples + 1,
              last_seen_at: now,
            }
          } else {
            let _s = sleep_delay_seconds_second_carrier_projection(duration: host_reset_watch_sample_cadence)
            WatchFold { outcome: none, samples: acc.samples + 1, last_seen_at: now }
          }
      }
  }
}

func watch_for(host: NonEmptyStr, want_reachable: Bool, max_samples: Nat) -> LivenessWatch
  uses net: std.resources.Network
{
  let done = fold(
    nat_range_inclusive(lo: 1, hi: max_samples),
    init: WatchFold { outcome: none, samples: 0, last_seen_at: 0 },
    f: (acc, _i) => watch_step(acc: acc, want_reachable: want_reachable, host: host),
  )
  return match done.outcome {
    Present { value: o } => o
    Absent => WatchTimedOut { samples: done.samples, watched_until: done.last_seen_at }
  }
}

// THE DOWN WATCH RUNS FIRST. A return observation is reachable only after a departure observation,
// so an already-up host cannot be reported as having rebooted.
func observe_reset_return(host: NonEmptyStr, down_samples_max: Nat, back_samples_max: Nat) -> HostReturnObservation
  uses net: std.resources.Network
{
  return match watch_for(host: host, want_reachable: false, max_samples: down_samples_max) {
    WatchClockRefused { detail: d } =>
      HostReturnUnobserved { cause: join(["the observer could not read its own clock while watching for the host to go down: ", d], "") as NonEmptyStr }
    WatchTimedOut { samples: n, watched_until: until } =>
      HostNeverObservedDown {
        probe: host_reset_return_probe_label,
        samples: n,
        watched_until: until,
      }
    WatchSaw { at: down_at, samples: down_n } =>
      match watch_for(host: host, want_reachable: true, max_samples: back_samples_max) {
        WatchClockRefused { detail: d } =>
          HostReturnUnobserved { cause: join(["the observer could not read its own clock while watching for the host to return: ", d], "") as NonEmptyStr }
        WatchTimedOut { samples: _, watched_until: until } =>
          HostObservedDownAndNotBack {
            probe: host_reset_return_probe_label,
            down_first_seen_at: down_at,
            waited_until: until,
          }
        WatchSaw { at: back_at, samples: back_n } =>
          HostObservedDownThenBack {
            probe: host_reset_return_probe_label,
            down_first_seen_at: down_at,
            back_first_seen_at: back_at,
            down_samples: down_n,
            back_samples: back_n,
          }
      }
  }
}

// The runner label, the observer's own hostname, and the allocation roster are independent reads.
// A mislabeled runner on the subject chassis cannot pass by merely differing in one spelling.
func observer_self_corroboration(observer: HostIdentity, subject: HostIdentity) -> ObserverSelfIdentity
  uses net: std.resources.Network
{
  let observed = os.Hostname.ReadShort()
  if observed.success == false {
    return ObserverSelfIdentityUnreadable {
      cause: "the observer could not read its own short hostname, so it cannot establish that it is not the subject machine",
    }
  }
  return match canonical_hostname_for_fleet_slot(fleet_slot: subject) {
    Absent =>
      ObserverSelfIdentityUnreadable {
        cause: join(
          [
            "the subject has no canonical hostname allocated in gunbc.hostname_allocation, so the observer cannot compare itself against it: ",
            subject as String,
          ],
          "",
        ) as NonEmptyStr,
      }
    Present { value: subject_hostname } =>
      match canonical_hostname_for_fleet_slot(fleet_slot: observer) {
        Absent =>
          ObserverSelfIdentityUnreadable {
            cause: join(
              [
                "the observer has no canonical hostname allocated, so its own reported name is evidence about nothing: ",
                observer as String,
              ],
              "",
            ) as NonEmptyStr,
          }
        Present { value: observer_hostname } =>
          observer_self_identity(
            observer_machine_id: trim(s: observed.value) as NonEmptyStr,
            observer_allocated_hostname: observer_hostname as NonEmptyStr,
            subject_machine_id: subject_hostname as NonEmptyStr,
          )
      }
  }
}

// A subject already unreachable before issuance cannot prove that this attempt moved it down.
func subject_baseline(host: NonEmptyStr) -> HostReturnObservation?
  uses net: std.resources.Network
{
  if host_is_reachable(host: host) {
    return none
  }
  return match clock_unix_millis_read() {
    ClockUnixMillisRefused { detail: d } =>
      Present { value: HostReturnUnobserved { cause: join(["the observer could not read its own clock while taking the pre-issuance baseline: ", d], "") as NonEmptyStr } }
    ClockUnixMillisObserved { millis: now } =>
      Present {
        value: SubjectNotUpBeforeIssuance {
          probe: host_reset_return_probe_label,
          checked_at: now,
        },
      }
  }
}

// THE ACKNOWLEDGEMENT IS CONTROL-PLANE GRAIN. BootControlIssued means the complete typed parameter
// read back and the power command was accepted; it does not claim an artifact booted. The independent
// down/back observation below supplies this workflow's terminal reset property.
fn acknowledgement_of_boot_control(outcome: OobBootControlOutcome, issued_at: EpochMs) -> ResetCommandAcknowledgement {
  match outcome {
    BootControlIssued { selection: s } =>
      ResetAccepted {
        controller_response: join(["typed boot control ", ipmi_boot_selection_label(selection: s) as String, " read back and the power action was accepted"], "") as NonEmptyStr,
        issued_at: issued_at,
      }
    BootSelectionRefused { selection: s } =>
      ResetRefusedByController { diagnostic: join(["controller refused typed boot selection ", ipmi_boot_selection_label(selection: s) as String, "; nothing was cycled"], "") as NonEmptyStr }
    BootSelectionNotApplied { selection: s, readback: r } =>
      ResetRefusedByController {
        diagnostic: join(["device selector disagreed with ", ipmi_boot_selection_label(selection: s) as String, "; parameter 5: ", r], "") as NonEmptyStr,
      }
    BootSelectionFirmwareModeMismatch { selection: s, readback: r } =>
      ResetRefusedByController {
        diagnostic: join(["firmware mode disagreed with ", ipmi_boot_selection_label(selection: s) as String, "; parameter 5: ", r], "") as NonEmptyStr,
      }
    BootSelectionPersistenceMismatch { selection: s, readback: r } =>
      ResetRefusedByController {
        diagnostic: join(["persistence disagreed with ", ipmi_boot_selection_label(selection: s) as String, "; parameter 5: ", r], "") as NonEmptyStr,
      }
    BootSelectionFlagInvalid { selection: s, readback: r } =>
      ResetRefusedByController {
        diagnostic: join(["boot flag invalid for ", ipmi_boot_selection_label(selection: s) as String, "; parameter 5: ", r], "") as NonEmptyStr,
      }
    BootSelectionUnverifiable { selection: s, readback: r } =>
      ResetRefusedByController {
        diagnostic: join(["parameter 5 unreadable for ", ipmi_boot_selection_label(selection: s) as String, "; output: ", r], "") as NonEmptyStr,
      }
    PowerCycleRefused { selection: s } =>
      ResetRefusedByController {
        diagnostic: join(["typed selection applied but power cycle refused for ", ipmi_boot_selection_label(selection: s) as String], "") as NonEmptyStr,
      }
    BootControlNotAdmitted { admission: _ } =>
      ResetNotAttempted { cause: "the controller was not admitted for out-of-band drive; no write was attempted" }
  }
}

data host_reset_watch_sample_cadence: Second = second(count: 1)
data host_reset_down_watch_samples: Nat = 120
data host_reset_back_watch_samples: Nat = 200

func host_reset_return_attempt(
  candidate: ResetSubjectCandidate,
  observer: NonEmptyStr,
  attempt: NonEmptyStr,
  route: ResetIssuanceRoute,
  password_file: NonEmptyStr,
) -> ResetAttemptMint
  uses net: std.resources.Network
{
  let subject = candidate.host as NonEmptyStr
  let selection = select_reset_observer(
    subject_roster: reset_subject_roster(),
    peer_roster: reset_observer_peer_roster(),
    subject: subject,
    observer: observer,
  )
  let identity = observer_self_corroboration(observer: observer as HostIdentity, subject: candidate.host)
  match reset_issuance_block(selection: selection, identity: identity) {
    Present { value: blocked } =>
      return mint_reset_attempt_receipt(
        selection: selection,
        attempt: attempt,
        route: route,
        self_identity: identity,
        acknowledgement: ResetNotAttempted {
          cause: join([
            "issuance was blocked before any controller write: ",
            reset_return_refusal_cause_wire(cause: blocked),
          ], "") as NonEmptyStr,
        },
        observation: HostReturnUnobserved { cause: "no reset was issued, so nothing was watched" },
      )
    Absent => none
  }
  return match subject_baseline(host: subject) {
    Present { value: refused } =>
      mint_reset_attempt_receipt(
        selection: selection,
        attempt: attempt,
        route: route,
        self_identity: identity,
        acknowledgement: ResetNotAttempted { cause: "the pre-issuance baseline refused, so no controller write was attempted" },
        observation: refused,
      )
    Absent =>
      match clock_unix_millis_read() {
        ClockUnixMillisRefused { detail: d } =>
          mint_reset_attempt_receipt(
            selection: selection,
            attempt: attempt,
            route: route,
            self_identity: identity,
            acknowledgement: ResetNotAttempted { cause: join(["the observer could not read its own clock, so no issuance instant exists and no write was attempted: ", d], "") as NonEmptyStr },
            observation: HostReturnUnobserved { cause: "no issuance instant was established, so nothing was watched" },
          )
        ClockUnixMillisObserved { millis: issued_at } =>
          host_reset_return_issue_and_watch(
            candidate: candidate,
            selection: selection,
            identity: identity,
            attempt: attempt,
            route: route,
            password_file: password_file,
            issued_at: issued_at,
          )
      }
  }
}

func host_reset_return_issue_and_watch(
  candidate: ResetSubjectCandidate,
  selection: ResetObserverSelection,
  identity: ObserverSelfIdentity,
  attempt: NonEmptyStr,
  route: ResetIssuanceRoute,
  password_file: NonEmptyStr,
  issued_at: EpochMs,
) -> ResetAttemptMint
  uses net: std.resources.Network
{
  let outcome = oob_boot_control_issue(
    observation: candidate.observation,
    capability_row: candidate.capability_row,
    username: candidate.username,
    password_file: password_file,
    selection: candidate.boot_selection,
    power_action: candidate.power_action,
  )
  let ack = acknowledgement_of_boot_control(outcome: outcome, issued_at: issued_at)
  let observation = observe_reset_return(
    host: candidate.host as NonEmptyStr,
    down_samples_max: host_reset_down_watch_samples,
    back_samples_max: host_reset_back_watch_samples,
  )
  return mint_reset_attempt_receipt(
    selection: selection,
    attempt: attempt,
    route: route,
    self_identity: identity,
    acknowledgement: ack,
    observation: observation,
  )
}

data host_reset_bmc_credential_path_env: NonEmptyStr = "GUNBC_HOST_RESET_BMC_CREDENTIAL_FILE" as NonEmptyStr

func host_reset_return_preflight_exit(refusal: ResetPreflightRefusal, remedy: String) -> ProcessExit
  uses net: std.resources.Network
{
  let wire = reset_preflight_refusal_wire(refusal: refusal)
  let _w = Filesystem.Write(
    path: host_reset_return_receipt_path as String,
    content: join(["attempt=none-minted verdict=refused-before-attempt downtime_ms=unavailable cause=", wire, "\n"], ""),
  )
  return exit_failure(
    reason: join(["host reset-return refused before any attempt: ", wire, " -- ", remedy, " (receipt at ", host_reset_return_receipt_path as String, ")"], ""),
  )
}

func host_reset_return_dispatch_admission_wet() -> ProcessExit
  uses net: std.resources.Network
{
  let mode_raw = match shell.Env.Get(name: host_reset_dispatch_mode_env).value {
    Absent => ""
    Present { value: v } => v
  }
  let observer_raw = match shell.Env.Get(name: host_reset_observer_label_env).value {
    Absent => ""
    Present { value: v } => v
  }
  return match admit_reset_dispatch(mode: mode_raw, reset_observer: observer_raw) {
    ResetDispatchNotThisMode { mode: _ } => ExitSuccess
    ResetDispatchAdmitted { mode: _ } => ExitSuccess
    ResetDispatchObserverUnnamed { mode: _ } =>
      exit_failure(reason: reset_dispatch_observer_unnamed_diagnostic as String)
  }
}

data host_reset_dispatch_mode_env: NonEmptyStr = "GUNBC_HOST_RESET_DISPATCH_MODE" as NonEmptyStr

func host_reset_return_wet() -> ProcessExit
  uses net: std.resources.Network
{
  let credential = shell.Env.Get(name: host_reset_bmc_credential_path_env).value
  let password_file_raw = match credential {
    Absent => ""
    Present { value: raw } => trim(s: raw)
  }
  if password_file_raw == "" {
    return host_reset_return_preflight_exit(
      refusal: BmcCredentialPathUnset { variable: host_reset_bmc_credential_path_env },
      remedy: "no controller credential was materialized, so nothing was written to any controller; the workflow step that would materialize it is the declared frontier for this mode",
    )
  }
  let label = shell.Env.Get(name: host_reset_observer_label_env).value
  let observer_raw = match label {
    Absent => ""
    Present { value: raw } => trim(s: raw)
  }
  if observer_raw == "" {
    return host_reset_return_preflight_exit(
      refusal: ObserverLabelUnset { variable: host_reset_observer_label_env },
      remedy: "this run does not know which observer the dispatch placed it as, and it deliberately does NOT fall back to its own hostname",
    )
  }
  let observer = observer_raw as NonEmptyStr
  let route = match host_reset_return_converge_route_read() {
    RouteUnidentified { variable: v, detail: d } =>
      return host_reset_return_preflight_exit(
        refusal: IssuingRunUnidentified { variable: v, detail: d },
        remedy: "a receipt minted here could not name the run that drove the machine",
      )
    RouteEstablished { route: r } => r
  }
  let assignment = reset_dispatch_pairings(
    subject_roster: reset_subject_roster(),
    peer_roster: reset_observer_peer_roster(),
  )
  return match subject_for_observer(assignment: assignment, observer: observer) {
    Absent =>
      host_reset_return_preflight_exit(
        refusal: ObserverNotAssigned { observer: observer },
        remedy: "this runner is not an assigned observer, so it has no subject to watch",
      )
    Present { value: subject } =>
      match reset_subject_candidate_for(host: subject) {
        Absent =>
          host_reset_return_preflight_exit(
            refusal: SubjectHasNoRosterRow { subject: subject },
            remedy: "the assigned subject has no roster row carrying its controller evidence",
          )
        Present { value: candidate } =>
          host_reset_return_exit(
            verdict: reset_return_verdict_of_mint(
              mint: host_reset_return_attempt(
                candidate: candidate,
                observer: observer,
                attempt: host_reset_return_attempt_label(observer: observer, subject: subject),
                route: route,
                password_file: password_file_raw as NonEmptyStr,
              )
            ),
            subject: subject,
            attempt: host_reset_return_attempt_label(observer: observer, subject: subject),
          )
      }
  }
}

func host_reset_return_converge_route_read() -> ResetIssuanceRouteRead
  uses net: std.resources.Network
{
  match actions_variable_read(name: github_run_id_variable_name) {
    ActionsVariableAbsent { variable: v, detail: d } =>
      RouteUnidentified { variable: v as NonEmptyStr, detail: d as NonEmptyStr }
    ActionsVariablePresent { value: run_id } =>
      RouteEstablished {
        route: IssuedThroughConverge {
          workflow: "fleet-converge",
          mode: "host_reset_return",
          run_id: run_id as NonEmptyStr,
        },
      }
  }
}

fn host_reset_return_attempt_label(observer: NonEmptyStr, subject: NonEmptyStr) -> NonEmptyStr {
  join([subject as String, "-observed-by-", observer as String], "") as NonEmptyStr
}

fn host_reset_return_receipt_line(verdict: ResetReturnVerdict, subject: NonEmptyStr, attempt: NonEmptyStr) -> String {
  match verdict {
    HostDrivenBackToKnownState { downtime: ms } =>
      join(["attempt=", attempt as String, " subject=", subject as String, " verdict=driven-back downtime_ms=", to_string(ms), "\n"], "")
    ResetReturnRefused { cause: c } =>
      join(["attempt=", attempt as String, " subject=", subject as String, " verdict=refused downtime_ms=unavailable cause=", reset_return_refusal_cause_wire(cause: c), "\n"], "")
  }
}

func host_reset_return_exit(verdict: ResetReturnVerdict, subject: NonEmptyStr, attempt: NonEmptyStr) -> ProcessExit
  uses net: std.resources.Network
{
  let _w = Filesystem.Write(
    path: host_reset_return_receipt_path as String,
    content: host_reset_return_receipt_line(verdict: verdict, subject: subject, attempt: attempt),
  )
  return match verdict {
    HostDrivenBackToKnownState { downtime: _ } => ExitSuccess
    ResetReturnRefused { cause: c } =>
      exit_failure(
        reason: join(["host reset-return refused for ", subject as String, ": ", reset_return_refusal_cause_wire(cause: c), " (receipt at ", host_reset_return_receipt_path as String, ")"], "")
      )
  }
}
