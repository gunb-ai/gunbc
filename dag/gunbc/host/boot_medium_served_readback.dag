module gunbc.host.boot_medium_served_readback

import std.types { Int, List, NonEmptyStr, String }
import std.algebra { trim }
import std.content_hash { sha256_hex_digest }
import extdeps.crypto.hash { sha256sum_file_command }
import extdeps.exec.command { argv_words }
import extdeps.ssh.known_hosts { known_hosts_host_field }
import gunbc.fleet.fleet_ssh_locus { prepare_fleet_ssh_agent_context, FleetSshContextReady, FleetSshContextRefused }
import gunbc.typed_argv_exec { TypedArgvExecOutcome, typed_argv_exec_over_fleet_ssh, TypedArgvExecConverged, TypedArgvExecRefused }
import gunbc.host.boot_medium { BootMedium, BootMediumReadbackHeld, BootMediumReadbackDigestDiffers, boot_medium_readback }
import gunbc.machine_intake.boot_image_fetch { boot_image_published_path }

// THE BOOT-TIME READBACK OF THE SELECTED MEDIUM, whichever medium that is. The medium row carries the
// digest a publication measured; between that run and this boot the file the BMC will mount over NFS
// could have been replaced, truncated or removed. So the boot re-measures the served file on the host
// that serves the export, over the medium's own exporter target, and judges the measurement by the one
// readback rule every boot medium is judged by (gunbc.host.boot_medium boot_medium_readback). The
// publication receipt is the row's digest; this is the independent reading of the stored bytes.
//
// The join is a pure fold over what the remote leg answered, so a witness supplies the answer and the
// fleet-SSH leg below is the one producer. A refused or failed leg is unreadable, never diverged: the
// bytes were never read.
type RemoteAnswer {
  exit_code: Int
  stdout: String
  stderr: String
}

type BootMediumServedReadback
  = BootMediumServedHeld { host: NonEmptyStr, image_name: NonEmptyStr, served_path: NonEmptyStr, measured_digest: NonEmptyStr }
  | BootMediumServedUnreadable { host: NonEmptyStr, served_path: NonEmptyStr, reason: String }
  | BootMediumServedMeasureMalformed { served_path: NonEmptyStr, content: String }
  | BootMediumServedDiverged { served_path: NonEmptyStr, expected: NonEmptyStr, measured: NonEmptyStr }

fn boot_medium_served_path(medium: BootMedium) -> NonEmptyStr {
  boot_image_published_path(export_dir: medium.export.dir, image_name: medium.image_name)
}

fn boot_medium_served_argv(path: NonEmptyStr) -> List<String> {
  argv_words(command: sha256sum_file_command(path: path as String))
}

// sha256sum prints "<hex>  <path>": the first whitespace-delimited field, admitted as a digest.
fn sha256sum_digest(line: String) -> String? {
  match get(xs: split(s: trim(s: line), delimiter: " "), index: 0) {
    Absent => none
    Present { value: w } =>
      match sha256_hex_digest(hex: w) {
        Absent => none
        Present { value: d } => Present { value: d.hex as String }
      }
  }
}

fn boot_medium_served_join(medium: BootMedium, host: NonEmptyStr, measure: RemoteAnswer) -> BootMediumServedReadback {
  let served_path = boot_medium_served_path(medium: medium)
  if measure.exit_code != 0 {
    BootMediumServedUnreadable { host: host, served_path: served_path, reason: concat("exit=", to_string(measure.exit_code), " ", trim(s: measure.stderr)) }
  } else {
    match sha256sum_digest(line: measure.stdout) {
      Absent => BootMediumServedMeasureMalformed { served_path: served_path, content: trim(s: measure.stdout) }
      Present { value: measured } =>
        match boot_medium_readback(medium: medium, observed: measured as NonEmptyStr) {
          BootMediumReadbackHeld => BootMediumServedHeld { host: host, image_name: medium.image_name, served_path: served_path, measured_digest: measured as NonEmptyStr }
          BootMediumReadbackDigestDiffers { image_name: _, expected: e, observed: o } => BootMediumServedDiverged { served_path: served_path, expected: e, measured: o }
        }
    }
  }
}

// STAGE-NEUTRAL CAUSE. The SUBJECT'S label is a parameter, never a spelling baked into the text. The
// executor host is not: the readback names the host that actually took the leg (DESIGN 5, no
// fabricated output). What the boot has and has not touched differs between the two call sites, so
// the sentence about that is the caller's wrapper below.
fn boot_medium_served_refusal(subject: NonEmptyStr, readback: BootMediumServedReadback) -> String? {
  match readback {
    BootMediumServedHeld { host: _, image_name: _, served_path: _, measured_digest: _ } => none
    BootMediumServedUnreadable { host: h, served_path: p, reason: why } =>
      Present { value: concat(subject as String, " boot: the served medium ", p as String, " could not be re-measured on ", h as String, " (", why, "); refusing rather than trusting the publication receipt") }
    BootMediumServedMeasureMalformed { served_path: p, content: c } =>
      Present { value: concat(subject as String, " boot: sha256sum over ", p as String, " answered no sha256 digest (", c, "); refusing") }
    BootMediumServedDiverged { served_path: p, expected: e, measured: m } =>
      Present { value: concat(subject as String, " boot: the served medium ", p as String, " reads ", m as String, " but the medium row says ", e as String, "; refusing to mint a subject over bytes the row does not describe") }
  }
}

// Before the approval request is filed nothing has been claimed: the controller is untouched.
fn boot_medium_served_refusal_before_filing(subject: NonEmptyStr, readback: BootMediumServedReadback) -> String? {
  match boot_medium_served_refusal(subject: subject, readback: readback) {
    Absent => none
    Present { value: why } => Present { value: concat(why, " -- controller untouched") }
  }
}

// After the grant the boot has claimed the capability and acquired the SOL session; only the media
// attach, boot selection and power are still untouched, and the SOL session follows the existing
// settle/release path.
fn boot_medium_served_refusal_before_attach(subject: NonEmptyStr, readback: BootMediumServedReadback) -> String? {
  match boot_medium_served_refusal(subject: subject, readback: readback) {
    Absent => none
    Present { value: why } => Present { value: concat("after grant, before attach: ", why, " -- media attach, boot selection and power untouched; the SOL session had been acquired and follows the settle/release path") }
  }
}

fn remote_answer_of(outcome: TypedArgvExecOutcome) -> RemoteAnswer {
  match outcome {
    TypedArgvExecRefused { reason: r } => RemoteAnswer { exit_code: 255, stdout: "", stderr: r }
    TypedArgvExecConverged { result: r } => RemoteAnswer { exit_code: r.exit_code, stdout: r.stdout, stderr: r.stderr }
  }
}

// THE ONE PRODUCER: one read-only leg on the medium's own exporter (its SSH target, never a
// substituted one). The host the readback names is DERIVED from that target's address, not a free
// parameter, so it cannot name a host the leg did not run on.
fn boot_medium_served_readback(medium: BootMedium, attempt: NonEmptyStr) -> BootMediumServedReadback {
  let target = medium.export.target
  let host = known_hosts_host_field(address: target.address) as NonEmptyStr
  match prepare_fleet_ssh_agent_context(attempt_raw: attempt) {
    FleetSshContextRefused { cause: c } => BootMediumServedUnreadable { host: host, served_path: boot_medium_served_path(medium: medium), reason: c }
    FleetSshContextReady { context: context, receipt: _ } =>
      boot_medium_served_join(
        medium: medium,
        host: host,
        measure: remote_answer_of(outcome: typed_argv_exec_over_fleet_ssh(target: target, context: context, argv: boot_medium_served_argv(path: boot_medium_served_path(medium: medium)))),
      )
  }
}

data boot_medium_served_attempt_raw: String = "boot-medium-served-readback"
