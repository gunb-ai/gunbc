module gunbc.host_effect_nbd_proxy_serve

import std.types { String, NonEmptyStr, Int, List, Bool }
import std.disposition { Disposition, Terminal }
import std.temporal_effect { TemporalEffectPolicy, HeldSessionLease }
import std.upsert_decision {
  UpsertClassification,
  Noop,
  Apply,
  Refuse,
  Conflict,
  Drifted,
}
import extdeps.bmc.webui.nbd_proxy_serve {
  NbdProxyServeTransportIntent,
  nbd_proxy_serve_transport_intent,
  nbd_proxy_serve_nbdkit_argv,
  nbd_proxy_serve_websocat_argv,
  nbd_proxy_serve_nbdkit_unit_name,
  nbd_proxy_serve_websocat_unit_name,
  nbd_proxy_serve_session_fingerprint,
}
import extdeps.filesystem.filesystem_io
import extdeps.gunbc
import gunbc.session_lease {
  ProcessPortScope,
  ProcessPortObservation,
  PortAbsent,
  PortObserved,
  PortObservationRefused,
  ProcessLeasePlan,
  Start,
  DrainMatchingStaleThenStart,
  classify_process_port_upsert,
}
import gunbc.host_effect { HostEffectTransport }
import gunbc.srv3_actuate_shell_paths { srv3_bmcweb_token_path }
import gunbc.systemd_run_transient { systemd_run_transient_read, SystemdRunTransientStarted, SystemdRunTransientRefused }
import gunbc.systemctl_stop_run { systemctl_stop_run, SystemctlStopped, SystemctlStopRefused }
import gunbc.systemctl_is_active_read { systemctl_is_active_read, UnitIsActiveCapture, UnitIsActiveCaptured, UnitIsActiveCaptureRefused }

data host_effect_nbd_proxy_serve_disposition: Disposition = Terminal {
  reason: "systemd transient-unit realize transport for Srv3NbdProxyServe (P6 Part 2; operator ruling 2026-07-14: no trap/&/$! ShellStmt vocabulary). Actuate side routes through gunbc.systemd_run_transient (RunTransient) and gunbc.systemctl_stop_run (Stop), both typed-argv dispatch over the cited extdeps.systemd.systemd_run / extdeps.systemd.systemctl authorities. Observe side routes through gunbc.systemctl_is_active_read (IsActive) against the transient unit name, which is this scope's identity anchor. Token bridge: start_units materializes BMCWEB session token from srv3_bmcweb_token_path via Filesystem.Read into websocat argv. Formerly host_effect_nbd_proxy_serve_dissolution_trigger / host_effect_nbd_proxy_serve_scaffold (WitnessBin systemd-run scaffolding + unconditional PortInaccessible observe stub); both conditions of that trigger are now met and it is retired in favor of this Terminal disposition."
}

data nbd_proxy_serve_expected_owner_label: NonEmptyStr = "gunbc-nbd-proxy" as NonEmptyStr

data nbd_proxy_serve_expected_process_fingerprint: NonEmptyStr = "gunbc-nbd-proxy" as NonEmptyStr

fn host_effect_nbd_proxy_serve_session_policy(lease_key: NonEmptyStr) -> TemporalEffectPolicy {
  HeldSessionLease { lease_key: lease_key }
}

fn host_effect_nbd_proxy_serve_session_policy_is_held_lease(lease_key: NonEmptyStr) -> Bool {
  match host_effect_nbd_proxy_serve_session_policy(lease_key: lease_key) {
    HeldSessionLease { lease_key: lk } => lk == lease_key
    PureRead => false
    CreateIfAbsent { content_key: _ } => false
    ReplaceIfStale { content_key: _ } => false
    UpsertScope { scope_key: _ } => false
    DestructiveOnce { approval_id: _, idempotency_key: _ } => false
  }
}

fn host_effect_nbd_proxy_serve_session_scope(intent: NbdProxyServeTransportIntent) -> ProcessPortScope {
  ProcessPortScope {
    listen_port: intent.local_nbd_port,
    expected_owner_label: nbd_proxy_serve_expected_owner_label,
    expected_process_fingerprint: nbd_proxy_serve_session_fingerprint(),
  }
}

type NbdProxyServeSessionBinding {
  intent: NbdProxyServeTransportIntent
  lease_key: NonEmptyStr
  scope: ProcessPortScope
  policy: TemporalEffectPolicy
}

fn host_effect_nbd_proxy_serve_session_binding(
  intent: NbdProxyServeTransportIntent,
  lease_key: NonEmptyStr,
) -> NbdProxyServeSessionBinding {
  NbdProxyServeSessionBinding {
    intent: intent,
    lease_key: lease_key,
    scope: host_effect_nbd_proxy_serve_session_scope(intent: intent),
    policy: host_effect_nbd_proxy_serve_session_policy(lease_key: lease_key),
  }
}

// String? rather than Bool: a caller composing several of these (start_units starts two units,
// drain_stale_units stops two) needs the REAL refusal reason from whichever leg failed, not a
// bare false that erases which unit and why -- the same distinction UnitStatusCapture/
// SystemdPropertyCapture make in the sibling read modules. Absent means "started/stopped".
fn host_effect_nbd_proxy_serve_systemd_run_transient(
  unit: NonEmptyStr,
  command_argv: List<String>,
  transport: HostEffectTransport,
) -> String? {
  match systemd_run_transient_read(transport: transport, unit: unit, command_argv: command_argv) {
    SystemdRunTransientStarted { stdout: _ } => Absent
    SystemdRunTransientRefused { reason: why } =>
      Present { value: concat(concat("unit ", unit as String), concat(": ", why)) }
  }
}

fn host_effect_nbd_proxy_serve_systemd_stop_unit(
  unit: NonEmptyStr,
  transport: HostEffectTransport,
) -> String? {
  match systemctl_stop_run(transport: transport, unit: unit) {
    SystemctlStopped { stdout: _ } => Absent
    SystemctlStopRefused { reason: why } =>
      Present { value: concat(concat("unit ", unit as String), concat(": ", why)) }
  }
}

// The transient unit name IS the identity anchor for this scope: nbd-proxy-{lease}-{role} is
// unique to "our" process, so IsActive on that exact unit is sufficient port/ownership evidence
// here without a ss/lsof port scan. pid: 0 and cmdline: the unit name are documented sentinels,
// not fabricated data -- classify_process_port (gunbc.session_lease) only inspects
// observed_port/process_fingerprint, never pid/cmdline, so the sentinel never reaches a decision.
fn host_effect_nbd_proxy_serve_observation_from_is_active_capture(
  scope: ProcessPortScope,
  websocat_unit: NonEmptyStr,
  capture: UnitIsActiveCapture,
) -> ProcessPortObservation {
  match capture {
    UnitIsActiveCaptured { state: _, active: active } =>
      if active {
        PortObserved {
          observed_port: scope.listen_port,
          pid: 0,
          cmdline: websocat_unit,
          process_fingerprint: scope.expected_process_fingerprint,
        }
      } else {
        PortAbsent
      }
    UnitIsActiveCaptureRefused { reason: why } =>
      PortObservationRefused { reason: why as NonEmptyStr }
  }
}

fn host_effect_nbd_proxy_serve_observe_port(
  scope: ProcessPortScope,
  transport: HostEffectTransport,
  websocat_unit: NonEmptyStr,
) -> ProcessPortObservation {
  host_effect_nbd_proxy_serve_observation_from_is_active_capture(
    scope: scope,
    websocat_unit: websocat_unit,
    capture: systemctl_is_active_read(transport: transport, unit: websocat_unit),
  )
}

// Named for the one transport that genuinely cannot observe (EmitArtifactThenThinRun): its typed
// dispatch refuses before any read-back is attempted, which now surfaces here as the real captured
// refusal reason (via PortObservationRefused / ObservationVerdict.UnknownRefused), never the fixed
// "port inaccessible" string -- that string means the port was observed and genuinely wrong, a
// different fact this predicate must not conflate with "could not observe."
fn host_effect_nbd_proxy_serve_apply_refuses_when_observe_unimplemented(
  binding: NbdProxyServeSessionBinding,
  transport: HostEffectTransport,
) -> Bool {
  match host_effect_nbd_proxy_serve_apply(binding: binding, transport: transport) {
    NbdProxyServeApplyRefused { reason: why } =>
      string_contains(s: why, pattern: "EmitArtifactThenThinRun")
    _ => false
  }
}

fn host_effect_nbd_proxy_serve_apply_classification(
  binding: NbdProxyServeSessionBinding,
  obs: ProcessPortObservation,
) -> UpsertClassification<ProcessLeasePlan> {
  classify_process_port_upsert(scope: binding.scope, obs: obs)
}

fn host_effect_nbd_proxy_serve_apply_refuses_foreign_port(
  binding: NbdProxyServeSessionBinding,
  obs: ProcessPortObservation,
) -> Bool {
  match host_effect_nbd_proxy_serve_apply_classification(binding: binding, obs: obs) {
    UpsertClassification { verdict: Conflict, decision: Refuse { reason: _ } } => true
    _ => false
  }
}

fn host_effect_nbd_proxy_serve_apply_drains_stale_matching(
  binding: NbdProxyServeSessionBinding,
  obs: ProcessPortObservation,
) -> Bool {
  match host_effect_nbd_proxy_serve_apply_classification(binding: binding, obs: obs) {
    UpsertClassification {
      verdict: Drifted,
      decision: Apply { plan: DrainMatchingStaleThenStart },
    } => true
    _ => false
  }
}

fn host_effect_nbd_proxy_serve_read_session_token() -> String? {
  let read = Filesystem.Read(path: srv3_bmcweb_token_path)
  match read.success {
    true =>
      match read.content != "" {
        true => Present { value: read.content }
        false => Absent
      }
    false => Absent
  }
}

fn host_effect_nbd_proxy_serve_websocat_argv_materialized(
  intent: NbdProxyServeTransportIntent,
  token: NonEmptyStr,
) -> List<String> {
  nbd_proxy_serve_websocat_argv(
    intent: nbd_proxy_serve_transport_intent(
      bmc_host: intent.bmc_host,
      session_token: token,
      ws_path: intent.ws_path,
      iso_path: intent.iso_path,
      local_nbd_port: intent.local_nbd_port,
    ),
  )
}

fn host_effect_nbd_proxy_serve_websocat_argv_materialized_omits_shell_env_ref(
  intent: NbdProxyServeTransportIntent,
  token: NonEmptyStr,
) -> Bool {
  let argv = host_effect_nbd_proxy_serve_websocat_argv_materialized(intent: intent, token: token)
  let surface = fold(
    argv,
    init: "",
    f: (acc, word) => if acc == "" { word } else { concat(acc, concat(" ", word)) },
  )
  string_contains(s: surface, pattern: token as String)
    && !string_contains(s: surface, pattern: "$BMCWEB_SESSION_TOKEN")
}

// String? here is the same real-reason-over-Bool move as the leaf functions above: the caller
// (host_effect_nbd_proxy_serve_apply) surfaces the ACTUAL typed refusal in
// NbdProxyServeApplyOutcome rather than a fixed "systemd-run transient start failed" string,
// and each leg (nbdkit unit, websocat unit, missing token) is attempted exactly once.
fn host_effect_nbd_proxy_serve_start_units(
  binding: NbdProxyServeSessionBinding,
  transport: HostEffectTransport,
) -> String? {
  let nbdkit_unit = nbd_proxy_serve_nbdkit_unit_name(lease_key: binding.lease_key)
  let websocat_unit = nbd_proxy_serve_websocat_unit_name(lease_key: binding.lease_key)
  match host_effect_nbd_proxy_serve_read_session_token() {
    Absent => Present { value: "BMCWEB session token absent" }
    Present { value: token } =>
      match host_effect_nbd_proxy_serve_systemd_run_transient(
        unit: nbdkit_unit,
        command_argv: nbd_proxy_serve_nbdkit_argv(intent: binding.intent),
        transport: transport,
      ) {
        Present { value: why } => Present { value: why }
        Absent =>
          host_effect_nbd_proxy_serve_systemd_run_transient(
            unit: websocat_unit,
            command_argv: host_effect_nbd_proxy_serve_websocat_argv_materialized(
              intent: binding.intent,
              token: token as NonEmptyStr,
            ),
            transport: transport,
          )
      }
  }
}

fn host_effect_nbd_proxy_serve_drain_stale_units(
  binding: NbdProxyServeSessionBinding,
  transport: HostEffectTransport,
) -> String? {
  match host_effect_nbd_proxy_serve_systemd_stop_unit(
    unit: nbd_proxy_serve_nbdkit_unit_name(lease_key: binding.lease_key),
    transport: transport,
  ) {
    Present { value: why } => Present { value: why }
    Absent =>
      host_effect_nbd_proxy_serve_systemd_stop_unit(
        unit: nbd_proxy_serve_websocat_unit_name(lease_key: binding.lease_key),
        transport: transport,
      )
  }
}

type NbdProxyServeApplyOutcome
  = NbdProxyServeApplyConverged { stdout: String }
  | NbdProxyServeApplyRefused { reason: String }

fn host_effect_nbd_proxy_serve_apply(
  binding: NbdProxyServeSessionBinding,
  transport: HostEffectTransport,
) -> NbdProxyServeApplyOutcome {
  let websocat_unit = nbd_proxy_serve_websocat_unit_name(lease_key: binding.lease_key)
  let obs = host_effect_nbd_proxy_serve_observe_port(scope: binding.scope, transport: transport, websocat_unit: websocat_unit)
  match host_effect_nbd_proxy_serve_apply_classification(binding: binding, obs: obs).decision {
    Noop =>
      NbdProxyServeApplyConverged {
        stdout: concat(
          "NbdProxyServeSessionReceipt: verdict=Converged unit=",
          websocat_unit as String,
        ),
      }
    Refuse { reason: why } =>
      NbdProxyServeApplyRefused { reason: why as String }
    Apply { plan: Start } =>
      match host_effect_nbd_proxy_serve_start_units(binding: binding, transport: transport) {
        Absent =>
          NbdProxyServeApplyConverged {
            stdout: concat(
              "NbdProxyServeSessionReceipt: verdict=Absent plan=Start unit=",
              websocat_unit as String,
            ),
          }
        Present { value: why } =>
          NbdProxyServeApplyRefused {
            reason: concat("nbd-proxy-serve: systemd-run transient start failed; fail-closed: ", why),
          }
      }
    Apply { plan: DrainMatchingStaleThenStart } =>
      match host_effect_nbd_proxy_serve_drain_stale_units(binding: binding, transport: transport) {
        Present { value: why } =>
          NbdProxyServeApplyRefused {
            reason: concat("nbd-proxy-serve: stale drain failed; fail-closed: ", why),
          }
        Absent =>
          match host_effect_nbd_proxy_serve_start_units(binding: binding, transport: transport) {
            Absent =>
              NbdProxyServeApplyConverged {
                stdout: concat(
                  "NbdProxyServeSessionReceipt: verdict=Drifted plan=DrainMatchingStaleThenStart unit=",
                  websocat_unit as String,
                ),
              }
            Present { value: why } =>
              NbdProxyServeApplyRefused {
                reason: concat("nbd-proxy-serve: restart after drain failed; fail-closed: ", why),
              }
          }
      }
  }
}

fn host_effect_nbd_proxy_serve_apply_with_observation(
  binding: NbdProxyServeSessionBinding,
  obs: ProcessPortObservation,
  transport: HostEffectTransport,
) -> NbdProxyServeApplyOutcome {
  match host_effect_nbd_proxy_serve_apply_classification(binding: binding, obs: obs).decision {
    Noop =>
      NbdProxyServeApplyConverged { stdout: "NbdProxyServeSessionReceipt: verdict=Converged" }
    Refuse { reason: why } =>
      NbdProxyServeApplyRefused { reason: why as String }
    Apply { plan: Start } =>
      match host_effect_nbd_proxy_serve_start_units(binding: binding, transport: transport) {
        Absent =>
          NbdProxyServeApplyConverged { stdout: "NbdProxyServeSessionReceipt: verdict=Absent plan=Start" }
        Present { value: why } =>
          NbdProxyServeApplyRefused {
            reason: concat("nbd-proxy-serve: systemd-run transient start failed; fail-closed: ", why),
          }
      }
    Apply { plan: DrainMatchingStaleThenStart } =>
      match host_effect_nbd_proxy_serve_drain_stale_units(binding: binding, transport: transport) {
        Present { value: why } =>
          NbdProxyServeApplyRefused {
            reason: concat("nbd-proxy-serve: stale drain failed; fail-closed: ", why),
          }
        Absent =>
          match host_effect_nbd_proxy_serve_start_units(binding: binding, transport: transport) {
            Absent =>
              NbdProxyServeApplyConverged {
                stdout: "NbdProxyServeSessionReceipt: verdict=Drifted plan=DrainMatchingStaleThenStart",
              }
            Present { value: why } =>
              NbdProxyServeApplyRefused {
                reason: concat("nbd-proxy-serve: restart after drain failed; fail-closed: ", why),
              }
          }
      }
  }
}
