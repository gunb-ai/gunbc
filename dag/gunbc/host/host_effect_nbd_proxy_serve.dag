  NbdProxyServeTransportIntent,
  nbd_proxy_serve_nbdkit_unit_name,
  nbd_proxy_serve_websocat_unit_name,
  nbd_proxy_serve_session_fingerprint,
  bmcweb_session_token_env_ref,
}
import extdeps.exec.command { ArgvCommand, argv_words }
import extdeps.systemd.systemd_run { SystemdRunCommandReady, SystemdRunCommandRefused, systemd_run_transient_unit_command }
import extdeps.tools.nbdkit { nbdkit_readonly_file_serve_command }
import extdeps.tools.websocat { websocat_nbd_proxy_bridge_command }
