module gunbc.host.host_effect_argv_stdio

import std.types { List, NonEmptyStr }
import std.algebra { list_map }
import std.decl_ref { decl_ref }
import std.roster_frontier { FrontierRow, frontier_row_decl }
import std.dissolution { unbound_dissolution }
import extdeps.exec.command { ArgvCommand, argv_words }
import extdeps.posix.process { PosixProcessStdio }
import gunbc.remote_shell_command {
  RemoteExecCommandOutcome,
  openssh_login_shell_interpretation,
  remote_exec_command_string_with_stdio,
}

// Carries an ArgvCommand and the posix.process stdio value into the OpenSSH login-shell render.
// Does not mint a second stdio type (DESIGN §3). LocalExec sets fds; this does not wrap LocalShell
// in `sh -c`.

fn argv_as_remote_words(command: ArgvCommand) -> List<NonEmptyStr> {
  list_map(xs: argv_words(command: command), f: fn(w) { w as NonEmptyStr })
}

fn host_effect_argv_stdio_remote_command(
  command: ArgvCommand,
  stdio: PosixProcessStdio,
) -> RemoteExecCommandOutcome {
  remote_exec_command_string_with_stdio(
    argv: argv_as_remote_words(command: command),
    stdio: stdio,
    interpretation: openssh_login_shell_interpretation,
  )
}

data s3c_launch_stdio_file_wiring_frontier_rows: List<FrontierRow> = [
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.host.host_effect_argv_stdio", decl_name: "host_effect_argv_stdio_remote_command"),
    reason: "S3c serving launch (gunbc.serving.serving_launch) does not consume this render; #14109 still refuses typed at gunbc.serving.serving_launch ServingDetachRefusedNoStdoutToFileRoute.",
    dissolution: unbound_dissolution(
      description: "TRIGGER: the #14109 S3c launch leg consumes host_effect_argv_stdio_remote_command so a detached ninfer-serve over FleetSsh has stdout and stderr set to a file. SUFFICIENT FOR: gunbc.serving.serving_launch ServingDetachRefusedNoStdoutToFileRoute dissolves. NOT satisfied by this render existing unused." as NonEmptyStr
    )
  )
]
