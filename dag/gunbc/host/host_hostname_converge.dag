// ONE HOST-GENERIC MODE THAT SETS AND READS BACK A HOST'S LINUX HOSTNAME, RUN FROM A PEER.
data gunbc_host_hostname_converge_scope_disposition: Disposition = std.disposition.Terminal {
  reason: "Peer-run hostname converge (gunbc.plans.fleet_machine_authority P8a). ONE host-generic mode for every machine, keyed end to end by the HostIdentity the selectors resolve to (gunbc.design_argument::root_generalization): no per-host target, no per-host branch, no per-host entry. It runs ON A PEER because the target's own fleet-converge job is pinned to the target's runner label, which the rename window renames out from under it — a job that must survive a rename cannot live on the machine being renamed. It reaches the target through the fleet's OWN reach model (fleet_probe_endpoint_for for the endpoint, the operator principal whose sudoers grant covers hostnamectl for the login, prepare_fleet_ssh_agent_context for the credential and the host-key anchor); no caller supplies a route. The plan fold is the SAME three-way fold the closed loop uses (host_identity_patch_from_intents through host_identity_plan_from_verdict), so the peer mode and the in-place loop cannot disagree about what a state means; what this module adds on top is a direction, a conflict that NAMES both sides, and a typed re-adopt step. It is not a second converge engine and does not own the base."
}

// THE MODE NAME IS HELD BY THE SUBJECT, not by the emitter, so the emitter consumes the mode instead
// of naming it (gunbc.design_argument::single_authority). gunbc.fleet.fleet_converge_workflow wires
// this string; no arm spells the mode name independently.
data hostname_converge_mode: NonEmptyStr = "hostname_converge"

// THE INPUTS ARE ENVIRONMENT INPUTS OF THE PEER JOB, named once here so the emitted step and the entry
// cannot drift apart (single authority). The executing peer is read from the dispatch, NEVER from the
// executor's own `hostname -s`: a runner reused across machines would otherwise report whichever box it
// happens to sit on rather than the box it was dispatched to run on.
//
// THREE VALUES, NOT FIVE. GitHub caps workflow_dispatch at 25 inputs and the fleet-converge file sits AT
// that cap (extdeps.github.actions workflow_dispatch_max_inputs, which cites GitHub's own documentation), so this mode declares none of
// its own: the two hosts arrive on the fields the file already has -- `host`, the executor, which is the
// PEER here, and `subject_host`, the host acted on, which is the TARGET -- and the intent arrives as one
// word on a free-text field the mode reuses. A fifth field would have been a 26th input, and a 26th input
// does not quietly go missing: GitHub refuses the whole file and every mode in it stops being dispatchable.
data hostname_converge_target_env_name: NonEmptyStr = "FLEET_CONVERGE_HOSTNAME_TARGET"
data hostname_converge_peer_env_name: NonEmptyStr = "FLEET_CONVERGE_HOSTNAME_PEER"
data hostname_converge_act_env_name: NonEmptyStr = "FLEET_CONVERGE_HOSTNAME_ACT"
data hostname_converge_attempt_env_name: NonEmptyStr = "FLEET_CONVERGE_HOSTNAME_ATTEMPT"
data hostname_converge_mode_env_name: NonEmptyStr = "GUNBC_HOSTNAME_CONVERGE_MODE"

// WHICH DISPATCH FIELD CARRIES WHICH VALUE, held beside the environment name each becomes. The input
// declaration, the emitted step env and the `if:` that gates a step all read these, so renaming a field
// moves all three together; a lock whose field name is a second copy of the text simply stops matching,
// with no type error anywhere, and the step it existed to guard either runs ungated or never runs at all.
data hostname_converge_target_input_name: NonEmptyStr = "subject_host"
data hostname_converge_peer_input_name: NonEmptyStr = "host"
data hostname_converge_act_input_name: NonEmptyStr = "transaction_nonce"

// THE WORD IS THE WHOLE INTENT, so no dispatch can mean two things at once. `converge` moves the live
// name to the registry's name; `rollback` puts the previous name back; `adopt` re-adopts the baseline.
// Anything else -- the empty field above all -- is a dry plan and nothing more, which is why an operator
// who touches nothing cannot move a hostname or a baseline. These words are the closed choice the form
// offers, the words the emitted `if:` compares, and the words the entries re-check for themselves: one
// source, so the word an operator can pick and the word that actuates cannot drift apart.
data hostname_converge_act_converge_value: NonEmptyStr = "converge"
data hostname_converge_act_rollback_value: NonEmptyStr = "rollback"
data hostname_converge_act_adopt_value: NonEmptyStr = "adopt"

data hostname_converge_act_options: List<String> = [
  "" as String,
  hostname_converge_act_converge_value as String,
  hostname_converge_act_rollback_value as String,
  hostname_converge_act_adopt_value as String,
]

fn hostname_converge_act_is_converge(value: String) -> Bool {
  value == (hostname_converge_act_converge_value as String)
}

fn hostname_converge_act_is_rollback(value: String) -> Bool {
  value == (hostname_converge_act_rollback_value as String)
}

fn hostname_converge_act_is_adopt(value: String) -> Bool {
  value == (hostname_converge_act_adopt_value as String)
}

// AN ACTUATING WORD is one that may write a hostname. Re-adopt writes a BASELINE, not a hostname, so it
// is deliberately NOT an actuation here: the read-back step reports an unchanged name as success only
// while no actuating word was given, and this is the predicate it asks (gunbc.design_argument::fail_closed
// -- a mode that claims to converge must not go green having not).
fn hostname_converge_act_is_actuation(value: String) -> Bool {
  hostname_converge_act_is_converge(value: value) || hostname_converge_act_is_rollback(value: value)
}

// THE WORD DECIDES WHICH WAY THE FOLD IS READ, so there is no separate direction field that could
// contradict it: `converge` is forward, `rollback` is back. A dispatch that carried a direction AND a
// lock word could ask for a rollback apply behind a forward gate -- two authorities over one intent.
fn hostname_converge_direction_of_act(value: String) -> HostnameConvergeDirection? {
  if hostname_converge_act_is_converge(value: value) {
    Present { value: Forward }
  } else {
    if hostname_converge_act_is_rollback(value: value) {
      Present { value: Rollback }
    } else {
      none
    }
  }
}

// THE READ-ONLY STEPS (dry plan, independent read-back) ask the FORWARD question when the dispatch carries
// no act word at all -- that is the default dispatch, and "would this converge, and to what" is the question
// it is asking. It is a DERIVATION of the same parser, not a second one: an empty word means forward, and a
// word that is neither of the two write words still refuses rather than being defaulted. A dispatch that
// says `rollback` gets to see what a rollback would do before it commits to one.
fn hostname_converge_planned_direction(value: String) -> HostnameConvergeDirection? {
  if value == "" {
    Present { value: Forward }
  } else {
    hostname_converge_direction_of_act(value: value)
  }
}

// THE REFUSALS THE LOCKS PRODUCE, written once. An operator staring at a red step needs the word that was
// missing and the field that carries it; a step that says only "not confirmed" sends them to read the
// workflow instead of the form.
fn hostname_converge_apply_lock_line(value: String) -> String {
  join(
    [
      "hostname_converge refused: the apply step requires `", hostname_converge_act_converge_value as String,
      "` or `", hostname_converge_act_rollback_value as String, "` in `", hostname_converge_act_env_name as String,
      "` (the dispatch input `", hostname_converge_act_input_name as String, "`) and this dispatch carried `", value,
      "`, so no hostnamectl write was attempted on any host\n",
    ],
    "",
  )
}

fn hostname_converge_readopt_lock_line(value: String) -> String {
  join(
    [
      "hostname_converge refused: the re-adopt step requires `", hostname_converge_act_adopt_value as String,
      "` in `", hostname_converge_act_env_name as String, "` (the dispatch input `",
      hostname_converge_act_input_name as String, "`) and this dispatch carried `", value,
      "`, so the committed baseline is untouched\n",
    ],
    "",
  )
}

// THE DIRECTION IS TYPED, not a name a dispatch may carry, and it is not even a field of its own: it is read
// out of the dispatched act word by `hostname_converge_direction_of_act` -- the one parser, so the workflow's
// lock and the write cannot be reading two different strings. The rename window's rollback is "put the
// previous name back", and the only previous name this code may write is the committed baseline. A
// free-string rollback target would let a dispatch name ANY hostname — the exact failure the
// opaque-handle regime retires (gunbc.design_argument::fail_closed). The wire spelling here is for receipts,
// not for dispatches: the word an operator picks is `converge`/`rollback`, and `forward` is no longer a word
// the mode admits at all.
type HostnameConvergeDirection
  = Forward
  | Rollback

fn hostname_converge_direction_wire(direction: HostnameConvergeDirection) -> NonEmptyStr {
  match direction {
    Forward => "forward" as NonEmptyStr
    Rollback => "rollback" as NonEmptyStr
  }
}

// WHICH SIDE THE FOLD GUARDS ON. Forward guards on the committed baseline and settles on the canonical
// name; rollback swaps them — it guards on the canonical name (the name the window put there) and
// settles back on the baseline (the name that was there before). One fold read two ways, which is why
// the rollback is the same code and not a second path that could drift from the first.
type HostnameConvergePair {
  guard: NonEmptyStr
  settle: NonEmptyStr
}

fn hostname_converge_pair(
  direction: HostnameConvergeDirection,
  base: NonEmptyStr,
  desired: NonEmptyStr,
) -> HostnameConvergePair {
  match direction {
    Forward => HostnameConvergePair { guard: base, settle: desired }
    Rollback => HostnameConvergePair { guard: desired, settle: base }
  }
}

// THE PLAN, typed, with the conflict carrying BOTH names. It drives the real fold
// (host_identity_patch_from_intents through host_identity_plan_from_verdict); it only refines the
// conflict arm, which structurally carries no names, into a refusal an operator can act on — the
// witness's third case is unreadable without them, and a refusal that does not name what it refused is
// a dead end rather than an instruction (gunbc.design_argument::fail_closed).
type HostnameConvergePlan
  = ConvergeApply { guard: NonEmptyStr, settle: NonEmptyStr }
  | ConvergeNoop { live: NonEmptyStr }
  | ConvergeConflict { live: NonEmptyStr, base: NonEmptyStr, desired: NonEmptyStr }

fn hostname_converge_plan(
  direction: HostnameConvergeDirection,
  base: NonEmptyStr,
  desired: NonEmptyStr,
  live: NonEmptyStr,
) -> HostnameConvergePlan {
  let pair = hostname_converge_pair(direction: direction, base: base, desired: desired)
  let verdict = host_identity_patch_from_intents(
    base_hostname: pair.guard as String,
    observed_hostname: live as String,
    desired_hostname: pair.settle as String,
  )
  match host_identity_plan_from_verdict(
    verdict: verdict,
    base: pair.guard as DnsLabel,
    desired: pair.settle as DnsLabel,
  ) {
    ApplyPlan { base: b, desired: d } => ConvergeApply { guard: b as NonEmptyStr, settle: d as NonEmptyStr }
    NoopPlan => ConvergeNoop { live: live }
    ConflictPlan { verdict: _ } => ConvergeConflict { live: live, base: base, desired: desired }
  }
}

fn hostname_converge_plan_is_apply(plan: HostnameConvergePlan) -> Bool {
  match plan {
    ConvergeApply { guard: _, settle: _ } => true
    ConvergeNoop { live: _ } => false
    ConvergeConflict { live: _, base: _, desired: _ } => false
  }
}

fn hostname_converge_plan_is_noop(plan: HostnameConvergePlan) -> Bool {
  match plan {
    ConvergeApply { guard: _, settle: _ } => false
    ConvergeNoop { live: _ } => true
    ConvergeConflict { live: _, base: _, desired: _ } => false
  }
}

fn hostname_converge_plan_is_conflict(plan: HostnameConvergePlan) -> Bool {
  match plan {
    ConvergeApply { guard: _, settle: _ } => false
    ConvergeNoop { live: _ } => false
    ConvergeConflict { live: _, base: _, desired: _ } => true
  }
}

fn hostname_converge_plan_wire(plan: HostnameConvergePlan) -> NonEmptyStr {
  match plan {
    ConvergeApply { guard: _, settle: _ } => "apply" as NonEmptyStr
    ConvergeNoop { live: _ } => "noop" as NonEmptyStr
    ConvergeConflict { live: _, base: _, desired: _ } => "conflict" as NonEmptyStr
  }
}

// THE PLAN IS STAMPED so the apply step can name the plan it acted on. The apply step refolds from a
// fresh live read and acts only on what THAT fold says; the stamp ties the two steps' records together
// in the log, so a name that moved between the steps shows up as two different stamps rather than a
// silent agreement.
fn hostname_converge_plan_stamp(
  target: HostIdentity,
  peer: HostIdentity,
  direction: HostnameConvergeDirection,
  plan: HostnameConvergePlan,
) -> NonEmptyStr {
  hostname_converge_plan_fold_text(target: target, peer: peer, direction: direction, plan: plan) as NonEmptyStr
}

fn hostname_converge_plan_fold_text(
  target: HostIdentity,
  peer: HostIdentity,
  direction: HostnameConvergeDirection,
  plan: HostnameConvergePlan,
) -> String {
  join(
    [
      "hostname_converge target=", target as String,
      " peer=", peer as String,
      " direction=", hostname_converge_direction_wire(direction: direction) as String,
      " plan=", hostname_converge_plan_wire(plan: plan) as String,
      " ", hostname_converge_plan_detail(plan: plan),
    ],
    "",
  )
}

fn hostname_converge_plan_detail(plan: HostnameConvergePlan) -> String {
  match plan {
    ConvergeApply { guard: g, settle: s } => join(["live=", g as String, " settles=", s as String], "")
    ConvergeNoop { live: l } => join(["live=", l as String, " is already the settled name", ""], "")
    ConvergeConflict { live: l, base: b, desired: d } =>
      join(
        [
          "live=", l as String,
          " matches neither base=", b as String,
          " nor desired=", d as String,
          "; the typed re-adopt step is the only thing that may move the baseline, and only once the live name",
          " is the desired name",
        ],
        "",
      )
  }
}

// EVERY REFUSAL IS TYPED AND CARRIES THE STATE THAT CAUSED IT, and resolution refuses BEFORE any
// effect: a target and a peer that are the same machine, a selector that resolves to nothing or to
// several hosts, a host with no committed baseline, a target with no bound compute host, a route the
// fleet's own reach model declines. The mode never guesses a route and never applies against an
// unresolved pair (gunbc.design_argument::fail_closed).
type HostnameConvergeRefusalCause
  = TargetSelectorUnknown { selector: String }
  | TargetSelectorAmbiguous { selector: String, candidates: List<DnsLabel> }
  | TargetSelectorRefused { selector: String, key: String }
  | PeerSelectorUnknown { selector: String }
  | PeerSelectorAmbiguous { selector: String, candidates: List<DnsLabel> }
  | PeerSelectorRefused { selector: String, key: String }
  | ActWordUnknown { raw: String }
  | PeerIsTarget { host: NonEmptyStr }
  | TargetHostUnbound { host: NonEmptyStr }
  | NoCommittedBaseline { host: NonEmptyStr }
  | DesiredNameUnreadable { host: NonEmptyStr }
  | SshAgentContextRefused { reason: String }
  | SshRouteRefused { host: NonEmptyStr, endpoint: String }
  | LiveNameUnreadable { host: NonEmptyStr }

type HostnameConvergeRequest {
  target: HostIdentity
  peer: HostIdentity
  direction: HostnameConvergeDirection
  base: DeployedIntentV0
  desired: DeployedIntentV1
  access: DeployAccess
  control_plane: NodeControlPlane
  transport: HostEffectTransport
}

type HostnameConvergeResolution
  = PairResolved { request: HostnameConvergeRequest }
  | ResolutionRefused { cause: HostnameConvergeRefusalCause }

fn hostname_converge_refusal_wire(cause: HostnameConvergeRefusalCause) -> NonEmptyStr {
  match cause {
    TargetSelectorUnknown { selector: _ } => "target-selector-unknown" as NonEmptyStr
    TargetSelectorAmbiguous { selector: _, candidates: _ } => "target-selector-ambiguous" as NonEmptyStr
    TargetSelectorRefused { selector: _, key: _ } => "target-selector-refused" as NonEmptyStr
    PeerSelectorUnknown { selector: _ } => "peer-selector-unknown" as NonEmptyStr
    PeerSelectorAmbiguous { selector: _, candidates: _ } => "peer-selector-ambiguous" as NonEmptyStr
    PeerSelectorRefused { selector: _, key: _ } => "peer-selector-refused" as NonEmptyStr
    ActWordUnknown { raw: _ } => "act-word-unknown" as NonEmptyStr
    PeerIsTarget { host: _ } => "peer-is-target" as NonEmptyStr
    TargetHostUnbound { host: _ } => "target-host-unbound" as NonEmptyStr
    NoCommittedBaseline { host: _ } => "no-committed-baseline" as NonEmptyStr
    DesiredNameUnreadable { host: _ } => "desired-name-unreadable" as NonEmptyStr
    SshAgentContextRefused { reason: _ } => "ssh-agent-context-refused" as NonEmptyStr
    SshRouteRefused { host: _, endpoint: _ } => "ssh-route-refused" as NonEmptyStr
    LiveNameUnreadable { host: _ } => "live-name-unreadable" as NonEmptyStr
  }
}

fn hostname_converge_refusal_reason(cause: HostnameConvergeRefusalCause) -> String {
  match cause {
    TargetSelectorUnknown { selector: s } =>
      join(["no fleet host answers the target selector `", s, "`", ""], "")
    TargetSelectorAmbiguous { selector: s, candidates: c } =>
      join(
        [
          "the target selector `", s, "` answers ", hostname_converge_candidate_count_text(candidates: c),
          " fleet hostnames, so no host is picked",
          "",
        ],
        "",
      )
    TargetSelectorRefused { selector: s, key: k } =>
      join(
        [
          "the machine registry refuses every read because two rows claim the key `", k, "`; the target selector `", s,
          "` therefore resolves to no host at all -- it is not Unknown, and nothing is picked until the registry is fixed",
          "",
        ],
        "",
      )
    PeerSelectorUnknown { selector: s } =>
      join(["no fleet host answers the executing-peer selector `", s, "`", ""], "")
    PeerSelectorAmbiguous { selector: s, candidates: c } =>
      join(
        [
          "the executing-peer selector `", s, "` answers ", hostname_converge_candidate_count_text(candidates: c),
          " fleet hostnames, so no peer is picked",
          "",
        ],
        "",
      )
    PeerSelectorRefused { selector: s, key: k } =>
      join(
        [
          "the machine registry refuses every read because two rows claim the key `", k, "`; the executing-peer selector `", s,
          "` therefore resolves to no peer at all -- it is not Unknown, and nothing is picked until the registry is fixed",
          "",
        ],
        "",
      )
    ActWordUnknown { raw: r } =>
      join(
        [
          "`", r, "` is not an act word: `", hostname_converge_act_input_name as String, "` admits `",
          hostname_converge_act_converge_value as String, "` (write the canonical name), `",
          hostname_converge_act_rollback_value as String, "` (write the committed baseline back) or `",
          hostname_converge_act_adopt_value as String, "` (re-adopt the baseline), and the mode writes nothing",
          " to a hostname on a word it does not have", "",
        ],
        "",
      )
    PeerIsTarget { host: h } =>
      join(
        [
          "the executing peer is the target `", h, "` itself: this mode exists because the target's own",
          " fleet-converge job is pinned to the runner label the rename window renames, so a run on the",
          " target cannot be the run that renames it",
          "",
        ],
        "",
      )
    TargetHostUnbound { host: h } =>
      join(["the target `", h, "` has no bound fleet compute host, so it has no control-plane cell to converge", ""], "")
    NoCommittedBaseline { host: h } =>
      join(
        [
          "the target `", h, "` has no committed DeployedIntentV0 baseline row, so the three-way merge has no",
          " base; the mode refuses rather than adopting a live read as the base on its own",
          "",
        ],
        "",
      )
    DesiredNameUnreadable { host: h } =>
      join(["the canonical hostname of the target `", h, "` is not readable from the hostname allocation, so there is no name to converge to", ""], "")
    SshAgentContextRefused { reason: r } =>
      join(["the fleet ssh credential and host-key anchor could not be prepared on the peer: ", r, ""], "")
    SshRouteRefused { host: h, endpoint: e } =>
      join(["the fleet reach model has no ssh target for the target `", h, "` at the endpoint it probes (`", e, "`)", ""], "")
    LiveNameUnreadable { host: h } =>
      join(["the live hostname of the target `", h, "` did not answer, so no state can be folded", ""], "")
  }
}

fn hostname_converge_candidate_count_text(candidates: List<DnsLabel>) -> String {
  if candidates.length() == 1 {
    "one"
  } else {
    if candidates.length() == 2 {
      "two"
    } else {
      nat_to_decimal_string(value: candidates.length())
    }
  }
}

// WHICH TWO MACHINES THIS DISPATCH IS ABOUT. One law, read twice: the dispatch gate that runs in `build`
// and every step of the converge job both come through here, so a pair the gate waved through cannot be
// refused later by the job it was queued for -- and a pair the gate refused never reaches a runs-on
// expression that no runner satisfies (gunbc.design_argument::single_authority). A refused selector is
// named before anything is opened, and a peer that is the target is refused here, not downstream.
type HostnameConvergeSelection
  = PairSelected { target: HostIdentity, peer: HostIdentity }
  | PairUnresolved { cause: HostnameConvergeRefusalCause }

fn hostname_converge_select(
  target_selector: String,
  peer_selector: String,
) -> HostnameConvergeSelection {
  match resolve_host_selector(selector: target_selector) {
    HostSelectorUnknown { selector: s } => PairUnresolved { cause: TargetSelectorUnknown { selector: s } }
    HostSelectorAmbiguous { selector: s, candidates: c } =>
      PairUnresolved { cause: TargetSelectorAmbiguous { selector: s, candidates: c } }
    HostSelectorRegistryRefused { key: k } =>
      PairUnresolved { cause: TargetSelectorRefused { selector: target_selector, key: k } }
    HostSelectorResolved { host: target } =>
      match resolve_host_selector(selector: peer_selector) {
        HostSelectorUnknown { selector: s } => PairUnresolved { cause: PeerSelectorUnknown { selector: s } }
        HostSelectorAmbiguous { selector: s, candidates: c } =>
          PairUnresolved { cause: PeerSelectorAmbiguous { selector: s, candidates: c } }
        HostSelectorRegistryRefused { key: k } =>
          PairUnresolved { cause: PeerSelectorRefused { selector: peer_selector, key: k } }
        HostSelectorResolved { host: peer } =>
          if target == peer {
            PairUnresolved { cause: PeerIsTarget { host: target as NonEmptyStr } }
          } else {
            PairSelected { target: target, peer: peer }
          }
      }
  }
}

// RESOLVE THE PAIR, then derive everything else from the two resolved identities: the route is opened
// only for a host that has BOTH a committed baseline and a readable canonical name. There are two entry
// shapes and they differ in ONE thing -- how much they let the dispatched word decide. The apply may only be
// reached with an actuating word, so its resolver parses strictly; the read-only steps may be reached with no
// word and read that as forward. Splitting them by name, rather than by a flag some caller could pass wrong,
// keeps "the apply ran on a defaulted direction" off the table, and both shapes land on the same parser.
fn hostname_converge_resolve_apply(
  target_selector: String,
  peer_selector: String,
  act: String,
  attempt_raw: String,
) -> HostnameConvergeResolution {
  hostname_converge_resolve_with_direction(
    direction_of: hostname_converge_direction_of_act(value: act),
    act: act,
    target_selector: target_selector,
    peer_selector: peer_selector,
    attempt_raw: attempt_raw,
  )
}

fn hostname_converge_resolve_plan(
  target_selector: String,
  peer_selector: String,
  act: String,
  attempt_raw: String,
) -> HostnameConvergeResolution {
  hostname_converge_resolve_with_direction(
    direction_of: hostname_converge_planned_direction(value: act),
    act: act,
    target_selector: target_selector,
    peer_selector: peer_selector,
    attempt_raw: attempt_raw,
  )
}

fn hostname_converge_resolve_with_direction(
  direction_of: HostnameConvergeDirection?,
  act: String,
  target_selector: String,
  peer_selector: String,
  attempt_raw: String,
) -> HostnameConvergeResolution {
  match direction_of {
    Absent => ResolutionRefused { cause: ActWordUnknown { raw: act } }
    Present { value: direction } =>
      match hostname_converge_select(target_selector: target_selector, peer_selector: peer_selector) {
        PairUnresolved { cause: c } => ResolutionRefused { cause: c }
        PairSelected { target: target, peer: peer } =>
          hostname_converge_resolve_pair(
            target: target,
            peer: peer,
            direction: direction,
            attempt_raw: attempt_raw,
          )
      }
  }
}

fn hostname_converge_resolve_pair(
  target: HostIdentity,
  peer: HostIdentity,
  direction: HostnameConvergeDirection,
  attempt_raw: String,
) -> HostnameConvergeResolution {
  match fleet_compute_host_for_identity(identity: target) {
    Absent => ResolutionRefused { cause: TargetHostUnbound { host: target as NonEmptyStr } }
    Present { value: host } => hostname_converge_bind(
      target: target,
      peer: peer,
      direction: direction,
      host: host,
      attempt_raw: attempt_raw,
    )
  }
}

fn hostname_converge_bind(
  target: HostIdentity,
  peer: HostIdentity,
  direction: HostnameConvergeDirection,
  host: ComputeHost,
  attempt_raw: String,
) -> HostnameConvergeResolution {
  match deployed_intent_v0_persisted_for_slot(fleet_slot: target) {
    Absent => ResolutionRefused { cause: NoCommittedBaseline { host: target as NonEmptyStr } }
    Present { value: base } =>
      match deployed_intent_v1_from_fleet_slot(fleet_slot: target, target_host: host) {
        Absent => ResolutionRefused { cause: DesiredNameUnreadable { host: target as NonEmptyStr } }
        Present { value: desired } =>
          hostname_converge_open_route(
            target: target,
            peer: peer,
            direction: direction,
            base: base,
            desired: desired,
            host: host,
            attempt_raw: attempt_raw,
          )
      }
  }
}

// THE ROUTE IS DERIVED, NOT SUPPLIED. The endpoint is the one the fleet probes for this host; the login
// is the operator principal whose sudoers grant covers `/usr/bin/hostnamectl set-hostname` (the fleet
// probe principal deliberately carries no sudo, so it cannot be the principal that sets a name); the
// credential and the host-key anchor come from the fleet's own agent preparation. Nothing here takes a
// target string from a caller.
fn hostname_converge_open_route(
  target: HostIdentity,
  peer: HostIdentity,
  direction: HostnameConvergeDirection,
  base: DeployedIntentV0,
  desired: DeployedIntentV1,
  host: ComputeHost,
  attempt_raw: String,
) -> HostnameConvergeResolution {
  match prepare_fleet_ssh_agent_context(attempt_raw: attempt_raw) {
    FleetSshContextRefused { cause: c } => ResolutionRefused { cause: SshAgentContextRefused { reason: c } }
    FleetSshContextReady { context: context, receipt: _ } =>
      hostname_converge_bind_transport(
        target: target,
        peer: peer,
        direction: direction,
        base: base,
        desired: desired,
        host: host,
        context: context,
      )
  }
}

fn hostname_converge_bind_transport(
  target: HostIdentity,
  peer: HostIdentity,
  direction: HostnameConvergeDirection,
  base: DeployedIntentV0,
  desired: DeployedIntentV1,
  host: ComputeHost,
  context: FleetSshExecutionContext,
) -> HostnameConvergeResolution {
  let endpoint = fleet_probe_endpoint_for(host: target as String)
  match fleet_ssh_target_at_standard_port(endpoint: endpoint, principal: host_identity_operator_principal_name()) {
    SshTargetRefused { endpoint: _, refusal: _ } =>
      ResolutionRefused { cause: SshRouteRefused { host: target as NonEmptyStr, endpoint: endpoint } }
    SshTargetResolved { target: ssh_target } =>
      PairResolved {
        request: hostname_converge_request(
          target: target,
          peer: peer,
          direction: direction,
          base: base,
          desired: desired,
          host: host,
          transport: FleetSsh { target: ssh_target, context: context },
        ),
      }
  }
}

// ONE ACCESS CELL DERIVES the principal, its privileged-command grants, the control-plane cell and the
// transport, so the plan step, the apply step and the read-back cannot each assemble them differently.
fn hostname_converge_request(
  target: HostIdentity,
  peer: HostIdentity,
  direction: HostnameConvergeDirection,
  base: DeployedIntentV0,
  desired: DeployedIntentV1,
  host: ComputeHost,
  transport: HostEffectTransport,
) -> HostnameConvergeRequest {
  let principal = fleet_posix_operator_principal()
  HostnameConvergeRequest {
    target: target,
    peer: peer,
    direction: direction,
    base: base,
    desired: desired,
    access: DeployAccess {
      principal: principal,
      host: host,
      transport: transport,
      privileged_commands: grounded_principal_privileged_commands(p: principal),
    },
    control_plane: HostOs { node: host },
    transport: transport,
  }
}

// THE LIVE NAME, read on demand. Each step calls this itself: the read-back is not the apply's return
// value and the apply's fold is not the plan step's fold, because a peer that read the name once and
// passed it along would be certifying its own write rather than the machine's state
// (gunbc.design_argument::witness_one_interface).
type HostnameConvergeLive
  = LiveRead { name: NonEmptyStr }
  | LiveRefused { cause: HostnameConvergeRefusalCause }

fn hostname_converge_live(request: HostnameConvergeRequest) -> HostnameConvergeLive {
  match host_identity_observation_live(
    target: request.control_plane,
    transport: request.transport,
    probed_at: clock_now_probed_at_or_unknown(),
  ) {
    Absent => LiveRefused { cause: LiveNameUnreadable { host: request.target as NonEmptyStr } }
    Present { value: obs } => LiveRead { name: obs.short_hostname as NonEmptyStr }
  }
}

fn hostname_converge_base_name(request: HostnameConvergeRequest) -> NonEmptyStr {
  deployed_intent_observed_short_hostname(d: request.base) as NonEmptyStr
}

fn hostname_converge_desired_name(request: HostnameConvergeRequest) -> NonEmptyStr {
  request.desired.desired_hostname_short as NonEmptyStr
}

fn hostname_converge_fold(request: HostnameConvergeRequest, live: NonEmptyStr) -> HostnameConvergePlan {
  hostname_converge_plan(
    direction: request.direction,
    base: hostname_converge_base_name(request: request),
    desired: hostname_converge_desired_name(request: request),
    live: live,
  )
}

// STEP ONE: THE DRY PLAN. It reads the live name and folds it; it never acts.
type HostnameConvergePlanStep
  = Planned { plan: HostnameConvergePlan, live: NonEmptyStr, stamp: NonEmptyStr }
  | PlanStepRefused { cause: HostnameConvergeRefusalCause }

fn hostname_converge_plan_step(request: HostnameConvergeRequest) -> HostnameConvergePlanStep {
  match hostname_converge_live(request: request) {
    LiveRefused { cause: c } => PlanStepRefused { cause: c }
    LiveRead { name: live } => hostname_converge_planned(request: request, live: live)
  }
}

fn hostname_converge_planned(request: HostnameConvergeRequest, live: NonEmptyStr) -> HostnameConvergePlanStep {
  let plan = hostname_converge_fold(request: request, live: live)
  Planned {
    plan: plan,
    live: live,
    stamp: hostname_converge_plan_stamp(
      target: request.target,
      peer: request.peer,
      direction: request.direction,
      plan: plan,
    ),
  }
}

// STEP TWO: THE WET APPLY. It refolds from ITS OWN live read and only then reaches for the effect, so
// the fold that authorizes a write is the fold over the state at write time. The apply is still gated
// twice more: `host_identity_apply_gated` refuses unless the plan is the Apply arm and the privilege
// verdict permits it, and the CAS inside the effect acts only while the live name still equals the
// guard the script was built under.
type HostnameConvergeApplyStep
  = ApplyDone { settle: NonEmptyStr, live_before: NonEmptyStr, converged: Bool }
  | ApplySkipped { plan: HostnameConvergePlan, live_before: NonEmptyStr, reason: String }
  | ApplyStepRefused { cause: HostnameConvergeRefusalCause }

fn hostname_converge_apply_step(request: HostnameConvergeRequest) -> HostnameConvergeApplyStep {
  match hostname_converge_live(request: request) {
    LiveRefused { cause: c } => ApplyStepRefused { cause: c }
    LiveRead { name: live_before } =>
      hostname_converge_apply_folded(
        request: request,
        plan: hostname_converge_fold(request: request, live: live_before),
        live_before: live_before,
      )
  }
}

fn hostname_converge_apply_folded(
  request: HostnameConvergeRequest,
  plan: HostnameConvergePlan,
  live_before: NonEmptyStr,
) -> HostnameConvergeApplyStep {
  if !hostname_converge_plan_is_apply(plan: plan) {
    ApplySkipped {
      plan: plan,
      live_before: live_before,
      reason: "the fold did not admit an apply, so no hostnamectl write was attempted",
    }
  } else {
    match hostname_converge_identity_plan(plan: plan) {
      Absent =>
        ApplySkipped {
          plan: plan,
          live_before: live_before,
          reason: "the admitted fold produced no effect cell, so nothing was attempted",
        }
      Present { value: identity_plan } =>
        match host_identity_apply_gated(
          access: request.access,
          target: request.control_plane,
          plan: identity_plan,
          transport: request.transport,
          fixture_actor: none,
        ) {
          Absent =>
            ApplySkipped {
              plan: plan,
              live_before: live_before,
              reason: "the gated apply refused the effect before running it",
            }
          Present { value: reconciliation } =>
            ApplyDone {
              settle: hostname_converge_settle_of(plan: plan),
              live_before: live_before,
              converged: reconciliation_converged(r: reconciliation),
            }
        }
    }
  }
}

// THE EFFECT CELL IS BUILT BY THE SHARED FOLD, not here: handing `host_identity_plan_from_verdict` a
// state whose live name equals its guard yields the Apply arm by construction, so the peer mode builds
// exactly the `SetHostnameCas` cell the in-place loop builds and cannot invent an effect of its own.
fn hostname_converge_identity_plan(plan: HostnameConvergePlan) -> HostIdentityPlan? {
  match plan {
    ConvergeApply { guard: g, settle: s } =>
      Present {
        value: host_identity_plan_from_verdict(
          verdict: host_identity_patch_from_intents(
            base_hostname: g as String,
            observed_hostname: g as String,
            desired_hostname: s as String,
          ),
          base: g as DnsLabel,
          desired: s as DnsLabel,
        ),
      }
    ConvergeNoop { live: _ } => none
    ConvergeConflict { live: _, base: _, desired: _ } => none
  }
}

// STEP THREE: THE INDEPENDENT READ-BACK. A fresh `hostname -s` over the transport, compared against
// the name the direction was supposed to settle on. It takes NO plan from the apply step: the settle a
// direction intends is derived from the same two committed names, so the read-back can be run on its
// own — including after an apply that never ran — and still say what the machine actually answers
// (gunbc.design_argument::witness_one_interface).
type HostnameConvergeReadBackStep
  = ReadBackDone { observed: NonEmptyStr, settle: NonEmptyStr, matches_settle: Bool }
  | ReadBackStepRefused { cause: HostnameConvergeRefusalCause }

fn hostname_converge_settle_for_direction(request: HostnameConvergeRequest) -> NonEmptyStr {
  match request.direction {
    Forward => hostname_converge_desired_name(request: request)
    Rollback => hostname_converge_base_name(request: request)
  }
}

fn hostname_converge_read_back_step(request: HostnameConvergeRequest) -> HostnameConvergeReadBackStep {
  match hostname_converge_live(request: request) {
    LiveRefused { cause: c } => ReadBackStepRefused { cause: c }
    LiveRead { name: observed } =>
      ReadBackDone {
        observed: observed,
        settle: hostname_converge_settle_for_direction(request: request),
        matches_settle: observed == hostname_converge_settle_for_direction(request: request),
      }
  }
}

fn hostname_converge_settle_of(plan: HostnameConvergePlan) -> NonEmptyStr {
  match plan {
    ConvergeApply { guard: _, settle: s } => s
    ConvergeNoop { live: l } => l
    ConvergeConflict { live: _, base: _, desired: _ } => "none" as NonEmptyStr
  }
}

// THE PEER LABEL IS ADMISSION-GATED BEFORE THE JOB IS SCHEDULED. The peer input is meaningful for one
// mode only, so it is `required: false`, and its value is interpolated into the job's runs-on — the
// same shape review 61950 found for the reset observer, where a dispatch that omitted it asked for a
// label set ending in an empty string, which no runner carries: the job queued to the backstop with no
// diagnostic. The gate therefore runs in a job that is always schedulable and refuses with a cause
// rather than declining quietly.
type HostnameConvergeDispatchAdmission
  = DispatchNotThisMode { mode: String }
  | DispatchAdmitted { mode: String, target: NonEmptyStr, peer: NonEmptyStr }
  | DispatchTargetUnnamed { mode: String, variable: String }
  | DispatchPeerUnnamed { mode: String, variable: String }
  | DispatchPairRefused { mode: String, cause: HostnameConvergeRefusalCause }

fn hostname_converge_dispatch_admission(
  mode_raw: String,
  target_raw: String,
  peer_raw: String,
) -> HostnameConvergeDispatchAdmission {
  if mode_raw != (hostname_converge_mode as String) {
    DispatchNotThisMode { mode: mode_raw }
  } else {
    if target_raw == "" {
      DispatchTargetUnnamed { mode: mode_raw, variable: hostname_converge_target_env_name as String }
    } else {
      if peer_raw == "" {
        DispatchPeerUnnamed { mode: mode_raw, variable: hostname_converge_peer_env_name as String }
      } else {
        match hostname_converge_select(target_selector: target_raw, peer_selector: peer_raw) {
          PairSelected { target: t, peer: p } =>
            DispatchAdmitted { mode: mode_raw, target: t as NonEmptyStr, peer: p as NonEmptyStr }
          PairUnresolved { cause: c } => DispatchPairRefused { mode: mode_raw, cause: c }
        }
      }
    }
  }
}

fn hostname_converge_dispatch_admission_line(admission: HostnameConvergeDispatchAdmission) -> String {
  match admission {
    DispatchNotThisMode { mode: m } => join(["hostname_converge dispatch admission: mode `", m, "` is not this mode; nothing to gate\n"], "")
    DispatchAdmitted { mode: m, target: t, peer: p } =>
      join(
        [
          "hostname_converge dispatch admission: mode `", m, "` converges target `", t, "` from executing peer `", p, "`\n",
        ],
        "",
      )
    DispatchTargetUnnamed { mode: m, variable: v } =>
      join(
        [
          "hostname_converge dispatch admission refused: mode `", m, "` was dispatched without naming the target (`",
          v, "` is empty). The mode converges ONE named fleet host and refuses to guess which\n",
        ],
        "",
      )
    DispatchPeerUnnamed { mode: m, variable: v } =>
      join(
        [
          "hostname_converge dispatch admission refused: mode `", m, "` was dispatched without naming its executing peer (`",
          v, "` is empty). The peer label is interpolated into this job's runs-on, so an unnamed peer asks",
          " for a label no runner carries and the job would queue to the backstop with no diagnostic; name a",
          " fleet host that is not the target\n",
        ],
        "",
      )
    DispatchPairRefused { mode: m, cause: c } =>
      join(
        [
          "hostname_converge dispatch admission refused: mode `", m, "` -- ",
          hostname_converge_refusal_reason(cause: c),
          " The gate applies the same law the converge job applies to the pair, checked before any runs-on",
          " expression is built; fix the dispatch, not the fleet\n",
        ],
        "",
      )
  }
}

// THE RECEIPT THIS MODE WRITES. A relative path under the checkout, like the reset-return attempt
// receipt beside it: the step uploads it whether the step passed or failed, because the refused run is
// the one somebody needs to read.
data hostname_converge_receipt_path: NonEmptyStr = "target/host-hostname-converge.txt"

// THE RE-ADOPT IS EXPLICIT AND TYPED, and it is the only thing in this mode allowed to move the
// baseline. It admits on exactly one state: the live name ALREADY IS the desired name, which is what a
// rename window looks like when the name was set by an earlier pass (or by hand) while the committed
// baseline is still the pre-rename value. On every other state it refuses, naming what it found —
// adopting a baseline the operator has not confirmed would fold an unverified name into the base the
// three-way merge trusts (gunbc.design_argument::fail_closed).
//
// The admitted outcome CARRIES THE DeployedIntentV0 the operator commits as the new row; it does not
// rewrite the committed row in place, so a re-adopt lands as a reviewed change like every other fact.
// That is what "must not silently overwrite the baseline" means in code: this function has no path to
// the committed data, only to a candidate the operator reviews.
type HostnameConvergeAdoptStep
  = Adopted { previous_base: NonEmptyStr, adopted: NonEmptyStr, candidate: DeployedIntentV0 }
  | AdoptRefused { live: NonEmptyStr, base: NonEmptyStr, desired: NonEmptyStr, reason: String }
  | AdoptReadRefused { cause: HostnameConvergeRefusalCause }

fn hostname_converge_readopt_step(request: HostnameConvergeRequest) -> HostnameConvergeAdoptStep {
  match hostname_converge_live(request: request) {
    LiveRefused { cause: c } => AdoptReadRefused { cause: c }
    LiveRead { name: live } =>
      hostname_converge_readopt_judged(request: request, live: live)
  }
}

// THE JUDGEMENT ITSELF, over the three names and nothing else — no transport, no request, no clock. It
// is what a witness can drive case by case (gunbc.design_argument::witness_one_interface), and it is the
// single place that decides whether a baseline may move.
type HostnameConvergeAdoptJudgement
  = Admits { previous_base: NonEmptyStr, adopted: NonEmptyStr }
  | Declines { live: NonEmptyStr, base: NonEmptyStr, desired: NonEmptyStr, reason: String }

fn hostname_converge_readopt_judge(
  base: NonEmptyStr,
  desired: NonEmptyStr,
  live: NonEmptyStr,
) -> HostnameConvergeAdoptJudgement {
  if live == desired {
    Admits { previous_base: base, adopted: live }
  } else {
    Declines {
      live: live,
      base: base,
      desired: desired,
      reason: "the live name is not the desired name, so it is not a confirmed target state and cannot become the baseline",
    }
  }
}

fn hostname_converge_readopt_judged(request: HostnameConvergeRequest, live: NonEmptyStr) -> HostnameConvergeAdoptStep {
  let base = hostname_converge_base_name(request: request)
  let desired = hostname_converge_desired_name(request: request)
  match hostname_converge_readopt_judge(base: base, desired: desired, live: live) {
    Admits { previous_base: p, adopted: a } =>
      Adopted {
        previous_base: p,
        adopted: a,
        candidate: deployed_intent_v0_adopt_observed_base(
          fleet_slot: request.target,
          target_host: request.desired.target_host,
          observation: HostIdentityObservation { short_hostname: a as String, probed_at: clock_now_probed_at_or_unknown() },
        ),
      }
    Declines { live: l, base: b, desired: d, reason: r } =>
      AdoptRefused { live: l, base: b, desired: d, reason: r }
  }
}

// THE WIRE LINES THE STEPS PRINT — one line per fact, so a log is a record an operator reads and a
// control asserts on. The plan stamp is what ties the apply's record back to the plan it acted on.
fn hostname_converge_plan_line(request: HostnameConvergeRequest, step: HostnameConvergePlanStep) -> String {
  match step {
    Planned { plan: plan, live: live, stamp: stamp } =>
      join(
        [
          "hostname_converge plan target=", request.target as String,
          " peer=", request.peer as String,
          " direction=", hostname_converge_direction_wire(direction: request.direction) as String,
          " kind=", hostname_converge_plan_wire(plan: plan) as String,
          " live=", live as String,
          " ", hostname_converge_plan_detail(plan: plan),
          " stamp=", stamp as String,
          "\n",
        ],
        "",
      )
    PlanStepRefused { cause: c } => hostname_converge_refusal_line(cause: c)
  }
}

fn hostname_converge_refusal_line(cause: HostnameConvergeRefusalCause) -> String {
  join(
    [
      "hostname_converge refused cause=", hostname_converge_refusal_wire(cause: cause) as String,
      " reason=", hostname_converge_refusal_reason(cause: cause),
      "\n",
    ],
    "",
  )
}

fn hostname_converge_apply_line(result: HostnameConvergeApplyStep) -> String {
  match result {
    ApplyDone { settle: s, live_before: before, converged: converged } =>
      join(
        [
          "hostname_converge applied settle=", s as String,
          " was=", before as String,
          " converged=", if converged { "true" } else { "false" },
          "\n",
        ],
        "",
      )
    ApplySkipped { plan: plan, live_before: before, reason: r } =>
      join(
        [
          "hostname_converge not-applied kind=", hostname_converge_plan_wire(plan: plan) as String,
          " was=", before as String,
          " reason=", r,
          "\n",
        ],
        "",
      )
    ApplyStepRefused { cause: c } => hostname_converge_refusal_line(cause: c)
  }
}

fn hostname_converge_read_back_line(result: HostnameConvergeReadBackStep) -> String {
  match result {
    ReadBackDone { observed: o, settle: s, matches_settle: m } =>
      join(
        [
          "hostname_converge read-back observed=", o as String,
          " settle=", s as String,
          " matches=", if m { "true" } else { "false" },
          "\n",
        ],
        "",
      )
    ReadBackStepRefused { cause: c } => hostname_converge_refusal_line(cause: c)
  }
}

fn hostname_converge_adopt_line(result: HostnameConvergeAdoptStep) -> String {
  match result {
    Adopted { previous_base: p, adopted: a, candidate: _ } =>
      join(
        [
          "hostname_converge re-adopt admitted previous_base=", p as String,
          " adopted=", a as String,
          " — the committed baseline is NOT rewritten by this run; commit the candidate row as the new",
          " DeployedIntentV0 for this host",
          "\n",
        ],
        "",
      )
    AdoptRefused { live: l, base: b, desired: d, reason: r } =>
      join(
        [
          "hostname_converge re-adopt refused live=", l as String,
          " base=", b as String,
          " desired=", d as String,
          " reason=", r,
          "\n",
        ],
        "",
      )
    AdoptReadRefused { cause: c } => hostname_converge_refusal_line(cause: c)
  }
}

// THE CLOSED CHOICE THE FORM OFFERS FOR THE INTENT is `hostname_converge_act_options`, built from the
// words themselves above: the empty value is the dry plan, and the three actuating words are the only
// ways to move a hostname or a baseline. It rides a free-text dispatch field rather than an InputChoice,
// because the field it reuses is shared with other modes -- which is why the ENTRIES re-check the word
// instead of trusting the form, and why the emitted `if:` compares the same words.

