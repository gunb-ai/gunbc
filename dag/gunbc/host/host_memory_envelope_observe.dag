  typed_argv_exec_over_fleet_ssh, TypedArgvExecOutcome, TypedArgvExecConverged, TypedArgvExecRefused, TypedArgvExecOverran,
  TypedArgvExecWireInconsistent, typed_argv_exec_wire_inconsistent_reason,
}

// READ-ONLY HOST MEMORY ENVELOPE. Modeled on gunbc.host.host_memory_observation
// HostMemAvailableObservation (host, totals, available) and extended with Swap, the active
// actions-runner@* count, and MemoryCurrent/High/Max/SwapMax for each top-level slice plus
// system-actions-runner.slice. No apply. gunbc.design_argument::selection_precedes_convergence: this is
// independent readback, not a converge verdict.

data host_memory_envelope_receipt_path: String = "target/host-memory-envelope-observe.txt"

// THE LIMIT'S PRINTED FORM HAS ONE HOME (extdeps.systemd::systemd_memory_limit_wire_label);
// this receipt only decides how its OWN receipt shows the empty (absent) arm, so a bare
// "memory_max=" can never read as a value.
fn host_memory_envelope_limit_label(limit: SystemdCgroupMemoryLimit) -> String {
  let label = systemd_memory_limit_wire_label(lim: limit)
  if label == "" { "(absent)" } else { label }
}

type SliceMemoryReading {
  slice_unit: NonEmptyStr
  memory_current: ByteSize
  memory_high: SystemdCgroupMemoryLimit
  memory_max: SystemdCgroupMemoryLimit
  memory_swap_max: SystemdCgroupMemoryLimit
  // Fail-SOFT by design: an unreadable events line never drops the slice's other readings (the limits
  // stand on their own reads); it names itself in the receipt instead.
  memory_events: CgroupMemoryEventsReading
}

type HostMemoryEnvelopeObservation {
  host: HostIdentity
  probed_at: NonEmptyStr
  mem_total: ByteSize
  mem_available: ByteSize
  swap_total: ByteSize
  swap_free: ByteSize
  active_runner_unit_count: Int
  slice_readings: List<SliceMemoryReading>
  standing: CitedFigureStanding
}

type HostMemoryEnvelopeObserveResult
  = HostMemoryEnvelopeObserved { observation: HostMemoryEnvelopeObservation }
  | HostMemoryEnvelopeRefused { host: HostIdentity, reason: String }

fn host_mem_available_projection(obs: HostMemoryEnvelopeObservation) -> HostMemAvailableObservation {
  HostMemAvailableObservation {
    host: obs.host,
    run_id: obs.probed_at,
    runner_unit: "host" as NonEmptyStr,
    host_total: obs.mem_total,
    mem_available: obs.mem_available,
  }
}

fn host_memory_envelope_from_meminfo(
  host: HostIdentity,
  probed_at: NonEmptyStr,
  meminfo: ProcMeminfo,
  active_runner_unit_count: Int,
  slice_readings: List<SliceMemoryReading>,
  standing: CitedFigureStanding,
) -> HostMemoryEnvelopeObservation {
  HostMemoryEnvelopeObservation {
    host: host,
    probed_at: probed_at,
    mem_total: kibibyte_to_byte_size(k: meminfo.mem_total),
    mem_available: kibibyte_to_byte_size(k: meminfo.mem_available),
    swap_total: kibibyte_to_byte_size(k: meminfo.swap_total),
    swap_free: kibibyte_to_byte_size(k: meminfo.swap_free),
    active_runner_unit_count: active_runner_unit_count,
    slice_readings: slice_readings,
    standing: standing,
  }
}

fn host_memory_envelope_from_meminfo_text(
  host: HostIdentity,
  probed_at: NonEmptyStr,
  meminfo_text: String,
  active_runner_unit_count: Int,
  slice_readings: List<SliceMemoryReading>,
  standing: CitedFigureStanding,
) -> HostMemoryEnvelopeObserveResult {
  match parse_proc_meminfo(text: meminfo_text) {
    MeminfoFieldAbsent { field: f } =>
      HostMemoryEnvelopeRefused {
        host: host,
        reason: concat("host_memory_envelope_observe: /proc/meminfo field absent: ", f as String),
      }
    MeminfoParsed { meminfo: m } =>
      HostMemoryEnvelopeObserved {
        observation: host_memory_envelope_from_meminfo(
          host: host,
          probed_at: probed_at,
          meminfo: m,
          active_runner_unit_count: active_runner_unit_count,
          slice_readings: slice_readings,
          standing: standing,
        ),
      }
  }
}

data runner_parent_slice_unit: NonEmptyStr = "system-actions-runner.slice" as NonEmptyStr

fn slice_hierarchy_depth(unit: NonEmptyStr) -> Nat? {
  match systemd_slice_cgroup_path(mount_point: "/" as NonEmptyStr, slice: unit) {
    SliceNameNotASlice { spelling: _ } => none
    SliceCgroupPath { path: _ } =>
      if (unit as String) == systemd_root_slice_name {
        let empty: List<String> = []
        Present { value: length(empty) }
      } else {
        let name = unit as String
        let stem = substring(s: name, start: 0, end: length(name) - length(systemd_slice_suffix))
        Present { value: length(systemd_slice_ancestor_names(stem: stem)) }
      }
  }
}

fn is_top_level_slice_unit(unit: NonEmptyStr) -> Bool {
  match slice_hierarchy_depth(unit: unit) {
    Absent => false
    Present { value: depth } =>
      let one: List<String> = ["."]
      depth == length(one)
  }
}

fn host_memory_envelope_includes_slice(unit: NonEmptyStr) -> Bool {
  is_top_level_slice_unit(unit: unit) || (unit as String) == (runner_parent_slice_unit as String)
}

fn slice_property_raw(unit: NonEmptyStr, property: SystemdUnitProperty) -> String? {
  match systemctl_show_property_read(transport: LocalShell, unit: unit, property: property) {
    SystemdPropertyCaptured { value: raw } => Present { value: raw }
    SystemdPropertyBlank => Present { value: "" }
    SystemdPropertyCaptureRefused { reason: _ } => none
  }
}

fn slice_limit_bytes(n: Int) -> SystemdCgroupMemoryLimit {
  MemoryLimitBytes { bytes: byte_size(count: n) }
}

fn slice_current_bytes(n: Int) -> ByteSize {
  byte_size(count: n)
}

fn slice_limit_from_property(unit: NonEmptyStr, property: SystemdUnitProperty) -> SystemdCgroupMemoryLimit? {
  match slice_property_raw(unit: unit, property: property) {
    Absent => none
    Present { value: raw } => Present { value: parse_systemd_memory_limit_show(raw: raw) }
  }
}

fn slice_memory_reading(
  slice_unit: NonEmptyStr,
  memory_current: ByteSize,
  memory_high: SystemdCgroupMemoryLimit,
  memory_max: SystemdCgroupMemoryLimit,
  memory_swap_max: SystemdCgroupMemoryLimit,
  memory_events: CgroupMemoryEventsReading,
) -> SliceMemoryReading {
  SliceMemoryReading {
    slice_unit: slice_unit,
    memory_current: memory_current,
    memory_high: memory_high,
    memory_max: memory_max,
    memory_swap_max: memory_swap_max,
    memory_events: memory_events,
  }
}

fn slice_current_bytes_from_unit(unit: NonEmptyStr) -> ByteSize? {
  match slice_limit_from_property(unit: unit, property: MemoryCurrent) {
    Absent => none
    Present { value: current } =>
      match current {
        MemoryLimitBytes { bytes: b } => Present { value: b }
        MemoryLimitUnbounded => none
        MemoryLimitAbsent => none
      }
  }
}

fn slice_memory_reading_from_unit(unit: NonEmptyStr) -> SliceMemoryReading? {
  match slice_current_bytes_from_unit(unit: unit) {
    Absent => none
    Present { value: current } =>
      match slice_limit_from_property(unit: unit, property: MemoryHigh) {
        Absent => none
        Present { value: high } =>
          match slice_limit_from_property(unit: unit, property: MemoryMax) {
            Absent => none
            Present { value: max } =>
              match slice_limit_from_property(unit: unit, property: MemorySwapMax) {
                Absent => none
                Present { value: swap } =>
                  Present {
                    value: slice_memory_reading(
                      slice_unit: unit,
                      memory_current: current,
                      memory_high: high,
                      memory_max: max,
                      memory_swap_max: swap,
                      // Fail-soft: a refused or blank events read names itself; it does not refuse the row.
                      memory_events: match slice_property_raw(unit: unit, property: MemoryEventsProperty) {
                        Absent => CgroupMemoryEventsUnreadable { detail: "the manager refused the MemoryEvents read" }
                        Present { value: raw } => parse_cgroup_memory_events_systemd_property(raw: raw)
                      },
                    )
                  }
              }
          }
      }
  }
}

fn observed_slice_readings_accumulate(
  acc: List<SliceMemoryReading>?,
  unit: NonEmptyStr,
) -> List<SliceMemoryReading>? {
  match acc {
    Absent => none
    Present { value: so_far } =>
      if !host_memory_envelope_includes_slice(unit: unit) {
        Present { value: so_far }
      } else {
        match slice_memory_reading_from_unit(unit: unit) {
          Absent => none
          Present { value: row } => Present { value: list_snoc_item(xs: so_far, item: row) }
        }
      }
  }
}

fn host_memory_envelope_observed_slice_readings() -> List<SliceMemoryReading>? {
  match systemctl_list_units_active_of_type(instance_glob: "*.slice" as NonEmptyStr, unit_type: "slice") {
    Absent => none
    Present { value: units } =>
      let empty: List<SliceMemoryReading> = []
      fold(units, init: Present { value: empty }, f: fn(acc, unit) {
        observed_slice_readings_accumulate(acc: acc, unit: unit)
      })
  }
}

fn host_memory_envelope_active_runner_count(host: HostIdentity) -> Int? {
  match systemctl_list_units_active_services(instance_glob: runner_instance_glob(host: host) as NonEmptyStr) {
    Absent => none
    Present { value: units } => Present { value: length(units) }
  }
}

fn host_memory_envelope_observe_local(host: HostIdentity) -> HostMemoryEnvelopeObserveResult {
  let read = linux.Procfs.ReadMeminfo()
  if !read.success {
    HostMemoryEnvelopeRefused { host: host, reason: "host_memory_envelope_observe: /proc/meminfo could not be read on this host" }
  } else {
    match host_memory_envelope_active_runner_count(host: host) {
      Absent =>
        HostMemoryEnvelopeRefused {
          host: host,
          reason: "host_memory_envelope_observe: actions-runner@* unit enumeration absent; fail-closed",
        }
      Present { value: n } =>
        match host_memory_envelope_observed_slice_readings() {
          Absent =>
            HostMemoryEnvelopeRefused {
              host: host,
              reason: "host_memory_envelope_observe: slice MemoryCurrent/High/Max/SwapMax read absent; fail-closed",
            }
          Present { value: slices } =>
            let probed = probed_at_word(reading: clock_now_probed_at())
            host_memory_envelope_from_meminfo_text(
              host: host,
              probed_at: probed,
              meminfo_text: read.value,
              active_runner_unit_count: n,
              slice_readings: slices,
              standing: TranscribedUncited {
                read_obligation: concat(
                  "host_memory_envelope_observe_local on this kernel at probed_at=",
                  probed as String,
                ) as NonEmptyStr,
              },
            )
        }
    }
  }
}

fn host_memory_envelope_receipt_text(obs: HostMemoryEnvelopeObservation) -> String {
  join([
    "host-memory-envelope host=",
    obs.host as String,
    " probed_at=",
    obs.probed_at as String,
    " mem_total=",
    to_string(byte_size_count(b: obs.mem_total)),
    " mem_available=",
    to_string(byte_size_count(b: obs.mem_available)),
    " swap_total=",
    to_string(byte_size_count(b: obs.swap_total)),
    " swap_free=",
    to_string(byte_size_count(b: obs.swap_free)),
    " active_runner_units=",
    to_string(obs.active_runner_unit_count),
    " slice_readings=",
    to_string(length(obs.slice_readings)),
    "\n",
    // THE SLICE DETAIL, one line per reading. The job's name promised these numbers and the receipt
    // printed only the count -- the memory.max and memory.events figures this PR's door diagnostic
    // exists to stop losing are the whole point of the envelope lane, so they ride the receipt.
    join(map(obs.slice_readings, r => join([
      "slice=", r.slice_unit as String,
      " memory_current=", to_string(byte_size_count(b: r.memory_current)),
      " memory_high=", host_memory_envelope_limit_label(limit: r.memory_high),
      " memory_max=", host_memory_envelope_limit_label(limit: r.memory_max),
      " memory_swap_max=", host_memory_envelope_limit_label(limit: r.memory_swap_max),
      " memory_events=", cgroup_memory_events_wire(reading: r.memory_events),
      "\n",
    ], "")), ""),
  ], "")
}

fn local_kernel_hostname() -> String {
  match hostname_short_read(transport: LocalShell) {
    HostnameShortCaptured { value: v } => v
    HostnameShortCaptureRefused { reason: _ } => ""
  }
}

// TODAY'S BEHAVIOUR, VERBATIM. host = subject: the machine the dispatch named in FLEET_CONVERGE_EXPECTED_HOST
// reads its OWN /proc locally (Procfs.ReadMeminfo), resolved through the allocation's selector join. This is
// the byte-identical path a host_memory_observe dispatch with no subject_host runs; the peer branch below is
// the ONLY new behaviour, so a self dispatch is untouched.
fn host_memory_envelope_observe_self_wet() -> ProcessExit
{
  let dispatched = match actions_variable_read(name: fleet_converge_expected_host_env_name) {
    ActionsVariablePresent { value: v } => v
    ActionsVariableAbsent { variable: _, detail: _ } => ""
  }
  if dispatched == "" {
    exit_failure(reason: concat(
      "host_memory_envelope_observe: ",
      fleet_converge_expected_host_env_name,
      " is unset; one host per run, named by the dispatch",
    ))
  } else {
    let kernel = local_kernel_hostname()
    // THE KERNEL'S ANSWER IS A NAME, NOT THE IDENTITY: it resolves through the allocation's selector
    // (gunbc.hostname_allocation::observed_host_selector_join), and the observation runs under the
    // RESOLVED identity. srv14 answers "butch" and is still srv14; the old string comparison refused
    // exactly that host, and a rename would refuse whichever host the name moves to next.
    match observed_host_selector_join(expected: dispatched, observed: kernel) {
      ObservedHostSelectorJoinRefused { cause: c } => exit_failure(reason: join([
        "host_memory_envelope_observe: ",
        observed_host_join_refusal_text(cause: c),
      ], ""))
      ObservedHostSelectorAgreed { host: identity } =>
        match host_memory_envelope_observe_local(host: identity) {
          HostMemoryEnvelopeRefused { host: _, reason: why } => exit_failure(reason: why)
          HostMemoryEnvelopeObserved { observation: obs } => {
            let text = host_memory_envelope_receipt_text(obs: obs)
            let w = Filesystem.Write(path: host_memory_envelope_receipt_path, content: text)
            if w.success == false {
              exit_failure(reason: join(["host_memory_envelope_observe: receipt write failed: ", w.error, "\n", text], ""))
            } else {
              ExitSuccess
            }
          }
        }
    }
  }
}

// PEER-EXECUTOR MEMORY READ (option (a), 2026-11-23). host_memory_observe now takes the same
// peer-executor shape the serving modes use: host = the executor runner, subject_host = the machine read
// over ssh. This is the branch that lets a runnerless host like srv14 (butch) get a quiescent memory read
// WITHOUT its own CI lane -- the executor (srv1) reads the subject's /proc/meminfo over fleet ssh. The
// receipt comes out in exactly the gunbc.host.host_memory_observation::HostMemAvailableQuiescentRead shape
// (host_total + mem_available) that gunbc.serving.serving_reservation's srv14 memory-charge frontier names
// as trigger (2). The self path above (host = subject, no subject_host named) is byte-for-byte today's
// behaviour; this branch is the ONLY new behaviour. gunbc.design_argument::fail_closed: an unreachable
// subject, a refused leg, a non-zero exit, or an absent field all REFUSE -- this path never reports a zero
// or absent memory figure for a host it could not actually read.
data host_memory_envelope_observe_attempt_raw: String = "host-memory-envelope-observe-ci"

data host_memory_quiescent_receipt_path: String = "target/host-memory-quiescent-observe.txt"

// The account that performed a peer read: fleet automation, reading the subject over ssh. Distinguished
// from a self read so the quiescent row cites who read it. The run id is the provenance, attached when the
// row is authored from this receipt.
data host_memory_quiescent_peer_account: NonEmptyStr = "fleet-automation-peer-executor" as NonEmptyStr

type HostMemQuiescentReadResult
  = HostMemQuiescentReadObserved { read: HostMemAvailableQuiescentRead, user_work_slice: PeerSliceEventsRead }
  | HostMemQuiescentReadRefused { host: HostIdentity, reason: String }

// THE SLICE'S CEILING AND ITS DEATH COUNTERS, read on the subject over the same ssh route as the
// meminfo pair. This is the block the job's name always promised and the receipt never carried:
// the two blind srv3 serving-child deaths left no account because the observe leg printed only
// host_total/mem_available. Field-fail-soft, leg-fail-closed: a leg that ran renders every field it
// could read and names the ones it could not; a leg that did not run at all refuses rather than
// printing a slice it did not see.
type PeerSliceEventsRead
  = PeerSliceObserved {
      slice_unit: NonEmptyStr,
      memory_max: SystemdCgroupMemoryLimit,
      // A CURRENT reading, not a limit: usage has no "infinity" -- if the manager ever prints that
      // for MemoryCurrent it is an unreadable reading, never an accepted standing
      // (gunbc.design_argument::single_authority; the sibling SliceMemoryReading carries ByteSize).
      memory_current: ByteSize?,
      memory_events: CgroupMemoryEventsReading
    }
  | PeerSliceUnreadable { slice_unit: NonEmptyStr, reason: String }

// ONE "systemctl show <slice> -p ..." line rendered back to its value: the token keyed "Key=", or
// absence. systemctl show prints a key the manager has no value for as "Key=" (empty), which the
// per-field parsers below already render as unreadable.
fn peer_show_field(lines: List<String>, key: NonEmptyStr) -> String? {
  match first_where(xs: lines, keep: ln => starts_with(s: ln, prefix: concat(key as String, "="))) {
    Absent => none
    Present { value: ln } => Present { value: substring(s: ln, start: length(key as String) + 1, end: length(ln)) }
  }
}

fn host_memory_quiescent_user_work_slice_over_ssh(
  target: SshTarget,
  context: FleetSshExecutionContext,
) -> PeerSliceEventsRead {
  match typed_argv_exec_over_fleet_ssh(
    target: target,
    context: context,
    argv: ["/bin/systemctl", "show", serving_child_slice_unit_name as String, "-p", "MemoryMax", "-p", "MemoryCurrent", "-p", "MemoryEvents"],
    kind: ProbeLeg,
  ) {
    TypedArgvExecRefused { reason: why } =>
      PeerSliceUnreadable { slice_unit: serving_child_slice_unit_name, reason: concat("the read leg was refused: ", why) }
    TypedArgvExecOverran { deadline: _ } =>
      PeerSliceUnreadable { slice_unit: serving_child_slice_unit_name, reason: "the read leg overran its ProbeLeg wall ceiling" }
    TypedArgvExecConverged { result: r } =>
      if r.exit_code != 0 {
        PeerSliceUnreadable { slice_unit: serving_child_slice_unit_name, reason: concat("systemctl show exited ", to_string(r.exit_code)) }
      } else {
        let lines = map(split(s: r.stdout, delimiter: "\n"), ln => trim(ln))
        PeerSliceObserved {
          slice_unit: serving_child_slice_unit_name,
          memory_max: match peer_show_field(lines: lines, key: "MemoryMax" as NonEmptyStr) {
            Absent => MemoryLimitAbsent
            Present { value: raw } => parse_systemd_memory_limit_show(raw: raw)
          },
          memory_current: match peer_show_field(lines: lines, key: "MemoryCurrent" as NonEmptyStr) {
            Absent => none
            Present { value: raw } =>
              match parse_systemd_memory_limit_show(raw: raw) {
                MemoryLimitBytes { bytes: b } => Present { value: b }
                MemoryLimitUnbounded => none
                MemoryLimitAbsent => none
              }
          },
          memory_events: match peer_show_field(lines: lines, key: "MemoryEvents" as NonEmptyStr) {
            Absent => CgroupMemoryEventsUnreadable { detail: "the manager printed no MemoryEvents line" }
            Present { value: raw } => parse_cgroup_memory_events_systemd_property(raw: raw)
          },
        }
      }
  }
}

// Read /proc/meminfo on the subject over fleet ssh (world-readable, so a plain cat, no sudo) and project
// the MemTotal/MemAvailable pair. Every failure mode refuses rather than yielding zero.
fn host_memory_quiescent_read_over_ssh(
  host: HostIdentity,
  target: SshTarget,
  context: FleetSshExecutionContext,
  account: NonEmptyStr,
) -> HostMemQuiescentReadResult {
  match typed_argv_exec_over_fleet_ssh(
    target: target,
    context: context,
    argv: ["/bin/cat", "/proc/meminfo"],
    kind: ProbeLeg,
  ) {
    TypedArgvExecRefused { reason: why } =>
      HostMemQuiescentReadRefused {
        host: host,
        reason: concat("host_memory_envelope_observe: ", host as String, " is unreachable over ssh; refusing to report memory (never a zero or an absent figure): ", why),
      }
    TypedArgvExecOverran { deadline: _ } =>
      HostMemQuiescentReadRefused {
        host: host,
        reason: concat("host_memory_envelope_observe: the read leg on ", host as String, " overran its ProbeLeg wall ceiling; refusing to report memory (never a zero or an absent figure)"),
      }
    TypedArgvExecWireInconsistent { fault: f } =>
      HostMemQuiescentReadRefused {
        host: host,
        reason: concat(concat("host_memory_envelope_observe: the read leg on ", host as String, " was dispatched but its reply arrived inconsistent; refusing to report memory (never a zero or an absent figure): "), typed_argv_exec_wire_inconsistent_reason(leg_hint: "host memory read", fault: f)),
      }
    TypedArgvExecConverged { result: r } =>
      if r.exit_code != 0 {
        HostMemQuiescentReadRefused {
          host: host,
          reason: concat("host_memory_envelope_observe: cat /proc/meminfo on ", host as String, " exited ", to_string(r.exit_code), "; refusing to report memory (never a zero or an absent figure)"),
        }
      } else {
        match parse_proc_meminfo(text: r.stdout) {
          MeminfoFieldAbsent { field: f } =>
            HostMemQuiescentReadRefused {
              host: host,
              reason: concat("host_memory_envelope_observe: /proc/meminfo field absent on ", host as String, ": ", f as String),
            }
          MeminfoParsed { meminfo: m } =>
            HostMemQuiescentReadObserved {
              read: HostMemAvailableQuiescentRead {
                host: host,
                account: account,
                read_at: probed_at_word(reading: clock_now_probed_at()),
                host_total: kibibyte_to_byte_size(k: m.mem_total),
                mem_available: kibibyte_to_byte_size(k: m.mem_available),
              },
              user_work_slice: host_memory_quiescent_user_work_slice_over_ssh(target: target, context: context),
            }
        }
      }
  }
}

fn host_memory_quiescent_receipt_text(read: HostMemAvailableQuiescentRead, user_work_slice: PeerSliceEventsRead) -> String {
  let slice_part = match user_work_slice {
    PeerSliceObserved { slice_unit: unit, memory_max: max, memory_current: current, memory_events: events } =>
      join([
        "\nslice=", unit as String,
        " memory_max=", host_memory_envelope_limit_label(limit: max),
        " memory_current=", match current { Present { value: b } => to_string(byte_size_count(b: b))  Absent => "unreadable(MemoryCurrent)" },
        " memory_events=", cgroup_memory_events_wire(reading: events),
      ], "")
    PeerSliceUnreadable { slice_unit: unit, reason: why } =>
      join(["\nslice=", unit as String, " memory_events=unreadable(", why, ")"], "")
  }
  join([
    "host-memory-quiescent host=", read.host as String,
    " account=", read.account as String,
    " read_at=", read.read_at as String,
    " host_total=", to_string(byte_size_count(b: read.host_total)),
    " mem_available=", to_string(byte_size_count(b: read.mem_available)),
    slice_part,
    "\n",
  ], "")
}

// Resolve the subject's anchored ssh target, prepare the fleet ssh context (credential, then anchor --
// one preparation, the order the serving route states), and read the subject's memory over it. A subject
// the anchor does not name, or a context that cannot be prepared, REFUSES -- the dispatch never guesses a
// host and never reports memory it did not read. Split out from the wet so the fail-closed refusal on an
// unreachable subject is a witness claim, not only a CI exit code.
fn host_memory_quiescent_read_for_subject(hi: HostIdentity) -> HostMemQuiescentReadResult {
  match administrator_ssh_target(host: hi) {
    SshTargetRefused { endpoint: e, refusal: _ } =>
      HostMemQuiescentReadRefused {
        host: hi,
        reason: concat("host_memory_envelope_observe: no anchored ssh target for subject ", e, "; refusing to read a host the anchor does not name"),
      }
    SshTargetResolved { target: target } =>
      match prepare_fleet_ssh_agent_context(attempt_raw: host_memory_envelope_observe_attempt_raw) {
        FleetSshContextRefused { cause: c } => HostMemQuiescentReadRefused { host: hi, reason: c }
        FleetSshContextReady { context: context, receipt: _ } =>
          host_memory_quiescent_read_over_ssh(host: hi, target: target, context: context, account: host_memory_quiescent_peer_account)
      }
  }
}

fn host_memory_envelope_observe_peer_wet(subject: String) -> ProcessExit {
  let hi = subject as HostIdentity
  match host_memory_quiescent_read_for_subject(hi: hi) {
    HostMemQuiescentReadRefused { host: _, reason: why } => exit_failure(reason: concat(why, "\n"))
    HostMemQuiescentReadObserved { read: read } => {
      let text = host_memory_quiescent_receipt_text(read: read)
      // Two carriers, two consumers, one observation: the envelope path is host_memory_observe's canonical
      // step-gated receipt (what the step script cats after the wet, identical to the self read -- the peer
      // read is the SAME mode, so its receipt lands at the same place the step checks); the quiescent path is
      // the frontier-named artifact that carries srv14's post-retirement MemAvailable reading (upload step).
      let w = Filesystem.Write(path: host_memory_quiescent_receipt_path, content: text)
      let we = Filesystem.Write(path: host_memory_envelope_receipt_path, content: text)
      if w.success == false {
        exit_failure(reason: join(["host_memory_envelope_observe: quiescent receipt write failed: ", w.error, "\n", text], ""))
      } else if we.success == false {
        exit_failure(reason: join(["host_memory_envelope_observe: envelope receipt write failed: ", we.error, "\n", text], ""))
      } else {
        ExitSuccess
      }
    }
  }
}

// THE DISPATCH: a subject_host named in FLEET_CONVERGE_SUBJECT_HOST routes the read over ssh to that
// machine (the peer-executor shape); no subject named means today's self read, byte-for-byte.
fn host_memory_envelope_observe_ci_wet() -> ProcessExit {
  match actions_variable_read(name: fleet_converge_subject_host_env_name) {
    ActionsVariablePresent { value: subject } =>
      if subject == "" {
        host_memory_envelope_observe_self_wet()
      } else {
        host_memory_envelope_observe_peer_wet(subject: subject)
      }
    ActionsVariableAbsent { variable: _, detail: _ } =>
      host_memory_envelope_observe_self_wet()
  }
}

