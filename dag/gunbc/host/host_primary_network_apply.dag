// CONVERGING A HOST'S PRIMARY NETWORK WITHOUT LOSING ITS ONLY UPLINK.
//
// The host-file core (gunbc.runner.runner_host_file_converge, the FleetHostFileSubject route) writes
// every file here: the cloud-init guard in place, and the netplan file and the scripts below into a
// root-only staging directory. The netplan file is never written into /etc/netplan by the core,
// because a file written there is applied at the next generate whether or not it works. It reaches
// /etc/netplan only inside a `netplan try`, which reverts the running network unless it is confirmed.
//
// netplan try's revert does not restore /etc/netplan (extdeps.netplan.netplan
// netplan_try_revert_restores), so the try runs inside a wrapper that keeps the prior directory and
// restores it unless netplan itself reports the configuration accepted. The wrapper runs as a
// transient systemd unit, so the timer outlives the SSH leg that started it, and its stdin is a FIFO
// it opens read-write, because netplan try on an end-of-file stdin reverts at once
// (NetplanTryStdin). A second converge while one runs refuses at launch: systemd-run refuses a unit
// name already loaded.
//
// THE CONFIRMATION IS EARNED OVER A FRESH CONNECTION. Every leg runs as the administrator principal,
// whose session is the password session, shaped with ControlPath none
// (gunbc.fleet.fleet_known_hosts_anchor fleet_ssh_password_client_options): no leg rides an earlier
// connection, so a leg that reaches the host after the try has applied proves the new network
// accepts a new connection. The readback then judges the running network against the row and the
// directory against the population, exactly as the plan does, and only a Settled readback writes the
// newline that confirms. A host that cannot be reached is never confirmed, and netplan's timeout
// restores it.
//
// OUTSIDE THE MODELED GUARANTEE: a reboot or power loss inside the try window boots the unconfirmed
// files, with the prior directory kept on disk in the staging directory; recovery is the BMC serial
// console, the route the operator used for the hand move.

data primary_network_staging_dir: NonEmptyStr = "/etc/gunbc/primary-network" as NonEmptyStr
data primary_network_try_unit: NonEmptyStr = "gunbc-primary-network-try" as NonEmptyStr

// Long enough for the await bounds below (60 s for the ready stamp, 60 s for wait-online) plus the
// readback and confirmation legs.
data primary_network_try_timeout_seconds: Nat = 300

fn staged(name: String) -> String {
  join([primary_network_staging_dir as String, "/", name], "")
}

fn primary_network_try_stdin() -> NetplanTryStdin {
  TryStdinBlockingFifo { path: staged(name: "try.fifo") as NonEmptyStr }
}

fn primary_network_try_stdin_path() -> String {
  match primary_network_try_stdin() {
    TryStdinBlockingFifo { path: p } => p as String
    TryStdinAtEof => ""
  }
}

fn primary_network_wait_online_command(renderer: NetplanRenderer) -> String {
  match renderer {
    SystemdNetworkd => "/usr/lib/systemd/systemd-networkd-wait-online --any --timeout=60"
    NetworkManager => "nm-online -q -t 60"
  }
}

// THE WRAPPER, rendered whole from the row. It keeps the prior directory, swaps in the population,
// runs the try on the FIFO, and keeps the new directory only on netplan's own "Configuration
// accepted."; on anything else it restores the prior directory and regenerates (netplan has already
// restored the running network).
fn primary_network_try_script(d: HostPrimaryNetworkDesired) -> String {
  let owned = join([netplan_config_dir as String, "/", primary_network_netplan_file_name as String], "")
  join([
    "set -u\n",
    "S=", primary_network_staging_dir as String, "\n",
    "rm -f \"$S/try.verdict\" \"$S/try.out\" \"", primary_network_try_stdin_path(), "\"\n",
    "rm -rf \"$S/prior\"\n",
    "mkdir -m 700 \"$S/prior\"\n",
    "if ! cp -a ", netplan_config_dir as String, "/. \"$S/prior/\"; then echo staging-refused > \"$S/try.verdict\"; exit 2; fi\n",
    "rm -f ", netplan_config_dir as String, "/*.yaml\n",
    "install -m 600 \"$S/", primary_network_netplan_file_name as String, "\" ", owned, "\n",
    "mkfifo -m 600 \"", primary_network_try_stdin_path(), "\"\n",
    join(netplan_try_argv(timeout_seconds: primary_network_try_timeout_seconds), " "), " <> \"", primary_network_try_stdin_path(), "\" > \"$S/try.out\" 2>&1\n",
    "if grep -q 'Configuration accepted' \"$S/try.out\" && ! grep -q 'Reverting' \"$S/try.out\"; then echo accepted > \"$S/try.verdict\"; exit 0; fi\n",
    "rm -f ", netplan_config_dir as String, "/*.yaml\n",
    "cp -a \"$S/prior/.\" ", netplan_config_dir as String, "/\n",
    "netplan generate\n",
    "echo reverted > \"$S/try.verdict\"\n",
    "exit 3\n",
  ], "")
}

// Bounded waits, each with its own exit word: the stamp netplan touches once it has applied, then the
// renderer's own online wait.
fn primary_network_await_script(d: HostPrimaryNetworkDesired) -> String {
  join([
    "S=", primary_network_staging_dir as String, "\n",
    "i=0\n",
    "while [ ! -e ", netplan_try_ready_stamp_path as String, " ]; do\n",
    "  if [ -e \"$S/try.verdict\" ]; then echo ended-before-ready; cat \"$S/try.verdict\"; exit 6; fi\n",
    "  i=$((i+1))\n",
    "  if [ \"$i\" -gt 60 ]; then echo try-not-ready; exit 4; fi\n",
    "  sleep 1\n",
    "done\n",
    "if ! ", primary_network_wait_online_command(renderer: d.renderer), "; then echo not-online; exit 5; fi\n",
    "echo ready\n",
  ], "")
}

// The newline goes in through a read-write open, which never blocks: if the try has already ended
// it lands in a pipe nobody reads, and the verdict says reverted.
fn primary_network_confirm_script() -> String {
  join([
    "S=", primary_network_staging_dir as String, "\n",
    "if [ ! -p \"", primary_network_try_stdin_path(), "\" ]; then echo no-try; exit 7; fi\n",
    "exec 3<>\"", primary_network_try_stdin_path(), "\"\n",
    "printf '\\n' >&3\n",
    "exec 3>&-\n",
    "i=0\n",
    "while [ ! -e \"$S/try.verdict\" ]; do\n",
    "  i=$((i+1))\n",
    "  if [ \"$i\" -gt 30 ]; then echo verdict-unread; exit 8; fi\n",
    "  sleep 1\n",
    "done\n",
    "cat \"$S/try.verdict\"\n",
  ], "")
}

fn staged_file(subject: String, name: String, content: String) -> FleetHostFileDesired {
  FleetHostFileDesired { subject: subject as NonEmptyStr, path: staged(name: name) as FilePath, content: content, mode: RemoteFileModeOwnerReadWrite, validation: NoValidation }
}

fn primary_network_staged_files(d: HostPrimaryNetworkDesired) -> List<FleetHostFileDesired> {
  [
    staged_file(subject: "primary-network-staged-netplan", name: primary_network_netplan_file_name as String, content: primary_network_netplan_text(d: d)),
    staged_file(subject: "primary-network-try-script", name: "try.sh", content: primary_network_try_script(d: d)),
    staged_file(subject: "primary-network-await-script", name: "await.sh", content: primary_network_await_script(d: d)),
    staged_file(subject: "primary-network-confirm-script", name: "confirm.sh", content: primary_network_confirm_script()),
  ]
}

fn primary_network_staging_dir_argv() -> List<String> {
  ["install", "-d", "-m", "700", primary_network_staging_dir as String]
}

fn primary_network_launch_argv() -> List<String> {
  ["systemd-run", "--unit", primary_network_try_unit as String, "--collect", "--quiet", "/bin/sh", staged(name: "try.sh")]
}

// ── Legs ─────────────────────────────────────────────────────────────────────────────────────────

type PrimaryLegRead
  = PrimaryLegAnswered { exit_code: Int, stdout: String }
  | PrimaryLegUnreached { cause: NonEmptyStr }

fn primary_leg(subject: FleetHostFileSubject, context: FleetSshExecutionContext, command: List<String>) -> PrimaryLegRead
{
  match run_fleet_host_leg(subject: subject, context: context, leg: LegElevated { command: command }) {
    TypedArgvExecRefused { reason: why } => PrimaryLegUnreached { cause: join([join(command, " "), ": ", why], "") as NonEmptyStr }
    TypedArgvExecConverged { result: r } => PrimaryLegAnswered { exit_code: r.exit_code, stdout: r.stdout }
  }
}

fn primary_leg_stdout(read: PrimaryLegRead, what: String) -> String? {
  match read {
    PrimaryLegUnreached { cause: _ } => none
    PrimaryLegAnswered { exit_code: c, stdout: o } => if c == 0 { Present { value: o } } else { none }
  }
}

fn primary_leg_cause(read: PrimaryLegRead, what: String) -> NonEmptyStr {
  match read {
    PrimaryLegUnreached { cause: c } => c
    PrimaryLegAnswered { exit_code: c, stdout: o } => join([what, " exit=", to_string(c), " ", trim(s: o)], "") as NonEmptyStr
  }
}

fn observe_primary_effective(subject: FleetHostFileSubject, context: FleetSshExecutionContext, d: HostPrimaryNetworkDesired) -> PrimaryEffectiveVerdict
{
  let links = primary_leg(subject: subject, context: context, command: concat(["ip"], ip_show_link_args))
  let addrs = primary_leg(subject: subject, context: context, command: concat(["ip"], ip_show_ipv4_addr_args))
  let route = primary_leg(subject: subject, context: context, command: concat(["ip"], ip_show_ipv4_default_route_args))
  match primary_leg_stdout(read: links, what: "ip link") {
    Absent => PrimaryEffectiveUnjudged { cause: primary_leg_cause(read: links, what: "ip link") }
    Present { value: l } =>
      match primary_leg_stdout(read: addrs, what: "ip addr") {
        Absent => PrimaryEffectiveUnjudged { cause: primary_leg_cause(read: addrs, what: "ip addr") }
        Present { value: a } =>
          match primary_leg_stdout(read: route, what: "ip route") {
            Absent => PrimaryEffectiveUnjudged { cause: primary_leg_cause(read: route, what: "ip route") }
            Present { value: r } => primary_effective_verdict(d: d, reads: PrimaryNetworkIpReads { links: l, ipv4_addresses: a, ipv4_default_route: r })
          }
      }
  }
}

fn observe_netplan_directory(subject: FleetHostFileSubject, context: FleetSshExecutionContext) -> NetplanDirectoryListing
{
  let read = primary_leg(subject: subject, context: context, command: ["ls", "-1", "-A", "--", netplan_config_dir as String])
  match primary_leg_stdout(read: read, what: "ls /etc/netplan") {
    Absent => NetplanDirectoryUnread { cause: primary_leg_cause(read: read, what: "ls /etc/netplan") }
    Present { value: o } => NetplanDirectoryListed { names: netplan_yaml_names(listing_stdout: o) }
  }
}

fn observe_primary_network(subject: FleetHostFileSubject, context: FleetSshExecutionContext, d: HostPrimaryNetworkDesired) -> PrimaryNetworkObservation
{
  PrimaryNetworkObservation {
    effective: observe_primary_effective(subject: subject, context: context, d: d),
    directory: observe_netplan_directory(subject: subject, context: context),
    owned: observe_fleet_host_file_content(subject: subject, context: context, file: primary_network_netplan_file(d: d)),
  }
}

// ── The apply ────────────────────────────────────────────────────────────────────────────────────

// WHERE A STOPPED APPLY LEFT THE HOST. Before the launch nothing in /etc/netplan has changed; after
// it, the try is running and only netplan's timeout and the wrapper decide what remains, so a stop
// there is reported with the timeout that will end it.
type PrimaryApplyRollback
  = RollbackNothingLaunched
  | RollbackByTryTimeout { timeout_seconds: Nat }

type PrimaryNetworkApplyOutcome
  = PrimaryApplyObservedOnly { plan: PrimaryNetworkPlan }
  | PrimaryApplyNotOwed
  | PrimaryApplyRefused { plan: PrimaryNetworkPlan }
  | PrimaryApplyStopped { step: NonEmptyStr, cause: NonEmptyStr, rollback: PrimaryApplyRollback }
  | PrimaryApplyConfirmed { after: PrimaryNetworkPlan }

fn primary_apply_outcome_settled(o: PrimaryNetworkApplyOutcome) -> Bool {
  match o {
    PrimaryApplyObservedOnly { plan: p } => match p { PrimaryNetworkSettled => true  PrimaryNetworkApplyOwed { foreign: _, owned: _ } => true  PrimaryNetworkRefused { cause: _ } => false }
    PrimaryApplyNotOwed => true
    PrimaryApplyRefused { plan: _ } => false
    PrimaryApplyStopped { step: _, cause: _, rollback: _ } => false
    PrimaryApplyConfirmed { after: a } => match a { PrimaryNetworkSettled => true  PrimaryNetworkApplyOwed { foreign: _, owned: _ } => false  PrimaryNetworkRefused { cause: _ } => false }
  }
}

fn primary_apply_outcome_wire(o: PrimaryNetworkApplyOutcome) -> String {
  match o {
    PrimaryApplyObservedOnly { plan: p } => join(["observe-only plan=", primary_network_plan_wire(p: p)], "")
    PrimaryApplyNotOwed => "settled, nothing to apply"
    PrimaryApplyRefused { plan: p } => join(["refused plan=", primary_network_plan_wire(p: p)], "")
    PrimaryApplyStopped { step: s, cause: c, rollback: r } =>
      join(["STOPPED step=", s as String, " ", c as String, " rollback=", match r { RollbackNothingLaunched => "nothing-launched"  RollbackByTryTimeout { timeout_seconds: t } => join(["netplan-try-timeout-", to_string(t), "s"], "") }], "")
    PrimaryApplyConfirmed { after: a } => join(["confirmed after=", primary_network_plan_wire(p: a)], "")
  }
}

fn stopped_before_launch(step: String, cause: String) -> PrimaryNetworkApplyOutcome {
  PrimaryApplyStopped { step: step as NonEmptyStr, cause: cause as NonEmptyStr, rollback: RollbackNothingLaunched }
}

fn stopped_in_try(step: String, cause: String) -> PrimaryNetworkApplyOutcome {
  PrimaryApplyStopped { step: step as NonEmptyStr, cause: cause as NonEmptyStr, rollback: RollbackByTryTimeout { timeout_seconds: primary_network_try_timeout_seconds } }
}

fn write_through_host_file_core(subject: FleetHostFileSubject, context: FleetSshExecutionContext, files: List<FleetHostFileDesired>) -> String?
{
  fold(files, init: none, f: (acc, file) =>
    match acc {
      Present { value: _ } => acc
      Absent => {
        let outcome = apply_fleet_host_file(subject: subject, context: context, planned: plan_fleet_host_file(subject: subject, context: context, file: file))
        if fleet_host_file_outcome_settled(outcome: outcome) { none } else { Present { value: join([file.subject as String, " ", runner_host_file_outcome_wire(outcome: outcome)], "") } }
      }
    }
  )
}

// After the launch every leg is a fresh connection; the readback is the plan itself, and only a
// Settled readback confirms.
fn confirm_primary_network_try(subject: FleetHostFileSubject, context: FleetSshExecutionContext, d: HostPrimaryNetworkDesired) -> PrimaryNetworkApplyOutcome
{
  let waited = primary_leg(subject: subject, context: context, command: ["/bin/sh", staged(name: "await.sh")])
  match primary_leg_stdout(read: waited, what: "await") {
    Absent => stopped_in_try(step: "await", cause: primary_leg_cause(read: waited, what: "await") as String)
    Present { value: _ } =>
      match plan_primary_network(d: d, observation: observe_primary_network(subject: subject, context: context, d: d)) {
        PrimaryNetworkApplyOwed { foreign: f, owned: _ } => stopped_in_try(step: "readback", cause: join(["the tried directory is not the population; foreign=[", join(f, ","), "]"], ""))
        PrimaryNetworkRefused { cause: c } => stopped_in_try(step: "readback", cause: c as String)
        PrimaryNetworkSettled => {
          let confirm = primary_leg(subject: subject, context: context, command: ["/bin/sh", staged(name: "confirm.sh")])
          match primary_leg_stdout(read: confirm, what: "confirm") {
            Absent => stopped_in_try(step: "confirm", cause: primary_leg_cause(read: confirm, what: "confirm") as String)
            Present { value: v } =>
              if trim(s: v) != "accepted" { stopped_in_try(step: "confirm", cause: join(["the wrapper's verdict is ", trim(s: v)], "")) }
              else { PrimaryApplyConfirmed { after: plan_primary_network(d: d, observation: observe_primary_network(subject: subject, context: context, d: d)) } }
          }
        }
      }
  }
}

fn apply_primary_network(subject: FleetHostFileSubject, context: FleetSshExecutionContext, d: HostPrimaryNetworkDesired, mode: FleetHostFileConvergeMode) -> PrimaryNetworkApplyOutcome
{
  let plan = plan_primary_network(d: d, observation: observe_primary_network(subject: subject, context: context, d: d))
  match mode {
    FleetHostFilesObserveOnly => PrimaryApplyObservedOnly { plan: plan }
    FleetHostFilesApply =>
      match plan {
        PrimaryNetworkSettled =>
          match write_through_host_file_core(subject: subject, context: context, files: [primary_network_cloud_init_guard()]) {
            Present { value: why } => stopped_before_launch(step: "cloud-init-guard", cause: why)
            Absent => PrimaryApplyNotOwed
          }
        PrimaryNetworkRefused { cause: _ } => PrimaryApplyRefused { plan: plan }
        PrimaryNetworkApplyOwed { foreign: _, owned: _ } =>
          if !netplan_try_stdin_admits_confirmation(s: primary_network_try_stdin()) { stopped_before_launch(step: "try-stdin", cause: "the try's stdin cannot carry a confirmation") }
          else {
            let dir = primary_leg(subject: subject, context: context, command: primary_network_staging_dir_argv())
            match primary_leg_stdout(read: dir, what: "staging-dir") {
              Absent => stopped_before_launch(step: "staging-dir", cause: primary_leg_cause(read: dir, what: "staging-dir") as String)
              Present { value: _ } =>
                match write_through_host_file_core(subject: subject, context: context, files: concat([primary_network_cloud_init_guard()], primary_network_staged_files(d: d))) {
                  Present { value: why } => stopped_before_launch(step: "stage", cause: why)
                  Absent => {
                    let launch = primary_leg(subject: subject, context: context, command: primary_network_launch_argv())
                    match primary_leg_stdout(read: launch, what: "launch") {
                      Absent => stopped_before_launch(step: "launch", cause: primary_leg_cause(read: launch, what: "launch") as String)
                      Present { value: _ } => confirm_primary_network_try(subject: subject, context: context, d: d)
                    }
                  }
                }
            }
          }
      }
  }
}

// ── The CI entry ─────────────────────────────────────────────────────────────────────────────────

data host_primary_network_attempt_raw: String = "host-primary-network-converge-ci"
data host_primary_network_receipt_path: String = "target/host-primary-network-receipt.txt"

// ONE HOST PER RUN, NAMED BY THE DISPATCH, as the host-file converge reads it. A host without a row
// refuses with its standing; the apply mode is the operator's to choose.
fn host_primary_network_ci_wet(mode: FleetHostFileConvergeMode) -> ProcessExit
{
  match actions_variable_read(name: fleet_converge_expected_host_env_name) {
    ActionsVariableAbsent { variable: v, detail: dt } =>
      exit_failure(reason: join(["host_primary_network: ", v, " ", dt, "; one host per run, named by the dispatch"], ""))
    ActionsVariablePresent { value: raw_host } =>
      match primary_network_row_for(host: raw_host as HostIdentity) {
        PrimaryRowUnmodeled { host: h } => exit_failure(reason: join(["host_primary_network: ", h as String, " has no primary network row"], ""))
        PrimaryRowAwaitingRead { change: _, read_obligation: o } => exit_failure(reason: join(["host_primary_network: ", raw_host, " was moved by hand and not read; owed: ", o as String], ""))
        PrimaryRowDeclared { desired: d } =>
          match administrator_ssh_target(host: d.host) {
            SshTargetRefused { endpoint: e, refusal: why } => exit_failure(reason: ssh_target_refusal_text(endpoint: e, refusal: why))
            SshTargetResolved { target: target } =>
              match prepare_fleet_ssh_agent_context(attempt_raw: host_primary_network_attempt_raw) {
                FleetSshContextRefused { cause: c } => exit_failure(reason: c)
                FleetSshContextReady { context: context, receipt: context_receipt } => {
                  let subject = FleetHostFileSubject { host: d.host, target: target }
                  let outcome = match observe_fleet_host_administrator_privilege(subject: subject, context: context) {
                    AdministratorPrivilegeRefused { reason: why } => stopped_before_launch(step: "privilege", cause: why)
                    AdministratorPrivilegeAvailable => apply_primary_network(subject: subject, context: context, d: d, mode: mode)
                  }
                  let body = join([
                    "host_primary_network probed_at=", probed_at_word(reading: clock_now_probed_at()) as String, " host=", d.host as String, "\n",
                    context_receipt,
                    "outcome ", primary_apply_outcome_wire(o: outcome), "\n",
                  ], "")
                  let w = Filesystem.Write(path: host_primary_network_receipt_path, content: body)
                  if !w.success { exit_failure(reason: join(["host_primary_network: receipt write failed: ", w.error, "\n", body], "")) }
                  else if !primary_apply_outcome_settled(o: outcome) { exit_failure(reason: body) }
                  else { ExitSuccess }
                }
              }
          }
      }
  }
}

fn host_primary_network_observe_ci_wet() -> ProcessExit
{
  host_primary_network_ci_wet(mode: FleetHostFilesObserveOnly)
}

fn host_primary_network_converge_ci_wet() -> ProcessExit
{
  host_primary_network_ci_wet(mode: FleetHostFilesApply)
}
