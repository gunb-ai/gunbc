module gunbc.host_memory_observation

import std.measure {
  ByteSize, byte_size, measure_scale_fraction_floor,
}
import std.realization_width { byte_size_saturating_sub }
import std.types { String, NonEmptyStr }
import std.disposition { Disposition, Scaffold, SingleAuthority, Terminal }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import product.placement_supply { HostIdentity }
import gunbc.fleet_intent_network {
  operator_host_srv1, operator_host_srv2, operator_host_srv3, operator_host_srv4,
}

// WHAT A HOST HAS, READ FROM THE HOST -- SEPARATED FROM WHAT CI DOES WITH IT. Every declaration
// here came from gunbc.ci_floor_measurement and the extraction is the whole
// change: these are per-host kernel observations and operator allowances that depend on nothing
// about a runner slot, while the rows they sat beside (the cgroup caps, the floor peak receipts)
// derive from gunbc.runner_slot_allocation gunbc_runner_slot_desired. Co-locating the two made
// gunbc.ci_floor_measurement import the slot authority, which in turn made these facts unreachable
// FROM that authority -- the cycle named in gunbc.runner_slot_allocation
// host_runner_memory_envelope_bytes as its dissolve-on: "the usable-RAM and fixed-overhead facts
// become reachable from this module without a cycle -- today they sit in gunbc.ci_floor_measurement
// and gunbc.ci_runner_placement, both of which import this one".
//
// THE CONSEQUENCE THE CYCLE PAID FOR, which is why this is a correctness repair rather than tidying:
// host_runner_memory_envelope_bytes could not derive, so it carried one authored literal per host
// and an else arm of zero. Three hosts got hand-maintained numbers that no observation could
// contradict, and any host not named got a width of zero that is indistinguishable, at every
// consumer, from a host measured to have no capacity.
//
// THE NAMES ARE CARRIED UNCHANGED, DELIBERATELY. The gunbc_ci_ prefix no longer describes where
// these live and is kept anyway: the corpus cites several of these rows BY NAME in prose that
// argues about them, and a rename would turn every such citation stale in the same commit that
// moved them. Renaming is its own change, with its own sweep.
//
// ONE STRING CHANGED IN THE MOVE, AND TWO MORE CHANGED AND WERE PUT BACK -- recorded because an
// earlier revision of this note claimed the extraction was verbatim, and then a later one ratified
// a change nobody had decided. The `provenance` string on gunbc_ci_managed_host_fixed_overhead cited
// this row's own module by name and follows the row, which is self-citation and correct.
//
// THE TWO DeclarationRef BIND TARGETS ARE BACK AT gunbc.ci_floor_measurement. A proximity rewrite
// over citations had moved them here with everything else, and the reasoning offered afterwards --
// that a quiescent /proc/meminfo read belongs beside the rows it grounds -- was the author's
// judgement rather than a decision the corpus had taken. The corpus had already taken one: the
// citation debt rows that exempt those successors from refusing (declaration_index.rs
// PRE_EXISTING_CITATION_DEBT, FIXTURE_CARRIER_CITATION_EXEMPTIONS) name gunbc.ci_floor_measurement
// as their home, and the required floor reported six declaration findings the moment the bind
// targets disagreed with them -- three citations that no longer resolved, three debt rows gone
// stale. Where a successor lands is those rows' question. A bind target is not a citation and a
// regex aimed at citations should never have reached it.

type HostFixedOverhead
  = HostFixedOverheadMeasured { bytes: ByteSize, provenance: NonEmptyStr }
  | HostFixedOverheadAllowance { bytes: ByteSize, reason: NonEmptyStr }
  | HostFixedOverheadUnmeasured

// THREE ARMS BECAUSE THERE ARE THREE FACTS, and the row that stood here fused two of them under the
// name of the third. gunbc_ci_host_fixed_overhead was a single fleet-wide HostFixedOverheadMeasured
// carrying exactly 17179869184 bytes — 2^34, a round power of two — and its Scaffold bound to
// gunbc_ci_per_service_overhead, a declaration that HAS NEVER EXISTED anywhere in the corpus. So
// the constructor asserted a measurement, the provenance pointed at a row nobody wrote, and no
// reader could tell the difference between the two. That is rung inflation (DESIGN 4b) in the
// budget's own input: a carrier named for the top rung while occupying the bottom, and an inflated
// class never ranks for climbing.
//
// MEASURED means an observation produced it and the row says which one — the provenance field is
// required, not optional, for exactly the reason the SEC citation rule is: for a measured fact the
// provenance IS the grounding, so an arm that could omit it is a fail-open invitation. ALLOWANCE
// means an operator granted headroom for a deployment the model does not describe, which is a
// DIFFERENT KIND OF FACT, not a weaker measurement — it is honest, it is load-bearing, and it must
// never be reported as measured. UNMEASURED stays the fail-closed floor.
//
// Why per-host rather than one fleet number: srv1 and srv2 carry hand-built deployments this corpus
// never modeled (the session dashboard instances of gunbc.build_cache_instance among them), so
// their allowance is a real operator judgement about unmodeled residents. srv3 and srv4 were stood
// up through the modeled path and have an observation. One number could only have been the maximum
// of the two, which silently taxes the managed hosts for the legacy ones' mess — 10.4 GiB per host
// of memory the budget refused to spend because two other machines are untidy.

data gunbc_ci_host_memavailable_observation_note: String = "THE OBSERVATION THAT BOUNDS THE MANAGED-HOST OVERHEAD, and it is a found receipt rather than a fresh probe — worth saying plainly because it changes what the bound is allowed to claim. Before the srv3 cap converge (gunbc.runner_slot_allocation, 2026-07-21) srv3's slots were uncapped, so v1_compiler::memory_governor had no cgroup memory.high to arm against and fell back to /proc/meminfo MemAvailable, printing the host-level figure into every floor job's log. Seventeen such arm-time lines survive from 2026-07-16 across srv3-02/05/08, spanning 104.8 to 119.4 GiB; srv1 and srv2 on the same day printed only their 15 GiB cgroup budget, so the series is srv3 and nothing else.\n\nTHE DIRECTION OF THE BOUND IS THE WHOLE POINT. MemAvailable counts free memory plus reclaimable page cache and slab, so what it EXCLUDES is non-reclaimable anonymous RSS — services, daemons, and whatever runner work was resident at that instant. The MAXIMUM observation therefore corresponds to the QUIETEST moment seen, and host_total - max(MemAvailable) is an UPPER bound on fixed service overhead: at that instant everything non-reclaimable on the box, including any concurrent job, fit inside it. A smaller true overhead is consistent with this receipt; a larger one is not.\n\nWHAT IT IS NOT: a dedicated measurement. Nobody read /proc/meminfo on a quiescent srv3, and this row must not be cited as though someone had. It is admissible because it is an upper bound and the budget spends against it conservatively — the bound refuses to justify more slots than it can carry, which is the direction a fail-closed budget wants. The dissolution trigger is an ordinary quiescent read, which is also a prerequisite of the systemd-oomd verification that gunbc.oomd_install still lacks, so one reach closes both."

type HostMemAvailableObservation {
  host: HostIdentity
  run_id: NonEmptyStr
  runner_unit: NonEmptyStr
  host_total: ByteSize
  mem_available: ByteSize
}

data gunbc_ci_srv3_memavailable_high_water: HostMemAvailableObservation = HostMemAvailableObservation {
  host: operator_host_srv3,
  run_id: "29537878075",
  runner_unit: "srv3-08",
  host_total: byte_size(134217728000),
  mem_available: byte_size(128200089600),
}

fn host_overhead_upper_bound(obs: HostMemAvailableObservation) -> ByteSize {
  byte_size_saturating_sub(total: obs.host_total, reserved: obs.mem_available)
}

data gunbc_ci_managed_host_fixed_overhead: HostFixedOverhead = HostFixedOverheadMeasured {
  bytes: host_overhead_upper_bound(obs: gunbc_ci_srv3_memavailable_high_water),
  provenance: "gunbc.host_memory_observation gunbc_ci_srv3_memavailable_high_water: MemTotal-shaped host_total minus the 2026-07-16 arm-time MemAvailable high-water on srv3-08 (run 29537878075), an upper bound on non-reclaimable host residency — see gunbc_ci_host_memavailable_observation_note for why the maximum observation is the conservative end",
}

data gunbc_ci_legacy_host_fixed_overhead: HostFixedOverhead = HostFixedOverheadAllowance {
  bytes: byte_size(17179869184),
  reason: "srv1 and srv2 carry hand-built deployments the corpus does not model — the session dashboard instance (gunbc.build_cache_instance session_cache_instance, srv1 and srv2 only), its sccache server, and the residue of the pre-subsumption install path. 16 GiB is the operator's standing allowance for those unmodeled residents (ruling 2026-08-05), carried forward unchanged from the fleet-wide row it replaces so this change moves no number on these two hosts. It is an ALLOWANCE and not a measurement: no observation produced it, and the same MemAvailable receipt that bounds srv3 does not exist for srv1/srv2 because their slots were already capped when the governor stopped reading meminfo. Dissolves when those deployments are modeled — at which point their residents become budget rows and the allowance becomes whatever is left over, if anything.",
}

// THE UNKNOWN ARM REFUSES, and the first draft of this function did not — it ended in a bare else
// returning the managed measurement, so a host nobody had classified would silently inherit srv3's
// 5.6 GiB bound and the budget would hand it two extra slots on the strength of another machine's
// receipt. That is the absorbing fallback (DESIGN 5) sitting in the input to a conservation wall,
// which is the worst place for one: the wall's arithmetic would be correct and its premise
// fabricated, exactly the shape gunbc.plans.fleet_subsumption_manual_gaps section C prices — srv4
// took fleet work as a member of GitHub's fleet and a ghost of the model, and OOM-killed live CI
// the next day.
//
// So an unclassified host derives HostFixedOverheadUnmeasured, which host_fixed_overhead_bytes
// cannot turn into a number and gunbc.ci_runner_placement refuses on. Adding srv5 therefore fails
// closed with a located reason rather than quietly succeeding with a borrowed one — the enrollment
// wall's own shape, applied to the budget's inputs instead of its installer.

fn gunbc_ci_host_fixed_overhead_for(host: HostIdentity) -> HostFixedOverhead {
  if (host as String) == (operator_host_srv1 as String) {
    gunbc_ci_legacy_host_fixed_overhead
  } else if (host as String) == (operator_host_srv2 as String) {
    gunbc_ci_legacy_host_fixed_overhead
  } else if (host as String) == (operator_host_srv3 as String) {
    gunbc_ci_managed_host_fixed_overhead
  } else if (host as String) == (operator_host_srv4 as String) {
    gunbc_ci_managed_host_fixed_overhead
  } else {
    HostFixedOverheadUnmeasured
  }
}

// ONE SCAFFOLD BECOMES TWO BECAUSE THE TWO OVERHEADS DISSOLVE ON DIFFERENT EVENTS, and each still
// binds a successor that DOES NOT YET EXIST — which is what a Scaffold bind is for.
// v2.lens.disposition_redundancy reads these marks and counts a violation when a bind target is
// PRESENT: a scaffold whose successor has been written is redundant and must be dissolved. So an
// absent target is the normal, correct state of outstanding debt, and the lens is the thing that
// notices when the debt is actually payable.
//
// CORRECTION, recorded because an earlier revision of this change got it backwards and would have
// shipped the inversion. The row this replaces bound to gunbc_ci_per_service_overhead, and that
// bind was read here as a defect — 'a dissolve-on pointing at nothing' — on the reasoning that a
// marker naming a nonexistent declaration can never fire. The reasoning inverts the mechanism. It
// fires precisely BY that declaration coming into existence, and the first draft's repair
// (re-binding both scaffolds to rows this module already declares) would have made both of them
// immediate violations of the redundancy lens, converting two pieces of honest outstanding debt
// into two false claims that the debt was already paid. The original bind was right; only its
// single-row grain was wrong.
//
// What legitimately changed is the grain. gunbc_ci_per_service_overhead was one successor for one
// fleet-wide number, and there are now two facts with two different closure conditions: the managed
// hosts need an observation, the legacy pair need their deployments modeled. Neither successor
// exists, both name what would replace them, and writing either one fires the lens for that arm
// alone.

data gunbc_ci_managed_host_fixed_overhead_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.ci_floor_measurement",
    decl_name: "gunbc_ci_managed_host_quiescent_meminfo_read",
    field: WholeDeclaration
  }
}

data gunbc_ci_legacy_host_fixed_overhead_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.ci_floor_measurement",
    decl_name: "gunbc_ci_legacy_host_modeled_residents",
    field: WholeDeclaration
  }
}

type HostUsableRam
  = HostUsableRamMeasured { bytes: ByteSize, provenance: NonEmptyStr }
  | HostUsableRamConservativeLowerBound { bytes: ByteSize, basis: NonEmptyStr }
  | HostUsableRamUnmeasured

data gunbc_ci_host_usable_ram_kind_note: String = "OS-USABLE RAM IS A PER-HOST FACT AND WAS STORED AS A FLEET CONSTANT, which is the same grain defect gunbc_ci_host_fixed_overhead_kind_note repaired for overhead -- so this carrier is deliberately that carrier's shape rather than a new invention.\n\nTHE DIMM-REPLACEMENT CLAIM HAS NOW BEEN WRONG IN BOTH DIRECTIONS AND IS SETTLED BY MEASUREMENT. An earlier revision said a 2026-08-11 replacement had raised memory on part of the fleet; that was written from an in-flight operator report before any observation existed, and it was wrong (the attempt failed, operator 2026-08-12). This revision records the opposite and does so from a read rather than a report: srv3 and srv4 were each observed at 512 GiB over BMC Redfish on 2026-08-22 -- 8 x Samsung M393A8G40D40-CRB at 64 GiB, one per channel, all Enabled/OK -- while srv1 was upgraded to the same 8 x Samsung population on operator report and srv2's identical attempt FAILED memory training and was reverted to 8 x 16 GiB Hynix. The hosts no longer share one nominal population.\n\nTWO ARMS HAVE NOW MOVED AND TWO HAVE NOT, WHICH IS THE GRAIN DOING ITS JOB. srv3 and srv4 carry HostUsableRamMeasured from /proc/meminfo reads taken over SSH on 2026-08-22 (about 502.25 GiB each); srv1 and srv2 still carry HostUsableRamConservativeLowerBound at 125 GiB, because no MemTotal read has been taken on either. What promoted the two was a KERNEL read, never the Redfish 512 GiB figure -- that is NOMINAL DIMM capacity, which this carrier does not hold and must never be fed. A lower bound does not become false when the machine gets bigger; it becomes LOOSE, and srv1's is now loose by roughly 4x while remaining sound. The remedy is unchanged and is now half-applied: one ordinary read per host, taken any time, promoting that host's row and leaving the others untouched.\n\nTHREE ARMS BECAUSE THERE ARE THREE FACTS. MEASURED means a read of THIS host produced the number and the row names the read. CONSERVATIVE LOWER BOUND means no such read exists and the carried figure is known not to exceed the host's real usable RAM, with basis stating why. UNMEASURED is the fail-closed floor for a host nobody classified.\n\nTHE MIDDLE ARM IS A BOUND AND NOT A SUBSTITUTION, and the heterogeneity above is exactly why that distinction was worth paying for in advance. While the fleet was uniform an equivalence argument was also available, and naming the arm for equivalence would have licensed the move the wall cannot survive: carrying a reading from a host with MORE memory onto one with less. That move is now AUTHORABLE for the first time -- srv3 and srv4 are the hosts with more -- and the bound's name is what forbids it. The safety property is monotonicity, and it did not have to be re-argued when the fleet's uniformity ended.\n\nWHY srv1 AND srv2 ARE STILL BOUNDS: no MemTotal read has been taken on either. A NEARBY RECEIPT IS NOT ONE, and it is named because it looks like one: gunbc_ci_srv3_memavailable_high_water, whose host_total is MemTotal-shaped but was captured as an arm-time line from a memory governor rather than a read taken to answer this question, only on srv3, and -- now load-bearing -- against srv3's PREVIOUS 128 GiB population, so it is a receipt about hardware that is no longer in that chassis.\n\nDissolving these is CHEAPER THAN THE FIXED-OVERHEAD ROW BESIDE THEM and must not be confused with it. That row needs a QUIESCENT read because it estimates non-reclaimable residency from MemAvailable, which moves with load. MemTotal does not: the kernel reports total usable RAM after firmware and kernel reservations, so an ordinary read while the host serves work is a complete answer. One read per host, taken any time, promotes that host's row to MEASURED and leaves the others untouched -- which is the entire point of the grain."

data gunbc_ci_conservative_lower_bound_retired_note: String = "THE FLEET-WIDE CONSERVATIVE LOWER BOUND IS DELETED, ITS OBLIGATION DISCHARGED ON EVERY HOST. It held byte_size(134217728000) -- the MemTotal-shaped figure captured on srv3 on 2026-07-16 -- and lent it to whichever hosts had no read of their own, which was at first all four and latterly srv1 and srv2. All four now carry their own /proc/meminfo MemTotal, so it had no consumer left and is removed rather than kept as a value nothing reads.\n\nIT IS DELETED, NOT MARKED HISTORICAL, and the distinction matters because the observation it borrowed still exists: gunbc_ci_srv3_memavailable_high_water is untouched and is still the receipt the managed-host overhead bound rests on. What is gone is the act of LENDING that number to other machines. The row's own text predicted this end -- it said the bound survives a host growing because a lower bound only loosens, and that each host replaces it independently by its own MemTotal read -- and that is what happened, on the last of the four, today.\n\nWHAT SURVIVES AND SHOULD NOT BE MISTAKEN FOR DEAD: the HostUsableRamConservativeLowerBound VARIANT stays in the type and host_usable_ram_or_refusal still handles it. Nothing constructs it today, and an arm that nothing currently occupies is a quiet guard rather than a dead one -- a fifth host enrolled tomorrow with no read of its own is exactly the state it exists to represent, and deleting the arm because its population is momentarily zero would remove the representation along with the occupant."

data gunbc_ci_host_usable_ram_disposition_note: String = "REGISTERED AS SCAFFOLD DEBT BECAUSE ITS TWIN IS, and because the debt is PRE-EXISTING rather than introduced here: the fleet-wide constant this carrier replaces was already an unmeasured stand-in, and modeling it is what makes it countable. DESIGN 5 refuses NEW dissolution obligations without an operator verdict; it separately exists so that documenting previously hidden debt never reads as creating it, which is this row.\n\nTHE BIND TARGET IS DELIBERATELY NOT THE OVERHEAD ROW'S. gunbc_ci_managed_host_fixed_overhead_disposition binds a QUIESCENT read, because overhead is estimated from MemAvailable and MemAvailable moves with load. MemTotal does not — the kernel reports total usable RAM after firmware and kernel reservations — so an ordinary read taken while the host serves work discharges this and not that. Two obligations, two observations, two independently removable units, which is the grain DESIGN 5 requires: sharing one trigger is admissible only when neither artifact can survive the other, and these plainly can."

data gunbc_ci_host_usable_ram_disposition: Disposition = Terminal {
  reason: "DISCHARGED 2026-08-23: every enrolled host now carries its own measured /proc/meminfo MemTotal, which is precisely what this scaffold named as its dissolution condition. srv3 and srv4 were read on 2026-08-22 and srv1 and srv2 on 2026-08-23; the borrowed fleet-wide lower bound they were all standing on is deleted (gunbc_ci_conservative_lower_bound_retired_note). This is a real climb and not a re-labelling: the carrier no longer has any arm in which one host's measurement answers for another's, so the state this scaffold was registered against is unreachable rather than merely unoccupied. The sibling overhead obligation gunbc_ci_managed_host_fixed_overhead_disposition is NOT discharged by this and is deliberately left standing -- it binds a QUIESCENT MemAvailable read, which is a different observation with a different provenance requirement, and gunbc_ci_host_usable_ram_disposition_note exists to say why the two were never one obligation."
}

// THE FIRST MemTotal READS THIS FLEET HAS EVER CARRIED. srv3 and srv4 were read on 2026-08-22 and
// srv1 and srv2 on 2026-08-23, at which point the borrowed fleet-wide lower bound had no host left
// to lend to and was deleted -- gunbc_ci_conservative_lower_bound_retired_note above records that,
// and gunbc_ci_host_usable_ram_disposition is Terminal on the strength of it. The paragraphs below
// describe the 2026-08-22 pair, which is why they speak of "both hosts".
//
// Taken over SSH on the hosts themselves -- /proc/meminfo MemTotal, the figure the kernel
// reports after firmware and kernel reservations -- which is exactly the read
// gunbc_ci_host_usable_ram_kind_note names as sufficient: MemTotal does not move with load, so
// an ordinary read while the host serves work is a complete answer and no quiescence is needed.
//
// THE NOMINAL-VERSUS-USABLE GAP IS NOW MEASURED RATHER THAN ASSERTED, and it is larger than the
// old population's. Both hosts carry 512 GiB of nominal DIMM capacity and the kernel reports
// 502.25 GiB usable -- a 9.75 GiB firmware and kernel reservation. Writing the Redfish 512 GiB
// figure into this carrier would therefore have overstated the budget's ceiling by nearly ten
// gibibytes on each host, which is the error this carrier's whole existence is meant to prevent
// and which was one edit away the moment the BMC reported a bigger number.
data gunbc_ci_srv1_memtotal_measured: HostUsableRam = HostUsableRamMeasured {
  bytes: byte_size(539281129472),
  provenance: "srv1 /proc/meminfo MemTotal = 526641728 kB, read over SSH 2026-08-23 while the host was serving. THIS RETIRES srv1's CONSERVATIVE LOWER BOUND, which was the 125 GiB figure captured on srv3 in 2026-07-16 and was still being applied to a host carrying four times that much -- sound, and uselessly so, exactly as that bound's own text predicted it would become -- see gunbc_ci_conservative_lower_bound_retired_note, which records its deletion now that the last host has a read of its own. It is a kernel read of THIS host and not a promotion of srv1's operator-relayed 512 GiB nominal figure: the 10 GiB gap between the two is the firmware-and-kernel reservation, and the nominal number remains inadmissible here for the reason fleet_host_memory_nominal_vs_usable_note gives.\n\nA MEMTOTAL READ TAKEN UNDER LOAD IS STILL A MEMTOTAL READ. The host was serving runners at the time and that does not weaken this the way it would weaken a MemAvailable observation: MemTotal is what the kernel found after its own reservations and does not move with load, which is precisely the distinction gunbc_ci_host_usable_ram_disposition_note draws between this obligation and the overhead one beside it.",
}

data gunbc_ci_srv2_memtotal_measured: HostUsableRam = HostUsableRamMeasured {
  bytes: byte_size(134314512384),
  provenance: "srv2 /proc/meminfo MemTotal = 131166516 kB, read over SSH 2026-08-23, corroborated independently by that host's docker daemon reporting MemTotal = 134314512384 bytes exactly. srv2 did NOT take the 64 GiB upgrade -- its install failed memory training and was reverted to 8 x 16 GiB Hynix -- so this read confirms the small population rather than a large one, and it is carried for the same reason as srv1's: the borrowed srv3 bound was never a measurement of THIS machine. It lands about 96 MiB ABOVE the 134217728000 bound it replaces, which is the whole argument for taking the read: the bound was not merely loose, it was on the wrong side on this host, and a lower bound that is too high is not conservative at all.",
}

data gunbc_ci_srv3_memtotal_measured: HostUsableRam = HostUsableRamMeasured {
  bytes: byte_size(539282522112),
  provenance: "srv3 /proc/meminfo MemTotal = 526643088 kB, read over SSH 2026-08-22 while the host was serving (5 actions-runner units active, uptime 2h21m, kernel 6.8.0-138-generic), against the 8 x 64 GiB Samsung population installed the same day",
}

data gunbc_ci_srv4_memtotal_measured: HostUsableRam = HostUsableRamMeasured {
  bytes: byte_size(539282526208),
  provenance: "srv4 /proc/meminfo MemTotal = 526643092 kB, read over SSH 2026-08-22 while the host was serving (5 actions-runner units active, uptime 2h52m, kernel 6.8.0-138-generic), against the 8 x 64 GiB Samsung population installed the same day",
}

// THE UNKNOWN-HOST ARM REFUSES RATHER THAN BORROWING, WHICH IS THE ONLY THING THIS DISPATCH
// DECIDES THAT ITS ROWS DO NOT SAY FOR THEMSELVES. Every enrolled host answers from its own
// /proc/meminfo read, and each row's provenance carries why that read is admissible; a host with
// no row gets HostUsableRamUnmeasured, never another machine's figure. That is the whole rationale
// -- lending one host's MemTotal to a second is what the retired fleet-wide bound did, and
// gunbc_ci_conservative_lower_bound_retired_note records why it was deleted rather than loosened.
fn gunbc_ci_host_usable_ram_for(host: HostIdentity) -> HostUsableRam {
  if (host as String) == (operator_host_srv1 as String) {
    gunbc_ci_srv1_memtotal_measured
  } else if (host as String) == (operator_host_srv2 as String) {
    gunbc_ci_srv2_memtotal_measured
  } else if (host as String) == (operator_host_srv3 as String) {
    gunbc_ci_srv3_memtotal_measured
  } else if (host as String) == (operator_host_srv4 as String) {
    gunbc_ci_srv4_memtotal_measured
  } else {
    HostUsableRamUnmeasured
  }
}

// THE CEILING PROJECTION LIVES ONCE, BESIDE THE CARRIER. gunbc.ci_budget_tree and
// gunbc.fleet_host_budget each grew a byte-identical fold over HostUsableRam when they migrated off
// nominal DIMM capacity, which is the duplication DESIGN 2 forbids and exactly the shape that lets
// two budget models drift apart again — the defect the migration existed to close.
//
// It does NOT absorb gunbc.ci_runner_placement host_usable_ram_or_refusal, which folds the same
// coproduct to a different answer on purpose. That one is LOUD: an unmeasured host yields a typed,
// located refusal that becomes PlanUnsound. This one is a total ceiling for budget arithmetic,
// where zero is the fail-closed reading because an unknown ceiling admits nothing. Same input, two
// honest consumers, two results — collapsing them would force one caller to accept the other's
// failure semantics.

fn host_usable_ram_ceiling_bytes(host: HostIdentity) -> ByteSize {
  match gunbc_ci_host_usable_ram_for(host: host) {
    HostUsableRamMeasured { bytes: b, provenance: _ } => b
    HostUsableRamConservativeLowerBound { bytes: b, basis: _ } => b
    HostUsableRamUnmeasured => byte_size(0)
  }
}


// THE OOMD ACTUATION FLOOR IS A HOST-MEMORY FACT AND WAS LIVING IN THE BUDGET THAT SPENDS IT.
// Extracted from gunbc.fleet_host_budget for the same reason as the rows above: it is a pure
// fraction of a host's own RAM, it depends on nothing about a runner slot or a budget tree, and
// leaving it there kept it unreachable from gunbc.runner_slot_allocation -- which needs it,
// because a runner-memory envelope that does not subtract it is an envelope that has silently
// spent the headroom systemd-oomd requires in order to act at all.
data gunbc_fleet_oomd_floor_basis: String = "oomd_actuation_floor is a DERIVED lower bound on free host memory: systemd-oomd needs free headroom to evict a runaway cgroup BEFORE the kernel OOM-killer/livelock fires (the srv2-reboot vector). Basis: a fixed fraction of host RAM (1/16 = ~6.25%) as the minimum free-memory swing oomd needs to actuate; on a 125GiB host this is ~7.8GiB. This is the floor BELOW which a HeadroomSet policy is unsound (it leaves oomd no room to act). Derived, not a literal: scales with host. dissolve-on a measured oomd MemoryPressureLimit + swap-free actuation window once systemd-oomd is live (operator fix-manifest item 8)."

fn oomd_actuation_floor(host: ByteSize) -> ByteSize {
  measure_scale_fraction_floor(m: host, num: 1, den: 16)
}
