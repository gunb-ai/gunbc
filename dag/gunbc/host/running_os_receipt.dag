module gunbc.host.running_os_receipt

import std.types { String, Int, Bool, List, NonEmptyStr }
import std.algebra { trim }
import std.integer { int_to_decimal_string }
import std.list { sole_where, SoleMatchNone, SoleMatchRepeated, SoleMatchOne }
import std.optional { Present, Absent }
import std.bytes { bytes_octets, utf8_encode_bytes }
import extdeps.crypto.sha2 { sha256_hex }
import extdeps.github.workflow_runs { GitHubWorkflowRunId, github_workflow_run_id_wire_text }
import product.host_identity { HostIdentity }
import gunbc.host.host_boot_id { HostBootId, host_boot_id_of_kernel_text }
import gunbc.host.running_os { RunningOs, RunningDeliveredArtifact, RunningOsReading, RunningOsObserved, RunningOsUnobserved }

// A RUNNING-OS READING CARRIED ACROSS JOBS (gunbc.plans.physical_machine_boot_program, the initialized-host
// contract; merry-fox-82's B2 decision A, 2026-11-02). The reading is produced where the boot's console capture
// is read (for the Ephemeral runner medium, gunbc.runner.runner_host_medium runner_host_running_os, inside the
// boot run); a consumer in another job (the qualification attempt) needs the same reading to initialize the host.
// The boot run writes it as this receipt and uploads it as an artifact of ITS OWN RUN; the consumer selects that
// producer run (gunbc.fleet.fleet_converge_producer_run) and downloads the artifact from it, never from a
// hand-supplied value or a path in a working tree.
//
// WHAT THE RECEIPT DOES NOT CARRY IS TRUST. It names its producer and its content digest, so a document that is
// not what its producer wrote, or that came from another run, refuses here. That the host is STILL on the boot
// the receipt observed, and that it is the host the consumer authenticated, are not facts a stored document can
// state: gunbc.host.initialized_host initialized_host_over re-reads the boot id live over the pinned transport
// and compares both, so a receipt from before a reboot or from another host refuses there.
//
// THE PRODUCER IS NAMED IN GITHUB'S OWN WIRE WORDS (the decimal run id and run attempt, as GITHUB_RUN_ID and
// GITHUB_RUN_ATTEMPT spell them to the writer and the runs listing returns them to the reader), and two producers
// are one run exactly when both words agree.
type RunningOsReceiptProducer {
  run_id: NonEmptyStr
  run_attempt: NonEmptyStr
}

fn running_os_receipt_producer_of_run(run: GitHubWorkflowRunId, attempt: Int) -> RunningOsReceiptProducer {
  RunningOsReceiptProducer { run_id: github_workflow_run_id_wire_text(id: run) as NonEmptyStr, run_attempt: to_string(attempt) as NonEmptyStr }
}

fn running_os_receipt_producer_text(p: RunningOsReceiptProducer) -> String {
  join(["run ", p.run_id as String, " attempt ", p.run_attempt as String], "")
}

// WHERE A HOST'S RUNNING-OS RECEIPT IS PUBLISHED: the fleet-converge mode of the boot run that writes it, the host
// that run is DISPATCHED with, the artifact that run uploads it under, and the file's name inside that artifact.
// The SUBJECT host (the host the receipt is about, the key a consumer looks the source up by) and the producer's
// DISPATCH host (the `host` input the boot run was dispatched with, which its run title carries and the producer-run
// selection matches) are two facts: a boot route whose executor is not its subject (mtcollins1 is booted from srv1)
// titles every producer run with the executor, so selecting by the subject finds none. One row per boot route, declared by
// the route that writes the receipt (for mtcollins1, gunbc.machine_intake.mtcollins1_boot_run
// mtcollins1_running_os_receipt_source), so the writer and the reader (gunbc.host.running_os_receipt_observed)
// read one spelling.
type RunningOsReceiptSource {
  host: HostIdentity
  producer_dispatch_host: HostIdentity
  mode: String
  artifact: String
  file_name: String
}

// THE DOCUMENT'S WIRE VOCABULARY, one home for both directions.
data running_os_receipt_header: String = "running_os_receipt"
data running_os_receipt_run_prefix: String = "producer_run="
data running_os_receipt_attempt_prefix: String = "producer_attempt="
data running_os_receipt_host_prefix: String = "host="
data running_os_receipt_delivered_artifact_prefix: String = "delivered_artifact_digest="
data running_os_receipt_boot_prefix: String = "observed_boot_id="
data running_os_receipt_content_digest_prefix: String = "content_sha256="

// THE CONTENT DIGEST is the sha256 of every byte before the content_sha256 line (FIPS 180-4, extdeps.crypto.sha2,
// over the body's UTF-8 encoding), so any change to a stated fact changes the digest the body yields.
fn running_os_receipt_content_digest(body: String) -> String {
  sha256_hex(message: bytes_octets(b: utf8_encode_bytes(s: body)))
}

fn running_os_receipt_body(producer: RunningOsReceiptProducer, host: HostIdentity, running: RunningOs, boot: HostBootId) -> String {
  let delivered = match running { RunningDeliveredArtifact { digest: d } => d as String }
  concat(join([
    running_os_receipt_header,
    concat(running_os_receipt_run_prefix, producer.run_id as String),
    concat(running_os_receipt_attempt_prefix, producer.run_attempt as String),
    concat(running_os_receipt_host_prefix, host as String),
    concat(running_os_receipt_delivered_artifact_prefix, delivered),
    concat(running_os_receipt_boot_prefix, boot.boot_id as String),
  ], "\n"), "\n")
}

// THE WRITER: only an observed reading has a receipt. An unobserved one is not written, so a consumer finds no
// receipt rather than one stating nothing.
fn running_os_receipt_text(producer: RunningOsReceiptProducer, reading: RunningOsReading) -> String? {
  match reading {
    RunningOsUnobserved { cause: _ } => none
    RunningOsObserved { running: r, observed_host: h, observed_on: b } => {
      let body = running_os_receipt_body(producer: producer, host: h, running: r, boot: b)
      Present { value: join([body, running_os_receipt_content_digest_prefix, running_os_receipt_content_digest(body: body), "\n"], "") }
    }
  }
}

type RunningOsReceiptRefusal
  // the bytes are not this document: no content digest line, a wrong header, or a field that does not decode.
  = RunningOsReceiptMalformed { cause: String }
  // a named field has no line. The document lost a fact its writer always states.
  | RunningOsReceiptFieldAbsent { prefix: String }
  // a named field has more than one line. The writer states each fact once, so a document carrying two cannot
  // say which is meant; reading the first would admit 'host=a' over a later 'host=b' whatever the digest says.
  | RunningOsReceiptFieldRepeated { prefix: String, occurrences: Int }
  // a line that is none of the fields the writer states. The writer's lines are the whole document, so a line it
  // never writes is not part of this receipt, and admitting it would let the document carry a fact no reader checks.
  | RunningOsReceiptLineUnexpected { line: String }
  // the stated digest is not the digest of the content: the document is not what its producer wrote.
  | RunningOsReceiptDigestMismatch { stated: String, computed: String }
  // the document names another run than the one it was downloaded from.
  | RunningOsReceiptOfAnotherRun { stated: String, fetched_from: RunningOsReceiptProducer }

type RunningOsReceiptReading
  = RunningOsReceiptAdmitted { reading: RunningOsReading }
  | RunningOsReceiptRefused { refusal: RunningOsReceiptRefusal }

fn running_os_receipt_refusal_text(refusal: RunningOsReceiptRefusal) -> String {
  match refusal {
    RunningOsReceiptMalformed { cause: c } => concat("the running-OS receipt is malformed: ", c)
    RunningOsReceiptFieldAbsent { prefix: p } => join(["the running-OS receipt has no ", p, " line"], "")
    RunningOsReceiptLineUnexpected { line: l } => join(["the running-OS receipt carries a line its writer never states: ", l], "")
    RunningOsReceiptFieldRepeated { prefix: p, occurrences: n } => join(["the running-OS receipt has ", int_to_decimal_string(value: n), " ", p, " lines; each field is stated exactly once"], "")
    RunningOsReceiptDigestMismatch { stated: s, computed: c } => join(["the running-OS receipt states content_sha256 ", s, " but its content digests to ", c], "")
    RunningOsReceiptOfAnotherRun { stated: s, fetched_from: f } => join(["the running-OS receipt names ", s, " but was downloaded from ", running_os_receipt_producer_text(p: f)], "")
  }
}

fn running_os_receipt_malformed(cause: String) -> RunningOsReceiptReading {
  RunningOsReceiptRefused { refusal: RunningOsReceiptMalformed { cause: cause } }
}

// A NAMED FIELD IS READ ONLY WHEN IT OCCURS EXACTLY ONCE: an absent line and a repeated line are each a typed
// refusal, never a first-match pick (std.list sole_where).
type RunningOsReceiptField
  = RunningOsReceiptFieldRead { value: String }
  | RunningOsReceiptFieldRefused { refusal: RunningOsReceiptRefusal }

fn running_os_receipt_field(lines: List<String>, prefix: String) -> RunningOsReceiptField {
  match sole_where(xs: lines, keep: l => starts_with(s: l, prefix: prefix)) {
    SoleMatchOne { value: l } => RunningOsReceiptFieldRead { value: trim(s: substring(s: l, start: string_length(s: prefix), end: string_length(s: l))) }
    SoleMatchNone => RunningOsReceiptFieldRefused { refusal: RunningOsReceiptFieldAbsent { prefix: prefix } }
    SoleMatchRepeated { occurrences: n } => RunningOsReceiptFieldRefused { refusal: RunningOsReceiptFieldRepeated { prefix: prefix, occurrences: n } }
  }
}

// THE READER, given the producer the document was DOWNLOADED FROM. The digest is checked before any field is
// believed; the producer is checked before the reading is admitted.
fn running_os_receipt_reading(text: String, fetched_from: RunningOsReceiptProducer) -> RunningOsReceiptReading {
  let parts = text.split(delimiter: running_os_receipt_content_digest_prefix)
  if count(parts) != 2 {
    running_os_receipt_malformed(cause: concat("expected exactly one ", running_os_receipt_content_digest_prefix, " line"))
  } else {
    match parts.first() {
      Absent => running_os_receipt_malformed(cause: "no content before the digest line")
      Present { value: body } => match parts.last() {
        Absent => running_os_receipt_malformed(cause: "no digest after its prefix")
        Present { value: stated_raw } => {
          let stated = trim(s: stated_raw)
          let computed = running_os_receipt_content_digest(body: body)
          if stated != computed {
            RunningOsReceiptRefused { refusal: RunningOsReceiptDigestMismatch { stated: stated, computed: computed } }
          } else {
            running_os_receipt_body_reading(body: body, fetched_from: fetched_from)
          }
        }
      }
    }
  }
}

// THE FIELDS THE WRITER STATES, one row each, after the header line (running_os_receipt_body). The full shape is
// the header, then each of these exactly once, then nothing else: a field read is by prefix (running_os_receipt_field
// refuses an absent or repeated one) and every other line refuses here.
data running_os_receipt_field_prefixes: List<String> = [
  running_os_receipt_run_prefix,
  running_os_receipt_attempt_prefix,
  running_os_receipt_host_prefix,
  running_os_receipt_delivered_artifact_prefix,
  running_os_receipt_boot_prefix,
]

fn running_os_receipt_line_is_field(line: String) -> Bool {
  count(filter(running_os_receipt_field_prefixes, p => starts_with(s: line, prefix: p))) > 0
}

// The body the writer produces ends in one newline, so splitting it yields one trailing empty element and no
// other: every element after the header and before that one must be a field line.
fn running_os_receipt_unexpected_line(lines: List<String>) -> String? {
  let n = count(lines)
  let inner = lines.skip(n: 1).take(n: if n >= 2 { n - 2 } else { 0 })
  let trailing_ok = match lines.last() { Present { value: l } => l == ""  Absent => false }
  if trailing_ok == false {
    Present { value: "(the body does not end in one newline)" }
  } else {
    filter(inner, l => running_os_receipt_line_is_field(line: l) == false).first()
  }
}

fn running_os_receipt_body_reading(body: String, fetched_from: RunningOsReceiptProducer) -> RunningOsReceiptReading {
  let lines = body.split(delimiter: "\n")
  match running_os_receipt_unexpected_line(lines: lines) {
    Present { value: l } => RunningOsReceiptRefused { refusal: RunningOsReceiptLineUnexpected { line: l } }
    Absent => running_os_receipt_shaped_body_reading(lines: lines, fetched_from: fetched_from)
  }
}

fn running_os_receipt_shaped_body_reading(lines: List<String>, fetched_from: RunningOsReceiptProducer) -> RunningOsReceiptReading {
  match lines.first() {
    Absent => running_os_receipt_malformed(cause: "empty body")
    Present { value: head } =>
      if trim(s: head) != running_os_receipt_header {
        running_os_receipt_malformed(cause: concat("the first line is not ", running_os_receipt_header))
      } else {
        match running_os_receipt_field(lines: lines, prefix: running_os_receipt_run_prefix) {
          RunningOsReceiptFieldRefused { refusal: r } => RunningOsReceiptRefused { refusal: r }
          RunningOsReceiptFieldRead { value: run } => match running_os_receipt_field(lines: lines, prefix: running_os_receipt_attempt_prefix) {
            RunningOsReceiptFieldRefused { refusal: r } => RunningOsReceiptRefused { refusal: r }
            RunningOsReceiptFieldRead { value: attempt } =>
              if run != (fetched_from.run_id as String) || attempt != (fetched_from.run_attempt as String) {
                RunningOsReceiptRefused { refusal: RunningOsReceiptOfAnotherRun { stated: join(["run ", run, " attempt ", attempt], ""), fetched_from: fetched_from } }
              } else {
                running_os_receipt_facts(lines: lines)
              }
          }
        }
      }
  }
}

fn running_os_receipt_facts(lines: List<String>) -> RunningOsReceiptReading {
  match running_os_receipt_field(lines: lines, prefix: running_os_receipt_host_prefix) {
    RunningOsReceiptFieldRefused { refusal: r } => RunningOsReceiptRefused { refusal: r }
    RunningOsReceiptFieldRead { value: host } => match running_os_receipt_field(lines: lines, prefix: running_os_receipt_delivered_artifact_prefix) {
      RunningOsReceiptFieldRefused { refusal: r } => RunningOsReceiptRefused { refusal: r }
      RunningOsReceiptFieldRead { value: digest } => match running_os_receipt_field(lines: lines, prefix: running_os_receipt_boot_prefix) {
        RunningOsReceiptFieldRefused { refusal: r } => RunningOsReceiptRefused { refusal: r }
        RunningOsReceiptFieldRead { value: boot_text } => match host_boot_id_of_kernel_text(text: boot_text) {
          Absent => running_os_receipt_malformed(cause: concat("the observed boot id is not a uuid: ", boot_text))
          Present { value: boot } =>
            if host == "" || digest == "" {
              running_os_receipt_malformed(cause: "an empty host or delivered artifact digest")
            } else {
              RunningOsReceiptAdmitted { reading: RunningOsObserved {
                running: RunningDeliveredArtifact { digest: digest as NonEmptyStr },
                observed_host: host as HostIdentity,
                observed_on: boot,
              } }
            }
        }
      }
    }
  }
}
