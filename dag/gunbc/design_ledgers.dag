module gunbc.design_ledgers

// THE LEDGERS ARE NOT THE REASONING, AND ONLY ONE OF THE TWO HAS TO BE LOADED TO READ THE OTHER.
//
// DESIGN.md is reasoned serially: section 1 fixes the axioms and each later section is a
// consequence of the ones before it. Two of its sections were never consequences of anything --
// the recurring failure modes and the declared rung drops are ROSTERS, appended to by every lane
// that finds a new class or declares a new drop, and between them they had grown to 96,042 of the
// projected document's 165,482 characters. Fifty-eight percent of the file that every session
// loads on every turn, and the half that grows without bound.
//
// So they are projected HERE, and DESIGN.md keeps an index naming each row and pointing at this
// document. That is one authority with two projections, not two authorities: the rows live in
// gunbc.recurring_failure_mode and gunbc.rung_drop, both files are generated by the same
// generated-artifact phase, and neither is hand-editable. What changed is which file a reader
// pays for by default.
//
// THIS IS A RELOCATION AND ITS ORACLE IS CONTENT PRESERVATION. Every authored sentence that was in
// DESIGN.md is still generated, byte-for-byte, from the same `authored` fields. One thing is
// deliberately NOT preserved, and it is a rendering decision rather than a content one: the
// nineteen failure classes were joined into a SINGLE paragraph with " · " separators -- 29,827
// characters with no structural break anywhere in it -- and are rendered here as one list item
// each. Nothing is added and nothing is dropped; the separator becomes a line break, which is the
// difference between a roster a reader can scan and a wall a reader skips.

import std.markdown { MarkdownDocument, MarkdownBlock, HeadingBlock, TextInline, H1 }
import gunbc.plans.md_helpers { h2, h3, p, li, ul, hr }
import extdeps.languages.markdown { serialize_markdown_source }
import gunbc.recurring_failure_mode { recurring_failure_mode_roster }
import gunbc.rung_drop { rung_drop_roster }
import v2.workflow.floor_discovery { floor_discovery_tree_identity }
import gunbc.self_host_compile_phase_frontier {
  CompilePhaseFrontierEmpty,
  CompilePhaseFrontierValidated,
  CompilePhaseFrontierInvalid,
  compile_phase_frontier_standing,
  render_phase_board,
  self_host_compile_phase_frontier_receipts,
}

fn h1(text: String) -> MarkdownBlock { HeadingBlock { level: H1, inlines: [TextInline { text: text }] } }

fn preamble_blocks() -> List<MarkdownBlock> {
  [
    h1(text: "gunbc — design ledgers"),
    p(text: "Generated from `gunbc.recurring_failure_mode` and `gunbc.rung_drop`. Do not hand-edit — the generated-artifact phase adjudicates this file against those authorities. `DESIGN.md` carries the reasoning and an index into these rows; this document carries the rows in full."),
    hr(),
  ]
}

fn failure_mode_blocks() -> List<MarkdownBlock> {
  [
    h2(text: "Recurring failure modes (instances of §3–§5, kept for pattern-matching)"),
    p(text: "The citation-extraction boundary named below is bounded at mechanism grain, not unknown: code inspection finds six non-fixture helpers that mint `DeclarationRef` from caller-supplied module and declaration strings (`wet_surface_ref`, `roster_decl`, `target_decl`, `principle_ref`, `family_subject`, `coverage_subject`). Their calls are not members of the parser-visible 31 and are not silently counted as citation targets: an argument may be computed, so a textual call count is not an unchecked-citation population. Whether the cited-symbol wall reaches those wrappers through another path is unmeasured here; establishing that separate question requires a planted wrapper call and execution, not an inference from this extractor read."),
    p(text: "The landing measurement partitions the 31 parser-visible identities into **2 cited-and-syntactically-called** (`gunbc.auth.credentials`, `gunbc.auth.optional_impersonation`) and **29 cited-not-syntactically-called**. It independently partitions them by compile disposition: **25 live under `dag/`, the first and therefore entry-producing root of the existing `--source-root dag --source-root src/v2` corpus compile; 6 live under `src/v2/`, which that invocation indexes only as a dependency pool.** Because this population has no inbound import edges, those six pool-only identities are structurally unreachable by that operation. The call split is evidence, not semantic resolution: indirection may hide a call and an equal bare callee spelling may bind elsewhere. It separates an under-declaration candidate present only in the called arm from the compile-coverage deficit present in both arms. PR #9453 is the worked construction-side repair for one called specimen: the missing import was a real dependency and incidentally makes that citee enter a consumer closure. It does not repair the shared coverage class. The existing compile mechanism covers the 25 `dag/` identities by collecting every `.dag` file under its first source root as an entry regardless of inbound edges; coverage for the six `src/v2/` pool-only identities remains open. The current whole compile-route cost is UNMEASURED: the available 7 GiB figure is a rounded-up, stale lower-bound proxy from the former compile-clean floor route, not a demand measurement, and differencing it from a budget would fabricate a shortfall. The existing carrier names the re-measure trigger: a dated uncensored whole-tree peak on the compile route itself. No citation-derived edge is proposed for the not-called arm: it would manufacture reachability from the claim being checked and make the check green by construction. **THE RED EVIDENCE NO LONGER DEPENDS ON THE LIVE CREDENTIALS DEFECT.** The live 87.712s refusal remains a dated mechanism measurement, but `orphan_entry_compile_has_a_controlled_red_and_clean_control` now compiles two in-memory, caller-authored orphan entries: one undefined value must produce `CompileRefused`, and the clean peer must produce `CompileCompleted`. Repairing or importing any live retained module cannot green that discriminating pair."),
    p(text: "**THE THIRD EMIT-STAGE ESCAPE MODE NOW HAS A MEASURED POPULATION (2026-08-27), AND THE NUMBER IS 31, NOT THE 39 A TEXT SCAN SUGGESTED.** `v1_compiler.declaration_index` already derives each module's imports and typed-literal `DeclarationRef` citations from the parse sweep. Its one ingestion-derived join now reports every distinct non-fixture module cited by a different non-fixture module and reached by no import edge, with all 31 RETAINED IDENTITIES beside the count on the required parse phase. Fixture citers and targets are evidence carriers, not production authority demand; self-citation creates no consumer; both are excluded by construction. The earlier regex figure 39 was an instrument result, never an oracle: on the tree measured here its comparable scan returned 38, including six `module_path` fields that are not `DeclarationRef`s at all, while one real citation routed through the local `wet_surface_ref` wrapper lies outside the index's declared extraction boundary. Neither discrepancy is smoothed away. This bounds mode three at the exact grain the parser-backed instrument can establish; it does not bound mode one, all emit-stage diagnostics, or every possible citation spelling. **THE DISCRIMINATING EXECUTION EXISTS AND THE REQUIRED PHASE DOES NOT.** Compiling the retained `gunbc.auth.credentials` entry refused on its four known hard diagnostics in 87.712s; compiling the clean orphan control `extdeps.vendor.arm` passed in 85.119s. That pair proves entry compilation detects the class without making every legitimate orphan red. It also refuses enrollment of a serial 31-entry phase: these subjects cost about 85s each, with 21–24s (about 27%) in reconcile, not the neighbouring emit-compile row's 40–50s and ~85% reconcile over a different roster. Both measurements stand; neither is generalized across the other population. At this cost shape a whole-population serial wall is outside the admitted runner envelope, so mode three remains unprevented while its exact parser-visible remainder is now bounded and named. The construction-side candidate is citation-derived dependency edges, which would make a cited authority enter its citer's closure instead of adding a second compile; it is NOT claimed here because qualified references already prove import closure under-approximates dependency, the index deliberately does not resolve every wrapper-produced `DeclarationRef`, and the closure-growth and historical/quarantined-citation semantics have not been bounded. Its next decision requires those measurements, not a second edge authority improvised in the census."),
    ul(items: map(recurring_failure_mode_roster, r => li(text: r.authored))),
  ]
}

fn rung_drop_blocks() -> List<MarkdownBlock> {
  flat_map(
    [
      [
        h2(text: "Declared rung drops (§4b(3))"),
        p(text: "Each row declares a safety guarantee that was lowered: what stood before, what stands now, why, over what population, and the trigger that restores it. A drop is retired by its trigger and by nothing else."),
      ],
      flat_map(rung_drop_roster, d => concat([
        h3(text: concat(concat(d.subject, " — declared "), d.declared)),
        p(text: d.authored),
      ], if (d.identity as String) == "measurement_bankruptcy" {
        compile_phase_frontier_blocks()
      } else { [] })),
    ],
    bs => bs
  )
}

fn compile_phase_frontier_blocks() -> List<MarkdownBlock> {
  match compile_phase_frontier_standing(series: self_host_compile_phase_frontier_receipts) {
    CompilePhaseFrontierEmpty => [
      h3(text: "Whole-corpus compile-phase frontier receipts"),
      p(text: "No complete instrument observation has been appended; the next valid row must be the typed genesis receipt."),
    ]
    CompilePhaseFrontierInvalid { reason } => [
      h3(text: "Whole-corpus compile-phase frontier receipts — INVALID"),
      p(text: reason as String),
    ]
    CompilePhaseFrontierValidated { latest } => [
      h3(text: "Whole-corpus compile-phase frontier receipts — latest validated row"),
      p(text: concat("Milestones: ", render_phase_board(board: latest.board))),
      p(text: concat("Tree: `", concat(floor_discovery_tree_identity(tree: latest.subject.git_tree_object), "`"))),
      p(text: concat("Invocation: `", concat(latest.invocation as String, "`"))),
      p(text: concat("Census identity digest: `", concat(latest.board.census_identity_digest.digest as String, "`"))),
      p(text: concat(
        "Error identities: ",
        concat(
          to_string(latest.board.total_error_diagnostics),
          concat(
            " total = ",
            concat(
              to_string(latest.board.coded_error_diagnostics),
              concat(" coded + ", concat(to_string(latest.board.codeless_error_diagnostics), " codeless"))
            )
          )
        )
      )),
      p(text: concat("Producer: `", concat(latest.producer.module_path, concat("::", concat(latest.producer.function, "`"))))),
    ]
  }
}

fn ledger_blocks() -> List<MarkdownBlock> {
  flat_map([
    preamble_blocks(),
    failure_mode_blocks(),
    rung_drop_blocks(),
  ], bs => bs)
}

fn design_ledgers_document() -> MarkdownDocument {
  MarkdownDocument { blocks: ledger_blocks() }
}

fn expected_design_ledgers_md() -> String {
  serialize_markdown_source(doc: design_ledgers_document())
}
