  = EnrollmentSpawnCliPrivatePty
  | EnrollmentObserveBrowserChallenge {
      challenge: ClaudeSetupTokenBrowserChallenge,
    }
  | EnrollmentCaptureSetupTokenPrivate
  | EnrollmentSecretManagerAddVersion
  | EnrollmentExactVersionReadBack
  | EnrollmentCleanContextMaterialization
  | EnrollmentManagedPairedProbe
  | EnrollmentProviderStandingReceipt

type ClaudeEnrollmentWorkflowAdmission
