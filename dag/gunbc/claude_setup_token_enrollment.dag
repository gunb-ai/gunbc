data claude_setup_token_enrollment_authority_note: String = "Claude Code enrollment station workflow (operator direction 2026-08-07; revised msg_3b291a6a). The enrollment host is where the irreducible browser gesture happens — NOT the roadmap worker host. Enrollment INITIATES ONLY through the pinned Claude CLI setup-token path. This module is a STANDING PRODUCER: it emits ProviderStanding from managed enrollment; it does NOT wire OfferClaude into production dispatch inventory (WorkerTurn PR). NO WorkerTurn and NO UI workflow progress in this slice."

data claude_enrollment_no_invented_binding_note: String = "HARD PROHIBITION (msg_3b291a6a): no exact enrollment host, GCP project, secret ID, or Unix service-principal binding is established anywhere in this module. Operator proposals (claude-personal-max, claude-code-oauth-personal-max, gunbai-secrets) are NOT selected values. Model the shape; leave values unbound; refuse rather than default."

data claude_ambient_oauth_home_separate_lifecycle_note: String = "Ambient claudeAiOauth home (refresh/access state, finite refresh-token expiry) may mutate in normal operation — write-back behaviour for THAT realization must be MEASURED, not assumed. CLAUDE_CODE_OAUTH_TOKEN from setup-token is supplied through environment with NO evidence the runtime mutates or rotates it; setup-token standing uses ClaudeSetupTokenStanding, not the ambient OAuth write-back path."

data claude_enrollment_no_provider_authenticated_literal_note: String = "Acceptance: no authored ProviderAuthenticated literal from extdeps.llm.cli_lifecycle exists anywhere in this workflow. Authentication standing is projected into gunbc.provider_standing ProviderAuthenticationStanding only."

type ClaudeSetupTokenStanding
  = SetupTokenUsable
  | SetupTokenRejected { reason: NonEmptyStr }
  | SetupTokenExpiryObserved { expires_at: NonEmptyStr }
  | SetupTokenRotationSemanticsUnobserved

type ClaudeCredentialStanding
  = ClaudeCredentialUsable
  | ClaudeCredentialExpiringSoon { detail: NonEmptyStr }
  | ClaudeCredentialRejected { reason: NonEmptyStr }
  | ClaudeCredentialObservationRefused { reason: NonEmptyStr }

type ClaudeProviderEnrollmentAction
  = ConnectClaude
  | ReconnectClaude { cause: NonEmptyStr }
  | EnrollmentActionNotRequired

type ClaudeEnrollmentHostPlacement
  = EnrollmentHostUnbound
  | EnrollmentHostSpecified { hostname: NonEmptyStr }

type ClaudeEnrollmentUnixServicePrincipal
  = EnrollmentUnixPrincipalUnbound
  | EnrollmentUnixPrincipalSpecified { principal: NonEmptyStr }

type ClaudeEnrollmentSecretTarget
  = EnrollmentSecretTargetUnbound
  | EnrollmentSecretTargetSpecified {
      project: NonEmptyStr,
      secret: NonEmptyStr,
    }

type ClaudeExactSecretVersionBinding {
  project: NonEmptyStr,
  secret: NonEmptyStr,
  version: NonEmptyStr,
  private_content_identity: NonEmptyStr,
}

type ClaudeEnrollmentPrincipalPopulation
  = EnrollmentPrincipalPopulationDerived { members: List<NonEmptyStr> }
  | EnrollmentPrincipalPopulationDeploymentModelGap {
      reason: NonEmptyStr,
    }

type ClaudeEnrollmentRuntimeBinding {
  executable: NonEmptyStr,
  version_pin: NonEmptyStr,
}

type ClaudeEnrollmentPlacement {
  host: ClaudeEnrollmentHostPlacement,
  run_as: ClaudeEnrollmentUnixServicePrincipal,
  enrollment_root: FilePath,
  account_label: NonEmptyStr,
  secret_target: ClaudeEnrollmentSecretTarget,
  writer: ClaudeEnrollmentPrincipalPopulation,
  readers: ClaudeEnrollmentPrincipalPopulation,
  claude_runtime: ClaudeEnrollmentRuntimeBinding,
  sdk_runtime: ClaudeEnrollmentRuntimeBinding,
}

type ClaudeEnrollmentOperatorChoices {
  enrollment_host: NonEmptyStr?,
  run_as_principal: NonEmptyStr?,
  gcp_project: NonEmptyStr?,
  secret_id_or_create_authorization: NonEmptyStr?,
  account_label: NonEmptyStr?,
}

type ClaudeEnrollmentPlacementAdmission
  = EnrollmentPlacementAdmitted { placement: ClaudeEnrollmentPlacement }
  | EnrollmentPlacementRefusedUnbound { missing_axes: List<NonEmptyStr> }

type ClaudeEnrollmentSession {
  placement: ClaudeEnrollmentPlacement,
  standing_fact_id: RecordedFactId,
}

type ClaudeEnrollmentInitiationSurface
  = EnrollmentInitiationClaudeCli
  | EnrollmentInitiationSdkAttempt

type ClaudeEnrollmentInitiationAdmission
  = EnrollmentInitiationAdmitted
  | EnrollmentInitiationRefusedSdkPath {
      reason: NonEmptyStr,
    }

type ClaudeAmbientOAuthArtifactDigest {
  digest: NonEmptyStr
}

type ClaudeAmbientOAuthArtifactObservationPair {
  before_use: ClaudeAmbientOAuthArtifactDigest,
  after_use: ClaudeAmbientOAuthArtifactDigest,
}

type ClaudeAmbientOAuthHomeWriteBackAdmission
  = AmbientOAuthWriteBackAdmitted {
      prior: ClaudeAmbientOAuthArtifactDigest,
      observed: ClaudeAmbientOAuthArtifactDigest,
    }
  | AmbientOAuthWriteBackRefusedUnchanged {
      digest: ClaudeAmbientOAuthArtifactDigest,
    }
  | AmbientOAuthWriteBackRefusedMissingObservation {
      reason: NonEmptyStr,
    }

type ClaudeEnrollmentColdStartAdmission
  = EnrollmentColdStartAdmitted
  | EnrollmentColdStartRefusedAmbientPrerequisite {
      reason: NonEmptyStr,
    }

type ClaudeEnrollmentWriterLeaseEpoch {
  holder: NonEmptyStr
  epoch: Int
  binding_version: NonEmptyStr
}

type ClaudeEnrollmentWriterLeaseAdmission
  = EnrollmentLeaseGranted { holder: NonEmptyStr, epoch: Int }
  | EnrollmentLeaseRefusedConcurrent {
      incumbent_holder: NonEmptyStr,
      incumbent_binding_version: NonEmptyStr,
      incumbent_epoch: Int,
    }
  | EnrollmentLeaseRefusedNewerBindingExists {
      incumbent_version: NonEmptyStr,
      attempted_version: NonEmptyStr,
    }

type ClaudeEnrollmentWriterLeasePublishAdmission
  = EnrollmentLeasePublishGranted
  | EnrollmentLeasePublishRefusedStaleEpoch {
      holder_epoch: Int,
      current_epoch: Int,
    }

type ClaudeSetupTokenCaptureAdmission
  = SetupTokenCaptureAdmitted { token_length: CharacterCount }
  | SetupTokenCaptureRefusedMultipleCandidates { count: Int }
  | SetupTokenCaptureRefusedMalformedPrefix
  | SetupTokenCaptureRefusedMalformedLength {
      observed: CharacterCount,
      min: CharacterCount,
      max: CharacterCount,
    }
  | SetupTokenCaptureRefusedFormatUnobserved { reason: NonEmptyStr }
  | SetupTokenCaptureRefusedNoCandidate

type ClaudeEnrollmentSecretVersionAdmission
  = EnrollmentSecretVersionAdmitted
  | EnrollmentSecretVersionRefusedLatest
  | EnrollmentSecretVersionRefusedEmpty

type ClaudeEnrollmentSecretWriteOutcome
  = EnrollmentSecretWritten { version: NonEmptyStr }
  | EnrollmentSecretWriteRefused { reason: NonEmptyStr }

type ClaudeEnrollmentSecretReadBackOutcome
  = EnrollmentSecretReadBackOk {
      version: NonEmptyStr,
      private_content_identity: NonEmptyStr,
      digest_matches: Bool,
    }
  | EnrollmentSecretReadBackRefused { reason: NonEmptyStr }

type ClaudeExactSecretVersionBindingAdmission
  = ExactSecretVersionBindingAdmitted {
      binding: ClaudeExactSecretVersionBinding,
    }
  | ExactSecretVersionBindingRefusedWrite { reason: NonEmptyStr }
  | ExactSecretVersionBindingRefusedReadBack { reason: NonEmptyStr }
  | ExactSecretVersionBindingRefusedDigestMismatch

