  | EnrollmentWorkflowRefusedPlacementUnbound { missing_axes: List<NonEmptyStr> }
  | EnrollmentWorkflowRefusedDeploymentModelGap { reason: NonEmptyStr }
  | EnrollmentWorkflowRefusedHostEffectsScaffold { stage: NonEmptyStr }

type ClaudeIsolationPathObservation
  = IsolationPathObserved { paths_read: List<FilePath> }
  | IsolationPathObservationRefused { reason: NonEmptyStr }

