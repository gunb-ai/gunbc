module gunbc.roadmap_execution_contract

import std.types { String, NonEmptyStr, List, FilePath, Bool }
import gunbc.ensure { EnsurePolicy }

type ExecutionCapability
  = GitWorkspaceCapability
  | TmuxSessionCapability
  | TmuxPipeShellCapability
  | TeeEventCaptureCapability
  | ProviderEventProjectionCapability
  | EnvironmentBindingCapability
  | AttemptStateDirectoryCapability
  | AttemptCurrentPointerCapability
  | GunbcClaimRunnerCapability
  | CargoCapability
  | RustcCapability
  | RustfmtCapability
  | RustupCapability

type ValidationOperation
  = GunbcClaimValidation {
      entry: FilePath,
      function: NonEmptyStr,
    }
  | CargoTestValidation { filter: NonEmptyStr }
  | CargoFmtValidation

type WorkItemExecutionContract
  = ExecutionContractUnspecified
  | ExecutionContract {
      validations: List<ValidationOperation>,
      extra_capabilities: List<ExecutionCapability>,
    }

type CapabilityRealization {
  capability: ExecutionCapability
  executable: FilePath
  identity_args: List<String>
  identity_contains: NonEmptyStr
  ensure_policy: EnsurePolicy
}

type DispatchHostEnvironment {
  realizations: List<CapabilityRealization>
}

type ModeledValidationCommand {
  label: NonEmptyStr
  program: FilePath
  args: List<String>
}

data work_item_execution_contract_note: String = "A work item names semantic validation operations, never an opaque prompt fragment. Task capabilities derive from those closed variants; the provider prompt and the post-provider verifier are projections of the same operations. The dispatch platform separately contributes its fixed workspace/session/capture capabilities at admission, so those mechanics do not leak into every work-item contract. HostDashboardInstance resolves every joined semantic capability to an exact executable plus identity probe and Ensure policy. ExecutionContractUnspecified is an explicit migration state and dispatch refusal, never a repository-wide guessed default. In particular, a DAG task does not acquire Cargo merely because the repository is implemented in Rust."

fn execution_capability_label(capability: ExecutionCapability) -> String {
  match capability {
    GitWorkspaceCapability => "git-workspace"
    TmuxSessionCapability => "tmux-session"
    TmuxPipeShellCapability => "tmux-pipe-shell"
    TeeEventCaptureCapability => "tee-event-capture"
    ProviderEventProjectionCapability => "provider-event-projection"
    EnvironmentBindingCapability => "environment-binding"
    AttemptStateDirectoryCapability => "attempt-state-directory"
    AttemptCurrentPointerCapability => "attempt-current-pointer"
    GunbcClaimRunnerCapability => "gunbc-claim-runner"
    CargoCapability => "cargo"
    RustcCapability => "rustc"
    RustfmtCapability => "rustfmt"
    RustupCapability => "rustup"
  }
}

fn execution_capability_equal(
  a: ExecutionCapability,
  b: ExecutionCapability,
) -> Bool {
  execution_capability_label(capability: a) == execution_capability_label(capability: b)
}

fn capability_append_unique(
  capabilities: List<ExecutionCapability>,
  capability: ExecutionCapability,
) -> List<ExecutionCapability> {
  if any(
    capabilities,
    existing => execution_capability_equal(a: existing, b: capability),
  ) {
    capabilities
  } else {
    append(capabilities, [capability])
  }
}

fn validation_required_capabilities(
  validation: ValidationOperation,
) -> List<ExecutionCapability> {
  match validation {
    GunbcClaimValidation { entry: _, function: _ } =>
      [GunbcClaimRunnerCapability]
    CargoTestValidation { filter: _ } =>
      [CargoCapability, RustcCapability]
    CargoFmtValidation =>
      [CargoCapability, RustfmtCapability]
  }
}

fn execution_contract_required_capabilities(
  contract: WorkItemExecutionContract,
) -> List<ExecutionCapability> {
  match contract {
    ExecutionContractUnspecified => []
    ExecutionContract { validations, extra_capabilities } =>
      let required = fold(
        validations,
        init: extra_capabilities,
        f: fn(acc, validation) {
          concat(
            acc,
            validation_required_capabilities(validation: validation),
          )
        },
      )
      fold(
        required,
        init: [],
        f: fn(acc, cap) {
          capability_append_unique(
            capabilities: acc,
            capability: cap,
          )
        },
      )
  }
}

data contract_closure_note: String = "ONE BINDING LAW, BECAUSE THERE WERE THREE AND THEY DISAGREED. Whether a contract closes anything was decided independently in three places and two answers were given. gunbc.roadmap_authority's node_lacks_closing_validation treated ANY ExecutionContract as bound, so a contract declaring an empty validation list counted as closed; gunbc.roadmap_verify treated the empty list as unbound; gunbc.roadmap_dispatch_environment refused it with its own reason. Empty lists are constructible — nothing stops ExecutionContract with no validations from being written — so the disagreement is reachable rather than theoretical.\\n\\nThe consequence lands on the acceptance frontier. A node bound to an empty contract disappears from nodes_needing_acceptance, because the projection reads it as bound; the verifier then reports it Unbound, and dispatch refuses to admit an environment for it. The node is simultaneously finished, unverifiable and undispatchable, and no single reading of the model says so.\\n\\nThis is the one decision, and it returns a THREE-valued closure rather than a Bool because the two unclosed states have different remedies — author a contract, versus fix the contract you authored — and dispatch_environment's located diagnostics depend on telling them apart. contract_has_closing_validation is the Bool projection for the callers that genuinely only need the predicate. No consumer re-derives either from the coproduct's shape.\\n\\nNo behaviour changes on today's corpus: all four bound nodes route through gunbc_claim_execution_contract, which always emits exactly one validation. The de-fork is what keeps that true when the fifth binding is written by hand."

type ContractClosure
  = ContractDeclaresNoValidation
  | ContractClosesNothing
  | ContractCloses { validations: List<ValidationOperation> }

fn contract_closure(contract: WorkItemExecutionContract) -> ContractClosure {
  match contract {
    ExecutionContractUnspecified => ContractDeclaresNoValidation
    ExecutionContract { validations, extra_capabilities: _ } =>
      if count(validations) == 0 {
        ContractClosesNothing
      } else {
        ContractCloses { validations: validations }
      }
  }
}

fn contract_has_closing_validation(contract: WorkItemExecutionContract) -> Bool {
  match contract_closure(contract: contract) {
    ContractCloses { validations: _ } => true
    ContractClosesNothing => false
    ContractDeclaresNoValidation => false
  }
}

fn dispatch_platform_required_capabilities() -> List<ExecutionCapability> {
  [
    GitWorkspaceCapability,
    TmuxSessionCapability,
    TmuxPipeShellCapability,
    TeeEventCaptureCapability,
    ProviderEventProjectionCapability,
    EnvironmentBindingCapability,
    AttemptStateDirectoryCapability,
    AttemptCurrentPointerCapability,
  ]
}

fn dispatch_required_capabilities(
  contract: WorkItemExecutionContract,
) -> List<ExecutionCapability> {
  match contract {
    ExecutionContractUnspecified => []
    ExecutionContract { validations: _, extra_capabilities: _ } =>
      fold(
        concat(
          dispatch_platform_required_capabilities(),
          execution_contract_required_capabilities(contract: contract),
        ),
        init: [],
        f: fn(acc, cap) {
          capability_append_unique(
            capabilities: acc,
            capability: cap,
          )
        },
      )
  }
}

fn gunbc_claim_execution_contract(
  entry: FilePath,
  function: NonEmptyStr,
) -> WorkItemExecutionContract {
  ExecutionContract {
    validations: [
      GunbcClaimValidation {
        entry: entry,
        function: function,
      },
    ],
    extra_capabilities: [],
  }
}

fn cargo_test_execution_contract(
  filter: NonEmptyStr,
) -> WorkItemExecutionContract {
  ExecutionContract {
    validations: [CargoTestValidation { filter: filter }],
    extra_capabilities: [],
  }
}

fn dispatch_host_realization(
  environment: DispatchHostEnvironment,
  capability: ExecutionCapability,
) -> CapabilityRealization? {
  environment.realizations
    |> filter(realization =>
      execution_capability_equal(
        a: realization.capability,
        b: capability,
      ))
    |> first
}

fn validation_operation_command(
  validation: ValidationOperation,
  environment: DispatchHostEnvironment,
) -> ModeledValidationCommand? {
  match validation {
    GunbcClaimValidation { entry, function } =>
      match dispatch_host_realization(
        environment: environment,
        capability: GunbcClaimRunnerCapability,
      ) {
        Present { value: realization } =>
          Present { value: ModeledValidationCommand {
            label: "gunbc-claim" as NonEmptyStr,
            program: realization.executable,
            args: [
              "run",
              "--source-root", "dag",
              "--source-root", "src/v2",
              "--entry", entry as String,
              "--function", function as String,
              "--claim-run",
            ],
          } }
        Absent => none
      }
    CargoTestValidation { filter } =>
      match dispatch_host_realization(
        environment: environment,
        capability: CargoCapability,
      ) {
        Present { value: realization } =>
          Present { value: ModeledValidationCommand {
            label: "cargo-test" as NonEmptyStr,
            program: realization.executable,
            args: ["test", filter as String],
          } }
        Absent => none
      }
    CargoFmtValidation =>
      match dispatch_host_realization(
        environment: environment,
        capability: CargoCapability,
      ) {
        Present { value: realization } =>
          Present { value: ModeledValidationCommand {
            label: "cargo-fmt" as NonEmptyStr,
            program: realization.executable,
            args: ["fmt", "--all", "--check"],
          } }
        Absent => none
      }
  }
}

fn modeled_validation_command_wire(command: ModeledValidationCommand) -> String {
  join(
    concat([command.program as String], command.args),
    " ",
  )
}

fn execution_contract_validation_summary(
  contract: WorkItemExecutionContract,
  environment: DispatchHostEnvironment,
) -> String {
  match contract {
    ExecutionContractUnspecified => "execution contract unspecified"
    ExecutionContract { validations, extra_capabilities: _ } =>
      join(
        map(
          validations,
          validation =>
            match validation_operation_command(
              validation: validation,
              environment: environment,
            ) {
              Present { value: command } =>
                modeled_validation_command_wire(command: command)
              Absent =>
                "validation command has no host capability realization"
            },
        ),
        "\n",
      )
  }
}

fn validation_consumes_affected_set_window(validation: ValidationOperation) -> Bool {
  match validation {
    GunbcClaimValidation { entry: _, function: _ } => true
    CargoTestValidation { filter: _ } => false
    CargoFmtValidation => false
  }
}

fn execution_contract_needs_diff_window(contract: WorkItemExecutionContract) -> Bool {
  match contract {
    ExecutionContractUnspecified => false
    ExecutionContract { validations, extra_capabilities: _ } =>
      any(
        validations,
        validation => validation_consumes_affected_set_window(validation: validation),
      )
  }
}
