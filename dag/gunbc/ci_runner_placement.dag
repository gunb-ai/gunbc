type WorkloadClass
  = BatchLatencyTolerant
  | InteractiveLatencySensitive

data gunbc_ci_cpu_weight_unit_modeling_marker: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "std.measure",
    decl_name: "Measure",
    field: WholeDeclaration
  }
}

fn workload_class_cpu_weight(wc: WorkloadClass) -> Int {
  match wc {
    BatchLatencyTolerant => 100
    InteractiveLatencySensitive => 1000
  }
}

// 🟡 feature:task-count-measure-carrier dissolve-on: TaskCount measure carrier — per_runner_tasks_max is a pids-controller
// COUNT riding a bare Int while its memory siblings carry ByteSize; same dissolution as
// the ConvergeTarget.PerSlotMemoryCap → PerSlotUnitProperty P3 axis rework (a std.measure
// TaskCount, the HardwareThreadCount shape), which also retires the to_string() re-serialization
// at the host_converge knob seam.
type RunnerHostDeployment {
  identity: HostIdentity
  runner_count: Int
  runner_slice_cap: ByteSize
  per_runner_memory_cap: ByteSize
  per_runner_memory_swap_cap: ByteSize
  per_runner_memory_high_cap: ByteSize
  per_runner_tasks_max: Int
  build_tokens: HardwareThreadCount
  runner: RunnerSpec
  workload_class: WorkloadClass
}

type RunnerDeploymentPlan
  = PlanDerived { hosts: List<RunnerHostDeployment>, fleet_concurrent_runs: Int }
  | PlanUnsound { reason: String }


type DeploymentAccumulator {
  deployments: List<RunnerHostDeployment>
  unsound_reason: String
  any_unfit: Bool
  total: Int
}

type SessionSliceResolution
  = SessionSliceResolved { bytes: ByteSize, per_session_cap: ByteSize, concurrency: Int }
  | SessionSliceUnresolved { reason: String }

fn resolve_regime1_slice(c: ByteSize, n: Int) -> SessionSliceResolution {
  if byte_size_count(b: c) == 0 {
    SessionSliceUnresolved { reason: "per-session cap is zero bytes: refuse a degenerate sessions-slice" }
  } else if n <= 0 {
    SessionSliceUnresolved { reason: "session concurrency is non-positive: refuse a degenerate sessions-slice" }
  } else {
    SessionSliceResolved {
      bytes: measure_scale_fraction_floor(m: c, num: n, den: 1),
      per_session_cap: c,
      concurrency: n,
    }
  }
}

fn resolve_session_slice(mode: SessionReservationMode, oomd: OomdEnforcementEvidence) -> SessionSliceResolution {
  match mode {
    SessionReservationModeUnset =>
      SessionSliceUnresolved {
        reason: "session reservation mode unset: the per-session budget is an operator operating-point choice (REGIME-1 worst-case cap C * concurrency N, or REGIME-2 measured aggregate with C as the oomd eviction ceiling) grounded in the measured distribution (min 0.28 / median ~2.06 / max 8.27 GiB); refuse to derive the host sessions-slice (and therefore the conserving runner count) until gunbc_ci_session_reservation_mode is set. See the operating curve in the manifest."
      }
    Regime1WorstCase { point: p } =>
      match p {
        SessionOperatingPointUnset =>
          SessionSliceUnresolved { reason: "REGIME-1 operating point unset: refuse to derive a worst-case sessions-slice without a (cap, concurrency) pair" }
        SessionOperatingPointSet { per_session_cap: c, session_concurrency: n } =>
          resolve_regime1_slice(c: c, n: n)
      }
    Regime2AggregateOomd { oomd_eviction_ceiling: ceiling, session_concurrency: n, aggregate_reservation: agg } =>
      match oomd {
        OomdUnverified =>
          SessionSliceUnresolved { reason: "REGIME-2 keystone unmet: it over-commits the per-session caps, so it is unsound until per-cgroup memory.max + systemd-oomd eviction is verified live on the hosts (gunbc_fleet_oomd_evidence = OomdUnverified). Fail closed; do NOT reserve the smaller aggregate without the runtime eviction floor." }
        OomdEnforced =>
          match agg {
            SessionAggregateUnmeasured =>
              SessionSliceUnresolved { reason: "REGIME-2 aggregate-concurrent-peak series unmeasured: refuse to derive the aggregate sessions-slice without a measured realistic concurrent peak (the 13 per-session samples are NOT an aggregate). Fail closed." }
            SessionAggregateMeasured { bytes: agg_bytes } =>
              if byte_size_count(b: agg_bytes) == 0 {
                SessionSliceUnresolved { reason: "REGIME-2 measured aggregate is zero bytes: refuse a degenerate sessions-slice" }
              } else if byte_size_count(b: ceiling) == 0 {
                SessionSliceUnresolved { reason: "REGIME-2 oomd eviction ceiling is zero bytes: refuse a degenerate per-session ceiling" }
              } else if n <= 0 {
                SessionSliceUnresolved { reason: "REGIME-2 session concurrency is non-positive: refuse a degenerate admitted-session target" }
              } else {
                SessionSliceResolved {
                  bytes: agg_bytes,
                  per_session_cap: ceiling,
                  concurrency: n,
                }
              }
          }
      }
  }
}

data gunbc_ci_runner_count_from_budget_disposition: Disposition = Terminal { reason: "DESIGN conservation model: the runner count divides the DECLARED runner_pool_budget by the DECLARED per_runner_memory_cap (gunbc.fleet_host_budget). Soundness is host_allocation_verdict (node_conserves over runner_pool + session_pool + fixed_overhead + headroom + the control-plane charge <= host RAM), consumed as a coproduct so an unmeasured resident reports a measurement to take rather than a capacity deficit; it replaces the old chicken-and-egg RunnerSlotUnenforced gate (which refused to derive a count premised on a cap not yet enforced live). 'Is the cap live on the host' is no longer a plan-soundness question - it is a converge-receipt question. Session pool is charged by host_session_slice_bytes, which derives from gunbc.ci_floor_measurement gunbc_ci_session_reservation_mode and refuses when it cannot size the charge. THIS CLAUSE PREVIOUSLY READ 'the uniform 1 GiB demand class shared with the ctrl session dashboard' and that was false in both halves: the ctrl session dashboard's per-container cap is gunbc_ci_dashboard_session_container_cap (33578549248, 31.27 GiB), 31x the figure this clause claimed it shared, and the 1 GiB figure named a gunbc.fleet_host_budget literal that no derivation and no citation supported. It also sat below the measured per-session median (~2.06 GiB, distribution min 0.28 / max 8.27), so a budget folding it under-charged a typical session by more than half while the conservation verdict above returned true. The literal is deleted (gunbc.fleet_host_budget session_container_memory_deleted_note); this clause is corrected rather than dropped because a sentence asserting that two carriers hold one class is exactly the invented relation that made the wrong number look sourced." }

fn host_fixed_overhead_bytes(o: HostFixedOverhead) -> ByteSize {
  match o {
    HostFixedOverheadMeasured { bytes: b, provenance: _ } => b
    HostFixedOverheadAllowance { bytes: b, reason: _ } => b
    HostFixedOverheadUnmeasured => byte_size(0)
  }
}

// host_fixed_overhead_bytes maps Unmeasured to ZERO BYTES, and that arm is a fail-open this module must not consume directly. Zero overhead makes a host look like it has its entire RAM available for runners, which is the most permissive possible answer to a question nobody answered — the absorbing fallback in the input to a conservation wall. The arm is retained because the function is a total projection and callers legitimately fold over it, but accumulate_conservation_deployment refuses on Unmeasured BEFORE reaching it (host_overhead_or_refusal), so the zero is unreachable on the plan path. Retained rather than deleted because deleting it would only move the totality problem to every caller.
type HostOverheadResolution
  = HostOverheadResolved { bytes: ByteSize }
  | HostOverheadUnresolved { reason: String }

fn host_overhead_or_refusal(host: HostIdentity, o: HostFixedOverhead) -> HostOverheadResolution {
  match o {
    HostFixedOverheadMeasured { bytes: b, provenance: _ } => HostOverheadResolved { bytes: b }
    HostFixedOverheadAllowance { bytes: b, reason: _ } => HostOverheadResolved { bytes: b }
    HostFixedOverheadUnmeasured =>
      HostOverheadUnresolved {
        reason: concat("host fixed overhead is unmeasured and carries no operator allowance, so the share of RAM this host spends on residents the budget does not model is unknown: refuse to derive a runner width rather than charge zero (which would silently hand the host its whole RAM) or borrow another host's number. Classify it in gunbc.ci_floor_measurement gunbc_ci_host_fixed_overhead_for. Host: ", host)
      }
  }
}

fn conservation_host_deployment(offer: ComputeOffer, nproc: HardwareThreadCount) -> RunnerHostDeployment {
  RunnerHostDeployment {
    identity: offer.supply.physical.identity,
    runner_count: declared_runner_count_for(host: offer.supply.physical.identity),
    runner_slice_cap: gunbc_runner_pool_budget_for(host: offer.supply.physical.identity),
    per_runner_memory_cap: gunbc_ci_runner_cgroup_memory_cap,
    per_runner_memory_swap_cap: gunbc_runner_slot_desired().memory_swap_max,
    per_runner_memory_high_cap: gunbc_runner_slot_desired().memory_high,
    per_runner_tasks_max: gunbc_runner_slot_desired().tasks_max,
    build_tokens: nproc,
    runner: runner_spec_from_offer(offer: offer),
    workload_class: BatchLatencyTolerant,
  }
}

data host_session_slice_source_note: String = "WHICH HOSTS OWE A SESSIONS RESERVATION comes from gunbc.session_residency, the authority for where interactive session containers actually live. It does NOT come from the build-cache roster, and the correction is recorded because the proxy came within one cleanup of causing the bug this charge exists to prevent.\n\nThe original derivation asked whether gunbc.build_cache_instance listed an InteractiveSessionCompiles instance for the host. That correlated with session residency and nothing more. When ctrl-sccache.service was deleted from srv1 and srv2 on 2026-08-06 as provably dead — 29MB in 45 days, zero connections, zero writes in a week, because containers cache to their own in-container path — the obvious follow-up of dropping those roster rows would have stopped charging both hosts their 20GiB reservation, and the conservation wall would then have admitted 7 slots each and overcommitted them by ~17GiB while returning true.\n\nSessions consume host RAM whether or not a shared build cache exists for them; srv1 and srv2 were each running 19 session containers at the moment their session cache was found dead. The charge follows residency.\n\nTHE RESERVATION SIZE remains a separate and unsettled question: gunbc.ci_floor_measurement gunbc_ci_session_reservation_mode declares a Regime-2 aggregate of exactly 21474836480 bytes, a round power of two with the same signature as the fixed-overhead literal this change already split, and no derivation from the thirteen measured per-session samples beside it. It is charged as declared because charging it is strictly safer than the zero it replaced. Dissolve-on: a measured concurrent-peak series."

data host_session_slice_refuses_rather_than_charging_zero_note: String = "AN UNSIZED SESSION SLICE ON A SESSION HOST REFUSES, because the alternative is the bug this change exists to remove, re-entering through a different door. The first draft of this function returned byte_size(0) whenever the reservation mode could not produce a number — SessionAggregateUnmeasured, SessionOperatingPointUnset, SessionReservationModeUnset — which reads as 'sessions cost nothing' and is exactly the unconditional zero that let srv1 and srv2 score as though 20GiB of reservation were free. Fixing the WHERE (a host carries sessions) while leaving the HOW MUCH silently zero would have moved the defect rather than closed it.\n\nThe distinction the arms preserve: a host with NO session instance genuinely owes nothing, and SessionSliceNotApplicable says so. A host that DOES carry one and cannot size it is unknown, not free, and SessionSliceUnsized refuses the whole plan with a located reason. Those are different states and one of them is safe.\n\nToday every arm resolves — the declared Regime-2 aggregate is present — so this refusal is dormant. It is written anyway because the mode is one edit from unmeasured and the cost of the fail-open version is a fleet that overcommits its two tightest hosts while every wall returns true."

type HostSessionSliceResolution
  = SessionSliceCharged { bytes: ByteSize }
  | SessionSliceNotApplicable
  | SessionSliceUnsized { reason: String }

fn session_reservation_declared_bytes() -> ByteSize? {
  match gunbc_ci_session_reservation_mode {
    Regime2AggregateOomd { oomd_eviction_ceiling: _, session_concurrency: _, aggregate_reservation: agg } =>
      match agg {
        SessionAggregateMeasured { bytes: b } => Present { value: b }
        SessionAggregateUnmeasured => none
      }
    Regime1WorstCase { point: p } =>
      match p {
        SessionOperatingPointSet { per_session_cap: c, session_concurrency: n } =>
          Present { value: measure_scale_fraction_floor(m: c, num: n, den: 1) }
        SessionOperatingPointUnset => none
      }
    SessionReservationModeUnset => none
  }
}

fn host_session_slice_resolution(host: HostIdentity) -> HostSessionSliceResolution {
  if host_carries_interactive_sessions(host: host) {
    match session_reservation_declared_bytes() {
      Present { value: b } => SessionSliceCharged { bytes: b }
      Absent =>
        SessionSliceUnsized {
          reason: concat("host runs interactive session containers (gunbc.session_residency host_session_residency) but gunbc_ci_session_reservation_mode yields no reservation size, so the largest non-runner claim on this host is unknown: refuse to derive a runner width rather than charge zero for it. Host: ", host)
        }
    }
  } else {
    SessionSliceNotApplicable
  }
}

fn host_session_slice_bytes(host: HostIdentity) -> ByteSize {
  match host_session_slice_resolution(host: host) {
    SessionSliceCharged { bytes: b } => b
    SessionSliceNotApplicable => byte_size(0)
    SessionSliceUnsized { reason: _ } => byte_size(0)
  }
}

data host_usable_ram_note: String = "CONSERVATION IS CHECKED AGAINST OS-USABLE RAM, NOT THE DIMM TOTAL. compute_host_ram_bytes_total sums the populated modules -- nominal capacity -- while the OS sees less after firmware and kernel reservations, and gunbc.ci_fleet fleet_host_memory_nominal_vs_usable_note exists specifically to say these are two facts that must not be conflated. The margin decides admissions rather than being academic: at the 128 GiB nominal / 125 GiB usable population this fleet carried until 2026-08-22, an eighth 14 GiB slot summed to 125.6 GiB, which PASSED against nominal and FAILED against usable -- so checking the nominal figure would admit a width the machine cannot carry, by spending memory that does not exist.\n\nTHE UNIFORM-POPULATION PREMISE HAS NOW ACTUALLY FALSIFIED, AND THIS PARAGRAPH IS THE THIRD REVISION OF THAT CLAIM -- which is itself the finding. The premise was: every host on the same board at the same population, so one figure stands in for all four. It was declared falsified once on an in-flight report of a DIMM replacement, then RESTORED when that replacement was reported failed (operator, 2026-08-12), with a note saying that marking a true statement historical is the same defect as leaving a false one live. Both of those were correct at the time. Both are now superseded by measurement: srv3 and srv4 were each read at 512 GiB over BMC Redfish on 2026-08-22 (8 x Samsung M393A8G40D40-CRB, one per channel), srv1 was upgraded to the same population on operator report, and srv2's identical attempt failed memory training and was reverted to 8 x 16 GiB Hynix. The fleet is HETEROGENEOUS as of that date and the premise is dead for the first time in this note's history.\n\nWHAT THAT DOES NOT LICENSE, because it is the move this note has always existed to forbid: the 512 GiB figure is NOMINAL DIMM CAPACITY read from a management controller. It is NOT OS-usable RAM and must not be written into gunbc_ci_host_usable_ram_for. The gap was closed on two hosts the only way it can be: srv3 and srv4 now carry MEASURED usable RAM from /proc/meminfo reads taken over SSH on 2026-08-22, about 502.25 GiB each -- roughly 10 GiB BELOW their nominal 512, which is exactly the firmware-and-kernel reservation this note exists to preserve. srv1 and srv2 have had no such read, so their rows remain conservative lower bounds and the wall keeps admitting the widths it admitted yesterday on those two. srv1's bound is now SOUND and USELESSLY CONSERVATIVE at the same time -- 125 GiB is still a true lower bound for a 512 GiB host -- and it closes with one ordinary /proc/meminfo read, never by promoting a Redfish number.\n\nWHAT THE PER-HOST GRAIN RESTS ON is therefore still not this trigger, and the heterogeneity does not retroactively justify the grain. It is that this wall folded over per-host offers and then read RAM from a synthetic machine outside that fold, and that an unclassified host borrowed rather than refused -- see gunbc.ci_floor_measurement gunbc_ci_host_usable_ram_kind_note. A per-host fact belonged at per-host grain when the hosts were identical; it merely became visible when they stopped being."

// The grain here is per host, and the reason is not that the hosts differ. This wall folds over
// per-host offers and charges each host its own overhead and session slice, then read RAM from a
// synthetic ComputeHost that is not a member of that fold and does not exist — so the arithmetic
// was right while one of its premises named the wrong subject. A fleet-wide shape was wrong
// because it could not EXPRESS a per-host difference, not because one had appeared.
//
// The unresolved arm refuses rather than borrowing, for the reason the overhead axis beside it
// gives: a fabricated premise under correct arithmetic is the worst place for an absorbing
// fallback, because the wall returns true and the machine OOMs.
type HostUsableRamResolution
  = HostUsableRamResolved { bytes: ByteSize }
  | HostUsableRamUnresolved { reason: String }


fn host_usable_ram_or_refusal(host: HostIdentity, r: HostUsableRam) -> HostUsableRamResolution {
  match r {
    HostUsableRamMeasured { bytes: b, provenance: _ } => HostUsableRamResolved { bytes: b }
    HostUsableRamConservativeLowerBound { bytes: b, basis: _ } => HostUsableRamResolved { bytes: b }
    HostUsableRamUnmeasured =>
      HostUsableRamUnresolved {
        reason: concat("host OS-usable RAM is unclassified, so the ceiling every other charge in this budget is checked against is unknown: refuse to derive a runner width rather than borrow another host's MemTotal (which is how a correct sum acquires a fabricated premise). Classify it in gunbc.ci_floor_measurement gunbc_ci_host_usable_ram_for. Host: ", host)
      }
  }
}

fn accumulate_conservation_deployment(acc: DeploymentAccumulator, offer: ComputeOffer, control_plane_placement: FabricControlPlanePlacement) -> DeploymentAccumulator {
  match compute_host_primary_cpu(host: offer.supply.physical) {
    Absent =>
      DeploymentAccumulator {
        deployments: acc.deployments,
        unsound_reason: if acc.unsound_reason == "" { concat("compute offer has no primary CPU facts: ", offer.supply.physical.identity) } else { acc.unsound_reason },
        any_unfit: acc.any_unfit,
        total: acc.total,
      }
    Present { value: cpu } =>
      match host_usable_ram_or_refusal(host: offer.supply.physical.identity, r: gunbc_ci_host_usable_ram_for(host: offer.supply.physical.identity)) {
        HostUsableRamUnresolved { reason: rr } =>
          DeploymentAccumulator {
            deployments: acc.deployments,
            unsound_reason: if acc.unsound_reason == "" { rr } else { acc.unsound_reason },
            any_unfit: acc.any_unfit,
            total: acc.total,
          }
        HostUsableRamResolved { bytes: host_ram } => {
      let host_id = offer.supply.physical.identity
      let headroom = oomd_actuation_floor(host: host_ram)
      match host_session_slice_resolution(host: host_id) {
        SessionSliceUnsized { reason: sr } =>
          DeploymentAccumulator {
            deployments: acc.deployments,
            unsound_reason: if acc.unsound_reason == "" { sr } else { acc.unsound_reason },
            any_unfit: acc.any_unfit,
            total: acc.total,
          }
        SessionSliceNotApplicable => accumulate_with_session_slice(acc: acc, offer: offer, cpu: cpu, host_id: host_id, host_ram: host_ram, headroom: headroom, session_pool: byte_size(0), control_plane_placement: control_plane_placement)
        SessionSliceCharged { bytes: session_pool } => accumulate_with_session_slice(acc: acc, offer: offer, cpu: cpu, host_id: host_id, host_ram: host_ram, headroom: headroom, session_pool: session_pool, control_plane_placement: control_plane_placement)
      }
        }
      }
  }
}

fn accumulate_with_session_slice(
  acc: DeploymentAccumulator,
  offer: ComputeOffer,
  cpu: CpuFacts,
  host_id: HostIdentity,
  host_ram: ByteSize,
  headroom: ByteSize,
  session_pool: ByteSize,
  control_plane_placement: FabricControlPlanePlacement
) -> DeploymentAccumulator {
      match host_overhead_or_refusal(host: host_id, o: gunbc_ci_host_fixed_overhead_for(host: host_id)) {
        HostOverheadUnresolved { reason: orr } =>
          DeploymentAccumulator {
            deployments: acc.deployments,
            unsound_reason: if acc.unsound_reason == "" { orr } else { acc.unsound_reason },
            any_unfit: acc.any_unfit,
            total: acc.total,
          }
        HostOverheadResolved { bytes: overhead } =>
      match compile_pool_bytes_for(
        placement: gunbc_compile_pool_placement,
        nproc: cpu_facts_threads(cpu: cpu),
        host: host_ram,
        citation: jobserver_config
      ) {
        CompilePoolUnresolved { reason: r } =>
          DeploymentAccumulator {
            deployments: acc.deployments,
            unsound_reason: if acc.unsound_reason == "" { concat("compile pool unresolved: ", r) } else { acc.unsound_reason },
            any_unfit: acc.any_unfit,
            total: acc.total,
          }
        CompilePoolDerived { bytes: compile_pool } =>
        match host_allocation_verdict(
          host: host_ram,
          overhead: overhead,
          headroom: headroom,
          runner_pool: gunbc_runner_pool_budget_for(host: host_id),
          session_pool: session_pool,
          compile_pool: compile_pool,
          control_plane: host_fabric_control_plane_claim_under(host: host_id, placement: control_plane_placement)
        ) {
          HostAllocationConserves => {
          let dep = conservation_host_deployment(offer: offer, nproc: cpu_facts_threads(cpu: cpu))
          DeploymentAccumulator {
            deployments: concat(acc.deployments, [dep]),
            unsound_reason: acc.unsound_reason,
            any_unfit: acc.any_unfit || (dep.runner_count == 0),
            total: acc.total + dep.runner_count,
          }
          }
          HostAllocationOversubscribed =>
          DeploymentAccumulator {
            deployments: acc.deployments,
            unsound_reason: if acc.unsound_reason == "" { concat("host allocation over-committed (runner_pool + session_pool + compile_pool + overhead + headroom exceeds host RAM): ", offer.supply.physical.identity) } else { acc.unsound_reason },
            any_unfit: acc.any_unfit,
            total: acc.total,
          }
          HostAllocationUnchargeable { cause: c } =>
          DeploymentAccumulator {
            deployments: acc.deployments,
            unsound_reason: if acc.unsound_reason == "" { concat(concat("host allocation unchargeable on ", offer.supply.physical.identity), concat(": ", c)) } else { acc.unsound_reason },
            any_unfit: acc.any_unfit,
            total: acc.total,
          }
        }
      }
      }
}

fn runner_deployment_plan() -> RunnerDeploymentPlan {
  runner_deployment_plan_under_placement(control_plane_placement: fabric_control_plane_placement)
}

fn runner_deployment_plan_under_placement(control_plane_placement: FabricControlPlanePlacement) -> RunnerDeploymentPlan {
  let acc = fold(
    fleet_intent_offers,
    init: DeploymentAccumulator { deployments: [], unsound_reason: "", any_unfit: false, total: 0 },
    f: (a, o) => accumulate_conservation_deployment(acc: a, offer: o, control_plane_placement: control_plane_placement)
  )
  if acc.unsound_reason != "" {
    PlanUnsound { reason: acc.unsound_reason }
  } else if acc.any_unfit {
    PlanUnsound { reason: "declared runner_pool_budget admits zero runners at the declared per_runner_memory_cap: raise runner_pool_budget or lower per_runner_memory_cap" }
  } else {
    PlanDerived { hosts: acc.deployments, fleet_concurrent_runs: acc.total }
  }
}

type RunnersPerHostResolution
  = RunnersPerHostDerived { count: Int }
  | RunnersPerHostUnsound { reason: String }

fn effective_runners_per_host() -> RunnersPerHostResolution {
  match runner_deployment_plan() {
    PlanDerived { hosts: hosts, fleet_concurrent_runs: _ } =>
      RunnersPerHostDerived { count: fold(hosts, init: 0, f: (acc, h) => if h.runner_count > acc { h.runner_count } else { acc }) }
    PlanUnsound { reason: r } => RunnersPerHostUnsound { reason: r }
  }
}

type SessionHostReservation {
  identity: HostIdentity
  session_count: Int
  per_session_reservation: ByteSize
  workload_class: WorkloadClass
}

type SessionReservationPlan
  = SessionReservationDerived {
      hosts: List<SessionHostReservation>,
      fleet_concurrent_sessions: Int,
      per_session_reservation: ByteSize,
      coverage_count: Int,
      sample_count: Int
    }
  | SessionReservationUnsound { reason: String }

fn samples_covered(cap: ByteSize) -> Int {
  fold(gunbc_ci_per_session_peak_samples, init: 0, f: (acc, s) => if measure_le(a: s, b: cap) { acc + 1 } else { acc })
}

fn session_reservation_plan() -> SessionReservationPlan {
  match resolve_session_slice(mode: gunbc_ci_session_reservation_mode, oomd: gunbc_fleet_oomd_evidence) {
    SessionSliceUnresolved { reason: r } => SessionReservationUnsound { reason: r }
    SessionSliceResolved { bytes: _, per_session_cap: c, concurrency: n } =>
      SessionReservationDerived {
        hosts: map(fleet_intent_offers, o => SessionHostReservation {
          identity: o.supply.physical.identity,
          session_count: n,
          per_session_reservation: c,
          workload_class: InteractiveLatencySensitive,
        }),
        fleet_concurrent_sessions: n * fleet_intent_offers.length(),
        per_session_reservation: c,
        coverage_count: samples_covered(cap: c),
        sample_count: gunbc_ci_per_session_peak_samples.length(),
      }
  }
}

data gunbc_ci_count_field_measure_followup: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "std.measure",
    decl_name: "HardwareThreadCount",
    field: WholeDeclaration
  }
}


type OperatingPointRow {
  per_session_cap: ByteSize
  session_concurrency: Int
  sessions_slice: ByteSize
  coverage_count: Int
  sample_count: Int
}

fn evaluate_operating_point(cap: ByteSize, n: Int) -> OperatingPointRow {
  let slice = match resolve_session_slice(mode: Regime1WorstCase { point: SessionOperatingPointSet { per_session_cap: cap, session_concurrency: n } }, oomd: gunbc_fleet_oomd_evidence) {
    SessionSliceResolved { bytes: b, per_session_cap: _, concurrency: _ } => b
    SessionSliceUnresolved { reason: _ } => byte_size(0)
  }
  OperatingPointRow {
    per_session_cap: cap,
    session_concurrency: n,
    sessions_slice: slice,
    coverage_count: samples_covered(cap: cap),
    sample_count: gunbc_ci_per_session_peak_samples.length(),
  }
}

data gunbc_ci_session_operating_curve_candidates: List<SessionOperatingPoint> = [
  SessionOperatingPointSet { per_session_cap: byte_size(2211908157), session_concurrency: 16 },
  SessionOperatingPointSet { per_session_cap: byte_size(4294967296), session_concurrency: 16 },
  SessionOperatingPointSet { per_session_cap: byte_size(8879844884), session_concurrency: 6 },
  SessionOperatingPointSet { per_session_cap: byte_size(10737418240), session_concurrency: 6 },
  SessionOperatingPointSet { per_session_cap: byte_size(8879844884), session_concurrency: 4 },
]

fn operating_curve() -> List<OperatingPointRow> {
  map(gunbc_ci_session_operating_curve_candidates, op => match op {
    SessionOperatingPointSet { per_session_cap: c, session_concurrency: n } => evaluate_operating_point(cap: c, n: n)
    SessionOperatingPointUnset => evaluate_operating_point(cap: byte_size(0), n: 0)
  })
}
