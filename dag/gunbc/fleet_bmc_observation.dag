data srv4_bmc_fan_observed_controller_zone_path: std.types.NonEmptyStr = "/xyz/openbmc_project/settings/fanctrl/zone0"
data srv4_bmc_fan_observed_aggregate_entry: std.types.NonEmptyStr = "FAN1"
data srv4_bmc_fan_observed_tach_inputs: List<std.types.NonEmptyStr> = ["FAN1", "FAN2", "FAN3", "FAN4"]

data srv4_bmc_fan_active_config_digest: extdeps.crypto.hash.Digest = extdeps.crypto.hash.sha256_digest(
  hex: gunbc.bmc_fan_projection.altrad8ud_openbmc_322_fleet_quiet_projected_config_sha256_hex,
)

data srv4_bmc_fan_realization_id: std.types.NonEmptyStr = "altrad8ud-openbmc-3.22.00-swampd-asrr-temp-soc-jffs2-v1"

fn bmc_fan_caller_asserted_definition_linkage(
  reason: std.types.NonEmptyStr,
) -> std.state_durability.StateDefinitionLinkage {
  std.state_durability.CallerAssertedDefinitionLinkage {
    reason: reason,
    dissolution: std.state_durability.symbol_index_subtree_digest_dissolution,
  }
}

fn bmc_fan_realization_definition_linkages() -> std.state_durability.StateRealizationDefinitionLinkages {
  std.state_durability.StateRealizationDefinitionLinkages {
    projection: bmc_fan_caller_asserted_definition_linkage(
      reason: "openbmc fan config projection is caller-asserted until SymbolIndex subtree digest",
    ),
    verifier: bmc_fan_caller_asserted_definition_linkage(
      reason: "openbmc fan config verifier is caller-asserted until SymbolIndex subtree digest",
    ),
    observer: bmc_fan_caller_asserted_definition_linkage(
      reason: "openbmc fan config observer is caller-asserted until SymbolIndex subtree digest",
    ),
    transport: bmc_fan_caller_asserted_definition_linkage(
      reason: "openbmc fan config transport is caller-asserted until SymbolIndex subtree digest",
    ),
    actuator: bmc_fan_caller_asserted_definition_linkage(
      reason: "openbmc fan config actuator is caller-asserted until SymbolIndex subtree digest",
    ),
  }
}

data srv4_bmc_fan_realization_definition_linkages_scaffold_note: String = "Until the namespace content-addressed SymbolIndex subtree-digest authority lands, every realization role is CallerAssertedDefinitionLinkage and durable qualification refuses with typed DurabilityDefinitionLinkageUnavailable. The condition is not restated per row: std.state_durability state_definition_linkage_frontier_note is its single authority, and the arm's own name carries the temporary state, so the deleted per-instance dissolve_on string was one module fact copied to eight sites — including a witness that asserted the sentence verbatim, which made the prose the contract rather than the behaviour."

data srv4_bmc_fan_realization: std.state_durability.StateRealizationIdentity = std.state_durability.StateRealizationIdentity {
  realization_id: srv4_bmc_fan_realization_id,
  definition_linkages: bmc_fan_realization_definition_linkages(),
}

data srv4_bmc_fan_durability_capability_version: std.state_durability.StateDurabilityCapabilityVersion = std.state_durability.StateDurabilityCapabilityVersion {
  version: "openbmc-overlay-config-graceful-restart-v2",
  definition_linkage: bmc_fan_caller_asserted_definition_linkage(
    reason: "linux synchronized rename-replace publication capability is caller-asserted until SymbolIndex subtree digest",
  ),
}

data srv4_bmc_fan_perturbation_generation: std.state_durability.StatePerturbationGeneration = 1

