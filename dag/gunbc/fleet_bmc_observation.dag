module gunbc.fleet_bmc_observation



type BmcFanTachReceipt {
  sensor: std.types.NonEmptyStr
  reading: std.measure.RevolutionsPerMinute
}

type BmcFanConvergenceReceipt {
  evidence_scope: extdeps.bmc.capability.BmcEvidenceTemporalScope
  host: product.placement_supply.HostIdentity
  policy: extdeps.bmc.types.BmcFanPolicyObservation
  persistence: extdeps.bmc.types.BmcConfigPersistenceObservation
  active_config_digest: extdeps.crypto.hash.Digest
  previous_config_digest: extdeps.crypto.hash.Digest
  zone_control_path: std.types.NonEmptyStr
  zone_failsafe_active: Bool
  monitoring_sample_count: std.nat.Nat
  monitoring_duration: std.measure.Second
  temp_soc_minimum: std.measure.Celsius
  temp_soc_maximum: std.measure.Celsius
  temp_soc_final: std.measure.Celsius
  guarded_component_maximum: std.measure.Celsius
  final_tachs: List<BmcFanTachReceipt>
  observed_at: std.types.EpochMs
}

type BmcFanRebootPersistenceReceipt {
  evidence_scope: extdeps.bmc.capability.BmcEvidenceTemporalScope
  host: product.placement_supply.HostIdentity
  perturbation_receipt_id: std.types.NonEmptyStr
  perturbation_generation: std.state_durability.StatePerturbationGeneration
  perturbation_capability: gunbc.bmc_fan_projection.BmcFanPolicyProjectionCapability
  before: BmcFanConvergenceReceipt
  post_reboot_policy: extdeps.bmc.types.BmcFanPolicyObservation
  reset: extdeps.bmc.types.RedfishManagerResetObservation
  bmc_down_observed: Bool
  bmc_returned: Bool
  bmc_down_observed_at: std.types.EpochMs
  bmc_returned_at: std.types.EpochMs
  host_power_before: extdeps.bmc.types.RedfishPowerState
  host_power_after: extdeps.bmc.types.RedfishPowerState
  host_os_ssh_reachable_throughout: Bool
  pre_reboot_temp_soc: std.measure.Celsius
  post_reboot_temp_soc: std.measure.Celsius
  pre_reboot_tachs: List<BmcFanTachReceipt>
  post_reboot_tachs: List<BmcFanTachReceipt>
  post_reboot_active_config_digest: extdeps.crypto.hash.Digest
  post_reboot_controller_active: Bool
  post_reboot_zone_failsafe_active: Bool
  post_reboot_observer_exit_success: Bool
  post_reboot_converge_noop_exit_success: Bool
  observed_at: std.types.EpochMs
}

// AN OBSERVATION IS IMMUTABLE; only which one is CURRENT advances. An earlier
// revision of this change edited the single srv3 row in place from 2.07.00 to
// 3.22.00, which moved every receipt that referenced it — so the July
// update-service snapshot silently began claiming it had been taken under
// firmware that was installed in August. That is the same temporal-authority
// defect this change set out to fix, relocated one field sideways: a receipt
// must keep the firmware identity it was actually observed under, and a later
// flash may not rewrite the past by reference.
data srv3_bmc_firmware_2_07_00_observation: extdeps.bmc.capability.BmcFirmwareObservation = extdeps.bmc.capability.BmcFirmwareObservation {
  endpoint: srv3_baseboard.bmc,
  firmware: extdeps.bmc.capability.BmcFirmwareVersion {
    family: std.bmc.OpenBmc,
    version: extdeps.firmware.types.firmware_semantic_version(major: 2, minor: 7, patch: 0),
  },
  evidence_scope: extdeps.bmc.capability.HistoricalEvidenceSnapshot,
  observed_at: 1785110400000,
}

// Observed 2026-08-12 after the 2026-08-11 flash: VERSION_ID=3.22.00 read from
// /etc/os-release over authenticated BMC SSH.
data srv3_bmc_firmware_3_22_00_observation: extdeps.bmc.capability.BmcFirmwareObservation = extdeps.bmc.capability.BmcFirmwareObservation {
  endpoint: srv3_baseboard.bmc,
  firmware: extdeps.bmc.capability.BmcFirmwareVersion {
    family: std.bmc.OpenBmc,
    version: extdeps.firmware.types.firmware_semantic_version(major: 3, minor: 22, patch: 0),
  },
  evidence_scope: extdeps.bmc.capability.HistoricalEvidenceSnapshot,
  observed_at: 1786843200000,
}

// The CURRENT standing. This is the only row that advances on a flash, and it
// advances by re-binding rather than by mutation, so nothing historical moves.
data srv3_bmc_firmware_observation: extdeps.bmc.capability.BmcFirmwareObservation = srv3_bmc_firmware_3_22_00_observation

data srv4_bmc_firmware_observation: extdeps.bmc.capability.BmcFirmwareObservation = extdeps.bmc.capability.BmcFirmwareObservation {
  endpoint: srv4_baseboard.bmc,
  firmware: extdeps.bmc.capability.BmcFirmwareVersion {
    family: std.bmc.OpenBmc,
    version: extdeps.firmware.types.firmware_semantic_version(major: 3, minor: 22, patch: 0),
  },
  evidence_scope: extdeps.bmc.capability.HistoricalEvidenceSnapshot,
  observed_at: 1785110400000,
}

// DERIVED, not authored. Each host contributes only its observed firmware
// version; the surface comes from the board catalog. This is what closes the
// staleness class: after srv3's 2026-08-11 flash there is no per-host copy
// left to go stale, and updating its firmware observation below moves its
// surface with it in one motion.
data srv3_bmc_redfish_surface: extdeps.bmc.types.BmcRedfishSurfaceDerivation = extdeps.bmc.types.bmc_redfish_surface_of_host(
  catalog: extdeps.boards.asrock_rack.asrock_altrad8ud_1l2t_bmc_redfish_surface_catalog,
  observation: srv3_bmc_firmware_observation,
)

data srv4_bmc_redfish_surface: extdeps.bmc.types.BmcRedfishSurfaceDerivation = extdeps.bmc.types.bmc_redfish_surface_of_host(
  catalog: extdeps.boards.asrock_rack.asrock_altrad8ud_1l2t_bmc_redfish_surface_catalog,
  observation: srv4_bmc_firmware_observation,
)

// Bound to the 2.07.00 observation it was actually taken under. No 3.22.00
// update-service receipt exists for srv3 yet; when one is measured it lands as
// a NEW row rather than by re-pointing this one.
data srv3_bmc_update_service_observation: extdeps.bmc.types.BmcUpdateServiceObservation = extdeps.bmc.types.BmcUpdateServiceObservation {
  firmware: srv3_bmc_firmware_2_07_00_observation,
  http_push_uri: "/redfish/v1/UpdateService/update",
  multipart_http_push_uri: "/redfish/v1/UpdateService/update",
  active_bmc_image_id: "c1789ba5",
  active_bmc_image_updateable: true,
  firmware_inventory_member_count: 2,
  bmc_image_member_count: 1,
  backup_bmc_image_observed: false,
  observed_at: 1785110400000,
}

data srv4_bmc_update_service_observation: extdeps.bmc.types.BmcUpdateServiceObservation = extdeps.bmc.types.BmcUpdateServiceObservation {
  firmware: srv4_bmc_firmware_observation,
  http_push_uri: "/redfish/v1/UpdateService/update",
  multipart_http_push_uri: "/redfish/v1/UpdateService/update",
