}
import std.types { Bool, ContentHash, EpochMs, List, NonEmptyStr, String }

type BmcFanTachReceipt {
  sensor: NonEmptyStr
  reading: RevolutionsPerMinute
}

type BmcFanConvergenceReceipt {
  evidence_scope: BmcEvidenceTemporalScope
  host: HostIdentity
  policy: BmcFanPolicyObservation
  persistence: BmcConfigPersistenceObservation
  active_config_digest: Digest
  previous_config_digest: Digest
  zone_control_path: NonEmptyStr
  zone_failsafe_active: Bool
  monitoring_sample_count: Nat
  monitoring_duration: Second
  temp_soc_minimum: Celsius
  temp_soc_maximum: Celsius
  temp_soc_final: Celsius
  guarded_component_maximum: Celsius
  final_tachs: List<BmcFanTachReceipt>
  observed_at: EpochMs
}

type BmcFanRebootPersistenceReceipt {
  evidence_scope: BmcEvidenceTemporalScope
  host: HostIdentity
  perturbation_receipt_id: NonEmptyStr
  perturbation_generation: StatePerturbationGeneration
  before: BmcFanConvergenceReceipt
  post_reboot_policy: BmcFanPolicyObservation
  reset: RedfishManagerResetObservation
  bmc_down_observed: Bool
  bmc_returned: Bool
  bmc_down_observed_at: EpochMs
  bmc_returned_at: EpochMs
  host_power_before: RedfishPowerState
  host_power_after: RedfishPowerState
  host_os_ssh_reachable_throughout: Bool
  pre_reboot_temp_soc: Celsius
  post_reboot_temp_soc: Celsius
  pre_reboot_tachs: List<BmcFanTachReceipt>
  post_reboot_tachs: List<BmcFanTachReceipt>
  post_reboot_active_config_digest: Digest
  post_reboot_controller_active: Bool
  post_reboot_zone_failsafe_active: Bool
  post_reboot_observer_exit_success: Bool
  post_reboot_converge_noop_exit_success: Bool
  observed_at: EpochMs
}

