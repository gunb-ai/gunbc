module gunbc.public_workload_evidence

import std.types { Bool, CommitSha, Int, List, NonEmptyStr, String }
import std.integer { UInt8 }
import std.encoding { Standard, base64_encode }
import std.object_store {
  percent_encode_payload,
  ImmutableRecordPut, ImmutableRecordStored, ImmutableRecordAlreadyPresent, ImmutableRecordConflict,
  ImmutableRecordOccupiedByEmptyObject, ImmutableRecordPublishRefused, ImmutableRecordReadBackRefused,
}
import extdeps.realization.object_store_git { GitObjectStoreOpening, git_object_store_put_record }
import extdeps.transports.rest {
  RestExchangePerformance, RestExchangeSucceeded, RestExchangeStatusRefused, RestExchangeCommitAmbiguous,
  RestExchangeUnreached, RestExchangeUndecodable,
}
import extdeps.github.repository_contents {
  RepositoryFileBytesRead, RepositoryFileBytes, RepositoryFileNotBase64Encoded, RepositoryFileBase64Invalid,
  RepositoryFileSizeDisagrees, repository_file_bytes,
}
import extdeps.languages.yaml.gha_workflow_read { WorkflowJobsRead }
import gunbc.ci_workflow_source_read {
  HitRevisionResolution, HitReadAtResolvedRevision, HitRevisionUnaddressable, HitRepositoryReadRefused,
  HitRepositoryDisagrees, HitBranchReadRefused, HitBranchHeadNotExact,
  HitCanonicalized, HitFileUnreadable, HitSubjectsDisagree, HitRefNotExact, HitReadRefused,
  RepositoryIdDiffersFromHit, RepositoryRenamedSinceIndex,
  RepositoryDiffersFromHit, RequestedPathDiffersFromHit, ResponsePathDiffersFromRequest,
}
import gunbc.public_workload_scan {
  WorkloadScanReceipt, ScanHitReceipt, HitSighting, ScanQueryReceipt,
  ScanQueryPagesExhausted, ScanQueryPageLimit, ScanQueryHitLimit, ScanQueryTruncated, ScanQueryPageRefused,
}

// THE RAW CORPUS OF A PUBLIC WORKLOAD SCAN: WHAT WAS READ, AND HOW IT WAS FOUND.
//
// TWO RECORD FAMILIES ARE STORED, AND INTERPRETATION IS NOT ONE OF THEM.
//
//   workflow-source   one workflow file at one exact revision: the repository id, commit, path and
//                     blob that identify it, the repository's name and fork standing as observed, the
//                     size the endpoint declared, and the file's exact bytes. Nothing is read out of
//                     the bytes before they are stored.
//   scan-attempt      one scan: when it ran, every query's bounds, pages and stop, every individual
//                     sighting (which query found which file on which page at which position, with the
//                     blob the index held), and every distinct file's resolution outcome, naming the
//                     source record it produced when it produced one.
//
// A READING OF THE BYTES IS NOT STORED because it is a pure function of the bytes and the reader, and
// the bytes are stored. Persisting it would be a second representation of the source that goes stale
// the moment the reader improves - and an earlier revision of this module did exactly that, storing a
// rendering that kept a step's command but not its shell, a strategy's name but not its matrix, a key's
// name but not its value, while describing itself as the observation. A projection that needs jobs
// reads them from the source record with whatever reader is current.
//
// THE SOURCE KEY HAS NO READER IN IT. A new reader is a new projection of the same source, never a new
// source. The key is what upstream identifies: repository id, commit, path, blob.
//
// NO FILTER SITS BETWEEN A SUCCESSFUL READ AND STORAGE. A file that turns out to have no ARM job, a
// provider's own repository, a file that is not UTF-8 - each was read, so each is stored. What is and is
// not interesting is a projection's question.
//
// COLLECTION TIME LIVES ONLY IN THE SCAN ATTEMPT. A source record's bytes are identical however many
// scans read the same blob at the same commit, so a re-read settles as already present; the attempts
// that read it are separate records, each naming the source key.

data workflow_source_family: NonEmptyStr = "workflow-source-v1"
data scan_attempt_family: NonEmptyStr = "scan-attempt-v1"

data workflow_source_format: String = "gunbc-workflow-source v1"
data scan_attempt_format: String = "gunbc-scan-attempt v1"

type WorkflowSourceKey {
  repository_id: Int
  ref: CommitSha
  workflow_path: String
  blob_sha: String
}

type WorkflowSourceRecord {
  key: WorkflowSourceKey
  repository_full_name_at_observation: String
  repository_is_fork: Bool
  declared_size: Int
  octets: List<UInt8>
}

fn enc(s: String) -> String {
  percent_encode_payload(s: s)
}

fn workflow_source_record_key(key: WorkflowSourceKey) -> NonEmptyStr {
  join([workflow_source_format, to_string(value: key.repository_id), key.ref as String, enc(s: key.workflow_path), key.blob_sha], " ") as NonEmptyStr
}

// The bytes are carried as canonical RFC 4648 base64 - re-encoded from the decoded octets rather than
// copied from the endpoint's line-wrapped text - so one blob has exactly one stored spelling and a byte
// that is not valid UTF-8 is stored as faithfully as one that is.
fn encode_workflow_source_record(r: WorkflowSourceRecord) -> NonEmptyStr {
  concat(join([
    workflow_source_format,
    join(["repository_id", to_string(value: r.key.repository_id)], " "),
    join(["repository_full_name_at_observation", enc(s: r.repository_full_name_at_observation)], " "),
    join(["repository_is_fork", if r.repository_is_fork { "true" } else { "false" }], " "),
    join(["ref", r.key.ref as String], " "),
    join(["workflow_path", enc(s: r.key.workflow_path)], " "),
    join(["blob_sha", r.key.blob_sha], " "),
    join(["declared_size", to_string(value: r.declared_size)], " "),
    join(["content_base64", base64_encode(octets: r.octets, variant: Standard)], " "),
    "end",
  ], "\n"), "\n") as NonEmptyStr
}

// ---------------------------------------------------------------------------------------------
// From a resolved hit to a source record, or to the outcome that explains why there is none.

type SourceFromHit
  = SourceRead { record: WorkflowSourceRecord }
  | SourceBytesUnusable { read: RepositoryFileBytesRead }
  | SourceNotReached { resolution: HitRevisionResolution }

fn source_from_hit(receipt: ScanHitReceipt) -> SourceFromHit {
  match receipt.resolution {
    HitReadAtResolvedRevision { hit, repository, head, canonicalization } =>
      match canonicalization {
        HitCanonicalized { identity, file } =>
          match repository_file_bytes(file: file) {
            RepositoryFileBytes { octets } =>
              SourceRead {
                record: WorkflowSourceRecord {
                  key: WorkflowSourceKey { repository_id: identity.repository_id, ref: identity.ref, workflow_path: identity.workflow_path, blob_sha: identity.blob_sha },
                  repository_full_name_at_observation: identity.repository_full_name,
                  repository_is_fork: identity.repository_is_fork,
                  declared_size: file.size,
                  octets: octets,
                },
              }
            other => SourceBytesUnusable { read: other }
          }
        HitFileUnreadable { repository_full_name, path, cause } => SourceNotReached { resolution: receipt.resolution }
        HitSubjectsDisagree { repository_full_name, path, disagreement, cause } => SourceNotReached { resolution: receipt.resolution }
        HitRefNotExact { repository_full_name, path, ref, cause } => SourceNotReached { resolution: receipt.resolution }
        HitReadRefused { repository_full_name, path, performance } => SourceNotReached { resolution: receipt.resolution }
      }
    HitRevisionUnaddressable { hit, address } => SourceNotReached { resolution: receipt.resolution }
    HitRepositoryReadRefused { hit, performance } => SourceNotReached { resolution: receipt.resolution }
    HitRepositoryDisagrees { hit, disagreement } => SourceNotReached { resolution: receipt.resolution }
    HitBranchReadRefused { hit, repository, performance } => SourceNotReached { resolution: receipt.resolution }
    HitBranchHeadNotExact { hit, repository, observed, cause } => SourceNotReached { resolution: receipt.resolution }
  }
}

// ---------------------------------------------------------------------------------------------
// The scan attempt's canonical bytes. Every refusal is rendered as its arm name plus the located facts
// the arm carries, so a later reader can route it without re-running the scan.

fn performance_tag(p: RestExchangePerformance) -> String {
  match p {
    RestExchangeSucceeded => "succeeded"
    RestExchangeStatusRefused { status, body: _ } => join(["status_refused", to_string(value: status)], ":")
    RestExchangeCommitAmbiguous { detail } => join(["commit_ambiguous", enc(s: detail as String)], ":")
    RestExchangeUnreached { cause } => join(["unreached", enc(s: cause as String)], ":")
    RestExchangeUndecodable { status, cause } => join(["undecodable", to_string(value: status), enc(s: cause as String)], ":")
  }
}

fn bytes_unusable_tag(r: RepositoryFileBytesRead) -> String {
  match r {
    RepositoryFileBytes { octets: _ } => "bytes"
    RepositoryFileNotBase64Encoded { encoding } => join(["not_base64_encoded", enc(s: encoding)], ":")
    RepositoryFileBase64Invalid => "base64_invalid"
    RepositoryFileSizeDisagrees { declared, decoded } => join(["size_disagrees", to_string(value: declared), to_string(value: decoded)], ":")
  }
}

fn resolution_tag(r: HitRevisionResolution) -> String {
  match r {
    HitReadAtResolvedRevision { hit: _, repository: _, head, canonicalization } => match canonicalization {
      HitCanonicalized { identity: _, file: _ } => join(["read", head as String], ":")
      HitFileUnreadable { repository_full_name: _, path: _, cause } => join(["file_unreadable", enc(s: cause as String)], ":")
      HitSubjectsDisagree { repository_full_name: _, path: _, disagreement, cause: _ } => join(["subjects_disagree", match disagreement {
        RepositoryDiffersFromHit { hit_repository, read_repository } => join(["repository", enc(s: hit_repository), enc(s: read_repository)], ":")
        RequestedPathDiffersFromHit { hit_path, requested_path } => join(["requested_path", enc(s: hit_path), enc(s: requested_path)], ":")
        ResponsePathDiffersFromRequest { requested_path, response_path } => join(["response_path", enc(s: requested_path), enc(s: response_path)], ":")
      }], ":")
      HitRefNotExact { repository_full_name: _, path: _, ref, cause: _ } => join(["ref_not_exact", enc(s: ref as String)], ":")
      HitReadRefused { repository_full_name: _, path: _, performance } => join(["file_read_refused", performance_tag(p: performance)], ":")
    }
    HitRevisionUnaddressable { hit: _, address: _ } => "repository_unaddressable"
    HitRepositoryReadRefused { hit: _, performance } => join(["repository_read_refused", performance_tag(p: performance)], ":")
    HitRepositoryDisagrees { hit: _, disagreement } => join(["repository_disagrees", match disagreement {
      RepositoryIdDiffersFromHit { hit_id, observed_id, full_name } => join(["id", to_string(value: hit_id), to_string(value: observed_id), enc(s: full_name)], ":")
      RepositoryRenamedSinceIndex { id, hit_full_name, observed_full_name } => join(["renamed", to_string(value: id), enc(s: hit_full_name), enc(s: observed_full_name)], ":")
    }], ":")
    HitBranchReadRefused { hit: _, repository: _, performance } => join(["branch_read_refused", performance_tag(p: performance)], ":")
    HitBranchHeadNotExact { hit: _, repository: _, observed, cause: _ } => join(["branch_head_not_exact", enc(s: observed)], ":")
  }
}

fn query_lines(q: ScanQueryReceipt) -> List<String> {
  concat(
    [join(["query", enc(s: q.policy.query_id as String), enc(s: q.policy.query as String), to_string(value: q.policy.per_page), to_string(value: q.policy.max_pages), to_string(value: q.policy.max_distinct_hits), match q.stop {
      ScanQueryPagesExhausted => "pages_exhausted"
      ScanQueryPageLimit => "page_limit"
      ScanQueryHitLimit => "hit_limit"
      ScanQueryTruncated { page, cause } => join(["truncated", to_string(value: page), enc(s: cause as String)], ":")
      ScanQueryPageRefused { page, performance } => join(["page_refused", to_string(value: page), performance_tag(p: performance)], ":")
    }], " ")],
    map(q.pages, p => join(["page", enc(s: q.policy.query_id as String), to_string(value: p.page), to_string(value: p.items_delivered)], " ")),
  )
}

fn sighting_line(s: HitSighting) -> String {
  join(["sighting", enc(s: s.query_id as String), to_string(value: s.page), to_string(value: s.position), to_string(value: s.hit.repository.id), enc(s: s.hit.repository.full_name), enc(s: s.hit.path), s.hit.sha, if s.admitted { "admitted" } else { "declined_by_bound" }], " ")
}

// The outcome line names the source record's key when the hit produced one, so the attempt joins to the
// source it read without either record repeating the other's content.
fn outcome_line(h: ScanHitReceipt, source: SourceFromHit) -> String {
  let subject = [to_string(value: h.hit.repository.id), enc(s: h.hit.path)]
  match source {
    SourceRead { record } => join(concat(concat(["outcome"], subject), ["source", enc(s: workflow_source_record_key(key: record.key) as String)]), " ")
    SourceBytesUnusable { read } => join(concat(concat(["outcome"], subject), ["bytes_unusable", bytes_unusable_tag(r: read)]), " ")
    SourceNotReached { resolution } => join(concat(concat(["outcome"], subject), ["not_reached", resolution_tag(r: resolution)]), " ")
  }
}

type HitSource {
  hit: ScanHitReceipt
  source: SourceFromHit
}

fn encode_scan_attempt(observed_at: NonEmptyStr, receipt: WorkloadScanReceipt, sources: List<HitSource>) -> NonEmptyStr {
  concat(join(concat(concat(concat(concat(
    [scan_attempt_format, join(["observed_at", observed_at as String], " ")],
    fold(receipt.queries, init: [], f: fn(acc, q) { concat(acc, query_lines(q: q)) })),
    map(receipt.sightings, s => sighting_line(s: s))),
    map(sources, p => outcome_line(h: p.hit, source: p.source))),
    ["end"]), "\n"), "\n") as NonEmptyStr
}

// ---------------------------------------------------------------------------------------------
// Storage.

type SourceStorage {
  record: WorkflowSourceRecord
  put: ImmutableRecordPut
}

type ScanHarvest {
  attempt: ImmutableRecordPut
  stored: List<SourceStorage>
  bytes_unusable: Int
  not_reached: Int
}

func store_workflow_source(store: GitObjectStoreOpening, record: WorkflowSourceRecord, attempts: Int) -> SourceStorage {
  SourceStorage {
    record: record,
    put: git_object_store_put_record(store: store, family: workflow_source_family, key: workflow_source_record_key(key: record.key), content: encode_workflow_source_record(r: record), attempts: attempts),
  }
}

// Sources first, then the attempt that names them: an attempt record never refers to a source key the
// store was not at least asked to hold. Every distinct file lands in exactly one of stored, bytes
// unusable, or not reached, so the three partition the scan's files.
func harvest_scan(store: GitObjectStoreOpening, observed_at: NonEmptyStr, receipt: WorkloadScanReceipt, attempts: Int) -> ScanHarvest {
  let sources = map(receipt.hits, h => HitSource { hit: h, source: source_from_hit(receipt: h) })
  let stored = fold(sources, init: [], f: fn(acc, p) {
    match p.source {
      SourceRead { record } => concat(acc, [store_workflow_source(store: store, record: record, attempts: attempts)])
      SourceBytesUnusable { read: _ } => acc
      SourceNotReached { resolution: _ } => acc
    }
  })
  let attempt_bytes = encode_scan_attempt(observed_at: observed_at, receipt: receipt, sources: sources)
  ScanHarvest {
    attempt: git_object_store_put_record(store: store, family: scan_attempt_family, key: attempt_bytes, content: attempt_bytes, attempts: attempts),
    stored: stored,
    bytes_unusable: count(filter(sources, p => match p.source { SourceBytesUnusable { read: _ } => true  SourceRead { record: _ } => false  SourceNotReached { resolution: _ } => false })),
    not_reached: count(filter(sources, p => match p.source { SourceNotReached { resolution: _ } => true  SourceRead { record: _ } => false  SourceBytesUnusable { read: _ } => false })),
  }
}
