module gunbc.host_hygiene_liveness

import std.types { String, NonEmptyStr, Bool, List }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.measure { Second, second, second_count, measure_le }
import std.realization_reconcile {
  ShowEffectiveRead,
  ReadObserved,
  ReadAbsent,
  Grounding,
  Grounds,
  DoesNotGround,
  Reconciliation,
  Converged,
  NotConverged,
  reconcile_grounded,
}

data gunbc_host_hygiene_liveness_scope_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.fleet_runner_connectivity",
    decl_name: "fleet_runner_connectivity_authority_disposition",
    field: WholeDeclaration,
  }
}

data session_started_observation_is_not_connectivity_note: String = "THIS MODULE IS NOT REGISTRATION CONNECTIVITY. The prior Terminal disposition titled 'registration liveness' was rung inflation: journal 'Listening for Jobs' timestamps emit once per runner incarnation and cannot distinguish a wedged broker session from a healthy one — the 2026-08-06 incident had 15 of 16 GitHub registrations offline while local units stayed active and continued logging that line. Real connectivity joins org-level GitHub registration status to stable slot identities in gunbc.fleet_runner_connectivity. What remains here is a RunnerSessionStarted diagnostic only."

type RunnerSessionStartedObservation
  = SessionStartedObserved { unit: NonEmptyStr, age: Second }
  | SessionStartedNeverSeen { unit: NonEmptyStr }
  | SessionStartedReadInaccessible { unit: NonEmptyStr, detail: NonEmptyStr }

type RunnerSessionStartedVerdict
  = SessionStartedFresh { unit: NonEmptyStr }
  | SessionStartedStale { unit: NonEmptyStr, age: Second, bound: Second }
  | SessionStartedUnknown { unit: NonEmptyStr, reason: NonEmptyStr }

fn runner_session_started_verdict(obs: RunnerSessionStartedObservation, bound: Second) -> RunnerSessionStartedVerdict {
  match obs {
    SessionStartedObserved { unit: u, age: a } =>
      if measure_le(a: a, b: bound) {
        SessionStartedFresh { unit: u }
      } else {
        SessionStartedStale { unit: u, age: a, bound: bound }
      }
    SessionStartedNeverSeen { unit: u } =>
      SessionStartedUnknown { unit: u, reason: "no 'Listening for Jobs' line found in the unit's journal" as NonEmptyStr }
    SessionStartedReadInaccessible { unit: u, detail: d } => SessionStartedUnknown { unit: u, reason: d }
  }
}

fn runner_session_started_verdict_fresh(v: RunnerSessionStartedVerdict) -> Bool {
  match v {
    SessionStartedFresh { unit: _ } => true
    SessionStartedStale { unit: _, age: _, bound: _ } => false
    SessionStartedUnknown { unit: _, reason: _ } => false
  }
}

fn runner_session_started_verdict_unit(v: RunnerSessionStartedVerdict) -> NonEmptyStr {
  match v {
    SessionStartedFresh { unit: u } => u
    SessionStartedStale { unit: u, age: _, bound: _ } => u
    SessionStartedUnknown { unit: u, reason: _ } => u
  }
}

type FleetSessionStartedVerdict
  = FleetSessionStartedGreen
  | FleetSessionStartedRed { unhealthy: List<RunnerSessionStartedVerdict> }

fn fleet_session_started_verdict(verdicts: List<RunnerSessionStartedVerdict>) -> FleetSessionStartedVerdict {
  let unhealthy = filter(verdicts, v => !runner_session_started_verdict_fresh(v: v))
  if unhealthy.length() == 0 {
    FleetSessionStartedGreen
  } else {
    FleetSessionStartedRed { unhealthy: unhealthy }
  }
}

fn fleet_green_from_session_started(verdicts: List<RunnerSessionStartedVerdict>) -> Bool {
  match fleet_session_started_verdict(verdicts: verdicts) {
    FleetSessionStartedGreen => true
    FleetSessionStartedRed { unhealthy: _ } => false
  }
}

type FleetSessionStartedEvidence {
  slot_count: Int
}

fn fleet_session_started_check_reason(verdicts: List<RunnerSessionStartedVerdict>) -> String? {
  match fleet_session_started_verdict(verdicts: verdicts) {
    FleetSessionStartedGreen => none
    FleetSessionStartedRed { unhealthy: u } =>
      Present {
        value: concat(
          "stale or unknown session-start listener(s): ",
          concat(
            to_string(u.length()),
            " slot(s) failed freshness",
          )
        )
      }
  }
}

fn ground_fleet_session_started(verdicts: List<RunnerSessionStartedVerdict>) -> Grounding<FleetSessionStartedEvidence> {
  match fleet_session_started_check_reason(verdicts: verdicts) {
    Absent =>
      Grounds {
        evidence: FleetSessionStartedEvidence {
          slot_count: verdicts.length(),
        }
      }
    Present { value: reason } => DoesNotGround { reason: reason }
  }
}

fn reconcile_fleet_session_started(
  read: ShowEffectiveRead<List<RunnerSessionStartedVerdict>>,
) -> Reconciliation<String, FleetSessionStartedEvidence> {
  match read {
    ReadAbsent { reason: why } =>
      reconcile_grounded(
        apply_effect: "host_hygiene_liveness.timer",
        show_read: read,
        grounding: DoesNotGround { reason: why }
      )
    ReadObserved { value: verdicts } =>
      reconcile_grounded(
        apply_effect: "host_hygiene_liveness.timer",
        show_read: read,
        grounding: ground_fleet_session_started(verdicts: verdicts)
      )
  }
}

data gunbc_host_hygiene_liveness_bound: Second = second(1800)

data gunbc_host_hygiene_liveness_show_effective_read: ShowEffectiveRead<List<RunnerSessionStartedVerdict>> = ReadAbsent {
  reason: "no live per-slot journal read has run on the fleet hosts yet; pure .dag model — this diagnostic is not registration connectivity (see gunbc.fleet_runner_connectivity)"
}

fn gunbc_host_hygiene_liveness_evidence() -> Reconciliation<String, FleetSessionStartedEvidence> {
  reconcile_fleet_session_started(read: gunbc_host_hygiene_liveness_show_effective_read)
}
