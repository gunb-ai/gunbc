module gunbc.host_hygiene_liveness

data gunbc_host_hygiene_liveness_scope_disposition: std.disposition.Disposition = std.disposition.Terminal {
  reason: "Brief 4 deliverable (b): registration liveness. NRestarts is useless as slot health (it counts jobs-served under the ephemeral restart-per-job runner design, 400-950 across slots at diagnosis time, not failure). Real liveness mines the 'Listening for Jobs' journal line per slot and compares its age against a bound; zero-occupancy outages (a 2.5h-class incident) had no liveness signal before this. RED: a stopped listener on one slot must flip the fleet verdict within one cadence — fleet_green_from_listening is any-stale-fails, not majority-fails."
}

type SlotListeningObservation
  = ListeningObserved { unit: std.types.NonEmptyStr, age: std.measure.Second }
  | ListeningNeverSeen { unit: std.types.NonEmptyStr }
  | ListeningReadInaccessible { unit: std.types.NonEmptyStr, detail: std.types.NonEmptyStr }

type SlotListeningVerdict
  = ListeningFresh { unit: std.types.NonEmptyStr }
  | ListeningStale { unit: std.types.NonEmptyStr, age: std.measure.Second, bound: std.measure.Second }
  | ListeningUnknown { unit: std.types.NonEmptyStr, reason: std.types.NonEmptyStr }

fn slot_listening_verdict(obs: SlotListeningObservation, bound: std.measure.Second) -> SlotListeningVerdict {
  match obs {
    ListeningObserved { unit: u, age: a } =>
      if std.measure.measure_le(a: a, b: bound) {
        ListeningFresh { unit: u }
      } else {
        ListeningStale { unit: u, age: a, bound: bound }
      }
    ListeningNeverSeen { unit: u } =>
      ListeningUnknown { unit: u, reason: "no 'Listening for Jobs' line found in the unit's journal" as std.types.NonEmptyStr }
    ListeningReadInaccessible { unit: u, detail: d } => ListeningUnknown { unit: u, reason: d }
  }
}

fn slot_listening_verdict_healthy(v: SlotListeningVerdict) -> Bool {
  match v {
    ListeningFresh { unit: _ } => true
    ListeningStale { unit: _, age: _, bound: _ } => false
    ListeningUnknown { unit: _, reason: _ } => false
  }
}

fn slot_listening_verdict_unit(v: SlotListeningVerdict) -> std.types.NonEmptyStr {
  match v {
    ListeningFresh { unit: u } => u
    ListeningStale { unit: u, age: _, bound: _ } => u
    ListeningUnknown { unit: u, reason: _ } => u
  }
}

type FleetListeningVerdict
  = FleetListeningGreen
  | FleetListeningRed { unhealthy: List<SlotListeningVerdict> }

fn fleet_listening_verdict(verdicts: List<SlotListeningVerdict>) -> FleetListeningVerdict {
  let unhealthy = filter(verdicts, v => !slot_listening_verdict_healthy(v: v))
  if unhealthy.length() == 0 {
    FleetListeningGreen
  } else {
    FleetListeningRed { unhealthy: unhealthy }
  }
}

fn fleet_green_from_listening(verdicts: List<SlotListeningVerdict>) -> Bool {
  match fleet_listening_verdict(verdicts: verdicts) {
    FleetListeningGreen => true
    FleetListeningRed { unhealthy: _ } => false
  }
}

type FleetListeningEvidence {
  slot_count: Int
}

fn fleet_listening_check_reason(verdicts: List<SlotListeningVerdict>) -> String? {
  match fleet_listening_verdict(verdicts: verdicts) {
    FleetListeningGreen => none
    FleetListeningRed { unhealthy: u } =>
      Present {
        value: concat(
          "stale or unknown registration listener(s): ",
          concat(
            to_string(u.length()),
            " slot(s) failed freshness",
          )
        )
      }
  }
}

fn ground_fleet_listening(verdicts: List<SlotListeningVerdict>) -> std.realization_reconcile.Grounding<FleetListeningEvidence> {
  match fleet_listening_check_reason(verdicts: verdicts) {
    Absent =>
      std.realization_reconcile.Grounds {
        evidence: FleetListeningEvidence {
          slot_count: verdicts.length(),
        }
      }
    Present { value: reason } => std.realization_reconcile.DoesNotGround { reason: reason }
  }
}

fn reconcile_fleet_listening(
  read: std.realization_reconcile.ShowEffectiveRead<List<SlotListeningVerdict>>,
) -> std.realization_reconcile.Reconciliation<String, FleetListeningEvidence> {
  match read {
    ReadAbsent { reason: why } =>
      std.realization_reconcile.reconcile_grounded(
        apply_effect: "host_hygiene_liveness.timer",
        show_read: read,
        grounding: std.realization_reconcile.DoesNotGround { reason: why }
      )
    ReadObserved { value: verdicts } =>
      std.realization_reconcile.reconcile_grounded(
        apply_effect: "host_hygiene_liveness.timer",
        show_read: read,
        grounding: ground_fleet_listening(verdicts: verdicts)
      )
  }
}

data gunbc_host_hygiene_liveness_bound: std.measure.Second = std.measure.second(1800)

data gunbc_host_hygiene_liveness_show_effective_read: std.realization_reconcile.ShowEffectiveRead<List<SlotListeningVerdict>> = std.realization_reconcile.ReadAbsent {
  reason: "this is the pure/CI-hermetic default read (deliberately never observed — this .dag has no shell transport and CI's floor is hermetic-only); the live per-slot journal read runs through gunbc.host_hygiene_liveness_observe.gunbc_host_hygiene_liveness_live_evidence(), which this module does not import to avoid a cycle back onto its own decision core"
}

fn gunbc_host_hygiene_liveness_evidence() -> std.realization_reconcile.Reconciliation<String, FleetListeningEvidence> {
  reconcile_fleet_listening(read: gunbc_host_hygiene_liveness_show_effective_read)
}
