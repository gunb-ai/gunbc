import std.decl_ref { DeclarationRef, WholeDeclaration }

data namespace_unique_on_chain_policy_hand_rust_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "test.retirement.namespace_unique_on_chain_policy_retained",
    decl_name: "namespace_unique_on_chain_policy_retention",
    field: WholeDeclaration
  }
}

data namespace_unique_on_chain_policy_hand_rust_dissolve_trigger: String = "DISSOLVE-ON: v1 self-host deletes src/v1 and the host thread-local NameResolutionPolicy gate; dag-native policy witnesses replace src/v1/tests/src/namespace_unique_on_chain_policy_test.rs (hand-Rust LOC after → 0). ROADMAP row: gunbc.roadmap_authority namespace-canonical-binding."

data namespace_unique_on_chain_policy_hand_rust_receipt_plan_anchor: String = "gunbc.roadmap_authority namespace-canonical-binding"

data namespace_unique_on_chain_policy_hand_rust_loc_before: Int = 244

data namespace_unique_on_chain_policy_hand_rust_loc_after: Int = 277

data namespace_unique_on_chain_policy_loc_delta_net: Int = 33

data namespace_unique_on_chain_policy_hand_rust_loc_census_note: String = "Hand-Rust keystone witness LOC census vs origin/main (src/v1/tests/src/namespace_unique_on_chain_policy_test.rs): before=244 after=277 net=+33. Interim growth is counted against ROADMAP row namespace-canonical-binding; dissolve-on deletes the rs (after → 0). A bare plan-filename is not the receipt — the checkable anchor is gunbc.roadmap_authority namespace-canonical-binding."

data namespace_unique_on_chain_policy_cli_run_hand_rust_loc_delta_net: Int = 83

data namespace_unique_on_chain_policy_cli_run_hand_rust_census_note: String = "THE SECOND HAND-RUST FILE THIS WORK GROWS, censused here because the first receipt did not cover it (review 45162). src/v1/stage0/src/cli_run.rs goes 32513 -> 32596 vs origin/main, net +83. It is reported as a delta rather than before/after because whole-file LOC on a 32k-line host module measures the file, not this change — the same shape cli_run_witness_admission_hand_rust_loc_delta_net already uses for the same file.\n\nWHAT GREW AND WHY IT IS HAND-RUST: the bulk is containment_resolve_fn_v1_for_module, which now routes the v1 containment census through the SAME chain+decide authority inference uses (module_path_owner_binding_decide, global_bare_unique_chain_candidate) so zero-on-chain never authorizes a whole-corpus search, including the nearest-ancestor LCP widen. That is the point of the node: one name-decision function rather than two that can disagree. Consolidating onto one authority necessarily grows the caller until the seed itself goes, so this is counted interim growth, not a shrink.\n\nIt cannot be a dag witness today for the reason the retention row already states: the census walks the seed interpreter's own resolution state through a host thread-local policy gate, and a substrate program has no handle to flip that gate. So there is no deleted path to point at and no shrink to claim — the honest receipt is a counted delta with a dissolution trigger, which is what this row is.\n\nDISSOLVE-ON: identical to the sibling census above — v1 self-host deletes src/v1 and with it both this growth and the policy gate it serves (delta -> 0). Checkable anchor: gunbc.roadmap_authority namespace-canonical-binding. Total hand-Rust growth this PR is therefore +33 (policy witness) +83 (cli_run) = +116, and a receipt claiming only +33 understated it."

data namespace_unique_on_chain_policy_containment_census_test_discriminator: String = "zero_on_chain_containment_census_matches_inference_unresolved"

data namespace_unique_on_chain_policy_zero_on_chain_test_discriminator: String = "zero_on_chain_homonym_discriminates_the_diagnostic_label"

data namespace_unique_on_chain_policy_single_off_chain_test_discriminator: String = "single_off_chain_unique_refuses_under_namespace_only"
