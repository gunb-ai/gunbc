    concat("principalSet://iam.googleapis.com/projects/", unread_project_number_314501921854 as String),
    "/locations/global/workloadIdentityPools/github-pool/attribute.repository/gunb-ai/gunb.ai",
  )
}

fn gunbai_auto_provider_condition_is_tight_legacy_repo() -> Bool {
  observed_gunbai_auto_github_provider.attribute_condition == "assertion.repository=='gunb-ai/gunb.ai'"
    && (observed_gunbai_auto_github_provider.attribute_condition).contains(legacy_federated_repo)
}

type LegacyFederationHygiene
  = CorrectlyScopedPossiblyInertUndeclared {
      pool_project_number: String
      pool_id: NonEmptyStr
      provider_id: NonEmptyStr
      federated_repo: String
      modeled_repo: String
    }

fn gunbai_auto_legacy_federation_hygiene() -> LegacyFederationHygiene {
  CorrectlyScopedPossiblyInertUndeclared {
    pool_project_number: unread_project_number_314501921854 as String,
    pool_id: github_pool_id,
    provider_id: observed_gunbai_auto_github_provider.provider_id,
    federated_repo: legacy_federated_repo,
    modeled_repo: "gunb-ai/gunbc",
  }
}

type FederationGenerationHypothesis
  = GithubPoolIsPriorGenerationUngrounded {
      auto_github_pool_condition: String
      secrets_github_pool_condition: String
      modeled_github_actions_condition: String
    }

fn github_pool_generation_hypothesis() -> FederationGenerationHypothesis {
  GithubPoolIsPriorGenerationUngrounded {
    auto_github_pool_condition: observed_gunbai_auto_github_provider.attribute_condition,
    secrets_github_pool_condition: observed_secrets_github_pool_attribute_condition,
    modeled_github_actions_condition: observed_github_actions_attribute_condition,
  }
}

fn secrets_github_pool_condition_is_the_malformed_one() -> Bool {
  match github_pool_generation_hypothesis() {
    GithubPoolIsPriorGenerationUngrounded {
      auto_github_pool_condition: auto_c,
      secrets_github_pool_condition: secrets_c,
      modeled_github_actions_condition: _,
    } =>
      (secrets_c).contains("repository_owner=='https:'")
        && (auto_c).contains(legacy_federated_repo)
        && !(auto_c).contains("https:")
  }
}

