fn gunb_test_enables_service(service: NonEmptyStr) -> Bool {
  fold(
    gunb_test_enabled_service_ids,
    init: false,
    f: fn(acc, s) { acc || s == service },
  )
}

fn gunb_test_sheets_is_absent() -> Bool {
  !gunb_test_enables_service(service: sheets_api_service_id)
}

data sts_api_service_id: NonEmptyStr = "sts.googleapis.com"

data gunbai_auto_enabled_service_count: Int = 32

