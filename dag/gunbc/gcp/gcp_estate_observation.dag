// github-pool is one identifier and one display name in four projects. The project
// NUMBER is the only discriminator, and it is the part a reader skims — which is
// how 314501921854 looked foreign. Inventory rows are keyed by project, never by pool id alone.
data github_pool_id: NonEmptyStr = "github-pool"

