fn github_pool_id_does_not_discriminate_project(left: ObservedWifPool, right: ObservedWifPool) -> Bool {
  left.pool_id == right.pool_id && left.project_number != right.project_number
}

fn four_github_pools_are_keyed_by_project_number() -> Bool {
  github_pool_id_does_not_discriminate_project(left: observed_github_pool, right: observed_gunbai_auto_github_pool)
    && github_pool_id_does_not_discriminate_project(left: observed_github_pool, right: observed_gunb_ci_github_pool)
    && github_pool_id_does_not_discriminate_project(left: observed_github_pool, right: observed_gunb_test_github_pool)
    && github_pool_id_does_not_discriminate_project(left: observed_gunbai_auto_github_pool, right: observed_gunb_ci_github_pool)
    && github_pool_id_does_not_discriminate_project(left: observed_gunbai_auto_github_pool, right: observed_gunb_test_github_pool)
    && github_pool_id_does_not_discriminate_project(left: observed_gunb_ci_github_pool, right: observed_gunb_test_github_pool)
}

