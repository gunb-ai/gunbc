  pool_id: "github-actions" as NonEmptyStr,
  provider_id: "github-oidc" as NonEmptyStr,
  attribute_condition: "assertion.repository == 'gunb-ai/gunbc'",
}

fn fleet_cloud_convergence_principal_set_member() -> String {
  concat(
    concat(
      concat(principal_set_member_prefix, fleet_secrets_project_number),
      "/locations/global/workloadIdentityPools/github-actions/attribute.repository/",
    ),
    "gunb-ai/gunbc",
  )
}

data observed_convergence_wif_binding: ObservedPrincipalSetBinding = ObservedPrincipalSetBinding {
  account: fleet_cloud_convergence_sa_email,
  role: role_iam_workload_identity_user,
  member: Present { value: fleet_cloud_convergence_principal_set_member() },
  pool_project_number: Present { value: fleet_secrets_project_number },
}

data observed_ci_secrets_cross_project_binding: ObservedPrincipalSetBinding = ObservedPrincipalSetBinding {
  account: gunbai_ci_secrets_sa_email,
  role: role_iam_workload_identity_user,
  member: Absent,
  pool_project_number: Present { value: unread_project_number_314501921854 as String },
}

data observed_ci_iap_cross_project_binding: ObservedPrincipalSetBinding = ObservedPrincipalSetBinding {
  account: gunbai_ci_iap_sa_email,
  role: role_iam_workload_identity_user,
  member: Absent,
  pool_project_number: Present { value: unread_project_number_314501921854 as String },
}

data gap_project_314501921854: EstateCoverageGap = EstateCoverageGap {
  subject_identity: "projects/314501921854" as NonEmptyStr,
  cause: "named by principalSet IAM bindings on gunbai-secrets service accounts; this session has no credential that can read the project",
  discharge: "projects.get on 314501921854 plus that project's workloadIdentityPools list and each provider's attribute condition",
  trusting_accounts: [gunbai_ci_secrets_sa_email, gunbai_ci_iap_sa_email],
}

data gap_third_legacy_sa: EstateCoverageGap = EstateCoverageGap {
  subject_identity: "gunbai-secrets/third-sa-bound-to-gunb.ai" as NonEmptyStr,
  cause: "operator audit stated three service accounts bound to gunb-ai/gunb.ai; two are named (gunbai-ci-secrets, gunbai-ci-iap); the third identity was not recorded",
  discharge: "IAM policy scan of every service account in gunbai-secrets for principalSet members containing gunb-ai/gunb.ai",
  trusting_accounts: [],
}

data gap_github_pool_provider_id: EstateCoverageGap = EstateCoverageGap {
  subject_identity: "projects/582015116396/locations/global/workloadIdentityPools/github-pool/providers" as NonEmptyStr,
  cause: "operator audit recorded attribute condition assertion.repository_owner=='https:' and not the provider resource id; minting an id would be a guess wearing observation standing",
  discharge: "iam.googleapis.com list providers on pool github-pool",
  trusting_accounts: [],
}

data gap_cross_project_principal_set_member: EstateCoverageGap = EstateCoverageGap {
  subject_identity: "projects/314501921854/principalSet-member-uri" as NonEmptyStr,
  cause: "audit named the pool project number and the federated repo gunb-ai/gunb.ai but not the principalSet member URI or pool id",
  discharge: "getIamPolicy on gunbai-ci-secrets and gunbai-ci-iap; parse principalSet members verbatim",
  trusting_accounts: [gunbai_ci_secrets_sa_email, gunbai_ci_iap_sa_email],
}

fn operator_audit_census() -> GcpEstateCensus {
  GcpEstateCensus {
    method_identity: operator_audit_method_identity,
    observed_at: operator_audit_observed_at,
    projects: [EstateObserved { value: observed_gunbai_secrets_project }],
    service_accounts: [
      EstateObserved { value: observed_fleet_cloud_convergence_sa },
      EstateObserved { value: observed_gunbai_ci_secrets_sa },
      EstateObserved { value: observed_gunbai_ci_iap_sa },
      EstateObserved { value: observed_fleet_automation_sa },
    ],
    wif_pools: [
      EstateObserved { value: observed_github_actions_pool },
      EstateObserved { value: observed_github_pool },
    ],
    wif_providers: [
      EstateObserved { value: observed_github_oidc_provider },
    ],
    principal_set_bindings: [
      EstateObserved { value: observed_convergence_wif_binding },
      EstateObserved { value: observed_ci_secrets_cross_project_binding },
      EstateObserved { value: observed_ci_iap_cross_project_binding },
    ],
    coverage_gaps: [
      gap_project_314501921854,
      gap_third_legacy_sa,
      gap_github_pool_provider_id,
      gap_cross_project_principal_set_member,
    ],
  }
}

fn census_gap_count(census: GcpEstateCensus) -> Int {
  census.coverage_gaps.length()
}

fn accounts_include(accounts: List<ServiceAccountEmail>, email: ServiceAccountEmail) -> Bool {
  fold(accounts, init: false, f: fn(acc, a) { acc || a == email })
}

fn unread_project_gap_names_trusting_accounts(gap: EstateCoverageGap) -> Bool {
  gap.trusting_accounts.length() == 2
    && accounts_include(accounts: gap.trusting_accounts, email: gunbai_ci_secrets_sa_email)
    && accounts_include(accounts: gap.trusting_accounts, email: gunbai_ci_iap_sa_email)
}

fn fleet_automation_has_no_principal_set_binding(census: GcpEstateCensus) -> Bool {
  fold(
    census.principal_set_bindings,
    init: true,
    f: fn(acc, row) {
      match row {
        EstateUnread { gap: _ } => acc
        EstateObserved { value: b } => acc && b.account != fleet_automation_sa_email
      }
    },
  )
}
