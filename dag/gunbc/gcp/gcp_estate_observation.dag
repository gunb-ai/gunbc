}

type TokenExchangeStsHypothesis
  = TokenExchangeRequiresStsInPoolProjectUngrounded {
      pool_project_number: String
      pool_id: NonEmptyStr
      sts_enabled_in_pool_project: Bool
    }

fn gunbai_auto_token_exchange_sts_hypothesis() -> TokenExchangeStsHypothesis {
  TokenExchangeRequiresStsInPoolProjectUngrounded {
    pool_project_number: unread_project_number_314501921854 as String,
    pool_id: github_pool_id,
    sts_enabled_in_pool_project: gunbai_auto_has_sts(),
  }
}

fn gunbai_auto_sts_inert_is_not_established() -> Bool {
  match gunbai_auto_token_exchange_sts_hypothesis() {
    TokenExchangeRequiresStsInPoolProjectUngrounded {
      pool_project_number: _,
      pool_id: _,
      sts_enabled_in_pool_project: enabled,
    } => !enabled
  }
}

type SheetsCallingStrategy
  = CreatePurposeScopedProject { none_of_three_has_sheets: Bool }

fn sheets_calling_strategy() -> SheetsCallingStrategy {
  CreatePurposeScopedProject { none_of_three_has_sheets: none_of_the_three_sandboxes_has_sheets() }
}

fn sheets_calling_strategy_is_create_not_adopt() -> Bool {
  match sheets_calling_strategy() {
    CreatePurposeScopedProject { none_of_three_has_sheets: ok } => ok
  }
}

fn observed_project_roster_count(census: GcpEstateCensus) -> Int {
  fold(
    census.projects,
    init: 0,
    f: fn(acc, row) {
      match row {
        EstateUnread { gap: _ } => acc
        EstateObserved { value: _ } => acc + 1
      }
    },
  )
}

// Secrets is custody. Convergence SA lives there so it cannot close the API-surface project.
// gunb-test is a deranked scratch project (two SAs, one a default). gunb-ci leads on evidence
// (STS, WIF pool, operational runner fleet, a Workspace-admin-named SA) and is not Selected:
// that SA's display name says Test Account, and its pool provider condition is unread.
type SheetsCallingHome
  = SheetsCallingHomeUnresolved {
      refused_api_surface_project: GcpProjectId
      refused_writer: ServiceAccountEmail
      candidate_writer_in_secrets: ServiceAccountEmail
      kitchen_sink_project: GcpProjectId
      pool_host_without_sts: GcpProjectId
      sts_host_without_sheets: GcpProjectId
    }

type SheetsEvidenceLead
  = GunbCiLeadsOnEvidenceNotSelected {
      leading_project: GcpProjectId
      workspace_admin: ServiceAccountEmail
      display_name_is_test_account: Bool
      provider_condition_unread: Bool
      deranked_scratch_project: GcpProjectId
      displaced_name_lead: GcpProjectId
      selected: Bool
    }

fn sheets_evidence_lead() -> SheetsEvidenceLead {
  GunbCiLeadsOnEvidenceNotSelected {
    leading_project: gunb_ci_project_id,
    workspace_admin: gunbai_ci_workspace_admin_sa_email,
    display_name_is_test_account: workspace_admin_display_name_says_test(),
    provider_condition_unread: true,
    deranked_scratch_project: gunb_test_project_id,
    displaced_name_lead: gunbai_auto_project_id,
    selected: false,
  }
}

fn sheets_leading_candidate_is_not_selected() -> Bool {
  match sheets_evidence_lead() {
    GunbCiLeadsOnEvidenceNotSelected {
      leading_project: lead,
      workspace_admin: admin,
      display_name_is_test_account: test_label,
      provider_condition_unread: unread_cond,
      deranked_scratch_project: scratch,
      displaced_name_lead: former,
      selected: selected,
    } =>
      lead == gunb_ci_project_id
        && admin == gunbai_ci_workspace_admin_sa_email
        && test_label
        && unread_cond
        && scratch == gunb_test_project_id
        && former == gunbai_auto_project_id
        && !selected
        && gunbai_auto_lacks_sts_while_ci_and_test_have_it()
  }
}

fn gunb_test_is_deranked_scratch_not_a_sheets_candidate() -> Bool {
  match sheets_evidence_lead() {
    GunbCiLeadsOnEvidenceNotSelected {
      leading_project: _,
      workspace_admin: _,
      display_name_is_test_account: _,
      provider_condition_unread: _,
      deranked_scratch_project: scratch,
      displaced_name_lead: _,
      selected: selected,
    } => scratch == gunb_test_project_id && !selected
  }
}

fn sheets_calling_home() -> SheetsCallingHome {
  SheetsCallingHomeUnresolved {
    refused_api_surface_project: fleet_secrets_gcp_project,
    refused_writer: fleet_automation_sa_email,
    candidate_writer_in_secrets: fleet_cloud_convergence_sa_email,
    kitchen_sink_project: gunb_test_project_id,
    pool_host_without_sts: gunbai_auto_project_id,
    sts_host_without_sheets: gunb_ci_project_id,
  }
}

fn sheets_calling_home_is_unresolved() -> Bool {
  match sheets_calling_home() {
    SheetsCallingHomeUnresolved {
      refused_api_surface_project: _,
      refused_writer: _,
      candidate_writer_in_secrets: _,
      kitchen_sink_project: _,
      pool_host_without_sts: _,
      sts_host_without_sheets: _,
    } => true
  }
}

fn secrets_project_is_refused_as_sheets_api_surface() -> Bool {
  match sheets_calling_home() {
    SheetsCallingHomeUnresolved {
      refused_api_surface_project: p,
      refused_writer: _,
      candidate_writer_in_secrets: _,
      kitchen_sink_project: _,
      pool_host_without_sts: _,
      sts_host_without_sheets: _,
    } => p == fleet_secrets_gcp_project
  }
}

fn fleet_automation_is_refused_as_sheets_writer() -> Bool {
  match sheets_calling_home() {
    SheetsCallingHomeUnresolved {
      refused_api_surface_project: _,
      refused_writer: w,
      candidate_writer_in_secrets: _,
      kitchen_sink_project: _,
      pool_host_without_sts: _,
      sts_host_without_sheets: _,
    } => w == fleet_automation_sa_email
  }
}

fn gunb_test_is_enumerated_not_selected(census: GcpEstateCensus) -> Bool {
  census_subject_is_observed_project_id(census: census, project_id: gunb_test_project_id)
    && match sheets_calling_home() {
      SheetsCallingHomeUnresolved {
        refused_api_surface_project: _,
        refused_writer: _,
        candidate_writer_in_secrets: _,
        kitchen_sink_project: k,
        pool_host_without_sts: _,
        sts_host_without_sheets: _,
      } => k == gunb_test_project_id
    }
}

fn gunbai_auto_is_not_selected_as_sheets_home() -> Bool {
  match sheets_calling_home() {
    SheetsCallingHomeUnresolved {
      refused_api_surface_project: _,
      refused_writer: _,
      candidate_writer_in_secrets: _,
      kitchen_sink_project: _,
      pool_host_without_sts: c,
      sts_host_without_sheets: _,
    } => c == gunbai_auto_project_id
  }
}

