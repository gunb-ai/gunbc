type GcpEstateSubjectKind
  = KindProject
  | KindEnabledService
  | KindServiceAccount
  | KindWifPool
  | KindWifProvider
  | KindIamBindingCell

type GcpEstateSubject
  = EstateProject { project_id: GcpProjectId, project_number: String }
  | EstateEnabledService { project_id: GcpProjectId, service_id: NonEmptyStr }
  | EstateServiceAccount { email: ServiceAccountEmail }
  | EstateWifPool { project_number: String, pool_id: NonEmptyStr }
  | EstateWifProvider { project_number: String, pool_id: NonEmptyStr, provider_id: NonEmptyStr }
  | EstateIamBindingCell {
      account: ServiceAccountEmail
      role: String
      member: String?
    }

type EstateCoverageGap {
  subject_identity: NonEmptyStr
  cause: NonEmptyStr
  discharge: NonEmptyStr
  trusting_accounts: List<ServiceAccountEmail>
  trusting_role: String?
  federated_repo: String?
}

type GcpEstateCoverage<T>
  = EstateObserved { value: T }
  | EstateUnread { gap: EstateCoverageGap }

type ObservedWifPool {
  project_number: String
  pool_id: NonEmptyStr
  display_name: String
  disabled: Bool
}

type ObservedWifProvider {
  project_number: String
