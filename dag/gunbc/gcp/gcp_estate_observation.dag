  "sts.googleapis.com" as NonEmptyStr,
]

fn named_sas_as_coverage(
  sas: List<ObservedNamedServiceAccount>,
) -> List<GcpEstateCoverage<ObservedNamedServiceAccount>> {
  fold(
    sas,
    init: [],
    f: fn(acc, sa) { acc |> list_push(EstateObserved { value: sa }) },
  )
}

fn append_named_sas(
  left: List<ObservedNamedServiceAccount>,
  right: List<ObservedNamedServiceAccount>,
) -> List<ObservedNamedServiceAccount> {
  fold(right, init: left, f: fn(acc, sa) { acc |> list_push(sa) })
}

fn all_observed_named_service_accounts() -> List<ObservedNamedServiceAccount> {
  append_named_sas(
    left: append_named_sas(
      left: append_named_sas(
        left: observed_gunbai_secrets_named_service_accounts,
        right: observed_gunbai_auto_named_service_accounts,
      ),
      right: observed_gunb_ci_named_service_accounts,
    ),
    right: observed_gunb_test_named_service_accounts,
  )
}

fn workspace_admin_display_name_says_test() -> Bool {
  (observed_gunbai_ci_workspace_admin_sa.display_name).contains("Test")
}

