fn census_measured_fingerprint(census: GcpEstateCensus) -> String {
  let from_providers = fold(
    census.wif_providers,
    init: "",
    f: fn(acc, row) {
      match row {
        EstateUnread { gap: g } => concat(acc, concat("|unread-provider|", g.cause as String))
        EstateObserved { value: p } => concat(
          acc,
          concat("|provider|", concat(p.provider_id as String, concat("|", p.attribute_condition))),
        )
      }
    },
  )
  let from_pools = fold(
    census.wif_pools,
    init: from_providers,
    f: fn(acc, row) {
      match row {
        EstateUnread { gap: g } => concat(acc, concat("|unread-pool|", g.cause as String))
        EstateObserved { value: p } => concat(acc, concat("|pool|", p.pool_id as String))
      }
    },
  )
  fold(
    census.coverage_gaps,
    init: from_pools,
    f: fn(acc, g) {
      concat(acc, concat("|gap|", concat(g.subject_identity as String, concat("|", g.cause as String))))
    },
  )
}

fn census_measured_fingerprint_eq(left: GcpEstateCensus, right: GcpEstateCensus) -> Bool {
  census_measured_fingerprint(census: left) == census_measured_fingerprint(census: right)
}
