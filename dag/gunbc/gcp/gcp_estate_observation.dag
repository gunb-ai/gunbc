  subject_identity: "projects/314501921854" as NonEmptyStr,
  cause: "named by principalSet IAM bindings on gunbai-secrets service accounts as project 314501921854; this session has no credential that can read the project",
  discharge: "projects.get on 314501921854 plus that project's workloadIdentityPools list and each provider's attribute condition",
  trusting_accounts: [gunbai_ci_secrets_sa_email, gunbai_ci_iap_sa_email],
  trusting_role: Present { value: role_iam_workload_identity_user },
  federated_repo: Present { value: legacy_federated_repo },
}

