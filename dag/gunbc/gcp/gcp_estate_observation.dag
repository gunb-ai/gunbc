  fleet_secrets_project_number,
}
import gunbc.fleet_secrets_config { fleet_secrets_gcp_project }

// OBSERVING LAYER. These rows are receipts about a live GCP estate, not facts owned by
// extdeps.cloud.gcp (DESIGN section 3: observations stay downstream of the observed upstream).
//
// THIS MODULE DOES NOT ACTUATE. It does not enable, create, bind, disable, or delete.

data gcp_sa_email_domain_suffix: String = ".iam.gserviceaccount.com"

data principal_set_scheme: String = "principalSet://iam.googleapis.com/"

data operator_prose_project_name_slip: NonEmptyStr = "gunbc-secrets"

data operator_audit_method_identity: NonEmptyStr = "operator-readonly-audit-2026-09-11"

data operator_audit_observed_at: NonEmptyStr = "2026-09-11"

data unread_project_number_314501921854: NonEmptyStr = "314501921854"

data gunbai_ci_secrets_sa_email: ServiceAccountEmail = "gunbai-ci-secrets@gunbai-secrets.iam.gserviceaccount.com"

data gunbai_ci_iap_sa_email: ServiceAccountEmail = "gunbai-ci-iap@gunbai-secrets.iam.gserviceaccount.com"

data fleet_cloud_convergence_sa_email: ServiceAccountEmail = "fleet-cloud-convergence@gunbai-secrets.iam.gserviceaccount.com"

data fleet_automation_sa_email: ServiceAccountEmail = "fleet-automation@gunbai-secrets.iam.gserviceaccount.com"

data role_iam_workload_identity_user: String = "roles/iam.workloadIdentityUser"

data legacy_federated_repo: String = "gunb-ai/gunb.ai"

type GcpEstateSubjectKind
  = KindProject
  | KindEnabledService
  | KindServiceAccount
  | KindWifPool
  | KindWifProvider
  | KindIamBindingCell

type GcpEstateSubject
  = EstateProject { project_id: GcpProjectId, project_number: String }
  | EstateEnabledService { project_id: GcpProjectId, service_id: NonEmptyStr }
  | EstateServiceAccount { email: ServiceAccountEmail }
  | EstateWifPool { project_number: String, pool_id: NonEmptyStr }
  | EstateWifProvider { project_number: String, pool_id: NonEmptyStr, provider_id: NonEmptyStr }
  | EstateIamBindingCell {
      account: ServiceAccountEmail
      role: String
      member: String?
    }

type EstateCoverageGap {
  subject_identity: NonEmptyStr
  cause: NonEmptyStr
  discharge: NonEmptyStr
  trusting_accounts: List<ServiceAccountEmail>
  trusting_role: String?
  federated_repo: String?
}

type GcpEstateCoverage<T>
  = EstateObserved { value: T }
  | EstateUnread { gap: EstateCoverageGap }

type ObservedWifPool {
  project_number: String
  pool_id: NonEmptyStr
  disabled: Bool
}

type ObservedWifProvider {
  project_number: String
  pool_id: NonEmptyStr
  provider_id: NonEmptyStr
  attribute_condition: String
}

type ObservedPrincipalSetBinding {
  account: ServiceAccountEmail
  role: String
  member: String?
  pool_project_number: String?
}

type GcpEstateCensus {
  method_identity: NonEmptyStr
  observed_at: NonEmptyStr
  projects: List<GcpEstateCoverage<GcpProject>>
  service_accounts: List<GcpEstateCoverage<GcpServiceAccount>>
  wif_pools: List<GcpEstateCoverage<ObservedWifPool>>
  wif_providers: List<GcpEstateCoverage<ObservedWifProvider>>
  principal_set_bindings: List<GcpEstateCoverage<ObservedPrincipalSetBinding>>
  coverage_gaps: List<EstateCoverageGap>
}

type PrincipalSetCitation
  = MemberIsNotAPrincipalSet { member: String }
  | PrincipalSetCitesProject { project_number: NonEmptyStr, pool_id: NonEmptyStr }
  | PrincipalSetUnparsed { member: String }

type PrincipalSetPathScan {
  previous: String
  project_number: String
  pool_id: String
}

fn principal_set_scan_step(acc: PrincipalSetPathScan, segment: String) -> PrincipalSetPathScan {
  PrincipalSetPathScan {
    previous: segment,
    project_number: if acc.previous == "projects" && acc.project_number == "" { segment } else { acc.project_number },
    pool_id: if acc.previous == "workloadIdentityPools" && acc.pool_id == "" { segment } else { acc.pool_id },
  }
}

fn principal_set_citation(member: String) -> PrincipalSetCitation {
  if !starts_with(s: member, prefix: principal_set_scheme) {
    MemberIsNotAPrincipalSet { member: member }
  } else {
    let scanned = fold(
      split(s: member, delimiter: "/"),
      init: PrincipalSetPathScan { previous: "", project_number: "", pool_id: "" },
      f: (acc, segment) => principal_set_scan_step(acc: acc, segment: segment),
    )
    if scanned.project_number == "" || scanned.pool_id == "" {
      PrincipalSetUnparsed { member: member }
    } else {
      PrincipalSetCitesProject {
        project_number: scanned.project_number as NonEmptyStr,
        pool_id: scanned.pool_id as NonEmptyStr,
      }
    }
  }
}

fn principal_set_pool_project_number(member: String) -> String? {
  match principal_set_citation(member: member) {
    PrincipalSetCitesProject { project_number: number, pool_id: _ } =>
      Present { value: number as String }
    MemberIsNotAPrincipalSet { member: _ } => none
    PrincipalSetUnparsed { member: _ } => none
  }
}

fn project_id_from_sa_email(email: ServiceAccountEmail) -> GcpProjectId? {
  sa_email_project_id_from_at(raw: email as String, at: 0, fuel: 128)
}

fn sa_email_project_id_from_at(raw: String, at: Int, fuel: Int) -> GcpProjectId? {
  if fuel <= 0 {
    none
  } else if at >= string_length(s: raw) {
    none
  } else if substring(s: raw, start: at, end: at + 1) == "@" {
    let host = substring(s: raw, start: at + 1, end: string_length(s: raw))
    if ends_with(s: host, suffix: gcp_sa_email_domain_suffix) {
      let id = substring(
        s: host,
        start: 0,
        end: string_length(s: host) - string_length(s: gcp_sa_email_domain_suffix),
      )
      if id == "" {
        none
      } else {
        Present { value: id as GcpProjectId }
      }
    } else {
      none
    }
  } else {
    sa_email_project_id_from_at(raw: raw, at: at + 1, fuel: fuel - 1)
  }
}

fn project_id_from_sa_email_is_gunbai_secrets(email: ServiceAccountEmail) -> Bool {
  match project_id_from_sa_email(email: email) {
    Present { value: id } => id == fleet_secrets_gcp_project
    Absent => false
  }
}

fn operator_prose_disagrees_with_sa_derived_project_id() -> Bool {
  operator_prose_project_name_slip as String != fleet_secrets_gcp_project as String
}

