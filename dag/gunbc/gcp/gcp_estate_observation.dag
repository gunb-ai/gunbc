fn operator_audit_census() -> GcpEstateCensus {
  GcpEstateCensus {
    method_identity: operator_audit_method_identity,
    observed_at: operator_audit_observed_at,
    projects: [
      EstateObserved { value: observed_gunbai_secrets_project },
      EstateObserved { value: observed_gunbai_auto_project },
      EstateObserved { value: observed_gunb_ci_project },
      EstateObserved { value: observed_gunb_test_project },
      EstateObserved { value: observed_gemini_project },
    ],
    service_accounts: named_sas_as_coverage(sas: all_observed_named_service_accounts()),
    wif_pools: [
      EstateObserved { value: observed_github_actions_pool },
      EstateObserved { value: observed_github_pool },
      EstateObserved { value: observed_gunbai_auto_github_pool },
      EstateObserved { value: observed_gunb_ci_github_pool },
      EstateObserved { value: observed_gunb_test_github_pool },
    ],
    wif_providers: [
      EstateObserved { value: observed_github_oidc_provider },
      EstateObserved { value: observed_secrets_github_pool_provider },
      EstateObserved { value: observed_gunbai_auto_github_provider },
    ],
    principal_set_bindings: [
      EstateObserved { value: observed_secrets_ci_integration_tests_legacy_binding },
      EstateObserved { value: observed_ci_secrets_cross_project_binding },
      EstateObserved { value: observed_ci_iap_cross_project_binding },
      EstateObserved { value: observed_fleet_cloud_convergence_binding },
    ],
    coverage_gaps: [
      gap_gunb_ci_github_pool_providers,
      gap_gunb_test_github_pool_providers,
      gap_workspace_admin_iam_roles_keys_refs,
      gap_gemini_project_beyond_identity,
      gap_gunbai_secrets_enabled_services_partial,
      gap_pool_creation_timestamps,
      gap_token_creator_binding_members,
    ],
  }
}

fn census_gap_count(census: GcpEstateCensus) -> Int {
  census.coverage_gaps.length()
}

fn census_coverage_has_unread<T>(rows: List<GcpEstateCoverage<T>>) -> Bool {
  fold(
    rows,
    init: false,
    f: fn(acc, row) {
      match row {
        EstateUnread { gap: _ } => true
        EstateObserved { value: _ } => acc
      }
    },
  )
}

fn accounts_include(accounts: List<ServiceAccountEmail>, email: ServiceAccountEmail) -> Bool {
  fold(accounts, init: false, f: fn(acc, a) { acc || a == email })
}

fn unread_project_gap_names_trusting_accounts(gap: EstateCoverageGap) -> Bool {
  gap.trusting_accounts.length() == 2
    && accounts_include(accounts: gap.trusting_accounts, email: gunbai_ci_secrets_sa_email)
    && accounts_include(accounts: gap.trusting_accounts, email: gunbai_ci_iap_sa_email)
}

fn unread_project_gap_names_role_and_repo(gap: EstateCoverageGap) -> Bool {
  match gap.trusting_role {
    Present { value: role } =>
      role == role_iam_workload_identity_user && match gap.federated_repo {
        Present { value: repo } => repo == legacy_federated_repo
        Absent => false
      }
    Absent => false
  }
}

fn fleet_automation_has_no_principal_set_binding(census: GcpEstateCensus) -> Bool {
  account_has_no_principal_set_binding(census: census, email: fleet_automation_sa_email)
}

fn account_has_no_principal_set_binding(census: GcpEstateCensus, email: ServiceAccountEmail) -> Bool {
  fold(
    census.principal_set_bindings,
    init: true,
    f: fn(acc, row) {
      match row {
        EstateUnread { gap: _ } => acc
        EstateObserved { value: b } => acc && b.account != email
      }
    },
  )
}

fn custody_sas_with_no_wif_bindings(census: GcpEstateCensus) -> Bool {
  account_has_no_principal_set_binding(census: census, email: fleet_automation_sa_email)
    && account_has_no_principal_set_binding(census: census, email: bmc_assimilator_sa_email)
    && account_has_no_principal_set_binding(census: census, email: secrets_compute_default_sa_email)
}

fn census_project_identifier_strings(census: GcpEstateCensus) -> List<String> {
  let from_projects = fold(
    census.projects,
    init: [],
    f: fn(acc, row) {
      match row {
        EstateUnread { gap: g } => acc |> list_push(g.subject_identity as String)
        EstateObserved { value: p } =>
          acc
            |> list_push(concat("project/", p.project_id as String))
            |> list_push(concat("project/", to_string(p.project_number)))
      }
    },
  )
  fold(
    census.coverage_gaps,
    init: from_projects,
    f: fn(acc, g) { acc |> list_push(g.subject_identity as String) },
  )
}

fn census_cited_project_numbers(census: GcpEstateCensus) -> List<NonEmptyStr> {
  fold(
    census.principal_set_bindings,
    init: [],
    f: fn(acc, row) {
      match row {
        EstateUnread { gap: _ } => acc
        EstateObserved { value: b } =>
          match b.pool_project_number {
            Present { value: n } =>
              if fold(acc, init: false, f: fn(seen, existing) { seen || existing as String == n }) {
                acc
              } else {
                acc |> list_push(n as NonEmptyStr)
              }
            Absent =>
              match b.member {
                Absent => acc
                Present { value: m } =>
                  match principal_set_citation(member: m) {
                    PrincipalSetCitesProject { project_number: number, pool_id: _ } =>
                      if fold(acc, init: false, f: fn(seen, existing) { seen || existing == number }) {
                        acc
                      } else {
                        acc |> list_push(number)
                      }
                    PrincipalSetUnparsed { member: _ } => acc
                    MemberIsNotAPrincipalSet { member: _ } => acc
                  }
              }
          }
      }
    },
  )
}

fn census_cited_but_unenumerated_projects(census: GcpEstateCensus) -> List<NonEmptyStr> {
  let identifiers = census_project_identifier_strings(census: census)
  fold(
    census_cited_project_numbers(census: census),
    init: [],
    f: fn(acc, number) {
      let key = concat("project/", number as String)
      let key_projects = concat("projects/", number as String)
      let enumerated = fold(
        identifiers,
        init: false,
        f: fn(seen, id) { seen || id == key || id == key_projects || id.contains(number as String) },
      )
      if enumerated { acc } else { acc |> list_push(number) }
    },
  )
}

fn census_unparsed_principal_set_members(census: GcpEstateCensus) -> List<String> {
  fold(
    census.principal_set_bindings,
    init: [],
    f: fn(acc, row) {
      match row {
        EstateUnread { gap: _ } => acc
        EstateObserved { value: b } =>
          match b.member {
            Absent => acc
            Present { value: m } =>
              match principal_set_citation(member: m) {
                PrincipalSetUnparsed { member: member } => acc |> list_push(member)
                PrincipalSetCitesProject { project_number: _, pool_id: _ } => acc
                MemberIsNotAPrincipalSet { member: _ } => acc
              }
          }
      }
    },
  )
}

fn census_subject_is_named_gap(census: GcpEstateCensus, subject: String) -> Bool {
  fold(
    census.coverage_gaps,
    init: false,
    f: fn(acc, g) { acc || g.subject_identity as String == subject },
  )
}

fn census_subject_is_observed_project_id(census: GcpEstateCensus, project_id: GcpProjectId) -> Bool {
  fold(
    census.projects,
    init: false,
    f: fn(acc, row) {
      match row {
        EstateUnread { gap: _ } => acc
        EstateObserved { value: p } => acc || p.project_id == project_id
      }
    },
  )
}

fn census_subject_is_observed_project_number(census: GcpEstateCensus, number: String) -> Bool {
  fold(
    census.projects,
    init: false,
    f: fn(acc, row) {
      match row {
        EstateUnread { gap: _ } => acc
        EstateObserved { value: p } => acc || to_string(p.project_number) == number
      }
    },
  )
}

fn census_subject_is_enumerated_project_number(census: GcpEstateCensus, number: String) -> Bool {
  census_subject_is_observed_project_number(census: census, number: number)
    || census_subject_is_named_gap(census: census, subject: concat("projects/", number))
    || census_subject_is_named_gap(census: census, subject: concat("project/", number))
}

fn operator_audit_census_without_unread_project_gap() -> GcpEstateCensus {
  GcpEstateCensus {
    method_identity: operator_audit_method_identity,
    observed_at: operator_audit_observed_at,
    projects: [EstateObserved { value: observed_gunbai_secrets_project }],
    service_accounts: [],
    wif_pools: [],
    wif_providers: [],
    principal_set_bindings: [
      EstateObserved { value: observed_ci_secrets_cross_project_binding },
    ],
    coverage_gaps: [],
  }
}

fn census_github_actions_provider_is_unread(census: GcpEstateCensus) -> Bool {
  !fold(
    census.wif_providers,
    init: false,
    f: fn(acc, row) {
      match row {
        EstateUnread { gap: _ } => acc
        EstateObserved { value: p } => acc || p.provider_id as String == "github-oidc"
      }
    },
  )
}

