module gunbc.roadmap_acceptance_history_projection

import gunbc.roadmap_model { RoadmapAcceptanceEvent }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.disposition { Disposition, RealizationDispatch, Scaffold }
import v2.std.collection { List }
import v2.std.text { String }

data roadmap_acceptance_history_projection_note: String = "Bounded seed bridge: evaluate roadmap_acceptance_event_history from revision-addressed authority source text. Git observation and append-only prefix policy stay in gunbc.roadmap_acceptance_history_observation; this module owns only the typed projection boundary from authority text to List<RoadmapAcceptanceEvent> or refusal."

type RoadmapAcceptanceHistoryProjection
  = RoadmapAcceptanceHistoryProjected { events: List<RoadmapAcceptanceEvent> }
  | RoadmapAcceptanceHistoryProjectionRefused { detail: String }

data roadmap_acceptance_history_projection_seed_scaffold: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "v1_compiler.cli_run",
    decl_name: "project_roadmap_acceptance_event_history_from_authority_text",
    field: WholeDeclaration,
  }
}
