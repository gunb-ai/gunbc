module gunbc.srv3_os_install_reconcile_apply


data srv3_os_install_reconcile_apply_shell_runner_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.srv3_host_effect_script",
    decl_name: "srv3_host_effect_script_dissolution_trigger",
    field: WholeDeclaration,
  }
}


fn process_exit_succeeded(exit: ProcessExit) -> Bool {
  match exit {
    ExitSuccess => true
    _ => false
  }
}

func srv3_os_install_reconcile_apply() -> ProcessExit
  uses net: std.resources.Network
{
  let intent = srv3_os_install_attempt_intent
  let grant_r = srv3_durable_approval_grant_read_apply()
  let grant_stdout = match srv3_shell_stdout_from_apply(r: grant_r) {
    Present { value: out } => out
    Absent =>
      return match srv3_reconciliation_failure_reason(r: grant_r) {
        Present { value: why } => exit_failure(reason: concat("srv3-install-reconcile-apply: read grant: ", why))
        Absent => exit_failure(reason: "srv3-install-reconcile-apply: read grant: host_effect_apply failed")
      }
  }
  let grant = parse_durable_approval_grant_file(contents: grant_stdout)
  if !durable_grant_is_active(grant: grant) {
    return exit_failure(reason: "srv3-install-reconcile-apply: durable approval grant missing or invalid")
  }

  let pre_observe_r = srv3_host_effect_observe_read_apply()
  let pre_observe_stdout = match srv3_shell_stdout_from_apply(r: pre_observe_r) {
    Present { value: out } => out
    Absent =>
      return match srv3_reconciliation_failure_reason(r: pre_observe_r) {
        Present { value: why } => exit_failure(reason: concat("srv3-install-reconcile-apply: pre-observe: ", why))
        Absent => exit_failure(reason: "srv3-install-reconcile-apply: pre-observe: host_effect_apply failed")
      }
  }
  let pre_observed_at = match parse_observed_at_from_stdout(stdout: pre_observe_stdout) {
    Present { value: t } => t as Timestamp
    Absent =>
      return exit_failure(reason: "srv3-install-reconcile-apply: pre-observe missing surface=observed_at=")
  }
  let pre_observation = parse_srv3_install_debug_observation(
    stdout: pre_observe_stdout,
    intent: intent,
  )
  let pre_result = reconcile_srv3_os_install(
    intent: intent,
    observation: pre_observation,
    disk: srv3_install_reconcile_default_disk,
    observed_at: pre_observed_at,
    grant: grant,
    prior: NoPriorReceipt,
  )

  match pre_result.temporal_plan {
    PlanApply { step_id: _ } => {}
    PlanAwaitApproval { escalation_id: _ } =>
      return exit_failure(reason: "srv3-install-reconcile-apply: plan awaits approval despite grant file present")
    PlanRefuse { step_id: _, reason: r } =>
      return exit_failure(reason: concat("srv3-install-reconcile-apply: plan refused: ", r))
    PlanNoop { step_id: _ } =>
      return exit_failure(reason: "srv3-install-reconcile-apply: plan noop; boot-once already converged")
    _ =>
      return exit_failure(reason: "srv3-install-reconcile-apply: unexpected temporal plan for boot-once apply")
  }

  let boot_exit = srv3_boot_once_cd_gated(approval: workflow_approval_from_durable_grant(grant: grant))
  let apply_succeeded = process_exit_succeeded(exit: boot_exit)
  if !apply_succeeded {
    return exit_failure(reason: "srv3-install-reconcile-apply: boot-once-cd apply failed")
  }

  let sleep_exit = srv3_reconciliation_to_process_exit(
    r: srv3_boot_once_read_back_sleep_apply(),
    failure_prefix: "srv3-install-reconcile-apply: read-back sleep: ",
  )
  if !process_exit_succeeded(exit: sleep_exit) {
    return sleep_exit
  }

  let post_observe_r = srv3_host_effect_observe_read_apply()
  let post_observe_stdout = match srv3_shell_stdout_from_apply(r: post_observe_r) {
    Present { value: out } => out
    Absent =>
      return match srv3_reconciliation_failure_reason(r: post_observe_r) {
        Present { value: why } => exit_failure(reason: concat("srv3-install-reconcile-apply: post-observe: ", why))
        Absent => exit_failure(reason: "srv3-install-reconcile-apply: post-observe: host_effect_apply failed")
      }
  }
  let post_observed_at = match parse_observed_at_from_stdout(stdout: post_observe_stdout) {
    Present { value: t } => t as Timestamp
    Absent =>
      return exit_failure(reason: "srv3-install-reconcile-apply: post-observe missing surface=observed_at=")
  }
  let post_observation = parse_srv3_install_debug_observation(
    stdout: post_observe_stdout,
    intent: intent,
  )
  let read_back_ok = boot_once_apply_read_back_ok(
    pre: pre_observation,
    post: post_observation,
    apply_succeeded: apply_succeeded,
  )
  let step_receipt = effect_step_receipt_for_boot_once(
    observation: post_observation,
    diagnostic: pre_result.diagnostic,
    plan: pre_result.temporal_plan,
    read_back_ok: read_back_ok,
    observed_at: post_observed_at,
    applied: EffectApplied { effect_id: "srv3-boot-once-cd" as NonEmptyStr },
  )
  let post_grant = consumed_grant_after_boot_once()
  let post_result = reconcile_srv3_os_install(
    intent: intent,
    observation: post_observation,
    disk: srv3_install_reconcile_default_disk,
    observed_at: post_observed_at,
    grant: post_grant,
    prior: PriorReceipt { receipt: step_receipt },
  )
  let lease = srv3_held_lease_from_serve(serve: post_observation.actuator_serve)
  let dry_receipt = srv3_install_reconcile_full_receipt(
    result: post_result,
    intent: intent,
    observation: post_observation,
    grant: post_grant,
    prior: PriorReceipt { receipt: step_receipt },
    lease: lease,
    git_branch: "live-apply" as NonEmptyStr,
    git_commit: "live-apply" as NonEmptyStr,
  )
  let apply_receipt = srv3_install_reconcile_apply_receipt(
    pre_result: pre_result,
    post_result: post_result,
    pre_grant: grant,
    post_grant: post_grant,
    step_receipt: step_receipt,
    apply_succeeded: apply_succeeded,
    read_back_ok: read_back_ok,
  )
  let echo_exit = srv3_emit_typed_receipt(
    receipt: srv3_typed_receipt_from_lines(lines: [apply_receipt, dry_receipt]),
  )
  if !process_exit_succeeded(exit: echo_exit) {
    return echo_exit
  }
  if !read_back_ok {
    return exit_failure(reason: "srv3-install-reconcile-apply: read-back failed after boot-once-cd")
  }
  ExitSuccess
}
