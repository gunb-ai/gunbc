module gunbc.heal_candidate_stage0

import std.types { List, String }
import std.process { ProcessExit, exit_failure }
import extdeps.filesystem.filesystem_io { Filesystem }
import v2.std.algebra { list_map }
import gunbc.generated_artifact { artifact_path }
import gunbc.seed_build_artifact_emit { seed_build_artifacts }
import gunbc.heal_publication_boundary { heal_stage0_mirror_directory, path_is_stage0_mirror }
import gunbc.heal_candidate { heal_candidate_produce_declaring, DeclarationFromDriftedPaths }

// THE STAGE0 CANDIDATE: the mirrors the seed's own regeneration round installed, plus the eleven
// artifacts the seed build reads. The population is OBSERVED, as gunbc.heal_candidate says of its
// own: every `.rs` directly in the mirror directory and every seed-build artifact is compared with
// the checked-out head, and a path is in the candidate exactly when its bytes differ. A file the
// regeneration did not touch is unchanged and is not named. The registry is not imported: loading it
// is the 2,659-file closure this entry exists to avoid (gunbc.seed_build_artifact_emit).
fn stage0_mirror_candidate_paths() -> List<String> {
  let listed = Filesystem.List(path: heal_stage0_mirror_directory)
  if !listed.success {
    []
  } else {
    mirror_paths_of(names: split(s: listed.entries, delimiter: "\n"))
  }
}

fn mirror_paths_of(names: List<String>) -> List<String> {
  filter(
    list_map(xs: names, f: fn(name) { concat(concat(heal_stage0_mirror_directory, "/"), name) }),
    p => path_is_stage0_mirror(path: p) && !any(seed_build_artifact_paths(), q => q == p)
  )
}

// ONE PRODUCER PER PATH. A mirror is a directory-observed population ("every .rs there"); a
// seed-build artifact has a named registry producer (gunbc_file_transport_generated.rs is both). The
// producer is the authority, so the mirror category is derived WITHOUT the paths it owns and the two
// categories are disjoint by construction. The seed-build writer also runs after the stage0 round, so
// its bytes are the ones the candidate observes.
fn seed_build_artifact_paths() -> List<String> {
  list_map(xs: seed_build_artifacts(), f: fn(a) { artifact_path(a: a) })
}

fn heal_candidate_stage0_produce_wet() -> ProcessExit {
  let listed = Filesystem.List(path: heal_stage0_mirror_directory)
  if !listed.success {
    exit_failure(reason: concat("HealCandidateStage0MirrorsUnlisted: ", listed.error))
  } else {
    heal_candidate_produce_declaring(
      root: ".",
      paths: concat(stage0_mirror_candidate_paths(), seed_build_artifact_paths()),
      source: DeclarationFromDriftedPaths { subject: "Regenerated by the stage0 mirror convergence round and the seed-build artifact writer" }
    )
  }
}
