module gunbc.git_use_census.roadmap_event_git_execution

import std.types { NonEmptyStr }
import std.decl_ref { decl_ref }
import gunbc.git_use_authority { GitUseRow, DagGitProcessDependency, ClassifiedGitUse, GitWorkspaceSourceAuthority, DeclaredLegacyGitUse }

data roadmap_event_git_execution: GitUseRow = GitUseRow {
  consumer: decl_ref(module_path: "gunbc.roadmap.roadmap_event_carrier", decl_name: "carrier_exec"),

  surface: DagGitProcessDependency { operation: "Execute layout.git_program through carrier_exec_program; the instance binds GitWorkspaceCapability." as NonEmptyStr },

  classification: ClassifiedGitUse {
    role: GitWorkspaceSourceAuthority,
    authorization: DeclaredLegacyGitUse {
      retirement_capability: "All callers of carrier_exec append and read the existing gunbc.roadmap.roadmap_event_log envelopes through a durable native event carrier with independent observation, without Git branch storage or Git-process fallback. This is event-source persistence, not SCM proposal publication." as NonEmptyStr
    }
  },

  bridge_disposition: "Git currently stores the authoritative roadmap event stream on roadmap-events. Import its existing envelopes into the native durable event carrier and route append/read through that carrier; preserve event identities and explicit Git import provenance. KNOWN BYPASS: the direct-import wall does not observe this configured process invocation; closing it requires Node-derived process provenance through capability bindings." as NonEmptyStr,

  cutover_disposition: "The native event carrier remains authoritative for event append/read independently of SCM target landing. Git may export an event-history compatibility projection, but no event reader or appender treats that projection as its authority or falls back to it on refusal." as NonEmptyStr,
}
