module gunbc.v1_complexity_decl_classification_types


type V1ComplexityDeclRole
  = AuthorityOf { capability: gunbc.v1_complexity_capability_census.ComplexityCapabilityId }
  | HelperOf { capability: gunbc.v1_complexity_capability_census.ComplexityCapabilityId }
  | LegacyHazardOf { hazard: gunbc.v1_complexity_capability_census.V1ComplexityResidueId, of_capability: gunbc.v1_complexity_capability_census.ComplexityCapabilityId }
  | LegacyRealizationOf { realization: gunbc.v1_complexity_capability_census.V1ComplexityResidueId, of_capability: gunbc.v1_complexity_capability_census.ComplexityCapabilityId }
  | DeliberatelyOutOfScope { reason: std.types.NonEmptyStr }

type V1ComplexityDeclClassification {
  decl_name: String
  role: V1ComplexityDeclRole
}
