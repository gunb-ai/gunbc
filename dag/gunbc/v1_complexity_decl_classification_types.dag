module gunbc.v1_complexity_decl_classification_types


type V1ComplexityDeclRole
  = AuthorityOf { capability: ComplexityCapabilityId }
  | HelperOf { capability: ComplexityCapabilityId }
  | LegacyHazardOf { hazard: V1ComplexityResidueId, of_capability: ComplexityCapabilityId }
  | LegacyRealizationOf { realization: V1ComplexityResidueId, of_capability: ComplexityCapabilityId }
  | DeliberatelyOutOfScope { reason: NonEmptyStr }

type V1ComplexityDeclClassification {
  decl_name: String
  role: V1ComplexityDeclRole
}
