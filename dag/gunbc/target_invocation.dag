module gunbc.target_invocation

import extdeps.bazel.label {
  Label,
  LabelParse, LabelParsed, LabelRefused, LabelRefusal,
  LabelCanonicalityCause, RenderedLabelRefused, RenderedLabelStructureMismatch,
  parse_label, render_label,
}
import gunbc.target_binding {
  TargetBinding,
  TargetBindingIndex,
  TargetBindingIndexBuild, TargetBindingIndexReady, TargetBindingIndexRefused,
  TargetBindingIndexRefusal,
  TargetBindingLookup,
  TargetProducerBound, KnownTargetBindingMissing, TargetUnknown, TargetLookupLabelNotCanonical,
  build_target_binding_index, target_binding_lookup,
}
import std.types { String, Bool, List }
import std.execution_mode { ExecutionMode, Hermetic, Wet, Record }
import std.integer { Int }
import extdeps.bazel.target_pattern {
  TargetPattern, SingleTarget, PackageTargets, SubtreeTargets,
  TargetPatternParsed, TargetPatternRefused, TargetPatternRefusal,
  parse_target_pattern, target_pattern_refusal_text, target_pattern_within,
}

// THE VERB'S OPERAND IS A TARGET PATTERN, AND ADMISSION IS THE PATTERN AUTHORITY'S DECISION.
//
// The surface row (gunbc.cli_dispatch_surface) names `extdeps.bazel.target_pattern` as the
// operand's authority; this function is where that authority's answer becomes the verb's route.
// Nothing here re-decides the grammar -- no prefix check, no suffix list -- so the CLI cannot grow
// a second, weaker pattern grammar.
//
// THERE ARE TWO EXECUTORS AND THE OPERAND SAYS WHICH, BY CONTAINMENT RATHER THAN BY SPELLING.
// The native test route owns one universe, and that universe is itself a target pattern
// (`gunbc.native_route_universe` `native_route_default_pattern`, `//v2/...`). So "does this"
// operand belong to the native route" is the cited authority's own containment question, asked
// once, here: `extdeps.bazel.target_pattern` `target_pattern_within`. An operand inside it --
// single target or set form alike -- is `TestOperandNativeRoute` and enters the native
// implementation carrying THAT pattern, which is what makes `gunbc test //v2/test/claim/parse:all` a
// narrower native run rather than the whole lane. An operand outside it keeps the route it had:
// a single target is an exact registry lookup, and a set form has no executor at all.
//
// THE UNIVERSE IS A PARAMETER, NOT A ROW THIS MODULE REACHES FOR, for the same reason
// `route_target_invocation_in` takes its index: folding the lane's own rows in here would leave
// this function checkable only against a transcription of them, which is the change detector
// DESIGN's oracle rule rejects. The production caller is the seed's `test_verb`, which supplies the
// pattern it parses from the constant `gunbc.native_route_seed_boundary_emit` renders from
// `native_route_default_pattern`, so the seed holds no spelling of the universe of its own.
//
// THE REFUSAL IS THE AUTHORITY'S OWN CAUSE, CARRIED TYPED. `PatternNotAbsolute` and
// `PatternAllTargetsUnsupported` have different remedies from each other and from every
// `PatternLabelRefused` inner cause, and collapsing them into one malformed-operand arm would be
// the state-space conflation this repository keeps finding.
//
// THE CLAIM ROUTE IS THE SECOND UNIVERSE, DECIDED BY THE SAME CONTAINMENT. Witness claims -- the
// `test fn` declarations the floor's discovery authority enrolls -- are labelled by
// `gunbc.discovery_census` `site_label` (`a.b.c` + `f` -> `//a/b/c:f`), and the subtree those
// labels occupy is `gunbc.discovery_census` `claim_route_universe`. An operand inside it -- an exact
// claim label, a module's `:all`, or a `/...` subtree -- is `TestOperandClaimRoute` and enters the
// claim executor carrying that pattern; the executor selects the discovered claims the pattern
// contains and evaluates them with the floor's own claim evaluation. The native universe is asked
// FIRST, so no operand is answered by both. Like the native universe, the claim universe is a
// parameter the production caller supplies.
type TestOperandAdmission
  = TestOperandExactTarget { label: Label }
  | TestOperandNativeRoute { pattern: TargetPattern }
  | TestOperandClaimRoute { pattern: TargetPattern }
  | TestOperandSetForm { pattern: TargetPattern }
  | TestOperandRefused { operand: String, cause: TargetPatternRefusal }

fn admit_test_operand(
  operand: String,
  native_universe: TargetPattern,
  claim_universe: TargetPattern
) -> TestOperandAdmission {
  match parse_target_pattern(text: operand) {
    TargetPatternRefused { cause: c } => TestOperandRefused { operand: operand, cause: c }
    TargetPatternParsed { pattern: p } =>
      if target_pattern_within(inner: p, outer: native_universe) {
        TestOperandNativeRoute { pattern: p }
      } else if target_pattern_within(inner: p, outer: claim_universe) {
        TestOperandClaimRoute { pattern: p }
      } else {
        match p {
          SingleTarget { label: l } => TestOperandExactTarget { label: l }
          PackageTargets { package: _ } => TestOperandSetForm { pattern: p }
          SubtreeTargets { package: _ } => TestOperandSetForm { pattern: p }
        }
      }
  }
}

// A SET FORM OUTSIDE EVERY ROUTE'S UNIVERSE HAS NO EXECUTOR, AND THAT IS WHAT THIS REFUSES.
//
// Two executors enumerate a population: the native test route (`//v2/...`) and the claim
// route (`//test/claim/...`, the discovered witness claims). The retirement trigger this arm used to
// carry -- "an executor that enumerates a population outside the native universe" -- is satisfied
// for the claim population, so `//test/claim/...` is no longer refused here. A set form outside
// BOTH, such as `//dag/test/claim/...` (a file-path spelling, not a claim label), still names no
// population any executor enumerates, and the instrument registry is not one -- it answers exact
// labels by construction. The verb refuses with status 2 -- no observation -- never 1, which would
// claim a run happened and did not hold. A set form is never widened into another route's
// universe: that would report a run over a population the operand did not name, and handing a
// native-universe operand to the interpreter would report a result the native compiler never
// produced.
fn test_operand_set_form_refusal_rendered(operand: String) -> String {
  concat(
    concat("gunbc test: ", operand),
    " denotes a SET of targets outside every route's universe (the native test route and the claim route); no executor enumerates that population, and a set form is never widened into another route"
  )
}

// THE BATCH IS SUPPLIED, NOT DERIVED, AND THE TWO NO-WIDENING OBLIGATIONS SIT ON DIFFERENT SIDES.
//
// `gunbc.plans.claim_execution_consolidation` §2 line 25: "One invocation runs an exact supplied batch. `gunbc test`
// accepts several operands and runs exactly the claims they denote, in one process ... Overlapping operands select each
// claim identity once. No caller widens a sparse request to `:all` or a subtree to fit the interface, and none spawns
// one process per claim." Three facts decide where each half of that sentence is enforced, and getting them apart is
// the point of this fold:
//
//   * THE ROUTE ADMITS SET FORMS. §1 line 15 gives the interface as `gunbc test <target-pattern>...`, and a pattern
//     that denotes many claims is a legitimate request -- `//test/claim/...` means exactly the claims under it. So a
//     fold that refused subtree forms would be refusing something the plan asks for.
//   * `TestOperandSetForm` CANNOT SERVE AS A WIDENING GUARD even if one were wanted: it fires only when the set form
//     lies OUTSIDE both universes. A subtree inside the claim universe is admitted as `TestOperandClaimRoute` and
//     carried to the executor, which selects the discovered claims the pattern contains. A reviewer who assumed
//     otherwise would have a guard that never fires.
//   * THE NO-WIDENING DUTY IS THE CALLER'S, so it is checkable where a reviewer can read it -- on each migrated argv
//     (a caller that wants three claims passes three exact labels). The caller table of gunb-ai/gunbc#16872 is that
//     control. It is not enforced here, and this comment says so rather than leaving the absence to be discovered.
//
// AN EMPTY BATCH IS ITS OWN CAUSE, AND THE FIRST REFUSAL WINS. `TestOperandsEmpty` and `TestOperandsRefused` have
// different remedies: one says the invocation asked for nothing, the other names an operand to repair -- the state-space
// conflation this repository keeps finding. A refusal is never overwritten by a later operand, because the first cause
// is the one a reader can act on while the rest of the input is still in front of them. There is no "run everything"
// fallback: `gunbc run --claim-run`'s no-`--entry` branch ran every test function in the roots, and it is deleted
// rather than ported.
//
// OVERLAP IS DEDUPLICATED ON OPERAND TEXT, AND THAT IS THE WHOLE OF WHAT THIS FOLD CAN DO. Two occurrences of one
// operand denote one claim, so the second adds nothing. Deduplication across DIFFERENT operand forms -- a subtree and
// an exact label naming the same claim -- needs the discovered population, which lives with the executor, not with an
// admission over text; the seed's control (gunb-ai/gunbc#16872, controls table) is the case that pins it, and this
// layer deliberately does not claim a property it cannot see.
type TestOperandSelection
  = TestOperandsSelected { exact: List<Label>, native: List<TargetPattern>, claim: List<TargetPattern>, seen: List<String> }
  | TestOperandsEmpty
  | TestOperandsRefused { operand: String, cause: TestOperandFoldRefusal }

// THE FOLD CARRIES THE AUTHORITY'S CAUSE, TYPED, WITH ONE ADDITION OF ITS OWN. `FoldPatternRefused` wraps the pattern
// authority's own `TargetPatternRefusal` rather than paraphrasing it, for the reason given above at
// `test_operand_refusal_rendered`. `FoldSetFormOutsideEveryUniverse` is the fold's own fact: a set form outside both
// universes is refused by `admit_test_operand` as `TestOperandSetForm`, which carries the pattern and no cause, so the
// fold names what it knows -- the operand, and the pattern that denoted nothing any executor enumerates.
type TestOperandFoldRefusal
  = FoldPatternRefused { cause: TargetPatternRefusal }
  | FoldSetFormOutsideEveryUniverse { pattern: TargetPattern }

// ONE OPERAND, ADMITTED ALONE. Every arm of `admit_test_operand` maps to exactly one arm here, with the contributing
// item in a one-element list so `test_operands_merge` has a uniform shape to merge into an accumulator.
fn test_operands_admit_one(
  operand: String,
  native_universe: TargetPattern,
  claim_universe: TargetPattern
) -> TestOperandSelection {
  match admit_test_operand(operand: operand, native_universe: native_universe, claim_universe: claim_universe) {
    TestOperandExactTarget { label: l } =>
      TestOperandsSelected { exact: [l], native: [], claim: [], seen: [operand] }
    TestOperandNativeRoute { pattern: p } =>
      TestOperandsSelected { exact: [], native: [p], claim: [], seen: [operand] }
    TestOperandClaimRoute { pattern: p } =>
      TestOperandsSelected { exact: [], native: [], claim: [p], seen: [operand] }
    TestOperandSetForm { pattern: p } =>
      TestOperandsRefused { operand: operand, cause: FoldSetFormOutsideEveryUniverse { pattern: p } }
    TestOperandRefused { operand: o, cause: c } =>
      TestOperandsRefused { operand: o, cause: FoldPatternRefused { cause: c } }
  }
}

// A refusal absorbs everything: once a batch is refused, no later operand can make it admissible, and the located cause
// stays the one the reader sees.
fn test_operands_merge(acc: TestOperandSelection, next: TestOperandSelection) -> TestOperandSelection {
  match acc {
    TestOperandsRefused { operand: o, cause: c } => TestOperandsRefused { operand: o, cause: c }
    TestOperandsEmpty => next
    TestOperandsSelected { exact: e, native: n, claim: c, seen: s } => match next {
      TestOperandsSelected { exact: e2, native: n2, claim: c2, seen: s2 } => TestOperandsSelected {
        exact: fold(e2, init: e, f: (a1, x) => append(a1, x)),
        native: fold(n2, init: n, f: (a2, x) => append(a2, x)),
        claim: fold(c2, init: c, f: (a3, x) => append(a3, x)),
        seen: fold(s2, init: s, f: (a4, x) => append(a4, x))
      }
      TestOperandsEmpty => TestOperandsSelected { exact: e, native: n, claim: c, seen: s }
      TestOperandsRefused { operand: o, cause: c2 } => TestOperandsRefused { operand: o, cause: c2 }
    }
  }
}

// THE BATCH, ADMITTED. Total over the operand list, with no reach for a population or a row: `native_universe` and
// `claim_universe` stay parameters for the reason stated at the top of this module (a fold that pulled in the lane's own
// rows would be checkable only against a transcription of them, which is the change detector DESIGN's oracle rule
// rejects). `TestOperandsSelected.seen` is the fold's bookkeeping for the overlap rule and carries no meaning after
// admission.
fn admit_test_operands(
  operands: List<String>,
  native_universe: TargetPattern,
  claim_universe: TargetPattern
) -> TestOperandSelection {
  if length(operands) == 0 {
    TestOperandsEmpty
  } else {
    fold(
      operands,
      init: TestOperandsSelected { exact: [], native: [], claim: [], seen: [] },
      f: (acc, operand) => match acc {
        TestOperandsRefused { operand: o, cause: c } => TestOperandsRefused { operand: o, cause: c }
        TestOperandsEmpty =>
          test_operands_admit_one(
            operand: operand,
            native_universe: native_universe,
            claim_universe: claim_universe
          )
        TestOperandsSelected { exact: e, native: n, claim: c, seen: s } =>
          if any(s, t => t == operand) {
            TestOperandsSelected { exact: e, native: n, claim: c, seen: s }
          } else {
            test_operands_merge(
              acc: acc,
              next: test_operands_admit_one(
                operand: operand,
                native_universe: native_universe,
                claim_universe: claim_universe
              )
            )
          }
      }
    )
  }
}

// AN EXACT LABEL THE REGISTRY DOES NOT BIND, WHOSE MODULE RESOLVES IN THE ROOTS, IS A CLAIM.
//
// `admit_test_operand` decides by pattern containment alone, so an exact label outside both universes is the registry's
// to answer. That was right for `//gunbc/instruments:<name>` and wrong for every claim outside `//test/claim/...`: a
// pinned validation oracle under dag/test/manual, or a parse control under src/v1/tests/claim, named exactly by its
// label, was refused as an unknown target although its module resolves and its `test fn` exists (found after the
// claim-execution cutover: `roadmap_launch_canary_execution_contract` spawned exactly that refusal, exit 2). The claim
// route already selects from every module the given roots hold, so the defect was the admission, and the repair is here.
//
// THE REGISTRY IS ASKED FIRST, so a bound instrument subject keeps its producer even if a module of the same path
// exists, and an unbound label whose module does NOT resolve keeps its `TargetIsUnknown` refusal: a typo is still a typo.
// Only an exact label moves; a set form outside both universes stays refused by the fold above, because no executor
// enumerates it. Both questions are PARAMETERS -- the registry's binding and the corpus's resolution are owned elsewhere
// (`gunbc.instrument_targets`, the roots' module index), and a fold that reached for either would be checkable only
// against a transcription of it.
fn admit_resolvable_exact_targets(
  selection: TestOperandSelection,
  registry_binds: fn(Label) -> Bool,
  module_resolves: fn(Label) -> Bool
) -> TestOperandSelection {
  match selection {
    TestOperandsEmpty => TestOperandsEmpty
    TestOperandsRefused { operand: o, cause: c } => TestOperandsRefused { operand: o, cause: c }
    TestOperandsSelected { exact: e, native: n, claim: c, seen: s } => TestOperandsSelected {
      exact: filter(e, l => registry_binds(l) || !module_resolves(l)),
      native: n,
      claim: fold(
        filter(e, l => !registry_binds(l) && module_resolves(l)),
        init: c,
        f: (acc, l) => append(acc, SingleTarget { label: l })
      ),
      seen: s
    }
  }
}

// WHICH BATCH A SELECTION IS, DECIDED FROM WHAT IT CONTAINS RATHER THAN FROM A SPELLING. The option admissions below
// (`admit_test_execution_mode`, `admit_test_source_roots`) refuse on this, and the refusal must name a batch that
// exists: an option belonging to the claim route is refused on a native batch, an instrument batch, or a batch that
// mixes the two -- mixing is not something the plan asks for, so it is refused rather than silently routed to whichever
// executor would take part of it.
// WHICH BATCH A SELECTION IS, DECIDED FROM WHAT IT CONTAINS RATHER THAN FROM A SPELLING. The option admissions below
// (`admit_test_execution_mode`, `admit_test_source_roots`) refuse on this, and the refusal must name a batch that
// exists: an option belonging to the claim route is refused on a native batch, a registry batch, or a batch that mixes
// them -- mixing is not something the plan asks for, so it is refused rather than silently routed to whichever executor
// would take part of it.
//
// THE REGISTRY POPULATION IS ITS OWN ARM BECAUSE IT IS NOT THE NATIVE ONE. `TestOperandAdmission`'s exact arm is what
// `admit_test_operand` yields for a label inside NEITHER universe, and that is where the instrument subjects live
// (`//gunbc/instruments:<name>` is outside `//v2/...` and outside `//test/claim/...`): they run today, through a
// `gunbc.instrument_targets` binding and one `Producer` arm. Folding them into `NativeBatch` would let an instrument
// target inherit native behaviour, and refusing them in the fold would delete a working entry point -- both are
// regressions the field names hide, so the arm is named for who answers it.
type TestBatchRoute
  = ClaimBatch
  | NativeBatch
  | InstrumentRegistryBatch { exact: Int }
  | MixedBatch { native: Int, claim: Int, exact: Int }
  | NoOperandsSelected

fn test_selection_batch_route(selection: TestOperandSelection) -> TestBatchRoute {
  match selection {
    // An empty batch, or a refused one, has no route: NoOperandsSelected makes the option admission refuse the whole
    // invocation before anything is evaluated, rather than letting an option be admitted onto nothing.
    TestOperandsEmpty => NoOperandsSelected
    TestOperandsRefused { operand: o, cause: c } => NoOperandsSelected
    TestOperandsSelected { exact: e, native: n, claim: c, seen: s } =>
      if length(c) > 0 && length(n) == 0 && length(e) == 0 {
        ClaimBatch
      } else if length(n) > 0 && length(c) == 0 && length(e) == 0 {
        NativeBatch
      } else if length(e) > 0 && length(n) == 0 && length(c) == 0 {
        InstrumentRegistryBatch { exact: length(e) }
      } else if length(n) == 0 && length(c) == 0 && length(e) == 0 {
        NoOperandsSelected
      } else {
        MixedBatch { native: length(n), claim: length(c), exact: length(e) }
      }
  }
}

// THE OPTION SURFACE IS TWO OPTIONS, AND THE DEFAULT IS A GRANT RATHER THAN A REFUSAL.
//
// The cutover adds exactly two things to `gunbc test`: the execution mode and the corpus it reads. Both are claim-route
// only, and both refuse on every other route -- the same rule stated once, in the same shape, so a reader checking
// "can this option reach the interpreter?" finds one answer in two places rather than two answers to compare.
//
// A MODE IS THE ONLY THING SPELLING A MODE CAN CHANGE, AND UNSPELLING IS NOT A FAILURE. With no mode flag the batch
// runs `Hermetic`, which is what `execution_mode_for(None, is_claim = true)` does today and what every contributor's
// `gunbc test <label>` and the remote build's test command already rely on; refusing an unspelled mode would break the
// one-command goal and every existing invocation, so the arm below grants it and there is deliberately no refusal arm to
// reach for. `Record` is a mode of its own -- effects run and fixtures are written -- which is why `--record` alone
// grants the claim's host effects, `--hermetic --fixture-store <dir>` replays with none, and `--record --wet` is TWO
// mode flags rather than a combination: the refusal names both, because a reader correcting this needs to know which
// two they typed.
//
// A FIXTURE STORE NAMES A MODE AND DOES NOT DEFAULT ONE. `--fixture-store <dir>` without an explicit `--record` or
// `--hermetic` is refused: a store is meaningful in exactly two modes and guessing which one the caller meant would put
// the guess where the caller's intent belongs.
type TestModeFlags {
  hermetic: Bool
  wet: Bool
  record: Bool
  fixture_store: String
}

type TestExecutionModeRefusal
  = ModeFlagsConflict { first: String, second: String }
  | RecordWithoutFixtureStore
  | FixtureStoreWithoutRecordOrHermetic
  | ModeOptionOnNonClaimBatch

type TestExecutionModeAdmission
  = TestExecutionModeGranted { mode: ExecutionMode, fixture_store: String }
  | TestExecutionModeDenied { cause: TestExecutionModeRefusal }

// Total, and the spelling of the conflict is checked rather than inferred from the count of flags: `first` and `second`
// are the flags as typed, in the order a reader meets them in the argv.
fn admit_test_execution_mode(
  batch: TestBatchRoute,
  flags: TestModeFlags
) -> TestExecutionModeAdmission {
  if batch != ClaimBatch {
    TestExecutionModeDenied { cause: ModeOptionOnNonClaimBatch }
  } else if flags.wet && flags.record {
    TestExecutionModeDenied { cause: ModeFlagsConflict { first: "--wet", second: "--record" } }
  } else if flags.wet && flags.hermetic {
    TestExecutionModeDenied { cause: ModeFlagsConflict { first: "--hermetic", second: "--wet" } }
  } else if flags.hermetic && flags.record {
    TestExecutionModeDenied { cause: ModeFlagsConflict { first: "--hermetic", second: "--record" } }
  } else if flags.record && length(flags.fixture_store) == 0 {
    // Record writes fixtures; a mode that writes into nowhere is a request nobody can honour, and the fixture store is
    // the mode's OWN argument -- never a source root.
    TestExecutionModeDenied { cause: RecordWithoutFixtureStore }
  } else if length(flags.fixture_store) > 0 && !flags.record && !flags.hermetic {
    TestExecutionModeDenied { cause: FixtureStoreWithoutRecordOrHermetic }
  } else if flags.record {
    TestExecutionModeGranted { mode: Record, fixture_store: flags.fixture_store }
  } else if flags.wet {
    TestExecutionModeGranted { mode: Wet, fixture_store: "" }
  } else {
    // The grant every existing invocation depends on: no flag, or `--hermetic` alone (with or without a store to
    // replay from). Hermetic is granted, not refused.
    TestExecutionModeGranted { mode: Hermetic, fixture_store: flags.fixture_store }
  }
}

// THE CORPUS THE ONE ROUTE READS, SELECTED NOT SWITCHED. `--source-root` is an option on the claim route for one
// reason the plan settles by name (section 2, line 26): "For each caller that supplies source roots today, it is
// established whether that set is redundant with `witness_layer_roots` or meaningful (fixture-driven callers
// especially), and the migration preserves the meaningful ones." The fixture witness passes a third root today, the
// directory its scratch entry lives in, and a label cannot reach a file outside the roots.
//
// THIS IS NOT A SECOND ENTRYPOINT, AND THE TEST IS THAT THE ADMISSION AND THE RESULT RULE DO NOT CHANGE. The operands
// stay labels admitted by `admit_test_operands`; what this option selects is which corpus those labels are looked up
// in. It is refused on the native and instrument routes exactly as the mode option is, so the number of routes that
// read a caller-supplied corpus stays one.
//
// THE REPLACE-NOT-APPEND RULE IS IN THE TYPE, NOT IN A COMMENT (gunbc.design_argument::source_annotations: a comment is
// unreadable by any pass). There is exactly one roots field, the route reads that field and nothing else, and
// `default_roots` is a PARAMETER the caller of this admission supplies -- it never reaches a row of its own, so when an
// option was given the defaults have nowhere to reappear. The seed control that makes this readable gives one root and
// asserts no default is among `Granted.roots`.
type TestSourceRootRefusal
  = SourceRootsOnNonClaimBatch
  | RootValueAbsent
  | RootNotWalkable { root: String, reason: String }

type TestSourceRootsAdmission
  = TestSourceRootsGranted { roots: List<String> }
  | TestSourceRootsDenied { cause: TestSourceRootRefusal }

// Total. `default_roots` is supplied by the caller (the seed passes `gunbc.ci.ci_layer_roots.witness_layer_roots`)
// rather than named here, for the same reason the universes are parameters above: a module that pulled in the lane's
// own rows would be checkable only against a transcription of them.
fn admit_test_source_roots(
  batch: TestBatchRoute,
  given: List<String>,
  default_roots: List<String>
) -> TestSourceRootsAdmission {
  if batch != ClaimBatch {
    TestSourceRootsDenied { cause: SourceRootsOnNonClaimBatch }
  } else if length(given) == 0 {
    TestSourceRootsGranted { roots: default_roots }
  } else if any(given, r => length(r) == 0) {
    TestSourceRootsDenied { cause: RootValueAbsent }
  } else {
    TestSourceRootsGranted { roots: given }
  }
}

// A ROOT THAT TURNS OUT NOT TO BE A DIRECTORY IS DISCOVERED BY THE INDEX, NOT BY THIS ADMISSION. `RootNotWalkable`
// stays unconstructible here -- length and emptiness are all a string can be judged by -- and exists so the seed's
// unreadable-root path reports through THIS vocabulary next to `ClaimSourceRefusalCause.ClaimSourceRootUnreadable`
// above, which keeps the prose cause out of a typed refusal the same way.
fn test_source_root_not_walkable(root: String, reason: String) -> TestSourceRootRefusal {
  RootNotWalkable { root: root, reason: reason }
}

// A CLAIM-ROOT SOURCE THE ROUTE CANNOT READ IS NO OBSERVATION, AND ITS CAUSE IS NOT A TYPO'S.
//
// `gunbc test //test/claim/x:c` selects a claim by the module name a file declares, and paths follow
// names (gunbc.design_argument::single_authority). A file whose declaration cannot be read therefore cannot be selected, and
// reporting that as "the pattern selected no discovered claim" makes a broken admitted file read like
// a misspelled label. All six causes terminate `InvocationSubjectUnreached` (exit 2, never 1: no claim
// ran), each LOCATED at the file and each distinct from an unknown label.
type ClaimSourceRefusalCause
  = ClaimSourceUnparseable { diagnostic: String }
  | ClaimSourceModuleHeaderAbsent
  | ClaimSourceUnreadable { reason: String }
  | ClaimSourceRootUnreadable { reason: String }
  | ClaimSourceDirectoryNamedDag
  | ClaimSourceModuleCollision { other: String }

fn claim_source_refusal_rendered(path: String, cause: ClaimSourceRefusalCause) -> String {
  concat(
    concat("claim source refused: ", path),
    match cause {
      ClaimSourceUnparseable { diagnostic: d } => concat(": the file does not parse: ", d)
      ClaimSourceModuleHeaderAbsent => ": a .dag under the claim root declares no module, so no claim label can name it (paths follow names)"
      ClaimSourceUnreadable { reason: r } => concat(": unreadable: ", r)
      ClaimSourceDirectoryNamedDag => ": a directory named like a .dag source; a source path is a file"
      ClaimSourceRootUnreadable { reason: r } => concat(": unreadable source root: ", r)
      ClaimSourceModuleCollision { other: o } => concat(concat(": declares a module also declared by ", o), "; one module, one authority (gunbc.design_argument::single_authority), so de-fork or rename one side")
    }
  )
}

// THE CLAIM ROUTE'S MEMBER VERDICTS, AND THE FOLD THAT MAKES THEM THE OPERAND'S TERMINATION.
//
// One verdict per selected claim. `ClaimDidNotHold` is an OBSERVATION -- the claim evaluated and
// returned false or a non-Bool value. `ClaimUnobserved` is the absence of one -- a runtime error, a
// host refusal, an unwind, a budget interrupt -- and is not reported as a failing claim, for the
// same reason `InvocationSubjectUnreached` is not `InvocationObservationDidNotHold`.
type ClaimRouteVerdict
  = ClaimHeld
  | ClaimDidNotHold
  | ClaimUnobserved

type ClaimRouteTally {
  did_not_hold: Bool
  unobserved: Bool
  members: Int
}

fn claim_route_tally_step(acc: ClaimRouteTally, v: ClaimRouteVerdict) -> ClaimRouteTally {
  match v {
    ClaimHeld => ClaimRouteTally {
      did_not_hold: acc.did_not_hold,
      unobserved: acc.unobserved,
      members: acc.members + 1
    }
    ClaimDidNotHold => ClaimRouteTally {
      did_not_hold: true,
      unobserved: acc.unobserved,
      members: acc.members + 1
    }
    ClaimUnobserved => ClaimRouteTally {
      did_not_hold: acc.did_not_hold,
      unobserved: true,
      members: acc.members + 1
    }
  }
}

// A DEFINITE FAILURE DOMINATES; AN EMPTY SELECTION IS UNREACHED. A claim that returned false is a
// finding whatever happened beside it; a selection with an unobserved member cannot answer "held";
// and a pattern that selected nothing produced no evidence, so it is `InvocationSubjectUnreached`
// (exit 2), never a vacuous pass -- the absence-is-not-success rule `gunbc.instrument_targets`
// `native_route_member_termination` keeps for the native route.
fn claim_route_termination(verdicts: List<ClaimRouteVerdict>) -> InvocationTermination {
  let tally = fold(
    verdicts,
    init: ClaimRouteTally { did_not_hold: false, unobserved: false, members: 0 },
    f: (acc, v) => claim_route_tally_step(acc: acc, v: v)
  )
  if tally.did_not_hold {
    InvocationObservationDidNotHold {}
  } else if tally.unobserved {
    InvocationSubjectUnreached {}
  } else if tally.members == 0 {
    InvocationSubjectUnreached {}
  } else {
    InvocationObservationHeld {}
  }
}

// A REFUSED OPERAND TERMINATES AS REFUSED, AND THE RENDERING NAMES THE AUTHORITY'S CAUSE. The
// inner text is `target_pattern_refusal_text` -- the pattern authority's own renderer -- rather
// than a paraphrase here, for the same reason `label_canonicality_cause_rendered` declines to
// decompose `LabelRefusal`: this layer names the class of repair, the authority names the cause.
fn test_operand_refusal_rendered(operand: String, cause: TargetPatternRefusal) -> String {
  concat(
    concat("gunbc test: operand is not an admitted target pattern: ", operand),
    concat("\n  cause: ", target_pattern_refusal_text(r: cause))
  )
}

// THE ONE ROUTE FROM AN ARGV OPERAND TO A BOUND PRODUCER, AND IT KNOWS NO INSTRUMENT'S NAME.
//
// Direct invocation asks a different question from the `//:required` aggregate, and this module
// exists so the two never answer each other's. The aggregate asks whether a target's standing
// SATISFIES a required set, and `gunbc.build_target` `test_standing_verdict` deliberately refuses
// every instrument producer there as out-of-aggregate. A direct `gunbc test <label>` asks what the
// producer OBSERVED. Routing the direct answer through aggregate policy would report a completed
// instrument as unsatisfied — correct code applied to the wrong question — and routing it through
// the Blaze status export would refuse it for the same reason, since that export has no honest
// upstream member for a producer-specific standing.
//
// WHAT IS NOT HERE, DELIBERATELY: any arm naming a producer, an instrument, or a host function.
// The route ends at the BINDING; which realization runs it is the peripheral dispatch
// gunbc.design_argument::single_authority keeps out of the interface, and a coordinator carrying one arm per instrument here
// would be the N-times fork this seam is built to make unnecessary. Adding a fifth instrument is
// a row in the population this module folds over, not an edit to this module.

// EVERY WAY THE ROUTE CAN FAIL, EACH WITH ITS OWN CAUSE AND ITS OWN REMEDY.
//
// `OperandNotALabel` carries the label grammar's own refusal rather than a message, so a target
// PATTERN reaches the caller as `TargetPattern` — the remedy is "name one target" — and a
// relative label reaches it as `MissingRepositoryRootPrefix`, whose remedy is "make it absolute".
// Collapsing them into one malformed-operand arm would be the state-space conflation this
// repository keeps finding: one symbol over causes whose repairs differ.
//
// `TargetIsUnknown` and `TargetHasNoProducer` are separated for the same reason and the
// distinction is the sharper one: an unknown label is a typo or an unregistered target, while a
// KNOWN target with no binding is a registry gap — the target exists, nothing realizes it, and
// reporting that as "no such target" would send the reader to fix the spelling of a label that is
// already correct.
type TargetInvocationRefusal
  = OperandNotALabel { operand: String, cause: LabelRefusal }
  | InvocationRegistryRefused { cause: TargetBindingIndexRefusal }
  | InvocationLabelNotCanonical { target: Label, cause: LabelCanonicalityCause }
  | TargetIsUnknown { target: Label }
  | TargetHasNoProducer { target: Label }

type TargetInvocationRoute
  = TargetInvocationRouted { binding: TargetBinding }
  | TargetInvocationRouteRefused { cause: TargetInvocationRefusal }

// THE ROUTE IS PARAMETERIZED ON THE POPULATION AND NOT REACHING FOR THE PRODUCTION ROWS.
//
// The live rows are bound one module away in `gunbc.instrument_targets`. Folding over them here
// would leave this function checkable only against a transcription of the rows it already reads,
// which is the change detector DESIGN's oracle rule rejects; taking them as arguments lets a
// controlled fixture author an input and an expected outcome independently.
fn route_target_invocation_in(index: TargetBindingIndex, target: Label) -> TargetInvocationRoute {
  match target_binding_lookup(index: index, target: target) {
    TargetProducerBound { binding: b } => TargetInvocationRouted { binding: b }
    TargetUnknown { target: t } =>
      TargetInvocationRouteRefused { cause: TargetIsUnknown { target: t } }
    KnownTargetBindingMissing { target: t } =>
      TargetInvocationRouteRefused { cause: TargetHasNoProducer { target: t } }
    TargetLookupLabelNotCanonical { target: t, cause: c } =>
      TargetInvocationRouteRefused { cause: InvocationLabelNotCanonical { target: t, cause: c } }
  }
}

// ADMISSION IS THE CITED GRAMMAR'S DECISION, TAKEN ONCE, AT THE BOUNDARY.
//
// `parse_label` is the only thing that decides whether the operand text names a target, so this
// function contains no string test of its own — no prefix check, no pattern list, no colon count.
// Every family the label authority excludes refuses here for free and with the cause that
// authority named, which is what keeps the CLI from growing a second, weaker label grammar that
// drifts from the one `//:required` is keyed on.
fn route_target_invocation(
  operand: String,
  targets: List<Label>,
  bindings: List<TargetBinding>
) -> TargetInvocationRoute {
  match parse_label(text: operand) {
    LabelRefused { cause: c } =>
      TargetInvocationRouteRefused { cause: OperandNotALabel { operand: operand, cause: c } }
    LabelParsed { label: l } =>
      match build_target_binding_index(targets: targets, bindings: bindings) {
        TargetBindingIndexRefused { cause: c } =>
          TargetInvocationRouteRefused { cause: InvocationRegistryRefused { cause: c } }
        TargetBindingIndexReady { index: idx } =>
          route_target_invocation_in(index: idx, target: l)
      }
  }
}

// HOW ONE INVOCATION ENDED, IN A VOCABULARY EVERY PRODUCER CLASSIFIES ITS OWN STANDING INTO.
//
// This is the hoist DESIGN records for `gunbc.scm.load_standing` rather than a match over any
// producer's arms: each producer owns a total function from its native standing into these four
// states, so a new producer is a new classifier and never a new arm in a consumer that would
// otherwise collapse causes it does not distinguish. The four are kept apart because their
// remedies are: repair the tree, wait for nothing (it held), give the producer a subject it can
// reach, and fix the producer or the invocation.
//
// `SubjectUnreached` IS NOT `ObservationDidNotHold`. An instrument handed a source root that does
// not exist observed nothing, and reporting that as a failing differential would be the
// fabricated-plausible-output failure — a defect announced where no reading was taken.
type InvocationTermination
  = InvocationObservationHeld
  | InvocationObservationDidNotHold
  | InvocationSubjectUnreached
  | InvocationRefused

// THE PROCESS STATUS, DECIDED ONCE AND WILDCARD-FREE.
//
// Three statuses rather than two, because a caller that cannot separate "the instrument ran and
// found a defect" from "the instrument never ran" is handed the same absorbing answer
// gunbc.design_argument::fail_closed forbids: 1 is an OBSERVATION that did not hold, 2 is the absence of an observation.
// A fifth termination arm must fail to compile here rather than inherit whichever status a `_`
// happened to name.
fn invocation_exit_status(t: InvocationTermination) -> Int {
  match t {
    InvocationObservationHeld => 0
    InvocationObservationDidNotHold => 1
    InvocationSubjectUnreached => 2
    InvocationRefused => 2
  }
}

// ONE CLAIM'S VERDICT AS ITS `gunbc test` EXIT, AND BACK. A claim run alone in a guest returns only
// its exit, so a reader of that exit decodes into ClaimRouteVerdict. The exit is DERIVED from the
// route's own fold over that one verdict -- not a second table -- and decoding is the inverse over
// the three verdicts, so a status the fold never produces has no verdict and the reader refuses it.
fn claim_route_verdict_exit(v: ClaimRouteVerdict) -> Int {
  invocation_exit_status(t: claim_route_termination(verdicts: [v]))
}

fn claim_route_verdict_of_exit(code: Int) -> ClaimRouteVerdict? {
  filter([ClaimHeld, ClaimDidNotHold, ClaimUnobserved], v => claim_route_verdict_exit(v: v) == code).first()
}

// THE CANONICALITY CAUSE REACHES THE USER, WHICH IS THE POINT OF CARRYING IT AT ALL.
//
// `extdeps.bazel.label` splits a non-canonical label into two facts with two different repairs: a
// rendering that does not parse at all, and one that parses to a DIFFERENT structure than the
// value held -- typically a `PackagePath` authored as one segment containing a `/` where the
// grammar builds two. Retaining that distinction through the registry (gunbc#9323) and then
// dropping it here would have made the split real and invisible at the only surface a caller of
// this verb touches, which is the one place it was ever going to be read.
//
// THE INNER `LabelRefusal` IS CARRIED BUT NOT DECOMPOSED HERE, AND THE OMISSION IS DELIBERATE.
// That vocabulary belongs to the label authority and has no renderer there today; writing one in
// this module would be a second site deciding what `DotSegment` or `TargetPattern` says to a
// human -- the gunbc.design_argument::single_authority fork, arriving through a rendering rather than through a type. The typed cause
// stays intact on the refusal for any consumer that wants to descend, and this text names the
// CLASS of repair, which is what distinguishes the two arms. A renderer landing in
// `extdeps.bazel.label` is what this arm should call.
fn label_canonicality_cause_rendered(c: LabelCanonicalityCause) -> String {
  match c {
    RenderedLabelRefused { cause: _ } =>
      "\n  cause: the label's own rendering does not parse back; fix the label text"
    RenderedLabelStructureMismatch { reparsed: r } =>
      concat(
        "\n  cause: its rendering parses to a different structure: ",
        concat(render_label(l: r), " -- the package segments were not built by the grammar")
      )
  }
}

// A REFUSED ROUTE TERMINATES AS REFUSED, AND THE RENDERING NAMES THE CAUSE.
fn invocation_refusal_rendered(cause: TargetInvocationRefusal) -> String {
  match cause {
    OperandNotALabel { operand: o, cause: _ } =>
      concat("gunbc test: operand is not an absolute label: ", o)
    InvocationRegistryRefused { cause: _ } =>
      "gunbc test: the target registry refused to build"
    InvocationLabelNotCanonical { target: t, cause: c } =>
      concat(
        concat("gunbc test: label is not canonical: ", render_label(l: t)),
        label_canonicality_cause_rendered(c: c)
      )
    TargetIsUnknown { target: t } =>
      concat("gunbc test: no such target: ", render_label(l: t))
    TargetHasNoProducer { target: t } =>
      concat("gunbc test: target has no bound producer: ", render_label(l: t))
  }
}

// IS THE BINARY ANSWERING FOR THE TREE IT IS ABOUT TO READ?
//
// Every instrument behind `gunbc test` is compiled into the binary that runs it, and reads a live
// tree beside it. A binary whose inputs have changed since it was built answers for code that is
// no longer there, and its reading is reported under the current tree's name -- a silent wrong
// answer, four incidents in one day before this check existed. So the invocation's first act is
// to ask whether the binary still answers for its inputs, and refuse when it does not or when
// nothing can say.
//
// THE INPUT SET IS THE ONE CARGO RECORDED, NOT A LIST WE AUTHOR. Cargo's dep-info beside the
// binary (`<bin>.d`) lists every file the compile read, `include_str!` files included, and every
// path the build script watches. The build script watches the workspace's manifest, lockfile,
// toolchain pin and cargo configuration (`gunbc.seed_build_inputs`), which decide what the compile
// means -- release overflow checks are a profile setting -- without rustc reading them. So the
// set is exact, not a path heuristic. Keying on HEAD equality instead would refuse a correct binary
// after every unrelated commit, which teaches people to route around the check
// (calm-boar-904's ruling on #13007).
//
// The comparison is cargo's own rule: an input newer than the BUILD START, read from the unit's
// fingerprint dep-info, which cargo rewinds to when compilation began. The binary's own mtime is
// the wrong anchor: an input edited after rustc read it but before the link finished is older
// than the binary and was never compiled. A watched directory is judged as cargo scans it: it is
// newer when it or anything below it, file or directory, is, so a file added, edited or removed
// at any depth counts, and the first changed file is named. So a refusal here means exactly
// "cargo build would rebuild". It is NOT content-exact: an input whose mtime moved
// without its bytes changing refuses too, as cargo would rebuild. A content-exact check needs a
// digest recorded AFTER the compile that writes dep-info, which no in-tree build hook can do.
//
// A binary built in another checkout names that checkout's files. Each such input is judged by
// the rule above at the path the binary read, which says its bytes are the bytes compiled, and
// then by byte equality with this checkout's file at the same path, a directory as a whole tree
// with its membership; an input that differs or is absent here is stale. So identical sources
// answer for every checkout, and any difference refuses.
//
// The host classifies each input (the effectful mtime, path and byte reads); this function decides
// the precedence: undecided beats stale beats fresh, so an unjudgeable input is never masked by a
// staleness verdict and a stale input never by a fresh one.
type BinaryInput
  = InputNotNewer { path: String }
  | InputNewer { path: String }
  | InputMissing { path: String }
  | InputDiffersFromThisCheckout { path: String }

type BinaryInputObservation
  = InputsObserved { binary: String, inputs: List<BinaryInput> }
  | DepInfoUnreadable { binary: String, reason: String }

type BinaryFreshness
  = BinaryFresh { binary: String, inputs: Int }
  | BinaryStale { binary: String, input: String, why: String }
  | BinaryFreshnessUndecided { binary: String, reason: String }

// One input's step. An undecided or stale verdict absorbs every later input.
fn binary_freshness_step(acc: BinaryFreshness, input: BinaryInput) -> BinaryFreshness {
  match acc {
    BinaryFreshnessUndecided { binary: _, reason: _ } => acc
    BinaryStale { binary: _, input: _, why: _ } => acc
    BinaryFresh { binary: b, inputs: n } =>
      match input {
        InputDiffersFromThisCheckout { path: p } => BinaryStale { binary: b, input: p, why: "differs from the file the binary was built from in another checkout" }
        InputNewer { path: p } => BinaryStale { binary: b, input: p, why: "changed after the binary was built" }
        InputMissing { path: p } => BinaryStale { binary: b, input: p, why: "no longer exists" }
        InputNotNewer { path: _ } => BinaryFresh { binary: b, inputs: n + 1 }
      }
  }
}

fn assess_binary_freshness(observed: BinaryInputObservation) -> BinaryFreshness {
  match observed {
    DepInfoUnreadable { binary: b, reason: r } => BinaryFreshnessUndecided { binary: b, reason: r }
    InputsObserved { binary: b, inputs: ins } =>
      fold(ins, init: BinaryFresh { binary: b, inputs: 0 }, f: fn(acc, i) {
        binary_freshness_step(acc: acc, input: i)
      })
  }
}

// Only `BinaryFresh` admits the invocation; both other arms terminate `InvocationRefused` (exit
// 2, no observation) with their line, never a warning printed beside a reading.
fn binary_freshness_rendered(f: BinaryFreshness) -> String {
  match f {
    BinaryFresh { binary: b, inputs: _ } => concat("gunbc test: binary fresh against its dep-info: ", b)
    BinaryStale { binary: b, input: p, why: w } =>
      concat(concat(concat(concat(concat(concat(
        "gunbc test: REFUSED cause=StaleBinary — ", b), ": input "), p), " "), w), "; rebuild before measuring")
    BinaryFreshnessUndecided { binary: b, reason: r } =>
      concat(concat(concat("gunbc test: REFUSED cause=BinaryFreshnessUndecided — ", b), ": "), r)
  }
}
