module gunbc.durable_handoff_rest

import std.types { String, NonEmptyStr, Int }
import std.error_primitives { Result, Ok, Err }
import product.fabric.identity { FabricIdentity, DemandKey }
import extdeps.http.server { ServeWireResponse, KnownMethod, UnknownMethod, parse_http_method_label }
import extdeps.ietf.http_semantics { GET, PUT }
import extdeps.uri_path {
  parse_path_template, ParsedPathTemplate, MalformedPathTemplate,
  match_path_template, PathMatched, PathNotMatched, path_param_value,
}
import extdeps.languages.json.emit { JsonValue, JsonNull, json_object, json_kv, json_string, serialize_json }
import gunbc.durable_handoff_host {
  HostAcceptedRequest, HostRequestAccepted, HostRequestRejected, UserBusy, HostRequestAcceptanceUnknown,
  HostRequestPresent, HostRequestNotObserved, HostRequestObservationUnknown,
  HostRequestResultPending, HostRequestResultReady, HostRequestResultUnknown,
  host_request_submit, host_request_observe, host_request_result,
}

// HTTP is a projection of shared acceptance/readback, not a second queue.
// The enclosing service authenticates the principal and supplies its payload
// admission/codec. This handler neither accepts arbitrary commands nor launches
// workers. Results are published by the admitted consumer, not by a REST caller.
// Only PUT and GET exist; GET cannot enqueue, retry or cancel anything.
// The response a request can receive, as one closed outcome. Status and standing label are
// projected from it in exactly one place (host_request_outcome_response); no caller chooses
// them independently.
type HostRequestOutcome
  = AcceptedDurably
  | ResultPending
  | ResultRecorded
  | RequestNotObserved
  | OutcomeUnknown { detail: String }
  | OutcomeBadRequest { detail: String }
  | OutcomeUnauthenticated { detail: String }
  | OutcomeForbidden { detail: String }
  | OutcomeNotFound { detail: String }
  | OutcomeMethodNotAllowed
  | OutcomeUserBusy { existing: String }
  | OutcomeConflict { detail: String }

fn host_request_outcome_status(outcome: HostRequestOutcome) -> Int {
  match outcome {
    AcceptedDurably => 202
    ResultPending => 200
    ResultRecorded => 200
    RequestNotObserved => 404
    OutcomeUnknown { detail: _ } => 503
    OutcomeBadRequest { detail: _ } => 400
    OutcomeUnauthenticated { detail: _ } => 401
    OutcomeForbidden { detail: _ } => 403
    OutcomeNotFound { detail: _ } => 404
    OutcomeMethodNotAllowed => 405
    OutcomeUserBusy { existing: _ } => 409
    OutcomeConflict { detail: _ } => 409
  }
}

fn host_request_outcome_standing(outcome: HostRequestOutcome) -> String {
  match outcome {
    AcceptedDurably => "accepted"
    ResultPending => "accepted"
    ResultRecorded => "cleanup-pending"
    RequestNotObserved => "unknown"
    OutcomeUnknown { detail: _ } => "unknown"
    OutcomeBadRequest { detail: _ } => "rejected"
    OutcomeUnauthenticated { detail: _ } => "rejected"
    OutcomeForbidden { detail: _ } => "rejected"
    OutcomeNotFound { detail: _ } => "rejected"
    OutcomeMethodNotAllowed => "rejected"
    OutcomeUserBusy { existing: _ } => "UserBusy"
    OutcomeConflict { detail: _ } => "rejected"
  }
}

fn host_request_outcome_detail(outcome: HostRequestOutcome) -> String {
  match outcome {
    AcceptedDurably => "durable acceptance confirmed; not an execution verdict"
    ResultPending => "no terminal result published"
    ResultRecorded => "result recorded; stopped-and-cleaned settlement not yet confirmed"
    RequestNotObserved => "request not observed"
    OutcomeUnknown { detail: d } => d
    OutcomeBadRequest { detail: d } => d
    OutcomeUnauthenticated { detail: d } => d
    OutcomeForbidden { detail: d } => d
    OutcomeNotFound { detail: d } => d
    OutcomeMethodNotAllowed => "only PUT and GET are admitted"
    OutcomeUserBusy { existing: e } => e
    OutcomeConflict { detail: d } => d
  }
}

fn host_request_outcome_response(request_id: String, outcome: HostRequestOutcome, result: JsonValue) -> ServeWireResponse {
  ServeWireResponse {
    status: host_request_outcome_status(outcome: outcome), content_type_label: "application/json; charset=utf-8", headers: [],
    body: serialize_json(v: json_object(members: [
      json_kv(key: "request_id", value: json_string(s: request_id)),
      json_kv(key: "status", value: json_string(s: host_request_outcome_standing(outcome: outcome))),
      json_kv(key: "detail", value: json_string(s: host_request_outcome_detail(outcome: outcome))),
      json_kv(key: "result", value: result),
    ])),
  }
}

fn host_request_status_response(request: HostAcceptedRequest) -> ServeWireResponse {
  let id = request.identity.key as String
  match host_request_result(request: request) {
    HostRequestResultPending => host_request_outcome_response(request_id: id, outcome: ResultPending, result: JsonNull)
    HostRequestResultReady { result: r } => host_request_outcome_response(request_id: id, outcome: ResultRecorded, result: r)
    HostRequestResultUnknown { detail: d } => host_request_outcome_response(request_id: id, outcome: OutcomeUnknown { detail: d }, result: JsonNull)
  }
}

fn host_request_get(root: NonEmptyStr, identity: FabricIdentity, id: String) -> ServeWireResponse {
  match host_request_observe(root: root, identity: identity) {
    HostRequestPresent { request: r } => host_request_status_response(request: r)
    // Absence is not an authoritative rejection of an earlier submission.
    HostRequestNotObserved => host_request_outcome_response(request_id: id, outcome: RequestNotObserved, result: JsonNull)
    HostRequestObservationUnknown { detail: d } => host_request_outcome_response(request_id: id, outcome: OutcomeUnknown { detail: d }, result: JsonNull)
  }
}

fn host_request_put(
  root: NonEmptyStr, identity: FabricIdentity, id: String, body: String, admit_payload: fn(String) -> Result<NonEmptyStr, String>,
) -> ServeWireResponse {
  match admit_payload(body) {
    Err { value: reason } => host_request_outcome_response(request_id: id, outcome: OutcomeBadRequest { detail: reason }, result: JsonNull)
    Ok { value: payload } => match host_request_submit(root: root, identity: identity, payload: payload) {
      HostRequestAccepted { request: _ } => host_request_outcome_response(request_id: id, outcome: AcceptedDurably, result: JsonNull)
      UserBusy { existing_request: existing } => host_request_outcome_response(request_id: id, outcome: OutcomeUserBusy { existing: existing as String }, result: JsonNull)
      HostRequestRejected { reason: r } => host_request_outcome_response(request_id: id, outcome: OutcomeConflict { detail: r }, result: JsonNull)
      HostRequestAcceptanceUnknown { detail: d } => host_request_outcome_response(request_id: id, outcome: OutcomeUnknown { detail: d }, result: JsonNull)
    }
  }
}

// The wire label is parsed once into the modeled HttpMethod (case-sensitive, RFC 9110): a
// lowercase "get" is UnknownMethod and is refused, never normalized.
fn host_request_rest_at(
  root: NonEmptyStr, principal: NonEmptyStr, request_id: NonEmptyStr,
  method: String, body: String, admit_payload: fn(String) -> Result<NonEmptyStr, String>,
) -> ServeWireResponse {
  let identity = FabricIdentity { principal: principal, key: request_id as DemandKey }
  let id = request_id as String
  match parse_http_method_label(label: method) {
    KnownMethod { method: m } => match m {
      GET => host_request_get(root: root, identity: identity, id: id)
      PUT => host_request_put(root: root, identity: identity, id: id, body: body, admit_payload: admit_payload)
      _ => host_request_outcome_response(request_id: id, outcome: OutcomeMethodNotAllowed, result: JsonNull)
    }
    UnknownMethod { label: _ } => host_request_outcome_response(request_id: id, outcome: OutcomeMethodNotAllowed, result: JsonNull)
  }
}

fn host_request_rest(
  root: NonEmptyStr, principal: NonEmptyStr, method: String, path: String, body: String,
  admit_payload: fn(String) -> Result<NonEmptyStr, String>,
) -> ServeWireResponse {
  match parse_path_template(raw: "/requests/\{id\}") {
    MalformedPathTemplate { raw: _, segment: _, reason: _ } => host_request_outcome_response(request_id: "", outcome: OutcomeUnknown { detail: "request route is malformed" }, result: JsonNull)
    ParsedPathTemplate { template: t } => match match_path_template(template: t, path: path) {
      PathNotMatched => host_request_outcome_response(request_id: "", outcome: OutcomeNotFound { detail: "request route not found" }, result: JsonNull)
      PathMatched { params: ps } => {
        let id = path_param_value(params: ps, name: "id")
        if id == "" { host_request_outcome_response(request_id: "", outcome: OutcomeBadRequest { detail: "request id is empty" }, result: JsonNull) }
        else { host_request_rest_at(root: root, principal: principal, request_id: id as NonEmptyStr, method: method, body: body, admit_payload: admit_payload) }
      }
    }
  }
}
