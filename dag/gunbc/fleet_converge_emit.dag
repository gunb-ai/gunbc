module gunbc.fleet_converge_emit


import std.types { String, List, Int, Bool }
import product.placement_supply { HostIdentity }
import std.layout {
  Doc, DocConcat, DocEmpty,
  LayoutProtocol,
  doc_concat, doc_line_of,
  render
}
import std.disposition { Disposition, RealizationDispatch, Scaffold, Terminal }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.fleet_converge_apply {
  converge_apply,
  converge_apply_fleet,
  FleetConvergeApplyResult,
  fleet_converge_apply_result_converged,
  fleet_converge_thin_invocation,
}
import gunbc.host_effect { LocalShell, HostEffectTransport }
import gunbc.host_converge {
  ConvergePolicy,
  ConvergePolicyDerived,
  ConvergePolicyUnsound,
  HostConverge,
  FreshStandup,
  ExistingHostQuiescentReload,
  gunbc_apply_mode_for_host,
  gunbc_host_ctrl_checkout_path,
  gunbc_dag_root_submodule_path,
  gunbc_host_gunbc_root_path,
  gunbc_root_env_key,
  gunbc_ctrl_read_pin_script,
  gunbc_fleet_pinned_binary_name,
  fleet_converge_policy,
}
import v2.std.orchestration {
  Pipeline,
  PipelineStep,
  Do,
  If,
  Run,
  Let,
  ExprLit,
  FailFast,
  ExitZero,
  RedirectSpec,
  CaptureSpec,
  DiscardAll,
  IgnoreFail,
}
import v2.std.collection { Absent, Present }
import v2.std.diagnostic { Accepted, Rejected, None }
import v2.compiler.emit_orchestration { orch_emit_pipeline }
import v2.extdeps.languages.bash_orchestration_emit { bash_orchestration_emit_medium }
import extdeps.git { git_fetch_prune_shell }



data fleet_converge_protocol: LayoutProtocol = LayoutProtocol { indent_unit: "" }

fn sh_arg(s: String) -> String {
  concat(concat("\"", s), "\"")
}

data fresh_standup_bootstrap_emit_refused_poison: String = "__GUNBC_ORCH_EMIT_REFUSED__ fresh-standup bootstrap intent emission was rejected by v2.compiler.emit_orchestration; this marker is not valid fleet-converge shell, so the committed .github/fleet-converge.sh drift gate goes red rather than a hand-spelled fallback masking the refusal (DESIGN §5: refuse, never widen)\n"

fn fresh_standup_checkout_path() -> String {
  concat(concat(gunbc_host_ctrl_checkout_path, "/"), gunbc_dag_root_submodule_path)
}

fn fresh_standup_binary_path() -> String {
  concat(concat(gunbc_host_gunbc_root_path, "/"), gunbc_fleet_pinned_binary_name)
}

fn fresh_standup_built_binary_path() -> String {
  concat(concat(fresh_standup_checkout_path(), "/target/release/"), gunbc_fleet_pinned_binary_name)
}

fn fresh_standup_ignore_fail_run(command: String) -> PipelineStep {
  Do {
    run: Run {
      command: command,
      env: [],
      redirect: Absent,
      capture: Present { value: IgnoreFail }
    }
  }
}

fn fresh_standup_discard_fail_run(command: String) -> PipelineStep {
  Do {
    run: Run {
      command: command,
      env: [],
      redirect: Present { value: DiscardAll },
      capture: Present { value: IgnoreFail }
    }
  }
}

fn fresh_standup_sh_quote(path: String) -> String {
  concat("\"", concat(path, "\""))
}

fn fresh_standup_bootstrap_intent() -> Pipeline {
  Pipeline {
    steps: [
      Do {
        run: Run {
          command: concat("checkout=\"", fresh_standup_checkout_path(), "\""),
          env: [],
          redirect: Absent,
          capture: Absent
        }
      },
      Do {
        run: Run {
          command: concat(
            concat(
              concat("ctrl_pin=\"$(bash \"", gunbc_host_ctrl_checkout_path),
              concat("/", gunbc_ctrl_read_pin_script)
            ),
            concat("\" ", concat(fresh_standup_sh_quote(path: gunbc_host_ctrl_checkout_path), " 2>/dev/null || true)\""))
          ),
          env: [],
          redirect: Absent,
          capture: Absent
        }
      },
      fresh_standup_discard_fail_run(
        command: concat("(cd \"$checkout\" && ", concat(git_fetch_prune_shell(remote: "origin"), ")"))
      ),
      fresh_standup_discard_fail_run(
        command: "(cd \"$checkout\" && git checkout --detach \"$ctrl_pin\")"
      ),
      Do {
        run: Run {
          command: concat("mkdir -p ", fresh_standup_sh_quote(path: gunbc_host_gunbc_root_path)),
          env: [],
          redirect: Absent,
          capture: Absent
        }
      },
      fresh_standup_discard_fail_run(
        command: concat(
          "(cd \"$checkout\" && cargo build -p v1-compiler --release --bin ",
          concat(gunbc_fleet_pinned_binary_name, ")")
        )
      ),
      fresh_standup_discard_fail_run(
        command: concat(
          concat("cp ", fresh_standup_sh_quote(path: fresh_standup_built_binary_path())),
          concat(" ", fresh_standup_sh_quote(path: fresh_standup_binary_path()))
        )
      ),
      If {
        cond: ExitZero {
          run: Run {
            command: concat("[ -x ", fresh_standup_sh_quote(path: fresh_standup_binary_path()), " ]"),
            env: [],
            redirect: Absent,
            capture: Absent
          }
        },
        then_: Pipeline {
          steps: [
            Do {
              run: Run {
                command: concat(
                  concat("export ", gunbc_root_env_key),
                  concat("=", gunbc_host_gunbc_root_path)
                ),
                env: [],
                redirect: Absent,
                capture: Absent
              }
            },
          ],
          on_failure: FailFast
        },
        else_: Absent
      },
    ],
    on_failure: FailFast
  }
}

fn fresh_standup_bootstrap_emit_pipeline(p: Pipeline) -> String {
  match orch_emit_pipeline(p: p, medium: bash_orchestration_emit_medium()) {
    Accepted { value: source, diagnostics: d } =>
      match d {
        None => source.carried
        Some { diagnostics: _ } => fresh_standup_bootstrap_emit_refused_poison
      }
    Rejected { diagnostics: _ } => fresh_standup_bootstrap_emit_refused_poison
  }
}

fn fresh_standup_bootstrap_script() -> String {
  fresh_standup_bootstrap_emit_pipeline(p: fresh_standup_bootstrap_intent())
}

fn fresh_standup_bootstrap_arm_golden() -> String {
  concat(
    "# fresh-standup bootstrap (srv3 exemplar) — ONE orchestration intent tree.\n",
    fresh_standup_bootstrap_script()
  )
}

fn thin_invocation_shell_line(host: HostIdentity) -> String {
  let inv = fleet_converge_thin_invocation(host: host)
  concat("gunbc converge --host ", sh_arg(s: inv.argv.last()))
}

fn thin_invocation_failure_line(host: HostIdentity) -> String {
  concat(thin_invocation_shell_line(host: host), " || host_failed=1")
}

fn host_thin_run_lines(h: HostConverge) -> List<String> {
  match gunbc_apply_mode_for_host(host: h.identity) {
    FreshStandup =>
      concat(
        [
          "# fresh-standup bootstrap (srv3 exemplar) — ONE orchestration intent tree.",
          fresh_standup_bootstrap_script(),
        ],
        items: [thin_invocation_failure_line(host: h.identity)]
      )
    ExistingHostQuiescentReload => [thin_invocation_failure_line(host: h.identity)]
  }
}

fn flatten_host_lines(hosts: List<HostConverge>) -> List<String> {
  fold(
    hosts,
    init: [],
    f: fn(acc, h) { concat(acc, host_thin_run_lines(h: h)) }
  )
}

fn fleet_converge_thin_header() -> Doc {
  doc_concat(parts: map([
    "#!/usr/bin/env bash",
    "set -euo pipefail",
    "# GENERATED by dag/gunbc/fleet_converge_emit.dag (gunbc.fleet_converge_emit). DO NOT HAND-EDIT.",
    "# Thin-run: steady-state converge via gunbc converge --host (ConvergePlan in-process, EmitArtifactThenThinRun slice 2).",
    "# Bootstrap: fresh-standup hosts only — category B pre-runtime (git-checkout / cargo-build / cp).",
    "",
    "host_failed=0",
    ""
  ], line => doc_line_of(text: line)))
}

fn converge_unsound_doc(reason: String) -> Doc {
  doc_concat(parts: map([
    "#!/usr/bin/env bash",
    "set -euo pipefail",
    "# GENERATED by dag/gunbc/fleet_converge_emit.dag (gunbc.fleet_converge_emit). DO NOT HAND-EDIT.",
    concat("echo \"fleet-converge UNSOUND: ", concat(reason, "\" >&2")),
    "exit 1"
  ], line => doc_line_of(text: line)))
}

fn project_fleet_converge_to_doc(policy: ConvergePolicy) -> Doc {
  match policy {
    ConvergePolicyUnsound { reason: reason } => converge_unsound_doc(reason: reason)
    ConvergePolicyDerived { hosts: hosts } =>
      doc_concat(parts: append(
        [fleet_converge_thin_header()],
        items: append(
          map(flatten_host_lines(hosts: hosts), line => doc_line_of(text: line)),
          items: [doc_line_of(text: "exit \"$host_failed\"")]
        )
      ))
  }
}

fn fleet_converge_sh_for(policy: ConvergePolicy) -> String {
  render(doc: project_fleet_converge_to_doc(policy: policy), proto: fleet_converge_protocol)
}

fn expected_fleet_converge_sh() -> String {
  fleet_converge_sh_for(policy: fleet_converge_policy())
}

fn fleet_converge_drifted(committed: String) -> Bool {
  !(committed == expected_fleet_converge_sh())
}

fn fleet_converge_via_apply(policy: ConvergePolicy) -> FleetConvergeApplyResult {
  converge_apply(policy: policy, transport: LocalShell)
}

fn fleet_converge_fleet_via_apply() -> FleetConvergeApplyResult {
  fleet_converge_via_apply(policy: fleet_converge_policy())
}

fn fleet_converge_fleet_apply_converged() -> Bool {
  fleet_converge_apply_result_converged(r: fleet_converge_fleet_via_apply())
}

data fleet_converge_steady_state_doc_projection_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.fleet_converge_apply",
    decl_name: "fleet_converge_thin_invocation",
    field: WholeDeclaration,
  }
}

data fleet_converge_fresh_standup_bootstrap_emit_dissolution_trigger: Disposition = Terminal {
  reason: "fresh-standup bootstrap routes through orch_emit_pipeline(intent,Bash) on fresh_standup_bootstrap_intent; witness_fresh_standup_bootstrap_committed_byte_oracle_holds in fleet_converge_emit_test.dag byte-oracles the arm+thin-run seam vs .github/fleet-converge.sh (shell→dag P2 consumer slice, #6573/#6585)"
}
