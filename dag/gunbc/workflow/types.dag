module gunbc.workflow.types


type ArtifactKind = DesignDoc | Review | Plan | CiReport
type AuthorSource = Llm | Human

type ReviewDimension = Coherence | Quality | Requirements | Aspirational

type ReviewConcern {
  dimension: ReviewDimension
  system_prompt_preamble: String
}

type DimensionReviewOutput {
  dimension: ReviewDimension
  output: Json
  errors: Json
}

type MergedReviewOutput {
  output: Json
  summary: String
}

type IssueLifecycleStage
  = Idea
  | Design
  | DesignReview
  | Accepted
  | Implementing
  | CodeReview
  | Testing
  | Done
  | TerminalFailed

type TrackedIssue {
  id: String
  title: String
  body: String
  stage: IssueLifecycleStage
  url: std.types.NonEmptyStr?
  author: String?
  labels: List<String>
  created_at: std.types.Timestamp?
  updated_at: std.types.Timestamp?
}

type DesignOutput {
  content: String
  summary: String
  source: AuthorSource
  sections: DesignSections?
}

type DesignSections {
  problem: String?
  approach: String?
  interfaces: String?
  risks: List<String>?
  test_plan: String?
  scope: std.types.FermiDepth?
}

type DesignReviewOutput {
  findings: List<DesignFinding>
  approved: Bool
  summary: String
}

type DesignFinding {
  check_id: String
  issue_key: String
  observation: String
  severity: gunbc.review_verdict.FindingSeverity
  suggestion: String?
}

type ImplementationPlan {
  tasks: List<ImplementationTask>
  estimated_scope: std.types.FermiDepth
  summary: String
}

type ImplementationTask {
  title: String
  description: String
  file_paths: List<std.types.FilePath>?
  dependencies: List<String>?
  done: Bool = false
}

type PipelineRun {
  issue_id: String
  stages_completed: List<IssueLifecycleStage>
  current_stage: IssueLifecycleStage
  started_at: std.types.Timestamp
  updated_at: std.types.Timestamp
  artifacts: List<PipelineArtifact>
}

type PipelineArtifact {
  stage: IssueLifecycleStage
  kind: ArtifactKind
  content: String
  url: std.types.NonEmptyStr?
}

type IssueState = Open | Closed

type BindingStatus
  = Active
  | Conflicted
  | Terminated

type IntentSheet {
  intent_id: std.types.NonEmptyStr
  intent_version: Int
  title: std.types.NonEmptyStr
  body: String
  labels: List<String>
  owner: std.types.NonEmptyStr
  repo: std.types.NonEmptyStr
  created_at: std.types.Timestamp
  metadata: Json?
}

type IssueBinding {
  intent_id: std.types.NonEmptyStr
  issue_id: std.types.NonEmptyStr
  provider: std.types.NonEmptyStr
  created_at: std.types.Timestamp
  binding_status: BindingStatus
}

type StageRunKey {
  issue_id: std.types.NonEmptyStr
  stage: IssueLifecycleStage
  input_hash: std.content_hash.ContentHash
  policy_version: std.types.NonEmptyStr
}

type ClaimLease {
  issue_id: std.types.NonEmptyStr
  stage: IssueLifecycleStage
  owner: std.types.NonEmptyStr
  generation: Int
  acquired_at: std.types.Timestamp
  expires_at: std.types.Timestamp
  lease_ttl_ms: std.types.Milliseconds
}

type OutcomeStatus
  = Success
  | Failed
  | PendingApproval
  | Skipped
  | OutcomeTerminalFailed

type StageOutcome {
  run_key: std.types.NonEmptyStr
  stage: IssueLifecycleStage
  status: OutcomeStatus
  payload: Json?
  error: String?
  attempt_count: Int
  retry_budget_remaining: Int
  next_attempt_at: std.types.Timestamp?
  created_at: std.types.Timestamp
  updated_at: std.types.Timestamp
}

type ArtifactType
  = DesignArtifact
  | DesignReviewArtifact
  | ImplementationPlanArtifact
  | CodeDiffArtifact
  | CodeReviewArtifact
  | TestReportArtifact
  | StageSummaryArtifact

type ArtifactPayload
  = Inline { body: String }
  | BlobRef { uri: extdeps.uri.Uri, size_bytes: Int }

type RunArtifact {
  artifact_id: std.types.NonEmptyStr
  run_key: std.types.NonEmptyStr
  artifact_type: ArtifactType
  payload: ArtifactPayload
  content_hash: std.content_hash.ContentHash
  created_at: std.types.Timestamp
}

type MarkerKind
  = Provisional
  | Canonical

type ArtifactMarker {
  run_key: std.types.NonEmptyStr
  artifact_type: ArtifactType
  marker_kind: MarkerKind
  content_hash: std.content_hash.ContentHash
  lease_generation: Int?
  created_at: std.types.Timestamp
}

type SignalType
  = IntentSubmitted { intent_id: std.types.NonEmptyStr, intent_version: Int }
  | WorkReady { issue_id: std.types.NonEmptyStr, stage: IssueLifecycleStage, stage_epoch: Int }
  | ApprovalGranted { issue_id: std.types.NonEmptyStr, stage: IssueLifecycleStage, approval_epoch: Int }
  | RetryDue { issue_id: std.types.NonEmptyStr, stage: IssueLifecycleStage, run_key: std.types.NonEmptyStr, next_attempt_at: std.types.Timestamp }
  | LeaseExpired { issue_id: std.types.NonEmptyStr, stage: IssueLifecycleStage, lease_generation: Int }
  | ReconcileTick { window_id: std.types.NonEmptyStr }
  | InfraIntentChanged { intent_fingerprint: std.types.NonEmptyStr }
  | TerminalStateReached { issue_id: std.types.NonEmptyStr, stage: IssueLifecycleStage, run_key: std.types.NonEmptyStr }

type Signal {
  signal_type: SignalType
  idempotency_key: std.types.NonEmptyStr
  payload: Json
  produced_at: std.types.Timestamp
  consumed_at: std.types.Timestamp?
}

type RuntimeProfile
  = LocalCoLocated
  | StatelessFleet

type LaunchConfig {
  worker_count: Int
  drain_flag_path: String?
  drain_flag_url: std.types.NonEmptyStr?
}

type InfraIntent {
  schema_version: std.types.NonEmptyStr
  runtime_profile: RuntimeProfile
  launch: LaunchConfig
  infra_fingerprint: std.types.NonEmptyStr
}

type FailureClass
  = Retryable {
      reason: String
      next_attempt_at: std.types.Timestamp
    }
  | NonRetryable { reason: String }
  | Transient { reason: String }

type AgentStatus
  = Pending
  | Running
  | Completed
  | AgentFailed
  | Cancelled
  | TimedOut

type ApprovalMode
  = FullAuto
  | SuggestOnly
  | HumanInLoop

type CredentialIntent
  = GitHubApi
  | AgentExecution
  | LlmApi
  | CloudStorage
  | SecretManagerAccess

type CredentialResolution
  = EnvVar { name: std.types.NonEmptyStr }
  | SecretManagerRef { secret_id: std.types.NonEmptyStr, project_id: extdeps.cloud.gcp.gcp.GcpProjectId }
  | WorkloadIdentity { service_account: extdeps.cloud.gcp.gcp.ServiceAccountEmail?, scopes: std.types.List<String> }

type CredentialBinding {
  intent: CredentialIntent
  resolution: CredentialResolution
}

type ExecutionMetrics {
  run_key: std.types.NonEmptyStr
  stage: IssueLifecycleStage
  duration_ms: std.types.Milliseconds
  approval_latency_ms: std.types.Milliseconds?
  retry_attempts: Int
  llm_cost_units: Float?
  transport_calls: Int
  artifacts_stored: Int
}

type AuditAction
  = Created
  | Updated
  | Deleted
  | TransitionedTo { from_state: String, to_state: String }

type AuditEntry {
  timestamp: std.types.Timestamp
  actor: std.types.NonEmptyStr
  action: AuditAction
  entity_type: std.types.NonEmptyStr
  entity_id: std.types.NonEmptyStr
  before: Json?
  after: Json?
}
