module gunbc.compile_pool_observe

import std.types { String, NonEmptyStr, Bool }
import std.measure { ByteSize }
import std.disposition { Disposition, SingleAuthority }
import std.algebra { trim }
import extdeps.systemd {
  SystemdUnitProperty,
  MemoryMax,
  MemoryHigh,
  MemoryCurrent,
  SystemdCgroupMemoryLimit,
  MemoryLimitBytes,
  MemoryLimitUnbounded,
  MemoryLimitAbsent,
  parse_systemd_memory_limit_show,
  systemd_unit_load_state_not_found_wire,
}
import gunbc.host_effect { HostEffectTransport }
import gunbc.systemctl_show_read {
  SystemdPropertyCapture,
  SystemdPropertyCaptured,
  SystemdPropertyCaptureRefused,
  systemctl_show_property_read,
  systemctl_show_load_state_read,
}
import gunbc.build_cache_instance {
  CgroupMemoryLimits,
  EndpointObservationUnavailableReason,
  ReachRefused,
}
import gunbc.host_compile_pool {
  CompilePoolObservation,
  CompilePoolSliceObserved,
  CompilePoolSliceAbsent,
  CompilePoolObservationUnavailable,
}

data compile_pool_observe_scope_disposition: Disposition = SingleAuthority

// THE MISSING PRODUCER. gunbc.host_compile_pool declares CompilePoolObservation and gunbc.compile_pool_ensure
// consumes it, and until this module existed every value of that type in the tree was hand-authored inside a
// test -- so the admission that decides whether a host may have its compile-pool slice written was proven over
// fixtures and computed over nothing. That is the same shape gunbc.build_cache_endpoint_observe closed for the
// endpoint observation, and this is the slice half of it.
//
// WHAT IT READS AND IN WHICH ORDER. LoadState first, because it is the only reading that separates an absent
// slice from a present one (extdeps.systemd.systemctl ShowLoadState carries the citation: `systemctl show`
// answers `infinity` for MemoryMax on a unit the manager never heard of, identically to a loaded unit with no
// ceiling). Only under a loaded unit are the three cgroup magnitudes read. A slice that is loaded but reports
// no numeric ceiling is NOT folded into absent and NOT folded into a zero: `infinity` and an unparseable value
// are both refusals carrying what was read, because a pool with no ceiling is precisely the unbounded charge
// the managed slice exists to replace and reporting it as a size would fabricate the thing being checked.
//
// WHAT IT DOES NOT DO: it decides nothing. Whether the observed slice is large enough, correctly named, or
// permitted to be written is gunbc.compile_pool_ensure's and gunbc.host_compile_pool's judgement over this
// value; this module only reports what the host said.

fn compile_pool_reach_refusal(slice_unit: NonEmptyStr, what: String, why: String) -> CompilePoolObservation {
  CompilePoolObservationUnavailable {
    reason: ReachRefused {
      detail: join(
        ["compile-pool slice ", slice_unit as String, ": ", what, " -- ", why],
        "",
      ) as NonEmptyStr,
    },
  }
}

fn compile_pool_limit_bytes(lim: SystemdCgroupMemoryLimit) -> ByteSize? {
  match lim {
    MemoryLimitBytes { bytes: b } => Present { value: b }
    MemoryLimitUnbounded => none
    MemoryLimitAbsent => none
  }
}

fn compile_pool_limit_label(lim: SystemdCgroupMemoryLimit) -> String {
  match lim {
    MemoryLimitBytes { bytes: _ } => "a byte count"
    MemoryLimitUnbounded => "infinity (no ceiling -- an unbounded slice is the charge the managed pool replaces, not a size)"
    MemoryLimitAbsent => "empty or unparseable"
  }
}

// MemoryCurrent IS READ EVEN THOUGH NO JUDGEMENT USES IT, AND AN UNREADABLE ONE REFUSES. CgroupMemoryLimits
// carries three magnitudes and the two judgements over this observation read only two -- the ensure admission
// compares memory.max and memory.high against the derived size, the readiness check compares memory.max. The
// third is required to CONSTRUCT the record, so this module cannot report an observation without it, and it
// does not invent one: a zero would be a fabricated live charge that reads as an idle pool, which is exactly
// the state an operator would act on. So a slice that is loaded but never started -- systemd answers
// `[not set]` for MemoryCurrent until the cgroup exists -- is reported unavailable with that reading quoted,
// and the next pass observes it after the start. RUNG: mitigatable, and the deficit is a carrier shape rather
// than a read -- a limit PAIR and a live magnitude fused into one record. NEXT-RUNG TRIGGER: CgroupMemoryLimits
// split so observed ceilings can be reported without a current charge, at which point this arm is
// unrepresentable rather than refused.
type CompilePoolLimitRead
  = CompilePoolLimitBytes { bytes: ByteSize }
  | CompilePoolLimitRefused { observation: CompilePoolObservation }

fn compile_pool_limit_of_capture(
  slice_unit: NonEmptyStr,
  property_name: String,
  capture: SystemdPropertyCapture,
) -> CompilePoolLimitRead {
  match capture {
    SystemdPropertyCaptureRefused { reason: why } =>
      CompilePoolLimitRefused {
        observation: compile_pool_reach_refusal(
          slice_unit: slice_unit,
          what: join(["could not read ", property_name], ""),
          why: why,
        ),
      }
    SystemdPropertyCaptured { value: raw } => {
      let lim = parse_systemd_memory_limit_show(raw: trim(raw))
      match compile_pool_limit_bytes(lim: lim) {
        Present { value: b } => CompilePoolLimitBytes { bytes: b }
        Absent =>
          CompilePoolLimitRefused {
            observation: compile_pool_reach_refusal(
              slice_unit: slice_unit,
              what: join([property_name, " is not a ceiling"], ""),
              why: compile_pool_limit_label(lim: lim),
            ),
          }
      }
    }
  }
}

fn compile_pool_slice_limits_from_reads(
  slice_unit: NonEmptyStr,
  max_read: SystemdPropertyCapture,
  high_read: SystemdPropertyCapture,
  current_read: SystemdPropertyCapture,
) -> CompilePoolObservation {
  match compile_pool_limit_of_capture(slice_unit: slice_unit, property_name: "MemoryMax", capture: max_read) {
    CompilePoolLimitRefused { observation: o } => o
    CompilePoolLimitBytes { bytes: max } =>
      match compile_pool_limit_of_capture(slice_unit: slice_unit, property_name: "MemoryHigh", capture: high_read) {
        CompilePoolLimitRefused { observation: o } => o
        CompilePoolLimitBytes { bytes: high } =>
          match compile_pool_limit_of_capture(slice_unit: slice_unit, property_name: "MemoryCurrent", capture: current_read) {
            CompilePoolLimitRefused { observation: o } => o
            CompilePoolLimitBytes { bytes: current } =>
              CompilePoolSliceObserved {
                slice_unit: slice_unit,
                limits: CgroupMemoryLimits {
                  memory_max: max,
                  memory_high: high,
                  memory_current: current,
                },
              }
          }
      }
  }
}

fn observe_compile_pool_slice(
  transport: HostEffectTransport,
  slice_unit: NonEmptyStr,
) -> CompilePoolObservation {
  match systemctl_show_load_state_read(transport: transport, unit: slice_unit) {
    SystemdPropertyCaptureRefused { reason: why } =>
      compile_pool_reach_refusal(slice_unit: slice_unit, what: "could not read LoadState", why: why)
    SystemdPropertyCaptured { value: raw } =>
      if trim(raw) == (systemd_unit_load_state_not_found_wire as String) {
        CompilePoolSliceAbsent { slice_unit: slice_unit }
      } else {
        compile_pool_slice_limits_from_reads(
          slice_unit: slice_unit,
          max_read: systemctl_show_property_read(transport: transport, unit: slice_unit, property: MemoryMax),
          high_read: systemctl_show_property_read(transport: transport, unit: slice_unit, property: MemoryHigh),
          current_read: systemctl_show_property_read(transport: transport, unit: slice_unit, property: MemoryCurrent),
        )
      }
  }
}
