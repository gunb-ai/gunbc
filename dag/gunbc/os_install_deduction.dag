module gunbc.os_install_deduction


type TargetDiskState
  = EmptyDisk
  | ForeignOsPresent
  | UnknownDiskState

type OsInstallPreflightVerdict
  = CompleteForUnattended
  | NotUnattendedByPolicy
  | RequiresStoragePolicy
  | RequiresDiskObservation
  | IncompleteSeedDelivery
  | AutoinstallIncompleteNotBootable

type OsInstallPreflightPlan
  = PreflightNoop
  | RemasterWithStoragePolicy
  | RefuseUntilStoragePolicyDeclared
  | RefuseNeedsDiskObservation
  | RefuseIncompleteSeedDelivery
  | RefuseNotUnattendedByPolicy

type OsInstallRuntimeDiagnosticVerdict
  = RuntimeReadyToBoot
  | KvmFirmwareIdleObserved
  | RuntimeBootOverrideConsumedNoInstallEvidence
  | InstallerAwaitingStorage
  | InstallerRunning
  | RuntimeInstallerHung
  | KvmSuggestsOsBooted
  | RuntimeOsInstalled

type KvmObservedScreen
  = FirmwareSetup
  | UefiBootMenu
  | GrubMenu
  | SubiquityStorageScreen
  | SubiquityInstalling
  | LoginPrompt
  | ErrorScreen { summary: std.types.NonEmptyStr }

type KvmOperatorAttestation {
  target: product.placement_supply.HostIdentity
  observed_screen: KvmObservedScreen
  observed_at: std.types.Timestamp
  attested_by: std.types.NonEmptyStr
}

fn fold_nbd_proxy_os_install_preflight_verdict(
  payload: extdeps.os.ubuntu_autoinstall.UbuntuAutoinstallPayload,
  disk: TargetDiskState,
) -> OsInstallPreflightVerdict {
  if !payload.fully_automated {
    NotUnattendedByPolicy
  } else {
    match payload.delivery {
      NoCloudNet { seed_url: _ } => IncompleteSeedDelivery
      NoCloudLocal =>
        match payload.storage_policy {
          StoragePolicyDirectLayout => CompleteForUnattended
          StoragePolicyAbsent =>
            match disk {
              EmptyDisk => RequiresStoragePolicy
              ForeignOsPresent => AutoinstallIncompleteNotBootable
              UnknownDiskState => RequiresDiskObservation
            }
        }
    }
  }
}

fn plan_for_os_install_preflight_verdict(
  verdict: OsInstallPreflightVerdict,
) -> OsInstallPreflightPlan {
  match verdict {
    CompleteForUnattended => PreflightNoop
    NotUnattendedByPolicy => RefuseNotUnattendedByPolicy
    RequiresStoragePolicy => RemasterWithStoragePolicy
    RequiresDiskObservation => RefuseNeedsDiskObservation
    IncompleteSeedDelivery => RefuseIncompleteSeedDelivery
    AutoinstallIncompleteNotBootable => RefuseUntilStoragePolicyDeclared
  }
}

fn runtime_verdict_from_kvm_attestation(
  attestation: KvmOperatorAttestation,
  preflight: OsInstallPreflightVerdict,
) -> OsInstallRuntimeDiagnosticVerdict {
  match attestation.observed_screen {
    SubiquityStorageScreen =>
      match preflight {
        AutoinstallIncompleteNotBootable => InstallerAwaitingStorage
        RequiresStoragePolicy => InstallerAwaitingStorage
        _ => InstallerRunning
      }
    SubiquityInstalling => InstallerRunning
    LoginPrompt => KvmSuggestsOsBooted
    FirmwareSetup => KvmFirmwareIdleObserved
    UefiBootMenu => KvmFirmwareIdleObserved
    GrubMenu => InstallerRunning
    ErrorScreen { summary: _ } => RuntimeInstallerHung
  }
}
