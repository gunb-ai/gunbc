module gunbc.heal_push_plan


fn artifact_repository_path(a: gunbc.generated_artifact.GeneratedArtifact) -> extdeps.github.effect.RepositoryPath {
  extdeps.github.effect.RepositoryPath { value: artifact_path(a: a) }
}

fn artifact_push_authorized(
  a: gunbc.generated_artifact.GeneratedArtifact,
  authority: gunbc.auth.github_credential.GitHubCredentialAuthority,
  control_plane: gunbc.auth.github_apps.GitHubAppControlPlaneState
) -> Bool {
  credential_authorizes_required(
    authority: authority,
    control_plane: control_plane,
    required: advance_branch_required_permissions(paths: [artifact_repository_path(a: a)])
  )
}

type HealPushRefusalCause
  = ActionsJobCredentialScopeUnavailable
  | ActionsJobCredentialScopeNotGranted
  | ActionsJobCredentialForkPolicyUnobserved
  | ActionsJobCredentialAxisNotModeled
  | ActionsJobCredentialDeclaredAccessInvalid
  | PushBindingMissingOnCheckoutStep
  | PushBindingLeaseUnresolved
  | PushBindingStepKindNotSupported
  | PushBindingActionNotCheckout
  | PushBindingInputObservationDuplicated
  | PushBindingInputValueUnsupported
  | ManagedInstallationGrantUnobserved
  | ManagedCredentialSubjectMismatch

type HealPushBindingSite {
  checkout_step: std.decl_ref.DeclarationRef
  input: std.types.NonEmptyStr?
  observed_kind: extdeps.languages.yaml.types.YamlValueKind?
}

type HealPushFailure {
  cause: HealPushRefusalCause
  missing: extdeps.github.app.GitHubPermissionAxis?
  site: HealPushBindingSite?
}

type HealPushRefusal {
  paths: List<extdeps.github.effect.RepositoryPath>
  failures: List<HealPushFailure>
}

fn heal_push_refusal_cause_token(cause: HealPushRefusalCause) -> String {
  match cause {
    ActionsJobCredentialScopeUnavailable => "ActionsJobCredentialScopeUnavailable"
    ActionsJobCredentialScopeNotGranted => "ActionsJobCredentialScopeNotGranted"
    ActionsJobCredentialForkPolicyUnobserved => "ActionsJobCredentialForkPolicyUnobserved"
    ActionsJobCredentialAxisNotModeled => "ActionsJobCredentialAxisNotModeled"
    ActionsJobCredentialDeclaredAccessInvalid => "ActionsJobCredentialDeclaredAccessInvalid"
    PushBindingMissingOnCheckoutStep => "PushBindingMissingOnCheckoutStep"
    PushBindingLeaseUnresolved => "PushBindingLeaseUnresolved"
    PushBindingStepKindNotSupported => "PushBindingStepKindNotSupported"
    PushBindingActionNotCheckout => "PushBindingActionNotCheckout"
    PushBindingInputObservationDuplicated => "PushBindingInputObservationDuplicated"
    PushBindingInputValueUnsupported => "PushBindingInputValueUnsupported"
    ManagedInstallationGrantUnobserved => "ManagedInstallationGrantUnobserved"
    ManagedCredentialSubjectMismatch => "ManagedCredentialSubjectMismatch"
  }
}

type HealPushPlan
  = HealPushNothingToDo
  | HealPushReady { artifacts: List<gunbc.generated_artifact.GeneratedArtifact> }
  | HealPushPartial {
      ready: List<gunbc.generated_artifact.GeneratedArtifact>
      refused: List<gunbc.generated_artifact.GeneratedArtifact>
      cause: HealPushRefusal
    }
  | HealPushRefused {
      refused: List<gunbc.generated_artifact.GeneratedArtifact>
      cause: HealPushRefusal
    }
  | HealPushPlanInconsistent { refused_paths: List<extdeps.github.effect.RepositoryPath> }

type RefusalDerivation
  = RefusalDerived { refusal: HealPushRefusal }
  | RefusalDerivationInconsistent { refused_paths: List<extdeps.github.effect.RepositoryPath> }

fn capability_failure(c: gunbc.auth.github_credential.CredentialCapability) -> HealPushFailure? {
  match c {
    CredentialGrants => none
    CredentialKindCannotSatisfy { missing } =>
      Present { value: HealPushFailure { cause: ActionsJobCredentialScopeUnavailable, missing: Present { value: missing }, site: none } }
    CredentialScopeNotGranted { missing } =>
      Present { value: HealPushFailure { cause: ActionsJobCredentialScopeNotGranted, missing: Present { value: missing }, site: none } }
    CredentialForkPolicyUnobserved { missing } =>
      Present { value: HealPushFailure { cause: ActionsJobCredentialForkPolicyUnobserved, missing: Present { value: missing }, site: none } }
    CredentialAxisNotModeled { missing } =>
      Present { value: HealPushFailure { cause: ActionsJobCredentialAxisNotModeled, missing: Present { value: missing }, site: none } }
    CredentialDeclaredAccessInvalid { missing } =>
      Present { value: HealPushFailure { cause: ActionsJobCredentialDeclaredAccessInvalid, missing: Present { value: missing }, site: none } }
    CredentialSubjectMismatch { missing } =>
      Present { value: HealPushFailure { cause: ManagedCredentialSubjectMismatch, missing: Present { value: missing }, site: none } }
    CredentialGrantNotObserved { missing } =>
      Present { value: HealPushFailure { cause: ManagedInstallationGrantUnobserved, missing: Present { value: missing }, site: none } }
  }
}

data no_heal_push_failures: List<HealPushFailure> = []

fn refusal_failure_population(
  paths: List<extdeps.github.effect.RepositoryPath>,
  authority: gunbc.auth.github_credential.GitHubCredentialAuthority,
  control_plane: gunbc.auth.github_apps.GitHubAppControlPlaneState
) -> List<HealPushFailure> {
  v2.std.algebra.fold_list(
    xs: unsatisfied_capabilities_for_required(
      authority: authority,
      control_plane: control_plane,
      required: advance_branch_required_permissions(paths: paths)
    ),
    empty: no_heal_push_failures,
    cons: fn(acc, c) {
      match capability_failure(c: c) {
        Absent => acc
        Present { value: f } => concat(acc, [f])
      }
    }
  )
}

fn derive_refusal(
  refused: List<gunbc.generated_artifact.GeneratedArtifact>,
  authority: gunbc.auth.github_credential.GitHubCredentialAuthority,
  control_plane: gunbc.auth.github_apps.GitHubAppControlPlaneState
) -> RefusalDerivation {
  let paths = map(refused, a => artifact_repository_path(a: a))
  let failures = refusal_failure_population(
    paths: paths,
    authority: authority,
    control_plane: control_plane
  )
  if count(failures) == 0 {
    RefusalDerivationInconsistent { refused_paths: paths }
  } else {
    RefusalDerived { refusal: HealPushRefusal { paths: paths, failures: failures } }
  }
}

fn plan_heal_push(
  artifacts: List<gunbc.generated_artifact.GeneratedArtifact>,
  authority: gunbc.auth.github_credential.GitHubCredentialAuthority,
  control_plane: gunbc.auth.github_apps.GitHubAppControlPlaneState
) -> HealPushPlan {
  let ready = filter(artifacts, a => artifact_push_authorized(a: a, authority: authority, control_plane: control_plane))
  let refused = filter(artifacts, a => !artifact_push_authorized(a: a, authority: authority, control_plane: control_plane))
  if count(artifacts) == 0 {
    HealPushNothingToDo
  } else if count(refused) == 0 {
    HealPushReady { artifacts: ready }
  } else {
    match derive_refusal(refused: refused, authority: authority, control_plane: control_plane) {
      RefusalDerivationInconsistent { refused_paths } =>
        HealPushPlanInconsistent { refused_paths: refused_paths }
      RefusalDerived { refusal } =>
        if count(ready) == 0 {
          HealPushRefused { refused: refused, cause: refusal }
        } else {
          HealPushPartial { ready: ready, refused: refused, cause: refusal }
        }
    }
  }
}

fn plan_heal_push_from_binding(
  artifacts: List<gunbc.generated_artifact.GeneratedArtifact>,
  resolution: gunbc.auth.github_credential.PushBindingResolution,
  control_plane: gunbc.auth.github_apps.GitHubAppControlPlaneState
) -> HealPushPlan {
  match resolution {
    PushBindingResolved { binding: _, authority } =>
      plan_heal_push(artifacts: artifacts, authority: authority, control_plane: control_plane)
    PushCredentialBindingMissing { checkout_step } =>
      binding_refused_plan(
        artifacts: artifacts,
        cause: PushBindingMissingOnCheckoutStep,
        site: step_site(checkout_step: checkout_step)
      )
    PushCredentialLeaseUnresolved { checkout_step } =>
      binding_refused_plan(
        artifacts: artifacts,
        cause: PushBindingLeaseUnresolved,
        site: step_site(checkout_step: checkout_step)
      )
    PushBindingStepKindUnsupported { checkout_step } =>
      binding_refused_plan(
        artifacts: artifacts,
        cause: PushBindingStepKindNotSupported,
        site: step_site(checkout_step: checkout_step)
      )
    PushBindingActionMismatch { checkout_step } =>
      binding_refused_plan(
        artifacts: artifacts,
        cause: PushBindingActionNotCheckout,
        site: step_site(checkout_step: checkout_step)
      )
    PushBindingInputDuplicated { checkout_step, input } =>
      binding_refused_plan(
        artifacts: artifacts,
        cause: PushBindingInputObservationDuplicated,
        site: HealPushBindingSite {
          checkout_step: checkout_step,
          input: Present { value: input },
          observed_kind: none
        }
      )
    PushBindingInputUnsupported { checkout_step, input, observed_kind } =>
      binding_refused_plan(
        artifacts: artifacts,
        cause: PushBindingInputValueUnsupported,
        site: HealPushBindingSite {
          checkout_step: checkout_step,
          input: Present { value: input },
          observed_kind: Present { value: observed_kind }
        }
      )
  }
}

fn step_site(checkout_step: std.decl_ref.DeclarationRef) -> HealPushBindingSite {
  HealPushBindingSite { checkout_step: checkout_step, input: none, observed_kind: none }
}

fn binding_refused_plan(
  artifacts: List<gunbc.generated_artifact.GeneratedArtifact>,
  cause: HealPushRefusalCause,
  site: HealPushBindingSite
) -> HealPushPlan {
  if count(artifacts) == 0 {
    HealPushNothingToDo
  } else {
    HealPushRefused {
      refused: artifacts,
      cause: HealPushRefusal {
        paths: map(artifacts, a => artifact_repository_path(a: a)),
        failures: [HealPushFailure { cause: cause, missing: none, site: Present { value: site } }]
      }
    }
  }
}

data live_heal_push_plan: HealPushPlan = plan_heal_push_from_binding(
  artifacts: committed_generated_artifacts(),
  resolution: live_heal_push_binding_resolution,
  control_plane: live_heal_control_plane
)

fn plan_ready_artifacts(plan: HealPushPlan) -> List<gunbc.generated_artifact.GeneratedArtifact> {
  match plan {
    HealPushNothingToDo => []
    HealPushReady { artifacts } => artifacts
    HealPushPartial { ready, refused: _, cause: _ } => ready
    HealPushRefused { refused: _, cause: _ } => []
    HealPushPlanInconsistent { refused_paths: _ } => []
  }
}

fn plan_refused_artifacts(plan: HealPushPlan) -> List<gunbc.generated_artifact.GeneratedArtifact> {
  match plan {
    HealPushNothingToDo => []
    HealPushReady { artifacts: _ } => []
    HealPushPartial { ready: _, refused, cause: _ } => refused
    HealPushRefused { refused, cause: _ } => refused
    HealPushPlanInconsistent { refused_paths: _ } => []
  }
}

type RemedyOwner
  = RemedyAuthor
  | RemedyMachine
  | RemedyProviderObservation

fn refusal_cause_remedy_owner(cause: HealPushRefusalCause) -> RemedyOwner {
  match cause {
    ActionsJobCredentialScopeUnavailable => RemedyAuthor
    ActionsJobCredentialScopeNotGranted => RemedyMachine
    ActionsJobCredentialAxisNotModeled => RemedyMachine
    ActionsJobCredentialDeclaredAccessInvalid => RemedyMachine
    ActionsJobCredentialForkPolicyUnobserved => RemedyProviderObservation
    ManagedInstallationGrantUnobserved => RemedyProviderObservation
    ManagedCredentialSubjectMismatch => RemedyMachine
    PushBindingMissingOnCheckoutStep => RemedyMachine
    PushBindingLeaseUnresolved => RemedyMachine
    PushBindingStepKindNotSupported => RemedyMachine
    PushBindingActionNotCheckout => RemedyMachine
    PushBindingInputObservationDuplicated => RemedyMachine
    PushBindingInputValueUnsupported => RemedyMachine
  }
}

fn failure_is_machine_owned(f: HealPushFailure) -> Bool {
  match refusal_cause_remedy_owner(cause: f.cause) {
    RemedyMachine => true
    RemedyAuthor => false
    RemedyProviderObservation => false
  }
}

fn failure_is_provider_owned(f: HealPushFailure) -> Bool {
  match refusal_cause_remedy_owner(cause: f.cause) {
    RemedyProviderObservation => true
    RemedyMachine => false
    RemedyAuthor => false
  }
}

fn failure_causes(fs: List<HealPushFailure>) -> List<HealPushRefusalCause> {
  map(fs, f => f.cause)
}

fn failure_is_actions_workflow_scope_residual(f: HealPushFailure) -> Bool {
  match f.cause {
    ActionsJobCredentialScopeUnavailable => match f.missing {
      Absent => false
      Present { value: axis } => permission_name_eq(a: axis, b: workflows_permission_name)
    }
    ActionsJobCredentialScopeNotGranted => false
    ActionsJobCredentialAxisNotModeled => false
    ActionsJobCredentialDeclaredAccessInvalid => false
    ActionsJobCredentialForkPolicyUnobserved => false
    ManagedInstallationGrantUnobserved => false
    ManagedCredentialSubjectMismatch => false
    PushBindingMissingOnCheckoutStep => false
    PushBindingLeaseUnresolved => false
    PushBindingStepKindNotSupported => false
    PushBindingActionNotCheckout => false
    PushBindingInputObservationDuplicated => false
    PushBindingInputValueUnsupported => false
  }
}

fn author_residual_exact(refusal: HealPushRefusal) -> Bool {
  count(refusal.failures) > 0
    && count(refusal.paths) > 0
    && v2.std.algebra.fold_list(
         xs: refusal.failures,
         empty: true,
         cons: fn(acc, f) { acc && failure_is_actions_workflow_scope_residual(f: f) }
       )
    && v2.std.algebra.fold_list(
         xs: refusal.paths,
         empty: true,
         cons: fn(acc, p) { acc && is_workflow_projection_path(path: p) }
       )
}

type HealPushRemediation
  = HealAutomatically { paths: List<extdeps.github.effect.RepositoryPath> }
  | AuthorCommitRequired { paths: List<extdeps.github.effect.RepositoryPath>, causes: List<HealPushRefusalCause> }
  | MachineRepairRequired { causes: List<HealPushRefusalCause> }
  | ProviderObservationRequired { causes: List<HealPushRefusalCause> }
  | HealNothingToRemediate
  | HealPlanInconsistent { refused_paths: List<extdeps.github.effect.RepositoryPath> }

fn remediation_for_refusal(refusal: HealPushRefusal) -> HealPushRemediation {
  let machine = filter(refusal.failures, f => failure_is_machine_owned(f: f))
  let provider = filter(refusal.failures, f => failure_is_provider_owned(f: f))
  if count(machine) > 0 {
    MachineRepairRequired { causes: failure_causes(fs: machine) }
  } else if count(provider) > 0 {
    ProviderObservationRequired { causes: failure_causes(fs: provider) }
  } else if author_residual_exact(refusal: refusal) {
    AuthorCommitRequired {
      paths: refusal.paths,
      causes: failure_causes(fs: refusal.failures)
    }
  } else {
    HealPlanInconsistent { refused_paths: refusal.paths }
  }
}

fn plan_remediation(plan: HealPushPlan) -> HealPushRemediation {
  match plan {
    HealPushNothingToDo => HealNothingToRemediate
    HealPushReady { artifacts } =>
      HealAutomatically { paths: map(artifacts, a => artifact_repository_path(a: a)) }
    HealPushPartial { ready: _, refused: _, cause } => remediation_for_refusal(refusal: cause)
    HealPushRefused { refused: _, cause } => remediation_for_refusal(refusal: cause)
    HealPushPlanInconsistent { refused_paths } => HealPlanInconsistent { refused_paths: refused_paths }
  }
}

data live_heal_remediation: HealPushRemediation = plan_remediation(plan: live_heal_push_plan)

fn remediation_author_commit_paths(r: HealPushRemediation) -> List<extdeps.github.effect.RepositoryPath> {
  match r {
    AuthorCommitRequired { paths, causes: _ } => paths
    HealAutomatically { paths: _ } => []
    MachineRepairRequired { causes: _ } => []
    ProviderObservationRequired { causes: _ } => []
    HealNothingToRemediate => []
    HealPlanInconsistent { refused_paths: _ } => []
  }
}

fn auto_push_eligible_committed_artifacts() -> List<gunbc.generated_artifact.GeneratedArtifact> {
  plan_ready_artifacts(plan: live_heal_push_plan)
}

fn author_commit_required_committed_artifacts() -> List<gunbc.generated_artifact.GeneratedArtifact> {
  let author_paths = remediation_author_commit_paths(r: live_heal_remediation)
  filter(
    plan_refused_artifacts(plan: live_heal_push_plan),
    a => any(author_paths, p => p.value == artifact_path(a: a))
  )
}

fn auto_push_eligible_committed_artifact_paths() -> List<String> {
  map(auto_push_eligible_committed_artifacts(), a => artifact_path(a: a))
}

fn author_commit_required_committed_artifact_paths() -> List<String> {
  map(author_commit_required_committed_artifacts(), a => artifact_path(a: a))
}

fn path_requires_author_commit(path: String) -> Bool {
  any(author_commit_required_committed_artifact_paths(), p => p == path)
}

type HealRepairDisposition
  = HealRepairNoDrift
  | HealRepairAutoPushEligibleOnly { paths: List<String> }
  | HealRepairAuthorCommitRequired { paths: List<String> }
  | HealRepairMixed {
      auto_push_paths: List<String>,
      author_commit_paths: List<String>
    }

fn classify_heal_repair_paths(changed_paths: List<String>) -> HealRepairDisposition {
  let author = filter(changed_paths, p => path_requires_author_commit(path: p))
  let auto_push = filter(changed_paths, p => !path_requires_author_commit(path: p))
  if count(changed_paths) == 0 {
    HealRepairNoDrift
  } else if count(author) == 0 {
    HealRepairAutoPushEligibleOnly { paths: auto_push }
  } else if count(auto_push) == 0 {
    HealRepairAuthorCommitRequired { paths: author }
  } else {
    HealRepairMixed { auto_push_paths: auto_push, author_commit_paths: author }
  }
}

fn refusal_causes_token(causes: List<HealPushRefusalCause>) -> String {
  v2.std.algebra.fold_list(
    xs: causes,
    empty: "HealPushRefusalPopulationEmpty",
    cons: fn(acc, c) {
      if acc == "HealPushRefusalPopulationEmpty" {
        heal_push_refusal_cause_token(cause: c)
      } else {
        concat(acc, concat("+", heal_push_refusal_cause_token(cause: c)))
      }
    }
  )
}

fn live_heal_push_refusal_cause_token() -> String {
  match live_heal_push_plan {
    HealPushPartial { ready: _, refused: _, cause } => refusal_causes_token(causes: failure_causes(fs: cause.failures))
    HealPushRefused { refused: _, cause } => refusal_causes_token(causes: failure_causes(fs: cause.failures))
    HealPushReady { artifacts: _ } => "NoRefusal"
    HealPushNothingToDo => "NoRefusal"
    HealPushPlanInconsistent { refused_paths: _ } => "HealPushPlanInconsistent"
  }
}
