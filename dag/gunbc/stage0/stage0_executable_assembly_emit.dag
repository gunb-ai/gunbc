module gunbc.stage0_executable_assembly_emit

import v2.compiler.self_host.stage0_executable_assembly {
  stage0_host_shell_package_name,
  stage0_host_shell_partition_dependencies,
  stage0_next_pass_bin_name
}
import v2.std.algebra { fold_list, list_map, filter, any, length }
import v2.std.collection { List }
import v2.std.text { String }
import v2.workflow.rust_crate_partition { Stage0PartitionCrateRow, stage0_partition_crate_rows }

// THE BRIDGE, AND WHY THERE HAS TO BE ONE. v2.compiler.self_host.stage0_executable_assembly is
// the authority for which package assembles the next-pass executable and which partition packages
// it links. Its consumers -- the package graph the rebuild closure walks, and the lib.rs cut in
// v1.compiler.emit_rust -- are inside the seed's own compile closure, which is rooted at src/v1
// and dag, not src/v2. Importing the authority directly from there would drag the whole v2
// self-host closure into every emitted seed. So the authority is projected into one generated
// gunbc row module, exactly as v2.workflow.rust_crate_partition already is through
// gunbc.stage0_crate_partition_emit, and the projection is regenerated by the same wet actuator.

fn escape_dag_string_body(s: String) -> String {
  replace(replace(replace(s, "\\", "\\\\"), "\"", "\\\""), "\n", "\\n")
}

fn render_assembly_string_list(xs: List<String>) -> String {
  concat(
    "[",
    concat(
      fold_list(xs, empty: "", cons: fn(acc, item) {
        let line = concat("\"", concat(escape_dag_string_body(s: item), "\""))
        if acc == "" {
          line
        } else {
          concat(acc, concat(", ", line))
        }
      }),
      "]"
    )
  )
}

fn expected_stage0_executable_assembly_generated_dag() -> String {
  concat(
    "module gunbc.stage0_executable_assembly_generated\n\n",
    "import std.types { List, String }\n\n",
    "data generated_stage0_executable_assembly_note: String = \"Generated by gunbc stage0_executable_assembly_emit — do not hand-edit. Authority: v2.compiler.self_host.stage0_executable_assembly; regen via dag/gunbc/instruments/generated_artifact_gate.dag main_wet.\"\n\n",
    "data generated_host_shell_package_name: String = \"", escape_dag_string_body(s: stage0_host_shell_package_name), "\"\n\n",
    "data generated_next_pass_bin_name: String = \"", escape_dag_string_body(s: stage0_next_pass_bin_name), "\"\n\n",
    "data generated_host_shell_partition_dependencies: List<String> = ",
    render_assembly_string_list(xs: stage0_host_shell_partition_dependencies),
    "\n"
  )
}

// THE CRATES THE EXECUTABLE LINKS, PROJECTED FOR ITS BUILD SCRIPT. src/v1/stage0/build.rs binds the
// executable's build identity and must rerun -- and so observe a dirty tree -- when ANY source the
// executable links changes, not only this package's. Cargo reruns a build script only for the
// paths it names, so the script needs the linked crate set, and it must not infer that set from
// manifest text (gunbc#11693 review: a one-spelling scan treats every other spelling as absence,
// and workspace inheritance never spells the path at all). The set is derived here from the
// partition authority instead: the host shell's declared partition dependencies, closed over the
// modeled `reexport_packages` edges, projected to each row's `crate_dir`. One repo-relative
// directory per line; the header is the provenance line every generated artifact carries.
//
// A package the closure reaches without a rostered row is a REFUSAL, not an omission: the
// artifact is not rendered, the gate refuses, and the build script's own refusal on a missing
// file keeps the identity from being minted over a population nobody could complete.
type LinkedPartitionCratesRender
  = LinkedPartitionCratesRendered { content: String }
  | LinkedPartitionCratesRefused { reason: String }

fn linked_partition_closure_step(rows: List<Stage0PartitionCrateRow>, acc: List<String>) -> List<String> {
  fold_list(rows, empty: acc, cons: fn(reached, row) {
    if any(xs: reached, predicate: fn(p) { p == row.package_name }) {
      fold_list(row.reexport_packages, empty: reached, cons: fn(r, dep) {
        if any(xs: r, predicate: fn(p) { p == dep }) { r } else { concat(r, [dep]) }
      })
    } else {
      reached
    }
  })
}

// The closure is a fixed point reached in at most |rows| steps, because each step that changes
// the set adds at least one rostered package and there are only |rows| of them. The fold takes
// its two inputs -- the declared dependencies and the rostered rows -- as VALUES, so a claim can
// supply a roster with a transitive child, or a dependency no row names, without editing the
// authority; the live entry point below binds the real ones.
fn linked_partition_packages(deps: List<String>, rows: List<Stage0PartitionCrateRow>) -> List<String> {
  fold_list(rows, empty: deps, cons: fn(acc, _) {
    linked_partition_closure_step(rows: rows, acc: acc)
  })
}

fn linked_partition_crate_dirs(deps: List<String>, rows: List<Stage0PartitionCrateRow>) -> List<String> {
  let reached = linked_partition_packages(deps: deps, rows: rows)
  list_map(
    xs: filter(xs: rows, predicate: fn(row) { any(xs: reached, predicate: fn(p) { p == row.package_name }) }),
    f: fn(row) { row.crate_dir }
  )
}

fn unrostered_linked_packages(deps: List<String>, rows: List<Stage0PartitionCrateRow>) -> List<String> {
  filter(xs: linked_partition_packages(deps: deps, rows: rows), predicate: fn(p) { !any(xs: rows, predicate: fn(row) { row.package_name == p }) })
}

fn render_linked_partition_crates(deps: List<String>, rows: List<Stage0PartitionCrateRow>) -> LinkedPartitionCratesRender {
  let unrostered = unrostered_linked_packages(deps: deps, rows: rows)
  if length(xs: unrostered) > 0 {
    LinkedPartitionCratesRefused {
      reason: concat(
        "stage0 host shell links a partition package with no row in v2.workflow.rust_crate_partition: ",
        fold_list(unrostered, empty: "", cons: fn(acc, p) { if acc == "" { p } else { concat(acc, concat(", ", p)) } })
      ),
    }
  } else {
    LinkedPartitionCratesRendered {
      content: concat(
        "# Generated by gunbc stage0_executable_assembly_emit — do not hand-edit. Authority: v2.compiler.self_host.stage0_executable_assembly stage0_host_shell_partition_dependencies closed over v2.workflow.rust_crate_partition reexport_packages; regen via dag/gunbc/instruments/generated_artifact_gate.dag main_wet. Consumed by src/v1/stage0/build.rs: one repo-relative crate directory per line, each watched so the build identity reruns when any linked source changes.\n",
        fold_list(linked_partition_crate_dirs(deps: deps, rows: rows), empty: "", cons: fn(acc, dir) { concat(acc, concat(dir, "\n")) })
      ),
    }
  }
}

fn expected_stage0_linked_partition_crates_txt() -> LinkedPartitionCratesRender {
  render_linked_partition_crates(deps: stage0_host_shell_partition_dependencies, rows: stage0_partition_crate_rows())
}
