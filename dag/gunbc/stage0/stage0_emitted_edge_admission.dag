module gunbc.stage0.stage0_emitted_edge_admission

import std.types { Bool, Int, List, String }
import std.content_hash { ContentHash }
import v1.compiler.artifact { RenderTarget, RustModuleRenderSelection }
import v2.compiler.self_host.stage0_executable_assembly { Stage0ExecutableModuleOwner }
import gunbc.rust_emitted_edge {
  EmittedEdge,
  EmittedEdgeProvenance,
  EmittedModuleTarget,
  EmittedCrateRootTarget,
  RuntimePrelude,
  ReexportFacade,
  SemanticSourceReference,
  DeclaredImport,
  InlinePathReference,
  ServiceRuntimeSurface
}
import gunbc.stage0.stage0_crate_partition_generated { GeneratedPartitionCrateRow }
import gunbc.stage0.stage0_partition_package_graph {
  partition_package_dependency_names_over,
  stage0_partition_row_is_module_bearing_package
}

// DOES EVERY EDGE THE EMITTER WROTE RESOLVE IN THE CRATE ITS SOURCE MODULE LANDS IN. A `use
// crate::m::X;` line compiles in a partition crate only when m lives in that crate or in a package
// the crate re-exports (transitively, since each layered facade is `pub use <dep>::*;`). The
// emitter returns each such edge beside the text it wrote (gunbc.rust_emitted_edge); this admission
// maps both endpoints through the partition's owner rows and the package graph
// (gunbc.stage0.stage0_partition_package_graph), and refuses an edge whose target package the source
// package cannot reach -- the E0432 class, named before rustc is asked.
//
// THE POPULATION IS THE STAGE0 SEED, and it is stated rather than assumed. A module is owned by the
// module-bearing partition row that lists it, else by the host shell package when the host shell's
// module roster (the caller supplies it, read from the SAME CANDIDATE shell's lib.rs) lists it. A module in
// neither is NOT COVERED: this admission has no crate for it, so it answers with that typed arm,
// never with a pass. Emitting a closure that is not the seed therefore reaches the not-covered arm
// by name.

// THE PACKAGE GRAPH THE EMITTED TREE WILL BE BUILT UNDER, as that tree declares it: its partition rows
// (gunbc.stage0.stage0_crate_partition_generated) and the host shell node above them
// (gunbc.stage0.stage0_executable_assembly_generated). All three are supplied by the caller and every owner,
// dependency and reach lookup below reads them and nothing else, so no answer here re-enters the rows
// or shell edges compiled into the binary that asks.
type Stage0EmittedTreePackages {
  rows: List<GeneratedPartitionCrateRow>
  host_shell_package_name: String
  host_shell_dependencies: List<String>
}

// CANDIDATE ASSEMBLY CONTRACT -- MODEL REVIEW, NOT YET A HOST CUTOVER.
// Named later consumer: required_regen_host::compile_stage0_admitted. Its source adapter must
// read root/modules from the v1.compiler.compile::PipelineResult.files it is judging, and package facts from
// the SAME immutable source observation supplied to compilation. The prior live caller reads
// committed lib.rs before emission; that route remains unchanged until this contract is admitted
// and its producer/consumer change together. No runtime safety improvement is claimed here.
// The existing supplied-values edge function below remains the single owner/reach law; it is
// not a constructor of candidate provenance. This seal has no producer until the adapter lands.
//
// One source digest binds the full source observation (paths AND contents, including generated
// package/assembly projections); one candidate digest binds the whole result.files/edges pair.
// Both digests are computed over the actual canonical inputs, never caller labels. Unchanged
// inputs include declared retained sources AND generated files deliberately omitted by the
// render selection. Their ownership/unchanged standing comes from the candidate plan before
// reading, not from absence in result.files; observe once and check again at realization.
// They are not a fallback for a missing generated candidate file. Selection may omit rendering
// an unchanged mirror, but cannot shrink the candidate root's full declaration population.
// Minted BEFORE reading candidate/unchanged file bytes. Ownership comes from the existing
// stage0 assembly census over the selected source observation; generated unchanged standing
// additionally requires RenderSelectedMirrors exclusion under the admitted affected-set plan.
// Neither membership nor standing may be inferred from absence in result.files. A selected
// generated file missing from result.files refuses even if its old bytes exist on disk.
// CONTENT-PRODUCER FRONTIER (both branches are currently unavailable):
// Retained ownership is produced by stage0_executable_assembly's census/retention rows;
// emitted_closure_compile_host::closure_modules reads declarations, but does not return a
// sealed retained-byte observation. cli_run::regen_input_sources observes DAG sources, not
// these retained Rust files; authority_digest_from_sources cannot stand in for their content.
// The later ownership-aware traversal adapter must observe each already-owned retained path
// once, bind its actual bytes to this source observation, and derive expected_content there.
// Until that bounded producer exists, CandidateUnchangedEvidenceUnavailable refuses the path.
//
// For deliberately omitted generated files, required_regen_host::scope_selection and its
// RenderSelectedMirrors construction establish selection, NOT provenance of omitted bytes.
// PipelineResult.files supplies emitted bytes only. No inspected existing producer joins
// omitted-file origin/content with affected-plan exclusion into an unchanged-input seal.
// That join is a bounded missing producer at the same adapter: require the admitted exclusion
// and observed generated-file provenance/content from existing generation authority, or refuse.
// Reading whichever disk file exists and hashing it is not proof of unchanged standing.
// A caller-supplied expected_content cannot close either frontier. Do not weaken the seal to
// make scoped emission run before its evidence producer exists.
type Stage0UnchangedAssemblyInput {
  path: String
  owner: Stage0ExecutableModuleOwner
  expected_content: ContentHash
}

type Stage0CandidateReadPlan sole_constructor {
  source_authority: ContentHash
  target: RenderTarget
  render_selection: RustModuleRenderSelection
  unchanged_inputs: List<Stage0UnchangedAssemblyInput>
}

// FIXED DECLARED-SET POLICY, not active-cfg membership: the existing closure_modules calls
// declared_mod_decls(content, true). That includes cfg(test) and does not evaluate target/feature
// predicates; closure_modules_tests::a_cfg_test_mod_is_not_a_seed_module explicitly contrasts
// true (edge coverage) with binary_modules' false (seed membership). Preserve this policy for
// supported syntax. The traversal adapter must first classify attached attributes using an
// explicit supported-form policy: ordinary literal path, cfg under declared-set semantics,
// and known non-membership-changing lint/format/doc forms with validated shape. Unknown forms,
// malformed/duplicate path attributes, or transformations such as cfg_attr refuse by default;
// a cfg_attr-only denylist is insufficient. Extend the existing declaration reader, not a second
// roster. Pair each admitted form (including multiline lint and cfg(test)) with its refusal
// control; unsupported attributes must never become a path-less ordinary mod declaration.
// cfg_attr or other syntax whose module/path relation is not established is
// CandidateDeclarationUnsupported, never silently evaluated or ignored. This contract makes no
// active-target availability claim; Cargo compilation remains a separate obligation.
// RenderTarget must be Rust; its typed value and the exact existing render-selection carrier
// are bound in the read plan and included in candidate identity, not hidden behind a hash label.
type Stage0CandidateAssembly sole_constructor {
  read_plan: Stage0CandidateReadPlan
  candidate: ContentHash
  candidate_root_path: String
  host_shell_modules: List<String>
  packages: Stage0EmittedTreePackages
  emitted_edges: List<EmittedEdge>
}

// Failures to establish the assembly are distinct from a valid assembly whose edges are not
// covered or cross an inadmissible package boundary. There is no refusal arm that falls through
// to committed-root membership, the compiled partition, or a union of emitted edge endpoints.
type Stage0CandidateAssemblyRefusal
  = CandidateRenderTargetUnsupported { target: RenderTarget }
  | CandidateRootMissing { path: String }
  | CandidatePathDuplicated { path: String }
  | CandidateDeclarationUnreadable { path: String, detail: String }
  | CandidateDeclarationUnsupported { path: String, detail: String }
  | CandidateInputOwnershipUnresolved { path: String }
  | CandidateUnchangedInputChanged { path: String }
  | CandidateUnchangedEvidenceUnavailable { path: String, detail: String }
  | CandidateSourceAuthorityDisagrees { expected: ContentHash, observed: ContentHash }
  | CandidateEmissionIdentityDisagrees { expected: ContentHash, observed: ContentHash }
  | CandidateModuleOwnershipDisagrees { module_basename: String }
  | CandidatePackageGraphDisagrees { package_name: String }

type Stage0CandidateAssemblyAdmission
  = CandidateAssemblyAdmitted { assembly: Stage0CandidateAssembly }
  | CandidateAssemblyRefused { cause: Stage0CandidateAssemblyRefusal }

// After admission, the host must pass exactly this assembly's edges, shell modules and packages
// to stage0_emitted_edge_admission. No independent shell list may be added to that call.
// Adapter choice (no new compiler output interface): use result.files' unique candidate root,
// factor emitted_closure_compile_host::closure_modules over a supplied read resolver, preserve
// its nested mod/#[path] resolution and cfg inclusion policy. Each read has declared ownership:
// emitted candidate bytes, a predeclared unchanged candidate input, or typed refusal.
// A generated file missing from result.files is NOT an invitation to consult the committed root.
// Unsupported syntax must remain a refusal rather than be read as an empty declaration list.
// Partition-subtraction/retained-module meaning stays with stage0_executable_assembly and the
// existing emit_lib_rs_from_paths projection. The adapter compares their emitted package graph
// and candidate declaration result; disagreement refuses, it does not mint a second roster.
//
// Required production-path discriminator before host cutover: emit a new unpartitioned fixture
// absent from committed lib.rs, then derive membership from that exact candidate and admit its
// legal edge. Remove the candidate declaration while retaining the edge: NotCovered. A stale
// committed declaration cannot rescue it; lower-package -> host still refuses crossing. Missing
// root, stale package source, nested retained-path, cfg policy and scoped-render complete-root
// controls pair each refusal with its valid case. A supplied-model fixture alone is insufficient.
// This is independent of transient base-package bootstrap population: it governs the candidate
// after emission. End-to-end evidence must name the actually executing base-built seed; a host
// fix only in HEAD is not proof that the re-executed seed ran this adapter. No alternate seed or
// generated-byte hand-seed is admitted by this contract.

type Stage0EmittedModuleOwner
  = Stage0EmittedModuleOwned { package_name: String }
  | Stage0EmittedModuleNotCovered

type Stage0EmittedEdgeCrossing {
  from_module: String
  to_module: String
  from_package: String
  to_package: String
  provenance: EmittedEdgeProvenance
}

type Stage0EmittedEdgeUncovered {
  module: String
  edge_from: String
  provenance: EmittedEdgeProvenance
}

type Stage0EmittedEdgeAdmission
  = Stage0EmittedEdgesAdmitted { edge_count: Int }
  | Stage0EmittedEdgesNotCovered { uncovered: List<Stage0EmittedEdgeUncovered> }
  | Stage0EmittedEdgesRefused { crossings: List<Stage0EmittedEdgeCrossing> }

// THE ONE ROW-OWNER LOOKUP. v1.compiler.stage0_crates stage0_lookup_module_owner_package_name reads
// this too, so the crate a lib.rs includes a module into and the crate this admission places it in
// are one answer.
fn partition_module_owner_packages_over(module_basename: String, rows: List<GeneratedPartitionCrateRow>) -> List<String> {
  rows
    |> filter(row =>
      stage0_partition_row_is_module_bearing_package(row: row)
        && (row.modules |> any(m => m == module_basename))
    )
    |> map(row => row.package_name)
}

fn stage0_emitted_module_owner(module_basename: String, host_shell_modules: List<String>, packages: Stage0EmittedTreePackages) -> Stage0EmittedModuleOwner {
  match partition_module_owner_packages_over(module_basename: module_basename, rows: packages.rows) |> first {
    Present { value: package_name } => Stage0EmittedModuleOwned { package_name: package_name }
    Absent =>
      if host_shell_modules |> any(m => m == module_basename) {
        Stage0EmittedModuleOwned { package_name: packages.host_shell_package_name }
      } else {
        Stage0EmittedModuleNotCovered
      }
  }
}

fn stage0_package_direct_dependencies(package_name: String, packages: Stage0EmittedTreePackages) -> List<String> {
  if package_name == packages.host_shell_package_name {
    packages.host_shell_dependencies
  } else {
    packages.rows
      |> filter(row => row.package_name == package_name)
      |> flat_map(row => partition_package_dependency_names_over(row: row, rows: packages.rows))
  }
}

// Bounded by the package count: each round adds every direct dependency of what is already
// reached, and a chain over n partition packages plus the shell is complete after n rounds, so the
// rows themselves are the fuel.
fn stage0_package_reachable(package_name: String, packages: Stage0EmittedTreePackages) -> List<String> {
  packages.rows |> fold(init: [package_name], f: (reached, _row) =>
    reached
      |> concat(reached |> flat_map(p => stage0_package_direct_dependencies(package_name: p, packages: packages)))
      |> fold(init: [], f: (acc, p) => if acc |> any(a => a == p) { acc } else { acc |> concat([p]) })
  )
}

type Stage0PackageReach {
  package_name: String
  reachable: List<String>
}

// Computed once per admission, one row per package, so an edge asks a lookup rather than a closure.
fn stage0_package_reach_table(packages: Stage0EmittedTreePackages) -> List<Stage0PackageReach> {
  concat([packages.host_shell_package_name], packages.rows |> map(row => row.package_name))
    |> map(p => Stage0PackageReach { package_name: p, reachable: stage0_package_reachable(package_name: p, packages: packages) })
}

fn stage0_package_reaches(reach: List<Stage0PackageReach>, from_package: String, to_package: String) -> Bool {
  from_package == to_package
    || reach |> any(r => r.package_name == from_package && (r.reachable |> any(p => p == to_package)))
}

fn stage0_emitted_edge_target_basename(edge: EmittedEdge) -> List<String> {
  match edge.to {
    EmittedModuleTarget { module: target } => if target == edge.from { [] } else { [target] }
    EmittedCrateRootTarget => []
  }
}

fn stage0_emitted_edge_uncovered(edge: EmittedEdge, host_shell_modules: List<String>, packages: Stage0EmittedTreePackages) -> List<Stage0EmittedEdgeUncovered> {
  concat([edge.from], stage0_emitted_edge_target_basename(edge: edge)) |> flat_map(m =>
    match stage0_emitted_module_owner(module_basename: m, host_shell_modules: host_shell_modules, packages: packages) {
      Stage0EmittedModuleOwned { package_name: _ } => []
      Stage0EmittedModuleNotCovered => [Stage0EmittedEdgeUncovered { module: m, edge_from: edge.from, provenance: edge.provenance }]
    }
  )
}

fn stage0_emitted_edge_crossing(edge: EmittedEdge, host_shell_modules: List<String>, packages: Stage0EmittedTreePackages, reach: List<Stage0PackageReach>) -> List<Stage0EmittedEdgeCrossing> {
  stage0_emitted_edge_target_basename(edge: edge) |> flat_map(target =>
    match stage0_emitted_module_owner(module_basename: edge.from, host_shell_modules: host_shell_modules, packages: packages) {
      Stage0EmittedModuleNotCovered => []
      Stage0EmittedModuleOwned { package_name: from_package } =>
        match stage0_emitted_module_owner(module_basename: target, host_shell_modules: host_shell_modules, packages: packages) {
          Stage0EmittedModuleNotCovered => []
          Stage0EmittedModuleOwned { package_name: to_package } =>
            if stage0_package_reaches(reach: reach, from_package: from_package, to_package: to_package) {
              []
            } else {
              [Stage0EmittedEdgeCrossing {
                from_module: edge.from,
                to_module: target,
                from_package: from_package,
                to_package: to_package,
                provenance: edge.provenance
              }]
            }
        }
    }
  )
}

// THE PACKAGE GRAPH IS THE TREE BEING EMITTED'S, SUPPLIED BY THE CALLER -- never the rows or shell
// edges compiled into the binary asking. Required-regen emits the seed from the corpus in hand and admits
// that emission's edges; the only partition that emission will be built under is the one in the same
// corpus (gunbc.stage0.stage0_crate_partition_generated as that corpus declares it). Reading the committed
// rows instead admitted a candidate against its predecessor's partition: a module added to the
// partition in the same change had no row in the binary, so the regen refused NotCovered until a
// regen had already installed the row it was refusing to produce -- a bootstrap deadlock broken only
// by hand-seeding the generated mirror (#12171 -> #12185). Supplying the rows narrows nothing: every
// edge is still mapped through owner rows and the package graph, and a module no row and no shell
// lists still refuses by name.
fn stage0_emitted_edge_admission(edges: List<EmittedEdge>, host_shell_modules: List<String>, packages: Stage0EmittedTreePackages) -> Stage0EmittedEdgeAdmission {
  let uncovered = edges |> flat_map(edge => stage0_emitted_edge_uncovered(edge: edge, host_shell_modules: host_shell_modules, packages: packages))
  let reach = stage0_package_reach_table(packages: packages)
  let crossings = edges |> flat_map(edge => stage0_emitted_edge_crossing(edge: edge, host_shell_modules: host_shell_modules, packages: packages, reach: reach))
  if uncovered |> count > 0 {
    Stage0EmittedEdgesNotCovered { uncovered: uncovered }
  } else if crossings |> count > 0 {
    Stage0EmittedEdgesRefused { crossings: crossings }
  } else {
    Stage0EmittedEdgesAdmitted { edge_count: edges |> count }
  }
}

fn stage0_emitted_edge_provenance_name(provenance: EmittedEdgeProvenance) -> String {
  match provenance {
    RuntimePrelude => "runtime-prelude"
    ReexportFacade => "reexport-facade"
    SemanticSourceReference => "semantic-source-reference"
    DeclaredImport => "declared-import"
    InlinePathReference => "inline-path-reference"
    ServiceRuntimeSurface => "service-runtime-surface"
  }
}

fn stage0_emitted_edge_admission_refusal(outcome: Stage0EmittedEdgeAdmission) -> String? {
  match outcome {
    Stage0EmittedEdgesAdmitted { edge_count: _ } => none
    Stage0EmittedEdgesNotCovered { uncovered: uncovered } =>
      Present {
        value: concat(
          "Stage0EmittedEdgesNotCovered: ",
          to_string(value: uncovered |> count),
          " emitted edge endpoint(s) have no stage0 crate (neither a module-bearing partition row nor the host shell lists them):\n",
          uncovered
            |> map(u => concat("  ", u.module, " (edge from ", u.edge_from, ", ", stage0_emitted_edge_provenance_name(provenance: u.provenance), ")"))
            |> join(separator: "\n")
        )
      }
    Stage0EmittedEdgesRefused { crossings: crossings } =>
      Present {
        value: concat(
          "Stage0EmittedEdgeCrossesCrateBoundary: ",
          to_string(value: crossings |> count),
          " emitted edge(s) name a module in a package their source crate does not depend on (E0432 class):\n",
          crossings
            |> map(c => concat("  ", c.from_module, " [", c.from_package, "] -> ", c.to_module, " [", c.to_package, "] (", stage0_emitted_edge_provenance_name(provenance: c.provenance), ")"))
            |> join(separator: "\n")
        )
      }
  }
}
