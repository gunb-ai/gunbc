module gunbc.stage0.stage0_emitted_population_manifest

import std.algebra { list_map }
import std.types { List, String }

// THE NAME OF THE ARTIFACT IN WHICH THE EMITTER DECLARES THE POPULATION IT PRODUCED.
//
// This module exists to hold ONE string, and that is the point rather than an accident of
// factoring. The manifest has two ends -- `v1.compiler.emit_rust` writes it and
// `gunbc.stage0.stage0_rust_host_observation` reads it -- and if each spelled the basename itself,
// the artifact would have two names for one file, which is the nicknaming failure DESIGN 3
// names and the exact class the manifest exists to end. A shared leaf module is the smallest
// carrier that lets both ends resolve the same symbol without the reader importing the whole
// emitter's closure to get at one literal.
//
// ONLY THE BASENAME IS SHARED, DELIBERATELY. The two ends compose different roots because they
// address different spaces: the emitter writes target-relative (under `rust_source_root()`,
// i.e. `src/`), the observation addresses repository-relative (under `stage0_package_root`,
// i.e. `src/v1/stage0/`). Hoisting a single "path" here would force one of them to hold a path
// in a space it does not speak, so the shared fact is the part that is genuinely one fact.
data emitted_population_manifest_basename: String = "emitted_population.rs"

// The first line of the self-host step's verdict file, stated once beside the manifest it is read
// with: the Rust writer (cli_run native_lane_runner run_self_host_frontier) and the .dag reader
// (v2.compiler.self_host.seed_retention_frontier) both call these rather than each owning a copy.
data self_host_frontier_verdict_passed_word: String = "controls-passed"
data self_host_frontier_verdict_not_passed_word: String = "controls-not-passed"

// The manifest's line grammar, stated once for the same reason the basename is.
//
// The emitter renders one line per path as `line_prefix ++ path`, joined by the separator; the
// observation recovers the population by splitting on the separator and stripping the prefix.
// One grammar read in both directions (DESIGN 4) -- the structural inverse, not a second parser.
//
// WHY THE ARTIFACT IS A `.rs` OF COMMENT LINES, WHICH LOOKS ODD UNTIL YOU SEE WHAT IT BUYS.
// Two demands pull opposite ways. GATING wants the manifest inside the population
// `required_regen` already compares, and that population is `.rs`-shaped end to end: every
// compared member is rustfmt-normalized before its digest is taken, so a `.txt` member is
// REFUSED at normalization ("expected one of `!` or `::`, found `.`") -- measured, not
// predicted. READING wants recovery without parsing Rust, because a text-parse standing in for
// a modeled fact is exactly what this lane spent the day deleting (gunbc#8690, cssl_assemble's
// seed lib.rs oracle), and a generated `const &[&str]` would put one right back.
//
// A file of nothing but `//` lines satisfies both. It is valid Rust, so it enters the compared
// population by construction and normalizes to itself (a comments-only file is already a
// rustfmt fixed point, which is the property DESIGN's two-consumer rule demands). And it is
// read by splitting and stripping a literal prefix -- no Rust grammar is involved on the
// reading side at all. It is deliberately NOT a module: it is appended to the emitted file list
// AFTER `lib.rs` is rendered, so no `pub mod` line names it and nothing compiles it.
// DISSOLUTION: this shape is owed to the compared population being Rust-shaped end to end, not
// to anything about the fact itself. When that population becomes medium-agnostic -- when
// `required_regen`'s comparison normalizes an artifact by its declared medium rather than by
// assuming Rust -- the manifest becomes the line-delimited text it wants to be, this paragraph
// deletes, and the `.rs` extension goes with it. Until then the extension is load-bearing and
// "cleaning it up" into a `const &[&str]` would silently reintroduce a Rust parse on the read
// side, which is the class gunbc#8690 deleted.
data emitted_population_manifest_line_prefix: String = "// "

data emitted_population_manifest_line_separator: String = "\n"

// THE READ IS THE STRUCTURAL INVERSE OF THE WRITE, NOT A SECOND PARSER.
//
// `v1.compiler.emit_rust` `emit_emitted_population_manifest` renders one line per produced path
// as `line_prefix ++ path`, joined by the separator. This recovers them by splitting on that
// separator and stripping that prefix, reading BOTH literals from the same authority the writer
// reads (`gunbc.stage0.stage0_emitted_population_manifest`). No Rust grammar is involved: the artifact
// is a `.rs` so that it is covered by the regen comparison, but nothing here parses Rust, which
// is the whole reason it is comment lines rather than a `const &[&str]`.
//
// A line that does not carry the prefix is DROPPED rather than guessed at. The manifest is
// emitter-produced and every line carries it by construction, so a line that does not is
// evidence the artifact is not what this function was pointed at -- and the emptiness that
// results is caught by the caller, which refuses on an empty population rather than reporting
// "the emitter produced nothing".
//
// IT LIVES BESIDE THE GRAMMAR IT INVERTS, so every reader of the manifest -- the git-revision
// observation and the self-host frontier mode of the emitted driver -- calls one parser rather than
// each re-splitting on the separator.
fn emitted_population_paths_from_manifest(content: String) -> List<String> {
  let prefix_length = string_length(s: emitted_population_manifest_line_prefix)
  let lines = split(s: content, delimiter: emitted_population_manifest_line_separator)
  list_map(
    xs: filter(
      xs: lines,
      predicate: fn(line) {
        starts_with(s: line, prefix: emitted_population_manifest_line_prefix)
      }
    ),
    f: fn(line) { substring(s: line, start: prefix_length, end: string_length(s: line)) }
  )
}
