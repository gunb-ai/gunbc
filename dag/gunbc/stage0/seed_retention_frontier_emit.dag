module gunbc.seed_retention_frontier_emit

import extdeps.languages.rust.string_literal { escape_rust_cooked_string_literal_body }
import v2.compiler.self_host.seed_retention_frontier {
  seed_retention_frontier_crate_relative_paths,
  seed_retention_frontier_top_level_src_basenames
}
import v2.std.algebra { fold_list }
import v2.std.collection { List }
import v2.std.text { String }

// THE BRIDGE, AND WHY THERE HAS TO BE ONE. v2.compiler.self_host.seed_retention_frontier is
// the authority for which stage0 files are seed-retained. required_regen_host is inside the
// seed compile closure and cannot import that v2 module without dragging the self-host
// closure into every emit. So the paths are projected into a PathIncluded Rust const,
// the same route bootstrap_stage0_crate_layout_generated already uses.

fn render_rust_str_slice_items(xs: List<String>) -> String {
  fold_list(xs, empty: "", cons: fn(acc, item) {
    let line = concat("    \"", escape_rust_cooked_string_literal_body(s: item), "\"")
    if acc == "" {
      line
    } else {
      concat(acc, concat(",\n", line))
    }
  })
}

fn expected_seed_retention_frontier_generated_rs() -> String {
  concat(
    "// Generated by gunbc seed_retention_frontier_emit — do not hand-edit.\n",
    "// Authority: v2.compiler.self_host.seed_retention_frontier; regen via dag/gunbc/instruments/generated_artifact_gate.dag main_wet.\n\n",
    "/// Crate-relative retained paths. Nested members never enter required-regen's basename join.\n",
    "#[rustfmt::skip]\n",
    "pub const SEED_RETENTION_FRONTIER_CRATE_RELATIVE_PATHS: &[&str] = &[\n",
    render_rust_str_slice_items(xs: seed_retention_frontier_crate_relative_paths()),
    "\n];\n\n",
    "/// Direct `src/*.rs` children of the frontier. required_regen_host joins committed-not-emitted against this list.\n",
    "#[rustfmt::skip]\n",
    "pub const SEED_RETENTION_FRONTIER_TOP_LEVEL_SRC_BASENAMES: &[&str] = &[\n",
    render_rust_str_slice_items(xs: seed_retention_frontier_top_level_src_basenames()),
    "\n];\n"
  )
}
