module gunbc.spark_serving_converge_realize

import std.types { String, List, NonEmptyStr, Bool }
import gunbc.fleet_known_hosts_anchor { portable_remote_words, portable_remote_words_strings }
import gunbc.spark_serving_realization { ServingInstallEffect, EnableLingerForOwnAccount }
import gunbc.spark_serving_desired { spark_serving_automation_principal_login }

data spark_serving_converge_realize_authority_note: String = "Seam 2 realization for Spark serving frozen install_effects. Maps a frozen ServingInstallEffect to admitted portable remote argv — never through effect_actuation shell strings (that module is privilege-derivation only; serving_privilege_derivation_witness_test). Linger slice: [sudo, -n, loginctl, enable-linger, login] with no interpolation."

type SparkServingInstallRemoteArgvVerdict =
    SparkServingInstallRemoteArgvPresent { argv: List<String> }
  | SparkServingInstallRemoteArgvRefused { reason: String }

fn spark_serving_admit_portable_remote_argv(raws: List<String>) -> SparkServingInstallRemoteArgvVerdict {
  match portable_remote_words(raws: raws) {
    Present { value: words } =>
      SparkServingInstallRemoteArgvPresent {
        argv: portable_remote_words_strings(words: words),
      }
    Absent =>
      SparkServingInstallRemoteArgvRefused {
        reason: "spark_serving_converge_realize: remote argv is not portable — refuse rather than shell-interpolate",
      }
  }
}

fn spark_serving_enable_linger_remote_argv(login: NonEmptyStr) -> SparkServingInstallRemoteArgvVerdict {
  spark_serving_admit_portable_remote_argv(
    raws: ["sudo", "-n", "loginctl", "enable-linger", login as String],
  )
}

fn realize_spark_serving_install_effect_argv(
  effect: ServingInstallEffect,
  executor_login: NonEmptyStr,
) -> SparkServingInstallRemoteArgvVerdict {
  match effect {
    EnableLingerForOwnAccount =>
      spark_serving_enable_linger_remote_argv(login: executor_login)
    _ =>
      SparkServingInstallRemoteArgvRefused {
        reason: "spark_serving_converge_realize: only EnableLingerForOwnAccount is implemented in the linger vertical slice",
      }
  }
}

fn realize_spark_serving_install_effects_argv(
  effects: List<ServingInstallEffect>,
  executor_login: NonEmptyStr,
) -> SparkServingInstallRemoteArgvVerdict {
  fold(
    effects,
    init: SparkServingInstallRemoteArgvPresent { argv: [] },
    f: fn(acc, effect) {
      match acc {
        SparkServingInstallRemoteArgvRefused { reason: _ } => acc
        SparkServingInstallRemoteArgvPresent { argv: prior } =>
          match realize_spark_serving_install_effect_argv(
            effect: effect,
            executor_login: executor_login,
          ) {
            SparkServingInstallRemoteArgvRefused { reason: why } =>
              SparkServingInstallRemoteArgvRefused { reason: why }
            SparkServingInstallRemoteArgvPresent { argv: next } =>
              SparkServingInstallRemoteArgvPresent {
                argv: concat(prior, next),
              }
          }
      }
    },
  )
}

fn spark_serving_install_remote_argv_refused(v: SparkServingInstallRemoteArgvVerdict) -> Bool {
  match v {
    SparkServingInstallRemoteArgvRefused { reason: _ } => true
    SparkServingInstallRemoteArgvPresent { argv: _ } => false
  }
}

fn spark_serving_default_executor_login() -> NonEmptyStr {
  spark_serving_automation_principal_login()
}

fn spark_serving_enable_linger_argv_matches_expected(argv: List<String>) -> Bool {
  match spark_serving_enable_linger_remote_argv(
    login: spark_serving_default_executor_login(),
  ) {
    SparkServingInstallRemoteArgvPresent { argv: expected } =>
      join(argv, "\0") == join(expected, "\0")
    SparkServingInstallRemoteArgvRefused { reason: _ } => false
  }
}
