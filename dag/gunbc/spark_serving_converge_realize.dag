data spark_serving_converge_realize_authority_note: String = "Seam 2 realization for Spark serving frozen install_effects. Maps a frozen ServingInstallEffect to a gunbc.remote_operation RemoteOperation — never through effect_actuation shell strings (that module is privilege-derivation only; serving_privilege_derivation_witness_test). Two operation kinds, because a file write is bytes and bytes ride stdin, never argv: argv arms are EnableLingerForOwnAccount [sudo, -n, loginctl, enable-linger, login]; ReloadUserManager [systemctl, --user, daemon-reload]; EnableUserUnit [systemctl, --user, enable, --now, unit] — no interpolation, unit basename from gunbc.spark_serving_unit_identity. The file-bytes arm is WriteUserUnitFile, whose content comes from gunbc.spark_serving_unit_render and whose path is admitted by typed_remote_file_write_seal (containment under the executor home plus far-side portability); its seal refusal is carried through with its own cause. Every remaining effect refuses; a sequence containing one refuses whole."

// A SEQUENCE OF COMMANDS, NOT ONE ARGV. This carrier previously held a single List<String> and
// the effects fold appended with concat, which concatenated argv WORDS across effects. That is
// coherent only while exactly one effect is implemented: with two, the linger and daemon-reload
// argvs fused into one 8-word sudo invocation carrying systemctl as trailing operands, and
// nothing refused it because every individual word is portable — the words were fine, the arity
// was nonsense. No validation on List<String> can separate one command from two concatenated
// ones, so the repair is the type: a command is one argv, and a plan is an ordered list of them.
// Ordering is load-bearing for these effects (write the unit file, reload the manager, enable the
// unit), and a fused argv erases it.
type SparkServingInstallRemoteCommandsVerdict =
    SparkServingInstallRemoteCommandsPresent { steps: List<PlannedRemoteStep> }
  | SparkServingInstallRemoteCommandsRefused { reason: String }

// A STEP IS NAMED WHERE IT IS BUILT, because that is the only place its meaning is known. Deriving
// an identity later from a list position would name it by where it happens to sit, so inserting a
// step would silently rename every step after it -- and a receipt that says "step 4 failed" is a
// position, not a fact.
fn spark_serving_step(identity: NonEmptyStr, operation: RemoteOperation) -> PlannedRemoteStep {
  PlannedRemoteStep { identity: identity, operation: operation }
}

fn spark_serving_admit_portable_remote_argv(
  identity: NonEmptyStr,
  raws: List<String>,
) -> SparkServingInstallRemoteCommandsVerdict {
  match portable_remote_words(raws: raws) {
    Present { value: words } =>
      SparkServingInstallRemoteCommandsPresent {
        steps: [
          spark_serving_step(
            identity: identity,
            operation: RemoteArgv { argv: portable_remote_words_strings(words: words) },
          ),
        ],
      }
    Absent =>
      SparkServingInstallRemoteCommandsRefused {
        reason: "spark_serving_converge_realize: remote argv is not portable — refuse rather than shell-interpolate",
      }
  }
}

fn spark_serving_enable_linger_remote_argv(login: NonEmptyStr) -> SparkServingInstallRemoteCommandsVerdict {
  spark_serving_admit_portable_remote_argv(
    identity: "enable-linger" as NonEmptyStr,
    raws: ["sudo", "-n", "loginctl", "enable-linger", login as String],
  )
}

// USER SCOPE, NO SUDO. These two act on the invoking account's own systemd manager, which is why
// they carry no sudo and no login argument: the account is established by the ssh session, not
// named in the argv. Interpolating a login here would be a second, forgeable statement of who is
// acting. The unit basename comes from gunbc.spark_serving_unit_identity, the same authority the
// observe probe reads, so the unit enabled and the unit observed cannot drift apart.
fn spark_serving_reload_user_manager_remote_argv() -> SparkServingInstallRemoteCommandsVerdict {
  spark_serving_admit_portable_remote_argv(
    identity: "daemon-reload" as NonEmptyStr,
    raws: ["systemctl", "--user", "daemon-reload"],
  )
}

// enable --now, matching the fleet_converge_timer precedent: the frozen effect order places
// PullModelArtifact AFTER EnableUserUnit, and pulling a model targets the RUNNING server, so the
// unit must be started here rather than left enabled-but-inactive for a later effect to start.
fn spark_serving_enable_user_unit_remote_argv() -> SparkServingInstallRemoteCommandsVerdict {
  spark_serving_admit_portable_remote_argv(
    identity: "enable-user-unit" as NonEmptyStr,
    raws: ["systemctl", "--user", "enable", "--now", spark_serving_unit_name],
  )
}

// NO WILDCARD, and each unimplemented effect refuses under its OWN name (#8323's construction,
// kept and extended). A wildcard refused correctly but said only that something other than the
// realized set was asked for, so a thirteenth variant would have been absorbed into that sentence
// rather than forcing a decision; enumerating makes a new variant non-exhaustive instead. That
// also retires the non_fold_residue roster row this site briefly carried — there is no wildcard
// left to roster, and a row for a site that no longer exists counts as STALE, which reds the same
// two witnesses the row was added to green.
// WRITING THE UNIT IS BYTES, NOT ARGV, so this produces a `RemoteFileBytes` operation. The bytes come
// from `gunbc.spark_serving_unit_render` -- the single rendering the observe side also reads -- so a
// delivered unit and an observed unit are compared against the same value rather than two renderings
// that can drift.
//
// The path is ADMITTED, not trusted: the seal checks containment under the executor home and
// portability under the far-side re-parse allowlist, and its refusal is carried through with its own
// cause rather than collapsing into a generic not-implemented.
//
// Mode is owner-read-write: a user unit is read by that user's own systemd manager and has no reason
// to be world-readable.
//
// TWO OPERATIONS, ORDERED, because the first consumer is a BARE host. `~/.config/systemd/user` does
// not exist on a machine that has never run a user unit, and the file convergence opens a staging
// sibling with `dd` -- it does not create missing parents. Without the mkdir the very first step
// refuses on exactly the host this effect exists to restore, so realizing the write alone would not
// have realized the effect.
//
// The mkdir is NOT privileged: the directory lives under the executor's own home, so `sudo` would be
// both unnecessary and a privilege escalation for a write the account can already perform. `-p` makes
// it idempotent, which matters because this effect re-runs on every converge until the unit member
// reports converged.
fn spark_serving_write_user_unit_operation() -> SparkServingInstallRemoteCommandsVerdict {
  match typed_remote_file_write_seal(
    path: spark_serving_user_unit_path(),
    content: spark_serving_desired_user_unit_text(),
    allowed_scope: FileTreeScope { root_path: spark_serving_executor_home as NonEmptyStr },
  ) {
    TypedRemoteFileWriteAdmissionRefused { cause: why } =>
      SparkServingInstallRemoteCommandsRefused {
        reason: join(["spark_serving_converge_realize: WriteUserUnitFile refused — ", why as String], ""),
      }
    TypedRemoteFileWriteAdmitted { write: w } =>
      match portable_remote_words(
        raws: ["mkdir", "-p", spark_serving_user_unit_dir() as String],
      ) {
        Absent =>
          SparkServingInstallRemoteCommandsRefused {
            reason: "spark_serving_converge_realize: WriteUserUnitFile refused — the user unit directory is not portable under the far-side re-parse allowlist",
          }
        Present { value: words } =>
          SparkServingInstallRemoteCommandsPresent {
            steps: [
              spark_serving_step(
                identity: "ensure-user-unit-dir" as NonEmptyStr,
                operation: RemoteArgv { argv: portable_remote_words_strings(words: words) },
              ),
              spark_serving_step(
                identity: "write-user-unit-file" as NonEmptyStr,
                operation: RemoteFileBytes { write: w, mode: RemoteFileModeOwnerReadWrite },
              ),
            ],
          }
      }
  }
}

// INSTALLING THE OWNED RUNTIME CLOSURE -- nine steps, each named, each frozen.
//
// THE DIGEST IS VERIFIED BY A MANIFEST PLUS `--check`, NOT BY READING STDOUT. `sha256sum <path>`
// exits zero whenever the file is merely READABLE and puts its answer on stdout, so freezing it as a
// step would install a check that passes on any downloaded bytes at all. `sha256sum --check --status`
// is the opposite: it is silent, and its EXIT STATUS is the comparison result. So the expected digest
// travels as file bytes -- a checksum manifest written by the same typed file-write path the unit
// file uses -- and the verifying argv names only the manifest.
//
// What that buys is that the frozen artifact hash covers the expected digest, the archive path the
// digest is claimed of, the manifest bytes, the manifest's destination, and the exact verifying argv.
// An apply cannot substitute a different expectation, because the expectation is in the bundle.
//
// THE STAGING TREE IS REMOVED FIRST. This effect re-runs on every converge until the runtime member
// reports converged, so a previous interrupted attempt's partial tree would otherwise be extracted
// over -- and `tar` merging into a half-populated directory produces a tree that is neither attempt.
// The removal is confined to a path derived from the materialization identity under our own runtimes
// parent; it is not a general delete.
//
// NOTHING HERE ESTABLISHES THAT THE RUNTIME IS CORRECT. Every step exiting zero means the invoked
// program reported completion. `tar` exiting zero is not proof the entrypoint is present, and `mv`
// exiting zero is not proof the published tree has the intended contents -- which is why the runtime
// observer reads the published root independently afterwards and the plan must come back empty. The
// `test -x` step is here to stop the sequence BEFORE publishing a tree that is visibly wrong, not to
// serve as that proof.
//
// THE RECEIPT IS WRITTEN LAST, inside the published root. Its presence is therefore evidence that
// every prior step completed, and it cannot outlive a failed publish.
fn spark_serving_install_owned_runtime_closure_steps() -> SparkServingInstallRemoteCommandsVerdict {
  let staging = spark_serving_required_runtime_staging_root() as String
  let archive = spark_serving_required_runtime_staged_archive_path() as String
  let manifest = spark_serving_required_runtime_checksum_manifest_path() as String
  let staged_exe = spark_serving_required_runtime_staged_executable_path() as String
  let final_root = spark_serving_required_runtime_root() as String
  match spark_serving_runtime_checksum_manifest_write() {
    SparkServingInstallRemoteCommandsRefused { reason: why } =>
      SparkServingInstallRemoteCommandsRefused { reason: why }
    SparkServingInstallRemoteCommandsPresent { steps: manifest_steps } =>
      match spark_serving_runtime_receipt_write() {
        SparkServingInstallRemoteCommandsRefused { reason: why } =>
          SparkServingInstallRemoteCommandsRefused { reason: why }
        SparkServingInstallRemoteCommandsPresent { steps: receipt_steps } =>
          spark_serving_concat_step_verdicts(verdicts: [
            spark_serving_admit_portable_remote_argv(
              identity: "ensure-runtimes-parent" as NonEmptyStr,
              raws: ["mkdir", "-p", spark_serving_runtimes_parent() as String],
            ),
            spark_serving_admit_portable_remote_argv(
              identity: "reset-attempt-staging" as NonEmptyStr,
              raws: ["rm", "-rf", staging],
            ),
            spark_serving_admit_portable_remote_argv(
              identity: "create-attempt-staging" as NonEmptyStr,
              raws: ["mkdir", "-p", staging],
            ),
            spark_serving_admit_portable_remote_argv(
              identity: "download-archive" as NonEmptyStr,
              raws: [
                "curl", "-fsSL", "-o", archive,
                ollama_binary_release_download_locator(binary_release: ollama_required_release) as String,
              ],
            ),
            SparkServingInstallRemoteCommandsPresent { steps: manifest_steps },
            spark_serving_admit_portable_remote_argv(
              identity: "admit-archive-digest" as NonEmptyStr,
              raws: ["sha256sum", "--check", "--status", manifest],
            ),
            spark_serving_runtime_extract_argv(archive: archive, staging: staging),
            spark_serving_admit_portable_remote_argv(
              identity: "require-staged-entrypoint" as NonEmptyStr,
              raws: ["test", "-x", staged_exe],
            ),
            spark_serving_admit_portable_remote_argv(
              identity: "publish-runtime-root" as NonEmptyStr,
              raws: ["mv", "-T", staging, final_root],
            ),
            SparkServingInstallRemoteCommandsPresent { steps: receipt_steps },
          ])
      }
  }
}

// THE EXTRACTION FLAG COMES FROM THE CITED CODEC, not from the filename. A distribution suffix is a
// naming convention -- `.tgz` and `.tar.gz` are one codec spelled two ways -- so selecting the
// decompressor by suffix would be reading a nickname where the release row already carries the fact.
fn spark_serving_runtime_extract_argv(
  archive: String,
  staging: String,
) -> SparkServingInstallRemoteCommandsVerdict {
  match ollama_required_release.archive_format.codec {
    Zstd =>
      spark_serving_admit_portable_remote_argv(
        identity: "extract-archive" as NonEmptyStr,
        raws: ["tar", "--zstd", "-xf", archive, "-C", staging],
      )
    Gzip =>
      spark_serving_admit_portable_remote_argv(
        identity: "extract-archive" as NonEmptyStr,
        raws: ["tar", "-xzf", archive, "-C", staging],
      )
  }
}

// The manifest is `<hex><two spaces><path>`, the format `sha256sum --check` parses. Two spaces means
// binary mode; one space and a star means the same thing to GNU coreutils, and picking one and
// stating it here is cheaper than discovering the difference on a host.
fn spark_serving_runtime_checksum_manifest_content() -> String {
  join([
    ollama_required_release.digest.hex as String,
    "  ",
    spark_serving_required_runtime_staged_archive_path() as String,
  ], "")
}

fn spark_serving_runtime_checksum_manifest_write() -> SparkServingInstallRemoteCommandsVerdict {
  spark_serving_admit_typed_file_step(
    identity: "write-checksum-manifest" as NonEmptyStr,
    path: spark_serving_required_runtime_checksum_manifest_path(),
    content: spark_serving_runtime_checksum_manifest_content(),
  )
}

// The receipt records WHICH materialization this root is, so a later observer can tell a correctly
// published tree from one that merely occupies the right path name.
fn spark_serving_runtime_receipt_write() -> SparkServingInstallRemoteCommandsVerdict {
  spark_serving_admit_typed_file_step(
    identity: "write-materialization-receipt" as NonEmptyStr,
    path: spark_serving_required_runtime_receipt_path(),
    content: ollama_runtime_materialization_identity_for_required_release().digest as String,
  )
}

// One admission path for every frozen file write, so containment and far-side portability are checked
// the same way for a checksum manifest, a receipt and a unit file.
fn spark_serving_admit_typed_file_step(
  identity: NonEmptyStr,
  path: FilePath,
  content: String,
) -> SparkServingInstallRemoteCommandsVerdict {
  match typed_remote_file_write_seal(
    path: path,
    content: content,
    allowed_scope: FileTreeScope { root_path: spark_serving_executor_home as NonEmptyStr },
  ) {
    TypedRemoteFileWriteAdmissionRefused { cause: why } =>
      SparkServingInstallRemoteCommandsRefused {
        reason: join([
          "spark_serving_converge_realize: ", identity as String, " refused — ", why as String,
        ], ""),
      }
    TypedRemoteFileWriteAdmitted { write: w } =>
      SparkServingInstallRemoteCommandsPresent {
        steps: [
          spark_serving_step(
            identity: identity,
            operation: RemoteFileBytes { write: w, mode: RemoteFileModeOwnerReadWrite },
          ),
        ],
      }
  }
}

// ONE REFUSAL REFUSES THE WHOLE SEQUENCE. A partially admitted install is not a shorter install: it
// is an install that would run its prefix and report the effect applied.
fn spark_serving_concat_step_verdicts(
  verdicts: List<SparkServingInstallRemoteCommandsVerdict>,
) -> SparkServingInstallRemoteCommandsVerdict {
  fold(verdicts, init: SparkServingInstallRemoteCommandsPresent { steps: [] }, f: fn(acc, v) {
    match acc {
      SparkServingInstallRemoteCommandsRefused { reason: _ } => acc
      SparkServingInstallRemoteCommandsPresent { steps: prior } =>
        match v {
          SparkServingInstallRemoteCommandsRefused { reason: why } =>
            SparkServingInstallRemoteCommandsRefused { reason: why }
          SparkServingInstallRemoteCommandsPresent { steps: next } =>
            SparkServingInstallRemoteCommandsPresent { steps: concat(prior, next) }
        }
    }
  })
}

fn realize_spark_serving_install_effect_command(
  effect: ServingInstallEffect,
  executor_login: NonEmptyStr,
) -> SparkServingInstallRemoteCommandsVerdict {
  match effect {
    EnableLingerForOwnAccount =>
      spark_serving_enable_linger_remote_argv(login: executor_login)
    ReloadUserManager => spark_serving_reload_user_manager_remote_argv()
    EnableUserUnit => spark_serving_enable_user_unit_remote_argv()
    WriteSystemUnitFile =>
      SparkServingInstallRemoteCommandsRefused {
        reason: "spark_serving_converge_realize: WriteSystemUnitFile is not implemented in the Spark serving slice",
      }
    ReloadSystemManager =>
      SparkServingInstallRemoteCommandsRefused {
        reason: "spark_serving_converge_realize: ReloadSystemManager is not implemented in the Spark serving slice",
      }
    EnableSystemUnit =>
      SparkServingInstallRemoteCommandsRefused {
        reason: "spark_serving_converge_realize: EnableSystemUnit is not implemented in the Spark serving slice",
      }
    WriteUserUnitFile => spark_serving_write_user_unit_operation()
    InstallRuntimePackage =>
      SparkServingInstallRemoteCommandsRefused {
        reason: "spark_serving_converge_realize: InstallRuntimePackage is not implemented in the Spark serving slice",
      }
    InstallOwnedRuntimeClosure => spark_serving_install_owned_runtime_closure_steps()
    PullModelArtifact =>
      SparkServingInstallRemoteCommandsRefused {
        reason: "spark_serving_converge_realize: PullModelArtifact is not implemented in the Spark serving slice",
      }
    GrantContainerRuntimeAccess =>
      SparkServingInstallRemoteCommandsRefused {
        reason: "spark_serving_converge_realize: GrantContainerRuntimeAccess is not implemented in the Spark serving slice",
      }
    RunContainerAsOwnUser =>
      SparkServingInstallRemoteCommandsRefused {
        reason: "spark_serving_converge_realize: RunContainerAsOwnUser is not implemented in the Spark serving slice",
      }
  }
}

// The concat here appends COMMANDS, not words. That is the whole difference from the prior
// shape: each effect contributes one or more complete argvs, and the list preserves the order
// the effects were frozen in.
fn realize_spark_serving_install_effect_commands(
  effects: List<ServingInstallEffect>,
  executor_login: NonEmptyStr,
) -> SparkServingInstallRemoteCommandsVerdict {
  fold(
    effects,
    init: SparkServingInstallRemoteCommandsPresent { steps: [] },
    f: fn(acc, effect) {
      match acc {
        SparkServingInstallRemoteCommandsRefused { reason: _ } => acc
        SparkServingInstallRemoteCommandsPresent { steps: prior } =>
          match realize_spark_serving_install_effect_command(
            effect: effect,
            executor_login: executor_login,
          ) {
            SparkServingInstallRemoteCommandsRefused { reason: why } =>
              SparkServingInstallRemoteCommandsRefused { reason: why }
            SparkServingInstallRemoteCommandsPresent { steps: next } =>
              SparkServingInstallRemoteCommandsPresent {
                steps: concat(prior, next),
              }
          }
      }
    },
  )
}

fn spark_serving_install_remote_commands_refused(v: SparkServingInstallRemoteCommandsVerdict) -> Bool {
  match v {
    SparkServingInstallRemoteCommandsRefused { reason: _ } => true
    SparkServingInstallRemoteCommandsPresent { steps: _ } => false
  }
}

fn spark_serving_default_executor_login() -> NonEmptyStr {
  spark_serving_automation_principal_login()
}

// Compares ONE command against the single command the linger effect realizes. A caller holding
// a command sequence must select the command it means; this deliberately refuses a sequence of
// any length other than one rather than comparing against a flattened join, which is the
// comparison that would have hidden the fused-argv defect.
fn spark_serving_enable_linger_argv_matches_expected(argv: List<String>) -> Bool {
  match spark_serving_enable_linger_remote_argv(
    login: spark_serving_default_executor_login(),
  ) {
    SparkServingInstallRemoteCommandsPresent { steps: expected } =>
      if expected.length() == 1 {
        match remote_operation_argv(operation: expected.first().operation) {
          Present { value: words } => join(argv, "\0") == join(words, "\0")
          Absent => false
        }
      } else {
        false
      }
    SparkServingInstallRemoteCommandsRefused { reason: _ } => false
  }
}
