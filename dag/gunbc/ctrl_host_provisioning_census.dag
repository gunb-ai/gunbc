module gunbc.ctrl_host_provisioning_census

import std.types { String, NonEmptyStr, Bool, Int, List }
import std.decl_ref { DeclarationRef, decl_ref }
import std.disposition { Disposition, Terminal }

data ctrl_host_provisioning_census_scope_disposition: Disposition = Terminal {
  reason: "The disposition census the runner-provisioning replacement migration requires (DESIGN §3, staged carve-out): one row per FACT the ctrl host/ provisioning surface decides, each joined to the gunbc carrier that already answers it or marked unowned with a typed reason. This module is the census, not a second authority for anything it censuses: every Owned row's content lives in the carrier it names and is not restated here. It is also NOT a citation of ctrl as a live upstream — the 2026-08-06 ruling recorded in gunbc.runner_host_deploy runner_host_deploy_citation deleted the ctrl path literals that stood as authority rows, and nothing here reinstates one. A census subject is a thing being retired; an authority is a thing being consulted."
}

// WHY A CENSUS AND NOT A PORT, AND WHAT THE OPERATOR ASKED FOR INSTEAD.
//
// Operator directive, 2026-08-27, verbatim: "i would just try to preserve any important behaviors
// - i would prefer if you just use ctrl/ as an inspiration for what we would have needed, i would
// prefer to start the design from first principles".
//
// So the unit of this census is a FACT, never a line. A line that exists because bash made it
// convenient carries no obligation into the replacement; a line that exists because a runner stops
// without it does. That distinction is the FactStanding axis below, and it is the axis that makes
// this census actionable rather than a file map: 2917 lines is not a migration scope, and the
// subset of them that are load-bearing and unowned is.
data ctrl_host_census_purpose_note: String = "Per fact: what is this a fact ABOUT, is it load-bearing or incidental, and does gunbc already own it. The output is a scope for the replacement, not a translation of the shell."

// THE SURFACE WAS MEASURED AGAINST A NAMED REF, AND THE REF MOVED WHILE THIS CENSUS WAS BEING
// TAKEN. That is not an inconvenience; it is the census's first finding, so it is recorded as a
// measurement rather than as prose.
//
// The brief that commissioned this work said 19 files / 2887 lines. Measured at ctrl e98af992
// (2026-08-26 21:46 -0400, the head at census time) the surface is 19 files / 2917 lines. The
// difference is exact and it is one commit: 2887 is the tree at e98af992^, and e98af992 -- ctrl
// PR 1994, "Rootless-Docker provisioning silently no-ops: wait for the user bus, not its
// directory" -- added 30 lines to install-actions-runner.sh the day before this row was written.
//
// WHY THAT MATTERS MORE THAN THIRTY LINES. gunbc records this repository as dead: "ctrl is a dead
// repo, not a live upstream" (operator ruling 2026-08-06, carried in gunbc.runner_host_deploy
// runner_host_deploy_citation). The ruling was correct about what gunbc should CITE and it is not
// reopened here. But the surface it describes took a load-bearing defect fix, measured on srv1 the
// same day, three weeks after the ruling -- so "dead" is true of ctrl's standing as an authority
// and false of its standing as the thing that actually provisions srv1's runners. A migration
// scoped on the first reading would be scoped against a tree that is already stale, which is
// precisely what the brief's own figure was.
data ctrl_host_surface_measured_ref: NonEmptyStr = "ctrl e98af992 (2026-08-26T21:46-0400), scripts/session-dashboard/host/" as NonEmptyStr

data ctrl_host_surface_measured_lines: Int = 2917

data ctrl_host_surface_brief_figure_note: String = "The commissioning brief's 2887 is the same 19 files at e98af992^. The delta is entirely ctrl#1994, which fixed a rootless-Docker provisioning step that reported success while installing nothing -- the installer polled for the job user's runtime DIRECTORY rather than its D-Bus SOCKET, so on a host where the directory already existed the setuptool raced the user manager and exited zero. A silently-no-op provisioning step reporting success is the fabricated-plausible-output failure (DESIGN §5) sitting in the surface this census is scoping, and it was found by deploying, not by reading."

type CtrlHostSubject {
  path: NonEmptyStr
  lines: Int
}

fn ctrl_host_subject(path: String, lines: Int) -> CtrlHostSubject {
  CtrlHostSubject { path: path as NonEmptyStr, lines: lines }
}

data actions_runner_unit: CtrlHostSubject = ctrl_host_subject(path: "actions-runner@.service", lines: 100)
data jit_runner_sh: CtrlHostSubject = ctrl_host_subject(path: "jit-runner.sh", lines: 116)
data install_actions_runner_sh: CtrlHostSubject = ctrl_host_subject(path: "install-actions-runner.sh", lines: 623)
data deploy_runner_hosts_sh: CtrlHostSubject = ctrl_host_subject(path: "deploy-runner-hosts.sh", lines: 176)
data ctrl_jobserver_daemon: CtrlHostSubject = ctrl_host_subject(path: "ctrl-jobserver", lines: 288)
data ctrl_jobserver_unit: CtrlHostSubject = ctrl_host_subject(path: "ctrl-jobserver.service", lines: 59)
data install_ctrl_jobserver_sh: CtrlHostSubject = ctrl_host_subject(path: "install-ctrl-jobserver.sh", lines: 129)
data ctrl_sccache_unit: CtrlHostSubject = ctrl_host_subject(path: "ctrl-sccache.service", lines: 136)
data install_ctrl_sccache_sh: CtrlHostSubject = ctrl_host_subject(path: "install-ctrl-sccache.sh", lines: 301)
data reclaim_runner_disk_sh: CtrlHostSubject = ctrl_host_subject(path: "reclaim-runner-disk.sh", lines: 191)
data ctrl_runner_reclaim_unit: CtrlHostSubject = ctrl_host_subject(path: "ctrl-runner-reclaim.service", lines: 29)
data ctrl_runner_reclaim_timer: CtrlHostSubject = ctrl_host_subject(path: "ctrl-runner-reclaim.timer", lines: 19)
data install_runner_reclaim_sh: CtrlHostSubject = ctrl_host_subject(path: "install-runner-reclaim.sh", lines: 64)
data ctrl_litestream_unit: CtrlHostSubject = ctrl_host_subject(path: "ctrl-litestream.service", lines: 82)
data litestream_yml_template: CtrlHostSubject = ctrl_host_subject(path: "litestream.yml.template", lines: 58)
data install_ctrl_litestream_sh: CtrlHostSubject = ctrl_host_subject(path: "install-ctrl-litestream.sh", lines: 244)
data node_overrides_example: CtrlHostSubject = ctrl_host_subject(path: "node_overrides.example.json", lines: 19)
data host_readme: CtrlHostSubject = ctrl_host_subject(path: "README.md", lines: 131)
data rootless_docker_ci_plan: CtrlHostSubject = ctrl_host_subject(path: "ROOTLESS_DOCKER_CI_PLAN.md", lines: 152)

data ctrl_host_surface_files: List<CtrlHostSubject> = [
  actions_runner_unit,
  jit_runner_sh,
  install_actions_runner_sh,
  deploy_runner_hosts_sh,
  ctrl_jobserver_daemon,
  ctrl_jobserver_unit,
  install_ctrl_jobserver_sh,
  ctrl_sccache_unit,
  install_ctrl_sccache_sh,
  reclaim_runner_disk_sh,
  ctrl_runner_reclaim_unit,
  ctrl_runner_reclaim_timer,
  install_runner_reclaim_sh,
  ctrl_litestream_unit,
  litestream_yml_template,
  install_ctrl_litestream_sh,
  node_overrides_example,
  host_readme,
  rootless_docker_ci_plan,
]

// THE STANDING AXIS IS WHAT THE DIRECTIVE ASKED FOR, AND ITS TWO ARMS ARE NOT SYMMETRIC.
//
// LoadBearing carries the FAILURE -- what breaks, concretely, when the fact is absent -- because a
// claim that something matters is unfalsifiable and a named failure is not. Incidental carries
// WHY the line exists anyway, and the answer is almost always the same shape: bash had no types,
// no idempotent apply, and no way to declare intent, so intent had to be spelled as a procedure.
// Those lines are the ones the replacement does not owe anything to.
//
// A third arm was considered and rejected. "Unknown" would have been an honest-looking place to
// put a fact nobody had thought about, and it is exactly the absorbing arm DESIGN §5 forbids: it
// zeroes the frequency of "this census could not decide", so nothing ever ranks for deciding. A
// fact this census cannot classify is a question for the operator, not a variant.
type FactStanding
  = LoadBearing { failure: NonEmptyStr }
  | Incidental { why: NonEmptyStr }

// THE JOIN AXIS IS A THREE-ARM SUM RATHER THAN A PRODUCT, DELIBERATELY, AND THE EXEMPLAR IS WHY.
//
// gunbc.host_standup carries the same census shape one layer up and records its own defect in
// host_standup_gap_ledger_parallel_representation_note: PhaseDisposition is a TWO-arm sum, so
// authorities and interim_realization are mutually exclusive, and two of its live phases need
// BOTH. Partial ownership had no spelling, so it was spelled in a prose ledger beside the rows and
// went stale.
//
// The product form that note proposes -- authorities plus an optional interim -- fixes that and
// admits a state this one cannot: neither authorities nor interim, which is a row asserting
// nothing. PartiallyOwned carries both and REQUIRES the residue, so "gunbc answers part of this"
// cannot be authored without saying which part is left. That is the distinction the prose ledger
// was invented to carry, made unwritable-if-empty instead.
type CarrierJoin
  = Owned { authorities: List<DeclarationRef> }
  | PartiallyOwned { authorities: List<DeclarationRef>, residue: NonEmptyStr }
  | Unowned { reason: UnownedReason }

// ONE ARM PER REASON A FACT HAS NO GUNBC CARRIER, BECAUSE THE REASONS HAVE DIFFERENT OWNERS AND
// DIFFERENT REMEDIES. Collapsing them into one "not modeled" would be the state-space conflation
// DESIGN names: NoCarrierAuthored is work for this repository, UpstreamProductSurface is a fact
// that belongs to a cited dependency and must not be re-coined here (§3), DesignNotBuilt is a plan
// whose remedy is to build or delete it, and DashboardControlPlane is out of this migration's
// scope entirely and its remedy is a different program.
//
// NoCarrierAuthored carries its NEAREST neighbours rather than nothing. "No carrier" is a claim a
// reader must be able to re-run, and a list of the modules that came closest is what makes it
// checkable -- the same reason gunbc.fabric_capacity_class_gap records the one grep hit it found
// and why it does not count, instead of rounding to zero.
type UnownedReason
  = NoCarrierAuthored { nearest: List<DeclarationRef>, why_none_fits: NonEmptyStr }
  | UpstreamProductSurface { upstream: DeclarationRef, why_not_ours: NonEmptyStr }
  | DesignNotBuilt { doc: NonEmptyStr, status: NonEmptyStr }
  | DashboardControlPlane { why_out_of_scope: NonEmptyStr }

type CtrlHostFact {
  subject: CtrlHostSubject
  about: NonEmptyStr
  standing: FactStanding
  join: CarrierJoin
}

fn ctrl_host_fact(subject: CtrlHostSubject, about: String, standing: FactStanding, join: CarrierJoin) -> CtrlHostFact {
  CtrlHostFact {
    subject: subject,
    about: about as NonEmptyStr,
    standing: standing,
    join: join,
  }
}

// ROW 1. The runner unit template's IDENTITY -- the name actions-runner@.service, its per-slot
// instance form, and its drop-in directory. Fully owned; the shell is one realization of names
// gunbc already derives.
data fact_unit_identity: CtrlHostFact = ctrl_host_fact(
  subject: actions_runner_unit,
  about: "the runner systemd unit's template name, per-slot instance naming, and drop-in directory",
  standing: LoadBearing { failure: "a slot whose unit name does not round-trip cannot be enabled, drained, read back or capped -- every operation on a slot is keyed on this name" as NonEmptyStr },
  join: Owned {
    authorities: [
      decl_ref(module_path: "gunbc.runner_unit", decl_name: "runner_unit_template_name"),
      decl_ref(module_path: "gunbc.runner_unit", decl_name: "runner_unit_dropin_path"),
      decl_ref(module_path: "gunbc.runner_unit", decl_name: "read_runner_unit_name"),
    ]
  }
)

// ROW 2. THE CENTRAL SPECIMEN OF THIS CENSUS'S THESIS, and it is not a modeling gap -- it is the
// reason the migration is worth doing.
//
// Measured on srv1 2026-08-26 by the commissioning lane: the LIVE unit was 28 lines with no
// comments and had LOST After=/Wants=ctrl-jobserver.service. The installer writes a 100-line
// commented template that carries both. So the committed source and the running host disagreed,
// nothing detected it, and the host's copy is the one that decided behaviour. A missing
// After=ctrl-jobserver.service means the runner may start before the FIFO exists, and the failure
// surfaces as a cargo build dying on "Invalid jobserver-auth" rather than as a provisioning
// diagnostic.
//
// The fact is DRIFT DETECTION, and it is unowned in the direction that matters. gunbc reads live
// runner units for MEMORY caps (runner_unit_live_read, runner_slot_enforcement) and reconciles
// them, so the mechanism exists; nothing reads the unit's ORDERING directives, so this particular
// divergence is invisible to both sides.
data fact_unit_ordering_drift: CtrlHostFact = ctrl_host_fact(
  subject: actions_runner_unit,
  about: "the runner unit's ordering on the jobserver (After=/Wants=ctrl-jobserver.service), and whether the live unit still matches what the installer writes",
  standing: LoadBearing { failure: "measured on srv1 2026-08-26: the live unit had lost both directives, so a runner can start ahead of the FIFO and the first cargo invocation fails on jobserver-auth -- and because no reader compares ordering, the divergence is silent in both directions" as NonEmptyStr },
  join: PartiallyOwned {
    authorities: [
      decl_ref(module_path: "gunbc.runner_unit_live_read", decl_name: "runner_unit_live_read_typed"),
      decl_ref(module_path: "gunbc.runner_slot_enforcement", decl_name: "runner_slot_enforcement_from_unit_read"),
      decl_ref(module_path: "gunbc.build_cache_unit", decl_name: "runner_ordering_drop_in"),
    ],
    residue: "the live read is scoped to MEMORY properties; nothing reads or reconciles the unit's After=/Wants= ordering, which is the directive that actually drifted on srv1" as NonEmptyStr
  }
)

// ROW 3. Per-slot fork ceiling. The shell pins TasksMax=4096 in the template; gunbc carries the
// per-slot cap axis and its drop-in path, but the cap it models and enforces is MEMORY.
data fact_per_slot_tasks_max: CtrlHostFact = ctrl_host_fact(
  subject: actions_runner_unit,
  about: "the per-slot process ceiling (TasksMax) that bounds one misbehaving job to its own cgroup",
  standing: LoadBearing { failure: "the 2026-05-28 srv2 incident: a CI loop fan-spawned ~105k wrapper shells with no per-unit cap, exhausted RAM and swap, and took the host down -- the jobserver bounds compiles cooperatively but not the arrival rate of blocked shells" as NonEmptyStr },
  join: PartiallyOwned {
    authorities: [
      decl_ref(module_path: "gunbc.host_converge", decl_name: "gunbc_runner_per_slot_tasks_dropin_path"),
      decl_ref(module_path: "gunbc.runner_lifecycle", decl_name: "runner_lifecycle_per_slot_caps"),
      decl_ref(module_path: "gunbc.host_axis_caps", decl_name: "host_axis_caps_note"),
    ],
    residue: "the drop-in PATH is modeled and the per-slot cap AXIS is modeled for memory; the task-count value itself and the reason for its magnitude are carried only in the shell" as NonEmptyStr
  }
)

// ROW 4. Host pinning. LABELS_JSON is what lets a workflow say runs-on:[self-hosted,linux,arm64,srvN].
data fact_runner_labels: CtrlHostFact = ctrl_host_fact(
  subject: actions_runner_unit,
  about: "the runner's registration labels, including the per-host label that lets a workflow pin a job to one machine",
  standing: LoadBearing { failure: "without the host label no workflow can target a specific host, and every placement decision the fleet model makes about which host runs what becomes unenforceable at the GitHub end" as NonEmptyStr },
  join: PartiallyOwned {
    authorities: [
      decl_ref(module_path: "gunbc.runner_slot_allocation", decl_name: "RunnerSlotLabels"),
      decl_ref(module_path: "gunbc.build_cache_instance", decl_name: "runner_slot_instance_name"),
    ],
    residue: "gunbc models the slot's labels as an allocation fact; the JSON encoding handed to the registration API, and its placement in the unit's Environment, are not derived from it" as NonEmptyStr
  }
)

// ROW 5. The jobserver coupling. Two Environment lines that must name the same FIFO path, and the
// file that carries the operator's override of it.
data fact_jobserver_env_coupling: CtrlHostFact = ctrl_host_fact(
  subject: actions_runner_unit,
  about: "binding the runner's builds to the host-wide cargo jobserver by exporting the FIFO path through MAKEFLAGS",
  standing: LoadBearing { failure: "the two lines must agree; when they diverge, cargo points jobserver-auth at a path with no daemon and the runner's first build fails -- and this is the coupling the lost After= in row 2 also breaks, from the other end" as NonEmptyStr },
  join: PartiallyOwned {
    authorities: [
      decl_ref(module_path: "gunbc.host_converge", decl_name: "gunbc_runner_jobserver_env_file"),
      decl_ref(module_path: "gunbc.host_converge", decl_name: "gunbc_runner_jobserver_env_key"),
      decl_ref(module_path: "gunbc.host_converge", decl_name: "gunbc_runner_jobserver_service"),
    ],
    residue: "the env file, key and service name are modeled; that BOTH unit lines derive from one path -- the whole content of the coupling -- is enforced only by the shell writing them together" as NonEmptyStr
  }
)

// ROW 6. The runner's GitHub identity. Owned outright and better than the shell has it: gunbc
// carries the app as a declared entity with a typed secret reference, where the unit carries three
// literal numbers.
data fact_github_app_identity: CtrlHostFact = ctrl_host_fact(
  subject: actions_runner_unit,
  about: "which GitHub App, installation and org the runner registers against, and where its private key lives on the host",
  standing: LoadBearing { failure: "a wrong or stale identity 401s at the JWT exchange and no runner on the fleet can register -- the 2026-05-29 stall" as NonEmptyStr },
  join: Owned {
    authorities: [
      decl_ref(module_path: "gunbc.auth.github_apps", decl_name: "gunbai_ci_declared"),
      decl_ref(module_path: "gunbc.auth.github_apps", decl_name: "gunbai_ci_app_pem_secret"),
      decl_ref(module_path: "gunbc.runner_lifecycle", decl_name: "runner_lifecycle_ci_installation_id"),
      decl_ref(module_path: "gunbc.runner_host_deploy", decl_name: "gunbc_ci_github_app"),
    ]
  }
)

// ROW 7. Restart semantics: one job per invocation, then restart. This is what makes a runner
// EPHEMERAL in identity, and it is the property the whole security posture rests on.
data fact_ephemeral_cycle: CtrlHostFact = ctrl_host_fact(
  subject: actions_runner_unit,
  about: "the ephemeral cycle -- Restart=always over a wrapper that runs exactly one job and exits",
  standing: LoadBearing { failure: "a long-lived runner accumulates state across jobs from different PRs, so an untrusted fork PR's residue is visible to the next job; ephemerality is the isolation, not the container" as NonEmptyStr },
  join: Owned {
    authorities: [
      decl_ref(module_path: "gunbc.runner_unit", decl_name: "RunnerUnitLifecycleIntent"),
      decl_ref(module_path: "gunbc.runner_unit", decl_name: "gunbc_runner_lifecycle_intent"),
      decl_ref(module_path: "gunbc.runner_unit", decl_name: "lifecycle_intent_cannot_orphan"),
    ]
  }
)

// ROW 8. The JIT registration protocol: sign a JWT with the App key, trade it for an installation
// token, mint a one-shot runner config. Three upstream API calls in sequence, each with a typed
// failure.
data fact_jit_registration: CtrlHostFact = ctrl_host_fact(
  subject: jit_runner_sh,
  about: "minting a just-in-time runner registration: App JWT, installation access token, then a single-use JIT config",
  standing: LoadBearing { failure: "this IS how a slot becomes a runner; every ephemeral cycle performs it, and any step failing leaves the slot restart-looping with no registration" as NonEmptyStr },
  join: Unowned {
    reason: NoCarrierAuthored {
      nearest: [
        decl_ref(module_path: "gunbc.auth.github_apps", decl_name: "gunbai_ci_declared"),
        decl_ref(module_path: "gunbc.runner_lifecycle", decl_name: "GitHubRunnerRegistrationObservation"),
        decl_ref(module_path: "gunbc.runner_lifecycle", decl_name: "runner_lifecycle_jit_wrapper_path"),
      ],
      why_none_fits: "gunbc models the wrapper's PATH, the app that signs, and the registration as OBSERVED at GitHub -- but not the mint itself. There is no modeled operation whose inputs are an App key and whose output is a JIT config, so the one operation every runner performs on every job is the one with no .dag surface" as NonEmptyStr
    }
  }
)

// ROW 9. The privilege drop. The wrapper runs as root to read the key, then setpriv's to an
// unprivileged user for the job body, preserving the unit's Environment.
data fact_privilege_drop: CtrlHostFact = ctrl_host_fact(
  subject: jit_runner_sh,
  about: "dropping from the root that mints the registration to the unprivileged user that runs the job, without losing the unit environment",
  standing: LoadBearing { failure: "this is the 2026-06-01 public-repo hardening: a job that keeps root can read the App key and mint org-wide tokens, so an approved fork PR becomes org compromise. The Environment preservation is load-bearing too -- lose it and the jobserver and sccache coupling silently vanish for the job" as NonEmptyStr },
  join: PartiallyOwned {
    authorities: [
      decl_ref(module_path: "gunbc.fleet_posix_accounts", decl_name: "DeployRunnerPrincipal"),
      decl_ref(module_path: "gunbc.fleet_posix_accounts", decl_name: "fleet_posix_ci_runner_principal"),
      decl_ref(module_path: "gunbc.credential_argv_exposure", decl_name: "credential_argv_exposure_instances"),
    ],
    residue: "the unit-user/job-user SPLIT is grounded as a principal pair and argv credential exposure is censused; the DROP as an operation -- who may perform it, what must survive it, and that a failure to be root is fatal rather than a fallback -- is carried only in the wrapper" as NonEmptyStr
  }
)

// ROW 10. Refusing to run as a non-root uid when de-privilege is requested. Named separately from
// row 9 because it is the fail-closed arm, and it is the half a re-derivation is most likely to
// drop: without it, a misconfigured unit runs the job as whatever the wrapper happened to be.
data fact_depriv_refusal: CtrlHostFact = ctrl_host_fact(
  subject: jit_runner_sh,
  about: "refusing outright when a privilege drop is requested but the wrapper is not root, rather than proceeding un-dropped",
  standing: LoadBearing { failure: "the fail-open arm here is invisible and total: the job simply runs with whatever privilege the wrapper had, which on a half-configured host is root, and nothing reports it" as NonEmptyStr },
  join: Unowned {
    reason: NoCarrierAuthored {
      nearest: [
        decl_ref(module_path: "gunbc.runner_activation", decl_name: "admit_runner_activation"),
        decl_ref(module_path: "gunbc.fleet_posix_accounts", decl_name: "DeployRunnerPrincipal"),
      ],
      why_none_fits: "gunbc has an activation admission gate, but it admits on cache and pool READINESS; no admission arm asks whether the identity the job will run as is the one that was declared" as NonEmptyStr
    }
  }
)

// ROW 11. Rendering the unit from a template with placeholder substitution, and validating every
// substituted value at the ingress boundary before it reaches a systemd directive.
data fact_unit_render_and_validate: CtrlHostFact = ctrl_host_fact(
  subject: install_actions_runner_sh,
  about: "rendering the runner unit from committed source, with every substituted value refused at ingress if it could corrupt a directive",
  standing: LoadBearing { failure: "a value carrying a newline splits the unit into bogus directives and a value carrying whitespace changes how systemd tokenizes it -- both accepted by systemd, both silently wrong" as NonEmptyStr },
  join: PartiallyOwned {
    authorities: [
      decl_ref(module_path: "gunbc.build_cache_unit", decl_name: "render_build_cache_unit"),
      decl_ref(module_path: "gunbc.systemd_directive_value_grain", decl_name: "build_cache_environment_variables"),
    ],
    residue: "the delivery spine renders a typed instance into a unit file for four other subjects and the directive-value grain is modeled, so the CAPABILITY exists; the runner unit is not one of the subjects routed through it, and templating with string substitution is what remains" as NonEmptyStr
  }
)

// ROW 12. The pool-wide runner slice cap. The per-slot cap bounds one slot; this bounds the sum.
data fact_runner_slice_cap: CtrlHostFact = ctrl_host_fact(
  subject: install_actions_runner_sh,
  about: "the pool-wide memory ceiling on the slice every runner slot shares, expressed as a fraction of host RAM",
  standing: LoadBearing { failure: "the shared slice ships MemoryMax=infinity by default, which is how the 2026-05-28 srv2 incident exhausted host RAM despite per-slot caps -- the pool total was unbounded" as NonEmptyStr },
  join: Owned {
    authorities: [
      decl_ref(module_path: "gunbc.fleet_host_budget", decl_name: "runner_slice_cap"),
      decl_ref(module_path: "gunbc.runner_slot_allocation", decl_name: "gunbc_runner_slice_cap_declared"),
      decl_ref(module_path: "gunbc.fleet_host_budget", decl_name: "runner_slice_cap_drifted"),
      decl_ref(module_path: "gunbc.host_converge", decl_name: "gunbc_runner_slot_unit_placeholder"),
    ]
  }
)

// ROW 13. Applying a cap to an ALREADY-RUNNING cgroup. A daemon-reload re-reads the drop-in and
// does not re-apply limits to a live slice; only an explicit set-property does. This is the fact
// that separates "the cap is committed" from "the cap is in force".
data fact_live_cap_apply: CtrlHostFact = ctrl_host_fact(
  subject: install_actions_runner_sh,
  about: "applying a changed resource cap to the live cgroup, because writing the drop-in and reloading does not bind a running slice",
  standing: LoadBearing { failure: "without it the host reports the new cap in its configuration and enforces the old one until reboot -- a declared/effective divergence that reads as converged" as NonEmptyStr },
  join: Owned {
    authorities: [
      decl_ref(module_path: "gunbc.runner_lifecycle", decl_name: "runner_lifecycle_memory_cap_apply_note"),
      decl_ref(module_path: "gunbc.host_runner_memory_provision", decl_name: "runner_memory_converge_effect"),
      decl_ref(module_path: "gunbc.runner_slot_allocation", decl_name: "runner_slot_effective_cap_drifts_from_declaration"),
    ]
  }
)

// ROW 14. Installing the App key on the host, and refusing to leave a host with none.
data fact_app_key_install: CtrlHostFact = ctrl_host_fact(
  subject: install_actions_runner_sh,
  about: "landing the GitHub App private key on the host at restricted permissions, and refusing to complete when no key would be present",
  standing: LoadBearing { failure: "a host with no key registers no runners, and the failure appears as jobs never being picked up rather than as an install error -- exactly the silent-missing-key state that stalled all of GHA on 2026-05-29" as NonEmptyStr },
  join: PartiallyOwned {
    authorities: [
      decl_ref(module_path: "gunbc.auth.github_apps", decl_name: "gunbai_ci_app_pem_secret"),
      decl_ref(module_path: "gunbc.auth.github_apps", decl_name: "ManagedGitHubAppKey"),
    ],
    residue: "the key is a typed secret reference with a modeled custody role; the MATERIALIZATION -- reference to an on-host file at a given mode and owner, and the refusal when absent -- is the secret-lifecycle effect gunbc.plans.fleet_subsumption_manual_gaps has been declaring missing since 2026-07-22" as NonEmptyStr
  }
)

// ROW 15. Creating the unprivileged job user, and REFUSING if it carries a privileged group.
data fact_job_user_provision: CtrlHostFact = ctrl_host_fact(
  subject: install_actions_runner_sh,
  about: "provisioning the unprivileged job user and refusing to proceed if that user holds a privileged group",
  standing: LoadBearing { failure: "a de-privileged user in the docker group still gets root through the daemon, so without the refusal the whole privilege separation is a label -- the guarantee is the group check, not the user's name" as NonEmptyStr },
  join: PartiallyOwned {
    authorities: [
      decl_ref(module_path: "gunbc.fleet_posix_accounts", decl_name: "fleet_posix_ci_runner_principal"),
      decl_ref(module_path: "gunbc.fleet_posix_accounts", decl_name: "PosixAccountAllocationStanding"),
      decl_ref(module_path: "gunbc.fleet_posix_accounts", decl_name: "ground_posix_principal"),
    ],
    residue: "the principal is grounded and its allocation standing is modeled; the NEGATIVE constraint -- that this principal must hold none of a named set of privileged groups, checked before anything else proceeds -- has no carrier" as NonEmptyStr
  }
)

// ROW 16. Rootless container runtime for the de-privileged job user: subordinate id ranges,
// lingering, the user manager, and the engine itself.
data fact_rootless_container_runtime: CtrlHostFact = ctrl_host_fact(
  subject: install_actions_runner_sh,
  about: "provisioning a rootless container engine for the job user -- subordinate uid/gid ranges, lingering, the user service manager, and the engine packages",
  standing: LoadBearing { failure: "this is the only container path that gives a CI job an isolated home and an enforceable memory cgroup WITHOUT granting the docker group or the system socket, either of which is root-equivalent. It is also the step ctrl#1994 found reporting success while installing nothing" as NonEmptyStr },
  join: PartiallyOwned {
    authorities: [
      decl_ref(module_path: "gunbc.runner_host_deploy", decl_name: "runner_host_docker_provision_script"),
      decl_ref(module_path: "extdeps.container.docker_ce", decl_name: "docker_ce_packages"),
      decl_ref(module_path: "gunbc.runner_host_deploy", decl_name: "runner_host_prereq_note"),
    ],
    residue: "the engine packages are cited and a provisioning script is carried as a prerequisite; the ROOTLESS specifics have no model at all -- subordinate id allocation, lingering, and waiting for the user bus before driving the user manager, which is precisely where the silent no-op lived" as NonEmptyStr
  }
)

// ROW 17. The containerized-CI pool cap. Container work runs under the JOB USER's slice, not the
// runner slice, so the cap in row 12 does not reach it.
data fact_job_user_slice_cap: CtrlHostFact = ctrl_host_fact(
  subject: install_actions_runner_sh,
  about: "a second pool ceiling on the job user's own slice, because containerized job bodies run outside the runner slice entirely",
  standing: LoadBearing { failure: "containerizing MOVES the work out from under the cap that keeps the host alive; without this cap, adopting container jobs silently removes the bound rather than tightening it -- srv1 2026-06-10 reached 60.6 GB across four uncapped jobs" as NonEmptyStr },
  join: Unowned {
    reason: NoCarrierAuthored {
      nearest: [
        decl_ref(module_path: "gunbc.fleet_host_budget", decl_name: "runner_slice_cap"),
        decl_ref(module_path: "gunbc.fleet_host_budget", decl_name: "host_allocation_tree"),
        decl_ref(module_path: "gunbc.host_axis_caps", decl_name: "host_axis_caps_note"),
      ],
      why_none_fits: "the host allocation tree charges the runner slice, the sessions slice and the compile pool; the job user's slice is not a node in it, so the budget model cannot see the RAM containerized CI would consume and would not detect it being double-counted or uncapped" as NonEmptyStr
    }
  }
)

// ROW 18. The isolated CI build cache. A separate cache instance for untrusted job code, owned by
// the job user -- deliberately NOT the shared host cache.
data fact_isolated_ci_cache: CtrlHostFact = ctrl_host_fact(
  subject: install_actions_runner_sh,
  about: "giving the de-privileged job its own build cache instance rather than access to the trusted shared one",
  standing: LoadBearing { failure: "a writable shared cache reachable by untrusted fork-PR code is a poisoning vector into trusted local builds; the isolation is the operator decision of 2026-06-01, and CI-to-CI warmth is preserved because the separate cache still persists across job cycles" as NonEmptyStr },
  join: Owned {
    authorities: [
      decl_ref(module_path: "gunbc.build_cache_instance", decl_name: "BuildCacheConsumerClass"),
      decl_ref(module_path: "gunbc.build_cache_instance", decl_name: "ci_cache_instance"),
      decl_ref(module_path: "gunbc.build_cache_instance", decl_name: "build_cache_desired_instances"),
      decl_ref(module_path: "gunbc.build_cache_ensure", decl_name: "admit_ensure_build_cache_instance"),
    ]
  }
)

// ROW 19. The drop-in that carries the de-privilege environment into the job.
data fact_depriv_dropin: CtrlHostFact = ctrl_host_fact(
  subject: install_actions_runner_sh,
  about: "the drop-in that switches the unit to the minting identity and exports the job's cache and container-runtime environment",
  standing: LoadBearing { failure: "removing it while the wrapper still expects to drop leaves jobs running as root; leaving it stale after de-privilege is withdrawn does the same -- the installer's removal arm is as load-bearing as its write arm" as NonEmptyStr },
  join: PartiallyOwned {
    authorities: [
      decl_ref(module_path: "gunbc.runner_unit", decl_name: "runner_unit_dropin_path"),
      decl_ref(module_path: "extdeps.cache.sccache", decl_name: "sccache_idle_timeout_never_env_assignment"),
      decl_ref(module_path: "gunbc.build_cache_unit", decl_name: "capacity_env_directives"),
    ],
    residue: "drop-in paths and the cache environment assignments are modeled; the drop-in as a RECONCILED MEMBER -- present when de-privilege is intended, absent otherwise, with the absent arm actively removing a stale one -- is not, and that arm is the one whose failure is silent root" as NonEmptyStr
  }
)

// ROW 20. Idempotence by content comparison. Every write in the installer is guarded by comparing
// what would be written against what is there, and a no-op install performs no restart.
data fact_installer_idempotence: CtrlHostFact = ctrl_host_fact(
  subject: install_actions_runner_sh,
  about: "reconciling by comparing rendered content to installed content, so an unchanged deploy restarts nothing",
  standing: LoadBearing { failure: "an unconditional write plus reload restarts every runner slot on every deploy, killing in-flight jobs; and because the deploy is fanned out automatically on every dashboard restart, the churn would be continuous" as NonEmptyStr },
  join: Owned {
    authorities: [
      decl_ref(module_path: "gunbc.runner_slot_provision", decl_name: "runner_slot_membership_reconcile"),
      decl_ref(module_path: "gunbc.runner_disk_reclaim", decl_name: "reclaim_member_ownership"),
      decl_ref(module_path: "gunbc.build_cache_ensure", decl_name: "ensure_is_a_reconcile_not_an_install_note"),
    ]
  }
)

// ROW 21. Provisioning the OS packages a de-privileged job cannot install for itself. This is a
// real consequence of de-privilege that is easy to forget when re-deriving it.
data fact_ci_os_packages: CtrlHostFact = ctrl_host_fact(
  subject: install_actions_runner_sh,
  about: "installing the job's OS-level toolchain at provisioning time, because a de-privileged job cannot install it itself",
  standing: LoadBearing { failure: "de-privilege removes the job's ability to apt-install, so any dependency the workflow used to install at job time must move to provisioning or the job fails on a missing tool -- the same class as the rustfmt incident gunbc.host_toolchain_components records" as NonEmptyStr },
  join: PartiallyOwned {
    authorities: [
      decl_ref(module_path: "gunbc.host_toolchain_components", decl_name: "floor_gate_component_requirements"),
      decl_ref(module_path: "gunbc.host_toolchain_components", decl_name: "toolchain_ensure_apply_scaffold"),
      decl_ref(module_path: "gunbc.host_toolchain_components", decl_name: "ComponentSpawnReachability"),
    ],
    residue: "the toolchain-component axis models rustup components on a resolved toolchain and already carries the reachability distinction; OS PACKAGES are a different dependency class with no requirement roster, so nothing states what a runner host must carry" as NonEmptyStr
  }
)

// ROW 22. Which hosts get provisioned, and reaching them.
data fact_fleet_fanout_roster: CtrlHostFact = ctrl_host_fact(
  subject: deploy_runner_hosts_sh,
  about: "the roster of hosts to provision and the identity and address used to reach each",
  standing: LoadBearing { failure: "a host absent from the roster is never provisioned and never reports as unprovisioned -- it simply serves no runners, which reads as capacity that was never planned rather than a host that was missed" as NonEmptyStr },
  join: Owned {
    authorities: [
      decl_ref(module_path: "gunbc.runner_host_deploy", decl_name: "fleet_runner_host_deploys"),
      decl_ref(module_path: "gunbc.runner_host_deploy", decl_name: "runner_host_deploy_for"),
      decl_ref(module_path: "gunbc.runner_host_deploy", decl_name: "RunnerHostDeployResolution"),
      decl_ref(module_path: "gunbc.fleet_intent_network", decl_name: "fleet_intent_network"),
    ]
  }
)

// ROW 23. THE SECRET LIFECYCLE, and it is the most transferable fact in the surface.
//
// The wrapper does the whole shape by hand: read one canonical copy, ship it to a private
// per-run temp, use it, shred it whatever happened. gunbc.plans.fleet_subsumption_manual_gaps A1
// names this exact pattern as evidence the shape is known and not yet a first-class effect. It is
// still not one.
data fact_secret_materialization: CtrlHostFact = ctrl_host_fact(
  subject: deploy_runner_hosts_sh,
  about: "materializing a credential from its single canonical copy, binding it to a transport, and destroying it on completion including on failure",
  standing: LoadBearing { failure: "every arm matters separately: no canonical copy means per-host drift and the 2026-05-29 rotation stall; no shred leaves the org's App key on disk on four hosts; and validating the key BEFORE touching any host is what turns a fleet-wide 401 into a local refusal" as NonEmptyStr },
  join: Unowned {
    reason: NoCarrierAuthored {
      nearest: [
        decl_ref(module_path: "gunbc.auth.github_apps", decl_name: "gunbai_ci_app_pem_secret"),
        decl_ref(module_path: "gunbc.plans.fleet_subsumption_manual_gaps", decl_name: "fsmg_secret_materialization"),
        decl_ref(module_path: "gunbc.credential_argv_exposure", decl_name: "credential_argv_exposure_instances"),
      ],
      why_none_fits: "a SecretRef names WHERE a secret lives; the missing carrier is the effect that turns a reference into a usable credential and destroys it by construction rather than by a remembered step. It has been declared missing since 2026-07-22 and this surface is its most complete hand-rolled instance -- which makes it the strongest candidate to model first, since the replacement cannot deploy a key without it" as NonEmptyStr
    }
  }
)

// ROW 24. The de-privilege default, and the distinction between an unset variable and an empty one.
// This is a fact about DEFAULTS BEING SAFE, and it is the kind of thing a re-derivation loses.
data fact_depriv_default_is_safe: CtrlHostFact = ctrl_host_fact(
  subject: deploy_runner_hosts_sh,
  about: "the fan-out's default being the de-privileged posture, with reverting to root jobs requiring an explicit choice rather than an omission",
  standing: LoadBearing { failure: "the installer REMOVES the de-privilege drop-in when no job user is named, so a fan-out that forgot to pass one would silently re-expose root to untrusted fork-PR code -- and because the fan-out runs automatically, nobody would be present when it happened" as NonEmptyStr },
  join: Unowned {
    reason: NoCarrierAuthored {
      nearest: [
        decl_ref(module_path: "gunbc.runner_host_deploy", decl_name: "RunnerHostDeploy"),
        decl_ref(module_path: "gunbc.fleet_posix_accounts", decl_name: "DeployRunnerPrincipal"),
      ],
      why_none_fits: "RunnerHostDeploy carries job_user as a required field, so in gunbc the unsafe state is already closer to unwritable than the shell's convention makes it -- but nothing states that the absent case is a DELIBERATE REVERT rather than an omission, which is the whole content of the distinction the wrapper is protecting" as NonEmptyStr
    }
  }
)

// ROW 25. Sizing the host-wide compile pool from cores AND memory, and refusing to start on a
// failed probe rather than assuming a value.
data fact_jobserver_token_derivation: CtrlHostFact = ctrl_host_fact(
  subject: ctrl_jobserver_daemon,
  about: "deriving the host's concurrent-compile ceiling from both core count and available memory, and refusing to start when either cannot be measured",
  standing: LoadBearing { failure: "a core-only bound oversubscribes memory on a high-core host and drives the runner slice past its wall -- the 2026-05-28 class; and fabricating a token count from a failed probe is the fabricated-plausible-output failure with the whole host as its blast radius" as NonEmptyStr },
  join: Owned {
    authorities: [
      decl_ref(module_path: "extdeps.jobserver", decl_name: "JobserverConfig"),
      decl_ref(module_path: "extdeps.jobserver", decl_name: "derive_jobserver_tokens"),
      decl_ref(module_path: "gunbc.fleet_host_budget", decl_name: "resolve_compile_pool"),
      decl_ref(module_path: "gunbc.fleet_host_budget", decl_name: "gunbc_jobserver_token_override_note"),
    ]
  }
)

// ROW 26. The FIFO's lifecycle: recreate on every start so the pool cannot drift, and self-heal the
// one non-FIFO state that is never legitimate.
data fact_jobserver_fifo_lifecycle: CtrlHostFact = ctrl_host_fact(
  subject: ctrl_jobserver_daemon,
  about: "owning the jobserver FIFO -- recreated per start so the token pool cannot accumulate, with an empty directory at that path healed rather than refused",
  standing: LoadBearing { failure: "measured on srv2 2026-05-29: a container bind-mounted the FIFO before the daemon created it, the container runtime materialized an empty directory there, and the unit crash-looped 9137 times while every compile on the host was token-starved. Seeding on top of an existing FIFO instead of recreating lets the pool drift across restarts" as NonEmptyStr },
  join: Unowned {
    reason: NoCarrierAuthored {
      nearest: [
        decl_ref(module_path: "gunbc.host_converge", decl_name: "gunbc_runner_jobserver_service"),
        decl_ref(module_path: "gunbc.build_cache_endpoint_path", decl_name: "endpoint_path_state_authority_note"),
      ],
      why_none_fits: "the identical problem IS modeled one subject over: gunbc.build_cache_endpoint_path is a state machine for exactly this -- an endpoint path that may be absent, a socket, or a bind-mount artifact -- built because EndpointAbsent was not enough. The jobserver FIFO has the same three states and no such model, so the fix exists and does not reach here" as NonEmptyStr
    }
  }
)

// ROW 27. Bounding token leaks by restarting the daemon on a schedule. Named because it is a
// mitigation whose absence is invisible: leaked tokens only ever reduce throughput.
data fact_jobserver_leak_bound: CtrlHostFact = ctrl_host_fact(
  subject: ctrl_jobserver_unit,
  about: "bounding token leakage from killed builds by giving the daemon a maximum runtime and reseeding on restart",
  standing: LoadBearing { failure: "a build killed between checking out a token and returning it leaks it permanently; with no reseed the host's effective compile ceiling decays toward zero and presents as everything getting slower, never as an error" as NonEmptyStr },
  join: Unowned {
    reason: NoCarrierAuthored {
      nearest: [
        decl_ref(module_path: "extdeps.jobserver", decl_name: "jobserver_config"),
        decl_ref(module_path: "gunbc.build_cache_unit", decl_name: "compile_pool_service_directives"),
      ],
      why_none_fits: "the jobserver's cited config models its three sizing knobs; its unit's supervision directives are not modeled, unlike the build cache's, whose service directives are derived from a typed instance" as NonEmptyStr
    }
  }
)

// ROW 28. The daemon's confinement profile, and the one confinement that is deliberately loosened.
data fact_jobserver_hardening: CtrlHostFact = ctrl_host_fact(
  subject: ctrl_jobserver_unit,
  about: "the daemon's confinement, and the deliberate choice not to confine the filesystem strictly so an operator-chosen FIFO path stays writable",
  standing: Incidental { why: "the confinement is real but it is a property of a daemon whose whole body is mkfifo-and-sleep. In the replacement the pool is not a bash daemon holding a pipe open, so the profile is not a fact to carry across -- what carries is the constraint it encodes, which is row 26's path being operator-choosable" as NonEmptyStr },
  join: Unowned {
    reason: NoCarrierAuthored {
      nearest: [
        decl_ref(module_path: "gunbc.build_cache_unit", decl_name: "compile_pool_service_directives"),
      ],
      why_none_fits: "no carrier models systemd confinement directives for any subject; the build cache unit models supervision and environment but not hardening" as NonEmptyStr
    }
  }
)

// ROW 29. Readiness probing after start. Both installers do the same thing for the same reason, so
// it is one fact with two instances rather than two facts.
data fact_post_start_readiness_probe: CtrlHostFact = ctrl_host_fact(
  subject: install_ctrl_jobserver_sh,
  about: "verifying after start that the thing the service is supposed to own actually exists, because the supervisor reports active as soon as the process spawns",
  standing: LoadBearing { failure: "an installer that exits successfully while the FIFO or socket has not appeared hands the operator a host that looks provisioned; the first consumer discovers otherwise, at job time, as a build failure" as NonEmptyStr },
  join: PartiallyOwned {
    authorities: [
      decl_ref(module_path: "gunbc.build_cache_endpoint_observe", decl_name: "proc_net_unix_columns_note"),
      decl_ref(module_path: "gunbc.build_cache_ensure", decl_name: "EndpointPreflight"),
      decl_ref(module_path: "gunbc.build_cache_provision_verdict", decl_name: "build_cache_server_placement_doc"),
    ],
    residue: "for the build cache this is fully modeled: a typed endpoint observation with named unavailability reasons, and a preflight that refuses. The jobserver has no observation type, so its readiness is answered only by a shell test" as NonEmptyStr
  }
)

// ROW 30. Reading the path a service will ACTUALLY use, from the override file rather than the
// installing process's own environment. Small, and it is a genuine fact about correctness.
data fact_probe_reads_effective_config: CtrlHostFact = ctrl_host_fact(
  subject: install_ctrl_jobserver_sh,
  about: "resolving the effective configuration a service will use from its override file, so a readiness probe checks the path the daemon uses rather than the default",
  standing: LoadBearing { failure: "a re-install on a host with a customized path restarts the daemon on the custom path and probes the default one, so it reports failure on a healthy host -- a false red that trains operators to ignore the probe" as NonEmptyStr },
  join: Unowned {
    reason: NoCarrierAuthored {
      nearest: [
        decl_ref(module_path: "gunbc.host_converge", decl_name: "gunbc_runner_jobserver_env_file"),
      ],
      why_none_fits: "the override FILE is modeled as a path; that a declared default and an operator override compose into one effective value, and that every consumer must read the composed value, is not modeled for any subject" as NonEmptyStr
    }
  }
)

// ROW 31. One cache server per host, running as the identity its clients can reach.
data fact_build_cache_server: CtrlHostFact = ctrl_host_fact(
  subject: ctrl_sccache_unit,
  about: "one host-wide build cache server, running as the identity whose socket its clients can connect to, with its capacity and never-idle policy declared",
  standing: LoadBearing { failure: "the cache's local storage assumes single-server ownership; two servers on one directory each enforce the capacity independently and cross-evict. A wrong identity makes the socket unconnectable for every client, silently, and an idle shutdown leaves a stale socket for the next client to trip on" as NonEmptyStr },
  join: Owned {
    authorities: [
      decl_ref(module_path: "gunbc.build_cache_instance", decl_name: "BuildCacheInstance"),
      decl_ref(module_path: "gunbc.build_cache_unit", decl_name: "render_build_cache_unit"),
      decl_ref(module_path: "extdeps.cache.sccache", decl_name: "sccache_server_process_model_doc"),
      decl_ref(module_path: "extdeps.cache.sccache", decl_name: "sccache_idle_timeout_never_value_note"),
    ]
  }
)

// ROW 32. The confinements that must NOT be applied to a cache server, because it spawns the real
// compiler in the client's working directory. A negative fact, and negative facts are the ones a
// clean re-derivation reintroduces.
data fact_cache_confinement_exclusions: CtrlHostFact = ctrl_host_fact(
  subject: ctrl_sccache_unit,
  about: "the two confinements that must not be applied to the cache server, because it executes the compiler server-side against the client's own paths",
  standing: LoadBearing { failure: "confining the server's view of home breaks every CI compile, since job trees live there; confining its temporary directory breaks source and temp visibility. Both look like obvious hardening and both were verified to fail 100% of real compiles" as NonEmptyStr },
  join: Unowned {
    reason: NoCarrierAuthored {
      nearest: [
        decl_ref(module_path: "extdeps.cache.sccache", decl_name: "sccache_server_process_facts"),
        decl_ref(module_path: "gunbc.build_cache_unit", decl_name: "build_cache_unit_file"),
      ],
      why_none_fits: "the server's process model is cited, including that it spawns the compiler; the CONSEQUENCE for confinement is not carried anywhere, so the unit renderer has nothing that would refuse a future author adding those directives -- which is exactly what a re-derivation from first principles would do" as NonEmptyStr
    }
  }
)

// ROW 33. Verifying which storage backend the server actually bound, and refusing on a confirmed
// fallback. This is a fail-closed arm over a silent degradation, and it is worth carrying.
data fact_cache_backend_verification: CtrlHostFact = ctrl_host_fact(
  subject: install_ctrl_sccache_sh,
  about: "confirming after start which storage backend the cache server actually bound, and refusing when a configured shared backend silently fell back to local disk",
  standing: LoadBearing { failure: "an unreachable endpoint or bad credential makes the server fall back to local disk and keep working, so the shared cache appears deployed while every host has a private one and no cross-host hit ever occurs -- a degradation whose only symptom is builds being slower than expected" as NonEmptyStr },
  join: PartiallyOwned {
    authorities: [
      decl_ref(module_path: "gunbc.build_cache_instance", decl_name: "BuildCacheStorageObservation"),
      decl_ref(module_path: "gunbc.build_cache_instance", decl_name: "BuildCacheStorageConfiguration"),
      decl_ref(module_path: "gunbc.build_cache_provision_verdict", decl_name: "build_cache_server_placement_doc"),
    ],
    residue: "the storage configuration and its observation are typed, so the distinction between intended and actual backend is representable; the shared object-store backend itself is not among the modeled configurations, so the specific fallback this verifies has no modeled counterpart to compare against" as NonEmptyStr
  }
)

// ROW 34. Classifying a backend from one named line rather than from anywhere in the output. A
// small correctness fact with a general lesson, kept because it is the kind of thing that reads as
// fussiness and is actually the difference between a working check and a permanently-green one.
data fact_backend_classification_discipline: CtrlHostFact = ctrl_host_fact(
  subject: install_ctrl_sccache_sh,
  about: "classifying the active backend from the one line that reports it, checking the failure case first, rather than pattern-matching anywhere in the output",
  standing: LoadBearing { failure: "the tool's own name, the local directory path and the canonical bucket name are all the same string, so matching it anywhere false-positives the success branch on a real fallback -- the fail-closed check would report success in precisely the case it exists to catch" as NonEmptyStr },
  join: Unowned {
    reason: NoCarrierAuthored {
      nearest: [
        decl_ref(module_path: "gunbc.build_cache_endpoint_observe", decl_name: "proc_net_unix_columns_note"),
      ],
      why_none_fits: "the same discipline IS modeled for the socket observation, which reads fields by fixed column rather than by scanning; the cache statistics output has no typed decode, so its classification remains a text match" as NonEmptyStr
    }
  }
)

// ROW 35. Bounded disk reclaim, and its safety rule: never touch a slot that is running a job.
data fact_bounded_disk_reclaim: CtrlHostFact = ctrl_host_fact(
  subject: reclaim_runner_disk_sh,
  about: "bounding the growth of persistent runner workspaces without discarding the warm checkout, and skipping any slot currently executing a job",
  standing: LoadBearing { failure: "the workspaces are deliberately persistent so CI does not re-clone and rebuild cold; nothing else bounds them, and at their measured growth the disk fills. Repacking a live checkout races the job that owns it" as NonEmptyStr },
  join: Owned {
    authorities: [
      decl_ref(module_path: "gunbc.runner_disk_reclaim", decl_name: "admit_reclaim_operation"),
      decl_ref(module_path: "gunbc.runner_disk_reclaim", decl_name: "operation_requires_idle_slot"),
      decl_ref(module_path: "gunbc.host_disk_reclaim", decl_name: "repack_decision_for"),
      decl_ref(module_path: "gunbc.host_disk_reclaim", decl_name: "reclaim_parameters_note"),
    ]
  }
)

// ROW 36. Healing the shared review store's broken references, so that a repack cannot wedge and
// disable itself.
data fact_review_store_heal: CtrlHostFact = ctrl_host_fact(
  subject: reclaim_runner_disk_sh,
  about: "dropping unresolvable review references and the log that would disable future automatic maintenance, before repacking",
  standing: LoadBearing { failure: "a review killed mid-run leaks a reference whose object later goes missing; the repack then fails and writes a log that DISABLES all subsequent automatic maintenance, so one interrupted review wedges every later one on that host until a human intervenes" as NonEmptyStr },
  join: Owned {
    authorities: [
      decl_ref(module_path: "gunbc.runner_disk_reclaim", decl_name: "ReviewRefDisposition"),
      decl_ref(module_path: "gunbc.runner_disk_reclaim", decl_name: "review_ref_should_be_dropped"),
      decl_ref(module_path: "gunbc.host_disk_reclaim", decl_name: "StoreWedgeCause"),
    ]
  }
)

// ROW 37. Performing owner-scoped maintenance AS the owner, dispatching from root but never acting
// as it.
data fact_reclaim_runs_as_owner: CtrlHostFact = ctrl_host_fact(
  subject: reclaim_runner_disk_sh,
  about: "dispatching maintenance from a privileged context but performing every owner-scoped action as the owning identity",
  standing: LoadBearing { failure: "repacking as root leaves root-owned pack files inside a tree the unprivileged job must read, so the reclaim that was supposed to save the slot breaks it -- and the breakage appears on the next job, not during the reclaim" as NonEmptyStr },
  join: PartiallyOwned {
    authorities: [
      decl_ref(module_path: "gunbc.runner_disk_reclaim", decl_name: "reclaim_job_user"),
      decl_ref(module_path: "gunbc.fleet_posix_accounts", decl_name: "posix_sudo_grant_to_effect_grant"),
    ],
    residue: "the job user the reclaimer acts for is modeled and the fleet models sudo grants as typed effect grants; that an operation must be PERFORMED as a named identity rather than merely authorized by one is not a property any modeled effect carries" as NonEmptyStr
  }
)

// ROW 38. Scheduling: a cadence inside the growth rate, catching up after downtime, and yielding to
// live CI for CPU and disk.
data fact_reclaim_schedule: CtrlHostFact = ctrl_host_fact(
  subject: ctrl_runner_reclaim_timer,
  about: "running reclaim on a cadence inside the growth rate, catching up after a host was down, and never contending with live CI",
  standing: LoadBearing { failure: "a cadence slower than the growth rate does not bound anything; no catch-up means a host that was off silently skips reclaim indefinitely; and reclaim competing with CI for disk turns maintenance into the thing that makes builds slow" as NonEmptyStr },
  join: PartiallyOwned {
    authorities: [
      decl_ref(module_path: "gunbc.runner_disk_reclaim", decl_name: "reclaim_managed_unit_paths"),
      decl_ref(module_path: "gunbc.runner_disk_reclaim", decl_name: "reclaim_member_ownership"),
      decl_ref(module_path: "gunbc.host_disk_reclaim_units", decl_name: "host_disk_reclaim_units_note"),
    ],
    residue: "the reclaim units are modeled as reconciled members with managed paths; the SCHEDULE itself -- cadence and catch-up-after-downtime -- is carried in the timer and not derived from anything" as NonEmptyStr
  }
)

// ROW 39. Staggering scheduled work across hosts. Small, and it is the fact that stops fleet-wide
// maintenance from becoming a fleet-wide outage.
data fact_reclaim_stagger: CtrlHostFact = ctrl_host_fact(
  subject: ctrl_runner_reclaim_timer,
  about: "randomizing the trigger so hosts do not perform maintenance in lockstep",
  standing: LoadBearing { failure: "a calendar schedule fires at the same instant on every host, so scheduled maintenance takes disk bandwidth away from CI on the whole fleet simultaneously rather than on one host at a time" as NonEmptyStr },
  join: Unowned {
    reason: NoCarrierAuthored {
      nearest: [
        decl_ref(module_path: "gunbc.fleet_converge_timer", decl_name: "fleet_converge_timer_randomized_delay"),
      ],
      why_none_fits: "the fleet has a converge timer, so scheduled fleet work is a modeled concept; that concurrent scheduled work across hosts must be deliberately desynchronized is not stated anywhere" as NonEmptyStr
    }
  }
)

// ROW 40. Continuous replication of the control plane's database. IN THE DIRECTORY, NOT IN SCOPE --
// and saying so precisely is the point of the row.
data fact_dashboard_db_replication: CtrlHostFact = ctrl_host_fact(
  subject: ctrl_litestream_unit,
  about: "continuously replicating the control plane's database to shared object storage so a survivor can be promoted with near-current state",
  standing: LoadBearing { failure: "without it a host death loses the control plane's state back to its last manual copy; with it, a survivor restores to seconds ago" as NonEmptyStr },
  join: Unowned {
    reason: DashboardControlPlane {
      why_out_of_scope: "this replicates the SESSION DASHBOARD's database and runs on the dashboard host, not on a runner host. It sits in the same directory as runner provisioning purely because that directory is where host-level units were collected, which is a filing convention rather than a boundary. gunbc contains no reference to it at all, which is correct: the dashboard is frozen and gets its own program, and the replacement migration must delete this row's subject NOWHERE -- moving it out of host/ is a filing fix, not a migration step" as NonEmptyStr
    }
  }
)

// ROW 41. The single-writer rule that makes the replication above correct, and the reason its
// replica path must be shared rather than per-host.
data fact_replication_single_writer: CtrlHostFact = ctrl_host_fact(
  subject: litestream_yml_template,
  about: "exactly one node replicating a logical database at a time, into a path shared across hosts rather than one per host",
  standing: LoadBearing { failure: "two nodes replicating one database interleave their write-ahead streams and corrupt the replica; per-host replica paths break promotion entirely, because a survivor has no leader replica to restore from" as NonEmptyStr },
  join: Unowned {
    reason: DashboardControlPlane {
      why_out_of_scope: "same subject as row 40. Recorded separately because it is the fact most likely to be lost if that unit is ever relocated by someone treating it as a file move: the correctness constraint lives in the configuration template, not in the unit" as NonEmptyStr
    }
  }
)

// ROW 42. Installing inert by default, so a unit can be deployed before the resource it depends on
// exists. Shared by the replication and the shared cache backend, and a genuinely good pattern.
data fact_inert_until_configured: CtrlHostFact = ctrl_host_fact(
  subject: install_ctrl_litestream_sh,
  about: "installing a service in a state where it is deployed, supervised and doing nothing, until the external resource it needs is configured",
  standing: LoadBearing { failure: "the alternative is ordering deployment against resource creation across a fleet; installing inert makes the two independent, and the arm that would be dangerous -- appearing configured while shipping nothing -- is closed separately by the verification in row 33" as NonEmptyStr },
  join: PartiallyOwned {
    authorities: [
      decl_ref(module_path: "gunbc.build_cache_unit", decl_name: "absent_capacity_omits_the_line_note"),
      decl_ref(module_path: "gunbc.build_cache_ensure", decl_name: "placement_already_converged"),
    ],
    residue: "gunbc has the adjacent discipline -- an absent capacity omits its directive rather than rendering a default -- which is the same refusal to fabricate; INERT AS A DECLARED STATE, distinct from both configured and unconfigured, is not a state any modeled instance can be in" as NonEmptyStr
  }
)

// ROW 43. Separating secret material from non-secret configuration by FILE PERMISSION, not by
// convention. Two files because they have different readerships.
data fact_secret_config_separation: CtrlHostFact = ctrl_host_fact(
  subject: install_ctrl_sccache_sh,
  about: "splitting a service's configuration into a readable file of knobs and a restricted file of credentials, composed by the supervisor",
  standing: LoadBearing { failure: "one file means either the knobs are unreadable to operators or the credentials are world-readable; and the composition ORDER matters, since the wrong order lets a default override an operator's value" as NonEmptyStr },
  join: PartiallyOwned {
    authorities: [
      decl_ref(module_path: "gunbc.build_cache_unit", decl_name: "capacity_env_directives"),
      decl_ref(module_path: "gunbc.systemd_directive_value_grain", decl_name: "build_cache_environment_variables"),
    ],
    residue: "environment directives are modeled and their value grain is typed; that a value's SENSITIVITY determines which file carries it, and that the resulting files compose in a defined order, is not modeled -- the same Secret-versus-plain distinction DESIGN records the gcp credential repair as needing" as NonEmptyStr
  }
)

// ROW 44. Preserving operator edits across re-installs by creating configuration only when absent.
data fact_operator_edits_survive: CtrlHostFact = ctrl_host_fact(
  subject: install_ctrl_jobserver_sh,
  about: "seeding an operator-editable configuration file only when it does not exist, so a re-install never discards a tuning",
  standing: LoadBearing { failure: "an unconditional write silently reverts every operator override on the next deploy, and because the deploy is automatic the revert has no author and no notification" as NonEmptyStr },
  join: Unowned {
    reason: NoCarrierAuthored {
      nearest: [
        decl_ref(module_path: "gunbc.runner_slot_provision", decl_name: "runner_slot_member_ownership"),
        decl_ref(module_path: "gunbc.runner_disk_reclaim", decl_name: "reclaim_path_is_managed"),
      ],
      why_none_fits: "gunbc models which paths a reconcile OWNS, which is the right shape for this; no subject declares a path as operator-owned-once-seeded, so the distinction between a managed file and a seeded one has no spelling" as NonEmptyStr
    }
  }
)

// ROW 45. Per-host capacity and identity overrides kept out of committed configuration.
data fact_node_overrides: CtrlHostFact = ctrl_host_fact(
  subject: node_overrides_example,
  about: "per-host addresses, identity, sizing and concurrency caps supplied as deployment-local overrides rather than committed values",
  standing: Incidental { why: "the SEPARATION exists because the committed file is a portable schema in a repo that others may clone; gunbc has no such constraint -- it commits its host rows directly, with measured addresses and derived widths, which is strictly better than an example file an operator copies and edits" as NonEmptyStr },
  join: Owned {
    authorities: [
      decl_ref(module_path: "gunbc.runner_host_deploy", decl_name: "fleet_runner_host_deploys"),
      decl_ref(module_path: "gunbc.fleet_intent_network", decl_name: "fleet_intent_network"),
      decl_ref(module_path: "gunbc.runner_slot_allocation", decl_name: "gunbc_runner_slots_per_host"),
      decl_ref(module_path: "gunbc.ci_runner_placement", decl_name: "runner_deployment_plan"),
    ]
  }
)

// ROW 46. The typo guard on that override file: an override naming a host that does not exist
// throws rather than being ignored. Kept because it is the one genuinely load-bearing line in an
// otherwise incidental file.
data fact_override_typo_guard: CtrlHostFact = ctrl_host_fact(
  subject: node_overrides_example,
  about: "refusing an override that names a host with no committed counterpart, rather than silently ignoring it",
  standing: LoadBearing { failure: "a mistyped host name in an override is otherwise inert: the operator believes they have configured a host and the system uses defaults for it, which is the empty-observation narrow -- the configuration was expressed and read as nothing" as NonEmptyStr },
  join: Owned {
    authorities: [
      decl_ref(module_path: "gunbc.runner_host_deploy", decl_name: "RunnerHostDeployResolution"),
      decl_ref(module_path: "gunbc.runner_host_deploy", decl_name: "runner_host_deploy_for_refuses_note"),
      decl_ref(module_path: "gunbc.runner_slot_allocation", decl_name: "gunbc_runner_slots_per_host_unknown_note"),
    ]
  }
)

// ROW 47. THE KEY EXISTS IN TWO PLACES THAT CANNOT BE DERIVED FROM EACH OTHER, and a rotation must
// update both or half the system stalls.
data fact_two_copy_secret_model: CtrlHostFact = ctrl_host_fact(
  subject: host_readme,
  about: "the same credential necessarily existing in two places -- a file our own hosts read, and a value only the upstream provider can hold -- so a rotation is not complete until both are updated",
  standing: LoadBearing { failure: "the two cannot be derived from each other because the provider's copy cannot be read back; they drifted independently before this was written down, and that drift is the 2026-05-29 stall. A half-rotation stalls either every runner or every workflow, and which half is not obvious from the symptom" as NonEmptyStr },
  join: PartiallyOwned {
    authorities: [
      decl_ref(module_path: "gunbc.auth.github_apps", decl_name: "ManagedGitHubAppKey"),
      decl_ref(module_path: "gunbc.auth.github_apps", decl_name: "ManagedGitHubAppKeyRole"),
      decl_ref(module_path: "gunbc.auth.github_apps", decl_name: "signer_seals_app"),
    ],
    residue: "gunbc models the key by ROLE and can check that a live signer seals the declared app, which is stronger than the runbook -- but it models one key with one custody, not the same secret held in N places that must be updated together, so a rotation that updates one and not the other is not representable as an inconsistency" as NonEmptyStr
  }
)

// ROW 48. The rotation procedure itself: an ordered sequence a human performs, ending in a
// verification against an independent read.
data fact_rotation_runbook: CtrlHostFact = ctrl_host_fact(
  subject: host_readme,
  about: "the ordered procedure for rotating the credential, ending in a check of the hosts' own logs rather than of what was just written",
  standing: Incidental { why: "the ORDERING and the independent verification are real requirements, and they are captured by rows 47 and 14 as properties. What is incidental is the runbook FORM: a numbered list a human follows exists because there was no actuator, and re-deriving it as a document would be committing manual application as source" as NonEmptyStr },
  join: Unowned {
    reason: NoCarrierAuthored {
      nearest: [
        decl_ref(module_path: "gunbc.auth.github_apps", decl_name: "GitHubAppNextAction"),
        decl_ref(module_path: "gunbc.auth.github_apps", decl_name: "control_plane_next_action"),
      ],
      why_none_fits: "gunbc already derives the NEXT ACTION for the app control plane and names who owns it, which is the right shape for this and does not yet cover key rotation across the two copies of row 47" as NonEmptyStr
    }
  }
)

// ROW 49. Diagnosing a stalled fleet from the runner side.
data fact_stall_diagnosis: CtrlHostFact = ctrl_host_fact(
  subject: host_readme,
  about: "reading a host's own runner state to distinguish a stale credential from an absent runner when nothing is being picked up",
  standing: LoadBearing { failure: "every cause of nothing-being-picked-up presents identically from the workflow side; without a host-side read the operator cannot tell a 401 from an unprovisioned host from a drained pool, and the remedies are entirely different" as NonEmptyStr },
  join: PartiallyOwned {
    authorities: [
      decl_ref(module_path: "gunbc.runner_lifecycle", decl_name: "RunnerLocalStateObservation"),
      decl_ref(module_path: "gunbc.runner_lifecycle", decl_name: "GitHubRunnerRegistrationObservation"),
      decl_ref(module_path: "gunbc.runner_capacity_plan", decl_name: "runner_capacity_plan_authority_note"),
    ],
    residue: "both sides are modeled as observations -- what the host has and what the org holds -- and the capacity plan reconciles them; the CREDENTIAL cause specifically has no observation, so a stale key is diagnosed by reading a log line" as NonEmptyStr
  }
)

// ROW 50. The containerized-CI design, and why it is a decision rather than a behaviour.
//
// The design is worth reading and its two decisions are settled, but half of it targets a workflow
// and a guard job that were both DELETED in the 2026-08-15 floor cut, so its second stage cannot
// be restored, only re-derived. Its first stage is code-complete and now deployed and validated on
// srv1, which is what rows 16 and 17 are about.
data fact_containerized_ci_design: CtrlHostFact = ctrl_host_fact(
  subject: rootless_docker_ci_plan,
  about: "the design for running each CI job body in a fresh container so jobs are stateless and individually capped",
  standing: Incidental { why: "a design document is not a behaviour to preserve. Its two decisions ARE facts and both are already carried: the host-enforced pool cap is row 17 and the per-job cap belongs to whatever replaces the deleted workflow. What is incidental is the document, and it is additionally stale where it targets a workflow and an adversarial guard job the floor cut deleted on 2026-08-15" as NonEmptyStr },
  join: Unowned {
    reason: DesignNotBuilt {
      doc: "ROOTLESS_DOCKER_CI_PLAN.md" as NonEmptyStr,
      status: "stage one is code-complete, deployed and validated on srv1 2026-08-26 (rows 16, 17); stage two targeted ci.yml and its infra_isolation guard, both deleted by the floor cut, so it must be re-derived rather than restored" as NonEmptyStr
    }
  }
)

// ROW 51. THE GUARD THAT MADE THE DE-PRIVILEGE CLAIM CHECKABLE, and it is gone.
//
// This is the row a file-shaped census would not produce, because its subject is described in
// host/ and lived outside it. The design's whole argument for choosing a rootless engine is that
// an adversarial job in the workflow FAILS CI CLOSED if the runner is re-privileged -- it asserts
// the job user holds no privileged group and cannot reach the system socket. That guard was in
// the deleted workflow. So the de-privilege posture rows 9, 10, 15 and 19 protect currently has no
// executing evidence anywhere: it is enforced by an installer's refusals at provisioning time and
// checked by nothing at job time.
data fact_isolation_guard_absent: CtrlHostFact = ctrl_host_fact(
  subject: rootless_docker_ci_plan,
  about: "the adversarial job-time check that the runner is still de-privileged, which failed CI closed if it was not",
  standing: LoadBearing { failure: "without it, every claim in this surface about jobs being unprivileged is a provisioning-time assertion with no job-time evidence -- a host that drifted, as srv1's unit did in row 2, would run privileged jobs and nothing would say so" as NonEmptyStr },
  join: Unowned {
    reason: NoCarrierAuthored {
      nearest: [
        decl_ref(module_path: "product.fabric.isolation", decl_name: "current_runner_slot_profile"),
        decl_ref(module_path: "gunbc.fleet_posix_accounts", decl_name: "fleet_posix_ci_runner_sudo_grants"),
      ],
      why_none_fits: "gunbc models isolation as a class and models the runner principal's grants, so the intended posture is stated; nothing executes a check that the live job matches it. The replacement owes this a job-time witness, not another declaration" as NonEmptyStr
    }
  }
)

// ROW 52. YIELDING TO LIVE WORK. Maintenance that competes with CI for CPU and disk is maintenance
// that presents as CI being slow, so the reclaimer runs at the lowest scheduling priority and in
// the idle I/O class. Authored against the SERVICE rather than the timer because it is a property
// of how the work runs, not of when it starts -- a distinction the shell makes correctly and a
// re-derivation is likely to collapse into one "scheduling" concept.
data fact_reclaim_yields_to_live_work: CtrlHostFact = ctrl_host_fact(
  subject: ctrl_runner_reclaim_unit,
  about: "running reclaim at the lowest CPU priority and in the idle I/O class, so it consumes only what live CI is not using",
  standing: LoadBearing { failure: "a repack is disk-bound and a runner host's disk is the resource CI is already contending for; unprioritized, the maintenance that exists to keep builds working is the thing that makes them slow, and it does so on a schedule nobody correlates with" as NonEmptyStr },
  join: Unowned {
    reason: NoCarrierAuthored {
      nearest: [
        decl_ref(module_path: "gunbc.runner_disk_reclaim", decl_name: "ReclaimOperation"),
        decl_ref(module_path: "gunbc.host_disk_reclaim", decl_name: "reclaim_parameters_note"),
      ],
      why_none_fits: "the reclaim operations and their bounding parameters are modeled -- what to do and how far to go -- but not the PRIORITY at which any modeled effect executes. No host effect anywhere carries a notion of yielding to live work, so this would be a new axis rather than a missing row" as NonEmptyStr
    }
  }
)

// ROW 53. NOT BLOCKING THE LOAD-BEARING PATH ON THE MAINTENANCE PATH. The fan-out installs the
// reclaimer AFTER runner provisioning and treats its failure as a warning, deliberately: a host
// without the reclaimer keeps the pre-existing posture and still serves CI, whereas a host without
// runners serves nothing.
//
// This is a criticality ORDERING between two provisioning steps, and it is exactly the kind of
// fact that survives as a comment in shell and evaporates in a re-derivation, because a modeled
// converge naturally wants every step to be equally load-bearing.
data fact_maintenance_install_is_not_load_bearing: CtrlHostFact = ctrl_host_fact(
  subject: install_runner_reclaim_sh,
  about: "installing the maintenance path after the serving path and refusing to let its failure block provisioning",
  standing: LoadBearing { failure: "inverting it is worse than it sounds: a fleet-wide reclaimer install failure would abort runner provisioning on every host, so a defect in bounded disk maintenance becomes a total CI outage -- a maintenance component taking down the thing it maintains" as NonEmptyStr },
  join: Unowned {
    reason: NoCarrierAuthored {
      nearest: [
        decl_ref(module_path: "gunbc.runner_lifecycle", decl_name: "runner_slot_add_steps_ordered"),
        decl_ref(module_path: "gunbc.runner_lifecycle", decl_name: "runner_slot_caps_precede_start"),
        decl_ref(module_path: "gunbc.runner_disk_reclaim", decl_name: "reclaim_member_ownership"),
      ],
      why_none_fits: "gunbc models step ORDER within slot provisioning and even proves that caps precede start, which is the right shape; every ordering it carries is a prerequisite ordering, where a failed earlier step must stop the later one. The inverse -- a later step whose failure must NOT stop anything -- has no spelling, and expressing it as an ordering alone would get it backwards" as NonEmptyStr
    }
  }
)

data ctrl_host_facts: List<CtrlHostFact> = [
  fact_unit_identity,
  fact_unit_ordering_drift,
  fact_per_slot_tasks_max,
  fact_runner_labels,
  fact_jobserver_env_coupling,
  fact_github_app_identity,
  fact_ephemeral_cycle,
  fact_jit_registration,
  fact_privilege_drop,
  fact_depriv_refusal,
  fact_unit_render_and_validate,
  fact_runner_slice_cap,
  fact_live_cap_apply,
  fact_app_key_install,
  fact_job_user_provision,
  fact_rootless_container_runtime,
  fact_job_user_slice_cap,
  fact_isolated_ci_cache,
  fact_depriv_dropin,
  fact_installer_idempotence,
  fact_ci_os_packages,
  fact_fleet_fanout_roster,
  fact_secret_materialization,
  fact_depriv_default_is_safe,
  fact_jobserver_token_derivation,
  fact_jobserver_fifo_lifecycle,
  fact_jobserver_leak_bound,
  fact_jobserver_hardening,
  fact_post_start_readiness_probe,
  fact_probe_reads_effective_config,
  fact_build_cache_server,
  fact_cache_confinement_exclusions,
  fact_cache_backend_verification,
  fact_backend_classification_discipline,
  fact_bounded_disk_reclaim,
  fact_review_store_heal,
  fact_reclaim_runs_as_owner,
  fact_reclaim_schedule,
  fact_reclaim_stagger,
  fact_dashboard_db_replication,
  fact_replication_single_writer,
  fact_inert_until_configured,
  fact_secret_config_separation,
  fact_operator_edits_survive,
  fact_node_overrides,
  fact_override_typo_guard,
  fact_two_copy_secret_model,
  fact_rotation_runbook,
  fact_stall_diagnosis,
  fact_containerized_ci_design,
  fact_isolation_guard_absent,
  fact_reclaim_yields_to_live_work,
  fact_maintenance_install_is_not_load_bearing,
]

fn fact_is_load_bearing(f: CtrlHostFact) -> Bool {
  match f.standing {
    LoadBearing { failure: _ } => true
    Incidental { why: _ } => false
  }
}

fn fact_is_unowned(f: CtrlHostFact) -> Bool {
  match f.join {
    Owned { authorities: _ } => false
    PartiallyOwned { authorities: _, residue: _ } => false
    Unowned { reason: _ } => true
  }
}

fn fact_is_fully_owned(f: CtrlHostFact) -> Bool {
  match f.join {
    Owned { authorities: _ } => true
    PartiallyOwned { authorities: _, residue: _ } => false
    Unowned { reason: _ } => false
  }
}

fn fact_authorities(f: CtrlHostFact) -> List<DeclarationRef> {
  match f.join {
    Owned { authorities: a } => a
    PartiallyOwned { authorities: a, residue: _ } => a
    Unowned { reason: r } =>
      match r {
        NoCarrierAuthored { nearest: n, why_none_fits: _ } => n
        UpstreamProductSurface { upstream: u, why_not_ours: _ } => [u]
        DesignNotBuilt { doc: _, status: _ } => []
        DashboardControlPlane { why_out_of_scope: _ } => []
      }
  }
}

fn fact_is_out_of_migration_scope(f: CtrlHostFact) -> Bool {
  match f.join {
    Owned { authorities: _ } => false
    PartiallyOwned { authorities: _, residue: _ } => false
    Unowned { reason: r } =>
      match r {
        NoCarrierAuthored { nearest: _, why_none_fits: _ } => false
        UpstreamProductSurface { upstream: _, why_not_ours: _ } => false
        DesignNotBuilt { doc: _, status: _ } => false
        DashboardControlPlane { why_out_of_scope: _ } => true
      }
  }
}

// THE ANSWER THE MIGRATION ACTUALLY NEEDS, AND IT IS A PROJECTION RATHER THAN A ROSTER.
//
// The replacement does not owe 2917 lines and it does not owe 51 rows. It owes the facts that are
// LOAD-BEARING and that gunbc does not already answer -- everything else is either already carried,
// or is a line that exists because bash had no better way to say it. Deriving this rather than
// authoring it is the point: a hand-kept "what is left" list is the parallel ledger the exemplar
// census recorded going stale, and this one cannot, because changing a row's standing or its join
// moves it in or out here by construction.
fn ctrl_host_migration_scope() -> List<CtrlHostFact> {
  filter(ctrl_host_facts, f => fact_is_load_bearing(f: f) && fact_is_unowned(f: f) && !fact_is_out_of_migration_scope(f: f))
}

fn ctrl_host_partial_scope() -> List<CtrlHostFact> {
  filter(ctrl_host_facts, f => match f.join {
    Owned { authorities: _ } => false
    PartiallyOwned { authorities: _, residue: _ } => true
    Unowned { reason: _ } => false
  })
}

fn ctrl_host_incidental_facts() -> List<CtrlHostFact> {
  filter(ctrl_host_facts, f => !fact_is_load_bearing(f: f))
}

fn ctrl_host_fully_owned_facts() -> List<CtrlHostFact> {
  filter(ctrl_host_facts, f => fact_is_fully_owned(f: f))
}

// COVERAGE IS AN IDENTITY JOIN, NOT A COUNT. DESIGN §5 rules out a completeness claim expressed as
// count equality, and the reason bites here exactly: 51 rows over 19 files says nothing about
// whether some file contributed zero. This asks, per file, whether any row names it -- so a file
// that was read and produced no fact is a visible hole rather than an invisible one.
fn file_has_a_fact(s: CtrlHostSubject) -> Bool {
  any(ctrl_host_facts, f => f.subject.path == s.path)
}

fn ctrl_host_files_without_facts() -> List<CtrlHostSubject> {
  filter(ctrl_host_surface_files, s => !file_has_a_fact(s: s))
}

// THE SCOPE QUESTION THE BRIEF ASKED THIS CENSUS TO SETTLE, and it is a real question rather than
// a formality: host/ is a DIRECTORY, and a directory is a filing convention. Whether it is also the
// runner-provisioning BOUNDARY is decided by what reaches in and out of it, not by what is filed
// there -- which is the same distinction rows 40 and 41 record from the other direction, where two
// files sit inside host/ and belong to the frozen control plane.
//
// The deciding test is not the file's name. Three of the four candidates carry "runner" in their
// name and only one of them provisions anything.
type OutsideHostDirVerdict
  = RunnerProvisioning { why: NonEmptyStr }
  | FrozenControlPlane { why: NonEmptyStr }

type OutsideHostDirCandidate {
  path: NonEmptyStr
  lines: Int
  verdict: OutsideHostDirVerdict
}

// IN SCOPE, and it is the one that would have been missed. This is the only thing that AUTOMATICALLY
// runs host provisioning: it hashes the payload host/'s fan-out ships and re-deploys any host whose
// last-deployed hash differs. Without it, provisioning happens exactly when a human remembers --
// which is the gap it was written to close, after a fix merged and sat undeployed for five days
// while the defect it fixed kept firing.
//
// It also carries a §3 fork worth naming before it is inherited: its own list of the provisioning
// files is a hand-kept mirror of the fan-out wrapper's list, with a comment asking the reader to
// keep the two in sync. Two authorings of one fact, and the failure is silent in both directions --
// miss a file and a change never reaches the hosts, add one the wrapper never ships and every host
// redeploys forever. The replacement should derive the trigger from the payload, not restate it.
data outside_runner_host_reconcile: OutsideHostDirCandidate = OutsideHostDirCandidate {
  path: "scripts/session-dashboard/lib/runner_host_reconcile.mjs" as NonEmptyStr,
  lines: 188,
  verdict: RunnerProvisioning {
    why: "the automatic trigger for the host/ fan-out: it hashes the provisioning payload and redeploys hosts whose deployed hash is stale. Deleting host/ without owning this leaves an orphaned actuator, and re-deriving host/ without it means provisioning only ever runs by hand. Carries a hand-mirrored copy of the payload file list -- one fact authored twice, drifting silently either way" as NonEmptyStr
  },
}

// OUT. It reads the upstream provider's runner registrations and buckets them per host for display.
// It provisions nothing and mutates no host. gunbc already models the same read as a typed
// observation and reconciles it against desired slots, so the capability is not lost with it.
data outside_runner_health: OutsideHostDirCandidate = OutsideHostDirCandidate {
  path: "scripts/session-dashboard/lib/runner_health.mjs" as NonEmptyStr,
  lines: 224,
  verdict: FrozenControlPlane {
    why: "a read-only observability probe of the org's runner registrations for the dashboard UI; it changes nothing on any host. The equivalent read is already modeled as GitHubRunnerRegistrationObservation and consumed by the capacity plan, so this is duplicated read rather than unowned provisioning" as NonEmptyStr
  },
}

// OUT, and the name is the trap. Its "runner" is the thing that RUNS a modeling-coherence check on
// a pull-request head; it has no relationship to a GitHub Actions runner or to any host. Recorded
// rather than silently dropped, because a name-based sweep for runner provisioning finds it and a
// reader who trusts that sweep would either migrate it or conclude the census missed it.
data outside_coherence_runner: OutsideHostDirCandidate = OutsideHostDirCandidate {
  path: "scripts/session-dashboard/lib/coherence_runner.mjs" as NonEmptyStr,
  lines: 129,
  verdict: FrozenControlPlane {
    why: "the per-head modeling-coherence check producer for the review gate; 'runner' here names the thing that runs a check, not a build host. Zero reach into host provisioning" as NonEmptyStr
  },
}

// OUT. It grants a live SESSION container reach to the hosts by copying the orchestrator's own
// credentials into it. That is session substrate, not host provisioning: it configures a client,
// never a host.
data outside_grant_host_reach: OutsideHostDirCandidate = OutsideHostDirCandidate {
  path: "scripts/session-dashboard/lib/grant_host_reach.mjs" as NonEmptyStr,
  lines: 238,
  verdict: FrozenControlPlane {
    why: "grants a running session container the credentials to reach srv1/srv2; it mutates a container, never a host. 'host' in its name is the reach TARGET, not its subject" as NonEmptyStr
  },
}

data ctrl_outside_host_dir_candidates: List<OutsideHostDirCandidate> = [
  outside_runner_host_reconcile,
  outside_runner_health,
  outside_coherence_runner,
  outside_grant_host_reach,
]

fn candidate_is_in_scope(c: OutsideHostDirCandidate) -> Bool {
  match c.verdict {
    RunnerProvisioning { why: _ } => true
    FrozenControlPlane { why: _ } => false
  }
}

fn ctrl_provisioning_outside_host_dir() -> List<OutsideHostDirCandidate> {
  filter(ctrl_outside_host_dir_candidates, c => candidate_is_in_scope(c: c))
}

// SO THE DIRECTORY IS NOT THE BOUNDARY, IN BOTH DIRECTIONS AT ONCE, and that is this census's
// answer to the question it was asked to settle. One file outside host/ is runner provisioning and
// three are not; two files inside host/ are frozen control plane and not provisioning at all. A
// migration scoped as "delete this directory" would therefore both orphan an actuator and delete
// the control plane's replication -- two errors in opposite directions from one filing assumption.
data ctrl_host_dir_is_not_the_boundary_note: String = "IN, outside the directory: lib/runner_host_reconcile.mjs, the only automatic trigger for the fan-out. OUT, inside the directory: ctrl-litestream.service and litestream.yml.template, which replicate the dashboard database and belong to the frozen program. The provisioning boundary is what reaches a runner host, and it crosses the directory in both directions."
