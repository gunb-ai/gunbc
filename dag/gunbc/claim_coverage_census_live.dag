module gunbc.claim_coverage_census_live

import std.types { String, List }
import std.process { ExitSuccess, ExitFailure }
import gunbc.cli_wire { CliWireResponse, CliWirePrintable }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import v2.workflow.floor2_prepared_subject { WitnessIdentity, witness_identity_qualified_name }
import v2.workflow.local_repo_wet_terminal { local_repo_wet_schedule }
import gunbc.witness.compiler_gate_workflow { compiler_gate_required_job_id }
import gunbc.claim_coverage_census {
  ClaimSource, ClaimExecutorSubject, ExecutesNoClaims, ClaimExecutorRow, ClaimCoverageInputs,
  ClaimCoverageHeld, ClaimCoverageDidNotHold,
  claim_coverage, claim_coverage_standing, claim_coverage_receipt_lines,
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// THE SOURCE ROSTER. A further source of enrolled claims is a row here.
//
// `local_repo_wet_schedule` is the wet claim lane's roster. Its enrolled identities are read from
// the schedule itself, so a claim added to it joins this census with no edit here. The drop that
// declares its non-execution is gunbc.rung_drop v1_required_lanes_withdrawn (member 1 names this
// instrument as the population's enumerator).
fn claim_sources() -> List<ClaimSource> {
  [
    ClaimSource {
      source_id: "local_repo_wet_schedule",
      enrolled: local_repo_wet_schedule() |> map(c => witness_identity_qualified_name(identity: c.identity)),
      declaring_drop: "v1_required_lanes_withdrawn"
    }
  ]
}

// THE EXECUTOR ROSTER: the required job and the claim subjects its steps execute. `witnesses` emits
// and builds two products and runs `gunbc test` over their instruments; no step runs a scheduled
// claim, so its subject is ExecutesNoClaims. The row that restores the wet lane's execution is an
// ExecutesScheduleOf subject here (trigger of v1_required_lanes_withdrawn: the native binary
// executes the schedule on a required job with its host effects bounded).
fn claim_executors() -> List<ClaimExecutorRow> {
  [
    ClaimExecutorRow {
      job_id: compiler_gate_required_job_id,
      subjects: [ExecutesNoClaims { reason: "emits and builds the self-host and v2-native-cli products and runs their instruments; no step executes a scheduled claim" }]
    }
  ]
}

// `gunbc test //gunbc/instruments:claim-coverage-census`: 0 every enrolled claim is executed by a
// required job; 1 the uncovered population is nonempty (printed above the exit by identity, each
// tagged with its declaring drop or UNDECLARED).
fn claim_coverage_census_exit() -> CliWireResponse {
  let c = claim_coverage(inputs: ClaimCoverageInputs { sources: claim_sources(), jobs: claim_executors() })
  let bytes = concat(claim_coverage_receipt_lines(c: c) |> join(separator: "\n"), "\n")
  match claim_coverage_standing(c: c) {
    ClaimCoverageHeld => CliWirePrintable { bytes: bytes, exit: ExitSuccess }
    ClaimCoverageDidNotHold { uncovered: u } =>
      CliWirePrintable { bytes: bytes, exit: ExitFailure { code: 1, reason: concat("claim-coverage-census: did not hold: ", concat(to_string(u |> count), " enrolled claims are executed by no required job (listed above by identity)")) } }
  }
}
