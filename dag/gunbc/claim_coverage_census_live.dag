module gunbc.claim_coverage_census_live

import std.types { String, List, Int }
import std.algebra { is_empty }
import std.process { ExitSuccess, ExitFailure }
import gunbc.cli_wire { CliWireResponse, CliWirePrintable }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import v2.workflow.floor2_prepared_subject { WitnessIdentity, witness_identity_qualified_name }
import v2.workflow.local_repo_wet_terminal { local_repo_wet_schedule }
import std.optional { Absent, Present }
import gunbc.rung_drop.v1_required_lanes_withdrawn { v1_required_lanes_withdrawn }
import gunbc.emitted_subject_build_gate { emitted_subject_build_rows, emitted_subject_build_label_text }
import gunbc.witness.compiler_gate_workflow { compiler_gate_required_job_id }
import gunbc.claim_coverage_census {
  ClaimSource, ClaimExecutorRow, ClaimCoverageInputs, UncoveredClaim, ClaimCoverageStanding,
  ClaimCoverageHeld, ClaimCoverageDidNotHold,
  claim_coverage, claim_coverage_standing, claim_coverage_receipt_lines,
}
import v2.workflow.claim_coverage_census_s1_live { s1_compose, s1_head_receipt_line }
import v2.workflow.claim_coverage_census_s1 { s1_block }
import v2.workflow.claim_coverage_census_s1 {
  S1Standing, S1Held, S1DidNotHold, S1Unread,
  s1_exit_code_did_not_hold, s1_exit_code_unread
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// THE SOURCE ROSTER. A further source of enrolled claims is a row here.
//
// `local_repo_wet_schedule` is the wet claim lane's roster. Its enrolled identities are read from
// the schedule itself, so a claim added to it joins this census with no edit here. The drop that
// declares its non-execution is gunbc.rung_drop v1_required_lanes_withdrawn (member 1 names this
// instrument as the population's enumerator).
fn claim_sources() -> List<ClaimSource> {
  [
    ClaimSource {
      source_id: "local_repo_wet_schedule",
      enrolled: local_repo_wet_schedule() |> map(c => witness_identity_qualified_name(identity: c.identity)),
      executed_by_label: Absent,
      declaring_drop: Present { value: v1_required_lanes_withdrawn }
    }
  ]
}

// THE EXECUTOR ROSTER IS READ, NOT AUTHORED: the required job and the instrument labels its steps
// run, from `emitted_subject_build_rows` -- the same rows `gunbc.witness.compiler_gate_workflow`
// renders its `gunbc test` steps from. A step added there joins this census; no edit here. The
// wet schedule's `executed_by_label` is Absent because no instrument executes it; restoring the
// capability (trigger 1a of v1_required_lanes_withdrawn) is a label on that source AND a row there.
fn claim_executors() -> List<ClaimExecutorRow> {
  [
    ClaimExecutorRow {
      job_id: compiler_gate_required_job_id,
      executed_labels: emitted_subject_build_rows() |> map(r => emitted_subject_build_label_text(row: r))
    }
  ]
}

// `gunbc test //gunbc/instruments:claim-coverage-census`: 0 every enrolled claim is executed by a required
// job AND the discovered universe holds; 1 EITHER census printed a finding (each listed above, located), even
// if some input was unread; 2 nothing was found AND the discovered census could not read an input, so no
// population was decided.
//
// THE ONE INSTRUMENT PRINTS TWO CENSUSES (warm-wolf-570's one-instrument ruling: no second label, no
// registry arm). The wet schedule's receipt is stern-raven-457's claim-grain census; the block composed
// below is the DISCOVERED universe (S1) and the standings every other enrolled-claim carrier contributes
// over it. The policy is one pure function over an injected composition
// (`v2.workflow.claim_coverage_census_s1_live s1_block`), so a witness can assert every case over a fixture
// instead of only over whatever the checkout happens to look like.
// THE WET REASON, from the wet census's own sum. A did-not-hold that lists nothing is not a thing this
// census can print, so the wording is a property of the arm rather than a string chosen at the call site.
fn claim_coverage_wet_reason(uncovered: List<UncoveredClaim>) -> String {
  concat(
    "claim-coverage-census: did not hold -- an enrolled claim is executed by no required job (",
    concat(map(uncovered, u => u.identity) |> join(separator: ", "), ")")
  )
}

// THE DECISION THE TWO STANDINGS REACH, BEFORE ANY EXIT NUMBER EXISTS (parent ruling, 2026-10-20, overriding
// warm-wolf-570's earlier "unread outranks a finding": that was wrong by Kleene -- `false AND unknown =
// false`). A DEFINITE finding dominates: if either census found something, the observation definitely did not
// hold, and an unread input elsewhere cannot downgrade that to "unknown". Exit 2 is reserved for the case
// where NOTHING was found and something could not be read -- there, and only there, the census genuinely
// cannot answer. Precedence is therefore 1 > 2 > 0, and it is a decision over a declared sum rather than an
// if-ladder, so the three cases are the only states this function can be in.
//
// WHY A THIRD SUM RATHER THAN A MATCH THAT RETURNS AN INT DIRECTLY: the exit code must be derived from what
// was decided, not chosen beside it. `ComposedCensusStanding` is that decision;
// `claim_coverage_composed_exit_code` is the ONE site that turns it into a protocol number, reusing the
// instrument's constants. So an exit number still cannot be paired with an outcome the censuses did not
// report -- and now it cannot disagree with the OTHER census either, which is what the S1-only derivation
// allowed.
type ComposedCensusStanding
  = ComposedHeld
  | ComposedFinding { reasons: List<String> }
  | ComposedUnread { cause: String }

// THE PRECEDENCE, AS ONE EXHAUSTIVE MATCH OVER TWO SUMS (review 82914 kept: both inputs are declared
// coproducts, nothing is turned into a Bool, no integer is compared). Both censuses naming findings keeps
// BOTH reasons -- either alone would send the reader to the wrong file, and the unread cause is printed here
// too when it accompanies a finding, because an unreadable input is still a located fact the reader has to
// fix even though it does not decide the exit.
fn claim_coverage_composed_standing(wet: ClaimCoverageStanding, s1: S1Standing) -> ComposedCensusStanding {
  let wet_reason = match wet {
    ClaimCoverageHeld => []
    ClaimCoverageDidNotHold { uncovered: uncovered } => [claim_coverage_wet_reason(uncovered: uncovered)]
  }
  let s1_channel = match s1 {
    S1Held => []
    S1DidNotHold { reason: s1_reason } => [s1_reason]
    S1Unread { reason: cause } => []
  }
  let findings = concat(wet_reason, s1_channel)
  if !is_empty(findings) {
    // A finding dominates. With an unread input beside it, the cause travels as a further reason: the exit is
    // already decided by the finding, and the reader still needs to know which input could not be read.
    let unread_note = match s1 {
      S1Unread { reason: cause } => [unread_beside_finding_note(cause: cause)]
      _ => []
    }
    ComposedFinding { reasons: concat(findings, unread_note) }
  } else {
    match s1 {
      // Nothing was found and the discovered census could not read: no observation, exit 2.
      S1Unread { reason: cause } => ComposedUnread { cause: cause }
      _ => ComposedHeld
    }
  }
}

// THE UNREAD CAUSE, SAID AS WHAT IT IS WHEN IT DOES NOT DECIDE. Kept separate from the finding reasons so a
// reader cannot mistake it for a claim finding, and so the exit-2 arm can print the bare cause instead.
fn unread_beside_finding_note(cause: String) -> String {
  concat("an input could not be read (does not change the exit: a finding was found): ", cause)
}

// THE PROCESS PROTOCOL, DERIVED ONCE (dag/gunbc/design_document: "Exit 0 means the observation held, 1 that
// it did not, 2 that there was no observation"). The numbers are the instrument's constants, not chosen here;
// the match is the only place a standing becomes a number.
fn claim_coverage_composed_exit_code(standing: ComposedCensusStanding) -> Int {
  match standing {
    ComposedHeld => 0
    ComposedFinding { reasons: _ } => s1_exit_code_did_not_hold
    ComposedUnread { cause: _ } => s1_exit_code_unread
  }
}

// PURE AND INJECTED, which is the other half of why it is a function: the witness asserts every case over
// fixtures (`src/v2/test/claim/claim_coverage_census_s1_witness.dag`) -- including a finding beside an unread
// input, which is the case whose precedence was wrong -- and, by importing this module, resolves every body
// in it. That import is the reason an unresolvable module can no longer hide behind a green per-file parse
// sweep.
fn claim_coverage_composed_exit(
  bytes: String,
  wet: ClaimCoverageStanding,
  s1: S1Standing
) -> CliWireResponse {
  let standing = claim_coverage_composed_standing(wet: wet, s1: s1)
  match standing {
    ComposedHeld => CliWirePrintable { bytes: bytes, exit: ExitSuccess }
    ComposedUnread { cause: cause } => CliWirePrintable {
      bytes: bytes,
      exit: ExitFailure { code: claim_coverage_composed_exit_code(standing: standing), reason: cause }
    }
    ComposedFinding { reasons: reasons } => CliWirePrintable {
      bytes: bytes,
      exit: ExitFailure {
        code: claim_coverage_composed_exit_code(standing: standing),
        reason: join(reasons, separator: " | ")
      }
    }
  }
}

fn claim_coverage_census_exit() -> CliWireResponse {
  let c = claim_coverage(inputs: ClaimCoverageInputs { sources: claim_sources(), jobs: claim_executors() })
  // THE FOLD, THEN THE BLOCK. Two functions, in the two modules they belong to: `s1_compose` performs the
  // governed-root fold and `s1_block` turns a composition into printable lines plus a standing. This call
  // site read `s1_live_block()` -- a name that has NEVER existed in this module or any earlier commit, in any
  // file -- so the instrument's own entry could not resolve. Nothing noticed, because until this head no
  // claim imported this module: the resolve pass only ever saw files that a per-file sweep happened to parse
  // (the same invisibility the manager's import-the-live-module claim was opened to close, now proven on the
  // entry itself rather than on a helper). The fix composes the two halves that do exist; it does not invent a
  // third function, and the head stays stamped beside the output by this runner, not inside the fold.
  let s1 = s1_block(s1: s1_compose())
  // THE LOCATOR IS STAMPED BESIDE THE OUTPUT BY THIS RUNNER (warm-wolf-570): the census is a pure function
  // of the tree, so the revision is the runner's business. THIS runner has git, so it asks and prints what
  // it got: `S1-CENSUS head:<rev>` from `RevisionRead`, or `S1-CENSUS head UNREADABLE: <cause>` from
  // `RevisionAbsent` -- the typed cause, never a fabricated revision (review 82943 allowed either printing
  // a typed cause or omitting the line; printing it is chosen here because a git that refused IS a finding
  // this receipt should show). Omitting the line is what a runner with NO way to ask does -- the host-native
  // route has no git to run -- and it omits it because the question does not arise there, not because an
  // answer was missing.
  let s1_lines = concat([s1_head_receipt_line()], s1.lines)
  let bytes = concat(
    concat(claim_coverage_receipt_lines(c: c) |> join(separator: "\n"), "\n"),
    concat(s1_lines |> join(separator: "\n"), "\n")
  )
  claim_coverage_composed_exit(
    bytes: bytes,
    wet: claim_coverage_standing(c: c),
    s1: s1.standing
  )
}
