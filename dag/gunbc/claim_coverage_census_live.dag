module gunbc.claim_coverage_census_live

import std.types { String, List }
import std.process { ExitSuccess, ExitFailure }
import gunbc.cli_wire { CliWireResponse, CliWirePrintable }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import v2.workflow.floor2_prepared_subject { WitnessIdentity, witness_identity_qualified_name }
import v2.workflow.local_repo_wet_terminal { local_repo_wet_schedule }
import std.optional { Absent, Present }
import gunbc.rung_drop.v1_required_lanes_withdrawn { v1_required_lanes_withdrawn }
import gunbc.emitted_subject_build_gate { emitted_subject_build_rows, emitted_subject_build_label_text }
import gunbc.witness.compiler_gate_workflow { compiler_gate_required_job_id }
import gunbc.claim_coverage_census {
  ClaimSource, ClaimExecutorRow, ClaimCoverageInputs,
  ClaimCoverageHeld, ClaimCoverageDidNotHold,
  claim_coverage, claim_coverage_standing, claim_coverage_receipt_lines,
}
import gunbc.claim_coverage_census_s1_live { s1_live_block }
import gunbc.claim_coverage_census_s1 { s1_exit_held, s1_exit_did_not_hold, s1_exit_unread }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// THE SOURCE ROSTER. A further source of enrolled claims is a row here.
//
// `local_repo_wet_schedule` is the wet claim lane's roster. Its enrolled identities are read from
// the schedule itself, so a claim added to it joins this census with no edit here. The drop that
// declares its non-execution is gunbc.rung_drop v1_required_lanes_withdrawn (member 1 names this
// instrument as the population's enumerator).
fn claim_sources() -> List<ClaimSource> {
  [
    ClaimSource {
      source_id: "local_repo_wet_schedule",
      enrolled: local_repo_wet_schedule() |> map(c => witness_identity_qualified_name(identity: c.identity)),
      executed_by_label: Absent,
      declaring_drop: Present { value: v1_required_lanes_withdrawn }
    }
  ]
}

// THE EXECUTOR ROSTER IS READ, NOT AUTHORED: the required job and the instrument labels its steps
// run, from `emitted_subject_build_rows` -- the same rows `gunbc.witness.compiler_gate_workflow`
// renders its `gunbc test` steps from. A step added there joins this census; no edit here. The
// wet schedule's `executed_by_label` is Absent because no instrument executes it; restoring the
// capability (trigger 1a of v1_required_lanes_withdrawn) is a label on that source AND a row there.
fn claim_executors() -> List<ClaimExecutorRow> {
  [
    ClaimExecutorRow {
      job_id: compiler_gate_required_job_id,
      executed_labels: emitted_subject_build_rows() |> map(r => emitted_subject_build_label_text(row: r))
    }
  ]
}

// `gunbc test //gunbc/instruments:claim-coverage-census`: 0 every enrolled claim is executed by a
// required job AND the discovered universe holds; 1 either census printed a finding (each listed above,
// located); 2 the discovered census could not read an input, so no population was decided.
//
// THE ONE INSTRUMENT PRINTS TWO CENSUSES (warm-wolf-570's one-instrument ruling: no second label, no
// registry arm). The wet schedule's receipt is stern-raven-457's claim-grain census; the block composed
// below is the DISCOVERED universe (S1) and the standings every other enrolled-claim carrier contributes
// over it. The exits compose by taking the worse, and the unread channel outranks a did-not-hold: a census
// that could not read is not a census that failed, it is a census that cannot answer, and reporting the
// failure would hide which. The policy is one pure function over an injected composition
// (`gunbc.claim_coverage_census_s1_live s1_block`), so a witness can assert all three arms over a fixture
// instead of only over whatever the checkout happens to look like.
fn claim_coverage_census_exit() -> CliWireResponse {
  let c = claim_coverage(inputs: ClaimCoverageInputs { sources: claim_sources(), jobs: claim_executors() })
  let s1 = s1_live_block()
  let bytes = concat(
    concat(claim_coverage_receipt_lines(c: c) |> join(separator: "\n"), "\n"),
    concat(s1.lines |> join(separator: "\n"), "\n")
  )
  if s1.exit_code == s1_exit_unread {
    return CliWirePrintable { bytes: bytes, exit: ExitFailure { code: s1_exit_unread, reason: s1.reason } }
  }
  let wet_holds = match claim_coverage_standing(c: c) {
    ClaimCoverageHeld => true
    ClaimCoverageDidNotHold { uncovered: _ } => false
  }
  if wet_holds && s1.exit_code == s1_exit_held {
    return CliWirePrintable { bytes: bytes, exit: ExitSuccess }
  }
  return CliWirePrintable {
    bytes: bytes,
    exit: ExitFailure {
      code: s1_exit_did_not_hold,
      reason: if !wet_holds {
        "claim-coverage-census: did not hold -- an enrolled claim is executed by no required job, or the discovered universe printed a finding (each listed above, located)"
      } else {
        s1.reason
      }
    }
  }
}
