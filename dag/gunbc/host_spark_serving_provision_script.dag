module gunbc.host_spark_serving_provision_script

import std.dissolution { DissolutionCondition, unbound_dissolution }
import std.types { String, NonEmptyStr, Bool }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.exec.command { shell_quote }
import extdeps.ollama.api { ollama_default_port }
import gunbc.shell_bash_runner { shell_exec_via_bash }
import gunbc.host_layout {
  srv1_gunbc_repo_root,
  srv1_gunbc_serve_binary,
}
import gunbc.spark_serving_install_paths {
  spark_serving_runtime_executable,
  spark_serving_desired_model_wire,
}

data host_spark_serving_gunbc_layout_note: String = "Remote ensure delegates to gunbc run materialize_spark_serving_on_local_host using gunbc.host_layout srv1_gunbc_* rows — fleet-constant /opt/gunbc paths on Spark hosts (codex precedent at host_codex_runtime_provision_script). Observed 2026-08-15 on srv5/srv6: /opt/gunbc/bin/gunbc absent; ensure fails closed until live_deploy carries this member."

fn spark_serving_gunbc_src_v2_root(gunbc_repo: String) -> String {
  concat(gunbc_repo, "/src/v2")
}

data host_spark_serving_provision_script_dissolution_trigger: DissolutionCondition = unbound_dissolution(description: "🟡 dissolve-on: host_spark_serving_provision_script — observe/read-back concat shell plus ensure transport that delegates to gunbc run materialize_spark_serving_on_local_host; DISSOLVES WHEN ProvisionSparkServing reaches host_effect_apply as typed argv rather than a script body (same class as host_codex_runtime_provision_script).")

data host_spark_serving_provision_script_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.host_spark_serving_provision_script",
    decl_name: "host_spark_serving_provision_script_dissolution_trigger",
    field: WholeDeclaration,
  }
}

data host_spark_serving_provision_script_note: String = "Observe/ensure/read-back shell for Spark serving (#8225). Ensure delegates to the single materializer via gunbc run materialize_spark_serving_on_local_host on the target host — the codex precedent (host_codex_runtime_provision_script), not a parallel re-encoded install pipeline. Observe/read-back remain concat shell consumed by spark_serving_provision_apply over FleetSsh ExecPortableWordsWithStdin (sh -s)."

fn spark_serving_observe_body(executable: String, model_wire: String) -> String {
  let executable_q = shell_quote(arg: executable)
  let model_q = shell_quote(arg: model_wire)
  let api_port = to_string(ollama_default_port)
  join([
    "observe_rc=0",
    join(["if [ -x ", executable_q, " ]; then"], " "),
    join(["  if curl -sf http://127.0.0.1:", api_port, "/api/tags | grep -F ", model_q, " >/dev/null; then"], " "),
    "    printf '%s\\n' \"SparkServingProvisionReceipt: observe=ok\"",
    "    exit 0",
    "  fi",
    "fi",
    "printf '%s\\n' \"SparkServingProvisionReceipt: observe=absent\"",
    "observe_rc=127",
    "",
  ], "\n")
}

fn spark_serving_ensure_body(
  gunbc_binary: String,
  gunbc_repo: String,
) -> String {
  let gunbc_binary_q = shell_quote(arg: gunbc_binary)
  let gunbc_repo_q = shell_quote(arg: gunbc_repo)
  let gunbc_src_v2_q = shell_quote(arg: spark_serving_gunbc_src_v2_root(gunbc_repo: gunbc_repo))
  join([
    join([
      "if ! ",
      gunbc_binary_q,
      " run --source-root ",
      gunbc_repo_q,
      " --source-root ",
      gunbc_src_v2_q,
      " --entry dag/gunbc/host_spark_serving_provision.dag --function materialize_spark_serving_on_local_host; then",
      "  printf '%s\\n' \"SparkServingProvisionReceipt: ensure=FAILED\"",
      "  exit 1",
      "fi",
    ], " "),
    "",
  ], "\n")
}

fn spark_serving_read_back_body(executable: String, model_wire: String) -> String {
  let executable_q = shell_quote(arg: executable)
  let model_q = shell_quote(arg: model_wire)
  let api_port = to_string(ollama_default_port)
  join([
    join(["if [ -x ", executable_q, " ]; then"], " "),
    join(["  if curl -sf http://127.0.0.1:", api_port, "/api/tags | grep -F ", model_q, " >/dev/null; then"], " "),
    "    printf '%s\\n' \"SparkServingProvisionReceipt: read_back=ok\"",
    "    exit 0",
    "  fi",
    "fi",
    "printf '%s\\n' \"SparkServingProvisionReceipt: read_back=FAILED\"",
    "exit 1",
    "",
  ], "\n")
}

fn spark_serving_provision_script_body() -> String {
  let executable = spark_serving_runtime_executable() as String
  let model_wire = spark_serving_desired_model_wire()
  join([
    "set -euo pipefail",
    spark_serving_observe_body(executable: executable, model_wire: model_wire),
    "printf '%s\\n' \"SparkServingProvisionReceipt: ensure=starting\"",
    spark_serving_ensure_body(
      gunbc_binary: srv1_gunbc_serve_binary as String,
      gunbc_repo: srv1_gunbc_repo_root as String,
    ),
    spark_serving_read_back_body(executable: executable, model_wire: model_wire),
  ], "\n")
}

fn spark_serving_provision_shell_script() -> String {
  shell_exec_via_bash(body: spark_serving_provision_script_body())
}

fn spark_serving_provision_read_back_fails_closed() -> Bool {
  let body = spark_serving_read_back_body(
    executable: spark_serving_runtime_executable() as String,
    model_wire: spark_serving_desired_model_wire(),
  )
  string_contains(s: body, pattern: "read_back=FAILED")
    && string_contains(s: body, pattern: "exit 1")
}

fn spark_serving_provision_ensure_delegates_to_materializer() -> Bool {
  let body = spark_serving_ensure_body(
    gunbc_binary: srv1_gunbc_serve_binary as String,
    gunbc_repo: srv1_gunbc_repo_root as String,
  )
  string_contains(s: body, pattern: "materialize_spark_serving_on_local_host")
    && string_contains(s: body, pattern: "host_spark_serving_provision.dag")
    && !string_contains(s: body, pattern: "sha256sum -c")
    && !string_contains(s: body, pattern: "tar -I zstd")
}

fn spark_serving_provision_shell_uses_shell_quote_authority() -> Bool {
  let body = spark_serving_provision_script_body()
  string_contains(s: body, pattern: shell_quote(arg: srv1_gunbc_serve_binary as String))
    && string_contains(s: body, pattern: shell_quote(arg: srv1_gunbc_repo_root as String))
}
