data instrument_sandbox_note: String = "THE FIRST V1-DELETION INSTRUMENT, at /sandbox/instrument. Everything on this page is DERIVED from the same authorities the model layer is witnessed against — the four finish lines come from gunbc.v1_deletion_plan, the roles come from the projection rather than from hand-placed classes, the audition verdicts come from the register's own emission and displacement gates, and the impulse matrix is admit_impulse run over every source and every sensor state. Nothing here is a mock, so a page that renders a wrong role is a projection defect and not a styling one. WHAT IS DELIBERATELY ABSENT, named rather than faked: the IDLE half of the physical character — resting jitter, vertical shift, buoyant drift — is modelled, budgeted and witnessed but NOT animated here, because ambient motion has no constructor in this register by design (gunbc.design.material still_until_touched_amendment_note: MotionTrigger carries no ambient variant and no keyframes constructor exists). Emitting raw animation text past that wall would be the unmarked-workaround class the design authority names as a line-stop signal, so the idle channels are shown as their measured budget and the CAUSED half — the impulse glitch on press — is real, built through the ordinary ResponseRule machinery. DISSOLVE-ON: an enclosure-scoped ambient-motion constructor lands with its own admission law, and the idle channels animate through it."

data instrument_sandbox_page_class: String = "instrument-sandbox"
data instrument_frame_class: String = "instrument-frame"
data instrument_row_class: String = "instrument-row"
data instrument_cell_class: String = "instrument-cell"
data instrument_note_class: String = "instrument-note"
data instrument_refusal_class: String = "instrument-refusal"

fn audition_card_class(i: AuditionIntensity) -> String {
  concat("audition-", audition_intensity_key(i: i))
}

fn audition_emission_var(i: AuditionIntensity) -> String {
  concat("instrument-emission-", audition_intensity_key(i: i))
}

data emission_projection_note: String = "An EmissionSpec becomes a two-layer box-shadow: a crisp core near the object and one soft low-alpha corona, which is exactly the shape the emission envelope admits and no more. The colour is the theme's FOCUS material at the spec's own alphas, so the emission is the same hue the register already uses to say 'this one', and it is emitted per theme through the shared theme-selector grammar rather than pinned to one projection — the day/night toggle retunes the glow for free."

fn emission_shadow_value(m: Material, spec: EmissionSpec) -> String {
  join([
    "0 0 ", to_string(spec.core_radius.n), "px ", paint_alpha(m: m, alpha_pct: spec.core_alpha_pct),
    ", 0 0 ", to_string(spec.corona_radius.n), "px ", paint_alpha(m: m, alpha_pct: spec.corona_alpha_pct),
  ], "")
}

fn emission_decl_for(t: Theme, i: AuditionIntensity) -> List<CssDecl> {
  match audition_emission(i: i) {
    AuditionNoEmission => [decl(prop: CustomProperty { name: audition_emission_var(i: i) }, value: "none")]
    AuditionEmits { spec } => [decl(
      prop: CustomProperty { name: audition_emission_var(i: i) },
      value: emission_shadow_value(m: assignment_material(t: t, r: FocusRole), spec: spec),
    )]
  }
}

fn emission_var_decls(t: Theme) -> List<CssDecl> {
  flat_map(audition_intensities, i => emission_decl_for(t: t, i: i))
}

fn instrument_emission_root_css() -> String {
  theme_scoped_blocks(base: day_theme, alternate: night_theme, decls_for: t => emission_var_decls(t: t))
}

fn cls(name: String) -> SelectorSubject {
  ClassSelector { name: name }
}

fn audition_card_rule(i: AuditionIntensity) -> BuildRule {
  StaticRule {
    selector: cls(name: audition_card_class(i: i)),
    decls: [
      decl(prop: BoxShadow, value: concat("var(--", concat(audition_emission_var(i: i), ")"))),
      decl(prop: Border, value: join(["1px solid ", role_var(r: BorderRole)], "")),
      decl(prop: BorderRadius, value: scale_var(t: radius_3)),
      decl(prop: Padding, value: scale_var(t: space_6)),
      decl(prop: Background, value: role_var(r: SurfaceRole)),
      decl(prop: MinWidth, value: "14rem"),
    ],
  }
}

data impulse_press_note: String = "THE CAUSED HALF, BUILT THROUGH THE ORDINARY MACHINERY. Pressing the instrument frame displaces it by the preference's own impulse amplitude and it settles on the glitch duration's timing — a ResponseRule with the OnActive trigger, the same construction every other control in this register uses, so the physical character is not a special case that bypasses the wall. The displacement is negative on the Y axis and read straight off the preference: an author who disables the impulse channel gets a rule that displaces by zero rather than a rule that has to be removed."

fn impulse_translate_value(p: InstrumentPreference) -> String {
  join(["translateY(-", to_string(amplitude_px(a: p.impulse_glitch)), "px)"], "")
}

fn instrument_frame_rule(p: InstrumentPreference) -> BuildRule {
  ResponseRule {
    subject: cls(name: instrument_frame_class),
    shape: SelfResponse,
    trigger: OnActive,
    transition_props: "transform",
    timing: glitch_settle(g: p.glitch_duration),
    base_decls: [
      decl(prop: Border, value: join(["1px solid ", role_var(r: BorderRole)], "")),
      decl(prop: BorderRadius, value: scale_var(t: radius_3)),
      decl(prop: Padding, value: scale_var(t: space_16)),
      decl(prop: Background, value: role_var(r: SurfaceRole)),
      decl(prop: Transform, value: "translateY(0)"),
    ],
    response_decls: [decl(prop: Transform, value: impulse_translate_value(p: p))],
  }
}

fn instrument_layout_rules() -> List<BuildRule> {
  [
    StaticRule {
      selector: cls(name: instrument_row_class),
      decls: [
        decl(prop: Display, value: "flex"),
        decl(prop: Gap, value: scale_var(t: space_6)),
        decl(prop: Margin, value: join([scale_var(t: space_6), " 0"], "")),
      ],
    },
    StaticRule {
      selector: cls(name: instrument_cell_class),
      decls: [
        decl(prop: FontFamily, value: scale_var(t: font_mono)),
        decl(prop: FontSize, value: scale_var(t: text_12)),
        decl(prop: Padding, value: scale_var(t: space_2)),
      ],
    },
    StaticRule {
      selector: cls(name: instrument_note_class),
      decls: [decl(prop: Color, value: role_var(r: TextDimRole))],
    },
    StaticRule {
      selector: cls(name: instrument_refusal_class),
      decls: [
        decl(prop: Color, value: role_var(r: TextRole)),
        decl(prop: Border, value: join(["1px dashed ", role_var(r: BorderRole)], "")),
        decl(prop: Padding, value: scale_var(t: space_2)),
      ],
    },
  ]
}

fn instrument_rules() -> List<BuildRule> {
  concat(
    instrument_layout_rules(),
    concat(
      [instrument_frame_rule(p: preference_default)],
      map(audition_intensities, i => audition_card_rule(i: i))))
}

fn instrument_css() -> String {
  join([roadmap_css(), instrument_emission_root_css(), serialize_rules(rules: instrument_rules())], "\n")
}

fn cell(s: String) -> Fragment {
  el_class("span", instrument_cell_class, [ txt(s) ])
}

fn row(cells: List<Fragment>) -> Fragment {
  el_class("div", instrument_row_class, cells)
}

fn note(s: String) -> Fragment {
  el_class("p", instrument_note_class, [ txt(s) ])
}

data exemplar_note: String = "One camera state is rendered rather than an interactive one, and the subject is a real finish line: the page's job here is to show what each depth and mode PRODUCE, and a server-rendered exemplar shows that without a client program standing between the projection and what you read."

fn exemplar_camera() -> ProgramCamera {
  camera_select(c: camera_initial, f: focus_finish_line(l: CompilerFixedPoint))
}

fn program_depths() -> List<ProgramDepth> { [DepthProgram, DepthOutcome, DepthFront, DepthNode, DepthEvidence] }
fn program_modes() -> List<ProgramMode> { [ModeStatus, ModeRemaining, ModeWhy] }

fn depth_cell(d: ProgramDepth) -> Fragment {
  cell(s: join([to_string(program_depth_index(d: d)), " · ", program_depth_key(d: d)], ""))
}

fn owner_cell(o: StateOwner) -> Fragment {
  cell(s: join([
    state_owner_key(o: o), " — ",
    if owner_may_write_domain_fact(o: o) { "may write domain facts" } else { "presentation only" },
  ], ""))
}

fn camera_section() -> Fragment {
  el("section", concat(
    [
      el("h2", [ txt("semantic camera") ]),
      note(s: "Five depths on one axis, three modes across it. A depth change crosses exactly one detent, and every move carries the selected subject unchanged."),
      row(cells: map(program_depths(), d => depth_cell(d: d))),
      el("h3", [ txt("state ownership") ]),
      note(s: "Only one owner may write a domain fact, and it is not reachable from the instrument."),
      row(cells: map(
        [AuthoritativeProgramView, LocalInstrumentState, InstrumentObservation, RendererEphemera],
        o => owner_cell(o: o))),
    ],
    [ el("h3", [ txt("readings") ]), reading_rows() ]))
}

data reading_render_note: String = "A refusal renders AS a refusal. The Why mode has no rationale carrier to read, so it produces a typed ReadingUnavailable and the page prints the cause — the alternative, printing the claim under a Why heading, would be indistinguishable from an answer and is exactly the fabricated-plausible-output arm this surface exists to make visible."

fn reading_fragment(m: ProgramMode) -> Fragment {
  match read_camera(camera: camera_set_mode(c: exemplar_camera(), m: m), accepted: []) {
    ReadingNoSubject => el_class("div", instrument_refusal_class, [ txt("no subject selected") ])
    ReadingStatus { node, accepted, name } => row(cells: [
      cell(s: program_mode_key(m: m)),
      cell(s: name),
      cell(s: node),
      cell(s: if accepted { "accepted" } else { "not accepted" }),
    ])
    ReadingRemaining { name, claim, accepted } => row(cells: [
      cell(s: program_mode_key(m: m)),
      cell(s: name),
      cell(s: claim),
    ])
    ReadingUnavailable { mode, subject_key, cause } =>
      el_class("div", instrument_refusal_class, [
        txt(join([mode, " · ", subject_key, " — refused: ", cause], "")),
      ])
  }
}

fn reading_rows() -> Fragment {
  el("div", map(program_modes(), m => reading_fragment(m: m)))
}

fn salience_row(assignments: List<SalienceAssignment>, spec: V1FinishLineSpec) -> Fragment {
  let key = v1_finish_line_key(l: spec.line)
  row(cells: [
    cell(s: salience_key(role: assignment_role_for(assignments: assignments, subject: key))),
    cell(s: spec.name),
    cell(s: key),
  ])
}

fn salience_block(label: String, camera: ProgramCamera, refusal: RefusalAggregate) -> Fragment {
  let assignments = project_finish_line_salience(camera: camera, refusal: refusal)
  el("div", concat(
    concat(
      [ el("h3", [ txt(label) ]) ],
      map(v1_exit_finish_lines(), s => salience_row(assignments: assignments, spec: s))),
    [ row(cells: [
        cell(s: salience_key(role: assignment_role_for(assignments: assignments, subject: refusal_subject_key))),
        cell(s: refusal_subject_key),
      ]) ]))
}

fn salience_section() -> Fragment {
  el("section", [
    el("h2", [ txt("focal salience, derived") ]),
    note(s: "No row on this page carries an authored role. The selected subject is Focal, its region siblings are Supporting, everything else is Ground, and an active refusal is one Critical subject however many refuse."),
    salience_block(label: "nothing selected", camera: camera_initial, refusal: NoActiveRefusal),
    salience_block(label: "compiler fixed point selected", camera: exemplar_camera(), refusal: NoActiveRefusal),
    salience_block(
      label: "selected, with three active refusals",
      camera: exemplar_camera(),
      refusal: ActiveRefusals { refused_count: 3 },
    ),
  ])
}

fn audition_verdict_text(a: AuditionAdmission) -> String {
  match a {
    AuditionAdmitted { intensity, emission, attraction, displacement_px } =>
      join(["admitted · enclosure displacement ", to_string(displacement_px), "px"], "")
    AuditionEmissionRefused { intensity, grant } => "refused: emission not admissible at this role"
    AuditionAttractionOutsideEnvelope { intensity } => "refused: attraction outside the envelope"
    AuditionDisplacementOverBudget { intensity, total_px, max_px } =>
      join(["refused: displacement ", to_string(total_px), "px over ", to_string(max_px), "px"], "")
  }
}

fn audition_card(i: AuditionIntensity) -> Fragment {
  let verdict = admit_audition(i: i, role: SalienceFocal, subject_key: "compiler-fixed-point")
  el_class("div", audition_card_class(i: i), [
    el("h3", [ txt(audition_intensity_key(i: i)) ]),
    cell(s: "Compiler fixed point"),
    note(s: audition_verdict_text(a: verdict)),
  ])
}

fn audition_section() -> Fragment {
  el("section", [
    el("h2", [ txt("focal audition — one real subject, three energies") ]),
    note(s: "The same finish line rendered at three grants of the same budget. Restrained is the register before the amendment; hero sits at the emission envelope's admissible maximum, so the comparison shows where the bound actually is."),
    el_class("div", instrument_row_class, map(audition_intensities, i => audition_card(i: i))),
  ])
}

fn channel_row(p: InstrumentPreference, c: InstrumentChannel) -> Fragment {
  row(cells: [
    cell(s: channel_key(c: c)),
    cell(s: join([to_string(amplitude_px(a: channel_amplitude(p: p, c: c))), "px"], "")),
    cell(s: "carries no domain fact"),
  ])
}

fn displacement_text(p: InstrumentPreference) -> String {
  match displacement_admission(p: p) {
    DisplacementAdmitted { total_px } =>
      join([
        "composed displacement ", to_string(total_px), "px, within the ",
        to_string(instrument_displacement_max_px), "px ceiling borrowed from the register's attraction travel",
      ], "")
    DisplacementOverBudget { total_px, max_px } =>
      join(["refused: ", to_string(total_px), "px exceeds ", to_string(max_px), "px"], "")
  }
}

fn impulse_cell(s: PhysicalImpulseSource, a: SensorAvailability) -> Fragment {
  cell(s: join([
    sensor_availability_key(a: a), " → ",
    match admit_impulse(p: preference_default, s: s, sensor: a) {
      ImpulseAdmitted { source, settle } => join(["admitted (", settle.name, ")"], "")
      ImpulseSourceUnavailable { source, availability } => join(["refused (", availability, ")"], "")
      ImpulseChannelDisabled { source } => "refused (channel disabled)"
    },
  ], ""))
}

fn sensor_states() -> List<SensorAvailability> {
  [SensorPresent, SensorAbsent, SensorPermissionNotRequested, SensorPermissionDenied, SensorAvailabilityUnknown]
}

fn impulse_row(s: PhysicalImpulseSource) -> Fragment {
  row(cells: concat(
    [ cell(s: impulse_source_key(s: s)) ],
    map(sensor_states(), a => impulse_cell(s: s, a: a))))
}

fn physical_section() -> Fragment {
  el("section", concat(
    concat(
      [
        el("h2", [ txt("physical screen") ]),
        note(s: "Press the frame below: the impulse glitch is a real response built through the ordinary ResponseRule machinery, so it obeys the same still-until-touched law every other control does. The idle channels are budgeted here but not animated — ambient motion has no constructor in this register yet, and emitting one past that wall would be an unmarked workaround."),
        el_class("div", instrument_frame_class, [
          el("h3", [ txt("instrument enclosure — press to see the impulse glitch") ]),
          note(s: join(["glitch duration: ", glitch_duration_key(g: preference_default.glitch_duration)], "")),
        ]),
      ],
      map([OpticalJitter, VerticalShift, BuoyantDrift, ImpulseGlitch], c => channel_row(p: preference_default, c: c))),
    concat(
      [ note(s: displacement_text(p: preference_default)), el("h3", [ txt("impulse admission") ]) ],
      map([SyntheticImpulse, HostAccelerometer, HostDeviceMotion], s => impulse_row(s: s)))))
}

fn instrument_sandbox_page() -> Fragment {
  Element {
    tag: "html",
    attributes: [],
    children: [
      el("head", [
        Element { tag: "meta", attributes: [ attr(name: "charset", value: "utf-8" ) ], children: [] },
        el("style", [ txt(instrument_css()) ]),
        el("title", [ txt("gunbc — instrument") ]),
      ]),
      el("body", [
        roadmap_header(page: "instrument"),
        el_class("main", instrument_sandbox_page_class, [
          camera_section(),
          salience_section(),
          audition_section(),
          physical_section(),
        ]),
      ]),
    ],
  }
}
