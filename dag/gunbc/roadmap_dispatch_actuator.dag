  host_exec_argv(
    program: dispatch_capability_program(
      environment: instance.execution_environment,
      cap: GitWorkspaceCapability,
    ),
    args: ["for-each-ref", "--format=%(refname:short)", "refs/heads/dispatch/"],
  )
}

data dispatch_session_ownership_note: String = "R5 owned-only teardown, session grain: a live dispatch session is teardown-eligible (OUR process) ONLY when its lease verdict is Converged (running with our expected process fingerprint) or Drifted (our fingerprint, stale lease — reap-able stale-ours, matching decision_for_dispatch_lease_verdict's DrainStale). Conflict (foreign process), Inaccessible, UnknownRefused, Absent are NOT owned. Name-only tmux-ls observation yields UnknownRefused/Inaccessible only, so teardown FAIL-CLOSED-REFUSES until the observation carries a process fingerprint — correct R5 (no ownership proof, no reap). This owned-ness judgment lives HERE (the actuator owns lease/ownership classification, §3) as a Bool; gunbc.roadmap_belt lifts the Bool into gunbc.ownership.Ownership for the reconcile teardown gate, so the belt never imports ObservationVerdict."

data tmux_pane_fingerprint_note: String = "U4 (stop from the UI): the pane read is the scaffold's declared dissolution — tmux list-panes -a with the cited format variables yields (session_name, pane_current_command) per pane, and pane_current_command IS the process-fingerprint evidence the lease classification was built to consume. The observation upgrade is total over its inputs: a session whose pane row is found observes as SessionObserved (fingerprint in hand — Converged only for dispatch_cli_provider's expected process, Conflict for anything else wearing the name, e.g. a hand-made sleep); a session visible in ls but absent from the pane read stays SessionNameObserved (honest partial — UnknownRefused downstream, still no reap). The stop gate is the R5 table as a typed decision: owned stops; everything else refuses with the verdict's own reason, and refusing to kill what we cannot prove ours is the point, not a limitation."

type TmuxPaneEntry {
  session_name: String
  command: String
}

fn parse_tmux_pane_line(line: String) -> TmuxPaneEntry? {
  let segs = split(s: line, delimiter: " ")
  if count(segs) >= 2 && segs.first() != "" {
    let name = segs.first()
    Present { value: TmuxPaneEntry {
      session_name: name,
      command: substring(s: line, start: string_length(s: name) + 1, end: string_length(s: line)),
    } }
  } else {
    none
  }
}

fn parse_tmux_panes_output(output: String) -> List<TmuxPaneEntry> {
  fold(
    split(s: output, delimiter: "\n"),
    init: [],
    f: (acc, line) => match parse_tmux_pane_line(line: line) {
      Present { value: e } => append(acc, [e])
      Absent => acc
    },
  )
}

fn tmux_list_panes_argv() -> HostExecArgv {
  host_exec_argv(program: "tmux", args: shape_tmux_list_panes_argv())
}

fn tmux_list_panes_argv_for_instance(instance: HostDashboardInstance) -> HostExecArgv {
  host_exec_argv(
    program: dispatch_capability_program(
      environment: instance.execution_environment,
      cap: TmuxSessionCapability,
    ),
    args: shape_tmux_list_panes_argv_for(scope: instance.tmux_server),
  )
}

type TmuxAttemptPaneEntry {
  session_name: String
  dead: Bool
  exit_code: Int?
  command: String
}

type TmuxAttemptPanesParse
  = AttemptPanesParsed { panes: List<TmuxAttemptPaneEntry> }
  | AttemptPanesParseRefused {
      line_number: Int,
      raw: String,
      reason: String,
    }

type TmuxAttemptPanesFold {
  panes: List<TmuxAttemptPaneEntry>
  next_line_number: Int
  refused: Bool
  refused_line_number: Int
  refused_raw: String
  refused_reason: String
}

data tmux_attempt_pane_parse_note: String = "The attempt observer uses one exact tmux format with four tab-delimited fields: session_name, pane_dead, pane_dead_status, and pane_current_command. Parsing is total and fail-closed. A live pane must report dead=0; a retained pane must report dead=1 plus an integer exit status. The first malformed non-empty row refuses the whole observation with its 1-based line and raw evidence. No malformed row is dropped into an apparently-empty process set."

fn tmux_attempt_pane_field(parts: List<String>, n: Int) -> String {
  match parts.skip(n: n).first() {
    Present { value } => value
    Absent => ""
  }
}

fn parse_tmux_attempt_pane_line(
  line: String,
) -> TmuxAttemptPaneEntry? {
  let parts = split(s: line, delimiter: "\t")
  let name = tmux_attempt_pane_field(parts: parts, n: 0)
  let dead = tmux_attempt_pane_field(parts: parts, n: 1)
  let status = tmux_attempt_pane_field(parts: parts, n: 2)
  let command = tmux_attempt_pane_field(parts: parts, n: 3)
  if count(parts) != 4 || name == "" {
    none
  } else if dead == "0" && status == "" {
    Present { value: TmuxAttemptPaneEntry {
      session_name: name,
      dead: false,
      exit_code: none,
      command: command,
    } }
  } else if dead == "1" {
    match parse_int(status) {
      Present { value: code } =>
        Present { value: TmuxAttemptPaneEntry {
          session_name: name,
          dead: true,
          exit_code: Present { value: code },
          command: command,
        } }
      Absent => none
    }
  } else {
    none
  }
}

fn parse_tmux_attempt_panes_output(
  output: String,
) -> TmuxAttemptPanesParse {
  let lines = split(s: output, delimiter: "\n")
  let state = fold(
    lines,
    init: TmuxAttemptPanesFold {
      panes: [],
      next_line_number: 1,
      refused: false,
      refused_line_number: 0,
      refused_raw: "",
      refused_reason: "",
    },
    f: fn(acc, line) {
      if acc.refused || trim(line) == "" {
        TmuxAttemptPanesFold {
          panes: acc.panes,
          next_line_number: acc.next_line_number + 1,
          refused: acc.refused,
          refused_line_number: acc.refused_line_number,
          refused_raw: acc.refused_raw,
          refused_reason: acc.refused_reason,
        }
      } else {
        match parse_tmux_attempt_pane_line(line: line) {
          Present { value: pane } =>
            TmuxAttemptPanesFold {
              panes: append(acc.panes, [pane]),
              next_line_number: acc.next_line_number + 1,
              refused: false,
              refused_line_number: 0,
              refused_raw: "",
              refused_reason: "",
            }
          Absent =>
            TmuxAttemptPanesFold {
              panes: acc.panes,
              next_line_number: acc.next_line_number + 1,
              refused: true,
              refused_line_number: acc.next_line_number,
              refused_raw: line,
              refused_reason: "expected four tab-delimited tmux attempt-pane fields with a valid dead/status pair",
            }
        }
      }
    },
  )
  if state.refused {
    AttemptPanesParseRefused {
      line_number: state.refused_line_number,
      raw: state.refused_raw,
      reason: state.refused_reason,
    }
  } else {
    AttemptPanesParsed { panes: state.panes }
  }
}

type DispatchSessionCleanup
  = DispatchStopRunningProcess { session_name: String }
  | DispatchClearRetainedSession {
      session_name: String,
      exit_code: Int,
    }
  | DispatchCleanupRefused { reason: String }

fn dispatch_session_cleanup_action(
  cleanup: DispatchSessionCleanup,
) -> String {
  match cleanup {
    DispatchStopRunningProcess { session_name: _ } => "stop"
    DispatchClearRetainedSession { session_name: _, exit_code: _ } => "clear"
    DispatchCleanupRefused { reason: _ } => "unavailable"
  }
}

fn dispatch_session_cleanup_allowed(
  cleanup: DispatchSessionCleanup,
) -> Bool {
  match cleanup {
    DispatchStopRunningProcess { session_name: _ } => true
    DispatchClearRetainedSession { session_name: _, exit_code: _ } => true
    DispatchCleanupRefused { reason: _ } => false
  }
}

fn dispatch_session_cleanup_detail(
  cleanup: DispatchSessionCleanup,
) -> String {
  match cleanup {
    DispatchStopRunningProcess { session_name: _ } =>
      "owned running provider process may be stopped"
    DispatchClearRetainedSession { session_name: _, exit_code } =>
      join([
        "provider process already exited ",
        to_string(exit_code),
        "; only retained tmux session metadata will be removed",
      ], "")
    DispatchCleanupRefused { reason } => reason
  }
}

data dispatch_process_cleanup_separation_note: String = "Session presence, pane/process lifecycle, and cleanup authority are independent facts. A running process is stop-eligible only when its observed command matches the provider fingerprint. A dead remain-on-exit pane is clear-eligible from the exact dead/status observation because no live process can be killed; its last command is historical evidence and is never re-used as a running ownership fingerprint. A present session with an absent/refused pane observation remains cleanup-refused. The wire therefore says stop, clear, or unavailable mechanically from DispatchSessionCleanup instead of presenting every tmux container as a live agent."

fn worker_process_from_attempt_pane(
  pane: TmuxAttemptPaneEntry,
) -> WorkerProcessEvidence {
  if pane.dead {
    match pane.exit_code {
      Present { value: code } =>
        WorkerProcessExited {
          exit_code: code,
          last_command: pane.command,
        }
      Absent =>
        WorkerProcessUnobserved {
          reason: "dead pane did not carry an exit status" as NonEmptyStr,
        }
    }
  } else if pane.command == "" {
    WorkerProcessUnobserved {
      reason: "running pane did not expose pane_current_command" as NonEmptyStr,
    }
  } else {
    WorkerProcessRunning { command: pane.command as NonEmptyStr }
  }
}

fn worker_process_for_session(
  panes: List<TmuxAttemptPaneEntry>,
  session_name: String,
  pane_observation_refusal: String,
) -> WorkerProcessEvidence {
  if pane_observation_refusal != "" {
    WorkerProcessUnobserved {
      reason: pane_observation_refusal as NonEmptyStr,
    }
  } else {
    let matched = panes
      |> filter(pane => pane.session_name == session_name)
    match matched.first() {
      Present { value: pane } =>
        worker_process_from_attempt_pane(pane: pane)
      Absent =>
        WorkerProcessUnobserved {
          reason: "session was observed but no pane row was returned" as NonEmptyStr,
        }
    }
  }
}

fn live_session_row_with_process(
  entry: TmuxLsEntry,
  scope: TmuxSessionScope,
  process: WorkerProcessEvidence,
) -> DispatchLiveSession {
  let obs = match process {
    WorkerProcessRunning { command } =>
      SessionObserved {
        session_name: entry.session_name as NonEmptyStr,
        windows: entry.windows,
        process_fingerprint: command,
      }
    _ =>
      SessionNameObserved {
        session_name: entry.session_name as NonEmptyStr,
        windows: entry.windows,
      }
  }
  DispatchLiveSession {
    session_name: entry.session_name,
    node_id: dispatch_node_id_from_session_name(
      session_name: entry.session_name),
    windows: entry.windows,
    lease_verdict: classify_tmux_session(scope: scope, obs: obs),
    worker: dispatch_worker_observation_for_process(process: process),
  }
}

fn dispatch_live_sessions_with_process(
  tmux_ls_output: String,
  panes: List<TmuxAttemptPaneEntry>,
  pane_observation_refusal: String,
) -> List<DispatchLiveSession> {
  filter_dispatch_tmux_sessions(
    entries: parse_tmux_ls_output(output: tmux_ls_output),
  )
    |> map(entry => {
      let node_id = dispatch_node_id_from_session_name(
        session_name: entry.session_name)
      live_session_row_with_process(
        entry: entry,
        scope: dispatch_tmux_session_scope(node_id: node_id),
        process: worker_process_for_session(
          panes: panes,
          session_name: entry.session_name,
          pane_observation_refusal: pane_observation_refusal,
        ),
      )
    })
}

fn dispatch_session_cleanup(
  scope: TmuxSessionScope,
  session: DispatchLiveSession,
) -> DispatchSessionCleanup {
  if session.session_name != (scope.session_name as String) {
    DispatchCleanupRefused {
      reason: "tmux session name does not match the requested node",
    }
  } else {
    match session.worker.process {
      WorkerProcessRunning { command } =>
        if command == scope.expected_process_fingerprint {
          DispatchStopRunningProcess {
            session_name: session.session_name,
          }
        } else {
          DispatchCleanupRefused {
            reason: "a foreign running process wears the dispatch session name — refusing to kill what we cannot prove ours",
          }
        }
      WorkerProcessExited { exit_code, last_command: _ } =>
        DispatchClearRetainedSession {
          session_name: session.session_name,
          exit_code: exit_code,
        }
      WorkerProcessAbsent =>
        DispatchCleanupRefused {
          reason: "session is present but provider process is absent",
        }
      WorkerProcessUnobserved { reason } =>
        DispatchCleanupRefused {
          reason: join([
            "process lifecycle unobserved — no cleanup authority: ",
            reason as String,
          ], ""),
        }
    }
  }
}

fn tmux_attempt_panes_argv_for_instance(
  instance: HostDashboardInstance,
) -> HostExecArgv {
  host_exec_argv(
    program: dispatch_capability_program(
      environment: instance.execution_environment,
      cap: TmuxSessionCapability,
    ),
    args: shape_tmux_attempt_panes_argv_for(scope: instance.tmux_server),
  )
}

fn pane_command_for_session(panes: List<TmuxPaneEntry>, session_name: String) -> String {
  fold(panes, init: "", f: (acc, p) =>
    if acc == "" && p.session_name == session_name { p.command } else { acc })
}

fn tmux_session_observation_with_panes(
  scope: TmuxSessionScope,
  entries: List<TmuxLsEntry>,
  panes: List<TmuxPaneEntry>,
) -> TmuxSessionObservation {
  match tmux_session_observation_for_scope(scope: scope, entries: entries) {
    SessionNameObserved { session_name: name, windows: w } => {
      let cmd = pane_command_for_session(panes: panes, session_name: name as String)
      if cmd == "" {
        SessionNameObserved { session_name: name, windows: w }
      } else {
        SessionObserved { session_name: name, windows: w, process_fingerprint: cmd as NonEmptyStr }
      }
    }
    SessionAbsent => SessionAbsent
    SessionObserved { session_name: n2, windows: w2, process_fingerprint: f2 } =>
      SessionObserved { session_name: n2, windows: w2, process_fingerprint: f2 }
    SessionObservedStaleExpected { session_name: n3, windows: w3, process_fingerprint: f3, stale_reason: r3 } =>
      SessionObservedStaleExpected { session_name: n3, windows: w3, process_fingerprint: f3, stale_reason: r3 }
    SessionInaccessible => SessionInaccessible
  }
}

type DispatchStopGate
  = StopPermitted { session_name: String }
  | StopRefused { reason: String }

fn dispatch_stop_gate(scope: TmuxSessionScope, obs: TmuxSessionObservation) -> DispatchStopGate {
  match classify_tmux_session(scope: scope, obs: obs) {
    Converged => StopPermitted { session_name: scope.session_name as String }
    Drifted => StopPermitted { session_name: scope.session_name as String }
    Absent => StopRefused { reason: "no live session for this node" }
    Conflict => StopRefused { reason: "a foreign process wears the dispatch session name — refusing to kill what we cannot prove ours" }
    Inaccessible => StopRefused { reason: "tmux session inaccessible" }
    UnknownRefused => StopRefused { reason: "process fingerprint unobserved — no ownership proof, no reap" }
  }
}

fn dispatch_session_is_owned(session: DispatchLiveSession) -> Bool {
  match session.lease_verdict {
    Converged => true
    Drifted => true
    _ => false
  }
}

fn session_lease_reuses_process_port_classifier_shape() -> Bool {
  let port_scope = ProcessPortScope {
    listen_port: 8080,
    expected_owner_label: "gunbc-roadmap" as NonEmptyStr,
    expected_process_fingerprint: "node server.js" as NonEmptyStr,
  }
  match classify_process_port_upsert(
    scope: port_scope,
    obs: PortAbsent,
  ) {
    UpsertClassification { verdict: Absent, decision: Apply { plan: Start } } => true
    _ => false
  }
}

fn argv_contains_token(argv: List<String>, token: String) -> Bool {
  any(argv, a => a == token)
}

fn hostile_node_id_stays_single_argv_token(node_id: String) -> Bool {
  let worktree_path = dispatch_worktree_path(node_id: node_id, attempt_key: "feedfacefeedface")
  let branch_name = dispatch_branch_name(node_id: node_id, attempt_key: "feedfacefeedface")
  let worktree = git_worktree_add_argv(
    worktree_path: worktree_path,
    branch_name: branch_name,
    remote_ref: dispatch_git_remote_ref,
  ).args
  argv_contains_token(argv: worktree, token: worktree_path)
    && argv_contains_token(argv: worktree, token: branch_name)
    && !argv_contains_token(argv: worktree, token: "rm")
    && !argv_contains_token(argv: worktree, token: "-rf")
}
