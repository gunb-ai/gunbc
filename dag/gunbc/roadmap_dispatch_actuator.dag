  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  node_id: gunbc.roadmap_model.RoadmapNodeId,
  attempt_key: String,
  head_sha: String,
) -> String {
  join([
    dispatch_attempt_publication_dir_for_instance(
      instance: instance,
      node_id: node_id,
      attempt_key: attempt_key,
    ),
    "/",
    head_sha,
    ".json",
  ], "")
}

data publication_receipt_has_no_current_alias_note: String = "EVERY OTHER RECEIPT ON THIS ROW HAS A `current` SPELLING AND THIS ONE DELIBERATELY DOES NOT. The alias exists so a reader that knows only a node can find the live attempt's evidence without first reading the attempt key. Publication cannot be reached that way: its address contains the head, and a reader that does not know the head has no path to build regardless of which attempt directory it starts from.\\n\\nSo the alias would buy nothing and cost the thing this lane is for. A reader holding a head already had to establish it, and establishing a head means reading the attempt - at which point the attempt-keyed path is available and the alias is a second spelling of it. Keeping it would have made the symlink an alternative route to a file whose identity is a head, which is how a receipt for one attempt gets read as evidence for another."

data verification_receipt_is_head_addressed_note: String = "VERIFICATION AND PUBLICATION SHARE THE HEAD × WINDOW GRAIN. One implementation attempt may be verified at head A under window W1 and again at the same head under window W2 after the target branch advances. Attempt-level files would either overwrite A or let A's verdict stand for B. The verification directory therefore mirrors publication at the finer grain: attempt/<attempt>/verification/<head>.<window_identity>.json for immutable receipts, plus a mutable current-selection pointer at verification/<head>.current-selection.json that names which window identity is selected for dashboard observation. DISSOLVE-ON: the legacy attempt-level validation-receipt.json path deletes once its last belt consumer is gone."

