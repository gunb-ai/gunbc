  red_control: String
  out_of_scope: String
  handback: String
  paths: String
  commands_to_run: String
  expected_artifact: String
}

data dispatch_brief_slot_note: String = "The template's workflow slots are REAL fields when the node is a TicketLine (remodel W2: the template was always the spec of the schema — its slot names became TicketFields), and honest stubs only on the legacy prose frontier: a legacy row's brief still repeats the title where a fact should be, which is exactly the burn-down pressure W2-bulk answers. A ticket node's brief carries its own displaced cost, current state, first slice, RED, scope, and hand-back conditions; paths come from the node's carriers."

type TmuxLsEntry {
  session_name: String
  windows: Int
}

type TmuxSessionScope {
  session_name: NonEmptyStr
  expected_owner_label: NonEmptyStr
  expected_process_fingerprint: NonEmptyStr
}

type TmuxSessionObservation
  = SessionAbsent
  | SessionNameObserved {
      session_name: NonEmptyStr
      windows: Int
    }
  | SessionObserved {
      session_name: NonEmptyStr
      windows: Int
      process_fingerprint: NonEmptyStr
    }
  | SessionObservedStaleExpected {
      session_name: NonEmptyStr
      windows: Int
      process_fingerprint: NonEmptyStr
      stale_reason: NonEmptyStr
    }
  | SessionInaccessible

type DispatchLeasePlan
  = SpawnSession
  | DrainStaleThenSpawn
  | RefuseForeignSession

type DispatchRequestGate
  = DispatchPermitted {
      session_name: String
      worktree_path: String
      branch_name: String
      brief: String
      reasoning_effort: ReasoningEffort
    }
  | DispatchRefused { reason: NonEmptyStr }

type DispatchLiveSession {
  session_name: String
  node_id: String
  windows: Int
  lease_verdict: ObservationVerdict
  worker: WorkerObservation
}

data dispatch_provider_instance_note: String = "The configured provider instance is known from the actuator plan, not guessed from one process command. dispatch_provider_instance_for is total over the same closed DispatchCliProvider choice that owns argv and expected process fingerprint: Claude consumes claude_cli_program; Codex consumes codex_cli_program. The tmux observation does not read hostname, version, state/auth directory, credential storage, or service identity, so each stays explicitly Unobserved; filling any from deployment prose would fabricate live evidence. A later provider-instance probe replaces those arms independently."

fn dispatch_provider_executable(provider: DispatchCliProvider) -> NonEmptyStr {
  match provider {
    ClaudeCodeProvider => claude_cli_program as NonEmptyStr
    CodexCliProvider => codex_cli_program as NonEmptyStr
  }
}

fn dispatch_provider_instance_for(
  provider: DispatchCliProvider,
) -> ProviderInstance {
  ProviderInstance {
    kind: match provider {
      ClaudeCodeProvider => ClaudeCliProvider
      CodexCliProvider => extdeps.llm.cli_lifecycle.CodexCliProvider
    },
    host: ProviderInstanceFieldUnobserved {
      reason: "session observation does not read host identity" as NonEmptyStr,
    },
    executable: dispatch_provider_executable(provider: provider),
    observed_version: ProviderInstanceFieldUnobserved {
      reason: "session observation does not execute the provider version probe" as NonEmptyStr,
    },
    state_directory: ProviderInstanceFieldUnobserved {
      reason: "session observation does not inspect provider state" as NonEmptyStr,
    },
    credential_storage_method: ProviderInstanceFieldUnobserved {
      reason: "session observation does not inspect credential storage" as NonEmptyStr,
    },
    service_identity: ProviderInstanceFieldUnobserved {
      reason: "session observation does not read process ownership" as NonEmptyStr,
    },
  }
}

fn dispatch_provider_instance() -> ProviderInstance {
  dispatch_provider_instance_for(provider: dispatch_cli_provider)
}

fn dispatch_worker_observation_for_process(
  process: WorkerProcessEvidence,
) -> WorkerObservation {
  worker_observation_without_provider_probe_for_process(
    instance: dispatch_provider_instance(),
    process: process,
  )
}

fn dispatch_worker_observation() -> WorkerObservation {
  worker_observation_without_provider_probe(instance: dispatch_provider_instance())
}

