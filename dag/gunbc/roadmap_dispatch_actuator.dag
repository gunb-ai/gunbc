module gunbc.roadmap_dispatch_actuator


data dispatch_tmux_process_fingerprint_observation_dissolution_trigger: std.disposition.Disposition = Terminal {
  reason: "DISSOLVED (U4, 2026-07-25): the pane-fingerprint observation landed — tmux list-panes with the cited format variables feeds tmux_session_observation_with_panes, so SessionObserved carries pane_current_command and the lease classification's Converged/Conflict arms are reachable by observation, not only by fixture. The R5 owned-only teardown gate (dispatch_stop_gate) is its first live consumer." as std.types.NonEmptyStr
}

data dispatch_repo: String = "gunbc"

data dispatch_worktree_root_note: String = "PROJECTION of gunbc.host_layout.srv1_dispatch_worktree_root — the single path authority shared with the live_deploy membership that provisions the directory (DESIGN §3; its former private copy deleted, belt-B lane 2026-07-20)."

data dispatch_worktree_root: String = srv1_dispatch_worktree_root as String
data dispatch_git_remote_ref: String = gunbc_merge_target_ref as String
data dispatch_tmux_session_prefix: String = "gunbc-dispatch-"
data dispatch_claude_fingerprint_finding_note: String = "NAMED FINDING (U4 live drive, macOS, 2026-07-25): pane_current_command is the kernel process name (p_comm) — symlinks resolve and exec -a cannot fake it, which is exactly the anti-spoof property R5 wants — BUT a REAL running claude CLI on this macOS reported its VERSION STRING (2.1.220) as p_comm, not claude (node process.title). So the Converged green path may not fire on real workers until the fingerprint a real srv1 spawned session reports is READ, not guessed. The refuse arms are unaffected (they are the safety half and were proven live four ways). DECIDE-BY-RECEIPT: run tmux list-panes on srv1 beside a live dispatch session; if it reports claude this row stands; if it reports a version-or-node name, this row becomes the observed value (or an accepted set) — a data edit, never a code change."

type DispatchCliProvider
  = ClaudeCodeProvider
  | CodexDispatchProvider
  | CursorDispatchProvider

data dispatch_cli_provider_note: String = "Provider choice is resolved by gunbc.dispatch_selection from a per-instance inventory, not a host-wide constant. dispatch_cli_provider() projects the srv1-live Automatic selection for legacy call sites; instance-aware dispatch uses dispatch_selection_for_instance. Production Codex inventory standing is declared-unobserved at selection time; wet probe-derived standing is reserved for dashboard readiness (dispatch_production_standing_unobserved_refusal_note). Each DispatchCliProvider variant owns argv, preflight, and expected pane fingerprint together at this call site."

fn provider_kind_to_dispatch_cli(kind: extdeps.llm.cli_lifecycle.ProviderKind) -> DispatchCliProvider {
  match kind {
    ClaudeCliProvider => ClaudeCodeProvider
    extdeps.llm.cli_lifecycle.CodexCliProvider => CodexDispatchProvider
    extdeps.llm.cli_lifecycle.CursorCliProvider => CursorDispatchProvider
  }
}

fn dispatch_cli_to_provider_kind(provider: DispatchCliProvider) -> extdeps.llm.cli_lifecycle.ProviderKind {
  match provider {
    ClaudeCodeProvider => ClaudeCliProvider
    CodexDispatchProvider => extdeps.llm.cli_lifecycle.CodexCliProvider
    CursorDispatchProvider => extdeps.llm.cli_lifecycle.CursorCliProvider
  }
}

type DispatchActuatorSelection
  = DispatchActuatorSelectionOk {
      provider: DispatchCliProvider
      effort: extdeps.llm.cli.ReasoningEffort
      process_fingerprint: std.types.NonEmptyStr
    }
  | DispatchActuatorSelectionRefused { reason: std.types.NonEmptyStr }

data dispatch_actuator_selection_note: String = "The actuator's sole projection of gunbc.dispatch_selection for legacy call sites. Refusal propagates typed — no Codex substitute, no ReasoningMedium default, no actuator-local process fingerprint (DESIGN §5; review 47676). Process fingerprints are consumed from the selection kernel via resolved_process_fingerprint, never re-declared here (DESIGN §3)."

fn dispatch_actuator_selection(node_sizing: gunbc.roadmap_model.NodeSizing) -> DispatchActuatorSelection {
  match dispatch_selection_for_instance(
    instance: srv1_live_dashboard_instance(),
    request: default_provider_selection_request(),
    node_sizing: node_sizing,
  ) {
    DispatchSelectionResolved { receipt } =>
      DispatchActuatorSelectionOk {
        provider: provider_kind_to_dispatch_cli(kind: receipt.provider_kind),
        effort: receipt.applied_effort,
        process_fingerprint: resolved_process_fingerprint(resolved: receipt.resolved_selection),
      }
    DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason } =>
      DispatchActuatorSelectionRefused { reason: reason }
  }
}

fn dispatch_actuator_selection_for_provider(
  provider: DispatchCliProvider,
  node_sizing: gunbc.roadmap_model.NodeSizing,
) -> DispatchActuatorSelection {
  match dispatch_selection_for_instance(
    instance: srv1_live_dashboard_instance(),
    request: provider_selection_request_for_kind(
      kind: dispatch_cli_to_provider_kind(provider: provider),
    ),
    node_sizing: node_sizing,
  ) {
    DispatchSelectionResolved { receipt } =>
      DispatchActuatorSelectionOk {
        provider: provider_kind_to_dispatch_cli(kind: receipt.provider_kind),
        effort: receipt.applied_effort,
        process_fingerprint: resolved_process_fingerprint(resolved: receipt.resolved_selection),
      }
    DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason } =>
      DispatchActuatorSelectionRefused { reason: reason }
  }
}

fn dispatch_cli_provider() -> DispatchCliProvider? {
  match dispatch_actuator_selection(node_sizing: Unsized) {
    DispatchActuatorSelectionOk { provider, effort: _, process_fingerprint: _ } =>
      Present { value: provider }
    DispatchActuatorSelectionRefused { reason: _ } => none
  }
}
data claude_skip_permission_settings_json: String = "{\"skipDangerousModePermissionPrompt\":true}"
data dispatch_claude_start_prompt: String = "Begin working on the assigned node."
data dispatch_claude_permission_args: List<String> = ["--dangerously-skip-permissions"]
data dispatch_codex_start_prompt: String = "Begin working on the assigned node."
data dispatch_codex_home: String = srv1_roadmap_codex_home as String
data dispatch_codex_exec_spec: extdeps.llm.cli.CodexExecSpec = extdeps.llm.cli.CodexExecSpec {
  sandbox: CodexWorkspaceWrite,
  approval: CodexApprovalNever,
  json_events: true,
  persist_session: true,
}
data dispatch_codex_exec_spec_note: String = "Codex dispatch is unattended but not unrestricted: workspace-write permits implementation inside the attempt worktree; approval never returns blocked operations to the agent instead of hanging on an invisible prompt; --json exposes the provider event stream in the pane; persisted sessions preserve the provider transcript after the process exits. Attempt capture retains the complete JSONL stream, while workflow observation consumes a separately validated bounded projection. Spawned and session-present remain actuator/process observations only — never a claim that the provider completed successfully."

fn dispatch_provider_label(provider: DispatchCliProvider) -> String {
  match provider {
    ClaudeCodeProvider => "claude"
    CodexDispatchProvider => "codex"
    CursorDispatchProvider => "cursor"
  }
}

type HostExecArgv {
  program: String
  args: List<String>
}

data dispatch_unrealized_capability_marker: String = "gunbc-unrealized-capability:"

data dispatch_capability_program_absence_note: String = "An environment with no realization for a capability used to resolve to the empty program string. Empty is non-executable, so the host did fail — but it failed as an unattributable exec error with nothing naming WHICH capability was unrealized, which is a degradation that cannot be counted (DESIGN 5). The marker keeps the arm non-executable and makes it self-describing at the point of failure. It is not a widening: no marker value can run. The real close is a typed refusal on the resolver, which requires the argv shapers above it to carry a refusal arm — that rides with the DashboardExecResult typed-refusal migration named in dashboard_exec_result_carrier_note, and dissolves this row with it."

fn dispatch_capability_program(
  environment: gunbc.roadmap_execution_contract.DispatchHostEnvironment,
  cap: gunbc.roadmap_execution_contract.ExecutionCapability,
) -> String {
  match dispatch_host_realization(environment: environment, capability: cap) {
    Present { value: realization } => realization.executable as String
    Absent =>
      join(
        [
          dispatch_unrealized_capability_marker,
          execution_capability_label(capability: cap),
        ],
        "",
      )
  }
}

type DispatchBriefFields {
  node_id: String
  displaced_cost: String
  current_state: String
  first_slice: String
  red_control: String
  out_of_scope: String
  handback: String
  paths: String
  commands_to_run: String
  expected_artifact: String
}

data dispatch_brief_fields_invariant_note: String = "DispatchBriefFields contains only fields consumed by fill_dispatch_brief. Sizing remains typed on RoadmapNode and is projected only where rendered."


data dispatch_brief_slot_note: String = "The template's workflow slots are REAL fields when the node is a TicketLine (remodel W2: the template was always the spec of the schema — its slot names became TicketFields), and honest stubs only on the legacy prose frontier: a legacy row's brief still repeats the title where a fact should be, which is exactly the burn-down pressure W2-bulk answers. A ticket node's brief carries its own displaced cost, current state, first slice, RED, scope, and hand-back conditions; paths come from the node's carriers."

type TmuxSessionScope {
  session_name: std.types.NonEmptyStr
  expected_owner_label: std.types.NonEmptyStr
  expected_process_fingerprint: std.types.NonEmptyStr
}

type TmuxSessionObservation
  = SessionAbsent
  | SessionNameObserved {
      session_name: std.types.NonEmptyStr
      windows: Int
    }
  | SessionObserved {
      session_name: std.types.NonEmptyStr
      windows: Int
      process_fingerprint: std.types.NonEmptyStr
    }
  | SessionObservedStaleExpected {
      session_name: std.types.NonEmptyStr
      windows: Int
      process_fingerprint: std.types.NonEmptyStr
      stale_reason: std.types.NonEmptyStr
    }
  | SessionInaccessible

type DispatchLeasePlan
  = SpawnSession
  | DrainStaleThenSpawn
  | RefuseForeignSession

type DispatchRequestGate
  = DispatchPermitted {
      session_name: String
      worktree_path: String
      branch_name: String
      brief: String
      reasoning_effort: extdeps.llm.cli.ReasoningEffort
    }
  | DispatchRefused { reason: std.types.NonEmptyStr }

type DispatchLiveSession {
  session_name: String
  node_id: String
  windows: Int
  lease_verdict: std.upsert_decision.ObservationVerdict
  worker: gunbc.worker_lifecycle.WorkerObservation
}

data dispatch_provider_instance_note: String = "The configured provider instance is known from the actuator plan, not guessed from one process command. dispatch_provider_instance_for is total over the same closed DispatchCliProvider choice that owns argv and expected process fingerprint: Claude consumes claude_cli_program; Codex consumes codex_cli_program. The tmux observation does not read hostname, version, state/auth directory, credential storage, or service identity, so each stays explicitly Unobserved; filling any from deployment prose would fabricate live evidence. A later provider-instance probe replaces those arms independently."

fn dispatch_provider_executable(provider: DispatchCliProvider) -> std.types.NonEmptyStr {
  match provider {
    ClaudeCodeProvider => claude_cli_program as std.types.NonEmptyStr
    CodexDispatchProvider => codex_cli_program as std.types.NonEmptyStr
    CursorDispatchProvider => cursor_cli_program as std.types.NonEmptyStr
  }
}

fn dispatch_provider_instance_for(
  provider: DispatchCliProvider,
) -> extdeps.llm.cli_lifecycle.ProviderInstance {
  extdeps.llm.cli_lifecycle.ProviderInstance {
    kind: dispatch_cli_to_provider_kind(provider: provider),
    host: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved {
      reason: "session observation does not read host identity" as std.types.NonEmptyStr,
    },
    executable: dispatch_provider_executable(provider: provider),
    observed_version: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved {
      reason: "session observation does not execute the provider version probe" as std.types.NonEmptyStr,
    },
    state_directory: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved {
      reason: "session observation does not inspect provider state" as std.types.NonEmptyStr,
    },
    credential_storage_method: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved {
      reason: "session observation does not inspect credential storage" as std.types.NonEmptyStr,
    },
    service_identity: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved {
      reason: "session observation does not read process ownership" as std.types.NonEmptyStr,
    },
  }
}

fn dispatch_provider_instance() -> extdeps.llm.cli_lifecycle.ProviderInstance? {
  match dispatch_actuator_selection(node_sizing: Unsized) {
    DispatchActuatorSelectionOk { provider, effort: _, process_fingerprint: _ } =>
      Present { value: dispatch_provider_instance_for(provider: provider) }
    DispatchActuatorSelectionRefused { reason: _ } => none
  }
}

fn dispatch_worker_observation_for_process(
  process: gunbc.worker_lifecycle.WorkerProcessEvidence,
) -> gunbc.worker_lifecycle.WorkerObservation? {
  match dispatch_provider_instance() {
    Present { value: instance } =>
      Present {
        value: worker_observation_without_provider_probe_for_process(
          instance: instance,
          process: process,
        ),
      }
    none => none
  }
}

fn dispatch_worker_observation() -> gunbc.worker_lifecycle.WorkerObservation? {
  match dispatch_provider_instance() {
    Present { value: instance } =>
      Present { value: worker_observation_without_provider_probe(instance: instance) }
    none => none
  }
}

fn dispatch_applied_effort() -> extdeps.llm.cli.ReasoningEffort? {
  match dispatch_actuator_selection(node_sizing: Unsized) {
    DispatchActuatorSelectionOk { provider: _, effort, process_fingerprint: _ } =>
      Present { value: effort }
    DispatchActuatorSelectionRefused { reason: _ } => none
  }
}

fn dispatch_provider_process_fingerprint(provider: DispatchCliProvider) -> std.types.NonEmptyStr? {
  match dispatch_actuator_selection_for_provider(
    provider: provider,
    node_sizing: Unsized,
  ) {
    DispatchActuatorSelectionOk { provider: _, effort: _, process_fingerprint } =>
      Present { value: process_fingerprint }
    DispatchActuatorSelectionRefused { reason: _ } => none
  }
}

fn dispatch_tmux_session_name(node_id: gunbc.roadmap_model.RoadmapNodeId) -> String {
  concat(dispatch_tmux_session_prefix, node_id)
}

data dispatch_attempt_note: String = "Dispatch is ATTEMPT-grain (U1, the redispatch fix, 2026-07-25; the operator's accidental spawn was the live receipt): branch and worktree carry an attempt key derived from (node_id x the spawn's clock observation) through std.content_hash; the Claude provider also derives its required session-id from that stamp, while Codex mints its own persisted thread identity and does not yet join it back to the attempt. A stopped attempt's debris therefore never collides with the next spawn, and NOTHING is deleted to make way. The tmux session name deliberately STAYS node-grain: it is what observe/reconcile key on, so already-live detection, kill, and tick idempotency are untouched. Same-instant duplicate spawns for one node collide on the attempt key and refuse at the git step, typed. A clock refusal refuses the spawn (step attempt-clock), never an unknown-stamped attempt."

fn dispatch_attempt_key(node_id: gunbc.roadmap_model.RoadmapNodeId, probed_at: String) -> String {
  content_hash_atom(value: join([node_id as String, "\n", probed_at], "") as std.types.NonEmptyStr).digest as String
}

fn dispatch_worktree_path(node_id: gunbc.roadmap_model.RoadmapNodeId, attempt_key: String) -> String {
  join([dispatch_worktree_root, "/", node_id as String, "-a", attempt_key], "")
}

fn dispatch_worktree_path_for_instance(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  node_id: gunbc.roadmap_model.RoadmapNodeId,
  attempt_key: String,
) -> String {
  join([
    dashboard_instance_dispatch_worktree_root(instance: instance) as String,
    "/",
    node_id as String,
    "-a",
    attempt_key,
  ], "")
}

data dispatch_verification_checkout_path_note: String = "Verification validates the committed head in a DETACHED checkout, never the mutable implementation worktree the agent may still be editing. The path is head-addressed beside the attempt worktree so multiple heads per attempt each retain their own immutable tree without colliding on the branch checkout."

