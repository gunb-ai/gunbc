data dispatch_actuator_lease_witness_fixture_note: String = "Lease and tmux classification witnesses pin an explicit process fingerprint via dispatch_tmux_session_scope_for_process_fingerprint and classify_dispatch_request_for_process_fingerprint — they prove ownership classification and ready-frontier gating, not production selection standing. Production paths use dispatch_actuator_selection and refuse while standing axes block eligibility."

data dispatch_live_session_admission_note: String = "Production admission onto the live-session list routes through dispatch_tmux_session_scope, which projects dispatch_actuator_selection. Standing refusal yields Absent and the tmux row is omitted — ordinary non-running presentation, never a Codex substitute or partial row. Wire projection for already-admitted sessions uses dispatch_tmux_session_scope_for_live_session: Codex routes through dispatch_actuator_selection and refuses when process fingerprint is unobserved; Claude/Cursor still pin their observed fixture fingerprints."

data dispatch_projection_standing_refusal_specimen_note: String = "One planted refusal specimen for production standing-blocked projection: tmux row gunbc-dispatch-panel-a while production dispatch_actuator_selection refuses. Actuator admission (dispatch_live_sessions_from_entries), classify_dispatch_request, and sessions wire (belt_sessions_json_value over Observed live) must all derive no eligible provider — omit the row, never Null-deref or Codex substitute."

fn fixture_projection_standing_refusal_tmux_entry() -> extdeps.tmux.TmuxLsEntry {
  extdeps.tmux.TmuxLsEntry {
    session_name: "gunbc-dispatch-panel-a",
    windows: 1,
  }
}

fn dispatch_tmux_session_scope_for_process_fingerprint(
  node_id: gunbc.roadmap_model.RoadmapNodeId,
  process_fingerprint: std.types.NonEmptyStr,
) -> TmuxSessionScope {
  TmuxSessionScope {
    session_name: dispatch_tmux_session_name(node_id: node_id) as std.types.NonEmptyStr,
    expected_owner_label: dispatch_tmux_session_name(node_id: node_id) as std.types.NonEmptyStr,
    expected_process_fingerprint: process_fingerprint,
  }
}

fn dispatch_tmux_session_scope(node_id: gunbc.roadmap_model.RoadmapNodeId) -> TmuxSessionScope? {
  match dispatch_actuator_selection(node_sizing: Unsized) {
    DispatchActuatorSelectionOk { provider: _, effort: _, process_fingerprint } =>
      Present {
        value: dispatch_tmux_session_scope_for_process_fingerprint(
          node_id: node_id,
          process_fingerprint: process_fingerprint,
        ),
      }
    DispatchActuatorSelectionRefused { reason: _ } => none
  }
}

fn carrier_paths_label(carriers: List<gunbc.roadmap_model.Pointer>, repo: String) -> String {
  if count(carriers) == 0 {
    concat("dag/gunbc/roadmap_dispatch_actuator.dag (repo=", concat(repo, ")"))
  } else {
    join(map(carriers, p => p.path), " · ")
  }
}

fn dispatch_slot_fields(node: gunbc.roadmap_model.RoadmapNode, repo: String) -> DispatchBriefFields {
  let title = node_title(item: node.line)
  match line_ticket(item: node.line) {
    Present { value: t } =>
      DispatchBriefFields {
        node_id: node.node,
        displaced_cost: t.displaced_cost,
        current_state: t.current_state,
        first_slice: t.first_slice,
        red_control: t.red_control,
        out_of_scope: t.out_of_scope,
        handback: t.handback,
        paths: carrier_paths_label(carriers: node.carriers, repo: repo),
        commands_to_run: "",
        expected_artifact: "",
      }
    Absent =>
      DispatchBriefFields {
        node_id: node.node,
        displaced_cost: title,
        current_state: title,
        first_slice: title,
        red_control: "drop modeled argv row and witness goes red",
        out_of_scope: "see parent roadmap dispatch plan",
        handback: "node not ready, foreign lease, or unsupported repo",
        paths: carrier_paths_label(carriers: node.carriers, repo: repo),
        commands_to_run: "",
        expected_artifact: "",
      }
  }
}

fn dispatch_brief_fields_for_environment(
  node: gunbc.roadmap_model.RoadmapNode,
  environment: gunbc.roadmap_execution_contract.DispatchHostEnvironment,
) -> DispatchBriefFields {
  let validation = execution_contract_validation_summary(
    contract: node.execution,
    environment: environment,
  )
  match node.sizing {
  Sized { intricacy, volume, repo, acceptance: _ } => {
    let f = dispatch_slot_fields(node: node, repo: repo)
    DispatchBriefFields {
      node_id: f.node_id,
      displaced_cost: f.displaced_cost,
      current_state: f.current_state,
      first_slice: f.first_slice,
      red_control: f.red_control,
      out_of_scope: f.out_of_scope,
      handback: f.handback,
      paths: f.paths,
      commands_to_run: validation,
      expected_artifact: "implementation diff plus receipts from the declared validation operations",
    }
  }
  Unsized => {
    let f = dispatch_slot_fields(node: node, repo: "")
    DispatchBriefFields {
      node_id: f.node_id,
      displaced_cost: f.displaced_cost,
      current_state: f.current_state,
      first_slice: f.first_slice,
      red_control: f.red_control,
      out_of_scope: f.out_of_scope,
      handback: f.handback,
      paths: f.paths,
      commands_to_run: validation,
      expected_artifact: "implementation diff plus receipts from the declared validation operations",
    }
  }
  }
}

fn dispatch_brief_fields(node: gunbc.roadmap_model.RoadmapNode) -> DispatchBriefFields {
  dispatch_brief_fields_for_environment(
    node: node,
    environment: srv1_live_dashboard_instance().execution_environment,
  )
}

fn fill_dispatch_brief(template: String, fields: DispatchBriefFields) -> String {
  template
    .replace(from: "<node_id>", to: fields.node_id)
    .replace(from: "<displaced cost / what it unblocks>", to: fields.displaced_cost)
    .replace(from: "<explicitly out of scope>", to: fields.out_of_scope)
    .replace(from: "<prove current state / reproduce the gap>", to: fields.current_state)
    .replace(from: "<first implementation slice>", to: fields.first_slice)
    .replace(from: "<perturbation that goes red>", to: fields.red_control)
    .replace(from: "<execution on the real path>", to: fields.commands_to_run)
    .replace(from: "<named hand-back conditions>", to: fields.handback)
    .replace(from: "<paths>", to: fields.paths)
    .replace(from: "<repro/verify commands>", to: fields.commands_to_run)
    .replace(from: "<what comes back even if the fix does not land>", to: fields.expected_artifact)
}

fn filled_dispatch_brief_for_node(node: gunbc.roadmap_model.RoadmapNode) -> String {
  fill_dispatch_brief(
    template: dispatch_brief_template,
    fields: dispatch_brief_fields(node: node),
  )
}

