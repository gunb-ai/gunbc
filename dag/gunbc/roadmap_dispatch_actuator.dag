data dispatch_spawn_plan_note: String = "review 44113. Building the spawn plan can FAIL, so the builder returns a sum rather than a record it might have to fake. The one failure today is the tmux pipe-pane payload: it is emitted through the bash backend, and a serializer refusal has no honest command to put in tmux_event_pipe. Answering with a placeholder would make an un-emittable intent indistinguishable from a serialized one at the dispatch site (DESIGN 5). The refusal names the step that could not be built, and the belt maps it onto the SpawnFailed carrier it already has, so a plan that cannot be built never becomes a plan that gets run."

type DispatchSpawnPlan
  = DispatchSpawnReady { commands: DispatchSpawnCommands }
  | DispatchSpawnRefused { step: std.types.NonEmptyStr, detail: String }

type DispatchSpawnCommands {
  worktree_add: HostExecArgv
  attempt_state_prepare: HostExecArgv
  attempt_current_pointer: HostExecArgv
  tmux_spawn: HostExecArgv
  tmux_default_shell: HostExecArgv
  tmux_remain_on_exit: HostExecArgv
  tmux_event_pipe: HostExecArgv
  provider_start: HostExecArgv
}

fn dispatch_spawn_commands_for_provider(
  node: gunbc.roadmap_model.RoadmapNode,
  session_uuid: String,
  attempt_key: String,
  provider: DispatchCliProvider,
) -> DispatchSpawnPlan {
  dispatch_spawn_commands_for_instance(
    instance: srv1_live_dashboard_instance(),
    node: node,
    session_uuid: session_uuid,
    attempt_key: attempt_key,
    request: provider_selection_request_for_kind(
      kind: dispatch_cli_to_provider_kind(provider: provider),
    ),
  )
}

fn dispatch_spawn_commands_for_inventory(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  inventory: gunbc.dispatch_selection.ProviderInventory,
  node: gunbc.roadmap_model.RoadmapNode,
  session_uuid: String,
  attempt_key: String,
  request: gunbc.dispatch_selection.ProviderSelectionRequest,
) -> DispatchSpawnPlan {
  match resolve_dispatch_selection(
    inventory: inventory,
    request: request,
    node_sizing: node.sizing,
  ) {
    DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason } =>
      DispatchSpawnRefused {
        step: "dispatch-selection" as std.types.NonEmptyStr,
        detail: reason as String,
      }
    DispatchSelectionResolved { receipt } => {
      let provider = provider_kind_to_dispatch_cli(kind: receipt.provider_kind)
      let effort = receipt.applied_effort
      match provider {
        CursorDispatchProvider =>
          DispatchSpawnRefused {
            step: "cursor-provider-spawn" as std.types.NonEmptyStr,
            detail: "cursor dispatch spawn is not yet wired on this actuator path",
          }
        _ =>
          dispatch_spawn_commands_for_resolved_instance(
            instance: instance,
            node: node,
            session_uuid: session_uuid,
            attempt_key: attempt_key,
            provider: provider,
            effort: effort,
          )
      }
    }
  }
}

fn dispatch_spawn_commands_for_instance(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  node: gunbc.roadmap_model.RoadmapNode,
  session_uuid: String,
  attempt_key: String,
  request: gunbc.dispatch_selection.ProviderSelectionRequest,
) -> DispatchSpawnPlan {
  dispatch_spawn_commands_for_inventory(
    instance: instance,
    inventory: provider_inventory_for_instance(instance: instance),
    node: node,
    session_uuid: session_uuid,
    attempt_key: attempt_key,
    request: request,
  )
}

fn dispatch_spawn_commands_for_resolved_instance(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  node: gunbc.roadmap_model.RoadmapNode,
  session_uuid: String,
  attempt_key: String,
  provider: DispatchCliProvider,
  effort: extdeps.llm.cli.ReasoningEffort,
) -> DispatchSpawnPlan {
  let fields = dispatch_brief_fields_for_environment(
    node: node,
    environment: instance.execution_environment,
  )
  let brief = fill_dispatch_brief(template: dispatch_brief_template, fields: fields)
  let session_name = dispatch_tmux_session_name(node_id: node.node)
  let worktree_path = dispatch_worktree_path_for_instance(
    instance: instance,
    node_id: node.node,
    attempt_key: attempt_key,
  )
  let branch_name = dispatch_branch_name(node_id: node.node, attempt_key: attempt_key)
  match dispatch_provider_inner_argv_for_instance(
    instance: instance,
    provider: provider,
    effort: effort,
    session_uuid: session_uuid,
    node_id: node.node,
    worktree_path: worktree_path,
    brief: brief,
  ) {
    CursorProviderSpawnUnwired { reason } =>
      DispatchSpawnRefused {
        step: "cursor-provider-spawn" as std.types.NonEmptyStr,
        detail: reason as String,
      }
    CodexProviderExecutableAbsent { reason } =>
      DispatchSpawnRefused {
        step: "codex-executable-placement" as std.types.NonEmptyStr,
        detail: reason as String,
      }
    DispatchProviderInnerArgvReady { argv: provider_inner } => {
  let worktree = git_worktree_add_argv_for_instance(
    instance: instance,
    worktree_path: worktree_path,
    branch_name: branch_name,
    remote_ref: instance.dispatch_base_ref as String,
  )
  let state_prepare = attempt_state_prepare_argv_for_instance(
    instance: instance,
    node_id: node.node,
    attempt_key: attempt_key,
  )
  let tmux = tmux_idle_spawn_argv_for_instance(
    instance: instance,
    session_name: session_name,
    worktree_path: worktree_path,
  )
  let events_path = dispatch_attempt_events_path_for_instance(
    instance: instance,
    node_id: node.node,
    attempt_key: attempt_key,
  )
  match dispatch_attempt_pipe_emission_for_instance(
    instance: instance,
    events_path: events_path,
  ) {
    PipeEmitRefused { detail } =>
      DispatchSpawnRefused {
        step: "tmux-event-pipe-emit" as std.types.NonEmptyStr,
        detail: detail,
      }
    PipeEmitted { command } =>
      DispatchSpawnReady {
        commands: DispatchSpawnCommands {
          worktree_add: worktree,
          attempt_state_prepare: state_prepare,
          attempt_current_pointer: attempt_current_pointer_argv_for_instance(
            instance: instance,
            node_id: node.node,
            attempt_key: attempt_key,
          ),
          tmux_spawn: tmux,
          tmux_default_shell: tmux_attempt_default_shell_argv_for_instance(
            instance: instance,
            session_name: session_name,
          ),
          tmux_remain_on_exit: tmux_attempt_remain_argv_for_instance(
            instance: instance,
            session_name: session_name,
          ),
          tmux_event_pipe: tmux_attempt_pipe_argv_for_command(
            instance: instance,
            session_name: session_name,
            command: command,
          ),
          provider_start: tmux_attempt_provider_start_argv_for_instance(
            instance: instance,
            session_name: session_name,
            inner_argv: provider_inner,
          ),
        },
      }
    }
    }
  }
}

fn dispatch_spawn_commands(node: gunbc.roadmap_model.RoadmapNode, session_uuid: String, attempt_key: String) -> DispatchSpawnPlan {
  dispatch_spawn_commands_for_instance(
    instance: srv1_live_dashboard_instance(),
    node: node,
    session_uuid: session_uuid,
    attempt_key: attempt_key,
    request: default_provider_selection_request(),
  )
}

fn filter_dispatch_tmux_sessions(entries: List<extdeps.tmux.TmuxLsEntry>) -> List<extdeps.tmux.TmuxLsEntry> {
  entries |> filter(e => starts_with(s: e.session_name, prefix: dispatch_tmux_session_prefix))
}

fn tmux_session_observation_for_scope(
  scope: TmuxSessionScope,
  entries: List<extdeps.tmux.TmuxLsEntry>,
) -> TmuxSessionObservation {
  let scoped_name = scope.session_name as String
  let matched = entries |> filter(e => e.session_name == scoped_name)
  if count(matched) == 0 {
    SessionAbsent
  } else {
    let e = matched.first()
    SessionNameObserved {
      session_name: scope.session_name,
      windows: e.windows,
    }
  }
}

fn classify_tmux_session(
  scope: TmuxSessionScope,
  obs: TmuxSessionObservation,
) -> std.upsert_decision.ObservationVerdict {
  match obs {
    SessionAbsent => Absent
    SessionInaccessible => Inaccessible
    SessionNameObserved {
      session_name: name,
      windows: _,
    } =>
      if (name as String) != (scope.session_name as String) {
        Inaccessible
      } else {
        UnknownRefused
      }
    SessionObserved {
      session_name: name,
      windows: _,
      process_fingerprint: fingerprint,
    } =>
      if (name as String) != (scope.session_name as String) {
        Inaccessible
      } else {
        if fingerprint == scope.expected_process_fingerprint {
          Converged
        } else {
          Conflict
        }
      }
    SessionObservedStaleExpected {
      session_name: name,
      windows: _,
      process_fingerprint: fingerprint,
      stale_reason: _,
    } =>
      if (name as String) != (scope.session_name as String) {
        Inaccessible
      } else {
        if fingerprint == scope.expected_process_fingerprint {
          Drifted
        } else {
          Conflict
        }
      }
  }
}

fn decision_for_dispatch_lease_verdict(
  verdict: std.upsert_decision.ObservationVerdict,
) -> UpsertDecision<DispatchLeasePlan> {
  match verdict {
    Converged => std.upsert_decision.Refuse { reason: "dispatch session already running for node" as std.types.NonEmptyStr }
    Absent => std.upsert_decision.Apply { plan: SpawnSession }
    Drifted => std.upsert_decision.Apply { plan: DrainStaleThenSpawn }
    Conflict => std.upsert_decision.Refuse { reason: "foreign tmux session owns dispatch slot" as std.types.NonEmptyStr }
    Inaccessible => std.upsert_decision.Refuse { reason: "tmux session inaccessible" as std.types.NonEmptyStr }
    UnknownRefused =>
      std.upsert_decision.Refuse { reason: "dispatch session name occupied; process fingerprint unobserved" as std.types.NonEmptyStr }
  }
}

fn classify_dispatch_lease_upsert(
  scope: TmuxSessionScope,
  obs: TmuxSessionObservation,
) -> std.upsert_decision.UpsertClassification<DispatchLeasePlan> {
  let verdict = classify_tmux_session(scope: scope, obs: obs)
  std.upsert_decision.UpsertClassification {
    verdict: verdict,
    decision: decision_for_dispatch_lease_verdict(verdict: verdict),
  }
}

fn node_in_ready(node_id: gunbc.roadmap_model.RoadmapNodeId, ready: List<gunbc.roadmap_model.RoadmapNode>) -> Bool {
  any(ready, n => n.node == node_id)
}

fn node_repo_supported(node: gunbc.roadmap_model.RoadmapNode) -> Bool {
  match node.sizing {
    Sized { repo, intricacy: _, volume: _, acceptance: _ } => repo == dispatch_repo
    Unsized => false
  }
}

fn dispatch_permitted_from_selection(
  node: gunbc.roadmap_model.RoadmapNode,
  attempt_key: String,
  effort: extdeps.llm.cli.ReasoningEffort,
) -> DispatchRequestGate {
  DispatchPermitted {
    session_name: dispatch_tmux_session_name(node_id: node.node),
    worktree_path: dispatch_worktree_path(node_id: node.node, attempt_key: attempt_key),
    branch_name: dispatch_branch_name(node_id: node.node, attempt_key: attempt_key),
    brief: filled_dispatch_brief_for_node(node: node),
    reasoning_effort: effort,
  }
}

fn classify_dispatch_request_for_process_fingerprint(
  node: gunbc.roadmap_model.RoadmapNode,
  ready: List<gunbc.roadmap_model.RoadmapNode>,
  tmux_entries: List<extdeps.tmux.TmuxLsEntry>,
  attempt_key: String,
  process_fingerprint: std.types.NonEmptyStr,
  effort: extdeps.llm.cli.ReasoningEffort,
) -> DispatchRequestGate {
  if !node_in_ready(node_id: node.node, ready: ready) {
    DispatchRefused { reason: "node not in ready frontier" as std.types.NonEmptyStr }
  } else {
    if !node_repo_supported(node: node) {
      DispatchRefused { reason: "repo not supported on srv1 mvp" as std.types.NonEmptyStr }
    } else {
      let scope = dispatch_tmux_session_scope_for_process_fingerprint(
        node_id: node.node,
        process_fingerprint: process_fingerprint,
      )
      let obs = tmux_session_observation_for_scope(scope: scope, entries: tmux_entries)
      match classify_dispatch_lease_upsert(scope: scope, obs: obs) {
        UpsertClassification { verdict: _, decision: Refuse { reason } } =>
          DispatchRefused { reason: reason }
        UpsertClassification { verdict: _, decision: Noop } =>
          DispatchRefused { reason: "dispatch session already running for node" as std.types.NonEmptyStr }
        UpsertClassification { verdict: _, decision: Apply { plan: _ } } =>
          dispatch_permitted_from_selection(
            node: node,
            attempt_key: attempt_key,
            effort: effort,
          )
      }
    }
  }
}

fn classify_dispatch_request(
  node: gunbc.roadmap_model.RoadmapNode,
  ready: List<gunbc.roadmap_model.RoadmapNode>,
  tmux_entries: List<extdeps.tmux.TmuxLsEntry>,
  attempt_key: String,
) -> DispatchRequestGate {
  if !node_in_ready(node_id: node.node, ready: ready) {
    DispatchRefused { reason: "node not in ready frontier" as std.types.NonEmptyStr }
  } else {
    if !node_repo_supported(node: node) {
      DispatchRefused { reason: "repo not supported on srv1 mvp" as std.types.NonEmptyStr }
    } else {
      match dispatch_actuator_selection(node_sizing: node.sizing) {
        DispatchActuatorSelectionRefused { reason } =>
          DispatchRefused { reason: reason }
        DispatchActuatorSelectionOk { provider: _, effort, process_fingerprint } =>
          classify_dispatch_request_for_process_fingerprint(
            node: node,
            ready: ready,
            tmux_entries: tmux_entries,
            attempt_key: attempt_key,
            process_fingerprint: process_fingerprint,
            effort: effort,
          )
      }
    }
  }
}

fn dispatch_node_id_from_session_name(session_name: String) -> String {
  if starts_with(s: session_name, prefix: dispatch_tmux_session_prefix) {
    substring(
      s: session_name,
      start: string_length(s: dispatch_tmux_session_prefix),
      end: string_length(s: session_name),
    )
  } else {
    ""
  }
}

fn dispatch_live_session_row_for_scope(
  entry: extdeps.tmux.TmuxLsEntry,
  scope: TmuxSessionScope,
  instance: extdeps.llm.cli_lifecycle.ProviderInstance,
) -> DispatchLiveSession {
  let obs = SessionNameObserved {
    session_name: entry.session_name as std.types.NonEmptyStr,
    windows: entry.windows,
  }
  DispatchLiveSession {
    session_name: entry.session_name,
    node_id: dispatch_node_id_from_session_name(session_name: entry.session_name),
    windows: entry.windows,
    lease_verdict: classify_tmux_session(scope: scope, obs: obs),
    worker: worker_observation_without_provider_probe(instance: instance),
  }
}

fn live_session_row(entry: extdeps.tmux.TmuxLsEntry, scope: TmuxSessionScope) -> DispatchLiveSession? {
  match dispatch_worker_observation() {
    Present { value: worker } => {
      let obs = SessionNameObserved {
        session_name: entry.session_name as std.types.NonEmptyStr,
        windows: entry.windows,
      }
      Present {
        value: DispatchLiveSession {
          session_name: entry.session_name,
          node_id: dispatch_node_id_from_session_name(session_name: entry.session_name),
          windows: entry.windows,
          lease_verdict: classify_tmux_session(scope: scope, obs: obs),
          worker: worker,
        }
      }
    }
    none => none
  }
}

fn dispatch_tmux_session_scope_for_live_session(sess: DispatchLiveSession) -> TmuxSessionScope? {
  let node_id = sess.node_id as gunbc.roadmap_model.RoadmapNodeId
  match sess.worker.configured_provider.kind {
    CodexCliProvider =>
      match sess.worker.process {
        WorkerProcessRunning { command } =>
          Present {
            value: dispatch_tmux_session_scope_for_process_fingerprint(
              node_id: node_id,
              process_fingerprint: command as std.types.NonEmptyStr,
            ),
          }
        WorkerProcessExited { exit_code: _, last_command } =>
          Present {
            value: dispatch_tmux_session_scope_for_process_fingerprint(
              node_id: node_id,
              process_fingerprint: if last_command == "" {
                "retained-exit" as std.types.NonEmptyStr
              } else {
                last_command as std.types.NonEmptyStr
              },
            ),
          }
        _ => none
      }
    ClaudeCliProvider =>
      Present {
        value: dispatch_tmux_session_scope_for_process_fingerprint(
          node_id: sess.node_id as gunbc.roadmap_model.RoadmapNodeId,
          process_fingerprint: dispatch_claude_process_fingerprint,
        ),
      }
    CursorCliProvider =>
      Present {
        value: dispatch_tmux_session_scope_for_process_fingerprint(
          node_id: sess.node_id as gunbc.roadmap_model.RoadmapNodeId,
          process_fingerprint: dispatch_cursor_process_fingerprint,
        ),
      }
  }
}

fn dispatch_session_cleanup_for_live_session(sess: DispatchLiveSession) -> DispatchSessionCleanup {
  match dispatch_tmux_session_scope_for_live_session(sess: sess) {
    Present { value: scope } => dispatch_session_cleanup(scope: scope, session: sess)
    Absent =>
      DispatchCleanupRefused {
        reason: "cleanup scope unavailable from session worker process evidence",
      }
  }
}

fn dispatch_live_session_for_entry(entry: extdeps.tmux.TmuxLsEntry) -> DispatchLiveSession? {
  let node_id = dispatch_node_id_from_session_name(session_name: entry.session_name)
  match dispatch_tmux_session_scope(node_id: node_id as gunbc.roadmap_model.RoadmapNodeId) {
    Present { value: scope } => live_session_row(entry: entry, scope: scope)
    Absent => none
  }
}

fn append_present_live_session(
  acc: List<DispatchLiveSession>,
  entry: extdeps.tmux.TmuxLsEntry,
) -> List<DispatchLiveSession> {
  match dispatch_live_session_for_entry(entry: entry) {
    Present { value: row } => concat(acc, [row])
    Absent => acc
  }
}

fn dispatch_live_sessions_from_entries(
  entries: List<extdeps.tmux.TmuxLsEntry>,
) -> List<DispatchLiveSession> {
  fold(
    filter_dispatch_tmux_sessions(entries: entries),
    init: [],
    f: fn(acc, e) { append_present_live_session(acc: acc, entry: e) },
  )
}

data dispatch_attempt_refs_note: String = "U3 (result surfacing): the attempt branches ARE the results ledger — every spawn mints dispatch/<node>-a<key> (U1), so listing refs/heads/dispatch/ observes every attempt ever made, including pre-attempt-grain LEGACY branches (attempt_key empty — the operator's accidental ts-authority-converge spawn is one), which are real attempts and render as such, never filtered as noise. Parse discriminates by the LAST -a segment being exactly 16 chars (the content-hash key width); a node id that itself ends in -a<16 chars> would misparse — accepted and named, not papered over: node ids are roadmap-authored and none has that shape. Empty-node branches are rejected before constructing DispatchAttemptRef, whose node and branch are non-empty by construction; malformed debris cannot invalidate the whole attempts projection. v0 renders branch NAMES (copyable, true), never tree links that would be dead until a push — a dead link is a fabricated result; the PR half lands when push/PR state is observed, not guessed."

type DispatchAttemptRef {
  node_id: std.types.NonEmptyStr
  branch: std.types.NonEmptyStr
  attempt_key: String
}

fn dispatch_attempt_evidence(attempt: DispatchAttemptRef) -> gunbc.worker_lifecycle.AttemptEvidence {
  gunbc.worker_lifecycle.AttemptEvidence {
    node_id: attempt.node_id,
    attempt_key: attempt.attempt_key,
    branch: attempt.branch,
    worktree: gunbc.worker_lifecycle.WorktreeUnobserved {
      reason: "branch observation does not inspect the attempt worktree" as std.types.NonEmptyStr,
    },
    provider_instance: gunbc.worker_lifecycle.ProviderEvidenceUnobserved {
      reason: "branch observation does not identify the provider instance" as std.types.NonEmptyStr,
    },
    process_identity: gunbc.worker_lifecycle.ProcessIdentityUnobserved {
      reason: "branch observation does not inspect PID, start time, or ownership" as std.types.NonEmptyStr,
    },
    transcript: gunbc.worker_lifecycle.TranscriptUnobserved {
      reason: "branch observation does not locate a provider transcript" as std.types.NonEmptyStr,
    },
    terminal_outcome: gunbc.worker_lifecycle.TerminalOutcomeUnobserved {
      reason: "branch existence does not imply a terminal outcome" as std.types.NonEmptyStr,
    },
  }
}

fn parse_dispatch_attempt_branch(line: String) -> DispatchAttemptRef? {
  if string_contains(s: line, pattern: "dispatch/") {
    let rest = substring(s: line, start: 9, end: string_length(s: line))
    if rest == "" {
      none
    } else {
      let segs = split(s: rest, delimiter: "-a")
      let last = segs |> fold(init: "", f: (acc, x) => x)
      if count(segs) >= 2 && string_length(s: last) == 16 {
        let node_id = substring(s: rest, start: 0, end: string_length(s: rest) - 18)
        if node_id == "" {
          none
        } else {
          Present { value: DispatchAttemptRef {
            node_id: node_id as std.types.NonEmptyStr,
            branch: line as std.types.NonEmptyStr,
            attempt_key: last,
          } }
        }
      } else {
        Present { value: DispatchAttemptRef {
          node_id: rest as std.types.NonEmptyStr,
          branch: line as std.types.NonEmptyStr,
          attempt_key: "",
        } }
      }
    }
  } else {
    none
  }
}

fn dispatch_attempt_refs(git_output: String) -> List<DispatchAttemptRef> {
  fold(
    split(s: git_output, delimiter: "\n"),
    init: [],
    f: (acc, line) => match parse_dispatch_attempt_branch(line: line) {
      Present { value: r } => append(acc, [r])
      Absent => acc
    },
  )
}

fn git_for_each_ref_dispatch_argv() -> HostExecArgv {
  host_exec_argv(program: "git", args: ["for-each-ref", "--format=%(refname:short)", "refs/heads/dispatch/"])
}

fn git_for_each_ref_dispatch_argv_for_instance(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
