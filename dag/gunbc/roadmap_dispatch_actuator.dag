type DispatchProviderInnerArgv
  = DispatchProviderInnerArgvReady { argv: List<String> }
  | CodexProviderExecutableAbsent { reason: std.types.NonEmptyStr }
  | CursorProviderSpawnUnwired { reason: std.types.NonEmptyStr }

data cursor_provider_spawn_unwired_reason: std.types.NonEmptyStr = "cursor dispatch inner argv is not wired on this actuator path" as std.types.NonEmptyStr

fn dispatch_provider_inner_argv(
  provider: DispatchCliProvider,
  effort: extdeps.llm.cli.ReasoningEffort,
  session_uuid: String,
  node_id: gunbc.roadmap_model.RoadmapNodeId,
  worktree_path: String,
  brief: String,
) -> DispatchProviderInnerArgv {
  match provider {
    ClaudeCodeProvider =>
      DispatchProviderInnerArgvReady {
        argv: concat(
          ["env", "CLAUDE_CODE_NO_FLICKER=1"],
          claude_spawn_argv(
            effort: effort,
            session_uuid: session_uuid,
            node_id: node_id,
            brief: brief,
          ),
        ),
      }
    CodexDispatchProvider =>
      DispatchProviderInnerArgvReady {
        argv: codex_spawn_argv(
          effort: effort,
          worktree_path: worktree_path,
          brief: brief,
        ),
      }
    CursorDispatchProvider =>
      CursorProviderSpawnUnwired { reason: cursor_provider_spawn_unwired_reason }
  }
}

fn dispatch_provider_inner_argv_for_instance(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  provider: DispatchCliProvider,
  effort: extdeps.llm.cli.ReasoningEffort,
  session_uuid: String,
  node_id: gunbc.roadmap_model.RoadmapNodeId,
  worktree_path: String,
  brief: String,
) -> DispatchProviderInnerArgv {
  match provider {
    ClaudeCodeProvider =>
      DispatchProviderInnerArgvReady {
        argv: concat(
          [
            dispatch_capability_program(
              environment: instance.execution_environment,
              cap: EnvironmentBindingCapability,
            ),
            "CLAUDE_CODE_NO_FLICKER=1",
          ],
          claude_spawn_argv(
            effort: effort,
            session_uuid: session_uuid,
            node_id: node_id,
            brief: brief,
          ),
        ),
      }
    CodexDispatchProvider =>
      match dashboard_instance_provider_executable(instance: instance) {
        Absent =>
          CodexProviderExecutableAbsent {
            reason: dashboard_instance_provider_executable_refusal_detail(instance: instance) as std.types.NonEmptyStr,
          }
        Present { value: codex_program } =>
          DispatchProviderInnerArgvReady {
            argv: shape_codex_exec_argv_for_programs(
              env_program: dispatch_capability_program(
                environment: instance.execution_environment,
                cap: EnvironmentBindingCapability,
              ),
              program: codex_program as String,
              codex_home: dashboard_instance_provider_state_root(instance: instance) as String,
              cwd: worktree_path,
              prompt: join([brief, "\n\n", dispatch_codex_start_prompt], ""),
              reasoning_effort: effort,
              spec: dispatch_codex_exec_spec,
            ),
          }
      }
    CursorDispatchProvider =>
      CursorProviderSpawnUnwired { reason: cursor_provider_spawn_unwired_reason }
  }
}

