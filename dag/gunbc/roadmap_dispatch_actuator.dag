fn carrier_paths_label(carriers: List<Pointer>, repo: String) -> String {
  if count(carriers) == 0 {
    concat("dag/gunbc/roadmap_dispatch_actuator.dag (repo=", concat(repo, ")"))
  } else {
    join(map(carriers, p => p.path), " · ")
  }
}

fn dispatch_slot_fields(node: RoadmapNode, repo: String) -> DispatchBriefFields {
  let title = node_title(item: node.line)
  match line_ticket(item: node.line) {
    Present { value: t } =>
      DispatchBriefFields {
        node_id: node.node,
        title: title,
        repo: repo,
        intricacy_label: "",
        volume_label: "",
        displaced_cost: t.displaced_cost,
        current_state: t.current_state,
        first_slice: t.first_slice,
        red_control: t.red_control,
        out_of_scope: t.out_of_scope,
        handback: t.handback,
        paths: carrier_paths_label(carriers: node.carriers, repo: repo),
        commands_to_run: "",
        expected_artifact: "",
      }
    Absent =>
      DispatchBriefFields {
        node_id: node.node,
        title: title,
        repo: repo,
        intricacy_label: "",
        volume_label: "",
        displaced_cost: title,
        current_state: title,
        first_slice: title,
        red_control: "drop modeled argv row and witness goes red",
        out_of_scope: "see parent roadmap dispatch plan",
        handback: "node not ready, foreign lease, or unsupported repo",
        paths: carrier_paths_label(carriers: node.carriers, repo: repo),
        commands_to_run: "",
        expected_artifact: "",
      }
  }
}

fn dispatch_brief_fields_for_environment(
  node: RoadmapNode,
  environment: DispatchHostEnvironment,
) -> DispatchBriefFields {
  let validation = execution_contract_validation_summary(
    contract: node.execution,
    environment: environment,
  )
  match node.sizing {
  Sized { intricacy, volume, repo, acceptance: _ } => {
    let f = dispatch_slot_fields(node: node, repo: repo)
    DispatchBriefFields {
      node_id: f.node_id,
      title: f.title,
      repo: repo,
      intricacy_label: intricacy_label(i: intricacy),
      volume_label: volume_label(v: volume),
      displaced_cost: f.displaced_cost,
      current_state: f.current_state,
      first_slice: f.first_slice,
      red_control: f.red_control,
      out_of_scope: f.out_of_scope,
      handback: f.handback,
      paths: f.paths,
      commands_to_run: validation,
      expected_artifact: "implementation diff plus receipts from the declared validation operations",
    }
  }
  Unsized => {
    let f = dispatch_slot_fields(node: node, repo: "")
    DispatchBriefFields {
      node_id: f.node_id,
      title: f.title,
      repo: "",
      intricacy_label: "unsized",
      volume_label: "unsized",
      displaced_cost: f.displaced_cost,
      current_state: f.current_state,
      first_slice: f.first_slice,
      red_control: f.red_control,
      out_of_scope: f.out_of_scope,
      handback: f.handback,
      paths: f.paths,
      commands_to_run: validation,
      expected_artifact: "implementation diff plus receipts from the declared validation operations",
    }
  }
  }
}

fn dispatch_brief_fields(node: RoadmapNode) -> DispatchBriefFields {
  dispatch_brief_fields_for_environment(
    node: node,
    environment: srv1_live_dashboard_instance().execution_environment,
  )
}

fn fill_dispatch_brief(template: String, fields: DispatchBriefFields) -> String {
  template
    .replace(from: "<node_id>", to: fields.node_id)
    .replace(from: "<displaced cost / what it unblocks>", to: fields.displaced_cost)
    .replace(from: "<explicitly out of scope>", to: fields.out_of_scope)
    .replace(from: "<prove current state / reproduce the gap>", to: fields.current_state)
    .replace(from: "<first implementation slice>", to: fields.first_slice)
    .replace(from: "<perturbation that goes red>", to: fields.red_control)
    .replace(from: "<execution on the real path>", to: fields.commands_to_run)
    .replace(from: "<named hand-back conditions>", to: fields.handback)
    .replace(from: "<paths>", to: fields.paths)
    .replace(from: "<repro/verify commands>", to: fields.commands_to_run)
    .replace(from: "<what comes back even if the fix does not land>", to: fields.expected_artifact)
}

fn filled_dispatch_brief_for_node(node: RoadmapNode) -> String {
  fill_dispatch_brief(
    template: dispatch_brief_template,
    fields: dispatch_brief_fields(node: node),
  )
}

fn host_exec_argv(program: String, args: List<String>) -> HostExecArgv {
  HostExecArgv { program: program, args: args }
}

fn git_worktree_add_argv(worktree_path: String, branch_name: String, remote_ref: String) -> HostExecArgv {
  host_exec_argv(
    program: "git",
    args: shape_git_worktree_add_argv(
      path: worktree_path as FilePath,
      branch: branch_name as NonEmptyStr,
      remote_ref: remote_ref as GitRef,
    ),
  )
}

fn git_worktree_add_argv_for_instance(
  instance: HostDashboardInstance,
