data dispatch_tmux_process_fingerprint_observation_dissolution_trigger: Disposition = Terminal {
  reason: "DISSOLVED (U4, 2026-07-25): the pane-fingerprint observation landed — tmux list-panes with the cited format variables feeds tmux_session_observation_with_panes, so SessionObserved carries pane_current_command and the lease classification's Converged/Conflict arms are reachable by observation, not only by fixture. The R5 owned-only teardown gate (dispatch_stop_gate) is its first live consumer." as NonEmptyStr
}

data dispatch_repo: String = "gunbc"

data dispatch_worktree_root_note: String = "PROJECTION of gunbc.host_layout.srv1_dispatch_worktree_root — the single path authority shared with the live_deploy membership that provisions the directory (DESIGN §3; its former private copy deleted, belt-B lane 2026-07-20)."

data dispatch_worktree_root: String = srv1_dispatch_worktree_root as String
data dispatch_git_remote_ref: String = gunbc_merge_target_ref as String
data dispatch_tmux_session_prefix: String = "gunbc-dispatch-"
data dispatch_claude_fingerprint_finding_note: String = "NAMED FINDING (U4 live drive, macOS, 2026-07-25): pane_current_command is the kernel process name (p_comm) — symlinks resolve and exec -a cannot fake it, which is exactly the anti-spoof property R5 wants — BUT a REAL running claude CLI on this macOS reported its VERSION STRING (2.1.220) as p_comm, not claude (node process.title). So the Converged green path may not fire on real workers until the fingerprint a real srv1 spawned session reports is READ, not guessed. The refuse arms are unaffected (they are the safety half and were proven live four ways). DECIDE-BY-RECEIPT: run tmux list-panes on srv1 beside a live dispatch session; if it reports claude this row stands; if it reports a version-or-node name, this row becomes the observed value (or an accepted set) — a data edit, never a code change."

data dispatch_claude_process_fingerprint: NonEmptyStr = "claude" as NonEmptyStr
data claude_skip_permission_settings_json: String = "{\"skipDangerousModePermissionPrompt\":true}"
data dispatch_claude_start_prompt: String = "Begin working on the assigned node."
data dispatch_claude_permission_args: List<String> = ["--dangerously-skip-permissions"]

type HostExecArgv {
  program: String
  args: List<String>
}

type DispatchBriefFields {
  node_id: String
  title: String
  repo: String
  intricacy_label: String
  volume_label: String
  displaced_cost: String
  current_state: String
  first_slice: String
  red_control: String
  out_of_scope: String
  handback: String
  paths: String
}

data dispatch_brief_slot_note: String = "The template's workflow slots are REAL fields when the node is a TicketLine (remodel W2: the template was always the spec of the schema — its slot names became TicketFields), and honest stubs only on the legacy prose frontier: a legacy row's brief still repeats the title where a fact should be, which is exactly the burn-down pressure W2-bulk answers. A ticket node's brief carries its own displaced cost, current state, first slice, RED, scope, and hand-back conditions; paths come from the node's carriers."

type TmuxLsEntry {
  session_name: String
  windows: Int
}

type TmuxSessionScope {
  session_name: NonEmptyStr
  expected_owner_label: NonEmptyStr
  expected_process_fingerprint: NonEmptyStr
}

type TmuxSessionObservation
  = SessionAbsent
  | SessionNameObserved {
      session_name: NonEmptyStr
      windows: Int
    }
  | SessionObserved {
      session_name: NonEmptyStr
      windows: Int
      process_fingerprint: NonEmptyStr
    }
  | SessionObservedStaleExpected {
      session_name: NonEmptyStr
      windows: Int
      process_fingerprint: NonEmptyStr
      stale_reason: NonEmptyStr
    }
  | SessionInaccessible

type DispatchLeasePlan
  = SpawnSession
  | DrainStaleThenSpawn
  | RefuseForeignSession

type DispatchRequestGate
  = DispatchPermitted {
      session_name: String
      worktree_path: String
      branch_name: String
      brief: String
      claude_effort: String
    }
  | DispatchRefused { reason: NonEmptyStr }

type DispatchLiveSession {
  session_name: String
  node_id: String
  windows: Int
  lease_verdict: ObservationVerdict
  worker: WorkerObservation
}

data dispatch_provider_instance_note: String = "The configured provider instance is known from the actuator plan, not guessed from one process command. Claude is the only dispatch provider today and its executable comes from extdeps.llm.cli.claude_cli_program. The tmux observation does not read hostname, version, state/auth directory, credential storage, or service identity, so each stays explicitly Unobserved; filling any from deployment prose would fabricate live evidence. A later provider-instance probe replaces those arms independently."

fn dispatch_provider_instance() -> ProviderInstance {
  ProviderInstance {
    kind: ClaudeCliProvider,
    host: ProviderInstanceFieldUnobserved {
      reason: "session observation does not read host identity" as NonEmptyStr,
    },
    executable: claude_cli_program as NonEmptyStr,
    observed_version: ProviderInstanceFieldUnobserved {
      reason: "session observation does not execute the provider version probe" as NonEmptyStr,
    },
    state_directory: ProviderInstanceFieldUnobserved {
      reason: "session observation does not inspect provider state" as NonEmptyStr,
    },
    credential_storage_method: ProviderInstanceFieldUnobserved {
      reason: "session observation does not inspect credential storage" as NonEmptyStr,
    },
    service_identity: ProviderInstanceFieldUnobserved {
      reason: "session observation does not read process ownership" as NonEmptyStr,
    },
  }
}

fn dispatch_worker_observation() -> WorkerObservation {
  worker_observation_without_provider_probe(instance: dispatch_provider_instance())
}

fn intricacy_label(i: Intricacy) -> String {
  match i {
    IntricacyLow => "low"
    IntricacyMedium => "medium"
    IntricacyHigh => "high"
  }
}

fn volume_label(v: Volume) -> String {
  match v {
    VolumeSmall => "small"
    VolumeMedium => "medium"
    VolumeLarge => "large"
  }
}

fn claude_effort_for_intricacy(i: Intricacy) -> String {
  match i {
    IntricacyHigh => "high"
    IntricacyMedium => "medium"
    IntricacyLow => "medium"
  }
}

fn dispatch_tmux_session_name(node_id: RoadmapNodeId) -> String {
  concat(dispatch_tmux_session_prefix, node_id)
}

data dispatch_attempt_note: String = "Dispatch is ATTEMPT-grain (U1, the redispatch fix, 2026-07-25; the operator's accidental spawn was the live receipt): branch, worktree, and claude session-id carry an attempt key derived from (node_id x the spawn's clock observation) through std.content_hash — so a stopped attempt's debris never collides with the next spawn, and NOTHING is deleted to make way (a stopped attempt's worktree may hold uncommitted work, and the rework discipline carries prior diffs forward; cleanup is separate explicit work, never an absorbing arm on spawn). The tmux session name deliberately STAYS node-grain: it is what observe/reconcile key on, so already-live detection, kill, and tick idempotency are untouched — the invariant remains one live session per node. Same-instant duplicate spawns for one node collide on the attempt key and refuse at the git step, typed — fail-closed, and honestly: a same-second double-press IS a refusal-worthy event. A clock refusal refuses the spawn (step attempt-clock), never an unknown-stamped attempt that would collide later."

fn dispatch_attempt_key(node_id: RoadmapNodeId, probed_at: String) -> String {
  content_hash_atom(value: join([node_id as String, "\n", probed_at], "") as NonEmptyStr) as String
}

fn dispatch_worktree_path(node_id: RoadmapNodeId, attempt_key: String) -> String {
  join([dispatch_worktree_root, "/", node_id as String, "-a", attempt_key], "")
}

fn dispatch_branch_name(node_id: RoadmapNodeId, attempt_key: String) -> String {
  join(["dispatch/", node_id as String, "-a", attempt_key], "")
}

fn dispatch_tmux_session_scope(node_id: RoadmapNodeId) -> TmuxSessionScope {
  TmuxSessionScope {
    session_name: dispatch_tmux_session_name(node_id: node_id) as NonEmptyStr,
    expected_owner_label: dispatch_tmux_session_name(node_id: node_id) as NonEmptyStr,
    expected_process_fingerprint: dispatch_claude_process_fingerprint,
  }
}

fn carrier_paths_label(carriers: List<Pointer>, repo: String) -> String {
  if count(carriers) == 0 {
    concat("dag/gunbc/roadmap_dispatch_actuator.dag (repo=", concat(repo, ")"))
  } else {
    join(map(carriers, p => p.path), " · ")
  }
}

fn dispatch_slot_fields(node: RoadmapNode, repo: String) -> DispatchBriefFields {
  let title = node_title(item: node.line)
  match line_ticket(item: node.line) {
    Present { value: t } =>
      DispatchBriefFields {
        node_id: node.node,
        title: title,
        repo: repo,
        intricacy_label: "",
        volume_label: "",
        displaced_cost: t.displaced_cost,
        current_state: t.current_state,
        first_slice: t.first_slice,
        red_control: t.red_control,
        out_of_scope: t.out_of_scope,
        handback: t.handback,
        paths: carrier_paths_label(carriers: node.carriers, repo: repo),
      }
    Absent =>
      DispatchBriefFields {
        node_id: node.node,
        title: title,
        repo: repo,
        intricacy_label: "",
        volume_label: "",
        displaced_cost: title,
        current_state: title,
        first_slice: title,
        red_control: "drop modeled argv row and witness goes red",
        out_of_scope: "see parent roadmap dispatch plan",
        handback: "node not ready, foreign lease, or unsupported repo",
        paths: carrier_paths_label(carriers: node.carriers, repo: repo),
      }
  }
}

fn dispatch_brief_fields(node: RoadmapNode) -> DispatchBriefFields {
  match node.sizing {
  Sized { intricacy, volume, repo, acceptance: _ } => {
    let f = dispatch_slot_fields(node: node, repo: repo)
    DispatchBriefFields {
      node_id: f.node_id,
      title: f.title,
      repo: repo,
      intricacy_label: intricacy_label(i: intricacy),
      volume_label: volume_label(v: volume),
      displaced_cost: f.displaced_cost,
      current_state: f.current_state,
      first_slice: f.first_slice,
      red_control: f.red_control,
      out_of_scope: f.out_of_scope,
      handback: f.handback,
      paths: f.paths,
    }
  }
  Unsized => {
    let f = dispatch_slot_fields(node: node, repo: "")
    DispatchBriefFields {
      node_id: f.node_id,
      title: f.title,
      repo: "",
      intricacy_label: "unsized",
      volume_label: "unsized",
      displaced_cost: f.displaced_cost,
      current_state: f.current_state,
      first_slice: f.first_slice,
      red_control: f.red_control,
      out_of_scope: f.out_of_scope,
      handback: f.handback,
      paths: f.paths,
    }
  }
  }
}

fn fill_dispatch_brief(template: String, fields: DispatchBriefFields) -> String {
  template
    .replace(from: "<node_id>", to: fields.node_id)
    .replace(from: "<displaced cost / what it unblocks>", to: fields.displaced_cost)
    .replace(from: "<explicitly out of scope>", to: fields.out_of_scope)
    .replace(from: "<prove current state / reproduce the gap>", to: fields.current_state)
    .replace(from: "<first implementation slice>", to: fields.first_slice)
    .replace(from: "<perturbation that goes red>", to: fields.red_control)
    .replace(from: "<execution on the real path>", to: "tmux ls shows gunbc-dispatch session on srv1")
    .replace(from: "<named hand-back conditions>", to: fields.handback)
    .replace(from: "<paths>", to: fields.paths)
    .replace(from: "<repro/verify commands>", to: "cargo test roadmap_dispatch_actuator_witness")
    .replace(from: "<what comes back even if the fix does not land>", to: "dispatch argv receipt + witness log")
}

fn filled_dispatch_brief_for_node(node: RoadmapNode) -> String {
  fill_dispatch_brief(
    template: dispatch_brief_template,
    fields: dispatch_brief_fields(node: node),
  )
}

fn host_exec_argv(program: String, args: List<String>) -> HostExecArgv {
  HostExecArgv { program: program, args: args }
}

fn git_worktree_add_argv(worktree_path: String, branch_name: String, remote_ref: String) -> HostExecArgv {
  host_exec_argv(
    program: "git",
    args: shape_git_worktree_add_argv(
      path: worktree_path as FilePath,
      branch: branch_name as NonEmptyStr,
      remote_ref: remote_ref as GitRef,
    ),
  )
}

fn claude_spawn_argv(
  effort: String,
  session_uuid: String,
  node_id: RoadmapNodeId,
  brief: String,
) -> List<String> {
  shape_claude_invoke_argv(
    session_id: session_uuid,
    node_id: node_id,
    effort: effort,
    settings_json: claude_skip_permission_settings_json,
    append_system_prompt: brief,
    start_prompt: dispatch_claude_start_prompt,
    permission_args: dispatch_claude_permission_args,
  )
}

fn tmux_spawn_argv(session_name: String, worktree_path: String, claude_argv: List<String>) -> HostExecArgv {
  host_exec_argv(
    program: "tmux",
    args: shape_tmux_new_session_argv(
      session_name: session_name,
      working_dir: worktree_path,
      inner_argv: concat(["env", "CLAUDE_CODE_NO_FLICKER=1"], claude_argv),
    ),
  )
}

fn tmux_ls_argv() -> HostExecArgv {
  host_exec_argv(program: "tmux", args: shape_tmux_ls_argv())
}

fn tmux_kill_session_argv(session_name: String) -> HostExecArgv {
  host_exec_argv(program: "tmux", args: shape_tmux_kill_session_argv(session_name: session_name))
}

type DispatchSpawnCommands {
  worktree_add: HostExecArgv
  tmux_spawn: HostExecArgv
}

fn dispatch_spawn_commands(node: RoadmapNode, session_uuid: String, attempt_key: String) -> DispatchSpawnCommands {
  let fields = dispatch_brief_fields(node: node)
  let brief = fill_dispatch_brief(template: dispatch_brief_template, fields: fields)
  let effort = match node.sizing {
    Sized { intricacy, volume: _, repo: _, acceptance: _ } => claude_effort_for_intricacy(i: intricacy)
    Unsized => "medium"
  }
  let session_name = dispatch_tmux_session_name(node_id: node.node)
  let worktree_path = dispatch_worktree_path(node_id: node.node, attempt_key: attempt_key)
  let branch_name = dispatch_branch_name(node_id: node.node, attempt_key: attempt_key)
  let worktree = git_worktree_add_argv(
    worktree_path: worktree_path,
    branch_name: branch_name,
    remote_ref: dispatch_git_remote_ref,
  )
  let claude = claude_spawn_argv(
    effort: effort,
    session_uuid: session_uuid,
    node_id: node.node,
    brief: brief,
  )
  let tmux = tmux_spawn_argv(session_name: session_name, worktree_path: worktree_path, claude_argv: claude)
  DispatchSpawnCommands { worktree_add: worktree, tmux_spawn: tmux }
}

fn parse_tmux_ls_windows(rest: String) -> Int {
  let parts = split(s: rest, delimiter: " ")
  match parts.first() {
    Present { value: s } => match parse_int(s) {
      Present { value: n } => n
      Absent => 0
    }
    Absent => 0
  }
}

fn parse_tmux_ls_line(line: String) -> TmuxLsEntry? {
  let trimmed = trim(line)
  if trimmed == "" {
    none
  } else {
    let colon_parts = split(s: trimmed, delimiter: ":")
    let name = match colon_parts.first() {
      Present { value: s } => trim(s)
      Absent => ""
    }
    if name == "" {
      none
    } else {
      let rest = match colon_parts.skip(n: 1).first() {
        Present { value: s } => trim(s)
        Absent => ""
      }
      Present {
        value: TmuxLsEntry {
          session_name: name,
          windows: parse_tmux_ls_windows(rest: rest),
        },
      }
    }
  }
}

fn parse_tmux_ls_output(output: String) -> List<TmuxLsEntry> {
  fold(
    split(s: output, delimiter: "\n"),
    init: [],
    f: (acc, line) => match parse_tmux_ls_line(line: line) {
      Present { value: e } => append(acc, [e])
      Absent => acc
    },
  )
}

fn filter_dispatch_tmux_sessions(entries: List<TmuxLsEntry>) -> List<TmuxLsEntry> {
  entries |> filter(e => starts_with(s: e.session_name, prefix: dispatch_tmux_session_prefix))
}

fn tmux_session_observation_for_scope(
  scope: TmuxSessionScope,
  entries: List<TmuxLsEntry>,
) -> TmuxSessionObservation {
  let scoped_name = scope.session_name as String
  let matched = entries |> filter(e => e.session_name == scoped_name)
  if count(matched) == 0 {
    SessionAbsent
  } else {
    let e = matched.first()
    SessionNameObserved {
      session_name: scope.session_name,
      windows: e.windows,
    }
  }
}

fn classify_tmux_session(
  scope: TmuxSessionScope,
  obs: TmuxSessionObservation,
) -> ObservationVerdict {
  match obs {
    SessionAbsent => Absent
    SessionInaccessible => Inaccessible
    SessionNameObserved {
      session_name: name,
      windows: _,
    } =>
      if (name as String) != (scope.session_name as String) {
        Inaccessible
      } else {
        UnknownRefused
      }
    SessionObserved {
      session_name: name,
      windows: _,
      process_fingerprint: fingerprint,
    } =>
      if (name as String) != (scope.session_name as String) {
        Inaccessible
      } else {
        if fingerprint == scope.expected_process_fingerprint {
          Converged
        } else {
          Conflict
        }
      }
    SessionObservedStaleExpected {
      session_name: name,
      windows: _,
      process_fingerprint: fingerprint,
      stale_reason: _,
    } =>
      if (name as String) != (scope.session_name as String) {
        Inaccessible
      } else {
        if fingerprint == scope.expected_process_fingerprint {
          Drifted
        } else {
          Conflict
        }
      }
  }
}

fn decision_for_dispatch_lease_verdict(
  verdict: ObservationVerdict,
) -> UpsertDecision<DispatchLeasePlan> {
  match verdict {
    Converged => Refuse { reason: "dispatch session already running for node" as NonEmptyStr }
    Absent => Apply { plan: SpawnSession }
    Drifted => Apply { plan: DrainStaleThenSpawn }
    Conflict => Refuse { reason: "foreign tmux session owns dispatch slot" as NonEmptyStr }
    Inaccessible => Refuse { reason: "tmux session inaccessible" as NonEmptyStr }
    UnknownRefused =>
      Refuse { reason: "dispatch session name occupied; process fingerprint unobserved" as NonEmptyStr }
  }
}

fn classify_dispatch_lease_upsert(
  scope: TmuxSessionScope,
  obs: TmuxSessionObservation,
) -> UpsertClassification<DispatchLeasePlan> {
  let verdict = classify_tmux_session(scope: scope, obs: obs)
  UpsertClassification {
    verdict: verdict,
    decision: decision_for_dispatch_lease_verdict(verdict: verdict),
  }
}

fn node_in_ready(node_id: RoadmapNodeId, ready: List<RoadmapNode>) -> Bool {
  any(ready, n => n.node == node_id)
}

fn node_repo_supported(node: RoadmapNode) -> Bool {
  match node.sizing {
    Sized { repo, intricacy: _, volume: _, acceptance: _ } => repo == dispatch_repo
    Unsized => false
  }
}

fn dispatch_permitted_for_node(node: RoadmapNode, attempt_key: String) -> DispatchRequestGate {
  let brief = filled_dispatch_brief_for_node(node: node)
  let effort = match node.sizing {
    Sized { intricacy, volume: _, repo: _, acceptance: _ } =>
      claude_effort_for_intricacy(i: intricacy)
    Unsized => "medium"
  }
  DispatchPermitted {
    session_name: dispatch_tmux_session_name(node_id: node.node),
    worktree_path: dispatch_worktree_path(node_id: node.node, attempt_key: attempt_key),
    branch_name: dispatch_branch_name(node_id: node.node, attempt_key: attempt_key),
    brief: brief,
    claude_effort: effort,
  }
}

fn classify_dispatch_request(
  node: RoadmapNode,
  ready: List<RoadmapNode>,
  tmux_entries: List<TmuxLsEntry>,
  attempt_key: String,
) -> DispatchRequestGate {
  if !node_in_ready(node_id: node.node, ready: ready) {
    DispatchRefused { reason: "node not in ready frontier" as NonEmptyStr }
  } else {
    if !node_repo_supported(node: node) {
      DispatchRefused { reason: "repo not supported on srv1 mvp" as NonEmptyStr }
    } else {
      let scope = dispatch_tmux_session_scope(node_id: node.node)
      let obs = tmux_session_observation_for_scope(scope: scope, entries: tmux_entries)
      match classify_dispatch_lease_upsert(scope: scope, obs: obs) {
        UpsertClassification { verdict: _, decision: Refuse { reason } } =>
          DispatchRefused { reason: reason }
        UpsertClassification { verdict: _, decision: Noop } =>
          DispatchRefused { reason: "dispatch session already running for node" as NonEmptyStr }
        UpsertClassification { verdict: _, decision: Apply { plan: _ } } =>
          dispatch_permitted_for_node(node: node, attempt_key: attempt_key)
      }
    }
  }
}

fn dispatch_node_id_from_session_name(session_name: String) -> String {
  if starts_with(s: session_name, prefix: dispatch_tmux_session_prefix) {
    substring(
      s: session_name,
      start: string_length(s: dispatch_tmux_session_prefix),
      end: string_length(s: session_name),
    )
  } else {
    ""
  }
}

fn live_session_row(entry: TmuxLsEntry, scope: TmuxSessionScope) -> DispatchLiveSession {
  let obs = SessionNameObserved {
    session_name: entry.session_name as NonEmptyStr,
    windows: entry.windows,
  }
  DispatchLiveSession {
    session_name: entry.session_name,
    node_id: dispatch_node_id_from_session_name(session_name: entry.session_name),
    windows: entry.windows,
    lease_verdict: classify_tmux_session(scope: scope, obs: obs),
    worker: dispatch_worker_observation(),
  }
}

fn dispatch_live_session_for_entry(entry: TmuxLsEntry) -> DispatchLiveSession {
  let node_id = dispatch_node_id_from_session_name(session_name: entry.session_name)
  let scope = dispatch_tmux_session_scope(node_id: node_id)
  live_session_row(entry: entry, scope: scope)
}

fn dispatch_live_sessions(tmux_ls_output: String) -> List<DispatchLiveSession> {
  let entries = filter_dispatch_tmux_sessions(entries: parse_tmux_ls_output(output: tmux_ls_output))
  entries |> map(e => dispatch_live_session_for_entry(entry: e))
}

data dispatch_attempt_refs_note: String = "U3 (result surfacing): the attempt branches ARE the results ledger — every spawn mints dispatch/<node>-a<key> (U1), so listing refs/heads/dispatch/ observes every attempt ever made, including pre-attempt-grain LEGACY branches (attempt_key empty — the operator's accidental ts-authority-converge spawn is one), which are real attempts and render as such, never filtered as noise. Parse discriminates by the LAST -a segment being exactly 16 chars (the content-hash key width); a node id that itself ends in -a<16 chars> would misparse — accepted and named, not papered over: node ids are roadmap-authored and none has that shape. v0 renders branch NAMES (copyable, true), never tree links that would be dead until a push — a dead link is a fabricated result; the PR half lands when push/PR state is observed, not guessed."

type DispatchAttemptRef {
  node_id: String
  branch: String
  attempt_key: String
}

fn dispatch_attempt_evidence(attempt: DispatchAttemptRef) -> AttemptEvidence {
  AttemptEvidence {
    node_id: attempt.node_id as NonEmptyStr,
    attempt_key: attempt.attempt_key,
    branch: attempt.branch as NonEmptyStr,
    worktree: WorktreeUnobserved {
      reason: "branch observation does not inspect the attempt worktree" as NonEmptyStr,
    },
    provider_instance: ProviderEvidenceUnobserved {
      reason: "branch observation does not identify the provider instance" as NonEmptyStr,
    },
    process_identity: ProcessIdentityUnobserved {
      reason: "branch observation does not inspect PID, start time, or ownership" as NonEmptyStr,
    },
    transcript: TranscriptUnobserved {
      reason: "branch observation does not locate a provider transcript" as NonEmptyStr,
    },
    terminal_outcome: TerminalOutcomeUnobserved {
      reason: "branch existence does not imply a terminal outcome" as NonEmptyStr,
    },
  }
}

fn parse_dispatch_attempt_branch(line: String) -> DispatchAttemptRef? {
  if string_contains(s: line, pattern: "dispatch/") {
    let rest = substring(s: line, start: 9, end: string_length(s: line))
    if rest == "" {
      none
    } else {
      let segs = split(s: rest, delimiter: "-a")
      let last = segs |> fold(init: "", f: (acc, x) => x)
      if count(segs) >= 2 && string_length(s: last) == 16 {
        Present { value: DispatchAttemptRef {
          node_id: substring(s: rest, start: 0, end: string_length(s: rest) - 18),
          branch: line,
          attempt_key: last,
        } }
      } else {
        Present { value: DispatchAttemptRef { node_id: rest, branch: line, attempt_key: "" } }
      }
    }
  } else {
    none
  }
}

fn dispatch_attempt_refs(git_output: String) -> List<DispatchAttemptRef> {
  fold(
    split(s: git_output, delimiter: "\n"),
    init: [],
    f: (acc, line) => match parse_dispatch_attempt_branch(line: line) {
      Present { value: r } => append(acc, [r])
      Absent => acc
    },
  )
}

fn git_for_each_ref_dispatch_argv() -> HostExecArgv {
  host_exec_argv(program: "git", args: ["for-each-ref", "--format=%(refname:short)", "refs/heads/dispatch/"])
}

data dispatch_session_ownership_note: String = "R5 owned-only teardown, session grain: a live dispatch session is teardown-eligible (OUR process) ONLY when its lease verdict is Converged (running with our expected process fingerprint) or Drifted (our fingerprint, stale lease — reap-able stale-ours, matching decision_for_dispatch_lease_verdict's DrainStale). Conflict (foreign process), Inaccessible, UnknownRefused, Absent are NOT owned. Name-only tmux-ls observation yields UnknownRefused/Inaccessible only, so teardown FAIL-CLOSED-REFUSES until the observation carries a process fingerprint — correct R5 (no ownership proof, no reap). This owned-ness judgment lives HERE (the actuator owns lease/ownership classification, §3) as a Bool; gunbc.roadmap_belt lifts the Bool into gunbc.ownership.Ownership for the reconcile teardown gate, so the belt never imports ObservationVerdict."

data tmux_pane_fingerprint_note: String = "U4 (stop from the UI): the pane read is the scaffold's declared dissolution — tmux list-panes -a with the cited format variables yields (session_name, pane_current_command) per pane, and pane_current_command IS the process-fingerprint evidence the lease classification was built to consume. The observation upgrade is total over its inputs: a session whose pane row is found observes as SessionObserved (fingerprint in hand — Converged for claude, Conflict for anything else wearing the name, e.g. a hand-made sleep); a session visible in ls but absent from the pane read stays SessionNameObserved (honest partial — UnknownRefused downstream, still no reap). The stop gate is the R5 table as a typed decision: owned stops; everything else refuses with the verdict's own reason, and refusing to kill what we cannot prove ours is the point, not a limitation."

type TmuxPaneEntry {
  session_name: String
  command: String
}

fn parse_tmux_pane_line(line: String) -> TmuxPaneEntry? {
  let segs = split(s: line, delimiter: " ")
  if count(segs) >= 2 && segs.first() != "" {
    let name = segs.first()
    Present { value: TmuxPaneEntry {
      session_name: name,
      command: substring(s: line, start: string_length(s: name) + 1, end: string_length(s: line)),
    } }
  } else {
    none
  }
}

fn parse_tmux_panes_output(output: String) -> List<TmuxPaneEntry> {
  fold(
    split(s: output, delimiter: "\n"),
    init: [],
    f: (acc, line) => match parse_tmux_pane_line(line: line) {
      Present { value: e } => append(acc, [e])
      Absent => acc
    },
  )
}

fn tmux_list_panes_argv() -> HostExecArgv {
  host_exec_argv(program: "tmux", args: shape_tmux_list_panes_argv())
}

fn pane_command_for_session(panes: List<TmuxPaneEntry>, session_name: String) -> String {
  fold(panes, init: "", f: (acc, p) =>
    if acc == "" && p.session_name == session_name { p.command } else { acc })
}

fn tmux_session_observation_with_panes(
  scope: TmuxSessionScope,
  entries: List<TmuxLsEntry>,
  panes: List<TmuxPaneEntry>,
) -> TmuxSessionObservation {
  match tmux_session_observation_for_scope(scope: scope, entries: entries) {
    SessionNameObserved { session_name: name, windows: w } => {
      let cmd = pane_command_for_session(panes: panes, session_name: name as String)
      if cmd == "" {
        SessionNameObserved { session_name: name, windows: w }
      } else {
        SessionObserved { session_name: name, windows: w, process_fingerprint: cmd as NonEmptyStr }
      }
    }
    SessionAbsent => SessionAbsent
    SessionObserved { session_name: n2, windows: w2, process_fingerprint: f2 } =>
      SessionObserved { session_name: n2, windows: w2, process_fingerprint: f2 }
    SessionObservedStaleExpected { session_name: n3, windows: w3, process_fingerprint: f3, stale_reason: r3 } =>
      SessionObservedStaleExpected { session_name: n3, windows: w3, process_fingerprint: f3, stale_reason: r3 }
    SessionInaccessible => SessionInaccessible
  }
}

type DispatchStopGate
  = StopPermitted { session_name: String }
  | StopRefused { reason: String }

fn dispatch_stop_gate(scope: TmuxSessionScope, obs: TmuxSessionObservation) -> DispatchStopGate {
  match classify_tmux_session(scope: scope, obs: obs) {
    Converged => StopPermitted { session_name: scope.session_name as String }
    Drifted => StopPermitted { session_name: scope.session_name as String }
    Absent => StopRefused { reason: "no live session for this node" }
    Conflict => StopRefused { reason: "a foreign process wears the dispatch session name — refusing to kill what we cannot prove ours" }
    Inaccessible => StopRefused { reason: "tmux session inaccessible" }
    UnknownRefused => StopRefused { reason: "process fingerprint unobserved — no ownership proof, no reap" }
  }
}

fn dispatch_session_is_owned(session: DispatchLiveSession) -> Bool {
  match session.lease_verdict {
    Converged => true
    Drifted => true
    _ => false
  }
}

fn session_lease_reuses_process_port_classifier_shape() -> Bool {
  let port_scope = ProcessPortScope {
    listen_port: 8080,
    expected_owner_label: "gunbc-roadmap" as NonEmptyStr,
    expected_process_fingerprint: "node server.js" as NonEmptyStr,
  }
  match classify_process_port_upsert(
    scope: port_scope,
    obs: PortAbsent,
  ) {
    UpsertClassification { verdict: Absent, decision: Apply { plan: Start } } => true
    _ => false
  }
}

fn argv_contains_token(argv: List<String>, token: String) -> Bool {
  any(argv, a => a == token)
}

fn hostile_node_id_stays_single_argv_token(node_id: String) -> Bool {
  let worktree_path = dispatch_worktree_path(node_id: node_id, attempt_key: "feedfacefeedface")
  let branch_name = dispatch_branch_name(node_id: node_id, attempt_key: "feedfacefeedface")
  let worktree = git_worktree_add_argv(
    worktree_path: worktree_path,
    branch_name: branch_name,
    remote_ref: dispatch_git_remote_ref,
  ).args
  argv_contains_token(argv: worktree, token: worktree_path)
    && argv_contains_token(argv: worktree, token: branch_name)
    && !argv_contains_token(argv: worktree, token: "rm")
    && !argv_contains_token(argv: worktree, token: "-rf")
}
