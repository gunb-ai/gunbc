module gunbc.ensure

import std.types { String, Bool, NonEmptyStr }
import std.goal_assessment {
  ObservationAttempt,
  ObservationEstablished,
  ObservationRefused,
}
import std.upsert_decision {
  UpsertDecision,
  Noop,
  Apply,
  Refuse,
}
import std.realization_reconcile {
  ShowEffectiveRead,
  ReadObserved,
  ReadAbsent,
  Grounds,
  DoesNotGround,
  Grounding,
  ReconciledEffect,
  Application,
}
import gunbc.host_convergence_protocol { reconcile_from_read_attempt }

type EnsurePolicy
  = EnsureObserveOnly
  | EnsureMayApply

// Derived spelling of ObservationAttempt<ShowEffectiveRead<E>, String>.
// C0 RenameOutOfConvergence canonical = ShowEffectiveRead names the ESTABLISHED
// read. Inaccessible is ObservationRefused, never ReadAbsent (DESIGN §5).
type EnsureObservation<E>
  = EnsureObserved { evidence: E }
  | EnsureAbsent { reason: String }
  | EnsureInaccessible { reason: String }

fn ensure_observation_as_attempt<E>(
  observation: EnsureObservation<E>,
) -> ObservationAttempt<ShowEffectiveRead<E>, String> {
  match observation {
    EnsureObserved { evidence: evidence } =>
      ObservationEstablished { observed: ReadObserved { value: evidence } }
    EnsureAbsent { reason: reason } =>
      ObservationEstablished { observed: ReadAbsent { reason: reason } }
    EnsureInaccessible { reason: reason } =>
      ObservationRefused { cause: reason }
  }
}

fn ensure_observation_from_attempt<E>(
  attempt: ObservationAttempt<ShowEffectiveRead<E>, String>,
) -> EnsureObservation<E> {
  match attempt {
    ObservationEstablished { observed: ReadObserved { value: evidence } } =>
      EnsureObserved { evidence: evidence }
    ObservationEstablished { observed: ReadAbsent { reason: reason } } =>
      EnsureAbsent { reason: reason }
    ObservationRefused { cause: reason } =>
      EnsureInaccessible { reason: reason }
  }
}

type EnsurePlan<P>
  = EnsurePlanAvailable { plan: P }
  | EnsurePlanUnavailable { reason: String }

// Ensure is a convergence modality, never a roster of packages or tools. A caller supplies a typed
// desired requirement, an observation, its own satisfaction predicate, an authority policy, and an
// optional typed convergence plan. ensure_decide projects those facts onto the existing
// std.upsert_decision authority: satisfied -> Noop; known absent/drift + authorized plan -> Apply;
// observe-only, no-plan, and inaccessible -> Refuse. Effects remain capability-specific adapters.
// the caller-supplied effective read is classified through
// std.realization_reconcile, so an Apply receipt cannot claim convergence without grounded
// readback. Fine grain means one requirement/observation/receipt per semantic capability; it does
// not mean one ensure function per executable.

fn ensure_decide<P, E>(
  policy: EnsurePolicy,
  observation: EnsureObservation<E>,
  observation_satisfies: Bool,
  mismatch_reason: String,
  plan: EnsurePlan<P>,
) -> UpsertDecision<P> {
  match observation {
    EnsureInaccessible { reason } =>
      Refuse { reason: reason as NonEmptyStr }
    EnsureObserved { evidence: _ } =>
      if observation_satisfies {
        Noop
      } else {
        match policy {
          EnsureObserveOnly =>
            Refuse { reason: mismatch_reason as NonEmptyStr }
          EnsureMayApply =>
            match plan {
              EnsurePlanAvailable { plan: p } => Apply { plan: p }
              EnsurePlanUnavailable { reason } =>
                Refuse { reason: reason as NonEmptyStr }
            }
        }
      }
    EnsureAbsent { reason } =>
      match policy {
        EnsureObserveOnly =>
          Refuse { reason: reason as NonEmptyStr }
        EnsureMayApply =>
          match plan {
            EnsurePlanAvailable { plan: p } => Apply { plan: p }
            EnsurePlanUnavailable { reason: why } =>
              Refuse { reason: why as NonEmptyStr }
          }
      }
  }
}

// The whole lifecycle as ONE call, so that assembling it is no longer the caller's job to remember.
// ensure_decide remains exported because domains that already own the sequence call it directly.
// What this adds is the single route whose OUTPUT is a sealed receipt, so a sink can demand
// ReconciledEffect and thereby demand that the decision inputs, the application arm, the
// effective-read report and the grounding report were all SUPPLIED AND CLASSIFIED.
//
// WHAT THIS DOES NOT ESTABLISH. It assembles a report in one call; it does not EXECUTE the lifecycle.
// `before`, `after` and both satisfaction predicates are caller-supplied, so a caller that observes
// nothing and asserts everything still gets a report. The post-observation is a SECOND observation
// supplied by the caller -- the same observation value passed twice is a caller defect this function
// cannot see, and is what the witnesses in gunbc.readback_independence exist to catch. None of these
// inputs is INDEPENDENT in any sense this module can check: independence is not a property a report
// carries, so it cannot itself be reported.
//
// TWO THINGS IT IS TEMPTING TO CLAIM HERE, and neither holds. That a sink demanding ReconciledEffect
// thereby demands the lifecycle "all ran": it does not, and the paragraph above is the authority.
// And that a caller can no longer get a CONVERGED receipt "merely by writing a Bool": picking the
// Applied arm is exactly as cheap as writing true, and an evidence payload on that arm would not
// change it, because no fold reads one. Both describe a rename as a guarantee.
//
// What the carrier actually buys is the REFUSAL TABLE in std.realization_reconcile:
// Noop-with-an-application and Refuse-with-an-application are lifecycle contradictions that refuse.
// That is a real property and it is the only one claimed here.
//
// It is NOT proof the decided plan is the one that ran — std cannot witness that without a law from
// the same caller it would be checking, so the plan-to-evidence binding belongs to the domain and is
// discharged by a domain carrier the effect authority alone can mint.

fn ensure_after_grounding<E>(
  after: EnsureObservation<E>,
  after_satisfies: Bool,
  after_mismatch_reason: String,
) -> Grounding<E> {
  match after {
    EnsureObserved { evidence: evidence } =>
      if after_satisfies {
        Grounds { evidence: evidence }
      } else {
        DoesNotGround { reason: after_mismatch_reason }
      }
    EnsureAbsent { reason: reason } => DoesNotGround { reason: reason }
    EnsureInaccessible { reason: reason } => DoesNotGround { reason: reason }
  }
}

fn ensure_reconcile<P, E>(
  policy: EnsurePolicy,
  before: EnsureObservation<E>,
  before_satisfies: Bool,
  mismatch_reason: String,
  plan: EnsurePlan<P>,
  application: Application,
  after: EnsureObservation<E>,
  after_satisfies: Bool,
  after_mismatch_reason: String,
) -> ReconciledEffect<P, E> {
  reconcile_from_read_attempt(
    decision: ensure_decide(
      policy: policy,
      observation: before,
      observation_satisfies: before_satisfies,
      mismatch_reason: mismatch_reason,
      plan: plan,
    ),
    application: application,
    after: ensure_observation_as_attempt(observation: after),
    grounding: ensure_after_grounding(
      after: after,
      after_satisfies: after_satisfies,
      after_mismatch_reason: after_mismatch_reason,
    ),
  )
}
