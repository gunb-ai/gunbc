module gunbc.ensure

import std.types { String, Bool, NonEmptyStr }
import std.upsert_decision {
  UpsertDecision,
  Noop,
  Apply,
  Refuse,
}
import std.realization_reconcile {
  Reconciliation,
  ReadObserved,
  ReadAbsent,
  Grounds,
  DoesNotGround,
  reconcile_grounded,
  ReconciledEffect,
  reconcile_effect,
}

type EnsurePolicy
  = EnsureObserveOnly
  | EnsureMayApply

type EnsureObservation<E>
  = EnsureObserved { evidence: E }
  | EnsureAbsent { reason: String }
  | EnsureInaccessible { reason: String }

type EnsurePlan<P>
  = EnsurePlanAvailable { plan: P }
  | EnsurePlanUnavailable { reason: String }

// Ensure is a convergence modality, never a roster of packages or tools. A caller supplies a typed
// desired requirement, an observation, its own satisfaction predicate, an authority policy, and an
// optional typed convergence plan. ensure_decide projects those facts onto the existing
// std.upsert_decision authority: satisfied -> Noop; known absent/drift + authorized plan -> Apply;
// observe-only, no-plan, and inaccessible -> Refuse. Effects remain capability-specific adapters.
// ensure_readback then projects the independent post-apply observation through
// std.realization_reconcile, so an Apply receipt cannot claim convergence without grounded
// readback. Fine grain means one requirement/observation/receipt per semantic capability; it does
// not mean one ensure function per executable.

fn ensure_decide<P, E>(
  policy: EnsurePolicy,
  observation: EnsureObservation<E>,
  observation_satisfies: Bool,
  mismatch_reason: String,
  plan: EnsurePlan<P>,
) -> UpsertDecision<P> {
  match observation {
    EnsureInaccessible { reason } =>
      Refuse { reason: reason as NonEmptyStr }
    EnsureObserved { evidence: _ } =>
      if observation_satisfies {
        Noop
      } else {
        match policy {
          EnsureObserveOnly =>
            Refuse { reason: mismatch_reason as NonEmptyStr }
          EnsureMayApply =>
            match plan {
              EnsurePlanAvailable { plan: p } => Apply { plan: p }
              EnsurePlanUnavailable { reason } =>
                Refuse { reason: reason as NonEmptyStr }
            }
        }
      }
    EnsureAbsent { reason } =>
      match policy {
        EnsureObserveOnly =>
          Refuse { reason: reason as NonEmptyStr }
        EnsureMayApply =>
          match plan {
            EnsurePlanAvailable { plan: p } => Apply { plan: p }
            EnsurePlanUnavailable { reason: why } =>
              Refuse { reason: why as NonEmptyStr }
          }
      }
  }
}

fn ensure_readback<E>(
  applied: Bool,
  observation: EnsureObservation<E>,
  observation_satisfies: Bool,
  mismatch_reason: String,
) -> Reconciliation<Bool, E> {
  match observation {
    EnsureObserved { evidence } =>
      reconcile_grounded(
        apply_effect: applied,
        show_read: ReadObserved { value: evidence },
        grounding: if observation_satisfies {
          Grounds { evidence: evidence }
        } else {
          DoesNotGround { reason: mismatch_reason }
        },
      )
    EnsureAbsent { reason } =>
      reconcile_grounded(
        apply_effect: applied,
        show_read: ReadAbsent { reason: reason },
        grounding: DoesNotGround { reason: reason },
      )
    EnsureInaccessible { reason } =>
      reconcile_grounded(
        apply_effect: applied,
        show_read: ReadAbsent { reason: reason },
        grounding: DoesNotGround { reason: reason },
      )
  }
}

// The whole lifecycle as ONE call, so that assembling it is no longer the caller's job to remember.
// ensure_decide and ensure_readback remain exported because domains that already own the sequence
// call them directly; what this adds is the single route whose OUTPUT is a sealed receipt, so a sink
// can demand ReconciledEffect and thereby demand that classify, policy, apply and independent
// readback all ran. The post-observation is a SECOND observation supplied by the caller — the same
// observation value passed twice is a caller defect this function cannot see, and is what the
// independent-readback witnesses in gunbc.readback_independence exist to catch.
//
// WHAT THIS DOES NOT ESTABLISH, corrected after review of the first revision: this assembles a
// report in one call, it does not EXECUTE the lifecycle. `before`, `after` and both satisfaction
// predicates remain caller-supplied, so a caller that observes nothing and asserts everything still
// gets a report — what changed is that it can no longer get a CONVERGED one merely by writing a
// Bool, because the Apply route now demands an Application carrying the performed plan and a domain
// evidence value. The strength of the result is the strength of that evidence type, and choosing a
// freely-constructible one is a hole in the calling domain rather than here.

fn ensure_reconcile<P, A, E>(
  policy: EnsurePolicy,
  before: EnsureObservation<E>,
  before_satisfies: Bool,
  mismatch_reason: String,
  plan: EnsurePlan<P>,
  application: Application<P, A>,
  plan_eq: fn(P, P) -> Bool,
  after: EnsureObservation<E>,
  after_satisfies: Bool,
  after_mismatch_reason: String,
) -> ReconciledEffect<P, E> {
  match after {
    EnsureObserved { evidence: evidence } =>
      reconcile_effect(
        decision: ensure_decide(
          policy: policy,
          observation: before,
          observation_satisfies: before_satisfies,
          mismatch_reason: mismatch_reason,
          plan: plan,
        ),
        application: application,
        plan_eq: plan_eq,
        show_read: ReadObserved { value: evidence },
        grounding: if after_satisfies {
          Grounds { evidence: evidence }
        } else {
          DoesNotGround { reason: after_mismatch_reason }
        },
      )
    EnsureAbsent { reason: reason } =>
      reconcile_effect(
        decision: ensure_decide(
          policy: policy,
          observation: before,
          observation_satisfies: before_satisfies,
          mismatch_reason: mismatch_reason,
          plan: plan,
        ),
        application: application,
        plan_eq: plan_eq,
        show_read: ReadAbsent { reason: reason },
        grounding: DoesNotGround { reason: reason },
      )
    EnsureInaccessible { reason: reason } =>
      reconcile_effect(
        decision: ensure_decide(
          policy: policy,
          observation: before,
          observation_satisfies: before_satisfies,
          mismatch_reason: mismatch_reason,
          plan: plan,
        ),
        application: application,
        plan_eq: plan_eq,
        show_read: ReadAbsent { reason: reason },
        grounding: DoesNotGround { reason: reason },
      )
  }
}
