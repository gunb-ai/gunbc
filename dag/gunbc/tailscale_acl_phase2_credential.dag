module gunbc.tailscale_acl_phase2_credential

// The credential authorities are IMPORT EDGES, not DeclarationRef rows.
//
// This carrier used to name `gunbc.auth.credentials` and `gunbc.auth.optional_impersonation` in
// four `DeclarationRef` rows and assert the binding with a string-equality function. That was the
// defect: a `DeclarationRef` is inert data -- no closure follows it -- so the credential module was
// reached by no import edge, entered no compile closure, and was typechecked by nothing, while four
// rows and a witness asserted it was the authority. The declaration index answers whether a symbol
// EXISTS; whether its home COMPILES is a property of a closure, and a citation creates none.
//
// The string-equality check was the matching decoration: it compared each row's literal against
// the same literal, so its RED was authorable only by editing the row it read (§4b) -- permanently
// green by construction, cited as evidence the credential flow bound these authorities. It bound
// nothing.
//
// An import edge is the construction the check was validating (§5): the binding now rides the
// mechanism that typechecks the calls below, so an authority renamed, deleted, or not compiling
// refuses HERE rather than standing green in a data row.
import gunbc.auth.credentials {
  gcp_secret_credential,
  gcp_oauth_access_token,
  GcpSecretCredentialReady,
  GcpSecretCredentialWireDecodeRefused,
  GcpAdcTokenOutcome,
  GcpAdcTokenReady,
  GcpAdcReadRefused,
  GcpAdcDocumentRefused,
}
import gunbc.auth.optional_impersonation { optional_impersonation }

// The rest of this carrier's authorities, for the same reason. Measured against main: with no
// import list this module resolved a 274-source reference-derived closure and every one of these
// names landed by whatever else was dragged into the pool -- accidental coverage, not a binding,
// the finding `extdeps.cloud.gcp.secret_manager` records above its own `GcpProjectId` /
// `GcpErrorShape` edges. Naming them makes each refuse here if its home is renamed, deleted, or
// stops compiling.
import gunbc.assimilate.bmc_token_federation {
  SecretAccessBinding,
  bmc_secrets_project_id,
  bmc_federated_github_repo,
  bmc_wif_principal_set,
  bmc_assimilator_sa_member,
}
import gunbc.fleet_posix_accounts { fleet_operator_email, fleet_operator_gcp_iam_member }
import gunbc.tailscale_acl_emit { expected_tailscale_acl_json }
import extdeps.tailscale.acl { TailscaleAclPolicy, operator_acl_security_spine_holds }
import extdeps.cloud.gcp.gcp { GcpOAuth2AccessTokenStrategy, AdcRefresh, GcpProjectId }
import extdeps.cloud.gcp.iam { role_secretmanager_secret_accessor }
import extdeps.cloud.gcp.secret_manager {
  SmResolvedVersionIdentityRefusal,
  SmAccessVersionPayloadRefusal,
}
import std.measure { Second, second, second_count }
import std.types { Bool, List, NonEmptyStr, Secret, String }

data tailscale_acl_ephemeral_token_secret_id: NonEmptyStr = "tailscale-acl-ephemeral-token"

data tailscale_acl_ephemeral_lifetime: Second = second(count: 3600)

data tailscale_acl_operator_adc_strategy: GcpOAuth2AccessTokenStrategy = AdcRefresh { adc_path: Absent }


fn tailscale_acl_operator_email() -> NonEmptyStr {
  fleet_operator_email
}

fn operator_principal_member() -> String {
  fleet_operator_gcp_iam_member()
}

fn tailscale_acl_ephemeral_token_secret_resource_name() -> String {
  concat(
    concat(concat("projects/", bmc_secrets_project_id as String), "/secrets/"),
    tailscale_acl_ephemeral_token_secret_id as String
  )
}

data operator_tailscale_acl_secret_bindings: List<SecretAccessBinding> = [
  SecretAccessBinding {
    member: operator_principal_member(),
    role: role_secretmanager_secret_accessor,
    secret: tailscale_acl_ephemeral_token_secret_id as String,
    project: bmc_secrets_project_id,
  }
]

fn secret_binding_member_is_repo_scoped_wif(member: String) -> Bool {
  (member == bmc_wif_principal_set())
    || string_contains(s: member, pattern: "principalSet://iam.googleapis.com")
}

fn secret_binding_member_is_ci_federation_service_account(member: String) -> Bool {
  member == bmc_assimilator_sa_member()
}

fn operator_bindings_admit_repo_scoped_wif(bindings: List<SecretAccessBinding>) -> Bool {
  fold(
    bindings,
    init: false,
    f: (acc, b) => acc || secret_binding_member_is_repo_scoped_wif(member: b.member)
  )
}

fn operator_bindings_admit_bmc_assimilator_sa(bindings: List<SecretAccessBinding>) -> Bool {
  fold(
    bindings,
    init: false,
    f: (acc, b) => acc || secret_binding_member_is_ci_federation_service_account(member: b.member)
  )
}

fn operator_bindings_are_user_principal_accessor_only(bindings: List<SecretAccessBinding>) -> Bool {
  (length(bindings) == 1)
    && match bindings.first() {
      Present { value: only } =>
        only.member == operator_principal_member()
          && only.role == role_secretmanager_secret_accessor
          && only.project == bmc_secrets_project_id
          && only.secret == (tailscale_acl_ephemeral_token_secret_id as String)
          && starts_with(s: only.member, prefix: "user:")
      Absent => false
    }
}

type TailscaleAclOperatorEphemeralCredentialOutcome
  = TailscaleAclOperatorEphemeralCredentialReady {
      tailscale_api_token: Secret
      operator_gcp_token: Secret
    }
  | TailscaleAclOperatorEphemeralCredentialSecretRefused {
      identity_cause: SmResolvedVersionIdentityRefusal?
      payload_cause: SmAccessVersionPayloadRefusal?
    }
  | TailscaleAclOperatorEphemeralCredentialAdcRefused {
      cause: GcpAdcTokenOutcome
    }

pattern tailscale_acl_operator_ephemeral_credential(
  secret_version: NonEmptyStr = "latest"
) -> TailscaleAclOperatorEphemeralCredentialOutcome
  uses net: std.resources.Network
{
  node operator_gcp: gcp_oauth_access_token(strategy: tailscale_acl_operator_adc_strategy)
  return match operator_gcp {
    GcpAdcReadRefused { path: _, cause: _ } =>
      TailscaleAclOperatorEphemeralCredentialAdcRefused { cause: operator_gcp }
    GcpAdcDocumentRefused { path: _, cause: _ } =>
      TailscaleAclOperatorEphemeralCredentialAdcRefused { cause: operator_gcp }
    GcpAdcTokenReady { token: operator_token } =>
      tailscale_acl_credential_with_operator_token(
        operator_token: operator_token,
        secret_version: secret_version
      )
  }
}

// The impersonation and the secret read live INSIDE the ready arm: they need a real operator
// token, and there is no honest value when the ADC read or decode refused. Hoisting them out with
// a placeholder would be the fabricated plausible output §5 forbids -- the refusal must reach the
// caller, not be absorbed into an empty Secret.
pattern tailscale_acl_credential_with_operator_token(
  operator_token: Secret,
  secret_version: NonEmptyStr
) -> TailscaleAclOperatorEphemeralCredentialOutcome
  uses net: std.resources.Network
{
  node bounded_gcp: optional_impersonation(
    access_token: operator_token,
    service_account: Absent,
    lifetime_seconds: second_count(s: tailscale_acl_ephemeral_lifetime)
  )
  node sm_secret: gcp_secret_credential(
    project_id: bmc_secrets_project_id,
    secret_name: tailscale_acl_ephemeral_token_secret_id,
    version: secret_version
  )
  return match sm_secret {
    GcpSecretCredentialReady { credential: credential, resolved_version: _ } =>
      TailscaleAclOperatorEphemeralCredentialReady {
        tailscale_api_token: credential,
        operator_gcp_token: bounded_gcp.token,
      }
    GcpSecretCredentialWireDecodeRefused { identity_cause: identity_cause, payload_cause: payload_cause } =>
      TailscaleAclOperatorEphemeralCredentialSecretRefused {
        identity_cause: identity_cause,
        payload_cause: payload_cause,
      }
  }
}

type EphemeralTokenGate
  = TokenPresent { token: Secret, issued_at: Second, lifetime: Second }
  | TokenAbsent { reason: String }
  | TokenExpired { reason: String }

fn operator_adc_identity_email() -> NonEmptyStr {
  fleet_operator_email
}

fn second_instant_before(earlier: Second, later: Second) -> Bool {
  second_count(s: earlier) < second_count(s: later)
}

fn tailscale_ephemeral_token_within_ttl(
  issued_at: Second,
  lifetime: Second,
  now: Second
) -> Bool {
  measure_le(a: lifetime, b: tailscale_acl_ephemeral_lifetime)
    && second_instant_before(
      earlier: now,
      later: measure_add(a: issued_at, b: lifetime)
    )
}

fn ephemeral_token_gate_valid(gate: EphemeralTokenGate, now: Second) -> Bool {
  match gate {
    TokenPresent { token: _, issued_at: issued, lifetime: ttl } =>
      tailscale_ephemeral_token_within_ttl(
        issued_at: issued,
        lifetime: ttl,
        now: now
      )
    TokenAbsent { reason: _ } => false
    TokenExpired { reason: _ } => false
  }
}

fn ephemeral_token_gate_fail_closed(gate: EphemeralTokenGate) -> Bool {
  match gate {
    TokenAbsent { reason: _ } => true
    TokenExpired { reason: _ } => true
    TokenPresent { token: _, issued_at: _, lifetime: _ } => false
  }
}

type AclPolicyDiff
  = PoliciesMatch
  | PoliciesDiffer { emitted: String, live: String }

type AclUpsertGate
  = DiffPending { diff: AclPolicyDiff }
  | OperatorConfirmed { emitted: String, token: Secret, issued_at: Second, lifetime: Second }
  | RefusedAutoUpsert { reason: String }

type TailscaleAclUpsertWetShape
  = DiffPrintOnly { diff: AclPolicyDiff }
  | LiveWriteRefused { reason: String }

fn acl_diff_from_authority(live_json: String) -> AclPolicyDiff {
  let emitted = expected_tailscale_acl_json()
  if emitted == live_json {
    PoliciesMatch
  } else {
    PoliciesDiffer { emitted: emitted, live: live_json }
  }
}

fn acl_upsert_wet_shape_is_diff_print_only(shape: TailscaleAclUpsertWetShape) -> Bool {
  match shape {
    DiffPrintOnly { diff: _ } => true
    LiveWriteRefused { reason: _ } => false
  }
}

fn acl_upsert_permitted(gate: AclUpsertGate, now: Second) -> Bool {
  match gate {
    OperatorConfirmed { emitted: _, token: _, issued_at: issued, lifetime: ttl } =>
      tailscale_ephemeral_token_within_ttl(
        issued_at: issued,
        lifetime: ttl,
        now: now
      )
    DiffPending { diff: _ } => false
    RefusedAutoUpsert { reason: _ } => false
  }
}

fn acl_auto_upsert_refused(gate: AclUpsertGate) -> Bool {
  match gate {
    RefusedAutoUpsert { reason: _ } => true
    DiffPending { diff: _ } => true
    OperatorConfirmed { emitted: _, token: _, issued_at: _, lifetime: _ } => false
  }
}

fn tailscale_acl_upsert_preflight(policy: TailscaleAclPolicy) -> Bool {
  operator_acl_security_spine_holds(policy: policy)
}

data tailscale_acl_phase2_live_write_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.tailscale_acl_phase2_credential",
    decl_name: "tailscale_acl_upsert_wet",
    field: WholeDeclaration
  }
}

fn tailscale_acl_phase2_credential_design_holds() -> Bool {
  operator_bindings_are_user_principal_accessor_only(bindings: operator_tailscale_acl_secret_bindings)
    && !operator_bindings_admit_repo_scoped_wif(bindings: operator_tailscale_acl_secret_bindings)
    && !operator_bindings_admit_bmc_assimilator_sa(bindings: operator_tailscale_acl_secret_bindings)
    && (second_count(s: tailscale_acl_ephemeral_lifetime) == 3600)
}
