module gunbc.tailscale_acl_phase2_credential


data tailscale_acl_ephemeral_token_secret_id: std.types.NonEmptyStr = "tailscale-acl-ephemeral-token"

data tailscale_acl_ephemeral_lifetime: std.measure.Second = second(count: 3600)

data tailscale_acl_operator_adc_strategy: extdeps.cloud.gcp.gcp.GcpOAuth2AccessTokenStrategy = extdeps.cloud.gcp.gcp.AdcRefresh { adc_path: Absent }

data tailscale_acl_gcp_secret_credential_authority: std.decl_ref.DeclarationRef = std.decl_ref.DeclarationRef {
  module_path: "gunbc.auth.credentials",
  decl_name: "gcp_secret_credential",
  field: WholeDeclaration
}

data tailscale_acl_adc_refresh_credential_authority: std.decl_ref.DeclarationRef = std.decl_ref.DeclarationRef {
  module_path: "gunbc.auth.credentials",
  decl_name: "gcp_oauth_access_token_via_adc_refresh",
  field: WholeDeclaration
}

data tailscale_acl_optional_impersonation_authority: std.decl_ref.DeclarationRef = std.decl_ref.DeclarationRef {
  module_path: "gunbc.auth.optional_impersonation",
  decl_name: "optional_impersonation",
  field: WholeDeclaration
}

data tailscale_acl_ephemeral_lifetime_authority: std.decl_ref.DeclarationRef = std.decl_ref.DeclarationRef {
  module_path: "gunbc.auth.optional_impersonation",
  decl_name: "optional_impersonation",
  field: std.decl_ref.NamedField { field_name: "lifetime_seconds" }
}

fn tailscale_acl_operator_email() -> std.types.NonEmptyStr {
  fleet_operator_email
}

fn operator_principal_member() -> String {
  fleet_operator_gcp_iam_member()
}

fn tailscale_acl_ephemeral_token_secret_resource_name() -> String {
  concat(
    concat(concat("projects/", bmc_secrets_project_id as String), "/secrets/"),
    tailscale_acl_ephemeral_token_secret_id as String
  )
}

data operator_tailscale_acl_secret_bindings: List<gunbc.assimilate.bmc_token_federation.SecretAccessBinding> = [
  gunbc.assimilate.bmc_token_federation.SecretAccessBinding {
    member: operator_principal_member(),
    role: extdeps.cloud.gcp.iam.role_secretmanager_secret_accessor,
    secret: tailscale_acl_ephemeral_token_secret_id as String,
    project: bmc_secrets_project_id,
  }
]

fn secret_binding_member_is_repo_scoped_wif(member: String) -> Bool {
  (member == bmc_wif_principal_set())
    || string_contains(s: member, pattern: "principalSet://iam.googleapis.com")
}

fn secret_binding_member_is_ci_federation_service_account(member: String) -> Bool {
  member == bmc_assimilator_sa_member()
}

fn operator_bindings_admit_repo_scoped_wif(bindings: List<gunbc.assimilate.bmc_token_federation.SecretAccessBinding>) -> Bool {
  fold(
    bindings,
    init: false,
    f: (acc, b) => acc || secret_binding_member_is_repo_scoped_wif(member: b.member)
  )
}

fn operator_bindings_admit_bmc_assimilator_sa(bindings: List<gunbc.assimilate.bmc_token_federation.SecretAccessBinding>) -> Bool {
  fold(
    bindings,
    init: false,
    f: (acc, b) => acc || secret_binding_member_is_ci_federation_service_account(member: b.member)
  )
}

fn operator_bindings_are_user_principal_accessor_only(bindings: List<gunbc.assimilate.bmc_token_federation.SecretAccessBinding>) -> Bool {
  (length(bindings) == 1)
    && bindings.first().member == operator_principal_member()
    && bindings.first().role == extdeps.cloud.gcp.iam.role_secretmanager_secret_accessor
    && bindings.first().project == bmc_secrets_project_id
    && bindings.first().secret == (tailscale_acl_ephemeral_token_secret_id as String)
    && starts_with(s: bindings.first().member, prefix: "user:")
}

type TailscaleAclOperatorEphemeralCredentialOutcome
  = TailscaleAclOperatorEphemeralCredentialReady {
      tailscale_api_token: Secret
      operator_gcp_token: Secret
    }
  | TailscaleAclOperatorEphemeralCredentialSecretRefused {
      identity_cause: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentityRefusal?
      payload_cause: extdeps.cloud.gcp.secret_manager.SmAccessVersionPayloadRefusal?
    }
  | TailscaleAclOperatorEphemeralCredentialAdcRefused {
      cause: GcpAdcTokenOutcome
    }

pattern tailscale_acl_operator_ephemeral_credential(
  secret_version: std.types.NonEmptyStr = "latest"
) -> TailscaleAclOperatorEphemeralCredentialOutcome
  uses net: std.resources.Network
{
  node operator_gcp: gcp_oauth_access_token(strategy: tailscale_acl_operator_adc_strategy)
  return match operator_gcp {
    GcpAdcReadRefused { path: _, cause: _ } =>
      TailscaleAclOperatorEphemeralCredentialAdcRefused { cause: operator_gcp }
    GcpAdcDocumentRefused { path: _, cause: _ } =>
      TailscaleAclOperatorEphemeralCredentialAdcRefused { cause: operator_gcp }
    GcpAdcTokenReady { token: operator_token } =>
      tailscale_acl_credential_with_operator_token(
        operator_token: operator_token,
        secret_version: secret_version
      )
  }
}

// The impersonation and the secret read live INSIDE the ready arm rather than
// beside the match: they need a real operator token, and there is no honest
// value to hand them when the ADC read or decode refused. Hoisting them out and
// passing a placeholder would be the fabricated plausible output §5 forbids --
// the refusal must reach the caller, not be absorbed into an empty Secret.
pattern tailscale_acl_credential_with_operator_token(
  operator_token: Secret,
  secret_version: NonEmptyStr
) -> TailscaleAclOperatorEphemeralCredentialOutcome
  uses net: std.resources.Network
{
  node bounded_gcp: optional_impersonation(
    access_token: operator_token,
    service_account: Absent,
    lifetime_seconds: second_count(s: tailscale_acl_ephemeral_lifetime)
  )
  node sm_secret: gcp_secret_credential(
    project_id: bmc_secrets_project_id,
    secret_name: tailscale_acl_ephemeral_token_secret_id,
    version: secret_version
  )
  return match sm_secret {
    GcpSecretCredentialReady { credential: credential, resolved_version: _ } =>
      TailscaleAclOperatorEphemeralCredentialReady {
        tailscale_api_token: credential,
        operator_gcp_token: bounded_gcp.token,
      }
    GcpSecretCredentialWireDecodeRefused { identity_cause: identity_cause, payload_cause: payload_cause } =>
      TailscaleAclOperatorEphemeralCredentialSecretRefused {
        identity_cause: identity_cause,
        payload_cause: payload_cause,
      }
  }
}

type EphemeralTokenGate
  = TokenPresent { token: Secret, issued_at: std.measure.Second, lifetime: std.measure.Second }
  | TokenAbsent { reason: String }
  | TokenExpired { reason: String }

fn operator_adc_identity_email() -> std.types.NonEmptyStr {
  fleet_operator_email
}

fn second_instant_before(earlier: std.measure.Second, later: std.measure.Second) -> Bool {
  second_count(s: earlier) < second_count(s: later)
}

fn tailscale_ephemeral_token_within_ttl(
  issued_at: std.measure.Second,
  lifetime: std.measure.Second,
  now: std.measure.Second
) -> Bool {
  measure_le(a: lifetime, b: tailscale_acl_ephemeral_lifetime)
    && second_instant_before(
      earlier: now,
      later: measure_add(a: issued_at, b: lifetime)
    )
}

fn ephemeral_token_gate_valid(gate: EphemeralTokenGate, now: std.measure.Second) -> Bool {
  match gate {
    TokenPresent { token: _, issued_at: issued, lifetime: ttl } =>
      tailscale_ephemeral_token_within_ttl(
        issued_at: issued,
        lifetime: ttl,
        now: now
      )
    TokenAbsent { reason: _ } => false
    TokenExpired { reason: _ } => false
  }
}

fn ephemeral_token_gate_fail_closed(gate: EphemeralTokenGate) -> Bool {
  match gate {
    TokenAbsent { reason: _ } => true
    TokenExpired { reason: _ } => true
    TokenPresent { token: _, issued_at: _, lifetime: _ } => false
  }
}

type AclPolicyDiff
  = PoliciesMatch
  | PoliciesDiffer { emitted: String, live: String }

type AclUpsertGate
  = DiffPending { diff: AclPolicyDiff }
  | OperatorConfirmed { emitted: String, token: Secret, issued_at: std.measure.Second, lifetime: std.measure.Second }
  | RefusedAutoUpsert { reason: String }

type TailscaleAclUpsertWetShape
  = DiffPrintOnly { diff: AclPolicyDiff }
  | LiveWriteRefused { reason: String }

fn acl_diff_from_authority(live_json: String) -> AclPolicyDiff {
  let emitted = expected_tailscale_acl_json()
  if emitted == live_json {
    PoliciesMatch
  } else {
    PoliciesDiffer { emitted: emitted, live: live_json }
  }
}

fn acl_upsert_wet_shape_is_diff_print_only(shape: TailscaleAclUpsertWetShape) -> Bool {
  match shape {
    DiffPrintOnly { diff: _ } => true
    LiveWriteRefused { reason: _ } => false
  }
}

fn acl_upsert_permitted(gate: AclUpsertGate, now: std.measure.Second) -> Bool {
  match gate {
    OperatorConfirmed { emitted: _, token: _, issued_at: issued, lifetime: ttl } =>
      tailscale_ephemeral_token_within_ttl(
        issued_at: issued,
        lifetime: ttl,
        now: now
      )
    DiffPending { diff: _ } => false
    RefusedAutoUpsert { reason: _ } => false
  }
}

fn acl_auto_upsert_refused(gate: AclUpsertGate) -> Bool {
  match gate {
    RefusedAutoUpsert { reason: _ } => true
    DiffPending { diff: _ } => true
    OperatorConfirmed { emitted: _, token: _, issued_at: _, lifetime: _ } => false
  }
}

fn tailscale_acl_upsert_preflight(policy: extdeps.tailscale.acl.TailscaleAclPolicy) -> Bool {
  operator_acl_security_spine_holds(policy: policy)
}

fn tailscale_acl_credential_flow_uses_auth_patterns() -> Bool {
  tailscale_acl_gcp_secret_credential_authority.module_path == "gunbc.auth.credentials"
    && tailscale_acl_gcp_secret_credential_authority.decl_name == "gcp_secret_credential"
    && tailscale_acl_adc_refresh_credential_authority.decl_name == "gcp_oauth_access_token_via_adc_refresh"
    && tailscale_acl_optional_impersonation_authority.module_path == "gunbc.auth.optional_impersonation"
    && tailscale_acl_optional_impersonation_authority.decl_name == "optional_impersonation"
    && match tailscale_acl_operator_adc_strategy {
      AdcRefresh { adc_path: _ } => true
      _ => false
    }
}

data tailscale_acl_phase2_live_write_disposition: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.tailscale_acl_phase2_credential",
    decl_name: "tailscale_acl_upsert_wet",
    field: WholeDeclaration
  }
}

fn tailscale_acl_phase2_credential_design_holds() -> Bool {
  tailscale_acl_credential_flow_uses_auth_patterns()
    && operator_bindings_are_user_principal_accessor_only(bindings: operator_tailscale_acl_secret_bindings)
    && !operator_bindings_admit_repo_scoped_wif(bindings: operator_tailscale_acl_secret_bindings)
    && !operator_bindings_admit_bmc_assimilator_sa(bindings: operator_tailscale_acl_secret_bindings)
    && (second_count(s: tailscale_acl_ephemeral_lifetime) == 3600)
}
