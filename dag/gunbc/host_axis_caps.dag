module gunbc.host_axis_caps


data host_axis_caps_note: String = "PerSlotMemoryCap axis, closed vertically on the membership_reconcile spine — the first non-degenerate reconcile in the repo (desired vs a real OBSERVED set, not observed=[]). MemoryMax SINGLE AUTHORITY: drop-in content authored here and applied at live_deploy under the deploy principal (ghrunner sudo) — gunbc converge on the operator principal does NOT write drop-ins, daemon-reload, set-property MemoryMax, or systemctl revert (operator privilege hold 2026-08-13). system.control set-property RESIDUE is a separate reconcile axis: stale 50-MemoryMax.conf / 50-MemoryHigh.conf shadow deploy drop-ins until teardown via deploy apply (author derived drop-ins before revert). A CapMember is a per-slot systemd drop-in keyed by its file path (stable IDENTITY, so a content drift is Modified->MemberChanged, never Remove+Add). The interference domain is the drop-in directory itself: ownership is DERIVED from the path (managed set -> Owned; anything else -> a foreign occupant, Ensured), never stored, so a Removed foreign file yields MemberRemovalRefused (R5, no effect arm, never deleted). Idempotence = zero hunks (Unchanged); perturb = Modified->MemberChanged of exactly the drifted row; foreign occupant = ApplyRefused wholesale. Live apply/observe are host_effect_apply typed transports (operator one-liners for the go-live receipts); this module is the pure, hermetically-witnessed fold."

type CapMemberAt = std.types.NonEmptyStr

type CapMember {
  dropin_path: std.types.NonEmptyStr
  content: String
}

data caps_managed_dropin_paths: List<std.types.NonEmptyStr> = [
  gunbc.host_converge.gunbc_runner_per_slot_dropin_path as std.types.NonEmptyStr,
  gunbc.host_converge.gunbc_runner_per_slot_swap_dropin_path as std.types.NonEmptyStr,
  gunbc.host_converge.gunbc_runner_per_slot_high_dropin_path as std.types.NonEmptyStr,
  gunbc.host_converge.gunbc_runner_per_slot_tasks_dropin_path as std.types.NonEmptyStr,
]

fn cap_is_managed_path(p: std.types.NonEmptyStr) -> Bool {
  fold(caps_managed_dropin_paths, init: false, f: (acc, mp) => acc || (mp as String == p as String))
}

fn cap_member_key(m: gunbc.host_axis_caps.CapMember) -> std.types.NonEmptyStr {
  m.dropin_path
}

fn cap_member_key_eq(a: std.types.NonEmptyStr, b: std.types.NonEmptyStr) -> Bool {
  a as String == b as String
}

fn cap_member_value_eq(a: gunbc.host_axis_caps.CapMember, b: gunbc.host_axis_caps.CapMember) -> Bool {
  a.content == b.content
}

fn cap_member_ownership(m: gunbc.host_axis_caps.CapMember) -> gunbc.ownership.Ownership? {
  if cap_is_managed_path(p: m.dropin_path) {
    Present { value: gunbc.ownership.Owned }
  } else {
    Present { value: gunbc.ownership.Ensured }
  }
}

fn cap_dropin_content(property: std.types.NonEmptyStr, bytes_value: std.types.NonEmptyStr) -> String {
  join(["[Service]\n", property as String, "=", bytes_value as String, "\n"], "")
}

fn desired_cap_member(dropin_path: std.types.NonEmptyStr, property: std.types.NonEmptyStr, bytes_value: std.types.NonEmptyStr) -> gunbc.host_axis_caps.CapMember {
  CapMember {
    dropin_path: dropin_path,
    content: cap_dropin_content(property: property, bytes_value: bytes_value),
  }
}

// Runtime shell is a MODELED BASH PROGRAM here, not a String built by join. Every
// executed statement in this module is a bash grammar tree (v2.extdeps.languages.bash_build)
// serialized once at the foreign-executor edge through v2.workflow.bash_command_fold_serialize
// — so word quoting is the serializer's structural job (POSIX single-quote, cited at
// extdeps.posix.shell_command_language) instead of an apostrophe an author remembered to type,
// and a shape the grammar cannot express REFUSES with a poison marker rather than emitting a
// hand-spelled fallback (DESIGN §5). The statement JOIN is the grammar's too
// (bash_fold_serialize_stmts_semi), so sequencing is not workflow-code concatenation either.
data host_axis_caps_bash_emit_refused_poison: String = "__GUNBC_BASH_EMIT_REFUSED__ host-axis cap script intent was rejected by v2.workflow.bash_command_fold_serialize; this marker is not valid shell, so the consuming deploy/converge step fails loudly rather than a hand-spelled fallback masking the refusal (DESIGN §5: refuse, never widen)"

fn cap_script_from_stmts(stmts: List<Node>) -> String {
  match bash_fold_serialize_stmts_semi(stmts: stmts) {
    Accepted { value: source, diagnostics: d } =>
      match d {
        None => source
        Some { diagnostics: _ } => host_axis_caps_bash_emit_refused_poison
      }
    Rejected { diagnostics: _ } => host_axis_caps_bash_emit_refused_poison
  }
}

fn cap_lit_words(words: List<String>) -> List<Node> {
  map(words, w => bash_build_word_lit(text: w))
}

fn cap_command_intent(words: List<String>) -> Node {
  bash_build_command_with_words(words: cap_lit_words(words: words))
}

fn cap_privileged_command_intent(argv: List<String>) -> Node {
  cap_command_intent(words: concat(["sudo", "-n"], argv))
}

fn cap_write_content_intent(content: String, path: Node) -> Node {
  bash_build_with_redir_to_file(
    inner: cap_command_intent(words: ["printf", "%s", content]),
    path: path,
  )
}

fn cap_upsert_stmts(m: gunbc.host_axis_caps.CapMember) -> List<Node> {
  [
    cap_write_content_intent(
      content: m.content,
      path: bash_build_word_lit(text: m.dropin_path as String),
    ),
    cap_command_intent(words: systemctl_daemon_reload_argv()),
  ]
}

fn cap_upsert_script(m: gunbc.host_axis_caps.CapMember) -> String {
  cap_script_from_stmts(stmts: cap_upsert_stmts(m: m))
}

fn caps_reconcile(desired: List<gunbc.host_axis_caps.CapMember>, observed: List<gunbc.host_axis_caps.CapMember>) -> gunbc.membership_reconcile.MembershipPlan<gunbc.host_axis_caps.CapMember, gunbc.host_axis_caps.CapMemberAt> {
  gunbc.membership_reconcile.membership_plan_admitting_outcome(
    outcome: gunbc.membership_reconcile.membership_reconcile(
      desired: desired,
      observed: observed,
      key_of: cap_member_key,
      key_eq: cap_member_key_eq,
      value_eq: cap_member_value_eq,
      ownership_of: cap_member_ownership,
    ),
  )
}

fn caps_effects(desired: List<gunbc.host_axis_caps.CapMember>, observed: List<gunbc.host_axis_caps.CapMember>) -> gunbc.membership_reconcile.EffectsOrRefusal<gunbc.host_axis_caps.CapMember> {
  gunbc.membership_reconcile.membership_effects(plan: caps_reconcile(desired: desired, observed: observed))
}

fn caps_upsert_count(desired: List<gunbc.host_axis_caps.CapMember>, observed: List<gunbc.host_axis_caps.CapMember>) -> Int {
  gunbc.membership_reconcile.membership_write_count(plan: caps_reconcile(desired: desired, observed: observed))
}

fn caps_teardown_count(desired: List<gunbc.host_axis_caps.CapMember>, observed: List<gunbc.host_axis_caps.CapMember>) -> Int {
  gunbc.membership_reconcile.membership_removal_count(plan: caps_reconcile(desired: desired, observed: observed))
}

fn caps_refusal_count(desired: List<gunbc.host_axis_caps.CapMember>, observed: List<gunbc.host_axis_caps.CapMember>) -> Int {
  gunbc.membership_reconcile.membership_refusal_count(plan: caps_reconcile(desired: desired, observed: observed))
}

// system.control set-property residue — shadows deploy-authored drop-ins (sorts later, wins).
type ControlShadowMemberAt = std.types.NonEmptyStr

type ControlShadowUnit {
  unit: std.types.NonEmptyStr
}

data control_shadow_memory_max_filename: std.types.NonEmptyStr = "50-MemoryMax.conf"
data control_shadow_memory_high_filename: std.types.NonEmptyStr = "50-MemoryHigh.conf"

data control_shadow_managed_filenames: List<std.types.NonEmptyStr> = [
  control_shadow_memory_max_filename,
  control_shadow_memory_high_filename,
]

fn control_shadow_dropin_path(unit: std.types.NonEmptyStr, filename: std.types.NonEmptyStr) -> std.types.NonEmptyStr {
  join([
    gunbc.host_converge.gunbc_runner_control_dropin_dir_prefix,
    unit as String,
    ".d/",
    filename as String,
  ], "") as std.types.NonEmptyStr
}

fn control_shadow_unit(unit: std.types.NonEmptyStr) -> gunbc.host_axis_caps.ControlShadowUnit {
  ControlShadowUnit { unit: unit }
}

fn control_shadow_unit_key(u: gunbc.host_axis_caps.ControlShadowUnit) -> std.types.NonEmptyStr {
  u.unit
}

fn control_shadow_unit_key_eq(a: std.types.NonEmptyStr, b: std.types.NonEmptyStr) -> Bool {
  a as String == b as String
}

fn control_shadow_unit_value_eq(a: gunbc.host_axis_caps.ControlShadowUnit, b: gunbc.host_axis_caps.ControlShadowUnit) -> Bool {
  a.unit as String == b.unit as String
}

fn control_shadow_unit_ownership(u: gunbc.host_axis_caps.ControlShadowUnit) -> gunbc.ownership.Ownership? {
  Present { value: gunbc.ownership.Owned }
}

fn control_shadow_revert_script(u: gunbc.host_axis_caps.ControlShadowUnit) -> String {
  concat(join(extdeps.systemd.systemctl.systemctl_revert_memory_caps_argv(unit: u.unit), " "), "\n")
}

fn control_shadow_revert_script_matches_extdeps_argv(u: gunbc.host_axis_caps.ControlShadowUnit) -> Bool {
  join(extdeps.systemd.systemctl.systemctl_revert_memory_caps_argv(unit: u.unit), " ") == std.algebra.trim(s: control_shadow_revert_script(u: u))
}

fn derived_runner_memory_max_cap_member() -> gunbc.host_axis_caps.CapMember {
  desired_cap_member(
    dropin_path: gunbc.host_converge.gunbc_runner_per_slot_dropin_path as std.types.NonEmptyStr,
    property: extdeps.systemd.systemd_memory_max_property as std.types.NonEmptyStr,
    bytes_value: to_string(std.measure.byte_size_count(b: gunbc.runner_slot_allocation.gunbc_runner_slot_desired().memory_max)) as std.types.NonEmptyStr,
  )
}

fn derived_runner_memory_high_cap_member() -> gunbc.host_axis_caps.CapMember {
  desired_cap_member(
    dropin_path: gunbc.host_converge.gunbc_runner_per_slot_high_dropin_path as std.types.NonEmptyStr,
    property: extdeps.systemd.systemd_memory_high_property as std.types.NonEmptyStr,
    bytes_value: to_string(std.measure.byte_size_count(b: gunbc.runner_slot_allocation.gunbc_runner_slot_desired().memory_high)) as std.types.NonEmptyStr,
  )
}

fn derived_runner_memory_cap_members() -> List<gunbc.host_axis_caps.CapMember> {
  [derived_runner_memory_max_cap_member(), derived_runner_memory_high_cap_member()]
}

fn runner_memory_cap_author_stmts() -> List<Node> {
  concat(
    cap_upsert_stmts(m: derived_runner_memory_max_cap_member()),
    cap_upsert_stmts(m: derived_runner_memory_high_cap_member()),
  )
}

fn runner_memory_cap_author_script() -> String {
  cap_script_from_stmts(stmts: runner_memory_cap_author_stmts())
}

fn cap_observed_contains_derived_member(observed: List<gunbc.host_axis_caps.CapMember>, derived: gunbc.host_axis_caps.CapMember) -> Bool {
  fold(observed, init: false, f: (acc, o) =>
    acc
      || (
        cap_member_key(m: o) as String == cap_member_key(m: derived) as String
          && cap_member_value_eq(a: o, b: derived)
      )
  )
}

// Shadow revert is safe only after deploy drop-ins carry derived allocation bytes —
// reverting before author on stale 16/15GiB disk raises effective caps (operator hazard).
fn runner_memory_cap_author_ready_for_shadow_revert(observed: List<gunbc.host_axis_caps.CapMember>) -> Bool {
  fold(derived_runner_memory_cap_members(), init: true, f: (acc, d) =>
    acc && cap_observed_contains_derived_member(observed: observed, derived: d)
  )
}

data memory_cap_author_before_shadow_revert_ordering_note: String = "Deploy drop-ins (20-fleet-width MemoryMax, 40-fleet-high MemoryHigh) must be authored from gunbc.runner_slot_allocation BEFORE systemctl revert MemoryMax MemoryHigh on any unit. On-disk deploy files may still carry superseded 16/15GiB while effective caps match declared 14/13 via system.control shadows; revert alone drops shadows and falls back to stale disk."

data host_axis_caps_author_before_revert_enforced: Bool = true

fn runner_slot_service_units_range(host: product.placement_supply.HostIdentity, slot: Int, limit: Int) -> List<std.types.NonEmptyStr> {
  if slot > limit {
    []
  } else {
    concat(
      [gunbc.runner_lifecycle.runner_slot_unit_name(slot: gunbc.build_cache_instance.RunnerSlotIdentity { host: host, slot_index: slot }) as std.types.NonEmptyStr],
      runner_slot_service_units_range(host: host, slot: slot + 1, limit: limit)
    )
  }
}

fn runner_slot_service_units_for_host(host: product.placement_supply.HostIdentity) -> List<std.types.NonEmptyStr> {
  runner_slot_service_units_range(
    host: host,
    slot: 1,
    limit: gunbc.runner_slot_allocation.gunbc_runner_slots_per_host(host: host),
  )
}

// The staged path is a WORD, not a spelled-out quotation: variable reference and literal
// suffix are two parts of one concat word, so nothing here decides how "$_gunbc_stage" is
// quoted — the grammar does, at both the redirection target and the install argument, from
// the same word.
fn deploy_cap_stage_path_word(stage_name: String) -> Node {
  bash_build_word_concat_from_nodes(parts: [
    bash_build_word_var(name: "_gunbc_stage"),
    bash_build_word_lit(text: concat("/", stage_name)),
  ])
}

fn deploy_cap_upsert_staged_stmts(m: gunbc.host_axis_caps.CapMember, stage_name: String) -> List<Node> {
  [
    cap_write_content_intent(
      content: m.content,
      path: deploy_cap_stage_path_word(stage_name: stage_name),
    ),
    bash_build_command_with_words(words: concat(
      cap_lit_words(words: ["sudo", "-n", "install", "-m", "0644"]),
      [
        deploy_cap_stage_path_word(stage_name: stage_name),
        bash_build_word_lit(text: m.dropin_path as String),
      ],
    )),
  ]
}

fn deploy_runner_memory_cap_author_stmts() -> List<Node> {
  concat(
    concat(
      deploy_cap_upsert_staged_stmts(m: derived_runner_memory_max_cap_member(), stage_name: "20-fleet-width.conf"),
      deploy_cap_upsert_staged_stmts(m: derived_runner_memory_high_cap_member(), stage_name: "40-fleet-high.conf"),
    ),
    [cap_privileged_command_intent(argv: systemctl_daemon_reload_argv())],
  )
}

fn deploy_runner_memory_cap_author_script() -> String {
  cap_script_from_stmts(stmts: deploy_runner_memory_cap_author_stmts())
}

fn deploy_control_shadow_revert_stmt(u: gunbc.host_axis_caps.ControlShadowUnit) -> Node {
  cap_privileged_command_intent(argv: systemctl_revert_memory_caps_argv(unit: u.unit))
}

fn deploy_memory_cap_shadow_revert_stmts(units: List<std.types.NonEmptyStr>) -> List<Node> {
  map(units, unit => deploy_control_shadow_revert_stmt(u: control_shadow_unit(unit: unit)))
}

fn deploy_memory_cap_shadow_revert_script(units: List<std.types.NonEmptyStr>) -> String {
  cap_script_from_stmts(stmts: deploy_memory_cap_shadow_revert_stmts(units: units))
}

// Production deploy script: author derived template drop-ins, daemon-reload, then per-unit shadow revert.
fn deploy_memory_cap_apply_script_for_host(host: product.placement_supply.HostIdentity) -> String {
  deploy_memory_cap_apply_script_ordered(units: runner_slot_service_units_for_host(host: host))
}

// Deploy apply composite: author derived drop-ins first, then shadow revert per unit.
fn deploy_memory_cap_apply_script_ordered(units: List<std.types.NonEmptyStr>) -> String {
  cap_script_from_stmts(stmts: deploy_memory_cap_apply_stmts_ordered(units: units))
}

fn deploy_memory_cap_apply_stmts_ordered(units: List<std.types.NonEmptyStr>) -> List<Node> {
  concat(
    deploy_runner_memory_cap_author_stmts(),
    deploy_memory_cap_shadow_revert_stmts(units: units),
  )
}

// Pin external script to deploy_memory_cap_apply_script_ordered's concat(author, reverts).
fn deploy_memory_cap_script_matches_ordered_composition(script: String, units: List<std.types.NonEmptyStr>) -> Bool {
  script == deploy_memory_cap_apply_script_ordered(units: units)
}

// Independently derive author + revert halves; refuse reversed or padded wrong-order scripts.
fn deploy_memory_cap_script_author_precedes_shadow_revert(script: String, units: List<std.types.NonEmptyStr>) -> Bool {
  let ordered = cap_script_from_stmts(stmts: concat(
    deploy_runner_memory_cap_author_stmts(),
    deploy_memory_cap_shadow_revert_stmts(units: units),
  ))
  list_length(items: units) > 0 && script == ordered
}

// Enrolled: live_deploy apply emits deploy_memory_cap_apply_script_for_host after sudoers preamble.
data deploy_memory_cap_live_deploy_enrollment_note: String = "deploy_memory_cap_apply_script_for_host is emitted into live_deploy apply (gunbc.live_deploy.emit apply_intent_from_effects) after deploy_apply_preamble_steps — author derived drop-ins then systemctl revert per runner_slot_service_units_for_host."

fn control_shadow_reconcile(
  desired: List<gunbc.host_axis_caps.ControlShadowUnit>,
  observed: List<gunbc.host_axis_caps.ControlShadowUnit>,
) -> gunbc.membership_reconcile.MembershipPlan<gunbc.host_axis_caps.ControlShadowUnit, gunbc.host_axis_caps.ControlShadowMemberAt> {
  gunbc.membership_reconcile.membership_plan_admitting_outcome(
    outcome: gunbc.membership_reconcile.membership_reconcile(
      desired: desired,
      observed: observed,
      key_of: control_shadow_unit_key,
      key_eq: control_shadow_unit_key_eq,
      value_eq: control_shadow_unit_value_eq,
      ownership_of: control_shadow_unit_ownership,
    ),
  )
}

fn control_shadow_effects(
  desired: List<gunbc.host_axis_caps.ControlShadowUnit>,
  observed: List<gunbc.host_axis_caps.ControlShadowUnit>,
) -> gunbc.membership_reconcile.EffectsOrRefusal<gunbc.host_axis_caps.ControlShadowUnit> {
  gunbc.membership_reconcile.membership_effects(plan: control_shadow_reconcile(desired: desired, observed: observed))
}

fn control_shadow_teardown_count(
  desired: List<gunbc.host_axis_caps.ControlShadowUnit>,
  observed: List<gunbc.host_axis_caps.ControlShadowUnit>,
) -> Int {
  gunbc.membership_reconcile.membership_removal_count(plan: control_shadow_reconcile(desired: desired, observed: observed))
}

fn control_shadow_refusal_count(
  desired: List<gunbc.host_axis_caps.ControlShadowUnit>,
  observed: List<gunbc.host_axis_caps.ControlShadowUnit>,
) -> Int {
  gunbc.membership_reconcile.membership_refusal_count(plan: control_shadow_reconcile(desired: desired, observed: observed))
}
