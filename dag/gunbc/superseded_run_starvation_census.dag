module gunbc.superseded_run_starvation_census

import std.types { Bool, Int, String, Timestamp }
import std.measure { Second }

// One census identity is an ordered pair, never a run selected because it hurt. The observing
// instrument discovers every pair in a declared time window by PR identity and head transition.
type SupersededRunPair {
  pull_request: Int
  superseded_run: Int
  superseded_head: String
  live_head_run: Int
  live_head: String
}

// Absence of either job roster is coverage debt, not the reassuring `false` arm. `ReachedFirst`
// also covers a live-head run that still has zero registered jobs at the observation boundary:
// once a dead-head job has started, it necessarily started before an event that has not happened.
type DeadHeadStartStanding
  = DeadHeadReachedInProgressFirst
  | LiveHeadRegisteredJobFirst
  | NeitherRunRegisteredAJob

type CensusReadEnvelope {
  max_run_pages: Int
}

type CensusBoundaryObligation
  = LeftBoundaryLookbackExhausted { pull_request: Int, earliest_observed_run: Int }

fn dead_head_start_standing(
  dead_first_job_started_at: Timestamp?,
  live_first_job_created_at: Timestamp?
) -> DeadHeadStartStanding {
  match dead_first_job_started_at {
    Present { value: dead } =>
      match live_first_job_created_at {
        Absent => DeadHeadReachedInProgressFirst
        Present { value: live } =>
          if dead < live { DeadHeadReachedInProgressFirst }
          else { LiveHeadRegisteredJobFirst }
      }
    Absent =>
      match live_first_job_created_at {
        Present { value: _ } => LiveHeadRegisteredJobFirst
        Absent => NeitherRunRegisteredAJob
      }
  }
}

// Cancellation is priced at job grain. A run listing can lag the individual run resource during
// settlement, so the instrument refreshes that resource and never derives a status transition
// from successive listing reads. Cancelled work and a queued laggard can coexist in one aggregate.
type CancelledRunJobStanding {
  pair: SupersededRunPair
  cancelled_jobs: Int
  failed_jobs: Int
  queued_jobs: Int
  dead_time_under_hold: Second?
  group_hold_after_jobs: Second?
}
