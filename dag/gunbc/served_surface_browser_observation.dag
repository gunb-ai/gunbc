        bytes: byte_size(19520),
      },
      recovery_trials: [explicit_reload_recovery(body: "RECOVERED_REFUSED" as NonEmptyStr)],
    },
    NavigationPresentationSpecimen {
      id: EmptyBody502Specimen,
      stimulus: HttpResponseStimulus {
        requested_url: local_http_url(locator: "127.0.0.1:43821/empty" as NonEmptyStr),
        origin: LocalSyntheticHarness,
        status: 502,
        configured_headers: [
          ContentLengthHeader { bytes: byte_size(0) },
          GunbcSpecimenHeader { specimen: EmptyBody502Specimen },
        ],
        body: EmptyNavigationResponseBody,
      },
      navigation: ChromiumNavigationFailed { error: ChromiumErrHttpResponseCodeFailure },
      document: ChromiumInternalPresentedDocument {
        document: ChromiumWebDataErrorDocument,
        final_url: ChromiumWebDataErrorUrl,
      },
      screenshot: ScreenshotArtifact {
        path: "dag/test/fixtures/browser/chromium_151_empty_502.png" as BinaryFilePath,
        digest: sha256_digest(hex: "f8a0b51701f18c0ff3ea22825103e5016fe68e69c7eca1190ed8162c05df22c6" as NonEmptyStr),
        bytes: byte_size(14089),
      },
      recovery_trials: [explicit_reload_recovery(body: "RECOVERED_EMPTY" as NonEmptyStr)],
    },
    NavigationPresentationSpecimen {
      id: SentinelBody502Specimen,
      stimulus: HttpResponseStimulus {
        requested_url: local_http_url(locator: "127.0.0.1:43821/body" as NonEmptyStr),
        origin: LocalSyntheticHarness,
        status: 502,
        configured_headers: [
          ContentLengthHeader { bytes: byte_size(26) },
          TextPlainUtf8ContentTypeHeader,
          GunbcSpecimenHeader { specimen: SentinelBody502Specimen },
        ],
        body: Utf8NavigationResponseBody {
          text: "GUNBC_TYPED_ERROR_SENTINEL" as NonEmptyStr,
          bytes: byte_size(26),
        },
      },
      navigation: NavigationReturnedHttpResponse { status: 502 },
      document: NetworkResponsePresentedDocument {
        final_url: local_http_url(locator: "127.0.0.1:43821/body" as NonEmptyStr),
        response_specimen: SentinelBody502Specimen,
      },
      screenshot: ScreenshotArtifact {
        path: "dag/test/fixtures/browser/chromium_151_bodied_502.png" as BinaryFilePath,
        digest: sha256_digest(hex: "165dea20b5ecdaa9a864ff11c3924e9e6d3bbd956fa94f6b7827d948acc5bf71" as NonEmptyStr),
        bytes: byte_size(6337),
      },
      recovery_trials: [explicit_reload_recovery(body: "RECOVERED_BODY" as NonEmptyStr)],
    },
  ],
}

type SpecimenCoverage
  = | ExactSpecimenCoverage { specimen: NavigationSpecimenId }

fn navigation_specimen_coverage(specimen: NavigationPresentationSpecimen) -> SpecimenCoverage {
  ExactSpecimenCoverage { specimen: specimen.id }
}

data evidence_grain_note: NonEmptyStr = "This run claims only what the exact stimuli produced under its one Chromium, Playwright, operating-system, architecture, presentation-mode, and launch identity. Specimens cannot repeat or contradict build identity because identity exists only on BrowserDiscriminatorRun. LocalSyntheticHarness prevents these responses from standing in for a production proxy or operational cause. ExactSpecimenCoverage cannot widen EmptyBody502Specimen into all empty HTTP errors. RecoveryTrial records that ExplicitReload was performed and a healthy response document followed; it carries no reload-necessity constructor. The run names no browser support roster, production response chain, continuity guarantee, or roadmap implementation lane." as NonEmptyStr
