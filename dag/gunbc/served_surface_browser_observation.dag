module gunbc.served_surface_browser_observation


type LinuxKernelRelease = std.types.NonEmptyStr where brand("LinuxKernelRelease")

type ContainerVisibleHostKernel {
  visible_release: LinuxKernelRelease
}

type BrowserPresentationMode
  = | HeadlessPresentation

type BrowserLaunchConfiguration
  = | PlaywrightDefaultChromiumLaunch {
      executable_path: std.types.FilePath,
    }

type BrowserExecutionEnvironment {
  chromium_build: extdeps.browser.chromium.ChromiumBuild
  playwright_build: extdeps.automation.playwright.PlaywrightBuild
  browser_binary_provenance: extdeps.automation.playwright.PlaywrightBrowserBinaryProvenance
  container_userland: extdeps.os.debian.DebianRelease
  container_visible_host_kernel: ContainerVisibleHostKernel
  architecture: extdeps.toolchain.types.Architecture
  presentation_mode: BrowserPresentationMode
  launch_configuration: BrowserLaunchConfiguration
}

type NavigationHttpHeader
  = ContentLengthHeader { bytes: std.measure.ByteSize }
  | TextPlainUtf8ContentTypeHeader
  | Empty502SpecimenHeader
  | Sentinel502SpecimenHeader

type NavigationResponseBody
  = EmptyNavigationResponseBody
  | Utf8NavigationResponseBody {
      text: std.types.NonEmptyStr,
      bytes: std.measure.ByteSize,
    }

type NavigationStimulusOrigin
  = | LocalSyntheticHarness

type NavigationStimulus
  = TcpConnectionRefusedStimulus {
      requested_url: extdeps.uri.Uri,
      origin: NavigationStimulusOrigin,
    }
  | HttpResponseStimulus {
      requested_url: extdeps.uri.Uri,
      origin: NavigationStimulusOrigin,
      status: std.types.HttpStatus,
      configured_headers: List<NavigationHttpHeader>,
      body: NavigationResponseBody,
    }

type NavigationOutcome
  = ChromiumNavigationFailed {
      error: extdeps.browser.chromium.ChromiumNavigationError,
    }
  | NavigationReturnedHttpResponse {
      status: std.types.HttpStatus,
    }

type PresentedDocument
  = ChromiumInternalPresentedDocument {
      document: extdeps.browser.chromium.ChromiumInternalDocument,
      final_url: extdeps.browser.chromium.ChromiumInternalUrl,
    }
  | NetworkResponsePresentedDocument {
      final_url: extdeps.uri.Uri,
    }

type ScreenshotArtifact {
  path: std.types.BinaryFilePath
  digest: extdeps.crypto.hash.Digest
  bytes: std.measure.ByteSize
}

type HealthyTransition
  = | RouteChangedToHealthyHttpResponse {
      status: std.types.HttpStatus,
      body: std.types.NonEmptyStr,
    }

type RecoveryAction
  = | ExplicitReload

type RecoveryOutcome
  = | HealthyResponseDocumentObserved

type RecoveryTrial {
  healthy_transition: HealthyTransition
  action: RecoveryAction
  outcome: RecoveryOutcome
}

type NavigationPresentation {
  stimulus: NavigationStimulus
  navigation: NavigationOutcome
  document: PresentedDocument
}

type ConnectionRefusedExactSpecimen {
  requested_url: extdeps.uri.Uri
  origin: NavigationStimulusOrigin
  screenshot: ScreenshotArtifact
  recovery_trials: List<RecoveryTrial>
}

type EmptyBody502ExactSpecimen {
  requested_url: extdeps.uri.Uri
  origin: NavigationStimulusOrigin
  screenshot: ScreenshotArtifact
  recovery_trials: List<RecoveryTrial>
}

type SentinelBody502ExactSpecimen {
  requested_url: extdeps.uri.Uri
  origin: NavigationStimulusOrigin
  screenshot: ScreenshotArtifact
  recovery_trials: List<RecoveryTrial>
}

type Chromium151DiscriminatorSpecimens {
  connection_refused: ConnectionRefusedExactSpecimen
  empty_502: EmptyBody502ExactSpecimen
  sentinel_502: SentinelBody502ExactSpecimen
}

type PlaywrightChromium151DiscriminatorRun {
  environment: BrowserExecutionEnvironment
  observed_on: extdeps.time.rfc3339.Rfc3339Timestamp
  specimens: Chromium151DiscriminatorSpecimens
}

fn local_http_url(locator: std.types.NonEmptyStr) -> extdeps.uri.Uri {
  extdeps.uri.Uri { scheme: Http, locator: locator }
}

fn explicit_reload_recovery(body: std.types.NonEmptyStr) -> RecoveryTrial {
  RecoveryTrial {
    healthy_transition: RouteChangedToHealthyHttpResponse {
      status: 200,
      body: body,
    },
    action: ExplicitReload,
    outcome: HealthyResponseDocumentObserved,
  }
}

fn connection_refused_presentation(specimen: ConnectionRefusedExactSpecimen) -> NavigationPresentation {
  NavigationPresentation {
    stimulus: TcpConnectionRefusedStimulus {
      requested_url: specimen.requested_url,
      origin: specimen.origin,
    },
    navigation: ChromiumNavigationFailed { error: ChromiumErrConnectionRefused },
    document: ChromiumInternalPresentedDocument {
      document: ChromiumWebDataErrorDocument,
      final_url: ChromiumWebDataErrorUrl,
    },
  }
}

fn empty_body_502_presentation(specimen: EmptyBody502ExactSpecimen) -> NavigationPresentation {
  NavigationPresentation {
    stimulus: HttpResponseStimulus {
      requested_url: specimen.requested_url,
      origin: specimen.origin,
      status: 502,
      configured_headers: [
        ContentLengthHeader { bytes: byte_size(0) },
        Empty502SpecimenHeader,
      ],
      body: EmptyNavigationResponseBody,
    },
    navigation: ChromiumNavigationFailed { error: ChromiumErrHttpResponseCodeFailure },
    document: ChromiumInternalPresentedDocument {
      document: ChromiumWebDataErrorDocument,
      final_url: ChromiumWebDataErrorUrl,
    },
  }
}

fn sentinel_body_502_presentation(specimen: SentinelBody502ExactSpecimen) -> NavigationPresentation {
  NavigationPresentation {
    stimulus: HttpResponseStimulus {
      requested_url: specimen.requested_url,
      origin: specimen.origin,
      status: 502,
      configured_headers: [
        ContentLengthHeader { bytes: byte_size(26) },
        TextPlainUtf8ContentTypeHeader,
        Sentinel502SpecimenHeader,
      ],
      body: Utf8NavigationResponseBody {
        text: "GUNBC_TYPED_ERROR_SENTINEL" as std.types.NonEmptyStr,
        bytes: byte_size(26),
      },
    },
    navigation: NavigationReturnedHttpResponse { status: 502 },
    document: NetworkResponsePresentedDocument { final_url: specimen.requested_url },
  }
}

data playwright_chromium_151_linux_arm64_headless_navigation_run: PlaywrightChromium151DiscriminatorRun = PlaywrightChromium151DiscriminatorRun {
  environment: BrowserExecutionEnvironment {
    chromium_build: extdeps.browser.chromium.chromium_151_0_7922_34,
    playwright_build: playwright_1_62_1,
    browser_binary_provenance: PlaywrightManagedChromiumDownload,
    container_userland: Debian12Bookworm,
    container_visible_host_kernel: ContainerVisibleHostKernel {
      visible_release: "6.8.0-124-generic" as LinuxKernelRelease,
    },
    architecture: Aarch64,
    presentation_mode: HeadlessPresentation,
    launch_configuration: PlaywrightDefaultChromiumLaunch {
      executable_path: "/session-home/.cache/ms-playwright/chromium-1234/chrome-linux/chrome" as std.types.FilePath,
    },
  },
  observed_on: "2026-08-01T04:58:15Z" as extdeps.time.rfc3339.Rfc3339Timestamp,
  specimens: Chromium151DiscriminatorSpecimens {
    connection_refused: ConnectionRefusedExactSpecimen {
      requested_url: local_http_url(locator: "127.0.0.1:43822/refused" as std.types.NonEmptyStr),
      origin: LocalSyntheticHarness,
      screenshot: ScreenshotArtifact {
        path: "dag/test/fixtures/browser/chromium_151_connection_refused.png" as std.types.BinaryFilePath,
        digest: sha256_digest(hex: "637bf51bb5163ec58e6f325d1ed304bfa3618940ac75cb493ddd81d4895b29d3" as std.types.NonEmptyStr),
        bytes: byte_size(19520),
      },
      recovery_trials: [explicit_reload_recovery(body: "RECOVERED_REFUSED" as std.types.NonEmptyStr)],
    },
    empty_502: EmptyBody502ExactSpecimen {
      requested_url: local_http_url(locator: "127.0.0.1:43821/empty" as std.types.NonEmptyStr),
      origin: LocalSyntheticHarness,
      screenshot: ScreenshotArtifact {
        path: "dag/test/fixtures/browser/chromium_151_empty_502.png" as std.types.BinaryFilePath,
        digest: sha256_digest(hex: "f8a0b51701f18c0ff3ea22825103e5016fe68e69c7eca1190ed8162c05df22c6" as std.types.NonEmptyStr),
        bytes: byte_size(14089),
      },
      recovery_trials: [explicit_reload_recovery(body: "RECOVERED_EMPTY" as std.types.NonEmptyStr)],
    },
    sentinel_502: SentinelBody502ExactSpecimen {
      requested_url: local_http_url(locator: "127.0.0.1:43821/body" as std.types.NonEmptyStr),
      origin: LocalSyntheticHarness,
      screenshot: ScreenshotArtifact {
        path: "dag/test/fixtures/browser/chromium_151_bodied_502.png" as std.types.BinaryFilePath,
        digest: sha256_digest(hex: "165dea20b5ecdaa9a864ff11c3924e9e6d3bbd956fa94f6b7827d948acc5bf71" as std.types.NonEmptyStr),
        bytes: byte_size(6337),
      },
      recovery_trials: [explicit_reload_recovery(body: "RECOVERED_BODY" as std.types.NonEmptyStr)],
    },
  },
}

data evidence_grain_note: std.types.NonEmptyStr = "The one PlaywrightChromium151DiscriminatorRun receipt owns three distinct exact specimen types. Each type derives its empirical stimulus, navigation outcome, and presented document together, so a contradictory exact-coverage label cannot be constructed independently; its screenshot and recovery trials remain nested historical values. Chromium151DiscriminatorSpecimens fixes the three-case denominator without turning the observed result into a timeless decision table; a future build or environment carries its own receipt. Debian12Bookworm records the container userland reported by /etc/os-release; ContainerVisibleHostKernel separately records the host kernel release exposed by uname inside that container and does not infer a host operating-system distribution from its suffix. LocalSyntheticHarness prevents these responses from standing in for a production proxy or operational cause. EmptyBody502ExactSpecimen cannot widen one specimen into all empty HTTP errors. RecoveryTrial records that ExplicitReload was performed and a healthy response document followed; it carries no reload-necessity constructor. The run names no browser support roster, production response chain, continuity guarantee, or roadmap implementation lane." as std.types.NonEmptyStr
