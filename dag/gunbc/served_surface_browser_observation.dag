module gunbc.served_surface_browser_observation

import std.types { NonEmptyStr, List, BinaryFilePath, FilePath, HttpStatus }
import std.measure { ByteSize, byte_size }
import extdeps.uri { Uri, Http }
import extdeps.time.rfc3339 { Rfc3339Timestamp }
import extdeps.crypto.hash { Digest, sha256_digest }
import extdeps.toolchain.types { Architecture, Aarch64 }
import extdeps.os.debian { DebianRelease, Debian12Bookworm }
import extdeps.browser.chromium {
  ChromiumBuild,
  ChromiumNavigationError,
  ChromiumErrConnectionRefused,
  ChromiumErrHttpResponseCodeFailure,
  ChromiumInternalDocument,
  ChromiumWebDataErrorDocument,
  ChromiumInternalUrl,
  ChromiumWebDataErrorUrl,
  chromium_151_0_7922_34,
}
import extdeps.automation.playwright {
  PlaywrightBuild,
  PlaywrightBrowserBinaryProvenance,
  PlaywrightManagedChromiumDownload,
  playwright_1_62_1,
}

type LinuxKernelRelease = NonEmptyStr where brand("LinuxKernelRelease")

type ContainerVisibleHostKernel {
  visible_release: LinuxKernelRelease
}

type BrowserPresentationMode
  = | HeadlessPresentation

type BrowserLaunchConfiguration
  = | PlaywrightDefaultChromiumLaunch {
      executable_path: FilePath,
    }

type BrowserExecutionEnvironment {
  chromium_build: ChromiumBuild
  playwright_build: PlaywrightBuild
  browser_binary_provenance: PlaywrightBrowserBinaryProvenance
  container_userland: DebianRelease
  container_visible_host_kernel: ContainerVisibleHostKernel
  architecture: Architecture
  presentation_mode: BrowserPresentationMode
  launch_configuration: BrowserLaunchConfiguration
}

type NavigationHttpHeader
  = ContentLengthHeader { bytes: ByteSize }
  | TextPlainUtf8ContentTypeHeader
  | Empty502SpecimenHeader
  | Sentinel502SpecimenHeader

type NavigationResponseBody
  = EmptyNavigationResponseBody
  | Utf8NavigationResponseBody {
      text: NonEmptyStr,
      bytes: ByteSize,
    }

type NavigationStimulusOrigin
  = | LocalSyntheticHarness

type NavigationStimulus
  = TcpConnectionRefusedStimulus {
      requested_url: Uri,
      origin: NavigationStimulusOrigin,
    }
  | HttpResponseStimulus {
      requested_url: Uri,
      origin: NavigationStimulusOrigin,
      status: HttpStatus,
      configured_headers: List<NavigationHttpHeader>,
      body: NavigationResponseBody,
    }

type NavigationOutcome
  = ChromiumNavigationFailed {
      error: ChromiumNavigationError,
    }
  | NavigationReturnedHttpResponse {
      status: HttpStatus,
    }

type PresentedDocument
  = ChromiumInternalPresentedDocument {
      document: ChromiumInternalDocument,
      final_url: ChromiumInternalUrl,
    }
  | NetworkResponsePresentedDocument {
      final_url: Uri,
    }

type ScreenshotArtifact {
  path: BinaryFilePath
  digest: Digest
  bytes: ByteSize
}

type HealthyTransition
  = | RouteChangedToHealthyHttpResponse {
      status: HttpStatus,
      body: NonEmptyStr,
    }

type RecoveryAction
  = | ExplicitReload

type RecoveryOutcome
  = | HealthyResponseDocumentObserved

type RecoveryTrial {
  healthy_transition: HealthyTransition
  action: RecoveryAction
  outcome: RecoveryOutcome
}

type NavigationPresentationSpecimen
  = ConnectionRefusedPresentationSpecimen
  | EmptyBody502PresentationSpecimen
  | SentinelBody502PresentationSpecimen

type BrowserDiscriminatorRun {
  environment: BrowserExecutionEnvironment
  observed_on: Rfc3339Timestamp
  specimens: List<NavigationPresentationSpecimen>
}

fn local_http_url(locator: NonEmptyStr) -> Uri {
  Uri { scheme: Http, locator: locator }
}

fn explicit_reload_recovery(body: NonEmptyStr) -> RecoveryTrial {
  RecoveryTrial {
    healthy_transition: RouteChangedToHealthyHttpResponse {
      status: 200,
      body: body,
    },
    action: ExplicitReload,
    outcome: HealthyResponseDocumentObserved,
  }
}

data playwright_chromium_151_linux_arm64_headless_navigation_run: BrowserDiscriminatorRun = BrowserDiscriminatorRun {
  environment: BrowserExecutionEnvironment {
    chromium_build: chromium_151_0_7922_34,
    playwright_build: playwright_1_62_1,
    browser_binary_provenance: PlaywrightManagedChromiumDownload,
    container_userland: Debian12Bookworm,
    container_visible_host_kernel: ContainerVisibleHostKernel {
      visible_release: "6.8.0-124-generic" as LinuxKernelRelease,
    },
    architecture: Aarch64,
    presentation_mode: HeadlessPresentation,
    launch_configuration: PlaywrightDefaultChromiumLaunch {
      executable_path: "/session-home/.cache/ms-playwright/chromium-1234/chrome-linux/chrome" as FilePath,
    },
  },
  observed_on: "2026-08-01T04:58:15Z" as Rfc3339Timestamp,
  specimens: [
    ConnectionRefusedPresentationSpecimen,
    EmptyBody502PresentationSpecimen,
    SentinelBody502PresentationSpecimen,
  ],
}

fn navigation_specimen_stimulus(specimen: NavigationPresentationSpecimen) -> NavigationStimulus {
  match specimen {
    ConnectionRefusedPresentationSpecimen =>
      TcpConnectionRefusedStimulus {
        requested_url: local_http_url(locator: "127.0.0.1:43822/refused" as NonEmptyStr),
        origin: LocalSyntheticHarness,
      }
    EmptyBody502PresentationSpecimen =>
      HttpResponseStimulus {
        requested_url: local_http_url(locator: "127.0.0.1:43821/empty" as NonEmptyStr),
        origin: LocalSyntheticHarness,
        status: 502,
        configured_headers: [
          ContentLengthHeader { bytes: byte_size(0) },
          Empty502SpecimenHeader,
        ],
        body: EmptyNavigationResponseBody,
      }
    SentinelBody502PresentationSpecimen =>
      HttpResponseStimulus {
        requested_url: local_http_url(locator: "127.0.0.1:43821/body" as NonEmptyStr),
        origin: LocalSyntheticHarness,
        status: 502,
        configured_headers: [
          ContentLengthHeader { bytes: byte_size(26) },
          TextPlainUtf8ContentTypeHeader,
          Sentinel502SpecimenHeader,
        ],
        body: Utf8NavigationResponseBody {
          text: "GUNBC_TYPED_ERROR_SENTINEL" as NonEmptyStr,
          bytes: byte_size(26),
        },
      }
  }
}

fn navigation_specimen_outcome(specimen: NavigationPresentationSpecimen) -> NavigationOutcome {
  match specimen {
    ConnectionRefusedPresentationSpecimen =>
      ChromiumNavigationFailed { error: ChromiumErrConnectionRefused }
    EmptyBody502PresentationSpecimen =>
      ChromiumNavigationFailed { error: ChromiumErrHttpResponseCodeFailure }
    SentinelBody502PresentationSpecimen =>
      NavigationReturnedHttpResponse { status: 502 }
  }
}

fn navigation_specimen_document(specimen: NavigationPresentationSpecimen) -> PresentedDocument {
  match specimen {
    ConnectionRefusedPresentationSpecimen =>
      ChromiumInternalPresentedDocument {
        document: ChromiumWebDataErrorDocument,
        final_url: ChromiumWebDataErrorUrl,
      }
    EmptyBody502PresentationSpecimen =>
      ChromiumInternalPresentedDocument {
        document: ChromiumWebDataErrorDocument,
        final_url: ChromiumWebDataErrorUrl,
      }
    SentinelBody502PresentationSpecimen => NetworkResponsePresentedDocument {
      final_url: local_http_url(locator: "127.0.0.1:43821/body" as NonEmptyStr),
    }
  }
}

fn navigation_specimen_screenshot(specimen: NavigationPresentationSpecimen) -> ScreenshotArtifact {
  match specimen {
    ConnectionRefusedPresentationSpecimen => ScreenshotArtifact {
      path: "dag/test/fixtures/browser/chromium_151_connection_refused.png" as BinaryFilePath,
      digest: sha256_digest(hex: "637bf51bb5163ec58e6f325d1ed304bfa3618940ac75cb493ddd81d4895b29d3" as NonEmptyStr),
      bytes: byte_size(19520),
    }
    EmptyBody502PresentationSpecimen => ScreenshotArtifact {
      path: "dag/test/fixtures/browser/chromium_151_empty_502.png" as BinaryFilePath,
      digest: sha256_digest(hex: "f8a0b51701f18c0ff3ea22825103e5016fe68e69c7eca1190ed8162c05df22c6" as NonEmptyStr),
      bytes: byte_size(14089),
    }
    SentinelBody502PresentationSpecimen => ScreenshotArtifact {
      path: "dag/test/fixtures/browser/chromium_151_bodied_502.png" as BinaryFilePath,
      digest: sha256_digest(hex: "165dea20b5ecdaa9a864ff11c3924e9e6d3bbd956fa94f6b7827d948acc5bf71" as NonEmptyStr),
      bytes: byte_size(6337),
    }
  }
}

fn navigation_specimen_recovery_trials(specimen: NavigationPresentationSpecimen) -> List<RecoveryTrial> {
  match specimen {
    ConnectionRefusedPresentationSpecimen => [explicit_reload_recovery(body: "RECOVERED_REFUSED" as NonEmptyStr)]
    EmptyBody502PresentationSpecimen => [explicit_reload_recovery(body: "RECOVERED_EMPTY" as NonEmptyStr)]
    SentinelBody502PresentationSpecimen => [explicit_reload_recovery(body: "RECOVERED_BODY" as NonEmptyStr)]
  }
}

type SpecimenCoverage
  = ConnectionRefusedExactCoverage
  | EmptyBody502ExactCoverage
  | SentinelBody502ExactCoverage

fn navigation_specimen_coverage(specimen: NavigationPresentationSpecimen) -> SpecimenCoverage {
  match specimen {
    ConnectionRefusedPresentationSpecimen => ConnectionRefusedExactCoverage
    EmptyBody502PresentationSpecimen => EmptyBody502ExactCoverage
    SentinelBody502PresentationSpecimen => SentinelBody502ExactCoverage
  }
}

data evidence_grain_note: NonEmptyStr = "This run claims only what the exact stimuli produced under its one Chromium, Playwright, container-userland, container-visible host-kernel, architecture, presentation-mode, and launch identity. Debian12Bookworm records the container userland reported by /etc/os-release; ContainerVisibleHostKernel separately records the host kernel release exposed by uname inside that container and does not infer a host operating-system distribution from its suffix. Each exact specimen constructor is the sole authored identity; stimulus, navigation outcome, presented document, coverage, screenshot, and recovery are projections from that constructor, so their correlated facts cannot be authored inconsistently. LocalSyntheticHarness prevents these responses from standing in for a production proxy or operational cause. EmptyBody502ExactCoverage cannot widen one specimen into all empty HTTP errors. RecoveryTrial records that ExplicitReload was performed and a healthy response document followed; it carries no reload-necessity constructor. The run names no browser support roster, production response chain, continuity guarantee, or roadmap implementation lane." as NonEmptyStr
