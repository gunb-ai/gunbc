module gunbc.bach_double_slit_path_additivity_synthetic_fixture


data synthetic_fixture_note: String = "SYNTHETIC MECHANISM FIXTURE — NOT Bach et al. 2013 provenance. Rows exercise gunbc.physics.bach_double_slit_path_additivity with equal declared exposure identity; classical mechanism adds raw counts."

data synthetic_double_slit_fixture: gunbc.physics.bach_double_slit_path_additivity.SyntheticDoubleSlitFixture = gunbc.physics.bach_double_slit_path_additivity.SyntheticDoubleSlitFixtureOne {}

data synthetic_first_minimum_both_open: gunbc.physics.bach_double_slit_path_additivity.SyntheticArrivalCountObservationRow = gunbc.physics.bach_double_slit_path_additivity.SyntheticArrivalCountObservationRow {
  fixture: synthetic_double_slit_fixture,
  arrangement: BothSlitsOpen,
  band: FirstMinimumBand,
  exposure: gunbc.physics.bach_double_slit_path_additivity.SyntheticMatchedExposureOne {},
  arrival_count: 5,
}

data synthetic_first_minimum_slit_one: gunbc.physics.bach_double_slit_path_additivity.SyntheticArrivalCountObservationRow = gunbc.physics.bach_double_slit_path_additivity.SyntheticArrivalCountObservationRow {
  fixture: synthetic_double_slit_fixture,
  arrangement: SlitOneOpen,
  band: FirstMinimumBand,
  exposure: gunbc.physics.bach_double_slit_path_additivity.SyntheticMatchedExposureOne {},
  arrival_count: 10,
}

data synthetic_first_minimum_slit_two: gunbc.physics.bach_double_slit_path_additivity.SyntheticArrivalCountObservationRow = gunbc.physics.bach_double_slit_path_additivity.SyntheticArrivalCountObservationRow {
  fixture: synthetic_double_slit_fixture,
  arrangement: SlitTwoOpen,
  band: FirstMinimumBand,
  exposure: gunbc.physics.bach_double_slit_path_additivity.SyntheticMatchedExposureOne {},
  arrival_count: 10,
}

data synthetic_central_both_open: gunbc.physics.bach_double_slit_path_additivity.SyntheticArrivalCountObservationRow = gunbc.physics.bach_double_slit_path_additivity.SyntheticArrivalCountObservationRow {
  fixture: synthetic_double_slit_fixture,
  arrangement: BothSlitsOpen,
  band: CentralBand,
  exposure: gunbc.physics.bach_double_slit_path_additivity.SyntheticMatchedExposureOne {},
  arrival_count: 95,
}

data synthetic_central_slit_one: gunbc.physics.bach_double_slit_path_additivity.SyntheticArrivalCountObservationRow = gunbc.physics.bach_double_slit_path_additivity.SyntheticArrivalCountObservationRow {
  fixture: synthetic_double_slit_fixture,
  arrangement: SlitOneOpen,
  band: CentralBand,
  exposure: gunbc.physics.bach_double_slit_path_additivity.SyntheticMatchedExposureOne {},
  arrival_count: 40,
}

data synthetic_central_slit_two: gunbc.physics.bach_double_slit_path_additivity.SyntheticArrivalCountObservationRow = gunbc.physics.bach_double_slit_path_additivity.SyntheticArrivalCountObservationRow {
  fixture: synthetic_double_slit_fixture,
  arrangement: SlitTwoOpen,
  band: CentralBand,
  exposure: gunbc.physics.bach_double_slit_path_additivity.SyntheticMatchedExposureOne {},
  arrival_count: 38,
}

data synthetic_blocked_central: gunbc.physics.bach_double_slit_path_additivity.SyntheticArrivalCountObservationRow = gunbc.physics.bach_double_slit_path_additivity.SyntheticArrivalCountObservationRow {
  fixture: synthetic_double_slit_fixture,
  arrangement: BothSlitsBlocked,
  band: CentralBand,
  exposure: gunbc.physics.bach_double_slit_path_additivity.SyntheticMatchedExposureOne {},
  arrival_count: 0,
}

data synthetic_fixture_arrival_count_observations: List<gunbc.physics.bach_double_slit_path_additivity.SyntheticArrivalCountObservationRow> = [
  synthetic_first_minimum_both_open,
  synthetic_first_minimum_slit_one,
  synthetic_first_minimum_slit_two,
  synthetic_central_both_open,
  synthetic_central_slit_one,
  synthetic_central_slit_two,
  synthetic_blocked_central,
]

data path_additivity_subject: gunbc.physics.bach_double_slit_path_additivity.PathAdditivitySubject = gunbc.physics.bach_double_slit_path_additivity.PathAdditivitySyntheticFixture {}

fn synthetic_first_minimum_verdict() -> gunbc.physics.bach_double_slit_path_additivity.PathAdditivityBandVerdict {
  derive_path_additivity_refutation_at_band(
    rows: synthetic_fixture_arrival_count_observations,
    fixture: synthetic_double_slit_fixture,
    band: FirstMinimumBand,
    exposure: gunbc.physics.bach_double_slit_path_additivity.SyntheticMatchedExposureOne {},
  )
}

data bach_double_slit_path_additivity_first_minimum_verdict: gunbc.physics.bach_double_slit_path_additivity.PathAdditivityBandVerdict = synthetic_first_minimum_verdict()

fn synthetic_first_minimum_receipt_resolution() -> gunbc.physics.bach_double_slit_path_additivity.RefutationReceiptResolution {
  refutation_receipt_resolution_from_band_verdict(verdict: synthetic_first_minimum_verdict())
}

fn bach_double_slit_path_additivity_refutation_holds() -> Bool {
  match bach_double_slit_path_additivity_first_minimum_verdict {
    PathAdditivityRefutationAtBand { receipt: receipt } =>
      path_additivity_refutation_holds_for_synthetic_fixture(receipt: receipt)
    PathAdditivityHeldAtBand {
      band: held_band,
      exposure: held_exposure,
    } => false
    PathAdditivityUndecidedAtBand { failure: undecided_failure } => false
  }
}

fn synthetic_path_additivity_receipt_matches_fold_kernel(
  receipt: gunbc.physics.bach_double_slit_path_additivity.PathAdditivityRefutationReceipt,
  band: gunbc.physics.bach_double_slit_path_additivity.ScreenBand,
  exposure: gunbc.physics.bach_double_slit_path_additivity.SyntheticMatchedExposureSession,
) -> Bool {
  match resolve_additivity_inputs(
    rows: synthetic_fixture_arrival_count_observations,
    fixture: synthetic_double_slit_fixture,
    band: band,
    exposure: exposure,
  ) {
    AdditivityInputsResolved {
      left: resolved_left,
      right: resolved_right,
      both: resolved_both,
      left_contributing_rows: resolved_left_rows,
      right_contributing_rows: resolved_right_rows,
      both_contributing_rows: resolved_both_rows,
    } =>
      receipt.witness.left_alternative_count == resolved_left
        && receipt.witness.right_alternative_count == resolved_right
        && receipt.witness.both_open_observed_count == resolved_both
    AdditivityInputsIncomplete {
      missing_arrangement: missing_arrangement,
      band: incomplete_band,
      exposure: incomplete_exposure,
    } => false
    AdditivityInputsAmbiguous {
      arrangement: ambiguous_arrangement,
      band: ambiguous_band,
      exposure: ambiguous_exposure,
      matching_rows: ambiguous_matching_rows,
    } => false
  }
}

fn synthetic_central_band_verdict() -> gunbc.physics.bach_double_slit_path_additivity.PathAdditivityBandVerdict {
  derive_path_additivity_refutation_at_band(
    rows: synthetic_fixture_arrival_count_observations,
    fixture: synthetic_double_slit_fixture,
    band: CentralBand,
    exposure: gunbc.physics.bach_double_slit_path_additivity.SyntheticMatchedExposureOne {},
  )
}

fn bach_double_slit_path_additivity_central_band_refutation_holds() -> Bool {
  match derive_path_additivity_refutation_at_band(
    rows: synthetic_fixture_arrival_count_observations,
    fixture: synthetic_double_slit_fixture,
    band: CentralBand,
    exposure: gunbc.physics.bach_double_slit_path_additivity.SyntheticMatchedExposureOne {},
  ) {
    PathAdditivityRefutationAtBand {
      receipt: PathAdditivityRefutationReceipt {
        witness: w,
        subject: s,
        location: l,
      },
    } =>
      path_additivity_witness_is_counterexample(witness: w)
        && path_additivity_witness_observed_vs_prediction(witness: w) == Greater
    PathAdditivityHeldAtBand {
      band: held_band,
      exposure: held_exposure,
    } => false
    PathAdditivityUndecidedAtBand { failure: undecided_failure } => false
  }
}

fn synthetic_derive_first_minimum_verdict_from_partial_rows() -> gunbc.physics.bach_double_slit_path_additivity.PathAdditivityBandVerdict {
  let partial_rows = [
    synthetic_first_minimum_both_open,
    synthetic_first_minimum_slit_one,
  ]
  derive_path_additivity_refutation_at_band(
    rows: partial_rows,
    fixture: synthetic_double_slit_fixture,
    band: FirstMinimumBand,
    exposure: gunbc.physics.bach_double_slit_path_additivity.SyntheticMatchedExposureOne {},
  )
}

fn synthetic_blocked_count_is_resolved_zero_not_missing() -> Bool {
  match resolve_arrival_count_at(
    rows: synthetic_fixture_arrival_count_observations,
    fixture: synthetic_double_slit_fixture,
    arrangement: BothSlitsBlocked,
    band: CentralBand,
    exposure: gunbc.physics.bach_double_slit_path_additivity.SyntheticMatchedExposureOne {},
  ) {
    ArrivalCountResolved { count: 0, contributing_rows: 1 } => true
    ArrivalCountMissing {
      arrangement: missing_arrangement,
      band: missing_band,
      exposure: missing_exposure,
    } => false
    ArrivalCountAmbiguous {
      arrangement: ambiguous_arrangement,
      band: ambiguous_band,
      exposure: ambiguous_exposure,
      matching_rows: ambiguous_matching_rows,
    } => false
  }
}

fn synthetic_missing_row_yields_incomplete_inputs() -> Bool {
  let partial_rows = [
    synthetic_first_minimum_both_open,
    synthetic_first_minimum_slit_one,
  ]
  match resolve_additivity_inputs(
    rows: partial_rows,
    fixture: synthetic_double_slit_fixture,
    band: FirstMinimumBand,
    exposure: gunbc.physics.bach_double_slit_path_additivity.SyntheticMatchedExposureOne {},
  ) {
    AdditivityInputsIncomplete {
      missing_arrangement: SlitTwoOpen,
      band: incomplete_band,
      exposure: incomplete_exposure,
    } => true
    AdditivityInputsResolved {
      left: resolved_left,
      right: resolved_right,
      both: resolved_both,
      left_contributing_rows: resolved_left_rows,
      right_contributing_rows: resolved_right_rows,
      both_contributing_rows: resolved_both_rows,
    } => false
    AdditivityInputsAmbiguous {
      arrangement: ambiguous_arrangement,
      band: ambiguous_band,
      exposure: ambiguous_exposure,
      matching_rows: ambiguous_matching_rows,
    } => false
  }
}

fn synthetic_fold_receipt_resolution_matches_kernel_counts() -> Bool {
  match synthetic_first_minimum_receipt_resolution() {
    RefutationReceiptResolved { receipt: folded } =>
      match path_additivity_refutation_receipt_resolution_from_resolved_counts(
        left: 10,
        right: 10,
        both: 5,
        band: FirstMinimumBand,
        exposure: gunbc.physics.bach_double_slit_path_additivity.SyntheticMatchedExposureOne {},
      ) {
        RefutationReceiptResolved { receipt: kernel } =>
          kernel.witness.left_alternative_count == folded.witness.left_alternative_count
            && kernel.witness.right_alternative_count == folded.witness.right_alternative_count
            && kernel.witness.both_open_observed_count == folded.witness.both_open_observed_count
        RefutationNotEstablished { reason: AdditivityUndecided { failure: not_established_failure } } => false
        RefutationNotEstablished { reason: AdditivityHeld { band: held_band, exposure: held_exposure } } => false
      }
    RefutationNotEstablished { reason: AdditivityUndecided { failure: not_established_failure } } => false
    RefutationNotEstablished { reason: AdditivityHeld { band: held_band, exposure: held_exposure } } => false
  }
}
