module gunbc.replacement_cut

import std.types { String, NonEmptyStr, Bool, Int, List, list_length }
import std.content_hash {
  Fnv1a64Structural,
  content_hash_atom, content_hash_combine_structural, content_hash_tagged_structural,
  content_hash_eq_structural,
}
// decl_ref itself is deliberately NOT imported: the admit_callers annotations below already
// resolved it before this module imported anything from std.decl_ref, and adding the name to the
// import block is the shadowing hazard rather than tidiness.
import std.decl_ref { DeclarationRef, declaration_ref_eq, declaration_ref_display_key }

// THE MECHANICAL PLANNING CARRIER FOR REPLACEMENT MIGRATIONS (DESIGN section 3 standing rule,
// operator-directed 2026-08-15; hardened per the 2026-08-15 planning-thread review). A
// ReplacementCut names one consumer-relative boundary: the exact old root consumer, subject
// population and semantic contract; the Y authority proposed at that boundary; the X region deleted
// at cutover; the boundary-consumer census with every consumer's earned disposition; X's permitted
// external roles from a CLOSED vocabulary (a forbidden role -- fallback, internal resolver,
// production second opinion -- has no constructor); and the evidence dispositions. Construction
// encodes the greedy root-first search: why_not_higher is a required field, so a cut cannot be
// authored without stating either that its boundary is outermost or which parent cut's refusal
// pushed it down -- the descended arm names the parent by ReplacementCutId, a joinable typed
// reference, never prose alone. A THIRD ARM, DescentParentUnauthored, carries the state a real
// first subject actually lands in: this boundary is not outermost AND no cut has been authored at
// the boundary above it, so there is no id to name. It names the intended parent BOUNDARY and a
// basis, deliberately carrying no identifier -- an optional id would be the same
// joinable-but-unresolvable hazard wearing a Maybe. Without it the honest state has no constructor
// and the carrier forces a false one, both falses being worse than they look: OutermostBoundary
// mints a sealed, digest-bound, sole_constructor AdmittedReplacementCutPlan asserting a boundary is
// outermost when it is not, and a minted parent id is false AND JOINS CLEANLY, which no reader can
// detect. See replacement_cut_unjoined_parent_rung_note for what this arm does NOT fix.
//
// ADMISSION IS PLAN ADMISSION, and the vocabulary says so: admit_replacement_cut_plan judges the
// AUTHORED PLAN's completeness and internal coherence, not the world. It refuses, all causes
// counted, on: any undecided consumer or evidence row; any surviving consumer without a named
// coverage authority; coverage or replacement naming the old root itself (fallback wearing a
// disposition); an empty covered region; old and new root identical; a census enumerated yet empty
// (the bottom-as-answer conflation -- a genuinely consumer-free boundary is declared with
// BoundaryDeclaredEmpty and a basis, never left as an ambiguous empty list); an ExternalXRoles list
// enumerated yet empty (the same conflation on the oracle axis -- no-oracle-needed is the justified
// NoExternalOracleRequired arm, never an empty list); a self-referential descent; and any
// duplicated consumer, evidence subject, or region member (one subject, one disposition -- a
// duplicate is a fork whether or not the copies agree). The verdict is SEALED AND BOUND twice over:
// AdmittedReplacementCutPlan is a sole_constructor record only this module can build -- a
// cross-module construction or cast refuses at compile time (04_infer
// sole_constructor_construction_diags) -- and its one in-module mint, mint_admitted, is
// admit_callers-sealed to admit_replacement_cut_plan alone, so no importer can reach a verdict
// except through the checks. The digest binds the verdict to the exact plan it judged: an edited
// plan stops matching, and admitted_matches_plan is the recompute check.
//
// WHAT PLAN ADMISSION DOES NOT ESTABLISH, stated per DESIGN 4b rung honesty: the authored census is
// not proven equal to the real boundary population -- an omitted consumer cannot be detected at
// this grain, because no independently produced consumer/obligation/evidence/region observation
// exists yet to join against; coverage authorities are named, not proven to cover;
// OutermostBoundary is an authored claim pending a boundary-census receipt; a descended cut's
// parent refusal is a typed reference pending executed refusal receipts; retirement names its
// reason pending a retirement-receipt authority. Those two-way exact identity joins, the attempt
// layer (backedge, parity, refusal preservation, executed deletion), derived cut standing, the
// outcome ledger, and the roadmap projection are the migration-cut authority program -- the named
// next layer, deliberately not pre-built as string-shaped promises. NO ROADMAP NODE IS STRUCTURALLY
// REGISTERED TO A CUT YET: RoadmapNode carries no cut field, and the typed projection in which a
// lane's contract, shadow, parity and cutover-plus-deletion nodes derive from ONE admitted plan --
// cutover and deletion one accepted state, a deeper cut addable only under an exact parent refusal,
// unregistered migration work red -- is a future obligation of that program, not a present fact.

data replacement_cut_unjoined_parent_rung_note: String = "RUNG HONESTY (DESIGN 4b), declared rather than left to be rediscovered: DescendedFromRefusedCut.parent_cut IS AN UNJOINED REFERENCE. ReplacementCutId is a brand over NonEmptyStr, so every string inhabits it, and the only check applied to why_not_higher anywhere in this module is SelfReferentialDescent -- parent equals this cut's own identity. A plan naming a parent cut that exists nowhere in any tree is ADMITTED, sealed and digest-bound like any other. MEASURED, not read: probe_admits_nonexistent_parent returned true against a parent id of cut-that-exists-nowhere-in-any-tree-zzz, with probe_control_refuses_undecided returning false in the same run as the positive control proving admission is not vacuous (gentle-dove-833, 2026-08-16, base 7f5fa6a94ec1). Those three probes are enrolled in replacement_cut_witness_test as permanent regression controls.\n\nRUNG: WAS mitigatable, NOW mechanically preventable AT THE REGISTERED-PLAN LAYER, and the two halves of that sentence are both load-bearing. THE TRIGGER FIRED: this note's stated next-rung trigger was a cut registry carrying real authored rows, at which point parent_cut becomes an identity join. That registry is admit_cut_registry in this module, and its rows are gunbc.replacement_cut_registry -- so a DescendedFromRefusedCut naming a parent that no registered cut declares now refuses with RegistryParentAbsent naming both ends.\n\nTHE CEILING ARGUMENT THIS NOTE USED TO CARRY WAS ALSO WRONG ON ITS FACTS BEFORE IT WAS OVERTAKEN, and that is recorded rather than quietly dropped. It read that THIS CARRIER HAS ZERO PRODUCTION ROWS and that every ReplacementCut in the tree is a synthetic fixture in its own witness. gunbc.interpreter_replacement_cut has constructed a production row since it landed, and this same note calls it 'this carrier's first real subject' four sentences earlier -- so the file contradicted itself, and the half a reader would act on was the false half. It is the stale-citation class sitting inside the note that declares a gap, which is exactly where it is most expensive.\n\nWHAT IS STILL NOT ESTABLISHED, so the rung is not inflated past what executes. First, EXISTENCE IS NOT REFUSAL: the registry proves a named parent is authored, never that the parent's boundary actually refused, and the second is the later attempt/receipt layer's fact. Second, REGISTRY COMPLETENESS IS UNPROVEN: a cut authored and never registered is invisible to this join, the same shape as an omitted consumer being invisible to plan admission -- nothing walks the corpus for unregistered ReplacementCut values. Third, this says nothing about the AUTHORED-VERSUS-OBSERVED population question, which is Slice 0B and a different mechanism entirely. NEXT-RUNG TRIGGER for the completeness half: a producer that enumerates authored ReplacementCut declarations from the corpus and refuses one absent from the registry.\n\nWHY THE GAP SURVIVED A 423-LINE EXECUTING WITNESS SUITE: every input those witnesses exercise was invented by the same author as the type, so the state a real subject lands in was never reachable from them. A synthetic witness tests the refusals its author thought of; a first production row tests the ones nobody did. This carrier's first real subject -- the interpreter cut, descended from an engine cut nobody has authored -- hit the hole on the first field it filled."

type ReplacementCutId = NonEmptyStr where brand("ReplacementCutId")

type CoverageClaim
  = Covered { by: NonEmptyStr }
  | CoverageOpen

type ConsumerDisposition
  = RetainSameContract { justification: NonEmptyStr, coverage: CoverageClaim }
  | RetainChangedContract { terminal_contract: NonEmptyStr, justification: NonEmptyStr, coverage: CoverageClaim }
  | ReplacedByY { new_authority: NonEmptyStr }
  | EvidenceOnly { surviving_claim: NonEmptyStr, reenrolled_witness: NonEmptyStr }
  | Retire { reason: NonEmptyStr }
  | Undecided

// THE RELATION KEY IS consumer x consumed_old_authority, NOT the consumer alone. One declaration
// may consume two different declarations of the old authority under different contracts -- the
// endpoint projection and a reservation row, say -- and keying on the consumer would let one
// disposition stand in for two dependencies. Both sides are DeclarationRef because the exact join
// in 0B compares identities; a rendered name is a second naming scheme for what the containment
// tree already names, and it cannot be resolved against an index.
type BoundaryConsumerKey {
  consumer: DeclarationRef
  consumed_old_authority: DeclarationRef
}

type BoundaryConsumer {
  consumer: DeclarationRef
  consumed_old_authority: DeclarationRef
  disposition: ConsumerDisposition
}

fn boundary_consumer_key(c: BoundaryConsumer) -> BoundaryConsumerKey {
  BoundaryConsumerKey { consumer: c.consumer, consumed_old_authority: c.consumed_old_authority }
}

type BoundaryCensus
  = ConsumersEnumerated { consumers: List<BoundaryConsumer> }
  | BoundaryDeclaredEmpty { basis: NonEmptyStr }

type HigherBoundaryAnswer
  = OutermostBoundary
  | DescendedFromRefusedCut { parent_cut: ReplacementCutId, refusal_summary: NonEmptyStr }
  | DescentParentUnauthored { intended_parent_boundary: NonEmptyStr, basis: NonEmptyStr }

type EvidenceDisposition
  = ReenrollAgainstY { evidence: NonEmptyStr, surviving_claim: NonEmptyStr }
  | ReplaceEvidence { old_evidence: NonEmptyStr, new_evidence: NonEmptyStr }
  | RetireEvidence { evidence: NonEmptyStr, retired_subject: NonEmptyStr, retirement_reason: NonEmptyStr }
  | EvidenceUndecided { evidence: NonEmptyStr }

type ExternalXRole
  = BootstrapProducer
  | ExternalDifferentialOracle
  | MechanicalCorpusRewriter
  | HistoricalMeasurementSource

type ExternalXAnswer
  = ExternalXRoles { roles: List<ExternalXRole> }
  | NoExternalOracleRequired { justification: NonEmptyStr }

type ReplacementCut {
  identity: ReplacementCutId
  old_root_consumer: NonEmptyStr
  subject: NonEmptyStr
  contract: NonEmptyStr
  new_root: NonEmptyStr
  why_not_higher: HigherBoundaryAnswer
  covered_region: List<DeclarationRef>
  boundary_census: BoundaryCensus
  external_x: ExternalXAnswer
  evidence_dispositions: List<EvidenceDisposition>
}

type CutRefusalCause
  = UndispositionedConsumer { key: BoundaryConsumerKey }
  | UncoveredSurvivingConsumer { key: BoundaryConsumerKey }
  | UndispositionedEvidence { evidence: NonEmptyStr }
  | CoveredByOldRoot { key: BoundaryConsumerKey }
  | ReplacementNamesOldRoot { key: BoundaryConsumerKey }
  | ConsumerDuplicated { key: BoundaryConsumerKey }
  | EvidenceDuplicated { evidence: NonEmptyStr }
  | RegionMemberDuplicated { member: DeclarationRef }
  | EnumeratedCensusEmpty
  | ExternalRolesEnumeratedEmpty
  | EmptyCoveredRegion
  | NewRootEqualsOldRoot
  | SelfReferentialDescent

type AdmittedReplacementCutPlan sole_constructor {
  cut_identity: ReplacementCutId
  criteria_digest: Fnv1a64Structural
  retained_count: Int
  replaced_count: Int
  evidence_only_count: Int
  retired_count: Int
  covered_region_count: Int
}

type PlanAdmission
  = PlanAdmitted { admitted: AdmittedReplacementCutPlan }
  | PlanRefused { causes: List<CutRefusalCause> }

type CountStanding = CountZero | CountPositive

fn count_standing(count: Int) -> CountStanding {
  if count == 0 { CountZero } else { CountPositive }
}

fn nes_eq(a: NonEmptyStr, b: NonEmptyStr) -> Bool {
  (a as String) == (b as String)
}

fn nes_seen(xs: List<NonEmptyStr>, x: NonEmptyStr) -> Bool {
  fold(xs, init: false, f: fn(acc, item) { acc || nes_eq(a: item, b: x) })
}

fn coverage_causes(
  acc: List<CutRefusalCause>,
  key: BoundaryConsumerKey,
  old_root_consumer: NonEmptyStr,
  cov: CoverageClaim,
) -> List<CutRefusalCause> {
  match cov {
    CoverageOpen => Cons { head: UncoveredSurvivingConsumer { key: key }, tail: acc }
    Covered { by: authority } =>
      match nes_eq(a: authority, b: old_root_consumer) {
        true => Cons { head: CoveredByOldRoot { key: key }, tail: acc }
        false => acc
      }
  }
}

fn consumer_causes(
  acc: List<CutRefusalCause>,
  old_root_consumer: NonEmptyStr,
  c: BoundaryConsumer,
) -> List<CutRefusalCause> {
  match c.disposition {
    Undecided => Cons { head: UndispositionedConsumer { key: boundary_consumer_key(c: c) }, tail: acc }
    RetainSameContract { justification: _, coverage: cov } =>
      coverage_causes(acc: acc, key: boundary_consumer_key(c: c), old_root_consumer: old_root_consumer, cov: cov)
    RetainChangedContract { terminal_contract: _, justification: _, coverage: cov } =>
      coverage_causes(acc: acc, key: boundary_consumer_key(c: c), old_root_consumer: old_root_consumer, cov: cov)
    ReplacedByY { new_authority: authority } =>
      match nes_eq(a: authority, b: old_root_consumer) {
        true => Cons { head: ReplacementNamesOldRoot { key: boundary_consumer_key(c: c) }, tail: acc }
        false => acc
      }
    EvidenceOnly { surviving_claim: _, reenrolled_witness: _ } => acc
    Retire { reason: _ } => acc
  }
}

fn evidence_causes(acc: List<CutRefusalCause>, e: EvidenceDisposition) -> List<CutRefusalCause> {
  match e {
    EvidenceUndecided { evidence: w } => Cons { head: UndispositionedEvidence { evidence: w }, tail: acc }
    ReenrollAgainstY { evidence: _, surviving_claim: _ } => acc
    ReplaceEvidence { old_evidence: _, new_evidence: _ } => acc
    RetireEvidence { evidence: _, retired_subject: _, retirement_reason: _ } => acc
  }
}

fn evidence_key(e: EvidenceDisposition) -> NonEmptyStr {
  match e {
    ReenrollAgainstY { evidence: w, surviving_claim: _ } => w
    ReplaceEvidence { old_evidence: w, new_evidence: _ } => w
    RetireEvidence { evidence: w, retired_subject: _, retirement_reason: _ } => w
    EvidenceUndecided { evidence: w } => w
  }
}

fn boundary_consumer_key_eq(a: BoundaryConsumer, b: BoundaryConsumer) -> Bool {
  declaration_ref_eq(a: a.consumer, b: b.consumer)
    && declaration_ref_eq(a: a.consumed_old_authority, b: b.consumed_old_authority)
}

fn boundary_consumer_key_seen(xs: List<BoundaryConsumer>, x: BoundaryConsumer) -> Bool {
  fold(xs, init: false, f: fn(acc, item) { acc || boundary_consumer_key_eq(a: item, b: x) })
}

fn decl_ref_seen(xs: List<DeclarationRef>, x: DeclarationRef) -> Bool {
  fold(xs, init: false, f: fn(acc, item) { acc || declaration_ref_eq(a: item, b: x) })
}

type ConsumerDupState { seen: List<BoundaryConsumer>, causes: List<CutRefusalCause> }
type EvidenceDupState { seen: List<NonEmptyStr>, causes: List<CutRefusalCause> }
type RegionDupState { seen: List<DeclarationRef>, causes: List<CutRefusalCause> }

fn consumer_duplicate_causes(
  acc: List<CutRefusalCause>,
  consumers: List<BoundaryConsumer>,
) -> List<CutRefusalCause> {
  let end_state = fold(
    consumers,
    init: ConsumerDupState { seen: [], causes: acc },
    f: fn(state, c) {
      match boundary_consumer_key_seen(xs: state.seen, x: c) {
        true => ConsumerDupState {
          seen: state.seen,
          causes: Cons { head: ConsumerDuplicated { key: boundary_consumer_key(c: c) }, tail: state.causes },
        }
        false => ConsumerDupState {
          seen: Cons { head: c, tail: state.seen },
          causes: state.causes,
        }
      }
    },
  )
  end_state.causes
}

fn evidence_dup_step(state: EvidenceDupState, key: NonEmptyStr) -> EvidenceDupState {
  match nes_seen(xs: state.seen, x: key) {
    true => EvidenceDupState {
      seen: state.seen,
      causes: Cons { head: EvidenceDuplicated { evidence: key }, tail: state.causes },
    }
    false => EvidenceDupState {
      seen: Cons { head: key, tail: state.seen },
      causes: state.causes,
    }
  }
}

fn evidence_duplicate_causes(
  acc: List<CutRefusalCause>,
  rows: List<EvidenceDisposition>,
) -> List<CutRefusalCause> {
  let end_state = fold(
    rows,
    init: EvidenceDupState { seen: [], causes: acc },
    f: fn(state, e) { evidence_dup_step(state: state, key: evidence_key(e: e)) },
  )
  end_state.causes
}

fn region_causes(acc: List<CutRefusalCause>, region: List<DeclarationRef>) -> List<CutRefusalCause> {
  let dup_state = fold(
    region,
    init: RegionDupState { seen: [], causes: acc },
    f: fn(state, member) {
      match decl_ref_seen(xs: state.seen, x: member) {
        true => RegionDupState {
          seen: state.seen,
          causes: Cons { head: RegionMemberDuplicated { member: member }, tail: state.causes },
        }
        false => RegionDupState {
          seen: Cons { head: member, tail: state.seen },
          causes: state.causes,
        }
      }
    },
  )
  match count_standing(count: list_length(items: region)) {
    CountZero => Cons { head: EmptyCoveredRegion, tail: dup_state.causes }
    CountPositive => dup_state.causes
  }
}

fn enumerated_consumer_causes(
  acc: List<CutRefusalCause>,
  old_root_consumer: NonEmptyStr,
  rows: List<BoundaryConsumer>,
) -> List<CutRefusalCause> {
  let disposition_acc = fold(
    rows,
    init: acc,
    f: fn(inner, c) { consumer_causes(acc: inner, old_root_consumer: old_root_consumer, c: c) },
  )
  consumer_duplicate_causes(acc: disposition_acc, consumers: rows)
}

fn census_causes(
  acc: List<CutRefusalCause>,
  old_root_consumer: NonEmptyStr,
  census: BoundaryCensus,
) -> List<CutRefusalCause> {
  match census {
    BoundaryDeclaredEmpty { basis: _ } => acc
    ConsumersEnumerated { consumers: rows } =>
      match count_standing(count: list_length(items: rows)) {
        CountZero => Cons { head: EnumeratedCensusEmpty, tail: acc }
        CountPositive => enumerated_consumer_causes(acc: acc, old_root_consumer: old_root_consumer, rows: rows)
      }
  }
}

fn external_x_causes(acc: List<CutRefusalCause>, x: ExternalXAnswer) -> List<CutRefusalCause> {
  match x {
    NoExternalOracleRequired { justification: _ } => acc
    ExternalXRoles { roles: rs } =>
      match count_standing(count: list_length(items: rs)) {
        CountZero => Cons { head: ExternalRolesEnumeratedEmpty, tail: acc }
        CountPositive => acc
      }
  }
}

fn root_identity_causes(acc: List<CutRefusalCause>, cut: ReplacementCut) -> List<CutRefusalCause> {
  let after_root = match nes_eq(a: cut.new_root, b: cut.old_root_consumer) {
    true => Cons { head: NewRootEqualsOldRoot, tail: acc }
    false => acc
  }
  match cut.why_not_higher {
    OutermostBoundary => after_root
    DescendedFromRefusedCut { parent_cut: parent, refusal_summary: _ } =>
      match nes_eq(a: parent as NonEmptyStr, b: cut.identity as NonEmptyStr) {
        true => Cons { head: SelfReferentialDescent, tail: after_root }
        false => after_root
      }
    DescentParentUnauthored { intended_parent_boundary: boundary, basis: _ } =>
      match nes_eq(a: boundary, b: cut.old_root_consumer) {
        true => Cons { head: SelfReferentialDescent, tail: after_root }
        false => after_root
      }
  }
}

type DispositionCounts {
  retained: Int
  replaced: Int
  evidence_only: Int
  retired: Int
  undecided: Int
}

fn census_consumers(census: BoundaryCensus) -> List<BoundaryConsumer> {
  match census {
    ConsumersEnumerated { consumers: rows } => rows
    BoundaryDeclaredEmpty { basis: _ } => []
  }
}

fn count_dispositions(consumers: List<BoundaryConsumer>) -> DispositionCounts {
  fold(
    consumers,
    init: DispositionCounts { retained: 0, replaced: 0, evidence_only: 0, retired: 0, undecided: 0 },
    f: fn(acc, c) {
      match c.disposition {
        RetainSameContract { justification: _, coverage: _ } =>
          DispositionCounts { retained: acc.retained + 1, replaced: acc.replaced, evidence_only: acc.evidence_only, retired: acc.retired, undecided: acc.undecided }
        RetainChangedContract { terminal_contract: _, justification: _, coverage: _ } =>
          DispositionCounts { retained: acc.retained + 1, replaced: acc.replaced, evidence_only: acc.evidence_only, retired: acc.retired, undecided: acc.undecided }
        ReplacedByY { new_authority: _ } =>
          DispositionCounts { retained: acc.retained, replaced: acc.replaced + 1, evidence_only: acc.evidence_only, retired: acc.retired, undecided: acc.undecided }
        EvidenceOnly { surviving_claim: _, reenrolled_witness: _ } =>
          DispositionCounts { retained: acc.retained, replaced: acc.replaced, evidence_only: acc.evidence_only + 1, retired: acc.retired, undecided: acc.undecided }
        Retire { reason: _ } =>
          DispositionCounts { retained: acc.retained, replaced: acc.replaced, evidence_only: acc.evidence_only, retired: acc.retired + 1, undecided: acc.undecided }
        Undecided =>
          DispositionCounts { retained: acc.retained, replaced: acc.replaced, evidence_only: acc.evidence_only, retired: acc.retired, undecided: acc.undecided + 1 }
      }
    },
  )
}

fn nes_digest(value: NonEmptyStr) -> Fnv1a64Structural {
  content_hash_atom(value: value)
}

fn tag_digest(tag: NonEmptyStr) -> Fnv1a64Structural {
  content_hash_atom(value: tag)
}

fn boundary_consumer_key_digest(key: BoundaryConsumerKey) -> Fnv1a64Structural {
  content_hash_combine_structural(
    left: decl_ref_digest(ref: key.consumer),
    right: decl_ref_digest(ref: key.consumed_old_authority),
  )
}

fn decl_ref_digest(ref: DeclarationRef) -> Fnv1a64Structural {
  content_hash_atom(value: declaration_ref_display_key(ref: ref) as NonEmptyStr)
}

fn decl_ref_list_digest(tag: NonEmptyStr, items: List<DeclarationRef>) -> Fnv1a64Structural {
  fold(
    items,
    init: tag_digest(tag: tag),
    f: fn(acc, item) { content_hash_combine_structural(left: acc, right: decl_ref_digest(ref: item)) },
  )
}

fn coverage_digest(cov: CoverageClaim) -> Fnv1a64Structural {
  match cov {
    Covered { by: authority } => content_hash_tagged_structural(tag: "covered" as NonEmptyStr, payload: nes_digest(value: authority))
    CoverageOpen => tag_digest(tag: "coverage-open" as NonEmptyStr)
  }
}

fn disposition_digest(d: ConsumerDisposition) -> Fnv1a64Structural {
  match d {
    RetainSameContract { justification: j, coverage: cov } =>
      content_hash_tagged_structural(
        tag: "retain-same" as NonEmptyStr,
        payload: content_hash_combine_structural(left: nes_digest(value: j), right: coverage_digest(cov: cov)),
      )
    RetainChangedContract { terminal_contract: t, justification: j, coverage: cov } =>
      content_hash_tagged_structural(
        tag: "retain-changed" as NonEmptyStr,
        payload: content_hash_combine_structural(
          left: content_hash_combine_structural(left: nes_digest(value: t), right: nes_digest(value: j)),
          right: coverage_digest(cov: cov),
        ),
      )
    ReplacedByY { new_authority: a } =>
      content_hash_tagged_structural(tag: "replaced-by-y" as NonEmptyStr, payload: nes_digest(value: a))
    EvidenceOnly { surviving_claim: sc, reenrolled_witness: w } =>
      content_hash_tagged_structural(
        tag: "evidence-only" as NonEmptyStr,
        payload: content_hash_combine_structural(left: nes_digest(value: sc), right: nes_digest(value: w)),
      )
    Retire { reason: r } =>
      content_hash_tagged_structural(tag: "retire" as NonEmptyStr, payload: nes_digest(value: r))
    Undecided => tag_digest(tag: "undecided" as NonEmptyStr)
  }
}

fn census_digest(census: BoundaryCensus) -> Fnv1a64Structural {
  match census {
    BoundaryDeclaredEmpty { basis: b } =>
      content_hash_tagged_structural(tag: "boundary-declared-empty" as NonEmptyStr, payload: nes_digest(value: b))
    ConsumersEnumerated { consumers: rows } =>
      fold(
        rows,
        init: tag_digest(tag: "consumers-enumerated" as NonEmptyStr),
        f: fn(acc, c) {
          content_hash_combine_structural(
            left: acc,
            right: content_hash_combine_structural(
              left: content_hash_combine_structural(
                left: decl_ref_digest(ref: c.consumer),
                right: decl_ref_digest(ref: c.consumed_old_authority),
              ),
              right: disposition_digest(d: c.disposition),
            ),
          )
        },
      )
  }
}

fn evidence_row_digest(e: EvidenceDisposition) -> Fnv1a64Structural {
  match e {
    ReenrollAgainstY { evidence: w, surviving_claim: sc } =>
      content_hash_tagged_structural(
        tag: "reenroll" as NonEmptyStr,
        payload: content_hash_combine_structural(left: nes_digest(value: w), right: nes_digest(value: sc)),
      )
    ReplaceEvidence { old_evidence: o, new_evidence: n } =>
      content_hash_tagged_structural(
        tag: "replace-evidence" as NonEmptyStr,
        payload: content_hash_combine_structural(left: nes_digest(value: o), right: nes_digest(value: n)),
      )
    RetireEvidence { evidence: w, retired_subject: s, retirement_reason: r } =>
      content_hash_tagged_structural(
        tag: "retire-evidence" as NonEmptyStr,
        payload: content_hash_combine_structural(
          left: content_hash_combine_structural(left: nes_digest(value: w), right: nes_digest(value: s)),
          right: nes_digest(value: r),
        ),
      )
    EvidenceUndecided { evidence: w } =>
      content_hash_tagged_structural(tag: "evidence-undecided" as NonEmptyStr, payload: nes_digest(value: w))
  }
}

fn higher_boundary_digest(h: HigherBoundaryAnswer) -> Fnv1a64Structural {
  match h {
    OutermostBoundary => tag_digest(tag: "outermost" as NonEmptyStr)
    DescendedFromRefusedCut { parent_cut: parent, refusal_summary: r } =>
      content_hash_tagged_structural(
        tag: "descended" as NonEmptyStr,
        payload: content_hash_combine_structural(left: nes_digest(value: parent as NonEmptyStr), right: nes_digest(value: r)),
      )
    DescentParentUnauthored { intended_parent_boundary: boundary, basis: b } =>
      content_hash_tagged_structural(
        tag: "descent-parent-unauthored" as NonEmptyStr,
        payload: content_hash_combine_structural(left: nes_digest(value: boundary), right: nes_digest(value: b)),
      )
  }
}

fn external_x_role_digest(r: ExternalXRole) -> Fnv1a64Structural {
  match r {
    BootstrapProducer => tag_digest(tag: "bootstrap-producer" as NonEmptyStr)
    ExternalDifferentialOracle => tag_digest(tag: "external-differential-oracle" as NonEmptyStr)
    MechanicalCorpusRewriter => tag_digest(tag: "mechanical-corpus-rewriter" as NonEmptyStr)
    HistoricalMeasurementSource => tag_digest(tag: "historical-measurement-source" as NonEmptyStr)
  }
}

fn external_x_digest(a: ExternalXAnswer) -> Fnv1a64Structural {
  match a {
    NoExternalOracleRequired { justification: j } =>
      content_hash_tagged_structural(tag: "no-external-oracle" as NonEmptyStr, payload: nes_digest(value: j))
    ExternalXRoles { roles: rs } =>
      fold(
        rs,
        init: tag_digest(tag: "external-x-roles" as NonEmptyStr),
        f: fn(acc, r) { content_hash_combine_structural(left: acc, right: external_x_role_digest(r: r)) },
      )
  }
}

fn replacement_cut_plan_digest(cut: ReplacementCut) -> Fnv1a64Structural {
  let identity_part = content_hash_combine_structural(
    left: nes_digest(value: cut.identity as NonEmptyStr),
    right: nes_digest(value: cut.old_root_consumer),
  )
  let contract_part = content_hash_combine_structural(
    left: nes_digest(value: cut.subject),
    right: content_hash_combine_structural(left: nes_digest(value: cut.contract), right: nes_digest(value: cut.new_root)),
  )
  let structure_part = content_hash_combine_structural(
    left: higher_boundary_digest(h: cut.why_not_higher),
    right: decl_ref_list_digest(tag: "covered-region" as NonEmptyStr, items: cut.covered_region),
  )
  let population_part = content_hash_combine_structural(
    left: census_digest(census: cut.boundary_census),
    right: fold(
      cut.evidence_dispositions,
      init: external_x_digest(a: cut.external_x),
      f: fn(acc, e) { content_hash_combine_structural(left: acc, right: evidence_row_digest(e: e)) },
    ),
  )
  content_hash_combine_structural(
    left: content_hash_combine_structural(left: identity_part, right: contract_part),
    right: content_hash_combine_structural(left: structure_part, right: population_part),
  )
}

fn mint_admitted(cut: ReplacementCut, counts: DispositionCounts) -> PlanAdmission
  admit_callers: [
    decl_ref(module_path: "gunbc.replacement_cut", decl_name: "admit_replacement_cut_plan"),
  ]
  = PlanAdmitted {
    admitted: AdmittedReplacementCutPlan {
      cut_identity: cut.identity,
      criteria_digest: replacement_cut_plan_digest(cut: cut),
      retained_count: counts.retained,
      replaced_count: counts.replaced,
      evidence_only_count: counts.evidence_only,
      retired_count: counts.retired,
      covered_region_count: list_length(items: cut.covered_region),
    },
  }

fn admit_replacement_cut_plan(cut: ReplacementCut) -> PlanAdmission {
  let root_acc = root_identity_causes(acc: [], cut: cut)
  let census_acc = census_causes(acc: root_acc, old_root_consumer: cut.old_root_consumer, census: cut.boundary_census)
  let oracle_acc = external_x_causes(acc: census_acc, x: cut.external_x)
  let evidence_disposition_acc = fold(
    cut.evidence_dispositions,
    init: oracle_acc,
    f: fn(acc, e) { evidence_causes(acc: acc, e: e) },
  )
  let evidence_acc = evidence_duplicate_causes(acc: evidence_disposition_acc, rows: cut.evidence_dispositions)
  let all_causes = region_causes(acc: evidence_acc, region: cut.covered_region)
  match count_standing(count: list_length(items: all_causes)) {
    CountZero => mint_admitted(cut: cut, counts: count_dispositions(consumers: census_consumers(census: cut.boundary_census)))
    CountPositive => PlanRefused { causes: all_causes }
  }
}

fn admitted_matches_plan(admitted: AdmittedReplacementCutPlan, cut: ReplacementCut) -> Bool {
  nes_eq(a: admitted.cut_identity as NonEmptyStr, b: cut.identity as NonEmptyStr)
    && content_hash_eq_structural(left: admitted.criteria_digest, right: replacement_cut_plan_digest(cut: cut))
}

// THE CUT REGISTRY -- fires the next-rung trigger replacement_cut_unjoined_parent_rung_note
// declared. That note's ceiling argument was that an existence check needs a registry of authored
// cuts to join against; this is that registry, and the join is admit_cut_registry below.
//
// WHAT IT CLOSES: DescendedFromRefusedCut.parent_cut was an UNJOINED reference. ReplacementCutId is
// a brand over NonEmptyStr, so every string inhabits it, and the only check applied anywhere was
// SelfReferentialDescent. A plan naming a parent that exists nowhere was admitted, sealed and
// digest-bound like any other -- measured, not read (probe_admits_nonexistent_parent).
//
// WHAT IT DOES NOT CLOSE, stated so the rung is not inflated: this establishes that the named
// parent EXISTS, never that the parent actually REFUSED at its boundary. Existence and executed
// refusal are different facts and the second belongs to the later attempt/receipt layer. Nor does
// it establish that the registry is COMPLETE -- a cut authored and never registered is invisible
// here, exactly as an omitted consumer is invisible to plan admission.
// THE LEGACY SURVEY ARM, and why it is not two grains in one carrier. The re-grounding above made
// the exact relation consumer x consumed-authority at DECLARATION grain. The interpreter cut -- this
// carrier's only prior production row -- declares its own census grain as one row per consuming
// MODULE OR BINARY, sampled ten of 125 files. That value therefore no longer inhabits the exact
// carrier, which is the DESIRED result rather than a migration problem: the old survey was authored
// in an identity universe too coarse to satisfy the new contract, and weakening the grain so it fits
// would launder a sample into an exactness claim.
//
// So the old measurement is preserved HERE, deliberately non-authoritative. A LegacyReplacementSurvey
// keeps its strings because its purpose is now exactly to record what the prior measurement said at
// its actual historical grain. It reaches no exact mechanism: not admit_replacement_cut_plan, not the
// population join, not region observability, not cutover readiness.
//
// WHAT THIS IS NOT: it is not a scaffold with a deletion trigger, and it is not a compatibility arm.
// It is a historical receipt whose subject is a past measurement, and it stays correct forever
// because what it records already happened. The REMEASUREMENT is the obligation, and that is carried
// by the registration arm rather than by this record.
type LegacyConsumerSurveyRow {
  consumer_label: NonEmptyStr
  disposition: ConsumerDisposition
}

// The survey carries the WHOLE prior plan at its historical grain, not a lossy excerpt of it.
// Dropping the contract fields, the external-X grant or the evidence rows on the way in would be the
// delete-a-prose-row-and-lose-its-contents failure: the operator grant recorded in external_x and
// the two evidence dispositions are real content that no other carrier holds.
type LegacyReplacementSurvey {
  old_root_consumer: NonEmptyStr
  subject: NonEmptyStr
  contract: NonEmptyStr
  new_root: NonEmptyStr
  why_not_higher: HigherBoundaryAnswer
  covered_region_labels: List<NonEmptyStr>
  consumer_rows: List<LegacyConsumerSurveyRow>
  external_x: ExternalXAnswer
  evidence_rows: List<EvidenceDisposition>
  measured_revision: NonEmptyStr
  limitation: NonEmptyStr
}

// A registry entry is EITHER an exact cut or an outstanding remeasurement obligation. Keeping both
// under one identity space is what lets the interpreter id stay visible -- so a parent reference to
// it resolves to something and refuses for the RIGHT reason -- without letting a coarse survey
// answer as an exact plan.
// A FIELD ADDED TO LegacyReplacementSurvey IS INCOMPLETE UNTIL EVERY PRODUCTION LEGACY SURVEY GAINS
// AN EXACT PAYLOAD ASSERTION FOR IT. Supplying the field at construction is not evidence that its
// historical value is bound -- the compiler forces the field to EXIST and says nothing about whether
// anything executes over its content, which is the specification-without-execution trap one level
// in. The obligation is review diligence today and is strictly weaker than a wall; its next rung is
// whole-value equality against an expected fixture survey, which a field addition breaks at the
// construction site rather than leaving green. That construction is not built here because there is
// ONE production legacy survey and this type is a non-authoritative container for it; a second
// production survey, or an actual schema extension, is the trigger.
//
// AND `reason` BELOW IS MUTABLE OPERATOR-FACING GUIDANCE, NOT PART OF THE HISTORICAL RECEIPT. The
// registration's semantic state is already carried structurally -- by the constructor, by the
// identity, and by the prior survey embedded whole rather than transcribed -- so the string is
// present-tense instruction about what the owning lane must do next, and it should improve as the
// remeasurement program becomes clearer. Its witness therefore checks nonempty rather than equality,
// which is the OPPOSITE treatment from LegacyReplacementSurvey's `limitation`: that field records
// what was measured and must not drift. If a mechanism ever begins deriving work from this string,
// the trigger is to replace it with typed fields, never to freeze today's sentence.
type CutRegistration
  = RegisteredExactCut { cut: ReplacementCut }
  | RegisteredCutRemeasureRequired {
      identity: ReplacementCutId
      prior_survey: LegacyReplacementSurvey
      reason: NonEmptyStr
    }

// RegistryParentRemeasureRequired is a DIFFERENT refusal from RegistryParentAbsent, and collapsing
// them would lose the distinction that matters: the boundary was noticed, and no exact plan exists
// at it. Descent claims the parent REFUSED, which a coarse survey cannot establish.
type CutRegistryRefusalCause
  = RegistryDuplicateCutId { identity: ReplacementCutId }
  | RegistryParentAbsent { cut: ReplacementCutId, named_parent: ReplacementCutId }
  | RegistryParentRemeasureRequired { cut: ReplacementCutId, named_parent: ReplacementCutId }

type CutRegistryStanding
  = CutRegistryAdmitted { exact_count: Int, remeasure_required_count: Int }
  | CutRegistryRefused { causes: List<CutRegistryRefusalCause> }

fn cut_id_eq(a: ReplacementCutId, b: ReplacementCutId) -> Bool {
  nes_eq(a: a as NonEmptyStr, b: b as NonEmptyStr)
}

fn registration_identity(r: CutRegistration) -> ReplacementCutId {
  match r {
    RegisteredExactCut { cut: c } => c.identity
    RegisteredCutRemeasureRequired { identity: id, prior_survey: _, reason: _ } => id
  }
}

fn registration_is_exact(r: CutRegistration) -> Bool {
  match r {
    RegisteredExactCut { cut: _ } => true
    RegisteredCutRemeasureRequired { identity: _, prior_survey: _, reason: _ } => false
  }
}

// Resolution is THREE-WAY on purpose: absent, present-but-only-as-a-survey, present-and-exact.
// A two-way answer would force the middle case into one of the outer two, and both readings are
// wrong -- absent understates what is known, exact overstates it.
type ParentResolution
  = ParentResolvedExact
  | ParentResolvedRemeasureOnly
  | ParentUnresolved

fn resolve_parent(rs: List<CutRegistration>, target: ReplacementCutId) -> ParentResolution {
  fold(rs, init: ParentUnresolved, f: fn(acc, r) {
    if cut_id_eq(a: registration_identity(r: r), b: target) {
      match registration_is_exact(r: r) {
        true => ParentResolvedExact
        false => match acc {
          ParentResolvedExact => ParentResolvedExact
          ParentResolvedRemeasureOnly => ParentResolvedRemeasureOnly
          ParentUnresolved => ParentResolvedRemeasureOnly
        }
      }
    } else {
      acc
    }
  })
}

fn cut_id_seen(xs: List<ReplacementCutId>, x: ReplacementCutId) -> Bool {
  fold(xs, init: false, f: fn(acc, item) { acc || cut_id_eq(a: item, b: x) })
}

type RegistryDupState { seen: List<ReplacementCutId>, causes: List<CutRegistryRefusalCause> }

// ONE CAUSE PER EXCESS REGISTRATION, not one per roster row. N registrations under one identity
// yield N-1 causes -- the denominator is the minimum number of rows that must be removed to restore
// uniqueness, which is the actionable count. The seen-list idiom is the same one
// consumer_duplicate_causes already uses, and matching it is not tidiness: a fold that re-fires for
// every occurrence emits N causes for one defect, so the moment a count becomes load-bearing -- and
// DESIGN §5 requires degradations to be COUNTABLE -- the number would report the roster's shape
// rather than the population of defects.
fn registry_duplicate_causes(
  acc: List<CutRegistryRefusalCause>,
  rs: List<CutRegistration>,
) -> List<CutRegistryRefusalCause> {
  let end_state = fold(
    rs,
    init: RegistryDupState { seen: [], causes: acc },
    f: fn(state, r) {
      match cut_id_seen(xs: state.seen, x: registration_identity(r: r)) {
        true => RegistryDupState {
          seen: state.seen,
          causes: Cons { head: RegistryDuplicateCutId { identity: registration_identity(r: r) }, tail: state.causes },
        }
        false => RegistryDupState {
          seen: Cons { head: registration_identity(r: r), tail: state.seen },
          causes: state.causes,
        }
      }
    },
  )
  end_state.causes
}

fn registry_parent_causes(
  acc: List<CutRegistryRefusalCause>,
  rs: List<CutRegistration>,
) -> List<CutRegistryRefusalCause> {
  fold(
    rs,
    init: acc,
    f: fn(inner, r) {
      match r {
        RegisteredCutRemeasureRequired { identity: _, prior_survey: _, reason: _ } => inner
        RegisteredExactCut { cut: c } =>
          match c.why_not_higher {
            OutermostBoundary => inner
            DescentParentUnauthored { intended_parent_boundary: _, basis: _ } => inner
            DescendedFromRefusedCut { parent_cut: parent, refusal_summary: _ } =>
              match resolve_parent(rs: rs, target: parent) {
                ParentResolvedExact => inner
                ParentResolvedRemeasureOnly =>
                  Cons { head: RegistryParentRemeasureRequired { cut: c.identity, named_parent: parent }, tail: inner }
                ParentUnresolved =>
                  Cons { head: RegistryParentAbsent { cut: c.identity, named_parent: parent }, tail: inner }
              }
          }
      }
    },
  )
}

fn registry_exact_count(rs: List<CutRegistration>) -> Int {
  fold(rs, init: 0, f: fn(acc, r) { if registration_is_exact(r: r) { acc + 1 } else { acc } })
}

fn admit_cut_registry(rs: List<CutRegistration>) -> CutRegistryStanding {
  let causes = registry_parent_causes(acc: registry_duplicate_causes(acc: [], rs: rs), rs: rs)
  match count_standing(count: list_length(items: causes)) {
    CountZero => CutRegistryAdmitted {
      exact_count: registry_exact_count(rs: rs),
      remeasure_required_count: list_length(items: rs) - registry_exact_count(rs: rs),
    }
    CountPositive => CutRegistryRefused { causes: causes }
  }
}
