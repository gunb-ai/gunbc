module gunbc.spark_credential_workflow

import std.types { String, NonEmptyStr, Secret }
import std.resources { Network }
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.cloud.gcp.secret_ref {
  SecretRef,
  HashPending,
  secret_ref_version_resource,
}
import gunbc.fleet_secrets_config { fleet_secrets_gcp_project }
import gunbc.fleet_ssh_access {
  fleet_automation_ssh_privkey_secret,
  fleet_automation_ssh_key,
}
import gunbc.fleet_known_hosts_anchor {
  FleetSshAttemptIdentity,
  fleet_ssh_attempt_identity,
  FleetSshCredentialBinding,
  fleet_ssh_credential_binding_of_public_material,
}
import gunbc.auth.access_token_source {
  AccessTokenSource,
  GcloudPrintToken,
  access_token_upsert_required_reason,
}
import gunbc.auth.secret_ref_credential {
  SecretCredentialFetch,
  SecretCredentialReady,
  SecretCredentialAccessUpsertRequired,
  SecretCredentialFetchRefused,
  SecretCredentialWireDecodeRefused,
  fetch_secret_ref_credential,
}
import extdeps.cloud.gcp.secret_manager {
  SmResolvedVersionIdentityRefusal,
  SmResolvedVersionIdentityEmpty,
  SmResolvedVersionIdentityMalformed,
  SmAccessVersionPayloadRefusal,
  SmAccessVersionPayloadEmpty,
  SmAccessVersionPayloadInvalidBase64,
}

data spark_credential_workflow_note: String = "SECRETREF-WIRE-0: credentials resolve inside the workflow from typed SecretRef rows and gunbc.auth.secret_ref_credential.fetch_secret_ref_credential (wire decoding imported from extdeps.cloud.gcp.secret_manager). Wet entry points name attempt identity and host only — never plaintext administrator passwords or fleet key paths on argv. The spark-administrator-password SecretRef (versions/1) is ON the serving-install critical path: gunbc-automation's sole NOPASSWD grant is EnableLingerForOwnAccount (UserUnitRealization), while SystemUnitRealization still needs WriteSystemUnitFile, ReloadSystemManager, EnableSystemUnit, and InstallRuntimePackage — widening sudoers is itself a privileged effect that requires the administrator credential this lane resolves."

data spark_credential_access_token_frontier_note: String = "AUTH FRONTIER (2026-08-13): the only wired access-token source on this path is GcloudPrintToken. Operator-token routes are refuted upstream (ACCESS_TOKEN_TYPE_UNSUPPORTED). gunbc.github_actions_wif federation rows live on an unmerged branch and are deliberately not copied here. Wet resolution therefore refuses when gcloud cannot mint a token rather than hand-rolling a token fetch or reading an env var — that would be the workaround class. A fail-open credential path blocks serving install; a declared frontier refusal is the honest outcome until WIF lands on host_effect_apply. CI WIF materialization remains the separate gunbc_ci_fleet_key_agent_script scaffold until host_effect_apply lands the typed SecretRef→agent effect."

data spark_administrator_password_secret_ref: SecretRef = SecretRef {
  project: fleet_secrets_gcp_project,
  secret: "spark-administrator-password" as NonEmptyStr,
  version: "1",
  hash_state: HashPending,
}

fn fleet_ssh_privkey_materialization_path(attempt: FleetSshAttemptIdentity) -> NonEmptyStr {
  join([
    "target/fleet-ssh-attempt-", attempt as String,
    "-fleet-automation-privkey",
  ], "") as NonEmptyStr
}

type FleetSshCredentialMaterialization
  = FleetSshCredentialMaterialized { binding: FleetSshCredentialBinding }
  | FleetSshCredentialMaterializationRefused { reason: NonEmptyStr }

type SparkAdministratorCredentialResolution
  = SparkAdministratorCredentialResolved { credential: Secret }
  | SparkAdministratorCredentialRefused { reason: NonEmptyStr }

fn sm_resolved_version_identity_refusal_label(cause: SmResolvedVersionIdentityRefusal) -> String {
  match cause {
    SmResolvedVersionIdentityEmpty => "resolved version identity empty"
    SmResolvedVersionIdentityMalformed => "resolved version identity malformed"
  }
}

fn sm_access_version_payload_refusal_label(cause: SmAccessVersionPayloadRefusal) -> String {
  match cause {
    SmAccessVersionPayloadEmpty => "access version payload empty"
    SmAccessVersionPayloadInvalidBase64 => "access version payload invalid base64"
  }
}

fn secret_credential_wire_decode_refusal_reason(
  identity_cause: SmResolvedVersionIdentityRefusal?,
  payload_cause: SmAccessVersionPayloadRefusal?,
) -> NonEmptyStr {
  match identity_cause {
    Present { value: identity_refusal } =>
      match payload_cause {
        Present { value: payload_refusal } =>
          concat(
            concat(
              sm_resolved_version_identity_refusal_label(cause: identity_refusal),
              "; ",
            ),
            sm_access_version_payload_refusal_label(cause: payload_refusal),
          ) as NonEmptyStr
        Absent =>
          sm_resolved_version_identity_refusal_label(cause: identity_refusal) as NonEmptyStr
      }
    Absent =>
      match payload_cause {
        Present { value: payload_refusal } =>
          sm_access_version_payload_refusal_label(cause: payload_refusal) as NonEmptyStr
        Absent => "secret manager access version wire decode refused without typed cause" as NonEmptyStr
      }
  }
}

fn secret_credential_fetch_refusal_reason(fetch: SecretCredentialFetch) -> NonEmptyStr {
  match fetch {
    SecretCredentialAccessUpsertRequired { plan: plan } =>
      access_token_upsert_required_reason(plan: plan) as NonEmptyStr
    SecretCredentialFetchRefused { reason: reason } => reason
    SecretCredentialWireDecodeRefused { identity_cause: identity_cause, payload_cause: payload_cause } =>
      secret_credential_wire_decode_refusal_reason(
        identity_cause: identity_cause,
        payload_cause: payload_cause,
      )
    SecretCredentialReady { credential: credential } =>
      "secret credential fetch reported ready while mapping refusal" as NonEmptyStr
  }
}

func resolve_spark_administrator_credential(
  token_source: AccessTokenSource,
) -> SparkAdministratorCredentialResolution
  uses net: Network
{
  match fetch_secret_ref_credential(
    secret_ref: spark_administrator_password_secret_ref,
    token_source: token_source,
  ) {
    SecretCredentialReady { credential: credential } =>
      SparkAdministratorCredentialResolved { credential: credential }
    SecretCredentialAccessUpsertRequired { plan: plan } =>
      SparkAdministratorCredentialRefused {
        reason: access_token_upsert_required_reason(plan: plan) as NonEmptyStr,
      }
    SecretCredentialFetchRefused { reason: reason } =>
      SparkAdministratorCredentialRefused { reason: reason }
    SecretCredentialWireDecodeRefused { identity_cause: identity_cause, payload_cause: payload_cause } =>
      SparkAdministratorCredentialRefused {
        reason: secret_credential_wire_decode_refusal_reason(
          identity_cause: identity_cause,
          payload_cause: payload_cause,
        ),
      }
  }
}

func materialize_fleet_ssh_credential_binding(
  attempt_raw: String,
  token_source: AccessTokenSource,
) -> FleetSshCredentialMaterialization
  uses net: Network
{
  match fleet_ssh_attempt_identity(raw: attempt_raw) {
    Absent =>
      FleetSshCredentialMaterializationRefused {
        reason: "attempt identity is not a safe path segment" as NonEmptyStr,
      }
    Present { value: attempt } => {
      let path = fleet_ssh_privkey_materialization_path(attempt: attempt)
      match fetch_secret_ref_credential(
        secret_ref: fleet_automation_ssh_privkey_secret,
        token_source: token_source,
      ) {
        SecretCredentialReady { credential: privkey } => {
          let write = Filesystem.Write(path: path as String, content: privkey as String)
          if write.success {
            FleetSshCredentialMaterialized {
              binding: fleet_ssh_credential_binding_of_public_material(
                identity_file: path,
                public_material: fleet_automation_ssh_key.material as NonEmptyStr,
              ),
            }
          } else {
            FleetSshCredentialMaterializationRefused {
              reason: concat(
                concat("fleet automation privkey write refused: ", write.error),
                "",
              ) as NonEmptyStr,
            }
          }
        }
        SecretCredentialAccessUpsertRequired { plan: plan } =>
          FleetSshCredentialMaterializationRefused {
            reason: access_token_upsert_required_reason(plan: plan) as NonEmptyStr,
          }
        SecretCredentialFetchRefused { reason: reason } =>
          FleetSshCredentialMaterializationRefused { reason: reason }
        SecretCredentialWireDecodeRefused { identity_cause: identity_cause, payload_cause: payload_cause } =>
          FleetSshCredentialMaterializationRefused {
            reason: secret_credential_wire_decode_refusal_reason(
              identity_cause: identity_cause,
              payload_cause: payload_cause,
            ),
          }
      }
    }
  }
}
