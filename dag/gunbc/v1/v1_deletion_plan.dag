module gunbc.v1.v1_deletion_plan

import gunbc.roadmap.roadmap_model { RoadmapNodeId }
import gunbc.rung_drop { RungDrop }
import gunbc.rung_drop.rest_body_undecodable_third_splice_form { rest_body_undecodable_third_splice_form }

// COMPACT V1 EXIT MODEL (operator verdict 2026-07-28, retiring this file's second-mutable-roadmap
// role). This file owns exactly one thing: the identity and meaning of the four v1 finish lines and
// the roadmap node each binds to. It owns nothing else. The dependency graph is
// gunbc.roadmap.roadmap_authority (RoadmapEdge rows); per-node acceptance criteria live on the roadmap
// tickets themselves (TicketFields red_control/handback — restating them here would be a second
// representation); acceptance is a gunbc.roadmap.roadmap_model RoadmapAcceptanceReceipt row in the
// authority, so a finish line is reached exactly when its bound node is accepted, never by an
// assertion in this file. The prior three-gate brick ledger
// (PlanGate/PlanMilestone/BrickState/ConfidenceBasis rows, lane_state execution prose, day
// estimates; cycle-5 remodel 2026-07-20) is retired: probe receipts and execution state live in
// their natural carriers (docs/probes/*, the witness corpus, gunbc.proactive_verification_ledger,
// the self-host frontier), and the full brick history remains in git history at this path. The
// four-line split replaces the single overloaded 'delete v1' terminal: interpreter deletion is a
// link-grain no-consumer claim that does not wait on unrelated hand-Rust or v1 test migration;
// product v1-freedom and repository-wide zero hand-maintained Rust are separate downstream claims
// with their own bars.

type V1FinishLine
  = CompilerFixedPoint
  | InterpreterDeleted
  | ProductsV1Free
  | ZeroHandMaintainedRust

type V1FinishLineSpec {
  line: V1FinishLine
  name: String
  claim: String
  node: RoadmapNodeId
}

fn v1_exit_node_id(s: String) -> RoadmapNodeId { s }

fn v1_finish_line_key(l: V1FinishLine) -> String {
  match l {
    CompilerFixedPoint => "compiler-fixed-point"
    InterpreterDeleted => "interpreter-deleted"
    ProductsV1Free => "products-v1-free"
    ZeroHandMaintainedRust => "zero-hand-maintained-rust"
  }
}

fn v1_exit_finish_lines() -> List<V1FinishLineSpec> {
  [
    V1FinishLineSpec {
      line: CompilerFixedPoint,
      name: "Compiler fixed point",
      claim: "Every part of the new compiler generates its own source, that source builds, and the result behaves the same again — the generator itself first, then everything else it does. Matching the old compiler byte for byte is deliberately not the goal.",
      node: v1_exit_node_id(s: "v1-emitter-fixed-point"),
    },
    V1FinishLineSpec {
      line: InterpreterDeleted,
      name: "Interpreter deleted",
      claim: "Nothing we ship or run reaches the old runner any more, and its code is gone. Unrelated hand-written Rust and the old compiler's tests are not part of this claim.",
      node: v1_exit_node_id(s: "v1-interpreter-delete"),
    },
    V1FinishLineSpec {
      line: ProductsV1Free,
      name: "Products v1-free",
      claim: "Every product builds and runs with the old code absent. Anything that genuinely has to stay is listed with a reason.",
      node: v1_exit_node_id(s: "v1-products-v1-free"),
    },
    V1FinishLineSpec {
      line: ZeroHandMaintainedRust,
      name: "Zero hand-maintained Rust",
      claim: "Every Rust file we track is generated from a description or deleted. Hand-maintaining Rust is a stage we pass through, not where we stop.",
      node: v1_exit_node_id(s: "v1-zero-hand-maintained-rust"),
    },
  ]
}

fn v1_finish_line_accepted(spec: V1FinishLineSpec, accepted: List<RoadmapNodeId>) -> Bool {
  accepted |> any(id => id == spec.node)
}

fn v1_finish_lines_accepted_count(accepted: List<RoadmapNodeId>) -> Int {
  count(v1_exit_finish_lines() |> filter(s => v1_finish_line_accepted(spec: s, accepted: accepted)))
}

// THE V1 TEST MIGRATION DISPOSITION: for each hand-written v1 Rust test module that is leaving
// src/v1/tests/src/ (still present until the seed-Rust deletion lands; a row is the witness that will
// replace it), what covers its behaviour, or why nothing does, in a form a reader who did
// not write it can answer from. The enforcing control is the wall claim
// test.claim.manual.test_migration_debt retained_rust_kernel_wall_holds_against_live_tree. The rule
// has two halves, not two models. Discovery subtracts from the debt every Rust module whose stem
// equals the stem of a .dag file carrying a test-marked declaration (test_migration_debt_stem_covered);
// the wall then requires exact equality in BOTH directions between what remains discovered and the
// retained rows, and a deleted module is represented by its file being absent. So a module is
// discharged by exactly one of a retained row or an exact-stem floor witness, never both: both
// together is refused, not merely redundant (the wall was FAIL at 307426545e94 for that reason on
// the follow-up PR 16937). A disposition that names a witness the wall will not accept is the failure
// the dispositions claim exists to catch. This carrier is the readable
// account of which, and of what the replacement does NOT cover. A row names the gap, or it states
// that none was identified; it never reads "replaced" for a weaker control without saying so.
type V1TestMigrationDisposition
  = ReplacedByWitness { coverage_gap: V1CoverageGap }

// What a replacement does not cover, as a status and not as prose. PortedByReadingEmittedTextOnly: the
// witness's needles were ported by reading the Rust assertions, not proved equivalent by a mutation
// control, and it reads emitted Rust text only. WeakerThanRustTest: a guarantee was lowered; the typed
// declaration is the typed gunbc.rung_drop row, held as a resolved import. The witnesses of a row are named
// once, by the #-markers above it, which reference_check resolves; no second copy is kept in a field.
type V1CoverageGap
  = PortedByReadingEmittedTextOnly
  | WeakerThanRustTest { rung_drop: RungDrop }

type V1MigratedTestModule {
  rust_module: String
  disposition: V1TestMigrationDisposition
}

// A DOCUMENT FOR A PERSON. The retention wall (v2.test.claim.manual.test_migration_debt) does not read
// these rows; it judges the Rust side only. The sole machine reader is the optional row-rot claim
// test.claim.v1_test_migration_dispositions, which the node does not require.
fn v1_migrated_test_modules() -> List<V1MigratedTestModule> {
  [
    // #test.claim.sort_by_decorate_once::w_sort_by_decorates_once_sorts_stored_key_and_undecorates_test
    // #test.claim.sort_by_decorate_once::w_sort_by_does_not_apply_the_selector_inside_the_comparator_test
    V1MigratedTestModule {
      rust_module: "sort_by_decorate_once_test",
      disposition: ReplacedByWitness {
        coverage_gap: PortedByReadingEmittedTextOnly,
      },
    },
    // #test.claim.grounded_shared_carrier_wrap::w_grounded_empty_is_shared_once_test
    // #test.claim.grounded_shared_carrier_wrap::w_grounded_empty_is_never_shared_twice_test
    V1MigratedTestModule {
      rust_module: "grounded_shared_carrier_wrap_test",
      disposition: ReplacedByWitness {
        coverage_gap: PortedByReadingEmittedTextOnly,
      },
    },
    // #test.claim.rest_body_undecodable_emitted_cause::w_rest_body_undecodable_causes_are_declared_side_constants_test
    // #test.claim.rest_body_undecodable_emitted_cause::w_rest_body_undecodable_cause_never_splices_the_runtime_error_test
    // #gunbc.rung_drop.rest_body_undecodable_third_splice_form::rest_body_undecodable_third_splice_form
    // The Rust test accepted a cause only as a single quoted declared-side literal; the witness pins two literals present and two leaking spellings absent, so a third splice form passes.
    V1MigratedTestModule {
      rust_module: "rest_body_undecodable_emitted_cause_test",
      disposition: ReplacedByWitness {
        coverage_gap: WeakerThanRustTest { rung_drop: rest_body_undecodable_third_splice_form },
      },
    },
    // #test.claim.unknown_pipeline_driver_refusal::w_unrecognised_driver_reading_refuses_and_names_the_reading_test
    // #test.claim.unknown_pipeline_driver_refusal::w_unrecognised_driver_does_not_render_the_direct_ingest_main_test
    V1MigratedTestModule {
      rust_module: "unknown_pipeline_driver_refusal_test",
      disposition: ReplacedByWitness {
        coverage_gap: PortedByReadingEmittedTextOnly,
      },
    },
  ]
}
