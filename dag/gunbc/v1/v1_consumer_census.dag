      consumer: decl_ref(module_path: "v1.compiler.workspace_members", decl_name: "workspace_members_region_begin_marker"),
      authority: stage0_partition_rows,
      disposition: retired(reason: "the workspace-member region writer is itself under src/v1 and consumes the partition rows to emit the generated member list; it is a consumer INSIDE the deletion set and cannot refuse when both go. Filed as Retire rather than omitted because the floor cut's first measured bound is exactly this class -- a consumer defined and consumed inside the deletion set leaves no diagnostic, so its retirement must be a row, not an absence"),
    ),
    medium: CargoManifestDependency,
