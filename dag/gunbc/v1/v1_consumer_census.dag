      consumer: decl_ref(module_path: "gunbc.fleet_desired_admission_workflow", decl_name: "fleet_desired_admission_decide_step"),
      authority: gunbc_cli_bin,
      disposition: retained_open(justification: "the decide step invokes `gunbc run` over the corpus to evaluate the admission. Same closing capability as the build step's row; a separate relation because the key is consumer x authority and this step depends on the RUN verb, not merely on the binary existing"),
    ),
