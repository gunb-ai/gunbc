// XL-5's FIRST DELIVERABLE: the population that has to be EMPTY before the bankruptcy transaction
// can execute, remeasured at the grain gunbc.replacement_cut requires. XL-5 is primarily a
// deletion, and a deletion's only real question is who is still holding on. This carrier answers
// it at consumer x consumed-authority identity, one disposition per relation, so "is v1
// unreachable yet" is a JOIN rather than a recollection.
//
// WHY THIS CARRIER SPEAKS gunbc.replacement_cut's VOCABULARY AND MINTS NONE OF ITS OWN. The exact
// cut carrier already owns ConsumerDisposition and BoundaryConsumer, and gunbc.interpreter_replacement_cut
// registered its v1 survey as RegisteredCutRemeasureRequired precisely because that survey was
// authored at module-or-binary grain over a ten-of-125 sample -- a universe too coarse to inhabit
// the exact relation. This census IS that remeasurement (XL-N Manager ruling, 2026-08-29: XL-5 is
// the sole producer of the exact census and discharges the registered obligation). An earlier
// revision of this file minted a four-arm V1ConsumerDisposition beside ConsumerDisposition; that
// was a nickname for a concept with an authority, the DESIGN section 3 fork, and it is gone. The
// four names the XL-5 brief uses map onto the authority's arms without loss: replaced-by-native-v2
// is ReplacedByY; retired-with-deleted-subject is Retire; still-required-and-blocking is
// RetainSameContract or RetainChangedContract with CoverageOpen -- which admit_replacement_cut_plan
// already refuses as UncoveredSurvivingConsumer; and replaced-by-stronger-witness is ReplacedByY
// naming the witness, with the STRENGTHENING carried by the witness census's evidence rows.
//
// WHAT THIS IS NOT. It is not the v1 exit model: gunbc.v1_deletion_plan owns the four finish lines
// and says it owns nothing else. This census discharges two of them -- InterpreterDeleted and
// ProductsV1Free -- and names them rather than restating their claims. It is not the maintenance
// standing: gunbc.v1_maintenance_standing governs v1 while it lives; this governs what must be
// true for it to stop living.

// WHAT IS BEING CONSUMED, at the grain a deletion actually operates on. These are not folders:
// src/v1 contains all of them and deleting the folder is the transaction, not the model. The axis
// matters because the dispositions differ per subject in a way a path cannot express -- the v1 CLI
// is REPLACED (v2 has to grow the verb), the generated stage0 mirrors are RETIRED WITH THEIR
// SUBJECT (they are projections of .dag authorities that move), and the v1 .dag source is neither:
// it is the regeneration loop's SUBJECT, so deleting it retires the loop rather than orphaning it.
// V1RuntimeBridge is separate from V1CompilerCrate because the bridge is reached by EMITTED code
// rather than by a caller in the tree, so its consumer population is discovered by a different
// instrument -- and the floor-cut plan's third measured bound says a reach measurement over one
// medium reads exactly like a reach measurement over all of them.

type V1Subject
  = V1CompilerCrate
  | V1Interpreter
  | V1RuntimeBridge
  | V1Cli
  | V1HostedCiBinary
  | V1DagSource
  | V1GeneratedStage0Mirror
  | V1SerializedArtifact

fn v1_subject_key(s: V1Subject) -> String {
  match s {
    V1CompilerCrate => "v1-compiler-crate"
    V1Interpreter => "v1-interpreter"
    V1RuntimeBridge => "v1-runtime-bridge"
    V1Cli => "v1-cli"
    V1HostedCiBinary => "v1-hosted-ci-binary"
    V1DagSource => "v1-dag-source"
    V1GeneratedStage0Mirror => "v1-generated-stage0-mirror"
    V1SerializedArtifact => "v1-serialized-artifact"
  }
}

// HOW THE DEPENDENCY IS SPELLED, and it is a KEY field rather than a note because the discovery
// instrument is per-medium and nothing in a per-medium answer announces the media it omitted. The
// floor-cut replacement plan measured this directly: eight orphan candidates by import graph fell
// to three once roster rows, test discovery, workflow argv and Cargo bin targets were joined, a
// five-in-eight false-positive rate produced entirely by asking one medium. A consumer census that
// swept only Rust `use` edges would have reported this repository's CI as v1-free, because CI
// reaches v1 through an argv string that no Rust instrument reads. Carrying the medium is what
// makes the omission of a medium a visible hole rather than a silent green.

// RustSourceReference, NOT RustUseEdge: the arm was named for `use` edges when its rows were
// authored by hand, and the produced population attributes ANY token-carrying line to its item --
// a `pub use`, a `pub mod v1_rt;`, a `v1_rt::answer()` call in a body -- so the old name said less
// than the rows carried. One name, one meaning: a reference in Rust source to the named authority.
type ConsumerMedium
  = CargoManifestDependency
  | CargoBinTarget
  | WorkflowArgv
  | DagArgvRow
  | RustSourceReference
  | GitHookScript
  | CommittedGeneratedMirror
  | SerializedArtifactPath
  | RustcExternLink

fn consumer_medium_key(m: ConsumerMedium) -> String {
  match m {
    CargoManifestDependency => "cargo-manifest-dependency"
    CargoBinTarget => "cargo-bin-target"
    WorkflowArgv => "workflow-argv"
    DagArgvRow => "dag-argv-row"
    RustSourceReference => "rust-source-reference"
    GitHookScript => "git-hook-script"
    CommittedGeneratedMirror => "committed-generated-mirror"
    SerializedArtifactPath => "serialized-artifact-path"
    RustcExternLink => "rustc-extern-link"
  }
}

// EVERY ROW NAMES THE INSTRUMENT THAT FOUND IT, AND THE COMMAND THAT RE-DERIVES IT. XL-5's standing
// rule is that a number without a producer, a source revision and a command is not a number, and
// DESIGN section 6 states the general form: name the instrument, never transcribe its output.
// Making the producer a REQUIRED FIELD turns that from a review habit into a construction -- a row
// with no producer has no constructor, so an author cannot file a consumer they merely remember.
// The command is carried verbatim so a reader re-derives rather than trusts; the revision is
// carried because a command's answer is a timestamped observation of a moving tree, not an
// identifier.

type DiscoveryProducer {
  instrument: String
  command: String
  source_revision: CommitSha
  source_tree: FloorDiscoveryTreeId
}

// THE REVISION AND THE TREE ARE TYPED, AND THE TREE IS THE ONE THAT DECIDES. A String revision is a
// spelling that any later tree can wear; std.types CommitSha is the Git-head vocabulary every
// consumer already names, and v2.workflow.floor_discovery FloorDiscoveryTreeId is what the floor
// itself keys a discovery on -- a tree, not a commit, because two commits can carry one tree and
// one commit is an observation of exactly one. Carrying both makes a row say which tree it
// observed, so that after an upstream change lands (XL-0, #9676) the census reads as an observation
// of an OLDER tree rather than as a current fact, and the rebind is a visible edit to two typed
// fields rather than a stale string nobody re-reads (XL-N Manager ruling, 2026-08-29).

fn discovery_producer(instrument: String, command: String, source_revision: String, source_tree_hex: String) -> DiscoveryProducer {
  DiscoveryProducer {
    instrument: instrument,
    command: command,
    source_revision: source_revision as CommitSha,
    source_tree: floor_discovery_tree_id(object_id: GitSha1ObjectId { digest: Sha1Digest { hex: source_tree_hex } }),
  }
}

// THE ROW. The relation itself -- consumer x consumed_old_authority x disposition -- is the
// authority's BoundaryConsumer, carried whole rather than re-spelled, so v1_boundary_census() below
// projects straight into the exact carrier's BoundaryCensus. The three fields beside it are this
// census's own facts about how the relation was found.
type V1ConsumerRow {
  boundary: BoundaryConsumer
  medium: ConsumerMedium
  subject: V1Subject
  discovered_by: DiscoveryProducer
}

fn v1cc_nes(s: String) -> NonEmptyStr { s as NonEmptyStr }

fn v1_row_key(r: V1ConsumerRow) -> String {
  concat(concat(concat(concat(r.boundary.consumer.module_path as String, "."), r.boundary.consumer.decl_name as String), " -> "),
    concat(concat(r.boundary.consumed_old_authority.module_path as String, "."), r.boundary.consumed_old_authority.decl_name as String))
}

// WHICH ARMS BLOCK THE TRANSACTION, read off the authority's own vocabulary. A retained consumer
// with CoverageOpen is exactly what admit_replacement_cut_plan refuses as UncoveredSurvivingConsumer,
// and Undecided is what it refuses as UndispositionedConsumer; this predicate is those two causes
// asked of one row, so the blocking column here and the refusal there cannot disagree.
fn consumer_disposition_blocks(d: ConsumerDisposition) -> Bool {
  match d {
    RetainSameContract { justification: _, coverage: c } => v1cc_coverage_is_open(c: c)
    RetainChangedContract { terminal_contract: _, justification: _, coverage: c } => v1cc_coverage_is_open(c: c)
    ReplacedByY { new_authority: _ } => false
    EvidenceOnly { surviving_claim: _, reenrolled_witness: _ } => false
    Retire { reason: _ } => false
    Undecided => true
  }
}

fn v1cc_coverage_is_open(c: CoverageClaim) -> Bool {
  match c {
    Covered { by: _ } => false
    CoverageOpen => true
  }
}

fn consumer_disposition_successors(d: ConsumerDisposition) -> List<String> {
  match d {
    RetainSameContract { justification: _, coverage: c } => coverage_authorities(c: c)
    RetainChangedContract { terminal_contract: _, justification: _, coverage: c } => coverage_authorities(c: c)
    ReplacedByY { new_authority: a } => [a as String]
    EvidenceOnly { surviving_claim: _, reenrolled_witness: w } => [w as String]
    Retire { reason: _ } => []
    Undecided => []
  }
}

fn coverage_authorities(c: CoverageClaim) -> List<String> {
  match c {
    Covered { by: b } => [b as String]
    CoverageOpen => []
  }
}

// A CONSUMER THE EXACT VOCABULARY CANNOT SPELL IS CARRIED AS A REFUSAL, NEVER AS A FABRICATED
// REFERENCE. gunbc.rust_item_host_observation item_declaration_ref projects a Rust item into
// DeclarationRef through rust_source_namespace_rows, and a BoundaryConsumer needs a DeclarationRef
// on both sides. The four self-host shim crates under dag/gunbc/instruments/ are hand-authored Rust
// that reaches v1_rt; until this lane added the tooling namespace row the projection REFUSED them,
// and the two dishonest moves were to invent a module path the projection did not produce, or to
// drop the four because the carrier had no slot for them. So citability is DERIVED, never authored:
// gunbc.rust_item_host_observation observe_rust_references folds the item scan over the hand-Rust
// reference population against a supplied namespace table and carries the projection on each row;
// v1_shim_partition_over then lands a reference as a BoundaryConsumer row when the projection
// answered and in this refusal shape when it did not. Under the live table every shim reference is
// cited and this list is empty by construction; under the live table with the tooling row removed
// every one returns here -- which is the falsifier the paired witness executes over planted
// sources, and the reason the table is a parameter of the producer.

type V1UncitableConsumer {
  item_key: String
  refusal_detail: String
  medium: ConsumerMedium
  subject: V1Subject
  disposition: ConsumerDisposition
  discovered_by: DiscoveryProducer
}

// COMPLETENESS IS A STRUCTURAL FACT, NOT A CLAIM IN A COMMENT. The three arms answer the
// transaction's admission gate OPPOSITELY, and a bare List cannot tell them apart: an empty
// blocking column means 'nothing blocks' under Complete, 'nothing was measured' under Unmeasured,
// and 'nothing blocks among what was measured' under MeasuredLowerBound -- three different facts
// one `[]` would spell identically. gunbc.replacement_cut BoundaryCensus carries
// ConsumersEnumerated | BoundaryDeclaredEmpty and has no lower-bound arm, because an exact cut may
// not be authored over a lower bound at all; this carrier is what stands BETWEEN a measurement and
// that census, and the lower-bound arm is where a partial measurement lives while it is still
// partial. v2.compiler.effect_demand DemandPopulation carries the same three-way shape for XL-1's
// demand rows; the two are one concept at two subjects and are not consolidated here because that
// module is in flight on XL-1's branch and does not exist on main. The dissolution condition below
// names the merge, not the file.

type ConsumerPopulation
  = PopulationMeasuredComplete { rows: List<V1ConsumerRow>, joined_media: List<ConsumerMedium> }
  | PopulationMeasuredLowerBound { rows: List<V1ConsumerRow>, uncitable: List<V1UncitableConsumer>, missing_basis: String }
  | PopulationUnmeasured { reason: String }

fn consumer_population_rows(p: ConsumerPopulation) -> List<V1ConsumerRow> {
  match p {
    PopulationMeasuredComplete { rows: r, joined_media: _ } => r
    PopulationMeasuredLowerBound { rows: r, uncitable: _, missing_basis: _ } => r
    PopulationUnmeasured { reason: _ } => []
  }
}

fn consumer_population_uncitable(p: ConsumerPopulation) -> List<V1UncitableConsumer> {
  match p {
    PopulationMeasuredComplete { rows: _, joined_media: _ } => []
    PopulationMeasuredLowerBound { rows: _, uncitable: u, missing_basis: _ } => u
    PopulationUnmeasured { reason: _ } => []
  }
}

fn consumer_population_is_complete(p: ConsumerPopulation) -> Bool {
  match p {
    PopulationMeasuredComplete { rows: _, joined_media: _ } => true
    PopulationMeasuredLowerBound { rows: _, uncitable: _, missing_basis: _ } => false
    PopulationUnmeasured { reason: _ } => false
  }
}

data v1_consumer_census_population_dissolution: DissolutionCondition = unbound_dissolution(description: "dissolve-on: a single generic completeness carrier is declared once and consumed by BOTH this census and v2.compiler.effect_demand, after XL-1's branch merges to main. Until then the two lanes carry the shape separately, which is a known duplicate held deliberately rather than an unnoticed fork. NOT satisfied by either lane deleting its own copy and importing the other's while the other is unmerged -- that produces a carrier whose provider does not exist on main, which is a worse state than the duplicate. The capability this names is one completeness axis with one declaring module reachable from main, not the deletion of a type.")

// THE PRODUCERS. One declaration per instrument, so a row cites a producer rather than restating a
// command, and re-deriving the whole census is reading the commands below rather than every row.

data v1_census_revision: String = "0bdb8dc3a22cd4cb7736b7e83d4df6c132051259"

data v1_census_tree: String = "168f313cdd9562ff01334c3ac2d154f4c5db6d96"

data producer_workflow_argv: DiscoveryProducer = discovery_producer(
  instrument: "argv and cargo invocations in the emitted workflow surface, traced back to the .dag step declaration that emits each one",
  command: "grep -nE 'target/release/|cargo (build|test).*v1-compiler' .github/workflows/*.yml; then the emitting declaration in gunbc.witness_floor_workflow / gunbc.fleet_desired_admission_workflow / gunbc.fleet_converge_workflow",
  source_revision: v1_census_revision,
  source_tree_hex: v1_census_tree,
)

data producer_cargo_manifest_graph: DiscoveryProducer = discovery_producer(
  instrument: "path dependencies among the v1 crate manifests and the workspace member region",
  command: "git grep -n 'path = \"\\.\\./stage0' -- '*/Cargo.toml'; sed -n 1,20p Cargo.toml",
  source_revision: v1_census_revision,
  source_tree_hex: v1_census_tree,
)

// THE RUST ROWS ARE PRODUCED AT RUN TIME, so this producer's revision is the pin of the hand sweep
// it replaced and its command is the instrument that now re-derives the rows from HEAD: the fold in
// gunbc.rust_item_host_observation observe_current_rust_references over v1_reference_tokens,
// outside v1_deletion_set_prefix, consumed by v1_consumer_population().
data producer_rust_bridge_edge: DiscoveryProducer = discovery_producer(
  instrument: "hand-Rust items outside src/v1 whose text names a v1 reference token, folded by gunbc.rust_item_host_observation observe_current_rust_references and projected through item_declaration_ref_in",
  command: "gunbc run --source-root dag --source-root src/v2 --entry dag/gunbc/v1/v1_consumer_census.dag --function v1_blocking_consumer_count",
  source_revision: v1_census_revision,
  source_tree_hex: v1_census_tree,
)

data producer_generated_mirror: DiscoveryProducer = discovery_producer(
  instrument: "the committed generated Rust under src/v1, defined by its header rather than by basename, and the .gitattributes rows projected from the artifact registry",
  command: "grep -rl 'Generated by' src/v1 --include=*.rs | wc -l; grep -c 'generated-artifact' .gitattributes",
  source_revision: v1_census_revision,
  source_tree_hex: v1_census_tree,
)

data producer_serialized_artifact: DiscoveryProducer = discovery_producer(
  instrument: "the receipt paths the required workflow uploads, read from the declarations that name them",
  command: "grep -oE '[a-z_]+\\.tsv' .github/workflows/witnesses.yml | sort -u; git grep -nE '^data [a-z_]+_path: String = \"[a-z_]+\\.tsv\"' -- dag/gunbc/witness/witness_floor_workflow.dag",
  source_revision: v1_census_revision,
  source_tree_hex: v1_census_tree,
)

data producer_git_hook: DiscoveryProducer = discovery_producer(
  instrument: "v1 binary invocations inside the repository-local git hooks, traced to the emitting declaration",
  command: "git grep -n 'target/release' .githooks/; git grep -ln 'generated-artifact-merge' -- 'dag/**/*.dag'",
  source_revision: v1_census_revision,
  source_tree_hex: v1_census_tree,
)

data producer_bin_roster_row: DiscoveryProducer = discovery_producer(
  instrument: ".dag roster rows that enumerate v1 binary names for a workflow to build",
  command: "git grep -n 'ci_floor_invoked_bins\\|witness_declared_release_bins' -- 'dag/gunbc/**/*.dag'",
  source_revision: v1_census_revision,
  source_tree_hex: v1_census_tree,
)

// IDENTITIES, declared once each. The Rust-item identities follow gunbc.rust_item_host_observation
// rust_source_namespace_rows exactly: src/v1/stage0/src/bin/<stem>.rs projects to
// v1_compiler.bin.<stem>, src/v1/stage0/src/<stem>.rs to v1_compiler.<stem>, src/v1/tests/src/<stem>.rs
// to v1_compiler_tests.<stem>. Nothing here is a spelling the projection would not produce.

data claim_executor_bin: DeclarationRef = decl_ref(module_path: "v1_compiler.bin.claim_executor", decl_name: "main")
data gunbc_cli_bin: DeclarationRef = decl_ref(module_path: "v1_compiler.main", decl_name: "main")
data codex_session_bin: DeclarationRef = decl_ref(module_path: "v1_compiler.bin.codex_app_server_stdio_session", decl_name: "main")
data v1_compiler_crate_root: DeclarationRef = decl_ref(module_path: "v1_compiler.lib", decl_name: "lib")
data stage0_partition_rows: DeclarationRef = decl_ref(module_path: "v2.workflow.rust_crate_partition", decl_name: "stage0_partition_crate_rows")
data invoked_bins_row: DeclarationRef = decl_ref(module_path: "gunbc.ci_release_bins", decl_name: "ci_floor_invoked_bins")
data declared_release_bins_row: DeclarationRef = decl_ref(module_path: "gunbc.ci_release_bins", decl_name: "witness_declared_release_bins")
data witness_census_gate: String = "gunbc.v1_witness_census v1_claim_conservation_holds"

fn retained_open(justification: String) -> ConsumerDisposition {
  RetainSameContract { justification: v1cc_nes(s: justification), coverage: CoverageOpen }
}

fn retired(reason: String) -> ConsumerDisposition {
  Retire { reason: v1cc_nes(s: reason) }
}

fn wfw(decl: String) -> DeclarationRef {
  decl_ref(module_path: "gunbc.witness_floor_workflow", decl_name: decl)
}

fn v1cc_boundary(consumer: DeclarationRef, authority: DeclarationRef, disposition: ConsumerDisposition) -> BoundaryConsumer {
  BoundaryConsumer { consumer: consumer, consumed_old_authority: authority, disposition: disposition }
}

data stage0_core_deletion_search_receipt: String = "SEARCH RECEIPT (2026-08-30): searched the workspace member declarations and every tracked Cargo.toml for a stage0_core member or path dependency; searched workflow, emission and tooling sources for stage0_core; and checked both the authored partition authority v2.workflow.rust_crate_partition and its gunbc.stage0_crate_partition_generated projection. No builder or owner names src/v1/stage0_core. The only hits outside the orphan directory were this retirement receipt and the lifecycle residue contradiction whose own dissolution condition selected crate deletion. Therefore the directory deletes; it is not enrolled or frozen."

fn tsv_row(path_decl: String) -> V1ConsumerRow {
  {
    boundary: v1cc_boundary(
      consumer: wfw(decl: "witness_floor_tsv_upload_step"),
      authority: wfw(decl: path_decl),
      disposition: ReplacedByY { new_authority: v1cc_nes(s: witness_census_gate) },
    ),
    medium: SerializedArtifactPath,
    subject: V1SerializedArtifact,
    discovered_by: producer_serialized_artifact,
  }
}

// THE ROSTER. Every relation was established by running its cited producer against the revision
// above and reading the emitting declaration, and each row's identity is the relation a deletion
// would break, not the file the evidence was read in. Rows are not ordered by severity: the
// floor-cut plan's bounds say the dangerous member is the one nobody thought to look for, and
// ordering by an author's judgement is what lets a reader stop early.
//
// THE RETAINED-OPEN ROWS ARE THE TRANSACTION. Everything else is discharged by deleting a subject
// or by a successor that already exists; the rows carrying CoverageOpen are the entire content of
// 'XL-5 cannot run yet', and each justification names the CAPABILITY that closes it -- never an
// artifact that would contribute to one, which DESIGN section 4b(3) rules is satisfied while the
// capability stays dead. That is the honest shape of a bankruptcy: the estate is mostly worthless,
// and the whole question is the creditors who are still owed.
//
// THE TSV ROWS ARE FOUR RELATIONS, NOT ONE, because the authority's key is consumer x consumed
// authority and one upload step consumes four path declarations. Collapsing them would let one
// disposition stand for four dependencies, which is the exact conflation the key exists to refuse.

data v1_static_consumers: List<V1ConsumerRow> = [
  {
    boundary: v1cc_boundary(
      consumer: wfw(decl: "build_lane_run_step"),
      authority: claim_executor_bin,
      disposition: retained_open(justification: "the build lane of the required merge gate runs inside this binary. Closes on: an admitted native v2 compiler that executes the required gate roster end to end on a cold runner with no preinstalled gunbc and no src/v1 present -- NOT the existence of an emitted crate that cargo-checks, which is XL-0's gate and runs nothing"),
    ),
    medium: WorkflowArgv,
    subject: V1HostedCiBinary,
    discovered_by: producer_workflow_argv,
  },
  {
    boundary: v1cc_boundary(
      consumer: wfw(decl: "witness_floor_run_step"),
      authority: claim_executor_bin,
      disposition: retained_open(justification: "the witness floor roster executes inside this binary, so every witness identity in the repository is reached through v1 today. Closes on: a native v2 witness fold that executes the same witness identities and refuses on subject loss -- the identity join gunbc.v1_witness_census carries, never a count of witnesses run"),
    ),
    medium: WorkflowArgv,
    subject: V1HostedCiBinary,
    discovered_by: producer_workflow_argv,
  },
  {
    boundary: v1cc_boundary(
      consumer: wfw(decl: "rust_unit_tests_step"),
      authority: v1_compiler_crate_root,
      disposition: retired(reason: "the job's entire subject is the v1 crate's own #[test] functions, none of which asserts anything outside v1. #9663 added it because those tests ran on no CI path; it is one merge window old and retires with the code it was built to cover rather than being ported. DELETED 2026-09-04 under the runner-capacity ruling, ahead of the crate it covered: the carrier no longer exists in gunbc.witness_floor_workflow and the loss is declared at gunbc.rung_drop rust_unit_tests_off_the_merge_path. This row is kept rather than dropped because the census is a record of what consumed v1, not of what still does"),
    ),
    medium: WorkflowArgv,
    subject: V1CompilerCrate,
    discovered_by: producer_workflow_argv,
  },
  {
    boundary: v1cc_boundary(
      consumer: decl_ref(module_path: "gunbc.fleet_desired_admission_workflow", decl_name: "fleet_desired_admission_build_step"),
      authority: gunbc_cli_bin,
      disposition: retained_open(justification: "fleet desired-state admission builds the gunbc binary; a product workflow outside the floor cut's boundary by that cut's own exclusion. Closes on: the native v2 binary answering the verbs the fleet workflows actually pass among the five the v1 clap surface declares (Compile, Test, Run, Converge, Serve), with a REFUSAL for any verb it does not answer -- a verb that silently forwards is the falsifier XL-5 lists, not the migration"),
    ),
    medium: WorkflowArgv,
    subject: V1Cli,
    discovered_by: producer_workflow_argv,
  },
  {
    boundary: v1cc_boundary(
      consumer: decl_ref(module_path: "gunbc.fleet_desired_admission_workflow", decl_name: "fleet_desired_admission_decide_step"),
      authority: gunbc_cli_bin,
      disposition: retained_open(justification: "the decide step invokes `gunbc run` over the corpus to evaluate the admission. Same closing capability as the build step's row; a separate relation because the key is consumer x authority and this step depends on the RUN verb, not merely on the binary existing"),
    ),
    medium: WorkflowArgv,
    subject: V1Cli,
    discovered_by: producer_workflow_argv,
  },
  {
    boundary: v1cc_boundary(
      consumer: decl_ref(module_path: "gunbc.fleet_converge_workflow", decl_name: "fleet_converge_build_job"),
      authority: invoked_bins_row,
      disposition: retained_open(justification: "the converge build job packs every bin this roster names; the roster names claim_executor and gunbc. Closes with the two CLI rows above; a separate relation because the consumer reaches the bins through a .dag roster row rather than through a literal, and gunbc.ci_release_bins records that this exact roster stranded fleet-converge for two days after FLOOR-Y when a member was removed without draining the row"),
    ),
    medium: DagArgvRow,
    subject: V1HostedCiBinary,
    discovered_by: producer_bin_roster_row,
  },
  {
    boundary: v1cc_boundary(
      consumer: decl_ref(module_path: "gunbc.fleet_converge_workflow", decl_name: "fleet_converge_build_job"),
      authority: declared_release_bins_row,
      disposition: retained_open(justification: "the same build job packs every witness-declared release bin, all of which are v1-compiler bin targets. Closes on: every member of this roster having its own disposition here -- the roster is a population, and gunbc.ci_release_bins's own lesson is that removing a consumer and removing a member are different edits"),
    ),
    medium: DagArgvRow,
    subject: V1HostedCiBinary,
