      consumer: decl_ref(module_path: "gunbc.generated_artifact_merge_driver", decl_name: "generated_artifact_merge_driver_repair_steps"),
      authority: claim_executor_bin,
      disposition: retired(reason: "the repair recipe names claim_executor --required-regen as the route to regenerate a conflicted src/v1 mirror; with the regeneration SUBJECT deleted the recipe has nothing to regenerate. This retires the RECIPE TEXT for the src/v1 population, not the driver: the driver survives for the surviving generated artifacts, and dropping it would drop the merge protection #7836 twice needed"),
    ),
    medium: GitHookScript,
    subject: V1DagSource,
    discovered_by: producer_git_hook,
  },
  {
    boundary: v1cc_boundary(
      consumer: decl_ref(module_path: "v1.compiler.workspace_members", decl_name: "workspace_members_region_begin_marker"),
      authority: stage0_partition_rows,
      disposition: retired(reason: "the workspace-member region writer is itself under src/v1 and consumes the partition rows to emit the generated member list; it is a consumer INSIDE the deletion set and cannot refuse when both go. Filed as Retire rather than omitted because the floor cut's first measured bound is exactly this class -- a consumer defined and consumed inside the deletion set leaves no diagnostic, so its retirement must be a row, not an absence"),
    ),
    medium: CargoManifestDependency,
    subject: V1GeneratedStage0Mirror,
    discovered_by: producer_cargo_manifest_graph,
  },
  {
    boundary: v1cc_boundary(
      consumer: decl_ref(module_path: "v1_compiler_tests.lib", decl_name: "helpers"),
      authority: v1_compiler_crate_root,
      disposition: retired(reason: "the src/v1/tests crate depends only on v1-compiler, with three features that exist to expose v1 internals to v1's own tests. No manifest outside src/v1 names it"),
    ),
    medium: CargoManifestDependency,
    subject: V1CompilerCrate,
    discovered_by: producer_cargo_manifest_graph,
  },
  {
    boundary: v1cc_boundary(
      consumer: decl_ref(module_path: "gunbc.stage0_rust_source_lifecycle_scaffold", decl_name: "residue_stage0_core_lib_dissolution"),
      authority: stage0_partition_rows,
      disposition: retired(reason: "an ALREADY-DECLARED open authority contradiction, not a discovery of this census: src/v1/stage0_core/src/lib.rs is tracked on disk, absent from the partition rows and absent from the workspace member list, and the residue row's dissolution reads 'stage0_partition_crate_rows enrolls src/v1/stage0_core OR the crate deletes'. XL-5 satisfies the second arm. Recorded so the transaction is known to DISCHARGE that row rather than orphan it"),
    ),
    medium: CargoManifestDependency,
    subject: V1GeneratedStage0Mirror,
    discovered_by: producer_cargo_manifest_graph,
  },
  {
    boundary: v1cc_boundary(
      consumer: decl_ref(module_path: "gunbc.stage0_rust_source_lifecycle_scaffold", decl_name: "stage0_partition_crate_rows_authority_ref"),
      authority: stage0_partition_rows,
      disposition: retired(reason: "the committed generated mirrors under src/v1 and the .gitattributes rows that route their merges are projections of src/v1 .dag authorities; with the authority deleted a mirror has no producer and is not a survivor to re-home. The .gitattributes rows go with their registry entries, the same motion #9663 performed for the js_site rows"),
    ),
    medium: CommittedGeneratedMirror,
    subject: V1GeneratedStage0Mirror,
    discovered_by: producer_generated_mirror,
  },
  tsv_row(path_decl: "required_floor_disposition_path"),
  tsv_row(path_decl: "expected_red_roster_join_path"),
  tsv_row(path_decl: "long_home_storage_agreement_path"),
  tsv_row(path_decl: "required_floor_claim_cost_path"),
]

fn v1_shim_disposition() -> ConsumerDisposition {
  retained_open(justification: "a hand-authored shim standing in for primitive arms the emitted v2 closure does not yet realize; the only Rust outside src/v1 that reaches the v1 runtime bridge. These shims are themselves v1 CONSUMERS slated for a disposition, not infrastructure that survives the cut. Closes on: the emitted v2 closure realizing those arms so the shim has nothing to bridge -- XL-0's arms-to-zero milestone AS EXECUTED, meaning the emitted crate compiles without a v1_rt path rather than merely cargo-checking with one")
}

data v1_rt_bridge_authority: DeclarationRef = decl_ref(module_path: "v1_compiler.v1_rt", decl_name: "v1_rt")

// THE FOUR SHIM ITEMS, at the grain gunbc.rust_item_identity carries: the crate root of each shim
// crate, a RustModule item named for the file. loc is the measured line count at v1_census_revision
// (wc -l) and is metadata; identity is the path and kind.
fn v1_shim_item(path: String, loc: Int) -> RustItemIdentity {
  RustItemIdentity {
    repo_path: path as FilePath,
    kind: RustModule,
    name: "lib" as NonEmptyStr,
    impl_subject: "",
    enclosing_module: "",
    start_line: 1,
    loc: loc,
  }
}

fn v1_shim_items() -> List<RustItemIdentity> {
  [
    v1_shim_item(path: "dag/gunbc/instruments/self_host_03_normalize_shims/lib.rs", loc: 23),
    v1_shim_item(path: "dag/gunbc/instruments/self_host_body_producer_shims/lib.rs", loc: 10),
    v1_shim_item(path: "dag/gunbc/instruments/self_host_parse_engine_hooks_shims/lib.rs", loc: 8),
    v1_shim_item(path: "dag/gunbc/instruments/self_host_use_site_verdict_shims/lib.rs", loc: 10),
  ]
}

type V1ShimPartition {
  cited: List<V1ConsumerRow>
  uncitable: List<V1UncitableConsumer>
}

fn v1_shim_cited_row(ref: DeclarationRef) -> V1ConsumerRow {
  {
    boundary: v1cc_boundary(consumer: ref, authority: v1_rt_bridge_authority, disposition: v1_shim_disposition()),
    medium: RustUseEdge,
    subject: V1RuntimeBridge,
    discovered_by: producer_rust_bridge_edge,
  }
}

fn v1_shim_uncitable_row(item_key: String, detail: String) -> V1UncitableConsumer {
  {
    item_key: item_key,
    refusal_detail: detail,
    medium: RustUseEdge,
    subject: V1RuntimeBridge,
    disposition: v1_shim_disposition(),
    discovered_by: producer_rust_bridge_edge,
  }
}

// CITABILITY IS THE PROJECTION'S ANSWER, ASKED AGAINST A SUPPLIED TABLE. One fold, two accumulators;
// a shim cannot be in both and cannot be in neither.
fn v1_shim_partition(rows: List<RustSourceNamespaceRow>) -> V1ShimPartition {
  fold_list(
    xs: v1_shim_items(),
    empty: V1ShimPartition { cited: [], uncitable: [] },
    cons: fn(acc, item) {
      match item_declaration_ref_in(rows: rows, item: item) {
        ItemDeclarationRefProjected { ref: r } =>
          V1ShimPartition { cited: list_snoc_item(xs: acc.cited, item: v1_shim_cited_row(ref: r)), uncitable: acc.uncitable }
        ItemDeclarationRefUncitable { item_key: k, detail: d } =>
          V1ShimPartition { cited: acc.cited, uncitable: list_snoc_item(xs: acc.uncitable, item: v1_shim_uncitable_row(item_key: k, detail: d)) }
        ItemDeclarationRefRefused { item_key: k, detail: d } =>
          V1ShimPartition { cited: acc.cited, uncitable: list_snoc_item(xs: acc.uncitable, item: v1_shim_uncitable_row(item_key: k, detail: d)) }
      }
    }
  )
}

fn v1_consumers_for(rows: List<RustSourceNamespaceRow>) -> List<V1ConsumerRow> {
  list_append(left: v1_static_consumers, right: v1_shim_partition(rows: rows).cited)
}

fn v1_consumers() -> List<V1ConsumerRow> {
  v1_consumers_for(rows: rust_source_namespace_rows)
}

fn v1_uncitable_consumers() -> List<V1UncitableConsumer> {
  v1_shim_partition(rows: rust_source_namespace_rows).uncitable
}

// THE POPULATION THIS ROSTER CONSTITUTES TODAY, and it is deliberately not the Complete arm. Seven
// producers were run and none of them joins the others. Filing this as Complete would be the rung
// inflation DESIGN section 4b names as worse than sitting low, because the admission gate below
// reads this field and an inflated Complete would let the transaction execute against a population
// that was never closed.
fn v1_consumer_population_for(rows: List<RustSourceNamespaceRow>) -> ConsumerPopulation {
  let partition = v1_shim_partition(rows: rows)
  PopulationMeasuredLowerBound {
    rows: list_append(left: v1_static_consumers, right: partition.cited),
    uncitable: partition.uncitable,
    missing_basis: "seven per-medium sweeps, unjoined. Three named holes, each of which would produce a row this roster does not have: (1) no producer classifies the .dag argv rows -- 88 .dag files name a v1 binary in a string position and only the two ci_release_bins rosters were traced to a consumer; (2) the deletion-set blind spot the floor cut measured has one row here (workspace_members) and no instrument -- a consumer defined inside src/v1 and consumed inside src/v1 cannot refuse when both go, and only a per-deleted-file question finds the rest; (3) reachability is not measured for any row: every disposition above is a PRESENCE claim, and presence over-approximates demand, which is the reachability_read_as_occupancy class this repository rosters and XL-1 tripped on in its own first census. The uncitable column is NOT a fourth hole any more: under the live namespace table it is empty by construction, and the tooling row that made it so was necessary for Complete, not sufficient.",
  }
}

fn v1_consumer_population() -> ConsumerPopulation {
  v1_consumer_population_for(rows: rust_source_namespace_rows)
}

// THE PROJECTION INTO THE EXACT CARRIER. When the population reaches Complete, this is the
// BoundaryCensus the RegisteredExactCut for cut-v1-interpreter is authored over; until then the
// projection exists so the shape is executed now rather than discovered at release, and so the
// consumer identities XL-3 consumes are the authority's BoundaryConsumer rather than a private row.
fn v1_boundary_census(rows: List<V1ConsumerRow>) -> BoundaryCensus {
  ConsumersEnumerated { consumers: rows |> map(r => r.boundary) }
}

// REFUSAL ONE, in the direction a census is most likely to fail: something is reachable and no row
// disposes it. The discovered population is supplied by the CALLER rather than read from a field
// here, because a census that supplies its own denominator is asserting completeness by writing it
// down -- the change-detector shape DESIGN section 5 names, where automating the literal collapses
// the assertion to measure() == measure().
fn v1_row_keys(rows: List<V1ConsumerRow>) -> List<String> {
  rows |> map(r => v1_row_key(r: r))
}

fn v1_key_in(needle: String, xs: List<String>) -> Bool {
  xs |> any(x => x == needle)
}

fn v1_consumers_undisposed(discovered: List<String>, rows: List<V1ConsumerRow>) -> List<String> {
  discovered |> filter(d => !v1_key_in(needle: d, xs: v1_row_keys(rows: rows)))
}

fn v1_every_discovered_consumer_disposed(discovered: List<String>, rows: List<V1ConsumerRow>) -> Bool {
  count(v1_consumers_undisposed(discovered: discovered, rows: rows)) == 0
}

// REFUSAL TWO, the opposite direction: a row names a relation the discovery population does not
// contain. This catches a roster going stale rather than short -- a consumer repaired upstream
// leaves a row behind, and a stale row is indistinguishable from a live one to every reader who is
// not re-running the producer.
fn v1_rows_naming_no_live_consumer(discovered: List<String>, rows: List<V1ConsumerRow>) -> List<V1ConsumerRow> {
  rows |> filter(r => !v1_key_in(needle: v1_row_key(r: r), xs: discovered))
}

fn v1_every_row_names_a_live_consumer(discovered: List<String>, rows: List<V1ConsumerRow>) -> Bool {
  count(v1_rows_naming_no_live_consumer(discovered: discovered, rows: rows)) == 0
}

// REFUSAL THREE, the load-bearing one: A DISPOSITION CANNOT BE MADE TRUE BY EDITING IT. A row may
// CLAIM a successor authority; the claim holds only if that authority appears in a realized
// population supplied from outside this module. Without this arm, ReplacedByY is an author's
// intention typed into a field -- the tell DESIGN section 5 gives for validation standing where
// construction was available.
fn v1_claimed_successors(rows: List<V1ConsumerRow>) -> List<String> {
  rows |> flat_map(r => consumer_disposition_successors(d: r.boundary.disposition))
}

fn v1_unrealized_successors(rows: List<V1ConsumerRow>, realized: List<String>) -> List<String> {
  v1_claimed_successors(rows: rows) |> filter(s => !v1_key_in(needle: s, xs: realized))
}

fn v1_every_claimed_successor_is_realized(rows: List<V1ConsumerRow>, realized: List<String>) -> Bool {
  count(v1_unrealized_successors(rows: rows, realized: realized)) == 0
}

// THE BLOCKING COLUMN, derived rather than authored, over BOTH the citable rows and the uncitable
// ones. This is the number XL-5 reports upward; a filter over the roster rather than a literal, so
// it cannot be edited down without deleting a row -- and deleting a row is what refusal two catches.
fn v1_blocking_consumers(rows: List<V1ConsumerRow>) -> List<V1ConsumerRow> {
  rows |> filter(r => consumer_disposition_blocks(d: r.boundary.disposition))
}

fn v1_blocking_uncitable(uncitable: List<V1UncitableConsumer>) -> List<V1UncitableConsumer> {
  uncitable |> filter(u => consumer_disposition_blocks(d: u.disposition))
}

fn v1_blocking_consumer_count() -> Int {
  count(v1_blocking_consumers(rows: v1_consumers())) + count(v1_blocking_uncitable(uncitable: v1_uncitable_consumers()))
}

fn v1_consumer_member_count() -> Int {
  count(v1_consumers()) + count(v1_uncitable_consumers())
}

// THE ADMISSION GATE FOR THE BANKRUPTCY TRANSACTION. All four conditions, and the first is the one
// a reader will be tempted to drop: a lower-bound population with an empty blocking column says
// nothing blocks AMONG WHAT WAS MEASURED, not the claim the transaction needs. Executing the
// cutover on that is the absorbing-fallback shape read backwards -- ignorance taken as an answer --
// and it is why completeness is a field the gate reads rather than a sentence in a note. The
// fourth condition is that no uncitable consumer remains, since a consumer the vocabulary cannot
// spell is one the exact cut cannot disposition.
fn v1_bankruptcy_transaction_admitted(population: ConsumerPopulation, realized: List<String>) -> Bool {
  let rows = consumer_population_rows(p: population)
  consumer_population_is_complete(p: population)
    && count(v1_blocking_consumers(rows: rows)) == 0
    && count(consumer_population_uncitable(p: population)) == 0
    && v1_every_claimed_successor_is_realized(rows: rows, realized: realized)
}

data v1_consumer_census_rung_note: String = "RUNG, at the honest grain, separated from what the roster claims about v1.\n\nTHE CLASS -- 'the cutover deletes a subject nothing succeeded' -- sits at MITIGATABLE today, and this carrier does not move it. Nothing refuses when a consumer is added to the tree; the roster is a hand sweep and an author who forgets to file a row leaves no trace.\n\nWHAT IS CONSTRUCTED, and it is the only rung claim made here: the relation is the authority's own BoundaryConsumer, so a row cannot name a consumer without naming what it consumes; a row has no constructor without a producer carrying a command and a revision; the blocking predicate is derived from the same two arms admit_replacement_cut_plan refuses on, so the blocking column here and the refusal there cannot disagree; and the successor claim is not self-satisfiable at all -- refusal three joins it against a population this module cannot write.\n\nWHAT IS NOT CONSTRUCTED, stated because the gap is the next lane's work rather than an omission: completeness. PopulationMeasuredLowerBound is the honest arm and the admission gate reads it, so the transaction refuses by construction today -- but nothing stops an author from writing PopulationMeasuredComplete over the same unjoined rows. That edit is the one way this carrier can lie, and it is exactly what the next-rung trigger closes."

data v1_consumer_census_next_rung_trigger: DissolutionCondition = unbound_dissolution(description: "dissolve-on: the discovered consumer population is produced by ONE joined instrument over all eight media -- manifests, bin targets, workflow argv, .dag argv rows, Rust use edges, hook scripts, committed mirrors and serialized artifact paths -- so that adding a consumer in any medium appears in the census without an author remembering to file it, and PopulationMeasuredComplete becomes a fact the instrument establishes rather than a value an author types. NOT satisfied by an instrument covering some media however many rows it finds: a per-medium answer is indistinguishable from a joined one, so a partial join has the same blind spot as no join. NOT satisfied by adding rows by hand.")
