      authority: codex_session_bin,
      disposition: retained_open(justification: "a PRODUCT integration, not a compiler consumer: the codex stdio session transport is a v1-compiler bin target whose subject has nothing to do with compiling .dag. Its disposition is genuinely open rather than assumed retired, and deleting it as CI cruft would be the deletion-inside-the-deletion-set blind spot the floor cut measured. Closes on: either a native successor for this transport or a retirement with the product owner's cause -- not on the compiler cutover"),
    ),
    medium: CargoBinTarget,
    subject: V1HostedCiBinary,
    discovered_by: producer_workflow_argv,
  },
  {
    boundary: v1cc_boundary(
      consumer: decl_ref(module_path: "gunbc.generated_artifact_merge_driver", decl_name: "generated_artifact_merge_driver_repair_steps"),
      authority: claim_executor_bin,
      disposition: retired(reason: "the repair recipe names claim_executor --required-regen as the route to regenerate a conflicted src/v1 mirror; with the regeneration SUBJECT deleted the recipe has nothing to regenerate. This retires the RECIPE TEXT for the src/v1 population, not the driver: the driver survives for the surviving generated artifacts, and dropping it would drop the merge protection #7836 twice needed"),
    ),
    medium: GitHookScript,
