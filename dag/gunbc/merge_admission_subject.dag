module gunbc.merge_admission_subject


data merge_admission_subject_defusion_note: String = "WalkAttemptId, TestedSubject, and their path/wire identity live here because capture and admission classification both consume them. This is a MOVE from gunbc.merge_admission and gunbc.merge_admission_produce, not a second representation: the domain modules import this carrier home. Keeping the checkout capture out of the classifier's commit-roster closure makes its declared Negligible profile measurable at the realization boundary."

// The attempt identity is a PATH SEGMENT, because it is concatenated into one: merge_admission_attempt_dir builds <root>/.gunbc/merge-admission/<attempt_id>/. As a bare string it was neither path-safe nor wire-safe. Both producers — GitHub-derived composition and explicit GUNBC_WALK_ATTEMPT_ID — go through walk_attempt_id, the only constructor, and refuse rather than sanitizing.
type WalkAttemptId = std.types.PathSegment where brand("WalkAttemptId")

fn walk_attempt_id(raw: String) -> WalkAttemptId? {
  if path_segment_is_safe(raw: raw) {
    Present { value: raw as WalkAttemptId }
  } else {
    none
  }
}

fn walk_attempt_id_eq(left: WalkAttemptId, right: WalkAttemptId) -> Bool {
  (left as String) == (right as String)
}

// THE BASE COMMIT IS A SEPARATE FACT FROM THE BASE TREE, AND OMITTING IT WAS A FALSE-ADMIT HOLE.
// A three-way merge is a function of head, base, and the MERGE BASE -- and the merge base is fixed
// by ANCESTRY, which a tree does not carry. So a base TREE alone cannot determine the merge
// result, and an earlier revision of this carrier (and of MergeAdmissionReceiptV2) pinned only the
// tree. The tree field is GONE rather than kept beside the commit: a commit determines its tree, so
// carrying both would be two representations of one fact (DESIGN §3) introduced by the very change
// that closes a §3-shaped hole. Measured before removing it -- the only reader of the tree that was
// not its own comparison was a format oracle decoding the observed tree FOR that comparison, so it
// left with it, taking a ShowTree observation and a decode step out of three call sites.
//
// DEMONSTRATED, not argued (2026-08-21, throwaway repo, real git). Let H branch from base B0; let
// the base then cherry-pick H and revert it, giving B2:
//
//   tree(B0) == tree(B2)        YES   -- the revert restored the content exactly
//   B0 != B2                    YES   -- distinct commits
//   merge-base(H, B0) = B0            merge H into B0 -> H's file PRESENT
//   merge-base(H, B2) = H'            merge H into B2 -> H's file ABSENT
//
// Same head, same base tree, different base commit, DIFFERENT merge result -- with the PR's own
// change silently not landing. Every comparison the classifier made would have passed, so this was
// a false ADMIT: the one direction the wall exists to make impossible.
type TestedSubject {
  attempt_id: WalkAttemptId
  head_sha: std.types.CommitSha
  base_ref: String
  base_commit_sha: std.types.CommitSha
}

data tested_subject_note: String = "THE SUBJECT THE FLOOR TESTED, captured by a typed claim subprocess before the ordinary floor — before any substantive floor work — and bound into the receipt by the stamp. The child address space dies before batch 1, structurally reclaiming its evaluator arena while preserving the exact wire bytes. The stamp must NOT re-read HEAD or re-observe the merge target at stamp time: main can advance during a floor that runs for tens of minutes, and a receipt binding post-floor observations would claim the floor tested a tree it never saw. The gate then fetches the CURRENT target and classifies tested_base_commit_sha against it — two base facts with different jobs, never one observation doing both (the deleted single pre-floor fetch was exactly that fusion, and the freshness hole it left is what the old separate gate step's own fresh fetch existed to catch). The classified operand is the base COMMIT, not its tree: the merge base is fixed by ancestry, which a tree does not carry, so a base that returns to the same tree at a different commit changes the merge result while a tree comparison passes."

data merge_admission_merge_base_ref: String = gunbc_merge_target_ref as String
// SCHEMA BUMPED v1 -> v2 WITH THE ADDED FIELD, per the rule gunbc.merge_admission_produce
// wire_exact_arity_note states: "adding a field means bumping the schema tag, not silently
// appending a line older readers ignore". The arity check below moves 5 -> 6 in the same step, so a
// stale v1 wire refuses on the tag rather than binding five of its six fields and inventing the
// sixth.
data merge_admission_tested_subject_schema: String = "gunbc.merge_admission_tested_subject.v2"

data compose_walk_attempt_id_note: String = "Pure composition of the walk-attempt identity from its parts; the ENV OBSERVATION lives with the wet entry, this fn only joins and refuses. Every part must be nonempty — an empty run id, attempt number, or job name yields Absent, and the caller REFUSES the run rather than substituting a constant: a silent local would make every non-GitHub run one attempt, so the wrong-attempt refusal could never fire off CI, which is exactly the unreachable-arm shape §5 forbids. Non-GitHub execution supplies GUNBC_WALK_ATTEMPT_ID explicitly and it passes through compose_explicit_walk_attempt_id under the same nonempty law."

data git_object_id_wire_note: String = "A Git object id on the wire carries its FORMAT, because the type does: <format>:<hex>. An anonymous hex string would be exactly the defect DESIGN's ContentHash-family residue records — a value whose family the reader has to guess — and a repository mid SHA-1/SHA-256 transition is precisely when guessing wrong is possible. This fn owns ONLY the <format>:<hex> spelling; whether the hex is a well-formed object id of that family is extdeps.git.object_store's question, answered by git_sha1_object_id / git_sha256_object_id, which check exact length and canonical lowercase hex. An earlier cut cast the suffix straight into the brand, so sha1:x, sha1:not-hex and a 64-digit value labelled sha1 all parsed (review 2026-07-30) — family without length and syntax is not identification."

fn merge_admission_attempt_dir(root: String, attempt_id: WalkAttemptId) -> String {
  concat(concat(root, "/.gunbc/merge-admission/"), attempt_id as String)
}

fn merge_admission_tested_subject_path(root: String, attempt_id: WalkAttemptId) -> String {
  concat(merge_admission_attempt_dir(root: root, attempt_id: attempt_id), "/tested-subject.wire")
}

fn merge_admission_floor_receipt_path(root: String, attempt_id: WalkAttemptId) -> String {
  concat(merge_admission_attempt_dir(root: root, attempt_id: attempt_id), "/floor-receipt.wire")
}

fn compose_walk_attempt_id(run_id: String, run_attempt: String, job: String) -> WalkAttemptId? {
  if (run_id == "") || (run_attempt == "") || (job == "") {
    none
  } else {
    walk_attempt_id(raw: concat(concat(concat(concat(run_id, "-"), run_attempt), "-"), job))
  }
}

fn compose_explicit_walk_attempt_id(explicit: String) -> WalkAttemptId? {
  walk_attempt_id(raw: explicit)
}

fn render_git_object_id_wire(oid: extdeps.git.object_store.GitObjectId) -> String {
  match oid {
    GitSha1ObjectId { digest: _ } => concat("sha1:", git_object_id_wire_hex(oid: oid) as String)
    GitSha256ObjectId { digest: _ } => concat("sha256:", git_object_id_wire_hex(oid: oid) as String)
  }
}

fn parse_git_object_id_wire(raw: String) -> extdeps.git.object_store.GitObjectId? {
  if !(length(split(s: raw, delimiter: ":")) == 2) {
    none
  } else if split(s: raw, delimiter: ":").first() == "sha1" {
    git_sha1_object_id(hex: split(s: raw, delimiter: ":").skip(n: 1).first())
  } else if split(s: raw, delimiter: ":").first() == "sha256" {
    git_sha256_object_id(hex: split(s: raw, delimiter: ":").skip(n: 1).first())
  } else {
    none
  }
}

fn render_tested_subject_wire(subject: TestedSubject) -> String {
  join([
    merge_admission_tested_subject_schema,
    subject.attempt_id as String,
    subject.base_ref,
    subject.head_sha,
    subject.base_commit_sha,
  ], "\n")
}

fn receipt_wire_lines(text: String) -> std.types.List<String> {
  split(s: text, delimiter: "\n")
}

fn parse_tested_subject_wire(text: String) -> TestedSubject? {
  let lines = receipt_wire_lines(text: text)
  if !(length(lines) == 5) {
    none
  } else if !(lines.first() == merge_admission_tested_subject_schema) {
    none
  } else if lines.skip(n: 2).first() == "" {
    none
  } else if lines.skip(n: 3).first() == "" {
    none
  } else if lines.skip(n: 4).first() == "" {
    none
  } else {
    match walk_attempt_id(raw: lines.skip(n: 1).first()) {
      Absent => none
      Present { value: attempt } => Present {
        value: TestedSubject {
          attempt_id: attempt,
          base_ref: lines.skip(n: 2).first(),
          head_sha: lines.skip(n: 3).first(),
          base_commit_sha: lines.skip(n: 4).first(),
        }
      }
    }
  }
}
