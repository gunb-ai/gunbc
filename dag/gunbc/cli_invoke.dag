module gunbc.cli_invoke

import std.dissolution { DissolutionCondition, dissolution_description, unbound_dissolution }

import std.types { FilePath, String }

data cli_invoke_shell_spelling_dissolve_trigger: DissolutionCondition = unbound_dissolution(description: "dissolve-on: cli_invoke claim_executor _shell builders (claim_executor_run_plan_shell, claim_executor_verify_artifacts_shell, source_roots_shell_flags and the SourceRootShellStyle they read) — interim GHA emit surface for Phase 3a; delete when claim_executor call sites render through bash emit (shell→intent open thread, docs/plans/shell-intent-emit-realization-design.md Phase 3 completion). THE gunbc run HALF IS DONE, not deferred: gunbc_run_shell and gunbc_bin_shell are DELETED and every emitted gunbc run step now renders from the one typed invocation shape gunbc_run_invocation_words through v2.workflow.gunbc_invoke_step_emit. This row is narrowed rather than retired because the claim_executor lane still carries its own shell spelling beside claim_executor_run_plan_transport_argv, which is the same fork one authority up.")

type SourceRootShellStyle
  = SourceRootBare
  | SourceRootRooted { root_var: String }

data claim_executor_bin_name: String = "claim_executor"
data gunbc_bin_name: String = "gunbc"

fn source_root_transport_argv(roots: List<String>) -> List<String> {
  fold(roots, init: [], f: (acc, r) => concat(acc, ["--source-root", r]))
}

fn source_root_shell_flag(root: String, style: SourceRootShellStyle) -> String {
  match style {
    SourceRootBare => concat(" --source-root ", root)
    SourceRootRooted { root_var: v } =>
      concat(" --source-root \"", concat(concat(v, "/"), concat(root, "\"")))
  }
}

fn source_roots_shell_flags(roots: List<String>, style: SourceRootShellStyle) -> String {
  fold(roots, init: "", f: (acc, r) => concat(acc, source_root_shell_flag(root: r, style: style)))
}

data release_bin_dir_rel: String = "target/release"

fn release_bin_rel_path(bin_name: String) -> String {
  concat(concat(release_bin_dir_rel, "/"), bin_name)
}

fn release_bin_shell_path(bin_name: String) -> String {
  concat(concat("\"$ROOT/", release_bin_rel_path(bin_name: bin_name)), "\"")
}

fn claim_executor_bin_shell() -> String {
  release_bin_shell_path(bin_name: claim_executor_bin_name)
}

fn claim_executor_notice_title_normalized(notice_title: String?) -> String? {
  match notice_title {
    Present { value: title } =>
      if title == "" { none } else { Present { value: title } }
    Absent => none
  }
}

type PlanFunction
  = CiFloorPlan
  | CiRegenFloorPlan
  | CiPlanArtifactPlan
  | FalsifierPlan
  | FalsifierNativeCacheColdPlan

data plan_function_closed_roster_note: String = "THE CLOSED ROSTER OF PRODUCTION ClaimExecutor PLAN TARGETS, and it is a coproduct rather than a String parameter because a String is what let a plan target escape a migration that claimed to cover all of them. plan_function was an unconstrained String crossing the modeled boundary, so plan identity was carried by an argv token nothing could check: gunbc.falsifier_workflow passed the literal \"gunbc_falsifier_native_cache_cold_batches\", derived from no authority, and the 2026-07-30 WalkPlan rename — whose completeness argument was a hand-maintained count of four — could not reach it. The executor then correctly refused the stale shape on every falsifier run that armed that step.\n\nWHAT THE TYPE BUYS, stated as the guarantee rather than the intent: an inline string literal at a plan_function argument is now a TYPE ERROR, so the class that produced this incident is unwritable rather than validated (§5 construction-over-validation). The roster is closed by the coproduct, so a new production plan target cannot be authored without adding a variant, and every exhaustive match over PlanFunction — plan_function_name here, plan_variant_is_walk_plan_shaped in v2.test.claim.ci_floor_plan_witness — fails to compile until that variant is handled.\n\nTHE LIMIT OF THAT, corrected after review 46883 rejected the stronger claim this paragraph used to make. Compile-time forces an ARM TO EXIST for every variant; it does not force that arm to be EXECUTED by any witness, because the witness roster is a hand-authored list. So the guarantee is 'no target can exist unhandled', NOT 'the target set and the proof set are the same set'. The census is narrowed, not abolished, and saying otherwise would repeat the completeness failure this type exists to prevent.\n\nWHAT IT DOES NOT BUY, named rather than implied: the variant-to-plan-function-value pairing in the witness is still hand-authored, because resolving an argv token to a declaration needs the containment SymbolIndex the namespace lane is building — the type closes WHICH targets exist, not that each names a function whose declared return is WalkPlan<F>. Dissolve-on: a typed declaration reference (std.decl_ref.DeclarationRef over a resolved plan symbol) replaces the name projection, at which point plan_function_name and the witness's hand pairing both delete."

fn plan_function_name(p: PlanFunction) -> String {
  match p {
    CiFloorPlan => "gunbc_ci_floor_plan"
    CiRegenFloorPlan => "gunbc_ci_regen_floor_plan"
    CiPlanArtifactPlan => "gunbc_ci_plan_artifact_plan"
    FalsifierPlan => "gunbc_falsifier_plan"
    FalsifierNativeCacheColdPlan => "gunbc_falsifier_native_cache_cold_plan"
  }
}

fn claim_executor_run_plan_transport_argv(
  source_roots: List<String>,
  plan_entry: String,
  plan_function: PlanFunction,
  notice_title: String?
) -> List<String> {
  let base = concat(
    source_root_transport_argv(roots: source_roots),
    ["--plan-entry", plan_entry, "--plan-function", plan_function_name(p: plan_function)]
  )
  match claim_executor_notice_title_normalized(notice_title: notice_title) {
    Present { value: title } => concat(base, ["--notice-title", title])
    Absent => base
  }
}

fn claim_executor_verify_artifacts_transport_argv(artifact_paths: List<String>) -> List<String> {
  concat(["--verify-build-artifacts"], artifact_paths)
}

// THE SINGLE AUTHORITY for the shape of a `gunbc run` invocation's arguments. It was
// two authorities until now: gunbc_run_transport_argv built the typed argv the
// gunbc.WitnessBin.Run route takes, and the deleted gunbc_run_shell built a bash
// spelling of the same invocation for emitted workflow steps. Both had to be edited to
// change one fact and nothing made them agree (DESIGN section 3 -- one concept, one
// authority). A word is either an ordinary literal or a repository-root-relative path;
// that distinction is what the two realizations need and the only thing a flat
// List<String> could not carry, since rooting is a per-word fact (source roots are
// rooted, --entry is not). Realizations: the argv projection below, and the emitted
// bash step in v2.workflow.gunbc_invoke_step_emit. Neither is named here -- the
// dispatch that selects a realization is itself realization.
type InvocationWord
  = LiteralWord { spelling: String }
  | RootRelativeWord { rel: String }

fn invocation_word_bare(w: InvocationWord) -> String {
  match w {
    LiteralWord { spelling: s } => s
    RootRelativeWord { rel: r } => r
  }
}

fn invocation_words_bare(words: List<InvocationWord>) -> List<String> {
  fold(words, init: [], f: (acc, w) => concat(acc, [invocation_word_bare(w: w)]))
}

fn source_root_invocation_words(roots: List<String>) -> List<InvocationWord> {
  fold(
    roots,
    init: [],
    f: (acc, r) =>
      concat(acc, [LiteralWord { spelling: "--source-root" }, RootRelativeWord { rel: r }])
  )
}

fn gunbc_run_invocation_words(
  source_roots: List<String>,
  entry: String,
  function: String,
  claim_run: Bool
) -> List<InvocationWord> {
  let base = concat(
    concat([LiteralWord { spelling: "run" }], source_root_invocation_words(roots: source_roots)),
    [
      LiteralWord { spelling: "--entry" },
      LiteralWord { spelling: entry },
      LiteralWord { spelling: "--function" },
      LiteralWord { spelling: function }
    ]
  )
  if claim_run {
    concat(base, [LiteralWord { spelling: "--claim-run" }])
  } else {
    base
  }
}

fn gunbc_run_transport_argv(
  source_roots: List<String>,
  entry: String,
  function: String,
  claim_run: Bool
) -> List<String> {
  invocation_words_bare(
    words: gunbc_run_invocation_words(
      source_roots: source_roots,
      entry: entry,
      function: function,
      claim_run: claim_run
    )
  )
}


fn claim_executor_notice_title_shell_suffix(notice_title: String?) -> String {
  match claim_executor_notice_title_normalized(notice_title: notice_title) {
    Present { value: title } => concat(concat(" --notice-title \"", title), "\"")
    Absent => ""
  }
}

fn claim_executor_run_plan_shell(
  source_roots: List<String>,
  plan_entry: String,
  plan_function: PlanFunction,
  notice_title: String?,
  rooted: Bool
) -> String {
  let style = if rooted {
    SourceRootRooted { root_var: "$ROOT" }
  } else {
    SourceRootBare
  }
  let flags = source_roots_shell_flags(roots: source_roots, style: style)
  let notice = claim_executor_notice_title_shell_suffix(notice_title: notice_title)
  concat(
    concat(claim_executor_bin_shell(), flags),
    concat(
      concat(concat(" --plan-entry ", plan_entry), concat(" --plan-function ", plan_function_name(p: plan_function))),
      notice
    )
  )
}

fn claim_executor_verify_artifacts_shell(artifact_paths: List<String>) -> String {
  let paths = fold(artifact_paths, init: "", f: (acc, p) => concat(acc, concat(" ", p)))
  concat(concat(concat(claim_executor_bin_shell(), " --verify-build-artifacts"), paths), "\n")
}
