module gunbc.cli_invoke

import std.dissolution { DissolutionCondition, unbound_dissolution }

import std.types { String }

// NARROWED 2026-08-26 with the plan/walk residue cut. What stood here named four
// claim_executor shell builders; three of them (claim_executor_run_plan_shell and the
// notice-title suffix and normalizer it needed) built argv for --plan-entry /
// --plan-function / --notice-title, flags claim_executor stopped parsing on 2026-08-25,
// and they are deleted rather than dissolved. The row survives for the ONE spelling that
// still renders a live mode.
data cli_invoke_shell_spelling_dissolve_trigger: DissolutionCondition = unbound_dissolution(description: "dissolve-on: cli_invoke claim_executor_verify_artifacts_shell and the claim_executor_bin_shell / release_bin_shell_path / source_roots_shell_flags spelling beneath it — interim GHA emit surface; delete when the claim_executor --verify-build-artifacts call site renders through bash emit (shell→intent open thread, docs/plans/shell-intent-emit-realization-design.md Phase 3 completion). THE gunbc run HALF IS DONE, not deferred: gunbc_run_shell and gunbc_bin_shell are DELETED and every emitted gunbc run step now renders from the one typed invocation shape gunbc_run_invocation_words through v2.workflow.gunbc_invoke_step_emit. This row is narrowed rather than retired because the claim_executor lane still carries its own shell spelling beside claim_executor_verify_artifacts_transport_argv, which is the same fork one authority up.")

type SourceRootShellStyle
  = SourceRootBare
  | SourceRootRooted { root_var: String }

data claim_executor_bin_name: String = "claim_executor"
data gunbc_bin_name: String = "gunbc"

fn source_root_transport_argv(roots: List<String>) -> List<String> {
  fold(roots, init: [], f: (acc, r) => concat(acc, ["--source-root", r]))
}

data release_bin_dir_rel: String = "target/release"

fn release_bin_rel_path(bin_name: String) -> String {
  concat(concat(release_bin_dir_rel, "/"), bin_name)
}

fn release_bin_shell_path(bin_name: String) -> String {
  concat(concat("\"$ROOT/", release_bin_rel_path(bin_name: bin_name)), "\"")
}

fn claim_executor_bin_shell() -> String {
  release_bin_shell_path(bin_name: claim_executor_bin_name)
}

fn source_root_shell_flag(root: String, style: SourceRootShellStyle) -> String {
  match style {
    SourceRootBare => concat(" --source-root ", root)
    SourceRootRooted { root_var: v } =>
      concat(" --source-root \"", concat(concat(v, "/"), concat(root, "\"")))
  }
}

fn source_roots_shell_flags(roots: List<String>, style: SourceRootShellStyle) -> String {
  fold(roots, init: "", f: (acc, r) => concat(acc, source_root_shell_flag(root: r, style: style)))
}

fn claim_executor_verify_artifacts_transport_argv(artifact_paths: List<String>) -> List<String> {
  concat(["--verify-build-artifacts"], artifact_paths)
}

// THE SINGLE AUTHORITY for the shape of a `gunbc run` invocation's arguments. It was
// two authorities until now: gunbc_run_transport_argv built the typed argv the
// gunbc.WitnessBin.Run route takes, and the deleted gunbc_run_shell built a bash
// spelling of the same invocation for emitted workflow steps. Both had to be edited to
// change one fact and nothing made them agree (DESIGN section 3 -- one concept, one
// authority). A word is either an ordinary literal or a repository-root-relative path;
// that distinction is what the two realizations need and the only thing a flat
// List<String> could not carry, since rooting is a per-word fact (source roots are
// rooted, --entry is not). Realizations: the argv projection below, and the emitted
// bash step in v2.workflow.gunbc_invoke_step_emit. Neither is named here -- the
// dispatch that selects a realization is itself realization.
type InvocationWord
  = LiteralWord { spelling: String }
  | RootRelativeWord { rel: String }

fn invocation_word_bare(w: InvocationWord) -> String {
  match w {
    LiteralWord { spelling: s } => s
    RootRelativeWord { rel: r } => r
  }
}

fn invocation_words_bare(words: List<InvocationWord>) -> List<String> {
  fold(words, init: [], f: (acc, w) => concat(acc, [invocation_word_bare(w: w)]))
}

fn source_root_invocation_words(roots: List<String>) -> List<InvocationWord> {
  fold(
    roots,
    init: [],
    f: (acc, r) =>
      concat(acc, [LiteralWord { spelling: "--source-root" }, RootRelativeWord { rel: r }])
  )
}

// A NAMED ARGUMENT IS A NAME AND A VALUE, NOT A PRE-JOINED WORD. `gunbc run` takes repeatable
// `--arg name=value`, and the joining is the transport's business: a caller that handed in the
// string "root=/tmp/x" would be spelling the separator itself, which is the same positional
// convention this module exists to own once.
//
// THE ROUND TRIP IS DECIDED BY THE DECODER, so it is named rather than assumed: `decode_run_args`
// in the stage0 driver splits on `split_once('=')` -- the FIRST separator -- and refuses a spec
// whose name half is empty. Joining here as name + "=" + value therefore reconstructs exactly this
// pair on the far side, and a VALUE containing "=" survives intact rather than re-splitting into a
// different name. That is a property of the decoder's rule, not of this carrier being tidy; if that
// rule ever became last-separator or greedy, this comment is where the disagreement would surface.
// THE NAME IS SEALED; THE VALUE IS NOT. The value side is safe by the decoder's rule above -- the
// first "=" has already divided name from value, so everything after it is the value whatever it
// contains. The NAME side is not, and that asymmetry is the whole reason this carrier is sealed:
// a name containing "=" REBINDS SILENTLY rather than refusing. `NamedArgument { name:
// "expected=text", value: "x" }` projects to `--arg expected=text=x`, and the host binds the
// parameter `expected` with value `text=x` -- a different parameter than the caller named, with no
// diagnostic anywhere. An empty name is refused by the host, which is a stop rather than a silent
// rebind, but it is refused LATE, in a child process, as a string; admitting it here makes the
// refusal local and typed.
//
// So construction is the wall (DESIGN section 5: correctness by construction, not validation) --
// `sole_constructor` means the only route to a NamedArgument is `admit_named_argument`, which
// returns a typed refusal rather than a value for a name that cannot round-trip.
type NamedArgument sole_constructor { name: String, value: String }

type NamedArgumentAdmission
  = NamedArgumentAdmitted { argument: NamedArgument }
  | NamedArgumentNameEmpty
  | NamedArgumentNameHoldsSeparator { name: String }

fn admit_named_argument(name: String, value: String) -> NamedArgumentAdmission {
  if name == "" {
    NamedArgumentNameEmpty
  } else if string_contains(s: name, pattern: "=") {
    NamedArgumentNameHoldsSeparator { name: name }
  } else {
    NamedArgumentAdmitted { argument: NamedArgument { name: name, value: value } }
  }
}

fn named_argument_words(argument: NamedArgument) -> List<InvocationWord> {
  [
    LiteralWord { spelling: "--arg" },
    LiteralWord { spelling: concat(concat(argument.name, "="), argument.value) }
  ]
}

fn named_argument_invocation_words(arguments: List<NamedArgument>) -> List<InvocationWord> {
  fold(arguments, init: [], f: (acc, a) => concat(acc, named_argument_words(argument: a)))
}

// THE ONE `gunbc run` SHAPE. The no-named-arguments route below delegates here with an EMPTY
// population rather than carrying a second spelling of the same argv, so there is one place where
// the order of `run`, the source roots, the entry, the function, the named arguments and
// `--claim-run` is decided (DESIGN section 3: interface, realization and policy are three facts, and
// the argv shape is the interface).
fn gunbc_run_invocation_words_with_arguments(
  source_roots: List<String>,
  entry: String,
  function: String,
  claim_run: Bool,
  arguments: List<NamedArgument>
) -> List<InvocationWord> {
  let base = concat(
    concat(
      concat([LiteralWord { spelling: "run" }], source_root_invocation_words(roots: source_roots)),
      [
        LiteralWord { spelling: "--entry" },
        LiteralWord { spelling: entry },
        LiteralWord { spelling: "--function" },
        LiteralWord { spelling: function }
      ]
    ),
    named_argument_invocation_words(arguments: arguments)
  )
  if claim_run {
    concat(base, [LiteralWord { spelling: "--claim-run" }])
  } else {
    base
  }
}

fn gunbc_run_invocation_words(
  source_roots: List<String>,
  entry: String,
  function: String,
  claim_run: Bool
) -> List<InvocationWord> {
  gunbc_run_invocation_words_with_arguments(
    source_roots: source_roots,
    entry: entry,
    function: function,
    claim_run: claim_run,
    arguments: []
  )
}

fn gunbc_run_transport_argv(
  source_roots: List<String>,
  entry: String,
  function: String,
  claim_run: Bool
) -> List<String> {
  invocation_words_bare(
    words: gunbc_run_invocation_words(
      source_roots: source_roots,
      entry: entry,
      function: function,
      claim_run: claim_run
    )
  )
}

fn gunbc_run_transport_argv_with_arguments(
  source_roots: List<String>,
  entry: String,
  function: String,
  claim_run: Bool,
  arguments: List<NamedArgument>
) -> List<String> {
  invocation_words_bare(
    words: gunbc_run_invocation_words_with_arguments(
      source_roots: source_roots,
      entry: entry,
      function: function,
      claim_run: claim_run,
      arguments: arguments
    )
  )
}

fn claim_executor_verify_artifacts_shell(artifact_paths: List<String>) -> String {
  let paths = fold(artifact_paths, init: "", f: (acc, p) => concat(acc, concat(" ", p)))
  concat(concat(concat(claim_executor_bin_shell(), " --verify-build-artifacts"), paths), "\n")
}
