type InspectedMatrixAxesJoin
  = InspectedMatrixAxesBound { axes: List<NonEmptyStr> }
  | InspectedMatrixAxesUninspected { cause: NonEmptyStr }

fn inspected_job_matrix_axes_join(
  rows: List<InspectedJobMatrixAxes>,
  repository: NonEmptyStr,
  workflow_path: NonEmptyStr,
  job_key: NonEmptyStr,
) -> InspectedMatrixAxesJoin {
  let matches = filter(rows, r =>
    (r.repository as String) == (repository as String)
      && (r.workflow_path as String) == (workflow_path as String)
      && (r.job_key as String) == (job_key as String)
  )
  if count(matches) == 0 {
    InspectedMatrixAxesUninspected {
      cause: "no inspected matrix-axis row for this repository, workflow path, and job_key",
    }
  } else if count(matches) == 1 {
    match matches.first() {
      Present { value: row } => InspectedMatrixAxesBound { axes: row.axes }
      Absent => InspectedMatrixAxesUninspected {
        cause: "no inspected matrix-axis row for this repository, workflow path, and job_key",
      }
    }
  } else {
    InspectedMatrixAxesUninspected {
      cause: "multiple inspected matrix-axis rows for this repository, workflow path, and job_key",
    }
  }
}

