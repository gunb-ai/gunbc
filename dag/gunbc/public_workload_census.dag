module gunbc.public_workload_census

import std.types { Bool, CommitSha, Int, List, NonEmptyStr, String }
import extdeps.time.rfc3339 { Rfc3339Timestamp }
import extdeps.toolchain.types { Architecture }
import extdeps.github.workflow_runs {
  WorkflowJobRun,
  Completed,
  Success,
  Failure,
  Cancelled,
  Neutral,
  Skipped,
  TimedOut,
  ActionRequired,
  StartupFailure,
}
import gunbc.runner_label_resolution {
  resolve_runner_label,
  arm_standing,
  ArmStanding,
  ArmConfirmed,
  NotArmConfirmed,
  ArmUndetermined,
}

// PUBLIC WORKFLOW-JOB CENSUS (year_end_plan item public-workload-census).
//
// THE SUBJECT IS A JOB, NOT A REPOSITORY. Compatibility is job-scoped: an Arm image-publishing
// job proves nothing about whether a repository's build and tests run natively on Arm. Every row
// is keyed on repository + inspected commit + workflow path + job key + matrix selector.
//
// DECLARED VERSUS OBSERVED ARE DIFFERENT FACTS. A workflow file declares a runs-on value; a job
// resource may report the label that actually ran. Absence of a run is a recorded value
// (NoRunObserved), never a blank. Architecture and provider are read from
// gunbc.runner_label_resolution's vendor catalogs, never from a hyphen grammar: a label without a
// catalog row is ArmUndetermined, not x64.
//
// THIS MODULE IS A CENSUS AND A SELECTION. It does not port, benchmark, authorize a trial, or
// authorize outreach. Spend is unobserved on every row: a third-party label is use, not a bill.
//
// FIVE PROMOTIONS THE CARRIERS KEEP APART: an x64 catalog row is not Arm; a green job that ran no
// test is not a baseline; an unobserved cache is not warm; provider use is not verified spend;
// a census outcome does not authorize a trial.

type CensusVerdict<Reading> sole_constructor {
  reading: Reading
}

type DeclaredRunner
  = DeclaredLabel { label: String }
  | DeclaredExpression { expression: String, alternatives: List<String> }

type DeclaredArchitectureStanding
  = DeclaredArm { via: DeclaredRunner }
  | DeclaredNotArm { via: DeclaredRunner, architecture: Architecture }
  | DeclaredArchitectureUnresolved { via: DeclaredRunner, cause: NonEmptyStr }

type DeclaredProviderStanding
  = DeclaredProviderKnown { via: DeclaredRunner, provider_module: NonEmptyStr }
  | DeclaredProviderUnresolved { via: DeclaredRunner, cause: NonEmptyStr }

fn first_alternative_standing(
  alternatives: List<String>,
  observed_at: Rfc3339Timestamp,
) -> ArmStanding {
  if count(alternatives) == 0 {
    ArmUndetermined { label: "", cause: "declared runs-on expression listed no concrete alternatives" }
  } else {
    arm_standing(r: resolve_runner_label(label: alternatives.first(), observed_at: observed_at))
  }
}

fn alternatives_any_undetermined(alternatives: List<String>, observed_at: Rfc3339Timestamp) -> Bool {
  any(alternatives, l => match arm_standing(r: resolve_runner_label(label: l, observed_at: observed_at)) {
    ArmUndetermined { label, cause } => true
    ArmConfirmed { label, snapshot } => false
    NotArmConfirmed { label, architecture, snapshot } => false
  })
}

fn alternatives_any_arm(alternatives: List<String>, observed_at: Rfc3339Timestamp) -> Bool {
  any(alternatives, l => match arm_standing(r: resolve_runner_label(label: l, observed_at: observed_at)) {
    ArmConfirmed { label, snapshot } => true
    NotArmConfirmed { label, architecture, snapshot } => false
    ArmUndetermined { label, cause } => false
  })
}

fn alternatives_any_not_arm(alternatives: List<String>, observed_at: Rfc3339Timestamp) -> Bool {
  any(alternatives, l => match arm_standing(r: resolve_runner_label(label: l, observed_at: observed_at)) {
    NotArmConfirmed { label, architecture, snapshot } => true
    ArmConfirmed { label, snapshot } => false
    ArmUndetermined { label, cause } => false
  })
}

fn declared_architecture_standing(
  spec: DeclaredRunner,
  observed_at: Rfc3339Timestamp,
) -> DeclaredArchitectureStanding {
  match spec {
    DeclaredLabel { label } =>
      match arm_standing(r: resolve_runner_label(label: label, observed_at: observed_at)) {
        ArmConfirmed { label, snapshot } => DeclaredArm { via: spec }
        NotArmConfirmed { label, architecture, snapshot } =>
          DeclaredNotArm { via: spec, architecture: architecture }
        ArmUndetermined { label, cause } =>
          DeclaredArchitectureUnresolved { via: spec, cause: cause }
      }
    DeclaredExpression { expression, alternatives } =>
      if alternatives_any_undetermined(alternatives: alternatives, observed_at: observed_at) {
        DeclaredArchitectureUnresolved {
          via: spec,
          cause: "at least one declared alternative is absent from the surveyed runner catalogs, so architecture is not established by the workflow file alone",
        }
      } else if alternatives_any_arm(alternatives: alternatives, observed_at: observed_at)
        && alternatives_any_not_arm(alternatives: alternatives, observed_at: observed_at) {
        DeclaredArchitectureUnresolved {
          via: spec,
          cause: "declared alternatives mix catalog Arm and not-Arm labels; the workflow does not establish a single architecture",
        }
      } else if alternatives_any_arm(alternatives: alternatives, observed_at: observed_at) {
        DeclaredArm { via: spec }
      } else {
        match first_alternative_standing(alternatives: alternatives, observed_at: observed_at) {
          NotArmConfirmed { label, architecture, snapshot } =>
            DeclaredNotArm { via: spec, architecture: architecture }
          ArmConfirmed { label, snapshot } => DeclaredArm { via: spec }
          ArmUndetermined { label, cause } =>
            DeclaredArchitectureUnresolved { via: spec, cause: cause }
        }
      }
  }
}

fn declared_architecture_is_arm(s: DeclaredArchitectureStanding) -> Bool {
  match s {
    DeclaredArm { via } => true
    DeclaredNotArm { via, architecture } => false
    DeclaredArchitectureUnresolved { via, cause } => false
  }
}

// -------------------------------------------------------------------------------------
// OBSERVED EXECUTION. The job resource is the observation; correctness is a second reading of
// the steps, not of the conclusion name.
// -------------------------------------------------------------------------------------

type CorrectnessObservation
  = TestsExecuted { step: NonEmptyStr }
  | NoTestsExecuted { note: NonEmptyStr }

type ObservedExecution
  = NoRunObserved { obligation: NonEmptyStr }
  | JobRunObserved {
      job: WorkflowJobRun
      head_sha: CommitSha
      correctness: CorrectnessObservation
    }

fn observed_job_labels(job: WorkflowJobRun) -> List<String> {
  job.labels
}

fn observed_job_run_attempt(job: WorkflowJobRun) -> Int {
  job.run_attempt
}

fn observed_primary_label(o: ObservedExecution) -> String {
  match o {
    JobRunObserved { job, head_sha, correctness } =>
      if count(observed_job_labels(job: job)) == 0 {
        ""
      } else {
        observed_job_labels(job: job).first()
      }
    NoRunObserved { obligation } => ""
  }
}

fn conclusion_is_success(c: WorkflowRunConclusion?) -> Bool {
  match c {
    Present { value: conclusion } => match conclusion {
      Success => true
      Failure => false
      Cancelled => false
      Neutral => false
      Skipped => false
      TimedOut => false
      ActionRequired => false
      StartupFailure => false
    }
    Absent => false
  }
}

type BaselineAdmission
  = BaselineAdmitted {
      job_id: Int
      run_id: Int
      run_attempt: Int
      head_sha: CommitSha
      test_step: NonEmptyStr
      observed_label: String
    }
  | BaselineRefused { cause: NonEmptyStr }

fn baseline_admission(o: ObservedExecution) -> CensusVerdict<BaselineAdmission> {
  match o {
    NoRunObserved { obligation } =>
      CensusVerdict { reading: BaselineRefused { cause: concat("no run observed: ", obligation) } }
    JobRunObserved { job, head_sha, correctness } =>
      if conclusion_is_success(c: job.conclusion) == false {
        CensusVerdict { reading: BaselineRefused {
          cause: "the observed job did not conclude success; a failed, cancelled or unconcluded job is not a baseline",
        } }
      } else {
        match correctness {
          TestsExecuted { step } => CensusVerdict { reading: BaselineAdmitted {
            job_id: job.id,
            run_id: job.run_id,
            run_attempt: observed_job_run_attempt(job: job),
            head_sha: head_sha,
            test_step: step,
            observed_label: observed_primary_label(o: o),
          } }
          NoTestsExecuted { note } => CensusVerdict { reading: BaselineRefused {
            cause: concat("job succeeded but executed no correctness check: ", note),
          } }
        }
      }
  }
}

fn baseline_is_admitted(b: CensusVerdict<BaselineAdmission>) -> Bool {
  match b.reading {
    BaselineAdmitted { job_id, run_id, run_attempt, head_sha, test_step, observed_label } => true
    BaselineRefused { cause } => false
  }
}

fn observed_arm_standing(o: ObservedExecution, observed_at: Rfc3339Timestamp) -> ArmStanding {
  let label = observed_primary_label(o: o)
  if label == "" {
    ArmUndetermined { label: label, cause: "no runner label was observed on a job resource" }
  } else {
    arm_standing(r: resolve_runner_label(label: label, observed_at: observed_at))
  }
}

// -------------------------------------------------------------------------------------
// CACHE: reading YAML is not observing hit or miss.
// -------------------------------------------------------------------------------------

type CacheObservation
  = CacheUnobserved { obligation: NonEmptyStr }
  | CacheMissConfirmed { evidence: NonEmptyStr }
  | CacheHitConfirmed { evidence: NonEmptyStr }

type CacheMechanism {
  name: NonEmptyStr
  layer: NonEmptyStr
  observation: CacheObservation
}

type CacheCondition
  = LogicalCold { evidence: NonEmptyStr }
  | RemoteWarmOnFreshWorker { evidence: NonEmptyStr }
  | CacheConditionUnestablished { cause: NonEmptyStr }

fn cache_condition(m: CacheMechanism) -> CensusVerdict<CacheCondition> {
  match m.observation {
    CacheHitConfirmed { evidence } =>
      CensusVerdict { reading: RemoteWarmOnFreshWorker { evidence: evidence } }
    CacheMissConfirmed { evidence } =>
      CensusVerdict { reading: LogicalCold { evidence: evidence } }
    CacheUnobserved { obligation } => CensusVerdict { reading: CacheConditionUnestablished {
      cause: concat(m.name, concat(" was declared in the workflow and never observed: ", obligation)),
    } }
  }
}

fn cache_condition_is_warm(c: CensusVerdict<CacheCondition>) -> Bool {
  match c.reading {
    RemoteWarmOnFreshWorker { evidence } => true
    LogicalCold { evidence } => false
    CacheConditionUnestablished { cause } => false
  }
}

data cache_read_obligation: NonEmptyStr = "this census read workflow YAML and the job-run resource (labels, conclusion, step names); no cache log line was read, so hit or miss is unobserved"

// -------------------------------------------------------------------------------------
// EXTERNAL EFFECTS. Registry pushes and cloud role assumption come out of BOTH replay
// realizations. An artifact upload inside the same run is retained and timed.
// -------------------------------------------------------------------------------------

type ExternalEffectKind
  = RegistryPush { registry: NonEmptyStr }
  | CloudRoleAssumption { role: NonEmptyStr }
  | CoverageUpload { service: NonEmptyStr }
  | WorkflowArtifactUpload { artifact: NonEmptyStr }

type EffectDisposition
  = RemovedFromBothRealizations { cause: NonEmptyStr }
  | RetainedAndTimed { cause: NonEmptyStr }

type ExternalEffect {
  kind: ExternalEffectKind
  step: NonEmptyStr
  disposition: EffectDisposition
}

fn effect_requires_removal(k: ExternalEffectKind) -> Bool {
  match k {
    RegistryPush { registry } => true
    CloudRoleAssumption { role } => true
    CoverageUpload { service } => true
    WorkflowArtifactUpload { artifact } => false
  }
}

fn effect_is_removed(e: ExternalEffect) -> Bool {
  match e.disposition {
    RemovedFromBothRealizations { cause } => true
    RetainedAndTimed { cause } => false
  }
}

fn effect_disposition_is_sound(e: ExternalEffect) -> Bool {
  effect_requires_removal(k: e.kind) == effect_is_removed(e: e)
}

type ReplayAdmission
  = ReplayAdmitted { note: NonEmptyStr }
  | ReplayRefusedLicense { cause: NonEmptyStr }
  | ReplayRefusedArchitecture { cause: NonEmptyStr }
  | ReplayRefusedWorkload { cause: NonEmptyStr }

data replay_derivation_note: NonEmptyStr = "public visibility is not a licence; source SPDX was read from GitHub's license API. External mutations named on the row are removed from both realizations, so a replay is a derived build/test (or build-only) contract, not an execution of the published pipeline"

type SpendStanding
  = SpendUnobserved { obligation: NonEmptyStr }

data spend_unobserved_note: NonEmptyStr = "a runner label establishes provider USE, not spend; no customer bill was observed, and this census does not treat GitHub-hosted public minutes as a measured zero"

type TrialAuthorization
  = TrialUnauthorized { cause: NonEmptyStr }

data trial_refusal_note: NonEmptyStr = "a census is not a mandate: nothing in this item authorizes a trial, a migration PR, or outreach"

fn trial_authorization_from_census() -> CensusVerdict<TrialAuthorization> {
  CensusVerdict { reading: TrialUnauthorized { cause: trial_refusal_note } }
}

fn trial_is_authorized(t: CensusVerdict<TrialAuthorization>) -> Bool {
  match t.reading {
    TrialUnauthorized { cause } => false
  }
}

type CandidateSelection
  = SelectedWorkload { rank: Int, complementarity: NonEmptyStr }
  | CandidateRejected { reason: NonEmptyStr }
  | CandidateUnresolved { obligation: NonEmptyStr }

type WorkloadCandidate {
  repository: NonEmptyStr
  license_spdx: NonEmptyStr
  inspected_commit: CommitSha
  workflow_path: NonEmptyStr
  workflow_blob_sha: NonEmptyStr
  job_key: NonEmptyStr
  job_display_name: NonEmptyStr
  matrix_selector: NonEmptyStr
  declared_runner: DeclaredRunner
  observed: ObservedExecution
  observation_time: Rfc3339Timestamp
  workload_commands: List<NonEmptyStr>
  resource_requirements: NonEmptyStr
  caches: List<CacheMechanism>
  external_effects: List<ExternalEffect>
  replay: ReplayAdmission
  spend: SpendStanding
  trial: CensusVerdict<TrialAuthorization>
  selection: CandidateSelection
}

fn candidate_declared_architecture(c: WorkloadCandidate) -> DeclaredArchitectureStanding {
  declared_architecture_standing(spec: c.declared_runner, observed_at: c.observation_time)
}

fn candidate_baseline(c: WorkloadCandidate) -> CensusVerdict<BaselineAdmission> {
  baseline_admission(o: c.observed)
}

fn candidate_is_selected(c: WorkloadCandidate) -> Bool {
  match c.selection {
    SelectedWorkload { rank, complementarity } => true
    CandidateRejected { reason } => false
    CandidateUnresolved { obligation } => false
  }
}

fn candidate_effects_are_sound(c: WorkloadCandidate) -> Bool {
  all(c.external_effects, e => effect_disposition_is_sound(e: e))
}

fn candidate_warm_cache_count(c: WorkloadCandidate) -> Int {
  count(filter(c.caches, m => cache_condition_is_warm(c: cache_condition(m: m))))
}

fn spend_is_unobserved(s: SpendStanding) -> Bool {
  match s {
    SpendUnobserved { obligation } => true
  }
}

