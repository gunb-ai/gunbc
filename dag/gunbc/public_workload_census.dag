type YamlJobNameJoin
  = YamlJobNameBound { prefix: String }
  | YamlJobNameUninspected { cause: NonEmptyStr }

// 0/1/many on repository+workflow_path+job_key. first() is only the unique-row read after
// count==1; two matching rows are Uninspected naming the plurality, not a silent pick.
fn inspected_yaml_job_name_join(
  rows: List<InspectedYamlJobName>,
  repository: NonEmptyStr,
  workflow_path: NonEmptyStr,
  job_key: NonEmptyStr,
) -> YamlJobNameJoin {
  let matches = filter(rows, r =>
    (r.repository as String) == (repository as String)
      && (r.workflow_path as String) == (workflow_path as String)
      && (r.job_key as String) == (job_key as String)
  )
  if count(matches) == 0 {
    YamlJobNameUninspected {
      cause: "no inspected YAML job-name row for this repository, workflow path, and job_key",
    }
  } else if count(matches) == 1 {
    match matches.first() {
      Present { value: row } => YamlJobNameBound {
        prefix: match row.name {
          AuthoredName { prefix } => prefix as String
          NameUnset => row.job_key as String
        },
      }
      Absent => YamlJobNameUninspected {
        cause: "no inspected YAML job-name row for this repository, workflow path, and job_key",
      }
    }
  } else {
    YamlJobNameUninspected {
      cause: "multiple inspected YAML job-name rows for this repository, workflow path, and job_key",
    }
  }
}

type MatrixValueProjection
  = MatrixValuesProjected { values: List<NonEmptyStr> }
  | MatrixValueLookupRefused

fn assignments_for_declared_axis(
  axes: List<MatrixAxisAssignment>,
  name: NonEmptyStr,
) -> List<MatrixAxisAssignment> {
  filter(axes, a => (a.axis as String) == (name as String))
}

fn selector_assignments(matrix: JobMatrixIdentity) -> List<MatrixAxisAssignment> {
  match matrix {
    NoMatrix => []
    MatrixCombination { axes } => axes
  }
}

fn matrix_values_in_declared_axis_order(
  declared: List<NonEmptyStr>,
  axes: List<MatrixAxisAssignment>,
) -> MatrixValueProjection {
  if count(declared) != count(axes) {
    MatrixValueLookupRefused
  } else {
    fold(declared, init: MatrixValuesProjected { values: [] }, f: fn(acc, name) {
      match acc {
        MatrixValueLookupRefused => MatrixValueLookupRefused
        MatrixValuesProjected { values } =>
          let hits = assignments_for_declared_axis(axes: axes, name: name)
          if count(hits) != 1 {
            MatrixValueLookupRefused
          } else {
            match hits.first() {
              Present { value: row } =>
                MatrixValuesProjected { values: concat(values, [row.value]) }
              Absent => MatrixValueLookupRefused
            }
          }
      }
    })
  }
}

type InspectedJobsNameJoin
  = JobsNamePrefixOnly
  | JobsNameMatrixParenthetical { standing: CitedFigureStanding }

type InspectedLegBinding
  = InspectedLegBound { jobs_name_join: InspectedJobsNameJoin }
  | InspectedLegUninspected { cause: NonEmptyStr }
  | InspectedLegAxisMismatch
  | InspectedLegNameMismatch

fn inspected_leg_binding(
  job_name: String,
  job_key: NonEmptyStr,
  matrix: JobMatrixIdentity,
  repository: NonEmptyStr,
  workflow_path: NonEmptyStr,
) -> InspectedLegBinding {
  match inspected_yaml_job_name_join(
    rows: inspected_yaml_job_names,
    repository: repository,
    workflow_path: workflow_path,
    job_key: job_key,
  ) {
    YamlJobNameUninspected { cause } => InspectedLegUninspected { cause: cause }
    YamlJobNameBound { prefix } =>
      match inspected_job_matrix_axes_join(
        rows: inspected_job_matrix_axes,
        repository: repository,
        workflow_path: workflow_path,
        job_key: job_key,
      ) {
        InspectedMatrixAxesUninspected { cause } => InspectedLegUninspected { cause: cause }
        InspectedMatrixAxesBound { axes } =>
          match matrix_values_in_declared_axis_order(
            declared: axes,
            axes: selector_assignments(matrix: matrix),
          ) {
            MatrixValueLookupRefused => InspectedLegAxisMismatch
            MatrixValuesProjected { values } =>
              match matrix {
                NoMatrix =>
                  if job_name == prefix {
                    InspectedLegBound { jobs_name_join: JobsNamePrefixOnly }
                  } else {
                    InspectedLegNameMismatch
                  }
                MatrixCombination { axes: _unused_selector_axes } =>
                  if count(values) == 0 {
                    InspectedLegNameMismatch
                  } else if job_name == concat(
                    prefix,
                    workflow_job_name_matrix_value_parenthetical(values: values),
                  ) {
                    InspectedLegBound {
                      jobs_name_join: JobsNameMatrixParenthetical {
                        standing: workflow_job_name_matrix_parenthetical_standing,
                      },
                    }
                  } else {
                    InspectedLegNameMismatch
                  }
              }
          }
      }
  }
}

type RunIdentityStanding
  = ObservedAtInspectedRevision {
      repository: NonEmptyStr
      revision: CommitSha
      workflow_path: NonEmptyStr
      job_key: NonEmptyStr
      matrix_selector: JobMatrixIdentity
      jobs_name_join: InspectedJobsNameJoin
    }
  | WorkflowEquivalentOnly {
      inspected: CommitSha
      observed: CommitSha
      blob: NonEmptyStr
      jobs_name_join: InspectedJobsNameJoin
    }
  | RunIdentityMismatched { cause: NonEmptyStr }
  | RunIdentityUnresolved { cause: NonEmptyStr }

fn observed_arm_standing(o: ObservedExecution, observed_at: Rfc3339Timestamp) -> ArmStanding {
  match observed_single_label_or_unresolved(s: observed_label_standing(o: o)) {
    ObservedSingleLabel { label } =>
      arm_standing(r: resolve_runner_label(label: label, observed_at: observed_at))
    ObservedLabelUnresolved { label, cause } => ArmUndetermined {
      label: label,
      cause: cause,
    }
  }
}

// -------------------------------------------------------------------------------------
// CACHE: reading YAML is not observing hit or miss.
// -------------------------------------------------------------------------------------

type CacheObservation
  = CacheUnobserved { obligation: NonEmptyStr }
  | CacheMissConfirmed { evidence: NonEmptyStr }
  | CacheHitConfirmed { evidence: NonEmptyStr }

type CacheMechanism {
  name: NonEmptyStr
  layer: NonEmptyStr
  observation: CacheObservation
}

type CacheCondition
  = LogicalCold { evidence: NonEmptyStr }
  | RemoteWarmOnFreshWorker { evidence: NonEmptyStr }
  | CacheConditionUnestablished { cause: NonEmptyStr }

fn cache_condition(m: CacheMechanism) -> CacheCondition {
  match m.observation {
    CacheHitConfirmed { evidence } => RemoteWarmOnFreshWorker { evidence: evidence }
    CacheMissConfirmed { evidence } => LogicalCold { evidence: evidence }
    CacheUnobserved { obligation } => CacheConditionUnestablished {
      cause: concat(m.name, concat(" was declared in the workflow and never observed: ", obligation)),
    }
  }
}

data cache_read_obligation: NonEmptyStr = "this census read workflow YAML and the job-run resource (labels, conclusion, step names); no cache log line was read, so hit or miss is unobserved"

// -------------------------------------------------------------------------------------
// EXTERNAL EFFECTS. Registry pushes and cloud role assumption come out of BOTH replay
// realizations. An artifact upload inside the same run is retained and timed.
// -------------------------------------------------------------------------------------

type ExternalEffectKind
  = RegistryPush { registry: NonEmptyStr }
  | CloudRoleAssumption { role: NonEmptyStr }
  | CoverageUpload { service: NonEmptyStr }
  | WorkflowArtifactUpload { artifact: NonEmptyStr }

type EffectDisposition
  = RemovedFromBothRealizations { cause: NonEmptyStr }
  | RetainedAndTimed { cause: NonEmptyStr }

type ExternalEffect {
  kind: ExternalEffectKind
  step: NonEmptyStr
}

fn effect_disposition(kind: ExternalEffectKind) -> EffectDisposition {
  match kind {
    RegistryPush { registry } => RemovedFromBothRealizations {
      cause: "publishing mutates a third-party registry",
    }
    CloudRoleAssumption { role } => RemovedFromBothRealizations {
      cause: "assuming a third party's cloud role is neither possible nor permissible for replay",
    }
    CoverageUpload { service } => RemovedFromBothRealizations {
      cause: "a third-party coverage upload mutates an external service",
    }
    WorkflowArtifactUpload { artifact } => RetainedAndTimed {
      cause: "an artifact upload inside the same run is required work and is timed as its own stage",
    }
  }
}

type ReplayAdmission
  = ReplayAdmitted { note: NonEmptyStr }
  | ReplayRefusedLicense { cause: NonEmptyStr }
  | ReplayRefusedArchitecture { cause: NonEmptyStr }
  | ReplayRefusedWorkload { cause: NonEmptyStr }

data replay_derivation_note: NonEmptyStr = "public visibility is not a licence; source SPDX was read from GitHub's license API. External mutations named on the row are removed from both realizations, so a replay is a derived build/test (or build-only) contract, not an execution of the published pipeline"

type SpendStanding
  = SpendUnobserved { obligation: NonEmptyStr }

data spend_unobserved_note: NonEmptyStr = "a runner label establishes provider USE, not spend; no customer bill was observed, and this census does not treat GitHub-hosted public minutes as a measured zero"

type TrialAuthorization
  = TrialUnauthorized { cause: NonEmptyStr }

data trial_refusal_note: NonEmptyStr = "a census is not a mandate: nothing in this item authorizes a trial, a migration PR, or outreach"

fn trial_authorization_from_census() -> TrialAuthorization {
  TrialUnauthorized { cause: trial_refusal_note }
}

type ResourceRequirements
  = ResourceRequirementsObserved {
      hardware_threads: HardwareThreadCount
      uses_container: Bool
    }
  | ResourceRequirementsUnobserved { obligation: NonEmptyStr }

// CandidateSelection is complementary census coverage, not realization selection
// (DESIGN §3b stated departure from §3d). std.decision / std.pareto choose one
// realization on a funded multi-axis field and bind a SelectionReceipt. This item
// asks for two or three complementary jobs kept visible with rejected and unresolved
// rows. SelectedWorkload is an authored coverage pick, not SelectedWithin. rank orders
// complementarity of the selected set, not Pareto dominance. CandidateUnresolved is an
// inspection obligation (catalog gap, floating alias), not SelectionNeedsEvidence.
// incumbent-head-to-head is the named later consumer of the selected set; it is not a
// decision subject in this change.
type CandidateSelection
  = SelectedWorkload { rank: Int, complementarity: NonEmptyStr }
  | CandidateRejected { reason: NonEmptyStr }
  | CandidateUnresolved { obligation: NonEmptyStr }

type WorkloadCandidate {
  repository: NonEmptyStr
  license_spdx: NonEmptyStr
  inspected_commit: CommitSha
  workflow_path: NonEmptyStr
  workflow_blob_sha: NonEmptyStr
  job_key: NonEmptyStr
  matrix_selector: JobMatrixIdentity
  declared_runner: DeclaredRunner
  observed: ObservedExecution
  observation_time: Rfc3339Timestamp
  workload_commands: List<NonEmptyStr>
  resource_requirements: ResourceRequirements
  caches: List<CacheMechanism>
  external_effects: List<ExternalEffect>
  replay: ReplayAdmission
  spend: SpendStanding
  trial: TrialAuthorization
  selection: CandidateSelection
}

fn candidate_declared_architecture(c: WorkloadCandidate) -> DeclaredArchitectureStanding {
  declared_architecture_standing(spec: c.declared_runner, observed_at: c.observation_time)
}

fn candidate_declared_provider(c: WorkloadCandidate) -> DeclaredProviderStanding {
  declared_provider_standing(spec: c.declared_runner, observed_at: c.observation_time)
}

fn candidate_observed_architecture(c: WorkloadCandidate) -> ArmStanding {
  observed_arm_standing(o: c.observed, observed_at: c.observation_time)
}

fn candidate_observed_provider(c: WorkloadCandidate) -> ProviderReading {
  observed_provider_standing(o: c.observed, observed_at: c.observation_time)
}

fn candidate_run_identity(c: WorkloadCandidate) -> RunIdentityStanding {
  match c.observed {
    NoRunObserved { obligation } => RunIdentityUnresolved { cause: obligation }
    JobRunObserved { job, repository, workflow_path, workflow_blob_sha_at_head, head_sha, correctness } =>
      if (repository as String) != (c.repository as String) {
        RunIdentityMismatched { cause: "observed repository is not the inspected repository" }
      } else if (workflow_path as String) != (c.workflow_path as String) {
        RunIdentityMismatched { cause: "observed workflow path is not the inspected workflow" }
      } else {
        match inspected_leg_binding(
          job_name: job.name,
          job_key: c.job_key,
          matrix: c.matrix_selector,
          repository: c.repository,
          workflow_path: c.workflow_path,
        ) {
          InspectedLegUninspected { cause } => RunIdentityUnresolved { cause: cause }
          InspectedLegAxisMismatch =>
            RunIdentityMismatched {
              cause: "the matrix selector's axis names are not exactly the inspected workflow's declared matrix axes",
            }
          InspectedLegNameMismatch =>
            RunIdentityMismatched {
              cause: "observed job name is not the Jobs API rendering of the inspected job key and matrix selector",
            }
          InspectedLegBound { jobs_name_join } =>
            if c.inspected_commit == head_sha {
              ObservedAtInspectedRevision {
                repository: c.repository,
                revision: c.inspected_commit,
                workflow_path: c.workflow_path,
                job_key: c.job_key,
                matrix_selector: c.matrix_selector,
                jobs_name_join: jobs_name_join,
              }
            } else if (c.workflow_blob_sha as String) == (workflow_blob_sha_at_head as String) {
              WorkflowEquivalentOnly {
                inspected: c.inspected_commit,
                observed: head_sha,
                blob: c.workflow_blob_sha,
                jobs_name_join: jobs_name_join,
              }
            } else {
              RunIdentityMismatched {
                cause: "inspected revision and observed head differ, and the workflow blob at the observed head is not the inspected blob",
              }
            }
        }
      }
  }
}

data observed_job_did_not_conclude_success: NonEmptyStr = "the observed job did not conclude success; a failed, cancelled or unconcluded job is not a baseline"

fn baseline_from_observed_correctness(c: WorkloadCandidate) -> BaselineAdmission {
  match c.observed {
    NoRunObserved { obligation } =>
      BaselineRefused { cause: concat("no run observed: ", obligation) }
    JobRunObserved { job, repository, workflow_path, workflow_blob_sha_at_head, head_sha, correctness } =>
      match job.conclusion {
        Absent => BaselineRefused { cause: observed_job_did_not_conclude_success }
        Present { value: conclusion } =>
          if job.run_attempt < 1 {
            BaselineRefused {
              cause: "the job resource did not carry a positive run attempt; zero is not attempt 1",
            }
          } else {
            match conclusion {
          Success => match correctness {
            TestsExecuted { step } => match observed_label_standing(o: c.observed) {
              ObservedLabel { label } => BaselineAdmitted {
                job_id: job.id,
                run_id: job.run_id,
                run_attempt: observed_job_run_attempt(job: job),
                head_sha: head_sha,
                test_step: step,
                observed_label: label,
              }
              NoRunObservedForLabel { obligation } => BaselineRefused {
                cause: concat("no run observed: ", obligation),
              }
              JobResourceCarriedNoLabels { job_id } => BaselineRefused {
                cause: "the observed job concluded success and ran tests, but the job resource carried no runner labels",
              }
              JobResourceCarriedMultipleLabels { labels } => BaselineRefused {
                cause: concat(
                  "the job resource carried multiple labels; this census does not admit a baseline from the first of a set: ",
                  observed_label_set_rendering(labels: labels),
                ),
              }
            }
            NoTestsExecuted { note } =>
              BaselineRefused { cause: concat("job succeeded but executed no correctness check: ", note) }
          }
          Failure => BaselineRefused { cause: observed_job_did_not_conclude_success }
          Cancelled => BaselineRefused { cause: observed_job_did_not_conclude_success }
          Neutral => BaselineRefused { cause: observed_job_did_not_conclude_success }
          Skipped => BaselineRefused { cause: observed_job_did_not_conclude_success }
          TimedOut => BaselineRefused { cause: observed_job_did_not_conclude_success }
          ActionRequired => BaselineRefused { cause: observed_job_did_not_conclude_success }
          StartupFailure => BaselineRefused { cause: observed_job_did_not_conclude_success }
            }
          }
      }
  }
}

fn baseline_admission(c: WorkloadCandidate) -> BaselineAdmission {
  match candidate_run_identity(c: c) {
    RunIdentityUnresolved { cause } =>
      BaselineRefused { cause: concat("no run identity: ", cause) }
    RunIdentityMismatched { cause } =>
      BaselineRefused { cause: concat("observed run is not the inspected workload: ", cause) }
    ObservedAtInspectedRevision { repository, revision, workflow_path, job_key, matrix_selector, jobs_name_join } =>
      baseline_from_observed_correctness(c: c)
    WorkflowEquivalentOnly { inspected, observed, blob, jobs_name_join } =>
      BaselineRefused {
        cause: "workflow blob equivalence is not a versioned correctness baseline: tests, dependencies and invoked scripts can change while the workflow YAML bytes stay the same",
      }
  }
}

type ArchitectureJoinStanding
  = ArchitectureJoinOnInspectedRevision
  | ArchitectureJoinOnWorkflowEquivalentOnly {
      inspected: CommitSha
      observed: CommitSha
      blob: NonEmptyStr
    }
  | ArchitectureJoinRefused { cause: NonEmptyStr }

fn architecture_join_standing(c: WorkloadCandidate) -> ArchitectureJoinStanding {
  match candidate_run_identity(c: c) {
    ObservedAtInspectedRevision { repository, revision, workflow_path, job_key, matrix_selector, jobs_name_join } =>
      ArchitectureJoinOnInspectedRevision
    WorkflowEquivalentOnly { inspected, observed, blob, jobs_name_join } =>
      ArchitectureJoinOnWorkflowEquivalentOnly {
        inspected: inspected,
        observed: observed,
        blob: blob,
      }
    RunIdentityMismatched { cause } => ArchitectureJoinRefused { cause: cause }
    RunIdentityUnresolved { cause } => ArchitectureJoinRefused { cause: cause }
  }
}

fn candidate_warm_cache_count(c: WorkloadCandidate) -> Int {
  count(filter(c.caches, m => match cache_condition(m: m) {
    RemoteWarmOnFreshWorker { evidence } => true
    LogicalCold { evidence } => false
    CacheConditionUnestablished { cause } => false
  }))
}

