// PUBLIC WORKFLOW-JOB CENSUS (year_end_plan item public-workload-census).
//
// THE SUBJECT IS A JOB, NOT A REPOSITORY. Compatibility is job-scoped: an Arm image-publishing
// job proves nothing about whether a repository's build and tests run natively on Arm. Every row
// is keyed on repository + inspected commit + workflow path + job key + matrix selector.
//
// DECLARED VERSUS OBSERVED ARE DIFFERENT FACTS. A workflow file declares a runs-on value; a job
// resource may report the label that actually ran. Absence of a run is a recorded value
// (NoRunObserved), never a blank. Architecture and provider are read from
// gunbc.runner_label_resolution's vendor catalogs, never from a hyphen grammar: a label without a
// catalog row is ArmUndetermined, not x64.
//
// THIS MODULE IS A CENSUS AND A SELECTION. It does not port, benchmark, authorize a trial, or
// authorize outreach. Inspection is read-only: public workflow files (Get Repository Content at a
// pinned ref) and public job-run metadata. No maintainer was contacted. Nothing here qualifies a
// customer. Spend is unobserved on every row: a third-party label is use, not a bill.
//
// FIVE PROMOTIONS THE CARRIERS KEEP APART: an x64 catalog row is not Arm; a green job that ran no
// test is not a baseline; an unobserved cache is not warm; provider use is not verified spend;
// a census outcome does not authorize a trial.
//
// DECLARED FRONTIER (DESIGN section 3c). This module is the census: rows and selection folds
// land here. The executing consumer that *replays* a selected job is incumbent-head-to-head,
// a separate year_end_plan item blocked on runner-canary and fabric-m0. A witness that imports
// these declarations is not that consumer.

data public_workload_census_replay_consumer_frontier_rows: List<FrontierRow> = [
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.public_workload_census", decl_name: "selected_workloads"),
    reason: "the examined job population and the two-or-three complementary selection land in this change; incumbent-head-to-head is the named later consumer that replays those jobs. Nothing outside test.claim in this change drives a trial or a comparison from selected_workloads. WorkflowJobRun.labels ARE consumed here by observed_job_labels to settle observed architecture and provider against the declared readings. run_attempt is a separate consumption obligation: see public_workload_census_run_attempt_consumer_frontier_rows",
    dissolution: unbound_dissolution(description: "NAMED CONSUMER: gunbc-private strategy.year_end_plan item incumbent-head-to-head (blocked on runner-canary and fabric-m0). TRIGGER: a production func outside test.claim calls selected_workloads (or reads workload_census) to bind a replay or comparison. SUFFICIENT FOR deleting this row. NOT satisfied by a witness importing this module"),
  ),
]

data public_workload_census_run_attempt_consumer_frontier_rows: List<FrontierRow> = [
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.public_workload_census", decl_name: "observed_job_run_attempt"),
    reason: "WorkflowJobRun.labels reach observed_arm_standing (via candidate_observed_architecture) and observed_provider_standing (via candidate_observed_provider), which are compared with the declared readings. run_attempt is copied onto BaselineAdmitted.run_attempt; correctness_admitted_workloads matches only the admitted arm, and the other readers are witness binders. Copying is not the capability the retired workflow_job_run_observed_runner_frontier_rows trigger named: an OBSERVED attempt that a production fold can tell apart from attempt 1",
    dissolution: unbound_dissolution(description: "NAMED CONSUMER: gunbc-private strategy.year_end_plan item incumbent-head-to-head. TRIGGER: a production func outside test.claim matches BaselineAdmitted.run_attempt or observed_job_run_attempt to select or refuse a run attempt. SUFFICIENT FOR deleting this row. NOT satisfied by copying run_attempt onto BaselineAdmitted, nor by a witness comparing the field to 1"),
  ),
]

data public_workload_census_declared_runner_frontier_rows: List<FrontierRow> = [
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.public_workload_census", decl_name: "DeclaredRunner"),
    reason: "DeclaredRunner (DeclaredLabel | DeclaredExpression with hand-authored alternatives), inspected_yaml_job_names, and inspected_job_matrix_axes are inspection transcripts. gunbc#11270 drafts extdeps.languages.yaml.gha_workflow_read into the Actions RunnerSpec (HostedRunner, SelfHosted, RunsOnLabel, RunsOnExpression) and evaluates expressions per matrix combination. Until that lands, these rows are authored census facts, not a parse of the inspected workflow blob",
    dissolution: unbound_dissolution(description: "NAMED CONSUMER: gunbc#11270 gha_workflow_read / RunnerSpec. TRIGGER: a production fold in gunbc.public_workload_census reads RunnerSpec (or equivalent) from the inspected workflow blob instead of DeclaredRunner, inspected_yaml_job_names, and inspected_job_matrix_axes. SUFFICIENT FOR deleting DeclaredRunner, the hand-authored DeclaredExpression.alternatives, inspected_yaml_job_names, inspected_job_matrix_axes, and this row. NOT satisfied by adding more authored alternatives, YAML-name rows, or matrix-axis rows"),
  ),
]

type DeclaredRunner
  = DeclaredLabel { label: String }
  | DeclaredExpression { expression: String, alternatives: List<String> }

type DeclaredArchitectureStanding
  = DeclaredArm { via: DeclaredRunner }
  | DeclaredNotArm { via: DeclaredRunner, architecture: Architecture }
  | DeclaredArchitectureUnresolved { via: DeclaredRunner, cause: NonEmptyStr }

type DeclaredProviderStanding
  = DeclaredProviderKnown { via: DeclaredRunner, provider_module: NonEmptyStr }
  | DeclaredProviderUnresolved { via: DeclaredRunner, cause: NonEmptyStr }

fn alternative_arm_standings(
  alternatives: List<String>,
  observed_at: Rfc3339Timestamp,
) -> List<ArmStanding> {
  map(alternatives, l => arm_standing(r: resolve_runner_label(label: l, observed_at: observed_at)))
}

// DeclaredExpression.standings.first() is the nonempty probe, not the architecture. Empty
// alternatives unresolved; every standing is classified by any() over the whole list; mixed
// Arm/not-Arm unresolved; all-NotArm requires every alternative to share one catalog architecture.
fn declared_architecture_standing(
  spec: DeclaredRunner,
  observed_at: Rfc3339Timestamp,
) -> DeclaredArchitectureStanding {
  match spec {
    DeclaredLabel { label } =>
      if label == "" {
        DeclaredArchitectureUnresolved {
          via: spec,
          cause: "declared runs-on is an empty string; emptiness is not a catalog label",
        }
      } else {
        match arm_standing(r: resolve_runner_label(label: label, observed_at: observed_at)) {
          ArmConfirmed { label, snapshot } => DeclaredArm { via: spec }
          NotArmConfirmed { label, architecture, snapshot } =>
            DeclaredNotArm { via: spec, architecture: architecture }
          ArmUndetermined { label, cause } =>
            DeclaredArchitectureUnresolved { via: spec, cause: cause }
        }
      }
    DeclaredExpression { expression, alternatives } =>
      let standings = alternative_arm_standings(alternatives: alternatives, observed_at: observed_at)
      match standings.first() {
        Absent => DeclaredArchitectureUnresolved {
          via: spec,
          cause: "declared runs-on expression listed no concrete alternatives",
        }
        Present { value: first_standing } =>
          if any(standings, s => match s {
            ArmUndetermined { label, cause } => true
            ArmConfirmed { label, snapshot } => false
            NotArmConfirmed { label, architecture, snapshot } => false
          }) {
            DeclaredArchitectureUnresolved {
              via: spec,
              cause: "at least one declared alternative is absent from the surveyed runner catalogs, so architecture is not established by the workflow file alone",
            }
          } else if any(standings, s => match s {
            ArmConfirmed { label, snapshot } => true
            NotArmConfirmed { label, architecture, snapshot } => false
            ArmUndetermined { label, cause } => false
          }) && any(standings, s => match s {
            NotArmConfirmed { label, architecture, snapshot } => true
            ArmConfirmed { label, snapshot } => false
            ArmUndetermined { label, cause } => false
          }) {
            DeclaredArchitectureUnresolved {
              via: spec,
              cause: "declared alternatives mix catalog Arm and not-Arm labels; the workflow does not establish a single architecture",
            }
          } else if any(standings, s => match s {
            ArmConfirmed { label, snapshot } => true
            NotArmConfirmed { label, architecture, snapshot } => false
            ArmUndetermined { label, cause } => false
          }) {
            DeclaredArm { via: spec }
          } else {
            match first_standing {
              NotArmConfirmed { label, architecture, snapshot } =>
                if all(standings, s => match s {
                  NotArmConfirmed { label, architecture: other, snapshot } => architecture == other
                  ArmConfirmed { label, snapshot } => false
                  ArmUndetermined { label, cause } => false
                }) {
                  DeclaredNotArm { via: spec, architecture: architecture }
                } else {
                  DeclaredArchitectureUnresolved {
                    via: spec,
                    cause: "declared alternatives resolve to more than one catalog architecture, so the workflow file does not establish a single architecture",
                  }
                }
              ArmConfirmed { label, snapshot } => DeclaredArm { via: spec }
              ArmUndetermined { label, cause } =>
                DeclaredArchitectureUnresolved { via: spec, cause: cause }
            }
          }
      }
  }
}

fn alternative_provider_readings(
  alternatives: List<String>,
  observed_at: Rfc3339Timestamp,
) -> List<ProviderReading> {
  map(alternatives, l => provider_reading(r: resolve_runner_label(label: l, observed_at: observed_at)))
}

fn remaining_readings_share_catalog_provider(
  first_provider: DeclarationRef,
  readings: List<ProviderReading>,
) -> Bool {
  all(readings, r => match r {
    ProviderFromCatalog { provider, label, snapshot } =>
      declaration_ref_eq(a: provider, b: first_provider)
    ProviderUnresolved { label, cause } => false
  })
}

// DeclaredExpression.readings.first() is the nonempty probe, not the provider. Empty
// alternatives unresolved; any unresolved alternative unresolved; remaining_readings_share_catalog_provider
// refuses two catalog providers.
fn declared_provider_standing(
  spec: DeclaredRunner,
  observed_at: Rfc3339Timestamp,
) -> DeclaredProviderStanding {
  match spec {
    DeclaredLabel { label } =>
      if label == "" {
        DeclaredProviderUnresolved {
          via: spec,
          cause: "declared runs-on is an empty string; emptiness is not a catalog label",
        }
      } else {
        match provider_reading(r: resolve_runner_label(label: label, observed_at: observed_at)) {
          ProviderFromCatalog { provider, label, snapshot } =>
            DeclaredProviderKnown { via: spec, provider_module: provider.module_path as NonEmptyStr }
          ProviderUnresolved { label, cause } =>
            DeclaredProviderUnresolved { via: spec, cause: cause }
        }
      }
    DeclaredExpression { expression, alternatives } =>
      let readings = alternative_provider_readings(alternatives: alternatives, observed_at: observed_at)
      match readings.first() {
        Absent => DeclaredProviderUnresolved {
          via: spec,
          cause: "declared runs-on expression listed no concrete alternatives",
        }
        Present { value: first_reading } =>
          if any(readings, r => match r {
            ProviderUnresolved { label, cause } => true
            ProviderFromCatalog { provider, label, snapshot } => false
          }) {
            DeclaredProviderUnresolved {
              via: spec,
              cause: "at least one declared alternative is absent from the surveyed runner catalogs, so the workflow file does not establish a provider",
            }
          } else {
            match first_reading {
              ProviderFromCatalog { provider, label, snapshot } =>
                if remaining_readings_share_catalog_provider(first_provider: provider, readings: readings) {
                  DeclaredProviderKnown { via: spec, provider_module: provider.module_path as NonEmptyStr }
                } else {
                  DeclaredProviderUnresolved {
                    via: spec,
                    cause: "declared alternatives resolve to more than one surveyed provider, so the workflow file does not establish which one will run",
                  }
                }
              ProviderUnresolved { label, cause } =>
                DeclaredProviderUnresolved { via: spec, cause: cause }
            }
          }
      }
  }
}

// -------------------------------------------------------------------------------------
// OBSERVED EXECUTION. The job resource is the observation; correctness is a second reading of
// the steps, not of the conclusion name.
// -------------------------------------------------------------------------------------

type CorrectnessObservation
  = TestsExecuted { step: NonEmptyStr }
  | NoTestsExecuted { note: NonEmptyStr }

type ObservedExecution
  = NoRunObserved { obligation: NonEmptyStr }
  | JobRunObserved {
      job: WorkflowJobRun
      repository: NonEmptyStr
      workflow_path: NonEmptyStr
      workflow_blob_sha_at_head: NonEmptyStr
      head_sha: CommitSha
      correctness: CorrectnessObservation
    }

fn observed_job_labels(job: WorkflowJobRun) -> List<String> {
  job.labels
}

fn observed_job_run_attempt(job: WorkflowJobRun) -> Int {
  job.run_attempt
}

// This census is scoped to single-label runners. An empty labels list is a fact about
// the resource. Two or more labels are JobResourceCarriedMultipleLabels naming the set;
// the first element is not the observed runner.
type ObservedLabelStanding
  = ObservedLabel { label: String }
  | NoRunObservedForLabel { obligation: NonEmptyStr }
  | JobResourceCarriedNoLabels { job_id: Int }
  | JobResourceCarriedMultipleLabels { labels: List<String> }

fn observed_label_set_rendering(labels: List<String>) -> String {
  join(labels, ", ")
}

type ObservedSingleLabelOrUnresolved
  = ObservedSingleLabel { label: String }
  | ObservedLabelUnresolved { label: String, cause: NonEmptyStr }

fn observed_single_label_or_unresolved(s: ObservedLabelStanding) -> ObservedSingleLabelOrUnresolved {
  match s {
    ObservedLabel { label } => ObservedSingleLabel { label: label }
    NoRunObservedForLabel { obligation } => ObservedLabelUnresolved {
      label: "(no run)",
      cause: concat("no runner label was observed because no job run was observed: ", obligation),
    }
    JobResourceCarriedNoLabels { job_id } => ObservedLabelUnresolved {
      label: "(empty labels)",
      cause: "the job resource carried an empty labels list",
    }
    JobResourceCarriedMultipleLabels { labels } => ObservedLabelUnresolved {
      label: concat("[", concat(observed_label_set_rendering(labels: labels), "]")),
      cause: concat(
        "the job resource carried multiple labels; this census resolves a single-label runner only and does not take the first as the observed runner: ",
        observed_label_set_rendering(labels: labels),
      ),
    }
  }
}

fn observed_provider_standing(
  o: ObservedExecution,
  observed_at: Rfc3339Timestamp,
) -> ProviderReading {
  match observed_single_label_or_unresolved(s: observed_label_standing(o: o)) {
    ObservedSingleLabel { label } =>
      provider_reading(r: resolve_runner_label(label: label, observed_at: observed_at))
    ObservedLabelUnresolved { label, cause } => ProviderUnresolved {
      label: label,
      cause: cause,
    }
  }
}
fn observed_label_standing(o: ObservedExecution) -> ObservedLabelStanding {
  match o {
    NoRunObserved { obligation } => NoRunObservedForLabel { obligation: obligation }
    JobRunObserved { job, repository, workflow_path, workflow_blob_sha_at_head, head_sha, correctness } =>
      let labels = observed_job_labels(job: job)
      if count(labels) == 0 {
        JobResourceCarriedNoLabels { job_id: job.id }
      } else if count(labels) == 1 {
        ObservedLabel { label: join(labels, "") }
      } else {
        JobResourceCarriedMultipleLabels { labels: labels }
      }
  }
}

type BaselineAdmission
  = BaselineAdmitted {
      job_id: Int
      run_id: Int
      run_attempt: Int
      head_sha: CommitSha
      test_step: NonEmptyStr
      observed_label: String
    }
  | BaselineRefused { cause: NonEmptyStr }

type MatrixAxisAssignment {
  axis: NonEmptyStr
  value: NonEmptyStr
}

type JobMatrixIdentity
  = NoMatrix
  | MatrixCombination { axes: List<MatrixAxisAssignment> }

// Inspected jobs.<job_id>.name standing. AuthoredName is the YAML name prefix before
// matrix interpolation. NameUnset is an inspected-source fact that the job omitted
// `name:`, so the prefix is the job_id. A missing row is Unresolved, never a default
// to the candidate's job_key.
type InspectedYamlJobNameFact
  = AuthoredName { prefix: NonEmptyStr }
  | NameUnset

type InspectedYamlJobName {
  repository: NonEmptyStr
  workflow_path: NonEmptyStr
  job_key: NonEmptyStr
  name: InspectedYamlJobNameFact
}

type InspectedJobMatrixAxes {
  repository: NonEmptyStr
  workflow_path: NonEmptyStr
  job_key: NonEmptyStr
  axes: List<NonEmptyStr>
}

