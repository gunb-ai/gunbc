module gunbc.public_workload_census

import std.types { Bool, CommitSha, Int, List, NonEmptyStr, String }
import std.measure { HardwareThreadCount, hardware_thread_count }
import extdeps.time.rfc3339 { Rfc3339Timestamp }
import extdeps.toolchain.types { Architecture }
import extdeps.github.workflow_runs {
  WorkflowJobRun,
  WorkflowRunConclusion,
  Completed,
  Success,
  Failure,
  Cancelled,
  Neutral,
  Skipped,
  TimedOut,
  ActionRequired,
  StartupFailure,
}
import std.decl_ref { declaration_ref_eq, decl_ref }
import std.roster_frontier { FrontierRow, frontier_row_decl }
import std.dissolution { unbound_dissolution }
import gunbc.runner_label_resolution {
  resolve_runner_label,
  arm_standing,
  ArmStanding,
  ArmConfirmed,
  NotArmConfirmed,
  ArmUndetermined,
  provider_reading,
  ProviderReading,
  ProviderFromCatalog,
  ProviderUnresolved,
}

// PUBLIC WORKFLOW-JOB CENSUS (year_end_plan item public-workload-census).
//
// THE SUBJECT IS A JOB, NOT A REPOSITORY. Compatibility is job-scoped: an Arm image-publishing
// job proves nothing about whether a repository's build and tests run natively on Arm. Every row
// is keyed on repository + inspected commit + workflow path + job key + matrix selector.
//
// DECLARED VERSUS OBSERVED ARE DIFFERENT FACTS. A workflow file declares a runs-on value; a job
// resource may report the label that actually ran. Absence of a run is a recorded value
// (NoRunObserved), never a blank. Architecture and provider are read from
// gunbc.runner_label_resolution's vendor catalogs, never from a hyphen grammar: a label without a
// catalog row is ArmUndetermined, not x64.
//
// THIS MODULE IS A CENSUS AND A SELECTION. It does not port, benchmark, authorize a trial, or
// authorize outreach. Spend is unobserved on every row: a third-party label is use, not a bill.
//
// FIVE PROMOTIONS THE CARRIERS KEEP APART: an x64 catalog row is not Arm; a green job that ran no
// test is not a baseline; an unobserved cache is not warm; provider use is not verified spend;
// a census outcome does not authorize a trial.
//
// DECLARED FRONTIER (DESIGN section 3c). This module is the census: rows and selection folds
// land here. The executing consumer that *replays* a selected job is incumbent-head-to-head,
// a separate year_end_plan item blocked on runner-canary and fabric-m0. A witness that imports
// these declarations is not that consumer.

data public_workload_census_replay_consumer_frontier_rows: List<FrontierRow> = [
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.public_workload_census", decl_name: "selected_workloads"),
    reason: "the examined job population and the two-or-three complementary selection land in this change; incumbent-head-to-head is the named later consumer that replays those jobs. Nothing outside test.claim in this change drives a trial or a comparison from selected_workloads. WorkflowJobRun.labels and run_attempt ARE consumed here by observed_job_labels and observed_job_run_attempt — that is production reading of the GitHub job resource, not a reason to pretend the census itself already has a replay caller",
    dissolution: unbound_dissolution(description: "NAMED CONSUMER: gunbc-private strategy.year_end_plan item incumbent-head-to-head (blocked on runner-canary and fabric-m0). TRIGGER: a production func outside test.claim calls selected_workloads (or reads workload_census) to bind a replay or comparison. SUFFICIENT FOR deleting this row. NOT satisfied by a witness importing this module"),
  ),
]

type DeclaredRunner
  = DeclaredLabel { label: String }
  | DeclaredExpression { expression: String, alternatives: List<String> }

type DeclaredArchitectureStanding
  = DeclaredArm { via: DeclaredRunner }
  | DeclaredNotArm { via: DeclaredRunner, architecture: Architecture }
  | DeclaredArchitectureUnresolved { via: DeclaredRunner, cause: NonEmptyStr }

type DeclaredProviderStanding
  = DeclaredProviderKnown { via: DeclaredRunner, provider_module: NonEmptyStr }
  | DeclaredProviderUnresolved { via: DeclaredRunner, cause: NonEmptyStr }

fn alternative_arm_standings(
  alternatives: List<String>,
  observed_at: Rfc3339Timestamp,
) -> List<ArmStanding> {
  map(alternatives, l => arm_standing(r: resolve_runner_label(label: l, observed_at: observed_at)))
}

fn arm_standing_is_undetermined(s: ArmStanding) -> Bool {
  match s {
    ArmUndetermined { label, cause } => true
    ArmConfirmed { label, snapshot } => false
    NotArmConfirmed { label, architecture, snapshot } => false
  }
}

fn arm_standing_is_arm(s: ArmStanding) -> Bool {
  match s {
    ArmConfirmed { label, snapshot } => true
    NotArmConfirmed { label, architecture, snapshot } => false
    ArmUndetermined { label, cause } => false
  }
}

fn arm_standing_is_not_arm(s: ArmStanding) -> Bool {
  match s {
    NotArmConfirmed { label, architecture, snapshot } => true
    ArmConfirmed { label, snapshot } => false
    ArmUndetermined { label, cause } => false
  }
}

fn declared_architecture_standing(
  spec: DeclaredRunner,
  observed_at: Rfc3339Timestamp,
) -> DeclaredArchitectureStanding {
  match spec {
    DeclaredLabel { label } =>
      match arm_standing(r: resolve_runner_label(label: label, observed_at: observed_at)) {
        ArmConfirmed { label, snapshot } => DeclaredArm { via: spec }
        NotArmConfirmed { label, architecture, snapshot } =>
          DeclaredNotArm { via: spec, architecture: architecture }
        ArmUndetermined { label, cause } =>
          DeclaredArchitectureUnresolved { via: spec, cause: cause }
      }
    DeclaredExpression { expression, alternatives } =>
      if count(alternatives) == 0 {
        DeclaredArchitectureUnresolved {
          via: spec,
          cause: "declared runs-on expression listed no concrete alternatives",
        }
      } else {
        let standings = alternative_arm_standings(alternatives: alternatives, observed_at: observed_at)
        if any(standings, s => arm_standing_is_undetermined(s: s)) {
          DeclaredArchitectureUnresolved {
            via: spec,
            cause: "at least one declared alternative is absent from the surveyed runner catalogs, so architecture is not established by the workflow file alone",
          }
        } else if any(standings, s => arm_standing_is_arm(s: s)) && any(standings, s => arm_standing_is_not_arm(s: s)) {
          DeclaredArchitectureUnresolved {
            via: spec,
            cause: "declared alternatives mix catalog Arm and not-Arm labels; the workflow does not establish a single architecture",
          }
        } else if any(standings, s => arm_standing_is_arm(s: s)) {
          DeclaredArm { via: spec }
        } else {
          match standings.first() {
            Present { value: standing } => match standing {
              NotArmConfirmed { label, architecture, snapshot } =>
                DeclaredNotArm { via: spec, architecture: architecture }
              ArmConfirmed { label, snapshot } => DeclaredArm { via: spec }
              ArmUndetermined { label, cause } =>
                DeclaredArchitectureUnresolved { via: spec, cause: cause }
            }
            Absent => DeclaredArchitectureUnresolved {
              via: spec,
              cause: "declared alternatives were nonempty by count but first() was absent",
            }
          }
        }
      }
  }
}

fn alternative_provider_readings(
  alternatives: List<String>,
  observed_at: Rfc3339Timestamp,
) -> List<ProviderReading> {
  map(alternatives, l => provider_reading(r: resolve_runner_label(label: l, observed_at: observed_at)))
}

fn provider_reading_is_unresolved(r: ProviderReading) -> Bool {
  match r {
    ProviderUnresolved { label, cause } => true
    ProviderFromCatalog { provider, label, snapshot } => false
  }
}

fn provider_readings_share_one_catalog_provider(readings: List<ProviderReading>) -> Bool {
  if count(readings) == 0 {
    false
  } else {
    match readings.first() {
      Present { value: first_reading } => match first_reading {
        ProviderUnresolved { label, cause } => false
        ProviderFromCatalog { provider: first_provider, label, snapshot } =>
          all(readings, r => match r {
            ProviderFromCatalog { provider, label, snapshot } =>
              declaration_ref_eq(a: provider, b: first_provider)
            ProviderUnresolved { label, cause } => false
          })
      }
      Absent => false
    }
  }
}

fn declared_provider_standing(
  spec: DeclaredRunner,
  observed_at: Rfc3339Timestamp,
) -> DeclaredProviderStanding {
  match spec {
    DeclaredLabel { label } =>
      match provider_reading(r: resolve_runner_label(label: label, observed_at: observed_at)) {
        ProviderFromCatalog { provider, label, snapshot } =>
          DeclaredProviderKnown { via: spec, provider_module: provider.module_path as NonEmptyStr }
        ProviderUnresolved { label, cause } =>
          DeclaredProviderUnresolved { via: spec, cause: cause }
      }
    DeclaredExpression { expression, alternatives } =>
      if count(alternatives) == 0 {
        DeclaredProviderUnresolved {
          via: spec,
          cause: "declared runs-on expression listed no concrete alternatives",
        }
      } else {
        let readings = alternative_provider_readings(alternatives: alternatives, observed_at: observed_at)
        if any(readings, r => provider_reading_is_unresolved(r: r)) {
          DeclaredProviderUnresolved {
            via: spec,
            cause: "at least one declared alternative is absent from the surveyed runner catalogs, so the workflow file does not establish a provider",
          }
        } else if provider_readings_share_one_catalog_provider(readings: readings) {
          match readings.first() {
            Present { value: first_reading } => match first_reading {
              ProviderFromCatalog { provider, label, snapshot } =>
                DeclaredProviderKnown { via: spec, provider_module: provider.module_path as NonEmptyStr }
              ProviderUnresolved { label, cause } =>
                DeclaredProviderUnresolved { via: spec, cause: cause }
            }
            Absent => DeclaredProviderUnresolved {
              via: spec,
              cause: "declared alternatives were nonempty by count but first() was absent",
            }
          }
        } else {
          DeclaredProviderUnresolved {
            via: spec,
            cause: "declared alternatives resolve to more than one surveyed provider, so the workflow file does not establish which one will run",
          }
        }
      }
  }
}

// -------------------------------------------------------------------------------------
// OBSERVED EXECUTION. The job resource is the observation; correctness is a second reading of
// the steps, not of the conclusion name.
// -------------------------------------------------------------------------------------

type CorrectnessObservation
  = TestsExecuted { step: NonEmptyStr }
  | NoTestsExecuted { note: NonEmptyStr }

type ObservedExecution
  = NoRunObserved { obligation: NonEmptyStr }
  | JobRunObserved {
      job: WorkflowJobRun
      head_sha: CommitSha
      correctness: CorrectnessObservation
    }

fn observed_job_labels(job: WorkflowJobRun) -> List<String> {
  job.labels
}

fn observed_job_run_attempt(job: WorkflowJobRun) -> Int {
  job.run_attempt
}

type ObservedLabelStanding
  = ObservedLabel { label: String }
  | NoRunObservedForLabel { obligation: NonEmptyStr }
  | JobResourceCarriedNoLabels { job_id: Int }

fn observed_label_standing(o: ObservedExecution) -> ObservedLabelStanding {
  match o {
    NoRunObserved { obligation } => NoRunObservedForLabel { obligation: obligation }
    JobRunObserved { job, head_sha, correctness } =>
      fold(observed_job_labels(job: job), init: JobResourceCarriedNoLabels { job_id: job.id }, f: fn(acc, l) {
        match acc {
          JobResourceCarriedNoLabels { job_id } => ObservedLabel { label: l }
          ObservedLabel { label } => acc
          NoRunObservedForLabel { obligation } => acc
        }
      })
  }
}

fn observed_provider_standing(
  o: ObservedExecution,
  observed_at: Rfc3339Timestamp,
) -> ProviderReading {
  match observed_label_standing(o: o) {
    ObservedLabel { label } =>
      provider_reading(r: resolve_runner_label(label: label, observed_at: observed_at))
    NoRunObservedForLabel { obligation } => ProviderUnresolved {
      label: "(no run)",
      cause: concat("no runner label was observed because no job run was observed: ", obligation),
    }
    JobResourceCarriedNoLabels { job_id } => ProviderUnresolved {
      label: "(empty labels)",
      cause: "the job resource carried an empty labels list",
    }
  }
}

fn conclusion_is_success(c: WorkflowRunConclusion?) -> Bool {
  match c {
    Present { value: conclusion } => match conclusion {
      Success => true
      Failure => false
      Cancelled => false
      Neutral => false
      Skipped => false
      TimedOut => false
      ActionRequired => false
      StartupFailure => false
    }
    Absent => false
  }
}

type BaselineAdmission
  = BaselineAdmitted {
      job_id: Int
      run_id: Int
      run_attempt: Int
      head_sha: CommitSha
      test_step: NonEmptyStr
      observed_label: String
    }
  | BaselineRefused { cause: NonEmptyStr }

fn baseline_admission(o: ObservedExecution) -> BaselineAdmission {
  match o {
    NoRunObserved { obligation } =>
      BaselineRefused { cause: concat("no run observed: ", obligation) }
    JobRunObserved { job, head_sha, correctness } =>
      if conclusion_is_success(c: job.conclusion) == false {
        BaselineRefused {
          cause: "the observed job did not conclude success; a failed, cancelled or unconcluded job is not a baseline",
        }
      } else {
        match correctness {
          TestsExecuted { step } => match observed_label_standing(o: o) {
            ObservedLabel { label } => BaselineAdmitted {
              job_id: job.id,
              run_id: job.run_id,
              run_attempt: observed_job_run_attempt(job: job),
              head_sha: head_sha,
              test_step: step,
              observed_label: label,
            }
            NoRunObservedForLabel { obligation } => BaselineRefused {
              cause: concat("no run observed: ", obligation),
            }
            JobResourceCarriedNoLabels { job_id } => BaselineRefused {
              cause: "the observed job concluded success and ran tests, but the job resource carried no runner labels",
            }
          }
          NoTestsExecuted { note } =>
            BaselineRefused { cause: concat("job succeeded but executed no correctness check: ", note) }
        }
      }
  }
}

fn baseline_is_admitted(b: BaselineAdmission) -> Bool {
  match b {
    BaselineAdmitted { job_id, run_id, run_attempt, head_sha, test_step, observed_label } => true
    BaselineRefused { cause } => false
  }
}

fn observed_arm_standing(o: ObservedExecution, observed_at: Rfc3339Timestamp) -> ArmStanding {
  match observed_label_standing(o: o) {
    ObservedLabel { label } =>
      arm_standing(r: resolve_runner_label(label: label, observed_at: observed_at))
    NoRunObservedForLabel { obligation } => ArmUndetermined {
      label: "(no run)",
      cause: concat("no runner label was observed because no job run was observed: ", obligation),
    }
    JobResourceCarriedNoLabels { job_id } => ArmUndetermined {
      label: "(empty labels)",
      cause: "the job resource carried an empty labels list",
    }
  }
}

// -------------------------------------------------------------------------------------
// CACHE: reading YAML is not observing hit or miss.
// -------------------------------------------------------------------------------------

type CacheObservation
  = CacheUnobserved { obligation: NonEmptyStr }
  | CacheMissConfirmed { evidence: NonEmptyStr }
  | CacheHitConfirmed { evidence: NonEmptyStr }

type CacheMechanism {
  name: NonEmptyStr
  layer: NonEmptyStr
  observation: CacheObservation
}

type CacheCondition
  = LogicalCold { evidence: NonEmptyStr }
  | RemoteWarmOnFreshWorker { evidence: NonEmptyStr }
  | CacheConditionUnestablished { cause: NonEmptyStr }

fn cache_condition(m: CacheMechanism) -> CacheCondition {
  match m.observation {
    CacheHitConfirmed { evidence } => RemoteWarmOnFreshWorker { evidence: evidence }
    CacheMissConfirmed { evidence } => LogicalCold { evidence: evidence }
    CacheUnobserved { obligation } => CacheConditionUnestablished {
      cause: concat(m.name, concat(" was declared in the workflow and never observed: ", obligation)),
    }
  }
}

fn cache_condition_is_warm(c: CacheCondition) -> Bool {
  match c {
    RemoteWarmOnFreshWorker { evidence } => true
    LogicalCold { evidence } => false
    CacheConditionUnestablished { cause } => false
  }
}

data cache_read_obligation: NonEmptyStr = "this census read workflow YAML and the job-run resource (labels, conclusion, step names); no cache log line was read, so hit or miss is unobserved"

// -------------------------------------------------------------------------------------
// EXTERNAL EFFECTS. Registry pushes and cloud role assumption come out of BOTH replay
// realizations. An artifact upload inside the same run is retained and timed.
// -------------------------------------------------------------------------------------

type ExternalEffectKind
  = RegistryPush { registry: NonEmptyStr }
  | CloudRoleAssumption { role: NonEmptyStr }
  | CoverageUpload { service: NonEmptyStr }
  | WorkflowArtifactUpload { artifact: NonEmptyStr }

type EffectDisposition
  = RemovedFromBothRealizations { cause: NonEmptyStr }
  | RetainedAndTimed { cause: NonEmptyStr }

type ExternalEffect {
  kind: ExternalEffectKind
  step: NonEmptyStr
  disposition: EffectDisposition
}

fn effect_requires_removal(k: ExternalEffectKind) -> Bool {
  match k {
    RegistryPush { registry } => true
    CloudRoleAssumption { role } => true
    CoverageUpload { service } => true
    WorkflowArtifactUpload { artifact } => false
  }
}

fn effect_is_removed(e: ExternalEffect) -> Bool {
  match e.disposition {
    RemovedFromBothRealizations { cause } => true
    RetainedAndTimed { cause } => false
  }
}

fn effect_disposition_is_sound(e: ExternalEffect) -> Bool {
  effect_requires_removal(k: e.kind) == effect_is_removed(e: e)
}

type ReplayAdmission
  = ReplayAdmitted { note: NonEmptyStr }
  | ReplayRefusedLicense { cause: NonEmptyStr }
  | ReplayRefusedArchitecture { cause: NonEmptyStr }
  | ReplayRefusedWorkload { cause: NonEmptyStr }

data replay_derivation_note: NonEmptyStr = "public visibility is not a licence; source SPDX was read from GitHub's license API. External mutations named on the row are removed from both realizations, so a replay is a derived build/test (or build-only) contract, not an execution of the published pipeline"

type SpendStanding
  = SpendUnobserved { obligation: NonEmptyStr }

data spend_unobserved_note: NonEmptyStr = "a runner label establishes provider USE, not spend; no customer bill was observed, and this census does not treat GitHub-hosted public minutes as a measured zero"

type TrialAuthorization
  = TrialUnauthorized { cause: NonEmptyStr }

data trial_refusal_note: NonEmptyStr = "a census is not a mandate: nothing in this item authorizes a trial, a migration PR, or outreach"

fn trial_authorization_from_census() -> TrialAuthorization {
  TrialUnauthorized { cause: trial_refusal_note }
}

type ResourceRequirements
  = ResourceRequirementsObserved {
      hardware_threads: HardwareThreadCount
      uses_container: Bool
    }
  | ResourceRequirementsUnobserved { obligation: NonEmptyStr }

type CandidateSelection
  = SelectedWorkload { rank: Int, complementarity: NonEmptyStr }
  | CandidateRejected { reason: NonEmptyStr }
  | CandidateUnresolved { obligation: NonEmptyStr }

type WorkloadCandidate {
  repository: NonEmptyStr
  license_spdx: NonEmptyStr
  inspected_commit: CommitSha
  workflow_path: NonEmptyStr
  workflow_blob_sha: NonEmptyStr
  job_key: NonEmptyStr
  job_display_name: NonEmptyStr
  matrix_selector: NonEmptyStr
  declared_runner: DeclaredRunner
  observed: ObservedExecution
  observation_time: Rfc3339Timestamp
  workload_commands: List<NonEmptyStr>
  resource_requirements: ResourceRequirements
  caches: List<CacheMechanism>
  external_effects: List<ExternalEffect>
  replay: ReplayAdmission
  spend: SpendStanding
  trial: TrialAuthorization
  selection: CandidateSelection
}

fn candidate_declared_architecture(c: WorkloadCandidate) -> DeclaredArchitectureStanding {
  declared_architecture_standing(spec: c.declared_runner, observed_at: c.observation_time)
}

fn candidate_declared_provider(c: WorkloadCandidate) -> DeclaredProviderStanding {
  declared_provider_standing(spec: c.declared_runner, observed_at: c.observation_time)
}

fn candidate_observed_provider(c: WorkloadCandidate) -> ProviderReading {
  observed_provider_standing(o: c.observed, observed_at: c.observation_time)
}

fn candidate_baseline(c: WorkloadCandidate) -> BaselineAdmission {
  baseline_admission(o: c.observed)
}

fn candidate_is_selected(c: WorkloadCandidate) -> Bool {
  match c.selection {
    SelectedWorkload { rank, complementarity } => true
    CandidateRejected { reason } => false
    CandidateUnresolved { obligation } => false
  }
}

fn candidate_effects_are_sound(c: WorkloadCandidate) -> Bool {
  all(c.external_effects, e => effect_disposition_is_sound(e: e))
}

fn candidate_warm_cache_count(c: WorkloadCandidate) -> Int {
  count(filter(c.caches, m => cache_condition_is_warm(c: cache_condition(m: m))))
}

fn observed_job_attempt(o: ObservedExecution) -> Int? {
  match o {
    JobRunObserved { job, head_sha, correctness } => Present { value: observed_job_run_attempt(job: job) }
    NoRunObserved { obligation } => Absent
  }
}

fn baseline_attempt(b: BaselineAdmission) -> Int? {
  match b {
    BaselineAdmitted { job_id, run_id, run_attempt, head_sha, test_step, observed_label } =>
      Present { value: run_attempt }
    BaselineRefused { cause } => Absent
  }
}

fn baseline_attempt_matches_observed_job(c: WorkloadCandidate) -> Bool {
  match observed_job_attempt(o: c.observed) {
    Present { value: job_attempt } => match baseline_attempt(b: candidate_baseline(c: c)) {
      Present { value: admitted_attempt } => job_attempt == admitted_attempt
      Absent => false
    }
    Absent => false
  }
}

