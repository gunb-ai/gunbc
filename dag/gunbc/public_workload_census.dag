  candidate_biome_test,
  candidate_pdns_dnsdist_arm,
  candidate_openobserve_arm_build,
  candidate_openobserve_amd64,
  candidate_openobserve_manifest,
  candidate_biome_test_windows,
  candidate_biome_test_macos,
  candidate_openobserve_summary,
]

fn census_contains_subject(rows: List<WorkloadCandidate>, needle: WorkloadCandidate) -> Bool {
  count(filter(rows, r =>
    (r.repository as String) == (needle.repository as String)
      && (r.job_key as String) == (needle.job_key as String)
      && (r.workflow_path as String) == (needle.workflow_path as String)
      && r.inspected_commit == needle.inspected_commit
      && r.matrix_selector == needle.matrix_selector
      && (r.workflow_blob_sha as String) == (needle.workflow_blob_sha as String)
      && match r.observed {
        JobRunObserved { job: rj, repository: r_repo, workflow_path: r_path, workflow_blob_sha_at_head: rb, head_sha: rh, correctness: r_corr } =>
          match needle.observed {
            JobRunObserved { job: nj, repository: n_repo, workflow_path: n_path, workflow_blob_sha_at_head: nb, head_sha: nh, correctness: n_corr } =>
              (rb as String) == (nb as String) && rh == nh && rj.id == nj.id
            NoRunObserved { obligation } => false
          }
        NoRunObserved { obligation: a } => match needle.observed {
          NoRunObserved { obligation: b } => a == b
          JobRunObserved { job, repository, workflow_path, workflow_blob_sha_at_head, head_sha, correctness } => false
        }
      }
  )) == 1
}

fn selected_workloads() -> List<WorkloadCandidate> {
  filter(workload_census, c => match c.selection {
    SelectedWorkload { rank, complementarity } => match candidate_run_identity(c: c) {
      ObservedAtInspectedRevision { repository, revision, workflow_path, job_key, matrix_selector, jobs_name_join } => true
      WorkflowEquivalentOnly { inspected, observed, blob, jobs_name_join } => true
      RunIdentityMismatched { cause } => false
      RunIdentityUnresolved { cause } => false
    }
    CandidateRejected { reason } => false
    CandidateUnresolved { obligation } => false
  })
}

fn correctness_admitted_workloads() -> List<WorkloadCandidate> {
  filter(selected_workloads(), c => match baseline_admission(c: c) {
    BaselineAdmitted { job_id, run_id, run_attempt, head_sha, test_step, observed_label } => true
    BaselineRefused { cause } => false
  })
}

fn rejected_candidates() -> List<WorkloadCandidate> {
  filter(workload_census, c => match c.selection {
    CandidateRejected { reason } => true
    SelectedWorkload { rank, complementarity } => false
    CandidateUnresolved { obligation } => false
  })
}

fn unresolved_candidates() -> List<WorkloadCandidate> {
  filter(workload_census, c => match c.selection {
    CandidateUnresolved { obligation } => true
    SelectedWorkload { rank, complementarity } => false
    CandidateRejected { reason } => false
  })
}
