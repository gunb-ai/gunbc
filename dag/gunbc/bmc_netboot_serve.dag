module gunbc.bmc_netboot_serve

import std.types { NonEmptyStr, String, Int, List }
import extdeps.uri { Uri, Http, Https, uri_wire }
import extdeps.os.ubuntu_autoinstall { UbuntuAutoinstallPayload }
import extdeps.bootloader.grub { GrubConfig, GrubMenuEntry, grub_config_render }
import extdeps.firmware.kernel_cmdline { KernelCmdlineArg, KernelFlag, KernelKeyValue }
import extdeps.firmware.uefi_http_boot { UefiHttpBootEntry }
import extdeps.tools.busybox { busybox_cli_tool, busybox_httpd_command }
import extdeps.exec.command {
  ShellCommand,
  CommandTransport,
  LocalShell,
  SshExec,
  command_over_transport,
  shell_command_render,
}
import extdeps.shell
import extdeps.bmc.ssh
import extdeps.filesystem.filesystem_io { Filesystem }
import gunbc.shell_bash_runner { shell_exec_via_bash }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.resources { Network }
import gunbc.os_install { srv4_ubuntu_autoinstall_on_iso }
import gunbc.os_install_emit { autoinstall_user_data }

type BmcNetbootServePlan {
  bmc_host: NonEmptyStr
  serve_port: Int
  netboot_dir: NonEmptyStr
  boot_interface: NonEmptyStr
  bulk_iso_url: Uri
  autoinstall: UbuntuAutoinstallPayload
}

data srv4_bmc_netboot_serve_plan: BmcNetbootServePlan = BmcNetbootServePlan {
  bmc_host: "192.168.1.195",
  serve_port: 8080,
  netboot_dir: "/tmp/netboot",
  boot_interface: "eth0",
  bulk_iso_url: Uri {
    scheme: Https,
    locator: "cdimage.ubuntu.com/ubuntu/releases/24.04/release/ubuntu-24.04.3-live-server-arm64.iso",
  },
  autoinstall: srv4_ubuntu_autoinstall_on_iso,
}

fn bmc_netboot_host_port(plan: BmcNetbootServePlan) -> NonEmptyStr {
  join([plan.bmc_host as String, ":", to_string(plan.serve_port)], "") as NonEmptyStr
}

fn bmc_netboot_uri(plan: BmcNetbootServePlan, path: NonEmptyStr) -> Uri {
  Uri {
    scheme: Http,
    locator: join([bmc_netboot_host_port(plan: plan) as String, path as String], "") as NonEmptyStr,
  }
}

fn bmc_netboot_seed_datasource(plan: BmcNetbootServePlan) -> String {
  join(["nocloud-net;s=", uri_wire(uri: bmc_netboot_uri(plan: plan, path: "/nocloud/"))], "")
}

fn bmc_netboot_kernel_cmdline(plan: BmcNetbootServePlan) -> List<KernelCmdlineArg> {
  [
    KernelKeyValue { key: "ip", value: "dhcp" },
    KernelKeyValue { key: "url", value: uri_wire(uri: plan.bulk_iso_url) },
    KernelFlag { name: "autoinstall" },
    KernelKeyValue { key: "ds", value: bmc_netboot_seed_datasource(plan: plan) },
    KernelFlag { name: "---" },
  ]
}

fn bmc_netboot_grub_config(plan: BmcNetbootServePlan) -> GrubConfig {
  GrubConfig {
    timeout_seconds: 1,
    default_entry: 0,
    entries: [
      GrubMenuEntry {
        title: "gunbc netboot install",
        linux_image: "/vmlinuz",
        linux_cmdline: bmc_netboot_kernel_cmdline(plan: plan),
        initrd_image: "/initrd",
      },
    ],
  }
}

fn bmc_netboot_grub_cfg_text(plan: BmcNetbootServePlan) -> String {
  grub_config_render(cfg: bmc_netboot_grub_config(plan: plan))
}

fn bmc_netboot_http_boot_entry(plan: BmcNetbootServePlan) -> UefiHttpBootEntry {
  UefiHttpBootEntry {
    description: "gunbc-bmc-netboot",
    boot_file_uri: bmc_netboot_uri(plan: plan, path: "/grubaa64.efi"),
    interface_name: plan.boot_interface,
  }
}

fn bmc_netboot_nocloud_user_data(plan: BmcNetbootServePlan) -> String {
  autoinstall_user_data(payload: plan.autoinstall)
}

fn bmc_transport(plan: BmcNetbootServePlan) -> CommandTransport {
  SshExec { ssh_target: join(["root@", plan.bmc_host as String], "") as NonEmptyStr }
}

fn bmc_netboot_serve_command_local(plan: BmcNetbootServePlan) -> ShellCommand {
  busybox_httpd_command(document_root: plan.netboot_dir, port: plan.serve_port)
}

fn bmc_netboot_serve_command(plan: BmcNetbootServePlan) -> ShellCommand {
  command_over_transport(
    command: bmc_netboot_serve_command_local(plan: plan),
    transport: bmc_transport(plan: plan),
  )
}

fn bmc_netboot_serve_command_text(plan: BmcNetbootServePlan) -> String {
  shell_command_render(command: bmc_netboot_serve_command(plan: plan))
}

fn bmc_ssh_target(plan: BmcNetbootServePlan) -> NonEmptyStr {
  join(["root@", plan.bmc_host as String], "") as NonEmptyStr
}

fn bmc_remote_target(plan: BmcNetbootServePlan, name: NonEmptyStr) -> NonEmptyStr {
  join([bmc_ssh_target(plan: plan) as String, ":", bmc_netboot_staged_path(plan: plan, name: name) as String], "") as NonEmptyStr
}

data bmc_netboot_provision_dissolution_trigger: String = "🟡 dissolve-on: bmc_netboot_provision — realization driver sequences the staging manifest + serve over shell.Exec.Run / bmc.Ssh.PutFile / Filesystem.Write; the BMC commands go through the extdeps.exec.command seam (no bespoke blob) but the per-file sequencing is hand-unrolled for the known plan. DISSOLVES WHEN a host_effect_apply binds the staging manifest fold generically; retire medium_structure_exception_roster entry for dag/gunbc/bmc_netboot_serve.dag"

func bmc_netboot_run_bmc(plan: BmcNetbootServePlan, argv: List<String>) -> ProcessExit
  uses net: Network
{
  let cmd = command_over_transport(command: ShellCommand { argv: argv }, transport: bmc_transport(plan: plan))
  let run = shell.Exec.Run(script: shell_exec_via_bash(body: shell_command_render(command: cmd)))
  if run.success { ExitSuccess } else { exit_failure(reason: concat("bmc-netboot: ", run.stderr)) }
}

func bmc_netboot_put(plan: BmcNetbootServePlan, local: NonEmptyStr, name: NonEmptyStr) -> ProcessExit
  uses net: Network
{
  let put = bmc.Ssh.PutFile(local_path: local, remote_target: bmc_remote_target(plan: plan, name: name))
  if put.success { ExitSuccess } else { exit_failure(reason: concat("bmc-netboot: scp failed for ", name as String)) }
}

func bmc_netboot_put_inline(plan: BmcNetbootServePlan, local: NonEmptyStr, content: String, name: NonEmptyStr) -> ProcessExit
  uses net: Network
{
  let w = Filesystem.Write(path: local as String, content: content)
  if w.success == false {
    return exit_failure(reason: concat("bmc-netboot: local write failed for ", name as String))
  }
  return bmc_netboot_put(plan: plan, local: local, name: name)
}

fn process_exit_first_failure(results: List<ProcessExit>) -> ProcessExit {
  fold(
    results,
    init: ExitSuccess,
    f: (acc, r) => match acc {
      ExitFailure { code: _, reason: _ } => acc
      ExitSuccess => r
    }
  )
}

func bmc_netboot_provision(plan: BmcNetbootServePlan) -> ProcessExit
  uses net: Network
{
  let mk = bmc_netboot_run_bmc(plan: plan, argv: ["mkdir", "-p", join([plan.netboot_dir as String, "/nocloud"], "")])
  let a1 = bmc_netboot_put(plan: plan, local: bmc_netboot_artifact(name: "busybox"), name: "busybox")
  let a2 = bmc_netboot_put(plan: plan, local: bmc_netboot_artifact(name: "vmlinuz"), name: "vmlinuz")
  let a3 = bmc_netboot_put(plan: plan, local: bmc_netboot_artifact(name: "initrd"), name: "initrd")
  let a4 = bmc_netboot_put(plan: plan, local: bmc_netboot_artifact(name: "grubaa64.efi"), name: "grubaa64.efi")
  let g = bmc_netboot_put_inline(plan: plan, local: "/tmp/gunbc-bmc-grub.cfg", content: bmc_netboot_grub_cfg_text(plan: plan), name: "grub.cfg")
  let ud = bmc_netboot_put_inline(plan: plan, local: "/tmp/gunbc-bmc-user-data", content: bmc_netboot_nocloud_user_data(plan: plan), name: "nocloud/user-data")
  let md = bmc_netboot_put_inline(plan: plan, local: "/tmp/gunbc-bmc-meta-data", content: join(["instance-id: ", plan.autoinstall.identity.hostname as String], ""), name: "nocloud/meta-data")
  let serve = bmc_netboot_run_bmc(plan: plan, argv: ["busybox", "httpd", "-p", to_string(plan.serve_port), "-h", plan.netboot_dir as String])
  process_exit_first_failure(results: [mk, a1, a2, a3, a4, g, ud, md, serve])
}

func srv4_bmc_netboot_provision() -> ProcessExit
  uses net: Network
{
  bmc_netboot_provision(plan: srv4_bmc_netboot_serve_plan)
}

data bmc_netboot_bootstrap_artifact_dir: NonEmptyStr = "/var/lib/gunbc/artifacts/netboot"

type StagedContentSource
  = InlineText { text: String }
  | LocalArtifact { path: NonEmptyStr }
  | FetchFromUri { source: Uri }

type BmcStagedFile {
  remote_path: NonEmptyStr
  content: StagedContentSource
}

fn bmc_netboot_artifact(name: NonEmptyStr) -> NonEmptyStr {
  join([bmc_netboot_bootstrap_artifact_dir as String, "/", name as String], "") as NonEmptyStr
}

fn bmc_netboot_staged_path(plan: BmcNetbootServePlan, name: NonEmptyStr) -> NonEmptyStr {
  join([plan.netboot_dir as String, "/", name as String], "") as NonEmptyStr
}

fn bmc_netboot_staging_manifest(plan: BmcNetbootServePlan) -> List<BmcStagedFile> {
  [
    BmcStagedFile {
      remote_path: bmc_netboot_staged_path(plan: plan, name: "busybox"),
      content: LocalArtifact { path: bmc_netboot_artifact(name: "busybox") },
    },
    BmcStagedFile {
      remote_path: bmc_netboot_staged_path(plan: plan, name: "vmlinuz"),
      content: LocalArtifact { path: bmc_netboot_artifact(name: "vmlinuz") },
    },
    BmcStagedFile {
      remote_path: bmc_netboot_staged_path(plan: plan, name: "initrd"),
      content: LocalArtifact { path: bmc_netboot_artifact(name: "initrd") },
    },
    BmcStagedFile {
      remote_path: bmc_netboot_staged_path(plan: plan, name: "grubaa64.efi"),
      content: LocalArtifact { path: bmc_netboot_artifact(name: "grubaa64.efi") },
    },
    BmcStagedFile {
      remote_path: bmc_netboot_staged_path(plan: plan, name: "grub.cfg"),
      content: InlineText { text: bmc_netboot_grub_cfg_text(plan: plan) },
    },
    BmcStagedFile {
      remote_path: bmc_netboot_staged_path(plan: plan, name: "nocloud/user-data"),
      content: InlineText { text: bmc_netboot_nocloud_user_data(plan: plan) },
    },
    BmcStagedFile {
      remote_path: bmc_netboot_staged_path(plan: plan, name: "nocloud/meta-data"),
      content: InlineText { text: join(["instance-id: ", plan.autoinstall.identity.hostname as String], "") },
    },
  ]
}
