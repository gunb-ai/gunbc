module gunbc.network_identity_subsumption


data gunbc_network_identity_subsumption_scope_disposition: std.disposition.Disposition = std.disposition.Terminal {
  reason: "Slice-1 network-identity subsumption: DHCP option-12 dynamic lease client_hostname short label must subsume fleet_intent HostIdentity slot — discriminates BMC static reservation labels (operator-typed) from OS self-report (option-12). Pre-install: no dynamic row subsumes srv3; post-install: dynamic row with hostname srv3 subsumes operator_host_srv3."
}

data srv3_os_lan_mac_dissolution_trigger: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: std.disposition.SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.network_identity_subsumption",
    decl_name: "srv3_os_up_dynamic_lease_row",
    field: std.decl_ref.WholeDeclaration
  }
}

data srv3_os_lan_ipv4_dissolution_trigger: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: std.disposition.SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.network_identity_subsumption",
    decl_name: "srv3_os_up_dynamic_lease_row",
    field: std.decl_ref.WholeDeclaration
  }
}

data srv3_fleet_slot_host_name: extdeps.dns.domain_name.HostName = extdeps.dns.domain_name.HostName {
  name: extdeps.dns.domain_name.DomainName { labels: ["srv3" as extdeps.dns.domain_name.DnsLabel] },
  qualification: extdeps.dns.domain_name.PartiallyQualified,
}

fn network_identity_subsumes_fleet_slot(
  fleet_slot: product.placement_supply.HostIdentity,
  lease: extdeps.dhcp.v4.DhcpLeaseObservation,
) -> Bool {
  match lease {
    extdeps.dhcp.v4.DynamicDhcpLease { client_hostname: Present { value: reported }, lease_time_remaining: _, status: extdeps.dhcp.v4.Active } =>
      match gunbc.hostname_allocation.canonical_hostname_for_fleet_slot(fleet_slot: fleet_slot) {
        Present { value: desired } =>
          extdeps.dns.domain_name.domain_name_wire(name: reported.name) == (desired as String)
        Absent => false
      }
    extdeps.dhcp.v4.DynamicDhcpLease { client_hostname: Absent, lease_time_remaining: _, status: _ } => false
    extdeps.dhcp.v4.DynamicDhcpLease { client_hostname: Present { value: _ }, lease_time_remaining: _, status: extdeps.dhcp.v4.Inactive } => false
    extdeps.dhcp.v4.DynamicDhcpLease { client_hostname: Present { value: _ }, lease_time_remaining: _, status: extdeps.dhcp.v4.Expired } => false
    extdeps.dhcp.v4.StaticDhcpReservation { reservation_label: _, status: _ } => false
  }
}

fn lease_table_has_os_up_subsumption(
  table: extdeps.router.verizon_cr1000a.Cr1000aDhcpLeaseTable,
  fleet_slot: product.placement_supply.HostIdentity,
) -> Bool {
  fold(
    table.rows,
    init: false,
    f: (acc, row) =>
      acc || network_identity_subsumes_fleet_slot(fleet_slot: fleet_slot, lease: row.lease)
  )
}

data srv3_bmc_static_lease_row: extdeps.router.verizon_cr1000a.Cr1000aDhcpLeaseRow = extdeps.router.verizon_cr1000a.Cr1000aDhcpLeaseRow {
  mac_address: "48:21:0B:81:C5:14" as extdeps.dhcp.v4.MacAddress,
  ipv4_address: extdeps.network.ipv4.ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 192),
  lease: extdeps.dhcp.v4.StaticDhcpReservation {
    reservation_label: "bmc-altrad8ud-1l2t-3" as std.types.NonEmptyStr,
    status: extdeps.dhcp.v4.Active,
  },
}

data srv3_os_up_dynamic_lease_row: extdeps.router.verizon_cr1000a.Cr1000aDhcpLeaseRow = extdeps.router.verizon_cr1000a.Cr1000aDhcpLeaseRow {
  mac_address: "00:00:00:00:00:00" as extdeps.dhcp.v4.MacAddress,
  ipv4_address: extdeps.network.ipv4.ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 193),
  lease: extdeps.dhcp.v4.DynamicDhcpLease {
    client_hostname: Present { value: srv3_fleet_slot_host_name },
    lease_time_remaining: extdeps.dhcp.v4.dhcp_lease_remaining_from_cited_minutes(minutes: 120),
    status: extdeps.dhcp.v4.Active,
  },
}

data srv3_pre_install_lease_table: extdeps.router.verizon_cr1000a.Cr1000aDhcpLeaseTable = extdeps.router.verizon_cr1000a.Cr1000aDhcpLeaseTable {
  rows: [srv3_bmc_static_lease_row],
}

data srv3_post_install_lease_table_fixture: extdeps.router.verizon_cr1000a.Cr1000aDhcpLeaseTable = extdeps.router.verizon_cr1000a.Cr1000aDhcpLeaseTable {
  rows: [srv3_bmc_static_lease_row, srv3_os_up_dynamic_lease_row],
}

fn srv3_pre_install_has_no_os_up_subsumption() -> Bool {
  !lease_table_has_os_up_subsumption(
    table: srv3_pre_install_lease_table,
    fleet_slot: gunbc.fleet_intent_network.operator_host_srv3,
  )
}

fn srv3_post_install_fixture_subsumes_fleet_slot() -> Bool {
  lease_table_has_os_up_subsumption(
    table: srv3_post_install_lease_table_fixture,
    fleet_slot: gunbc.fleet_intent_network.operator_host_srv3,
  )
}

fn bmc_static_reservation_does_not_subsume_os_fleet_slot() -> Bool {
  !network_identity_subsumes_fleet_slot(
    fleet_slot: gunbc.fleet_intent_network.operator_host_srv3,
    lease: srv3_bmc_static_lease_row.lease,
  )
}
