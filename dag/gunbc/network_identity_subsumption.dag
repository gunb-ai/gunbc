module gunbc.network_identity_subsumption

import std.types { NonEmptyStr, Bool, List, String }
import std.disposition { Disposition, Scaffold, SingleAuthority, Terminal }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.dhcp.v4 {
  DhcpLeaseObservation,
  DhcpClientHostNameOption12,
  DynamicDhcpLease,
  StaticDhcpReservation,
  Active,
  Inactive,
  Expired,
  dhcp_lease_remaining_from_cited_minutes,
}
import extdeps.network.ipv4 { Ipv4Address, ipv4_address }
import extdeps.network.mac { mac_address }
import extdeps.dns.domain_name {
  HostName,
  DomainName,
  DnsLabel,
  PartiallyQualified,
  domain_name_wire,
}
import extdeps.router.verizon_cr1000a { Cr1000aDhcpLeaseRow, Cr1000aDhcpLeaseTable }
import product.host_identity { HostIdentity }
import gunbc.fleet.fleet_host_identity { operator_host_srv3 }
import gunbc.hostname_allocation { canonical_hostname_for_fleet_slot }

data gunbc_network_identity_subsumption_scope_disposition: Disposition = Terminal {
  reason: "Slice-1 network-identity subsumption: DHCP option-12 dynamic lease client_hostname short label must subsume fleet_intent HostIdentity slot — discriminates BMC static reservation labels (operator-typed) from OS self-report (option-12). Pre-install: no dynamic row subsumes srv3; post-install: dynamic row with hostname srv3 subsumes operator_host_srv3."
}

data srv3_os_lan_mac_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.network_identity_subsumption",
    decl_name: "srv3_os_up_dynamic_lease_row",
    field: WholeDeclaration
  }
}

data srv3_os_lan_ipv4_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.network_identity_subsumption",
    decl_name: "srv3_os_up_dynamic_lease_row",
    field: WholeDeclaration
  }
}

// THE NAME THIS FIXTURE REPORTS OVER DHCP IS NOT THIS MODULE'S TO HOLD. What a host answers with is
// the hostname its ALLOCATION carries (gunbc.hostname_allocation::canonical_hostname_for_fleet_slot),
// and a hand-written copy of that name here is a second authority over it: rename srv3 and this row
// would go on certifying a lease for a name no host answers to, while the subsumption check beside it
// -- which reads the allocation -- moved on. So the fixture derives its label from the roster (the
// plan's hand-literal row, gunbc.plans.fleet_machine_authority section 4.4), and a slot with no
// allocated hostname reports the empty name and subsumes NOTHING: a host the roster cannot name is a
// host whose lease cannot prove anything (fail closed, never a name reconstructed from the identity).
fn srv3_observed_client_host_name() -> HostName {
  match canonical_hostname_for_fleet_slot(fleet_slot: operator_host_srv3) {
    Present { value: allocated } =>
      HostName { name: DomainName { labels: [allocated] }, qualification: PartiallyQualified }
    Absent => HostName { name: DomainName { labels: [] }, qualification: PartiallyQualified }
  }
}

data srv3_fleet_slot_host_name: HostName = srv3_observed_client_host_name()

fn network_identity_subsumes_fleet_slot(
  fleet_slot: HostIdentity,
  lease: DhcpLeaseObservation,
) -> Bool {
  match lease {
    DynamicDhcpLease { client_hostname: Present { value: reported }, lease_time_remaining: _, status: Active } =>
      match canonical_hostname_for_fleet_slot(fleet_slot: fleet_slot) {
        Present { value: desired } =>
          domain_name_wire(name: reported.name) == (desired as String)
        Absent => false
      }
    DynamicDhcpLease { client_hostname: Absent, lease_time_remaining: _, status: _ } => false
    DynamicDhcpLease { client_hostname: Present { value: _ }, lease_time_remaining: _, status: Inactive } => false
    DynamicDhcpLease { client_hostname: Present { value: _ }, lease_time_remaining: _, status: Expired } => false
    StaticDhcpReservation { reservation_label: _, status: _ } => false
  }
}

fn lease_table_has_os_up_subsumption(
  table: Cr1000aDhcpLeaseTable,
  fleet_slot: HostIdentity,
) -> Bool {
  fold(
    table.rows,
    init: false,
    f: (acc, row) =>
      acc || network_identity_subsumes_fleet_slot(fleet_slot: fleet_slot, lease: row.lease)
  )
}

data srv3_bmc_static_lease_row: Cr1000aDhcpLeaseRow = Cr1000aDhcpLeaseRow {
  mac_address: mac_address(octet1: 72, octet2: 33, octet3: 11, octet4: 129, octet5: 197, octet6: 20),
  ipv4_address: ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 192),
  lease: StaticDhcpReservation {
    reservation_label: "bmc-altrad8ud-1l2t-3" as NonEmptyStr,
    status: Active,
  },
}

data srv3_os_up_dynamic_lease_row: Cr1000aDhcpLeaseRow = Cr1000aDhcpLeaseRow {
  mac_address: mac_address(octet1: 0, octet2: 0, octet3: 0, octet4: 0, octet5: 0, octet6: 0),
  ipv4_address: ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 193),
  lease: DynamicDhcpLease {
    client_hostname: Present { value: srv3_fleet_slot_host_name },
    lease_time_remaining: dhcp_lease_remaining_from_cited_minutes(minutes: 120),
    status: Active,
  },
}

data srv3_pre_install_lease_table: Cr1000aDhcpLeaseTable = Cr1000aDhcpLeaseTable {
  rows: [srv3_bmc_static_lease_row],
}

data srv3_post_install_lease_table_fixture: Cr1000aDhcpLeaseTable = Cr1000aDhcpLeaseTable {
  rows: [srv3_bmc_static_lease_row, srv3_os_up_dynamic_lease_row],
}

fn srv3_pre_install_has_no_os_up_subsumption() -> Bool {
  !lease_table_has_os_up_subsumption(
    table: srv3_pre_install_lease_table,
    fleet_slot: operator_host_srv3,
  )
}

fn srv3_post_install_fixture_subsumes_fleet_slot() -> Bool {
  lease_table_has_os_up_subsumption(
    table: srv3_post_install_lease_table_fixture,
    fleet_slot: operator_host_srv3,
  )
}

fn bmc_static_reservation_does_not_subsume_os_fleet_slot() -> Bool {
  !network_identity_subsumes_fleet_slot(
    fleet_slot: operator_host_srv3,
    lease: srv3_bmc_static_lease_row.lease,
  )
}
