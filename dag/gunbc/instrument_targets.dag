  route_target_invocation,
}
import std.types { String, Bool, NonEmptyStr }

// THE REAL INSTRUMENT TARGETS, AND THEY ARE PRODUCTION ROWS RATHER THAN FIXTURE EXAMPLES.
//
// `gunbc.target_binding` declares the carriers and the witness beside it authors examples; neither
// declares an addressable target that exists in this repository. This module does, and the
// population began with one target so the dispatch seam could be proven independently. The three
// behavioral instruments now complete the already-modeled producer population as ordinary target
// and binding rows; `gunbc.target_invocation` remains unchanged.
//
// THE INSTRUMENTS ARE OUTSIDE `//:required` AND NOTHING HERE ADDS THEM TO IT. That is not a
// promise kept by diligence: `//:required`'s dependencies are DERIVED by
// `gunbc.discovery_census` from the floor's discovered witness sites, whose labels are
// `//<module path>:<function>` for a site the floor found. No fold anywhere feeds this population
// into that one, so an instrument target has no route into the aggregate at all — and the witness
// beside this module measures the derived population rather than restating the sentence.

fn instruments_package() -> PackageName {
  PackagePath { segments: ["gunbc", "instruments"] }
}

// THE TARGET NAME IS THE INSTRUMENT'S OWN SPELLING, HYPHENATED, and that is worth one sentence
// because it is also what keeps this population disjoint from the census one by construction: a
// discovered site's target name is a `.dag` FUNCTION name, and `heads-reading-differential` is not
// an identifier any function could carry. The two naming axes cannot collide even by accident.
fn heads_reading_differential_label() -> Label {
  Label {
    package: instruments_package()
    target: TargetName { name: "heads-reading-differential" }
  }
}

// THE FLOOR'S MEMORY DEMAND, QUALIFIED. The subject is the required-floor PROCESS -- not any
// function inside it -- which is why the reading is taken by a supervisor from outside rather than
// by anything the floor itself emits. See `gunbc.floor_memory_demand` for why an in-process
// observer cannot report the two terminations that matter most.
fn floor_memory_qualification_label() -> Label {
  Label {
    package: instruments_package()
    target: TargetName { name: "floor-memory-qualification" }
  }
}

fn behavioral_receipt_plan_label() -> Label {
  Label { package: instruments_package() target: TargetName { name: "behavioral-receipt-plan" } }
}

fn behavioral_receipt_census_label() -> Label {
  Label { package: instruments_package() target: TargetName { name: "behavioral-receipt-census" } }
}

fn behavioral_receipt_selftest_label() -> Label {
  Label { package: instruments_package() target: TargetName { name: "behavioral-receipt-selftest" } }
}

// THE COMPILE-CLEAN DIAGNOSTIC CENSUS. Its subject is the whole-tree compile-clean closure -- the
// same source set the floor gate compiles -- because a diagnostic count is a statement about the
// corpus only when the closure is the corpus's: censusing a narrower entry would report what was
// compiled, not what exists. This is the restored reachability for the census whose standalone
// bin was swept as an unrostered seed probe in gunbc#9160; the instrument target is the rostered
// entry point that sweep showed was missing. It was the ADVISORY census until the false-zero
// finding (review 2026-09-09): partitioning by severity before counting let a class vanish from
// the instrument exactly when its disposition changed, so the census now counts the raw emitted
// population and carries disposition as a row attribute.
fn compile_clean_diagnostic_census_label() -> Label {
  Label { package: instruments_package() target: TargetName { name: "compile-clean-diagnostic-census" } }
}

// THE SELF-HOST INSTRUMENT: THE GENERATION THIS REPOSITORY CAN PERFORM, ASKED AS ONE QUESTION.
//
// The seed emits v2's compiler closure, assembles it as a crate, and builds it. Pass or fail is
// the whole verdict and WHERE IT STOPS IS THE STATUS, so there is no roster of known-good entries
// beside it: a roster is a second representation of what this instrument demonstrates by running
// (DESIGN sections 2 and 3), and it drifts exactly when nobody updates it.
// `required_v2_emission_entries` has changed once in repository history and that change was a
// directory move.
//
// WHAT A GREEN DOES NOT ESTABLISH, named so it is not cited for more than it carries. It is
// EMISSION AND COMPILATION, not behavioural equivalence -- DESIGN section 7 asks that the emitted
// module also behave as the seed does on a discriminating corpus, and that half lives in the three
// behavioral-receipt instruments beside this one. Nor is it the second generation: the BUILT binary
// emitting the same closure is the v2 -> v2 boundary, and it refuses today because
// `v2.compiler.compile` declares `SourceRootEvalDriver`, whose rendered main answers `census` and
// `adjudicate` and has no compile mode at all. That refusal is the honest next position and belongs
// in this instrument when a driver can reach it.
fn self_host_label() -> Label {
  Label { package: instruments_package() target: TargetName { name: "self-host" } }
}

// THE V2-EXCLUSIVE CLI INSTRUMENT: THE DOOR THE SELF-HOST STEP STOPS IN FRONT OF.
//
// `//gunbc/instruments:self-host` establishes that the seed can emit `v2.compiler.compile` and
// build it clean, and its own row above states what that does NOT establish: the second generation,
// because that entry declares `SourceRootEvalDriver`, whose rendered main answers `census` and
// `adjudicate` and has no compile mode. `v2.cli.compile_cli` is the entry that has one -- a
// `NativeCliDriver` whose `.dag` fold decides the verb, every refusal, what to emit and the process
// status, with a rendered main that only reads argv, walks the roots the PLAN named, writes stdout
// and sets the status. This instrument asks whether that door compiles.
//
// IT IS A SEPARATE LABEL BECAUSE IT IS A SEPARATE CLOSURE, not because the question is different.
// The two closures are DIFFERENT rather than nested, and neither contains the other's
// `compiler_pipeline_entry` declaration -- which is precisely why they can coexist under the
// emitter's exactly-one rule. They are also close in size, so size is not the argument: the
// argument is membership. This closure reaches modules `v2.compiler.compile`'s does not,
// `v2.extdeps.languages.rust` among them, so a green here and a green there are two facts about
// two compilations and neither is evidence about the other. One label carrying both would let a
// regression in either be reported under a name that does not say which.
fn v2_native_cli_label() -> Label {
  Label { package: instruments_package() target: TargetName { name: "v2-native-cli" } }
}

// O(corpus) exact-head join of evaluation_store_address callers plus the fail-closed src/v2
// call-form scan. Not a DiscoverySelection floor witness (enrolment_bound_without_ceiling);
// not a required CI job. `gunbc test //gunbc/instruments:evaluation-store-address-exact-head`.
fn evaluation_store_address_exact_head_label() -> Label {
  Label { package: instruments_package() target: TargetName { name: "evaluation-store-address-exact-head" } }
}

// THE INSTRUMENT IS A `TestRule` WITH NO DEPENDENCIES, and both halves are measurements rather
// than placeholders. It answers a test question — does the heads reading read the same grammar as
// the full reading — so it is not a `BuildRule`; and it depends on no other target in this graph,
// because its subject is the source corpus handed to it at invocation, not a built artifact.
fn heads_reading_differential_target() -> BuildTarget {
  BuildTarget {
    label: heads_reading_differential_label()
    kind: TestRule {}
    dependencies: []
  }
}

// NOT EVERY `*_target()` BELOW IS CONSUMED. `evaluation_store_address_exact_head_target` and
// `v2_native_cli_target` are each referenced only by their own definition; `instrument_targets()`
// folds LABELS and `instrument_bindings()` folds BINDINGS, and neither reads a `BuildTarget`. That
// is a DESIGN section 3c dangling set, recorded here rather than resolved because resolving it is
// a separate change -- and recorded so the next author adding an instrument does not copy the
// pattern. The floor-memory row deliberately adds no `*_target()` for that reason.
fn instrument_test_target(label: Label) -> BuildTarget {
  BuildTarget { label: label kind: TestRule {} dependencies: [] }
}

fn behavioral_receipt_plan_target() -> BuildTarget {
  instrument_test_target(label: behavioral_receipt_plan_label())
}

fn behavioral_receipt_census_target() -> BuildTarget {
  instrument_test_target(label: behavioral_receipt_census_label())
}

fn behavioral_receipt_selftest_target() -> BuildTarget {
  instrument_test_target(label: behavioral_receipt_selftest_label())
}

fn compile_clean_diagnostic_census_target() -> BuildTarget {
  instrument_test_target(label: compile_clean_diagnostic_census_label())
}

fn self_host_target() -> BuildTarget {
  instrument_test_target(label: self_host_label())
}

fn v2_native_cli_target() -> BuildTarget {
  instrument_test_target(label: v2_native_cli_label())
}

fn evaluation_store_address_exact_head_target() -> BuildTarget {
  instrument_test_target(label: evaluation_store_address_exact_head_label())
}

fn v2_native_cli_binding() -> TargetBinding {
  TargetBinding { target: v2_native_cli_label() producer: V2NativeCliProducer {} }
}

fn self_host_binding() -> TargetBinding {
  TargetBinding { target: self_host_label() producer: SelfHostProducer {} }
}

fn heads_reading_differential_binding() -> TargetBinding {
  TargetBinding {
    target: heads_reading_differential_label()
    producer: HeadsReadingDifferentialProducer {}
  }
}

fn behavioral_receipt_plan_binding() -> TargetBinding {
  TargetBinding { target: behavioral_receipt_plan_label() producer: BehavioralReceiptPlanProducer {} }
}

fn behavioral_receipt_census_binding() -> TargetBinding {
  TargetBinding { target: behavioral_receipt_census_label() producer: BehavioralReceiptCensusProducer {} }
}

fn behavioral_receipt_selftest_binding() -> TargetBinding {
  TargetBinding { target: behavioral_receipt_selftest_label() producer: BehavioralReceiptSelftestProducer {} }
}

fn compile_clean_diagnostic_census_binding() -> TargetBinding {
  TargetBinding { target: compile_clean_diagnostic_census_label() producer: CompileCleanDiagnosticCensusProducer {} }
}

fn evaluation_store_address_exact_head_binding() -> TargetBinding {
  TargetBinding { target: evaluation_store_address_exact_head_label() producer: EvaluationStoreAddressExactHeadProducer {} }
}

fn floor_memory_qualification_binding() -> TargetBinding {
  TargetBinding {
    target: floor_memory_qualification_label()
    producer: FloorMemoryQualificationProducer {}
  }
}

// THE SUBJECT IS THE INSTRUMENT'S OWN FACT, NOT AN ARGUMENT THE CALLER SUPPLIES.
//
// `gunbc test //gunbc/instruments:heads-reading-differential` takes no source-root option, and
// that is a modelling decision rather than a convenience: which corpus the heads reading is a
// reading OF is a property of this instrument, so making it a CLI option would give one fact two
// homes and let an invocation quietly measure a different corpus while reporting the same target's
// standing. These are the two roots the existing `--heads-reading-differential` mode already
// reads, so this row moves the literal out of argv rather than inventing a third population.
fn heads_reading_differential_source_roots() -> List<String> {
  ["dag", "src/v2"]
}

// The self-host instrument's own subject, on the same rule its siblings follow: which corpus the
// seed emits v2 FROM is a property of this instrument, not a CLI option, so an invocation cannot
// quietly build a different closure while reporting this target's standing.
// The CLI instrument's own subject, on the rule every instrument here follows: which corpus the
// CLI's closure is emitted FROM is a property of this instrument rather than an invocation option,
// so a run cannot quietly build a different closure while reporting this target's standing. The two
// roots are the same population its sibling reads, because the CLI entry resolves against both.
fn v2_native_cli_source_roots() -> List<String> {
  ["dag", "src/v2"]
}

// The floor-memory instrument's own subject, on the same rule its siblings follow: WHICH floor run
// is being qualified is a property of this instrument, not an invocation option, so a run cannot
// quietly measure a different lane while reporting this target's standing. These are the roots and
// the lane the required check ran when this instrument was written.
fn floor_memory_qualification_source_roots() -> List<String> {
  ["dag", "src/v2"]
}

fn floor_memory_qualification_lane() -> String {
  "witnesses"
}

fn self_host_source_roots() -> List<String> {
  ["dag", "src/v2"]
}

// One modeled subject shared by the three behavioral producers. The host leaf receives this
// population; it does not decide it.
fn behavioral_receipt_source_roots() -> List<String> {
  ["dag", "src/v2"]
}

// WHAT AN INVOCATION OF THIS INSTRUMENT DOES NOT ESTABLISH, STATED HERE RATHER THAN ASSUMED SAFE.
//
// The differential's producer reads an UNPINNED LIVE WORKING TREE. Nothing binds the bytes it
// consumed to the standing it returned -- the corpus may change while the walk is in progress --
// so a completed observation is not identified with any source state a later run could
// reconstruct. Every arm of `HeadsReadingDifferentialStanding` is therefore an OUTCOME and none of
// them is a receipt, and no digest, commit or head-ref field may be added THERE to close the gap:
// hashing before the run, after it, or both proves nothing, because the tree can go A -> B -> A
// while the producer reads a MIXED population and both hashes agree. A field that looks like
// provenance and supports none is worse than the gap it hides.
//
// THE DIAGNOSTIC CENSUS IS THE ONE EXCEPTION, AND THE MECHANISM IS THE DIFFERENCE. It does not
// hash the tree and then read it: it materializes the whole source vector into memory FIRST,
// hashes exactly that vector, and hands the same in-memory bytes to the compiler, so the bytes
// hashed are the bytes compiled and the mixed-population hole has no write path. Its identity
// block (gunbc.target_binding CompileCleanDiagnosticCensusIdentity) is therefore provenance that
// binds, not a digest-shaped decoration. What it still does not establish is anything CROSS-RUN:
// comparing two observations (the per-class ratchet the burndown program wants) needs a stored
// prior reading and a join discipline of its own, which is a later consumer, not a field here.
//
// SO FOR THE SEAM GENERALLY THE FOLLOWING REMAIN OUT OF REACH UNTIL SOURCE BINDING LANDS AS ITS
// OWN CAPABILITY: caching a target's result, executing remotely, replaying. Direct invocation and
// its immediate rendering are what this seam claims, and they need none of them.
fn instrument_targets() -> List<Label> {
  [
    heads_reading_differential_label(), behavioral_receipt_plan_label(),
    behavioral_receipt_census_label(), behavioral_receipt_selftest_label(),
    compile_clean_diagnostic_census_label(), self_host_label(), v2_native_cli_label(),
    evaluation_store_address_exact_head_label(), floor_memory_qualification_label()
  ]
}

fn instrument_bindings() -> List<TargetBinding> {
  [
    heads_reading_differential_binding(), behavioral_receipt_plan_binding(),
    behavioral_receipt_census_binding(), behavioral_receipt_selftest_binding(),
    compile_clean_diagnostic_census_binding(), self_host_binding(), v2_native_cli_binding(),
    evaluation_store_address_exact_head_binding(), floor_memory_qualification_binding()
  ]
}

// THE PRODUCTION ENTRY: the generic route, bound to the live population, in one place. Every
// caller — the CLI verb, a witness, a future coordinator — asks here, so there is exactly one
// answer to "which producer does this label name in this repository".
fn invoke_target(operand: String) -> TargetInvocationRoute {
  route_target_invocation(
    operand: operand,
    targets: instrument_targets(),
    bindings: instrument_bindings()
  )
}

// ---------------------------------------------------------------------------------------------
// THE DIFFERENTIAL'S OWN CLASSIFIER AND ITS OWN RENDERING
// ---------------------------------------------------------------------------------------------

// WHAT "HELD" MEANS IS THE PRODUCER'S DECISION, TAKEN HERE, ONCE.
//
// `divergent` must be empty — a divergence means the heads reading is a second, weaker parser
// rather than a reading of the same grammar — and `regressed` must be empty, since the heads
// reading may never refuse what the full reading accepts. `narrowed` is NOT a defect and is
// excluded deliberately: it is the declared, bounded scope narrowing, counted rather than absorbed,
// and folding it into the verdict would make a documented boundary report as a defect. `both_refused`
// is a property of the corpus, not of the reading, and is likewise reported without deciding.
fn heads_reading_differential_holds(o: HeadsReadingDifferentialObservation) -> Bool {
  ((o.divergent |> count) == 0) && ((o.regressed |> count) == 0)
}

// THE CLASSIFIER INTO THE SHARED TERMINATION VOCABULARY, WILDCARD-FREE. A fourth standing arm
// added upstream must fail to compile here rather than inherit whichever termination a `_` named.
fn heads_reading_differential_termination(
  s: HeadsReadingDifferentialStanding
) -> InvocationTermination {
  match s {
    HeadsReadingDifferentialCompleted { observation: o } =>
      if heads_reading_differential_holds(o: o) {
        InvocationObservationHeld {}
      } else {
        InvocationObservationDidNotHold {}
      }
    HeadsReadingDifferentialSubjectUnreached { source_roots: _, cause: _ } =>
      InvocationSubjectUnreached {}
    HeadsReadingDifferentialRefused { cause: _ } => InvocationRefused {}
  }
}

fn differential_subject_cause_rendered(c: HeadsReadingDifferentialSubjectCause) -> String {
  match c {
    DifferentialSourceRootAbsent => "source root absent"
    DifferentialSourceRootUnreadable => "source root unreadable"
    DifferentialSourcePopulationIndexRefused => "source population index refused"
  }
}

fn differential_refusal_cause_rendered(c: HeadsReadingDifferentialRefusalCause) -> String {
  match c {
    DifferentialReadingExecutionRefused => "reading execution refused"
    DifferentialObservationAssemblyRefused => "observation assembly refused"
  }
}

// THE RENDERING IS THE PRODUCER'S NATIVE VOCABULARY AND NOTHING ELSE.
//
// It does not say PASSED or FAILED, and the omission is the point. Those are the aggregate's
// words, and a direct invocation that borrowed them would quietly re-answer the question
// `test_standing_verdict` deliberately refuses for an instrument. What a reader gets is what the
// differential measured: how many modules were compared, and the four populations it partitions
// them into.
fn heads_reading_differential_observation_rendered(
  o: HeadsReadingDifferentialObservation
) -> String {
  join([
    "heads-reading-differential: compared=", to_string(o.modules_compared),
    " divergent=", to_string(o.divergent |> count),
    " narrowed=", to_string(o.narrowed |> count),
    " regressed=", to_string(o.regressed |> count),
    " both_refused=", to_string(o.both_refused |> count)
  ], "")
}

fn heads_reading_differential_standing_rendered(
  s: HeadsReadingDifferentialStanding
) -> String {
  match s {
    HeadsReadingDifferentialCompleted { observation: o } =>
      heads_reading_differential_observation_rendered(o: o)
    HeadsReadingDifferentialSubjectUnreached { source_roots: roots, cause: c } =>
      join([
        "heads-reading-differential: subject unreached (",
        differential_subject_cause_rendered(c: c),
        "): ",
        join(roots, ", ")
      ], "")
    HeadsReadingDifferentialRefused { cause: c } =>
      concat(
        "heads-reading-differential: refused: ",
        differential_refusal_cause_rendered(c: c)
      )
  }
}

// ---------------------------------------------------------------------------------------------
// THE DIAGNOSTIC CENSUS'S OWN CLASSIFIER AND ITS OWN RENDERING
// ---------------------------------------------------------------------------------------------

// THE RAW COUNT OF ONE CLASS OVER THE UNFILTERED POPULATION. An absent row and a zero-count row
// are the same answer here -- the class emitted nothing -- because the census counts every
// emitted diagnostic and a class with no emission has no row to carry.
fn diagnostic_class_raw_count(
  classes: List<RawDiagnosticClassObservation>,
  wanted: NonEmptyStr
) -> Int {
  classes
    |> filter(r => r.diagnostic_class == wanted)
    |> fold(init: 0, f: fn(acc, r) { acc + r.diagnostics })
}

// WHAT "HELD" MEANS FOR THIS INSTRUMENT: the class-specific zero wall for the class whose
// burndown it governs -- the RAW UnlistedImportUse count is zero. Two properties are doing the
// work, and both are the point of the raw census. FIRST, the count is read over the unfiltered
// population, so a severity change cannot hide a recurrence: the class row exists with its gate
// and severity attributes whether the policy row says FloorNotYet or Enforced, and promoting the
// class to blocking does not retire this wall -- it is the same observation. SECOND, the wall is
// class-specific rather than the all-advisories-empty completion target: while the other advisory
// classes burn down on their own tracks, this instrument holds exactly when UnlistedImportUse
// reaches zero, and a reintroduced occurrence flips it back. A census that cannot reach its
// closure, read its policy, or satisfy its conservation and roster invariants refuses; it never
// reports an unobserved tree as a clean one.
fn compile_clean_diagnostic_census_holds(o: CompileCleanDiagnosticCensusObservation) -> Bool {
  diagnostic_class_raw_count(classes: o.classes, wanted: "UnlistedImportUse" as NonEmptyStr) == 0
}

fn compile_clean_diagnostic_census_termination(
  s: CompileCleanDiagnosticCensusStanding
) -> InvocationTermination {
  match s {
    CompileCleanDiagnosticCensusCompleted { observation: o } =>
      if compile_clean_diagnostic_census_holds(o: o) {
        InvocationObservationHeld {}
      } else {
        InvocationObservationDidNotHold {}
      }
    CompileCleanDiagnosticCensusRefused { cause: _ } => InvocationRefused {}
  }
}

fn diagnostic_census_refusal_cause_rendered(c: CompileCleanDiagnosticCensusRefusalCause) -> String {
  match c {
    DiagnosticCensusClosureUnresolvable => "whole-tree closure unresolvable"
    DiagnosticCensusGraphAbsent => "compilation produced no graph"
    DiagnosticCensusPolicyUnreadable => "disposition policy or ceiling roster unreadable"
    DiagnosticCensusConservationViolated => "per-class counts do not sum to the raw diagnostics vector"
    DiagnosticCensusDetailCountMismatch => "class count disagrees with the detailed UnlistedImportUse worklist"
    DiagnosticCensusCeilingRosterDuplicate => "two ceiling rows name one diagnostic class"
    DiagnosticCensusCeilingRosterStale => "a ceiling row names a class outside the schema or no longer advisory"
    DiagnosticCensusCeilingRosterUncovered => "an observed advisory-typecheck class carries no ceiling row"
    DiagnosticCensusIdentityUnavailable => "an identity digest could not be computed; the observation would be unbound"
    DiagnosticCensusSchemaAuthorityAbsent =>
      "the CompilerDiagnostic coproduct authority is absent from the compiled closure"
    DiagnosticCensusSchemaSpecimenDuplicate => "two schema specimens project one class identity"
    DiagnosticCensusSchemaCountMismatch =>
      "the schema specimen count disagrees with the authority constructor census"
    DiagnosticCensusSchemaConstructorUnrepresented =>
      "an authority constructor has no schema specimen"
    DiagnosticCensusSchemaSpecimenUnknownToAuthority =>
      "a schema specimen names no authority constructor"
  }
}

fn diagnostic_census_gate_rendered(g: DiagnosticCensusGateDisposition) -> String {
  match g {
    CensusBlocking => "blocking"
    CensusAdvisoryTypecheck => "advisory-typecheck"
    CensusRenderedUncounted { reason: r } => join(["rendered-uncounted(", r as String, ")"], "")
  }
}

fn diagnostic_census_severity_rendered(s: DiagnosticCensusSeverity) -> String {
  match s {
    CensusSeverityError => "error"
    CensusSeverityNonError => "non-error"
  }
}

fn raw_diagnostic_class_observation_rendered(e: RawDiagnosticClassObservation) -> String {
  join([
    e.diagnostic_class as String,
    " gate=", diagnostic_census_gate_rendered(g: e.gate),
    " severity=", diagnostic_census_severity_rendered(s: e.severity),
    " diagnostics=", to_string(e.diagnostics),
    " distinct_modules=", to_string(e.distinct_modules),
    " distinct_positions=", to_string(e.distinct_positions)
  ], "")
}

fn compile_clean_diagnostic_census_identity_rendered(
  i: CompileCleanDiagnosticCensusIdentity
) -> String {
  join([
    "identity source_vector=", i.source_vector_digest as String,
    " compiler=", i.compiler_executable_digest as String,
    " resolver_policy=", i.resolver_policy_digest as String,
    " diagnostic_class_schema=", i.diagnostic_class_schema_digest as String,
    " closure=", i.closure_digest as String
  ], "")
}

// THE RENDERING IS THE CENSUS'S OWN VOCABULARY: the denominator and the raw total, the walled
// class's own count (the termination's subject, printed so the verdict and the printout cannot
// diverge), the five identity digests, then one line per class with disposition and the three
// burndown counts. It does not say PASSED or FAILED -- those are the aggregate's words, and this
// instrument is outside the aggregate by construction.
fn compile_clean_diagnostic_census_observation_rendered(
  o: CompileCleanDiagnosticCensusObservation
) -> String {
  join([
    "compile-clean-diagnostic-census: closure_modules=", to_string(o.closure_modules),
    " raw_diagnostics=", to_string(o.raw_diagnostics),
    " classes=", to_string(o.classes |> count),
    " unlisted_import_use_raw=",
      to_string(diagnostic_class_raw_count(classes: o.classes, wanted: "UnlistedImportUse" as NonEmptyStr)),
    "\n",
    compile_clean_diagnostic_census_identity_rendered(i: o.identity),
    "\n",
    join(o.classes |> map(e => raw_diagnostic_class_observation_rendered(e: e)), "\n")
  ], "")
}

fn compile_clean_diagnostic_census_standing_rendered(
  s: CompileCleanDiagnosticCensusStanding
) -> String {
  match s {
    CompileCleanDiagnosticCensusCompleted { observation: o } =>
      compile_clean_diagnostic_census_observation_rendered(o: o)
    CompileCleanDiagnosticCensusRefused { cause: c } =>
      concat(
        "compile-clean-diagnostic-census: refused: ",
        diagnostic_census_refusal_cause_rendered(c: c)
      )
  }
}
