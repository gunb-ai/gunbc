fn organization_runner_roster_evidence() -> OrganizationRunnerRosterEvidence {
  RosterObserved {
    observed_on: "2026-08-06" as NonEmptyStr,
    registrations: incident_2026_08_06_registrations,
  }
}

data organization_runner_roster_producer_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.fleet_runner_connectivity",
    decl_name: "organization_runner_roster_show_effective_read",
    field: WholeDeclaration,
  }
}

data organization_runner_roster_show_effective_read: ShowEffectiveRead<OrganizationRunnerRosterEvidence> = ReadAbsent {
  reason: "no live org-level GET /orgs/gunb-ai/actions/runners has executed through the gunbai-ci GitHub App yet; the incident fixture in organization_runner_roster_evidence is the pinned acceptance corpus until this read binds ReadObserved"
}

fn organization_runner_roster_for_apply_plan() -> OrganizationRunnerRosterEvidence? {
  match organization_runner_roster_show_effective_read {
    ReadAbsent { reason: _ } => none
    ReadObserved { value: v } => Present { value: v }
  }
}

fn registration_matches_name(
  reg: GitHubSelfHostedRunnerRegistration,
  name: NonEmptyStr,
) -> Bool {
  (reg.name as String) == (name as String)
}

fn find_registration_by_name(
  registrations: List<GitHubSelfHostedRunnerRegistration>,
  name: NonEmptyStr,
) -> GitHubSelfHostedRunnerRegistration? {
  fold(
    registrations,
    init: none,
    f: (acc, reg) =>
      if registration_matches_name(reg: reg, name: name) {
        Present { value: reg }
      } else {
        acc
      }
  )
}

data do_not_count_directories_for_width_note: String = "DO NOT COUNT DIRECTORIES FOR WIDTH. srv1 carries fifty slot directories with only five active systemd units; srv1-06/07 directories exist since 2026-07-11 with no unit. srv3-06/07 and srv4-06/07 directories may already exist from prior attempts without a matching unit. Live width authority is unit/process state joined with the org roster — never filesystem enumeration. A directory-counting producer reads fifty, computes nothing missing, and reports success having provisioned nothing."

data runner_slot_materialized_not_active_note: String = "MATERIALIZED, NOT CURRENTLY ACTIVE is the actionable local state for ADD — one arm, not two. It subsumes both shapes observed live: (a) srv1-06/07 — complete install tree, no .runner, unit absent or disabled+inactive; (b) srv3-06/07/08 — complete install tree, stale .runner from a prior incarnation, unit disabled+inactive. The .runner file records history, not required action: measured on srv1-01, .runner mtime trails unit ActiveEnterTimestamp by one second because run.sh --jitconfig rewrites it at every incarnation start (.credentials and .credentials_rsaparams follow the same pattern); jit-runner.sh does not pre-clean them and does not need to. Ephemeral AgentIds in a stale file are long garbage-collected by GitHub. ADD therefore does NOT fork on .runner presence and does NOT need RunnerIncarnationReplace for inactive slots — only set-property (per-slot caps), daemon-reload, and systemctl start; JIT registration happens at start. What matters is unit state: disabled+inactive is startable; active is already converged. Re-extracting over an existing complete tree is wrong (clobbers _work); refusing because a directory exists is the empty-observation narrow."

data srv3_live_materialized_slot_observation_note: String = "LIVE READ 2026-08-07 (read-only, no units started; vivid-eagle-131 via srv2 tailscale → ubuntu@192.168.1.221): srv3 carries eight complete slot directories (srv3-01..08) under /opt/actions-runner/, five active actions-runner@ units (01..05), and three materialized-not-active slots (06..08: disabled+inactive units, stale .runner present from 2026-07-21 incarnations). gunbc_runner_slots_per_host's seven is a memory-derived INTENT CEILING, not a materialization limit — srv3-08 may remain materialized and unactivated without widening intent. The incident corpus below still pins 2026-08-06 org-roster connectivity at five active units per host until a live producer grounds materialized_width separately."

data stale_runner_file_rewritten_at_start_note: String = "Stale .runner on disk is NOT live registration state and is NOT a blocker for ADD. Proof: srv1-01 live slot — unit ActiveEnterTimestamp 09:19:20, .runner mtime 09:19:21; run.sh --jitconfig overwrites .runner each start. Fetch/extract/digest-verify remains the FALLBACK arm for genuinely-absent slots only; it must not gate a slot whose install tree is already complete."

data incident_local_unit_active_width_note: String = "UNIT_ACTIVE WIDTH IS ACTIVE SYSTEMD INCARNATION STATE, pinned from the incident corpus: five active actions-runner@<slot>.service units per host on all four hosts (20 total), even though gunbc_runner_slots_per_host admits 22 desired slots today. MATERIALIZED WIDTH names on-disk install artifacts separately and must not be equated with directory count. This row is the seam where local incarnation observation should eventually ground gunbc.runner_slot_allocation observed_live_width when that carrier lands — without taking a dependency on an unmerged PR."

type UnitActiveWidthByHostEvidence {
  srv1_width: Int
  srv2_width: Int
  srv3_width: Int
  srv4_width: Int
}

type MaterializedWidthByHostEvidence {
  srv1_width: Int
  srv2_width: Int
  srv3_width: Int
  srv4_width: Int
}

data incident_unit_active_width_by_host: UnitActiveWidthByHostEvidence = UnitActiveWidthByHostEvidence {
  srv1_width: 5,
  srv2_width: 5,
  srv3_width: 5,
  srv4_width: 5,
}

data incident_materialized_width_by_host: MaterializedWidthByHostEvidence = MaterializedWidthByHostEvidence {
  srv1_width: 5,
  srv2_width: 5,
  srv3_width: 5,
  srv4_width: 5,
}

data local_unit_active_width_producer_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.fleet_runner_connectivity",
    decl_name: "unit_active_width_show_effective_read",
    field: WholeDeclaration,
  }
}

data local_materialized_width_producer_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.fleet_runner_connectivity",
    decl_name: "materialized_width_show_effective_read",
    field: WholeDeclaration,
  }
}

data unit_active_width_show_effective_read: ShowEffectiveRead<UnitActiveWidthByHostEvidence> = ReadAbsent {
  reason: "no live per-host systemd unit-active width read has executed on the fleet yet; incident_unit_active_width_for_host pins the 2026-08-06 acceptance corpus until this read binds ReadObserved"
}

data materialized_width_show_effective_read: ShowEffectiveRead<MaterializedWidthByHostEvidence> = ReadAbsent {
  reason: "no live per-host materialized slot-width read has executed on the fleet yet; incident_materialized_width_for_host pins the 2026-08-06 acceptance corpus until this read binds ReadObserved"
}

fn unit_active_width_from_evidence(host: HostIdentity, evidence: UnitActiveWidthByHostEvidence) -> Int {
  if (host as String) == (operator_host_srv1 as String) {
    evidence.srv1_width
  } else if (host as String) == (operator_host_srv2 as String) {
    evidence.srv2_width
  } else if (host as String) == (operator_host_srv3 as String) {
    evidence.srv3_width
  } else if (host as String) == (operator_host_srv4 as String) {
    evidence.srv4_width
  } else {
    0
  }
}

fn materialized_width_from_evidence(host: HostIdentity, evidence: MaterializedWidthByHostEvidence) -> Int {
  if (host as String) == (operator_host_srv1 as String) {
    evidence.srv1_width
  } else if (host as String) == (operator_host_srv2 as String) {
    evidence.srv2_width
  } else if (host as String) == (operator_host_srv3 as String) {
    evidence.srv3_width
  } else if (host as String) == (operator_host_srv4 as String) {
    evidence.srv4_width
  } else {
    0
  }
}

fn incident_unit_active_width_for_host(host: HostIdentity) -> Int {
  unit_active_width_from_evidence(host: host, evidence: incident_unit_active_width_by_host)
}

fn incident_materialized_width_for_host(host: HostIdentity) -> Int {
  materialized_width_from_evidence(host: host, evidence: incident_materialized_width_by_host)
}

fn unit_active_width_for_host(host: HostIdentity) -> Int {
  match unit_active_width_show_effective_read {
    ReadObserved { value: v } => unit_active_width_from_evidence(host: host, evidence: v)
    ReadAbsent { reason: _ } => incident_unit_active_width_for_host(host: host)
  }
}

fn unit_active_width_for_apply_plan(host: HostIdentity) -> Int? {
  match unit_active_width_show_effective_read {
    ReadAbsent { reason: _ } => none
    ReadObserved { value: v } => Present { value: unit_active_width_from_evidence(host: host, evidence: v) }
  }
}

fn materialized_width_for_host(host: HostIdentity) -> Int {
  match materialized_width_show_effective_read {
    ReadObserved { value: v } => materialized_width_from_evidence(host: host, evidence: v)
    ReadAbsent { reason: _ } => incident_materialized_width_for_host(host: host)
  }
}

data incident_materialized_slot_indices: List<Nat> = [1, 2, 3, 4, 5]

data local_incarnations_width_refusal_note: String = "local_incarnations_for_host refuses (returns Absent) for any unit-active width other than the incident corpus width of five — never answers an empty list for an unmodeled width. An empty list would conflate no incarnations observed with observation refused (DESIGN empty-observation narrow); Absent propagates to connectivity_verdicts_for_active_incarnations, runner_slot_connectivity_verdict, and runner_capacity_plan observed_slot_identities so repair planning cannot silently proceed with zero replacements."

fn slot_suffix(slot_index: Nat) -> String {
  if slot_index == 1 {
    "01"
  } else if slot_index == 2 {
    "02"
  } else if slot_index == 3 {
    "03"
  } else if slot_index == 4 {
    "04"
  } else if slot_index == 5 {
    "05"
  } else if slot_index == 6 {
    "06"
  } else if slot_index == 7 {
    "07"
  } else if slot_index == 8 {
    "08"
  } else {
    "00"
  }
}

fn runner_slot_incarnation(
  host: HostIdentity,
  slot_index: Nat,
  unit_active: Bool,
) -> LocalRunnerSlotIncarnation {
  let registration_name = join([host as String, "-", slot_suffix(slot_index: slot_index)], "") as NonEmptyStr
  LocalRunnerSlotIncarnation {
    slot: RunnerSlotIdentity { host: host, slot_index: slot_index },
    unit: join(["actions-runner@", registration_name as String, ".service"], "") as NonEmptyStr,
    unit_active: unit_active,
    registration_name: registration_name,
  }
}

fn local_incarnations_for_host(host: HostIdentity, width: Int) -> List<LocalRunnerSlotIncarnation>? {
  if width == 5 {
    Present {
      value: map(
        incident_materialized_slot_indices,
        i => runner_slot_incarnation(host: host, slot_index: i, unit_active: true)
      )
    }
  } else {
    none
  }
}

fn local_runner_slot_incarnations() -> List<LocalRunnerSlotIncarnation>? {
  match local_incarnations_for_host(host: operator_host_srv1, width: materialized_width_for_host(host: operator_host_srv1)) {
    Absent => none
    Present { value: h1 } =>
      match local_incarnations_for_host(host: operator_host_srv2, width: materialized_width_for_host(host: operator_host_srv2)) {
        Absent => none
        Present { value: h2 } =>
          match local_incarnations_for_host(host: operator_host_srv3, width: materialized_width_for_host(host: operator_host_srv3)) {
            Absent => none
            Present { value: h3 } =>
              match local_incarnations_for_host(host: operator_host_srv4, width: materialized_width_for_host(host: operator_host_srv4)) {
                Absent => none
                Present { value: h4 } => Present { value: concat(h1, concat(h2, concat(h3, h4))) }
              }
          }
      }
  }
}

fn runner_slot_connectivity_verdict_for_incarnation(
  incarnation: LocalRunnerSlotIncarnation,
  roster: OrganizationRunnerRosterEvidence,
) -> RunnerSlotConnectivityVerdict {
  if !incarnation.unit_active {
    SlotConnectivityUnknown {
      slot: incarnation.slot,
      reason: "inactive systemd unit is outside the active-incarnation connectivity model"
    }
  } else {
    match roster {
      RosterReadUnavailable { reason: r } =>
        SlotConnectivityUnknown { slot: incarnation.slot, reason: r }
      RosterObserved { observed_on: _, registrations: regs } =>
        match find_registration_by_name(registrations: regs, name: incarnation.registration_name) {
          Absent => SlotConnectivityOrphaned { slot: incarnation.slot }
          Present { value: reg } =>
            match reg.status {
              GitHubRunnerOnline =>
                SlotConnectivityHealthy { slot: incarnation.slot, registration_id: reg.id }
              GitHubRunnerOffline =>
                SlotConnectivityDetached { slot: incarnation.slot, registration_id: reg.id }
            }
        }
    }
  }
}

fn runner_slot_connectivity_verdict(
  slot: RunnerSlotIdentity,
  roster: OrganizationRunnerRosterEvidence,
) -> RunnerSlotConnectivityVerdict {
  match local_runner_slot_incarnations() {
    Absent =>
      SlotConnectivityUnknown {
        slot: slot,
        reason: "local incarnation observation refused — unit-active width is not the modeled incident corpus width"
      }
    Present { value: incarnations } =>
      match fold(
        incarnations,
        init: none,
        f: (acc, inc) =>
          if (inc.slot.host as String) == (slot.host as String) && inc.slot.slot_index == slot.slot_index {
            Present {
              value: runner_slot_connectivity_verdict_for_incarnation(incarnation: inc, roster: roster)
            }
          } else {
            acc
          }
      ) {
        Absent =>
          SlotConnectivityUnknown {
            slot: slot,
            reason: "no local incarnation is modeled for this slot identity"
          }
        Present { value: v } => v
      }
  }
}

fn count_online_registrations(registrations: List<GitHubSelfHostedRunnerRegistration>) -> Int {
  fold(
    registrations,
    init: 0,
    f: (n, reg) => if github_runner_registration_is_online(reg: reg) { n + 1 } else { n }
  )
}

fn count_schedulable_registrations(registrations: List<GitHubSelfHostedRunnerRegistration>) -> Int {
  fold(
    registrations,
    init: 0,
    f: (n, reg) => if github_runner_registration_is_schedulable(reg: reg) { n + 1 } else { n }
  )
}

fn count_executing_registrations(registrations: List<GitHubSelfHostedRunnerRegistration>) -> Int {
  fold(
    registrations,
    init: 0,
    f: (n, reg) => if github_runner_registration_is_online(reg: reg) && reg.busy { n + 1 } else { n }
  )
}

fn fleet_hosts() -> List<HostIdentity> {
  [operator_host_srv1, operator_host_srv2, operator_host_srv3, operator_host_srv4]
}

fn fleet_desired_width_total() -> Int {
  fold(
    fleet_hosts(),
    init: 0,
    f: (n, h) => n + gunbc_runner_slots_per_host(host: h)
  )
}

fn fleet_materialized_width_total() -> Int {
  fold(
    fleet_hosts(),
    init: 0,
    f: (n, h) => n + materialized_width_for_host(host: h)
  )
}

fn fleet_unit_active_width_total() -> Int {
  fold(
    fleet_hosts(),
    init: 0,
    f: (n, h) => n + unit_active_width_for_host(host: h)
  )
}

fn fleet_achieved_runner_widths_from_roster(
  roster: OrganizationRunnerRosterEvidence,
) -> FleetAchievedRunnerWidths {
  match roster {
    RosterReadUnavailable { reason: r } => AchievedWidthsUnobserved { reason: r }
    RosterObserved { observed_on: _, registrations: regs } =>
      AchievedWidthsObserved {
        registered_width: regs.length(),
        connected_width: count_online_registrations(registrations: regs),
        schedulable_width: count_schedulable_registrations(registrations: regs),
        executing_width: count_executing_registrations(registrations: regs),
      }
  }
}

fn fleet_runner_capacity_width_snapshot_from_roster(
  roster: OrganizationRunnerRosterEvidence,
) -> FleetRunnerCapacityWidthSnapshot {
  FleetRunnerCapacityWidthSnapshot {
    desired_width: fleet_desired_width_total(),
    materialized_width: fleet_materialized_width_total(),
    unit_active_width: fleet_unit_active_width_total(),
    achieved: fleet_achieved_runner_widths_from_roster(roster: roster),
  }
}

fn fleet_runner_capacity_width_snapshot() -> FleetRunnerCapacityWidthSnapshot {
  fleet_runner_capacity_width_snapshot_from_roster(roster: organization_runner_roster_evidence())
}

fn connectivity_verdicts_for_active_incarnations(
  roster: OrganizationRunnerRosterEvidence,
) -> List<RunnerSlotConnectivityVerdict>? {
  match local_runner_slot_incarnations() {
    Absent => none
    Present { value: incs } =>
      Present {
        value: map(
          incs,
          inc => runner_slot_connectivity_verdict_for_incarnation(incarnation: inc, roster: roster)
        )
      }
  }
}

fn connectivity_verdict_is_healthy(v: RunnerSlotConnectivityVerdict) -> Bool {
  match v {
    SlotConnectivityHealthy { slot: _, registration_id: _ } => true
    _ => false
  }
}

fn connectivity_verdict_is_detached(v: RunnerSlotConnectivityVerdict) -> Bool {
  match v {
    SlotConnectivityDetached { slot: _, registration_id: _ } => true
    _ => false
  }
}

fn connectivity_verdict_is_orphaned(v: RunnerSlotConnectivityVerdict) -> Bool {
  match v {
    SlotConnectivityOrphaned { slot: _ } => true
    _ => false
  }
}

fn connectivity_verdict_is_unknown(v: RunnerSlotConnectivityVerdict) -> Bool {
  match v {
    SlotConnectivityUnknown { slot: _, reason: _ } => true
    _ => false
  }
}

fn roster_unavailable_yields_unknown_not_detached(
  roster: OrganizationRunnerRosterEvidence,
) -> Bool {
  match roster {
    RosterReadUnavailable { reason: _ } =>
      match connectivity_verdicts_for_active_incarnations(roster: roster) {
        Absent => false
        Present { value: verdicts } =>
          all(
            verdicts,
            v => connectivity_verdict_is_unknown(v: v) && !connectivity_verdict_is_detached(v: v)
          )
      }
    RosterObserved { observed_on: _, registrations: _ } => true
  }
}
