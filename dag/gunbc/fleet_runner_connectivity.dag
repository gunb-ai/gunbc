  "self-hosted" as NonEmptyStr,
  "linux" as NonEmptyStr,
  "arm64" as NonEmptyStr,
  "gunbc-heavy" as NonEmptyStr,
]

fn github_organization_ref() -> GitHubOrganizationRef {
  GitHubOrganizationRef { login: gunbai_ci_declared.owner_login }
}

fn incident_registration(
  id: Nat,
  name: NonEmptyStr,
  status: GitHubRunnerRegistrationStatus,
  busy: Bool,
) -> GitHubSelfHostedRunnerRegistration {
  GitHubSelfHostedRunnerRegistration {
    id: id,
    name: name,
    status: status,
    busy: busy,
    ephemeral: true,
    version: incident_runner_version,
    os: "Linux" as NonEmptyStr,
    labels: incident_runner_labels,
  }
}

