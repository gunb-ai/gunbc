fn local_incarnations_for_host(host: HostIdentity, width: Int) -> List<LocalRunnerSlotIncarnation> {
  map(
    slot_indices_for_managed_width(width: width),
    i => runner_slot_incarnation(host: host, slot_index: i, unit_active: true),
  )
}

fn local_runner_slot_incarnations() -> List<LocalRunnerSlotIncarnation> {
  concat(
    local_incarnations_for_host(host: operator_host_srv1, width: materialized_width_for_host(host: operator_host_srv1)),
    concat(
      local_incarnations_for_host(host: operator_host_srv2, width: materialized_width_for_host(host: operator_host_srv2)),
      concat(
        local_incarnations_for_host(host: operator_host_srv3, width: materialized_width_for_host(host: operator_host_srv3)),
        local_incarnations_for_host(host: operator_host_srv4, width: materialized_width_for_host(host: operator_host_srv4))
      )
    )
  )
}

fn runner_slot_connectivity_verdict_for_incarnation(
  incarnation: LocalRunnerSlotIncarnation,
  roster: OrganizationRunnerRosterEvidence,
) -> RunnerSlotConnectivityVerdict {
  if !incarnation.unit_active {
    SlotConnectivityUnknown {
      slot: incarnation.slot,
      reason: "inactive systemd unit is outside the active-incarnation connectivity model"
    }
  } else {
    match roster {
      RosterReadUnavailable { reason: r } =>
        SlotConnectivityUnknown { slot: incarnation.slot, reason: r }
      RosterObserved { observed_on: _, registrations: regs } =>
        match find_registration_by_name(registrations: regs, name: incarnation.registration_name) {
          Absent => SlotConnectivityOrphaned { slot: incarnation.slot }
          Present { value: reg } =>
            match reg.status {
              GitHubRunnerOnline =>
                SlotConnectivityHealthy { slot: incarnation.slot, registration_id: reg.id }
              GitHubRunnerOffline =>
                SlotConnectivityDetached { slot: incarnation.slot, registration_id: reg.id }
            }
        }
    }
  }
}

fn runner_slot_connectivity_verdict(slot: RunnerSlotIdentity) -> RunnerSlotConnectivityVerdict {
  let roster = organization_runner_roster_evidence()
  let incarnations = local_runner_slot_incarnations()
  match fold(
    incarnations,
    init: none,
    f: (acc, inc) =>
      if (inc.slot.host as String) == (slot.host as String) && inc.slot.slot_index == slot.slot_index {
        Present {
          value: runner_slot_connectivity_verdict_for_incarnation(incarnation: inc, roster: roster)
        }
      } else {
        acc
      }
  ) {
    Absent =>
      SlotConnectivityUnknown {
        slot: slot,
        reason: "no local incarnation is modeled for this slot identity"
      }
    Present { value: v } => v
  }
}

fn count_online_registrations(registrations: List<GitHubSelfHostedRunnerRegistration>) -> Int {
  fold(
    registrations,
    init: 0,
    f: (n, reg) => if github_runner_registration_is_online(reg: reg) { n + 1 } else { n }
  )
}

fn count_schedulable_registrations(registrations: List<GitHubSelfHostedRunnerRegistration>) -> Int {
  fold(
    registrations,
    init: 0,
    f: (n, reg) => if github_runner_registration_is_schedulable(reg: reg) { n + 1 } else { n }
  )
}

fn count_executing_registrations(registrations: List<GitHubSelfHostedRunnerRegistration>) -> Int {
  fold(
    registrations,
    init: 0,
    f: (n, reg) => if github_runner_registration_is_online(reg: reg) && reg.busy { n + 1 } else { n }
  )
}

fn fleet_hosts() -> List<HostIdentity> {
  [operator_host_srv1, operator_host_srv2, operator_host_srv3, operator_host_srv4]
}

data incident_pinned_widths_note: String = "THE 2026-08-06 CORPUS IS PINNED ON EVERY HOST, NOT JUST srv4, AND THAT IS THE WHOLE POINT OF IT. This fold previously pinned srv4 alone and read gunbc_runner_slots_per_host live for srv1-srv3, so a historical incident total silently tracked present-day allocation. The 2026-08-17 16GiB ruling moved srv3 from 7 to 6 and the outage total would have become 21 while incident_2026_08_06_roster_note and its witness both say 22 — a pinned corpus contradicting itself because it was only half pinned.\n\nDESIGN section 5's test-oracle discipline is the authority: a historical measurement compared against a literal is legitimate only when the measurement is independently fixed, and half of this one was live. The widths below are what the fleet committed ON 2026-08-06 (srv1 5, srv2 5, srv3 7, srv4 5 with its then-live disk row-pin), summing to the 22 the roster note records. They are frozen by date and must never be updated to follow an allocation ruling; a future ruling changes what the fleet desires TODAY, not what it desired during that outage."

data incident_srv1_committed_width_at_outage: Int = 5

data incident_srv2_committed_width_at_outage: Int = 5

data incident_srv3_committed_width_at_outage: Int = 7

fn incident_committed_width_at_outage_for(host: HostIdentity) -> Int {
  if (host as String) == (operator_host_srv1 as String) {
    incident_srv1_committed_width_at_outage
  } else if (host as String) == (operator_host_srv2 as String) {
    incident_srv2_committed_width_at_outage
  } else if (host as String) == (operator_host_srv3 as String) {
    incident_srv3_committed_width_at_outage
  } else if (host as String) == (operator_host_srv4 as String) {
    incident_srv4_committed_width_at_outage
  } else {
    0
  }
}

fn incident_fleet_desired_width_at_outage() -> Int {
  fold(
    fleet_hosts(),
    init: 0,
    f: (n, h) => n + incident_committed_width_at_outage_for(host: h),
  )
}

fn fleet_desired_width_total() -> Int {
  fold(
    fleet_hosts(),
    init: 0,
    f: (n, h) => n + gunbc_runner_slots_per_host(host: h)
  )
}

fn fleet_materialized_width_total() -> Int {
  fold(
    fleet_hosts(),
    init: 0,
    f: (n, h) => n + materialized_width_for_host(host: h)
  )
}

fn fleet_unit_active_width_total() -> Int {
  fold(
    fleet_hosts(),
    init: 0,
    f: (n, h) => n + unit_active_width_for_host(host: h)
  )
}

fn fleet_achieved_runner_widths_from_roster(
  roster: OrganizationRunnerRosterEvidence,
) -> FleetAchievedRunnerWidths {
  match roster {
    RosterReadUnavailable { reason: r } => AchievedWidthsUnobserved { reason: r }
    RosterObserved { observed_on: _, registrations: regs } =>
      AchievedWidthsObserved {
        registered_width: regs.length(),
        connected_width: count_online_registrations(registrations: regs),
        schedulable_width: count_schedulable_registrations(registrations: regs),
        executing_width: count_executing_registrations(registrations: regs),
      }
  }
}

fn fleet_runner_capacity_width_snapshot_from_roster(
  roster: OrganizationRunnerRosterEvidence,
) -> FleetRunnerCapacityWidthSnapshot {
  FleetRunnerCapacityWidthSnapshot {
    desired_width: incident_fleet_desired_width_at_outage(),
    materialized_width: fleet_materialized_width_total(),
    unit_active_width: fleet_unit_active_width_total(),
    achieved: fleet_achieved_runner_widths_from_roster(roster: roster),
  }
}

fn fleet_runner_capacity_width_snapshot() -> FleetRunnerCapacityWidthSnapshot {
  fleet_runner_capacity_width_snapshot_from_roster(roster: organization_runner_roster_evidence())
}

fn connectivity_verdicts_for_active_incarnations(
  roster: OrganizationRunnerRosterEvidence,
) -> List<RunnerSlotConnectivityVerdict> {
  map(
    local_runner_slot_incarnations(),
    inc => runner_slot_connectivity_verdict_for_incarnation(incarnation: inc, roster: roster)
  )
}

fn connectivity_verdict_is_healthy(v: RunnerSlotConnectivityVerdict) -> Bool {
  match v {
    SlotConnectivityHealthy { slot: _, registration_id: _ } => true
    _ => false
  }
}

fn connectivity_verdict_is_detached(v: RunnerSlotConnectivityVerdict) -> Bool {
  match v {
    SlotConnectivityDetached { slot: _, registration_id: _ } => true
    _ => false
  }
}

fn connectivity_verdict_is_orphaned(v: RunnerSlotConnectivityVerdict) -> Bool {
  match v {
    SlotConnectivityOrphaned { slot: _ } => true
    _ => false
  }
}

fn connectivity_verdict_is_unknown(v: RunnerSlotConnectivityVerdict) -> Bool {
  match v {
    SlotConnectivityUnknown { slot: _, reason: _ } => true
    _ => false
  }
}

fn roster_unavailable_yields_unknown_not_detached(
  roster: OrganizationRunnerRosterEvidence,
) -> Bool {
  match roster {
    RosterReadUnavailable { reason: _ } =>
      all(
        connectivity_verdicts_for_active_incarnations(roster: roster),
        v => connectivity_verdict_is_unknown(v: v) && !connectivity_verdict_is_detached(v: v)
      )
    RosterObserved { observed_on: _, registrations: _ } => true
  }
}
