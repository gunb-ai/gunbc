data fleet_runner_connectivity_authority_disposition: Disposition = Terminal {
  reason: "Single authority for GITHUB REGISTRATION CONNECTIVITY versus LOCAL RUNNER INCARNATIONS. It joins one org-level registration roster (remote ground truth from the GitHub Actions runners API) to per-slot stable identities (host, index) and their local systemd incarnations. It does NOT repair wedged runners — that is PR B. It refuses to fold connected width into desired width, and it refuses to treat a roster read failure as 'everything detached' (empty-observation narrow)."
}

data organization_roster_is_one_org_read_note: String = "THE ROSTER IS ONE CENTRAL ORG READ, not a per-host poll. GitHub's org runners API returns every self-hosted registration for the organization in one response; slot health is derived by joining that roster to stable (host, index) identities. The gunbai-ci GitHub App carries organization_self_hosted_runners read permission for this producer. Local journal mining and per-host gh api calls are not the authority for whether GitHub will schedule work onto a registration."

data achieved_widths_are_orthogonal_to_desired_width_note: String = "THE ACHIEVED AXES HERE ARE ORTHOGONAL TO gunbc.runner_slot_allocation's desired-side widths (#7930 candidate/actuatable/observed). registered_width counts GitHub org roster rows; connected_width counts status == online; schedulable_width counts online AND NOT busy; executing_width counts online AND busy. desired_width is INTENT from gunbc_runner_slots_per_host and does NOT reconcile down when connected collapses during an outage. unit_active_width counts active systemd units (never slot directories — see do_not_count_directories_for_width_note). materialized_width names on-disk install artifacts separately until a live producer grounds them."

type OrganizationRunnerRosterEvidence
  = RosterObserved { observed_on: NonEmptyStr, registrations: List<GitHubSelfHostedRunnerRegistration> }
  | RosterReadUnavailable { reason: String }

type FleetAchievedRunnerWidths
  = AchievedWidthsObserved {
      registered_width: Int
      connected_width: Int
      schedulable_width: Int
      executing_width: Int
    }
  | AchievedWidthsUnobserved { reason: String }

type LocalRunnerSlotIncarnation {
  slot: RunnerSlotIdentity
  unit: NonEmptyStr
  unit_active: Bool
  registration_name: NonEmptyStr
}

type RunnerSlotConnectivityVerdict
  = SlotConnectivityHealthy { slot: RunnerSlotIdentity, registration_id: Nat }
  | SlotConnectivityDetached { slot: RunnerSlotIdentity, registration_id: Nat }
  | SlotConnectivityOrphaned { slot: RunnerSlotIdentity }
  | SlotConnectivityUnknown { slot: RunnerSlotIdentity, reason: String }

type FleetRunnerCapacityWidthSnapshot {
  desired_width: Int
  materialized_width: Int
  unit_active_width: Int
  achieved: FleetAchievedRunnerWidths
}

data incident_2026_08_06_roster_note: String = "PINNED ACCEPTANCE CORPUS from the live GitHub org runners API during the 2026-08-06 broker-session incident (15 of 16 registrations offline; 1 functional runner). srv1 registered 01-05 with only 01 online+busy; srv2 registered 01,02,05 all offline with 03,04 absent; srv3 registered 01,02,04,05 all offline with 03 absent; srv4 registered 01,02,04,05 all offline with 03 absent. desired_width stays 22 while connected is 1."

data incident_runner_version: NonEmptyStr = "2.334.0"

data incident_runner_labels: List<NonEmptyStr> = [
  "self-hosted" as NonEmptyStr,
  "linux" as NonEmptyStr,
  "arm64" as NonEmptyStr,
  "gunbc-heavy" as NonEmptyStr,
]

fn github_organization_ref() -> GitHubOrganizationRef {
  GitHubOrganizationRef { login: gunbai_ci_declared.owner_login }
}

fn incident_registration(
  id: Nat,
  name: NonEmptyStr,
  status: GitHubRunnerRegistrationStatus,
  busy: Bool,
) -> GitHubSelfHostedRunnerRegistration {
  GitHubSelfHostedRunnerRegistration {
    id: id,
    name: name,
    status: status,
    busy: busy,
    ephemeral: true,
    version: incident_runner_version,
    os: "Linux" as NonEmptyStr,
    labels: incident_runner_labels,
  }
}

