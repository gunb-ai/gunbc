data organization_runner_roster_producer_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.fleet_runner_connectivity",
    decl_name: "organization_runner_roster_show_effective_read",
    field: WholeDeclaration,
  }
}

data organization_runner_roster_show_effective_read: ShowEffectiveRead<OrganizationRunnerRosterEvidence> = ReadAbsent {
  reason: "no live org-level GET /orgs/gunb-ai/actions/runners has executed through the gunbai-ci GitHub App yet; the incident fixture in organization_runner_roster_evidence is the pinned acceptance corpus until this read binds ReadObserved"
}

fn registration_matches_name(
  reg: GitHubSelfHostedRunnerRegistration,
  name: NonEmptyStr,
) -> Bool {
  (reg.name as String) == (name as String)
}

fn find_registration_by_name(
  registrations: List<GitHubSelfHostedRunnerRegistration>,
  name: NonEmptyStr,
) -> GitHubSelfHostedRunnerRegistration? {
  fold(
    registrations,
    init: none,
    f: (acc, reg) =>
      if registration_matches_name(reg: reg, name: name) {
        Present { value: reg }
      } else {
        acc
      }
  )
}

data incident_local_materialized_width_note: String = "ACTIVATED WIDTH vs INSTALL-TREE COUNT (operator correction 2026-08-07): counts ACTIVATED units, not install trees. srv1: 50 trees / 5 active; srv3: 8 materialized trees (includes 08) / 5 active — committed width 7 is memory ceiling, not materialization cap. Dormant trees are SlotMaterializedNotActive; stale .runner does not block ADD."

fn materialized_width_for_host(host: HostIdentity) -> Int {
  if (host as String) == (operator_host_srv1 as String) {
    5
  } else if (host as String) == (operator_host_srv2 as String) {
    5
  } else if (host as String) == (operator_host_srv3 as String) {
    5
  } else if (host as String) == (operator_host_srv4 as String) {
    5
  } else {
    0
  }
}

fn unit_active_width_for_host(host: HostIdentity) -> Int {
  materialized_width_for_host(host: host)
}

data converged_seven_roster_observed_on: NonEmptyStr = "converged-seven-fixture" as NonEmptyStr

fn host_registration_name_for_slot(host: HostIdentity, slot_index: Nat) -> NonEmptyStr {
  join([host as String, "-", slot_suffix(slot_index: slot_index)], "") as NonEmptyStr
}

fn slot_indices_for_managed_width(width: Int) -> List<Nat> {
  nat_range_inclusive(lo: 1, hi: width)
}

fn count_host_registrations_at_width(
  host: HostIdentity,
  width: Int,
  registrations: List<GitHubSelfHostedRunnerRegistration>,
) -> Int {
  fold(
    slot_indices_for_managed_width(width: width),
    init: 0,
    f: (n, slot_index) =>
      match find_registration_by_name(
        registrations: registrations,
        name: host_registration_name_for_slot(host: host, slot_index: slot_index),
      ) {
        Present { value: _ } => n + 1
        Absent => n
      },
  )
}

fn count_host_online_at_width(
  host: HostIdentity,
  width: Int,
  registrations: List<GitHubSelfHostedRunnerRegistration>,
) -> Int {
  fold(
    slot_indices_for_managed_width(width: width),
    init: 0,
    f: (n, slot_index) =>
      match find_registration_by_name(
        registrations: registrations,
        name: host_registration_name_for_slot(host: host, slot_index: slot_index),
      ) {
        Present { value: reg } =>
          if github_runner_registration_is_online(reg: reg) {
            n + 1
          } else {
            n
          }
        Absent => n
      },
  )
}

fn roster_is_converged_seven_fixture(roster: OrganizationRunnerRosterEvidence) -> Bool {
  match roster {
    RosterObserved { observed_on: observed_on, registrations: _ } =>
      (observed_on as String) == (converged_seven_roster_observed_on as String)
    RosterReadUnavailable { reason: _ } => false
  }
}

