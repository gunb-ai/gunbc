data fleet_runner_connectivity_authority_disposition: Disposition = Terminal {
  reason: "Single authority for GITHUB REGISTRATION CONNECTIVITY versus LOCAL RUNNER INCARNATIONS. It joins one org-level registration roster (remote ground truth from the GitHub Actions runners API) to per-slot stable identities (host, index) and their local systemd incarnations. It does NOT repair wedged runners — that is PR B. It refuses to fold connected width into desired width, and it refuses to treat a roster read failure as 'everything detached' (empty-observation narrow)."
}

data organization_roster_is_one_org_read_note: String = "THE ROSTER IS ONE CENTRAL ORG READ, not a per-host poll. GitHub's org runners API returns every self-hosted registration for the organization in one response; slot health is derived by joining that roster to stable (host, index) identities. The gunbai-ci GitHub App carries organization_self_hosted_runners read permission for this producer. Local journal mining and per-host gh api calls are not the authority for whether GitHub will schedule work onto a registration."

data achieved_widths_are_orthogonal_to_desired_width_note: String = "THE ACHIEVED AXES HERE ARE ORTHOGONAL TO gunbc.runner_slot_allocation's desired-side widths (#7930 candidate/actuatable/observed). registered_width counts GitHub org roster rows; connected_width counts status == online; schedulable_width counts online AND NOT busy; executing_width counts online AND busy. desired_width is INTENT from gunbc_runner_slots_per_host and does NOT reconcile down when connected collapses during an outage. materialized_width and unit_active_width are LOCAL incarnation facts pinned from the incident corpus until the local producer grounds them."

type OrganizationRunnerRosterEvidence
  = RosterObserved { observed_on: NonEmptyStr, registrations: List<GitHubSelfHostedRunnerRegistration> }
  | RosterReadUnavailable { reason: String }

type FleetAchievedRunnerWidths
  = AchievedWidthsObserved {
      registered_width: Int
      connected_width: Int
      schedulable_width: Int
      executing_width: Int
    }
  | AchievedWidthsUnobserved { reason: String }

type RegistrationSlotDecoding
  = RegistrationNamesCommittedSlot { slot: RunnerSlotIdentity }
  | RegistrationNamesNoCommittedSlot { registration_name: NonEmptyStr }

// THE DECODER DOES NOT PARSE. Splitting "srv3-06" back into a host and an index would be a SECOND
// naming authority read in the opposite direction from the first, and the two could disagree without
// anything detecting it. The committed population is finite and already enumerable, so decoding is a
// total decision over it: which committed identity's own name equals this registration's name. That is
// the forward naming authority read backward (DESIGN section 4, one grammar in both directions) rather
// than an inverse re-implemented beside it, and a name matching nothing is not a parse failure -- it is
// the answer RegistrationNamesNoCommittedSlot, which is a fact about the fleet rather than about text.
//
// THE FORK IS DISSOLVED, AND IT WAS FIVE SITES RATHER THAN THE THREE AN EARLIER REVISION OF THIS
// NOTE CLAIMED. One rule -- pad a slot index to two digits -- had four independent implementations
// (runner_lifecycle, runner_host_deploy, runner_incarnation, and host_registration_name_for_slot
// just below, which reached it through a shared bucketed helper). Three derived the pad
// arithmetically; runner_incarnation's slot_suffix ENUMERATED indices 1 through 8 with an else arm
// returning the literal "00". Measured before the fix: srv3-09 from the derived sites, srv3-00 from
// the enumerator -- a COLLISION rather than a wrong name, since every index above 8 produced the
// same string and two slots would contend for one GitHub registration.
//
// All of them now route through gunbc.build_cache_instance runner_slot_index_suffix, which is the
// identity's own module and therefore the rule's layer. Derived, total over Nat, no fall-through to
// reach. My census of this fork said three sites twice -- to a reviewer and in a PR body -- and it
// was five; the two I missed were the ones that reached the rule INDIRECTLY, which is the same
// shape as every other undercount in this lane: I grepped for the thing I was looking for rather
// than enumerating the declarations.
//
// ONE INDEPENDENT IMPLEMENTATION SURVIVES DELIBERATELY, in host_converge_slice1_witness_test, which
// builds its own expected name inline. That is not a missed site: a witness that computes its
// expectation by calling the production function proves only that the function equals itself. Its
// pad is an independent oracle and consolidating it would convert a check into a tautology.
fn fleet_committed_slot_identities() -> List<RunnerSlotIdentity> {
  fold(
    fleet_hosts(),
    init: [],
    f: (acc, h) => concat(acc, committed_slot_identities(host: h))
  )
}

fn decode_registration_slot(reg: GitHubSelfHostedRunnerRegistration) -> RegistrationSlotDecoding {
  match fold(
    fleet_committed_slot_identities(),
    init: none,
    f: (acc, id) =>
      match acc {
        Present { value: v } => Present { value: v }
        Absent =>
          if runner_slot_instance_name(slot: id) == (reg.name as String) {
            Present { value: id }
          } else {
            none
          }
      }
  ) {
    Present { value: id } => RegistrationNamesCommittedSlot { slot: id }
    Absent => RegistrationNamesNoCommittedSlot { registration_name: reg.name }
  }
}

type RunnerSlotConnectivityVerdict
  = SlotConnectivityHealthy { slot: RunnerSlotIdentity, registration_id: Nat }
  | SlotConnectivityDetached { slot: RunnerSlotIdentity, registration_id: Nat }
  | SlotConnectivityOrphaned { slot: RunnerSlotIdentity }
  | SlotConnectivityUnknown { slot: RunnerSlotIdentity, reason: String }
  | SlotConnectivityUnexpectedRegistration {
      registration_id: Nat
      registration_name: NonEmptyStr
      decoded: RegistrationSlotDecoding
    }

// THIS ARM CARRIES THE REGISTRATION'S OWN IDENTITY AND NOT A SLOT, AND THAT IS THE WHOLE POINT OF IT.
// The other four arms each carry a RunnerSlotIdentity taken from a LOCAL incarnation, because they are
// produced by mapping over local_runner_slot_incarnations. A registration GitHub holds that we never
// provisioned locally has no incarnation to be mapped from, so it was not mis-reported by those four --
// it was unsayable, and no check could close it because there was nothing for a check to read.
// Giving this arm a slot field would have rebuilt that same blindness inside the fix: it would have
// forced an unexpected registration to be described in terms of a local slot that by construction does
// not exist. It carries `decoded` instead, so a consumer can tell the two cases apart -- a registration
// whose name resolves to a COMMITTED slot identity is the disjointness violation this model exists for
// (an actions-runner sitting on a fabric-purpose slot), while one that resolves to nothing is a
// foreign runner in the org. Those are different facts and a single Bool would have merged them.

type FleetRunnerCapacityWidthSnapshot {
  desired_width: Int
  materialized_width: Int
  unit_active_width: Int
  achieved: FleetAchievedRunnerWidths
}

data incident_2026_08_06_roster_note: String = "PINNED ACCEPTANCE CORPUS from the live GitHub org runners API during the 2026-08-06 broker-session incident (15 of 16 registrations offline; 1 functional runner). srv1 registered 01-05 with only 01 online+busy; srv2 registered 01,02,05 all offline with 03,04 absent; srv3 registered 01,02,04,05 all offline with 03 absent; srv4 registered 01,02,04,05 all offline with 03 absent. desired_width stays 22 while connected is 1 — derived at incident_fleet_desired_width_at_outage (srv4 still carried the five-slot disk row-pin on 2026-08-06. The live total is DERIVED by fleet_desired_width_total rather than pinned here, so it tracks gunbc_runner_slots_per_host: it read 24 while srv3/srv4 committed 7, and reads 22 since the 2026-08-17 16GiB ruling moved both managed hosts to 6. The incident figure of 22 is a DIFFERENT QUANTITY that happens to share the number — it is what the roster desired on 2026-08-06 (5+5+7+5, srv4 row-pinned), and it comes from the pinned per-host rows in incident_pinned_widths_note, never from the live allocation.)"

