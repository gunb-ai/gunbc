module gunbc.serve_cookie_header_seed_growth

import gunbc.roadmap_model { RoadmapNodeId }
import gunbc.seed_growth { SeedGrowthJustification }
import std.decl_ref { DeclarationRef, WholeDeclaration }

// Seed-growth obligation for the session-cookie channel and typed response headers on the seed's
// serve transport (gunbc#13004). PURPOSE ADMISSION (gunbc.v1_maintenance_standing
// v1_seed_standing): the served dashboard is the operator surface through which v2 work is
// reviewed, approved and allocated, and #12787 left its login routes undelivered for exactly this
// reason ("their redirect and Set-Cookie answers need a socket runtime that writes response
// headers, which this revision's seed does not"). The growth is confined to the two wire
// operations no .dag fold can perform on a live connection -- reading one named request header,
// writing response header lines -- and every decision (which cookie, what it authenticates, which
// headers to set, with what attributes) is in extdeps.http.server and gunbc.roadmap_serve.
data serve_cookie_header_seed_growth_justification: SeedGrowthJustification = SeedGrowthJustification {
  hand_authored_declarations: [
    DeclarationRef { module_path: "v1_compiler.cli_run", decl_name: "serve_wire_header_line", field: WholeDeclaration }
  ],
  reason: "Reading a request header off an accepted connection and writing response header bytes are host operations on a live socket, in the same class as the listener and peer read gunbc.fabric_door_socket_seed_growth already rosters. serve_wire_header_line spells the RFC 9110 name of each arm of the closed extdeps.http.server ServeWireHeaderName coproduct and refuses a value carrying CR, LF or NUL. The request half of this channel is no longer a named header in the seed: gunbc.serve_declared_binding_seed_growth binds a served entry's arguments by its declared parameters, and the Cookie field is selected in gunbc.roadmap_serve.",
  owning_dissolution_lane: "v1-hand-queue-drain" as RoadmapNodeId,
  trigger: "Delete it when `serve` is a verb of the v2-native CLI door (v2.cli.compile_cli) whose request read and response write are a modeled host effect (an extdeps socket interface carrying typed request headers and ServeWireHeader) that the rendered main realizes -- the same trigger as gunbc.fabric_door_socket_seed_growth, because it is the same transport.",
  current_boundary: "Confined to v1_compiler.cli_run handle_serve, serve_write_response and serve_wire_fields: the response write renders the handler's typed headers after the framing headers the seam owns. A handler that sets no headers produces exactly the pre-change bytes. Tests: cli_run serve_unix_socket_door_tests."
}
