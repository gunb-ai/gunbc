// THE PALETTE IS CITED AND THE CHANNELS ARE DERIVED. gunbc.design.catalog carries okabe_ito as a
// CitedUpstream set anchored at jfly.uni-koeln.de, and it is the right set for this sheet for a
// reason beyond availability: the column a reader scans fastest is Standing, and Okabe-Ito is
// constructed to stay distinguishable under the common colour vision deficiencies. A palette
// chosen to look pleasant would fail exactly the reader who most needs the distinction.
//
// AN EARLIER REVISION TRANSCRIBED EACH CHANNEL AS A DECIMAL and said the corpus could not compute
// the quotient. That was false, and it is worth recording because the false claim was about to be
// landed as declared debt: std.coercion enrols Int -> Float as an admitted cast, std.integer
// derives the 8-bit inclusive maximum, and (158 as Float) / (255 as Float) evaluates. Nothing had
// to be transcribed. The swatches below are references to the cited rows, and every channel is a
// division this module performs.
//
// THE MAXIMUM IS OPTIONAL AND SO IS THE COLOUR. uint8_channel_inclusive_max_value_derived returns
// Int? because it is derived through a bounded exponentiation that can decline. A colour that
// cannot be derived is therefore a reading rather than a value, and a format step holding one
// refuses instead of substituting a default -- a wrong colour is a silently wrong sheet, which is
// worse than a step that says why it did not run.
type SheetsColorReading
  = SheetsColorDerived { color: SheetsColor }
  | SheetsColorUnderivable { cause: NonEmptyStr }

fn sheets_channel(value: Int, inclusive_max: Int) -> Float {
  (value as Float) / (inclusive_max as Float)
}

fn sheets_color_from_srgb8(c: Srgb8) -> SheetsColorReading {
  match uint8_channel_inclusive_max_value_derived() {
    Absent =>
      SheetsColorUnderivable {
        cause: "std.integer uint8_channel_inclusive_max_value_derived declined, so an 8-bit channel has no inclusive maximum to divide by and no Sheets channel can be derived from this swatch" as NonEmptyStr
      }
    Present { value: m } =>
      SheetsColorDerived {
        color: SheetsColor {
          red: sheets_channel(value: c.r, inclusive_max: m),
          green: sheets_channel(value: c.g, inclusive_max: m),
          blue: sheets_channel(value: c.b, inclusive_max: m),
        }
      }
  }
}

fn standing_admitted_color() -> SheetsColorReading {
  sheets_color_from_srgb8(c: okabe_ito_bluish_green)
}

fn standing_refused_color() -> SheetsColorReading {
  sheets_color_from_srgb8(c: okabe_ito_vermillion)
}

fn header_background_color() -> SheetsColorReading {
  sheets_color_from_srgb8(c: okabe_ito_blue)
}

// NOT A PALETTE HUE, AND DERIVED RATHER THAN WRITTEN. White is the ground the header figure sits
// on, not a colour chosen from a set, and okabe_ito carries no white -- borrowing across swatch
// sets to satisfy a sentence would be worse than saying this plainly. It is still derived: every
// channel at the 8-bit inclusive maximum IS white, so the same fold answers for it and the literal
// 255 never appears.
fn header_foreground_color() -> SheetsColorReading {
  match uint8_channel_inclusive_max_value_derived() {
    Absent =>
      SheetsColorUnderivable {
        cause: "the 8-bit inclusive maximum declined, so full-intensity white cannot be derived" as NonEmptyStr
      }
    Present { value: m } => sheets_color_from_srgb8(c: Srgb8 { r: m, g: m, b: m })
  }
}

data review_sheet_header_row_count: Int = 1

// THE SHEET'S SHAPE IS NOT THIS MODULE'S FACT AND AN EARLIER REVISION AUTHORED IT TWICE OVER. It
// carried `review_sheet_column_count: Int = 17` and `standing_column_index: Int = 3` as bare
// literals, while gunbc.review_sheet_projection ReviewSheetSchema already owns the column roster
// and marks the standing column with the ListingStanding kind. Two sources for "how wide is this
// sheet" and "which column is Standing" can produce different answers, and this pair would have
// drifted SILENTLY: format_is_converged checks frozen rows, header colours and a rule count, never
// extent or column position, so adding one derived column would leave the header band stopping
// short and the conditional rule painting a column that is no longer Standing -- with every call
// answering success and the converge still reporting converged.
//
// Both are derived from the supplied schema now. A schema with no ListingStanding column cannot be
// formatted and says so, rather than colouring index 3 and hoping.
//
// THE HEADER ROW'S EXTENT AND THE STANDING COLUMN'S POSITION ARE READ OFF THE VALIDATED HEADER ROW,
// NOT OFF THE COLUMN ROSTER. They differ: gunbc.review_sheet_projection renders the identity column
// ahead of the roster when the schema does not carry it as a column, so for a schema of that shape
// `count(schema.columns)` is one short of the header row and every column's sheet position is one
// to the left of where the roster puts it. A band sized that way stops before the last header and a
// conditional rule keyed that way paints the column beside Standing -- both silently, both reported
// as applied. Taking ValidatedHeaderSchema rather than ReviewSheetSchema is what makes that
// unwritable here: this module has no way to construct the carrier and so cannot re-derive the row.
//
// THE EXTENT IS READ THROUGH review_sheet_header_count AND THIS MODULE DECLARES NO NAME FOR IT.
// An earlier revision kept a local `schema_column_count(validated)` whose whole body had become
// `review_sheet_header_count(validated: validated)` -- one concept answering to two exported names
// across two modules, which is the DESIGN section 3 fork, and the witness was importing both. The
// passthrough was load-bearing while it folded `count(schema.columns)`; once the extent moved to
// the projection it was a nickname (review 68548).

type StandingColumnIndex
  = StandingColumnAt { index: Int }
  | StandingColumnAbsent

// The FIRST ListingStanding column wins and later ones are ignored rather than refused, because a
// schema carrying two is a defect in the schema and this module is not its validator.
fn first_standing_column_name(schema: ReviewSheetSchema) -> NonEmptyStr? {
  schema.columns
    |> filter(c => match c.kind {
      ListingStanding => true
      DerivedField { source_field: _ } => false
      OperatorEntered => false
      DerivedErasureMark => false
    })
    |> map(c => c.name)
    |> first
}

fn header_index_of(validated: ValidatedHeaderSchema, name: NonEmptyStr) -> Int? {
  review_sheet_header_names(validated: validated)
    |> enumerate
    |> filter(pair => (pair.second as String) == (name as String))
    |> map(pair => pair.first)
    |> first
}

fn standing_column_index(validated: ValidatedHeaderSchema) -> StandingColumnIndex {
  match first_standing_column_name(schema: validated_schema(validated: validated)) {
    Absent => StandingColumnAbsent
    Present { value: name } =>
      match header_index_of(validated: validated, name: name) {
        Absent => StandingColumnAbsent
        Present { value: i } => StandingColumnAt { index: i }
      }
  }
}

type FormatStepOutcome
  = FormatStepApplied { step: NonEmptyStr }
  | FormatStepRefused { step: NonEmptyStr, cause: NonEmptyStr }

// A FORMAT WRITE HAS NO READBACK HERE AND THAT IS A STATED LIMIT, not an oversight. Reading a
// cell's format back means spreadsheets.get with includeGridData, a response shape this module does
// not model, so these steps report what the API answered and nothing about what the sheet now
// looks like. That is weaker evidence than the values converge carries, and the honest consequence
// is that formatting is NOT idempotent-by-observation: re-running re-applies rather than adopting.
// Conditional rules in particular accumulate, which is why the rule steps take an explicit index.
fn classify_format_step(step: NonEmptyStr, outcome: RestRefusal) -> FormatStepOutcome {
  match classify_rest_refusal(standing: RestMutationExchange { refusal: outcome }) {
    RestExchangeStatusRefused { status, body } =>
      FormatStepRefused {
        step: step,
        cause: join(["refused with status ", to_string(status), ": ", body], "") as NonEmptyStr
      }
    RestExchangeUnreached { cause } =>
      FormatStepRefused { step: step, cause: join(["never reached Sheets: ", cause as String], "") as NonEmptyStr }
    RestExchangeUndecodable { status, cause } =>
      FormatStepRefused {
        step: step,
        cause: join(["answered ", to_string(status), " with an unreadable body: ", cause as String], "") as NonEmptyStr
      }
    RestExchangeCommitAmbiguous { detail } =>
      FormatStepRefused {
        step: step,
        cause: join(["left the write ambiguous: ", detail], "") as NonEmptyStr
      }
  }
}

// THE REQUESTS ARE DERIVED BEFORE ANY OF THEM IS SENT, AND THAT IS WHAT MAKES THE ADDRESSING
// WITNESSABLE. Every batchUpdate below names a sheetId, and until this change every one of them
// named a first-sheet constant of 0 (since deleted with its last consumer) -- so the formatter wrote to
// whatever tab happened to be first, in a file whose tab identity nothing had established. The
// sheetId now comes from a gunbc.review_sheet_tab_locator LocatedReviewTab, which has no
// constructor outside the function that read the workbook's metadata.
//
// The request records exist so that the addressing is a VALUE a claim can read rather than an
// argument inside an effect. format_request_plan is a pure fold from the located tab and the
// schema to every request this actuator would send, and test.claim.review_sheet_format_target_witness
// asserts that each one carries the located sheetId; the step functions take a request and pass
// its fields through. WHAT THAT DOES NOT ESTABLISH, said plainly: the claim reads the plan, not the
// wire, so it discriminates a plan built from the constant and does NOT discriminate a step
// rewritten to ignore the request it was handed. Closing that needs the mock corpus to carry the
// three batchUpdate operations, which it does not.
// THE REQUEST RECORDS ARE SEALED, AND THAT IS WHAT KEEPS THE EFFECTS BEHIND THE LOCATED TAB.
// These records exist so the addressing is a VALUE a claim can read rather than an argument buried
// in an effect. As ordinary records that was a bypass of the whole discipline above: every
// batchUpdate function below takes one, none of them was admission-restricted, and a record anyone
// could author meant a foreign module could call freeze_header or format_review_sheet with a
// spreadsheet id and sheet id it chose -- formatting an arbitrary tab of an arbitrary workbook
// without obtaining a LocatedReviewTab, validating a header schema, or running the converge at all
// (side-chat hold on gunbc#11725). The production entry required a located tab; the effects did not.
//
// THE CLOSURE IS ON THE INPUT, NOT ON THE CALLERS, for the same reason the carrier's was. Sealing
// five effectful functions to their exact predecessors would work and would leave confinement
// depending on an admission list staying complete as this module grows -- the two-lists-with-no-join
// defect that has already cost this branch a false seal claim and two silent mutation gaps. Instead
// every request record is sole_constructor and the ONLY expressions that build them are the three
// builders below, each of which requires a LocatedReviewTab. An unconstructible argument needs no
// guard on the function that consumes it: the effect functions stay unrestricted because there is
// no way to reach them except through a plan derived from a tab that was actually read.
//
// WHAT THAT LEAVES OPEN, said rather than implied: read_format_at takes a range String beside the
// located tab, so a caller holding a genuine tab may read any range WITHIN that spreadsheet. The
// subject stays confined -- the spreadsheet and tab are the located ones -- and it is a read, not a
// mutation. Narrowing the range to a derived value is the next rung and nothing today needs it.
type FreezeRowsRequest sole_constructor {
  spreadsheet_id: String
  sheet_id: Int
  frozen_row_count: Int
}

type HeaderBandRequest sole_constructor {
  spreadsheet_id: String
  sheet_id: Int
  start_row: Int
  end_row: Int
  start_col: Int
  end_col: Int
}

type StandingRuleRequest sole_constructor {
  spreadsheet_id: String
  sheet_id: Int
  start_row: Int
  start_col: Int
  end_col: Int
  condition: FormatRuleCondition
  rule_index: Int
  color: SheetsColorReading
}

fn freeze_rows_request(tab: LocatedReviewTab) -> FreezeRowsRequest {
  FreezeRowsRequest {
    spreadsheet_id: tab.spreadsheet_id as String,
    sheet_id: tab.sheet_id,
    frozen_row_count: review_sheet_header_row_count,
  }
}

fn header_band_request(tab: LocatedReviewTab, validated: ValidatedHeaderSchema) -> HeaderBandRequest {
  HeaderBandRequest {
    spreadsheet_id: tab.spreadsheet_id as String,
    sheet_id: tab.sheet_id,
    start_row: 0,
    end_row: review_sheet_header_row_count,
    start_col: 0,
    end_col: review_sheet_header_count(validated: validated),
  }
}

fn standing_rule_request(
  tab: LocatedReviewTab,
  rule: FormatRule,
  rule_index: Int,
  column_index: Int,
) -> StandingRuleRequest {
  StandingRuleRequest {
    spreadsheet_id: tab.spreadsheet_id as String,
    sheet_id: tab.sheet_id,
    start_row: review_sheet_header_row_count,
    start_col: column_index,
    end_col: column_index + 1,
    condition: rule.condition,
    rule_index: rule_index,
    color: rule.color,
  }
}

// A RULE IS A ROW: the column it colours by NAME, the substring it matches and the colour it paints.
// The format of a kind is the list of these, so a kind that colours three columns and a kind that
// colours one are the same shape and a new kind adds rows rather than fields (DESIGN section 6b).
// The column is a name because a position is a second authority for what the schema already says;
// it resolves against the validated header, and a name the header does not carry refuses the plan.
type FormatRule {
  column: NonEmptyStr
  condition: FormatRuleCondition
  color: SheetsColorReading
}

// WHAT A RULE MATCHES, as the upstream condition it lowers to. A substring colours a closed
// vocabulary cell by its member's name; a number colours a count above a named threshold. Each arm
// is one extdeps.google.sheets SheetsBooleanConditionType and its one value, so a rule cannot ask
// for a comparison upstream cannot express.
type FormatRuleCondition
  = RuleTextContains { fragment: String }
  | RuleNumberGreater { threshold: Int }

fn format_rule_condition_type(c: FormatRuleCondition) -> SheetsBooleanConditionType {
  match c {
    RuleTextContains { fragment: _ } => ConditionTextContains
    RuleNumberGreater { threshold: _ } => ConditionNumberGreater
  }
}

fn format_rule_condition_value(c: FormatRuleCondition) -> String {
  match c {
    RuleTextContains { fragment: f } => f
    RuleNumberGreater { threshold: n } => to_string(n)
  }
}

fn format_rule_condition_text(c: FormatRuleCondition) -> String {
  match c {
    RuleTextContains { fragment: f } => join(["containing ", f], "")
    RuleNumberGreater { threshold: n } => join(["greater than ", to_string(n)], "")
  }
}

// A COLUMN WIDTH IS A ROW TOO: the column by name and the pixels it should be. The pixels are the
// kind's to derive (gunbc.review_sheet_kind derives them from each column's declared content), and
// this module resolves the name against the validated header exactly as it resolves a rule's.
type ColumnWidth {
  column: NonEmptyStr
  pixels: DisplayPixelCount
}

type ColumnWidthRequest sole_constructor {
  spreadsheet_id: String
  sheet_id: Int
  column_index: Int
  pixel_size: DisplayPixelCount
}

fn resolved_width_request(tab: LocatedReviewTab, validated: ValidatedHeaderSchema, width: ColumnWidth) -> List<ColumnWidthRequest> {
  match header_index_of(validated: validated, name: width.column) {
    Absent => []
    Present { value: i } =>
      [ColumnWidthRequest { spreadsheet_id: tab.spreadsheet_id as String, sheet_id: tab.sheet_id, column_index: i, pixel_size: width.pixels }]
  }
}

type FormatRequestPlan sole_constructor {
  freeze: FreezeRowsRequest
  header: HeaderBandRequest
  rules: List<StandingRuleRequest>
  widths: List<ColumnWidthRequest>
}

type FormatPlanOutcome
  = FormatPlanned { plan: FormatRequestPlan }
  | FormatPlanRefused { cause: NonEmptyStr }

fn resolved_rule_request(
  tab: LocatedReviewTab,
  validated: ValidatedHeaderSchema,
  index: Int,
  rule: FormatRule,
) -> List<StandingRuleRequest> {
  match header_index_of(validated: validated, name: rule.column) {
    Absent => []
    Present { value: i } => [standing_rule_request(tab: tab, rule: rule, rule_index: index, column_index: i)]
  }
}

fn format_request_plan(tab: LocatedReviewTab, validated: ValidatedHeaderSchema, rules: List<FormatRule>, widths: List<ColumnWidth>) -> FormatPlanOutcome {
  let requests = flat_map(enumerate(rules), p => resolved_rule_request(tab: tab, validated: validated, index: p.first, rule: p.second))
  let width_requests = flat_map(widths, w => resolved_width_request(tab: tab, validated: validated, width: w))
  if count(requests) == count(rules) && count(width_requests) == count(widths) {
    FormatPlanned {
      plan: FormatRequestPlan {
        freeze: freeze_rows_request(tab: tab),
        header: header_band_request(tab: tab, validated: validated),
        rules: requests,
        widths: width_requests,
      }
    }
  } else {
    FormatPlanRefused {
      cause: "a format rule or column width names a column the validated header does not carry, so applying it would format whatever now sits at a guessed position" as NonEmptyStr
    }
  }
}

fn set_column_width(q: ColumnWidthRequest) -> FormatStepOutcome {
  let step = join(["width of column ", to_string(q.column_index), " to ", to_string(q.pixel_size.pixels), "px"], "") as NonEmptyStr
  match sheets.Spreadsheets.SetColumnWidth(
    spreadsheet_id: q.spreadsheet_id,
    sheet_id: q.sheet_id,
    start_index: q.column_index,
    end_index: q.column_index + 1,
    pixel_size: q.pixel_size.pixels,
  ) {
    RestAnswered { answer: _ } => FormatStepApplied { step: step }
    RestRefused { refusal } => classify_format_step(step: step, outcome: refusal)
  }
}

fn freeze_header(q: FreezeRowsRequest) -> FormatStepOutcome {
  match sheets.Spreadsheets.SetFrozenRows(
    spreadsheet_id: q.spreadsheet_id,
    sheet_id: q.sheet_id,
    frozen_row_count: q.frozen_row_count,
  ) {
    RestAnswered { answer: _ } => FormatStepApplied { step: "freeze header row" as NonEmptyStr }
    RestRefused { refusal } => classify_format_step(step: "freeze header row" as NonEmptyStr, outcome: refusal)
  }
}

fn format_header_band(q: HeaderBandRequest) -> FormatStepOutcome {
  match header_background_color() {
    SheetsColorUnderivable { cause: c } =>
      FormatStepRefused { step: "header band" as NonEmptyStr, cause: c }
    SheetsColorDerived { color: bg } =>
      match header_foreground_color() {
        SheetsColorUnderivable { cause: c } =>
          FormatStepRefused { step: "header band" as NonEmptyStr, cause: c }
        SheetsColorDerived { color: fg } =>
          match sheets.Spreadsheets.FormatCellRange(
            spreadsheet_id: q.spreadsheet_id,
            sheet_id: q.sheet_id,
            start_row: q.start_row,
            end_row: q.end_row,
            start_col: q.start_col,
            end_col: q.end_col,
            background: bg,
            foreground: fg,
            bold: true,
          ) {
            RestAnswered { answer: _ } => FormatStepApplied { step: "header band" as NonEmptyStr }
            RestRefused { refusal } => classify_format_step(step: "header band" as NonEmptyStr, outcome: refusal)
          }
      }
  }
}

fn color_standing(q: StandingRuleRequest) -> FormatStepOutcome {
  match q.color {
    SheetsColorUnderivable { cause: c } =>
      FormatStepRefused {
        step: join(["colour for cells ", format_rule_condition_text(c: q.condition)], "") as NonEmptyStr,
        cause: c,
      }
    SheetsColorDerived { color: fg } => color_standing_derived(q: q, color: fg)
  }
}

fn color_standing_derived(q: StandingRuleRequest, color: SheetsColor) -> FormatStepOutcome {
  let step = join(["colour for cells ", format_rule_condition_text(c: q.condition)], "") as NonEmptyStr
  match sheets.Spreadsheets.AddTextColorRule(
    spreadsheet_id: q.spreadsheet_id,
    sheet_id: q.sheet_id,
    start_row: q.start_row,
    start_col: q.start_col,
    end_col: q.end_col,
    condition_type: format_rule_condition_type(c: q.condition),
    condition_value: format_rule_condition_value(c: q.condition),
    foreground: color,
    rule_index: q.rule_index,
  ) {
    RestAnswered { answer: _ } => FormatStepApplied { step: step }
    RestRefused { refusal } => classify_format_step(step: step, outcome: refusal)
  }
}

fn format_step_text(o: FormatStepOutcome) -> String {
  match o {
    FormatStepApplied { step: s } => join(["applied: ", s as String], "")
    FormatStepRefused { step: s, cause: c } => join(["REFUSED ", s as String, ": ", c as String], "")
  }
}

fn format_step_is_applied(o: FormatStepOutcome) -> Bool {
  match o {
    FormatStepApplied { step: _ } => true
    FormatStepRefused { step: _, cause: _ } => false
  }
}


// A FREEZE OR HEADER STEP NOT TAKEN IS ABSENT, not applied: the remediation writes only the terms
// the readback found wrong, so a report says which steps ran.
type FormatReport {
  freeze: FormatStepOutcome?
  header: FormatStepOutcome?
  rules: List<FormatStepOutcome>
  widths: List<FormatStepOutcome>
}

// THE WRITES ONE RUN SENDS, TERM BY TERM. The plan is the whole desired format; a remediation is the
// part of it the readback found wrong. It is a separate carrier because the earlier converge had one
// Bool for four terms, so one wrong width re-sent the whole plan, and the plan's AddTextColorRule
// requests ADD: a sheet with N correct rules then carried 2N, then 3N, and never verified again.
type FormatRemediation sole_constructor {
  freeze: FreezeRowsRequest?
  header: HeaderBandRequest?
  rules: List<StandingRuleRequest>
  widths: List<ColumnWidthRequest>
}

fn full_format_remediation(plan: FormatRequestPlan) -> FormatRemediation {
  FormatRemediation { freeze: Present { value: plan.freeze }, header: Present { value: plan.header }, rules: plan.rules, widths: plan.widths }
}

fn apply_format_remediation(r: FormatRemediation) -> FormatReport {
  let freeze = match r.freeze { Present { value: q } => Present { value: freeze_header(q: q) }  Absent => none }
  let header = match r.header { Present { value: q } => Present { value: format_header_band(q: q) }  Absent => none }
  let rules = map(r.rules, q => color_standing(q: q))
  let widths = map(r.widths, q => set_column_width(q: q))
  FormatReport { freeze: freeze, header: header, rules: rules, widths: widths }
}

fn format_review_sheet(plan: FormatRequestPlan) -> FormatReport {
  apply_format_remediation(r: full_format_remediation(plan: plan))
}

fn optional_step_texts(o: FormatStepOutcome?) -> List<String> {
  match o { Present { value: s } => [format_step_text(o: s)]  Absent => [] }
}

fn optional_step_is_applied(o: FormatStepOutcome?) -> Bool {
  match o { Present { value: s } => format_step_is_applied(o: s)  Absent => true }
}

fn format_report_text(r: FormatReport) -> String {
  join(
    concat(concat(concat(optional_step_texts(o: r.freeze), optional_step_texts(o: r.header)), map(r.rules, o => format_step_text(o: o))), map(r.widths, o => format_step_text(o: o))),
    "\n",
  )
}

fn format_report_all_applied(r: FormatReport) -> Bool {
  optional_step_is_applied(o: r.freeze)
    && optional_step_is_applied(o: r.header)
    && all(r.rules, o => format_step_is_applied(o: o))
    && all(r.widths, o => format_step_is_applied(o: o))
}

// -------------------------------------------------------------------------------------
// THE READBACK. Everything above writes; this reads what the sheet now carries so the converge can
// ADOPT rather than re-apply. It is the difference between an actuator and a converge, and its
// absence was a stated limit of the earlier revision rather than an oversight -- conditional rules
// accumulate on every pass, so a formatter with no readback makes the sheet worse each run.
// -------------------------------------------------------------------------------------

// A FLOAT COMPARISON NEEDS A TOLERANCE AND THE TOLERANCE IS DERIVED. std.algebra declares Float an
// ApproximateFieldProfile carrier, so an equality test against a channel that has been through JSON
// and a spreadsheet's own storage is the wrong instrument: two values naming the same 8-bit swatch
// can differ in the last place, and an exact comparison would report a difference forever and
// rewrite the format on every run. Half an 8-bit step is the principled width, because two channels
// closer than that round to the same swatch. There is no absolute-value fold in reach, so the
// bound is checked in both directions.
fn channel_is_same_swatch(observed: Float, desired: Float, inclusive_max: Int) -> Bool {
  let half_step = 1.0 / ((inclusive_max as Float) + (inclusive_max as Float))
  ((observed - desired) < half_step) && ((desired - observed) < half_step)
}

fn color_is_same_swatch(observed: SheetsColorRead, desired: SheetsColor, inclusive_max: Int) -> Bool {
  channel_is_same_swatch(observed: sheets_color_channel_read(channel: observed.red), desired: desired.red, inclusive_max: inclusive_max)
    && channel_is_same_swatch(observed: sheets_color_channel_read(channel: observed.green), desired: desired.green, inclusive_max: inclusive_max)
    && channel_is_same_swatch(observed: sheets_color_channel_read(channel: observed.blue), desired: desired.blue, inclusive_max: inclusive_max)
}

type FormatObservation
  = FormatObserved { frozen_rows: Int, header: SheetsCellFormatRead?, rule_count: Int, column_widths: List<DisplayPixelCount?> }
  | FormatUnreadable { cause: NonEmptyStr }

// THE SECOND READ IS UNRANGED AND CARRIES NO GRID DATA, so the conditional rules are not filtered
// away by a range chosen to bound something else. It is cheap for the same reason: sheet metadata
// without grid data does not grow with the census.
fn read_format_meta(tab: LocatedReviewTab, grid: SpreadsheetRead) -> FormatObservation {
  match sheets.Spreadsheets.GetSpreadsheetMetadata(
    spreadsheet_id: tab.spreadsheet_id as String,
    fields: review_sheet_format_meta_field_mask,
  ) {
    RestAnswered { answer: meta } =>
      match located_sheet(read: meta.result, sheet_id: tab.sheet_id) {
        Absent =>
          FormatUnreadable {
            cause: "the metadata read answered with no sheet carrying the located sheetId, so the frozen row count and the conditional rules of the tab this converge addresses could not be observed" as NonEmptyStr
          }
        Present { value: meta_sheet } =>
          match header_format_of(read: grid, sheet_id: tab.sheet_id) {
            HeaderFormatUnreadable { cause: c } => FormatUnreadable { cause: c }
            HeaderFormatRead { format: h } =>
              match observed_column_widths(read: grid, sheet_id: tab.sheet_id) {
                ColumnWidthsRefused { cause: c } => FormatUnreadable { cause: c }
                ColumnWidthsRead { widths: ws } =>
                  FormatObserved {
                    frozen_rows: observed_frozen_rows(sheet: meta_sheet),
                    header: h,
                    rule_count: observed_rule_count(sheet: meta_sheet),
                    column_widths: ws,
                  }
              }
          }
      }
    RestRefused { refusal } => match classify_rest_refusal(standing: RestReadExchange { refusal: refusal }) {
      RestExchangeStatusRefused { status, body } =>
        FormatUnreadable {
          cause: join(["the metadata read answered ", to_string(status), ": ", body], "") as NonEmptyStr
        }
      RestExchangeUnreached { cause } =>
        FormatUnreadable {
          cause: join(["the metadata read never reached Sheets: ", cause as String], "") as NonEmptyStr
        }
      RestExchangeUndecodable { status, cause } =>
        FormatUnreadable {
          cause: join(["the metadata read answered ", to_string(status), " with a body this model could not decode: ", cause as String], "") as NonEmptyStr
        }
      RestExchangeCommitAmbiguous { detail } =>
        FormatUnreadable {
          cause: join(["the metadata read is a read and reported an ambiguous commit: ", detail], "") as NonEmptyStr
        }
    }
  }
}

// A GRID RESPONSE WITH NO SHEETS IS NOT A HEADER CARRYING NO FORMAT, and collapsing the two into
// one `none` is what this type exists to prevent. `SheetsCellFormatRead?` can say "the header cell
// has no userEnteredFormat" -- a fact about a sheet that was READ -- and it cannot say "the grid
// response contained no sheet at all", which is the absence of a reading. Folded together, an
// unreadable grid answers `header_matches` false, answers `format_is_converged` false, and the
// converge proceeds to issue batchUpdates against a spreadsheet whose grid response it never read:
// the rostered class absent_reads_identically_to_never_looked, and a widening failure arm where
// DESIGN §5 requires a refusal.
type HeaderFormatReading
  = HeaderFormatRead { format: SheetsCellFormatRead? }
  | HeaderFormatUnreadable { cause: NonEmptyStr }

fn header_format_of(read: SpreadsheetRead, sheet_id: Int) -> HeaderFormatReading {
  match located_sheet(read: read, sheet_id: sheet_id) {
    Absent =>
      HeaderFormatUnreadable {
        cause: "the grid read answered with no sheet carrying the located sheetId, so the header format of the tab this converge addresses could not be read and nothing may be adopted from it" as NonEmptyStr
      }
    Present { value: sheet } => HeaderFormatRead { format: observed_header_format(sheet: sheet) }
  }
}

// THE FIELD MASK AND THE RANGE ARE DECLARED HERE because they are a fact about what this module
// inspects, not about the Sheets API. The range is the header row alone: nothing below it is read,
// so the cost of this readback does not grow with the census.
// TWO READS, BECAUSE ONE RANGE CANNOT ANSWER BOTH QUESTIONS. An earlier revision asked for the
// header cell format, the frozen row count and the conditional rules in ONE ranged call, and the
// range silently ate the rules: Sheets filters conditionalFormats to those INTERSECTING the
// requested ranges, this sheet's rules start at row index 1, and the range that bounds the grid read
// to the header row is row 0 only. So the rules came back absent, the fold counted zero, and the
// converge reported UNVERIFIED over a sheet it had just formatted correctly.
//
// That is not a cosmetic false negative. format_is_converged compares the rule COUNT, so a run
// reading zero would have applied five more rules, and the next run five more again -- the exact
// accumulation the readback exists to prevent, caused by the readback. It was invisible until the
// converge ran against a real spreadsheet: every witness supplies its own observation, so none of
// them can discover that the request does not return what the request asked for.
//
// The split is along what each question actually needs. Grid data is expensive and MUST stay bounded
// to the header row. The frozen row count and the conditional rules are sheet metadata, need no grid
// data at all, and must NOT be range-filtered.
// BOTH MASKS NOW REQUEST THE sheetId, AND OMITTING IT BROKE THE PRODUCTION PATH OUTRIGHT.
// When the readback stopped taking the head of the sheet list and started selecting the sheet
// whose sheetId is the LOCATED one, these two masks kept their old spelling -- so the selector
// keyed on a field the request had told Sheets not to send. The grid mask asked for no
// properties at all, so no sheet ever matched and converge_review_sheet_format answered
// FormatConvergeRefused for every workbook; the metadata mask carried properties without the id,
// so absent-is-zero made it match only when the located tab happened to be tab zero -- the exact
// assumption this change exists to remove, reintroduced in the one place nothing was looking
// (review 68553).
//
// The masks are composed from extdeps.google.sheets field-path rows rather than spelled here, so
// the path the decode keys on and the path the request asks for are ONE declaration. That is the
// repair: the defect was not a forgotten string, it was a mask and a decode being two
// representations of one fact with nothing joining them, which is what let widening the reading
// and widening the request come apart.
data review_sheet_format_grid_field_mask: String = sheets_field_mask(paths: [sheets_field_sheet_id, sheets_field_user_entered_format, sheets_field_column_pixel_size])

data review_sheet_format_meta_field_mask: String = sheets_field_mask(paths: [sheets_field_sheet_id, sheets_field_frozen_row_count, sheets_field_conditional_formats])

// THE RANGE IS QUALIFIED BY THE LOCATED TITLE, and the bare form this replaced is the READ side of
// the same defect the constant sheetId was on the write side. gunbc.review_sheet_sheets
// a1_readback_standing already refuses an unqualified A1 range in as many words -- "BatchUpdate
// would hit the first tab" -- and this module was sending one. The title comes from the located
// tab, never from the Drive file's display name: they are written by different systems into
// different places and renaming one does not touch the other.
//
// THE RANGE SPANS THE TAB'S OWN HEADER, NOT A CONSTANT. It was "A1:Q1", seventeen columns, written
// when one kind existed; a census tab of eighteen or nineteen columns then never read back its
// trailing widths, so the formatter re-applied on every run and the tab never verified. The extent
// is the validated header's, so a wider schema widens its read and nothing else.
fn review_sheet_header_cells(validated: ValidatedHeaderSchema) -> String? {
  match a1_column_letter(index: review_sheet_header_count(validated: validated) - 1) {
    Present { value: last } => Present { value: join(["A1:", last, "1"], "") }
    Absent => none
  }
}

// THE FIRST ELEMENT OF A LIST, ONCE PER TYPE, AND THE GENERIC IT REPLACES DID NOT SURVIVE CONTACT.
// An earlier revision wrote one generic first_of<T> folding over List<T> with `none` as the initial
// accumulator. It typechecked and then failed at EVALUATION against the live response with an error
// type cascade: the accumulator is an untyped Optional at the fold's start and nothing in the
// expression fixes T, so the return type could not be resolved where it was used. The three
// monomorphic folds below say what they return, which is what the runtime needs.
//
// This is the `as Nat` shape again -- an expression the compiler accepts and the evaluator refuses --
// and it is why the readback had to be run against a real spreadsheet before it could be believed.
fn first_grid(items: List<SheetsGridDataRead>) -> SheetsGridDataRead? {
  fold_list(
    items,
    none,
    (acc, x) =>
      match acc {
        Present { value: v } => Present { value: v }
        Absent => Present { value: x }
      },
  )
}

fn first_row(items: List<SheetsRowDataRead>) -> SheetsRowDataRead? {
  fold_list(
    items,
    none,
    (acc, x) =>
      match acc {
        Present { value: v } => Present { value: v }
        Absent => Present { value: x }
      },
  )
}

fn first_cell(items: List<SheetsCellDataRead>) -> SheetsCellDataRead? {
  fold_list(
    items,
    none,
    (acc, x) =>
      match acc {
        Present { value: v } => Present { value: v }
        Absent => Present { value: x }
      },
  )
}

// THE SHEET IS SELECTED BY ITS LOCATED ID, NOT BY BEING FIRST. Both folds this replaced took the
// head of the response's sheet list, which is the same assumption the constant sheetId made on the
// write side wearing a different hat: a readback that inspects the first tab while the writes
// address the located one would report UNVERIFIED for a correctly formatted sheet, or -- worse, in
// the case the two happen to coincide today -- report VERIFIED for a tab nobody wrote to. The
// readback and the write must address the same tab for the readback to be evidence at all.
// THE ABSENT-IS-ZERO RULE IS CALLED, NOT RESTATED. An earlier cut of this predicate spelled the
// proto3 omission inline as `Absent => sheet_id == 0`, in the same change that declared
// extdeps.google.sheets sheets_sheet_id_read as the single authority for exactly that fact
// (review 68663). Two spellings of one rule is the fork DESIGN section 3 exists to prevent, and it
// is the same defect shape this change already repaired between the field masks and the decode:
// correcting or widening the omission rule must be ONE edit, not an edit plus a search. Absent
// PROPERTIES stays distinct and stays here -- a sheet whose properties were never read is not a
// sheet whose sheetId was omitted, and only the second is a zero.
fn sheet_read_has_id(sheet: SheetsSheetRead, sheet_id: Int) -> Bool {
  match sheet.properties {
    Absent => false
    Present { value: props } => sheets_sheet_id_read(id: props.sheetId) == sheet_id
  }
}

fn sheet_with_id(items: List<SheetsSheetRead>, sheet_id: Int) -> SheetsSheetRead? {
  fold_list(
    items,
    none,
    (acc, x) =>
      match acc {
        Present { value: v } => Present { value: v }
        Absent => if sheet_read_has_id(sheet: x, sheet_id: sheet_id) { Present { value: x } } else { none }
      },
  )
}

fn located_sheet(read: SpreadsheetRead, sheet_id: Int) -> SheetsSheetRead? {
  match read.sheets {
    Absent => none
    Present { value: ss } => sheet_with_id(items: ss, sheet_id: sheet_id)
  }
}

fn observed_frozen_rows(sheet: SheetsSheetRead) -> Int {
  match sheet.properties {
    Absent => 0
    Present { value: props } =>
      match props.gridProperties {
        Absent => 0
        Present { value: grid } =>
          match grid.frozenRowCount {
            Absent => 0
            Present { value: n } => n
          }
      }
  }
}

fn observed_rule_count(sheet: SheetsSheetRead) -> Int {
  match sheet.conditionalFormats {
    Absent => 0
    Present { value: rules } => count(rules)
  }
}

// THE WIDTHS COME BACK WITH THE HEADER GRID READ, one pixelSize per column of the header range, so
// they cost nothing beyond the field in the mask. The wire's Int crosses to DisplayPixelCount HERE,
// through std.checked_arithmetic checked_int_to_nat, and nowhere later: an absent pixelSize is an
// unread width and never matches a desired one, but a pixelSize no Nat holds (negative, or past the
// magnitude) is not a width at all, so the whole reading refuses rather than reading as a mismatch
// the converge would "repair" by writing over an answer it did not understand.
type ColumnWidthsReading
  = ColumnWidthsRead { widths: List<DisplayPixelCount?> }
  | ColumnWidthsRefused { cause: NonEmptyStr }

fn column_widths_of(cols: List<SheetsDimensionPropertiesRead>) -> ColumnWidthsReading {
  let invalid = filter(enumerate(cols), p => match p.second.pixelSize {
    Present { value: px } => match checked_int_to_nat(n: px) { Absent => true  Present { value: _ } => false }
    Absent => false
  })
  if count(invalid) > 0 {
    ColumnWidthsRefused {
      cause: join(["the grid read answered a pixelSize no display width holds at column index ", join(map(invalid, p => to_string(p.first)), ", "), ", so the widths could not be observed"], "") as NonEmptyStr
    }
  } else {
    ColumnWidthsRead { widths: map(cols, c => match c.pixelSize {
      Absent => none
      Present { value: px } => match checked_int_to_nat(n: px) {
        Absent => none
        Present { value: n } => Present { value: DisplayPixelCount { pixels: n } }
      }
    }) }
  }
}

fn observed_column_widths(read: SpreadsheetRead, sheet_id: Int) -> ColumnWidthsReading {
  match located_sheet(read: read, sheet_id: sheet_id) {
    Absent => ColumnWidthsRead { widths: [] }
    Present { value: sheet } =>
      match sheet.data {
        Absent => ColumnWidthsRead { widths: [] }
        Present { value: grids } =>
          match first_grid(items: grids) {
            Absent => ColumnWidthsRead { widths: [] }
            Present { value: grid } =>
              match grid.columnMetadata {
                Absent => ColumnWidthsRead { widths: [] }
                Present { value: cols } => column_widths_of(cols: cols)
              }
          }
      }
  }
}

fn observed_header_format(sheet: SheetsSheetRead) -> SheetsCellFormatRead? {
  match sheet.data {
    Absent => none
    Present { value: grids } =>
      match first_grid(items: grids) {
        Absent => none
        Present { value: grid } =>
          match grid.rowData {
            Absent => none
            Present { value: rows } =>
              match first_row(items: rows) {
                Absent => none
                Present { value: row } =>
                  match row.values {
                    Absent => none
                    Present { value: cells } =>
                      match first_cell(items: cells) {
                        Absent => none
                        Present { value: cell } => cell.userEnteredFormat
                      }
                  }
              }
          }
      }
  }
}

// THE TITLE IS ENCODED BY THE CODEC THAT LANDED, NOT BY A RULE THIS MODULE INVENTED. An earlier
// cut of this branch carried gunbc.review_sheet_sheets a1_tab_qualification, which REFUSED a title
// containing a space, an apostrophe, a bang or a colon on the stated ground that no encoder
// existed and writing a second one beside gunbc#11703 would be the fork that PR exists to prevent.
// #11703 has since landed as extdeps.google.sheets a1_range_encode, so that function's own
// dissolution trigger -- "it retires when 11703 lands an encoder this function can call instead of
// declining" -- has fired, and it is deleted rather than left standing beside its replacement.
//
// THE DELETION ALSO REMOVES AN OVER-PROHIBITION, which is worth naming because it was the more
// interesting defect. Quoting makes a space, a bang and a colon perfectly legal in an A1 title;
// refusing them was forbidding more of the world than the evidence supported, and the cost of that
// arm was invisible -- a correctly formattable workbook declining to format, with the refusal
// reading like rigour (DESIGN section 4d). The codec refuses exactly one thing, an apostrophe,
// because its WIRE SPELLING is genuinely unobserved and it says so with a read obligation.
type HeaderRangeStanding
  = HeaderRangeWire { range: String }
  | HeaderRangeUnqualifiable { cause: NonEmptyStr }

fn review_sheet_header_range(tab: LocatedReviewTab, validated: ValidatedHeaderSchema) -> HeaderRangeStanding {
  match review_sheet_header_cells(validated: validated) {
    Absent => HeaderRangeUnqualifiable { cause: "the header is wider than the A1 letters this module spells (A-Z), so no range covers it" as NonEmptyStr }
    Present { value: cells } => review_sheet_header_range_at(tab: tab, cells: cells)
  }
}

fn review_sheet_header_range_at(tab: LocatedReviewTab, cells: String) -> HeaderRangeStanding {
  match a1_range_encode(title: tab.title, cells: Present { value: cells }) {
    A1RangeEncoded { wire: w } => HeaderRangeWire { range: w }
    A1TitleApostropheUnsupported { title: t } =>
      HeaderRangeUnqualifiable {
        cause: a1_range_encoding_text(e: A1TitleApostropheUnsupported { title: t }) as NonEmptyStr
      }
  }
}

fn read_format(tab: LocatedReviewTab, validated: ValidatedHeaderSchema) -> FormatObservation {
  match review_sheet_header_range(tab: tab, validated: validated) {
    HeaderRangeUnqualifiable { cause: c } =>
      FormatUnreadable {
        cause: join(["the located tab's title cannot qualify an A1 range, so the header read would have been unqualified and would have hit whichever tab is first: ", c as String], "") as NonEmptyStr
      }
    HeaderRangeWire { range: r } => read_format_at(tab: tab, range: r)
  }
}

fn read_format_at(tab: LocatedReviewTab, range: String) -> FormatObservation {
  match sheets.Spreadsheets.GetSpreadsheet(
    spreadsheet_id: tab.spreadsheet_id as String,
    range: range,
    fields: review_sheet_format_grid_field_mask,
    include_grid_data: true,
  ) {
    RestAnswered { answer: grid } => read_format_meta(tab: tab, grid: grid.result)
    RestRefused { refusal } => match classify_rest_refusal(standing: RestReadExchange { refusal: refusal }) {
      RestExchangeStatusRefused { status, body } =>
        FormatUnreadable {
          cause: join(["spreadsheets.get answered ", to_string(status), ": ", body], "") as NonEmptyStr
        }
      RestExchangeUnreached { cause } =>
        FormatUnreadable {
          cause: join(["spreadsheets.get never reached Sheets: ", cause as String], "") as NonEmptyStr
        }
      RestExchangeUndecodable { status, cause } =>
        FormatUnreadable {
          cause: join(["spreadsheets.get answered ", to_string(status), " with a body this model could not decode: ", cause as String], "") as NonEmptyStr
        }
      RestExchangeCommitAmbiguous { detail } =>
        FormatUnreadable {
          cause: join(["spreadsheets.get is a read and reported an ambiguous commit: ", detail], "") as NonEmptyStr
        }
    }
  }
}

// -------------------------------------------------------------------------------------
// THE CONVERGE. Observe, decide, actuate only if the decision says so, then read back
// INDEPENDENTLY -- the same shape the membership, spreadsheet and values converges use, and the
// shape the earlier revision of this module could not reach because it had no read.
// -------------------------------------------------------------------------------------
fn desired_rule_count(rules: List<FormatRule>) -> Int {
  count(rules)
}

// ALREADY-FORMATTED IS A JUDGEMENT ABOUT FOUR FACTS AND ALL FOUR MUST HOLD. Each sized column's
// width is exact, read from the header grid's columnMetadata. The frozen row count
// is exact. The header colours are compared at swatch width, never by float equality. The rule
// count is compared rather than the rules themselves, and that is a DECLARED WEAKNESS rather than
// a claim: this reads how many conditional rules the sheet carries, not whether each one matches
// the fragment and colour this module would write. A sheet carrying five unrelated rules reads as
// converged. The narrower check needs the rule's condition values and format compared per rule,
// which the response models but this fold does not yet walk.
// THE INDEX IS PAIRED BEFORE IT IS LOOKED UP. `first` over a List<Int?> answers Int?? and the
// evaluator folds that to one optional layer, so the inner match then met a bare integer and the
// first width that differed raised a type error instead of reading as wrong (the remediation RED
// found it; no earlier claim compared a width that differed). Each column is matched as the
// (index, width) pair it is, so the optional layer is the width's own.
fn width_matches(observed: DisplayPixelCount?, desired: ColumnWidthRequest) -> Bool {
  match observed {
    Present { value: w } => w.pixels == desired.pixel_size.pixels
    Absent => false
  }
}

fn width_is_observed(observed: List<DisplayPixelCount?>, desired: ColumnWidthRequest) -> Bool {
  count(filter(enumerate(observed), p => p.first == desired.column_index && width_matches(observed: p.second, desired: desired))) > 0
}

// THE FOUR TERMS, READ SEPARATELY, so each can be remediated on its own.
type FormatTermReading {
  frozen_ok: Bool
  header_ok: Bool
  rule_count: Int
  column_widths: List<DisplayPixelCount?>
}

fn format_terms_of(rows: Int, h: SheetsCellFormatRead?, rules: Int, widths: List<DisplayPixelCount?>, inclusive_max: Int, header_bg: SheetsColor, header_fg: SheetsColor) -> FormatTermReading {
  FormatTermReading {
    frozen_ok: rows == review_sheet_header_row_count,
    header_ok: header_matches(h: h, inclusive_max: inclusive_max, header_bg: header_bg, header_fg: header_fg),
    rule_count: rules,
    column_widths: widths,
  }
}

type FormatRemediationDecision
  = FormatRemediationPlanned { remediation: FormatRemediation }
  | FormatRemediationRefused { cause: NonEmptyStr }

// EACH TERM IS WRITTEN ONLY WHEN IT IS WRONG. The freeze and the header band are idempotent
// replacements, so a wrong one is re-sent alone. Each width is re-sent alone when its observed
// pixelSize differs. The rules are the one term that cannot be repaired by re-sending, because an
// add is not a replacement: the right count writes none, zero writes the full set, and any other
// count refuses, since reconciling a partial or foreign rule set needs the delete and update
// requests this module does not model yet.
fn format_remediation(terms: FormatTermReading, plan: FormatRequestPlan) -> FormatRemediationDecision {
  let desired_rules = count(plan.rules)
  if terms.rule_count != desired_rules && terms.rule_count != 0 {
    FormatRemediationRefused {
      cause: join(["the tab carries ", to_string(terms.rule_count), " conditional rules where ", to_string(desired_rules), " are declared; adding would stack a second set and nothing here can delete or update a rule, so the rule set needs reconciling before this converge may write"], "") as NonEmptyStr
    }
  } else {
    FormatRemediationPlanned {
      remediation: FormatRemediation {
        freeze: if terms.frozen_ok { none } else { Present { value: plan.freeze } },
        header: if terms.header_ok { none } else { Present { value: plan.header } },
        rules: if terms.rule_count == desired_rules { [] } else { plan.rules },
        widths: filter(plan.widths, d => !width_is_observed(observed: terms.column_widths, desired: d)),
      }
    }
  }
}

fn format_remediation_is_empty(r: FormatRemediation) -> Bool {
  let no_freeze = match r.freeze { Present { value: _ } => false  Absent => true }
  let no_header = match r.header { Present { value: _ } => false  Absent => true }
  no_freeze && no_header && count(r.rules) == 0 && count(r.widths) == 0
}

// HOW MANY WRITES OF EACH KIND A REMEDIATION SENDS: freeze, header, rules, widths.
fn format_remediation_shape(r: FormatRemediation) -> List<Int> {
  [
    match r.freeze { Present { value: _ } => 1  Absent => 0 },
    match r.header { Present { value: _ } => 1  Absent => 0 },
    count(r.rules),
    count(r.widths),
  ]
}

fn format_is_converged(o: FormatObservation, desired_rules: Int, desired_widths: List<ColumnWidthRequest>, inclusive_max: Int, header_bg: SheetsColor, header_fg: SheetsColor) -> Bool {
  match o {
    FormatUnreadable { cause: _ } => false
    FormatObserved { frozen_rows: rows, header: h, rule_count: rules, column_widths: widths } =>
      (rows == review_sheet_header_row_count)
        && (rules == desired_rules)
        && all(desired_widths, d => width_is_observed(observed: widths, desired: d))
        && header_matches(h: h, inclusive_max: inclusive_max, header_bg: header_bg, header_fg: header_fg)
  }
}

fn header_matches(h: SheetsCellFormatRead?, inclusive_max: Int, header_bg: SheetsColor, header_fg: SheetsColor) -> Bool {
  match h {
    Absent => false
    Present { value: fmt } =>
      match fmt.backgroundColor {
        Absent => false
        Present { value: bg } =>
          color_is_same_swatch(observed: bg, desired: header_bg, inclusive_max: inclusive_max)
            && header_text_matches(t: fmt.textFormat, inclusive_max: inclusive_max, header_fg: header_fg)
      }
  }
}

fn header_text_matches(t: SheetsTextFormatRead?, inclusive_max: Int, header_fg: SheetsColor) -> Bool {
  match t {
    Absent => false
    Present { value: tf } =>
      match tf.foregroundColor {
        Absent => false
        Present { value: fg } => color_is_same_swatch(observed: fg, desired: header_fg, inclusive_max: inclusive_max)
      }
  }
}

type FormatConvergeOutcome
  = FormatAlreadyConverged
  | FormatAppliedAndVerified { report: FormatReport }
  | FormatAppliedUnverified { report: FormatReport, cause: NonEmptyStr }
  | FormatConvergeRefused { cause: NonEmptyStr }

// THE READBACK IS THE SAME READ THE CONVERGE OPENED WITH, not a trusted echo of the writes. A
// batchUpdate answering 200 has told us what it did, not what the sheet now carries, and the
// distance between those two is where the first live run lost an hour.
// THE SUBJECT IS A LOCATED TAB, NOT A FILE ID. The parameter used to be the spreadsheet's file id
// alone, which named the workbook and left every request inside it to address tab zero. A
// LocatedReviewTab names the workbook AND the tab, and it has no constructor outside
// gunbc.review_sheet_tab_locator, so a caller cannot reach this function with a tab it asserted
// rather than observed.
//
// WHAT THIS CONVERGE VERIFIES, STATED AT ITS ACTUAL STRENGTH. format_is_converged compares four
// facts read back off the located tab: the frozen row count exactly, the header cell's background
// and foreground at swatch width, the NUMBER of conditional format rules, and the pixel width of
// every column the kind sizes. It does not compare
// each rule's condition or colour, so a tab carrying five unrelated rules reads as converged; it
// does not check the header band's extent or the standing column's position; and it reads
// userEnteredFormat, so it verifies what this repository wrote rather than what a viewer sees.
// FormatAppliedAndVerified means those four facts hold on the tab that was addressed -- which is
// the fact this change adds, and it is a smaller claim than "the sheet is formatted".
fn converge_review_sheet_format(
  tab: LocatedReviewTab,
  validated: ValidatedHeaderSchema,
  rules: List<FormatRule>,
  widths: List<ColumnWidth>,
) -> FormatConvergeOutcome {
  match uint8_channel_inclusive_max_value_derived() {
    Absent =>
      FormatConvergeRefused {
        cause: "the 8-bit inclusive maximum declined, so no desired colour can be derived and nothing may be compared or written" as NonEmptyStr
      }
    Present { value: m } =>
      match header_background_color() {
        SheetsColorUnderivable { cause: c } => FormatConvergeRefused { cause: c }
        SheetsColorDerived { color: bg } =>
          match header_foreground_color() {
            SheetsColorUnderivable { cause: c } => FormatConvergeRefused { cause: c }
            SheetsColorDerived { color: fg } =>
              converge_with_desired(
                tab: tab, validated: validated, rules: rules, widths: widths,
                inclusive_max: m, header_bg: bg, header_fg: fg)
          }
      }
  }
}

fn converge_with_desired(
  tab: LocatedReviewTab,
  validated: ValidatedHeaderSchema,
  rules: List<FormatRule>,
  widths: List<ColumnWidth>,
  inclusive_max: Int,
  header_bg: SheetsColor,
  header_fg: SheetsColor,
) -> FormatConvergeOutcome {
  match format_request_plan(tab: tab, validated: validated, rules: rules, widths: widths) {
    FormatPlanRefused { cause: c } => FormatConvergeRefused { cause: c }
    FormatPlanned { plan: plan } =>
      converge_planned(
        tab: tab, validated: validated, plan: plan, desired_rules: count(rules),
        inclusive_max: inclusive_max, header_bg: header_bg, header_fg: header_fg)
  }
}

fn converge_planned(
  tab: LocatedReviewTab,
  validated: ValidatedHeaderSchema,
  plan: FormatRequestPlan,
  desired_rules: Int,
  inclusive_max: Int,
  header_bg: SheetsColor,
  header_fg: SheetsColor,
) -> FormatConvergeOutcome {
  let observed = read_format(tab: tab, validated: validated)
  match observed {
    FormatUnreadable { cause: c } =>
      FormatConvergeRefused {
        cause: join(["the sheet's current format could not be read, so applying would be writing blind: ", c as String], "") as NonEmptyStr
      }
    FormatObserved { frozen_rows: rows, header: h, rule_count: n, column_widths: ws } =>
      match format_remediation(terms: format_terms_of(rows: rows, h: h, rules: n, widths: ws, inclusive_max: inclusive_max, header_bg: header_bg, header_fg: header_fg), plan: plan) {
        FormatRemediationRefused { cause: c } => FormatConvergeRefused { cause: c }
        FormatRemediationPlanned { remediation: r } =>
          if format_remediation_is_empty(r: r) {
            FormatAlreadyConverged
          } else {
            verify_applied_format(
              tab: tab,
              validated: validated,
              report: apply_format_remediation(r: r),
              desired_rules: desired_rules,
              desired_widths: plan.widths,
              inclusive_max: inclusive_max,
              header_bg: header_bg,
              header_fg: header_fg,
            )
          }
      }
  }
}

fn verify_applied_format(
  tab: LocatedReviewTab,
  validated: ValidatedHeaderSchema,
  report: FormatReport,
  desired_rules: Int,
  desired_widths: List<ColumnWidthRequest>,
  inclusive_max: Int,
  header_bg: SheetsColor,
  header_fg: SheetsColor,
) -> FormatConvergeOutcome {
  if format_report_all_applied(r: report) {
    if format_is_converged(o: read_format(tab: tab, validated: validated), desired_rules: desired_rules, desired_widths: desired_widths, inclusive_max: inclusive_max, header_bg: header_bg, header_fg: header_fg) {
      FormatAppliedAndVerified { report: report }
    } else {
      FormatAppliedUnverified {
        report: report,
        cause: "every format step answered success and the readback still does not show the desired format; the writes did not take, or they landed somewhere this read does not look" as NonEmptyStr
      }
    }
  } else {
    FormatAppliedUnverified {
      report: report,
      cause: "at least one format step refused, so the sheet is partly formatted and no claim is made about the rest" as NonEmptyStr
    }
  }
}

fn format_converge_text(o: FormatConvergeOutcome) -> String {
  match o {
    FormatAlreadyConverged => "format: already converged, nothing applied"
    FormatAppliedAndVerified { report: r } => join(["format: applied and verified by readback\n", format_report_text(r: r)], "")
    FormatAppliedUnverified { report: r, cause: c } => join(["format UNVERIFIED: ", c as String, "\n", format_report_text(r: r)], "")
    FormatConvergeRefused { cause: c } => join(["format REFUSED: ", c as String], "")
  }
}

fn format_converge_is_converged(o: FormatConvergeOutcome) -> Bool {
  match o {
    FormatAlreadyConverged => true
    FormatAppliedAndVerified { report: _ } => true
    FormatAppliedUnverified { report: _, cause: _ } => false
    FormatConvergeRefused { cause: _ } => false
  }
}
