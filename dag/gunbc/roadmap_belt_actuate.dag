data belt_actuate_exec_authority_note: String = "Slice 2b actuation: the belt DECISION (gunbc.roadmap_belt.belt_reconcile) is CLOSED against the host by three proven single-authorities — the actuator's HostExecArgv argv model (gunbc.roadmap_dispatch_actuator, the one place git/tmux/provider argv is shaped), gunbc.WitnessBin.Run (the typed-argv exec intrinsic, no shell string), and shell.Which.Check (program -> bin_path). Provider is a closed ClaudeCodeProvider | CodexCliProvider choice whose argv, preflight, and pane fingerprint move together. This remains fail-closed throughout: which-miss or auth uncertainty refuses before git worktree add; a worktree failure short-circuits tmux spawn; a nonzero provider process after tmux accepted is runtime evidence, not spawn evidence, and is deliberately NOT absorbed into Spawned-as-success."

data belt_actuate_placement_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.roadmap_dispatch_actuator",
    decl_name: "classify_dispatch_lease_upsert",
    field: WholeDeclaration
  }
}

data belt_actuate_fingerprint_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.roadmap_dispatch_actuator",
    decl_name: "dispatch_tmux_process_fingerprint_observation_dissolution_trigger",
    field: WholeDeclaration
  }
}

data belt_actuate_workdir_note: String = "Two DISTINCT workdirs, because the belt's two host verbs bind to different roots (a §5 fail-open otherwise: observing from a repo path that may not exist on an arbitrary host would make `tmux ls` fail and — before this split — get widened to an empty session set). belt_actuate_workdir is the SPAWN root: `git worktree add` must run inside the gunbc repo — a PROJECTION of gunbc.host_layout.srv1_gunbc_repo_root (the single path authority; its former private copy deleted, DESIGN §3): the same tree `gunbc serve` loads, which is why dispatch works in-process. belt_observe_workdir is the host-global root '/': `tmux ls` and `tmux kill-session` act on the per-user tmux server (a host singleton, not a repo), so they must run from a directory guaranteed to exist on the host — never the repo path, which may be absent (fake-claude test box, a freshly-enrolled srvN). Observe/teardown therefore carry no workdir parameter; only spawn is workdir-parameterized."

data belt_actuate_workdir: FilePath = srv1_gunbc_repo_root

data belt_observe_workdir: FilePath = "/" as FilePath

type BeltExecOutcome
  = ExecOk { stdout: String }
  | ExecFailed { program: String, exit_code: Int, stderr: String }
  | ExecRefused { program: String, reason: String }

data belt_program_available_note: String = "program-on-PATH probe via shell.Which.Check exit_success (Bool), NOT its .path field: the Which .path realization is a bare-stdout string wet (the Optional-over-Value::Null realization fork — DESIGN open thread), so the belt keys on the exit Bool and lets WitnessBin.Run's `env -C \{workdir\} \{bin_path\} args` resolve the bare program name via PATH (env execvp searches PATH). This keeps 'program missing' (refuse) distinct from 'program present, exited nonzero' (fail) without touching the Optional straddle."

data belt_outcome_is_data_note: String = "The three probes in this module are annotated OutcomeIsData (operator ruling 2026-07-25): their exit codes are ANSWERS the belt adjudicates, not faults. belt_program_available's which-miss is the 'program missing' pole this module's belt_program_available_note already keeps deliberately distinct from 'present but exited nonzero'; belt_exec's nonzero exit becomes ExecFailed; belt_observe's becomes a typed BeltObserve arm. In every case the belt renders the fault loudly through its own per-variant status mapping, so the effect layer's anomaly glyph was a second, cruder judgment of an event that already has a real adjudicator. ADMISSIBILITY (§5 guard, gunbc.output_policy outcome_is_data_note): each annotated fn returns a typed value whose arms ARE the adjudication — Bool for the availability probe (consumed as the refuse/fail discriminator, never discarded), BeltExecOutcome, BeltObserve — never unit. Dispatch failure stays anomalous: it is not an exit code and does not travel this arm."

fn belt_program_available(program: String) -> Bool {
  shell.Which.Check(command: program as NonEmptyStr, expect: OutcomeIsData).exists
}

fn belt_exec(cmd: HostExecArgv, workdir: String) -> BeltExecOutcome {
  if belt_program_available(program: cmd.program) {
    let result = gunbc.WitnessBin.Run(
      workdir: workdir as FilePath,
      bin_path: cmd.program as FilePath,
      args: cmd.args,
      expect: OutcomeIsData,
    )
    if result.success {
      ExecOk { stdout: result.stdout }
    } else {
      ExecFailed { program: cmd.program, exit_code: result.exit_code, stderr: result.stderr }
    }
  } else {
    ExecRefused {
      program: cmd.program,
      reason: "belt_exec: program not found on PATH (which exit nonzero); fail-closed, no fabricated success",
    }
  }
}

data belt_exec_all_fail_closed_note: String = "Fail-closed sequencing: fold runs each argv in order; once a step is non-ok (ExecFailed/ExecRefused) the accumulator SHORT-CIRCUITS — belt_exec is NOT called for the remaining steps and the first failure is returned. Spawn's worktree-add -> tmux-new-session ordering rides this: a failed git worktree add never spawns the tmux session (no orphan session on a missing worktree). Discriminating control: remove the ExecOk-guarded short-circuit and [false, echo] would run echo and go green when it must stay failed."

fn belt_exec_all(cmds: List<HostExecArgv>, workdir: String) -> BeltExecOutcome {
  fold(cmds, init: ExecOk { stdout: "" }, f: fn(acc, cmd) {
    match acc {
      ExecOk { stdout: _ } => belt_exec(cmd: cmd, workdir: workdir)
      ExecFailed { program: _, exit_code: _, stderr: _ } => acc
      ExecRefused { program: _, reason: _ } => acc
    }
  })
}

type BeltSpawnOutcome
  = Spawned { node_id: String, session_name: String }
  | SpawnFailed { node_id: String, step: String, detail: String }

data belt_claude_preflight_note: String = "Spawn preflights the CLAUDE dependency before any actuation, because both of its failure classes pass the exec seam SILENTLY (§5, found live 2026-07-23): tmux new-session exits 0 even when the inner claude is missing (the pane dies instantly behind a fabricated Spawned), and an unseeded workspace-trust root blocks claude INTERACTIVELY on its per-path trust dialog (a hung session, not an error — --dangerously-skip-permissions does not cover it). Both are decidable BEFORE spawning, so they refuse as typed SpawnFailed rows: claude-on-PATH via the same shell.Which authority belt_exec uses (step claude-cli), then the trust seed for the ONE dispatch worktree root read from the claude trust store and classified by extdeps.llm.cli.claude_workspace_trust_seeded — the modeled home of what was hand-provisioned on srv1 at go-live (ancestor-inheritance makes the single root sufficient; steps claude-trust-home / claude-trust-store / claude-trust-seed, each detail naming the exact convergence). The DECISION is the pure witnessed fn (belt_claude_preflight_decision, every arm exercised on synthetic facts — same shape as belt_observe_from_result); belt_claude_preflight only threads live observations into it. Residue: refuse-with-instructions, not auto-seed — the trust store is claude's own mutable file (claude rewrites it at runtime), so a read-modify-write APPLY arm races the upstream writer; seeding stays with the live_deploy membership convergence (the go-live receipt's named dissolution)."

type BeltClaudePreflight
  = ClaudePreflightOk
  | ClaudePreflightRefused { step: String, detail: String }

fn belt_claude_preflight_decision(
  claude_on_path: Bool,
  home: String,
  trust_store_path: String,
  trust_store_readable: Bool,
  trust_store_text: String,
  trust_root: String,
) -> BeltClaudePreflight {
  if !claude_on_path {
    ClaudePreflightRefused {
      step: "claude-cli",
      detail: "claude not found on PATH (which exit nonzero); tmux would spawn a pane that dies instantly — fail-closed, no fabricated Spawned",
    }
  } else if home == "" {
    ClaudePreflightRefused {
      step: "claude-trust-home",
      detail: "HOME unset or empty — cannot locate the claude trust store (~/.claude.json), so the workspace-trust seed is unknowable; fail-closed",
    }
  } else if !trust_store_readable {
    ClaudePreflightRefused {
      step: "claude-trust-store",
      detail: concat(
        concat("claude trust store unreadable at ", trust_store_path),
        " — claude blocks on its workspace-trust dialog for an unseeded root; seed it by launching claude once under the dispatch worktree root, or converge via the live_deploy membership",
      ),
    }
  } else if !claude_workspace_trust_seeded(config_text: trust_store_text, project_path: trust_root) {
    ClaudePreflightRefused {
      step: "claude-trust-seed",
      detail: concat(
        concat(concat("workspace trust not seeded for ", trust_root), " in "),
        concat(trust_store_path, " (projects entry with hasTrustDialogAccepted: true) — claude would block interactively on its trust dialog; ancestor-dir trust inheritance means seeding this ONE root covers every dispatch worktree"),
      ),
    }
  } else {
    ClaudePreflightOk
  }
}

fn belt_claude_preflight_for_instance(instance: HostDashboardInstance) -> BeltClaudePreflight {
  let claude_ok = belt_program_available(program: claude_cli_program)
  let home = match shell.Env.Get(name: "HOME" as NonEmptyStr).value {
    Absent => ""
    Present { value: v } => v
  }
  if !claude_ok || home == "" {
    belt_claude_preflight_decision(
      claude_on_path: claude_ok,
      home: home,
      trust_store_path: "",
      trust_store_readable: false,
      trust_store_text: "",
      trust_root: instance.dispatch_worktree_root as String,
    )
  } else {
    let path = claude_trust_store_path(home: home)
    let r = Filesystem.Read(path: path)
    belt_claude_preflight_decision(
      claude_on_path: claude_ok,
      home: home,
      trust_store_path: path,
      trust_store_readable: r.success,
      trust_store_text: r.content,
      trust_root: instance.dispatch_worktree_root as String,
    )
  }
}

fn belt_claude_preflight() -> BeltClaudePreflight {
  belt_claude_preflight_for_instance(instance: srv1_live_dashboard_instance())
}

type BeltCodexPreflight
  = CodexPreflightOk { auth_method: String }
  | CodexPreflightRefused { step: String, detail: String }

data belt_codex_preflight_note: String = "Codex preflight owns only facts decidable before actuation. It requires both codex and env on PATH, then executes `env CODEX_HOME=<dedicated-root> codex login status`; exit 0 is the CLI's active-auth verdict and its stdout is retained as the method receipt, while every nonzero is codex-auth refusal carrying stdout+stderr. It never parses auth.json and never treats file presence as authentication. Subscription exhaustion and upstream/rate failures occur only after `codex exec` starts; those belong to the provider JSONL event stream (`turn.failed` / `error`) and exit status, not this preflight. Until that event observer lands, a tmux spawn is only Spawned and session presence is only Present."

fn belt_codex_preflight_decision_for_home(
  codex_home: String,
  codex_on_path: Bool,
  env_on_path: Bool,
  login_status_success: Bool,
  login_status_stdout: String,
  login_status_stderr: String,
) -> BeltCodexPreflight {
  if !codex_on_path {
    CodexPreflightRefused {
      step: "codex-cli",
      detail: "codex not found on PATH; refusing before worktree creation",
    }
  } else if !env_on_path {
    CodexPreflightRefused {
      step: "codex-env",
      detail: "env not found on PATH; cannot bind the dedicated CODEX_HOME for auth or execution",
    }
  } else if !login_status_success {
    CodexPreflightRefused {
      step: "codex-auth",
      detail: join([
        "codex login status exited nonzero for ",
        codex_home,
        "; stdout: ",
        login_status_stdout,
        "; stderr: ",
        login_status_stderr,
      ], ""),
    }
  } else {
    CodexPreflightOk { auth_method: login_status_stdout }
  }
}

fn belt_codex_preflight_decision(
  codex_on_path: Bool,
  env_on_path: Bool,
  login_status_success: Bool,
  login_status_stdout: String,
  login_status_stderr: String,
) -> BeltCodexPreflight {
  belt_codex_preflight_decision_for_home(
    codex_home: dispatch_codex_home,
    codex_on_path: codex_on_path,
    env_on_path: env_on_path,
    login_status_success: login_status_success,
    login_status_stdout: login_status_stdout,
    login_status_stderr: login_status_stderr,
  )
}

fn belt_codex_preflight_for_instance(instance: HostDashboardInstance) -> BeltCodexPreflight {
  let codex_home = dashboard_instance_provider_state_root(instance: instance) as String
  let codex_program = dashboard_instance_provider_executable(instance: instance) as String
  let codex_ok = belt_program_available(program: codex_program)
  let env_ok = belt_program_available(program: "env")
  if !codex_ok || !env_ok {
    belt_codex_preflight_decision_for_home(
      codex_home: codex_home,
      codex_on_path: codex_ok,
      env_on_path: env_ok,
      login_status_success: false,
      login_status_stdout: "",
      login_status_stderr: "",
    )
  } else {
    let result = gunbc.WitnessBin.Run(
      workdir: belt_observe_workdir,
      bin_path: "env" as FilePath,
      args: shape_codex_login_status_env_args_for_program(
        program: codex_program,
        codex_home: codex_home,
      ),
      expect: OutcomeIsData,
    )
    belt_codex_preflight_decision_for_home(
      codex_home: codex_home,
      codex_on_path: codex_ok,
      env_on_path: env_ok,
      login_status_success: result.success,
      login_status_stdout: result.stdout,
      login_status_stderr: result.stderr,
    )
  }
}

fn belt_codex_preflight() -> BeltCodexPreflight {
  belt_codex_preflight_for_instance(instance: srv1_live_dashboard_instance())
}

type BeltProviderPreflight
  = ProviderPreflightOk
  | ProviderPreflightRefused { step: String, detail: String }

fn belt_provider_preflight_for_instance(
  instance: HostDashboardInstance,
  provider: DispatchCliProvider,
) -> BeltProviderPreflight {
  match provider {
    ClaudeCodeProvider =>
      match belt_claude_preflight_for_instance(instance: instance) {
        ClaudePreflightOk => ProviderPreflightOk
        ClaudePreflightRefused { step: st, detail: d } =>
          ProviderPreflightRefused { step: st, detail: d }
      }
    CodexCliProvider =>
      match belt_codex_preflight_for_instance(instance: instance) {
        CodexPreflightOk { auth_method: _ } => ProviderPreflightOk
        CodexPreflightRefused { step: st, detail: d } =>
          ProviderPreflightRefused { step: st, detail: d }
      }
  }
}

fn belt_provider_preflight(provider: DispatchCliProvider) -> BeltProviderPreflight {
  belt_provider_preflight_for_instance(
    instance: srv1_live_dashboard_instance(),
    provider: provider,
  )
}

fn belt_actuate_spawn_for_instance(
  instance: HostDashboardInstance,
  node: RoadmapNode,
  probed_at: String,
) -> BeltSpawnOutcome {
  match belt_provider_preflight_for_instance(
    instance: instance,
    provider: dispatch_cli_provider,
  ) {
    ProviderPreflightRefused { step: st, detail: d } =>
      SpawnFailed { node_id: node.node as String, step: st, detail: d }
    ProviderPreflightOk =>
      belt_actuate_spawn_exec_for_instance(
        instance: instance,
        node: node,
        probed_at: probed_at,
      )
  }
}

fn belt_actuate_spawn_exec_for_instance(
  instance: HostDashboardInstance,
  node: RoadmapNode,
  probed_at: String,
) -> BeltSpawnOutcome {
  let cmds = dispatch_spawn_commands_for_instance(
    instance: instance,
    node: node,
    session_uuid: belt_spawn_session_uuid(node_id: node.node as String, probed_at: probed_at),
    attempt_key: dispatch_attempt_key(node_id: node.node, probed_at: probed_at),
    provider: dispatch_cli_provider,
  )
  match belt_exec_all(
    cmds: [cmds.worktree_add, cmds.tmux_spawn],
    workdir: instance.repo_root as String,
  ) {
    ExecOk { stdout: _ } =>
      Spawned {
        node_id: node.node as String,
        session_name: dispatch_tmux_session_name(node_id: node.node),
      }
    ExecFailed { program: p, exit_code: _, stderr: e } =>
      SpawnFailed { node_id: node.node as String, step: p, detail: e }
    ExecRefused { program: p, reason: r } =>
      SpawnFailed { node_id: node.node as String, step: p, detail: r }
  }
}

fn belt_actuate_spawn(node: RoadmapNode, probed_at: String, workdir: String) -> BeltSpawnOutcome {
  match belt_provider_preflight(provider: dispatch_cli_provider) {
    ProviderPreflightRefused { step: st, detail: d } =>
      SpawnFailed { node_id: node.node as String, step: st, detail: d }
    ProviderPreflightOk =>
      belt_actuate_spawn_exec(node: node, probed_at: probed_at, workdir: workdir)
  }
}

fn belt_actuate_spawn_exec(node: RoadmapNode, probed_at: String, workdir: String) -> BeltSpawnOutcome {
  let cmds = dispatch_spawn_commands(
    node: node,
    session_uuid: belt_spawn_session_uuid(node_id: node.node as String, probed_at: probed_at),
    attempt_key: dispatch_attempt_key(node_id: node.node, probed_at: probed_at))
  match belt_exec_all(cmds: [cmds.worktree_add, cmds.tmux_spawn], workdir: workdir) {
    ExecOk { stdout: _ } =>
      Spawned {
        node_id: node.node as String,
        session_name: dispatch_tmux_session_name(node_id: node.node),
      }
    ExecFailed { program: p, exit_code: _, stderr: e } =>
      SpawnFailed { node_id: node.node as String, step: p, detail: e }
    ExecRefused { program: p, reason: r } =>
      SpawnFailed { node_id: node.node as String, step: p, detail: r }
  }
}

type BeltTeardownOutcome
  = ReapedSession { session_name: String }
  | TeardownFailed { session_name: String, detail: String }

fn belt_actuate_teardown_for_instance(
  instance: HostDashboardInstance,
  session_name: String,
) -> BeltTeardownOutcome {
  match belt_exec(
    cmd: tmux_kill_session_argv_for_instance(
      instance: instance,
      session_name: session_name,
    ),
    workdir: belt_observe_workdir as String,
  ) {
    ExecOk { stdout: _ } => ReapedSession { session_name: session_name }
    ExecFailed { program: _, exit_code: _, stderr: e } =>
      TeardownFailed { session_name: session_name, detail: e }
    ExecRefused { program: _, reason: r } =>
      TeardownFailed { session_name: session_name, detail: r }
  }
}

fn belt_actuate_teardown(session_name: String) -> BeltTeardownOutcome {
  belt_actuate_teardown_for_instance(
    instance: srv1_live_dashboard_instance(),
    session_name: session_name,
  )
}

data belt_actuate_member_shape_note: String = "The reconcile guarantees spawns are DesiredMembers (carry the RoadmapNode for the brief) and teardowns are ObservedMembers (carry the live session). The cross arms are unreachable by construction; if ever reached they REFUSE (typed SpawnFailed/TeardownFailed), never a fabricated action — DESIGN §5 (no spawn without a node model, no teardown without an observed session)."

data belt_session_uuid_salt: NonEmptyStr = "belt-session-uuid-v1" as NonEmptyStr

data belt_spawn_session_uuid_note: String = "The UUID is the Claude provider's --session-id input; Claude requires a syntactically valid UUID. It remains computed for every provider so dispatch_spawn_commands has one stable arity, but CodexCliProvider deliberately ignores it and lets Codex mint its persisted thread id. For Claude the UUID is ATTEMPT-scoped (U1 redispatch fix 2026-07-25): derived from (node_id x the spawn's clock observation), reshaped to RFC-4122 v4. The earlier node-deterministic derivation made every node one-shot at the Claude layer. Reconcile idempotency never keys on this id — the node-grain tmux session name is the observation key."

fn belt_uuid_stamped_id(node_id: String, probed_at: String) -> NonEmptyStr {
  join([node_id, "\n", probed_at], "") as NonEmptyStr
}

fn belt_uuid_hex32(node_id: String, probed_at: String) -> String {
  concat(
    content_hash_atom(value: belt_uuid_stamped_id(node_id: node_id, probed_at: probed_at)) as String,
    content_hash_combine(
      left: content_hash_atom(value: belt_uuid_stamped_id(node_id: node_id, probed_at: probed_at)),
      right: content_hash_atom(value: belt_session_uuid_salt),
    ) as String,
  )
}

fn belt_uuid_rfc4122(hex: String) -> String {
  concat(substring(s: hex, start: 0, end: 12),
  concat("4",
  concat(substring(s: hex, start: 13, end: 16),
  concat("8",
  substring(s: hex, start: 17, end: 32)))))
}

fn belt_uuid_dash(v: String) -> String {
  concat(substring(s: v, start: 0, end: 8),
  concat("-",
  concat(substring(s: v, start: 8, end: 12),
  concat("-",
  concat(substring(s: v, start: 12, end: 16),
  concat("-",
  concat(substring(s: v, start: 16, end: 20),
  concat("-",
  substring(s: v, start: 20, end: 32)))))))))
}

fn belt_spawn_session_uuid(node_id: String, probed_at: String) -> String {
  belt_uuid_dash(v: belt_uuid_rfc4122(hex: belt_uuid_hex32(node_id: node_id, probed_at: probed_at)))
}

fn belt_actuate_spawn_member(m: DispatchMember, workdir: String) -> BeltSpawnOutcome {
  match m {
    DesiredMember { node_id: nid, node: node } =>
      match clock_now_probed_at() {
        Present { value: probed_at } =>
          belt_actuate_spawn(node: node, probed_at: probed_at as String, workdir: workdir)
        Absent =>
          SpawnFailed {
            node_id: nid,
            step: "attempt-clock",
            detail: "clock observation refused; an attempt without a stamp would collide with a later one — fail-closed, no unknown-stamped attempts",
          }
      }
    ObservedMember { node_id: nid, session: _ } =>
      SpawnFailed {
        node_id: nid,
        step: "member-shape",
        detail: "belt spawn expected DesiredMember (carries node for brief); got ObservedMember — fail-closed, no spawn without a node model",
      }
  }
}

fn belt_actuate_teardown_member(m: DispatchMember) -> BeltTeardownOutcome {
  match m {
    ObservedMember { node_id: _, session: session } =>
      belt_actuate_teardown(session_name: session.session_name)
    DesiredMember { node_id: nid, node: _ } =>
      TeardownFailed {
        session_name: nid,
        detail: "belt teardown expected ObservedMember (carries live session); got DesiredMember — fail-closed, no teardown without an observed session",
      }
  }
}

type BeltObserve
  = Observed { live: List<DispatchLiveSession> }
  | ObserveRefused { reason: String }

data belt_observe_note: String = "tmux-present is the FIRST precondition: tmux not on PATH -> ObserveRefused (the belt cannot know what is live). Once tmux is present the observe half must NOT widen an exec failure into a zero-session answer (the §5 absorbing-fallback / ⊤-as-answer-vs-⊤-as-ignorance conflation). So the decision (belt_observe_from_result) gates on exit success: `tmux ls` exit 0 -> parse stdout into the true session set. On FAILURE only tmux's two DOCUMENTED empty signals count as a genuine zero observation — stderr containing 'no server running' or 'no sessions' (grounded in the extdeps tmux.Session.List exit contract `1 => Unit \"No sessions\"`, dag/extdeps/tmux/tmux.dag) -> Observed []. EVERY OTHER failure (socket/permission/transient error, empty-stderr non-zero exit) is an UNKNOWABLE session set -> ObserveRefused (typed, located, carries stderr), never a blind spawn/reap. First-tick bootstrap still works: no server yields the documented 'no server running' signal -> Observed [] -> spawns proceed. The decision is a pure fn so every arm is witnessed (belt_observe_from_result witnesses); belt_observe only threads the live WitnessBin.Run result fields into it."

fn tmux_ls_stderr_reports_empty(stderr: String) -> Bool {
  string_contains(s: stderr, pattern: "no server running")
    || string_contains(s: stderr, pattern: "no sessions")
}

fn belt_observe_from_result(
  success: Bool,
  stdout: String,
  stderr: String,
) -> BeltObserve {
  if success {
    Observed { live: dispatch_live_sessions(tmux_ls_output: stdout) }
  } else {
    if tmux_ls_stderr_reports_empty(stderr: stderr) {
      Observed { live: [] }
    } else {
      ObserveRefused {
        reason: concat(
          "belt_observe: tmux ls exited nonzero with no documented no-server/no-sessions signal — the live session set is unknowable; fail-closed, no blind spawn/reap. stderr: ",
          stderr,
        ),
      }
    }
  }
}

fn belt_observe_for_instance(instance: HostDashboardInstance) -> BeltObserve {
  let ls = tmux_ls_argv_for_instance(instance: instance)
  if belt_program_available(program: ls.program) {
    let result = gunbc.WitnessBin.Run(
      workdir: belt_observe_workdir,
      bin_path: ls.program as FilePath,
      args: ls.args,
      expect: OutcomeIsData,
    )
    belt_observe_from_result(
      success: result.success,
      stdout: result.stdout,
      stderr: result.stderr,
    )
  } else {
    ObserveRefused {
      reason: "belt_observe: tmux not found on PATH; cannot observe belt session set; fail-closed (no blind spawn/reap on an unknowable observed set)",
    }
  }
}

fn belt_observe() -> BeltObserve {
  belt_observe_for_instance(instance: srv1_live_dashboard_instance())
}

type BeltTickResult {
  observe_refused: Bool,
  observe_refusal_reason: String,
  reconcile: BeltReconcile,
  spawn_outcomes: List<BeltSpawnOutcome>,
  teardown_outcomes: List<BeltTeardownOutcome>,
}

fn belt_tick_empty_reconcile(state: BeltRunState) -> BeltReconcile {
  BeltReconcile {
    run_state: state,
    occupied: 0,
    free: 0,
    spawns: [],
    deferred: 0,
    teardowns: [],
    refusals: [],
  }
}

data belt_tick_note: String = "The re-runnable belt driver: observe the live session set -> decide via belt_reconcile (the sole belt decision; belt_step is its degenerate spawn-only precursor) -> actuate each planned spawn/teardown through the fail-closed exec seam. Idempotent by construction: a spawned session is observed present on the next tick, keying to its ready node as Unchanged -> noop, so re-ticking never double-spawns (the observed set closes the loop the pure decision cannot). ObserveRefused short-circuits the whole tick with a typed reason and zero actions — no spawn/reap on an unknowable observed set."

fn belt_tick(
  state: BeltRunState,
  frontier: SpawnFrontier,
  cap: BeltCapacity,
  spawn_workdir: String,
) -> BeltTickResult {
  match belt_observe() {
    ObserveRefused { reason: r } =>
      BeltTickResult {
        observe_refused: true,
        observe_refusal_reason: r,
        reconcile: belt_tick_empty_reconcile(state: state),
        spawn_outcomes: [],
        teardown_outcomes: [],
      }
    Observed { live: live } => {
      let r = belt_reconcile(state: state, frontier: frontier, live: live, cap: cap)
      BeltTickResult {
        observe_refused: false,
        observe_refusal_reason: "",
        reconcile: r,
        spawn_outcomes: r.spawns |> map(m => belt_actuate_spawn_member(m: m, workdir: spawn_workdir)),
        teardown_outcomes: r.teardowns |> map(m => belt_actuate_teardown_member(m: m)),
      }
    }
  }
}

fn belt_tick_default_workdir(
  state: BeltRunState,
  frontier: SpawnFrontier,
  cap: BeltCapacity,
) -> BeltTickResult {
  belt_tick(state: state, frontier: frontier, cap: cap, spawn_workdir: belt_actuate_workdir as String)
}

fn belt_spawn_ok(o: BeltSpawnOutcome) -> Bool {
  match o {
    Spawned { node_id: _, session_name: _ } => true
    SpawnFailed { node_id: _, step: _, detail: _ } => false
  }
}

fn belt_teardown_ok(o: BeltTeardownOutcome) -> Bool {
  match o {
    ReapedSession { session_name: _ } => true
    TeardownFailed { session_name: _, detail: _ } => false
  }
}

fn belt_tick_spawn_ok_count(t: BeltTickResult) -> Int {
  count(t.spawn_outcomes |> filter(o => belt_spawn_ok(o: o)))
}

fn belt_tick_spawn_failed_count(t: BeltTickResult) -> Int {
  count(t.spawn_outcomes |> filter(o => !belt_spawn_ok(o: o)))
}

fn belt_tick_teardown_ok_count(t: BeltTickResult) -> Int {
  count(t.teardown_outcomes |> filter(o => belt_teardown_ok(o: o)))
}

data belt_run_once_note: String = "The runnable belt entrypoint: one tick against the LIVE roadmap. Reads the roadmap authority + merged PRs, builds the ready frontier, and runs belt_tick_default_workdir (Running, default capacity, belt_actuate_workdir). Zero-arg so it is invokable directly (gunbc run --function belt_run_once_json, wet), spawning a real tmux session through dispatch_cli_provider on the host it runs on. belt_run_once returns the typed BeltTickResult; belt_run_once_json projects it to a receipt (observe verdict, occupied/free/deferred, per-node spawn/teardown outcomes, refusal count) so the operator sees exactly what one tick did — no fabricated summary. Idempotent: a spawned session is observed live next tick and reconciles to noop."

fn belt_run_once() -> BeltTickResult {
  belt_tick_default_workdir(
    state: roadmap_belt_default_run_state,
    frontier: spawn_frontier(doc: roadmap_authority(), merged: authored_merged_prs()),
    cap: roadmap_belt_default_capacity,
  )
}

fn belt_spawn_outcome_json(o: BeltSpawnOutcome) -> JsonValue {
  match o {
    Spawned { node_id: nid, session_name: sn } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "spawned")),
        json_kv(key: "session_name", value: json_string(s: sn)),
      ])
    SpawnFailed { node_id: nid, step: st, detail: d } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "spawn_failed")),
        json_kv(key: "step", value: json_string(s: st)),
        json_kv(key: "detail", value: json_string(s: d)),
      ])
  }
}

fn belt_teardown_outcome_json(o: BeltTeardownOutcome) -> JsonValue {
  match o {
    ReapedSession { session_name: sn } =>
      json_object(members: [
        json_kv(key: "session_name", value: json_string(s: sn)),
        json_kv(key: "status", value: json_string(s: "reaped")),
      ])
    TeardownFailed { session_name: sn, detail: d } =>
      json_object(members: [
        json_kv(key: "session_name", value: json_string(s: sn)),
        json_kv(key: "status", value: json_string(s: "teardown_failed")),
        json_kv(key: "detail", value: json_string(s: d)),
      ])
  }
}

fn belt_tick_result_json_value(t: BeltTickResult) -> JsonValue {
  json_object(members: [
    json_kv(key: "schema", value: json_string(s: "roadmap-belt-tick/v1")),
    json_kv(key: "observe_refused", value: json_bool(b: t.observe_refused)),
    json_kv(key: "observe_refusal_reason", value: json_string(s: t.observe_refusal_reason)),
    json_kv(key: "run_state", value: json_string(s: belt_run_state_label(s: t.reconcile.run_state))),
    json_kv(key: "occupied", value: json_int(n: t.reconcile.occupied)),
    json_kv(key: "free", value: json_int(n: t.reconcile.free)),
    json_kv(key: "deferred", value: json_int(n: t.reconcile.deferred)),
    json_kv(key: "refusal_count", value: json_int(n: belt_reconcile_refusal_count(r: t.reconcile))),
    json_kv(key: "spawned", value: json_int(n: belt_tick_spawn_ok_count(t: t))),
    json_kv(key: "spawn_failed", value: json_int(n: belt_tick_spawn_failed_count(t: t))),
    json_kv(key: "reaped", value: json_int(n: belt_tick_teardown_ok_count(t: t))),
    json_kv(key: "spawn_outcomes", value: json_array(elements: t.spawn_outcomes |> map(o => belt_spawn_outcome_json(o: o)))),
    json_kv(key: "teardown_outcomes", value: json_array(elements: t.teardown_outcomes |> map(o => belt_teardown_outcome_json(o: o)))),
  ])
}

type BeltAttempts
  = AttemptsObserved { attempts: List<DispatchAttemptRef> }
  | AttemptsRefused { reason: String }

data belt_attempts_observe_note: String = "U3: the attempts observation mirrors belt_observe's fail-closed grammar — git absent or a non-zero for-each-ref is an UNKNOWABLE attempts set (AttemptsRefused, typed, carries stderr), never widened to zero attempts; exit 0 with empty output IS a genuine zero (for-each-ref's documented no-match behavior). Runs in belt_actuate_workdir — the same repo-root authority the spawn's worktree add uses, because the attempt branches live exactly where spawns mint them."

fn belt_attempts_observe_for_instance(instance: HostDashboardInstance) -> BeltAttempts {
  let cmd = git_for_each_ref_dispatch_argv()
  if belt_program_available(program: cmd.program) {
    let result = gunbc.WitnessBin.Run(
      workdir: instance.repo_root,
      bin_path: cmd.program as FilePath,
      args: cmd.args,
    )
    if result.success {
      AttemptsObserved { attempts: dispatch_attempt_refs(git_output: result.stdout) }
    } else {
      AttemptsRefused { reason: concat("git for-each-ref failed: ", result.stderr) }
    }
  } else {
    AttemptsRefused { reason: "git not found on PATH — the attempts set is unknowable" }
  }
}

fn belt_attempts_observe() -> BeltAttempts {
  belt_attempts_observe_for_instance(instance: srv1_live_dashboard_instance())
}

fn belt_attempts_json_value(a: BeltAttempts) -> JsonValue {
  match a {
    AttemptsRefused { reason: r } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: "roadmap-attempts/v1")),
        json_kv(key: "attempts_refused", value: json_bool(b: true)),
        json_kv(key: "reason", value: json_string(s: r)),
      ])
    AttemptsObserved { attempts } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: "roadmap-attempts/v1")),
        json_kv(key: "attempts_refused", value: json_bool(b: false)),
        json_kv(key: "attempts", value: json_array(elements: attempts |> map(a2 =>
          json_object(members: [
            json_kv(key: "node_id", value: json_string(s: a2.node_id)),
            json_kv(key: "branch", value: json_string(s: a2.branch)),
            json_kv(key: "attempt_key", value: json_string(s: a2.attempt_key)),
          ])))),
      ])
  }
}

fn belt_attempts_observed_json(a: BeltAttempts) -> String {
  serialize_json(v: belt_attempts_json_value(a: a))
}

fn belt_attempts_http_status(a: BeltAttempts) -> Int {
  match a {
    AttemptsRefused { reason: _ } => 503
    AttemptsObserved { attempts: _ } => 200
  }
}

type BeltStopResult
  = StopStopped { node_id: String, session_name: String }
  | StopDisabled { node_id: String, instance_id: String, reason: String }
  | StopRefusedResult { node_id: String, reason: String }
  | StopObserveRefused { node_id: String, reason: String }
  | StopTeardownFailed { node_id: String, session_name: String, detail: String }

data belt_stop_note: String = "U4 (stop from the UI): the R5 owned-only teardown as a wire actuation. The decision chain is observation-first and refuses at every unknowable: tmux ls refused → StopObserveRefused (503); pane read refused → the observation stays name-only and the gate refuses fingerprint-unobserved (409) — a pane-read failure NEVER widens into a kill; the gate itself refuses foreign/absent/inaccessible per verdict (409/404); only a Converged-or-Drifted observation reaches tmux kill-session, and a kill that fails is its own typed arm (502). The operator's hand-made sleep session wearing a dispatch name is the standing negative control: it observes Conflict and the button refuses to kill it."

fn belt_observe_panes_for_instance(instance: HostDashboardInstance) -> List<TmuxPaneEntry>? {
  let cmd = tmux_list_panes_argv_for_instance(instance: instance)
  if belt_program_available(program: cmd.program) {
    let result = gunbc.WitnessBin.Run(
      workdir: belt_observe_workdir,
      bin_path: cmd.program as FilePath,
      args: cmd.args,
    )
    if result.success {
      Present { value: parse_tmux_panes_output(output: result.stdout) }
    } else {
      none
    }
  } else {
    none
  }
}

fn belt_observe_panes() -> List<TmuxPaneEntry>? {
  belt_observe_panes_for_instance(instance: srv1_live_dashboard_instance())
}

fn belt_stop_node_for_instance(
  instance: HostDashboardInstance,
  node_id: String,
) -> BeltStopResult {
  if !dashboard_instance_can_actuate(instance: instance) {
    StopDisabled {
      node_id: node_id,
      instance_id: instance.instance_id as String,
      reason: "dashboard instance is observe-only; stop refused before tmux observation",
    }
  } else {
  match belt_observe_for_instance(instance: instance) {
    ObserveRefused { reason: r } => StopObserveRefused { node_id: node_id, reason: r }
    Observed { live } => {
      let scope = dispatch_tmux_session_scope(node_id: node_id)
      let entries = live
        |> filter(sess => sess.session_name == (scope.session_name as String))
        |> map(sess => TmuxLsEntry { session_name: sess.session_name, windows: sess.windows })
      let obs = match belt_observe_panes_for_instance(instance: instance) {
        Present { value: panes } =>
          tmux_session_observation_with_panes(scope: scope, entries: entries, panes: panes)
        Absent =>
          tmux_session_observation_with_panes(scope: scope, entries: entries, panes: [])
      }
      match dispatch_stop_gate(scope: scope, obs: obs) {
        StopRefused { reason: r2 } => StopRefusedResult { node_id: node_id, reason: r2 }
        StopPermitted { session_name: sn } =>
          match belt_actuate_teardown_for_instance(instance: instance, session_name: sn) {
            ReapedSession { session_name: sn2 } => StopStopped { node_id: node_id, session_name: sn2 }
            TeardownFailed { session_name: sn3, detail: d } =>
              StopTeardownFailed { node_id: node_id, session_name: sn3, detail: d }
          }
      }
    }
  }
  }
}

fn belt_stop_node(node_id: String) -> BeltStopResult {
  belt_stop_node_for_instance(
    instance: srv1_live_dashboard_instance(),
    node_id: node_id,
  )
}

fn belt_stop_result_json_value(r: BeltStopResult) -> JsonValue {
  match r {
    StopStopped { node_id: nid, session_name: sn } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "stopped")),
        json_kv(key: "session_name", value: json_string(s: sn)),
      ])
    StopDisabled { node_id: nid, instance_id: iid, reason: why } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "stop_disabled")),
        json_kv(key: "instance", value: json_string(s: iid)),
        json_kv(key: "reason", value: json_string(s: why)),
      ])
    StopRefusedResult { node_id: nid, reason: r2 } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "stop_refused")),
        json_kv(key: "reason", value: json_string(s: r2)),
      ])
    StopObserveRefused { node_id: nid, reason: r3 } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "observe_refused")),
        json_kv(key: "reason", value: json_string(s: r3)),
      ])
    StopTeardownFailed { node_id: nid, session_name: sn, detail: d } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "teardown_failed")),
        json_kv(key: "session_name", value: json_string(s: sn)),
        json_kv(key: "detail", value: json_string(s: d)),
      ])
  }
}

fn belt_stop_http_status(r: BeltStopResult) -> Int {
  match r {
    StopStopped { node_id: _, session_name: _ } => 200
    StopDisabled { node_id: _, instance_id: _, reason: _ } => 403
    StopRefusedResult { node_id: _, reason: r2 } =>
      if string_contains(s: r2, pattern: "no live session") { 404 } else { 409 }
    StopObserveRefused { node_id: _, reason: _ } => 503
    StopTeardownFailed { node_id: _, session_name: _, detail: _ } => 502
  }
}

fn belt_stop_json(node_id: String) -> String {
  serialize_json(v: belt_stop_result_json_value(r: belt_stop_node(node_id: node_id)))
}

data belt_sessions_json_note: String = "U2 (sessions panel v0): the belt observation projected as wire JSON so the PAGE can know what is live without the render losing purity — the healthz digest is taken over the pure page body, so live state must arrive by fetch, exactly as dispatch answers do. The projection is a pure fn over BeltObserve (every arm witnessed on synthetic values); the effectful wrapper only threads belt_observe() in. The refusal arm stays a refusal on the wire (observe_refused true + reason, served 503): an unknowable session set renders loud at the client, never as an empty panel."

fn belt_sessions_json_value(o: BeltObserve) -> JsonValue {
  match o {
    ObserveRefused { reason: r } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: "roadmap-sessions/v1")),
        json_kv(key: "observe_refused", value: json_bool(b: true)),
        json_kv(key: "reason", value: json_string(s: r)),
      ])
    Observed { live } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: "roadmap-sessions/v1")),
        json_kv(key: "observe_refused", value: json_bool(b: false)),
        json_kv(key: "sessions", value: json_array(elements: live |> map(sess =>
          json_object(members: [
            json_kv(key: "node_id", value: json_string(s: sess.node_id)),
            json_kv(key: "session_name", value: json_string(s: sess.session_name)),
          ])))),
      ])
  }
}

fn belt_sessions_observed_json(o: BeltObserve) -> String {
  serialize_json(v: belt_sessions_json_value(o: o))
}

fn belt_sessions_json() -> String {
  belt_sessions_observed_json(o: belt_observe())
}

fn belt_sessions_http_status(o: BeltObserve) -> Int {
  match o {
    ObserveRefused { reason: _ } => 503
    Observed { live: _ } => 200
  }
}

fn belt_run_once_json() -> String {
  serialize_json(v: belt_tick_result_json_value(t: belt_run_once()))
}

data belt_run_once_cli_note: String = "The ProcessExit entrypoint — this is what `gunbc run --function belt_run_once_cli` invokes (belt_run_once_json returns String, which `gunbc run` rejects; belt_run_once_cli is its runnable wrapper). Fail-closed exit mapping, idiomatic per srv3_boot_once_cd / host_build_cache_provision: a clean idempotent tick -> ExitSuccess (exit 0, silent). ANY problem surfaces the FULL JSON receipt loudly on stderr via exit_failure(reason): observe_refused (the live session set was unknowable, so no actions were taken) -> exit_failure(receipt); or one-or-more spawn_failed outcomes (a git-worktree/tmux/which failure) -> exit_failure(receipt). The receipt is the whole BeltTickResult projection, so the operator reads exactly which node failed at which step. Teardown failures are surfaced in the receipt but do NOT flip the exit — a reap that could not complete is not a reason to fail the tick (the session is still tracked and retried next tick); only a spawn failure or an unknowable observation is a hard stop. For always-on observation of a SUCCESSFUL tick's receipt, belt_run_once_json is the string form (witness/inspection)."

fn belt_run_once_cli() -> ProcessExit {
  let t = belt_run_once()
  let receipt = serialize_json(v: belt_tick_result_json_value(t: t))
  if t.observe_refused {
    exit_failure(reason: receipt)
  } else {
    if belt_tick_spawn_failed_count(t: t) > 0 {
      exit_failure(reason: receipt)
    } else {
      ExitSuccess
    }
  }
}

data belt_dispatch_node_note: String = "Per-node MANUAL dispatch — the click path (operator 2026-07-20: 'i should just manually click/dispatch'). belt_run_once ticks the WHOLE ready frontier; belt_dispatch_node spawns exactly ONE node by id, operator-selected from the roadmap UI, NOT frontier-gated (the operator's click IS the selection). DONE = the operator's SIGNOFF, never a merged PR (operator: 'PR merged not necessarily mean item == done — they may not be 1:1'): a signoff-accepted node refuses dispatch (DispatchNodeAlreadyDone); a node whose PRs merged but is unsigned is still 'in review' and remains dispatchable (more work). Idempotent by the same observe-before-spawn the tick uses: if the node's session is already live, DispatchAlreadyLive (noop), so a double-click never double-spawns. Fail-closed: unknown node id -> DispatchNodeNotFound; unknowable observed set -> DispatchObserveRefused; spawn failure -> DispatchSpawnFailed (never a fabricated success). Reuses belt_lookup_node (pure roadmap read), belt_observe, and belt_actuate_spawn — no forked spawn path."

type BeltNodeLookup
  = NodeFound { node: RoadmapNode }
  | NodeMissing

fn belt_find_node_in(nodes: List<RoadmapNode>, node_id: String) -> BeltNodeLookup {
  let matches = nodes |> filter(n => n.node == node_id)
  fold(matches, init: NodeMissing, f: fn(acc, n) {
    match acc {
      NodeFound { node: _ } => acc
      NodeMissing => NodeFound { node: n }
    }
  })
}

fn belt_lookup_node(node_id: String) -> BeltNodeLookup {
  belt_find_node_in(nodes: doc_all_nodes(doc: roadmap_authority()), node_id: node_id)
}

fn belt_node_session_live(live: List<DispatchLiveSession>, node_id: String) -> Bool {
  any(live, s => s.node_id == node_id)
}

type BeltDispatchResult
  = DispatchSpawned { node_id: String, session_name: String }
  | DispatchAlreadyLive { node_id: String, session_name: String }
  | DispatchDisabled { node_id: String, instance_id: String, reason: String }
  | DispatchNodeNotFound { node_id: String }
  | DispatchNodeAlreadyDone { node_id: String }
  | DispatchObserveRefused { node_id: String, reason: String }
  | DispatchSpawnFailed { node_id: String, step: String, detail: String }

fn belt_dispatch_node_for_instance(
  instance: HostDashboardInstance,
  node_id: String,
) -> BeltDispatchResult {
  if !dashboard_instance_can_actuate(instance: instance) {
    DispatchDisabled {
      node_id: node_id,
      instance_id: instance.instance_id as String,
      reason: "dashboard instance is observe-only; dispatch refused before observation, provider preflight, or worktree creation",
    }
  } else {
  match belt_lookup_node(node_id: node_id) {
    NodeMissing => DispatchNodeNotFound { node_id: node_id }
    NodeFound { node: node } =>
      if signoff_accepts(s: node.signoff) {
        DispatchNodeAlreadyDone { node_id: node_id }
      } else {
        match belt_observe_for_instance(instance: instance) {
          ObserveRefused { reason: r } =>
            DispatchObserveRefused { node_id: node_id, reason: r }
          Observed { live: live } =>
            if belt_node_session_live(live: live, node_id: node_id) {
              DispatchAlreadyLive {
                node_id: node_id,
                session_name: dispatch_tmux_session_name(node_id: node.node),
              }
            } else {
              match (match clock_now_probed_at() {
                Present { value: probed_at } =>
                  belt_actuate_spawn_for_instance(
                    instance: instance,
                    node: node,
                    probed_at: probed_at as String,
                  )
                Absent =>
                  SpawnFailed {
                    node_id: node_id,
                    step: "attempt-clock",
                    detail: "clock observation refused; an attempt without a stamp would collide with a later one — fail-closed, no unknown-stamped attempts",
                  }
              }) {
                Spawned { node_id: sid, session_name: sn } =>
                  DispatchSpawned { node_id: sid, session_name: sn }
                SpawnFailed { node_id: sid, step: st, detail: d } =>
                  DispatchSpawnFailed { node_id: sid, step: st, detail: d }
              }
            }
        }
      }
  }
  }
}

fn belt_dispatch_node(node_id: String) -> BeltDispatchResult {
  belt_dispatch_node_for_instance(
    instance: srv1_live_dashboard_instance(),
    node_id: node_id,
  )
}

fn belt_dispatch_result_ok(r: BeltDispatchResult) -> Bool {
  dispatch_band_is_ok(b: belt_dispatch_result_band(r: r))
}

data belt_dispatch_status_label_note: String = "The ONE wire vocabulary for a dispatch result (DESIGN §3, found live 2026-07-23): the served JSON body's `status` member and the roadmap page's client-side ok-check are two consumers of ONE label set — the dispatch button read a retired belt-A `\{ok, node\}` shape while belt B answered `\{status, ...\}`, so EVERY successful click rendered 'failed' (a silently-wrong UI answer, §5). belt_dispatch_status_label is the per-variant label authority consumed by belt_dispatch_result_json_value; belt_dispatch_ok_status_labels is the ok-subset the page derives its JS predicate from, glued to belt_dispatch_result_ok by witness (a label moved across the ok/refusal line without updating both surfaces goes RED)."

fn belt_dispatch_status_label(r: BeltDispatchResult) -> String {
  match r {
    DispatchSpawned { node_id: _, session_name: _ } => "spawned"
    DispatchAlreadyLive { node_id: _, session_name: _ } => "already_live"
    DispatchDisabled { node_id: _, instance_id: _, reason: _ } => "disabled"
    DispatchNodeNotFound { node_id: _ } => "node_not_found"
    DispatchNodeAlreadyDone { node_id: _ } => "already_done_signed_off"
    DispatchObserveRefused { node_id: _, reason: _ } => "observe_refused"
    DispatchSpawnFailed { node_id: _, step: _, detail: _ } => "spawn_failed"
  }
}

fn belt_dispatch_disabled_status_label() -> String {
  belt_dispatch_status_label(
    r: DispatchDisabled {
      node_id: "label-exemplar",
      instance_id: "label-exemplar",
      reason: "label-exemplar",
    },
  )
}

data dispatch_band_note: String = "The operator-facing state vocabulary (operator ruling 2026-07-24, roadmap-workspace-remodel-plan W1a): the wire taxonomy is the belt's DIAGNOSTIC vocabulary and must not moonlight as button text. The operator reads BANDS, each a remedy class — ok: the click achieved or already holds the desired state; fail: this click cannot achieve it and the ROW is the remedy (wrong node, already signed off); loud: the BELT itself is unwell (observe refused, spawn failed — step/detail surface in the detail channel, never the caption). BandInProgress is inhabited only by the client's requested phase: no wire RESULT maps to it (the fold below has no arm producing it), so presentation cannot fabricate progress out of an answer. This fold is now the SINGLE ok-authority — belt_dispatch_result_ok and belt_dispatch_ok_status_labels are projections of it; the former hand copies (a Bool match, a hand list, a label predicate — three spellings of one fact) were the half-born-band defect this dissolves."

type DispatchBand
  = BandOk
  | BandInProgress
  | BandFail
  | BandLoud

fn belt_dispatch_result_band(r: BeltDispatchResult) -> DispatchBand {
  match r {
    DispatchSpawned { node_id: _, session_name: _ } => BandOk
    DispatchAlreadyLive { node_id: _, session_name: _ } => BandOk
    DispatchDisabled { node_id: _, instance_id: _, reason: _ } => BandFail
    DispatchNodeNotFound { node_id: _ } => BandFail
    DispatchNodeAlreadyDone { node_id: _ } => BandFail
    DispatchObserveRefused { node_id: _, reason: _ } => BandLoud
    DispatchSpawnFailed { node_id: _, step: _, detail: _ } => BandLoud
  }
}

fn dispatch_band_key(b: DispatchBand) -> String {
  match b {
    BandOk => "ok"
    BandInProgress => "in-progress"
    BandFail => "fail"
    BandLoud => "loud"
  }
}

fn dispatch_band_is_ok(b: DispatchBand) -> Bool {
  match b {
    BandOk => true
    BandInProgress => false
    BandFail => false
    BandLoud => false
  }
}

fn belt_dispatch_ok_status_labels() -> List<String> {
  belt_dispatch_result_exemplars()
    |> filter(r => dispatch_band_is_ok(b: belt_dispatch_result_band(r: r)))
    |> map(r => belt_dispatch_status_label(r: r))
}

type DispatchLabelBandRow {
  wire_label: String
  band_key: String
}

fn belt_dispatch_label_band_rows() -> List<DispatchLabelBandRow> {
  map(belt_dispatch_result_exemplars(), r => DispatchLabelBandRow {
    wire_label: belt_dispatch_status_label(r: r),
    band_key: dispatch_band_key(b: belt_dispatch_result_band(r: r)),
  })
}

fn label_band_rows_cover(rows: List<DispatchLabelBandRow>, labels: List<String>) -> Bool {
  all(labels, l => count(filter(rows, row => row.wire_label == l)) == 1)
}

fn belt_dispatch_label_band_key(wire_label: String) -> String {
  match belt_dispatch_result_for_label(wire_label: wire_label) {
    Present { value: r } => dispatch_band_key(b: belt_dispatch_result_band(r: r))
    Absent => dispatch_band_key(b: BandLoud)
  }
}

data belt_dispatch_all_status_labels_note: String = "The full wire-label set, GROUNDED in belt_dispatch_status_label rather than hand-listed (§3): one exemplar per BeltDispatchResult variant, mapped through the label authority. The exemplar roster is the single manual enumeration the closed variant set forces — the same enumeration witness_dispatch_status_labels_pin_wire_contract already pins — and it is fail-closed twice: an 8th variant makes belt_dispatch_status_label's match non-exhaustive (compiler-caught), and gunbc.roadmap_component derives the DispatchButton's terminal states from THIS list and cross-checks totality both directions (a label with no state row, a state with no label — each red), so the button's state set cannot silently drift from the served contract. This is the projection the dispatch-button incident (2026-07-23) needed: one authority for the wire vocabulary, consumed by the JSON body, the page ok-predicate, and now the component state totality."

fn belt_dispatch_result_exemplars() -> List<BeltDispatchResult> {
  [
    DispatchSpawned { node_id: "x", session_name: "s" },
    DispatchAlreadyLive { node_id: "x", session_name: "s" },
    DispatchDisabled { node_id: "x", instance_id: "i", reason: "r" },
    DispatchNodeNotFound { node_id: "x" },
    DispatchNodeAlreadyDone { node_id: "x" },
    DispatchObserveRefused { node_id: "x", reason: "r" },
    DispatchSpawnFailed { node_id: "x", step: "s", detail: "d" },
  ]
}

fn belt_dispatch_all_status_labels() -> List<String> {
  map(belt_dispatch_result_exemplars(), r => belt_dispatch_status_label(r: r))
}

fn belt_dispatch_result_for_label(wire_label: String) -> BeltDispatchResult? {
  belt_dispatch_result_exemplars()
    |> filter(r => belt_dispatch_status_label(r: r) == wire_label)
    |> first
}

fn belt_dispatch_label_is_ok(wire_label: String) -> Bool {
  any(belt_dispatch_ok_status_labels(), l => l == wire_label)
}

data belt_dispatch_path_prefix_note: String = "The dispatch route prefix, part of the wire contract (the click POSTs to prefix+NODE_ID; belt B answers it at the /dispatch/ NODE_ID route). Homed here with the rest of the wire vocabulary (§3) so the client script builder (gunbc.roadmap_component) and the emitted server (node_http_server_emit) read one authority — it moved off roadmap_page to break the page-to-component import cycle the TsProgram builder would otherwise create."

data belt_dispatch_path_prefix: String = "/dispatch/"

fn belt_dispatch_provider_label() -> String {
  dispatch_provider_label(provider: dispatch_cli_provider)
}

fn belt_dispatch_result_json_value(r: BeltDispatchResult) -> JsonValue {
  match r {
    DispatchSpawned { node_id: nid, session_name: sn } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: belt_dispatch_status_label(r: r))),
        json_kv(key: "provider", value: json_string(s: belt_dispatch_provider_label())),
        json_kv(key: "session_name", value: json_string(s: sn)),
      ])
    DispatchAlreadyLive { node_id: nid, session_name: sn } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: belt_dispatch_status_label(r: r))),
        json_kv(key: "session_name", value: json_string(s: sn)),
      ])
    DispatchDisabled { node_id: nid, instance_id: iid, reason: why } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: belt_dispatch_status_label(r: r))),
        json_kv(key: "instance", value: json_string(s: iid)),
        json_kv(key: "reason", value: json_string(s: why)),
      ])
    DispatchNodeNotFound { node_id: nid } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: belt_dispatch_status_label(r: r))),
      ])
    DispatchNodeAlreadyDone { node_id: nid } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: belt_dispatch_status_label(r: r))),
      ])
    DispatchObserveRefused { node_id: nid, reason: r2 } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: belt_dispatch_status_label(r: r))),
        json_kv(key: "reason", value: json_string(s: r2)),
      ])
    DispatchSpawnFailed { node_id: nid, step: st, detail: d } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: belt_dispatch_status_label(r: r))),
        json_kv(key: "provider", value: json_string(s: belt_dispatch_provider_label())),
        json_kv(key: "step", value: json_string(s: st)),
        json_kv(key: "detail", value: json_string(s: d)),
      ])
  }
}

data belt_dispatch_env_var: NonEmptyStr = "GUNBC_BELT_NODE_ID" as NonEmptyStr

data belt_dispatch_node_cli_note: String = "The ProcessExit entrypoint the roadmap-UI launch button drives. gunbc run --function cannot pass an argument (there is no --arg flag), so the node id enters through the environment: the Node HTTP server on srv1 shells env GUNBC_BELT_NODE_ID=NODE gunbc run --function belt_dispatch_node_cli, and this reads it via shell.Env.Get (the same env-read authority github.auth uses for its token). Fail-closed on the channel: a missing OR empty GUNBC_BELT_NODE_ID refuses — shell.Env.Get returns a Present-but-empty value for an unset var wet, so empty is folded into the same refusal as Absent. Exit map: DispatchSpawned or DispatchAlreadyLive -> ExitSuccess (the click achieved or already holds the desired state, the node is being worked); every refusal or failure (node_not_found, already_done, observe_refused, spawn_failed) -> exit_failure with the JSON receipt on stderr, so the server relays the exact cause back to the operator."

fn belt_dispatch_node_cli() -> ProcessExit {
  match shell.Env.Get(name: belt_dispatch_env_var).value {
    Absent =>
      exit_failure(reason: "belt_dispatch_node_cli: GUNBC_BELT_NODE_ID not set — no node id to dispatch (fail-closed)")
    Present { value: v } =>
      if string_length(s: v) == 0 {
        exit_failure(reason: "belt_dispatch_node_cli: GUNBC_BELT_NODE_ID is empty — no node id to dispatch (fail-closed)")
      } else {
        let r = belt_dispatch_node(node_id: v)
        if belt_dispatch_result_ok(r: r) {
          ExitSuccess
        } else {
          exit_failure(reason: serialize_json(v: belt_dispatch_result_json_value(r: r)))
        }
      }
  }
}
