module gunbc.roadmap_belt_actuate



data belt_actuate_exec_authority_note: String = "Slice 2b actuation: the belt DECISION (gunbc.roadmap_belt.belt_reconcile) is CLOSED against the host by three proven single-authorities — the actuator's HostExecArgv argv model (gunbc.roadmap_dispatch_actuator, the one place git/tmux/provider argv is shaped), gunbc.WitnessBin.Run (the typed-argv exec intrinsic, no shell string), and shell.Which.Check (program -> bin_path). Provider is a closed ClaudeCodeProvider | CodexCliProvider choice whose argv, preflight, and pane fingerprint move together. This remains fail-closed throughout: which-miss or auth uncertainty refuses before git worktree add; a worktree failure short-circuits tmux spawn; a nonzero provider process after tmux accepted is runtime evidence, not spawn evidence, and is deliberately NOT absorbed into Spawned-as-success."

data belt_actuate_placement_dissolution_trigger: std.disposition.Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.roadmap_dispatch_actuator",
    decl_name: "classify_dispatch_lease_upsert",
    field: WholeDeclaration
  }
}

data belt_actuate_fingerprint_dissolution_trigger: std.disposition.Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.roadmap_dispatch_actuator",
    decl_name: "dispatch_tmux_process_fingerprint_observation_dissolution_trigger",
    field: WholeDeclaration
  }
}

data belt_actuate_workdir_note: String = "Two DISTINCT workdirs, because the belt's two host verbs bind to different roots (a §5 fail-open otherwise: observing from a repo path that may not exist on an arbitrary host would make `tmux ls` fail and — before this split — get widened to an empty session set). belt_actuate_workdir is the SPAWN root: `git worktree add` must run inside the gunbc repo — a PROJECTION of gunbc.host_layout.srv1_gunbc_repo_root (the single path authority; its former private copy deleted, DESIGN §3): the same tree `gunbc serve` loads, which is why dispatch works in-process. belt_observe_workdir is the host-global root '/': `tmux ls` and `tmux kill-session` act on the per-user tmux server (a host singleton, not a repo), so they must run from a directory guaranteed to exist on the host — never the repo path, which may be absent (fake-claude test box, a freshly-enrolled srvN). Observe/teardown therefore carry no workdir parameter; only spawn is workdir-parameterized."

data belt_actuate_workdir: std.types.FilePath = srv1_gunbc_repo_root

data belt_observe_workdir: std.types.FilePath = "/" as std.types.FilePath

type BeltExecOutcome
  = ExecOk { stdout: String }
  | ExecFailed { program: String, exit_code: Int, stderr: String }
  | ExecRefused { program: String, reason: String }

data belt_program_available_note: String = "program-on-PATH probe via shell.Which.Check exit_success (Bool), NOT its .path field: the Which .path realization is a bare-stdout string wet (the Optional-over-Value::Null realization fork — DESIGN open thread), so the belt keys on the exit Bool and lets WitnessBin.Run's `env -C \{workdir\} \{bin_path\} args` resolve the bare program name via PATH (env execvp searches PATH). This keeps 'program missing' (refuse) distinct from 'program present, exited nonzero' (fail) without touching the Optional straddle."

data belt_outcome_is_data_note: String = "The probes in this module are annotated OutcomeIsData (operator ruling 2026-07-25): their exit codes are ANSWERS the belt adjudicates, not faults. belt_program_available's which-miss is the 'program missing' pole this module's belt_program_available_note already keeps deliberately distinct from 'present but exited nonzero'; belt_exec's nonzero exit becomes ExecFailed; belt_observe's becomes a typed BeltObserve arm. In every case the belt renders the fault loudly through its own per-variant status mapping, so the effect layer's anomaly glyph was a second, cruder judgment of an event that already has a real adjudicator. ADMISSIBILITY (§5 guard, gunbc.output_policy outcome_is_data_note): each annotated fn returns a typed value whose arms ARE the adjudication — Bool for the availability probe (consumed as the refuse/fail discriminator, never discarded), BeltExecOutcome, BeltObserve, PublicationCredentialSource — never unit. Dispatch failure stays anomalous: it is not an exit code and does not travel this arm."

fn belt_program_available(program: String) -> Bool {
  shell.Which.Check(command: program as std.types.NonEmptyStr, expect: OutcomeIsData).exists
}

fn belt_exec(cmd: gunbc.roadmap_dispatch_actuator.HostExecArgv, workdir: String) -> BeltExecOutcome {
  if belt_program_available(program: cmd.program) {
    let result = gunbc.WitnessBin.Run(
      workdir: workdir as std.types.FilePath,
      bin_path: cmd.program as std.types.FilePath,
      args: cmd.args,
      expect: OutcomeIsData,
    )
    if result.success {
      ExecOk { stdout: result.stdout }
    } else {
      ExecFailed { program: cmd.program, exit_code: result.exit_code, stderr: result.stderr }
    }
  } else {
    ExecRefused {
      program: cmd.program,
      reason: "belt_exec: program not found on PATH (which exit nonzero); fail-closed, no fabricated success",
    }
  }
}

data belt_exec_all_fail_closed_note: String = "Fail-closed sequencing: fold runs each argv in order; once a step is non-ok (ExecFailed/ExecRefused) the accumulator SHORT-CIRCUITS — belt_exec is NOT called for the remaining steps and the first failure is returned. Spawn's worktree-add -> tmux-new-session ordering rides this: a failed git worktree add never spawns the tmux session (no orphan session on a missing worktree). Discriminating control: remove the ExecOk-guarded short-circuit and [false, echo] would run echo and go green when it must stay failed."

fn belt_exec_all(cmds: List<gunbc.roadmap_dispatch_actuator.HostExecArgv>, workdir: String) -> BeltExecOutcome {
  fold(cmds, init: ExecOk { stdout: "" }, f: fn(acc, cmd) {
    match acc {
      ExecOk { stdout: _ } => belt_exec(cmd: cmd, workdir: workdir)
      ExecFailed { program: _, exit_code: _, stderr: _ } => acc
      ExecRefused { program: _, reason: _ } => acc
    }
  })
}

type BeltExecStep {
  step: String
  command: gunbc.roadmap_dispatch_actuator.HostExecArgv
}

type BeltExecStepsOutcome
  = ExecStepsOk
  | ExecStepFailed { step: String, detail: String }

fn belt_exec_steps(
  steps: List<BeltExecStep>,
  workdir: String,
) -> BeltExecStepsOutcome {
  fold(steps, init: ExecStepsOk, f: fn(acc, step) {
    match acc {
      ExecStepFailed { step: _, detail: _ } => acc
      ExecStepsOk =>
        match belt_exec(cmd: step.command, workdir: workdir) {
          ExecOk { stdout: _ } => ExecStepsOk
          ExecFailed { program: _, exit_code, stderr } =>
            ExecStepFailed {
              step: step.step,
              detail: join([
                "exit ", to_string(exit_code), ": ", stderr,
              ], ""),
            }
          ExecRefused { program: _, reason } =>
            ExecStepFailed { step: step.step, detail: reason }
        }
    }
  })
}

type AttemptStateInitialization
  = AttemptStateInitialized
  | AttemptStateInitializationFailed { step: String, detail: String }

data attempt_state_publication_note: String = "A modeled attempt publishes an immutable evidence prefix before provider launch. After worktree and state-directory creation, the serve process writes the attempt key, the exact grounded environment-admission JSON receipt, and an empty provider-events.jsonl file through typed Filesystem.Write operations. Only then does it replace the node-current symlink. The replace may have a brief unreadable interval, which the observer reports as refusal and retries on its next poll; no atomicity is claimed for `ln -sfnT`. A readable current attempt is constructive proof that admission, workspace creation, and event capture initialization preceded provider launch; the progress route validates the admitted receipt rather than inferring those stages from a tmux name."

fn belt_attempt_state_initialize_for_instance(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  node: gunbc.roadmap_model.RoadmapNode,
  attempt_key: String,
  admission_receipt: String,
) -> AttemptStateInitialization {
  let key_write = Filesystem.Write(
    path: dispatch_attempt_key_path_for_instance(
      instance: instance,
      node_id: node.node,
      attempt_key: attempt_key,
    ),
    content: attempt_key,
  )
  if !key_write.success {
    AttemptStateInitializationFailed {
      step: "attempt-key-write",
      detail: key_write.error,
    }
  } else {
    let admission_write = Filesystem.Write(
      path: dispatch_attempt_admission_path_for_instance(
        instance: instance,
        node_id: node.node,
        attempt_key: attempt_key,
      ),
      content: admission_receipt,
    )
    if !admission_write.success {
      AttemptStateInitializationFailed {
        step: "attempt-admission-write",
        detail: admission_write.error,
      }
    } else {
      let events_write = Filesystem.Write(
        path: dispatch_attempt_events_path_for_instance(
          instance: instance,
          node_id: node.node,
          attempt_key: attempt_key,
        ),
        content: "",
      )
      if events_write.success {
        let pin_persisted = belt_persist_oracle_pin_for_instance(
          instance: instance,
          node: node,
          attempt_key: attempt_key,
          capture: belt_attempt_oracle_pin_capture_for_instance(
            instance: instance,
            node: node,
            attempt_key: attempt_key,
          ),
        )
        let receipt_initialized = Filesystem.Write(
          path: dispatch_attempt_validation_receipt_path_for_instance(
            instance: instance,
            node_id: node.node,
            attempt_key: attempt_key,
          ),
          content: validation_receipt_json(
            verdict: ValidationNotRun,
            observations: belt_oracle_observations_in_worktree(
              contract: node.execution,
              worktree: dispatch_worktree_path_for_instance(
                instance: instance,
                node_id: node.node,
                attempt_key: attempt_key,
              ),
            ),
          ),
        ).success
        if !receipt_initialized {
          AttemptStateInitializationFailed {
            step: "attempt-validation-receipt-initialize",
            detail: "the not-run validation receipt could not be written beside the attempt; without it a later unreadable receipt is indistinguishable from an absent one, which is the conflation this initialization exists to remove",
          }
        } else if pin_persisted {
          AttemptStateInitialized
        } else {
          AttemptStateInitializationFailed {
            step: "attempt-oracle-pin-persist",
            detail: "the validation oracle pin could not be written beside the attempt; an attempt whose oracle is unrecorded can never be verified, and the write itself failing is a state-directory fault rather than a verification-side deficit",
          }
        }
      } else {
        AttemptStateInitializationFailed {
          step: "attempt-events-initialize",
          detail: events_write.error,
        }
      }
    }
  }
}

data belt_oracle_pin_capture_note: String = "The pin is captured from the FRESHLY CREATED WORKTREE, before the provider is spawned, because that is the only moment the oracle is known to be the base revision's oracle and not the attempt's. Reading it from the controller repo instead would be a different tree that nothing ties to this attempt; reading it after the agent runs is the fail-open this whole lane closes. Ordering is therefore load-bearing and it is already the ordering the staged spawn establishes: worktree-add and attempt-state-prepare run first, this capture runs inside state initialization, and tmux-session-create runs only after. A capture failure does NOT fail the spawn — the agent's work is still worth doing and a dispatch that refuses on a verification-side deficit would trade a whole attempt for a receipt — but it is never silent either: the reason is persisted to its own file, so verification reports a located cause instead of an absent pin, and the deficit stays countable at the Verify lamp rather than having its frequency zeroed."

type AttemptOraclePinCapture
  = OraclePinRecorded {
      identity: std.content_hash.ContentHash,
      revision: String,
    }
  | OraclePinNotRecorded { reason: String }

data belt_oracle_refs_primitive_note: String = "This projection used filter_map, which type-checks and DOES NOT RUN: std.primitives declares a filter_map contract but the seed registers no method for it, so the call reached the interpreter as `not yet implemented` and took the dispatch route to a 500. Found by a live dispatch on the lab, not by the whole-tree compile (0 blocking errors) and not by this lane's own witnesses — which is the specification-without-execution trap in DESIGN section 5 landing one layer below where this PR was watching for it: I checked that MY functions were exercised and never checked that the PRIMITIVES they call exist. The corpus had zero filter_map call sites before this change, which is why nothing else had already surfaced it. flat_map is the same fold with a registered implementation, and returning a one-or-zero element list is exactly the Present/none the contract described."

fn belt_oracle_refs_for_contract(
  contract: gunbc.roadmap_execution_contract.WorkItemExecutionContract,
) -> List<gunbc.roadmap_validation_oracle.ValidationOracleRef> {
  validation_oracle_scopes(contract: contract)
    |> flat_map(scope => match scope {
      OraclePinnable { oracle } => [oracle]
      OracleNotPinnable { validation_label: _, reason: _ } => []
    })
}

fn belt_oracle_observe_in_worktree(
  worktree: String,
  oracle: gunbc.roadmap_validation_oracle.ValidationOracleRef,
) -> gunbc.roadmap_validation_oracle.OracleObservation {
  let read = Filesystem.Read(
    path: join([worktree, "/", oracle.entry as String], ""),
  )
  validation_oracle_observe_from_source(
    oracle: oracle,
    source_readable: read.success,
    source: read.content,
    read_error: read.error,
  )
}

fn belt_oracle_observations_in_worktree(
  contract: gunbc.roadmap_execution_contract.WorkItemExecutionContract,
  worktree: String,
) -> List<gunbc.roadmap_validation_oracle.OracleObservation> {
  belt_oracle_refs_for_contract(contract: contract)
    |> map(oracle => belt_oracle_observe_in_worktree(
      worktree: worktree,
      oracle: oracle,
    ))
}

data worktree_head_observation_note: String = "THE REVISION READ NOW CARRIES WHY IT FAILED, AND THE STRING PROJECTION SURVIVES AS A PROJECTION. belt_worktree_head_revision collapsed all three exec arms to the empty string, and its one consumer tested `== \\\"\\\"`, which was adequate exactly because the consumer's two branches took the same action either way.\\n\\nPublication cannot use it, and the reason is the point rather than an inconvenience. Publication is adjudicated against an EXACT HEAD; if the head cannot be read there is no subject, and a consumer with no subject cannot check a receipt against one. That state has to say what happened - git missing, git refused, worktree gone - because the operator's next action differs in each case, and because a Publication lamp that reads `unknown` must be able to prove it is not reading `unpublished`.\\n\\nSO THE TYPED OBSERVATION IS THE AUTHORITY AND THE STRING IS DERIVED FROM IT. Not a second reader: one exec, one decision function, and belt_worktree_head_revision becomes a two-line projection over it. Adding a parallel typed reader beside the string one would have been the fork this corpus keeps paying for.\\n\\nEMPTY STDOUT IS UNOBSERVED, NOT OBSERVED-AS-EMPTY. git rev-parse HEAD exits zero and prints nothing in cases this belt can reach - an unborn HEAD in a freshly created worktree is the ordinary one - so a zero exit is not by itself proof that a revision was read. Casting that empty string into a CommitSha would produce a subject whose head matches no commit and compares equal to any other empty head, which is the branded-empty defect empty_branch_projection_note describes on the ref side."

type WorktreeHeadObservation
  = WorktreeHeadObserved { revision: std.types.NonEmptyStr }
  | WorktreeHeadUnobserved { reason: String }

fn worktree_head_observation_of(outcome: BeltExecOutcome) -> WorktreeHeadObservation {
  match outcome {
    ExecOk { stdout } =>
      if trim(stdout) == "" {
        WorktreeHeadUnobserved {
          reason: "git reported no revision for HEAD, which a worktree whose branch has no commit yet will do without failing",
        }
      } else {
        WorktreeHeadObserved { revision: trim(stdout) as std.types.NonEmptyStr }
      }
    ExecFailed { program, exit_code, stderr } =>
      WorktreeHeadUnobserved {
        reason: join([
          program, " could not read the worktree head (exit ", to_string(exit_code), "): ", stderr,
        ], ""),
      }
    ExecRefused { program, reason } =>
      WorktreeHeadUnobserved {
        reason: join([program, " was not available to read the worktree head: ", reason], ""),
      }
  }
}

fn belt_worktree_head_observe(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  worktree: String,
) -> WorktreeHeadObservation {
  worktree_head_observation_of(
    outcome: belt_exec(
      cmd: host_exec_argv(
        program: dispatch_capability_program(
          environment: instance.execution_environment,
          cap: GitWorkspaceCapability,
        ),
        args: shape_git_rev_parse_head_args(),
      ),
      workdir: worktree,
    ),
  )
}

fn belt_worktree_head_revision(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  worktree: String,
) -> String {
  match belt_worktree_head_observe(instance: instance, worktree: worktree) {
    WorktreeHeadObserved { revision } => revision as String
    WorktreeHeadUnobserved { reason: _ } => ""
  }
}

fn belt_verify_detached_worktree(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  node_id: gunbc.roadmap_model.RoadmapNodeId,
  attempt_key: String,
  head_sha: String,
) -> String {
  let checkout_path = dispatch_verification_checkout_path_for_instance(
    instance: instance,
    node_id: node_id,
    attempt_key: attempt_key,
    head_sha: head_sha,
  )
  match belt_worktree_head_observe(instance: instance, worktree: checkout_path) {
    WorktreeHeadObserved { revision } =>
      if (revision as String) == head_sha {
        checkout_path
      } else {
        ""
      }
    WorktreeHeadUnobserved { reason: _ } =>
      match belt_exec(
        cmd: git_worktree_add_detached_argv_for_instance(
          instance: instance,
          worktree_path: checkout_path,
          commit_sha: head_sha,
        ),
        workdir: instance.repo_root as String,
      ) {
        ExecOk { stdout: _ } => checkout_path
        ExecFailed { program: _, exit_code: _, stderr: _ } => ""
        ExecRefused { program: _, reason: _ } => ""
      }
  }
}

fn belt_verify_detached_worktree_refusal(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  node_id: gunbc.roadmap_model.RoadmapNodeId,
  attempt_key: String,
  head_sha: String,
) -> String {
  let checkout_path = dispatch_verification_checkout_path_for_instance(
    instance: instance,
    node_id: node_id,
    attempt_key: attempt_key,
    head_sha: head_sha,
  )
  match belt_worktree_head_observe(instance: instance, worktree: checkout_path) {
    WorktreeHeadObserved { revision } =>
      join([
        "a verification checkout already exists at ",
        checkout_path,
        " but its head is ",
        revision as String,
        " instead of the observed ",
        head_sha,
      ], "")
    WorktreeHeadUnobserved { reason: _ } =>
      match belt_exec(
        cmd: git_worktree_add_detached_argv_for_instance(
          instance: instance,
          worktree_path: checkout_path,
          commit_sha: head_sha,
        ),
        workdir: instance.repo_root as String,
      ) {
        ExecOk { stdout: _ } => ""
        ExecFailed { program, exit_code, stderr } =>
          join([
            program,
            " could not create a detached verification checkout at ",
            head_sha,
            " (exit ",
            to_string(exit_code),
            "): ",
            stderr,
          ], "")
        ExecRefused { program, reason } =>
          join([
            program,
            " was not available to create a detached verification checkout: ",
            reason,
          ], "")
      }
  }
}

fn belt_attempt_oracle_pin_capture_for_instance(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  node: gunbc.roadmap_model.RoadmapNode,
  attempt_key: String,
) -> AttemptOraclePinCapture {
  let worktree = dispatch_worktree_path_for_instance(
    instance: instance,
    node_id: node.node,
    attempt_key: attempt_key,
  )
  let refs = belt_oracle_refs_for_contract(contract: node.execution)
  if count(refs) == 0 {
    OraclePinNotRecorded {
      reason: "this node's execution contract declares no validation whose oracle can be pinned",
    }
  } else {
    match validation_oracle_set_observe(
      observations: belt_oracle_observations_in_worktree(
        contract: node.execution,
        worktree: worktree,
      ),
    ) {
      OracleSetIncomplete { blocking: _, observations: _ } =>
        OraclePinNotRecorded {
          reason: join([
            "the declared validation oracle was not observable in the attempt worktree at ",
            worktree,
            " when the attempt was created",
          ], ""),
        }
      OracleSetObserved { identity, observations: _ } => {
        let revision = belt_worktree_head_revision(
          instance: instance,
          worktree: worktree,
        )
        if revision == "" {
          OraclePinNotRecorded {
            reason: "the attempt worktree's head revision could not be read, so the pinned oracle could not be attributed to a revision",
          }
        } else {
          OraclePinRecorded {
            identity: identity,
            revision: revision,
          }
        }
      }
    }
  }
}

fn belt_persist_oracle_pin_for_instance(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  node: gunbc.roadmap_model.RoadmapNode,
  attempt_key: String,
  capture: AttemptOraclePinCapture,
) -> Bool {
  match capture {
    OraclePinNotRecorded { reason } =>
      Filesystem.Write(
        path: dispatch_attempt_oracle_pin_refusal_path_for_instance(
          instance: instance,
          node_id: node.node,
          attempt_key: attempt_key,
        ),
        content: reason,
      ).success
    OraclePinRecorded { identity, revision } => {
      let identity_write = Filesystem.Write(
        path: dispatch_attempt_oracle_identity_path_for_instance(
          instance: instance,
          node_id: node.node,
          attempt_key: attempt_key,
        ),
        content: serialize_content_hash(hash: identity) as String,
      )
      let revision_write = Filesystem.Write(
        path: dispatch_attempt_oracle_revision_path_for_instance(
          instance: instance,
          node_id: node.node,
          attempt_key: attempt_key,
        ),
        content: revision,
      )
      identity_write.success && revision_write.success
    }
  }
}

fn belt_created_session_cleanup_detail(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  session_name: String,
) -> String {
  match belt_exec(
    cmd: tmux_kill_session_argv_for_instance(
      instance: instance,
      session_name: session_name,
    ),
    workdir: belt_observe_workdir as String,
  ) {
    ExecOk { stdout: _ } => "created session reaped"
    ExecFailed { program: _, exit_code, stderr } =>
      join([
        "created-session cleanup failed with exit ",
        to_string(exit_code),
        ": ",
        stderr,
      ], "")
    ExecRefused { program: _, reason } =>
      join(["created-session cleanup refused: ", reason], "")
  }
}

fn belt_persist_spawn_failure_for_instance(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  node: gunbc.roadmap_model.RoadmapNode,
  attempt_key: String,
  step: String,
  detail: String,
) -> String {
  let evidence = join([step, ": ", detail], "")
  let write = Filesystem.Write(
    path: dispatch_attempt_spawn_failure_path_for_instance(
      instance: instance,
      node_id: node.node,
      attempt_key: attempt_key,
    ),
    content: evidence,
  )
  if write.success {
    detail
  } else {
    join([
      detail,
      "; additionally failed to persist spawn evidence: ",
      write.error,
    ], "")
  }
}

type BeltSpawnOutcome
  = Spawned { node_id: String, session_name: String, provider: String }
  | SpawnFailed { node_id: String, step: String, detail: String, provider: String }

fn belt_dispatch_spawn_unselected_provider_wire_label() -> String {
  "unselected"
}

fn belt_dispatch_spawn_selection_refused_provider_wire_label(reason: std.types.NonEmptyStr) -> String {
  concat("selection-refused: ", reason as String)
}

fn belt_dispatch_spawn_provider_wire_label(provider: gunbc.roadmap_dispatch_actuator.DispatchCliProvider) -> String {
  dispatch_provider_label(provider: provider)
}

data belt_claude_preflight_note: String = "Spawn preflights the CLAUDE dependency before any actuation, because both of its failure classes pass the exec seam SILENTLY (§5, found live 2026-07-23): tmux new-session exits 0 even when the inner claude is missing (the pane dies instantly behind a fabricated Spawned), and an unseeded workspace-trust root blocks claude INTERACTIVELY on its per-path trust dialog (a hung session, not an error — --dangerously-skip-permissions does not cover it). Both are decidable BEFORE spawning, so they refuse as typed SpawnFailed rows: claude-on-PATH via the same shell.Which authority belt_exec uses (step claude-cli), then the trust seed for the ONE dispatch worktree root read from the claude trust store and classified by extdeps.llm.cli.claude_workspace_trust_seeded — the modeled home of what was hand-provisioned on srv1 at go-live (ancestor-inheritance makes the single root sufficient; steps claude-trust-home / claude-trust-store / claude-trust-seed, each detail naming the exact convergence). The DECISION is the pure witnessed fn (belt_claude_preflight_decision, every arm exercised on synthetic facts — same shape as belt_observe_from_result); belt_claude_preflight only threads live observations into it. Residue: refuse-with-instructions, not auto-seed — the trust store is claude's own mutable file (claude rewrites it at runtime), so a read-modify-write APPLY arm races the upstream writer; seeding stays with the live_deploy membership convergence (the go-live receipt's named dissolution)."

type BeltClaudePreflight
  = ClaudePreflightOk
  | ClaudePreflightRefused { step: String, detail: String }

fn belt_claude_preflight_decision(
  claude_on_path: Bool,
  home: String,
  trust_store_path: String,
  trust_store_readable: Bool,
  trust_store_text: String,
  trust_root: String,
) -> BeltClaudePreflight {
  if !claude_on_path {
    ClaudePreflightRefused {
      step: "claude-cli",
      detail: "claude not found on PATH (which exit nonzero); tmux would spawn a pane that dies instantly — fail-closed, no fabricated Spawned",
    }
  } else if home == "" {
    ClaudePreflightRefused {
      step: "claude-trust-home",
      detail: "HOME unset or empty — cannot locate the claude trust store (~/.claude.json), so the workspace-trust seed is unknowable; fail-closed",
    }
  } else if !trust_store_readable {
    ClaudePreflightRefused {
      step: "claude-trust-store",
      detail: concat(
        concat("claude trust store unreadable at ", trust_store_path),
        " — claude blocks on its workspace-trust dialog for an unseeded root; seed it by launching claude once under the dispatch worktree root, or converge via the live_deploy membership",
      ),
    }
  } else if !claude_workspace_trust_seeded(config_text: trust_store_text, project_path: trust_root) {
    ClaudePreflightRefused {
      step: "claude-trust-seed",
      detail: concat(
        concat(concat("workspace trust not seeded for ", trust_root), " in "),
        concat(trust_store_path, " (projects entry with hasTrustDialogAccepted: true) — claude would block interactively on its trust dialog; ancestor-dir trust inheritance means seeding this ONE root covers every dispatch worktree"),
      ),
    }
  } else {
    ClaudePreflightOk
  }
}

fn belt_claude_preflight_for_instance(instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance) -> BeltClaudePreflight {
  let claude_ok = belt_program_available(program: claude_cli_program)
  let home = match shell.Env.Get(name: "HOME" as std.types.NonEmptyStr).value {
    Absent => ""
    Present { value: v } => v
  }
  if !claude_ok || home == "" {
    belt_claude_preflight_decision(
      claude_on_path: claude_ok,
      home: home,
      trust_store_path: "",
      trust_store_readable: false,
      trust_store_text: "",
      trust_root: dashboard_instance_dispatch_worktree_root(instance: instance) as String,
    )
  } else {
    let path = claude_trust_store_path(home: home)
    let r = Filesystem.Read(path: path)
    belt_claude_preflight_decision(
      claude_on_path: claude_ok,
      home: home,
      trust_store_path: path,
      trust_store_readable: r.success,
      trust_store_text: r.content,
      trust_root: dashboard_instance_dispatch_worktree_root(instance: instance) as String,
    )
  }
}

fn belt_claude_preflight() -> BeltClaudePreflight {
  belt_claude_preflight_for_instance(instance: srv1_live_dashboard_instance())
}

type BeltCodexPreflight
  = CodexPreflightOk { auth_method: String }
  | CodexPreflightRefused { step: String, detail: String }

data belt_codex_preflight_note: String = "Codex preflight owns only facts decidable before actuation. Exact env and codex executable paths are admitted first. It then executes `env CODEX_HOME=<dedicated-root> codex --version` and requires the provider identity marker before separately executing `codex login status`; this distinguishes a broken npm launcher/runtime dependency from unauthenticated OAuth. Login exit 0 is the CLI's active-auth verdict and stdout is retained as the method receipt; it never parses auth.json or treats file presence as authentication. Subscription exhaustion and upstream/rate failures occur only after codex exec starts; those belong to provider JSONL (`turn.failed` / `error`) plus retained process exit."

fn belt_codex_preflight_decision_observed_for_home(
  codex_home: String,
  codex_on_path: Bool,
  env_on_path: Bool,
  identity_command_success: Bool,
  identity_stdout: String,
  identity_stderr: String,
  login_status_success: Bool,
  login_status_stdout: String,
  login_status_stderr: String,
) -> BeltCodexPreflight {
  let identity_realized = identity_command_success
    && codex_runtime_version_identity_satisfied(
      combined_output: join([identity_stdout, "\n", identity_stderr], ""),
    )
  if !codex_on_path {
    CodexPreflightRefused {
      step: "codex-cli",
      detail: "codex not found on PATH; refusing before worktree creation",
    }
  } else if !env_on_path {
    CodexPreflightRefused {
      step: "codex-env",
      detail: "env not found on PATH; cannot bind the dedicated CODEX_HOME for auth or execution",
    }
  } else if !identity_realized {
    CodexPreflightRefused {
      step: "codex-identity",
      detail: join([
        "codex --version did not realize ",
        codex_runtime_version_identity_marker(),
        "; stdout: ",
        identity_stdout,
        "; stderr: ",
        identity_stderr,
      ], ""),
    }
  } else if !login_status_success {
    CodexPreflightRefused {
      step: "codex-auth",
      detail: join([
        "codex login status exited nonzero for ",
        codex_home,
        "; stdout: ",
        login_status_stdout,
        "; stderr: ",
        login_status_stderr,
      ], ""),
    }
  } else {
    CodexPreflightOk { auth_method: login_status_stdout }
  }
}

fn belt_codex_preflight_for_instance(instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance) -> BeltCodexPreflight {
  match dashboard_instance_provider_executable(instance: instance) {
    Absent =>
      CodexPreflightRefused {
        step: "codex-executable-placement",
        detail: dashboard_instance_provider_executable_refusal_detail(instance: instance),
      }
    Present { value: codex_program } => {
      let codex_home = dashboard_instance_provider_state_root(instance: instance) as String
      let codex_program_str = codex_program as String
      let env_program = dispatch_capability_program(
        environment: instance.execution_environment,
        cap: EnvironmentBindingCapability,
      )
      let codex_ok = belt_program_available(program: codex_program_str)
      let env_ok = belt_program_available(program: env_program)
      if !codex_ok || !env_ok {
        belt_codex_preflight_decision_observed_for_home(
          codex_home: codex_home,
          codex_on_path: codex_ok,
          env_on_path: env_ok,
          identity_command_success: false,
          identity_stdout: "",
          identity_stderr: "",
          login_status_success: false,
          login_status_stdout: "",
          login_status_stderr: "",
        )
      } else {
        let identity = gunbc.WitnessBin.Run(
          workdir: belt_observe_workdir,
          bin_path: env_program as std.types.FilePath,
          args: shape_codex_version_env_args_for_program(
            program: codex_program_str,
            codex_home: codex_home,
          ),
          expect: OutcomeIsData,
        )
        let identity_realized = identity.success
          && codex_runtime_version_identity_satisfied(
            combined_output: join([identity.stdout, "\n", identity.stderr], ""),
          )
        if !identity_realized {
          belt_codex_preflight_decision_observed_for_home(
            codex_home: codex_home,
            codex_on_path: codex_ok,
            env_on_path: env_ok,
            identity_command_success: identity.success,
            identity_stdout: identity.stdout,
            identity_stderr: identity.stderr,
            login_status_success: false,
            login_status_stdout: "",
            login_status_stderr: "",
          )
        } else {
          let result = gunbc.WitnessBin.Run(
            workdir: belt_observe_workdir,
            bin_path: env_program as std.types.FilePath,
            args: shape_codex_login_status_env_args_for_program(
              program: codex_program_str,
              codex_home: codex_home,
            ),
            expect: OutcomeIsData,
          )
          belt_codex_preflight_decision_observed_for_home(
            codex_home: codex_home,
            codex_on_path: codex_ok,
            env_on_path: env_ok,
            identity_command_success: identity.success,
            identity_stdout: identity.stdout,
            identity_stderr: identity.stderr,
            login_status_success: result.success,
            login_status_stdout: result.stdout,
            login_status_stderr: result.stderr,
          )
        }
      }
    }
  }
}

fn belt_codex_preflight() -> BeltCodexPreflight {
  belt_codex_preflight_for_instance(instance: srv1_live_dashboard_instance())
}

type BeltProviderPreflight
  = ProviderPreflightOk
  | ProviderPreflightRefused { step: String, detail: String }

fn belt_provider_preflight_for_instance(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  provider: gunbc.roadmap_dispatch_actuator.DispatchCliProvider,
) -> BeltProviderPreflight {
  match provider {
    ClaudeCodeProvider =>
      match belt_claude_preflight_for_instance(instance: instance) {
        ClaudePreflightOk => ProviderPreflightOk
        ClaudePreflightRefused { step: st, detail: d } =>
          ProviderPreflightRefused { step: st, detail: d }
      }
    CodexDispatchProvider =>
      match belt_codex_preflight_for_instance(instance: instance) {
        CodexPreflightOk { auth_method: _ } => ProviderPreflightOk
        CodexPreflightRefused { step: st, detail: d } =>
          ProviderPreflightRefused { step: st, detail: d }
      }
    CursorDispatchProvider =>
      ProviderPreflightRefused {
        step: "cursor-provider-preflight",
        detail: "cursor dispatch is not yet wired on this actuator path",
      }
  }
}

fn belt_provider_preflight(provider: gunbc.roadmap_dispatch_actuator.DispatchCliProvider) -> BeltProviderPreflight {
  belt_provider_preflight_for_instance(
    instance: srv1_live_dashboard_instance(),
    provider: provider,
  )
}

data belt_footprint_admission_note: String = "Step 0b: the runtime admits against its own deployment footprint BEFORE it mutates anything, because the 2026-07-30 incident proved the belt learns about a missing root in the worst possible order. Staging ran `git worktree add` (389ms, succeeded) and then `install -d` into an attempt-state root that did not exist under a root-owned parent (3ms, EACCES) — so the fail-closed short-circuit worked exactly as designed and still left an orphan branch and worktree behind on every click, because the first durable mutation had already happened by the time the deficit was discovered. Step 0a made the root a converged deployment member so it EXISTS; this gate makes its absence or unwritability REFUSE FIRST, which is the difference between a class that cannot recur and a class that recurs once per host between deploys.\\n\\nTHE ROOTS COME FROM THE INSTANCE, NOT FROM live_deploy's srv1 roster. That is deliberate and not a second footprint: the instance is the runtime's own view of the paths it writes, so a lab/preview instance under a disjoint root admits against ITS roots rather than production's, while gunbc.live_deploy.spec stays the provisioner's view of srv1. Step 1 unifies the two into one member list with permissions; until then the belt reads the value it was handed rather than importing a host-specific roster it has no business knowing.\\n\\nWRITABILITY IS PROBED AS WRITE **AND** SEARCH, because POSIX requires both to create an entry in a directory: `test -w` alone would pass on a mode-0644 directory and the very next `install -d` would still fail, which is the fabricated-precondition shape this gate exists to remove. Search permission reuses shell.Test.IsExecutable — `test -x` on a directory IS the search bit, so this is the cited operation read in its directory sense, never a minted directory-specific probe. The frame is the EFFECTIVE principal: these probes run in the serve process, so they answer for the account that will actually perform the mutation, which is the only question worth asking (a provisioner-side SSH probe would answer for the deploy principal and admit a root the runtime cannot write).\\n\\nKnown conflation, named rather than modeled away: a probe that could not execute at all reads as present=false, the same as a genuinely absent root. Both arms REFUSE, so nothing is fabricated in either direction and the remedy is a converge in both; only the detail line would misattribute, and `test` is a coreutils/shell builtin whose absence would have already broken belt_exec's which-check. Splitting it would add a third state whose two branches take the same action.\\n\\nOutcomeIsData ADMISSIBILITY (discharging the review obligation gunbc.output_policy outcome_is_data_note leaves open): all three probes are annotated because a non-zero `test` exit here is an ANSWER — root absent / not writable / not searchable — and it is ambient in both contexts, since production responds by refusing the spawn and the witnesses respond by asserting the refusal arm. The guard is satisfied structurally, not by assertion: belt_footprint_observe returns BeltFootprintObservation and belt_footprint_admission_for_instance returns BeltFootprintAdmission, so each exit provably feeds a typed consumer and neither returns unit. Dispatch failure of the probe ITSELF remains anomalous and is not silenced by the annotation."

type BeltFootprintRoot {
  member: String
  path: String
}

fn belt_dispatch_footprint_roots(instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance) -> List<BeltFootprintRoot> {
  [
    BeltFootprintRoot {
      member: "dispatch-worktree-root",
      path: dashboard_instance_dispatch_worktree_root(instance: instance) as String,
    },
    BeltFootprintRoot {
      member: "attempt-state-root",
      path: dashboard_instance_dispatch_attempt_state_root(instance: instance) as String,
    },
  ]
}

type BeltFootprintObservation {
  member: String
  path: String
  present: Bool
  writable: Bool
  searchable: Bool
}

type BeltFootprintAdmission
  = FootprintAdmitted
  | FootprintRefused { step: String, detail: String }

fn belt_footprint_root_verdict(obs: BeltFootprintObservation) -> BeltFootprintAdmission {
  if !obs.present {
    FootprintRefused {
      step: "footprint-root-absent",
      detail: join([
        "deployment member ", obs.member, " is not a directory at ", obs.path,
        " — the belt writes there on every dispatch, so staging would mutate the worktree and then fail; converge the member (gunbc.live_deploy.spec deployment_owned_steps) rather than creating it by hand",
      ], ""),
    }
  } else if !obs.writable {
    FootprintRefused {
      step: "footprint-root-unwritable",
      detail: join([
        "deployment member ", obs.member, " at ", obs.path,
        " is not writable by the effective runtime principal — the deploy converges it owned by the service user; a root owned by anyone else means the instance was hand-provisioned or the member's ownership drifted",
      ], ""),
    }
  } else if !obs.searchable {
    FootprintRefused {
      step: "footprint-root-unsearchable",
      detail: join([
        "deployment member ", obs.member, " at ", obs.path,
        " is writable but not searchable by the effective runtime principal — POSIX requires write AND search to create an entry, so staging would still fail on a directory this gate would otherwise admit",
      ], ""),
    }
  } else {
    FootprintAdmitted
  }
}

fn belt_footprint_admission_decision(
  observations: List<BeltFootprintObservation>,
) -> BeltFootprintAdmission {
  fold(observations, init: FootprintAdmitted, f: (acc, obs) =>
    match acc {
      FootprintRefused { step: st, detail: d } =>
        FootprintRefused { step: st, detail: d }
      FootprintAdmitted => belt_footprint_root_verdict(obs: obs)
    }
  )
}

fn belt_footprint_observe(root: BeltFootprintRoot) -> BeltFootprintObservation {
  BeltFootprintObservation {
    member: root.member,
    path: root.path,
    present: shell.Test.IsDirectory(
      path: root.path as std.types.FilePath,
      expect: OutcomeIsData,
    ).is_directory,
    writable: shell.Test.IsWritable(
      path: root.path as std.types.FilePath,
      expect: OutcomeIsData,
    ).writable,
    searchable: shell.Test.IsExecutable(
      path: root.path as std.types.FilePath,
      expect: OutcomeIsData,
    ).executable,
  }
}

fn belt_footprint_admission_for_instance(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
) -> BeltFootprintAdmission {
  belt_footprint_admission_decision(
    observations: map(
      belt_dispatch_footprint_roots(instance: instance),
      r => belt_footprint_observe(root: r),
    ),
  )
}

fn belt_actuate_spawn_for_instance(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  node: gunbc.roadmap_model.RoadmapNode,
  probed_at: String,
) -> BeltSpawnOutcome {
  match belt_footprint_admission_for_instance(instance: instance) {
    FootprintRefused { step: fst, detail: fd } =>
      SpawnFailed {
        node_id: node.node as String,
        step: fst,
        detail: fd,
        provider: belt_dispatch_spawn_unselected_provider_wire_label(),
      }
    FootprintAdmitted =>
  match dispatch_environment_admit(
    contract: node.execution,
    environment: instance.execution_environment,
  ) {
    EnvironmentRefused { receipts, validation_summary, reason } =>
      SpawnFailed {
        node_id: node.node as String,
        step: "environment-admission",
        detail: dispatch_environment_admission_json(
          admission: EnvironmentRefused {
            receipts: receipts,
            validation_summary: validation_summary,
            reason: reason,
          },
        ),
        provider: belt_dispatch_spawn_unselected_provider_wire_label(),
      }
    EnvironmentAdmitted { receipts, validation_summary } =>
      match dispatch_actuator_selection(node_sizing: node.sizing) {
        DispatchActuatorSelectionRefused { reason } =>
          SpawnFailed {
            node_id: node.node as String,
            step: "dispatch-selection",
            detail: reason as String,
            provider: belt_dispatch_spawn_selection_refused_provider_wire_label(reason: reason),
          }
        DispatchActuatorSelectionOk { provider, effort: _, process_fingerprint: _ } =>
          match belt_provider_preflight_for_instance(
            instance: instance,
            provider: provider,
          ) {
            ProviderPreflightRefused { step: st, detail: d } =>
              SpawnFailed {
                node_id: node.node as String,
                step: st,
                detail: d,
                provider: belt_dispatch_spawn_provider_wire_label(provider: provider),
              }
            ProviderPreflightOk =>
              belt_actuate_spawn_exec_for_instance(
                instance: instance,
                node: node,
                probed_at: probed_at,
                admission_receipt: dispatch_environment_admission_json(
                  admission: EnvironmentAdmitted {
                    receipts: receipts,
                    validation_summary: validation_summary,
                  },
                ),
                provider_wire_label: belt_dispatch_spawn_provider_wire_label(provider: provider),
              )
          }
      }
  }
  }
}

fn belt_actuate_spawn_exec_for_instance(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  node: gunbc.roadmap_model.RoadmapNode,
  probed_at: String,
  admission_receipt: String,
  provider_wire_label: String,
) -> BeltSpawnOutcome {
  belt_actuate_spawn_exec_modeled(
    instance: instance,
    node: node,
    probed_at: probed_at,
    workdir: instance.repo_root as String,
    admission_receipt: admission_receipt,
    provider_wire_label: provider_wire_label,
  )
}

data belt_staged_spawn_cleanup_note: String = "The tmux creation boundary is explicit. Worktree/state publication happens before tmux; tmux new-session runs alone; only after its success do session configuration, pipe attachment, and provider respawn run. A later staging failure reaps exactly the session this same request just created, without relying on a name-only ownership guess. Worktree, branch, and attempt evidence are deliberately retained for diagnosis and user work. The original located failure plus cleanup receipt is persisted under the published attempt before SpawnFailed returns."

fn belt_actuate_spawn_exec_modeled(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  node: gunbc.roadmap_model.RoadmapNode,
  probed_at: String,
  workdir: String,
  admission_receipt: String,
  provider_wire_label: String,
) -> BeltSpawnOutcome {
  let attempt_key = dispatch_attempt_key(
    node_id: node.node,
    probed_at: probed_at,
  )
  let session_name = dispatch_tmux_session_name(node_id: node.node)
  match dispatch_spawn_commands_for_instance(
    instance: instance,
    node: node,
    session_uuid: belt_spawn_session_uuid(node_id: node.node as String, probed_at: probed_at),
    attempt_key: attempt_key,
    request: default_provider_selection_request(),
  ) {
    DispatchSpawnRefused { step, detail } =>
      SpawnFailed {
        node_id: node.node as String,
        step: step as String,
        detail: detail,
        provider: provider_wire_label,
      }
    DispatchSpawnReady { commands: cmds } =>
  match belt_exec_steps(
    steps: [
      BeltExecStep { step: "worktree-add", command: cmds.worktree_add },
      BeltExecStep {
        step: "attempt-state-prepare",
        command: cmds.attempt_state_prepare,
      },
    ],
    workdir: workdir,
  ) {
    ExecStepFailed { step, detail } =>
      SpawnFailed {
        node_id: node.node as String,
        step: step,
        detail: detail,
        provider: provider_wire_label,
      }
    ExecStepsOk =>
      match belt_attempt_state_initialize_for_instance(
        instance: instance,
        node: node,
        attempt_key: attempt_key,
        admission_receipt: admission_receipt,
      ) {
        AttemptStateInitializationFailed { step, detail } =>
          SpawnFailed {
            node_id: node.node as String,
            step: step,
            detail: detail,
            provider: provider_wire_label,
          }
        AttemptStateInitialized =>
          match belt_exec_steps(
            steps: [
              BeltExecStep {
                step: "attempt-current-publish",
                command: cmds.attempt_current_pointer,
              },
            ],
            workdir: workdir,
          ) {
            ExecStepFailed { step, detail } =>
              SpawnFailed {
                node_id: node.node as String,
                step: step,
                detail: detail,
                provider: provider_wire_label,
              }
            ExecStepsOk =>
              match belt_exec_steps(
                steps: [
                  BeltExecStep {
                    step: "tmux-session-create",
                    command: cmds.tmux_spawn,
                  },
                ],
                workdir: workdir,
              ) {
                ExecStepFailed { step, detail } =>
                  SpawnFailed {
                    node_id: node.node as String,
                    step: step,
                    detail: belt_persist_spawn_failure_for_instance(
                      instance: instance,
                      node: node,
                      attempt_key: attempt_key,
                      step: step,
                      detail: detail,
                    ),
                    provider: provider_wire_label,
                  }
                ExecStepsOk =>
                  match belt_exec_steps(
                    steps: [
                      BeltExecStep {
                        step: "tmux-default-shell",
                        command: cmds.tmux_default_shell,
                      },
                      BeltExecStep {
                        step: "tmux-remain-on-exit",
                        command: cmds.tmux_remain_on_exit,
                      },
                      BeltExecStep {
                        step: "tmux-event-pipe",
                        command: cmds.tmux_event_pipe,
                      },
                      BeltExecStep {
                        step: "provider-start",
                        command: cmds.provider_start,
                      },
                    ],
                    workdir: workdir,
                  ) {
                    ExecStepsOk =>
                      Spawned {
                        node_id: node.node as String,
                        session_name: session_name,
                        provider: provider_wire_label,
                      }
                    ExecStepFailed { step, detail } => {
                      let cleanup = belt_created_session_cleanup_detail(
                        instance: instance,
                        session_name: session_name,
                      )
                      let full_detail = join([
                        detail,
                        "; ",
                        cleanup,
                      ], "")
                      SpawnFailed {
                        node_id: node.node as String,
                        step: step,
                        detail: belt_persist_spawn_failure_for_instance(
                          instance: instance,
                          node: node,
                          attempt_key: attempt_key,
                          step: step,
                          detail: full_detail,
                        ),
                        provider: provider_wire_label,
                      }
                    }
                  }
              }
          }
      }
  }
}
}

fn belt_actuate_spawn(node: gunbc.roadmap_model.RoadmapNode, probed_at: String, workdir: String) -> BeltSpawnOutcome {
  let instance = srv1_live_dashboard_instance()
  match dispatch_environment_admit(
    contract: node.execution,
    environment: instance.execution_environment,
  ) {
    EnvironmentRefused { receipts, validation_summary, reason } =>
      SpawnFailed {
        node_id: node.node as String,
        step: "environment-admission",
        detail: dispatch_environment_admission_json(
          admission: EnvironmentRefused {
            receipts: receipts,
            validation_summary: validation_summary,
            reason: reason,
          },
        ),
        provider: belt_dispatch_spawn_unselected_provider_wire_label(),
      }
    EnvironmentAdmitted { receipts, validation_summary } =>
      match dispatch_actuator_selection(node_sizing: node.sizing) {
        DispatchActuatorSelectionRefused { reason } =>
          SpawnFailed {
            node_id: node.node as String,
            step: "dispatch-selection",
            detail: reason as String,
            provider: belt_dispatch_spawn_selection_refused_provider_wire_label(reason: reason),
          }
        DispatchActuatorSelectionOk { provider, effort: _, process_fingerprint: _ } =>
          match belt_provider_preflight(provider: provider) {
            ProviderPreflightRefused { step: st, detail: d } =>
              SpawnFailed {
                node_id: node.node as String,
                step: st,
                detail: d,
                provider: belt_dispatch_spawn_provider_wire_label(provider: provider),
              }
            ProviderPreflightOk =>
              belt_actuate_spawn_exec(
                node: node,
                probed_at: probed_at,
                workdir: workdir,
                admission_receipt: dispatch_environment_admission_json(
                  admission: EnvironmentAdmitted {
                    receipts: receipts,
                    validation_summary: validation_summary,
                  },
                ),
                provider_wire_label: belt_dispatch_spawn_provider_wire_label(provider: provider),
              )
          }
      }
  }
}

fn belt_actuate_spawn_exec(
  node: gunbc.roadmap_model.RoadmapNode,
  probed_at: String,
  workdir: String,
  admission_receipt: String,
  provider_wire_label: String,
) -> BeltSpawnOutcome {
  belt_actuate_spawn_exec_modeled(
    instance: srv1_live_dashboard_instance(),
    node: node,
    probed_at: probed_at,
    workdir: workdir,
    admission_receipt: admission_receipt,
    provider_wire_label: provider_wire_label,
  )
}

type BeltTeardownOutcome
  = ReapedSession { session_name: String }
  | TeardownFailed { session_name: String, detail: String }

fn belt_actuate_teardown_for_instance(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  session_name: String,
) -> BeltTeardownOutcome {
  match belt_exec(
    cmd: tmux_kill_session_argv_for_instance(
      instance: instance,
      session_name: session_name,
    ),
    workdir: belt_observe_workdir as String,
  ) {
    ExecOk { stdout: _ } => ReapedSession { session_name: session_name }
    ExecFailed { program: _, exit_code: _, stderr: e } =>
      TeardownFailed { session_name: session_name, detail: e }
    ExecRefused { program: _, reason: r } =>
      TeardownFailed { session_name: session_name, detail: r }
  }
}

fn belt_actuate_teardown(session_name: String) -> BeltTeardownOutcome {
  belt_actuate_teardown_for_instance(
    instance: srv1_live_dashboard_instance(),
    session_name: session_name,
  )
}

data belt_actuate_member_shape_note: String = "The reconcile guarantees spawns are DesiredMembers (carry the RoadmapNode for the brief) and teardowns are ObservedMembers (carry the live session). The cross arms are unreachable by construction; if ever reached they REFUSE (typed SpawnFailed/TeardownFailed), never a fabricated action — DESIGN §5 (no spawn without a node model, no teardown without an observed session)."

data belt_session_uuid_salt: std.types.NonEmptyStr = "belt-session-uuid-v1" as std.types.NonEmptyStr

data belt_spawn_session_uuid_note: String = "The UUID is the Claude provider's --session-id input; Claude requires a syntactically valid UUID. It remains computed for every provider so dispatch_spawn_commands has one stable arity, but CodexCliProvider deliberately ignores it and lets Codex mint its persisted thread id. For Claude the UUID is ATTEMPT-scoped (U1 redispatch fix 2026-07-25): derived from (node_id x the spawn's clock observation), reshaped to RFC-4122 v4. The earlier node-deterministic derivation made every node one-shot at the Claude layer. Reconcile idempotency never keys on this id — the node-grain tmux session name is the observation key."

fn belt_uuid_stamped_id(node_id: String, probed_at: String) -> std.types.NonEmptyStr {
  join([node_id, "\n", probed_at], "") as std.types.NonEmptyStr
}

fn belt_uuid_hex32(node_id: String, probed_at: String) -> String {
  concat(
    content_hash_atom(value: belt_uuid_stamped_id(node_id: node_id, probed_at: probed_at)).digest as String,
    content_hash_combine_structural(
      left: content_hash_atom(value: belt_uuid_stamped_id(node_id: node_id, probed_at: probed_at)),
      right: content_hash_atom(value: belt_session_uuid_salt),
    ).digest as String,
  )
}

fn belt_uuid_rfc4122(hex: String) -> String {
  concat(substring(s: hex, start: 0, end: 12),
  concat("4",
  concat(substring(s: hex, start: 13, end: 16),
  concat("8",
  substring(s: hex, start: 17, end: 32)))))
}

fn belt_uuid_dash(v: String) -> String {
  concat(substring(s: v, start: 0, end: 8),
  concat("-",
  concat(substring(s: v, start: 8, end: 12),
  concat("-",
  concat(substring(s: v, start: 12, end: 16),
  concat("-",
  concat(substring(s: v, start: 16, end: 20),
  concat("-",
  substring(s: v, start: 20, end: 32)))))))))
}

fn belt_spawn_session_uuid(node_id: String, probed_at: String) -> String {
  belt_uuid_dash(v: belt_uuid_rfc4122(hex: belt_uuid_hex32(node_id: node_id, probed_at: probed_at)))
}

fn belt_actuate_spawn_member(m: gunbc.roadmap_belt.DispatchMember, workdir: String) -> BeltSpawnOutcome {
  match m {
    DesiredMember { node_id: nid, node: node } =>
      match clock_now_probed_at() {
        Present { value: probed_at } =>
          belt_actuate_spawn(node: node, probed_at: probed_at as String, workdir: workdir)
        Absent =>
          SpawnFailed {
            node_id: nid,
            step: "attempt-clock",
            detail: "clock observation refused; an attempt without a stamp would collide with a later one — fail-closed, no unknown-stamped attempts",
            provider: belt_dispatch_spawn_unselected_provider_wire_label(),
          }
      }
    ObservedMember { node_id: nid, session: _ } =>
      SpawnFailed {
        node_id: nid,
        step: "member-shape",
        detail: "belt spawn expected DesiredMember (carries node for brief); got ObservedMember — fail-closed, no spawn without a node model",
        provider: belt_dispatch_spawn_unselected_provider_wire_label(),
      }
  }
}

fn belt_actuate_teardown_member(m: gunbc.roadmap_belt.DispatchMember) -> BeltTeardownOutcome {
  match m {
    ObservedMember { node_id: _, session: session } =>
      belt_actuate_teardown(session_name: session.session_name)
    DesiredMember { node_id: nid, node: _ } =>
      TeardownFailed {
        session_name: nid,
        detail: "belt teardown expected ObservedMember (carries live session); got DesiredMember — fail-closed, no teardown without an observed session",
      }
  }
}

type BeltObserve
  = Observed { live: List<gunbc.roadmap_dispatch_actuator.DispatchLiveSession> }
  | ObserveRefused { reason: String }

data belt_observe_note: String = "tmux-present is the FIRST precondition: tmux not on PATH -> ObserveRefused (the belt cannot know what is live). Once tmux is present the observe half must NOT widen an exec failure into a zero-session answer (the §5 absorbing-fallback / ⊤-as-answer-vs-⊤-as-ignorance conflation). extdeps.tmux classify_tmux_session_list is the sole authority for tmux ls outcome facts (listed sessions, documented no-server signals, stdout parse refusal, unknowable stderr); this module maps those outcomes to belt policy only: TmuxSessionsListed -> filter dispatch sessions into Observed live rows; TmuxNoServer -> Observed []; TmuxListStdoutRefused and TmuxListUnknowable -> ObserveRefused with located evidence, never a blind spawn/reap. First-tick bootstrap works under either no-server spelling admitted by the classifier. The decision is a pure fn so every arm is witnessed (belt_observe_from_result witnesses); belt_observe only threads the live WitnessBin.Run result fields into it."

fn belt_ls_stdout_refusal_reason(
  line_number: Int,
  raw: String,
  reason: String,
) -> String {
  join([
    "belt_observe: tmux ls stdout parse refused at line ",
    to_string(line_number),
    ": ",
    reason,
    "; raw=",
    raw,
    " — the live session set is unknowable; fail-closed, no blind spawn/reap",
  ], "")
}

fn belt_observe_from_result(
  success: Bool,
  stdout: String,
  stderr: String,
) -> BeltObserve {
  match classify_tmux_session_list(exit_ok: success, stdout: stdout, stderr: stderr) {
    TmuxSessionsListed { entries } =>
      Observed {
        live: dispatch_live_sessions_from_entries(entries: entries),
      }
    TmuxNoServer { evidence: _ } =>
      Observed { live: [] }
    TmuxListStdoutRefused { line_number, raw, reason } =>
      ObserveRefused {
        reason: belt_ls_stdout_refusal_reason(
          line_number: line_number,
          raw: raw,
          reason: reason,
        ),
      }
    TmuxListUnknowable { stderr: e } =>
      ObserveRefused {
        reason: concat(
          "belt_observe: tmux ls exited nonzero with no documented no-server/no-sessions signal — the live session set is unknowable; fail-closed, no blind spawn/reap. stderr: ",
          e,
        ),
      }
  }
}

data belt_observe_entry_dissolution_note: String = "belt_observe and belt_observe_for_instance ARE DELETED. They observed the tmux session NAME set only, so a retained dead pane read as a live agent — the defect this arc removed. Both dispatch and tick now call belt_sessions_observe_for_instance, which classifies each row's process evidence.\n\nbelt_observe_from_result SURVIVES DELIBERATELY and is now reached only by witnesses. Its subject is the tmux stdout parse (nonzero exit with no documented no-server marker, unparseable line, empty set), and deleting it would delete that evidence along with the caller — the §4b rule is that a climb dissolves the lower-rung production handling, never the discriminating evidence that the higher rung stays real. Its parse duty is subsumed by classify_tmux_session_list, which the live observer uses; the dissolve-on is those parse witnesses being re-pointed at classify_tmux_session_list with the refusal cases preserved one-for-one, at which point this function and this note go together."

type BeltPassOutcome
  = BeltPassRecorded
  | BeltPassDeferred { reason: String }
  | BeltPassRefused { reason: String }
  | BeltPassFailed { reason: String }

type BeltTickReceipt {
  observed_at: String,
  spawn_pass: BeltPassOutcome,
  teardown_pass: BeltPassOutcome,
  verify_pass: BeltPassOutcome,
  publish_pass: BeltPassOutcome,
}

type BeltTickReceiptRead
  = BeltTickReceiptPresent { receipt: BeltTickReceipt }
  | BeltTickReceiptAbsent
  | BeltTickReceiptUnreadable { reason: String }

data belt_tick_receipt_note: String = "THE PERSISTED TICK RECEIPT IS WHAT THE WORKFLOW UI READS to answer whether a belt tick ran, deferred, refused, or failed — today it exists only in journald stdout and the row cannot say 'Verification queued - next belt tick' or 'blocked - belt session observation refused'. Each pass is typed independently (BeltPassOutcome): spawn/teardown depend on tmux session observation; verify depends only on the attempt ledger plus terminal provider/process evidence; publish depends on exact verified head plus repository observation. A tmux-list refusal may block spawn/reap while verify still examines its own attempt evidence (DESIGN section 5: a failure arm must refuse narrowly, never widen to zeroing sibling passes). Written beside the instance's attempt-state root so /workflow.json can read it without re-running the belt."

data belt_tick_receipt_schema: String = "roadmap-belt-tick-receipt/v2"

fn belt_tick_receipt_path_for_instance(instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance) -> String {
  join([instance.instance_root as String, "/belt-last-tick.json"], "")
}

fn belt_pass_outcome_key(o: BeltPassOutcome) -> String {
  match o {
    BeltPassRecorded => "recorded"
    BeltPassDeferred { reason: _ } => "deferred"
    BeltPassRefused { reason: _ } => "refused"
    BeltPassFailed { reason: _ } => "failed"
  }
}

fn belt_pass_outcome_json(o: BeltPassOutcome) -> extdeps.languages.json.emit.JsonValue {
  match o {
    BeltPassRecorded =>
      json_object(members: [
        json_kv(key: "outcome", value: json_string(s: "recorded")),
      ])
    BeltPassDeferred { reason: r } =>
      json_object(members: [
        json_kv(key: "outcome", value: json_string(s: "deferred")),
        json_kv(key: "reason", value: json_string(s: r)),
      ])
    BeltPassRefused { reason: r } =>
      json_object(members: [
        json_kv(key: "outcome", value: json_string(s: "refused")),
        json_kv(key: "reason", value: json_string(s: r)),
      ])
    BeltPassFailed { reason: r } =>
      json_object(members: [
        json_kv(key: "outcome", value: json_string(s: "failed")),
        json_kv(key: "reason", value: json_string(s: r)),
      ])
  }
}

type BeltPassOutcomeDecode
  = BeltPassOutcomeDecoded { outcome: BeltPassOutcome }
  | BeltPassOutcomeUnreadable { reason: String }

fn belt_pass_outcome_from_json(doc: extdeps.languages.json.emit.JsonValue) -> BeltPassOutcomeDecode {
  match json_object_unique_member(v: doc, key: "outcome") {
    JsonMemberFound { value: JsonString { value: outcome } } =>
      match outcome {
        "recorded" => BeltPassOutcomeDecoded { outcome: BeltPassRecorded }
        "deferred" =>
          match json_object_unique_member(v: doc, key: "reason") {
            JsonMemberFound { value: JsonString { value: r } } =>
              BeltPassOutcomeDecoded { outcome: BeltPassDeferred { reason: r } }
            _ =>
              BeltPassOutcomeUnreadable { reason: "belt tick pass deferred without reason" }
          }
        "refused" =>
          match json_object_unique_member(v: doc, key: "reason") {
            JsonMemberFound { value: JsonString { value: r } } =>
              BeltPassOutcomeDecoded { outcome: BeltPassRefused { reason: r } }
            _ =>
              BeltPassOutcomeUnreadable { reason: "belt tick pass refused without reason" }
          }
        "failed" =>
          match json_object_unique_member(v: doc, key: "reason") {
            JsonMemberFound { value: JsonString { value: r } } =>
              BeltPassOutcomeDecoded { outcome: BeltPassFailed { reason: r } }
            _ =>
              BeltPassOutcomeUnreadable { reason: "belt tick pass failed without reason" }
          }
        _ => BeltPassOutcomeUnreadable { reason: "belt tick pass outcome is unknown" }
      }
    JsonMemberAbsent =>
      BeltPassOutcomeUnreadable { reason: "belt tick pass outcome is missing" }
    JsonMemberDuplicated { count: _ } =>
      BeltPassOutcomeUnreadable { reason: "belt tick pass outcome is duplicated" }
    JsonMemberNotAnObject =>
      BeltPassOutcomeUnreadable { reason: "belt tick pass outcome is unreadable" }
  }
}

fn belt_tick_receipt_decode(raw: String) -> BeltTickReceiptRead {
  match parse_json(s: raw) {
    Absent =>
      BeltTickReceiptUnreadable { reason: "belt tick receipt is not one complete JSON value" }
    Present { value: doc } =>
      match json_object_unique_member(v: doc, key: "schema") {
        JsonMemberFound { value: JsonString { value: schema } } =>
          if schema != belt_tick_receipt_schema {
            BeltTickReceiptUnreadable { reason: "belt tick receipt schema is unknown" }
          } else {
            match json_object_unique_member(v: doc, key: "observed_at") {
              JsonMemberFound { value: JsonString { value: observed_at } } =>
                match belt_pass_outcome_from_member(doc: doc, key: "spawn_pass") {
                  BeltPassOutcomeUnreadable { reason: r } =>
                    BeltTickReceiptUnreadable { reason: r }
                  BeltPassOutcomeDecoded { outcome: spawn_pass } =>
                    match belt_pass_outcome_from_member(doc: doc, key: "teardown_pass") {
                      BeltPassOutcomeUnreadable { reason: r } =>
                        BeltTickReceiptUnreadable { reason: r }
                      BeltPassOutcomeDecoded { outcome: teardown_pass } =>
                        match belt_pass_outcome_from_member(doc: doc, key: "verify_pass") {
                          BeltPassOutcomeUnreadable { reason: r } =>
                            BeltTickReceiptUnreadable { reason: r }
                          BeltPassOutcomeDecoded { outcome: verify_pass } =>
                            match belt_pass_outcome_from_member(doc: doc, key: "publish_pass") {
                              BeltPassOutcomeUnreadable { reason: r } =>
                                BeltTickReceiptUnreadable { reason: r }
                              BeltPassOutcomeDecoded { outcome: publish_pass } =>
                                BeltTickReceiptPresent {
                                  receipt: BeltTickReceipt {
                                    observed_at: observed_at,
                                    spawn_pass: spawn_pass,
                                    teardown_pass: teardown_pass,
                                    verify_pass: verify_pass,
                                    publish_pass: publish_pass,
                                  },
                                }
                            }
                        }
                    }
                }
              _ =>
                BeltTickReceiptUnreadable { reason: "belt tick receipt observed_at is missing" }
            }
          }
        _ =>
          BeltTickReceiptUnreadable { reason: "belt tick receipt schema is missing" }
      }
  }
}

fn belt_pass_outcome_from_member(doc: extdeps.languages.json.emit.JsonValue, key: String) -> BeltPassOutcomeDecode {
  match json_object_unique_member(v: doc, key: key) {
    JsonMemberFound { value: pass_doc } => belt_pass_outcome_from_json(doc: pass_doc)
    _ =>
      BeltPassOutcomeUnreadable {
        reason: join(["belt tick receipt ", key, " is missing"], ""),
      }
  }
}

type SpawnWorkdirInstanceLookup
  = SpawnWorkdirInstanceResolved { instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance }
  | UnknownSpawnWorkdir { workdir: String }

fn belt_dashboard_instance_lookup_for_spawn_workdir(
  workdir: String,
) -> SpawnWorkdirInstanceLookup {
  if workdir == (srv1_green_dashboard_instance().repo_root as String) {
    SpawnWorkdirInstanceResolved { instance: srv1_green_dashboard_instance() }
  } else if workdir == (srv1_live_dashboard_instance().repo_root as String) {
    SpawnWorkdirInstanceResolved { instance: srv1_live_dashboard_instance() }
  } else {
    UnknownSpawnWorkdir { workdir: workdir }
  }
}

fn belt_tick_receipt_read_from_filesystem(
  success: Bool,
  content: String,
  error: String,
) -> BeltTickReceiptRead {
  if success {
    if trim(content) == "" {
      BeltTickReceiptAbsent
    } else {
      belt_tick_receipt_decode(raw: content)
    }
  } else if string_contains(s: error, pattern: "No such file")
      || string_contains(s: error, pattern: "not found") {
    BeltTickReceiptAbsent
  } else {
    BeltTickReceiptUnreadable {
      reason: join(["belt tick receipt could not be read: ", error], ""),
    }
  }
}

fn belt_tick_receipt_read_for_instance(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
) -> BeltTickReceiptRead {
  let read = Filesystem.Read(
    path: belt_tick_receipt_path_for_instance(instance: instance),
  )
  belt_tick_receipt_read_from_filesystem(
    success: read.success,
    content: read.content,
    error: read.error,
  )
}

fn belt_tick_receipt_json_value(receipt: BeltTickReceipt) -> extdeps.languages.json.emit.JsonValue {
  json_object(members: [
    json_kv(key: "schema", value: json_string(s: belt_tick_receipt_schema)),
    json_kv(key: "observed_at", value: json_string(s: receipt.observed_at)),
    json_kv(key: "spawn_pass", value: belt_pass_outcome_json(o: receipt.spawn_pass)),
    json_kv(key: "teardown_pass", value: belt_pass_outcome_json(o: receipt.teardown_pass)),
    json_kv(key: "verify_pass", value: belt_pass_outcome_json(o: receipt.verify_pass)),
    json_kv(key: "publish_pass", value: belt_pass_outcome_json(o: receipt.publish_pass)),
  ])
}

fn belt_teardown_ok(o: BeltTeardownOutcome) -> Bool {
  match o {
    ReapedSession { session_name: _ } => true
    TeardownFailed { session_name: _, detail: _ } => false
  }
}

fn belt_spawn_pass_outcome_from(
  observe_refused: Bool,
  observe_reason: String,
  spawn_outcomes: List<BeltSpawnOutcome>,
) -> BeltPassOutcome {
  if observe_refused {
    BeltPassRefused { reason: observe_reason }
  } else {
    if count(spawn_outcomes |> filter(o => match o {
      SpawnFailed { node_id: _, step: _, detail: _, provider: _ } => true
      Spawned { node_id: _, session_name: _, provider: _ } => false
    })) > 0 {
      BeltPassFailed { reason: "one or more spawn outcomes failed" }
    } else {
      BeltPassRecorded
    }
  }
}

fn belt_teardown_pass_outcome_from(
  observe_refused: Bool,
  observe_reason: String,
  teardown_outcomes: List<BeltTeardownOutcome>,
) -> BeltPassOutcome {
  if observe_refused {
    BeltPassRefused { reason: observe_reason }
  } else {
    if count(teardown_outcomes |> filter(o => !belt_teardown_ok(o: o))) > 0 {
      BeltPassFailed { reason: "one or more teardown outcomes failed" }
    } else {
      BeltPassRecorded
    }
  }
}

fn belt_tick_observed_at() -> String {
  match clock_now_probed_at() {
    Present { value: probed_at } => probed_at as String
    Absent => "clock observation refused"
  }
}

fn belt_tick_receipt_write_for_instance(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  receipt: BeltTickReceipt,
) -> BeltPassOutcome {
  let write = Filesystem.Write(
    path: belt_tick_receipt_path_for_instance(instance: instance),
    content: serialize_json(v: belt_tick_receipt_json_value(receipt: receipt)),
  )
  if write.success {
    BeltPassRecorded
  } else {
    BeltPassFailed {
      reason: join([
        "the belt tick receipt could not be written: ",
        write.error,
      ], ""),
    }
  }
}

data belt_tick_verify_pass_note: String = "Verification runs on the SAME tick that spawns and reaps, because it is the same kind of fact: a desired obligation reconciled against an observed one. Putting it here rather than behind its own trigger is what makes the mechanism the thing the operator was doing by hand — the belt already runs, so an attempt whose turn completed gets its receipts run on the next tick without anyone noticing it finished. It runs AFTER the reconcile's actuations and reads its own evidence, so a session spawned by this same tick has no completed turn to verify and is simply deferred. VERIFY NO LONGER SHORT-CIRCUITS ON SESSION OBSERVE REFUSAL: a tmux-list refusal blocks spawn/reap only; verify reads the attempt ledger and terminal provider/process evidence on its own authority (operator P1, 2026-08-02)."

type BeltTickResult {
  observe_refused: Bool,
  observe_refusal_reason: String,
  reconcile: gunbc.roadmap_belt.BeltReconcile,
  spawn_outcomes: List<BeltSpawnOutcome>,
  teardown_outcomes: List<BeltTeardownOutcome>,
  verify_outcomes: List<BeltVerifyOutcome>,
  publish_outcomes: List<BeltPublishOutcome>,
}

fn belt_tick_empty_reconcile(state: gunbc.roadmap_belt.BeltRunState) -> gunbc.roadmap_belt.BeltReconcile {
  gunbc.roadmap_belt.BeltReconcile {
    run_state: state,
    occupied: 0,
    free: 0,
    spawns: [],
    deferred: 0,
    teardowns: [],
    refusals: [],
  }
}

data belt_tick_note: String = "The re-runnable belt driver: observe the live session set -> decide via belt_reconcile (the sole belt decision; belt_step is its degenerate spawn-only precursor) -> actuate each planned spawn/teardown through the fail-closed exec seam. Idempotent by construction: a spawned session is observed present on the next tick, keying to its ready node as Unchanged -> noop, so re-ticking never double-spawns (the observed set closes the loop the pure decision cannot). ObserveRefused blocks spawn/reap only — verify and publish still run on their own evidence authorities (operator P1, 2026-08-02)."

data belt_tick_lifecycle_note: String = "THE TIMER IS A DISPATCH ACTUATOR TOO (review artifact 51237, both P0s). The dead-pane fix and the revision gate reached the click path only. This tick passed the whole observed session list into belt_reconcile, which maps EVERY present row to an observed member and counts live.length() as occupied — so a retained dead pane stayed a member (desired + present = Unchanged, no respawn) and still consumed a capacity slot. It also never consulted the deployed revision, so a drifted host refused a click and spawned on a timer.\n\nBOTH PATHS NOW CONSUME ONE SEAM. belt_revision_admission gates the tick before any spawn or reap. A refusal blocks spawn and teardown ONLY: verification and publication continue, because they read independently bound receipts and already run when tmux observation refuses — stopping them would widen a spawn-admission refusal into a work stoppage.\n\nCLEANUP PRECEDES START, DEFERRED ONE TICK. A stale pane is excluded from observed membership, so the node becomes a spawn candidate — but spawning it THIS tick would collide with the tmux session name that still exists, because spawn runs before teardown here. So a stale node's spawn is withheld this tick and its teardown is planned; the next tick observes it Absent and spawns normally. That is why the fix is a partition plus a deferral rather than a filter.\n\nLivenessUnobserved and MultiplicityConflict are neither cleaned nor spawned: they are counted refusals. An unobserved pane might be running, so tearing it down could kill live work, and spawning beside it could double-run the node.\n\nTHIS PARAGRAPH DESCRIBED BEHAVIOUR THE CODE DID NOT HAVE (review artifact 51285), which is worse than the gap it described. The first cut partitioned `refused` and never read it again, so only stale node ids were withheld from spawn — a ready node with an unobserved-but-present session read as ABSENT to belt_reconcile and could be spawned beside a pane that might be running. The deferral set is now every non-running class, so the note and the code say the same thing.\n\nMULTIPLICITY IS A NODE FACT, NOT A SESSION FACT, and the first cut missed it here for that reason: belt_tick_classify_sessions read each row's process state in isolation, so two rows for one node (one running, one stale) landed in two different buckets and the reconciler acted on an ambiguous observation that dispatch would have refused. The partition is now node-aware — a node with more than one row is conflicted whatever its rows say individually — so both actuation paths refuse the same ambiguity."

type BeltTickSessionPartition {
  running: List<gunbc.roadmap_dispatch_actuator.DispatchLiveSession>
  stale: List<gunbc.roadmap_dispatch_actuator.DispatchLiveSession>
  refused: List<gunbc.roadmap_dispatch_actuator.DispatchLiveSession>
  conflicted: List<gunbc.roadmap_dispatch_actuator.DispatchLiveSession>
}

fn belt_tick_node_row_count(live: List<gunbc.roadmap_dispatch_actuator.DispatchLiveSession>, node_id: String) -> Int {
  count(filter(live, s => s.node_id == node_id))
}

data belt_tick_session_class_note: String = "THE PARTITION READS THE COPRODUCT, NOT A PARALLEL STRING VOCABULARY (review artifact 51309). The first cut asked belt_tick_session_is(s, arm: \"running\") and compared string arms — a second naming scheme for BeltSessionLiveness, which already names exactly these states. Two vocabularies for one concept is the nicknaming class, and the string one is strictly worse: a typo in an arm name compiles and silently empties a bucket, where a missing coproduct arm is a non-exhaustive match the compiler catches.\n\nThe node-awareness stays here rather than moving into belt_session_liveness_from_process, because multiplicity is a fact about a NODE's rows and that function sees one row's process. belt_node_session_liveness makes the same distinction on the dispatch path."

fn belt_tick_session_class(
  live: List<gunbc.roadmap_dispatch_actuator.DispatchLiveSession>,
  s: gunbc.roadmap_dispatch_actuator.DispatchLiveSession,
) -> BeltSessionLiveness {
  let n = belt_tick_node_row_count(live: live, node_id: s.node_id)
  if n > 1 {
    BeltSessionMultiplicityConflict {
      session_names: join(
        map(filter(live, r => r.node_id == s.node_id), r => r.session_name), ", "),
      session_count: n,
    }
  } else {
    belt_session_liveness_from_process(session_name: s.session_name, process: s.worker.process)
  }
}

fn belt_tick_is_running(live: List<gunbc.roadmap_dispatch_actuator.DispatchLiveSession>, s: gunbc.roadmap_dispatch_actuator.DispatchLiveSession) -> Bool {
  match belt_tick_session_class(live: live, s: s) {
    BeltSessionRunning { session_name: _, command: _ } => true
    _ => false
  }
}

fn belt_tick_is_stale(live: List<gunbc.roadmap_dispatch_actuator.DispatchLiveSession>, s: gunbc.roadmap_dispatch_actuator.DispatchLiveSession) -> Bool {
  match belt_tick_session_class(live: live, s: s) {
    BeltSessionStaleTerminal { session_name: _, detail: _ } => true
    _ => false
  }
}

fn belt_tick_is_refused(live: List<gunbc.roadmap_dispatch_actuator.DispatchLiveSession>, s: gunbc.roadmap_dispatch_actuator.DispatchLiveSession) -> Bool {
  match belt_tick_session_class(live: live, s: s) {
    BeltSessionLivenessUnobserved { session_name: _, reason: _ } => true
    _ => false
  }
}

fn belt_tick_is_conflicted(live: List<gunbc.roadmap_dispatch_actuator.DispatchLiveSession>, s: gunbc.roadmap_dispatch_actuator.DispatchLiveSession) -> Bool {
  match belt_tick_session_class(live: live, s: s) {
    BeltSessionMultiplicityConflict { session_names: _, session_count: _ } => true
    _ => false
  }
}

fn belt_tick_classify_sessions(live: List<gunbc.roadmap_dispatch_actuator.DispatchLiveSession>) -> BeltTickSessionPartition {
  BeltTickSessionPartition {
    running: filter(live, s => belt_tick_is_running(live: live, s: s)),
    stale: filter(live, s => belt_tick_is_stale(live: live, s: s)),
    refused: filter(live, s => belt_tick_is_refused(live: live, s: s)),
    conflicted: filter(live, s => belt_tick_is_conflicted(live: live, s: s)),
  }
}

data belt_tick_revision_drift_reason: String = "belt tick refused: deployed tree is not the admitted fleet revision; spawn and reap withheld"
data belt_tick_revision_unobserved_reason: String = "belt tick refused: deployed revision could not be observed; spawn and reap withheld"

fn belt_tick_revision_refused(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  state: gunbc.roadmap_belt.BeltRunState,
  reason: String,
) -> BeltTickResult {
  BeltTickResult {
    observe_refused: true,
    observe_refusal_reason: reason,
    reconcile: belt_tick_empty_reconcile(state: state),
    spawn_outcomes: [],
    teardown_outcomes: [],
    verify_outcomes: belt_verify_attempts_for_instance(instance: instance),
    publish_outcomes: belt_publish_attempts_for_instance(instance: instance),
  }
}

fn belt_tick_for_instance(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  state: gunbc.roadmap_belt.BeltRunState,
  frontier: gunbc.roadmap_spawner.SpawnFrontier,
  cap: gunbc.roadmap_belt.BeltCapacity,
  spawn_workdir: String,
) -> BeltTickResult {
  match belt_sessions_observe_for_instance(instance: instance) {
    ObserveRefused { reason: r } =>
      BeltTickResult {
        observe_refused: true,
        observe_refusal_reason: r,
        reconcile: belt_tick_empty_reconcile(state: state),
        spawn_outcomes: [],
        teardown_outcomes: [],
        verify_outcomes: belt_verify_attempts_for_instance(instance: instance),
        publish_outcomes: belt_publish_attempts_for_instance(instance: instance),
      }
    Observed { live: live } =>
      match belt_revision_admission(
        standing: fleet_revision_standing(repo: instance.repo_root),
      ) {
        BeltRevisionRefusedDrifted { desired: d, local: l } =>
          belt_tick_revision_refused(
            instance: instance,
            state: state,
            reason: join([belt_tick_revision_drift_reason, " desired=", d, " local=", l], ""),
          )
        BeltRevisionRefusedUnobserved { cause: c } =>
          belt_tick_revision_refused(
            instance: instance,
            state: state,
            reason: join([belt_tick_revision_unobserved_reason, " cause=", c], ""),
          )
        BeltRevisionAdmitted { revision: _ } => {
      let classified = belt_tick_classify_sessions(live: live)
      let r = belt_reconcile(
        state: state,
        frontier: frontier,
        live: classified.running,
        cap: cap,
      )
      let deferred_ids = concat(
        map(classified.stale, s => s.node_id),
        concat(
          map(classified.refused, s => s.node_id),
          map(classified.conflicted, s => s.node_id),
        ),
      )
      let admitted_spawns = filter(r.spawns, m =>
        !any(deferred_ids, id => id == dispatch_member_key(m: m)))
      let spawn_outcomes = admitted_spawns |> map(m => belt_actuate_spawn_member(m: m, workdir: spawn_workdir))
      let stale_teardowns = map(classified.stale, s => ObservedMember { node_id: s.node_id, session: s })
      let teardown_outcomes =
        concat(r.teardowns, stale_teardowns) |> map(m => belt_actuate_teardown_member(m: m))
      BeltTickResult {
        observe_refused: false,
        observe_refusal_reason: "",
        reconcile: r,
        spawn_outcomes: spawn_outcomes,
        teardown_outcomes: teardown_outcomes,
        verify_outcomes: belt_verify_attempts_for_instance(instance: instance),
        publish_outcomes: belt_publish_attempts_for_instance(instance: instance),
      }
        }
      }
  }
}

fn belt_tick(
  state: gunbc.roadmap_belt.BeltRunState,
  frontier: gunbc.roadmap_spawner.SpawnFrontier,
  cap: gunbc.roadmap_belt.BeltCapacity,
  spawn_workdir: String,
) -> BeltTickResult {
  belt_tick_for_instance(
    instance: srv1_live_dashboard_instance(),
    state: state,
    frontier: frontier,
    cap: cap,
    spawn_workdir: spawn_workdir,
  )
}

fn belt_tick_default_workdir(
  state: gunbc.roadmap_belt.BeltRunState,
  frontier: gunbc.roadmap_spawner.SpawnFrontier,
  cap: gunbc.roadmap_belt.BeltCapacity,
) -> BeltTickResult {
  belt_tick(state: state, frontier: frontier, cap: cap, spawn_workdir: belt_actuate_workdir as String)
}

fn belt_spawn_ok(o: BeltSpawnOutcome) -> Bool {
  match o {
    Spawned { node_id: _, session_name: _, provider: _ } => true
    SpawnFailed { node_id: _, step: _, detail: _, provider: _ } => false
  }
}

fn belt_tick_spawn_ok_count(t: BeltTickResult) -> Int {
  count(t.spawn_outcomes |> filter(o => belt_spawn_ok(o: o)))
}

fn belt_tick_spawn_failed_count(t: BeltTickResult) -> Int {
  count(t.spawn_outcomes |> filter(o => !belt_spawn_ok(o: o)))
}

fn belt_tick_teardown_ok_count(t: BeltTickResult) -> Int {
  count(t.teardown_outcomes |> filter(o => belt_teardown_ok(o: o)))
}

data belt_run_once_note: String = "The runnable belt entrypoint: one tick against the LIVE roadmap. Reads the roadmap authority + merged PRs, builds the ready frontier, and runs belt_tick_default_workdir (Running, default capacity, belt_actuate_workdir). Zero-arg so it is invokable directly (gunbc run --function belt_run_once_json, wet), spawning a real tmux session through dispatch_cli_provider on the host it runs on. belt_run_once returns the typed BeltTickResult; belt_run_once_json projects it to a receipt (observe verdict, occupied/free/deferred, per-node spawn/teardown outcomes, refusal count) so the operator sees exactly what one tick did — no fabricated summary. Idempotent: a spawned session is observed live next tick and reconciles to noop."

fn belt_run_once_in(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  spawn_workdir: String,
) -> BeltTickResult {
  match roadmap_authority_projection() {
    RoadmapAuthorityProjectionRefused { detail: detail } =>
      BeltTickResult {
        observe_refused: true,
        observe_refusal_reason: concat("roadmap authority projection refused: ", detail),
        reconcile: belt_tick_empty_reconcile(state: roadmap_belt_default_run_state),
        spawn_outcomes: [],
        teardown_outcomes: [],
        verify_outcomes: belt_verify_attempts_for_instance(instance: instance),
        publish_outcomes: belt_publish_attempts_for_instance(instance: instance),
      }
    RoadmapAuthorityProjected { doc: doc, accepted: _ } =>
      belt_tick_for_instance(
        instance: instance,
        state: roadmap_belt_default_run_state,
        frontier: spawn_frontier(doc: doc, merged: authored_merged_prs()),
        cap: roadmap_belt_default_capacity,
        spawn_workdir: spawn_workdir,
      )
  }
}

fn belt_run_once() -> BeltTickResult {
  belt_run_once_in(
    instance: srv1_live_dashboard_instance(),
    spawn_workdir: belt_actuate_workdir as String,
  )
}

fn belt_spawn_outcome_json(o: BeltSpawnOutcome) -> extdeps.languages.json.emit.JsonValue {
  match o {
    Spawned { node_id: nid, session_name: sn, provider: p } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "spawned")),
        json_kv(key: "provider", value: json_string(s: p)),
        json_kv(key: "session_name", value: json_string(s: sn)),
      ])
    SpawnFailed { node_id: nid, step: st, detail: d, provider: p } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "spawn_failed")),
        json_kv(key: "provider", value: json_string(s: p)),
        json_kv(key: "step", value: json_string(s: st)),
        json_kv(key: "detail", value: json_string(s: d)),
      ])
  }
}

fn belt_teardown_outcome_json(o: BeltTeardownOutcome) -> extdeps.languages.json.emit.JsonValue {
  match o {
    ReapedSession { session_name: sn } =>
      json_object(members: [
        json_kv(key: "session_name", value: json_string(s: sn)),
        json_kv(key: "status", value: json_string(s: "reaped")),
      ])
    TeardownFailed { session_name: sn, detail: d } =>
      json_object(members: [
        json_kv(key: "session_name", value: json_string(s: sn)),
        json_kv(key: "status", value: json_string(s: "teardown_failed")),
        json_kv(key: "detail", value: json_string(s: d)),
      ])
  }
}

fn belt_tick_result_json_value(t: BeltTickResult) -> extdeps.languages.json.emit.JsonValue {
  json_object(members: [
    json_kv(key: "schema", value: json_string(s: "roadmap-belt-tick/v1")),
    json_kv(key: "observe_refused", value: json_bool(b: t.observe_refused)),
    json_kv(key: "observe_refusal_reason", value: json_string(s: t.observe_refusal_reason)),
    json_kv(key: "run_state", value: json_string(s: belt_run_state_label(s: t.reconcile.run_state))),
    json_kv(key: "occupied", value: json_int(n: t.reconcile.occupied)),
    json_kv(key: "free", value: json_int(n: t.reconcile.free)),
    json_kv(key: "deferred", value: json_int(n: t.reconcile.deferred)),
    json_kv(key: "refusal_count", value: json_int(n: belt_reconcile_refusal_count(r: t.reconcile))),
    json_kv(key: "spawned", value: json_int(n: belt_tick_spawn_ok_count(t: t))),
    json_kv(key: "spawn_failed", value: json_int(n: belt_tick_spawn_failed_count(t: t))),
    json_kv(key: "reaped", value: json_int(n: belt_tick_teardown_ok_count(t: t))),
    json_kv(key: "spawn_outcomes", value: json_array(elements: t.spawn_outcomes |> map(o => belt_spawn_outcome_json(o: o)))),
    json_kv(key: "teardown_outcomes", value: json_array(elements: t.teardown_outcomes |> map(o => belt_teardown_outcome_json(o: o)))),
    json_kv(key: "verified", value: json_int(n: belt_tick_verify_recorded_count(t: t))),
    json_kv(key: "verify_outcomes", value: json_array(elements: t.verify_outcomes |> map(o => belt_verify_outcome_json(o: o)))),
  ])
}

fn belt_verify_outcome_json(o: BeltVerifyOutcome) -> extdeps.languages.json.emit.JsonValue {
  match o {
    VerifyDeferred { node_id, reason } =>
      json_object(members: [
        json_kv(key: "node", value: json_string(s: node_id)),
        json_kv(key: "outcome", value: json_string(s: "deferred")),
        json_kv(key: "detail", value: json_string(s: reason)),
      ])
    VerifyRecorded { node_id, verdict_key, detail } =>
      json_object(members: [
        json_kv(key: "node", value: json_string(s: node_id)),
        json_kv(key: "outcome", value: json_string(s: "recorded")),
        json_kv(key: "verdict", value: json_string(s: verdict_key)),
        json_kv(key: "detail", value: json_string(s: detail)),
      ])
    VerifyWriteFailed { node_id, detail } =>
      json_object(members: [
        json_kv(key: "node", value: json_string(s: node_id)),
        json_kv(key: "outcome", value: json_string(s: "write-failed")),
        json_kv(key: "detail", value: json_string(s: detail)),
      ])
    VerifyEvidenceUnreadable { node_id, detail } =>
      json_object(members: [
        json_kv(key: "node", value: json_string(s: node_id)),
        json_kv(key: "outcome", value: json_string(s: "evidence-unreadable")),
        json_kv(key: "detail", value: json_string(s: detail)),
      ])
    VerifyRefused { node_id, cause } =>
      json_object(members: [
        json_kv(key: "node", value: json_string(s: node_id)),
        json_kv(key: "outcome", value: json_string(s: "refused")),
        json_kv(key: "detail", value: json_string(s: cause)),
      ])
  }
}

data belt_tick_verify_counts_note: String = "The tick counts verdicts RECORDED, never verdicts passed. A tick that records four refusals did its job exactly as well as one that records four passes — the belt's obligation is to produce the receipt, not to produce a green — so counting passes here would make the belt's own receipt read as a quality metric and give a later reader a reason to want fewer refusals. Write failures are counted separately because they are the belt failing, not the validation."

fn belt_tick_verify_recorded_count(t: BeltTickResult) -> Int {
  count(t.verify_outcomes |> filter(o => match o {
    VerifyRecorded { node_id: _, verdict_key: _, detail: _ } => true
    VerifyDeferred { node_id: _, reason: _ } => false
    VerifyWriteFailed { node_id: _, detail: _ } => false
    VerifyEvidenceUnreadable { node_id: _, detail: _ } => false
    VerifyRefused { node_id: _, cause: _ } => false
  }))
}

fn belt_tick_verify_write_failed_count(t: BeltTickResult) -> Int {
  count(t.verify_outcomes |> filter(o => match o {
    VerifyWriteFailed { node_id: _, detail: _ } => true
    VerifyEvidenceUnreadable { node_id: _, detail: _ } => true
    VerifyRecorded { node_id: _, verdict_key: _, detail: _ } => false
    VerifyDeferred { node_id: _, reason: _ } => false
    VerifyRefused { node_id: _, cause: _ } => false
  }))
}

type BeltAttempts
  = AttemptsObserved { attempts: List<gunbc.roadmap_dispatch_actuator.DispatchAttemptRef> }
  | AttemptsRefused { reason: String }

data belt_attempts_observe_note: String = "U3: the attempts observation mirrors belt_observe's fail-closed grammar — git absent or a non-zero for-each-ref is an UNKNOWABLE attempts set (AttemptsRefused, typed, carries stderr), never widened to zero attempts; exit 0 with empty output IS a genuine zero (for-each-ref's documented no-match behavior). Runs in belt_actuate_workdir — the same repo-root authority the spawn's worktree add uses, because the attempt branches live exactly where spawns mint them."

fn belt_attempts_observe_for_instance(instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance) -> BeltAttempts {
  let cmd = git_for_each_ref_dispatch_argv_for_instance(instance: instance)
  if belt_program_available(program: cmd.program) {
    let result = gunbc.WitnessBin.Run(
      workdir: instance.repo_root,
      bin_path: cmd.program as std.types.FilePath,
      args: cmd.args,
    )
    if result.success {
      AttemptsObserved { attempts: dispatch_attempt_refs(git_output: result.stdout) }
    } else {
      AttemptsRefused { reason: concat("git for-each-ref failed: ", result.stderr) }
    }
  } else {
    AttemptsRefused { reason: "git not found on PATH — the attempts set is unknowable" }
  }
}

fn belt_attempts_observe() -> BeltAttempts {
  belt_attempts_observe_for_instance(instance: srv1_live_dashboard_instance())
}

fn belt_attempts_json_value(a: BeltAttempts) -> extdeps.languages.json.emit.JsonValue {
  match a {
    AttemptsRefused { reason: r } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: "roadmap-attempts/v1")),
        json_kv(key: "attempts_refused", value: json_bool(b: true)),
        json_kv(key: "reason", value: json_string(s: r)),
      ])
    AttemptsObserved { attempts } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: "roadmap-attempts/v1")),
        json_kv(key: "attempts_refused", value: json_bool(b: false)),
        json_kv(key: "attempts", value: json_array(elements: attempts |> map(a2 => {
          let evidence = dispatch_attempt_evidence(attempt: a2)
          json_object(members: [
            json_kv(key: "node_id", value: json_string(s: a2.node_id)),
            json_kv(key: "branch", value: json_string(s: a2.branch)),
            json_kv(key: "attempt_key", value: json_string(s: a2.attempt_key)),
            json_kv(key: "worktree_evidence", value: json_string(s: worktree_evidence_label(evidence: evidence.worktree))),
            json_kv(key: "provider_evidence", value: json_string(s: provider_evidence_label(evidence: evidence.provider_instance))),
            json_kv(key: "process_identity_evidence", value: json_string(s: process_identity_evidence_label(evidence: evidence.process_identity))),
            json_kv(key: "transcript_evidence", value: json_string(s: transcript_evidence_label(evidence: evidence.transcript))),
            json_kv(key: "terminal_outcome_evidence", value: json_string(s: terminal_outcome_evidence_label(evidence: evidence.terminal_outcome))),
          ])
        }))),
      ])
  }
}

fn belt_attempts_observed_json(a: BeltAttempts) -> String {
  serialize_json(v: belt_attempts_json_value(a: a))
}

fn belt_attempts_http_status(a: BeltAttempts) -> Int {
  match a {
    AttemptsRefused { reason: _ } => 503
    AttemptsObserved { attempts: _ } => 200
  }
}

type BeltAttemptPanes
  = BeltAttemptPanesObserved { panes: List<extdeps.tmux.TmuxAttemptPaneEntry> }
  | BeltAttemptPanesRefused { reason: String }

type BeltWorkflowAttempts
  = WorkflowAttemptsObserved { attempts: List<gunbc.roadmap_workflow_progress.WorkflowAttemptProgress> }
  | WorkflowAttemptsRefused { reason: String }

data belt_workflow_attempts_note: String = "The workflow route joins the latest published attempt state to process evidence at node grain. Git refs determine which nodes have attempts; the node-current pointer selects the latest modeled attempt without guessing chronology from content-hash keys; Filesystem.Read observes the immutable key/admission prefix plus the append-only Codex JSONL; one exact tmux list-panes read observes alive/dead/exit for all attempts. A git refusal refuses the route. A pane-command or parse refusal stays located inside each attempt so already-terminal provider evidence remains usable while incomplete attempts become refused."

fn belt_attempt_panes_observe_for_instance(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
) -> BeltAttemptPanes {
  let cmd = tmux_attempt_panes_argv_for_instance(instance: instance)
  if belt_program_available(program: cmd.program) {
    let result = gunbc.WitnessBin.Run(
      workdir: belt_observe_workdir,
      bin_path: cmd.program as std.types.FilePath,
      args: cmd.args,
      expect: OutcomeIsData,
    )
    if result.success {
      match parse_tmux_attempt_panes_output(output: result.stdout) {
        AttemptPanesParsed { panes } =>
          BeltAttemptPanesObserved { panes: panes }
        AttemptPanesParseRefused { line_number, raw, reason } =>
          BeltAttemptPanesRefused {
            reason: join([
              "tmux attempt-pane parse refused at line ",
              to_string(line_number),
              ": ",
              reason,
              "; raw=",
              raw,
            ], ""),
          }
      }
    } else {
      match classify_tmux_session_list(
        exit_ok: result.success,
        stdout: result.stdout,
        stderr: result.stderr,
      ) {
        TmuxNoServer { evidence: _ } =>
          BeltAttemptPanesObserved { panes: [] }
        TmuxSessionsListed { entries: _ } =>
          BeltAttemptPanesRefused {
            reason: join([
              "tmux attempt-pane observation failed: ",
              result.stderr,
            ], ""),
          }
        TmuxListUnknowable { stderr: e } =>
          BeltAttemptPanesRefused {
            reason: join([
              "tmux attempt-pane observation failed: ",
              e,
            ], ""),
          }
        TmuxListStdoutRefused { line_number, raw, reason } =>
          BeltAttemptPanesRefused {
            reason: belt_ls_stdout_refusal_reason(
              line_number: line_number,
              raw: raw,
              reason: reason,
            ),
          }
      }
    }
  } else {
    BeltAttemptPanesRefused {
      reason: "tmux realization is not executable; process state is unknowable",
    }
  }
}

data belt_sessions_observation_separation_note: String = "The sessions route has two probes with independent authority. tmux ls decides only which session containers are present; if it refuses, the session set refuses. The richer pane probe decides process running/exited/unobserved and cleanup eligibility for each already-observed session. A pane-probe refusal therefore does NOT erase known session presence: it maps every present session to process-unobserved and cleanup-unavailable with the located pane reason. This keeps the UI capable of saying `session present · process unknown` instead of either fabricating liveness or hiding the container."

fn belt_sessions_observe_for_instance(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
) -> BeltObserve {
  let ls = tmux_ls_argv_for_instance(instance: instance)
  if belt_program_available(program: ls.program) {
    let result = gunbc.WitnessBin.Run(
      workdir: belt_observe_workdir,
      bin_path: ls.program as std.types.FilePath,
      args: ls.args,
      expect: OutcomeIsData,
    )
    if result.success {
      match classify_tmux_session_list(
        exit_ok: result.success,
        stdout: result.stdout,
        stderr: result.stderr,
      ) {
        TmuxSessionsListed { entries } =>
          match belt_attempt_panes_observe_for_instance(instance: instance) {
            BeltAttemptPanesObserved { panes } =>
              Observed {
                live: dispatch_live_sessions_with_process(
                  entries: entries,
                  panes: panes,
                  pane_observation_refusal: "",
                ),
              }
            BeltAttemptPanesRefused { reason } =>
              Observed {
                live: dispatch_live_sessions_with_process(
                  entries: entries,
                  panes: [],
                  pane_observation_refusal: reason,
                ),
              }
          }
        TmuxListStdoutRefused { line_number, raw, reason } =>
          ObserveRefused {
            reason: belt_ls_stdout_refusal_reason(
              line_number: line_number,
              raw: raw,
              reason: reason,
            ),
          }
        TmuxNoServer { evidence: _ } =>
          Observed { live: [] }
        TmuxListUnknowable { stderr: e } =>
          ObserveRefused {
            reason: concat(
              "belt_sessions_observe: tmux ls failed; session containers are unknowable. stderr: ",
              e,
            ),
          }
      }
    } else {
      match classify_tmux_session_list(
        exit_ok: result.success,
        stdout: result.stdout,
        stderr: result.stderr,
      ) {
        TmuxNoServer { evidence: _ } =>
          Observed { live: [] }
        TmuxSessionsListed { entries: _ } =>
          ObserveRefused {
            reason: concat(
              "belt_sessions_observe: tmux ls failed; session containers are unknowable. stderr: ",
              result.stderr,
            ),
          }
        TmuxListUnknowable { stderr: e } =>
          ObserveRefused {
            reason: concat(
              "belt_sessions_observe: tmux ls failed; session containers are unknowable. stderr: ",
              e,
            ),
          }
        TmuxListStdoutRefused { line_number, raw, reason } =>
          ObserveRefused {
            reason: belt_ls_stdout_refusal_reason(
              line_number: line_number,
              raw: raw,
              reason: reason,
            ),
          }
      }
    }
  } else {
    ObserveRefused {
      reason: "belt_sessions_observe: tmux not found; session containers are unknowable",
    }
  }
}

fn belt_sessions_observe() -> BeltObserve {
  belt_sessions_observe_for_instance(
    instance: srv1_live_dashboard_instance(),
  )
}

fn attempt_process_for_node(
  panes: BeltAttemptPanes,
  node_id: String,
) -> gunbc.worker_lifecycle.WorkerProcessEvidence {
  match panes {
    BeltAttemptPanesRefused { reason } =>
      WorkerProcessUnobserved { reason: reason as std.types.NonEmptyStr }
    BeltAttemptPanesObserved { panes: observed } => {
      let session_name = dispatch_tmux_session_name(
        node_id: node_id as gunbc.roadmap_model.RoadmapNodeId,
      )
      let matched = observed |> filter(pane =>
        pane.session_name == session_name)
      match matched.first() {
        Absent => WorkerProcessAbsent
        Present { value: pane } =>
          worker_process_from_attempt_pane(pane: pane)
      }
    }
  }
}

fn dispatch_attempt_ref_first_per_node(
  attempts: List<gunbc.roadmap_dispatch_actuator.DispatchAttemptRef>,
) -> List<gunbc.roadmap_dispatch_actuator.DispatchAttemptRef> {
  fold(attempts, init: [], f: fn(acc, attempt) {
    if any(acc, existing => existing.node_id == attempt.node_id) {
      acc
    } else {
      append(acc, [attempt])
    }
  })
}

fn belt_validation_summary_for_node(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  node_id: String,
) -> String {
  match belt_lookup_node(node_id: node_id) {
    AuthorityProjectionRefused { detail: _ } => ""
    NodeMissing => ""
    NodeFound { node } =>
      execution_contract_validation_summary(
        contract: node.execution,
        environment: instance.execution_environment,
      )
  }
}

type ProviderEventProjectionObservation
  = ProviderEventProjectionObserved { events: String }
  | ProviderEventProjectionRefused { reason: String }

fn belt_provider_event_projection_observe_for_instance(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  node_id: gunbc.roadmap_model.RoadmapNodeId,
) -> ProviderEventProjectionObservation {
  match belt_exec(
    cmd: dispatch_current_attempt_events_projection_argv_for_instance(
      instance: instance,
      node_id: node_id,
    ),
    workdir: instance.repo_root as String,
  ) {
    ExecOk { stdout } =>
      ProviderEventProjectionObserved { events: stdout }
    ExecFailed { program, exit_code, stderr } =>
      ProviderEventProjectionRefused {
        reason: join([
          "provider event projection failed through ",
          program,
          " (exit ",
          to_string(exit_code),
          "): ",
          stderr,
        ], ""),
      }
    ExecRefused { program, reason } =>
      ProviderEventProjectionRefused {
        reason: join([
          "provider event projection unavailable through ",
          program,
          ": ",
          reason,
        ], ""),
      }
  }
}

fn provider_event_projection_readable(
  observation: ProviderEventProjectionObservation,
) -> Bool {
  match observation {
    ProviderEventProjectionObserved { events: _ } => true
    ProviderEventProjectionRefused { reason: _ } => false
  }
}

fn provider_event_projection_events(
  observation: ProviderEventProjectionObservation,
) -> String {
  match observation {
    ProviderEventProjectionObserved { events } => events
    ProviderEventProjectionRefused { reason: _ } => ""
  }
}

fn provider_event_projection_error(
  observation: ProviderEventProjectionObservation,
) -> String {
  match observation {
    ProviderEventProjectionObserved { events: _ } => ""
    ProviderEventProjectionRefused { reason } => reason
  }
}

data belt_publication_receipt_read_note: String = "THE RECEIPT IS ADDRESSED BY HEAD, SO THERE IS NO PATH TO READ UNTIL THE HEAD IS KNOWN. That ordering is the point: the other receipts on this row live at one path per attempt and can be read before anything is decided, while a publication receipt is one per head, so the subject has to exist before the address does.\\n\\nTHE UNOBSERVED ARM ANSWERS ReceiptSourceAbsent AND THAT IS NOT A FABRICATED ABSENCE. publication_segment refuses on an unobserved subject before it consults the source at all, so this value never reaches a judgment; it exists because the evidence record carries a source for every stage and there is no address to consult for this one. If the projection ever stopped refusing first, this would become a real answer - which is why the refusal there is matched on the subject rather than inferred here.\\n\\nEVERY OTHER ARM ESTABLISHES ITS ANSWER POSITIVELY - see publication_receipt_absence_is_established_note. No arm of this walk turns a failure into an absence, which is the whole difference between it and the read it replaced."

data listing_membership_is_line_exact_note: String = "Filesystem.List returns entry names joined by newlines, so a plain substring test would answer yes for a name that is merely a PREFIX or suffix of a real entry - `abc.json` would be found inside `abc.json.tmp`, and a head sha would be found inside a longer one. Wrapping both sides in newlines makes the test line-exact without needing a split the interpreter does not offer, and every conclusion drawn from it is a membership fact rather than a coincidence of spelling."

fn belt_listing_names_entry(listing: String, name: String) -> Bool {
  string_contains(
    s: join(["\n", listing, "\n"], ""),
    pattern: join(["\n", name, "\n"], ""),
  )
}

data publication_receipt_absence_is_established_note: String = "ABSENCE IS ESTABLISHED BY A SUCCESSFUL LISTING, NEVER BY A FAILED READ (review 46148). Filesystem.Read answers success=false both for a receipt that does not exist and for one that exists and cannot be read, and those two worlds have opposite correct actions - observe and write, versus stop and preserve. This walk therefore never concludes absence from a failure of any kind.\\n\\nTHE LADDER STARTS AT A DIRECTORY THAT IS KNOWN TO EXIST, which is what makes each step decidable. The attempt state directory is created by dispatch when the attempt starts, and this producer only runs for an attempt whose worktree head it has already read, so a failure to list THAT directory is unambiguously a fault rather than a not-yet. From there each answer is positive: the publication directory is absent from a listing that succeeded, or the head's own file is absent from a listing that succeeded. Only when the file is listed does a read happen, and a read that then fails is unambiguously a fault because the entry was just observed to exist.\\n\\nWHAT THIS DELIBERATELY DOES NOT DO is widen on doubt. Every failure arm returns ReceiptSourceUnreadable carrying the path and the host error, which the gate turns into a typed, located, counted refusal that halts the row - it never falls back to `treat it as absent and rewrite`, which is the absorbing fallback DESIGN section 5 forbids and precisely the defect this replaced."

fn belt_publication_receipt_source(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  node_id: gunbc.roadmap_model.RoadmapNodeId,
  attempt_key: String,
  subject: gunbc.roadmap_publish.PublicationSubjectObservation,
) -> gunbc.roadmap_publish.PublicationReceiptSource {
  match subject {
    PublicationSubjectUnobserved { reason: _ } => ReceiptSourceAbsent
    PublicationSubjectObserved { subject: observed } => {
      let attempt_dir = dispatch_attempt_state_path_for_instance(
        instance: instance,
        node_id: node_id,
        attempt_key: attempt_key,
      )
      let attempt_listing = Filesystem.List(path: attempt_dir)
      if !attempt_listing.success {
        ReceiptSourceUnreadable {
          detail: join([
            "the attempt state directory could not be listed, so whether a publication receipt exists was not established: ",
            attempt_dir,
            " (",
            attempt_listing.error,
            ")",
          ], ""),
        }
      } else if !belt_listing_names_entry(
        listing: attempt_listing.entries,
        name: publication_receipt_directory_segment,
      ) {
        ReceiptSourceAbsent
      } else {
        let publication_dir = dispatch_attempt_publication_dir_for_instance(
          instance: instance,
          node_id: node_id,
          attempt_key: attempt_key,
        )
        let publication_listing = Filesystem.List(path: publication_dir)
        if !publication_listing.success {
          ReceiptSourceUnreadable {
            detail: join([
              "the publication receipt directory was named by the attempt listing but could not itself be listed: ",
              publication_dir,
              " (",
              publication_listing.error,
              ")",
            ], ""),
          }
        } else if !belt_listing_names_entry(
          listing: publication_listing.entries,
          name: join([observed.expected_head as String, ".json"], ""),
        ) {
          ReceiptSourceAbsent
        } else {
          let path = dispatch_attempt_publication_receipt_path_for_instance(
            instance: instance,
            node_id: node_id,
            attempt_key: attempt_key,
            head_sha: observed.expected_head as String,
          )
          let read = Filesystem.Read(path: path)
          if read.success {
            ReceiptSourcePresent { text: read.content }
          } else {
            ReceiptSourceUnreadable {
              detail: join([
                "a publication receipt for this head was listed and then could not be read, so it exists and its content is unavailable: ",
                path,
                " (",
                read.error,
                ")",
              ], ""),
            }
          }
        }
      }
    }
  }
}

fn belt_publish_current_verification_selection(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  node_id: gunbc.roadmap_model.RoadmapNodeId,
  attempt_key: String,
  subject: gunbc.roadmap_verification_receipt.VerificationSubject,
) -> gunbc.roadmap_verification_receipt.VerificationSelectionPublishOutcome {
  let path = dispatch_attempt_verification_current_selection_path_for_instance(
    instance: instance,
    node_id: node_id,
    attempt_key: attempt_key,
    head_sha: subject.head_sha as String,
  )
  let write = Filesystem.Write(
    path: path,
    content: current_verification_selection_json(
      selection: gunbc.roadmap_verification_receipt.CurrentVerificationSelection {
        head_sha: subject.head_sha,
        change_window_identity: subject.change_window_identity,
      },
    ),
  )
  if write.success {
    VerificationSelectionPublished { path: path }
  } else {
    VerificationSelectionPublishRefused {
      path: path,
      cause: join([
        "the belt could not publish the current verification selection: ",
        write.error,
      ], ""),
    }
  }
}

fn belt_verification_selection_observe(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  node_id: gunbc.roadmap_model.RoadmapNodeId,
  attempt_key: String,
  head_sha: String,
) -> gunbc.roadmap_verification_receipt.CurrentVerificationSelectionObservation {
  current_verification_selection_observe(
    attempt_dir: dispatch_attempt_state_path_for_instance(
      instance: instance,
      node_id: node_id,
      attempt_key: attempt_key,
    ),
    verification_dir: dispatch_attempt_verification_dir_for_instance(
      instance: instance,
      node_id: node_id,
      attempt_key: attempt_key,
    ),
    head_sha: head_sha,
  )
}

fn belt_verification_subject_from_selection(
  node: gunbc.roadmap_model.RoadmapNode,
  attempt_key: String,
  branch: String,
  head: std.types.CommitSha,
  selection: gunbc.roadmap_verification_receipt.CurrentVerificationSelectionObservation,
) -> gunbc.roadmap_verification_receipt.VerificationSubjectObservation {
  match selection {
    SelectionUnaddressable { cause } =>
      VerificationSubjectUnobserved { reason: cause }
    SelectionAbsent =>
      VerificationSubjectUnobserved {
        reason: "the belt has not selected a verification window for this head yet",
      }
    SelectionUnreadable { cause } =>
      VerificationSubjectUnobserved { reason: cause }
    SelectionMalformed { cause } =>
      VerificationSubjectUnobserved { reason: cause }
    SelectionObserved { head: selected_head, window_identity } =>
      if (selected_head as String) != (head as String) {
        VerificationSubjectUnobserved {
          reason: join([
            "the current verification selection names head ",
            selected_head as String,
            " but the worktree head is ",
            head as String,
          ], ""),
        }
      } else {
        match node_criteria_digest(rn: node) {
          Absent =>
            VerificationSubjectUnobserved {
              reason: "this roadmap node has no criteria digest, so the verification subject cannot be constructed",
            }
          Present { value: criteria_digest } =>
            VerificationSubjectObserved {
              subject: gunbc.roadmap_verification_receipt.VerificationSubject {
                node_identity: node.identity,
                criteria_digest: criteria_digest,
                attempt_key: attempt_key,
                branch: branch as std.types.NonEmptyStr,
                head_sha: head,
                change_window_identity: window_identity,
              },
            }
        }
      }
  }
}

fn belt_verification_receipt_source_for_selection(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  node_id: gunbc.roadmap_model.RoadmapNodeId,
  attempt_key: String,
  head_sha: String,
  window_identity_hex: String,
) -> gunbc.roadmap_verification_receipt.VerificationReceiptFileSource {
  let address = exact_verification_address_for(
    attempt_dir: dispatch_attempt_state_path_for_instance(
      instance: instance,
      node_id: node_id,
      attempt_key: attempt_key,
    ),
    verification_dir: dispatch_attempt_verification_dir_for_instance(
      instance: instance,
      node_id: node_id,
      attempt_key: attempt_key,
    ),
    head_sha: head_sha,
    window_identity_hex: window_identity_hex,
  )
  verification_receipt_file_source_from_exact(
    source: exact_verification_receipt_source_read(
      attempt_dir: address.attempt_dir,
      verification_dir: address.verification_dir,
      receipt_basename: address.receipt_basename,
    ),
  )
}

fn belt_verification_receipt_source(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  node_id: gunbc.roadmap_model.RoadmapNodeId,
  attempt_key: String,
  selection: gunbc.roadmap_verification_receipt.CurrentVerificationSelectionObservation,
) -> gunbc.roadmap_verification_receipt.VerificationReceiptFileSource {
  match selection {
    SelectionUnaddressable { cause } =>
      VerificationReceiptUnreadable {
        detail: join([
          "the worktree head could not be observed, so the exact receipt path was not established: ",
          cause,
        ], ""),
      }
    SelectionAbsent => VerificationReceiptAbsent
    SelectionUnreadable { cause } =>
      VerificationReceiptUnreadable {
        detail: join([
          "the current verification selection could not be read, so the exact receipt path was not established: ",
          cause,
        ], ""),
      }
    SelectionMalformed { cause } =>
      VerificationReceiptUnreadable {
        detail: join([
          "the current verification selection is malformed, so the exact receipt path was not established: ",
          cause,
        ], ""),
      }
    SelectionObserved { head, window_identity } =>
      belt_verification_receipt_source_for_selection(
        instance: instance,
        node_id: node_id,
        attempt_key: attempt_key,
        head_sha: head as String,
        window_identity_hex: window_identity.digest as String,
      )
  }
}

fn belt_workflow_progress_for_attempt_ref(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  panes: BeltAttemptPanes,
  attempt: gunbc.roadmap_dispatch_actuator.DispatchAttemptRef,
) -> gunbc.roadmap_workflow_progress.WorkflowAttemptProgress {
  let key_read = Filesystem.Read(
    path: dispatch_current_attempt_key_path_for_instance(
      instance: instance,
      node_id: attempt.node_id as gunbc.roadmap_model.RoadmapNodeId,
    ),
  )
  if !key_read.success || trim(key_read.content) == "" {
    workflow_attempt_progress(evidence: gunbc.roadmap_workflow_progress.WorkflowAttemptEvidence {
      node_id: attempt.node_id,
      attempt_key: attempt.attempt_key,
      branch: attempt.branch,
      modeled_state_present: false,
      admission_receipt_readable: false,
      admission_receipt: "",
      spawn_failure_present: false,
      spawn_failure: "",
      provider_events_readable: false,
      provider_events: "",
      provider_events_error: key_read.error,
      process: attempt_process_for_node(
        panes: panes,
        node_id: attempt.node_id,
      ),
      validation_summary: belt_validation_summary_for_node(
        instance: instance,
        node_id: attempt.node_id,
      ),
      verification_subject: VerificationSubjectUnobserved {
        reason: "this attempt has no modeled state pointer, so neither its attempt key nor its head is established",
      },
      verification_selection: SelectionAbsent,
      verification_source: VerificationReceiptAbsent,
      publication_subject: PublicationSubjectUnobserved {
        reason: "this attempt has no modeled state pointer, so neither its attempt key nor its head is established",
      },
      publication_source: ReceiptSourceAbsent,
    })
  } else {
    let current_key = trim(key_read.content)
    let node_id = attempt.node_id as gunbc.roadmap_model.RoadmapNodeId
    let admission = Filesystem.Read(
      path: dispatch_current_attempt_admission_path_for_instance(
        instance: instance,
        node_id: node_id,
      ),
    )
    let events = belt_provider_event_projection_observe_for_instance(
      instance: instance,
      node_id: node_id,
    )
    let spawn_failure = Filesystem.Read(
      path: dispatch_current_attempt_spawn_failure_path_for_instance(
        instance: instance,
        node_id: node_id,
      ),
    )
    let branch = dispatch_branch_name(
      node_id: node_id,
      attempt_key: current_key,
    )
    let worktree = dispatch_worktree_path_for_instance(
      instance: instance,
      node_id: node_id,
      attempt_key: current_key,
    )
    let head = belt_worktree_head_observe(
      instance: instance,
      worktree: worktree,
    )
    let publication_subject = belt_publication_subject_for(
      node_id: attempt.node_id,
      attempt_key: current_key,
      branch: branch,
      head: head,
    )
    let verification_selection = match head {
      WorktreeHeadUnobserved { reason } =>
        SelectionUnaddressable { cause: reason }
      WorktreeHeadObserved { revision: revision } =>
        belt_verification_selection_observe(
          instance: instance,
          node_id: node_id,
          attempt_key: current_key,
          head_sha: revision as String,
        )
    }
    let verification_subject = match belt_lookup_node(node_id: attempt.node_id) {
      AuthorityProjectionRefused { detail: detail } =>
        VerificationSubjectUnobserved {
          reason: concat("roadmap authority projection refused: ", detail),
        }
      NodeMissing =>
        VerificationSubjectUnobserved {
          reason: "the roadmap authority declares no node with this id, so there is no verification subject",
        }
      NodeFound { node } =>
        match head {
          WorktreeHeadUnobserved { reason } =>
            VerificationSubjectUnobserved { reason: reason }
          WorktreeHeadObserved { revision: revision } =>
            if trim(branch) == "" {
              VerificationSubjectUnobserved {
                reason: "the attempt has no branch name, so there is no verification subject to construct",
              }
            } else {
              belt_verification_subject_from_selection(
                node: node,
                attempt_key: current_key,
                branch: branch,
                head: revision as std.types.CommitSha,
                selection: verification_selection,
              )
            }
        }
    }
    let publication_receipt = belt_publication_receipt_source(
      instance: instance,
      node_id: node_id,
      attempt_key: current_key,
      subject: publication_subject,
    )
    workflow_attempt_progress(evidence: gunbc.roadmap_workflow_progress.WorkflowAttemptEvidence {
      node_id: attempt.node_id,
      attempt_key: current_key,
      branch: dispatch_branch_name(
        node_id: node_id,
        attempt_key: current_key,
      ),
      modeled_state_present: true,
      admission_receipt_readable: admission.success,
      admission_receipt: admission.content,
      spawn_failure_present: spawn_failure.success,
      spawn_failure: spawn_failure.content,
      provider_events_readable: provider_event_projection_readable(
        observation: events,
      ),
      provider_events: provider_event_projection_events(
        observation: events,
      ),
      provider_events_error: provider_event_projection_error(
        observation: events,
      ),
      process: attempt_process_for_node(
        panes: panes,
        node_id: attempt.node_id,
      ),
      validation_summary: belt_validation_summary_for_node(
        instance: instance,
        node_id: attempt.node_id,
      ),
      verification_subject: verification_subject,
      verification_selection: verification_selection,
      verification_source: belt_verification_receipt_source(
        instance: instance,
        node_id: node_id,
        attempt_key: current_key,
        selection: verification_selection,
      ),
      publication_subject: publication_subject,
      publication_source: publication_receipt,
    })
  }
}

data belt_verify_pass_note: String = "The workflow's own verification actuation, and the reason it lives on the belt rather than in the /workflow.json handler: running a declared validation is an EFFECT that takes as long as the validation takes, while the progress route is a synchronous read that the browser polls every two seconds. Producing the verdict on the read path would make the lamp's own observation the thing that runs cargo. So the belt produces the receipt and the projection reads it — the same split the environment-admission receipt already uses, and the reason Verify can move without the observer changing shape. Idempotence comes from the receipt's presence, exactly as spawn idempotence comes from the observed session: a recorded verdict is not recomputed, so re-ticking neither re-runs the validation nor overwrites a verdict with a later one taken against a tree the agent has since touched. Agent completion is read from the reconciled provider state, so a turn that completed while its pane still runs, or completed with a nonzero exit, does not reach verification at all — the obligation order is preserved rather than restated."

data belt_verification_detached_checkout_note: String = "Validations run in a detached checkout of the observed head, never in the mutable implementation worktree. The checkout path is head-addressed and idempotent: an existing tree at the same revision is reused; a tree at a different revision refuses rather than validating the wrong commit."

type BeltVerifyOutcome
  = VerifyDeferred { node_id: String, reason: String }
  | VerifyRecorded {
      node_id: String,
      verdict_key: String,
      detail: String,
    }
  | VerifyWriteFailed { node_id: String, detail: String }
  | VerifyEvidenceUnreadable { node_id: String, detail: String }
  | VerifyRefused { node_id: String, cause: String }

data belt_read_or_empty_scope_note: String = "review 45271, and the scope of this collapse is now deliberate rather than incidental. Reducing a read to `\"\"` conflates absent with unreadable, which is only safe where BOTH branches take the same action. That holds for the PIN reads below — an absent identity and an unreadable one both leave pin_recorded false, and the gate refuses either way, actuating nothing — so the distinction would change the message and not the behaviour. It did NOT hold for the receipt-presence read, which gated whether to RUN the validation and OVERWRITE the evidence: there, absent means run and unreadable means stop, so the collapse let an I/O fault regenerate a verdict against a worktree that may have moved. That seam no longer uses this function; it reads with status preserved and decodes."

fn belt_read_or_empty(path: String) -> String {
  let read = Filesystem.Read(path: path)
  if read.success { trim(read.content) } else { "" }
}

type BeltValidationRun {
  executions: List<gunbc.roadmap_verification_receipt.ValidationExecution>
  verdict: gunbc.roadmap_validation_oracle.ValidationVerdict
}

data belt_diff_window_producer_note: String = "Roadmap verification produces a GitExactDiffWindow with a derived window_identity immediately before gunbc-claim validation. The belt observes target_generation via rev-parse and merge-base(head, target_generation) in the detached verification checkout, writes the receipt at verification/<head>.<window_identity>.diff-window.json, and binds GUNBC_DIFF_WINDOW_PATH only for validations that consume an affected-set window."

fn git_target_generation_observation_of(outcome: BeltExecOutcome) -> gunbc.git_diff_change_window.GitTargetGenerationObservation {
  match outcome {
    ExecOk { stdout } =>
      match git_object_id_from_untagged_hex(hex: trim(stdout)) {
        Absent =>
          GitTargetGenerationOutputMalformed { stdout: trim(stdout) }
        Present { value: generation } =>
          GitTargetGenerationObserved { generation: generation }
      }
    ExecFailed { program, exit_code, stderr } =>
      GitTargetGenerationExecutionFailed {
        program: program,
        exit_code: exit_code,
        stdout: "",
        stderr: stderr,
      }
    ExecRefused { program, reason } =>
      GitTargetGenerationProgramUnavailable { program: program, reason: reason }
  }
}

fn git_merge_base_observation_of(
  outcome: BeltExecOutcome,
  target: std.types.GitRef,
  target_generation: extdeps.git.object_store.GitObjectId,
  head: extdeps.git.object_store.GitObjectId,
) -> gunbc.git_diff_change_window.GitMergeBaseObservation {
  match outcome {
    ExecOk { stdout } =>
      match git_object_id_from_untagged_hex(hex: trim(stdout)) {
        Absent =>
          GitMergeBaseOutputMalformed { stdout: trim(stdout) }
        Present { value: base } =>
          GitMergeBaseObserved {
            target: target,
            target_generation: target_generation,
            base: base,
            head: head,
          }
      }
    ExecFailed { program, exit_code, stderr } =>
      GitMergeBaseExecutionFailed {
        program: program,
        exit_code: exit_code,
        stdout: "",
        stderr: stderr,
      }
    ExecRefused { program, reason } =>
      GitMergeBaseProgramUnavailable { program: program, reason: reason }
  }
}

fn belt_observe_target_generation(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  worktree: String,
  target: std.types.GitRef,
) -> gunbc.git_diff_change_window.GitTargetGenerationObservation {
  git_target_generation_observation_of(
    outcome: belt_exec(
      cmd: host_exec_argv(
        program: dispatch_capability_program(
          environment: instance.execution_environment,
          cap: GitWorkspaceCapability,
        ),
        args: ["rev-parse", target as String],
      ),
      workdir: worktree,
    ),
  )
}

fn belt_observe_merge_base(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  worktree: String,
  head_sha: String,
  target_generation_hex: String,
) -> BeltExecOutcome {
  belt_exec(
    cmd: host_exec_argv(
      program: dispatch_capability_program(
        environment: instance.execution_environment,
        cap: GitWorkspaceCapability,
      ),
      args: ["merge-base", head_sha, target_generation_hex],
    ),
    workdir: worktree,
  )
}

fn belt_prepare_diff_window_for_verification(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  node_id: gunbc.roadmap_model.RoadmapNodeId,
  attempt_key: String,
  subject: gunbc.roadmap_verification_receipt.VerificationSubject,
  worktree: String,
) -> gunbc.git_diff_change_window.GitDiffWindowPrepareOutcome {
  let head_sha = subject.head_sha as String
  let target = instance.dispatch_base_ref
  match git_object_id_from_untagged_hex(hex: head_sha) {
    Absent =>
      GitDiffWindowPrepareRefused {
        cause: ChangeWindowHeadObjectIdRefused { head_hex: head_sha },
      }
    Present { value: head } =>
      match belt_observe_target_generation(
        instance: instance,
        worktree: worktree,
        target: target,
      ) {
        GitTargetGenerationObserved { generation: target_generation } =>
          match git_merge_base_observation_of(
            outcome: belt_observe_merge_base(
              instance: instance,
              worktree: worktree,
              head_sha: head_sha,
              target_generation_hex: git_object_id_wire_hex(oid: target_generation) as String,
            ),
            target: target,
            target_generation: target_generation,
            head: head,
          ) {
            GitMergeBaseObserved {
              target: observed_target,
              target_generation: observed_generation,
              base: base,
              head: observed_head,
            } =>
              let window = git_exact_diff_window_for_verification(
                target: observed_target,
                target_generation: observed_generation,
                base: base,
                head: observed_head,
              )
              let identity_hex = git_diff_window_identity_hex(
                identity: window.window_identity,
              )
              let path = dispatch_attempt_diff_window_path_for_instance(
                instance: instance,
                node_id: node_id,
                attempt_key: attempt_key,
                head_sha: head_sha,
                window_identity_hex: identity_hex,
              )
              let write = Filesystem.Write(
                path: path,
                content: git_diff_window_json(window: window),
              )
              if write.success {
                GitDiffWindowPrepared { path: path, window: window }
              } else {
                GitDiffWindowPrepareRefused {
                  cause: ChangeWindowPersistenceRefused {
                    path: path,
                    cause: write.error,
                  },
                }
              }
            GitMergeBaseProgramUnavailable { program: program, reason: reason } =>
              GitDiffWindowPrepareRefused {
                cause: ChangeWindowMergeBaseRefused {
                  observation: GitMergeBaseProgramUnavailable { program: program, reason: reason },
                },
              }
            GitMergeBaseExecutionFailed { program: program, exit_code: exit_code, stdout: stdout, stderr: stderr } =>
              GitDiffWindowPrepareRefused {
                cause: ChangeWindowMergeBaseRefused {
                  observation: GitMergeBaseExecutionFailed {
                    program: program,
                    exit_code: exit_code,
                    stdout: stdout,
                    stderr: stderr,
                  },
                },
              }
            GitMergeBaseOutputMalformed { stdout: stdout } =>
              GitDiffWindowPrepareRefused {
                cause: ChangeWindowMergeBaseRefused {
                  observation: GitMergeBaseOutputMalformed { stdout: stdout },
                },
              }
          }
        GitTargetGenerationProgramUnavailable { program: program, reason: reason } =>
          GitDiffWindowPrepareRefused {
            cause: ChangeWindowTargetGenerationRefused {
              observation: GitTargetGenerationProgramUnavailable { program: program, reason: reason },
            },
          }
        GitTargetGenerationExecutionFailed { program: program, exit_code: exit_code, stdout: stdout, stderr: stderr } =>
          GitDiffWindowPrepareRefused {
            cause: ChangeWindowTargetGenerationRefused {
              observation: GitTargetGenerationExecutionFailed {
                program: program,
                exit_code: exit_code,
                stdout: stdout,
                stderr: stderr,
              },
            },
          }
        GitTargetGenerationOutputMalformed { stdout: stdout } =>
          GitDiffWindowPrepareRefused {
            cause: ChangeWindowTargetGenerationRefused {
              observation: GitTargetGenerationOutputMalformed { stdout: stdout },
            },
          }
      }
  }
}

fn belt_verification_subject_with_window(
  subject: gunbc.roadmap_verification_receipt.VerificationSubject,
  window_identity: std.content_hash.Fnv1a64Structural,
) -> gunbc.roadmap_verification_receipt.VerificationSubject {
  gunbc.roadmap_verification_receipt.VerificationSubject {
    node_identity: subject.node_identity,
    criteria_digest: subject.criteria_digest,
    attempt_key: subject.attempt_key,
    branch: subject.branch,
    head_sha: subject.head_sha,
    change_window_identity: window_identity,
  }
}

fn belt_exec_with_diff_window_env(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  cmd: gunbc.roadmap_dispatch_actuator.HostExecArgv,
  workdir: String,
  diff_window_path: String,
) -> BeltExecOutcome {
  belt_exec(
    cmd: host_exec_argv(
      program: dispatch_capability_program(
        environment: instance.execution_environment,
        cap: EnvironmentBindingCapability,
      ),
      args: concat(
        [git_diff_window_env_assignment(path: diff_window_path)],
        concat([cmd.program], cmd.args),
      ),
    ),
    workdir: workdir,
  )
}

fn belt_run_validation_operations(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  validations: List<gunbc.roadmap_execution_contract.ValidationOperation>,
  worktree: String,
  oracle_identity: std.content_hash.ContentHash,
  diff_window_path: String?,
) -> BeltValidationRun {
  fold(
    validations,
    init: BeltValidationRun {
      executions: [],
      verdict: ValidationPassed {
        command: "",
        oracle_identity: oracle_identity,
      },
    },
    f: fn(acc, validation) {
      match acc.verdict {
        ValidationNotRun => acc
        ValidationFailed { command: _, exit_code: _, detail: _ } => acc
        ValidationRefused { cause: _ } => acc
        ValidationPassed { command: prior, oracle_identity: _ } =>
          match validation_operation_command(
            validation: validation,
            environment: instance.execution_environment,
          ) {
            Absent =>
              BeltValidationRun {
                executions: acc.executions,
                verdict: ValidationRefused { cause: ValidationCommandUnrealized },
              }
            Present { value: command } => {
              let wire = modeled_validation_command_wire(command: command)
              let exec_outcome = if validation_consumes_affected_set_window(
                validation: validation,
              ) {
                match diff_window_path {
                  Present { value: path } =>
                    if path == "" {
                      ExecRefused {
                        program: "gunbc-diff-window",
                        reason: "verification requires an affected-set diff window path but the prepared path is empty",
                      }
                    } else {
                      belt_exec_with_diff_window_env(
                        instance: instance,
                        cmd: host_exec_argv(
                          program: command.program as String,
                          args: command.args,
                        ),
                        workdir: worktree,
                        diff_window_path: path,
                      )
                    }
                  Absent =>
                    ExecRefused {
                      program: "gunbc-diff-window",
                      reason: "verification requires an affected-set diff window path but none was prepared",
                    }
                }
              } else {
                belt_exec(
                  cmd: host_exec_argv(
                    program: command.program as String,
                    args: command.args,
                  ),
                  workdir: worktree,
                )
              }
              match exec_outcome {
                ExecOk { stdout } =>
                  BeltValidationRun {
                    executions: acc.executions |> append(gunbc.roadmap_verification_receipt.ValidationExecution {
                      validation: validation,
                      command: command,
                      exit_code: 0,
                      stdout: stdout,
                      stderr: "",
                    }),
                    verdict: ValidationPassed {
                      command: if prior == "" {
                        wire
                      } else {
                        join([prior, "; ", wire], "")
                      },
                      oracle_identity: oracle_identity,
                    },
                  }
                ExecFailed { program: _, exit_code, stderr } =>
                  BeltValidationRun {
                    executions: acc.executions |> append(gunbc.roadmap_verification_receipt.ValidationExecution {
                      validation: validation,
                      command: command,
                      exit_code: exit_code,
                      stdout: "",
                      stderr: stderr,
                    }),
                    verdict: ValidationFailed {
                      command: wire,
                      exit_code: exit_code,
                      detail: stderr,
                    },
                  }
                ExecRefused { program, reason } =>
                  BeltValidationRun {
                    executions: acc.executions,
                    verdict: ValidationRefused {
                      cause: if program == "gunbc-diff-window" {
                        ValidationChangeWindowRefused {
                          cause: ChangeWindowPersistenceRefused {
                            path: "",
                            cause: reason,
                          },
                        }
                      } else {
                        ValidationCommandRefused {
                          program: program,
                          reason: reason,
                        }
                      },
                    },
                  }
              }
            }
          }
      }
    },
  )
}

fn belt_verify_attempt_for_instance(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  progress: gunbc.roadmap_workflow_progress.WorkflowAttemptProgress,
) -> BeltVerifyOutcome {
  let node_id = progress.node_id as gunbc.roadmap_model.RoadmapNodeId
  match progress.provider {
    ProviderCompleted { activity: _ } =>
      match belt_lookup_node(node_id: progress.node_id) {
        AuthorityProjectionRefused { detail: detail } =>
          VerifyDeferred {
            node_id: progress.node_id,
            reason: concat("roadmap authority projection refused: ", detail),
          }
        NodeMissing =>
          VerifyDeferred {
            node_id: progress.node_id,
            reason: "the roadmap authority declares no node with this id, so there is no contract to verify against",
          }
        NodeFound { node } => {
          let branch = dispatch_branch_name(
            node_id: node_id,
            attempt_key: progress.attempt_key,
          )
          if trim(branch) == "" {
            VerifyDeferred {
              node_id: progress.node_id,
              reason: "the attempt has no branch name, so there is no verification subject to construct",
            }
          } else {
            let attempt_worktree = dispatch_worktree_path_for_instance(
              instance: instance,
              node_id: node_id,
              attempt_key: progress.attempt_key,
            )
            match belt_worktree_head_observe(
              instance: instance,
              worktree: attempt_worktree,
            ) {
              WorktreeHeadUnobserved { reason } =>
                VerifyDeferred { node_id: progress.node_id, reason: reason }
              WorktreeHeadObserved { revision: revision } => {
                let head_sha = revision as String
                let worktree = belt_verify_detached_worktree(
                  instance: instance,
                  node_id: node_id,
                  attempt_key: progress.attempt_key,
                  head_sha: head_sha,
                )
                match node_criteria_digest(rn: node) {
                  Absent =>
                    VerifyDeferred {
                      node_id: progress.node_id,
                      reason: "this roadmap node has no criteria digest, so the verification subject cannot be constructed",
                    }
                  Present { value: criteria_digest } => {
                    let partial_subject = gunbc.roadmap_verification_receipt.VerificationSubject {
                      node_identity: node.identity,
                      criteria_digest: criteria_digest,
                      attempt_key: progress.attempt_key,
                      branch: branch as std.types.NonEmptyStr,
                      head_sha: revision as std.types.CommitSha,
                      change_window_identity: git_diff_window_absent_identity(),
                    }
                    let prepared_window = if worktree != ""
                      && execution_contract_needs_diff_window(contract: node.execution) {
                      Present {
                        value: belt_prepare_diff_window_for_verification(
                          instance: instance,
                          node_id: node_id,
                          attempt_key: progress.attempt_key,
                          subject: partial_subject,
                          worktree: worktree,
                        ),
                      }
                    } else {
                      none
                    }
                    let subject = match prepared_window {
                      Present { value: GitDiffWindowPrepared { path: _, window: window } } =>
                        belt_verification_subject_with_window(
                          subject: partial_subject,
                          window_identity: window.window_identity,
                        )
                      Present { value: GitDiffWindowPrepareRefused { cause: _ } } =>
                        partial_subject
                      Absent => partial_subject
                    }
                    let identity_hex = git_diff_window_identity_hex(
                      identity: subject.change_window_identity,
                    )
                    let address = exact_verification_address_for(
                      attempt_dir: dispatch_attempt_state_path_for_instance(
                        instance: instance,
                        node_id: node_id,
                        attempt_key: progress.attempt_key,
                      ),
                      verification_dir: dispatch_attempt_verification_dir_for_instance(
                        instance: instance,
                        node_id: node_id,
                        attempt_key: progress.attempt_key,
                      ),
                      head_sha: head_sha,
                      window_identity_hex: identity_hex,
                    )
                    match belt_publish_current_verification_selection(
                      instance: instance,
                      node_id: node_id,
                      attempt_key: progress.attempt_key,
                      subject: subject,
                    ) {
                      VerificationSelectionPublishRefused { path: _, cause } =>
                        VerifyRefused {
                          node_id: progress.node_id,
                          cause: join([
                            "verification refused before running because the current selection could not be published: ",
                            cause,
                          ], ""),
                        }
                      VerificationSelectionPublished { path: _ } => {
                        let exact_source = exact_verification_receipt_source_read(
                          attempt_dir: address.attempt_dir,
                          verification_dir: address.verification_dir,
                          receipt_basename: address.receipt_basename,
                        )
                        match belt_verification_decision(
                          expected: subject,
                          source: exact_source,
                        ) {
                          BeltVerificationEvidenceUnreadable { reason } =>
                            VerifyEvidenceUnreadable {
                              node_id: progress.node_id,
                              detail: reason,
                            }
                          BeltVerificationRefuse { reason } =>
                            VerifyRefused {
                              node_id: progress.node_id,
                              cause: reason,
                            }
                          BeltVerificationDefer { reason } =>
                            VerifyDeferred {
                              node_id: progress.node_id,
                              reason: reason,
                            }
                          BeltVerificationRun =>
                            belt_verify_run_and_persist(
                              instance: instance,
                              node: node,
                              progress: progress,
                              subject: subject,
                              diff_window_path: if execution_contract_needs_diff_window(
                                contract: node.execution,
                              ) {
                                Present {
                                  value: dispatch_attempt_diff_window_path_for_instance(
                                    instance: instance,
                                    node_id: node_id,
                                    attempt_key: progress.attempt_key,
                                    head_sha: head_sha,
                                    window_identity_hex: identity_hex,
                                  ),
                                }
                              } else {
                                none
                              },
                              change_window_refusal: match prepared_window {
                                Present {
                                  value: GitDiffWindowPrepareRefused { cause: cause },
                                } =>
                                  Present { value: cause }
                                _ => none
                              },
                            )
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    _ =>
      VerifyDeferred {
        node_id: progress.node_id,
        reason: "the agent obligation is not satisfied, so there is nothing to verify yet",
      }
  }
}

fn belt_verify_run_and_persist(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  node: gunbc.roadmap_model.RoadmapNode,
  progress: gunbc.roadmap_workflow_progress.WorkflowAttemptProgress,
  subject: gunbc.roadmap_verification_receipt.VerificationSubject,
  diff_window_path: String?,
  change_window_refusal: gunbc.git_diff_change_window.ChangeWindowPreparationRefusal?,
) -> BeltVerifyOutcome {
  let node_id = progress.node_id as gunbc.roadmap_model.RoadmapNodeId
  let identity_hex = git_diff_window_identity_hex(
    identity: subject.change_window_identity,
  )
  let receipt_path = dispatch_attempt_verification_receipt_path_for_instance(
    instance: instance,
    node_id: node_id,
    attempt_key: progress.attempt_key,
    head_sha: subject.head_sha as String,
    window_identity_hex: identity_hex,
  )
  let worktree = belt_verify_detached_worktree(
    instance: instance,
    node_id: node_id,
    attempt_key: progress.attempt_key,
    head_sha: subject.head_sha as String,
  )
  let pinned_identity_wire = belt_read_or_empty(
    path: dispatch_current_attempt_oracle_identity_path_for_instance(
      instance: instance,
      node_id: node_id,
    ),
  )
  let pinned_revision_wire = belt_read_or_empty(
    path: dispatch_current_attempt_oracle_revision_path_for_instance(
      instance: instance,
      node_id: node_id,
    ),
  )
  let pinned_identity = validation_oracle_parse_pinned_identity_wire(
    text: pinned_identity_wire,
  )
  let pinned_revision = validation_oracle_parse_pinned_revision_wire(
    text: pinned_revision_wire,
  )
  let pin_refusal = belt_read_or_empty(
    path: dispatch_current_attempt_oracle_pin_refusal_path_for_instance(
      instance: instance,
      node_id: node_id,
    ),
  )
  let pin_recorded = validation_oracle_pin_recorded(
    identity: pinned_identity,
    revision: pinned_revision,
  )
  if worktree == "" {
    let run = BeltValidationRun {
      executions: [],
      verdict: ValidationRefused {
        cause: ValidationCommandRefused {
          program: "git",
          reason: belt_verify_detached_worktree_refusal(
            instance: instance,
            node_id: node_id,
            attempt_key: progress.attempt_key,
            head_sha: subject.head_sha as String,
          ),
        },
      },
    }
    let receipt = gunbc.roadmap_verification_receipt.VerificationReceipt {
      subject: subject,
      oracle_identity: match pinned_identity {
        Present { value: identity } => identity
        Absent =>
          as_content_hash_structural(
            structural: content_hash_atom(value: "oracle-pin-unreadable")
          )
      },
      executions: run.executions,
      verdict: run.verdict,
    }
    let write = Filesystem.Write(
      path: receipt_path,
      content: verification_receipt_json(receipt: receipt),
    )
    if write.success {
      VerifyRecorded {
        node_id: progress.node_id,
        verdict_key: validation_verdict_key(verdict: run.verdict),
        detail: validation_verdict_detail(verdict: run.verdict),
      }
    } else {
      VerifyWriteFailed {
        node_id: progress.node_id,
        detail: write.error,
      }
    }
  } else {
    match change_window_refusal {
      Present { value: cause } => {
        let run = BeltValidationRun {
          executions: [],
          verdict: ValidationRefused {
            cause: ValidationChangeWindowRefused { cause: cause },
          },
        }
        let receipt = gunbc.roadmap_verification_receipt.VerificationReceipt {
          subject: subject,
          oracle_identity: match pinned_identity {
            Present { value: identity } => identity
            Absent =>
              as_content_hash_structural(
                structural: content_hash_atom(value: "oracle-pin-unreadable")
              )
          },
          executions: run.executions,
          verdict: run.verdict,
        }
        let write = Filesystem.Write(
          path: receipt_path,
          content: verification_receipt_json(receipt: receipt),
        )
        if write.success {
          VerifyRecorded {
            node_id: progress.node_id,
            verdict_key: validation_verdict_key(verdict: run.verdict),
            detail: validation_verdict_detail(verdict: run.verdict),
          }
        } else {
          VerifyWriteFailed {
            node_id: progress.node_id,
            detail: write.error,
          }
        }
      }
      Absent => {
    let observations = belt_oracle_observations_in_worktree(
      contract: node.execution,
      worktree: worktree,
    )
    let run = match validation_oracle_gate(
      contract: node.execution,
      observations: observations,
      pin_recorded: pin_recorded,
      expected_identity: match pinned_identity {
        Present { value: identity } => identity
        Absent =>
          as_content_hash_structural(
            structural: content_hash_atom(value: "oracle-pin-unreadable")
          )
      },
      revision: match pinned_revision {
        Present { value: revision } => revision
        Absent => "oracle-pin-unreadable" as std.types.NonEmptyStr as extdeps.version.VersionIdentity
      },
      pin_read_detail: if pin_refusal == "" {
        "no oracle identity was recorded for this attempt at dispatch"
      } else {
        pin_refusal
      },
    ) {
      ValidationOracleGateRefused { cause } =>
        BeltValidationRun {
          executions: [],
          verdict: ValidationRefused { cause: cause },
        }
      ValidationOracleAdmitted { identity } =>
        match node.execution {
          ExecutionContractUnspecified =>
            BeltValidationRun {
              executions: [],
              verdict: ValidationRefused {
                cause: ValidationContractUnspecified,
              },
            }
          ExecutionContract { validations, extra_capabilities: _ } =>
            belt_run_validation_operations(
              instance: instance,
              validations: validations,
              worktree: worktree,
              oracle_identity: identity,
              diff_window_path: diff_window_path,
            )
        }
    }
    let receipt = gunbc.roadmap_verification_receipt.VerificationReceipt {
      subject: subject,
      oracle_identity: match pinned_identity {
        Present { value: identity } => identity
        Absent =>
          as_content_hash_structural(
            structural: content_hash_atom(value: "oracle-pin-unreadable")
          )
      },
      executions: run.executions,
      verdict: run.verdict,
    }
    let write = Filesystem.Write(
      path: receipt_path,
      content: verification_receipt_json(receipt: receipt),
    )
    if write.success {
      VerifyRecorded {
        node_id: progress.node_id,
        verdict_key: validation_verdict_key(verdict: run.verdict),
        detail: validation_verdict_detail(verdict: run.verdict),
      }
    } else {
      VerifyWriteFailed {
        node_id: progress.node_id,
        detail: write.error,
      }
    }
      }
    }
  }
}

fn belt_verify_attempts_for_instance(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
) -> List<BeltVerifyOutcome> {
  match belt_workflow_attempts_observe_for_instance(instance: instance) {
    WorkflowAttemptsRefused { reason } =>
      [
        VerifyDeferred {
          node_id: "",
          reason: join([
            "the attempts ledger is unobservable, so no attempt can be verified: ",
            reason,
          ], ""),
        },
      ]
    WorkflowAttemptsObserved { attempts } =>
      map(attempts, progress => belt_verify_attempt_for_instance(
        instance: instance,
        progress: progress,
      ))
  }
}

fn belt_verify_attempts() -> List<BeltVerifyOutcome> {
  belt_verify_attempts_for_instance(
    instance: srv1_live_dashboard_instance(),
  )
}

fn belt_verify_pass_outcome_from(outcomes: List<BeltVerifyOutcome>) -> BeltPassOutcome {
  let ledger_refusals = outcomes |> filter(o => match o {
    VerifyDeferred { node_id: nid, reason: _ } => nid == ""
    VerifyWriteFailed { node_id: _, detail: _ } => false
    VerifyEvidenceUnreadable { node_id: _, detail: _ } => false
    VerifyRefused { node_id: _, cause: _ } => false
    VerifyRecorded { node_id: _, verdict_key: _, detail: _ } => false
  })
  if count(ledger_refusals) > 0 {
    match ledger_refusals.first() {
      Present { value: VerifyDeferred { node_id: _, reason: r } } =>
        BeltPassRefused { reason: r }
      _ =>
        BeltPassRefused { reason: "the attempts ledger is unobservable" }
    }
  } else {
    if any(outcomes, o => match o {
      VerifyWriteFailed { node_id: _, detail: _ } => true
      VerifyEvidenceUnreadable { node_id: _, detail: _ } => true
      VerifyDeferred { node_id: _, reason: _ } => false
      VerifyRefused { node_id: _, cause: _ } => false
      VerifyRecorded { node_id: _, verdict_key: _, detail: _ } => false
    }) {
      BeltPassFailed { reason: "one or more verification outcomes could not be recorded" }
    } else {
      let verification_refusals = outcomes |> filter(o => match o {
        VerifyRefused { node_id: _, cause: _ } => true
        VerifyWriteFailed { node_id: _, detail: _ } => false
        VerifyEvidenceUnreadable { node_id: _, detail: _ } => false
        VerifyDeferred { node_id: _, reason: _ } => false
        VerifyRecorded { node_id: _, verdict_key: _, detail: _ } => false
      })
      if count(verification_refusals) > 0 {
        match verification_refusals.first() {
          Present { value: VerifyRefused { node_id: _, cause: r } } =>
            BeltPassRefused { reason: r }
          _ =>
            BeltPassRefused { reason: "verification refused on one or more attempts" }
        }
      } else if count(outcomes) > 0
        && all(outcomes, o => match o {
          VerifyDeferred { node_id: nid, reason: _ } => nid != ""
          VerifyWriteFailed { node_id: _, detail: _ } => false
          VerifyEvidenceUnreadable { node_id: _, detail: _ } => false
          VerifyRefused { node_id: _, cause: _ } => false
          VerifyRecorded { node_id: _, verdict_key: _, detail: _ } => false
        }) {
        BeltPassDeferred {
          reason: "no attempt is ready for verification on this tick",
        }
      } else {
        BeltPassRecorded
      }
    }
  }
}

fn belt_workflow_attempts_observe_for_instance(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
) -> BeltWorkflowAttempts {
  match belt_attempts_observe_for_instance(instance: instance) {
    AttemptsRefused { reason } =>
      WorkflowAttemptsRefused { reason: reason }
    AttemptsObserved { attempts } => {
      let panes = belt_attempt_panes_observe_for_instance(instance: instance)
      WorkflowAttemptsObserved {
        attempts: dispatch_attempt_ref_first_per_node(attempts: attempts)
          |> map(attempt => belt_workflow_progress_for_attempt_ref(
            instance: instance,
            panes: panes,
            attempt: attempt,
          )),
      }
    }
  }
}

data belt_attempt_presentation_note: String = "The wire join of the two authorities the client must never re-derive: the attempt's progress members (gunbc.roadmap_workflow_progress, unchanged) plus the DECIDED activity view (gunbc.roadmap_presentation) appended as one 'activity' member. The seam reads process and current activity from INSIDE the progress carrier (one_progress_authority_note — the belt cannot pass a disagreeing process beside it), so this join is one call on one value. The join lives here because progress cannot import presentation without a cycle; the member-list seam (workflow_attempt_progress_json_members) is what lets the belt extend the object without re-stating or re-matching it."

fn belt_workflow_attempt_presentation_json(
  progress: gunbc.roadmap_workflow_progress.WorkflowAttemptProgress,
) -> extdeps.languages.json.emit.JsonValue {
  belt_workflow_attempt_presentation_json_with_tick_read(
    progress: progress,
    tick_read: BeltTickReceiptAbsent,
  )
}

fn belt_workflow_attempt_presentation_json_for_instance(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  progress: gunbc.roadmap_workflow_progress.WorkflowAttemptProgress,
) -> extdeps.languages.json.emit.JsonValue {
  belt_workflow_attempt_presentation_json_with_tick_read(
    progress: progress,
    tick_read: belt_tick_receipt_read_for_instance(instance: instance),
  )
}

fn belt_workflow_attempt_presentation_json_with_tick_read(
  progress: gunbc.roadmap_workflow_progress.WorkflowAttemptProgress,
  tick_read: BeltTickReceiptRead,
) -> extdeps.languages.json.emit.JsonValue {
  json_object(members: concat(
    workflow_attempt_progress_json_members(progress: progress),
    [
      json_kv(key: "activity", value: activity_view_json_value(
          view: activity_view_from_progress(progress: progress))),
      json_kv(
        key: "verification_presentation",
        value: json_string(
          s: belt_verification_presentation_detail(
            progress: progress,
            tick_read: tick_read,
          ),
        ),
      ),
    ]))
}

fn belt_tick_receipt_wire_json_from_read(tick_read: BeltTickReceiptRead) -> extdeps.languages.json.emit.JsonValue {
  match tick_read {
    BeltTickReceiptPresent { receipt } =>
      json_object(members: [
        json_kv(key: "present", value: json_bool(b: true)),
        json_kv(key: "receipt", value: belt_tick_receipt_json_value(receipt: receipt)),
      ])
    BeltTickReceiptAbsent =>
      json_object(members: [
        json_kv(key: "present", value: json_bool(b: false)),
      ])
    BeltTickReceiptUnreadable { reason: r } =>
      json_object(members: [
        json_kv(key: "present", value: json_bool(b: false)),
        json_kv(
          key: "unreadable_reason",
          value: json_string(s: r),
        ),
      ])
  }
}

fn belt_tick_receipt_wire_json_for_instance(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
) -> extdeps.languages.json.emit.JsonValue {
  belt_tick_receipt_wire_json_from_read(
    tick_read: belt_tick_receipt_read_for_instance(instance: instance),
  )
}

fn belt_workflow_attempts_json_value_for_instance(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  observed: BeltWorkflowAttempts,
) -> extdeps.languages.json.emit.JsonValue {
  let tick_read = belt_tick_receipt_read_for_instance(instance: instance)
  match observed {
    WorkflowAttemptsRefused { reason } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: "roadmap-workflow/v1")),
        json_kv(key: "observe_refused", value: json_bool(b: true)),
        json_kv(key: "reason", value: json_string(s: reason)),
        json_kv(key: "belt_tick", value: belt_tick_receipt_wire_json_from_read(tick_read: tick_read)),
      ])
    WorkflowAttemptsObserved { attempts } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: "roadmap-workflow/v1")),
        json_kv(key: "observe_refused", value: json_bool(b: false)),
        json_kv(
          key: "attempts",
          value: json_array(elements: map(
            attempts,
            progress => belt_workflow_attempt_presentation_json_with_tick_read(
              progress: progress,
              tick_read: tick_read,
            ),
          )),
        ),
        json_kv(key: "belt_tick", value: belt_tick_receipt_wire_json_from_read(tick_read: tick_read)),
      ])
  }
}

fn belt_workflow_attempts_json_value(
  observed: BeltWorkflowAttempts,
) -> extdeps.languages.json.emit.JsonValue {
  belt_workflow_attempts_json_value_for_instance(
    instance: srv1_live_dashboard_instance(),
    observed: observed,
  )
}

fn belt_workflow_attempts_observed_json_for_instance(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  observed: BeltWorkflowAttempts,
) -> String {
  serialize_json(v: belt_workflow_attempts_json_value_for_instance(
    instance: instance,
    observed: observed,
  ))
}

fn belt_workflow_attempts_observed_json(
  observed: BeltWorkflowAttempts,
) -> String {
  serialize_json(v: belt_workflow_attempts_json_value(observed: observed))
}

fn belt_workflow_attempts_http_status(
  observed: BeltWorkflowAttempts,
) -> Int {
  match observed {
    WorkflowAttemptsRefused { reason: _ } => 503
    WorkflowAttemptsObserved { attempts: _ } => 200
  }
}

type BeltStopResult
  = StopProcessStopped { node_id: String, session_name: String }
  | StopRetainedSessionCleared {
      node_id: String,
      session_name: String,
      exit_code: Int,
    }
  | StopDisabled { node_id: String, instance_id: String, reason: String }
  | StopRefusedResult { node_id: String, reason: String }
  | StopObserveRefused { node_id: String, reason: String }
  | StopTeardownFailed { node_id: String, session_name: String, detail: String }

data belt_stop_note: String = "U4 (stop/clear from the UI): cleanup consumes the same independently observed session and process facts served to the page. Session-list refusal yields StopObserveRefused. A present running pane is stop-eligible only with the configured provider fingerprint; a foreign or unobserved running process refuses. A retained dead pane is a different operation: clear removes tmux metadata after the process has already exited, so its historical wrapper command is never misclassified as a live foreign process. Teardown failure remains its own typed 502 arm."

fn belt_stop_node_for_instance(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  node_id: String,
) -> BeltStopResult {
  match instance.actuation {
    DashboardObserveOnly =>
    StopDisabled {
      node_id: node_id,
      instance_id: instance.instance_id as String,
      reason: "dashboard instance is observe-only; stop refused before tmux observation",
    }
    DashboardActuating => {
  match belt_sessions_observe_for_instance(instance: instance) {
    ObserveRefused { reason: r } => StopObserveRefused { node_id: node_id, reason: r }
    Observed { live } => {
      match dispatch_tmux_session_scope(node_id: node_id) {
        Absent =>
          StopRefusedResult {
            node_id: node_id,
            reason: "dispatch selection refused before stop scope",
          }
        Present { value: scope } => {
      let matched = live
        |> filter(sess =>
          sess.session_name == (scope.session_name as String))
      match matched.first() {
        Absent =>
          StopRefusedResult {
            node_id: node_id,
            reason: "no session container for this node",
          }
        Present { value: session } =>
          match dispatch_session_cleanup(scope: scope, session: session) {
            DispatchCleanupRefused { reason } =>
              StopRefusedResult { node_id: node_id, reason: reason }
            DispatchStopRunningProcess { session_name } =>
              match belt_actuate_teardown_for_instance(
                instance: instance,
                session_name: session_name,
              ) {
                ReapedSession { session_name: stopped } =>
                  StopProcessStopped {
                    node_id: node_id,
                    session_name: stopped,
                  }
                TeardownFailed { session_name: failed, detail } =>
                  StopTeardownFailed {
                    node_id: node_id,
                    session_name: failed,
                    detail: detail,
                  }
              }
            DispatchClearRetainedSession { session_name, exit_code } =>
              match belt_actuate_teardown_for_instance(
                instance: instance,
                session_name: session_name,
              ) {
                ReapedSession { session_name: cleared } =>
                  StopRetainedSessionCleared {
                    node_id: node_id,
                    session_name: cleared,
                    exit_code: exit_code,
                  }
                TeardownFailed { session_name: failed, detail } =>
                  StopTeardownFailed {
                    node_id: node_id,
                    session_name: failed,
                    detail: detail,
                  }
              }
          }
      }
        }
      }
    }
  }
  }
  }
}

fn belt_stop_node(node_id: String) -> BeltStopResult {
  belt_stop_node_for_instance(
    instance: srv1_live_dashboard_instance(),
    node_id: node_id,
  )
}

fn belt_stop_result_json_value(r: BeltStopResult) -> extdeps.languages.json.emit.JsonValue {
  match r {
    StopProcessStopped { node_id: nid, session_name: sn } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "process_stopped")),
        json_kv(key: "action", value: json_string(s: "stop")),
        json_kv(key: "ok", value: json_bool(b: true)),
        json_kv(key: "session_name", value: json_string(s: sn)),
      ])
    StopRetainedSessionCleared {
      node_id: nid,
      session_name: sn,
      exit_code,
    } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "session_cleared")),
        json_kv(key: "action", value: json_string(s: "clear")),
        json_kv(key: "ok", value: json_bool(b: true)),
        json_kv(key: "session_name", value: json_string(s: sn)),
        json_kv(key: "exit_code", value: json_int(n: exit_code)),
      ])
    StopDisabled { node_id: nid, instance_id: iid, reason: why } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "stop_disabled")),
        json_kv(key: "ok", value: json_bool(b: false)),
        json_kv(key: "instance", value: json_string(s: iid)),
        json_kv(key: "reason", value: json_string(s: why)),
      ])
    StopRefusedResult { node_id: nid, reason: r2 } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "stop_refused")),
        json_kv(key: "ok", value: json_bool(b: false)),
        json_kv(key: "reason", value: json_string(s: r2)),
      ])
    StopObserveRefused { node_id: nid, reason: r3 } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "observe_refused")),
        json_kv(key: "ok", value: json_bool(b: false)),
        json_kv(key: "reason", value: json_string(s: r3)),
      ])
    StopTeardownFailed { node_id: nid, session_name: sn, detail: d } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "teardown_failed")),
        json_kv(key: "ok", value: json_bool(b: false)),
        json_kv(key: "session_name", value: json_string(s: sn)),
        json_kv(key: "detail", value: json_string(s: d)),
      ])
  }
}

fn belt_stop_http_status(r: BeltStopResult) -> Int {
  match r {
    StopProcessStopped { node_id: _, session_name: _ } => 200
    StopRetainedSessionCleared {
      node_id: _,
      session_name: _,
      exit_code: _,
    } => 200
    StopDisabled { node_id: _, instance_id: _, reason: _ } => 403
    StopRefusedResult { node_id: _, reason: r2 } =>
      if string_contains(s: r2, pattern: "no session container") {
        404
      } else {
        409
      }
    StopObserveRefused { node_id: _, reason: _ } => 503
    StopTeardownFailed { node_id: _, session_name: _, detail: _ } => 502
  }
}

fn belt_stop_json(node_id: String) -> String {
  serialize_json(v: belt_stop_result_json_value(r: belt_stop_node(node_id: node_id)))
}

data belt_sessions_json_note: String = "The sessions wire projects independent session-container, process-lifecycle, provider, readiness, phase, and cleanup facts. Inclusion in sessions proves only `session_presence=present`. process_state comes from the exact dead/status pane observation; cleanup_action is derived separately from process state plus ownership policy. A refused pane probe stays per-session as process unobserved and cleanup unavailable while the known session set remains a 200. Only refusal of the tmux session-list source produces top-level observe_refused/503. Cleanup scope for admitted rows uses dispatch_tmux_session_scope_for_live_session from the session worker's configured provider facts — never a production-selection re-query that would fabricate eligibility or a partial row when standing refuses."

fn belt_sessions_json_value(o: BeltObserve) -> extdeps.languages.json.emit.JsonValue {
  match o {
    ObserveRefused { reason: r } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: "roadmap-sessions/v1")),
        json_kv(key: "observe_refused", value: json_bool(b: true)),
        json_kv(key: "reason", value: json_string(s: r)),
      ])
    Observed { live } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: "roadmap-sessions/v1")),
        json_kv(key: "observe_refused", value: json_bool(b: false)),
        json_kv(key: "sessions", value: json_array(elements: live |> map(sess => {
          let cleanup = dispatch_session_cleanup_for_live_session(sess: sess)
          json_object(members: [
            json_kv(key: "node_id", value: json_string(s: sess.node_id)),
            json_kv(key: "session_name", value: json_string(s: sess.session_name)),
            json_kv(key: "session_presence", value: json_string(s: "present")),
            json_kv(key: "process_state", value: json_string(
              s: worker_process_evidence_label(evidence: sess.worker.process))),
            json_kv(key: "process_detail", value: json_string(
              s: worker_process_evidence_detail(evidence: sess.worker.process))),
            json_kv(key: "configured_provider", value: json_string(s: provider_kind_label(kind: sess.worker.configured_provider.kind))),
            json_kv(key: "provider", value: json_string(s: provider_evidence_label(evidence: sess.worker.provider_instance))),
            json_kv(key: "provider_readiness", value: json_string(s: provider_readiness_label(readiness: sess.worker.provider_readiness))),
            json_kv(key: "tool_execution_readiness", value: json_string(s: tool_execution_readiness_label(readiness: sess.worker.tool_readiness))),
            json_kv(key: "worker_phase", value: json_string(s: worker_phase_label(phase: sess.worker.phase))),
            json_kv(key: "cleanup_action", value: json_string(
              s: dispatch_session_cleanup_action(cleanup: cleanup))),
            json_kv(key: "cleanup_allowed", value: json_bool(
              b: dispatch_session_cleanup_allowed(cleanup: cleanup))),
            json_kv(key: "cleanup_detail", value: json_string(
              s: dispatch_session_cleanup_detail(cleanup: cleanup))),
            json_kv(key: "facts", value: session_facts_json_value(
              v: session_facts_view(
                process: sess.worker.process,
                process_detail: worker_process_evidence_detail(evidence: sess.worker.process),
                provider: provider_evidence_label(evidence: sess.worker.provider_instance),
                configured_provider: provider_kind_label(kind: sess.worker.configured_provider.kind),
                provider_readiness: provider_readiness_label(readiness: sess.worker.provider_readiness),
                session_name: sess.session_name,
                cleanup_action: dispatch_session_cleanup_action(cleanup: cleanup),
                cleanup_allowed: dispatch_session_cleanup_allowed(cleanup: cleanup),
                cleanup_detail: dispatch_session_cleanup_detail(cleanup: cleanup),
              ))),
          ])
        }))),
      ])
  }
}

fn belt_sessions_observed_json(o: BeltObserve) -> String {
  serialize_json(v: belt_sessions_json_value(o: o))
}

fn belt_sessions_json() -> String {
  belt_sessions_observed_json(o: belt_sessions_observe())
}

fn belt_sessions_http_status(o: BeltObserve) -> Int {
  match o {
    ObserveRefused { reason: _ } => 503
    Observed { live: _ } => 200
  }
}

fn belt_run_once_json() -> String {
  serialize_json(v: belt_tick_result_json_value(t: belt_run_once()))
}

data belt_run_once_cli_note: String = "The ProcessExit entrypoint — this is what `gunbc run --function belt_run_once_cli` invokes (belt_run_once_json returns String, which `gunbc run` rejects; belt_run_once_cli is its runnable wrapper). EXIT SEMANTICS (operator P0, 2026-08-02): exit 0 when the tick COMPLETED and PERSISTED its BeltTickReceipt — spawn failures, recorded validation refusals, and observe_refused on the spawn pass do NOT flip the exit, because those are counted outcomes in the receipt, not a failure to run or record the tick. Nonzero ONLY when the tick could not persist its receipt (BeltPassFailed on write) or when GUNBC_BELT_SPAWN_WORKDIR is missing/empty. systemd therefore distinguishes 'tick crashed' from 'tick ran, work refused'. The stdout JSON (roadmap-belt-tick/v1) remains the per-tick operational receipt for journald; the persisted BeltTickReceipt (roadmap-belt-tick-receipt/v2) is what /workflow.json reads for presentation."

data belt_spawn_workdir_is_a_parameter_note: String = "THE SPAWN ROOT IS SUPPLIED BY WHOEVER INVOKES THE TICK, AND MAKING IT A LITERAL WAS THE DEFECT. belt_actuate_workdir is a projection of srv1_gunbc_repo_root, so a tick spawned `git worktree add` into PRODUCTION's tree no matter which deployment invoked it. That was invisible while nothing invoked the belt on a cadence; the moment a deployment owns a timer it stops being invisible, because the srv1-lab twin would install a unit that actuates production — the failure gunbc.live_deploy.spec's deployment_service_handler_note records for the serve handler, where every path-level check passes and the process simply operates as production.\\n\\nIt enters through the environment for the same reason the node id does (belt_dispatch_node_cli_note): `gunbc run --function` cannot pass an argument, there is no --arg flag. So the deployment's belt unit sets GUNBC_BELT_SPAWN_WORKDIR to ITS instance's repo root, and each instance actuates its own tree.\\n\\nFAIL-CLOSED ON THE CHANNEL, and the choice matters more here than for a node id: defaulting an absent variable to belt_actuate_workdir would restore the exact defect, silently, for every caller that forgot to set it — the absorbing fallback DESIGN §5 forbids, with production's tree as the thing absorbed. A missing OR empty value refuses, and shell.Env.Get returns Present-but-empty for an unset var wet, so both fold into one refusal.\\n\\nbelt_run_once and belt_run_once_json keep the literal default: they are inspection surfaces invoked by hand against production, not the scheduled entrypoint, and belt_run_once_in is the one implementation both spellings route through so the parameterized and default paths cannot drift."

fn belt_run_once_cli() -> std.process.ProcessExit {
  match shell.Env.Get(name: belt_spawn_workdir_env_var).value {
    Absent =>
      exit_failure(reason: "belt_run_once_cli: GUNBC_BELT_SPAWN_WORKDIR not set — the spawn root is a per-deployment fact and defaulting it would actuate production's tree (fail-closed)")
    Present { value: workdir } =>
      if string_length(s: workdir) == 0 {
        exit_failure(reason: "belt_run_once_cli: GUNBC_BELT_SPAWN_WORKDIR is empty — the spawn root is a per-deployment fact and defaulting it would actuate production's tree (fail-closed)")
      } else {
        belt_run_once_cli_in(spawn_workdir: workdir)
      }
  }
}

fn belt_run_once_cli_in(spawn_workdir: String) -> std.process.ProcessExit {
  match belt_dashboard_instance_lookup_for_spawn_workdir(workdir: spawn_workdir) {
    UnknownSpawnWorkdir { workdir: w } =>
      exit_failure(reason: join([
        "belt_run_once_cli: GUNBC_BELT_SPAWN_WORKDIR does not match a known dashboard instance repo root: ",
        w,
      ], ""))
    SpawnWorkdirInstanceResolved { instance } => {
      let t = belt_run_once_in(instance: instance, spawn_workdir: spawn_workdir)
      let tick_receipt = belt_tick_receipt_from_result(
        result: t,
        observed_at: belt_tick_observed_at(),
      )
      match belt_tick_receipt_write_for_instance(instance: instance, receipt: tick_receipt) {
        BeltPassFailed { reason: r } =>
          exit_failure(reason: join([
            serialize_json(v: belt_tick_result_json_value(t: t)),
            "\n",
            r,
          ], ""))
        BeltPassRecorded =>
          ExitSuccess
        BeltPassDeferred { reason: r } =>
          exit_failure(reason: join(["belt tick receipt write returned deferred: ", r], ""))
        BeltPassRefused { reason: r } =>
          exit_failure(reason: join(["belt tick receipt write returned refused: ", r], ""))
      }
    }
  }
}

data belt_dispatch_node_note: String = "Per-node MANUAL dispatch — the click path (operator 2026-07-20: 'i should just manually click/dispatch'). belt_run_once ticks the WHOLE ready frontier; belt_dispatch_node spawns exactly ONE node by id, operator-selected from the roadmap UI, NOT frontier-gated (the operator's click IS the selection). DONE = the operator's SIGNOFF, never a merged PR (operator: 'PR merged not necessarily mean item == done — they may not be 1:1'): a signoff-accepted node refuses dispatch (DispatchNodeAlreadyDone); a node whose PRs merged but is unsigned is still 'in review' and remains dispatchable (more work). Idempotent by the same observe-before-spawn the tick uses, and idempotence is asserted of a PROCESS rather than of a container name (belt_session_liveness_note): a running worker gives DispatchAlreadyLive (noop) so a double-click never double-spawns, while a retained dead pane gives DispatchStaleSession — refused, never accepted, and never suppressing the new turn. Fail-closed: unknown node id -> DispatchNodeNotFound; unknowable observed set -> DispatchObserveRefused; unreadable pane lifecycle for a present session -> DispatchSessionLivenessUnobserved (no blind spawn under unknown liveness); spawn failure -> DispatchSpawnFailed (never a fabricated success). Reuses belt_lookup_node (pure roadmap read), belt_sessions_observe_for_instance (the process-aware observation the sessions route already used), and belt_actuate_spawn — no forked spawn path and no second observer."

type BeltNodeLookup
  = NodeFound { node: gunbc.roadmap_model.RoadmapNode }
  | NodeMissing
  | AuthorityProjectionRefused { detail: String }

fn belt_find_node_in(nodes: List<gunbc.roadmap_model.RoadmapNode>, node_id: String) -> BeltNodeLookup {
  let matches = nodes |> filter(n => n.node == node_id)
  fold(matches, init: NodeMissing, f: fn(acc, n) {
    match acc {
      NodeFound { node: _ } => acc
      NodeMissing => NodeFound { node: n }
      AuthorityProjectionRefused { detail: _ } => acc
    }
  })
}

fn belt_lookup_node(node_id: String) -> BeltNodeLookup {
  match roadmap_authority_projection() {
    RoadmapAuthorityProjectionRefused { detail: detail } =>
      AuthorityProjectionRefused { detail: detail }
    RoadmapAuthorityProjected { doc: doc, accepted: _ } =>
      belt_find_node_in(nodes: doc_all_nodes(doc: doc), node_id: node_id)
  }
}

data belt_session_liveness_note: String = "A TMUX CONTAINER IS NOT A LIVE AGENT, AND ADMISSION IS THE LAST PLACE IN THIS MODULE TO LEARN IT. dispatch_process_cleanup_separation_note settled the rule for the cleanup path and belt_sessions_observation_separation_note settled it for the sessions route: session presence and process lifecycle are independent facts, so `session present` never by itself means `agent running`. Dispatch admission never adopted it. belt_node_session_live asked `any(live, s => s.node_id == node_id)` over a tmux ls row set whose worker evidence was the worker_observation_without_provider_probe placeholder, so a retained remain-on-exit pane — the exact artifact the spawn path CREATES by setting remain-on-exit — answered `live`, and the click returned DispatchAlreadyLive through the accepted band. The operator saw a positive acknowledgement and no agent, forever, with no refusal anywhere to count.\\n\\nTHAT IS WORSE THAN THE REFUSAL IT SITS BESIDE. A selection refusal at least lands in a journal as a typed, counted event; an accepted no-op is indistinguishable from success at every surface, so its frequency is zero by construction — the absorbing fallback of DESIGN section 5 wearing an idempotence label. `already running` is a claim about a PROCESS, and it must be derived from process evidence or refuse.\\n\\nTHE FOUR ANSWERS ARE NOT A BOOLEAN. Running is the only one that may suppress a spawn. StaleTerminal is a container whose pane is dead: it must never suppress the new turn and must never read as accepted, because the remedy is to clear or supersede it. LivenessUnobserved is the honest third state — a pane probe that refused, or a dead pane with no exit status — and it REFUSES rather than spawning, because a blind spawn under unknown liveness is how one node acquires two workers. Absent is the ordinary path to a spawn. Collapsing Unobserved into either pole is the state-space conflation that produced this defect one level down.\\n\\nNO SECOND OBSERVER WAS BUILT FOR THIS. The pane probe (belt_attempt_panes_observe_for_instance), the pane-to-evidence projection (worker_process_from_attempt_pane) and the per-session join (worker_process_for_session) already existed and already carried the refusal semantics; what was missing was that dispatch admission read the ls-only observation instead of the process-aware one. This routes the two actuation call sites — the tick and the dispatch — through the observation the sessions UI was already using."

type BeltSessionLiveness
  = BeltSessionRunning { session_name: String, command: String }
  | BeltSessionStaleTerminal { session_name: String, detail: String }
  | BeltSessionLivenessUnobserved { session_name: String, reason: String }
  | BeltSessionAbsent
  | BeltSessionMultiplicityConflict { session_names: String, session_count: Int }

fn belt_session_liveness_from_process(
  session_name: String,
  process: gunbc.worker_lifecycle.WorkerProcessEvidence,
) -> BeltSessionLiveness {
  match process {
    WorkerProcessRunning { command } =>
      BeltSessionRunning { session_name: session_name, command: command as String }
    WorkerProcessExited { exit_code, last_command } =>
      BeltSessionStaleTerminal {
        session_name: session_name,
        detail: join([
          "retained pane: process exited with status ",
          to_string(exit_code),
          "; last command ",
          last_command,
        ], ""),
      }
    WorkerProcessAbsent =>
      BeltSessionStaleTerminal {
        session_name: session_name,
        detail: "session container is present but no provider process is attached",
      }
    WorkerProcessUnobserved { reason } =>
      BeltSessionLivenessUnobserved {
        session_name: session_name,
        reason: reason as String,
      }
  }
}

fn belt_node_session_liveness(
  live: List<gunbc.roadmap_dispatch_actuator.DispatchLiveSession>,
  node_id: String,
) -> BeltSessionLiveness {
  let matched = live |> filter(s => s.node_id == node_id)
  let n = count(matched)
  if n > 1 {
    BeltSessionMultiplicityConflict {
      session_names: join(map(matched, s => s.session_name), ", "),
      session_count: n,
    }
  } else {
    match matched.first() {
      Present { value: s } =>
        belt_session_liveness_from_process(
          session_name: s.session_name,
          process: s.worker.process,
        )
      Absent => BeltSessionAbsent
    }
  }
}

data belt_session_multiplicity_note: String = "0/1/MANY, BECAUSE first() IS A SILENT VERDICT (review artifact 51237 handback item 3). The fold filtered rows by node id and took the first match, so two sessions claiming one node resolved to whichever tmux happened to list first — [running, stale] answered running and [stale, running] answered stale. The same observation, two orders, two different dispatch outcomes, and no signal that a choice had been made.\n\nTwo sessions for one node is not a tie to break; it is a state whose remedy differs from every other arm — neither spawn nor reuse is safe until someone decides which history is real. So it refuses and NAMES every session, because a refusal that says only 'ambiguous' leaves the operator to go find the panes themselves."

data belt_node_session_live_deletion_note: String = "belt_node_session_live IS DELETED. It answered Bool over a four-state lifecycle, mapping StaleTerminal, LivenessUnobserved and Absent all to false — and the module's own liveness note says those three have different remedies (clean up; refuse and count; spawn). A Boolean that erases the distinction is a standing invitation to bypass the coproduct, and it had no production caller left once dispatch matched on BeltSessionLiveness directly. Consumers match the coproduct."

data belt_dispatch_wire_contract_exemplar_provider: String = "codex"

type BeltRevisionAdmission
  = BeltRevisionAdmitted { revision: String }
  | BeltRevisionRefusedDrifted { desired: String, local: String }
  | BeltRevisionRefusedUnobserved { cause: String }

data belt_revision_admission_note: String = "THE GATE, EXTRACTED SO IT IS WITNESSABLE (review artifact 51237 handback item 4). The revision check lived inline in belt_dispatch_node_for_instance, so every witness constructed DispatchRevisionDrifted directly and asserted its label, band and JSON — which proves the ARMS render, and would stay green if the fleet_revision_standing match were deleted outright. A test that survives the removal of the thing it tests is not testing it.\n\nThis fold is pure: FleetRevisionStanding in, admission out, no effect. The effectful read stays at the call site, so a witness can drive Converged / Drifted / Unobserved through the real decision without a git tree.\n\nIt is also the SHARED seam, which is the second half of the same finding: the belt timer is a dispatch actuator exactly as much as the button is, and a gate that only the button consults refuses a click on a drifted host while the tick spawns against it anyway."

fn belt_revision_admission(standing: gunbc.fleet_desired_observe.FleetRevisionStanding) -> BeltRevisionAdmission {
  match standing {
    RevisionConverged { revision: r } =>
      BeltRevisionAdmitted { revision: git_object_id_wire_hex(oid: r) as String }
    RevisionDrifted { desired: d, local: l } =>
      BeltRevisionRefusedDrifted {
        desired: git_object_id_wire_hex(oid: d) as String,
        local: git_object_id_wire_hex(oid: l) as String,
      }
    RevisionUnobserved { cause: c } => BeltRevisionRefusedUnobserved { cause: c }
  }
}

type BeltDispatchResult
  = DispatchSpawned { node_id: String, session_name: String, provider: String }
  | DispatchAlreadyLive { node_id: String, session_name: String }
  | DispatchDisabled { node_id: String, instance_id: String, reason: String }
  | DispatchNodeNotFound { node_id: String }
  | DispatchNodeAlreadyDone { node_id: String }
  | DispatchObserveRefused { node_id: String, reason: String }
  | DispatchAuthorityRefused { node_id: String, detail: String }
  | DispatchSpawnFailed { node_id: String, step: String, detail: String, provider: String }
  | DispatchStaleSession { node_id: String, session_name: String, detail: String }
  | DispatchSessionLivenessUnobserved { node_id: String, session_name: String, reason: String }
  | DispatchRevisionDrifted { node_id: String, desired: String, local: String }
  | DispatchRevisionUnobserved { node_id: String, cause: String }
  | DispatchSessionMultiplicityConflict {
      node_id: String,
      session_names: String,
      session_count: Int,
    }

data belt_dispatch_revision_gate_note: String = "DISPATCH READS BACK THE DEPLOYED REVISION BEFORE IT ACTS, and the reason is that every fact this path consumes comes from the deployed tree — the node roster, the signoff, the contract, the command it is about to run. `gunbc.fleet_desired_observe` `fleet_revision_standing` already decided that cell three ways, and until now its ONLY consumer was `gunbc.fleet_converge_cli`: convergence knew the host was drifted while the served page dispatched against the drifted tree anyway, saying nothing. That is not a stale display, it is a worker spawned from code the fleet never admitted, reported as an ordinary spawn.\\n\\nSo the standing is consulted FIRST — before node lookup, before session observation, before the worktree — because a roster read from an unadmitted tree cannot be trusted to name the right node, and refusing later would mean refusing after acting on it.\\n\\nBOTH non-converged arms refuse, and neither is an absorbing widen: `RevisionDrifted` carries BOTH revisions (the membership-diff `from` ruling — a catch-up needs the prior, and a receipt must name what it observed), `RevisionUnobserved` carries its cause and is unobserved-GRADE, never satisfied. A `RevisionUnobserved` that dispatched anyway would be exactly the empty-observation narrow: could-not-compare rendered as nothing-is-wrong.\\n\\nThe repo path is `instance.repo_root`, not the `srv1_gunbc_repo_root` constant `fleet_converge_cli` uses, because the gate is a fact about the instance being dispatched — hardcoding srv1 here would mint a second path authority and answer for the wrong host on any other instance."

fn belt_dispatch_node_for_instance(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  node_id: String,
) -> BeltDispatchResult {
  match instance.actuation {
    DashboardObserveOnly =>
    DispatchDisabled {
      node_id: node_id,
      instance_id: instance.instance_id as String,
      reason: "dashboard instance is observe-only; dispatch refused before observation, provider preflight, or worktree creation",
    }
    DashboardActuating =>
      match belt_revision_admission(
        standing: fleet_revision_standing(repo: instance.repo_root),
      ) {
        BeltRevisionRefusedDrifted { desired: d, local: l } =>
          DispatchRevisionDrifted { node_id: node_id, desired: d, local: l }
        BeltRevisionRefusedUnobserved { cause: c } =>
          DispatchRevisionUnobserved { node_id: node_id, cause: c }
        BeltRevisionAdmitted { revision: _ } => {
  match belt_lookup_node(node_id: node_id) {
    AuthorityProjectionRefused { detail: detail } =>
      DispatchAuthorityRefused { node_id: node_id, detail: detail }
    NodeMissing => DispatchNodeNotFound { node_id: node_id }
    NodeFound { node: node } =>
      if signoff_accepts(s: node.signoff) {
        DispatchNodeAlreadyDone { node_id: node_id }
      } else {
        match belt_sessions_observe_for_instance(instance: instance) {
          ObserveRefused { reason: r } =>
            DispatchObserveRefused { node_id: node_id, reason: r }
          Observed { live: live } =>
            match belt_node_session_liveness(live: live, node_id: node_id) {
              BeltSessionRunning { session_name: sn, command: _ } =>
                DispatchAlreadyLive {
                  node_id: node_id,
                  session_name: sn,
                }
              BeltSessionStaleTerminal { session_name: sn, detail: d } =>
                DispatchStaleSession {
                  node_id: node_id,
                  session_name: sn,
                  detail: d,
                }
              BeltSessionLivenessUnobserved { session_name: sn, reason: r } =>
                DispatchSessionLivenessUnobserved {
                  node_id: node_id,
                  session_name: sn,
                  reason: r,
                }
              BeltSessionMultiplicityConflict { session_names: sn, session_count: n } =>
                DispatchSessionMultiplicityConflict {
                  node_id: node_id,
                  session_names: sn,
                  session_count: n,
                }
              BeltSessionAbsent =>
              match (match clock_now_probed_at() {
                Present { value: probed_at } =>
                  belt_actuate_spawn_for_instance(
                    instance: instance,
                    node: node,
                    probed_at: probed_at as String,
                  )
                Absent =>
                  SpawnFailed {
                    node_id: node_id,
                    step: "attempt-clock",
                    detail: "clock observation refused; an attempt without a stamp would collide with a later one — fail-closed, no unknown-stamped attempts",
                    provider: belt_dispatch_spawn_unselected_provider_wire_label(),
                  }
              }) {
                Spawned { node_id: sid, session_name: sn, provider: p } =>
                  DispatchSpawned { node_id: sid, session_name: sn, provider: p }
                SpawnFailed { node_id: sid, step: st, detail: d, provider: p } =>
                  DispatchSpawnFailed { node_id: sid, step: st, detail: d, provider: p }
              }
            }
        }
      }
  }
  }
      }
  }
}

fn belt_dispatch_node(node_id: String) -> BeltDispatchResult {
  belt_dispatch_node_for_instance(
    instance: srv1_live_dashboard_instance(),
    node_id: node_id,
  )
}

fn belt_dispatch_result_ok(r: BeltDispatchResult) -> Bool {
  dispatch_band_is_ok(b: belt_dispatch_result_band(r: r))
}

data belt_dispatch_status_label_note: String = "The ONE wire vocabulary for a dispatch result (DESIGN §3, found live 2026-07-23): the served JSON body's `status` member and the roadmap page's client-side ok-check are two consumers of ONE label set — the dispatch button read a retired belt-A `\{ok, node\}` shape while belt B answered `\{status, ...\}`, so EVERY successful click rendered 'failed' (a silently-wrong UI answer, §5). belt_dispatch_status_label is the per-variant label authority consumed by belt_dispatch_result_json_value; belt_dispatch_ok_status_labels is the ok-subset the page derives its JS predicate from, glued to belt_dispatch_result_ok by witness (a label moved across the ok/refusal line without updating both surfaces goes RED)."

fn belt_dispatch_status_label(r: BeltDispatchResult) -> String {
  match r {
    DispatchSpawned { node_id: _, session_name: _, provider: _ } => "spawned"
    DispatchAlreadyLive { node_id: _, session_name: _ } => "already_live"
    DispatchDisabled { node_id: _, instance_id: _, reason: _ } => "disabled"
    DispatchNodeNotFound { node_id: _ } => "node_not_found"
    DispatchNodeAlreadyDone { node_id: _ } => "already_done_signed_off"
    DispatchObserveRefused { node_id: _, reason: _ } => "observe_refused"
    DispatchAuthorityRefused { node_id: _, detail: _ } => "authority_refused"
    DispatchSpawnFailed { node_id: _, step: _, detail: _, provider: _ } => "spawn_failed"
    DispatchStaleSession { node_id: _, session_name: _, detail: _ } => "stale_session"
    DispatchSessionLivenessUnobserved { node_id: _, session_name: _, reason: _ } => "session_liveness_unobserved"
    DispatchRevisionDrifted { node_id: _, desired: _, local: _ } => "deployed_revision_drifted"
    DispatchRevisionUnobserved { node_id: _, cause: _ } => "deployed_revision_unobserved"
    DispatchSessionMultiplicityConflict { node_id: _, session_names: _, session_count: _ } => "session_multiplicity_conflict"
  }
}

fn belt_dispatch_disabled_status_label() -> String {
  belt_dispatch_status_label(
    r: DispatchDisabled {
      node_id: "label-exemplar",
      instance_id: "label-exemplar",
      reason: "label-exemplar",
    },
  )
}

data dispatch_band_note: String = "The operator-facing state vocabulary (operator ruling 2026-07-24, roadmap-workspace-remodel-plan W1a): the wire taxonomy is the belt's DIAGNOSTIC vocabulary and must not moonlight as button text. The operator reads BANDS, each a remedy class — ok: the click achieved or already holds the desired state; fail: this click cannot achieve it and the ROW is the remedy (wrong node, already signed off); loud: the BELT itself is unwell (observe refused, spawn failed — step/detail surface in the detail channel, never the caption). BandInProgress is inhabited only by the client's requested phase: no wire RESULT maps to it (the fold below has no arm producing it), so presentation cannot fabricate progress out of an answer. This fold is now the SINGLE ok-authority — belt_dispatch_result_ok and belt_dispatch_ok_status_labels are projections of it; the former hand copies (a Bool match, a hand list, a label predicate — three spellings of one fact) were the half-born-band defect this dissolves."

type DispatchBand
  = BandOk
  | BandInProgress
  | BandFail
  | BandLoud

fn belt_dispatch_result_band(r: BeltDispatchResult) -> DispatchBand {
  match r {
    DispatchSpawned { node_id: _, session_name: _, provider: _ } => BandOk
    DispatchAlreadyLive { node_id: _, session_name: _ } => BandOk
    DispatchDisabled { node_id: _, instance_id: _, reason: _ } => BandFail
    DispatchNodeNotFound { node_id: _ } => BandFail
    DispatchNodeAlreadyDone { node_id: _ } => BandFail
    DispatchObserveRefused { node_id: _, reason: _ } => BandLoud
    DispatchAuthorityRefused { node_id: _, detail: _ } => BandLoud
    DispatchSpawnFailed { node_id: _, step: _, detail: _, provider: _ } => BandLoud
    DispatchStaleSession { node_id: _, session_name: _, detail: _ } => BandLoud
    DispatchSessionLivenessUnobserved { node_id: _, session_name: _, reason: _ } => BandLoud
    DispatchRevisionDrifted { node_id: _, desired: _, local: _ } => BandLoud
    DispatchRevisionUnobserved { node_id: _, cause: _ } => BandLoud
    DispatchSessionMultiplicityConflict { node_id: _, session_names: _, session_count: _ } => BandLoud
  }
}

fn dispatch_band_key(b: DispatchBand) -> String {
  match b {
    BandOk => "ok"
    BandInProgress => "in-progress"
    BandFail => "fail"
    BandLoud => "loud"
  }
}

fn dispatch_band_is_ok(b: DispatchBand) -> Bool {
  match b {
    BandOk => true
    BandInProgress => false
    BandFail => false
    BandLoud => false
  }
}

fn belt_dispatch_ok_status_labels() -> List<String> {
  belt_dispatch_result_exemplars()
    |> filter(r => dispatch_band_is_ok(b: belt_dispatch_result_band(r: r)))
    |> map(r => belt_dispatch_status_label(r: r))
}

type DispatchLabelBandRow {
  wire_label: String
  band_key: String
}

fn belt_dispatch_label_band_rows() -> List<DispatchLabelBandRow> {
  map(belt_dispatch_result_exemplars(), r => DispatchLabelBandRow {
    wire_label: belt_dispatch_status_label(r: r),
    band_key: dispatch_band_key(b: belt_dispatch_result_band(r: r)),
  })
}

fn label_band_rows_cover(rows: List<DispatchLabelBandRow>, labels: List<String>) -> Bool {
  all(labels, l => count(filter(rows, row => row.wire_label == l)) == 1)
}

fn belt_dispatch_label_band_key(wire_label: String) -> String {
  match belt_dispatch_result_for_label(wire_label: wire_label) {
    Present { value: r } => dispatch_band_key(b: belt_dispatch_result_band(r: r))
    Absent => dispatch_band_key(b: BandLoud)
  }
}

data belt_dispatch_all_status_labels_note: String = "The full wire-label set, GROUNDED in belt_dispatch_status_label rather than hand-listed (§3): one exemplar per BeltDispatchResult variant, mapped through the label authority. The exemplar roster is the single manual enumeration the closed variant set forces — the same enumeration witness_dispatch_status_labels_pin_wire_contract already pins — and it is fail-closed twice: a NEW variant makes belt_dispatch_status_label's match non-exhaustive (compiler-caught), and gunbc.roadmap_component derives the DispatchButton's terminal states from THIS list and cross-checks totality both directions (a label with no state row, a state with no label — each red), so the button's state set cannot silently drift from the served contract. This is the projection the dispatch-button incident (2026-07-23) needed: one authority for the wire vocabulary, consumed by the JSON body, the page ok-predicate, and now the component state totality."

fn belt_dispatch_result_exemplars() -> List<BeltDispatchResult> {
  [
    DispatchSpawned { node_id: "x", session_name: "s", provider: belt_dispatch_wire_contract_exemplar_provider },
    DispatchAlreadyLive { node_id: "x", session_name: "s" },
    DispatchDisabled { node_id: "x", instance_id: "i", reason: "r" },
    DispatchNodeNotFound { node_id: "x" },
    DispatchNodeAlreadyDone { node_id: "x" },
    DispatchObserveRefused { node_id: "x", reason: "r" },
    DispatchAuthorityRefused { node_id: "x", detail: "d" },
    DispatchSpawnFailed { node_id: "x", step: "s", detail: "d", provider: belt_dispatch_wire_contract_exemplar_provider },
    DispatchStaleSession { node_id: "x", session_name: "s", detail: "d" },
    DispatchSessionLivenessUnobserved { node_id: "x", session_name: "s", reason: "r" },
    DispatchRevisionDrifted { node_id: "x", desired: "a", local: "b" },
    DispatchRevisionUnobserved { node_id: "x", cause: "c" },
    DispatchSessionMultiplicityConflict { node_id: "x", session_names: "s1, s2", session_count: 2 },
  ]
}

fn belt_dispatch_all_status_labels() -> List<String> {
  map(belt_dispatch_result_exemplars(), r => belt_dispatch_status_label(r: r))
}

fn belt_dispatch_result_for_label(wire_label: String) -> BeltDispatchResult? {
  belt_dispatch_result_exemplars()
    |> filter(r => belt_dispatch_status_label(r: r) == wire_label)
    |> first
}

fn belt_dispatch_label_is_ok(wire_label: String) -> Bool {
  any(belt_dispatch_ok_status_labels(), l => l == wire_label)
}

data belt_dispatch_path_prefix_note: String = "The dispatch route prefix, part of the wire contract (the click POSTs to prefix+NODE_ID; belt B answers it at the /dispatch/ NODE_ID route). Homed here with the rest of the wire vocabulary (§3) so the client script builder (gunbc.roadmap_component) and the emitted server (node_http_server_emit) read one authority — it moved off roadmap_page to break the page-to-component import cycle the TsProgram builder would otherwise create."

data belt_dispatch_path_prefix: String = "/dispatch/"

data belt_dispatch_provider_label_note: String = "Live production-selection introspection only — NOT the dispatch wire JSON authority. belt_dispatch_result_json_value reads the provider stamped on DispatchSpawned/DispatchSpawnFailed at spawn/result construction time so exemplars, sandbox echoes, and post-selection receipts stay honest when standing refuses production re-query."

fn belt_dispatch_provider_label() -> String {
  match dispatch_actuator_selection(node_sizing: Unsized) {
    DispatchActuatorSelectionOk { provider, effort: _, process_fingerprint: _ } =>
      dispatch_provider_label(provider: provider)
    DispatchActuatorSelectionRefused { reason } =>
      concat("selection-refused: ", reason as String)
  }
}

fn belt_dispatch_result_json_value(r: BeltDispatchResult) -> extdeps.languages.json.emit.JsonValue {
  match r {
    DispatchSpawned { node_id: nid, session_name: sn, provider: p } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: belt_dispatch_status_label(r: r))),
        json_kv(key: "provider", value: json_string(s: p)),
        json_kv(key: "session_name", value: json_string(s: sn)),
      ])
    DispatchAlreadyLive { node_id: nid, session_name: sn } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: belt_dispatch_status_label(r: r))),
        json_kv(key: "session_name", value: json_string(s: sn)),
      ])
    DispatchDisabled { node_id: nid, instance_id: iid, reason: why } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: belt_dispatch_status_label(r: r))),
        json_kv(key: "instance", value: json_string(s: iid)),
        json_kv(key: "reason", value: json_string(s: why)),
      ])
    DispatchNodeNotFound { node_id: nid } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: belt_dispatch_status_label(r: r))),
      ])
    DispatchNodeAlreadyDone { node_id: nid } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: belt_dispatch_status_label(r: r))),
      ])
    DispatchObserveRefused { node_id: nid, reason: r2 } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: belt_dispatch_status_label(r: r))),
        json_kv(key: "reason", value: json_string(s: r2)),
      ])
    DispatchAuthorityRefused { node_id: nid, detail: d } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: belt_dispatch_status_label(r: r))),
        json_kv(key: "detail", value: json_string(s: d)),
      ])
    DispatchSpawnFailed { node_id: nid, step: st, detail: d, provider: p } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: belt_dispatch_status_label(r: r))),
        json_kv(key: "provider", value: json_string(s: p)),
        json_kv(key: "step", value: json_string(s: st)),
        json_kv(key: "detail", value: json_string(s: d)),
      ])
    DispatchStaleSession { node_id: nid, session_name: sn, detail: d } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: belt_dispatch_status_label(r: r))),
        json_kv(key: "session", value: json_string(s: sn)),
        json_kv(key: "detail", value: json_string(s: d)),
      ])
    DispatchSessionLivenessUnobserved { node_id: nid, session_name: sn, reason: r2 } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: belt_dispatch_status_label(r: r))),
        json_kv(key: "session", value: json_string(s: sn)),
        json_kv(key: "reason", value: json_string(s: r2)),
      ])
    DispatchRevisionDrifted { node_id: nid, desired: dr, local: lr } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: belt_dispatch_status_label(r: r))),
        json_kv(key: "desired", value: json_string(s: dr)),
        json_kv(key: "local", value: json_string(s: lr)),
      ])
    DispatchRevisionUnobserved { node_id: nid, cause: c2 } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: belt_dispatch_status_label(r: r))),
        json_kv(key: "cause", value: json_string(s: c2)),
      ])
    DispatchSessionMultiplicityConflict { node_id: nid, session_names: sn, session_count: n } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: belt_dispatch_status_label(r: r))),
        json_kv(key: "sessions", value: json_string(s: sn)),
        json_kv(key: "session_count", value: json_int(n: n)),
      ])
  }
}

data belt_dispatch_env_var: std.types.NonEmptyStr = "GUNBC_BELT_NODE_ID" as std.types.NonEmptyStr

data belt_dispatch_node_cli_note: String = "The ProcessExit entrypoint the roadmap-UI launch button drives. gunbc run --function cannot pass an argument (there is no --arg flag), so the node id enters through the environment: the Node HTTP server on srv1 shells env GUNBC_BELT_NODE_ID=NODE gunbc run --function belt_dispatch_node_cli, and this reads it via shell.Env.Get (the same env-read authority github.auth uses for its token). Fail-closed on the channel: a missing OR empty GUNBC_BELT_NODE_ID refuses — shell.Env.Get returns a Present-but-empty value for an unset var wet, so empty is folded into the same refusal as Absent. Exit map: DispatchSpawned or DispatchAlreadyLive -> ExitSuccess (the click achieved or already holds the desired state, the node is being worked); every refusal or failure (node_not_found, already_done, observe_refused, spawn_failed) -> exit_failure with the JSON receipt on stderr, so the server relays the exact cause back to the operator."

fn belt_dispatch_node_cli() -> std.process.ProcessExit {
  match shell.Env.Get(name: belt_dispatch_env_var).value {
    Absent =>
      exit_failure(reason: "belt_dispatch_node_cli: GUNBC_BELT_NODE_ID not set — no node id to dispatch (fail-closed)")
    Present { value: v } =>
      if string_length(s: v) == 0 {
        exit_failure(reason: "belt_dispatch_node_cli: GUNBC_BELT_NODE_ID is empty — no node id to dispatch (fail-closed)")
      } else {
        let r = belt_dispatch_node(node_id: v)
        if belt_dispatch_result_ok(r: r) {
          ExitSuccess
        } else {
          exit_failure(reason: serialize_json(v: belt_dispatch_result_json_value(r: r)))
        }
      }
  }
}

data belt_publish_producer_note: String = "THE PRODUCER, WITHOUT WHICH THE PUBLICATION LAMP CANNOT MOVE. Every other piece of this lane existed before this function did - the observer, the adjudicator, the receipt format, the decoder, the path, the workflow projection - and none of them ever ran, because nothing wrote a receipt. A belt tick read an absent file and reported Pending forever, which is indistinguishable from a correct answer and is why the gap survived several reviews.\\n\\nTHE DECISION IS SEPARATED FROM THE THREE EFFECTS, for the same reason roadmap_publish is separated from roadmap_publish_observe. belt_publish_decide takes what the read found, what the observation concluded, and what the write reported, and returns the outcome; belt_publish_attempt_for_instance performs the read, the observation and the write and calls it. Every arm - already recorded, undecodable evidence, a receipt about another subject, an unwritable receipt - is therefore reachable in a hermetic witness from constructed values, which is the only way an arm that fires once a year gets proven at all.\\n\\nIT READS BEFORE WRITING, and an unreadable existing receipt REFUSES rather than being overwritten, because the belt must not destroy evidence it cannot see. The address is the difference from the verify producer: verification writes one receipt per attempt, publication writes one per head, so re-running against an already-recorded head is a no-op while a new head opens a new round.\\n\\nOBSERVATION FAILURE PERSISTS A REFUSED RECEIPT rather than aborting. Aborting before any receipt exists would leave the workflow showing an ordinary Pending, so an unavailable credential and a genuinely unpublished branch would look identical - the absence-versus-refusal collapse this whole lane exists to remove, reappearing at the outermost boundary. A refusal is a fact about an attempt and belongs on disk with the others."

type BeltPublishOutcome
  = PublishRecorded {
      node_id: String,
      head_sha: String,
      outcome_key: String,
    }
  | PublishAlreadyRecorded { node_id: String, head_sha: String }
  | PublishEvidenceUnreadable { node_id: String, detail: String }
  | PublishWriteFailed { node_id: String, detail: String }
  | PublishDeferred { node_id: String, reason: String }

data belt_publication_subject_base_note: String = "expected_base IS main FOR THIS BELT, AND THAT IS A DEPLOYMENT FACT RATHER THAN A DEFAULT. adjudicate_publication uses the base to decide which pull requests are candidates at all, so two runs with different bases can reach different outcomes about one head; the value therefore belongs in the subject, gets recorded in the receipt, and gets compared when a consumer checks that receipt.\\n\\nWhat it must not become is a parameter nobody supplies. Threading it up through the belt would produce a call chain in which every caller passes the same literal, which is the spelling-repeated-N-times shape rather than one authority. When a roadmap node can target a base other than the repository's own default, this reads that fact from the node - and the receipt already records what was used, so the change is visible in the evidence rather than silent."

fn belt_publication_subject_for(
  node_id: String,
  attempt_key: String,
  branch: String,
  head: WorktreeHeadObservation,
) -> gunbc.roadmap_publish.PublicationSubjectObservation {
  match head {
    WorktreeHeadUnobserved { reason } =>
      PublicationSubjectUnobserved {
        reason: join([
          "publication is adjudicated against an exact head and this attempt has none: ",
          reason,
        ], ""),
      }
    WorktreeHeadObserved { revision } =>
      if trim(branch) == "" {
        PublicationSubjectUnobserved {
          reason: "the attempt has no branch name, so there is nothing to look for on the remote",
        }
      } else {
        PublicationSubjectObserved {
          subject: gunbc.roadmap_publish.RoadmapPublicationSubject {
            node_id: node_id,
            attempt_key: attempt_key,
            repository: gunbc_repository,
            branch: branch as std.types.NonEmptyStr,
            expected_base: gunbc_repository.default_branch as std.types.NonEmptyStr,
            expected_head: revision as std.types.CommitSha,
          },
        }
      }
  }
}

data belt_publish_gate_note: String = "THE GATE DECIDES WHETHER TO OBSERVE AT ALL, WHICH IS WHY IT IS PURE AND WHY IT RUNS FIRST. Three of the five outcomes are settled entirely by what is already on disk - the head is on offer, the record does not decode, the record is about someone else - and none of them should cost a network read or risk a write. Deciding them before the effect is what makes them reachable in a witness from constructed values; deciding them after would make the arms untestable and would perform a GitHub read to learn something the filesystem already said.\\n\\nONLY A SETTLED RECEIPT HALTS, AND GETTING THIS WRONG WOULD HAVE FROZEN THE LAMP. The obvious idempotence key is `a receipt exists for this head`, and it is wrong: the belt ticks continuously, so the FIRST observation of a head usually happens before the worker has pushed. That observation is a perfectly good judgment - branch-not-published - and storing it as final would pin the row to `not published` forever, with every later tick halting on the very receipt that recorded the branch's absence. The negative answer would outlive the fact it described.\\n\\nSo the key is whether the receipt says the head is ON OFFER (publication_receipt_offers_the_expected_head, the same predicate a downstream obligation asks). Every other outcome is a snapshot of remote state that has not stopped moving, so the next tick re-observes and replaces it. That is not destroying evidence: it is the same question re-asked, and nothing downstream builds on a snapshot that answered no.\\n\\nA RECEIPT ABOUT ANOTHER SUBJECT AT THIS HEAD'S OWN ADDRESS IS NOT OVERWRITTEN, and that halt is unconditional. The address contains the head, so a mismatch here means something wrote a receipt for a different node, attempt, repository or base into this head's slot. That is unexplained state, and the belt's move on unexplained state is to stop rather than to correct it - overwriting would destroy the only evidence that it happened."

type BeltPublishGate
  = PublishProceed
  | PublishHalted { outcome: BeltPublishOutcome }

fn belt_publish_gate(
  node_id: String,
  subject: gunbc.roadmap_publish.RoadmapPublicationSubject,
  existing: gunbc.roadmap_publish.PublicationReceiptSource,
) -> BeltPublishGate {
  match publication_evidence_for(expected: subject, source: existing) {
    EvidenceAbsent => PublishProceed
    EvidenceForSubject { receipt } =>
      if publication_receipt_offers_the_expected_head(outcome: receipt.outcome) {
        PublishHalted {
          outcome: PublishAlreadyRecorded {
            node_id: node_id,
            head_sha: subject.expected_head as String,
          },
        }
      } else {
        PublishProceed
      }
    EvidenceUnreadable { reason } =>
      PublishHalted {
        outcome: PublishEvidenceUnreadable {
          node_id: node_id,
          detail: join([
            "a publication receipt for this head could not be read or does not decode, so the belt refuses to replace evidence it cannot read: ",
            reason,
          ], ""),
        },
      }
    EvidenceForAnotherSubject { field, expected, found } =>
      PublishHalted {
        outcome: PublishEvidenceUnreadable {
          node_id: node_id,
          detail: join([
            "a publication receipt at this head's own address is about another subject (",
            field as String, " expected ", expected, ", found ", found,
            "), which the belt refuses to overwrite because the mismatch is itself evidence of a state nobody has explained",
          ], ""),
        },
      }
  }
}

fn belt_publish_write_outcome(
  node_id: String,
  subject: gunbc.roadmap_publish.RoadmapPublicationSubject,
  receipt: gunbc.roadmap_publish.PublicationReceipt,
  write_success: Bool,
  write_error: String,
) -> BeltPublishOutcome {
  if write_success {
    PublishRecorded {
      node_id: node_id,
      head_sha: subject.expected_head as String,
      outcome_key: publication_receipt_outcome_key(outcome: receipt.outcome) as String,
    }
  } else {
    PublishWriteFailed {
      node_id: node_id,
      detail: join([
        "the publication receipt could not be written, so the judgment was reached and then lost: ",
        write_error,
      ], ""),
    }
  }
}

fn belt_publish_attempt_for_instance(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  node_id: String,
  attempt_key: String,
  credential: gunbc.roadmap_publish_observe.PublicationCredentialSource,
) -> BeltPublishOutcome {
  let attempt_worktree = dispatch_worktree_path_for_instance(
    instance: instance,
    node_id: node_id as gunbc.roadmap_model.RoadmapNodeId,
    attempt_key: attempt_key,
  )
  match belt_publication_subject_for(
    node_id: node_id,
    attempt_key: attempt_key,
    branch: dispatch_branch_name(
      node_id: node_id as gunbc.roadmap_model.RoadmapNodeId,
      attempt_key: attempt_key,
    ),
    head: belt_worktree_head_observe(
      instance: instance,
      worktree: attempt_worktree,
    ),
  ) {
    PublicationSubjectUnobserved { reason } =>
      PublishDeferred { node_id: node_id, reason: reason }
    PublicationSubjectObserved { subject } => {
      match observe_worktree_repository_binding(
        worktree: attempt_worktree,
        repo: subject.repository,
      ) {
        WorktreeRemoteUnreadable { exit_code: code, stderr: err } =>
          PublishEvidenceUnreadable {
            node_id: node_id,
            detail: join([
              "the attempt worktree's origin remote could not be read, so it is unknown whether the head being published came from this repository (git exit ",
              to_string(code), "): ", err,
            ], ""),
          }
        WorktreeBoundElsewhere { observed: observed, expected: expected } =>
          PublishEvidenceUnreadable {
            node_id: node_id,
            detail: join([
              "the attempt worktree is a checkout of a different repository, so its head is not evidence about this subject — origin is ",
              observed, " but this publication is about ", expected as String,
            ], ""),
          }
        WorktreeBoundToRepository => {
          let path = dispatch_attempt_publication_receipt_path_for_instance(
            instance: instance,
            node_id: node_id as gunbc.roadmap_model.RoadmapNodeId,
            attempt_key: attempt_key,
            head_sha: subject.expected_head as String,
          )
          match belt_publish_gate(
            node_id: node_id,
            subject: subject,
            existing: belt_publication_receipt_source(
              instance: instance,
              node_id: node_id as gunbc.roadmap_model.RoadmapNodeId,
              attempt_key: attempt_key,
              subject: PublicationSubjectObserved { subject: subject },
            ),
          ) {
            PublishHalted { outcome } => outcome
            PublishProceed => {
              let receipt = publication_receipt_of(
                subject: subject,
                outcome: observe_publication_for_subject(
                  credential: credential,
                  subject: subject,
                ),
              )
              let write = Filesystem.Write(
                path: path,
                content: publication_receipt_json(receipt: receipt),
              )
              belt_publish_write_outcome(
                node_id: node_id,
                subject: subject,
                receipt: receipt,
                write_success: write.success,
                write_error: write.error,
              )
            }
          }
        }
      }
    }
  }
}

data belt_publish_credential_note: String = "THE CREDENTIAL IS PROBED FOR PRESENCE AND CARRIED AS A SOURCE, NEVER AS A VALUE. github.Pulls.List takes a CredentialSource - the same EnvVar row gunbc.tools.review_codex already passes - and the transport resolves it at the boundary, so the token itself never becomes a value in this graph. What this function establishes is only whether resolving it would find anything.\\n\\nWHY THE PROBE EXISTS AT ALL, rather than assuming presence: a publication read without a usable token is not a failed read, it is a read that must not be attempted. Sending an empty bearer produces a 401 whose only content is that we sent nothing - and the REST realization turns a 401 into a raise, so the most decidable failure on a fresh host would arrive as the least tractable kind of event. Probing turns it into an ordinary value that becomes a recorded refusal.\\n\\nTHE VALUE DOES TRANSIT, and pretending otherwise would be the overclaim. shell.Env.Get returns the variable's contents, so the token is briefly a String inside this process; only its emptiness escapes this function, and nothing stores or renders it. A presence probe that never read the value would need `test -n` against a variable this layer would have to name into a shell string, which is the composed-command shape the shell-to-intent lane exists to remove. Dissolve-on: a modeled presence-only environment probe, at which point this reads nothing.\\n\\nOutcomeIsData ADMISSIBILITY: printenv exits 1 when the variable is unset, and that exit IS the answer this function is asking for, not a fault. The result is a PublicationCredentialSource whose two arms ARE the adjudication - never unit - which is the shape belt_outcome_is_data_note requires of every annotated probe here."

data belt_publication_credential_source: std.credentials.CredentialSource = std.credentials.EnvVar { name: "GITHUB_TOKEN" }

fn belt_publication_credential() -> gunbc.roadmap_publish_observe.PublicationCredentialSource {
  match shell.Env.Get(name: "GITHUB_TOKEN" as std.types.NonEmptyStr, expect: OutcomeIsData).value {
    Present { value } =>
      if trim(value) == "" {
        CredentialSourceAbsent {
          reason: "GITHUB_TOKEN is set to an empty value in the belt's environment",
        }
      } else {
        CredentialSourceConfigured { source: belt_publication_credential_source }
      }
    Absent =>
      CredentialSourceAbsent {
        reason: "GITHUB_TOKEN is not set in the belt's environment",
      }
  }
}

fn belt_publish_pass_outcome_from(outcomes: List<BeltPublishOutcome>) -> BeltPassOutcome {
  let ledger_refusals = outcomes |> filter(o => match o {
    PublishDeferred { node_id: nid, reason: _ } => nid == ""
    PublishWriteFailed { node_id: _, detail: _ } => false
    PublishEvidenceUnreadable { node_id: _, detail: _ } => false
    PublishRecorded { node_id: _, head_sha: _, outcome_key: _ } => false
    PublishAlreadyRecorded { node_id: _, head_sha: _ } => false
  })
  if count(ledger_refusals) > 0 {
    match ledger_refusals.first() {
      Present { value: PublishDeferred { node_id: _, reason: r } } =>
        BeltPassRefused { reason: r }
      _ =>
        BeltPassRefused { reason: "the attempts ledger is unobservable" }
    }
  } else {
    if any(outcomes, o => match o {
      PublishWriteFailed { node_id: _, detail: _ } => true
      PublishEvidenceUnreadable { node_id: _, detail: _ } => true
      PublishDeferred { node_id: _, reason: _ } => false
      PublishRecorded { node_id: _, head_sha: _, outcome_key: _ } => false
      PublishAlreadyRecorded { node_id: _, head_sha: _ } => false
    }) {
      BeltPassFailed { reason: "one or more publication outcomes could not be recorded" }
    } else {
      BeltPassRecorded
    }
  }
}

fn belt_verification_segment(progress: gunbc.roadmap_workflow_progress.WorkflowAttemptProgress) -> gunbc.roadmap_workflow_stage.WorkflowSegment? {
  fold(progress.segments, init: none, f: (acc, s) => match acc {
    Present { value: v } => Present { value: v }
    Absent =>
      match s.kind {
        VerificationWorkflowSegment => Present { value: s }
        _ => none
      }
  })
}

fn belt_verification_presentation_detail(
  progress: gunbc.roadmap_workflow_progress.WorkflowAttemptProgress,
  tick_read: BeltTickReceiptRead,
) -> String {
  match belt_verification_segment(progress: progress) {
    Present { value: segment } =>
      match segment.state {
        WorkflowSegmentComplete =>
          join(["Verification passed · ", segment.detail], "")
        WorkflowSegmentFailed =>
          join(["Verification failed · ", segment.detail], "")
        WorkflowSegmentRefused =>
          join(["Verification refused · ", segment.detail], "")
        WorkflowSegmentActive =>
          join(["Verification running · ", progress.validation_summary], "")
        WorkflowSegmentPending =>
          match tick_read {
            BeltTickReceiptPresent { receipt } =>
              match receipt.verify_pass {
                BeltPassRefused { reason: r } =>
                  join(["Verification blocked · ", r], "")
                BeltPassFailed { reason: r } =>
                  join(["Verification failed · ", r], "")
                BeltPassDeferred { reason: _ } =>
                  "Verification queued - next belt tick"
                BeltPassRecorded =>
                  if string_contains(s: segment.detail, pattern: "could not be read") {
                    join(["Verification refused · ", segment.detail], "")
                  } else {
                    join(["Verification queued - next belt tick · ", segment.detail], "")
                  }
              }
            BeltTickReceiptAbsent =>
              "Verification queued - next belt tick"
            BeltTickReceiptUnreadable { reason: r } =>
              join(["Verification blocked · belt tick receipt unreadable: ", r], "")
          }
      }
    Absent =>
      "Verification unobserved"
  }
}

fn belt_tick_receipt_from_result(
  result: BeltTickResult,
  observed_at: String,
) -> BeltTickReceipt {
  BeltTickReceipt {
    observed_at: observed_at,
    spawn_pass: belt_spawn_pass_outcome_from(
      observe_refused: result.observe_refused,
      observe_reason: result.observe_refusal_reason,
      spawn_outcomes: result.spawn_outcomes,
    ),
    teardown_pass: belt_teardown_pass_outcome_from(
      observe_refused: result.observe_refused,
      observe_reason: result.observe_refusal_reason,
      teardown_outcomes: result.teardown_outcomes,
    ),
    verify_pass: belt_verify_pass_outcome_from(outcomes: result.verify_outcomes),
    publish_pass: belt_publish_pass_outcome_from(outcomes: result.publish_outcomes),
  }
}

data belt_publish_pass_note: String = "PUBLICATION RUNS ON THE SAME TICK AS SPAWN, TEARDOWN AND VERIFY, because it is the same kind of fact: a desired obligation reconciled against an observed one. A producer nobody calls is the defect this lane keeps producing - every piece of the publication path existed before this pass and none of it ever ran - so the wiring is the deliverable, not the type.\\n\\nIT RUNS PER ATTEMPT, OVER THE SAME OBSERVED LEDGER VERIFY USES, and it does NOT wait for the agent to finish. That is the difference from the verify pass and it is deliberate: verification is an action taken ON the attempt, so running it early would burn a validation against an unfinished tree, while publication is an OBSERVATION of the remote, so running it early records the true state - the branch is not published yet - and the next tick revises it. The gate is what makes that safe, since only a receipt saying the head is on offer stops the revisions.\\n\\nONE CREDENTIAL PROBE PER TICK, not one per attempt. The environment does not change between attempts within a tick, and probing per attempt would multiply a process spawn by the attempt count for an answer that cannot differ."

fn belt_publish_attempts_for_instance(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
) -> List<BeltPublishOutcome> {
  match belt_workflow_attempts_observe_for_instance(instance: instance) {
    WorkflowAttemptsRefused { reason } =>
      [
        PublishDeferred {
          node_id: "",
          reason: join([
            "the attempts ledger is unobservable, so no attempt's publication can be adjudicated: ",
            reason,
          ], ""),
        },
      ]
    WorkflowAttemptsObserved { attempts } => {
      let credential = belt_publication_credential()
      map(attempts, progress => belt_publish_attempt_for_instance(
        instance: instance,
        node_id: progress.node_id,
        attempt_key: progress.attempt_key,
        credential: credential,
      ))
    }
  }
}

fn belt_publish_attempts() -> List<BeltPublishOutcome> {
  belt_publish_attempts_for_instance(
    instance: srv1_live_dashboard_instance(),
  )
}

data belt_publish_node_note: String = "THE PRODUCER NEEDS A LIVE TRIGGER, AND belt_tick IS NOT ONE. belt_tick is the belt's actuation pass and nothing calls it - not the serve routes, not a timer, not the CLI. That is a pre-existing gap it shares with the verification pass, which is wired into the same tick and is equally undriven; this lane did not create it and does not close it.\\n\\nWhat it does mean is that wiring publication into belt_tick alone would leave the receipt unproduced in production, which is the exact defect the recut exists to fix, one layer further out. So publication also gets a per-node entry the serve table can reach, mirroring belt_dispatch_node_for_instance: an operator presses it, the receipt is written, and the next read of the row paints from it.\\n\\nIT RESOLVES THE ATTEMPT ITSELF rather than taking one, because the caller is a route holding only a node id. The current attempt pointer is the same authority the workflow projection reads, so both are answering about the same attempt by construction rather than by the caller passing a matching key.\\n\\nOBSERVE-ONLY INSTANCES REFUSE, like dispatch. Publication performs a network read and a filesystem write against an instance's own attempt state, so an instance declared observe-only must not perform either - and the refusal names the posture rather than reporting an absence."

fn belt_publish_node_for_instance(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  node_id: String,
) -> BeltPublishOutcome {
  match instance.actuation {
    DashboardObserveOnly =>
      PublishDeferred {
        node_id: node_id,
        reason: join([
          "dashboard instance ",
          instance.instance_id as String,
          " is observe-only, so publication was neither observed nor recorded",
        ], ""),
      }
    DashboardActuating => {
      let key_read = Filesystem.Read(
        path: dispatch_current_attempt_key_path_for_instance(
          instance: instance,
          node_id: node_id as gunbc.roadmap_model.RoadmapNodeId,
        ),
      )
      if !key_read.success || trim(key_read.content) == "" {
        PublishDeferred {
          node_id: node_id,
          reason: "this node has no current attempt, so there is no branch or head for publication to be about",
        }
      } else {
        belt_publish_attempt_for_instance(
          instance: instance,
          node_id: node_id,
          attempt_key: trim(key_read.content),
          credential: belt_publication_credential(),
        )
      }
    }
  }
}

data belt_publish_outcome_wire_note: String = "THE WIRE CARRIES THE OUTCOME KEY THE RECEIPT RECORDED, not a rendering of it. A caller that pressed publish wants to know which judgment was reached, and re-deriving that from a sentence is the prose-parsing move the receipt format itself was rewritten to remove. The detail is beside it for a human, never instead of it.\\n\\nTHE STATUS CODES SPLIT ON WHO HAS TO ACT. A recorded judgment and an already-recorded one are both 200, because the belt did what was asked and the row is now accurate either way. A deferral is 409 - the request was well formed and the attempt is not in a state where publication means anything yet. Unreadable evidence and a failed write are 500, because they are the belt's own problem and nothing about the request would change them."

fn belt_publish_outcome_key(o: BeltPublishOutcome) -> String {
  match o {
    PublishRecorded { node_id: _, head_sha: _, outcome_key: _ } => "recorded"
    PublishAlreadyRecorded { node_id: _, head_sha: _ } => "already-recorded"
    PublishEvidenceUnreadable { node_id: _, detail: _ } => "evidence-unreadable"
    PublishWriteFailed { node_id: _, detail: _ } => "write-failed"
    PublishDeferred { node_id: _, reason: _ } => "deferred"
  }
}

fn belt_publish_outcome_node_id(o: BeltPublishOutcome) -> String {
  match o {
    PublishRecorded { node_id, head_sha: _, outcome_key: _ } => node_id
    PublishAlreadyRecorded { node_id, head_sha: _ } => node_id
    PublishEvidenceUnreadable { node_id, detail: _ } => node_id
    PublishWriteFailed { node_id, detail: _ } => node_id
    PublishDeferred { node_id, reason: _ } => node_id
  }
}

fn belt_publish_outcome_head_sha(o: BeltPublishOutcome) -> String {
  match o {
    PublishRecorded { node_id: _, head_sha, outcome_key: _ } => head_sha
    PublishAlreadyRecorded { node_id: _, head_sha } => head_sha
    PublishEvidenceUnreadable { node_id: _, detail: _ } => ""
    PublishWriteFailed { node_id: _, detail: _ } => ""
    PublishDeferred { node_id: _, reason: _ } => ""
  }
}

fn belt_publish_outcome_publication_key(o: BeltPublishOutcome) -> String {
  match o {
    PublishRecorded { node_id: _, head_sha: _, outcome_key } => outcome_key
    PublishAlreadyRecorded { node_id: _, head_sha: _ } => ""
    PublishEvidenceUnreadable { node_id: _, detail: _ } => ""
    PublishWriteFailed { node_id: _, detail: _ } => ""
    PublishDeferred { node_id: _, reason: _ } => ""
  }
}

fn belt_publish_outcome_detail(o: BeltPublishOutcome) -> String {
  match o {
    PublishRecorded { node_id: _, head_sha: _, outcome_key: _ } => ""
    PublishAlreadyRecorded { node_id: _, head_sha: _ } => ""
    PublishEvidenceUnreadable { node_id: _, detail } => detail
    PublishWriteFailed { node_id: _, detail } => detail
    PublishDeferred { node_id: _, reason } => reason
  }
}

fn belt_publish_outcome_http_status(o: BeltPublishOutcome) -> Int {
  match o {
    PublishRecorded { node_id: _, head_sha: _, outcome_key: _ } => 200
    PublishAlreadyRecorded { node_id: _, head_sha: _ } => 200
    PublishDeferred { node_id: _, reason: _ } => 409
    PublishEvidenceUnreadable { node_id: _, detail: _ } => 500
    PublishWriteFailed { node_id: _, detail: _ } => 500
  }
}

fn belt_publish_outcome_json_value(o: BeltPublishOutcome) -> extdeps.languages.json.emit.JsonValue {
  json_object(members: [
    json_kv(key: "schema", value: json_string(s: "roadmap-belt-publish/v1")),
    json_kv(key: "outcome", value: json_string(s: belt_publish_outcome_key(o: o))),
    json_kv(key: "node_id", value: json_string(s: belt_publish_outcome_node_id(o: o))),
    json_kv(key: "head_sha", value: json_string(s: belt_publish_outcome_head_sha(o: o))),
    json_kv(
      key: "publication",
      value: json_string(s: belt_publish_outcome_publication_key(o: o)),
    ),
    json_kv(key: "detail", value: json_string(s: belt_publish_outcome_detail(o: o))),
  ])
}
