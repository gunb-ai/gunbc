data belt_actuate_exec_authority_note: String = "Slice 2b actuation: the belt DECISION (gunbc.roadmap_belt.belt_reconcile) is CLOSED against the host by three proven single-authorities — the actuator's HostExecArgv argv model (gunbc.roadmap_dispatch_actuator, the one place git/tmux/provider argv is shaped), gunbc.WitnessBin.Run (the typed-argv exec intrinsic, no shell string), and shell.Which.Check (program -> bin_path). Provider is a closed ClaudeCodeProvider | CodexCliProvider choice whose argv, preflight, and pane fingerprint move together. This remains fail-closed throughout: which-miss or auth uncertainty refuses before git worktree add; a worktree failure short-circuits tmux spawn; a nonzero provider process after tmux accepted is runtime evidence, not spawn evidence, and is deliberately NOT absorbed into Spawned-as-success."

data belt_actuate_placement_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.roadmap_dispatch_actuator",
    decl_name: "classify_dispatch_lease_upsert",
    field: WholeDeclaration
  }
}

data belt_actuate_fingerprint_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.roadmap_dispatch_actuator",
    decl_name: "dispatch_tmux_process_fingerprint_observation_dissolution_trigger",
    field: WholeDeclaration
  }
}

data belt_actuate_workdir_note: String = "Two DISTINCT workdirs, because the belt's two host verbs bind to different roots (a §5 fail-open otherwise: observing from a repo path that may not exist on an arbitrary host would make `tmux ls` fail and — before this split — get widened to an empty session set). belt_actuate_workdir is the SPAWN root: `git worktree add` must run inside the gunbc repo — a PROJECTION of gunbc.host_layout.srv1_gunbc_repo_root (the single path authority; its former private copy deleted, DESIGN §3): the same tree `gunbc serve` loads, which is why dispatch works in-process. belt_observe_workdir is the host-global root '/': `tmux ls` and `tmux kill-session` act on the per-user tmux server (a host singleton, not a repo), so they must run from a directory guaranteed to exist on the host — never the repo path, which may be absent (fake-claude test box, a freshly-enrolled srvN). Observe/teardown therefore carry no workdir parameter; only spawn is workdir-parameterized."

data belt_actuate_workdir: FilePath = srv1_gunbc_repo_root

data belt_observe_workdir: FilePath = "/" as FilePath

type BeltExecOutcome
  = ExecOk { stdout: String }
  | ExecFailed { program: String, exit_code: Int, stderr: String }
  | ExecRefused { program: String, reason: String }

data belt_program_available_note: String = "program-on-PATH probe via shell.Which.Check exit_success (Bool), NOT its .path field: the Which .path realization is a bare-stdout string wet (the Optional-over-Value::Null realization fork — DESIGN open thread), so the belt keys on the exit Bool and lets WitnessBin.Run's `env -C \{workdir\} \{bin_path\} args` resolve the bare program name via PATH (env execvp searches PATH). This keeps 'program missing' (refuse) distinct from 'program present, exited nonzero' (fail) without touching the Optional straddle."

data belt_outcome_is_data_note: String = "The three probes in this module are annotated OutcomeIsData (operator ruling 2026-07-25): their exit codes are ANSWERS the belt adjudicates, not faults. belt_program_available's which-miss is the 'program missing' pole this module's belt_program_available_note already keeps deliberately distinct from 'present but exited nonzero'; belt_exec's nonzero exit becomes ExecFailed; belt_observe's becomes a typed BeltObserve arm. In every case the belt renders the fault loudly through its own per-variant status mapping, so the effect layer's anomaly glyph was a second, cruder judgment of an event that already has a real adjudicator. ADMISSIBILITY (§5 guard, gunbc.output_policy outcome_is_data_note): each annotated fn returns a typed value whose arms ARE the adjudication — Bool for the availability probe (consumed as the refuse/fail discriminator, never discarded), BeltExecOutcome, BeltObserve — never unit. Dispatch failure stays anomalous: it is not an exit code and does not travel this arm."

fn belt_program_available(program: String) -> Bool {
  shell.Which.Check(command: program as NonEmptyStr, expect: OutcomeIsData).exists
}

fn belt_exec(cmd: HostExecArgv, workdir: String) -> BeltExecOutcome {
  if belt_program_available(program: cmd.program) {
    let result = gunbc.WitnessBin.Run(
      workdir: workdir as FilePath,
      bin_path: cmd.program as FilePath,
      args: cmd.args,
      expect: OutcomeIsData,
    )
    if result.success {
      ExecOk { stdout: result.stdout }
    } else {
      ExecFailed { program: cmd.program, exit_code: result.exit_code, stderr: result.stderr }
    }
  } else {
    ExecRefused {
      program: cmd.program,
      reason: "belt_exec: program not found on PATH (which exit nonzero); fail-closed, no fabricated success",
    }
  }
}

data belt_exec_all_fail_closed_note: String = "Fail-closed sequencing: fold runs each argv in order; once a step is non-ok (ExecFailed/ExecRefused) the accumulator SHORT-CIRCUITS — belt_exec is NOT called for the remaining steps and the first failure is returned. Spawn's worktree-add -> tmux-new-session ordering rides this: a failed git worktree add never spawns the tmux session (no orphan session on a missing worktree). Discriminating control: remove the ExecOk-guarded short-circuit and [false, echo] would run echo and go green when it must stay failed."

fn belt_exec_all(cmds: List<HostExecArgv>, workdir: String) -> BeltExecOutcome {
  fold(cmds, init: ExecOk { stdout: "" }, f: fn(acc, cmd) {
    match acc {
      ExecOk { stdout: _ } => belt_exec(cmd: cmd, workdir: workdir)
      ExecFailed { program: _, exit_code: _, stderr: _ } => acc
      ExecRefused { program: _, reason: _ } => acc
    }
  })
}

type BeltExecStep {
  step: String
  command: HostExecArgv
}

type BeltExecStepsOutcome
  = ExecStepsOk
  | ExecStepFailed { step: String, detail: String }

fn belt_exec_steps(
  steps: List<BeltExecStep>,
  workdir: String,
) -> BeltExecStepsOutcome {
  fold(steps, init: ExecStepsOk, f: fn(acc, step) {
    match acc {
      ExecStepFailed { step: _, detail: _ } => acc
      ExecStepsOk =>
        match belt_exec(cmd: step.command, workdir: workdir) {
          ExecOk { stdout: _ } => ExecStepsOk
          ExecFailed { program: _, exit_code, stderr } =>
            ExecStepFailed {
              step: step.step,
              detail: join([
                "exit ", to_string(exit_code), ": ", stderr,
              ], ""),
            }
          ExecRefused { program: _, reason } =>
            ExecStepFailed { step: step.step, detail: reason }
        }
    }
  })
}

type AttemptStateInitialization
  = AttemptStateInitialized
  | AttemptStateInitializationFailed { step: String, detail: String }

data attempt_state_publication_note: String = "A modeled attempt publishes an immutable evidence prefix before provider launch. After worktree and state-directory creation, the serve process writes the attempt key, the exact grounded environment-admission JSON receipt, and an empty provider-events.jsonl file through typed Filesystem.Write operations. Only then does it replace the node-current symlink. The replace may have a brief unreadable interval, which the observer reports as refusal and retries on its next poll; no atomicity is claimed for `ln -sfnT`. A readable current attempt is constructive proof that admission, workspace creation, and event capture initialization preceded provider launch; the progress route validates the admitted receipt rather than inferring those stages from a tmux name."

fn belt_attempt_state_initialize_for_instance(
  instance: HostDashboardInstance,
  node: RoadmapNode,
  attempt_key: String,
  admission_receipt: String,
) -> AttemptStateInitialization {
  let key_write = Filesystem.Write(
    path: dispatch_attempt_key_path_for_instance(
      instance: instance,
      node_id: node.node,
      attempt_key: attempt_key,
    ),
    content: attempt_key,
  )
  if !key_write.success {
    AttemptStateInitializationFailed {
      step: "attempt-key-write",
      detail: key_write.error,
    }
  } else {
    let admission_write = Filesystem.Write(
      path: dispatch_attempt_admission_path_for_instance(
        instance: instance,
        node_id: node.node,
        attempt_key: attempt_key,
      ),
      content: admission_receipt,
    )
    if !admission_write.success {
      AttemptStateInitializationFailed {
        step: "attempt-admission-write",
        detail: admission_write.error,
      }
    } else {
      let events_write = Filesystem.Write(
        path: dispatch_attempt_events_path_for_instance(
          instance: instance,
          node_id: node.node,
          attempt_key: attempt_key,
        ),
        content: "",
      )
      if events_write.success {
        let pin_persisted = belt_persist_oracle_pin_for_instance(
          instance: instance,
          node: node,
          attempt_key: attempt_key,
          capture: belt_attempt_oracle_pin_capture_for_instance(
            instance: instance,
            node: node,
            attempt_key: attempt_key,
          ),
        )
        let receipt_initialized = Filesystem.Write(
          path: dispatch_attempt_validation_receipt_path_for_instance(
            instance: instance,
            node_id: node.node,
            attempt_key: attempt_key,
          ),
          content: validation_receipt_json(
            verdict: ValidationNotRun,
            observations: belt_oracle_observations_in_worktree(
              contract: node.execution,
              worktree: dispatch_worktree_path_for_instance(
                instance: instance,
                node_id: node.node,
                attempt_key: attempt_key,
              ),
            ),
          ),
        ).success
        if !receipt_initialized {
          AttemptStateInitializationFailed {
            step: "attempt-validation-receipt-initialize",
            detail: "the not-run validation receipt could not be written beside the attempt; without it a later unreadable receipt is indistinguishable from an absent one, which is the conflation this initialization exists to remove",
          }
        } else if pin_persisted {
          AttemptStateInitialized
        } else {
          AttemptStateInitializationFailed {
            step: "attempt-oracle-pin-persist",
            detail: "the validation oracle pin could not be written beside the attempt; an attempt whose oracle is unrecorded can never be verified, and the write itself failing is a state-directory fault rather than a verification-side deficit",
          }
        }
      } else {
        AttemptStateInitializationFailed {
          step: "attempt-events-initialize",
          detail: events_write.error,
        }
      }
    }
  }
}

data belt_oracle_pin_capture_note: String = "The pin is captured from the FRESHLY CREATED WORKTREE, before the provider is spawned, because that is the only moment the oracle is known to be the base revision's oracle and not the attempt's. Reading it from the controller repo instead would be a different tree that nothing ties to this attempt; reading it after the agent runs is the fail-open this whole lane closes. Ordering is therefore load-bearing and it is already the ordering the staged spawn establishes: worktree-add and attempt-state-prepare run first, this capture runs inside state initialization, and tmux-session-create runs only after. A capture failure does NOT fail the spawn — the agent's work is still worth doing and a dispatch that refuses on a verification-side deficit would trade a whole attempt for a receipt — but it is never silent either: the reason is persisted to its own file, so verification reports a located cause instead of an absent pin, and the deficit stays countable at the Verify lamp rather than having its frequency zeroed."

type AttemptOraclePinCapture
  = OraclePinRecorded {
      identity: ContentHash,
      revision: String,
    }
  | OraclePinNotRecorded { reason: String }

data belt_oracle_refs_primitive_note: String = "This projection used filter_map, which type-checks and DOES NOT RUN: std.primitives declares a filter_map contract but the seed registers no method for it, so the call reached the interpreter as `not yet implemented` and took the dispatch route to a 500. Found by a live dispatch on the lab, not by the whole-tree compile (0 blocking errors) and not by this lane's own witnesses — which is the specification-without-execution trap in DESIGN section 5 landing one layer below where this PR was watching for it: I checked that MY functions were exercised and never checked that the PRIMITIVES they call exist. The corpus had zero filter_map call sites before this change, which is why nothing else had already surfaced it. flat_map is the same fold with a registered implementation, and returning a one-or-zero element list is exactly the Present/none the contract described."

fn belt_oracle_refs_for_contract(
  contract: WorkItemExecutionContract,
) -> List<ValidationOracleRef> {
  validation_oracle_scopes(contract: contract)
    |> flat_map(scope => match scope {
      OraclePinnable { oracle } => [oracle]
      OracleNotPinnable { validation_label: _, reason: _ } => []
    })
}

fn belt_oracle_observe_in_worktree(
  worktree: String,
  oracle: ValidationOracleRef,
) -> OracleObservation {
  let read = Filesystem.Read(
    path: join([worktree, "/", oracle.entry as String], ""),
  )
  validation_oracle_observe_from_source(
    oracle: oracle,
    source_readable: read.success,
    source: read.content,
    read_error: read.error,
  )
}

fn belt_oracle_observations_in_worktree(
  contract: WorkItemExecutionContract,
  worktree: String,
) -> List<OracleObservation> {
  belt_oracle_refs_for_contract(contract: contract)
    |> map(oracle => belt_oracle_observe_in_worktree(
      worktree: worktree,
      oracle: oracle,
    ))
}

fn belt_worktree_head_revision(
  instance: HostDashboardInstance,
  worktree: String,
) -> String {
  match belt_exec(
    cmd: host_exec_argv(
      program: dispatch_capability_program(
        environment: instance.execution_environment,
        cap: GitWorkspaceCapability,
      ),
      args: shape_git_rev_parse_head_args(),
    ),
    workdir: worktree,
  ) {
    ExecOk { stdout } => trim(stdout)
    ExecFailed { program: _, exit_code: _, stderr: _ } => ""
    ExecRefused { program: _, reason: _ } => ""
  }
}

fn belt_attempt_oracle_pin_capture_for_instance(
  instance: HostDashboardInstance,
  node: RoadmapNode,
  attempt_key: String,
) -> AttemptOraclePinCapture {
  let worktree = dispatch_worktree_path_for_instance(
    instance: instance,
    node_id: node.node,
    attempt_key: attempt_key,
  )
  let refs = belt_oracle_refs_for_contract(contract: node.execution)
  if count(refs) == 0 {
    OraclePinNotRecorded {
      reason: "this node's execution contract declares no validation whose oracle can be pinned",
    }
  } else {
    match validation_oracle_set_observe(
      observations: belt_oracle_observations_in_worktree(
        contract: node.execution,
        worktree: worktree,
      ),
    ) {
      OracleSetIncomplete { blocking: _, observations: _ } =>
        OraclePinNotRecorded {
          reason: join([
            "the declared validation oracle was not observable in the attempt worktree at ",
            worktree,
            " when the attempt was created",
          ], ""),
        }
      OracleSetObserved { identity, observations: _ } => {
        let revision = belt_worktree_head_revision(
          instance: instance,
          worktree: worktree,
        )
        if revision == "" {
          OraclePinNotRecorded {
            reason: "the attempt worktree's head revision could not be read, so the pinned oracle could not be attributed to a revision",
          }
        } else {
          OraclePinRecorded {
            identity: identity,
            revision: revision,
          }
        }
      }
    }
  }
}

fn belt_persist_oracle_pin_for_instance(
  instance: HostDashboardInstance,
  node: RoadmapNode,
  attempt_key: String,
  capture: AttemptOraclePinCapture,
) -> Bool {
  match capture {
    OraclePinNotRecorded { reason } =>
      Filesystem.Write(
        path: dispatch_attempt_oracle_pin_refusal_path_for_instance(
          instance: instance,
          node_id: node.node,
          attempt_key: attempt_key,
        ),
        content: reason,
      ).success
    OraclePinRecorded { identity, revision } => {
      let identity_write = Filesystem.Write(
        path: dispatch_attempt_oracle_identity_path_for_instance(
          instance: instance,
          node_id: node.node,
          attempt_key: attempt_key,
        ),
        content: identity as String,
      )
      let revision_write = Filesystem.Write(
        path: dispatch_attempt_oracle_revision_path_for_instance(
          instance: instance,
          node_id: node.node,
          attempt_key: attempt_key,
        ),
        content: revision,
      )
      identity_write.success && revision_write.success
    }
  }
}

fn belt_created_session_cleanup_detail(
  instance: HostDashboardInstance,
  session_name: String,
) -> String {
  match belt_exec(
    cmd: tmux_kill_session_argv_for_instance(
      instance: instance,
      session_name: session_name,
    ),
    workdir: belt_observe_workdir as String,
  ) {
    ExecOk { stdout: _ } => "created session reaped"
    ExecFailed { program: _, exit_code, stderr } =>
      join([
        "created-session cleanup failed with exit ",
        to_string(exit_code),
        ": ",
        stderr,
      ], "")
    ExecRefused { program: _, reason } =>
      join(["created-session cleanup refused: ", reason], "")
  }
}

fn belt_persist_spawn_failure_for_instance(
  instance: HostDashboardInstance,
  node: RoadmapNode,
  attempt_key: String,
  step: String,
  detail: String,
) -> String {
  let evidence = join([step, ": ", detail], "")
  let write = Filesystem.Write(
    path: dispatch_attempt_spawn_failure_path_for_instance(
      instance: instance,
      node_id: node.node,
      attempt_key: attempt_key,
    ),
    content: evidence,
  )
  if write.success {
    detail
  } else {
    join([
      detail,
      "; additionally failed to persist spawn evidence: ",
      write.error,
    ], "")
  }
}

type BeltSpawnOutcome
  = Spawned { node_id: String, session_name: String }
  | SpawnFailed { node_id: String, step: String, detail: String }

data belt_claude_preflight_note: String = "Spawn preflights the CLAUDE dependency before any actuation, because both of its failure classes pass the exec seam SILENTLY (§5, found live 2026-07-23): tmux new-session exits 0 even when the inner claude is missing (the pane dies instantly behind a fabricated Spawned), and an unseeded workspace-trust root blocks claude INTERACTIVELY on its per-path trust dialog (a hung session, not an error — --dangerously-skip-permissions does not cover it). Both are decidable BEFORE spawning, so they refuse as typed SpawnFailed rows: claude-on-PATH via the same shell.Which authority belt_exec uses (step claude-cli), then the trust seed for the ONE dispatch worktree root read from the claude trust store and classified by extdeps.llm.cli.claude_workspace_trust_seeded — the modeled home of what was hand-provisioned on srv1 at go-live (ancestor-inheritance makes the single root sufficient; steps claude-trust-home / claude-trust-store / claude-trust-seed, each detail naming the exact convergence). The DECISION is the pure witnessed fn (belt_claude_preflight_decision, every arm exercised on synthetic facts — same shape as belt_observe_from_result); belt_claude_preflight only threads live observations into it. Residue: refuse-with-instructions, not auto-seed — the trust store is claude's own mutable file (claude rewrites it at runtime), so a read-modify-write APPLY arm races the upstream writer; seeding stays with the live_deploy membership convergence (the go-live receipt's named dissolution)."

type BeltClaudePreflight
  = ClaudePreflightOk
  | ClaudePreflightRefused { step: String, detail: String }

fn belt_claude_preflight_decision(
  claude_on_path: Bool,
  home: String,
  trust_store_path: String,
  trust_store_readable: Bool,
  trust_store_text: String,
  trust_root: String,
) -> BeltClaudePreflight {
  if !claude_on_path {
    ClaudePreflightRefused {
      step: "claude-cli",
      detail: "claude not found on PATH (which exit nonzero); tmux would spawn a pane that dies instantly — fail-closed, no fabricated Spawned",
    }
  } else if home == "" {
    ClaudePreflightRefused {
      step: "claude-trust-home",
      detail: "HOME unset or empty — cannot locate the claude trust store (~/.claude.json), so the workspace-trust seed is unknowable; fail-closed",
    }
  } else if !trust_store_readable {
    ClaudePreflightRefused {
      step: "claude-trust-store",
      detail: concat(
        concat("claude trust store unreadable at ", trust_store_path),
        " — claude blocks on its workspace-trust dialog for an unseeded root; seed it by launching claude once under the dispatch worktree root, or converge via the live_deploy membership",
      ),
    }
  } else if !claude_workspace_trust_seeded(config_text: trust_store_text, project_path: trust_root) {
    ClaudePreflightRefused {
      step: "claude-trust-seed",
      detail: concat(
        concat(concat("workspace trust not seeded for ", trust_root), " in "),
        concat(trust_store_path, " (projects entry with hasTrustDialogAccepted: true) — claude would block interactively on its trust dialog; ancestor-dir trust inheritance means seeding this ONE root covers every dispatch worktree"),
      ),
    }
  } else {
    ClaudePreflightOk
  }
}

fn belt_claude_preflight_for_instance(instance: HostDashboardInstance) -> BeltClaudePreflight {
  let claude_ok = belt_program_available(program: claude_cli_program)
  let home = match shell.Env.Get(name: "HOME" as NonEmptyStr).value {
    Absent => ""
    Present { value: v } => v
  }
  if !claude_ok || home == "" {
    belt_claude_preflight_decision(
      claude_on_path: claude_ok,
      home: home,
      trust_store_path: "",
      trust_store_readable: false,
      trust_store_text: "",
      trust_root: instance.dispatch_worktree_root as String,
    )
  } else {
    let path = claude_trust_store_path(home: home)
    let r = Filesystem.Read(path: path)
    belt_claude_preflight_decision(
      claude_on_path: claude_ok,
      home: home,
      trust_store_path: path,
      trust_store_readable: r.success,
      trust_store_text: r.content,
      trust_root: instance.dispatch_worktree_root as String,
    )
  }
}

fn belt_claude_preflight() -> BeltClaudePreflight {
  belt_claude_preflight_for_instance(instance: srv1_live_dashboard_instance())
}

type BeltCodexPreflight
  = CodexPreflightOk { auth_method: String }
  | CodexPreflightRefused { step: String, detail: String }

data belt_codex_preflight_note: String = "Codex preflight owns only facts decidable before actuation. Exact env and codex executable paths are admitted first. It then executes `env CODEX_HOME=<dedicated-root> codex --version` and requires the provider identity marker before separately executing `codex login status`; this distinguishes a broken npm launcher/runtime dependency from unauthenticated OAuth. Login exit 0 is the CLI's active-auth verdict and stdout is retained as the method receipt; it never parses auth.json or treats file presence as authentication. Subscription exhaustion and upstream/rate failures occur only after codex exec starts; those belong to provider JSONL (`turn.failed` / `error`) plus retained process exit."

fn belt_codex_preflight_decision_observed_for_home(
  codex_home: String,
  codex_on_path: Bool,
  env_on_path: Bool,
  identity_command_success: Bool,
  identity_stdout: String,
  identity_stderr: String,
  login_status_success: Bool,
  login_status_stdout: String,
  login_status_stderr: String,
) -> BeltCodexPreflight {
  let identity_realized = identity_command_success
    && string_contains(
      s: join([identity_stdout, "\n", identity_stderr], ""),
      pattern: codex_cli_identity_contains,
    )
  if !codex_on_path {
    CodexPreflightRefused {
      step: "codex-cli",
      detail: "codex not found on PATH; refusing before worktree creation",
    }
  } else if !env_on_path {
    CodexPreflightRefused {
      step: "codex-env",
      detail: "env not found on PATH; cannot bind the dedicated CODEX_HOME for auth or execution",
    }
  } else if !identity_realized {
    CodexPreflightRefused {
      step: "codex-identity",
      detail: join([
        "codex --version did not realize ",
        codex_cli_identity_contains,
        "; stdout: ",
        identity_stdout,
        "; stderr: ",
        identity_stderr,
      ], ""),
    }
  } else if !login_status_success {
    CodexPreflightRefused {
      step: "codex-auth",
      detail: join([
        "codex login status exited nonzero for ",
        codex_home,
        "; stdout: ",
        login_status_stdout,
        "; stderr: ",
        login_status_stderr,
      ], ""),
    }
  } else {
    CodexPreflightOk { auth_method: login_status_stdout }
  }
}

fn belt_codex_preflight_for_instance(instance: HostDashboardInstance) -> BeltCodexPreflight {
  let codex_home = dashboard_instance_provider_state_root(instance: instance) as String
  let codex_program = dashboard_instance_provider_executable(instance: instance) as String
  let env_program = dispatch_capability_program(
    environment: instance.execution_environment,
    cap: EnvironmentBindingCapability,
  )
  let codex_ok = belt_program_available(program: codex_program)
  let env_ok = belt_program_available(program: env_program)
  if !codex_ok || !env_ok {
    belt_codex_preflight_decision_observed_for_home(
      codex_home: codex_home,
      codex_on_path: codex_ok,
      env_on_path: env_ok,
      identity_command_success: false,
      identity_stdout: "",
      identity_stderr: "",
      login_status_success: false,
      login_status_stdout: "",
      login_status_stderr: "",
    )
  } else {
    let identity = gunbc.WitnessBin.Run(
      workdir: belt_observe_workdir,
      bin_path: env_program as FilePath,
      args: shape_codex_version_env_args_for_program(
        program: codex_program,
        codex_home: codex_home,
      ),
      expect: OutcomeIsData,
    )
    let identity_realized = identity.success
      && string_contains(
        s: join([identity.stdout, "\n", identity.stderr], ""),
        pattern: codex_cli_identity_contains,
      )
    if !identity_realized {
      belt_codex_preflight_decision_observed_for_home(
        codex_home: codex_home,
        codex_on_path: codex_ok,
        env_on_path: env_ok,
        identity_command_success: identity.success,
        identity_stdout: identity.stdout,
        identity_stderr: identity.stderr,
        login_status_success: false,
        login_status_stdout: "",
        login_status_stderr: "",
      )
    } else {
    let result = gunbc.WitnessBin.Run(
      workdir: belt_observe_workdir,
      bin_path: env_program as FilePath,
      args: shape_codex_login_status_env_args_for_program(
        program: codex_program,
        codex_home: codex_home,
      ),
      expect: OutcomeIsData,
    )
    belt_codex_preflight_decision_observed_for_home(
      codex_home: codex_home,
      codex_on_path: codex_ok,
      env_on_path: env_ok,
      identity_command_success: identity.success,
      identity_stdout: identity.stdout,
      identity_stderr: identity.stderr,
      login_status_success: result.success,
      login_status_stdout: result.stdout,
      login_status_stderr: result.stderr,
    )
    }
  }
}

fn belt_codex_preflight() -> BeltCodexPreflight {
  belt_codex_preflight_for_instance(instance: srv1_live_dashboard_instance())
}

type BeltProviderPreflight
  = ProviderPreflightOk
  | ProviderPreflightRefused { step: String, detail: String }

fn belt_provider_preflight_for_instance(
  instance: HostDashboardInstance,
  provider: DispatchCliProvider,
) -> BeltProviderPreflight {
  match provider {
    ClaudeCodeProvider =>
      match belt_claude_preflight_for_instance(instance: instance) {
        ClaudePreflightOk => ProviderPreflightOk
        ClaudePreflightRefused { step: st, detail: d } =>
          ProviderPreflightRefused { step: st, detail: d }
      }
    CodexCliProvider =>
      match belt_codex_preflight_for_instance(instance: instance) {
        CodexPreflightOk { auth_method: _ } => ProviderPreflightOk
        CodexPreflightRefused { step: st, detail: d } =>
          ProviderPreflightRefused { step: st, detail: d }
      }
  }
}

fn belt_provider_preflight(provider: DispatchCliProvider) -> BeltProviderPreflight {
  belt_provider_preflight_for_instance(
    instance: srv1_live_dashboard_instance(),
    provider: provider,
  )
}

data belt_footprint_admission_note: String = "Step 0b: the runtime admits against its own deployment footprint BEFORE it mutates anything, because the 2026-07-30 incident proved the belt learns about a missing root in the worst possible order. Staging ran `git worktree add` (389ms, succeeded) and then `install -d` into an attempt-state root that did not exist under a root-owned parent (3ms, EACCES) — so the fail-closed short-circuit worked exactly as designed and still left an orphan branch and worktree behind on every click, because the first durable mutation had already happened by the time the deficit was discovered. Step 0a made the root a converged deployment member so it EXISTS; this gate makes its absence or unwritability REFUSE FIRST, which is the difference between a class that cannot recur and a class that recurs once per host between deploys.\\n\\nTHE ROOTS COME FROM THE INSTANCE, NOT FROM live_deploy's srv1 roster. That is deliberate and not a second footprint: the instance is the runtime's own view of the paths it writes, so a lab/preview instance under a disjoint root admits against ITS roots rather than production's, while gunbc.live_deploy.spec stays the provisioner's view of srv1. Step 1 unifies the two into one member list with permissions; until then the belt reads the value it was handed rather than importing a host-specific roster it has no business knowing.\\n\\nWRITABILITY IS PROBED AS WRITE **AND** SEARCH, because POSIX requires both to create an entry in a directory: `test -w` alone would pass on a mode-0644 directory and the very next `install -d` would still fail, which is the fabricated-precondition shape this gate exists to remove. Search permission reuses shell.Test.IsExecutable — `test -x` on a directory IS the search bit, so this is the cited operation read in its directory sense, never a minted directory-specific probe. The frame is the EFFECTIVE principal: these probes run in the serve process, so they answer for the account that will actually perform the mutation, which is the only question worth asking (a provisioner-side SSH probe would answer for the deploy principal and admit a root the runtime cannot write).\\n\\nKnown conflation, named rather than modeled away: a probe that could not execute at all reads as present=false, the same as a genuinely absent root. Both arms REFUSE, so nothing is fabricated in either direction and the remedy is a converge in both; only the detail line would misattribute, and `test` is a coreutils/shell builtin whose absence would have already broken belt_exec's which-check. Splitting it would add a third state whose two branches take the same action.\\n\\nOutcomeIsData ADMISSIBILITY (discharging the review obligation gunbc.output_policy outcome_is_data_note leaves open): all three probes are annotated because a non-zero `test` exit here is an ANSWER — root absent / not writable / not searchable — and it is ambient in both contexts, since production responds by refusing the spawn and the witnesses respond by asserting the refusal arm. The guard is satisfied structurally, not by assertion: belt_footprint_observe returns BeltFootprintObservation and belt_footprint_admission_for_instance returns BeltFootprintAdmission, so each exit provably feeds a typed consumer and neither returns unit. Dispatch failure of the probe ITSELF remains anomalous and is not silenced by the annotation."

type BeltFootprintRoot {
  member: String
  path: String
}

fn belt_dispatch_footprint_roots(instance: HostDashboardInstance) -> List<BeltFootprintRoot> {
  [
    BeltFootprintRoot {
      member: "dispatch-worktree-root",
      path: instance.dispatch_worktree_root as String,
    },
    BeltFootprintRoot {
      member: "attempt-state-root",
      path: instance.dispatch_attempt_state_root as String,
    },
  ]
}

type BeltFootprintObservation {
  member: String
  path: String
  present: Bool
  writable: Bool
  searchable: Bool
}

type BeltFootprintAdmission
  = FootprintAdmitted
  | FootprintRefused { step: String, detail: String }

fn belt_footprint_root_verdict(obs: BeltFootprintObservation) -> BeltFootprintAdmission {
  if !obs.present {
    FootprintRefused {
      step: "footprint-root-absent",
      detail: join([
        "deployment member ", obs.member, " is not a directory at ", obs.path,
        " — the belt writes there on every dispatch, so staging would mutate the worktree and then fail; converge the member (gunbc.live_deploy.spec deployment_owned_steps) rather than creating it by hand",
      ], ""),
    }
  } else if !obs.writable {
    FootprintRefused {
      step: "footprint-root-unwritable",
      detail: join([
        "deployment member ", obs.member, " at ", obs.path,
        " is not writable by the effective runtime principal — the deploy converges it owned by the service user; a root owned by anyone else means the instance was hand-provisioned or the member's ownership drifted",
      ], ""),
    }
  } else if !obs.searchable {
    FootprintRefused {
      step: "footprint-root-unsearchable",
      detail: join([
        "deployment member ", obs.member, " at ", obs.path,
        " is writable but not searchable by the effective runtime principal — POSIX requires write AND search to create an entry, so staging would still fail on a directory this gate would otherwise admit",
      ], ""),
    }
  } else {
    FootprintAdmitted
  }
}

fn belt_footprint_admission_decision(
  observations: List<BeltFootprintObservation>,
) -> BeltFootprintAdmission {
  fold(observations, init: FootprintAdmitted, f: (acc, obs) =>
    match acc {
      FootprintRefused { step: st, detail: d } =>
        FootprintRefused { step: st, detail: d }
      FootprintAdmitted => belt_footprint_root_verdict(obs: obs)
    }
  )
}

fn belt_footprint_observe(root: BeltFootprintRoot) -> BeltFootprintObservation {
  BeltFootprintObservation {
    member: root.member,
    path: root.path,
    present: shell.Test.IsDirectory(
      path: root.path as FilePath,
      expect: OutcomeIsData,
    ).is_directory,
    writable: shell.Test.IsWritable(
      path: root.path as FilePath,
      expect: OutcomeIsData,
    ).writable,
    searchable: shell.Test.IsExecutable(
      path: root.path as FilePath,
      expect: OutcomeIsData,
    ).executable,
  }
}

fn belt_footprint_admission_for_instance(
  instance: HostDashboardInstance,
) -> BeltFootprintAdmission {
  belt_footprint_admission_decision(
    observations: map(
      belt_dispatch_footprint_roots(instance: instance),
      r => belt_footprint_observe(root: r),
    ),
  )
}

fn belt_actuate_spawn_for_instance(
  instance: HostDashboardInstance,
  node: RoadmapNode,
  probed_at: String,
) -> BeltSpawnOutcome {
  match belt_footprint_admission_for_instance(instance: instance) {
    FootprintRefused { step: fst, detail: fd } =>
      SpawnFailed { node_id: node.node as String, step: fst, detail: fd }
    FootprintAdmitted =>
  match dispatch_environment_admit(
    contract: node.execution,
    environment: instance.execution_environment,
  ) {
    EnvironmentRefused { receipts, validation_summary, reason } =>
      SpawnFailed {
        node_id: node.node as String,
        step: "environment-admission",
        detail: dispatch_environment_admission_json(
          admission: EnvironmentRefused {
            receipts: receipts,
            validation_summary: validation_summary,
            reason: reason,
          },
        ),
      }
    EnvironmentAdmitted { receipts, validation_summary } =>
      match belt_provider_preflight_for_instance(
        instance: instance,
        provider: dispatch_cli_provider,
      ) {
        ProviderPreflightRefused { step: st, detail: d } =>
          SpawnFailed { node_id: node.node as String, step: st, detail: d }
        ProviderPreflightOk =>
          belt_actuate_spawn_exec_for_instance(
            instance: instance,
            node: node,
            probed_at: probed_at,
            admission_receipt: dispatch_environment_admission_json(
              admission: EnvironmentAdmitted {
                receipts: receipts,
                validation_summary: validation_summary,
              },
            ),
          )
      }
  }
  }
}

fn belt_actuate_spawn_exec_for_instance(
  instance: HostDashboardInstance,
  node: RoadmapNode,
  probed_at: String,
  admission_receipt: String,
) -> BeltSpawnOutcome {
  belt_actuate_spawn_exec_modeled(
    instance: instance,
    node: node,
    probed_at: probed_at,
    workdir: instance.repo_root as String,
    admission_receipt: admission_receipt,
  )
}

data belt_staged_spawn_cleanup_note: String = "The tmux creation boundary is explicit. Worktree/state publication happens before tmux; tmux new-session runs alone; only after its success do session configuration, pipe attachment, and provider respawn run. A later staging failure reaps exactly the session this same request just created, without relying on a name-only ownership guess. Worktree, branch, and attempt evidence are deliberately retained for diagnosis and user work. The original located failure plus cleanup receipt is persisted under the published attempt before SpawnFailed returns."

fn belt_actuate_spawn_exec_modeled(
  instance: HostDashboardInstance,
  node: RoadmapNode,
  probed_at: String,
  workdir: String,
  admission_receipt: String,
) -> BeltSpawnOutcome {
  let attempt_key = dispatch_attempt_key(
    node_id: node.node,
    probed_at: probed_at,
  )
  let session_name = dispatch_tmux_session_name(node_id: node.node)
  match dispatch_spawn_commands_for_instance(
    instance: instance,
    node: node,
    session_uuid: belt_spawn_session_uuid(node_id: node.node as String, probed_at: probed_at),
    attempt_key: attempt_key,
    provider: dispatch_cli_provider,
  ) {
    DispatchSpawnRefused { step, detail } =>
      SpawnFailed {
        node_id: node.node as String,
        step: step as String,
        detail: detail,
      }
    DispatchSpawnReady { commands: cmds } =>
  match belt_exec_steps(
    steps: [
      BeltExecStep { step: "worktree-add", command: cmds.worktree_add },
      BeltExecStep {
        step: "attempt-state-prepare",
        command: cmds.attempt_state_prepare,
      },
    ],
    workdir: workdir,
  ) {
    ExecStepFailed { step, detail } =>
      SpawnFailed {
        node_id: node.node as String,
        step: step,
        detail: detail,
      }
    ExecStepsOk =>
      match belt_attempt_state_initialize_for_instance(
        instance: instance,
        node: node,
        attempt_key: attempt_key,
        admission_receipt: admission_receipt,
      ) {
        AttemptStateInitializationFailed { step, detail } =>
          SpawnFailed {
            node_id: node.node as String,
            step: step,
            detail: detail,
          }
        AttemptStateInitialized =>
          match belt_exec_steps(
            steps: [
              BeltExecStep {
                step: "attempt-current-publish",
                command: cmds.attempt_current_pointer,
              },
            ],
            workdir: workdir,
          ) {
            ExecStepFailed { step, detail } =>
              SpawnFailed {
                node_id: node.node as String,
                step: step,
                detail: detail,
              }
            ExecStepsOk =>
              match belt_exec_steps(
                steps: [
                  BeltExecStep {
                    step: "tmux-session-create",
                    command: cmds.tmux_spawn,
                  },
                ],
                workdir: workdir,
              ) {
                ExecStepFailed { step, detail } =>
                  SpawnFailed {
                    node_id: node.node as String,
                    step: step,
                    detail: belt_persist_spawn_failure_for_instance(
                      instance: instance,
                      node: node,
                      attempt_key: attempt_key,
                      step: step,
                      detail: detail,
                    ),
                  }
                ExecStepsOk =>
                  match belt_exec_steps(
                    steps: [
                      BeltExecStep {
                        step: "tmux-default-shell",
                        command: cmds.tmux_default_shell,
                      },
                      BeltExecStep {
                        step: "tmux-remain-on-exit",
                        command: cmds.tmux_remain_on_exit,
                      },
                      BeltExecStep {
                        step: "tmux-event-pipe",
                        command: cmds.tmux_event_pipe,
                      },
                      BeltExecStep {
                        step: "provider-start",
                        command: cmds.provider_start,
                      },
                    ],
                    workdir: workdir,
                  ) {
                    ExecStepsOk =>
                      Spawned {
                        node_id: node.node as String,
                        session_name: session_name,
                      }
                    ExecStepFailed { step, detail } => {
                      let cleanup = belt_created_session_cleanup_detail(
                        instance: instance,
                        session_name: session_name,
                      )
                      let full_detail = join([
                        detail,
                        "; ",
                        cleanup,
                      ], "")
                      SpawnFailed {
                        node_id: node.node as String,
                        step: step,
                        detail: belt_persist_spawn_failure_for_instance(
                          instance: instance,
                          node: node,
                          attempt_key: attempt_key,
                          step: step,
                          detail: full_detail,
                        ),
                      }
                    }
                  }
              }
          }
      }
  }
}
}

fn belt_actuate_spawn(node: RoadmapNode, probed_at: String, workdir: String) -> BeltSpawnOutcome {
  let instance = srv1_live_dashboard_instance()
  match dispatch_environment_admit(
    contract: node.execution,
    environment: instance.execution_environment,
  ) {
    EnvironmentRefused { receipts, validation_summary, reason } =>
      SpawnFailed {
        node_id: node.node as String,
        step: "environment-admission",
        detail: dispatch_environment_admission_json(
          admission: EnvironmentRefused {
            receipts: receipts,
            validation_summary: validation_summary,
            reason: reason,
          },
        ),
      }
    EnvironmentAdmitted { receipts, validation_summary } =>
      match belt_provider_preflight(provider: dispatch_cli_provider) {
        ProviderPreflightRefused { step: st, detail: d } =>
          SpawnFailed { node_id: node.node as String, step: st, detail: d }
        ProviderPreflightOk =>
          belt_actuate_spawn_exec(
            node: node,
            probed_at: probed_at,
            workdir: workdir,
            admission_receipt: dispatch_environment_admission_json(
              admission: EnvironmentAdmitted {
                receipts: receipts,
                validation_summary: validation_summary,
              },
            ),
          )
      }
  }
}

fn belt_actuate_spawn_exec(
  node: RoadmapNode,
  probed_at: String,
  workdir: String,
  admission_receipt: String,
) -> BeltSpawnOutcome {
  belt_actuate_spawn_exec_modeled(
    instance: srv1_live_dashboard_instance(),
    node: node,
    probed_at: probed_at,
    workdir: workdir,
    admission_receipt: admission_receipt,
  )
}

type BeltTeardownOutcome
  = ReapedSession { session_name: String }
  | TeardownFailed { session_name: String, detail: String }

fn belt_actuate_teardown_for_instance(
  instance: HostDashboardInstance,
  session_name: String,
) -> BeltTeardownOutcome {
  match belt_exec(
    cmd: tmux_kill_session_argv_for_instance(
      instance: instance,
      session_name: session_name,
    ),
    workdir: belt_observe_workdir as String,
  ) {
    ExecOk { stdout: _ } => ReapedSession { session_name: session_name }
    ExecFailed { program: _, exit_code: _, stderr: e } =>
      TeardownFailed { session_name: session_name, detail: e }
    ExecRefused { program: _, reason: r } =>
      TeardownFailed { session_name: session_name, detail: r }
  }
}

fn belt_actuate_teardown(session_name: String) -> BeltTeardownOutcome {
  belt_actuate_teardown_for_instance(
    instance: srv1_live_dashboard_instance(),
    session_name: session_name,
  )
}

data belt_actuate_member_shape_note: String = "The reconcile guarantees spawns are DesiredMembers (carry the RoadmapNode for the brief) and teardowns are ObservedMembers (carry the live session). The cross arms are unreachable by construction; if ever reached they REFUSE (typed SpawnFailed/TeardownFailed), never a fabricated action — DESIGN §5 (no spawn without a node model, no teardown without an observed session)."

data belt_session_uuid_salt: NonEmptyStr = "belt-session-uuid-v1" as NonEmptyStr

data belt_spawn_session_uuid_note: String = "The UUID is the Claude provider's --session-id input; Claude requires a syntactically valid UUID. It remains computed for every provider so dispatch_spawn_commands has one stable arity, but CodexCliProvider deliberately ignores it and lets Codex mint its persisted thread id. For Claude the UUID is ATTEMPT-scoped (U1 redispatch fix 2026-07-25): derived from (node_id x the spawn's clock observation), reshaped to RFC-4122 v4. The earlier node-deterministic derivation made every node one-shot at the Claude layer. Reconcile idempotency never keys on this id — the node-grain tmux session name is the observation key."

fn belt_uuid_stamped_id(node_id: String, probed_at: String) -> NonEmptyStr {
  join([node_id, "\n", probed_at], "") as NonEmptyStr
}

fn belt_uuid_hex32(node_id: String, probed_at: String) -> String {
  concat(
    content_hash_atom(value: belt_uuid_stamped_id(node_id: node_id, probed_at: probed_at)) as String,
    content_hash_combine(
      left: content_hash_atom(value: belt_uuid_stamped_id(node_id: node_id, probed_at: probed_at)),
      right: content_hash_atom(value: belt_session_uuid_salt),
    ) as String,
  )
}

fn belt_uuid_rfc4122(hex: String) -> String {
  concat(substring(s: hex, start: 0, end: 12),
  concat("4",
  concat(substring(s: hex, start: 13, end: 16),
  concat("8",
  substring(s: hex, start: 17, end: 32)))))
}

fn belt_uuid_dash(v: String) -> String {
  concat(substring(s: v, start: 0, end: 8),
  concat("-",
  concat(substring(s: v, start: 8, end: 12),
  concat("-",
  concat(substring(s: v, start: 12, end: 16),
  concat("-",
  concat(substring(s: v, start: 16, end: 20),
  concat("-",
  substring(s: v, start: 20, end: 32)))))))))
}

fn belt_spawn_session_uuid(node_id: String, probed_at: String) -> String {
  belt_uuid_dash(v: belt_uuid_rfc4122(hex: belt_uuid_hex32(node_id: node_id, probed_at: probed_at)))
}

fn belt_actuate_spawn_member(m: DispatchMember, workdir: String) -> BeltSpawnOutcome {
  match m {
    DesiredMember { node_id: nid, node: node } =>
      match clock_now_probed_at() {
        Present { value: probed_at } =>
          belt_actuate_spawn(node: node, probed_at: probed_at as String, workdir: workdir)
        Absent =>
          SpawnFailed {
            node_id: nid,
            step: "attempt-clock",
            detail: "clock observation refused; an attempt without a stamp would collide with a later one — fail-closed, no unknown-stamped attempts",
          }
      }
    ObservedMember { node_id: nid, session: _ } =>
      SpawnFailed {
        node_id: nid,
        step: "member-shape",
        detail: "belt spawn expected DesiredMember (carries node for brief); got ObservedMember — fail-closed, no spawn without a node model",
      }
  }
}

fn belt_actuate_teardown_member(m: DispatchMember) -> BeltTeardownOutcome {
  match m {
    ObservedMember { node_id: _, session: session } =>
      belt_actuate_teardown(session_name: session.session_name)
    DesiredMember { node_id: nid, node: _ } =>
      TeardownFailed {
        session_name: nid,
        detail: "belt teardown expected ObservedMember (carries live session); got DesiredMember — fail-closed, no teardown without an observed session",
      }
  }
}

type BeltObserve
  = Observed { live: List<DispatchLiveSession> }
  | ObserveRefused { reason: String }

data belt_observe_note: String = "tmux-present is the FIRST precondition: tmux not on PATH -> ObserveRefused (the belt cannot know what is live). Once tmux is present the observe half must NOT widen an exec failure into a zero-session answer (the §5 absorbing-fallback / ⊤-as-answer-vs-⊤-as-ignorance conflation). So the decision (belt_observe_from_result) gates on exit success: `tmux ls` exit 0 -> parse stdout into the true session set. On FAILURE only tmux's three DOCUMENTED empty spellings count as a genuine zero observation — stderr containing 'no server running', 'no sessions', or the no-server socket ENOENT spelling 'error connecting to ... (No such file or directory)' (grounded in extdeps.tmux tmux.Session.List and tmux_client_connect_error_note) -> Observed []. EVERY OTHER failure (socket permission/transient error, empty-stderr non-zero exit) is an UNKNOWABLE session set -> ObserveRefused (typed, located, carries stderr), never a blind spawn/reap. In particular, 'error connecting to ... (Connection refused)' is not the cited ENOENT fact and keeps refusing. First-tick bootstrap works under either no-server spelling: the empty observation admits the first spawn that creates the instance socket. The decision is a pure fn so every arm is witnessed (belt_observe_from_result witnesses); belt_observe only threads the live WitnessBin.Run result fields into it."

fn tmux_ls_stderr_reports_empty(stderr: String) -> Bool {
  string_contains(s: stderr, pattern: "no server running")
    || string_contains(s: stderr, pattern: "no sessions")
    || (
      string_contains(s: stderr, pattern: "error connecting to ")
        && string_contains(s: stderr, pattern: "(No such file or directory)")
    )
}

fn belt_observe_from_result(
  success: Bool,
  stdout: String,
  stderr: String,
) -> BeltObserve {
  if success {
    Observed { live: dispatch_live_sessions(tmux_ls_output: stdout) }
  } else {
    if tmux_ls_stderr_reports_empty(stderr: stderr) {
      Observed { live: [] }
    } else {
      ObserveRefused {
        reason: concat(
          "belt_observe: tmux ls exited nonzero with no documented no-server/no-sessions signal — the live session set is unknowable; fail-closed, no blind spawn/reap. stderr: ",
          stderr,
        ),
      }
    }
  }
}

fn belt_observe_for_instance(instance: HostDashboardInstance) -> BeltObserve {
  let ls = tmux_ls_argv_for_instance(instance: instance)
  if belt_program_available(program: ls.program) {
    let result = gunbc.WitnessBin.Run(
      workdir: belt_observe_workdir,
      bin_path: ls.program as FilePath,
      args: ls.args,
      expect: OutcomeIsData,
    )
    belt_observe_from_result(
      success: result.success,
      stdout: result.stdout,
      stderr: result.stderr,
    )
  } else {
    ObserveRefused {
      reason: "belt_observe: tmux not found on PATH; cannot observe belt session set; fail-closed (no blind spawn/reap on an unknowable observed set)",
    }
  }
}

fn belt_observe() -> BeltObserve {
  belt_observe_for_instance(instance: srv1_live_dashboard_instance())
}

data belt_tick_verify_pass_note: String = "Verification runs on the SAME tick that spawns and reaps, because it is the same kind of fact: a desired obligation reconciled against an observed one. Putting it here rather than behind its own trigger is what makes the mechanism the thing the operator was doing by hand — the belt already runs, so an attempt whose turn completed gets its receipts run on the next tick without anyone noticing it finished. It runs AFTER the reconcile's actuations and reads its own evidence, so a session spawned by this same tick has no completed turn to verify and is simply deferred. An unknowable session set short-circuits the whole tick before verification, exactly as it does for spawn and teardown: no observation, no actuation."

type BeltTickResult {
  observe_refused: Bool,
  observe_refusal_reason: String,
  reconcile: BeltReconcile,
  spawn_outcomes: List<BeltSpawnOutcome>,
  teardown_outcomes: List<BeltTeardownOutcome>,
  verify_outcomes: List<BeltVerifyOutcome>,
}

fn belt_tick_empty_reconcile(state: BeltRunState) -> BeltReconcile {
  BeltReconcile {
    run_state: state,
    occupied: 0,
    free: 0,
    spawns: [],
    deferred: 0,
    teardowns: [],
    refusals: [],
  }
}

data belt_tick_note: String = "The re-runnable belt driver: observe the live session set -> decide via belt_reconcile (the sole belt decision; belt_step is its degenerate spawn-only precursor) -> actuate each planned spawn/teardown through the fail-closed exec seam. Idempotent by construction: a spawned session is observed present on the next tick, keying to its ready node as Unchanged -> noop, so re-ticking never double-spawns (the observed set closes the loop the pure decision cannot). ObserveRefused short-circuits the whole tick with a typed reason and zero actions — no spawn/reap on an unknowable observed set."

fn belt_tick(
  state: BeltRunState,
  frontier: SpawnFrontier,
  cap: BeltCapacity,
  spawn_workdir: String,
) -> BeltTickResult {
  match belt_observe() {
    ObserveRefused { reason: r } =>
      BeltTickResult {
        observe_refused: true,
        observe_refusal_reason: r,
        reconcile: belt_tick_empty_reconcile(state: state),
        spawn_outcomes: [],
        teardown_outcomes: [],
        verify_outcomes: [],
      }
    Observed { live: live } => {
      let r = belt_reconcile(state: state, frontier: frontier, live: live, cap: cap)
      BeltTickResult {
        observe_refused: false,
        observe_refusal_reason: "",
        reconcile: r,
        spawn_outcomes: r.spawns |> map(m => belt_actuate_spawn_member(m: m, workdir: spawn_workdir)),
        teardown_outcomes: r.teardowns |> map(m => belt_actuate_teardown_member(m: m)),
        verify_outcomes: belt_verify_attempts(),
      }
    }
  }
}

fn belt_tick_default_workdir(
  state: BeltRunState,
  frontier: SpawnFrontier,
  cap: BeltCapacity,
) -> BeltTickResult {
  belt_tick(state: state, frontier: frontier, cap: cap, spawn_workdir: belt_actuate_workdir as String)
}

fn belt_spawn_ok(o: BeltSpawnOutcome) -> Bool {
  match o {
    Spawned { node_id: _, session_name: _ } => true
    SpawnFailed { node_id: _, step: _, detail: _ } => false
  }
}

fn belt_teardown_ok(o: BeltTeardownOutcome) -> Bool {
  match o {
    ReapedSession { session_name: _ } => true
    TeardownFailed { session_name: _, detail: _ } => false
  }
}

fn belt_tick_spawn_ok_count(t: BeltTickResult) -> Int {
  count(t.spawn_outcomes |> filter(o => belt_spawn_ok(o: o)))
}

fn belt_tick_spawn_failed_count(t: BeltTickResult) -> Int {
  count(t.spawn_outcomes |> filter(o => !belt_spawn_ok(o: o)))
}

fn belt_tick_teardown_ok_count(t: BeltTickResult) -> Int {
  count(t.teardown_outcomes |> filter(o => belt_teardown_ok(o: o)))
}

data belt_run_once_note: String = "The runnable belt entrypoint: one tick against the LIVE roadmap. Reads the roadmap authority + merged PRs, builds the ready frontier, and runs belt_tick_default_workdir (Running, default capacity, belt_actuate_workdir). Zero-arg so it is invokable directly (gunbc run --function belt_run_once_json, wet), spawning a real tmux session through dispatch_cli_provider on the host it runs on. belt_run_once returns the typed BeltTickResult; belt_run_once_json projects it to a receipt (observe verdict, occupied/free/deferred, per-node spawn/teardown outcomes, refusal count) so the operator sees exactly what one tick did — no fabricated summary. Idempotent: a spawned session is observed live next tick and reconciles to noop."

fn belt_run_once() -> BeltTickResult {
  belt_tick_default_workdir(
    state: roadmap_belt_default_run_state,
    frontier: spawn_frontier(doc: roadmap_authority(), merged: authored_merged_prs()),
    cap: roadmap_belt_default_capacity,
  )
}

fn belt_spawn_outcome_json(o: BeltSpawnOutcome) -> JsonValue {
  match o {
    Spawned { node_id: nid, session_name: sn } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "spawned")),
        json_kv(key: "session_name", value: json_string(s: sn)),
      ])
    SpawnFailed { node_id: nid, step: st, detail: d } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "spawn_failed")),
        json_kv(key: "step", value: json_string(s: st)),
        json_kv(key: "detail", value: json_string(s: d)),
      ])
  }
}

fn belt_teardown_outcome_json(o: BeltTeardownOutcome) -> JsonValue {
  match o {
    ReapedSession { session_name: sn } =>
      json_object(members: [
        json_kv(key: "session_name", value: json_string(s: sn)),
        json_kv(key: "status", value: json_string(s: "reaped")),
      ])
    TeardownFailed { session_name: sn, detail: d } =>
      json_object(members: [
        json_kv(key: "session_name", value: json_string(s: sn)),
        json_kv(key: "status", value: json_string(s: "teardown_failed")),
        json_kv(key: "detail", value: json_string(s: d)),
      ])
  }
}

fn belt_tick_result_json_value(t: BeltTickResult) -> JsonValue {
  json_object(members: [
    json_kv(key: "schema", value: json_string(s: "roadmap-belt-tick/v1")),
    json_kv(key: "observe_refused", value: json_bool(b: t.observe_refused)),
    json_kv(key: "observe_refusal_reason", value: json_string(s: t.observe_refusal_reason)),
    json_kv(key: "run_state", value: json_string(s: belt_run_state_label(s: t.reconcile.run_state))),
    json_kv(key: "occupied", value: json_int(n: t.reconcile.occupied)),
    json_kv(key: "free", value: json_int(n: t.reconcile.free)),
    json_kv(key: "deferred", value: json_int(n: t.reconcile.deferred)),
    json_kv(key: "refusal_count", value: json_int(n: belt_reconcile_refusal_count(r: t.reconcile))),
    json_kv(key: "spawned", value: json_int(n: belt_tick_spawn_ok_count(t: t))),
    json_kv(key: "spawn_failed", value: json_int(n: belt_tick_spawn_failed_count(t: t))),
    json_kv(key: "reaped", value: json_int(n: belt_tick_teardown_ok_count(t: t))),
    json_kv(key: "spawn_outcomes", value: json_array(elements: t.spawn_outcomes |> map(o => belt_spawn_outcome_json(o: o)))),
    json_kv(key: "teardown_outcomes", value: json_array(elements: t.teardown_outcomes |> map(o => belt_teardown_outcome_json(o: o)))),
    json_kv(key: "verified", value: json_int(n: belt_tick_verify_recorded_count(t: t))),
    json_kv(key: "verify_outcomes", value: json_array(elements: t.verify_outcomes |> map(o => belt_verify_outcome_json(o: o)))),
  ])
}

fn belt_verify_outcome_json(o: BeltVerifyOutcome) -> JsonValue {
  match o {
    VerifyDeferred { node_id, reason } =>
      json_object(members: [
        json_kv(key: "node", value: json_string(s: node_id)),
        json_kv(key: "outcome", value: json_string(s: "deferred")),
        json_kv(key: "detail", value: json_string(s: reason)),
      ])
    VerifyRecorded { node_id, verdict_key, detail } =>
      json_object(members: [
        json_kv(key: "node", value: json_string(s: node_id)),
        json_kv(key: "outcome", value: json_string(s: "recorded")),
        json_kv(key: "verdict", value: json_string(s: verdict_key)),
        json_kv(key: "detail", value: json_string(s: detail)),
      ])
    VerifyWriteFailed { node_id, detail } =>
      json_object(members: [
        json_kv(key: "node", value: json_string(s: node_id)),
        json_kv(key: "outcome", value: json_string(s: "write-failed")),
        json_kv(key: "detail", value: json_string(s: detail)),
      ])
    VerifyEvidenceUnreadable { node_id, detail } =>
      json_object(members: [
        json_kv(key: "node", value: json_string(s: node_id)),
        json_kv(key: "outcome", value: json_string(s: "evidence-unreadable")),
        json_kv(key: "detail", value: json_string(s: detail)),
      ])
  }
}

data belt_tick_verify_counts_note: String = "The tick counts verdicts RECORDED, never verdicts passed. A tick that records four refusals did its job exactly as well as one that records four passes — the belt's obligation is to produce the receipt, not to produce a green — so counting passes here would make the belt's own receipt read as a quality metric and give a later reader a reason to want fewer refusals. Write failures are counted separately because they are the belt failing, not the validation."

fn belt_tick_verify_recorded_count(t: BeltTickResult) -> Int {
  count(t.verify_outcomes |> filter(o => match o {
    VerifyRecorded { node_id: _, verdict_key: _, detail: _ } => true
    VerifyDeferred { node_id: _, reason: _ } => false
    VerifyWriteFailed { node_id: _, detail: _ } => false
    VerifyEvidenceUnreadable { node_id: _, detail: _ } => false
  }))
}

fn belt_tick_verify_write_failed_count(t: BeltTickResult) -> Int {
  count(t.verify_outcomes |> filter(o => match o {
    VerifyWriteFailed { node_id: _, detail: _ } => true
    VerifyEvidenceUnreadable { node_id: _, detail: _ } => true
    VerifyRecorded { node_id: _, verdict_key: _, detail: _ } => false
    VerifyDeferred { node_id: _, reason: _ } => false
  }))
}

type BeltAttempts
  = AttemptsObserved { attempts: List<DispatchAttemptRef> }
  | AttemptsRefused { reason: String }

data belt_attempts_observe_note: String = "U3: the attempts observation mirrors belt_observe's fail-closed grammar — git absent or a non-zero for-each-ref is an UNKNOWABLE attempts set (AttemptsRefused, typed, carries stderr), never widened to zero attempts; exit 0 with empty output IS a genuine zero (for-each-ref's documented no-match behavior). Runs in belt_actuate_workdir — the same repo-root authority the spawn's worktree add uses, because the attempt branches live exactly where spawns mint them."

fn belt_attempts_observe_for_instance(instance: HostDashboardInstance) -> BeltAttempts {
  let cmd = git_for_each_ref_dispatch_argv_for_instance(instance: instance)
  if belt_program_available(program: cmd.program) {
    let result = gunbc.WitnessBin.Run(
      workdir: instance.repo_root,
      bin_path: cmd.program as FilePath,
      args: cmd.args,
    )
    if result.success {
      AttemptsObserved { attempts: dispatch_attempt_refs(git_output: result.stdout) }
    } else {
      AttemptsRefused { reason: concat("git for-each-ref failed: ", result.stderr) }
    }
  } else {
    AttemptsRefused { reason: "git not found on PATH — the attempts set is unknowable" }
  }
}

fn belt_attempts_observe() -> BeltAttempts {
  belt_attempts_observe_for_instance(instance: srv1_live_dashboard_instance())
}

fn belt_attempts_json_value(a: BeltAttempts) -> JsonValue {
  match a {
    AttemptsRefused { reason: r } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: "roadmap-attempts/v1")),
        json_kv(key: "attempts_refused", value: json_bool(b: true)),
        json_kv(key: "reason", value: json_string(s: r)),
      ])
    AttemptsObserved { attempts } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: "roadmap-attempts/v1")),
        json_kv(key: "attempts_refused", value: json_bool(b: false)),
        json_kv(key: "attempts", value: json_array(elements: attempts |> map(a2 => {
          let evidence = dispatch_attempt_evidence(attempt: a2)
          json_object(members: [
            json_kv(key: "node_id", value: json_string(s: a2.node_id)),
            json_kv(key: "branch", value: json_string(s: a2.branch)),
            json_kv(key: "attempt_key", value: json_string(s: a2.attempt_key)),
            json_kv(key: "worktree_evidence", value: json_string(s: worktree_evidence_label(evidence: evidence.worktree))),
            json_kv(key: "provider_evidence", value: json_string(s: provider_evidence_label(evidence: evidence.provider_instance))),
            json_kv(key: "process_identity_evidence", value: json_string(s: process_identity_evidence_label(evidence: evidence.process_identity))),
            json_kv(key: "transcript_evidence", value: json_string(s: transcript_evidence_label(evidence: evidence.transcript))),
            json_kv(key: "terminal_outcome_evidence", value: json_string(s: terminal_outcome_evidence_label(evidence: evidence.terminal_outcome))),
          ])
        }))),
      ])
  }
}

fn belt_attempts_observed_json(a: BeltAttempts) -> String {
  serialize_json(v: belt_attempts_json_value(a: a))
}

fn belt_attempts_http_status(a: BeltAttempts) -> Int {
  match a {
    AttemptsRefused { reason: _ } => 503
    AttemptsObserved { attempts: _ } => 200
  }
}

type BeltAttemptPanes
  = BeltAttemptPanesObserved { panes: List<TmuxAttemptPaneEntry> }
  | BeltAttemptPanesRefused { reason: String }

type BeltWorkflowAttempts
  = WorkflowAttemptsObserved { attempts: List<WorkflowAttemptProgress> }
  | WorkflowAttemptsRefused { reason: String }

data belt_workflow_attempts_note: String = "The workflow route joins the latest published attempt state to process evidence at node grain. Git refs determine which nodes have attempts; the node-current pointer selects the latest modeled attempt without guessing chronology from content-hash keys; Filesystem.Read observes the immutable key/admission prefix plus the append-only Codex JSONL; one exact tmux list-panes read observes alive/dead/exit for all attempts. A git refusal refuses the route. A pane-command or parse refusal stays located inside each attempt so already-terminal provider evidence remains usable while incomplete attempts become refused."

fn belt_attempt_panes_observe_for_instance(
  instance: HostDashboardInstance,
) -> BeltAttemptPanes {
  let cmd = tmux_attempt_panes_argv_for_instance(instance: instance)
  if belt_program_available(program: cmd.program) {
    let result = gunbc.WitnessBin.Run(
      workdir: belt_observe_workdir,
      bin_path: cmd.program as FilePath,
      args: cmd.args,
      expect: OutcomeIsData,
    )
    if result.success {
      match parse_tmux_attempt_panes_output(output: result.stdout) {
        AttemptPanesParsed { panes } =>
          BeltAttemptPanesObserved { panes: panes }
        AttemptPanesParseRefused { line_number, raw, reason } =>
          BeltAttemptPanesRefused {
            reason: join([
              "tmux attempt-pane parse refused at line ",
              to_string(line_number),
              ": ",
              reason,
              "; raw=",
              raw,
            ], ""),
          }
      }
    } else if tmux_ls_stderr_reports_empty(stderr: result.stderr) {
      BeltAttemptPanesObserved { panes: [] }
    } else {
      BeltAttemptPanesRefused {
        reason: join([
          "tmux attempt-pane observation failed: ",
          result.stderr,
        ], ""),
      }
    }
  } else {
    BeltAttemptPanesRefused {
      reason: "tmux realization is not executable; process state is unknowable",
    }
  }
}

data belt_sessions_observation_separation_note: String = "The sessions route has two probes with independent authority. tmux ls decides only which session containers are present; if it refuses, the session set refuses. The richer pane probe decides process running/exited/unobserved and cleanup eligibility for each already-observed session. A pane-probe refusal therefore does NOT erase known session presence: it maps every present session to process-unobserved and cleanup-unavailable with the located pane reason. This keeps the UI capable of saying `session present · process unknown` instead of either fabricating liveness or hiding the container."

fn belt_sessions_observe_for_instance(
  instance: HostDashboardInstance,
) -> BeltObserve {
  let ls = tmux_ls_argv_for_instance(instance: instance)
  if belt_program_available(program: ls.program) {
    let result = gunbc.WitnessBin.Run(
      workdir: belt_observe_workdir,
      bin_path: ls.program as FilePath,
      args: ls.args,
      expect: OutcomeIsData,
    )
    if result.success {
      match belt_attempt_panes_observe_for_instance(instance: instance) {
        BeltAttemptPanesObserved { panes } =>
          Observed {
            live: dispatch_live_sessions_with_process(
              tmux_ls_output: result.stdout,
              panes: panes,
              pane_observation_refusal: "",
            ),
          }
        BeltAttemptPanesRefused { reason } =>
          Observed {
            live: dispatch_live_sessions_with_process(
              tmux_ls_output: result.stdout,
              panes: [],
              pane_observation_refusal: reason,
            ),
          }
      }
    } else if tmux_ls_stderr_reports_empty(stderr: result.stderr) {
      Observed { live: [] }
    } else {
      ObserveRefused {
        reason: concat(
          "belt_sessions_observe: tmux ls failed; session containers are unknowable. stderr: ",
          result.stderr,
        ),
      }
    }
  } else {
    ObserveRefused {
      reason: "belt_sessions_observe: tmux not found; session containers are unknowable",
    }
  }
}

fn belt_sessions_observe() -> BeltObserve {
  belt_sessions_observe_for_instance(
    instance: srv1_live_dashboard_instance(),
  )
}

fn attempt_process_for_node(
  panes: BeltAttemptPanes,
  node_id: String,
) -> WorkerProcessEvidence {
  match panes {
    BeltAttemptPanesRefused { reason } =>
      WorkerProcessUnobserved { reason: reason as NonEmptyStr }
    BeltAttemptPanesObserved { panes: observed } => {
      let session_name = dispatch_tmux_session_name(
        node_id: node_id as gunbc.roadmap_model.RoadmapNodeId,
      )
      let matched = observed |> filter(pane =>
        pane.session_name == session_name)
      match matched.first() {
        Absent => WorkerProcessAbsent
        Present { value: pane } =>
          worker_process_from_attempt_pane(pane: pane)
      }
    }
  }
}

fn dispatch_attempt_ref_first_per_node(
  attempts: List<DispatchAttemptRef>,
) -> List<DispatchAttemptRef> {
  fold(attempts, init: [], f: fn(acc, attempt) {
    if any(acc, existing => existing.node_id == attempt.node_id) {
      acc
    } else {
      append(acc, [attempt])
    }
  })
}

fn belt_validation_summary_for_node(
  instance: HostDashboardInstance,
  node_id: String,
) -> String {
  match belt_lookup_node(node_id: node_id) {
    NodeMissing => ""
    NodeFound { node } =>
      execution_contract_validation_summary(
        contract: node.execution,
        environment: instance.execution_environment,
      )
  }
}

type ProviderEventProjectionObservation
  = ProviderEventProjectionObserved { events: String }
  | ProviderEventProjectionRefused { reason: String }

fn belt_provider_event_projection_observe_for_instance(
  instance: HostDashboardInstance,
  node_id: gunbc.roadmap_model.RoadmapNodeId,
) -> ProviderEventProjectionObservation {
  match belt_exec(
    cmd: dispatch_current_attempt_events_projection_argv_for_instance(
      instance: instance,
      node_id: node_id,
    ),
    workdir: instance.repo_root as String,
  ) {
    ExecOk { stdout } =>
      ProviderEventProjectionObserved { events: stdout }
    ExecFailed { program, exit_code, stderr } =>
      ProviderEventProjectionRefused {
        reason: join([
          "provider event projection failed through ",
          program,
          " (exit ",
          to_string(exit_code),
          "): ",
          stderr,
        ], ""),
      }
    ExecRefused { program, reason } =>
      ProviderEventProjectionRefused {
        reason: join([
          "provider event projection unavailable through ",
          program,
          ": ",
          reason,
        ], ""),
      }
  }
}

fn provider_event_projection_readable(
  observation: ProviderEventProjectionObservation,
) -> Bool {
  match observation {
    ProviderEventProjectionObserved { events: _ } => true
    ProviderEventProjectionRefused { reason: _ } => false
  }
}

fn provider_event_projection_events(
  observation: ProviderEventProjectionObservation,
) -> String {
  match observation {
    ProviderEventProjectionObserved { events } => events
    ProviderEventProjectionRefused { reason: _ } => ""
  }
}

fn provider_event_projection_error(
  observation: ProviderEventProjectionObservation,
) -> String {
  match observation {
    ProviderEventProjectionObserved { events: _ } => ""
    ProviderEventProjectionRefused { reason } => reason
  }
}

fn belt_workflow_progress_for_attempt_ref(
  instance: HostDashboardInstance,
  panes: BeltAttemptPanes,
  attempt: DispatchAttemptRef,
) -> WorkflowAttemptProgress {
  let key_read = Filesystem.Read(
    path: dispatch_current_attempt_key_path_for_instance(
      instance: instance,
      node_id: attempt.node_id as gunbc.roadmap_model.RoadmapNodeId,
    ),
  )
  if !key_read.success || trim(key_read.content) == "" {
    workflow_attempt_progress(evidence: WorkflowAttemptEvidence {
      node_id: attempt.node_id,
      attempt_key: attempt.attempt_key,
      branch: attempt.branch,
      modeled_state_present: false,
      admission_receipt_readable: false,
      admission_receipt: "",
      spawn_failure_present: false,
      spawn_failure: "",
      provider_events_readable: false,
      provider_events: "",
      provider_events_error: key_read.error,
      process: attempt_process_for_node(
        panes: panes,
        node_id: attempt.node_id,
      ),
      validation_summary: belt_validation_summary_for_node(
        instance: instance,
        node_id: attempt.node_id,
      ),
      validation_receipt_readable: false,
      validation_receipt: "",
    })
  } else {
    let current_key = trim(key_read.content)
    let node_id = attempt.node_id as gunbc.roadmap_model.RoadmapNodeId
    let admission = Filesystem.Read(
      path: dispatch_current_attempt_admission_path_for_instance(
        instance: instance,
        node_id: node_id,
      ),
    )
    let events = belt_provider_event_projection_observe_for_instance(
      instance: instance,
      node_id: node_id,
    )
    let spawn_failure = Filesystem.Read(
      path: dispatch_current_attempt_spawn_failure_path_for_instance(
        instance: instance,
        node_id: node_id,
      ),
    )
    let validation_receipt = Filesystem.Read(
      path: dispatch_current_attempt_validation_receipt_path_for_instance(
        instance: instance,
        node_id: node_id,
      ),
    )
    workflow_attempt_progress(evidence: WorkflowAttemptEvidence {
      node_id: attempt.node_id,
      attempt_key: current_key,
      branch: dispatch_branch_name(
        node_id: node_id,
        attempt_key: current_key,
      ),
      modeled_state_present: true,
      admission_receipt_readable: admission.success,
      admission_receipt: admission.content,
      spawn_failure_present: spawn_failure.success,
      spawn_failure: spawn_failure.content,
      provider_events_readable: provider_event_projection_readable(
        observation: events,
      ),
      provider_events: provider_event_projection_events(
        observation: events,
      ),
      provider_events_error: provider_event_projection_error(
        observation: events,
      ),
      process: attempt_process_for_node(
        panes: panes,
        node_id: attempt.node_id,
      ),
      validation_summary: belt_validation_summary_for_node(
        instance: instance,
        node_id: attempt.node_id,
      ),
      validation_receipt_readable: validation_receipt.success,
      validation_receipt: validation_receipt.content,
    })
  }
}

data belt_verify_pass_note: String = "The workflow's own verification actuation, and the reason it lives on the belt rather than in the /workflow.json handler: running a declared validation is an EFFECT that takes as long as the validation takes, while the progress route is a synchronous read that the browser polls every two seconds. Producing the verdict on the read path would make the lamp's own observation the thing that runs cargo. So the belt produces the receipt and the projection reads it — the same split the environment-admission receipt already uses, and the reason Verify can move without the observer changing shape. Idempotence comes from the receipt's presence, exactly as spawn idempotence comes from the observed session: a recorded verdict is not recomputed, so re-ticking neither re-runs the validation nor overwrites a verdict with a later one taken against a tree the agent has since touched. Agent completion is read from the reconciled provider state, so a turn that completed while its pane still runs, or completed with a nonzero exit, does not reach verification at all — the obligation order is preserved rather than restated."

type BeltVerifyOutcome
  = VerifyDeferred { node_id: String, reason: String }
  | VerifyRecorded {
      node_id: String,
      verdict_key: String,
      detail: String,
    }
  | VerifyWriteFailed { node_id: String, detail: String }
  | VerifyEvidenceUnreadable { node_id: String, detail: String }

data belt_read_or_empty_scope_note: String = "review 45271, and the scope of this collapse is now deliberate rather than incidental. Reducing a read to `\"\"` conflates absent with unreadable, which is only safe where BOTH branches take the same action. That holds for the PIN reads below — an absent identity and an unreadable one both leave pin_recorded false, and the gate refuses either way, actuating nothing — so the distinction would change the message and not the behaviour. It did NOT hold for the receipt-presence read, which gated whether to RUN the validation and OVERWRITE the evidence: there, absent means run and unreadable means stop, so the collapse let an I/O fault regenerate a verdict against a worktree that may have moved. That seam no longer uses this function; it reads with status preserved and decodes."

fn belt_read_or_empty(path: String) -> String {
  let read = Filesystem.Read(path: path)
  if read.success { trim(read.content) } else { "" }
}

fn belt_validation_commands_for_contract(
  instance: HostDashboardInstance,
  contract: WorkItemExecutionContract,
) -> List<ModeledValidationCommand?> {
  match contract {
    ExecutionContractUnspecified => []
    ExecutionContract { validations, extra_capabilities: _ } =>
      map(validations, v => validation_operation_command(
        validation: v,
        environment: instance.execution_environment,
      ))
  }
}

fn belt_run_validation_commands(
  commands: List<ModeledValidationCommand?>,
  worktree: String,
  oracle_identity: ContentHash,
) -> ValidationVerdict {
  fold(
    commands,
    init: ValidationPassed {
      command: "",
      oracle_identity: oracle_identity,
    },
    f: fn(acc, maybe_command) {
      match acc {
        ValidationNotRun => acc
        ValidationFailed { command: _, exit_code: _, detail: _ } => acc
        ValidationRefused { cause: _ } => acc
        ValidationPassed { command: prior, oracle_identity: _ } =>
          match maybe_command {
            Absent =>
              ValidationRefused { cause: ValidationCommandUnrealized }
            Present { value: command } => {
              let wire = modeled_validation_command_wire(command: command)
              match belt_exec(
                cmd: host_exec_argv(
                  program: command.program as String,
                  args: command.args,
                ),
                workdir: worktree,
              ) {
                ExecOk { stdout: _ } =>
                  ValidationPassed {
                    command: if prior == "" {
                      wire
                    } else {
                      join([prior, "; ", wire], "")
                    },
                    oracle_identity: oracle_identity,
                  }
                ExecFailed { program: _, exit_code, stderr } =>
                  ValidationFailed {
                    command: wire,
                    exit_code: exit_code,
                    detail: stderr,
                  }
                ExecRefused { program, reason } =>
                  ValidationRefused {
                    cause: ValidationCommandRefused {
                      program: program,
                      reason: reason,
                    },
                  }
              }
            }
          }
      }
    },
  )
}

fn belt_verify_attempt_for_instance(
  instance: HostDashboardInstance,
  progress: WorkflowAttemptProgress,
) -> BeltVerifyOutcome {
  let node_id = progress.node_id as gunbc.roadmap_model.RoadmapNodeId
  match progress.provider {
    ProviderCompleted { activity: _ } => {
      let receipt_read = Filesystem.Read(
        path: dispatch_current_attempt_validation_receipt_path_for_instance(
          instance: instance,
          node_id: node_id,
        ),
      )
      if !receipt_read.success {
        VerifyEvidenceUnreadable {
          node_id: progress.node_id,
          detail: join([
            "the validation receipt beside this attempt could not be read, so whether a verdict already exists is unknown; the belt refuses to run the validation rather than overwrite evidence it cannot see (",
            receipt_read.error,
            "). An attempt dispatched before verification receipts existed reports this until it is re-dispatched",
          ], ""),
        }
      } else {
        match validation_receipt_decode(receipt: receipt_read.content) {
          ValidationReceiptUndecodable { reason } =>
            VerifyEvidenceUnreadable {
              node_id: progress.node_id,
              detail: join([
                "the validation receipt beside this attempt does not decode, so the belt refuses to replace it: ",
                reason,
              ], ""),
            }
          ValidationReceiptDecoded { verdict_key } =>
            if verdict_key != "not_run" {
              VerifyDeferred {
                node_id: progress.node_id,
                reason: join([
                  "a validation verdict is already recorded for this attempt: ",
                  verdict_key,
                ], ""),
              }
            } else {
        match belt_lookup_node(node_id: progress.node_id) {
          NodeMissing =>
            VerifyDeferred {
              node_id: progress.node_id,
              reason: "the roadmap authority declares no node with this id, so there is no contract to verify against",
            }
          NodeFound { node } => {
            let worktree = dispatch_worktree_path_for_instance(
              instance: instance,
              node_id: node_id,
              attempt_key: progress.attempt_key,
            )
            let observations = belt_oracle_observations_in_worktree(
              contract: node.execution,
              worktree: worktree,
            )
            let pinned_identity = belt_read_or_empty(
              path: dispatch_current_attempt_oracle_identity_path_for_instance(
                instance: instance,
                node_id: node_id,
              ),
            )
            let pinned_revision = belt_read_or_empty(
              path: dispatch_current_attempt_oracle_revision_path_for_instance(
                instance: instance,
                node_id: node_id,
              ),
            )
            let pin_refusal = belt_read_or_empty(
              path: dispatch_current_attempt_oracle_pin_refusal_path_for_instance(
                instance: instance,
                node_id: node_id,
              ),
            )
            let pin_recorded = pinned_identity != "" && pinned_revision != ""
            let verdict = match validation_oracle_gate(
              contract: node.execution,
              observations: observations,
              pin_recorded: pin_recorded,
              expected_identity: pinned_identity as ContentHash,
              revision: pinned_revision as VersionIdentity,
              pin_read_detail: if pin_refusal == "" {
                "no oracle identity was recorded for this attempt at dispatch"
              } else {
                pin_refusal
              },
            ) {
              ValidationOracleGateRefused { cause } =>
                ValidationRefused { cause: cause }
              ValidationOracleAdmitted { identity } =>
                belt_run_validation_commands(
                  commands: belt_validation_commands_for_contract(
                    instance: instance,
                    contract: node.execution,
                  ),
                  worktree: worktree,
                  oracle_identity: identity,
                )
            }
            let write = Filesystem.Write(
              path: dispatch_current_attempt_validation_receipt_path_for_instance(
                instance: instance,
                node_id: node_id,
              ),
              content: validation_receipt_json(
                verdict: verdict,
                observations: observations,
              ),
            )
            if write.success {
              VerifyRecorded {
                node_id: progress.node_id,
                verdict_key: validation_verdict_key(verdict: verdict),
                detail: validation_verdict_detail(verdict: verdict),
              }
            } else {
              VerifyWriteFailed {
                node_id: progress.node_id,
                detail: write.error,
              }
            }
          }
        }
      }
        }
      }
    }
    _ =>
      VerifyDeferred {
        node_id: progress.node_id,
        reason: "the agent obligation is not satisfied, so there is nothing to verify yet",
      }
  }
}

fn belt_verify_attempts_for_instance(
  instance: HostDashboardInstance,
) -> List<BeltVerifyOutcome> {
  match belt_workflow_attempts_observe_for_instance(instance: instance) {
    WorkflowAttemptsRefused { reason } =>
      [
        VerifyDeferred {
          node_id: "",
          reason: join([
            "the attempts ledger is unobservable, so no attempt can be verified: ",
            reason,
          ], ""),
        },
      ]
    WorkflowAttemptsObserved { attempts } =>
      map(attempts, progress => belt_verify_attempt_for_instance(
        instance: instance,
        progress: progress,
      ))
  }
}

fn belt_verify_attempts() -> List<BeltVerifyOutcome> {
  belt_verify_attempts_for_instance(
    instance: srv1_live_dashboard_instance(),
  )
}

fn belt_workflow_attempts_observe_for_instance(
  instance: HostDashboardInstance,
) -> BeltWorkflowAttempts {
  match belt_attempts_observe_for_instance(instance: instance) {
    AttemptsRefused { reason } =>
      WorkflowAttemptsRefused { reason: reason }
    AttemptsObserved { attempts } => {
      let panes = belt_attempt_panes_observe_for_instance(instance: instance)
      WorkflowAttemptsObserved {
        attempts: dispatch_attempt_ref_first_per_node(attempts: attempts)
          |> map(attempt => belt_workflow_progress_for_attempt_ref(
            instance: instance,
            panes: panes,
            attempt: attempt,
          )),
      }
    }
  }
}

data belt_attempt_presentation_note: String = "The wire join of the two authorities the client must never re-derive: the attempt's progress members (gunbc.roadmap_workflow_progress, unchanged) plus the DECIDED activity view (gunbc.roadmap_presentation) appended as one 'activity' member. The seam reads process and current activity from INSIDE the progress carrier (one_progress_authority_note — the belt cannot pass a disagreeing process beside it), so this join is one call on one value. The join lives here because progress cannot import presentation without a cycle; the member-list seam (workflow_attempt_progress_json_members) is what lets the belt extend the object without re-stating or re-matching it."

fn belt_workflow_attempt_presentation_json(
  progress: WorkflowAttemptProgress,
) -> JsonValue {
  json_object(members: concat(
    workflow_attempt_progress_json_members(progress: progress),
    [ json_kv(key: "activity", value: activity_view_json_value(
        view: activity_view_from_progress(progress: progress))) ]))
}

fn belt_workflow_attempts_json_value(
  observed: BeltWorkflowAttempts,
) -> JsonValue {
  match observed {
    WorkflowAttemptsRefused { reason } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: "roadmap-workflow/v1")),
        json_kv(key: "observe_refused", value: json_bool(b: true)),
        json_kv(key: "reason", value: json_string(s: reason)),
      ])
    WorkflowAttemptsObserved { attempts } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: "roadmap-workflow/v1")),
        json_kv(key: "observe_refused", value: json_bool(b: false)),
        json_kv(
          key: "attempts",
          value: json_array(elements: map(
            attempts,
            progress => belt_workflow_attempt_presentation_json(
              progress: progress,
            ),
          )),
        ),
      ])
  }
}

fn belt_workflow_attempts_observed_json(
  observed: BeltWorkflowAttempts,
) -> String {
  serialize_json(v: belt_workflow_attempts_json_value(observed: observed))
}

fn belt_workflow_attempts_http_status(
  observed: BeltWorkflowAttempts,
) -> Int {
  match observed {
    WorkflowAttemptsRefused { reason: _ } => 503
    WorkflowAttemptsObserved { attempts: _ } => 200
  }
}

type BeltStopResult
  = StopProcessStopped { node_id: String, session_name: String }
  | StopRetainedSessionCleared {
      node_id: String,
      session_name: String,
      exit_code: Int,
    }
  | StopDisabled { node_id: String, instance_id: String, reason: String }
  | StopRefusedResult { node_id: String, reason: String }
  | StopObserveRefused { node_id: String, reason: String }
  | StopTeardownFailed { node_id: String, session_name: String, detail: String }

data belt_stop_note: String = "U4 (stop/clear from the UI): cleanup consumes the same independently observed session and process facts served to the page. Session-list refusal yields StopObserveRefused. A present running pane is stop-eligible only with the configured provider fingerprint; a foreign or unobserved running process refuses. A retained dead pane is a different operation: clear removes tmux metadata after the process has already exited, so its historical wrapper command is never misclassified as a live foreign process. Teardown failure remains its own typed 502 arm."

fn belt_stop_node_for_instance(
  instance: HostDashboardInstance,
  node_id: String,
) -> BeltStopResult {
  match instance.actuation {
    DashboardObserveOnly =>
    StopDisabled {
      node_id: node_id,
      instance_id: instance.instance_id as String,
      reason: "dashboard instance is observe-only; stop refused before tmux observation",
    }
    DashboardActuating => {
  match belt_sessions_observe_for_instance(instance: instance) {
    ObserveRefused { reason: r } => StopObserveRefused { node_id: node_id, reason: r }
    Observed { live } => {
      let scope = dispatch_tmux_session_scope(node_id: node_id)
      let matched = live
        |> filter(sess =>
          sess.session_name == (scope.session_name as String))
      match matched.first() {
        Absent =>
          StopRefusedResult {
            node_id: node_id,
            reason: "no session container for this node",
          }
        Present { value: session } =>
          match dispatch_session_cleanup(scope: scope, session: session) {
            DispatchCleanupRefused { reason } =>
              StopRefusedResult { node_id: node_id, reason: reason }
            DispatchStopRunningProcess { session_name } =>
              match belt_actuate_teardown_for_instance(
                instance: instance,
                session_name: session_name,
              ) {
                ReapedSession { session_name: stopped } =>
                  StopProcessStopped {
                    node_id: node_id,
                    session_name: stopped,
                  }
                TeardownFailed { session_name: failed, detail } =>
                  StopTeardownFailed {
                    node_id: node_id,
                    session_name: failed,
                    detail: detail,
                  }
              }
            DispatchClearRetainedSession { session_name, exit_code } =>
              match belt_actuate_teardown_for_instance(
                instance: instance,
                session_name: session_name,
              ) {
                ReapedSession { session_name: cleared } =>
                  StopRetainedSessionCleared {
                    node_id: node_id,
                    session_name: cleared,
                    exit_code: exit_code,
                  }
                TeardownFailed { session_name: failed, detail } =>
                  StopTeardownFailed {
                    node_id: node_id,
                    session_name: failed,
                    detail: detail,
                  }
              }
          }
      }
    }
  }
  }
  }
}

fn belt_stop_node(node_id: String) -> BeltStopResult {
  belt_stop_node_for_instance(
    instance: srv1_live_dashboard_instance(),
    node_id: node_id,
  )
}

fn belt_stop_result_json_value(r: BeltStopResult) -> JsonValue {
  match r {
    StopProcessStopped { node_id: nid, session_name: sn } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "process_stopped")),
        json_kv(key: "action", value: json_string(s: "stop")),
        json_kv(key: "ok", value: json_bool(b: true)),
        json_kv(key: "session_name", value: json_string(s: sn)),
      ])
    StopRetainedSessionCleared {
      node_id: nid,
      session_name: sn,
      exit_code,
    } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "session_cleared")),
        json_kv(key: "action", value: json_string(s: "clear")),
        json_kv(key: "ok", value: json_bool(b: true)),
        json_kv(key: "session_name", value: json_string(s: sn)),
        json_kv(key: "exit_code", value: json_int(n: exit_code)),
      ])
    StopDisabled { node_id: nid, instance_id: iid, reason: why } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "stop_disabled")),
        json_kv(key: "ok", value: json_bool(b: false)),
        json_kv(key: "instance", value: json_string(s: iid)),
        json_kv(key: "reason", value: json_string(s: why)),
      ])
    StopRefusedResult { node_id: nid, reason: r2 } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "stop_refused")),
        json_kv(key: "ok", value: json_bool(b: false)),
        json_kv(key: "reason", value: json_string(s: r2)),
      ])
    StopObserveRefused { node_id: nid, reason: r3 } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "observe_refused")),
        json_kv(key: "ok", value: json_bool(b: false)),
        json_kv(key: "reason", value: json_string(s: r3)),
      ])
    StopTeardownFailed { node_id: nid, session_name: sn, detail: d } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: "teardown_failed")),
        json_kv(key: "ok", value: json_bool(b: false)),
        json_kv(key: "session_name", value: json_string(s: sn)),
        json_kv(key: "detail", value: json_string(s: d)),
      ])
  }
}

fn belt_stop_http_status(r: BeltStopResult) -> Int {
  match r {
    StopProcessStopped { node_id: _, session_name: _ } => 200
    StopRetainedSessionCleared {
      node_id: _,
      session_name: _,
      exit_code: _,
    } => 200
    StopDisabled { node_id: _, instance_id: _, reason: _ } => 403
    StopRefusedResult { node_id: _, reason: r2 } =>
      if string_contains(s: r2, pattern: "no session container") {
        404
      } else {
        409
      }
    StopObserveRefused { node_id: _, reason: _ } => 503
    StopTeardownFailed { node_id: _, session_name: _, detail: _ } => 502
  }
}

fn belt_stop_json(node_id: String) -> String {
  serialize_json(v: belt_stop_result_json_value(r: belt_stop_node(node_id: node_id)))
}

data belt_sessions_json_note: String = "The sessions wire projects independent session-container, process-lifecycle, provider, readiness, phase, and cleanup facts. Inclusion in sessions proves only `session_presence=present`. process_state comes from the exact dead/status pane observation; cleanup_action is derived separately from process state plus ownership policy. A refused pane probe stays per-session as process unobserved and cleanup unavailable while the known session set remains a 200. Only refusal of the tmux session-list source produces top-level observe_refused/503."

fn belt_sessions_json_value(o: BeltObserve) -> JsonValue {
  match o {
    ObserveRefused { reason: r } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: "roadmap-sessions/v1")),
        json_kv(key: "observe_refused", value: json_bool(b: true)),
        json_kv(key: "reason", value: json_string(s: r)),
      ])
    Observed { live } =>
      json_object(members: [
        json_kv(key: "schema", value: json_string(s: "roadmap-sessions/v1")),
        json_kv(key: "observe_refused", value: json_bool(b: false)),
        json_kv(key: "sessions", value: json_array(elements: live |> map(sess => {
          let cleanup = dispatch_session_cleanup(
            scope: dispatch_tmux_session_scope(node_id: sess.node_id),
            session: sess,
          )
          json_object(members: [
            json_kv(key: "node_id", value: json_string(s: sess.node_id)),
            json_kv(key: "session_name", value: json_string(s: sess.session_name)),
            json_kv(key: "session_presence", value: json_string(s: "present")),
            json_kv(key: "process_state", value: json_string(
              s: worker_process_evidence_label(evidence: sess.worker.process))),
            json_kv(key: "process_detail", value: json_string(
              s: worker_process_evidence_detail(evidence: sess.worker.process))),
            json_kv(key: "configured_provider", value: json_string(s: provider_kind_label(kind: sess.worker.configured_provider.kind))),
            json_kv(key: "provider", value: json_string(s: provider_evidence_label(evidence: sess.worker.provider_instance))),
            json_kv(key: "provider_readiness", value: json_string(s: provider_readiness_label(readiness: sess.worker.provider_readiness))),
            json_kv(key: "tool_execution_readiness", value: json_string(s: tool_execution_readiness_label(readiness: sess.worker.tool_readiness))),
            json_kv(key: "worker_phase", value: json_string(s: worker_phase_label(phase: sess.worker.phase))),
            json_kv(key: "cleanup_action", value: json_string(
              s: dispatch_session_cleanup_action(cleanup: cleanup))),
            json_kv(key: "cleanup_allowed", value: json_bool(
              b: dispatch_session_cleanup_allowed(cleanup: cleanup))),
            json_kv(key: "cleanup_detail", value: json_string(
              s: dispatch_session_cleanup_detail(cleanup: cleanup))),
            json_kv(key: "facts", value: session_facts_json_value(
              v: session_facts_view(
                process: sess.worker.process,
                process_detail: worker_process_evidence_detail(evidence: sess.worker.process),
                provider: provider_evidence_label(evidence: sess.worker.provider_instance),
                configured_provider: provider_kind_label(kind: sess.worker.configured_provider.kind),
                provider_readiness: provider_readiness_label(readiness: sess.worker.provider_readiness),
                session_name: sess.session_name,
                cleanup_action: dispatch_session_cleanup_action(cleanup: cleanup),
                cleanup_allowed: dispatch_session_cleanup_allowed(cleanup: cleanup),
                cleanup_detail: dispatch_session_cleanup_detail(cleanup: cleanup),
              ))),
          ])
        }))),
      ])
  }
}

fn belt_sessions_observed_json(o: BeltObserve) -> String {
  serialize_json(v: belt_sessions_json_value(o: o))
}

fn belt_sessions_json() -> String {
  belt_sessions_observed_json(o: belt_sessions_observe())
}

fn belt_sessions_http_status(o: BeltObserve) -> Int {
  match o {
    ObserveRefused { reason: _ } => 503
    Observed { live: _ } => 200
  }
}

fn belt_run_once_json() -> String {
  serialize_json(v: belt_tick_result_json_value(t: belt_run_once()))
}

data belt_run_once_cli_note: String = "The ProcessExit entrypoint — this is what `gunbc run --function belt_run_once_cli` invokes (belt_run_once_json returns String, which `gunbc run` rejects; belt_run_once_cli is its runnable wrapper). Fail-closed exit mapping, idiomatic per srv3_boot_once_cd / host_build_cache_provision: a clean idempotent tick -> ExitSuccess (exit 0, silent). ANY problem surfaces the FULL JSON receipt loudly on stderr via exit_failure(reason): observe_refused (the live session set was unknowable, so no actions were taken) -> exit_failure(receipt); or one-or-more spawn_failed outcomes (a git-worktree/tmux/which failure) -> exit_failure(receipt). The receipt is the whole BeltTickResult projection, so the operator reads exactly which node failed at which step. A verify outcome that could not be WRITTEN flips the exit for the same reason a spawn failure does — the belt failed to produce a receipt it was obliged to produce — while a recorded refusal or a recorded red does NOT, because those are the receipt working: the belt's obligation is to produce a verdict, never to produce a green, and flipping the exit on a refusal would make the tick's own success depend on what the validation said. Teardown failures are surfaced in the receipt but do NOT flip the exit — a reap that could not complete is not a reason to fail the tick (the session is still tracked and retried next tick); only a spawn failure or an unknowable observation is a hard stop. For always-on observation of a SUCCESSFUL tick's receipt, belt_run_once_json is the string form (witness/inspection)."

fn belt_run_once_cli() -> ProcessExit {
  let t = belt_run_once()
  let receipt = serialize_json(v: belt_tick_result_json_value(t: t))
  if t.observe_refused {
    exit_failure(reason: receipt)
  } else {
    if belt_tick_spawn_failed_count(t: t) > 0 {
      exit_failure(reason: receipt)
    } else if belt_tick_verify_write_failed_count(t: t) > 0 {
      exit_failure(reason: receipt)
    } else {
      ExitSuccess
    }
  }
}

data belt_dispatch_node_note: String = "Per-node MANUAL dispatch — the click path (operator 2026-07-20: 'i should just manually click/dispatch'). belt_run_once ticks the WHOLE ready frontier; belt_dispatch_node spawns exactly ONE node by id, operator-selected from the roadmap UI, NOT frontier-gated (the operator's click IS the selection). DONE = the operator's SIGNOFF, never a merged PR (operator: 'PR merged not necessarily mean item == done — they may not be 1:1'): a signoff-accepted node refuses dispatch (DispatchNodeAlreadyDone); a node whose PRs merged but is unsigned is still 'in review' and remains dispatchable (more work). Idempotent by the same observe-before-spawn the tick uses: if the node's session is already live, DispatchAlreadyLive (noop), so a double-click never double-spawns. Fail-closed: unknown node id -> DispatchNodeNotFound; unknowable observed set -> DispatchObserveRefused; spawn failure -> DispatchSpawnFailed (never a fabricated success). Reuses belt_lookup_node (pure roadmap read), belt_observe, and belt_actuate_spawn — no forked spawn path."

type BeltNodeLookup
  = NodeFound { node: RoadmapNode }
  | NodeMissing

fn belt_find_node_in(nodes: List<RoadmapNode>, node_id: String) -> BeltNodeLookup {
  let matches = nodes |> filter(n => n.node == node_id)
  fold(matches, init: NodeMissing, f: fn(acc, n) {
    match acc {
      NodeFound { node: _ } => acc
      NodeMissing => NodeFound { node: n }
    }
  })
}

fn belt_lookup_node(node_id: String) -> BeltNodeLookup {
  belt_find_node_in(nodes: doc_all_nodes(doc: roadmap_authority()), node_id: node_id)
}

fn belt_node_session_live(live: List<DispatchLiveSession>, node_id: String) -> Bool {
  any(live, s => s.node_id == node_id)
}

type BeltDispatchResult
  = DispatchSpawned { node_id: String, session_name: String }
  | DispatchAlreadyLive { node_id: String, session_name: String }
  | DispatchDisabled { node_id: String, instance_id: String, reason: String }
  | DispatchNodeNotFound { node_id: String }
  | DispatchNodeAlreadyDone { node_id: String }
  | DispatchObserveRefused { node_id: String, reason: String }
  | DispatchSpawnFailed { node_id: String, step: String, detail: String }

fn belt_dispatch_node_for_instance(
  instance: HostDashboardInstance,
  node_id: String,
) -> BeltDispatchResult {
  match instance.actuation {
    DashboardObserveOnly =>
    DispatchDisabled {
      node_id: node_id,
      instance_id: instance.instance_id as String,
      reason: "dashboard instance is observe-only; dispatch refused before observation, provider preflight, or worktree creation",
    }
    DashboardActuating => {
  match belt_lookup_node(node_id: node_id) {
    NodeMissing => DispatchNodeNotFound { node_id: node_id }
    NodeFound { node: node } =>
      if signoff_accepts(s: node.signoff) {
        DispatchNodeAlreadyDone { node_id: node_id }
      } else {
        match belt_observe_for_instance(instance: instance) {
          ObserveRefused { reason: r } =>
            DispatchObserveRefused { node_id: node_id, reason: r }
          Observed { live: live } =>
            if belt_node_session_live(live: live, node_id: node_id) {
              DispatchAlreadyLive {
                node_id: node_id,
                session_name: dispatch_tmux_session_name(node_id: node.node),
              }
            } else {
              match (match clock_now_probed_at() {
                Present { value: probed_at } =>
                  belt_actuate_spawn_for_instance(
                    instance: instance,
                    node: node,
                    probed_at: probed_at as String,
                  )
                Absent =>
                  SpawnFailed {
                    node_id: node_id,
                    step: "attempt-clock",
                    detail: "clock observation refused; an attempt without a stamp would collide with a later one — fail-closed, no unknown-stamped attempts",
                  }
              }) {
                Spawned { node_id: sid, session_name: sn } =>
                  DispatchSpawned { node_id: sid, session_name: sn }
                SpawnFailed { node_id: sid, step: st, detail: d } =>
                  DispatchSpawnFailed { node_id: sid, step: st, detail: d }
              }
            }
        }
      }
  }
  }
  }
}

fn belt_dispatch_node(node_id: String) -> BeltDispatchResult {
  belt_dispatch_node_for_instance(
    instance: srv1_live_dashboard_instance(),
    node_id: node_id,
  )
}

fn belt_dispatch_result_ok(r: BeltDispatchResult) -> Bool {
  dispatch_band_is_ok(b: belt_dispatch_result_band(r: r))
}

data belt_dispatch_status_label_note: String = "The ONE wire vocabulary for a dispatch result (DESIGN §3, found live 2026-07-23): the served JSON body's `status` member and the roadmap page's client-side ok-check are two consumers of ONE label set — the dispatch button read a retired belt-A `\{ok, node\}` shape while belt B answered `\{status, ...\}`, so EVERY successful click rendered 'failed' (a silently-wrong UI answer, §5). belt_dispatch_status_label is the per-variant label authority consumed by belt_dispatch_result_json_value; belt_dispatch_ok_status_labels is the ok-subset the page derives its JS predicate from, glued to belt_dispatch_result_ok by witness (a label moved across the ok/refusal line without updating both surfaces goes RED)."

fn belt_dispatch_status_label(r: BeltDispatchResult) -> String {
  match r {
    DispatchSpawned { node_id: _, session_name: _ } => "spawned"
    DispatchAlreadyLive { node_id: _, session_name: _ } => "already_live"
    DispatchDisabled { node_id: _, instance_id: _, reason: _ } => "disabled"
    DispatchNodeNotFound { node_id: _ } => "node_not_found"
    DispatchNodeAlreadyDone { node_id: _ } => "already_done_signed_off"
    DispatchObserveRefused { node_id: _, reason: _ } => "observe_refused"
    DispatchSpawnFailed { node_id: _, step: _, detail: _ } => "spawn_failed"
  }
}

fn belt_dispatch_disabled_status_label() -> String {
  belt_dispatch_status_label(
    r: DispatchDisabled {
      node_id: "label-exemplar",
      instance_id: "label-exemplar",
      reason: "label-exemplar",
    },
  )
}

data dispatch_band_note: String = "The operator-facing state vocabulary (operator ruling 2026-07-24, roadmap-workspace-remodel-plan W1a): the wire taxonomy is the belt's DIAGNOSTIC vocabulary and must not moonlight as button text. The operator reads BANDS, each a remedy class — ok: the click achieved or already holds the desired state; fail: this click cannot achieve it and the ROW is the remedy (wrong node, already signed off); loud: the BELT itself is unwell (observe refused, spawn failed — step/detail surface in the detail channel, never the caption). BandInProgress is inhabited only by the client's requested phase: no wire RESULT maps to it (the fold below has no arm producing it), so presentation cannot fabricate progress out of an answer. This fold is now the SINGLE ok-authority — belt_dispatch_result_ok and belt_dispatch_ok_status_labels are projections of it; the former hand copies (a Bool match, a hand list, a label predicate — three spellings of one fact) were the half-born-band defect this dissolves."

type DispatchBand
  = BandOk
  | BandInProgress
  | BandFail
  | BandLoud

fn belt_dispatch_result_band(r: BeltDispatchResult) -> DispatchBand {
  match r {
    DispatchSpawned { node_id: _, session_name: _ } => BandOk
    DispatchAlreadyLive { node_id: _, session_name: _ } => BandOk
    DispatchDisabled { node_id: _, instance_id: _, reason: _ } => BandFail
    DispatchNodeNotFound { node_id: _ } => BandFail
    DispatchNodeAlreadyDone { node_id: _ } => BandFail
    DispatchObserveRefused { node_id: _, reason: _ } => BandLoud
    DispatchSpawnFailed { node_id: _, step: _, detail: _ } => BandLoud
  }
}

fn dispatch_band_key(b: DispatchBand) -> String {
  match b {
    BandOk => "ok"
    BandInProgress => "in-progress"
    BandFail => "fail"
    BandLoud => "loud"
  }
}

fn dispatch_band_is_ok(b: DispatchBand) -> Bool {
  match b {
    BandOk => true
    BandInProgress => false
    BandFail => false
    BandLoud => false
  }
}

fn belt_dispatch_ok_status_labels() -> List<String> {
  belt_dispatch_result_exemplars()
    |> filter(r => dispatch_band_is_ok(b: belt_dispatch_result_band(r: r)))
    |> map(r => belt_dispatch_status_label(r: r))
}

type DispatchLabelBandRow {
  wire_label: String
  band_key: String
}

fn belt_dispatch_label_band_rows() -> List<DispatchLabelBandRow> {
  map(belt_dispatch_result_exemplars(), r => DispatchLabelBandRow {
    wire_label: belt_dispatch_status_label(r: r),
    band_key: dispatch_band_key(b: belt_dispatch_result_band(r: r)),
  })
}

fn label_band_rows_cover(rows: List<DispatchLabelBandRow>, labels: List<String>) -> Bool {
  all(labels, l => count(filter(rows, row => row.wire_label == l)) == 1)
}

fn belt_dispatch_label_band_key(wire_label: String) -> String {
  match belt_dispatch_result_for_label(wire_label: wire_label) {
    Present { value: r } => dispatch_band_key(b: belt_dispatch_result_band(r: r))
    Absent => dispatch_band_key(b: BandLoud)
  }
}

data belt_dispatch_all_status_labels_note: String = "The full wire-label set, GROUNDED in belt_dispatch_status_label rather than hand-listed (§3): one exemplar per BeltDispatchResult variant, mapped through the label authority. The exemplar roster is the single manual enumeration the closed variant set forces — the same enumeration witness_dispatch_status_labels_pin_wire_contract already pins — and it is fail-closed twice: an 8th variant makes belt_dispatch_status_label's match non-exhaustive (compiler-caught), and gunbc.roadmap_component derives the DispatchButton's terminal states from THIS list and cross-checks totality both directions (a label with no state row, a state with no label — each red), so the button's state set cannot silently drift from the served contract. This is the projection the dispatch-button incident (2026-07-23) needed: one authority for the wire vocabulary, consumed by the JSON body, the page ok-predicate, and now the component state totality."

fn belt_dispatch_result_exemplars() -> List<BeltDispatchResult> {
  [
    DispatchSpawned { node_id: "x", session_name: "s" },
    DispatchAlreadyLive { node_id: "x", session_name: "s" },
    DispatchDisabled { node_id: "x", instance_id: "i", reason: "r" },
    DispatchNodeNotFound { node_id: "x" },
    DispatchNodeAlreadyDone { node_id: "x" },
    DispatchObserveRefused { node_id: "x", reason: "r" },
    DispatchSpawnFailed { node_id: "x", step: "s", detail: "d" },
  ]
}

fn belt_dispatch_all_status_labels() -> List<String> {
  map(belt_dispatch_result_exemplars(), r => belt_dispatch_status_label(r: r))
}

fn belt_dispatch_result_for_label(wire_label: String) -> BeltDispatchResult? {
  belt_dispatch_result_exemplars()
    |> filter(r => belt_dispatch_status_label(r: r) == wire_label)
    |> first
}

fn belt_dispatch_label_is_ok(wire_label: String) -> Bool {
  any(belt_dispatch_ok_status_labels(), l => l == wire_label)
}

data belt_dispatch_path_prefix_note: String = "The dispatch route prefix, part of the wire contract (the click POSTs to prefix+NODE_ID; belt B answers it at the /dispatch/ NODE_ID route). Homed here with the rest of the wire vocabulary (§3) so the client script builder (gunbc.roadmap_component) and the emitted server (node_http_server_emit) read one authority — it moved off roadmap_page to break the page-to-component import cycle the TsProgram builder would otherwise create."

data belt_dispatch_path_prefix: String = "/dispatch/"

fn belt_dispatch_provider_label() -> String {
  dispatch_provider_label(provider: dispatch_cli_provider)
}

fn belt_dispatch_result_json_value(r: BeltDispatchResult) -> JsonValue {
  match r {
    DispatchSpawned { node_id: nid, session_name: sn } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: belt_dispatch_status_label(r: r))),
        json_kv(key: "provider", value: json_string(s: belt_dispatch_provider_label())),
        json_kv(key: "session_name", value: json_string(s: sn)),
      ])
    DispatchAlreadyLive { node_id: nid, session_name: sn } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: belt_dispatch_status_label(r: r))),
        json_kv(key: "session_name", value: json_string(s: sn)),
      ])
    DispatchDisabled { node_id: nid, instance_id: iid, reason: why } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: belt_dispatch_status_label(r: r))),
        json_kv(key: "instance", value: json_string(s: iid)),
        json_kv(key: "reason", value: json_string(s: why)),
      ])
    DispatchNodeNotFound { node_id: nid } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: belt_dispatch_status_label(r: r))),
      ])
    DispatchNodeAlreadyDone { node_id: nid } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: belt_dispatch_status_label(r: r))),
      ])
    DispatchObserveRefused { node_id: nid, reason: r2 } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: belt_dispatch_status_label(r: r))),
        json_kv(key: "reason", value: json_string(s: r2)),
      ])
    DispatchSpawnFailed { node_id: nid, step: st, detail: d } =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: nid)),
        json_kv(key: "status", value: json_string(s: belt_dispatch_status_label(r: r))),
        json_kv(key: "provider", value: json_string(s: belt_dispatch_provider_label())),
        json_kv(key: "step", value: json_string(s: st)),
        json_kv(key: "detail", value: json_string(s: d)),
      ])
  }
}

data belt_dispatch_env_var: NonEmptyStr = "GUNBC_BELT_NODE_ID" as NonEmptyStr

data belt_dispatch_node_cli_note: String = "The ProcessExit entrypoint the roadmap-UI launch button drives. gunbc run --function cannot pass an argument (there is no --arg flag), so the node id enters through the environment: the Node HTTP server on srv1 shells env GUNBC_BELT_NODE_ID=NODE gunbc run --function belt_dispatch_node_cli, and this reads it via shell.Env.Get (the same env-read authority github.auth uses for its token). Fail-closed on the channel: a missing OR empty GUNBC_BELT_NODE_ID refuses — shell.Env.Get returns a Present-but-empty value for an unset var wet, so empty is folded into the same refusal as Absent. Exit map: DispatchSpawned or DispatchAlreadyLive -> ExitSuccess (the click achieved or already holds the desired state, the node is being worked); every refusal or failure (node_not_found, already_done, observe_refused, spawn_failed) -> exit_failure with the JSON receipt on stderr, so the server relays the exact cause back to the operator."

fn belt_dispatch_node_cli() -> ProcessExit {
  match shell.Env.Get(name: belt_dispatch_env_var).value {
    Absent =>
      exit_failure(reason: "belt_dispatch_node_cli: GUNBC_BELT_NODE_ID not set — no node id to dispatch (fail-closed)")
    Present { value: v } =>
      if string_length(s: v) == 0 {
        exit_failure(reason: "belt_dispatch_node_cli: GUNBC_BELT_NODE_ID is empty — no node id to dispatch (fail-closed)")
      } else {
        let r = belt_dispatch_node(node_id: v)
        if belt_dispatch_result_ok(r: r) {
          ExitSuccess
        } else {
          exit_failure(reason: serialize_json(v: belt_dispatch_result_json_value(r: r)))
        }
      }
  }
}
