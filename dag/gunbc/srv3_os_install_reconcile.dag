fn held_lease_observed_from_serve(serve: NbdServeObservation) -> HeldLeaseObservedState {
  match serve {
    ServeUnknown => LeaseInaccessible
    ServeObserved { process: proc, port: port, session: _, iso: _ } =>
      match proc {
        NbdkitAbsent => LeaseAbsent
        WebsocatAbsent => LeaseAbsent
        ServeProcessesPresent =>
          match port {
            ServePortAbsent => LeaseAbsent
            ServePortConflict => LeasePortForeign
            ServePortListening { port: _, owner_matches_expected: owner_ok } =>
              if owner_ok {
                LeaseRunningExpected
              } else {
                LeasePortForeign
              }
          }
      }
  }
}

fn srv3_held_lease_from_serve(serve: NbdServeObservation) -> HeldLease {
  HeldLease {
    lease_key: srv3_nbd_proxy_lease_key,
    resource_fingerprint: srv3_seeded_install_media_content_hash,
    owner_fingerprint: "gunbc-nbd-proxy" as ContentHash,
    generation: 1,
    observed: held_lease_observed_from_serve(serve: serve),
  }
}

fn kvm_screen_from_diagnostic(
  diagnostic: Srv3InstallDiagnostic,
  observation: Srv3InstallDebugObservation,
) -> KvmObservedScreen {
  match diagnostic {
    BootOverrideConsumedNoInstallEvidence =>
      match observation.sol {
        Present { value: sol } =>
          if sol.contains_firmware_menu {
            FirmwareSetup
          } else {
            if sol.contains_grub {
              GrubMenu
            } else {
              UefiBootMenu
            }
          }
        Absent => UefiBootMenu
      }
    InstallerProbablyRunning =>
      match observation.sol {
        Present { value: sol } =>
          if sol.contains_subiquity {
            SubiquityStorageScreen
          } else {
            if sol.contains_grub {
              GrubMenu
            } else {
              UefiBootMenu
            }
          }
        Absent => UefiBootMenu
      }
    _ => UefiBootMenu
  }
}

fn optional_kvm_attestation_from_observation(
  diagnostic: Srv3InstallDiagnostic,
  observation: Srv3InstallDebugObservation,
  observed_at: Timestamp,
) -> KvmOperatorAttestation? {
  match diagnostic {
    BootOverrideConsumedNoInstallEvidence => Present {
      value: KvmOperatorAttestation {
        target: operator_host_srv3,
        observed_screen: kvm_screen_from_diagnostic(
          diagnostic: diagnostic,
          observation: observation,
        ),
        observed_at: observed_at,
        attested_by: "reconcile-infer-sol-redfish" as NonEmptyStr,
      },
    }
    _ => Absent
  }
}

fn deduction_runtime_hint(
  preflight: OsInstallPreflightVerdict,
  diagnostic: Srv3InstallDiagnostic,
  observation: Srv3InstallDebugObservation,
  observed_at: Timestamp,
) -> DeductionRuntimeHint {
  match optional_kvm_attestation_from_observation(
    diagnostic: diagnostic,
    observation: observation,
    observed_at: observed_at,
  ) {
    Present { value: att } => DeductionRuntimePresent {
      verdict: runtime_verdict_from_kvm_attestation(
        attestation: att,
        preflight: preflight,
      ),
    }
    Absent => DeductionRuntimeAbsent
  }
}

fn reconcile_pending_step_id(diagnostic: Srv3InstallDiagnostic) -> NonEmptyStr {
  match diagnostic {
    ReadyToBoot => "boot-once-cd" as NonEmptyStr
    ServeDown => "nbd-serve" as NonEmptyStr
    BootOverrideNotArmed => "boot-once-cd" as NonEmptyStr
    BootOverrideConsumedNoInstallEvidence => "boot-once-cd" as NonEmptyStr
    InstallerProbablyRunning => "monitor-install" as NonEmptyStr
    OsInstalled => "post-install-verify" as NonEmptyStr
    _ => "diagnose" as NonEmptyStr
  }
}

fn reconcile_requires_destructive_approval(step_id: NonEmptyStr) -> Bool {
  step_id == srv3_boot_once_cd_step_id
}

fn plan_boot_once_cd_with_lease(lease: HeldLease, step_id: NonEmptyStr) -> NextStepPlan {
  match lease.observed {
    LeaseRunningExpected => PlanApply { step_id: step_id }
    LeaseAbsent =>
      PlanRefuse {
        step_id: step_id,
        reason: "nbd serve lease absent before boot-once-cd",
      }
    LeasePortForeign =>
      PlanRefuse {
        step_id: step_id,
        reason: "foreign lease holder on scoped nbd serve resource",
      }
    LeaseRunningStale =>
      PlanRefuse {
        step_id: step_id,
        reason: "stale nbd serve lease before boot-once-cd",
      }
    LeaseInaccessible =>
      PlanRefuse {
        step_id: step_id,
        reason: "nbd serve lease observation inaccessible",
      }
  }
}

fn plan_boot_once_cd_step(
  intent: EffectAttemptIntent,
  escalation_id: NonEmptyStr,
  grant: DurableApprovalGrant,
  lease: HeldLease,
  prior: PriorStepReceipt,
  observed_at: Timestamp,
) -> NextStepPlan {
  if !approval_grant_covers_intent(
    grant: grant,
    intent: intent,
    escalation_id: escalation_id,
    observed_at: observed_at,
  ) {
    PlanAwaitApproval { escalation_id: escalation_id }
  } else {
    match prior {
      PriorReceipt { receipt: r } =>
        if r.step_id == srv3_boot_once_cd_step_id && r.read_back_ok {
          PlanNoop { step_id: srv3_boot_once_cd_step_id }
        } else {
          if r.step_id == srv3_boot_once_cd_step_id && !r.read_back_ok {
            PlanRefuse {
              step_id: srv3_boot_once_cd_step_id,
              reason: "prior boot-once-cd applied without read-back convergence",
            }
          } else {
            plan_boot_once_cd_with_lease(lease: lease, step_id: srv3_boot_once_cd_step_id)
          }
        }
      NoPriorReceipt =>
        plan_boot_once_cd_with_lease(lease: lease, step_id: srv3_boot_once_cd_step_id)
    }
  }
}

fn reconcile_temporal_plan(
  pending_step_id: NonEmptyStr,
  grant: DurableApprovalGrant,
  lease: HeldLease,
  prior: PriorStepReceipt,
  observed_at: Timestamp,
) -> NextStepPlan {
  if pending_step_id == srv3_boot_once_cd_step_id {
    plan_boot_once_cd_step(
      intent: srv3_install_effect_attempt_intent,
      escalation_id: srv3_boot_once_cd_escalation.escalation_id,
      grant: grant,
      lease: lease,
      prior: prior,
      observed_at: observed_at,
    )
  } else {
    plan_next_step_from_prior_receipt_and_lease(
      intent: srv3_install_effect_attempt_intent,
      pending_step_id: pending_step_id,
      requires_destructive_approval: reconcile_requires_destructive_approval(step_id: pending_step_id),
      escalation_id: srv3_boot_once_cd_escalation.escalation_id,
      grant: grant,
      lease: lease,
      prior: prior,
      observed_at: observed_at,
    )
  }
}

