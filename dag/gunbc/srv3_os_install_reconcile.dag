fn parse_grant_field_token(tail: String) -> String {
  let token = split(s: tail, delimiter: " ").first()
  split(s: token, delimiter: "\n").first()
}

fn parse_grant_field(contents: String, key: String) -> String {
  let marker = concat(key, "=")
  if !string_contains(s: contents, pattern: marker) {
    concat("", "")
  } else {
    let parts = split(s: contents, delimiter: marker)
    if parts.length() <= 1 {
      concat("", "")
    } else {
      let tail = parts.skip(n: 1).first()
      parse_grant_field_token(tail: tail)
    }
  }
}

fn parse_durable_approval_grant_file(contents: String) -> DurableApprovalGrant {
  if !string_contains(s: contents, pattern: "Srv3InstallApprovalGrant:") {
    GrantAbsent
  } else {
    let escalation_id = parse_grant_field(contents: contents, key: "escalation_id")
    let intent_hash = parse_grant_field(contents: contents, key: "intent_hash")
    let granted_by = parse_grant_field(contents: contents, key: "granted_by")
    let granted_at = parse_grant_field(contents: contents, key: "granted_at")
    let expires_at = parse_grant_field(contents: contents, key: "expires_at")
    if escalation_id == ""
      || intent_hash == ""
      || granted_by == ""
      || granted_at == ""
      || expires_at == "" {
      GrantAbsent
    } else {
      if intent_hash == (srv3_install_effect_attempt_intent.intent_hash as String) {
        GrantActive {
          escalation_id: escalation_id as NonEmptyStr,
          intent_hash: intent_hash as ContentHash,
          granted_by: granted_by as NonEmptyStr,
          granted_at: granted_at,
          expires_at: expires_at,
        }
      } else {
        GrantAbsent
      }
    }
  }
}
fn parse_observed_at_from_stdout(stdout: String) -> String? {
  let parts = split(s: stdout, delimiter: "surface=observed_at=")
  if parts.length() <= 1 {
    Absent
  } else {
    let tail = parts.skip(n: 1).first()
    let token = split(s: tail, delimiter: "\n").first()
    match token == concat("", "") {
      true => Absent
      false => Present { value: token }
    }
  }
}

