fn sol_has_new_installer_markers(
  pre: Srv3InstallDebugObservation,
  post: Srv3InstallDebugObservation,
) -> Bool {
  match post.sol {
    Present { value: post_sol } =>
      match pre.sol {
        Present { value: pre_sol } =>
          (post_sol.contains_grub && !pre_sol.contains_grub)
            || (post_sol.contains_subiquity && !pre_sol.contains_subiquity)
            || (post_sol.contains_autoinstall && !pre_sol.contains_autoinstall)
        Absent =>
          post_sol.contains_grub
            || post_sol.contains_subiquity
            || post_sol.contains_autoinstall
      }
    Absent => false
  }
}

fn redfish_boot_override_is_consumed(obs: RedfishBootObservation) -> Bool {
  obs.boot_override_enabled == BootOverrideDisabled
    && obs.boot_override_target == BootTargetNone
}

fn redfish_boot_override_is_armed_for_cd(obs: RedfishBootObservation) -> Bool {
  obs.boot_override_enabled == BootOverrideOnce
    && obs.boot_override_target == BootTargetCd
}

fn boot_override_armed_to_consumed_transition(
  pre: Srv3InstallDebugObservation,
  post: Srv3InstallDebugObservation,
) -> Bool {
  redfish_boot_override_is_armed_for_cd(obs: pre.redfish_boot)
    && redfish_boot_override_is_consumed(obs: post.redfish_boot)
}

fn boot_once_elapsed_advanced_after_pre_boot_ready(
  pre: Srv3InstallDebugObservation,
  post: Srv3InstallDebugObservation,
) -> Bool {
  if !srv3_install_pre_boot_ready_to_boot(observation: pre)
    || !redfish_boot_override_is_consumed(obs: post.redfish_boot) {
    false
  } else {
    match pre.elapsed_since_boot_once_ms {
      Absent =>
        match post.elapsed_since_boot_once_ms {
          Present { value: post_elapsed } => post_elapsed > 0
          Absent => false
        }
      Present { value: pre_elapsed } =>
        match post.elapsed_since_boot_once_ms {
          Present { value: post_elapsed } => post_elapsed > pre_elapsed
          Absent => false
        }
    }
  }
}

fn boot_once_apply_read_back_ok(
  pre: Srv3InstallDebugObservation,
  post: Srv3InstallDebugObservation,
  apply_succeeded: Bool,
) -> Bool {
  if !apply_succeeded || !install_serve_session_active(observation: post) {
    false
  } else {
    sol_has_new_installer_markers(pre: pre, post: post)
  }
}

fn consumed_grant_after_boot_once() -> DurableApprovalGrant {
  GrantConsumed {
    escalation_id: srv3_boot_once_cd_escalation.escalation_id,
    intent_hash: srv3_install_effect_attempt_intent.intent_hash,
    consumed_by_step: srv3_boot_once_cd_step_id,
  }
}

fn reconcile_srv3_os_install(
  intent: OsInstallAttemptIntent,
  observation: Srv3InstallDebugObservation,
  disk: TargetDiskState,
  observed_at: Timestamp,
  grant: DurableApprovalGrant,
  prior: PriorStepReceipt,
) -> Srv3InstallReconcileResult {
  let preflight = fold_nbd_proxy_os_install_preflight_verdict(
    payload: srv3_ubuntu_autoinstall_on_iso,
    disk: disk,
  )
  let preflight_plan = plan_for_os_install_preflight_verdict(verdict: preflight)
  let diagnostic = diagnose_srv3_install(intent: intent, observation: observation)
  let deduction_runtime = deduction_runtime_hint(
    preflight: preflight,
    diagnostic: diagnostic,
    observation: observation,
    observed_at: observed_at,
  )
  let pending_step_id = reconcile_pending_step_id(diagnostic: diagnostic)
  let lease = srv3_held_lease_from_serve(serve: observation.actuator_serve)
  let temporal_plan = reconcile_temporal_plan(
    pending_step_id: pending_step_id,
    grant: grant,
    lease: lease,
    prior: prior,
    observed_at: observed_at,
  )
  Srv3InstallReconcileResult {
    preflight: preflight,
    preflight_plan: preflight_plan,
    diagnostic: diagnostic,
    deduction_runtime: deduction_runtime,
    temporal_plan: temporal_plan,
    pending_step_id: pending_step_id,
  }
}

fn reconcile_srv3_os_install_dry_run_fixture(
  observation: Srv3InstallDebugObservation,
) -> Srv3InstallReconcileResult {
  reconcile_srv3_os_install(
    intent: srv3_os_install_attempt_intent,
    observation: observation,
    disk: srv3_install_reconcile_default_disk,
    observed_at: srv3_install_reconcile_dry_run_observed_at,
    grant: GrantAbsent,
    prior: NoPriorReceipt,
  )
}
