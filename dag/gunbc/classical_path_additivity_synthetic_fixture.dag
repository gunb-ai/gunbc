module gunbc.classical_path_additivity_synthetic_fixture

import std.types { Bool, Int, List }
import gunbc.physics.classical_path_additivity {
  SyntheticDoubleSlitFixture,
  SyntheticDoubleSlitFixtureOne,
  SyntheticSlitArrangement,
  BothSlitsOpen,
  SlitOneOpen,
  SlitTwoOpen,
  BothSlitsBlocked,
  ScreenBand,
  CentralBand,
  FirstMinimumBand,
  SyntheticMatchedExposureSession,
  SyntheticMatchedExposureOne,
  SyntheticArrivalCountObservationRow,
  PathAdditivitySubject,
  PathAdditivitySyntheticFixture,
  PathAdditivityRefutationReceipt,
  Less,
  Greater,
  ArrivalCountResolution,
  ArrivalCountResolved,
  ArrivalCountMissing,
  AdditivityInputResolution,
  AdditivityInputsResolved,
  AdditivityInputsIncomplete,
  resolve_arrival_count_at,
  resolve_additivity_inputs,
  derive_path_additivity_refutation_at_band,
  path_additivity_refutation_holds_for_synthetic_fixture,
  path_additivity_refutation_from_resolved,
  path_additivity_witness_is_counterexample,
}

data synthetic_fixture_note: String = "SYNTHETIC MECHANISM FIXTURE — NOT Bach et al. 2013 provenance. Rows exercise gunbc.physics.classical_path_additivity with equal declared exposure identity; classical mechanism adds raw counts."

data synthetic_double_slit_fixture: SyntheticDoubleSlitFixture = SyntheticDoubleSlitFixtureOne {}

data synthetic_first_minimum_both_open: SyntheticArrivalCountObservationRow = SyntheticArrivalCountObservationRow {
  fixture: synthetic_double_slit_fixture,
  arrangement: BothSlitsOpen,
  band: FirstMinimumBand,
  exposure: SyntheticMatchedExposureOne {},
  arrival_count: 5,
}

data synthetic_first_minimum_slit_one: SyntheticArrivalCountObservationRow = SyntheticArrivalCountObservationRow {
  fixture: synthetic_double_slit_fixture,
  arrangement: SlitOneOpen,
  band: FirstMinimumBand,
  exposure: SyntheticMatchedExposureOne {},
  arrival_count: 10,
}

data synthetic_first_minimum_slit_two: SyntheticArrivalCountObservationRow = SyntheticArrivalCountObservationRow {
  fixture: synthetic_double_slit_fixture,
  arrangement: SlitTwoOpen,
  band: FirstMinimumBand,
  exposure: SyntheticMatchedExposureOne {},
  arrival_count: 10,
}

data synthetic_central_both_open: SyntheticArrivalCountObservationRow = SyntheticArrivalCountObservationRow {
  fixture: synthetic_double_slit_fixture,
  arrangement: BothSlitsOpen,
  band: CentralBand,
  exposure: SyntheticMatchedExposureOne {},
  arrival_count: 95,
}

data synthetic_central_slit_one: SyntheticArrivalCountObservationRow = SyntheticArrivalCountObservationRow {
  fixture: synthetic_double_slit_fixture,
  arrangement: SlitOneOpen,
  band: CentralBand,
  exposure: SyntheticMatchedExposureOne {},
  arrival_count: 40,
}

data synthetic_central_slit_two: SyntheticArrivalCountObservationRow = SyntheticArrivalCountObservationRow {
  fixture: synthetic_double_slit_fixture,
  arrangement: SlitTwoOpen,
  band: CentralBand,
  exposure: SyntheticMatchedExposureOne {},
  arrival_count: 38,
}

data synthetic_blocked_central: SyntheticArrivalCountObservationRow = SyntheticArrivalCountObservationRow {
  fixture: synthetic_double_slit_fixture,
  arrangement: BothSlitsBlocked,
  band: CentralBand,
  exposure: SyntheticMatchedExposureOne {},
  arrival_count: 0,
}

data synthetic_fixture_arrival_count_observations: List<SyntheticArrivalCountObservationRow> = [
  synthetic_first_minimum_both_open,
  synthetic_first_minimum_slit_one,
  synthetic_first_minimum_slit_two,
  synthetic_central_both_open,
  synthetic_central_slit_one,
  synthetic_central_slit_two,
  synthetic_blocked_central,
]

data path_additivity_subject: PathAdditivitySubject = PathAdditivitySyntheticFixture {}

fn synthetic_first_minimum_refutation_receipt() -> PathAdditivityRefutationReceipt {
  path_additivity_refutation_from_resolved(
    left: 10,
    right: 10,
    both: 5,
    band: FirstMinimumBand,
    exposure: SyntheticMatchedExposureOne {},
    observed_vs_prediction: Less,
  )
}

data classical_path_additivity_refuted: PathAdditivityRefutationReceipt = synthetic_first_minimum_refutation_receipt()

fn classical_path_additivity_refutation_holds() -> Bool {
  path_additivity_refutation_holds_for_synthetic_fixture(receipt: classical_path_additivity_refuted)
}

fn classical_path_additivity_central_band_refutation_holds() -> Bool {
  match derive_path_additivity_refutation_at_band(
    rows: synthetic_fixture_arrival_count_observations,
    fixture: synthetic_double_slit_fixture,
    band: CentralBand,
    exposure: SyntheticMatchedExposureOne {},
  ) {
    Present {
      value: PathAdditivityRefutationReceipt {
        witness: w,
        subject: s,
        location: l,
      },
    } =>
      path_additivity_witness_is_counterexample(witness: w)
        && w.observed_vs_prediction == Greater
    Absent => false
  }
}

fn synthetic_blocked_count_is_resolved_zero_not_missing() -> Bool {
  match resolve_arrival_count_at(
    rows: synthetic_fixture_arrival_count_observations,
    fixture: synthetic_double_slit_fixture,
    arrangement: BothSlitsBlocked,
    band: CentralBand,
    exposure: SyntheticMatchedExposureOne {},
  ) {
    ArrivalCountResolved { count: 0, contributing_rows: 1 } => true
    ArrivalCountMissing {
      arrangement: missing_arrangement,
      band: missing_band,
      exposure: missing_exposure,
    } => false
    _ => false
  }
}

fn synthetic_missing_row_yields_incomplete_inputs() -> Bool {
  let partial_rows = [
    synthetic_first_minimum_both_open,
    synthetic_first_minimum_slit_one,
  ]
  match resolve_additivity_inputs(
    rows: partial_rows,
    fixture: synthetic_double_slit_fixture,
    band: FirstMinimumBand,
    exposure: SyntheticMatchedExposureOne {},
  ) {
    AdditivityInputsIncomplete {
      missing_arrangement: SlitTwoOpen,
      band: incomplete_band,
      exposure: incomplete_exposure,
    } => true
    AdditivityInputsResolved {
      left: resolved_left,
      right: resolved_right,
      both: resolved_both,
      left_contributing_rows: resolved_left_rows,
      right_contributing_rows: resolved_right_rows,
      both_contributing_rows: resolved_both_rows,
    } => false
    _ => false
  }
}
