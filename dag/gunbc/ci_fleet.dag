module gunbc.ci_fleet


type CostClass = OwnedMarginalZero | PerSecondBilled | Metered | DeveloperAttention

type CostModel { cost_class: CostClass }

type AvailabilityWindow { open: std.types.LogicalTime, close: std.types.LogicalTime? }

type CostEstimate { model: CostModel, unit_price: std.measure.MoneyAmountMicro, currency: std.currency.CurrencyCode }

type ComputeSupplyFacts {
  physical: gunbc.fleet_intent.ComputeHost
  execution: gunbc.fleet_intent.ExecutionSurface
  cost: CostModel?
  observed_performance: List<gunbc.fleet_intent.PerformanceReceipt>
}

type ComputeOffer {
  provider: gunbc.fleet_intent.ProviderIdentity
  supply: ComputeSupplyFacts
  available_window: AvailabilityWindow
  cost_quote: CostEstimate?
}

fn per_second_billed_cost_quote(unit_price: std.measure.MoneyAmountMicro, currency: std.currency.CurrencyCode) -> CostEstimate {
  CostEstimate {
    model: CostModel { cost_class: PerSecondBilled },
    unit_price: unit_price,
    currency: currency,
  }
}

fn cost_estimate_unit_price_micros(quote: CostEstimate) -> std.nat.Nat {
  std.measure.money_amount_micro_count(m: quote.unit_price)
}

fn operator_owned_cost() -> CostModel {
  CostModel { cost_class: OwnedMarginalZero }
}

data srv1_offer: ComputeOffer = ComputeOffer {
  provider: "gunbc-operator-srv1",
  supply: ComputeSupplyFacts {
    physical: gunbc.fleet_intent.srv1_host,
    execution: gunbc.fleet_intent.fleet_intent_execution_surface(),
    cost: Present { value: operator_owned_cost() },
    observed_performance: [],
  },
  available_window: AvailabilityWindow { open: "always-open", close: none },
  cost_quote: none,
}

