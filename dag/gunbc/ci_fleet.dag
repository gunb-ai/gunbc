data fleet_intent_offers: List<ComputeOffer> = [srv1_offer, srv2_offer, srv3_offer, srv4_offer]

data gunbc_ci_host_identity: product.placement_supply.HostIdentity = "gunbc-ci-fleet"

data gunbc_ci_cpu: extdeps.cpu.types.CpuFacts = extdeps.cpu.types.CpuFacts {
  catalog: extdeps.cpu.ampere.altra_q6430_catalog,
  deployment: extdeps.cpu.types.CpuDeploymentFacts { sustained_per_thread_hz: std.measure.hertz(3000000000) },
}

data gunbc_ci_linux_surface: std.os.types.OperatingSystemSurface = std.os.types.OperatingSystemSurface {
  kernel: std.os.types.Linux,
  distro_or_product: none,
  version: none,
  filesystem_semantics: std.os.types.Posix,
  process_semantics: std.os.types.PosixProcess,
}

data gunbc_ci_host_memory_deferral_note: String = gunbc.fleet_intent.fleet_host_memory_nominal_vs_usable_note

data gunbc_ci_host_memory_deferral_disposition: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: std.disposition.SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.ci_fleet",
    decl_name: "gunbc_ci_host",
    field: std.decl_ref.NamedField { field_name: "memory" },
  },
}

data gunbc_ci_host: gunbc.fleet_intent.ComputeHost = gunbc.fleet_intent.ComputeHost {
  identity: gunbc_ci_host_identity,
  baseboard: none,
  processors: [gunbc.fleet_intent.CpuProcessor { cpu: gunbc_ci_cpu }],
  memory: [gunbc.fleet_intent.MemoryDevice { capacity: std.measure.byte_size(134217728000), memory_kind: extdeps.memory.types.Dram, bandwidth: none }],
  storage: [],
  network_interfaces: [],
}

data gunbc_ci_fleet_offer: ComputeOffer = ComputeOffer {
  provider: "gunbc-ci-fleet",
  supply: ComputeSupplyFacts {
    physical: gunbc_ci_host,
    execution: gunbc.fleet_intent.ExecutionSurface {
      os: gunbc_ci_linux_surface,
      isolation: gunbc.fleet_intent.PerJobFilesystem,
      container_runtime: none,
      toolchains: [],
      mounted_storage: [],
      network: [],
    },
    cost: Present { value: operator_owned_cost() },
    observed_performance: [],
  },
  available_window: AvailabilityWindow { open: "always-open", close: none },
  cost_quote: none,
}

