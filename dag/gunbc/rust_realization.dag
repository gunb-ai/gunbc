module gunbc.rust_realization

import std.decl_ref { DeclarationRef, decl_ref, declaration_ref_eq }
import extdeps.languages.rust.type_identity {
  RustTypeIdentity, RustPrimitiveType, RustNamedType, RustAppliedType,
  rust_type_identity_is_grounded
}

// WHICH DAG DECLARATION REALIZES AS WHICH RUST TYPE. This is a gunbc-corpus fact and lives here,
// deliberately not in extdeps: a TypeCheckpoint row is cited to the Rust reference and states how
// RUST spells a type, whereas which module declares Int is a fact about this repository. Putting a
// declaring-module column on the extdeps row would ask a cited upstream authority a question its
// source cannot answer -- a layer inversion. Two authorities join instead:
//
//     DeclarationRef  --(this table)-->  RustTypeIdentity  --(extdeps)-->  spelling and facts
//
// It lives outside src/v1 so v2 translation can consume the same authority rather than inheriting
// a seed-only fact.
//
// WHY IDENTITY RATHER THAN SPELLING. The predecessor keyed realization on the authored leaf name,
// so two declarations sharing a spelling received one answer. That is not a style preference: it
// silently DROPPED A GUARANTEE. v2.std.node.Hash is Fnv1a64Structural, whose public constructors
// are deleted precisely so the `where lower_hex_16` refinement IS its construction wall; a bare
// "Hash" row targeting v1_rt::Hash (`pub type Hash = String`) rendered that carrier away as a bare
// String alias, and with it the wall. A name-keyed spelling row can therefore demote a DESIGN 4b
// construction rung with no diagnostic anywhere.
//
// ROWS ARE GROUNDED POSITIVELY, ONE DECLARATION AT A TIME. A row may be added only when that exact
// declaration genuinely IS the named Rust type at this target. A row may never be added to make a
// failing site compile: that converts one site's diagnostic into a corpus-wide realization change,
// and does it by editing the table rather than the fact the table reports. The tell is an author
// unable to say what the declaration IS at the target without pointing at the site that failed.
// Absence of a row is a real answer -- render the declared structure -- never a gap to fill.
type RustRealizationBinding {
  decl: DeclarationRef
  target: RustTypeIdentity
}

// ROW GROUNDING, one line per row. DESIGN 4c admits annotations only at module-item grain, so this
// sits above the declaration rather than beside each row.
//
//   std.integer.Int, std.nat.Nat -> i64   the two grounded numeric authorities; they ARE the host
//                                         machine integer at this target.
//   std.float.Float              -> f64
//   std.types.Bool               -> bool
//   std.types.Unit               -> ()    Rust's nullary tuple, not a scalar, so a named type and
//                                         deliberately not a rust_grounding_primitives row.
//   std.string_type.String       -> String
//   std.types.Secret             -> String  its declaration IS `nominal_opaque = String`.
//   std.types.Json               -> serde_json::Value
//   std.types.Bytes              -> Vec<u8>  authored as base-applied-to-argument, which is the
//                                         point of the applied arm: the predecessor carried this
//                                         as the string "Vec<u8>" and therefore could not express
//                                         arity.
//   v2.std.node.Symbol           -> String  declared ONLY in v2; an opaque interned name.
//
// DELIBERATELY ABSENT, and each absence is an answer rather than a gap:
//
//   v2.std.integer.Int, v2.std.nat.Nat -- GroupCompletion and the Peano coproduct Zero|Succ are
//     structures to emit, not machine scalars. Both spellings are "Int"; keying on identity is
//     what lets the two differ.
//   v2.std.node.Hash -- the retired checkpoint row targeted v1_rt::Hash. A census of every
//     `type Hash` declaration in the corpus finds exactly one, v2.std.node.Hash =
//     Fnv1a64Structural, and no declaration legitimately realizes as v1_rt::Hash: every remaining
//     occurrence of that spelling in the seed is inside a STRING LITERAL in v1.runtime_rust, which
//     is generated v1_rt.rs text rather than a .dag type reference. A target row with no legitimate
//     positive source declaration is retired, not rebound, so Hash renders its declared structure
//     and keeps its digest refinement.
data rust_realization_bindings: List<RustRealizationBinding> = [
  { decl: decl_ref(module_path: "std.integer", decl_name: "Int"),
    target: RustPrimitiveType { target_name: "i64" } },
  { decl: decl_ref(module_path: "std.nat", decl_name: "Nat"),
    target: RustPrimitiveType { target_name: "i64" } },
  { decl: decl_ref(module_path: "std.float", decl_name: "Float"),
    target: RustPrimitiveType { target_name: "f64" } },
  { decl: decl_ref(module_path: "std.types", decl_name: "Bool"),
    target: RustPrimitiveType { target_name: "bool" } },
  { decl: decl_ref(module_path: "std.types", decl_name: "Unit"),
    target: RustNamedType { path: "()" } },
  { decl: decl_ref(module_path: "std.string_type", decl_name: "String"),
    target: RustNamedType { path: "String" } },
  { decl: decl_ref(module_path: "std.types", decl_name: "Secret"),
    target: RustNamedType { path: "String" } },
  { decl: decl_ref(module_path: "std.types", decl_name: "Json"),
    target: RustNamedType { path: "serde_json::Value" } },
  { decl: decl_ref(module_path: "std.types", decl_name: "Bytes"),
    target: RustAppliedType { base: "Vec", args: [ RustPrimitiveType { target_name: "u8" } ] } },
  { decl: decl_ref(module_path: "v2.std.node", decl_name: "Symbol"),
    target: RustNamedType { path: "String" } }
]

fn rust_realization_binding_for(decl: DeclarationRef) -> RustRealizationBinding? {
  rust_realization_bindings
    |> filter(b => declaration_ref_eq(a: b.decl, b: decl))
    |> first
}

fn rust_realization_target_for(decl: DeclarationRef) -> RustTypeIdentity? {
  match rust_realization_binding_for(decl: decl) {
    Present { value: b } => Present { value: b.target }
    Absent => none
  }
}

// Every authored row must name a Rust type that actually exists. This is the table's own
// construction check rather than a consumer's: a row whose target is ungrounded would render as
// plausible Rust and fail far from here.
fn rust_realization_rows_are_grounded() -> Bool {
  rust_realization_bindings |> all(b => rust_type_identity_is_grounded(id: b.target))
}
