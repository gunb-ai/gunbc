module gunbc.runner_deploy_emit


data runner_deploy_protocol: std.layout.LayoutProtocol = std.layout.LayoutProtocol { indent_unit: "" }

data manifest_record_knobs: std.languages.SerializationKnobs = {
  assign: "=",
  entry_separator: " ",
  open: "",
  close: "",
  quote_keys: false,
  value_quote: null
}

fn runner_labels_text(spec: extdeps.github.actions.RunnerSpec) -> String {
  match spec {
    extdeps.github.actions.SelfHosted { labels: labels } =>
      fold(labels, init: "", f: (acc, l) => if acc == "" { l } else { concat(concat(acc, ","), l) })
    extdeps.github.actions.HostedRunner { label: _ } => "hosted"
    extdeps.github.actions.RunsOnExpression { expression: e } => e
  }
}

fn manifest_host_fields(h: gunbc.ci_runner_placement.RunnerHostDeployment) -> List<std.languages.SerialField> {
  [
    std.serialize.serial_field(key: "host", value: std.serialize.serial_scalar(text: h.identity)),
    std.serialize.serial_field(key: "runner_count", value: std.serialize.serial_scalar(text: to_string(h.runner_count))),
    std.serialize.serial_field(key: "runner_slice_cap_bytes", value: std.serialize.serial_scalar(text: to_string(std.measure.byte_size_count(b: h.runner_slice_cap)))),
    std.serialize.serial_field(key: "per_slot_memory_max_bytes", value: std.serialize.serial_scalar(text: to_string(std.measure.byte_size_count(b: h.per_runner_memory_cap)))),
    std.serialize.serial_field(key: "build_tokens", value: std.serialize.serial_scalar(text: to_string(std.measure.hardware_thread_count_value(t: h.build_tokens)))),
    std.serialize.serial_field(key: "labels", value: std.serialize.serial_scalar(text: runner_labels_text(spec: h.runner))),
    std.serialize.serial_field(key: "cpu_weight", value: std.serialize.serial_scalar(text: to_string(gunbc.ci_runner_placement.workload_class_cpu_weight(wc: h.workload_class))))
  ]
}

fn manifest_host_doc(h: gunbc.ci_runner_placement.RunnerHostDeployment) -> std.layout.Doc {
  std.serialize.serialize_fields_doc(knobs: manifest_record_knobs, fields: manifest_host_fields(h: h))
}

fn runner_plan_doc() -> std.layout.Doc {
  match gunbc.ci_runner_placement.runner_deployment_plan() {
    gunbc.ci_runner_placement.PlanUnsound { reason: reason } =>
      std.layout.doc_line_of(text: concat("runner-deploy UNSOUND: ", reason))
    gunbc.ci_runner_placement.PlanDerived { hosts: hosts, fleet_concurrent_runs: total } =>
      std.layout.doc_concat(parts: append(
        map(hosts, h => std.layout.doc_concat(parts: [std.layout.doc_text(text: "runner-deploy "), manifest_host_doc(h: h), std.layout.DocLine])),
        items: [std.layout.doc_line_of(text: concat("runner-deploy fleet_concurrent_runs=", to_string(total)))]
      ))
  }
}

fn session_host_fields(h: gunbc.ci_runner_placement.SessionHostReservation) -> List<std.languages.SerialField> {
  [
    std.serialize.serial_field(key: "host", value: std.serialize.serial_scalar(text: h.identity)),
    std.serialize.serial_field(key: "sessions", value: std.serialize.serial_scalar(text: to_string(h.session_count))),
    std.serialize.serial_field(key: "per_session_cap_bytes", value: std.serialize.serial_scalar(text: to_string(std.measure.byte_size_count(b: h.per_session_reservation))))
  ]
}

fn session_host_doc(h: gunbc.ci_runner_placement.SessionHostReservation) -> std.layout.Doc {
  std.serialize.serialize_fields_doc(knobs: manifest_record_knobs, fields: session_host_fields(h: h))
}

fn session_plan_doc() -> std.layout.Doc {
  match gunbc.ci_runner_placement.session_reservation_plan() {
    gunbc.ci_runner_placement.SessionReservationUnsound { reason: reason } =>
      std.layout.doc_line_of(text: concat("session-reservation UNSOUND: ", reason))
    gunbc.ci_runner_placement.SessionReservationDerived {
      hosts: hosts,
      fleet_concurrent_sessions: total,
      per_session_reservation: _,
      coverage_count: covered,
      sample_count: samples
    } =>
      std.layout.doc_concat(parts: append(
        map(hosts, h => std.layout.doc_concat(parts: [std.layout.doc_text(text: "session-reservation "), session_host_doc(h: h), std.layout.DocLine])),
        items: [std.layout.doc_line_of(text: concat(
          concat("session-reservation fleet_concurrent_sessions=", to_string(total)),
          concat(" measured_peak_coverage=", concat(to_string(covered), concat("/", to_string(samples))))
        ))]
      ))
  }
}

fn operating_row_fields(r: gunbc.ci_runner_placement.OperatingPointRow) -> List<std.languages.SerialField> {
  [
    std.serialize.serial_field(key: "per_session_cap_bytes", value: std.serialize.serial_scalar(text: to_string(std.measure.byte_size_count(b: r.per_session_cap)))),
    std.serialize.serial_field(key: "concurrency", value: std.serialize.serial_scalar(text: to_string(r.session_concurrency))),
    std.serialize.serial_field(key: "sessions_slice_bytes", value: std.serialize.serial_scalar(text: to_string(std.measure.byte_size_count(b: r.sessions_slice)))),
    std.serialize.serial_field(key: "peak_coverage", value: std.serialize.serial_scalar(text: concat(concat(to_string(r.coverage_count), "/"), to_string(r.sample_count))))
  ]
}

fn operating_row_doc(r: gunbc.ci_runner_placement.OperatingPointRow) -> std.layout.Doc {
  std.layout.doc_concat(parts: [
    std.layout.doc_text(text: "  "),
    std.serialize.serialize_fields_doc(knobs: manifest_record_knobs, fields: operating_row_fields(r: r)),
    std.layout.DocLine
  ])
}

fn operating_curve_doc() -> std.layout.Doc {
  std.layout.doc_concat(parts: concat(
    [std.layout.doc_line_of(text: "operating-curve (SESSION-side coverage only: operator selects one per-session operating point grounded in measured per-session peaks min 0.28 / median ~2.06 / max 8.27 GiB; sessions_slice = per_session_cap*concurrency. The per-host runner_count is budget-derived from runner_slice_cap and reported on the runner-deploy lines above, independent of this curve):")],
    map(gunbc.ci_runner_placement.operating_curve(), r => operating_row_doc(r: r))
  ))
}

fn session_slice_doc() -> std.layout.Doc {
  match gunbc.ci_floor_measurement.gunbc_ci_session_reservation_mode {
    gunbc.ci_floor_measurement.SessionReservationModeUnset =>
      std.layout.doc_line_of(text: "session-slice UNSOUND: session reservation mode unset")
    gunbc.ci_floor_measurement.Regime1WorstCase { point: _ } =>
      std.layout.doc_line_of(text: "session-slice UNSOUND: REGIME-1 mode has no aggregate reservation; session-slice apply requires REGIME-2")
    gunbc.ci_floor_measurement.Regime2AggregateOomd { oomd_eviction_ceiling: ceiling, session_concurrency: _, aggregate_reservation: agg } =>
      match agg {
        gunbc.ci_floor_measurement.SessionAggregateUnmeasured =>
          std.layout.doc_line_of(text: "session-slice UNSOUND: aggregate_reservation is unmeasured; commit a measured concurrent peak before wiring the apply")
        gunbc.ci_floor_measurement.SessionAggregateMeasured { bytes: agg_bytes } =>
          std.layout.doc_concat(parts: map(gunbc.ci_fleet.fleet_intent_offers, o => std.layout.doc_line_of(text: concat(
            "session-slice ",
            concat(
              concat(
                concat(
                  concat(
                    concat(concat("host=", o.supply.physical.identity), concat(" slice_max_bytes=", to_string(std.measure.byte_size_count(b: agg_bytes)))),
                    concat(" per_session_max_bytes=", to_string(std.measure.byte_size_count(b: ceiling)))
                  ),
                  " oom_pressure_kill=true"
                ),
                concat(" oom_pressure_limit_pct=", to_string(std.measure.percent_count(p: gunbc_oomd_sessions_policy.managed_oom_memory_pressure_limit)))
              ),
              concat(" cpu_weight=", to_string(gunbc.ci_runner_placement.workload_class_cpu_weight(wc: gunbc.ci_runner_placement.InteractiveLatencySensitive)))
            )
          ))))
      }
  }
}

fn project_runner_deploy_to_doc() -> std.layout.Doc {
  std.layout.doc_concat(parts: [
    runner_plan_doc(),
    session_slice_doc(),
    session_plan_doc(),
    operating_curve_doc()
  ])
}

fn expected_runner_deploy_manifest() -> String {
  std.layout.render(doc: project_runner_deploy_to_doc(), proto: runner_deploy_protocol)
}

fn runner_deploy_drifted(committed: String) -> Bool {
  !(committed == expected_runner_deploy_manifest())
}

fn expected_runner_deploy_manifest_json() -> String {
  match gunbc.ci_runner_placement.runner_deployment_plan() {
    gunbc.ci_runner_placement.PlanUnsound { reason: reason } =>
      std.layout.render(doc: std.layout.doc_line_of(text: concat("runner-deploy UNSOUND: ", reason)), proto: runner_deploy_protocol)
    gunbc.ci_runner_placement.PlanDerived { hosts: hosts, fleet_concurrent_runs: _ } =>
      std.layout.render(
        doc: std.layout.doc_concat(parts: map(hosts, h =>
          std.layout.doc_concat(parts: [
            std.layout.doc_text(text: "runner-deploy "),
            std.serialize.serialize_record_doc(knobs: std.languages.json_record_knobs, fields: manifest_host_fields(h: h)),
            std.layout.DocLine
          ])
        )),
        proto: runner_deploy_protocol
      )
  }
}
