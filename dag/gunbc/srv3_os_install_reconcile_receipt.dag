fn bash_var_ref(name: String) -> String {
  concat("$", concat("{", concat(name, "}")))
}

fn srv3_install_record_boot_once_approval_script() -> String {
  let header = concat(
    "set -euo pipefail\nmkdir -p /var/lib/gunbc/logs/approvals\nGRANTED_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)\nEXPIRES_AT=$(date -u -d '+24 hours' +%Y-%m-%dT%H:%M:%SZ)\nprintf '%s\\n' \"Srv3InstallApprovalGrant: escalation_id=",
    srv3_boot_once_cd_escalation.escalation_id as String,
  )
  let intent = concat(
    " intent_hash=",
    srv3_install_effect_attempt_intent.intent_hash as String,
  )
  let grantee = concat(
    " granted_by=operator granted_at=",
    bash_var_ref(name: "GRANTED_AT"),
  )
  let expiry = concat(" expires_at=", bash_var_ref(name: "EXPIRES_AT"))
  let redirect = concat("\" > ", srv3_boot_once_approval_grant_path)
  let trailer = concat(
    "\necho \"Srv3InstallApprovalGrantRecorded: path=",
    concat(srv3_boot_once_approval_grant_path, "\"\n"),
  )
  concat(concat(concat(concat(concat(header, intent), concat(grantee, expiry)), redirect), trailer))
}

fn durable_grant_is_active(grant: DurableApprovalGrant) -> Bool {
  match grant {
    GrantActive { escalation_id: _, intent_hash: _, granted_by: _, granted_at: _, expires_at: _ } => true
    _ => false
  }
}

fn bool_wire(value: Bool) -> String {
  if value {
    "true"
  } else {
    "false"
  }
}
fn effect_step_receipt_for_boot_once(
  observation: Srv3InstallDebugObservation,
  diagnostic: Srv3InstallDiagnostic,
  plan: NextStepPlan,
  read_back_ok: Bool,
  observed_at: Timestamp,
  applied: AppliedEffectRef,
) -> EffectStepReceipt {
  EffectStepReceipt {
    attempt_id: srv3_install_effect_attempt_intent.attempt_id,
    step_id: srv3_boot_once_cd_step_id,
    observation_digest: reconcile_iso_hash_observed(observation: observation) as ContentHash,
    verdict_label: srv3_install_diagnostic_wire(verdict: diagnostic) as NonEmptyStr,
    plan_label: next_step_plan_wire(plan: plan) as NonEmptyStr,
    applied: applied,
    read_back_ok: read_back_ok,
    recorded_at: observed_at,
  }
}

fn os_install_preflight_verdict_wire(verdict: OsInstallPreflightVerdict) -> String {
  match verdict {
    CompleteForUnattended => "CompleteForUnattended"
    NotUnattendedByPolicy => "NotUnattendedByPolicy"
    RequiresStoragePolicy => "RequiresStoragePolicy"
    RequiresDiskObservation => "RequiresDiskObservation"
    IncompleteSeedDelivery => "IncompleteSeedDelivery"
    AutoinstallIncompleteNotBootable => "AutoinstallIncompleteNotBootable"
  }
}

fn os_install_runtime_verdict_wire(verdict: OsInstallRuntimeDiagnosticVerdict) -> String {
  match verdict {
    ReadyToBoot => "ReadyToBoot"
    KvmFirmwareIdleObserved => "KvmFirmwareIdleObserved"
    BootOverrideConsumedNoInstallEvidence => "BootOverrideConsumedNoInstallEvidence"
    InstallerAwaitingStorage => "InstallerAwaitingStorage"
    InstallerRunning => "InstallerRunning"
    InstallerHung => "InstallerHung"
    KvmSuggestsOsBooted => "KvmSuggestsOsBooted"
    OsInstalled => "OsInstalled"
  }
}

fn next_step_plan_wire(plan: NextStepPlan) -> String {
  match plan {
    PlanNoop { step_id: s } => concat("PlanNoop(", concat(s as String, ")"))
    PlanApply { step_id: s } => concat("PlanApply(", concat(s as String, ")"))
    PlanRefuse { step_id: s, reason: r } =>
      concat("PlanRefuse(", concat(s as String, concat(", ", concat(r as String, ")"))))
    PlanAwaitApproval { escalation_id: e } =>
      concat("PlanAwaitApproval(", concat(e as String, ")"))
    PlanDrainThenStart { step_id: s, lease_key: k } =>
      concat("PlanDrainThenStart(", concat(s as String, concat(", ", concat(k as String, ")"))))
  }
}

fn deduction_runtime_hint_wire(hint: DeductionRuntimeHint) -> String {
  match hint {
    DeductionRuntimeAbsent => "absent"
    DeductionRuntimePresent { verdict: v } => os_install_runtime_verdict_wire(verdict: v)
  }
}

fn srv3_install_reconcile_receipt_line(result: Srv3InstallReconcileResult) -> String {
  concat(
    concat(
      concat(
        concat("Srv3InstallReconcileReceipt: preflight=", os_install_preflight_verdict_wire(verdict: result.preflight)),
        concat(" diagnostic=", srv3_install_diagnostic_wire(verdict: result.diagnostic)),
      ),
      concat(" deduction_runtime=", deduction_runtime_hint_wire(hint: result.deduction_runtime)),
    ),
    concat(
      concat(" pending_step=", result.pending_step_id as String),
      concat(" temporal=", next_step_plan_wire(plan: result.temporal_plan)),
    ),
  )
}

fn srv3_install_reconcile_action_line(result: Srv3InstallReconcileResult) -> String {
  concat(
    "Srv3InstallReconcileAction: ",
    srv3_install_diagnostic_recommended_action_wire(verdict: result.diagnostic),
  )
}

fn reconcile_nbd_serve_lease_wire(lease: HeldLease) -> String {
  match lease.observed {
    LeaseAbsent => "NbdServeLeaseAbsent"
    LeaseRunningExpected => "NbdServeLeaseRunningExpected"
    LeaseRunningStale => "NbdServeLeaseStale"
    LeasePortForeign => "NbdServeLeaseForeign"
    LeaseInaccessible => "NbdServeLeaseInaccessible"
  }
}

fn reconcile_serve_process_wire(proc: NbdServeProcessObservation) -> String {
  match proc {
    ServeProcessesPresent => "present"
    NbdkitAbsent => "absent"
    WebsocatAbsent => "websocat_absent"
  }
}

fn reconcile_serve_port_wire(port: NbdServePortObservation) -> String {
  match port {
    ServePortListening { owner_matches_expected: ok, port: p } =>
      if ok {
        concat("expected:", to_string(p))
      } else {
        concat("foreign:", to_string(p))
      }
    ServePortAbsent => "absent"
    ServePortConflict => "conflict"
  }
}

fn reconcile_serve_session_wire(sess: BmcSessionTokenObservation) -> String {
  match sess {
    TokenPresent => "present"
    TokenMissing => "missing"
  }
}

fn reconcile_serve_iso_wire(iso: IsoServeReadinessObservation) -> String {
  match iso {
    IsoPresent { observed_content_hash: h } => h as String
    IsoMissing => "missing"
  }
}

fn reconcile_serve_detail_wire(serve: NbdServeObservation) -> String {
  match serve {
    ServeUnknown => "unknown"
    ServeObserved { process: proc, port: port, session: sess, iso: iso } =>
      concat(
        concat(
          concat(concat("nbdkit=", reconcile_serve_process_wire(proc: proc)), concat(" port=", reconcile_serve_port_wire(port: port))),
          concat(" token=", reconcile_serve_session_wire(sess: sess)),
        ),
        concat(" iso=", reconcile_serve_iso_wire(iso: iso)),
      )
  }
}

fn reconcile_redfish_boot_wire(observation: Srv3InstallDebugObservation) -> String {
  concat(
    concat(
      concat("power=", observation.redfish_boot.power_state as String),
      concat(
        " boot_enabled=",
        observation.redfish_boot.boot_override_enabled as String,
      ),
    ),
    concat(
      concat(" boot_target=", observation.redfish_boot.boot_override_target as String),
      concat(" boot_progress=", observation.redfish_boot.boot_progress as String),
    ),
  )
}

fn reconcile_sol_state_wire(observation: Srv3InstallDebugObservation) -> String {
  match observation.sol {
    Absent => "absent"
    Present { value: sol } =>
      if sol.contains_autoinstall {
        "autoinstall_seen"
      } else {
        if sol.contains_subiquity {
          "subiquity_seen"
        } else {
          if sol.contains_grub {
            "grub_seen"
          } else {
            if sol.contains_firmware_menu {
              "firmware_menu"
            } else {
              if sol.capture_available {
                "silent"
              } else {
                "unavailable"
              }
            }
          }
        }
      }
  }
}

fn reconcile_virtual_media_observation_wire(
  observation: Srv3InstallDebugObservation,
) -> String {
  match observation.actuator_serve {
    ServeUnknown => "Unknown"
    ServeObserved { process: _, port: _, session: _, iso: _ } =>
      match observation.bmc_websocket {
        WebsocketUnavailable => "AttachFailed"
        WebsocketUpgradeAccepted =>
          match observation.virtual_media_session {
            AttachedToExpectedServe => "AttachedExpectedIso"
            NoAttachedServe => "AttachFailed"
            VirtualMediaSessionUnknown => "EndpointAccepted"
          }
        _ => "Unknown"
      }
  }
}

fn reconcile_router_lease_wire(
  observation: Srv3InstallDebugObservation,
  intent: OsInstallAttemptIntent,
) -> String {
  match observation.router_lease_table {
    Absent => "RouterLeaseUnknownOperatorRequired"
    Present { value: table } =>
      match classify_router_lease_table(table: table, fleet_slot: intent.target_host) {
        Srv3OsLeasePresent => "DynamicSrv3LeasePresent"
        OnlyBmcLeasePresent => "OnlyBmcLeasePresent"
        Srv3OsLeaseAbsent => "RouterLeaseAbsent"
        WrongHostnameLeasePresent => "WrongHostnameLeasePresent"
      }
  }
}

fn reconcile_boot_override_consumed_wire(observation: Srv3InstallDebugObservation) -> String {
  match observation.redfish_boot.boot_override_enabled {
    BootOverrideDisabled =>
      match observation.redfish_boot.boot_override_target {
        BootTargetNone => "true"
        _ => "false"
      }
    _ => "false"
  }
}

fn reconcile_kvm_attestation_wire(hint: DeductionRuntimeHint) -> String {
  deduction_runtime_hint_wire(hint: hint)
}

fn reconcile_lease_state_wire(lease: HeldLease) -> String {
  match lease.observed {
    LeaseAbsent => "LeaseAbsent"
    LeaseRunningExpected => "LeaseRunningExpected"
    LeaseRunningStale => "LeaseRunningStale"
    LeasePortForeign => "LeasePortForeign"
    LeaseInaccessible => "LeaseInaccessible"
  }
}

fn reconcile_approval_state_wire(grant: DurableApprovalGrant) -> String {
  match grant {
    GrantAbsent => "GrantAbsent"
    GrantActive { escalation_id: e, intent_hash: _, granted_by: _, granted_at: _, expires_at: _ } =>
      concat("GrantActive(", concat(e as String, ")"))
    GrantConsumed { escalation_id: e, intent_hash: _, consumed_by_step: s } =>
      concat("GrantConsumed(", concat(e as String, concat(",", concat(s as String, ")"))))
  }
}

fn reconcile_prior_step_wire(prior: PriorStepReceipt) -> String {
  match prior {
    NoPriorReceipt => "none"
    PriorReceipt { receipt: r } => r.step_id as String
  }
}

fn reconcile_refusal_reason_wire(plan: NextStepPlan) -> String {
  match plan {
    PlanRefuse { step_id: _, reason: r } => r as String
    _ => ""
  }
}

fn reconcile_iso_hash_observed(observation: Srv3InstallDebugObservation) -> String {
  match observation.actuator_serve {
    ServeObserved { process: _, port: _, session: _, iso: iso } =>
      match iso {
        IsoPresent { observed_content_hash: h } => h as String
        IsoMissing => "missing"
      }
    ServeUnknown => "unknown"
  }
}

fn srv3_install_reconcile_full_receipt(
  result: Srv3InstallReconcileResult,
  intent: OsInstallAttemptIntent,
  observation: Srv3InstallDebugObservation,
  grant: DurableApprovalGrant,
  prior: PriorStepReceipt,
  lease: HeldLease,
  git_branch: NonEmptyStr,
  git_commit: NonEmptyStr,
) -> String {
  let identity = concat(
    concat(
      concat("Srv3InstallReconcileReceipt: attempt_id=", srv3_install_effect_attempt_intent.attempt_id as String),
      concat(" intent_hash=", srv3_install_effect_attempt_intent.intent_hash as String),
    ),
    concat(
      concat(" branch=", git_branch as String),
      concat(" commit=", git_commit as String),
    ),
  )
  let intent_fields = concat(
    concat(" actuator_host=", intent.actuator_host as String),
    concat(" iso_path=", intent.iso_path as String),
  )
  let hash_fields = concat(
    concat(" iso_hash_expected=", intent.iso_content_hash as String),
    concat(" iso_hash_observed=", reconcile_iso_hash_observed(observation: observation)),
  )
  let verdict_fields = concat(
    concat(" preflight_verdict=", os_install_preflight_verdict_wire(verdict: result.preflight)),
    concat(" diagnostic=", srv3_install_diagnostic_wire(verdict: result.diagnostic)),
  )
  let serve_fields = concat(
    concat(" serve_lease_state=", reconcile_nbd_serve_lease_wire(lease: lease)),
    concat(" serve_detail=", reconcile_serve_detail_wire(serve: observation.actuator_serve)),
  )
  let media_fields = concat(
    concat(
      " virtual_media_observation=",
      reconcile_virtual_media_observation_wire(observation: observation),
    ),
    concat(" redfish_boot_state=", reconcile_redfish_boot_wire(observation: observation)),
  )
  let observe_fields = concat(
    concat(" kvm_attestation=", reconcile_kvm_attestation_wire(hint: result.deduction_runtime)),
    concat(" sol_state=", reconcile_sol_state_wire(observation: observation)),
  )
  let router_fields = concat(
    concat(
      " router_lease_state=",
      reconcile_router_lease_wire(observation: observation, intent: intent),
    ),
    concat(
      " boot_override_consumed=",
      reconcile_boot_override_consumed_wire(observation: observation),
    ),
  )
  let temporal_fields = concat(
    concat(" temporal_prior_step=", reconcile_prior_step_wire(prior: prior)),
    concat(" lease_state=", reconcile_lease_state_wire(lease: lease)),
  )
  let approval_fields = concat(
    concat(" approval_state=", reconcile_approval_state_wire(grant: grant)),
    concat(" next_plan=", next_step_plan_wire(plan: result.temporal_plan)),
  )
  let refusal_suffix = match reconcile_refusal_reason_wire(plan: result.temporal_plan) {
    "" => ""
    r => concat(" refusal_reason=", r)
  }
  concat(
    concat(concat(concat(identity, intent_fields), hash_fields), verdict_fields),
    concat(
      concat(concat(concat(serve_fields, media_fields), observe_fields), router_fields),
      concat(concat(temporal_fields, approval_fields), refusal_suffix),
    ),
  )
}

fn srv3_install_reconcile_apply_receipt(
  pre_result: Srv3InstallReconcileResult,
  post_result: Srv3InstallReconcileResult,
  pre_grant: DurableApprovalGrant,
  post_grant: DurableApprovalGrant,
  step_receipt: EffectStepReceipt,
  apply_succeeded: Bool,
  read_back_ok: Bool,
) -> String {
  let identity = concat(
    concat(
      "Srv3InstallReconcileApplyReceipt: attempt_id=",
      srv3_install_effect_attempt_intent.attempt_id as String,
    ),
    concat(
      concat(" boot_attempt_id=", srv3_install_effect_attempt_intent.attempt_id as String),
      concat(" step_id=", srv3_boot_once_cd_step_id as String),
    ),
  )
  let diagnostics = concat(
    concat(" pre_diagnostic=", srv3_install_diagnostic_wire(verdict: pre_result.diagnostic)),
    concat(" post_diagnostic=", srv3_install_diagnostic_wire(verdict: post_result.diagnostic)),
  )
  let plan_flags = concat(
    concat(" pre_plan=", next_step_plan_wire(plan: pre_result.temporal_plan)),
    concat(" apply_succeeded=", bool_wire(value: apply_succeeded)),
  )
  let approval = concat(
    concat(" read_back_ok=", bool_wire(value: read_back_ok)),
    concat(
      concat(" approval_state=", reconcile_approval_state_wire(grant: post_grant)),
      concat(" pre_approval_state=", reconcile_approval_state_wire(grant: pre_grant)),
    ),
  )
  let step = concat(
    concat(" step_read_back_ok=", bool_wire(value: step_receipt.read_back_ok)),
    concat(
      " step_applied=",
      match step_receipt.applied {
        EffectApplied { effect_id: e } => e as String
        NoEffectApplied => "none"
      },
    ),
  )
  let tail = concat(
    concat(" post_plan=", next_step_plan_wire(plan: post_result.temporal_plan)),
    concat(" recorded_at=", step_receipt.recorded_at),
  )
  concat(concat(concat(concat(identity, diagnostics), concat(plan_flags, approval)), concat(step, tail)))
}
