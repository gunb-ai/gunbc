fn instrument_tuner_apply_camera_fn_body() -> List<extdeps.languages.typescript.program.TsStmt> {
  [
    ts_const(name: "key", value: js_instrument_wire_expr()),
    instrument_tuner_reading_visibility_stmt(),
    instrument_tuner_depth_btn_apply_stmt(),
    instrument_tuner_mode_btn_apply_stmt(),
    instrument_tuner_subject_btn_apply_stmt(),
  ]
}

fn instrument_tuner_persist_and_apply_stmts() -> List<extdeps.languages.typescript.program.TsStmt> {
  [
    ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_instrument_save_fn), args: [])),
    ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_instrument_apply_fn), args: [])),
  ]
}

fn instrument_tuner_step_depth_fn_body() -> List<extdeps.languages.typescript.program.TsStmt> {
  concat(
    [
      ts_const(name: "prevDepth", value: js_instrument_camera_member(name: "depth")),
      ts_const(name: "i", value: ts_call(
        callee: ts_member(object: ts_ident(name: "INSTRUMENT_DEPTH_KEYS"), property: "indexOf"),
        args: [js_instrument_camera_member(name: "depth")],
      )),
      ts_if(cond: ts_binop(left: ts_ident(name: "i"), op: "<", right: ts_lit_num(text: "0")), then: ts_return(expr: none), else_stmt: none),
      ts_if(
        cond: ts_binop(
          left: ts_binop(left: ts_ident(name: "dir"), op: "===", right: ts_lit_str(value: "in")),
          op: "&&",
          right: ts_binop(
            left: ts_ident(name: "i"),
            op: "<",
            right: ts_binop(
              left: ts_member(object: ts_ident(name: "INSTRUMENT_DEPTH_KEYS"), property: "length"),
              op: "-",
              right: ts_lit_num(text: "1"),
            ),
          ),
        ),
        then: ts_expr_stmt(expr: ts_binop(
          left: js_instrument_camera_member(name: "depth"),
          op: "=",
          right: ts_index(
            object: ts_ident(name: "INSTRUMENT_DEPTH_KEYS"),
            index: ts_binop(left: ts_ident(name: "i"), op: "+", right: ts_lit_num(text: "1")),
          ),
        )),
        else_stmt: none,
      ),
      ts_if(
        cond: ts_binop(
          left: ts_binop(left: ts_ident(name: "dir"), op: "===", right: ts_lit_str(value: "out")),
          op: "&&",
          right: ts_binop(left: ts_ident(name: "i"), op: ">", right: ts_lit_num(text: "0")),
        ),
        then: ts_expr_stmt(expr: ts_binop(
          left: js_instrument_camera_member(name: "depth"),
          op: "=",
          right: ts_index(
            object: ts_ident(name: "INSTRUMENT_DEPTH_KEYS"),
            index: ts_binop(left: ts_ident(name: "i"), op: "-", right: ts_lit_num(text: "1")),
          ),
        )),
        else_stmt: none,
      ),
      ts_if(
        cond: ts_binop(left: js_instrument_camera_member(name: "depth"), op: "!==", right: ts_ident(name: "prevDepth")),
        then: ts_block(stmts: concat(
          instrument_tuner_persist_and_apply_stmts(),
          [ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_tick_fn), args: []))],
        )),
        else_stmt: none,
      ),
    ],
    [],
  )
}

fn instrument_tuner_seek_depth_fn_body() -> List<extdeps.languages.typescript.program.TsStmt> {
  [
    ts_const(name: "targetIdx", value: ts_call(
      callee: ts_member(object: ts_ident(name: "INSTRUMENT_DEPTH_KEYS"), property: "indexOf"),
      args: [ts_ident(name: "target")],
    )),
    ts_const(name: "currentIdx", value: ts_call(
      callee: ts_member(object: ts_ident(name: "INSTRUMENT_DEPTH_KEYS"), property: "indexOf"),
      args: [js_instrument_camera_member(name: "depth")],
    )),
    ts_if(
      cond: ts_binop(
        left: ts_binop(
          left: ts_binop(left: ts_ident(name: "targetIdx"), op: "<", right: ts_lit_num(text: "0")),
          op: "||",
          right: ts_binop(left: ts_ident(name: "currentIdx"), op: "<", right: ts_lit_num(text: "0")),
        ),
        op: "||",
        right: ts_binop(left: ts_ident(name: "targetIdx"), op: "===", right: ts_ident(name: "currentIdx")),
      ),
      then: ts_return(expr: none),
      else_stmt: none,
    ),
    ts_expr_stmt(expr: ts_call(
      callee: ts_ident(name: js_instrument_step_depth_fn),
      args: [
        ts_cond(
          test: ts_binop(left: ts_ident(name: "targetIdx"), op: ">", right: ts_ident(name: "currentIdx")),
          consequent: ts_lit_str(value: "in"),
          alternate: ts_lit_str(value: "out"),
        ),
      ],
    )),
    ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_instrument_seek_depth_fn), args: [ts_ident(name: "target")])),
  ]
}

fn instrument_tuner_select_subject_fn_body() -> List<extdeps.languages.typescript.program.TsStmt> {
  concat(
    [
      ts_if(
        cond: ts_binop(left: js_instrument_camera_member(name: "focus"), op: "===", right: ts_ident(name: "key")),
        then: ts_return(expr: none),
        else_stmt: none,
      ),
      ts_expr_stmt(expr: ts_binop(left: js_instrument_camera_member(name: "focus"), op: "=", right: ts_ident(name: "key"))),
    ],
    instrument_tuner_persist_and_apply_stmts(),
  )
}

fn instrument_tuner_toggle_subject_key_stmts() -> List<extdeps.languages.typescript.program.TsStmt> {
  [
    ts_const(name: "was", value: ts_binop(
      left: js_instrument_camera_member(name: "focus"),
      op: "===",
      right: ts_ident(name: "key"),
    )),
    ts_if(
      cond: ts_ident(name: "was"),
      then: ts_block(stmts: concat(
        [ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_instrument_clear_subject_fn), args: []))],
        [ts_return(expr: none)],
      )),
      else_stmt: none,
    ),
    ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_instrument_select_subject_fn), args: [ts_ident(name: "key")])),
  ]
}

