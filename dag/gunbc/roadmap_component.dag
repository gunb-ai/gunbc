data attempts_row_note: String = "U3 (result surfacing v0): each attempt branch renders into its node's disclosure as a mono line — the branch NAME, copyable and true (a tree link would be dead until a push; a dead link is a fabricated result — the PR half lands when push/PR state is observed, not guessed). The one-shot refresh clears the prior rendered projection before rebuilding it, so the immediate post-dispatch read cannot duplicate old branches. Refusal upserts its own source-labeled loud banner; recovery clears it."

fn attempts_mark_stmts() -> List<TsStmt> {
  [
    ts_const(name: "ar", value: ts_call(
      callee: ts_member(object: ts_ident(name: "document"), property: "querySelector"),
      args: [workflow_row_selector_expr(
        node_id: ts_member(object: ts_ident(name: "att"), property: "node_id"))])),
    workflow_set_observation_call(
      lamp_expr: workflow_lamp_in_row_expr(row_name: "ar", lamp: AttemptedWorkflowLamp),
      state: ClientObservationOn,
      reason_expr: ts_lit_str(value: "")),
    ts_const(name: "adt", value: ts_binop(
      left: ts_ident(name: "ar"),
      op: "&&",
      right: ts_call(callee: ts_member(object: ts_ident(name: "ar"), property: "querySelector"), args: [ts_lit_str(value: "details.item-detail")]))),
    ts_if(
      cond: ts_ident(name: "adt"),
      then: ts_block(stmts: [
        ts_let(name: "al", value: ts_call(callee: ts_member(object: ts_ident(name: "adt"), property: "querySelector"), args: [ts_lit_str(value: ".dispatch-attempts")])),
        ts_if(
          cond: ts_prefix(op: "!", expr: ts_ident(name: "al")),
          then: ts_block(stmts: [
            ts_expr_stmt(expr: ts_binop(left: ts_ident(name: "al"), op: "=", right: ts_call(callee: ts_member(object: ts_ident(name: "document"), property: "createElement"), args: [ts_lit_str(value: "div")]))),
            ts_expr_stmt(expr: ts_binop(left: ts_member(object: ts_ident(name: "al"), property: "className"), op: "=", right: ts_lit_str(value: "dispatch-attempts"))),
            ts_expr_stmt(expr: ts_binop(left: ts_member(object: ts_ident(name: "al"), property: "textContent"), op: "=", right: ts_lit_str(value: "attempts: "))),
            ts_expr_stmt(expr: ts_call(callee: ts_member(object: ts_ident(name: "adt"), property: "append"), args: [ts_ident(name: "al")])),
          ]),
          else_stmt: none,
        ),
        ts_expr_stmt(expr: ts_binop(
          left: ts_member(object: ts_ident(name: "al"), property: "textContent"),
          op: "=",
          right: ts_binop(
            left: ts_binop(left: ts_member(object: ts_ident(name: "al"), property: "textContent"), op: "+", right: ts_member(object: ts_ident(name: "att"), property: "branch")),
            op: "+",
            right: ts_lit_str(value: " ")))),
      ]),
      else_stmt: none,
    ),
  ]
}

