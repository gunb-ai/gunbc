        ts_expr_stmt(expr: ts_call(
          callee: ts_member(object: ts_ident(name: "cb"), property: "remove"),
          args: [])),
      ]),
      else_stmt: none),
  ])
}

fn sessions_fetch_request_statements() -> List<TsStmt> {
  [
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(
        object: ts_call(
          callee: ts_member(
            object: ts_call(
              callee: ts_member(
                object: ts_call(callee: ts_ident(name: "fetch"), args: [ts_lit_str(value: sessions_route_path)]),
                property: "then"),
              args: [ts_arrow(params: ["r"], body: ts_block(stmts: [ts_return(expr: ts_call(callee: ts_member(object: ts_ident(name: "r"), property: "json"), args: []))]))]),
            property: "then"),
          args: [ts_arrow(params: ["sj"], body: ts_block(stmts: [
            ts_if(
              cond: ts_member(object: ts_ident(name: "sj"), property: "observe_refused"),
              then: ts_block(stmts: concat(
                [
                  ts_const(name: "wireWhy", value: ts_binop(
                    left: ts_member(object: ts_ident(name: "sj"), property: "reason"),
                    op: "||",
                    right: ts_lit_str(value: "no reason on the wire"))),
                  ts_const(name: "why", value: ts_binop(
                    left: ts_lit_str(value: "session observation refused: "),
                    op: "+",
                    right: ts_ident(name: "wireWhy"))),
                ],
                concat(
                  [workflow_set_all_observations_stmt(
                    lamp: LiveWorkflowLamp,
                    state: ClientObservationRefused { reason: "" },
                    reason_expr: ts_ident(name: "why"))],
                  observation_refused_banner_stmts(source: "session")))),
              else_stmt: Present { value: ts_block(stmts: concat(
                [
                  observation_clear_refused_banner_stmt(source: "session"),
                  workflow_set_all_observations_stmt(
                    lamp: LiveWorkflowLamp,
                    state: ClientObservationOff,
                    reason_expr: ts_lit_str(value: "")),
                  ts_expr_stmt(expr: ts_call(
                    callee: ts_member(object: ts_member(object: ts_ident(name: "sj"), property: "sessions"), property: "forEach"),
                    args: [ts_arrow(params: ["sess"], body: ts_block(stmts: sessions_mark_live_stmts()))])),
                ],
                sessions_reconcile_absent_stmts())) },
            ),
          ]))]),
        property: "catch"),
      args: [ts_arrow(params: ["e"], body: ts_block(stmts: concat(
        [ts_const(name: "why", value: ts_binop(left: ts_lit_str(value: "session observation refused: "), op: "+", right: ts_binop(left: ts_ident(name: "e"), op: "+", right: ts_lit_str(value: ""))))],
        concat(
          [workflow_set_all_observations_stmt(
            lamp: LiveWorkflowLamp,
            state: ClientObservationRefused { reason: "" },
            reason_expr: ts_ident(name: "why"))],
          observation_refused_banner_stmts(source: "session")))))])),
  ]
}

