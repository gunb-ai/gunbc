fn instrument_tuner_camera_preamble() -> List<extdeps.languages.typescript.program.TsStmt> {
  concat(
    [
      ts_const(name: js_instrument_camera_var, value: ts_object(fields: [
        ts_field(key: "depth", value: ts_lit_str(value: program_depth_key(d: camera_initial.depth))),
        ts_field(key: "mode", value: ts_lit_str(value: program_mode_key(m: camera_initial.mode))),
        ts_field(key: "focus", value: ts_lit_str(value: focus_subject_key(f: camera_initial.focus))),
      ])),
      ts_const(name: "INSTRUMENT_WIRE_DEPTH_KEYS", value: ts_array(elements: map(instrument_depth_keys(), k => ts_lit_str(value: k)))),
      ts_const(name: "INSTRUMENT_DEPTH_KEYS", value: ts_array(elements: map(instrument_user_depth_keys(), k => ts_lit_str(value: k)))),
    ts_const(name: "INSTRUMENT_MODE_KEYS", value: ts_array(elements: map(instrument_mode_keys(), k => ts_lit_str(value: k)))),
    ts_const(name: "INSTRUMENT_FOCUS_KEYS", value: ts_array(elements: map(instrument_focus_keys(), k => ts_lit_str(value: k)))),
    ts_const(name: js_instrument_save_fn, value: ts_arrow(params: [], body: ts_expr_stmt(expr: ts_call(
      callee: ts_member(object: ts_ident(name: "localStorage"), property: "setItem"),
      args: [ts_lit_str(value: camera_storage_key), js_instrument_wire_expr()],
    )))),
    ts_const(name: js_instrument_load_fn, value: ts_arrow(params: [], body: ts_block(stmts: instrument_tuner_load_camera_fn_body()))),
    ts_const(name: js_instrument_apply_fn, value: ts_arrow(params: [], body: ts_block(stmts: instrument_tuner_apply_camera_fn_body()))),
    ts_const(name: js_instrument_step_depth_fn, value: ts_arrow(params: ["dir"], body: ts_block(stmts: instrument_tuner_step_depth_fn_body()))),
    ts_const(name: js_instrument_seek_depth_fn, value: ts_arrow(params: ["target"], body: ts_block(stmts: instrument_tuner_seek_depth_fn_body()))),
    ts_const(name: js_instrument_set_mode_fn, value: ts_arrow(params: ["m"], body: ts_block(stmts: concat(
      [ts_expr_stmt(expr: ts_binop(left: js_instrument_camera_member(name: "mode"), op: "=", right: ts_ident(name: "m")))],
      instrument_tuner_persist_and_apply_stmts(),
    )))),
    ts_const(name: js_instrument_clear_subject_fn, value: ts_arrow(params: [], body: ts_block(stmts: concat(
      [ts_expr_stmt(expr: ts_binop(
        left: js_instrument_camera_member(name: "focus"),
        op: "=",
        right: ts_lit_str(value: focus_subject_key(f: NoSubjectSelected)),
      ))],
      instrument_tuner_persist_and_apply_stmts(),
    )))),
    ts_const(name: js_instrument_select_subject_fn, value: ts_arrow(params: ["key"], body: ts_block(stmts: instrument_tuner_select_subject_fn_body()))),
    ],
    instrument_tuner_wheel_preamble(),
  )
}

