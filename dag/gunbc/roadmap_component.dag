fn instrument_tuner_wheel_preamble() -> List<extdeps.languages.typescript.program.TsStmt> {
  [
    ts_const(name: js_instrument_wheel_threshold_const, value: ts_lit_num(text: to_string(wheel_detent_threshold_px))),
    ts_let(name: js_instrument_wheel_travel_var, value: ts_lit_num(text: "0")),
    ts_let(name: js_instrument_wheel_timer_var, value: ts_ident(name: "null")),
    ts_const(name: js_instrument_normalize_wheel_fn, value: ts_arrow(params: ["e"], body: ts_block(stmts: [
      ts_const(name: "mode", value: ts_binop(left: ts_member(object: ts_ident(name: "e"), property: "deltaMode"), op: "||", right: ts_lit_num(text: "0"))),
      ts_const(name: "raw", value: ts_member(object: ts_ident(name: "e"), property: "deltaY")),
      ts_if(
        cond: ts_binop(left: ts_ident(name: "mode"), op: "===", right: ts_lit_num(text: "1")),
        then: ts_return(expr: ts_binop(left: ts_ident(name: "raw"), op: "*", right: ts_lit_num(text: "16"))),
        else_stmt: none,
      ),
      ts_if(
        cond: ts_binop(left: ts_ident(name: "mode"), op: "===", right: ts_lit_num(text: "2")),
        then: ts_return(expr: ts_binop(
          left: ts_ident(name: "raw"),
          op: "*",
          right: ts_binop(left: ts_member(object: ts_ident(name: "window"), property: "innerHeight"), op: "||", right: ts_lit_num(text: "800")),
        )),
        else_stmt: none,
      ),
      ts_return(expr: ts_ident(name: "raw")),
    ]))),
    ts_const(name: js_instrument_consume_wheel_fn, value: ts_arrow(params: [], body: ts_block(stmts: [
      ts_if(
        cond: ts_binop(
          left: ts_call(callee: ts_ident(name: "Math.abs"), args: [ts_ident(name: js_instrument_wheel_travel_var)]),
          op: "<",
          right: ts_ident(name: js_instrument_wheel_threshold_const),
        ),
        then: ts_return(expr: none),
        else_stmt: none,
      ),
      ts_const(name: "before", value: js_instrument_camera_member(name: "depth")),
      ts_expr_stmt(expr: ts_call(
        callee: ts_ident(name: js_instrument_step_depth_fn),
