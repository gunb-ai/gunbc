      ts_if(
        cond: ts_binop(
          left: ts_binop(left: ts_ident(name: "delta"), op: ">", right: ts_lit_num(text: "0")),
          op: "&&",
          right: ts_ident(name: "atMax"),
        ),
        then: ts_return(expr: none),
        else_stmt: none,
