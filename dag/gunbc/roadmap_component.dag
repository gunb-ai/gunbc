fn observation_fetch_statements() -> List<extdeps.languages.typescript.program.TsStmt> {
  [
    ts_let(name: js_sessions_observe_in_flight, value: ts_ident(name: "false")),
    ts_let(name: js_attempts_observe_in_flight, value: ts_ident(name: "false")),
    ts_let(name: js_sessions_observe_pending, value: ts_ident(name: "false")),
    ts_let(name: js_attempts_observe_pending, value: ts_ident(name: "false")),
    ts_const(
      name: js_sessions_observe_fn,
      value: ts_arrow(params: [], body: ts_block(stmts: concat(
        observation_begin_stmts(
          in_flight: js_sessions_observe_in_flight,
          pending: js_sessions_observe_pending),
        sessions_fetch_effect_statements())))),
    ts_const(
      name: js_attempts_observe_fn,
      value: ts_arrow(params: [], body: ts_block(stmts: concat(
        observation_begin_stmts(
          in_flight: js_attempts_observe_in_flight,
          pending: js_attempts_observe_pending),
        attempts_fetch_effect_statements())))),
    ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_sessions_observe_fn), args: [])),
    ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_attempts_observe_fn), args: [])),
    ts_const(
      name: js_observation_poll_tick,
      value: ts_arrow(params: [], body: ts_block(stmts: [
          ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_sessions_observe_fn), args: [])),
          ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_attempts_observe_fn), args: [])),
          ts_expr_stmt(expr: ts_call(
            callee: ts_ident(name: "setTimeout"),
            args: [
              ts_ident(name: js_observation_poll_tick),
              ts_lit_num(text: to_string(millisecond_count(m: observation_poll_interval))),
            ])),
        ]))),
    ts_expr_stmt(expr: ts_call(
      callee: ts_ident(name: "setTimeout"),
      args: [
        ts_ident(name: js_observation_poll_tick),
        ts_lit_num(text: to_string(millisecond_count(m: observation_poll_interval))),
      ])),
  ]
}

data workflow_paint_no_policy_note: String = "Every branch below selects WHERE a decided string lands, never WHAT it says: arm/attention keys route material and expansion, summary/outcome/reason strings land verbatim, the ledger renders the wire's canonical segment rows in wire order, and counts are never recomputed client-side. The stale sweep realizes attempt disappearance as DOM removal (attention rule: absence earns no area) while keep-and-update preserves the operator's open disclosure between polls."

