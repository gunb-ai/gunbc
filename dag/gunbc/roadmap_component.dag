}

data workflow_observation_poll_interval: std.measure.Millisecond = millisecond(count: 2000)

fn workflow_schedule_refresh_stmt() -> extdeps.languages.typescript.program.TsStmt {
  ts_expr_stmt(expr: ts_call(
    callee: ts_ident(name: "setTimeout"),
    args: [
      ts_ident(name: js_poll_workflow_fn),
      ts_lit_num(text: to_string(
        millisecond_count(m: workflow_observation_poll_interval))),
    ],
  ))
}

data workflow_poll_single_flight_note: String = "gunbcPollWorkflow waits for gunbcRefreshWorkflow's returned fetch promise to settle and schedules the next read in finally. The former fire-then-setTimeout shape overlapped every two seconds whenever /workflow.json exceeded its cadence; one real oversized Codex event made the interpreted handler slow enough to fill the socket backlog. Settlement-driven polling preserves cadence after completion and admits at most one workflow observation per browser."

fn workflow_fetch_statements() -> List<extdeps.languages.typescript.program.TsStmt> {
  [
    ts_const(
      name: js_refresh_workflow_fn,
      value: ts_arrow(
        params: [],
        body: ts_block(stmts: workflow_fetch_request_statements()),
      ),
    ),
    ts_const(
      name: js_poll_workflow_fn,
      value: ts_arrow(params: [], body: ts_block(stmts: [
        ts_expr_stmt(expr: ts_call(
          callee: ts_member(
            object: ts_call(
              callee: ts_ident(name: js_refresh_workflow_fn),
              args: [],
            ),
            property: "finally",
          ),
          args: [
            ts_arrow(
              params: [],
              body: ts_block(stmts: [workflow_schedule_refresh_stmt()]),
            ),
          ],
        )),
      ])),
    ),
    ts_expr_stmt(expr: ts_call(
      callee: ts_ident(name: js_poll_workflow_fn),
      args: [],
    )),
  ]
}

data row_selection_note: String = "SELECTION IS CLIENT STATE; PROMINENCE IS ITS PROJECTION (A2 hierarchy closeout, operator gap ruling 2026-08-02: only the selected subject normally exposes the primary operation prominently). Selecting a row — by clicking its non-interactive surface, by keyboard focus reaching it (focus-visible only, so pointer clicks on inner controls never move selection through the focus channel), or by Enter/Space on the focused row — selects exactly one row at a time; re-selecting the selected row, or pressing Escape, clears; activating any control, link, or disclosure TOGGLE acts WITHOUT changing selection, keeping selection and activation distinct operations (the exclusion names summary — the disclosure's interactive part — NOT details: every row lives inside the section fold's details element, so excluding details ancestors made pointer selection unreachable corpus-wide, a defect this note's first revision shipped and the S0 interaction capture exposed by execution). Every input path funnels through ONE gunbcSelectRow, so keyboard and pointer cannot drift apart. Selection grants action-focal to the row's own primary action only (the class named for what it means — selection-granted focal prominence, never liveness; see action_prominence_rules_note) — the first .node-head under the row li is its own head in document order, so a nested child row's control can never inherit the parent's grant — and the clear pass strips every node-selected and action-focal in one sweep, so two focal controls cannot coexist. No selection state is persisted: prominence is a session-local reading aid, not a fact about the work. DECLARED FOLLOW-UP (S0 handback, operator recalibration 2026-08-02): in the instrument composition, secondary override controls LEAVE the resting row entirely — they move into the contextual inspector/disclosure and the resting row keeps at most a small affordance; this production page keeps them in-row until that composition lands."

data row_selected_class: String = "node-selected"
data action_focal_class: String = "action-focal"

fn row_selection_bind_statements() -> List<extdeps.languages.typescript.program.TsStmt> {
  [
    ts_const(name: "gunbcClearSelection", value: ts_arrow(params: [], body: ts_expr_stmt(expr: ts_call(
      callee: ts_member(
        object: ts_call(
          callee: ts_member(object: ts_ident(name: "document"), property: "querySelectorAll"),
          args: [ts_lit_str(value: join([".", row_selected_class, ", .", action_focal_class], ""))],
