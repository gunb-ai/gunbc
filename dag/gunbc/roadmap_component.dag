fn instrument_tuner_keydown_bind_stmt() -> extdeps.languages.typescript.program.TsStmt {
  ts_expr_stmt(expr: ts_call(
    callee: ts_member(object: ts_ident(name: "document"), property: "addEventListener"),
    args: [
      ts_lit_str(value: "keydown"),
      ts_arrow(params: ["e"], body: ts_block(stmts: [
        ts_if(
          cond: ts_binop(left: ts_member(object: ts_ident(name: "e"), property: "key"), op: "===", right: ts_lit_str(value: "Escape")),
          then: ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_instrument_clear_subject_fn), args: [])),
          else_stmt: none,
        ),
        ts_if(
          cond: ts_binop(left: ts_member(object: ts_ident(name: "e"), property: "key"), op: "===", right: ts_lit_str(value: "ArrowDown")),
          then: ts_block(stmts: [
            ts_expr_stmt(expr: ts_call(callee: ts_member(object: ts_ident(name: "e"), property: "preventDefault"), args: [])),
            ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_instrument_step_depth_fn), args: [ts_lit_str(value: "in")])),
          ]),
          else_stmt: none,
        ),
        ts_if(
          cond: ts_binop(left: ts_member(object: ts_ident(name: "e"), property: "key"), op: "===", right: ts_lit_str(value: "ArrowUp")),
          then: ts_block(stmts: [
            ts_expr_stmt(expr: ts_call(callee: ts_member(object: ts_ident(name: "e"), property: "preventDefault"), args: [])),
            ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_instrument_step_depth_fn), args: [ts_lit_str(value: "out")])),
          ]),
          else_stmt: none,
        ),
        ts_if(
          cond: ts_binop(
            left: ts_binop(
              left: ts_member(object: ts_ident(name: "e"), property: "key"),
              op: "!==",
              right: ts_lit_str(value: "Enter"),
            ),
            op: "&&",
            right: ts_binop(
              left: ts_member(object: ts_ident(name: "e"), property: "key"),
              op: "!==",
              right: ts_lit_str(value: " "),
            ),
          ),
          then: ts_return(expr: none),
          else_stmt: none,
        ),
        ts_const(name: "t", value: ts_member(object: ts_ident(name: "e"), property: "target")),
        ts_if(
          cond: ts_binop(
            left: ts_prefix(op: "!", expr: ts_ident(name: "t")),
            op: "||",
            right: ts_prefix(op: "!", expr: ts_member(object: ts_ident(name: "t"), property: "matches")),
          ),
          then: ts_return(expr: none),
          else_stmt: none,
        ),
        ts_if(
          cond: ts_prefix(op: "!", expr: ts_call(
            callee: ts_member(object: ts_ident(name: "t"), property: "matches"),
            args: [ts_lit_str(value: join(["li.", instrument_subject_class], ""))],
          )),
          then: ts_return(expr: none),
          else_stmt: none,
        ),
        ts_expr_stmt(expr: ts_call(callee: ts_member(object: ts_ident(name: "e"), property: "preventDefault"), args: [])),
        ts_const(name: "key", value: ts_call(
          callee: ts_member(object: ts_ident(name: "t"), property: "getAttribute"),
          args: [ts_lit_str(value: "data-subject-key")],
        )),
        ts_if(
          cond: ts_binop(left: js_instrument_camera_member(name: "focus"), op: "===", right: ts_ident(name: "key")),
          then: ts_block(stmts: concat(
            [ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_instrument_clear_subject_fn), args: []))],
            [ts_return(expr: none)],
          )),
          else_stmt: none,
        ),
        ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_instrument_select_subject_fn), args: [ts_ident(name: "key")])),
      ])),
    ],
  ))
}

