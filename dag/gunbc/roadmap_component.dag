}

data sessions_panel_note: String = "U2 plus workflow lamps v0, corrected for lifecycle truth: one named observer per endpoint runs at load, immediately after an accepted dispatch, and on the modeled poll cadence while the page is open. Each observation recomputes its own axis; neither endpoint can suppress the other. /sessions.json proves tmux/process presence only, so it renders `session · present` plus the provider/readiness evidence carried by the wire, never `live` as agent execution. Refusal resolves every Live lamp to Refused and inserts a source-specific loud banner — unknowable never rounds to Off."

data js_sessions_observe_fn: String = "gunbcObserveSessions"
data js_attempts_observe_fn: String = "gunbcObserveAttempts"
data js_sessions_observe_in_flight: String = "gunbcSessionsObservationInFlight"
data js_attempts_observe_in_flight: String = "gunbcAttemptsObservationInFlight"
data js_sessions_observe_pending: String = "gunbcSessionsObservationPending"
data js_attempts_observe_pending: String = "gunbcAttemptsObservationPending"
data js_observation_poll_tick: String = "gunbcObservationPollTick"
data observation_poll_interval: std.measure.Millisecond = millisecond(count: 3000)
data observation_poll_note: String = "The page has no typed terminal-attempt observation yet, so it cannot honestly decide that an attempt is terminal and stop polling. It therefore re-observes both independent sources for the page lifetime at one explicit cadence; a recursive one-shot timeout schedules the next observation without introducing the dashboard's forbidden animation/interval loop, and page unload cancels the browser timer. Each source permits one request in flight and coalesces overlapping timer or post-dispatch observations into one pending rerun, so an older response cannot repaint over a newer one. This dissolves into terminal-bounded polling when AttemptEvidence.terminal_outcome gains a live producer."

fn observation_complete_stmts(
  observer: String,
  in_flight: String,
  pending: String,
) -> List<extdeps.languages.typescript.program.TsStmt> {
  [
    ts_expr_stmt(expr: ts_binop(
      left: ts_ident(name: in_flight),
      op: "=",
      right: ts_ident(name: "false"))),
    ts_if(
      cond: ts_ident(name: pending),
      then: ts_block(stmts: [
        ts_expr_stmt(expr: ts_binop(
          left: ts_ident(name: pending),
          op: "=",
          right: ts_ident(name: "false"))),
        ts_expr_stmt(expr: ts_call(callee: ts_ident(name: observer), args: [])),
      ]),
      else_stmt: none),
  ]
}

fn observation_begin_stmts(in_flight: String, pending: String) -> List<extdeps.languages.typescript.program.TsStmt> {
  [
    ts_if(
      cond: ts_ident(name: in_flight),
      then: ts_block(stmts: [
        ts_expr_stmt(expr: ts_binop(
          left: ts_ident(name: pending),
          op: "=",
          right: ts_ident(name: "true"))),
        ts_return(expr: none),
