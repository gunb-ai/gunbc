fn instrument_tuner_subject_click_handler_body() -> List<extdeps.languages.typescript.program.TsStmt> {
  concat(
    [
      ts_const(name: "t", value: ts_member(object: ts_ident(name: "e"), property: "target")),
      ts_if(
        cond: ts_binop(
          left: ts_prefix(op: "!", expr: ts_ident(name: "t")),
          op: "||",
          right: ts_prefix(op: "!", expr: ts_member(object: ts_ident(name: "t"), property: "closest")),
        ),
        then: ts_return(expr: none),
        else_stmt: none,
      ),
      ts_if(
        cond: ts_call(
          callee: ts_member(object: ts_ident(name: "t"), property: "closest"),
          args: [ts_lit_str(value: "button, a, input, select, textarea")],
        ),
        then: ts_return(expr: none),
        else_stmt: none,
      ),
      ts_const(name: "li", value: ts_call(
        callee: ts_member(object: ts_ident(name: "t"), property: "closest"),
        args: [ts_lit_str(value: join(["li.", instrument_subject_class], ""))],
      )),
      ts_if(cond: ts_prefix(op: "!", expr: ts_ident(name: "li")), then: ts_return(expr: none), else_stmt: none),
      ts_const(name: "key", value: ts_call(
        callee: ts_member(object: ts_ident(name: "li"), property: "getAttribute"),
        args: [ts_lit_str(value: "data-subject-key")],
      )),
    ],
    instrument_tuner_toggle_subject_key_stmts(),
  )
}

fn instrument_tuner_subject_focus_handler_body() -> List<extdeps.languages.typescript.program.TsStmt> {
  [
    ts_const(name: "t", value: ts_member(object: ts_ident(name: "e"), property: "target")),
    ts_if(
      cond: ts_binop(
        left: ts_prefix(op: "!", expr: ts_ident(name: "t")),
