            ),
            property: "then",
          ),
          args: [ts_arrow(params: ["j"], body: dispatch_response_handler_body())],
        ),
        property: "catch",
      ),
      args: [ts_arrow(params: ["e"], body: ts_block(stmts: [
        ts_const(name: "applyErr", value: ts_arrow(params: [], body: ts_block(stmts: [
          ts_expr_stmt(expr: ts_binop(left: js_b_member(name: "textContent"), op: "=", right: ts_lit_str(value: dispatch_caption_loud))),
          js_classlist_call(method: "remove", arg: ts_lit_str(value: dispatch_class_requested)),
          js_classlist_call(method: "add", arg: ts_lit_str(value: dispatch_class_refused)),
