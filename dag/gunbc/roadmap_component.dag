fn instrument_tuner_subject_btn_apply_stmt() -> extdeps.languages.typescript.program.TsStmt {
  ts_expr_stmt(expr: ts_call(
    callee: ts_member(object: js_instrument_query_all(class_name: instrument_subject_class), property: "forEach"),
    args: [ts_arrow(params: ["li"], body: ts_block(stmts: [
      ts_const(name: "k", value: ts_call(
