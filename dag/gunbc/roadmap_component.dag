data js_set_client_observation_fn: String = "gunbcSetClientObservation"

fn workflow_lamp_selector(lamp: WorkflowLamp) -> String {
  join([
    "[", workflow_lamp_data_attribute, "=\"",
    workflow_lamp_key(lamp: lamp),
    "\"]",
  ], "")
}

fn workflow_row_selector_expr(node_id: TsExpr) -> TsExpr {
  ts_binop(
    left: ts_binop(
      left: ts_lit_str(value: "li[data-node=\""),
      op: "+",
      right: node_id),
    op: "+",
    right: ts_lit_str(value: "\"]"))
}

fn workflow_lamp_in_row_expr(row_name: String, lamp: WorkflowLamp) -> TsExpr {
  ts_binop(
    left: ts_ident(name: row_name),
    op: "&&",
    right: ts_call(
      callee: ts_member(object: ts_ident(name: row_name), property: "querySelector"),
      args: [ts_lit_str(value: workflow_lamp_selector(lamp: lamp))]))
}

fn workflow_observation_key(state: ClientObservationState) -> String {
  client_observation_state_key(state: state)
}

fn workflow_set_observation_call(
  lamp_expr: TsExpr,
  state: ClientObservationState,
  reason_expr: TsExpr,
) -> TsStmt {
  ts_expr_stmt(expr: ts_call(
    callee: ts_ident(name: js_set_client_observation_fn),
    args: [
      lamp_expr,
      ts_lit_str(value: workflow_observation_key(state: state)),
      reason_expr,
    ]))
}

fn workflow_set_all_observations_stmt(
  lamp: WorkflowLamp,
  state: ClientObservationState,
  reason_expr: TsExpr,
) -> TsStmt {
  ts_expr_stmt(expr: ts_call(
    callee: ts_member(
      object: ts_call(
        callee: ts_member(object: ts_ident(name: "document"), property: "querySelectorAll"),
        args: [ts_lit_str(value: workflow_lamp_selector(lamp: lamp))]),
      property: "forEach"),
    args: [ts_arrow(params: ["lamp"], body: workflow_set_observation_call(
      lamp_expr: ts_ident(name: "lamp"),
      state: state,
      reason_expr: reason_expr))]))
}

fn workflow_observation_preamble_statements() -> List<TsStmt> {
  [
    ts_const(name: js_set_client_observation_fn, value: ts_arrow(
      params: ["lamp", "state", "reason"],
      body: ts_block(stmts: [
        ts_if(
          cond: ts_ident(name: "lamp"),
          then: ts_block(stmts: [
            ts_expr_stmt(expr: ts_binop(
              left: ts_member(
                object: ts_member(object: ts_ident(name: "lamp"), property: "dataset"),
                property: "observation"),
              op: "=",
              right: ts_ident(name: "state"))),
            ts_expr_stmt(expr: ts_binop(
              left: ts_member(object: ts_ident(name: "lamp"), property: "title"),
              op: "=",
              right: ts_binop(
                left: ts_ident(name: "reason"),
                op: "||",
                right: ts_lit_str(value: "")))),
            ts_const(name: "stateLabel", value: ts_cond(
              test: ts_ident(name: "reason"),
              consequent: ts_binop(
                left: ts_binop(
                  left: ts_ident(name: "state"),
                  op: "+",
                  right: ts_lit_str(value: ": ")),
                op: "+",
                right: ts_ident(name: "reason")),
              alternate: ts_ident(name: "state"))),
            ts_expr_stmt(expr: ts_call(
              callee: ts_member(object: ts_ident(name: "lamp"), property: "setAttribute"),
              args: [
                ts_lit_str(value: "aria-label"),
                ts_binop(
                  left: ts_binop(
                    left: ts_member(
                      object: ts_member(object: ts_ident(name: "lamp"), property: "dataset"),
                      property: "label"),
                    op: "+",
                    right: ts_lit_str(value: ": ")),
                  op: "+",
                  right: ts_ident(name: "stateLabel")),
              ])),
          ]),
          else_stmt: none),
      ]))),
  ]
}

data sessions_panel_note: String = "U2 plus workflow lamps v0: one polling loop reads the belt session observation at load and every two seconds; accepted dispatches also request an immediate one-shot read without creating another loop. Each successful read resolves every Live lamp Off, marks observed rows On, renders `session · present` plus Stop, and retracts stale observed-session controls after exit. The stable lookup is li[data-node], so done and superseded rows retain the observation even without an actuator. Refusal resolves every Live lamp to Refused and upserts one source-labeled loud banner — unknowable never rounds to Off; recovery removes that banner. Sessions and attempts remain independent."

fn sessions_mark_live_stmts() -> List<TsStmt> {
  [
    ts_const(name: "sr", value: ts_call(
      callee: ts_member(object: ts_ident(name: "document"), property: "querySelector"),
      args: [workflow_row_selector_expr(
        node_id: ts_member(object: ts_ident(name: "sess"), property: "node_id"))])),
    workflow_set_observation_call(
      lamp_expr: workflow_lamp_in_row_expr(row_name: "sr", lamp: LiveWorkflowLamp),
      state: ClientObservationOn,
      reason_expr: ts_lit_str(value: "")),
    ts_const(name: "sb", value: ts_binop(
      left: ts_ident(name: "sr"),
      op: "&&",
      right: ts_call(
        callee: ts_member(object: ts_ident(name: "sr"), property: "querySelector"),
        args: [ts_lit_str(value: ".dispatch-btn")]))),
    ts_if(
      cond: ts_ident(name: "sb"),
      then: ts_block(stmts: [
        ts_expr_stmt(expr: ts_binop(
          left: ts_member(
            object: ts_member(object: ts_ident(name: "sb"), property: "dataset"),
            property: "sessionObserved"),
          op: "=",
          right: ts_lit_str(value: "true"))),
        ts_expr_stmt(expr: ts_binop(
          left: ts_member(object: ts_ident(name: "sb"), property: "textContent"),
          op: "=",
          right: ts_lit_str(value: concat(dispatch_session_chip_prefix, dispatch_caption_present_word)))),
        ts_expr_stmt(expr: ts_call(
          callee: ts_member(object: ts_member(object: ts_ident(name: "sb"), property: "classList"), property: "add"),
          args: [ts_lit_str(value: dispatch_class_ok)])),
        ts_expr_stmt(expr: ts_binop(
          left: ts_member(object: ts_ident(name: "sb"), property: "title"),
          op: "=",
          right: ts_member(object: ts_ident(name: "sess"), property: "session_name"))),
        ts_let(name: "sc", value: ts_call(
          callee: ts_member(object: ts_member(object: ts_ident(name: "sb"), property: "parentElement"), property: "querySelector"),
          args: [ts_lit_str(value: ".stop-chip")])),
        ts_if(
          cond: ts_prefix(op: "!", expr: ts_ident(name: "sc")),
          then: ts_block(stmts: [
            ts_expr_stmt(expr: ts_binop(left: ts_ident(name: "sc"), op: "=", right: ts_call(callee: ts_member(object: ts_ident(name: "document"), property: "createElement"), args: [ts_lit_str(value: "button")]))),
