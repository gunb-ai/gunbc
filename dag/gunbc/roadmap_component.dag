module gunbc.roadmap_component

import std.types { Int, String, Bool }
import gunbc.design.component {
  Component, ComponentState, ComponentStateKind,
  IdleState, RequestedState, TerminalState,
  component_wire_total, labels_missing_state, states_missing_label,
  component_terminal_states, component_drop_state,
}
import gunbc.design.theme {
  ThemeRole, TextRole, TextDimRole, FigureRole, SurfaceRole, BorderRole, BoundaryRole, FocusRole,
}
import gunbc.design.interaction { DispatchBtnElement, Approach, Dispatch }
import gunbc.roadmap_belt_actuate {
  belt_dispatch_all_status_labels, belt_dispatch_label_is_ok,
  belt_dispatch_ok_status_labels, belt_dispatch_path_prefix,
}
import extdeps.languages.typescript.program {
  TsProgram, TsExpr, TsStmt, serialize_typescript_program,
  ts_ident, ts_lit_str, ts_member, ts_call, ts_binop, ts_arrow, ts_block,
  ts_const, ts_expr_stmt, ts_if, ts_cond, ts_prefix, ts_object, ts_field,
}

data roadmap_component_note: String = "The DispatchButton — the first instantiation of the component concept (gunbc.design.component), and the second consumer that unlocks the archetype library's component axis. It lives HERE, one layer above the register, because it binds the belt wire vocabulary: its terminal states are DERIVED from belt_dispatch_all_status_labels (the grounded label set), never a hand enum, so the state totality is a projection of the served contract — the exact thing the dispatch-button incident needed (the button's states cannot drift from what belt B answers). Role/material binding follows the ok/refusal split of the wire authority: an ok terminal (spawned/already_live) reads through the figure role (the lit/accent material, the same the progress bar uses); a refusal terminal reads through the boundary role (clay — the warning material, never brass-as-text). idle reads text, requested reads text-dim (the in-flight hush). P3 renders these rows as chips + reserved widths; P4 galleries them; here they are just the modeled rows."

fn dispatch_terminal_role(ok: Bool) -> ThemeRole {
  if ok { FigureRole } else { BoundaryRole }
}

fn dispatch_terminal_state(wire_label: String) -> ComponentState {
  let ok = belt_dispatch_label_is_ok(wire_label: wire_label)
  ComponentState {
    key: wire_label,
    kind: TerminalState { wire_label: wire_label, ok: ok },
    role: dispatch_terminal_role(ok: ok),
  }
}

fn dispatch_button_terminal_states() -> List<ComponentState> {
  map(belt_dispatch_all_status_labels(), l => dispatch_terminal_state(wire_label: l))
}

data dispatch_idle_state: ComponentState = ComponentState {
  key: "idle",
  kind: IdleState,
  role: TextRole,
}

data dispatch_requested_state: ComponentState = ComponentState {
  key: "requested",
  kind: RequestedState,
  role: TextDimRole,
}

fn dispatch_button_component() -> Component {
  Component {
    name: "dispatch-button",
    element: DispatchBtnElement,
    verbs: [Approach, Dispatch],
    base_roles: [TextRole, SurfaceRole, BorderRole, FocusRole],
    states: concat(
      [dispatch_idle_state, dispatch_requested_state],
      dispatch_button_terminal_states(),
    ),
  }
}

fn dispatch_button_wire_total() -> Bool {
  component_wire_total(c: dispatch_button_component(), wire_labels: belt_dispatch_all_status_labels())
}

fn dispatch_button_terminal_count() -> Int {
  count(component_terminal_states(c: dispatch_button_component()))
}

data dispatch_reserved_width_note: String = "The dispatch button's reserved width is a PROJECTION of the label authority, not a hand pixel (P3): min-width is the longest wire label (in ch, the mono-font character unit the button uses) plus a fixed gutter for border+padding. Because every terminal renders its wire label as the button text, reserving the longest label's width up front means a text swap (dispatch -> dispatching... -> already_done_signed_off) never reflows the row — the layout jump dies as a class. Add a longer wire arm and the reserved width grows by derivation; there is no pixel to re-tune."

data dispatch_button_ch_gutter: Int = 2

fn longest_label_len(labels: List<String>) -> Int {
  fold(labels, init: 0, f: (acc, l) =>
    if string_length(s: l) > acc { string_length(s: l) } else { acc })
}

fn dispatch_reserved_ch_for(labels: List<String>) -> Int {
  longest_label_len(labels: labels) + dispatch_button_ch_gutter
}

fn dispatch_reserved_ch() -> Int {
  dispatch_reserved_ch_for(labels: belt_dispatch_all_status_labels())
}

fn dispatch_reserved_width() -> String {
  join([to_string(dispatch_reserved_ch()), "ch"], "")
}

data dispatch_class_requested: String = "dispatch-requested"
data dispatch_class_ok: String = "dispatch-ok"
data dispatch_class_refused: String = "dispatch-refused"

data dispatch_state_class_note: String = "The single authority for a state's CSS modifier class, consumed by the client script (which flips classes on the live button), the stylesheet (which paints each class through the state's role material), and the P4 gallery (which renders each state statically) — three consumers, one class vocabulary, so the live button and the gallery cannot disagree. idle is the base (no modifier); the terminals collapse to their ok/refusal MATERIAL group (figure vs boundary), the per-label distinction living in the text, not the color."

fn dispatch_state_class(state: ComponentState) -> String {
  match state.kind {
    IdleState => ""
    RequestedState => dispatch_class_requested
    TerminalState { wire_label: _, ok } => if ok { dispatch_class_ok } else { dispatch_class_refused }
  }
}

data dispatch_client_program_note: String = "The dispatch button's client behavior, modeled in native .dag as ONE TsProgram (extdeps.languages.typescript.program) — never a hand-concatenated JS string (the dispatch-button incident's root class, §5). It is EMITTED as an external served asset (gunbc.roadmap_dispatch_asset_path, served by belt B) and referenced by <script src>, the same shape gunbc.site.moodboard uses for reframe_watcher_js — NOT inlined into the HTML (an inline <script> text node escapes '>' under std.markup EscapeHtml, corrupting an arrow's `=>`; external emission has no such hazard, so arrows are free). The ok-predicate is a ts_binop `||` chain DERIVED from belt_dispatch_ok_status_labels (the wire authority), so a label crossing the ok/refusal line moves the predicate by derivation — the retired belt-A ok/node read is gone and cannot return (the page witness holds a RED on j.ok)."

data roadmap_dispatch_asset_path: String = "/assets/roadmap-dispatch.js"

fn js_b_member(name: String) -> TsExpr {
  ts_member(object: ts_ident(name: "b"), property: name)
}

fn js_j_status() -> TsExpr {
  ts_member(object: ts_ident(name: "j"), property: "status")
}

fn js_j_member(name: String) -> TsExpr {
  ts_member(object: ts_ident(name: "j"), property: name)
}

fn js_classlist_call(method: String, arg: TsExpr) -> TsStmt {
  ts_expr_stmt(expr: ts_call(
    callee: ts_member(object: ts_member(object: ts_ident(name: "b"), property: "classList"), property: method),
    args: [arg],
  ))
}

fn dispatch_ok_status_comparison(wire_label: String) -> TsExpr {
  ts_binop(left: js_j_status(), op: "===", right: ts_lit_str(value: wire_label))
}

fn dispatch_or_chain(exprs: List<TsExpr>) -> TsExpr {
  let acc = fold(exprs, init: none, f: (a, c) => match a {
    Absent => Present { value: c }
    Present { value: prev } => Present { value: ts_binop(left: prev, op: "||", right: c) }
  })
  match acc {
    Present { value: e } => e
    Absent => ts_ident(name: "false")
  }
}

fn dispatch_ok_predicate_expr() -> TsExpr {
  dispatch_or_chain(exprs: map(belt_dispatch_ok_status_labels, l => dispatch_ok_status_comparison(wire_label: l)))
}

fn dispatch_fetch_url_expr() -> TsExpr {
  ts_binop(
    left: ts_lit_str(value: belt_dispatch_path_prefix),
    op: "+",
    right: ts_call(
      callee: ts_ident(name: "encodeURIComponent"),
      args: [ts_call(callee: js_b_member(name: "getAttribute"), args: [ts_lit_str(value: "data-node")])],
    ),
  )
}

fn dispatch_response_handler_body() -> TsStmt {
  ts_block(stmts: [
    ts_const(name: "ok", value: dispatch_ok_predicate_expr()),
    ts_expr_stmt(expr: ts_binop(
      left: js_b_member(name: "textContent"),
      op: "=",
      right: ts_binop(left: js_j_status(), op: "||", right: ts_lit_str(value: "no status")),
    )),
    js_classlist_call(method: "remove", arg: ts_lit_str(value: dispatch_class_requested)),
    js_classlist_call(method: "remove", arg: ts_lit_str(value: dispatch_class_ok)),
    js_classlist_call(method: "remove", arg: ts_lit_str(value: dispatch_class_refused)),
    js_classlist_call(method: "add", arg: ts_cond(
      test: ts_ident(name: "ok"),
      consequent: ts_lit_str(value: dispatch_class_ok),
      alternate: ts_lit_str(value: dispatch_class_refused),
    )),
    ts_const(name: "d", value: ts_binop(left: js_j_member(name: "detail"), op: "||", right: ts_lit_str(value: ""))),
    ts_expr_stmt(expr: ts_binop(
      left: js_b_member(name: "title"),
      op: "=",
      right: ts_cond(
        test: js_j_member(name: "step"),
        consequent: ts_binop(
          left: ts_binop(left: js_j_member(name: "step"), op: "+", right: ts_lit_str(value: ": ")),
          op: "+",
          right: ts_ident(name: "d"),
        ),
        alternate: ts_binop(
          left: ts_binop(left: js_j_member(name: "reason"), op: "||", right: js_j_status()),
          op: "||",
          right: ts_lit_str(value: "no status"),
        ),
      ),
    )),
    ts_if(
      cond: ts_prefix(op: "!", expr: ts_ident(name: "ok")),
      then: ts_block(stmts: [
        ts_expr_stmt(expr: ts_call(
          callee: ts_member(object: ts_ident(name: "console"), property: "log"),
          args: [ts_lit_str(value: "dispatch refused"), ts_ident(name: "j")],
        )),
      ]),
      else_stmt: none,
    ),
    ts_expr_stmt(expr: ts_binop(left: js_b_member(name: "disabled"), op: "=", right: ts_ident(name: "false"))),
  ])
}

fn dispatch_click_handler_body() -> TsStmt {
  ts_block(stmts: [
    ts_expr_stmt(expr: ts_binop(left: js_b_member(name: "disabled"), op: "=", right: ts_ident(name: "true"))),
    ts_expr_stmt(expr: ts_binop(left: js_b_member(name: "textContent"), op: "=", right: ts_lit_str(value: "dispatching..."))),
    js_classlist_call(method: "remove", arg: ts_lit_str(value: dispatch_class_ok)),
    js_classlist_call(method: "remove", arg: ts_lit_str(value: dispatch_class_refused)),
    js_classlist_call(method: "add", arg: ts_lit_str(value: dispatch_class_requested)),
    ts_expr_stmt(expr: ts_binop(left: js_b_member(name: "title"), op: "=", right: ts_lit_str(value: ""))),
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(
        object: ts_call(
          callee: ts_member(
            object: ts_call(
              callee: ts_member(
                object: ts_call(
                  callee: ts_ident(name: "fetch"),
                  args: [dispatch_fetch_url_expr(), ts_object(fields: [ts_field(key: "method", value: ts_lit_str(value: "POST"))])],
                ),
                property: "then",
              ),
              args: [ts_arrow(params: ["r"], body: ts_expr_stmt(expr: ts_call(callee: ts_member(object: ts_ident(name: "r"), property: "json"), args: [])))],
            ),
            property: "then",
          ),
          args: [ts_arrow(params: ["j"], body: dispatch_response_handler_body())],
        ),
        property: "catch",
      ),
      args: [ts_arrow(params: ["e"], body: ts_block(stmts: [
        ts_expr_stmt(expr: ts_binop(left: js_b_member(name: "textContent"), op: "=", right: ts_lit_str(value: "error"))),
        ts_expr_stmt(expr: ts_binop(left: js_b_member(name: "disabled"), op: "=", right: ts_ident(name: "false"))),
      ]))],
    )),
  ])
}

fn dispatch_client_program() -> TsProgram {
  TsProgram {
    ts_nocheck: false,
    header_lines: [
      "gunbc roadmap dispatch button — emitted from gunbc.roadmap_component.dispatch_client_program",
      "POSTs to the dispatch route and reads belt B's status contract (ok set derived from",
      "belt_dispatch_ok_status_labels); served as an external asset, referenced by <script src>",
    ],
    statements: [
      ts_expr_stmt(expr: ts_call(
        callee: ts_member(
          object: ts_call(
            callee: ts_member(object: ts_ident(name: "document"), property: "querySelectorAll"),
            args: [ts_lit_str(value: ".dispatch-btn")],
          ),
          property: "forEach",
        ),
        args: [ts_arrow(params: ["b"], body: ts_block(stmts: [
          ts_expr_stmt(expr: ts_call(
            callee: js_b_member(name: "addEventListener"),
            args: [ts_lit_str(value: "click"), ts_arrow(params: [], body: dispatch_click_handler_body())],
          )),
        ]))],
      )),
    ],
  }
}

fn dispatch_client_js_source() -> String {
  serialize_typescript_program(p: dispatch_client_program())
}
