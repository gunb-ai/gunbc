fn instrument_tuner_client_program() -> extdeps.languages.typescript.program.TsProgram {
  extdeps.languages.typescript.program.TsProgram {
    ts_nocheck: false,
    header_lines: [
      "gunbc v1-deletion instrument tuner — emitted from gunbc.roadmap_component.instrument_tuner_client_program",
      "Persistent camera, selection parity, one detent per admitted threshold, working controls.",
    ],
    statements: concat(
      sound_preamble_statements(),
      concat(
        instrument_tuner_camera_preamble(),
        concat(
          sound_toggle_bind_statements(),
          concat(
            theme_toggle_bind_statements(),
            concat(
              instrument_tuner_control_bind_statements(),
              [
                ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_instrument_load_fn), args: [])),
                ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_instrument_apply_fn), args: [])),
              ],
            ),
          ),
        ),
      ),
    ),
  }
}

fn instrument_tuner_client_js_source() -> String {
  serialize_typescript_program(p: instrument_tuner_client_program())
}

data instrument_sandbox_page_path: String = "/sandbox/instrument"
data instrument_tuner_page_path: String = "/sandbox/instrument/tuner"
data instrument_motion_page_path: String = "/sandbox/instrument/motion"
data repo_atlas_page_path: String = "/sandbox/repo-atlas"

data instrument_lab_nav_note: String = "ONE ROSTER, RENDERED IN THE SHARED HEADER, so a new instrument page is discoverable by adding a row rather than by remembering which pages to edit. It also removes the path literals: the route table and the links now read the same declaration, so a page cannot link somewhere the router does not serve. That is the difference between a nav that is DERIVED from the routes' own path authority and one that agrees with it by coincidence until someone renames a route."

type InstrumentLabLink {
  path: String
  label: String
}

data instrument_lab_links: List<InstrumentLabLink> = [
  InstrumentLabLink { path: instrument_sandbox_page_path, label: "instrument" },
  InstrumentLabLink { path: instrument_tuner_page_path, label: "tuner" },
  InstrumentLabLink { path: instrument_motion_page_path, label: "motion lab" },
  InstrumentLabLink { path: repo_atlas_page_path, label: "repo atlas" },
]

data instrument_motion_asset_path: String = "/assets/instrument-motion.js"

data instrument_motion_client_note: String = "THE RENDERER HALF OF THE MOTION LAB. It replays a decided sequence and reports two probes; it computes no physics and it decides no verdict.

THE ONE RULE THIS PROGRAM EXISTS TO KEEP: every receipt line it writes names something that happened. A count of events is a count it kept. A named error is the error's own name, read off the event. A window is measured, not declared. Where nothing has happened yet the line says so, and where an interface is absent the line says absent rather than silent — those are different observations and this program never renders them the same way.

WHY THE FRAMES ARRIVE AS DATA: the displacement sequence is decided in gunbc.design.instrument_bob, asserted green in a witness, and shipped into the page on an attribute. So the browser cannot disagree with the witness, a physics change is a diff rather than something to watch for on screen, and this file has no envelope, no half-life and no bound of its own to drift from the model's."

data motion_plate_class: String = "motion-plate"
data motion_tap_btn_class: String = "motion-tap-btn"
data motion_receipt_class: String = "motion-receipt"
data motion_frame_data_attr: String = "data-frames"
data motion_reduced_frame_data_attr: String = "data-frames-reduced"
data motion_frame_interval_attr: String = "data-frame-interval"
data motion_plate_id: String = "motion-plate"
data motion_receipt_id: String = "motion-receipt"
data motion_probe_run_id: String = "motion-probe-run"

data motion_probe_window_ms: Int = 2000

data client_manufactures_no_final_zero_note: String = "THE CLIENT DOES NOT RESET THE PLATE WHEN THE LIST RUNS OUT, and removing that line is half the repair for a real defect. It used to set translateY(0) after consuming the frames, which meant a sequence that never settled still LOOKED settled — the renderer supplied the ending the model had failed to reach, and the failure had no way to become visible. The sequence now ends at zero because gunbc.design.instrument_bob proved it does, and a sequence that cannot reach rest is refused before it is ever shipped, so there is nothing left for a fallback to paper over."

data motion_reduced_sequence_is_emitted_not_suppressed_note: String = "REDUCED MOTION IS A SECOND DECIDED SEQUENCE, NOT A SUPPRESSED FIRST ONE. The page ships both wires and the client selects by matchMedia, so under a reduced-motion preference the model still answers 'what does the plate do' — it answers with the at-rest frame gunbc.design.instrument_bob returns for MotionReduced. The receipt, the straddle and the magnitudes are untouched. Suppressing playback in the client instead would put a second motion policy in the renderer, disagreeing silently with the one the witness asserts."

data js_motion_plate_var: String = "gunbcMotionPlate"
data js_motion_receipt_var: String = "gunbcMotionReceipt"
data js_motion_interval_var: String = "gunbcMotionInterval"
data js_motion_reduced_var: String = "gunbcMotionReduced"
data js_motion_timer_var: String = "gunbcMotionTimer"
data js_motion_line_fn: String = "gunbcMotionLine"
data js_motion_play_fn: String = "gunbcMotionPlay"
data js_motion_devicemotion_probe_fn: String = "gunbcMotionProbeDeviceMotion"
data js_motion_sensor_probe_fn: String = "gunbcMotionProbeSensor"
data js_motion_sensor_refused_var: String = "gunbcMotionSensorRefused"

fn js_motion_assign(target: extdeps.languages.typescript.program.TsExpr, value: extdeps.languages.typescript.program.TsExpr) -> extdeps.languages.typescript.program.TsStmt {
  ts_expr_stmt(expr: ts_binop(left: target, op: "=", right: value))
}

fn js_motion_guard(cond: extdeps.languages.typescript.program.TsExpr) -> extdeps.languages.typescript.program.TsStmt {
  ts_if(cond: cond, then: ts_return(expr: none), else_stmt: none)
}

fn js_motion_cat(parts: List<extdeps.languages.typescript.program.TsExpr>) -> extdeps.languages.typescript.program.TsExpr {
  fold(parts, init: ts_lit_str(value: ""), f: (acc, p) => ts_binop(left: acc, op: "+", right: p))
}

fn js_motion_line_call(index: String, text: extdeps.languages.typescript.program.TsExpr) -> extdeps.languages.typescript.program.TsStmt {
  ts_expr_stmt(expr: ts_call(
    callee: ts_ident(name: js_motion_line_fn),
    args: [ts_lit_num(text: index), text],
  ))
}

fn js_motion_typeof_undefined(name: String) -> extdeps.languages.typescript.program.TsExpr {
  ts_binop(
    left: ts_prefix(op: "typeof ", expr: ts_ident(name: name)),
    op: "===",
    right: ts_lit_str(value: "undefined"),
  )
}

data any_axis_is_the_upstream_predicate_note: String = "A READING IS ANY NON-NULL AXIS, NOT THE X AXIS (review finding, 2026-08-07). Both probes decided what counted as a value by reading one field: the event path tested acceleration.x alone, and the sensor path tested nothing at all and counted reading EVENTS as readings. The first misclassifies a device whose knock lands on y or z as producing hollow events; the second reports readings on a route whose axes are declared nullable, which is the events-versus-values collapse the cited module went to the trouble of naming.

This is the emitted form of acceleration_carries_any_value: any axis carrying a value makes the reading a reading. The axis names arrive as parameters from whichever specification defines the object being read, so neither probe spells them at the reading site."

fn js_motion_axis_not_null(obj: extdeps.languages.typescript.program.TsExpr, axis: String) -> extdeps.languages.typescript.program.TsExpr {
  ts_binop(left: ts_member(object: obj, property: axis), op: "!==", right: ts_ident(name: "null"))
}

fn js_motion_any_axis_valued(obj: extdeps.languages.typescript.program.TsExpr, x: String, y: String, z: String) -> extdeps.languages.typescript.program.TsExpr {
  ts_binop(
    left: js_motion_axis_not_null(obj: obj, axis: x),
    op: "||",
    right: ts_binop(
      left: js_motion_axis_not_null(obj: obj, axis: y),
      op: "||",
      right: js_motion_axis_not_null(obj: obj, axis: z),
    ),
  )
}

fn js_motion_count_if(cond: extdeps.languages.typescript.program.TsExpr, counter: String) -> extdeps.languages.typescript.program.TsStmt {
  ts_if(
    cond: cond,
    then: js_motion_assign(
      target: ts_ident(name: counter),
      value: ts_binop(left: ts_ident(name: counter), op: "+", right: ts_lit_num(text: "1")),
    ),
    else_stmt: none,
  )
}

fn js_motion_now() -> extdeps.languages.typescript.program.TsExpr {
  ts_call(callee: ts_member(object: ts_ident(name: "Date"), property: "now"), args: [])
}

fn js_motion_get_by_id(id: String) -> extdeps.languages.typescript.program.TsExpr {
  ts_call(
    callee: ts_member(object: ts_ident(name: "document"), property: "getElementById"),
    args: [ts_lit_str(value: id)],
  )
}

fn js_motion_set_timeout(body: List<extdeps.languages.typescript.program.TsStmt>) -> extdeps.languages.typescript.program.TsStmt {
  ts_expr_stmt(expr: ts_call(
    callee: ts_ident(name: "setTimeout"),
    args: [
      ts_arrow(params: [], body: ts_block(stmts: body)),
      ts_lit_num(text: to_string(motion_probe_window_ms)),
    ],
  ))
}

fn motion_preamble_statements() -> List<extdeps.languages.typescript.program.TsStmt> {
  [
    ts_const(name: js_motion_plate_var, value: js_motion_get_by_id(id: motion_plate_id)),
    ts_const(name: js_motion_receipt_var, value: js_motion_get_by_id(id: motion_receipt_id)),
    ts_const(
      name: js_motion_interval_var,
      value: ts_cond(
        test: ts_ident(name: js_motion_plate_var),
        consequent: ts_call(
          callee: ts_ident(name: "parseInt"),
          args: [
            ts_call(
              callee: ts_member(object: ts_ident(name: js_motion_plate_var), property: "getAttribute"),
              args: [ts_lit_str(value: motion_frame_interval_attr)],
            ),
            ts_lit_num(text: "10"),
          ],
        ),
        alternate: ts_lit_num(text: "0"),
      ),
    ),
    ts_const(
      name: js_motion_reduced_var,
      value: ts_binop(
        left: ts_member(object: ts_ident(name: "window"), property: "matchMedia"),
        op: "&&",
        right: ts_member(
          object: ts_call(
            callee: ts_member(object: ts_ident(name: "window"), property: "matchMedia"),
            args: [ts_lit_str(value: "(prefers-reduced-motion: reduce)")],
          ),
          property: "matches",
        ),
      ),
    ),
    ts_let(name: js_motion_timer_var, value: ts_ident(name: "null")),
    ts_let(name: js_motion_sensor_refused_var, value: ts_ident(name: "false")),
  ]
}

fn motion_line_fn_statement() -> extdeps.languages.typescript.program.TsStmt {
