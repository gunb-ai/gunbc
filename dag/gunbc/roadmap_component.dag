    )),
    ts_const(
      name: "wp",
      value: workflow_progress_in_row_expr(row_name: "wr"),
    ),
    ts_if(
      cond: ts_ident(name: "wp"),
      then: ts_block(stmts: [
        ts_expr_stmt(expr: ts_binop(
          left: ts_member(object: ts_ident(name: "wp"), property: "hidden"),
          op: "=",
          right: ts_ident(name: "false"),
        )),
        ts_expr_stmt(expr: ts_binop(
          left: ts_member(object: ts_ident(name: "wp"), property: "title"),
          op: "=",
          right: ts_binop(
            left: ts_binop(
              left: ts_binop(
                left: ts_member(
