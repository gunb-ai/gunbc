data sessions_reset_note: String = "Each session observation clears the prior projection before repainting: presence datasets flip back and every session-facts disclosure line is removed, so a torn-down session cannot leave a stale 'present' claim. The dispatch button itself is untouched — it is an action and never carried the presence claim after A2 (node_activity_region_note)."

fn sessions_reset_presence_stmt() -> extdeps.languages.typescript.program.TsStmt {
  ts_expr_stmt(expr: ts_call(
    callee: ts_member(
      object: ts_call(
        callee: ts_member(object: ts_ident(name: "document"), property: "querySelectorAll"),
        args: [ts_lit_str(value: join([
          ".dispatch-btn[data-session-presence=\"present\"], .",
          session_facts_class,
        ], ""))]),
      property: "forEach"),
    args: [ts_arrow(params: ["pb"], body: ts_block(stmts: [
      ts_if(
        cond: ts_call(
          callee: ts_member(
            object: ts_member(object: ts_ident(name: "pb"), property: "classList"),
            property: "contains"),
          args: [ts_lit_str(value: session_facts_class)]),
        then: ts_block(stmts: [
          ts_expr_stmt(expr: ts_call(
            callee: ts_member(object: ts_ident(name: "pb"), property: "remove"),
            args: [])),
        ]),
        else_stmt: Present { value: ts_block(stmts: [
          ts_expr_stmt(expr: ts_binop(
            left: ts_member(
              object: ts_member(object: ts_ident(name: "pb"), property: "dataset"),
              property: "sessionPresence"),
            op: "=",
            right: ts_lit_str(value: ""))),
        ]) },
      ),
    ]))]))
}

data observe_impact_region_note: String = "ONE FAILURE NARRATED ONCE, ACROSS CHANNELS (A2 hierarchy closeout, operator gap ruling 2026-08-02). Three observation channels — sessions, attempts, workflow — used to each prepend their own full-width refusal banner through this painter, so one dead observation root stacked three near-identical amber voices above the fold (the local-serve screenshots are the specimen). The painter now upserts each channel's located row INSIDE one shared impact region: the server-rendered section.workspace-observation when the page shipped one (the serve-time impact statement keeps its own summary — the client never overwrites a server-decided claim), else a client-minted twin. The region's disclosure holds the per-channel raw rows, the summary states the user-relevant impact with the refused-channel count, and gunbcObserveImpactSync retracts rows as channels recover — a client-minted region with zero refused rows removes itself, so recovery leaves no husk. Frequency stays observable: every channel row remains in the DOM, typed by its source class, one interaction deep — deduplicated narration, never deduplicated evidence."

