fn dispatch_client_program_for(
  selector: String,
  url_expr: extdeps.languages.typescript.program.TsExpr,
  header: List<String>,
  instance_statements: List<extdeps.languages.typescript.program.TsStmt>,
) -> extdeps.languages.typescript.program.TsProgram {
  extdeps.languages.typescript.program.TsProgram {
    ts_nocheck: false,
    header_lines: header,
    statements: concat(
      sound_preamble_statements(),
      concat(
        dispatch_preamble_statements(),
        concat(
          observe_impact_preamble_statements(),
          concat(
          dispatch_bind_statements(selector: selector, url_expr: url_expr),
          concat(
            sound_toggle_bind_statements(),
            concat(
              theme_toggle_bind_statements(),
              concat(
                disclosure_bind_statements(),
                concat(
                  swatch_toggle_bind_statements(),
                  concat(
                    observation_fetch_statements(),
                    concat(
                      workflow_fetch_statements(),
                      concat(
                        row_selection_bind_statements(),
                        instance_statements))))))))))),
  }
}

fn dispatch_client_program() -> extdeps.languages.typescript.program.TsProgram {
  dispatch_client_program_for(
    selector: ".dispatch-btn",
    url_expr: dispatch_fetch_url_expr(),
    header: [
      "gunbc roadmap dispatch button — emitted from gunbc.roadmap_component.dispatch_client_program",
      "POSTs to the dispatch route and reads belt B's status contract (ok set derived from",
      "belt_dispatch_ok_status_labels); served as an external asset, referenced by <script src>",
      "Operation sound: a 5ms detent tick on pointerdown, synthesized through WebAudio from",
      "gunbc.design.sound rows — no audio files, and a persisted mute the instrument obeys",
    ],
    instance_statements: dashboard_instance_fetch_statements(),
  )
}

fn dispatch_client_js_source() -> String {
  serialize_typescript_program(p: dispatch_client_program())
}

data sandbox_live_class: String = "sandbox-live-btn"

data sandbox_client_program_note: String = "The /sandbox live instance reuses the EXACT dispatch render (dispatch_client_program_for) — one behavior, two bindings (§2): same click/response handler, only the fetch URL differs. It POSTs to /sandbox/echo?status=<data-status> instead of the real dispatch route, so every wire arm is pressable and renders identically to the real button, without spawning a session. If the render forked, the sandbox would be a lie; sharing the program makes it a faithful mirror."

fn sandbox_echo_url_expr() -> extdeps.languages.typescript.program.TsExpr {
  ts_binop(
    left: ts_lit_str(value: "/sandbox/echo?status="),
    op: "+",
    right: ts_call(
      callee: ts_ident(name: "encodeURIComponent"),
      args: [ts_call(callee: js_b_member(name: "getAttribute"), args: [ts_lit_str(value: "data-status")])],
    ),
  )
}

fn sandbox_client_program() -> extdeps.languages.typescript.program.TsProgram {
  dispatch_client_program_for(
    selector: join([".", sandbox_live_class], ""),
    url_expr: sandbox_echo_url_expr(),
    header: [
      "gunbc /sandbox live dispatch instance — emitted from gunbc.roadmap_component.sandbox_client_program",
      "same render as the real dispatch button, but POSTs to /sandbox/echo?status=<data-status>",
      "so every wire arm is pressable without dispatching a real session",
    ],
    instance_statements: [],
  )
}

fn sandbox_client_js_source() -> String {
  serialize_typescript_program(p: sandbox_client_program())
}

data instrument_tuner_asset_path: String = "/assets/instrument-tuner.js"

data instrument_tuner_client_note: String = "THE OPERABLE HALF OF THE V1-DELETION INSTRUMENT (declared follow-on to gunbc.roadmap_instrument_sandbox exemplar_note). Modeled as a TsProgram via serialize_typescript_program — persistent camera in localStorage, selection parity with row_selection_bind_statements, thresholded wheel integrator (one detent per admitted threshold) and seek-depth buttons that decompose distant targets into adjacent steps, detent click only when depth actually changes, MVP user depths (program/outcome/front) on controls. Never writes a program fact."

data instrument_subject_class: String = "instrument-subject"
data instrument_subject_selected_class: String = "instrument-subject-selected"
data instrument_reading_class: String = "instrument-reading"
data instrument_depth_btn_class: String = "instrument-depth-btn"
data instrument_mode_btn_class: String = "instrument-mode-btn"
data instrument_tuner_root_class: String = "instrument-tuner"

data js_instrument_camera_var: String = "gunbcCamera"
data js_instrument_load_fn: String = "gunbcLoadInstrumentCamera"
data js_instrument_save_fn: String = "gunbcSaveInstrumentCamera"
data js_instrument_apply_fn: String = "gunbcApplyInstrumentCamera"
data js_instrument_step_depth_fn: String = "gunbcStepInstrumentDepth"
data js_instrument_seek_depth_fn: String = "gunbcSeekInstrumentDepth"
data js_instrument_set_mode_fn: String = "gunbcSetInstrumentMode"
data js_instrument_select_subject_fn: String = "gunbcSelectInstrumentSubject"
data js_instrument_clear_subject_fn: String = "gunbcClearInstrumentSubject"

data js_instrument_wheel_travel_var: String = "instrumentWheelTravel"
data js_instrument_wheel_timer_var: String = "instrumentWheelGestureTimer"
data js_instrument_normalize_wheel_fn: String = "gunbcNormalizeWheelDelta"
data js_instrument_consume_wheel_fn: String = "gunbcConsumeWheelTravel"
data js_instrument_handle_wheel_fn: String = "gunbcHandleInstrumentWheel"
data js_instrument_wheel_threshold_const: String = "INSTRUMENT_WHEEL_THRESHOLD"

fn instrument_focus_keys() -> List<String> {
  concat(
    [focus_subject_key(f: NoSubjectSelected)],
    v1_exit_finish_lines() |> map(s => v1_finish_line_key(l: s.line)),
  )
}

fn js_instrument_wire_index_valid(keys_var: String, parts_var: String, index: String) -> extdeps.languages.typescript.program.TsExpr {
  ts_binop(
    left: ts_call(
      callee: ts_member(object: ts_ident(name: keys_var), property: "indexOf"),
      args: [ts_index(object: ts_ident(name: parts_var), index: ts_lit_num(text: index))],
    ),
    op: "<",
    right: ts_lit_num(text: "0"),
  )
}

fn js_instrument_camera_member(name: String) -> extdeps.languages.typescript.program.TsExpr {
  ts_member(object: ts_ident(name: js_instrument_camera_var), property: name)
}

fn js_instrument_wire_expr() -> extdeps.languages.typescript.program.TsExpr {
  ts_binop(
    left: ts_binop(
      left: js_instrument_camera_member(name: "depth"),
      op: "+",
      right: ts_lit_str(value: camera_wire_sep),
    ),
    op: "+",
    right: ts_binop(
      left: js_instrument_camera_member(name: "mode"),
      op: "+",
      right: ts_binop(
        left: ts_lit_str(value: camera_wire_sep),
        op: "+",
        right: js_instrument_camera_member(name: "focus"),
      ),
    ),
  )
}

fn js_instrument_query_all(class_name: String) -> extdeps.languages.typescript.program.TsExpr {
  ts_call(
    callee: ts_member(object: ts_ident(name: "document"), property: "querySelectorAll"),
    args: [ts_lit_str(value: join([".", class_name], ""))],
  )
}

fn js_instrument_toggle_class_on(el: String, cls: String, on: extdeps.languages.typescript.program.TsExpr) -> extdeps.languages.typescript.program.TsStmt {
  ts_expr_stmt(expr: ts_call(
    callee: ts_member(object: ts_member(object: ts_ident(name: el), property: "classList"), property: "toggle"),
    args: [ts_lit_str(value: cls), on],
  ))
}

fn instrument_tuner_load_camera_fn_body() -> List<extdeps.languages.typescript.program.TsStmt> {
  [
    ts_const(name: "w", value: js_local_storage_get(key: camera_storage_key)),
    ts_if(cond: ts_prefix(op: "!", expr: ts_ident(name: "w")), then: ts_return(expr: none), else_stmt: none),
    ts_const(name: "parts", value: ts_call(
      callee: ts_member(object: ts_ident(name: "w"), property: "split"),
      args: [ts_lit_str(value: camera_wire_sep)],
    )),
    ts_if(
      cond: ts_binop(left: ts_member(object: ts_ident(name: "parts"), property: "length"), op: "!==", right: ts_lit_num(text: "3")),
      then: ts_return(expr: none),
      else_stmt: none,
    ),
    ts_if(
      cond: js_instrument_wire_index_valid(keys_var: "INSTRUMENT_WIRE_DEPTH_KEYS", parts_var: "parts", index: "0"),
      then: ts_return(expr: none),
      else_stmt: none,
    ),
    ts_if(
      cond: js_instrument_wire_index_valid(keys_var: "INSTRUMENT_MODE_KEYS", parts_var: "parts", index: "1"),
      then: ts_return(expr: none),
      else_stmt: none,
    ),
    ts_if(
      cond: js_instrument_wire_index_valid(keys_var: "INSTRUMENT_FOCUS_KEYS", parts_var: "parts", index: "2"),
      then: ts_return(expr: none),
      else_stmt: none,
    ),
    ts_expr_stmt(expr: ts_binop(left: js_instrument_camera_member(name: "depth"), op: "=", right: ts_index(object: ts_ident(name: "parts"), index: ts_lit_num(text: "0")))),
    ts_expr_stmt(expr: ts_binop(left: js_instrument_camera_member(name: "mode"), op: "=", right: ts_index(object: ts_ident(name: "parts"), index: ts_lit_num(text: "1")))),
    ts_expr_stmt(expr: ts_binop(left: js_instrument_camera_member(name: "focus"), op: "=", right: ts_index(object: ts_ident(name: "parts"), index: ts_lit_num(text: "2")))),
  ]
}

fn instrument_tuner_reading_visibility_stmt() -> extdeps.languages.typescript.program.TsStmt {
  ts_expr_stmt(expr: ts_call(
    callee: ts_member(object: js_instrument_query_all(class_name: instrument_reading_class), property: "forEach"),
    args: [ts_arrow(params: ["r"], body: ts_block(stmts: [
      ts_expr_stmt(expr: ts_binop(
        left: ts_member(object: ts_ident(name: "r"), property: "hidden"),
        op: "=",
        right: ts_binop(
          left: ts_call(
            callee: ts_member(object: ts_ident(name: "r"), property: "getAttribute"),
            args: [ts_lit_str(value: "data-reading-key")],
          ),
          op: "!==",
          right: ts_ident(name: "key"),
        ),
      )),
    ]))],
  ))
}

fn instrument_tuner_depth_btn_apply_stmt() -> extdeps.languages.typescript.program.TsStmt {
  ts_expr_stmt(expr: ts_call(
