data roadmap_component_note: String = "The DispatchButton — the first instantiation of the component concept (gunbc.design.component), and the second consumer that unlocks the archetype library's component axis. It lives HERE, one layer above the register, because it binds the belt wire vocabulary: its terminal states are DERIVED from belt_dispatch_all_status_labels (the grounded label set), never a hand enum, so the state totality is a projection of the served contract — the exact thing the dispatch-button incident needed (the button's states cannot drift from what belt B answers). Role/material binding follows the ok/refusal split of the wire authority: an ok terminal (spawned/already_live) reads through the figure role (the lit/accent material, the same the progress bar uses); a refusal terminal reads through the boundary role (clay — the warning material, never brass-as-text). idle reads text, requested reads text-dim (the in-flight hush). P3 renders these rows as chips + reserved widths; P4 galleries them; here they are just the modeled rows."

fn dispatch_terminal_role(ok: Bool) -> ThemeRole {
  if ok { FigureRole } else { BoundaryRole }
}

fn dispatch_terminal_state(wire_label: String) -> ComponentState {
  let ok = belt_dispatch_label_is_ok(wire_label: wire_label)
  ComponentState {
    key: wire_label,
    kind: TerminalState { wire_label: wire_label, ok: ok },
    role: dispatch_terminal_role(ok: ok),
  }
}

fn dispatch_button_terminal_states() -> List<ComponentState> {
  map(belt_dispatch_all_status_labels(), l => dispatch_terminal_state(wire_label: l))
}

data dispatch_idle_state: ComponentState = ComponentState {
  key: "idle",
  kind: IdleState,
  role: TextRole,
}

data dispatch_requested_state: ComponentState = ComponentState {
  key: "requested",
  kind: RequestedState,
  role: TextDimRole,
}

fn dispatch_button_component() -> Component {
  Component {
    name: "dispatch-button",
    element: DispatchBtnElement,
    verbs: [Approach, Dispatch],
    base_roles: [TextRole, SurfaceRole, BorderRole, FocusRole],
    states: concat(
      [dispatch_idle_state, dispatch_requested_state],
      dispatch_button_terminal_states(),
    ),
  }
}

fn dispatch_button_wire_total() -> Bool {
  component_wire_total(c: dispatch_button_component(), wire_labels: belt_dispatch_all_status_labels())
}

fn dispatch_button_terminal_count() -> Int {
  count(component_terminal_states(c: dispatch_button_component()))
}

data dispatch_reserved_width_note: String = "The dispatch button's reserved width is a PROJECTION of the caption authority, not a hand pixel (P3, re-pointed by remodel W1d): min-width is the longest CAPTION the button can wear (band phrases + the session-chip morphs derived from the ok labels) plus a fixed gutter. Wire labels no longer render as captions, so they no longer drive geometry — the A.4 complaint's root (the control shaped by its worst-case diagnostic string) dissolves here. A caption or ok-label change moves the reservation by derivation; there is no pixel to re-tune."

data dispatch_button_ch_gutter: Int = 2

fn longest_label_len(labels: List<String>) -> Int {
  fold(labels, init: 0, f: (acc, l) =>
    if string_length(s: l) > acc { string_length(s: l) } else { acc })
}

fn dispatch_reserved_ch_for(labels: List<String>) -> Int {
  longest_label_len(labels: labels) + dispatch_button_ch_gutter
}

fn dispatch_caption_set() -> List<String> {
  concat(
    [dispatch_caption_idle, dispatch_caption_requested, dispatch_caption_fail, dispatch_caption_loud],
    [concat(dispatch_ack_prefix, dispatch_ack_word), concat(dispatch_session_chip_prefix, dispatch_caption_present_word)])
}

fn dispatch_reserved_ch() -> Int {
  dispatch_reserved_ch_for(labels: dispatch_caption_set())
}

fn dispatch_reserved_length() -> CssLength {
  css_ch(n: dispatch_reserved_ch())
}

fn dispatch_reserved_width() -> String {
  css_length_wire(l: dispatch_reserved_length())
}

data dispatch_session_chip_note: String = "The POST acknowledgement and the session observation are two different captions because they are two different facts. An ok POST renders `dispatch · accepted`: worktree/process creation returned success, or the idempotent request found the desired dispatch already accepted. Only the independent /sessions.json observation may render `session · present`, and that wording claims tmux/process presence only — never provider readiness, execution, or completion. The response's exact spawned/already_live wire label remains in the title channel.

Both captions stay inside the reserved width derived from the caption set, so re-observation cannot reflow the row. The session chip remains type-distinct from the node's status chip at the head of the row."

data dispatch_ack_prefix: String = "dispatch · "
data dispatch_ack_word: String = "accepted"
data dispatch_session_chip_prefix: String = "session · "

data sessions_route_path: String = "/sessions.json"

data attempts_route_path: String = "/attempts.json"

type WorkflowLamp
  = LiveWorkflowLamp
  | AttemptedWorkflowLamp

data workflow_lamps_v0: List<WorkflowLamp> = [
  LiveWorkflowLamp,
  AttemptedWorkflowLamp,
]

fn workflow_lamp_key(lamp: WorkflowLamp) -> String {
  match lamp {
    LiveWorkflowLamp => "live"
    AttemptedWorkflowLamp => "attempted"
  }
}

fn workflow_lamp_label(lamp: WorkflowLamp) -> String {
  match lamp {
    LiveWorkflowLamp => "Live"
    AttemptedWorkflowLamp => "Attempted"
  }
}

fn workflow_lamp_state(
  lamp: WorkflowLamp,
  live: ClientObservationState,
  attempted: ClientObservationState,
) -> ClientObservationState {
  match lamp {
    LiveWorkflowLamp => live
    AttemptedWorkflowLamp => attempted
  }
}

fn workflow_lamp_initial_state(lamp: WorkflowLamp) -> ClientObservationState {
  workflow_lamp_state(
    lamp: lamp,
    live: ClientObservationPending,
    attempted: ClientObservationPending)
}

data workflow_controls_class: String = "workflow-controls"
data workflow_strip_class: String = "workflow-strip"
data workflow_lamp_class: String = "workflow-lamp"
data workflow_lamp_indicator_class: String = "workflow-lamp-indicator"
data workflow_lamp_label_class: String = "workflow-lamp-label"
data workflow_lamp_data_attribute: String = "data-workflow-lamp"
data workflow_observation_data_attribute: String = "data-observation"
data workflow_lamp_label_data_attribute: String = "data-label"

data workflow_lamps_note: String = "Workflow lamps v0 (operator adjudication 2026-07-26): Live and Attempted are two independent projections over the existing /sessions.json and /attempts.json observations. workflow_lamps_v0 declares their presentation order for the row strip; workflow_lamp_state selects each axis without collapsing them into one workflow status. Every lamp starts ClientObservationPending and can become Off, On, or Refused only through the shared gunbc.client_observation_state authority. The strip is evidence presentation only: its rightmost lit member never gates an action and is never persisted. gunbc.client_observation_state.work_item_workflow_fact_note records the seven-fact join ruling without re-declaring those facts as a parallel roster. Proposed and Landed do not earn lamps until the typed attempt/branch/PR/node join exists; that binding, not more visual states, is the next slice."

data dispatch_caption_live_word_note: String = "The session route observes tmux/process presence, not agent execution. Its caption is therefore `present`, never `live` or `executing`. The existing Live workflow lamp keeps its compatibility label while its evidence source remains this same documented presence observation."

data dispatch_caption_present_word: String = "present"

data dispatch_class_requested: String = "dispatch-requested"
data dispatch_class_ok: String = "dispatch-ok"
data dispatch_class_refused: String = "dispatch-refused"
data dispatch_class_loud: String = "dispatch-loud"

data roadmap_row_archetype_note: String = "The RoadmapRow archetype (composition slice 2; refined by workflow lamps v0 without adding a head track): the row's five regions remain status chip, title, meta, disclosure, actuator. The ActuatorRegion is realized by one always-present workflow-controls wrapper containing the workflow strip and the optional dispatch control; dynamic Stop also lands inside that wrapper. This preserves the derived auto 1fr auto grid while giving done/superseded rows an observation surface and preventing Stop or a lamp strip from becoming an implicit fourth grid item. The title owns the flex track; meta FLOWS inside it; disclosure sits under the head. Density rides roadmap_row_height and roadmap_row_gutter. The full-size instrument specimen remains outside .node-head in the sandbox."

type RowTrack
  = AutoTrack
  | FlexTrack

fn row_track_wire(t: RowTrack) -> String {
  match t {
    AutoTrack => "auto"
    FlexTrack => "1fr"
  }
}

type RowPlacement
  = HeadTrack { track: RowTrack }
  | InTitleFlow
  | UnderHead

type RowRegion
  = StatusChipRegion
  | TitleRegion
  | MetaRegion
  | DisclosureRegion
  | ActuatorRegion

fn row_region_key(r: RowRegion) -> String {
  match r {
    StatusChipRegion => "status-chip"
    TitleRegion => "title"
    MetaRegion => "meta"
    DisclosureRegion => "disclosure"
    ActuatorRegion => "actuator"
  }
}

type RoadmapRowRegion {
  region: RowRegion
  placement: RowPlacement
}

data roadmap_row_archetype: List<RoadmapRowRegion> = [
  RoadmapRowRegion { region: StatusChipRegion, placement: HeadTrack { track: AutoTrack } },
  RoadmapRowRegion { region: TitleRegion, placement: HeadTrack { track: FlexTrack } },
  RoadmapRowRegion { region: MetaRegion, placement: InTitleFlow },
  RoadmapRowRegion { region: DisclosureRegion, placement: UnderHead },
  RoadmapRowRegion { region: ActuatorRegion, placement: HeadTrack { track: AutoTrack } },
]

data roadmap_row_gutter_split_note: String = "Two gutters, two jobs (operator-signed 2026-07-25, the third PROVISIONAL flip): the first cut ran ONE space-4 token as both the grid's column rhythm and the mid cell's badge-flow rhythm, and the operator's tune split them — column gaps (chip | title | actuator) breathe at space-8 while the badge flow inside the title cell keeps space-4. They are separate density decisions that happened to share a number for one commit; a later retune of either moves alone."

data roadmap_row_height: ScaleToken = height_row
data roadmap_row_gutter: ScaleToken = space_4
data roadmap_row_column_gutter: ScaleToken = space_8

fn roadmap_row_grid_template() -> String {
  join(
    fold(roadmap_row_archetype, init: [], f: (acc, r) => match r.placement {
      HeadTrack { track } => concat(acc, [row_track_wire(t: track)])
      InTitleFlow => acc
      UnderHead => acc
    }),
    " ")
}

data node_mid_class_note: String = "The title track's cell: the wrapper that carries the title plus the flowing meta regions (badges, carrier links). It exists because the archetype's grid has exactly the head tracks as columns and a node's badge count varies — meta declared InTitleFlow realizes as flex flow inside this cell, never as a column that would ragged the grid."

data node_mid_class: String = "node-mid"

data dispatch_caption_note: String = "The operator-facing captions (remodel W1d, operator ruling 2026-07-24): the wire taxonomy never renders as button text. The caption is the BAND's verb — ok keeps the session-chip morph (prefix + the belt's own status word, an honest projection, checkpoint 2); fail and loud collapse to one operator phrase each, with the wire label and its located fields demoted to the title/detail channel. BandInProgress renders the requested caption. These rows are the caption authority for the client program, the gallery, and the reserved width — one vocabulary, three consumers."

data dispatch_caption_idle: String = "dispatch"
data dispatch_caption_requested: String = "dispatching..."
data dispatch_caption_fail: String = "not dispatchable"
data dispatch_caption_loud: String = "belt fault"

data theme_toggle_note: String = "The day/night control (operator 2026-07-24, remodel W1g): a property of the whole surface like the mute, cycling auto -> day -> night. auto removes data-theme so the prefers-color-scheme projection governs; a named choice pins data-theme to the Theme's OWN name (derived from day_theme/night_theme, never a re-typed string), which the theme_root_css selector grammar already answers. Persisted in this browser's storage for the same reason the mute is: the preference belongs to these eyes."

data disclosure_component_note: String = "The brief disclosure enters the register (remodel W1e, operator 2026-07-24: the UA triangle read as debug chrome — a ticket affordance, not a tree-widget default). The MARK is a real span inside the summary, never a UA marker or a pseudo-element: the client program mirrors the details element's open state onto the mark as a state class (the browser owns [open]; the state class belongs to the client program — the same split the dispatch button's OnStateClass note establishes), so the register's existing trigger + detent machinery drives the turn with no new trigger vocabulary and no descendant selector. The open detent is the first consumer of the detent model's rotation axis (turn_deg)."

data disclosure_mark_class: String = "disclosure-mark"
data disclosure_open_class: String = "disclosure-open"
data disclosure_mark_glyph: String = "›"

data theme_storage_key: String = "gunbc.theme"
data theme_toggle_class: String = "theme-toggle"
data theme_toggle_auto_value: String = "auto"
data theme_toggle_label_prefix: String = "theme · "

fn theme_toggle_labels() -> List<String> {
  map([theme_toggle_auto_value, day_theme.name, night_theme.name],
    v => join([theme_toggle_label_prefix, v], ""))
}

fn theme_toggle_reserved_width() -> String {
  css_length_wire(l: css_ch(n: dispatch_reserved_ch_for(labels: theme_toggle_labels())))
}

data sound_toggle_class: String = "sound-toggle"

data sound_toggle_note: String = "The mute control, and its whole design is one operator sentence: an instrument can be muted, not argued with. So it is a single persisted boolean with no volume axis, no per-sound settings, and no prompt — the mechanism has one voice and you either hear it or you do not. Default is SOUNDING, because a sound feature shipped off by default is a sound feature nobody discovers, and the sounds here are 5 ms operation ticks rather than notifications.

Both labels are rendered from one authority so the toggle can never disagree with the state it reports, and the reserved width is DERIVED from the longer of them (the same discipline the dispatch button's width uses) so flipping the label cannot reflow the header. Persistence is localStorage rather than a cookie or a server round-trip: the preference is about this browser's speakers, so it belongs to the browser, and a mute that needed the belt to be up would be a mute that failed when the dashboard was most annoying.

The toggle deliberately ticks when it is switched ON and stays silent when switched OFF, which needs no branch — the tick already checks the mute state, so calling it after the flip produces confirmation on unmute and silence on mute. That is the instrument answering with its own voice, which is the only honest way for a sound control to acknowledge itself."

data sound_toggle_label_on: String = "sound · on"
data sound_toggle_label_off: String = "sound · off"

fn sound_toggle_labels() -> List<String> {
  [sound_toggle_label_on, sound_toggle_label_off]
}

fn sound_toggle_reserved_width() -> String {
  css_length_wire(l: css_ch(n: dispatch_reserved_ch_for(labels: sound_toggle_labels())))
}

data sound_muted_storage_value: String = "1"
data sound_sounding_storage_value: String = "0"

data js_sound_muted_fn: String = "gunbcSoundMuted"
data js_audio_context_var: String = "gunbcAudioContext"
data js_tick_fn: String = "gunbcTick"

fn js_local_storage_get(key: String) -> TsExpr {
  ts_call(
    callee: ts_member(object: ts_ident(name: "localStorage"), property: "getItem"),
    args: [ts_lit_str(value: key)],
  )
}

fn js_sound_muted_predicate() -> TsStmt {
  ts_const(
    name: js_sound_muted_fn,
    value: ts_arrow(
      params: [],
      body: ts_expr_stmt(expr: ts_binop(
        left: js_local_storage_get(key: sound_mute_storage_key),
        op: "===",
        right: ts_lit_str(value: sound_muted_storage_value),
      )),
    ),
  )
}

fn js_actx_member(name: String) -> TsExpr {
  ts_member(object: ts_ident(name: js_audio_context_var), property: name)
}

fn js_oscillator_tick_body(s: SoundSpec) -> TsStmt {
  let decay_s = sound_spec_decay_seconds_wire(s: s)
  ts_block(stmts: [
    ts_if(
      cond: ts_call(callee: ts_ident(name: js_sound_muted_fn), args: []),
      then: ts_block(stmts: [ts_return(expr: none)]),
      else_stmt: none,
    ),
    ts_if(
      cond: ts_prefix(op: "!", expr: ts_ident(name: js_audio_context_var)),
      then: ts_block(stmts: [
        ts_expr_stmt(expr: ts_binop(
          left: ts_ident(name: js_audio_context_var),
          op: "=",
          right: ts_new(callee: ts_ident(name: web_audio_context_interface), args: []),
        )),
      ]),
      else_stmt: none,
    ),
    ts_const(name: "play", value: ts_arrow(params: [], body: ts_block(stmts: js_oscillator_schedule_stmts(s: s, decay_s: decay_s)))),
    ts_if(
      cond: ts_binop(left: js_actx_member(name: "state"), op: "===", right: ts_lit_str(value: "running")),
      then: ts_block(stmts: [
        ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "play"), args: [])),
        ts_return(expr: none),
      ]),
      else_stmt: none,
    ),
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(object: ts_call(callee: js_actx_member(name: "resume"), args: []), property: "then"),
      args: [ts_ident(name: "play")],
    )),
  ])
}

fn js_oscillator_schedule_stmts(s: SoundSpec, decay_s: String) -> List<TsStmt> {
  [
    ts_const(name: "t0", value: js_actx_member(name: web_audio_current_time_property)),
    ts_const(name: "osc", value: ts_call(callee: js_actx_member(name: web_audio_create_oscillator_method), args: [])),
    ts_const(name: "amp", value: ts_call(callee: js_actx_member(name: web_audio_create_gain_method), args: [])),
    ts_const(name: "t1", value: ts_binop(left: ts_ident(name: "t0"), op: "+", right: ts_lit_num(text: decay_s))),
    ts_expr_stmt(expr: ts_binop(
      left: ts_member(object: ts_ident(name: "osc"), property: web_audio_type_property),
      op: "=",
      right: ts_lit_str(value: sound_spec_timbre_wire(s: s)),
    )),
    ts_expr_stmt(expr: ts_binop(
      left: ts_member(
        object: ts_member(object: ts_ident(name: "osc"), property: web_audio_frequency_property),
        property: web_audio_value_property,
      ),
      op: "=",
      right: ts_lit_num(text: sound_spec_frequency_wire(s: s)),
    )),
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(
        object: ts_member(object: ts_ident(name: "amp"), property: web_audio_gain_property),
        property: web_audio_set_value_at_time_method,
      ),
      args: [ts_lit_num(text: sound_spec_peak_gain_wire(s: s)), ts_ident(name: "t0")],
    )),
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(
        object: ts_member(object: ts_ident(name: "amp"), property: web_audio_gain_property),
        property: web_audio_exponential_ramp_method,
      ),
      args: [ts_lit_num(text: micros_decimal_wire(micros: web_audio_gain_epsilon_micros)), ts_ident(name: "t1")],
    )),
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(object: ts_ident(name: "osc"), property: web_audio_connect_method),
      args: [ts_ident(name: "amp")],
    )),
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(object: ts_ident(name: "amp"), property: web_audio_connect_method),
      args: [js_actx_member(name: web_audio_destination_property)],
    )),
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(object: ts_ident(name: "osc"), property: web_audio_start_method),
      args: [ts_ident(name: "t0")],
    )),
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(object: ts_ident(name: "osc"), property: web_audio_stop_method),
      args: [ts_ident(name: "t1")],
    )),
  ]
}

data sound_preamble_note: String = "Three statements, in this order for reasons that are not stylistic. The mute predicate comes first because the tick calls it. The AudioContext is a LET initialised to null and constructed lazily inside the tick, not at load: a context created outside a user gesture starts suspended under every browser's autoplay policy, and constructing one per tick would leak a hardware resource per click. The earlier claim that a pointerdown-born context needs no resume dance was measured in Chrome only and did not survive the operator's ears (remodel W1d, A.2): a fresh context can sit suspended with currentTime frozen at 0, so a 5 ms tick scheduled on that clock is silently swallowed — the first press, at least, made no sound. The tick therefore wraps its scheduling in `play` and gates on state: running plays immediately; anything else goes through resume().then(play), which is a no-op cost when the engine was already running and the difference between silence and a first-press tick everywhere else."

fn sound_preamble_statements() -> List<TsStmt> {
  [
    js_sound_muted_predicate(),
    ts_let(name: js_audio_context_var, value: ts_ident(name: "null")),
    ts_const(
      name: js_tick_fn,
      value: ts_arrow(
        params: [],
        body: js_oscillator_tick_body(s: engage_detent_click),
      ),
    ),
  ]
}

data sound_toggle_program_note: String = "The toggle paints itself from the same predicate the tick reads, then repaints after each flip, so the label is a projection of the stored state rather than a second copy of it — a toggle whose label and behaviour can disagree is worse than no toggle. paint() runs once at bind time because the stored preference outlives the page: on load the label must already say what this browser will actually do."

fn sound_toggle_bind_statements() -> List<TsStmt> {
  [
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(
        object: ts_call(
          callee: ts_member(object: ts_ident(name: "document"), property: "querySelectorAll"),
          args: [ts_lit_str(value: join([".", sound_toggle_class], ""))],
        ),
        property: "forEach",
      ),
      args: [ts_arrow(params: ["t"], body: ts_block(stmts: [
        ts_const(name: "paint", value: ts_arrow(params: [], body: ts_expr_stmt(expr: ts_binop(
          left: ts_member(object: ts_ident(name: "t"), property: "textContent"),
          op: "=",
          right: ts_cond(
            test: ts_call(callee: ts_ident(name: js_sound_muted_fn), args: []),
            consequent: ts_lit_str(value: sound_toggle_label_off),
            alternate: ts_lit_str(value: sound_toggle_label_on),
          ),
        )))),
        ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "paint"), args: [])),
        ts_expr_stmt(expr: ts_call(
          callee: ts_member(object: ts_ident(name: "t"), property: "addEventListener"),
          args: [ts_lit_str(value: "click"), ts_arrow(params: [], body: ts_block(stmts: [
            ts_expr_stmt(expr: ts_call(
              callee: ts_member(object: ts_ident(name: "localStorage"), property: "setItem"),
              args: [
                ts_lit_str(value: sound_mute_storage_key),
                ts_cond(
                  test: ts_call(callee: ts_ident(name: js_sound_muted_fn), args: []),
                  consequent: ts_lit_str(value: sound_sounding_storage_value),
                  alternate: ts_lit_str(value: sound_muted_storage_value),
                ),
              ],
            )),
            ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "paint"), args: [])),
            ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_tick_fn), args: [])),
          ]))],
        )),
      ]))],
    )),
  ]
}

data dispatch_state_class_note: String = "The single authority for a state's CSS modifier class, consumed by the client script (which flips classes on the live button), the stylesheet (which paints each class through the state's role material), and the P4 gallery (which renders each state statically) — three consumers, one class vocabulary, so the live button and the gallery cannot disagree. idle is the base (no modifier); the terminals collapse to their ok/refusal MATERIAL group (figure vs boundary), the per-label distinction living in the text, not the color."

fn dispatch_state_class(state: ComponentState) -> String {
  match state.kind {
    IdleState => ""
    RequestedState => dispatch_class_requested
    TerminalState { wire_label: wl, ok: ok } =>
      if ok {
        dispatch_class_ok
      } else if belt_dispatch_label_band_key(wire_label: wl) == "loud" {
        join([dispatch_class_refused, " ", dispatch_class_loud], "")
      } else {
        dispatch_class_refused
      }
  }
}

data dispatch_client_program_note: String = "The dispatch button's client behavior, modeled in native .dag as ONE TsProgram (extdeps.languages.typescript.program) — never a hand-concatenated JS string (the dispatch-button incident's root class, §5). It is EMITTED as an external served asset (gunbc.roadmap_dispatch_asset_path, served by belt B) and referenced by <script src>, the same shape gunbc.site.moodboard uses for reframe_watcher_js — NOT inlined into the HTML (an inline <script> text node escapes '>' under std.markup EscapeHtml, corrupting an arrow's `=>`; external emission has no such hazard, so arrows are free). The ok-predicate is a ts_binop `||` chain DERIVED from belt_dispatch_ok_status_labels (the wire authority), so a label crossing the ok/refusal line moves the predicate by derivation — the retired belt-A ok/node read is gone and cannot return (the page witness holds a RED on j.ok)."

data roadmap_dispatch_asset_path: String = "/assets/roadmap-dispatch.js"

data sandbox_asset_path: String = "/assets/sandbox.js"

fn js_b_member(name: String) -> TsExpr {
  ts_member(object: ts_ident(name: "b"), property: name)
}

fn js_j_status() -> TsExpr {
  ts_member(object: ts_ident(name: "j"), property: "status")
}

fn js_j_member(name: String) -> TsExpr {
  ts_member(object: ts_ident(name: "j"), property: name)
}

fn js_classlist_call(method: String, arg: TsExpr) -> TsStmt {
  ts_expr_stmt(expr: ts_call(
    callee: ts_member(object: ts_member(object: ts_ident(name: "b"), property: "classList"), property: method),
    args: [arg],
  ))
}

fn dispatch_ok_status_comparison(wire_label: String) -> TsExpr {
  ts_binop(left: js_j_status(), op: "===", right: ts_lit_str(value: wire_label))
}

fn dispatch_or_chain(exprs: List<TsExpr>) -> TsExpr {
  let acc = fold(exprs, init: none, f: (a, c) => match a {
    Absent => Present { value: c }
    Present { value: prev } => Present { value: ts_binop(left: prev, op: "||", right: c) }
  })
  match acc {
    Present { value: e } => e
    Absent => ts_ident(name: "false")
  }
}

fn dispatch_ok_predicate_expr() -> TsExpr {
  dispatch_or_chain(exprs: map(belt_dispatch_ok_status_labels(), l => dispatch_ok_status_comparison(wire_label: l)))
}

fn dispatch_fetch_url_expr() -> TsExpr {
  ts_binop(
    left: ts_lit_str(value: belt_dispatch_path_prefix),
    op: "+",
    right: ts_call(
      callee: ts_ident(name: "encodeURIComponent"),
      args: [ts_call(callee: js_b_member(name: "getAttribute"), args: [ts_lit_str(value: "data-node")])],
    ),
  )
}

data dispatch_choreography_note: String = "The presented-state choreography (remodel W1d, operator ruling 2026-07-24: transitions are sugar over the data layer). The DATA layer applies the wire answer the moment it arrives — b.dataset.status lands immediately, nothing about the operation waits. The PRESENTATION holds the requested phase for at least the read dwell (dispatch_requested_read_dwell_ms — a reading duration with its own authority row, never a borrowed transition clock) and then applies the terminal render: setTimeout(apply, max(0, t0 + dwell - now)), so a 1 ms echo appears as a deliberate act and a 30 s belt answer appears the moment it lands. Presentation never fabricates a state that did not occur — apply renders exactly the answer stored on the data layer, later, never a different one. The terminal caption is the BAND's phrase (dispatch_caption_note); the wire label and located fields live in the title channel; the loud band additionally marks dispatch_class_loud so the stylesheet and any detail affordance can key on it."

data dispatch_requested_read_dwell_note: String = "The requested phase's minimum presentation is a READING duration, not a transition clock (operator ruling 2026-07-24: 160 ms — the first cut borrowed reveal_deliberate — was too short to actually read 'dispatching...'; a dwell exists so the caption is USEFUL, so it is priced in reading time). It is deliberately its own authority row rather than a retune of a shared TimingToken: the hover reveal and this hold are different concepts that happened to share a number for one commit, and retuning the shared token would have made every hover a half-second. Operator-tuned twice: 500 ms first (readable), then 300 ms (2026-07-24 — readable AND quick). The deeper direction is filed as the motion-modeling follow-up: a single long hold is the wrong shape — the requested phase wants MOVING PARTS (the Discord-mute reference: the state lands fast, the motion continues to hold attention), i.e. phase-structured choreography rows, not one dwell scalar. This row survives until that session replaces it."

data dispatch_requested_read_dwell_ms: Int = 300

data js_dwell_const: String = "gunbcDwellMs"

fn dispatch_preamble_statements() -> List<TsStmt> {
  [ts_const(name: js_dwell_const, value: ts_lit_num(text: to_string(dispatch_requested_read_dwell_ms)))]
}

fn dwell_remaining_expr() -> TsExpr {
  ts_call(
    callee: ts_member(object: ts_ident(name: "Math"), property: "max"),
    args: [
      ts_lit_num(text: "0"),
      ts_binop(
        left: ts_binop(left: ts_ident(name: "t0"), op: "+", right: ts_ident(name: js_dwell_const)),
        op: "-",
        right: ts_call(callee: ts_member(object: ts_ident(name: "Date"), property: "now"), args: []),
      ),
    ],
  )
}

fn dispatch_band_chain_expr() -> TsExpr {
  fold(belt_dispatch_label_band_rows(), init: ts_lit_str(value: "loud"), f: (acc, row) =>
    ts_cond(
      test: ts_binop(left: ts_ident(name: "s"), op: "===", right: ts_lit_str(value: row.wire_label)),
      consequent: ts_lit_str(value: row.band_key),
      alternate: acc,
    ))
}

data dispatch_expand_chain_note: String = "The client grain of the attention law (composition slice 3): which terminal bands auto-expand the row's disclosure is DERIVED — the distinct band keys of the wire-band rows filtered through gunbc.roadmap_altitude.band_expands (anomaly expands; routine and working never do) — so the emitted predicate `(band === \"fail\") || (band === \"loud\")` moves when either authority moves and no band name is hand-chosen at the emit site. The fold seeds `false`, which serializes as a visible leading arm rather than a fabricated default."

fn key_present(keys: List<String>, key: String) -> Bool {
  fold(keys, init: false, f: (acc, k) => acc || k == key)
}

fn dispatch_expand_band_keys() -> List<String> {
  fold(belt_dispatch_label_band_rows(), init: [], f: (acc, row) =>
    if band_expands(band_key: row.band_key) && !key_present(keys: acc, key: row.band_key) {
      concat(acc, [row.band_key])
    } else {
      acc
    })
}

fn dispatch_expand_chain_expr() -> TsExpr {
  fold(dispatch_expand_band_keys(), init: ts_ident(name: "false"), f: (acc, k) =>
    ts_binop(
      left: acc,
      op: "||",
      right: ts_binop(left: ts_ident(name: "band"), op: "===", right: ts_lit_str(value: k))))
}

fn dispatch_terminal_apply_body() -> TsStmt {
  ts_block(stmts: [
    ts_const(name: "s", value: ts_binop(left: js_j_status(), op: "||", right: ts_lit_str(value: ""))),
    ts_const(name: "band", value: dispatch_band_chain_expr()),
    ts_const(name: "ok", value: ts_binop(left: ts_ident(name: "band"), op: "===", right: ts_lit_str(value: "ok"))),
    ts_expr_stmt(expr: ts_binop(
      left: js_b_member(name: "textContent"),
      op: "=",
      right: ts_cond(
        test: ts_ident(name: "ok"),
        consequent: ts_lit_str(value: concat(dispatch_ack_prefix, dispatch_ack_word)),
        alternate: ts_cond(
          test: ts_binop(left: ts_ident(name: "band"), op: "===", right: ts_lit_str(value: "fail")),
          consequent: ts_lit_str(value: dispatch_caption_fail),
          alternate: ts_lit_str(value: dispatch_caption_loud),
        ),
      ),
    )),
    js_classlist_call(method: "remove", arg: ts_lit_str(value: dispatch_class_requested)),
    js_classlist_call(method: "remove", arg: ts_lit_str(value: dispatch_class_ok)),
    js_classlist_call(method: "remove", arg: ts_lit_str(value: dispatch_class_refused)),
    js_classlist_call(method: "remove", arg: ts_lit_str(value: dispatch_class_loud)),
    js_classlist_call(method: "add", arg: ts_cond(
      test: ts_ident(name: "ok"),
      consequent: ts_lit_str(value: dispatch_class_ok),
      alternate: ts_lit_str(value: dispatch_class_refused),
    )),
    ts_if(
      cond: ts_binop(left: ts_ident(name: "band"), op: "===", right: ts_lit_str(value: "loud")),
      then: ts_block(stmts: [
        js_classlist_call(method: "add", arg: ts_lit_str(value: dispatch_class_loud)),
      ]),
      else_stmt: none,
    ),
    ts_const(name: "d", value: ts_binop(left: js_j_member(name: "detail"), op: "||", right: ts_lit_str(value: ""))),
    ts_const(name: "why", value: ts_cond(
      test: js_j_member(name: "step"),
      consequent: ts_binop(
        left: ts_binop(left: js_j_member(name: "step"), op: "+", right: ts_lit_str(value: ": ")),
        op: "+",
        right: ts_ident(name: "d"),
      ),
      alternate: ts_binop(left: js_j_member(name: "reason"), op: "||", right: ts_lit_str(value: "")),
    )),
    ts_const(name: "base", value: ts_binop(left: ts_ident(name: "s"), op: "||", right: ts_lit_str(value: "no status"))),
    ts_expr_stmt(expr: ts_binop(
      left: js_b_member(name: "title"),
      op: "=",
      right: ts_cond(
        test: ts_ident(name: "why"),
        consequent: ts_binop(
          left: ts_binop(left: ts_ident(name: "base"), op: "+", right: ts_lit_str(value: " — ")),
          op: "+",
          right: ts_ident(name: "why"),
        ),
        alternate: ts_ident(name: "base"),
      ),
    )),
    ts_const(name: "expandRow", value: dispatch_expand_chain_expr()),
    ts_const(name: "rowEl", value: ts_call(callee: js_b_member(name: "closest"), args: [ts_lit_str(value: "li")])),
    ts_const(name: "dt", value: ts_binop(
      left: ts_ident(name: "rowEl"),
      op: "&&",
      right: ts_call(
        callee: ts_member(object: ts_ident(name: "rowEl"), property: "querySelector"),
        args: [ts_lit_str(value: "details.item-detail")]),
    )),
    ts_if(
      cond: ts_binop(left: ts_ident(name: "expandRow"), op: "&&", right: ts_ident(name: "dt")),
      then: ts_block(stmts: [
        ts_expr_stmt(expr: ts_binop(
          left: ts_member(object: ts_ident(name: "dt"), property: "open"),
          op: "=",
          right: ts_ident(name: "true"))),
      ]),
      else_stmt: none,
    ),
    ts_if(
      cond: ts_binop(
        left: ts_binop(left: ts_ident(name: "band"), op: "===", right: ts_lit_str(value: "loud")),
        op: "&&",
        right: ts_ident(name: "dt")),
      then: ts_block(stmts: [
        ts_let(name: "rl", value: ts_call(
          callee: ts_member(object: ts_ident(name: "dt"), property: "querySelector"),
          args: [ts_lit_str(value: ".disclosure-reason")])),
        ts_if(
          cond: ts_prefix(op: "!", expr: ts_ident(name: "rl")),
          then: ts_block(stmts: [
            ts_expr_stmt(expr: ts_binop(
              left: ts_ident(name: "rl"),
              op: "=",
              right: ts_call(
                callee: ts_member(object: ts_ident(name: "document"), property: "createElement"),
                args: [ts_lit_str(value: "div")]))),
            ts_expr_stmt(expr: ts_binop(
              left: ts_member(object: ts_ident(name: "rl"), property: "className"),
              op: "=",
              right: ts_lit_str(value: "disclosure-reason"))),
            ts_const(name: "sm", value: ts_call(
              callee: ts_member(object: ts_ident(name: "dt"), property: "querySelector"),
              args: [ts_lit_str(value: "summary")])),
            ts_expr_stmt(expr: ts_binop(
              left: ts_ident(name: "sm"),
              op: "&&",
              right: ts_call(
                callee: ts_member(object: ts_ident(name: "sm"), property: "insertAdjacentElement"),
                args: [ts_lit_str(value: "afterend"), ts_ident(name: "rl")]))),
          ]),
          else_stmt: none,
        ),
        ts_expr_stmt(expr: ts_binop(
          left: ts_member(object: ts_ident(name: "rl"), property: "textContent"),
          op: "=",
          right: ts_binop(
            left: ts_ident(name: "why"),
            op: "||",
            right: ts_lit_str(value: "belt fault — no located reason on the wire")))),
      ]),
      else_stmt: none,
    ),
    ts_if(
      cond: ts_prefix(op: "!", expr: ts_ident(name: "ok")),
      then: ts_block(stmts: [
        ts_expr_stmt(expr: ts_call(
          callee: ts_member(object: ts_ident(name: "console"), property: "log"),
          args: [ts_lit_str(value: "dispatch refused"), ts_ident(name: "j")],
        )),
      ]),
      else_stmt: none,
    ),
    ts_if(
      cond: ts_ident(name: "ok"),
      then: ts_block(stmts: [
        ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_sessions_observe_fn), args: [])),
        ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_attempts_observe_fn), args: [])),
      ]),
      else_stmt: none,
    ),
    ts_expr_stmt(expr: ts_binop(left: js_b_member(name: "disabled"), op: "=", right: ts_ident(name: "false"))),
  ])
}

fn dispatch_response_handler_body() -> TsStmt {
  ts_block(stmts: [
    ts_expr_stmt(expr: ts_binop(
      left: ts_member(object: js_b_member(name: "dataset"), property: "status"),
      op: "=",
      right: ts_binop(left: js_j_status(), op: "||", right: ts_lit_str(value: "")),
    )),
    ts_const(name: "apply", value: ts_arrow(params: [], body: dispatch_terminal_apply_body())),
    ts_expr_stmt(expr: ts_call(
      callee: ts_ident(name: "setTimeout"),
      args: [ts_ident(name: "apply"), dwell_remaining_expr()],
    )),
  ])
}

fn dispatch_click_handler_body(url_expr: TsExpr) -> TsStmt {
  ts_block(stmts: [
    ts_expr_stmt(expr: ts_binop(left: js_b_member(name: "disabled"), op: "=", right: ts_ident(name: "true"))),
    ts_const(name: "t0", value: ts_call(callee: ts_member(object: ts_ident(name: "Date"), property: "now"), args: [])),
    ts_expr_stmt(expr: ts_binop(left: js_b_member(name: "textContent"), op: "=", right: ts_lit_str(value: dispatch_caption_requested))),
    js_classlist_call(method: "remove", arg: ts_lit_str(value: dispatch_class_ok)),
    js_classlist_call(method: "remove", arg: ts_lit_str(value: dispatch_class_refused)),
    js_classlist_call(method: "remove", arg: ts_lit_str(value: dispatch_class_loud)),
    js_classlist_call(method: "add", arg: ts_lit_str(value: dispatch_class_requested)),
    ts_expr_stmt(expr: ts_binop(left: js_b_member(name: "title"), op: "=", right: ts_lit_str(value: ""))),
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(
        object: ts_call(
          callee: ts_member(
            object: ts_call(
              callee: ts_member(
                object: ts_call(
                  callee: ts_ident(name: "fetch"),
                  args: [url_expr, ts_object(fields: [ts_field(key: "method", value: ts_lit_str(value: "POST"))])],
                ),
                property: "then",
              ),
              args: [ts_arrow(params: ["r"], body: ts_expr_stmt(expr: ts_call(callee: ts_member(object: ts_ident(name: "r"), property: "json"), args: [])))],
            ),
            property: "then",
          ),
          args: [ts_arrow(params: ["j"], body: dispatch_response_handler_body())],
        ),
        property: "catch",
      ),
      args: [ts_arrow(params: ["e"], body: ts_block(stmts: [
        ts_const(name: "applyErr", value: ts_arrow(params: [], body: ts_block(stmts: [
          ts_expr_stmt(expr: ts_binop(left: js_b_member(name: "textContent"), op: "=", right: ts_lit_str(value: dispatch_caption_loud))),
          js_classlist_call(method: "remove", arg: ts_lit_str(value: dispatch_class_requested)),
          js_classlist_call(method: "add", arg: ts_lit_str(value: dispatch_class_refused)),
          js_classlist_call(method: "add", arg: ts_lit_str(value: dispatch_class_loud)),
          ts_expr_stmt(expr: ts_binop(left: js_b_member(name: "title"), op: "=", right: ts_lit_str(value: "network error"))),
          ts_expr_stmt(expr: ts_binop(left: js_b_member(name: "disabled"), op: "=", right: ts_ident(name: "false"))),
        ]))),
        ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "setTimeout"), args: [ts_ident(name: "applyErr"), dwell_remaining_expr()])),
      ]))],
    )),
  ])
}

data pointerdown_tick_isolation_note: String = "The tick rides its OWN pointerdown listener rather than living inside the click handler, and the separation is load-bearing in two independent ways.

MECHANICALLY it is when the sound belongs. Acknowledgment is owed to the press, not the release — the video-game rule the whole register follows — and pointerdown is the event that fires as the control starts travelling, in the same frame the CSS :active depression begins. Putting the tick in the click handler would fire it on RELEASE, so the sound and the visible travel would disagree about when the mechanism engaged.

SAFETY-WISE it means a sound failure cannot break dispatch. Two listeners on one element are independent: if WebAudio is unavailable or throws in some browser, the exception is contained in the tick listener and the click listener still POSTs. Had the tick been a statement inside the click handler, a throw would have aborted the dispatch before the fetch — trading a working button for a decorative noise, which is exactly the wrong direction. This is also why no capability probe or try/catch appears here: the isolation makes the failure harmless, so there is nothing to degrade gracefully around and no silent fallback to write."

fn dispatch_bind_statements(selector: String, url_expr: TsExpr) -> List<TsStmt> {
  [
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(
        object: ts_call(
          callee: ts_member(object: ts_ident(name: "document"), property: "querySelectorAll"),
          args: [ts_lit_str(value: selector)],
        ),
        property: "forEach",
      ),
      args: [ts_arrow(params: ["b"], body: ts_block(stmts: [
        ts_expr_stmt(expr: ts_call(
          callee: js_b_member(name: "addEventListener"),
          args: [
            ts_lit_str(value: "pointerdown"),
            ts_arrow(params: [], body: ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_tick_fn), args: []))),
          ],
        )),
        ts_expr_stmt(expr: ts_call(
          callee: js_b_member(name: "addEventListener"),
          args: [ts_lit_str(value: "click"), ts_arrow(params: [], body: dispatch_click_handler_body(url_expr: url_expr))],
        )),
      ]))],
    )),
  ]
}

data swatch_toggle_note: String = "The auditioner control (remodel W1f): cycles the active swatch set island-pastel -> okabe-ito -> solarized -> island-pastel, persisted like the mute because a palette audition is a property of these eyes. island is the ABSENT attribute (the emitted default); a named set pins data-swatch-set, which the audition blocks in roadmap_style answer. Rendered only on /sandbox (the design surface owns auditioning) but applied by the shared client program on load, so a choice made in the sandbox follows the operator to the live roadmap — auditioning against real content, not specimens."

data swatch_storage_key: String = "gunbc.swatch-set"
data swatch_toggle_class: String = "swatch-toggle"
data swatch_default_set_value: String = "okabe-ito"
data swatch_audition_a: String = "island-pastel"
data swatch_audition_b: String = "solarized"
data swatch_audition_values: List<String> = [swatch_audition_a, swatch_audition_b]
data swatch_toggle_label_prefix: String = "swatches · "

fn swatch_toggle_labels() -> List<String> {
  map(concat([swatch_default_set_value], swatch_audition_values),
    v => join([swatch_toggle_label_prefix, v], ""))
}

fn swatch_toggle_reserved_width() -> String {
  css_length_wire(l: css_ch(n: dispatch_reserved_ch_for(labels: swatch_toggle_labels())))
}

data js_theme_choice_fn: String = "gunbcThemeChoice"
data js_theme_apply_fn: String = "gunbcApplyTheme"

fn js_document_element() -> TsExpr {
  ts_member(object: ts_ident(name: "document"), property: "documentElement")
}

fn theme_toggle_bind_statements() -> List<TsStmt> {
  [
    ts_const(name: js_theme_choice_fn, value: ts_arrow(params: [], body: ts_expr_stmt(expr: ts_binop(
      left: js_local_storage_get(key: theme_storage_key),
      op: "||",
      right: ts_lit_str(value: theme_toggle_auto_value))))),
    ts_const(name: js_theme_apply_fn, value: ts_arrow(params: [], body: ts_block(stmts: [
      ts_const(name: "t", value: ts_call(callee: ts_ident(name: js_theme_choice_fn), args: [])),
      ts_if(
        cond: ts_binop(left: ts_ident(name: "t"), op: "===", right: ts_lit_str(value: theme_toggle_auto_value)),
        then: ts_block(stmts: [
          ts_expr_stmt(expr: ts_call(
            callee: ts_member(object: js_document_element(), property: "removeAttribute"),
            args: [ts_lit_str(value: "data-theme")],
          )),
          ts_return(expr: none),
        ]),
        else_stmt: none,
      ),
      ts_expr_stmt(expr: ts_call(
        callee: ts_member(object: js_document_element(), property: "setAttribute"),
        args: [ts_lit_str(value: "data-theme"), ts_ident(name: "t")],
      )),
    ]))),
    ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_theme_apply_fn), args: [])),
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(
        object: ts_call(
          callee: ts_member(object: ts_ident(name: "document"), property: "querySelectorAll"),
          args: [ts_lit_str(value: join([".", theme_toggle_class], ""))],
        ),
        property: "forEach",
      ),
      args: [ts_arrow(params: ["t"], body: ts_block(stmts: [
        ts_const(name: "paint", value: ts_arrow(params: [], body: ts_expr_stmt(expr: ts_binop(
          left: ts_member(object: ts_ident(name: "t"), property: "textContent"),
          op: "=",
          right: ts_binop(
            left: ts_lit_str(value: theme_toggle_label_prefix),
            op: "+",
            right: ts_call(callee: ts_ident(name: js_theme_choice_fn), args: []),
          ),
        )))),
        ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "paint"), args: [])),
        ts_expr_stmt(expr: ts_call(
          callee: ts_member(object: ts_ident(name: "t"), property: "addEventListener"),
          args: [ts_lit_str(value: "click"), ts_arrow(params: [], body: ts_block(stmts: [
            ts_const(name: "cur", value: ts_call(callee: ts_ident(name: js_theme_choice_fn), args: [])),
            ts_const(name: "next", value: ts_cond(
              test: ts_binop(left: ts_ident(name: "cur"), op: "===", right: ts_lit_str(value: theme_toggle_auto_value)),
              consequent: ts_lit_str(value: day_theme.name),
              alternate: ts_cond(
                test: ts_binop(left: ts_ident(name: "cur"), op: "===", right: ts_lit_str(value: day_theme.name)),
                consequent: ts_lit_str(value: night_theme.name),
                alternate: ts_lit_str(value: theme_toggle_auto_value),
              ),
            )),
            ts_if(
              cond: ts_binop(left: ts_ident(name: "next"), op: "===", right: ts_lit_str(value: theme_toggle_auto_value)),
              then: ts_block(stmts: [
                ts_expr_stmt(expr: ts_call(
                  callee: ts_member(object: ts_ident(name: "localStorage"), property: "removeItem"),
                  args: [ts_lit_str(value: theme_storage_key)],
                )),
              ]),
              else_stmt: none,
            ),
            ts_if(
              cond: ts_binop(left: ts_ident(name: "next"), op: "!==", right: ts_lit_str(value: theme_toggle_auto_value)),
              then: ts_block(stmts: [
                ts_expr_stmt(expr: ts_call(
                  callee: ts_member(object: ts_ident(name: "localStorage"), property: "setItem"),
                  args: [ts_lit_str(value: theme_storage_key), ts_ident(name: "next")],
                )),
              ]),
              else_stmt: none,
            ),
            ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_theme_apply_fn), args: [])),
            ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "paint"), args: [])),
          ]))],
        )),
      ]))],
    )),
  ]
}

fn disclosure_bind_statements() -> List<TsStmt> {
  [
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(
        object: ts_call(
          callee: ts_member(object: ts_ident(name: "document"), property: "querySelectorAll"),
          args: [ts_lit_str(value: "details.item-detail")],
        ),
        property: "forEach",
      ),
      args: [ts_arrow(params: ["d"], body: ts_block(stmts: [
        ts_const(name: "m", value: ts_call(
          callee: ts_member(object: ts_ident(name: "d"), property: "querySelector"),
          args: [ts_lit_str(value: join([".", disclosure_mark_class], ""))],
        )),
        ts_if(
          cond: ts_prefix(op: "!", expr: ts_ident(name: "m")),
          then: ts_block(stmts: [ts_return(expr: none)]),
          else_stmt: none,
        ),
        ts_const(name: "paint", value: ts_arrow(params: [], body: ts_expr_stmt(expr: ts_call(
          callee: ts_member(object: ts_member(object: ts_ident(name: "m"), property: "classList"), property: "toggle"),
          args: [ts_lit_str(value: disclosure_open_class), ts_member(object: ts_ident(name: "d"), property: "open")],
        )))),
        ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "paint"), args: [])),
        ts_expr_stmt(expr: ts_call(
          callee: ts_member(object: ts_ident(name: "d"), property: "addEventListener"),
          args: [ts_lit_str(value: "toggle"), ts_ident(name: "paint")],
        )),
      ]))],
    )),
  ]
}

fn swatch_toggle_bind_statements() -> List<TsStmt> {
  [
    ts_const(name: "gunbcSwatchChoice", value: ts_arrow(params: [], body: ts_expr_stmt(expr: ts_binop(
      left: js_local_storage_get(key: swatch_storage_key),
      op: "||",
      right: ts_lit_str(value: swatch_default_set_value))))),
    ts_const(name: "gunbcApplySwatch", value: ts_arrow(params: [], body: ts_block(stmts: [
      ts_const(name: "t", value: ts_call(callee: ts_ident(name: "gunbcSwatchChoice"), args: [])),
      ts_if(
        cond: ts_binop(left: ts_ident(name: "t"), op: "===", right: ts_lit_str(value: swatch_default_set_value)),
        then: ts_block(stmts: [
          ts_expr_stmt(expr: ts_call(
            callee: ts_member(object: js_document_element(), property: "removeAttribute"),
            args: [ts_lit_str(value: "data-swatch-set")],
          )),
          ts_return(expr: none),
        ]),
        else_stmt: none,
      ),
      ts_expr_stmt(expr: ts_call(
        callee: ts_member(object: js_document_element(), property: "setAttribute"),
        args: [ts_lit_str(value: "data-swatch-set"), ts_ident(name: "t")],
      )),
    ]))),
    ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "gunbcApplySwatch"), args: [])),
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(
        object: ts_call(
          callee: ts_member(object: ts_ident(name: "document"), property: "querySelectorAll"),
          args: [ts_lit_str(value: join([".", swatch_toggle_class], ""))],
        ),
        property: "forEach",
      ),
      args: [ts_arrow(params: ["t"], body: ts_block(stmts: [
        ts_const(name: "paint", value: ts_arrow(params: [], body: ts_expr_stmt(expr: ts_binop(
          left: ts_member(object: ts_ident(name: "t"), property: "textContent"),
          op: "=",
          right: ts_binop(
            left: ts_lit_str(value: swatch_toggle_label_prefix),
            op: "+",
            right: ts_call(callee: ts_ident(name: "gunbcSwatchChoice"), args: []),
          ),
        )))),
        ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "paint"), args: [])),
        ts_expr_stmt(expr: ts_call(
          callee: ts_member(object: ts_ident(name: "t"), property: "addEventListener"),
          args: [ts_lit_str(value: "click"), ts_arrow(params: [], body: ts_block(stmts: [
            ts_const(name: "cur", value: ts_call(callee: ts_ident(name: "gunbcSwatchChoice"), args: [])),
            ts_const(name: "next", value: ts_cond(
              test: ts_binop(left: ts_ident(name: "cur"), op: "===", right: ts_lit_str(value: swatch_default_set_value)),
              consequent: ts_lit_str(value: swatch_audition_a),
              alternate: ts_cond(
                test: ts_binop(left: ts_ident(name: "cur"), op: "===", right: ts_lit_str(value: swatch_audition_a)),
                consequent: ts_lit_str(value: swatch_audition_b),
                alternate: ts_lit_str(value: swatch_default_set_value),
              ),
            )),
            ts_if(
              cond: ts_binop(left: ts_ident(name: "next"), op: "===", right: ts_lit_str(value: swatch_default_set_value)),
              then: ts_block(stmts: [
                ts_expr_stmt(expr: ts_call(
                  callee: ts_member(object: ts_ident(name: "localStorage"), property: "removeItem"),
                  args: [ts_lit_str(value: swatch_storage_key)],
                )),
              ]),
              else_stmt: none,
            ),
            ts_if(
              cond: ts_binop(left: ts_ident(name: "next"), op: "!==", right: ts_lit_str(value: swatch_default_set_value)),
              then: ts_block(stmts: [
                ts_expr_stmt(expr: ts_call(
                  callee: ts_member(object: ts_ident(name: "localStorage"), property: "setItem"),
                  args: [ts_lit_str(value: swatch_storage_key), ts_ident(name: "next")],
                )),
              ]),
              else_stmt: none,
            ),
            ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "gunbcApplySwatch"), args: [])),
            ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "paint"), args: [])),
          ]))],
        )),
      ]))],
    )),
  ]
}

data js_set_client_observation_fn: String = "gunbcSetClientObservation"

fn workflow_lamp_selector(lamp: WorkflowLamp) -> String {
  join([
    "[", workflow_lamp_data_attribute, "=\"",
    workflow_lamp_key(lamp: lamp),
    "\"]",
  ], "")
}

fn workflow_row_selector_expr(node_id: TsExpr) -> TsExpr {
  ts_binop(
    left: ts_binop(
      left: ts_lit_str(value: "li[data-node=\""),
      op: "+",
      right: node_id),
    op: "+",
    right: ts_lit_str(value: "\"]"))
}

fn workflow_lamp_in_row_expr(row_name: String, lamp: WorkflowLamp) -> TsExpr {
  ts_binop(
    left: ts_ident(name: row_name),
    op: "&&",
    right: ts_call(
      callee: ts_member(object: ts_ident(name: row_name), property: "querySelector"),
      args: [ts_lit_str(value: workflow_lamp_selector(lamp: lamp))]))
}

fn workflow_observation_key(state: ClientObservationState) -> String {
  client_observation_state_key(state: state)
}

fn workflow_set_observation_call(
  lamp_expr: TsExpr,
  state: ClientObservationState,
  reason_expr: TsExpr,
) -> TsStmt {
  ts_expr_stmt(expr: ts_call(
    callee: ts_ident(name: js_set_client_observation_fn),
    args: [
      lamp_expr,
      ts_lit_str(value: workflow_observation_key(state: state)),
      reason_expr,
    ]))
}

fn workflow_set_all_observations_stmt(
  lamp: WorkflowLamp,
  state: ClientObservationState,
  reason_expr: TsExpr,
) -> TsStmt {
  ts_expr_stmt(expr: ts_call(
    callee: ts_member(
      object: ts_call(
        callee: ts_member(object: ts_ident(name: "document"), property: "querySelectorAll"),
        args: [ts_lit_str(value: workflow_lamp_selector(lamp: lamp))]),
      property: "forEach"),
    args: [ts_arrow(params: ["lamp"], body: workflow_set_observation_call(
      lamp_expr: ts_ident(name: "lamp"),
      state: state,
      reason_expr: reason_expr))]))
}

fn workflow_observation_preamble_statements() -> List<TsStmt> {
  [
    ts_const(name: js_set_client_observation_fn, value: ts_arrow(
      params: ["lamp", "state", "reason"],
      body: ts_block(stmts: [
        ts_if(
          cond: ts_ident(name: "lamp"),
          then: ts_block(stmts: [
            ts_expr_stmt(expr: ts_binop(
              left: ts_member(
                object: ts_member(object: ts_ident(name: "lamp"), property: "dataset"),
                property: "observation"),
              op: "=",
              right: ts_ident(name: "state"))),
            ts_expr_stmt(expr: ts_binop(
              left: ts_member(object: ts_ident(name: "lamp"), property: "title"),
              op: "=",
              right: ts_binop(
                left: ts_ident(name: "reason"),
                op: "||",
                right: ts_lit_str(value: "")))),
            ts_const(name: "stateLabel", value: ts_cond(
              test: ts_ident(name: "reason"),
              consequent: ts_binop(
                left: ts_binop(
                  left: ts_ident(name: "state"),
                  op: "+",
                  right: ts_lit_str(value: ": ")),
                op: "+",
                right: ts_ident(name: "reason")),
              alternate: ts_ident(name: "state"))),
            ts_expr_stmt(expr: ts_call(
              callee: ts_member(object: ts_ident(name: "lamp"), property: "setAttribute"),
              args: [
                ts_lit_str(value: "aria-label"),
                ts_binop(
                  left: ts_binop(
                    left: ts_member(
                      object: ts_member(object: ts_ident(name: "lamp"), property: "dataset"),
                      property: "label"),
                    op: "+",
                    right: ts_lit_str(value: ": ")),
                  op: "+",
                  right: ts_ident(name: "stateLabel")),
              ])),
          ]),
          else_stmt: none),
      ]))),
  ]
}

data sessions_panel_note: String = "U2 plus workflow lamps v0, corrected for lifecycle truth: one named observer per endpoint runs at load, immediately after an accepted dispatch, and on the modeled poll cadence while the page is open. Each observation recomputes its own axis; neither endpoint can suppress the other. /sessions.json proves tmux/process presence only, so it renders `session · present` plus the provider/readiness evidence carried by the wire, never `live` as agent execution. Refusal resolves every Live lamp to Refused and inserts a source-specific loud banner — unknowable never rounds to Off."

data js_sessions_observe_fn: String = "gunbcObserveSessions"
data js_attempts_observe_fn: String = "gunbcObserveAttempts"
data js_sessions_observe_in_flight: String = "gunbcSessionsObservationInFlight"
data js_attempts_observe_in_flight: String = "gunbcAttemptsObservationInFlight"
data js_sessions_observe_pending: String = "gunbcSessionsObservationPending"
data js_attempts_observe_pending: String = "gunbcAttemptsObservationPending"
data observation_poll_interval: Millisecond = millisecond(count: 3000)
data observation_poll_note: String = "The page has no typed terminal-attempt observation yet, so it cannot honestly decide that an attempt is terminal and stop polling. It therefore re-observes both independent sources for the page lifetime at one explicit cadence; page unload cancels the browser timer. Each source permits one request in flight and coalesces overlapping timer or post-dispatch observations into one pending rerun, so an older response cannot repaint over a newer one. This dissolves into terminal-bounded polling when AttemptEvidence.terminal_outcome gains a live producer."

fn observation_complete_stmts(
  observer: String,
  in_flight: String,
  pending: String,
) -> List<TsStmt> {
  [
    ts_expr_stmt(expr: ts_binop(
      left: ts_ident(name: in_flight),
      op: "=",
      right: ts_ident(name: "false"))),
    ts_if(
      cond: ts_ident(name: pending),
      then: ts_block(stmts: [
        ts_expr_stmt(expr: ts_binop(
          left: ts_ident(name: pending),
          op: "=",
          right: ts_ident(name: "false"))),
        ts_expr_stmt(expr: ts_call(callee: ts_ident(name: observer), args: [])),
      ]),
      else_stmt: none),
  ]
}

fn observation_begin_stmts(in_flight: String, pending: String) -> List<TsStmt> {
  [
    ts_if(
      cond: ts_ident(name: in_flight),
      then: ts_block(stmts: [
        ts_expr_stmt(expr: ts_binop(
          left: ts_ident(name: pending),
          op: "=",
          right: ts_ident(name: "true"))),
        ts_return(expr: none),
      ]),
      else_stmt: none),
    ts_expr_stmt(expr: ts_binop(
      left: ts_ident(name: in_flight),
      op: "=",
      right: ts_ident(name: "true"))),
  ]
}

fn sessions_mark_live_stmts() -> List<TsStmt> {
  [
    ts_const(name: "sr", value: ts_call(
      callee: ts_member(object: ts_ident(name: "document"), property: "querySelector"),
      args: [workflow_row_selector_expr(
        node_id: ts_member(object: ts_ident(name: "sess"), property: "node_id"))])),
    workflow_set_observation_call(
      lamp_expr: workflow_lamp_in_row_expr(row_name: "sr", lamp: LiveWorkflowLamp),
      state: ClientObservationOn,
      reason_expr: ts_lit_str(value: "")),
    ts_const(name: "sb", value: ts_binop(
      left: ts_ident(name: "sr"),
      op: "&&",
      right: ts_call(
        callee: ts_member(object: ts_ident(name: "sr"), property: "querySelector"),
        args: [ts_lit_str(value: ".dispatch-btn")]))),
    ts_if(
      cond: ts_ident(name: "sb"),
      then: ts_block(stmts: [
        ts_expr_stmt(expr: ts_binop(
          left: ts_member(
            object: ts_member(object: ts_ident(name: "sb"), property: "dataset"),
            property: "sessionPresence"),
          op: "=",
          right: ts_lit_str(value: "present"))),
        ts_if(
          cond: ts_binop(
            left: ts_binop(
              left: ts_member(object: ts_ident(name: "sb"), property: "textContent"),
              op: "===",
              right: ts_lit_str(value: dispatch_caption_idle)),
            op: "||",
            right: ts_binop(
              left: ts_member(object: ts_ident(name: "sb"), property: "textContent"),
              op: "===",
              right: ts_lit_str(value: concat(dispatch_session_chip_prefix, dispatch_caption_present_word)))),
          then: ts_block(stmts: [
            ts_expr_stmt(expr: ts_binop(
              left: ts_member(object: ts_ident(name: "sb"), property: "textContent"),
              op: "=",
              right: ts_lit_str(value: concat(dispatch_session_chip_prefix, dispatch_caption_present_word)))),
            ts_expr_stmt(expr: ts_call(
              callee: ts_member(object: ts_member(object: ts_ident(name: "sb"), property: "classList"), property: "add"),
              args: [ts_lit_str(value: dispatch_class_ok)])),
            ts_expr_stmt(expr: ts_binop(
              left: ts_member(object: ts_ident(name: "sb"), property: "title"),
              op: "=",
              right: ts_binop(
                left: ts_binop(
                  left: ts_binop(
                    left: ts_binop(
                      left: ts_member(object: ts_ident(name: "sess"), property: "configured_provider"),
                      op: "+",
                      right: ts_lit_str(value: " configured · ")),
                    op: "+",
                    right: ts_member(object: ts_ident(name: "sess"), property: "provider")),
                  op: "+",
                  right: ts_lit_str(value: " · ")),
                op: "+",
                right: ts_binop(
                  left: ts_member(object: ts_ident(name: "sess"), property: "provider_readiness"),
                  op: "+",
                  right: ts_binop(
                    left: ts_lit_str(value: " — "),
                    op: "+",
                    right: ts_member(object: ts_ident(name: "sess"), property: "session_name")))))),
          ]),
          else_stmt: none),
        ts_let(name: "sc", value: ts_call(
          callee: ts_member(object: ts_member(object: ts_ident(name: "sb"), property: "parentElement"), property: "querySelector"),
          args: [ts_lit_str(value: ".stop-chip")])),
        ts_if(
          cond: ts_prefix(op: "!", expr: ts_ident(name: "sc")),
          then: ts_block(stmts: [
            ts_expr_stmt(expr: ts_binop(left: ts_ident(name: "sc"), op: "=", right: ts_call(callee: ts_member(object: ts_ident(name: "document"), property: "createElement"), args: [ts_lit_str(value: "button")]))),
            ts_expr_stmt(expr: ts_binop(left: ts_member(object: ts_ident(name: "sc"), property: "className"), op: "=", right: ts_lit_str(value: "stop-chip"))),
            ts_expr_stmt(expr: ts_binop(left: ts_member(object: ts_ident(name: "sc"), property: "type"), op: "=", right: ts_lit_str(value: "button"))),
            ts_expr_stmt(expr: ts_binop(left: ts_member(object: ts_ident(name: "sc"), property: "textContent"), op: "=", right: ts_lit_str(value: "stop"))),
            ts_expr_stmt(expr: ts_call(
              callee: ts_member(object: ts_ident(name: "sc"), property: "addEventListener"),
              args: [ts_lit_str(value: "click"), ts_arrow(params: ["ev"], body: ts_block(stmts: [
                ts_expr_stmt(expr: ts_binop(left: ts_member(object: ts_ident(name: "sc"), property: "textContent"), op: "=", right: ts_lit_str(value: "stopping…"))),
                ts_expr_stmt(expr: ts_binop(left: ts_member(object: ts_ident(name: "sc"), property: "disabled"), op: "=", right: ts_ident(name: "true"))),
                ts_expr_stmt(expr: ts_call(
                  callee: ts_member(
                    object: ts_call(
                      callee: ts_member(
                        object: ts_call(
                          callee: ts_member(
                            object: ts_call(callee: ts_ident(name: "fetch"), args: [
                              ts_binop(left: ts_lit_str(value: "/stop/"), op: "+", right: ts_member(object: ts_ident(name: "sess"), property: "node_id")),
                              ts_object(fields: [ts_field(key: "method", value: ts_lit_str(value: "POST"))]),
                            ]),
                            property: "then"),
                          args: [ts_arrow(params: ["r"], body: ts_block(stmts: [ts_return(expr: ts_call(callee: ts_member(object: ts_ident(name: "r"), property: "json"), args: []))]))]),
                        property: "then"),
                      args: [ts_arrow(params: ["j"], body: ts_block(stmts: [
                        ts_if(
                          cond: ts_binop(left: ts_member(object: ts_ident(name: "j"), property: "status"), op: "===", right: ts_lit_str(value: "stopped")),
                          then: ts_block(stmts: [
                            ts_expr_stmt(expr: ts_call(callee: ts_member(object: ts_member(object: ts_ident(name: "window"), property: "location"), property: "reload"), args: [])),
                          ]),
                          else_stmt: Present { value: ts_block(stmts: [
                            ts_expr_stmt(expr: ts_binop(left: ts_member(object: ts_ident(name: "sc"), property: "textContent"), op: "=", right: ts_lit_str(value: "stop refused"))),
                            ts_expr_stmt(expr: ts_binop(
                              left: ts_member(object: ts_ident(name: "sc"), property: "title"),
                              op: "=",
                              right: ts_binop(
                                left: ts_binop(left: ts_member(object: ts_ident(name: "j"), property: "reason"), op: "||", right: ts_member(object: ts_ident(name: "j"), property: "detail")),
                                op: "||",
                                right: ts_lit_str(value: "no reason on the wire")))),
                            ts_expr_stmt(expr: ts_binop(left: ts_member(object: ts_ident(name: "sc"), property: "disabled"), op: "=", right: ts_ident(name: "false"))),
                          ]) },
                        ),
                      ]))]),
                    property: "catch"),
                  args: [ts_arrow(params: ["e"], body: ts_block(stmts: [
                    ts_expr_stmt(expr: ts_binop(left: ts_member(object: ts_ident(name: "sc"), property: "textContent"), op: "=", right: ts_lit_str(value: "stop failed"))),
                    ts_expr_stmt(expr: ts_binop(left: ts_member(object: ts_ident(name: "sc"), property: "title"), op: "=", right: ts_binop(left: ts_ident(name: "e"), op: "+", right: ts_lit_str(value: "")))),
                    ts_expr_stmt(expr: ts_binop(left: ts_member(object: ts_ident(name: "sc"), property: "disabled"), op: "=", right: ts_ident(name: "false"))),
                  ]))])),
              ]))])),
            ts_expr_stmt(expr: ts_call(
              callee: ts_member(object: ts_ident(name: "sb"), property: "insertAdjacentElement"),
              args: [ts_lit_str(value: "afterend"), ts_ident(name: "sc")])),
          ]),
          else_stmt: none,
        ),
      ]),
      else_stmt: none,
    ),
  ]
}

fn remove_all_selector_stmt(selector: String, item_name: String) -> TsStmt {
  ts_expr_stmt(expr: ts_call(
    callee: ts_member(
      object: ts_call(
        callee: ts_member(object: ts_ident(name: "document"), property: "querySelectorAll"),
        args: [ts_lit_str(value: selector)]),
      property: "forEach"),
    args: [ts_arrow(
      params: [item_name],
      body: ts_expr_stmt(expr: ts_call(
        callee: ts_member(object: ts_ident(name: item_name), property: "remove"),
        args: [])))]))
}

fn sessions_reset_presence_stmt() -> TsStmt {
  ts_expr_stmt(expr: ts_call(
    callee: ts_member(
      object: ts_call(
        callee: ts_member(object: ts_ident(name: "document"), property: "querySelectorAll"),
        args: [ts_lit_str(value: ".dispatch-btn[data-session-presence=\"present\"]")]),
      property: "forEach"),
    args: [ts_arrow(params: ["pb"], body: ts_block(stmts: [
      ts_expr_stmt(expr: ts_binop(
        left: ts_member(
          object: ts_member(object: ts_ident(name: "pb"), property: "dataset"),
          property: "sessionPresence"),
        op: "=",
        right: ts_lit_str(value: ""))),
      ts_if(
        cond: ts_binop(
          left: ts_member(object: ts_ident(name: "pb"), property: "textContent"),
          op: "===",
          right: ts_lit_str(value: concat(dispatch_session_chip_prefix, dispatch_caption_present_word))),
        then: ts_block(stmts: [
          ts_expr_stmt(expr: ts_binop(
            left: ts_member(object: ts_ident(name: "pb"), property: "textContent"),
            op: "=",
            right: ts_lit_str(value: dispatch_caption_idle))),
          ts_expr_stmt(expr: ts_call(
            callee: ts_member(
              object: ts_member(object: ts_ident(name: "pb"), property: "classList"),
              property: "remove"),
            args: [ts_lit_str(value: dispatch_class_ok)])),
          ts_expr_stmt(expr: ts_binop(
            left: ts_member(object: ts_ident(name: "pb"), property: "title"),
            op: "=",
            right: ts_lit_str(value: ""))),
        ]),
        else_stmt: none),
      ts_const(name: "oldStop", value: ts_call(
        callee: ts_member(object: ts_member(object: ts_ident(name: "pb"), property: "parentElement"), property: "querySelector"),
        args: [ts_lit_str(value: ".stop-chip")])),
      ts_expr_stmt(expr: ts_binop(
        left: ts_ident(name: "oldStop"),
        op: "&&",
        right: ts_call(callee: ts_member(object: ts_ident(name: "oldStop"), property: "remove"), args: []))),
    ]))]))
}

fn observation_refused_banner_stmts(source_class: String) -> List<TsStmt> {
  [
    ts_let(name: "bn", value: ts_call(
      callee: ts_member(object: ts_ident(name: "document"), property: "querySelector"),
      args: [ts_lit_str(value: concat(".", source_class))])),
    ts_if(
      cond: ts_prefix(op: "!", expr: ts_ident(name: "bn")),
      then: ts_block(stmts: [
        ts_expr_stmt(expr: ts_binop(
          left: ts_ident(name: "bn"),
          op: "=",
          right: ts_call(
            callee: ts_member(object: ts_ident(name: "document"), property: "createElement"),
            args: [ts_lit_str(value: "div")]))),
        ts_expr_stmt(expr: ts_binop(
          left: ts_member(object: ts_ident(name: "bn"), property: "className"),
          op: "=",
          right: ts_lit_str(value: join(["observe-refused", source_class], " ")))),
        ts_const(name: "mn", value: ts_call(
          callee: ts_member(object: ts_ident(name: "document"), property: "querySelector"),
          args: [ts_lit_str(value: "main")])),
        ts_expr_stmt(expr: ts_binop(
          left: ts_ident(name: "mn"),
          op: "&&",
          right: ts_call(
            callee: ts_member(object: ts_ident(name: "mn"), property: "prepend"),
            args: [ts_ident(name: "bn")]))),
      ]),
      else_stmt: none),
    ts_expr_stmt(expr: ts_binop(
      left: ts_member(object: ts_ident(name: "bn"), property: "textContent"),
      op: "=",
      right: ts_ident(name: "why"))),
  ]
}

fn sessions_fetch_effect_statements() -> List<TsStmt> {
  [
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(
        object: ts_call(
          callee: ts_member(
            object: ts_call(
              callee: ts_member(
                object: ts_call(callee: ts_ident(name: "fetch"), args: [ts_lit_str(value: sessions_route_path)]),
                property: "then"),
              args: [ts_arrow(params: ["r"], body: ts_block(stmts: [ts_return(expr: ts_call(callee: ts_member(object: ts_ident(name: "r"), property: "json"), args: []))]))]),
            property: "then"),
          args: [ts_arrow(params: ["sj"], body: ts_block(stmts: concat([
            ts_if(
              cond: ts_member(object: ts_ident(name: "sj"), property: "observe_refused"),
              then: ts_block(stmts: concat(
                [
                  ts_const(name: "wireWhy", value: ts_binop(
                    left: ts_member(object: ts_ident(name: "sj"), property: "reason"),
                    op: "||",
                    right: ts_lit_str(value: "no reason on the wire"))),
                  ts_const(name: "why", value: ts_binop(
                    left: ts_lit_str(value: "session observation refused: "),
                    op: "+",
                    right: ts_ident(name: "wireWhy"))),
                ],
                concat(
                  [
                    sessions_reset_presence_stmt(),
                    workflow_set_all_observations_stmt(
                      lamp: LiveWorkflowLamp,
                      state: ClientObservationRefused { reason: "" },
                      reason_expr: ts_ident(name: "why")),
                  ],
                  observation_refused_banner_stmts(source_class: "sessions-observe-refused")))),
              else_stmt: Present { value: ts_block(stmts: [
                remove_all_selector_stmt(selector: ".sessions-observe-refused", item_name: "oldBanner"),
                sessions_reset_presence_stmt(),
                workflow_set_all_observations_stmt(
                  lamp: LiveWorkflowLamp,
                  state: ClientObservationOff,
                  reason_expr: ts_lit_str(value: "")),
                ts_expr_stmt(expr: ts_call(
                  callee: ts_member(object: ts_member(object: ts_ident(name: "sj"), property: "sessions"), property: "forEach"),
                  args: [ts_arrow(params: ["sess"], body: ts_block(stmts: sessions_mark_live_stmts()))])),
              ]) },
            ),
          ], observation_complete_stmts(
            observer: js_sessions_observe_fn,
            in_flight: js_sessions_observe_in_flight,
            pending: js_sessions_observe_pending))))]),
        property: "catch"),
      args: [ts_arrow(params: ["e"], body: ts_block(stmts: concat(
        [ts_const(name: "why", value: ts_binop(left: ts_lit_str(value: "session observation refused: "), op: "+", right: ts_binop(left: ts_ident(name: "e"), op: "+", right: ts_lit_str(value: ""))))],
        concat(
          [
            sessions_reset_presence_stmt(),
            workflow_set_all_observations_stmt(
              lamp: LiveWorkflowLamp,
              state: ClientObservationRefused { reason: "" },
              reason_expr: ts_ident(name: "why")),
          ],
          concat(
            observation_refused_banner_stmts(source_class: "sessions-observe-refused"),
            observation_complete_stmts(
              observer: js_sessions_observe_fn,
              in_flight: js_sessions_observe_in_flight,
              pending: js_sessions_observe_pending))))))])),
  ]
}

data attempts_row_note: String = "U3 (result surfacing v0): each attempt branch renders into its node's disclosure as a mono line — the branch NAME, copyable and true (a tree link would be dead until a push; a dead link is a fabricated result — the PR half lands when push/PR state is observed, not guessed). Upsert by class so a reload never stacks duplicates; the refusal arm reuses the loud banner with its own message."

fn attempts_mark_stmts() -> List<TsStmt> {
  [
    ts_const(name: "ar", value: ts_call(
      callee: ts_member(object: ts_ident(name: "document"), property: "querySelector"),
      args: [workflow_row_selector_expr(
        node_id: ts_member(object: ts_ident(name: "att"), property: "node_id"))])),
    workflow_set_observation_call(
      lamp_expr: workflow_lamp_in_row_expr(row_name: "ar", lamp: AttemptedWorkflowLamp),
      state: ClientObservationOn,
      reason_expr: ts_lit_str(value: "")),
    ts_const(name: "adt", value: ts_binop(
      left: ts_ident(name: "ar"),
      op: "&&",
      right: ts_call(callee: ts_member(object: ts_ident(name: "ar"), property: "querySelector"), args: [ts_lit_str(value: "details.item-detail")]))),
    ts_if(
      cond: ts_ident(name: "adt"),
      then: ts_block(stmts: [
        ts_let(name: "al", value: ts_call(callee: ts_member(object: ts_ident(name: "adt"), property: "querySelector"), args: [ts_lit_str(value: ".dispatch-attempts")])),
        ts_if(
          cond: ts_prefix(op: "!", expr: ts_ident(name: "al")),
          then: ts_block(stmts: [
            ts_expr_stmt(expr: ts_binop(left: ts_ident(name: "al"), op: "=", right: ts_call(callee: ts_member(object: ts_ident(name: "document"), property: "createElement"), args: [ts_lit_str(value: "div")]))),
            ts_expr_stmt(expr: ts_binop(left: ts_member(object: ts_ident(name: "al"), property: "className"), op: "=", right: ts_lit_str(value: "dispatch-attempts"))),
            ts_expr_stmt(expr: ts_binop(left: ts_member(object: ts_ident(name: "al"), property: "textContent"), op: "=", right: ts_lit_str(value: "attempts: "))),
            ts_expr_stmt(expr: ts_call(callee: ts_member(object: ts_ident(name: "adt"), property: "append"), args: [ts_ident(name: "al")])),
          ]),
          else_stmt: none,
        ),
        ts_expr_stmt(expr: ts_binop(
          left: ts_member(object: ts_ident(name: "al"), property: "textContent"),
          op: "=",
          right: ts_binop(
            left: ts_binop(left: ts_member(object: ts_ident(name: "al"), property: "textContent"), op: "+", right: ts_member(object: ts_ident(name: "att"), property: "branch")),
            op: "+",
            right: ts_lit_str(value: " ")))),
      ]),
      else_stmt: none,
    ),
  ]
}

fn attempts_fetch_effect_statements() -> List<TsStmt> {
  [
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(
        object: ts_call(
          callee: ts_member(
            object: ts_call(
              callee: ts_member(
                object: ts_call(callee: ts_ident(name: "fetch"), args: [ts_lit_str(value: attempts_route_path)]),
                property: "then"),
              args: [ts_arrow(params: ["r"], body: ts_block(stmts: [ts_return(expr: ts_call(callee: ts_member(object: ts_ident(name: "r"), property: "json"), args: []))]))]),
            property: "then"),
          args: [ts_arrow(params: ["aj"], body: ts_block(stmts: concat([
            ts_if(
              cond: ts_member(object: ts_ident(name: "aj"), property: "attempts_refused"),
              then: ts_block(stmts: concat(
                [
                  ts_const(name: "wireWhy", value: ts_binop(
                    left: ts_member(object: ts_ident(name: "aj"), property: "reason"),
                    op: "||",
                    right: ts_lit_str(value: "no reason on the wire"))),
                  ts_const(name: "why", value: ts_binop(
                    left: ts_lit_str(value: "attempt observation refused: "),
                    op: "+",
                    right: ts_ident(name: "wireWhy"))),
                ],
                concat(
                  [workflow_set_all_observations_stmt(
                    lamp: AttemptedWorkflowLamp,
                    state: ClientObservationRefused { reason: "" },
                    reason_expr: ts_ident(name: "why"))],
                  observation_refused_banner_stmts(source_class: "attempts-observe-refused")))),
              else_stmt: Present { value: ts_block(stmts: [
                remove_all_selector_stmt(selector: ".attempts-observe-refused", item_name: "oldBanner"),
                remove_all_selector_stmt(selector: ".dispatch-attempts", item_name: "oldAttempts"),
                workflow_set_all_observations_stmt(
                  lamp: AttemptedWorkflowLamp,
                  state: ClientObservationOff,
                  reason_expr: ts_lit_str(value: "")),
                ts_expr_stmt(expr: ts_call(
                  callee: ts_member(object: ts_member(object: ts_ident(name: "aj"), property: "attempts"), property: "forEach"),
                  args: [ts_arrow(params: ["att"], body: ts_block(stmts: attempts_mark_stmts()))])),
              ]) },
            ),
          ], observation_complete_stmts(
            observer: js_attempts_observe_fn,
            in_flight: js_attempts_observe_in_flight,
            pending: js_attempts_observe_pending))))]),
        property: "catch"),
      args: [ts_arrow(params: ["e"], body: ts_block(stmts: concat(
        [ts_const(name: "why", value: ts_binop(left: ts_lit_str(value: "attempt observation refused: "), op: "+", right: ts_binop(left: ts_ident(name: "e"), op: "+", right: ts_lit_str(value: ""))))],
        concat(
          [workflow_set_all_observations_stmt(
            lamp: AttemptedWorkflowLamp,
            state: ClientObservationRefused { reason: "" },
            reason_expr: ts_ident(name: "why"))],
          concat(
            observation_refused_banner_stmts(source_class: "attempts-observe-refused"),
            observation_complete_stmts(
              observer: js_attempts_observe_fn,
              in_flight: js_attempts_observe_in_flight,
              pending: js_attempts_observe_pending))))))])),
  ]
}

fn observation_fetch_statements() -> List<TsStmt> {
  [
    ts_let(name: js_sessions_observe_in_flight, value: ts_ident(name: "false")),
    ts_let(name: js_attempts_observe_in_flight, value: ts_ident(name: "false")),
    ts_let(name: js_sessions_observe_pending, value: ts_ident(name: "false")),
    ts_let(name: js_attempts_observe_pending, value: ts_ident(name: "false")),
    ts_const(
      name: js_sessions_observe_fn,
      value: ts_arrow(params: [], body: ts_block(stmts: concat(
        observation_begin_stmts(
          in_flight: js_sessions_observe_in_flight,
          pending: js_sessions_observe_pending),
        sessions_fetch_effect_statements())))),
    ts_const(
      name: js_attempts_observe_fn,
      value: ts_arrow(params: [], body: ts_block(stmts: concat(
        observation_begin_stmts(
          in_flight: js_attempts_observe_in_flight,
          pending: js_attempts_observe_pending),
        attempts_fetch_effect_statements())))),
    ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_sessions_observe_fn), args: [])),
    ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_attempts_observe_fn), args: [])),
    ts_expr_stmt(expr: ts_call(
      callee: ts_ident(name: "setInterval"),
      args: [
        ts_arrow(params: [], body: ts_block(stmts: [
          ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_sessions_observe_fn), args: [])),
          ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_attempts_observe_fn), args: [])),
        ])),
        ts_lit_num(text: to_string(millisecond_count(m: observation_poll_interval))),
      ])),
  ]
}

fn dispatch_client_program_for(selector: String, url_expr: TsExpr, header: List<String>) -> TsProgram {
  TsProgram {
    ts_nocheck: false,
    header_lines: header,
    statements: concat(
      sound_preamble_statements(),
      concat(
        dispatch_preamble_statements(),
        concat(
          workflow_observation_preamble_statements(),
          concat(
            dispatch_bind_statements(selector: selector, url_expr: url_expr),
            concat(
              sound_toggle_bind_statements(),
              concat(
                theme_toggle_bind_statements(),
                concat(
                  disclosure_bind_statements(),
                  concat(
                    swatch_toggle_bind_statements(),
                    observation_fetch_statements())))))))),
  }
}

fn dispatch_client_program() -> TsProgram {
  dispatch_client_program_for(
    selector: ".dispatch-btn",
    url_expr: dispatch_fetch_url_expr(),
    header: [
      "gunbc roadmap dispatch button — emitted from gunbc.roadmap_component.dispatch_client_program",
      "POSTs to the dispatch route and reads belt B's status contract (ok set derived from",
      "belt_dispatch_ok_status_labels); served as an external asset, referenced by <script src>",
      "Operation sound: a 5ms detent tick on pointerdown, synthesized through WebAudio from",
      "gunbc.design.sound rows — no audio files, and a persisted mute the instrument obeys",
    ],
  )
}

fn dispatch_client_js_source() -> String {
  serialize_typescript_program(p: dispatch_client_program())
}

data sandbox_live_class: String = "sandbox-live-btn"

data sandbox_client_program_note: String = "The /sandbox live instance reuses the EXACT dispatch render (dispatch_client_program_for) — one behavior, two bindings (§2): same click/response handler, only the fetch URL differs. It POSTs to /sandbox/echo?status=<data-status> instead of the real dispatch route, so every wire arm is pressable and renders identically to the real button, without spawning a session. If the render forked, the sandbox would be a lie; sharing the program makes it a faithful mirror."

fn sandbox_echo_url_expr() -> TsExpr {
  ts_binop(
    left: ts_lit_str(value: "/sandbox/echo?status="),
    op: "+",
    right: ts_call(
      callee: ts_ident(name: "encodeURIComponent"),
      args: [ts_call(callee: js_b_member(name: "getAttribute"), args: [ts_lit_str(value: "data-status")])],
    ),
  )
}

fn sandbox_client_program() -> TsProgram {
  dispatch_client_program_for(
    selector: join([".", sandbox_live_class], ""),
    url_expr: sandbox_echo_url_expr(),
    header: [
      "gunbc /sandbox live dispatch instance — emitted from gunbc.roadmap_component.sandbox_client_program",
      "same render as the real dispatch button, but POSTs to /sandbox/echo?status=<data-status>",
      "so every wire arm is pressable without dispatching a real session",
    ],
  )
}

fn sandbox_client_js_source() -> String {
  serialize_typescript_program(p: sandbox_client_program())
}

fn dispatch_state_display_text(state: ComponentState) -> String {
  match state.kind {
    IdleState => dispatch_caption_idle
    RequestedState => dispatch_caption_requested
    TerminalState { wire_label: wl, ok: ok } =>
      if ok {
        concat(dispatch_ack_prefix, dispatch_ack_word)
      } else if belt_dispatch_label_band_key(wire_label: wl) == "loud" {
        dispatch_caption_loud
      } else {
        dispatch_caption_fail
      }
  }
}
