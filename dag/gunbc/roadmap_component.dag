data workflow_progress_class: String = "workflow-progress"
data workflow_stage_class: String = "workflow-stage"
data workflow_activity_class: String = "workflow-activity"
data workflow_stage_data_attribute: String = "data-workflow-stage"
data workflow_segment_state_data_attribute: String = "data-state"

data workflow_progress_note: String = "The seven-obligation attempt pipeline is presentation over /workflow.json evidence, not a stored stage machine and not a replacement for independent Live/Attempted facts. Environment and Worktree are constructive receipts; Agent comes from provider events reconciled with process exit; Verify, Publish, Review, and Audit remain visibly pending until their own producers exist. Both markup and server desired facts consume roadmap_attempt_workflow_segment_kinds, while the client writes only each segment's observed state/detail from the route. A provider turn completing cannot move downstream obligations. Workflow observation is single-flight: the next timer is armed only in the settled promise's finally arm, so a slow/refused route cannot accumulate overlapping requests against the interpreted single-threaded server."

data workflow_lamps_note: String = "Workflow lamps v0 (operator adjudication 2026-07-26): Live and Attempted are two independent projections over the existing /sessions.json and /attempts.json observations. workflow_lamps_v0 declares their presentation order for the row strip; workflow_lamp_state selects each axis without collapsing them into one workflow status. Every lamp starts ClientObservationPending and can become Off, On, or Refused only through the shared gunbc.client_observation_state authority. The strip is evidence presentation only: its rightmost lit member never gates an action and is never persisted. gunbc.client_observation_state.work_item_workflow_fact_note records the seven-fact join ruling without re-declaring those facts as a parallel roster. Proposed and Landed do not earn lamps until the typed attempt/branch/PR/node join exists; that binding, not more visual states, is the next slice."

data dispatch_caption_present_word_note: String = "U2: /sessions.json observes tmux session presence, not provider progress. The caption therefore says `present`; the Live lamp retains its v0 key for compatibility, but neither this word nor that lamp may be projected as authenticated, executing, or complete."

data dispatch_caption_present_word: String = "present"

data dispatch_class_requested: String = "dispatch-requested"
data dispatch_class_ok: String = "dispatch-ok"
data dispatch_class_refused: String = "dispatch-refused"
data dispatch_class_loud: String = "dispatch-loud"

data roadmap_row_archetype_note: String = "The RoadmapRow archetype (composition slice 2; refined by workflow lamps v0 without adding a head track): the row's five regions remain status chip, title, meta, disclosure, actuator. The ActuatorRegion is realized by one always-present workflow-controls wrapper containing the workflow strip and the optional dispatch control; dynamic Stop also lands inside that wrapper. This preserves the derived auto 1fr auto grid while giving done/superseded rows an observation surface and preventing Stop or a lamp strip from becoming an implicit fourth grid item. The title owns the flex track; meta FLOWS inside it; disclosure sits under the head. Density rides roadmap_row_height and roadmap_row_gutter. The full-size instrument specimen remains outside .node-head in the sandbox."

type RowTrack
  = AutoTrack
  | FlexTrack

fn row_track_wire(t: RowTrack) -> String {
  match t {
    AutoTrack => "auto"
    FlexTrack => "1fr"
  }
}

type RowPlacement
  = HeadTrack { track: RowTrack }
  | InTitleFlow
  | UnderHead

type RowRegion
  = StatusChipRegion
  | TitleRegion
  | MetaRegion
  | DisclosureRegion
  | ActuatorRegion

fn row_region_key(r: RowRegion) -> String {
  match r {
    StatusChipRegion => "status-chip"
    TitleRegion => "title"
    MetaRegion => "meta"
    DisclosureRegion => "disclosure"
    ActuatorRegion => "actuator"
  }
}

type RoadmapRowRegion {
  region: RowRegion
  placement: RowPlacement
}

data roadmap_row_archetype: List<RoadmapRowRegion> = [
  RoadmapRowRegion { region: StatusChipRegion, placement: HeadTrack { track: AutoTrack } },
  RoadmapRowRegion { region: TitleRegion, placement: HeadTrack { track: FlexTrack } },
  RoadmapRowRegion { region: MetaRegion, placement: InTitleFlow },
  RoadmapRowRegion { region: DisclosureRegion, placement: UnderHead },
  RoadmapRowRegion { region: ActuatorRegion, placement: HeadTrack { track: AutoTrack } },
]

data roadmap_row_gutter_split_note: String = "Two gutters, two jobs (operator-signed 2026-07-25, the third PROVISIONAL flip): the first cut ran ONE space-4 token as both the grid's column rhythm and the mid cell's badge-flow rhythm, and the operator's tune split them — column gaps (chip | title | actuator) breathe at space-8 while the badge flow inside the title cell keeps space-4. They are separate density decisions that happened to share a number for one commit; a later retune of either moves alone."

data roadmap_row_height: ScaleToken = height_row
data roadmap_row_gutter: ScaleToken = space_4
data roadmap_row_column_gutter: ScaleToken = space_8

fn roadmap_row_grid_template() -> String {
  join(
    fold(roadmap_row_archetype, init: [], f: (acc, r) => match r.placement {
      HeadTrack { track } => concat(acc, [row_track_wire(t: track)])
      InTitleFlow => acc
      UnderHead => acc
    }),
    " ")
}

data node_mid_class_note: String = "The title track's cell: the wrapper that carries the title plus the flowing meta regions (badges, carrier links). It exists because the archetype's grid has exactly the head tracks as columns and a node's badge count varies — meta declared InTitleFlow realizes as flex flow inside this cell, never as a column that would ragged the grid."

data node_mid_class: String = "node-mid"

data dispatch_caption_note: String = "The operator-facing captions (remodel W1d, operator ruling 2026-07-24; lifecycle correction 2026-07-27): ok keeps the exact belt status under the dispatch-receipt prefix, while fail and loud collapse to one operator phrase each with the wire label and located fields in the title/detail channel. A separate sessions observation may replace the receipt with `session · present`; neither caption claims provider execution. BandInProgress renders the requested caption. These rows are the caption authority for the client program, gallery, and reserved width."

data dispatch_caption_idle: String = "dispatch"
data dispatch_caption_requested: String = "dispatching..."
data dispatch_caption_fail: String = "not dispatchable"
data dispatch_caption_loud: String = "belt fault"

data theme_toggle_note: String = "The day/night control (operator 2026-07-24, remodel W1g): a property of the whole surface like the mute, cycling auto -> day -> night. auto removes data-theme so the prefers-color-scheme projection governs; a named choice pins data-theme to the Theme's OWN name (derived from day_theme/night_theme, never a re-typed string), which the theme_root_css selector grammar already answers. Persisted in this browser's storage for the same reason the mute is: the preference belongs to these eyes."

data disclosure_component_note: String = "The brief disclosure enters the register (remodel W1e, operator 2026-07-24: the UA triangle read as debug chrome — a ticket affordance, not a tree-widget default). The MARK is a real span inside the summary, never a UA marker or a pseudo-element: the client program mirrors the details element's open state onto the mark as a state class (the browser owns [open]; the state class belongs to the client program — the same split the dispatch button's OnStateClass note establishes), so the register's existing trigger + detent machinery drives the turn with no new trigger vocabulary and no descendant selector. The open detent is the first consumer of the detent model's rotation axis (turn_deg)."

data disclosure_mark_class: String = "disclosure-mark"
data disclosure_open_class: String = "disclosure-open"
data disclosure_mark_glyph: String = "›"

data theme_storage_key: String = "gunbc.theme"
data theme_toggle_class: String = "theme-toggle"
data theme_toggle_auto_value: String = "auto"
data theme_toggle_label_prefix: String = "theme · "

fn theme_toggle_labels() -> List<String> {
  map([theme_toggle_auto_value, day_theme.name, night_theme.name],
    v => join([theme_toggle_label_prefix, v], ""))
}

fn theme_toggle_reserved_width() -> String {
  css_length_wire(l: css_ch(n: dispatch_reserved_ch_for(labels: theme_toggle_labels())))
}

data sound_toggle_class: String = "sound-toggle"

data sound_toggle_note: String = "The mute control, and its whole design is one operator sentence: an instrument can be muted, not argued with. So it is a single persisted boolean with no volume axis, no per-sound settings, and no prompt — the mechanism has one voice and you either hear it or you do not. Default is SOUNDING, because a sound feature shipped off by default is a sound feature nobody discovers, and the sounds here are 5 ms operation ticks rather than notifications.

Both labels are rendered from one authority so the toggle can never disagree with the state it reports, and the reserved width is DERIVED from the longer of them (the same discipline the dispatch button's width uses) so flipping the label cannot reflow the header. Persistence is localStorage rather than a cookie or a server round-trip: the preference is about this browser's speakers, so it belongs to the browser, and a mute that needed the belt to be up would be a mute that failed when the dashboard was most annoying.

The toggle deliberately ticks when it is switched ON and stays silent when switched OFF, which needs no branch — the tick already checks the mute state, so calling it after the flip produces confirmation on unmute and silence on mute. That is the instrument answering with its own voice, which is the only honest way for a sound control to acknowledge itself."

data sound_toggle_label_on: String = "sound · on"
data sound_toggle_label_off: String = "sound · off"

fn sound_toggle_labels() -> List<String> {
  [sound_toggle_label_on, sound_toggle_label_off]
}

fn sound_toggle_reserved_width() -> String {
  css_length_wire(l: css_ch(n: dispatch_reserved_ch_for(labels: sound_toggle_labels())))
}

data sound_muted_storage_value: String = "1"
data sound_sounding_storage_value: String = "0"

data js_sound_muted_fn: String = "gunbcSoundMuted"
data js_audio_context_var: String = "gunbcAudioContext"
data js_tick_fn: String = "gunbcTick"

fn js_local_storage_get(key: String) -> TsExpr {
  ts_call(
    callee: ts_member(object: ts_ident(name: "localStorage"), property: "getItem"),
    args: [ts_lit_str(value: key)],
  )
}

fn js_sound_muted_predicate() -> TsStmt {
  ts_const(
    name: js_sound_muted_fn,
    value: ts_arrow(
      params: [],
      body: ts_expr_stmt(expr: ts_binop(
        left: js_local_storage_get(key: sound_mute_storage_key),
        op: "===",
        right: ts_lit_str(value: sound_muted_storage_value),
      )),
    ),
  )
}

fn js_actx_member(name: String) -> TsExpr {
  ts_member(object: ts_ident(name: js_audio_context_var), property: name)
}

fn js_oscillator_tick_body(s: SoundSpec) -> TsStmt {
  let decay_s = sound_spec_decay_seconds_wire(s: s)
  ts_block(stmts: [
    ts_if(
      cond: ts_call(callee: ts_ident(name: js_sound_muted_fn), args: []),
      then: ts_block(stmts: [ts_return(expr: none)]),
      else_stmt: none,
    ),
    ts_if(
      cond: ts_prefix(op: "!", expr: ts_ident(name: js_audio_context_var)),
      then: ts_block(stmts: [
        ts_expr_stmt(expr: ts_binop(
          left: ts_ident(name: js_audio_context_var),
          op: "=",
          right: ts_new(callee: ts_ident(name: web_audio_context_interface), args: []),
        )),
      ]),
      else_stmt: none,
    ),
    ts_const(name: "play", value: ts_arrow(params: [], body: ts_block(stmts: js_oscillator_schedule_stmts(s: s, decay_s: decay_s)))),
    ts_if(
      cond: ts_binop(left: js_actx_member(name: "state"), op: "===", right: ts_lit_str(value: "running")),
      then: ts_block(stmts: [
        ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "play"), args: [])),
        ts_return(expr: none),
      ]),
      else_stmt: none,
    ),
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(object: ts_call(callee: js_actx_member(name: "resume"), args: []), property: "then"),
      args: [ts_ident(name: "play")],
    )),
  ])
}

fn js_oscillator_schedule_stmts(s: SoundSpec, decay_s: String) -> List<TsStmt> {
  [
    ts_const(name: "t0", value: js_actx_member(name: web_audio_current_time_property)),
    ts_const(name: "osc", value: ts_call(callee: js_actx_member(name: web_audio_create_oscillator_method), args: [])),
    ts_const(name: "amp", value: ts_call(callee: js_actx_member(name: web_audio_create_gain_method), args: [])),
    ts_const(name: "t1", value: ts_binop(left: ts_ident(name: "t0"), op: "+", right: ts_lit_num(text: decay_s))),
    ts_expr_stmt(expr: ts_binop(
      left: ts_member(object: ts_ident(name: "osc"), property: web_audio_type_property),
      op: "=",
      right: ts_lit_str(value: sound_spec_timbre_wire(s: s)),
    )),
    ts_expr_stmt(expr: ts_binop(
      left: ts_member(
        object: ts_member(object: ts_ident(name: "osc"), property: web_audio_frequency_property),
        property: web_audio_value_property,
      ),
      op: "=",
      right: ts_lit_num(text: sound_spec_frequency_wire(s: s)),
    )),
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(
        object: ts_member(object: ts_ident(name: "amp"), property: web_audio_gain_property),
        property: web_audio_set_value_at_time_method,
      ),
      args: [ts_lit_num(text: sound_spec_peak_gain_wire(s: s)), ts_ident(name: "t0")],
    )),
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(
        object: ts_member(object: ts_ident(name: "amp"), property: web_audio_gain_property),
        property: web_audio_exponential_ramp_method,
      ),
      args: [ts_lit_num(text: micros_decimal_wire(micros: web_audio_gain_epsilon_micros)), ts_ident(name: "t1")],
    )),
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(object: ts_ident(name: "osc"), property: web_audio_connect_method),
      args: [ts_ident(name: "amp")],
    )),
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(object: ts_ident(name: "amp"), property: web_audio_connect_method),
      args: [js_actx_member(name: web_audio_destination_property)],
    )),
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(object: ts_ident(name: "osc"), property: web_audio_start_method),
      args: [ts_ident(name: "t0")],
    )),
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(object: ts_ident(name: "osc"), property: web_audio_stop_method),
      args: [ts_ident(name: "t1")],
    )),
  ]
}

data sound_preamble_note: String = "Three statements, in this order for reasons that are not stylistic. The mute predicate comes first because the tick calls it. The AudioContext is a LET initialised to null and constructed lazily inside the tick, not at load: a context created outside a user gesture starts suspended under every browser's autoplay policy, and constructing one per tick would leak a hardware resource per click. The earlier claim that a pointerdown-born context needs no resume dance was measured in Chrome only and did not survive the operator's ears (remodel W1d, A.2): a fresh context can sit suspended with currentTime frozen at 0, so a 5 ms tick scheduled on that clock is silently swallowed — the first press, at least, made no sound. The tick therefore wraps its scheduling in `play` and gates on state: running plays immediately; anything else goes through resume().then(play), which is a no-op cost when the engine was already running and the difference between silence and a first-press tick everywhere else."

fn sound_preamble_statements() -> List<TsStmt> {
  [
    js_sound_muted_predicate(),
    ts_let(name: js_audio_context_var, value: ts_ident(name: "null")),
    ts_const(
      name: js_tick_fn,
      value: ts_arrow(
        params: [],
        body: js_oscillator_tick_body(s: engage_detent_click),
      ),
    ),
  ]
}

data sound_toggle_program_note: String = "The toggle paints itself from the same predicate the tick reads, then repaints after each flip, so the label is a projection of the stored state rather than a second copy of it — a toggle whose label and behaviour can disagree is worse than no toggle. paint() runs once at bind time because the stored preference outlives the page: on load the label must already say what this browser will actually do."

fn sound_toggle_bind_statements() -> List<TsStmt> {
  [
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(
        object: ts_call(
          callee: ts_member(object: ts_ident(name: "document"), property: "querySelectorAll"),
          args: [ts_lit_str(value: join([".", sound_toggle_class], ""))],
        ),
        property: "forEach",
      ),
      args: [ts_arrow(params: ["t"], body: ts_block(stmts: [
        ts_const(name: "paint", value: ts_arrow(params: [], body: ts_expr_stmt(expr: ts_binop(
          left: ts_member(object: ts_ident(name: "t"), property: "textContent"),
          op: "=",
          right: ts_cond(
            test: ts_call(callee: ts_ident(name: js_sound_muted_fn), args: []),
            consequent: ts_lit_str(value: sound_toggle_label_off),
            alternate: ts_lit_str(value: sound_toggle_label_on),
          ),
        )))),
        ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "paint"), args: [])),
        ts_expr_stmt(expr: ts_call(
          callee: ts_member(object: ts_ident(name: "t"), property: "addEventListener"),
          args: [ts_lit_str(value: "click"), ts_arrow(params: [], body: ts_block(stmts: [
            ts_expr_stmt(expr: ts_call(
              callee: ts_member(object: ts_ident(name: "localStorage"), property: "setItem"),
              args: [
                ts_lit_str(value: sound_mute_storage_key),
                ts_cond(
                  test: ts_call(callee: ts_ident(name: js_sound_muted_fn), args: []),
                  consequent: ts_lit_str(value: sound_sounding_storage_value),
                  alternate: ts_lit_str(value: sound_muted_storage_value),
                ),
              ],
            )),
            ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "paint"), args: [])),
            ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_tick_fn), args: [])),
          ]))],
        )),
      ]))],
    )),
  ]
}

data dispatch_state_class_note: String = "The single authority for a state's CSS modifier class, consumed by the client script (which flips classes on the live button), the stylesheet (which paints each class through the state's role material), and the P4 gallery (which renders each state statically) — three consumers, one class vocabulary, so the live button and the gallery cannot disagree. idle is the base (no modifier); the terminals collapse to their ok/refusal MATERIAL group (figure vs boundary), the per-label distinction living in the text, not the color."

fn dispatch_state_class(state: ComponentState) -> String {
  match state.kind {
    IdleState => ""
    RequestedState => dispatch_class_requested
    TerminalState { wire_label: wl, ok: ok } =>
      if ok {
        dispatch_class_ok
      } else if belt_dispatch_label_band_key(wire_label: wl) == "loud" {
        join([dispatch_class_refused, " ", dispatch_class_loud], "")
      } else {
        dispatch_class_refused
      }
  }
}

data dispatch_client_program_note: String = "The dispatch button's client behavior, modeled in native .dag as ONE TsProgram (extdeps.languages.typescript.program) — never a hand-concatenated JS string (the dispatch-button incident's root class, §5). It is EMITTED as an external served asset (gunbc.roadmap_dispatch_asset_path, served by belt B) and referenced by <script src>, the same shape gunbc.site.moodboard uses for reframe_watcher_js — NOT inlined into the HTML (an inline <script> text node escapes '>' under std.markup EscapeHtml, corrupting an arrow's `=>`; external emission has no such hazard, so arrows are free). The ok-predicate is a ts_binop `||` chain DERIVED from belt_dispatch_ok_status_labels (the wire authority), so a label crossing the ok/refusal line moves the predicate by derivation — the retired belt-A ok/node read is gone and cannot return (the page witness holds a RED on j.ok)."

data roadmap_dispatch_asset_path: String = "/assets/roadmap-dispatch.js"

data sandbox_asset_path: String = "/assets/sandbox.js"

fn js_b_member(name: String) -> TsExpr {
  ts_member(object: ts_ident(name: "b"), property: name)
}

fn js_j_status() -> TsExpr {
  ts_member(object: ts_ident(name: "j"), property: "status")
}

fn js_j_member(name: String) -> TsExpr {
  ts_member(object: ts_ident(name: "j"), property: name)
}

fn js_classlist_call(method: String, arg: TsExpr) -> TsStmt {
  ts_expr_stmt(expr: ts_call(
    callee: ts_member(object: ts_member(object: ts_ident(name: "b"), property: "classList"), property: method),
    args: [arg],
  ))
}

fn dispatch_ok_status_comparison(wire_label: String) -> TsExpr {
  ts_binop(left: js_j_status(), op: "===", right: ts_lit_str(value: wire_label))
}

fn dispatch_or_chain(exprs: List<TsExpr>) -> TsExpr {
  let acc = fold(exprs, init: none, f: (a, c) => match a {
    Absent => Present { value: c }
    Present { value: prev } => Present { value: ts_binop(left: prev, op: "||", right: c) }
  })
  match acc {
    Present { value: e } => e
    Absent => ts_ident(name: "false")
  }
}

fn dispatch_ok_predicate_expr() -> TsExpr {
  dispatch_or_chain(exprs: map(belt_dispatch_ok_status_labels(), l => dispatch_ok_status_comparison(wire_label: l)))
}

fn dispatch_fetch_url_expr() -> TsExpr {
  ts_binop(
    left: ts_lit_str(value: belt_dispatch_path_prefix),
    op: "+",
    right: ts_call(
      callee: ts_ident(name: "encodeURIComponent"),
      args: [ts_call(callee: js_b_member(name: "getAttribute"), args: [ts_lit_str(value: "data-node")])],
    ),
  )
}

data dispatch_choreography_note: String = "The presented-state choreography (remodel W1d, operator ruling 2026-07-24: transitions are sugar over the data layer). The DATA layer applies the wire answer the moment it arrives — b.dataset.status lands immediately, nothing about the operation waits. The PRESENTATION holds the requested phase for at least the read dwell (dispatch_requested_read_dwell_ms — a reading duration with its own authority row, never a borrowed transition clock) and then applies the terminal render: setTimeout(apply, max(0, t0 + dwell - now)), so a 1 ms echo appears as a deliberate act and a 30 s belt answer appears the moment it lands. Presentation never fabricates a state that did not occur — apply renders exactly the answer stored on the data layer, later, never a different one. The terminal caption is the BAND's phrase (dispatch_caption_note); the wire label and located fields live in the title channel; the loud band additionally marks dispatch_class_loud so the stylesheet and any detail affordance can key on it."

data dispatch_requested_read_dwell_note: String = "The requested phase's minimum presentation is a READING duration, not a transition clock (operator ruling 2026-07-24: 160 ms — the first cut borrowed reveal_deliberate — was too short to actually read 'dispatching...'; a dwell exists so the caption is USEFUL, so it is priced in reading time). It is deliberately its own authority row rather than a retune of a shared TimingToken: the hover reveal and this hold are different concepts that happened to share a number for one commit, and retuning the shared token would have made every hover a half-second. Operator-tuned twice: 500 ms first (readable), then 300 ms (2026-07-24 — readable AND quick). The deeper direction is filed as the motion-modeling follow-up: a single long hold is the wrong shape — the requested phase wants MOVING PARTS (the Discord-mute reference: the state lands fast, the motion continues to hold attention), i.e. phase-structured choreography rows, not one dwell scalar. This row survives until that session replaces it."

data dispatch_requested_read_dwell_ms: Int = 300

data js_dwell_const: String = "gunbcDwellMs"
data js_refresh_sessions_fn: String = "gunbcRefreshSessions"
data js_poll_sessions_fn: String = "gunbcPollSessions"
data js_refresh_attempts_fn: String = "gunbcRefreshAttempts"
data js_refresh_workflow_fn: String = "gunbcRefreshWorkflow"
data js_poll_workflow_fn: String = "gunbcPollWorkflow"

data session_observation_refresh_note: String = "Session presence is a live read, not page-load state. gunbcRefreshSessions performs one read, so an accepted dispatch can re-observe immediately without minting another timer chain. The single gunbcPollSessions loop schedules itself with setTimeout. Two seconds keeps a short-lived provider/setup failure visible without turning tmux observation into a hot loop. This is observation cadence, not animation; setInterval remains absent under the tactile motion wall."

data session_observation_refresh_ms: Int = 2000

fn dispatch_preamble_statements() -> List<TsStmt> {
  [ts_const(name: js_dwell_const, value: ts_lit_num(text: to_string(dispatch_requested_read_dwell_ms)))]
}

fn dwell_remaining_expr() -> TsExpr {
  ts_call(
    callee: ts_member(object: ts_ident(name: "Math"), property: "max"),
    args: [
      ts_lit_num(text: "0"),
      ts_binop(
        left: ts_binop(left: ts_ident(name: "t0"), op: "+", right: ts_ident(name: js_dwell_const)),
        op: "-",
        right: ts_call(callee: ts_member(object: ts_ident(name: "Date"), property: "now"), args: []),
      ),
    ],
  )
}

fn dispatch_band_chain_expr() -> TsExpr {
  fold(belt_dispatch_label_band_rows(), init: ts_lit_str(value: "loud"), f: (acc, row) =>
    ts_cond(
      test: ts_binop(left: ts_ident(name: "s"), op: "===", right: ts_lit_str(value: row.wire_label)),
      consequent: ts_lit_str(value: row.band_key),
      alternate: acc,
    ))
}

data dispatch_expand_chain_note: String = "The client grain of the attention law (composition slice 3): which terminal bands auto-expand the row's disclosure is DERIVED — the distinct band keys of the wire-band rows filtered through gunbc.roadmap_altitude.band_expands (anomaly expands; routine and working never do) — so the emitted predicate `(band === \"fail\") || (band === \"loud\")` moves when either authority moves and no band name is hand-chosen at the emit site. The fold seeds `false`, which serializes as a visible leading arm rather than a fabricated default."

fn key_present(keys: List<String>, key: String) -> Bool {
  fold(keys, init: false, f: (acc, k) => acc || k == key)
}

fn dispatch_expand_band_keys() -> List<String> {
  fold(belt_dispatch_label_band_rows(), init: [], f: (acc, row) =>
    if band_expands(band_key: row.band_key) && !key_present(keys: acc, key: row.band_key) {
      concat(acc, [row.band_key])
    } else {
      acc
    })
}

fn dispatch_expand_chain_expr() -> TsExpr {
  fold(dispatch_expand_band_keys(), init: ts_ident(name: "false"), f: (acc, k) =>
    ts_binop(
      left: acc,
      op: "||",
      right: ts_binop(left: ts_ident(name: "band"), op: "===", right: ts_lit_str(value: k))))
}

fn dispatch_terminal_apply_body() -> TsStmt {
  ts_block(stmts: [
    ts_const(name: "s", value: ts_binop(left: js_j_status(), op: "||", right: ts_lit_str(value: ""))),
    ts_const(name: "p", value: ts_binop(left: js_j_member(name: "provider"), op: "||", right: ts_lit_str(value: ""))),
    ts_const(name: "band", value: dispatch_band_chain_expr()),
    ts_const(name: "ok", value: ts_binop(left: ts_ident(name: "band"), op: "===", right: ts_lit_str(value: "ok"))),
    ts_expr_stmt(expr: ts_binop(
      left: js_b_member(name: "textContent"),
      op: "=",
      right: ts_cond(
        test: ts_ident(name: "ok"),
        consequent: ts_binop(
          left: ts_binop(
            left: ts_lit_str(value: dispatch_receipt_chip_prefix),
            op: "+",
            right: ts_ident(name: "s"),
          ),
          op: "+",
          right: ts_cond(
            test: ts_ident(name: "p"),
            consequent: ts_binop(
              left: ts_lit_str(value: " · "),
              op: "+",
              right: ts_ident(name: "p")),
            alternate: ts_lit_str(value: "")),
        ),
        alternate: ts_cond(
          test: ts_binop(
            left: ts_ident(name: "s"),
            op: "===",
            right: ts_lit_str(value: belt_dispatch_disabled_status_label())),
          consequent: ts_binop(
            left: ts_lit_str(value: dispatch_receipt_chip_prefix),
            op: "+",
            right: ts_ident(name: "s")),
          alternate: ts_cond(
            test: ts_binop(
              left: ts_ident(name: "band"),
              op: "===",
              right: ts_lit_str(value: "fail")),
            consequent: ts_lit_str(value: dispatch_caption_fail),
            alternate: ts_lit_str(value: dispatch_caption_loud)),
        ),
      ),
    )),
    js_classlist_call(method: "remove", arg: ts_lit_str(value: dispatch_class_requested)),
    js_classlist_call(method: "remove", arg: ts_lit_str(value: dispatch_class_ok)),
    js_classlist_call(method: "remove", arg: ts_lit_str(value: dispatch_class_refused)),
    js_classlist_call(method: "remove", arg: ts_lit_str(value: dispatch_class_loud)),
    js_classlist_call(method: "add", arg: ts_cond(
      test: ts_ident(name: "ok"),
      consequent: ts_lit_str(value: dispatch_class_ok),
      alternate: ts_lit_str(value: dispatch_class_refused),
    )),
    ts_if(
      cond: ts_binop(left: ts_ident(name: "band"), op: "===", right: ts_lit_str(value: "loud")),
      then: ts_block(stmts: [
        js_classlist_call(method: "add", arg: ts_lit_str(value: dispatch_class_loud)),
      ]),
      else_stmt: none,
    ),
    ts_const(name: "d", value: ts_binop(left: js_j_member(name: "detail"), op: "||", right: ts_lit_str(value: ""))),
    ts_const(name: "why", value: ts_cond(
      test: js_j_member(name: "step"),
      consequent: ts_binop(
        left: ts_binop(left: js_j_member(name: "step"), op: "+", right: ts_lit_str(value: ": ")),
        op: "+",
        right: ts_ident(name: "d"),
      ),
      alternate: ts_binop(left: js_j_member(name: "reason"), op: "||", right: ts_lit_str(value: "")),
    )),
    ts_const(name: "base", value: ts_cond(
      test: ts_ident(name: "p"),
      consequent: ts_binop(
        left: ts_binop(left: ts_ident(name: "s"), op: "+", right: ts_lit_str(value: " · ")),
        op: "+",
        right: ts_ident(name: "p")),
      alternate: ts_binop(left: ts_ident(name: "s"), op: "||", right: ts_lit_str(value: "no status")))),
    ts_expr_stmt(expr: ts_binop(
      left: js_b_member(name: "title"),
      op: "=",
      right: ts_cond(
        test: ts_ident(name: "why"),
        consequent: ts_binop(
          left: ts_binop(left: ts_ident(name: "base"), op: "+", right: ts_lit_str(value: " — ")),
          op: "+",
          right: ts_ident(name: "why"),
        ),
        alternate: ts_ident(name: "base"),
      ),
    )),
    ts_const(name: "expandRow", value: dispatch_expand_chain_expr()),
    ts_const(name: "rowEl", value: ts_call(callee: js_b_member(name: "closest"), args: [ts_lit_str(value: "li")])),
    ts_const(name: "dt", value: ts_binop(
      left: ts_ident(name: "rowEl"),
      op: "&&",
      right: ts_call(
        callee: ts_member(object: ts_ident(name: "rowEl"), property: "querySelector"),
        args: [ts_lit_str(value: "details.item-detail")]),
    )),
    ts_if(
      cond: ts_binop(left: ts_ident(name: "expandRow"), op: "&&", right: ts_ident(name: "dt")),
      then: ts_block(stmts: [
        ts_expr_stmt(expr: ts_binop(
          left: ts_member(object: ts_ident(name: "dt"), property: "open"),
          op: "=",
          right: ts_ident(name: "true"))),
      ]),
      else_stmt: none,
    ),
    ts_if(
      cond: ts_binop(
        left: ts_binop(left: ts_ident(name: "band"), op: "===", right: ts_lit_str(value: "loud")),
        op: "&&",
        right: ts_ident(name: "dt")),
      then: ts_block(stmts: [
        ts_let(name: "rl", value: ts_call(
          callee: ts_member(object: ts_ident(name: "dt"), property: "querySelector"),
          args: [ts_lit_str(value: ".disclosure-reason")])),
        ts_if(
          cond: ts_prefix(op: "!", expr: ts_ident(name: "rl")),
          then: ts_block(stmts: [
            ts_expr_stmt(expr: ts_binop(
              left: ts_ident(name: "rl"),
              op: "=",
              right: ts_call(
                callee: ts_member(object: ts_ident(name: "document"), property: "createElement"),
                args: [ts_lit_str(value: "div")]))),
            ts_expr_stmt(expr: ts_binop(
              left: ts_member(object: ts_ident(name: "rl"), property: "className"),
              op: "=",
              right: ts_lit_str(value: "disclosure-reason"))),
            ts_const(name: "sm", value: ts_call(
              callee: ts_member(object: ts_ident(name: "dt"), property: "querySelector"),
              args: [ts_lit_str(value: "summary")])),
            ts_expr_stmt(expr: ts_binop(
              left: ts_ident(name: "sm"),
              op: "&&",
              right: ts_call(
                callee: ts_member(object: ts_ident(name: "sm"), property: "insertAdjacentElement"),
                args: [ts_lit_str(value: "afterend"), ts_ident(name: "rl")]))),
          ]),
          else_stmt: none,
        ),
        ts_expr_stmt(expr: ts_binop(
          left: ts_member(object: ts_ident(name: "rl"), property: "textContent"),
          op: "=",
          right: ts_binop(
            left: ts_ident(name: "why"),
            op: "||",
            right: ts_lit_str(value: "belt fault — no located reason on the wire")))),
      ]),
      else_stmt: none,
    ),
    ts_if(
      cond: ts_prefix(op: "!", expr: ts_ident(name: "ok")),
      then: ts_block(stmts: [
        ts_expr_stmt(expr: ts_call(
          callee: ts_member(object: ts_ident(name: "console"), property: "log"),
          args: [ts_lit_str(value: "dispatch refused"), ts_ident(name: "j")],
        )),
      ]),
      else_stmt: none,
    ),
    ts_if(
      cond: ts_ident(name: "ok"),
      then: ts_block(stmts: [
        ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_refresh_sessions_fn), args: [])),
        ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_refresh_attempts_fn), args: [])),
        ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_refresh_workflow_fn), args: [])),
      ]),
      else_stmt: none,
    ),
    ts_expr_stmt(expr: ts_binop(left: js_b_member(name: "disabled"), op: "=", right: ts_ident(name: "false"))),
  ])
}

fn dispatch_response_handler_body() -> TsStmt {
  ts_block(stmts: [
    ts_expr_stmt(expr: ts_binop(
      left: ts_member(object: js_b_member(name: "dataset"), property: "status"),
      op: "=",
      right: ts_binop(left: js_j_status(), op: "||", right: ts_lit_str(value: "")),
    )),
    ts_const(name: "apply", value: ts_arrow(params: [], body: dispatch_terminal_apply_body())),
    ts_expr_stmt(expr: ts_call(
      callee: ts_ident(name: "setTimeout"),
      args: [ts_ident(name: "apply"), dwell_remaining_expr()],
    )),
  ])
}

fn dispatch_click_handler_body(url_expr: TsExpr) -> TsStmt {
  ts_block(stmts: [
    ts_expr_stmt(expr: ts_binop(left: js_b_member(name: "disabled"), op: "=", right: ts_ident(name: "true"))),
    ts_const(name: "t0", value: ts_call(callee: ts_member(object: ts_ident(name: "Date"), property: "now"), args: [])),
    ts_expr_stmt(expr: ts_binop(left: js_b_member(name: "textContent"), op: "=", right: ts_lit_str(value: dispatch_caption_requested))),
    js_classlist_call(method: "remove", arg: ts_lit_str(value: dispatch_class_ok)),
    js_classlist_call(method: "remove", arg: ts_lit_str(value: dispatch_class_refused)),
    js_classlist_call(method: "remove", arg: ts_lit_str(value: dispatch_class_loud)),
    js_classlist_call(method: "add", arg: ts_lit_str(value: dispatch_class_requested)),
    ts_expr_stmt(expr: ts_binop(left: js_b_member(name: "title"), op: "=", right: ts_lit_str(value: ""))),
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(
        object: ts_call(
          callee: ts_member(
            object: ts_call(
              callee: ts_member(
                object: ts_call(
                  callee: ts_ident(name: "fetch"),
                  args: [url_expr, ts_object(fields: [ts_field(key: "method", value: ts_lit_str(value: "POST"))])],
                ),
                property: "then",
              ),
              args: [ts_arrow(params: ["r"], body: ts_expr_stmt(expr: ts_call(callee: ts_member(object: ts_ident(name: "r"), property: "json"), args: [])))],
            ),
            property: "then",
          ),
          args: [ts_arrow(params: ["j"], body: dispatch_response_handler_body())],
        ),
        property: "catch",
      ),
      args: [ts_arrow(params: ["e"], body: ts_block(stmts: [
        ts_const(name: "applyErr", value: ts_arrow(params: [], body: ts_block(stmts: [
          ts_expr_stmt(expr: ts_binop(left: js_b_member(name: "textContent"), op: "=", right: ts_lit_str(value: dispatch_caption_loud))),
          js_classlist_call(method: "remove", arg: ts_lit_str(value: dispatch_class_requested)),
          js_classlist_call(method: "add", arg: ts_lit_str(value: dispatch_class_refused)),
          js_classlist_call(method: "add", arg: ts_lit_str(value: dispatch_class_loud)),
          ts_expr_stmt(expr: ts_binop(left: js_b_member(name: "title"), op: "=", right: ts_lit_str(value: "network error"))),
          ts_expr_stmt(expr: ts_binop(left: js_b_member(name: "disabled"), op: "=", right: ts_ident(name: "false"))),
        ]))),
        ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "setTimeout"), args: [ts_ident(name: "applyErr"), dwell_remaining_expr()])),
      ]))],
    )),
  ])
}

data pointerdown_tick_isolation_note: String = "The tick rides its OWN pointerdown listener rather than living inside the click handler, and the separation is load-bearing in two independent ways.

MECHANICALLY it is when the sound belongs. Acknowledgment is owed to the press, not the release — the video-game rule the whole register follows — and pointerdown is the event that fires as the control starts travelling, in the same frame the CSS :active depression begins. Putting the tick in the click handler would fire it on RELEASE, so the sound and the visible travel would disagree about when the mechanism engaged.

SAFETY-WISE it means a sound failure cannot break dispatch. Two listeners on one element are independent: if WebAudio is unavailable or throws in some browser, the exception is contained in the tick listener and the click listener still POSTs. Had the tick been a statement inside the click handler, a throw would have aborted the dispatch before the fetch — trading a working button for a decorative noise, which is exactly the wrong direction. This is also why no capability probe or try/catch appears here: the isolation makes the failure harmless, so there is nothing to degrade gracefully around and no silent fallback to write."

fn dispatch_bind_statements(selector: String, url_expr: TsExpr) -> List<TsStmt> {
  [
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(
        object: ts_call(
          callee: ts_member(object: ts_ident(name: "document"), property: "querySelectorAll"),
          args: [ts_lit_str(value: selector)],
        ),
        property: "forEach",
      ),
      args: [ts_arrow(params: ["b"], body: ts_block(stmts: [
        ts_expr_stmt(expr: ts_call(
          callee: js_b_member(name: "addEventListener"),
          args: [
            ts_lit_str(value: "pointerdown"),
            ts_arrow(params: [], body: ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_tick_fn), args: []))),
          ],
        )),
        ts_expr_stmt(expr: ts_call(
          callee: js_b_member(name: "addEventListener"),
          args: [ts_lit_str(value: "click"), ts_arrow(params: [], body: dispatch_click_handler_body(url_expr: url_expr))],
        )),
      ]))],
    )),
  ]
}

data swatch_toggle_note: String = "The auditioner control (remodel W1f): cycles the active swatch set island-pastel -> okabe-ito -> solarized -> island-pastel, persisted like the mute because a palette audition is a property of these eyes. island is the ABSENT attribute (the emitted default); a named set pins data-swatch-set, which the audition blocks in roadmap_style answer. Rendered only on /sandbox (the design surface owns auditioning) but applied by the shared client program on load, so a choice made in the sandbox follows the operator to the live roadmap — auditioning against real content, not specimens."

data swatch_storage_key: String = "gunbc.swatch-set"
data swatch_toggle_class: String = "swatch-toggle"
data swatch_default_set_value: String = "okabe-ito"
data swatch_audition_a: String = "island-pastel"
data swatch_audition_b: String = "solarized"
data swatch_audition_values: List<String> = [swatch_audition_a, swatch_audition_b]
data swatch_toggle_label_prefix: String = "swatches · "

fn swatch_toggle_labels() -> List<String> {
  map(concat([swatch_default_set_value], swatch_audition_values),
    v => join([swatch_toggle_label_prefix, v], ""))
}

fn swatch_toggle_reserved_width() -> String {
  css_length_wire(l: css_ch(n: dispatch_reserved_ch_for(labels: swatch_toggle_labels())))
}

