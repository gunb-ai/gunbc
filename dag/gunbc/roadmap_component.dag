fn js_motion_clear_timer_statements() -> List<extdeps.languages.typescript.program.TsStmt> {
  [
    ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "clearInterval"), args: [ts_ident(name: js_motion_timer_var)])),
    js_motion_assign(target: ts_ident(name: js_motion_timer_var), value: ts_ident(name: "null")),
  ]
}

fn motion_play_fn_statement() -> extdeps.languages.typescript.program.TsStmt {
  ts_const(
    name: js_motion_play_fn,
    value: ts_arrow(params: ["wire"], body: ts_block(stmts: [
      js_motion_guard(cond: ts_prefix(op: "!", expr: ts_ident(name: js_motion_plate_var))),
      js_motion_guard(cond: ts_binop(
        left: ts_ident(name: js_motion_interval_var),
        op: "<=",
        right: ts_lit_num(text: "0"),
      )),
      ts_if(
        cond: ts_binop(left: ts_ident(name: js_motion_timer_var), op: "!==", right: ts_ident(name: "null")),
        then: ts_block(stmts: js_motion_clear_timer_statements()),
        else_stmt: none,
      ),
      ts_const(
        name: "frames",
        value: ts_call(
          callee: ts_member(object: ts_ident(name: "wire"), property: "split"),
          args: [ts_lit_str(value: ",")],
        ),
      ),
      ts_let(name: "i", value: ts_lit_num(text: "0")),
      js_motion_assign(
        target: ts_ident(name: js_motion_timer_var),
        value: ts_call(
          callee: ts_ident(name: "setInterval"),
          args: [
            ts_arrow(params: [], body: ts_block(stmts: [
              ts_if(
                cond: ts_binop(
                  left: ts_ident(name: "i"),
                  op: ">=",
                  right: ts_member(object: ts_ident(name: "frames"), property: "length"),
                ),
                then: ts_block(stmts: concat(
                  js_motion_clear_timer_statements(),
                  [ ts_return(expr: none) ],
                )),
                else_stmt: none,
              ),
              js_motion_set_translate(px: ts_index(object: ts_ident(name: "frames"), index: ts_ident(name: "i"))),
              js_motion_assign(
                target: ts_ident(name: "i"),
                value: ts_binop(left: ts_ident(name: "i"), op: "+", right: ts_lit_num(text: "1")),
              ),
            ])),
            ts_ident(name: js_motion_interval_var),
          ],
        ),
      ),
    ])),
  )
}

