    args: [
      ts_lit_str(value: "click"),
      ts_arrow(params: ["e"], body: ts_block(stmts: [
        ts_const(name: "t", value: ts_member(object: ts_ident(name: "e"), property: "target")),
        js_motion_guard(cond: ts_binop(
          left: ts_prefix(op: "!", expr: ts_ident(name: "t")),
          op: "||",
          right: ts_prefix(op: "!", expr: ts_member(object: ts_ident(name: "t"), property: "closest")),
        )),
        ts_const(
          name: "btn",
          value: ts_call(
            callee: ts_member(object: ts_ident(name: "t"), property: "closest"),
            args: [ts_lit_str(value: join(["[", motion_frame_data_attr, "]"], ""))],
          ),
        ),
        js_motion_guard(cond: ts_prefix(op: "!", expr: ts_ident(name: "btn"))),
        ts_const(
          name: "wire",
          value: ts_call(
            callee: ts_member(object: ts_ident(name: "btn"), property: "getAttribute"),
            args: [ts_cond(
              test: ts_ident(name: js_motion_reduced_var),
              consequent: ts_lit_str(value: motion_reduced_frame_data_attr),
              alternate: ts_lit_str(value: motion_frame_data_attr),
            )],
          ),
        ),
        js_motion_guard(cond: ts_prefix(op: "!", expr: ts_ident(name: "wire"))),
        ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_motion_play_fn), args: [ts_ident(name: "wire")])),
      ])),
    ],
  ))
}

data motion_devicemotion_probe_note: String = "The DeviceMotion route, reported as three separable facts because they fail separately: whether the interface exists at all, whether the permission gate answered, and what the stream actually delivered over a measured window. A silent stream reports zero events over its window — it does NOT report an absent sensor, because a window that produced nothing and an interface that does not exist are different observations and only one of them was made."

fn motion_devicemotion_listen_statements() -> List<extdeps.languages.typescript.program.TsStmt> {
  [
    ts_let(name: "events", value: ts_lit_num(text: "0")),
    ts_let(name: "valued", value: ts_lit_num(text: "0")),
    ts_const(name: "t0", value: js_motion_now()),
    ts_const(name: "h", value: ts_arrow(params: ["ev"], body: ts_block(stmts: [
      js_motion_assign(
        target: ts_ident(name: "events"),
        value: ts_binop(left: ts_ident(name: "events"), op: "+", right: ts_lit_num(text: "1")),
      ),
      ts_const(name: "a", value: ts_member(object: ts_ident(name: "ev"), property: device_motion_acceleration_property)),
      js_motion_count_if(
        cond: ts_binop(
          left: ts_ident(name: "a"),
          op: "&&",
          right: js_motion_any_axis_valued(
            obj: ts_ident(name: "a"),
            x: device_motion_axis_x_property,
            y: device_motion_axis_y_property,
            z: device_motion_axis_z_property,
          ),
        ),
        counter: "valued",
      ),
    ]))),
    ts_expr_stmt(expr: ts_call(
      callee: ts_member(object: ts_ident(name: "window"), property: "addEventListener"),
      args: [ts_lit_str(value: devicemotion_event_type), ts_ident(name: "h")],
    )),
    js_motion_line_call(index: "0", text: ts_lit_str(value: join([device_motion_event_interface, " · listening"], ""))),
    js_motion_set_timeout(body: [
      ts_expr_stmt(expr: ts_call(
        callee: ts_member(object: ts_ident(name: "window"), property: "removeEventListener"),
        args: [ts_lit_str(value: devicemotion_event_type), ts_ident(name: "h")],
      )),
      js_motion_line_call(index: "0", text: js_motion_cat(parts: [
        ts_lit_str(value: join([device_motion_event_interface, " · "], "")),
        ts_ident(name: "events"),
        ts_lit_str(value: " events, "),
        ts_ident(name: "valued"),
        ts_lit_str(value: " carrying values, over "),
        ts_binop(left: js_motion_now(), op: "-", right: ts_ident(name: "t0")),
        ts_lit_str(value: "ms"),
      ])),
    ]),
  ]
}

fn motion_devicemotion_probe_statement() -> extdeps.languages.typescript.program.TsStmt {
  ts_const(
    name: js_motion_devicemotion_probe_fn,
    value: ts_arrow(params: [], body: ts_block(stmts: [
      ts_if(
        cond: js_motion_typeof_undefined(name: device_motion_event_interface),
        then: ts_block(stmts: [
          js_motion_line_call(
            index: "0",
            text: ts_lit_str(value: join([device_motion_event_interface, " · interface absent in this container"], "")),
          ),
          ts_return(expr: none),
        ]),
        else_stmt: none,
      ),
      ts_const(name: "listen", value: ts_arrow(params: [], body: ts_block(stmts: motion_devicemotion_listen_statements()))),
      ts_if(
        cond: ts_binop(
          left: ts_prefix(
            op: "typeof ",
            expr: ts_member(object: ts_ident(name: device_motion_event_interface), property: "requestPermission"),
          ),
          op: "===",
          right: ts_lit_str(value: "function"),
        ),
        then: ts_block(stmts: [
          ts_expr_stmt(expr: ts_call(
            callee: ts_member(
              object: ts_call(
                callee: ts_member(
                  object: ts_call(
                    callee: ts_member(
                      object: ts_ident(name: device_motion_event_interface),
                      property: "requestPermission",
                    ),
                    args: [],
                  ),
                  property: "then",
                ),
                args: [ts_arrow(params: ["st"], body: ts_block(stmts: [
                  ts_if(
                    cond: ts_binop(left: ts_ident(name: "st"), op: "===", right: ts_lit_str(value: permission_state_wire(s: PermissionGranted))),
                    then: ts_block(stmts: [
                      ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "listen"), args: [])),
                      ts_return(expr: none),
                    ]),
                    else_stmt: none,
                  ),
                  js_motion_line_call(index: "0", text: js_motion_cat(parts: [
                    ts_lit_str(value: join([device_motion_event_interface, " · permission "], "")),
                    ts_ident(name: "st"),
                  ])),
                ]))],
              ),
              property: "catch",
            ),
            args: [ts_arrow(params: ["err"], body: ts_block(stmts: [
              js_motion_line_call(index: "0", text: js_motion_cat(parts: [
                ts_lit_str(value: join([device_motion_event_interface, " · permission request refused · "], "")),
                ts_member(object: ts_ident(name: "err"), property: "name"),
              ])),
            ]))],
          )),
          ts_return(expr: none),
        ]),
        else_stmt: none,
      ),
      ts_expr_stmt(expr: ts_call(callee: ts_ident(name: "listen"), args: [])),
    ])),
  )
}

data motion_sensor_probe_note: String = "The Generic Sensor route, kept because it is the only one whose failures are NAMED. Construction itself can raise, so it is wrapped: a SecurityError from an insecure context or a blocking permissions policy becomes a located line rather than a fault that leaves the previous line standing. The refusal flag exists so an error observed during the window is not overwritten by the window's own summary — the first thing that actually happened is what the receipt keeps."

fn motion_sensor_probe_statement() -> extdeps.languages.typescript.program.TsStmt {
  ts_const(
    name: js_motion_sensor_probe_fn,
    value: ts_arrow(params: [], body: ts_block(stmts: [
      ts_if(
        cond: js_motion_typeof_undefined(name: accelerometer_interface_name(i: LinearAccelerationSensor)),
        then: ts_block(stmts: [
          js_motion_line_call(
            index: "1",
            text: ts_lit_str(value: join([
              accelerometer_interface_name(i: LinearAccelerationSensor),
              " · interface absent in this container",
            ], "")),
          ),
          ts_return(expr: none),
        ]),
        else_stmt: none,
      ),
      js_motion_assign(target: ts_ident(name: js_motion_sensor_refused_var), value: ts_ident(name: "false")),
      ts_try(
        body: ts_block(stmts: [
          ts_let(name: "readings", value: ts_lit_num(text: "0")),
          ts_let(name: "valued", value: ts_lit_num(text: "0")),
          ts_const(
            name: "s",
            value: ts_new(
              callee: ts_ident(name: accelerometer_interface_name(i: LinearAccelerationSensor)),
              args: [ts_object(fields: [ts_field(key: "frequency", value: ts_lit_num(text: "60"))])],
            ),
          ),
          ts_expr_stmt(expr: ts_call(
            callee: ts_member(object: ts_ident(name: "s"), property: "addEventListener"),
            args: [
              ts_lit_str(value: "error"),
              ts_arrow(params: ["ev"], body: ts_block(stmts: [
                js_motion_assign(target: ts_ident(name: js_motion_sensor_refused_var), value: ts_ident(name: "true")),
                js_motion_line_call(index: "1", text: js_motion_cat(parts: [
                  ts_lit_str(value: join([
                    accelerometer_interface_name(i: LinearAccelerationSensor), " · refused · ",
                  ], "")),
                  ts_member(object: ts_member(object: ts_ident(name: "ev"), property: "error"), property: "name"),
                ])),
              ])),
            ],
          )),
          ts_expr_stmt(expr: ts_call(
            callee: ts_member(object: ts_ident(name: "s"), property: "addEventListener"),
            args: [
              ts_lit_str(value: "reading"),
              ts_arrow(params: [], body: ts_block(stmts: [
                js_motion_assign(
                  target: ts_ident(name: "readings"),
                  value: ts_binop(left: ts_ident(name: "readings"), op: "+", right: ts_lit_num(text: "1")),
                ),
                js_motion_count_if(
                  cond: js_motion_any_axis_valued(
                    obj: ts_ident(name: "s"),
                    x: axis_x_property,
                    y: axis_y_property,
                    z: axis_z_property,
                  ),
                  counter: "valued",
                ),
              ])),
            ],
          )),
          ts_const(name: "t0", value: js_motion_now()),
          js_motion_line_call(
            index: "1",
            text: ts_lit_str(value: join([
              accelerometer_interface_name(i: LinearAccelerationSensor), " · ",
              sensor_lifecycle_key(s: SensorActivating),
            ], "")),
          ),
          ts_expr_stmt(expr: ts_call(callee: ts_member(object: ts_ident(name: "s"), property: "start"), args: [])),
          js_motion_set_timeout(body: [
            ts_expr_stmt(expr: ts_call(callee: ts_member(object: ts_ident(name: "s"), property: "stop"), args: [])),
            js_motion_guard(cond: ts_ident(name: js_motion_sensor_refused_var)),
            js_motion_line_call(index: "1", text: js_motion_cat(parts: [
              ts_lit_str(value: join([accelerometer_interface_name(i: LinearAccelerationSensor), " · "], "")),
              ts_ident(name: "readings"),
              ts_lit_str(value: " reading events, "),
              ts_ident(name: "valued"),
              ts_lit_str(value: " carrying values, over "),
              ts_binop(left: js_motion_now(), op: "-", right: ts_ident(name: "t0")),
              ts_lit_str(value: "ms · activated "),
              ts_member(object: ts_ident(name: "s"), property: "activated"),
            ])),
          ]),
        ]),
        catch_param: "err",
        handler: ts_block(stmts: [
          js_motion_assign(target: ts_ident(name: js_motion_sensor_refused_var), value: ts_ident(name: "true")),
          js_motion_line_call(index: "1", text: js_motion_cat(parts: [
            ts_lit_str(value: join([
              accelerometer_interface_name(i: LinearAccelerationSensor), " · construction refused · ",
            ], "")),
            ts_member(object: ts_ident(name: "err"), property: "name"),
          ])),
        ]),
      ),
    ])),
  )
}

fn motion_probe_bind_statement() -> extdeps.languages.typescript.program.TsStmt {
  ts_const(name: "motionProbeBtn", value: js_motion_get_by_id(id: motion_probe_run_id))
}

fn motion_probe_bind_statements() -> List<extdeps.languages.typescript.program.TsStmt> {
  [
    motion_probe_bind_statement(),
    ts_if(
      cond: ts_ident(name: "motionProbeBtn"),
      then: ts_expr_stmt(expr: ts_call(
        callee: ts_member(object: ts_ident(name: "motionProbeBtn"), property: "addEventListener"),
        args: [
          ts_lit_str(value: "click"),
          ts_arrow(params: [], body: ts_block(stmts: [
            ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_motion_devicemotion_probe_fn), args: [])),
            ts_expr_stmt(expr: ts_call(callee: ts_ident(name: js_motion_sensor_probe_fn), args: [])),
          ])),
        ],
      )),
      else_stmt: none,
    ),
  ]
}

fn instrument_motion_client_program() -> extdeps.languages.typescript.program.TsProgram {
  extdeps.languages.typescript.program.TsProgram {
    ts_nocheck: false,
    header_lines: [
      "gunbc instrument motion lab — emitted from gunbc.roadmap_component.instrument_motion_client_program",
      "Replays a decided frame sequence; reports two probes as exact observations. No physics, no verdicts.",
    ],
    statements: concat(
      motion_preamble_statements(),
      concat(
        [
          motion_line_fn_statement(),
          motion_play_fn_statement(),
          motion_tap_bind_statement(),
          motion_devicemotion_probe_statement(),
          motion_sensor_probe_statement(),
        ],
        concat(
          motion_probe_bind_statements(),
          theme_toggle_bind_statements(),
        ),
      ),
    ),
  }
}

fn instrument_motion_client_js_source() -> String {
  serialize_typescript_program(p: instrument_motion_client_program())
}

fn dispatch_state_display_text(state: gunbc.design.component.ComponentState) -> String {
  match state.kind {
    IdleState => dispatch_caption_idle
    RequestedState => dispatch_caption_requested
    TerminalState { wire_label: wl, ok: ok } =>
      if ok {
        concat(dispatch_ack_prefix, dispatch_ack_word)
      } else if wl == belt_dispatch_disabled_status_label() {
        concat(dispatch_ack_prefix, wl)
      } else if belt_dispatch_label_band_key(wire_label: wl) == "loud" {
        dispatch_caption_loud
      } else {
        dispatch_caption_fail
      }
  }
}
