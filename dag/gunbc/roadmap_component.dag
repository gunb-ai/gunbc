                  workflow_set_all_observations_stmt(
                    lamp: AttemptedWorkflowLamp,
                    state: ClientObservationOff,
                    reason_expr: ts_lit_str(value: "")),
                ],
                concat(
                  attempts_clear_rendered_stmts(),
                  [
                    ts_expr_stmt(expr: ts_call(
                      callee: ts_member(object: ts_member(object: ts_ident(name: "aj"), property: "attempts"), property: "forEach"),
                      args: [ts_arrow(params: ["att"], body: ts_block(stmts: attempts_mark_stmts()))])),
