data swatch_toggle_label_prefix: String = "swatches · "

fn swatch_toggle_labels() -> List<String> {
  map(concat([swatch_default_set_value], swatch_audition_values),
    v => join([swatch_toggle_label_prefix, v], ""))
}

fn swatch_toggle_reserved_width() -> String {
  css_length_wire(l: css_ch(n: dispatch_reserved_ch_for(labels: swatch_toggle_labels())))
}

