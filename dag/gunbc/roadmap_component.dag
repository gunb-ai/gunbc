fn instrument_tuner_mode_btn_apply_stmt() -> extdeps.languages.typescript.program.TsStmt {
  ts_expr_stmt(expr: ts_call(
    callee: ts_member(object: js_instrument_query_all(class_name: instrument_mode_btn_class), property: "forEach"),
    args: [ts_arrow(params: ["b"], body: ts_block(stmts: [
      js_instrument_toggle_class_on(
        el: "b",
        cls: "is-active",
        on: ts_binop(
          left: ts_call(
            callee: ts_member(object: ts_ident(name: "b"), property: "getAttribute"),
