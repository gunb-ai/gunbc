// THE ONE ENTRY POINT. Everything an operator would otherwise do in a console is reachable from
// here, and the sequence is the dependency order rather than a preference: the APIs cannot be
// enabled before the project exists, the writer cannot be created before the project, the writer
// cannot be added to a drive before it exists, and no sheet may be created before the writer can
// see the drive it goes in.
//
// THE PROJECT STEP IS NOT CALLED HERE, and that is a deliberate refusal rather than an omission.
// Creating a project needs org-level authority that the writer will never hold, so folding it into
// the same run would mean this entry point only ever succeeds under an org admin's credential --
// which is precisely the standing privilege the estate's blast-radius discipline avoids. The
// project step stays a separately invoked converge run by whoever holds that authority.
//
// WHY THE STEPS DO NOT SHORT-CIRCUIT ON THE FIRST REFUSAL. A run that stops at the first problem
// reports one obstacle per invocation, so an operator clears four in four rounds. Each step here
// is observed independently and every outcome is reported, so one run names everything standing
// between the current state and a converged one.

type ReviewSheetConvergeReport {
  sheets_api: ServiceEnableOutcome
  drive_api: ServiceEnableOutcome
  writer: ServiceAccountConvergeOutcome
  membership: MembershipConvergeOutcome
  spreadsheet: SpreadsheetConvergeOutcome
}

data review_sheet_writer_account_id: NonEmptyStr = "review-sheet-writer"

data review_sheet_writer_display_name: NonEmptyStr = "Review sheet writer (Sheets only, shared-drive member)"


// A residency that is not a shared drive cannot be converged by this entry point, and saying so is
// better than converging something else: a My Drive sheet needs a per-sheet share that this run
// does not perform, and an unobserved residency has no drive to read at all.
type ResidencyDriveResolution
  = DriveResolved { drive_id: NonEmptyStr }
  | DriveUnresolved { cause: NonEmptyStr }

fn residency_drive(residency: ReviewSheetResidency) -> ResidencyDriveResolution {
  match residency {
    SheetInSharedDrive { drive_id: id, drive_name: _ } => DriveResolved { drive_id: id }
    SheetInOwnerMyDrive =>
      DriveUnresolved {
        cause: "residency is a My Drive sheet, whose access is a per-sheet share this converge does not perform" as NonEmptyStr
      }
    ResidencyUnobserved =>
      DriveUnresolved {
        cause: "residency is unobserved; no drive has been recorded to converge against" as NonEmptyStr
      }
  }
}

type CallingHomeResolution
  = HomeResolved { project_id: GcpProjectId, writer: ServiceAccountEmail }
  | HomeUnresolved { cause: NonEmptyStr }

fn calling_home_resolution() -> CallingHomeResolution {
  match sheets_calling_home() {
    SheetsCallingHomeSelected {
      project_id: p,
      writer: w,
      refused_api_surface_project: _,
      refused_writer: _,
    } => HomeResolved { project_id: p, writer: w }
    SheetsCallingHomeUnresolved {
      refused_api_surface_project: _,
      refused_writer: _,
      candidate_writer_in_secrets: _,
      kitchen_sink_project: _,
      pool_host_without_sts: _,
      sts_host_without_sheets: _,
    } =>
      HomeUnresolved {
        cause: "sheets_calling_home is unresolved; no project has been selected to converge against" as NonEmptyStr
      }
  }
}

fn converge_review_sheet_all(
  token: Secret,
  project_id: GcpProjectId,
  writer: ServiceAccountEmail,
  drive_id: NonEmptyStr,
  kind: ReviewSheetKind,
  policy: EnsurePolicy,
) -> ReviewSheetConvergeReport {
  let sheets_api = converge_service_enablement(
    token: token,
    project_id: project_id,
    service_id: sheets_serviceusage_api_id,
    policy: policy,
  )
  let drive_api = converge_service_enablement(
    token: token,
    project_id: project_id,
    service_id: drive_serviceusage_api_id,
    policy: policy,
  )
  let writer_account = converge_service_account(
    token: token,
    project_id: project_id,
    account_id: review_sheet_writer_account_id,
    display_name: review_sheet_writer_display_name,
    sa_email: writer,
    policy: policy,
  )
  let membership = converge_drive_membership(
    drive_id: drive_id,
    writer: writer,
    policy: policy,
  )
  let spreadsheet = converge_review_spreadsheet(
    drive_id: drive_id,
    sheet_name: kind.sheet_name,
    marker_value: kind.marker_value,
    policy: policy,
  )
  ReviewSheetConvergeReport {
    sheets_api: sheets_api,
    drive_api: drive_api,
    writer: writer_account,
    membership: membership,
    spreadsheet: spreadsheet,
  }
}

// CONVERGED IS NARROWER THAN "NOT REFUSED". An accepted long-running enable and an unverified
// create are both progress and neither is a converged state, so both leave this false and the run
// exits non-zero. An operator re-running after an accepted enable is the intended path.
fn service_enable_is_converged(o: ServiceEnableOutcome) -> Bool {
  match o {
    ServiceAlreadyEnabled { service_id: _ } => true
    ServiceEnableAccepted { service_id: _, operation_name: _ } => false
    ServiceEnableRefused { cause: _ } => false
  }
}

fn service_account_is_converged(o: ServiceAccountConvergeOutcome) -> Bool {
  match o {
    ServiceAccountAlreadyPresent { email: _ } => true
    ServiceAccountCreatedAndVerified { email: _ } => true
    ServiceAccountCreateUnverified { cause: _ } => false
    ServiceAccountConvergeRefused { cause: _ } => false
  }
}

fn membership_is_converged(o: MembershipConvergeOutcome) -> Bool {
  match o {
    MembershipAlreadyHeld { role: _ } => true
    MembershipGrantedAndVerified { role: _ } => true
    MembershipGrantUnverified { cause: _ } => false
    MembershipConvergeRefused { cause: _ } => false
  }
}

fn spreadsheet_is_converged(o: SpreadsheetConvergeOutcome) -> Bool {
  match o {
    SpreadsheetAdopted { file_id: _ } => true
    SpreadsheetAdoptedByDeclaredId { file_id: _ } => true
    SpreadsheetCreatedAndVerified { file_id: _ } => true
    SpreadsheetCreateUnverified { cause: _ } => false
    SpreadsheetConvergeRefused { cause: _ } => false
  }
}

fn report_is_converged(r: ReviewSheetConvergeReport) -> Bool {
  service_enable_is_converged(o: r.sheets_api)
    && service_enable_is_converged(o: r.drive_api)
    && service_account_is_converged(o: r.writer)
    && membership_is_converged(o: r.membership)
    && spreadsheet_is_converged(o: r.spreadsheet)
}

fn service_enable_text(o: ServiceEnableOutcome) -> String {
  match o {
    ServiceAlreadyEnabled { service_id: s } => join(["already enabled: ", s as String], "")
    ServiceEnableAccepted { service_id: s, operation_name: op } =>
      join(["enable ACCEPTED (not yet on): ", s as String, " via ", op], "")
    ServiceEnableRefused { cause: c } => join(["REFUSED: ", c as String], "")
  }
}

fn service_account_text(o: ServiceAccountConvergeOutcome) -> String {
  match o {
    ServiceAccountAlreadyPresent { email: e } => join(["already present: ", e as String], "")
    ServiceAccountCreatedAndVerified { email: e } => join(["created and verified: ", e as String], "")
    ServiceAccountCreateUnverified { cause: c } => join(["UNVERIFIED: ", c as String], "")
    ServiceAccountConvergeRefused { cause: c } => join(["REFUSED: ", c as String], "")
  }
}

fn report_text(r: ReviewSheetConvergeReport) -> String {
  join(
    [
      "sheets api: ", service_enable_text(o: r.sheets_api),
      "\ndrive api:  ", service_enable_text(o: r.drive_api),
      "\nwriter:     ", service_account_text(o: r.writer),
      "\nmembership: ", membership_outcome_text(o: r.membership),
      "\nsheet:      ", spreadsheet_outcome_text(o: r.spreadsheet),
    ],
    "",
  )
}

// THERE IS NO ARGV ENTRY POINT HERE, AND THE ONE THAT WAS HERE IS DELETED RATHER THAN DOCUMENTED.
// It took the operator credential as a CLI argument, which is exactly what gunbc.credential_argv_exposure
// measures on this fleet -- cmdline is 0444 and runner slots share the host pid namespace, so an
// argv word is readable by any job payload a pull request can influence. The comment on it admitted
// the hazard and carried on, which is the escape hatch DESIGN section 5 refuses: a toggle whose only
// effect is to proceed as if the refusal had not fired.
//
// It was also a SECOND PATH beside a modelled one. The Drive and Sheets services read their
// credential in-process through auth_source, converge_drive_half_cli takes no arguments at all, and
// those two facts together mean an argv-free entry was not merely possible but already written six
// lines below. A parallel authority that is strictly worse than the route beside it is not a
// compatibility arm; it is the one a hurried reader will copy.
//
// What is genuinely missing is an argv-free way to reach the GCP steps, whose operations take their
// token as an operation input because they are shared with consumers this lane does not own. That
// gap is real and is NOT closed by this deletion -- converge_review_sheet_all remains callable by a
// caller that can supply a Secret. The declarations it alone reaches are rostered, with that
// trigger, in review_sheet_whole_estate_consumer_frontier_rows at the foot of this module; this
// annotation deliberately does not restate the set, because the row is the authority and a second
// copy here would rot against it.
fn converge_report_exit(report: ReviewSheetConvergeReport) -> ProcessExit {
  if report_is_converged(r: report) {
    ExitSuccess
  } else {
    exit_failure(reason: report_text(r: report))
  }
}


// THE DRIVE HALF ALONE, AND THE ENTRY POINT THAT TAKES NO ARGUMENTS AT ALL. The GCP steps read a
// token as an operation input, so this entry does not reach them; the Drive operations read theirs
// at the transport from GUNBC_REVIEW_SHEET_TOKEN, which the review_sheet_converge mode's delegation
// step sets, so this entry has nothing a caller could put on a command line. That is the point: gunbc
// run passes arguments only as argv, and on this fleet an argv word is readable by any job payload a
// pull request can influence. A hand-exported token is break-glass only
// (gunbc.review_sheet_federation review_sheet_hand_minted_token_break_glass).
//
// IT CONVERGES EVERY KIND IN THE ROSTER, AND HOLDS THE NAME OF NONE. Which kinds exist is
// gunbc.review_sheet_kind_roster; what each one is -- its file name, marker, tabs, schemas, rules
// and rows -- is the kind value. So a new kind is a roster row and this module does not change,
// and the entry stays argv-free because choosing a kind is not an argument either. Each kind is
// converged independently and reported, so one kind's refusal does not hide another's state.
type ReviewTabHeader
  = TabHeaderWritten { outcome: ValuesWriteOutcome }
  | TabHeaderPresent
  | TabHeaderRefused { cause: NonEmptyStr }

type ReviewTabRowsOutcome
  = TabRowsAlreadyConverged
  | TabRowsWritten { receipt: ReviewSheetWriteReceipt }
  | TabRowsLeftToWriter { writer: NonEmptyStr }
  | TabRowsRefused { cause: NonEmptyStr }

type ReviewTabReport {
  title: NonEmptyStr
  header: ReviewTabHeader
  rows: ReviewTabRowsOutcome
  format: FormatDisposition
}

type ReviewSheetKindSheet
  = KindSheetConverged { tab_set: TabSetConvergeOutcome, tabs: List<ReviewTabReport> }
  | KindSheetSkipped { cause: NonEmptyStr }

type ReviewSheetKindReport {
  kind_id: NonEmptyStr
  spreadsheet: SpreadsheetConvergeOutcome?
  sheet: ReviewSheetKindSheet
}

type DriveHalfReport {
  membership: MembershipConvergeOutcome
  kinds: List<ReviewSheetKindReport>
}

// THE HEADER IS WRITTEN ONLY INTO AN EMPTY TAB, through the sealed header-init plan. An occupied tab
// already has a header, and whether it is THIS schema's header is the row converge's question: its
// classification refuses a missing or duplicated header before any row is written, so a header the
// operator edited is a loud refusal there and never a rewrite here.
fn converge_review_tab_header(
  spreadsheet_id: NonEmptyStr,
  at: AdmittedReviewSheetTab,
  policy: EnsurePolicy,
) -> ReviewTabHeader {
  let plan = plan_header_init(
    reading: observe_formula_whole_tab(spreadsheet_id: spreadsheet_id, requested: review_sheet_get_values_request(tab: at.tab.title)),
    validated: at.validated,
  )
  match plan {
    HeaderInitTabOccupied { tab: _, first: _ } => TabHeaderPresent
    HeaderInitWriteHeaderRow { authorization: a } =>
      match policy {
        EnsureObserveOnly => TabHeaderRefused { cause: join(["observe-only, and the tab needs: ", header_init_plan_text(plan: plan)], "") as NonEmptyStr }
        EnsureMayApply => {
          let w = header_row_value_range_write(authorization: a)
          let written = converge_sheet_values(
            spreadsheet_id: spreadsheet_id,
            a1: w.range,
            desired: ValueRange { range: w.range, majorDimension: Present { value: w.majorDimension }, values: Present { value: w.values } },
          )
          match written {
            ValuesAlreadyMatch { rows: _ } => TabHeaderWritten { outcome: written }
            ValuesWrittenAndVerified { rows: _ } => TabHeaderWritten { outcome: written }
            ValuesWriteUnverified { cause: c } => TabHeaderRefused { cause: c }
            ValuesWriteRefused { cause: c } => TabHeaderRefused { cause: c }
          }
        }
      }
    HeaderInitHeaderRowUnaddressable { tab: _, header_count: _, addressable_columns: _ } =>
      TabHeaderRefused { cause: header_init_plan_text(plan: plan) as NonEmptyStr }
    HeaderInitTabTitleUnquotable { tab: _ } => TabHeaderRefused { cause: header_init_plan_text(plan: plan) as NonEmptyStr }
    HeaderInitObservationRefused { refusal: _ } => TabHeaderRefused { cause: header_init_plan_text(plan: plan) as NonEmptyStr }
  }
}

fn tab_header_is_established(h: ReviewTabHeader) -> Bool {
  match h {
    TabHeaderWritten { outcome: _ } => true
    TabHeaderPresent => true
    TabHeaderRefused { cause: _ } => false
  }
}

// THE ROWS GO THROUGH THE IDENTITY-KEYED ENSURE, NEVER A WHOLE-RANGE WRITE. The tab is read whole,
// classified against the projection by identity (a duplicated identity in the sheet or in the
// projection refuses there), and only derived cells are written; Ruling and Note are the operator's
// and no plan touches them. The write is verified by an independent re-read of the whole tab.
fn converge_review_tab_rows(
  spreadsheet_id: NonEmptyStr,
  at: AdmittedReviewSheetTab,
  policy: EnsurePolicy,
) -> ReviewTabRowsOutcome {
  match at.tab.rows {
    TabRowsWrittenElsewhere { writer: w } => TabRowsLeftToWriter { writer: w }
    TabRowsProjected { rows: rows } => {
      let requested = review_sheet_get_values_request(tab: at.tab.title)
      let projection = ReviewSheetProjection { schema: at.tab.schema, rows: rows }
      match sheet_a1_range_wire(range: requested) {
        A1TitleApostropheUnsupported { title: t } =>
          TabRowsRefused { cause: join(["tab ", t as String, " cannot be quoted in A1 notation"], "") as NonEmptyStr }
        A1RangeEncoded { wire: a1 } =>
          match read_values(spreadsheet_id: spreadsheet_id, a1: a1) {
            ValuesUnreadable { cause: c } => TabRowsRefused { cause: c }
            ValuesRead { range: got } =>
              match review_sheet_ensure_decide(
                policy: policy,
                assessment: review_sheet_ensure_assess(requested: requested, range: got, projection: projection, erasures: []),
              ) {
                Noop => TabRowsAlreadyConverged
                Refuse { reason: r } => TabRowsRefused { cause: r }
                Apply { plan: bound } =>
                  TabRowsWritten {
                    receipt: write_and_verify_review_sheet(spreadsheet_id: spreadsheet_id, bound: bound, projection: projection, erasures: []),
                  }
              }
          }
      }
    }
  }
}

fn tab_rows_is_converged(o: ReviewTabRowsOutcome) -> Bool {
  match o {
    TabRowsAlreadyConverged => true
    TabRowsWritten { receipt: r } =>
      match r {
        WriteVerifiedConverged { commit: _, observed: _ } => true
        WriteUnverified { commit: _, readback_assessment: _ } => false
        WriteNotCommitted { cause: _ } => false
      }
    TabRowsLeftToWriter { writer: _ } => true
    TabRowsRefused { cause: _ } => false
  }
}

fn tab_rows_text(o: ReviewTabRowsOutcome) -> String {
  match o {
    TabRowsAlreadyConverged => "rows: already the projection"
    TabRowsWritten { receipt: r } => join(["rows: ", review_sheet_write_receipt_text(receipt: r)], "")
    TabRowsLeftToWriter { writer: w } => join(["rows: written by ", w as String, ", not by this converge"], "")
    TabRowsRefused { cause: c } => join(["rows REFUSED: ", c as String], "")
  }
}

fn tab_header_text(h: ReviewTabHeader) -> String {
  match h {
    TabHeaderWritten { outcome: o } => join(["header: ", values_outcome_text(o: o)], "")
    TabHeaderPresent => "header: the tab is occupied; the row converge checks its header"
    TabHeaderRefused { cause: c } => join(["header REFUSED: ", c as String], "")
  }
}

// HEADER, THEN ROWS, THEN FORMAT, and each later step runs only on what the earlier one established:
// rows into a tab with no established header would be classified against a header that is not
// there, and formatting is keyed to the header row.
fn converge_review_tab(
  spreadsheet_id: NonEmptyStr,
  at: AdmittedReviewSheetTab,
  policy: EnsurePolicy,
) -> ReviewTabReport {
  let header = converge_review_tab_header(spreadsheet_id: spreadsheet_id, at: at, policy: policy)
  if tab_header_is_established(h: header) {
    let rows = converge_review_tab_rows(spreadsheet_id: spreadsheet_id, at: at, policy: policy)
    ReviewTabReport {
      title: at.tab.title,
      header: header,
      rows: rows,
      format: if tab_rows_is_converged(o: rows) {
        format_located_tab(file_id: spreadsheet_id, at: at)
      } else {
        FormatSkipped { cause: "the rows did not converge" as NonEmptyStr }
      },
    }
  } else {
    ReviewTabReport {
      title: at.tab.title,
      header: header,
      rows: TabRowsRefused { cause: "the header was not established" as NonEmptyStr },
      format: FormatSkipped { cause: "the header was not established" as NonEmptyStr },
    }
  }
}

fn review_tab_is_converged(r: ReviewTabReport) -> Bool {
  tab_header_is_established(h: r.header) && tab_rows_is_converged(o: r.rows) && format_disposition_is_applied(d: r.format)
}

fn review_tab_text(r: ReviewTabReport) -> String {
  join(["  tab ", r.title as String, ":\n    ", tab_header_text(h: r.header), "\n    ", tab_rows_text(o: r.rows), "\n    ", format_disposition_text(d: r.format)], "")
}

// THE SPREADSHEET IS ESTABLISHED BY MARKER, THEN ITS TAB SET, THEN EACH TAB. Formatting and rows
// run only on a spreadsheet this run established by readback, and only once the workbook carries
// exactly the kind's declared tabs: a tab the kind does not declare is a refusal, never a tab to
// ignore, and a missing one is created before anything is written to it.
fn converge_kind_sheet(file_id: NonEmptyStr, tabs: List<AdmittedReviewSheetTab>, kind: ReviewSheetKind, policy: EnsurePolicy) -> ReviewSheetKindSheet {
  let tab_set = converge_review_tab_set(spreadsheet_id: file_id, declared: review_sheet_kind_tab_titles(kind: kind), policy: policy)
  if tab_set_converge_is_converged(o: tab_set) {
    KindSheetConverged { tab_set: tab_set, tabs: map(tabs, at => converge_review_tab(spreadsheet_id: file_id, at: at, policy: policy)) }
  } else {
    KindSheetConverged { tab_set: tab_set, tabs: [] }
  }
}

fn converged_file_id(o: SpreadsheetConvergeOutcome) -> NonEmptyStr? {
  match o {
    SpreadsheetAdopted { file_id: id } => Present { value: id }
    SpreadsheetAdoptedByDeclaredId { file_id: id } => Present { value: id }
    SpreadsheetCreatedAndVerified { file_id: id } => Present { value: id }
    SpreadsheetCreateUnverified { cause: _ } => none
    SpreadsheetConvergeRefused { cause: _ } => none
  }
}

fn converge_review_sheet_kind(drive_id: NonEmptyStr, kind: ReviewSheetKind, policy: EnsurePolicy) -> ReviewSheetKindReport {
  match admit_review_sheet_kind(kind: kind) {
    ReviewSheetKindRefused { kind_id: k, cause: c } =>
      ReviewSheetKindReport { kind_id: k, spreadsheet: none, sheet: KindSheetSkipped { cause: c } }
    ReviewSheetKindAdmitted { kind: admitted, tabs: tabs } => {
      let spreadsheet = converge_review_spreadsheet(
        drive_id: drive_id,
        sheet_name: admitted.sheet_name,
        marker_value: admitted.marker_value,
        policy: policy,
      )
      ReviewSheetKindReport {
        kind_id: admitted.kind_id,
        spreadsheet: Present { value: spreadsheet },
        sheet: match converged_file_id(o: spreadsheet) {
          Present { value: id } => converge_kind_sheet(file_id: id, tabs: tabs, kind: admitted, policy: policy)
          Absent => KindSheetSkipped { cause: spreadsheet_outcome_text(o: spreadsheet) as NonEmptyStr }
        },
      }
    }
  }
}

fn converge_drive_half(
  drive_id: NonEmptyStr,
  writer: ServiceAccountEmail,
  kinds: List<ReviewSheetKind>,
  policy: EnsurePolicy,
) -> DriveHalfReport {
  let membership = converge_drive_membership(drive_id: drive_id, writer: writer, policy: policy)
  DriveHalfReport {
    membership: membership,
    kinds: if membership_is_converged(o: membership) {
      map(kinds, k => converge_review_sheet_kind(drive_id: drive_id, kind: k, policy: policy))
    } else {
      map(kinds, k => ReviewSheetKindReport { kind_id: k.kind_id, spreadsheet: none, sheet: KindSheetSkipped { cause: "the writer is not a member of the drive" as NonEmptyStr } })
    },
  }
}

fn kind_report_is_converged(r: ReviewSheetKindReport) -> Bool {
  match r.sheet {
    KindSheetSkipped { cause: _ } => false
    KindSheetConverged { tab_set: t, tabs: tabs } =>
      tab_set_converge_is_converged(o: t) && count(filter(tabs, tab => !review_tab_is_converged(r: tab))) == 0
  }
}

fn kind_report_text(r: ReviewSheetKindReport) -> String {
  let sheet_line = match r.spreadsheet {
    Present { value: o } => join(["  sheet: ", spreadsheet_outcome_text(o: o)], "")
    Absent => "  sheet: not converged"
  }
  let body = match r.sheet {
    KindSheetSkipped { cause: c } => join(["  SKIPPED: ", c as String], "")
    KindSheetConverged { tab_set: t, tabs: tabs } =>
      join(concat([join(["  ", tab_set_converge_text(o: t)], "")], map(tabs, tab => review_tab_text(r: tab))), "\n")
  }
  join(["kind ", r.kind_id as String, ":\n", sheet_line, "\n", body], "")
}

fn drive_half_is_converged(r: DriveHalfReport) -> Bool {
  membership_is_converged(o: r.membership) && count(filter(r.kinds, k => !kind_report_is_converged(r: k))) == 0
}

fn drive_half_text(r: DriveHalfReport) -> String {
  join(concat([join(["membership: ", membership_outcome_text(o: r.membership)], "")], map(r.kinds, k => kind_report_text(r: k))), "\n")
}

// THE WRITER TOKEN IS ESTABLISHED BEFORE ANY CALL, and it is minted by the run, not handed in. The
// review_sheet_converge fleet-converge mode federates and delegates (gunbc.review_sheet_federation),
// and a refused delegation stops here with the one cell that is missing, so a run with no grant
// writes nothing and never reports success.
fn converge_drive_half_cli() -> ProcessExit {
  let collisions = review_sheet_roster_collisions(kinds: review_sheet_kind_roster())
  if count(collisions) > 0 {
    exit_failure(reason: join(["the kind roster has kinds sharing an identity, marker or file name: ", join(map(collisions, k => k as String), ", ")], ""))
  } else {
    match observe_writer_token() {
      WriterTokenRefused { cause: c } => exit_failure(reason: c as String)
      WriterTokenMinted => converge_drive_half_roster()
    }
  }
}

fn converge_drive_half_roster() -> ProcessExit {
  match calling_home_resolution() {
    HomeUnresolved { cause: c } => exit_failure(reason: c as String)
    HomeResolved { project_id: _, writer: w } =>
      match residency_drive(residency: review_sheet_residency) {
        DriveUnresolved { cause: c } => exit_failure(reason: c as String)
        DriveResolved { drive_id: d } =>
          drive_half_exit(
            report: converge_drive_half(drive_id: d, writer: w, kinds: review_sheet_kind_roster(), policy: EnsureMayApply)
          )
      }
  }
}

// THE SKIP TEXT NAMES NO CAUSE OF ITS OWN, and that stopped being cosmetic when the locator
// landed. The carried cause already says why formatting did not run, so the prefix says only that.
type FormatDisposition
  = FormatAttempted { outcome: FormatConvergeOutcome }
  | FormatSkipped { cause: NonEmptyStr }

// TWO FACTS MUST BOTH BE ESTABLISHED BEFORE A SINGLE CELL IS FORMATTED, and they arrived from
// different directions: a sealed ValidatedHeaderSchema says what to write and a sealed
// LocatedReviewTab says where. The kind's admission validated the schema; the locator answers the
// one tab carrying the declared title, and only a TabLocated reaches the formatter. Absent,
// ambiguous and unreadable each skip formatting with the locator's own account of why, because
// formatting the wrong tab is a silent wrong answer and skipping is a loud one.
fn format_located_tab(file_id: NonEmptyStr, at: AdmittedReviewSheetTab) -> FormatDisposition {
  let standing = locate_review_tab(spreadsheet_id: file_id, title: at.tab.title)
  match standing {
    TabLocated { tab: t } =>
      FormatAttempted { outcome: converge_review_sheet_format(tab: t, validated: at.validated, rules: at.tab.rules, widths: review_sheet_tab_widths(tab: at.tab)) }
    TabAbsent => FormatSkipped { cause: review_tab_standing_text(s: standing) as NonEmptyStr }
    TabAmbiguous { candidates: _ } => FormatSkipped { cause: review_tab_standing_text(s: standing) as NonEmptyStr }
    TabUnreadable { cause: _ } => FormatSkipped { cause: review_tab_standing_text(s: standing) as NonEmptyStr }
  }
}

fn format_disposition_text(d: FormatDisposition) -> String {
  match d {
    FormatAttempted { outcome: o } => format_converge_text(o: o)
    FormatSkipped { cause: c } => join(["formatting skipped: ", c as String], "")
  }
}

fn format_disposition_is_applied(d: FormatDisposition) -> Bool {
  match d {
    FormatAttempted { outcome: o } => format_converge_is_converged(o: o)
    FormatSkipped { cause: _ } => false
  }
}

fn drive_half_exit(report: DriveHalfReport) -> ProcessExit {
  if drive_half_is_converged(r: report) {
    ExitSuccess
  } else {
    exit_failure(reason: drive_half_text(r: report))
  }
}

