module gunbc.host_converge_slice1


data gunbc_host_converge_slice1_scope_disposition: std.disposition.Disposition = std.disposition.Terminal {
  reason: "Host-converge realized knob: per_slot_tasks_max from fleet_converge_policy through typed systemctl show/set-property/list-units and clock_now_probed_at (LocalShell on-host, operator principal briansrls on srv1). MemoryMax/MemoryHigh drop-in authoring and system.control shadow teardown are deploy-time only (gunbc.host_axis_caps at live_deploy apply under ghrunner sudo) — convergence does NOT write /etc/systemd drop-ins, daemon-reload, set-property MemoryMax, or systemctl revert on the operator principal (operator privilege hold 2026-08-13). Ordering invariant (author derived drop-ins before shadow revert) is modeled in host_axis_caps for the deploy path. srv1 TasksMax on probe unit; srv3 multi-unit enumerated via runner_instance_glob. Per-unit outcomes are independent (DESIGN section 5 per-cause refusal / siblings continue). srv2 and other knobs stay on host_converge_realize frontier."
}

// Operator ruling 2026-08-13: MemoryMax single authority is deploy-time drop-in authoring
// (gunbc.host_axis_caps). Convergence must not re-apply it.
//
// TWO `data ...: Bool = true` FLAGS USED TO SIT HERE and they are deleted rather than moved.
// They claimed the converge-side apply was suppressed; their only readers were two witnesses
// asserting the literals, so what executed was `true && true`. Nothing in any production path
// consulted them, and the arm they described stayed wired the whole time
// (gunbc.host_converge_realize interpreted a PerSlotMemoryCap knob into a shell body and
// host_effect_realize ran it). The hold is now carried by the absence of that code path, which
// is the construction move the flags were standing in for — see
// gunbc.host_effect_realize converge_in_process_apply_withdrawn_reason.
data host_converge_slice1_memory_max_deploy_authority_note: String = "MemoryMax is authored at deploy through gunbc.host_axis_caps cap membership reconcile and drop-in upsert — not re-applied by gunbc converge. Dual authority (deploy drop-in vs converge set-property) is forbidden."

data host_converge_slice1_control_shadow_converge_note: String = "Aug-11 root-era set-property wrote /etc/systemd/system.control/<unit>.d/50-MemoryMax.conf and 50-MemoryHigh.conf; those drop-ins shadow deploy-authored files until removed. Teardown ordering is author derived drop-ins from gunbc.runner_slot_allocation THEN systemctl revert MemoryMax MemoryHigh — modeled in gunbc.host_axis_caps for the deploy apply path (ghrunner sudo), not gunbc converge on briansrls. Revert-before-author on stale 16/15GiB on-disk deploy drop-ins raises effective caps to the superseded regime."

data host_converge_slice1_cap_author_before_shadow_revert_enforced: Bool = true

fn host_converge_slice1_shadow_revert_script_matches_authority(unit: std.types.NonEmptyStr) -> Bool {
  gunbc.host_axis_caps.control_shadow_revert_script_matches_extdeps_argv(u: gunbc.host_axis_caps.control_shadow_unit(unit: unit))
}

data host_converge_slice1_probe_unit: std.types.NonEmptyStr = "actions-runner@srv1-01.service"

data host_converge_slice1_knob_name: String = "per_slot_memory_max_bytes"

data host_converge_slice1_tasks_knob_name: String = "per_slot_tasks_max"

// TasksMax (gunbc.runner_slot_allocation gunbc_runner_slot_desired, 16384 — the
// 2026-06-21 incident REPAIR value; 512 was the diagnosed EAGAIN outage value, per the
// operator ruling on PR 8045) is the second knob realized on this circuit: same typed
// systemctl show/set-property transports, same fail-closed order (live read -> Drifted
// verdict -> pre-apply TasksCurrent guard -> apply -> independent read-back ->
// reapply-noop), a pids-controller count instead of a byte size. The guard refuses when
// live TasksCurrent meets or exceeds the target cap (>=: equality means zero headroom,
// so the next clone() would EAGAIN) — lowering TasksMax below live usage would not kill
// tasks but would starve every new clone(), the compute_envelope_model failure class —
// typed and retryable, never applied past it.
type HostConvergeSlice1TasksMaxReceipt {
  host: product.placement_supply.HostIdentity
  unit: std.types.NonEmptyStr
  knob: gunbc.host_converge.ConvergeKnob
  limit: extdeps.systemd.SystemdCgroupTaskLimit
  verdict: gunbc.host_converge.ConvergeVerdict
  probed_at: std.types.NonEmptyStr
  applied: Bool
  read_back_converged: Bool
  reapply_noop: Bool
}

type HostConvergeSlice1MemoryCapReceipt {
  host: product.placement_supply.HostIdentity
  unit: std.types.NonEmptyStr
  knob: gunbc.host_converge.ConvergeKnob
  live_read: gunbc.runner_unit_live_read.RunnerUnitMemoryLiveRead
  verdict: gunbc.host_converge.ConvergeVerdict
  probed_at: std.types.NonEmptyStr
  applied: Bool
  read_back_converged: Bool
  reapply_noop: Bool
}

type HostConvergeSlice1ConvergeResult
  = HostConvergeSlice1Converged { applied_knobs: Int, receipt: HostConvergeSlice1MemoryCapReceipt }
  | HostConvergeSlice1TasksConverged { applied_knobs: Int, receipt: HostConvergeSlice1TasksMaxReceipt }
  | HostConvergeSlice1Refused { reason: String }

fn host_converge_identity(h: gunbc.host_converge.HostConverge) -> product.placement_supply.HostIdentity {
  h.identity
}

fn converge_knob_by_name(host: gunbc.host_converge.HostConverge, name: String) -> gunbc.host_converge.ConvergeKnob? {
  fold(host.knobs, init: none, f: fn(acc, knob) {
    match acc {
      Present { value: _ } => acc
      _ =>
        if knob.name == name {
          Present { value: knob }
        } else {
          none
        }
    }
  })
}

fn host_converge_from_policy(policy: gunbc.host_converge.ConvergePolicy, host: product.placement_supply.HostIdentity) -> gunbc.host_converge.HostConverge? {
  match policy {
    gunbc.host_converge.ConvergePolicyUnsound { reason: _ } => none
    gunbc.host_converge.ConvergePolicyDerived { hosts: hs } =>
      gunbc.host_converge.find_by_identity(items: hs, identity: host, key: host_converge_identity)
  }
}

fn host_converge_slice1_per_slot_memory_max_knob(host: product.placement_supply.HostIdentity) -> gunbc.host_converge.ConvergeKnob? {
  match host_converge_from_policy(policy: gunbc.host_converge.fleet_converge_policy(), host: host) {
    Present { value: hc } =>
      match converge_knob_by_name(host: hc, name: host_converge_slice1_knob_name) {
        Present { value: knob } =>
          match knob.target {
            gunbc.host_converge.PerSlotMemoryCap { dropin_path: _, instance_glob: _, property: p, bytes_value: b } =>
              if p == extdeps.systemd.systemd_memory_max_property && b == knob.desired {
                Present { value: knob }
              } else {
                none
              }
            _ => none
          }
        _ => none
      }
    _ => none
  }
}

fn host_converge_slice1_srv1_per_slot_memory_max_knob() -> gunbc.host_converge.ConvergeKnob? {
  host_converge_slice1_per_slot_memory_max_knob(host: gunbc.fleet_intent_network.operator_host_srv1)
}

data host_converge_slice1_probed_at_refusal_reason: String = "host_converge_slice1: probed_at read failed (clock_now_probed_at); fail-closed"

fn host_converge_slice1_probed_at() -> std.types.NonEmptyStr? {
  gunbc.clock_read.clock_now_probed_at()
}

fn host_converge_slice1_read_memory_max_raw(unit: std.types.NonEmptyStr) -> String? {
  match gunbc.systemctl_show_read.systemctl_show_property_read(transport: gunbc.host_effect.LocalShell, unit: unit, property: extdeps.systemd.MemoryMax) {
    gunbc.systemctl_show_read.SystemdPropertyCaptured { value: raw } => Present { value: raw }
    gunbc.systemctl_show_read.SystemdPropertyCaptureRefused { reason: _ } => none
  }
}

fn host_converge_slice1_live_read(unit: std.types.NonEmptyStr, probed_at: std.types.NonEmptyStr) -> gunbc.runner_unit_live_read.RunnerUnitMemoryLiveRead? {
  match host_converge_slice1_read_memory_max_raw(unit: unit) {
    Present { value: memory_max_raw } =>
      Present {
        value: gunbc.runner_unit_live_read.runner_unit_live_read_typed(
          row: gunbc.runner_unit_live_read.RunnerUnitLiveReadRow {
            unit: unit,
            memory_max_raw: memory_max_raw,
            memory_swap_max_raw: "",
            memory_high_raw: "",
            memory_current_raw: "",
            probed_at: probed_at,
          }
        )
      }
    _ => none
  }
}

fn host_converge_slice1_memory_cap_verdict(
  read: gunbc.runner_unit_live_read.RunnerUnitMemoryLiveRead,
  knob: gunbc.host_converge.ConvergeKnob,
) -> gunbc.host_converge.ConvergeVerdict? {
  gunbc.fleet_show_effective_read.per_slot_memory_cap_verdict_from_unit_read(read: read, target: knob.target)
}

fn host_converge_slice1_receipt_from_read(
  host: product.placement_supply.HostIdentity,
  read: gunbc.runner_unit_live_read.RunnerUnitMemoryLiveRead,
  knob: gunbc.host_converge.ConvergeKnob,
  applied: Bool,
  read_back_converged: Bool,
  reapply_noop: Bool,
) -> HostConvergeSlice1MemoryCapReceipt? {
  match host_converge_slice1_memory_cap_verdict(read: read, knob: knob) {
    Present { value: verdict } =>
      Present {
        value: HostConvergeSlice1MemoryCapReceipt {
          host: host,
          unit: read.unit,
          knob: knob,
          live_read: read,
          verdict: verdict,
          probed_at: read.probed_at,
          applied: applied,
          read_back_converged: read_back_converged,
          reapply_noop: reapply_noop,
        }
      }
    _ => none
  }
}

fn host_converge_slice1_fixture_receipt() -> HostConvergeSlice1MemoryCapReceipt? {
  match host_converge_slice1_srv1_per_slot_memory_max_knob() {
    Present { value: knob } =>
      host_converge_slice1_receipt_from_read(
        host: gunbc.fleet_intent_network.operator_host_srv1,
        read: gunbc.runner_unit_live_read.runner_unit_live_read_typed(row: gunbc.runner_unit_live_read.gunbc_srv1_runner_unit_live_read_fixture),
        knob: knob,
        applied: false,
        read_back_converged: false,
        reapply_noop: false,
      )
    _ => none
  }
}

type HostConvergeSlice1EnumerationMismatch {
  host: product.placement_supply.HostIdentity
  declared_count: Int
  observed_units: List<std.types.NonEmptyStr>
}

fn host_converge_slice1_enumerate_units(instance_glob: String) -> List<std.types.NonEmptyStr>? {
  gunbc.systemctl_list_units.systemctl_list_units_active_services(instance_glob: instance_glob as std.types.NonEmptyStr)
}

// Count equality is a postcondition after RunnerSlotProvision, not a pre-refuse on under-count.
// Observed < declared means slots are missing — converge existing units' caps; provision adds the delta.
fn host_converge_slice1_enumeration_mismatch(
  host: product.placement_supply.HostIdentity,
  units: List<std.types.NonEmptyStr>,
) -> HostConvergeSlice1EnumerationMismatch? {
  let declared = gunbc.fleet_host_budget.declared_runner_count_for(host: host)
  if length(units) == declared {
    none
  } else {
    Present {
      value: HostConvergeSlice1EnumerationMismatch {
        host: host,
        declared_count: declared,
        observed_units: units,
      }
    }
  }
}

fn host_converge_slice1_cross_check_enumeration(host: product.placement_supply.HostIdentity, units: List<std.types.NonEmptyStr>) -> HostConvergeSlice1EnumerationMismatch? {
  let declared = gunbc.fleet_host_budget.declared_runner_count_for(host: host)
  let observed_count = length(units)
  if observed_count > declared {
    host_converge_slice1_enumeration_mismatch(host: host, units: units)
  } else {
    none
  }
}

type HostConvergeSlice1UnitOutcome
  = HostConvergeSlice1UnitTasksConverged { unit: std.types.NonEmptyStr, applied: Bool, receipt: HostConvergeSlice1TasksMaxReceipt }
  | HostConvergeSlice1UnitRefused { unit: std.types.NonEmptyStr, reason: String }

type HostConvergeSlice1HostResult
  = HostConvergeSlice1HostEnumerated { host: product.placement_supply.HostIdentity, outcomes: List<HostConvergeSlice1UnitOutcome> }
  | HostConvergeSlice1HostRefused { reason: String }
  | HostConvergeSlice1HostEnumerationMismatch { mismatch: HostConvergeSlice1EnumerationMismatch }

fn host_converge_slice1_tasks_knob(host: product.placement_supply.HostIdentity) -> gunbc.host_converge.ConvergeKnob? {
  match host_converge_from_policy(policy: gunbc.host_converge.fleet_converge_policy(), host: host) {
    Present { value: hc } =>
      match converge_knob_by_name(host: hc, name: host_converge_slice1_tasks_knob_name) {
        Present { value: knob } =>
          match knob.target {
            gunbc.host_converge.PerSlotMemoryCap { dropin_path: _, instance_glob: _, property: p, bytes_value: b } =>
              if p == (extdeps.systemd.systemd_tasks_max_property as String) && b == knob.desired {
                Present { value: knob }
              } else {
                none
              }
            _ => none
          }
        _ => none
      }
    _ => none
  }
}

fn host_converge_slice1_read_tasks_max_raw(unit: std.types.NonEmptyStr) -> String? {
  match gunbc.systemctl_show_read.systemctl_show_property_read(transport: gunbc.host_effect.LocalShell, unit: unit, property: extdeps.systemd.TasksMax) {
    gunbc.systemctl_show_read.SystemdPropertyCaptured { value: raw } => Present { value: raw }
    gunbc.systemctl_show_read.SystemdPropertyCaptureRefused { reason: _ } => none
  }
}

fn host_converge_slice1_read_tasks_current_raw(unit: std.types.NonEmptyStr) -> String? {
  match gunbc.systemctl_show_read.systemctl_show_property_read(transport: gunbc.host_effect.LocalShell, unit: unit, property: extdeps.systemd.TasksCurrent) {
    gunbc.systemctl_show_read.SystemdPropertyCaptured { value: raw } => Present { value: raw }
    gunbc.systemctl_show_read.SystemdPropertyCaptureRefused { reason: _ } => none
  }
}

// Verdict over the live TasksMax read against the knob's desired count. An empty or
// unparseable wire is the Absent verdict (untyped wire, refused upstream), never Drifted:
// Drifted is reserved for a real limit that disagrees, because Drifted is the arm that
// arms the apply path.
fn host_converge_slice1_tasks_verdict(limit: extdeps.systemd.SystemdCgroupTaskLimit, knob: gunbc.host_converge.ConvergeKnob) -> gunbc.host_converge.ConvergeVerdict {
  match limit {
    extdeps.systemd.TaskLimitCount { count: n } =>
      if to_string(n) == knob.desired { gunbc.host_converge.VerdictConverged } else { gunbc.host_converge.Drifted }
    extdeps.systemd.TaskLimitUnbounded => gunbc.host_converge.Drifted
    extdeps.systemd.TaskLimitAbsent => Absent
  }
}

fn host_converge_slice1_apply_tasks_max(unit: std.types.NonEmptyStr, value: String) -> Bool {
  gunbc.systemctl_set_property.systemctl_set_property_local(
    unit: unit,
    property: extdeps.systemd.systemd_tasks_max_property,
    value: value as std.types.NonEmptyStr,
  )
}

type HostConvergeSlice1TasksGuardOutcome
  = HostConvergeSlice1TasksSafe { unit: std.types.NonEmptyStr, current_count: Int }
  | HostConvergeSlice1TasksUnsafe { unit: std.types.NonEmptyStr, current_count: Int, target_count: Int }
  | HostConvergeSlice1TasksUnknown { unit: std.types.NonEmptyStr, reason: String }

// Pure boundary predicate for the tasks guard, extracted so the >= boundary is
// witnessable: equality means zero headroom (the next clone() EAGAINs), so it refuses.
fn host_converge_slice1_tasks_headroom_refuses(current: Int, target: Int) -> Bool {
  current >= target
}

fn host_converge_slice1_tasks_guard(unit: std.types.NonEmptyStr, target_value: String) -> HostConvergeSlice1TasksGuardOutcome {
  match parse_int(s: target_value) {
    Present { value: target } =>
      match host_converge_slice1_read_tasks_current_raw(unit: unit) {
        Present { value: raw } =>
          match extdeps.systemd.parse_systemd_task_limit_show(raw: raw) {
            extdeps.systemd.TaskLimitCount { count: current } =>
              if host_converge_slice1_tasks_headroom_refuses(current: current, target: target) {
                HostConvergeSlice1TasksUnsafe { unit: unit, current_count: current, target_count: target }
              } else {
                HostConvergeSlice1TasksSafe { unit: unit, current_count: current }
              }
            _ =>
              HostConvergeSlice1TasksUnknown {
                unit: unit,
                reason: "host_converge_slice1: live TasksCurrent read unbounded or unparseable; cannot bound usage against target cap; fail-closed",
              }
          }
        _ =>
          HostConvergeSlice1TasksUnknown {
            unit: unit,
            reason: "host_converge_slice1: live systemctl show TasksCurrent read absent; fail-closed",
          }
      }
    _ =>
      HostConvergeSlice1TasksUnknown {
        unit: unit,
        reason: "host_converge_slice1: target TasksMax value did not parse as Int; fail-closed",
      }
  }
}

fn host_converge_slice1_tasks_receipt(
  host: product.placement_supply.HostIdentity,
  unit: std.types.NonEmptyStr,
  knob: gunbc.host_converge.ConvergeKnob,
  limit: extdeps.systemd.SystemdCgroupTaskLimit,
  probed_at: std.types.NonEmptyStr,
  applied: Bool,
  read_back_converged: Bool,
  reapply_noop: Bool,
) -> HostConvergeSlice1TasksMaxReceipt {
  HostConvergeSlice1TasksMaxReceipt {
    host: host,
    unit: unit,
    knob: knob,
    limit: limit,
    verdict: host_converge_slice1_tasks_verdict(limit: limit, knob: knob),
    probed_at: probed_at,
    applied: applied,
    read_back_converged: read_back_converged,
    reapply_noop: reapply_noop,
  }
}

fn host_converge_slice1_tasks_receipt_is_valid(receipt: HostConvergeSlice1TasksMaxReceipt) -> Bool {
  receipt.read_back_converged
    && receipt.reapply_noop
    && receipt.verdict == gunbc.host_converge.VerdictConverged
}

fn host_converge_slice1_tasks_read_limit(unit: std.types.NonEmptyStr) -> extdeps.systemd.SystemdCgroupTaskLimit? {
  match host_converge_slice1_read_tasks_max_raw(unit: unit) {
    Present { value: raw } => Present { value: extdeps.systemd.parse_systemd_task_limit_show(raw: raw) }
    _ => none
  }
}

// The reapply-noop second write intentionally bypasses the TasksCurrent guard: it is only
// reachable after an independent read proved the effective TasksMax already equals the
// desired value, and re-applying the effective value cannot lower headroom (TasksCurrent
// is always <= the effective cap at the moment of the read). The read-back and this
// second write are NOT atomic — concurrent task creation can raise TasksCurrent between
// them — but the EAGAIN-starvation class the guard exists for requires setting the cap
// BELOW current, which re-applying the already-effective value cannot cause regardless
// of concurrent spawns (review 50754 wording). Mirrors the memory circuit's reapply-noop.
fn host_converge_slice1_prove_tasks_reapply_noop(unit: std.types.NonEmptyStr, knob: gunbc.host_converge.ConvergeKnob) -> String? {
  if !host_converge_slice1_apply_tasks_max(unit: unit, value: knob.desired) {
    Present {
      value: "host_converge_slice1: tasks reapply-noop second apply (systemctl set-property TasksMax) failed; fail-closed",
    }
  } else {
    match host_converge_slice1_tasks_read_limit(unit: unit) {
      Present { value: limit } =>
        match host_converge_slice1_tasks_verdict(limit: limit, knob: knob) {
          gunbc.host_converge.VerdictConverged => none
          gunbc.host_converge.Drifted =>
            Present {
              value: "host_converge_slice1: tasks reapply-noop failed — still drifted after second apply; fail-closed",
            }
          Absent =>
            Present {
              value: "host_converge_slice1: tasks reapply-noop read returned Absent verdict after second apply; fail-closed",
            }
        }
      _ =>
        Present {
          value: "host_converge_slice1: tasks reapply-noop independent read after second apply absent; fail-closed",
        }
    }
  }
}

fn host_converge_slice1_converge_unit_tasks(host: product.placement_supply.HostIdentity, unit: std.types.NonEmptyStr, knob: gunbc.host_converge.ConvergeKnob) -> HostConvergeSlice1UnitOutcome {
  match host_converge_slice1_probed_at() {
    Present { value: probed_at } =>
      match host_converge_slice1_tasks_read_limit(unit: unit) {
        Present { value: limit } =>
          match host_converge_slice1_tasks_verdict(limit: limit, knob: knob) {
            gunbc.host_converge.VerdictConverged =>
              match host_converge_slice1_prove_tasks_reapply_noop(unit: unit, knob: knob) {
                Present { value: why } => HostConvergeSlice1UnitRefused { unit: unit, reason: why }
                _ =>
                  HostConvergeSlice1UnitTasksConverged {
                    unit: unit,
                    applied: false,
                    receipt: host_converge_slice1_tasks_receipt(
                      host: host, unit: unit, knob: knob, limit: limit, probed_at: probed_at,
                      applied: false, read_back_converged: true, reapply_noop: true,
                    ),
                  }
              }
            gunbc.host_converge.Drifted =>
              match host_converge_slice1_tasks_guard(unit: unit, target_value: knob.desired) {
                HostConvergeSlice1TasksUnsafe { unit: _, current_count: cc, target_count: tc } =>
                  HostConvergeSlice1UnitRefused {
                    unit: unit,
                    reason: concat(
                      concat(concat("host_converge_slice1: tasks guard refused apply for ", unit as String), concat(" current_tasks=", to_string(cc))),
                      concat(concat(" exceeds target_tasks_max=", to_string(tc)), "; retryable once the slot is quiet"),
                    ),
                  }
                HostConvergeSlice1TasksUnknown { unit: _, reason: r } =>
                  HostConvergeSlice1UnitRefused { unit: unit, reason: concat("host_converge_slice1: tasks guard could not prove safety before apply, fail-closed: ", r) }
                HostConvergeSlice1TasksSafe { unit: _, current_count: _ } =>
                  if !host_converge_slice1_apply_tasks_max(unit: unit, value: knob.desired) {
                    HostConvergeSlice1UnitRefused {
                      unit: unit,
                      reason: concat(
                        concat("host_converge_slice1: systemctl set-property TasksMax failed for ", unit as String),
                        concat(" desired=", knob.desired)
                      ),
                    }
                  } else {
                    match host_converge_slice1_probed_at() {
                      Present { value: readback_at } =>
                        match host_converge_slice1_tasks_read_limit(unit: unit) {
                          Present { value: read_back } =>
                            match host_converge_slice1_tasks_verdict(limit: read_back, knob: knob) {
                              gunbc.host_converge.VerdictConverged =>
                                match host_converge_slice1_prove_tasks_reapply_noop(unit: unit, knob: knob) {
                                  Present { value: why } => HostConvergeSlice1UnitRefused { unit: unit, reason: why }
                                  _ =>
                                    HostConvergeSlice1UnitTasksConverged {
                                      unit: unit,
                                      applied: true,
                                      receipt: host_converge_slice1_tasks_receipt(
                                        host: host, unit: unit, knob: knob, limit: read_back, probed_at: readback_at,
                                        applied: true, read_back_converged: true, reapply_noop: true,
                                      ),
                                    }
                                }
                              gunbc.host_converge.Drifted =>
                                HostConvergeSlice1UnitRefused { unit: unit, reason: "host_converge_slice1: tasks independent read-back after apply still drifted; fail-closed" }
                              Absent =>
                                HostConvergeSlice1UnitRefused { unit: unit, reason: "host_converge_slice1: tasks read-back after apply returned Absent verdict; fail-closed" }
                            }
                          _ => HostConvergeSlice1UnitRefused { unit: unit, reason: "host_converge_slice1: tasks independent read-back after apply returned absent; fail-closed" }
                        }
                      _ => HostConvergeSlice1UnitRefused { unit: unit, reason: host_converge_slice1_probed_at_refusal_reason }
                    }
                  }
              }
            Absent =>
              HostConvergeSlice1UnitRefused { unit: unit, reason: concat("host_converge_slice1: live TasksMax parsed Absent (empty/untyped wire) for ", unit as String) }
          }
        _ => HostConvergeSlice1UnitRefused { unit: unit, reason: concat("host_converge_slice1: live systemctl show TasksMax read absent for ", unit as String) }
      }
    _ => HostConvergeSlice1UnitRefused { unit: unit, reason: host_converge_slice1_probed_at_refusal_reason }
  }
}

fn host_converge_slice1_converge_host(host: product.placement_supply.HostIdentity, instance_glob: String) -> HostConvergeSlice1HostResult {
  match host_converge_slice1_tasks_knob(host: host) {
    Present { value: tasks_knob } =>
      match host_converge_slice1_enumerate_units(instance_glob: instance_glob) {
        Present { value: units } =>
          match host_converge_slice1_cross_check_enumeration(host: host, units: units) {
            Present { value: mismatch } => HostConvergeSlice1HostEnumerationMismatch { mismatch: mismatch }
            _ =>
              HostConvergeSlice1HostEnumerated {
                host: host,
                outcomes: map(units, u => host_converge_slice1_converge_unit_tasks(host: host, unit: u, knob: tasks_knob)),
              }
          }
        _ => HostConvergeSlice1HostRefused { reason: concat("host_converge_slice1: live unit enumeration absent for glob ", instance_glob) }
      }
    _ => HostConvergeSlice1HostRefused { reason: "host_converge_slice1: per_slot_tasks_max knob absent from fleet_converge_policy for host; fail-closed" }
  }
}

fn host_converge_slice1_converge_srv3() -> HostConvergeSlice1HostResult {
  host_converge_slice1_converge_host(host: gunbc.fleet_intent_network.operator_host_srv3, instance_glob: gunbc.host_converge.runner_instance_glob(host: gunbc.fleet_intent_network.operator_host_srv3))
}

fn host_converge_slice1_receipt_is_valid(receipt: HostConvergeSlice1MemoryCapReceipt) -> Bool {
  receipt.read_back_converged
    && receipt.reapply_noop
    && receipt.verdict == gunbc.host_converge.VerdictConverged
}

fn host_converge_slice1_unit_outcome_to_legacy_result(outcome: HostConvergeSlice1UnitOutcome) -> HostConvergeSlice1ConvergeResult {
  match outcome {
    HostConvergeSlice1UnitTasksConverged { unit: _, applied: a, receipt: r } =>
      HostConvergeSlice1TasksConverged { applied_knobs: if a { 1 } else { 0 }, receipt: r }
    HostConvergeSlice1UnitRefused { unit: _, reason: reason } =>
      HostConvergeSlice1Refused { reason: reason }
  }
}

fn host_converge_slice1_host_result_applied_count(result: HostConvergeSlice1HostResult) -> Int {
  match result {
    HostConvergeSlice1HostEnumerated { host: _, outcomes: os } =>
      fold(os, init: 0, f: fn(acc, o) {
        match host_converge_slice1_unit_outcome_to_legacy_result(o) {
          HostConvergeSlice1Converged { applied_knobs: n, receipt: _ } => acc + n
          HostConvergeSlice1TasksConverged { applied_knobs: n, receipt: _ } => acc + n
          _ => acc
        }
      })
    _ => 0
  }
}

fn host_converge_slice1_host_result_all_valid(result: HostConvergeSlice1HostResult) -> Bool {
  match result {
    HostConvergeSlice1HostEnumerated { host: _, outcomes: os } =>
      length(os) > 0
        && fold(os, init: true, f: fn(acc, o) {
          acc
            && match o {
              HostConvergeSlice1UnitTasksConverged { unit: _, applied: _, receipt: r } =>
                host_converge_slice1_tasks_receipt_is_valid(receipt: r)
              _ => false
            }
        })
    _ => false
  }
}

fn host_converge_slice1_host_result_refusal_reason(result: HostConvergeSlice1HostResult) -> String? {
  match result {
    HostConvergeSlice1HostRefused { reason: why } => Present { value: why }
    HostConvergeSlice1HostEnumerationMismatch { mismatch: m } =>
      Present {
        value: concat(
          concat("host_converge_slice1: enumeration mismatch for ", m.host as String),
          concat(concat(" declared_count=", to_string(m.declared_count)), concat(" observed_count=", to_string(length(m.observed_units)))),
        ),
      }
    HostConvergeSlice1HostEnumerated { host: _, outcomes: os } =>
      fold(os, init: none, f: fn(acc, o) {
        match acc {
          Present { value: _ } => acc
          _ =>
            match host_converge_slice1_unit_outcome_to_legacy_result(o) {
              HostConvergeSlice1Refused { reason: why } => Present { value: why }
              _ => none
            }
        }
      })
  }
}

// srv1: TasksMax on probe unit only — memory-cap live apply is deploy-time (operator principal).
fn host_converge_slice1_converge_loop() -> HostConvergeSlice1ConvergeResult {
  match host_converge_slice1_tasks_knob(host: gunbc.fleet_intent_network.operator_host_srv1) {
    Present { value: tasks_knob } =>
      match host_converge_slice1_unit_outcome_to_legacy_result(
        host_converge_slice1_converge_unit_tasks(host: gunbc.fleet_intent_network.operator_host_srv1, unit: host_converge_slice1_probe_unit, knob: tasks_knob)
      ) {
        HostConvergeSlice1TasksConverged { applied_knobs: n, receipt: r } =>
          if host_converge_slice1_tasks_receipt_is_valid(receipt: r) {
            HostConvergeSlice1TasksConverged { applied_knobs: n, receipt: r }
          } else {
            HostConvergeSlice1Refused { reason: "host_converge_slice1: tasks receipt validity gate failed on srv1 probe unit; fail-closed" }
          }
        HostConvergeSlice1Converged { applied_knobs: _, receipt: _ } =>
          HostConvergeSlice1Refused { reason: "host_converge_slice1: converge loop returned a memory-cap outcome; fail-closed" }
        HostConvergeSlice1Refused { reason: why } => HostConvergeSlice1Refused { reason: why }
      }
    _ =>
      HostConvergeSlice1Refused {
        reason: "host_converge_slice1: per_slot_tasks_max knob absent from fleet_converge_policy for srv1; fail-closed",
      }
  }
}
