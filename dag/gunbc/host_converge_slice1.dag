module gunbc.host_converge_slice1

import std.types { String, NonEmptyStr, Bool, List }
import std.disposition { Disposition, Terminal }
import std.realization_reconcile {
  Reconciliation,
  Converged,
  NotConverged,
}
import product.placement_supply { HostIdentity }
import gunbc.fleet_intent_network { operator_host_srv1 }
import gunbc.host_converge {
  ConvergeKnob,
  ConvergeTarget,
  ConvergeVerdict,
  ConvergePolicy,
  ConvergePolicyDerived,
  ConvergePolicyUnsound,
  HostConverge,
  PerSlotMemoryCap,
  fleet_converge_policy,
  find_by_identity,
}
import gunbc.host_effect { HostEffectIntent, HostEffectEvidence }
import gunbc.runner_unit_live_read {
  RunnerUnitMemoryLiveRead,
  gunbc_srv1_runner_unit_live_read_fixture,
  runner_unit_live_read_typed,
}
import gunbc.fleet_show_effective_read {
  fleet_runner_unit_memory_read_apply,
  runner_unit_memory_live_read_from_apply,
  per_slot_memory_cap_verdict_from_unit_read,
}

data gunbc_host_converge_slice1_scope_disposition: Disposition = Terminal {
  reason: "Slice 1 host-converge: wire the first real knob — srv1 actions-runner@srv1-01.service per_slot_memory_max_bytes — from fleet_converge_policy through fleet_show_effective_read live transport to ConvergeTarget PerSlotMemoryCap verdict semantics. READ-ONLY: no apply/patch engine, no runner-count reconciliation. Live SSH transport via host_effect; fixture rows ground RED witnesses."
}

data host_converge_slice1_probe_unit: NonEmptyStr = "actions-runner@srv1-01.service"

data host_converge_slice1_knob_name: String = "per_slot_memory_max_bytes"

type HostConvergeSlice1MemoryCapReceipt {
  host: HostIdentity
  unit: NonEmptyStr
  knob: ConvergeKnob
  live_read: RunnerUnitMemoryLiveRead
  verdict: ConvergeVerdict
  probed_at: NonEmptyStr
}

fn host_converge_identity(h: HostConverge) -> HostIdentity {
  h.identity
}

fn converge_knob_by_name(host: HostConverge, name: String) -> ConvergeKnob? {
  fold(host.knobs, init: none, f: fn(acc, knob) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        if knob.name == name {
          Present { value: knob }
        } else {
          none
        }
    }
  })
}

fn host_converge_from_policy(policy: ConvergePolicy, host: HostIdentity) -> HostConverge? {
  match policy {
    ConvergePolicyUnsound { reason: _ } => none
    ConvergePolicyDerived { hosts: hs } =>
      find_by_identity(items: hs, identity: host, key: host_converge_identity)
  }
}

fn host_converge_slice1_srv1_per_slot_memory_max_knob() -> ConvergeKnob? {
  match host_converge_from_policy(policy: fleet_converge_policy(), host: operator_host_srv1) {
    Present { value: host } =>
      converge_knob_by_name(host: host, name: host_converge_slice1_knob_name)
    Absent => none
  }
}

fn host_converge_slice1_per_slot_memory_cap_target(knob: ConvergeKnob) -> PerSlotMemoryCap? {
  match knob.target {
    PerSlotMemoryCap { dropin_path: d, instance_glob: g, property: p, bytes_value: b } =>
      Present {
        value: PerSlotMemoryCap {
          dropin_path: d,
          instance_glob: g,
          property: p,
          bytes_value: b,
        }
      }
    _ => none
  }
}

fn host_converge_slice1_memory_cap_verdict(
  read: RunnerUnitMemoryLiveRead,
  knob: ConvergeKnob,
) -> ConvergeVerdict? {
  per_slot_memory_cap_verdict_from_unit_read(read: read, target: knob.target)
}

fn host_converge_slice1_receipt_from_read(
  read: RunnerUnitMemoryLiveRead,
  knob: ConvergeKnob,
) -> HostConvergeSlice1MemoryCapReceipt? {
  match host_converge_slice1_memory_cap_verdict(read: read, knob: knob) {
    Present { value: verdict } =>
      Present {
        value: HostConvergeSlice1MemoryCapReceipt {
          host: operator_host_srv1,
          unit: read.unit,
          knob: knob,
          live_read: read,
          verdict: verdict,
          probed_at: read.probed_at,
        }
      }
    Absent => none
  }
}

fn host_converge_slice1_fixture_receipt() -> HostConvergeSlice1MemoryCapReceipt? {
  match host_converge_slice1_srv1_per_slot_memory_max_knob() {
    Present { value: knob } =>
      host_converge_slice1_receipt_from_read(
        read: runner_unit_live_read_typed(row: gunbc_srv1_runner_unit_live_read_fixture),
        knob: knob,
      )
    Absent => none
  }
}

fn host_converge_slice1_srv1_memory_cap_read_apply() -> Reconciliation<HostEffectIntent, HostEffectEvidence>? {
  fleet_runner_unit_memory_read_apply(host: operator_host_srv1, unit: host_converge_slice1_probe_unit)
}

fn host_converge_slice1_live_read_from_apply(
  r: Reconciliation<HostEffectIntent, HostEffectEvidence>,
  probed_at: NonEmptyStr,
) -> RunnerUnitMemoryLiveRead? {
  runner_unit_memory_live_read_from_apply(
    r: r,
    unit: host_converge_slice1_probe_unit,
    probed_at: probed_at,
  )
}

fn host_converge_slice1_live_receipt_from_apply(
  r: Reconciliation<HostEffectIntent, HostEffectEvidence>,
  probed_at: NonEmptyStr,
) -> HostConvergeSlice1MemoryCapReceipt? {
  match host_converge_slice1_srv1_per_slot_memory_max_knob() {
    Present { value: knob } =>
      match host_converge_slice1_live_read_from_apply(r: r, probed_at: probed_at) {
        Present { value: read } => host_converge_slice1_receipt_from_read(read: read, knob: knob)
        Absent => none
      }
    Absent => none
  }
}

fn host_converge_slice1_knob_wired() -> Bool {
  match host_converge_slice1_srv1_per_slot_memory_max_knob() {
    Present { value: knob } =>
      match host_converge_slice1_per_slot_memory_cap_target(knob: knob) {
        Present { value: _ } => true
        Absent => false
      }
    Absent => false
  }
}

fn host_converge_slice1_apply_path_wired() -> Bool {
  match host_converge_slice1_srv1_memory_cap_read_apply() {
    Present { value: _ } => true
    Absent => false
  }
}
