data gunbc_host_converge_slice1_scope_disposition: Disposition = Terminal {
  reason: "Host-converge realized knob: per_slot_memory_max_bytes from fleet_converge_policy through typed systemctl show/set-property/list-units and clock_now_probed_at (LocalShell on-host, runs AS the target host's own job — no SSH transport needed) into ConvergeTarget PerSlotMemoryCap verdict semantics, with independent read-back and reapply-noop proof. Realized on srv1 (single probe unit) and srv3 (multi-unit: live-enumerated via runner_instance_glob, cross-checked against declared_runner_count() — a count mismatch refuses typed rather than silently converging a subset; per-unit outcomes are independent, so one unit's refusal never blocks its siblings, per DESIGN §5's per-cause-typed-refusal/siblings-continue discipline). A pre-apply MemoryCurrent usage guard (host_converge_slice1_usage_guard) refuses per-unit, typed and retryable, rather than applying a cap below live usage — never a fleet-wide abort. srv2 and other knobs stay on the host_converge_realize frontier. Deliberately NOT integrated with the membership-diff reconcile spine (membership-diff-reconcile-spine-design.md) — that spine's R5 teardown-owned-only concerns a different axis (fleet membership, not a live cgroup knob); noted as a future consolidation candidate, not actioned here. Dissolve-on (same bind): knob.desired bytes_value is inherited ConvergeKnob String at the shell seam; emit lane should terminate on ByteSize-typed argv rows, not raw String interpolation. First-execution safety: the apply arm is unreachable except via host_converge_slice1_converge_unit's own control flow — enumeration (host_converge_slice1_enumerate_units) and cross-check must both succeed before any unit is attempted, and within a unit the live MemoryMax read and Drifted verdict must both succeed before host_converge_slice1_usage_guard's own live MemoryCurrent read is attempted and must itself return Safe before set-property fires — so the first live invocation against a real host (srv1 or srv3) necessarily exercises only read-only systemctl show/list-units transports up through several fail-closed gates before any write is reachable; there is no code path to set-property without a prior successful live read in the same pass. Operationally this means the first `gunbc converge` run against srv3 IS the read-proof — no separate wet witness step is required by construction — but the operator should still supervise that first run to confirm the read/enumerate paths return real data rather than tripping an early Refused arm for an unrelated reason (host reachability, transport auth, etc.). CLOSED 2026-08-05, by its own trigger firing rather than by anyone revisiting it. Review 41089 recorded a known non-blocking gap here — host_converge_slice1_cross_check_enumeration took a host param while declared_runner_count() was fleet-wide, so host was threaded through only to LABEL a HostConvergeSlice1EnumerationMismatch and never to select the count being compared. Modeling a per-host budget then would have been speculative (every host shared one width), so the gap was left with a precise dissolve-on: the day a second host's declared runner count genuinely differs, declared_runner_count must take a HostIdentity backed by a per-host budget row and this cross-check wires straight to it, no interim shim. srv3/srv4 moved to 7 slots and srv1/srv2 stayed at 5 (gunbc.runner_slot_allocation gunbc_runner_slot_width_ruling_note), the counts diverged, and the call is now declared_runner_count_for(host: host) against gunbc_runner_pool_budget_for — the shim the note forbade was not needed and was not written.\n\nWhat that gap would have COST had it stayed, which is the reason to record its closure rather than delete the row: this cross-check refuses when live unit enumeration disagrees with the declared width. Against a fleet-wide count it would have compared srv3's seven observed units to a five that belonged to srv1, refused a correctly-converged host, and — worse in the other direction — passed srv1 carrying seven units that its RAM cannot hold. A label-only host param is exactly the state-space conflation that looks harmless while every host agrees."
}

data host_converge_slice1_probe_unit: NonEmptyStr = "actions-runner@srv1-01.service"

data host_converge_slice1_knob_name: String = "per_slot_memory_max_bytes"

data host_converge_slice1_tasks_knob_name: String = "per_slot_tasks_max"

// TasksMax (gunbc.runner_slot_allocation gunbc_runner_slot_desired, 16384 — the
// 2026-06-21 incident REPAIR value; 512 was the diagnosed EAGAIN outage value, per the
// operator ruling on PR 8045) is the second knob realized on this circuit: same typed
// systemctl show/set-property transports, same fail-closed order (live read -> Drifted
// verdict -> pre-apply TasksCurrent guard -> apply -> independent read-back ->
// reapply-noop), a pids-controller count instead of a byte size. The guard refuses when
// live TasksCurrent meets or exceeds the target cap (>=: equality means zero headroom,
// so the next clone() would EAGAIN) — lowering TasksMax below live usage would not kill
// tasks but would starve every new clone(), the compute_envelope_model failure class —
// typed and retryable, never applied past it.
type HostConvergeSlice1TasksMaxReceipt {
  host: HostIdentity
  unit: NonEmptyStr
  knob: ConvergeKnob
  limit: SystemdCgroupTaskLimit
  verdict: ConvergeVerdict
  probed_at: NonEmptyStr
  applied: Bool
  read_back_converged: Bool
  reapply_noop: Bool
}

type HostConvergeSlice1MemoryCapReceipt {
  host: HostIdentity
  unit: NonEmptyStr
  knob: ConvergeKnob
  live_read: RunnerUnitMemoryLiveRead
  verdict: ConvergeVerdict
  probed_at: NonEmptyStr
  applied: Bool
  read_back_converged: Bool
  reapply_noop: Bool
}

type HostConvergeSlice1ConvergeResult
  = HostConvergeSlice1Converged { applied_knobs: Int, receipt: HostConvergeSlice1MemoryCapReceipt }
  | HostConvergeSlice1TasksConverged { applied_knobs: Int, receipt: HostConvergeSlice1TasksMaxReceipt }
  | HostConvergeSlice1Refused { reason: String }

fn host_converge_identity(h: HostConverge) -> HostIdentity {
  h.identity
}

fn converge_knob_by_name(host: HostConverge, name: String) -> ConvergeKnob? {
  fold(host.knobs, init: none, f: fn(acc, knob) {
    match acc {
      Present { value: _ } => acc
      _ =>
        if knob.name == name {
          Present { value: knob }
        } else {
          none
        }
    }
  })
}

fn host_converge_from_policy(policy: ConvergePolicy, host: HostIdentity) -> HostConverge? {
  match policy {
    ConvergePolicyUnsound { reason: _ } => none
    ConvergePolicyDerived { hosts: hs } =>
      find_by_identity(items: hs, identity: host, key: host_converge_identity)
  }
}

fn host_converge_slice1_per_slot_memory_max_knob(host: HostIdentity) -> ConvergeKnob? {
  match host_converge_from_policy(policy: fleet_converge_policy(), host: host) {
    Present { value: hc } =>
      match converge_knob_by_name(host: hc, name: host_converge_slice1_knob_name) {
        Present { value: knob } =>
          match knob.target {
            PerSlotMemoryCap { dropin_path: _, instance_glob: _, property: p, bytes_value: b } =>
              if p == systemd_memory_max_property && b == knob.desired {
                Present { value: knob }
              } else {
                none
              }
            _ => none
          }
        _ => none
      }
    _ => none
  }
}

fn host_converge_slice1_srv1_per_slot_memory_max_knob() -> ConvergeKnob? {
  host_converge_slice1_per_slot_memory_max_knob(host: operator_host_srv1)
}

data host_converge_slice1_probed_at_refusal_reason: String = "host_converge_slice1: probed_at read failed (clock_now_probed_at); fail-closed"

fn host_converge_slice1_probed_at() -> NonEmptyStr? {
  clock_now_probed_at()
}

fn host_converge_slice1_read_memory_max_raw(unit: NonEmptyStr) -> String? {
  match systemctl_show_property_read_local(unit: unit, property: MemoryMax) {
    SystemdPropertyCaptured { value: raw } => Present { value: raw }
    SystemdPropertyCaptureRefused { reason: _ } => none
  }
}

fn host_converge_slice1_apply_memory_max(unit: NonEmptyStr, bytes_value: String) -> Bool {
  systemctl_set_property_local(
    unit: unit,
    property: systemd_memory_max_property,
    value: bytes_value as NonEmptyStr,
  )
}

fn host_converge_slice1_live_read(unit: NonEmptyStr, probed_at: NonEmptyStr) -> RunnerUnitMemoryLiveRead? {
  match host_converge_slice1_read_memory_max_raw(unit: unit) {
    Present { value: memory_max_raw } =>
      Present {
        value: runner_unit_live_read_typed(
          row: RunnerUnitLiveReadRow {
            unit: unit,
            memory_max_raw: memory_max_raw,
            memory_swap_max_raw: "",
            memory_high_raw: "",
            memory_current_raw: "",
            probed_at: probed_at,
          }
        )
      }
    _ => none
  }
}

fn host_converge_slice1_memory_cap_verdict(
  read: RunnerUnitMemoryLiveRead,
  knob: ConvergeKnob,
) -> ConvergeVerdict? {
  per_slot_memory_cap_verdict_from_unit_read(read: read, target: knob.target)
}

fn host_converge_slice1_receipt_from_read(
  host: HostIdentity,
  read: RunnerUnitMemoryLiveRead,
  knob: ConvergeKnob,
  applied: Bool,
  read_back_converged: Bool,
  reapply_noop: Bool,
) -> HostConvergeSlice1MemoryCapReceipt? {
  match host_converge_slice1_memory_cap_verdict(read: read, knob: knob) {
    Present { value: verdict } =>
      Present {
        value: HostConvergeSlice1MemoryCapReceipt {
          host: host,
          unit: read.unit,
          knob: knob,
          live_read: read,
          verdict: verdict,
          probed_at: read.probed_at,
          applied: applied,
          read_back_converged: read_back_converged,
          reapply_noop: reapply_noop,
        }
      }
    _ => none
  }
}

fn host_converge_slice1_fixture_receipt() -> HostConvergeSlice1MemoryCapReceipt? {
  match host_converge_slice1_srv1_per_slot_memory_max_knob() {
    Present { value: knob } =>
      host_converge_slice1_receipt_from_read(
        host: operator_host_srv1,
        read: runner_unit_live_read_typed(row: gunbc_srv1_runner_unit_live_read_fixture),
        knob: knob,
        applied: false,
        read_back_converged: false,
        reapply_noop: false,
      )
    _ => none
  }
}

type HostConvergeSlice1UsageGuardOutcome
  = HostConvergeSlice1UsageSafe { unit: NonEmptyStr, current_bytes: ByteSize }
  | HostConvergeSlice1UsageUnsafe { unit: NonEmptyStr, current_bytes: ByteSize, target_cap_bytes: ByteSize }
  | HostConvergeSlice1UsageUnknown { unit: NonEmptyStr, reason: String }

data host_converge_slice1_usage_guard_placeholder_probed_at: NonEmptyStr = "host_converge_slice1_usage_guard"

fn host_converge_slice1_read_memory_current_raw(unit: NonEmptyStr) -> String? {
  match systemctl_show_property_read_local(unit: unit, property: MemoryCurrent) {
    SystemdPropertyCaptured { value: raw } => Present { value: raw }
    SystemdPropertyCaptureRefused { reason: _ } => none
  }
}

fn host_converge_slice1_usage_guard(unit: NonEmptyStr, target_bytes_value: String) -> HostConvergeSlice1UsageGuardOutcome {
  match parse_int(s: target_bytes_value) {
    Present { value: target_bytes } =>
      match host_converge_slice1_read_memory_current_raw(unit: unit) {
        Present { value: raw } => {
          let read = runner_unit_live_read_typed(
            row: RunnerUnitLiveReadRow {
              unit: unit,
              memory_max_raw: "",
              memory_swap_max_raw: "",
              memory_high_raw: "",
              memory_current_raw: raw,
              probed_at: host_converge_slice1_usage_guard_placeholder_probed_at,
            }
          )
          let target_cap = byte_size(count: target_bytes)
          match runner_unit_usage_exceeds_bytes(read: read, target_bytes: target_cap) {
            Present { value: exceeds } =>
              match read.memory_current {
                MemoryLimitBytes { bytes: current } =>
                  if exceeds {
                    HostConvergeSlice1UsageUnsafe { unit: unit, current_bytes: current, target_cap_bytes: target_cap }
                  } else {
                    HostConvergeSlice1UsageSafe { unit: unit, current_bytes: current }
                  }
                _ =>
                  HostConvergeSlice1UsageUnknown {
                    unit: unit,
                    reason: "host_converge_slice1: MemoryCurrent read parsed inconsistently between guard and comparison; fail-closed",
                  }
              }
            _ =>
              HostConvergeSlice1UsageUnknown {
                unit: unit,
                reason: "host_converge_slice1: MemoryCurrent read unbounded or unparseable; cannot bound usage against target cap; fail-closed",
              }
          }
        }
        _ =>
          HostConvergeSlice1UsageUnknown {
            unit: unit,
            reason: "host_converge_slice1: live systemctl show MemoryCurrent read absent; fail-closed",
          }
      }
    _ =>
      HostConvergeSlice1UsageUnknown {
        unit: unit,
        reason: "host_converge_slice1: target cap bytes_value did not parse as Int; fail-closed",
      }
  }
}

type HostConvergeSlice1EnumerationMismatch {
  host: HostIdentity
  declared_count: Int
  observed_units: List<NonEmptyStr>
}

fn host_converge_slice1_enumerate_units(instance_glob: String) -> List<NonEmptyStr>? {
  systemctl_list_units_active_services(instance_glob: instance_glob as NonEmptyStr)
}

// Count equality is a postcondition after RunnerSlotProvision, not a pre-refuse on under-count.
// Observed < declared means slots are missing — converge existing units' caps; provision adds the delta.
fn host_converge_slice1_enumeration_mismatch(
  host: HostIdentity,
  units: List<NonEmptyStr>,
) -> HostConvergeSlice1EnumerationMismatch? {
  let declared = declared_runner_count_for(host: host)
  if length(units) == declared {
    none
  } else {
    Present {
      value: HostConvergeSlice1EnumerationMismatch {
        host: host,
        declared_count: declared,
        observed_units: units,
      }
    }
  }
}

fn host_converge_slice1_cross_check_enumeration(host: HostIdentity, units: List<NonEmptyStr>) -> HostConvergeSlice1EnumerationMismatch? {
  let declared = declared_runner_count_for(host: host)
  let observed_count = length(units)
  if observed_count > declared {
    host_converge_slice1_enumeration_mismatch(host: host, units: units)
  } else {
    none
  }
}

type HostConvergeSlice1UnitOutcome
  = HostConvergeSlice1UnitConverged { unit: NonEmptyStr, applied: Bool, receipt: HostConvergeSlice1MemoryCapReceipt }
  | HostConvergeSlice1UnitTasksConverged { unit: NonEmptyStr, applied: Bool, receipt: HostConvergeSlice1TasksMaxReceipt }
  | HostConvergeSlice1UnitRefused { unit: NonEmptyStr, reason: String }
  | HostConvergeSlice1UnitUsageGuardRefused { unit: NonEmptyStr, current_bytes: ByteSize, target_cap_bytes: ByteSize }

type HostConvergeSlice1HostResult
  = HostConvergeSlice1HostEnumerated { host: HostIdentity, outcomes: List<HostConvergeSlice1UnitOutcome> }
  | HostConvergeSlice1HostRefused { reason: String }
  | HostConvergeSlice1HostEnumerationMismatch { mismatch: HostConvergeSlice1EnumerationMismatch }

fn host_converge_slice1_converge_unit(host: HostIdentity, unit: NonEmptyStr, knob: ConvergeKnob) -> HostConvergeSlice1UnitOutcome {
  match host_converge_slice1_probed_at() {
    Present { value: probed_at } =>
      match host_converge_slice1_live_read(unit: unit, probed_at: probed_at) {
        Present { value: precondition_read } =>
          match host_converge_slice1_memory_cap_verdict(read: precondition_read, knob: knob) {
            Present { value: v } =>
              match v {
                VerdictConverged =>
                  match host_converge_slice1_prove_reapply_noop(unit: unit, knob: knob) {
                    Present { value: why } => HostConvergeSlice1UnitRefused { unit: unit, reason: why }
                    _ =>
                      match host_converge_slice1_receipt_from_read(
                        host: host,
                        read: precondition_read,
                        knob: knob,
                        applied: false,
                        read_back_converged: true,
                        reapply_noop: true,
                      ) {
                        Present { value: receipt } => HostConvergeSlice1UnitConverged { unit: unit, applied: false, receipt: receipt }
                        _ => HostConvergeSlice1UnitRefused { unit: unit, reason: "host_converge_slice1: converged read failed receipt construction; fail-closed" }
                      }
                  }
                Drifted =>
                  match host_converge_slice1_usage_guard(unit: unit, target_bytes_value: knob.desired) {
                    HostConvergeSlice1UsageUnsafe { unit: _, current_bytes: cb, target_cap_bytes: tb } =>
                      HostConvergeSlice1UnitUsageGuardRefused { unit: unit, current_bytes: cb, target_cap_bytes: tb }
                    HostConvergeSlice1UsageUnknown { unit: _, reason: r } =>
                      HostConvergeSlice1UnitRefused { unit: unit, reason: concat("host_converge_slice1: usage guard could not prove safety before apply, fail-closed: ", r) }
                    HostConvergeSlice1UsageSafe { unit: _, current_bytes: _ } =>
                      if !host_converge_slice1_apply_memory_max(unit: unit, bytes_value: knob.desired) {
                        HostConvergeSlice1UnitRefused {
                          unit: unit,
                          reason: concat(
                            concat("host_converge_slice1: systemctl set-property MemoryMax failed for ", unit as String),
                            concat(" desired=", knob.desired)
                          ),
                        }
                      } else {
                        match host_converge_slice1_probed_at() {
                          Present { value: readback_at } =>
                            match host_converge_slice1_live_read(unit: unit, probed_at: readback_at) {
                              Present { value: read_back } =>
                                match host_converge_slice1_memory_cap_verdict(read: read_back, knob: knob) {
                                  Present { value: readback_verdict } =>
                                    match readback_verdict {
                                      VerdictConverged =>
                                        match host_converge_slice1_prove_reapply_noop(unit: unit, knob: knob) {
                                          Present { value: why } => HostConvergeSlice1UnitRefused { unit: unit, reason: why }
                                          _ =>
                                            match host_converge_slice1_receipt_from_read(
                                              host: host,
                                              read: read_back,
                                              knob: knob,
                                              applied: true,
                                              read_back_converged: true,
                                              reapply_noop: true,
                                            ) {
                                              Present { value: receipt } => HostConvergeSlice1UnitConverged { unit: unit, applied: true, receipt: receipt }
                                              _ => HostConvergeSlice1UnitRefused { unit: unit, reason: "host_converge_slice1: post-apply receipt construction failed; fail-closed" }
                                            }
                                        }
                                      Drifted =>
                                        HostConvergeSlice1UnitRefused { unit: unit, reason: "host_converge_slice1: independent read-back after apply still drifted; fail-closed" }
                                      _ =>
                                        HostConvergeSlice1UnitRefused { unit: unit, reason: "host_converge_slice1: read-back after apply returned Absent verdict; fail-closed" }
                                    }
                                  _ => HostConvergeSlice1UnitRefused { unit: unit, reason: "host_converge_slice1: read-back verdict missing after apply; fail-closed" }
                                }
                              _ => HostConvergeSlice1UnitRefused { unit: unit, reason: "host_converge_slice1: independent read-back after apply returned absent; fail-closed" }
                            }
                          _ => HostConvergeSlice1UnitRefused { unit: unit, reason: host_converge_slice1_probed_at_refusal_reason }
                        }
                      }
                  }
                _ =>
                  HostConvergeSlice1UnitRefused { unit: unit, reason: concat("host_converge_slice1: live MemoryMax parsed Absent (empty/untyped wire) for ", unit as String) }
              }
            _ => HostConvergeSlice1UnitRefused { unit: unit, reason: "host_converge_slice1: live MemoryMax verdict missing; fail-closed" }
          }
        _ => HostConvergeSlice1UnitRefused { unit: unit, reason: concat("host_converge_slice1: live systemctl show MemoryMax read absent for ", unit as String) }
      }
    _ => HostConvergeSlice1UnitRefused { unit: unit, reason: host_converge_slice1_probed_at_refusal_reason }
  }
}

fn host_converge_slice1_tasks_knob(host: HostIdentity) -> ConvergeKnob? {
  match host_converge_from_policy(policy: fleet_converge_policy(), host: host) {
    Present { value: hc } =>
      match converge_knob_by_name(host: hc, name: host_converge_slice1_tasks_knob_name) {
        Present { value: knob } =>
          match knob.target {
            PerSlotMemoryCap { dropin_path: _, instance_glob: _, property: p, bytes_value: b } =>
              if p == (systemd_tasks_max_property as String) && b == knob.desired {
                Present { value: knob }
              } else {
                none
              }
            _ => none
          }
        _ => none
      }
    _ => none
  }
}

fn host_converge_slice1_read_tasks_max_raw(unit: NonEmptyStr) -> String? {
  match systemctl_show_property_read_local(unit: unit, property: TasksMax) {
    SystemdPropertyCaptured { value: raw } => Present { value: raw }
    SystemdPropertyCaptureRefused { reason: _ } => none
  }
}

fn host_converge_slice1_read_tasks_current_raw(unit: NonEmptyStr) -> String? {
  match systemctl_show_property_read_local(unit: unit, property: TasksCurrent) {
    SystemdPropertyCaptured { value: raw } => Present { value: raw }
    SystemdPropertyCaptureRefused { reason: _ } => none
  }
}

// Verdict over the live TasksMax read against the knob's desired count. An empty or
// unparseable wire is the Absent verdict (untyped wire, refused upstream), never Drifted:
// Drifted is reserved for a real limit that disagrees, because Drifted is the arm that
// arms the apply path.
fn host_converge_slice1_tasks_verdict(limit: SystemdCgroupTaskLimit, knob: ConvergeKnob) -> ConvergeVerdict {
  match limit {
    TaskLimitCount { count: n } =>
      if to_string(n) == knob.desired { VerdictConverged } else { Drifted }
    TaskLimitUnbounded => Drifted
    TaskLimitAbsent => Absent
  }
}

fn host_converge_slice1_apply_tasks_max(unit: NonEmptyStr, value: String) -> Bool {
  systemctl_set_property_local(
    unit: unit,
    property: systemd_tasks_max_property,
    value: value as NonEmptyStr,
  )
}

type HostConvergeSlice1TasksGuardOutcome
  = HostConvergeSlice1TasksSafe { unit: NonEmptyStr, current_count: Int }
  | HostConvergeSlice1TasksUnsafe { unit: NonEmptyStr, current_count: Int, target_count: Int }
  | HostConvergeSlice1TasksUnknown { unit: NonEmptyStr, reason: String }

// Pure boundary predicate for the tasks guard, extracted so the >= boundary is
// witnessable: equality means zero headroom (the next clone() EAGAINs), so it refuses.
fn host_converge_slice1_tasks_headroom_refuses(current: Int, target: Int) -> Bool {
  current >= target
}

fn host_converge_slice1_tasks_guard(unit: NonEmptyStr, target_value: String) -> HostConvergeSlice1TasksGuardOutcome {
  match parse_int(s: target_value) {
    Present { value: target } =>
      match host_converge_slice1_read_tasks_current_raw(unit: unit) {
        Present { value: raw } =>
          match parse_systemd_task_limit_show(raw: raw) {
            TaskLimitCount { count: current } =>
              if host_converge_slice1_tasks_headroom_refuses(current: current, target: target) {
                HostConvergeSlice1TasksUnsafe { unit: unit, current_count: current, target_count: target }
              } else {
                HostConvergeSlice1TasksSafe { unit: unit, current_count: current }
              }
            _ =>
              HostConvergeSlice1TasksUnknown {
                unit: unit,
                reason: "host_converge_slice1: live TasksCurrent read unbounded or unparseable; cannot bound usage against target cap; fail-closed",
              }
          }
        _ =>
          HostConvergeSlice1TasksUnknown {
            unit: unit,
            reason: "host_converge_slice1: live systemctl show TasksCurrent read absent; fail-closed",
          }
      }
    _ =>
      HostConvergeSlice1TasksUnknown {
        unit: unit,
        reason: "host_converge_slice1: target TasksMax value did not parse as Int; fail-closed",
      }
  }
}

fn host_converge_slice1_tasks_receipt(
  host: HostIdentity,
  unit: NonEmptyStr,
  knob: ConvergeKnob,
  limit: SystemdCgroupTaskLimit,
  probed_at: NonEmptyStr,
  applied: Bool,
  read_back_converged: Bool,
  reapply_noop: Bool,
) -> HostConvergeSlice1TasksMaxReceipt {
  HostConvergeSlice1TasksMaxReceipt {
    host: host,
    unit: unit,
    knob: knob,
    limit: limit,
    verdict: host_converge_slice1_tasks_verdict(limit: limit, knob: knob),
    probed_at: probed_at,
    applied: applied,
    read_back_converged: read_back_converged,
    reapply_noop: reapply_noop,
  }
}

fn host_converge_slice1_tasks_receipt_is_valid(receipt: HostConvergeSlice1TasksMaxReceipt) -> Bool {
  receipt.read_back_converged
    && receipt.reapply_noop
    && receipt.verdict == VerdictConverged
}

fn host_converge_slice1_tasks_read_limit(unit: NonEmptyStr) -> SystemdCgroupTaskLimit? {
  match host_converge_slice1_read_tasks_max_raw(unit: unit) {
    Present { value: raw } => Present { value: parse_systemd_task_limit_show(raw: raw) }
    _ => none
  }
}

// The reapply-noop second write intentionally bypasses the TasksCurrent guard: it is only
// reachable after an independent read proved the effective TasksMax already equals the
// desired value, and re-applying the effective value cannot lower headroom (TasksCurrent
// is always <= the effective cap), so the EAGAIN-starvation class the guard exists for is
// physically unreachable on this arm. Mirrors the memory circuit's reapply-noop.
fn host_converge_slice1_prove_tasks_reapply_noop(unit: NonEmptyStr, knob: ConvergeKnob) -> String? {
  if !host_converge_slice1_apply_tasks_max(unit: unit, value: knob.desired) {
    Present {
      value: "host_converge_slice1: tasks reapply-noop second apply (systemctl set-property TasksMax) failed; fail-closed",
    }
  } else {
    match host_converge_slice1_tasks_read_limit(unit: unit) {
      Present { value: limit } =>
        match host_converge_slice1_tasks_verdict(limit: limit, knob: knob) {
          VerdictConverged => none
          Drifted =>
            Present {
              value: "host_converge_slice1: tasks reapply-noop failed — still drifted after second apply; fail-closed",
            }
          Absent =>
            Present {
              value: "host_converge_slice1: tasks reapply-noop read returned Absent verdict after second apply; fail-closed",
            }
        }
      _ =>
        Present {
          value: "host_converge_slice1: tasks reapply-noop independent read after second apply absent; fail-closed",
        }
    }
  }
}

fn host_converge_slice1_converge_unit_tasks(host: HostIdentity, unit: NonEmptyStr, knob: ConvergeKnob) -> HostConvergeSlice1UnitOutcome {
  match host_converge_slice1_probed_at() {
    Present { value: probed_at } =>
      match host_converge_slice1_tasks_read_limit(unit: unit) {
        Present { value: limit } =>
          match host_converge_slice1_tasks_verdict(limit: limit, knob: knob) {
            VerdictConverged =>
              match host_converge_slice1_prove_tasks_reapply_noop(unit: unit, knob: knob) {
                Present { value: why } => HostConvergeSlice1UnitRefused { unit: unit, reason: why }
                _ =>
                  HostConvergeSlice1UnitTasksConverged {
                    unit: unit,
                    applied: false,
                    receipt: host_converge_slice1_tasks_receipt(
                      host: host, unit: unit, knob: knob, limit: limit, probed_at: probed_at,
                      applied: false, read_back_converged: true, reapply_noop: true,
                    ),
                  }
              }
            Drifted =>
              match host_converge_slice1_tasks_guard(unit: unit, target_value: knob.desired) {
                HostConvergeSlice1TasksUnsafe { unit: _, current_count: cc, target_count: tc } =>
                  HostConvergeSlice1UnitRefused {
                    unit: unit,
                    reason: concat(
                      concat(concat("host_converge_slice1: tasks guard refused apply for ", unit as String), concat(" current_tasks=", to_string(cc))),
                      concat(concat(" exceeds target_tasks_max=", to_string(tc)), "; retryable once the slot is quiet"),
                    ),
                  }
                HostConvergeSlice1TasksUnknown { unit: _, reason: r } =>
                  HostConvergeSlice1UnitRefused { unit: unit, reason: concat("host_converge_slice1: tasks guard could not prove safety before apply, fail-closed: ", r) }
                HostConvergeSlice1TasksSafe { unit: _, current_count: _ } =>
                  if !host_converge_slice1_apply_tasks_max(unit: unit, value: knob.desired) {
                    HostConvergeSlice1UnitRefused {
                      unit: unit,
                      reason: concat(
                        concat("host_converge_slice1: systemctl set-property TasksMax failed for ", unit as String),
                        concat(" desired=", knob.desired)
                      ),
                    }
                  } else {
                    match host_converge_slice1_probed_at() {
                      Present { value: readback_at } =>
                        match host_converge_slice1_tasks_read_limit(unit: unit) {
                          Present { value: read_back } =>
                            match host_converge_slice1_tasks_verdict(limit: read_back, knob: knob) {
                              VerdictConverged =>
                                match host_converge_slice1_prove_tasks_reapply_noop(unit: unit, knob: knob) {
                                  Present { value: why } => HostConvergeSlice1UnitRefused { unit: unit, reason: why }
                                  _ =>
                                    HostConvergeSlice1UnitTasksConverged {
                                      unit: unit,
                                      applied: true,
                                      receipt: host_converge_slice1_tasks_receipt(
                                        host: host, unit: unit, knob: knob, limit: read_back, probed_at: readback_at,
                                        applied: true, read_back_converged: true, reapply_noop: true,
                                      ),
                                    }
                                }
                              Drifted =>
                                HostConvergeSlice1UnitRefused { unit: unit, reason: "host_converge_slice1: tasks independent read-back after apply still drifted; fail-closed" }
                              Absent =>
                                HostConvergeSlice1UnitRefused { unit: unit, reason: "host_converge_slice1: tasks read-back after apply returned Absent verdict; fail-closed" }
                            }
                          _ => HostConvergeSlice1UnitRefused { unit: unit, reason: "host_converge_slice1: tasks independent read-back after apply returned absent; fail-closed" }
                        }
                      _ => HostConvergeSlice1UnitRefused { unit: unit, reason: host_converge_slice1_probed_at_refusal_reason }
                    }
                  }
              }
            Absent =>
              HostConvergeSlice1UnitRefused { unit: unit, reason: concat("host_converge_slice1: live TasksMax parsed Absent (empty/untyped wire) for ", unit as String) }
          }
        _ => HostConvergeSlice1UnitRefused { unit: unit, reason: concat("host_converge_slice1: live systemctl show TasksMax read absent for ", unit as String) }
      }
    _ => HostConvergeSlice1UnitRefused { unit: unit, reason: host_converge_slice1_probed_at_refusal_reason }
  }
}

fn host_converge_slice1_converge_host(host: HostIdentity, instance_glob: String) -> HostConvergeSlice1HostResult {
  match host_converge_slice1_per_slot_memory_max_knob(host: host) {
    Present { value: knob } =>
      match host_converge_slice1_tasks_knob(host: host) {
        Present { value: tasks_knob } =>
          match host_converge_slice1_enumerate_units(instance_glob: instance_glob) {
            Present { value: units } =>
              match host_converge_slice1_cross_check_enumeration(host: host, units: units) {
                Present { value: mismatch } => HostConvergeSlice1HostEnumerationMismatch { mismatch: mismatch }
                _ =>
                  HostConvergeSlice1HostEnumerated {
                    host: host,
                    outcomes: units.flat_map(u => [
                      host_converge_slice1_converge_unit(host: host, unit: u, knob: knob),
                      host_converge_slice1_converge_unit_tasks(host: host, unit: u, knob: tasks_knob),
                    ]),
                  }
              }
            _ => HostConvergeSlice1HostRefused { reason: concat("host_converge_slice1: live unit enumeration absent for glob ", instance_glob) }
          }
        _ => HostConvergeSlice1HostRefused { reason: "host_converge_slice1: per_slot_tasks_max knob absent from fleet_converge_policy for host; fail-closed" }
      }
    _ => HostConvergeSlice1HostRefused { reason: "host_converge_slice1: per_slot_memory_max_bytes knob absent from fleet_converge_policy for host; fail-closed" }
  }
}

fn host_converge_slice1_converge_srv3() -> HostConvergeSlice1HostResult {
  host_converge_slice1_converge_host(host: operator_host_srv3, instance_glob: runner_instance_glob(host: operator_host_srv3))
}

fn host_converge_slice1_prove_reapply_noop(unit: NonEmptyStr, knob: ConvergeKnob) -> String? {
  if !host_converge_slice1_apply_memory_max(unit: unit, bytes_value: knob.desired) {
    Present {
      value: "host_converge_slice1: reapply-noop second apply (systemctl set-property) failed; fail-closed",
    }
  } else {
    match host_converge_slice1_probed_at() {
      Present { value: reapply_at } =>
        match host_converge_slice1_live_read(unit: unit, probed_at: reapply_at) {
          Present { value: reapply_read } =>
            match host_converge_slice1_memory_cap_verdict(read: reapply_read, knob: knob) {
              Present { value: v } =>
                match v {
                  VerdictConverged => none
                  Drifted =>
                    Present {
                      value: "host_converge_slice1: reapply-noop failed — still drifted after second apply; fail-closed",
                    }
                  _ =>
                    Present {
                      value: "host_converge_slice1: reapply-noop read returned Absent verdict after second apply; fail-closed",
                    }
                }
              _ =>
                Present {
                  value: "host_converge_slice1: reapply-noop verdict missing after second apply; fail-closed",
                }
            }
          _ =>
            Present {
              value: "host_converge_slice1: reapply-noop independent read after second apply absent; fail-closed",
            }
        }
      _ =>
        Present { value: host_converge_slice1_probed_at_refusal_reason }
    }
  }
}

fn host_converge_slice1_receipt_is_valid(receipt: HostConvergeSlice1MemoryCapReceipt) -> Bool {
  receipt.read_back_converged
    && receipt.reapply_noop
    && receipt.verdict == VerdictConverged
}

fn host_converge_slice1_unit_outcome_to_legacy_result(outcome: HostConvergeSlice1UnitOutcome) -> HostConvergeSlice1ConvergeResult {
  match outcome {
    HostConvergeSlice1UnitConverged { unit: _, applied: a, receipt: r } =>
      HostConvergeSlice1Converged { applied_knobs: if a { 1 } else { 0 }, receipt: r }
    HostConvergeSlice1UnitTasksConverged { unit: _, applied: a, receipt: r } =>
      HostConvergeSlice1TasksConverged { applied_knobs: if a { 1 } else { 0 }, receipt: r }
    HostConvergeSlice1UnitRefused { unit: _, reason: reason } =>
      HostConvergeSlice1Refused { reason: reason }
    HostConvergeSlice1UnitUsageGuardRefused { unit: u, current_bytes: cb, target_cap_bytes: tb } =>
      HostConvergeSlice1Refused {
        reason: concat(
          concat(concat("host_converge_slice1: usage guard refused apply for ", u as String), concat(" current_bytes=", to_string(byte_size_count(b: cb)))),
          concat(concat(" exceeds target_cap_bytes=", to_string(byte_size_count(b: tb))), "; retryable once the slot is quiet"),
        ),
      }
  }
}

fn host_converge_slice1_host_result_applied_count(result: HostConvergeSlice1HostResult) -> Int {
  match result {
    HostConvergeSlice1HostEnumerated { host: _, outcomes: os } =>
      fold(os, init: 0, f: fn(acc, o) {
        match host_converge_slice1_unit_outcome_to_legacy_result(o) {
          HostConvergeSlice1Converged { applied_knobs: n, receipt: _ } => acc + n
          HostConvergeSlice1TasksConverged { applied_knobs: n, receipt: _ } => acc + n
          _ => acc
        }
      })
    _ => 0
  }
}

fn host_converge_slice1_host_result_all_valid(result: HostConvergeSlice1HostResult) -> Bool {
  match result {
    HostConvergeSlice1HostEnumerated { host: _, outcomes: os } =>
      length(os) > 0
        && fold(os, init: true, f: fn(acc, o) {
          acc
            && match o {
              HostConvergeSlice1UnitConverged { unit: _, applied: _, receipt: r } => host_converge_slice1_receipt_is_valid(receipt: r)
              HostConvergeSlice1UnitTasksConverged { unit: _, applied: _, receipt: r } => host_converge_slice1_tasks_receipt_is_valid(receipt: r)
              _ => false
            }
        })
    _ => false
  }
}

fn host_converge_slice1_host_result_refusal_reason(result: HostConvergeSlice1HostResult) -> String? {
  match result {
    HostConvergeSlice1HostRefused { reason: why } => Present { value: why }
    HostConvergeSlice1HostEnumerationMismatch { mismatch: m } =>
      Present {
        value: concat(
          concat("host_converge_slice1: enumeration mismatch for ", m.host as String),
          concat(concat(" declared_count=", to_string(m.declared_count)), concat(" observed_count=", to_string(length(m.observed_units)))),
        ),
      }
    HostConvergeSlice1HostEnumerated { host: _, outcomes: os } =>
      fold(os, init: none, f: fn(acc, o) {
        match acc {
          Present { value: _ } => acc
          _ =>
            match host_converge_slice1_unit_outcome_to_legacy_result(o) {
              HostConvergeSlice1Refused { reason: why } => Present { value: why }
              _ => none
            }
        }
      })
  }
}

// srv1 probe-unit loop, both knobs: the memory outcome carries the legacy receipt shape;
// the tasks outcome must ALSO be valid-converged for the loop to report converged — an
// invalid or refused tasks outcome refuses the whole loop (never silently dropped), and a
// converged one adds its applied count.
fn host_converge_slice1_converge_loop() -> HostConvergeSlice1ConvergeResult {
  match host_converge_slice1_srv1_per_slot_memory_max_knob() {
    Present { value: knob } =>
      match host_converge_slice1_tasks_knob(host: operator_host_srv1) {
        Present { value: tasks_knob } =>
          match host_converge_slice1_unit_outcome_to_legacy_result(
            host_converge_slice1_converge_unit(host: operator_host_srv1, unit: host_converge_slice1_probe_unit, knob: knob)
          ) {
            HostConvergeSlice1Converged { applied_knobs: n, receipt: r } =>
              match host_converge_slice1_converge_unit_tasks(host: operator_host_srv1, unit: host_converge_slice1_probe_unit, knob: tasks_knob) {
                HostConvergeSlice1UnitTasksConverged { unit: _, applied: a, receipt: tr } =>
                  if host_converge_slice1_tasks_receipt_is_valid(receipt: tr) {
                    HostConvergeSlice1Converged { applied_knobs: n + (if a { 1 } else { 0 }), receipt: r }
                  } else {
                    HostConvergeSlice1Refused { reason: "host_converge_slice1: tasks receipt validity gate failed on srv1 probe unit; fail-closed" }
                  }
                HostConvergeSlice1UnitConverged { unit: _, applied: _, receipt: _ } =>
                  HostConvergeSlice1Refused { reason: "host_converge_slice1: tasks converge returned a memory-cap outcome; fail-closed" }
                HostConvergeSlice1UnitRefused { unit: _, reason: why } =>
                  HostConvergeSlice1Refused { reason: why }
                HostConvergeSlice1UnitUsageGuardRefused { unit: _, current_bytes: _, target_cap_bytes: _ } =>
                  HostConvergeSlice1Refused { reason: "host_converge_slice1: tasks converge returned a memory usage-guard outcome; fail-closed" }
              }
            HostConvergeSlice1TasksConverged { applied_knobs: _, receipt: _ } =>
              HostConvergeSlice1Refused { reason: "host_converge_slice1: memory converge returned a tasks outcome; fail-closed" }
            HostConvergeSlice1Refused { reason: why } => HostConvergeSlice1Refused { reason: why }
          }
        _ =>
          HostConvergeSlice1Refused {
            reason: "host_converge_slice1: per_slot_tasks_max knob absent from fleet_converge_policy for srv1; fail-closed",
          }
      }
    _ =>
      HostConvergeSlice1Refused {
        reason: "host_converge_slice1: per_slot_memory_max_bytes knob absent from fleet_converge_policy for srv1; fail-closed",
      }
  }
}
