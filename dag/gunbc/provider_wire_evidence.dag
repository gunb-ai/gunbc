module gunbc.provider_wire_evidence

import std.types { String, NonEmptyStr, FilePath, Bool, Int }
import std.content_hash { ContentHash, as_content_hash_sha512 }
import extdeps.shell
import extdeps.tools.sha512sum {
  sha512sum_observe_file,
  Sha512FileObserved,
  Sha512FileObservationRefused,
}

data provider_wire_evidence_note: String = "Durable private wire evidence for provider account-standing captures. Bytes are written content-addressed under an evidence root (SHA-512 hex filename); digest observation uses extdeps.tools.sha512sum like gunbc.package_delivery."

type PrivateEvidenceRef {
  root: FilePath
  content_address_hex: NonEmptyStr
}

type ProcessExitObservation {
  success: Bool
}

type ProviderWireEvidenceReceipt {
  private_ref: PrivateEvidenceRef
  content_digest: ContentHash
  byte_count: Int
  process_exit: ProcessExitObservation
  stderr_ref: PrivateEvidenceRef?
}

data private_evidence_staging_rel: NonEmptyStr = ".retain-staging" as NonEmptyStr

fn private_evidence_object_path(root: FilePath, hex: NonEmptyStr) -> String {
  concat(root as String, concat("/", hex as String))
}

type PrivateEvidenceBytesRetention
  = PrivateEvidenceBytesRetained {
      ref: PrivateEvidenceRef
      content_digest: ContentHash
      byte_count: Int
    }

fn retain_private_evidence_bytes_detailed(
  root: FilePath,
  bytes: String,
) -> PrivateEvidenceBytesRetention? {
  let made = shell.Mkdir.Parents(path: root)
  if made.success == false {
    none
  } else {
    let staging_path = concat(root as String, concat("/", private_evidence_staging_rel as String))
    let wrote = Filesystem.Write(path: staging_path, content: bytes)
    if wrote.success == false {
      none
    } else {
      match sha512sum_observe_file(path: staging_path as FilePath) {
        Sha512FileObservationRefused { cause: _ } => none
        Sha512FileObserved { digest } => {
          let dest_path = private_evidence_object_path(root: root, hex: digest.hex)
          let dest_wrote = Filesystem.Write(path: dest_path, content: bytes)
          if dest_wrote.success == false {
            none
          } else {
            Present {
              value: PrivateEvidenceBytesRetained {
                ref: PrivateEvidenceRef {
                  root: root,
                  content_address_hex: digest.hex,
                },
                content_digest: as_content_hash_sha512(digest: digest),
                byte_count: string_length(s: bytes),
              }
            }
          }
        }
      }
    }
  }
}

fn retain_private_evidence_bytes(root: FilePath, bytes: String) -> PrivateEvidenceRef? {
  match retain_private_evidence_bytes_detailed(root: root, bytes: bytes) {
    Absent => none
    Present { value: retained } => Present { value: retained.ref }
  }
}

fn retain_provider_wire_capture(
  evidence_root: FilePath,
  stdout: String,
  stderr: String,
  success: Bool,
) -> ProviderWireEvidenceReceipt? {
  match retain_private_evidence_bytes_detailed(root: evidence_root, bytes: stdout) {
    Absent => none
    Present { value: stdout_retained } =>
      if stderr == "" {
        Present {
          value: ProviderWireEvidenceReceipt {
            private_ref: stdout_retained.ref,
            content_digest: stdout_retained.content_digest,
            byte_count: stdout_retained.byte_count,
            process_exit: ProcessExitObservation { success: success },
            stderr_ref: none,
          }
        }
      } else {
        match retain_private_evidence_bytes(root: evidence_root, bytes: stderr) {
          Absent => none
          Present { value: stderr_ref } =>
            Present {
              value: ProviderWireEvidenceReceipt {
                private_ref: stdout_retained.ref,
                content_digest: stdout_retained.content_digest,
                byte_count: stdout_retained.byte_count,
                process_exit: ProcessExitObservation { success: success },
                stderr_ref: Present { value: stderr_ref },
              }
            }
        }
      }
  }
}
