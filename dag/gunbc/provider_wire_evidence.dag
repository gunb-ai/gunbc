module gunbc.provider_wire_evidence

import std.types { String, NonEmptyStr, FilePath, Bool, Int }
import std.content_hash { ContentHash, as_content_hash_sha512 }
import std.measure { ByteSize, byte_size }
import extdeps.shell
import extdeps.shell.exec
import extdeps.filesystem.filesystem_io
import extdeps.tools.sha512sum {
  sha512sum_observe_file,
  Sha512FileObserved,
  Sha512FileObservationRefused,
}

// Durable private wire evidence for provider account-standing captures. Publication is exclusive
// under an evidence root: 0700 directory → unique same-directory temporary file → write raw bytes →
// SHA-512 → hardlink to content-addressed name (fails closed if a concurrent writer already
// published a different object at that hex) → independent digest read-back → 0600 retained object →
// remove temporary. byte_count is ByteSize (std.measure) over the UTF-8 code-unit length of the
// retained String carrier (substrate String length), not a separate host byte-count observation.

// ProcessExitObservation models shell.Exec transport facts (success bool + optional exit_code), not
// std.process.ProcessExit (ExitSuccess | ExitFailure with code and reason). Press receipt exit
// semantics live in gunbc.codex_app_server_press.ProviderProcessExit (parsed sentinel mux vs
// observation-failed). Converge on shell→intent typed stdio transport
// (docs/plans/shell-intent-emit-realization-design.md) — this observation carrier deletes when
// typed stdio replaces sentinel reparsing.

type PrivateEvidenceRef {
  root: FilePath
  content_address_hex: NonEmptyStr
}

type ProcessExitObservation {
  success: Bool
  exit_code: Int?
}

type ProviderWireEvidenceReceipt {
  private_ref: PrivateEvidenceRef
  content_digest: ContentHash
  byte_count: ByteSize
  process_exit: ProcessExitObservation
  stderr_ref: PrivateEvidenceRef?
}

type PrivateEvidenceBytesRetention
  = PrivateEvidenceBytesRetained {
      ref: PrivateEvidenceRef
      content_digest: ContentHash
      byte_count: ByteSize
    }
  | PrivateEvidenceBytesRetentionRefused {
      cause: NonEmptyStr
    }

type ProviderWireCaptureOutcome
  = ProviderWireCaptureOk {
      receipt: ProviderWireEvidenceReceipt
    }
  | ProviderWireCaptureRefused {
      cause: NonEmptyStr
    }

fn private_evidence_object_path(root: FilePath, hex: NonEmptyStr) -> String {
  concat(root as String, concat("/", hex as String))
}

// TYPED OPS, NOT CONCAT-BUILT SCRIPTS (review 50540). Every effect below previously assembled a
// shell script by concat-ing a FilePath into a single-quoted string and running it through
// retained_foreign. In THIS module that was the sharpest form of the defect: these effects create
// the private evidence root and set 0700/0600 on retained provider wire bytes, so an evidence root
// containing an apostrophe did not merely fail — it terminated the quote and let the remainder of
// the path be read as shell words, in the one module whose job is to keep those bytes owner-only.
// Each is now a typed operation in extdeps.shell where the path is a distinct argv element and no
// quoting exists to escape. The exclusivity the publish relies on is unchanged and now explicit at
// the authority: ln fails when the destination exists, which is what makes the concurrent-writer
// arm reachable rather than racy.
//
// The Bool collapse went with it. ensure_private_evidence_root answered one false for two effects
// with different remedies — a missing-or-unwritable parent directory versus a directory that exists
// but could not be made owner-only — and the caller's cause string named both at once (DESIGN §5
// state-space conflation: two states whose remedies differ merged into one). Each arm now carries
// its own cause, and the 0700 failure in particular is a confidentiality-relevant state that a
// reader must be able to tell from a mkdir failure.

type PrivateEvidenceRootReadiness
  = PrivateEvidenceRootReady
  | PrivateEvidenceRootRefused { cause: NonEmptyStr }

fn ensure_private_evidence_root(root: FilePath) -> PrivateEvidenceRootReadiness {
  let made = shell.Mkdir.Parents(path: root)
  if made.success == false {
    PrivateEvidenceRootRefused {
      cause: "private evidence root could not be created" as NonEmptyStr,
    }
  } else {
    let mode = shell.Chmod.OwnerOnlyDirectory(path: root)
    if mode.success == false {
      PrivateEvidenceRootRefused {
        cause: "private evidence root exists but could not be made owner-only (0700)" as NonEmptyStr,
      }
    } else {
      PrivateEvidenceRootReady
    }
  }
}

fn mktemp_file_in_dir(dir: FilePath) -> FilePath? {
  let run = shell.Mktemp.FileInDirectory(dir: dir)
  if run.success == false || (run.path as String).trim() == "" {
    none
  } else {
    Present { value: (run.path as String).trim() as FilePath }
  }
}

fn publish_evidence_object_exclusive(
  staging: FilePath,
  dest: FilePath,
) -> Bool {
  let linked = shell.Link.Hard(source: staging, destination: dest)
  if linked.success == false {
    false
  } else {
    let mode = shell.Chmod.OwnerReadWriteFile(path: dest)
    if mode.success == false {
      false
    } else {
      shell.Remove.FileForce(path: staging).success
    }
  }
}

// THE DISCARDED STAGING SWEEPS BELOW ARE EXPLICITLY BEST-EFFORT. They are members of the
// discarded-effect census #10574 opened over its own out-of-scope remainder, whose instrument is
// the selector `let _ = shell.<Op>` OR `let _ = Filesystem.<Op>` -- the wider of the two readings,
// since the defect is an ignored effect outcome and not a property of which service produced it.
// No total is transcribed here (DESIGN §6): run the selector and the population re-derives at any
// ref, where a copied number would rot independently of its subject.
//
// EVERY MEMBER IN THIS MODULE SHARES ONE DECLARATION, retain_private_evidence_bytes_detailed, so
// they are identified by the arm each follows -- staging write failed; staging digest observation
// refused; destination exists with its digest unreadable; destination exists and digests compared;
// exclusive publish lost the race -- and a roster at declaration grain would collapse them to one.
// This module gets the statement
// in its own right rather than a pointer to the package_delivery block, because it is the one
// census member whose subject IS confidentiality, and "the sweep result is ignored" is precisely
// the sentence that needs a reason here.
//
// The swept path is always the mktemp file this call minted inside the evidence root: unique,
// never re-derived, and unreachable by any reader -- evidence is reached only through
// PrivateEvidenceRef's content address, and nothing in the repository lists the root. mktemp
// creates it 0600 and ensure_private_evidence_root has already made the root 0700, so residue is
// no more exposed than the retained object sitting beside it, and it holds bytes this call is
// retaining anyway rather than a secret the call was supposed to destroy. A failed sweep therefore
// leaves unreferenced garbage under an owner-only root and changes no answer a caller can act on:
// each retention outcome is already decided by the write, the digest, or the publish the sweep
// follows.
//
// CHECKED BY CONSTRUCTION SITE, NOT BY NAME: every member reaches the single `staging` binding, whose
// only origin in this module is mktemp_file_in_dir's `shell.Mktemp.FileInDirectory`.
//
// WHAT WOULD FALSIFY THAT: a reader that LISTS the evidence root. An unreferenced staging file
// would then enter a population whose every member is supposed to be named by its own digest, and
// these sweeps would owe their outcomes to the caller. No such reader exists today; adding one is
// what obligates them.
fn retain_private_evidence_bytes_detailed(
  root: FilePath,
  bytes: String,
) -> PrivateEvidenceBytesRetention {
  match ensure_private_evidence_root(root: root) {
    PrivateEvidenceRootRefused { cause: root_cause } =>
      PrivateEvidenceBytesRetentionRefused { cause: root_cause }
    PrivateEvidenceRootReady => {
    match mktemp_file_in_dir(dir: root) {
      Absent =>
        PrivateEvidenceBytesRetentionRefused {
          cause: "private evidence staging mktemp failed" as NonEmptyStr,
        }
      Present { value: staging } => {
        let wrote = Filesystem.Write(path: staging as String, content: bytes)
        if wrote.success == false {
          let _ = shell.Remove.RecursiveForce(path: staging)
          PrivateEvidenceBytesRetentionRefused {
            cause: "private evidence staging write failed" as NonEmptyStr,
          }
        } else {
          match sha512sum_observe_file(path: staging) {
            Sha512FileObservationRefused { cause: cause } => {
              let _ = shell.Remove.RecursiveForce(path: staging)
              PrivateEvidenceBytesRetentionRefused { cause: cause }
            }
            Sha512FileObserved { digest } => {
              let dest_path = private_evidence_object_path(root: root, hex: digest.hex) as FilePath
              let existing = shell.Test.IsFile(path: dest_path)
              if existing.is_file {
                match sha512sum_observe_file(path: dest_path) {
                  Sha512FileObservationRefused { cause: cause } => {
                    let _ = shell.Remove.RecursiveForce(path: staging)
                    PrivateEvidenceBytesRetentionRefused { cause: cause }
                  }
                  Sha512FileObserved { digest: existing_digest } => {
                    let _ = shell.Remove.RecursiveForce(path: staging)
                    if (existing_digest.hex as String) != (digest.hex as String) {
                      PrivateEvidenceBytesRetentionRefused {
                        cause: "concurrent private evidence digest mismatch" as NonEmptyStr,
                      }
                    } else {
                      PrivateEvidenceBytesRetained {
                        ref: PrivateEvidenceRef {
                          root: root,
                          content_address_hex: digest.hex,
                        },
                        content_digest: as_content_hash_sha512(digest: digest),
                        byte_count: byte_size(count: string_length(s: bytes)),
                      }
                    }
                  }
                }
              } else if publish_evidence_object_exclusive(
                staging: staging,
                dest: dest_path,
              ) == false {
                let _ = shell.Remove.RecursiveForce(path: staging)
                match sha512sum_observe_file(path: dest_path) {
                  Sha512FileObserved { digest: winner } =>
                    if (winner.hex as String) == (digest.hex as String) {
                      PrivateEvidenceBytesRetained {
                        ref: PrivateEvidenceRef {
                          root: root,
                          content_address_hex: digest.hex,
                        },
                        content_digest: as_content_hash_sha512(digest: digest),
                        byte_count: byte_size(count: string_length(s: bytes)),
                      }
                    } else {
                      PrivateEvidenceBytesRetentionRefused {
                        cause: "exclusive evidence publish lost race to different digest" as NonEmptyStr,
                      }
                    }
                  Sha512FileObservationRefused { cause: cause } =>
                    PrivateEvidenceBytesRetentionRefused { cause: cause }
                }
              } else {
                match sha512sum_observe_file(path: dest_path) {
                  Sha512FileObservationRefused { cause: cause } =>
                    PrivateEvidenceBytesRetentionRefused { cause: cause }
                  Sha512FileObserved { digest: readback } =>
                    if (readback.hex as String) != (digest.hex as String) {
                      PrivateEvidenceBytesRetentionRefused {
                        cause: "private evidence read-back digest mismatch" as NonEmptyStr,
                      }
                    } else {
                      PrivateEvidenceBytesRetained {
                        ref: PrivateEvidenceRef {
                          root: root,
                          content_address_hex: digest.hex,
                        },
                        content_digest: as_content_hash_sha512(digest: digest),
                        byte_count: byte_size(count: string_length(s: bytes)),
                      }
                    }
                }
              }
            }
          }
        }
      }
    }
  }
  }
}

fn retain_private_evidence_bytes(root: FilePath, bytes: String) -> PrivateEvidenceRef? {
  match retain_private_evidence_bytes_detailed(root: root, bytes: bytes) {
    PrivateEvidenceBytesRetentionRefused { cause: _ } => none
    PrivateEvidenceBytesRetained { ref: ref, content_digest: _, byte_count: _ } =>
      Present { value: ref }
  }
}

fn retain_provider_wire_capture(
  evidence_root: FilePath,
  stdout: String,
  stderr: String,
  success: Bool,
  exit_code: Int?,
) -> ProviderWireCaptureOutcome {
  match retain_private_evidence_bytes_detailed(root: evidence_root, bytes: stdout) {
    PrivateEvidenceBytesRetentionRefused { cause: cause } =>
      ProviderWireCaptureRefused { cause: cause }
    PrivateEvidenceBytesRetained {
      ref: stdout_ref,
      content_digest: stdout_digest,
      byte_count: stdout_bytes,
    } =>
      if stderr == "" {
        ProviderWireCaptureOk {
          receipt: ProviderWireEvidenceReceipt {
            private_ref: stdout_ref,
            content_digest: stdout_digest,
            byte_count: stdout_bytes,
            process_exit: ProcessExitObservation {
              success: success,
              exit_code: exit_code,
            },
            stderr_ref: none,
          },
        }
      } else {
        match retain_private_evidence_bytes_detailed(root: evidence_root, bytes: stderr) {
          PrivateEvidenceBytesRetentionRefused { cause: cause } =>
            ProviderWireCaptureRefused { cause: cause }
          PrivateEvidenceBytesRetained { ref: stderr_ref, content_digest: _, byte_count: _ } =>
            ProviderWireCaptureOk {
              receipt: ProviderWireEvidenceReceipt {
                private_ref: stdout_ref,
                content_digest: stdout_digest,
                byte_count: stdout_bytes,
                process_exit: ProcessExitObservation {
                  success: success,
                  exit_code: exit_code,
                },
                stderr_ref: Present { value: stderr_ref },
              },
            }
        }
      }
  }
}
