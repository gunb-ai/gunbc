module gunbc.typed_remote_file_write

data typed_remote_file_write_authority_note: String = "Typed remote file-bytes write at the FleetSsh seam. TypedRemoteFileWrite is sole_constructor: the ONLY representable meaning is write these exact bytes to this exact path. Remote realization is portable argv [tee, path] with content on stdin — bytes are DATA, never interpreted as shell. No script body arm, no sh -c, no command string constructor. Path containment uses gunbc.file_access path_within_file_tree_scope (exact root, root/…, .. rejected); portable-word allowlist uses gunbc.fleet_known_hosts_anchor portable_remote_word at seal and portable_remote_words at execute (one authority, no typed_argv fork). typed_remote_file_write_over_fleet_ssh accepts only TypedRemoteFileWriteAdmitted. TypedRemoteFileWriteOutcome success arm is TypedRemoteFileWriteRemoteExecAccepted (tee exit 0 only) — NOT convergence. A zero tee exit proves only that the remote process accepted stdin — not that bytes landed at the declared path with declared mode/ownership. A future TypedRemoteFileWriteConverged variant requires independent read-back digest match (operator ruling msg_71f67aa9); stage-and-rename + mode/ownership + read-back land before that arm is writable."

data typed_remote_file_write_wet_fleet_ssh_execute_deferred_note: String = "Operator ruling msg_71f67aa9 authorizes substrate-before-consumer landing on this PR: generic FleetSsh tee+stdin here; wet roundtrip, stage-and-rename, mode/ownership, read-back digest, and first production consumer follow on #8281 integration branch — not a Scaffold row and no DissolutionCondition in this diff. Hermetic witnesses exercise seal, argv, preflight, and RemoteExecAccepted routing via ssh.Session.ExecPortableWordsWithStdin mock_response only."

type TypedRemoteFileWrite sole_constructor {
  path: std.types.FilePath
  content: String
}

type TypedRemoteFileWriteAdmission
  = TypedRemoteFileWriteAdmitted { write: TypedRemoteFileWrite }
  | TypedRemoteFileWriteAdmissionRefused { cause: std.types.NonEmptyStr }

type TypedRemoteFileWriteOutcome
  = TypedRemoteFileWriteRemoteExecAccepted { result: extdeps.ssh.session.SshSessionExecResult }
  | TypedRemoteFileWriteOutcomeRefused { reason: String }

// ── Convergence ─────────────────────────────────────────────────────────────────────────────────
//
// `TypedRemoteFileWriteRemoteExecAccepted` is a zero exit from the writing process and the authority
// note above is explicit that this is NOT convergence: it proves the remote accepted stdin, not that
// the declared bytes are at the declared path with the declared mode. This section adds the arm that
// ruling reserved.
//
// FOUR STEPS, and the ORDER is the property.
//
//   1. stage    -- write the bytes to a sibling staging path, never to the destination
//   2. mode     -- set the mode on the staged file, before anything can observe it at its real name
//   3. rename   -- `mv -f` within one directory, which POSIX makes atomic, so no reader ever sees a
//                  partially written or wrong-moded file at the destination
//   4. read back-- `cat` the DESTINATION and compare to the declared content in the model
//
// Writing straight to the destination and then chmod-ing is the shape this replaces: it publishes
// incomplete bytes under the real name, and on a unit file that is a window where systemd can read
// something that was never a valid unit.
//
// WHY `dd status=none` AND NOT `tee`. `tee` copies stdin to stdout, so every byte written is also
// echoed back across the SSH channel and into whatever captures it -- doubling transfer and putting
// file content into logs. `dd status=none` writes and says nothing. This is not a style preference:
// a credential or config file written through `tee` has its contents in the run log.
//
// WHY READ-BACK BY CONTENT AND NOT BY DIGEST. A digest comparison needs a digest of the INTENDED
// bytes, and `.dag` has no SHA-256 over a `String` -- `extdeps.crypto.hash` `Digest` carries a hex
// its caller supplies. Comparing a remote `sha256sum` of the staged file to a remote `sha256sum` of
// the destination would prove only that the rename moved the same bytes, saying nothing about
// whether those bytes were the ones intended, which is the question. Reading the file back and
// comparing to the declared content answers it directly and the comparison happens in the model,
// where a witness can exercise it. For a unit file the transfer is a few hundred bytes.
type RemoteFileMode
  = RemoteFileModeOwnerReadWrite
  | RemoteFileModeOwnerReadWriteWorldRead

fn remote_file_mode_octal(mode: RemoteFileMode) -> String {
  match mode {
    RemoteFileModeOwnerReadWrite => "600"
    RemoteFileModeOwnerReadWriteWorldRead => "644"
  }
}

type TypedRemoteFileConvergence
  = TypedRemoteFileConverged { path: std.types.FilePath, mode: RemoteFileMode }
  | TypedRemoteFileConvergenceRefused { step: String, reason: String }

// The staging sibling. It MUST share a directory with the destination: `mv` is atomic only within
// one filesystem, and a suffix on the same path is the cheapest way to guarantee that without
// modeling mount points. The suffix is dot-separated so it stays inside the portable-word allowlist.
fn typed_remote_file_staging_path(write: TypedRemoteFileWrite) -> String {
  concat(write.path as String, ".gunbc-staging")
}

fn typed_remote_file_stage_argv(write: TypedRemoteFileWrite) -> List<String> {
  ["dd", "status=none", concat("of=", typed_remote_file_staging_path(write: write))]
}

fn typed_remote_file_chmod_argv(write: TypedRemoteFileWrite, mode: RemoteFileMode) -> List<String> {
  [chmod_path_resolved_program as String, remote_file_mode_octal(mode: mode), typed_remote_file_staging_path(write: write)]
}

fn typed_remote_file_rename_argv(write: TypedRemoteFileWrite) -> List<String> {
  ["mv", "-f", typed_remote_file_staging_path(write: write), write.path as String]
}

// THE COMPARISON HAPPENS FAR-SIDE, AND ONLY AN EXIT CODE COMES BACK.
//
// This read `cat <path>` and compared the returned stdout to the declared content here. That cannot
// work for arbitrary bytes and the reason is structural, not a bug in the comparison: the shell
// transport delivers stdout through `retained_utf8_lossy_trimmed`, so the channel is a TRIMMED
// string. Trimming is right for `hostname` or `systemctl is-enabled`, where the trailing newline is
// noise, and wrong here, where the bytes ARE the payload -- the transport conflates "the text a
// command printed" with "the bytes a command emitted", and a unit file ending in a newline can never
// compare equal. Measured on srv6: declared_bytes=500 read_back_bytes=499, every run, deterministic.
//
// Widening the transport was the wrong fix and the corpus says so: a new untrimmed output binding is
// PublicSurfaceGrowth against a seed whose semantics are frozen, and refusal dominates admission
// there. Trimming the declared side to match would be worse -- it is exactly the normalization
// the exact comparison refuses, and it would let a real trailing-byte difference pass.
//
// So the payload does not round-trip at all. `cmp -s - <path>` reads the declared bytes from stdin
// and compares them far-side, and the verdict rides home as an exit code, which no trim can alter.
// The evidence is strictly stronger than the old read-back: it never assumed the transport could
// carry arbitrary bytes faithfully, and it stops shipping whole files back through stdout. cmp's own
// exit vocabulary distinguishes a difference (1) from an error reading either side (2), so those stay
// two refusals rather than collapsing into one.
fn typed_remote_file_compare_argv(write: TypedRemoteFileWrite) -> List<String> {
  ["cmp", "-s", "-", write.path as String]
}

// The read-back judgment, pure so every arm is reachable hermetically. Exact comparison, with no
// trimming: normalizing whitespace here would let a real difference pass, and a file whose trailing
// bytes differ from the declared content is not the file that was declared.
// The comparison verdict, pure so every arm is reachable hermetically. The arms are cmp's own exit
// vocabulary and are NOT collapsed: 0 is identical, 1 is a real content difference, and anything else
// means cmp could not compare -- a missing file, an unreadable one, a cmp that is not there. Reporting
// the third as a difference would blame the content for a failure to look at it.
fn classify_typed_remote_file_comparison(
  write: TypedRemoteFileWrite,
  mode: RemoteFileMode,
  compare_exit_code: Int,
  compare_stderr: String,
) -> TypedRemoteFileConvergence {
  if compare_exit_code == 0 {
    TypedRemoteFileConverged { path: write.path, mode: mode }
  } else if compare_exit_code == 1 {
    TypedRemoteFileConvergenceRefused {
      step: "compare",
      reason: join([
        "the bytes at ", write.path as String,
        " are not the declared content: the write reported success and the file is something else",
        " (declared_bytes=", to_string(string_length(s: write.content)), ")",
      ], ""),
    }
  } else {
    TypedRemoteFileConvergenceRefused {
      step: "compare",
      reason: join([
        "could not compare ", write.path as String,
        " against the declared content after rename: cmp exit=",
        to_string(compare_exit_code), " ", trim(s: compare_stderr),
      ], ""),
    }
  }
}

data typed_remote_file_write_tee_command: String = "tee"

fn typed_remote_file_write_seal(
  path: std.types.FilePath,
  content: String,
  allowed_scope: gunbc.file_access.FileTreeScope,
) -> TypedRemoteFileWriteAdmission {
  if !gunbc.file_access.path_within_file_tree_scope(scope: allowed_scope, path: path as std.types.NonEmptyStr) {
    TypedRemoteFileWriteAdmissionRefused {
      cause: join(
        [
          "typed_remote_file_write: path ",
          path as String,
          " outside file tree scope rooted at ",
          allowed_scope.root_path as String,
        ],
        "",
      ) as std.types.NonEmptyStr,
    }
  } else {
    match gunbc.fleet_known_hosts_anchor.portable_remote_word(raw: path as String) {
      Absent =>
        TypedRemoteFileWriteAdmissionRefused {
          cause: join(
            [
              "typed_remote_file_write: path ",
              path as String,
              " is not portable under the far-side shell re-parse allowlist",
            ],
            "",
          ) as std.types.NonEmptyStr,
        }
      Present { value: _ } =>
        TypedRemoteFileWriteAdmitted {
          write: TypedRemoteFileWrite { path: path, content: content },
        }
    }
  }
}

fn typed_remote_file_write_stdin_payload(write: TypedRemoteFileWrite) -> String {
  write.content
}

// Remote argv is ONLY [tee, path] — no sh/bash/-c arm exists; bytes ride stdin, not argv.
fn typed_remote_file_write_remote_argv(write: TypedRemoteFileWrite) -> List<String> {
  [typed_remote_file_write_tee_command, write.path as String]
}

fn typed_remote_file_write_content_digest_hex(write: TypedRemoteFileWrite) -> String {
  std.content_hash.content_hash_atom(value: write.content as std.types.NonEmptyStr).digest as String
}

fn typed_remote_file_write_execute_preflight_outcome(
  target: gunbc.fleet_known_hosts_anchor.SshTarget,
  write: TypedRemoteFileWrite,
) -> TypedRemoteFileWriteOutcome? {
  match gunbc.fleet_known_hosts_anchor.portable_remote_words(raws: typed_remote_file_write_remote_argv(write: write)) {
    Absent =>
      Present {
        value: TypedRemoteFileWriteOutcomeRefused {
          reason: concat(
            "typed_remote_file_write: remote argv refused as non-portable for ",
            target.endpoint as String,
          ),
        },
      }
    Present { value: _ } => none
  }
}

fn typed_remote_file_write_outcome_after_ssh_exec(
  write: TypedRemoteFileWrite,
  result: extdeps.ssh.session.SshSessionExecResult,
) -> TypedRemoteFileWriteOutcome {
  if result.success {
    TypedRemoteFileWriteRemoteExecAccepted { result: result }
  } else {
    TypedRemoteFileWriteOutcomeRefused {
      reason: concat(
        "typed_remote_file_write: tee remote write failed for ",
        write.path as String,
      ),
    }
  }
}

fn typed_remote_file_write_over_fleet_ssh(
  target: gunbc.fleet_known_hosts_anchor.SshTarget,
  context: gunbc.fleet_known_hosts_anchor.FleetSshExecutionContext,
  admission: TypedRemoteFileWriteAdmission,
) -> TypedRemoteFileWriteOutcome {
  match admission {
    TypedRemoteFileWriteAdmissionRefused { cause: cause } =>
      TypedRemoteFileWriteOutcomeRefused { reason: cause as String }
    TypedRemoteFileWriteAdmitted { write: write } =>
      match gunbc.fleet_known_hosts_anchor.portable_remote_words(raws: typed_remote_file_write_remote_argv(write: write)) {
        Absent =>
          TypedRemoteFileWriteOutcomeRefused {
            reason: concat(
              "typed_remote_file_write: remote argv refused as non-portable for ",
              target.endpoint as String,
            ),
          }
        Present { value: words } =>
          typed_remote_file_write_outcome_after_ssh_exec(
            write: write,
            result: extdeps.ssh.session.ssh_session_exec_portable_words_with_stdin(
              client_args: gunbc.fleet_known_hosts_anchor.shape_fleet_ssh_exec(context: context, target: target, words: words),
              stdin_payload: typed_remote_file_write_stdin_payload(write: write),
            ),
          )
      }
  }
}

// ── The converging sequence ─────────────────────────────────────────────────────────────────────

// One remote step: portable-word admission, then the leg. A non-portable argv refuses BEFORE the
// leg rather than being quoted into something the far-side shell may re-split.
fn typed_remote_file_step(
  target: gunbc.fleet_known_hosts_anchor.SshTarget,
  context: gunbc.fleet_known_hosts_anchor.FleetSshExecutionContext,
  raws: List<String>,
  stdin_payload: String,
) -> extdeps.ssh.session.SshSessionExecResult? {
  match portable_remote_words(raws: raws) {
    Absent => none
    Present { value: words } => Present {
      value: ssh_session_exec_portable_words_with_stdin(
        client_args: shape_fleet_ssh_exec(context: context, target: target, words: words),
        stdin_payload: stdin_payload,
      ),
    }
  }
}

// A step that carries no stdin still goes through the stdin-bearing operation with an empty payload,
// so there is ONE leg shape rather than two that could drift apart.
fn typed_remote_file_step_outcome(
  target: gunbc.fleet_known_hosts_anchor.SshTarget,
  context: gunbc.fleet_known_hosts_anchor.FleetSshExecutionContext,
  step: String,
  raws: List<String>,
  stdin_payload: String,
) -> TypedRemoteFileConvergence? {
  match typed_remote_file_step(target: target, context: context, raws: raws, stdin_payload: stdin_payload) {
    Absent => Present {
      value: TypedRemoteFileConvergenceRefused {
        step: step,
        reason: "remote argv refused as non-portable under the far-side shell re-parse allowlist",
      },
    }
    Present { value: r } =>
      if r.success { none } else {
        Present {
          value: TypedRemoteFileConvergenceRefused {
            step: step,
            reason: concat("remote step failed: ", std.algebra.trim(s: r.stderr)),
          },
        }
      }
  }
}

// STAGE -> MODE -> RENAME -> READ BACK, halting at the first refusal. Each step's failure is located
// by name, so a converge that stops is a statement about WHICH invariant did not hold rather than a
// single opaque false. Nothing is published under the destination name until the rename, and nothing
// is called converged until the destination has been read back and compared.
func converge_typed_remote_file(
  target: gunbc.fleet_known_hosts_anchor.SshTarget,
  context: gunbc.fleet_known_hosts_anchor.FleetSshExecutionContext,
  admission: TypedRemoteFileWriteAdmission,
  mode: RemoteFileMode,
) -> TypedRemoteFileConvergence {
  match admission {
    TypedRemoteFileWriteAdmissionRefused { cause: cause } =>
      TypedRemoteFileConvergenceRefused { step: "admission", reason: cause as String }
    TypedRemoteFileWriteAdmitted { write: write } =>
      match typed_remote_file_step_outcome(
        target: target, context: context, step: "stage",
        raws: typed_remote_file_stage_argv(write: write),
        stdin_payload: typed_remote_file_write_stdin_payload(write: write),
      ) {
        Present { value: refusal } => refusal
        Absent =>
          match typed_remote_file_step_outcome(
            target: target, context: context, step: "mode",
            raws: typed_remote_file_chmod_argv(write: write, mode: mode),
            stdin_payload: "",
          ) {
            Present { value: refusal } => refusal
            Absent =>
              match typed_remote_file_step_outcome(
                target: target, context: context, step: "rename",
                raws: typed_remote_file_rename_argv(write: write),
                stdin_payload: "",
              ) {
                Present { value: refusal } => refusal
                Absent =>
                  match typed_remote_file_step(
                    target: target, context: context,
                    raws: typed_remote_file_compare_argv(write: write),
                    stdin_payload: write.content,
                  ) {
                    Absent =>
                      TypedRemoteFileConvergenceRefused {
                        step: "compare",
                        reason: "remote argv refused as non-portable under the far-side shell re-parse allowlist",
                      }
                    Present { value: back } =>
                      classify_typed_remote_file_comparison(
                        write: write,
                        mode: mode,
                        compare_exit_code: back.exit_code,
                        compare_stderr: back.stderr,
                      )
                  }
              }
          }
      }
  }
}
