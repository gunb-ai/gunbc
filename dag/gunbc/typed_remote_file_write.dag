module gunbc.typed_remote_file_write

import std.types { String, Bool, List, NonEmptyStr, FilePath, Int }
import std.content_hash { content_hash_atom }
import extdeps.ssh.session {
  ssh_session_exec_portable_words_with_stdin,
  SshSessionExecResult,
}
import gunbc.fleet_known_hosts_anchor {
  FleetSshExecutionContext,
  SshTarget,
  portable_remote_words,
  shape_fleet_ssh_exec,
}
import gunbc.typed_argv_exec { typed_argv_portable_argv_token }

data typed_remote_file_write_authority_note: String = "Typed remote file-bytes write at the FleetSsh seam (SPARK-SERVE-INSTALL-0 substrate). TypedRemoteFileWrite is sole_constructor: the ONLY representable meaning is write these exact bytes to this exact path. Remote realization is portable argv [tee, path] with content on stdin — bytes are DATA, never interpreted as shell. No script body arm, no sh -c, no command string constructor. Path must be within a declared allowed prefix and pass the portable-word allowlist."

data typed_remote_file_write_substrate_gap_closed_note: String = "Substrate PR closes spark_serving_membership CONDITION 1 FINDING for unit delivery: consumers seal path+content here; fleet execution routes through typed_remote_file_write_over_fleet_ssh."

type TypedRemoteFileWrite sole_constructor {
  path: FilePath
  content: String
}

type TypedRemoteFileWriteAdmission
  = TypedRemoteFileWriteAdmitted { write: TypedRemoteFileWrite }
  | TypedRemoteFileWriteRefused { cause: NonEmptyStr }

type TypedRemoteFileWriteOutcome
  = TypedRemoteFileWriteConverged { result: SshSessionExecResult }
  | TypedRemoteFileWriteRefused { reason: String }

data typed_remote_file_write_tee_command: String = "tee"

fn typed_remote_file_write_prefix_matches_at(
  path: String,
  prefix: String,
  i: Int,
  prefix_len: Int,
) -> Bool {
  if i >= prefix_len {
    true
  } else {
    if char_at(s: path, i: i) != char_at(s: prefix, i: i) {
      false
    } else {
      typed_remote_file_write_prefix_matches_at(
        path: path,
        prefix: prefix,
        i: i + 1,
        prefix_len: prefix_len,
      )
    }
  }
}

fn typed_remote_file_write_path_within_prefix(path: FilePath, allowed_prefix: NonEmptyStr) -> Bool {
  let p = path as String
  let pref = allowed_prefix as String
  let prefix_len = string_length(s: pref)
  let path_len = string_length(s: p)
  if path_len < prefix_len {
    false
  } else {
    typed_remote_file_write_prefix_matches_at(
      path: p,
      prefix: pref,
      i: 0,
      prefix_len: prefix_len,
    )
  }
}

fn typed_remote_file_write_path_portable(path: FilePath) -> Bool {
  typed_argv_portable_argv_token(token: path as String)
}

fn typed_remote_file_write_seal(
  path: FilePath,
  content: String,
  allowed_prefix: NonEmptyStr,
) -> TypedRemoteFileWriteAdmission {
  if !typed_remote_file_write_path_within_prefix(path: path, allowed_prefix: allowed_prefix) {
    TypedRemoteFileWriteRefused {
      cause: join(
        [
          "typed_remote_file_write: path ",
          path as String,
          " outside allowed prefix ",
          allowed_prefix as String,
        ],
        "",
      ) as NonEmptyStr,
    }
  } else {
    if !typed_remote_file_write_path_portable(path: path) {
      TypedRemoteFileWriteRefused {
        cause: join(
          [
            "typed_remote_file_write: path ",
            path as String,
            " is not portable under the far-side shell re-parse allowlist",
          ],
          "",
        ) as NonEmptyStr,
      }
    } else {
      TypedRemoteFileWriteAdmitted {
        write: TypedRemoteFileWrite { path: path, content: content },
      }
    }
  }
}

fn typed_remote_file_write_stdin_payload(write: TypedRemoteFileWrite) -> String {
  write.content
}

fn typed_remote_file_write_remote_argv(write: TypedRemoteFileWrite) -> List<String> {
  [typed_remote_file_write_tee_command, write.path as String]
}

fn typed_remote_file_write_argv_has_no_shell_body(argv: List<String>) -> Bool {
  !any(
    argv,
    token =>
      token == "sh"
        || token == "bash"
        || token == "-c"
        || token == "-s"
        || token == "exec",
  )
}

fn typed_remote_file_write_content_digest_hex(write: TypedRemoteFileWrite) -> String {
  content_hash_atom(value: write.content as NonEmptyStr).digest as String
}

fn typed_remote_file_write_over_fleet_ssh(
  target: SshTarget,
  context: FleetSshExecutionContext,
  write: TypedRemoteFileWrite,
) -> TypedRemoteFileWriteOutcome {
  match portable_remote_words(raws: typed_remote_file_write_remote_argv(write: write)) {
    Absent =>
      TypedRemoteFileWriteRefused {
        reason: concat(
          "typed_remote_file_write: remote argv refused as non-portable for ",
          target.endpoint as String,
        ),
      }
    Present { value: words } =>
      if !typed_remote_file_write_argv_has_no_shell_body(
        argv: typed_remote_file_write_remote_argv(write: write),
      ) {
        TypedRemoteFileWriteRefused {
          reason: "typed_remote_file_write: remote argv must be tee+path only — shell body tokens forbidden",
        }
      } else {
        let result = ssh_session_exec_portable_words_with_stdin(
          client_args: shape_fleet_ssh_exec(context: context, target: target, words: words),
          stdin_payload: typed_remote_file_write_stdin_payload(write: write),
        )
        if result.success {
          TypedRemoteFileWriteConverged { result: result }
        } else {
          TypedRemoteFileWriteRefused {
            reason: concat(
              "typed_remote_file_write: tee remote write failed for ",
              write.path as String,
            ),
          }
        }
      }
  }
}
