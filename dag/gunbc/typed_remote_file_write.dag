module gunbc.typed_remote_file_write

import std.types { String, List, NonEmptyStr, FilePath }
import std.content_hash { content_hash_atom }
import extdeps.ssh.session {
  ssh_session_exec_portable_words_with_stdin,
  SshSessionExecResult,
}
import gunbc.fleet_known_hosts_anchor {
  FleetSshExecutionContext,
  SshTarget,
  portable_remote_word,
  portable_remote_words,
  shape_fleet_ssh_exec,
}
import gunbc.file_access { FileTreeScope, path_within_file_tree_scope }

data typed_remote_file_write_authority_note: String = "Typed remote file-bytes write at the FleetSsh seam. TypedRemoteFileWrite is sole_constructor: the ONLY representable meaning is write these exact bytes to this exact path. Remote realization is portable argv [tee, path] with content on stdin — bytes are DATA, never interpreted as shell. No script body arm, no sh -c, no command string constructor. Path containment uses gunbc.file_access path_within_file_tree_scope (exact root, root/…, .. rejected); portable-word allowlist uses gunbc.fleet_known_hosts_anchor portable_remote_word at seal and portable_remote_words at execute (one authority, no typed_argv fork). typed_remote_file_write_over_fleet_ssh accepts only TypedRemoteFileWriteAdmitted. EXEC EXIT SUCCESS IS NOT CONVERGENCE: a zero tee exit proves only that the remote process accepted stdin — not that bytes landed at the declared path with declared mode/ownership. Convergence requires independent read-back digest match (operator ruling msg_71f67aa9); stage-and-rename + mode/ownership + read-back are follow-on in this module before any consumer may treat the outcome as converged."

data typed_remote_file_write_wet_fleet_ssh_execute_deferred_note: String = "Wet FleetSsh tee+stdin roundtrip, stage-and-rename atomicity, declared mode/ownership, and independent read-back digest verification are required before convergence — deferred to fleet-converge integration with #8281 as first consumer. Hermetic witnesses exercise seal, argv, execute preflight, and typed_remote_file_write_over_fleet_ssh exec-exit routing via ssh.Session.ExecPortableWordsWithStdin mock_response only."

data typed_remote_file_write_substrate_gap_closed_note: String = "Substrate module for generic remote file-bytes delivery at the FleetSsh seam. Consumers seal path+content here; fleet execution routes through typed_remote_file_write_over_fleet_ssh. First consumer: #8281 integration branch (user-unit write intent)."

type TypedRemoteFileWrite sole_constructor {
  path: FilePath
  content: String
}

type TypedRemoteFileWriteAdmission
  = TypedRemoteFileWriteAdmitted { write: TypedRemoteFileWrite }
  | TypedRemoteFileWriteAdmissionRefused { cause: NonEmptyStr }

type TypedRemoteFileWriteOutcome
  = TypedRemoteFileWriteConverged { result: SshSessionExecResult }
  | TypedRemoteFileWriteOutcomeRefused { reason: String }

data typed_remote_file_write_tee_command: String = "tee"

fn typed_remote_file_write_seal(
  path: FilePath,
  content: String,
  allowed_scope: FileTreeScope,
) -> TypedRemoteFileWriteAdmission {
  if !path_within_file_tree_scope(scope: allowed_scope, path: path as NonEmptyStr) {
    TypedRemoteFileWriteAdmissionRefused {
      cause: join(
        [
          "typed_remote_file_write: path ",
          path as String,
          " outside file tree scope rooted at ",
          allowed_scope.root_path as String,
        ],
        "",
      ) as NonEmptyStr,
    }
  } else {
    match portable_remote_word(raw: path as String) {
      Absent =>
        TypedRemoteFileWriteAdmissionRefused {
          cause: join(
            [
              "typed_remote_file_write: path ",
              path as String,
              " is not portable under the far-side shell re-parse allowlist",
            ],
            "",
          ) as NonEmptyStr,
        }
      Present { value: _ } =>
        TypedRemoteFileWriteAdmitted {
          write: TypedRemoteFileWrite { path: path, content: content },
        }
    }
  }
}

fn typed_remote_file_write_stdin_payload(write: TypedRemoteFileWrite) -> String {
  write.content
}

// Remote argv is ONLY [tee, path] — no sh/bash/-c arm exists; bytes ride stdin, not argv.
fn typed_remote_file_write_remote_argv(write: TypedRemoteFileWrite) -> List<String> {
  [typed_remote_file_write_tee_command, write.path as String]
}

fn typed_remote_file_write_content_digest_hex(write: TypedRemoteFileWrite) -> String {
  content_hash_atom(value: write.content as NonEmptyStr).digest as String
}

fn typed_remote_file_write_execute_preflight_outcome(
  target: SshTarget,
  write: TypedRemoteFileWrite,
) -> TypedRemoteFileWriteOutcome? {
  match portable_remote_words(raws: typed_remote_file_write_remote_argv(write: write)) {
    Absent =>
      Present {
        value: TypedRemoteFileWriteOutcomeRefused {
          reason: concat(
            "typed_remote_file_write: remote argv refused as non-portable for ",
            target.endpoint as String,
          ),
        },
      }
    Present { value: _ } => none
  }
}

fn typed_remote_file_write_outcome_after_ssh_exec(
  write: TypedRemoteFileWrite,
  result: SshSessionExecResult,
) -> TypedRemoteFileWriteOutcome {
  if result.success {
    TypedRemoteFileWriteConverged { result: result }
  } else {
    TypedRemoteFileWriteOutcomeRefused {
      reason: concat(
        "typed_remote_file_write: tee remote write failed for ",
        write.path as String,
      ),
    }
  }
}

fn typed_remote_file_write_over_fleet_ssh(
  target: SshTarget,
  context: FleetSshExecutionContext,
  admission: TypedRemoteFileWriteAdmitted,
) -> TypedRemoteFileWriteOutcome {
  let write = admission.write
  match portable_remote_words(raws: typed_remote_file_write_remote_argv(write: write)) {
    Absent =>
      TypedRemoteFileWriteOutcomeRefused {
        reason: concat(
          "typed_remote_file_write: remote argv refused as non-portable for ",
          target.endpoint as String,
        ),
      }
    Present { value: words } =>
      typed_remote_file_write_outcome_after_ssh_exec(
        write: write,
        result: ssh_session_exec_portable_words_with_stdin(
          client_args: shape_fleet_ssh_exec(context: context, target: target, words: words),
          stdin_payload: typed_remote_file_write_stdin_payload(write: write),
        ),
      )
  }
}
