module gunbc.list_membership_operation_gap

import std.types { Bool, Int, List, String }
import std.decl_ref {
  CitableThroughDeclIndex,
  CitationIndexCoverage,
  DeclarationRef,
  OutsideDeclIndexTestWitnessModule,
  citation_is_outside_index,
  decl_ref,
}

// HISTORICAL CALL-SHAPE MEASUREMENT, NOT AN ABSENT MEMBERSHIP OPERATION.
//
// The recorded sites supplied no equality capability and resolved to the host
// substring primitive. That does not establish that list membership is undeclared:
// v2.std.algebra.contains(xs, item, eq) already declares it, and std.types.List is
// FreeMonoid. The attempted std.list.list_cover cutover reached the seed builtin
// before module-function lookup; free_call.contains ignored the supplied equality.
// w_list_cover_consumes_caller_equality executed red at 84fbb95b968 in CI run
// 34742296746. This is a receipt for that route, not a prediction about a later head.
//
// DEFERRED CONSOLIDATION, AND ITS APPROVAL DOES NOT YET EXIST. std.list retains list_member
// using predicate any, and list_cover calls it with explicit equality. An earlier revision of
// this carrier said "the parent authorized restoring this working realization". That sentence
// was an IN-DIFF APPROVAL ROW, which DESIGN section 5 forbids in one sentence and gives the
// reason: approval is external to the diff because an author who can write a scaffold can
// equally write a row claiming it was approved. A parent lane inside the same work is not
// external; it can pick a technical route and it cannot grant this. (review 65388)
//
// THE DECISION IS OPEN WITH THE OPERATOR as escalation msg_6e8b272a-1600-4f0b-a26a-0c9438dcd5dc,
// which carries three options: narrow the v1 builtin contains arm from [xs, target, ..] to
// exactly [xs, target] so three-argument calls fall through to the declaration and this duplicate
// dissolves entirely; approve list_member as admitted debt under the retirement trigger below;
// or block this PR until the seed is repaired. THAT ESCALATION IS ALSO THE NAMED BINDING FOR THE
// SEED REPAIR - an earlier revision said only "the seed repair remains with its owning lane",
// which names nothing and cannot be checked. Until an option is chosen this row records admitted
// debt WITHOUT its admission, which is the honest state rather than a formality: nothing here
// should read as though the scaffold has been cleared to land.
//
// The unchanged caller-equality witness tests its contract; a green on this route does not prove
// algebra.contains executes. No claim is made that the duplicate authority is retired.
// RETIREMENT TRIGGER: the declared algebra.contains route honors supplied equality,
// demonstrated by the existing equality witness passing after cutover and failing
// when that declaration's body is mutated to false. Then delete list_member and
// restore the single-authority call. The seed repair is bound to the escalation named above.
//
// These rows retain the measured call shapes and citation obligations. They do not
// claim those sites have migrated, or resolve the held ruling about overloaded
// surface spelling or deriving omitted equality. Explicitly importing the existing
// three-argument operation does not supply the missing two-argument capability.

type ListMembershipGapSite {
  collection_producer: DeclarationRef
  index_coverage: CitationIndexCoverage
  element_type: String
  occurrences: Int
  argument_shape: MembershipArgumentShape
}

// The shape actually written at the call site. PositionalPair is the plain two-argument form.
// NamedItemWithoutEquality is one site that spells the three-argument declaration's `item:`
// parameter name while supplying no `eq:` — reaching for the modeled operation and landing short
// of it, which is evidence the gap is felt by authors rather than merely inferred by this census.
type MembershipArgumentShape
  = PositionalPair
  | NamedItemWithoutEquality

// HOW THE POPULATION WAS FOUND, AND THE FLAW IN THE FIRST ATTEMPT AT FINDING IT.
//
// The first classification split two-argument call sites by whether the SECOND argument was a
// string literal, treating a literal as evidence of a substring test. That instrument is unsound
// and undercounted this class by four: `contains(ids, "occ-coord")` is list membership whose item
// happens to be a string literal. Classification by the syntax of the argument cannot decide the
// operation; only the FIRST argument's type can, because that is what distinguishes a collection
// from a string. The corrected method resolves each first argument to its binding and reads the
// declared element type, which is what the rows below record.
//
// THE TOTALS ARE DERIVABLE AND ARE DELIBERATELY NOT STORED. Ten occurrences is the sum of the
// `occurrences` fields; five producers is the row count. An earlier revision carried both as
// scalar `data` rows so a later census could "check itself against either grain" — that
// justification was wrong. A total transcribed from the same rows it summarises is not an
// independent oracle; checking one against the other is `measure() == measure()`, the change
// detector DESIGN section 5 rules out, and it adds a second authority that drifts silently the
// first time a row is edited without it. If a consumer needs a count, it folds the rows.
//
// Rows are keyed on the declaration that PRODUCES the collection, because that is the grain at
// which the missing operation is supplied: one declaration serves every occurrence over its
// result. Where the collection is a function parameter rather than a declaration, the row names
// the enclosing function — the parameter has no declaration of its own to cite.
data list_membership_gap_sites: List<ListMembershipGapSite> = [
  {
    collection_producer: decl_ref(module_path: "gunbc.publication_policy", decl_name: "known_publication_roots"),
    index_coverage: CitableThroughDeclIndex,
    element_type: "String",
    occurrences: 1,
    argument_shape: PositionalPair,
  },
  {
    collection_producer: decl_ref(module_path: "extdeps.unicode.blocks", decl_name: "zero_width_codepoints"),
    index_coverage: CitableThroughDeclIndex,
    element_type: "Int",
    occurrences: 1,
    argument_shape: NamedItemWithoutEquality,
  },
  {
    collection_producer: decl_ref(module_path: "test.claim.attribution_span_witness", decl_name: "unattributed_widths"),
    index_coverage: OutsideDeclIndexTestWitnessModule,
    element_type: "Nat",
    occurrences: 3,
    argument_shape: PositionalPair,
  },
  {
    collection_producer: decl_ref(module_path: "test.claim.recorded_observation_envelope_witness", decl_name: "active_ids"),
    index_coverage: OutsideDeclIndexTestWitnessModule,
    element_type: "String",
    occurrences: 4,
    argument_shape: PositionalPair,
  },
]

// TWO OF THESE FIVE MODULE PATHS WERE FALSE WHEN THIS CARRIER MERGED, and the enrollment below
// caught them on its first execution. Both named the FILE
// (`test.claim.attribution_span_witness_test`) where the module declares itself without the `_test`
// suffix (`test.claim.attribution_span_witness`). A grep for the declaration name passed, because
// the declaration name was right; nothing checked the module path it was attributed to. Four
// reviews passed over the false rows, one of which verified the citations by hand.
//
// That is the whole argument for enrollment in one specimen: hand-verification and name-level grep
// both certify a citation whose ADDRESS is wrong, and only resolution asks the question they skip.

// ENROLLMENT PROJECTION — the `collection_producer` refs, exposed so a resolver can reach
// them. It was `v2.lens.cited_symbol_resolution` until that lens was deleted 2026-08-26;
// `v1_compiler.declaration_index` now resolves them corpus-wide at ingestion and
// `test.claim.long.carrier_reference_integrity_witness_test` holds the population claims. Enrolled in the same change as the sibling
// instance carrier `gunbc.lambda_argument_typing_gate`, and not after it: two carriers of one shape
// where only one is enrolled is the exact asymmetry that lens's own widening note was written
// against — one class of reference enforced and an adjacent one silently exempt.
data list_membership_gap_empty_declaration_refs: List<DeclarationRef> = []

fn list_membership_gap_declaration_refs_from(
  sites: List<ListMembershipGapSite>
) -> List<DeclarationRef> {
  fold_list(
    xs: sites,
    empty: list_membership_gap_empty_declaration_refs,
    cons: fn(acc, s) { concat(acc, [s.collection_producer]) }
  )
}

fn list_membership_gap_citable_sites() -> List<ListMembershipGapSite> {
  filter(list_membership_gap_sites, s => citation_is_outside_index(coverage: s.index_coverage) == false)
}

fn list_membership_gap_outside_index_sites() -> List<ListMembershipGapSite> {
  filter(list_membership_gap_sites, s => citation_is_outside_index(coverage: s.index_coverage))
}

fn list_membership_gap_declaration_refs() -> List<DeclarationRef> {
  list_membership_gap_declaration_refs_from(sites: list_membership_gap_citable_sites())
}

fn list_membership_gap_outside_index_refs() -> List<DeclarationRef> {
  list_membership_gap_declaration_refs_from(sites: list_membership_gap_outside_index_sites())
}

fn list_membership_gap_outside_index_count() -> Int {
  length(xs: list_membership_gap_outside_index_sites())
}
