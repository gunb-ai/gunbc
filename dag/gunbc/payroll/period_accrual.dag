module gunbc.payroll.period_accrual

import std.types { Bool, Int, NonEmptyStr, List }
import std.nat { Nat }
import std.measure { MoneyAmountMicro, money_amount_micro, money_amount_micro_count }
import extdeps.payroll.contribution {
  ContributionSpec, AssessedPosition, ContributionOutcome, ContributionRefusal,
  ContributionOriginated, ContributionRefused,
  BearingParty, Employer, Worker,
  contribution_for_period,
}

// One pay period, ACCRUED against whichever cited contribution rows apply to it.
// extdeps.payroll.contribution owns what a contribution is and each tax authority owns its own
// rates; the decision to run a period against a particular set of rows is a business fact and
// lives here.
//
// THIS MODULE PRODUCES ACCRUALS AND DOES NOT SETTLE MONEY, AND THAT IS A CORRECTION RATHER THAN A
// CAUTIOUS NAME. An earlier revision derived a gross, a residual and an employer cost, subtracting
// a micro-floored figure from gross and naming the difference carefully. A review named the defect
// exactly: naming a residual carefully does not make a floored micro accrual into money withheld.
// Publication 15 rounds to the nearest cent per wage payment with a fractions-of-cents adjustment
// on the quarterly return, so the statutory amount is not derivable until a rounding contract -
// mode, grain and application scope - is resolved.
//
// So the residual fields are GONE rather than renamed. What remains is what the rows actually
// support: an exact worker-borne accrual, an exact employer-borne accrual, and the lines that
// produced them. A settled amount becomes derivable when the authority carries its rounding
// contract; the accrual stays the exact intermediate it already is.
//
// The second reason they are gone is cardinality. Federal Social Security wages and Medicare wages
// are different bases, so one period is SEVERAL positions and there is no single gross to subtract
// from. Accrual totals compose across bases; a paycheck does not.

type PeriodAccrual {
  worker_borne: MoneyAmountMicro
  employer_borne: MoneyAmountMicro
  lines: List<ContributionOutcome>
}

// A spec is matched to the position computed under ITS OWN base. A spec with no such position
// refuses by name rather than borrowing whichever position happened to be passed - which is what a
// single-position fold did implicitly, and is the fail-open that let a Medicare-based position
// answer for a Social Security row.
type AccrualRefusal =
  | ContributionCause { cause: ContributionRefusal }
  | PositionUnavailableForBase { spec: NonEmptyStr, required_base: NonEmptyStr }

// The accrual derives whole or refuses whole, carrying EVERY cause rather than the first. There is
// no partially-accrued arm: a run that dropped one refused contribution and kept the rest would
// report a total against a position the model just said it could not compute, and would look
// exactly like a successful run doing it.
type PeriodAccrualOutcome =
  | AccrualDerived { accrual: PeriodAccrual }
  | AccrualRefusedWhole { causes: List<AccrualRefusal> }

type AccrualAccumulator {
  worker_micros: Nat
  employer_micros: Nat
  refusals: List<AccrualRefusal>
  lines: List<ContributionOutcome>
}

fn positions_for_base(positions: List<AssessedPosition>, base: NonEmptyStr) -> List<AssessedPosition> {
  filter(positions, p => p.contribution_base == base)
}

fn accumulate_borne(
  acc: AccrualAccumulator,
  borne_by: BearingParty,
  amount: MoneyAmountMicro,
) -> AccrualAccumulator {
  match borne_by {
    Worker => AccrualAccumulator {
      worker_micros: acc.worker_micros + money_amount_micro_count(m: amount),
      employer_micros: acc.employer_micros,
      refusals: acc.refusals,
      lines: acc.lines,
    }
    Employer => AccrualAccumulator {
      worker_micros: acc.worker_micros,
      employer_micros: acc.employer_micros + money_amount_micro_count(m: amount),
      refusals: acc.refusals,
      lines: acc.lines,
    }
  }
}

fn with_line(acc: AccrualAccumulator, outcome: ContributionOutcome) -> AccrualAccumulator {
  AccrualAccumulator {
    worker_micros: acc.worker_micros,
    employer_micros: acc.employer_micros,
    refusals: acc.refusals,
    lines: concat(acc.lines, [outcome]),
  }
}

fn accumulate_outcome(acc: AccrualAccumulator, outcome: ContributionOutcome) -> AccrualAccumulator {
  match outcome {
    ContributionOriginated { spec, borne_by, subject_wages, amount } =>
      accumulate_borne(acc: with_line(acc: acc, outcome: outcome), borne_by: borne_by, amount: amount)
    ContributionRefused { cause } => AccrualAccumulator {
      worker_micros: acc.worker_micros,
      employer_micros: acc.employer_micros,
      refusals: concat(acc.refusals, [ContributionCause { cause: cause }]),
      lines: concat(acc.lines, [outcome]),
    }
  }
}

fn accumulate_spec(
  acc: AccrualAccumulator,
  spec: ContributionSpec,
  positions: List<AssessedPosition>,
) -> AccrualAccumulator {
  match positions_for_base(positions: positions, base: spec.contribution_base).first() {
    Absent => AccrualAccumulator {
      worker_micros: acc.worker_micros,
      employer_micros: acc.employer_micros,
      refusals: concat(acc.refusals, [
        PositionUnavailableForBase { spec: spec.name, required_base: spec.contribution_base }
      ]),
      lines: acc.lines,
    }
    Present { value: p } =>
      accumulate_outcome(acc: acc, outcome: contribution_for_period(spec: spec, position: p))
  }
}

fn accrue_period(
  specs: List<ContributionSpec>,
  positions: List<AssessedPosition>,
) -> PeriodAccrualOutcome {
  let acc = fold(
    specs,
    init: AccrualAccumulator { worker_micros: 0, employer_micros: 0, refusals: [], lines: [] },
    f: (a, s) => accumulate_spec(acc: a, spec: s, positions: positions)
  )
  return if count(acc.refusals) > 0 {
    AccrualRefusedWhole { causes: acc.refusals }
  } else {
    AccrualDerived {
      accrual: PeriodAccrual {
        worker_borne: money_amount_micro(count: acc.worker_micros),
        employer_borne: money_amount_micro(count: acc.employer_micros),
        lines: acc.lines,
      }
    }
  }
}
