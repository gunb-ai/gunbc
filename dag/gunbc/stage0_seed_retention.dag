data seed_retention_exclusions: List<SeedRetentionExclusion> = [
  SeedRetentionExclusion {
    basename: "v1_compiler_ownership",
    disposition: "Superseded",
    reason: "Emitted twin of the per-binding grain, which the ownership-grain cut removes; per-site verdicts take its boundary and its consumers are rederived rather than reconnected, so the frozen carve-out's no-replacement precondition is not met. Operator ruling 2026-08-16. Deleted on integration/ownership-grain-cut."
  },
  SeedRetentionExclusion {
    basename: "v1_compiler_compiler_tests_rust",
    disposition: "Undecided",
    reason: "Deleted on integration/interpreter-cut and retained by this cut, with no stated disposition either way. Blocks rather than retains: the deciding fact is whether a named replacement takes its boundary, which belongs to the lane removing it. Guessing would fabricate a disposition."
  }
]

fn seed_retained_basenames() -> List<String> {
  concat(
    seed_retained_authority_deleted |> map(r => r.basename as String),
    seed_retained_authority_live |> map(r => r.basename as String)
  )
}

fn seed_retention_excluded_basenames() -> List<String> {
  seed_retention_exclusions |> map(r => r.basename as String)
}

fn seed_retention_classified_basenames() -> List<String> {
  concat(seed_retained_basenames(), seed_retention_excluded_basenames())
}

fn seed_retention_arms_disjoint() -> Bool {
  seed_retained_authority_deleted
    |> all(d => !(seed_retained_authority_live |> any(l => l.basename == d.basename)))
    && seed_retention_exclusions
         |> all(e => !(seed_retained_basenames() |> any(b => b == (e.basename as String))))
}

fn seed_retention_undecided_blocks() -> Bool {
  seed_retention_exclusions
    |> all(e => (e.disposition as String) == "Superseded" || (e.disposition as String) == "Undecided")
}

data stage0_seed_retention_rung_drop_note: String = "WHY A RUNG DROP IS A SEPARATE ARM AND NOT A FIELD ON EVERY ROW (operator question, 2026-08-16). Freezing an artifact and LOWERING A GUARANTEE are different facts about it. Most retained rows lost no fixable-at-authority defect, so a regression field on all 134 would be empty in nearly every one, and an empty required field invites an author to fill it with something plausible - the fabricated-plausible-output failure aimed at a safety ledger. Worse, it would conflate frozen with regressed, when the authority note above is explicit that membership asserts retention AND NOTHING ELSE. So a rung drop is its own list keyed by basename, joined to the retention roster, leaving the retention row neutral.

DESIGN section 4b (3) permits lowering a rung only by declaring previous rung, temporary rung, reason, bounded population and restoration trigger. The rows below are that declaration.

THIS IS THE INTERIM HOME, NOT THE TERMINAL ONE, and the row must not read as fully modeled. No section 4b rung-drop carrier exists anywhere in the tree; that absence is an open escalation to the operator. Until one lands, these fields are prose in a typed row rather than a modeled guarantee ledger, and a reader should treat them as a debt marker for the real carrier. DISSOLVE-ON: the rung-drop carrier landing, at which point these rows migrate to it and this arm deletes."

type SeedRetentionRungDrop {
  basename: NonEmptyStr
  previous_rung: NonEmptyStr
  temporary_rung: NonEmptyStr
  reason: NonEmptyStr
  bounded_population: NonEmptyStr
  magnitude: NonEmptyStr
  restoration_trigger: NonEmptyStr
}

data seed_retention_rung_drops: List<SeedRetentionRungDrop> = [
  SeedRetentionRungDrop {
    basename: "v1_compiler_emit_rust",
    previous_rung: "MechanicallyPreventable",
    temporary_rung: "Mitigatable",
    reason: "The clone-at-accumulator default. The emitter clones a value at its use site rather than moving it at its last use, so every fold threading a persistent container calls Rc::make_mut with another strong Rc live, taking the clone arm on EVERY element and copying the whole container per iteration. It was fixable at src/v1/05_emit_rust.dag, where the clone-versus-move decision is made; that authority is deleted by this cut and the artifact is frozen, so no file an author could edit reaches the built compiler. The per-binding ownership authority that fed the decision was deleted as the root of a grain error - clone-versus-move is a use-site property - and its replacement landed in std, where value_materialization folds over per-site UseSiteVerdicts; but the emitter that would CONSUME those verdicts is frozen, so the correction cannot reach the binary. Measurements authored by fierce-raven-463, which vouches for the numbers.",
    bounded_population: "42 clone-at-accumulator sites in v1_compiler_emit_rust.rs; 1 more in v1_compiler_compile.rs; 359 across all 28 emitted files. Counted at faa1539954 by matching rc_map_insert / rc_map_merge / rc_set_insert / rc_list_push / rc_list_concat applied to an identifier's .clone() - the shape where the accumulator is cloned at the call site. NOT A BURN-DOWN: per the operator verdict of 2026-07-29 on dag/tools/e0599_emitter_decision_census.dag, the count records where the emitter INSERTED a clone and never that any site is removable.",
    magnitude: "638x at m=4000, and the scope of that number is load-bearing: it measures the MECHANISM IN ISOLATION, not this emitter's runtime. A local benchmark replicating the emitted shape - an Rc map threaded through a fold, rc_map_insert(acc.clone(), ..) versus moving acc - measured clone slope 2.0 against move slope 1.0: m=1000 clone 28.5ms / move 186us; m=2000 clone 117ms / move 376us; m=4000 clone 498ms / move 780us. WHAT SHARE OF ANY REAL PHASE THIS ACCOUNTS FOR IS UNMEASURED. A phase-grain scaling sweep was run and came back inconclusive BY CONSTRUCTION, an 18.3s size-independent term swamping the grid. This row must not be read as a measured runtime cost.",
    restoration_trigger: "v2 self-hosts the emit stage, at which point the decision is authored in v2, consumes the per-site verdicts directly, and this row dissolves with the artifact. Self-emission is measured by v2.compiler.self_host.frontier and is deliberately not restated here."
  }
]

fn seed_retention_rung_drop_basenames() -> List<String> {
  seed_retention_rung_drops |> map(r => r.basename as String)
}

fn seed_retention_rung_drops_are_retained() -> Bool {
  seed_retention_rung_drop_basenames()
    |> all(b => seed_retained_basenames() |> any(r => r == b))
}
