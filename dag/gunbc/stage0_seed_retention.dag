data seed_retention_exclusions: List<SeedRetentionExclusion> = [
  SeedRetentionExclusion {
    basename: "v1_compiler_ownership",
    disposition: "Superseded",
    reason: "Emitted twin of the per-binding grain, which the ownership-grain cut removes; per-site verdicts take its boundary and its consumers are rederived rather than reconnected, so the frozen carve-out's no-replacement precondition is not met. Operator ruling 2026-08-16. Deleted on integration/ownership-grain-cut."
  },
  SeedRetentionExclusion {
    basename: "v1_compiler_compiler_tests_rust",
    disposition: "DeletedWithObligationsOpen",
    reason: "Deletion population, and NEITHER frozen NOR superseded - answered by gentle-dove-833, the lane removing it. It is a GENERATOR of Rust test source text (ct_tokenizer_tests, ct_parse_tests, ct_pipeline_test, ct_self_parse_all_test, ct_self_resolve_test, ct_self_compile_test), and the text it emits contains calls to crate::v1_interpreter::run. So retaining it would freeze a producer whose OUTPUT CANNOT COMPILE once the interpreter goes - a declared authority standing in front of something provably unbuildable, which is the exact failure a blocking row exists to prevent. But nothing takes its boundary either: no named replacement exists, and the one similarly named file on that branch is a compile gate that checks targets build rather than carrying the tokenizer, parse, pipeline or self-compile behaviours. ONE SUBJECT WITH compiler_tests.rs - 34 of its 41 emitted titles matched titles in the hand-written file, which was largely its own output copied down - so excluding one while retaining the other would split a subject across this roster's boundary. The behaviour is still owed and is banked as 49 obligations at title grain in gunbc.plans.interpreter_cut_replacement, proposed 26 re-establish / 23 retire, none built."
  }
]

fn seed_retained_basenames() -> List<String> {
  concat(
    seed_retained_authority_deleted |> map(r => r.basename as String),
    seed_retained_authority_live |> map(r => r.basename as String)
  )
}

fn seed_retention_excluded_basenames() -> List<String> {
  seed_retention_exclusions |> map(r => r.basename as String)
}

fn seed_retention_classified_basenames() -> List<String> {
  concat(seed_retained_basenames(), seed_retention_excluded_basenames())
}

fn seed_retention_arms_disjoint() -> Bool {
  seed_retained_authority_deleted
    |> all(d => !(seed_retained_authority_live |> any(l => l.basename == d.basename)))
    && seed_retention_exclusions
         |> all(e => !(seed_retained_basenames() |> any(b => b == (e.basename as String))))
}

fn seed_retention_dispositions_are_closed() -> Bool {
  seed_retention_exclusions
    |> all(e => (e.disposition as String) == "Superseded"
             || (e.disposition as String) == "DeletedWithObligationsOpen"
             || (e.disposition as String) == "Undecided")
}

data stage0_seed_retention_frozen_property_note: String = "WHY THERE IS NO RUNG-DROP ARM HERE, DERIVED FROM A MEASUREMENT RATHER THAN FROM A READING. This roster briefly carried one, on the premise that freezing an artifact whose authority was deleted must lower a DESIGN section 4b guarantee. Its single occupant was reclassified twice and then dissolved the premise: no correctness refusal was shown to become an accepted false value, and slower-but-correct is not on the ladder at all. Rather than delete the arm on anyone's say-so - the author's or the coordinator's, both of which had already produced a wrong classification for that row - the population was asked directly.

THE CENSUS, and the discriminator that settled it. All 60 AuthorityDeleted rows resolve to their deleted .dag authority at merge-base 8a799b61c4d, and 9 of them carried guarantee-shaped machinery with corpus reach. But the question a proxy grep cannot answer is whether freezing LOWERED anything, so it was answered by execution: a sole_constructor violation was authored in a NEW file that did not exist when the authority was deleted, and the frozen checker REFUSED it - typed and located - exactly as it would have before. The wall still fires, over corpus that postdates its own authority, because the frozen realization is data-driven over the parsed tree rather than over a roster fixed at emit time.

SO NOTHING DESCENDED. Existing error classes hold at their previous rung; a frozen wall still walls. What the cut removed is the ability to ADD or STRENGTHEN a wall, which is a CEILING ON FUTURE CLIMBING and not a descent - section 4b's own distinction between cannot-climb-further and lowered-in-place. An arm with no occupant would be an inert carrier implying a safety claim nobody made, so it is deleted rather than kept warm, and its content moved below where it belongs.

WHAT REPLACES IT is deliberately weaker vocabulary: a FROZEN PROPERTY records something true about a retained artifact that the freeze makes unfixable, with no implication that any guarantee moved. NEXT TRIGGER, so the absence is not read as permanent: if a later change freezes an artifact whose wall is NOT data-driven - one whose enforcement scope was fixed when it was emitted - that IS a lowered guarantee and this roster needs the arm back."

type SeedRetentionFrozenProperty {
  basename: NonEmptyStr
  what_freezes: NonEmptyStr
  verified: NonEmptyStr
  measured: NonEmptyStr
  not_established: NonEmptyStr
  dissolves_on: NonEmptyStr
}

data seed_retention_frozen_properties: List<SeedRetentionFrozenProperty> = [
  SeedRetentionFrozenProperty {
    basename: "v1_compiler_emit_rust",
    what_freezes: "The clone-at-accumulator default. The emitter emits .clone() where the .dag authors a plain accumulator, so a fold threading a persistent container calls Rc::make_mut with another strong Rc live and takes the copying arm each iteration. It was reachable at src/v1/05_emit_rust.dag, where the clone-versus-move decision is made; that authority is deleted and the artifact is frozen, so no file an author could edit reaches the built compiler. NOT A DEFECT ON CURRENT EVIDENCE: the emitter clones DEFENSIVELY because it lacks an ownership proof, and a defensive clone is slower and CORRECT. DESIGN section 5's subject is silent wrongness, and no correctness refusal here becomes an accepted false value, so filing this under section 5 would borrow a severity the evidence does not carry. This is QUARRY for v2's ownership-aware emitter, not an open obligation against the seed.",
    verified: "The emitter emits .clone() at those sites: 42 in v1_compiler_emit_rust.rs, 1 in v1_compiler_compile.rs, 359 across all 28 emitted files, counted at faa1539954 by matching rc_map_insert / rc_map_merge / rc_set_insert / rc_list_push / rc_list_concat applied to an identifier's .clone(). This is a SYNTACTIC denominator, NOT a roster of hot call sites, and per the operator verdict of 2026-07-29 on dag/tools/e0599_emitter_decision_census.dag it records where the emitter INSERTED a clone, never that any site is removable.",
    measured: "~9x CONSTANT FACTOR on an isolated im::HashMap fold, flat across a 16x span of n, fixed term 0.007ms. Not a complexity class. The mechanism is separately witnessed: strong_count=2 and allocation_moved=true on the clone arm, 1 and false on the moved arm. WITHDRAWN, with the reasoning kept because it generalizes: an earlier 638x and a quadratic characterization were measured against std::collections::HashMap while the subject uses im::HashMap, a HAMT with O(1) clone - verified against this subject, which imports im::HashMap and contains ZERO occurrences of the std one, against a corpus where 143 emitted files import im::HashMap and exactly two import std's. Two INDEPENDENT benchmarks agreed at 638x and 816.9x and that agreement read as corroboration; it was not. AGREEMENT ACROSS INSTRUMENTS THAT SHARE AN ASSUMPTION MEASURES THE ASSUMPTION - both had copied the same wrong use line. Three instances of that confusion surfaced in one night, which places the trap in the code's shape: copying a function carries its body and not its imports, and the imports are the universe.",
    not_established: "That removing the clone is sound per site; that this is a fault rather than a semantics-preserving realization of persistent values; that it recovers any share of any real phase. Removal is not free to prove - a blanket emitter change must establish, PER GENERATED SITE, that the argument is at its terminal use, that moving preserves value semantics, that no sibling branch needs the same binding, that closure capture does not require retention, that the type really is an owned persistent map, and that the callee's ownership contract accepts a move. That is precisely the ownership proof the emitter does not have, which is WHY it clones.",
    dissolves_on: "v2 self-hosts the emit stage, at which point the decision is authored in v2, consumes the per-site verdicts directly, and this property dissolves with the artifact. Self-emission is measured by v2.compiler.self_host.frontier and is deliberately not restated here."
  }
]

fn seed_retention_frozen_property_basenames() -> List<String> {
  seed_retention_frozen_properties |> map(r => r.basename as String)
}

fn seed_retention_frozen_properties_are_retained() -> Bool {
  seed_retention_frozen_property_basenames()
    |> all(b => seed_retained_basenames() |> any(r => r == b))
}
