module gunbc.fleet_posix_accounts

import extdeps.access.posix { PosixUser }
import extdeps.sudo.nopasswd_execute_probe {
  SudoNopasswdProbeKind,
  NopasswdExecuteCheck,
  NopasswdGrantListCheck,
}
import std.types { NonEmptyStr, List, String, Bool }
import std.disposition { Disposition, Terminal, Scaffold, ConstructionMechanism }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.effects { ExecuteEffect }
import std.effect_grant {
  Grant, RealTransport, LifecycleByConstruction,
  filesystem_position, grant_verb, verb_eq, verb_of_effect_shape,
}

data fleet_posix_accounts_scope_disposition: Disposition = Terminal {
  reason: "Single authority for fleet POSIX principals on srv1/srv2/srv3: closed roster construction only (no arbitrary-string principal). §3: PosixUser is extdeps/access; fleet rows live in gunbc/. declared_probe is authored provenance of the intended id(1) check — NOT live observation; live existence proof is deploy_access_check_observed. Grant alignment seam (#6146): GroundedPosixPrincipal is POSIX WHO; secret_access_grant.GrantPrincipal is GCP WIF WHO; operator links via FleetAccountOperator + fleet_operator_gcp_iam_member(). DeployRunnerPrincipal grounds the unit_user vs job_user split for CI runners."
}

type PosixAccountDeclaredProbe {
  probed_at: NonEmptyStr
  probe_command: NonEmptyStr
  host: NonEmptyStr
}

type PosixSudoGrant {
  command_path: NonEmptyStr
  probe: SudoNopasswdProbeKind
}

data posix_sudo_grant_materialization_note: String = "PosixSudoGrant is the fleet-domain MATERIALIZATION carrier for std.effect_grant.Grant over ExecuteEffect: posix_sudo_grant_to_effect_grant projects command_path to filesystem_position and carries verb via verb_of_effect_shape(ExecuteEffect) -- never a parallel grant vocabulary (DESIGN 3). probe chooses the typed verification operation (execute-check, or grant-list when the binary may be absent); it is observation policy, not grant reach. WHO may sudo remains GroundedPosixPrincipal / std.access. dissolve-on = deploy-preflight envelope admits via admit_effect over projected grants."

fn absolute_command_path_segments(path: NonEmptyStr) -> List<String> {
  filter(xs: split(s: path as String, delimiter: "/"), f: s => s != "")
}

fn posix_sudo_grant_to_effect_grant(g: PosixSudoGrant) -> Grant {
  Grant {
    verb: verb_of_effect_shape(shape: ExecuteEffect),
    root: filesystem_position(path: absolute_command_path_segments(path: g.command_path)),
    binding: RealTransport,
    lifecycle: LifecycleByConstruction,
  }
}

type GroundedPosixPrincipal {
  posix: PosixUser
  sudo_grants: List<PosixSudoGrant>
  declared_probe: PosixAccountDeclaredProbe
}

type DeployRunnerPrincipal {
  unit_user: NonEmptyStr
  job_user: NonEmptyStr
}

data deploy_runner_principal_note: String = "Two-phase runner principal (#6096 declared-vs-effective): unit_user is the systemd User= on the actions-runner unit (root on srv1); job_user is the deprivileged effective principal for workflow steps (ghrunner on srv1). Deploy authorization and sudoers roster ground on job_user only — never unit_user."

data srv1_ci_deploy_runner_principal: DeployRunnerPrincipal = DeployRunnerPrincipal {
  unit_user: "root",
  job_user: "ghrunner",
}

type FleetPosixAccountKey
  = FleetAccountRoot
  | FleetAccountOperator
  | FleetAccountCiRunner
  | FleetAccountSrv3Host
  | FleetAccountAutomation
  | FleetAccountInferenceService

data fleet_posix_root_user: PosixUser = PosixUser {
  name: "root",
  uid: 0,
  gid: 0,
}

data fleet_posix_operator_user: PosixUser = PosixUser {
  name: "briansrls",
  uid: 1000,
  gid: 1000,
}

data fleet_posix_ci_runner_user: PosixUser = PosixUser {
  name: "ghrunner",
  uid: 1001,
  gid: 1001,
}

data fleet_posix_srv3_host_user: PosixUser = PosixUser {
  name: "ubuntu",
  uid: 1000,
  gid: 1000,
}

// THE AUTOMATION AND SERVICE PRINCIPALS, and the split their arrival forces.
//
// fleet-automation@gunbc is an SSH KEY COMMENT, not a POSIX username. The tree had no automation
// account at all, so every modeled host access resolved FleetAccountOperator -- the HUMAN -- and
// automation reached hosts as a person. These two rows separate three concepts that were one:
// who a human is, what automation acts as, and what the served process runs as.
//
// WHAT IS DIFFERENT ABOUT THESE TWO ROWS, stated because the carrier cannot yet say it. Every
// other PosixUser here is OBSERVED: it exists on a host and PosixAccountDeclaredProbe records the
// command that confirmed it. These two are DESIRED and do not exist anywhere yet. Their probes
// therefore record the observation that was actually run -- a NAME AND UID AVAILABILITY check on
// both Sparks -- and not an existence check that would be a fabrication.
//
// That is the same authored-versus-executed conflation gunbc#8068 found in the host-phase
// observation frontier, reappearing one carrier over: a roster whose rows mean "observed to exist"
// cannot also carry rows meaning "intended to exist" without a reader being unable to tell which
// it holds. The split is NOT introduced here, deliberately -- inventing a desired/observed axis
// under a Terminal-disposition authority while a host apply is in flight would be modeling ahead
// of the consumer. Dissolve-on: the SPARK-SERVE-0 apply creates both accounts, at which point
// these probes are replaced by real existence observations and the distinction disappears for
// these rows; if a later desired account outlives its apply, the axis is owed at that point.
data fleet_posix_desired_not_observed_note: String = "The automation and inference-service rows are DESIRED, not observed. Every other PosixUser in this module exists on a host and its declared probe confirmed it; these two exist nowhere and their probes record a name/uid AVAILABILITY observation instead. Recorded rather than smoothed over because a roster that silently mixes 'is' with 'ought' cannot be read correctly by anything downstream, which is precisely the defect class gunbc#8068 corrected in the observation frontier. Dissolves when the apply creates the accounts and the probes become existence observations."

// UID/GID 1500 and 1501 are pinned IDENTICALLY on both Sparks, which is only sound because it was
// observed rather than assumed: on 2026-08-09 both hosts carried exactly one uid>=1000 account
// (briansrls uid=1000 gid=1000), and the names gunbc / gunbc-inference and uids 1500 / 1501 were
// free on BOTH. A collision on either host must refuse before mutation rather than silently
// selecting the next free id, because an account whose uid differs per host is not one identity.
data fleet_posix_automation_user: PosixUser = PosixUser {
  name: "gunbc",
  uid: 1500,
  gid: 1500,
}

// The served process. It holds NO ssh key, NO password login and NO sudo grant -- it owns model,
// cache and runtime files and nothing else. Serving needs no ability to reach or change the host,
// and granting it one because the deployment account happens to have it is how a service principal
// silently becomes an administrative one.
data fleet_posix_inference_service_user: PosixUser = PosixUser {
  name: "gunbc-inference",
  uid: 1501,
  gid: 1501,
}

data fleet_posix_automation_declared_probe: PosixAccountDeclaredProbe = PosixAccountDeclaredProbe {
  probed_at: "2026-08-09",
  probe_command: "getent passwd gunbc; getent passwd 1500",
  host: "spark-a3ee,spark-3bd5",
}

data fleet_posix_inference_service_declared_probe: PosixAccountDeclaredProbe = PosixAccountDeclaredProbe {
  probed_at: "2026-08-09",
  probe_command: "getent passwd gunbc-inference; getent passwd 1501",
  host: "spark-a3ee,spark-3bd5",
}

data fleet_posix_root_declared_probe: PosixAccountDeclaredProbe = PosixAccountDeclaredProbe {
  probed_at: "2026-07-02",
  probe_command: "id root",
  host: "srv1",
}

data fleet_posix_operator_declared_probe: PosixAccountDeclaredProbe = PosixAccountDeclaredProbe {
  probed_at: "2026-07-02",
  probe_command: "id briansrls",
  host: "srv1",
}

data fleet_posix_ci_runner_declared_probe: PosixAccountDeclaredProbe = PosixAccountDeclaredProbe {
  probed_at: "2026-07-02",
  probe_command: "id ghrunner",
  host: "srv1",
}

data fleet_posix_srv3_host_declared_probe: PosixAccountDeclaredProbe = PosixAccountDeclaredProbe {
  probed_at: "2026-07-21",
  probe_command: "id ubuntu",
  host: "srv3",
}

data fleet_hostnamectl_command_path: NonEmptyStr = "/usr/bin/hostnamectl"

data fleet_operator_email: NonEmptyStr = "briansrls@gmail.com"

fn fleet_operator_gcp_iam_member() -> String {
  concat("user:", fleet_operator_email as String)
}

fn fleet_posix_root_sudo_grants() -> List<PosixSudoGrant> {
  []
}

fn fleet_posix_operator_sudo_grants() -> List<PosixSudoGrant> {
  [
    PosixSudoGrant {
      command_path: fleet_hostnamectl_command_path,
      probe: NopasswdExecuteCheck { check_argv: "--version" },
    },
  ]
}

data fleet_apt_get_binary_path: NonEmptyStr = "/usr/bin/apt-get"

data fleet_visudo_binary_path: NonEmptyStr = "/usr/sbin/visudo"

data gunbc_deploy_privileged_helper_path: NonEmptyStr = "/opt/gunbc/bin/gunbc-deploy-privileged"

data gunbc_deploy_privileged_helper_check_argv: NonEmptyStr = "probe"

fn fleet_posix_ci_runner_sudo_grants() -> List<PosixSudoGrant> {
  [
    PosixSudoGrant { command_path: fleet_apt_get_binary_path, probe: NopasswdExecuteCheck { check_argv: "--help" } },
    PosixSudoGrant { command_path: "/usr/bin/install", probe: NopasswdExecuteCheck { check_argv: "--version" } },
    PosixSudoGrant { command_path: fleet_visudo_binary_path, probe: NopasswdExecuteCheck { check_argv: "-V" } },
    PosixSudoGrant { command_path: "/usr/bin/systemctl", probe: NopasswdExecuteCheck { check_argv: "--version" } },
    PosixSudoGrant { command_path: "/usr/bin/tailscale", probe: NopasswdGrantListCheck },
    PosixSudoGrant { command_path: "/usr/bin/rm", probe: NopasswdExecuteCheck { check_argv: "--version" } },
  ]
}

fn fleet_posix_srv3_host_sudo_grants() -> List<PosixSudoGrant> {
  []
}

// ONE closed privileged operation, not blanket sudo and not docker-group membership. The Docker
// control socket is a root-equivalent grant: anything that can talk to it can start a privileged
// container and own the host, so adding the automation account to the docker group because the
// socket currently refuses it would hand over far more than deployment needs. The grant is instead
// a single root-owned helper whose closed operation set covers exactly this vertical's effects.
//
// The probe is NopasswdGrantListCheck rather than an execute-check DELIBERATELY, and the module's
// own materialization note names the reason: grant-list is the typed verification for a binary
// that MAY BE ABSENT. The helper does not exist on either Spark yet -- the apply installs it -- so
// an execute-check would refuse for the honest reason that the file is missing, and would be
// indistinguishable from the grant itself being absent. Two different states, two different
// remedies. When the helper is installed the probe tightens to an execute-check.
data fleet_gunbc_deploy_privileged_path: NonEmptyStr = "/opt/gunbc/bin/gunbc-deploy-privileged"

fn fleet_posix_automation_sudo_grants() -> List<PosixSudoGrant> {
  [
    PosixSudoGrant {
      command_path: fleet_gunbc_deploy_privileged_path,
      probe: NopasswdGrantListCheck,
    },
  ]
}

// EMPTY BY CONSTRUCTION, and the empty list is the assertion. The served process runs a model and
// answers requests; it has no reason to change the host it runs on. A serving principal that
// accumulates a grant "just for the install step" is how the blast radius of a compromised model
// server becomes the whole machine.
fn fleet_posix_inference_service_sudo_grants() -> List<PosixSudoGrant> {
  []
}

fn fleet_posix_principal(key: FleetPosixAccountKey) -> GroundedPosixPrincipal {
  match key {
    FleetAccountRoot =>
      GroundedPosixPrincipal {
        posix: fleet_posix_root_user,
        sudo_grants: fleet_posix_root_sudo_grants(),
        declared_probe: fleet_posix_root_declared_probe,
      }
    FleetAccountOperator =>
      GroundedPosixPrincipal {
        posix: fleet_posix_operator_user,
        sudo_grants: fleet_posix_operator_sudo_grants(),
        declared_probe: fleet_posix_operator_declared_probe,
      }
    FleetAccountCiRunner =>
      GroundedPosixPrincipal {
        posix: fleet_posix_ci_runner_user,
        sudo_grants: fleet_posix_ci_runner_sudo_grants(),
        declared_probe: fleet_posix_ci_runner_declared_probe,
      }
    FleetAccountSrv3Host =>
      GroundedPosixPrincipal {
        posix: fleet_posix_srv3_host_user,
        sudo_grants: fleet_posix_srv3_host_sudo_grants(),
        declared_probe: fleet_posix_srv3_host_declared_probe,
      }
    FleetAccountAutomation =>
      GroundedPosixPrincipal {
        posix: fleet_posix_automation_user,
        sudo_grants: fleet_posix_automation_sudo_grants(),
        declared_probe: fleet_posix_automation_declared_probe,
      }
    FleetAccountInferenceService =>
      GroundedPosixPrincipal {
        posix: fleet_posix_inference_service_user,
        sudo_grants: fleet_posix_inference_service_sudo_grants(),
        declared_probe: fleet_posix_inference_service_declared_probe,
      }
  }
}

fn fleet_deploy_job_principal(runner: DeployRunnerPrincipal) -> GroundedPosixPrincipal? {
  fleet_posix_account_from_name(name: runner.job_user)
}

fn grounded_posix_principal_name(p: GroundedPosixPrincipal) -> NonEmptyStr {
  p.posix.name
}

fn posix_declared_probe_names_principal(p: GroundedPosixPrincipal) -> Bool {
  let expected = concat("id ", p.posix.name as String) as NonEmptyStr
  p.declared_probe.probe_command == expected
}

fn fleet_posix_account_from_name(name: NonEmptyStr) -> GroundedPosixPrincipal? {
  match name == fleet_posix_root_user.name {
    true => Present { value: fleet_posix_principal(key: FleetAccountRoot) }
    false =>
      match name == fleet_posix_operator_user.name {
        true => Present { value: fleet_posix_principal(key: FleetAccountOperator) }
        false =>
          match name == fleet_posix_ci_runner_user.name {
            true => Present { value: fleet_posix_principal(key: FleetAccountCiRunner) }
            false =>
              match name == fleet_posix_srv3_host_user.name {
                true => Present { value: fleet_posix_principal(key: FleetAccountSrv3Host) }
                false => Absent
              }
          }
      }
  }
}

data fleet_posix_account_exists_predicate_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.fleet_posix_accounts",
    decl_name: "fleet_posix_account_from_name",
    field: WholeDeclaration,
  }
}

fn fleet_posix_account_exists(name: NonEmptyStr) -> Bool {
  match fleet_posix_account_from_name(name: name) {
    Present { value: _ } => true
    Absent => false
  }
}
