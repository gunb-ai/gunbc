data fleet_hostnamectl_command_path: std.types.NonEmptyStr = "/usr/bin/hostnamectl"

data fleet_operator_email: std.types.NonEmptyStr = "briansrls@gmail.com"

fn fleet_operator_gcp_iam_member() -> String {
  concat("user:", fleet_operator_email as String)
}

fn fleet_posix_root_sudo_grants() -> List<PosixSudoGrant> {
  []
}

fn fleet_posix_operator_sudo_grants() -> List<PosixSudoGrant> {
  [
    PosixSudoGrant {
      command_path: fleet_hostnamectl_command_path,
      probe: extdeps.sudo.nopasswd_execute_probe.NopasswdExecuteCheck { check_argv: "--version" },
    },
  ]
}

// Structural guard: operator roster must stay hostnamectl-only until operator rules on
// set-property elevation — not whole-binary install/systemctl (root-equivalent).
fn fleet_posix_operator_sudo_grant_is_hostnamectl_only() -> Bool {
  match fleet_posix_operator_sudo_grants().first() {
    Present { value: g } => g.command_path == fleet_hostnamectl_command_path
    Absent => false
  }
}

