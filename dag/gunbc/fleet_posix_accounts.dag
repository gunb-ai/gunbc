data fleet_visudo_binary_path: std.types.NonEmptyStr = "/usr/sbin/visudo"

data gunbc_deploy_privileged_helper_path: std.types.NonEmptyStr = "/opt/gunbc/bin/gunbc-deploy-privileged"

data gunbc_deploy_privileged_helper_check_argv: std.types.NonEmptyStr = "probe"

fn fleet_posix_ci_runner_sudo_grants() -> List<PosixSudoGrant> {
  [
    PosixSudoGrant { command_path: fleet_apt_get_binary_path, probe: extdeps.sudo.nopasswd_execute_probe.NopasswdExecuteCheck { check_argv: "--help" } },
    PosixSudoGrant { command_path: "/usr/bin/install", probe: extdeps.sudo.nopasswd_execute_probe.NopasswdExecuteCheck { check_argv: "--version" } },
    PosixSudoGrant { command_path: fleet_visudo_binary_path, probe: extdeps.sudo.nopasswd_execute_probe.NopasswdExecuteCheck { check_argv: "-V" } },
    PosixSudoGrant { command_path: "/usr/bin/systemctl", probe: extdeps.sudo.nopasswd_execute_probe.NopasswdExecuteCheck { check_argv: "--version" } },
    PosixSudoGrant { command_path: "/usr/bin/tailscale", probe: NopasswdGrantListCheck },
    PosixSudoGrant { command_path: "/usr/bin/rm", probe: extdeps.sudo.nopasswd_execute_probe.NopasswdExecuteCheck { check_argv: "--version" } },
  ]
}

fn fleet_posix_srv3_host_sudo_grants() -> List<PosixSudoGrant> {
  []
