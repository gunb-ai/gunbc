module gunbc.fleet_posix_accounts


data fleet_posix_accounts_scope_disposition: std.disposition.Disposition = Terminal {
  reason: "Single authority for fleet POSIX principals on srv1/srv2/srv3: closed roster construction only (no arbitrary-string principal). §3: PosixUser is extdeps/access; fleet rows live in gunbc/. declared_probe is authored provenance of the intended id(1) check — NOT live observation; live existence proof is deploy_access_check_observed. Grant alignment seam (#6146): GroundedPosixPrincipal is POSIX WHO; secret_access_grant.GrantPrincipal is GCP WIF WHO; operator links via FleetAccountOperator + fleet_operator_gcp_iam_member(). DeployRunnerPrincipal grounds the unit_user vs job_user split for CI runners."
}

type PosixAccountDeclaredProbe {
  probed_at: std.types.NonEmptyStr
  probe_command: std.types.NonEmptyStr
  host: std.types.NonEmptyStr
}

type PosixSudoGrant {
  command_path: std.types.NonEmptyStr
  probe: extdeps.sudo.nopasswd_execute_probe.SudoNopasswdProbeKind
}

data posix_sudo_grant_materialization_note: String = "PosixSudoGrant is the fleet-domain MATERIALIZATION carrier for std.effect_grant.Grant over ExecuteEffect: posix_sudo_grant_to_effect_grant projects command_path to filesystem_position and carries verb via verb_of_effect_shape(ExecuteEffect) -- never a parallel grant vocabulary (DESIGN 3). probe chooses the typed verification operation (execute-check, or grant-list when the binary may be absent); it is observation policy, not grant reach. WHO may sudo remains GroundedPosixPrincipal / std.access. dissolve-on = deploy-preflight envelope admits via admit_effect over projected grants."

fn absolute_command_path_segments(path: std.types.NonEmptyStr) -> List<String> {
  filter(xs: split(s: path as String, delimiter: "/"), f: s => s != "")
}

fn posix_sudo_grant_to_effect_grant(g: PosixSudoGrant) -> std.effect_grant.Grant {
  std.effect_grant.Grant {
    verb: verb_of_effect_shape(shape: ExecuteEffect),
    root: filesystem_position(path: absolute_command_path_segments(path: g.command_path)),
    binding: RealTransport,
    lifecycle: LifecycleByConstruction,
  }
}

type GroundedPosixPrincipal {
  posix: extdeps.access.posix.PosixUser
  sudo_grants: List<PosixSudoGrant>
  declared_probe: PosixAccountDeclaredProbe
}

type DeployRunnerPrincipal {
  unit_user: std.types.NonEmptyStr
  job_user: std.types.NonEmptyStr
}

data deploy_runner_principal_note: String = "Two-phase runner principal (#6096 declared-vs-effective): unit_user is the systemd User= on the actions-runner unit (root on srv1); job_user is the deprivileged effective principal for workflow steps (ghrunner on srv1). Deploy authorization and sudoers roster ground on job_user only — never unit_user."

data srv1_ci_deploy_runner_principal: DeployRunnerPrincipal = DeployRunnerPrincipal {
  unit_user: "root",
  job_user: "ghrunner",
}

// ONE semantic principal population. The two new arms are PRINCIPAL IDENTITIES, not accounts:
// they carry policy and no operating-system label, because fleet-automation@gunbc is an SSH key
// comment and never was a username. What a principal IS lives here; what it is CALLED on a given
// host is an allocation, and the two are joined only by an executed observation.
type FleetPosixAccountKey
  = FleetAccountRoot
  | FleetAccountOperator
  | FleetAccountCiRunner
  | FleetAccountSrv3Host
  | FleetAccountAutomation
  | FleetAccountInferenceService

