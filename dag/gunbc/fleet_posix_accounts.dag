module gunbc.fleet_posix_accounts

import extdeps.access.posix { PosixUser }
import extdeps.sudo.nopasswd_execute_probe { SudoNopasswdExecuteProbeShape }
import std.types { NonEmptyStr, List, String, Bool }
import std.disposition { Disposition, Terminal, Scaffold, ConstructionMechanism }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.effects { ExecuteEffect }
import std.effect_grant {
  Grant, RealTransport, LifecycleByConstruction,
  filesystem_position, grant_verb, verb_eq, verb_of_effect_shape,
}

data fleet_posix_accounts_scope_disposition: Disposition = Terminal {
  reason: "Single authority for fleet POSIX principals on srv1/srv2/srv3: closed roster construction only (no arbitrary-string principal). §3: PosixUser is extdeps/access; fleet rows live in gunbc/. declared_probe is authored provenance of the intended id(1) check — NOT live observation; live existence proof is deploy_access_check_observed. Grant alignment seam (#6146): GroundedPosixPrincipal is POSIX WHO; secret_access_grant.GrantPrincipal is GCP WIF WHO; operator links via FleetAccountOperator + fleet_operator_gcp_iam_member(). DeployRunnerPrincipal grounds the unit_user vs job_user split for CI runners."
}

type PosixAccountDeclaredProbe {
  probed_at: NonEmptyStr
  probe_command: NonEmptyStr
  host: NonEmptyStr
}

type PosixSudoGrant = SudoNopasswdExecuteProbeShape

data posix_sudo_grant_materialization_note: String = "PosixSudoGrant is the fleet-domain MATERIALIZATION carrier for std.effect_grant.Grant over ExecuteEffect: posix_sudo_grant_to_effect_grant projects command_path to filesystem_position and carries verb via verb_of_effect_shape(ExecuteEffect) -- never a parallel grant vocabulary (DESIGN 3). check_argv is the deploy-preflight probe argv (transport/policy, not reach). WHO may sudo remains GroundedPosixPrincipal / std.access. dissolve-on = deploy-preflight envelope admits via admit_effect over projected grants."

fn absolute_command_path_segments(path: NonEmptyStr) -> List<String> {
  filter(xs: split(s: path as String, delimiter: "/"), f: s => s != "")
}

fn posix_sudo_grant_to_effect_grant(g: PosixSudoGrant) -> Grant {
  Grant {
    verb: verb_of_effect_shape(shape: ExecuteEffect),
    root: filesystem_position(path: absolute_command_path_segments(path: g.command_path)),
    binding: RealTransport,
    lifecycle: LifecycleByConstruction,
  }
}

type GroundedPosixPrincipal {
  posix: PosixUser
  sudo_grants: List<PosixSudoGrant>
  declared_probe: PosixAccountDeclaredProbe
}

type DeployRunnerPrincipal {
  unit_user: NonEmptyStr
  job_user: NonEmptyStr
}

data deploy_runner_principal_note: String = "Two-phase runner principal (#6096 declared-vs-effective): unit_user is the systemd User= on the actions-runner unit (root on srv1); job_user is the deprivileged effective principal for workflow steps (ghrunner on srv1). Deploy authorization and sudoers roster ground on job_user only — never unit_user."

data srv1_ci_deploy_runner_principal: DeployRunnerPrincipal = DeployRunnerPrincipal {
  unit_user: "root",
  job_user: "ghrunner",
}

type FleetPosixAccountKey
  = FleetAccountRoot
  | FleetAccountOperator
  | FleetAccountCiRunner
  | FleetAccountSrv3Host

data fleet_posix_root_user: PosixUser = PosixUser {
  name: "root",
  uid: 0,
  gid: 0,
}

data fleet_posix_operator_user: PosixUser = PosixUser {
  name: "briansrls",
  uid: 1000,
  gid: 1000,
}

data fleet_posix_ci_runner_user: PosixUser = PosixUser {
  name: "ghrunner",
  uid: 1001,
  gid: 1001,
}

data fleet_posix_srv3_host_user: PosixUser = PosixUser {
  name: "ubuntu",
  uid: 1000,
  gid: 1000,
}

data fleet_posix_root_declared_probe: PosixAccountDeclaredProbe = PosixAccountDeclaredProbe {
  probed_at: "2026-07-02",
  probe_command: "id root",
  host: "srv1",
}

data fleet_posix_operator_declared_probe: PosixAccountDeclaredProbe = PosixAccountDeclaredProbe {
  probed_at: "2026-07-02",
  probe_command: "id briansrls",
  host: "srv1",
}

data fleet_posix_ci_runner_declared_probe: PosixAccountDeclaredProbe = PosixAccountDeclaredProbe {
  probed_at: "2026-07-02",
  probe_command: "id ghrunner",
  host: "srv1",
}

data fleet_posix_srv3_host_declared_probe: PosixAccountDeclaredProbe = PosixAccountDeclaredProbe {
  probed_at: "2026-07-21",
  probe_command: "id ubuntu",
  host: "srv3",
}

data fleet_hostnamectl_command_path: NonEmptyStr = "/usr/bin/hostnamectl"

data fleet_operator_email: NonEmptyStr = "briansrls@gmail.com"

fn fleet_operator_gcp_iam_member() -> String {
  concat("user:", fleet_operator_email as String)
}

fn fleet_posix_root_sudo_grants() -> List<PosixSudoGrant> {
  []
}

fn fleet_posix_operator_sudo_grants() -> List<PosixSudoGrant> {
  [
    PosixSudoGrant {
      command_path: fleet_hostnamectl_command_path,
      check_argv: "--version",
    },
  ]
}

data fleet_apt_get_binary_path: NonEmptyStr = "/usr/bin/apt-get"

data fleet_visudo_binary_path: NonEmptyStr = "/usr/sbin/visudo"

data gunbc_deploy_privileged_helper_path: NonEmptyStr = "/opt/gunbc/bin/gunbc-deploy-privileged"

data gunbc_deploy_privileged_helper_check_argv: NonEmptyStr = "probe"

fn fleet_posix_ci_runner_sudo_grants() -> List<PosixSudoGrant> {
  [
    PosixSudoGrant { command_path: fleet_apt_get_binary_path, check_argv: "--help" },
    PosixSudoGrant { command_path: "/usr/bin/install", check_argv: "--version" },
    PosixSudoGrant { command_path: fleet_visudo_binary_path, check_argv: "-V" },
    PosixSudoGrant { command_path: "/usr/bin/systemctl", check_argv: "--version" },
    PosixSudoGrant { command_path: "/usr/bin/tailscale", check_argv: "version" },
    PosixSudoGrant { command_path: "/usr/bin/rm", check_argv: "--version" },
  ]
}

fn fleet_posix_ci_runner_sudo_command_paths() -> List<NonEmptyStr> {
  map(fleet_posix_ci_runner_sudo_grants(), g => g.command_path)
}

fn fleet_posix_srv3_host_sudo_grants() -> List<PosixSudoGrant> {
  []
}

fn fleet_posix_principal(key: FleetPosixAccountKey) -> GroundedPosixPrincipal {
  match key {
    FleetAccountRoot =>
      GroundedPosixPrincipal {
        posix: fleet_posix_root_user,
        sudo_grants: fleet_posix_root_sudo_grants(),
        declared_probe: fleet_posix_root_declared_probe,
      }
    FleetAccountOperator =>
      GroundedPosixPrincipal {
        posix: fleet_posix_operator_user,
        sudo_grants: fleet_posix_operator_sudo_grants(),
        declared_probe: fleet_posix_operator_declared_probe,
      }
    FleetAccountCiRunner =>
      GroundedPosixPrincipal {
        posix: fleet_posix_ci_runner_user,
        sudo_grants: fleet_posix_ci_runner_sudo_grants(),
        declared_probe: fleet_posix_ci_runner_declared_probe,
      }
    FleetAccountSrv3Host =>
      GroundedPosixPrincipal {
        posix: fleet_posix_srv3_host_user,
        sudo_grants: fleet_posix_srv3_host_sudo_grants(),
        declared_probe: fleet_posix_srv3_host_declared_probe,
      }
  }
}

fn fleet_deploy_job_principal(runner: DeployRunnerPrincipal) -> GroundedPosixPrincipal? {
  fleet_posix_account_from_name(name: runner.job_user)
}

fn grounded_posix_principal_name(p: GroundedPosixPrincipal) -> NonEmptyStr {
  p.posix.name
}

fn posix_declared_probe_names_principal(p: GroundedPosixPrincipal) -> Bool {
  let expected = concat("id ", p.posix.name as String) as NonEmptyStr
  p.declared_probe.probe_command == expected
}

fn fleet_posix_account_from_name(name: NonEmptyStr) -> GroundedPosixPrincipal? {
  match name == fleet_posix_root_user.name {
    true => Present { value: fleet_posix_principal(key: FleetAccountRoot) }
    false =>
      match name == fleet_posix_operator_user.name {
        true => Present { value: fleet_posix_principal(key: FleetAccountOperator) }
        false =>
          match name == fleet_posix_ci_runner_user.name {
            true => Present { value: fleet_posix_principal(key: FleetAccountCiRunner) }
            false =>
              match name == fleet_posix_srv3_host_user.name {
                true => Present { value: fleet_posix_principal(key: FleetAccountSrv3Host) }
                false => Absent
              }
          }
      }
  }
}

data fleet_posix_account_exists_predicate_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.fleet_posix_accounts",
    decl_name: "fleet_posix_account_from_name",
    field: WholeDeclaration,
  }
}

fn fleet_posix_account_exists(name: NonEmptyStr) -> Bool {
  match fleet_posix_account_from_name(name: name) {
    Present { value: _ } => true
    Absent => false
  }
}
