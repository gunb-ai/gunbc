module gunbc.provider_interface_binding

import std.types { NonEmptyStr, String, FilePath, Bool }
import std.content_hash { ContentHash }
import extdeps.llm.codex_app_server {
  CodexAppServerTransport,
  CodexAppServerStdio,
  CodexAppServerExecutable,
  codex_app_server_initialize_request_line,
}
import gunbc.package_delivery { CodexRuntimeBundle }
import gunbc.codex_runtime_bundle {
  codex_bundle_executable_path,
  codex_bundle_identity,
}
import gunbc.retained_shell_script { retained_foreign }
import extdeps.shell

data provider_interface_binding_note: String = "ONE nested ProviderInterfaceBinding. Provider identity is derived from the realization closure (runtime bundle + transport + lifecycle + protocol schema identity), never a writable sibling enum. Production binding requires installed executable read-back + successful app-server initialize — no exec --json fallback arm exists. project_codex_app_server_stdio_binding is hermetic path projection only."

type ProviderControlInterface
  = CodexAppServer {}

type ProviderInterfaceBinding {
  interface: ProviderControlInterface
  transport: CodexAppServerTransport
  executable: CodexAppServerExecutable
  runtime_identity: ContentHash
  protocol_schema_identity: ContentHash
}

type ProviderInterfaceResolution
  = ProviderInterfaceResolved {
      binding: ProviderInterfaceBinding
    }
  | RequiredProviderInterfaceUnavailable {
      interface: ProviderControlInterface
      reason: NonEmptyStr
    }

fn project_codex_app_server_stdio_binding(
  bundle: CodexRuntimeBundle,
) -> ProviderInterfaceResolution {
  ProviderInterfaceResolved {
    binding: ProviderInterfaceBinding {
      interface: CodexAppServer {},
      transport: CodexAppServerStdio,
      executable: CodexAppServerExecutable {
        path: codex_bundle_executable_path(bundle: bundle),
      },
      runtime_identity: codex_bundle_identity(bundle: bundle),
      protocol_schema_identity: bundle.receipt.protocol_schema_identity,
    },
  }
}

fn observe_bind_codex_app_server_stdio(
  bundle: CodexRuntimeBundle,
) -> ProviderInterfaceResolution {
  let path = codex_bundle_executable_path(bundle: bundle)
  let present = shell.Test.IsFile(path: path)
  if present.is_file == false {
    RequiredProviderInterfaceUnavailable {
      interface: CodexAppServer {},
      reason: "bundled Codex native executable absent at binding path" as NonEmptyStr,
    }
  } else {
    let script = retained_foreign(
      body: concat(
        "printf '%s\\n' '",
        concat(
          codex_app_server_initialize_request_line() as String,
          concat("' | '", concat(path as String, "' app-server --stdio")),
        ),
      ),
      reason: "Codex app-server initialize binding observation pending typed NDJSON transport" as NonEmptyStr,
    )
    let run = shell.Exec.Run(script: script)
    if run.success == false {
      RequiredProviderInterfaceUnavailable {
        interface: CodexAppServer {},
        reason: "codex app-server initialize refused during binding" as NonEmptyStr,
      }
    } else if (run.stdout as String).contains("userAgent") {
      ProviderInterfaceResolved {
        binding: ProviderInterfaceBinding {
          interface: CodexAppServer {},
          transport: CodexAppServerStdio,
          executable: CodexAppServerExecutable { path: path },
          runtime_identity: codex_bundle_identity(bundle: bundle),
          protocol_schema_identity: bundle.receipt.protocol_schema_identity,
        },
      }
    } else {
      RequiredProviderInterfaceUnavailable {
        interface: CodexAppServer {},
        reason: "codex app-server initialize produced no JSON-RPC result" as NonEmptyStr,
      }
    }
  }
}
