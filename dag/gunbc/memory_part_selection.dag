module gunbc.memory_part_selection


// HOW WE KNOW A STEP FAILS. Not all evidence is equal, and a selection model
// that flattens these would let the weakest link carry the strongest verdict.
// The platform's own syndrome register named the failing step. This is the
// strongest form and is NOT what gunbc currently holds for MREP.
// On AssociatedByIdenticalSignature:
// A vendor or third party reported the step by name alongside status words
// byte-identical to ours. Strong, but an association rather than a decode:
// it establishes that the same failure signature carries that step's name,
// not that our platform's registers were read and interpreted.
// On InferredFromSequencePosition:
// The step is inferred from position in the boot sequence only.
type TrainingEvidenceStanding
  = DecodedFromPlatformSyndrome { register: std.types.NonEmptyStr }
  | AssociatedByIdenticalSignature { signature: std.types.NonEmptyStr, source: extdeps.external_authority.ExternalAuthority }
  | InferredFromSequencePosition
  | EvidenceUnobserved

// On observed_population:
// The module population the failure was observed with. A step failure seen
// only in a sparse population is weaker support for rejecting a part in a
// full population, so the observation carries its own conditions.
type PlatformTrainingFailure {
  board: extdeps.boards.types.BaseboardModel
  step: extdeps.memory.training.MemoryTrainingStep
  standing: TrainingEvidenceStanding
  observed_population: List<std.types.NonEmptyStr>
  observed_at: std.types.EpochMs
}

// WHAT AN OBSERVED STEP FAILURE LICENSES, graded by evidence and scoped to
// the platform it was seen on. An earlier revision of this module refused any
// module that merely EXECUTES a step some platform was observed to fail, on
// any board, at any evidence standing — including EvidenceUnobserved. That is
// the blocklist this module's own prose claims to avoid, reached by a
// different route: since capacities near the generation's density ceiling are
// disproportionately load-reduced, a blanket MREP refusal removes most of the
// 64GB DDR4 market by construction, which is the opposite of shopping it.
//
// Two facts do the grading. A failure on ANOTHER board says nothing about this
// one. And an association carrying byte-identical status words is strong
// enough to demand a sample before committing to eight modules, but not strong
// enough to declare a part incompatible sight-unseen — only a decode of this
// platform's own syndrome register is.
type PartImplication
  = PartNotImplicated
  | PartSampleQualificationRequired {
      step: extdeps.memory.training.MemoryTrainingStep
      standing: TrainingEvidenceStanding
    }
  | PartImplicatedByFailingStep {
      step: extdeps.memory.training.MemoryTrainingStep
      standing: TrainingEvidenceStanding
    }

fn implication_severity(
  step: extdeps.memory.training.MemoryTrainingStep,
  standing: TrainingEvidenceStanding,
) -> PartImplication {
  match standing {
    DecodedFromPlatformSyndrome { register: _ } =>
      PartImplicatedByFailingStep { step: step, standing: standing }
    AssociatedByIdenticalSignature { signature: _, source: _ } =>
      PartSampleQualificationRequired { step: step, standing: standing }
    InferredFromSequencePosition =>
      PartSampleQualificationRequired { step: step, standing: standing }
    EvidenceUnobserved => PartNotImplicated
  }
}

fn implication_for_step(
  candidate: extdeps.memory.types.DramModuleCatalogRow,
  failure: PlatformTrainingFailure,
  target_board: extdeps.boards.types.BaseboardModel,
) -> PartImplication {
  if failure.board != target_board {
    PartNotImplicated
  } else if module_executes_step(module: candidate, step: failure.step) {
    implication_severity(step: failure.step, standing: failure.standing)
  } else {
    PartNotImplicated
  }
}

fn part_implication(
  candidate: extdeps.memory.types.DramModuleCatalogRow,
  failures: List<PlatformTrainingFailure>,
  target_board: extdeps.boards.types.BaseboardModel,
) -> PartImplication {
  fold(
    failures,
    init: PartNotImplicated,
    f: (acc, failure) =>
      match acc {
        PartImplicatedByFailingStep { step: s, standing: st } =>
          PartImplicatedByFailingStep { step: s, standing: st }
        PartSampleQualificationRequired { step: s, standing: st } =>
          match implication_for_step(
            candidate: candidate,
            failure: failure,
            target_board: target_board,
          ) {
            PartImplicatedByFailingStep { step: s2, standing: st2 } =>
              PartImplicatedByFailingStep { step: s2, standing: st2 }
            _ => PartSampleQualificationRequired { step: s, standing: st }
          }
        PartNotImplicated =>
          implication_for_step(
            candidate: candidate,
            failure: failure,
            target_board: target_board,
          )
      },
  )
}

// THE SECOND RISK AXIS, kept separate because it has a different cause. A part
// whose capacity is unreachable as a plain dual-rank registered module in its
// generation had to be built with extra ranks or stacked die — so at that
// capacity, "cheaper and slower" systematically selects the exotic topology.
// This is derived from JEDEC die density, not from price observation.
type TopologyPressure
  = CapacityReachableConventionally
  | CapacityForcesExoticTopology { capacity_bytes: std.measure.ByteSize }

fn topology_pressure(
  candidate: extdeps.memory.types.DramModuleCatalogRow,
  jedec: extdeps.memory.types.JedecDdrGenerationCatalogRow,
) -> TopologyPressure {
  if capacity_reachable_as_dual_rank_registered(module: candidate, jedec: jedec) {
    CapacityReachableConventionally
  } else {
    CapacityForcesExoticTopology { capacity_bytes: candidate.capacity_bytes }
  }
}

// A candidate for an ordering decision. Price rides the std.measure money
// carrier rather than a bare integer, and the currency is the std.currency
// closed code rather than a free string: a cross-currency comparison is then
// refused at admission below (DESIGN section 5 construction over validation),
// where an earlier revision of this module only narrated the invariant in a
// comment the compiler could not read.
type PartCandidate {
  module: extdeps.memory.types.DramModuleCatalogRow
  unit_price: std.measure.MoneyAmountMicro
  currency: std.currency.CurrencyCode
  sticks_required: std.nat.Nat
  qualification: gunbc.host_memory_qualification.SpecificPartQualification
}

fn candidate_total_capacity_bytes(candidate: PartCandidate) -> std.nat.Nat {
  byte_size_count(b: candidate.module.capacity_bytes) * candidate.sticks_required
}

fn candidate_total_price_micros(candidate: PartCandidate) -> std.nat.Nat {
  money_amount_micro_count(m: candidate.unit_price) * candidate.sticks_required
}

// PARETO SELECTION. Three objectives, and the implication axis is NOT one of
// them: an implicated part is REFUSED before the frontier is computed, because
// trading "it might not train" against price is how the failing modules were
// bought in the first place. Pareto ranks the parts that could work; it does
// not price the risk of parts we have mechanical reason to reject.
// Admission is a typed verdict rather than a Bool, so a dropped candidate
// carries WHY it was dropped. The currency arm is the load-bearing one: the
// frontier is computed against a DECLARED currency, and a candidate priced in
// another one is refused rather than silently ranked, which is what makes
// "prices are not compared across currencies" a property of the code instead
// of a sentence beside it.
type CandidateAdmission
  = CandidateAdmissible
  | CandidateSampleRequired {
      step: extdeps.memory.training.MemoryTrainingStep
      standing: TrainingEvidenceStanding
    }
  | CandidateImplicated {
      step: extdeps.memory.training.MemoryTrainingStep
      standing: TrainingEvidenceStanding
    }
  | CandidateCurrencyMismatch {
      declared: std.currency.CurrencyCode
      candidate_currency: std.currency.CurrencyCode
    }

fn candidate_admission(
  candidate: PartCandidate,
  failures: List<PlatformTrainingFailure>,
  declared_currency: std.currency.CurrencyCode,
  target_board: extdeps.boards.types.BaseboardModel,
) -> CandidateAdmission {
  if candidate.currency != declared_currency {
    CandidateCurrencyMismatch {
      declared: declared_currency,
      candidate_currency: candidate.currency,
    }
  } else {
    match part_implication(
      candidate: candidate.module,
      failures: failures,
      target_board: target_board,
    ) {
      PartNotImplicated => CandidateAdmissible
      PartSampleQualificationRequired { step: s, standing: st } =>
        CandidateSampleRequired { step: s, standing: st }
      PartImplicatedByFailingStep { step: s, standing: st } =>
        CandidateImplicated { step: s, standing: st }
    }
  }
}

// A sample-required candidate STAYS on the frontier. It is a buy-one-and-test
// candidate, not a rejected one, and removing it here is exactly how the
// market got shrunk to registered modules by construction. Only a decoded
// platform-syndrome refusal, or a currency the caller did not declare, drops a
// part before ranking.
fn candidate_admissible(
  candidate: PartCandidate,
  failures: List<PlatformTrainingFailure>,
  declared_currency: std.currency.CurrencyCode,
  target_board: extdeps.boards.types.BaseboardModel,
) -> Bool {
  match candidate_admission(
    candidate: candidate,
    failures: failures,
    declared_currency: declared_currency,
    target_board: target_board,
  ) {
    CandidateAdmissible => true
    CandidateSampleRequired { step: _, standing: _ } => true
    CandidateImplicated { step: _, standing: _ } => false
    CandidateCurrencyMismatch { declared: _, candidate_currency: _ } => false
  }
}

// a dominates b when it is at least as good on every objective and strictly
// better on one. More capacity is better; less total price is better; a higher
// data rate is better (it is headroom, and the platform downclocks to the
// slowest module present).
fn candidate_dominates(a: PartCandidate, b: PartCandidate) -> Bool {
  let cap_a = candidate_total_capacity_bytes(candidate: a)
  let cap_b = candidate_total_capacity_bytes(candidate: b)
  let price_a = candidate_total_price_micros(candidate: a)
  let price_b = candidate_total_price_micros(candidate: b)
  let rate_a = a.module.data_rate_mts
  let rate_b = b.module.data_rate_mts
  (cap_a >= cap_b && price_a <= price_b && rate_a >= rate_b)
    && (cap_a > cap_b || price_a < price_b || rate_a > rate_b)
}

fn pareto_frontier(
  candidates: List<PartCandidate>,
  failures: List<PlatformTrainingFailure>,
  declared_currency: std.currency.CurrencyCode,
  target_board: extdeps.boards.types.BaseboardModel,
) -> List<PartCandidate> {
  let admissible = candidates |> filter(c =>
    candidate_admissible(
      candidate: c,
      failures: failures,
      declared_currency: declared_currency,
      target_board: target_board,
    ))
  admissible |> filter(c => !any(admissible, other => candidate_dominates(a: other, b: c)))
}

data altrad8ud_mrep_failure_observation: PlatformTrainingFailure = PlatformTrainingFailure {
  board: AsrockRackAltrad8ud1l2t,
  step: LrdimmDataBufferMrep,
  standing: AssociatedByIdenticalSignature {
    signature: "SK[0]: 00120001 / MC[0]: 00f100b4",
    source: asrock_altrad8ud_download_authority,
  },
  observed_population: ["A1"],
  observed_at: 1786590000000,
}

data memory_part_selection_note: String = "The selection rule is mechanical and derived: a candidate is graded by whether it must execute a training step THIS platform has been observed to fail, and by how strongly that failure is evidenced. For the ALTRAD8UD-1L2T the step is the DDR4 data-buffer read-phase calibration (MREP), which only load-reduced modules execute, so the grading is independent of vendor, part number, capacity, speed grade, and presence on any approved-vendor list. THE SEVERITY IS A FUNCTION OF EVIDENCE, and an earlier revision of this module got that wrong in a way worth recording: it refused every module executing the failing step, on any board, at any standing including EvidenceUnobserved. Because capacities near a generation's die-density ceiling are disproportionately load-reduced, that blanket rule removed most of the 64GB DDR4 market by construction — the exact blocklist this module's prose claimed to avoid, reached by a different route, and the opposite of letting a buyer shop the whole market. Now: a decode of this platform's own syndrome register refuses; an association carrying byte-identical controller status words, or an inference from sequence position, requires a SAMPLE before committing to a full population and stays on the Pareto frontier; an unobserved standing implicates nothing. gunbc holds MREP at AssociatedByIdenticalSignature, so the honest verdict for another ALTRAD8UD LRDIMM today is buy-one-and-test, not reject. Failures are scoped to the board they were observed on, so an ALTRAD8UD receipt cannot speak for a different platform. KNOWN GAP, stated rather than papered over: BaseboardModel currently has exactly one variant, so the board scoping is real in the code but has no executing cross-board control — minting a second board purely to test it would be a fabricated entity, and the control lands when a second real board is modeled. The second axis, topology pressure, is derived rather than observed: when a capacity cannot be reached as a dual-rank registered module within the generation's monolithic die-density ceiling, that capacity forces extra ranks or stacking, which is why 64GB DDR4 at older speed grades is disproportionately load-reduced while 32GB is not. A buyer economizing on speed grade at 64GB is therefore not buying the same module more slowly, it is a different topology — which is a reason to sample it, not a reason to refuse it."
