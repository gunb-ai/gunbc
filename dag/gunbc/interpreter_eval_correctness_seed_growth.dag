  current_boundary: "src/v1/stage0/src (v1_interpreter, cli_run and its submodules, coproduct_reflection, data_initializer_identity, derived_realization_schedule, pre_push, required_regen_host, bin/interp_recorded_fixture_witness); src/v1/tests/src (two tests)",
