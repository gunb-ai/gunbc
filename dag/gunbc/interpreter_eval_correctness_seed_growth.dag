module gunbc.interpreter_eval_correctness_seed_growth

import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.roadmap_model { RoadmapNodeId }
import gunbc.seed_growth { SeedGrowthJustification }

// SEED-GROWTH RECEIPTS FOR TWO SEED-INTERPRETER CORRECTNESS REPAIRS, admitted under
// gunbc.v1_maintenance_standing v1_seed_standing: the seed interpreter decides every claim verdict
// today, so a silent wrong answer there is silent wrongness in the v2 self-host program's evidence,
// and the repair can only live where the evaluation happens. THE POPULATION IS DERIVED, AND HOW IS
// STATED: tools.rust_item_census_instrument census was run on both changes (BuildBuddy, in a
// self-made memory cgroup, origin/main merge base) and REFUSED both as unattributed -- "changed line
// at HEAD falls outside every scanned item" in src/v1/stage0/src/v1_interpreter.rs, and for gunbc#12886
// also "not readable at item grain" in src/bin/interp_recorded_fixture_witness.rs -- so the items
// below are the changed items read from each change's diff, each confirmed to contain a changed
// line. Impl blocks and impl methods are listed in prose because std.decl_ref cannot name them
// (gunbc.rust_item_host_observation ItemDeclarationRefUncitable).
data match_arm_guard_seed_growth_justification: SeedGrowthJustification = SeedGrowthJustification {
  hand_authored_declarations: [
    DeclarationRef { module_path: "v1_compiler.v1_interpreter", decl_name: "eval_match", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.v1_interpreter", decl_name: "InterpError", field: WholeDeclaration },
  ],
  reason: "gunbc#12814. v1_interpreter eval_match never read arm_guard, so a guarded arm ran whatever its guard said while emitted Rust honoured it (gunbc.recurring_failure_mode interpreter_ignores_match_arm_guards). eval_match now evaluates the guard in the arm's bindings, falls through on false, and refuses a non-Bool with the new InterpError variant MatchGuardNotBool. UNCITABLE, also changed: impl fmt::Display for InterpError (fmt) and impl WitnessRuntimeCause (of_interp_error) in v1_compiler.cli_run, which classifies the new variant as type-error. The evaluation of a match is the seed interpreter's own act, so no .dag authority can host the repair.",
  owning_dissolution_lane: "v1-hand-queue-drain" as RoadmapNodeId,
  trigger: "Delete with the seed interpreter itself: when claims are evaluated on the emitted path rather than by v1_interpreter (the v1-interpreter-quarantine then v1-interpreter-delete lanes), this Rust has no evaluator left to correct and goes with the file. It has no earlier trigger, because the interpreter's evaluation semantics have no .dag authority that an earlier move could migrate into.",
  current_boundary: "src/v1/stage0/src/v1_interpreter.rs eval_match, InterpError; src/v1/stage0/src/cli_run.rs WitnessRuntimeCause::of_interp_error",
}

