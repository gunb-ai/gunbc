fn render_phase_standing(row: RustcPhaseBoardRow) -> String {
  match row.standing {
    PhaseNotYetReached => concat(rustc_phase_name(phase: row.phase), " not yet reached")
    PhaseCount { count: 0, evidence: _ } => concat(rustc_phase_name(phase: row.phase), " PASSES")
    PhaseCount { count: n, evidence: _ } => concat(concat(rustc_phase_name(phase: row.phase), " "), concat(to_string(n), " remaining"))
  }
}

fn render_phase_board(board: RustcPhaseBoard) -> String {
  board.rows |> map(r => render_phase_standing(row: r)) |> join(separator: " / ")
}
