data host_effect_hostname_script_dissolution_trigger: String = "🟡 dissolve-on: host_effect_hostname_script — concat-built bash CAS hostnamectl body for SetHostnameCas realize-layer transport (P6 Part 1; relocated from host_identity_converge scaffold); DISSOLVES WHEN bash-emit (#5828 / shell-emission slice0) realizes SetHostnameCas through typed argv invocations / grammar-emitted nodes and host_effect_set_hostname_cas_script retires without concat-built transport strings. Wave 4 residue (shell→dag census §1C category C)."

data host_effect_hostname_script_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
