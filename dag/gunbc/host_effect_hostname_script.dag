fn host_effect_set_hostname_cas_script(hostnamectl_path: NonEmptyStr, base: DnsLabel, desired: DnsLabel) -> String {
  concat(
    concat("[ \"$(hostname -s)\" = \"", concat(base as String, "\" ] && sudo -n ")),
    concat(hostnamectl_path as String, concat(" set-hostname ", desired as String))
  )
}
