module gunbc.selection_degradation_receipt


data selection_degradation_receipt_path: String = "target/floor-selection-degradation-receipt.txt"

data selection_degradation_receipt_note: String = "P2 of the floor prep-tax program (still-moth-459, 2026-08-03): every floor discovery run publishes selection honesty — state, selected/total entry groups, ratio, and fallback_reason — so an affected run that executes the whole corpus is a COUNTED performance degradation (SelectionSuperset), never quiet success (DESIGN section 5). SelectionDegradationUnavailable is the unknown selection_mode_tag fail-closed arm only; upfront categorization_unavailable augments Applied/Superset fallback_reason, not that state. Authority for classification and receipt shape; the seed transport in cli_run.rs resolves this module and calls selection_degradation_receipt_line with measured counts only."

data selection_degradation_receipt_marker: NonEmptyStr = "[selection-degradation]" as NonEmptyStr

type SelectionDegradationState
  = SelectionDegradationOff
  | SelectionDegradationPredictOnly
  | SelectionDegradationApplied
  | SelectionDegradationSuperset
  | SelectionDegradationUnavailable

type SelectionDegradationReceipt {
  selection_state: SelectionDegradationState
  selected_entry_groups: Nat
  total_entry_groups: Nat
  selection_ratio_bp: BasisPoint
  fallback_reason: String
}

fn selection_degradation_mode_of_tag(tag: NonEmptyStr) -> String {
  tag as String
}

fn selection_degradation_state_tag(state: SelectionDegradationState) -> String {
  match state {
    SelectionDegradationOff => "SelectionOff"
    SelectionDegradationPredictOnly => "SelectionPredictOnly"
    SelectionDegradationApplied => "SelectionApplied"
    SelectionDegradationSuperset => "SelectionSuperset"
    SelectionDegradationUnavailable => "SelectionUnavailable"
  }
}

fn selection_ratio_basis_points(selected: Nat, total: Nat) -> BasisPoint {
  if total == 0 {
    basis_point(count: 0)
  } else {
    basis_point(count: (selected * 10000) / total)
  }
}

fn selection_ratio_wire(selected: Nat, total: Nat) -> String {
  let bp = basis_point_count(bp: selection_ratio_basis_points(selected: selected, total: total))
  let unit = 10000
  let whole = bp / unit
  let frac = bp - (whole * unit)
  join(
    [to_string(whole), ".", zero_pad_left(digits: to_string(frac), width: 4)],
    ""
  )
}

fn selection_degradation_fallback_reason_off() -> String {
  "node_frontier_selection=SelectionOff — full corpus roster executed"
}

fn selection_degradation_fallback_reason_predict_only() -> String {
  "node_frontier_selection=SelectionPredictOnly — all witnesses run cold; divergences counted"
}

fn selection_degradation_fallback_reason_applied_narrowed(selected: Nat, total: Nat) -> String {
  concat(
    "SelectionApplied: ",
    concat(
      concat(to_string(selected), concat(" of ", to_string(total))),
      " entry groups executed (import-closure and node-frontier skip reduced the run)"
    )
  )
}

fn selection_degradation_fallback_reason_superset(total: Nat) -> String {
  concat(
    "SelectionSuperset: all ",
    concat(
      to_string(total),
      " entry groups executed — affected-set selection did not narrow the floor (counted performance degradation)"
    )
  )
}

fn selection_degradation_fallback_reason_categorization_unavailable(detail: String) -> String {
  concat(
    "upfront import-closure categorization failed (",
    concat(detail, "); per-shard selection is authoritative at completion")
  )
}

fn selection_degradation_fallback_reason_unknown_mode_tag(tag: NonEmptyStr) -> String {
  concat(
    "SelectionUnavailable: unknown selection_mode_tag (",
    concat(tag as String, "); expected off|applied|predict_only")
  )
}

fn selection_degradation_state_of(
  selection_mode_tag: NonEmptyStr,
  selected: Nat,
  total: Nat,
  categorization_unavailable: Bool,
  categorization_reason: String
) -> SelectionDegradationState {
  if selection_mode_tag == ("off" as NonEmptyStr) {
    SelectionDegradationOff
  } else if selection_mode_tag == ("predict_only" as NonEmptyStr) {
    SelectionDegradationPredictOnly
  } else if selection_mode_tag == ("applied" as NonEmptyStr) {
    if selected == total {
      SelectionDegradationSuperset
    } else {
      SelectionDegradationApplied
    }
  } else {
    SelectionDegradationUnavailable
  }
}

fn selection_degradation_fallback_reason_of(
  selection_mode_tag: NonEmptyStr,
  state: SelectionDegradationState,
  selected: Nat,
  total: Nat,
  categorization_unavailable: Bool,
  categorization_reason: String
) -> String {
  match state {
    SelectionDegradationOff => selection_degradation_fallback_reason_off()
    SelectionDegradationPredictOnly => selection_degradation_fallback_reason_predict_only()
    SelectionDegradationApplied =>
      if categorization_unavailable {
        concat(
          selection_degradation_fallback_reason_applied_narrowed(selected: selected, total: total),
          concat(
            " — ",
            selection_degradation_fallback_reason_categorization_unavailable(detail: categorization_reason)
          )
        )
      } else {
        selection_degradation_fallback_reason_applied_narrowed(selected: selected, total: total)
      }
    SelectionDegradationSuperset =>
      if categorization_unavailable {
        concat(
          selection_degradation_fallback_reason_superset(total: total),
          concat(
            " — ",
            selection_degradation_fallback_reason_categorization_unavailable(detail: categorization_reason)
          )
        )
      } else {
        selection_degradation_fallback_reason_superset(total: total)
      }
    SelectionDegradationUnavailable =>
      selection_degradation_fallback_reason_unknown_mode_tag(tag: selection_mode_tag)
  }
}

fn selection_degradation_receipt_of(
  selection_mode_tag: NonEmptyStr,
  selected: Nat,
  total: Nat,
  categorization_unavailable: Bool,
  categorization_reason: String
) -> SelectionDegradationReceipt {
  let state = selection_degradation_state_of(
    selection_mode_tag: selection_mode_tag,
    selected: selected,
    total: total,
    categorization_unavailable: categorization_unavailable,
    categorization_reason: categorization_reason
  )
  SelectionDegradationReceipt {
    selection_state: state,
    selected_entry_groups: selected,
    total_entry_groups: total,
    selection_ratio_bp: selection_ratio_basis_points(selected: selected, total: total),
    fallback_reason: selection_degradation_fallback_reason_of(
      selection_mode_tag: selection_mode_tag,
      state: state,
      selected: selected,
      total: total,
      categorization_unavailable: categorization_unavailable,
      categorization_reason: categorization_reason
    )
  }
}

fn selection_degradation_receipt_line(
  selection_mode_tag: NonEmptyStr,
  selected: Nat,
  total: Nat,
  categorization_unavailable: Bool,
  categorization_reason: String
) -> String {
  let r = selection_degradation_receipt_of(
    selection_mode_tag: selection_mode_tag,
    selected: selected,
    total: total,
    categorization_unavailable: categorization_unavailable,
    categorization_reason: categorization_reason
  )
  concat(
    concat(
      concat(selection_degradation_receipt_marker as String, " selection_state="),
      selection_degradation_state_tag(state: r.selection_state)
    ),
    concat(
      concat(
        concat(
          concat(" selected_entry_groups=", to_string(r.selected_entry_groups)),
          concat(" total_entry_groups=", to_string(r.total_entry_groups))
        ),
        concat(" selection_ratio=", selection_ratio_wire(selected: selected, total: total))
      ),
      concat(" fallback_reason=", r.fallback_reason)
    )
  )
}

fn selection_degradation_receipt_body(
  selection_mode_tag: NonEmptyStr,
  selected: Nat,
  total: Nat,
  categorization_unavailable: Bool,
  categorization_reason: String
) -> String {
  let r = selection_degradation_receipt_of(
    selection_mode_tag: selection_mode_tag,
    selected: selected,
    total: total,
    categorization_unavailable: categorization_unavailable,
    categorization_reason: categorization_reason
  )
  concat(
    concat(
      concat(
        concat("selection_state=", selection_degradation_state_tag(state: r.selection_state)),
        concat("\nselected_entry_groups=", to_string(r.selected_entry_groups))
      ),
      concat("\ntotal_entry_groups=", to_string(r.total_entry_groups))
    ),
    concat(
      concat("\nselection_ratio=", selection_ratio_wire(selected: selected, total: total)),
      concat("\nfallback_reason=", r.fallback_reason)
    )
  )
}

fn selection_degradation_receipt_json(
  selection_mode_tag: NonEmptyStr,
  selected: Nat,
  total: Nat,
  categorization_unavailable: Bool,
  categorization_reason: String
) -> JsonValue {
  let r = selection_degradation_receipt_of(
    selection_mode_tag: selection_mode_tag,
    selected: selected,
    total: total,
    categorization_unavailable: categorization_unavailable,
    categorization_reason: categorization_reason
  )
  json_object(members: [
    json_kv(
      key: "selection_state",
      value: json_string(s: selection_degradation_state_tag(state: r.selection_state))
    ),
    json_kv(key: "selected_entry_groups", value: json_int(n: r.selected_entry_groups)),
    json_kv(key: "total_entry_groups", value: json_int(n: r.total_entry_groups)),
    json_kv(
      key: "selection_ratio",
      value: json_string(s: selection_ratio_wire(selected: selected, total: total))
    ),
    json_kv(key: "fallback_reason", value: json_string(s: r.fallback_reason)),
    json_kv(key: "categorization_unavailable", value: json_bool(b: categorization_unavailable))
  ])
}

fn selection_degradation_is_superset(receipt: SelectionDegradationReceipt) -> Bool {
  match receipt.selection_state {
    SelectionDegradationSuperset => true
    SelectionDegradationOff => false
    SelectionDegradationPredictOnly => false
    SelectionDegradationApplied => false
    SelectionDegradationUnavailable => false
  }
}

fn selection_degradation_is_applied_narrowed(receipt: SelectionDegradationReceipt) -> Bool {
  match receipt.selection_state {
    SelectionDegradationApplied => true
    SelectionDegradationOff => false
    SelectionDegradationPredictOnly => false
    SelectionDegradationSuperset => false
    SelectionDegradationUnavailable => false
  }
}
