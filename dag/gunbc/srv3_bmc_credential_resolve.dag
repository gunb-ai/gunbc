module gunbc.srv3_bmc_credential_resolve


type BmcCredentialIntent {
  account: std.types.NonEmptyStr
  factory_login: std.credentials.FactoryLogin
  factory_acceptable: Bool
  rotated_secret_ref: extdeps.cloud.gcp.secret_ref.SecretRef
}

type BmcCredentialResolution
  = UseFactoryCredential { login: std.credentials.FactoryLogin }
  | UseRotatedSecretRef { secret_ref: extdeps.cloud.gcp.secret_ref.SecretRef }
  | CredentialResolutionRefused { reason: String }

type BmcCredentialMaterialization
  = BmcCredentialMaterialized { password: String }
  | BmcCredentialAccessUpsertRequired { plan: gunbc.auth.access_token_source.AccessEnsurePlan }
  | BmcCredentialFetchRefused { reason: std.types.NonEmptyStr }

fn srv3_os_install_actuate_credential_intent() -> BmcCredentialIntent {
  BmcCredentialIntent {
    account: srv3_onboarding_plan.factory_login.username,
    factory_login: extdeps.bmc.openbmc.openbmc_factory_login,
    factory_acceptable: true,
    rotated_secret_ref: gunbc.assimilate.bmc_wif_delegation_chain.bmc_srv3_admin_secret_ref,
  }
}

fn resolve_bmc_credential(
  intent: BmcCredentialIntent,
  observation: gunbc.bmc_onboarding.BmcCredentialProbeResult,
) -> BmcCredentialResolution {
  match observation {
    FactoryCredentialActive =>
      if intent.factory_acceptable {
        UseFactoryCredential { login: intent.factory_login }
      } else {
        CredentialResolutionRefused {
          reason: "factory credential active but workflow intent refuses factory login",
        }
      }
    RotatedCredentialActive =>
      UseRotatedSecretRef { secret_ref: intent.rotated_secret_ref }
    CredentialAccessUpsertRequired { plan: plan } =>
      CredentialResolutionRefused {
        reason: access_token_upsert_required_reason(plan: plan),
      }
    CredentialEnsureRefused { reason: reason } =>
      CredentialResolutionRefused { reason: reason as String }
    CredentialStateUnknown { reason: r } =>
      CredentialResolutionRefused { reason: r }
  }
}

fn bmcweb_login_body_content(username: std.types.NonEmptyStr, password: String) -> String {
  concat(
    concat(
      concat("{\"username\":\"", username as String),
      concat("\",\"password\":\"", password),
    ),
    "\"}",
  )
}

fn bmc_login_password_from_resolution(resolution: BmcCredentialResolution) -> String? {
  match resolution {
    UseFactoryCredential { login: l } => Present { value: l.published_password as String }
    UseRotatedSecretRef { secret_ref: _ } => Absent
    CredentialResolutionRefused { reason: _ } => Absent
  }
}

fn bmc_credential_refusal_reason(reason: String) -> std.types.NonEmptyStr {
  if string_length(s: reason) > 0 {
    reason as std.types.NonEmptyStr
  } else {
    "bmc credential resolution refused without reason detail" as std.types.NonEmptyStr
  }
}

func materialize_bmc_login_password(resolution: BmcCredentialResolution) -> BmcCredentialMaterialization
  uses net: std.resources.Network
{
  match resolution {
    UseFactoryCredential { login: l } =>
      BmcCredentialMaterialized { password: l.published_password as String }
    UseRotatedSecretRef { secret_ref: ref } =>
      match fetch_secret_ref_credential(
        secret_ref: ref,
        token_source: GcloudPrintToken,
      ) {
        SecretCredentialReady { credential: credential, resolved_version: _ } =>
          BmcCredentialMaterialized { password: credential as String }
        SecretCredentialAccessUpsertRequired { plan: plan } =>
          BmcCredentialAccessUpsertRequired { plan: plan }
        SecretCredentialWireDecodeRefused { identity_cause: _, payload_cause: _ } =>
          BmcCredentialFetchRefused {
            reason: "secret manager access version wire decode refused" as std.types.NonEmptyStr,
          }
        SecretCredentialFetchRefused { reason: reason } =>
          BmcCredentialFetchRefused { reason: reason }
      }
    CredentialResolutionRefused { reason: reason } =>
      BmcCredentialFetchRefused { reason: bmc_credential_refusal_reason(reason: reason) }
  }
}

func observe_and_resolve_srv3_bmc_credential() -> BmcCredentialResolution
  uses net: std.resources.Network
{
  let intent = srv3_os_install_actuate_credential_intent()
  let observation = srv3_probe_credential_phase()
  resolve_bmc_credential(intent: intent, observation: observation)
}

fn bmc_credential_resolution_uses_secret_ref(resolution: BmcCredentialResolution) -> Bool {
  match resolution {
    UseRotatedSecretRef { secret_ref: ref } =>
      ref == gunbc.assimilate.bmc_wif_delegation_chain.bmc_srv3_admin_secret_ref
    _ => false
  }
}

fn bmc_credential_resolution_uses_factory(resolution: BmcCredentialResolution) -> Bool {
  match resolution {
    UseFactoryCredential { login: _ } => true
    _ => false
  }
}
