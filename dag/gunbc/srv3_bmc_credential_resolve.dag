module gunbc.srv3_bmc_credential_resolve

import std.types { NonEmptyStr, String, Secret }
import std.credentials { FactoryLogin }
import extdeps.bmc.openbmc { openbmc_factory_login }
import extdeps.cloud.gcp.secret_ref { SecretRef }
import gunbc.bmc_onboarding {
  new_altra_onboarding_plan,
  BmcCredentialProbeResult,
  FactoryCredentialActive,
  RotatedCredentialActive,
  CredentialStateUnknown,
}
import gunbc.assimilate.bmc_wif_delegation_chain { bmc_srv3_admin_secret_ref }
import gunbc.auth.secret_ref_credential { fetch_secret_ref_credential }
import gunbc.tools.bmc_onboard { bmc_probe_credential_phase }
import std.resources { Network }

type BmcCredentialIntent {
  account: NonEmptyStr
  factory_login: FactoryLogin
  factory_acceptable: Bool
  rotated_secret_ref: SecretRef
}

type BmcCredentialResolution
  = UseFactoryCredential { login: FactoryLogin }
  | UseRotatedSecretRef { secret_ref: SecretRef }
  | CredentialResolutionRefused { reason: String }

fn srv3_os_install_actuate_credential_intent() -> BmcCredentialIntent {
  BmcCredentialIntent {
    account: new_altra_onboarding_plan.factory_login.username,
    factory_login: openbmc_factory_login,
    factory_acceptable: true,
    rotated_secret_ref: bmc_srv3_admin_secret_ref,
  }
}

fn resolve_bmc_credential(
  intent: BmcCredentialIntent,
  observation: BmcCredentialProbeResult,
) -> BmcCredentialResolution {
  match observation {
    FactoryCredentialActive =>
      if intent.factory_acceptable {
        UseFactoryCredential { login: intent.factory_login }
      } else {
        CredentialResolutionRefused {
          reason: "factory credential active but workflow intent refuses factory login",
        }
      }
    RotatedCredentialActive =>
      UseRotatedSecretRef { secret_ref: intent.rotated_secret_ref }
    CredentialStateUnknown { reason: r } =>
      CredentialResolutionRefused { reason: r }
  }
}

fn bmcweb_login_body_content(username: NonEmptyStr, password: String) -> String {
  concat(
    concat(
      concat("{\"username\":\"", username as String),
      concat("\",\"password\":\"", password),
    ),
    "\"}",
  )
}

fn bmc_login_password_from_resolution(resolution: BmcCredentialResolution) -> String? {
  match resolution {
    UseFactoryCredential { login: l } => Present { value: l.published_password as String }
    UseRotatedSecretRef { secret_ref: _ } => Absent
    CredentialResolutionRefused { reason: _ } => Absent
  }
}

func materialize_bmc_login_password(resolution: BmcCredentialResolution) -> String?
  uses net: Network
{
  match resolution {
    UseFactoryCredential { login: l } => Present { value: l.published_password as String }
    UseRotatedSecretRef { secret_ref: ref } =>
      Present { value: fetch_secret_ref_credential(secret_ref: ref) as String }
    CredentialResolutionRefused { reason: _ } => Absent
  }
}

func observe_and_resolve_srv3_bmc_credential() -> BmcCredentialResolution
  uses net: Network
{
  let intent = srv3_os_install_actuate_credential_intent()
  let observation = bmc_probe_credential_phase()
  resolve_bmc_credential(intent: intent, observation: observation)
}

fn bmc_credential_resolution_uses_secret_ref(resolution: BmcCredentialResolution) -> Bool {
  match resolution {
    UseRotatedSecretRef { secret_ref: ref } =>
      ref == bmc_srv3_admin_secret_ref
    _ => false
  }
}

fn bmc_credential_resolution_uses_factory(resolution: BmcCredentialResolution) -> Bool {
  match resolution {
    UseFactoryCredential { login: _ } => true
    _ => false
  }
}
