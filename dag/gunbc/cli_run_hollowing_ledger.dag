module gunbc.cli_run_hollowing_ledger

import std.types { Int, List, String }
import v2.std.algebra { filter, length }
import v2.std.node { Symbol }

type CliRunHollowFeature = Unclassified
type CliRunHollowDisposition = HollowTarget { feature: CliRunHollowFeature, v2_authority: String }
type CliRunHollowLedgerRow { id: Symbol, fn_name: String, source_line: Int, disposition: CliRunHollowDisposition }

data cli_run_hollowing_row_count_baseline: Int = 0
data cli_run_hollowing_ledger_rows: List<CliRunHollowLedgerRow> = [
]

fn cli_run_hollowing_ledger_row_count() -> Int {
  cli_run_hollowing_ledger_rows |> length
}

fn cli_run_hollowing_ledger_enumeration_holds() -> Bool {
  cli_run_hollowing_ledger_row_count() == cli_run_hollowing_row_count_baseline
}
