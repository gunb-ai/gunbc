module gunbc.generated_artifact_merge_driver

// THE MERGE DRIVER FOR merge=generated-artifact PATHS, AND WHY IT REFUSES INSTEAD OF ANSWERING
// `true`. The binding was `merge.generated-artifact.driver=true` — the shell builtin, which leaves
// the ours side in place and exits 0. Git then records the merge as CLEAN and the other side's
// bytes are gone with no signal. That is the absorbing fallback of DESIGN section 5 at the
// integration boundary: the driver's failure arm answered instead of refusing, and it destroyed the
// one fact worth keeping — that a provisional choice was made at all — so the deficit's frequency
// was zero by construction and nothing ranked it for fixing. MEASURED CLASS: PR #7836, twice in one
// session. Merging main into a branch that also touched src/v1/stage0/src/v1_compiler_infer.rs
// resolved the SEED to the branch side and dropped main's emit changes (103 lines, then 130 lines)
// while src/v1/04_infer.dag — the AUTHORITY — merged correctly and carried them. Git reported no
// conflict either time; the tree was left authority-ahead-of-seed, and the class surfaced a full CI
// cycle later as a red regen job, or not at all until someone happened to run regen_stage0
// --verify. THE REFUSAL IS PRECISE, NOT A WIDEN, and this is measured rather than argued: git
// invokes a low-level merge driver ONLY when both sides changed the path relative to the merge
// base. Executed against git 2.x with a probe driver on a four-case matrix — one-sided theirs,
// one-sided ours, both sides identical, both sides different — the driver was invoked in exactly
// the fourth case; the first three merged clean with the correct content and never reached it. So
// driver invocation holds exactly when taking either side drops the other side's authority-derived
// content, and refusing there adds no stop to any merge that was previously correct. WHAT THE
// REFUSAL LEAVES BEHIND: the script does not write to the result file, so git keeps the ours side
// verbatim — clean bytes, NO conflict markers — and marks the path unmerged. The regenerators can
// therefore run against the worktree immediately, and a writer that would sweep the tree cannot
// commit marker text (there is none to sweep); the unmerged index stage is what the landed
// commit-writer admission already refuses on. RUNG (DESIGN section 4b), stated at its honest
// ceiling: this class moves from mitigatable — the regen gate detecting the bad transition a CI
// cycle after it exists — to MECHANICALLY PREVENTABLE at the merge boundary. It is NOT structural:
// the invalid state stays writable, because a resolver can still `git add` the provisional bytes
// without regenerating, and a clone that never converged the repo-local binding gets vanilla text
// merge. NEXT TRIGGER for the remaining climb, already a countable row rather than a new program:
// gunbc.commit_workflow commit_writer_binding_work — the DashboardAutocommit and heal-arm writers
// calling admit_commit_writer at their actual write boundary, whose unmerged-stage refusal is what
// turns this stop into one no writer can pass. Until those bindings land, an out-of-repository
// autocommit that stages and commits through the unmerged path defeats this refusal, and that is a
// stated residue, not an unnoticed one.

data generated_artifact_merge_driver_script_directory: String = ".githooks"

data generated_artifact_merge_driver_script_name: String = "generated-artifact-merge"

// THE PATH IS DERIVED FROM ITS PARTS, NOT PARSED BACK OUT OF ITSELF. A consumer that needs the
// directory to LIST it, and the entry name to look for inside that listing, would otherwise have to
// split this string on its last separator -- re-deriving by parsing something this module already
// knew structurally, where the parse can fail and the construction cannot. So the parts are the
// authority and the joined path is the projection. The path string is unchanged, which is the
// point: every existing consumer reads the same bytes.

data generated_artifact_merge_driver_script_path: String = concat(
  concat(generated_artifact_merge_driver_script_directory, "/"),
  generated_artifact_merge_driver_script_name
)

data generated_artifact_merge_driver_shell_program: String = "bash"

// The configured driver value invokes the script through `bash <path>` rather than executing it
// directly, so the binding does not depend on a file mode. A generated artifact is written by
// Filesystem.Write, which carries no executable-bit fact, and a driver that git could not spawn
// would fail the merge for a reason unrelated to the divergence it exists to report. The home is
// .githooks/ because that directory is already this repository's home for emitted repo-local Git
// integration scripts (the pre-commit hook there converges these same bindings); git invokes hooks
// by exact name, so a non-hook file beside them is inert. Placeholders are git's own: %O base, %A
// ours AND the result path git reads back, %B theirs, %P the pathname in the worktree.

fn generated_artifact_merge_driver_config_value_at(script_path: String) -> String {
  concat(
    concat(generated_artifact_merge_driver_shell_program, " "),
    concat(script_path, " %O %A %B %P")
  )
}

fn generated_artifact_merge_driver_config_value() -> String {
  generated_artifact_merge_driver_config_value_at(script_path: generated_artifact_merge_driver_script_path)
}

// THE REGENERATION COMMAND IS A PARAMETER, NOT AN IMPORT, AND THE REASON IS THE ACYCLICITY LAW
// RATHER THAN TASTE. Its single authority is gunbc.ci_spec ci_heal_author_commit_regen_command, and
// importing it here would close a real cycle: gunbc.generated_artifact reads this module for the
// artifact path, and ci_spec reaches gunbc.generated_artifact through the heal roster. So the
// consumer that already sits downstream of both — gunbc.generated_artifact_emit — supplies it, and
// the string is still authored in exactly one place. Restating it here as a literal would have been
// the second representation this document forbids; taking it as a parameter keeps one authority and
// an acyclic graph.

// STEP 3 IS NOT REDUNDANT WITH STEP 2. The regen route emits the seed by running a binary built FROM the seed, so a single pass can self-verify for the wrong reason: the binary that emitted the output predates the change it was emitting. The second build-and-verify is what makes the fixed point a claim about the merged authorities rather than about the stale binary.
// THE RECIPE NAMED regen_stage0 UNTIL 2026-08-20, AND THAT BINARY WAS DELETED AT THE ROOT BY THE REGEN CUT. A repair recipe is printed at exactly the moment an author is blocked, so a recipe naming a deleted producer is the same stranding this repository just closed inside required-regen itself: the stop is real, and the only move it offers does not exist. Measured cost: it was followed, verbatim, by the session that landed the producer repair. The steps now name the surviving route, whose first pass WRITES the candidate tree before adjudicating it (v2.workflow.required_regen required_regen_run), which is what makes step 2 a producer instruction rather than a request to re-run a check. NOT SWEPT HERE, and named rather than left to be rediscovered: other regen_stage0 citations survive in the corpus (v1_source_audit_witness_test, stage0_regen_convergence_real_execution_witness_test, stage0_crates and workspace_members generated-file headers, several plan carriers). They are a census of their own; this fix covers the one recipe that strands an author mid-merge. This recipe is the author-facing repair for an unmerged generated projection; the CI transport recipe is gunbc.proactive_verification_ledger spine_regen_recipe and is deliberately not restated here.
// STEP 3'S FIXED-POINT CALL CARRIES --source-root, AND ITS ABSENCE WAS THE SAME STRANDING ONE STEP LATER. claim_executor's `--required-regen-fixed-point` branch sits BELOW the binary's generic argument guard, so a run with no root exits 2 on `provide at least one --source-root` before the mode is ever reached -- the mode itself reads none, which is exactly why the omission looked harmless to write and could not be caught by reading the mode. The cost lands worst here: it is the LAST command of the wildcard arm every generated projection except the two heal-delegated rosters takes, so the author has already paid two builds and two regen passes when the recipe refuses. Found by a lane following this recipe verbatim, which is the only instrument that reads it.
fn generated_artifact_merge_driver_repair_steps(regen_command: String) -> List<String> {
  [
    concat("1. regenerate the derived projections: ", regen_command),
    "2. rebuild and run the seed emitter: cargo build --release --bin claim_executor && target/release/claim_executor --required-regen --source-root dag --source-root src/v2 (it writes the candidate tree under target/stage0-regen-candidate/src BEFORE it judges it; install every generated file it names into src/v1/stage0/src)",
    "3. rebuild from the installed seed and verify AGAIN: cargo build --release --bin claim_executor && target/release/claim_executor --required-regen --source-root dag --source-root src/v2 && target/release/claim_executor --required-regen-fixed-point --source-root dag --source-root src/v2",
    "   (the first pass runs a binary that predates the change it emits, so one pass can self-verify at divergence 0 for the wrong reason)",
  ]
}

// STEP 1 USED TO SAY "stage the driver-left bytes", AND THAT INSTRUCTION DELETED ROWS. The
// worktree bytes this driver leaves are the OURS side, so staging them commits this branch's
// rows OVER the base's and drops every row the base added since the merge base, adding none of
// this branch's own. The common diagnostic above already says so -- "Taking either side drops
// the other side's authority-derived content" -- and the route then instructed taking one.
// Measured 2026-09-04 across five heads that hit this driver on docs/design-failure-modes.md:
// the four that followed step 1 as written each committed a 97-row projection against a base of
// 98 and an authority of 99, silently dropping the same two rows; the one head that did not
// follow it was the only clean one. THE ROUTE INSTRUCTED THE ACTION THAT DISARMS THE GUARD --
// committing the provisional bytes MOVES THE MERGE BASE, after which this driver has nothing
// left to refuse, merge-tree reports clean, GitHub admits, and every instrument is green over a
// head that deletes rows. That is gunbc.recurring_failure_mode.guard_precondition_discharged_by
// _the_route_that_uses_it with the route itself as the discharging agent.
//
// TAKING THE BASE SIDE IS NOT A RESOLUTION AND IS NOT CLAIMED AS ONE. It leaves the tree
// authority-ahead-of-artifact by exactly this branch's own rows, which is the state heal exists
// to repair and which the generated-artifact gate can still see. What it removes is the DELETION,
// which nothing downstream can see at all.
fn generated_artifact_merge_driver_heal_repair_steps() -> List<String> {
  [
    "1. take the BASE side's projection verbatim -- git checkout <base-ref> -- $merged_path -- and do NOT stage the bytes sitting in your worktree: those are the OURS side, and staging them commits your rows over the base's, deleting every row the base added since the merge base",
    "2. VERIFY BY SET DIFFERENCE THAT NO ROW WENT DARK, never by count. The two projections carry DIFFERENT row identities -- a failure mode is a `slug` bullet, a rung drop is a `### Title — declared ...` heading -- so one extractor must name both, or the check reads zero rows on the file it cannot parse and reports a pass it never measured: rows() { sed -n -e 's/^- `\\([a-z0-9_]*\\)`.*/\\1/p' -e 's/^### \\(.*\\) — .*/\\1/p' | sort; }; comm -23 <(git show <base-ref>:$merged_path | rows) <(git show HEAD:$merged_path | rows) MUST BE EMPTY. A count tells you a number moved; only the difference names WHICH rows went dark, and the name is the whole finding",
    "3. DO NOT CHECK FOR CONFLICT MARKERS AND CONCLUDE ANYTHING: zero markers is exactly what this driver GUARANTEES on a refusal -- it leaves clean marker-free bytes and marks the path unmerged -- so a marker count reports that the DRIVER worked, never that its SUBJECT is intact. Read the index stages if you want the truth: stage 2 carries your rows and none of the base's, stage 3 the base's and none of yours",
    "4. finish the authority merge and push the branch; do not regenerate this projection locally",
    "5. heal-generated-artifacts derives it from the merged authorities, pushes the healed head, and dispatches revalidation; the generated-artifact gate must then agree on that exact head",
  ]
}

fn generated_artifact_merge_driver_diagnostic_lines(regen_command: String) -> List<String> {
  concat(
    ["  This path requires author regeneration before the merge can finish:"],
    generated_artifact_merge_driver_repair_steps(regen_command: regen_command)
  )
}

fn generated_artifact_merge_driver_common_diagnostic_lines() -> List<String> {
  [
    "[generated-artifact] GeneratedArtifactConcurrentDivergence: $merged_path",
    "  Both sides changed this generated projection since the merge base, so neither side's bytes are the projection of the MERGED authorities. Taking either side drops the other side's authority-derived content, and the tree is then authority-ahead-of-artifact with nothing to say so.",
    "  Git resolved nothing here. The path is left UNMERGED and the worktree file carries the ours side verbatim — no conflict markers.",
    "  Do NOT resolve these bytes by hand or pretend the provisional bytes are derived. Follow this path's declared repair route:",
  ]
}

fn emit_heal_path_case_pattern(paths: List<String>) -> String {
  join(paths, "|")
}

// THE ECHO IS DOUBLE-QUOTED BECAUSE THESE LINES ARE TEMPLATES: $merged_path must interpolate at
// the moment git runs the driver, so single quotes are not available and $ must stay active. Double
// quotes leave three other characters active, and one of them was live: the backtick. MEASURED, NOT
// REASONED -- the emitted heal recipe carries a sed program whose capture group is written between
// backticks, so bash ran `\\([a-z0-9_]*\\)` as a COMMAND SUBSTITUTION at echo time. Two "command not
// found" lines on stderr, and worse, the printed instruction came out with the capture group
// SILENTLY DELETED: an author pasting it got a sed that extracts nothing and a set difference that
// is empty because both sides are -- the vacuous pass this recipe exists to prevent, produced by
// the recipe itself. Escaping belongs here, where the quoting decision is made, rather than in each
// authored line, because a line author cannot see the quoting.
//
// THE RECIPE ALSO MAY NOT SPELL A POSITIONAL, AND THAT IS THIS SAME BOUNDARY READ FROM THE OTHER
// SIDE. $ stays active on purpose, so a $1 written inside a recipe line is the DRIVER's argv, not
// the reader's -- an extractor drafted as a shell function taking $1 rendered as `git show
// "O:docs/design-rung-drops.md"`, git's %O placeholder substituted into the instruction. Escaping
// it would only print a backslash, since the escaper doubles backslashes first. So a recipe line
// names $merged_path, which is the one variable the driver DEFINES, and pipes into a parameterless
// function instead of passing arguments to one.
// IT IS NOT gunbc.shell_bash_runner bash_escape_for_double_quotes AND THE DIFFERENCE IS ONE
// CHARACTER, NAMED SO IT IS NOT READ AS A FORK: that escaper also escapes $, which is exactly right
// for a literal line and exactly wrong for a template whose whole job is to name the path git handed
// the driver. Everything else -- backslash first, then quote, then backtick -- is the same rule.
fn emit_driver_stderr_quoted(line: String) -> String {
  let s1 = join(split(s: line, delimiter: "\\"), "\\\\")
  let s2 = join(split(s: s1, delimiter: "\""), "\\\"")
  join(split(s: s2, delimiter: "`"), "\\`")
}

fn emit_driver_stderr_echo(line: String) -> String {
  concat(concat("echo \"", emit_driver_stderr_quoted(line: line)), "\" >&2\n")
}

fn emit_driver_lines(lines: List<String>, indent: String) -> String {
  fold(lines, init: "", f: fn(acc, line) {
    concat(acc, concat(indent, emit_driver_stderr_echo(line: line)))
  })
}

fn emit_author_regeneration_repair(regen_command: String, indent: String) -> String {
  concat(
    emit_driver_lines(
      lines: generated_artifact_merge_driver_diagnostic_lines(regen_command: regen_command),
      indent: indent
    ),
    concat(indent, emit_driver_stderr_echo(line: "4. git add -- $merged_path"))
  )
}

fn expected_generated_artifact_merge_driver_sh(regen_command: String, heal_regenerated_paths: List<String>) -> String {
  concat(
    concat(
      "#!/usr/bin/env bash\n# GENERATED by dag/gunbc/generated_artifact_merge_driver.dag — DO NOT HAND-EDIT.\n",
      concat(
        "set -euo pipefail\n",
        "# git merge driver for merge=generated-artifact paths. argv: %O base, %A ours (result), %B theirs, %P pathname.\nmerged_path=\"$4\"\n"
      )
    ),
    concat(
      emit_driver_lines(lines: generated_artifact_merge_driver_common_diagnostic_lines(), indent: ""),
      if count(heal_regenerated_paths) == 0 {
        concat(
          emit_author_regeneration_repair(regen_command: regen_command, indent: ""),
          "exit 1\n"
        )
      } else {
        concat(
          concat(
            concat("case \"$merged_path\" in\n  ", concat(emit_heal_path_case_pattern(paths: heal_regenerated_paths), ")\n")),
            concat(
              emit_driver_lines(lines: generated_artifact_merge_driver_heal_repair_steps(), indent: "    "),
              "    ;;\n  *)\n"
            )
          ),
          concat(
            emit_author_regeneration_repair(regen_command: regen_command, indent: "    "),
            "    ;;\nesac\nexit 1\n"
          )
        )
      }
    )
  )
}
