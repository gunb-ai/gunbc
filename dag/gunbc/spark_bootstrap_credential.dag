module gunbc.spark_bootstrap_credential

import std.types { NonEmptyStr, String, Bool, List }
import product.placement_supply { HostIdentity }
import extdeps.cloud.gcp.secret_ref { SecretRef, HashPending }
import extdeps.systems.nvidia_dgx_spark_setup {
  OobeBootstrapAccessPoint,
  OobeCaptivePortalBehavior,
}
import gunbc.fleet_secrets_config { fleet_secrets_gcp_project }

// SPARK-PROVISION-0. The credential half of DGX Spark first-boot provisioning.
//
// THE HARD RULE, and why it is a rule rather than a preference: std.credentials.FactoryLogin
// stores published_password: NonEmptyStr. That is honest for OpenBMC, whose factory password
// the vendor PUBLISHES identically on every unit — writing 0penBmc into source discloses
// nothing that docs.nvidia.com equivalents have not already disclosed. A DGX Spark's hotspot
// password is printed on a per-unit sticker: it is a secret, it differs per device, and the
// only thing FactoryLogin's shape can do with it is put it in git. The name fits and the
// STORAGE does not, which is the DFS check DESIGN §2 asks for — check what a carrier stores,
// not what it is called. So the split below: SSID is an ordinary nonsecret identifier held
// inline, password is a SecretRef and never a value.
type BootstrapNetworkIdentity {
  ssid: NonEmptyStr
}

// The SSID is nonsecret, but it is also NOT KNOWN to this repository: like the password, it
// is printed on the per-unit sticker in the box, and neither unit's box has been opened. An
// authored placeholder would be a fabricated per-unit fact wearing the shape of an observed
// one — the same failure the update disposition refuses one module over, so the unread arm
// is explicit rather than a guessed default string.
type BootstrapNetworkStanding
  = BootstrapNetworkRead { identity: BootstrapNetworkIdentity }
  | BootstrapNetworkStickerUnread

type SparkFactoryBootstrap {
  access_point_identity: BootstrapNetworkStanding
  access_point_password_ref: SecretRef
  documented_surface: OobeBootstrapAccessPoint
}

fn spark_secret_ref(name: NonEmptyStr) -> SecretRef {
  SecretRef {
    project: fleet_secrets_gcp_project,
    secret: name,
    version: "latest",
    hash_state: HashPending,
  }
}

// Per-device administrator passwords. The operator never authors these: the secret is
// generated at provisioning time and the model carries only the reference, so there is no
// point in this repository at which an admin password exists as a value. The admin USERNAME
// is not minted here either — it is derived from the existing fleet operator principal in
// gunbc.fleet_posix_accounts (briansrls, uid/gid 1000), because a second spelling of the
// fleet's one operator account is the §3 nickname in its most literal form.
fn spark_admin_password_secret_name(host: HostIdentity) -> NonEmptyStr {
  concat(concat("spark-", host as String), "-admin-password") as NonEmptyStr
}

fn spark_admin_password_ref(host: HostIdentity) -> SecretRef {
  spark_secret_ref(name: spark_admin_password_secret_name(host: host))
}

// The bootstrap hotspot password's secret NAME is likewise derived from the one fleet
// identity rather than authored per unit — a second hand-spelled "srv5" is the same fork
// whether it appears in a host field or inside a secret name.
fn spark_bootstrap_password_secret_name(host: HostIdentity) -> NonEmptyStr {
  concat(concat("spark-", host as String), "-bootstrap-hotspot-password") as NonEmptyStr
}

fn spark_bootstrap_password_ref(host: HostIdentity) -> SecretRef {
  spark_secret_ref(name: spark_bootstrap_password_secret_name(host: host))
}

// The captive portal is a browser form, so the bootstrap password and the generated admin
// password are TYPED INTO A BROWSER. That is a narrower problem than "handle a secret", and
// claiming the existing SecretRef fetch path already covers it would be false: the fetch
// path governs how a credential is obtained, and says nothing about the trace, HAR, DOM
// snapshot, screenshot and console-capture surfaces an automated browser produces WHILE the
// credential is on screen. Those surfaces are the leak, and they are what this policy names.
type SensitiveEvidencePolicy
  = RetainNoDomNoHarNoTrace { retain_transition_result_only: Bool }

type SensitiveFieldIdentity = NonEmptyStr where brand("SensitiveFieldIdentity")

type SensitiveBrowserInputUse {
  secret_ref: SecretRef
  field_identity: SensitiveFieldIdentity
  evidence_policy: SensitiveEvidencePolicy
}

// What an actual run would have to report about itself. Every field is a fact about the
// run, not a promise about the code: an admission that read the POLICY instead of the
// OBSERVATION would be satisfiable by editing the policy while the run still leaked.
type SensitiveRunObservation {
  secret_present_in_argv: Bool
  secret_present_in_standard_streams: Bool
  trace_active_during_fill: Bool
  har_body_retained: Bool
  dom_snapshot_retained_after_fill: Bool
  screenshot_masks_password_controls: Bool
  credential_found_in_evidence_corpus_scan: Bool
}

type SensitiveInputRefusalCause
  = SecretReachedArgv
  | SecretReachedStandardStream
  | TraceActiveDuringSensitiveFill
  | HarBodyRetained
  | DomSnapshotRetainedAfterFill
  | ScreenshotDidNotMaskPasswordControls
  | CredentialFoundInEvidenceCorpus

// A refusal that found the credential already written into the evidence bundle cannot be
// discharged by refusing alone — the bytes exist. The disposition is therefore part of the
// verdict, and destruction is the only arm available to that one cause.
type EvidenceBundleDisposition
  = EvidenceBundleRetained
  | EvidenceBundleDestroyed

type SensitiveInputAdmission
  = SensitiveInputAdmitted { use: SensitiveBrowserInputUse }
  | SensitiveInputRefused {
      cause: SensitiveInputRefusalCause,
      evidence_disposition: EvidenceBundleDisposition
    }

fn sensitive_input_refusal_cause(obs: SensitiveRunObservation) -> SensitiveInputRefusalCause? {
  match obs.credential_found_in_evidence_corpus_scan {
    true => Present { value: CredentialFoundInEvidenceCorpus }
    false => match obs.secret_present_in_argv {
      true => Present { value: SecretReachedArgv }
      false => match obs.secret_present_in_standard_streams {
        true => Present { value: SecretReachedStandardStream }
        false => match obs.trace_active_during_fill {
          true => Present { value: TraceActiveDuringSensitiveFill }
          false => match obs.har_body_retained {
            true => Present { value: HarBodyRetained }
            false => match obs.dom_snapshot_retained_after_fill {
              true => Present { value: DomSnapshotRetainedAfterFill }
              false => match obs.screenshot_masks_password_controls {
                true => Absent
                false => Present { value: ScreenshotDidNotMaskPasswordControls }
              }
            }
          }
        }
      }
    }
  }
}

fn evidence_disposition_for(cause: SensitiveInputRefusalCause) -> EvidenceBundleDisposition {
  match cause {
    CredentialFoundInEvidenceCorpus => EvidenceBundleDestroyed
    SecretReachedArgv => EvidenceBundleRetained
    SecretReachedStandardStream => EvidenceBundleRetained
    TraceActiveDuringSensitiveFill => EvidenceBundleRetained
    HarBodyRetained => EvidenceBundleDestroyed
    DomSnapshotRetainedAfterFill => EvidenceBundleDestroyed
    ScreenshotDidNotMaskPasswordControls => EvidenceBundleDestroyed
  }
}

fn admit_sensitive_browser_input(
  use: SensitiveBrowserInputUse,
  observation: SensitiveRunObservation
) -> SensitiveInputAdmission {
  match sensitive_input_refusal_cause(obs: observation) {
    Present { value: cause } =>
      SensitiveInputRefused {
        cause: cause,
        evidence_disposition: evidence_disposition_for(cause: cause),
      }
    Absent => SensitiveInputAdmitted { use: use }
  }
}

data spark_bootstrap_evidence_policy: SensitiveEvidencePolicy = RetainNoDomNoHarNoTrace {
  retain_transition_result_only: true,
}
