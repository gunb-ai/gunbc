module gunbc.spark_bootstrap_credential

import std.types { String, NonEmptyStr, List, Bool }
import product.placement_supply { HostIdentity }
import extdeps.cloud.gcp.secret_ref { SecretRef, secret_ref_secret_resource }
import gunbc.fleet_secrets_config { fleet_secrets_gcp_project }
import gunbc.spark_managed_access_bootstrap {
  SparkManagedGrant,
  spark_managed_grant_wire,
  spark_managed_grant_sudoers_command,
  spark_operator_bootstrap_login,
}

// THE CREDENTIAL SEAM, which the authorization model has always described and nothing realized.
//
// `SparkBootstrapAuthorization` already carries OperatorBootstrapCredentialRequired, and its own
// secret_purpose says the credential is one-time, used through the modeled secret boundary, not
// retained, and not a serving requirement. That is the correct seam. What was missing was any path
// from it to execution: the grant installer emitted `sudo -n`, read the password demand, and
// rendered instructions for a human to reproduce the mutation by hand. So an authorization model, a
// secret-materialization model, a privileged plan, an installer and a workflow all existed, and the
// one absent thing was the JOIN between authorization and execution.
//
// The distinction that join encodes: the unavoidable external input is AUTHORIZATION, never MUTATION.
// Software cannot manufacture root authority from an account that lacks it, so someone supplies a
// credential once. Nobody should have to author host state by hand, which is what "run these sudo
// commands yourself" asks for -- and it is strictly worse than supplying a credential, because a
// hand-applied mutation is unobserved by the process that needed it.

// WHAT THE PLAN FREEZES IS A REFERENCE, NEVER BYTES. A lease names where the credential lives and
// what it may be used for; the password itself is materialized at apply and never enters a plan
// artifact, a workflow input, an argv, or a log. A carrier that could hold the secret would make
// leaking it a matter of someone printing a value.
type OperatorBootstrapCredentialLease sole_constructor {
  host: HostIdentity
  bootstrap_principal: NonEmptyStr
  secret: SecretRef
  authorized_purpose: NonEmptyStr
  attempt_identity: NonEmptyStr
}

// One secret per host, named for the host, because an administrator credential is a fact about a
// machine and a single fleet-wide password would make one compromise total.
fn spark_bootstrap_credential_secret(host: HostIdentity) -> SecretRef {
  SecretRef {
    project: fleet_secrets_gcp_project,
    secret: join(["spark-", host as String, "-bootstrap-admin"], "") as NonEmptyStr,
    version: "latest" as NonEmptyStr,
    hash_state: HashPending,
  }
}

fn spark_bootstrap_credential_lease(
  host: HostIdentity,
  grant: SparkManagedGrant,
  attempt_identity: NonEmptyStr,
) -> OperatorBootstrapCredentialLease {
  OperatorBootstrapCredentialLease {
    host: host,
    bootstrap_principal: spark_operator_bootstrap_login as NonEmptyStr,
    secret: spark_bootstrap_credential_secret(host: host),
    authorized_purpose: join([
      "install the narrow sudoers grant '", spark_managed_grant_wire(grant: grant) as String,
      "' (", spark_managed_grant_sudoers_command(grant: grant) as String,
      ") on ", host as String,
      " -- one-time, through the modeled secret boundary, not retained",
    ], "") as NonEmptyStr,
    attempt_identity: attempt_identity,
  }
}

// THE ARGV A ROOT CREDENTIAL MAY CARRY, closed by construction. The alternative -- widening
// RemoteArgv into a generic { argv, stdin } -- would reopen arbitrary script bodies through stdin
// under root, which is a far larger hole than the one being closed. So the privileged operation
// admits only the two commands this bootstrap needs, each named rather than passed through.
type AdmittedRootArgv
  = ValidateStagedSudoers { staged_path: NonEmptyStr }
  | InstallStagedSudoers { staged_path: NonEmptyStr, dropin_path: NonEmptyStr }

// `sudo -S` reads the password from stdin and `-p ''` suppresses the prompt so nothing resembling a
// credential is ever written to a terminal that might be captured. The `--` terminates option
// parsing, so a path can never be read as a flag.
fn admitted_root_argv_words(command: AdmittedRootArgv) -> List<String> {
  concat(
    ["sudo", "-S", "-p", "", "--"],
    match command {
      ValidateStagedSudoers { staged_path: p } => ["visudo", "-c", "-f", p as String]
      InstallStagedSudoers { staged_path: p, dropin_path: d } =>
        ["install", "-m", "0440", "-o", "root", "-g", "root", p as String, d as String]
    },
  )
}

fn admitted_root_argv_label(command: AdmittedRootArgv) -> String {
  match command {
    ValidateStagedSudoers { staged_path: _ } => "validate-staged-sudoers"
    InstallStagedSudoers { staged_path: _, dropin_path: _ } => "install-staged-sudoers"
  }
}

// THE LAYERS THE OPERATION ACTUALLY PRODUCES, kept distinct because their remedies differ and a
// single failure taxonomy would erase exactly the information that tells them apart. A credential
// that could not be fetched is an enrolment problem; a credential sudo rejected is a wrong password;
// a command that failed after sudo admitted it is a host problem. Collapsing these would send a
// reader to the wrong place three times out of four.
type PrivilegedStepOutcome
  = CredentialUnavailable { lease: OperatorBootstrapCredentialLease, cause: NonEmptyStr }
  | CredentialRejected { lease: OperatorBootstrapCredentialLease, stderr: String }
  | PrivilegedCommandFailed { command: AdmittedRootArgv, exit_code: Int, stderr: String }
  | PrivilegedCommandSucceeded { command: AdmittedRootArgv }

fn privileged_step_succeeded(outcome: PrivilegedStepOutcome) -> Bool {
  match outcome {
    PrivilegedCommandSucceeded { command: _ } => true
    PrivilegedCommandFailed { command: _, exit_code: _, stderr: _ } => false
    CredentialRejected { lease: _, stderr: _ } => false
    CredentialUnavailable { lease: _, cause: _ } => false
  }
}

// SUDO'S OWN DIAGNOSTIC SEPARATES A WRONG PASSWORD FROM A FAILED COMMAND, not the exit code: sudo
// exits 1 for both, and so does a malformed sudoers file. Reading the exit code alone would report
// a rejected credential as a broken host.
fn sudo_rejected_the_credential(stderr: String) -> Bool {
  string_contains(stderr, "incorrect password attempt")
    || string_contains(stderr, "Sorry, try again")
    || string_contains(stderr, "a password is required")
}

// THE RECEIPT NEVER CARRIES THE CREDENTIAL, only where it came from and what it was authorized for.
// The secret RESOURCE name is safe to print and is what an operator needs to fix an enrolment; the
// version's contents are not, and no arm of this renderer can reach them.
fn privileged_step_outcome_wire(outcome: PrivilegedStepOutcome) -> String {
  match outcome {
    CredentialUnavailable { lease: l, cause: c } =>
      join([
        "    privileged-step CREDENTIAL-UNAVAILABLE host=", l.host as String,
        " principal=", l.bootstrap_principal as String,
        " secret=", secret_ref_secret_resource(ref: l.secret),
        " purpose=", l.authorized_purpose as String,
        " cause=", c as String, "\n",
      ], "")
    CredentialRejected { lease: l, stderr: _ } =>
      join([
        "    privileged-step CREDENTIAL-REJECTED host=", l.host as String,
        " principal=", l.bootstrap_principal as String,
        " secret=", secret_ref_secret_resource(ref: l.secret),
        " -- sudo did not accept the materialized credential; the enrolled version is wrong or stale\n",
      ], "")
    PrivilegedCommandFailed { command: cmd, exit_code: code, stderr: err } =>
      join([
        "    privileged-step FAILED ", admitted_root_argv_label(command: cmd),
        " exit=", to_string(code), " stderr=", err, "\n",
      ], "")
    PrivilegedCommandSucceeded { command: cmd } =>
      join(["    privileged-step ok ", admitted_root_argv_label(command: cmd), "\n"], "")
  }
}
