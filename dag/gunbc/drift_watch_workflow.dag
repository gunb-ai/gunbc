import gunbc.repo.repo_identity { gunbc_default_branch_name }
import gunbc.ci.ci_layer_roots { witness_layer_roots }
import v2.workflow.gunbc_invoke_step_emit { gunbc_run_step_script }

// THE SCHEDULED, READ-ONLY HALF OF GENERATION: IT FINDS DRIFT AND REPAIRS NOTHING.
//
// Tier S (gunbc.heal_workflow) repairs what a pull request's own inputs break and pushes it back.
// Everything else the registry roster carries that is cheap to produce -- the workflows, the per-host
// runner sudoers, the githooks, .gitignore, .gitattributes and the fci1 context
// (gunbc.tier_o_artifact_emit tier_o_artifacts) -- drifts without any PR touching it: a runner-host
// row changes and the committed sudoers does not follow. This workflow reads the default branch on a
// schedule, compares each committed file with its authority's emission, and fails the run with one
// typed, located finding per drifted file, each naming its remedy (gunbc.instruments.tier_o_drift_check).
// It holds read-only permissions and writes nothing; a failed run is a signal, never a gate -- it is
// not a required context and is not triggered by a pull request or a merge_group.
// THE NAME, FROM THE REPOSITORY'S ROW. gunbc has exactly one profile row today and this emitter reads
// it, so "what this repository calls its drift watch" is one fact in one place rather than a literal here
// and a copy in a row kept equal by a witness.
data drift_watch_required_bins: List<String> = ["gunbc"]

data drift_watch_build_step_name: String = "Build the checker this job runs against the default branch"

fn drift_watch_checkout_step() -> Step {
  UsesStep {
    name: Present { value: "Checkout the default branch" },
    id: none,
    uses: checkout_action,
    with: Present {
      value: [
        kv(key: "fetch-depth", value: yaml_int(n: 1)),
        kv(key: "persist-credentials", value: yaml_bool(b: false))
      ]
    },
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn drift_watch_check_step(row: ProjectionDrift) -> Step {
  RunStep {
    name: Present { value: "Compare each Tier O artifact with its authority (read-only)" },
    id: none,
    // THE CHECK TARGET, FROM THE REPOSITORY'S ROW. The row's `check` is the same DagInvocation the
    // mirror's drift emitter reads, so one invocation answers both repositories' "are the committed bytes
    // what the authority emits" question; this emitter no longer reaches past the row for it.
    run: gunbc_run_step_script(
      source_roots: witness_layer_roots,
      entry: row.check.entry as String,
      function: row.check.function as String,
      claim_run: false,
      receipt_rel: none
    ),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

type DriftWatchBoundStep {
  step: Step
  role: StepCapabilityRole
  step_name: String
}

fn drift_watch_bound_steps(row: ProjectionDrift) -> List<DriftWatchBoundStep> {
  [
    DriftWatchBoundStep { step: drift_watch_checkout_step(), role: capability_neutral, step_name: "Checkout the default branch" },
    DriftWatchBoundStep { step: toolchain_home_isolation_step(), role: capability_neutral, step_name: "Isolate toolchain homes" },
    DriftWatchBoundStep {
      step: witness_floor_toolchain_step(),
      role: provides_only(capabilities: [CargoCapability, RustcCapability, RustfmtCapability, RustupCapability]),
      step_name: "Install Rust toolchain",
    },
    DriftWatchBoundStep {
      step: toolchain_pin_rustup_default_step(),
      role: consumes_only(capabilities: [RustupCapability, CargoCapability]),
      step_name: "Pin rustup default (isolated RUSTUP_HOME has no default toolchain)",
    },
    DriftWatchBoundStep {
      step: witness_floor_build_step(step_name: drift_watch_build_step_name, build_script: repo_self_build_command(bins: drift_watch_required_bins)),
      role: consumes_only(capabilities: [CargoCapability]),
      step_name: drift_watch_build_step_name,
    },
    DriftWatchBoundStep { step: drift_watch_check_step(row: row), role: capability_neutral, step_name: "Compare each Tier O artifact with its authority (read-only)" },
  ]
}

fn drift_watch_capability_closure_holds(row: ProjectionDrift) -> Bool {
  capability_closure_is_closed(
    v: workflow_job_capability_closure(
      steps: list_map(
        xs: drift_watch_bound_steps(row: row),
        f: fn(b) { CapabilityAnnotatedStep { step_name: b.step_name, role: b.role } },
      )
    ),
  )
}

data drift_watch_permissions: WorkflowPermissions = WorkflowPermissions {
  contents: Present { value: PermRead },
  pull_requests: none,
  issues: none,
  actions: none,
  id_token: none
}

fn drift_watch_job(row: ProjectionDrift) -> Job {
  Job {
    id: row.job_id as String,
    name: none,
    runner: ci_runner_target_spec(target: row.runner),
    environment: none,
    steps: list_map(xs: drift_watch_bound_steps(row: row), f: fn(b) { b.step }),
    needs: [],
    env: none,
    outputs: none,
    if_condition: none,
    timeout_minutes: Present { value: minute_count(m: row.timeout) },
    continue_on_error: none,
    concurrency: none,
    permissions: Present { value: drift_watch_permissions }
  }
}

// THE WORKFLOW, BUILT FROM THE ROW THE EMITTER WAS GIVEN. Name, job id, runner, cadence, timeout and
// check target are all reads of that one row; nothing here can be rendered for a repository that did not
// declare a drift watch, which is the difference between a mirror without a drift check and a mirror with
// a job that checks nothing on a machine the row never named.
fn drift_watch_workflow_of(row: ProjectionDrift, cron: CronSchedule) -> Workflow {
  Workflow {
  name: row.workflow_name as String,
  run_name: none,
  on: [Schedule { cron: cron }, WorkflowDispatch { inputs: [] }],
  concurrency: Present { value: ConcurrencyMappingQueueNotMax {
    group: "drift-watch",
    cancel_in_progress: Present { value: CancelInProgressBool { value: false } },
    explicit_single: none
  } },
  env: Present {
    value: [
      kv(key: "CARGO_TERM_COLOR", value: yaml_string(s: "always")),
      kv(key: "MALLOC_ARENA_MAX", value: yaml_string(s: "2"))
    ]
  },
  permissions: Present { value: drift_watch_permissions },
  jobs: [drift_watch_job(row: row)]
}
}

type DriftWatchWorkflowGenerationOutcome
  = DriftWatchWorkflowGenerated { content: String }
  | DriftWatchWorkflowGenerationRefused { reason: String }

data drift_watch_capability_refusal_reason: String = "REFUSED gunbc.drift_watch_workflow: the job's capability closure does not hold. No workflow yaml was emitted. Fix the step roles in drift_watch_bound_steps."

// WHAT THE ROW FORBIDS, BEFORE ANY OF THE ADMISSIONS RUN. The admissions are about the emitted job;
// this is about whether the row entitles the repository to have the job at all.


data drift_watch_no_job_refusal_reason: String = "REFUSED gunbc.drift_watch_workflow: this repository's RepositoryCiProfile carries no ProjectionDrift row, so there is no scheduled drift watch to emit. The absence is the repository's data, not this emitter's default."

data drift_watch_no_cron_refusal_reason: String = "REFUSED gunbc.drift_watch_workflow: the repository's ProjectionDrift row declares no cadence, so no schedule trigger is emitted; a checkout-driven drift check comes from gunbc.ci.repository_projection_drift_workflow instead."

// THE DRIFT EMITTER, REFUSING BEFORE IT RENDERS. Presence is read by matching, not by asking a Bool of
// an Optional: the no-row case and the row-without-cadence case are branches of the same match, so the
// fabricated fallbacks this module used to carry for each (a "no-drift-watch-declared" row, a midnight
// cron) no longer exist to be rendered. A repository with no drift watch gets a refusal naming its row; a
// repository whose drift check is checkout-driven gets no file from this emitter at all and takes its check
// from gunbc.ci.repository_projection_drift_workflow, which adds no schedule trigger.
fn expected_drift_watch_workflow_yml() -> DriftWatchWorkflowGenerationOutcome {
  match gunbc_drift_watch_job() {
    Absent => DriftWatchWorkflowGenerationRefused { reason: drift_watch_no_job_refusal_reason }
    Present { value: row } =>
      match row.cron {
        Absent => DriftWatchWorkflowGenerationRefused { reason: drift_watch_no_cron_refusal_reason }
        Present { value: cron } => emit_drift_watch_workflow(row: row, cron: cron)
      }
  }
}

fn emit_drift_watch_workflow(row: ProjectionDrift, cron: CronSchedule) -> DriftWatchWorkflowGenerationOutcome {
  match admit_workflow_checkout_refs(workflow: drift_watch_workflow_of(row: row, cron: cron), declared: []) {
    WorkflowCheckoutRefsRefused { refusals: crs } =>
      DriftWatchWorkflowGenerationRefused { reason: workflow_checkout_refs_refusal_reason(workflow_module: "gunbc.drift_watch_workflow", refusals: crs) }
    WorkflowCheckoutRefsAdmitted =>
      match admit_workflow_toolchain_homes(workflow: drift_watch_workflow_of(row: row, cron: cron)) {
        WorkflowToolchainHomeRefused { job_id: j, refusal: r } =>
          DriftWatchWorkflowGenerationRefused { reason: toolchain_home_refusal_reason(job_id: j, refusal: r) }
        WorkflowToolchainHomesAdmitted =>
          if !drift_watch_capability_closure_holds(row: row) {
            DriftWatchWorkflowGenerationRefused { reason: drift_watch_capability_refusal_reason }
          } else {
            match emit_yaml(v: project_workflow_to_yaml(workflow: drift_watch_workflow_of(row: row, cron: cron))) {
              EmittedYaml { text: t } => DriftWatchWorkflowGenerated { content: t }
              YamlEmitRefused { path: p, reason: r } => DriftWatchWorkflowGenerationRefused { reason: yaml_emit_refusal_text(module_path: "gunbc.drift_watch_workflow", path: p, reason: r) }
            }
          }
      }
  }
}
