fn enrolled_fingerprint_for(host: String) -> String? {
  fold(fleet_host_key_enrollments, init: none, f: fn(acc, k) {
    match acc {
      Present { value: _ } => acc
      _ => if (k.host as String) == host { Present { value: k.sha256_fingerprint } } else { none }
    }
  })
}

fn known_hosts_line(k: KnownHostKeyRow) -> String {
  join([k.endpoint, " ", k.key_type, " ", k.public_key_base64], "")
}

// The honest provenance label carried into the enroll receipt so a reader sees WHAT
// grounds each pinned key — trust-on-first-use vs an independent anchor — rather than
// reading "found" and inferring verification the row does not claim.
fn host_key_provenance_label(p: HostKeyEnrollmentProvenance) -> String {
  match p {
    ScannedFirstContact { scanned_from: _ } => "scanned-first-contact"
    IndependentlyAnchored { authority: _ } => "independently-anchored"
  }
}

data fleet_host_key_scan_receipt_path: String = "target/fleet-host-key-scan-receipt.txt"

// One host's scan: keyscan at the modeled endpoint (ed25519 — the key type both
// bold-eagle measurements and OpenSSH defaults lead with), then fingerprint the scanned
// line. Both captures ride the receipt VERBATIM with a per-host outcome label; a
// refusing scan is a typed absent line, never an empty fabrication.
// Post-apply verification. Hoisted out of the apply arms so both admitted arms share one route,
// and matched rather than read: the old code did concat("outcome=", trim(verify.stdout)), so a
// verify that REFUSED emitted the literal receipt line "outcome=" -- a fabricated plausible output
// standing where the answer was unknown, written into a receipt someone would later read as fact.
func verify_enrollment_outcome() -> String
  uses net: Network
{
  match run_shell_command_capture(
    command: posix_sh_program_command(script: "H=$(getent passwd \"$(whoami)\" | cut -d: -f6); grep -qxF \"$(cat target/fleet-authorized-key-line | head -1)\" \"$H/.ssh/authorized_keys\" && echo enrolled || echo ABSENT-after-apply"),
    transport: LocalExec,
  ) {
    ProcessOutputPresent { text: t } => concat("outcome=", std.algebra.trim(s: t))
    ProcessOutputAbsent => "outcome=UNKNOWN cause=verify admitted but printed nothing"
    ProcessRefused { exit_code: _, stderr: e } => join(["outcome=UNKNOWN cause=verify refused: ", std.algebra.trim(s: e)], "")
  }
}

// ProcessOutputPresent already means admitted-and-non-empty, so the old
// `scan.success && trim(scan.stdout) != ""` correlation is the variant itself rather than a
// condition the caller must remember to write. ProcessOutputAbsent is now a NAMED outcome --
// ssh-keyscan exiting 0 with no key is a different fact from ssh-keyscan failing, and the old
// shape reported both as "refused" with an empty cause.

// The old code fabricated a ShellCaptureResult here to stand in for a FILESYSTEM failure --
// a process result for something that was never a process, with an invented success: false.
// The coproduct makes that unwritable, which is the point: a write failure is not a process
// outcome and now has to be said in its own words.

fn scan_host_key_lines(host: String) -> String {
  let endpoint = fleet_probe_endpoint_for(host: host)
  match run_shell_command_capture(
    command: ssh_keyscan_command(host: endpoint, key_type: "ed25519", timeout_seconds: 5),
    transport: LocalExec,
  ) {
    ProcessOutputPresent { text: key_text } => {
      let key_file = join(["target/fleet-host-key-scan-", host, ".pub"], "")
      let w = Filesystem.Write(path: key_file, content: key_text)
      let fingerprint_text = if w.success {
        process_outcome_receipt_text(
          outcome: run_shell_command_capture(
            command: ssh_keygen_fingerprint_command(key_file: key_file),
            transport: LocalExec,
          )
        )
      } else {
        join(["(not computed: staging write refused: ", w.error, ")"], "")
      }
      join([
        "scan host=", host, " endpoint=", endpoint, " outcome=observed\n",
        "key ", std.algebra.trim(s: key_text), "\n",
        "fingerprint ", fingerprint_text, "\n",
      ], "")
    }
    ProcessOutputAbsent =>
      join([
        "scan host=", host, " endpoint=", endpoint, " outcome=no-key-offered cause=scan admitted but returned no key\n",
      ], "")
    ProcessRefused { exit_code: _, stderr: e } =>
      join([
        "scan host=", host, " endpoint=", endpoint, " outcome=refused cause=", std.algebra.trim(s: e), "\n",
      ], "")
  }
}

func fleet_host_key_scan_wet() -> ProcessExit
  uses net: Network
{
  let body = join(map(fleet_reach_probe_targets, h => scan_host_key_lines(host: h)), "")
  let w = Filesystem.Write(path: fleet_host_key_scan_receipt_path, content: body)
  if w.success {
    ExitSuccess
  } else {
    exit_failure(reason: concat("fleet_host_key_scan: receipt publication failed — ", w.error))
  }
}

data fleet_host_key_enroll_receipt_path: String = "target/fleet-host-key-enroll-receipt.txt"

// The ENROLL apply: registry rows -> a staged enrolled-ONLY known_hosts fragment -> a
// SCOPED ssh config that PINS the probe to that fragment for the fleet endpoints ->
// per-host independent readback (ssh-keygen -F against the fragment), which is the
// success criterion — never the write's exit code. Refuses loudly when the registry is
// empty: enrolling nothing must not read as enrolled.
//
// HOST-KEY ANCHOR PIN (host-key audit, witty-raven-412 / bold-eagle-107 cross-check,
// 2026-08-10): the earlier form APPENDED the fragment to $HOME/.ssh/known_hosts with no
// StrictHostKeyChecking, so ssh accepted a host key matching ANY line — including a
// pre-existing AMBIENT entry of unaudited provenance (OOBE / prior manual TOFU). That
// left every host-scoped observation anchored to whatever the runner account already
// trusted rather than to this registry: observed_principal/observed_short_hostname were
// genuine remote readbacks, but from a machine verified against something we do not
// control. The pin closes it non-destructively: a scoped `Host <fleet endpoints>` block
// sets UserKnownHostsFile to the enrolled-ONLY fragment and StrictHostKeyChecking yes, so
// for fleet hosts ssh consults ONLY this registry and REFUSES an unknown or mismatched
// key (a key change now trips ProbeHostKeyMismatch instead of silently passing). It is
// scoped to the fleet endpoints so non-fleet ssh (e.g. git) is untouched even on a
// durable HOME, and marker-guarded (`# gunbc-fleet-pin`) so a repeated run appends once.
// The enrolled baseline itself is ScannedFirstContact for srv1..srv4 (see
// HostKeyEnrollmentProvenance) — the pin lifts the anchor from ambient-unaudited to
// this-registry, NOT to an externally-verified key; that ceiling is carried by the
// provenance type, not hidden. The banked probe run 31346260819 PRE-DATES this pin and
// rode ambient known_hosts; the enrolled-anchored re-observe lands post-merge (probe
// jobs run on main/dispatch, skip on PR) in the same window as the host-receipt item.
//
// MEASURED CORRECTION (runs 31323572188): enrollment is NOT durable host state on a CI
// runner — GitHub Actions overrides HOME to a per-job temp directory, so a separate
// enroll job writes into an ephemeral HOME discarded at job end, and a probe job reads
// its OWN temp HOME. The registry is therefore materialized into the CURRENT process's
// HOME by fleet_host_key_enroll_apply, which the probe entry calls FIRST — enrollment
// rides with every probe run instead of pretending to persist.
func fleet_host_key_enroll_apply() -> String
  uses net: Network
{
  if length(fleet_host_key_enrollments) == 0 {
    "enroll outcome=refused cause=registry-empty\n"
  } else {
    let fragment = join(map(fleet_host_key_enrollments, k => concat(known_hosts_line(k: k), "\n")), "")
    let staged = "target/fleet-known-hosts-fragment"
    let endpoints = join(map(fleet_host_key_enrollments, k => k.endpoint), " ")
    let w = Filesystem.Write(path: staged, content: fragment)
    if w.success {
      let pin_cmd = join([
        "set -e; mkdir -p \"$HOME/.ssh\"; CFG=\"$HOME/.ssh/config\"; touch \"$CFG\"; ",
        "if ! grep -q gunbc-fleet-pin \"$CFG\"; then ",
        "( echo '# gunbc-fleet-pin'; echo 'Host ", endpoints, "'; ",
        "echo '  StrictHostKeyChecking yes'; ",
        "echo \"  UserKnownHostsFile $(pwd)/target/fleet-known-hosts-fragment\" ) >> \"$CFG\"; ",
        "fi; chmod 600 \"$CFG\"",
      ], "")
      let applied = run_shell_commands(
        commands: [ posix_sh_program_command(script: pin_cmd) ],
        transport: LocalExec,
      )
      match applied {
        ExitFailure { code: _, reason: why } => join(["enroll outcome=refused cause=", why, "\n"], "")
        ExitSuccess =>
          join(map(fleet_host_key_enrollments, k => {
            let f = run_shell_command_capture(
              command: ssh_keygen_known_hosts_find_command(host: k.endpoint, known_hosts_file: staged),
              transport: LocalExec,
            )
            join([
              "enroll host=", k.host as String, " endpoint=", k.endpoint,
              " provenance=", host_key_provenance_label(p: k.provenance),
              if process_outcome_admitted(outcome: f) { " readback=found-in-pinned-fragment" } else { " readback=ABSENT" }, "\n",
            ], "")
          }), "")
      }
    } else {
      join(["enroll outcome=refused cause=fragment-staging: ", w.error, "\n"], "")
    }
  }
}

func fleet_host_key_enroll_wet() -> ProcessExit
  uses net: Network
{
  let receipt = fleet_host_key_enroll_apply()
  let wr = Filesystem.Write(path: fleet_host_key_enroll_receipt_path, content: receipt)
  if wr.success {
    if string_contains(s: receipt, pattern: "outcome=refused") {
      exit_failure(reason: concat("fleet_host_key_enroll: apply refused — ", receipt))
    } else {
      ExitSuccess
    }
  } else {
    exit_failure(reason: concat("fleet_host_key_enroll: receipt publication failed — ", wr.error))
  }
}

// Ruling msg_43a8fd77 item 1: AUTHORIZED-KEY SELF-ENROLLMENT is self-service — a
// dispatched job runs AS the runner account on its host, so writing the fleet PUBLIC
// key into that account's ~/.ssh/authorized_keys needs no sudo and no secret access
// (the same self-install pattern as the timer). Idempotent by exact-line presence
// check (grep -qxF), never an appended duplicate; dir/file created 0700/0600 when
// absent. Asymmetry stated honestly: this grants fleet-key holders login as the runner
// account — the intended design (the fleet key IS fleet automation's credential), and
// reversible by removing the line. The receipt carries whoami — which is also the
// recorded EXISTENCE proof for the runner account on each host the job lands on.
data fleet_authorized_key_enroll_receipt_path: String = "target/fleet-authorized-key-enroll-receipt.txt"

// Re-grounded on the extdeps.ssh.keys authority (review 51659): this join re-spelled the line
// construction that module already owns, and hardcoded an algorithm token it already serializes.
fn fleet_automation_authorized_keys_line() -> String {
  ssh_public_key_line(k: fleet_automation_ssh_key)
}

// THE DEFECT THIS MIGRATION EXISTS FOR. The old test was `trim(check.stdout) == "present"`
// with no consultation of success, so a probe that FAILED produced "" -- not "present" -- and
// fell through to the else branch, which APPLIES. A refusal to read the file was therefore
// indistinguishable from the key being absent, and the remedy for the two states is opposite:
// absent means write it, unreadable means stop and say so. Matching the arms makes the third
// state impossible to fall through: a refusal now refuses instead of mutating the file.

func fleet_authorized_key_self_enroll_wet() -> ProcessExit
  uses net: Network
{
  let user = run_shell_command_capture(command: whoami_command(), transport: LocalExec)
  let hostname = run_shell_command_capture(command: hostname_read_command(), transport: LocalExec)
  let line = fleet_automation_authorized_keys_line()
  let staged = "target/fleet-authorized-key-line"
  let w = Filesystem.Write(path: staged, content: concat(line, "\n"))
  let outcome = if w.success {
    let check = run_shell_command_capture(
      command: posix_sh_program_command(script: "H=$(getent passwd \"$(whoami)\" | cut -d: -f6); grep -qxF \"$(cat target/fleet-authorized-key-line | head -1)\" \"$H/.ssh/authorized_keys\" 2>/dev/null && echo present || echo absent"),
      transport: LocalExec,
    )
    match check {
      ProcessRefused { exit_code: _, stderr: ce } =>
        join(["outcome=refused cause=presence-probe refused, not applying: ", std.algebra.trim(s: ce)], "")
      ProcessOutputAbsent =>
        "outcome=refused cause=presence-probe admitted but printed nothing, not applying"
      ProcessOutputPresent { text: ct } =>
    if std.algebra.trim(s: ct) == "present" {
      "outcome=already-present"
    } else {
      let apply = run_shell_command_capture(
        command: posix_sh_program_command(script: "H=$(getent passwd \"$(whoami)\" | cut -d: -f6); mkdir -p \"$H/.ssh\" && chmod 700 \"$H/.ssh\" && touch \"$H/.ssh/authorized_keys\" && chmod 600 \"$H/.ssh/authorized_keys\" && cat target/fleet-authorized-key-line >> \"$H/.ssh/authorized_keys\""),
        transport: LocalExec,
      )
      match apply {
        ProcessRefused { exit_code: _, stderr: ae } =>
          join(["outcome=refused cause=", std.algebra.trim(s: ae)], "")
        ProcessOutputPresent { text: _ } => verify_enrollment_outcome()
        ProcessOutputAbsent => verify_enrollment_outcome()
      }
    }
    }
  } else {
    join(["outcome=refused cause=staging: ", w.error], "")
  }
  let body = join([
    "authorized-key-self-enroll host=", process_outcome_receipt_text(outcome: hostname),
    " user=", process_outcome_receipt_text(outcome: user), " ", outcome, "\n",
  ], "")
  let wr = Filesystem.Write(path: fleet_authorized_key_enroll_receipt_path, content: body)
  if wr.success {
    if string_contains(s: outcome, pattern: "refused") || string_contains(s: outcome, pattern: "ABSENT-after-apply") {
      exit_failure(reason: concat("fleet_authorized_key_self_enroll: ", body))
    } else {
      ExitSuccess
    }
  } else {
    exit_failure(reason: concat("fleet_authorized_key_self_enroll: receipt publication failed — ", wr.error))
  }
}

// Ruling msg_43a8fd77 item 3 (A2), CROSSED by the operator 2026-08-09 (parent
// msg_72e2dcee): the GCP side is PROVISIONED and these are the observed facts, not a
// request. The service account is WIF-only (no keys exist and none may ever be minted);
// its sole grant is secretmanager.secretAccessor on the one named secret. The secret
// already held the fleet key as version 1 (ENABLED, created 2026-07-21T21:16:13Z;
// payload fingerprint matches the enrolled public key's SHA256:mGT7qJsh36VsVb8OPh3m8b
// r3oHedQHxRukRkW5P0CoQ) — version 1 is BLESSED as-is, nothing was minted, and
// consumers PIN versions/1, never the moving `latest` alias (SECRET-VERSION-LIFECYCLE-0
// wall: evidence must name a version). An OBSERVED PRIOR grant to
// serviceAccount:fleet-automation@gunbai-secrets.iam.gserviceaccount.com (July-era)
// exists on the same secret — recorded here, deliberately untouched. Rotation of the
// key to a version 2 is a REGISTERED FOLLOW-UP through the rotation kernel, not this
// lane. Closure evidence for A2 = the first dispatched probe run that authenticates.
type ProbeIdentitySecretAccessRequirement {
  secret_project: String
  secret_name: String
  pinned_version: String
  service_account: String
  service_account_unique_id: String
  wif_principal_set: String
  wif_provider_resource: String
  access: String
  observed_prior_grant: String
  consumer_jobs: List<String>
  materialization: String
}

data probe_identity_secret_access_requirement: ProbeIdentitySecretAccessRequirement = ProbeIdentitySecretAccessRequirement {
  secret_project: fleet_automation_ssh_privkey_secret.project as String,
  secret_name: fleet_automation_ssh_privkey_secret.secret as String,
  pinned_version: fleet_automation_privkey_version_segment(),
  service_account: "fleet-cloud-convergence@gunbai-secrets.iam.gserviceaccount.com",
  service_account_unique_id: "115150029926436834504",
  wif_principal_set: "principalSet://iam.googleapis.com/projects/582015116396/locations/global/workloadIdentityPools/github-actions/attribute.repository/gunb-ai/gunbc",
  wif_provider_resource: "projects/582015116396/locations/global/workloadIdentityPools/github-actions/providers/github-oidc",
