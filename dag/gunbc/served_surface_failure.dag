module gunbc.served_surface_failure

import std.types { NonEmptyStr, String, List, Int }
import extdeps.browser.error_presentation {
  BrowserProduct,
  BrowserPresentationProfile,
  BrowserHttpErrorBodyClass, EmptyHttpErrorBody, NonEmptyHttpErrorBody,
  BrowserHttpErrorPresentationRead,
  BrowserHttpErrorPresentationReadObserved,
  BrowserHttpErrorPresentationReadUnobserved,
  BrowserHttpErrorPresentation,
  BrowserReplacesHttpErrorResponse,
  BrowserRendersHttpErrorResponse,
  browser_presentation_product,
  browser_http_error_presentation,
}

type NoHttpResponseKind
  = NameResolutionRefused
  | TailnetUnreachable
  | Srv1HostDown
  | ConnectionRefused
  | ConnectionReset
  | ResponseTimedOut

type GunbcServeProcessAbsence
  = GunbcServeStopped
  | GunbcServeCrashed
  | GunbcServeOomKilled

type ClientPollFailure
  = ClientPollNetworkFailure
  | ClientPollHttpFailure { status: Int }
  | ClientPollUnreadableBody { status: Int }

type ServedSurfaceFailureState
  = DnsTailnetFailure { failure: NoHttpResponseKind }
  | TlsCertificateFailure
  | TailscaleServeProxyFailure { failure: NoHttpResponseKind }
  | GunbcServeProcessFailure { absence: GunbcServeProcessAbsence }
  | GunbcServeCompileWindow
  | GunbcServeApplication500 { body: NonEmptyStr }
  | ServedSurfaceClientPollingFailure { failure: ClientPollFailure }

type ServedSurfaceWireObservable
  = NoHttpResponse { failure: NoHttpResponseKind }
  | TlsHandshakeRefused
  | ProxyGeneratedBodyless502
  | GunbcTyped500Response { body: NonEmptyStr }
  | LoadedDocumentPollingRefused { failure: ClientPollFailure }

data served_surface_failure_chain_note: String = "THE HOPS STAY DISTINCT EVEN WHEN THE AUDIENCE CANNOT DISTINGUISH THEM. DNS/tailnet failure, TLS refusal, a missing tailscale listener, a missing gunbc-serve process, the 35-39 second pre-bind compile window, an application 500, and a post-load polling failure are seven causal states. gunbc process absence and compile window intentionally project to the SAME proxy-generated bodyless 502: their audience equivalence is derived here instead of erasing the operational distinction needed to fix them. Connection refused/reset, timeout, TLS refusal, bodyless proxy 502, typed bodied 500, and retained-document polling refusal remain distinct wire values. This is upstream of every frontend view; a view consumes the projection and does not reconstruct cause from text."

fn served_surface_wire_observable(state: ServedSurfaceFailureState) -> ServedSurfaceWireObservable {
  match state {
    DnsTailnetFailure { failure } => NoHttpResponse { failure: failure }
    TlsCertificateFailure => TlsHandshakeRefused
    TailscaleServeProxyFailure { failure } => NoHttpResponse { failure: failure }
    GunbcServeProcessFailure { absence: _ } => ProxyGeneratedBodyless502
    GunbcServeCompileWindow => ProxyGeneratedBodyless502
    GunbcServeApplication500 { body } => GunbcTyped500Response { body: body }
    ServedSurfaceClientPollingFailure { failure } => LoadedDocumentPollingRefused { failure: failure }
  }
}

type BodyOwnedSurface
  = GunbcTypedErrorBody
  | GunbcClientPollingRefusalSurface

type AudienceObservable
  = BrowserOwned
  | ProxyFabricated
  | BodyOwned { surface: BodyOwnedSurface }
  | AudienceObservableUnobserved { browser: BrowserProduct, reason: NonEmptyStr }

type BrowserFailureInterpretation
  = BrowserNetworkErrorInterpretation
  | BrowserHttpErrorInterpretation {
      body_class: BrowserHttpErrorBodyClass,
      read: BrowserHttpErrorPresentationRead,
    }
  | BrowserRetainsLoadedDocumentInterpretation

fn audience_observable_from_http_error_read(
  read: BrowserHttpErrorPresentationRead,
  body_class: BrowserHttpErrorBodyClass,
) -> AudienceObservable {
  match read {
    BrowserHttpErrorPresentationReadObserved { browser_build: _, presentation, receipt: _ } =>
      match presentation {
        BrowserReplacesHttpErrorResponse => BrowserOwned
        BrowserRendersHttpErrorResponse => match body_class {
          EmptyHttpErrorBody => ProxyFabricated
          NonEmptyHttpErrorBody => BodyOwned { surface: GunbcTypedErrorBody }
        }
      }
    BrowserHttpErrorPresentationReadUnobserved { product, reason } =>
      AudienceObservableUnobserved { browser: product, reason: reason }
  }
}

fn browser_failure_interpretation(
  wire: ServedSurfaceWireObservable,
  browser: BrowserPresentationProfile,
) -> BrowserFailureInterpretation {
  match wire {
    NoHttpResponse { failure: _ } => BrowserNetworkErrorInterpretation
    TlsHandshakeRefused => BrowserNetworkErrorInterpretation
    ProxyGeneratedBodyless502 => BrowserHttpErrorInterpretation {
      body_class: EmptyHttpErrorBody,
      read: browser_http_error_presentation(profile: browser, body_class: EmptyHttpErrorBody),
    }
    GunbcTyped500Response { body: _ } => BrowserHttpErrorInterpretation {
      body_class: NonEmptyHttpErrorBody,
      read: browser_http_error_presentation(profile: browser, body_class: NonEmptyHttpErrorBody),
    }
    LoadedDocumentPollingRefused { failure: _ } =>
      BrowserRetainsLoadedDocumentInterpretation
  }
}

fn audience_observable_from_browser_interpretation(
  interpretation: BrowserFailureInterpretation,
) -> AudienceObservable {
  match interpretation {
    BrowserNetworkErrorInterpretation => BrowserOwned
    BrowserHttpErrorInterpretation { body_class, read } =>
      audience_observable_from_http_error_read(read: read, body_class: body_class)
    BrowserRetainsLoadedDocumentInterpretation =>
      BodyOwned { surface: GunbcClientPollingRefusalSurface }
  }
}

fn audience_observable(
  state: ServedSurfaceFailureState,
  browser: BrowserPresentationProfile,
) -> AudienceObservable {
  let wire = served_surface_wire_observable(state: state)
  audience_observable_from_browser_interpretation(
    interpretation: browser_failure_interpretation(wire: wire, browser: browser))
}

type BrowserOwnedConstructionMover
  = DnsTailnetAvailabilityMover
  | CertificateValidityMover
  | TailscaleServeAvailabilityMover
  | BlueGreenServeFlipLane
  | BrowserCompatibilityMover

type AudienceObservableFixCeiling
  = ConstructionMoveRequired { mover: BrowserOwnedConstructionMover }
  | ProxyResponseConstructionRequired
  | BodyPresentationChangeAvailable { surface: BodyOwnedSurface }
  | BrowserObservationRequired { browser: BrowserProduct, reason: NonEmptyStr }

type OwnedSurfaceGuaranteeKind
  = DashboardProcessRestartContinuity
  | CandidateStartupContinuity
  | PlannedDeployContinuity
  | DynamicObserverUnavailableContinuity
  | TypedBackendRefusalContinuity

type RequiredFailureDomain
  = Srv1HostFailureDomain
  | TailscaledFailureDomain
  | TailnetDnsTlsFailureDomain

type ServedSurfaceContinuityBoundary
  = OwnedSurfaceGuarantee { guarantees: List<OwnedSurfaceGuaranteeKind> }
  | RequiresAnotherFailureDomain { domain: RequiredFailureDomain }

fn served_surface_continuity_boundary(
  state: ServedSurfaceFailureState,
) -> ServedSurfaceContinuityBoundary {
  match state {
    DnsTailnetFailure { failure } => match failure {
      Srv1HostDown => RequiresAnotherFailureDomain { domain: Srv1HostFailureDomain }
      _ => RequiresAnotherFailureDomain { domain: TailnetDnsTlsFailureDomain }
    }
    TlsCertificateFailure => RequiresAnotherFailureDomain { domain: TailnetDnsTlsFailureDomain }
    TailscaleServeProxyFailure { failure: _ } =>
      RequiresAnotherFailureDomain { domain: TailscaledFailureDomain }
    GunbcServeProcessFailure { absence: _ } => OwnedSurfaceGuarantee {
      guarantees: [DashboardProcessRestartContinuity],
    }
    GunbcServeCompileWindow => OwnedSurfaceGuarantee {
      guarantees: [CandidateStartupContinuity, PlannedDeployContinuity],
    }
    GunbcServeApplication500 { body: _ } => OwnedSurfaceGuarantee {
      guarantees: [TypedBackendRefusalContinuity],
    }
    ServedSurfaceClientPollingFailure { failure: _ } => OwnedSurfaceGuarantee {
      guarantees: [DynamicObserverUnavailableContinuity],
    }
  }
}

fn browser_owned_mover(state: ServedSurfaceFailureState) -> BrowserOwnedConstructionMover {
  match state {
    DnsTailnetFailure { failure: _ } => DnsTailnetAvailabilityMover
    TlsCertificateFailure => CertificateValidityMover
    TailscaleServeProxyFailure { failure: _ } => TailscaleServeAvailabilityMover
    GunbcServeProcessFailure { absence: _ } => BlueGreenServeFlipLane
    GunbcServeCompileWindow => BlueGreenServeFlipLane
    GunbcServeApplication500 { body: _ } => BrowserCompatibilityMover
    ServedSurfaceClientPollingFailure { failure: _ } => BrowserCompatibilityMover
  }
}

fn audience_observable_fix_ceiling(
  state: ServedSurfaceFailureState,
  observable: AudienceObservable,
) -> AudienceObservableFixCeiling {
  match observable {
    BrowserOwned => ConstructionMoveRequired { mover: browser_owned_mover(state: state) }
    ProxyFabricated => ProxyResponseConstructionRequired
    BodyOwned { surface } => BodyPresentationChangeAvailable { surface: surface }
    AudienceObservableUnobserved { browser, reason } =>
      BrowserObservationRequired { browser: browser, reason: reason }
  }
}

type ServedSurfaceAudienceObservableRow {
  failure: ServedSurfaceFailureState
  wire: ServedSurfaceWireObservable
  browser_interpretation: BrowserFailureInterpretation
  browser: BrowserProduct
  observable: AudienceObservable
  fix_ceiling: AudienceObservableFixCeiling
  continuity_boundary: ServedSurfaceContinuityBoundary
}

fn served_surface_audience_observable_row(
  failure: ServedSurfaceFailureState,
  browser: BrowserPresentationProfile,
) -> ServedSurfaceAudienceObservableRow {
  let wire = served_surface_wire_observable(state: failure)
  let interpretation = browser_failure_interpretation(wire: wire, browser: browser)
  let observable = audience_observable_from_browser_interpretation(
    interpretation: interpretation)
  ServedSurfaceAudienceObservableRow {
    failure: failure,
    wire: wire,
    browser_interpretation: interpretation,
    browser: browser_presentation_product(profile: browser),
    observable: observable,
    fix_ceiling: audience_observable_fix_ceiling(state: failure, observable: observable),
    continuity_boundary: served_surface_continuity_boundary(state: failure),
  }
}

fn served_surface_audience_observable_map(
  browser: BrowserPresentationProfile,
) -> List<ServedSurfaceAudienceObservableRow> {
  [
    served_surface_audience_observable_row(
      failure: DnsTailnetFailure { failure: NameResolutionRefused }, browser: browser),
    served_surface_audience_observable_row(
      failure: TlsCertificateFailure, browser: browser),
    served_surface_audience_observable_row(
      failure: TailscaleServeProxyFailure { failure: ConnectionRefused }, browser: browser),
    served_surface_audience_observable_row(
      failure: GunbcServeProcessFailure { absence: GunbcServeCrashed }, browser: browser),
    served_surface_audience_observable_row(
      failure: GunbcServeCompileWindow, browser: browser),
    served_surface_audience_observable_row(
      failure: GunbcServeApplication500 { body: "typed application error" as NonEmptyStr }, browser: browser),
    served_surface_audience_observable_row(
      failure: ServedSurfaceClientPollingFailure { failure: ClientPollNetworkFailure }, browser: browser),
  ]
}

data observable_fix_ceiling_note: String = "THE FIX CEILING IS DATA. BrowserOwned cannot be styled by the application because no application document controls those pixels; the only reachable move is construction at the failing hop. Process-absence and compile-window browser-owned cells name BlueGreenServeFlipLane as their mover, consuming the active blue/green lane rather than duplicating it. ProxyFabricated can move only by changing proxy response construction. BodyOwned is the only arm where the typed error body or persistent client refusal surface is available to application presentation. Unobserved blocks a fix claim on a browser observation first."

data audience_observable_three_fact_note: String = "EVERY MATRIX CELL RETAINS THREE FACTS. wire is the network or proxy response, browser_interpretation is the ordinary user-agent upstream's interpretation of that response, and observable is the user-visible surface derived from both. None is a synonym for another. Browser product labels select observed capability rows only; the interaction derivation has no Chrome/Firefox/Safari product branch. continuity_boundary states where this process can honestly promise continuity: owned dashboard/process/deploy/observer/backend refusals stay inside the responder domain, while srv1, tailscaled, and tailnet/DNS/TLS loss require another failure domain and therefore carry no local continuity claim."
