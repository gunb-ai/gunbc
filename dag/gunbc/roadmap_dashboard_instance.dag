fn dashboard_path_is_under(path: FilePath, root: FilePath) -> Bool {
  starts_with(s: path as String, prefix: concat(root as String, "/"))
}

fn dashboard_instance_owned_paths(instance: HostDashboardInstance) -> List<FilePath> {
  [
    instance.local_origin_root,
    instance.repo_root,
    instance.dispatch_worktree_root,
    instance.dispatch_attempt_state_root,
  ]
}

fn dashboard_instance_paths_are_owned(instance: HostDashboardInstance) -> Bool {
  all(
    dashboard_instance_owned_paths(instance: instance),
    path => dashboard_path_is_under(path: path, root: instance.instance_root),
  )
}

fn dashboard_instances_have_disjoint_owned_paths(
  a: HostDashboardInstance,
  b: HostDashboardInstance,
) -> Bool {
  all(
    dashboard_instance_owned_paths(instance: a),
    ap => all(
      dashboard_instance_owned_paths(instance: b),
      bp =>
        ap != bp
          && !dashboard_path_is_under(path: ap, root: bp)
          && !dashboard_path_is_under(path: bp, root: ap),
    ),
  )
}

type DashboardInstanceProvisionOp
  = DashboardHydrateControllerHistory {
      controller_repo: FilePath,
      history_remote: NonEmptyStr,
    }
  | DashboardPrepareGitBundle {
      controller_repo: FilePath,
      anchor_ref: NonEmptyStr,
    }
  | DashboardStageGitBundle {
      controller_repo: FilePath,
      staged_bundle: FilePath,
    }
  | DashboardEnsureDirectory { path: FilePath }
  | DashboardEnsureOwnershipMarker {
      path: FilePath,
      instance_id: NonEmptyStr,
    }
  | DashboardEnsureLocalOrigin {
      bundle: FilePath,
      origin: FilePath,
      source_ref: NonEmptyStr,
      publish_ref: NonEmptyStr,
    }
  | DashboardEnsureSourceRepo {
      origin: FilePath,
      repo: FilePath,
      anchor_ref: NonEmptyStr,
    }
  | DashboardEnsureService {
      instance_id: NonEmptyStr,
      binary: FilePath,
      workdir: FilePath,
      handler: NonEmptyStr,
      host: NonEmptyStr,
      port: Int,
      tmux_server: TmuxServerScope,
    }
  | DashboardVerifyProviderRuntime {
      executable: FilePath,
      state_root: FilePath,
    }
  | DashboardVerifyProviderAuth {
      executable: FilePath,
      state_root: FilePath,
    }
  | DashboardVerifyHealth { host: NonEmptyStr, port: Int }

fn dashboard_instance_provision_plan(instance: HostDashboardInstance) -> List<DashboardInstanceProvisionOp> {
  let controller_source_ops = match instance.source_seed {
    DashboardExistingRepo { anchor_ref: _ } => []
    DashboardGitBundle {
      controller_repo,
      staged_bundle: _,
      anchor_ref,
      history_remote,
    } => [
      DashboardHydrateControllerHistory {
        controller_repo: controller_repo,
        history_remote: history_remote,
      },
      DashboardPrepareGitBundle {
        controller_repo: controller_repo,
        anchor_ref: anchor_ref,
      },
    ]
  }
  let common = [
    DashboardEnsureDirectory { path: instance.instance_root },
    DashboardEnsureDirectory { path: instance.dispatch_worktree_root },
    DashboardEnsureDirectory { path: instance.dispatch_attempt_state_root },
    DashboardEnsureOwnershipMarker {
      path: dashboard_instance_ownership_marker_path(instance: instance),
      instance_id: instance.instance_id,
    },
  ]
  let source_ops = match instance.source_seed {
    DashboardExistingRepo { anchor_ref: _ } => []
    DashboardGitBundle {
      controller_repo,
      staged_bundle,
      anchor_ref,
      history_remote: _,
    } => [
      DashboardEnsureDirectory {
        path: dashboard_instance_child(root: instance.instance_root, child: "inbox"),
      },
      DashboardStageGitBundle {
        controller_repo: controller_repo,
        staged_bundle: staged_bundle,
      },
      DashboardEnsureLocalOrigin {
        bundle: staged_bundle,
        origin: instance.local_origin_root,
        source_ref: anchor_ref,
        publish_ref: instance.local_origin_publish_ref,
      },
      DashboardEnsureSourceRepo {
        origin: instance.local_origin_root,
        repo: instance.repo_root,
        anchor_ref: instance.dispatch_base_ref,
      },
    ]
  }
  concat(controller_source_ops, concat(common, concat(source_ops, [
    DashboardVerifyProviderRuntime {
      executable: dashboard_instance_provider_executable(instance: instance),
      state_root: dashboard_instance_provider_state_root(instance: instance),
    },
    DashboardVerifyProviderAuth {
      executable: dashboard_instance_provider_executable(instance: instance),
      state_root: dashboard_instance_provider_state_root(instance: instance),
    },
    DashboardEnsureService {
      instance_id: instance.instance_id,
      binary: instance.serve_binary,
      workdir: instance.repo_root,
      handler: instance.serve_function,
      host: instance.listen_host,
      port: instance.listen_port,
      tmux_server: instance.tmux_server,
    },
    DashboardVerifyHealth { host: instance.listen_host, port: instance.listen_port },
  ])))
}

type DashboardInstanceProvisionPlanRow {
  kind: NonEmptyStr
  target: String
  detail: String
}

fn dashboard_instance_provision_op_row(
  op: DashboardInstanceProvisionOp,
) -> DashboardInstanceProvisionPlanRow {
  match op {
    DashboardHydrateControllerHistory { controller_repo, history_remote } =>
      DashboardInstanceProvisionPlanRow {
        kind: "hydrate-controller-history" as NonEmptyStr,
        target: controller_repo as String,
        detail: join([
          "complete shallow history from named remote ",
          history_remote as String,
          "; no-op when already complete",
        ], ""),
      }
    DashboardPrepareGitBundle { controller_repo, anchor_ref } =>
      DashboardInstanceProvisionPlanRow {
        kind: "prepare-git-bundle" as NonEmptyStr,
        target: controller_repo as String,
        detail: join([
          anchor_ref as String,
          " -> temporary bundle -> empty bare repository import proof",
        ], ""),
      }
    DashboardStageGitBundle { controller_repo: _, staged_bundle } =>
      DashboardInstanceProvisionPlanRow {
        kind: "stage-git-bundle" as NonEmptyStr,
        target: staged_bundle as String,
        detail: "copy proven temporary bundle to .next, then atomically rename",
      }
    DashboardEnsureDirectory { path } =>
      DashboardInstanceProvisionPlanRow {
        kind: "ensure-directory" as NonEmptyStr,
        target: path as String,
        detail: "mkdir parents; idempotent",
      }
    DashboardEnsureOwnershipMarker { path, instance_id } =>
      DashboardInstanceProvisionPlanRow {
        kind: "ensure-ownership-marker" as NonEmptyStr,
        target: path as String,
        detail: instance_id as String,
      }
    DashboardEnsureLocalOrigin { bundle, origin, source_ref, publish_ref } =>
      DashboardInstanceProvisionPlanRow {
        kind: "ensure-local-origin" as NonEmptyStr,
        target: origin as String,
        detail: join([
          bundle as String,
          " ",
          source_ref as String,
          " -> ",
          publish_ref as String,
        ], ""),
      }
    DashboardEnsureSourceRepo { origin, repo, anchor_ref } =>
      DashboardInstanceProvisionPlanRow {
        kind: "ensure-source-repo" as NonEmptyStr,
        target: repo as String,
        detail: join([origin as String, " @ ", anchor_ref as String], ""),
      }
    DashboardEnsureService {
      instance_id,
      binary,
      workdir,
      handler,
      host,
      port,
      tmux_server: _,
    } =>
      DashboardInstanceProvisionPlanRow {
        kind: "ensure-service" as NonEmptyStr,
        target: instance_id as String,
        detail: join([
          binary as String,
          " · ",
          workdir as String,
          " · ",
          handler as String,
          " · ",
          host as String,
          ":",
          to_string(port),
        ], ""),
      }
    DashboardVerifyProviderRuntime { executable, state_root } =>
      DashboardInstanceProvisionPlanRow {
        kind: "verify-provider-runtime" as NonEmptyStr,
        target: executable as String,
        detail: join([
          "run --version through the modeled environment binding with CODEX_HOME=",
          state_root as String,
          "; require codex-cli identity",
        ], ""),
      }
    DashboardVerifyProviderAuth { executable, state_root } =>
      DashboardInstanceProvisionPlanRow {
        kind: "verify-provider-auth" as NonEmptyStr,
        target: state_root as String,
        detail: executable as String,
      }
    DashboardVerifyHealth { host, port } =>
      DashboardInstanceProvisionPlanRow {
        kind: "verify-health" as NonEmptyStr,
        target: join([host as String, ":", to_string(port)], ""),
        detail: "/instance.json must name the intended instance within the bounded readiness poll",
      }
  }
}

fn dashboard_instance_provision_plan_rows(
  instance: HostDashboardInstance,
) -> List<DashboardInstanceProvisionPlanRow> {
  map(
    dashboard_instance_provision_plan(instance: instance),
    op => dashboard_instance_provision_op_row(op: op),
  )
}

type DashboardInstanceObserved {
  root_present: Bool
  ownership_marker_present: Bool
  bundle_present: Bool
  origin_present: Bool
  source_present: Bool
  source_revision_observed: Bool
  source_revision_current: Bool
  source_revision_detail: String
  attempts_present: Bool
  attempt_state_present: Bool
  provider_runtime_ready: Bool
  provider_runtime_detail: String
  provider_authenticated: Bool
  provider_auth_detail: String
  service_present: Bool
  health_current: Bool
  production_untouched: Bool
  source_anchor_matches: Bool
}

data dashboard_source_revision_convergence_note: String = "Source convergence has two independent equalities. source_anchor_matches compares the target checkout HEAD with its target-local origin/base ref; that proves the owned checkout is cleanly resettable and prevents overwriting a divergent worktree. source_revision_current compares that HEAD with the exact controller CommitSha captured by preflight; that proves the running lab is this requested source revision rather than merely self-consistent at an older revision. A clean stale revision derives Apply, an unreadable revision refuses, and only both equalities can converge. The split is load-bearing: the first lab refresh after a controller rebase exposed that HEAD == old origin/main was true while HEAD == requested commit was false."

fn dashboard_source_seed_ready(
  instance: HostDashboardInstance,
  observed: DashboardInstanceObserved,
) -> Bool {
  match instance.source_seed {
    DashboardExistingRepo { anchor_ref: _ } => true
    DashboardGitBundle {
      controller_repo: _,
      staged_bundle: _,
      anchor_ref: _,
      history_remote: _,
    } =>
      observed.bundle_present
  }
}

type DashboardInstanceReconcile
  = DashboardInstanceConverged
  | DashboardInstanceApply { plan: List<DashboardInstanceProvisionOp> }
  | DashboardInstanceRefused { reason: NonEmptyStr }

fn dashboard_instance_reconcile(
  instance: HostDashboardInstance,
  observed: DashboardInstanceObserved,
) -> DashboardInstanceReconcile {
  if !dashboard_instance_paths_are_owned(instance: instance) {
    DashboardInstanceRefused {
      reason: "instance-owned paths escape the instance root" as NonEmptyStr,
    }
  } else if !observed.production_untouched {
    DashboardInstanceRefused {
      reason: "production isolation read-back failed" as NonEmptyStr,
    }
  } else if (observed.origin_present || observed.source_present)
      && !observed.ownership_marker_present {
    DashboardInstanceRefused {
      reason: "source or origin exists without the matching instance ownership marker" as NonEmptyStr,
    }
  } else if observed.source_present && !observed.source_anchor_matches {
    DashboardInstanceRefused {
      reason: "source repo exists at a different anchor; replacement is destructive and must be adjudicated" as NonEmptyStr,
    }
  } else if observed.source_present && !observed.source_revision_observed {
    DashboardInstanceRefused {
      reason: join([
        "source revision read-back refused: ",
        observed.source_revision_detail,
      ], "") as NonEmptyStr,
    }
  } else if observed.health_current
      && observed.root_present
      && observed.ownership_marker_present
      && dashboard_source_seed_ready(instance: instance, observed: observed)
      && observed.origin_present
      && observed.source_present
      && observed.attempts_present
      && observed.attempt_state_present
      && observed.provider_runtime_ready
      && observed.provider_authenticated
      && observed.service_present
      && observed.source_anchor_matches
      && observed.source_revision_current {
    DashboardInstanceConverged
  } else {
    DashboardInstanceApply { plan: dashboard_instance_provision_plan(instance: instance) }
  }
}

type DashboardInstanceRetractOp
  = DashboardStopService {
      instance_id: NonEmptyStr,
      tmux_server: TmuxServerScope,
    }
  | DashboardRefuseUnlessAttemptsEmpty { path: FilePath }
  | DashboardRemoveSourceRepo { path: FilePath }
  | DashboardRemoveLocalOrigin { path: FilePath }
  | DashboardPreserveSourceBundle { path: FilePath }

type DashboardInstanceRetract
  = DashboardInstanceRetractPlan { plan: List<DashboardInstanceRetractOp> }
  | DashboardInstanceRetractRefused { reason: NonEmptyStr }

data dashboard_instance_retract_note: String = "Retraction is modeled independently from provisioning and is deliberately narrower than recursive deletion. Existing-repo instances (including production) are not owned by this model and refuse retraction. Isolated bundle-seeded instances stop only their named service, refuse while any attempt worktree remains, remove the reproducible source clone and local origin, and preserve the staged bundle as the recovery anchor. Provider state is referenced secret state and is never in the retract plan."

fn dashboard_instance_retract_plan(
  instance: HostDashboardInstance,
) -> DashboardInstanceRetract {
  if !dashboard_instance_paths_are_owned(instance: instance) {
    DashboardInstanceRetractRefused {
      reason: "instance-owned paths escape the instance root" as NonEmptyStr,
    }
  } else {
    match instance.source_seed {
      DashboardExistingRepo { anchor_ref: _ } =>
        DashboardInstanceRetractRefused {
          reason: "existing-repo dashboard instances are not owned by the isolated-instance retractor" as NonEmptyStr,
        }
      DashboardGitBundle {
        controller_repo: _,
        staged_bundle,
        anchor_ref: _,
        history_remote: _,
      } =>
        DashboardInstanceRetractPlan { plan: [
          DashboardStopService {
            instance_id: instance.instance_id,
            tmux_server: instance.tmux_server,
          },
          DashboardRefuseUnlessAttemptsEmpty { path: instance.dispatch_worktree_root },
          DashboardRemoveSourceRepo { path: instance.repo_root },
          DashboardRemoveLocalOrigin { path: instance.local_origin_root },
          DashboardPreserveSourceBundle { path: staged_bundle },
        ] }
    }
  }
}
