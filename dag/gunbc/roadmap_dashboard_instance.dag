    actuation: DashboardActuating,
    provision_transport: DashboardLocalProvision,
  )
}

fn dashboard_path_is_under(path: std.types.FilePath, root: std.types.FilePath) -> Bool {
  starts_with(s: path as String, prefix: concat(root as String, "/"))
}

data owned_paths_omitted_the_binary_note: String = "serve_binary WAS MISSING FROM THE CANONICAL OWNED SET while live_deploy treated it as an Owned artifact and removed it on retract — two models of one fact, one saying owned-and-retractable and the other saying neither (review, 2026-07-30). The omission was correct while instances BORROWED production's binary: a path you do not own does not belong in your owned set. Making it instance-derived changed the answer and nothing propagated it here.\\n\\nThe consequence was concrete rather than tidy. dashboard_instances_have_disjoint_owned_paths reads this roster, so the disjointness check could not see the one path two instances actually shared — which is why the twin witness had to assert binary inequality as a SEPARATE conjunct rather than getting it from the canonical set. A check that needs a hand-written supplement to cover the thing it exists to cover is not covering it.\\n\\nIt belongs here for both instance shapes: srv1-live's /opt/gunbc/bin/gunbc sits under its instance_root /opt/gunbc, and an isolated lab's sits under its own root by derivation, so dashboard_instance_paths_are_owned's containment law holds for both without exception. The twin claim can now drop its supplemental conjunct and read the roster."

data owned_paths_split_by_scope_note: String = "ONE ROSTER USED TO CARRY TWO KINDS OF MEMBER, and the disjointness law could not be right about both once production slots began sharing dispatch state. The roster mixed paths that are the instance's own FOOTPRINT — its origin, its source tree, its binary — with paths that hold DISPATCH EVIDENCE, and then applied a single rule to the union: every path sits under instance_root, and no two instances share any path.\\n\\nThat rule is exactly right for the footprint and exactly wrong for host-shared dispatch state, whose whole purpose is to be the same path in two slots. Weakening the law to admit overlap would have been the cheap fix and the wrong one: overlap is precisely the hazard owned_paths_omitted_the_binary_note records, where a lab's retract would have deleted the binary production was executing. So the roster splits and each half keeps the law that is true of it, rather than one roster keeping a law that is true of neither.\\n\\nFootprint paths keep BOTH original laws at full strength, for every instance and every scope. Dispatch-state paths get the law their scope declares: instance-owned must sit under instance_root and stay disjoint from every other instance, which is the old behaviour preserved for labs; host-shared must EQUAL the layout rows and therefore agree with every other host-shared instance on the same host. Agreement is a stronger statement than the absence of a check — it goes red if a production slot is given its own attempt-state root, which is the regression this change exists to prevent recurring."

fn dashboard_instance_footprint_paths(instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance) -> List<std.types.FilePath> {
  [
    instance.local_origin_root,
    instance.repo_root,
    instance.serve_binary,
  ]
}

fn dashboard_instance_dispatch_worktree_root(instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance) -> std.types.FilePath {
  match instance.dispatch_state_scope {
    DispatchStateInstanceOwned { worktree_child, attempt_state_child: _ } =>
      dashboard_instance_child(root: instance.instance_root, child: worktree_child)
    DispatchStateHostShared { worktree_root, attempt_state_root: _ } => worktree_root
  }
}

fn dashboard_instance_dispatch_attempt_state_root(instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance) -> std.types.FilePath {
  match instance.dispatch_state_scope {
    DispatchStateInstanceOwned { worktree_child: _, attempt_state_child } =>
      dashboard_instance_child(root: instance.instance_root, child: attempt_state_child)
    DispatchStateHostShared { worktree_root: _, attempt_state_root } => attempt_state_root
  }
}

fn dashboard_instance_dispatch_state_paths(instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance) -> List<std.types.FilePath> {
  [
    dashboard_instance_dispatch_worktree_root(instance: instance),
    dashboard_instance_dispatch_attempt_state_root(instance: instance),
  ]
}

fn dashboard_paths_all_under(paths: List<std.types.FilePath>, root: std.types.FilePath) -> Bool {
  all(paths, path => dashboard_path_is_under(path: path, root: root))
}

fn dashboard_instance_paths_are_owned(instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance) -> Bool {
  dashboard_paths_all_under(
    paths: dashboard_instance_footprint_paths(instance: instance),
    root: instance.instance_root,
  )
    && match instance.dispatch_state_scope {
      DispatchStateInstanceOwned { worktree_child: _, attempt_state_child: _ } =>
        dashboard_paths_all_under(
          paths: dashboard_instance_dispatch_state_paths(instance: instance),
          root: instance.instance_root,
        )
      DispatchStateHostShared { worktree_root: _, attempt_state_root: _ } => true
    }
}

fn dashboard_paths_are_disjoint(a: List<std.types.FilePath>, b: List<std.types.FilePath>) -> Bool {
  all(
    a,
    ap => all(
      b,
      bp =>
        ap != bp
          && !dashboard_path_is_under(path: ap, root: bp)
          && !dashboard_path_is_under(path: bp, root: ap),
    ),
  )
}

fn dashboard_instances_have_disjoint_owned_paths(
  a: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  b: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
) -> Bool {
  dashboard_paths_are_disjoint(
    a: dashboard_instance_footprint_paths(instance: a),
    b: dashboard_instance_footprint_paths(instance: b),
  )
    && dashboard_instances_dispatch_state_is_consistent(a: a, b: b)
}

data dispatch_state_agreement_is_the_law_note: String = "THE REPLACEMENT FOR BLANKET DISJOINTNESS IS AGREEMENT, NOT ABSENCE. Two production slots on one host must resolve dispatch state to the SAME roots, and that is a checkable claim rather than a hole where a check used to be — a slot given its own attempt-state root fails this, which is precisely the shape that put a teardown of live dispatch evidence on the per-push path.\\n\\nTHE DIFFERENT-HOST ARM IS EXPLICIT BECAUSE THE FIRST CUT GOT IT WRONG (codex review 47405). This note already argued that two host-shared instances on different machines describe different directories and that disjointness is not the question their scope asks — and then the code routed exactly that pair into the disjointness branch anyway, where srv1 and srv2 layout paths, which gunbc_host_layout_note states are byte-identical by convention, would compare EQUAL and refuse a legitimate configuration. The prose was right and the fold contradicted it, which is the §3 stale-citation class turned inward: no live pair exercised it, so it stayed green. The arm now returns a valid outcome by name rather than by falling through.\\n\\nThe remaining pairings say which is which rather than defaulting: a host-shared instance beside an instance-owned one is a production slot beside a lab, and the lab exists to keep its dispatch evidence away from production, so disjointness is exactly right there.\\n\\nThis is the pairwise law. The population law it serves — every production slot on a host agrees with every other — is what the witness asserts over the declared slots, because a pairwise predicate cannot quantify over a roster it does not receive."

fn dashboard_instances_dispatch_state_is_consistent(
  a: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  b: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
) -> Bool {
  match a.dispatch_state_scope {
    DispatchStateInstanceOwned { worktree_child: _, attempt_state_child: _ } =>
      dashboard_paths_are_disjoint(
        a: dashboard_instance_dispatch_state_paths(instance: a),
        b: dashboard_instance_dispatch_state_paths(instance: b),
      )
    DispatchStateHostShared { worktree_root: a_worktree, attempt_state_root: a_attempts } =>
      match b.dispatch_state_scope {
        DispatchStateInstanceOwned { worktree_child: _, attempt_state_child: _ } =>
          dashboard_paths_are_disjoint(
            a: dashboard_instance_dispatch_state_paths(instance: a),
            b: dashboard_instance_dispatch_state_paths(instance: b),
          )
        DispatchStateHostShared { worktree_root: b_worktree, attempt_state_root: b_attempts } =>
          if a.host_identity == b.host_identity {
            a_worktree == b_worktree && a_attempts == b_attempts
          } else {
            true
          }
      }
  }
}

data serve_binary_ensure_note: String = "NOTHING INSTALLED A LAB'S BINARY, BECAUSE LABS USED TO BORROW PRODUCTION'S. Before serve_binary became instance-derived, every isolated instance resolved it to the host layout's /opt/gunbc/bin/gunbc — the file production is executing. That is why the plan had no install step: there was nothing to install, only something to point at. It is also exactly the hazard the twin witness caught, since ServeBinary is an Owned deployment artifact and a lab retract would have removed the binary out from under the running service.\\n\\nSo closing that hazard opened this gap, and the two belong in one change. An instance that owns its binary needs a step that puts one there, or the dashboard apply refuses at target-dependencies against a path only it was ever going to create — a chain that terminates in nobody's responsibility.\\n\\nIt copies rather than builds. The controller's already-built target/release/gunbc is the source, staged and moved into place through the same atomic copy the source bundle uses, so a half-written binary is never observable at the destination. Building is deliberately NOT modeled here: a provisioner that silently compiled would make apply's duration and its toolchain requirements invisible, and a stale or missing build should refuse with the path it looked for rather than quietly producing one that differs from what the operator tested."

data provider_state_root_ensure_note: String = "THE MODEL VERIFIED AUTH AGAINST A DIRECTORY IT NEVER CREATED. DashboardVerifyProviderRuntime and DashboardVerifyProviderAuth both read the provider state root, and nothing in the plan brought it into existence — so on a fresh host the only command that can populate it fails first: `CODEX_HOME=... codex login` exits with 'that path does not exist' before any OAuth begins. The operator hits a CLI error in their own terminal instead of a typed refusal telling them what to do, which is the gap this variant closes (operator, 2026-07-30: 'i think this stuff needs to be in the workflow').\\n\\nIT IS A SEPARATE VARIANT BECAUSE ITS OWNERSHIP AND TEARDOWN DIFFER, and reusing DashboardEnsureDirectory would state neither. The state root lives OUTSIDE the instance root, so it can never be an owned path — dashboard_instance_paths_are_owned requires containment, and the roster it checks deliberately excludes this. And it must never be torn down: the directory holds user-authored OAuth state, so removing it on retract would destroy credentials the deploy is forbidden to carry in the first place. dashboard_retract_preserves_recovery_anchor_and_provider_state already asserts that preservation; the type now says it too.\\n\\nWhat this creates is a DIRECTORY, never a credential. dashboard_instance_note's rule stands unchanged — provider credentials remain pre-existing user-authored state, referenced and never copied into a deployment payload. An empty state root is infrastructure; the secret inside it is not, and this op cannot produce one."

type DashboardInstanceProvisionOp
  = DashboardHydrateControllerHistory {
      controller_repo: std.types.FilePath,
      history_remote: std.types.NonEmptyStr,
    }
  | DashboardPrepareGitBundle {
      controller_repo: std.types.FilePath,
      anchor_ref: std.types.NonEmptyStr,
    }
  | DashboardStageGitBundle {
      controller_repo: std.types.FilePath,
      staged_bundle: std.types.FilePath,
    }
  | DashboardEnsureDirectory { path: std.types.FilePath }
  | DashboardEnsureProviderStateRoot { path: std.types.FilePath }
  | DashboardEnsureServeBinary {
      controller_repo: std.types.FilePath,
      built_binary: std.types.FilePath,
      path: std.types.FilePath,
    }
  | DashboardEnsureOwnershipMarker {
      path: std.types.FilePath,
      instance_id: std.types.NonEmptyStr,
    }
  | DashboardEnsureLocalOrigin {
      bundle: std.types.FilePath,
      origin: std.types.FilePath,
      source_ref: std.types.NonEmptyStr,
      publish_ref: std.types.NonEmptyStr,
    }
  | DashboardEnsureSourceRepo {
      origin: std.types.FilePath,
      repo: std.types.FilePath,
      anchor_ref: std.types.NonEmptyStr,
    }
  | DashboardEnsureService {
      instance_id: std.types.NonEmptyStr,
      binary: std.types.FilePath,
      workdir: std.types.FilePath,
      handler: std.types.NonEmptyStr,
      host: std.types.NonEmptyStr,
      port: Int,
      tmux_server: extdeps.tmux.TmuxServerScope,
    }
  | DashboardVerifyProviderRuntime {
      executable: std.types.FilePath,
      state_root: std.types.FilePath,
    }
  | DashboardVerifyProviderAuth {
      executable: std.types.FilePath,
      state_root: std.types.FilePath,
    }
  | DashboardVerifyHealth { host: std.types.NonEmptyStr, port: std.types.Port }

fn dashboard_instance_provision_plan(instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance) -> List<DashboardInstanceProvisionOp> {
  let controller_source_ops = match instance.source_seed {
    DashboardExistingRepo { anchor_ref: _ } => []
    DashboardGitBundle {
      controller_repo,
      staged_bundle: _,
      anchor_ref,
      history_remote,
    } => [
      DashboardHydrateControllerHistory {
        controller_repo: controller_repo,
        history_remote: history_remote,
      },
      DashboardPrepareGitBundle {
        controller_repo: controller_repo,
        anchor_ref: anchor_ref,
      },
    ]
  }
  let common = [
    DashboardEnsureDirectory { path: instance.instance_root },
    DashboardEnsureDirectory { path: dashboard_instance_dispatch_worktree_root(instance: instance) },
    DashboardEnsureDirectory { path: dashboard_instance_dispatch_attempt_state_root(instance: instance) },
    DashboardEnsureProviderStateRoot {
      path: dashboard_instance_provider_state_root(instance: instance),
    },
    DashboardEnsureServeBinary {
      controller_repo: dashboard_instance_controller_workdir(instance: instance),
      built_binary: dashboard_instance_child(
        root: dashboard_instance_controller_workdir(instance: instance),
        child: "target/release/gunbc",
      ),
      path: instance.serve_binary,
    },
    DashboardEnsureOwnershipMarker {
      path: dashboard_instance_ownership_marker_path(instance: instance),
      instance_id: instance.instance_id,
    },
  ]
  let source_ops = match instance.source_seed {
    DashboardExistingRepo { anchor_ref: _ } => []
    DashboardGitBundle {
      controller_repo,
      staged_bundle,
      anchor_ref,
      history_remote: _,
    } => [
      DashboardEnsureDirectory {
        path: dashboard_instance_child(root: instance.instance_root, child: "inbox"),
      },
      DashboardStageGitBundle {
        controller_repo: controller_repo,
        staged_bundle: staged_bundle,
      },
      DashboardEnsureLocalOrigin {
        bundle: staged_bundle,
        origin: instance.local_origin_root,
        source_ref: anchor_ref,
        publish_ref: instance.local_origin_publish_ref,
      },
      DashboardEnsureSourceRepo {
        origin: instance.local_origin_root,
        repo: instance.repo_root,
        anchor_ref: instance.dispatch_base_ref,
      },
    ]
  }
  concat(controller_source_ops, concat(common, concat(source_ops, concat(
    dashboard_instance_provider_verification_ops(instance: instance),
    [
      DashboardEnsureService {
        instance_id: instance.instance_id,
        binary: instance.serve_binary,
        workdir: instance.repo_root,
        handler: instance.serve_function,
        host: instance.listen_host,
        port: instance.listen_port,
        tmux_server: instance.tmux_server,
      },
      DashboardVerifyHealth { host: instance.listen_host, port: instance.listen_port },
    ],
  ))))
}

fn dashboard_instance_provider_verification_ops(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
) -> List<DashboardInstanceProvisionOp> {
  match dashboard_instance_provider_executable(instance: instance) {
    Present { value: executable } => [
      DashboardVerifyProviderRuntime {
        executable: executable,
        state_root: dashboard_instance_provider_state_root(instance: instance),
      },
      DashboardVerifyProviderAuth {
        executable: executable,
        state_root: dashboard_instance_provider_state_root(instance: instance),
      },
    ]
    Absent => []
  }
}

type DashboardInstanceProvisionPlanRow {
  kind: std.types.NonEmptyStr
  target: String
  detail: String
}

fn dashboard_instance_provision_op_row(
  op: DashboardInstanceProvisionOp,
) -> DashboardInstanceProvisionPlanRow {
  match op {
    DashboardHydrateControllerHistory { controller_repo, history_remote } =>
      DashboardInstanceProvisionPlanRow {
        kind: "hydrate-controller-history" as std.types.NonEmptyStr,
        target: controller_repo as String,
        detail: join([
          "complete shallow history from named remote ",
          history_remote as String,
          "; no-op when already complete",
        ], ""),
      }
    DashboardPrepareGitBundle { controller_repo, anchor_ref } =>
      DashboardInstanceProvisionPlanRow {
        kind: "prepare-git-bundle" as std.types.NonEmptyStr,
        target: controller_repo as String,
        detail: join([
          anchor_ref as String,
          " -> temporary bundle -> empty bare repository import proof",
        ], ""),
      }
    DashboardStageGitBundle { controller_repo: _, staged_bundle } =>
      DashboardInstanceProvisionPlanRow {
        kind: "stage-git-bundle" as std.types.NonEmptyStr,
        target: staged_bundle as String,
        detail: "copy proven temporary bundle to .next, then atomically rename",
      }
    DashboardEnsureDirectory { path } =>
      DashboardInstanceProvisionPlanRow {
        kind: "ensure-directory" as std.types.NonEmptyStr,
        target: path as String,
        detail: "mkdir parents; idempotent",
      }
    DashboardEnsureProviderStateRoot { path } =>
      DashboardInstanceProvisionPlanRow {
        kind: "ensure-provider-state-root" as std.types.NonEmptyStr,
        target: path as String,
        detail: "mkdir parents so the provider login has somewhere to write; never torn down, never populated by the deploy",
      }
    DashboardEnsureServeBinary { controller_repo: _, built_binary, path } =>
      DashboardInstanceProvisionPlanRow {
        kind: "ensure-serve-binary" as std.types.NonEmptyStr,
        target: path as String,
        detail: join([
          "copy the controller's built seed from ",
          built_binary as String,
          "; atomic move, never a build",
        ], ""),
      }
    DashboardEnsureOwnershipMarker { path, instance_id } =>
      DashboardInstanceProvisionPlanRow {
        kind: "ensure-ownership-marker" as std.types.NonEmptyStr,
        target: path as String,
        detail: instance_id as String,
      }
    DashboardEnsureLocalOrigin { bundle, origin, source_ref, publish_ref } =>
      DashboardInstanceProvisionPlanRow {
        kind: "ensure-local-origin" as std.types.NonEmptyStr,
        target: origin as String,
        detail: join([
          bundle as String,
          " ",
          source_ref as String,
          " -> ",
          publish_ref as String,
        ], ""),
      }
    DashboardEnsureSourceRepo { origin, repo, anchor_ref } =>
      DashboardInstanceProvisionPlanRow {
        kind: "ensure-source-repo" as std.types.NonEmptyStr,
        target: repo as String,
        detail: join([origin as String, " @ ", anchor_ref as String], ""),
      }
    DashboardEnsureService {
      instance_id,
      binary,
      workdir,
      handler,
      host,
      port,
      tmux_server: _,
    } =>
      DashboardInstanceProvisionPlanRow {
        kind: "ensure-service" as std.types.NonEmptyStr,
        target: instance_id as String,
        detail: join([
          binary as String,
          " · ",
          workdir as String,
          " · ",
          handler as String,
          " · ",
          host as String,
          ":",
          to_string(port),
        ], ""),
      }
    DashboardVerifyProviderRuntime { executable, state_root } =>
      DashboardInstanceProvisionPlanRow {
        kind: "verify-provider-runtime" as std.types.NonEmptyStr,
        target: executable as String,
        detail: join([
          "run --version through the modeled environment binding with CODEX_HOME=",
          state_root as String,
          "; require codex-cli identity",
        ], ""),
      }
    DashboardVerifyProviderAuth { executable, state_root } =>
      DashboardInstanceProvisionPlanRow {
        kind: "verify-provider-auth" as std.types.NonEmptyStr,
        target: state_root as String,
        detail: executable as String,
      }
    DashboardVerifyHealth { host, port } =>
      DashboardInstanceProvisionPlanRow {
        kind: "verify-health" as std.types.NonEmptyStr,
        target: join([host as String, ":", to_string(port)], ""),
        detail: "/instance.json must name the intended instance within the bounded readiness poll",
      }
  }
}

fn dashboard_instance_provision_plan_rows(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
) -> List<DashboardInstanceProvisionPlanRow> {
  map(
    dashboard_instance_provision_plan(instance: instance),
    op => dashboard_instance_provision_op_row(op: op),
  )
}

data observation_refusal_channel_note: String = "A REFUSED PROBE IS NOT A NEGATIVE FACT, and every Bool in this record used to say it was. dashboard_target_path_present reduced its probe to .success, so an SSH transport refusal, a missing test binary, or an unreachable host all arrived here as 'the path is absent' — and the same collapse fed provider_runtime_ready and provider_authenticated, so a broken transport reported as an unauthenticated provider. The SSH arm even HAD the distinction: typed_argv_probe_over_ssh returns TypedArgvExecRefused with a reason, which was thrown away converting to the two-state carrier (review, 2026-07-30).\\n\\nThat is the fabricated-verdict class this session kept producing at every layer — a missing cargo reported as rustfmt drift, an idle socket as a malformed request, a foreign server's health as convergence. Here it is worse than a wrong label, because the wrong label is ACTIONABLE: an operator told the state root is absent creates it, when the truth is that nothing could be observed at all.\\n\\nThe refusals ride ALONGSIDE the fields rather than converting each Bool to a tri-state, because a transport failure does not invalidate one field — it invalidates the whole observation. Ten probes feed one record; if any could not run, no Bool here is evidence of anything, and consumers must refuse on the channel BEFORE reading a single one. Per-field tri-states would let a caller keep trusting the nine that happened to answer, which is exactly the reasoning that makes a partial observation look complete."

type DashboardInstanceObserved {
  observation_refusals: List<String>
  root_present: Bool
  ownership_marker_present: Bool
  bundle_present: Bool
  origin_present: Bool
  source_present: Bool
  source_revision_observed: Bool
  source_revision_current: Bool
  source_revision_detail: String
  attempts_present: Bool
  attempt_state_present: Bool
  provider_runtime_ready: Bool
  provider_runtime_detail: String
  provider_authenticated: Bool
  provider_auth_detail: String
  service_present: Bool
  health_current: Bool
  production_untouched: Bool
  source_anchor_matches: Bool
}

data dashboard_source_revision_convergence_note: String = "Source convergence has two independent equalities. source_anchor_matches compares the target checkout HEAD with its target-local origin/base ref; that proves the owned checkout is cleanly resettable and prevents overwriting a divergent worktree. source_revision_current compares that HEAD with the exact controller CommitSha captured by preflight; that proves the running lab is this requested source revision rather than merely self-consistent at an older revision. A clean stale revision derives Apply, an unreadable revision refuses, and only both equalities can converge. The split is load-bearing: the first lab refresh after a controller rebase exposed that HEAD == old origin/main was true while HEAD == requested commit was false."

fn dashboard_source_seed_ready(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  observed: DashboardInstanceObserved,
) -> Bool {
  match instance.source_seed {
    DashboardExistingRepo { anchor_ref: _ } => true
    DashboardGitBundle {
      controller_repo: _,
      staged_bundle: _,
      anchor_ref: _,
      history_remote: _,
    } =>
      observed.bundle_present
  }
}

type DashboardInstanceReconcile
  = DashboardInstanceConverged
  | DashboardInstanceApply { plan: std.types.List<DashboardInstanceProvisionOp> }
  | DashboardInstanceRefused { reason: std.types.NonEmptyStr }

// THE REFUSAL CHANNEL IS READ BEFORE ANY FIELD, because after a refused probe no field in the record is evidence. Every branch below reasons from Bools — origin present, source present, health current — and each of those is false when the probe could not run just as surely as when the thing is genuinely missing. Reaching them with an unread refusal means deriving a plan from an observation that never happened.\n\nThe order is the whole point. Placing this check second, after the ownership law, would already be too late for anything the ownership law consults; placing it first means a transport failure produces one refusal naming what could not be observed, rather than a confident Apply plan built to create files that may well already exist.\n\nIt refuses rather than retrying or widening. A probe that could not run is not a slow probe, and a reconcile that responded by planning the superset — create everything, it is safe if it already exists — would be the absorbing fallback wearing a plausible justification.
fn dashboard_instance_reconcile(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  observed: DashboardInstanceObserved,
) -> DashboardInstanceReconcile {
  if count(observed.observation_refusals) > 0 {
    DashboardInstanceRefused {
      reason: join([
        "observation incomplete; no field is evidence: ",
        join(observed.observation_refusals, " | "),
      ], "") as std.types.NonEmptyStr,
    }
  } else if !dashboard_instance_paths_are_owned(instance: instance) {
    DashboardInstanceRefused {
      reason: "instance-owned paths escape the instance root" as std.types.NonEmptyStr,
    }
  } else if !observed.production_untouched {
    DashboardInstanceRefused {
      reason: "production isolation read-back failed" as std.types.NonEmptyStr,
    }
  } else if (observed.origin_present || observed.source_present)
      && !observed.ownership_marker_present {
    DashboardInstanceRefused {
      reason: "source or origin exists without the matching instance ownership marker" as std.types.NonEmptyStr,
    }
  } else if observed.source_present && !observed.source_anchor_matches {
    DashboardInstanceRefused {
      reason: "source repo exists at a different anchor; replacement is destructive and must be adjudicated" as std.types.NonEmptyStr,
    }
  } else if observed.source_present && !observed.source_revision_observed {
    DashboardInstanceRefused {
      reason: join([
        "source revision read-back refused: ",
        observed.source_revision_detail,
      ], "") as std.types.NonEmptyStr,
    }
  } else if observed.health_current
      && observed.root_present
      && observed.ownership_marker_present
      && dashboard_source_seed_ready(instance: instance, observed: observed)
      && observed.origin_present
      && observed.source_present
      && observed.attempts_present
      && observed.attempt_state_present
      && observed.provider_runtime_ready
      && observed.provider_authenticated
      && observed.service_present
      && observed.source_anchor_matches
      && observed.source_revision_current {
    DashboardInstanceConverged
  } else {
    DashboardInstanceApply { plan: dashboard_instance_provision_plan(instance: instance) }
  }
}

type DashboardInstanceRetractOp
  = DashboardStopService {
      instance_id: std.types.NonEmptyStr,
      tmux_server: extdeps.tmux.TmuxServerScope,
    }
  | DashboardRefuseUnlessAttemptsEmpty { path: std.types.FilePath }
  | DashboardRemoveSourceRepo { path: std.types.FilePath }
  | DashboardRemoveLocalOrigin { path: std.types.FilePath }
  | DashboardPreserveSourceBundle { path: std.types.FilePath }

type DashboardInstanceRetract
  = DashboardInstanceRetractPlan { plan: std.types.List<DashboardInstanceRetractOp> }
  | DashboardInstanceRetractRefused { reason: std.types.NonEmptyStr }

data dashboard_instance_retract_note: String = "Retraction is modeled independently from provisioning and is deliberately narrower than recursive deletion. Existing-repo instances (including production) are not owned by this model and refuse retraction. Isolated bundle-seeded instances stop only their named service, refuse while any attempt worktree remains, remove the reproducible source clone and local origin, and preserve the staged bundle as the recovery anchor. Provider state is referenced secret state and is never in the retract plan."

fn dashboard_instance_retract_plan(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
) -> DashboardInstanceRetract {
  if !dashboard_instance_paths_are_owned(instance: instance) {
    DashboardInstanceRetractRefused {
      reason: "instance-owned paths escape the instance root" as std.types.NonEmptyStr,
    }
  } else {
    match instance.source_seed {
      DashboardExistingRepo { anchor_ref: _ } =>
        DashboardInstanceRetractRefused {
          reason: "existing-repo dashboard instances are not owned by the isolated-instance retractor" as std.types.NonEmptyStr,
        }
      DashboardGitBundle {
        controller_repo: _,
        staged_bundle,
        anchor_ref: _,
        history_remote: _,
      } =>
        DashboardInstanceRetractPlan { plan: [
          DashboardStopService {
            instance_id: instance.instance_id,
            tmux_server: instance.tmux_server,
          },
          DashboardRefuseUnlessAttemptsEmpty { path: dashboard_instance_dispatch_worktree_root(instance: instance) },
          DashboardRemoveSourceRepo { path: instance.repo_root },
          DashboardRemoveLocalOrigin { path: instance.local_origin_root },
          DashboardPreserveSourceBundle { path: staged_bundle },
        ] }
    }
  }
}
