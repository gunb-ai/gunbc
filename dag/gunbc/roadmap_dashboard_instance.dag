module gunbc.roadmap_dashboard_instance


type DashboardActuationPosture
  = DashboardObserveOnly
  | DashboardActuating

type DashboardProvisionTransport
  = DashboardLocalProvision
  | DashboardSshProvision { host: std.types.NonEmptyStr }

type DashboardSourceSeed
  = DashboardExistingRepo { anchor_ref: std.types.NonEmptyStr }
  | DashboardGitBundle {
      controller_repo: std.types.FilePath,
      staged_bundle: std.types.FilePath,
      anchor_ref: std.types.NonEmptyStr,
      history_remote: std.types.NonEmptyStr,
    }

data provider_state_requires_admission_note: String = "THE ADMITTED BINDING IS A FIELD, NOT A CHECK SOMEONE MAY RUN. gunbc.provider_account models which account a credential belongs to and how many concurrent sessions its persistence behaviour can carry, and its admission function refuses the combinations that cannot hold — but this record used to carry only a root and an executable, so every instance in the fleet was built along a path that admission never saw. The model said the invalid architecture was unwritable while the constructor two files away wrote it four times.\\n\\nAdding the binding as a required field is what closes it. There is no default and no second constructor, so a provider state cannot come into existence without naming an admitted binding, and the account a deployment uses is no longer a bare path that happens to end in a directory name — it is a selection the admission agreed to.\\n\\nThe four declarations below bind ONE session each, which is what a serve process is, and take the total single-session path admitted_single_session_binding provides. That path cannot refuse, because a single session is admissible under every discipline resting on evidence; what it cannot do is accept an unobserved credential, since EvidencedSharingDiscipline has no unknown arm to pass it. A deployment wanting more than one session goes through the partial admission and must match its refusal."

type DashboardProviderStateBinding
  = DashboardExistingProviderState {
      root: std.types.FilePath,
      executable: std.types.FilePath?,
      binding: gunbc.provider_account.AdmittedAccountBinding,
    }

data dispatch_state_scope_note: String = "WHOSE STATE THE DISPATCH ROOTS ARE IS A DECLARATION, NOT AN INFERENCE, and it is the axis this record was missing when blue/green landed. An instance owns two roots a dispatch WRITES — the worktree root and the published attempt-state root — and until now both were derived from instance_root for every instance, which silently answered a question nobody had asked: that dispatch evidence belongs to the SLOT.\\n\\nFor an isolated lab that answer is right and load-bearing. A lab exists to be disjoint from production, and handing it the host-shared roots would let one lab's apply or retract disturb another lab's live worktrees and published attempts. For a production blue/green SLOT the same answer is wrong, and wrong in two directions at once. The cutover retracts the retiring slot, so slot-scoped roots put a teardown of live dispatch evidence on the per-push path — the empty-directory wall then refuses, correctly, and every main push reds (measured 2026-08-01: seven consecutive deploy jobs, alternating by candidate, both directions failing once each slot had served long enough to accumulate evidence). And because each slot reads its OWN roots, a flip moves the dashboard to a process that cannot see the attempts dispatched under its predecessor.\\n\\nThe defect is not that either answer is wrong. It is that ONE derivation answered for both kinds of instance, so the two could not disagree. Making it a field with no default means an instance cannot come into existence without stating which it is, and the two laws below read the declaration rather than guessing from instance_root, instance_id, or actuation posture — none of which separate a lab from a production slot, since labs and slots are both DashboardActuating.\\n\\nTHIS DOES NOT REOPEN isolated_instance_own_binary_note (operator ruling, 2026-07-30). That ruling is about serve_binary and its argument is mutual exclusion of PROCESSES: a lab testing a new seed must not overwrite the binary production executes, and retract tears Owned members down. Nothing here touches serve_binary, which stays instance-derived for labs and instance-declared for production under both scopes. The two rulings partition cleanly because they are about different members with opposite sharing requirements — the binary must NOT be shared because a retract would delete a running program, and the dispatch state MUST be shared across production slots because a flip would otherwise orphan live agent sessions."

data dispatch_state_scope_carries_its_roots_note: String = "THE SCOPE AND THE ROOTS TRAVEL TOGETHER, because as three independent fields they could disagree and the model could only NOTICE that afterwards (codex review 47405, #7637 follow-up). The first cut declared a bare two-variant scope beside dispatch_worktree_root and dispatch_attempt_state_root, so a slot could be labelled host-shared while carrying roots derived from its own instance root — exactly the state the change existed to eliminate. The tell was in the evidence: the RED witness had to CONSTRUCT that combination to prove the law caught it, which is DESIGN §4b rung two, mechanically preventable, standing where rung four was available.\\n\\nCarrying the roots in the variant moves it up. An instance-owned scope carries the CHILD NAMES its roots hang under, and the roots are derived beneath instance_root; a host-shared scope carries the layout roots themselves. There is no third field to contradict either, so the MISLABELLED slot — host-shared in name while its roots derive from its own instance root — has no representation rather than a check that finds it.\n\nBE EXACT ABOUT WHAT THIS DOES NOT CLOSE, because overstating a rung is worse than sitting at it (DESIGN §4b rung honesty). A host-shared variant still carries two free FilePath values, so a production slot CAN be authored with roots that are not the layout rows. That state remains representable and dashboard_instances_dispatch_state_is_consistent is what refuses it — mechanically preventable, not structurally impossible — and a_production_slot_keeping_its_own_dispatch_state_is_refused is the live discriminating red proving the law still executes. What DID climb is the instance-owned side, which carries child names only and therefore cannot reach outside its instance root at all. Next-rung trigger, so this is a tracked stall rather than a silent one: host-shared roots DERIVED from a total host-identity-to-layout lookup instead of carried. Dissolve-on feature:host-dispatch-roots-derived.\\n\\nTHE CHILD NAMES ARE CARRIED RATHER THAN FIXED, and that is not incidental: production hangs its worktrees under dispatch-worktrees while isolated labs use attempts. A uniform derivation would have silently RENAMED production's live worktree root — the kind of quiet migration a refactor produces when it assumes regularity the corpus does not have."

type DispatchStateScope
  = DispatchStateInstanceOwned {
      worktree_child: std.types.NonEmptyStr,
      attempt_state_child: std.types.NonEmptyStr,
    }
  | DispatchStateHostShared {
      worktree_root: std.types.FilePath,
      attempt_state_root: std.types.FilePath,
    }

type HostDashboardInstance {
  instance_id: std.types.NonEmptyStr
  host_identity: std.types.NonEmptyStr
  provision_parent_root: std.types.FilePath
  instance_root: std.types.FilePath
  local_origin_root: std.types.FilePath
  local_origin_publish_ref: std.types.NonEmptyStr
  repo_root: std.types.FilePath
  dispatch_base_ref: std.types.NonEmptyStr
  dispatch_state_scope: DispatchStateScope
  execution_environment: gunbc.roadmap_execution_contract.DispatchHostEnvironment
  provider_state: DashboardProviderStateBinding
  serve_binary: std.types.FilePath
  serve_function: std.types.NonEmptyStr
  listen_host: std.types.NonEmptyStr
  listen_port: std.types.Port
  tmux_server: extdeps.tmux.TmuxServerScope
  actuation: DashboardActuationPosture
  provision_transport: DashboardProvisionTransport
  source_seed: DashboardSourceSeed
}

data dashboard_instance_note: String = "A dashboard is an explicit host instance, not an ambient serve process. One value moves the source repository, local Git origin, attempt-worktree root, semantic execution-capability realizations, provider state binding, tmux server, listen address, handler entrypoint, and actuation posture together. Selection is by the serve entry function that receives this value; no environment variable may replace one projection independently. Production uses the user's default tmux server for compatibility. Labs and previews use named tmux servers and roots disjoint from production. Provider credentials remain pre-existing user-authored state and are referenced, never copied into a deployment payload. Capability realizations name exact executable paths and identity probes; observe-only means absence refuses admission until a separate capability-specific provisioner exists, never that generic Ensure guesses an installer."

data srv1_dashboard_live_id: std.types.NonEmptyStr = "srv1-live" as std.types.NonEmptyStr
data srv1_dashboard_green_id: std.types.NonEmptyStr = "srv1-green" as std.types.NonEmptyStr
data srv1_dashboard_lab_id: std.types.NonEmptyStr = "srv1-lab-codex-feedback-v0" as std.types.NonEmptyStr
data srv2_dashboard_preview_id: std.types.NonEmptyStr = "srv2-preview-codex-feedback-v0" as std.types.NonEmptyStr

data srv1_dashboard_lab_root: std.types.FilePath = "/home/briansrls/.local/share/gunbc-dashboard-instances/codex-provider-feedback-v0" as std.types.FilePath
data srv2_dashboard_preview_root: std.types.FilePath = "/home/briansrls/.local/share/gunbc-dashboard-instances/codex-provider-feedback-preview-v0" as std.types.FilePath
data dashboard_environment_binding_executable: std.types.FilePath = "/usr/bin/env" as std.types.FilePath

fn dashboard_instance_child(root: std.types.FilePath, child: String) -> std.types.FilePath {
  join([root as String, "/", child], "") as std.types.FilePath
}

fn dashboard_instance_provider_state_root(instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance) -> std.types.FilePath {
  match instance.provider_state {
    DashboardExistingProviderState { root, executable: _, binding: _ } => root
  }
}

fn dashboard_instance_provider_executable(instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance) -> std.types.FilePath? {
  match instance.provider_state {
    DashboardExistingProviderState { root: _, executable, binding: _ } => executable
  }
}

fn dashboard_instance_provider_executable_matches(
  executable: std.types.FilePath,
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
) -> Bool {
  match dashboard_instance_provider_executable(instance: instance) {
    Present { value: expected } => executable == expected
    Absent => false
  }
}

fn dashboard_instance_provider_executable_refusal_detail(instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance) -> String {
  join([
    "bundled Codex executable path unavailable for host ",
    instance.host_identity as String,
    "; fail-closed — committed lock placement not realized",
  ], "")
}

fn dashboard_instance_capability_executable(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
  cap: gunbc.roadmap_execution_contract.ExecutionCapability,
) -> std.types.FilePath? {
  match dispatch_host_realization(
    environment: instance.execution_environment,
    capability: cap,
  ) {
    Present { value: realization } =>
      Present { value: realization.executable }
    Absent => none
  }
}

fn dashboard_instance_dispatch_platform_executables(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
) -> List<std.types.FilePath> {
  dispatch_platform_required_capabilities()
    |> flat_map(cap =>
      match dashboard_instance_capability_executable(
        instance: instance,
        cap: cap,
      ) {
        Present { value: executable } => [executable]
        Absent => []
      })
}

fn dashboard_instance_ownership_marker_path(instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance) -> std.types.FilePath {
  dashboard_instance_child(
    root: instance.instance_root,
    child: join([".gunbc-dashboard-instance-", instance.instance_id as String], ""),
  )
}

fn dashboard_instance_service_session_name(instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance) -> std.types.NonEmptyStr {
  join(["gunbc-dashboard-", instance.instance_id as String], "") as std.types.NonEmptyStr
}

fn dashboard_instance_checkout_branch(instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance) -> std.types.NonEmptyStr {
  replace(
    s: instance.local_origin_publish_ref as String,
    from: "refs/heads/",
    to: "",
  ) as std.types.NonEmptyStr
}

fn dashboard_instance_controller_workdir(instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance) -> std.types.FilePath {
  match instance.source_seed {
    DashboardExistingRepo { anchor_ref: _ } => instance.repo_root
    DashboardGitBundle {
      controller_repo,
      staged_bundle: _,
      anchor_ref: _,
      history_remote: _,
    } =>
      controller_repo
  }
}

fn dashboard_instance_serve_argv(instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance) -> List<String> {
  [
    "serve",
    "--source-root", "dag",
    "--source-root", "src/v2",
    "--entry", "dag/gunbc/roadmap_serve.dag",
    "--function", instance.serve_function as String,
    "--host", instance.listen_host as String,
    "--port", to_string(instance.listen_port),
  ]
}

fn dashboard_actuation_posture_label(posture: DashboardActuationPosture) -> String {
  match posture {
    DashboardObserveOnly => "observe-only"
    DashboardActuating => "actuating"
  }
}

fn dashboard_provision_transport_label(transport: DashboardProvisionTransport) -> String {
  match transport {
    DashboardLocalProvision => "local"
    DashboardSshProvision { host } => join(["ssh:", host as String], "")
  }
}

data dashboard_instance_health_schema: String = "roadmap-dashboard-instance/v1"

data dashboard_instance_health_identity_note: String = "The served health document leads with schema then instance_id, so a reader can identify it POSITIONALLY instead of scanning the body — the same rule dispatch_environment_receipt_identity_prefix states for the admission receipt. A health reader that scanned for an instance_id fragment would accept any document carrying it in any nested value, which is how a foreign or stale server on the polled port fabricates a converged apply."

fn dashboard_instance_health_identity_prefix(instance_id: String) -> String {
  serialize_json_object_prefix(members: [
    json_kv(key: "schema", value: json_string(s: dashboard_instance_health_schema)),
    json_kv(key: "instance_id", value: json_string(s: instance_id)),
  ])
}

fn dashboard_named_tmux_server(instance_id: std.types.NonEmptyStr) -> extdeps.tmux.TmuxServerScope {
  extdeps.tmux.NamedTmuxServer { socket_name: instance_id }
}

fn dashboard_execution_environment(
  serve_binary: std.types.FilePath,
) -> gunbc.roadmap_execution_contract.DispatchHostEnvironment {
  gunbc.roadmap_execution_contract.DispatchHostEnvironment {
    realizations: [
      gunbc.roadmap_execution_contract.CapabilityRealization {
        capability: GitWorkspaceCapability,
        executable: "/usr/bin/git" as std.types.FilePath,
        identity_args: ["--version"],
        identity_contains: "git version" as std.types.NonEmptyStr,
        ensure_policy: EnsureObserveOnly,
      },
      gunbc.roadmap_execution_contract.CapabilityRealization {
        capability: TmuxSessionCapability,
        executable: "/usr/bin/tmux" as std.types.FilePath,
        identity_args: ["-V"],
        identity_contains: "tmux" as std.types.NonEmptyStr,
        ensure_policy: EnsureObserveOnly,
      },
      gunbc.roadmap_execution_contract.CapabilityRealization {
        capability: TmuxPipeShellCapability,
        executable: "/usr/bin/sh" as std.types.FilePath,
        identity_args: ["-c", "printf gunbc-tmux-pipe-shell"],
        identity_contains: "gunbc-tmux-pipe-shell" as std.types.NonEmptyStr,
        ensure_policy: EnsureObserveOnly,
      },
      gunbc.roadmap_execution_contract.CapabilityRealization {
        capability: TeeEventCaptureCapability,
        executable: "/usr/bin/tee" as std.types.FilePath,
        identity_args: ["--version"],
        identity_contains: "coreutils" as std.types.NonEmptyStr,
        ensure_policy: EnsureObserveOnly,
      },
      gunbc.roadmap_execution_contract.CapabilityRealization {
        capability: ProviderEventProjectionCapability,
        executable: "/usr/bin/jq" as std.types.FilePath,
        identity_args: ["--version"],
        identity_contains: "jq-" as std.types.NonEmptyStr,
        ensure_policy: EnsureObserveOnly,
      },
      gunbc.roadmap_execution_contract.CapabilityRealization {
        capability: EnvironmentBindingCapability,
        executable: dashboard_environment_binding_executable,
        identity_args: ["--version"],
        identity_contains: "coreutils" as std.types.NonEmptyStr,
        ensure_policy: EnsureObserveOnly,
      },
      gunbc.roadmap_execution_contract.CapabilityRealization {
        capability: AttemptStateDirectoryCapability,
        executable: "/usr/bin/install" as std.types.FilePath,
        identity_args: ["--version"],
        identity_contains: "coreutils" as std.types.NonEmptyStr,
        ensure_policy: EnsureObserveOnly,
      },
      gunbc.roadmap_execution_contract.CapabilityRealization {
        capability: AttemptCurrentPointerCapability,
        executable: "/usr/bin/ln" as std.types.FilePath,
        identity_args: ["--version"],
        identity_contains: "coreutils" as std.types.NonEmptyStr,
        ensure_policy: EnsureObserveOnly,
      },
      gunbc.roadmap_execution_contract.CapabilityRealization {
        capability: GunbcClaimRunnerCapability,
        executable: serve_binary,
        identity_args: ["--help"],
        identity_contains: "A causal compiler" as std.types.NonEmptyStr,
        ensure_policy: EnsureObserveOnly,
      },
      gunbc.roadmap_execution_contract.CapabilityRealization {
        capability: CargoCapability,
        executable: "/home/briansrls/.cargo/bin/cargo" as std.types.FilePath,
        identity_args: ["--version"],
        identity_contains: "cargo" as std.types.NonEmptyStr,
        ensure_policy: EnsureObserveOnly,
      },
      gunbc.roadmap_execution_contract.CapabilityRealization {
        capability: RustcCapability,
        executable: "/home/briansrls/.cargo/bin/rustc" as std.types.FilePath,
        identity_args: ["--version"],
        identity_contains: "rustc" as std.types.NonEmptyStr,
        ensure_policy: EnsureObserveOnly,
      },
      gunbc.roadmap_execution_contract.CapabilityRealization {
        capability: RustfmtCapability,
        executable: "/home/briansrls/.cargo/bin/rustfmt" as std.types.FilePath,
        identity_args: ["--version"],
        identity_contains: "rustfmt" as std.types.NonEmptyStr,
        ensure_policy: EnsureObserveOnly,
      },
    ],
  }
}

fn srv1_live_dashboard_instance() -> gunbc.roadmap_dashboard_instance.HostDashboardInstance {
  gunbc.roadmap_dashboard_instance.HostDashboardInstance {
    instance_id: srv1_dashboard_live_id,
    host_identity: "srv1" as std.types.NonEmptyStr,
    provision_parent_root: "/opt/gunbc" as std.types.FilePath,
    instance_root: "/opt/gunbc" as std.types.FilePath,
    local_origin_root: srv1_gunbc_repo_root,
    local_origin_publish_ref: "refs/heads/main" as std.types.NonEmptyStr,
    repo_root: srv1_gunbc_repo_root,
    dispatch_base_ref: "origin/main" as std.types.NonEmptyStr,
    dispatch_state_scope: DispatchStateHostShared {
      worktree_root: srv1_dispatch_worktree_root,
      attempt_state_root: srv1_dispatch_attempt_state_root,
    },
    execution_environment: dashboard_execution_environment(
      serve_binary: srv1_gunbc_serve_binary,
    ),
    provider_state: DashboardExistingProviderState {
      root: srv1_roadmap_codex_home,
      executable: srv1_codex_bundled_executable(),
      binding: admitted_single_session_binding(
        selection: codex_roadmap_account_selection(),
        evidence: codex_roadmap_account_evidence,
      ),
    },
    serve_binary: srv1_gunbc_serve_binary,
    serve_function: "roadmap_serve_handle" as std.types.NonEmptyStr,
    listen_host: "0.0.0.0" as std.types.NonEmptyStr,
    listen_port: 8080,
    tmux_server: DefaultTmuxServer,
    actuation: DashboardActuating,
    provision_transport: DashboardSshProvision { host: "srv1" as std.types.NonEmptyStr },
    source_seed: DashboardExistingRepo { anchor_ref: "origin/main" as std.types.NonEmptyStr },
  }
}

data srv1_green_dashboard_instance_note: String = "The second production slot for the operator-signed 2026-08-01 blue/green cutover. It is a full gunbc.roadmap_dashboard_instance.HostDashboardInstance rather than a port override: source, binary, unit handler and listen port move together, so preparing this idle slot cannot mutate the instance that Tailscale still serves. Provider credentials are referenced from the same admitted account binding, never copied. The slot is actuating and serves the production handler surface; it is not the pre-existing feedback lab, whose source ref and handler intentionally describe a different product.\\n\\nDISPATCH STATE AND THE TMUX SERVER DELIBERATELY DO NOT MOVE WITH THE SLOT, and an earlier revision of this note listed dispatch worktrees, attempt evidence and the tmux server among the things that do (operator ruling, 2026-08-01). Moving them was wrong twice over. It put a teardown of live dispatch evidence on the per-push cutover path, where the empty-directory wall correctly refused and reded every main push; and it meant a flip handed the dashboard to a process reading an empty attempt-state root and a differently-named tmux server, so attempts dispatched under the predecessor went invisible and their sessions unmanageable. Blue/green is sound for a stateless server, and this instance is stateful — so the stateful members are host-shared and the slot carries only what a slot may safely own."

fn srv1_green_dashboard_instance() -> gunbc.roadmap_dashboard_instance.HostDashboardInstance {
  let root = "/opt/gunbc-green" as std.types.FilePath
  let binary = dashboard_instance_child(root: root, child: "bin/gunbc")
  gunbc.roadmap_dashboard_instance.HostDashboardInstance {
    instance_id: srv1_dashboard_green_id,
    host_identity: "srv1" as std.types.NonEmptyStr,
    provision_parent_root: "/opt" as std.types.FilePath,
    instance_root: root,
    local_origin_root: dashboard_instance_child(root: root, child: "gunbc"),
    local_origin_publish_ref: "refs/heads/main" as std.types.NonEmptyStr,
    repo_root: dashboard_instance_child(root: root, child: "gunbc"),
    dispatch_base_ref: "origin/main" as std.types.NonEmptyStr,
    dispatch_state_scope: DispatchStateHostShared {
      worktree_root: srv1_dispatch_worktree_root,
      attempt_state_root: srv1_dispatch_attempt_state_root,
    },
    execution_environment: dashboard_execution_environment(serve_binary: binary),
    provider_state: DashboardExistingProviderState {
      root: srv1_roadmap_codex_home,
      executable: srv1_codex_bundled_executable(),
      binding: admitted_single_session_binding(
        selection: codex_roadmap_account_selection(),
        evidence: codex_roadmap_account_evidence,
      ),
    },
    serve_binary: binary,
    serve_function: "roadmap_serve_handle_srv1_green" as std.types.NonEmptyStr,
    listen_host: "0.0.0.0" as std.types.NonEmptyStr,
    listen_port: 18080,
    tmux_server: DefaultTmuxServer,
    actuation: DashboardActuating,
    provision_transport: DashboardSshProvision { host: "srv1" as std.types.NonEmptyStr },
    source_seed: DashboardExistingRepo { anchor_ref: "origin/main" as std.types.NonEmptyStr },
  }
}

data isolated_instance_layout_parameter_note: String = "host_identity USED TO BE A PARAMETER OVER A BODY OF srv1 LITERALS, which made a second host expressible without making it representable. Serve binary, provider state root, and source-seed controller repo were pinned to srv1 rows here, so srv2_preview_dashboard_instance below produced a value reading host_identity srv2 while describing srv1's binary, srv1's Codex home, and srv1's controller worktree. Nothing caught it because every consumer that would disagree — preflight, apply, the git and tmux observations — needs the host to actually be actuated, and that instance was declared observe-only and never provisioned.\\n\\nTaking the whole layout row instead of a bare host_identity makes the mismatch unwritable: there is no longer a way to name a host without also supplying the three facts that belong to it, because the name IS a field of the row that carries them. gunbc.host_layout owns those rows."

data isolated_instance_own_binary_note: String = "EACH INSTANCE OWNS ITS BINARY, BECAUSE THE PROCESSES ARE MUTUALLY EXCLUSIVE (operator ruling, 2026-07-30). The serve binary used to come from the host layout, so every isolated instance on one machine resolved to the same /opt/gunbc/bin/gunbc that production declares. dashboard_instance_owned_paths does not cover serve_binary — it checks origin, source, attempts and attempt-state — so the existing disjointness check passed while the DEPLOYMENT's owned-artifact set overlapped production on exactly that path.\\n\\nThe consequence was not a stale read. ServeBinary is an Owned artifact and retract tears Owned members down, so retracting a lab would have deleted the binary production is executing. That could not fire before deployments became expressible per instance, which is why it surfaced the moment the twin witness was written and not one commit earlier: the hazard is created by the capability, so it has to be closed in the same change that grants it.\\n\\nDeriving from the instance root rather than the layout also states the isolation the labs exist for — a lab testing a new seed must not overwrite the binary production is running. srv1-live is untouched: it declares /opt/gunbc/bin/gunbc directly rather than through this constructor, which is why its emitted apply and retract scripts stay byte-identical. GunbcHostLayout.gunbc_serve_binary keeps only srv1-live's own declaration as a consumer; it is a per-INSTANCE fact wearing a per-host name, and it dissolves when srv1-live is expressed as an instance row like the rest."

data isolated_instance_anchor_parameter_note: String = "WHICH REF A LAB SERVES IS THE LAB'S OWN FACT, and it was the fourth srv1-preview literal hiding in this constructor — found by probing the served endpoints after the other three were lifted, not by reading the diff. Every isolated instance inherited anchor_ref refs/heads/session/codex-provider-feedback-v0, so a newly added lab would have provisioned itself from a stale feedback branch belonging to a different lane while its page, its instance id, and its posture all read correctly. Nothing would have refused; it would simply have served the wrong source.\\n\\nThat is worse than the host-fact defect above, which produced identical values and no wrong output. This one produces a plausible page from unintended content — the failure that looks like success. It is a parameter rather than a layout field because two labs on ONE host may legitimately serve different refs; the ref belongs to the instance, not the machine."

fn isolated_dashboard_instance(
  instance_id: std.types.NonEmptyStr,
  layout: gunbc.host_layout.GunbcHostLayout,
  root: std.types.FilePath,
  serve_function: std.types.NonEmptyStr,
  listen_port: std.types.Port,
  source_anchor_ref: std.types.NonEmptyStr,
  actuation: DashboardActuationPosture,
  provision_transport: DashboardProvisionTransport,
) -> gunbc.roadmap_dashboard_instance.HostDashboardInstance {
  gunbc.roadmap_dashboard_instance.HostDashboardInstance {
    instance_id: instance_id,
    host_identity: layout.host_identity,
    provision_parent_root: "/home/briansrls/.local/share" as std.types.FilePath,
    instance_root: root,
    local_origin_root: dashboard_instance_child(root: root, child: "origin.git"),
    local_origin_publish_ref: "refs/heads/main" as std.types.NonEmptyStr,
    repo_root: dashboard_instance_child(root: root, child: "source"),
    dispatch_base_ref: "origin/main" as std.types.NonEmptyStr,
    dispatch_state_scope: DispatchStateInstanceOwned {
      worktree_child: "attempts" as std.types.NonEmptyStr,
      attempt_state_child: "attempt-state" as std.types.NonEmptyStr,
    },
    execution_environment: dashboard_execution_environment(
      serve_binary: dashboard_instance_child(root: root, child: "bin/gunbc"),
    ),
    provider_state: DashboardExistingProviderState {
      root: layout.roadmap_codex_home,
      executable: layout.codex_bundled_executable,
      binding: admitted_single_session_binding(
        selection: codex_roadmap_account_selection(),
        evidence: codex_roadmap_account_evidence,
      ),
    },
    serve_binary: dashboard_instance_child(root: root, child: "bin/gunbc"),
    serve_function: serve_function,
    listen_host: "0.0.0.0" as std.types.NonEmptyStr,
    listen_port: listen_port,
    tmux_server: dashboard_named_tmux_server(instance_id: instance_id),
    actuation: actuation,
    provision_transport: provision_transport,
    source_seed: DashboardGitBundle {
      controller_repo: layout.controller_repo,
      staged_bundle: dashboard_instance_child(root: root, child: "inbox/source.bundle"),
      anchor_ref: source_anchor_ref,
      history_remote: "origin" as std.types.NonEmptyStr,
    },
  }
}

