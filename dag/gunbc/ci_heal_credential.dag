module gunbc.ci_heal_credential

import std.types { NonEmptyStr, String, Bool }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.languages.yaml.types {
  YamlKeyValue, YamlValue,
  YamlString, YamlNull, YamlBool, YamlInt, YamlFloat, YamlSequence, YamlMapping,
  kv, yaml_string, yaml_int, yaml_bool
}
import extdeps.github.actions {
  WorkflowPermissions, PermissionLevel, PermRead, PermWrite, PermNone,
  Step, UsesStep, RunStep, checkout_action
}
import extdeps.github.actions_token {
  EffectiveActionsJobGrant,
  GitHubWorkflowEvent,
  PullRequestEvent,
  PullRequestOrigin,
  SameRepositoryOrigin,
  ForkedRepositoryOrigin,
  ActionsRepositoryPolicyObservation,
  ActionsRepositoryPolicyUnobserved
}
import gunbc.auth.github_apps {
  GitHubAppControlPlaneState,
  app_control_plane_state,
  gunbai_bot_declared,
  gunbai_bot_signer_custody,
  ObservedAppRegistration,
  AppRegistrationReadbackUnavailable,
  ObservedInstallation,
  InstallationReadbackUnavailable,
  InstallationReadbackCause,
  InstallationReadbackNotAttempted
}
import gunbc.auth.github_credential {
  GitHubCredentialAuthority,
  ActionsJobCredential,
  GitPushCredentialBinding,
  CheckoutPersistedActionsCredential,
  PushBindingResolution,
  PushBindingResolved,
  PushCredentialBindingMissing,
  PushCredentialLeaseUnresolved
}

data ci_heal_job_permissions: WorkflowPermissions = WorkflowPermissions {
  contents: Present { value: PermWrite },
  pull_requests: none,
  issues: none,
  actions: Present { value: PermWrite },
  id_token: none
}

data ci_heal_job_ref: DeclarationRef = DeclarationRef {
  module_path: "gunbc.ci_workflow",
  decl_name: "ci_heal_generated_artifacts_job",
  field: WholeDeclaration
}

data ci_heal_workflow_ref: DeclarationRef = DeclarationRef {
  module_path: "gunbc.ci_workflow",
  decl_name: "gunbc_ci_workflow",
  field: WholeDeclaration
}

data ci_heal_checkout_step_ref: DeclarationRef = DeclarationRef {
  module_path: "gunbc.ci_heal_credential",
  decl_name: "ci_heal_branch_head_checkout_step",
  field: WholeDeclaration
}

data ci_heal_branch_ref_expr: String = "${{ github.head_ref || github.ref_name }}"

type HealOriginGuard {
  event: GitHubWorkflowEvent
  require_same_repository: Bool
  exclude_dependabot: Bool
}

data ci_heal_origin_guard: HealOriginGuard = HealOriginGuard {
  event: PullRequestEvent,
  require_same_repository: true,
  exclude_dependabot: true
}

fn heal_guard_event_condition(event: GitHubWorkflowEvent) -> String {
  match event {
    PullRequestEvent => "github.event_name == 'pull_request'"
    PushEvent => "github.event_name == 'push'"
    WorkflowDispatchEvent => "github.event_name == 'workflow_dispatch'"
    MergeGroupEvent => "github.event_name == 'merge_group'"
    ScheduleEvent => "github.event_name == 'schedule'"
  }
}

data heal_same_repository_clause: String = "github.event.pull_request.head.repo.full_name == github.repository"

data heal_not_dependabot_clause: String = "github.actor != 'dependabot[bot]'"

fn heal_origin_guard_condition(guard: HealOriginGuard) -> String {
  let with_repo = if guard.require_same_repository {
    concat(
      concat(heal_guard_event_condition(event: guard.event), " && "),
      heal_same_repository_clause
    )
  } else {
    heal_guard_event_condition(event: guard.event)
  }
  if guard.exclude_dependabot {
    concat(concat(with_repo, " && "), heal_not_dependabot_clause)
  } else {
    with_repo
  }
}

fn heal_guard_origin(guard: HealOriginGuard) -> PullRequestOrigin {
  if guard.require_same_repository { SameRepositoryOrigin } else { ForkedRepositoryOrigin }
}

data ci_regen_heal_if: String = heal_origin_guard_condition(guard: ci_heal_origin_guard)

data ci_heal_pull_request_origin: PullRequestOrigin = heal_guard_origin(guard: ci_heal_origin_guard)

fn ci_heal_branch_head_checkout_step() -> Step {
  UsesStep {
    name: Present { value: "Checkout triggering branch head (heal pushes the regeneration back to this branch)" },
    id: none,
    uses: checkout_action,
    with: Present {
      value: [
        kv(key: "fetch-depth", value: yaml_int(n: 0)),
        kv(key: "ref", value: yaml_string(s: ci_heal_branch_ref_expr))
      ]
    },
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn step_input(step: Step, key: NonEmptyStr) -> YamlValue? {
  match step {
    RunStep { name: _, id: _, run: _, shell: _, env: _, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => none
    UsesStep { name: _, id: _, uses: _, with: w, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } =>
      match w {
        Absent => none
        Present { value: rows } =>
          fold_list(
            xs: rows,
            empty: none,
            cons: fn(found, row) {
              match found {
                Present { value: v } => Present { value: v }
                Absent => if row.key == key { Present { value: row.value } } else { none }
              }
            }
          )
      }
  }
}

fn yaml_is_false(v: YamlValue) -> Bool {
  match v {
    YamlBool { value: b } => !b
    YamlString { value: s } => s == "false"
    YamlNull => false
    YamlInt { lexeme: _ } => false
    YamlFloat { lexeme: _ } => false
    YamlSequence { elements: _ } => false
    YamlMapping { entries: _ } => false
  }
}

fn checkout_persists_actions_credential(step: Step) -> Bool {
  match step_input(step: step, key: "persist-credentials") {
    Absent => true
    Present { value: v } => !yaml_is_false(v: v)
  }
}

fn checkout_carries_explicit_token(step: Step) -> Bool {
  match step_input(step: step, key: "token") {
    Absent => false
    Present { value: _ } => true
  }
}

fn resolve_push_binding(step: Step, grant: EffectiveActionsJobGrant) -> PushBindingResolution {
  if checkout_carries_explicit_token(step: step) {
    PushCredentialLeaseUnresolved { checkout_step: ci_heal_checkout_step_ref }
  } else if !checkout_persists_actions_credential(step: step) {
    PushCredentialBindingMissing { checkout_step: ci_heal_checkout_step_ref }
  } else {
    PushBindingResolved {
      binding: CheckoutPersistedActionsCredential { checkout_step: ci_heal_checkout_step_ref },
      authority: ActionsJobCredential { grant: grant }
    }
  }
}

data ci_heal_effective_grant: EffectiveActionsJobGrant = EffectiveActionsJobGrant {
  workflow: ci_heal_workflow_ref,
  job: ci_heal_job_ref,
  event: ci_heal_origin_guard.event,
  origin: ci_heal_pull_request_origin,
  repository_policy: ActionsRepositoryPolicyUnobserved,
  permissions: ci_heal_job_permissions
}

data live_heal_push_binding_resolution: PushBindingResolution = resolve_push_binding(
  step: ci_heal_branch_head_checkout_step(),
  grant: ci_heal_effective_grant
)

fn push_binding_authority(resolution: PushBindingResolution) -> GitHubCredentialAuthority? {
  match resolution {
    PushBindingResolved { binding: _, authority } => Present { value: authority }
    PushCredentialBindingMissing { checkout_step: _ } => none
    PushCredentialLeaseUnresolved { checkout_step: _ } => none
  }
}

data live_heal_dispatch_credential: GitHubCredentialAuthority = ActionsJobCredential {
  grant: ci_heal_effective_grant
}

fn grant_with_origin(origin: PullRequestOrigin) -> EffectiveActionsJobGrant {
  EffectiveActionsJobGrant {
    workflow: ci_heal_workflow_ref,
    job: ci_heal_job_ref,
    event: ci_heal_origin_guard.event,
    origin: origin,
    repository_policy: ActionsRepositoryPolicyUnobserved,
    permissions: ci_heal_job_permissions
  }
}

fn fork_origin_grant() -> EffectiveActionsJobGrant {
  grant_with_origin(origin: ForkedRepositoryOrigin)
}

data live_heal_control_plane: GitHubAppControlPlaneState = app_control_plane_state(
  app: gunbai_bot_declared,
  custody: gunbai_bot_signer_custody,
  registration: AppRegistrationReadbackUnavailable,
  observed: InstallationReadbackUnavailable { cause: InstallationReadbackNotAttempted },
  required: [],
  reason: "heal branch advance over .github/workflows/**"
)
