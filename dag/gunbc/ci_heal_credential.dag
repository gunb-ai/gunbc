module gunbc.ci_heal_credential


data ci_heal_job_permissions: extdeps.github.actions.WorkflowPermissions = extdeps.github.actions.WorkflowPermissions {
  contents: Present { value: extdeps.github.actions.PermWrite },
  pull_requests: none,
  issues: none,
  actions: Present { value: extdeps.github.actions.PermWrite },
  id_token: none
}

data ci_heal_job_ref: std.decl_ref.DeclarationRef = std.decl_ref.DeclarationRef {
  module_path: "gunbc.ci_workflow",
  decl_name: "ci_heal_generated_artifacts_job",
  field: WholeDeclaration
}

data ci_heal_workflow_ref: std.decl_ref.DeclarationRef = std.decl_ref.DeclarationRef {
  module_path: "gunbc.ci_workflow",
  decl_name: "ci_workflow",
  field: WholeDeclaration
}

data ci_heal_checkout_step_ref: std.decl_ref.DeclarationRef = std.decl_ref.DeclarationRef {
  module_path: "gunbc.ci_heal_credential",
  decl_name: "ci_heal_branch_head_checkout_step",
  field: WholeDeclaration
}

data ci_heal_branch_ref_expr: String = "${{ github.head_ref || github.ref_name }}"

type HealOriginGuard {
  exclude_dependabot: Bool
}

type HealOriginBinding {
  condition: String
  origin: extdeps.github.actions_token.PullRequestOrigin
}

data ci_heal_origin_guard: HealOriginGuard = HealOriginGuard {
  exclude_dependabot: true
}

data heal_guarded_event: extdeps.github.actions_token.GitHubWorkflowEvent = PullRequestEvent

fn heal_guard_event_condition(event: extdeps.github.actions_token.GitHubWorkflowEvent) -> String {
  match event {
    PullRequestEvent => "github.event_name == 'pull_request'"
    PushEvent => "github.event_name == 'push'"
    WorkflowDispatchEvent => "github.event_name == 'workflow_dispatch'"
    MergeGroupEvent => "github.event_name == 'merge_group'"
    ScheduleEvent => "github.event_name == 'schedule'"
  }
}

data heal_same_repository_clause: String = "github.event.pull_request.head.repo.full_name == github.repository"

data heal_not_dependabot_clause: String = "github.actor != 'dependabot[bot]'"

fn heal_origin_binding(guard: HealOriginGuard) -> HealOriginBinding {
  let with_repo = concat(
    concat(heal_guard_event_condition(event: heal_guarded_event), " && "),
    heal_same_repository_clause
  )
  HealOriginBinding {
    condition: if guard.exclude_dependabot {
      concat(concat(with_repo, " && "), heal_not_dependabot_clause)
    } else {
      with_repo
    },
    origin: SameRepositoryOrigin
  }
}

data ci_heal_origin_binding: HealOriginBinding = heal_origin_binding(guard: ci_heal_origin_guard)

data ci_regen_heal_if: String = ci_heal_origin_binding.condition

data ci_heal_pull_request_origin: extdeps.github.actions_token.PullRequestOrigin = ci_heal_origin_binding.origin

fn ci_heal_branch_head_checkout_step() -> extdeps.github.actions.Step {
  extdeps.github.actions.UsesStep {
    name: Present { value: "Checkout triggering branch head (heal pushes the regeneration back to this branch)" },
    id: none,
    uses: checkout_action,
    with: Present {
      value: [
        kv(key: "fetch-depth", value: yaml_int(n: 0)),
        kv(key: "ref", value: yaml_string(s: ci_heal_branch_ref_expr))
      ]
    },
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

type StepInputObservation
  = StepInputAbsent
  | StepInputObserved { value: extdeps.languages.yaml.types.YamlValue }
  | StepInputDuplicated

fn step_input_rows(step: extdeps.github.actions.Step) -> List<extdeps.languages.yaml.types.YamlKeyValue> {
  match step {
    RunStep { name: _, id: _, run: _, shell: _, env: _, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => []
    UsesStep { name: _, id: _, uses: _, with: w, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } =>
      match w {
        Absent => []
        Present { value: rows } => rows
      }
  }
}

fn step_input(step: extdeps.github.actions.Step, key: std.types.NonEmptyStr) -> StepInputObservation {
  fold(step_input_rows(step: step), init: StepInputAbsent, f: fn(acc, row) {
    if row.key == key {
      match acc {
        StepInputAbsent => StepInputObserved { value: row.value }
        StepInputObserved { value: _ } => StepInputDuplicated
        StepInputDuplicated => StepInputDuplicated
      }
    } else {
      acc
    }
  })
}

fn action_ref_eq(a: extdeps.github.actions.ActionRef, b: extdeps.github.actions.ActionRef) -> Bool {
  a.owner == b.owner && a.repo == b.repo && a.ref == b.ref
}

fn step_is_checkout_action(step: extdeps.github.actions.Step) -> Bool {
  match step {
    RunStep { name: _, id: _, run: _, shell: _, env: _, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => false
    UsesStep { name: _, id: _, uses: u, with: _, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } =>
      action_ref_eq(a: u, b: checkout_action)
  }
}

fn step_is_uses(step: extdeps.github.actions.Step) -> Bool {
  match step {
    RunStep { name: _, id: _, run: _, shell: _, env: _, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => false
    UsesStep { name: _, id: _, uses: _, with: _, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => true
  }
}

type YamlBooleanReading
  = YamlBooleanTrue
  | YamlBooleanFalse
  | YamlBooleanUnsupported

fn yaml_boolean_reading(v: extdeps.languages.yaml.types.YamlValue) -> YamlBooleanReading {
  match v {
    extdeps.languages.yaml.types.YamlBool { value: b } => if b { YamlBooleanTrue } else { YamlBooleanFalse }
    extdeps.languages.yaml.types.YamlString { value: s } =>
      if s == "false" { YamlBooleanFalse }
      else if s == "true" { YamlBooleanTrue }
      else { YamlBooleanUnsupported }
    extdeps.languages.yaml.types.YamlNull => YamlBooleanUnsupported
    extdeps.languages.yaml.types.YamlInt { lexeme: _ } => YamlBooleanUnsupported
    extdeps.languages.yaml.types.YamlFloat { lexeme: _ } => YamlBooleanUnsupported
    extdeps.languages.yaml.types.YamlSequence { elements: _ } => YamlBooleanUnsupported
    extdeps.languages.yaml.types.YamlMapping { entries: _ } => YamlBooleanUnsupported
  }
}

fn resolve_checkout_inputs(step: extdeps.github.actions.Step, grant: extdeps.github.actions_token.EffectiveActionsJobGrant) -> gunbc.auth.github_credential.PushBindingResolution {
  match step_input(step: step, key: "token") {
    StepInputDuplicated =>
      gunbc.auth.github_credential.PushBindingInputDuplicated { checkout_step: ci_heal_checkout_step_ref, input: "token" }
    StepInputObserved { value: _ } =>
      gunbc.auth.github_credential.PushCredentialLeaseUnresolved { checkout_step: ci_heal_checkout_step_ref }
    StepInputAbsent => match step_input(step: step, key: "persist-credentials") {
      StepInputDuplicated =>
        gunbc.auth.github_credential.PushBindingInputDuplicated {
          checkout_step: ci_heal_checkout_step_ref,
          input: "persist-credentials"
        }
      StepInputObserved { value: v } => match yaml_boolean_reading(v: v) {
        YamlBooleanFalse => gunbc.auth.github_credential.PushCredentialBindingMissing { checkout_step: ci_heal_checkout_step_ref }
        YamlBooleanTrue =>
          gunbc.auth.github_credential.PushBindingResolved {
            binding: gunbc.auth.github_credential.CheckoutPersistedActionsCredential { checkout_step: ci_heal_checkout_step_ref },
            authority: gunbc.auth.github_credential.ActionsJobCredential { grant: grant }
          }
        YamlBooleanUnsupported =>
          gunbc.auth.github_credential.PushBindingInputUnsupported {
            checkout_step: ci_heal_checkout_step_ref,
            input: "persist-credentials",
            observed_kind: yaml_value_kind(v: v)
          }
      }
      StepInputAbsent =>
        gunbc.auth.github_credential.PushBindingResolved {
          binding: gunbc.auth.github_credential.CheckoutPersistedActionsCredential { checkout_step: ci_heal_checkout_step_ref },
          authority: gunbc.auth.github_credential.ActionsJobCredential { grant: grant }
        }
    }
  }
}

fn resolve_push_binding(step: extdeps.github.actions.Step, grant: extdeps.github.actions_token.EffectiveActionsJobGrant) -> gunbc.auth.github_credential.PushBindingResolution {
  if !step_is_uses(step: step) {
    gunbc.auth.github_credential.PushBindingStepKindUnsupported { checkout_step: ci_heal_checkout_step_ref }
  } else if !step_is_checkout_action(step: step) {
    gunbc.auth.github_credential.PushBindingActionMismatch { checkout_step: ci_heal_checkout_step_ref }
  } else {
    resolve_checkout_inputs(step: step, grant: grant)
  }
}

data ci_heal_effective_grant: extdeps.github.actions_token.EffectiveActionsJobGrant = extdeps.github.actions_token.EffectiveActionsJobGrant {
  workflow: ci_heal_workflow_ref,
  job: ci_heal_job_ref,
  event: heal_guarded_event,
  origin: ci_heal_pull_request_origin,
  repository_policy: ActionsRepositoryPolicyUnobserved,
  permissions: ci_heal_job_permissions
}

data live_heal_push_binding_resolution: gunbc.auth.github_credential.PushBindingResolution = resolve_push_binding(
  step: ci_heal_branch_head_checkout_step(),
  grant: ci_heal_effective_grant
)

fn push_binding_authority(resolution: gunbc.auth.github_credential.PushBindingResolution) -> gunbc.auth.github_credential.GitHubCredentialAuthority? {
  match resolution {
    PushBindingResolved { binding: _, authority } => Present { value: authority }
    PushCredentialBindingMissing { checkout_step: _ } => none
    PushCredentialLeaseUnresolved { checkout_step: _ } => none
    PushBindingStepKindUnsupported { checkout_step: _ } => none
    PushBindingActionMismatch { checkout_step: _ } => none
    PushBindingInputDuplicated { checkout_step: _, input: _ } => none
    PushBindingInputUnsupported { checkout_step: _, input: _, observed_kind: _ } => none
  }
}

data live_heal_dispatch_credential: gunbc.auth.github_credential.GitHubCredentialAuthority = gunbc.auth.github_credential.ActionsJobCredential {
  grant: ci_heal_effective_grant
}

fn grant_with_origin(origin: extdeps.github.actions_token.PullRequestOrigin) -> extdeps.github.actions_token.EffectiveActionsJobGrant {
  extdeps.github.actions_token.EffectiveActionsJobGrant {
    workflow: ci_heal_workflow_ref,
    job: ci_heal_job_ref,
    event: heal_guarded_event,
    origin: origin,
    repository_policy: ActionsRepositoryPolicyUnobserved,
    permissions: ci_heal_job_permissions
  }
}

fn fork_origin_grant() -> extdeps.github.actions_token.EffectiveActionsJobGrant {
  grant_with_origin(origin: ForkedRepositoryOrigin)
}

data live_heal_control_plane: gunbc.auth.github_apps.GitHubAppControlPlaneState = app_control_plane_state(
  app: gunbai_bot_declared,
  custody: gunbai_bot_signer_custody,
  registration: AppRegistrationReadbackUnavailable,
  observed: gunbc.auth.github_apps.InstallationReadbackUnavailable { cause: InstallationReadbackNotAttempted },
  required: [contents_write, workflows_write],
  reason: "heal branch advance over .github/workflows/**"
)
