module gunbc.heal_publication_boundary

import std.types { NonEmptyStr, String, List, Int, Bool, CommitSha }
import std.optional { Present, Absent }
import std.algebra { trim }
import extdeps.github.effect { RepositoryPath, is_workflow_projection_path }
import extdeps.github.workflow_runs {
  WorkflowRunConclusion, Success, Failure, Cancelled, Neutral, Skipped, TimedOut, ActionRequired, StartupFailure
}
import extdeps.github.git_database { GitTreeItemWire }
import extdeps.git.object_store {
  GitObjectId, git_sha1_object_id, git_object_id_wire_hex, git_object_id_eq,
  GitTreeMode, GitRegularBlobMode, GitExecutableBlobMode, GitSymlinkMode, GitSubtreeMode, GitlinkMode,
  GitTreeModeDecoded, GitTreeModeRefused, git_decode_tree_mode, git_encode_tree_mode
}
import extdeps.languages.json.emit {
  JsonValue, JsonNull, JsonBool, JsonNumber, JsonString, JsonArray, JsonObject,
  json_kv, json_string, json_null, json_array, json_object, serialize_json
}
import extdeps.languages.json.parse {
  parse_json_document, JsonDocumentParsed, JsonDocumentUnreadable, json_document_gap_text,
  json_object_unique_member, JsonMemberFound, JsonMemberAbsent, JsonMemberDuplicated, JsonMemberNotAnObject
}
import std.host_text { chars }

// A CREDENTIAL-ISOLATED BOUNDARY FOR HEAL REPAIRS (gunbc#10958), bidirectional and stated as an
// invariant rather than a convention:
//
//   No process that executes PR-head code may possess the App key, the publication token, or any
//   credential capable of minting one.
//   No process that possesses publication authority may execute the PR checkout, the generator,
//   build scripts, hooks, or any candidate-selected command.
//
// WHY BOTH DIRECTIONS. gunbc#10887 satisfied neither: it federated a PR-controlled job to Secret
// Manager, read a long-lived App private key, and handed a contents+workflows-capable token to
// actions/checkout BEFORE the PR-head regenerator was built and executed. Stating only the first
// direction would still admit a publisher that checks out the branch it is publishing.
//
// THE CANDIDATE IS DATA, NOT A COMMAND. The PR side produces a sealed description of the repair;
// the protected side reads it as UNTRUSTED INPUT and re-derives every fact it acts on. Nothing in
// the candidate is a permit: the publisher's path policy is its OWN checkout's registry, its base
// is the branch as GitHub reports it, and its blob identities are recomputed from the bytes.
//
// THIS MODULE IS THE PURE HALF. Every decision here is a total function over supplied observations,
// so each refusal is reachable by a value; gunbc.heal_candidate and gunbc.heal_publication are the
// effectful halves that make the observations and act on the verdicts.

type BoundaryPhase
  = CandidatePhase
  | PublicationPhase

type PhaseCredentialStanding
  = PhasesIsolated
  | CandidatePhaseHoldsPublicationCredential { detail: NonEmptyStr }
  | PublicationPhaseExecutesCandidateCode { detail: NonEmptyStr }

// The invariant as a total function over what each phase actually holds and does. Both violations
// are named separately because they have different remedies: the first is a credential-placement
// defect, the second an execution-placement one. The emitted workflows answer the two questions
// from their own job shapes (gunbc.heal_workflow and gunbc.heal_publisher_workflow), so this is fed
// by what will run, not by what an author says will run.
fn phase_isolation(
  candidate_holds_publication_credential: Bool,
  candidate_credential_detail: NonEmptyStr,
  publication_executes_candidate_code: Bool,
  publication_execution_detail: NonEmptyStr
) -> PhaseCredentialStanding {
  if candidate_holds_publication_credential {
    CandidatePhaseHoldsPublicationCredential { detail: candidate_credential_detail }
  } else if publication_executes_candidate_code {
    PublicationPhaseExecutesCandidateCode { detail: publication_execution_detail }
  } else {
    PhasesIsolated
  }
}

fn phases_are_isolated(s: PhaseCredentialStanding) -> Bool {
  match s {
    PhasesIsolated => true
    CandidatePhaseHoldsPublicationCredential { detail: _ } => false
    PublicationPhaseExecutesCandidateCode { detail: _ } => false
  }
}

// ── The sealed candidate ────────────────────────────────────────────────────────────────────

// ONE ENTRY PER PATH THE PRODUCER OBSERVED DRIFTED. `base_blob` is the blob the path held at the
// expected head, Absent exactly when the path was absent there; `proposed_blob` is the git blob id
// of the regenerated bytes, which travel beside the manifest under that id. The mode is the one the
// producer read at the expected head, and the publisher admits it only where the head it observes
// agrees.
type CandidateEntry {
  path: RepositoryPath
  mode: GitTreeMode
  base_blob: GitObjectId?
  proposed_blob: GitObjectId
}

type HealRepairCandidate {
  repository_full_name: NonEmptyStr
  pull_number: Int
  head_ref: NonEmptyStr
  expected_head_sha: CommitSha
  base_ref: NonEmptyStr
  producer_run_id: NonEmptyStr
  repair_declaration: String
  entries: List<CandidateEntry>
}

// THE WIRE FORMAT IS VERSIONED BY A NAME, so a producer and a publisher built from different
// revisions refuse each other by that name rather than by a field that happens to be missing.
data heal_repair_candidate_format: NonEmptyStr = "gunbc.heal_repair_candidate/1"

// ONE ARTIFACT, FLAT FILE NAMES. The candidate is a manifest and one file per proposed blob, all in
// one directory, so neither side needs to create or walk a directory tree: the producer writes into a
// directory its build already created, and the publisher reads exactly the names it derives.
data heal_repair_candidate_artifact_name: NonEmptyStr = "heal-repair-candidate"

data heal_repair_candidate_manifest_file_name: NonEmptyStr = "heal-repair-candidate-manifest.json"

data heal_repair_candidate_blob_file_prefix: NonEmptyStr = "heal-repair-candidate-blob-"

// A blob travels under its own identity, so the name the publisher reads is derived from a decoded
// object id and can never carry a path component the candidate chose.
fn candidate_blob_file_name(blob: GitObjectId) -> String {
  concat(heal_repair_candidate_blob_file_prefix as String, git_object_id_wire_hex(oid: blob) as String)
}

fn candidate_file_path(directory: String, file_name: String) -> String {
  join([directory, "/", file_name], "")
}

fn optional_blob_json(blob: GitObjectId?) -> JsonValue {
  match blob {
    Absent => json_null()
    Present { value: b } => json_string(s: git_object_id_wire_hex(oid: b) as String)
  }
}

fn candidate_entry_json(e: CandidateEntry) -> JsonValue {
  json_object(members: [
    json_kv(key: "path", value: json_string(s: e.path.value as String)),
    json_kv(key: "mode", value: json_string(s: git_encode_tree_mode(mode: e.mode) as String)),
    json_kv(key: "base_blob", value: optional_blob_json(blob: e.base_blob)),
    json_kv(key: "proposed_blob", value: json_string(s: git_object_id_wire_hex(oid: e.proposed_blob) as String))
  ])
}

// The pull number is carried as its decimal digits in a JSON STRING. This tree has no JSON-number
// decode (extdeps.github.workflow_run_event records why), and a number that must round-trip is
// better carried as the text both ends already compare than as a lexeme only one end can read.
fn encode_heal_repair_candidate(c: HealRepairCandidate) -> String {
  serialize_json(v: json_object(members: [
    json_kv(key: "format", value: json_string(s: heal_repair_candidate_format as String)),
    json_kv(key: "repository", value: json_string(s: c.repository_full_name as String)),
    json_kv(key: "pull_number", value: json_string(s: to_string(c.pull_number))),
    json_kv(key: "head_ref", value: json_string(s: c.head_ref as String)),
    json_kv(key: "expected_head_sha", value: json_string(s: c.expected_head_sha as String)),
    json_kv(key: "base_ref", value: json_string(s: c.base_ref as String)),
    json_kv(key: "producer_run_id", value: json_string(s: c.producer_run_id as String)),
    json_kv(key: "repair_declaration", value: json_string(s: c.repair_declaration)),
    json_kv(key: "entries", value: json_array(elements: map(c.entries, e => candidate_entry_json(e: e))))
  ]))
}

// ── Refusals, located and typed ─────────────────────────────────────────────────────────────

type HealPublicationRefusal
  = CandidateUnreadable { detail: String }
  | CandidateFormatUnsupported { format: String }
  | CandidateMemberMalformed { member: String, detail: String }
  | TriggeringRunNotTheCandidateProducer { workflow_path: String }
  | TriggeringRunNotAPullRequestRun { originating_event: String }
  | TriggeringRunReachedNoVerdict
  | TriggeringRunSubjectDisagreed { run_head_sha: String, candidate_head_sha: String }
  | TriggeringRunBranchDisagreed { run_head_branch: String, candidate_head_ref: String }
  | TriggeringRunRepositoryDisagreed { expected: String, observed: String }
  | CandidateRepositoryDisagreed { expected: String, candidate: String }
  | HeadRefNotAddressable { head_ref: String }
  | PullRequestNumberDisagreed { candidate: Int, observed: Int }
  | PullRequestNotOpen { pull_number: Int }
  | PullRequestHeadRefDisagreed { candidate: String, observed: String }
  | BaseRefNotTheDefaultBranch { base_ref: String, default_branch: String }
  | HeadMoved { expected: String, observed: String }
  | BranchRefUnreadable { head_ref: String, detail: String }
  | ExpectedHeadUnreadable { expected: String, detail: String }
  | BaseTreeUnreadable { tree_sha: String, detail: String }
  | RepairDeclarationMissing
  | CandidateEntriesEmpty
  | PathPopulationDuplicated { path: String }
  | PathRequiresAuthorCommit { path: String }
  | PathNotPublisherAdmitted { path: String }
  | BaseTreeTruncated { tree_sha: String }
  | BaseBlobDisagreed { path: String, candidate: String, observed: String }
  | BaseEntryNotARegularFile { path: String, observed_mode: String }
  | FileModeNotAdmitted { path: String, candidate: String, observed: String }
  | EntryProposesNoChange { path: String }
  | ProposedBlobUnreadable { path: String, detail: String }
  | ProposedBlobDisagreed { path: String, candidate: String, computed: String }

// ONE SPELLING PER ARM, PRODUCED BY THE MATCH. A log line names the arm by this token and the
// payload beside it, so a reader can recover the arm without a second vocabulary.
// ONE PREDICATE FOR "THIS CANDIDATE NAMES NO PATHS", because two consumers ask it and they must not
// answer differently. admit_heal_publication asks it to REFUSE -- publishing a commit over zero paths
// records a repair that repaired nothing. gunbc.heal_publication asks it to take the no-op arm before
// admitting at all, because gunbc.heal_candidate now writes a manifest on every successful run and an
// empty entries list is how a clean tree says so. Same question, opposite dispositions, and the
// dispositions are the callers' to make; spelling `count(entries) == 0` at both sites would be one
// predicate with two homes, and the day it gains a nuance only one of them would get it.
fn candidate_names_no_paths(c: HealRepairCandidate) -> Bool {
  count(c.entries) == 0
}

fn heal_publication_refusal_token(r: HealPublicationRefusal) -> NonEmptyStr {
  match r {
    CandidateUnreadable { detail: _ } => "CandidateUnreadable"
    CandidateFormatUnsupported { format: _ } => "CandidateFormatUnsupported"
    CandidateMemberMalformed { member: _, detail: _ } => "CandidateMemberMalformed"
    TriggeringRunNotTheCandidateProducer { workflow_path: _ } => "TriggeringRunNotTheCandidateProducer"
    TriggeringRunNotAPullRequestRun { originating_event: _ } => "TriggeringRunNotAPullRequestRun"
    TriggeringRunReachedNoVerdict => "TriggeringRunReachedNoVerdict"
    TriggeringRunSubjectDisagreed { run_head_sha: _, candidate_head_sha: _ } => "TriggeringRunSubjectDisagreed"
    TriggeringRunBranchDisagreed { run_head_branch: _, candidate_head_ref: _ } => "TriggeringRunBranchDisagreed"
    TriggeringRunRepositoryDisagreed { expected: _, observed: _ } => "TriggeringRunRepositoryDisagreed"
    CandidateRepositoryDisagreed { expected: _, candidate: _ } => "CandidateRepositoryDisagreed"
    HeadRefNotAddressable { head_ref: _ } => "HeadRefNotAddressable"
    PullRequestNumberDisagreed { candidate: _, observed: _ } => "PullRequestNumberDisagreed"
    PullRequestNotOpen { pull_number: _ } => "PullRequestNotOpen"
    PullRequestHeadRefDisagreed { candidate: _, observed: _ } => "PullRequestHeadRefDisagreed"
    BaseRefNotTheDefaultBranch { base_ref: _, default_branch: _ } => "BaseRefNotTheDefaultBranch"
    HeadMoved { expected: _, observed: _ } => "HeadMoved"
    BranchRefUnreadable { head_ref: _, detail: _ } => "BranchRefUnreadable"
    ExpectedHeadUnreadable { expected: _, detail: _ } => "ExpectedHeadUnreadable"
    BaseTreeUnreadable { tree_sha: _, detail: _ } => "BaseTreeUnreadable"
    RepairDeclarationMissing => "RepairDeclarationMissing"
    CandidateEntriesEmpty => "CandidateEntriesEmpty"
    PathPopulationDuplicated { path: _ } => "PathPopulationDuplicated"
    PathRequiresAuthorCommit { path: _ } => "PathRequiresAuthorCommit"
    PathNotPublisherAdmitted { path: _ } => "PathNotPublisherAdmitted"
    BaseTreeTruncated { tree_sha: _ } => "BaseTreeTruncated"
    BaseBlobDisagreed { path: _, candidate: _, observed: _ } => "BaseBlobDisagreed"
    BaseEntryNotARegularFile { path: _, observed_mode: _ } => "BaseEntryNotARegularFile"
    FileModeNotAdmitted { path: _, candidate: _, observed: _ } => "FileModeNotAdmitted"
    EntryProposesNoChange { path: _ } => "EntryProposesNoChange"
    ProposedBlobUnreadable { path: _, detail: _ } => "ProposedBlobUnreadable"
    ProposedBlobDisagreed { path: _, candidate: _, computed: _ } => "ProposedBlobDisagreed"
  }
}

fn heal_publication_refusal_detail(r: HealPublicationRefusal) -> String {
  match r {
    CandidateUnreadable { detail } => detail
    CandidateFormatUnsupported { format } => concat("format=", format)
    CandidateMemberMalformed { member, detail } => join(["member=", member, " ", detail], "")
    TriggeringRunNotTheCandidateProducer { workflow_path } => concat("workflow_path=", workflow_path)
    TriggeringRunNotAPullRequestRun { originating_event } => concat("event=", originating_event)
    TriggeringRunReachedNoVerdict => "the producing run was abandoned (cancelled, skipped, timed out or failed to start), so its artifacts describe no finished judgement about this head"
    TriggeringRunSubjectDisagreed { run_head_sha, candidate_head_sha } =>
      join(["run_head=", run_head_sha, " candidate_head=", candidate_head_sha], "")
    TriggeringRunBranchDisagreed { run_head_branch, candidate_head_ref } =>
      join(["run_branch=", run_head_branch, " candidate_branch=", candidate_head_ref], "")
    TriggeringRunRepositoryDisagreed { expected, observed } => join(["expected=", expected, " observed=", observed], "")
    CandidateRepositoryDisagreed { expected, candidate } => join(["expected=", expected, " candidate=", candidate], "")
    HeadRefNotAddressable { head_ref } => concat("head_ref=", head_ref)
    PullRequestNumberDisagreed { candidate, observed } =>
      join(["candidate=", to_string(candidate), " observed=", to_string(observed)], "")
    PullRequestNotOpen { pull_number } => concat("pull_number=", to_string(pull_number))
    PullRequestHeadRefDisagreed { candidate, observed } => join(["candidate=", candidate, " observed=", observed], "")
    BaseRefNotTheDefaultBranch { base_ref, default_branch } => join(["base_ref=", base_ref, " default_branch=", default_branch], "")
    HeadMoved { expected, observed } => join(["expected_head=", expected, " branch_head=", observed], "")
    BranchRefUnreadable { head_ref, detail } => join(["head_ref=", head_ref, " ", detail], "")
    ExpectedHeadUnreadable { expected, detail } => join(["expected_head=", expected, " ", detail], "")
    BaseTreeUnreadable { tree_sha, detail } => join(["tree=", tree_sha, " ", detail], "")
    RepairDeclarationMissing => "the candidate carries no repair declaration, so a commit would record zero repairs over an unstated population"
    CandidateEntriesEmpty => "the candidate names no paths; nothing to publish is not a publication"
    PathPopulationDuplicated { path } => concat("path=", path)
    PathRequiresAuthorCommit { path } => concat("path=", path)
    PathNotPublisherAdmitted { path } => concat("path=", path)
    BaseTreeTruncated { tree_sha } => concat("tree=", tree_sha)
    BaseBlobDisagreed { path, candidate, observed } => join(["path=", path, " candidate=", candidate, " observed=", observed], "")
    BaseEntryNotARegularFile { path, observed_mode } => join(["path=", path, " observed_mode=", observed_mode], "")
    FileModeNotAdmitted { path, candidate, observed } => join(["path=", path, " candidate=", candidate, " observed=", observed], "")
    EntryProposesNoChange { path } => concat("path=", path)
    ProposedBlobUnreadable { path, detail } => join(["path=", path, " ", detail], "")
    ProposedBlobDisagreed { path, candidate, computed } => join(["path=", path, " candidate=", candidate, " computed=", computed], "")
  }
}

// ── Decoding the candidate: strict, one refusal per defect ──────────────────────────────────

type CandidateDecode
  = CandidateDecoded { candidate: HealRepairCandidate }
  | CandidateUndecodable { refusal: HealPublicationRefusal }

type CandidateText
  = CandidateTextFound { text: String }
  | CandidateTextRefused { refusal: HealPublicationRefusal }

type CandidateValue
  = CandidateValueFound { value: JsonValue }
  | CandidateValueRefused { refusal: HealPublicationRefusal }

fn candidate_member(v: JsonValue, key: String) -> CandidateValue {
  match json_object_unique_member(v: v, key: key) {
    JsonMemberFound { value: found } => CandidateValueFound { value: found }
    JsonMemberAbsent => CandidateValueRefused { refusal: CandidateMemberMalformed { member: key, detail: "absent" } }
    JsonMemberDuplicated { count: _ } => CandidateValueRefused { refusal: CandidateMemberMalformed { member: key, detail: "duplicated" } }
    JsonMemberNotAnObject => CandidateValueRefused { refusal: CandidateMemberMalformed { member: key, detail: "enclosing value is not an object" } }
  }
}

fn candidate_string_member(v: JsonValue, key: String) -> CandidateText {
  match candidate_member(v: v, key: key) {
    CandidateValueRefused { refusal } => CandidateTextRefused { refusal: refusal }
    CandidateValueFound { value } =>
      match value {
        JsonString { value: s } => CandidateTextFound { text: s }
        JsonNull => CandidateTextRefused { refusal: CandidateMemberMalformed { member: key, detail: "null, expected a string" } }
        JsonBool { value: _ } => CandidateTextRefused { refusal: CandidateMemberMalformed { member: key, detail: "bool, expected a string" } }
        JsonNumber { lexeme: _ } => CandidateTextRefused { refusal: CandidateMemberMalformed { member: key, detail: "number, expected a string" } }
        JsonArray { elements: _ } => CandidateTextRefused { refusal: CandidateMemberMalformed { member: key, detail: "array, expected a string" } }
        JsonObject { members: _ } => CandidateTextRefused { refusal: CandidateMemberMalformed { member: key, detail: "object, expected a string" } }
      }
  }
}

fn candidate_nonempty_member(v: JsonValue, key: String) -> CandidateText {
  match candidate_string_member(v: v, key: key) {
    CandidateTextRefused { refusal } => CandidateTextRefused { refusal: refusal }
    CandidateTextFound { text } =>
      if text == "" {
        CandidateTextRefused { refusal: CandidateMemberMalformed { member: key, detail: "empty string" } }
      } else {
        CandidateTextFound { text: text }
      }
  }
}

type CandidateBlob
  = CandidateBlobFound { blob: GitObjectId? }
  | CandidateBlobRefused { refusal: HealPublicationRefusal }

// An object id is canonical lowercase 40-hex or it is not an object id. Uppercase, a short form, or a
// SHA-256 width all refuse here, because the publisher names a file by a blob id and substitutes the
// expected head into a REST path.
fn candidate_sha1_blob(member: String, text: String) -> CandidateBlob {
  if string_length(s: text) != 40 {
    CandidateBlobRefused { refusal: CandidateMemberMalformed { member: member, detail: "not a 40-character git object id" } }
  } else {
    match git_sha1_object_id(hex: text) {
      Absent => CandidateBlobRefused { refusal: CandidateMemberMalformed { member: member, detail: "not a canonical lowercase git object id" } }
      Present { value: oid } => CandidateBlobFound { blob: Present { value: oid } }
    }
  }
}

fn candidate_optional_blob_member(v: JsonValue, key: String) -> CandidateBlob {
  match candidate_member(v: v, key: key) {
    CandidateValueRefused { refusal } => CandidateBlobRefused { refusal: refusal }
    CandidateValueFound { value } =>
      match value {
        JsonNull => CandidateBlobFound { blob: none }
        JsonString { value: s } => candidate_sha1_blob(member: key, text: s)
        JsonBool { value: _ } => CandidateBlobRefused { refusal: CandidateMemberMalformed { member: key, detail: "bool, expected a blob id or null" } }
        JsonNumber { lexeme: _ } => CandidateBlobRefused { refusal: CandidateMemberMalformed { member: key, detail: "number, expected a blob id or null" } }
        JsonArray { elements: _ } => CandidateBlobRefused { refusal: CandidateMemberMalformed { member: key, detail: "array, expected a blob id or null" } }
        JsonObject { members: _ } => CandidateBlobRefused { refusal: CandidateMemberMalformed { member: key, detail: "object, expected a blob id or null" } }
      }
  }
}

type CandidateEntryDecode
  = CandidateEntryDecoded { entry: CandidateEntry }
  | CandidateEntryRefused { refusal: HealPublicationRefusal }

fn decode_candidate_entry(v: JsonValue) -> CandidateEntryDecode {
  match candidate_nonempty_member(v: v, key: "path") {
    CandidateTextRefused { refusal } => CandidateEntryRefused { refusal: refusal }
    CandidateTextFound { text: path } =>
      match candidate_nonempty_member(v: v, key: "mode") {
        CandidateTextRefused { refusal } => CandidateEntryRefused { refusal: refusal }
        CandidateTextFound { text: mode_text } =>
          match git_decode_tree_mode(text: mode_text as NonEmptyStr) {
            GitTreeModeRefused =>
              CandidateEntryRefused { refusal: CandidateMemberMalformed { member: "mode", detail: concat("not a git tree mode: ", mode_text) } }
            GitTreeModeDecoded { mode } =>
              match candidate_optional_blob_member(v: v, key: "base_blob") {
                CandidateBlobRefused { refusal } => CandidateEntryRefused { refusal: refusal }
                CandidateBlobFound { blob: base } =>
                  match candidate_nonempty_member(v: v, key: "proposed_blob") {
                    CandidateTextRefused { refusal } => CandidateEntryRefused { refusal: refusal }
                    CandidateTextFound { text: proposed_text } =>
                      match candidate_sha1_blob(member: "proposed_blob", text: proposed_text) {
                        CandidateBlobRefused { refusal } => CandidateEntryRefused { refusal: refusal }
                        CandidateBlobFound { blob: proposed } =>
                          match proposed {
                            Absent => CandidateEntryRefused { refusal: CandidateMemberMalformed { member: "proposed_blob", detail: "absent" } }
                            Present { value: p } =>
                              CandidateEntryDecoded {
                                entry: CandidateEntry {
                                  path: RepositoryPath { value: path as NonEmptyStr },
                                  mode: mode,
                                  base_blob: base,
                                  proposed_blob: p
                                }
                              }
                          }
                      }
                  }
              }
          }
      }
  }
}

type CandidateEntriesDecode
  = CandidateEntriesDecoded { entries: List<CandidateEntry> }
  | CandidateEntriesRefused { refusal: HealPublicationRefusal }

fn decode_candidate_entries(v: JsonValue) -> CandidateEntriesDecode {
  match candidate_member(v: v, key: "entries") {
    CandidateValueRefused { refusal } => CandidateEntriesRefused { refusal: refusal }
    CandidateValueFound { value } =>
      match value {
        JsonArray { elements } =>
          fold(elements, init: CandidateEntriesDecoded { entries: [] }, f: fn(acc, element) {
            match acc {
              CandidateEntriesRefused { refusal } => CandidateEntriesRefused { refusal: refusal }
              CandidateEntriesDecoded { entries } =>
                match decode_candidate_entry(v: element) {
                  CandidateEntryRefused { refusal } => CandidateEntriesRefused { refusal: refusal }
                  CandidateEntryDecoded { entry } => CandidateEntriesDecoded { entries: concat(entries, [entry]) }
                }
            }
          })
        JsonNull => CandidateEntriesRefused { refusal: CandidateMemberMalformed { member: "entries", detail: "null, expected an array" } }
        JsonBool { value: _ } => CandidateEntriesRefused { refusal: CandidateMemberMalformed { member: "entries", detail: "bool, expected an array" } }
        JsonNumber { lexeme: _ } => CandidateEntriesRefused { refusal: CandidateMemberMalformed { member: "entries", detail: "number, expected an array" } }
        JsonString { value: _ } => CandidateEntriesRefused { refusal: CandidateMemberMalformed { member: "entries", detail: "string, expected an array" } }
        JsonObject { members: _ } => CandidateEntriesRefused { refusal: CandidateMemberMalformed { member: "entries", detail: "object, expected an array" } }
      }
  }
}

fn decode_heal_repair_candidate(text: String) -> CandidateDecode {
  match parse_json_document(s: text) {
    JsonDocumentUnreadable { gap } =>
      CandidateUndecodable { refusal: CandidateUnreadable { detail: concat("the manifest is ", json_document_gap_text(gap: gap)) } }
    JsonDocumentParsed { value: doc } =>
      match candidate_string_member(v: doc, key: "format") {
        CandidateTextRefused { refusal } => CandidateUndecodable { refusal: refusal }
        CandidateTextFound { text: format } =>
          if format != (heal_repair_candidate_format as String) {
            CandidateUndecodable { refusal: CandidateFormatUnsupported { format: format } }
          } else {
            match candidate_nonempty_member(v: doc, key: "repository") {
              CandidateTextRefused { refusal } => CandidateUndecodable { refusal: refusal }
              CandidateTextFound { text: repository } =>
                match candidate_nonempty_member(v: doc, key: "pull_number") {
                  CandidateTextRefused { refusal } => CandidateUndecodable { refusal: refusal }
                  CandidateTextFound { text: pull_digits } =>
                    match parse_int(s: pull_digits) {
                      Absent => CandidateUndecodable { refusal: CandidateMemberMalformed { member: "pull_number", detail: "not decimal digits" } }
                      Present { value: pull_number } =>
                        if to_string(pull_number) != pull_digits {
                          CandidateUndecodable { refusal: CandidateMemberMalformed { member: "pull_number", detail: "not canonical decimal digits" } }
                        } else {
                          match candidate_nonempty_member(v: doc, key: "head_ref") {
                            CandidateTextRefused { refusal } => CandidateUndecodable { refusal: refusal }
                            CandidateTextFound { text: head_ref } =>
                              match candidate_nonempty_member(v: doc, key: "expected_head_sha") {
                                CandidateTextRefused { refusal } => CandidateUndecodable { refusal: refusal }
                                CandidateTextFound { text: expected_head } =>
                                  match candidate_sha1_blob(member: "expected_head_sha", text: expected_head) {
                                    CandidateBlobRefused { refusal } => CandidateUndecodable { refusal: refusal }
                                    CandidateBlobFound { blob: _ } =>
                                  match candidate_nonempty_member(v: doc, key: "base_ref") {
                                    CandidateTextRefused { refusal } => CandidateUndecodable { refusal: refusal }
                                    CandidateTextFound { text: base_ref } =>
                                      match candidate_nonempty_member(v: doc, key: "producer_run_id") {
                                        CandidateTextRefused { refusal } => CandidateUndecodable { refusal: refusal }
                                        CandidateTextFound { text: run_id } =>
                                          match candidate_string_member(v: doc, key: "repair_declaration") {
                                            CandidateTextRefused { refusal } => CandidateUndecodable { refusal: refusal }
                                            CandidateTextFound { text: declaration } =>
                                              match decode_candidate_entries(v: doc) {
                                                CandidateEntriesRefused { refusal } => CandidateUndecodable { refusal: refusal }
                                                CandidateEntriesDecoded { entries } =>
                                                  CandidateDecoded {
                                                    candidate: HealRepairCandidate {
                                                      repository_full_name: repository as NonEmptyStr,
                                                      pull_number: pull_number,
                                                      head_ref: head_ref as NonEmptyStr,
                                                      expected_head_sha: expected_head as CommitSha,
                                                      base_ref: base_ref as NonEmptyStr,
                                                      producer_run_id: run_id as NonEmptyStr,
                                                      repair_declaration: declaration,
                                                      entries: entries
                                                    }
                                                  }
                                              }
                                          }
                                      }
                                  }
                                  }
                              }
                          }
                        }
                    }
                }
            }
          }
      }
  }
}

// ── The publisher's OWN path policy ─────────────────────────────────────────────────────────

// THE PUBLISHER DOES NOT ACCEPT THE BRANCH'S GENERATED-ARTIFACT REGISTRY AS ITS PERMIT, and this
// is the single most important rule in the module. That registry lives in the PR's own tree, so a
// malicious or merely wrong branch could classify an arbitrary path as generated and ask a
// privileged process to write it. The policy is built from the committed-artifact paths of the
// PUBLISHER'S checkout -- the default branch the protected workflow runs from -- so a newly
// registered path becomes publishable only once that registration has itself landed.
//
// WORKFLOW PROJECTIONS ARE REFUSED WITH THEIR OWN ARM, because their remedy differs: they are
// generated and registered, and still no automation may write them -- a workflow file is the one
// path whose contents decide what later runs may do, and the publication credential carries no
// `workflows` permission. The author regenerates and commits them.
// THE STAGE0 MIRRORS ARE ADMITTED AS A DIRECTORY, NOT A ROSTER. They are not registry artifacts: the
// seed's own emission (claim_executor --regen-round-cost) decides which files under this directory
// are regenerated, including a mirror a change newly adds, and no .dag declaration lists them.
// Admission is by the path's shape -- a `.rs` file directly in this directory -- and the publisher
// still refuses every other path, a workflow projection included. The bytes are the branch's own
// regeneration; what the publisher decides is only that the path is one a regeneration may write.
data heal_stage0_mirror_directory: String = "src/v1/stage0/src"

data heal_stage0_mirror_suffix: String = ".rs"

fn path_is_stage0_mirror(path: String) -> Bool {
  starts_with(s: path, prefix: concat(heal_stage0_mirror_directory, "/"))
    && path.ends_with(suffix: heal_stage0_mirror_suffix)
    && split(s: path, delimiter: "/").length() == split(s: heal_stage0_mirror_directory, delimiter: "/").length() + 1
}

type PublisherPathPolicy {
  admitted: List<NonEmptyStr>
}

fn publisher_path_policy(committed_artifact_paths: List<String>) -> PublisherPathPolicy {
  PublisherPathPolicy {
    admitted: fold(committed_artifact_paths, init: [], f: fn(acc, p) {
      if p == "" {
        acc
      } else if is_workflow_projection_path(path: RepositoryPath { value: p as NonEmptyStr }) {
        acc
      } else {
        concat(acc, [p as NonEmptyStr])
      }
    })
  }
}

type PathAdmission
  = PathAdmitted
  | PathAdmissionRefused { refusal: HealPublicationRefusal }

fn publisher_path_admission(policy: PublisherPathPolicy, path: RepositoryPath) -> PathAdmission {
  if is_workflow_projection_path(path: path) {
    PathAdmissionRefused { refusal: PathRequiresAuthorCommit { path: path.value as String } }
  } else if any(policy.admitted, a => (a as String) == (path.value as String)) {
    PathAdmitted
  } else if path_is_stage0_mirror(path: path.value as String) {
    PathAdmitted
  } else {
    PathAdmissionRefused { refusal: PathNotPublisherAdmitted { path: path.value as String } }
  }
}

// ── What the publisher observes before it holds any credential ──────────────────────────────

// Facts about the run whose artifact carries the candidate, read from the workflow_run event GitHub
// delivered -- not from the candidate, and not from anything the pull request authored.
type TriggeringRunFacts {
  workflow_path: String
  originating_event: String
  conclusion: WorkflowRunConclusion
  head_sha: String
  head_branch: String
  head_repository_full_name: String
  repository_full_name: String
}

type PullRequestFacts {
  number: Int
  open: Bool
  head_ref: String
  base_ref: String
}

// A proposed blob as the publisher read it back: the bytes found under the blob's own name, and the
// git blob id recomputed from those bytes by the publisher's own git.
type ProposedBlobObservation
  = ProposedBlobComputed { blob_hex: String, computed_hex: String }
  | ProposedBlobReadRefused { blob_hex: String, detail: String }

type PublisherObservations {
  repository_full_name: NonEmptyStr
  default_branch: NonEmptyStr
  candidate_producer_workflow_path: NonEmptyStr
  run: TriggeringRunFacts
  pull_request: PullRequestFacts
  branch_head_sha: String
  base_tree_sha: String
  base_tree_truncated: Bool
  base_tree: List<GitTreeItemWire>
  proposed_blobs: List<ProposedBlobObservation>
}

// ── Admission ───────────────────────────────────────────────────────────────────────────────

type AdmittedEntry {
  path: RepositoryPath
  mode: GitTreeMode
  blob: GitObjectId
}

// ONLY admit_heal_publication MINTS THIS. A candidate producer can write a manifest, but it cannot
// construct an admitted publication: the value exists only as the result of the policy join below,
// so an effect that takes one has been handed something the publisher's own checks produced.
type AdmittedHealPublication sole_constructor {
  repository_full_name: NonEmptyStr
  head_ref: NonEmptyStr
  expected_head_sha: CommitSha
  base_tree_sha: String
  message: NonEmptyStr
  entries: List<AdmittedEntry>
}

type HealPublicationAdmission
  = HealPublicationAdmitted { admitted: AdmittedHealPublication }
  | HealPublicationRefused { refusal: HealPublicationRefusal }

data heal_publication_commit_subject: NonEmptyStr = "chore: regenerate drifted generated artifacts (ci auto-heal)"

// A BRANCH NAME IS SUBSTITUTED INTO A REST PATH RAW (extdeps.github.git_database), so the admitted
// alphabet is the one that cannot mis-address: ASCII letters, digits, and `.`, `_`, `-`, `/`. Git
// admits more (`#` among them), and those names refuse here rather than reach a URL.
fn head_ref_code_point_addressable(cp: Int) -> Bool {
  (cp >= 48 && cp <= 57)
    || (cp >= 65 && cp <= 90)
    || (cp >= 97 && cp <= 122)
    || cp == 46 || cp == 95 || cp == 45 || cp == 47
}

fn head_ref_is_addressable(head_ref: String) -> Bool {
  string_length(s: head_ref) > 0
    && all(chars(text: head_ref), cp => head_ref_code_point_addressable(cp: cp))
    && !string_contains(s: head_ref, pattern: "..")
}

// SUCCESS IS NOT THE ADMISSION RULE, AND STOPPED BEING ONE WHEN THE DRIFT GATE BECAME A MERGE
// BLOCKER (2026-09-19). The run that seals a candidate is the required gate, and a gate that found
// drift REFUSES -- that refusal is the block. Requiring Success would mean the publisher could only
// ever see runs with nothing to repair, so every repair would be sealed and then dropped.
//
// WHAT THE RULE PROTECTS IS STILL PROTECTED: that the run reached a verdict about this head rather
// than being abandoned. A cancelled, skipped, timed-out or startup-failed run never got there, and
// its artifacts describe no finished judgement. Failure now reads as "ran, and judged" -- every
// other admission below (repository, producer workflow, originating event, head sha, branch, pull
// request, blob and tree) is unchanged, so a failed run still cannot publish someone else's blob.
fn run_conclusion_reached_a_verdict(c: WorkflowRunConclusion) -> Bool {
  match c {
    Success => true
    Failure => true
    Cancelled => false
    Neutral => false
    Skipped => false
    TimedOut => false
    ActionRequired => false
    StartupFailure => false
  }
}

fn first_duplicate_path(entries: List<CandidateEntry>) -> String? {
  fold(entries, init: none, f: fn(acc, e) {
    match acc {
      Present { value: d } => Present { value: d }
      Absent =>
        if count(filter(entries, other => (other.path.value as String) == (e.path.value as String))) > 1 {
          Present { value: e.path.value as String }
        } else {
          none
        }
    }
  })
}

fn optional_blob_hex(blob: GitObjectId?) -> String {
  match blob {
    Absent => "absent"
    Present { value: b } => git_object_id_wire_hex(oid: b) as String
  }
}

fn base_entry_for(tree: List<GitTreeItemWire>, path: String) -> GitTreeItemWire? {
  tree |> filter(item => item.path == path) |> first
}

type EntryAdmission
  = EntryAdmitted { entry: AdmittedEntry }
  | EntryRefused { refusal: HealPublicationRefusal }

// THE BASE IS WHAT GITHUB SAYS THE EXPECTED HEAD HOLDS, and the candidate must agree with it on
// every axis before its proposal is looked at: a path present at the head must be a regular or
// executable file with the candidate's mode and the candidate's base blob; a path absent at the head
// may only be proposed as a regular file. The proposal itself must change something, and its bytes
// must hash to the id it claims.
fn admit_entry(e: CandidateEntry, o: PublisherObservations, policy: PublisherPathPolicy) -> EntryAdmission {
  let path = e.path.value as String
  match publisher_path_admission(policy: policy, path: e.path) {
    PathAdmissionRefused { refusal } => EntryRefused { refusal: refusal }
    PathAdmitted =>
      match base_entry_for(tree: o.base_tree, path: path) {
        Absent =>
          match e.base_blob {
            Present { value: b } =>
              EntryRefused { refusal: BaseBlobDisagreed { path: path, candidate: git_object_id_wire_hex(oid: b) as String, observed: "absent" } }
            Absent =>
              match e.mode {
                GitRegularBlobMode => admit_proposed_blob(e: e, o: o)
                GitExecutableBlobMode => EntryRefused { refusal: FileModeNotAdmitted { path: path, candidate: git_encode_tree_mode(mode: e.mode) as String, observed: "absent" } }
                GitSymlinkMode => EntryRefused { refusal: FileModeNotAdmitted { path: path, candidate: git_encode_tree_mode(mode: e.mode) as String, observed: "absent" } }
                GitSubtreeMode => EntryRefused { refusal: FileModeNotAdmitted { path: path, candidate: git_encode_tree_mode(mode: e.mode) as String, observed: "absent" } }
                GitlinkMode => EntryRefused { refusal: FileModeNotAdmitted { path: path, candidate: git_encode_tree_mode(mode: e.mode) as String, observed: "absent" } }
              }
          }
        Present { value: base } =>
          if base.type != "blob" || (base.mode != "100644" && base.mode != "100755") {
            EntryRefused { refusal: BaseEntryNotARegularFile { path: path, observed_mode: base.mode } }
          } else if (git_encode_tree_mode(mode: e.mode) as String) != base.mode {
            EntryRefused { refusal: FileModeNotAdmitted { path: path, candidate: git_encode_tree_mode(mode: e.mode) as String, observed: base.mode } }
          } else {
            match e.base_blob {
              Absent => EntryRefused { refusal: BaseBlobDisagreed { path: path, candidate: "absent", observed: base.sha } }
              Present { value: b } =>
                if (git_object_id_wire_hex(oid: b) as String) != base.sha {
                  EntryRefused { refusal: BaseBlobDisagreed { path: path, candidate: git_object_id_wire_hex(oid: b) as String, observed: base.sha } }
                } else if git_object_id_eq(left: b, right: e.proposed_blob) {
                  EntryRefused { refusal: EntryProposesNoChange { path: path } }
                } else {
                  admit_proposed_blob(e: e, o: o)
                }
            }
          }
      }
  }
}

fn admit_proposed_blob(e: CandidateEntry, o: PublisherObservations) -> EntryAdmission {
  let path = e.path.value as String
  let claimed = git_object_id_wire_hex(oid: e.proposed_blob) as String
  match (o.proposed_blobs |> filter(b => proposed_blob_observation_hex(o: b) == claimed) |> first) {
    Absent => EntryRefused { refusal: ProposedBlobUnreadable { path: path, detail: "no read of the blob was made" } }
    Present { value: observed } =>
      match observed {
        ProposedBlobReadRefused { blob_hex: _, detail } => EntryRefused { refusal: ProposedBlobUnreadable { path: path, detail: detail } }
        ProposedBlobComputed { blob_hex: _, computed_hex } =>
          if computed_hex != claimed {
            EntryRefused { refusal: ProposedBlobDisagreed { path: path, candidate: claimed, computed: computed_hex } }
          } else {
            EntryAdmitted { entry: AdmittedEntry { path: e.path, mode: e.mode, blob: e.proposed_blob } }
          }
      }
  }
}

fn proposed_blob_observation_hex(o: ProposedBlobObservation) -> String {
  match o {
    ProposedBlobComputed { blob_hex, computed_hex: _ } => blob_hex
    ProposedBlobReadRefused { blob_hex, detail: _ } => blob_hex
  }
}

type EntriesAdmission
  = EntriesAdmitted { entries: List<AdmittedEntry> }
  | EntriesRefused { refusal: HealPublicationRefusal }

fn admit_entries(c: HealRepairCandidate, o: PublisherObservations, policy: PublisherPathPolicy) -> EntriesAdmission {
  fold(c.entries, init: EntriesAdmitted { entries: [] }, f: fn(acc, e) {
    match acc {
      EntriesRefused { refusal } => EntriesRefused { refusal: refusal }
      EntriesAdmitted { entries } =>
        match admit_entry(e: e, o: o, policy: policy) {
          EntryRefused { refusal } => EntriesRefused { refusal: refusal }
          EntryAdmitted { entry } => EntriesAdmitted { entries: concat(entries, [entry]) }
        }
    }
  })
}

fn heal_publication_message(c: HealRepairCandidate) -> NonEmptyStr {
  join([
    heal_publication_commit_subject as String, "\n\n",
    c.repair_declaration,
    "\nHeal-Candidate-Run: ", c.producer_run_id as String, "\n"
  ], "") as NonEmptyStr
}

// ORDERED IDENTITY BEFORE CONTENT, CHEAPEST DISQUALIFIER FIRST. Which run delivered the candidate and
// which branch it describes are decided before any path is looked at, because a correct blob for the
// wrong branch is worse than a wrong one. The head comparison is the compare-and-swap's first half;
// the fast-forward-only reference update is its second, because a head that moves between this check
// and the write is exactly the race one check cannot close.
fn admit_heal_publication(
  candidate: HealRepairCandidate,
  observations: PublisherObservations,
  policy: PublisherPathPolicy
) -> HealPublicationAdmission {
  let o = observations
  let c = candidate
  let repo = o.repository_full_name as String
  if o.run.repository_full_name != repo {
    HealPublicationRefused { refusal: TriggeringRunRepositoryDisagreed { expected: repo, observed: o.run.repository_full_name } }
  } else if o.run.head_repository_full_name != repo {
    HealPublicationRefused { refusal: TriggeringRunRepositoryDisagreed { expected: repo, observed: o.run.head_repository_full_name } }
  } else if o.run.workflow_path != (o.candidate_producer_workflow_path as String) {
    HealPublicationRefused { refusal: TriggeringRunNotTheCandidateProducer { workflow_path: o.run.workflow_path } }
  } else if o.run.originating_event != "pull_request" {
    HealPublicationRefused { refusal: TriggeringRunNotAPullRequestRun { originating_event: o.run.originating_event } }
  } else if !run_conclusion_reached_a_verdict(c: o.run.conclusion) {
    HealPublicationRefused { refusal: TriggeringRunReachedNoVerdict }
  } else if (c.repository_full_name as String) != repo {
    HealPublicationRefused { refusal: CandidateRepositoryDisagreed { expected: repo, candidate: c.repository_full_name as String } }
  } else if o.run.head_sha != (c.expected_head_sha as String) {
    HealPublicationRefused { refusal: TriggeringRunSubjectDisagreed { run_head_sha: o.run.head_sha, candidate_head_sha: c.expected_head_sha as String } }
  } else if o.run.head_branch != (c.head_ref as String) {
    HealPublicationRefused { refusal: TriggeringRunBranchDisagreed { run_head_branch: o.run.head_branch, candidate_head_ref: c.head_ref as String } }
  } else if !head_ref_is_addressable(head_ref: c.head_ref as String) {
    HealPublicationRefused { refusal: HeadRefNotAddressable { head_ref: c.head_ref as String } }
  } else if o.pull_request.number != c.pull_number {
    HealPublicationRefused { refusal: PullRequestNumberDisagreed { candidate: c.pull_number, observed: o.pull_request.number } }
  } else if !o.pull_request.open {
    HealPublicationRefused { refusal: PullRequestNotOpen { pull_number: c.pull_number } }
  } else if o.pull_request.head_ref != (c.head_ref as String) {
    HealPublicationRefused { refusal: PullRequestHeadRefDisagreed { candidate: c.head_ref as String, observed: o.pull_request.head_ref } }
  } else if o.pull_request.base_ref != (o.default_branch as String) {
    HealPublicationRefused { refusal: BaseRefNotTheDefaultBranch { base_ref: o.pull_request.base_ref, default_branch: o.default_branch as String } }
  } else if (c.base_ref as String) != (o.default_branch as String) {
    HealPublicationRefused { refusal: BaseRefNotTheDefaultBranch { base_ref: c.base_ref as String, default_branch: o.default_branch as String } }
  } else if o.branch_head_sha != (c.expected_head_sha as String) {
    HealPublicationRefused { refusal: HeadMoved { expected: c.expected_head_sha as String, observed: o.branch_head_sha } }
  } else if trim(s: c.repair_declaration) == "" {
    HealPublicationRefused { refusal: RepairDeclarationMissing }
  } else if candidate_names_no_paths(c: c) {
    HealPublicationRefused { refusal: CandidateEntriesEmpty }
  } else if o.base_tree_truncated {
    HealPublicationRefused { refusal: BaseTreeTruncated { tree_sha: o.base_tree_sha } }
  } else {
    match first_duplicate_path(entries: c.entries) {
      Present { value: d } => HealPublicationRefused { refusal: PathPopulationDuplicated { path: d } }
      Absent =>
        match admit_entries(c: c, o: o, policy: policy) {
          EntriesRefused { refusal } => HealPublicationRefused { refusal: refusal }
          EntriesAdmitted { entries } =>
            HealPublicationAdmitted {
              admitted: AdmittedHealPublication {
                repository_full_name: o.repository_full_name,
                head_ref: c.head_ref,
                expected_head_sha: c.expected_head_sha,
                base_tree_sha: o.base_tree_sha,
                message: heal_publication_message(c: c),
                entries: entries
              }
            }
        }
    }
  }
}

// ── Publication, and what counts as evidence it happened ────────────────────────────────────

type PublicationWriteRefusal
  = BlobWriteRefused { path: String, detail: String }
  | BlobIdentityDisagreed { path: String, admitted: String, created: String }
  | TreeWriteRefused { detail: String }
  | CommitWriteRefused { detail: String }
  | CommitShapeDisagreed { detail: String }
  | ReferenceNotFastForward { detail: String }
  | ReferenceWriteRefused { detail: String }

// What the publisher reads back after the reference write, independently of that write's answer.
// `changed_paths` is the population GitHub's comparison of the expected head and the branch head
// reports; `head_tree` is the branch head's tree, looked up at the admitted paths.
type PublicationReadback {
  branch_head_sha: String
  head_parents: List<String>
  head_tree_sha: String
  changed_paths: List<String>
  comparison_truncated: Bool
  head_tree_truncated: Bool
  head_tree: List<GitTreeItemWire>
}

type HealPublicationReceipt {
  repository_full_name: NonEmptyStr
  head_ref: NonEmptyStr
  parent: CommitSha
  published_head: CommitSha
  tree: String
  paths: List<String>
}

type HealPublicationOutcome
  = HealPublished { receipt: HealPublicationReceipt }
  | HealPublicationWriteRefused { refusal: PublicationWriteRefusal }
  | HealPublicationUnverified { detail: String }

fn same_path_population(a: List<String>, b: List<String>) -> Bool {
  count(a) == count(b)
    && all(a, x => count(filter(b, y => y == x)) == 1)
    && all(b, y => count(filter(a, x => x == y)) == 1)
}

fn admitted_paths(admitted: AdmittedHealPublication) -> List<String> {
  map(admitted.entries, e => e.path.value as String)
}

fn readback_entry_matches(admitted: AdmittedEntry, head_tree: List<GitTreeItemWire>) -> Bool {
  match base_entry_for(tree: head_tree, path: admitted.path.value as String) {
    Absent => false
    Present { value: item } =>
      item.type == "blob"
        && item.mode == (git_encode_tree_mode(mode: admitted.mode) as String)
        && item.sha == (git_object_id_wire_hex(oid: admitted.blob) as String)
  }
}

// A SUCCESSFUL WRITE IS NOT TERMINAL EVIDENCE. The reference update's answer says the transport
// accepted the request; it does not say what the branch now names, what that commit's parent is, or
// which paths it changed. Those are read back, and a publication whose readback does not confirm
// every one of them is HealPublicationUnverified -- not published, and not a refusal either, because
// the write may well have landed. Collapsing that third state into either neighbour is how a
// half-applied publication gets reported as a clean one.
fn publication_readback_verdict(
  admitted: AdmittedHealPublication,
  created_commit_sha: String,
  created_tree_sha: String,
  readback: PublicationReadback
) -> HealPublicationOutcome {
  let paths = admitted_paths(admitted: admitted)
  if readback.branch_head_sha != created_commit_sha {
    HealPublicationUnverified { detail: join(["branch head ", readback.branch_head_sha, " is not the created commit ", created_commit_sha], "") }
  } else if count(readback.head_parents) != 1 || !any(readback.head_parents, p => p == (admitted.expected_head_sha as String)) {
    HealPublicationUnverified { detail: join(["the published commit's parents are not exactly the expected head ", admitted.expected_head_sha as String], "") }
  } else if readback.head_tree_sha != created_tree_sha {
    HealPublicationUnverified { detail: join(["the published commit names tree ", readback.head_tree_sha, ", not the created tree ", created_tree_sha], "") }
  } else if readback.comparison_truncated {
    HealPublicationUnverified { detail: "the comparison of the expected head and the published head was truncated, so the changed population is unobserved" }
  } else if !same_path_population(a: readback.changed_paths, b: paths) {
    HealPublicationUnverified { detail: join(["the published head changed [", join(readback.changed_paths, ","), "], not exactly the admitted [", join(paths, ","), "]"], "") }
  } else if readback.head_tree_truncated {
    HealPublicationUnverified { detail: "the published tree listing was truncated, so the admitted entries are unobserved" }
  } else if !all(admitted.entries, e => readback_entry_matches(admitted: e, head_tree: readback.head_tree)) {
    HealPublicationUnverified { detail: "an admitted path does not hold the admitted blob and mode at the published head" }
  } else {
    HealPublished {
      receipt: HealPublicationReceipt {
        repository_full_name: admitted.repository_full_name,
        head_ref: admitted.head_ref,
        parent: admitted.expected_head_sha,
        published_head: created_commit_sha as CommitSha,
        tree: created_tree_sha,
        paths: paths
      }
    }
  }
}

fn heal_publication_is_published(o: HealPublicationOutcome) -> Bool {
  match o {
    HealPublished { receipt: _ } => true
    HealPublicationWriteRefused { refusal: _ } => false
    HealPublicationUnverified { detail: _ } => false
  }
}

// ── THE HEAL WINDOW: a sealed candidate must be CONSUMED, within a declared bound ─────────────
//
// WHY THIS SITS WITH THE BOUNDARY IT GUARDS. `gunbc.rung_drop_amendment.heal_green_window_over_a_stale_mirror`
// names a window in which a pull request's head shows green REQUIRED checks -- v2-bootstrap, the witness
// floor -- while the repair sealed for that head has not landed. The window is not the drop: the drop is
// that row's later event, and its `bearing` already says a PUBLISHER FAILURE leaves no bound until someone
// notices. Its first specimen is heal 39378154865 with heal-publish 39383896432, ~41 minutes of exposure
// before the bot commit landed. Its second is heal 39389776978, which sealed a correct candidate for PR
// #14493 at head 8807d2405c6; heal-publish 39396236576 then FAILED at its admission step, posted nothing,
// and left that head showing heal-generated-artifacts/success, heal-fork-skipped/skipped and
// v2-bootstrap/success with no commit status at all. The green is green on MAIN'S MIRROR: the publisher is
// triggered by a `workflow_run` completion whose head_sha is main's, so the job's context belongs to main's
// commit and the PR head receives nothing from it. A reader of that head cannot distinguish "the repair
// landed" from "the repair was sealed and then dropped" -- which is exactly the reading the drop's `bearing`
// says must not be available.
//
// THE FIX IS A FOURTH THING THE PUBLISHER CAN SAY. This boundary has admitted or refused; a refusal left the
// job as an exit reason and died with the run, visible only in a run on main's sha. Here the publisher
// states, about a candidate it actually sealed, whether that candidate was CONSUMED. When it was not, the
// statement is typed (which conclusion failed to consume it), located (the record names the repository, the
// pull number, the head sha, the sealing run and the publish run it speaks for), and posted where a reader
// of the head looks -- the same comment channel the consumed receipt already uses, under the same grant.
// Green v2-bootstrap inside this window is then not evidence about the head, and cannot be mistaken for it.
//
// THE BOUND IS A FACT OF THIS MODEL, never a literal in generated yaml. It is the publisher's own liveness
// bound: the candidate's freshness check (candidate_freshness_verdict) and the publish job's wall clock are
// measured against the same declared minute count, so an elapsed time past it means the candidate is already
// untrusted AND no code left in the job can still consume it. `gunbc.heal_publisher_workflow` generates the
// job's timeout-minutes from a declared count exactly as `gunbc.heal_workflow` does with
// heal_workflow_timeout_minutes, and the guarantee-stall row named below uses this same fact as its ceiling,
// so the bound the publisher refuses at and the bound the drop is measured against cannot drift apart.
//
// PURE BY CONSTRUCTION, LIKE THE REST OF THIS MODULE. Elapsed time and the consumed-by receipt are INPUTS
// the wet publisher reads from the platform; nothing here performs a host effect, so the adjudication is
// decidable in a hermetic claim witness and cannot be steered by anything the candidate's producer wrote.

data heal_window_record_token: NonEmptyStr = "gunbc.heal-window.v1"
data heal_window_consumed_token: String = "consumed"
data heal_window_unconsumed_token: String = "unconsumed"
data heal_window_expected_head_sha_label: String = "expected_head_sha"
data heal_window_producer_run_id_label: String = "producer_run_id"
data heal_window_missing_consumed_by_detail: String = "the publish concluded without a consumed-by receipt naming the sealed candidate"

// THE BOUND, IN MINUTES, AS A DECLARED FACT OF THE PUBLISHER'S MODEL.
data heal_publication_candidate_liveness_minutes: Int = 25

// WHERE A CONSUMED-BY RECEIPT MUST BE READABLE. It is a fact the PUBLISHED HEAD carries -- this head
// consumed this candidate -- so it is only obtainable by reading the published head back.
data heal_publication_consumed_by_receipt_file_name: String = "HEAL_CONSUMED_BY"

// THE SHAPE OF A WINDOW THAT REFUSES. Each name says which conclusion failed to consume the candidate:
// it never got admitted, the write was refused, the fact needed to judge it could not be read, or the
// publish reported success while leaving no receipt that names this candidate.
type HealWindowCause
  = HealWindowNeverAdmitted { detail: String }
  | HealWindowWriteRefused { detail: String }
  | HealWindowUnverified { detail: String }
  | HealWindowConsumedWithoutProof { detail: String }

// THE STATE ITSELF. A refusal carries the conclusion that caused it, the declared bound, and the elapsed
// time observed, so a reader needs nothing outside the record to know what is missing and for how long.
type HealWindowVerdict
  = HealWindowConsumed { proof: NonEmptyStr }
  | HealWindowUnconsumed { cause: HealWindowCause, bound_minutes: Int, elapsed_secs: Int }

fn heal_window_bound_minutes() -> Int {
  heal_publication_candidate_liveness_minutes
}

fn heal_window_secs_of_minutes(minutes: Int) -> Int {
  minutes * 60
}

fn heal_window_deadline_passed(elapsed_secs: Int, bound_minutes: Int) -> Bool {
  elapsed_secs >= heal_window_secs_of_minutes(minutes: bound_minutes)
}

// A CONSUMED-BY RECEIPT IS AN IDENTITY CHECK, not a token search. The word "consumed" somewhere in a
// published head proves nothing: the receipt has to name the candidate it consumed, by the head sha it was
// sealed against AND by the run that sealed it, with both labels present in the same record. A receipt for
// some other candidate therefore cannot discharge this one, which is the confusion a stale mirror invites.
fn heal_window_consumed_by_receipt_matches(receipt: String, expected_head_sha: String, producer_run_id: String) -> Bool {
  string_contains(s: receipt, pattern: heal_window_consumed_token)
    && string_contains(s: receipt, pattern: heal_window_expected_head_sha_label)
    && string_contains(s: receipt, pattern: heal_window_producer_run_id_label)
    && string_contains(s: receipt, pattern: expected_head_sha)
    && string_contains(s: receipt, pattern: producer_run_id)
}

// THE WINDOW'S WHOLE ADJUDICATION, over facts the publisher read rather than facts anyone asserted. Two
// things make it refuse: the declared bound has been exceeded -- the candidate is already untrusted and no
// code left in the job can consume it, whether or not a receipt exists -- or the publish concluded and left
// no consumed-by receipt naming this candidate, INCLUDING a success that did, in fact, conclude: a green
// conclusion with no identity-bearing receipt is the stale-readback shape, and it does not count as consumed.
// An unmeasurable elapsed (the platform gave no parseable creation stamp) is unverified, not closed.
fn heal_window_verdict(
  producer_run_id: String,
  expected_head_sha: String,
  publish_run_concluded: Bool,
  publish_run_success: Bool,
  elapsed_secs: Int?,
  consumed_by_receipt: String?
) -> HealWindowVerdict {
  let bound = heal_window_bound_minutes()
  match elapsed_secs {
    Absent =>
      HealWindowUnconsumed {
        cause: HealWindowUnverified { detail: "the publish run gave no parseable creation stamp, so the declared bound cannot be measured" },
        bound_minutes: bound,
        elapsed_secs: 0
      }
    Present { value: elapsed } =>
      if heal_window_deadline_passed(elapsed_secs: elapsed, bound_minutes: bound) {
        HealWindowUnconsumed {
          cause: match consumed_by_receipt {
            Absent =>
              HealWindowUnverified { detail: "the declared bound has passed with the publish run not concluded, and no consumed-by receipt exists to read" }
            Present { value: receipt } =>
              if heal_window_consumed_by_receipt_matches(receipt: receipt, expected_head_sha: expected_head_sha, producer_run_id: producer_run_id) {
                HealWindowUnverified { detail: "the declared bound has passed although a consumed-by receipt names this candidate: the publish run never concluded to make it readable" }
              } else {
                HealWindowConsumedWithoutProof { detail: heal_window_missing_consumed_by_detail }
              }
          },
          bound_minutes: bound,
          elapsed_secs: elapsed
        }
      } else if !publish_run_concluded {
        HealWindowConsumed { proof: "the publish run is still inside the declared bound; the sealed candidate is being consumed" }
      } else if !publish_run_success {
        HealWindowUnconsumed {
          cause: HealWindowNeverAdmitted { detail: "the publish run concluded in failure without consuming the sealed candidate" },
          bound_minutes: bound,
          elapsed_secs: elapsed
        }
      } else {
        match consumed_by_receipt {
          Absent =>
            HealWindowUnconsumed {
              cause: HealWindowUnverified { detail: heal_window_missing_consumed_by_detail },
              bound_minutes: bound,
              elapsed_secs: elapsed
            }
          Present { value: receipt } =>
            if heal_window_consumed_by_receipt_matches(receipt: receipt, expected_head_sha: expected_head_sha, producer_run_id: producer_run_id) {
              HealWindowConsumed { proof: "the published head carries the consumed-by receipt naming this candidate" }
            } else {
              HealWindowUnconsumed {
                cause: HealWindowConsumedWithoutProof { detail: heal_window_missing_consumed_by_detail },
                bound_minutes: bound,
                elapsed_secs: elapsed
              }
            }
        }
      }
  }
}

fn heal_window_must_refuse(v: HealWindowVerdict) -> Bool {
  match v {
    HealWindowConsumed { proof: _ } => false
    HealWindowUnconsumed { cause: _, bound_minutes: _, elapsed_secs: _ } => true
  }
}

fn heal_window_cause_detail(cause: HealWindowCause) -> String {
  match cause {
    HealWindowNeverAdmitted { detail: d } => d
    HealWindowWriteRefused { detail: d } => d
    HealWindowUnverified { detail: d } => d
    HealWindowConsumedWithoutProof { detail: d } => d
  }
}

fn heal_window_cause_name(cause: HealWindowCause) -> String {
  match cause {
    HealWindowNeverAdmitted { detail: _ } => "never_admitted"
    HealWindowWriteRefused { detail: _ } => "write_refused"
    HealWindowUnverified { detail: _ } => "unverified"
    HealWindowConsumedWithoutProof { detail: _ } => "consumed_without_proof"
  }
}

// THE CAUSE, RENDERED. A cause whose name is not its detail is the kind of record a reader has to decode;
// the two are pinned together here so a refusal can never arrive as bare prose with no typed name, which is
// how the specimen's failure reached nobody.
fn heal_window_cause_text(cause: HealWindowCause) -> String {
  join([heal_window_cause_name(cause: cause), ": ", heal_window_cause_detail(cause: cause)], "")
}

// THE UNCONSUMED IDENTITY: what is missing, and WHERE the reader is being told about it. Located means the
// record carries the coordinates it speaks FOR -- not the coordinates of the run that writes it, which
// belong to main's sha -- so the record survives being read out of context.
data HealWindowLocation {
  repository_full_name: NonEmptyStr
  pull_number: Int
  head_sha: CommitSha
  head_ref: NonEmptyStr
  base_ref: NonEmptyStr
  producer_run_id: NonEmptyStr
  publish_run_id: NonEmptyStr
}

// THE LOCATED, TYPED, PR-VISIBLE RECORD. Header first (a reader scanning comments sees the token and the
// verdict word), then the coordinates, then the typed cause with the bound it exceeded and the elapsed time.
// It names the candidate it speaks for by the sealing run's id and the head sha it was sealed against, which
// is also the identity a later consumed-by receipt must match to discharge it.
fn heal_window_record_text(location: HealWindowLocation, v: HealWindowVerdict) -> String {
  let verdict_line = match v {
    HealWindowConsumed { proof: p } =>
      join(["**", heal_window_record_token, " ", heal_window_consumed_token, "** -- ", p], "")
    HealWindowUnconsumed { cause: c, bound_minutes: b, elapsed_secs: e } =>
      join(
        [
          "**", heal_window_record_token, " ", heal_window_unconsumed_token,
          "** -- a sealed heal repair candidate was NOT consumed. A green v2-bootstrap on this head is ",
          "green on main's mirror and is NOT evidence for this head: the repair sealed against it was never ",
          "applied. Cause ", heal_window_cause_text(cause: c),
          "; declared bound ", to_string(b), " minutes; elapsed ", to_string(e), " seconds."
        ],
        ""
      )
  }
  let consumed_by_line = match v {
    HealWindowConsumed { proof: _ } => ""
    HealWindowUnconsumed { cause: _, bound_minutes: _, elapsed_secs: _ } =>
      join(
        [
          "\n\nTo discharge this record, publish must conclude having consumed THIS candidate: a ",
          heal_publication_consumed_by_receipt_file_name, " receipt on the published head naming ",
          heal_window_expected_head_sha_label, "=", location.head_sha, " and ",
          heal_window_producer_run_id_label, "=", location.producer_run_id, "."
        ],
        ""
      )
  }
  join(
    [
      verdict_line,
      "\n\n",
      heal_window_record_token, " location\n",
      "- repository: ", location.repository_full_name, "\n",
      "- pull_request: #", to_string(location.pull_number), "\n",
      "- head_sha: ", location.head_sha, "\n",
      "- head_ref: ", location.head_ref, "\n",
      "- base_ref: ", location.base_ref, "\n",
      "- ", heal_window_producer_run_id_label, ": ", location.producer_run_id, "\n",
      "- publish_run_id: ", location.publish_run_id, "\n",
      consumed_by_line
    ],
    ""
  )
}

// THE SAME RECORD AS A RUN LOG LINE, for the step that refuses loudly. The job's exit reason is what a
// maintainer reading the failed step sees; it carries the same token, the same coordinates and the same
// typed cause, so the run and the pull request cannot tell two different stories about one window.
fn heal_window_run_log_text(location: HealWindowLocation, v: HealWindowVerdict) -> String {
  match v {
    HealWindowConsumed { proof: _ } =>
      join([heal_window_record_token, " ", heal_window_consumed_token, " producer_run_id=", location.producer_run_id], "")
    HealWindowUnconsumed { cause: _, bound_minutes: _, elapsed_secs: _ } =>
      join(
        [
          heal_window_record_token, " ", heal_window_unconsumed_token,
          " repository=", location.repository_full_name,
          " pull_request=", to_string(location.pull_number),
          " head_sha=", location.head_sha,
          " ", heal_window_producer_run_id_label, "=", location.producer_run_id,
          " publish_run_id=", location.publish_run_id,
          " -- ", heal_window_record_text(location: location, v: v)
        ],
        ""
      )
  }
}
