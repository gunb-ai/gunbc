import std.algebra { FreeSemigroup }
import std.decl_ref { decl_ref }
import std.optional { Absent }
import gunbc.guarantee_stall { climbs_when }
import gunbc.integration_concern { CitesDeclaration, ConcernSighting, HomeUnresolved, IntegrationConcern, PreservedObligation, SuspectedFork, Triaged, managed_host_boot_once_and_oob_boot_handoff_gate_the_same_boot_once_authorities, pxe_2c_base_revision }

data managed_host_boot_once_and_oob_boot_handoff_gate_the_same_boot_once: IntegrationConcern = IntegrationConcern {
  identity: "managed_host_boot_once_and_oob_boot_handoff_gate_the_same_boot_once",
  kind: SuspectedFork {
    authorities: managed_host_boot_once_and_oob_boot_handoff_gate_the_same_boot_once_authorities,
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "gunbc.host.managed_host_boot_once", decl_name: "plan_boot_once_on_standing"),
    tail: [
      decl_ref(module_path: "gunbc.host.managed_host_boot_once", decl_name: "settle_boot_once_read_back"),
      decl_ref(module_path: "gunbc.machine_intake.oob_boot_handoff", decl_name: "boot_readback_verdict"),
      decl_ref(module_path: "gunbc.machine_intake.oob_boot_handoff", decl_name: "oob_power_action_after_confirmed_selection"),
      decl_ref(module_path: "gunbc.host.install_boot_subject", decl_name: "install_boot_drive_handoff"),
    ],
  },
  question: "Which judgment admits a one-shot boot's power action: settle_boot_once_read_back over an observed Redfish BootObject, or boot_readback_verdict over the observed `chassis bootparam get 5` stdout -- and what does the other one become? Both enforce one property (set the override, read the controller's own answer back, and reset only if the answer still says one-shot for the device you asked for), and only one of them has an executing transport: the oob route runs live in the arrival-door and managed-host boot closures, while the managed-host boot-once plans and settles with no route of its own. A lane that used both would gate the same write twice with two models of the same controller, which is how a gate comes to disagree with the device.",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: pxe_2c_base_revision,
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "gunbc.host.install_boot_subject", decl_name: "install_boot_drive_handoff") },
        tail: [
          CitesDeclaration { declaration: decl_ref(module_path: "gunbc.machine_intake.oob_boot_handoff", decl_name: "oob_boot_handoff") },
          CitesDeclaration { declaration: decl_ref(module_path: "gunbc.host.managed_host_boot_once", decl_name: "managed_host_boot_once_consumer_frontier") },
          CitesDeclaration { declaration: decl_ref(module_path: "gunbc.host.network_install", decl_name: "network_install_boot_verdict") },
        ],
      },
      account: "SAUGHT AT PXE 2c, BY THE CONSUMER BOTH SIDES NAMED. 2c's module was written to consume 2b's planner and settle; on reaching for the transport it found the live route already did set-and-read-back-and-gate, and manager ruled (msg_51c06c2f) that the route's own verdict is the SOLE gate on the power action and that a second settle over the same bytes would not be accepted. So 2c drives the route and maps its outcome arms into an install receipt, and 2b's frontier row (managed_host_boot_once_consumer_frontier) was rewritten to say its named consumer consumed the live route instead -- it stays undissolved. WHAT IS STILL OWED: the delete-or-fold decision. Folding means one gate expressed over both controller surfaces (Redfish BootObject and IPMI boot parameter 5) with one model per surface and a single admitting entry per actuation; deleting either side today would remove the only gate that lane's own witnesses pin. 2c deliberately left both standing and added no code path that runs them over one actuation.",
    },
    tail: [],
  },
  disposition: Triaged {
    home: HomeUnresolved {
      question: "does the boot-once gate belong to the transport (each controller surface's own read-back verdict, with the planner reduced to stating intent) or to the host lane (one settle that every transport must pass through, with the route calling it before it powers)?",
    },
    preserve: [
      PreservedObligation {
        holder: decl_ref(module_path: "gunbc.machine_intake.oob_boot_handoff", decl_name: "oob_power_action_after_confirmed_selection"),
        control: Absent,
        statement: "whatever the gate becomes, the power action stays unreachable on any reading that is not the controller's own, and a caller cannot supply the read-back for itself",
      },
      PreservedObligation {
        holder: decl_ref(module_path: "gunbc.host.managed_host_boot_once", decl_name: "settle_boot_once_read_back"),
        control: Absent,
        statement: "the Redfish-field judgment (same target, still one-shot, still UEFI) and the witnesses that pin a mismatch resetting nothing survive whichever lane ends up owning the gate",
      },
    ],
    next: climbs_when(capability: "one admitting entry admits a one-shot boot over either controller surface, and the other gate is deleted or becomes a stated model of the surface it reads -- TRIGGER AND OWNER: 'boot-once consolidation, smart-crane-730', who is dispatching the decision"),
  },
}
