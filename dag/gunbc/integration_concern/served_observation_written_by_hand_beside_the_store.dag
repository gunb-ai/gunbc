  kind: SuspectedFork {
    authorities: served_observation_written_by_hand_beside_the_store_authorities,
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "gunbc.roadmap.roadmap_served_observation", decl_name: "served_observation_write_for_instance"),
    tail: [
      decl_ref(module_path: "gunbc.roadmap.roadmap_served_observation", decl_name: "served_observation_index_put"),
      decl_ref(module_path: "gunbc.roadmap.roadmap_served_observation", decl_name: "served_observation_body_put"),
    ],
  },
  question: "Who owns a durable write of a kept served-observation index or body record -- gunbc.durable_cas_file_store's committed generations, or this module's own Filesystem.Write into <instance_root>/served-observations?",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: "8d7634470095bdac5307cf31af73ea60d92753fa" as CommitSha,
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "gunbc.roadmap.roadmap_served_observation", decl_name: "served_observation_index_put") },
        tail: [
          CitesDeclaration { declaration: decl_ref(module_path: "gunbc.roadmap.roadmap_served_observation", decl_name: "served_observation_body_put") },
          CitesArtifact {
            label: "docs/probes/realization_census_1dd3eda5_2026-10-24/findings.tsv, the row gunbc.roadmap.roadmap_served_observation|storage|served_observation_write_for_instance|1 that PR 1 of the sealed-store lane narrowed rather than deleted",
            sha256: Sha256Digest { hex: "03c2cb71cb7b85a120fc2b764af36a1c0797e90ac8eb4f97350a1bb958ad1f4f" as Sha256DigestHex },
          },
        ],
      },
      account: "Read at 8d7634470095: `served_observation_index_put` (dag/gunbc/roadmap/roadmap_served_observation.dag:239) and `served_observation_body_put` (:248) each call `Filesystem.Write` on a path built from the instance root, with no expectation about what stands there; `served_observation_write_for_instance` (:258) composes them. The sealed stores in the same lane write generation-suffixed slots through `file_compare_and_set`, where a stale expectation is a typed refusal. A mutation of the library's expectation rule reddens a row for every sealed store and no row here, because the writes bypass the library -- which is the test that says the rule is kept twice. srv1's observation directories hold plain `index.json` and body files written by this route (captured under dag/test/fixture/c_roadmap2_srv1_bytes), so migrating means adopting those bytes, not replacing them.",
    },
    tail: [],
  },
  disposition: Triaged {
    home: ExistingHome { model: decl_ref(module_path: "gunbc.durable_cas_file_store", decl_name: "file_compare_and_set") },
    preserve: [
