module gunbc.integration_concern.fleet_converge_roster_vs_closed_sum

// One row of the integration-concern register.
// Its authorities are the sealed region fleet_converge_roster_vs_closed_sum_authorities in module gunbc.integration_concern
// (the seal forbids building a DistinctAuthorities value outside that module). The roster derives the row from this file (module gunbc.integration_concern.roster);
// there is no list to append to. Ported from main's block in gunbc.integration_concern
// at --row-only.

import std.algebra { FreeSemigroup }
import std.decl_ref { decl_ref }
import gunbc.guarantee_stall { climbs_when }
import gunbc.integration_concern { CitesDeclaration, ConcernSighting, ExistingHome, IntegrationConcern, Open, PreservedObligation, SuspectedFork, Triaged, fleet_converge_roster_vs_closed_sum_authorities }
import std.types { CommitSha }

// THE FLEET-CONVERGE ROSTER RE-ENUMERATES THE CLOSED SUM BY HAND (filed in the P2b facts-record
// change, 2026-11-13). After P2b every per-mode FACT has one authoring -- the single exhaustive
// fleet_converge_mode_facts row -- but the dispatch roster is still a separate hand-written list of
// every mode, because no value-level primitive reflects over a coproduct to yield its members. The
// two enumerations can therefore diverge; the failure is recorded rather than left silent.
data fleet_converge_roster_vs_closed_sum: IntegrationConcern = IntegrationConcern {
  identity: "fleet_converge_roster_vs_closed_sum",
  kind: SuspectedFork {
    authorities: fleet_converge_roster_vs_closed_sum_authorities,
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "gunbc.fleet.fleet_converge_workflow", decl_name: "fleet_converge_mode_facts"),
    tail: [decl_ref(module_path: "gunbc.fleet.fleet_converge_workflow", decl_name: "fleet_converge_workflow_modes")],
  },
  question: "Which declaration enumerates the fleet-converge modes once: the exhaustive fleet_converge_mode_facts match (its arms are the whole vocabulary, and a missing arm is a compile error) or the hand-written fleet_converge_workflow_modes roster (which orders the dispatch menu but a mode left out of it is silently absent from dispatch)? They are two enumerations of one coproduct because nothing reflects over a closed sum to produce its members at runtime. Either a value-level variant enumeration makes the roster derive from the sum, or a witness asserts every arm of fleet_converge_mode_facts appears in the roster exactly once.",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: "199f2b077548467c13b86b326229a6b009dd2263" as CommitSha,
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "gunbc.fleet.fleet_converge_workflow", decl_name: "fleet_converge_mode_facts") },
        tail: [CitesDeclaration { declaration: decl_ref(module_path: "gunbc.fleet.fleet_converge_workflow", decl_name: "fleet_converge_workflow_modes") }],
      },
      account: "P2b collapsed the six per-mode fact matches into the single exhaustive fleet_converge_mode_facts row, so each fact now has one authoring. The roster fleet_converge_workflow_modes was left hand-authored (no value-level variant enumeration exists to derive it), so membership -- unlike the facts -- still has a second place a mode can be registered or forgotten. The gap is stated on the roster itself and here rather than left silent.",
    },
    tail: [],
  },
  // TRIAGED, NOT CLOSED (smart-dove-204, 2026-11-18). The hazard this row describes -- a mode joins the
  // closed sum and its facts, is left out of the roster, and nothing turns red -- IS STILL LIVE, and this
  // row says so rather than reporting a rung the executed evidence does not establish: the wall authored
  // here is run by hand and is enrolled in no lane, so on the required path a dropped mode is still silent
  // (gunbc.design_argument::continuous_generalization: "A completed work item, a merged abstraction or a
  // shorter ledger is not evidence of integration"; gunbc.design_argument::guarantee_ladder: "A witness no
  // lane executes is not a check ... the row is what makes the refusal real"). Open, with its owed rung
  // named, which is what Triaged means here.
  // Whether the wall ran is NOT claimed in this comment. Each execution is a RetainedExecutionResult row
  // in test.claim.fleet.fleet_converge_roster_closed_sum_witness::witness_run_receipts -- command, host,
  // memory budget, window, revision and verdict -- guarded by that module's
  // witness_the_run_receipt_carrier_records_this_wall_and_says_how_it_ran; a receipt is read there, not
  // restated here (gunbc.design_argument::source_annotations: a receipt, a status and a count belong in a
  // carrier a pass can read, and a reader may not treat a comment as evidence that a machine claim holds).
  // What the wall establishes, as opposed to what it counts: it compares the roster, arm by arm, against
  // the closed sum as the compiler itself reflects it (coproduct_arm_keys), so an arm missing, an arm
  // listed twice, and an entry the sum does not name are three separate reds rather than a total that
  // happens to match; the dispatch menu is that roster mapped through fleet_converge_workflow_mode_wire,
  // walled in the same module, so the menu cannot drift from the roster either. The question's FIRST branch
  // was tried before the second was taken: the std value-level enumeration of a sum's variants,
  // coproduct_nullary_inhabitants, constructs a value per arm and therefore REFUSES any sum with a payload
  // arm ("payload arm is not nullary", src/v1/stage0/src/coproduct_reflection.rs), and this sum has one --
  // Srv1RootMutation carries Srv1RootMutationMode -- so it yields a refusal, not a member list, and cannot
  // author the roster. Both halves are pinned as rows rather than remembered: the refusal over this sum,
  // and the enumeration working where it can (the nested all-nullary arm, whose constructed inhabitants
  // agree with the arm keys read for it). The nested arm is in scope because the roster lists each of its
  // modes as its own entry, so one can go unrostered exactly as #16583's MtCollins1PcieRetimerReset would
  // have. A fixture (one arm dropped, one repeated, and an honest twin) is what makes this a wall and not a
  // tautology. The roster keeps its hand-written ORDER deliberately -- a menu whose option order shifted
  // whenever an arm happened to be declared elsewhere would be the worse artifact -- which is why the
  // witness branch, not derivation, is the shape taken.
  // WHY IT IS NOT ENROLLED, and where that is recorded. Enrollment means a row of
  // v2.workflow.required_floor.required_gate_authored_modules, which is operator-admitted
  // (gunbc.design_document::required_gate_rows_grow_by_operator_ruling) and spends the CI budget that is
  // closed to growth. The consolidating session declined to spend one on a single wall: bold-otter-603,
  // 2026-11-18, message msg_bad251bc-81ad-4853-8c6f-a68269259804, which rules the standing
  // authored-executed-by-hand-green-enrolled-nowhere-with-its-next-rung-named to be what DESIGN asks for.
  // That decision is cited here and in the two comments that name its trigger, and deliberately NOT kept as
  // a row of gunbc.design_ruling: those rows carry an operator provenance, and borrowing that register for
  // a lane-level decision would itself be the fork this file is about.
  disposition: Triaged {
    home: ExistingHome { model: decl_ref(module_path: "gunbc.fleet.fleet_converge_workflow", decl_name: "fleet_converge_mode_facts") },
    preserve: [
      PreservedObligation {
        holder: decl_ref(module_path: "gunbc.fleet.fleet_converge_workflow", decl_name: "fleet_converge_workflow_modes"),
        control: decl_ref(module_path: "test.claim.fleet.fleet_converge_roster_closed_sum_witness", decl_name: "witness_fleet_converge_roster_holds_every_closed_sum_arm_exactly_once"),
        statement: "the roster holds every arm of the closed sum FleetConvergeWorkflowMode exactly once, counting the Srv1RootMutation arm once per arm of Srv1RootMutationMode with that count read from the declaration index rather than written, and holds no entry the sum does not name -- enforced today for whoever executes the wall, and by nothing on the required path",
      },
      PreservedObligation {
        holder: decl_ref(module_path: "gunbc.fleet.fleet_converge_workflow", decl_name: "fleet_converge_mode_options"),
        control: decl_ref(module_path: "test.claim.fleet.fleet_converge_roster_closed_sum_witness", decl_name: "witness_dispatch_mode_options_are_roster_wires_without_repetition"),
        statement: "the workflow_dispatch mode menu is exactly the roster's wire strings, once each, in the roster's hand-kept order -- so a mode missing from the roster is undispatchable rather than silently absent, and the order an operator sees stays a decision rather than an accident of declaration order",
      },
    ],
    next: climbs_when(capability: "the wall is enrolled on an executing lane, so that deleting one entry from fleet_converge_workflow_modes reddens the required path rather than only whoever runs it; the trigger is gunbc.rung_drop.v1_required_lanes_withdrawn, the withdrawn v1 required lanes whose population the native compiler is to judge, which lifts every wall in this standing together rather than one wall by petition"),
  },
}
