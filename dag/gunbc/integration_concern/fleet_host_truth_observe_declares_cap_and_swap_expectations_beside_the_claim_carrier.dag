module gunbc.integration_concern.fleet_host_truth_observe_declares_cap_and_swap_expectations_beside_the_claim_carrier

// One row of the integration-concern register. The roster derives the row from this file
// (gunbc.integration_concern.roster); there is no list to append to. Filed by row
// fleet-truth-follows-the-machine (PR #17236) in response to review 99615, which named the fork this row
// records: the only production path that turns a claim into an expectation was already there, beside the
// new carrier. Recording it here rather than only in a comment follows
// gunbc.design_argument::continuous_generalization ("an unfinished reconciliation is recorded, not
// remembered") and source_annotations ("a fact that must survive belongs in a typed carrier").

import std.types { CommitSha }
import std.optional { Absent, Present }
import std.algebra { FreeSemigroup }
import std.decl_ref { decl_ref }
import gunbc.integration_concern {
  ConcernSighting, IntegrationConcern, ExistingHome, PreservedObligation, RequirementEstablished,
  SuspectedCapabilityGap, CitesDeclaration, Triaged,
}
import gunbc.guarantee_stall { climbs_when }

// The revision this sighting was made against: origin/main at the time both producers were read.
data fleet_host_truth_observe_declares_cap_and_swap_expectations_beside_the_claim_carrier_sighting_revision: CommitSha = "89aed82ed892eefe81a97589fabd6ae60a9a315c"

// The main revision the DIRECTION was decided against: the tip read at the moment the planning owner's
// ruling was relayed to this row (git and GitHub agreeing on it in the same turn).
data fleet_host_truth_observe_declares_cap_and_swap_expectations_beside_the_claim_carrier_decision_revision: CommitSha = "f87e669f2aaa514849f431fd934e93b8a360a804"

// TWO PRODUCERS OF THE SAME DECLARATION, ONE HOST, NO JOIN BETWEEN THEM.
//
// WHAT EXISTS. The observe route (row fleet-truth-per-host-read) needs a cap expectation and a swap
// expectation to compare its two readable axes against, and it builds them itself:
// gunbc.fleet.fleet_host_truth_observe::host_truth_observe_cap_expectation declares
// TruthSize { size: gunbc_runner_slot_desired().memory_max } for the cap axis and
// gunbc.fleet.fleet_host_truth_observe::host_truth_observe_swap_expectation declares
// gunbc_runner_slot_desired().memory_swap_max for the swap axis, both collected by
// gunbc.fleet.fleet_host_truth_observe::host_truth_observe_expectations and fed straight to
// gunbc.fleet.fleet_host_truth_read::fleet_host_truth_verdict_for_host. Row fleet-truth-follows-the-machine
// added a second producer for the same two axes: gunbc.fleet.fleet_desired_state_claim::ModelClaims carries a
// per-host cap claim and a per-host swap claim, and leaf_cap_claim_expectation / swap_backing_claim_expectation
// turn them into the same HostTruthDeclared shape for the same axes.
//
// WHY IT IS A FORK AND NOT MERELY DUPLICATION. Both sides decide WHAT a host's cap axis declares, and they
// decide from different sources: the observe route from the runner slot's declared shape -- one value applied to
// every host it runs on -- and the carrier from whatever the roster's own authority declares for that host. The
// operator's own specimen is the case where they part: srv4's serving engines are bounded at 40 GiB against a
// declared 56 GiB working set, which is not the runner slot. A host in that state gets two per-host verdicts that
// can state different expectations for one axis, and the one a roster relies on is not the one the standing read
// printed (gunbc.design_argument::single_authority: "a second place that independently decides it is a fork").
//
// WHY IT WAS NOT REPAIRED IN THIS ROW. Repairing it means changing the observe route to build its two
// declarations from claims -- a change to another row's module, which is at review, under the lane's standing
// order not to edit a module another open PR owns. And it is not this row's boundary: the row owns the model's
// claims and the consumer's refusal, and its boundary assigns the slot shape to gunbc.host.memory_envelope. The
// carrier is therefore interim in a SECOND way, recorded beside the first (the pairing-key row,
// gunbc.integration_concern.fleet_host_truth_pairing_keys_on_axis_alone_so_two_claims_on_one_axis_cannot_be_told_apart)
// so neither interim is discovered by collision: the model side can express one claim per axis, and the fleet has
// one host-shaped producer of those claims -- the observe route -- that does not yet use it.
data fleet_host_truth_observe_declares_cap_and_swap_expectations_beside_the_claim_carrier: IntegrationConcern = IntegrationConcern {
  identity: "fleet_host_truth_observe_declares_cap_and_swap_expectations_beside_the_claim_carrier",
  affected: FreeSemigroup {
    head: decl_ref(module_path: "gunbc.fleet.fleet_host_truth_observe", decl_name: "host_truth_observe_expectations"),
    tail: [
      decl_ref(module_path: "gunbc.fleet.fleet_host_truth_observe", decl_name: "host_truth_observe_cap_expectation"),
      decl_ref(module_path: "gunbc.fleet.fleet_host_truth_observe", decl_name: "host_truth_observe_swap_expectation"),
      decl_ref(module_path: "gunbc.fleet.fleet_desired_state_claim", decl_name: "leaf_cap_claim_expectation"),
      decl_ref(module_path: "gunbc.fleet.fleet_desired_state_claim", decl_name: "swap_backing_claim_expectation"),
      decl_ref(module_path: "gunbc.runner.runner_slot_desired", decl_name: "gunbc_runner_slot_desired"),
    ],
  },
  question: "Which producer decides what a host's cap and swap axes declare: the observe route, taking the value from the runner slot's declared shape for every host, or the claim carrier, taking it from the authority that declares that host's role -- and which one joins the other? The join has two directions and only one of them is safe: the observe route consuming claims (one producer, values from the host's own authority), or the carrier delegating to the observe route (one producer, values from the runner slot, which cannot express srv4). Whichever way it goes, the axis's declared_by must keep naming the authority the value actually came from. WHICH WAY IT WENT is not left to the reader: see this row's second sighting and its next rung.",
  kind: SuspectedCapabilityGap {
    model: decl_ref(module_path: "gunbc.fleet.fleet_host_truth_observe", decl_name: "host_truth_observe_expectations"),
    requirement: "ONE producer turns a host's model claims into expectations for every axis, so the verdict a roster relies on and the verdict the standing read prints cannot state different values for one axis of one host. Today the two readable axes have a producer inside the observe route that is fixed to the runner slot, and the model side has a second producer that carries per-host values.",
    standing: RequirementEstablished {
      by: CitesDeclaration {
        declaration: decl_ref(module_path: "gunbc.fleet.fleet_desired_state_claim", decl_name: "LeafCapClaim"),
      },
    },
  },
  sightings: [
    ConcernSighting {
      revision: fleet_host_truth_observe_declares_cap_and_swap_expectations_beside_the_claim_carrier_sighting_revision,
      evidence: FreeSemigroup {
        head: CitesDeclaration {
          declaration: decl_ref(module_path: "gunbc.fleet.fleet_host_truth_observe", decl_name: "host_truth_observe_expectations"),
        },
        tail: [
          CitesDeclaration {
            declaration: decl_ref(module_path: "gunbc.fleet.fleet_desired_state_claim", decl_name: "ModelClaims"),
          },
          CitesDeclaration {
            declaration: decl_ref(module_path: "test.claim.fleet.fleet_desired_state_follows_the_machine_witness", decl_name: "RED_leaf_cap_below_declared_working_set_diverges_and_names_its_arm"),
          },
        ],
      },
      account: "Found while building the model side of row fleet-truth-follows-the-machine, and named in review 99615 on that PR. Measured at the revision above: host_truth_observe_expectations returns exactly two HostTruthDeclared entries, cap and swap, with sizes taken from gunbc_runner_slot_desired() and declared_by naming the observe route; the three unread axes are deliberately given NO expectation so they fall into the refusal class. gunbc.fleet.fleet_desired_state_claim adds a second way to produce the same two entries from a per-host ModelClaims. Nothing calls the second way in production: its only caller today is the witness, and the follow-up row that will wire it is fleet-truth-rosters-consume-the-read. So today the two producers cannot disagree in any running route -- the fork is latent, not yet live -- which is why this row records it rather than treating it as a defect in the read route.",
    },
    ConcernSighting {
      revision: fleet_host_truth_observe_declares_cap_and_swap_expectations_beside_the_claim_carrier_decision_revision,
      evidence: FreeSemigroup {
        head: CitesDeclaration {
          declaration: decl_ref(module_path: "gunbc.fleet.fleet_desired_state_claim", decl_name: "LeafCapClaim"),
        },
        tail: [
          CitesDeclaration {
            declaration: decl_ref(module_path: "gunbc.fleet.fleet_host_truth_observe", decl_name: "host_truth_observe_cap_expectation"),
          },
        ],
      },
      account: "THE DIRECTION IS DECIDED, and this sighting is the record of the decision rather than of an observation. Relayed to this row by the lane manager on 2026-11-28 from the planning owner (Manager B): the observe route is to CONSUME claims. His reason, in the relayed form: only the claims form can express srv4's cap against the working set that host's role declares, so comparing every host against the runner slot's declared shape is this row's own failure mode -- the repository asserting a limit the host was never asked about. The requirement's standing is therefore Established, cited by the claim type that carries the per-host value the runner slot cannot express and by the observe route's cap declaration it is to replace. No roadmap row is opened for the repair, and none is needed: the repair belongs to sibling row fleet-truth-per-host-read, whose module this PR does not touch while its PR is the closest of this lane's to merge.",
    },
  ],
  disposition: Triaged {
    home: ExistingHome {
      model: decl_ref(module_path: "gunbc.fleet.fleet_host_truth_observe", decl_name: "host_truth_observe_expectations"),
    },
    preserve: [
      PreservedObligation {
        holder: decl_ref(module_path: "gunbc.fleet.fleet_host_truth_observe", decl_name: "host_truth_observe_expectations"),
        control: Present {
          value: decl_ref(module_path: "test.claim.fleet.fleet_desired_state_follows_the_machine_witness", decl_name: "RED_a_claim_with_no_current_read_refuses_rather_than_admits"),
        },
        statement: "when the observe route takes its cap and swap declarations from claims, the three unread axes keep NO expectation: an expectation paired with a refused read moves that axis out of the refusal class into a comparison, and the route's fail-closed property -- the fold can only return Refused or Diverges while an axis is unread -- is exactly what that would break",
      },
      PreservedObligation {
        holder: decl_ref(module_path: "gunbc.fleet.fleet_desired_state_claim", decl_name: "desired_state_follows_the_machine"),
        control: Absent,
        statement: "the join stays a producer join and never becomes a second admission decision: the seam passes the read module's verdict through unchanged, and joining the expectation producers must not add a rule beside gunbc.fleet.fleet_host_truth_read::fleet_truth_admits_host about which arm admits",
      },
    ],
    next: climbs_when(capability: "the observe route builds its cap and swap declarations by CONSUMING the claim carrier the roster consumer uses -- the ruled direction, not an open question: claims in, one producer, declared_by naming the authority the value actually came from, and the runner-slot value retired for hosts that never declared one -- with the planted-cap-divergence witness then running against the same declaration the standing read prints"),
  },
}
