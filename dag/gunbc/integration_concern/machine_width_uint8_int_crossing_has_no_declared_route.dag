import gunbc.integration_concern { CitesDeclaration, ConcernSighting, ExistingHome, IntegrationConcern, PreservedObligation, RequirementEstablished, SuspectedCapabilityGap, Triaged, machine_width_uint8_int_crossing_revision }

// THE MACHINE-WIDTH UInt8 <-> Int CROSSING. Origin: review 95669 on PR #16520. DESIGN.md states the
// limit in the model itself (`UInt8` is `Compose<UInt, MachineWidth<8>>`, phantom and transparent to
// `Int` across a formal; the worked example is a floor receipt observing `256` cross a `UInt8`
// parameter in `test.claim.machine_word_witness`), and the ruling decides the intended model, but
// neither claims a route -- this row is where the crossing exerts pressure.

data machine_width_uint8_int_crossing_has_no_declared_route: IntegrationConcern = IntegrationConcern {
  identity: "machine_width_uint8_int_crossing_has_no_declared_route",
  kind: SuspectedCapabilityGap {
    model: decl_ref(module_path: "std.integer", decl_name: "UInt8"),
    requirement: "a value of the machine-width composition UInt8 reaches the unbounded Int carrier through a route the model declares, and a bare Int is refused before it crosses into a UInt8 formal",
    standing: RequirementEstablished { by: CitesDeclaration { declaration: decl_ref(module_path: "gunbc.design_ruling", decl_name: "machine_width_composition_has_an_intersection_carrier") } },
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "gunbc.roadmap.roadmap_auth_routes", decl_name: "auth_base64url_wire"),
    tail: [decl_ref(module_path: "std.integer", decl_name: "uint8_of_int"), decl_ref(module_path: "std.integer", decl_name: "uint8_octets_of_ints"), decl_ref(module_path: "test.claim.machine_word_witness", decl_name: "an_octet_cannot_be_built_out_of_range_holds")],
  },
  question: "How does a List<UInt8> value reach the unbounded Int carrier, and what refuses a bare Int before it crosses into a UInt8 formal, when UInt8 is a phantom composition transparent to Int across a formal and no route is declared in either direction?",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: machine_width_uint8_int_crossing_revision,
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "gunbc.roadmap.roadmap_auth_routes", decl_name: "auth_base64url_wire") },
        tail: [CitesDeclaration { declaration: decl_ref(module_path: "test.claim.machine_word_witness", decl_name: "an_octet_cannot_be_built_out_of_range_holds") }, CitesDeclaration { declaration: decl_ref(module_path: "gunbc.design_ruling", decl_name: "machine_width_composition_has_an_intersection_carrier") }],
      },
      account: "BOTH DIRECTIONS ARE MEASURED, NEITHER IS DECLARED. The outward crossing: `gunbc.roadmap.roadmap_auth_routes.auth_base64url_wire` reads credential entropy and the PKCE challenge by mapping its octets with `o as Int` -- a `List<UInt8>` value reaching `Int` through a bare cast, because `UInt8` is `Compose<UInt, MachineWidth<8>>` and `Compose` is `Phantom`, so the composition has no declared route to the unbounded carrier anywhere in the corpus. The inward crossing is transparent rather than casted: `test.claim.machine_word_witness` once passed `[256, 0, 0]` to a `List<UInt8>` formal and COMPILED, and the file's own note records it -- `test.claim.machine_word_witness.an_octet_cannot_be_built_out_of_range_holds` pins only the mitigation's refusal, `std.integer.uint8_of_int` reporting an out-of-range member, and a caller is free to ignore that constructor and write `List<UInt8>` with any `List<Int>`. THE READING IS DECIDED, THE MODEL HAS NOT LANDED: `gunbc.design_ruling.machine_width_composition_has_an_intersection_carrier` ruled on 2026-11-01 that the composition denotes an intersection -- the algebra value restricted to the machine interval, width retained in its type -- and not a transparent alias of `UInt`; recording that ruling claims no runtime or emitted-width guarantee. THE CANDIDATE INTEGRATION IS PARKED: PR #16548, a declared total `UInt<N>` -> `Int` injection into `std.integer`, thrash-refuses in its non-required heal job near 22.5 GB on the 25.7 GB runner slot, and raising that budget is an operator decision, so no CI time or memory budget is changed here and the row stays open on the parking.",
    },
    tail: [],
  },
  disposition: Triaged {
    home: ExistingHome { model: decl_ref(module_path: "std.integer", decl_name: "UInt8") },
    preserve: [
      PreservedObligation {
        holder: decl_ref(module_path: "std.integer", decl_name: "uint8_of_int"),
        control: Present { value: decl_ref(module_path: "test.claim.machine_word_witness", decl_name: "an_octet_cannot_be_built_out_of_range_holds") },
        statement: "the checked octet constructor refuses an out-of-range member reporting the value it saw; a landing keeps the refusal and its control",
      },
      PreservedObligation {
        holder: decl_ref(module_path: "gunbc.roadmap.roadmap_auth_routes", decl_name: "auth_base64url_wire"),
        control: Absent,
        statement: "the wire refuses rather than answering with a value when octets do not qualify; a declared crossing may not turn that refusal into a substitution",
      },
    ],
    next: climbs_when(capability: "std.integer lands the ruled intersection carrier -- a checked width mint with its target realization, and the declared total UInt<N> -> Int crossing of PR #16548, parked while its non-required heal job thrash-refuses near 22.5 GB on the 25.7 GB runner slot pending an operator decision on that budget -- so sole construction makes an unadmitted octet unwritable and auth_base64url_wire consumes the qualified carrier instead of casting o as Int"),
  },
}
