module gunbc.integration_concern.h11ssl_unit3_host_key_login_admits_on_no_read_the_fleet_can_repeat

// One row of the integration-concern register. The roster derives the row from this file (module gunbc.integration_concern.roster);
// there is no list to append to. Ported from main's block in gunbc.integration_concern
// at this merge.

import std.algebra { FreeSemigroup }
import std.decl_ref { decl_ref }
import gunbc.integration_concern { CitesDeclaration, ConcernSighting, IntegrationConcern, Open, RequirementEstablished, SuspectedCapabilityGap, h11ssl_unit3_reach_report_sighting_revision }

// A HAND-PLACED KEY POPULATION THE FLEET HAS NOT REPEATED, AT A CONTESTED ADDRESS.
//
// The operator's report of 2026-11-16 says this unit's ubuntu account now carries the three fleet access
// principals' public keys, with passwordless sudo, and that ssh answers at 192.168.1.236. Nothing in this
// repository has repeated any of it, and .236 is the address gunbc.fleet.fleet_intent_network::
// srv9_host_lan_endpoint models as srv9's -- so an open row here, not an admission in the enrollment
// ledger, is where the report belongs.
data h11ssl_unit3_host_key_login_admits_on_no_read_the_fleet_can_repeat: IntegrationConcern = IntegrationConcern {
  identity: "h11ssl_unit3_host_key_login_admits_on_no_read_the_fleet_can_repeat",
  affected: FreeSemigroup {
    head: decl_ref(module_path: "gunbc.fleet.fleet_enrollment", decl_name: "fleet_enrollments"),
    tail: [
      decl_ref(module_path: "gunbc.runner.runner_connectivity_recovery", decl_name: "host_reach_admission_for_fleet_host"),
      decl_ref(module_path: "gunbc.fleet.fleet_posix_accounts", decl_name: "ground_host_access"),
      decl_ref(module_path: "gunbc.machine_intake.supermicro_h11ssl_unit3_intake_observation", decl_name: "supermicro_h11ssl_unit3_seen_host_key_fingerprint"),
      decl_ref(module_path: "gunbc.machine_intake.supermicro_h11ssl_unit3_intake_observation", decl_name: "supermicro_h11ssl_unit3_install_nic_address_standing"),
      decl_ref(module_path: "gunbc.fleet.fleet_intent_network", decl_name: "srv9_host_lan_endpoint"),
    ],
  },
  kind: SuspectedCapabilityGap {
    model: decl_ref(module_path: "gunbc.fleet.fleet_posix_accounts", decl_name: "ground_host_access"),
    requirement: "Access at a fleet host is consumed only as something the fleet REPEATED: a dispatch as one of the fleet access principals whose stdout and receipt the fleet holds, and an enrollment that mints HostKeyLoginAdmitted only from a read returning host-authored output. A hand placement plus an operator's word is neither, so this unit's reach stays refused and its account state stays ungrounded -- even though the placement is what gunbc.design_ruling::fleet_authorized_keys_on_every_install_route asks every install route to do.",
    standing: RequirementEstablished {
      by: CitesDeclaration {
        declaration: decl_ref(module_path: "gunbc.fleet.fleet_posix_accounts", decl_name: "ground_host_access"),
      },
    },
  },
  question: "What read turns the operator's 2026-11-16 report into grounded access at this host, and which row owns 192.168.1.236 until the lease says otherwise?",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: h11ssl_unit3_reach_report_sighting_revision,
      evidence: [
        CitesDeclaration {
          declaration: decl_ref(module_path: "gunbc.fleet.fleet_enrollment", decl_name: "fleet_enrollments"),
        },
        CitesDeclaration {
          declaration: decl_ref(module_path: "gunbc.machine_intake.supermicro_h11ssl_unit3_intake_observation", decl_name: "supermicro_h11ssl_unit3_install_nic_address_standing"),
        },
      ],
      account: "Transcribed from the operator's report of 2026-11-16, relayed in smart-crane-730's message to this lane: the operator's and fleet-automation's public keys were already on ubuntu@ken, node-orch@srv2's was added, ubuntu has passwordless sudo, and the box answers ssh at 192.168.1.236 -- the very address gunbc.fleet.fleet_intent_network::srv9_host_lan_endpoint models as srv9's. The report changes no verdict here: this host's enrollment row stays HostKeyLoginRefused with the reason the roster states once, because gunbc.runner.runner_connectivity_recovery::host_reach_admission_for_fleet_host puts that verdict in front of sudo-bearing recovery effects, and an effect admitted on a report could be applied at srv9. The probes from srv1 (2026-11-15 and 2026-11-16) are refused because srv1 holds none of the three private keys: they describe srv1's credentials, not this box. WHAT DISSOLVES IT: one fleet-converge dispatch as the fleet-automation principal -- the route that can reach this host -- returning host-authored output naming the account and its key population, beside the lease/ARP read naming which MAC holds .236 and a host key confirmed from this unit's own console. The receipt's sha256 is this row's dissolution, and the enrollment row moves with it.",
    },
    tail: [],
  },
  disposition: Open,
}
