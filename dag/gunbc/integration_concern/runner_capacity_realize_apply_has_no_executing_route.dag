data runner_capacity_realize_apply_has_no_executing_route: IntegrationConcern = IntegrationConcern {
  identity: "runner_capacity_realize_apply_has_no_executing_route",
  kind: SuspectedFork {
    authorities: runner_capacity_realize_apply_has_no_executing_route_authorities,
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "gunbc.runner.runner_capacity_realize", decl_name: "runner_capacity_apply_wet_exit"),
