      account: "Measured at main's released binary: an empty service parses and is refused at normalize under the namespace-graft reason, also when the module carries a function; a config-only service admits. A previous claim demanded admission and was red; PR 16897 re-pinned it to the refusal without deciding admissibility.",
    },
    tail: [],
  },
  disposition: Triaged {
    home: ExistingHome { model: decl_ref(module_path: "v2.extdeps.languages.dag", decl_name: "dag_grammar_service_decl_expr") },
