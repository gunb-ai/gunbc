import std.algebra { FreeSemigroup }
import std.decl_ref { decl_ref }
import gunbc.integration_concern { CitesDeclaration, ConcernSighting, Integrated, IntegrationConcern, Open, SuspectedFork, h11ssl_unit3_gpu_identity_receipt, h11ssl_unit3_gpu_pci_ids_receipt, h11ssl_unit3_gpu_rows_revision, h11ssl_unit3_operator_answers_revision, h11ssl_unit3_three_gpu_functions_against_two_reported_cards_authorities }

// THE UNIT'S GPU COUNT: THE OPERATOR'S REPORT AND THE READ DO NOT AGREE, and neither is thrown away.
data h11ssl_unit3_three_gpu_functions_against_two_reported_cards: IntegrationConcern = IntegrationConcern {
  identity: "h11ssl_unit3_three_gpu_functions_against_two_reported_cards",
  kind: SuspectedFork {
    authorities: h11ssl_unit3_three_gpu_functions_against_two_reported_cards_authorities,
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "gunbc.machine_intake.supermicro_h11ssl_unit3_intake_observation", decl_name: "supermicro_h11ssl_unit3_gpu_report"),
    tail: [
      decl_ref(module_path: "gunbc.fleet.gpu_device_observation", decl_name: "current_gpu_device_observations"),
      decl_ref(module_path: "gunbc.fleet.fleet_physical_inventory", decl_name: "gpu_board_assets"),
      decl_ref(module_path: "gunbc.fleet.fleet_physical_inventory", decl_name: "installed_gpu_board_containments"),
    ],
  },
  question: "Two authorities name the accelerators in this unit and answer DIFFERENTLY: the operator reported two Tesla T10 (2026-11-15 and 2026-11-17, and the same operator's own session named a third card -- 'third card: serial 1323019027149, in SLOT2 (c1:00.0)'), while the unit itself enumerates three driver-visible NVIDIA functions with three UUIDs and three serials. Which is the unit? The read rows carry THREE boards because a unit's enumeration outranks a report about it, and the report row still says TWO because a report row describes its report -- so the disagreement is visible on both sides instead of being resolved by deleting one. Closing it does NOT need the vendor:device read -- that was taken in the same session once the sysfs paths carried the PCI domain (every function read vendor 0x10de device 0x1e37, unit_read2.txt), and only the earlier unprefixed-path attempt failed. What it needs is the operator's word on the count: whether one of the two-report statements miscounted, or a fourth card exists that the driver does not show; and the ownership read of which machine answers on 192.168.1.236, which no read in this repo can yet repeat. Until then no consumer may treat this unit's GPU count as settled.",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: h11ssl_unit3_gpu_rows_revision,
      evidence: FreeSemigroup {
        head: h11ssl_unit3_gpu_identity_receipt,
        tail: [
          h11ssl_unit3_gpu_pci_ids_receipt,
          CitesDeclaration {
            declaration: decl_ref(module_path: "gunbc.machine_intake.supermicro_h11ssl_unit3_intake_observation", decl_name: "supermicro_h11ssl_unit3_gpu_report"),
          },
        ],
      },
      account: "Read on the unit 2026-11-18 in an admitted read-only session: three GPU functions (0000:01:00.0, 0000:81:00.0, 0000:c1:00.0), three GPU UUIDs, three card serials -- against a report of two Tesla T10. The same session's first attempt at the PCI ids failed on sysfs paths without the PCI domain prefix; the retry with domain-prefixed paths read vendor=0x10de device=0x1e37 class=0x030200 on each function (unit_read2.txt, cited above). So what stays open is the CARD COUNT and which machine answers on 192.168.1.236, not the ids. SETTLED IN FACT 2026-11-19 by the same source that gave the two-card figure, but the row is NOT marked Integrated in this change -- see the last sighting for why, and note that a row whose replacement declarations only exist in the change that closes it cannot name a revision that already carries them: the operator's own nvidia-smi read on the unit names THREE Tesla T10s, at 01:00.0, 81:00.0 and c1:00.0, each capped at 100 W, serving as one ken-strata server on :18081 -- the three bus ids the 2026-11-18 receipts already enumerate, so the disagreement was between a report and a later report, and the later one matches what the fleet read. The read receipt stays the authority for the enumeration; the relay is what retires the count question, and it is carried as a report (TranscribedUncited), not minted into an observed standing. The ownership half of the second ask went the same way -- the operator names the machine answering at 192.168.1.236 as this unit, hostname h11-new, tailnet ken.tailecbe08.ts.net at 100.96.80.109 -- and the reads that would confirm it in the fleet's own instruments stay owed where they are written: gunbc.machine_intake::supermicro_h11ssl_unit3_install_nic_address_standing and h11ssl_unit3_host_key_login_admits_on_no_read_the_fleet_can_repeat, which stay Open.",
    },
    tail: [
      ConcernSighting {
        revision: h11ssl_unit3_operator_answers_revision,
        evidence: FreeSemigroup {
          head: CitesDeclaration {
            declaration: decl_ref(module_path: "gunbc.machine_intake.supermicro_h11ssl_unit3_intake_observation", decl_name: "supermicro_h11ssl_unit3_gpu_count_restated_by_operator_2026_11_19"),
          },
          tail: [
            h11ssl_unit3_gpu_identity_receipt,
            h11ssl_unit3_gpu_pci_ids_receipt,
          ],
        },
        account: "The operator's own read of 2026-11-19 (relayed by chat; the fleet holds no artifact of that session) states three Tesla T10s at 01:00.0, 81:00.0 and c1:00.0, each capped at 100 W, all serving as one ken-strata server on :18081. The 2026-11-18 receipts in this repo enumerate exactly three driver-visible functions and, through the domain-prefixed sysfs paths, read vendor=0x10de device=0x1e37 on each -- so the two sources that survive disagree about nothing except the earlier report's count, and the earlier report is what the row was opened against. THE EXECUTED CONTROL, recorded here rather than in IntegrationEvidence: dag/test/claim/fleet/gpu_board_residence_witness.dag at clean main b156ebb3c2252f1f9ceac45155efb191d10534b6 (claim_batch --wet, binary sha256 e79a3d77d29acba40ef9500f0db319cdb7b422f4bc58d429038c66ce8e74bc6a built from main a7edfc30d566, which is also the interpreter that tree asks for): 7 witness(es), 7 pass, 0 fail, three read T10 boards resident in ken alone, matching the containment and current-population rows. WHY THIS ROW STAYS OPEN. IntegrationEvidence has one revision field, integrated_at: CommitSha, and no arm for a landing that has not happened: the replacement this closure introduces (the restated accelerator figure) does not exist at any revision main has, so naming the newest measured revision there would make the typed field say something the tree contradicts. Borrowing a nearby revision is the plausible fabrication fail-closed refuses. The closure is therefore recorded as Integrated in the follow-up that can name its own landing revision; until then the answer, the receipts and the run live in this sighting, and Continuous generalization is satisfied by the reconciliation being recorded rather than remembered. WHAT THE RELAY DOES NOT CLOSE, and where those questions live: whether 100 W bounds sustained or peak draw (h11ssl_unit3_t10_cap_applied_by_a_unit_the_model_cannot_express, still Open), and the bus-to-slot pairing, which gunbc.fleet.gpu_device_observation::current_gpu_device_observations keeps unread for each ken board rather than guessing a slot from a domain-prefixed bus id. The enumeration authority remains the receipts; the relay retires only the count question.",
      },
    ],
  },
  disposition: Open,
}
