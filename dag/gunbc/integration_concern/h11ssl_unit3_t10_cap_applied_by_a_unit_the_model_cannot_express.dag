module gunbc.integration_concern.h11ssl_unit3_t10_cap_applied_by_a_unit_the_model_cannot_express

// One row of the integration-concern register. The roster derives the row from this file (module gunbc.integration_concern.roster);
// there is no list to append to. Ported from main's block in gunbc.integration_concern
// at this merge.

import std.algebra { FreeSemigroup }
import std.decl_ref { decl_ref }
import gunbc.integration_concern { CitesDeclaration, ConcernSighting, IntegrationConcern, Open, RequirementUnestablished, SuspectedCapabilityGap, h11ssl_unit3_gpu_power_receipt, h11ssl_unit3_gpu_rows_revision }

// THE CAP THE MODEL HOLDS AND THE CAP THE MACHINE RUNS are two different things, and the model has a shape for
// one of them. This row says which half is missing -- it does NOT license booting the hand unit into the model.
data h11ssl_unit3_t10_cap_applied_by_a_unit_the_model_cannot_express: IntegrationConcern = IntegrationConcern {
  identity: "h11ssl_unit3_t10_cap_applied_by_a_unit_the_model_cannot_express",
  kind: SuspectedCapabilityGap {
    model: decl_ref(module_path: "gunbc.fleet.gpu_power_cap_boot_state", decl_name: "PowerCapBootUnit"),
    requirement: "THE SHAPE EXISTS AND DOES NOT FIT, which is the gap. gunbc.fleet.gpu_power_cap_boot_state models a cap mechanism AS INSTALLED -- PowerCapBootUnit carries unit_path, content_sha256, description, unit_type, wants/after/wanted_by, pre_commands, persistence_requested, cap_commands, enabled, active_state, since, read_on -- and srv1's hand-written unit stands in the corpus as precedent, with BootMechanismPresence (GunbcCapUnitAbsent) separating what gunbc installed from what was found. ken's mechanism was READ on 2026-11-18 (/etc/systemd/system/t10-power-cap.service: Type=oneshot, RemainAfterExit, After=systemd-modules-load.service, WantedBy=multi-user.target, ExecStartPre=/sbin/modprobe nvidia, ExecStart=/usr/local/sbin/t10-power-cap.sh, enabled, active-exited since 2026-11-17 22:43:09) and cannot be put in that shape without inventing four things: (1) content_sha256 -- the read cat'ed the unit and read its state but never digested the file, so its digest is unread; (2) cap_commands -- BootCapCommand addresses ONE GPU by UUID with ONE watt target, while this unit's cap lines live in a separate script that queries each GPU's OWN power floor and sets that, by enumeration INDEX, failing unless the count matches a hand-written EXPECT=3; the rule is 'cap each card at its own minimum', which has no arm here -- freezing 100 W per UUID would state a number the unit never contains; (3) no `requires` field exists on PowerCapBootUnit (only wants, after, wanted_by), so the load-bearing edge this read found cannot be carried at all: ken-strata.service declares Requires=t10-power-cap.service, meaning retiring the cap unit fails a running inference server at boot; (4) CapApplicationClaim needs the mechanism's own journal line (from_watts, to_watts, said_by) and the read did not take one, so the application-claim half cannot be written at all. WHY NO ROW WAS FORCED: minting a PowerCapBootUnit here would render a cap mechanism the converge believes it can reason about, when the corpus has no modeled NVIDIA power-limit instrument to address it (NvidiaSmiPowerLimit is a standing on a device row; the AMD hwmon route is the only modeled instrument) and this host's effects are refused (its enrollment entry carries reach_policy: HostKeyLoginRefused { reason: gunbc.fleet.fleet_enrollment::host_key_login_unavailable_reason }). A boot claim nobody can verify is what this repository calls fabrication.",
    standing: RequirementUnestablished {
      decided_by: "the operator, on whether the converge is to OWN a boot-time GPU power cap on this unit at all: the unit is prior-life state found on a hand-installed machine (gunbc.machine_intake.supermicro_h11ssl_unit3_intake_observation::supermicro_h11ssl_unit3_power_cap_setter_prior_life, standing unchanged), and nothing in the corpus decides that a found hand unit becomes a modeled input. If the answer is yes, two reads come first -- the unit file's digest and the journal's own claim lines -- and the instrument question (a modeled NVIDIA power-limit control) is the rung behind them.",
    },
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "gunbc.machine_intake.supermicro_h11ssl_unit3_intake_observation", decl_name: "supermicro_h11ssl_unit3_power_cap_setter_prior_life"),
    tail: [
      decl_ref(module_path: "gunbc.fleet.gpu_power_cap_boot_state", decl_name: "cap_boot_unit_for"),
      decl_ref(module_path: "gunbc.fleet.gpu_power_cap_boot_state", decl_name: "cap_application_claims_on"),
      decl_ref(module_path: "gunbc.fleet.gpu_power_cap_boot_state", decl_name: "BootMechanismPresence"),
      decl_ref(module_path: "gunbc.serving.gpu_power_state_policy", decl_name: "ken_t10_cap_decision"),
      decl_ref(module_path: "gunbc.serving.gpu_power_state_policy", decl_name: "installed_gpu_cap_intents"),
      decl_ref(module_path: "gunbc.fleet.gpu_device_observation", decl_name: "current_gpu_device_observations"),
    ],
  },
  question: "Does the converge take ownership of a boot-time GPU power cap on this unit -- retiring the hand unit and rendering an equivalent through the driver's power-limit control, or leaving it installed and recording it as prior life? It cannot answer by deleting: ken-strata.service Requires=t10-power-cap.service, so the cap unit is load-bearing for a service that is running today. Whichever way, the model needs things it does not have: the unit file's digest and that unit's journal claim lines (both unread, both one read away), a `requires` edge on PowerCapBootUnit, an arm for a cap rule stated as 'each card's own minimum' rather than a frozen watt number, a way to express a command delegated to a script that addresses GPUs by enumeration index and fails unless the count matches, and a modeled NVIDIA power-limit instrument the converge can address.",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: h11ssl_unit3_gpu_rows_revision,
      evidence: FreeSemigroup {
        head: h11ssl_unit3_gpu_power_receipt,
        tail: [
          CitesDeclaration {
            declaration: decl_ref(module_path: "gunbc.machine_intake.supermicro_h11ssl_unit3_intake_observation", decl_name: "supermicro_h11ssl_unit3_power_cap_setter_prior_life"),
          },
          CitesDeclaration {
            declaration: decl_ref(module_path: "gunbc.fleet.gpu_power_cap_boot_state", decl_name: "PowerCapBootUnit"),
          },
        ],
      },
      account: "Read on the unit 2026-11-18: the unit file, both hand-written units' [Unit] sections with their dependency edges, the status output and the script itself -- artifacts/host-observations/ken-gpu-read-2026-11-18/ (unit_read1.txt the unit listing and directory contents, unit_read2.txt both unit files plus the sysfs vendor/device reads, unit_read3.txt the script, the power limits and the running service's journal tail). No sha256sum of the cap unit file was taken and no `journalctl -u t10-power-cap` was run: the journal lines in the receipt belong to ken-strata.service, and the status output itself warned that some journal files were not opened for lack of permission. The limits the script leaves behind were read from the driver: 100.00 W current against 150.00 W default on all three functions.",
    },
    tail: [],
  },
  disposition: Open,
}
