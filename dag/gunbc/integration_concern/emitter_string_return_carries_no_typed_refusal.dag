          run: "claim_batch --source-root dag --source-root src/v2 --entry dag/test/claim/gunbc_invoke_witness.dag --functions <all> --hermetic, srv1, at 9064f37",
          conclusion: "PASS: an ordinary entry renders through the retyped family to byte-identical workflow shell.",
        },
        RetainedExecutionResult {
          control: decl_ref(module_path: "test.claim.gunbc_invoke_witness", decl_name: "gunbc_invoke_word_wall_refuses_metacharacter_entry_holds"),
          run: "claim_batch --source-root dag --source-root src/v2 --entry dag/test/claim/gunbc_invoke_witness.dag --functions gunbc_invoke_word_wall_refuses_metacharacter_entry_holds --hermetic, srv1, at 9064f37; AND the same witness on the origin/main tip tree (main's own sentinel witness, main's checker) at 4e98809",
          conclusion: "RED, NOT a regression from this change: the step-emitter path (gunbc_run_step_script -> gunbc_run_step_intent -> gunbc_invoke_step_emit_pipeline, orch_emit_pipeline only) does not cross the word wall -- only gunbc_run_command does -- so a hostile metacharacter entry is admitted on BOTH main and this head. Confirmed identical red on the origin/main-tip control. The step-emitter word-wall-coverage gap is owned elsewhere and is deliberately NOT fixed here; this witness is rewritten to assert the TYPED Rejected with the word-wall REASON so it turns green when that coverage lands.",
        },
      ],
