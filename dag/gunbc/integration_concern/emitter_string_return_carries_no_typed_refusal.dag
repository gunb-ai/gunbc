import gunbc.integration_concern { CitesDeclaration, ConcernSighting, HistoricalDeclaration, Integrated, IntegrationConcern, IntegrationEvidence, RequirementEstablished, RetainedExecutionResult, SuspectedCapabilityGap, emitter_string_return_carries_no_typed_refusal_review }

// THE __GUNBC_INVOKE_EMIT_REFUSED__ REFUSAL FAMILY, STATED IN ONE PLACE -- NOW INTEGRATED. The run-step
// emitter used to refuse three ways -- the word wall (gunbc_invoke_word_unsafe_poison), the orchestration
// rejection (gunbc_invoke_step_orch_refused_poison), and a target whose module derives no storage path
// (gunbc_run_step_target_unstored_poison) -- and all three collapsed their typed refusal into a marker
// STRING in the rendered bytes, which gunbc.tier_o_artifact_emit tier_o_workflow_produced later found with
// a prefix scan: a refusal rendered into anything the scan did not read travelled untyped, and the scan
// was the only gate. P2a (#16467, review 95421) filed this as its own change (the retype spans ~140
// String-returning job bodies), not P2a. This row is now integrated by that change: the invoke family
// returns a typed refusal carrier (Outcome<String>) that the job-body chain preserves, unwrapped ONCE at
// gunbc.generated_artifact_emit artifact_generate into a typed, located ArtifactGenerationRefused, and the
// three poisons together with the tier_o_workflow_produced prefix scan are deleted in the same change
// (gunbc.design_argument::replacement_migration -- the old authority ends at its root, no fallback). The
// separate __GUNBC_ORCH_EMIT_REFUSED__ sibling that the deleted scan never matched is recorded as its own
// row (gunbc.integration_concern.orch_emit_refusal_reaches_committed_bytes_unobserved), not swept under
// this closure. The retained controls are cited at the revision where the poisons and the scan existed.
data emitter_string_return_carries_no_typed_refusal: IntegrationConcern = IntegrationConcern {
  identity: "emitter_string_return_carries_no_typed_refusal",
  kind: SuspectedCapabilityGap {
    model: decl_ref(module_path: "v2.workflow.gunbc_invoke_step_emit", decl_name: "gunbc_run_step_script_for_target"),
    requirement: "a run-step emit that cannot render its target returns a typed, located refusal through the job-body chain, unwrapped once at gunbc.generated_artifact_emit artifact_generate into ArtifactGenerationRefused, rather than rendering a __GUNBC_INVOKE_EMIT_REFUSED__ marker string that the Tier O gate must later find by scanning the committed bytes (gunbc.design_argument::fail_closed: every path succeeds fully or fails with a typed, located diagnostic)",
    standing: RequirementEstablished { by: emitter_string_return_carries_no_typed_refusal_review },
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "v2.workflow.gunbc_invoke_step_emit", decl_name: "gunbc_invoke_word_unsafe_poison"),
    tail: [
      decl_ref(module_path: "v2.workflow.gunbc_invoke_step_emit", decl_name: "gunbc_invoke_step_orch_refused_poison"),
      decl_ref(module_path: "v2.workflow.gunbc_invoke_step_emit", decl_name: "gunbc_run_step_target_unstored_poison"),
      decl_ref(module_path: "gunbc.tier_o_artifact_emit", decl_name: "tier_o_workflow_produced"),
    ],
  },
  question: "close it by making the *_invoke job bodies return a typed refusal carrier (Outcome<String>) unwrapped once at artifact_generate into a typed, located ArtifactGenerationRefused, and deleting the three poisons together with the tier_o_workflow_produced prefix scan. This change did exactly that, so the mitigation it superseded -- located markers behind one prefix, the scan the only gate, and any render outside the scan's reach unguarded -- no longer stands; the refusal is typed at its source by type rather than caught by a byte scan.",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: "b45535c5d7f184b7ec9ffb687f7c387705f9b247",
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "v2.workflow.gunbc_invoke_step_emit", decl_name: "gunbc_run_step_target_unstored_poison") },
        tail: [
          CitesDeclaration { declaration: decl_ref(module_path: "v2.workflow.gunbc_invoke_step_emit", decl_name: "gunbc_invoke_word_unsafe_poison") },
          CitesDeclaration { declaration: decl_ref(module_path: "gunbc.tier_o_artifact_emit", decl_name: "tier_o_workflow_produced") },
        ],
      },
      account: "P2a added the third sibling (the unstored-target poison beside the word wall and orchestration poisons) and the Tier O prefix scan; dashboard review 95421 on gunb-ai/gunbc#16467 at head b45535c5d7f (Verdict: REQUEST_CHANGES) judged marker-string plus string_contains a fail_closed fork for the Absent arm. The family-wide retype was ruled its own change, not P2a; this row is its trigger. Dashboard review 95484 on the same PR (Verdict: REQUEST_CHANGES) refused the per-character sanitizer that had been duplicated beside the alphabet's home; this row's own citations were the proof (they named the copy by home). It is now deleted: the Absent arm renders through gunbc_invoke_sanitize_word, the family's single character map, so the family keeps ONE sanitizer and this concern tracks only the typed threading.",
    },
    tail: [],
  },
  disposition: Integrated { evidence: IntegrationEvidence {
    integrated_at: "9064f371ee2456eb1a95b63cd22cf33e7adb6954" as CommitSha,
    superseded: [
      HistoricalDeclaration { at: "bcc9f6370160fec55fcdee919590b533ffccfc4a" as CommitSha, module_path: "v2.workflow.gunbc_invoke_step_emit", decl_name: "gunbc_invoke_step_emit_refused_poison_prefix" },
      HistoricalDeclaration { at: "bcc9f6370160fec55fcdee919590b533ffccfc4a" as CommitSha, module_path: "v2.workflow.gunbc_invoke_step_emit", decl_name: "gunbc_invoke_word_unsafe_poison" },
      HistoricalDeclaration { at: "bcc9f6370160fec55fcdee919590b533ffccfc4a" as CommitSha, module_path: "v2.workflow.gunbc_invoke_step_emit", decl_name: "gunbc_invoke_step_orch_refused_poison" },
      HistoricalDeclaration { at: "bcc9f6370160fec55fcdee919590b533ffccfc4a" as CommitSha, module_path: "v2.workflow.gunbc_invoke_step_emit", decl_name: "gunbc_run_step_target_unstored_poison_prefix" },
    ],
    replacement: FreeSemigroup {
      head: decl_ref(module_path: "v2.workflow.gunbc_invoke_step_emit", decl_name: "gunbc_invoke_word_wall_diagnostic"),
      tail: [
