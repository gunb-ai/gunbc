          run: "claim_batch --source-root dag --source-root src/v2 --entry dag/test/claim/gunbc_invoke_witness.dag --functions <all> --hermetic, srv1, at 9064f37",
          conclusion: "PASS: an Absent entry path refuses at the artifact boundary with a located typed ArtifactGenerationRefused, not the deleted __GUNBC_INVOKE_EMIT_REFUSED__ string scan.",
