module gunbc.integration_concern.process_observation_construction_is_unsealed

import std.algebra { FreeSemigroup }
import std.decl_ref { decl_ref }
import std.optional { Absent }
import gunbc.guarantee_stall { climbs_when }
import gunbc.integration_concern { CitesDeclaration, ConcernSighting, HomeUnresolved, IntegrationConcern, PreservedObligation, RequirementEstablished, SuspectedCapabilityGap, Triaged }

data process_observation_construction_is_unsealed: IntegrationConcern = IntegrationConcern {
  identity: "process_observation_construction_is_unsealed",
  kind: SuspectedCapabilityGap {
    model: decl_ref(module_path: "extdeps.shell.exec", decl_name: "process_observation"),
    requirement: "process-output observations are constructible only through a sealed admission, so no caller can build a contradictory (exit_code, stdout, stderr) triple at the DAG layer -- in particular none carrying one merged text on both stream fields; a capture that cannot separate streams must refuse rather than mux",
    standing: RequirementEstablished { by: CitesDeclaration { declaration: decl_ref(module_path: "extdeps.shell.exec", decl_name: "ProcessObservation") } },
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "extdeps.shell.exec", decl_name: "process_observation"),
    tail: [decl_ref(module_path: "extdeps.shell.exec", decl_name: "ProcessObservation")],
  },
  question: "ProcessObservation and process_observation in extdeps.shell.exec are public and unsealed -- neither carries admit_callers, and the only admit_callers blocks in that module seal a different carrier -- so any caller can construct a merged-text triple and nothing refuses it. Should construction of process-output observations be sealed to the capture path, so the roadmapping row shell-dag-codex-app-server-trip-script's red_control clause 'a capture that cannot separate streams refuses rather than muxing' is enforced by the types rather than by convention?",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: "f990441e4aae05b83080f8c55142c41488f4b292",
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "extdeps.shell.exec", decl_name: "ProcessObservation") },
        tail: [CitesDeclaration { declaration: decl_ref(module_path: "gunbc.codex_app_server_press", decl_name: "parse_account_trip_stdout_for_tests") }],
      },
      account: "Seen while enrolling the sibling regression control test.claim.shell.shell_dag_codex_app_server_trip_stream_separation_witness for roadmap row shell-dag-codex-app-server-trip-script (lane ruling escalation msg_4157df93): the row's red_control clause names a capture that refuses rather than muxing, and the pinned oracle has no arm constructing a non-separable capture and showing the refusal. Census at the sighting revision: the deleted mux split_gunbc_stdio_capture survives in 5 hits repo-wide, all prose (6 today: the sixth is this row's own quotation); the old sentinel literals appear only as planted fixture data -- 2 lines in the pinned oracle's negative-data list and 2 in this control's fixtures -- with 0 hits in production code (dag/gunbc, dag/extdeps, src measured); no live function accepts one combined stream and produces both channels. The separation that does hold lives in the Rust capture path (two bounded pipe reads under separate evidence keys) and in the arms' planted-input check that no sentinel-mux behaviour is exhibited -- neither is compiler enforcement of construction.",
    },
    tail: [],
  },
  disposition: Triaged {
    home: HomeUnresolved { question: "does the seal belong on the constructors in extdeps.shell.exec (admit_callers on ProcessObservation / process_observation) or on a dedicated observation-admission carrier the capture path goes through?" },
    preserve: [PreservedObligation {
      holder: decl_ref(module_path: "gunbc.codex_app_server_press", decl_name: "parse_account_trip_session"),
      control: decl_ref(module_path: "test.claim.shell.shell_dag_codex_app_server_trip_stream_separation_witness", decl_name: "muxed_sentinels_stay_data_in_the_consumer"),
      statement: "Sentinel-shaped text arriving on a legitimately separate stdout stays data in the consumer: both planted sentinel-wrapped lines remain unknown-frame data, neither parsed nor stripped, checked by the muxed arm of test.claim.shell.shell_dag_codex_app_server_trip_stream_separation_witness (no sentinel-mux behaviour exhibited on the planted input). This obligation is KEPT after any capture seal: a separate stdout can still legitimately carry sentinel-shaped text, so a constructor seal never supersedes this consumer-side test.",
    }, PreservedObligation {
      holder: decl_ref(module_path: "extdeps.shell.exec", decl_name: "process_observation"),
      control: Absent,
      statement: "A source that supplies only combined output is refused at the capture boundary rather than producing a ProcessObservation. This is an outstanding capture-boundary requirement with no existing control. Its future control must distinguish a combined-only source from a valid separate capture whose stderr is empty -- a distinction a constructor seal alone cannot make, so sealing construction alone does not discharge this obligation.",
    }],
    next: climbs_when(capability: "The lane's roadmap row shell-dag-process-observation-sealed-carrier is created with sealed construction of process-output observations (admit_callers or an equivalent admission wall on the capture constructors), witnessed by an executed arm at the typed seam that REFUSES a merged input, AND a capture-boundary control exists that refuses a combined-only source while admitting a valid separate capture with empty stderr -- the consumer-side residue arms are kept alongside, not superseded by the seal -- at which point this row moves to Integrated."),
  },
}
