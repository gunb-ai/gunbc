module gunbc.integration_concern.broker_status_decision_is_unreceipted

// Filed with cas_fold_claims_have_no_executing_witness: the note above that row names the finding that raised both.

import std.algebra { FreeSemigroup }
import std.decl_ref { decl_ref }
import std.optional { Absent }
import gunbc.guarantee_stall { climbs_when }
import gunbc.integration_concern { CitesDeclaration, ConcernSighting, ExistingHome, IntegrationConcern, PreservedObligation, RequirementUnestablished, SuspectedCapabilityGap, Triaged }

data broker_status_decision_is_unreceipted: IntegrationConcern = IntegrationConcern {
  identity: "broker_status_decision_is_unreceipted",
  kind: SuspectedCapabilityGap {
    model: decl_ref(module_path: "gunbc.auth.approval_gate", decl_name: "approval_standing_read"),
    requirement: "an operator decision acted on by a non-operator runner job is the broker's MAC-receipted store record, verifiable by the runner with a verify-only key half, not a bare loopback status response",
    standing: RequirementUnestablished { decided_by: "approval_store_receipt_mac_key_secret_ref is not yet minted, and a verifier holding the current single key could also mint receipts, so a verify-only half must exist first" },
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "gunbc.fleet.printer_operator_approval", decl_name: "approve_and_print"),
    tail: [],
  },
  question: "How does a runner job verify that a decision read from the broker's loopback escalation-status route is the operator's recorded decision? Residual until then: a loopback-reachable forger of the status response can present Approved for the bed-clear approval, which reads that route. (The printer hold release that also read it was deleted on 2026-11-09.)",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: "b79423bb29e6b7a2804dc0bd0d3db629eb5688f4",
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "gunbc.auth.approval_gate", decl_name: "approval_standing_read") },
        tail: [],
      },
      account: "The printer job runs as the plain CI runner and cannot read the operator-only approval store, so the printer hold release reads the decision through the broker's unauthenticated loopback status route, the same route and trust as the converge's bed-clear approval. The MAC-receipted store route exists but its key is unminted.",
    },
    tail: [],
  },
  disposition: Triaged {
    home: ExistingHome { model: decl_ref(module_path: "gunbc.auth.approval_gate", decl_name: "approval_standing_read") },
    preserve: [
      PreservedObligation {
        holder: decl_ref(module_path: "gunbc.fleet.printer_operator_approval", decl_name: "approve_and_print"),
        control: Absent,
        statement: "a print starts only on an approved decision over this exact attempt; Denied, Expired, Pending and mismatched intent refuse",
      },
    ],
    next: climbs_when(capability: "the store-receipt MAC key is minted and pinned with a verify-only half the runner holds, and approval_standing_read verifies the receipt before returning a standing for the bed-clear consumer"),
  },
}
