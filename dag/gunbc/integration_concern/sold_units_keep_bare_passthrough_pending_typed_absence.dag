module gunbc.integration_concern.sold_units_keep_bare_passthrough_pending_typed_absence

// One row of the integration-concern register. The roster derives the row from this file (module gunbc.integration_concern.roster);
// there is no list to append to. Ported from main's block in gunbc.integration_concern
// at this merge.

import std.algebra { FreeSemigroup }
import std.decl_ref { decl_ref }
import std.optional { Absent }
import gunbc.guarantee_stall { climbs_when }
import gunbc.integration_concern { CitesDeclaration, ConcernSighting, ExistingHome, IntegrationConcern, PreservedObligation, RequirementUnestablished, SuspectedCapabilityGap, Triaged }
import std.types { CommitSha }

// A reach endpoint is a String projection (gunbc.fleet.fleet_reach_endpoint::fleet_probe_endpoint_for),
// so "this unit is sold, it has no endpoint" cannot be written in the type today. A SOLD Group B unit
// (in gunbc.spark.dgx_procurement::dgx_spark_disposed_units) is therefore kept OUT of the tailnet-name
// allocation rule and keeps the function's pre-existing bare-identity passthrough (srv9 -> "srv9"), so
// the sold unit is never handed the drawn MagicDNS name its retained-as-fixture allocation row would
// otherwise yield (francis/emerson/... -- a live name a new owner's device could answer). The bare id is
// the same total passthrough the function already gave unmodeled spellings, NOT an in-band sentinel.
// Fail-closed wants this absence represented in the type (an Optional endpoint or a typed SoldUnit arm),
// which is exactly what the endpoint-authority replacement cut models (an endpoint "whose ABSENCE IS
// REPRESENTABLE"). Making that change is a return-type rewrite that fans out to ~15 callers across
// fleet/host/runner (every fleet_ssh_target_at_standard_port / ProbeTargetReady / target-string build),
// so it is filed against the replacement rather than half-taken inside the old total projection.
data sold_units_keep_bare_passthrough_pending_typed_absence: IntegrationConcern = IntegrationConcern {
  identity: "sold_units_keep_bare_passthrough_pending_typed_absence",
  kind: SuspectedCapabilityGap {
    model: decl_ref(module_path: "gunbc.fleet.fleet_reach_endpoint", decl_name: "fleet_probe_endpoint_for"),
    requirement: "A host the model knows is sold must yield a typed no-endpoint, not a String that happens to name nothing and not its drawn MagicDNS tailnet name. fleet_probe_endpoint_for returns String, so a sold srv9..srv12 keeps its bare-slot passthrough (srv9 -> \"srv9\"): not the drawn name (francis.emerson.mil.bastien.tailecbe08.ts.net would hand a consumer a MagicDNS name that may now answer for another tenant's device), and not an empty sentinel. The bare id is still a string a caller could concatenate or dial; only a typed absence makes that a type error.",
    standing: RequirementUnestablished {
      decided_by: "the tailnet-name resolution change (ken pinned to ken.tailecbe08.ts.net) touches this function and forces the sold-arm decision. Representing sold absence in the type was measured to fan out to ~15 call sites that cannot be reached-and-typechecked within that change's budget; the endpoint-authority replacement cut is the designed home for a representable-absence endpoint. Filed under clever-raven-401's fallback ruling (msg_c08c60f0): when the Optional fan-out is unworkable, keep the passthrough and file this row rather than half-take a sentinel.",
    },
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "gunbc.fleet.fleet_reach_endpoint", decl_name: "fleet_probe_endpoint_for"),
    tail: [
      decl_ref(module_path: "gunbc.fleet.fleet_reach_endpoint", decl_name: "fleet_owned_probe_endpoint_for"),
    ],
  },
  question: "Where should a sold unit's reach endpoint become a typed no-endpoint rather than a String that happens to name nothing?",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: "398136026b345e087968a9db4ba42ec551c5ca4c" as CommitSha,
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "gunbc.fleet.fleet_reach_endpoint", decl_name: "fleet_owned_probe_endpoint_for") },
        tail: [],
      },
      account: "While pinning ken to its tailnet name, fleet_owned_probe_endpoint_for gains a uniform allocation-name rule; sold srv9..srv12 (dgx_spark_disposed_units, sold 2026-10-10) still carry hostname_allocation rows (francis/emerson/mil/bastien), so without a guard the rule resolves a sold unit to a live MagicDNS name. The landed short-circuit returns the bare slot string instead -- the function's existing total passthrough, not a sentinel -- because a typed Absent would change the String return and fan out to ~15 callers. The replacement cut already registers this function as the total String projection being replaced for exactly this reason.",
    },
    tail: [],
  },
  disposition: Triaged {
    home: ExistingHome { model: decl_ref(module_path: "gunbc.endpoint_authority_replacement_cut", decl_name: "endpoint_authority_cut_identity") },
    preserve: [
      PreservedObligation {
        holder: decl_ref(module_path: "test.claim.host.host_reach_identity_probe_witness", decl_name: "registry_hosts_resolve_to_tailnet_names_and_sold_units_keep_the_bare_handle"),
        control: Absent,
        statement: "a sold Group B unit (srv9/srv10) never resolves to a drawn tailnet name (francis/emerson/...) and keeps the bare handle, while every owned host with an allocation row resolves to its MagicDNS name -- the guard that must survive until the replacement lands a typed no-endpoint",
      },
    ],
    next: climbs_when(capability: "the endpoint-authority replacement (X -> Y) lands an endpoint type whose absence is representable, so fleet_probe_endpoint_for can return a typed no-endpoint for a sold unit and the bare-passthrough guard retires"),
  },
}
