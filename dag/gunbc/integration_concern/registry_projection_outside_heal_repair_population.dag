module gunbc.integration_concern.registry_projection_outside_heal_repair_population

// ONE ROW OF THE INTEGRATION REGISTER, raised while regenerating the five committed roadmap-authority
// event fixtures at 32b9202cec7c. They were stale on main -- the emitter had grown `red_at` and
// `green_at` inside `red_control` in af4a6e544944 (gunbc#16914) and nothing automatic said so. The
// class already has a home (gunbc.recurring_failure_mode.emitter_change_lands_without_regenerating_its_generated_workflow);
// what is unfinished here is WHICH route carries the registry-wide comparison, so the row is a concern
// and the ledger receipt it owes is its next rung.

import std.algebra { FreeSemigroup }
import std.decl_ref { decl_ref }
import std.optional { Absent }
import gunbc.guarantee_stall { climbs_when }
import gunbc.integration_concern {
  CitesDeclaration,
  ConcernSighting,
  ExistingHome,
  IntegrationConcern,
  PreservedObligation,
  RequirementEstablished,
  SuspectedCapabilityGap,
  Triaged,
}

data registry_projection_outside_heal_repair_population: IntegrationConcern = IntegrationConcern {
  identity: "registry_projection_outside_heal_repair_population",

  kind: SuspectedCapabilityGap {
    model: decl_ref(module_path: "gunbc.generated_artifact_registry", decl_name: "committed_generated_artifacts"),
    requirement: "every row of the committed generated-artifact registry is compared with its .dag authority by a route that runs without an author remembering to run it, so a committed projection cannot stay stale on main while every automatic route reports success",
    standing: RequirementEstablished {
      by: CitesDeclaration { declaration: decl_ref(module_path: "gunbc.generated_artifact_observation", decl_name: "observe_generated_artifact_population") },
    },
  },

  affected: FreeSemigroup {
    head: decl_ref(module_path: "gunbc.generated_artifact_registry", decl_name: "committed_generated_artifacts"),
    tail: [
      decl_ref(module_path: "gunbc.heal_workflow", decl_name: "heal_workflow_of"),
      decl_ref(module_path: "gunbc.heal_candidate_stage0", decl_name: "heal_tail_wet"),
      decl_ref(module_path: "gunbc.heal_candidate", decl_name: "heal_candidate_produce_declaring"),
      decl_ref(module_path: "gunbc.seed_build_artifact_emit", decl_name: "seed_build_artifacts"),
      decl_ref(module_path: "gunbc.regen_affected_set", decl_name: "regen_affected_set"),
      decl_ref(module_path: "gunbc.tier_o_artifact_emit", decl_name: "tier_o_artifacts"),
      decl_ref(module_path: "gunbc.instruments.generated_artifact_gate", decl_name: "main_wet"),
      decl_ref(module_path: "gunbc.roadmap.roadmap_authority_fixture", decl_name: "expected_roadmap_authority_accepted_scenario_acceptance_json"),
    ],
  },

  question: "Which route owns the registry-wide comparison? heal's round would have to observe committed_generated_artifacts() through observe_generated_artifact_population BEFORE its actuator, which today observes only the stage0 mirrors and the seed-build roster; the scheduled comparison (drift-watch.yml over gunbc.instruments.tier_o_drift_check main) walks tier_o_artifacts(), fifteen fixed rows plus the per-host sudoers, and would have to widen to the registry; or the generated-artifact drift phase returns to a required lane, which gunbc.rung_drop.required_gate_bankruptcy dropped precisely because no merge could wait for it. The three differ in what they refuse and what they write, so this is a decision and not a merge.",

  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: "32b9202cec7c559fefd44da47ce7965e2ad6f99a",
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "gunbc.roadmap.roadmap_authority_fixture", decl_name: "expected_roadmap_authority_accepted_scenario_acceptance_json") },
        tail: [
          CitesDeclaration { declaration: decl_ref(module_path: "gunbc.generated_artifact_registry", decl_name: "committed_generated_artifacts") },
          CitesDeclaration { declaration: decl_ref(module_path: "gunbc.heal_candidate_stage0", decl_name: "heal_tail_wet") },
          CitesDeclaration { declaration: decl_ref(module_path: "gunbc.tier_o_artifact_emit", decl_name: "tier_o_artifacts") },
        ],
      },
      account: "EXECUTED AT THIS REVISION: `gunbc run --source-root dag --source-root src/v2 --entry dag/gunbc/instruments/generated_artifact_gate.dag --function main_wet`, on a gunbc built from this checkout (gunbc --version prints 32b9202cec7c559fefd44da47ce7965e2ad6f99a), 49 minutes, exit 0, zero REFUSED markers in the run log and none in the bytes. Of the whole committed roster it rewrote EXACTLY the five files under fixtures/roadmap_authority/events -- every other committed projection regenerated byte-identical -- so this was the only registry drift on main. The committed bytes were still what they were before af4a6e544944 (gunbc#16914): `red_control` carried variant, witness_module, witness_fn and executed_on only, while the emitter's own receipt (roadmap_authority_fixture_receipt) has carried the on-main observation (red_at and green_at) since that commit added the observation to RedControlExecuted, so the wire text, each event id, and the two child events' `parent` links all moved. WHY HEAL DID NOT FLAG IT: the heal job's authority, gunbc.heal_workflow heal_workflow_of, gives the job two regeneration steps and no comparison over the registry -- `claim_executor --regen-round-cost --base-mirror --regen-affected-scope` over the stage0 mirrors (the selection is gunbc.regen_affected_set, whose three sources all key on MIRROR products) and `gunbc.heal_candidate_stage0 heal_tail_wet`, which writes seed_build_artifact_emit's roster and then proposes the candidate from exactly those two populations, the mirror directory listing plus the seed-build paths, through heal_candidate_produce_declaring. No registry projection is in either population, and the job never invokes main_wet, main_wet_one or the drift gate, so heal held no observation of these five paths to disagree about and reported success. The scheduled comparison does not cover them either: drift-watch.yml runs gunbc.instruments.tier_o_drift_check main over tier_o_artifacts(), which names none of them, and heal triggers on pull_request and workflow_dispatch only -- never on a push to main, which is where the lag lived. MEASURED ON THE LAGGING HEADS (gh run list at each PR head; git show at each head): at 9f7df3bfb759 (gunbc#16914, the emitter change itself), e5abe7b5983a (#16971) and 4813a739df85 (#16993) the carrier dag/gunbc/roadmap/roadmap_authority_fixture.dag already declared the observation -- one red_at line each -- while the committed fixtures/roadmap_authority/events/roadmap-authority-scenario-accepted/01-acceptance.json carried none, zero, and on every one of those heads both automatic routes completed success: heal in 43m6s (run 45164756058), 15m51s (45297719184) and 19m19s (45356505858), witnesses in 47m13s (45164756092), 46m30s (45297719109) and 6m56s (45356505804). The other three heads -- 05a270b23fcf (#16975), a3d11ef247c4 (#16990), 73fbbeb1d497 (#16992) -- likewise completed heal and witnesses successfully. NOT READ: the step logs of those runs, so whether the floor offered the witness that compares these five committed bytes with artifact_generate (test.claim.roadmap.roadmap_authority::witness_committed_fixture_bytes_are_the_encoders_own) on those heads is unmeasured; what IS measured is that whatever it offered, it answered success against a committed projection its own carrier contradicted.",
    },
    tail: [],
  },

  disposition: Triaged {
    home: ExistingHome {
      model: decl_ref(module_path: "gunbc.recurring_failure_mode.emitter_change_lands_without_regenerating_its_generated_workflow", decl_name: "emitter_change_lands_without_regenerating_its_generated_workflow"),
    },
    preserve: [
      PreservedObligation {
        holder: decl_ref(module_path: "gunbc.instruments.generated_artifact_gate", decl_name: "main_wet"),
        control: Absent,
        statement: "whatever route is chosen, the emitter stays the only author of a projection's bytes and gunbc.instruments.generated_artifact_gate write_generated_artifact the only thing that puts them on disk: no fix hand-edits a committed projection, and no second writer is given a path the registry already owns (the same two-writers-for-one-file wall heal_candidate_stage0 refuses on)",
      },
    ],
    next: climbs_when(capability: "one automatic route adjudicates every committed_generated_artifacts() row against its authority and reports a located finding -- heal's pre-actuator observation, the scheduled Tier O roster widened to the registry, or a restored required phase -- AND this incident is appended as a receipt to the recurring-failure-mode row this concern triages to, which cannot land beside this PR: docs/design-failure-modes.md is itself a committed projection of that ledger, so the append owes a wet run of its own"),
  },
}
