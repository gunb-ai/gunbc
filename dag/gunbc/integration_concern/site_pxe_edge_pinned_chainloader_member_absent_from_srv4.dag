module gunbc.integration_concern.site_pxe_edge_pinned_chainloader_member_absent_from_srv4

// One row of the integration-concern register. The roster derives the row from this file (module gunbc.integration_concern.roster);
// there is no list to append to. Ported from main's block in gunbc.integration_concern
// at merge 20: main 18cabce704f (#16564).

import std.algebra { FreeSemigroup }
import std.decl_ref { decl_ref }
import std.optional { Absent }
import std.content_hash { Sha256Digest, Sha256DigestHex }
import gunbc.integration_concern { CitesArtifact, CitesDeclaration, ConcernSighting, Distinct, IntegrationConcern, RequirementEstablished, SuspectedCapabilityGap, h11ssl_unit3_edge_live_read_revision, h11ssl_unit3_intake_sighting_revision }

// A PINNED EDGE MEMBER THE BOX DOES NOT CARRY -- filed open on the strength of a wire line, then CLOSED AS
// DISTINCT by reading the code that produced that line. The finding is real (srv4 lacks the file); what was
// wrong was my claim about what it blocks. The account below keeps both, because the wrong half is the part a
// reader must not repeat.
data site_pxe_edge_pinned_chainloader_member_absent_from_srv4: IntegrationConcern = IntegrationConcern {
  identity: "site_pxe_edge_pinned_chainloader_member_absent_from_srv4",
  kind: SuspectedCapabilityGap {
    model: decl_ref(module_path: "gunbc.fleet.site_pxe_edge_converge", decl_name: "site_pxe_edge_chainloader_pin"),
    requirement: "srv4 does not carry the pinned Aarch64 chainloader where the pin says it is installed: the read-only observation's digest of /srv/gunbc-site-pxe-edge/tftp/snponly.efi returns 'No such file or directory', the entry types that member member-unobservable (the chain cause MemberUnobservable, reached through site_pxe_edge_digest_causes) and withholds the Aarch64 chain, and the run's verdict line reads terminal=REFUSED. What I first read into that -- that the absence blocks every mode that must digest the pinned set, an apply included -- is refuted by the code that printed it, and the model had already declared the state. site_pxe_edge_tftp_root's own comment: the converge NEVER writes into the TFTP root, the binary's bytes have no producer in this repository yet, so it is observed at its pinned digest or refused. site_pxe_edge_chainloader_pin's own comment: 'The file is NOT on srv4: the gate still closes on the chainloader observation until a wet step places it at site_pxe_edge_chainloader_path and the post-placement sha256 agrees with this digest', naming that placement as a declared later change gated on operator approval of the srv4 write. And site_pxe_edge_run_succeeded decides the two modes differently: its SitePxeEdgeObserveOnly arm fails when any WITHHELD chain carries a cause that site_pxe_edge_chain_cause_is_unobserved calls unobserved (MemberUnobservable true; ChainUnpinned and MemberDigestMismatch false), while its SitePxeEdgeApply arm never consults run.chains at all -- it asks only for gate_causes empty, a settled package, settled file outcomes, a settled stale set and activation held, and a chainloader digest failure is a chain cause, never a gate cause. So the absence closes the READ-ONLY gate this lifecycle owes (an observe of this edge can only report REFUSED until the member is placed, though it still prints its readings), and it does not close an apply. What remains for the edge owner, not for the model: the placement step itself, and the standing of the Aarch64 chain in the meantime, since a withheld chain renders no pxe-service line for its architecture.",
    standing: RequirementEstablished {
      by: CitesArtifact {
        label: "artifacts/receipts/site-pxe-edge-observe-main-run-43789720870-2026-11-16/00_README.txt (the run's wire block, and the code read that settled which mode the refusal belongs to: the two verdict arms, the chain-cause predicate, and what the cmp leg's exit=1 actually answers)",
        sha256: Sha256Digest { hex: "64235c5b3529da5c91408f612b497363c8c887f070d600c4092b44927e8b6dc2" as Sha256DigestHex },
      },
    },
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "gunbc.fleet.site_pxe_edge_converge", decl_name: "site_pxe_edge_chainloader_pin"),
    tail: [
      decl_ref(module_path: "gunbc.fleet.site_pxe_edge_converge", decl_name: "site_pxe_edge_chain_pins"),
      decl_ref(module_path: "gunbc.fleet.site_pxe_edge_converge", decl_name: "site_pxe_edge_tftp_root"),
      decl_ref(module_path: "gunbc.fleet.site_pxe_edge_converge", decl_name: "site_pxe_edge_run_succeeded"),
      decl_ref(module_path: "gunbc.fleet.site_pxe_edge_converge", decl_name: "site_pxe_edge_chain_cause_is_unobserved"),
      decl_ref(module_path: "gunbc.machine_intake.supermicro_h11ssl_unit3_intake_observation", decl_name: "supermicro_h11ssl_unit3_edge_sighting"),
    ],
  },
  question: "Who places the pinned chainloader at site_pxe_edge_chainloader_path, on whose approval, and what is the Aarch64 chain's standing on this edge while it is withheld from the render?",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: h11ssl_unit3_edge_live_read_revision,
      evidence: FreeSemigroup {
        head: CitesArtifact {
          label: "artifacts/receipts/site-pxe-edge-observe-main-run-43789720870-2026-11-16/observe_wire_lines.txt (the failed digest leg and the 'chain Aarch64 withheld member-unobservable' line, from the entry itself)",
          sha256: Sha256Digest { hex: "7f3956a28b3b07223163d0f868d7fabb5b4c51c1633d5ce8384eda6c2801f415" as Sha256DigestHex },
        },
        tail: [],
      },
      account: "Sighted by still-fox-404 on 2026-11-16, in the middle of producing the read-only diff this lane owes before any edge cleanup. The observe dispatched at main reached srv4 over the fleet roster and read the pinned members; the Aarch64 chainloader leg failed with the file absent, and the entry refused rather than pretending. Note the honesty of the failure: the mode reported the absence instead of skipping the member, and the workflow published an evidence artifact whose only content is a header line, because the run took no readings. Not sighted then: whether any Aarch64 host PXEs off srv4 today, whether the file was ever staged, or which mode the refusal belonged to.",
    },
    tail: [
      ConcernSighting {
        revision: h11ssl_unit3_intake_sighting_revision,
        evidence: FreeSemigroup {
          head: CitesDeclaration {
            declaration: decl_ref(module_path: "gunbc.fleet.site_pxe_edge_converge", decl_name: "site_pxe_edge_run_succeeded"),
          },
          tail: [
            CitesDeclaration {
              declaration: decl_ref(module_path: "gunbc.fleet.site_pxe_edge_converge", decl_name: "site_pxe_edge_chain_cause_is_unobserved"),
            },
            CitesArtifact {
              label: "artifacts/receipts/site-pxe-edge-observe-main-run-43789720870-2026-11-16/00_README.txt (the code read, written down where the wire block it explains lives)",
              sha256: Sha256Digest { hex: "64235c5b3529da5c91408f612b497363c8c887f070d600c4092b44927e8b6dc2" as Sha256DigestHex },
            },
          ],
        },
        account: "Sighted by still-fox-404 on 2026-11-16 at main revision 22649d22d2fd15332770e4c344fecc8c388b89f6, while reading the code that emitted the wire line above, and it REFUTES the first sighting's consequence. The model already declares the absence (site_pxe_edge_tftp_root's comment: the converge never writes the TFTP root; site_pxe_edge_chainloader_pin's comment: the file is NOT on srv4, and the gate closes on the chainloader observation until a wet placement step puts it there and the post-placement sha256 agrees -- a declared later change gated on operator approval of the srv4 write, owned by the edge lane rather than by this one). site_pxe_edge_run_succeeded then splits the two modes: the SitePxeEdgeObserveOnly arm fails on any withheld chain whose cause site_pxe_edge_chain_cause_is_unobserved calls unobserved (MemberUnobservable true, ChainUnpinned false, MemberDigestMismatch false), while the SitePxeEdgeApply arm never reads run.chains and a chainloader digest failure is a chain cause, not a gate cause. So 'blocks every apply' was wrong: it blocks the READ-ONLY gate, which is the gate this lifecycle's cleanup owes, and an apply is free to proceed and to render the Aarch64 chain withheld. The same reading closes a second overstatement of mine: the `cmp -s - /etc/gunbc-site-pxe-edge.dnsmasq.conf (exit=1)` leg is observe_site_pxe_edge_file's own far-side comparison (typed_remote_file_compare_argv), exit 1 being that leg's ANSWER (EdgeFileDiffers), and the ObserveOnly arm fails only on EdgeFileUnobservable -- a differing live config is normal observe output, and the CI step's nonzero exit is the entry's ProcessExit, not that leg failing.",
      },
    ],
  },
  disposition: Distinct {
    reason: "Closed as distinct, not withdrawn: the file really is absent, but the obstacle is already owned and already declared elsewhere, and my filed consequence was wrong. The state is declared in the pin and in site_pxe_edge_tftp_root's comment, and the repair is a declared later change -- a wet step placing artifacts/ipxe/snponly-arm64.efi at site_pxe_edge_chainloader_path with the post-placement sha256 checked against the pin, gated on operator approval of the srv4 write -- which belongs to the site PXE edge lane (smart-crane-730's bring-up plan), not to a host bring-up. What is genuinely mine and stays recorded: while the member is absent an OBSERVE of this edge can only report terminal=REFUSED (site_pxe_edge_run_succeeded's ObserveOnly arm), so the read-only diff a cleanup owes prints its readings under a refused verdict until that placement step runs; an apply is not blocked by it.",
    scope_examined: "site_pxe_edge_run_succeeded (both arms, term by term), site_pxe_edge_chain_cause_is_unobserved and the chain causes built by site_pxe_edge_digest_causes (Absent and ChainloaderDigestUnobservable both reaching MemberUnobservable), site_pxe_edge_chainloader_pin with its build-receipt comment, site_pxe_edge_tftp_root's comment, observe_site_pxe_edge_file with typed_remote_file_compare_argv (the far-side cmp), and the wire block of workflow run 43789720870 transcribed in the cited receipt.",
  },
}
