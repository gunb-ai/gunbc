    },
    tail: [
      ConcernSighting {
        revision: spark_endpoint_rows_integrated_revision,
        evidence: FreeSemigroup {
          head: CitesDeclaration {
            declaration: decl_ref(module_path: "gunbc.spark.dgx_procurement", decl_name: "dgx_spark_disposed_units"),
