    model: decl_ref(module_path: "product.fabric.execution", decl_name: "ExecutionGrant"),
    requirement: "PR 4/5 must admit and deduplicate the exact committed attempt and grant at the executor. Controller ownership transfer fences state writes, not an already committed launch or process spawn.",
    standing: RequirementEstablished { by: CitesDeclaration { declaration: decl_ref(module_path: "gunbc.plans.durable_work_handoff", decl_name: "durable_work_handoff_plan") } },
  },
  affected: FreeSemigroup { head: decl_ref(module_path: "product.fabric.execution", decl_name: "ExecutionGrant"), tail: [decl_ref(module_path: "gunbc.fabric.fabric_control_plane", decl_name: "CellReservation"), decl_ref(module_path: "gunbc.runner.runner_revision_job_launch", decl_name: "revision_job_launch_plan")] },
  question: "PR 4/5 must admit and deduplicate the exact committed attempt and grant at the executor. Controller ownership transfer fences state writes, not an already committed launch or process spawn.",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: "1961e4984bf295a8c12e1bd9122b1edcb350b502",
      evidence: FreeSemigroup { head: CitesDeclaration { declaration: decl_ref(module_path: "gunbc.plans.durable_work_handoff", decl_name: "durable_work_handoff_plan") }, tail: [] },
      account: "PR 3 extends attempt_lifecycle with owner/acquisition-epoch authorization and same-slot CAS. A launch committed before ownership transfer is reconciled, not revoked. PR 4/5 owns executor admission, deduplication and fencing; a CAS result is not proof of quiescence or permission to release resources.",
    },
    tail: [],
