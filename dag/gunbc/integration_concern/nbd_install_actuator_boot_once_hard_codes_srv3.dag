module gunbc.integration_concern.nbd_install_actuator_boot_once_hard_codes_srv3

import std.algebra { FreeSemigroup }
import std.decl_ref { decl_ref }
import std.optional { Absent }
import gunbc.guarantee_stall { climbs_when }
import gunbc.integration_concern { CitesDeclaration, ConcernSighting, HomeUnresolved, IntegrationConcern, PreservedObligation, SuspectedFork, Triaged, nbd_boot_once_sighting_revision, nbd_install_actuator_boot_once_hard_codes_srv3_authorities }

data nbd_install_actuator_boot_once_hard_codes_srv3: IntegrationConcern = IntegrationConcern {
  identity: "nbd_install_actuator_boot_once_hard_codes_srv3",
  kind: SuspectedFork {
    authorities: nbd_install_actuator_boot_once_hard_codes_srv3_authorities,
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "gunbc.nbd_proxy_virtual_media_install", decl_name: "os_install_actuator_steps"),
    tail: [
      decl_ref(module_path: "gunbc.provisioning.network_boot_actuation", decl_name: "network_boot_arm_actuator_steps"),
      decl_ref(module_path: "gunbc.provisioning.provisioning_arm", decl_name: "provisioning_arm_derive"),
    ],
  },
  question: "Is the boot-once over a host's bound controller one authority, or two? The managed-host boot-once derives its controller from the managed-host row and gates its reset on a read-back; the nbd install actuator hard-codes its controller to srv3 and does not read back. Do they collapse into one, or are they distinct concerns that merely share the override+reset shape?",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: nbd_boot_once_sighting_revision,
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "gunbc.nbd_proxy_virtual_media_install", decl_name: "boot_once_step") },
        tail: [
          CitesDeclaration { declaration: decl_ref(module_path: "gunbc.nbd_proxy_virtual_media_install", decl_name: "ActuatorBootOnce") },
          CitesDeclaration { declaration: decl_ref(module_path: "gunbc.host.managed_host_boot_once", decl_name: "boot_once_plan_for_managed_host") },
        ],
      },
      account: "The install actuator has no managed-host identity: os_install_actuator_steps is keyed on (arm, boot_control, export) only, its sole production callers are internal to gunbc.nbd_proxy_virtual_media_install, and network_boot_actuation/network_boot_arm_actuator_steps/ProvisioningArm carry boot_control+boot_target+arm shape with no host, so the boot-once controller is hard-coded to srv3_host in the realization. The host-generic managed-host boot-once derives the controller from the managed-host row and its BMC binding, never an address passed in, and gates its reset on a read-back before the boot. They serve different concerns (an OS-install sequence step vs a managed-fleet one-shot boot), which is why the deletion did not merge them here, but the srv3 hard-code is a defect either way: a second managed host cannot get a boot-once from its own rows over the install actuator.",
    },
    tail: [],
  },
  disposition: Triaged {
    home: HomeUnresolved { question: "does the boot-once over a bound controller live in the managed-host boot-once (extended to emit the install-sequence step), or in a generalized nbd boot_once_step whose controller is row-derived -- or both over one shared planner?" },
    preserve: [
      PreservedObligation {
        holder: decl_ref(module_path: "gunbc.nbd_proxy_virtual_media_install", decl_name: "os_install_actuator_steps"),
        control: Absent,
        statement: "the install actuator's other steps (nbd proxy serve, media insert, PXE staging, firmware) and their refusals are not the boot-once and must keep working when the boot-once step is generalized",
      },
    ],
    next: climbs_when(capability: "a managed-host identity is threaded through provisioning_arm, network_boot_actuation and the nbd boot_once_step, so the install actuator's boot-once controller comes from the host's row and BMC binding (never an address passed in) and its reset is gated on a read-back; the srv3 hard-code is deleted with that threading"),
  },
}
