module gunbc.integration_concern.serve_binary_identity_unvalidated_at_serve_time

// One row of the integration-concern register. The roster derives the row from this file (module gunbc.integration_concern.roster);
// there is no list to append to.

import std.algebra { FreeSemigroup }
import std.decl_ref { decl_ref }
import std.types { CommitSha }
import gunbc.integration_concern { CitesDeclaration, ConcernSighting, IntegrationConcern, Open, RequirementEstablished, SuspectedCapabilityGap }

data serve_binary_identity_unvalidated_at_serve_time: IntegrationConcern = IntegrationConcern {
  identity: "serve_binary_identity_unvalidated_at_serve_time",
  kind: SuspectedCapabilityGap {
    model: decl_ref(module_path: "gunbc.compute.remote_build_serve", decl_name: "remote_build_forced_command_words"),
    requirement: "the binary the remote-build account's SSH forced command execs is checked against the identity the serving converge pinned at the instant a serve request is handled, not only whenever a serving converge last ran",
    standing: RequirementEstablished { by: CitesDeclaration { declaration: decl_ref(module_path: "gunbc.compute.remote_build_serve", decl_name: "remote_build_serve_provide") } },
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "gunbc.compute.remote_build_serve", decl_name: "remote_build_forced_command_words"),
    tail: [decl_ref(module_path: "gunbc.compute.remote_build_serving_converge", decl_name: "converge_install_binary"), decl_ref(module_path: "gunbc.compute.remote_build_serve", decl_name: "parse_serve_binary_identity")],
  },
  question: "What proves, at the moment a remote-build request is served, that the file the forced command execs is the binary the serving converge pinned -- and who closes the window between a converge reading that file's digest and the serve route execing whatever the path holds when a request arrives?",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: "767af989deb2a5ee96345a8fe09e53d343dc8b96" as CommitSha,
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "gunbc.compute.remote_build_serving_converge", decl_name: "converge_install_binary") },
        tail: [CitesDeclaration { declaration: decl_ref(module_path: "gunbc.compute.remote_build_serve", decl_name: "remote_build_forced_command_words") }, CitesDeclaration { declaration: decl_ref(module_path: "gunbc.compute.remote_build_serving_setup", decl_name: "serving_subject_value_deviation") }],
      },
      account: "A fleet serving converge of 2026-11-20 (run 44779656976, head 767af989deb2) reported srv3's serve binary as settled -- all items met, InstallServeBinary a no-op -- yet a live gate against srv3's serve that same evening refused an equality mainline had admitted since caeac322c7b7, while seeds built at 2387c5493bb9 accept it. The converge's identity for that binary is a single digest of the file the forced command execs, read at observe time and compared to the job's freshly built pin; its arms mint the comparison only when the file is present and the digest was read, and reach settled only on equality, so at the observe instant that file matched the current build. srv4's converge (run 44782848445) likewise scored the binary Met, yet a ctrl remote-build client dispatch of current main to srv4 also refused the same equality at compute_seat_ensure.dag:167. Two independent hosts scoring the binary Met and then both refusing the equality on the serve route cuts against a stale or swapped binary: the refusal may not originate in the binary at all, but in host-side state on the serve route (a persistent compile cache, or an environment variable on the forced command or the account) or in the corpus the serve resolves. BINARY STALENESS IS NOT ESTABLISHED and is attributed to no actor; the cause is open. What is established is narrower and is the gap this row names: within the model the sole governed writer of that path is converge_install_binary (RecordServeIdentity writes only the sidecar; live_deploy serve_binary is a different artifact and the remote-build serving instance is actuation: DashboardObserveOnly), and the converge fixes the binary's identity as a one-time digest at observe time -- nothing re-validates the file the forced command execs against that pinned identity when a request is actually served, so a serve route can refuse semantics the pinned identity would not predict and still read settled until the next converge. A post-PR-A srv4 converge, checking the sidecar sha against the pin, followed by one client compile of current main to srv4 is the planned discriminator: a fresh recorded binary that still refuses would clear the binary and implicate host state.",
    },
    tail: [],
  },
  disposition: Open,
}
