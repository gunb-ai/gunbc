// THE REMOTE BUILD CHOOSES A HOST BY WALKING A ROSTER, BESIDE FABRIC'S SELECTION. Recorded 2026-11-21 by the remote-build planning audit (gunbc.plans.remote_build_bandwidth section 2); the divergence is admitted by the scaffold ruling and stated in the module header, and this row is what makes it discoverable from the register.
data remote_build_host_choice_is_beside_select_supply: IntegrationConcern = IntegrationConcern {
  identity: "remote_build_host_choice_is_beside_select_supply",
  kind: SuspectedCapabilityGap {
    model: decl_ref(module_path: "gunbc.compute.remote_build", decl_name: "remote_build_next_step"),
    requirement: "choosing which supplier serves one demand is a selection through the fabric selection authority, not a roster walk or a pin beside it",
    standing: RequirementEstablished {
      by: CitesDeclaration { declaration: decl_ref(module_path: "product.fabric.selection", decl_name: "select_supply") },
    },
  },
  affected: FreeSemigroup {
