module gunbc.integration_concern.fleet_converge_arm64_label_blocks_x86_executor_host

// One row of the integration-concern register. The roster derives the row from this file (module gunbc.integration_concern.roster);
// there is no list to append to. Ported from main's block in gunbc.integration_concern
// at this merge.

import std.algebra { FreeSemigroup }
import std.decl_ref { decl_ref }
import gunbc.integration_concern { CitesDeclaration, ConcernSighting, IntegrationConcern, Open, RequirementUnestablished, SuspectedCapabilityGap, fleet_converge_arm64_label_sighting_revision }

// Capability gap, filed unfixed at the build lane's direction: the self-hosted fleet-converge job pins its
// runner label's machine-architecture slot to arm64 (fleet_converge_host_runner_expression_body), so a mode whose
// executor host is x86 can never be scheduled. The label slot should derive from the executor's modeled arch.
data fleet_converge_arm64_label_blocks_x86_executor_host: IntegrationConcern = IntegrationConcern {
  identity: "fleet_converge_arm64_label_blocks_x86_executor_host",
  kind: SuspectedCapabilityGap {
    model: decl_ref(module_path: "gunbc.fleet.fleet_converge_workflow", decl_name: "fleet_converge_host_runner_expression_body"),
    requirement: "the self-hosted fleet-converge runner label's machine-architecture slot is derived from the executor host's modeled architecture (the uname/Linux Architecture reading), not fixed to arm64, so a mode whose executor is an x86 host can be scheduled",
    standing: RequirementUnestablished { decided_by: "the build lane (clever-raven-401): where an x86 serving host's converge executes is a pending design decision, so this gap is filed without a fix" },
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "gunbc.fleet.fleet_converge_workflow", decl_name: "fleet_converge_host_runner_expression_body"),
    tail: [
      decl_ref(module_path: "gunbc.runner.runner_slot_allocation", decl_name: "runner_host_label"),
      decl_ref(module_path: "extdeps.tools.uname", decl_name: "uname_linux_machine_architecture"),
      decl_ref(module_path: "gunbc.machine_intake.h11ssl_x86_bringup_frontier", decl_name: "h11ssl_x86_bringup_frontier_rows"),
    ],
  },
  question: "Can a self-hosted fleet-converge mode run when its executor host's modeled machine architecture is x86, given the runs-on label list fixes that slot to arm64? Where should that machine-architecture label come from instead?",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: fleet_converge_arm64_label_sighting_revision,
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "gunbc.fleet.fleet_converge_workflow", decl_name: "fleet_converge_host_runner_expression_body") },
        tail: [
          CitesDeclaration { declaration: decl_ref(module_path: "gunbc.machine_intake.h11ssl_x86_bringup_frontier", decl_name: "h11ssl_x86_bringup_frontier_rows") },
        ],
      },
      account: "A read-only remote_build_serving_observe was dispatched with the H11SSL unit (operator_host_e2d4b7) as the EXECUTOR host (run 44815656750, 2026-11-20). Its build job completed; the self-hosted fleet-converge job stayed queued, because its runs-on is the fromJSON label list fleet_converge_host_runner_expression_body builds -- [self-hosted, linux, arm64, host-e2d4b7] -- and no runner carries that set, the unit being x86 per its own bring-up frontier. The job could never be scheduled and the run was cancelled. This names the gap only: the arm64 slot is a literal, not read from the executor's architecture. It does not fix the derivation, which is the build lane's pending decision for where ken's serving converge runs.",
    },
    tail: [],
  },
  disposition: Open,
}
