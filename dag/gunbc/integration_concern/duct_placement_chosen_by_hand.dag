module gunbc.integration_concern.duct_placement_chosen_by_hand

import std.algebra { FreeSemigroup }
import std.decl_ref { decl_ref }
import gunbc.integration_concern { CitesDeclaration, ConcernSighting, IntegrationConcern, Open, RequirementUnestablished, SuspectedCapabilityGap }

data duct_placement_chosen_by_hand: IntegrationConcern = IntegrationConcern {
  identity: "duct_placement_chosen_by_hand",
  kind: SuspectedCapabilityGap {
    model: decl_ref(module_path: "product.printed_chassis.card_cooling_route", decl_name: "BlowerHome"),
    requirement: "a blower placement is selected from candidate placements against the chassis's current arrangement and the operator's stated preference between rear depth and side space, and the selected placement is realized through the printable-assembly route without a new duct root being authored per layout",
    standing: RequirementUnestablished { decided_by: "an operator ruling recorded in gunbc.design_ruling: the preference was stated in conversation on 2026-11-02 and no ruling row carries it yet" },
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "product.printed_chassis.card_cooling_route", decl_name: "a16_route_report"),
    tail: [
      decl_ref(module_path: "product.printed_chassis.printable_assembly_selection", decl_name: "duct_root_selection"),
      decl_ref(module_path: "product.printed_chassis.chassis_clearances", decl_name: "side_lane_width"),
    ],
  },
  question: "How does a card's blower placement follow from the chassis arrangement and the operator's rear-versus-side preference, and how do placement candidates (BlowerHome) relate to printable realizations (DuctRootKind) -- selection and realization between them, or something else?",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: "f441733b7ac73f9e9114fcf1b09bef6e782b66f0",
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "product.printed_chassis.card_cooling_route", decl_name: "beside_the_row_demand") },
        tail: [
          CitesDeclaration { declaration: decl_ref(module_path: "product.printed_chassis.chassis_clearances", decl_name: "side_lane_width") },
          CitesDeclaration { declaration: decl_ref(module_path: "product.printed_chassis.printable_assembly", decl_name: "DuctRootKind") },
        ],
      },
      account: "The operator expected the blower mounted against the card's side with a short turn into the end, and received the flat-on-end duct. At this revision the closest candidate, BesideTheRow, REFUSES: it spends the blower's shorter face across the lane, and the lane row it is judged against is an eye estimate from a two-card row. The operator's described pose instead lays the blower's broad face against the card's side and spends mainly its thickness outward, so no existing candidate models it, and the operator now says nothing sits beside the A16 -- a different arrangement from the one the lane row records. The operator also stated the preference itself: where rear space is available they may prefer to keep side space free for more cards. Which candidate is built is chosen by hand and the preference has no carrier.",
    },
    tail: [],
  },
  disposition: Open,
}
