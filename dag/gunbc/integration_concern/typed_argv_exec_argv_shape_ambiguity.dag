    head: decl_ref(module_path: "gunbc.typed_argv_exec", decl_name: "typed_argv_exec_over_fleet_ssh"),
    tail: [
      decl_ref(module_path: "gunbc.tailscale_join_converge", decl_name: "tailscale_join_observe_status"),
    ],
  },
  question: "Should typed_argv_exec_over_fleet_ssh's argv parameter be a typed whole-argv (so an args-only List<String> is unwritable), rather than one List<String> that carries a whole argv and an args-only list alike?",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: "b94646b1a6cc3aee5f2b0451fba396ee59532bef",
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "gunbc.tailscale_join_converge", decl_name: "tailscale_join_observe_status") },
        tail: [
          CitesDeclaration { declaration: decl_ref(module_path: "extdeps.tailscale.machine_name", decl_name: "tailscale_status_json_argv") },
