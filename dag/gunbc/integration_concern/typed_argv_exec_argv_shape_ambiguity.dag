data typed_argv_exec_argv_shape_ambiguity: IntegrationConcern = IntegrationConcern {
  identity: "typed_argv_exec_argv_shape_ambiguity",
  kind: SuspectedCapabilityGap {
    model: decl_ref(module_path: "gunbc.typed_argv_exec", decl_name: "typed_argv_exec_over_fleet_ssh"),
    requirement: "a seam that dials a program over fleet ssh should take a whole argv (program then args) and make an args-only list unwritable, so a caller cannot pass args-only and dial the first argument as the program",
