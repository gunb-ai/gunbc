    // Length and RackUnitHeight dimensions.
    replacement: FreeSemigroup {
      head: decl_ref(module_path: "v1.compiler.infer", decl_name: "equality_argument_by_target"),
      tail: [decl_ref(module_path: "v1.compiler.infer", decl_name: "equality_scope_with_params"), decl_ref(module_path: "v1.compiler.infer", decl_name: "is_unit_variant_phantom_argument")],
    },
