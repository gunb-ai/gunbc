        conclusion: "PASS: NoSuchFunction for the empty function name, zero equality rows, zero resolve-failed headers, 825 modules, 5.28 GiB peak. At 3d34fc61ca6e the same entry refused at gunbc.host.host_effect::host_effect_is_converge_loop_evidence.",
      },
      tail: [
        RetainedExecutionResult {
          control: decl_ref(module_path: "gunbc.compute.compute_seat_ensure", decl_name: "seat_fell_by"),
