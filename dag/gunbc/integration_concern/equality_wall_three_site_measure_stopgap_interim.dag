      HistoricalDeclaration { at: "f9bad88f8a569a803a4fbfccbd8d17552fdd9611" as CommitSha, module_path: "gunbc.host.host_effect", decl_name: "host_effect_is_converge_loop_evidence" },
      HistoricalDeclaration { at: "f9bad88f8a569a803a4fbfccbd8d17552fdd9611" as CommitSha, module_path: "gunbc.compute.compute_seat_ensure", decl_name: "seat_fell_by" },
      HistoricalDeclaration { at: "3ca4fe166b5d511426dd0ae1ee2b73e0fd70e0b4" as CommitSha, module_path: "gunbc.fleet.fleet_physical_inventory", decl_name: "fleet_nominal_rackmount_arithmetic_holds" },
    ],
