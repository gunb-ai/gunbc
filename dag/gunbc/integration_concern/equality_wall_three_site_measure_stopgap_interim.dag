          conclusion: "PASS: zero equality rows, zero resolve-failed headers, 1042 modules, 6.96 GiB peak -- no OOM, which is what #16115 bought. At 3d34fc61ca6e the same entry refused at gunbc.compute.compute_seat_ensure::seat_fell_by.",
        },
        RetainedExecutionResult {
          control: decl_ref(module_path: "gunbc.fleet.fleet_physical_inventory", decl_name: "fleet_nominal_rackmount_arithmetic_holds"),
          run: "gunbc run --source-root dag --source-root src/v2 --entry dag/gunbc/fleet/fleet_physical_inventory.dag --function \"\" with the same compiler",
          conclusion: "PASS: zero equality rows, zero resolve-failed headers, 168 modules, 0.64 GiB. The same entry refused at 3d34fc61ca6e at gunbc.fleet.fleet_physical_inventory::fleet_nominal_rackmount_arithmetic_holds.",
        },
        RetainedExecutionResult {
          control: decl_ref(module_path: "v2.compiler.source_root_eval", decl_name: "source_root_eval"),
          run: "gunbc test //gunbc/instruments:self-host with the same compiler",
          conclusion: "exit_status=0 warning_count=0 wall_s=824, zero E0369, zero E0277, zero equality-admission rows; emitted closure d4d72cb053f985a9237f64943237ed38f612b694f53591f68181cab91238e391. The emitted self-host closure that failed with E0369 in v2-bootstrap 42414168425 builds under rustc.",
        },
        RetainedExecutionResult {
          control: decl_ref(module_path: "test.claim.self_host_equality_admission_witness", decl_name: "nested_structural_argument_equality_admits_at_the_use"),
          run: "claim_batch --source-root dag --source-root src/v2 --wet --entry dag/test/claim/self_host_equality_admission_witness.dag --functions <all 80 test fns of the module>, same compiler",
          conclusion: "76 PASS, 4 FAIL, 6 minutes wall. The four failures are the optional/Present controls (inferred_collection_key_census_row_is_present_and_the_program_stays_accepted, explicit_present_comparison_stays_admitted, explicit_present_return_stays_admitted, present_spelled_data_initializer_stays_admitted); they fail the same way under a compiler built from origin/main and are owned by #16206, not by this change. Zero equality-admission rows in the whole run.",
        },
