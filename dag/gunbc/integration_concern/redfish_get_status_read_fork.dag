module gunbc.integration_concern.redfish_get_status_read_fork

// One row of the integration-concern register.
// Its authorities are the sealed region redfish_get_status_read_fork_authorities in module gunbc.integration_concern
// (the seal forbids building a DistinctAuthorities value outside that module). The roster derives the row from this file (module gunbc.integration_concern.roster);
// there is no list to append to. Ported from main's block in gunbc.integration_concern
// at merge 21: main 00ef60b1a4c (#16357).

import std.algebra { FreeSemigroup }
import std.decl_ref { decl_ref }
import gunbc.guarantee_stall { climbs_when }
import gunbc.integration_concern { CitesDeclaration, ConcernSighting, ExistingHome, IntegrationConcern, PreservedObligation, SuspectedFork, Triaged, redfish_get_status_read_fork_authorities, redfish_get_status_read_fork_revision }

data redfish_get_status_read_fork: IntegrationConcern = IntegrationConcern {
  identity: "redfish_get_status_read_fork",
  kind: SuspectedFork {
    authorities: redfish_get_status_read_fork_authorities,
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "extdeps.bmc.http", decl_name: "GetResourceByPath"),
    tail: [
      decl_ref(module_path: "extdeps.bmc.http", decl_name: "GetResourceByPathWithStatus"),
      decl_ref(module_path: "test.claim.machine_intake.prior_life_capture_live_witness", decl_name: "redfish_refusals_classify_by_the_response_status"),
    ],
  },
  question: "Which declaration decides how a Redfish GET and its accompanying HTTP status come back to a caller -- and when do the two reads retire into one? GetResourceByPath curls --fail-with-body, which DISCARDS the status on 4xx/5xx, so it cannot tell a 401 auth refusal from a 404 firmware-cannot-serve gap; the status-suffixed read exists because the prior-life archive must turn those statuses into typed CarrierGapCauses rather than fabricated empty captures.",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: redfish_get_status_read_fork_revision,
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "extdeps.bmc.http", decl_name: "GetResourceByPath") },
        tail: [
          CitesDeclaration { declaration: decl_ref(module_path: "extdeps.bmc.http", decl_name: "GetResourceByPathWithStatus") },
          CitesDeclaration { declaration: decl_ref(module_path: "test.claim.machine_intake.prior_life_capture_live_witness", decl_name: "redfish_refusals_classify_by_the_response_status") },
        ],
      },
      account: "PXE 1d-c added GetResourceByPathWithStatus beside GetResourceByPath in the same effect (review 94474 named the fork). The divergence is the transport sentinel: --fail-with-body destroys exactly the status this read exists to observe, so the new op drops it and returns the status with the body. Two GET routes over one boundary is parallel authority; the collapse is recorded as disposition.next on this row so deleting any comment cannot lose it. As of this filing the remaining callers of the old read are gunbc.machine_intake.arrival_run's AccountService read and gunbc.machine_intake.megarac_boot_diagnostic_bundle's diagnostic read.",
    },
    tail: [],
  },
  disposition: Triaged {
    home: ExistingHome { model: decl_ref(module_path: "extdeps.bmc.http", decl_name: "GetResourceByPathWithStatus") },
    preserve: [
      PreservedObligation {
        holder: decl_ref(module_path: "extdeps.bmc.http", decl_name: "GetResourceByPathWithStatus"),
        control: decl_ref(module_path: "test.claim.machine_intake.prior_life_capture_live_witness", decl_name: "redfish_refusals_classify_by_the_response_status"),
        statement: "the status-suffixed read classifies 401/403 as auth refusals, 404/405 as not-served gaps, a 2xx with bytes as Ok, and a 2xx with an empty body as a typed absence -- never a fabricated capture",
      },
    ],
    next: climbs_when(capability: "every caller of GetResourceByPath -- arrival_run's AccountService read and megarac_boot_diagnostic_bundle's diagnostic read -- consumes the status-suffixed read, GetResourceByPath is deleted, and mutating the status-suffixed read's status classification reddens a row of test.claim.machine_intake.prior_life_capture_live_witness"),
  },
}
