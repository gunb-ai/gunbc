import gunbc.integration_concern { CitesDeclaration, ConcernSighting, ExistingHome, IntegrationConcern, PreservedObligation, RequirementEstablished, SuspectedCapabilityGap, Triaged }

// THE REMOTE SERVE LEG BYPASSES THE SHARED DURABLE ATTEMPT CONTROLLER; STORAGE ALONE IS NOT THE OWNERSHIP GAP. Recorded 2026-11-21 by the remote-build planning audit (#gunbc.plans.remote_build_bandwidth::remote_build_bandwidth_plan).
data remote_build_attempt_store_is_beside_the_fabric_event_log: IntegrationConcern = IntegrationConcern {
  identity: "remote_build_attempt_store_is_beside_the_fabric_event_log",
  kind: SuspectedCapabilityGap {
    model: decl_ref(module_path: "gunbc.compute.remote_build_serve", decl_name: "remote_build_provide_on"),
    requirement: "a served attempt participates in the durable route's shared request and attempt ownership, fencing and cancellation, with grants and results admitted by their owning authorities; a file store beside the seat event log is not by itself evidence of duplicate authority",
    standing: RequirementEstablished {
      by: CitesDeclaration { declaration: decl_ref(module_path: "gunbc.compute.durable_attempt_controller", decl_name: "controller_delegate") },
    },
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "gunbc.compute.remote_build_serve", decl_name: "remote_build_provide_on"),
    tail: [decl_ref(module_path: "gunbc.compute.work_provider_local", decl_name: "compute_recover_attempt_in")],
  },
  question: "When work-exec-2 lands, does the serving host's attempt share one authority with the durable route for request ownership, fencing, cancellation, grants and result admission? The durable attempt controller's controller_store is itself a file-backed compare-and-set store, so moving onto it does not by itself put attempts in the fabric event log; the integration is the shared ownership and admission, not the store.",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: "7711690f3f55ae40d41fbee3fc856e13b65c3c95",
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "gunbc.compute.attempt_lifecycle", decl_name: "recovery_write_authorization") },
        tail: [CitesDeclaration { declaration: decl_ref(module_path: "gunbc.compute.durable_attempt_controller", decl_name: "controller_store") }],
      },
      account: "Read at this revision: recovery_write_authorization and compute_recover_attempt_in decide recovery over a compare-and-set file store (gunbc.durable_cas_file_store, std.durable_exclusive_hold); only the seat release returns through gunbc.fabric.fabric_event_log. gunbc.compute.durable_attempt_controller joins attempt_lifecycle to product.fabric.execution, and no remote-build module imports it.",
    },
    tail: [],
  },
  disposition: Triaged {
    home: ExistingHome { model: decl_ref(module_path: "gunbc.compute.durable_attempt_controller", decl_name: "controller_delegate") },
    preserve: [
      PreservedObligation {
        holder: decl_ref(module_path: "gunbc.compute.attempt_lifecycle", decl_name: "recovery_write_authorization"),
        control: Present { value: decl_ref(module_path: "gunbc.compute.attempt_lifecycle", decl_name: "recovery_write_authorization") },
        statement: "for an attempt that may have launched, an unreadable or unknown unit lifecycle cannot establish quiescence or authorize release; pre-launch recovery retains its declared deadline and compare-and-set fence",
      },
    ],
    next: climbs_when(capability: "the serving host's attempts participate in work-exec-2's shared request and attempt ownership, fencing and cancellation, with grants and results admitted by their owning authorities and the existing recovery refusals preserved; this row then closes as integrated"),
  },
}
