import std.algebra { FreeSemigroup }
import std.decl_ref { decl_ref }
import std.optional { Absent }
import gunbc.guarantee_stall { climbs_when }
import gunbc.integration_concern { CitesDeclaration, ConcernSighting, ExistingHome, IntegrationConcern, PreservedObligation, RequirementEstablished, SuspectedCapabilityGap, Triaged, remote_build_serving_converge_merge_revision }

data remote_build_serving_fresh_account_has_no_toolchain_bootstrap: IntegrationConcern = IntegrationConcern {
  identity: "remote_build_serving_fresh_account_has_no_toolchain_bootstrap",
  kind: SuspectedCapabilityGap {
    model: decl_ref(module_path: "gunbc.compute.remote_build_serving_converge", decl_name: "converge_ensure_toolchain"),
    requirement: "a fresh serving account, with no rustup installed, converges to the pinned toolchain channel",
    standing: RequirementEstablished {
      by: CitesDeclaration { declaration: decl_ref(module_path: "gunbc.compute.remote_build_serving_converge", decl_name: "converge_plan") },
    },
  },
  affected: FreeSemigroup {
    head: decl_ref(module_path: "gunbc.compute.remote_build_serving_converge", decl_name: "converge_ensure_toolchain"),
    tail: [
      decl_ref(module_path: "gunbc.compute.remote_build_serving_converge", decl_name: "converge_plan"),
      decl_ref(module_path: "test.claim.compute.remote_build_serving_converge_witness", decl_name: "fresh_with_rustup_observed"),
    ],
  },
  question: "How does a fresh serving account get rustup, so the toolchain write has something to run? Either the bootstrap is modelled as its own write (rustup-init from a pinned, verified source), or the toolchain is provided by an existing converge route the serving account can use.",
  sightings: FreeSemigroup {
    head: ConcernSighting {
      revision: remote_build_serving_converge_merge_revision,
      evidence: FreeSemigroup {
        head: CitesDeclaration { declaration: decl_ref(module_path: "gunbc.compute.remote_build_serving_converge", decl_name: "converge_plan") },
        tail: [CitesDeclaration { declaration: decl_ref(module_path: "test.claim.compute.remote_build_serving_converge_witness", decl_name: "fresh_with_rustup_observed") }],
      },
      account: "Observed on main 2026-11-17 (fleet-converge remote_build_serving_observe runs 44046779069 and 44046782964): srv3 and srv4 have no serving account, so rustup is absent, and the converge plans ConvergeUnhandled with the cause 'toolchain: rustup not installed for <account>; no bootstrap modelled' and writes nothing. The plan-shape witnesses that check write order, dedupe and parents-before-installs therefore run on fresh_with_rustup_observed, a constructed fixture in which rustup survived a deleted account; no real fresh host is in that state.",
    },
    tail: [],
  },
  disposition: Triaged {
    home: ExistingHome { model: decl_ref(module_path: "gunbc.compute.remote_build_serving_converge", decl_name: "converge_plan") },
    preserve: [
      PreservedObligation {
        holder: decl_ref(module_path: "gunbc.compute.remote_build_serving_converge", decl_name: "converge_plan"),
        control: Absent,
        statement: "an account whose rustup is absent is never written toward a toolchain by a path that fetches and runs an unpinned installer (curl | sh); until a bootstrap is modelled the plan stays unhandled with zero writes",
      },
    ],
    next: climbs_when(capability: "a fresh host's converge plan settles the toolchain without the fresh_with_rustup_observed fixture, and the plan-shape witnesses move onto the real fresh observation"),
  },
}
