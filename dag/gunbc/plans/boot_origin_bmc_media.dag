module gunbc.plans.boot_origin_bmc_media

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetiresWhen, PlanIsAuthorityOnly }
import gunbc.design_ruling { project_documentation_projections_are_not_checkout_artifacts }
import std.markdown { MarkdownBlock }
import gunbc.plans.md_helpers { p }

// THE DESIGN FOR THE R2 BOOT ORIGIN AND THE BMC MEDIA RELAY (session bright-swift-248, 2026-10-25):
// boot images published to R2 behind a gunb.ai custom domain, reaching NFS-only BMCs through the
// segment holder of gunbc.plans.site_segment_anchor_bmc_reach. Split from
// gunbc.plans.fleet_naming_reach_access so each retires on its own condition. Design only.

fn opening() -> List<MarkdownBlock> {
  [
    p(text: "Goal: publish public, content-addressed runner images in R2 behind gunb.ai and boot mtcollins1 through its observed media capability. gunbc.cloudflare.boot_origin owns publication and refuses secrets; gunbc.plans.site_segment_anchor_bmc_reach owns the segment holder."),
    p(text: "Method: an authenticated VirtualMedia TransferProtocolType read selects DirectRedfishHttps when HTTPS is allowed, otherwise NfsRelayThroughHolder; unread capabilities select neither. A relay is built only for the selected NFS route, fetches by digest, verifies the hash and exports from the segment holder (srv2 in the lab). Resolve its LAN address through endpoint authority, not srv2_lan_ipv4."),
  ]
}

fn survey() -> List<MarkdownBlock> {
  [
    p(text: "Evidence: gunbc.machine_intake.mtcollins1_access_observation records the firmware-0.32 404 reading; gunbc.machine_intake.mtcollins1_virtual_media_readout_observation records Redfish on 0.45. Neither settles authenticated transfer capabilities: B0 selected no route. Keep both observations at their owners rather than treating firmware-specific absence as a permanent controller property."),
    p(text: "Prerequisites: the operator moves gunb.ai nameservers to Cloudflare after preserving every existing record observed by gunbc.namecheap.account. B1 requires gunb_ai_nameserver_delegation = DelegationObservedInParent and BootOriginHostnameAllocated. Verify the upstream R2 active-zone requirement and whether MegaRAC accepts an NFS hostname; otherwise use the resolved holder address."),
  ]
}

fn phases() -> List<MarkdownBlock> {
  [
    p(text: "Validate in order: B0 authenticated route selection (adhoc-9e4ea90a-fd0); B1 allocated hostname/readback; B2 digest publication/readback; B3 relay only if selected, with endpoint-resolved LAN identity (adhoc-37e2c372-ad5); B4 mtcollins1 boots the selected image through that route with its digest checked. These receipts, not the design, discharge retirement."),
  ]
}

data boot_origin_bmc_media_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly { ruling: project_documentation_projections_are_not_checkout_artifacts },
  slug: "boot-origin-bmc-media",
  title: "Boot origin and BMC media: content-addressed R2 images behind gunb.ai, read directly over Redfish HTTPS or relayed to NFS-only controllers by the segment holder",
  body: concat(concat(opening(), survey()), phases()),
  retirement: PlanRetiresWhen {
    condition: unbound_dissolution(description: "Retire when the boot origin's gunb.ai hostname is allocated and read back, the runner ISO is published by digest and read back, and mtcollins1 has booted that ISO through the media route its B0 observation selected (direct Redfish HTTPS, or the segment holder's NFS relay) with the digest checked."),
  },
}
