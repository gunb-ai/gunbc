module gunbc.plans.cli_run_hollowing_plan

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetirement, PlanRetiresWhen, PlanIsAuthorityOnly }
import std.markdown { MarkdownBlock }
import gunbc.plans.md_helpers { p }
import gunbc.design_ruling { project_documentation_projections_are_not_checkout_artifacts }

fn cli_run_hollowing_plan_body() -> List<MarkdownBlock> {
  [
    p(text: "Goal: remove cli_run.rs workflow orchestration into .dag, leaving only the admitted pinned bootstrap/host-physics boundary. This area map replaces closed #7074’s per-function ledger. It is authority-only, not committed generated Markdown. The file is orchestration, not the already modeled/generated frontend; current DESIGN/carriers govern execution."),
    p(text: "Measure scale from git show origin/main:src/v1/stage0/src/cli_run.rs | wc -l and the same source’s function declarations, not a copied count. Chunk F is the CI-orchestration dissolution sign-off unit, not whole-file LOC. Its historical order follows emitter chunks A–E and de-fork G; v2_self_hosting/frontier authority owns sequencing. ts-seed-interim names retained seed growth, not terminal authority."),
    p(text: "Workspace/repo paths: workspace_root/OnceLock and repo_relative_path containment→cli_run_workspace_root_scaffold/cli_run_repo_grant→generated host_effect_apply with effect-namespace-grants preset rows. CLI argv/bin dispatch→thin admitted bootstrap; pin it at the real fixed point, never infer a retained LOC target."),
    p(text: "Corpus discovery/file walking→ci_spec discovery_scan_dirs and native witness scheduling (#7069/#7090). The 2026-08-15 floor cut deleted ci_floor_plan: no retired plan-node target may be restored; rederive discovery’s consumer in the required fold."),
    p(text: "Resolve/typecheck entry orchestration→v2 compiler pipeline through cli-run-reconcile-defork Phases 1–3; closure selection needs module_graph.import_closure_live equivalence evidence before cache/reconcile repoints. Reconcile algorithm is already modeled; its host wrapper deletes with orchestration. Typed/resolved caches→std.materialize and ComputationIdentity/duplicate-work authority, not module-path-only memoization."),
    p(text: "Import/module-graph facts→module_graph/namespace SymbolIndex; reference_resolution_facts and reference_edges_as_import_facts→cross_tree.resolution/containment. layer_import_facts feeds LayerImportFact containment consumers; the direction lens was retired 2026-07-24. Import grammar deletion retires the mixed edge supply, not surviving containment obligations."),
    p(text: "Affected-set/diff provenance→ci_spec selection and effect_reach, with declared SourceRef boundary/provenance ingest (affected_set_reading_from_git_diff_provenance). Compile-clean shard scope is modeled in dag_compile_clean_scope/v2.compiler.compile but host walks remain until one module_graph closure authority reaches end-to-end."),
    p(text: "Floor/witness execution→required_floor policy and workflow host_effect_apply replacing run_required_floor/run_discovery_corpus scheduling. Both ci_floor_plan and claim_executor are deletion subjects, never terminal subsumption targets. Regen scope→required_regen/frontier at 5-real-fixpoint; regen_stage0 is already retired, and its claim_executor fixed-point replacement is also on the deletion path. Retire seed coverage in bulk with the qualified cut, not piecemeal."),
    p(text: "Host builtins retain irreducible physics only; interpreter-kernel/frontier per-builtin dissolution rows govern node-tree readers (#5364). Lens census/hygiene feeds→their actual lens readers or explicit retirement, never a blanket claim that deleted construction checks still execute. Floor observability/width→floor_materialization/realization_width and scheduler-native receipts, replacing host timing. Test-migration-debt builtins retire with src/v1/tests only after coverage migration."),
    p(text: "Open model gap: process-wide once-per-node union-resolve receipt counting has no modeled carrier; its MUB contract-test counter remains in the reconcile-defork fence until workflow orchestration owns it. This map does not duplicate that detailed design or claim a measured implementation state."),
  ]
}

data cli_run_hollowing_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly { ruling: project_documentation_projections_are_not_checkout_artifacts },
  slug: "cli-run-hollowing-plan",
  title: "Plan — cli_run.rs hollowing map (Chunk F)",
  body: cli_run_hollowing_plan_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "Delete when `cli_run.rs` Chunk F is GENERATED or deleted — orchestration runs from workflow `.dag` + pinned bootstrap kernel only, and this high-level map is redundant with the frontier carrier + seed-shrink census.")
  }
}
