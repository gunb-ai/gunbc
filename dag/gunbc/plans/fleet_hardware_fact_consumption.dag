]

// THE EVIDENCE COLUMN, COMPUTED FROM THE READING MODULES. Every phrase here is the output of a join in
// gunbc.fleet.gpu_interconnect_observation or gunbc.fleet.gpu_power_cap_boot_state, so rendering this plan
// EXECUTES the readings: if the pair's peer-access rows were retyped as possible, or the boot unit stopped
// addressing the card the device row names, this column changes and so does the generated table. That is what
// "the readings reach their consumer" has to mean for a plan whose whole body is text -- and review 92338 was
// right that the earlier version, which named both modules only inside strings, executed neither.
fn migration_evidence_text(r: ConsumerMigrationRow) -> String {
  match r.readings {
    ReadingsNotOwed => "no first-hand reading is owed by this row yet"
    Srv1InterconnectReadings => srv1_interconnect_evidence()
    Srv1PowerCapReadings => srv1_power_cap_evidence()
  }
}

// Each phrase is its own fn so each can be asked, and failed, on its own -- and so the table's cell is a
// composition of answers rather than a sentence someone agreed with.
fn peer_access_phrase() -> String {
  if gpu_pair_peer_access_is_absent(host: operator_host_srv1, left_board: gpu_board_04, right_board: gpu_board_01) { "peer access refused in both directions" } else { "PEER ACCESS NOT ESTABLISHED" }
}

fn pair_readings_phrase() -> String {
  if gpu_pair_interconnect_readings_complete(host: operator_host_srv1, left_board: gpu_board_04, right_board: gpu_board_01) { "pair readings complete" } else { "PAIR READINGS INCOMPLETE" }
}

fn first_hand_phrase() -> String {
  if srv1_gpu_peer_access_readings.all(r => srv1_reading_is_read(w: r.warrant)) && srv1_collective_transport_readings.all(c => srv1_reading_is_read(w: c.warrant)) { "every row first-hand" } else { "A ROW IS NOT FIRST-HAND" }
}

fn acs_phrase() -> String {
  if srv1_acs_redirects_at_both_root_ports() { "ACS redirecting" } else { "ACS NOT REDIRECTING" }
}

fn iommu_phrase() -> String {
  if srv1_iommu_translates_both_gpu_groups() { "SMMU translating" } else { "SMMU NOT TRANSLATING" }
}

// A reading whose warrant is an Unread carries the obligation to re-read it; that obligation showing up here
// is the table admitting it is not done, which is the point of rendering it.
fn reread_phrase() -> String {
  let owed_here = srv1_gpu_peer_access_readings.any(r => match srv1_reading_obligation(w: r.warrant) {
    Absent => false
    Present { value: _ } => true
  }) || srv1_collective_transport_readings.any(c => match srv1_reading_obligation(w: c.warrant) {
    Absent => false
    Present { value: _ } => true
  })
  if owed_here { "re-read owed" } else { "nothing re-read owed" }
}

fn explanation_phrase() -> String {
  if srv1_interconnect_explanations.all(e => match e.standing {
    Hypothesis { claim: _, would_be_settled_by: _ } => true
    Bet { claim: _, would_be_settled_by: _ } => true
  }) { "explanations stand as hypothesis or bet" } else { "AN EXPLANATION IS OVERSTATED" }
}

fn srv1_interconnect_evidence() -> String {
  join([peer_access_phrase(), "; ", pair_readings_phrase(), "; ", first_hand_phrase(), "; ", acs_phrase(), "; ", iommu_phrase(), "; ", reread_phrase(), "; ", explanation_phrase()])
}

fn unit_lines_phrase() -> String {
  if srv1_power_cap_boot_units.all(u => unit_lines_can_fail(unit: u)) { "boot unit installed, its lines can fail it" } else { "BOOT UNIT SILENCED, ABSENT OR EMPTY" }
}

fn cap_below_default_phrase() -> String {
  if srv1_power_cap_boot_units.all(u => boot_cap_actually_reduces_the_device_default(unit: u)) { "cap sits below the card's own read default" } else { "CAP NOT BELOW THE READ DEFAULT" }
}

fn max_q_phrase() -> String {
  if board_rests_on_its_own_default(board: gpu_board_04) { "Max-Q rests on its own default" } else { "MAX-Q NOT ON ITS DEFAULT" }
}

fn journal_phrase() -> String {
  if srv1_cap_application_claims.all(c => cap_application_claim_starts_from_the_device_default(claim: c)) { "journal's from-watts matches the read default" } else { "JOURNAL AND DEVICE ROW DISAGREE" }
}

fn gunbc_unit_phrase() -> String {
  if gunbc_cap_unit_is_installed(p: srv1_gunbc_cap_unit_presence) { "gunbc's unit installed" } else { "gunbc's unit not installed" }
}

fn srv1_power_cap_evidence() -> String {
  join([unit_lines_phrase(), "; ", cap_below_default_phrase(), "; ", max_q_phrase(), "; ", journal_phrase(), "; ", gunbc_unit_phrase()])
}

fn migration_row_markdown(r: ConsumerMigrationRow) -> MarkdownTableRow {
  row(cells: [
    cell(text: r.consumer as String),
    cell(text: owner_text(d: r.owner)),
    cell(text: r.superseded as String),
    cell(text: r.closes_on as String),
    cell(text: migration_standing_text(s: r.standing)),
    cell(text: migration_evidence_text(r: r)),
  ])
}

fn fleet_hardware_fact_consumption_body() -> List<MarkdownBlock> {
  [
    p(text: "The operator's intent (2026-11-07): changing installed hardware or an operating decision changes the configuration, admission or capacity it bears on, and the repository keeps that intent. srv1's two RTX PRO 6000 cards at the operator's 300 W cap on an ASRock PG-1600G are the first complete example."),
    h2(text: "Consumer migrations"),
    p(text: "One row per consumer that must come to read the hardware authority instead of an independent value or a bypass. A row closes on its stated evidence only: a merged model, an adopted decision, a matching host and a setting that survives its lifecycle are four separate states."),
    TableBlock {
      header: row(cells: [cell(text: "consumer"), cell(text: "owner"), cell(text: "superseded"), cell(text: "closes on"), cell(text: "standing"), cell(text: "readings (computed from the reading modules)")]),
      alignments: [AlignNone, AlignNone, AlignNone, AlignNone, AlignNone, AlignNone],
      rows: map(fleet_hardware_consumer_migrations, r => migration_row_markdown(r: r)),
    },
    h2(text: "Sequence"),
    ul(items: [
      li(text: "1. Reconcile facts and persist decisions already made: assembly, GPU assets and device observations, procurement, the 300 W decision, census, population dispositions, and these rows."),
      li(text: "2. One real path for manual GPU policy: resolve devices, validate, apply, read back independently, gate the selected serving configuration on it, re-realize after lifecycle changes."),
      li(text: "3. Migrate the remaining consumers across the fleet, removing each superseded authoring as its consumer moves; historical readings stay as history and stop serving as current evidence."),
      li(text: "4. Qualify the mixed-card TP=2 configuration once the second card is powered, then transition through the existing maintenance path."),
    ]),
  ]
}

data fleet_hardware_fact_consumption_plan: Plan = Plan {
  slug: "fleet-hardware-fact-consumption",
  title: "Fleet hardware facts, consumed: every installed-hardware fact and operating decision read by the configuration, admission and capacity derivations it bears on",
  body: fleet_hardware_fact_consumption_body(),
  retirement: PlanRetiresWhen {
    condition: unbound_dissolution(description: "Retire when every row of fleet_hardware_consumer_migrations has closed on its stated evidence (or moved to the program that owns it and closed there), each superseded independent authoring or bypass is removed, and the owned-hardware population carries an explicit disposition for every physical unit."),
  },
  projection: PlanIsAuthorityOnly,
}
