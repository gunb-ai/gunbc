module gunbc.plans.fleet_hardware_fact_consumption

import std.types { Bool, List, NonEmptyStr, String }
import std.optional { Absent, Present }
import std.decl_ref { DeclarationRef, decl_ref }
import std.dissolution { unbound_dissolution }
import std.markdown { MarkdownBlock, MarkdownTableRow, TableBlock, AlignNone }
import gunbc.plan { Plan, PlanRetiresWhen, PlanIsAuthorityOnly }
import gunbc.markdown_helpers { h2, p, li, ul, cell, row }
// The two modules that carry srv1's interconnect and boot-time power-cap readings, imported because the table
// below COMPUTES its evidence column from their joins. Review 92338 was right that naming a module inside a
// text string is not consumption: nothing outside the tests executed these joins, so a whole-table retyping of
// them would have rendered identically. The column is where a reading either reaches a consumer or does not.
import gunbc.fleet.gpu_interconnect_observation {
  gpu_pair_peer_access_is_absent, gpu_pair_interconnect_readings_complete, srv1_acs_redirects_at_both_root_ports,
  srv1_iommu_translates_both_gpu_groups, srv1_gpu_peer_access_readings, srv1_collective_transport_readings,
  srv1_interconnect_explanations, srv1_reading_is_read, srv1_reading_obligation, peer_access_is_absent,
  HypothesisStanding, Hypothesis, Bet,
}
import gunbc.fleet.gpu_power_cap_boot_state {
  srv1_power_cap_boot_units, srv1_cap_application_claims, srv1_gunbc_cap_unit_presence, unit_lines_can_fail,
  gunbc_cap_unit_is_installed, boot_cap_actually_reduces_the_device_default, board_rests_on_its_own_default,
  cap_application_claim_starts_from_the_device_default,
}
import gunbc.fleet.fleet_host_identity { operator_host_srv1 }
import gunbc.fleet.fleet_physical_inventory { gpu_board_01, gpu_board_04 }

// FLEET HARDWARE FACTS, CONSUMED (operator, 2026-11-07). The operator's intent, in their words: changing
// the installed hardware or an operating decision should change the generated configuration, admission
// decision or capacity calculation it bears on, and the repository should retain that intent. srv1's
// two-card configuration (an RTX PRO 6000 Max-Q beside an RTX PRO 6000 Workstation card, both capped at
// 300 W by the operator, on an ASRock PG-1600G) is the first complete example.
//
// THIS CARRIER OWNS NO FACT. Each fact already has a home (the assembly, the inventory, the device
// observation, the cap policy, the extdeps rows); each consumer already has an owner module. What this
// carrier holds is the MIGRATION between them: one row per consumer that must come to read the hardware
// authority instead of an independent authoring or a bypass, naming the owner, the inputs, what is
// superseded, what the row waits on, and the evidence that closes it. Where another program already owns
// a consumer (host_thermal_operating_point owns runner thermal restrictions and fan adoption), the row
// points at that program and does not restate its design.
//
// Rows were read against gunbc main 613e59301a78 and the operator's design review of the same day.

// Which first-hand readings a row's evidence column is computed from. A tag rather than a sentence, because
// the renderer must not decide what a row is about by matching its prose, and a row that owes no readings says
// so as a case instead of leaving the cell blank.
type MigrationReadings
  = ReadingsNotOwed
  | Srv1InterconnectReadings
  | Srv1PowerCapReadings

// The four completion states, kept separate per row: the fact is modeled; the decision is adopted; the host
// matches (an independent readback); the setting survives the relevant lifecycle (reboot, device
// reinitialization, a device appearing). A row closes only on the evidence its closure names, never on a
// merged model alone -- gunbc.design_argument::separation_of_authority, four states that a single
// "migrated" flag would flatten.
type MigrationStanding
  = MigrationUnstarted
  | MigrationStartedHere { what: NonEmptyStr }
  | MigrationOwnedByProgram { program: DeclarationRef }

type ConsumerMigrationRow {
  consumer: NonEmptyStr
  // Which readings the evidence column is computed from (see MigrationReadings).
  readings: MigrationReadings
  owner: DeclarationRef
  inputs: NonEmptyStr
  superseded: NonEmptyStr
  waits_on: List<NonEmptyStr>
  closes_on: NonEmptyStr
  standing: MigrationStanding
}

fn migration_standing_text(s: MigrationStanding) -> String {
  match s {
    MigrationUnstarted => "unstarted"
    MigrationStartedHere { what: w } => join(["started: ", w as String], "")
    MigrationOwnedByProgram { program: d } => join(["owned by ", d.module_path as String], "")
  }
}

fn owner_text(d: DeclarationRef) -> String {
  join([d.module_path as String, "::", d.decl_name as String], "")
}

data thermal_program: DeclarationRef = decl_ref(module_path: "gunbc.plans.host_thermal_operating_point", decl_name: "host_thermal_operating_point_plan")

data fleet_hardware_consumer_migrations: List<ConsumerMigrationRow> = [
  ConsumerMigrationRow {
    consumer: "assembly, inventory and GPU card census",
    readings: ReadingsNotOwed,
    owner: decl_ref(module_path: "gunbc.fleet.fleet_host_assembly", decl_name: "srv_assembly_components"),
    inputs: "canonical asset identities, installation, lifecycle, catalog binding, procurement lot",
    superseded: "unread psu_srv1..psu_srv4 catalog rows; the census row naming the Max-Q only as a rental; RTX 2000 Ada with no host",
    waits_on: ["operator: srv2..srv4 and every other host's supply", "operator: owned T10 / spare module counts"],
    closes_on: "one current answer per physical unit, partial installations representable, every installed board bound to its host",
    standing: MigrationStartedHere { what: "srv1 PSU catalog, Max-Q and srv4 Ada assets and census rows (this change)" },
  },
  ConsumerMigrationRow {
    consumer: "GPU power-cap realization",
    readings: Srv1PowerCapReadings,
    owner: decl_ref(module_path: "gunbc.serving.gpu_power_state_policy", decl_name: "installed_gpu_cap_intents"),
    inputs: "asset-to-device binding (gunbc.fleet.gpu_device_observation), the selected cap, the device range, the policy revision, the installed boot mechanism (gunbc.fleet.gpu_power_cap_boot_state) and the post-write per-UUID readback (gunbc.fleet.gpu_power_cap_converge)",
    superseded: "caps set by hand with nvidia-smi -pl, lost at reboot or device reinitialization",
    waits_on: ["the srv1 boot run of gunbc.fleet.gpu_power_cap_converge (the owed inhabitance receipt)", "re-realization on device reinitialization and on a device appearing (named obligations at gunbc.live_deploy.srv1_gpu_power_cap_unit srv1_gpu_power_cap_realization_triggers)"],
    closes_on: "changing the desired cap changes the applied command and the expected readback; a mismatch refuses; the cap is re-applied after reboot and on a device appearing",
    standing: MigrationStartedHere { what: "the 300 W decision, its admission, a boot unit applying and independently reading back power.limit per UUID, and the engine Requires=/After= on it (gunbc.live_deploy.apply_legs deploy_apply_srv1_gpu_power_cap_plan); reinitialization and device-appearance re-realization owed. WHAT IS INSTALLED ON SRV1 TODAY, read 2026-11-08 and carried in gunbc.fleet.gpu_power_cap_boot_state, is not that unit: it is the operator's hand-written /etc/systemd/system/gpu-power-limit.service (sha256 473372180065e6b313dc6266a477e37cc6845b386789eb407bff2fc77b6f4e2a, Type=oneshot, enabled), whose one cap line addresses the Workstation card's UUID at 300 W against that card's 600 W default. Its ExecStart lines carry no `-` prefix, so a failing nvidia-smi does fail that unit -- but nothing is Requires=-gated on it, and it reads nothing back, so on the other card the limit standing there is that device's own 300 W default, not the unit's doing. #16047 landed this row's realization owner (d79a9db7addb: gunbc.fleet.gpu_power_cap_converge plus gunbc.live_deploy.srv1_gpu_power_cap_unit); its own gunbc-srv1-gpu-power-cap.service was not installed on srv1 as of 2026-11-08, which is why the boot-run wait is still open" },
  },
  ConsumerMigrationRow {
