    inputs: "an applicable observed power reading, its measurement scope, workload attribution",
    superseded: "gunbc.fleet.fleet_host_power srv1_power (94 W, 2026-09-05) selected by host name for a materially changed assembly",
    waits_on: [],
    closes_on: "a reading carries the assembly it applies to and a changed assembly refuses the old reading; a configured cap is never used as a measured draw",
    standing: MigrationStartedHere { what: "(this change): each HostPowerProfile now carries the configuration it applies to (its applies_to, naming the single-authority installed units), and work_energy_cost joins it against gunbc.fleet.fleet_host_assembly host_installed_components -- which joins the assembly authority's own containment edges with gunbc.fleet.fleet_physical_inventory installed_gpu_board_containments. srv1's 94 W of 2026-09-05 (taken on psu_srv1, no accelerator) is REFUSED against srv1's rebuilt assembly with a ReadingAppliesToSupersededAssembly cause naming the measurement needed. srv2 and srv3 keep pricing: their declared configurations agree with their current assemblies (srv3's added liquid cooler is power-immaterial). srv4 also REFUSES: its 94 W is inferred from srv1's accelerator-free build while srv4's own build carries the accelerator boards gunbc.fleet.fleet_physical_inventory installed_gpu_board_containments places in it (gpu_board_05, gpu_board_06), so its applies_to names that accelerator-free basis and the join does not cover its current assembly -- an inferred figure never describes accelerators it was not taken against. The by-host-name pricing bypass is removed and no configured power ceiling is ever substituted for a measured draw." },
  },
  ConsumerMigrationRow {
    consumer: "owned-hardware population and dispositions",
    readings: ReadingsNotOwed,
    owner: decl_ref(module_path: "gunbc.hostname_allocation", decl_name: "operator_hosts"),
    inputs: "physical units, assemblies, ownership and lifecycle (installed, pending qualification, spare, retired or disposed, provider-managed)",
    superseded: "the identity roster read as a count of machines (srv13 and srv15 name one board; provider guests are rows)",
    waits_on: ["operator: addresses or access for srv3, srv13..srv16, mtcollins1, mtjade1, the host-* machines and the Sparks"],
    closes_on: "every consumer's population is derived from physical units with an explicit disposition per unit",
    standing: MigrationUnstarted,
