module gunbc.plans.authored_name_contract

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetirement, PlanRetiresWhen, PlanIsAuthorityOnly }
import std.markdown { MarkdownBlock }
import gunbc.plans.md_helpers { h2, p, li, ul }
import gunbc.design_ruling { project_documentation_projections_are_not_checkout_artifacts }

fn authored_name_contract_body() -> List<MarkdownBlock> {
  [
    p(text: "**Status:** design only (v1 cull audit P2.9, lane H); no implementation. Brief pinned at `63a464edf01fd94ea7a6ef9393f4af7b15479015` (`git show 63a464edf01fd94ea7a6ef9393f4af7b15479015:docs/plans/v1-interface-cull-audit.md`, section 3a Cross-phase, P2.9, lane H). Symbols, not positions, are the receipts."),
    h2(text: "1. What exists"),
    ul(items: [
      li(text: "`v1.std.core` `Node` carries `name` (the STRUCTURAL name, set by the `make_*_node` constructor) and `ident_span: SourceSpan?` (the identifier token span; `default_ident_span` is `none` for an empty name)."),
      li(text: "`v1.std.core` `authored_name_at` is a projection of `ident_span`, not a read of `name`: `Absent` gives the empty string; `Present` with the file in `source_indices` slices `source_text_at` (`chars_to_string` over `NewlineIndex.char_codes`); an absent file of the form `<kernel:N>` (`kernel_span`) yields N; any other absent file (`no_span`, `<synthetic>`) falls back to `node.name`."),
      li(text: "`v1.compiler.resolve` `with_authored_identity` builds a node whose structural fields come from `structural` and whose `ident_span` comes from `identity`. It is the one sanctioned place the two names differ: the node is structurally the alias target and spelled as the alias. `preserve_nominal_brand_on_resolve` and the transparent-alias relation read that difference (`gunbc.recurring_failure_mode` `transparent_alias_relation_read_the_brand_keeping_peel`)."),
      li(text: "Cost: the brief's section 3a perf profile attributes the reconcile and emit phases to re-slicing the name per call. Re-derive with the call-site census `git grep -c authored_name_at` and the 3a profile recipe in the pinned brief; no figure is transcribed here."),
    ]),
    h2(text: "2. The contract"),
    ul(items: [
      li(text: "**C1 one fact, two roles.** Authored = the spelling at the identity position; structural = what the node denotes. The carried value replaces `authored_name_at` only, never `.name`."),
      li(text: "**C2 snapshot.** The authored name is the slice of the tokenized source at the identifier span. Spans index Unicode scalars (`chars`), not bytes or UTF-16 units, so non-ASCII is correct as long as the carried string is cut from the same `char_codes`."),
      li(text: "**C3 fixed at construction.** Computed where `ident_span` is minted (parser, `kernel_span` and `no_span` constructors), never at use; no consumer needs `source_indices` to ask a node its name."),
      li(text: "**C4 propagation.** Constructors take it from the name they already receive; rebuilds copy it with `ident_span` as one field group; `with_authored_identity` takes it from `identity` beside `ident_span`; synthetic nodes make the `name` fallback explicit."),
      li(text: "**C5 missing source and kernel.** A construction with a span but no obtainable text is a typed construction error, not the empty string or a silent fallback; kernel and synthetic nodes construct their variants explicitly."),
      li(text: "**C6 unchanged outputs.** For every reachable node the carried value equals today's `authored_name_at`, including the empty string for absent `ident_span` and `node.name` for unknown files; checked by a corpus differential before the projection is deleted."),
    ]),
    h2(text: "3. Decision: carry it"),
    p(text: "Per DESIGN section 2 step 1 the repetition is authored duplication whose least common ancestor is the node's construction: carry the first value. A cache may discharge unavoidable recurrence; it may never excuse authored duplication. A memo keyed by file and span also cannot express the `with_authored_identity` divergence without keying on the node, which is the carried design with extra steps. `ident_span` stays (diagnostics, `node_name_span`); only its text-projection role moves."),
    h2(text: "4. Relation to P2.8"),
    p(text: "The authored name is immutable node state at the identity position, so it belongs on the state side of P2.8's key, not the traversal-role side. The carried field changes no occurrence identity, so P2.9 does not wait on P2.8."),
    h2(text: "5. Open operator decisions"),
    ul(items: [
      li(text: "Node shape. A new `Node` field touches every record literal and the stage0 mirror (regenerated by the integration lane). Recommended alternative with the same contract: change the `ident_span` payload to a type holding span plus authored text, so the two cannot be updated apart. Either form reshapes `Node`, a load-bearing substrate type, so a model change lands before any pipeline lane migrates."),
      li(text: "The saving is not re-measured here; the contract does not depend on its size."),
    ]),
    h2(text: "6. Verification for the implementer"),
    ul(items: [
      li(text: "Corpus differential, carried equals `authored_name_at`, with RED controls: a rebuild that drops the field, and a `with_authored_identity` that takes it from `structural`."),
      li(text: "Specimens: a non-BMP scalar before the identifier, kernel and synthetic nodes, an alias brand-keeping peel."),
      li(text: "Required routes `//gunbc/instruments:self-host` and `//gunbc/instruments:v2-native-cli` unchanged."),
    ]),
    h2(text: "PURPOSE test (`gunbc.v1.v1_maintenance_standing` `v1_seed_standing`)"),
    p(text: "Serves the v2 self-host program by removing the per-call name re-slicing demand on the required job once implemented, and by deleting the `source_indices` threading through every call site, so less seed surface exists for v2 to carry. This plan changes no behavior.")
  ]
}

data authored_name_contract_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly { ruling: project_documentation_projections_are_not_checkout_artifacts },
  slug: "authored-name-contract",
  title: "Plan - Authored-name contract (carry the name, do not re-materialize it)",
  body: authored_name_contract_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "Delete when the authored name is carried on the node, authored_name_at is deleted, and the corpus differential is green by execution.") }
}
