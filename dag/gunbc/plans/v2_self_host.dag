module gunbc.plans.v2_self_host

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetiresWhen, PlanIsAuthorityOnly }
import std.markdown { MarkdownBlock, TableBlock, AlignNone }
import gunbc.markdown_helpers { h2, p, li, ul, ol, quote, cell, row }

fn v2_self_host_body() -> List<MarkdownBlock> {
  [
    quote(blocks: [
      p(text: "**This plan is written as an intention** (`gunbc.design_argument::plans_are_intentions`): what the repository should become, why, and done-when. How it is realized is downstream: the work items live under `gunbc.roadmap.roadmap_authority` and name this intention; this plan does not list them."),
      p(text: "**Grounding:** `gunbc.design_argument::self_hosting`, `gunbc.design_argument::replacement_migration` (the seed is semantics-frozen under a purpose test), `gunbc.design_argument::guarantee_ladder`, `gunbc.design_argument::consumption`, `gunbc.design_argument::epistemic_humility`, `gunbc.design_argument::planning_has_one_home`. The milestone order is owned by `gunbc.compiler_frontend_program_interlock` and read by `gunbc.compiler_frontend_program_status`; this plan cites both and restates neither."),
    ]),
    h2(text: "1. Intention"),
    p(text: "**What:** the compiler written in `.dag` is the one that runs. v2 reads, names, types and emits the retained compiler closures, builds itself, rebuilds itself, is the required native route and the admitted production route, and the v1 seed is gone from the tree."),
    p(text: "**Why:** the seed is a regression oracle that the repository still builds, ships and maintains by hand (`gunbc.v1.v1_maintenance_standing::v1_seed_standing`). Every v2 change today proves a replacement nobody uses (the displaced cost recorded on `native-production-admission`), so its guarantees reach no product. The design's claim that a wall is a row over a medium-agnostic substrate (`gunbc.design_argument::self_hosting`) is a claim about a compiler that runs, not about a seed. The cost removed is the hand-maintained Rust, the second semantic authority, and the gap between what the corpus proves and what the build uses."),
    p(text: "**Done when** (each assessed against the tree unless marked as the operator's judgement):"),
    ul(items: [
      li(text: "`SelfHostSeedRetirement` reads CLEAR in `gunbc.compiler_frontend_program_status`. Today it reads NotDerivable because no instrument observes the seed's absence (`SeedDeletionObservation`); that observation is owed before this condition can be read at all, and an emptied authored roster is not it."),
      li(text: "Its four interlock prerequisites read CLEAR: `SelfHostNativeRouteRequiredLane`, `SelfHostEmittedContractsHeld`, `SelfHostEmitterProducesEveryRetainedArtifact`, `SelfHostSuccessorPromotionAdmitted`."),
      li(text: "Every product builds and runs from a tree with the old directory removed, and anything deliberately kept is listed (the red control of `v1-products-v1-free`); hand-written Rust in the repository is at zero (`v1-zero-hand-maintained-rust`)."),
      li(text: "Operator's judgement: `gunbc.v1.v1_maintenance_standing::v1_seed_standing` is retired, because the standing it describes no longer has a subject."),
    ]),
    p(text: "**A second milestone, after self-hosting: the vision realized** (the architectural audit of 2026-11-17, adopted by the operator with the three rulings of that date). Self-hosting is necessary and not sufficient: a compiler can rebuild itself while keeping accidental file semantics, partial facts in build artifacts, duplicated type authorities and string-keyed binding. The vision is realized when, in addition to the conditions above, each of the following holds on the tree:"),
    ul(items: [
      li(text: "One structural declaration identity (a nonempty path plus a tagged member coordinate) is what equality, hashing, dependency edges, citations, generated demands and resolver output all use; dots are its rendering; `DeclarationRef` and `QualifiedName` are one carrier."),
      li(text: "Source enters as a bundle at one ingest step into one universe and the files are discarded (`gunbc.design_ruling::source_is_ingested_into_one_universe_and_files_are_discarded`): no header, no file-level semantic unit, every declaration spelling its path; two providers for one path refuse; a declaration's test status is a property of the subject, not a second universe."),
      li(text: "Every phase is sealed (`gunbc.design_ruling::phase_admission_is_a_conformance_pattern`): parsed, resolved, checked, emitted, each a carrier with one constructor; `ParseTree` is no longer a bare `Node`; evaluation and emission consume only the checked carrier, whose constructor proves every reference resolves, every obligation is discharged, every target-required operation has a realization and no provider is unavailable. This replaces every roster of tolerated unknowns."),
      li(text: "Refusals are typed and located and diagnostics render them; no production module branches on a diagnostic's reason symbol (32 do today)."),
      li(text: "One text carrier, a sequence of Unicode scalars, with a host crossing as the only explicit wrapper; the tokenizer identity wall is retired."),
      li(text: "An operation is a declaration with a realization row (`gunbc.design_ruling::operations_are_declarations_with_realizations`); the checker, evaluator and emitter consume that one identity, and a target supplies a realization or refuses, typed."),
      li(text: "The retained compiler closures contain no two declarations for one concept; `v2.std` is not a second standard library (compiler-internal types are renamed into the compiler's namespace, semantic duplicates are merged)."),
      li(text: "Bootstrap is reproducible: one source, a pinned prior artifact, generation two meeting generation one under a stated fixed-point relation, from a clean checkout."),
      li(text: "At least one external specimen compiles that uses language features the compiler's own closure does not select; native-seven is the first specimen, never the definition of the wall."),
      li(text: "The language model classifies every grammar production as core (the five connectives and six behaviors, declarations, qualified references, lexical binders, literals) or sugar (pipes, method forms, postfix suffixes, `?` and `none`, string templates, carets, list and map literals), and every sugar production lowers to core before any semantic pass; sugar is added only after the core is stable (operator, 2026-11-17)."),
      li(text: "Occurrence identity is independent of load order and of which unrelated declarations the universe holds: the same source bundle yields the same identities whatever order the ingest reads it in."),
      li(text: "The realization partition (crates, native bundles, cache entries) is derived from the declaration graph, never from file or module membership (`v2-emitter-native-crate-partition` is re-read under the universe ruling)."),
      li(text: "The design document says what the compiler does: the single-authority and substrate claims in `gunbc.design_argument` no longer describe imports, module headers or name-to-path as the binding and storage rules, and the fourteen statements of the 2026-11-17 audit are rows there, rendered by regen."),
    ]),
    p(text: "**The vision milestone, staged.** Read the same way as the namespace layers: each item is a measured separation of one hidden context, justified by the done-when above, and realized by one node under `v2-compiler-live` bound to this intention at layer 5 (`gunbc.roadmap.roadmap_intention_binding`). Their order among themselves is a selection; what fixes it is that the identity carrier precedes dots-for-citations, the universe ingest precedes the import cut's loader half, and the checked carrier precedes any claim that a roster of tolerated unknowns may be deleted."),
    ul(items: [
      li(text: "`universe-ingest-replaces-file-acquisition`: the bundle-to-universe step; files discarded; the text mapping kept; the two-tree layout and `gunbc.source_layout` become the ingest's realization."),
      li(text: "`one-declaration-identity-carrier`: `DeclarationRef` and `QualifiedName` merged; dots the one rendering, citations included; `::` retired."),
      li(text: "`sealed-phases-and-the-checked-carrier`: `ParseTree` sealed; four phases; `CheckedProgram` the only input to evaluation and emission."),
      li(text: "`typed-refusals-own-control-flow`: the 32 production modules that branch on a diagnostic's reason symbol branch on typed refusals; diagnostics render."),
      li(text: "`one-text-carrier`: one sequence-of-scalars carrier with the host crossing as its only wrapper; the tokenizer identity wall retired."),
      li(text: "`operations-are-declarations`: the five mechanisms converge on declaration plus realization row; `CanonicalOperation` becomes declarations; operators lower to references."),
      li(text: "`one-standard-library`: zero duplicate concepts in the retained closures; `v2.std` internals renamed, semantic duplicates merged."),
      li(text: "`external-specimen-compiles`: a program outside the compiler's own closure compiles natively, with features the closure does not select."),
    ]),
    h2(text: "2. The backward structure, read at e346a2c89daa"),
    p(text: "This section is reasoning, not a phase list. It is derived from two authorities, the interlock's `milestone_prerequisites` and the declared edges of `gunbc.roadmap.roadmap_authority`, and it is replaceable whenever either changes. Read from the goal downward: each layer states what must already be true for the layer above it."),
    ol(items: [
      li(text: "**The goal.** The seed families are absent and every product runs without them (`v1-products-v1-free`, `v1-zero-hand-maintained-rust`)."),
      li(text: "**Just before it.** The old generator is deleted (`v1-emitter-delete`, needing the required lane and the admitted successor) and the old runner is deleted (`v1-interpreter-delete`, needing `v1-interpreter-quarantine`, which needs `native-production-admission`, which needs the required lane and, by the operator's 2026-11-16 ruling, the namespace program `namespace-unique-on-chain`). The interlock's four prerequisites sit here: the required lane (`native-frontier-required-lane`), the admitted successor (`v1-emitter-fixed-point`), every retained artifact produced (`emitter-produces-main-rs`), and every emitted module holding its own contract (`emitted-contracts-held`)."),
      li(text: "**Before the successor is admitted.** The v2-built compiler rebuilds itself (`v2-emitter-native-bootstrap`), which needs the built v2 CLI to compile and emit `v2.compiler.compile` (`second-generation`)."),
      li(text: "**Before the second generation.** Two independent lines meet: the emitter chain reaches the crate partition (`v2-emitter-producer-provenance`, `v2-emitter-direct-rust-door`, `v2-emitter-production-compatible-corpus-module`, `v2-emitter-first-behavioral-module`, `v2-emitter-native-crate-partition`: five serial steps), and v2 parses and types its own test target (`native-seven`), which needs its four parents (`literal-elaboration`, `shared-check-lets-and-matches`, `declaration-provider-outcomes`, `native-test-verdict-realization`)."),
    ]),
    p(text: "**The cone.** Walking the declared edges back from the goal reaches 31 nodes, of which 13 have no open parent (32 and 14 once the namespace edge below is counted; `namespace-unique-on-chain` is a project node whose eleven members declare no edges to it, so its own cone is read from membership). The longest chain from that frontier to the goal is 11 landings and runs through the emitter chain, which is serial: one worker at a time, starting at `v2-emitter-producer-provenance`, the open producer-authority question that `v2-emitter-direct-rust-door` was reported as carrying. The native-seven line has about three landings of slack against it. Of the 111 nodes under the v2 projects, 83 are on no path to the goal."),
    h2(text: "3. What is outside the cone, and what that means"),
    p(text: "The following are not prerequisites of this intention. They are quality, safety and cost work that each belongs to another intention or is admitted ad hoc; selecting them over the cone is a selection the operator makes against the shared CI heal slot, not a dependency this plan asserts: `compiler-guarantee` (35 nodes, the ladder climb), the egress rows under `v2-compiler-live` (numeric, crypto, encoding, effects, content hash), `emission-minimum-cost` and `cardinality-absence`. The namespace program is NOT outside: by `gunbc.design_ruling::v2_landing_waits_on_the_namespace_program` it gates production admission, while staying outside native-seven (`gunbc.design_ruling::n7_requires_only_its_own_closure`)."),
    p(text: "A node outside the cone is not wrong to work on. It is wrong to report it as moving the compiler closer to running, which is the confusion `v2-compiler-live` recorded as its displaced cost."),
    h2(text: "4. Milestones and their homes"),
    p(text: "Every interlock milestone, the work item that discharges it, and how the status module reads it today. A milestone with no work item was the gap this plan was written to close."),
    TableBlock {
      header: row(cells: [cell(text: "Milestone"), cell(text: "Work item"), cell(text: "Standing read by `gunbc.compiler_frontend_program_status`")]),
      alignments: [AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "S2 `SelfHostWholeCorpusPopulationDerived`"), cell(text: "`v2-frontend` (cited in its handback)"), cell(text: "NotDerivable: the whole-corpus census was retired by `gunbc.design_ruling::bad_process_is_worse_than_no_process`; the scope is the two compiler closures.")]),
        row(cells: [cell(text: "S3 `SelfHostCargoPhaseEnrolled`"), cell(text: "`v2-emitter-production` (cited in its handback)"), cell(text: "NotDerivable: the phase roster does not model whether a phase executes cargo; the v2-bootstrap rows do, but no carrier says so.")]),
        row(cells: [cell(text: "S4a `SelfHostRatchetObservationEnrolled`"), cell(text: "`native-frontier-required-lane`"), cell(text: "Outstanding.")]),
        row(cells: [cell(text: "S4b `SelfHostRatchetGateEnrolled`"), cell(text: "`native-frontier-required-lane` (read here as the same step; see open question 3)"), cell(text: "Outstanding, at an authored identity: leaves only by the edit that lands the step.")]),
        row(cells: [cell(text: "S5 `SelfHostCorpusEmitsCleanly`"), cell(text: "`second-generation` and `v2-emitter-native-bootstrap`; `v2-frontend` cites it"), cell(text: "Outstanding over the two retained closures.")]),
        row(cells: [cell(text: "`SelfHostEmittedContractsHeld`"), cell(text: "`emitted-contracts-held` (added with this plan under `v2-emitter-production`)"), cell(text: "Read from the latest deliberately taken behavioral-equivalence receipt, identity-joined to the transport roster.")]),
        row(cells: [cell(text: "`SelfHostEmitterProducesEveryRetainedArtifact`"), cell(text: "`emitter-produces-main-rs`"), cell(text: "Outstanding while any EmitterProducedDivergentRegistration remains.")]),
        row(cells: [cell(text: "`SelfHostSuccessorPromotionAdmitted`"), cell(text: "`v1-emitter-fixed-point`"), cell(text: "NotDerivable: whether admit_promotion ever returned promoted for a real candidate is a run fact no carrier holds.")]),
        row(cells: [cell(text: "`SelfHostNativeRouteRequiredLane`"), cell(text: "`native-frontier-required-lane`"), cell(text: "Outstanding while `gunbc.rung_drop` v2_native_route_off_the_merge_path stands.")]),
        row(cells: [cell(text: "S6 `SelfHostSeedRetirement`"), cell(text: "`v1-emitter-delete`, `v1-interpreter-delete`, `v1-products-v1-free`"), cell(text: "NotDerivable until a seed-deletion observation exists.")]),
      ],
    },
    h2(text: "5. The near-term milestone"),
    p(text: "`native-seven` is the operator's chosen near-term target (2026-11-16): a visible, end-to-end proof that keeps the program's motivation concrete. It is on the cone, since `second-generation` needs it, and it has slack against the emitter chain, so it is not the critical path. Both facts are stated so that progress on it is reported as what it is: a real prerequisite met early, not the program's bottleneck moving."),
    h2(text: "6. Decisions taken 2026-11-16, and what is still open"),
    ul(items: [
      li(text: "**The namespace program gates v2's landing** (`gunbc.design_ruling::v2_landing_waits_on_the_namespace_program`): the edge `native-production-admission` <- `namespace-unique-on-chain` is declared; native-seven keeps its own closure. **Closed the same day** (`gunbc.design_ruling::imports_are_deleted_before_v2_is_accepted`): the import concept is deleted by the time v2 is accepted as the production route, and not before; imports stay the binding mechanism while v2 moves. The intention for that program is `gunbc.plans.names_without_imports`, and the two meet at `native-production-admission`. On 2026-11-17 the operator settled the spelling: every declaration reference is fully qualified, always (`gunbc.design_ruling::declaration_references_are_fully_qualified`), which removes the candidate-population question the program review raised."),
      li(text: "**The required-lane step's budget may rise** (`gunbc.design_ruling::native_frontier_step_budget_may_rise_once_its_checks_are_stated`), on the condition that the operator knows what the checks consist of; section 7 states them."),
      li(text: "**S4a and S4b are read as one work item** with the required lane, `native-frontier-required-lane`. S4b is the interlock's name for a merge-blocking native gate over the two retained compiler closures; the frontier ratchet step is that gate, since its run is the adjudicating native run over the same closures and it refuses on a regressed identity. No second node is minted unless a measurement separates them. **Re-read owed:** on 2026-11-16 the operator ruled that no ratchets are built in this repository (`gunbc.design_ruling::no_ratchets_names_bind_now_and_meaning_migrates_later`); this node is a ratchet by name and carrier, so its owner re-reads it as a plain refusal over the two compiler closures or retires it, and the budget sign-off below covers only what that re-reading lands."),
      li(text: "**The seed-deletion observation is the v1 program's acceptance gate** (`gunbc.design_ruling::seed_deletion_observation_is_the_v1_programs_acceptance_gate`): owed by `v1-products-v1-free`, read from its acceptance evidence."),
      li(text: "**The other goals have their intentions:** `gunbc.plans.factory_first_customer`, `gunbc.plans.debt_payoff`, `gunbc.plans.names_without_imports`, and the backward section of `gunbc.plans.planning_consolidation`."),
    ]),
    h2(text: "7. What the required job runs, and what the required-lane step adds"),
    p(text: "Stated for the operator's 2026-11-16 condition. **Today**, the one required job `v2-bootstrap` (`gunbc.witness.compiler_gate_workflow`, 90-minute timeout) builds the seed, then runs one `gunbc test` step per row of `gunbc.emitted_subject_build_gate` `emitted_subject_build_rows`: `//gunbc/instruments:self-host` and `//gunbc/instruments:v2-native-cli`. Each has the seed emit a v2 closure, cargo build it fresh, and the built binary run against its controls, with a memory envelope refusing any OOM kill or swap. Nothing on it executes a witness claim (`gunbc.design_ruling::no_ci_claim_execution_until_native_frontier_clears`)."),
    p(text: "**The step adds** `//gunbc/instruments:v2-native-frontier` (`gunbc.instrument_targets`): the same adjudicating run the native route makes, by the emitted native compiler, over the whole native universe under `//v2/...`, answered by `v2.workflow.native_frontier_ratchet`. The ratchet compares the debt that run observed against the committed roster `v2.workflow.native_frontier_roster`, row by row: a stage or cause regression, a subject that left without a disposition, a rename target, a disposition the run contradicts, a cause change at a fixed rank, an identity owing debt the roster does not carry (new debt), and a row the run observed at a strictly better attainment (an advance, which proposes the shrunken roster). It passes only on held or advanced; a regressed identity or new debt is red. Qualification of the route is a separate question and stays green on a classified refusal. The node's budget is its own estimate: about 35 minutes per landing, revisit if it exceeds that or stops catching regressions. The roster must be minted first (`RosterUnminted` today), or a green run refuses. What the step buys is the finding gunb-ai/gunbc-private#289 recorded: the required job has no native resolve step, so name debt (an ambient or unhomed name in the native-seven closure) lands green today and is found only by the next native run; with the ratchet enrolled, such a landing refuses."),
    h2(text: "8. Realization"),
    p(text: "Not authored here. The work items are the cone's roadmap nodes; their order, staffing and slicing are a selection made when the work is picked up, and may be redrawn without this plan changing. What a landing reports is whether a milestone's standing moved, read from `gunbc.compiler_frontend_program_status`, never a count of nodes closed."),
  ]
}

data v2_self_host_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly,
  slug: "v2-self-host",
  title: "v2 self-host: the compiler written in .dag is the one that runs",
  body: v2_self_host_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "Section 1 is achieved: SelfHostSeedRetirement reads CLEAR in gunbc.compiler_frontend_program_status, every product builds and runs without the seed, and the operator has retired the v1 seed standing.") },
}
