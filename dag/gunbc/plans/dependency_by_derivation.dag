module gunbc.plans.dependency_by_derivation

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetiresWhen, PlanIsAuthorityOnly }
import std.markdown { MarkdownBlock, CodeBlock, TableBlock, AlignNone }
import gunbc.plans.md_helpers { h2, h3, p, li, ul, ol, quote, cell, row, tasks, todo }
import gunbc.design_ruling { project_documentation_projections_are_not_checkout_artifacts }

fn section_1_intention() -> List<MarkdownBlock> {
  [
    h2(text: "1. Intention"),
    quote(blocks: [p(text: "**In gunbc, textual order and naming carry no dependency.** Two computations are related only where the program shows a relation, and every execution order consistent with those relations is permitted.")]),
    p(text: "This inverts the usual contract. In most languages statement order is a dependency by default, and the compiler must prove independence before it reorders. Here independence is the default, and a dependency the program does not show is the author's to state. A program that relies on an unstated ordering is unsafe here, not merely slow."),
    p(text: "The goal is code that is as parallel as it can be: the compiler derives the real graph, removes dependencies nothing requires, and refuses to invent ones the source never stated."),
    p(text: "`gunbc.plans.for_while_loop_sugar` already states this rule for loop members (its §1.1 to §1.3: no implicit positional predecessor edge, a variable is not a dependency, one graph rather than one interleaving). This plan applies the same rule to statements, `let` chains and effects, and owns none of the loop encodings, which stay with that plan."),
  ]
}

fn section_2_what_counts() -> List<MarkdownBlock> {
  [
    h2(text: "2. What counts as a dependency"),
    p(text: "A dependency exists only where one of three relations holds; everything else is free."),
    TableBlock {
      header: row(cells: [cell(text: "Relation"), cell(text: "Example"), cell(text: "Direction")]),
      alignments: [AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "Name use"), cell(text: "`let x = foo(a)` then `bar(x)`"), cell(text: "`bar` waits on `foo`")]),
        row(cells: [cell(text: "Composition (a computation is made of its parts)"), cell(text: "`foo { bar(b) }`, `f(g(a))`"), cell(text: "the parent waits on the child")]),
        row(cells: [cell(text: "Stated world dependency (an effect touching what another effect touches)"), cell(text: "write a file, then read it back"), cell(text: "the read waits on the write")]),
      ],
    },
    p(text: "These are not dependencies:"),
    ul(items: [
      li(text: "**Textual order.** `let x = foo(a)` above `let y = bar(b)` relates nothing unless `y` uses `x`."),
      li(text: "**Bare scope blocks.** A `{ }` used only to limit which names are visible is sugar and adds no edge."),
      li(text: "**Nesting that only scopes names.** A `let` body containing the rest of the block is a scope, not a sign that the rest waits on the value."),
    ]),
    p(text: "An ordered *choice* is still meaning. When nested matches report the first error in a fixed order, that priority is kept: it orders which result wins, not when anything runs."),
  ]
}

fn section_3_pure_and_effectful() -> List<MarkdownBlock> {
  [
    h2(text: "3. Pure and effectful code"),
    p(text: "Pure code gets full independence with no annotation; effectful code is segregated so the compiler never assumes safety it cannot know."),
    ul(items: [
      li(text: "**Pure code.** Every dependency is visible as a name use or as composition, so the compiler derives the whole graph and nothing is written by hand."),
      li(text: "**Effectful code** (file reads and writes, process spawns, network calls). Two effects can depend on each other through the world without sharing any value. The compiler cannot see that, so effects are fenced off from pure code. Inside the fence an ordering exists only where the author states it, or where the compiler can prove two effects touch the same thing."),
      li(text: "**Unknown effects couple conservatively.** An effect with no declared footprint, such as a process spawn, is treated as possibly touching everything; reordering it is unsafe until its footprint is declared. `gunbc.plans.demand_engine_program` already requires this: an undeclared or unresolved effect never reads as independence."),
    ]),
    p(text: "Effects are where the burden of stating dependencies lands. Appendix B lists the cases to work through."),
  ]
}

fn section_4_today() -> List<MarkdownBlock> {
  [
    h2(text: "4. What the compiler does today"),
    p(text: "Every dependency the compiler sees today comes from the syntax tree and from left-to-right evaluation, not from name use or stated effects. As read at main `c3f3975e185`:"),
    TableBlock {
      header: row(cells: [cell(text: "Layer"), cell(text: "Symbol"), cell(text: "What it does")]),
      alignments: [AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "Statement lowering"), cell(text: "`v2.compiler.body_lowering_fold` `body_lower_stmt_spine`"), cell(text: "Each `let` becomes `Bind(key, value, body)` with the rest of the block as its body, so source order becomes nesting. A non-`let` statement before the last is refused (`body_lowering_reason_statement_precedes_without_binding`).")]),
        row(cells: [cell(text: "Dependency extraction"), cell(text: "`v2.std.dependency` `dependency_lens`"), cell(text: "One edge per parent-to-child tree edge, kind `Contains`, parent as prerequisite. No edge from a name use to its binding; `BindsTo` is produced only by hand-built test fixtures. `EffectDependsOn` and `BarrierBefore` are never derived.")]),
        row(cells: [cell(text: "Parallelism classification"), cell(text: "`v2.lens.common.algebraic_composition` `parallelism_classifier`"), cell(text: "Maps `Contains` to `DataDependent`, so every nesting edge reads as a data dependency.")]),
        row(cells: [cell(text: "Layering"), cell(text: "`v2.std.dependency` `topological_layers`"), cell(text: "One single-node layer per node, in depth-first order: a serialization, not a readiness schedule.")]),
        row(cells: [cell(text: "Evaluation"), cell(text: "`v2.compiler.eval` `eval_bind_node_eval`"), cell(text: "Runs a `let`'s value, then its body, passing `effect_io` along. This is the only thing ordering effects today.")]),
        row(cells: [cell(text: "Collection lowering"), cell(text: "`v2.compiler.fold_lowering`"), cell(text: "Lowers `map` and `filter` into a right-to-left cons recurrence with a `LoopCarrierEdge`. Owned by `gunbc.plans.for_while_loop_sugar`.")]),
        row(cells: [cell(text: "Plan text"), cell(text: "`gunbc.plans.demand_engine_program`"), cell(text: "States \"`Bind` orders later computation after its value\", the textual rule this plan rejects. The same paragraph already says effect ordering comes from `EffectDependsOn`.")]),
      ],
    },
  ]
}

fn section_5_layers() -> List<MarkdownBlock> {
  [
    h2(text: "5. Layers that may need to change"),
    p(text: "Effects must be ordered by stated relations before lets stop implying order; otherwise effectful code silently loses its ordering (DESIGN §5). Proposed order:"),
    ol(items: [
      li(text: "**Doctrine.** Record the rule as a `gunbc.design_ruling`, and amend the `Bind` sentence in `gunbc.plans.demand_engine_program`."),
      li(text: "**Effect footprints.** Effects declare what they touch. Derive `EffectDependsOn` between effects that touch the same thing; unknown footprints couple conservatively."),
      li(text: "**Dependency extraction.** `dependency_lens` emits `DataDependsOn` from each resolved name use, with the binding as prerequisite. Composition edges point child to parent."),
      li(text: "**Classification.** `Contains` stops meaning `DataDependent`; scope-only nesting couples nothing."),
      li(text: "**Layering.** `topological_layers` computes real readiness layers over the derived relation."),
      li(text: "**Collections.** Owned by `gunbc.plans.for_while_loop_sugar`; this plan only supplies the derived relation its §7 independence check reads."),
    ]),
    p(text: "Each worked example in Appendix A names the layer it tests, so the appendix doubles as the test plan."),
  ]
}

fn section_6_open() -> List<MarkdownBlock> {
  [
    h2(text: "6. Open questions"),
    tasks(items: [
      todo(text: "How does an author state a world dependency: a typed handle the read takes from the write, an explicit barrier form, or both?"),
      todo(text: "What does an effect's declared footprint name (a path, a directory, a store key), and how are two footprints compared when paths are computed?"),
      todo(text: "Is `ResourceDependsOn` a leftover to remove from `v2.std.dependency` `DependencyKind`?"),
      todo(text: "Should composition edges point child to parent (the parent waits on its parts), replacing today's parent-first direction?"),
    ]),
  ]
}

fn appendix_a_examples() -> List<MarkdownBlock> {
  [
    h2(text: "Appendix A: worked examples"),
    p(text: "Six real functions, each a future unit test; five are pure, and in all five the extra dependencies come from text."),
    TableBlock {
      header: row(cells: [cell(text: "#"), cell(text: "Function"), cell(text: "Intended"), cell(text: "Actual"), cell(text: "Cause"), cell(text: "Layer under test")]),
      alignments: [AlignNone, AlignNone, AlignNone, AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "A1"), cell(text: "`v2.std.datetime` `leap_second_next_day`"), cell(text: "5 independent lets"), cell(text: "chain of 5"), cell(text: "let nesting"), cell(text: "extraction, classification")]),
        row(cells: [cell(text: "A2"), cell(text: "`gunbc.auth.login_transaction_store` `login_transaction_decode_body`"), cell(text: "6 independent reads, ordered error choice"), cell(text: "chain of 6"), cell(text: "let nesting"), cell(text: "extraction; choice order kept")]),
        row(cells: [cell(text: "A3"), cell(text: "`v2.std.dependency` `dependency_view_relations`"), cell(text: "map"), cell(text: "chain of n"), cell(text: "fold used for a map"), cell(text: "collections")]),
        row(cells: [cell(text: "A4"), cell(text: "`v2.lens.parallelism` `parallelism_fact_unresolved`"), cell(text: "any"), cell(text: "chain of n"), cell(text: "fold used for any"), cell(text: "collections")]),
        row(cells: [cell(text: "A5"), cell(text: "`v2.std.dependency` `dependency_fold_step` via `fold_node`"), cell(text: "independent children, ordered combine"), cell(text: "chain over siblings"), cell(text: "fold over children"), cell(text: "collections, traversal")]),
        row(cells: [cell(text: "A6"), cell(text: "`gunbc.deploy_transition` `set_transition_inhibition`"), cell(text: "read waits on write (same file)"), cell(text: "ordered by luck"), cell(text: "branch nesting, evaluation order"), cell(text: "effect footprints")]),
      ],
    },
    h3(text: "A1. Independent lets"),
    CodeBlock { code: "let utc_year    = year_value(year: utc.year)\nlet utc_month   = month_value(month: utc.month)\nlet local_year  = year_value(year: local.year)\nlet local_month = month_value(month: local.month)\nlet local_day   = day_value(day: local.day)\nmatch utc_month { ... }\n" },
    ul(items: [
      li(text: "**Intended:** the five lets share no names, so all five may run at once. The `match` waits on `utc_month`; each arm waits on the lets it uses."),
      li(text: "**Actual:** `Bind(utc_year)` contains `Bind(utc_month)` contains ... contains the `match`, each edge `DataDependent`."),
      li(text: "**Test:** the derived relation has no edge between any two of the five values."),
    ]),
    h3(text: "A2. Independent reads, ordered error choice"),
    CodeBlock { code: "let state = login_transaction_required_string(doc: doc, key: \"state\")\nlet nonce = login_transaction_required_string(doc: doc, key: \"nonce\")\n... four more ...\nmatch state { Malformed => ...; Read => match nonce { ... } }\n" },
    ul(items: [
      li(text: "**Intended:** the six reads depend only on `doc`. The nested `match` makes the `state` error win over the `nonce` error; that choice order must survive."),
      li(text: "**Actual:** a chain of six, then the cascade."),
      li(text: "**Test:** no edge between the six reads; with two malformed fields, the reported error is unchanged."),
    ]),
    h3(text: "A3. A fold that is a map"),
    CodeBlock { code: "fold(views, init: [], f: fn(acc, v) { list_snoc_item(xs: acc, item: dependency_view_relation(view: v)) })\n" },
    ul(items: [
      li(text: "**Intended:** each output depends only on its own `v`; output order follows input order."),
      li(text: "**Actual:** each step's accumulator depends on the previous one."),
      li(text: "**Test:** the per-element computation has no edge to its neighbours; output order is preserved."),
    ]),
    h3(text: "A4. A fold that is any"),
    CodeBlock { code: "fold(fact.dependencies, init: false, f: fn(acc, dep) { acc || parallelism_relation_unresolved(relation: dep.classification) })\n" },
    ul(items: [
      li(text: "**Intended:** independent checks combined by `||`, in any grouping and order."),
      li(text: "**Actual:** a chain of n."),
      li(text: "**Test:** the checks have no edges between them; the result equals the serial fold."),
    ]),
    h3(text: "A5. Tree traversal"),
    CodeBlock { code: "fold(n.children, init: algebra.init(n), f: fn(acc, e) { algebra.step(acc, e, fold_node(e.target, algebra)) })\n" },
    ul(items: [
      li(text: "**Intended:** the recursive call never sees `acc`, so the child subtrees are independent. Only the combine is ordered, and list append is associative."),
      li(text: "**Actual:** child k waits on child k-1."),
      li(text: "**Test:** sibling subtrees have no edge between them. `NodeFoldDependent`, where a child does read earlier siblings' context, keeps its edges."),
    ]),
    h3(text: "A6. Write, then read back"),
    CodeBlock { code: "let path    = transition_inhibition_path(instance_root: root)\nlet created = Filesystem.WriteOwnerOnly(path: path, content: ...)\nif !created.success { refuse } else {\n  match observe_transition_file(instance_root: root, name: transition_inhibition_file_name) { ... }\n}\n" },
    ul(items: [
      li(text: "**Intended:** the read waits on the write because both touch the same file. No value shows that: the write is addressed by `path`, the read by `(root, name)`."),
      li(text: "**Actual:** correct by accident. The read sits in the `else` arm that waits on `created.success`, and evaluation runs left to right. No effect edge is derived."),
      li(text: "**Test:** with the read moved out of the branch, the compiler still orders it after the write, or refuses for want of a stated dependency."),
    ]),
  ]
}

fn appendix_b_effect_cases() -> List<MarkdownBlock> {
  [
    h2(text: "Appendix B: effect cases"),
    p(text: "Five cases, from the one that is safe for free to the ones where the author must state the dependency, to be worked through one at a time."),
    TableBlock {
      header: row(cells: [cell(text: "#"), cell(text: "Case"), cell(text: "Example"), cell(text: "Ordering needed?"), cell(text: "Who supplies it")]),
      alignments: [AlignNone, AlignNone, AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "B1"), cell(text: "Read of something no one writes during the run"), cell(text: "read an input file twice"), cell(text: "no"), cell(text: "nobody; free to run in parallel")]),
        row(cells: [cell(text: "B2"), cell(text: "Effects on things proven different"), cell(text: "write `a.json`, write `b.json` with literal paths"), cell(text: "no"), cell(text: "the compiler, from footprints")]),
        row(cells: [cell(text: "B3"), cell(text: "Write X, then read X"), cell(text: "A6"), cell(text: "yes"), cell(text: "stated by the author, or a typed handle from write to read")]),
        row(cells: [cell(text: "B4"), cell(text: "Two writes to X"), cell(text: "write a record, then overwrite it"), cell(text: "yes, last write wins"), cell(text: "stated by the author")]),
        row(cells: [cell(text: "B5"), cell(text: "Write X, then read Y, where Y depends on X"), cell(text: "write a file, then list its directory; write a config, then spawn a process that reads it"), cell(text: "yes"), cell(text: "stated by the author; a process spawn couples to everything until its footprint is declared")]),
      ],
    },
  ]
}

fn dependency_by_derivation_body() -> List<MarkdownBlock> {
  concat(section_1_intention(),
  concat(section_2_what_counts(),
  concat(section_3_pure_and_effectful(),
  concat(section_4_today(),
  concat(section_5_layers(),
  concat(section_6_open(),
  concat(appendix_a_examples(), appendix_b_effect_cases())))))))
}

data dependency_by_derivation_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly { ruling: project_documentation_projections_are_not_checkout_artifacts },
  slug: "dependency-by-derivation",
  title: "Dependency by derivation, not by text",
  body: dependency_by_derivation_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "Delete this plan when the rule it states is carried by the substrate: a design ruling records that textual order and scope-only nesting carry no dependency; dependency_lens derives DataDependsOn from name use and EffectDependsOn from declared effect footprints; the parallelism classifier no longer reads Contains as DataDependent; and Appendix A's six examples are enrolled claims that go red when a textual dependency reappears. The claims and the ruling are then the authority, and this document would be a second statement of them.") }
}
