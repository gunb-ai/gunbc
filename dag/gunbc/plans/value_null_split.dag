module gunbc.plans.value_null_split

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetirement, PlanRetiresWhen, PlanIsAuthorityOnly }
import std.markdown { MarkdownBlock }
import gunbc.plans.md_helpers { p }
import gunbc.design_ruling { project_documentation_projections_are_not_checkout_artifacts }

fn value_null_split_body() -> List<MarkdownBlock> {
  [
    p(text: "Goal: stop one Value::Null carrier representing Optional absence, Witness violation, None/LitNull and untyped lookup miss. This is the 2026-07-26 construction-first proposal; counts/standing must be reread before execution. CrossRepresentationEquality alone cannot repair the straddle because present-versus-None comparisons may legitimately be false."),
    p(text: "Recorded construction targets: optional_absent→Optional::Absent variant (landed construction, Null match bridge remains); optional_present/map_lookup_as_optional→Present (partial: map_get bridges; raw get misses remain Null); witness_holds→Witness::Holds and witness_violates/raw_map_lookup_witness→Violates(diagnostic) (constructed variants, Null→Violates bridge remains). raw_map_lookup/list_get_at_or_null retain untyped miss in this proposal. None/none literal remains an open type-context split between Absent sugar and that host sentinel."),
    p(text: "Ground emitter rows in extdeps.languages.rust.types and witness_option_bridge_test: Optional Absent→None via rust_none_expr/emit_variant_pattern; Present→Some via rust_some_template; Witness Holds/Violates→v1_rt::Witness variants via rust_type_checkpoints. Untyped get emits Option::None only with Optional return type; otherwise refuse pending API typing."),
    p(text: "Phases with discriminating red controls: A pin value_null_split_witness and emitter mapping; B Optional-returning map_get/get use map_lookup_as_optional, retaining raw get payload/Null only for map_lookup_dual_dispatch until typed overload; C remove match_pattern Null bridges only after Optional/Witness producers stop emitting Null; D type-directed None→optional_absent and comparison migration to match Absent/optional_is_absent; E ground Optional, reconcile narrowed Null only at the lookup-miss boundary, remove Optional×native_value_null testgen row and its equality guard together."),
    p(text: "Existing controls: witness_option_bridge_test.dag tests map_get→Present/Absent; cross_representation_equality.dag records the straddle. A re-census of Value::Null in v1_interpreter and None comparisons in dag/src/v2 is not a prerequisite (retired by the 2026-10-30 process ruling (`gunbc.design_ruling bad_process_is_worse_than_no_process`)); do not copy counts. No absorbing Null fallback for Optional/Witness and no new per-site Null bridge without admitted, counted dissolution. Current DESIGN’s absence/construction authority governs any implementation; this historical plan is not authorization to introduce a new competing absence model."),
  ]
}

data value_null_split_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly { ruling: project_documentation_projections_are_not_checkout_artifacts },
  slug: "value-null-split",
  title: "Plan — Value::Null split (Optional / Witness / lookup-miss carriers)",
  body: value_null_split_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "Delete when `Value::Null` means only untyped lookup-miss, `Optional::Absent` and `Witness::Violates` are construction-reached only as their `Value::Variant` forms (no `match_pattern` Null bridges), the testgen `Optional`×`native_value_null` straddle row is removed, and `CrossRepresentationEquality` backstop for numerics is the only remaining guard.")
  }
}
