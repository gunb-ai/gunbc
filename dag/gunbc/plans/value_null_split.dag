module gunbc.plans.value_null_split


fn value_null_split_body() -> List<std.markdown.MarkdownBlock> {
  [
    gunbc.plans.md_helpers.p(text: "**Status:** lane opened (keen-ferret-250) · **Parent:** model↔realization fork §3.2 · **DESIGN.md open thread** · Linked from [model-realization-fork.md](model-realization-fork.md) and [fail-closed-lockdown.md](fail-closed-lockdown.md) §4 tier-1."),
    gunbc.plans.md_helpers.p(text: "**Verified against the live tree 2026-07-26.** Census counts are receipts; re-check before acting."),
    gunbc.plans.md_helpers.h2(text: "0. Problem — one native carrier, four meanings"),
    gunbc.plans.md_helpers.p(text: "`Value::Null` overloads four distinct semantics today: (1) the `None`/`none` literal and `LitNull`, (2) `Optional::Absent` (bridged in `match_pattern` at `v1_interpreter.rs:2830`), (3) `Witness::Violates` on map miss (bridged at `:2808` with a fabricated diagnostic), (4) untyped lookup miss (`raw_map_lookup`, `list_get_at_or_null`, `get` on map/list). A blanket `CrossRepresentationEquality` guard cannot close the Optional/Witness straddle — `present == None → false` is *legitimate* at ~218 corpus sites — so the fix is **splitting**, not grounding onto one sentinel."),
    gunbc.plans.md_helpers.h2(text: "1. Target carriers (construction authority)"),
    std.markdown.TableBlock {
      header: gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "meaning"), gunbc.plans.md_helpers.cell(text: "modeled form"), gunbc.plans.md_helpers.cell(text: "target native"), gunbc.plans.md_helpers.cell(text: "construction site"), gunbc.plans.md_helpers.cell(text: "status")]),
      alignments: [std.markdown.AlignNone, std.markdown.AlignNone, std.markdown.AlignNone, std.markdown.AlignNone, std.markdown.AlignNone],
      rows: [
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "Optional absent"), gunbc.plans.md_helpers.cell(text: "`Absent` (`collection.dag`)"), gunbc.plans.md_helpers.cell(text: "`Value::Variant \{ Optional, Absent \}`"), gunbc.plans.md_helpers.cell(text: "`optional_absent()` `:420`"), gunbc.plans.md_helpers.cell(text: "LANDED at construction; still bridged from `Null` in `match_pattern`")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "Optional present"), gunbc.plans.md_helpers.cell(text: "`Present \{ value \}`"), gunbc.plans.md_helpers.cell(text: "`Value::Variant \{ Optional, Present, .. \}` or raw payload + Present bridge"), gunbc.plans.md_helpers.cell(text: "`optional_present()` `:412`; `map_lookup_as_optional` `:428`"), gunbc.plans.md_helpers.cell(text: "partial — `map_get` uses bridge; raw `get` on map still returns `Null` on miss")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "Witness holds"), gunbc.plans.md_helpers.cell(text: "`Holds \{ value \}`"), gunbc.plans.md_helpers.cell(text: "`Value::Variant \{ Witness, Holds, .. \}`"), gunbc.plans.md_helpers.cell(text: "`witness_holds()` `:3333`"), gunbc.plans.md_helpers.cell(text: "LANDED")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "Witness violates"), gunbc.plans.md_helpers.cell(text: "`Violates \{ diagnostic \}`"), gunbc.plans.md_helpers.cell(text: "`Value::Variant \{ Witness, Violates, .. \}`"), gunbc.plans.md_helpers.cell(text: "`witness_violates()` `:3341`; `raw_map_lookup_witness` `:9903`"), gunbc.plans.md_helpers.cell(text: "LANDED at construction; `Null` still bridged to `Violates` in `match_pattern`")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "Lookup miss (untyped)"), gunbc.plans.md_helpers.cell(text: "(no coproduct — host sentinel)"), gunbc.plans.md_helpers.cell(text: "`Value::Null` narrowed to this role only"), gunbc.plans.md_helpers.cell(text: "`raw_map_lookup` `:9927`; `list_get_at_or_null` `:9877`"), gunbc.plans.md_helpers.cell(text: "OPEN — still shared with `None` literal")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "`None` literal / `none` var"), gunbc.plans.md_helpers.cell(text: "context-dependent (Optional sugar vs host null)"), gunbc.plans.md_helpers.cell(text: "dissolve into `Absent` variant OR keep as alias of lookup-miss per type context"), gunbc.plans.md_helpers.cell(text: "`eval_literal LitNull` `:2041`; `eval_var none` `:2067`"), gunbc.plans.md_helpers.cell(text: "OPEN — needs type-directed resolution")]),
      ],
    },
    gunbc.plans.md_helpers.h2(text: "2. Emitter rows (v2 self-host lane — write down before emitting)"),
    gunbc.plans.md_helpers.p(text: "Grounded Rust realization targets (cited in `extdeps.languages.rust.types` + `witness_option_bridge_test.rs`; v2 `target_model` rows must match):"),
    std.markdown.TableBlock {
      header: gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "modeled"), gunbc.plans.md_helpers.cell(text: "Rust emission"), gunbc.plans.md_helpers.cell(text: "authority")]),
      alignments: [std.markdown.AlignNone, std.markdown.AlignNone, std.markdown.AlignNone],
      rows: [
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "`Optional<T>::Absent`"), gunbc.plans.md_helpers.cell(text: "`None`"), gunbc.plans.md_helpers.cell(text: "`rust_none_expr` / `emit_variant_pattern` when parent is `Optional`")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "`Optional<T>::Present \{ value \}`"), gunbc.plans.md_helpers.cell(text: "`Some(\{value\})`"), gunbc.plans.md_helpers.cell(text: "`rust_some_template`")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "`Witness<C>::Holds \{ value \}`"), gunbc.plans.md_helpers.cell(text: "`v1_rt::Witness::Holds(value)`"), gunbc.plans.md_helpers.cell(text: "`rust_type_checkpoints` Witness row")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "`Witness<C>::Violates \{ diagnostic \}`"), gunbc.plans.md_helpers.cell(text: "`v1_rt::Witness::Violates(diagnostic)`"), gunbc.plans.md_helpers.cell(text: "same")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "lookup miss (untyped `get`)"), gunbc.plans.md_helpers.cell(text: "`Option::None` only when return type is `Optional<T>`; else refuse until typed"), gunbc.plans.md_helpers.cell(text: "dissolve with Phase 3 API split")]),
      ],
    },
    gunbc.plans.md_helpers.h2(text: "3. Census (2026-07-26)"),
    gunbc.plans.md_helpers.ol(items: [
      gunbc.plans.md_helpers.li(text: "`Value::Null` in `v1_interpreter.rs`: **53** textual sites (hash/eq/display/match bridges/production — receipt: `rg -c Value::Null src/v1/stage0/src/v1_interpreter.rs`)."),
      gunbc.plans.md_helpers.li(text: "`== None` / `!= None` in `dag/` + `src/v2/`: **218** comparison sites across **66** files."),
      gunbc.plans.md_helpers.li(text: "`optional_absent()` call sites in v2: construction already uses modeled `Absent` variant (not `Null`)."),
      gunbc.plans.md_helpers.li(text: "Existing witnesses: `witness_option_bridge_test.dag` (map_get → Present/Absent at model layer); `cross_representation_equality.dag` roster includes `Optional` × `native_value_null` straddle (target: remove when grounded)."),
    ]),
    gunbc.plans.md_helpers.h2(text: "4. Phased landing (construction-first)"),
    gunbc.plans.md_helpers.tasks(items: [
      gunbc.plans.md_helpers.task(state: std.markdown.Unchecked, text: "**Phase A (this lane):** plan + discriminating witnesses pinning carrier invariants (`value_null_split_witness_test.dag`); emitter row table above is authority for S2 emit."),
      gunbc.plans.md_helpers.task(state: std.markdown.Unchecked, text: "**Phase B:** stop *producing* `Null` where the return type is `Optional<T>` — route `map_get`/`get`+Optional context through `map_lookup_as_optional` (keep raw `get` returning bare value + `Null` miss for `map_lookup_dual_dispatch` until typed overload lands)."),
      gunbc.plans.md_helpers.task(state: std.markdown.Unchecked, text: "**Phase C:** delete `match_pattern` `Null` bridges (`:2808–2834`) once no producer emits `Null` for Optional/Witness arms."),
      gunbc.plans.md_helpers.task(state: std.markdown.Unchecked, text: "**Phase D:** type-directed `None` literal → `optional_absent()` where inhabiting `Optional<_>`; migrate `== None` sites (~218) to `match Absent` or `optional_is_absent` helper."),
      gunbc.plans.md_helpers.task(state: std.markdown.Unchecked, text: "**Phase E:** cross-representation equality — ground `Optional` so `Absent` variant reconciles with narrowed `Null` *only* at the lookup-miss boundary; remove `Optional`×`native_value_null` from testgen roster; bundle `CrossRepresentationEquality` guard removal with this phase (fenced in model-realization-fork §3.1)."),
    ]),
    gunbc.plans.md_helpers.h2(text: "5. Review bar"),
    gunbc.plans.md_helpers.p(text: "No absorbing fallback: a miss must not widen to `Null` when the type is `Optional` or `Witness`. No new per-site `if matches!(v, Value::Null)` bridges without a counted dissolution trigger. Every phase ships with a discriminating witness that goes RED when the carrier regresses."),
  ]
}

data value_null_split_plan: gunbc.plan.Plan = gunbc.plan.Plan {
  slug: "value-null-split",
  title: "Plan — Value::Null split (Optional / Witness / lookup-miss carriers)",
  body: value_null_split_body(),
  retirement: gunbc.plan.PlanRetiresWhen { condition: std.dissolution.unbound_dissolution(description: "Delete when `Value::Null` means only untyped lookup-miss, `Optional::Absent` and `Witness::Violates` are construction-reached only as their `Value::Variant` forms (no `match_pattern` Null bridges), the testgen `Optional`×`native_value_null` straddle row is removed, and `CrossRepresentationEquality` backstop for numerics is the only remaining guard.")
  }
}
