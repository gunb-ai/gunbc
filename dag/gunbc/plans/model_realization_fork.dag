module gunbc.plans.model_realization_fork


fn model_realization_fork_body() -> List<std.markdown.MarkdownBlock> {
  [
    gunbc.plans.md_helpers.p(text: "**Status:** audit (done) + grounding order · **DESIGN.md + carriers are authority** (this *is* the DESIGN open thread, §1/§2/§7). Linked from `ROADMAP.md §0` and [fail-closed-lockdown.md](fail-closed-lockdown.md) §3a."),
    gunbc.plans.md_helpers.p(text: "**Verified against the live tree 2026-06-21** (two evidence-backed audits). Line numbers are receipts."),
    gunbc.plans.md_helpers.h2(text: "0. Verdict — single seam confirmed, dissolution is two-phase"),
    gunbc.plans.md_helpers.p(text: "Every primitive is **modeled** as a `.dag` coproduct and **realized** as a native host `Value`, reconciled by **per-site bridges** (~12–13 distinct ones across ~1500 lines of `v1_interpreter.rs`) — so coverage is accidental and non-compositional. **The single-root hypothesis is CONFIRMED:** the fail-open sites the lock-down found (the `==` straddle, the lossy cache digest, the under-keyed memos) all trace to this one seam. **But grounding does not dissolve it uniformly** — there are two sub-roots: the numeric tower (grounds cleanly) and the `Value::Null` overload (needs splitting, not grounding-away)."),
    gunbc.plans.md_helpers.h2(text: "1. The seam"),
    gunbc.plans.md_helpers.p(text: "**Native realization** — `Value` enum, 13 variants (`v1_interpreter.rs:448-483`): `Null, Bool, Int, Float, Str, List, Map, Set, Record, Variant, Closure, Fn, Unit`."),
    gunbc.plans.md_helpers.p(text: "**Modeled coproducts** (each → a native variant):"),
    std.markdown.TableBlock {
      header: gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "modeled"), gunbc.plans.md_helpers.cell(text: "form"), gunbc.plans.md_helpers.cell(text: "native"), gunbc.plans.md_helpers.cell(text: "bridge site"), gunbc.plans.md_helpers.cell(text: "coverage")]),
      alignments: [std.markdown.AlignNone, std.markdown.AlignNone, std.markdown.AlignNone, std.markdown.AlignNone, std.markdown.AlignNone],
      rows: [
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "`Nat`"), gunbc.plans.md_helpers.cell(text: "`Zero \\| Succ` (`nat.dag:21`)"), gunbc.plans.md_helpers.cell(text: "`Value::Int`"), gunbc.plans.md_helpers.cell(text: "pattern match `:2468`; eq guard `:1910`"), gunbc.plans.md_helpers.cell(text: "partial (pattern + eq only; arithmetic stays native i64)")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "`Bool`"), gunbc.plans.md_helpers.cell(text: "`True \\| False` (`logic.dag:19`)"), gunbc.plans.md_helpers.cell(text: "`Value::Bool`"), gunbc.plans.md_helpers.cell(text: "literal `:1764`; ops via `is_truthy`"), gunbc.plans.md_helpers.cell(text: "accidental (no coproduct-arm bridge; safe only because no corpus matches nominal arms)")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "`Int`"), gunbc.plans.md_helpers.cell(text: "`GroupCompletion<Nat>` (`integer.dag:41`)"), gunbc.plans.md_helpers.cell(text: "`Value::Int`"), gunbc.plans.md_helpers.cell(text: "native i64 ops"), gunbc.plans.md_helpers.cell(text: "total at op level, but native, not the modeled form")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "`Optional`"), gunbc.plans.md_helpers.cell(text: "`Absent \\| Present` (`collection.dag`)"), gunbc.plans.md_helpers.cell(text: "`Value::Null`"), gunbc.plans.md_helpers.cell(text: "pattern match `:2528`"), gunbc.plans.md_helpers.cell(text: "partial (pattern only)")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "`Witness`"), gunbc.plans.md_helpers.cell(text: "`Violates \\| Holds` (`witness.dag`)"), gunbc.plans.md_helpers.cell(text: "`Value::Null`"), gunbc.plans.md_helpers.cell(text: "pattern match `:2507`"), gunbc.plans.md_helpers.cell(text: "partial (pattern only)")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "`FreeMonoid`"), gunbc.plans.md_helpers.cell(text: "`Empty \\| Cons` (`algebra.dag:76`)"), gunbc.plans.md_helpers.cell(text: "`Value::List`/`Str`"), gunbc.plans.md_helpers.cell(text: "`free_monoid_to_vec :6225`"), gunbc.plans.md_helpers.cell(text: "total (one centralized flatten — the compositional exemplar)")]),
      ],
    },
    gunbc.plans.md_helpers.h2(text: "2. Reconciliation chokepoints (fail-open / closed / reconciled)"),
    std.markdown.TableBlock {
      header: gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "site"), gunbc.plans.md_helpers.cell(text: "file:line"), gunbc.plans.md_helpers.cell(text: "verdict")]),
      alignments: [std.markdown.AlignNone, std.markdown.AlignNone, std.markdown.AlignNone],
      rows: [
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "`Value::eq` catch-all"), gunbc.plans.md_helpers.cell(text: "`:689`"), gunbc.plans.md_helpers.cell(text: "**FAIL-OPEN** (`_ => false` on straddle) — but left infallible by design (single `CanonKey` authority)")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "`eval_binop` Eq/Ne guard"), gunbc.plans.md_helpers.cell(text: "`:1910-1922`"), gunbc.plans.md_helpers.cell(text: "**FAIL-CLOSED** (raises `CrossRepresentationEquality` on numeric straddle) — landed")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "`pattern_matches`"), gunbc.plans.md_helpers.cell(text: "`:2276-2563`"), gunbc.plans.md_helpers.cell(text: "RECONCILED (explicit per-variant arms)")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "`value_hash` / `CanonKey::new`"), gunbc.plans.md_helpers.cell(text: "`:344` / `:309`"), gunbc.plans.md_helpers.cell(text: "RECONCILED / FAIL-CLOSED (reflexivity check rejects non-reflexive)")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "`parse_table_memo` / `pure_call_memo` / `resolved_graph_cache`"), gunbc.plans.md_helpers.cell(text: "(see lock-down §3)"), gunbc.plans.md_helpers.cell(text: "reconciled-with-caveat → the under-keyed / lossy cache holes are this seam at the cache layer")]),
      ],
    },
    gunbc.plans.md_helpers.p(text: "`FreeMonoid` is the proof that compositional reconciliation is *possible* (one flatten, all ops). Every other primitive is per-site."),
    gunbc.plans.md_helpers.h2(text: "3. Grounding order (does it dissolve the guards?)"),
    gunbc.plans.md_helpers.ol(items: [
      gunbc.plans.md_helpers.li(text: "**Numeric tower — GROUNDED (#5428, 2026-06-21).** Nat construction-side grounded: `Zero → Value::Int(0)`, `Succ\{prev:Int(k)\} → Value::Int(k+1)` — native form == modeled form. `cross_representation_numeric_straddle` is dead-in-corpus for numerics; `eval_binop`'s `CrossRepresentationEquality` guard is **kept as fail-closed backstop** (not removed — guard removal is bundled with the `Value::Null` split in §3.2, fenced out of this window). The discriminating witness `cross_representation_equality_test` confirms: former fork cases now reconcile to `Bool(true)`; genuine diffs (`1==2`, `Succ\{Zero\}==Zero → Int(1)==Int(0)`) stay `false`. **Done.**"),
      gunbc.plans.md_helpers.li(text: "**`Value::Null` overload — the deeper root; NO, needs SPLITTING not grounding-away.** `Value::Null` means *None* / *Absent* (Optional) / *miss* (map lookup) / *Violates* (Witness) **all at once**. So a blanket equality guard is wrong — `present == None → false` is *legitimate* at ~131 sites. The fix is semantic: **split the sentinel** — `raw_map_lookup` returns `Optional<V>` directly (not `Null` + later bridge), Witness miss returns `Violates`, etc. — so each meaning has its own carrier. This is HIGH effort / HIGH impact and is the real depth of the root."),
      gunbc.plans.md_helpers.li(text: "**`FreeMonoid`** — mostly reconciled already; just ensure every op honours both forms."),
      gunbc.plans.md_helpers.li(text: "**`Bool`** — currently safe (no nominal-arm match in the corpus); if one lands, apply the numeric pattern (~5 lines). Low priority."),
    ]),
    gunbc.plans.md_helpers.p(text: "**Net:** grounding the numeric tower kills the *visible* straddle guards; splitting `Value::Null` is what actually closes the fail-open *class*. Until #2 lands, the cache/eq guards are per-site patches, not a dissolved root."),
    gunbc.plans.md_helpers.h2(text: "5. Infer-layer service-op String wire projection fork (algebra method attachment)"),
    gunbc.plans.md_helpers.p(text: "**Registered class (2026-08-09, #8062 trim + bold-eagle-107):** extdeps service-operation outputs declared `String from \"stdout\"` (and sibling wire fields) infer as **FaithfulFreeMonoid / Coproduct** receivers in pure-v2 closures (`rust_corpus_repr` without v1 seed), while algebra **ReceiverSelf** method templates (trim, and every other String method) attach only to the **declared String** type node. Method syntax on the wire-minted receiver refuses (`method trim not found on Coproduct(FreeMonoid)`) even though the service contract names String. Free-call `trim(s: x)` with `import std.algebra { trim }` is a **binding bridge** only — it does not unify the type nodes (#8062 scope). **Pinning witness:** `fixtures/class_b_trim/monoid_specimen.dag` + `v1-compiler-tests::trim_method_form_fails_on_freemonoid_receiver`; carrier note `extdeps.shell.exec` `service_op_string_wire_projection_method_fork_note`. **Dissolve-on:** wire projection mints the same type node the extdeps output declaration names so ReceiverSelf methods attach without a per-method binding workaround. Execution receipt for the landed binding half: [class_b trim pool-coincidence receipt](../probes/class_b_trim_pool_coincidence_receipt.md). SUPERSEDED-MECHANISM (eager-deer-389, RustCorpusRepr cutover): the trigger this class names -- v1.compiler.infer rust_corpus_repr selecting a corpus-global FaithfulFreeMonoid arm when the closure lacks v1-seed sources -- NO LONGER EXISTS. RustCorpusRepr and its closure-provenance switch are deleted; primitive realization is keyed on each type's declaring module, and the Rust text carrier is now unconditionally host-native. So the CITATION is stale even if the CLASS is not: this note's owner must re-measure whether a wire-minted receiver still forks, rather than reading the old trigger as live. One data point in that direction: emitting std.algebra::trim previously produced v1_rt::from_code_point((1 / 0)) in both arms of a tautological if -- the declared .dag seam leaking instead of routing to host realization -- and now emits v1_rt::trim(s). That is the same carrier family this class is about, but it is one function in one closure and is NOT a claim that the class is closed."),
    gunbc.plans.md_helpers.h2(text: "6. Relationship to the lock-down"),
    gunbc.plans.md_helpers.p(text: "This is the root the lock-down lane (`fail-closed-lockdown.md` §3a) was hunting. The §4 lock-down fixes (content-key caches, purity oracles, realizer-key lens) are *per-site patches* that stay necessary until this seam is grounded; grounding (esp. #2) makes whole classes of them dead code. Sequence the lock-down fixes to ship now (stop the bleeding), and the grounding (numeric tower → Null split) to dissolve the root behind them."),
  ]
}

data model_realization_fork_plan: gunbc.plan.Plan = gunbc.plan.Plan {
  slug: "model-realization-fork",
  title: "Plan — model↔realization fork (the root of the fail-open problem)",
  body: model_realization_fork_body(),
  retirement: gunbc.plan.PlanRetiresWhen { condition: std.dissolution.unbound_dissolution(description: "Delete this doc when the numeric tower is grounded (`Int`/`Nat` native = modeled, guard is dead code) **and** `Value::Null` is split into its grounded carriers (Optional/Witness/miss each own their realization). At that point the per-site bridges are gone and the seam no longer exists.")
  }
}
