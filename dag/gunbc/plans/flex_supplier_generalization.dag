module gunbc.plans.flex_supplier_generalization

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetirement, PlanRetiresWhen, PlanIsAuthorityOnly }
import std.markdown { MarkdownBlock, TableBlock, AlignNone }
import gunbc.plans.md_helpers { h2, p, li, ul, ol, cell, row }
import gunbc.design_ruling { project_documentation_projections_are_not_checkout_artifacts }

fn flex_supplier_generalization_body() -> List<MarkdownBlock> {
  [
    p(text: "Status: plan, no actuation. Work item `adhoc-09a90f72-66e`, authored 2026-10-23. Operator request: add AWS EC2 (spot first, on-demand as a separately priced candidate) as a second supplier of the flex autoscaler, target card RTX PRO 6000 Server through the g7e family. No instance is launched under this plan without the operator's go-ahead. This is a root-generalization case (DESIGN section 6b): the second supplier becomes a row, never a `flex_aws_*` fork of the Vast loop."),
    h2(text: "0. What the corpus already owns"),
    ul(items: [
      li(text: "Upstream: `extdeps.cloud.vast_ai` (offers, instances, charges, templates); supplier: `product.supplier.vast_ai` (`VastAiAskReceipt`). AWS: `extdeps.pricing.aws_ec2` (on-demand rows, M7a only) and `extdeps.access.aws_iam` (`PolicyDocument`). Neither AWS module carries an EC2 control-plane call; `extdeps.cloud.aws_ec2` does not exist."),
      li(text: "Selection: `product.fabric.selection` `select_supply` over `CandidateOffer<P>` with `AvailabilityObservation` (on-demand vs interruptible), and `std.decision` for bid level and card rank (`product.fabric.flex_market`). Supplier choice already has its home; this plan adds candidates to it, not a second chooser (DESIGN 3d)."),
      li(text: "Allocation, release, settlement: `gunbc.serving.rented_allocation` / `rented_release` / `rented_settlement` / `rented_allocation_host_enrollment`. Credential custody: `gunbc.flex_vast_credential` (SecretRef pinned version, custody host, host path)."),
    ]),
    h2(text: "1. Census: Vast-specific vs supplier-agnostic"),
    p(text: "Read by declaration from the six flex modules and the four rented modules at main 388263b185c3. Agnostic means the symbol mentions no Vast type and its meaning holds for any rented-card supplier. Vast-bound means its signature or body names an `extdeps.cloud.vast_ai` / `product.supplier.vast_ai` type or a Vast wire fact."),
    TableBlock {
      header: row(cells: [cell(text: "Module"), cell(text: "Supplier-agnostic (stays, consumed by both rows)"), cell(text: "Vast-bound (becomes the Vast row of a supplier interface)")]),
      alignments: [AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "`product.fabric.flex_policy`"), cell(text: "All of it: `FlexPolicy`, `FlexMachineKey` (already keyed by `provider: DeclarationRef` + account + machine), `FlexAcquisitionStanding`, `FlexBidAttempt<P>`, `FlexBidRefusal`, `flex_bid_admission`, `flex_on_demand_reference_cost`, `flex_relative_ceiling`, occupancy and window folds."), cell(text: "None by type. Two Vast assumptions in prose: the owner label as the only isolation on a shared account (a Vast fact; on AWS isolation is the account and the tag), and `min_bid` named as a Vast wire decimal.")]),
        row(cells: [cell(text: "`product.fabric.flex_market`"), cell(text: "`FlexVramClass`, `FlexOwnerLabel`/`FlexOwnership`, `FlexOwnedCard`, rank assessment and `flex_select_owned_cards`, release window/admit/pass, `flex_cleanup_dead`, `flex_rented_card_fungible`, `flex_dollars_per_vram`."), cell(text: "`FlexBidLevel` and the whole bid-level learner (`flex_choose_bid_level*`, tallies, `flex_class_market_median`, `flex_quoted_bid`): it prices a bid on a bid market. EC2 spot is not a bid market (section 3), so this is the Vast row's pricing rule, not the agnostic one. `flex_offer_driver_major(VastAiOffer)`. Dissolution `flex_wet_consumes_vast_write_shapes`.")]),
        row(cells: [cell(text: "`product.fabric.flex_vast_shadow`"), cell(text: "`FlexWriteDecision`, the complete-roster discipline (`sole_constructor` rosters, page folds, id uniqueness) as a SHAPE, `flex_cap_from_complete`, `FlexShadowFieldEntry`, the trial policy/objective/recipe data, `FlexServingTemplate`/`FlexTemplateRealization` (as concepts), `flex_reconcile_acquisition` as a shape."), cell(text: "Every roster and page type is instantiated at `VastAiInstance`/`VastAiCharge`; `FlexVastHostFilters`, `flex_vast_offer_query`, `flex_vast_gpu_catalog_row`, `flex_offer_card_facts`, `flex_offer_screen_by_recipe`, `flex_interruptible_rentable`, `flex_offer_disk_rate` and the storage billing month, search type/limits, `flex_vast_offer_key`, `flex_candidates_from_vast_offer`, `flex_vast_account`, `flex_shadow_bid`, `flex_find_instance`.")]),
        row(cells: [cell(text: "`product.fabric.flex_vast_loop`"), cell(text: "`FlexPassInput`/`FlexPassPlan`/`FlexPassOutcome` and `flex_plan_pass` as control flow; the walls (`flex_entry_wall`, `flex_quote_wall`, `flex_budget_wall`, `flex_wet_gate_wall`, `flex_placement_wall`); `FlexKeyStanding` from custody; `flex_cooldown_from_ask`; the wire renderers."), cell(text: "`FlexCreateRequest` (Vast PUT body: disk in Vast gigabytes, template hash), `flex_create_perform`, `flex_reconcile_ours` over Vast rosters, `flex_charge_owner(VastAiCharge)`, `flex_spent`, `flex_provider_declaration` (pinned to `extdeps.cloud.vast_ai`), `flex_vast_template_hashes`, pool password minting (a Vast-onstart input that both rows need, so it moves to the template).")]),
        row(cells: [cell(text: "`product.fabric.flex_vast_template` (+ `_control`)"), cell(text: "`flex_vast_onstart` (the script itself is supplier-agnostic: it needs a driver 580+, disk, POOL_API_KEY and PORT, and nothing Vast); `flex_template_forbidden_env_names`."), cell(text: "`FlexTemplateSpec` is the Vast template row (runtype, ssh_direct, jup_direct, use_jupyter_lab, min_cuda_max_good, verified_only); `flex_template_decide`/`judge_row` over `VastAiTemplateRow`; the control module is the Vast template ensure.")]),
        row(cells: [cell(text: "`gunbc.serving.rented_*`"), cell(text: "`RentedServingAllocation` and everything except the fields listed right; `RentedEndCondition`, engine, artifact, host access, route."), cell(text: "`RentedAllocationAcquired.provider_ask: VastAiAskReceipt`; `RentedInstanceObserved { instance: VastAiInstance }` and `rented_label_matches`/`rented_destroy_admitted` over it; `rented_allocation_host_enrollment` over `VastAiOfferHostResources`; `rented_settlement` entirely over `VastAiCharge` and the Vast charges day range.")]),
      ],
    },
    p(text: "Census reading: the policy, admission and selection layers are already agnostic, and `FlexBidAttempt<P>` is already parametric. The Vast binding sits in five places: the offer screen (shadow), the bid pricing rule (market), the write and reconcile (loop), the template, and four fields of the rented carriers. That is where the supplier interface goes; nothing above it moves."),
    h2(text: "2. The generalized supplier interface"),
    p(text: "Not a trait with a dispatching `match` inside the loop: DESIGN section 3 puts the dispatch that selects a realization at the periphery. Each supplier is one row of a `FlexSupplierRow` carrier in `product.fabric` (name settled in PR 4), whose fields are the five bindings above, each typed in agnostic vocabulary and realized per supplier:"),
    ol(items: [
      li(text: "**Observe offers -> `List<FlexScreenedCandidate<NonEmptyStr>>`.** Each supplier screens its own offer shape against the ONE serving recipe (disk, VRAM, driver floor, host RAM floor, TP width) and emits `CandidateOffer`s with `AvailabilityObservation` set (Vast interruptible bid, Vast on-demand, AWS spot, AWS on-demand are four availability readings, not four loops). The machine key's `provider` is the supplier's extdeps anchor, so `FlexCandidateMachineMismatch` already refuses a cross-supplier bind."),
      li(text: "**Price rule -> the bid `FlexBidAttempt` carries.** Vast: the bid-level learner (unchanged). AWS spot: the observed spot price plus a MaxPrice ceiling equal to the admitted rate (section 3). Both feed `flex_bid_admission` unchanged, so the fleet rate cap, the on-demand relative ceiling and currency refusal are one rule across suppliers."),
      li(text: "**Complete owned roster -> `FlexOwnedCard`s.** Each supplier mints a complete roster by its own paging (Vast keyset pages; EC2 DescribeInstances NextToken) and maps to `FlexOwnedCard`. Ownership is `FlexOwnership` from the supplier's label carrier (Vast instance label; EC2 tag). The cap, release and cleanup folds then run once over the union, so the fleet cap is a fleet cap and not a per-supplier one."),
      li(text: "**Create / release write shapes.** Typed per supplier in its extdeps module; the loop holds a `FlexCreateIntent` that is agnostic and a per-row request builder. The release keeps `rented_release` admission (bound instance, our label) with the instance observation generalized from `VastAiInstance` to a supplier-tagged observation."),
      li(text: "**Settlement observation.** Vast: the charges walk. AWS: there is no per-instance charges call on the EC2 API; spend is observed through billing (Cost Explorer / cost and usage report) with a lag of hours. Until an AWS settlement observation is modeled, an AWS allocation settles as `RentedSettlementUnobserved`-class refusal (typed, countable), and the budget wall counts the AWS standing rate x elapsed time as a conservative liability, never zero. This is a declared frontier, not a silent gap."),
    ]),
    p(text: "Rented carriers: `provider_ask` becomes a supplier-tagged ask receipt (Vast `VastAiAskReceipt` | EC2 RunInstances reservation and instance id), and `RentedInstanceObserved` likewise. These are two-arm sums whose arms live in each supplier module, consumed by one release/settlement fold. Generalizing them is a replacement migration of a carrier; delete-first applies, and the consumer census for each field is listed in PR 4."),
    h2(text: "3. The AWS realization"),
    ul(items: [
      li(text: "**Launch:** one EC2 launch template per serving recipe (CreateLaunchTemplate / CreateLaunchTemplateVersion), instance launched with RunInstances (`InstanceMarketOptions.MarketType = spot`, `SpotOptions.SpotInstanceType = one-time`, `InstanceInterruptionBehavior = terminate`, `MaxPrice` = admitted rate) and `TagSpecifications` carrying the owner label. CreateFleet type `instant` is the alternative when one call must try several sizes or zones; it is admitted only if selection has already chosen, so the fleet is never a second chooser (`allocation-strategy` would be a selection inside actuation, DESIGN 3d). Recommendation: RunInstances, one chosen candidate per call."),
      li(text: "**Price observation:** DescribeSpotPriceHistory per (instance type, availability zone, product description `Linux/UNIX`), the latest point within a freshness window; stale or missing is `FlexMarketPriceUnobserved`, never a guessed price. EC2 spot has no bid auction: the customer pays the current spot price and `MaxPrice` only caps it (AWS spot pricing model since 2017). So the Vast bid-level learner does not apply; the AWS price rule is observed price, admitted against the same ceilings."),
      li(text: "**On-demand:** a separate candidate with `AvailabilityObservation` on-demand, priced from the AWS Price List (GetProducts) as an observation, also serving as the `FlexOnDemandReference` for the relative ceiling. It is never a fallback inside actuation: if spot capacity is refused (`InsufficientInstanceCapacity`, `MaxSpotInstanceCountExceeded`), the next pass re-selects with that candidate excluded and on-demand still in the field."),
      li(text: "**Sizes as candidates (calm-crab-645 addendum):** every g7e size carries the same GPU and differs in host vCPU, RAM, NVMe and network. Each size is its own candidate, priced PER GPU (instance rate / GPU count) on the VRAM-hour axis. Hard constraints, excluded before Pareto: (a) host RAM at or above the recipe floor, which is the 26.8 GiB PLE table resident plus process overhead, unswappable because it is read randomly per token; (b) local instance-store NVMe present, mounted at `/cache` for the onstart's LMCache L2 disk KV tier, never EBS (a gp3 volume at its baseline throughput makes a session reload of about 10 GB take over a minute, slower than re-prefill); (c) TP width: a TP2 recipe requires a size with at least two GPUs in ONE instance, never cross-instance TP. Above the floor, host RAM (sizes the L1 tier) and NVMe capacity are priced axes, not exclusions. Per-size GPU count, vCPU, RAM, instance-store NVMe and network are read from the AWS instance-type documentation and DescribeInstanceTypes (`InstanceStorageInfo`) in PR 2, cited and versioned; this plan transcribes none of them. The launch template (PR 3) formats and mounts the instance-store volume(s) at `/cache` before the container starts, and refuses to start serving if it is absent."),
      li(text: "**Image and user-data:** an AMI with NVIDIA driver 580+ and docker plus the NVIDIA container toolkit (the AWS Deep Learning Base GPU AMI is the candidate; its driver version is read and pinned in PR 3, by AMI id per region via its SSM parameter). User-data is a thin wrapper that runs the lil image under docker with the SAME `flex_vast_onstart` as the container entry: one script, two realizations. The Vast-specific half of `FlexTemplateSpec` stays in the Vast row; the shared half (image, digest, port, shm, disk, env contract, onstart) becomes one agnostic serving-template carrier both rows read. The script is referenced, never copied. POOL_API_KEY reaches the container from the instance at boot without entering user-data or the launch template (user-data is readable by anyone with DescribeInstanceAttribute); route chosen in PR 3."),
      li(text: "**Interruption:** EC2 posts a two-minute notice (IMDS `spot/instance-action`, and the EventBridge `EC2 Spot Instance Interruption Warning`). On notice the card is drained (admission stops sending it new turns) and the allocation is released; the release is then observed as terminated by the roster. **A reclaimed card loses its KV cache. Sessions routed to it re-prefill on whichever card next serves them: added latency and re-prefill cost, not lost correctness.** This is the same consequence as a Vast interruptible outbid, now stated for both rows; it is priced as an interruption-rate reading on the candidate, not hidden."),
      li(text: "**The notice is best effort** (AWS EC2 User Guide, `spot-instance-termination-notices`: interruption notices are emitted on a best-effort basis; AWS recommends polling every 5 seconds). So the notice is never the only route to release: a roster pass that finds an owned instance in `shutting-down` / `terminated` with no notice seen releases it the same way, and that arm is counted separately (an unannounced reclaim)."),
      li(text: "**Observation of the notice:** the loop reads it in the roster pass (DescribeInstances state plus instance-status) and, on the card, the onstart wrapper polls IMDS and stops accepting turns. The harness-side drain is the existing release window; the two-minute bound is shorter than the reconstruction window (`flex_reconstruction`, 300 s), so an AWS interruption is always a hard loss, never a graceful migration."),
    ]),
    h2(text: "4. Credentials and operator actions"),
    p(text: "Custody follows `gunbc.flex_vast_credential`: a pinned `SecretRef` version, a custody host and a host path, no key in the corpus. Nothing in a public PR names an account id, key, private endpoint or a price tied to the operator's buying. The existing `flex_vast_account` row is an account identity in public source; the AWS row will not repeat that and takes the account as an observation at run time."),
    p(text: "Operator actions, none taken by this lane:"),
    ol(items: [
      li(text: "An IAM principal for the loop (role assumed from a custody host, or a user with an access key held in the secret store). Permissions, all scoped by region and by `aws:RequestTag`/`ec2:ResourceTag` owner label where the action supports it: ec2:RunInstances, ec2:CreateTags (on create only), ec2:TerminateInstances (tag-conditioned), ec2:DescribeInstances, ec2:DescribeInstanceTypes, ec2:DescribeSpotPriceHistory, ec2:DescribeImages, ec2:CreateLaunchTemplate, ec2:CreateLaunchTemplateVersion, ec2:DescribeLaunchTemplates, ec2:DescribeLaunchTemplateVersions, ssm:GetParameter (the AMI parameter), pricing:GetProducts. The policy is written as an `extdeps.access.aws_iam` `PolicyDocument` row in PR 2, so the grant is modeled, not described."),
      li(text: "Service Quotas: the vCPU quota for G and VT spot instance requests, and the running on-demand G and VT instances quota, in the chosen region(s), raised to cover the largest size the policy may admit. New accounts start at a low or zero G quota, so this gates any launch."),
      li(text: "Region choice and confirmation that g7e is offered there (read with DescribeInstanceTypeOfferings in PR 2)."),
      li(text: "Confirmation that the credits apply to EC2 spot and on-demand usage in that region (credit terms are the operator's, not modeled here)."),
    ]),
    h2(text: "5. Delivery, each its own PR"),
    ol(items: [
      li(text: "This plan."),
      li(text: "`extdeps.cloud.aws_ec2`: request/response shapes for RunInstances, TerminateInstances, DescribeInstances (paged), DescribeSpotPriceHistory, DescribeInstanceTypes, CreateLaunchTemplate(Version), and the interruption notice; cited to the EC2 API reference with the API version (2016-11-15). g7e rows in `extdeps.pricing.aws_ec2` as instance-type facts only, cited; the IAM policy row in `extdeps.access.aws_iam` vocabulary."),
      li(text: "The agnostic serving template carrier, the Vast row reading it unchanged, and the EC2 launch-template realization reading the same `flex_vast_onstart`."),
      li(text: "Loop generalization: the supplier row carrier, the Vast row as its first inhabitant (behavior-preserving, existing witnesses stay green), the rented carriers' supplier-tagged arms, then the AWS spot row wired in Plan mode (`ApplyMode` Plan) only. Apply for AWS is a separate operator go-ahead."),
    ]),
    h2(text: "6. Open decisions"),
    ul(items: [
      li(text: "**D1 RunInstances vs CreateFleet instant. DECIDED 2026-10-23 (calm-crab-645): RunInstances.** Selection stays in `std.decision`; no fleet allocation strategy inside actuation."),
      li(text: "**D2 AWS settlement. DECIDED 2026-10-23 (calm-crab-645): Apply is not blocked on billing.** The budget wall counts a conservative liability per AWS instance = max(admitted spot price, MaxPrice) x billed time, where billed time is per second from the `running` state with a one-minute minimum per start, and ends at `shutting-down` (AWS EC2 User Guide, `ec2-instance-lifecycle`, section Billing by instance state). Settlement unobserved is a DECLARED `gunbc.rung_drop` row, filed with PR 4, whose restoration trigger is a modeled AWS billing observation (cost and usage report or Cost Explorer) joined per instance id."),
      li(text: "**D3 isolation.** Recommend a dedicated AWS account or at least a dedicated region-scoped role for flex, so the tag is not the only isolation (on Vast it is, by necessity)."),
    ]),
  ]
}

data flex_supplier_generalization_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly { ruling: project_documentation_projections_are_not_checkout_artifacts },
  slug: "flex-supplier-generalization",
  title: "Flex autoscaler: Vast and AWS EC2 as supplier rows",
  body: flex_supplier_generalization_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "Retires when the flex loop selects over supplier rows with Vast and AWS EC2 as inhabitants, no flex symbol outside a supplier row names an extdeps.cloud.vast_ai type, and the AWS row runs its Plan-mode pass green by execution.") }
}
