module gunbc.plans.flex_supplier_generalization

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetirement, PlanRetiresWhen, PlanIsAuthorityOnly }
import std.markdown { MarkdownBlock, TableBlock, AlignNone }
import gunbc.plans.md_helpers { h2, p, li, ul, ol, cell, row }
import gunbc.design_ruling { project_documentation_projections_are_not_checkout_artifacts }

fn flex_supplier_generalization_body() -> List<MarkdownBlock> {
  [
    p(text: "Status: plan, no actuation. Work item `adhoc-09a90f72-66e`, authored 2026-10-23. Operator request: add AWS EC2 (spot first, on-demand as a separately priced candidate) as a second supplier of the flex autoscaler, target card RTX PRO 6000 Server through the g7e family. No instance is launched under this plan without the operator's go-ahead. This is a root-generalization case (DESIGN section 6b): the second supplier becomes a row, never a `flex_aws_*` fork of the Vast loop."),
    h2(text: "0. What the corpus already owns"),
    ul(items: [
      li(text: "Upstream: `extdeps.cloud.vast_ai` (offers, instances, charges, templates); supplier: `product.supplier.vast_ai` (its `VastAiAskReceipt` was deleted by gunbc#14879). AWS: `extdeps.pricing.aws_ec2` (on-demand rows, M7a only) and `extdeps.access.aws_iam` (`PolicyDocument`). Neither AWS module carries an EC2 control-plane call; `extdeps.cloud.aws_ec2` does not exist."),
      li(text: "Selection: `product.fabric.selection` `select_supply` over `CandidateOffer<P>` with `AvailabilityObservation` (on-demand vs interruptible), and `std.decision` for bid level and card rank (`product.fabric.flex_market`). Supplier choice already has its home; this plan adds candidates to it, not a second chooser (DESIGN 3d)."),
      li(text: "Allocation, release, settlement: `gunbc.serving.rented_allocation` / `rented_release` / `rented_settlement` / `rented_allocation_host_enrollment`. Credential custody: `gunbc.flex_vast_credential` (SecretRef pinned version, custody host, host path)."),
    ]),
    h2(text: "1. Census: Vast-specific vs supplier-agnostic"),
    p(text: "Read by declaration from the six flex modules and the four rented modules at main 388263b185c3. Agnostic means the symbol mentions no Vast type and its meaning holds for any rented-card supplier. Vast-bound means its signature or body names an `extdeps.cloud.vast_ai` / `product.supplier.vast_ai` type or a Vast wire fact."),
    TableBlock {
      header: row(cells: [cell(text: "Module"), cell(text: "Supplier-agnostic (stays, consumed by both rows)"), cell(text: "Vast-bound (becomes the Vast row of a supplier interface)")]),
      alignments: [AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "`product.fabric.flex_policy`"), cell(text: "All of it: `FlexPolicy`, `FlexMachineKey` (already keyed by `provider: DeclarationRef` + account + machine), `FlexAcquisitionStanding`, `FlexBidAttempt<P>`, `FlexBidRefusal`, `flex_bid_admission`, `flex_on_demand_reference_cost`, `flex_relative_ceiling`, occupancy and window folds."), cell(text: "None by type. Two Vast assumptions in prose: the owner label as the only isolation on a shared account (a Vast fact; on AWS isolation is the account and the tag), and `min_bid` named as a Vast wire decimal.")]),
        row(cells: [cell(text: "`product.fabric.flex_market`"), cell(text: "`FlexVramClass`, `FlexOwnerLabel`/`FlexOwnership`, `FlexOwnedCard`, rank assessment and `flex_select_owned_cards`, release window/admit/pass, `flex_cleanup_dead`, `flex_rented_card_fungible`, `flex_dollars_per_vram`."), cell(text: "`FlexBidLevel` and the whole bid-level learner (`flex_choose_bid_level*`, tallies, `flex_class_market_median`, `flex_quoted_bid`): it prices a bid on a bid market. EC2 spot is not a bid market (section 3), so this is the Vast row's pricing rule, not the agnostic one. `flex_offer_driver_major(VastAiOffer)`. Dissolution `flex_wet_consumes_vast_write_shapes`.")]),
        row(cells: [cell(text: "`product.fabric.flex_vast_shadow`"), cell(text: "`FlexWriteDecision`, the complete-roster discipline (`sole_constructor` rosters, page folds, id uniqueness) as a SHAPE, `flex_cap_from_complete`, `FlexShadowFieldEntry`, the trial policy/objective/recipe data, `FlexServingTemplate`/`FlexTemplateRealization` (as concepts), `flex_reconcile_acquisition` as a shape."), cell(text: "Every roster and page type is instantiated at `VastAiInstance`/`VastAiCharge`; `FlexVastHostFilters`, `flex_vast_offer_query`, `flex_vast_gpu_catalog_row`, `flex_offer_card_facts`, `flex_offer_screen_by_recipe`, `flex_interruptible_rentable`, `flex_offer_disk_rate` and the storage billing month, search type/limits, `flex_vast_offer_key`, `flex_candidates_from_vast_offer`, `flex_vast_account`, `flex_shadow_bid`, `flex_find_instance`.")]),
        row(cells: [cell(text: "`product.fabric.flex_vast_loop`"), cell(text: "`FlexPassInput`/`FlexPassPlan`/`FlexPassOutcome` and `flex_plan_pass` as control flow; the walls (`flex_entry_wall`, `flex_quote_wall`, `flex_budget_wall`, `flex_wet_gate_wall`, `flex_placement_wall`); `FlexKeyStanding` from custody; `flex_cooldown_from_ask`; the wire renderers."), cell(text: "`FlexCreateRequest` (Vast PUT body: disk in Vast gigabytes, template hash), `flex_create_perform`, `flex_reconcile_ours` over Vast rosters, `flex_charge_owner(VastAiCharge)`, `flex_spent`, `flex_provider_declaration` (pinned to `extdeps.cloud.vast_ai`), `flex_vast_template_hashes`, pool password minting (a Vast-onstart input that both rows need, so it moves to the template).")]),
        row(cells: [cell(text: "`product.fabric.flex_vast_template` (+ `_control`)"), cell(text: "`flex_vast_onstart` (the script itself is supplier-agnostic: it needs a driver 580+, disk, POOL_API_KEY and PORT, and nothing Vast); `flex_template_forbidden_env_names`."), cell(text: "`FlexTemplateSpec` is the Vast template row (runtype, ssh_direct, jup_direct, use_jupyter_lab, min_cuda_max_good, verified_only); `flex_template_decide`/`judge_row` over `VastAiTemplateRow`; the control module is the Vast template ensure.")]),
        row(cells: [cell(text: "`gunbc.serving.rented_*`"), cell(text: "`RentedServingAllocation` and everything except the fields listed right; `RentedEndCondition`, engine, artifact, host access, route."), cell(text: "`RentedAllocationAcquired.provider_ask: VastAiAskReceipt` (deleted, not generalized: see 3c); `RentedInstanceObserved { instance: VastAiInstance }` and `rented_label_matches`/`rented_destroy_admitted` over it; `rented_allocation_host_enrollment` over `VastAiOfferHostResources`; `rented_settlement` entirely over `VastAiCharge` and the Vast charges day range.")]),
      ],
    },
    p(text: "Census reading: the policy, admission and selection layers are already agnostic, and `FlexBidAttempt<P>` is already parametric. The Vast binding sits in five places: the offer screen (shadow), the bid pricing rule (market), the write and reconcile (loop), the template, and four fields of the rented carriers. That is where the supplier interface goes; nothing above it moves."),
    h2(text: "2. The generalized supplier interface"),
    p(text: "Not a trait with a dispatching `match` inside the loop: DESIGN section 3 puts the dispatch that selects a realization at the periphery. Each supplier is one row of a `FlexSupplierRow` carrier in `product.fabric` (name settled in PR 4), whose fields are the five bindings above, each typed in agnostic vocabulary and realized per supplier:"),
    ol(items: [
      li(text: "**Observe offers -> `List<FlexScreenedCandidate<NonEmptyStr>>`.** Each supplier screens its own offer shape against the ONE serving recipe (disk, VRAM, driver floor, host RAM floor, TP width) and emits `CandidateOffer`s with `AvailabilityObservation` set (Vast interruptible bid, Vast on-demand, AWS spot, AWS on-demand are four availability readings, not four loops). The machine key's `provider` is the supplier's extdeps anchor, so `FlexCandidateMachineMismatch` already refuses a cross-supplier bind."),
      li(text: "**Price rule -> the bid `FlexBidAttempt` carries.** Vast: the bid-level learner (unchanged). AWS spot: the observed spot price plus a MaxPrice ceiling equal to the admitted rate (section 3). Both feed `flex_bid_admission` unchanged, so the fleet rate cap, the on-demand relative ceiling and currency refusal are one rule across suppliers."),
      li(text: "**Complete owned roster -> `FlexOwnedCard`s.** Each supplier mints a complete roster by its own paging (Vast keyset pages; EC2 DescribeInstances NextToken) and maps to `FlexOwnedCard`. Ownership is `FlexOwnership` from the supplier's label carrier (Vast instance label; EC2 tag). The cap, release and cleanup folds then run once over the union, so the fleet cap is a fleet cap and not a per-supplier one."),
      li(text: "**Create / release write shapes.** Typed per supplier in its extdeps module; the loop holds a `FlexCreateIntent` that is agnostic and a per-row request builder. The release keeps `rented_release` admission (bound instance, our label) with the instance observation generalized from `VastAiInstance` to a supplier-agnostic reading each supplier maps into (section 3c, 4a)."),
      li(text: "**Settlement observation.** Vast: the charges walk. AWS: there is no per-instance charges call on the EC2 API; spend is observed through billing (Cost Explorer / cost and usage report) with a lag of hours. Until an AWS settlement observation is modeled, an AWS allocation settles as `RentedSettlementUnobserved`-class refusal (typed, countable), and the budget wall counts the AWS standing rate x elapsed time as a conservative liability, never zero. This is a declared frontier, not a silent gap."),
    ]),
    p(text: "Rented carriers: `RentedInstanceObserved` becomes a supplier-AGNOSTIC shape, never a supplier sum (DESIGN 3: a generic hub may not enumerate concrete products): the instance reading is `{ id, owner_label, status }`, and each supplier module maps its own instance into it. `provider_ask` is DELETED with no agnostic replacement: no release or settlement consumer reads it, and what a create names before actuation differs by supplier in kind (Vast: the selected offer and machine; EC2: a client token, with the instance id known only after the answer), so the pending-create standing stays in the supplier row (Vast: `product.fabric.flex_vast_shadow::FlexCreateStanding`). The derivation is in section 3c (4a). Generalizing them is a replacement migration of a carrier; delete-first applies, and the consumer census for each field is listed in 3c."),
    h2(text: "3. The AWS realization"),
    ul(items: [
      li(text: "**Launch:** one EC2 launch template per serving recipe (CreateLaunchTemplate / CreateLaunchTemplateVersion), instance launched with RunInstances (`InstanceMarketOptions.MarketType = spot`, `SpotOptions.SpotInstanceType = one-time`, `InstanceInterruptionBehavior = terminate`, `MaxPrice` = admitted rate) and `TagSpecifications` carrying the owner label. CreateFleet type `instant` is the alternative when one call must try several sizes or zones; it is admitted only if selection has already chosen, so the fleet is never a second chooser (`allocation-strategy` would be a selection inside actuation, DESIGN 3d). Recommendation: RunInstances, one chosen candidate per call."),
      li(text: "**Price observation:** DescribeSpotPriceHistory per (instance type, availability zone, product description `Linux/UNIX`), the latest point within a freshness window; stale or missing is `FlexMarketPriceUnobserved`, never a guessed price. EC2 spot has no bid auction: the customer pays the current spot price and `MaxPrice` only caps it (AWS spot pricing model since 2017). So the Vast bid-level learner does not apply; the AWS price rule is observed price, admitted against the same ceilings."),
      li(text: "**On-demand:** a separate candidate with `AvailabilityObservation` on-demand, priced from a LIVE AWS Price List GetProducts observation (a new interface shape and CLI projection in PR 2; `extdeps.pricing.aws_ec2` holds only static M7a us-east-1 rows and is not a g7e price), also serving as the `FlexOnDemandReference` for the relative ceiling. It is never a fallback inside actuation: if spot capacity is refused (`InsufficientInstanceCapacity`, `MaxSpotInstanceCountExceeded`), the next pass re-selects with that candidate excluded and on-demand still in the field."),
      li(text: "**Sizes as candidates (calm-crab-645 addendum; corrected by review):** every g7e size carries the same GPU and differs in host vCPU, RAM, NVMe and network. Each size is its own candidate, and each states its LAYOUT: N independent replicas, one TP=N replica, or k GPUs used with N-k idle (an idle GPU is billed and delivers no token). Hard constraints, excluded before Pareto: (a) host RAM at or above the recipe floor, which is the 26.8 GiB PLE table resident plus process overhead, unswappable because it is read randomly per token; (b) local instance-store NVMe present, mounted at `/cache` for the onstart's LMCache L2 disk KV tier, never EBS (a gp3 volume at its baseline throughput makes a session reload of about 10 GB take over a minute, slower than re-prefill); (c) TP width: a TP2 recipe requires a size with at least two GPUs in ONE instance, never cross-instance TP. Above the floor, host RAM (sizes the L1 tier) and NVMe capacity are priced axes, not exclusions. Per-size GPU count, vCPU, RAM, instance-store NVMe and network are read from the AWS instance-type documentation and DescribeInstanceTypes (`InstanceStorageInfo`) in PR 2, cited and versioned; this plan transcribes none of them. The launch template (PR 3) formats and mounts the instance-store volume(s) at `/cache` before the container starts, and refuses to start serving if it is absent."),
      li(text: "**Candidate field and objective (operator, 2026-10-23; corrected by review).** Workload is batch and interruption-tolerant; objective = lowest price per DELIVERED TOKEN. A candidate is (region, availability zone, size, layout, spot | on-demand). It is NOT ranked on instance price per GPU: its quote is the existing unit-cost authority, `product.fabric.serving_recipe::serving_cost_per_million_tokens` read through `serving_unit_cost_for_selection`, which already refuses an Estimated or unread unit cost, so no parallel GPU-hour ranking is built. The hourly input is the observed instance rate R (DescribeSpotPriceHistory for spot, Price List GetProducts for on-demand). Delivered tokens per second T is a THROUGHPUT READING keyed by (recipe, instance type, GPU topology, replica/TP layout, host and cache realization); `ServingRecipe.throughput` is keyed by recipe alone today, so widening that key is a modeling obligation of PR 4, landed before the AWS row ranks anything. Over an instance lifetime L with startup S, cost per token = R*L / (3600*T*(L-S)), further raised by the capacity lost to interruption (re-prefill of the sessions the card held) and to re-tuning. Until T and L are both READ for a candidate, it is needs-evidence (SelectionNeedsEvidence), never ranked on a prior. Hard constraints, excluded before ranking: the quota constraint below, the host RAM floor, local NVMe, single-instance TP. Latency is not an axis."),
      li(text: "**Startup and lifetime are readings (operator, 2026-10-23; corrected by review).** A new instance delivers no token until it has its weights on local NVMe and its kernels tuned. Startup time S is a MEASURED reading per (region, size), observed launch -> first served token; the operator figures of about 3-5 min warm and 15-25 min cold are a bet, replaced by the first measurements. Expected lifetime L per (region, AZ, size) is a reading of OUR OWN observed lifetimes (launch -> interruption notice or termination). The AWS Spot Instance Advisor interruption-frequency band (cited `CitedToAuthority` to the advisor data) is a PRIOR: it may order which pools are probed first, but it is not an observed lifetime and does not make a candidate rankable. A cheap pool with high churn loses through L-S in the cost formula, with no special rule. On-demand candidates carry the same startup reading, with lifetime bounded by the policy horizon."),
      li(text: "**Quota is account-wide usage plus the candidate, not the quota alone (review).** The account is shared, so the hard constraint per region and quota code is: account-wide vCPU in use (running instances and open or pending spot requests of every workload, not only ours) + the candidate size vCPUs <= applied quota. Usage is read from the Service Quotas usage metric in CloudWatch (namespace AWS/Usage, the metric the quota names); applied quota from GetServiceQuota, with the on-demand code resolved through ListServiceQuotas (paginated) to a typed resolution verdict. Unread usage refuses the candidate and is never read as 0. A 0-quota region is excluded, not ranked."),
      li(text: "**Correlated interruptions: spread when prices are near-equal.** Spot reclaims come in bursts across instances in one pool (region and AZ), so packing the single cheapest pool concentrates loss. The fleet carries a per-pool concentration limit as a policy parameter, applied as a hard constraint on each new candidate (a pool at its limit is excluded for this pass, not ranked), which spreads capacity when the price difference is inside the switch premium. It is a constraint in the existing `select_supply` field, not a second chooser."),
      li(text: "**Image, weights and tuning cache (operator, 2026-10-23), all in PR 3.** (a) AMI = NVIDIA driver 580+, docker and the NVIDIA container toolkit, and the lil image at its pinned digest already pulled; built once, then CopyImage to each enabled region (AMI id per region is a read, not a literal). (b) Weights: one S3 bucket per enabled region holding the pinned Hugging Face revision; at boot a parallel S3 client copies them to the instance-store NVMe. No Mountpoint or lazy reads, and no weights in the EBS snapshot: lazy-loading a snapshot costs about what the HF download does unless Fast Snapshot Restore is enabled, which is priced out. (c) Kernel-tuning cache in the same bucket, keyed by the COMPLETE preimage (GPU model, driver version, image digest, model revision, recipe and TP width). A miss tunes and publishes; a partial key match is never reused (`std.materialization_ladder`, `extdeps.realization.cache_purity`). (d) ONE onstart: `flex_vast_onstart` stays the single serving script, and the S3 fetch (weights and tuning cache to /cache) is a pre-step selected by supplier, the Vast row selecting none. Nothing is copied. POOL_API_KEY: see the credential delivery item below."),
      li(text: "**Where the image reads its caches (observation, calm-crab-645, read on Vast rentals of the pinned image 2026-10-16..22 with `lil-serve --print-config` and a listing of the image; not yet read from lil-serve source).** Weights: `HF_HOME=/root/.cache/huggingface`, served from `hub/models--local-inference-lab--Qwen3.8-Flash-Next-NVFP4-MXFP8-CSF-QAD/snapshots/<revision>`. That is on the root disk, not /cache, so on EC2 the pre-step places the hub directory on the instance-store mount and binds it at that path. Tuning and JIT caches (Triton, vLLM, TorchInductor, CuTe DSL, the b12x compile, CUDA, tilelang, tvm, numba, cupy, XDG) all live under `/cache/jit/<runtime-lock hash>/<profile>-<profile hash>/`, so lil already keys them by runtime lock and profile identity. The S3 tuning-cache key is that directory name PLUS the GPU model and the driver version, which the path does not carry (Server and Workstation editions share the `rtx-pro-6000-pcie` profile, the only RTX PRO 6000 profile in the image, and Server-edition rentals have served on it). Before the key is relied on, the derivation is read in lil-serve itself; until then the key is the observed directory name plus GPU model, driver and the image digest, which can only over-separate, never over-share."),
      li(text: "**Credential delivery (DECIDED 2026-10-23, calm-crab-645: SSM).** The loop writes POOL_API_KEY as an SSM Parameter Store `SecureString` encrypted with a KMS key, AFTER RunInstances returns the instance id, under a name keyed by that instance id. The instance role reads it once at boot (ssm:GetParameter and kms:Decrypt on the flex prefix). The onstart wrapper polls with a bounded wait and REFUSES on timeout, typed and logged. The loop deletes the parameter on enrollment. Nothing secret goes in user-data, tags or console output. **Stated residual:** scoping each instance to its own parameter would need `ec2:SourceInstanceARN` as a policy variable in the Resource element. The IAM documentation lists it only as a condition key compared with a literal ARN (IAM User Guide, `reference_policies_condition-keys`; EC2 User Guide, `ExamplePolicies_EC2`, example `iam-example-source-instance`) and does not document it as a variable. The only documented per-instance form is a policy per instance, which would hand the loop iam:PutRolePolicy. So the role reads the whole prefix: during its boot window one flex instance could read another live card's key. All such cards are ours, the key is per rental, and it is deleted on enrollment, so the exposure is bounded to the boot windows that overlap."),
      li(text: "**Interruption:** EC2 posts a two-minute notice (IMDS `spot/instance-action`, and the EventBridge `EC2 Spot Instance Interruption Warning`). On notice the card is drained (admission stops sending it new turns) and the allocation is released; the release is then observed as terminated by the roster. **A reclaimed card loses its KV cache. Sessions routed to it re-prefill on whichever card next serves them: added latency and re-prefill cost, not lost correctness.** This is the same consequence as a Vast interruptible outbid, now stated for both rows; it is priced as an interruption-rate reading on the candidate, not hidden."),
      li(text: "**The notice is best effort** (AWS EC2 User Guide, `spot-instance-termination-notices`: interruption notices are emitted on a best-effort basis; AWS recommends polling every 5 seconds). So the notice is never the only route to release: a roster pass that finds an owned instance in `shutting-down` / `terminated` with no notice seen releases it the same way, and that arm is counted separately (an unannounced reclaim)."),
      li(text: "**Observation of the notice (corrected by review):** the notice needs a control-plane path to the loop. Two are possible, and PR 4 sends the choice before building: (a) the EventBridge `EC2 Spot Instance Interruption Warning` event, with a rule and a target subscription the loop reads and its payload shape modeled in `extdeps.cloud.aws_ec2`; or (b) a card -> loop report: the onstart wrapper polls IMDS `spot/instance-action`, stops accepting turns, and reports the notice over the existing enrollment route. DescribeInstances state alone does not observe the notice; a roster that loses an owned instance with no notice seen stays the separately counted unannounced path. The harness-side drain is the existing release window; the two-minute bound is shorter than the reconstruction window (`flex_reconstruction`, 300 s), so an AWS interruption is always a hard loss, never a graceful migration.
"),
    ]),
    h2(text: "3b. The EC2 boot path, design before build"),
    p(text: "PR 3a (#14866) made the serving image one supplier-agnostic fact (`product.fabric.flex_serving_image`). The EC2 realization of it is three moves, each reusing a home the census found:"),
    ol(items: [
      li(text: "**Weights on an object store already has a home and is bound too narrowly.** `product.fabric.serving_recipe` `ServingWeightsSource` has `WeightsPlacedOnObjectStore { placement: RentedWeightsPlacement }`, but `gunbc.serving.rented_ninfer_source` `RentedWeightsPlacement` pairs a ninfer model row with a Cloudflare R2 key. The S3-per-region weights are the same concept, so the placement generalizes over the store (R2 locator | S3 bucket and key per region, resolved at boot from an SSM parameter so no bucket name is a literal) and over the pin (ninfer row | Hugging Face repository at a pinned revision). Flash-Next moves from `WeightsNamedUnpinned` to the pinned revision observed on the image (section 3, cache paths). Second leaf of one rule, so generalize, not add a sibling (DESIGN 6b)."),
      li(text: "**The container is typed, not scripted.** `extdeps.docker.cli` `DockerCreateSpec` is the home for a container launch. The EC2 container is one such spec: image `flex_serving_image_reference`, GPUs all, IPC host, shm from the image, binds `/cache` and the HF hub dir on the NVMe at `/root/.cache/huggingface`, PORT from the image, POOL_API_KEY through `--env-file` from a root-only file the pre-step wrote (so the value is in no argv), restart unless-stopped, entrypoint bash running the one onstart followed by `wait` (the onstart backgrounds its server and returns, so a container whose main process is the bare onstart would exit). `--env-file` and `--entrypoint` are real docker CLI flags the spec does not yet carry; they are added to the spec. No production site constructs `DockerCreateSpec` today, so the added fields break no caller."),
      li(text: "**The irreducibly procedural pre-step is ONE counted `gunbc.retained_shell_script` `RetainedShellScript` row**, with a reason and a dissolve-on target (the typed host-effect model), never a free String. It: assembles the instance-store NVMe (RAID0 when more than one disk), mounts it at /cache, refuses if none; reads the region and instance id from IMDSv2; fetches the weights with a parallel S3 copy; fetches the tuning cache for its complete key, where a hit requires a `complete` sentinel object written last; polls SSM for the per-instance POOL_API_KEY with a bounded wait and REFUSES on timeout; writes the env file and starts the container. After the server answers `/health`, on a miss only, it publishes `/cache/jit` under the key and writes the sentinel last, so a reader never sees a partial cache. Selected per supplier: the AWS row selects this pre-step, the Vast row selects none, and the onstart is shared by both."),
    ]),
    p(text: "**Every placement verifies the bytes against the pin before serving (calm-crab-645, 2026-10-23).** The pin is `extdeps.local_inference_lab.qwen3_8_flash_next` `qwen3_8_flash_next_files`: the Hub tree answer at the revision, every file with its size and its digest (`extdeps.huggingface.hub` `HubFileDigest`: LFS SHA-256, or the git blob SHA-1 for small files). The pre-step checks every file against it, refuses on any mismatch, and refuses when the snapshot holds a file the pin does not name or misses one it does. A bucket copy never stands in for the pin unverified. The verifier was exercised on the real bytes of the 14 git-blob files and the smallest LFS file, and refused a one-byte corruption in each. The AMI therefore also carries git (for `git hash-object`) and mdadm."),
    p(text: "User-data is that pre-step followed by the rendered `docker create` / `docker start` argv (`extdeps.exec.command` `shell_command_render`); nothing secret is in it. The launch template is an `extdeps.cloud.aws_ec2` `AwsEc2CreateLaunchTemplateRequest` built from the baked AMI id (a per-region read), IMDSv2 required, and the user-data. Order: 3b lands after #14862 and #14866, since it needs both and a stacked PR gets no CI."),
    h2(text: "3c. PR 4, design before build"),
    p(text: "**What the pass does today.** `gunbc.fleet.flex_pass_run` `pass` walks the Vast roster and charges, searches offers, screens them, and reports, for every member, the create it would ask for and every wall in front of it. It runs with NO intent: selection is the declared frontier `product.fabric.flex_vast_loop` `flex_select_supply_consumer_frontier`. So the AWS row in Plan mode is the same: observe, screen into candidates, report walls, and choose nothing. Wiring `select_supply` over the union of both rows is the next step, and it closes that frontier for both rows at once, not one per supplier."),
    ol(items: [
      li(text: "**4a, the row carrier, Vast as its first inhabitant, behavior-preserving.** Status: the rented-carrier and Vast-destroy half is landed (gunbc#14879); the row fold and Vast as its first row are NOT yet landed. The pass becomes a fold over supplier rows, each yielding its observation (complete owned roster, spend standing), its screened candidates (`FlexScreenedCandidate`) and its walls into one receipt. The Vast row is today's code moved behind the row boundary. Its receipt lines and `test.claim.fabric.flex_vast_loop_witness` / `flex_vast_shadow_witness` stay green. The Vast-typed rented-carrier fields become supplier-agnostic shapes each supplier maps into (`RentedInstanceObserved`, `RentedDestroyRequest`), and `provider_ask` is deleted, as derived below; settlement stays the Vast realization and host enrollment is mapped when the AWS row needs it. Consumers by name: `gunbc.serving.rented_allocation`, `rented_release`, `rented_settlement`, `rented_allocation_host_enrollment`, `product.fabric.flex_vast_loop`, and witnesses `test.claim.serving.rented_allocation_witness`, `rented_release_witness`, `rented_settlement_witness`, `test.claim.fabric.flex_vast_loop_witness`."),
      li(text: "**4b, the AWS row, Plan mode, read-only.** It reads regions, offerings, quotas, instance types, spot price history and the owned roster (DescribeInstances by owner tag). It screens (region, AZ, size, spot | on-demand) candidates with the hard constraints of section 3, and reports each with its walls. With no AWS credential bound it refuses typed and reports that, never an empty field read as no supply."),
    ]),
    p(text: "**Open decision D4, the AWS transport.** The corpus already signs AWS-compatible requests with `curl --aws-sigv4` and a netrc credential (`extdeps.tools.curl`, built for R2), but the EC2 Query API answers in XML and the corpus has no XML parser. Service Quotas, SSM and the Price List answer JSON. Options: (A) the AWS CLI with `--output json` as the transport handler, parsed with `extdeps.languages.json.parse`; it signs itself and reads the credential from its environment on the custody host, never argv. (B) curl SigV4 plus a new XML reader for the EC2 answers. **DECIDED 2026-10-23 (calm-crab-645): A, AWS CLI v2 with `--output json`, under four conditions.** (1) The CLI is its own independently versioned upstream: its own extdeps module with a pinned version, and the JSON it emits is modeled as that CLI's projection of the `extdeps.cloud.aws_ec2` shapes, not edited into them. (2) Transport is one handler bound to the interface: the loop calls the interface operation, and the CLI row is its realization, so a later curl-SigV4 plus XML handler is a row swap, not a loop edit. (3) Credentials come from the environment or a 0600 credentials file on the custody host only, never argv, and the CLI `--debug` flag is never enabled there. (4) The region is pinned explicitly on every call, never an ambient default, because region is a selection variable."),
    p(text: "**4a carrier generalization, by anti-unification of what the consumers read.** `gunbc.serving.rented_release` reads an instance only for its id and its owner label, and no release or settlement fold reads `provider_ask`. So the least general carriers are agnostic: `RentedInstanceObserved { id, owner_label }` and `RentedDestroyRequest { instance_id: NonEmptyStr }`, with each supplier mapping its own instance into them (Vast: id and label; EC2: instance id and the owner tag). `provider_ask` is DELETED, not generalized: an agnostic `{ ask, machine }` would unify by name, not by fact (a Vast machine id is known before actuation, an EC2 instance id only after the answer or a client-token reconcile), and no admitted consumer reads it. The pending-create receipt stays supplier-local (Vast: `FlexCreateStanding`; EC2: the client token, in the AWS row). No supplier sum appears in the hub (DESIGN 3: a generic hub may not enumerate concrete products). `rented_destroy_perform`, the Vast destroy call, moves out of the agnostic release module into the Vast row as `flex_vast_destroy_perform`, and its target is resolved only among instances carrying the owner label in the pass's complete roster (`flex_vast_destroy_target`). SEQUENCING, stated honestly: the carrier and destroy migration above is landed (gunbc#14879); the `FlexSupplierRow` fold with Vast as its first row is NOT yet landed and remains the next 4a implementation step, before the AWS row (4b). Settlement stays the Vast realization (a walk of Vast charges), and the AWS row settles unobserved under the declared drop (D2). Host enrollment over `VastAiOfferHostResources` is mapped the same way when the AWS row needs it (4b)."),
    h2(text: "4. Credentials and operator actions"),
    p(text: "Custody follows `gunbc.flex_vast_credential`: a pinned `SecretRef` version, a custody host and a host path, no key in the corpus. Nothing in a public PR names an account id, key, private endpoint or a price tied to the operator's buying. The existing `flex_vast_account` row is an account identity in public source; the AWS row will not repeat that and takes the account as an observation at run time."),
    p(text: "Operator actions, none taken by this lane:"),
    ol(items: [
      li(text: "An IAM principal for the loop (role assumed from a custody host, or a user with an access key held in the secret store). Permissions, all scoped by region and by `aws:RequestTag`/`ec2:ResourceTag` owner label where the action supports it: ec2:RunInstances, ec2:CreateTags (on create only), ec2:TerminateInstances (tag-conditioned), ec2:DescribeInstances, ec2:DescribeInstanceTypes, ec2:DescribeSpotPriceHistory, ec2:DescribeImages, ec2:CreateLaunchTemplate, ec2:CreateLaunchTemplateVersion, ec2:DescribeLaunchTemplates, ec2:DescribeLaunchTemplateVersions, ssm:GetParameter (the AMI parameter), pricing:GetProducts. For credential delivery, the loop principal needs ssm:PutParameter / ssm:DeleteParameter and kms:Encrypt on the flex prefix and key, and the instance role needs ssm:GetParameter / kms:Decrypt on the same, plus iam:PassRole on that role for RunInstances. Add servicequotas:GetServiceQuota, servicequotas:ListServiceQuotas, ec2:DescribeRegions and ec2:DescribeInstanceTypeOfferings for the region axis. The policy is written as an `extdeps.access.aws_iam` `PolicyDocument` row in PR 4, so the grant is modeled, not described. For the image and caches add ec2:CopyImage, ec2:DescribeImages, and s3:GetObject / s3:ListBucket on the per-region weight buckets plus s3:PutObject on the tuning-cache prefix only (the instance role, not the loop principal). Separately, the operator creates the Budgets cost budget filtered to the owner tag (activated as a cost-allocation tag) and its APPLY_IAM_POLICY action with an execution role; the amount is the operator parameter."),
      li(text: "Service Quotas: the vCPU quota for G and VT spot instance requests, and the running on-demand G and VT instances quota, in the chosen region(s), raised to cover the largest size the policy may admit. New accounts start at a low or zero G quota, so this gates any launch."),
      li(text: "Region: NOT fixed (operator, 2026-10-23). The loop reads the regions that offer g7e (DescribeRegions, then DescribeInstanceTypeOfferings per region) and, per region, the applied G and VT spot and on-demand vCPU quotas (Service Quotas GetServiceQuota, ListServiceQuotas) beside the account-wide usage of each (CloudWatch AWS/Usage), since the account is shared. The operator raises quota in the regions the policy should reach; which regions those are is the first Plan-mode pass output, not a list written here."),
      li(text: "Credits cover EC2 spot: confirmed by the operator 2026-10-23."),
    ]),
    h2(text: "5. Delivery, each its own PR"),
    ol(items: [
      li(text: "This plan."),
      li(text: "`extdeps.cloud.aws_ec2`: request/response shapes for RunInstances, TerminateInstances, DescribeInstances (paged), DescribeSpotPriceHistory, DescribeInstanceTypes, CreateLaunchTemplate(Version), and the interruption notice; cited to the EC2 API reference with the API version (2016-11-15). g7e rows in `extdeps.pricing.aws_ec2` as instance-type facts only, cited; Service Quotas (GetServiceQuota) and Budgets (budget, budget action) in their own modules, `extdeps.cloud.aws_service_quotas` and `extdeps.cloud.aws_budgets`, as separately versioned AWS services. The flex principal IAM policy is policy, not upstream: a `PolicyDocument` row beside the credential custody (the `gunbc.flex_vast_credential` pattern) in PR 4."),
      li(text: "The agnostic serving template carrier, the Vast row reading it unchanged, and the EC2 launch-template realization reading the same `flex_vast_onstart`."),
      li(text: "Loop generalization: the supplier row carrier, the Vast row as its first inhabitant (behavior-preserving, existing witnesses stay green), the rented carriers made supplier-agnostic (section 3c), then the AWS spot row wired in Plan mode (`ApplyMode` Plan) only. Apply for AWS is a separate operator go-ahead."),
    ]),
    h2(text: "6. Open decisions"),
    ul(items: [
      li(text: "**D1 RunInstances vs CreateFleet instant. DECIDED 2026-10-23 (calm-crab-645): RunInstances.** Selection stays in `std.decision`; no fleet allocation strategy inside actuation."),
      li(text: "**D2 AWS settlement. DECIDED 2026-10-23 (calm-crab-645): Apply is not blocked on billing.** The budget wall counts a conservative liability per AWS instance = max(admitted spot price, MaxPrice) x billed time, where billed time is per second from the `running` state with a one-minute minimum per start, and ends at `shutting-down` (AWS EC2 User Guide, `ec2-instance-lifecycle`, section Billing by instance state). Settlement unobserved is a DECLARED `gunbc.rung_drop` row, filed with PR 4, whose restoration trigger is a modeled AWS billing observation (cost and usage report or Cost Explorer) joined per instance id."),
      li(text: "**D3 isolation. DECIDED 2026-10-23 (operator): no dedicated account.** Isolation is two layers. (a) IAM conditioned on the owner tag (`aws:RequestTag` on launch, `ec2:ResourceTag` on terminate). (b) A hard spend budget: the autoscaler liability ceiling (`product.fabric.flex_policy`, refuse a launch whose projected liability would exceed it) AND an AWS Budgets action that attaches a deny-`ec2:RunInstances` policy to the flex principal at the cap, a backstop for the case where our accounting is wrong. Budgets evaluates lagging billing data, so it can only ever be the second layer. The amount is a policy parameter, never a literal in the corpus."),
    ]),
  ]
}

data flex_supplier_generalization_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly { ruling: project_documentation_projections_are_not_checkout_artifacts },
  slug: "flex-supplier-generalization",
  title: "Flex autoscaler: Vast and AWS EC2 as supplier rows",
  body: flex_supplier_generalization_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "Retires when the flex loop selects over supplier rows with Vast and AWS EC2 as inhabitants, no flex symbol outside a supplier row names an extdeps.cloud.vast_ai type, and the AWS row runs its Plan-mode pass green by execution.") }
}
