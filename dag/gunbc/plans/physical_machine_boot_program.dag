module gunbc.plans.physical_machine_boot_program

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetiresWhen, PlanIsAuthorityOnly }
import gunbc.design_ruling {
  project_documentation_projections_are_not_checkout_artifacts,
  one_physical_machine_boot_transaction, physical_and_guest_control_remain_distinct,
  machine_mode_names_drop_the_unit,
}
import std.markdown { MarkdownBlock }
import gunbc.plans.md_helpers { p }
import std.types { String }

// THE DESIGN ARGUMENT BEHIND gunbc.design_ruling one_physical_machine_boot_transaction AND
// physical_and_guest_control_remain_distinct. The rulings record the decision; this carrier records the
// target shape, the cut order and the open decisions, which until now lived only in an operator-adopted
// side-chat review (2026-10-14) and a session's pinned plan. It carries no measurement: populations and
// receipts are cited by module and symbol, never transcribed.

fn ruling_names() -> List<String> {
  [
    one_physical_machine_boot_transaction.reference.decl_name as String,
    physical_and_guest_control_remain_distinct.reference.decl_name as String,
    machine_mode_names_drop_the_unit.reference.decl_name as String,
  ]
}

fn opening() -> List<MarkdownBlock> {
  [
    p(text: "Goal: one physical-machine boot transaction and convergence entry, with no per-machine workflow roots. Arrival qualification, provisioning, reset and recovery consume boot; a universal managed-host lifecycle is not the target."),
    p(text: concat("Rulings (gunbc.design_ruling): ", join(ruling_names(), ", "))),
  ]
}

fn axes() -> List<MarkdownBlock> {
  [
    p(text: "Join three independent axes: current physical assembly/firmware identity (machine_intake.subject UnitKey and MachineIntakeSubject); optional fleet participation (fleet_enrollment HostEnrollmentIntent and fleet_host_backing OwnedMachine, with UnitKeyStanding absent until serial observation); and sealed control standing (host_control_route ControlledHost over bmc_control_binding), keyed by controller endpoint and unit so unenrolled arrivals remain controllable."),
    p(text: "A changed DIMM or firmware invalidates the old subject receipt. Roles never select boot implementations. Retire BMC-specific managed_host; obtain BMC capabilities from observed firmware-release catalogs, not per-unit copies. Ampere SMpro is an optional platform capability, absent rather than refused on x86."),
  ]
}

fn transaction() -> List<MarkdownBlock> {
  [
    p(text: "Method: request (subject, target, revision, consumer terminal requirement, authorization, maintenance hold) → admission → identified plan (route, delivery, target, expected terminal) → attempt → effect progress → independent terminal readback. Preserve not-started, unreached, began/completion-unknown, failed and reported-applied progress. Bind the receipt to exact subject, revision, attempt, incarnation and observed terminal; acknowledgement is never boot success."),
    p(text: "Separate artifact identity, delivery, boot target and terminal demand. Arrival requires diagnostic attestation; provisioning installed-system identity; reset down-then-back; runner qualification readiness. IPMI/Redfish virtual media, PXE/HTTP, installed disk, provider rebuild and appliance first boot are adapters. A known machine adds rows, not a workflow, mode or host-name branch."),
  ]
}

fn guests() -> List<MarkdownBlock> {
  [
    p(text: "Guests share runtime identity, OS/configuration convergence, workload assignment, attempt/incarnation vocabulary and independent-readback semantics. Their inventory, controllers, media and power interfaces remain distinct from physical machines."),
  ]
}

fn cuts() -> List<MarkdownBlock> {
  [
    p(text: "Cut order: finish managed-host untangling (#14062–#14065; its cut ledger is preserved at 80c2a87d1b6^:docs/plans/managed-host-untangle.md); (3) extract common boot around mtcollins1 without changing its operation sequence; (4) force a second protocol and OS-installation consumer through srv3; (5) replace host_reset_return with first-class local disk and terminal observation from another host, then delete old actuation; (6) PXE/HTTP provisioning with matching physical/runtime identity; (7) host/workload convergence; finally rename modes after old roots disappear."),
    p(text: "Cut 7 preserves capture-before-effect, named permitted delta, effect reachability, independent readback, incarnation, genuine pending state, rollback from observed progress and multi-subject requirements. Reuse these transaction semantics from the deleted Spark work, not its Docker/vLLM choices."),
  ]
}

fn decisions() -> List<MarkdownBlock> {
  [
    p(text: "Settled: use PXE/HTTP for ASRock ALTRAD8UD-1L2T at OpenBMC 3.22 (operator 2026-10-16), not firmware downgrade; the catalog grants NbdProxyVirtualMedia only to 2.07.00, with base capabilities at 3.06.00/3.22.00. Open: qualify in-band BMC credential recovery with typed admission/refusal, effect progress and independent readback, and decide its convergence owner."),
    p(text: "Validate onboarding breadth: another supported unit needs observation/inventory/enrollment rows; a new board one authority and binding; a new CPU architecture on a supported OS only artifact-compatibility/platform rows; a new controller one witnessed adapter; a new role only participation/workload assignment. Retirement requires the shared boot and convergence entries to serve every physical machine, with per-machine roots removed."),
  ]
}

data physical_machine_boot_program_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly { ruling: project_documentation_projections_are_not_checkout_artifacts },
  slug: "physical-machine-boot-program",
  title: "Physical-machine boot program: one boot transaction, three joined axes, and the cut order to retire per-machine roots",
  body: concat(concat(concat(concat(concat(opening(), axes()), transaction()), guests()), cuts()), decisions()),
  retirement: PlanRetiresWhen {
    condition: unbound_dissolution(description: "Retire this plan when every physical machine boots through the one boot transaction AND is reconciled through the one physical-machine convergence entry (cuts 6 and 7 landed: OS provisioning, host-system and workload convergence), and no per-machine workflow mode or boot root remains (the mtcollins1, srv3 and host_reset_return roots deleted, and the mode renames landed)."),
  },
}
