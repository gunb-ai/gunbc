module gunbc.plans.physical_machine_boot_program

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetiresWhen, PlanIsAuthorityOnly }
import gunbc.design_ruling {
  project_documentation_projections_are_not_checkout_artifacts,
  one_physical_machine_boot_transaction, physical_and_guest_control_remain_distinct,
  machine_mode_names_drop_the_unit, boot_delivery_persistence_and_role_are_independent_axes,
}
import std.markdown { MarkdownBlock }
import gunbc.plans.md_helpers { p }
import std.types { String }

// THE DESIGN ARGUMENT BEHIND gunbc.design_ruling one_physical_machine_boot_transaction AND
// physical_and_guest_control_remain_distinct. The rulings record the decision; this carrier records the
// target shape, the cut order and the open decisions, which until now lived only in an operator-adopted
// side-chat review (2026-10-14) and a session's pinned plan. It carries no measurement: populations and
// receipts are cited by module and symbol, never transcribed.

fn ruling_names() -> List<String> {
  [
    one_physical_machine_boot_transaction.reference.decl_name as String,
    physical_and_guest_control_remain_distinct.reference.decl_name as String,
    machine_mode_names_drop_the_unit.reference.decl_name as String,
    boot_delivery_persistence_and_role_are_independent_axes.reference.decl_name as String,
  ]
}

fn opening() -> List<MarkdownBlock> {
  [
    p(text: "Goal: one physical-machine boot transaction and convergence entry, with no per-machine workflow roots. Arrival qualification, provisioning, reset and recovery consume boot; a universal managed-host lifecycle is not the target."),
    p(text: concat("Rulings (gunbc.design_ruling): ", join(ruling_names(), ", "))),
  ]
}

fn axes() -> List<MarkdownBlock> {
  [
    p(text: "Join three independent axes: current physical assembly/firmware identity (machine_intake.subject UnitKey and MachineIntakeSubject); optional fleet participation (fleet_enrollment HostEnrollmentIntent and fleet_host_backing OwnedMachine, with UnitKeyStanding absent until serial observation); and sealed control standing (host_control_route ControlledHost over bmc_control_binding), keyed by controller endpoint and unit so unenrolled arrivals remain controllable."),
    p(text: "A changed DIMM or firmware invalidates the old subject receipt. Roles never select boot implementations. Retire BMC-specific managed_host; obtain BMC capabilities from observed firmware-release catalogs, not per-unit copies. Ampere SMpro is an optional platform capability, absent rather than refused on x86."),
  ]
}

fn transaction() -> List<MarkdownBlock> {
  [
    p(text: "Method: request (subject, target, revision, consumer terminal requirement, authorization, maintenance hold) → admission → identified plan (route, delivery, target, expected terminal) → attempt → effect progress → independent terminal readback. Preserve not-started, unreached, began/completion-unknown, failed and reported-applied progress. Bind the receipt to exact subject, revision, attempt, incarnation and observed terminal; acknowledgement is never boot success."),
    p(text: "Separate artifact identity, delivery, boot target and terminal demand. Arrival requires diagnostic attestation; provisioning installed-system identity; reset down-then-back; runner qualification readiness. IPMI/Redfish virtual media, PXE/HTTP, installed disk, provider rebuild and appliance first boot are adapters. A known machine adds rows, not a workflow, mode or host-name branch."),
  ]
}

fn guests() -> List<MarkdownBlock> {
  [
    p(text: "Guests share runtime identity, OS/configuration convergence, workload assignment, attempt/incarnation vocabulary and independent-readback semantics. Their inventory, controllers, media and power interfaces remain distinct from physical machines."),
  ]
}

fn cuts() -> List<MarkdownBlock> {
  [
    p(text: "Cut order: finish managed-host untangling (#14062–#14065; its cut ledger is preserved at 80c2a87d1b6^:docs/plans/managed-host-untangle.md); (3) extract common boot around mtcollins1 without changing its operation sequence; (4) force a second protocol and OS-installation consumer through srv3; (5) replace host_reset_return with first-class local disk and terminal observation from another host, then delete old actuation; (6) PXE/HTTP provisioning with matching physical/runtime identity; (7) host/workload convergence; finally rename modes after old roots disappear."),
    p(text: "Cut 7 preserves capture-before-effect, named permitted delta, effect reachability, independent readback, incarnation, genuine pending state, rollback from observed progress and multi-subject requirements. Reuse these transaction semantics from the deleted Spark work, not its Docker/vLLM choices."),
  ]
}

fn decisions() -> List<MarkdownBlock> {
  [
    p(text: "Settled: use PXE/HTTP for ASRock ALTRAD8UD-1L2T at OpenBMC 3.22 (operator 2026-10-16), not firmware downgrade; the catalog grants NbdProxyVirtualMedia only to 2.07.00, with base capabilities at 3.06.00/3.22.00. Open: qualify in-band BMC credential recovery with typed admission/refusal, effect progress and independent readback, and decide its convergence owner."),
    p(text: "Validate onboarding breadth: another supported unit needs observation/inventory/enrollment rows; a new board one authority and binding; a new CPU architecture on a supported OS only artifact-compatibility/platform rows; a new controller one witnessed adapter; a new role only participation/workload assignment. Retirement requires the shared boot and convergence entries to serve every physical machine, with per-machine roots removed."),
  ]
}

// THE SEPARATED AXES (ruling boot_delivery_persistence_and_role_are_independent_axes, 2026-11-02). Each
// axis names the authority that already owns it; where none exists, the gap is named and owned below.
fn separated_axes() -> List<MarkdownBlock> {
  [
    p(text: "Seven independent axes, each with one home. (1) Physical identity and controller capability: gunbc.machine_intake.subject MachineIntakeSubject, gunbc.host.host_control_route ControlledHost, and extdeps.bmc.capability readings bound to an observed firmware release. (2) Artifact and architecture: gunbc.boot_artifact BootArtifact (content-addressed, per architecture). (3) Delivery: gunbc.boot_artifact_delivery BootArtifactDelivery is THE route authority (RedfishVirtualMediaPull, MegaRacRestRemoteMedia, OpenBmcNbdProxyWebsocket, OpenBmcConfigfsUsbGadget, UefiHttpBoot, PxeChainBoot), with its solver, BootDeliveryRequest and BoundBootDeliveryEvidence. Boot CONTROL (BootControlObligation) stays separate from delivery. (4) OS storage and persistence: NO home yet (gap P below). (5) Initialization: gunbc.provisioning.ubuntu_autoinstall_seed and public_nocloud_seed (installed) or the delivered artifact's own init (diskless). (6) Trust establishment: gunbc.fleet.fleet_host_key_enrollment KnownHostKeyRow and gunbc.host.anchored_host_transport; the trust STRATEGY is an open operator decision, not settled here. (7) Workload role and lifecycle: participation and assignment (gunbc.fleet.fleet_enrollment HostEnrollmentIntent), with runners consuming an initialized host (gunbc.fleet.fleet_revision_acceptance AcceptedFleetRevision for the workload revision)."),
    p(text: "Forks to consolidate onto axis 3, which are not new homes: gunbc.provisioning.provisioning_arm DeliveryStrategy (PxeOrUefiHttp | VirtualMedia) and the legacy gunbc.os_install_mechanism OsInstallMechanism each name 'which route' a second and third time; gunbc.machine_intake.megarac_media_attach drives MegaRAC media directly rather than through a BootArtifactDelivery constructor. Known shape gaps (census by sleek-deer-601 at f441733b): gunbc.machine_intake.access BootDeliveryTarget is keyed on a BmcControllerEndpoint, and solve_boot_artifact_delivery refuses on an unbound BMC access context and on missing BMC boot-source override BEFORE judging any candidate, so a BMC-less PXE host is unrepresentable. The fix is a target sum (controller-addressed or network-addressed by MAC) and a solve in which BMC-gated candidates are ineligible-with-cause rather than refusing the whole solve; a BMC-less host's boot control is its firmware's own (BootControlObligation), not a delivery precondition. A fourth naming, ubuntu_autoinstall_seed SeedDeliveryStrategy, also exists. The one declared preference, PreferStandardRedfishThenOemThenNetwork, must cite the ruling that set it; if none exists, choosing between two eligible routes is SelectionNeedsPolicy until the operator rules."),
  ]
}

fn persistence_axis() -> List<MarkdownBlock> {
  [
    p(text: "Gap P, OS storage and persistence, a new closed axis carried by the boot REQUEST, never inferred from the route: Ephemeral (the OS root runs from the delivered artifact in memory; no OS root is installed or read from disk) | UseInstalled { system } (boot the installed OS already on a named disk, identified by its installed-system identity) | InstallThenUse { target, intent } (write the delivered installer's OS to an explicit target disk, then boot it). InstallThenUse is the only destructive arm. Its target reuses the disk selection that already exists, gunbc.provisioning.ubuntu_autoinstall_seed TargetDiskSelection (DiskSelected with its DiskSelectionProvenance; SelectionRefused when no, several, or a non-persistent disk matches); that selection is not an Ubuntu fact and moves to the neutral persistence home when P lands, and is not copied. Its intent is an explicit, attempt-bound authorization. There is no default target, and an absent target or intent refuses before any effect. Persistence here governs the OS ROOT only. Workload, cache and data volumes are a separate, explicit attachment (named device and intent), available in every mode: a diskless host MUST work with none, and an Ephemeral OS root does not forbid an explicitly attached data disk. Repeated convergence of a host whose installed system already matches the requested revision is a no-op (UseInstalled), never a reinstall."),
    p(text: "Delivery and persistence are orthogonal: every route on axis 3 can carry Ephemeral or InstallThenUse, and UseInstalled needs no delivery (boot control only: BootControlObligation targets the local disk). The terminal readback differs by persistence, not by route: Ephemeral proves the delivered artifact digest is running; UseInstalled proves the installed-system identity and revision; InstallThenUse proves installed-root identity (network_install_receipt InstalledRootReading) and then the post-install boot of that root."),
  ]
}

fn cross_product() -> List<MarkdownBlock> {
  [
    p(text: "Route x persistence, worked examples (each a row, never a workflow): (a) MegaRacRestRemoteMedia x Ephemeral: today's mtcollins1 runner-host ISO, booted live, with no disk touched. (b) PxeChainBoot x Ephemeral: a diskless runner on a PXE-only host, kernel and initrd from the site edge (gunbc.site_pxe_edge). (c) PxeChainBoot x InstallThenUse: the site edge's per-MAC grub plus NoCloud seed (#15136) autoinstalling to an explicit NVMe target, then booting it. (d) MegaRacRestRemoteMedia x InstallThenUse: an installer ISO over vendor media to an explicit target. (e) no delivery x UseInstalled: an already-installed host. Ordinary initialize/converge reads its installed identity and changes nothing, and never reboots a healthy host. A reboot happens only on an explicit boot or reset intent in the request, which is what replaces gunbc.host_reset_return's actuation. (f) UefiHttpBoot x Ephemeral or InstallThenUse: same as (b) and (c) where firmware serves UEFI HTTP. Independence of the axes is abstract: it does NOT mean every adapter carries every artifact in both modes. A row is feasible only where the artifact's format and architecture are compatible with the route (e.g. an ISO for vendor virtual media; kernel plus initrd or an EFI loader for PXE/UEFI HTTP) and the persistence mode is supported by that artifact (an installer for InstallThenUse; a live image for Ephemeral). Each row's feasibility comes from verified readings of axes 1 to 3 for THAT host; an unverified route is excluded before selection, and an uncatalogued firmware asks for evidence (std.decision SelectionNeedsEvidence)."),
  ]
}

fn adapter_obligations() -> List<MarkdownBlock> {
  [
    p(text: "Every delivery adapter (one BootArtifactDelivery constructor, its protocol facts in its own extdeps module) owes: admission from the evidence relevant to THAT route, never a board name: a BMC media adapter needs a verified controller firmware binding (extdeps.bmc.capability), while PXE/UEFI HTTP needs network and host-firmware evidence (gunbc.site_pxe_edge client admission, gunbc.network_boot_delivery NetworkBootDeliveryEstablishment), never the BMC catalog; a typed progress record (not-started, unreached, began-completion-unknown, failed, reported-applied), preserved across retries; independent terminal readback, meaning the resulting state is separately OBSERVED (console output, an in-band read over the trusted transport, or a read from another host) rather than inferred from the actuation's acknowledgement. A different transport is not mandatory where the hardware offers only one, and no hardware gate is invented to force one; detach and restore of prior boot control (BootArtifactDeliveryObligation DetachAfterUse, BootControlObligation RestoreBootState); and recovery: a refusal names the observed controller state and leaves the host in a state the next attempt reads, never one it must guess. A protocol with no verified reading of its API on a given firmware is a declared frontier, not a constructor guess (OpenBMC and ASRock media until read; the Supermicro H11SSL controller is UNKNOWN, and its interface implies neither MegaRAC nor standard Redfish media; no capability is inferred from indirect signs such as a cdc_ether interface)."),
  ]
}

fn initialized_host_contract() -> List<MarkdownBlock> {
  [
    p(text: "The boot transaction's consumer-facing terminal is an INITIALIZED HOST: host identity, reach, trust (a presented host key matched to a pin through gunbc.host.anchored_host_transport), and OS identity. The running-OS fact is a sum keyed on persistence: RunningDeliveredArtifact { digest } for Ephemeral, RunningInstalledSystem { identity } for UseInstalled and InstallThenUse; the record never assumes the running OS is the delivered image. Beside it sits the boot id read over that trusted transport, orthogonal to persistence: one HostBootId (gunbc.host.host_boot_id), which the runner's ServiceBootId becomes rather than a second name. The trust row is the anchor the binding matched, carried by the binding, not looked up again. Runner initialization requirements (runner account, the accepted workload revision via fleet_revision_acceptance) sit ON TOP of an initialized host and are never boot prerequisites. Trust establishment is its own axis with a defined interface: every strategy yields the same thing, a KnownHostKeyRow pin (gunbc.fleet.fleet_host_key_enrollment) bound to this boot or this installed system and consumed by gunbc.host.anchored_host_transport, which refuses an absent or mismatched pin. Supported concrete strategies: (T1) per-boot key: the booted OS generates a host key, its fingerprint is read over an independently observed console (SOL) and pinned for that boot only (needs a console channel; proposals #15523/#15554); (T2) provisioned key: the key is minted ON the install target during the install and its pin enrolled from that install's provisioning record - the public half announced over the console of the install boot, joined to that attempt's install receipt - valid across boots of that installed system and dead at reinstall; initial provisioning needs NO secret store and no IAM (the store is a rotation arm of its custody interface, not a dependency of installed-host trust), and gunbc.plans.host_trust_provisioned_key is the T2 note this plan cites for its mint, custody and lifecycle). Trust on first use is NOT a strategy: an unpinned first contact refuses. Selection is per host, from the host's verified capabilities (console channel; persistence mode, since T1 suits Ephemeral and T2 suits installed systems), and the per-host policy choice is the only open operator decision. Implementation of both strategies is not blocked by it."),
  ]
}

fn verification() -> List<MarkdownBlock> {
  [
    p(text: "Tests owed by each implementing change (hermetic witnesses, with a discriminating RED plus a positive control, and an inhabitance claim from a real producer per gunbc.design_argument::witness_one_interface): a request with InstallThenUse and no explicit target or intent refuses before any effect; a UseInstalled converge whose installed identity already matches does nothing destructive; selection excludes an unverified route and asks for evidence on an uncatalogued firmware; one transaction serves at least two route x persistence rows with no host-name branch; the initialized-host record refuses without a matched pin; a runner initialization refuses an unaccepted revision before any hold. Live receipts come later, per host, and are not prerequisites for the model."),
  ]
}

fn ownership() -> List<MarkdownBlock> {
  [
    p(text: "Owners and order (2026-11-02). A, sleek-deer-601: consolidate route naming onto BootArtifactDelivery (census of DeliveryStrategy, OsInstallMechanism and the direct MegaRAC attach; re-point or delete), and close the BMC-less BootDeliveryTarget gap. B, quiet-gull-101: the initialized-host record (gunbc.host.initialized_host, on main) and runner initialization on top of it (gunbc.runner.runner_initialization, stacked on #15266). C, cool-owl-599: the first-contact read battery and an identity-verified capability table per board; read-only reads need no per-board approval, and live and power effects keep their restrictions. Gap P (persistence axis) is owned with this plan by merry-fox-82 and lands as its own model change after A's census, so P keys on the consolidated delivery type. A and B design in parallel against this contract and integrate after agreement; no conflicting cross-route type lands first. The mtcollins1 finish path (fan rule, boot 7, host key, runner legs) proceeds on its existing route, which is row (a)."),
    p(text: "True unknowns, stated rather than assumed: the Supermicro H11SSL controller interface; the ASRock ALTRAD8UD (OpenBMC 3.22) media API beyond the PXE/HTTP settlement above; the post-StartMedia media status on MegaRAC 0.45 (a declared hypothesis until boot 7 reads it); the per-host trust-strategy policy (operator decision; both strategies are implementable now); which disks on each board are safe install targets (no default exists until an operator names one per host)."),
  ]
}

data physical_machine_boot_program_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly { ruling: project_documentation_projections_are_not_checkout_artifacts },
  slug: "physical-machine-boot-program",
  title: "Physical-machine boot program: one boot transaction, separated axes (identity, artifact, delivery, persistence, initialization, trust, role), and the cut order to retire per-machine roots",
  body: concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(opening(), axes()), transaction()), guests()), cuts()), decisions()), separated_axes()), persistence_axis()), cross_product()), adapter_obligations()), initialized_host_contract()), verification()), ownership()),
  retirement: PlanRetiresWhen {
    condition: unbound_dissolution(description: "Retire this plan when every physical machine boots through the one boot transaction AND is reconciled through the one physical-machine convergence entry (cuts 6 and 7 landed: OS provisioning, host-system and workload convergence), and no per-machine workflow mode or boot root remains (the mtcollins1, srv3 and host_reset_return roots deleted, and the mode renames landed)."),
  },
}
