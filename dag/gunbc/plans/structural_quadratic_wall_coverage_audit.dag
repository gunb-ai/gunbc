module gunbc.plans.structural_quadratic_wall_coverage_audit

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetirement, PlanRetiresWhen, PlanIsAuthorityOnly }
import std.markdown { MarkdownBlock }
import gunbc.plans.md_helpers { p }
import gunbc.design_ruling { project_documentation_projections_are_not_checkout_artifacts }

fn structural_quadratic_wall_coverage_audit_body() -> List<MarkdownBlock> {
  [
    p(text: "Goal: close decidable structural-quadratic coverage gaps by extending the existing cost authority, not by building another complexity oracle or cost-inference algebra. Distinguish structural cost from resource budgeting and classify each mechanism by both guarantee and executing reach."),
    p(text: "2. Execution receipt: at 6e881a11, ctrl-build -- cargo run --bin complexity_linearity_audit exited 0 over the corpus. Its match-fanout/wildcard findings were syntactic proxies, not asymptotic verdicts or floor enrollment. Re-run that producer after resolver fixes; its recorded counts do not describe the current tree."),
    p(text: "Structural owners in that audit: v2.lens.cost folds SymbolicCost and detects nested linear work as Poly(2), with UnknownCost failing to top. v2.lens.complexity refuses incomplete dominance through complexity_incomplete_assessment_stall. v2.lens.complexity_lowering owns strictly-lowering catalog soundness; intent_linearity had partial reach. synthesis_established_bound_patch_stall remains WallAfterGrounding, while synthesis_rice_residual_boundary is OutsideModeledGuarantee: neither an executed global optimum nor a permanently unknowable constructible patch."),
    p(text: "Termination owners: std.termination and the v1 DescentEvidence checker refuse unknown descent; #6209 consolidated the former cardinality fork. The recorded behavior_multiplicity(Loop) path was tag-only and measure-blind; Stage-2 must derive its verdict from loop_bound_edge through the existing lattice, with unknown evidence refusing. This is a wiring obligation, not a new termination algebra."),
    p(text: "Resource owners are distinct: std.realization_width memory_bounded_fit_count and spawn_width_cap bound co-resident memory, not asymptotic shape. extdeps.accounting.budget admission and product.budget_tree conservation differ in construction versus raw-literal checking. test_node_wall_clock_ratchet is bumpable; EffortBudget had no carrier. A memory cap does not prevent reintroducing quadratic resolver work."),
    p(text: "Remaining reach obligation: the cost engine was roster-bound while the emit-only audit reached the corpus. Whole-corpus asymptotic coverage requires decl_facts(roots) (#5966) and compile-graph access (#5364); do not extend the proxy as a substitute. Keep the existing cost engine and retire the audit only when the real gate covers the same population."),
    p(text: "Remaining shape obligation: after the measured build_type_env, func_env.sigs and intern-table-copy fixes land, exercise a discriminating reintroduction control against the repaired resolver route. Coordinate with those fixes; a new wall requires their measured pillar-path cost and the operator’s sequencing decision. Enrollment, execution and a red control determine coverage, not a mechanism’s name."),
  ]
}

data structural_quadratic_wall_coverage_audit_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly { ruling: project_documentation_projections_are_not_checkout_artifacts },
  slug: "structural-quadratic-wall-coverage-audit",
  title: "Structural-quadratic wall -- coverage audit and execution receipt",
  body: structural_quadratic_wall_coverage_audit_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "Dissolves when the whole-corpus asymptotic cost gate grounds (`decl_facts(roots)` #5966 + compile-graph gunbc#5364 land, flipping cost.dag from roster-bound to whole-corpus): at that point the region-(2) \"un-walled residue\" rows close, the emit-only `complexity_linearity_audit` bin is deleted, and this census is superseded by the live gate's own coverage report. Also re-run the section-2 receipt whenever a sibling lane lands a resolver-pathology quadratic fix, to confirm the reintroduction-fence candidate is still measured-live.")
  }
}
