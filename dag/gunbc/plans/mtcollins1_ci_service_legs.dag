module gunbc.plans.mtcollins1_ci_service_legs

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetiresWhen, PlanIsAuthorityOnly }
import gunbc.design_ruling { project_documentation_projections_are_not_checkout_artifacts }
import std.markdown { MarkdownBlock }
import gunbc.plans.md_helpers { p }

// THE DESIGN FOR THE LAST TWO LEGS OF mtcollins1 INTO CI SERVICE (session quiet-gull-101, node
// adhoc-2ae53679-074, 2026-10-27): F, the stateless service-slot lifecycle (dispatch, collect,
// deregister, lost-boot sweep), and G, the first qualification run. Each leg is mapped onto the
// authority that already owns it. Most of both legs exists as implemented authorities that still owe
// wiring, so this plan is mostly about wiring, not new vocabulary. Design only. Lane owner's ruling on the G route
// (merry-fox-82, msg_a8e095b1, 2026-10-27): option A, recorded in section 2.

fn opening() -> List<MarkdownBlock> {
  [
    p(text: "Goal: G qualifies one ephemeral attempt slot on mtcollins1, then F supplies stateless per-boot service slots. G uses runner_slot_desired shape and RamBackedTmpfs so memory.peak includes the build tree; its sealed receipt admits/refuses with the measured number. Only admission permits service-group reach from required CI. F derives committed width and boot-named slots, mints one JIT config per job/pass, collects/deregisters and sweeps lost-boot registrations; no registration survives boot."),
  ]
}

fn decisions() -> List<MarkdownBlock> {
  [
    p(text: "Ruled 2026-10-27 msg_a8e095b1: G uses qualification attempt route (option A). Preserve SubjectSlotNotAttemptScoped red for service slots; the attempt runs-on label binds the job to its registration. Reword service_slot_pass_binding_execution_frontier to F’s first post-G service pass with sealed JitRunnerDeregistered, not G."),
    p(text: "Both routes use dispatch_jit_mint/jit_mint_binding, never registration tokens. Only gunbai-ci App key is long-lived: G stages via WIF; F uses per-boot ServiceSlotAppKey/CustodyTmpfsNoSwap under mtcollins1_in_memory_app_credential_per_boot. Tokens/JIT config reach listener environment, not argv/logs; collected lines use non-Secret typed fields with a claim."),
    p(text: "New operations are fleet_converge modes under fleet_converge_modes_are_outside_the_job_roster. Qualification floor is workflow_dispatch only, never PR/merge_group. Reuse expected_revision, no duplicate qualification_revision input."),
    p(text: "Release baked into the image, its revision part of the image identity (merry-fox-82 2026-10-27: bake, decision A; build in the publish run as a local-source artifact, decision A; supersedes push-after-boot). The image carries a gunbc release tree (aarch64 binary plus corpus) at one pinned revision as a local-source NoCloudSeedArtifact (one type with a SeedArtifactSource coproduct, never a second artifact type), named from the revision, digest measured by the publish run. Revision and digest enter the build key and publish receipt, so a different digest is a new image, and a copied artifact whose measured digest disagrees refuses. The corpus never goes to a public-read origin. A release change is a re-image and reboot. At slot start the controller reads the baked revision back and refuses unless gunbc.fleet.fleet_revision_acceptance accepted it (RequiredCiSucceeded plus DefaultBranchRevisionObserved), the acceptance G's qualification_revision is pinned by."),
  ]
}

fn authorities() -> List<MarkdownBlock> {
  [
    p(text: "Every new effect site receives privileged_effect_census enrollment and an executed select_authorization_pattern choice. Existing rows cover mint/deregister/sweep/dispatch/ref pins; custody is host_credential_custody_converge_ci_wet. Slot shape MemoryMax/High/SwapMax=0/TasksMax/CPUWeight comes once from gunbc_runner_slot_desired via ephemeral_slot_properties, shared by G/F. committed width is derived; RAM-host DiskWidthUnconstrained still charges workspace to memory."),
    p(text: "Memory envelope bounds the actual unit and refuses OOM or swap. runner_unit_live_read verifies declared shape before floor execution; live drift refuses. All host effects use anchored_host_transport_of; derive host from Bound transport, refuse every other arm. lost_boot_observed_over plus lost_boot_current_from_capture mints the single CurrentBootEvidence consumed by both service population and sweep."),
  ]
}

fn leg_g() -> List<MarkdownBlock> {
  [
    p(text: "G1a: runner_qualification_floor_job owns attempt input/revision guard/job below readers to avoid a workflow-model import cycle. qualification_floor runs guard then compiler_gate_floor_steps_after_checkout on exactly the attempt label. Dispatch carries mode/host/expected_revision and refuses SubjectRequiredInputUnsupplied; no extra input beyond the existing GitHub-limit budget."),
    p(text: "G1b: qualification_attempt binds unit hold (qualification owner), WIF App key, installation token and anchored launch. Never infer listener status from SSH 255: systemd_run_transient_wait_read refuses FleetSsh ambiguity. Read the remote manager’s --wait Result through systemd_run_wait_summary using system-manager --pipe without --quiet, minting SystemdSummaryPrintingWait. Missing/bad summary→SlotListenerOutcomeUnobserved, never fabricated exit. Shared service/attempt listener builder varies only unit/user/root; attempt runs declared runner user with Delegate=yes, not root. Driver/F4 reuse one scanned-key anchored-transport composition."),
    p(text: "G2 order: unit hold→AttemptSlot host_unit_slot_for→JIT mint in qualification group→ephemeral listener over anchored transport, config stdin via posix_sh_export_from_stdin_then_exec_command/run_argv_stdin_over_host_effect_transport→ensure qualification ref pin→dispatch floor→collect run/instruments→on every exit deregister joined with RunnerTeardownRequest→remove pin. route_is_executable/witness must follow real bindings. Hermetic fn-bound pass controls exercise clean, failed and never-dispatched exits; deleting each call reds."),
    p(text: "G group (merry-fox-82, decision A, 2026-10-30): runner-qualification is a row of runner_group_restriction_ensure restricted_runner_groups, created once by MicrovmRunnerGroupEnsure under its per-create approval, restricted to fleet-converge.yml at the bare refs/heads/qualification/ prefix so it admits nothing until an attempt pins it. Its admission is the class AdmitsOneBranchUnder (exactly one selected workflow: the prefix or the prefix plus one ref component, extdeps.git git_ref_component_admitted), because each attempt re-pins it; a pin outside the prefix refuses (RunnerGroupSelectsOutsidePrefix). The create dispatch needs the operator's go."),
    p(text: "G3 reads current gunbc test memory-envelope receipt and job step timings, not withdrawn claim_executor [floor-phase]/[floor-cgroup] rows. Bounding attempt cgroup includes tmpfs. G4 seals collection, backing, envelope verdict, live-unit read and teardown. Peak above memory_high refuses with number; disk/narrower shape is a different subject, never silent limit raise. Before unit removal, observe per-attempt tree absent as well as registration absent: leftover tmpfs charges must not escape to parent."),
  ]
}

fn leg_f() -> List<MarkdownBlock> {
  [
    p(text: "F0 after G: enroll service_slot_runner_group_name/restricted_runner_groups with service_slot_selected_workflow and existing MicrovmRunnerGroupEnsure. Until created mint correctly refuses RunnerGroupAbsent. Group creation is the required-job exposure gate."),
    p(text: "F1 generic host start mode follows boot terminal/custody. Observe boot via anchored transport, derive current_service_population; the release is baked, so push nothing; start committed-width transient service_slot_unit_spelled units over the baked release locus with the accepted revision in the unit environment, (the publish run builds that release on its own aarch64 fleet slot at its admitted checkout: stage the release-locus tree in run scratch through the one tree install, gunbc.host.host_effect_realize approval_broker_tree_install_at, generalized by an install-privilege parameter, never a second tree writer or new sudo grant; pack with extdeps.tools.tar tar_create_reproducible_command, sorted, zero mtime, numeric owner 0, so a rebuild is byte-identical and the boot extracts it root-owned; measure sha256; copy to the export host beside the remaster work directory), with shared shape/controller ExecStart, service_slot_controller_execstop, and stop timeout covering deregistration+readback; read every unit back. This supplies controller/population production consumers."),
    p(text: "F2: durable job/run logs via read_job_log_with; one typed ServiceSlotPass journal line per pass fetched through anchored observe, pure byte classification in fleet_receipt_collector pattern. Boot loss before collection loses host evidence; never synthesize it."),
    p(text: "**F3. Deregister on shutdown.** The seed does not trap SIGTERM, so a stopped controller dies before its pass can deregister. The stop is therefore the unit's own ExecStop entry (gunbc.runner.runner_service_slot_controller service_slot_stop_main, rendered by service_slot_controller_execstop). It takes the same standing as the pass (service_slot_unit_standing: this unit, a managed host, admitted for the current boot's population, the App key held) and deregisters exactly this unit's registration with readback, under the slot's own binding. The subject is a sealed StoppingServiceRegistration that only that binding's derivation mints (runner_jit_mint_binding binding_stopping_subject), and the exit is SlotUnitStopping. The listener unit is PartOf= and After= the controller unit (runner_host_unit_slot ListenerPartOf), so a unit stop or the host's shutdown ends the listener first and the ExecStop runs after it, before systemd signals the controller. If the pass deregistered first, the readback finds the runner absent and the stop succeeds having deleted nothing. Consumed by F1, which starts each unit with this ExecStop and a TimeoutStopSec long enough for one deregistration with readback."),
    p(text: "**F4. The lost-boot sweep, read-only first.** Both arms admit the current boot over the one live anchored transport (gunbc.host.anchored_host_transport anchored_host_transport_live) through one shared admission. The read-only arm is a mode VALUE, service_runner_lost_boot_sweep_dry_run (gunbc.runner.runner_lost_boot_sweep_run lost_boot_sweep_dry_run_wet), not an input on the deleting mode, because fleet-converge already declares GitHub's limit of 25 workflow_dispatch inputs; it adds no job. It plans with sweep_plan against the real organization runner roster, writes the admitted boot and the selection to its receipt, and never reaches deregister_selection. The deleting arm refuses every dispatch before any read while lost_boot_sweep_apply_standing is SweepApplyGated; the go is a change to that row. The dry run's receipt is the recorded evidence that the #14738 pairing obligation and lost_boot_sweep_effect_pairing_frontier item 3 require."),
    p(text: "F5 after F0–F2: one real floor job on service slot produces sealed JitRunnerDeregistered, closing the reworded execution frontier."),
  ]
}

fn sequence() -> List<MarkdownBlock> {
  [
    p(text: "PR sequence: plan/frontier correction; G2 hermetic #15252; G1a job/mode; G1b driver/census; G3 instruments; F4 read-only; F1–F3 plus gated F0 roster. Wet steps each require merry-fox-82 go after boot supplies network/sshd with custody host key: anchored scan, F4 dry run, G, F0 group creation, F5."),
    p(text: "Open: verify GitHub selected-workflow matching before F0—refs/heads/main restriction may reject PR merge-ref jobs. Observe whether 22GiB supports floor plus tmpfs build tree; otherwise declared width five is not reachable without a new subject. runner_host_first_boot_receipt’s missing network/sshd is boot-lane prerequisite, not a service-leg workaround."),
  ]
}

data mtcollins1_ci_service_legs_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly { ruling: project_documentation_projections_are_not_checkout_artifacts },
  slug: "mtcollins1-ci-service-legs",
  title: "mtcollins1 into CI service, legs F and G: qualify one attempt slot under the tmpfs-inclusive envelope, then run stateless per-boot service slots with JIT registration, collection, deregistration and a gated lost-boot sweep",
  body: concat(concat(concat(concat(concat(opening(), decisions()), authorities()), leg_g()), leg_f()), sequence()),
  retirement: PlanRetiresWhen {
    condition: unbound_dissolution(description: "Retire when G's sealed qualification receipt for mtcollins1 is recorded (admitted or refused with its number), the lost-boot sweep's read-only run has recorded minted CurrentBootEvidence through the real dispatch, and, if G admitted the shape, one live service pass has recorded the sealed JitRunnerDeregistered receipt."),
  },
}
