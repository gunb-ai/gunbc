module gunbc.plans.v2_corpus_self_host

import std.decl_ref { DeclarationRef, decl_ref }
import std.dissolution { unbound_dissolution }
import std.markdown { MarkdownBlock }
import gunbc.plan { Plan, PlanRetiresWhen, PlanIsAuthorityOnly }
import gunbc.plans.md_helpers { p, quote }
import gunbc.design_ruling { project_documentation_projections_are_not_checkout_artifacts }

// WHY THIS PLAN CITES RATHER THAN RESTATES. Every binding below is a DeclarationRef, so the
// ingestion-time citation wall in v1_compiler.declaration_index resolves it on every required
// run. A section of this plan that goes stale because the mechanism it names was renamed or
// deleted therefore REFUSES, rather than sitting here reading as current. That is the whole
// reason the plan is a .dag module and not a hand-authored .md: the markdown is generated from
// these blocks, and the claims that matter are joined to symbols a machine checks.

fn status_block() -> MarkdownBlock {
  quote(blocks: [p(text: "**Status:** active anchor from the 2026-08-26 operator ruling. Current milestone standing is derived by compiler_frontend_program_status.report; the audit history below is not a live status board. Typed bindings remain the citation authority.")])
}

fn section_1() -> List<MarkdownBlock> {
  [
    p(text: "**Goal:** v2 emits the entire v2 corpus to Rust that cargo builds, then the emitted modules execute their own contracts before seed retirement. Seed size is motivation, not an acceptance count. The [baa4a8586f sizing audit and original plan](https://github.com/gunb-ai/gunbc/blob/06d3c1c3149a7420c4a548b9aba9b15c721c635d/dag/gunbc/plans/v2_corpus_self_host.dag) record the hand/emitted split and a reproducibility discrepancy. That partition still needs a producer rather than a prose procedure; do not copy its totals into a current board."),
  ]
}

fn section_2() -> List<MarkdownBlock> {
  [
    p(text: "**Boundary:** emission is not rustc success. The audited required_v2_emission_dissolution explicitly stopped before cargo and classified Completed/Refused/NotExecuted only for emission. Re-read ci_layer_roots for current enrollment. A green emission check alone cannot establish self-hosting."),
  ]
}

fn section_3() -> List<MarkdownBlock> {
  [
    p(text: "**Host admission:** whole_corpus_compile_demand_for_root joins repository, primary root and ordered dependency pools to a measured root-specific demand; unknown roots refuse with their recipe. Use whole_corpus_compile_public_root_demand, not the old floor-proxy estimate that admitted killed runs. The historical unthrottled srv1 measurements completed/refused diagnostics with binaries built from the measured SHA; CI was admitted, srv2 unmeasured and the then-tested remote runner too small. Those are dated receipts, not present capacity. Whole-corpus execution in a shared session is forbidden; use a currently admitted external runner and record uncensored peak/exit status."),
  ]
}

fn section_4() -> List<MarkdownBlock> {
  [
    p(text: "**Instrument:** emission_entry_instrument.measure_entry_emission emits, assembles and runs cargo JSON diagnostics, carrying code/module/site identity, location and typed unreached-stage status. Per-entry closure results are not the whole corpus, and their union is not a corpus proof. Build and run the actual binary in ONE dispatch; checkout location or installed --version does not prove vintage. The original discriminating feature probe was //-annotation parsing. Never interpret SIGKILL/empty diagnostics as zero. Record commit, instrument, actual binary provenance and exit status. The 2026-08-24 bankruptcy removed the old board; rederive before quoting a current population."),
  ]
}

fn section_5() -> List<MarkdownBlock> {
  [
    p(text: "**Ratchet:** emit_subject_clean_frontier/emit_subject_clean_ratchet admit roster members by identity and roster digest, never a measured count threshold that rewards dropped subjects. Emptiness still distinguishes no roster from an evaluated failure-free roster. Baseline debt rows refuse when fixed; planted-control rows refuse when they stop discriminating. Enrollment was NoConsumer at the audit despite operator approval on 2026-08-26; current standing comes from compiler_frontend_program_status.report, not this text."),
  ]
}

fn section_6() -> List<MarkdownBlock> {
  [
    p(text: "**Program:** S1 verify ratchet correctness fixes from their executing receipts, never stale PR-state prose. S2 rederive whole-corpus identity-grain diagnostics on an admitted runner. S3 enroll actual cargo execution with broken-emission RED, subject to current required-roster authority. S4 enroll the ratchet on S2’s identified population: repaired baseline rows and newly added blockers both refuse. S5 fix causes by root, using fresh distribution. S6 retires the seed only after Rust compilation AND emitted-contract execution. Mutation-test S3/S4 controls themselves; #9348 found permanently green controls despite a green suite and review. Cross-program prerequisites remain solely compiler_frontend_program_interlock.milestone_prerequisites."),
  ]
}

fn section_7() -> List<MarkdownBlock> {
  [
    p(text: "**Superseded evidence:** the operator deleted the 2026-08-16 root-partition plan on 2026-08-26 after its probe links/data/producer disappeared. Inherit only the emission-versus-cargo distinction; its claimed cross-module concentration must be reestablished, not assumed."),
  ]
}

fn section_8() -> List<MarkdownBlock> {
  [
    p(text: "**Sequencing hypothesis:** old error magnitudes and dominant-code shares are historical. Recompute the code partition with measure_entry_emission over the identified ratchet roster before ordering any wave. Emitter changes can invert concentration; a different distribution is new evidence, not a reason to retain the old schedule."),
  ]
}

fn section_9() -> List<MarkdownBlock> {
  [
    p(text: "**Done bar:** rustc zero is necessary but insufficient. The audit also lacked main.rs generation and executed behavioral receipts. DESIGN §7 requires each emitted module to hold its own .dag contract on a discriminating corpus; the seed is a regression oracle, not specification, byte fixed-point or behavior that v2 must blindly reproduce. A clean build permits planning S6, not executing retirement. The DeclarationRef bindings below preserve checked joins to the measurement, admission, discovery, ratchet, interlock and status authorities."),
  ]
}

// THE BINDING THE OPERATOR ASKED FOR: this plan is joined to the CI ratchet by symbol, not by
// prose. Each row resolves through the ingestion-time citation wall on every required run, so a
// rename or deletion of the mechanism REFUSES here instead of leaving a stale plan section that
// still reads as current.
// WHAT THE ROWS BELOW BIND, IN ORDER, since section 4c admits annotations only at
// module-item grain and this list cannot carry them inline:
//   emit_subject_clean_frontier + emit_subject_clean_ratchet -- the ratchet the plan
//     enrols at S4: the identity-grain frontier and its runner.
//   dag_compile_clean_shard_roster compile_clean_shard_entry_discovery -- the discoverer
//     the runner takes its universe from, which hands back the roots it scanned so the
//     policy recorded in the universe is derived rather than asserted beside it.
//   emission_entry_instrument -- the measurement S2 and S3 run.
//   whole_corpus_compile_admission -- the hosting decision in section 3.
//   compiler_frontend_program_interlock -- the cross-program precedence relation
//     (operator ruling 2026-08-26), carried ONCE in its own carrier and cited here;
//     this plan does not restate the ruling.
//   ci_layer_roots -- the gap section 2 names: the phase that emits and stops
//     before cargo.
//   compiler_frontend_program_status -- where each milestone's standing is DERIVED from a
//     population the corpus carries, or returned as NotDerivable naming the missing
//     instrument. No milestone in this plan is ticked anywhere; `report` is the runnable
//     answer to "where are we".
data v2_corpus_self_host_ratchet_bindings: List<DeclarationRef> = [
  decl_ref(module_path: "gunbc.emit_subject_clean_frontier", decl_name: "RatchetUniverse"),
  decl_ref(module_path: "gunbc.emit_subject_clean_frontier", decl_name: "roster_identity_derived"),
  decl_ref(module_path: "gunbc.instruments.emit_subject_clean_ratchet", decl_name: "emit_ratchet_roster"),
  decl_ref(module_path: "gunbc.instruments.dag_compile_clean_shard_roster", decl_name: "compile_clean_shard_entry_discovery"),
  decl_ref(module_path: "gunbc.instruments.emission_entry_instrument", decl_name: "measure_entry_emission"),
  decl_ref(module_path: "gunbc.whole_corpus_compile_admission", decl_name: "whole_corpus_compile_admission_at_budget"),
  decl_ref(module_path: "gunbc.compiler_frontend_program_interlock", decl_name: "milestone_prerequisites"),
  decl_ref(module_path: "gunbc.compiler_frontend_program_interlock", decl_name: "ProgramMilestone"),
  decl_ref(module_path: "gunbc.compiler_frontend_program_status", decl_name: "milestone_status"),
  decl_ref(module_path: "gunbc.compiler_frontend_program_status", decl_name: "report"),
  decl_ref(module_path: "gunbc.ci.ci_layer_roots", decl_name: "required_v2_emission_entries"),
  decl_ref(module_path: "gunbc.ci.ci_layer_roots", decl_name: "required_v2_emission_dissolution"),
]

fn v2_corpus_self_host_body() -> List<MarkdownBlock> {
  concat([status_block()],
  concat(section_1(),
  concat(section_2(),
  concat(section_3(),
  concat(section_4(),
  concat(section_5(),
  concat(section_6(),
  concat(section_7(),
  concat(section_8(), section_9())))))))))
}

data v2_corpus_self_host_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly { ruling: project_documentation_projections_are_not_checkout_artifacts },
  slug: "v2-corpus-self-host",
  title: "Plan — v2 self-hosts the entire v2 corpus",
  body: v2_corpus_self_host_body(),
  retirement: PlanRetiresWhen {
    condition: unbound_dissolution(description: "Delete this plan when the whole v2 corpus emits Rust that cargo builds with zero blocking diagnostics, a required CI phase enforces that by execution with a discriminating red, and every rostered emitted module holds its own contract (gunbc.compiler_frontend_program_interlock SelfHostEmittedContractsHeld) — at which point S6 retires the hand-written seed and the plan's subject no longer exists.")
  },
}
