module gunbc.plans.srv1_deploy_principal_split

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetirement, PlanRetiresWhen, PlanIsAuthorityOnly }
import std.markdown { MarkdownBlock, TableBlock, AlignNone }
import gunbc.plans.md_helpers { h2, p, li, ul, ol, cell, row }
import gunbc.design_ruling { project_documentation_projections_are_not_checkout_artifacts }

fn srv1_deploy_principal_split_body() -> List<MarkdownBlock> {
  [
    p(text: "Status: design, no actuation. Work item `adhoc-9fb32e42-f20`. Authored 2026-10-19. Nothing here changes a rendered sudoers body, a workflow or a host."),
    h2(text: "0. Finding, and what the corpus already owns"),
    p(text: "`ghrunner` runs every srv1 CI job, same-repository `pull_request` jobs included. Through `/etc/sudoers.d/gunbc-deploy` it holds whole-binary NOPASSWD grants over `systemctl`, `install`, `apt-get` and `visudo` (RunAsUsers ALL), plus the rest of `gunbc.fleet.fleet_posix_accounts` `ci_runner_sudo_binaries`. Each is root-equivalent, so PR code is root on srv1."),
    p(text: "The corpus already owns the *class and the standing loss*, so this plan does not file a second one:"),
    ul(items: [
      li(text: "class: `gunbc.recurring_failure_mode.the_grant_a_frontier_refuses_is_already_held_from_another_authority`"),
      li(text: "drop: `gunbc.rung_drop.the_job_user_holds_a_path_unrestricted_root_grant` (2026-09-21, structurally guaranteed -> mitigatable). Its restoration trigger already demands both \"no path-only root grant for the job user\" and \"the installs run under the administrator edge\". That is this plan's target."),
    ]),
    p(text: "What the corpus lacked is the plan, the consumer census and the migration, which this document supplies. The drop explicitly defers \"closing the grants\" to an operator-gated item needing a consumer census; this is that census. No ruling decides which principal deploys; section 5 states it as an open decision."),
    h2(text: "1. Census (question 1)"),
    p(text: "Read from `gunbc.ci.ci_deploy_access` (`srv1_live_deploy_privileged_commands` = `grounded_principal_privileged_commands(fleet_posix_ci_runner_principal())`), `gunbc.live_deploy.apply` / `operations` / `emit`, and `gunbc.auth.privileged_effect_census`. Stage 0 executed `select_authorization_pattern` over the four effects the deploy needs and recorded them as `gunbc.auth.privileged_effect_census` rows (sites `deploy_stage_install_command`, `deploy_stage_visudo_check_command`, `deploy_access_apt_get_privileged_command`, `systemctl_restart_command`); `test.claim.authorization_pattern_selection_witness` asserts each result. Rows 5 to 7 are not census rows: slot reconciliation is covered by the `systemctl` row, the host-wide executor grants are already rostered argv-pinned grants, and the last row names binaries with no deploy consumer. Execution did not contradict the by-inspection reading of any cell; the one change is that the host-root arm now exists, so the selection names the administrator edge instead of refusing."),
    TableBlock {
      header: row(cells: [cell(text: "Effect through ghrunner sudo"), cell(text: "Whole-binary grant used"), cell(text: "Selection's reading")]),
      alignments: [AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "Install units / files under `/etc`, `/usr/local` (`live_deploy` preamble, `dashboard_deploy`, `approval_broker_dark_install`)"), cell(text: "`install`"), cell(text: "Executed: `MintsHostRootReach` (new arm), selection returns `PatternSelected AdministratorEdge` (new candidate, offered only for that reach). Federated fails the witness and identity gates, approval fails the unattended gate, operator session fails both. The row diverges with reason `interim_job_user_whole_binary_grants`.")]),
        row(cells: [cell(text: "`systemctl` daemon-reload / enable / restart / start / stop"), cell(text: "`systemctl`"), cell(text: "Executed as a per-unit effect (`MintsResourceScopedCredential`, bindable host principal): selection returns `FederatedScopedGrant`, the retirement-mask precedent. Diverges with the same reason because the held grant is whole-binary. `systemctl edit` and `link` are not argv-pinnable as whole binary.")]),
        row(cells: [cell(text: "Sudoers self-install (`visudo -cf`, `install` into `/etc/sudoers.d`)"), cell(text: "`visudo`, `install`"), cell(text: "Executed: host-root reach, selection returns `AdministratorEdge`. The selection still does not see the circularity that a grantee cannot install its own grant (header of `gunbc.fleet.fleet_bootstrap_principal`); that is why the edge, not the job user, is the only pattern that can perform it.")]),
        row(cells: [cell(text: "Package installs (`apt-get`)"), cell(text: "`apt-get`"), cell(text: "Executed: host-root reach, selection returns `AdministratorEdge`. Not argv-pinnable without enumerating packages, which is a model row to write, not a call-site choice.")]),
        row(cells: [cell(text: "Runner slot reconciliation (`actions-runner@*` units, `gunbc.runner.runner_slot_desired`)"), cell(text: "`systemctl`"), cell(text: "Per-unit, argv-pinnable; admissible for the job user only for *its own* slot units if at all. Reconciling slots is deploy authority, not job authority.")]),
        row(cells: [cell(text: "Host-wide executor grants (`gunbc.runner.runner_host_grants` -> `gunbc-ghrunner`)"), cell(text: "`install`, `visudo`"), cell(text: "Already argv-pinned and sound; but *installing* it is the self-install circularity above.")]),
        row(cells: [cell(text: "`tailscale`, `rm`, `useradd`, `usermod`, `cp`, `mv`"), cell(text: "whole binary"), cell(text: "No current deploy consumer found in the read set (section 3 lists the consumers that remain to verify). Presumed removable; verify per binary.")]),
      ],
    },
    p(text: "Where selection refused or is silent: (a) it had **no vocabulary for host-root reach** (closed by stage 0: `MintsHostRootReach` and `AdministratorEdge`; the same effect filed at `MintsAccountWideCredential` still returns `NoAdmissiblePattern`, which is the witnessed RED); (b) it is silent on the sudoers self-install circularity; (c) it does not see that the same uid is shared between PR jobs and dispatched deploy runs, which no pattern can fix because the pattern is chosen per effect, not per co-tenant; stage 0 states it as a route requirement instead (`gunbc.ci.deploy_route_requirement` `srv1_deploy_route_requirement`, a declared frontier whose gate `deploy_route_switch_admitted` reads false for the observed shared tenancy). D2 (srv3/srv4 grants) remains open and needs the operator's key."),
    h2(text: "2. The split (question 2)"),
    p(text: "The model already contains the split; it is not applied to srv1's `ghrunner` deploy route."),
    ul(items: [
      li(text: "`fleet-converge.yml` is `workflow_dispatch` only. Its main-pinned OIDC pins (`gunbc.auth.oidc_claim_pins`, `fleet_converge_workflow_claim_pins`) gate the fleet SSH key, i.e. the administrator principal `ubuntu` (`executor_bootstrap_principal`). Dev pins are \"refused by the privileged list\" for root-host mutation; branch runs reach only run-scoped approved grants (`branch_run_grant`)."),
      li(text: "A PR job holds none of those: the key is materialized in-run for the main-pinned dispatch only."),
    ]),
    p(text: "Recommended allocation (typed open decision D1, section 5):"),
    ol(items: [
      li(text: "**Deploy authority = the administrator principal over the fleet SSH edge**, as `runner_host_file_converge` already uses. Root-evaluated installs (`install`, `visudo`, `apt-get`, unit install) run as `ubuntu` over SSH from a main-pinned dispatch. The deploy fold stops sudoing as `ghrunner`."),
      li(text: "**One-off, off-main or irreversible effects** go through `gunbc.auth.access_request` / `approval_capability` / `approval_broker` redemption, as the corpus already rules for run-scoped branch grants."),
      li(text: "**No dedicated deploy service account**: it would be a second administrator principal beside `executor_bootstrap_principal`, a nickname for an existing authority (DESIGN §3), and would have to be installed by that same principal anyway. Revisit only if the SSH edge cannot reach a needed host (srv3/srv4 are unverified)."),
      li(text: "**What `ghrunner` keeps**: only argv-pinned lines the selection admits for the job's own work: the #14390 mask grants, the fabric-cell set-property lines, `gunbc-ghrunner` (`runner_host_grants`). Nothing path-only."),
    ]),
    p(text: "**Condition for the split to work, not a side residual (D3).** The administrator key reaches a deploy run as an in-run ssh-agent owned by the job user: `gunbc.ci.ci_spec` materializes it with `eval \"$(ssh-agent -s)\"` + `ssh-add`, exports the agent socket to GITHUB_ENV, and the fleet prelude DISARMS its exit trap so the agent survives into later steps (the key file and bearer token are removed at once; the agent is killed by the always() cleanup step). An observed run (srv1, run 39218985071, runner_host_file_converge) logged `agent_socket=/tmp/ssh-.../agent.NNN` and a mux dir under `/opt/actions-runner/srv1-01/_work/_temp/fleet-ssh-mux`. ssh-agent sockets are mode 0600 in a 0700 dir, which protects against other uids and not against the same uid. The modeled runner unit (`gunbc.runner.runner_unit_file`, service section: `ServiceType`, `ServiceUser deploy.runner_user`, `WorkingDirectory`, `Environment`, the jit wrapper `ExecStart`, restart and teardown directives) carries NO `PrivateTmp`, `ProtectSystem`, `PrivateUsers`, `InaccessiblePaths` or `JoinsNamespaceOf`, and every `actions-runner@srv1-NN` instance is `User=` the same ghrunner. HOST-OBSERVED (read-only, bright-moth-475, srv1, 2026-10-19; `systemctl show -p PrivateTmp,ProtectSystem,PrivateUsers,InaccessiblePaths,JoinsNamespaceOf,User` on actions-runner@srv1-01 and actions-runner@srv1-02): for both units User=root, PrivateTmp=no, ProtectSystem=no, PrivateUsers=no, InaccessiblePaths= empty, JoinsNamespaceOf= empty. The unit starts as root and the job runs as ghrunner (CTRL_RUNNER_JOB_USER), so the slots share /tmp. So a concurrent job in another slot shares `/tmp` and can read the other slot's `_work/_temp`, can connect to the agent socket, and for the window the agent lives can authenticate over the administrator edge: that is root on srv1. If that holds, removing the sudo grants does NOT remove root reach from PR code while co-tenancy holds; D1-A would move the credential from a standing sudo grant to a window-scoped agent. The namespace properties are observed on the host as above; what remains unobserved is the agent socket's reachability from a second slot's job in a live run, which the shared /tmp and shared uid imply but no one has exercised."),
    h2(text: "3. Migration (question 3)"),
    p(text: "DESIGN §3 default is delete-first, but `gunbc-deploy` is the *only* route by which a deploy installs anything today. Deleting it first leaves no deploy route, and the sudoers drop-in cannot be reinstalled by the principal being narrowed. This boundary is **gap-intolerant**: staged form."),
    p(text: "Consumers of `fleet_posix_ci_runner_sudo_grants` (by name; the root is outside the required gate, so the compiled-population argument does not cover it):"),
    ul(items: [
      li(text: "`gunbc.fleet.fleet_posix_accounts`: `fleet_posix_ci_runner_principal` and two `PrincipalGrounded`/intent rows."),
      li(text: "`gunbc.ci.ci_deploy_sudoers`: allow-list lint and the drop-in render (`deploy_sudoers_dropin_lines_for`, `deploy_sudoers_install_shell`)."),
      li(text: "`gunbc.ci.ci_deploy_access`: `deploy_access_roster`, `srv1_live_deploy_privileged_commands`, `deploy_access_sudoers_install_scope`."),
      li(text: "Text consumers: `gunbc.live_deploy.emit` (two comment sites), `extdeps.github.actions_runner` (comment)."),
      li(text: "Witnesses: `test.claim.grounded_principal_witness`, `test.claim.fleet.fleet_converge_privilege_hold_witness`, `test.claim.fleet.fleet_converge_plan_witness`, `test.claim.ci.deploy_sudoers_host_union_witness`, `test.claim.deploy_access_privilege_witness`."),
      li(text: "Other `DeployAccess` users that would stop resolving: `gunbc.srv3.srv3_host_effect_apply`, `gunbc.srv3.srv3_seeded_install_media`, and the `test.claim.live_deploy.*` witnesses that bind `ci_deploy_srv1_access`."),
    ]),
    p(text: "Deploys that break if the grants go first: every `live_deploy` apply, `dashboard_deploy`, `approval_broker_dark_install`, runner slot reconcile, and the srv3 host effects. All reinstall through `ghrunner` sudo today. `deploy_access_check` refuses `principal mismatch` for any other actor, so there is no alternate door either."),
    p(text: "Stages (each its own PR, none in this one):"),
    ol(items: [
      li(text: "**Model the gap first**: execute `select_authorization_pattern` for each row of section 1 and add the census rows; add a host-root reach arm so the selection can name the administrator edge instead of refusing silently."),
      li(text: "**Y in shadow**: a `DeployAccess` whose principal is `executor_bootstrap_principal` over the SSH edge, with the deploy fold able to run through it on main-pinned dispatch. The old route stays authoritative; Y runs read-only/idempotent applies and its readback is compared."),
      li(text: "**One transition**: switch the root (`apply_dispatch` routes to Y), install the narrowed argv-only drop-in via the administrator edge, and delete the whole-binary rows from `ci_runner_sudo_binaries` in the same change. Y never falls back to the old route. Because the drop-in is installed by the admin edge, the narrowing cannot strand itself."),
      li(text: "**Verify on host by the independent readback** (the `sudo -ll` probe the finding used) per host, and amend the drop population (srv1, srv2 known; srv3/srv4 unverified) as each is read."),
    ]),
    p(text: "No window without a deploy route: Y is proven in shadow before the single switch, and the switch and the deletion are one change."),
    h2(text: "4. Ladder (question 4)"),
    p(text: "No new row. The instance joins the existing class and drop:"),
    ul(items: [
      li(text: "Instance added to `the_grant_a_frontier_refuses_is_already_held_from_another_authority`: 2026-10-19, read only on srv1, `sudo -n -ll -u root /usr/bin/systemctl mask --now actions-runner@srv1-03.service` matched the `gunbc-deploy` entry; it fits because two authorities render for one principal at opposite grains, and this specimen shows the consequence is PR-code root rather than a stale wall."),
      li(text: "Drop population updated with the same read. Rung stays mitigatable. Ceiling stays structural impossibility (decidable: a rendered sudoers body either carries argv or it does not). Next-rung trigger is the drop's existing capability trigger; this plan names the path to it (section 3) and the one step that can climb now but is unbuilt (stage 0 + stage 1)."),
    ]),
    h2(text: "5. Open decisions (operator)"),
    ul(items: [
      li(text: "**D1 which principal deploys.** Options: (A) administrator edge `ubuntu` over SSH from main-pinned dispatch; (B) approval-broker redemption per deploy; (C) dedicated deploy account. **Recommend A**: already modeled, already gated by the main-pinned federation, no second administrator authority. B suits one-offs, not a routine deploy that would otherwise need a phone tap per run. C rejected above."),
      li(text: "**D1 decided 2026-10-25, neither A nor per-run B as stated: the convergence is approved once.** Operator ruling `gunbc.design_ruling` `the_initial_convergence_is_the_only_approval`: the operator approves the srv1 root-mutation job's convergence through the broker route, one tap per dispatch, and each host-root write it entails runs inside the attempt that claimed that approval (`ApprovedConvergenceGrant`). The census rows of section 1 select that pattern, not the administrator edge, and their lineage root is `gunbc.fleet.srv1_root_mutation_approval_run` `srv1_root_mutation_after_gate`: the job files one access request and proceeds only on the operator's device-redeemed approval (ruling `gunbc.design_ruling` `srv1_root_mutation_approval_is_filed_by_the_job`, 2026-10-26). Wherever this plan names the edge as the deploy authority (section 2 item 1, stage 2, D5), read the inherited approval that step admits; the job user loses its whole-binary grants either way."),
      li(text: "**D2 srv3/srv4.** Verified only for srv1 and srv2. Recommend reading each (needs operator key) before stage 2."),
      li(text: "**D3 same-uid co-tenancy; the split is only as strong as this.** Options: (a) accept as a declared residual, stating the window-scoped administrator-credential exposure above (weakest; it leaves PR code root-reachable during every deploy); (b) main-pinned fleet-converge dispatches run on a runner label that never takes PR jobs, under a different uid, so the agent socket is not same-uid reachable (closes the exposure without new isolation machinery; costs a runner slot class and a label in the CiRunnerTarget model); (c) the per-job microvm migration (closes it structurally, but its trigger is far). **Recommend (b) as the precondition for stage 2, with (a) allowed only for the interval before it lands and declared as a rung drop with that trigger; (c) is the terminal state.** The host read shows no per-unit namespace isolating `/tmp`, so D3 does not narrow to a shared-filesystem residual."),
    ]),
    h2(text: "6. D3 precondition: the deploy slot (operator adopted D3 option b, 2026-10-19)"),
    p(text: "Model: `gunbc.ci.deploy_slot_tenancy`. Design and model only; no workflow, unit, sudoers or host changes. Witness: `test.claim.runner.runner_group_restriction_ensure_witness` `witness_deploy_slot_admits_the_route_switch_only_when_group_and_uid_both_hold`."),
    ol(items: [
      li(text: "**How a job reaches a runner today.** Selection is set membership over labels (`gunbc.runner.runner_registration_labels`, `runner_labels_satisfy_selector`); `gunbc.runner.runner_slot_desired` gives every srv1 CI slot the one label `gunbc-heavy`, and `gunbc.fleet.fleet_converge_workflow` `fleet_converge_host_runner_expression` selects `self-hosted,linux,arm64,<host>`. Any workflow, a pull request's included, may name any label, so a label alone refuses nothing. What refuses a pull request workflow is a runner group restricted to one workflow: `gunbc.runner.runner_group_restriction_ensure` now rosters `deploy_slot_runner_group_subject` (group and label `gunbc-deploy`, selected workflow `gunb-ai/gunbc/.github/workflows/fleet-converge.yml@refs/heads/main`), created only when absent and read back through the sealed `observe_runner_group_restriction`. Selecting the label in the fleet-converge `runs-on` is part of the stage-2 transition, not this PR."),
      li(text: "**The group alone does not settle D3.** It controls what is scheduled onto the deploy slot, not whether a same-uid job in another slot reaches this slot's ssh-agent socket or the `_work/_temp/fleet-ssh-mux` socket (slot units run as root, PrivateTmp=no, ProtectSystem=no, one job uid `ghrunner`). So a distinct job uid is required: `deploy_slot_job_user` = `ghdeploy`, used by no other slot. `deploy_slot_observed_tenancy` answers `SoleTenantOfJobUid` only when the group read back is restricted to that workflow AND no other slot's uid equals the deploy slot's; anything the observer refuses, or a shared uid, reads as shared."),
      li(text: "**Account and rendering (not yet modeled).** `RunnerHostDeploy.job_user` is host-level and the depriv drop-ins are template-level (`actions-runner@.service.d`), so a per-slot job user and the slot's registration into the group are a gap in `gunbc.runner.runner_unit_file` / `runner_host_unit_slot` (`ServiceSlot` over a `ControlledHost` is the vehicle). `ghdeploy` holds only the narrow per-unit grants the selection admits, no whole-binary grant, no membership of `briansrls` or any group in `fleet_root_equivalent_group_names`. Adding that rendering is the first stage-2 shadow step; it is declared below, not built here."),
      li(text: "**Slot and memory.** Each srv1 CI slot is 22 GiB (`gunbc_runner_slot_desired` memory_high; width from `gunbc_runner_committed_width`, not re-derived here). srv1's envelope is already spent: fabric cells 13/14 are funded by the user-work pool cut (`gunbc.live_deploy.user_work_pool_slots`). A new slot therefore either takes an existing CI slot (srv1-01/02, `runner_width_transition`) or adds width the envelope must be shown to carry. See D4."),
      li(text: "**What flips the gate.** `deploy_route_switch_admitted(srv1_deploy_route_requirement, observed)` reads `observed`. Today it is `srv1_observed_job_tenancy` (shared), and `deploy_slot_observed_tenancy(srv1_modeled_deploy_slot_reading())` agrees (red). The gate turns true only from a `DeploySlotReading` whose group is read back restricted and whose uid is unshared; the witness shows green for that reading and red for each wall missing alone, a non-restricted group, and a group restricted to another workflow. The host readback that produces a real reading (group list, slot unit uid) is the declared frontier on `srv1_observed_job_tenancy`; it remains open and the stage-2 switch stays blocked until it lands."),
    ]),
    p(text: "Open decisions added: **D4 which slot funds the deploy slot.** Options: (A) repurpose srv1-02 (no envelope growth; one CI slot of width lost); (B) add a slot charged against the envelope (needs the width instrument to show headroom). **Recommend A**, since the envelope is already fully allocated and a deploy slot idles between dispatches. **D5 `ghdeploy` grants.** Recommend exactly the per-unit mask and set-property lines (`#14390`, fabric cell) and nothing path-unrestricted; host-root effects go through the administrator edge (D1 A). Both need the operator."),
    p(text: "**D4 resolved by measurement: falls back to A (repurpose srv1-02).** Operator ruling 2026-10-19: D4 = B if headroom is measured, else A. Instrument: `gunbc.runner.runner_slot_allocation` `gunbc_runner_committed_width` over `host_width_facts`; it reads the usable-RAM term (MemTotal, `gunbc.host.host_memory_observation`), fixed overhead, the session reservation, the fabric control-plane claim, the served deployment claim and the oomd floor, subtracts the authored microVM slots' charge (srv1-13/14, each memory_max plus the controller slice), and fits whole 22 GiB slots into the rest. Only the usable-RAM term is an observation; every other term is an authored reservation, and MemAvailable, swap and the active-unit count do not enter. Read-only dispatch `host_memory_observe` on srv1 at `0316e96614` (run 39268283480, 2026-10-19T14:32Z) returned MemTotal 539269779456 B against the modeled 539281129472 B, a difference of 11350016 B (about 10.8 MiB). Evaluating the instrument with that MemTotal substituted gives width 4 (2 authored + 2 CI); the envelope is 145 GiB and under 146 GiB. Width 5 (deploy slot as a fifth) is refused: the same instrument with the usable-RAM term raised by 1..18 GiB still gives 4, and 20 GiB gives 5, so the shortfall is between 18 and 20 GiB. Because MemTotal is a physical fact, raising it is not available; the headroom must come from an authored reservation (the served deployment or control-plane claim), which is a different operator decision. A follows: the deploy slot takes one of the two CI slots, leaving width 4."),
    h2(text: "7. Stage 1 model: the deploy slot as a role (D4 = A, D5 adopted)"),
    p(text: "Model only; host steps are the operator's and listed in the PR. Witness: `test.claim.runner.runner_slot_job_role_witness`."),
    ol(items: [
      li(text: "**Role.** `gunbc.runner.runner_slot_job_role` `RunnerSlotJobRole` (`CiJobSlot` | `DeployJobSlot`) is orthogonal to `RunnerSlotPurpose`: a deploy slot is a GitHub Actions runner with the same lifecycle, so only the account and the label set differ. `runner_slot_job_user` selects the user with no default arm; srv1-02 is the one deploy slot (`srv1_deploy_slot`)."),
      li(text: "**Rendering.** The CI population renders exactly as before (template drop-in). The deploy slot gets an INSTANCE drop-in `20-slot-role.conf` (`runner_unit_file` `runner_unit_slot_role_dropin_text`) replacing `CTRL_RUNNER_JOB_USER`, `LABELS_JSON` and clearing `DOCKER_HOST`, so it cannot inherit the CI user's rootless docker socket. Delivered and byte-read-back by `runner_host_file_converge` `runner_host_slot_role_files`. Labels: `runner_slot_registration_labels` gives the deploy slot the `gunbc-deploy` label and not `gunbc-heavy`."),
      li(text: "**Account and grants (D5).** `FleetAccountDeployJob` has no binary grants; its per-unit authority (retirement mask lines and fabric-cell set-property lines) is `runner_host_grants` `deploy_slot_privileged_operations`, rendered as a second grantee block in the existing runner sudoers. The whole-binary `gunbc-deploy` grants are untouched: their removal is the stage-2 transition."),
      li(text: "**Width.** The deploy slot is one of the four committed srv1 members (CI 1, deploy 1, fabric 2), so the committed width is unchanged and the instrument still admits it; CI width falls from two to one."),
      li(text: "**Routing follows the root.** `fleet_converge_host_pinned_runner_spec` selects the deploy label for srv1 only when `deploy_route_switch_admitted` holds of the modeled slot's reading; the group is unobserved there, so it reads shared and the generated workflow is unchanged. Routing earlier would send dispatches to an account that lacks the whole-binary grants they use today. The frontier on `srv1_observed_job_tenancy` stays: its capability is the live org-group and slot-unit readback.")
    ]),
  ]
}

data srv1_deploy_principal_split_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly { ruling: project_documentation_projections_are_not_checkout_artifacts },
  slug: "srv1-deploy-principal-split",
  title: "Separating srv1's deploy principal from the CI job user",
  body: srv1_deploy_principal_split_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "Retires when the CI job user holds no path-unrestricted root grant on any runner host and the deploy installs run under the authority the selection names (since 2026-10-25 the inherited convergence approval), i.e. when gunbc.rung_drop the_job_user_holds_a_path_unrestricted_root_grant is retired by its restoration trigger.") }
}
