module gunbc.plans.srv1_deploy_principal_split

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetirement, PlanRetiresWhen, PlanIsAuthorityOnly }
import std.markdown { MarkdownBlock, TableBlock, AlignNone }
import gunbc.plans.md_helpers { h2, p, li, ul, ol, cell, row }
import gunbc.design_ruling { project_documentation_projections_are_not_checkout_artifacts }

fn srv1_deploy_principal_split_body() -> List<MarkdownBlock> {
  [
    p(text: "Status: design, no actuation. Work item `adhoc-9fb32e42-f20`. Authored 2026-10-19. Nothing here changes a rendered sudoers body, a workflow or a host."),
    h2(text: "0. Finding, and what the corpus already owns"),
    p(text: "`ghrunner` runs every srv1 CI job, same-repository `pull_request` jobs included. Through `/etc/sudoers.d/gunbc-deploy` it holds whole-binary NOPASSWD grants over `systemctl`, `install`, `apt-get` and `visudo` (RunAsUsers ALL), plus the rest of `gunbc.fleet.fleet_posix_accounts` `ci_runner_sudo_binaries`. Each is root-equivalent, so PR code is root on srv1."),
    p(text: "The corpus already owns the *class and the standing loss*, so this plan does not file a second one:"),
    ul(items: [
      li(text: "class: `gunbc.recurring_failure_mode.the_grant_a_frontier_refuses_is_already_held_from_another_authority`"),
      li(text: "drop: `gunbc.rung_drop.the_job_user_holds_a_path_unrestricted_root_grant` (2026-09-21, structurally guaranteed -> mitigatable). Its restoration trigger already demands both \"no path-only root grant for the job user\" and \"the installs run under the administrator edge\". That is this plan's target."),
    ]),
    p(text: "What the corpus lacked is the plan, the consumer census and the migration, which this document supplies. The drop explicitly defers \"closing the grants\" to an operator-gated item needing a consumer census; this is that census. No ruling decides which principal deploys; section 5 states it as an open decision."),
    h2(text: "1. Census (question 1)"),
    p(text: "Read from `gunbc.ci.ci_deploy_access` (`srv1_live_deploy_privileged_commands` = `grounded_principal_privileged_commands(fleet_posix_ci_runner_principal())`), `gunbc.live_deploy.apply` / `operations` / `emit`, and `gunbc.auth.privileged_effect_census`. Classes below are read from `select_authorization_pattern`'s hard constraints and gates by inspection, **not yet executed**; executing them and recording the results as census rows is the first task of the follow-up (section 4, step 0), and any cell that execution contradicts overrides this table."),
    TableBlock {
      header: row(cells: [cell(text: "Effect through ghrunner sudo"), cell(text: "Whole-binary grant used"), cell(text: "Selection's reading")]),
      alignments: [AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "Install units / files under `/etc`, `/usr/local` (`live_deploy` preamble, `dashboard_deploy`, `approval_broker_dark_install`)"), cell(text: "`install`"), cell(text: "Host-root reach. `MintedCredentialReach` has no host-root arm, so the cloud-credential patterns are refused by constraint; the only admissible pattern is the administrator edge (SSH as `executor_bootstrap_principal`) or an argv-pinned `ExecutorPrivilegedOperation`.")]),
        row(cells: [cell(text: "`systemctl` daemon-reload / enable / restart / start / stop"), cell(text: "`systemctl`"), cell(text: "Per-unit argv is spellable, so an argv-pinned grant is admissible (precedent: `retirement_mask_line`, the #14390 mask grants, fabric-cell set-property rows). `systemctl edit` and `link` are not argv-pinnable as whole binary.")]),
        row(cells: [cell(text: "Sudoers self-install (`visudo -cf`, `install` into `/etc/sudoers.d`)"), cell(text: "`visudo`, `install`"), cell(text: "**Selection is silent or circular**: a grantee cannot install its own grant (header of `gunbc.fleet.fleet_bootstrap_principal`). Only the administrator edge is admissible.")]),
        row(cells: [cell(text: "Package installs (`apt-get`)"), cell(text: "`apt-get`"), cell(text: "Host-root reach; administrator edge only. Not argv-pinnable without enumerating packages, which is a model row to write, not a call-site choice.")]),
        row(cells: [cell(text: "Runner slot reconciliation (`actions-runner@*` units, `gunbc.runner.runner_slot_desired`)"), cell(text: "`systemctl`"), cell(text: "Per-unit, argv-pinnable; admissible for the job user only for *its own* slot units if at all. Reconciling slots is deploy authority, not job authority.")]),
        row(cells: [cell(text: "Host-wide executor grants (`gunbc.runner.runner_host_grants` -> `gunbc-ghrunner`)"), cell(text: "`install`, `visudo`"), cell(text: "Already argv-pinned and sound; but *installing* it is the self-install circularity above.")]),
        row(cells: [cell(text: "`tailscale`, `rm`, `useradd`, `usermod`, `cp`, `mv`"), cell(text: "whole binary"), cell(text: "No current deploy consumer found in the read set (section 3 lists the consumers that remain to verify). Presumed removable; verify per binary.")]),
      ],
    },
    p(text: "Where selection refuses or is silent: (a) it has **no vocabulary for host-root reach**, so it refuses every cloud pattern for these effects without ever saying \"administrator edge\", which is a modeling gap and a census row to add; (b) it is silent on the sudoers self-install circularity; (c) it does not see that the same uid is shared between PR jobs and dispatched deploy runs, which no pattern can fix because the pattern is chosen per effect, not per co-tenant."),
    h2(text: "2. The split (question 2)"),
    p(text: "The model already contains the split; it is not applied to srv1's `ghrunner` deploy route."),
    ul(items: [
      li(text: "`fleet-converge.yml` is `workflow_dispatch` only. Its main-pinned OIDC pins (`gunbc.auth.oidc_claim_pins`, `fleet_converge_workflow_claim_pins`) gate the fleet SSH key, i.e. the administrator principal `ubuntu` (`executor_bootstrap_principal`). Dev pins are \"refused by the privileged list\" for root-host mutation; branch runs reach only run-scoped approved grants (`branch_run_grant`)."),
      li(text: "A PR job holds none of those: the key is materialized in-run for the main-pinned dispatch only."),
    ]),
    p(text: "Recommended allocation (typed open decision D1, section 5):"),
    ol(items: [
      li(text: "**Deploy authority = the administrator principal over the fleet SSH edge**, as `runner_host_file_converge` already uses. Root-evaluated installs (`install`, `visudo`, `apt-get`, unit install) run as `ubuntu` over SSH from a main-pinned dispatch. The deploy fold stops sudoing as `ghrunner`."),
      li(text: "**One-off, off-main or irreversible effects** go through `gunbc.auth.access_request` / `approval_capability` / `approval_broker` redemption, as the corpus already rules for run-scoped branch grants."),
      li(text: "**No dedicated deploy service account**: it would be a second administrator principal beside `executor_bootstrap_principal`, a nickname for an existing authority (DESIGN §3), and would have to be installed by that same principal anyway. Revisit only if the SSH edge cannot reach a needed host (srv3/srv4 are unverified)."),
      li(text: "**What `ghrunner` keeps**: only argv-pinned lines the selection admits for the job's own work: the #14390 mask grants, the fabric-cell set-property lines, `gunbc-ghrunner` (`runner_host_grants`). Nothing path-only."),
    ]),
    p(text: "Residual not closed by any pattern: srv1 runs PR jobs and dispatched deploy runs under the same uid (`CTRL_RUNNER_JOB_USER=ghrunner`). Removing the sudo grants removes root reach, but a dispatched deploy run and a concurrent PR job still share filesystem and process reach as `ghrunner`. That is a separate class (`sandboxed_worker_runs_as_account_whose_groups_reach_root` owns the briansrls group aspect; `ghrunner` being in group 1000 should be read against it) and stays a declared residual with the per-job microvm migration as its trigger, not something this plan claims to close."),
    h2(text: "3. Migration (question 3)"),
    p(text: "DESIGN §3 default is delete-first, but `gunbc-deploy` is the *only* route by which a deploy installs anything today. Deleting it first leaves no deploy route, and the sudoers drop-in cannot be reinstalled by the principal being narrowed. This boundary is **gap-intolerant**: staged form."),
    p(text: "Consumers of `fleet_posix_ci_runner_sudo_grants` (by name; the root is outside the required gate, so the compiled-population argument does not cover it):"),
    ul(items: [
      li(text: "`gunbc.fleet.fleet_posix_accounts`: `fleet_posix_ci_runner_principal` and two `PrincipalGrounded`/intent rows."),
      li(text: "`gunbc.ci.ci_deploy_sudoers`: allow-list lint and the drop-in render (`deploy_sudoers_dropin_lines_for`, `deploy_sudoers_install_shell`)."),
      li(text: "`gunbc.ci.ci_deploy_access`: `deploy_access_roster`, `srv1_live_deploy_privileged_commands`, `deploy_access_sudoers_install_scope`."),
      li(text: "Text consumers: `gunbc.live_deploy.emit` (two comment sites), `extdeps.github.actions_runner` (comment)."),
      li(text: "Witnesses: `test.claim.grounded_principal_witness`, `test.claim.fleet.fleet_converge_privilege_hold_witness`, `test.claim.fleet.fleet_converge_plan_witness`, `test.claim.ci.deploy_sudoers_host_union_witness`, `test.claim.deploy_access_privilege_witness`."),
      li(text: "Other `DeployAccess` users that would stop resolving: `gunbc.srv3.srv3_host_effect_apply`, `gunbc.srv3.srv3_seeded_install_media`, and the `test.claim.live_deploy.*` witnesses that bind `ci_deploy_srv1_access`."),
    ]),
    p(text: "Deploys that break if the grants go first: every `live_deploy` apply, `dashboard_deploy`, `approval_broker_dark_install`, runner slot reconcile, and the srv3 host effects. All reinstall through `ghrunner` sudo today. `deploy_access_check` refuses `principal mismatch` for any other actor, so there is no alternate door either."),
    p(text: "Stages (each its own PR, none in this one):"),
    ol(items: [
      li(text: "**Model the gap first**: execute `select_authorization_pattern` for each row of section 1 and add the census rows; add a host-root reach arm so the selection can name the administrator edge instead of refusing silently."),
      li(text: "**Y in shadow**: a `DeployAccess` whose principal is `executor_bootstrap_principal` over the SSH edge, with the deploy fold able to run through it on main-pinned dispatch. The old route stays authoritative; Y runs read-only/idempotent applies and its readback is compared."),
      li(text: "**One transition**: switch the root (`apply_dispatch` routes to Y), install the narrowed argv-only drop-in via the administrator edge, and delete the whole-binary rows from `ci_runner_sudo_binaries` in the same change. Y never falls back to the old route. Because the drop-in is installed by the admin edge, the narrowing cannot strand itself."),
      li(text: "**Verify on host by the independent readback** (the `sudo -ll` probe the finding used) per host, and amend the drop population (srv1, srv2 known; srv3/srv4 unverified) as each is read."),
    ]),
    p(text: "No window without a deploy route: Y is proven in shadow before the single switch, and the switch and the deletion are one change."),
    h2(text: "4. Ladder (question 4)"),
    p(text: "No new row. The instance joins the existing class and drop:"),
    ul(items: [
      li(text: "Instance added to `the_grant_a_frontier_refuses_is_already_held_from_another_authority`: 2026-10-19, read only on srv1, `sudo -n -ll -u root /usr/bin/systemctl mask --now actions-runner@srv1-03.service` matched the `gunbc-deploy` entry; it fits because two authorities render for one principal at opposite grains, and this specimen shows the consequence is PR-code root rather than a stale wall."),
      li(text: "Drop population updated with the same read. Rung stays mitigatable. Ceiling stays structural impossibility (decidable: a rendered sudoers body either carries argv or it does not). Next-rung trigger is the drop's existing capability trigger; this plan names the path to it (section 3) and the one step that can climb now but is unbuilt (stage 0 + stage 1)."),
    ]),
    h2(text: "5. Open decisions (operator)"),
    ul(items: [
      li(text: "**D1 which principal deploys.** Options: (A) administrator edge `ubuntu` over SSH from main-pinned dispatch; (B) approval-broker redemption per deploy; (C) dedicated deploy account. **Recommend A**: already modeled, already gated by the main-pinned federation, no second administrator authority. B suits one-offs, not a routine deploy that would otherwise need a phone tap per run. C rejected above."),
      li(text: "**D2 srv3/srv4.** Verified only for srv1 and srv2. Recommend reading each (needs operator key) before stage 2."),
      li(text: "**D3 same-uid co-tenancy.** Accept as a declared residual until the per-job microvm migration, or fund a separate uid for dispatched runs. Recommend accept and declare."),
    ]),
  ]
}

data srv1_deploy_principal_split_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly { ruling: project_documentation_projections_are_not_checkout_artifacts },
  slug: "srv1-deploy-principal-split",
  title: "Separating srv1's deploy principal from the CI job user",
  body: srv1_deploy_principal_split_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "Retires when the CI job user holds no path-unrestricted root grant on any runner host and the deploy installs run under the administrator edge, i.e. when gunbc.rung_drop the_job_user_holds_a_path_unrestricted_root_grant is retired by its restoration trigger.") }
}
