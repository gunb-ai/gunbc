module gunbc.plans.native_obligation_population

import std.types { String, List, Bool, Int, list_length }
import v2.std.algebra { any }
import v2.compiler.native_test_vocabulary { NativeTestStage, NativeTestStageContext, NativeTestStagePrepare, NativeTestStageEntry, NativeTestStageEval, native_test_stage_text }
import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetiresWhen, PlanProjectsCommittedMarkdown }
import std.markdown { MarkdownBlock }
import gunbc.plans.md_helpers { h2, p, li, ul, ol, quote }

// The typed rows this plan carries, because an annotation is not a declaration (DESIGN section 4c).
// The frontier is born unobserved; roadmap node native-route-first-frontier flips it by a RUN.
type NativeFrontierObservation
  = FrontierUnobserved
  | FrontierObserved { terminal: String, tested_tree: String, executable_identity: String, command: String }

data native_route_first_frontier: NativeFrontierObservation = FrontierUnobserved

// The green set: identities the built driver adjudicated as agreeing. Empty until the first run.
data native_population_green_set: List<String> = []

data native_terminal_stages: List<NativeTestStage> = [NativeTestStageContext, NativeTestStagePrepare, NativeTestStageEntry, NativeTestStageEval]

// A terminal is "<stage>:<reason>" where <stage> is a stage the native vocabulary mints.
fn native_terminal_is_in_vocabulary(terminal: String) -> Bool {
  any(native_terminal_stages, s => starts_with(s: terminal, prefix: concat(native_test_stage_text(stage: s), ":")))
}

// A frontier stands only when a run produced it: every provenance field is non-empty and the
// terminal is in the native vocabulary. FrontierUnobserved never stands.
fn native_frontier_stands(f: NativeFrontierObservation) -> Bool {
  match f {
    FrontierUnobserved => false
    FrontierObserved { terminal: t, tested_tree: tree, executable_identity: exe, command: cmd } =>
      native_terminal_is_in_vocabulary(terminal: t) && tree != "" && exe != "" && cmd != ""
  }
}

// The population carries exactly one frontier beside its green set.
fn native_population_frontier_count(rows: List<NativeFrontierObservation>) -> Int {
  list_length(items: rows)
}

fn native_obligation_population_body() -> List<MarkdownBlock> {
  [
    quote(blocks: [
      p(text: "**Status: designed 2026-10-09 (operator ruling: every v2 task carries a design and is handed to a dispatch worker). No implementation lands from this document.** It is the model behind roadmap nodes `native-route-first-frontier` and `native-obligation-population`."),
    ]),
    h2(text: "1. Goal and displaced cost"),
    p(text: "After the 2026-10-09 ruling the required path has one job, `witnesses`, which emits and builds the two retained products. Nothing on that path yet judges the `v2.test.*` universe with a binary the seed emitted, so `gunbc.rung_drop` `v2_native_route_off_the_merge_path` stands and the native verdict is reasoned rather than observed. The displaced cost is every landing that cannot tell whether the native compiler agrees with the tree it just built."),
    h2(text: "2. The model"),
    ul(items: [
      li(text: "**Population, separate from the subject rows.** `gunbc.emitted_subject_build_gate` `emitted_subject_build_rows` name what is emitted and built (two products). The population is what the BUILT product then adjudicates; it is a different set with a different executor and is not appended to those rows."),
      li(text: "**Executor.** The self-host product's built `std.compiler_entry` `SourceRootEvalDriver`, run in adjudicate mode over a universe of identities. Not the interpreter, not the seed's Rust."),
      li(text: "**Green set plus exactly one frontier.** `native_population_green_set` holds identities the driver adjudicated as agreeing; the frontier is the FIRST typed terminal the driver reports beyond it. A second frontier row refuses: the line stops at the first deficit (DESIGN section 5)."),
      li(text: "**Eligibility is native adjudication only.** A member judged by the host (`NativeClaimProgramProducer`, `NativeServeProgramProducer`) is ineligible; admitting it would let the interpreter's verdict stand in for the native one."),
      li(text: "**Reuse versus replace.** `gunbc.native_frontier_roster` and `gunbc.native_frontier_debt` stay the debt contract; the first green set is what mints the roster, so this plan feeds that carrier and does not fork it."),
    ]),
    h2(text: "3. Milestones"),
    ol(items: [
      li(text: "**M1 native-route-first-frontier.** Makes true: `native_route_first_frontier` is `FrontierObserved` from one driver run over a one-identity universe. Deletes in the same change: nothing. Production consumer: the ordering decision between `xl2-body-lowering` and `native-seven`. Qualification: the three witness functions. Exit: the row carries tested tree, executable identity and command."),
      li(text: "**M2 native-obligation-population.** Makes true: a green set and the one frontier judged by a step in the `witnesses` job. Deletes in the same change: the `v2_native_route_off_the_merge_path` population it discharges. Production consumer: `native-production-admission`, whose denominator is this green set. Qualification: the four witness functions. Exit: the first merge_group run printing the green set and the frontier."),
    ]),
    h2(text: "4. Decisions"),
    ol(items: [
      li(text: "Ruled 2026-10-09: the frontier is observed from a run, never reasoned from source."),
      li(text: "Deferred: widening the universe from one identity to all of `v2.test.*`; trigger is M1 landed with a terminal that the driver can pass."),
    ]),
  ]
}

data native_obligation_population_plan: Plan = Plan {
  projection: PlanProjectsCommittedMarkdown,
  slug: "native-obligation-population",
  title: "Native obligation population: the built driver judges the v2 universe on the required path",
  body: native_obligation_population_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "Delete when the population is judged on every landing by the binary built from the seed's emission, retiring gunbc.rung_drop v2_native_route_off_the_merge_path and discharging v1_required_lanes_withdrawn member (1), and native_population_green_set has become the minted gunbc.native_frontier_roster. A terminal refusal is evidence and never dissolves this plan.") }
}
