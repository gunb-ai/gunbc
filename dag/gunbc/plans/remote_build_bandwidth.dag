module gunbc.plans.remote_build_bandwidth

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetiresWhen, PlanIsAuthorityOnly }
import std.markdown { MarkdownBlock, TableBlock, AlignNone }
import gunbc.markdown_helpers { h2, p, li, ul, quote, cell, row }

fn remote_build_bandwidth_body() -> List<MarkdownBlock> {
  [
    quote(blocks: [
      p(text: "**This plan is written as an intention** (`gunbc.design_argument::plans_are_intentions`): what the repository should become, why, and done-when. Its work items are roadmap nodes that name it through `gunbc.roadmap.roadmap_intention_binding`; this text does not list them, hold their status or order them in time."),
      p(text: "**Grounding:** `gunbc.design_ruling::remote_build_ssh_dispatch_is_an_admitted_scaffold`, `gunbc.design_ruling::hosted_ci_bridges_to_remote_builds_and_adopts_work_execution_redesign`, `gunbc.design_argument::selection_precedes_convergence`, `gunbc.design_argument::replacement_migration`, `gunbc.design_argument::consumption`, `gunbc.design_argument::conformance`."),
    ]),
    h2(text: "1. Intention"),
    p(text: "**What:** every candidate serving host (srv1, srv3, srv4, ken = operator_host_e2d4b7, butch = operator_host_srv14) serves pinned remote compiles and claim runs end to end. Nobody chooses a host or clears host state by hand. Blockers are found **all at once by a read-only survey**, not one at a time by live converges that stop at their first failure."),
    p(text: "**Why:**"),
    ul(items: [
      li(text: "Operator, 2026-11-21: \"i need to get maximum remote build bandwidth asap, because we're fairly behind\"."),
      li(text: "Operator, 2026-11-26: \"are we in like a discover issues one by one phase? if so, i suggest we back up and plan and regroup, because thats how the mtcollins program effectively died - spiraling trying to fix issues one by one\", and \"somehow we need to fine all of the current blockers instead of serially - our process is too slow\"."),
      li(text: "Operator, 2026-11-26, on what the end user should see: \"the end user should probably just se a giant load balancer/router (basically the samae thing as openresty) - where they get a refusal/capacity limited and retry allowance - i would make sure not to diverge because the semantics should be very similar (stateless/simple processing)\". The walk the client does today is the divergence: it is routing done in every client, in a vocabulary of its own."),
      li(text: "The cost displaced: srv1 is the only place test evidence is produced today (load 40-52, about 48 min per `gunbc test`), while four other hosts sit unable to serve."),
    ]),
    p(text: "**Design constraint (operator, 2026-11-26): one front, router semantics.** The remote-build client sees ONE front that answers in the serving router's vocabulary: an answer is served, or capacity-limited with a retry allowance (`std.retry_law`'s `RetryHint`, mapped to HTTP by `gunbc.retry_http_hint`), or a final refusal. The client does not walk hosts. And the semantics must not diverge from the router this repository already has (`gunbc.plans.fabric_serving_router`, `gunbc.serving.router_proxy_config`, `extdeps.proxy.openresty`): the processing on both sides is stateless and simple, so a second vocabulary for the same answer would be a second authority over it (`gunbc.design_argument::single_authority`). What that costs, and where the answer classes differ, is a work item, not a detail -- see the row that points back here."),
    p(text: "**Done when** (each is assessed against the tree or a host read unless marked as the operator's judgement):"),
    ul(items: [
      li(text: "Each of srv1, srv3, srv4, ken and butch has a pinned compile **and** a pinned claim run whose receipt reads back served=true, with no hand cleanup of host state before or after."),
      li(text: "A read-only serving-precondition survey of every candidate host is a modelled route that runs in one dispatch and reports every unmet precondition per host, not the first one."),
      li(text: "A refused reservation's slot never blocks the census, and the census reports every unclassifiable slot, not the first."),
      li(text: "A request is wall-bounded on the host: a bound on how long it may wait before starting, and a bound on how long it may run, both enforced host-side, so a client that gives up or is old cannot hold a seat for hours."),
      li(text: "The serving probe leg's ceiling is derived from a serving-host read behind the front door, not from a dev box."),
      li(text: "Operator's judgement: remote-build bandwidth is no longer the constraint on the operator's work."),
    ]),
    p(text: "**Deferred, still owned by the work-execution-redesign program** (carried by the closed PR 16859 cut of this intention, and deliberately NOT work items of this one): `remote-build-answer-is-a-fabric-receipt`, `remote-build-request-carries-execution-requirements`, per-claim verdicts in receipts, `remote-build-gate-label-passes-remotely`, `remote-build-ci-bridge`, `remote-build-warm-target-cache`, `remote-build-worker-guidance-in-ctrl`, `remote-build-worker-loop-exercised`, `remote-build-bobo-admission`. Section 2 and section 3 stand as the design evidence for those as well."),
    h2(text: "2. Audit against fabric and the work-execution-redesign program, read at main 7711690f3f5 (2026-11-21)"),
    p(text: "Design evidence, cited by symbol. Each mechanism is classified as using, re-implementing or bypassing the fabric authority that `gunbc.design_argument` `conformance_domains` names for its concern."),
    ul(items: [
      li(text: "**Host choice -- bypasses, by declared divergence.** `gunbc.compute.remote_build::remote_build_next_step` walks the dispatch roster `gunbc.compute.remote_build_hosts::remote_build_serving_hosts` in order, and the host pin (`remote_build_host_pin`, `remote_build_pinned_candidates`) narrows that walk to one host. No compute module imports `product.fabric.selection::select_supply`, `gunbc.fabric.fabric_control_plane::CellReservation` or `gunbc.fabric.fabric_executor_class`. The divergence is stated in the module header and admitted by `gunbc.design_ruling::remote_build_ssh_dispatch_is_an_admitted_scaffold`, whose dissolution is work-exec-2. Consequence for this plan: no new selection policy is built in the remote build; the one addition admitted is a requirements check against the executor-class authority, because a mixed-architecture roster needs it before work-exec-2 lands and the check is fabric's own join, so it survives."),
      li(text: "**Build seat and ledger -- uses.** The serving host's provider reserves through `gunbc.compute.host_capacity::compute_reserve_against`, which calls `gunbc.fabric.fabric_event_log::fabric_seat_acquire` with a `product.capacity.pool_events::SeatRequest` and holds a `product.capacity.lease::LeaseGrant`; release goes through `fabric_seat_release`. Pool sizing is the frozen carve (`gunbc.runner.runner_slot_desired::host_build_pool_reservation`), and the runner allocation subtracts the remote-build reservation, so the carved bytes are not promised twice. Standing: reuses fabric's capacity and lease transitions; the frozen host allocations and the direct-provider lifecycle remain bridge assumptions. Two consequences read from code, not measured live: each carved host's 25 GiB build pool admits one heavy reservation (22 GiB unprofiled default, 25 GiB CI bound, no measured class-grant rows yet) whatever the nominal seat count; and acquisition and release replay the host's event history under `gunbc.compute.host_capacity` compute_partition_read_budget (4096) and refuse when it is exhausted, with no compaction, which is a fabric storage obligation (recorded as an integration concern). The ledger itself (PR 11962) replaced a lease-file count that two requests could both pass with byte-denominated fabric reservations; that atomic, host-local accounting is preserved."),
      li(text: "**Request shape -- uses the operation, bypasses the requirements.** `gunbc.compute.remote_build::RemoteBuildOperation` maps one to one onto `gunbc.compute.work_request::WorkOperation`, but the request carries no `product.fabric.work::ExecutionRequirements`; only `SourceManifestRef` is taken from product.fabric.work. A work item closes this."),
      li(text: "**Attempt lifecycle and recovery -- bypasses the shared controller.** `gunbc.compute.attempt_lifecycle::recovery_write_authorization` and `gunbc.compute.work_provider_local::compute_recover_attempt_in` keep the attempt slot in a compare-and-set file store beside the fabric event log; only the seat release returns through the log. `gunbc.compute.durable_attempt_controller` joins attempt_lifecycle to `product.fabric.execution`, and no remote-build module imports it; but its `controller_store` is also file-backed compare-and-set, so moving onto it does not by itself move attempts into the fabric event log. The substantive integration is shared request ownership, fencing, cancellation, grants and result admission, and that is what the integration concern names, homed at work-exec-2's durable route. The serving converge's stale-seat recovery is admitted as bridge maintenance and dissolves with that route."),
      li(text: "**Receipt -- bypasses.** `gunbc.compute.remote_build::RemoteBuildHostAnswer` carries `HostServed { receipt: String }` and the client writes a file; `product.fabric.execution::Receipt` is not used. Per-claim verdicts must not be added to the string: a work item makes the answer a typed fabric receipt first, and the verdicts ride it, because work-exec-5 publishes the required verdict from an admitted receipt. Wrapping the string in the type is not enough: `gunbc.compute.durable_attempt_controller` controller_receipt_for_attempt has no accepted outcome today because an otherwise admissible receipt lacks outcome, work and source bindings, so the receipt must be bound to the work, source, attempt, grant and result, and the consumer must admit it and reject a mismatched or stale one. Failure meaning must survive too: the provider's unclassifiable unit ending is an infrastructure refusal that the remote adapters can turn into a code verdict, and an earlier host's failed attempt disappears from the final receipt when a later host answers."),
      li(text: "**Workload sizing -- owned by work-exec-3.** Sizing grants from `gunbc.compute.work_class_grant` evidence instead of the seat is work-exec-3-automatic-sizing's; no remote-build row restates it. The comments in `gunbc.compute.work_class_grant` and `gunbc.compute.work_provider_local` that name a follow-up node workload-profiles-replace-seats cite a node that does not exist at main; retargeting them to work-exec-3 is a comment edit outside this planning change. The remote build contributes only the samples."),
      li(text: "**Executed source -- not bound (pre-existing on main 8ac28255d535, read from source, not reproduced live).** `gunbc.compute.work_provider_local` compute_resolve_subject computes the request's source manifest from a fresh checkout it then removes, while compute_run_leased executes in a persistent checkout it accepts whenever the directory lists, without checking it against that manifest; compute_remove_owned_target removes the target, not the source. A retry after a failed attempt that changed source can execute a modified checkout under a clean identity. A work item binds the executed materialization to the manifest; it precedes any further reuse."),
      li(text: "**Warm target cache -- belongs to the materialization domain.** Reusing a host's previous target directory is a cache: `std.materialization_ladder` decides first whether the repetition is authored duplication, then whether a reuse obligation exists, then which provider discharges it (`gunbc.design_argument::demand_before_materialization`). The work item is homed there, not as a remote-build feature."),
    ]),
    p(text: "**Live evidence, 2026-11-21 (receipts held by the srv3/srv4 work item).** A compile of clean main pinned to srv4 read back served (exit 0, about 24 minutes wall, client peak about 3.4 GB), building in the serving account's own scratch root. The gate label //gunbc/instruments:v2-native-cli pinned to srv4 was admitted and ledger-reserved, ran, and answered work-failed with host exit code 101 while the same label is green in CI: the subject fails in the remote subject environment, and only a host-side log read can say why, which no modelled read route fetches today. The same run's first `remote-build-v1 probe` leg failed with exit 6 and the client continued to the next leg, so a probe failure is absorbed without a typed record (`gunbc.design_argument::fail_closed`). The answer path also lists a per-class grant-exceeded counter the receipt does not carry."),
    h2(text: "3. The work-execution-redesign program, read the same day"),
    ul(items: [
      li(text: "**An ordering conflict, made an acceptance obligation.** work-exec-4-local-work-cutover deletes the direct `compute_provide` launch and `ComputeBuildPool`, but the remote build's serve leg calls `compute_provide` while the bridge carries a check. work-exec-4's red control now requires the serve leg to submit through the durable route before the launch is deleted."),
      li(text: "**The required switch is work-exec-5's.** remote-build-ci-bridge's first slice is a non-required hosted job and its out_of_scope excludes making the remote path required; commit-bound receipt admission, stale-attempt rejection, the publisher boundary, rollback and runner retirement are work-exec-5-ci-verdict-from-receipt's, so no milestone here claims the required check runs remotely."),
      li(text: "**The work's current carriers.** The work-execution-redesign program and its placement-backend decision are carried by `gunbc.roadmap.roadmap_authority`; work-exec-2's durable route is carried by `gunbc.compute.durable_attempt_controller`. None relies on the removed durable_work_handoff plan."),
      li(text: "**A question the bridge's evidence now bears on.** work-exec-1 selects a placement backend by spike (k3s with Kueue first, else Nomad, else gunbc's own allocator). The bridge has since served a compile through gunbc's own seat ledger and fabric event log; whether that changes which candidate the spike tries first is the operator's call, not this plan's."),
      li(text: "**Shadow evidence feeds work-exec-5 by text, not by edge.** work-exec-5's first slice is a shadow job on every pull request, which is what the hosted-runner shadow gate is; the ruling keeps dissolution out of the edge set, so the link is stated here and in the nodes' text only."),
    ]),
    p(text: "Operator handoff, 2026-11-22: the fleet-converge budget raise is withdrawn in favour of the 60-minute timeout cut. The roadmap records the remaining model and regeneration work within the admitted budgets; this is no longer an open request for a raise and is not a claim that the cut has landed."),
    h2(text: "4. Survey evidence (read-only, 2026-11-26 ~09:30-10:45Z, clever-raven-401 via srv2 at the operator's direction; no host was mutated)"),
    TableBlock {
      header: row(cells: [cell(text: "host"), cell(text: "arch, cores, mem"), cell(text: "CPU ceiling"), cell(text: "gunbc-build / gunbc-compute"), cell(text: "linger, work slice"), cell(text: "ledger /opt/gunbc/compute/capacity"), cell(text: "forced command (entry)"), cell(text: "checkout / serve bin"), cell(text: "notes")]),
      alignments: [AlignNone, AlignNone, AlignNone, AlignNone, AlignNone, AlignNone, AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "srv1"), cell(text: "aarch64, 128, 502G"), cell(text: "2.0 of 3.0 GHz (cpu-freq-cap.service active)"), cell(text: "yes / members briansrls,gunbc-build"), cell(text: "yes, gunbc-user-work.slice 44 GiB"), cell(text: "briansrls:gunbc-compute 03770"), cell(text: "OLD remote_build_serve.dag"), cell(text: "71b23d66 / bin 2026-11-26 03:18"), cell(text: "load 48; 131 attempt records, 17 spool records")]),
        row(cells: [cell(text: "srv3"), cell(text: "aarch64, 128, 502G"), cell(text: "2.0 of 3.0 GHz"), cell(text: "yes / gunbc-build,briansrls"), cell(text: "yes, 25 GiB"), cell(text: "briansrls:gunbc-compute"), cell(text: "FRONT DOOR (#17114)"), cell(text: "a8034c12 / 160f8a56"), cell(text: "a request from srv2 held since 2026-11-25 12:46 (TCP still established); serve started 05:44 today; claim run unit gunbc-compute-d6481839... running since 06:07, 20 GB, progressing; 15 spool records incl. one oom-kill")]),
        row(cells: [cell(text: "srv4"), cell(text: "aarch64, 128, 502G"), cell(text: "2.0 of 3.0 GHz"), cell(text: "yes"), cell(text: "yes, 25 GiB"), cell(text: "briansrls:gunbc-compute"), cell(text: "OLD"), cell(text: "f41ce8aa / bin 2026-11-21"), cell(text: "never observed by the fleet-converge route (dispatch-admission step timeout); 14 spool records")]),
        row(cells: [cell(text: "ken"), cell(text: "x86_64, 128, 125G"), cell(text: "2.0 of 2.18 GHz, no cap service"), cell(text: "gunbc-build only, partial converge"), cell(text: "no linger, no user@1005"), cell(text: "absent"), cell(text: "none"), cell(text: "none"), cell(text: "tailnet tags ci+serving; no toolchain, checkout or binary")]),
        row(cells: [cell(text: "butch"), cell(text: "aarch64, 80, 250G"), cell(text: "3.0 GHz, no cap"), cell(text: "gunbc-build only, partial converge"), cell(text: "no linger"), cell(text: "absent"), cell(text: "none"), cell(text: "none"), cell(text: "tailnet tag ci ONLY (no tag:serving)")]),
      ],
    },
    p(text: "**Census findings (these replace the \"dead seats\" reading):**"),
    ul(items: [
      li(text: "**Bug A:** srv1 09bcdd84...#8 and srv3 2c56092...#2 have state terminal:recovered with detail \"reservation refused: ... pool-full (attempt 1)\" and granted_kib 23068672. No seat was granted and no unit existed, yet the census demands proof that a unit ended and keeps a charge. The harm is that a refused-reservation slot is **permanent census poison**: it can never get unit proof, so the census stays unknown and the converge refuses. (Corrected 2026-11-26: there is no loop where a phantom charge causes pool-full -- admission reads only the capacity ledger, and a refused reservation never enters it.) The fix shape: a terminal slot the ledger never charged is skipped; an unreadable ledger stays unknown."),
      li(text: "**Bug B, as corrected by crisp-pike-295 from run logs and code:** there is no spool-lookup bug. The census fold **short-circuits at the first unknown slot**, so srv1 011dfdd...#1 (terminal:succeeded, its spool record at `attempt-exit-spool/1005/done/011dfdd...+70c25cd...+success+exited+0`) was never classified at all. The fix is that the census classifies every slot and reports all unknowns."),
      li(text: "**Bug C (still-tern-419, run logs and code, 2026-11-26):** srv3's converge 45762320308 refuses on seat 2c560927..#1 -- terminal:recovered, no unit, no stop-hook record -- because the unit-ended proof reads `/sys/fs/cgroup/cgroup.events`, which does not exist on these hosts; 250433fc..#1 has the same shape. It is a different defect from the two census findings: no proof is readable at all, rather than a readable one misclassified."),
      li(text: "The stop hook works: ExecStopPost `install -d .../attempt-exit-spool/1005/done/<id>+$\{INVOCATION_ID}+$\{SERVICE_RESULT}+$\{EXIT_CODE}+$\{EXIT_STATUS}`. Records exist on all three serving hosts."),
      li(text: "operator ruling `srv1_stale_seats_released_proven_ended_2026_11_26` (#17124) is now a fallback; Bug A and the census short-circuit are the cause."),
    ]),
    p(text: "**Addendum (2026-11-26, from quiet-pike-440 and a read-only check of ken and butch):** ken and butch both reach github.com, static.rust-lang.org and index.crates.io (HTTP 200), so converge egress is not a blocker. Their disks: ken 333G free, butch 247G free."),
    p(text: "**Addendum, settled the ken slice question (2026-11-26, lively-owl-722, reads only -- no dispatch, no host contact):** ken's user work slice ceiling is 44 GiB = 47,244,640,256 bytes -- InstallUserWorkSlice MemoryMax is user_work_slice_memory_max_for_host(host-e2d4b7) (dag/gunbc/compute/host_capacity.dag:558); host_build_pool_is_carved(ken) is false because ken is not on remote_build_serving_hosts() (that roster is [srv3, srv4]; ken is candidate-only), so ken takes the user_work_pool_slots branch: user_work_slice_memory_max_of = user_work_slot_memory_max (23,622,320,128 B, dag/gunbc/runner/slice_bounds.dag:329) x 2 charged slots (user_work_pool_slots.dag:27) = 47,244,640,256 B. The native serve build runs INSIDE gunbc-user-work.slice, with no uncapped fallback. No measured peak RSS exists for the exact command (the native BuildServeBinary route #16885 has never executed; the arm64 hosts use the upload path). The closest measured build-class records: srv1 lab builds-run-in-cgroup peak 15.8 GiB against the 22 GiB fleet per-build ceiling, and srv1 attempt-worker transient peaks of 12.5-18.2 GiB (max 18.2, median 15.8 over eight) in gunbc.live_deploy.srv1_worker_slice_receipt, which carries a standing read_obligation: a reading above the bound is answered by lowering the work, never by widening the bound. VERDICT: fits, with margin, on the cited build-class evidence -- not proven for the exact command. The first native build's receipt records its peak and closes that measurement."),
    p(text: "**Addendum (2026-11-26, still-tern-419):** #17118, merged 07:34Z, gates the fleet-converge dispatch-admission step to `mode == hostname_converge`, so srv4's two dead observes on 2026-11-26 (runs 45770097040, 45773631715) were the build job, not the host: no srv4 host blocker is known or cleared, and srv4 has still never been observed by the fleet route. The run has no budget row either: a probe overrun moves the walk on to the next host, while a request overrun answers `HostOutcomeUnknown` and stops the walk -- and with two rostered hosts, 2 x 1500 s already exceeds the 1800 s step bound, so no row models the run total."),
    p(text: "**Addendum, butch's tailnet tags (2026-11-26, quiet-pike-440, model and ACL, read-only):** butch carries `tag:ci` only, and that is by design and sufficient. The remote-build client reaches serving hosts through `tag_ci_dispatch_to_build_hosts_ssh_grant` (dst `tag:ci`, tcp:22, extdeps/tailscale/acl.dag:231-236); the converge peer executor reached butch:22 with `tag:ci` alone (observe run 45641490241, converge 45686569467); `tag:serving` gates only dashboard-to-inference ports 18081-18083 (extdeps/tailscale/acl.dag:211-217); butch's participation is `ci_runner_enrollment_participation` (gunbc/fleet/fleet_enrollment.dag:241) and serving tags are role-gated to `InferenceServingParticipation` (gunbc/tailscale_fleet_auth_key.dag:238-240), so applying `tag:serving` would misstate a host that runs no inference engines (#16848). The reachability risk runs the other way: srv3 and srv4 do not see butch over the tailnet, and no tag change fixes that -- the node issuing butch's pinned client compile must be verified to reach butch:22."),
    p(text: "**Addendum, all five hosts read at ONE head (2026-11-26, still-tern-419, observe-only -- no converge, nothing mutating; head d20fa377f6c830609b7caf3e4b26b5750aba1e71, verified to contain #17114, #17118 and #17124, so the 5-minute build-job step could not recur).** These are dated point-in-time host readings, evidence for the design question, not a status log. Numbers in the last column are the survey checklist's own precondition ids."),
    TableBlock {
      header: row(cells: [cell(text: "host"), cell(text: "observe run"), cell(text: "verdict"), cell(text: "unmet preconditions, as read")]),
      alignments: [AlignNone, AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "srv3"), cell(text: "45823174311 (executor srv3-13, 13:07:01Z)"), cell(text: "success-drift"), cell(text: "3.7 checkout (has a8034c12663d..); 3.11 serve binary (has 160f8a56a4fd..); 4.3 seat census DEFERRED behind 3.7, because the census door lives in the checkout -- and behind it seats 2c560927..#1 and 250433fc..#1 still have no proven_ended_seat_releases row (#17124 covers the two srv1 refs only). 3.6 authorized_keys.forced_command is MET: the front door IS installed here, the only one of the five where that is true.")]),
        row(cells: [cell(text: "srv1"), cell(text: "45823179327 (executor srv1-09, 13:04:58Z)"), cell(text: "success-drift"), cell(text: "1.2 off the dispatch roster (remote_build_serving_hosts = [srv3, srv4]; model-side, no host read changes it); 3.6 forced_command DRIFTS -- front door NOT installed, and its clean 11-25 verdict was rendered against pre-#17114 words, so it proved nothing; 3.7 checkout (has 71b23d66de.., moved from 10142523b00 -- the 02:52Z converge wrote the checkout and THEN refused at the census, which independently confirms the rank order); 3.11 binary (has 75dadf780183..); 4.3 census DEFERRED, though its two seats ARE attested by #17124.")]),
        row(cells: [cell(text: "srv4"), cell(text: "45823184766 (executor srv3-01 peer, 13:13:45Z)"), cell(text: "success-drift; first srv4 read on a fixed head"), cell(text: "3.6 forced_command DRIFTS -- front door NOT installed, and srv4 is ON the dispatch roster, so a pinned srv4 probe is answered by the pre-#17114 request entry, which refuses it (ServeHostCannotServe: the probe is answered by the front door) and the walk moves on; 3.7 checkout (has f41ce8aad011..); 3.11 binary (has f692ec9606ff..); 4.3 census DEFERRED, and its seat charges have never been read on any head, so 4.3 is UNKNOWN here rather than merely deferred.")]),
        row(cells: [cell(text: "butch (srv14)"), cell(text: "45823189449 (executor srv1-09, 13:12:28Z)"), cell(text: "failure: INDETERMINATE"), cell(text: "one unread fact, 3.8 toolchain: rustup toolchain list exits 127, and the named concern remote_build_serving_fresh_account_has_no_toolchain_bootstrap is what turns that drift into a refusal. Everything else reads as known deviation: group.members, the three ledgers, store.root, store.staging, scratch.root, seed.serve_binary, checkout, user_manager.linger, the user work slice, forced_command, seat.census -- so 1.4's capacity home is absent (sudo -n stat of the capacity objects exits 1, and elevation itself works), 1.6 carries the #17112 owner blocker, stages 3.2-3.11 are unmet, and 1.2 is off the dispatch row. Settled in butch's favour: the 11-23 refusal that the forced-command line is unrenderable is GONE (the candidate row renders, so 1.1 and 2.4 are MET), and the host is reachable and anchored.")]),
        row(cells: [cell(text: "ken (host-e2d4b7)"), cell(text: "45823194417 (executor srv1-07, 13:43:07Z)"), cell(text: "failure: INDETERMINATE"), cell(text: "the same shape as butch: one unread (3.8 toolchain, rustup exit 127) and the same known-deviation list, so 1.4's home is absent, 1.6 carries the #17112 blocker and stages 3.2-3.11 are unmet. Model-side also unmet: 1.2 off the roster, and 3.11 with no x86 serve route -- the pool binary is arm64 (RB-M3 pending), so the observe wants an x86-matching binary it has no way to place. 1.9 IS MET: reachable -- 21 ssh legs to ken.tailecbe08.ts.net with zero 'could not resolve', and elevation executes. The desired state renders, with no unrenderable refusal, even on x86.")]),
      ],
    },
    p(text: "**What those five readings change.** The front door is the most common unmet precondition among ROSTERED hosts, and that is read, not inferred: clever-raven-401 read gunbc-build's authorized_keys on the three arm64 hosts, and srv1 and srv4 name the OLD entry (remote_build_serve.dag / remote_build_serve_cli) while srv3 names the front door. So today's roster reads srv3 drifted-but-front-doored and srv4 front-door-missing, and no roster change reaches that: srv4 needs the EnsureAuthorizedKeys write. The fleet splits into three shapes that one-host-at-a-time converges could not show -- rostered and front-doored (srv3: only checkout, binary and census left), rostered without the front door (srv1, srv4), and fresh with exactly one unread fact (ken, butch) -- and for both fresh hosts the critical path is #17112, then a toolchain bootstrap, then the peer converge: not reachability, not enrollment, not the roster. No host has a READ pool state, because the census is deferred everywhere, and the door goes unknown on a recorded scope bound ('observed-bound arm did not admit (chain-unbounded)'). And nothing anywhere reported unread elevation, an arch mismatch against the authored row, a group-gid mismatch, or store/scratch drift on the three arm64 hosts: stages 1.3-1.8, 2.x, 3.1-3.5 and 3.9-3.10 are MET on all three. A successful observe is MET only against the head that observed it, which is why these readings name their head."),
    p(text: "**Addendum, ken's build pool ruled (2026-11-26).** Option A, approved by default on escalation msg_5ffaed22: ken takes zero CI width plus its own build pool of 22 GiB with ONE seat, beside the ken-strata engine at about 69 GiB RSS. That supersedes the 44 GiB two-slot reading above: once ken carries its own pool row, host_build_pool_is_carved(ken) is true and the slice follows the pool, and the capacity PR states the figure. The measurement obligation stands and is tighter: the highest measured build-class peak is 18.2 GiB against a 22 GiB per-build ceiling, so the native serve build fits with roughly 4 GiB of margin, and the first native build's receipt must record its own peak."),
    p(text: "**Addendum, the capacity ruling (2026-11-27, option A approved by default on escalation msg_0e98e799; quiet-pike-440 carries the implementation in gunb-ai/gunbc#17181).** A SAFE seat is 22 GiB of build grant + 3.4 GiB for the serving child + 0.8 GiB for the legs. On that arithmetic srv1, srv3 and srv4 take 4 safe seats each, and srv3 and srv4 each drop 2 CI runners to make room; butch takes 7; ken takes 1. This supersedes the 22 GiB ken figure above: ken's seat is 26.2 GiB. It is recorded here as evidence for the ruling, not as a status log -- the seat-count row and the slice-charge row both point at it, and the row that says the serving child and the legs are not charged to the ledger is what makes the 3.4 and 0.8 terms real rather than bookkeeping."""),
    p(text: "**Addendum, what the entries this plan walks cost to resolve (2026-11-26, loyal-badger-240, engine [pre-entry] readings; the demand table and the cut arithmetic are recorded in gunb-ai/gunbc#17152's comments 7201610499 and 7201882159, that PR being closed unmerged on purpose).** The remote-build client entry resolves 906 modules in 68,193 ms at 3,663,224 KiB max_rss (shadow-gate run 45774944663 step 7), and 905 modules in 832,637 ms on a contended host. On the serving host, the serve request arm costs 898 files / 143,992 ms / 3,435,568 KiB against the probe front door's 150 files / 9,751 ms / 374,128 KiB -- both measured on one host, both in the body of gunb-ai/gunbc#17114. Two control-plane entries show the same shape of a whole closure paid for a narrow job: 'hostname converge dispatch admission' 1,585 files / 301,548 ms / 6,084,572 KiB (runs 45770097040 and 45773631715), and generated_artifact_gate main_wet_one 3,706 files / 1,391,228 ms / 13,336,092 KiB. Anyone timing a survey should also know the serving observe/converge step has a 15-minute ceiling (gunbc_ci_gunbc_run_resolve_step_timeout_minutes), and the resolve plus every ssh leg has to fit inside it."),
    p(text: "**Addendum, the census cause above is superseded (2026-11-26, crisp-pike-295, read-only: fleet-converge run 45762320308, job 139720737977).** The quoted text is real -- the log did say `unknown: user_work_scope: observed-bound arm did not admit (chain-unbounded)` -- but the cause attached to it above is wrong. The census leg's pre-wrap chain is the ssh session layer, distro-unbounded BY DESIGN, so the observed-bound arm declining it is CORRECT; the wrap into `gunbc-user-work.slice`, which carries the installed bounds (`gunbc.live_deploy.slice_bounds:304-308`), FIRED and the census ran to a complete answer; and that leg's exit 2 was the census's declared unknown mapping for a missing unit-end proof, a distinct root since closed in gunb-ai/gunbc#17154. What the text actually shows is the door's UNKNOWN arm composing its reason from RAW stderr (`remote_build_serving_converge.dag:1658`), where any trampoline diagnostic can masquerade as the census's answer. The row that carried the bounds premise is retitled and re-scoped to that defect -- `remote-build-census-unknown-reason-names-the-census-not-the-transport`, same identity, same three host edges, and its implementation is the assigned lane's, not this plan's. The sentence above is left standing because it is what the survey read at that head; this addendum is what the same reading says now."),
    h2(text: "5. Open questions for the operator"),
    ul(items: [
      li(text: "The CPU frequency cap on srv1, srv3 and srv4 (2.0 of 3.0 GHz; \"we slowed the cores on all computers\"): keep it as a standing decision, or lift it."),
      li(text: "The srv3 request held since 2026-11-25 12:46 (unit gunbc-compute-d6481839...): let it finish or stop it."),
    ]),
  ]
}

data remote_build_bandwidth_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly,
  slug: "remote-build-bandwidth",
  title: "Remote-build bandwidth, regrouped: every candidate serving host serves pinned compiles and claim runs end to end, with all blockers found at once by a read-only survey and fixed in layers",
  body: remote_build_bandwidth_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "Section 1 is achieved -- every candidate serving host answers a pinned compile and a pinned claim run read back at served=true with no hand cleanup -- and the items section 1 defers to the work-execution-redesign program have landed there; the plan then retires into that program.") },
}
