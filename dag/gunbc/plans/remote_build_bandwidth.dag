module gunbc.plans.remote_build_bandwidth

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetiresWhen, PlanIsAuthorityOnly }
import std.markdown { MarkdownBlock }
import gunbc.markdown_helpers { h2, p, li, ul, quote }

fn remote_build_bandwidth_body() -> List<MarkdownBlock> {
  [
    quote(blocks: [
      p(text: "**This plan is written as an intention** (`gunbc.design_argument::plans_are_intentions`): what the repository should become, why, and done-when. Its work items are roadmap nodes that name it through `gunbc.roadmap.roadmap_intention_binding`; this text does not list them, hold their status or order them in time."),
      p(text: "**Grounding:** `gunbc.design_ruling::remote_build_ssh_dispatch_is_an_admitted_scaffold`, `gunbc.design_ruling::hosted_ci_bridges_to_remote_builds_and_adopts_work_execution_redesign`, `gunbc.design_argument::selection_precedes_convergence`, `gunbc.design_argument::replacement_migration`, `gunbc.design_argument::consumption`, `gunbc.design_argument::conformance`."),
    ]),
    h2(text: "1. Intention"),
    p(text: "**What:** the required check and ordinary builds run on the fleet's serving hosts through the remote build, at the bandwidth the fleet can actually give, without anyone choosing a host by hand -- and every piece of that path either survives into the work-execution-redesign program or names the step of that program that deletes it."),
    p(text: "**Why (operator, 2026-11-21):** \"i need to get maximum remote build bandwidth asap, because we're fairly behind\", and then \"i'm trying to actually design this work - basically i'd like us to go through and actually plan out the work/dependencies as tasks\", with \"make sure everything lines up well with the fabric and existing codebase concerns\". The remote build reached its first served compile on 2026-11-21 (srv4); until then every compile ran on the hosted pool or the fixed runner slots while converged serving hosts sat unused. The cost displaced is hosted-pool and fixed-slot time for builds a serving host could take, and the operator's time spent choosing hosts and clearing stuck seats by hand."),
    p(text: "**Done when** (each is assessed against the tree or a host read unless marked as the operator's judgement):"),
    ul(items: [
      li(text: "Every host on the dispatch roster has served at least one pinned compile whose receipt reads back served, and no rostered host is admitted on a figure that was not read from it."),
      li(text: "The hosted-runner shadow gate is green at main end to end through the remote build, and the bridge node's first slice (one emitted_subject_build_rows label under a reservation sized from its measured profile) has an accepted event."),
      li(text: "The remote build's answer is a `product.fabric.execution::Receipt`, not a string, and its request states the work's `product.fabric.work::ExecutionRequirements`, so the work-execution-redesign's durable route can consume both unchanged."),
      li(text: "No host is placed for a request whose requirements its `gunbc.fabric.fabric_executor_class` row does not admit; a mixed-architecture roster cannot place work on the wrong architecture."),
      li(text: "Every divergence of the remote build from the fabric model is either removed or recorded as an integration concern naming the work-execution-redesign node that removes it."),
      li(text: "Operator's judgement: remote-build bandwidth is no longer the constraint on the operator's work."),
    ]),
    h2(text: "2. Audit against fabric and the work-execution-redesign program, read at main 7711690f3f5 (2026-11-21)"),
    p(text: "Design evidence, cited by symbol. Each mechanism is classified as using, re-implementing or bypassing the fabric authority that `gunbc.design_argument` `conformance_domains` names for its concern."),
    ul(items: [
      li(text: "**Host choice -- bypasses, by declared divergence.** `gunbc.compute.remote_build::remote_build_next_step` walks the dispatch roster `gunbc.compute.remote_build_hosts::remote_build_serving_hosts` in order, and the host pin (`remote_build_host_pin`, `remote_build_pinned_candidates`) narrows that walk to one host. No compute module imports `product.fabric.selection::select_supply`, `gunbc.fabric.fabric_control_plane::CellReservation` or `gunbc.fabric.fabric_executor_class`. The divergence is stated in the module header and admitted by `gunbc.design_ruling::remote_build_ssh_dispatch_is_an_admitted_scaffold`, whose dissolution is work-exec-2. Consequence for this plan: no new selection policy is built in the remote build; the one addition admitted is a requirements check against the executor-class authority, because a mixed-architecture roster needs it before work-exec-2 lands and the check is fabric's own join, so it survives."),
      li(text: "**Build seat and ledger -- uses.** The serving host's provider reserves through `gunbc.compute.host_capacity::compute_reserve_against`, which calls `gunbc.fabric.fabric_event_log::fabric_seat_acquire` with a `product.capacity.pool_events::SeatRequest` and holds a `product.capacity.lease::LeaseGrant`; release goes through `fabric_seat_release`. Pool sizing is the frozen carve (`gunbc.runner.runner_slot_desired::host_build_pool_reservation`). Conforms."),
      li(text: "**Request shape -- uses the operation, bypasses the requirements.** `gunbc.compute.remote_build::RemoteBuildOperation` maps one to one onto `gunbc.compute.work_request::WorkOperation`, but the request carries no `product.fabric.work::ExecutionRequirements`; only `SourceManifestRef` is taken from product.fabric.work. A work item closes this."),
      li(text: "**Attempt lifecycle and recovery -- parallel store.** `gunbc.compute.attempt_lifecycle::recovery_write_authorization` and `gunbc.compute.work_provider_local::compute_recover_attempt_in` keep the attempt slot in a compare-and-set file store beside the fabric event log; only the seat release returns through the log. `gunbc.compute.durable_attempt_controller` already joins attempt_lifecycle to `product.fabric.execution`, and no remote-build module imports it. Recorded as an integration concern whose home is work-exec-2's durable route; the serving converge's stale-seat recovery is admitted as bridge maintenance and dissolves with that route."),
      li(text: "**Receipt -- bypasses.** `gunbc.compute.remote_build::RemoteBuildHostAnswer` carries `HostServed { receipt: String }` and the client writes a file; `product.fabric.execution::Receipt` is not used. Per-claim verdicts must not be added to the string: a work item makes the answer a typed fabric receipt first, and the verdicts ride it, because work-exec-5 publishes the required verdict from an admitted receipt."),
      li(text: "**Workload sizing -- duplicate of work-exec-3.** The row workload-profiles-replace-seats restates what work-exec-3-automatic-sizing owns (grants from `gunbc.compute.work_class_grant` evidence instead of the seat); it is kept only as a child of that node so its comment citations resolve, not as remote-build work."),
      li(text: "**Warm target cache -- belongs to the materialization domain.** Reusing a host's previous target directory is a cache: `std.materialization_ladder` decides first whether the repetition is authored duplication, then whether a reuse obligation exists, then which provider discharges it (`gunbc.design_argument::demand_before_materialization`). The work item is homed there, not as a remote-build feature."),
    ]),
    p(text: "**Live evidence, 2026-11-21 (receipts held by the srv3/srv4 work item).** A compile of clean main pinned to srv4 read back served (exit 0, about 24 minutes wall, client peak about 3.4 GB), building in the serving account's own scratch root. The gate label //gunbc/instruments:v2-native-cli pinned to srv4 was admitted and ledger-reserved, ran, and answered work-failed with host exit code 101 (a Rust panic) while the same label is green in CI: the subject fails in the remote subject environment, and only a host-side log read can say why, which no modelled read route fetches today. The same run's first `remote-build-v1 probe` leg failed with exit 6 and the client continued to the next leg, so a probe failure is absorbed without a typed record (`gunbc.design_argument::fail_closed`). The answer path also lists a per-class grant-exceeded counter the receipt does not carry."),
    h2(text: "3. The work-execution-redesign program, read the same day"),
    ul(items: [
      li(text: "**A real ordering conflict, stated as an open question.** work-exec-4-local-work-cutover deletes the direct `compute_provide` launch and `ComputeBuildPool`, and precedes work-exec-5-ci-verdict-from-receipt; but the remote build's serve leg calls `compute_provide` and, by `gunbc.design_ruling::hosted_ci_bridges_to_remote_builds_and_adopts_work_execution_redesign`, carries the required check until the bridge dissolves into work-exec-2 and work-exec-5. Either the serve leg moves onto the durable route by work-exec-4, or work-exec-4 cannot delete the launch while the bridge carries the check."),
      li(text: "**A dangling carrier.** work-exec-1-placement-backend-selection carries `dag/gunbc/plans/durable_work_handoff.dag`, which no longer exists at main."),
      li(text: "**A question the bridge's evidence now bears on.** work-exec-1 selects a placement backend by spike (k3s with Kueue first, else Nomad, else gunbc's own allocator). The bridge has since served a compile through gunbc's own seat ledger and fabric event log; whether that changes which candidate the spike tries first is the operator's call, not this plan's."),
      li(text: "**Shadow evidence feeds work-exec-5 by text, not by edge.** work-exec-5's first slice is a shadow job on every pull request, which is what the hosted-runner shadow gate is; the ruling keeps dissolution out of the edge set, so the link is stated here and in the nodes' text only."),
    ]),
    h2(text: "4. Open questions for the operator"),
    ul(items: [
      li(text: "The work-exec-4 versus bridge ordering in section 3."),
      li(text: "Which placement candidate work-exec-1 tries first, given section 3."),
      li(text: "bobo's tailnet join route (self-join as a runner, the modelled subject join of PR 16820 behind the fleet-converge budget question, or by hand as with butch)."),
      li(text: "The fleet-converge workflow regeneration's derived time-budget raise, which blocks the parked runner rows and any new fleet-converge mode; recorded as its own roadmap row, not answered here."),
    ]),
  ]
}

data remote_build_bandwidth_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly,
  slug: "remote-build-bandwidth",
  title: "Remote-build bandwidth: the fleet's serving hosts carry builds and the required check, typed against fabric, until the work-execution-redesign route replaces the bridge",
  body: remote_build_bandwidth_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "Section 1 is achieved and remote-build-ci-bridge has an accepted event; the plan then retires with the bridge into work-exec-2 and work-exec-5.") },
}
