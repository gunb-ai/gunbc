module gunbc.plans.harness_session_lifecycle

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetiresWhen, PlanIsAuthorityOnly }
import std.markdown { MarkdownBlock }
import gunbc.plans.md_helpers { p }
import gunbc.design_ruling { project_documentation_projections_are_not_checkout_artifacts }

fn harness_session_lifecycle_body() -> List<MarkdownBlock> {
  [
    p(text: "Goal: one durable conversation per dispatched attempt, continuing through supervision and revision until delivery, explicit stop or unrecoverable fault. Operator rulings 2026-10-11: turn=model reply/request/response/tools; round=stretch between supervision observations; boundaries are transparent; obligations are event-driven, never assigned to the retiring belt. This replaces only restart/continuation realization from harness-work-lifecycle (deleted fa44b981025), not its absent resource/delivery/conservation/frontend authority. factory/harness-recursive-alignment citations remain a separate repair."),
    p(text: "Evidence: srv1 2026-10-10/11 findings F61/F64/F65/F68/F71/F72/F73/F74/F75. Restart-per-stretch lost uncommitted work, killed jobs, orphaned scarce reservations and relearned context; countdowns distorted behavior. Capped continuation supervisors could neither change budget/brief nor verify by execution, and retained units blocked dispatch. provider_execution_fold_event conflated checkpoint/budget exhaustion; AlignmentCadenceState/checkpoint planning remained test-only. These are historical causes, not current state claims."),
    p(text: "Terminology: session is durable transcript, process replaceable; attempt owns one worktree/branch/session. Existing harness_round_budget_steps supplies cadence (recorded default 40 turns). Rename old round/turn inversions with each affected slice; do not keep two meanings locally."),
    p(text: "At a round boundary, after handling the response and before another request, persist supervision observation (turns, diff, receipts) and synchronously await a bounded alignment verdict. Append nothing while waiting. Exactly one action: aligned→unchanged next turn; misaligned→actionable steer in the same conversation; extremely misaligned→supervisor decision while paused; catastrophic→stop. No restart, countdown or killed background process. Run no check whose answer cannot affect the next turn; broader supervision only when needed."),
    p(text: "Hand-in is the submission-file event naming an immutable candidate. Worker makes no calls/mutations while awaiting acceptance. Trigger real verification, package-wide acceptance and review immediately, without a turn cap or periodic pass. The worker hands in when its node oracle holds; supervisor judgment is not verification. Review/audit changes become a steer to the same session; revised hand-in names a new candidate and results qualify only the candidate checked. Acceptance reaches existing delivery handoff. Process exit never establishes completed work."),
    p(text: "Keep command/request bounds, compaction, seat bind/release, exit/unit lifecycle, FreshFromBase and event-triggered review/audit/publication. A hung command returns control at harness_default_duration_limit_seconds; background/poll for longer waits. Allowance exhaustion triggers alignment renewal or stop, not a new session; resource/authorization authorities remain independent."),
    p(text: "Recovery requires durable results for every tool call in the last response, or no tools. Current last-request storage can precede completed effects and failed writes can report preparation; never blindly replay it or substitute a fresh conversation. Interrupted effects leave recovery-needed until outcomes are established. One unit per attempt is collected on every exit using evidence; resources cannot outlive owners (convergence_coverage_program cc-guaranteed-cleanup). Relaunch needs invocation-keyed exit lookup: roadmap_attempt_exit_spool’s recorded invocation must distinguish exits instead of node/attempt/role ambiguity."),
    p(text: "S1 deletes restart machinery in the same change: harness_turn_checkpoint_due/harness_event_alignment_checkpoint_due/TurnAlignmentCheckpointDue and exit-3; RoundsEndInAlignmentCheck/RoundsRemaining; HarnessAlignmentCheckpointDue/fold; ContinueFromAttempt, continuation_turn_cap/ContinuationTurnRead/continuation_continue_next_turn/continuation_brief_prefix and stretch arms; belt_continuation_carry/belt_attempt_state_initialize_after_carry/belt_origin_predecessor_key, attempt_origin_base_ref continuation branch, dispatch_continuation_alignment_preamble, continuation-turn file and cross-attempt alignment binding; stretch-keyed AttemptSupervisorRole/MeteredSupervisor and -tN units. Reuse roadmap_alignment verdicts if adequate; no first-version adaptive cadence/escalation scoring."),
    p(text: "S2 implements the live waiting/hand-in/review loop without resume. S3 adds validated recovery only for observed failures, proven by induced kill and deploy across a live session. S4 renames terminology alongside behavior, not as a delaying global pass."),
    p(text: "First milestone: one real srv1 lab development task, no operator repair, crosses a round with conversation/worktree/test intact; aligned continuation leaves no boundary text; deliberate useful steer arrives; hand-in executes acceptance/review; requested revision continues the same session to acceptance. Red controls: killed background work at ordinary boundary, aligned boundary text, or resume with unrecorded tool effects. Each slice needs live evidence; retirement requires S1–S4 at their owning modules."),
  ]
}

data harness_session_lifecycle_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly { ruling: project_documentation_projections_are_not_checkout_artifacts },
  slug: "harness-session-lifecycle",
  title: "Harness session lifecycle: one durable session per attempt, supervision as a transparent cadence",
  body: harness_session_lifecycle_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "Delete this document when slices S1 to S4 are realized and their rules are carried by the harness and roadmap modules' own declarations and witnesses.") },
}
