        row(cells: [cell(text: "worktree_claim_close_recorded"), cell(text: "Two arms of worktree_claim_ensure_one"), cell(text: "Both close-only and remove/readback/close paths must be covered.")]),
        row(cells: [cell(text: "worktree_claim_ensure_one"), cell(text: "worktree_claim_ensure_pass_at"), cell(text: "One internal call; preserve re-derived path and host-observation safeguards.")]),
