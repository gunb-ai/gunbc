        row(cells: [cell(text: "Identity projections"), cell(text: "fabric_writer_identity_observe::\{FabricWriterIdentityReceipt, fabric_writer_identity_observe_wet, fabric_writer_identity_receipt_text, fabric_writer_identity_ground, fabric_writer_identity_reading_grounds_roster\}; fabric_writer_roster::\{recorded_binding, observed_login, fabric_served_writer_roster_of\}"), cell(text: "R2 does not establish a tailnet principal. FabricIdentityUnproxied currently describes local-file access; reusing that explanation for R2 would misstate the observation.")]),
        row(cells: [cell(text: "FabricPut direct arms"), cell(text: "durable_cas_fabric_storage::cas_slot_advance; fabric_event_log::event_log_append_with; fabric_source_snapshot::\{snapshot_store_inclusion, capture_source_snapshot\}; fabric_storage_client::fabric_storage_put; fabric_storage_file_store::fabric_storage_put_from_create; fabric_storage_serve::fabric_served_storage_respond; fabric_storage_wire::\{fabric_storage_wire_put, fabric_storage_unwire_put\}; gunbc.instruments.source_snapshot_handoff::\{escaping_entry_manifest, duplicate_entry_manifest\}"), cell(text: "Update producers, codecs, adapters and consumers in the same contract-changing delivery. Preserve unknown publication and custody without mechanically turning an enclosing transaction into an unknown head update.")]),
        row(cells: [cell(text: "FabricHeadAdvance direct arms"), cell(text: "durable_cas_fabric_storage::cas_slot_advance; fabric_event_log::event_log_append_with; fabric_storage_client::fabric_storage_advance; fabric_storage_file_store::fabric_storage_file_advance; fabric_storage_r2_head::r2_head_fabric_advance; fabric_storage_serve::fabric_served_storage_respond; fabric_storage_wire::\{fabric_storage_wire_advance, fabric_storage_unwire_advance\}; std.checkpointed_workspace::workspace_commit_classify"), cell(text: "Conditional compatibility scope if the head outcome changes. The checkpoint classifier is a real consumer; preserve request/plan binding and coverage advancement.")]),
        row(cells: [cell(text: "FabricObjectGet direct arms"), cell(text: "fabric_object_r2::\{fabric_object_r2_read_of, get_fabric_object_r2, fabric_object_r2_readback_verdict\}; fabric_source_snapshot::\{materialize_source_snapshot, snapshot_materialize_entry_links, snapshot_materialize_step\}; fabric_storage_file_store::\{closure_step, fabric_storage_file_advance, fabric_storage_file_put, fabric_storage_object_from_read, fabric_storage_put_from_create\}; workspace_checkpoint_instrument::workspace_stored_entry_read"), cell(text: "Carry the existing verified-object result through the shared route; retain missing/corrupt/refused distinctions and staging custody.")]),
        row(cells: [cell(text: "Forwarding and served route"), cell(text: "fabric_storage_file_store::\{fabric_storage_file_put, fabric_storage_file_get\}; fabric_object_r2::\{FabricObjectR2Get, fabric_object_r2_put_verdict\}; fabric_storage_protocol::fabric_storage_respond; fabric_storage_client::\{door_post, served_post\}; state-auth/serve sites in A"), cell(text: "Signature/forwarding changes are part of the same package. Get preserves the selected binding's admission and namespace. Protected-state get uses its existing signature and separate private root; public served, host-local and R2 bindings retain their respective access routes.")]),
        row(cells: [cell(text: "Source-snapshot concrete-root operands"), cell(text: "fabric_source_snapshot::\{snapshot_store_inclusion, snapshot_capture_step, capture_source_snapshot, snapshot_materialize_entry_links, snapshot_materialize_entry, snapshot_materialize_step, materialize_source_snapshot\}"), cell(text: "Replace all seven concrete dependencies. Reuse SnapshotCaptureRefusal, SnapshotCapture, SnapshotCaptureAcc, snapshot_capture_refuse and corresponding SnapshotMaterializeRefusal, SnapshotMaterialization, SnapshotMaterializeAcc, snapshot_materialize_refuse as the local result-plumbing sites.")]),
        row(cells: [cell(text: "Only external snapshot code consumer"), cell(text: "gunbc.instruments.source_snapshot_handoff::\{SnapshotWorkspace, prepare_snapshot_workspace, capture_for_scenario, capture_refusal_wire, snapshot_refusal_wire, materialize_refused_for_wrong_reason, run_executed_request_scenario, run_corrupted_bytes_scenario, run_missing_object_scenario, run_composition_mismatch_scenario, run_escaping_path_scenario, run_duplicate_path_scenario, escaping_entry_manifest, duplicate_entry_manifest, authored_object_path, run_snapshot_scenario, source_snapshot_handoff\}"), cell(text: "Ordinary capture/materialization loses concrete file access. Deliberate corruption/hole fixtures remain isolated file-provider controls, not raw-path overrides on normal selection.")]),
        row(cells: [cell(text: "Checkpoint composition"), cell(text: "workspace_checkpoint_instrument::workspace_instrument_commit_admitted -> fabric_storage_r2_head::r2_head_fabric_advance -> std.checkpointed_workspace::workspace_commit_classify; workspace_checkpoint_instrument::workspace_stored_entry_read"), cell(text: "Keep object and head authority coherent. Later backend migration is distinct from immediate compatibility with a changed result.")]),
        row(cells: [cell(text: "Default protected-state binding callers"), cell(text: "gunbc.live_deploy.apply::live_deploy_apply_admitted_via_transport; gunbc.roadmap.roadmap_runtime_plan::roadmap_plan_projection; gunbc.roadmap.roadmap_serve::serve_issue_create_response_over; gunbc.roadmap.workspace_allocation_routes::\{workspace_route_create, workspace_route_get, workspace_route_list, workspace_route_release\}; gunbc.runner.runner_microvm_slot_controller::workspace_slot_dispatch_launch; gunbc.workspace_allocation_dispatch::\{workspace_allocation_prepare, workspace_allocation_readback_cli, workspace_allocation_selected, workspace_publish_preparation_wait\}; gunbc.workspace_host_offer_observe::workspace_observe_slot_offer; gunbc.workspace_operator_request::\{workspace_operator_observe_wet, workspace_operator_release_wet, workspace_operator_request_wet\}"), cell(text: "Retain fabric_state_storage_binding's existing protected mutable-state authority during the object pilot. Changing defaults globally would reopen these workflows and their state-continuity obligations.")]),
