data logical_work_realization_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly { ruling: project_documentation_projections_are_not_checkout_artifacts },
  slug: "logical-work-realization",
  title: "Fabric storage: real arbitrage and the repo-wide consumer migration",
  body: logical_work_realization_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "Retire when the repo-wide inventory populations marked migrate (snapshot S, all-six lifecycle and claims C2, and M1-M4), shared binding/result consumers F, prerequisite producers and callers B1/B2, and process-root selection bindings A execute through their one fabric authority. V must close every inventory row with the replacement doctrine terminal receipt: exact new consumers and retained/retired evidence, zero old root consumers, undispositioned consumers, uncovered surviving consumers, production X-to-Y adapters, fallbacks, migration flags and unreconciled identities. Real cited workload cost and applicable latency evidence must settle three-candidate arbitrage; the unchanged snapshot caller must execute in the second isolated deployment with independently verified fixture release. Backend/platform exclusions retain their declared reason and owner. The root/claim/readiness ledger dispositions and all named controls must have executed handbacks at the implementation revision. General compiler inference and approval workflow consolidation remain their separately named programs; no invented readings, unknown deployed-state population or hidden old route can discharge this retirement.") },
}
