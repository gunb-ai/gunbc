module gunbc.plans.logical_work_realization

import std.dissolution { unbound_dissolution }
import std.types { List }
import std.markdown { MarkdownBlock, CodeBlock, TableBlock, AlignNone }
import gunbc.plan { Plan, PlanRetiresWhen, PlanIsAuthorityOnly }
import gunbc.plans.md_helpers { h2, h3, p, li, ul, ol, cell, row }
import gunbc.design_ruling { project_documentation_projections_are_not_checkout_artifacts }

fn logical_work_realization_body() -> List<MarkdownBlock> {
  [
    p(text: "Proposal for review, revised 2026-10-23. This is a design and repo-wide migration inventory, not a runtime change or authorization to deploy. The implementation target is one fabric storage interface with contract-constrained, real-price arbitrage across this host's disk, a disk served from another host, and R2. There are no out-of-repository callers in this migration's declared population. Missing evidence is an explicit work item, never an invented default."),
    h2(text: "1. Consumer interface and authority"),
    p(text: "The consumer describes its logical operation and irreducible data. Fabric supplies the selected realization and its prerequisite chain from the deployment context. A feature should not choose a directory, bucket, credential route or setup enrollment. This gives ordinary local work a local realization when it meets the contract and wins the decision; cross-machine storage is not a prerequisite of using fabric."),
    CodeBlock { code: "// Desired replacement of an existing operation, not a second API:\nworktree_claim_record_before_add(claim: claim)\n\n// Implementable internal dependency before omitted-operand completion exists:\ncapture_source_snapshot(store: FabricStorageBinding,\n  composition: SourceComposition, inclusions: List<SnapshotInclusion>)\nmaterialize_source_snapshot(store: FabricStorageBinding,\n  manifest: FabricObjectRef, workspace: ProviderWorkspace,\n  expected: SourceComposition)\n\n// Existing no-argument instrument entrance stays:\nsource_snapshot_handoff()" },
    p(text: "The first spelling replaces worktree_claim_record_before_add(root, claim): it moves root to the realized dependency; it does not declare implicit completion already implemented. The internal binding is explicit until the existing compiler completion program can supply it. Ordinary consumers inherit one root-owned requirement and valuation declaration. A missing mandatory requirement is a residual naming its layer and authority; an explicit declaration of no additional performance bound is distinct from a missing declaration. There is no existing complete storage-SLO carrier to cite: package A must model that product-specific meaning before wiring selection."),
    TableBlock {
      header: row(cells: [cell(text: "Layer"), cell(text: "Owns"), cell(text: "Does not ask the feature author to repeat")]),
      alignments: [AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "Consumer"), cell(text: "Logical namespace, operation, data, consistency/retention/sharing/confidentiality requirements"), cell(text: "Host paths, R2 purpose, credentials, transport or physical directory setup")]),
        row(cells: [cell(text: "Fabric"), cell(text: "Candidate roster, typed eligibility, workload and SLO projection, cost/latency comparison, SelectionReceipt, continuity of selected mutable authority"), cell(text: "A backend preference or a second feature-specific selector")]),
        row(cells: [cell(text: "Backend"), cell(text: "Realization of object/head/list/history/hold contracts; owned directories or R2 allocation, authorization and observed readiness"), cell(text: "A second logical namespace or policy")]),
        row(cells: [cell(text: "Transport"), cell(text: "Local calls, admitted local door/socket or HTTPS request/response and uncertainty"), cell(text: "Which backend should win, or whether acknowledgement proves storage convergence")]),
      ],
    },
    p(text: "The storage interface remains std.fabric_storage; selection remains std.decision with std.pareto. The metadata plane holds structured values and conditional heads; the blob plane carries opaque admitted bytes. These distinctions survive without assigning either plane a permanently fixed placement. std.materialization_ladder and std.materialization_provider still govern immutable reuse; mutable keyed state does not become memoizable. Broader implicit reads/writes/computation remain the compiler program's direction, not this plan's completion condition."),
    p(text: "This plan supersedes the fixed target placement and fixed R2-tier policy in docs/plans/fabric-storage.md. It preserves that document's correctness and access obligations and its historical account of the incumbent deployment. One linearization point per head, durability and confidentiality become eligibility constraints. No backend has a predetermined role. The single governor remains v2-compiler-architecture for this storage-consumer completion slice; gunbc.plans.ensure_closure_design and the fabric authorities remain consumed domain owners, not competing governors."),
    h2(text: "2. Verified fabric today"),
    p(text: "Baseline: source at 7daaddd1f0ce99734e1ddb57138313701455c758, inspected 2026-10-23. These are verified source behaviors and declared deployment paths, not a live inventory of records on the machines. Appendix rows distinguish declared locations from unobserved live populations."),
    TableBlock {
      header: row(cells: [cell(text: "Current behavior"), cell(text: "Source authority"), cell(text: "Migration consequence and owner")]),
      alignments: [AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "The placed store is on the prod-role host; public metadata uses its local door/socket or remote HTTPS. Protected mutable state uses signed HTTPS even on that host. Separately admitted local bindings include compute_capacity_store. No cost/latency selection runs."), cell(text: "fabric_storage_placement, fabric_storage_binding; gunbc.compute.host_capacity"), cell(text: "A replaces fixed target policy and supplies the binding at each inventoried process root; preserve incumbent authority until a deliberate state cut.")]),
        row(cells: [cell(text: "FabricStorageBinding has LocalFiles, DoorSocket, Served, Unplaced and Refused forms. Client operations are put, head, advance and closure; no client get, list or delete."), cell(text: "fabric_storage_client; std.fabric_storage"), cell(text: "F adds get and enumeration once, extends bindings and all closed result matches, and models narrowly authorized fixture release.")]),
        row(cells: [cell(text: "R2 object and conditional-head implementations exist outside the shared binding. Checkpoints, blob cache and origin transfer use R2 directly."), cell(text: "fabric_object_r2, fabric_storage_r2_head, r2_staged_transfer and its consumers"), cell(text: "F makes an eligible realization; M3 cuts direct consumers onto the same authority while preserving byte/provenance/custody distinctions.")]),
        row(cells: [cell(text: "/state uses one writer MAC for every operation, including reads; it is not a split read/write credential protocol."), cell(text: "fabric_storage_serve and fabric_storage_client signed requests"), cell(text: "F preserves current admission and types any required scoped capability before changing it. A cheap route cannot bypass it.")]),
        row(cells: [cell(text: "served_reply_from maps a nonzero curl exit to FabricStoreUnreachable and a 5xx to FabricReplyUndecodable. A mutation may have committed before either result."), cell(text: "fabric_storage_client::served_reply_from"), cell(text: "F repairs uncertain completion in the served route as well as R2, and owns every affected result consumer.")]),
        row(cells: [cell(text: "fabric_storage_file_root_ensure reports readiness from mkdir success, without independent directory ownership/mode/readback."), cell(text: "fabric_storage_file_store"), cell(text: "B1 replaces this readiness producer and all production and 15 test-module callers, using owned_directory observation and readback.")]),
        row(cells: [cell(text: "Clean object put/get checks a 64-bit structural reference, not exact preimage equality or a cryptographic commitment."), cell(text: "std.fabric_storage; fabric_storage_file_store; fabric_object_r2"), cell(text: "Preserve the current check honestly; do not retire fabric_object_identity_is_a_structural_locator. Confidentiality/integrity eligibility cannot assume cryptographic identity.")]),
        row(cells: [cell(text: "File heads retain generation history. R2 heads replace the object in place, retain no equivalent generation line, and lack the file path's missing-object refusal."), cell(text: "fabric_storage_file_store; fabric_storage_r2_head"), cell(text: "F defines and realizes retained-history and target-existence semantics before history-dependent cohorts admit R2.")]),
        row(cells: [cell(text: "Bucket readback exists only as R2Buckets.Get inside r2_bucket_ensure, using the bucket-admin token. R2PurposeEnsureOutcome carries line/held; FabricBlobTargetReady is configuration resolution."), cell(text: "gunbc.cloudflare.r2_bucket_ensure; fabric_blob_r2"), cell(text: "B2 keeps admin observation at the privileged root and supplies scoped evidence, or models a non-admin probe. Neither existing result is readiness proof for ordinary consumers.")]),
      ],
    },
    h2(text: "3. Real arbitrage and service requirements"),
    p(text: "A root-owned fabric requirement names subject/namespace, operations, sharing/reachability, availability/failure domain, durability, consistency, retention and confidentiality. A workload names byte/object counts, read/write/list mix, holding interval, origin/destination, concurrency and warm/cold conditions. A service-level requirement adds metric, units, statistic, population/window, bound, accepted evidence and consequence. Package A owns declaring the initial workload and policy by symbol; until those declarations exist there is no hidden inherited SLO. Feature authors inherit them, with a justified stronger requirement at the owning scope when needed."),
    p(text: "Each candidate receives an established-eligible, established-excluded or unresolved disposition with typed reasons. Sharing and reachability include whether the store is reachable whenever this host launches work, not just whether two hosts can access it once. Failure-domain, durability, CAS/one-linearization-point, retention, confidentiality and operation-support facts are checked before ranking. Existing mutable state adds authority continuity. A conclusive incompatibility excludes the candidate and records why. Missing eligibility evidence returns SelectionNeedsEvidence; it must not silently remove a possibly better candidate. The disposition roster closes against the root's complete candidate roster."),
    p(text: "std.decision HardConstraint works only on a funded numeric axis and does not validate evidence standing. It is not an encoding for authorization, consistency or sharing. Package A provides typed fabric eligibility before projecting numeric readings; no arbitrary Boolean cost axes. Cost and latency are the ranked axes. select_realization/ValuedObjective and std.pareto supply the decision algebra; no list-order priority or backend preference substitutes for a policy. Unknown numeric evidence yields SelectionNeedsEvidence; incomparable survivors without an applicable valuation yield SelectionNeedsPolicy."),
    p(text: "The closure must be real: ObjectiveTerm grounds of TranscribedUncited, or missing vendor-documented/fleet-observed coupling and sensitivity evidence, defer the subject. merge_deferred_into_pick then changes SelectedWithin into SelectionNeedsEvidence. Three numbers alone cannot settle a choice. AxisReading.interval_micro has no workload, currency, statistic or provenance fields; the domain producer validates those and retains their evidence before projection. Preserve justified intervals and rounding, including rate fractions smaller than one micro-USD."),
    p(text: "SelectionReceipt scope equality compares evidence_snapshot by DeclarationRef name, not by reading values. The first delivery uses immutable corpus-declared reading sets with a distinct evidence identity for every changed price, applicability assumption, workload or observation. A mutable current_prices declaration is insufficient. Package A owns this identity discipline and its stale-receipt control. Runtime-changing observations require the decision authority's corresponding identity contract before such a profile is enabled."),
    h3(text: "Cited prices and the honest gaps"),
    p(text: "Sources retrieved 2026-10-23. These are real source inputs, not invented examples or a claim about the fleet's current bill."),
    TableBlock {
      header: row(cells: [cell(text: "Source input"), cell(text: "Published amount"), cell(text: "Applicability obligation")]),
      alignments: [AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "Cloudflare R2 Standard stored capacity"), cell(text: "USD 0.015 per GB-month"), cell(text: "Holding interval, encoded stored bytes, average daily peaks, account baseline and applicable storage class.")]),
        row(cells: [cell(text: "R2 Standard Class A"), cell(text: "USD 4.50 per million requests"), cell(text: "Derive puts/lists from the actual operation graph, including index/history publication.")]),
        row(cells: [cell(text: "R2 Standard Class B"), cell(text: "USD 0.36 per million requests"), cell(text: "Include independent gets/heads/readback; do not round each fractional-micro request down to zero.")]),
        row(cells: [cell(text: "R2 direct egress"), cell(text: "No R2 egress charge"), cell(text: "Account for any other metered services and host/transport costs that the route actually uses.")]),
        row(cells: [cell(text: "Hetzner 22 TB SATA Enterprise add-on"), cell(text: "USD 43/month or EUR 36/month, excluding VAT"), cell(text: "Real market quote, subject to server/location availability; not evidence of srv1's invoice.")]),
        row(cells: [cell(text: "Hetzner 1 TB NVMe SSD add-on"), cell(text: "USD 36/month or EUR 30/month, excluding VAT"), cell(text: "Whole device rental; usable capacity, reserve, replication and shared host costs still need derivation.")]),
      ],
    },
    p(text: "[Cloudflare R2 pricing](https://developers.cloudflare.com/r2/pricing/) supplies rates, Standard monthly free allowances and billing-unit rounding. [R2 limits](https://developers.cloudflare.com/r2/platform/limits/) defines GB as 10^9 bytes. [Hetzner dedicated-server add-ons](https://docs.hetzner.com/robot/dedicated-server/dedicated-server-hardware/price-server-addons/) supplies the disk quotes. A workload does not receive a fresh account-level allowance on every operation. Incremental invoice cost is the account baseline with and without that workload; a linear rate-derived estimate must retain its standing. Package A reuses existing measure/currency/time and rate shapes and updates upstream-owned pricing facts, not a second universal price catalog."),
    p(text: "For the actual host disks, package B1 obtains installed-device identity and acquisition/rental evidence or an explicitly applicable market quote; package A declares the cost horizon and allocation. Include relevant amortization, useful capacity, retention, energy, host service, transport, replication, setup and admitted migration costs without double counting. An idle disk may have zero incremental rental cash payment under a declared horizon; that is one term, not zero total cost or zero latency. Missing terms remain evidence needed."),
    p(text: "No applicable numeric end-to-end latency reading for the three actual routes was established in this audit. [Cloudflare R2 architecture](https://developers.cloudflare.com/r2/how-r2-works/) makes geography, origin and access pattern relevant; a vendor result for a different upload workload is not our readback SLO. std.cache_interface::read_latency_cost's fixed locality-class numbers are not measurements. B1/B2 must produce retained, workload-specific local/served/R2 observations with sample count/window, concurrency/cache conditions and failures/timeouts. A admits those through the existing observed-receipt authority or applicable vendor evidence. Until this exists, the funded latency axis correctly prevents a successful choice. This is a prerequisite to the pilot's acceptance, not deferred production metering."),
    h2(text: "4. One fabric contract, complete for the migrating cohorts"),
    p(text: "The following are modeling obligations in existing authorities, not declarations that these APIs already exist. Package F owns their design and implementation as one shared contract, including wire results and the local, served and R2 realizations. Consumer packages own their domain projection and cutover; they do not each invent an enumeration, history or uncertainty protocol."),
    TableBlock {
      header: row(cells: [cell(text: "Operation or boundary"), cell(text: "Required contract and refusal behavior"), cell(text: "Existing authority and dependency")]),
      alignments: [AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "Object put/get"), cell(text: "Immutable object address, object-before-head publication, independent readback; preserve absent, corrupt, inaccessible and unresolved publication separately. Get-by-ref crosses client and served route without inventing a head."), cell(text: "std.fabric_storage::FabricObjectGet/FabricPut; existing file get and get_fabric_object_r2.")]),
        row(cells: [cell(text: "Conditional head / CAS"), cell(text: "Create-only and expected-generation/ref updates, one linearization point per head, lost race distinct from unknown completion; refuse a head target that is absent or corrupt."), cell(text: "FabricHeadExpectation/FabricHeadAdvance; std.durable_compare_and_set; r2_head_advance_plan PutIfAbsent/PutIfMatch and R2HeadCasAdmitted.")]),
        row(cells: [cell(text: "Namespace enumeration"), cell(text: "One fabric-owned namespace-scoped key listing. A complete result identifies scope and scan evidence; listing/subject/access refusal is never empty success. No key committed before the pass begins may be silently omitted. Concurrent additions may be picked up by the next pass; per-record reads/updates retain their own race semantics."), cell(text: "Replaces all six cas_slot_keys consumers together at their respective root cuts. F owns an index or backend listing realization and its completeness evidence; FabricClosureRead is not listing.")]),
        row(cells: [cell(text: "Retained history"), cell(text: "Preserve generation numbers, payloads and required old generations, including approval_store_receipt's generation-1 read. An explicit retention policy may retire history only with a disposition, never incidentally by switching to R2."), cell(text: "File generation line is the baseline. F supplies a backend-independent immutable history representation and publication ordering; R2 head overwrite alone is ineligible.")]),
        row(cells: [cell(text: "Unknown completion"), cell(text: "A mutation that may have been sent yields an unresolved result bound to the attempted subject/expected state and request identity. Observe before retry; distinguish observed winner, observed noncommit/lost race and still unknown. No success or definite absence is minted by transport failure."), cell(text: "F repairs served_reply_from and R2 publication, carries outcomes through wire/client/domain matches, and preserves staging custody until resolved.")]),
        row(cells: [cell(text: "Uniform typed refusals"), cell(text: "Same semantic corruption, missing object, denied authority, bad scope, unavailable allocation and absent credential have compatible typed causes across backends. Presentation detail is additional, not the only carrier."), cell(text: "File FabricObjectCorrupt vs R2 FabricReplyUndecodable and R2 detail-only allocation/credential failures are concrete cut sites.")]),
        row(cells: [cell(text: "Logical retirement / revocation"), cell(text: "Conditional tombstone or closed-state publication preserves revocation, consumed-once transactions and audit semantics. Physical release follows an explicitly admitted retention obligation; no generic delete masquerades as secure erase or successful revocation."), cell(text: "F models the shared operation/result; M1/M4 cut auth/session and other record consumers.")]),
        row(cells: [cell(text: "Holds / leases"), cell(text: "Keep durable holds and temporal leases distinct. std.durable_exclusive_hold has no deadline/clock: recovery needs holder-bound, generation-bound observed death. Temporal leases additionally carry their declared time law; expiry alone cannot revoke an already-running stale actor. Ownership/revision and applicable fencing guard each protected effect; neither is a last-writer-wins object."), cell(text: "std.durable_exclusive_hold, std.temporal_effect::HeldLease and all hold consumers; F models the shared contract and M2 moves the complete cohorts.")]),
        row(cells: [cell(text: "Opaque blob / materialization"), cell(text: "Preserve the blob plane's byte/provenance/integrity/custody contract and immutable result identity. Metadata NonEmptyStr payloads are not a substitute for arbitrary bytes or a sealed content digest."), cell(text: "Existing fabric blob, staged transfer, source snapshot, local materialization authorities; M3 consumes F.")]),
        row(cells: [cell(text: "Fixture release"), cell(text: "A separately admitted test purpose/namespace with a bounded lifetime and a root-owned release capability. Release evidence includes independent absence and outstanding custody; ordinary durable consumers gain no general delete authority."), cell(text: "F provides the scoped release contract; B2 supplies its R2 realization; S proves cleanup. The shared fabric-workspace history bucket is excluded from the pilot.")]),
      ],
    },
    p(text: "For enumeration, the simplest admissible design is a retained namespace key registry whose registration precedes first value publication; a registered-but-absent key is harmless, a committed-but-unregistered key is not. Deletion/tombstone policy cannot remove a still-recoverable key from the registry. F must bind registry scope and observation to the same authority as the values and demonstrate recovery across interruption. A different backend implementation is acceptable only if it establishes this contract. Existing per-key heads remain conditional authorities; listing is not a claim of atomic multi-key transactions."),
    p(text: "History and leases are requirements, not mandatory support by every candidate. A backend lacking the necessary capability is excluded before ranking for that cohort. Object-only snapshot work can proceed once its smaller contract is complete; it cannot be cited as proof of claim or hold compatibility. No rollout may preserve an X-to-Y adapter to conceal an incomplete fabric contract."),
    h2(text: "5. Prerequisites and the selection-to-effect connection"),
    p(text: "Use gunbc.host_convergence_protocol's canonical composition: LayerSelect, LayerObserveAssess, LayerEnsureAdapter and LayerReadback. HostEffectDomainProjection and inspect_via_host_effect_projection already compose observation/assessment; host_effect_decide_apply_frontier explicitly awaits the fleet apply-side consumer. This plan consumes that home. It does not claim a consumed generic SelectionReceipt-to-effect runner already exists or create a competing shared cycle. std.goal_assessment's effectful frontier remains tied to gunbc.fleet.fleet_converge_plan; gunbc.plans.convergence_coverage_program does not mint it ahead of that trigger."),
    p(text: "For this storage domain, the selected binding must actually be the operand of the effect. Reuse gunbc.ensure and the existing authorized backend ensures, followed by independent readback. The domain's construction boundary must carry the selected scope and admission into the request and bind its response to that request. A pure fold over a supplied response cannot prove an effect never preceded admission. gunbc#14757's confined phase tokens are a domain precedent, not a new shared authority."),
    p(text: "Observe each prerequisite with EnsureObserveOnly, EnsureObservation and ensure_observation_as_attempt; compose through std.goal_assessment::inspect_goal/assess_by_deviations_and_unknowns. A fabric product goal and its typed component evidence establish GoalSatisfied only when every selected-backend prerequisite was observed. GoalDiverged, GoalIndeterminate and GoalAssessmentRefused retain their meanings; observer refusal stays outside assessment. The bounded first goal is corpus-declared. Runtime-changing goals need the existing authority's revision contract before reuse of readiness."),
    p(text: "B1 derives owned-directory path, owner, mode and permitted parent authority from the binding and closes owned_directory_ensure with readback. Setup and use consume that same dependency. B2 observes R2 allocation, directional credential, bucket and relevant lifecycle configuration at the responsible root. The existing bucket-admin GET stays at that root; ordinary consumers receive scoped evidence, not the admin secret. A future non-admin probe must first model what it actually establishes. Configuration resolution and line/held ensure output never count as an observed component. An empty desired lifecycle rule list must not skip observation when non-expiry is part of the contract."),
    p(text: "The machinery does not infer all demands today: dashboard_instance_directory_demands is an authored list, and general demand identity/dependency reads are the demand-engine program's frontier. This migration removes the separate consumer store enrollment by making the selected fabric binding own its prerequisites. Irreducible checkout/runtime paths remain host effects. Missing access or an unknown prerequisite names its owning layer; fabric does not manufacture authority or introduce an approval for a nonsensitive ordinary read/write."),
    h2(text: "6. Root cuts and existing state"),
    p(text: "The three deliveries are: S, an isolated source-snapshot cut through all three admitted realizations; C2, the complete attempt-lifecycle/claims/credential/seat/session cut; and the remaining repo-wide M cohorts plus V reconciliation. The second isolated deployment is part of S's handback, with the same logical snapshot caller, not an unowned later exercise. There is no promise that a particular backend wins: actual constraints and real readings determine the winner. S must exercise each admitted route with a truthful scoped candidate field and retain the full three-candidate decision as well as route-specific controls. Missing evidence is an honest failed acceptance, not a reason to invent a number."),
    p(text: "Source snapshot capture/materialize is the first store-bound consumer. Its external instrument entry is source_snapshot_handoff(), a manual gunbc run function. It builds and runs a real child using the materialized source. It is the only external consumer of those store-bound capture/materialize operations at this baseline; the module's other pure helpers have other consumers. A second host/deployment must actually materialize and run the child; two in-process bindings on one host do not establish that result."),
    p(text: "gunbc.compute.attempt_lifecycle has six consumers: work_provider_local, compute_seat_ensure, dispatch_credential_acquisition, roadmap_attempt_worktree_claim, roadmap_session_activation_ensure and roadmap_session_placement. C1 designs their common binding/namespace/history transition; C2 changes all six in one authority cut. There is no claims-only dual raw-root/fabric lifecycle signature. Work can be developed on an integration branch; main receives one coherent cut. No production dual interval is proposed or authorized."),
    p(text: "Before each cut, the owning package records every source namespace and exact subject identity, principal, writer/recovery entry, retained history and any deployed data. Deployed locations are known from declarations; record counts and contents are not established by this source audit. The implementation handback must observe them under the existing authority, quiesce or fence writers and recoverers, reconcile copied data/history independently, and perform one binding switch. Failed preparation leaves the old authority active. Once new writes begin, an old snapshot is not a rollback; a reverse move needs its own admitted continuity transition. No live copy, credential access or service stop is authorized by this design PR."),
    p(text: "Use [the replacement migration doctrine](docs/plans/replacement-migration-doctrine.md) and gunbc.replacement_cut. Each cut names its exact old root, subject population, new root, independent outer oracle, deleted machinery and retained/retired evidence. Its terminal receipt is the doctrine's full receipt:"),
    CodeBlock { code: "new root consumers                  = exact declared population\nold root consumers                  = 0\nundispositioned consumers           = 0\nuncovered surviving consumers       = 0\nproduction X<->Y adapters           = 0\nproduction fallbacks                = 0\nmigration feature flags             = 0\nunreconciled subject identities     = 0\nretained discriminating evidence    = exact declared population\nretired consumers and evidence      = exact declared population, each with a receipt" },
    h3(text: "Claims: the complete workflow and intended behavior"),
    p(text: "A worktree is a Git checkout; the worktree-claim store contains its ownership records. record_before_add already opens create-only, reads independently and compares claim identity/path before git worktree add. C2 preserves this baseline, along with lost-close races, capture-before-release and refusal to remove dirty/unpushed/live/foreign trees. It replaces string-only WorktreeClaimNotRecorded causes with domain-preserving typed reasons, including root/authority, race and readback mismatch."),
    TableBlock {
      header: row(cells: [cell(text: "Process or dependent"), cell(text: "Exact cut obligation"), cell(text: "Owner")]),
      alignments: [AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "Event-driven belt: belt_tick_for_instance and its launch fold"), cell(text: "Carry one resolved instance and fabric namespace through settlement, recovery and spawn. Today belt_actuate_spawn hardcodes srv1_live_dashboard_instance while tick settlement/recovery uses its supplied instance; the cut must remove this defect."), cell(text: "C2")]),
        row(cells: [cell(text: "Served POST /dispatch"), cell(text: "serve_dispatch_handler_response_over -> belt_dispatch_node_for_instance_over carries the served instance's binding."), cell(text: "C2")]),
        row(cells: [cell(text: "Assign follow-through"), cell(text: "serve_assignment_launch_follow_through_over -> belt_dispatch_node_for_instance_over uses the same subject and binding as record/recovery."), cell(text: "C2")]),
        row(cells: [cell(text: "CLI"), cell(text: "belt_dispatch_node_cli resolves GUNBC_BELT_INSTANCE_ID; preserve its admitted instance roster and supply that binding, not srv1 by default after resolution."), cell(text: "C2")]),
        row(cells: [cell(text: "Setup / observation"), cell(text: "dashboard_instance_directory_demands, live_deploy spec directories and dashboard_instance_apply become projections of the selected fabric prerequisite. Preflight, preflight_json and wet entries on srv1/srv2 consume the same observation."), cell(text: "C2")]),
        row(cells: [cell(text: "Retraction"), cell(text: "live_deploy.retract_legs::retract_dispatch_root_paths reads spec.directories. Retire claim metadata enrollment without losing checkout/attempt runtime cleanup or expanding deletion to shared fabric state."), cell(text: "C2")]),
        row(cells: [cell(text: "Privilege artifacts"), cell(text: "runner_host_privileged_operations feeds tier-O sudoers. The committed srv1 file has no worktree-claim grants at this baseline (the prior removal is #14579). Derive any necessary replacement grants, regenerate through the artifact authority and test the actual deployment principal; do not assume a prose directory row grants access."), cell(text: "C2")]),
      ],
    },
    p(text: "Listing failure refuses the whole recovery pass and withholds new launches. For an individually unreadable record, keep the record and its tree, continue safe observation/recovery of other records, and return a typed incomplete pass; that pass also withholds new launches for the affected instance until the unreadable state is resolved. This is an explicit tightening: today's unreadable record becomes non-red WorktreeClaimKept, so the pass can permit launches. A valid empty listing must remain distinguishable from either failure. There is no silent deletion or conversion of a corrupt record into absence."),
    h2(text: "7. Acceptance evidence and execution"),
    p(text: "This PR runs only the plan-governance claims and documentation checks. It does not execute the proposed storage acceptance controls. The required witnesses workflow currently emits/builds and parses; it executes no storage wet witness. gunbc.rung_drop.v1_required_lanes_withdrawn owns that standing. A green required job is not evidence that this migration's wet controls ran. Every implementation package retains its command, exact source revision, deployment/principal, input/evidence identities and typed outcome as handback evidence. No new universal CI floor is proposed here."),
    TableBlock {
      header: row(cells: [cell(text: "Control population"), cell(text: "Where it executes"), cell(text: "Sole accountable package")]),
      alignments: [AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "Real prices, complete eligibility roster, required couplings, workload/SLO units, changed evidence identity, stale receipt, unknown evidence and missing policy"), cell(text: "Focused .dag claim entry for fabric selection, explicitly invoked by the implementation owner; proposed entry is an A deliverable, not an existing label. Synthetic boundary inputs may test refusal laws but never stand as pilot price/latency evidence."), cell(text: "A")]),
        row(cells: [cell(text: "File readiness, parent-only start, owner/mode mismatch, inaccessible root, repeated Noop; all existing root-ensure callers"), cell(text: "Existing file-store wet witness and the 15 test.claim callers inventoried below, with a real consumer-principal route on an isolated host. B1 supplies the exact commands and negative deletion-of-prerequisite control."), cell(text: "B1")]),
        row(cells: [cell(text: "R2 root observation, denied/missing allocation and directional credentials, admin-observed bucket/lifecycle, unknown observation, actual R2 latency"), cell(text: "Explicit isolated provider instrument under the authorized root; ordinary data-principal probe separately. B2 names the entry and retained observation receipts before S uses them. No production bucket mutation."), cell(text: "B2")]),
        row(cells: [cell(text: "Get/list/history/CAS/holds and all result-match compatibility; post-send transport failure, 5xx, readback mismatch, list refusal, stale fence, missing head target"), cell(text: "Focused pure claims plus existing file-store, wire, fabric-CAS and R2 race instruments in isolated namespaces. F adds the served ambiguous-write path with an independent resolver; a mocked HTTP result alone cannot establish actual ordering."), cell(text: "F")]),
        row(cells: [cell(text: "Snapshot capture/materialize/child execution, three admitted routes, isolated release, second deployment"), cell(text: "Manual gunbc run --entry dag/gunbc/instruments/source_snapshot_handoff.dag --function source_snapshot_handoff, extended by S. Keep build and child on one architecture/dispatch. Use a remote dispatch for heavy builds; on a designated execution host use a native binary/build there. Not a gunbc test label."), cell(text: "S")]),
        row(cells: [cell(text: "Claims/lifecycle crash gaps, duplicates, close races, unreadable record, unreadable listing, readback mismatch, wrong instance and principal"), cell(text: "Explicit claim-run of dag/test/claim/roadmap/attempt_worktree_claim_wet_witness.dag plus the six lifecycle cohorts' real-route controls. C2 supplies the command/receipt and never infers execution from required CI."), cell(text: "C2")]),
        row(cells: [cell(text: "Each remaining state cohort's exact retained/retired evidence, continuity and refusal semantics"), cell(text: "Its inventory row's process entrance under an isolated or separately authorized migration rehearsal; M1/M2/M3/M4 own their distinct cohorts. No generic success sample substitutes for a cohort's oracle."), cell(text: "Respective M package")]),
        row(cells: [cell(text: "Repo-wide census closure, deletion/absence of old routes, reconciled identities, final independent evidence roster"), cell(text: "V reruns selectors against the implementation head and joins every row to one terminal receipt; parent/operator reviews completion."), cell(text: "V")]),
      ],
    },
    p(text: "The claim wet witness has a concrete blind spot: its pass helper converts WorktreeClaimPassRefused to an empty list. a_kill_before_the_claim_leaves_nothing_to_release and a_tree_no_claim_names_is_never_touched can therefore pass when the store cannot be listed. C2 must preserve and assert WorktreeClaimPassRan in the helper/result projection, add distinct missing-store/listing-refusal controls, and require the two tests to go red when successful enumeration is removed. Add readback-mismatch and single-unreadable-record controls with the behavior specified above. Retain the existing actual Git/child process path; supplied boundary cases complement it."),
    p(text: "The R2 pilot must not use FabricWorkspace's objects/<ref> history bucket: it has empty lifecycle rules and no delete route. A cache bucket lifecycle prefix also does not cover objects/<ref>. F/B2 admit an isolated purpose or namespace and release contract; S must actually release it and independently observe absence. Existing race_cleanup's status string is insufficient if cleanup failure does not gate success. Outstanding staged files, unknown puts or incomplete release prevent a complete pilot receipt."),
    h2(text: "8. Staffing, ledger and completion"),
    p(text: "Proposed headcount: four implementation seats, not two owners plus unnamed specialists. These are staffing roles for Brian to assign, not dispatched people: fabric integrator, backend/readiness owner, dispatch/lifecycle owner, and state-consumer owner. Domain maintainers review their semantics; review is not a fifth unowned delivery. The state-consumer seat performs cohorts sequentially; this is responsibility accounting, not an estimate that the whole repo can migrate in a day. Stable fabric models land before consumers cut; integration branches keep incomplete migrations off main."),
    TableBlock {
      header: row(cells: [cell(text: "Package"), cell(text: "One accountable seat"), cell(text: "Scope / dependency / finished handback")]),
      alignments: [AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "A"), cell(text: "Fabric integrator"), cell(text: "Sections 1/3: root requirement/SLO/workload declarations, cited cost derivation, eligibility projection, decision closure, immutable evidence identity, binding selection at process roots and selection controls. Consumes B1/B2 observations; does not own their collection.")]),
        row(cells: [cell(text: "B1"), cell(text: "Backend/readiness"), cell(text: "Section 2/5 file readiness, all root-ensure callers, actual disk identity/cost source and local/served latency observations. Consumes F/A contract; supplies real component evidence, including actual principal/grants.")]),
        row(cells: [cell(text: "B2"), cell(text: "Backend/readiness"), cell(text: "Section 2/5 R2 allocation/credential/bucket/lifecycle observation, root-held admin evidence or modeled non-admin probe, applicable R2 measurement, provider realization of F's isolated release.")]),
        row(cells: [cell(text: "F"), cell(text: "Fabric integrator"), cell(text: "Section 4 shared models and local/served/R2 execution, get/list/history/uncertainty/refusal/revocation/fenced-hold/blob/release contracts, all compatibility matches and served ambiguity repair. Enumeration is designed and built here, not delegated to claims. Owns selected-request/admission/readback composition of section 5.")]),
        row(cells: [cell(text: "S"), cell(text: "State-consumer"), cell(text: "Source-snapshot cut, isolated route execution/release, actual second deployment, unchanged logical caller and real child controls. Depends on A/B1/B2/F; owns delivery 1 and the second-deployment obligation.")]),
        row(cells: [cell(text: "C1"), cell(text: "Dispatch/lifecycle"), cell(text: "Common lifecycle/domain namespace, history and state-transfer design for all six consumers and claims; no production migration yet. Depends on F contracts. Names source identities, fencing, destination reconciliation and authority switch.")]),
        row(cells: [cell(text: "C2"), cell(text: "Dispatch/lifecycle"), cell(text: "One all-six-consumer lifecycle cut and full claims workflow in section 6, setup/retraction/sudoers/preflight, typed incomplete recovery, witness repair and first two ledger dispositions. Depends on C1 and F; owns delivery 2.")]),
        row(cells: [cell(text: "M1"), cell(text: "State-consumer"), cell(text: "Other direct file-CAS/security/journal/app stores in the inventory, their process roots and deployment state. Includes approval storage only; approval UX/sensitivity policy remains a later design.")]),
        row(cells: [cell(text: "M2"), cell(text: "State-consumer"), cell(text: "Every durable hold/lease consumer and protected-effect fence, grouped by complete independent root. Depends on F's common lease contract; preserves release and stale-actor refusal.")]),
        row(cells: [cell(text: "M3"), cell(text: "State-consumer"), cell(text: "Direct R2 checkpoints/blob/origin, Git-backed state and local materialization, plus immutable/object consumers. Preserves provenance, custody, retention and existing deployed history.")]),
        row(cells: [cell(text: "M4"), cell(text: "State-consumer"), cell(text: "Remaining persistent filesystem/shell/artifact/configuration paths classified migrate in the effect-boundary inventory. Converts logical persistent authority to fabric while retaining necessary local materialization effects; no catch-all omission.")]),
        row(cells: [cell(text: "V"), cell(text: "Fabric integrator"), cell(text: "Final selector rerun, exact row/obligation/receipt join, explicit retained backend/platform exclusions and full terminal receipt. Owns repo-wide retirement, not each package's execution evidence.")]),
      ],
    },
    p(text: "Every appendix row inherits exactly one package. F owns common protocol changes; a consumer package owns its cut and controls, not a second implementation of that protocol. B1 owns the root-readiness ledger disposition; C2 owns the two claim/root rows; V only checks those handbacks. Unimplemented inference beyond storage remains a named existing compiler frontier, not an unowned retirement obligation."),
    TableBlock {
      header: row(cells: [cell(text: "Ledger row / current standing"), cell(text: "Disposition in implementation cut"), cell(text: "Rung the evidence can buy")]),
      alignments: [AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "a_store_root_nothing_creates"), cell(text: "C2 removes the worktree/credential independent directory enrollment and authored rung-2 join/recognition rule once their common fabric dependency produces setup and use. Amend the ledger and its references in that cut; do not declare it fixed in this design PR."), cell(text: "Current typed rung is unread; receipt prose describes an authored two-store rung-2 join and the required-floor withdrawal. Executed replacement controls retain mitigation. A structural construction that makes a usable binding require its prerequisite can buy the stronger domain-local prevention rung; general inferred demand closure is still the demand-engine trigger.")]),
        row(cells: [cell(text: "an_attempt_worktree_has_no_owner_until_the_attempt_state_exists"), cell(text: "C2 preserves claim-before-add/readback, updates the DeclarationRef to worktree_claim_ensure_pass_at if that helper retires, and disposes its producer/recovery evidence."), cell(text: "Storage migration alone does not eliminate manual/pre-claim trees. Preserve the existing mitigation; claim a construction rung only when the actual worktree-acquisition boundary cannot execute without the confined claim, with a discriminating negative control.")]),
        row(cells: [cell(text: "control_plane_acknowledgement_minted_as_effect: new file-root-readiness specimen"), cell(text: "B1 records the source-proven mkdir-success-as-Ready specimen under this existing class and replaces it with independent owned-directory observation/readback. This is a verified source defect, not a fabricated live incident."), cell(text: "A run of the real negative controls buys mitigation at the file-root population. A required executing gate or confined readiness constructor must be evidenced separately before claiming mechanical/structural prevention; no class-wide rung rise follows from one repaired site.")]),
      ],
    },
    p(text: "The retirement population is every inventory row marked migrate (S, C2 and M1-M4), every changed shared binding/result consumer (F), every prerequisite producer/caller (B1/B2), and every process-root selection binding (A). Each needs the doctrine receipt and retained evidence; retained backend implementations, local materialization/transport effects and explicit exclusions need their own reason and owner, not a false zero. V must establish no undispositioned durable-state paths remain at the implementation head. This design's confidence is source-bounded: lexical selectors and read call chains support the listed dispositions, while deployed state contents and actual prices/timings require the named observations. A percentage is not a substitute for closing those obligations."),
    p(text: "The intended benefit is fewer feature-level integration points and one place to repair storage behavior. Costs are explicit: fabric gains enumeration/history/lease and evidence responsibilities; some consumers gain a transport hop or stricter refusals; state transitions need coordinated cuts. Approval-route consolidation remains the next discussion after this storage design is complete. Migrating approval records here does not introduce or preserve unnecessary formal approvals."),
    h2(text: "Appendix A. The all-six lifecycle cut (C1/C2)"),
    p(text: "Read-only source audit, 2026-10-23. This roster is **six modules, not six functions or six independent stores**. Compute provider/discharge share one namespace family; session placement/activation share another. Credential acquisition and worktree claims have their own payloads and namespaces. All six move together at `gunbc.compute.attempt_lifecycle`; none keeps a direct-file lifecycle fallback."),
    h3(text: "Concrete call and scope inventory"),
    TableBlock {
      header: row(cells: [cell(text: "Immediate consumer"), cell(text: "Actual functions calling lifecycle I/O"), cell(text: "Process/domain entrances and path to those functions"), cell(text: "Namespace and setup selectors"), cell(text: "Required behavior")]),
      alignments: [AlignNone, AlignNone, AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "`gunbc.compute.work_provider_local`"), cell(text: "`compute_open_attempt`, `compute_open_attempt_minted` call `attempt_open`; `compute_begin_launch` calls `attempt_begin_launch`; `compute_settle_attempt` and `compute_recover_attempt_in` call `attempt_terminate`; `compute_recover_slot_present` and `compute_recover_attempt_in` call `attempt_slot_read`."), cell(text: "`compute_request_cli` -> `compute_provide` -> production/reservation/run folds. `gunbc.compute.test_run::\{test_pattern_cli,compile_entry_cli\}` -> `test_run/run_selected_module` or direct `compute_provide`. Belt verification uses `roadmap_belt_actuate::belt_run_claim_through_compute` -> `compute_provide` with dispatch owner. Operator recovery is `compute_recover_cli` -> `compute_recover_attempt` -> `compute_recover_attempt_resolved/at` -> `compute_recover_attempt_in`."), cell(text: "Entrypoints resolve `HostDashboardInstance` through `dashboard_instance_for_repo_root`; `compute_layout_in` derives from `host_capacity::compute_root(instance)`. `compute_attempts_root` is compute-root/attempts. `compute_seat_dir`: `DispatchOwned` uses attempts/dispatch-<attempt_key>; `DirectInvocation` and `OwnerUnrecorded` use flat attempts root. `compute_provide_produce` creates attempts, leases, work, staging and target directories through `compute_ensure_dir`; `compute_reserve_and_run` creates the owner seat directory. Parent root is `host_capacity::compute_root_directory` in `dashboard_instance_directory_demands`."), cell(text: "Open before reserve/spawn, generation gate immediately before launch after checkout, observed unit/cgroup termination before capacity release, retained ordinal uniqueness, no release after stale generation. A terminal record can still owe capacity release; recovery must finish that crash gap. Keep direct and dispatch-owned namespaces, unique ledger references and duplicate-holder refusal.")]),
        row(cells: [cell(text: "`gunbc.compute.compute_seat_ensure`"), cell(text: "`compute_seat_ensure_in` calls `attempt_slot_read`; its `seat_apply` calls provider `compute_recover_attempt_in` (transitive mutation)."), cell(text: "`roadmap_belt_actuate::belt_compute_seat_discharge_pass` -> `compute_seat_discharge_all`; invoked by `belt_tick_for_instance` and the withheld branch of `belt_run_once_in`. Root executable: `roadmap_belt_tick_cli::belt_run_once_cli` / `belt_run_once_cli_in`. `compute_seat_discharge_owned` and `compute_seat_discharge_dir` also form the per-owner recovery seams."), cell(text: "Same compute attempts/leases/root and capacity subject as provider. `compute_seat_discharge_all` derives ended owners from `attempt_exit_all_stage_listings(instance_root)` and lists live dispatch directories; `compute_seat_discharge_dir` enumerates `cas_slot_keys`. `seat_dir_provably_absent` distinguishes proved absence from an unreadable listing."), cell(text: "Preserve full enumeration and scoped owner joins; unknown worker-exit/listing data cannot mean no seats. `seat_apply` independently reads capacity before/after and checks it fell by the held grant. Lease deletion goes through owner/reference checks. Dead worker, still-running compute unit and lost release must remain distinguishable.")]),
        row(cells: [cell(text: "`gunbc.dispatch_credential_acquisition`"), cell(text: "`credential_open` -> `attempt_open_payload`; `credential_begin_launch` -> `attempt_begin_launch_payload`; `credential_terminate` -> `attempt_terminate_payload` after domain-specific reader evidence."), cell(text: "Acquisition: `roadmap_dispatch_actuator::\{dispatch_actuator_claude_selection_observed,cursor_selection_observed\}` -> `credential_register_then_take`. Launch: `roadmap_belt_actuate::belt_credential_admit_before_spawn` -> `credential_admit_reader_or_discard` -> `credential_begin_launch_or_discard`. Recovery: `roadmap_belt_tick_cli::belt_credential_recovery_cli` -> `credential_recover_root` -> `credential_recover_slot` -> `credential_terminate` / `credential_seal_after_terminate`. Recovery has its own deployed event service and backstop timer via `live_deploy.emit::\{live_deploy_belt_credential_recovery_unit_file,live_deploy_belt_credential_recovery_timer_unit_file\}`."), cell(text: "`credential_acquisition_slots_root(instance_root)` uses instance-root/credential-acquisition-slots, independent of `DispatchStateScope`. Owner-only `credential_acquisition_slots_directory` and `cursor_attempt_runtime_directory` are enrolled in `dashboard_instance_directory_demands`. Recovery selects instance using `belt_instance_from_env` and `desired_deployment_for_instance_id`. Root ownership must follow the exact instance, not merely a host or provider prefix."), cell(text: "Record before taking credential/runtime custody; bind producer cgroup and belt unit; launch CAS before reader launch; `AttemptLaunching` may terminate only after reader ended. Keep recorded cgroup-drain evidence, snapshot tombstoning, marker-checked Cursor runtime cleanup and owed cleanup after partial failure. Terminal metadata alone never proves that the credential reader is gone.")]),
        row(cells: [cell(text: "`gunbc.roadmap.roadmap_attempt_worktree_claim`"), cell(text: "`worktree_claim_open` -> `attempt_open_payload`; `worktree_claim_close` -> `attempt_terminate_payload`. Companion direct-file reads are `worktree_claim_read`; enumeration is `worktree_claim_ensure_pass_at`."), cell(text: "Spawn: `roadmap_belt_actuate::belt_spawn_admitted` -> `belt_worktree_claim_before_add` -> `worktree_claim_record_before_add` -> open then readback, before `git worktree add`. Recovery: `belt_session_settlement_pass` -> activation ensure -> `belt_worktree_claim_ensure` -> `worktree_claim_ensure_pass_at/ensure_one`. Spawn entrances include the belt CLI and in-process dispatch path in `roadmap_serve`, not only timer/event execution."), cell(text: "`roadmap_attempt_worktree_claim_root::worktree_claim_slots_root_of` derives `<dashboard_instance_dispatch_attempt_state_root>/worktree-claims`; `worktree_claim_slots_directory` is owner-only and enrolled in both provisioning routes through `dashboard_instance_directory_demands`. Root retains `DispatchStateInstanceOwned` versus `DispatchStateHostShared`; do not blindly prefix every claim with instance ID. Physical Git worktree path still derives from `dashboard_instance_dispatch_worktree_root` and the node/attempt identity."), cell(text: "Create-only duplicate refusal, record/path/identity readback before tree creation; enumeration from claims rather than every physical worktree; live/unknown worker keeps tree. Dirty/unpushed content and unresolved capture keep it. Remove through Git, independently prove absence, then generation-fenced close. A removed tree whose close failed is repairable on next pass. No arbitrary persisted path is authority to remove a tree.")]),
        row(cells: [cell(text: "`gunbc.roadmap.roadmap_session_activation_ensure`"), cell(text: "`session_activation_ensure_pass_at` calls `attempt_slot_read`; mutation is through `session_activation_apply` -> `session_settle_one` in placement."), cell(text: "`roadmap_belt_actuate::belt_session_settlement_pass` -> `session_activation_ensure_after_settlement` -> `session_activation_ensure_pass_at/ensure_one`, then worktree-claim recovery. Same `belt_run_once_cli` entrance as settlement."), cell(text: "Reuses **the same** `SessionPlacementStores.slots_root` and `records_dir` as placement; it must consume the identical selected binding/namespace. `cas_slot_keys(stores.slots_root)` determines subjects; foreign/unrecorded units are not invented as subjects."), cell(text: "Rollback/release/collection only; no forward-spawn recovery. Preserve unknown/foreign placement refusal, deadline/live-worker protection, release-before-collect, readback of both placement and loaded unit, and the distinction between `ActivationRefused` and a red post-effect observation.")]),
        row(cells: [cell(text: "`gunbc.roadmap.roadmap_session_placement`"), cell(text: "`session_placement_acquire` -> `attempt_open`; `session_refused_after_open`, `session_abandon_terminate_then_release`, `session_placement_abandon_at`, `session_settle_one` -> `attempt_terminate`; `session_placement_begin_launch` -> `attempt_begin_launch`; `session_placement_abandon_at`, `session_placement_observe_at`, `session_settle_one` -> `attempt_slot_read`."), cell(text: "Spawn: `roadmap_belt_actuate::\{belt_actuate_spawn_with_origin,belt_session_placement_for_container,belt_session_container_create,belt_spawn_release_unless_spawned\}`. Settlement: `belt_session_settlement_pass` -> `session_placement_settle_pass/at` -> `session_settle_one`. Evidence readers: `session_placement_observe_for_attempt`, `attempt_worker_unit_observe_for_instance`; external callers include `roadmap_service_evidence::service_evidence_inputs_for_attempt` and `roadmap_belt_actuate::belt_workflow_attempt_evidence_for_key`."), cell(text: "`session_placement_stores(instance)` resolves `session_placement_pool` and `host_capacity_subject`; `session_placement_slots_root` derives `<dashboard_instance_dispatch_attempt_state_root>/session-attempts`, `records_dir` is that attempt-state root, and the store/partition are the capacity ledger's. `belt_session_slots_ensure` currently runs install -d -m 0700 before acquisition/settlement, based only on command outcome; it is **not** its own roster-enrolled directory target. Tmux container branch has `BeltPlacementNotHeld`; systemd branch acquires."), cell(text: "Slot before capacity acquisition; durable generation gate before launch; terminal CAS before release on abandonment; reread after lost race; ledger/reference/identity binding; settlement before new tick acquisition. Retain grant/release/note companions and independent observation so a crash after opening, granting, spawning, closing or releasing remains recoverable.")]),
      ],
    },
    h3(text: "Shared process and deployment selectors"),
    ul(items: [li(text: "`roadmap_belt_tick_cli::belt_run_once_cli` requires nonempty `GUNBC_BELT_SPAWN_WORKDIR`, then `belt_run_once_cli_in` uses `dashboard_instance_for_repo_root` and calls `belt_run_once_in`. Missing/unknown roots refuse instead of falling back to production. The main belt is event-driven now; do not describe all lifecycle recovery as a main-belt timer. Credential recovery separately retains a backstop timer."), li(text: "In-process dispatch is `roadmap_serve` -> `roadmap_belt_actuate::belt_dispatch_node_for_instance_over`; the manual CLI is `belt_dispatch_node_cli` -> `belt_dispatch_instance_selected/named`, requiring `GUNBC_BELT_INSTANCE_ID` from its admitted roster. Its current admitted list is srv1-live/srv2-deploy; that does not replace the broader instance roster used by deployment-scoped paths. Non-executable JSON projections are not extra process roots."), li(text: "`roadmap_dashboard_instance::dashboard_instance_dispatch_attempt_state_directory/root` match `DispatchStateScope`: instance-owned derives from `instance_root` and `attempt_state_child`; host-shared carries its declared attempt-state root. `srv1_live_dashboard_instance` is host-shared. The new logical namespace must retain this ownership/sharing fact, separately from its selected backend locator."), li(text: "Provisioning roots: `roadmap.dashboard_instance_directories::dashboard_instance_directory_demands` -> `roadmap_dashboard_instance_apply::dashboard_apply_owned_directories` with dashboard observation, and `live_deploy.spec::DeploymentSpec.directories` -> `live_deploy.emit::owned_directory_apply_steps` with `live_deploy.member_observe` directory observation. Keep both consumers in the cut. Compute subdirectory creation and session slot creation are additional imperative setup sites to eliminate or fold into the selected readiness producer.")]),
    h3(text: "Hidden path coupling and companion state that the cut must disposition"),
    ol(items: [li(text: "`credential_recover_slot` repeatedly derives `instance_root` with `path_parent_directory(root)` for runtime observation and cleanup. A fabric bucket/address cannot replace that string while preserving meaning. Carry the actual logical instance context through acquisition and recovery, and keep credential custody local to its declared process context. `credential_slot_record`, `credential_admit_reader_or_discard`, `credential_terminate`, `credential_recover_root` and `credential_recover_slot` also directly read/enumerate file CAS and must move with their lifecycle writers."), li(text: "`SessionPlacementStores` includes `slots_root`, `records_dir`, capacity `store` and `partition`. `session_placement_record_write`, `session_placement_release_write`, `session_settle_note`, `session_placement_file` and `session_placement_observe_at` operate on grant/release/note companions under `records_dir`. Retain or replace each under its existing contract; switching only the CAS calls leaves a split recovery authority. The design must name what remains physically local, why it is not a second lifecycle truth, and how the whole observation remains coherent."), li(text: "Compute cleanup joins lifecycle state to leases whose first line identifies the owning seat directory (`compute_lease_holder_line`), worker-exit spool owners, and capacity event history. Any new logical store binding must replace that physical locator comparison with the same ownership fact, not make every lease appear foreign or strip the fence. `compute_recover_roots` currently searches flat plus dispatch subroots and refuses multiple holders, including an unreadable potentially-held slot; keep that behavior."), li(text: "Worktree claim reads and enumeration bypass `attempt_slot_read` because the payload is domain-specific. An `attempt_lifecycle` signature change alone will not break those raw reads. Their replacement is part of the same cut.")]),
    h3(text: "Shared transition, retention and fencing contract"),
    p(text: "`attempt_open_payload` forces `AttemptReserved`, validates the declared launch window (nonnegative, not above `compute_pre_launch_ceiling_seconds`), and commits with `ExpectSlotAbsent`. `attempt_advance_payload` reads/decodes, checks embedded reference and expected generation, allows Reserved -> Launching, refuses reopening to Reserved, and routes terminal transitions through the same CAS. `attempt_commit_bytes` admits digest/key and uses unwindowed `file_compare_and_set(...DefaultAccessCreateOnly...)`. Lost precondition is `AttemptLostRace`; unreadable/refused storage is `AttemptTransitionRefused`. The losing launch must never reach spawn."),
    p(text: "The existing `file_compare_and_set` projects `KeepAllGenerations`. The six consumers ordinarily recover from enumerated current records; that does not prove they need an arbitrary history traversal API. But the retained generation line and stable reference nonreuse are current storage facts, and `compute_recover_exit` explicitly calls the terminal generation durable history. The cut must name surviving audit/retention/nonreuse obligations and preserve their data; it cannot select windowed/head-only storage merely because it also supports CAS. Fabric CAS currently has link-free per-key generation objects and heads; it supplies neither implicit namespace closure nor retained-history traversal by itself."),
    p(text: "`recovery_trigger` respects the declared prelaunch deadline for Reserved, requires observed ended lifecycle for Launching, and exposes `RecoveryTerminalRecordMayRelease` for crash recovery. Generic lifecycle termination alone is not sufficient evidence that a process ended. Compute, credentials, activation and worktree cleanup each have additional evidence obligations; preserve them at their own authority."),
    p(text: "For the one cut: fence/quiesce all writers and recoverers for these namespaces, enumerate and independently reconcile extant records and required retained history, preserve scopes and generation/reference identities, then switch both readers and writers to one selected authority. A restart must recover pre-cut open, launching and terminal-but-unreleased records. Do not use a new empty namespace or reset ordinals. New backend writes make rollback to an old snapshot unsafe; reverse transition needs its own reconciliation. This design document does not authorize touching live state."),
    h3(text: "Evidence and search limits"),
    p(text: "Search used `rg` for every `import gunbc.compute.attempt_lifecycle`, then direct calls to its ten I/O functions, followed by each caller's enclosing function, direct production callers, setup and instance selectors. Read the domain implementations and shared transition functions; traced executable CLI/deployment and in-process serve roots above. Import-only/type-only users (e.g. `compute.test_run` and `roadmap_belt_actuate` import lifecycle vocabulary) are distinguished from the six immediate I/O modules. Strings, comments and citation declarations are not counted as executable callers. This is a source roster, not a live state observation or execution receipt. The repo is the complete caller population by scope; the implementation cut must refresh its exact callers and source-declared deployments."),
    p(text: "Witnesses to retain/disposition include `test.claim.compute::\{attempt_lifecycle_wet_witness,attempt_lifecycle_payload_seal_witness,attempt_discharge_wet_witness\}`, `test.claim.dispatch_credential_acquisition_witness`, `test.claim.cursor_runtime_root_record_witness`, and `test.claim.roadmap::\{attempt_worktree_claim_wet_witness,session_placement_wet_witness,session_activation_ensure_wet_witness\}`. They accompany the six-module cut; they are not six more production stores. Keep sealed `admit_callers` references for payload codecs and lifecycle open/launch/terminate/commit synchronized with the replacement."),
    h2(text: "Appendix B. Provider, R2, Git and materialization paths"),
    p(text: "F owns retained shared backend implementations and result compatibility; B1 owns readiness callers, B2 R2 prerequisite/release realization, S the snapshot cut and M3 the durable R2/Git/materialization consumer cuts. Provider falsification fixtures remain evidence at their owning boundary. Deployed state is unobserved unless a dated observation is explicitly cited; none of the source paths below establishes current record counts."),
    h3(text: "Direct R2 transfer cohort and dispositions"),
    p(text: "There are four external operation-bearing users of the transfer's put/fetch/release API: origin object, fabric object, fabric blob and R2 head. A fifth production/instrument module, the conditional-put race probe, calls the common transfer classifier around its own deliberately adversarial commands. Checkpoint/source/M0 consumers also carry transfer custody variants directly; constructor/closed-result compatibility must cover them even when they do not call transfer I/O."),
    TableBlock {
      header: row(cells: [cell(text: "Cohort and exact symbols"), cell(text: "Current route"), cell(text: "Disposition, root and preservation obligations")]),
      alignments: [AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "`gunbc.cloudflare.r2_staged_transfer::\{r2_put_staged_file,r2_fetch_into_staging,r2_release_staging\}`"), cell(text: "R2TransferTarget → pinned secret/custody → signed curl → typed put/fetch outcome. Put has stored/already-present/tag-moved/refused/unknown; fetch distinguishes absent/store refusal/unanswered/local failure; temporary directories are minted by transfer"), cell(text: "Retain as R2 backend implementation. Root supplies admitted target and token source through fabric binding. Credentials and staging are temporary custody, not a durable data cohort; retain explicit cleanup result on every outcome")]),
        row(cells: [cell(text: "`gunbc.fabric.fabric_object_r2::\{put_fabric_object_r2,get_fabric_object_r2\}`"), cell(text: "`objects/<structural-ref>`; put stages canonical preimage, create-only; occupied/unknown puts read back exact preimage; successful put alone does not read back; get parses and checks ref"), cell(text: "Retain behind common metadata binding. Root supplies admitted purpose/namespace/credentials; direct purpose resolution moves below ordinary consumers. Add independent pilot get after EVERY success. Do not drop staging or credential residue")]),
        row(cells: [cell(text: "`gunbc.fabric.fabric_storage_r2_head::\{r2_head_observe,r2_head_read,r2_head_advance,r2_head_fabric_advance\}`"), cell(text: "Per-head GET tag; PutIfAbsent/PutIfMatch; known/unknown result; only admitted known result projects to FabricHeadAdvance"), cell(text: "Retain backend; coherent object/head placement required. A later observed generation does not prove an earlier unknown put lost: it may have committed and been built upon. Preserve the exact successor-generation reconciliation rule and CAS evidence")]),
        row(cells: [cell(text: "`gunbc.fabric.fabric_blob_r2::\{put_fabric_blob,get_fabric_blob,release_fabric_blob_staging,put_cache_blob,get_cache_blob,put_workspace_chunk,get_workspace_chunk\}`"), cell(text: "Existing std.fabric_blob put/get, bounds, purpose selection, SHA-256 staged readings; fetched bytes remain held for consumer, unlike origin digest-only reads"), cell(text: "Retain blob backend beneath fabric. Preserve opaque byte plane separately from NonEmptyStr metadata. Root binding expresses retention/access scope; missing cache blob is admitted miss, missing required durable object remains domain failure")]),
        row(cells: [cell(text: "`gunbc.fabric.workspace_checkpoint_instrument::\{workspace_instrument_commit_admitted,workspace_stored_entry_read,workspace_head_binding,workspace_observed_entry,workspace_closure,workspace_chunk_of_file,workspace_measure_on_btrfs,workspace_restore_after_barrier,workspace_restore_entry,workspace_timed_commit,workspace_restore_barrier\}`"), cell(text: "Direct R2 metadata put/get and head; direct workspace chunk/blob; explicit staged custody. Entrypoints `workspace_checkpoint_measure_wet` / `workspace_checkpoint_restore_wet` are fleet-converge modes, pinned to srv3 and local Btrfs capability"), cell(text: "Migrate COMPLETE checkpoint path to fabric metadata+blob+CAS, not object half alone. Root supplies coherent binding and provider workspace. Preserve chunk/entry-before-head ordering, request-bound commit classification, coverage advancement, restart/restore and all local/credential custody. Existing remote heads/chunks/history require inventory and continuity or explicit retirement; current contents unknown")]),
        row(cells: [cell(text: "`gunbc.fabric.workspace_source::\{workspace_source_pack_wet,workspace_source_publish\}`"), cell(text: "Source pack under FabricWorkspace `sources/<address>`, scoped archive admission/exclusions, direct blob put"), cell(text: "Fabric blob consumer. Root supplies workspace-purpose binding. Preserve confidentiality/exclusion/placeholder archive checks and SHA-256 address. Local archive staging is temporary. Current `workspace_source_publish` records `staging_removed` but can exit success after failed removal: an explicit custody gap for cohort migration, not proof of clean completion")]),
        row(cells: [cell(text: "`gunbc.native_product_shared_store::\{native_product_shared_get,native_product_shared_put\}` and `native_product_shared_transfer::\{native_product_restore_wet,native_product_save_wet,native_product_save_one,native_product_finish\}`"), cell(text: "Build-product cache through get/put_cache_blob, permitted publisher standing, local archive extraction/install"), cell(text: "Fabric blob/cache consumer, preserve exact key/member validation, publisher/read authority, cache miss semantics, age/size bounds. Root supplies cache binding, never durable-history default. `native_product_finish` currently ignores release result; common custody completion must not carry this silent success forward")]),
        row(cells: [cell(text: "`gunbc.cloudflare.r2_origin_object::\{put_origin_object,fetch_origin_object,resolve_origin_target\}`; `gunbc.fabric.fabric_m0_origin_commit::\{commit_manifest_to_origin,commit_object_to_origin,process_exit_with_credential_custody\}`"), cell(text: "Fixed durable origin; create-only commit slot/output keys; fresh origin-owned GET staging produces sealed OriginReading before release. Commit observation seals same-slot transport+readback. DataEffectPermit constrains build-output sink"), cell(text: "Migrate storage access through fabric while retaining ORIGIN provenance and sink authority. Generic cached/local read cannot mint OriginReading. A candidate serving a local cache is ineligible for origin durability confirmation. Root must bind an admitted durable-origin realization; preserve commit key/attempt/manifest/output identity and history, 412 occupant readback and unknown handling. Inventory existing origin state before cut; no freshness assumption")]),
        row(cells: [cell(text: "`gunbc.instruments.fabric_m0_origin_object_probe::\{fetch_absent,roundtrip,canary_ending\}`"), cell(text: "Live durable-origin probe calls put/fetch and commit path"), cell(text: "Retain as evidence under same origin provenance; separately disposition fixed canary remote keys and existing retained objects. Running source does not prove current data or credentials")]),
        row(cells: [cell(text: "`gunbc.cloudflare.r2_conditional_put_race_probe::\{race_seed,race_round,race_cleanup,race_run_with_netrc\}`"), cell(text: "Deliberate direct signed conditional commands with common transfer classifier; cleanup uses low-level S3 DELETE"), cell(text: "Retain as provider falsification evidence, deliberately below generic fabric semantics. It is not an ordinary durable consumer migration. `race_cleanup` reports delete status but no independent absence; `race_exit` does not consume cleanup string, so this is not complete release evidence for a new pilot")]),
      ],
    },
    p(text: "The native-product restore also has a concrete seed entry: `src/v1/stage0/src/cli_run/native_product_cache.rs::restore_from_shared_store` invokes the DAG restore entry with `GUNBC_NATIVE_PRODUCT_KEY`, after making the job-private L1 directory; failure is a counted miss and the compiler builds cold, then re-verifies the restored artifact. Preserve this derived-cache fallback law, which is not lawful for durable history. A matching currently emitted save workflow was not found in the scoped source search; comments naming merge-queue publication alone are not execution evidence."),
    p(text: "Related direct custody/result compatibility modules: `fabric_m0_origin_commit`, `workspace_checkpoint_instrument`, `workspace_source`, instrument `fabric_m0_origin_object_probe`; tests `test.claim.cloudflare_r2_origin_object`, `test.claim.fabric_storage_r2_head`, `test.claim.workspace_checkpoint_instrument`, `test.claim.fabric_m0_origin_commit_witness`. `fabric_blob_shell::\{fabric_blob_get_script,fabric_blob_put_script\}` emits equivalent shell operation plans, but this audit found no production call of those entries in dag/src/v2; only its own helpers and `test.claim.fabric_blob_shell` consume its operation producers. Old fabric-plan/workflow comments describe intended pre-compiler use and do not establish present execution. Give this implementation/evidence an explicit retain-or-retire disposition; do not invent a production migration cohort from its comments."),
    p(text: "Provisioning roots: `r2_origin::gunbc_fleet_r2_bucket_allocations`, `bucket_purpose_origin_standing`, directional credential standings and `r2_token_mint_run` own allocation/mint/version pins. `r2_bucket_ensure::ensure` walks the allocated roster, using separately held fleet bucket-admin credentials obtained through GCP secret read. `ci_spec::\{gunbc_ci_r2_bucket_ensure_target,gunbc_ci_r2_bucket_ensure_invoke\}` and `fleet_converge_workflow::fleet_converge_r2_bucket_ensure_step` provide its configured route. Workspace source/checkpoint targets are `ci_spec::\{gunbc_ci_workspace_source_pack_target,gunbc_ci_workspace_checkpoint_measure_target,gunbc_ci_workspace_checkpoint_restore_target\}` and emitted to fleet-converge. The direct provider race target is `gunbc_ci_r2_conditional_put_race_probe_target`. These are configured source facts; historical token/lifecycle receipts cited in r2_origin are evidence at those dates, not a present live readiness check."),
    h3(text: "Git-backed roadmap events: distinct from already-migrated fabric event log"),
    TableBlock {
      header: row(cells: [cell(text: "Boundary"), cell(text: "Current behavior and target disposition")]),
      alignments: [AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "Root/layout"), cell(text: "`roadmap_event_carrier::\{roadmap_event_carrier_layout_for_instance,roadmap_event_carrier_layout\}` uses instance repo/worktree/tool paths and origin; srv2-preview uses its isolated `ui-preview-events.git`. Replace storage selection with root-supplied scoped fabric dependency. Preserve repo/instance namespace; never accidentally join preview and production events")]),
        row(cells: [cell(text: "Setup"), cell(text: "`roadmap_event_carrier_ensure` creates/fetches `roadmap-events` branch/worktree; `roadmap_event_carrier_sync` fetches and resets to remote. `roadmap_event_carrier_directory` is existing directory declaration. After replacement, retire obsolete Git-carrier setup but preserve any surviving repository/workspace needs of real source execution")]),
        row(cells: [cell(text: "Atomic write"), cell(text: "`roadmap_event_append`, `_append_private`, `_append_after_no_operation_receipt`, `_publish_private` validate operation identity, exact command/idempotency receipt and issue parent against one private fetched snapshot; publish event+operation receipt in one Git commit under exact force-with-lease expected commit")]),
        row(cells: [cell(text: "Read/recovery"), cell(text: "`roadmap_events_read`, `roadmap_standings_read`, `roadmap_events_read_all` use private snapshots and full decode. Snapshot cleanup is explicit `CarrierClosed` outcome; snapshot census observes owned leftovers. Fabric replacement needs coherent snapshot/conditional append plus per-node and all-event enumeration, preserving unreadable/absent distinctions and cleanup accounting until old snapshots are retired")]),
        row(cells: [cell(text: "Result authority"), cell(text: "`roadmap_bound_result_append[_private]` binds returned attempt result through existing request/event authority. Do not replace it with unrestricted object append")]),
        row(cells: [cell(text: "State cut"), cell(text: "Current canonical authority is published remote branch; unpushed private state deliberately is not shared truth. Before production cut inventory remote refs, events, operation receipts, namespaces and private snapshot residue; fence writers/reconcile complete data under owning codecs; make one authority switch. No reset-to-empty based on old fabric event-log drain history")]),
      ],
    },
    p(text: "Closed external operation-caller modules found: `gunbc.roadmap.\{roadmap_serve,roadmap_event_snapshot_census,roadmap_attempt_request_binding,roadmap_served_observation,roadmap_event_cli,roadmap_belt_tick_cli,roadmap_issue_command,roadmap_result_returned\}`. Their exact function/callee pairs are in JSON. Important workflow entrances include event CLI `roadmap_event_record_cli` / standing reports, UI detail/assignment/comment routes, issue command apply, result-return reconciliation, and served daily/query surfaces. These all need dispositions together. Provider carrier helper names may retire; no obligation to mechanically translate obsolete Git helpers."),
    h3(text: "Local materialization provider"),
    p(text: "`extdeps.realization.materialization_store_local` is already a realization under `std.materialization_provider`, `std.materialization_object`, `std.materialization_store_grant` and `std.artifact_store`. It is not an ordinary immutable-history store. The file provider must retain or be replaced by an admitted fabric-backed provider preserving its full cache law; a blanket substitution of fabric metadata CAS is insufficient."),
    p(text: "External production I/O consumer is `gunbc.compute.work_provider_local::\{compute_store,compute_store_open,compute_store_read,compute_store_commit,compute_dependency_read\}`. `compute_store_providers` consumes provider budget facts. `gunbc.materialization_store_budgets::\{materialization_store_host_ceiling_bytes,materialization_store_local_facts\}` supplies policy; `gunbc.instruments.native_materialization_store_closure::store_path_cases` is implementation evidence. Tests include provider wet, pure and seal witnesses; keep direct-provider evidence even after ordinary callers use a fabric-owned realization."),
    p(text: "Current root: `HostDashboardInstance.materialization_store_root`; `std.materialization_store_grant::MaterializationStoreRoot` separates DurableHostVolume (`/var/lib/gunbc/materialization-store`), PersistentInstanceWorkspace, FrameJobWorkspace and WitnessScratchRoot. Live deployment `deployment_srv1_host_directories` provisions store and sibling staging; `compute_run_unit_cold` explicitly prepares its roots. Source built-ins configure macbook/srv2 persistent roots, srv1 durable root, some instances no root and hermetic jobs frame roots. These are configured scopes, not observed disk populations."),
    p(text: "`local_store_initialize` create-only publishes identity marker then opens actual marker; missing root fails rather than manufacturing a shadow store. `local_store_open` validates marker/catalog/budgets then runs scoped sweep before minting LocalStoreCapability. Marker identity on receipts, process/family holds, liveness recovery, windowed CAS index generations and re-observation, budget accounting, LRU eviction, oversize-before-eviction, orphan sweep and doomed-byte accounting all survive. Blob parts are copied into store-owned files, verified, then linked create-only; failed eviction remains charged. Missing admissible cache record permits recomputation; unreadable/corrupt/incomplete hit and missing required byte parts refuse. Do not turn these into absent cache hits or claim durable event history may be evicted under this policy."),
    p(text: "Existing-state disposition: preserve marker instance identity and indexed records/parts/holds/window generations if retained, or authorize explicit retirement of derived cache state with quiescence/cleanup and consequences for recomputation. Cache classification alone is not authorization to delete unknown live state or ignore active holds. Local staging/verified executable readings still need local custody even if durable cache realization changes. Parent/root supplies a capability satisfying materialization contract; compiler inference is not required or claimed."),
    h3(text: "Complete direct root-ensure test population"),
    p(text: "15 `test.claim` modules, 24 direct calls (one function has two calls). These are immediate compatibility/readiness-fixture obligations if the helper changes, not 15 backend migrations:"),
    ol(items: [li(text: "`workspace_allocation_storage_wet_witness::workspace_runtime_intent_replays_releases_and_reuses_one_fabric_head` (1)"), li(text: "`workspace_acquisition_storage_wet_witness::\{acquisition_cancellation_temporary_store,concurrent_actor_replacement_admits_exactly_one\}` (2)"), li(text: "`serving_caller_backlog_wet_witness::\{only_one_of_two_retries_claims_the_seat_by_real_execution,completion_fixture,failover_fixture,only_one_of_two_acquired_seats_for_one_hold_leaves_settle_bound_by_real_execution\}` (4)"), li(text: "`workspace_gateway_refresh_witness::refresh_failure_withdraws_success_delayed_success_cannot_revive_and_new_refresh_recovers` (1)"), li(text: "`spark.pair_serving_authority_log_real_execution::alr_witness_root_ready` (1)"), li(text: "`workspace_request_consumer_witness::\{persisted_expired_request_settles_after_reader_restart_without_offers,waiting_reason_is_durable_but_cannot_refresh_readiness_or_overwrite_retirement,enrolled_roster_discovers_a_customer_request_the_operator_pass_misses\}` (3)"), li(text: "`live_deploy.tailnet_door_cutover_journal_wet_witness::the_cutover_journal_survives_its_writer_and_fences_a_stale_write` (1)"), li(text: "`fabric.fabric_partition_read_wet_witness::fresh_store` (1)"), li(text: "`roadmap.roadmap_task_store_wet_witness::\{task_store_create_replay_and_conflicting_key,task_store_revise_stale_and_supersede\}` (2)"), li(text: "`roadmap.workspace_allocation_write_seam_wet_witness::seam_admitted_create_and_release_land_in_the_store` (1)"), li(text: "`fabric.fabric_event_log_wet_witness::fresh_files` (1)"), li(text: "`workspace_prelaunch_expiry_hold_witness::expired_reserved_controller_retires_even_when_cleanup_is_uncertain` (1)"), li(text: "`durable_cas_fabric_storage_real_execution::dcel_store_ready` (1)"), li(text: "`fabric.fabric_storage_file_store_wet_witness::\{fresh_store,a_declared_entry_mode_is_the_published_mode_of_objects_and_heads\}` (2)"), li(text: "`fabric.fabric_state_namespace_wet_witness::witness_public_head_cannot_alias_private_state_object` (2)")]),
    p(text: "Other external direct callers: `gunbc.compute.host_capacity::compute_capacity_store_ensure`, `gunbc.instruments.source_snapshot_handoff::prepare_snapshot_workspace`, `gunbc.instruments.fabric_event_log_probe::fabric_event_log_probe`. Do not infer setup conformance from tests that pre-create roots and ignore the readiness result (`fresh_files` and partition `fresh_store` currently bind `_ready`)."),
    h3(text: "Source-snapshot first consumer and released R2 fixture"),
    p(text: "Current concrete metadata consumer `fabric_source_snapshot::\{capture_source_snapshot,materialize_source_snapshot\}` has one external code consumer module, `gunbc.instruments.source_snapshot_handoff`. The unchanged no-argument instrument is an end-to-end executed integration entry, not an already-deployed production workflow. It acquires a compiler binary; creates synthetic public/v2/test source inclusions; captures; materializes into `ProviderWorkspace`; runs a real child process; checks mismatch/missing/corrupt/escape/duplicate/unsafe-allocation/squatted-base controls; releases workspaces. Ordinary snapshot helpers lose concrete file-root operands; intentionally destructive file-provider fixtures stay explicit isolated provider controls. Capturing metadata does not move local source paths, provider workspace or child execution into object storage."),
    p(text: "The R2 pilot cannot truthfully claim isolated release merely by selecting existing `FabricWorkspace`: its retention is released-never and keys are global `objects/<ref>`. Nor does using `FabricCacheBlobs` automatically release these metadata objects: its lifecycle scope is `blobs/`, not `objects/`. Required DESIGN task before executing the R2 pilot: model an admitted fabric-owned fixture binding with isolated bucket/namespace, bounded synthetic population and no production head/state authority; root resolves it once for capture/get; explicit fixture release authority tracks every possible publication (including uncertain writes), performs release, and independently establishes absence. Account separately for local staging and credential cleanup. Use existing low-level R2 delete/lifecycle provider capabilities as implementations after the domain contract is modeled, never add hand-rolled delete loops to snapshot consumers or grant delete to ordinary durable callers. A release that is refused/unknown keeps an outstanding obligation and cannot report a fully clean pilot success. No new resource provisioning/execution is authorized by this design-only work."),
    h3(text: "Exact direct provider/Git call roster"),
    p(text: "These rows complement the semantic cohort rows above. Setup and state standing inherit that cohort; repeated operations are one exact enclosing caller/callee pair. Test/instrument fixtures are dispositioned in their evidence rosters, rather than counted as production stores."),
    TableBlock {
      header: row(cells: [cell(text: "Authority"), cell(text: "Consumer module"), cell(text: "Enclosing caller -> operation")]),
      alignments: [AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "extdeps.realization.materialization_store_local"), cell(text: "gunbc.compute.work_provider_local"), cell(text: "compute_dependency_read -> local_store_lookup_parts; compute_store_commit -> local_store_commit; compute_store_open -> local_store_initialize; compute_store_providers -> local_store_family_budget; compute_store_providers -> local_store_family_provider; compute_store_read -> local_store_lookup")]),
        row(cells: [cell(text: "extdeps.realization.materialization_store_local"), cell(text: "gunbc.materialization_store_budgets"), cell(text: "materialization_store_host_ceiling_bytes -> local_store_budget_sum; materialization_store_local_facts -> materialization_store_local_facts_at")]),
        row(cells: [cell(text: "gunbc.cloudflare.r2_origin_object"), cell(text: "gunbc.fabric.fabric_m0_origin_commit"), cell(text: "commit_manifest_to_origin -> fetch_origin_object; commit_manifest_to_origin -> put_origin_object; commit_object_to_origin -> fetch_origin_object; commit_object_to_origin -> put_origin_object")]),
        row(cells: [cell(text: "gunbc.cloudflare.r2_staged_transfer"), cell(text: "gunbc.cloudflare.r2_conditional_put_race_probe"), cell(text: "race_cleanup -> classify_s3_transfer; race_seed -> classify_s3_transfer")]),
        row(cells: [cell(text: "gunbc.cloudflare.r2_staged_transfer"), cell(text: "gunbc.cloudflare.r2_origin_object"), cell(text: "classify_origin_fetch -> classify_r2_fetch; classify_origin_put -> classify_r2_put; fetch_origin_object -> r2_fetch_into_staging; fetch_origin_object -> r2_release_staging; put_origin_object -> r2_put_staged_file")]),
        row(cells: [cell(text: "gunbc.cloudflare.r2_staged_transfer"), cell(text: "gunbc.fabric.fabric_blob_r2"), cell(text: "get_fabric_blob -> r2_fetch_into_staging; get_fabric_blob -> r2_release_staging; put_fabric_blob -> r2_put_staged_file; release_fabric_blob_staging -> r2_release_staging")]),
        row(cells: [cell(text: "gunbc.cloudflare.r2_staged_transfer"), cell(text: "gunbc.fabric.fabric_object_r2"), cell(text: "get_fabric_object_r2 -> r2_fetch_into_staging; get_fabric_object_r2 -> r2_release_staging; put_fabric_object_r2 -> r2_put_staged_file; put_fabric_object_r2 -> r2_release_staging")]),
        row(cells: [cell(text: "gunbc.cloudflare.r2_staged_transfer"), cell(text: "gunbc.fabric.fabric_storage_r2_head"), cell(text: "r2_head_advance -> r2_put_staged_file; r2_head_advance -> r2_release_staging; r2_head_observe -> r2_fetch_into_staging; r2_head_observe -> r2_release_staging")]),
        row(cells: [cell(text: "gunbc.fabric.fabric_blob_r2"), cell(text: "gunbc.fabric.fabric_object_r2"), cell(text: "get_fabric_object_r2 -> resolve_fabric_blob_target; put_fabric_object_r2 -> resolve_fabric_blob_target")]),
        row(cells: [cell(text: "gunbc.fabric.fabric_blob_r2"), cell(text: "gunbc.fabric.workspace_checkpoint_instrument"), cell(text: "workspace_chunk_of_file -> put_workspace_chunk; workspace_head_binding -> resolve_fabric_blob_target; workspace_measure_on_btrfs -> get_fabric_blob; workspace_measure_on_btrfs -> release_fabric_blob_staging; workspace_measure_on_btrfs -> resolve_fabric_blob_target; workspace_restore_after_barrier -> put_workspace_chunk; workspace_restore_entry -> get_workspace_chunk; workspace_restore_entry -> release_fabric_blob_staging")]),
        row(cells: [cell(text: "gunbc.fabric.fabric_blob_r2"), cell(text: "gunbc.fabric.workspace_source"), cell(text: "workspace_source_publish -> put_fabric_blob")]),
        row(cells: [cell(text: "gunbc.fabric.fabric_blob_r2"), cell(text: "gunbc.native_product_shared_store"), cell(text: "native_product_shared_get -> get_cache_blob; native_product_shared_put -> put_cache_blob")]),
        row(cells: [cell(text: "gunbc.fabric.fabric_blob_r2"), cell(text: "gunbc.native_product_shared_transfer"), cell(text: "native_product_finish -> release_fabric_blob_staging")]),
        row(cells: [cell(text: "gunbc.fabric.fabric_object_r2"), cell(text: "gunbc.fabric.workspace_checkpoint_instrument"), cell(text: "workspace_instrument_commit_admitted -> put_fabric_object_r2; workspace_stored_entry_read -> get_fabric_object_r2")]),
        row(cells: [cell(text: "gunbc.fabric.fabric_storage_file_store"), cell(text: "gunbc.compute.host_capacity"), cell(text: "compute_capacity_store_ensure -> fabric_storage_file_root_ensure")]),
        row(cells: [cell(text: "gunbc.fabric.fabric_storage_r2_head"), cell(text: "gunbc.fabric.fabric_object_r2"), cell(text: "get_fabric_object_r2 -> r2_head_staging_of; put_fabric_object_r2 -> r2_head_staging_join; put_fabric_object_r2 -> r2_head_staging_of")]),
        row(cells: [cell(text: "gunbc.fabric.fabric_storage_r2_head"), cell(text: "gunbc.fabric.workspace_checkpoint_instrument"), cell(text: "workspace_closure -> r2_head_read; workspace_custody_of_r2_staging -> r2_head_staging_of; workspace_head_binding -> r2_head_binding; workspace_instrument_commit_admitted -> r2_head_advance; workspace_instrument_commit_admitted -> r2_head_fabric_advance; workspace_observed_entry -> r2_head_read; workspace_restore_barrier -> r2_head_cas_admission; workspace_restore_barrier -> r2_head_cas_ground; workspace_timed_commit -> r2_head_cas_admission; workspace_timed_commit -> r2_head_cas_ground")]),
        row(cells: [cell(text: "gunbc.roadmap.roadmap_event_carrier"), cell(text: "gunbc.roadmap.roadmap_attempt_request_binding"), cell(text: "attempt_request_binding_commit_for_instance -> roadmap_event_carrier_layout_for_instance; attempt_request_binding_commit_for_instance -> roadmap_events_read")]),
        row(cells: [cell(text: "gunbc.roadmap.roadmap_event_carrier"), cell(text: "gunbc.roadmap.roadmap_belt_tick_cli"), cell(text: "belt_tick_exit_with_snapshot_closes -> carrier_snapshot_close_failures")]),
        row(cells: [cell(text: "gunbc.roadmap.roadmap_event_carrier"), cell(text: "gunbc.roadmap.roadmap_event_cli"), cell(text: "roadmap_event_record_cli -> roadmap_event_append; roadmap_event_record_cli -> roadmap_event_carrier_layout_for_instance; roadmap_event_record_cli -> roadmap_events_read; roadmap_event_record_exit -> carrier_snapshot_close_failures; roadmap_event_standing_report -> carrier_report_with_snapshot_close; roadmap_event_standing_report -> roadmap_event_carrier_layout_for_instance; roadmap_event_standing_report -> roadmap_events_read")]),
        row(cells: [cell(text: "gunbc.roadmap.roadmap_event_carrier"), cell(text: "gunbc.roadmap.roadmap_event_snapshot_census"), cell(text: "roadmap_snapshot_census_at -> roadmap_event_snapshot_namespace; roadmap_snapshot_census_for_instance -> roadmap_event_carrier_layout_for_instance; roadmap_snapshot_census_of -> roadmap_event_snapshot_path_owned; roadmap_snapshot_census_read -> carrier_exec; roadmap_snapshot_census_read -> roadmap_event_snapshot_namespace; snapshot_census_population_fault -> roadmap_event_snapshot_path_owned")]),
