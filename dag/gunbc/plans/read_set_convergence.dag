module gunbc.plans.read_set_convergence

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetiresWhen, PlanIsAuthorityOnly }
import std.markdown { MarkdownBlock }
import gunbc.plans.md_helpers { h2, h3, p, li, ul, ol, quote }

fn read_set_convergence_inventory_row(id: String, location: String, io: String, standing: String, disposition: String) -> MarkdownBlock {
  p(text: concat(concat(concat(concat(concat(concat(concat(concat("**", id), ".** "), location), " -- "), io), " **Standing:** "), standing), concat(" **Disposition:** ", disposition)))
}

fn read_set_convergence_body() -> List<MarkdownBlock> {
  [
    quote(blocks: [
      p(text: "**Goal:** regenerate exactly what is needed from exactly what changed. Every generated product (a stage0 mirror, a seed-build artifact, a parse verdict, a required-job verdict) is converged by one rule: it is still valid while nothing its generator read has changed and the generator is the same; otherwise it is regenerated, alone. **Method:** one read-set validation authority, consumed through the existing convergence modality (`gunbc.ensure` `ensure_decide`), with a dry run that derives every decision and actuates none. **Validation:** each phase switches one production consumer onto the authority and deletes what it displaces."),
      p(text: "**Operator direction (2026-11-09, session bright-ibex-807):** T11 (heal's early exit) must use the same logic as the compiler's demand closure, not a fourth bespoke check; design the consolidation, cleanup and migration of every affected-set mechanism, implement only the parts consumed now, hand off the rest; delete or consolidate the rest; regenerate exactly what is needed from exactly what changed, as a convergence pattern with dry run.")
    ]),
    h2(text: "1. Displaced cost"),
    ul(items: [
      li(text: "**Heal** (`gunbc.heal_workflow`, `.github/workflows/heal.yml`) regenerates the whole population on every same-repository pull request touching `dag/**`, `src/v1/**` or `src/v2/**`: all 172 stage0 mirrors (`claim_executor --regen-round-cost --base-mirror`) and all 13 seed-build artifacts (`gunbc.seed_build_artifact_emit` `seed_build_artifacts`). Median wall time 65 minutes (8 successful runs before 2026-11-09, range 51-72), paid even by a plan-only change. It does no change selection at all."),
      li(text: "**What heal commits stays committed (T10, 2026-11-09).** Every one of the 185 products is read by `cargo build` of the seed before any gunbc binary exists: the 172 mirrors are all reached from the seed crate (`src/v1/stage0/src/lib.rs` and the binaries), the nine generated Rust files and `.cargo/config.toml` and `src/v1/stage0/linked_partition_crates.generated.txt` are read by the crate, `build.rs` or cargo, and the three generated `.dag` files under `dag/gunbc/stage0/` are mirrored into the seed and used there. None becomes on-demand without fetching a prebuilt seed first, which is a bootstrap redesign outside this plan. So the saving is in regenerating fewer of them, not in committing fewer."),
      li(text: "**Four spellings of one question.** Twenty-one mechanisms answer some form of what does this change affect (section 3). Three run in production, each with its own matcher, its own unknown handling and its own everything-changed trigger; the rest are dead, stubbed or witness-only, several under prose claiming production use."),
      li(text: "**The authority does not exist yet.** `gunbc.plans.demand_engine_program` section 2.3 lists the dependency read set with existing authority none yet, and its cross-run hit protocol already rules manifest-validation for the first consumer. This plan is that relation's first landing, scoped to file-grain products; it is a slice of that program, not a second one.")
    ]),
    h2(text: "2. The model"),
    p(text: "This is a file-grain PROJECTION into `gunbc.plans.demand_engine_program`'s keying relations, not a redefinition of them. The engine's identities stay authoritative: demand identity (the question asked), dependency read set (what the answer consumed), evaluation identity (the demand under its sealed inputs and evaluator semantics), result content identity (what was produced), and realization product identity (handler, generator, toolchain, configuration). A generated mirror or artifact is a realization product answering an admitted request; this plan names the file-grain parts it needs and binds them to those relations."),
    h3(text: "2.1 Three separate facts per product"),
    ul(items: [
      li(text: "**Product.** One generated output with a subject: a mirror file, a seed-build artifact, one module's parse verdict, one job's verdict."),
      li(text: "**Generator semantics identity.** The executable generator and the implementation semantics relevant to the product: the seed compiler that ran plus the generator module, and any input that genuinely determines the generator's semantics. A different identity invalidates the product. A seed hash over-approximates (any seed change invalidates every product); that is coarse and correct."),
      li(text: "**Input dependencies: observed or declared.** The files, probes, directories, configuration, fixtures and environment the result depends on. OBSERVED members are recorded by watching the real generator run (the T9 recorder, `src/v1/stage0/src/cli_run/demand_acquire.rs` `read_set_record`); member kinds `File` (read), `Probe` (looked for and absent), `Dir` (enumerated, matched on a path-segment boundary). DECLARED members cover inputs the recorder does not instrument: fixtures, Cargo manifests and `.cargo/`, the toolchain pin, workflow definitions. An uninstrumented dependency never disappears from the rule; it stays a declared member until the recorder observes it. Today's `gunbc.read_set_restore` `fast_lane_fixed_input_rules` become declared members, except where an input IS generator semantics (the seed sources under `src/v1/`, which enter through the seed's identity)."),
      li(text: "**Result content identity.** The digest of what was actually produced, recorded when it was produced. For committed products, the Git blob id of the committed bytes is that identity, so no second store is introduced."),
      li(text: "**Validation mode is not member identity.** A member's identity is its path and kind; it is checked either by path-diff since the recording revision (A1 today, needs that revision reachable) or by content digest (A2 today, self-contained). Both are modes of one validator.")
    ]),
    h3(text: "2.2 Validation: the one rule, and only for the inputs"),
    p(text: "The shared validator answers one question: are the sealed dependency observations still valid. Inputs: the recorded read set, the generator semantics identity it was recorded under, the current generator identity, and the current state of the members (changed paths since the recording revision, or current digests). Output: `ReadSetValid`; `ReadSetInvalidated` naming the changed members or the changed generator; or `ReadSetUnestablished` with a typed cause (recording unreadable or corrupt, recording revision not an ancestor, generator identity unreadable, a member path not normalized, the local observation incomplete). Matching is exact for `File` and `Probe` and segment-prefix for `Dir`; the unbounded suffix match in `v2.lens.module_graph` `path_matches_touched` and its Rust twin is deleted as a defect (`ba.dag` matches `a.dag`). The validator never widens or narrows on its own; it has no opinion about what an outcome costs."),
    h3(text: "2.3 Product validity: inputs AND result binding, with the four hit/miss states"),
    p(text: "Valid inputs do not make a product valid: a hand-edited generated file can sit under a valid read set. So a product consumer checks, in order, following the demand engine's manifest-validation protocol: (1) the manifest: absent is COLD (a genuinely new product; generate it and write its first manifest), unreadable or corrupt is a typed refusal with a repair route, never silently cold; (2) the read set via 2.2: invalidated is STALE (regenerate); (3) the result binding: the committed product's content identity equals the one the manifest recorded, otherwise RESULT DIVERGED (regenerate, and report it, since something wrote the product outside its generator); absent product is a MISSING RESULT (regenerate). Only all three passing is valid."),
    h3(text: "2.4 Each consumer maps outcomes explicitly"),
    ul(items: [
      li(text: "**Required-job consumer (the fast lane).** Valid: skip the build. Stale, cold, diverged, missing or any `ReadSetUnestablished`: `FullRun` with the typed cause. It never refuses the job and never skips on doubt; this is its current safety contract, kept."),
      li(text: "**Artifact-convergence consumer (heal).** Valid: `Noop`. Stale, cold, diverged, missing: regenerate. Corrupt or unreadable manifest, or an incomplete observation: `Refuse` with the cause. It goes through `gunbc.ensure` `ensure_decide` with `EnsureMayApply` and the regeneration as its plan, so the decision is `std.upsert_decision` `Noop`, `Apply` or `Refuse` per product.")
    ]),
    h3(text: "2.5 Dry run is an execution mode, not an ensure policy"),
    p(text: "`ensure_decide` under `EnsureObserveOnly` answers `Refuse` for a known drift (its contract), so it cannot list what would regenerate. The dry run therefore derives the full decision with `EnsureMayApply` and then does not actuate: it prints each product's `Noop`, `Apply` with its cause, or `Refuse`, and writes nothing. Planning and authorization stay separate; `ensure_decide`'s contract is unchanged. A dry run states which products would regenerate and why; it does not claim to know their future bytes. A local dry run observes staged, unstaged and relevant untracked inputs, or refuses as an incomplete observation."),
    h3(text: "2.6 Products form a graph; selection follows it"),
    p(text: "Products depend on products: a regenerated mirror changes the seed, and the seed is part of every seed-build artifact's generator identity. Validating a downstream product against the OLD upstream would falsely answer valid. So selection walks the product graph upstream first: an invalidated upstream product invalidates every product whose generator identity or read set contains it; then regeneration; then independent readback. The reverse index (member to products, built from the read sets) finds DIRECT readers fast; the transitive order comes from the product graph, not from the index. `gunbc.regen_affected_set`'s reverse walk over the whole-pool edge index is replaced by this."),
    h3(text: "2.7 Apply is grounded by readback, and where manifests live"),
    p(text: "`gunbc.ensure` `ensure_reconcile` receives an independently observed readback (the bytes now committed and their blob id) and the recorded read set, never the generator's return. For committed products the publication boundary is the existing heal publisher's exact-head compare-and-set commit (`gunbc.heal_publisher_workflow`), and the manifest is committed in the same commit as the products it describes. Ephemeral products (the required-job verdict, parse verdicts) keep their receipts in the Actions cache keyed by revision, as today (decision D2)."),
    h2(text: "3. Inventory and disposition"),
    p(text: "Read at main `ed30451e610` by name search over `dag/`, `src/v2/` and `src/v1/stage0/src` plus caller tracing; a candidate set, not a census. Live means invoked on an executing production route (a workflow step, the required job, heal, a verb a workflow calls). Phase names refer to section 4."),
    h3(text: "A. Live"),
    read_set_convergence_inventory_row(id: "A1", location: "Fast lane: `gunbc.read_set_restore` `fast_lane_decide`, `fast_lane_decide_diff`, `fast_lane_fixed_input_rules`; recorder `demand_acquire.rs` `read_set_record`; `gunbc.read_set_publish`; `gunbc.read_set_schema`; emitted into `witnesses.yml` as the step Decide whether the fast-lane unit covers this change.", io: "In: the main ancestor's recorded read set, `git diff --name-only` from it, fixed prefixes. Out: skip or full run with a typed `FastLaneFullRunCause`. Job grain; unknowns widen with a typed cause.", standing: "live, v2-bootstrap on pull requests.", disposition: "first consumer of the authority (P1). Its fixed inputs are sorted under 2.1: fixtures, Cargo manifests, `.cargo/`, the toolchain pin and `.github/` become declared input members; `src/v1/` stays an invalidating input until the current seed identity can be established independently of the restored binary (before skipping the seed build), and only then moves into generator semantics identity."),
    read_set_convergence_inventory_row(id: "A2", location: "Parse-verdict reuse: `gunbc.parse_verdict_schema` `parse_verdict_standing`; `v2.cli.parse_verdict_reuse` `parse_verdict_base_read`; `v2.cli.population_verbs` `population_parse_standing`; steps from `gunbc.witness.compiler_gate_workflow`.", io: "In: base and head compiler identity, each module's source digest, restored receipts. Out: per module Reused or one of five typed misses. Module grain, no closure.", standing: "live, v2-bootstrap on pull requests.", disposition: "instance with `Content` members (P3)."),
    read_set_convergence_inventory_row(id: "A3", location: "Partition rebuild scope: `gunbc.stage0_partition_rebuild_scope` `stage0_partition_rebuild_decision` and `stage0_partition_move_explained_by_affected_inputs` (calls `gunbc.regen_affected_set` in a child `claim_executor --regen-partition-move-explanation`); host `required_regen_host.rs` `partition_rebuild_actuation`, `install_convergence_stage`.", io: "In: changed mirror basenames, crate partition rows. Out: packages to rebuild, `WholeCompilerRebuildRequired`, or a typed refusal. Crate grain.", standing: "live inside heal, but only as a guard: the full seed cargo build still runs; the host passes `unlocatable` as empty, so unlocatable collapses into unexplained.", disposition: "consumes the per-mirror selection (P4) together with its own modeled build inputs: a package's inputs are its mirrors PLUS the partition-generation and shared-build inputs `gunbc.stage0_partition_rebuild_scope` declares as affecting every package (or a recorded package-build read set), never mirror ownership alone; the explanation child is deleted."),
    h3(text: "B. Reverse closures, not on a production selection route"),
    read_set_convergence_inventory_row(id: "B1", location: "`gunbc.regen_affected_set` (`regen_affected_set`, `regen_reverse_closure`, `regen_generation_inputs`, `regen_bootstrap_edges`); host `required_regen_host.rs` `regen_module_edges` over `cli_run` `whole_pool_closure_edge_index`.", io: "In: edited modules, unlocatable paths, whole-pool edges, mirror rows. Out: `AffectedMirrors`, `WholePopulation`, `EditedSetUnlocatable`. Mirror grain.", standing: "report-only flag `--regen-affected-set`; live only inside A3's child. The host lockstep passes its own reached set, so it cannot catch host under-reach.", disposition: "LIVE from P2 as heal's derived per-mirror handler (option A, 2026-11-09); deleted in P4, replaced by recorded read sets and the index (2.4); its bootstrap edge (v1_rt.rs) becomes a read-set member of that product."),
    read_set_convergence_inventory_row(id: "B2", location: "`v2.workflow.required_regen` `regen_scope_select`; `v2.workflow.regen_convergence_transaction` `regen_admit_affected_bound`.", io: "In: B1's bound, committed basenames, changed surfaces. Out: a scope selection and a changed-within-bound admission. Mirror grain.", standing: "flag `--regen-affected-scope`, which no workflow passed before P2.", disposition: "LIVE from P2: heal passes the flag; deleted in P4, when scoping becomes ensure per product over recorded read sets."),
    read_set_convergence_inventory_row(id: "B3", location: "`v2.lens.affected_set` (`affected_set`, `affected_set_reading`, `affected_set_closure`), `v2.std.change` `AffectedSet`, `v2.lens.edit_locus` `affected_set_reading_from_git_diff` (and `_provenance`).", io: "In: an in-memory tree and a diff. Out: a `ReExecFrontier` per node and dimension, or `FailClosed`. Node grain.", standing: "the edit_locus entry has no caller, but the lens itself has code consumers: `v2.compiler.self_host.compiler_closure_emit` calls `affected_set_closure` (a frozen emitter with its own replacement disposition), and `v2.lens.wiring_liveness_preflight`, `v2.lens.registry.completeness`, `v2.std.node_reflection`, `v2.lens.witness_cost_locality` and others import its carriers.", disposition: "NOT in P0. Kept frozen; deleted together with the frozen compiler-closure emitter's own migration, once its other importers move. The edit_locus git-diff entry and D2's use go in P0."),
    read_set_convergence_inventory_row(id: "B4", location: "`v2.workflow.compile_door_ledger` `affected_ledger_from_diff`, `door_ledger_over_affected_set`.", io: "In: a name-status diff, pool roots. Out: a ledger over the changed files only (no closure).", standing: "AuditOnly, witness only.", disposition: "delete in P0."),
    h3(text: "C. Forward closures, not on a production route"),
    read_set_convergence_inventory_row(id: "C1", location: "`v2.lens.module_graph` `demand_closure_walk`, `dependency_closure_live_excluding`, `import_closure_live`, `entry_affected_by_touched_paths` (and `_excluding`), `touched_path_in_closure`, `path_matches_touched`; edges from host builtins `cli_run` `dependency_resolution_facts_at`, `entry_resolve` `module_declaration_fact_at`.", io: "In: entry, pool roots, touched paths. Out: reached files, or a Bool. File grain. Unknowns narrow silently (an unreadable or unaccounted importer contributes no edges).", standing: "the Bool's only consumer is C3 (dead); `import_closure_live` is read by `gunbc.decoder_execution_identity` and witnesses.", disposition: "the walk stays as the derived handler (P5) once narrowing refuses; the touched-path wrappers and the suffix matcher are deleted in P0."),
    read_set_convergence_inventory_row(id: "C2", location: "`src/v2/lens/affected_set/entry_selection.dag`.", io: "One scaffold disposition naming C1; no logic.", standing: "no importers.", disposition: "delete in P0."),
    read_set_convergence_inventory_row(id: "C3", location: "`gunbc.instruments.dag_compile_clean_scope` `compile_clean_affected_entry_paths_from_roster`, `compile_clean_scope_disposition_probe`; Rust `compile_clean.rs` `compile_clean_scope_plan_for_ci` via the interpreter builtin `witness_gates.rs` `witness_layer_roots_compile_clean_check`.", io: "In: pool roots, touched paths, roster. Out: affected entries, WholeTree or Skip.", standing: "dead: the builtin has no .dag caller and `dag_compile_clean_gate` returns `GateNotRun`.", disposition: "delete in P0, both halves."),
    read_set_convergence_inventory_row(id: "C4", location: "Rust twin `cli_run.rs` `entry_file_touched_via_import_closure`, `repo_paths_match_touched`; caller `compile_clean.rs` `compile_clean_scope_plan_from_touched_paths_floor_fast_impl`.", io: "In: entry, facts, touched paths. Out: Bool or a typed refusal on the entry only, which the caller turns into WholeTree.", standing: "tests only, mostly ignored; its certification module has no test.", disposition: "delete in P0."),
    read_set_convergence_inventory_row(id: "C5", location: "`cli_run.rs` `effect_reach_touched_via_path_literals`, `reads_live_tree_effective`, `LiveReadSelectionRow` `touched_by`; `entry_resolve` `import_closure_live_paths`.", io: "Various Bool or path answers; `import_closure_live_paths` walks import edges only.", standing: "the first three have no production caller; `import_closure_live_paths` is read by A1's parse-identity recording.", disposition: "delete the first three in P0; `import_closure_live_paths` keeps its one consumer and loses the claim to realize `import_closure_live`."),
    read_set_convergence_inventory_row(id: "C6", location: "`gunbc.instruments.rust_stage0_gates` `unit_is_affected`, `any_declared_unit_affected`.", io: "Ignores its arguments and answers true.", standing: "stub; its consumer chain is un-enrolled since 2026-07-11.", disposition: "delete in P0."),
    read_set_convergence_inventory_row(id: "C7", location: "`v2.std.demand_engine` `demand_closure_step`, `demand_engine_closure`.", io: "In: demand prerequisites. Out: the seen set; partial on fuel exhaustion.", standing: "witness only.", disposition: "out of scope: the demand engine's own judgment-grain closure, owned by `gunbc.plans.demand_engine_program`."),
    h3(text: "D. Change-driven selection, not on a production route"),
    read_set_convergence_inventory_row(id: "D1", location: "Floor changed-witness family: `v2.workflow.required_floor` changed-selection functions, `v2.workflow.floor_changed_witness`, `v2.workflow.floor_cost_debt_edit` ceilings; Rust `cli_run/required_floor_runner.rs` `floor_diff_edits_from_line_ranges_reading`.", io: "In: a supplied changed Bool or identity list, a git diff. Out: dispositions, blockers, ceilings.", standing: "dead: the floor lane is withdrawn (`gunbc.rung_drop` `v1_required_lanes_withdrawn`); Rust callers sit under cfg(test).", disposition: "delete in P0 after enumerating consumers (outside the gate)."),
    read_set_convergence_inventory_row(id: "D2", location: "`v2.std.probe_selector` `probe_select_affected_test_claims`, `ci_test_claim_coverage_for_affected`.", io: "In: roster, an AffectedSet, budget. Out: selected claims; FailClosed selects all.", standing: "dead.", disposition: "delete in P0."),
    read_set_convergence_inventory_row(id: "D3", location: "`gunbc.source_admission_selection` `select_source_admission`, `source_admission_is_incremental`, `incremental_changed_module_paths`.", io: "In: base and head manifests, a receipt, mechanism identity. Out: incremental, no-op, whole, or refused, from its own keyed diff.", standing: "dead; its header says it was never wired.", disposition: "delete in P0."),
    read_set_convergence_inventory_row(id: "D4", location: "`gunbc.floor.incremental_floor_authority` `floor_affected_closure_sound`, `floor_selection_admission`.", io: "In: a supplied closure and measured delta. Out: admitted or whole population required.", standing: "dead by its own text.", disposition: "delete in P0."),
    read_set_convergence_inventory_row(id: "D5", location: "`gunbc.ci.ci_cost_arc_closeout_receipt` `AffectedSelection`.", io: "A historical tag on one hand audit.", standing: "dead.", disposition: "delete in P0."),
    p(text: "**Same word, different concept (out of scope):** `gunbc.compute.test_selection` `select_witness_files` (label pattern, not change), `std.selected_witness_bundle` (consumes a selection), `gunbc.roadmap.roadmap_execution_contract` `validation_consumes_affected_set_window` (provisions a diff window), `gunbc.runner.runner_service_activation` `runner_transition_affected_set_identity` (hash of refused unit names)."),
    h3(text: "G. Disagreements the one rule settles"),
    ol(items: [
      li(text: "Unknowns: C1 narrows silently; C4 refuses and its caller widens; A1 widens with a typed cause; B1-B4 refuse; D2 widens. Settled by 2.2 and 2.4: the validator returns a typed outcome and each consumer maps it explicitly (full run for the required job, refuse or regenerate for heal)."),
      li(text: "Matching: unbounded suffix (C1, C4) against exact plus directory prefix (A1). Settled by 2.2: exact, or segment-prefix for `Dir`."),
      li(text: "Edges: the whole-pool index (B1), keyed per-module reads (C1), import-only adjacency (C5), cargo package rows (A3), an in-memory dependency lens (B3). Settled by 2.1: observed reads are the default; one derived handler later."),
      li(text: "Everything changed, four spellings (A1 prefixes, A2 compiler identity, B1 module prefixes, A3 roster). Settled by 2.1: each is sorted into generator semantics identity (what determines the generator) or a declared input member (fixtures, Cargo, toolchain, workflows, the partition shared-build inputs), never dropped."),
      li(text: "Edit source: `floor_git_diff_range` (B1, B2), `floor_observe_git_diff_name_status_for_ci` (B4), raw git diff against a restored ancestor (A1). Settled by the observation input of 2.2: changed paths since the recording revision, or digests."),
      li(text: "Stale prose claiming production use (`cli_run.rs` near `entry_file_touched_via_import_closure` and the module-grain harness, `gunbc.instruments.dag_compile_clean_scope` roster note, `gunbc.regen_round_cost` `regen_affected_set_disposition`). Settled by deleting the code it describes.")
    ]),
    h2(text: "4. Phases"),
    p(text: "Each phase is one pull request that switches its consumer and deletes what it displaces (`gunbc.design_argument::replacement_migration`). Deletions outside the required gate enumerate their consumers by name first. No phase adds a CI job or raises a time or memory budget (`gunbc.design_ruling::job_roster_closed_to_growth`, `gunbc.design_ruling::ci_job_budgets_closed_to_growth`). Owner column: **here** is built by the lane that consumes it now; **hand-off** is for another worker."),
    ol(items: [
      li(text: "**P0, delete the dead (hand-off).** B4; C1's touched-path wrappers and suffix matcher; C2; C3; C4; C5's three dead functions; C6; D1-D5; and B3's unused `edit_locus` git-diff entry. Each deletion enumerates its consumers by name at its own head first. Pure deletion; no behavior change on any executing route. B3 itself is excluded (section 3)."),
      li(text: "**P1, the authority (here).** A new read-set module (home per D1): member kinds, observed and declared members, the matcher, the recording format, and `validate_read_set` with its three outcomes in its PATH-DIFF mode (every member path checked normal, declared ones included). Generator semantics identity and the digest mode are NOT part of P1: they land with their first consumer (P2's heal products; P3's parse verdicts), so P1 claims neither. The fast lane switches onto it as the required-job consumer (2.4): `fast_lane_decide` becomes a consumer, its fixed prefixes become declared members (or seed identity, for `src/v1/`), and the emitted bash stays generated from the same rows. `gunbc.plans.demand_engine_program` section 2.3's none yet names the new home as the file-grain projection. Done when the fast lane's decision is the authority's answer, with a discriminating red (a changed observed member, and separately a changed declared member, each force a full run) and the existing witness kept."),
      li(text: "**P2, heal scopes its mirror round (here; this is T11). Amended 2026-11-09 (operator chose option A).** MEASURED FIRST: of heal's ~65-minute run the mirror round takes 41-60 minutes and the 13 seed-build artifacts 2-3, and the mirror round's honest observed read set is the whole pool (its host builds a whole-pool index), so the approved whole-population mirror check would be invalidated by every `dag/` change and save ~2 minutes. P2 therefore consumes the existing DERIVED per-mirror bound now: heal runs its round with `--regen-affected-scope`, which regenerates only the mirrors `gunbc.regen_affected_set` names for the pull request's changes since its base commit (the base is the diff baseline's override, set from the same immutable `base.sha` the round bootstraps from, so a manual dispatch scopes correctly too). A departed module is named by its layout path (`gunbc.source_layout`), so a deletion scopes like an edit instead of refusing. B1 and B2 stay live as P2's derived handler until P4 replaces them with recorded read sets; the 13 seed-build artifacts keep their whole regeneration (2-3 minutes) until a consumer needs finer grain. The dry run is the existing report `claim_executor --regen-affected-set` over the same diff. Done when a plan-only pull request's heal selects zero mirrors, a one-module edit selects exactly the mirrors whose modules reach it, a module deletion scopes rather than refuses, and heal still converges."),
      li(text: "**P3, parse-verdict reuse as an instance (hand-off).** A2's per-module receipts become read sets validated by digest under the generator identity; its five typed misses map onto 2.3's states with their causes preserved."),
      li(text: "**P4, mirrors per product from recorded read sets (hand-off).** Replaces P2's derived bound (B1's whole-pool reverse walk and B2's scope plumbing) with one read set per mirror, recorded during emission and validated through `v2.std.read_set`; the product graph and reverse index (2.4, 2.6) select; B1, B2 and A3's explanation child are deleted. A3's guard consumes the per-mirror selection together with its own modeled build inputs: the partition-generation and shared-build inputs `gunbc.stage0_partition_rebuild_scope` declares as affecting every package stay modeled build inputs (or come from a recorded package-build read set), never collapsed into mirror ownership. Done when an edit to one mirrored module regenerates exactly the mirrors whose recorded read sets contain it, the partition guard agrees, and the whole-pool index is no longer built by heal."),
      li(text: "**P5, the derived handler (hand-off, only on demand).** C1's walk with its narrowing turned into typed refusals, for a consumer that has no recording. Not started until such a consumer is named.")
    ]),
    h2(text: "5. Decisions"),
    ul(items: [
      li(text: "**D1, home.** A new `v2.std` module holding the file-grain dependency-read-set projection, imported by the demand engine rather than owned by it, so file-system observation never becomes the definition of a semantic demand. Recommendation: yes. (Side-chat review of gunbc#16164: agreed.)"),
      li(text: "**D2, validation modes and storage.** Path-diff and digest are two validation modes of one member identity; digest is the target. Committed manifest bound to the products' blob ids for committed products, with the cold, stale, corrupt and missing-result states of 2.3; Actions cache for ephemeral ones. Recommendation: yes, as stated."),
      li(text: "**D3, B3.** Keep frozen and delete with the frozen compiler-closure emitter's migration, not in P0 (it has code consumers). Recommendation: as stated; changed from delete after review."),
      li(text: "**D4, T11 grain.** Measure first, by replaying representative changes against recorded read sets and counting the products each forces, not by the raw size of the read set. Recommendation: P2's whole-population mirror check plus per-artifact selection; P4 narrows mirrors.")
    ]),
    h2(text: "6. What this does not claim"),
    ul(items: [
      li(text: "An observed read set is exactly what one run read; a run that would read differently under different inputs is caught because changed inputs invalidate it. It does not establish what an untaken branch would read; that is the demand engine's M2."),
      li(text: "The inventory is a candidate set from name search and caller tracing at one revision; a mechanism it missed is added to section 3 when found, not ruled out by this list."),
      li(text: "Generator identity as a seed hash over-approximates: any seed change invalidates every product. That is correct and coarse; narrowing it is a later realization decision priced under the demand engine's M4.")
    ])
  ]
}

data read_set_convergence_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly,
  slug: "read-set-convergence",
  title: "Read-set convergence: regenerate exactly what changed",
  body: read_set_convergence_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "Every live consumer in section 3 (A1 fast lane, A2 parse-verdict reuse, A3 partition guard, heal's products) decides validity through the read-set authority, and the retired mechanisms are deleted: B1, B2, B4, C2, C3, C4, C6, D1-D5, C1's touched-path wrappers and suffix matcher, and C5's three dead functions (C5's `import_closure_live_paths` stays with its consumer, and B3 follows the frozen compiler-closure emitter's own migration); the authority's home is then cited by gunbc.plans.demand_engine_program section 2.3 and this plan deletes.") }
}
