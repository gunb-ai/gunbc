module gunbc.plans.read_set_convergence

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetiresWhen, PlanIsAuthorityOnly }
import std.markdown { MarkdownBlock }
import gunbc.plans.md_helpers { h2, h3, p, li, ul, ol, quote }

fn read_set_convergence_inventory_row(id: String, location: String, io: String, standing: String, disposition: String) -> MarkdownBlock {
  p(text: concat(concat(concat(concat(concat(concat(concat(concat("**", id), ".** "), location), " -- "), io), " **Standing:** "), standing), concat(" **Disposition:** ", disposition)))
}

fn read_set_convergence_body() -> List<MarkdownBlock> {
  [
    quote(blocks: [
      p(text: "**Goal:** regenerate exactly what is needed from exactly what changed. Every generated product (a stage0 mirror, a seed-build artifact, a parse verdict, a required-job verdict) is converged by one rule: it is still valid while nothing its generator read has changed and the generator is the same; otherwise it is regenerated, alone. **Method:** one read-set validation authority, consumed through the existing convergence modality (`gunbc.ensure` `ensure_decide`, whose `EnsureObserveOnly` policy is the dry run). **Validation:** each phase switches one production consumer onto the authority and deletes what it displaces."),
      p(text: "**Operator direction (2026-11-09, session bright-ibex-807):** T11 (heal's early exit) must use the same logic as the compiler's demand closure, not a fourth bespoke check; design the consolidation, cleanup and migration of every affected-set mechanism, implement only the parts consumed now, hand off the rest; delete or consolidate the rest; regenerate exactly what is needed from exactly what changed, as a convergence pattern with dry run.")
    ]),
    h2(text: "1. Displaced cost"),
    ul(items: [
      li(text: "**Heal** (`gunbc.heal_workflow`, `.github/workflows/heal.yml`) regenerates the whole population on every same-repository pull request touching `dag/**`, `src/v1/**` or `src/v2/**`: all 172 stage0 mirrors (`claim_executor --regen-round-cost --base-mirror`) and all 13 seed-build artifacts (`gunbc.seed_build_artifact_emit` `seed_build_artifacts`). Median wall time 65 minutes (8 successful runs before 2026-11-09, range 51-72), paid even by a plan-only change. It does no change selection at all."),
      li(text: "**Four spellings of one question.** Twenty-one mechanisms answer some form of what does this change affect (section 3). Three run in production, each with its own matcher, its own unknown handling and its own everything-changed trigger; the rest are dead, stubbed or witness-only, several under prose claiming production use."),
      li(text: "**The authority does not exist yet.** `gunbc.plans.demand_engine_program` section 2.3 lists the dependency read set with existing authority none yet, and its cross-run hit protocol already rules manifest-validation for the first consumer. This plan is that relation's first landing, scoped to file-grain products; it is a slice of that program, not a second one.")
    ]),
    h2(text: "2. The model"),
    h3(text: "2.1 Product, read set, generator identity"),
    ul(items: [
      li(text: "**Product.** One generated output with a subject: a mirror file, a seed-build artifact, one module's parse verdict, one job's verdict. A product is a demand in the demand-engine sense: generator plus subject."),
      li(text: "**Read set.** The sealed list of members the generator consumed while producing that product. Member kinds: `File` (a path that was read), `Probe` (a path that was looked for and was absent), `Dir` (a directory that was enumerated, matched on a path-segment boundary), and `Content` (a path with the digest that was read). Today's `gunbc.read_set_schema` kinds `file`, `probe`, `dir` are the first three."),
      li(text: "**Generator identity.** The identity of what produced the product: the seed compiler that ran plus the generator module. It replaces the four everything-changed spellings (section 3, G4): the fast lane's fixed path prefixes, parse-verdict's compiler identity, `gunbc.regen_affected_set` `regen_generation_inputs` prefixes `v1.compiler.` and `extdeps.languages.`, and the partition scope's whole-rebuild roster. In demand-engine terms it is the evaluator/compiler semantics identity inside the evaluation identity, not a read-set member."),
      li(text: "**Observed first, derived second.** A read set is recorded by observing the real generator run (the T9 recorder, `src/v1/stage0/src/cli_run/demand_acquire.rs` `read_set_record`, is the existing handler). A derived handler (forward closure over `v2.lens.module_graph` `demand_closure_walk`) is admitted later, only for a consumer that has no recording, and only after its silent narrowing becomes a typed refusal (section 3, C1).")
    ]),
    h3(text: "2.2 Validation: the one rule"),
    p(text: "Inputs: a recorded read set, the generator identity it was recorded under, the current generator identity, and an observation of the current state of its members: either the paths changed since the recording revision, or the members' current digests. Output: `ReadSetValid`, `ReadSetInvalidated` naming the members that changed, or `ReadSetUnestablished` with a typed cause (recording absent, recording unreadable, recording revision not an ancestor, generator identity unreadable, a member path not normalized). A different generator identity is `ReadSetInvalidated` by the generator, not a whole-population special case. Matching is exact for `File`, `Probe` and `Content`, and segment-prefix for `Dir`; the unbounded suffix match in `v2.lens.module_graph` `path_matches_touched` and its Rust twin is deleted as a defect (a path `ba.dag` matches `a.dag`)."),
    p(text: "Unknowns refuse with a typed cause; the authority never widens or narrows on its own. What an unknown costs is the consumer's decision: a required-job consumer runs in full, a convergence consumer refuses the product. This replaces the five unknown policies in section 3, G1."),
    h3(text: "2.3 Convergence: ensure per product, with dry run"),
    p(text: "Each consumer converges its products through `gunbc.ensure` `ensure_decide`: the observation is the committed product plus its recorded read set; it is satisfied when validation answers `ReadSetValid`; the plan is regenerate this product and record its new read set; `ReadSetUnestablished` refuses. The result is `std.upsert_decision` `UpsertDecision`: `Noop`, `Apply` or `Refuse`, per product. **Dry run** is `EnsureObserveOnly`: the full per-product Noop/Apply/Refuse list, with nothing written. An `Apply` is grounded by readback through `std.realization_reconcile` (the regenerated bytes are what was written, and the new read set is sealed), never by the generator's return."),
    h3(text: "2.4 The reverse direction is an index, not an authority"),
    p(text: "Which products does this edit affect is the inverse of the products' read sets: a map from member to products, built from the recordings. It is a realization of the validation for many products at once and holds no rule of its own. `gunbc.regen_affected_set`'s reverse walk over the whole-pool edge index (`cli_run` `whole_pool_closure_edge_index`) is replaced by it."),
    h3(text: "2.5 Where read sets live"),
    p(text: "Committed products (mirrors, seed-build artifacts) carry their read sets as one committed manifest beside them, written by the same Apply that writes the product, so a pull request and a local dry run need no cache. Ephemeral products (the required-job verdict, parse verdicts) keep their receipts in the Actions cache keyed by revision, as today (decision D2)."),
    h2(text: "3. Inventory and disposition"),
    p(text: "Read at main `ed30451e610` by name search over `dag/`, `src/v2/` and `src/v1/stage0/src` plus caller tracing; a candidate set, not a census. Live means invoked on an executing production route (a workflow step, the required job, heal, a verb a workflow calls). Phase names refer to section 4."),
    h3(text: "A. Live"),
    read_set_convergence_inventory_row(id: "A1", location: "Fast lane: `gunbc.read_set_restore` `fast_lane_decide`, `fast_lane_decide_diff`, `fast_lane_fixed_input_rules`; recorder `demand_acquire.rs` `read_set_record`; `gunbc.read_set_publish`; `gunbc.read_set_schema`; emitted into `witnesses.yml` as the step Decide whether the fast-lane unit covers this change.", io: "In: the main ancestor's recorded read set, `git diff --name-only` from it, fixed prefixes. Out: skip or full run with a typed `FastLaneFullRunCause`. Job grain; unknowns widen with a typed cause.", standing: "live, v2-bootstrap on pull requests.", disposition: "first consumer of the authority (P1); fixed prefixes become generator identity."),
    read_set_convergence_inventory_row(id: "A2", location: "Parse-verdict reuse: `gunbc.parse_verdict_schema` `parse_verdict_standing`; `v2.cli.parse_verdict_reuse` `parse_verdict_base_read`; `v2.cli.population_verbs` `population_parse_standing`; steps from `gunbc.witness.compiler_gate_workflow`.", io: "In: base and head compiler identity, each module's source digest, restored receipts. Out: per module Reused or one of five typed misses. Module grain, no closure.", standing: "live, v2-bootstrap on pull requests.", disposition: "instance with `Content` members (P3)."),
    read_set_convergence_inventory_row(id: "A3", location: "Partition rebuild scope: `gunbc.stage0_partition_rebuild_scope` `stage0_partition_rebuild_decision` and `stage0_partition_move_explained_by_affected_inputs` (calls `gunbc.regen_affected_set` in a child `claim_executor --regen-partition-move-explanation`); host `required_regen_host.rs` `partition_rebuild_actuation`, `install_convergence_stage`.", io: "In: changed mirror basenames, crate partition rows. Out: packages to rebuild, `WholeCompilerRebuildRequired`, or a typed refusal. Crate grain.", standing: "live inside heal, but only as a guard: the full seed cargo build still runs; the host passes `unlocatable` as empty, so unlocatable collapses into unexplained.", disposition: "consumes the per-mirror index (a package's read set is the union of its mirrors') (P4); the explanation child is deleted."),
    h3(text: "B. Reverse closures, not on a production selection route"),
    read_set_convergence_inventory_row(id: "B1", location: "`gunbc.regen_affected_set` (`regen_affected_set`, `regen_reverse_closure`, `regen_generation_inputs`, `regen_bootstrap_edges`); host `required_regen_host.rs` `regen_module_edges` over `cli_run` `whole_pool_closure_edge_index`.", io: "In: edited modules, unlocatable paths, whole-pool edges, mirror rows. Out: `AffectedMirrors`, `WholePopulation`, `EditedSetUnlocatable`. Mirror grain.", standing: "report-only flag `--regen-affected-set`; live only inside A3's child. The host lockstep passes its own reached set, so it cannot catch host under-reach.", disposition: "delete in P4, replaced by the index (2.4); its bootstrap edge (v1_rt.rs) becomes a read-set member of that product."),
    read_set_convergence_inventory_row(id: "B2", location: "`v2.workflow.required_regen` `regen_scope_select`; `v2.workflow.regen_convergence_transaction` `regen_admit_affected_bound`.", io: "In: B1's bound, committed basenames, changed surfaces. Out: a scope selection and a changed-within-bound admission. Mirror grain.", standing: "flag `--regen-affected-scope`, which no workflow passes (heal passes false).", disposition: "delete in P2/P4; scoping becomes ensure per product."),
    read_set_convergence_inventory_row(id: "B3", location: "`v2.lens.affected_set` (`affected_set`, `affected_set_reading`, `affected_set_closure`), `v2.std.change` `AffectedSet`, `v2.lens.edit_locus` `affected_set_reading_from_git_diff` (and `_provenance`).", io: "In: an in-memory tree and a diff. Out: a `ReExecFrontier` per node and dimension, or `FailClosed`. Node grain.", standing: "the edit_locus entry has no caller; consumers are witnesses and D2.", disposition: "delete in P0 unless the demand engine's M2 names it as a consumer (decision D3)."),
    read_set_convergence_inventory_row(id: "B4", location: "`v2.workflow.compile_door_ledger` `affected_ledger_from_diff`, `door_ledger_over_affected_set`.", io: "In: a name-status diff, pool roots. Out: a ledger over the changed files only (no closure).", standing: "AuditOnly, witness only.", disposition: "delete in P0."),
    h3(text: "C. Forward closures, not on a production route"),
    read_set_convergence_inventory_row(id: "C1", location: "`v2.lens.module_graph` `demand_closure_walk`, `dependency_closure_live_excluding`, `import_closure_live`, `entry_affected_by_touched_paths` (and `_excluding`), `touched_path_in_closure`, `path_matches_touched`; edges from host builtins `cli_run` `dependency_resolution_facts_at`, `entry_resolve` `module_declaration_fact_at`.", io: "In: entry, pool roots, touched paths. Out: reached files, or a Bool. File grain. Unknowns narrow silently (an unreadable or unaccounted importer contributes no edges).", standing: "the Bool's only consumer is C3 (dead); `import_closure_live` is read by `gunbc.decoder_execution_identity` and witnesses.", disposition: "the walk stays as the derived handler (P5) once narrowing refuses; the touched-path wrappers and the suffix matcher are deleted in P0."),
    read_set_convergence_inventory_row(id: "C2", location: "`src/v2/lens/affected_set/entry_selection.dag`.", io: "One scaffold disposition naming C1; no logic.", standing: "no importers.", disposition: "delete in P0."),
    read_set_convergence_inventory_row(id: "C3", location: "`gunbc.instruments.dag_compile_clean_scope` `compile_clean_affected_entry_paths_from_roster`, `compile_clean_scope_disposition_probe`; Rust `compile_clean.rs` `compile_clean_scope_plan_for_ci` via the interpreter builtin `witness_gates.rs` `witness_layer_roots_compile_clean_check`.", io: "In: pool roots, touched paths, roster. Out: affected entries, WholeTree or Skip.", standing: "dead: the builtin has no .dag caller and `dag_compile_clean_gate` returns `GateNotRun`.", disposition: "delete in P0, both halves."),
    read_set_convergence_inventory_row(id: "C4", location: "Rust twin `cli_run.rs` `entry_file_touched_via_import_closure`, `repo_paths_match_touched`; caller `compile_clean.rs` `compile_clean_scope_plan_from_touched_paths_floor_fast_impl`.", io: "In: entry, facts, touched paths. Out: Bool or a typed refusal on the entry only, which the caller turns into WholeTree.", standing: "tests only, mostly ignored; its certification module has no test.", disposition: "delete in P0."),
    read_set_convergence_inventory_row(id: "C5", location: "`cli_run.rs` `effect_reach_touched_via_path_literals`, `reads_live_tree_effective`, `LiveReadSelectionRow` `touched_by`; `entry_resolve` `import_closure_live_paths`.", io: "Various Bool or path answers; `import_closure_live_paths` walks import edges only.", standing: "the first three have no production caller; `import_closure_live_paths` is read by A1's parse-identity recording.", disposition: "delete the first three in P0; `import_closure_live_paths` keeps its one consumer and loses the claim to realize `import_closure_live`."),
    read_set_convergence_inventory_row(id: "C6", location: "`gunbc.instruments.rust_stage0_gates` `unit_is_affected`, `any_declared_unit_affected`.", io: "Ignores its arguments and answers true.", standing: "stub; its consumer chain is un-enrolled since 2026-07-11.", disposition: "delete in P0."),
    read_set_convergence_inventory_row(id: "C7", location: "`v2.std.demand_engine` `demand_closure_step`, `demand_engine_closure`.", io: "In: demand prerequisites. Out: the seen set; partial on fuel exhaustion.", standing: "witness only.", disposition: "out of scope: the demand engine's own judgment-grain closure, owned by `gunbc.plans.demand_engine_program`."),
    h3(text: "D. Change-driven selection, not on a production route"),
    read_set_convergence_inventory_row(id: "D1", location: "Floor changed-witness family: `v2.workflow.required_floor` changed-selection functions, `v2.workflow.floor_changed_witness`, `v2.workflow.floor_cost_debt_edit` ceilings; Rust `cli_run/required_floor_runner.rs` `floor_diff_edits_from_line_ranges_reading`.", io: "In: a supplied changed Bool or identity list, a git diff. Out: dispositions, blockers, ceilings.", standing: "dead: the floor lane is withdrawn (`gunbc.rung_drop` `v1_required_lanes_withdrawn`); Rust callers sit under cfg(test).", disposition: "delete in P0 after enumerating consumers (outside the gate)."),
    read_set_convergence_inventory_row(id: "D2", location: "`v2.std.probe_selector` `probe_select_affected_test_claims`, `ci_test_claim_coverage_for_affected`.", io: "In: roster, an AffectedSet, budget. Out: selected claims; FailClosed selects all.", standing: "dead.", disposition: "delete in P0."),
    read_set_convergence_inventory_row(id: "D3", location: "`gunbc.source_admission_selection` `select_source_admission`, `source_admission_is_incremental`, `incremental_changed_module_paths`.", io: "In: base and head manifests, a receipt, mechanism identity. Out: incremental, no-op, whole, or refused, from its own keyed diff.", standing: "dead; its header says it was never wired.", disposition: "delete in P0."),
    read_set_convergence_inventory_row(id: "D4", location: "`gunbc.floor.incremental_floor_authority` `floor_affected_closure_sound`, `floor_selection_admission`.", io: "In: a supplied closure and measured delta. Out: admitted or whole population required.", standing: "dead by its own text.", disposition: "delete in P0."),
    read_set_convergence_inventory_row(id: "D5", location: "`gunbc.ci.ci_cost_arc_closeout_receipt` `AffectedSelection`.", io: "A historical tag on one hand audit.", standing: "dead.", disposition: "delete in P0."),
    p(text: "**Same word, different concept (out of scope):** `gunbc.compute.test_selection` `select_witness_files` (label pattern, not change), `std.selected_witness_bundle` (consumes a selection), `gunbc.roadmap.roadmap_execution_contract` `validation_consumes_affected_set_window` (provisions a diff window), `gunbc.runner.runner_service_activation` `runner_transition_affected_set_identity` (hash of refused unit names)."),
    h3(text: "G. Disagreements the one rule settles"),
    ol(items: [
      li(text: "Unknowns: C1 narrows silently; C4 refuses and its caller widens; A1 widens with a typed cause; B1-B4 refuse; D2 widens. Settled by 2.2: the authority refuses with a typed cause and the consumer prices it."),
      li(text: "Matching: unbounded suffix (C1, C4) against exact plus directory prefix (A1). Settled by 2.2: exact, or segment-prefix for `Dir`."),
      li(text: "Edges: the whole-pool index (B1), keyed per-module reads (C1), import-only adjacency (C5), cargo package rows (A3), an in-memory dependency lens (B3). Settled by 2.1: observed reads are the default; one derived handler later."),
      li(text: "Everything changed, four spellings (A1 prefixes, A2 compiler identity, B1 module prefixes, A3 roster). Settled by 2.1: generator identity."),
      li(text: "Edit source: `floor_git_diff_range` (B1, B2), `floor_observe_git_diff_name_status_for_ci` (B4), raw git diff against a restored ancestor (A1). Settled by the observation input of 2.2: changed paths since the recording revision, or digests."),
      li(text: "Stale prose claiming production use (`cli_run.rs` near `entry_file_touched_via_import_closure` and the module-grain harness, `gunbc.instruments.dag_compile_clean_scope` roster note, `gunbc.regen_round_cost` `regen_affected_set_disposition`). Settled by deleting the code it describes.")
    ]),
    h2(text: "4. Phases"),
    p(text: "Each phase is one pull request that switches its consumer and deletes what it displaces (`gunbc.design_argument::replacement_migration`). Deletions outside the required gate enumerate their consumers by name first. No phase adds a CI job or raises a time or memory budget (`gunbc.design_ruling::job_roster_closed_to_growth`, `gunbc.design_ruling::ci_job_budgets_closed_to_growth`). Owner column: **here** is built by the lane that consumes it now; **hand-off** is for another worker."),
    ol(items: [
      li(text: "**P0, delete the dead (hand-off).** B3 (per D3), B4, C1's touched-path wrappers and suffix matcher, C2, C3, C4, C5's three dead functions, C6, D1-D5. Pure deletion; no behavior change on any executing route. Done when none of them resolves and the required job is green."),
      li(text: "**P1, the authority (here).** A read-set relation module (home per D1) with the member kinds, generator identity, `validate_read_set` and its three outcomes, the matcher, and the ensure projection (satisfied, plan, refuse) with an observe-only dry run. A1 switches onto it: `fast_lane_decide` becomes a consumer, its fixed prefixes become the recorded generator identity, and the emitted bash stays generated from the same rows. `gunbc.plans.demand_engine_program` section 2.3's none yet names the new home. Done when the fast lane's decision is the authority's answer, with a discriminating red (a changed member reds the skip) and the existing witness kept."),
      li(text: "**P2, heal converges its products (here; this is T11).** Heal records one read set per product on main (the 13 seed-build artifacts first; mirrors in P4), committed as a manifest beside the products. On a pull request heal's first step validates them and converges only the invalidated products; a dry run prints the per-product plan. First measurement, before choosing grain: record heal's read set once on main; if it covers nearly the whole pool, whole-heal skipping is useless and P2 goes straight to per-product. Done when a plan-only pull request runs no regeneration, a change to one producer regenerates exactly its product, and the dry run lists the same decisions."),
      li(text: "**P3, parse-verdict reuse as an instance (hand-off).** A2's per-module receipts become read sets with `Content` members under the generator identity; its five typed misses map onto the three outcomes with their causes preserved."),
      li(text: "**P4, mirrors per product (hand-off).** Each mirror's read set is recorded during emission; the index (2.4) replaces B1's whole-pool reverse walk; B1, B2 and A3's explanation child are deleted; A3's guard consumes the index. Done when an edit to one mirrored module regenerates exactly the mirrors whose read sets contain it, and the partition guard agrees."),
      li(text: "**P5, the derived handler (hand-off, only on demand).** C1's walk with its narrowing turned into typed refusals, for a consumer that has no recording. Not started until such a consumer is named.")
    ]),
    h2(text: "5. Decisions"),
    ul(items: [
      li(text: "**D1, home.** A new v2 std module that the demand engine program's table cites as the dependency read set authority, or a section of `v2.std.demand_engine`. Recommendation: a new module; the engine imports it rather than owning file-grain observation."),
      li(text: "**D2, member identity and storage.** Paths-touched-since-recording (A1 today; needs the recording revision reachable) and content digest (A2 today; self-contained) are both member kinds; digest is the target. Committed manifest for committed products, cache for ephemeral ones. Recommendation: as stated in 2.5."),
      li(text: "**D3, B3.** Delete the node-grain lens in P0, or freeze it for the demand engine's M2. Recommendation: delete; M2 derives its relations from section 4 behaviors and does not consume this lens."),
      li(text: "**D4, T11 grain.** Whole-heal first or per-product first. Recommendation: decided by P2's first measurement, per-product for the 13 seed-build artifacts in any case.")
    ]),
    h2(text: "6. What this does not claim"),
    ul(items: [
      li(text: "An observed read set is exactly what one run read; a run that would read differently under different inputs is caught because changed inputs invalidate it. It does not establish what an untaken branch would read; that is the demand engine's M2."),
      li(text: "The inventory is a candidate set from name search and caller tracing at one revision; a mechanism it missed is added to section 3 when found, not ruled out by this list."),
      li(text: "Generator identity as a seed hash over-approximates: any seed change invalidates every product. That is correct and coarse; narrowing it is a later realization decision priced under the demand engine's M4.")
    ])
  ]
}

data read_set_convergence_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly,
  slug: "read-set-convergence",
  title: "Read-set convergence: regenerate exactly what changed",
  body: read_set_convergence_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "Every live consumer in section 3 (A1 fast lane, A2 parse-verdict reuse, A3 partition guard, heal's products) decides validity through the read-set authority, and B1, B2, C2-C6 and D1-D5 are deleted; the authority's home is then cited by gunbc.plans.demand_engine_program section 2.3 and this plan deletes.") }
}
