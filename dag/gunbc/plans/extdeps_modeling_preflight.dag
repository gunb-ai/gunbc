module gunbc.plans.extdeps_modeling_preflight


data extdeps_modeling_preflight_law: String = "Normative authority rows for the extdeps modeling preflight (operator verdict on gunbc#7556; DESIGN §3 'External upstream decomposition'): before any new extdeps work, the agent returns this table, and no implementation starts until the table is coherent. The typed rows below are the single authority; the registered plan doc renders its table FROM these rows (derive, never a second copy)."

type ExtdepsPreflightRow {
  question: std.types.NonEmptyStr
  required_answer: std.types.NonEmptyStr
}

data extdeps_modeling_preflight_rows: List<ExtdepsPreflightRow> = [
  ExtdepsPreflightRow { question: "Independently governed upstream subjects", required_answer: "Enumerated by name" },
  ExtdepsPreflightRow { question: "Shared standard/interface concepts", required_answer: "Enumerated separately" },
  ExtdepsPreflightRow { question: "Product-/engine-specific facts", required_answer: "Assigned to their upstream modules" },
  ExtdepsPreflightRow { question: "Local execution observations", required_answer: "Assigned downstream" },
  ExtdepsPreflightRow { question: "Consumer policy or coverage", required_answer: "Assigned downstream" },
  ExtdepsPreflightRow { question: "Exact version/build authority", required_answer: "Named for each upstream" },
  ExtdepsPreflightRow { question: "Existing model searched", required_answer: "Symbols and modules listed" },
  ExtdepsPreflightRow { question: "Proposed file map", required_answer: "One subject per implementation module" }
]

fn extdeps_preflight_table() -> std.markdown.MarkdownBlock {
  std.markdown.TableBlock {
    header: gunbc.plans.md_helpers.row(cells: [cell(text: "Question"), cell(text: "Required answer")]),
    alignments: [AlignNone, AlignNone],
    rows: map(extdeps_modeling_preflight_rows, r =>
      gunbc.plans.md_helpers.row(cells: [cell(text: r.question), cell(text: r.required_answer)])
    ),
  }
}

fn extdeps_modeling_preflight_body() -> List<std.markdown.MarkdownBlock> {
  [
    std.markdown.BlockquoteBlock { blocks: [p(text: "Operator-directed (verdict on gunbc#7556, 2026-08-01). Normative source: DESIGN §3 → \"External upstream decomposition\". The typed rows live in `gunbc.plans.extdeps_modeling_preflight` `extdeps_modeling_preflight_rows`; this table is rendered from them.")] },
    h2(text: "The preflight"),
    p(text: "Before any new extdeps work, the agent should return this table:"),
    extdeps_preflight_table(),
    p(text: "No implementation starts until the table is coherent."),
    h2(text: "How the answers are checked"),
    ul(items: [
      li(text: "**One subject per module** is the `ExternalModelScope` contract (`extdeps.external_authority` — one symbolic subject `DeclarationRef` plus one-or-more citations; exact revisions live on build/release/fact rows, never on the module scope). `external_model_scope_decision` is the pure decision kernel over declared fact rows: a product-/engine-specific fact row attributed to a subject other than the module's declared subject is `ForeignSubjectRow`, and consumer coverage state stored in an upstream module is `ConsumerCoverageInUpstream`."),
      li(text: "**The honesty boundary** (`external_model_scope_decision_kernel_note`): the kernel judges *declared* facts, so it is not yet an admission wall. The mechanical enforcement today is scope **presence** at a declared grain (the staged frontier below — per-PR for the hermetic half, wet-lane for the live half); subject-content coherence derived from the real module tree is the named enforcement frontier `feature:extdeps-subject-content-derived`."),
      li(text: "**Observations and coverage live downstream** — receipts in the observing product/workflow layer (`DownstreamSupportRoster`, coverage identity symbolic), never `Unobserved` properties authored inside an upstream module."),
      li(text: "**Enrollment is staged** behind `gunbc.extdeps_scope_frontier`, per-PR merge-gated in both directions (codex `review 46258` / `review 46281`): hermetic — every rostered path resolves on disk, the three rosters stay disjoint, carrier files byte-declare the scope, RED controls live; diff-grain — `tools.extdeps_scope_placement_gate` (wet cheap-floor gate) refuses any added `dag/extdeps` `.dag` file outside carriers plus machinery and any frozen-manifest row naming a post-freeze-added file, with diff failure/truncation as refusals. A new module can never join the frozen manifest (remove-only, count derived); the wet live-cover witness remains the whole-population re-verification, and the storage-grain frontier dissolves into the `v2.lens.mandatory_tag` region promotion."),
      li(text: "**The non-precedent counterexample** is `extdeps.browser` (its disposition note names the conflation and the eventual split: `extdeps.automation.playwright` / agnostic interaction shape / transport realization)."),
    ]),
  ]
}

data extdeps_modeling_preflight_plan: gunbc.plan.Plan = gunbc.plan.Plan {
  slug: "extdeps-modeling-preflight",
  title: "extdeps modeling preflight — one subject per upstream module",
  body: extdeps_modeling_preflight_body(),
  retirement: gunbc.plan.PlanRetiresWhen { condition: unbound_dissolution(description: "Dissolves when the preflight's decidable half is machine-consumed end-to-end: the ExternalModelScope requirement is promoted from the gunbc.extdeps_scope_frontier staging roster to a v2.lens.mandatory_tag region (compile-grain wall), at which point the subject/coverage questions are enforced by construction and this doc's residue (the genuinely judgment-shaped rows: existing-model search, proposed file map) folds into DESIGN §3's standing text.")
  }
}
