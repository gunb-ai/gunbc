module gunbc.plans.host_convergence_circuit_residue

import std.dissolution { unbound_dissolution }
import std.types { String, List }
import std.markdown { MarkdownBlock }
import gunbc.plan { Plan, PlanRetirement, PlanRetiresWhen, PlanIsAuthorityOnly }
import gunbc.plans.md_helpers { p }
import gunbc.design_ruling { project_documentation_projections_are_not_checkout_artifacts }

fn hccr_intro() -> List<MarkdownBlock> {
  [
    p(text: "Close host convergence through the membership_reconcile circuit. This dated AcceptedWithResidue receipt proves P0 and the P1 hermetic logic; live srv1 evidence and P1b/P2/P3 remain. Failure refuses; it never widens to empty observation, assumed ownership or automatic disable."),
  ]
}

fn hccr_done() -> List<MarkdownBlock> {
  [
    p(text: "P0 removed fleet_converge_emit, .github/fleet-converge.sh, FleetConvergeArtifact and their test/workflow enrollment. fleet_converge_apply owns the typed path. realization_vocabulary_containment excludes fleet_converge* from ShellProgram emission; EmitArtifactThenThinRun remains for srv3-install/ci_deploy/nbd_proxy. The recorded green consumers are fleet_converge_apply, generated_artifact_drift, host_standup_spine, commit_workflow and realization_vocabulary_containment."),
    p(text: "P1: host.host_axis_caps instantiates membership_reconcile with real observed members and key/value/ownership functions. Drop-in paths derive Managed→Owned and foreign→Ensured. Foreign removal produces MemberRemovalRefused (R5, no effect arm) and wholesale ApplyRefused. Four CI-enrolled hermetic receipts have red controls: unchanged→zero effects; perturbation→only the drifted Upsert; foreign→zero teardowns (owned removal does tear down); [Service]/property/bytes derive from the model."),
    p(text: "WITHDRAWN 2026-08-21: host_converge_realize and its retained_shell_script are deleted. The 2026-08-13 privilege hold reserves cap authoring to the deploy principal. host_effect_realize.realize_converge_in_process always returns NotConverged with converge_in_process_apply_withdrawn_reason. converge_cli_run refuses unmodeled sibling knobs; converge_cli_verify_run is read-back only. No caps-only apply route exists. Historical interpret witnesses and hand-applied derived srv1/srv4 values are not live converge-apply evidence."),
  ]
}

fn hccr_hazard() -> List<MarkdownBlock> {
  [
    p(text: "Closed hazards: fabricated exit_code 0 was replaced by real exit evidence, then the apply arm was deleted. Safety no longer depends on every fleet host having an unimplemented sibling knob. A caps-only host or newly implemented axis therefore cannot turn a hermetic witness into live shell actuation; two self-asserting suppression Bools and a future mode gate are not substitutes for deletion."),
  ]
}

fn hccr_residue() -> List<MarkdownBlock> {
  [
    p(text: "Caps-only converge apply is withdrawn, not pending. Deploy owns apply; converge owes host.host_runner_memory_cap_verify over fleet_show_effective_read.per_slot_memory_cap_verdict_from_unit_read. P1b must enumerate the live drop-in directory and read each file into observed CapMember; unreadable directory/file refuses, never means empty. runner_memory_cap_live_reads already reads effective systemctl values; interference-directory enumeration remains."),
    p(text: "Live srv1 controls, after observe wiring: deploy apply plus converge read-back gives unchanged/zero effects; hand-break one cap, identify exactly that Modified row, deploy repair, verify green, then unchanged; add an unowned .d file, refuse naming its path, delete nothing, let siblings continue. Existing evidence is hermetic plus the 2026-07-23 srv4 OOM-fix readback; it does not discharge these live receipts."),
    p(text: "P2: enroll srv4 in fleet_intent with BMC/Redfish-measured HostMemoryPopulation, not a flat 128GiB assumption; conservation checks the five-runner fit. Construction must refuse runner installation on hosts absent from fleet_intent via its drift-gated derived roster guard. Hand action cannot establish fleet membership."),
    p(text: "P3: enroll HostAxisBundle in gunbc.roster_registry as a group. Provider extdeps rows share the memory model (cgroup-v2, PSI, OOM-kill; extend extdeps/os/systemd and extdeps/os/oomd). Execute a witness of interference as effect-grant subtree claim intersection. Observe by occupant identity; unknown identity is UnmodeledOccupant. Only signed TakeoverRuling permits foreign→owned teardown. Declare swap-device and reclaim-timer frontier rows with srv1/2/4 hand-provisioning receipts and each axis’s follow-on dissolution; declaration is not execution."),
  ]
}

fn host_convergence_circuit_residue_body() -> List<MarkdownBlock> {
  concat(hccr_intro(),
  concat(hccr_done(),
  concat(hccr_hazard(), hccr_residue())))
}

data host_convergence_circuit_residue_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly { ruling: project_documentation_projections_are_not_checkout_artifacts },
  slug: "host-convergence-circuit-residue",
  title: "Host-convergence circuit — P0 + P1-core landed; P1a/P1b/live + P2 + P3 residue (2026-07-23)",
  body: host_convergence_circuit_residue_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "Dissolves as each counted debt lands on the proven P1 circuit: P1a (interpreter KnobEffect + realize real-execution, the two coupled edits past the fabricated-exit-0 hazard), P1b (fail-closed observe provider), the three live srv1 receipts, P2 (srv4 enrollment + the enrollment wall), P3 (the axis framework + swap-device/reclaim-timer frontier rows). Fully retired when a foreign occupant on srv1's drop-in directory is refused BY THE LIVE CONVERGE (not just the hermetic witness) and srv5 subsumes with the enrollment wall making hand-action membership unwritable.") },
}
