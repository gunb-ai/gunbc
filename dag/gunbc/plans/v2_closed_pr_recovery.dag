module gunbc.plans.v2_closed_pr_recovery

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetiresWhen, PlanProjectsCommittedMarkdown }
import std.markdown { MarkdownBlock, MarkdownTableRow, TableBlock, AlignNone }
import gunbc.plans.md_helpers { h2, p, li, ul, cell, row }
import std.types { NonEmptyStr }
