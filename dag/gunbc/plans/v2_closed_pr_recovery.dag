fn format_one_pr(n: Int) -> String {
  concat("#", int_to_decimal_string(value: n))
}

fn format_prs(ns: List<Int>) -> String {
  fold(ns, init: "", f: (acc, n) =>
    if acc == "" {
      format_one_pr(n: n)
    } else {
      concat(concat(acc, ", "), format_one_pr(n: n))
    }
  )
}

fn area_label(a: ClosedPrArea) -> String {
  match a {
    V2Compiler => "V2Compiler"
    SharedStdOrV1Written => "SharedStdOrV1Written"
    ProductFleetOps => "ProductFleetOps"
  }
}

fn dead_kind_label(k: DeadKind) -> String {
  match k {
    RetiredFloor => "Dead (retired floor)"
    Scratch => "Dead (scratch)"
    DuplicateOrSuperseded => "Dead (duplicate or superseded)"
    PlansOnly => "Dead (plans only)"
    RejectedOnDesign => "Dead (rejected on design)"
    SubjectRetired => "Dead (subject retired)"
  }
}

fn disposition_label(d: LiveDisposition) -> String {
  match d {
    ReviveOnMain { first_step } => concat("ReviveOnMain — ", first_step as String)
    ReDeriveInV2 { what_carries_over, first_step } =>
      concat(concat(concat("ReDeriveInV2 — carries: ", what_carries_over as String), " First step: "), first_step as String)
    ProductPriorityCall => "ProductPriorityCall — revival is a product-priority call, not a v1/v2 question."
  }
}

fn standing_area_cell(st: ClosedPrStanding) -> String {
  match st {
    LiveWork { area, disposition: _ } => area_label(a: area)
    DeadWork { kind, why: _ } => dead_kind_label(k: kind)
  }
}

fn standing_disposition_cell(st: ClosedPrStanding) -> String {
  match st {
    LiveWork { area: _, disposition } => disposition_label(d: disposition)
    DeadWork { kind: _, why } => concat("Dead — ", why as String)
  }
}

fn recovery_table_row(r: ClosedPrRecoveryRow) -> MarkdownTableRow {
  row(cells: [
    cell(text: format_prs(ns: r.pr_numbers)),
    cell(text: r.subject as String),
    cell(text: standing_area_cell(st: r.standing)),
    cell(text: r.why_closed as String),
    cell(text: standing_disposition_cell(st: r.standing)),
  ])
}

fn flatten_pr_numbers(rows: List<ClosedPrRecoveryRow>) -> List<Int> {
  fold(rows, init: [], f: (acc, r) => concat(acc, r.pr_numbers))
}

fn int_eq(a: Int, b: Int) -> Bool {
  a == b
}

fn count_equal_ints(xs: List<Int>, item: Int) -> Int {
  fold(xs, init: 0, f: (n, x) => if int_eq(a: x, b: item) { n + 1 } else { n })
}

fn pr_numbers_are_unique(rows: List<ClosedPrRecoveryRow>) -> Bool {
  let nums = flatten_pr_numbers(rows: rows)
  fold(nums, init: true, f: (acc, n) => acc && (count_equal_ints(xs: nums, item: n) == 1))
}

fn provenance_paragraph(p: ClosedPrCensusProvenance) -> String {
  concat(
    concat(
      concat(
        concat(
          concat("**Provenance.** Session ", p.session),
          " on "
        ),
        p.date
      ),
      " judged closed-but-unfolded PRs by "
    ),
    concat(
      p.method,
      ". DESIGN section 4d: the census is that session's inference, typed TranscribedUncited, not a deduced fact. The dispositions record the operator's 2026-10-10 rulings: start and finish the v2 compiler rows; the shared-std and product/fleet/ops rows get in; the dead rows are irrelevant. A later change of disposition is a row edit."
    )
  )
}

fn v2_closed_pr_recovery_body() -> List<MarkdownBlock> {
  [
    p(text: "**Status:** typed planning carrier for the v1-closeout census of closed-but-unfolded PRs (gunbc#13641 landed on main at fa44b981025, 2026-10-10). Authority is `gunbc.plans.v2_closed_pr_recovery`; this page is its generated projection. Linked from ROADMAP parked context. A live row's disposition is the operator's revival ruling of 2026-10-10; the census reading beside it is not."),
    p(text: provenance_paragraph(p: closed_pr_census_provenance)),
    p(text: "Every closed branch was kept. Each live row is re-derived on current main from first principles rather than rebased: each old head was red or stale for a reason."),
    h2(text: "Census rows"),
    TableBlock {
      header: row(cells: [
        cell(text: "PRs"),
        cell(text: "Subject"),
        cell(text: "Area"),
        cell(text: "Why closed"),
        cell(text: "Disposition"),
      ]),
      alignments: [AlignNone, AlignNone, AlignNone, AlignNone, AlignNone],
      rows: closed_pr_recovery_rows |> map(item => recovery_table_row(r: item)),
    },
    h2(text: "How a later decision lands"),
    ul(items: [
      li(text: "A row's standing is `LiveWork` (an area and a `LiveDisposition`: ReviveOnMain, ReDeriveInV2 or ProductPriorityCall) or `DeadWork` (a `DeadKind` and a reason). A dead row has no area and a live row cannot be dead, by construction; every first step and reason is non-empty by type."),
      li(text: "A later decision is an edit of the named row's standing, not new prose. This module does not open revival work items and does not re-judge the census."),
    ]),
  ]
}

data v2_closed_pr_recovery_plan: Plan = Plan {
  projection: PlanProjectsCommittedMarkdown,
  slug: "v2-closed-pr-recovery",
  title: "v2 closed-PR recovery — census of closed-but-unfolded PRs after the v1 closeout",
  body: v2_closed_pr_recovery_body(),
  retirement: PlanRetiresWhen {
    condition: unbound_dissolution(description: "Delete this census when every LiveWork row has landed as revival work on main or been row-edited to DeadWork, so the closeout reading is no longer the reference for unrevived closed PRs.")
  },
}
