// CLOSED-BUT-UNFOLDED PR CENSUS as a planning carrier. The operator's instruction (2026-10-10):
// keep the v2-relevant work named so it cannot be lost; do not decide which items to revive.
// Every judgment below is neat-wolf-604's 2026-10-10 reading, not a verified fact.

type ClosedPrArea
  = V2Compiler
  | SharedStdOrV1Written
  | ProductFleetOps
  | DeadFloor
  | DeadScratch
  | DeadDuplicate
  | DeadPlansOnly

type ClosedPrDisposition
  = ReviveOnMain { first_step: String }
  | ReDeriveInV2 { what_carries_over: String, first_step: String }
  | ProductPriorityCall
  | Dead { why: String }

type ClosedPrRecoveryRow {
  pr_numbers: List<Int>,
  subject: String,
  area: ClosedPrArea,
  why_closed: String,
  disposition: ClosedPrDisposition,
}

type ClosedPrCensusProvenance {
  session: String,
  date: String,
  method: String,
  standing: CitedFigureStanding,
}

data closed_pr_census_provenance: ClosedPrCensusProvenance = ClosedPrCensusProvenance {
  session: "neat-wolf-604",
  date: "2026-10-10",
  method: "gh pr diff --name-only (paths, not line-by-line)",
  standing: TranscribedUncited {
    read_obligation: "Re-read each named PR's paths, completeness and greenness on current main; this carrier transcribes neat-wolf-604's 2026-10-10 path-only reading and the operator has not yet decided which items to revive." as NonEmptyStr,
  },
}

