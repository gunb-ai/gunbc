fn format_one_pr(n: Int) -> String {
  concat("#", int_to_decimal_string(value: n))
}

fn format_prs(ns: List<Int>) -> String {
  fold(ns, init: "", f: (acc, n) =>
    if acc == "" {
      format_one_pr(n: n)
    } else {
      concat(concat(acc, ", "), format_one_pr(n: n))
    }
  )
}

fn area_label(a: ClosedPrArea) -> String {
  match a {
    V2Compiler => "V2Compiler"
    SharedStdOrV1Written => "SharedStdOrV1Written"
    ProductFleetOps => "ProductFleetOps"
    DeadFloor => "DeadFloor"
    DeadScratch => "DeadScratch"
    DeadDuplicate => "DeadDuplicate"
    DeadPlansOnly => "DeadPlansOnly"
  }
}

fn disposition_label(d: ClosedPrDisposition) -> String {
  match d {
    ReviveOnMain { first_step } => concat("ReviveOnMain — ", first_step)
    ReDeriveInV2 { what_carries_over, first_step } =>
      concat(concat(concat("ReDeriveInV2 — carries: ", what_carries_over), " First step: "), first_step)
    ProductPriorityCall => "ProductPriorityCall — revival is a product-priority call, not a v1/v2 question."
    Dead { why } => concat("Dead — ", why)
  }
}

fn recovery_table_row(r: ClosedPrRecoveryRow) -> MarkdownTableRow {
  row(cells: [
    cell(text: format_prs(ns: r.pr_numbers)),
    cell(text: r.subject),
    cell(text: area_label(a: r.area)),
    cell(text: r.why_closed),
    cell(text: disposition_label(d: r.disposition)),
  ])
}

fn subject_and_reason_nonempty(r: ClosedPrRecoveryRow) -> Bool {
  (r.subject != "") && (r.why_closed != "")
}

fn every_row_has_subject_and_reason(rows: List<ClosedPrRecoveryRow>) -> Bool {
  fold(rows, init: true, f: (acc, r) => acc && subject_and_reason_nonempty(r: r))
}

fn revival_first_step_is_named(d: ClosedPrDisposition) -> Bool {
  match d {
    ReviveOnMain { first_step } => first_step != ""
    ReDeriveInV2 { what_carries_over: _, first_step } => first_step != ""
    ProductPriorityCall => true
    Dead { why: _ } => true
  }
}

fn every_revival_names_a_first_step(rows: List<ClosedPrRecoveryRow>) -> Bool {
  fold(rows, init: true, f: (acc, r) => acc && revival_first_step_is_named(d: r.disposition))
}

fn flatten_pr_numbers(rows: List<ClosedPrRecoveryRow>) -> List<Int> {
  fold(rows, init: [], f: (acc, r) => concat(acc, r.pr_numbers))
}

fn int_eq(a: Int, b: Int) -> Bool {
  a == b
}

fn count_equal_ints(xs: List<Int>, item: Int) -> Int {
  fold(xs, init: 0, f: (n, x) => if int_eq(a: x, b: item) { n + 1 } else { n })
}

fn pr_numbers_are_unique(rows: List<ClosedPrRecoveryRow>) -> Bool {
  let nums = flatten_pr_numbers(rows: rows)
  fold(nums, init: true, f: (acc, n) => acc && (count_equal_ints(xs: nums, item: n) == 1))
}

fn area_is_group4(a: ClosedPrArea) -> Bool {
  match a {
    DeadFloor => true
    DeadScratch => true
    DeadDuplicate => true
    DeadPlansOnly => true
    V2Compiler => false
    SharedStdOrV1Written => false
    ProductFleetOps => false
  }
}

fn disposition_is_dead(d: ClosedPrDisposition) -> Bool {
  match d {
    Dead { why: _ } => true
    ReviveOnMain { first_step: _ } => false
    ReDeriveInV2 { what_carries_over: _, first_step: _ } => false
    ProductPriorityCall => false
  }
}

fn group4_rows_are_dead(rows: List<ClosedPrRecoveryRow>) -> Bool {
  fold(rows, init: true, f: (acc, r) =>
    acc && (if area_is_group4(a: r.area) { disposition_is_dead(d: r.disposition) } else { true })
  )
}

fn provenance_paragraph(p: ClosedPrCensusProvenance) -> String {
  concat(
    concat(
      concat(
        concat(
          concat("**Provenance.** Session ", p.session),
          " on "
        ),
        p.date
      ),
      " judged closed-but-unfolded PRs by "
    ),
    concat(
      p.method,
      ". DESIGN section 4d: this is that session's inference, typed TranscribedUncited, not a deduced fact. The operator has not yet decided which items to revive; changing a disposition is a row edit."
    )
  )
}

fn v2_closed_pr_recovery_body() -> List<MarkdownBlock> {
  [
    p(text: "**Status:** typed planning carrier for the v1-closeout census of closed-but-unfolded PRs (gunbc#13641 landed on main at fa44b981025, 2026-10-10). Authority is `gunbc.plans.v2_closed_pr_recovery`; this page is its generated projection. Linked from ROADMAP parked context. Do not treat a row as an operator revival decision."),
    p(text: provenance_paragraph(p: closed_pr_census_provenance)),
    p(text: "Every closed branch was kept. Re-derive on current main rather than rebase the old heads: each was red or stale for a reason. Candidate later work (still a row edit, not this carrier's job): N7 (#13558 and #13623), XL-2 string templates, and a small bundle of #13426, #13391 and #13642."),
    h2(text: "Census rows"),
    TableBlock {
      header: row(cells: [
        cell(text: "PRs"),
        cell(text: "Subject"),
        cell(text: "Area"),
        cell(text: "Why closed"),
        cell(text: "Disposition"),
      ]),
      alignments: [AlignNone, AlignNone, AlignNone, AlignNone, AlignNone],
      rows: closed_pr_recovery_rows |> map(item => recovery_table_row(r: item)),
    },
    h2(text: "How a later decision lands"),
    ul(items: [
      li(text: "ReviveOnMain / ReDeriveInV2 / ProductPriorityCall / Dead are closed coproduct arms. The operator's later call is an edit of `disposition` on the named row, not new prose."),
      li(text: "This module does not open revival work items and does not re-judge the census."),
    ]),
  ]
}

data v2_closed_pr_recovery_plan: Plan = Plan {
  projection: PlanProjectsCommittedMarkdown,
  slug: "v2-closed-pr-recovery",
  title: "v2 closed-PR recovery — census of closed-but-unfolded PRs after the v1 closeout",
  body: v2_closed_pr_recovery_body(),
  retirement: PlanRetiresWhen {
    condition: unbound_dissolution(description: "Delete this census when every ReviveOnMain, ReDeriveInV2 and ProductPriorityCall row has been row-edited to a terminal Dead or to landed revival work, so the closeout reading is no longer the reference for unrevived closed PRs.")
  },
}
