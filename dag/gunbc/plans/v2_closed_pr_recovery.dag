// CLOSED-BUT-UNFOLDED PR CENSUS as a planning carrier. The operator's instruction (2026-10-10):
// keep the v2-relevant work named so it cannot be lost. The census judgments are neat-wolf-604's
// 2026-10-10 reading, not verified facts; the dispositions record the operator's rulings of the
// same day (start and finish the v2 compiler rows; the shared-std and product/fleet/ops rows get
// in; the dead rows are irrelevant).

// ONE STANDING PER ROW, BY CONSTRUCTION (review 78443): a live row carries the area its diff
// touches and a live disposition; a dead row carries why it is dead and has no area. A dead
// row with a revival disposition, or a revival with an empty first step, has no constructor.
type ClosedPrArea
  = V2Compiler
  | SharedStdOrV1Written
  | ProductFleetOps

type DeadKind
  = RetiredFloor
  | Scratch
  | DuplicateOrSuperseded
  | PlansOnly
  | RejectedOnDesign
  | SubjectRetired

type LiveDisposition
  = ReviveOnMain { first_step: NonEmptyStr }
  | ReDeriveInV2 { what_carries_over: NonEmptyStr, first_step: NonEmptyStr }
  | ProductPriorityCall

type ClosedPrStanding
  = LiveWork { area: ClosedPrArea, disposition: LiveDisposition }
  | DeadWork { kind: DeadKind, why: NonEmptyStr }

type ClosedPrRecoveryRow {
  pr_numbers: List<Int>,
  subject: NonEmptyStr,
  why_closed: NonEmptyStr,
  standing: ClosedPrStanding,
}

type ClosedPrCensusProvenance {
  session: String,
  date: String,
  method: String,
  standing: CitedFigureStanding,
}

data closed_pr_census_provenance: ClosedPrCensusProvenance = ClosedPrCensusProvenance {
  session: "neat-wolf-604",
  date: "2026-10-10",
  method: "gh pr diff --name-only (paths, not line-by-line)",
  standing: TranscribedUncited {
    read_obligation: "Re-read each named PR's paths, completeness and greenness on current main before reviving it; this carrier transcribes neat-wolf-604's 2026-10-10 path-only reading. The revival dispositions are the operator's 2026-10-10 rulings, not part of the reading." as NonEmptyStr,
  },
}

