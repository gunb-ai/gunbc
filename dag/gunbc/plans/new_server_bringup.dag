module gunbc.plans.new_server_bringup

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetiresWhen, PlanIsAuthorityOnly }
import std.markdown { MarkdownBlock }
import gunbc.markdown_helpers { h2, h3, p, li, ul, ol, quote }

fn new_server_bringup_body() -> List<MarkdownBlock> {
  [
    quote(blocks: [
      p(text: "**Goal:** one reusable machine lifecycle that accepts an observed machine, decides how to install it, installs it safely, admits it, converges its roles and makes verified runner capacity out of it -- with srv4 carrying the site's boot and management edge so that no host's path depends on a hand tending mtcollins1."),
      p(text: "**What this carrier holds:** the direction, why it is worth doing, and done-when. It holds no phase list, no owner, no item status and no done mark; those are the realization, downstream and redrawn whenever work is picked up (section 4), and they live as work items under site-boot-and-management-edge in gunbc.roadmap.roadmap_authority."),
      p(text: "**Read at:** gunbc main `00cacc14979`; butch and srv4's edge read live 2026-11-10. Sections 2 and 3 re-read against the tree at main `8b434ce74d6c` on 2026-11-24 (keen-dove-217), by source inspection of the modules cited there; that read ran nothing live and is not a census. The carrier was landed on 2026-11-20 from branch session/smart-crane-730-plan (head c623b01ef18), which had no pull request and so had never been checked against main or against *Plans are intentions*; what it carried there -- a PR sequence with owners and states, out-of-repo actions and a status vocabulary -- is where the work items and the event log carry it now."),
    ]),

    h2(text: "1. The decisions this intention stands on, and where each is recorded"),
    p(text: "An intention does not hold its operator's decisions (DESIGN.md, *Plans are intentions*: a decision it needs from the operator is recorded in `gunbc.design_ruling` and cited, never kept in the plan or the pull request alone). What follows cites each decision's home rather than restating it; the wording they were recorded under is the carrier's section 1 on branch session/smart-crane-730-plan (head c623b01ef18), which had no pull request, so until this change no row in the repository carried them."),
    ul(items: [
      li(text: "PXE is the default installation path for every eligible physical machine, BMC virtual media stays a fallback needing an explicit evidenced reason, and an install is one-shot -- never a standing authorization to erase a disk: ruling gunbc.design_ruling::pxe_default_install_and_no_standing_erase_2026_11_10, whose model side is gunbc.network_boot_delivery::uefi_pxe_admitted_architectures and gunbc.fleet.site_pxe_edge_converge::site_pxe_edge_no_install_requests."),
      li(text: "An install is automated and an upsert: no person-produced disk reading is a requirement of install, the destination is media the model designates when that is available and otherwise an unformatted disk, and what an attempt may write is decided per layer of disk state -- raw and empty-table disks initialized automatically, the unit's own unfinished attempt replaced only when its attempt identity proves it, a verified installation adopted, everything else manual -- by rows in a policy module of this repository: ruling gunbc.design_ruling::install_target_is_designated_or_unformatted_2026_11_24, which supersedes for install admission the 2026-11-20 reading that each binding carries a target-disk identity read before actuation."),
      li(text: "Runner capacity is a completion condition, not a declaration: ruling gunbc.design_ruling::runner_capacity_counts_only_when_observed_2026_11_10, modelled by the per-host specs at gunbc.runner.runner_host_deploy."),
      li(text: "The PXE witnesses carry no required CI check: ruling gunbc.design_ruling::pxe_witnesses_need_no_required_ci_2026_11_10."),
      li(text: "butch (srv14) is CI-only with no interactive sessions, its two Strata engines priced against its capacity before its CI width is derived: modelled at gunbc.runner.runner_host_deploy (the already-installed CI-only host) and priced in gunbc.serving.serving_host_memory; its executor-route-only narrowing rests on gunbc.design_ruling::hosted_ci_bridges_to_remote_builds_and_adopts_work_execution_redesign. Overtaken since: its four A2s left the host on 2026-11-17 (gunbc.fleet.fleet_physical_inventory) and its serving engines are being retired by the operator (gunbc.design_ruling::butch_serving_retirement_is_operator_handled_2026_11_21), so the Strata pricing no longer describes it."),
      li(text: "bobo (srv15) stops at CI and access for now, its GPUs modelled when the operator installs them: gunbc.serving.serving_host_memory carries no GPU claim for it until a read exists."),
      li(text: "One fleet access policy with explicit access relationships per principal, gunbc-runner as the systemd listener everywhere: gunbc.fleet.fleet_ssh_access."),
      li(text: "srv1-srv4 move to gunbc-runner one host at a time, keeping working capacity and a rollback, sequenced with the rename program's host flips: the srv1 fleet-migration work items in the roadmap, each with its own rollback obligation."),
      li(text: "The board BR80S6102300049 has one current identity, srv13 retired, its 2026-10-07 observations keeping their original provenance rather than being rewritten as srv15 captures: gunbc.fleet.fleet_host_identity."),
      li(text: "A run-scoped service account reading only bmc-srv15-admin may be created through gcp_iam_converge: gunbc.auth.srv15_arrival_federation_provision."),
      li(text: "h11-a16 (host-6ce85c) enters convergence through the same contract, answering the operator's 'yes please' of 2026-11-12: the host-6ce85c rulings in gunbc.design_ruling, with its tag question settled by gunbc.design_ruling::ken_dan_both_participation_carries_ci_and_serving_tags_2026_11_18."),
    ]),
    h2(text: "2. Findings that shaped the plan"),
    p(text: "The first group is the 2026-11-10 reading that motivated the plan, kept as read then; an entry the 2026-11-24 re-read found changed says so in place. The second group is that re-read."),
    ul(items: [
      li(text: "Nothing had ever been installed over PXE. butch was installed 2026-10-30 over its BMC's USB virtual media (installer block device Linux File-Stor_Gadget, ds=nocloud from /cdrom)."),
      li(text: "The edge could not serve an install. Ubuntu's signed network GRUB loads only $prefix/grub.cfg. The edge served each install as grub.cfg-01-<mac> and made grub.cfg exit. srv15 reached GRUB three times on 2026-10-29/30 and left each time (artifacts/pxe/srv15-pxe-attempt-2026-10-30). Since fixed: the entry grub.cfg loads each client's own install config (gunbc#16254)."),
      li(text: "The edge converge only wrote desired files. Withdrawing a binding from the model left its served files on disk, so a withdrawal proved nothing about the edge."),
      li(text: "The edge held a wiping install binding for butch, an installed host. The installer uses StoragePolicyDirectLayout, which does not pin a target disk."),
      li(text: "The edge witness file had not compiled since 2026-10-30 (#15291), so all 68 of its witnesses were red outside the required gate."),
      li(text: "Every BMC boot or intake route is one host's leaf. gunbc.srv3.srv3_boot_once_cd is srv3-only, CD-only, has an expired source-declared grant and no workflow. Since replaced by a host-generic boot-once over a managed host's bound controller (gunbc#16306). The mtcollins1 boot and its run-scoped federation are MegaRAC/IPMI-only. gunbc.machine_intake.arrival_subject is mtjade1-only."),
      li(text: "srv15 is not a managed host. Its rotated credential has been in custody since 2026-10-29, but none of the read-only admission evidence exists."),
      li(text: "fleet_enrollment derives hosts from its population, but downstream consumers have not generalized. gunbc.runner.runner_capacity_plan takes srv3_width and srv4_width and returns exactly those two plans, and gunbc.runner.runner_capacity_realize is a scaffold whose runner-add can return RunnerCapacityApplyScaffold instead of provisioning a runner. Since changed: runner_capacity_plan is a fold over the enrolled executor hosts, and the realize scaffold is deleted (runner slots are added by gunbc.runner.runner_host_file_converge)."),
      li(text: "OwnedOsDelivery has no network-install arm, and the assimilation program selects install phases for virtual-media delivery only."),
    ]),
    p(text: "**Re-read 2026-11-24.**"),
    ul(items: [
      li(text: "Still no unit has been installed by gunbc.host.network_install. The only PXE install from srv4's edge is H11SSL-i unit 3 (x86_64, 2026-11-15), staged and booted by hand (gunbc.machine_intake.supermicro_h11ssl_unit3_intake_observation). srv15's arrival runs have not reached its controller: one timed out compiling, one stopped before the first BMC read."),
      li(text: "The lifecycle's per-unit facts are rows, but every row is authored by hand for one unit, and most populations hold one or two units: gunbc.machine_intake.arrival_subject arrival_converge_population (mtjade1, srv15), gunbc.host.network_install network_install_client_bindings (srv15), gunbc.machine_intake.bmc_credential_policy (one firmware build), gunbc.host.bmc_release_capability_catalog (MegaRAC only), gunbc.fleet.fleet_intent fleet_intent_known_hosts and gunbc.runner.runner_host_deploy runner_host_spec_rows (hand lists; the roster lists are gunbc.plans.fleet_machine_authority's to derive), and one credential module per unit (gunbc.auth.srv15_arrival_federation_provision, srv15_bmc_secret_versions_receipt)."),
      li(text: "No step discovers a controller on the network: every BMC address in the model was transcribed from a router page, a capture or an operator reading."),
      li(text: "BMC securing has no live path: the credential rotation (gunbc.machine_intake.arrival_converge bmc_secure) is modeled with its live read, live write and route qualification still frontiers, and every rotation and recovery to date was performed by hand."),
      li(text: "An unrecognized controller stops at family discrimination (gunbc.machine_intake.bmc_firmware_family_discriminator: OpenBMC, MegaRAC, Supermicro); there is no generic IPMI or generic Redfish arm, so a new vendor needs a family before its first read."),
      li(text: "Boot-device control is live only over IPMI (gunbc.machine_intake.oob_boot_handoff, a one-shot UEFI parameter-5 write read back before power). The Redfish one-shot override is modeled (gunbc.host.managed_host_boot_once) and has no executing route; nothing reads a controller's or firmware's persistent boot order, and gunbc.host.controller_capability states that persistence is not yet expressible."),
      li(text: "The pre-install disk reading had only one source, a hand-booted rescue medium; the ruling of 2026-11-24 removes it from install admission (section 1)."),
      li(text: "Install-method selection is modeled (gunbc.provisioning.provisioning_arm, gunbc.provisioning.network_boot_actuation, gunbc.fleet.fleet_boot_delivery_solution) and gunbc.host.network_install does not consult it; two judgments gate the one-shot boot (gunbc.host.managed_host_boot_once and gunbc.machine_intake.oob_boot_handoff)."),
      li(text: "The Aarch64 default chainloader is pinned but absent from srv4 (gunbc.integration_concern.site_pxe_edge_pinned_chainloader_member_absent_from_srv4); the Aarch64 install chain and the x86_64 shim/GRUB chain are present."),
    ]),

    p(text: "**Tabletop of the install route, 2026-11-24.** An external read-only review of main 8b434ce74d6c, relayed by the operator the same day, walked one dispatch from the generated workflow to the first job. The entries below are the contradictions it found that keen-dove-217 re-read in the source at that revision and confirmed; its crash and concurrency scenarios are consequences to be tested, not observations, and are carried as risks in section 8."),
    ul(items: [
      li(text: "**No row population admits a new unit to the install.** The install resolver obtains secured-controller evidence only through a managed-host row (gunbc.host.network_install_ci network_install_ci_managed_row, over managed_host_binding_for), and the install subject gate refuses any unit that is a managed host (gunbc.host.install_boot_subject admit_install_boot_subject, through admit_arrival_subject_in over managed_hosts()). Both read the same memberships (gunbc.host.managed_host managed_host_memberships), so no set of real rows satisfies both."),
      li(text: "**The installer and the edge disagree on which x86_64 chain installs.** The installer accepts only a chain pinned for InstallBoundClients (network_install_ci_chain); the x86_64 Ubuntu chain is pinned for EveryKnownClient, because its GRUB looks for a per-MAC install config and otherwise exits (gunbc.fleet.site_pxe_edge_converge chain declarations). An x86_64 unit has no install chain by the installer's reading although ken was installed from that chain by hand."),
      li(text: "**A successful install cannot close through the production reader.** gunbc.host.network_install_host_reader leaves the DHCP client class Unread, the fetch list empty and Secure Boot Unobserved, and stamps observed_at with the run's decided_at, while gunbc.provisioning.network_install_receipt requires those readings and an installer record inside the attempt window."),
      li(text: "**A refusal may not reach the operator.** The entry writes network-install-ci-receipt.txt (network_install_ci_receipt_path) and the generated step reads and uploads target/managed-host-network-install-receipt.txt; the reviewer also reports that the step passes none of the token inputs the managed credential reader accepts and that the credential is read before the missing-input report is written, which this re-read did not trace."),
      li(text: "**The public seed cannot carry an in-installer guard or a report.** gunbc.provisioning.public_nocloud_seed admits a closed set of keys, a direct layout matched by serial or model among them, and neither early-commands nor reporting; Canonical documents that early-commands run before Subiquity probes block devices."),
      li(text: "**The plan's own acceptance was stale.** butch's four A2s left the host on 2026-11-17 (gunbc.fleet.fleet_physical_inventory), its serving engines are being retired by the operator (gunbc.design_ruling::butch_serving_retirement_is_operator_handled_2026_11_21) and its CI width is ruled zero; srv9-srv12 are sold (gunbc.spark.dgx_procurement); dan (h11-a16, operator_host_6ce85c) has no row in gunbc.fleet.fleet_enrollment fleet_enrollments, so a fold over enrollment alone would omit it."),
    ]),

    h2(text: "3. The lifecycle contract"),
    p(text: "One procedure for every unit, physical or provider-hosted. It has five concerns, each with its own authority: which unit this is, how it should be delivered, which particular effects are permitted, what actually happened, and whether the unit now provides the service it was admitted for. A unit that cannot meet a requirement ends at that stage with an outcome that names the requirement, never routed around; a hold with its release condition is a correct outcome, not an unfinished one. A new unit enters as rows, and each stage is a fold over them: a stage that needs code, rather than a row, to admit a new unit of a family it already supports is a gap in the stage."),
    ol(items: [
      li(text: "**Identify the subject.** A provider-hosted unit (the Hetzner guests) is identified by its provider resource and image and has no site controller, boot NIC or PXE stage. A physical unit: locate the controller from what the site network shows -- a DHCP lease or a statically configured management link (a sealed unit can arrive with no lease) -- as a dated observation, never a transcribed literal. Read board identity, controller family and firmware, NICs and storage through the protocols the controller answers; an unrecognized family still gets the generic reads its protocols allow, and a refusal such as a license-gated Redfish service is recorded as what it is. Bind the physical identity once, keeping historical aliases and credential histories with their provenance. A retired identity (a sold unit) is identified and receives no dispatch."),
      li(text: "**Select the delivery.** One of: a fresh install over PXE; a fresh install over the controller's virtual media, only as the evidenced fallback section 1 preserves, with the missing PXE capability named; adoption of a unit already running a verifiable installation; a diskless image booted per boot; a provider image; or a hold with its release condition. PXE is the default for a fresh physical install; any other route is an evidenced selection (section 1). Diskless and provider deliveries select no local disk; adoption writes nothing to storage."),
      li(text: "**Authorize the particular effects.** Securing the controller, the boot write, the power action and each storage write are separate effects, and each needs its own admission: the controller's observed capability, the credential in custody, and the operator's approval for that operation and attempt where the controller's row requires one. Boot material may be staged early; the permission to alter storage is usable only after every check it depends on has passed. The boot source is proven per unit, not per protocol: a one-shot UEFI override read back before the reset, or the unit's own boot request arriving at the edge from the intended NIC; a readback that names PXE does not prove which port the firmware will use (ken's forced PXE takes LAN1, its install used LAN2)."),
      li(text: "**Observe the attempt.** Each attempt carries one identity from dispatch through the installer's result, the installed root, the first-boot host key and the edge withdrawal. An attempt may stay in progress while the installer runs, may be resumed from another executor after an interruption, and a lost report or an SSH timeout leaves it unresolved and observable rather than failed or done. Destination selection happens inside the attempt before its first storage write, on a complete device view, and the writer receives the same unique device (ruling in section 1). The edge withdraws the attempt's offer and only that attempt's. A missing completion record is a reason to find out what happened, never authority to repeat a storage write. First SSH trust is scoped to the attempt (a host key announced for that attempt), and becomes a durable enrollment only once the root and the attempt agree."),
      li(text: "**Verify the role.** The unit is enrolled, converged and reachable, and then proven at the service it was admitted for: a canary job run on that runner registration, a real remote build on that executor, a diskless image running its workload on this boot, or -- for a held, zero-width or restricted unit -- dispatch excluding it and saying why. Each step is a fold over the enrolled population; a unit is not added to a second hand list to take part."),
    ]),

    h2(text: "4. Sequence, staffing and state are downstream of this intention"),
    p(text: "**The first milestone is one existing unit, end to end.** The operator asked on 2026-11-24 for the work to get an end-to-end workflow for one existing machine, any but srv1-srv4. That milestone is the roadmap node bobo-onboarding-end-to-end: srv15 (bobo) taken from arrival through a fresh install to a CI build executed on it, by the workflow alone, the strongest first fresh-install case because its controller credential is already in custody. Its order is the prerequisite edges into that node and its timing the working-day estimates in gunbc.roadmap.roadmap_effort_estimate; the schedule answer (start and finish per leaf, critical path) is computed from both on each read by gunbc.roadmap.roadmap_schedule (gunbc.design_ruling::schedule_answers_are_computed_cached_and_re_read); none of it is restated here, because a schedule kept in this carrier would be a second one (gunbc.design_ruling::planning_scheduling_is_cut)."),
    p(text: "What has to happen, in what order, who picks it up and how far each piece has got is a selection made against this intention (DESIGN.md, *Plans are intentions*: a work item names the intention it serves; the intention does not list its work items). It lives as work items under site-boot-and-management-edge in gunbc.roadmap.roadmap_authority -- the install lane from the arrival door through the dispatch, butch's route, the srv4 edge trio with its Apply gate, ken's strata re-read, and mtcollins1's boot legs and their retirement -- with their prerequisite edges carrying the order and their own updates threads carrying what a live read said and when. That selection may be redrawn whenever work is picked up, without this carrier changing; nothing here records a phase, an owner or a state, and a merged pull request is not done (gunbc.design_ruling::work_item_acceptance_is_the_managers_or_an_escalation)."),

    h2(text: "5. Fleet completion condition"),
    p(text: "Done means every identified unit has an established standing, derived as a fold over the identified population rather than kept as a hand list: installed and serving its role, adopted, booting diskless, held with its release condition, restricted from a role with the reason, or retired. A unit whose install is in progress or whose outcome is unknown stays visible as that until it resolves, and the census is not complete while any unit lacks a standing. Which units are in the population, and what each one's standing is today, is decided by the fleet model rows and the work items under site-boot-and-management-edge, not here. srv1, srv2, srv3, srv4, srv14, srv15, mtcollins1, mtjade1, host-6ce85c (dan), host-e2d4b7 (ken), H11SSL-i unit 2, the Hetzner guests and the sold DGX Sparks (srv5-srv12) are named only so no unit is quietly absent from the fold; a name here carries no standing."),

    h2(text: "6. Acceptance"),
    p(text: "Done means a recorded live run or readback per item. Merged PRs, green witnesses or a row saying a host is enrolled are not enough. The cases are chosen because the same architecture gives materially different answers on this fleet."),
    ul(items: [
      li(text: "**A refusal through the generated workflow.** A dispatch of the network install for a deliberately ineligible subject, through the generated fleet-converge workflow, ends with a retrieved receipt naming the executor, the subject and the reason, and with no edge or controller change. A dispatch for an existing managed host refuses and leaves it untouched."),
      li(text: "**bobo (srv15), a fresh arm64 install.** A dispatch from a newly secured arrival outside managed membership boots srv15 over PXE through the arm64 install chain under its controller's per-write approval. Inside the attempt the destination is selected as the ruling directs, on a unit whose recovery capture shows both a USB rescue drive and an internal NVMe; the unit then boots from the selected disk with the offer withdrawn, answers SSH with the fleet key, and a CI job's build is recorded as executed on srv15 through the remote-build bridge, linked to its job and revision, with its capacity reservation released afterwards (srv15 is an executor, never the GitHub runner). A second dispatch verifies or adopts the result without a storage write."),
      li(text: "**Interruption and concurrency.** One attempt interrupted after the offer is published, after the controller accepts the boot, after storage is written, after the first local boot, and after withdrawal but before completion is recorded, and resumed from another executor: in each case the effects that actually happened are established, another storage write needs fresh authority, and another unit's concurrent offer survives."),
      li(text: "**ken (H11SSL-i unit 3), adoption on x86_64.** The hand-installed unit is adopted without reinstall: its boot port, identity, actual delivery and authenticated first contact proven separately, and its first workload recorded as executed on ken itself."),
      li(text: "**mtcollins1, diskless.** The intended image boots, the boot is identified as this boot, the runner baked into the image runs a job, a reboot establishes a new boot identity, and losing the media server is a declared result."),
      li(text: "**Held, restricted and retired units.** mtjade1 is identified and held with its release condition and no boot; butch reaches the edge over PXE as an installed client, receives no installer, and keeps its declared executor-only, zero-width role; the Hetzner guests show their microVM restriction as a role restriction; no dispatch reaches a sold Spark."),
      li(text: "**A second unit by rows alone.** A unit other than srv15, of a controller family the lifecycle already supports, goes from identified to serving with only its own rows added and the operator's per-occasion approvals given -- no module, no code path and no hand step written for it."),
      li(text: "**Leaves deleted.** The srv3 boot-once, the mtjade1-only arrival row, the mtcollins1-only boot account and srv13 are gone, with the historical observations' provenance kept."),
      li(text: "**dan (h11-a16) in the fleet.** fleet-converge plan and apply run green with dan as subject, its access template is applied, and its serving memory is Read, with no step added for it alone."),
      li(text: "**srv1-srv4 as gunbc-runner.** Each host is cut over with its rollback, and CI is green after each cutover."),
    ]),

    h2(text: "7. Decided: no required CI for the PXE witnesses"),
    p(text: "Recorded, not restated: ruling gunbc.design_ruling::pxe_witnesses_need_no_required_ci_2026_11_10 settles that the floor-reading PXE witnesses do not join required CI, and narrows gunbc.design_argument::conformance for that class only. It costs nothing in rigour: each witness still has to go RED against its plant and GREEN against its fix on a post-wall binary before the work item that owes it can be accepted."),


    h2(text: "8. Risks"),
    ul(items: [
      li(text: "An install offer can wipe the disk of any client that reaches it. No offer stands: one attempt offers one NIC an installer, the installer writes only a destination the ruling admits, and the attempt withdraws its own offer and served files before it ends."),
      li(text: "A unit that boots the network persistently reaches the edge on every boot. That is safe only while the edge offers nothing that installs to an unbound client, so the edge's offer to unbound clients is part of this lifecycle's safety."),
      li(text: "Two attempts can interfere. A unit hold kept in two stores under one key excludes nothing, a completion journal read before the hold is taken can be stale by the time it is used, and an edge reconciled to exactly one attempt's offer removes another attempt's; until the edge reconciles all active attempts, installs are serialized at the edge for their whole lifetime."),
      li(text: "A completion that was never recorded looks like no install. Retrying the storage write on a disk an earlier attempt already wrote is the failure to avoid; the attempt identity carried onto the installed root is what lets recovery find the earlier result."),
      li(text: "A boot override can be correct and still boot the wrong port. A readback proves what the controller stored, not which NIC the firmware will use; the edge's sighting of the intended NIC is the evidence for that."),
      li(text: "srv13 and srv15 have two credential histories for one controller (2026-10-07 forced rotation, 2026-10-29 in-band rotation). The route pins secret version v1 and refuses if the managed probe fails. A rotation whose response was lost must be reconciled against custody, never retried with the factory credential."),
      li(text: "A Redfish boot override that is not Once and UEFI, or not read back, is not trusted. Legacy is a silent no-op on arm64."),
      li(text: "Migrating gunbc-runner and renaming the same host in one window doubles the rollback surface. Each host needs a rollback witness over both changes and a separately verified management path before it is drained."),
    ]),

  ]
}

data new_server_bringup_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly,
  slug: "new-server-bringup",
  title: "New server bring-up: one machine lifecycle, PXE-first, to verified runner capacity",
  body: new_server_bringup_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "srv15 was installed over PXE by one network-install attempt, its destination selected and classified inside the attempt and its offer withdrawn by that attempt, a CI job's build was recorded as executed on srv15 with its reservation released, and a second dispatch adopted it without a storage write; ken was adopted without reinstall and a workload was recorded as executed on ken itself; mtcollins1 ran a job on a diskless boot; a refusal through the generated workflow returned its receipt; mtjade1, butch, the Hetzner guests and the sold Sparks each ended at their stated hold, role, restriction or exclusion; srv1-srv4 run as gunbc-runner; the fleet completion census leaves no unit without a standing; and the srv3/mtcollins1/mtjade1 boot and intake leaves are deleted in favor of host-generic routes.") },
}
