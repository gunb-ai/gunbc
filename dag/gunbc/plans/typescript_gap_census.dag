module gunbc.plans.typescript_gap_census


fn typescript_gap_census_body() -> List<std.markdown.MarkdownBlock> {
  [
    gunbc.plans.md_helpers.p(text: "**Status:** audit-first discriminating census · **approved 2026-07-01** (loyal-bee-794) · linked from `ROADMAP.md` `5-ts-first-class` · companion to [v2-self-hosting.md](v2-self-hosting.md) Wave 4 / END GOAL (post-Rust; Track T retired). **`dag/gunbc/plans/typescript_gap_census.dag` is the authority** (DESIGN §6); `docs/plans/typescript-gap-census.md` is its generated projection (PlanArtifact)."),
    gunbc.plans.md_helpers.p(text: "**Method:** enumerate construct families `src/v2` actually uses (compiler substrate behaviors in `src/v2/compiler/*` + TargetModel emit surfaces in `src/v2/extdeps/languages/typescript.dag`). For each family report three independent bars: (a) grammar-inverse row enrolled on the committed TargetModel node, (b) VEP / pipeline emits the expected **TypeScript source string** (witness PASS), (c) **`tsc` / emit_host accepts the output** (consumer green-by-execution). Every FAIL names a witness or authority site — not a stub count."),
    gunbc.plans.md_helpers.quote(blocks: [
      gunbc.plans.md_helpers.p(text: "**Two-bar clarification (parent reframe 2026-07-01).** The GREEN column below is **bar (b) only** — VEP produces the expected TS source string. Bar (c) — `tsc` actually compiles the emitted output — is **UNMET even for `add`**: `typescript_descriptor_node_ts_node_run_add_holds` (`src/v2/test/claim/manual/typescript_descriptor_node_run_test.dag`) and `emit_host_gate_passes` (`dag/tools/emit_host_gate.dag`) both **FAIL wet** in execution. A construct is not genuinely first-class until bar (c) is green. **Do not stack breadth on a red tsc foundation.**"),
    ]),
    std.markdown.ThematicBreak,
    gunbc.plans.md_helpers.h2(text: "1. Baseline (merged on main, not stub PRs)"),
    gunbc.plans.md_helpers.ul(items: [
      gunbc.plans.md_helpers.li(text: "#5695 — Char atom-realization + green typed-fn emit"),
      gunbc.plans.md_helpers.li(text: "#5701 — FieldAccess + RecordConstruct + `tsc --noEmit` oracle (source-string witnesses; bar (c) still red — see #19)"),
      gunbc.plans.md_helpers.li(text: "#5704 — operators by inhabitance (test-catalog only, not default TargetModel)"),
      gunbc.plans.md_helpers.li(text: "#5938 — collection-method grammar rows"),
      gunbc.plans.md_helpers.li(text: "~55 `typescript_*` / `ts_*` test fns under `src/v2/test/claim/` (manual + execution trees)"),
    ]),
    gunbc.plans.md_helpers.h2(text: "2. Census table"),
    gunbc.plans.md_helpers.h3(text: "VEP source-string GREEN (bar (b) witness PASS)"),
    gunbc.plans.md_helpers.ol(items: [
      gunbc.plans.md_helpers.li(text: "**#1 fn add** — grammar-inverse row + full infer→emit pipeline. Witness: `add_body_ts_emit_add_fn_accepts_holds`, `typescript_add_emit_add_fn_accepts_holds` (`add_body_emit_typescript_test.dag`, `typescript_add_emit_translate_test.dag`)."),
      gunbc.plans.md_helpers.li(text: "**#2 field access** — VEP. Witness: `ts_field_access_emit_source_holds` → `\"o.x\"` (`typescript_field_access_emit_test.dag`)."),
      gunbc.plans.md_helpers.li(text: "**#3 record construct** — VEP. Witness: `ts_record_construct_emit_source_holds` (`typescript_record_construct_emit_test.dag`)."),
      gunbc.plans.md_helpers.li(text: "**#4 bind let IIFE** — VEP. Witness: `ts_bind_let_iife_emit_exact_holds` (`typescript_bind_let_iife_emit_test.dag`)."),
      gunbc.plans.md_helpers.li(text: "**#5 closure (value-producing)** — VEP. Witness: `ts_closure_emit_by_execution_exact_holds` (`typescript_closure_emit_by_execution_test.dag`)."),
      gunbc.plans.md_helpers.li(text: "**#6 enum / disj union** — VEP. Witness: `ts_enum_union_emit_by_execution_exact_holds` (`typescript_enum_union_emit_by_execution_test.dag`)."),
      gunbc.plans.md_helpers.li(text: "**#7 module import** — VEP. Witness: `ts_import_emit_by_execution_exact_holds` (`typescript_import_emit_by_execution_test.dag`)."),
      gunbc.plans.md_helpers.li(text: "**#8 effect apply** — VEP. Witness: `ts_effect_io_emit_holds` (`typescript_effect_io_emit_test.dag`)."),
      gunbc.plans.md_helpers.li(text: "**#9 fold_call body via translate** — VEP. Witness: `v2.test.manual.fold_call_closure_emit` `fold_call_emit_holds`; the paired `fold_call_swap_discriminates` is the red control."),
      gunbc.plans.md_helpers.li(text: "**#10 operators (arith/cmp)** — VEP with **ad-hoc test catalog only** (`add_body_ts_emit_catalog_minus_discriminates`, `add_body_ts_emit_missing_catalog_rejects`). Default `v2.extdeps.languages.typescript` `ts_operator_realizations_catalog_node` enrolls **OpAdd only** — see #16."),
    ]),
    gunbc.plans.md_helpers.h3(text: "FAIL-CLOSED (emit explicitly Rejected — named)"),
    gunbc.plans.md_helpers.ol(items: [
      gunbc.plans.md_helpers.li(text: "**#11 loop in statement-sequenced block mode** — `ts_loop_statement_sequenced_fails_closed_holds` (`typescript_bind_let_iife_emit_test.dag`; also `typescript_closure_emit_by_execution_test.dag`). `.dag` loop emits; TS `StatementSequenced` mode rejects."),
      gunbc.plans.md_helpers.li(text: "**#12 closure in statement-sequenced block mode** — `ts_closure_statement_sequenced_fails_closed_holds` (same files)."),
    ]),
    gunbc.plans.md_helpers.h3(text: "FAIL-OPEN (compiler-scale; no green bar (b)+(c) on default model today)"),
    gunbc.plans.md_helpers.ol(items: [
      gunbc.plans.md_helpers.li(text: "**#13 match / coproduct dispatch** — `match_form.match_token = ^ts_token_unwired_match` (`v2.extdeps.languages.typescript` `ts_value_expression_projection_full`); no TS match witness; compiler uses `Match` heavily (`05_eval.dag`)."),
      gunbc.plans.md_helpers.li(text: "**#14 bind-in scoping** — `let_form.in_token = ^ts_token_unwired_bind_in` (`v2.extdeps.languages.typescript` `ts_value_expression_projection_full`)."),
      gunbc.plans.md_helpers.li(text: "**#15 loop form wiring** — `loop_form.loop_token = ^ts_token_unwired_loop` (`v2.extdeps.languages.typescript` `ts_value_expression_projection_full`)."),
      gunbc.plans.md_helpers.li(text: "**#16 default operator catalog** — `v2.extdeps.languages.typescript` `ts_operator_realizations_catalog_node` rows = `[ts_add_operator_realization_row()]` only. Algebra ops miss on default model (`add_body_ts_emit_missing_catalog_rejects`)."),
      gunbc.plans.md_helpers.li(text: "**#17 grammar-inverse rows beyond add** — committed `v2.extdeps.languages.typescript` `ts_translation_rules_node` has **1** child (`fn_add`); `ts_translation_rules_witness` carries **2** rows (add + type_alias), while `ts_pr3_translation_rules_witness` carries **3** (add + type_alias + pr3). Type_alias and pr3 are witnessed candidates but neither is enrolled in the committed bundle."),
      gunbc.plans.md_helpers.li(text: "**#18 branch dispatch** — compiler uses `Branch` (`04_infer` / `05_eval`); zero TS emit witnesses."),
      gunbc.plans.md_helpers.li(text: "**#19 tsc-green / emit_host oracle** — §5 spec-without-execution crack. Sole consumer path: `ts_host_transport_descriptor` + `emit_host_gate.dag`. **`typescript_descriptor_node_ts_node_run_add_holds` FAIL** (wet `claim_batch`); **`emit_host_gate_passes` FAIL** (wet). Bar (c) red even for add."),
      gunbc.plans.md_helpers.li(text: "**#20 whole `src/v2` → TS** — no module; Route-A tsc analogue not started (terminal slice E)."),
    ]),
    gunbc.plans.md_helpers.h2(text: "3. Discriminating counts"),
    gunbc.plans.md_helpers.ul(items: [
      gunbc.plans.md_helpers.li(text: "**VEP source-string GREEN families:** 9 (#1–#9; #10 green only with ad-hoc catalog)"),
      gunbc.plans.md_helpers.li(text: "**FAIL-CLOSED:** 2 (#11–#12)"),
      gunbc.plans.md_helpers.li(text: "**FAIL-OPEN compiler-scale gaps:** 8 (#13–#20)"),
      gunbc.plans.md_helpers.li(text: "**tsc-green (bar c):** 0/N wet — add fixture attempted, red in execution (#19)"),
      gunbc.plans.md_helpers.li(text: "**Grammar-inverse rows:** 1 committed / 3 in witness bundle / ~15 type-decl productions defined"),
    ]),
    gunbc.plans.md_helpers.h2(text: "4. Size call"),
    gunbc.plans.md_helpers.p(text: "**LARGE multi-slice** — not a single row PR. Cheap tranche = grammar-row extensions (#17) + operator catalog derivation onto default TargetModel if row-only (#16). Load-bearing tranche = Match (#13) + loop/bind forms (#14–#15) + Branch (#18) — **HOLD for parent sign** before authoring TargetModel surfaces. Whole-tree tsc (#20) is terminal after per-construct gaps close."),
    gunbc.plans.md_helpers.h2(text: "5. Sequencing (revised 2026-07-01)"),
    gunbc.plans.md_helpers.ol(items: [
      gunbc.plans.md_helpers.li(text: "**A. Land this census** (this plan) — audit-first record, generated md."),
      gunbc.plans.md_helpers.li(text: "**A2. tsc-green oracle REAL on existing VEP-green slices (#19 pulled forward)** — per-construct `tsc` acceptance on #1–#9 before stacking breadth. Converts string-green families into compile-green. Highest-value foundation work."),
      gunbc.plans.md_helpers.li(text: "**B. Cheap row extensions (#17)** — enroll the type_alias row from `v2.extdeps.languages.typescript` `ts_translation_rules_witness` and the pr3 row from `ts_pr3_translation_rules_witness` into committed `ts_translation_rules_node`; rows only, no new TargetModel surface."),
      gunbc.plans.md_helpers.li(text: "**C. Operator catalog (#16)** — proceed **only** if genuinely row-derivation onto the default model; if it needs a new TargetModel surface → load-bearing → sign first."),
      gunbc.plans.md_helpers.li(text: "**D. HOLD for parent sign:** Match (#13) + loop/bind (#14–#15) + Branch (#18) — compiler-scale TargetModel surfaces."),
      gunbc.plans.md_helpers.li(text: "**E. Whole-tree Route-A tsc (#20)** — terminal."),
    ]),
    gunbc.plans.md_helpers.p(text: "**Priority note:** Lane C is language-breadth; operator retains burn-down sequencing call. Proceed A → A2 → B meanwhile; HOLD D for both parent sign and operator priority."),
  ]
}

data typescript_gap_census_plan: gunbc.plan.Plan = gunbc.plan.Plan {
  slug: "typescript-gap-census",
  title: "TypeScript first-class gap census — discriminating construct audit (Lane C / Track T)",
  body: typescript_gap_census_body(),
  retirement: gunbc.plan.PlanRetiresWhen { condition: std.dissolution.unbound_dissolution(description: "Delete this census once every FAIL-OPEN row (#13–#20) is closed with execution-grounded witnesses and bar (c) tsc-green holds on the default TargetModel — the audit record is superseded by the substrate facts it enumerated.")
  }
}
