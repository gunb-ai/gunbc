module gunbc.plans.typescript_gap_census

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetirement, PlanRetiresWhen, PlanIsAuthorityOnly }
import std.markdown { MarkdownBlock }
import gunbc.plans.md_helpers { p }
import gunbc.design_ruling { project_documentation_projections_are_not_checkout_artifacts }

fn typescript_gap_census_body() -> List<MarkdownBlock> {
  [
    p(text: "Goal: first-class TypeScript emission after Rust self-hosting. This is the audit approved 2026-07-01, linked by roadmap_authority 5-ts-first-class and v2_self_hosting Wave 4; dated standings require rereading. This .dag Plan is authority-only, not a checkout Markdown projection."),
    p(text: "Method: enumerate compiler-used constructs against committed typescript TargetModel. Keep three independent bars: (a) grammar-inverse enrollment, (b) expected emitted source, (c) actual tsc/emit_host acceptance. Name a witness/owner for each failure. In the recorded run, bar (c) failed even for add: typescript_descriptor_node_ts_node_run_add_holds and emit_host_gate_passes failed wet. Establish that foundation before breadth. Baseline receipts: #5695 Char/typed-fn, #5701 field/record and tsc oracle, #5704 test-only operators, #5938 collections."),
    p(text: "Bar-(b) controls: #1 add_body_ts_emit_add_fn_accepts_holds / typescript_add_emit_add_fn_accepts_holds; #2 ts_field_access_emit_source_holds; #3 ts_record_construct_emit_source_holds; #4 ts_bind_let_iife_emit_exact_holds; #5 ts_closure_emit_by_execution_exact_holds; #6 ts_enum_union_emit_by_execution_exact_holds; #7 ts_import_emit_by_execution_exact_holds; #8 ts_effect_io_emit_holds; #9 fold_call_emit_holds with fold_call_swap_discriminates red control. #10 arithmetic/comparison passed only under an ad-hoc catalog (add_body_ts_emit_catalog_minus_discriminates / add_body_ts_emit_missing_catalog_rejects), not default-model coverage."),
    p(text: "Fail-closed: #11 ts_loop_statement_sequenced_fails_closed_holds and #12 ts_closure_statement_sequenced_fails_closed_holds reject StatementSequenced TypeScript even where .dag loop emission exists."),
    p(text: "Compiler-scale gaps retaining their retirement IDs: #13 match_token=ts_token_unwired_match, no match witness; #14 in_token=ts_token_unwired_bind_in; #15 loop_token=ts_token_unwired_loop, all in ts_value_expression_projection_full. #16 default ts_operator_realizations_catalog_node has only add. #17 committed ts_translation_rules_node has fn_add; type_alias and pr3 are witnessed in ts_translation_rules_witness / ts_pr3_translation_rules_witness but unenrolled. #18 Branch has no TS emit witness despite compiler use. #19 ts_host_transport_descriptor→emit_host_gate remains wet-red. #20 whole src/v2→TS / Route-A tsc has no implementation."),
    p(text: "Validate and sequence: A2 executing tsc on #1–#9; B enroll witnessed type_alias/pr3 rows without new TargetModel surface; C derive default operator rows only if row-only, otherwise obtain parent sign; D hold Match/loop/bind/Branch surfaces for parent sign and operator priority; E whole-tree tsc after per-construct closure. Operator retains language-breadth priority. The A audit pass is retired as a prerequisite by the 2026-10-30 process ruling (`gunbc.design_ruling bad_process_is_worse_than_no_process`); it establishes no coverage. String green, test-only catalogs and defined-but-unenrolled rows never discharge execution."),
  ]
}

data typescript_gap_census_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly { ruling: project_documentation_projections_are_not_checkout_artifacts },
  slug: "typescript-gap-census",
  title: "TypeScript first-class gap census — discriminating construct audit (Lane C / Track T)",
  body: typescript_gap_census_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "Delete this census once every FAIL-OPEN row (#13–#20) is closed with execution-grounded witnesses and bar (c) tsc-green holds on the default TargetModel — the audit record is superseded by the substrate facts it enumerated.")
  }
}
