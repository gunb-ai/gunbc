module gunbc.plans.p4_home_serving_power_semantics

import std.dissolution { unbound_dissolution }
import std.types { Duration, NonEmptyStr, Timestamp }
import std.nat { Nat }
import gunbc.plan { Plan, PlanRetirement, PlanRetiresWhen, PlanIsAuthorityOnly }
import std.markdown { MarkdownBlock, MarkdownListItem, TableBlock, CodeBlock, MarkdownAlignment, AlignNone }
import gunbc.plans.md_helpers { h2, h3, p, li, ul, ol, cell, row, quote }
import gunbc.design_ruling { project_documentation_projections_are_not_checkout_artifacts }

// The carrier for the P4 home-serving watt-semantics decision. DESIGN §1: "A plan's
// authority is its `.dag` carrier; generated plan markdown whose only consumer is
// ProjectDocumentation is not a checkout artifact." So there is deliberately NO
// docs/plans/*.md for this plan — the `PlanIsAuthorityOnly` projection below is what
// says so, and the generated-artifact gate treats a committed projection of it as stale.
//
// Two conventions this carrier holds itself to, because a decision document is where
// they are easiest to violate:
//   * DESIGN §3 — every code reference names the module and symbol, never a file:line.
//     (One citation in an earlier draft drifted out from under its own line number while
//     the document was being written, which is the failure that rule names.)
//   * DESIGN §6 — where a claim rests on a count, the count is named as the command that
//     re-derives it, not transcribed as a number. Transcribed counts rot unreachably;
//     the file-count claims in an earlier draft had already gone stale twice.
fn p4_home_serving_power_semantics_body() -> List<MarkdownBlock> {
  [
    p(text: "Status: **decided — by default, not by the operator.** One question, one recommendation; the recommendation (option C) stands, and its model is built and open as PR #14463. Cards and power limits remain undecided: see \"Outcome\" at the end. Nothing here was merged by the author."),
    p(text: "Owner: vivid-ant-730 (\"own PR4\", assigned by the operator). Depends on: P1 #13762 (merged de0fedf0005), P2 #13771 (merged 466a08da), P3 #13774 (merged a2d57236bf2). Every citation below was re-checked against `origin/main`; the ones I could not confirm are deleted rather than hedged."),
    h2(text: "The request P4 is meant to satisfy"),
    p(text: "`gunbc.serving.home_serving_accelerator_field` declares P4's frontier in one row:"),
    quote(blocks: [
        p(text: "\"DESIGN section 3c declared frontier: these lists are consumed by P4 home-serving selection, which imports `home_serving_add_in_card_catalog_rows` as the purchase-candidate field and `home_serving_reference_sxm_catalog_rows` as references only. Trigger: that fold exists and deleting either list makes it fail to resolve. **A witness that only asserts the lists exist does not close this frontier.**\" — `gunbc.serving.home_serving_accelerator_field::home_serving_accelerator_field_p4_frontier`"),
    ]),
    p(text: "So the deliverable is a **selection fold over the card list**, not another list. Today the only thing that touches either list is one existence claim:"),
    CodeBlock { code: "test fn w_purchase_candidates_are_add_in_cards_and_sxm_are_references() -> Bool {\n  catalog_sku_in(rows: home_serving_add_in_card_catalog_rows, row: nvidia_rtx_pro_5000_72gb_catalog)\n    && catalog_sku_in(rows: home_serving_add_in_card_catalog_rows, row: nvidia_rtx_pro_6000_workstation_catalog)\n    && !catalog_sku_in(rows: home_serving_add_in_card_catalog_rows, row: nvidia_b200_sxm_catalog)\n    && ..." },
    p(text: "— `test.claim.home_serving_extdeps_facts_witness::w_purchase_candidates_are_add_in_cards_and_sxm_are_references`"),
    p(text: "That is precisely the existence-assertion the frontier says does not close it. The frontier is open, and honest about being open."),
    p(text: "\"cards × power limits\" is the shape. **\"What the watt figure means\" is the decision that has to be made before the shape can be built**, because the tree holds two different watt carriers that both read 600 for the PRO 6000 and do not mean the same thing."),
    h2(text: "The finding: two Watt carriers, both 600, meaning different things"),
    TableBlock {
      header: row(cells: [
        cell(text: "carrier"),
        cell(text: "where"),
        cell(text: "standing"),
        cell(text: "what it is"),
      ]),
      alignments: [AlignNone, AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [
          cell(text: "`GpuModelCatalogRow.tdp_watts: Watt?`"),
          cell(text: "`extdeps.gpu.types::GpuModelCatalogRow.tdp_watts`"),
          cell(text: "cited — `CitedToAuthority`, on the datasheet (P1)"),
          cell(text: "a **published ceiling** of the SKU, from NVIDIA's document"),
        ]),
        row(cells: [
          cell(text: "`ServingAcceleratorRealization.applied_power_limit: Watt?`"),
          cell(text: "`gunbc.spark.serving_performance_subject::ServingAcceleratorRealization.applied_power_limit`"),
          cell(text: "**carries no standing at all**"),
          cell(text: "a **limit set on one run** of one machine"),
        ]),
      ]
    },
    p(text: "Both are the same carrier type — `std.measure` `Watt`. Nothing in the tree relates them. The witness reads both field declarations (`extdeps.gpu.types::GpuModelCatalogRow.tdp_watts`, `gunbc.spark.serving_performance_subject::ServingAcceleratorRealization.applied_power_limit`) and reads the two modules a rule would live in; the command, not a number transcribed here, is the record: `git grep -i tdp origin/main -- dag/gunbc/spark dag/gunbc/serving`. There is no `applied ≤ tdp` rule, and no statement of which is which. A subject at an applied 600 W is, as the tree stands, readable as a card with a TDP of 600 W. Those are different facts about different things — one is a property of the product, the other a property of an afternoon."),
    p(text: "Three measurements sharpen this from \"confusing\" to \"actively misleading\"."),
    h3(text: "(1) `tdp_watts` is load-bearing in a way no other catalog field is"),
    p(text: "Diffing the two PRO 6000 rows field by field, every field is identical except the model name, the citation list, and TDP:"),
    CodeBlock { code: "<   model: \"RTX PRO 6000 Blackwell Workstation Edition\",   >   model: \"RTX PRO 6000 Blackwell Max-Q\",\n<   tdp_watts: watt(count: 600),                            >   tdp_watts: watt(count: 300),\n<   figure_citations: rtx_pro_6000_workstation_...          >   figure_citations: rtx_pro_6000_max_q_..." },
    p(text: "Every other declared field of those two rows agrees — `extdeps.gpu.nvidia::nvidia_rtx_pro_6000_workstation_catalog` against `nvidia_rtx_pro_6000_max_q_catalog`, compared field by field above. **TDP is the only field that distinguishes them** — and both are in the purchase-candidate list:"),
    CodeBlock { code: "data home_serving_add_in_card_catalog_rows: List<GpuModelCatalogRow> = [\n  nvidia_rtx_pro_5000_48gb_catalog,      nvidia_rtx_pro_5000_72gb_catalog,\n  nvidia_rtx_pro_6000_workstation_catalog, nvidia_rtx_pro_6000_max_q_catalog,\n]                                                    -- `gunbc.serving.home_serving_accelerator_field`" },
    p(text: "For a home-serving purpose those two are not two products: they are one product at two power ceilings. And the PRO 5000 pair behaves the opposite way — identical except capacity (48 vs 72 GiB), both `watt(count: 300)`. So TDP and capacity are each load-bearing discriminators, across *different* pairs, and the list cannot tell you which one is doing the work."),
    p(text: "Because the field is `Watt?` (optional) and the list is `List<GpuModelCatalogRow>`, today \"× power limits\" would multiply the card list by a field that is already inside the card row — restating it, not sweeping it."),
    h3(text: "(2) No receipt anywhere records an applied power limit"),
    p(text: "The witness lists `fixtures/gpu_bench/` and reads every entry in it (`ls -1 fixtures/gpu_bench/pro6000ws_600w_v2/` re-derives the same list). The claim is that no entry under any fixture path carries a watt figure; the witness checks that by reading each file, not by this sentence asserting it."),
    ul(items: [
      li(text: "`fixtures/gpu_bench/pro6000ws_600w_v2/warm_ninfer_nvfp4_pro6000ws_600w.jsonl` (re-derive with `grep -c '\"run\"' <fixture>`) has one fixed key set per record: `…completion_tokens, error, max_tokens, phase, prompt_tokens, round, run, schema, status, t_end, t_first, t_start…` (re-derive with `head -1 <fixture> | tr ',' '\\n'`). No power field."),
      li(text: "`auto.log` and `results_ninfer_nvfp4_pro6000ws_600w.txt`: `grep -Ei 'watt|power|tdp' fixtures/gpu_bench/pro6000ws_600w_v2/*` returns no match in either. Byte sizes are deliberately not transcribed — `wc -c` over that directory re-derives them."),
      li(text: "The substring \"600\" is re-derived rather than transcribed, by the witness reading the file and partitioning every occurrence of it. What is load-bearing is read there, not written here: which classes the occurrences fall into, and whether any is a measurement. The classes it sorts into are the run-name label (the `run` key of `warm_ninfer_nvfp4_pro6000ws_600w`, whose name carries the digits twice, in `pro6000ws` and in `600w`) and digit runs inside epoch timestamps. The claim is that **not one occurrence is a measurement** — a label, plus coincidental clock digits — and the witness is red if an occurrence falls outside both classes or inside a key that reads as power. (An earlier draft of this document said the hits were *only* inside the run name; the timestamp class refuted that, which is exactly why the count is stated as a command plus its classes rather than as a number.)"),
    ]),
    p(text: "So `600w` in this repo today means *\"the 600 W SKU\"*: a SKU label baked into a directory name, a filename, and a run id. It does **not** mean *\"this run executed under a 600 W limit\"*, and there is no field in which that claim could be recorded."),
    p(text: "`applied_power_limit` has **no producer outside its own module** and is not read by anything that judges power. Every site (`git grep -n applied_power_limit dag`):"),
    TableBlock {
      header: row(cells: [
        cell(text: "site"),
        cell(text: "role"),
      ]),
      alignments: [AlignNone, AlignNone],
      rows: [
        row(cells: [
          cell(text: "`gunbc.spark.serving_performance_subject::ServingAcceleratorRealization.applied_power_limit`"),
          cell(text: "field declaration"),
        ]),
        row(cells: [
          cell(text: ""),
          cell(text: "`Absent => AxisUnread`, else `AxisRead` — reads **presence only**; the watt value itself is never inspected"),
        ]),
        row(cells: [
          cell(text: ""),
          cell(text: "`match a.applied_power_limit { Absent => \"<unread>\"; Present { value: w } => to_string(watt_count(w: w)) }` — a **wire projection**, which is realization, not identity"),
        ]),
        row(cells: [
          cell(text: ","),
          cell(text: "the sole constructor's parameter and its assignment"),
        ]),
        row(cells: [
          cell(text: ""),
          cell(text: "`both_read_unequal(left: …, right: …)` inside `accelerator_known_parts_differ` — the one place the **value** is compared"),
        ]),
        row(cells: [
          cell(text: "`test.claim.spark.serving_performance_subject_witness::fx_cited`"),
          cell(text: "fixtures"),
        ]),
        row(cells: [
          cell(text: "`test.claim.spark.serving_performance_subject_witness::w_applied_power_limit_is_an_accelerator_axis`"),
          cell(text: "`w_applied_power_limit_is_an_accelerator_axis`"),
        ]),
      ]
    },
    p(text: "There is no non-test caller of `serving_accelerator_realization` on main: no benchmark path, no readback, no fold. The field is exercised only by its own witness."),
    p(text: "And that witness is where the ambiguity becomes concrete rather than theoretical:"),
    CodeBlock { code: "fn fx_cited(sku: GpuModelCatalogRow, watts: Nat, lanes: Int) -> … {\n    applied_power_limit: Present { value: watt(count: watts) },   // gunbc.spark.serving_performance_subject::ServingAcceleratorRealization.applied_power_limit\n}\n… fx_cited(sku: nvidia_rtx_pro_6000_workstation_catalog, watts: 600, lanes: 16)   // test.claim.spark.serving_performance_subject_witness::w_workstation_and_server_pro6000_are_different_accelerator_subjects" },
    p(text: "The row passed in has `tdp_watts: watt(count: 600)`; the applied limit supplied beside it is `watt(count: 600)`. They agree **by coincidence of typing, not by any rule** — and if that coincidence were load-bearing, `w_applied_power_limit_is_an_accelerator_axis` (which compares 600 against 400 on the same SKU) could not tell them apart from a TDP change. That is how a coincidence gets written into a test as though it were a relation."),
    h3(text: "(3) The home question cannot currently be answered at all"),
    p(text: "`extdeps/nvidia/management_library.dag` — the NVML module: the witness reads it in full and is red if a power reading appears in it in any case. It carries `DeviceMemoryObservation` and memory observations; that no power channel exists is what that claim costs, and it is read there rather than asserted here. There is no way to *read* what limit a card is running under, which is the question \"home serving\" actually asks: not \"what may this card draw\" but \"what is it drawing, in a room, on a desk\"."),
    h2(text: "Why this cannot be resolved by picking a number"),
    p(text: "The other three P4 inputs are ordinary product decisions. **Cards**: NVIDIA publishes both lists, P1's rows are cited, and the frontier's lists already partition them — any defensible default (the four current add-in rows) is safe to type. **Power rungs**: a sweep list of `Watt` values, safe to type. **The meaning of the watt figure** is the one input that determines **which type the whole selection is written in** — pick wrong and P4 ships a fold that multiplies two things that were never independent dimensions, and every receipt under it inherits the confusion."),
    p(text: "DESIGN §3d is directly about this and is stronger than a style preference:"),
    quote(blocks: [
        p(text: "\"A candidate violating a hard constraint is **excluded *before* Pareto, never ranked**.\" \"The result is scoped, never `Optimal`: `SelectedWithin` binds a `SelectionReceipt`… A change to any of those is a **different decision**, so a stale choice is detectable.\" — `DESIGN` §3d (Selection precedes convergence) (§3d)"),
    ]),
    p(text: "If the watt figure is a hard constraint (a card may not be asked to exceed its cited ceiling), it must exclude before Pareto. If it is an objective axis, it is ranked. Those are different positions in the fold, and the same `Watt` value cannot be both without saying which. §3d also settles the vocabulary: `std.pareto` computes the frontier and `std.decision` chooses, and P4 must **consume** them — \"a second decision algebra is the §3 fork.\" The real types to inhabit are `RealizationSelectionResult` with `SelectedWithin { candidate, receipt }` and `SelectionNeedsEvidence { needs }` (`std.decision::RealizationSelectionResult`), over `ParetoEntry { identity, display_label, readings, missing_inputs }` and `SelectionAxis { identity, goal }` (`std.pareto::SelectionAxis`) — not a minted parallel."),
    h2(text: "Options"),
    p(text: "**A. The watt figure is the catalog TDP only.** Selection sweeps `tdp_watts`; P2's `applied_power_limit` is scaffolding P4 does not consume. *Against*: the axis becomes meaningless. The catalog already carries TDP on the row, so \"× power limits\" would re-declare a field that is already there, and the only interesting home question — running a 600 W card at 400 W — is inexpressible."),
    p(text: "**B. The watt figure is the applied limit, read as a property of the run.** *For*: matches P2's construction — `applied_power_limit` sits on the realization beside `count` and `host_link`, all run-scoped, all optional. *Against, and fatal as stated*: there is no source for it. No NVML power field, no committed receipt that carries one, and P3's own layering rule requires that an applied limit be **cited to something** before selection consumes it. Selecting on it now means selecting on a number that otherwise appears only in a run name — §4d: *\"Do not assert as deduced what is only inferred. An inference is a bet: typed as a bet, neither deleted nor promoted.\"*"),
    p(text: "**C. Both, kept distinct and related by an explicit rule.** The axis is one value per candidate carrying both facts without conflating them:"),
    CodeBlock { code: "type AppliedPowerLimit                          // makes 'a watt with no provenance' unwritable\n  = AppliedLimitUnread\n  | AppliedLimitGrounded { limit: Watt, standing: CitedFigureStanding }\n  // standing stays the SHARED coproduct: extdeps.external_authority::CitedFigureStanding rules CITED/UNCITED/OBSERVED\n  // \"ONE STANDING, not a per-domain coproduct\", so AppliedPowerLimit cannot narrow it to a\n  // per-domain subset; which arm an applied limit may take is a witness + review fact, not a type fact\n\ntype HomeServingPowerPolicy\n  = PowerPolicyUnread { missing: NonEmptyStr }   // neither known: refused, never defaulted\n  | PowerPolicyGrounded {\n      tdp_watts: Watt                            // cited ceiling; required for a candidate\n      tdp_standing: CitedFigureStanding          // which datasheet cites it\n      applied: AppliedPowerLimit\n    }" },
    p(text: "`AppliedPowerLimit` exists so the bad state is unwritable rather than validated: there is no constructor that takes a watt without also taking its standing. That is §5's preference — *\"Stronger than catching a wrong state is making it **unwritable — correctness by construction, not validation.**\"* (`DESIGN` §5 (Fail-closed)) — and it is the same move P2 made with `ServingSubjectAxisReading` (`AxisNotApplicable | AxisUnread | AxisRead`) rather than a pile of optional-presence matches."),
    p(text: "Both standing fields reuse `extdeps.external_authority`'s `CitedFigureStanding` (`extdeps.external_authority::CitedFigureStanding`) rather than minting a parallel provenance type. That coproduct already answers exactly what these fields ask, with three arms and no more:"),
    CodeBlock { code: "type CitedFigureStanding\n  = CitedToAuthority { authority: ExternalAuthority }   # NVIDIA said it (datasheet, kit config)\n  | TranscribedUncited { read_obligation: NonEmptyStr }  # someone said it; nobody cites it\n  | ObservedByReceipt { observed: ObservedReceipt }      # this repo measured it" },
    p(text: "Reusing it is the §2 requirement (\"net concepts must not grow by re-invention\"), and it buys three things for free: the standing algebra is the one P3 just exercised on the ninfer replay counter, so an applied limit read off NVML and a replay counter read off a log carry their epistemic weight the same way; `cited_figure_read_obligation` already returns `Absent` for both grounded arms and `Present` only for `TranscribedUncited`, so \"what must still be read\" is answered once; and a `TranscribedUncited` applied limit cannot silently act like a cited one, because it must carry its read obligation into any refusal it causes."),
    p(text: "Value-beside-standing is also how the catalog already does it, so this is not a new shape: `GpuModelCatalogRow` carries `tdp_watts: Watt?` (`extdeps.gpu.types::GpuModelCatalogRow.tdp_watts`) next to `figure_citations: List<FactCitation>`, and P1 pairs the CUDA count with `rtx_pro_6000_workstation_cuda_core_standing: CitedFigureStanding = CitedToAuthority { authority: rtx_pro_6000_workstation_datasheet_authority }` (`extdeps.gpu.nvidia::rtx_pro_6000_workstation_cuda_core_standing`). Candidate identity is likewise already solved and must be consumed, not reinvented: `gpu_catalog_row_eq` (`extdeps.gpu.types::gpu_catalog_row_eq`) fixes a row's identity as *cited vendor plus cited SKU name*, with the comment warning that *\"Package×VRAM×TDP is not enough\"*."),
    p(text: "Two consequences worth stating rather than discovering later. First, `ObservedByReceipt` is admission-gated: `fn observed_receipt` lists its `admit_callers` explicitly, so the first home-serving fold that claims an *observed* applied limit is itself an admitting change — a named file and a review, not a call. Second, keeping `tdp_standing` beside the number rather than assuming it is deliberate: a ceiling without its datasheet is not the same fact as a ceiling with it, and P1 already attached the datasheet citation to exactly these rows."),
    p(text: "**The seal is only a third of this coproduct, and C's headline claim needs that stated honestly.** `ObservedReceipt` is `sole_constructor` and `observed_receipt` is `admit_callers`-gated, but `CitedToAuthority` carries `ExternalAuthority`, which is a plain open record — `type ExternalAuthority { uri: Uri }`, no constructor function, no admission list. So any module that imports the coproduct can already mint `CitedToAuthority { authority: ExternalAuthority { uri:... } }` pointing at any string. What option C makes **unwritable is a watt carrying no standing**, not a watt carrying a standing that does not actually state its figure. The second failure is real and has form here: review 79389 on P1 caught exactly that — the Workstation CUDA-core count and a PCIe `x16` were sitting `CitedToAuthority` on `rtx_pro_6000_workstation_authority` (`extdeps.gpu.nvidia::rtx_pro_6000_workstation_authority`), whose locator is the *products* page `www.nvidia.com/en-us/products/workstations/professional-desktop-gpus/rtx-pro-6000/`, which does not state either figure. The fix added `rtx_pro_6000_workstation_datasheet_authority` with the real PDF (`.../workstation-datasheet-blackwell-rtx-pro6000-x-nvidia-us-3519208-web.pdf`) and re-pointed the standing and both citations at it; it landed in P1's squash `de0fedf0005`."),
    p(text: "So the guarantee on the cited arm is a *reviewable named declaration plus the human check*, not a type-level bar — which is also why the standing must be a named `data` row that a witness can pin, never an inline `CitedToAuthority` written at the use site. Two guards follow, and both are cheap: a witness pins each power standing's `authority.uri.locator` to the exact string (a citation cannot drift to a friendlier page unnoticed, which is how 79389 got in), and the applied-limit arm, if the operator chooses C with an observed reading, goes through the *sealed* arm rather than the open one — which is why `AppliedLimitGrounded` should not offer `CitedToAuthority` as the cheap default for a number this repository measured itself. `gunbc.recurring_failure_mode` `citation_verified_against_a_rendering_that_destroyed_its_scope` already rosters the adjacent class."),
    p(text: "with the relation stated as a rule instead of implied by a shared type: `applied_limit ≤ tdp_watts`, refused loudly when violated, and `PowerPolicyUnread` refused at the fold — §5: *\"A wrong answer is a loud error, never a warning… no plausible output is fabricated\"* (`DESIGN` §5 (Fail-closed)). The same shape P1 chose for a missing lane count (`MachineShapeRefused { cause: CatalogExecutionLanesUnstated }`, `extdeps.gpu.machine_shape::gpu_shape_from_catalog`) and P3 chose for a missing capacity (`AxisGap`). The Max-Q / Workstation pair then stops being two unrelated SKUs and becomes one card at two cited ceilings, and sweeping a 600 W card at 400 W becomes expressible without pretending NVIDIA published a 400 W card."),
    p(text: "Why `tdp_watts` can be **required** in `PowerPolicyGrounded` while the catalog field is `Watt?`: the witness imports the catalog rows `extdeps.gpu.nvidia` declares and the frontier's two typed lists (`gunbc.serving.home_serving_accelerator_field::home_serving_add_in_card_catalog_rows` and `gunbc.serving.home_serving_accelerator_field::home_serving_reference_sxm_catalog_rows`), and is red unless every candidate carries a cited ceiling, every row whose ceiling is absent is a reference row, and the census's own count of catalog rows in that module equals the number the witness imported. That is the check that makes the type well-formed on the data as it stands; the optionality that `Watt?` currently carries is not a gap in the candidate field; it is the reference rows travelling in a type they should not have to share. If a future candidate ever lacks a published ceiling, that is a `PowerPolicyUnread` refusal at the fold, not a silent `none`."),
    h2(text: "Recommendation"),
    p(text: "**C**, with the applied arm starting honestly at `AppliedLimitUnread`, and no constructor anywhere that accepts a watt without its `CitedFigureStanding` — so a limit cannot enter the fold without saying where it came from."),
    p(text: "One line each:"),
    ul(items: [
      li(text: "It is the only option true to what the tree actually holds: a cited ceiling we have, and an applied limit we do not have and cannot currently read."),
      li(text: "It makes \"× power limits\" add information instead of restating `tdp_watts`."),
      li(text: "It does not promote an inference to a fact in order to get the fold written (§4d), and keeps the two standings from collapsing into the shared `Watt` type that is the root of the ambiguity."),
      li(text: "It leaves A and B reachable as special cases: A is `applied: AppliedLimitUnread`, B is `applied: AppliedLimitGrounded { standing: ObservedByReceipt {…} }`. Choosing C now forecloses neither; choosing A or B now forecloses the other and re-types every receipt underneath it."),
      li(text: "The repo already made this call once, in the same vendor's own terms. `extdeps.systems.nvidia::extdeps_model_scope` carries the Spark's 140 W and refuses to let it leak across a type boundary: *\"the 140W figure is the WHOLE SoC's TDP, not the GPU alone or the CPU alone, so it is carried at the system row, **never misattributed onto the nested GPU catalog row's own `tdp_watts` field**.\"* Two power figures that look interchangeable and are not is exactly the case that comment was written for."),
    ]),
    p(text: "**What I need from the operator, as one decision**: confirm reading C, or overrule me with A or B. Cards and rungs are then mine to draft against the four cited add-in rows and the two SXM references, and I will bring the fold, not another list."),
    p(text: "**What I will not do without it**: build the fold, add a witness, or touch `home_serving_accelerator_field.dag`. P4's trigger is \"that fold exists and deleting either list makes it fail to resolve\" — a fold written on the wrong watt meaning would satisfy the trigger while failing the request. That is the failure mode §5 already names (*\"Fluent, type-checking, grep-passing output is exactly what looks finished without running\"*, `DESIGN` §5, \"Done means executed\") and which I watched happen on #13774: two witnesses dead on arrival from their first commit, across three SHAs and three approving reviews that were each individually correct and collectively no evidence. P4's own acceptance will therefore be a discriminating input that goes red when the power rule is inverted, not a green tick."),
    h2(text: "The shape P4 must end in, and the ceiling it discharges"),
    p(text: "snappy-wolf-791 handed me its P4 design note as input. I verified every claim in it against source at `a7724b72999` before letting any of it into this document; the four citation slips it contained (two `compiler_tests.rs` lines, `cited_figure_read_obligation`'s line, and a stale commit for this doc) are listed in Facts and none changed a conclusion. What survives verification is the shape P4 should take, and one finding that changes what P4 *is*."),
    p(text: "**One value binding four things**, so a rate can never be detached from the subject it was measured on — an admitted receipt identity, the `ServingPerformanceSubject`, the measured rate, and the final standing. It should reuse what exists rather than mint: the standing is `GpuBenchWarmStanding` (`gunbc.serving.gpu_bench_warm_standing::GpuBenchWarmStanding`), the subject is `ServingPerformanceSubject` (`gunbc.spark.serving_performance_subject::ServingPerformanceSubject`, `sole_constructor`), and the rate carrier already exists as `TokensPerSecond = Measure<Frequency, One, Nat>` (`std.measure::TokensPerSecond`, with `tokens_per_second`, `tokens_per_second_count`, and `MilliTokensPerSecond` on the same axis) — so a rate is not carried as a `Nat` and no new rate type is minted (§2). The precedent to imitate is one level down: `SubjectBoundCacheFit` (`gunbc.spark.serving_promotion::SubjectBoundCacheFit`), a small record whose only purpose is *\"a verdict that cannot be named without its subject key\"*, plus the `ServingPromotionEvidence` / `ServingPromotionReceipts` split, which exists so a caller can hand over receipts but cannot supply a verdict the wall computes itself — and `cache_bound_to_resolved_plan` re-checks the binding at use time rather than trusting it."),
    p(text: "**The finding that changes P4's framing: this is discharging a declared ceiling, not new scope.** `gunbc.recurring_failure_mode.benchmark_warm_capacity_violation_read_as_engine_performance` states its CEILING as *\"through the admitted receipt constructor, an observation with a proved capacity violation or other established warm-policy failure cannot become eligible warm-performance evidence\"*, and names its NEXT TRIGGER as *\"P4 selection consumes only `WarmValid` as a funded axis\"*. The machinery that CEILING clause names does not exist in the tree. `GpuBenchWarmStanding` is an **unsealed coproduct**. `WarmValid` appears outside its own module only ever as a match pattern or in prose: `git grep -n WarmValid dag` is the instrument, and the claim is a classification rather than a count — **every hit ends in `=>` (a pattern) or sits in prose, and not one is a value construction**. The module's minting functions carry no `admit_callers` either: `grep -c admit_callers dag/gunbc/serving/gpu_bench_warm_standing.dag` is zero. So nothing in the compiler today stops a P4 module from writing `WarmValid { working_set_tokens: …, measured_kv_tokens: … }` literally and pairing it with a subject it made up. The existing claims (`the_capacity_fit_becomes_evidence_only_when_the_counter_is_faced`, `a_replayed_prefix_refuses_what_an_unreplayed_one_funds`) prove the gate discriminates when the value arrives through those folds; they cannot say anything about a hand-typed arm. The witness comment at the comment above `test.claim.gpu_bench_warm_standing_witness` says the near-true thing from the other side — *\"`WarmValid` IS reachable, and only by carrying the reuse evidence into stage 3\"* — which is true of the folds and silent about the literal. (The failure-mode row itself is authored at `de0fedf0005`, `gunbai-bot[bot]`, 2026-10-14 — P1's squash. The gap belongs to nobody in particular, and naming it is not an accusation.)"),
    p(text: "Why the seal has to be a **record with one admitted mint**, not the coproduct arm: DAG coproduct arms are not sealed, and I read the enforcement rather than trusting the error text. `sole_constructor_construction_diags` (`v1.compiler.infer::sole_constructor_construction_diags`) calls `type_has_sole_constructor` and then compares `decl.span.clone.file.clone == span.file.clone`; the diagnostic reads *\"cannot be constructed outside its defining module\"* (`v1.std.core::diagnostic_to_message`), but the comparison is a **file path**, not a module path. Today that coincidence is harmless — the invariant is structural, not numerical: **zero** files under `dag/` lack a `^module` declaration and **exactly one** carries two `^module` regex hits, and that one (the row `annotation_authored_at_a_grain_the_model_does_not_carry`) is the phrase \"module item follows it\" inside a multi-line string literal, not a declaration — so one real module per file holds. (Stated as an invariant rather than a count, because the count moves with every merged PR: `git grep -L '^module ' origin/main -- 'dag/**/*.dag' | wc -l` → 0, and `git grep -c '^module ' origin/main -- 'dag/**/*.dag' | awk -F: '$NF>1'` → that one file. Re-derive both at whatever head you are on.) But a second module sharing a file would sit inside the first one's seal boundary. `admit_callers` is therefore not belt-and-braces: it gates by caller **declaration coordinates** (`constructor_admission_diags_from_lookup`, `v1.compiler.infer::constructor_admission_diags_from_lookup`, comparing `caller_decl_coords` against `admit_callers_entry_coords`), which is file-agnostic. Sealed record + single mint + `admit_callers` is the only version of \"bound\" that survives a future caller in a hurry, and it is exactly the `ObservedReceipt` pattern (`extdeps.external_authority::ObservedReceipt`) this repository already uses for receipts."),
    p(text: "**What self-admission actually costs, measured rather than assumed.** If C is chosen with an *observed* applied limit, P4's mint must be added to `observed_receipt`'s roster — the roster is the `admit_callers` list on `extdeps.external_authority::observed_receipt`, and how long it is today is read from that list rather than quoted here — which is a line in a module outside P4's own. The worry that this breaks the roster's own witness is **dispelled, not assumed away**: `dag/test/claim/admit_callers_roster_integrity_witness.dag` mentions `observed_receipt` or `external_authority` **nowhere** — every claim in it runs synthetic in-string sources through `violation_count`, so adding an entry to a real roster cannot move any of them. But read the shape of those claims before trusting them: they check entry *well-formedness* (`AdmitCallersEntryNotDeclRef`) and that listed/unlisted callers are admitted/refused on the synthetic source, never that a named entry in a real roster **corresponds to a caller that actually calls**. A vacuous entry — a `decl_ref` naming a declaration that never calls `observed_receipt` — passes every claim in that file. So the roster is guarded against the historical bug (an uninterpretable entry shrinking it) but not against accretion — and the witness's own preamble is explicit that it does not close that class: about the unresolvable-entry arm it says the diagnostic is *\"the receipt that this arm is unchanged, NOT a claim that the class is closed,\"* and that such an entry *\"is simply retained and can never match any caller's coordinates.\"* A dead roster entry is therefore representable by design, not by accident. P4's own witness should therefore pin its admitted mint by naming the exact `decl_ref(module_path:, decl_name:)` pair — the module is `gunbc.serving.home_serving_accelerator_field`, whose mint name is not yet decided — so the entry cannot quietly outlive the call it admits. That is a build-time note, not a decision item."),
    p(text: "One thing not to \"fix\" while building this shape: the committed receipt ends `WarmCapacityUnread` because `extdeps.ninfer.replayed_tokens_total` is `TranscribedUncited`, and `cited_figure_read_obligation` (`extdeps.external_authority::cited_figure_read_obligation`) returns `Present` only for `TranscribedUncited` — `Absent` for `CitedToAuthority` and `ObservedByReceipt`. The honest route to a `WarmValid` over that fixture is to make the counter *grounded*, not to soften the standing fold. And if that grounding is an observed reading, the fold must take no arguments and read committed in-corpus bytes, per `observed_receipt`'s admission requirement, with the honesty note at `extdeps.external_authority::ObservedReceipt` respected: a fold over transcribed bytes is a boundary transcription, so name the seam and its trigger rather than claiming the substrate checks it."),
    h2(text: "Facts, with where each was checked"),
    p(text: "Every line below was re-checked by command against `origin/main` `92ca5568ba6845dcb5d3a5d9e539b75d8574ec19` (the tip at audit time, 2026-10-19). Items carrying their own \"Verified at\" or \"Measured at\" SHA were first measured there; where that SHA's line numbers no longer match `92ca5568ba6`, both are given. Of the 26 files cited in this document, 21 are byte-identical (`git rev-parse` blob comparison) between `c4dc2576872` — the tip the document was written against — and `92ca5568ba6`; the five that moved are `dag/std/measure.dag`, `dag/extdeps/external_authority.dag`, and the Stage-0 compiler sources (`compiler_tests.rs`, `v1_compiler_infer.rs`, `v1_std_core.rs`), whose citations are updated below."),
    ol(items: [
      li(text: "`GpuModelCatalogRow.tdp_watts: Watt?` — `extdeps.gpu.types::GpuModelCatalogRow.tdp_watts`."),
      li(text: "`ServingAcceleratorRealization.applied_power_limit: Watt?` — `gunbc.spark.serving_performance_subject::ServingAcceleratorRealization.applied_power_limit`; the witness reads the field list out of the declaration AST (`v2.std.node_query::declared_field_list` over the census row), so the field set is what the type declares on each run, not what this document last remembered."),
      li(text: "No `applied ≤ tdp` rule exists. The witness reads it as an absence, not a count: it takes the declaration census and is red if any declaration in the tree mentions both `tdp_watts` and `applied_power_limit` in its own body."),
      li(text: "`applied_power_limit` appears only in its owning module and in its own witness — `git grep -n applied_power_limit dag` re-derives the site list, and the load-bearing fact is that **no non-test caller of `serving_accelerator_realization` exists on main**. Within the module, `gunbc.spark.serving_performance_subject::accelerator_axis_reading` reads presence only, `gunbc.spark.serving_performance_subject::serving_accelerator_realization_wire` renders through `to_string(watt_count(w: w))`, and `gunbc.spark.serving_performance_subject::accelerator_known_parts_differ` holds the sole value comparison (`both_read_unequal(left:, right:)`)."),
      li(text: "PRO 6000 Workstation vs Max-Q differ only in `model`, `tdp_watts` (the Workstation at 600 and Max-Q at 300), `figure_citations` — field-by-field diff of the two rows in `extdeps/gpu/nvidia.dag`."),
      li(text: "PRO 5000 48 GB vs 72 GB differ only in `model`, capacity, `figure_citations`; both `watt(count: 300)`."),
      li(text: "Candidate list contents and SXM reference list — `gunbc.serving.home_serving_accelerator_field` (`home_serving_add_in_card_catalog_rows`) and (`home_serving_reference_sxm_catalog_rows`)."),
      li(text: "`warm_ninfer_nvfp4_pro6000ws_600w.jsonl` = re-derive size with `wc -c` and record count with `grep -c '\"run\"'`, one fixed key set per record (`…completion_tokens, error, max_tokens, phase, prompt_tokens, round, run, schema, status, t_end, t_first, t_start…` (re-derive with `head -1 <fixture> | tr ',' '\\n'`)), none power-related. the count of the substring \"600\" (`grep -o \"600\" … | wc -l`) splits into exactly two classes — the run-name label, hit twice per record because the name carries `600` twice (`pro6000ws` and `600w`), and digit runs inside epoch timestamps (`t_start`, `t_end`, `t_first` float values) — and neither class is a measurement All three fixtures are on `main` — P3 (`a2d57236bf2`) has merged — under `fixtures/gpu_bench/pro6000ws_600w_v2/`."),
      li(text: "`auto.log` and `results_ninfer_nvfp4_pro6000ws_600w.txt` contain no `watt|power|tdp` match."),
      li(text: "`extdeps/nvidia/management_library.dag` contains no \"power\"; its observations are `DeviceMemoryObservation`."),
      li(text: "Neither home-serving list has a consumer beyond `w_purchase_candidates_are_add_in_cards_and_sxm_are_references` (`test.claim.home_serving_extdeps_facts_witness::w_purchase_candidates_are_add_in_cards_and_sxm_are_references`)."),
      li(text: "`std.decision` ships `RealizationSelectionResult` (`SelectedWithin` / `SelectionNeedsEvidence` / `SelectionNeedsPolicy` / …) at `std.decision::RealizationSelectionResult` and `SelectionReceipt { scope, pareto_survivors, policy_authority, selected_identity }`. `std.pareto` ships `SelectionAxis` and `ParetoEntry`."),
      li(text: "§3d hard-constraint and scoped-result quotes — `DESIGN` §3d (Selection precedes convergence). §5 loud-error — `DESIGN` §5 (Fail-closed). §5 \"Done means executed\" — `DESIGN` §5, \"Done means executed\". §4d symmetric-obligation bullets — `DESIGN` §4d (Epistemic humility)."),
      li(text: "The Spark 140 W non-misattribution precedent — `extdeps.systems.nvidia::extdeps_model_scope`, carried as `soc_thermal_design_power: watt(count: 140)`."),
      li(text: "`CitedFigureStanding` arms — `extdeps.external_authority::CitedFigureStanding`; `fn observed_receipt` is `admit_callers`-gated; `cited_figure_read_obligation` returns `Absent` for `CitedToAuthority` and `ObservedByReceipt` and `Present` only for `TranscribedUncited`."),
      li(text: "Value-beside-standing is the existing catalog convention — `GpuModelCatalogRow.tdp_watts: Watt?` (`extdeps.gpu.types::GpuModelCatalogRow.tdp_watts`) beside `figure_citations: List<FactCitation>`; P1's `rtx_pro_6000_workstation_cuda_core_standing: CitedFigureStanding = CitedToAuthority {…}` at `extdeps.gpu.nvidia::rtx_pro_6000_workstation_cuda_core_standing`. Candidate identity is already fixed by `gpu_catalog_row_eq` (`extdeps.gpu.types::gpu_catalog_row_eq`)."),
      li(text: "Construction-over-validation — `DESIGN` §5 (Fail-closed): *\"Stronger than catching a wrong state is making it **unwritable — correctness by construction, not validation.**\"*"),
      li(text: "All three PRO 6000 rows (Workstation, Max-Q, Server) are `package: PcieAddInCard` in `extdeps/gpu/nvidia.dag`; the two SXM rows carry `tdp_watts: none` and are the reference-only rows."),
      li(text: "Rate carrier exists — `std.measure::TokensPerSecond` `TokensPerSecond = Measure<Frequency, One, Nat>`, `tokens_per_second`, `tokens_per_second_count`, `MilliTokensPerSecond` (their line numbers were already stale between two checks of this document, which is precisely why only the symbols are named)."),
      li(text: "Standing coproduct and its entry points — `gunbc.serving.gpu_bench_warm_standing::GpuBenchWarmStanding`; `gpu_bench_warm_run_admission`, `gpu_bench_warm_capacity_check`, `_from_capacity_ok`, `gpu_bench_warm_standing_after_replay`, `gpu_bench_warm_standing_with_ninfer_log`. `ServingPerformanceSubject` is `sole_constructor` at `gunbc.spark.serving_performance_subject::ServingPerformanceSubject`; `AxisNotApplicable | AxisUnread`."),
      li(text: "Subject-bound-verdict precedent — `SubjectBoundCacheFit { subject_key, allocation_plan, verdict }` at `gunbc.spark.serving_promotion::SubjectBoundCacheFit`; `ServingPromotionEvidence`; `ServingPromotionReceipts`; `promotion_evidence`; `serving_promotion_standing`; `cache_bound_to_resolved_plan`."),
      li(text: "Seal binds records, not arms — the Rust tests holding this seal are EMITTED by `v1.compiler.compiler_tests_rust::ct_sole_constructor_test`, `v1.compiler.compiler_tests_rust::ct_constructor_call_admission_test`, and `v1.compiler.compiler_tests_rust::ct_constructor_call_admission_function_value_test`. The third emits *\"an unlisted caller taking the sealed constructor as a FUNCTION VALUE must be refused\"* while the listed caller keeps that power, so admission survives the obvious workaround of passing the mint around as a value. The three Rust test names those fns emit are text inside an emitted string literal, so they are reached through their emitters and are NOT cited as declarations — a spelling that exists only inside a string literal has no census row, and citing one would assert a fact the tree does not hold. The module's own comment at `extdeps.external_authority::ObservedReceipt` says *\"a seal binds records, not coproduct arms\"*. Arms are constructed across module boundaries in the corpus today — `Present { value: … }` at `gunbc.ollama_runtime_bundle::ollama_runtime_materialization_identity_for_observed_release`, against the coproduct declared at `std.optional::Optional`. `git grep -F sole_constructor_violation_outside_module` re-derives where the emitted test sits on whatever head you are on, which is why no line number is given here."),
      li(text: "`WarmValid` outside its module (`git grep -n WarmValid dag`): every hit is a match arm — each one ends in `=>` — or prose, and none is a value construction. `GpuBenchWarmStanding` is not `sole_constructor`; `gpu_bench_warm_standing.dag` contains 0 `sole_constructor`/`admit_callers` hits. Measured against `origin/main` at the time of writing; re-derive it at any head with the commands in this item rather than trusting this sentence."),
      li(text: "Seal enforcement compares file paths, not module paths — `sole_constructor_construction_diags` at `v1.compiler.infer::sole_constructor_construction_diags` tests `decl.span.clone.file.clone == span.file.clone`, while the diagnostic text says \"defining module\" (`v1.std.core::diagnostic_to_message`). `admit_callers` instead gates by caller declaration coordinates — `constructor_admission_diags_from_lookup`, `v1.compiler.infer::constructor_admission_diags_from_lookup`, `caller_decl_coords` vs `admit_callers_entry_coords`. One module per file under `dag/` is a **structural invariant**, not a count: `git grep -L '^module ' origin/main -- 'dag/**/*.dag' | wc -l` names the files that lack one, and `git grep -c '^module ' origin/main -- 'dag/**/*.dag' | awk -F: '$NF>1'` names the files that carry more than one; both are run, and neither result is copied into this document. Raw file counts drift on almost every merge, so only the invariant is worth citing; re-derive a number with `git ls-tree -r --name-only origin/main -- dag | wc -l` if you need one. Repo-wide totals can also agree by coincidence: the one `src/` fixture with no declaration (`src/v1/stage0/tests/fixtures/fact_cardinality_split_brace.dag`) offsets that double-hit file."),
      li(text: "The warm-capacity failure-mode row — `dag/gunbc/recurring_failure_mode/benchmark_warm_capacity_violation_read_as_engine_performance.dag`, authored `de0fedf0005`, `gunbai-bot[bot]`, 2026-10-14 — states its CEILING as \"through the admitted receipt constructor …\" and its NEXT TRIGGER as \"P4 selection consumes only WarmValid as a funded axis\". (an earlier note had misplaced it in the `ExternalModelScope` comment block beneath it; `git grep -n \"fn cited_figure_read_obligation\" dag/extdeps/external_authority.dag` settles where it lives, which is why only the symbol is cited)"),
    ]),
    h2(text: "Outcome: what was decided, by whom, and what is still open"),
    p(text: "Written 2026-10-19. The base every citation was checked against is whatever `git rev-parse origin/main` answers when the claim runs — not a SHA frozen in this document — because the citation claim re-resolves each symbol below against the tree it executes on. A drift goes red; a transcribed base would rot."),
    p(text: p4_ruling_sentence()),
    p(text: p4_branch_sentence()),
    p(text: "The evidence is a differential, not a green run. The mutations below were applied one at a time to a scratch copy of the module and each copy run through `claim_batch --entry dag/test/claim/home_serving_power_policy_witness.dag`; there is no committed mutation harness to re-run, so re-deriving this means repeating those edits. The fold's claims were all accepted, and each of the following separate mutations of the module flipped at least one claim red — inverting the comparison, unsealing the type and dropping the roster, treating an uncited ceiling as a ground, deleting the roster, splitting the applied reading, and **merging the two figures into one number**, which is the conflation this whole document is about; that last one was caught by the conflation claim alone, with every other claim still green — which is why that claim is load-bearing rather than decorative. The control claims were all accepted, plus a kill-matrix whose two negative arms were each made to go red, including the positive control's own import made unresolvable — a case that stayed falsely green before review 82779 caught it."),
    p(text: p4_fleet_sentence()),
    ul(items: p4_trace_condition_rows()),
    p(text: "**Still open after this PR.**"),
    ol(items: [
      li(text: "The selection fold over `home_serving_add_in_card_catalog_rows` — its mint name, its roster entry, and its witness — remains undesigned here, and the note above about naming the exact `decl_ref` pair still applies to whoever builds it."),
      li(text: "A separate ledger row is open as PR #14472 (branch `p4-seal-wording-row`, one file, no behaviour change): the seal's diagnostic says *\"defining module\"* while `sole_constructor_construction_diags` compares file paths. Its rung is **latent**, established by executed refusals — the pre-write check `warm-wolf-570` asked for, run through `claim_batch` at base `891198514b8`, refused a second `module` header in one file (exit 1, `module index refused`) and refused two files declaring one module name (exit 101, `module-path collision`), with the probe shapes asserted before each run so neither green was accidental. So the wording cannot be exercised today; the trigger is a change that relaxes one of those refusals."),
      li(text: "The one-line reword of the seal diagnostic (\"module\" → \"file\") is **not** in either PR. It is deliberately left out of the row: the row's value is that it names a fork whose two readings are today held equal by enforcement, and rewording the sentence without also settling which boundary the seal means would open the module-boundary reading with nothing enforcing it. That belongs in the same change as the seal's own test, not in a ledger row."),
    ]),
    p(text: "Neither PR was merged by the author; the author is not merge-authorized."),
  ]
}

// ══════════════════════════════════════════════════════════════════════════════════════════
// THE STATUS HALF OF THE DECISION, TYPED (§4c: an event, a status, a count or a dissolution
// condition belongs in a carrier, not in prose). Three paragraphs here used to be narrative, and
// each was a snapshot that went false on its own schedule: the head of a branch under push, the
// merge state of a PR, and whether the operator had answered an ask. DESIGN §6 — "name the
// instrument, never transcribe its output" — is why the PR heads and merge states are NOT
// recorded here at all: they move under every push and every review, and a document that quoted
// `gh pr view` would be false by tomorrow. What IS recorded is what cannot drift silently, either
// because a claim re-reads the tree (the trace conditions, the unresolved module) or because the
// event is fixed in time (who asked, when, what closed it). The sentences the reader sees are
// RENDERED FROM these rows, the idiom `demand_restatement_follow_up` establishes: derived from the
// rows, never authored in the body, so prose and fact cannot diverge while the claim stays green.
// ══════════════════════════════════════════════════════════════════════════════════════════

type P4RulingRecord {
  ask_id: String
  asked_at: Timestamp
  // A duration, not a string. The close rule does arithmetic on this value, and "15 minutes"
  // as text could not be compared against anything; std.types.Duration is the named carrier
  // (Int seconds, range min 0) and the words the reader sees are rendered from it below.
  window_seconds: Duration
  decided_by: String
  recorded_by: String
  recorded_at: String
  standing_words: String
  license: String
  overturn: String
}

data p4_ruling_record: P4RulingRecord = P4RulingRecord {
  ask_id: "msg_2b573b87",
  asked_at: "2026-10-19T11:46:45Z" as Timestamp,
  window_seconds: 900,
  decided_by: "the close rule, not the operator",
  recorded_by: "manager stern-bat-401",
  recorded_at: "2026-10-19T12:01:35Z" as Timestamp,
  standing_words: "by default, not by endorsement",
  license: "the shape, not a number",
  overturn: "an operator answer naming A or B reopens it",
}

// Rendered FROM the Duration; the unit lives in the type, not in a stored string.
fn p4_window_words() -> String {
  join([to_string(p4_ruling_record.window_seconds / 60), " minutes"], "")
}

fn p4_ruling_sentence() -> String {
  join([
    "**The ruling was C, and it stands ", p4_ruling_record.standing_words, "** — decided by ",
    p4_ruling_record.decided_by, ". The escalation (ask `", p4_ruling_record.ask_id, "`, filed ",
    p4_ruling_record.asked_at, ", recommendation C) drew no operator answer within the ",
    p4_window_words(), ", so it closed with the recommendation approved; ",
    p4_ruling_record.recorded_by, " recorded it at ", p4_ruling_record.recorded_at, ". Read that as a default: it licenses ",
    p4_ruling_record.license, ", and ", p4_ruling_record.overturn, ". Nothing in the shipped model reads an operator ",
    "preference as a fact, and no mint, fold or witness branches on who decided this.",
  ], "")
}

type P4BranchRecord {
  // A PR number is a number, and this is the ONE place it lives: the instrument string is
  // derived from it (p4_pr_state_instrument), so the number can no longer disagree with itself.
  pr: Nat
  branch: NonEmptyStr
  model_files: String
  tree_invariant: String
  heal_artifact: String
}

data p4_branch_record: P4BranchRecord = P4BranchRecord {
  pr: 14463,
  branch: "p4-home-serving-power-policy" as NonEmptyStr,
  model_files: "`dag/gunbc/serving/home_serving_power_policy.dag` and its claim witness",
  tree_invariant: "the_citations_in_the_plan_resolve_against_the_declaration_census",
  heal_artifact: "`src/v1/stage0/src/std_decimal.rs`, auto-committed by the CI heal job as a re-emit of `fixed_point_trimmed_wire` — a generated function from `std.decimal` that this module never touches, after that artifact drifted on main independently of the branch",
}

// Derived from the typed PR number, so the number cannot appear twice and disagree with itself.
fn p4_pr_state_instrument() -> String {
  join(["gh pr view ", to_string(p4_branch_record.pr), " --json state,headRefOid"], "")
}

fn p4_branch_sentence() -> String {
  join([
    "**The C model is authored on a branch, not on the tree you are reading** (PR #"
    + to_string(p4_branch_record.pr) + "). It lives on `", p4_branch_record.branch as String, "` as ",
    p4_branch_record.model_files,
    ". Its merge state and head are deliberately ",
    "not transcribed — both move under every push, and a pushed branch is not a merged change; `",
    p4_pr_state_instrument(), "` answers that, today. What IS asserted about *this* tree is the negation, ",
    "and it is enforced by execution rather than by this sentence: `", p4_branch_record.tree_invariant,
    "` requires `gunbc.serving.home_serving_power_policy` to stay UNRESOLVED on the head the claim runs against, so if ",
    "this paragraph ever goes stale the claim goes red instead of the sentence rotting quietly. Everything the next ",
    "sections say about the mint, the roster and the refusal describes that branch and is NOT a claim about this tree. ",
    "One file GitHub lists there is not authored work: ", p4_branch_record.heal_artifact, ".",
  ], "")
}

// THE FLEET OBSERVATION. The operator answered the ask on 2026-10-20: no host carries a GPU yet, so
// cards and slots are empty as FACT, and P4 must refuse typed rather than select until a GPU-presence
// observation exists; software traces are the PREFERRED presence evidence, but RELIABILITY-CONDITIONAL,
// with three named conditions and an explicit instruction to model it as an observation, not a constant.
// So this row is an observation with a STANDING, and the standing is derived: `p4_trace_is_reliable`
// reads the fixture bytes on every run and only all-true conditions make it reliable. Today two are
// false, which is why presence is refused and nothing downstream may select a card.
type P4TraceCondition {
  name: String
  met: Bool
  what_it_would_show: String
  instrument: String
}

type P4FleetObservation {
  answered_at: Timestamp
  answered_via: String
  gpu_hosts: String
  cards: String
  slots: String
  preferred_evidence: String
  consequence: String
}

// FRESHNESS: a dated row is one that opens yyyy-mm-dd hh:mm:ss. Measured over the committed bytes by
// the claim, never quoted here.
data p4_trace_freshness: P4TraceCondition = P4TraceCondition {
  name: "freshness",
  met: true,
  what_it_would_show: "the trace was produced at a stated time rather than written down from memory, so it can be set against a run window",
  instrument: "filesystem_read(path: \"fixtures/gpu_bench/pro6000ws_600w_v2/auto.log\") — the claim counts rows opening with a date itself",
}

// PROVENANCE: unmet, and the reason is stated as a search the claim performs. No line in any gpu-bench
// fixture names the tool that wrote it; the tool is INFERRED from the column layout. An inference drawn
// from a header is not provenance, so this condition fails rather than being waived.
data p4_trace_provenance: P4TraceCondition = P4TraceCondition {
  name: "provenance",
  met: false,
  what_it_would_show: "a line that states which tool wrote the file. Today none does, in any of the three fixtures — the tool is inferred from the column layout, and an inference from a header is not provenance",
  instrument: "filesystem_read over all three fixtures/gpu_bench/pro6000ws_600w_v2 files — the claim searches every line for a tool naming itself",
}

// NEGATIVE CONTROL: unmet, and this is the condition the operator named specifically. Every committed
// fixture is a POSITIVE — each one names a device — so none of them can show that a host WITHOUT the
// card produces no trace. Without that half, a trace cannot distinguish "the GPU was there" from
// "someone wrote this file", which is exactly the reliability the operator asked me to show.
data p4_trace_negative_control: P4TraceCondition = P4TraceCondition {
  name: "negative control",
  met: false,
  what_it_would_show: "a committed fixture from a host with no GPU, showing that absence produces no trace. What the tree holds is the other half only: the two table traces print the device-name row and the receipt stream carries the run label on every line, and no fixture anywhere reports an absent device. So nothing in the corpus can distinguish a card that was present from a file that was written",
  instrument: "filesystem_read over all three fixtures/gpu_bench/pro6000ws_600w_v2 files — the claim asserts the device-name row is present in the two table traces (the positive floor, which is what makes the read non-vacuous) and that NO fixture carries an absent-device marker",
}

data p4_fleet_observation: P4FleetObservation = P4FleetObservation {
  answered_at: "2026-10-20" as Timestamp,
  answered_via: "the operator, relayed by manager stern-bat-401",
  gpu_hosts: "none — no host carries a GPU yet",
  cards: "empty as fact, not as a choice",
  slots: "empty as fact, not as a choice",
  preferred_evidence: "a software trace, once shown reliable",
  consequence: "card and power-limit selection stays a typed refusal; the candidate list stays empty",
}

fn p4_trace_conditions() -> List<P4TraceCondition> {
  [p4_trace_freshness, p4_trace_provenance, p4_trace_negative_control]
}

fn p4_trace_is_reliable() -> Bool {
  all(p4_trace_conditions(), c => c.met)
}

fn p4_presence_standing() -> String {
  if p4_trace_is_reliable() {
    "PRESENCE ESTABLISHED — a trace-backed observation may now feed selection"
  } else {
    "REFUSED — presence is not established, so no card and no limit may be selected"
  }
}

fn p4_unmet_condition_names() -> String {
  join(map(filter(p4_trace_conditions(), c => !c.met), c => c.name), ", ")
}

fn p4_fleet_sentence() -> String {
  join([
    "**Fleet facts, from ", p4_fleet_observation.answered_via, " on ", p4_fleet_observation.answered_at, ".** ",
    p4_fleet_observation.gpu_hosts, ": cards are ", p4_fleet_observation.cards, " and slots are ",
    p4_fleet_observation.slots, ", so the instruction is that P4 **refuses typed and never selects** until a ",
    "GPU-presence observation exists — no fleet is fabricated to make the question answerable. The preferred ",
    "presence evidence is ", p4_fleet_observation.preferred_evidence, ", and **the trace this repo holds does not yet ",
    "meet that bar**: the standing that follows is **", p4_presence_standing()
    + "**, and therefore ", p4_fleet_observation.consequence,
    ". Each condition below names the instrument that re-derives it and is re-read on every run by ",
    "`the_gpu_bench_trace_still_falls_short_of_reliable_presence_evidence`; unmet today: ",
    p4_unmet_condition_names(), ". The candidate ceilings themselves are re-derived, not quoted here: the witness ",
    "reads `gunbc.serving.home_serving_accelerator_field::home_serving_add_in_card_catalog_rows` and looks each row up ",
    "in `extdeps.gpu.nvidia`, so their identity comes from the tree on every run. Their STANDING is the finding that ",
    "made C the right call: every one of them is a `CitedToAuthority` figure about a product line, none is a reading of ",
    "a card in a chassis, and **a run's name is not a watt** — `600w` in a run name has no backing reading on either ",
    "carrier, and nothing here admits it.",
  ], "")
}

fn p4_met_word(c: P4TraceCondition) -> String {
  if c.met {
    "MET"
  } else {
    "NOT MET"
  }
}

fn p4_trace_condition_rows() -> List<MarkdownListItem> {
  map(p4_trace_conditions(), c => li(text: join([
    "**", c.name, "** — ", p4_met_word(c), ". It would show ",
    c.what_it_would_show, ". Instrument: ", c.instrument, ".",
  ], "")))
}

data p4_home_serving_power_semantics_plan: Plan = Plan {
  slug: "p4-home-serving-power-semantics",
  title: "P4 home-serving selection: what the watt figure means",
  body: p4_home_serving_power_semantics_body(),
  retirement: PlanRetiresWhen {
    condition: unbound_dissolution(description: "Dissolves when the home-serving card selection fold exists and consumes a `HomeServingPowerAdmission` — the catalog TDP and the applied limit carried as two distinct figures, with an applied limit above the rated power refused — so that the question this document settles (which of the two figures a recorded watt names) has a consumer in the tree rather than only an argument. THAT CONSUMER DOES NOT EXIST ON THIS HEAD. It is pending on the branch that `p4_branch_record` names, and it is NOT ON THIS HEAD — which is the one status claim this document is allowed to make, because a claim enforces it (`the_citations_in_the_plan_resolve_against_the_declaration_census` requires that module to stay unresolved on the head it runs against). Whether the branch has merged is deliberately not stated here; `git cat-file -e origin/main:dag/gunbc/serving/home_serving_power_policy.dag || echo absent` answers it against the tree — re-derive that with `git cat-file -e origin/main:dag/gunbc/serving/home_serving_power_policy.dag || echo absent`. The trigger is therefore keyed on that PR landing, which is tracked by its own merge request to the operator rather than being an untracked stall. Until it lands, this carrier states the decision and the option comparison that produced it, and claims nothing about that module being present."),
  },
  projection: PlanIsAuthorityOnly { ruling: project_documentation_projections_are_not_checkout_artifacts },
}
