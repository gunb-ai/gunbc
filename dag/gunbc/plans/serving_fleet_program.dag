module gunbc.plans.serving_fleet_program

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetiresWhen, PlanIsAuthorityOnly }
import std.markdown { MarkdownBlock, MarkdownListItem }
import gunbc.plans.md_helpers { h2, p, li, ul, quote }
import gunbc.design_ruling { project_documentation_projections_are_not_checkout_artifacts }

// The program is a list of typed rows; the markdown body is their projection. A row's
// identity, owner, standing and edges are fields, so a misspelled label or an unknown
// standing has no constructor, and a witness folds over the edges instead of parsing text
// (DESIGN section 4c: a status or citation belongs in a typed carrier, not in prose).
// Row prose names no other row: every relation between rows is `depends_on` (a completion
// prerequisite) or `related` (a cross-reference that is not one), so the declared graph
// is the whole graph.

type ServingFleetRowId
  = SfpA1 | SfpA2 | SfpA3
  | SfpB1
  | SfpC1 | SfpC2
  | SfpD1 | SfpD2 | SfpD3 | SfpD4 | SfpD5 | SfpD6 | SfpD7 | SfpD8
  | SfpE0 | SfpE1 | SfpE2 | SfpE3 | SfpE4
  | SfpF1

type ServingFleetSection = SfpSupply | SfpRouter | SfpMeasurement | SfpPolicy

// modeled: a declaration exists and a witness executes it. executed: a real run produced a
// receipt. deployed: a live unit serves traffic. unstarted: nothing exists.
type ServingFleetStanding = SfpModeled | SfpExecuted | SfpDeployed | SfpUnstarted

// An owner is a declared symbol that must resolve, or an explicit modeling obligation.
type ServingFleetOwner
  = SfpOwnedBy { symbol: String }
  | SfpUnowned { obligation: String }

type ServingFleetRow {
  id: ServingFleetRowId
  section: ServingFleetSection
  title: String
  owner: ServingFleetOwner
  summary: String
  standing: ServingFleetStanding
  standing_note: String
  pr: String
  done: String
  depends_on: List<ServingFleetRowId>
  related: List<ServingFleetRowId>
}

fn sfp_row_label(id: ServingFleetRowId) -> String {
  match id {
    SfpA1 => "A1"
    SfpA2 => "A2"
    SfpA3 => "A3"
    SfpB1 => "B1"
    SfpC1 => "C1"
    SfpC2 => "C2"
    SfpD1 => "D1"
    SfpD2 => "D2"
    SfpD3 => "D3"
    SfpD4 => "D4"
    SfpD5 => "D5"
    SfpD6 => "D6"
    SfpD7 => "D7"
    SfpD8 => "D8"
    SfpE0 => "E0"
    SfpE1 => "E1"
    SfpE2 => "E2"
    SfpE3 => "E3"
    SfpE4 => "E4"
    SfpF1 => "F1"
  }
}

fn sfp_row_ref(id: ServingFleetRowId) -> String {
  join(["Row ", sfp_row_label(id: id)], "")
}

fn sfp_section_key(s: ServingFleetSection) -> String {
  match s {
    SfpSupply => "supply"
    SfpRouter => "router"
    SfpMeasurement => "measurement"
    SfpPolicy => "policy"
  }
}

fn sfp_standing_text(s: ServingFleetStanding) -> String {
  match s {
    SfpModeled => "modeled"
    SfpExecuted => "executed"
    SfpDeployed => "deployed"
    SfpUnstarted => "unstarted"
  }
}

fn sfp_owner_text(o: ServingFleetOwner) -> String {
  match o {
    SfpOwnedBy { symbol } => join(["`", symbol, "`."], "")
    SfpUnowned { obligation } => join(["unowned; ", obligation], "")
  }
}

fn sfp_refs_text(ids: List<ServingFleetRowId>) -> String {
  if ids.length() == 0 { "nothing" } else { join(map(ids, i => sfp_row_ref(id: i)), ", ") }
}

fn sfp_related_text(ids: List<ServingFleetRowId>) -> String {
  if ids.length() == 0 { "" } else { join([" Related, not a prerequisite: ", sfp_refs_text(ids: ids), "."], "") }
}

fn sfp_standing_note_text(note: String) -> String {
  if note == "" { "." } else { join([", ", note, "."], "") }
}

fn serving_fleet_row_text(r: ServingFleetRow) -> String {
  join([
    "**", sfp_row_ref(id: r.id), " ", r.title, ".** Owner: ", sfp_owner_text(o: r.owner), " ", r.summary,
    " Standing: ", sfp_standing_text(s: r.standing), sfp_standing_note_text(note: r.standing_note),
    " PR: ", r.pr, ". Done: ", r.done, " Depends on: ", sfp_refs_text(ids: r.depends_on), ".",
    sfp_related_text(ids: r.related)
  ], "")
}

