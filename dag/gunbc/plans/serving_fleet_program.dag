fn sfp_section_items(s: ServingFleetSection) -> List<MarkdownListItem> {
  map(filter(serving_fleet_rows, r => sfp_section_key(s: r.section) == sfp_section_key(s: s)), r => li(text: serving_fleet_row_text(r: r)))
}

fn serving_fleet_program_body() -> List<MarkdownBlock> {
  [
    quote(blocks: [
      p(text: "**Status: umbrella index, awaiting review.** Operator goal, 2026-10-24: serve Qwen3.8 Flash Next, and smaller Qwen models, to dashboard agent sessions from ONE pool through a gunbc-native router, over three supply kinds. This plan is the index and the design spine. It restates no sub-plan: each row names the one module that owns its fact, or says it is unowned when that module does not exist yet, and says what done means, so the program can be tracked as rows close. The rows are typed records and this text is their projection. The buying material (prices, budgets, site power, accounts, endpoints, keys) is deliberately absent from this public repository."),
      p(text: "**Standing vocabulary.** modeled means a declaration exists and a witness executes it. executed means a real run produced a receipt. deployed means a live unit serves traffic. unstarted means nothing exists. No row below is deployed; the router has no live unit and no supply kind has served a session through it."),
    ]),

    h2(text: "1. Supply kinds"),
    ul(items: sfp_section_items(s: SfpSupply)),

    h2(text: "2. Router and lifecycle"),
    ul(items: sfp_section_items(s: SfpRouter)),

    h2(text: "3. Measurement"),
    ul(items: sfp_section_items(s: SfpMeasurement)),

    h2(text: "4. Routing policy across tiers"),
    ul(items: sfp_section_items(s: SfpPolicy)),

    h2(text: "5. Order of closure"),
    p(text: join([
      "The dependency edges form an acyclic graph, and the witness checks that they do. Rows with no dependency open the work: ",
      sfp_refs_text(ids: [SfpA3, SfpC2, SfpD2, SfpD6, SfpE0]),
      ". The milestone of section 6 is ", sfp_row_ref(id: SfpD8), ", reached through ", sfp_refs_text(ids: [SfpD3, SfpD1, SfpD7]),
      ", with ", sfp_refs_text(ids: [SfpC2, SfpC1]), " on the local supply side, and ", sfp_row_ref(id: SfpE3),
      " measuring the island once it converges. The rented path follows: ", sfp_refs_text(ids: [SfpD4, SfpD5, SfpA1, SfpE1]),
      ", with ", sfp_row_ref(id: SfpA2), " needing only its own Plan pass. ", sfp_row_ref(id: SfpE4),
      " comes before any selection trusts a throughput, and ", sfp_row_ref(id: SfpF1), " after it. ",
      sfp_refs_text(ids: [SfpB1, SfpE2]),
      " join through the same router once the card powers on. Each row is updated by its own PR, and this plan is retired when every row is closed or has moved to its owner's declarations."
    ], "")),

    h2(text: "6. Acceptance criteria: the first end-to-end milestone"),
    p(text: join([
      "**Milestone.** A request that carries the pool API key reaches a converged local upstream through the router and returns tokens. Local cards come first: the srv3 Strata replica of ",
      sfp_row_ref(id: SfpC1), ", then a srv1 vLLM upstream registered as in ", sfp_row_ref(id: SfpB1),
      "; rented flex supply follows. Supply is brought up and kept up by gunbc converge, never by a hand-run script."
    ], "")),
    p(text: "**Route.** A live probe through the deployed router: one streamed completion request with the pool key, answered with tokens by the local upstream, read beside the converge receipt for that upstream, whose readback shows it converged with no pending action. **Controls that must go red.** The same probe without the key, or with a revoked key, is refused at the authz callout and returns no tokens; the same probe with the upstream stopped returns a typed refusal, never a hang and never tokens from another source; and a converge pass with the upstream stopped reports an action, not a converged state."),
    ul(items: [
      li(text: join(["1. The local upstream is converged: ", sfp_row_ref(id: SfpC1), " for srv3, with the receipt of ", sfp_row_ref(id: SfpE3), " before selection trusts its throughput. Child PR: unstarted."], "")),
      li(text: join(["2. The streaming proxy is up: ", sfp_row_ref(id: SfpD2), ", PR 14938; deployed by ", sfp_row_ref(id: SfpD7), ", child PR unstarted."], "")),
      li(text: join(["3. The pool key is checked: ", sfp_row_ref(id: SfpD6), " through the callouts of ", sfp_row_ref(id: SfpD3), ", child PR unstarted."], "")),
      li(text: join(["4. The router contract the probe exercises: ", sfp_row_ref(id: SfpD1), ", PR 14929. The live request itself is ", sfp_row_ref(id: SfpD8), ", which closes this milestone."], "")),
      li(text: join(["Out of scope for this milestone: rented supply under ", sfp_refs_text(ids: [SfpA1, SfpA2, SfpD4, SfpD5]), "; the premium card under ", sfp_row_ref(id: SfpB1), ", while it does not power on; and the tier policy under ", sfp_row_ref(id: SfpF1), ". Each is closed by its own row's PR."], "")),
    ]),
  ]
}

data serving_fleet_program_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly { ruling: project_documentation_projections_are_not_checkout_artifacts },
  slug: "serving-fleet-program",
  title: "Serving-fleet program: rented, owned premium and owned cheap supply behind one native router",
  body: serving_fleet_program_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "Delete this plan when every deliverable row is deployed and observed, or has moved to the declarations and witnesses of the module that owns it.") },
}
