module gunbc.plans.serving_fleet_program

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetiresWhen, PlanIsAuthorityOnly }
import std.markdown { MarkdownBlock }
import gunbc.plans.md_helpers { h2, p, li, ul, quote }
import gunbc.design_ruling { project_documentation_projections_are_not_checkout_artifacts }

fn serving_fleet_program_body() -> List<MarkdownBlock> {
  [
    quote(blocks: [
      p(text: "**Status: umbrella index, awaiting review.** Operator goal, 2026-10-24: serve Qwen3.8 Flash Next, and smaller Qwen models, to dashboard agent sessions from ONE pool through a gunbc-native router, over three supply kinds. This plan is the index and the design spine. It restates no sub-plan: each row names the one module that owns its fact, or says it is unowned when that module does not exist yet, and says what done means, so the program can be tracked as rows close. The buying material (prices, budgets, site power, accounts, endpoints, keys) is deliberately absent from this public repository."),
      p(text: "**Standing vocabulary.** modeled means a declaration exists and a witness executes it. executed means a real run produced a receipt. deployed means a live unit serves traffic. unstarted means nothing exists. No row below is deployed; the router has no live unit and no supply kind has served a session through it."),
    ]),

    h2(text: "1. Supply kinds"),
    ul(items: [
      li(text: "**Row A1 Vast, rented and interruptible.** Owner: `gunbc.fleet.flex_pass_run::pass` (fleet-converge mode flex_pass), running the pass under `product.fabric.flex_vast_loop::flex_run_pass_caller_frontier`. Standing: executed in Plan mode, not deployed. Dispatched flex_pass runs on srv1 succeeded on 2026-10-19, and their receipts show complete instance and charge walks with an idle outcome. That fires trigger (1) of the caller frontier, whose text still says the pass has not executed. Selection is still unwired: the receipt reports needs-evidence under `product.fabric.flex_vast_loop::flex_select_supply_consumer_frontier`. PR: unstarted for the live leg. Live target: Apply on, a $50 spend cap, at most 2 cards. Done: live observation that one card was rented, enrolled, served a turn and was destroyed with the destroy independently read back, inside the cap. Depends on Row A3, Row D4 and Row D5."),
      li(text: "**Row A2 AWS EC2 spot g7e, rented and interruptible.** Owner: unowned on main; the owner is plan gunbc.plans.flex_supplier_generalization (PRs 14856 plan, 14862 shapes, 14866 serving image, 14879 supplier-agnostic carriers and destroy safety; owned by witty-lynx-354, cited only). The machine identity it extends is `product.fabric.flex_policy::FlexMachineKey`. Standing: modeled up to 14879; the boot path (3b) and the aws_cli plus Plan-mode supplier row (4b) are unstarted. Done: a Plan-mode pass against a real account observed green, and only then Apply, read back as in Row A1. Depends on Row A3."),
      li(text: "**Row A3 Pinned serving image and onstart, shared by rented and owned.** Owner: unowned on main; the owner is module product.fabric.flex_serving_image (PR 14866). The frontier it closes is `gunbc.serving.replica_endpoint_launch::replica_incarnation_unverified_obligation`, the declared frontier that the launched incarnation is not yet verified against the image. Standing: modeled in the PR. Done: the incarnation check executes and a launched replica proves it runs the pinned image, flags and weights. Depends on: nothing."),
      li(text: "**Row B1 Owned premium, RTX PRO 6000 on srv1.** Owner: `gunbc.serving.serving_enrollment::ServingRoute`; registered as a standing route, never through flex. Same image and onstart as Row A3. One card at TP1; a TP2 pair is a later purchase and not a row. Standing: modeled. PR: unstarted. Blocked: the card does not power on, a hardware fault that only the operator can act on. Done: live observation of a turn placed on the standing route and served by this card. Depends on Row A3, Row D1 and Row E2."),
      li(text: "**Row C1 Owned cheap tier, per-host islands.** Owner: unowned; the engine module it needs is Row C2. Flash Next IQ3_S through Strata, with CPU-computed experts, is unmeasured and stays Unobserved until Row E3 reads it; the stock-vLLM alternative serves Qwen3.6 35B-A3B or 27B. Islands are per host and never cross-host TP. The wire a compatible engine speaks already lives in `extdeps.llm.openai_compat_sse::openai_compat_sse_line_payload`. The return window on the cards ends 2026-11-24, which orders Row E3 ahead of the keep decision. Standing: unstarted. Done: a measured receipt for one engine on one island and a served turn through the router. Depends on Row C2, Row D1 and Row E3."),
      li(text: "**Row C2 Strata engine module.** Owner: unowned. The Strata engine has no extdeps module; one with its own scope under `extdeps.external_authority::ExternalModelScope` is a modeling obligation (DESIGN section 3), carrying the serving API as Strata documents it, and nothing is cited as Strata fact until it exists. Standing: unstarted. PR: unstarted. Done: the module exists and a witness reads its declared API; an adapter is written only if that API is not OpenAI-compatible. Depends on: nothing."),
    ]),

    h2(text: "2. Router and lifecycle"),
    ul(items: [
      li(text: "**Row D1 Router design.** Owner: unowned on main; the owner is plan gunbc.plans.fabric_serving_router (PR 14929, owned by proud-bear-756, cited only); the contract it realizes is `gunbc.serving.router_realization::router_capability_permission`. Standing: modeled, plan under review. Done: a witness drives the router contract over supplied requests, granting a permit and releasing the seat when the stream ends; the first live routed request is a separate integration row. Depends on Row D2 and Row D3."),
      li(text: "**Row D2 Streaming proxy scaffold.** Owner: unowned on main; the owner is plan gunbc.plans.fabric_serving_router S1 (PR 14938); the callouts it must reach are `gunbc.serving.serving_front_door::front_door_stream_end`. The hand-rendered configuration is operator-approved TRACKED debt that dissolves at the v2-native streaming door. Standing: executed as a scaffold, not deployed. Done: the falsifier cases of the router plan observed, and this row retires when the native door carries the bytes. Depends on: nothing."),
      li(text: "**Row D3 Authz and stream-end callouts.** Owner: `std.compiler_entry::CompilerEntryDriver` (the NativeServeDriver arm), as a separate srv1 unit beside the device-crypto sidecar. Standing: unstarted. PR: unstarted. Done: every RouterCapability arm exercised by a witness and the real callouts driven by the Row D2 harness. Depends on Row D6."),
      li(text: "**Row D4 Rent-to-enroll.** Owner: `gunbc.serving.rented_enrollment::rented_cohort_enrollments`, an empty hand list in production, to be replaced by applying `gunbc.serving.rented_allocation_host_enrollment::rented_allocation_host_enrollment` to each live allocation. Standing: modeled. PR: unstarted; sequenced after 14879. Done: a witness applies the enrollment to a supplied live allocation and the card becomes placeable with no hand edit; the live observation belongs to the rented integration, which depends on this row. Depends on Row A3."),
      li(text: "**Row D5 Reclaim and session re-placement.** Owner: `gunbc.serving.rented_release::rented_release_receipt` for drain, revoke, clean and destroy. Re-placement of a session whose card is reclaimed has no home today; it is a modeling obligation on the incarnation frontier of Row A3, and no generic replica-failover abstraction is introduced. Standing: release legs modeled with no driver; re-placement unstarted. Done: a reclaimed card is gone, read back, and the session's next turn is placed on a surviving card, both shown by a witness over a supplied allocation; the live observation belongs to the rented integration, which depends on this row. Depends on Row A3."),
      li(text: "**Row D6 Client API key.** Owner: `gunbc.serving.serving_key_grant::serving_key_request`. Standing: modeled. PR: unstarted for the callout check. Done: a request without a valid key is refused at the authz callout and one with it is served. Depends on: nothing."),
      li(text: "**Row D7 Live deploy leg.** Owner: `gunbc.live_deploy.apply_legs::DeployApplyPlan`, for the proxy and callout units, never a hand-written script. Standing: unstarted. Done: deployed units observed serving through the live deploy readback. Depends on Row D2 and Row D3."),
      li(text: "**Row D8 First live routed request.** Owner: unowned; this is the integration row for the milestone of section 6, not a module. Standing: unstarted. Done: the live probe and the controls of section 6 observed. Depends on Row C1, Row D1, Row D6 and Row D7."),
    ]),

    h2(text: "3. Measurement"),
    ul(items: [
      li(text: "**Row E0 Benchmark run receipt.** Owner: unowned. The facts the tiers need (KV capacity, knee, safe seats at 180k, open-loop agentic throughput, wall power and the power cap in force) belong to a whole run, not to one request, and no module carries them: `extdeps.gpu_bench.request_v2::gpu_bench_parse_jsonl` reads a per-request row, and `gunbc.serving.gpu_bench_warm_standing::GpuBenchWarmStanding` is eligibility for a warm reading, not a rate. A typed run receipt is a modeling obligation: one observation per run naming host, GPU, engine, quantization and topology, carrying those quantities, and built from the request rows it aggregates. Standing: unstarted. PR: unstarted. Done: a witness folds supplied request rows into a run receipt, and one inhabitance claim reads a real run. Depends on: nothing."),
      li(text: "**Row E1 Rented receipts.** Owner: unowned until Row E0 lands its carrier. A run receipt from a rented card, with results pulled off the box every 5 minutes. Standing: unstarted. Done: a receipt from a rented card read through the Row E0 carrier, with the pull cadence observed. Depends on Row E0 and Row A1."),
      li(text: "**Row E2 Owned premium receipts.** Owner: unowned until Row E0 lands its carrier. Run receipts for the PRO 6000, one per power cap at 300, 400, 500 and 600 W; the frontier they feed is `gunbc.serving.home_serving_accelerator_field::home_serving_accelerator_field_p4_frontier`. Blocked, like Row B1, while the card does not power on. Standing: unstarted. Done: one receipt per cap. Depends on Row E0 and Row A3."),
      li(text: "**Row E3 Cheap tier receipts.** Owner: unowned until Row E0 lands its carrier. A run receipt per engine on one island. Standing: unstarted. Done: a receipt for Strata and one for stock vLLM, which turns the Unobserved reading into a number. Depends on Row E0 and Row C2."),
      li(text: "**Row E4 Receipt to operating-point cost.** Owner: unowned. `product.fabric.serving_recipe::serving_unit_cost_for_selection` and `product.fabric.serving_recipe::serving_cost_per_million_tokens` refuse an unread unit cost, but the throughput they read is an operator reading on the recipe, not a run receipt. The ingestion that turns a Row E0 receipt into the candidate operating-point cost is a modeling obligation. That cost feeds offline fleet and capital selection, as `product.fleet_operating_point::fleet_operating_point_selection` does; runtime request routing is Row F1 and is a separate decision. Standing: unstarted. Done: a witness where a supplied receipt yields the unit cost that selection reads, and selection refuses a tier with no receipt. Depends on Row E0."),
    ]),

    h2(text: "4. Routing policy across tiers"),
    ul(items: [
      li(text: "**Row F1 Tier policy.** Owner: unowned. A session's KV is tied to its exact weights, so a tier switch happens only at a task boundary, and an escalation from the cheap tier to the premium tier carries a compact summary, not the transcript. The home is a consumer of the shared choice authorities `std.decision::select_realization` and `product.fabric.selection::select_supply`, following the precedent `product.fleet_operating_point::fleet_operating_point_selection`; the session identity it must respect is `gunbc.serving.session_store::ServingPrefixIdentity`. No module owns the boundary rule or the summary carrier today, so this is a modeling obligation, to land as a model before any router code reads it. Standing: unstarted. Done: a witness where a mid-task tier switch is refused, a task-boundary switch is selected, and the summary carrier is the only thing handed across. Depends on Row E4 and Row D1."),
    ]),

    h2(text: "5. Order of closure"),
    p(text: "The dependency edges form an acyclic graph, and the witness checks that they do. Rows with no dependency open the work: Row A3, Row C2, Row D2, Row D6 and Row E0. The milestone of section 6 is Row D8, reached through Row D3, Row D1 and Row D7, with Row C2, Row E3 and Row C1 on the local supply side. The rented path follows: Row D4, Row D5, Row A1 and Row E1, with Row A2 needing only its own Plan pass. Row E4 comes before any selection trusts a throughput, and Row F1 after it. Row B1 and Row E2 join through the same router once the card powers on. Each row is updated by its own PR, and this plan is retired when every row is closed or has moved to its owner's declarations."),

    h2(text: "6. Acceptance criteria: the first end-to-end milestone"),
    p(text: "**Milestone.** A request that carries the pool API key reaches a converged local upstream through the router and returns tokens. Local cards come first: the srv3 Strata replica of Row C1, then a srv1 vLLM upstream registered as in Row B1; rented flex supply follows. Supply is brought up and kept up by gunbc converge, never by a hand-run script."),
    p(text: "**Route.** A live probe through the deployed router: one streamed completion request with the pool key, answered with tokens by the local upstream, read beside the converge receipt for that upstream, whose readback shows it converged with no pending action. **Controls that must go red.** The same probe without the key, or with a revoked key, is refused at the authz callout and returns no tokens; the same probe with the upstream stopped returns a typed refusal, never a hang and never tokens from another source; and a converge pass with the upstream stopped reports an action, not a converged state."),
    ul(items: [
      li(text: "1. The local upstream is converged: Row C1 for srv3, with the receipt of Row E3 before selection trusts its throughput. Child PR: unstarted."),
      li(text: "2. The streaming proxy is up: Row D2, PR 14938; deployed by Row D7, child PR unstarted."),
      li(text: "3. The pool key is checked: Row D6 through the callouts of Row D3, child PR unstarted."),
      li(text: "4. The router contract the probe exercises: Row D1, PR 14929. The live request itself is Row D8, which closes this milestone."),
      li(text: "Out of scope for this milestone: rented supply under Row A1, Row A2, Row D4 and Row D5; the premium card under Row B1, while it does not power on; and the tier policy under Row F1. Each is closed by its own row's PR."),
    ]),
  ]
}

data serving_fleet_program_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly { ruling: project_documentation_projections_are_not_checkout_artifacts },
  slug: "serving-fleet-program",
  title: "Serving-fleet program: rented, owned premium and owned cheap supply behind one native router",
  body: serving_fleet_program_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "Delete this plan when every deliverable row is deployed and observed, or has moved to the declarations and witnesses of the module that owns it.") },
}
