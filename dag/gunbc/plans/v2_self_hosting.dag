module gunbc.plans.v2_self_hosting

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetirement, PlanRetiresWhen, PlanIsAuthorityOnly }
import std.markdown { MarkdownBlock }
import gunbc.plans.md_helpers { p }
import gunbc.design_ruling { project_documentation_projections_are_not_checkout_artifacts }

fn v2_self_hosting_body() -> List<MarkdownBlock> {
  [
    p(text: "Goal: .dag remains authority while emitted Rust replaces the bootstrap seed; first-class TypeScript follows the Rust fixed point (5-ts-first-class), deferred rather than dropped. This is the four-wave sequencer signed 2026-07-11, not a live status ledger. Current DESIGN/compiler architecture govern correctness; historical seed-equivalence receipts do not license preserving seed defects. Byte identity with seed was explicitly rejected 2026-07-08."),
    p(text: "The authored 27-module frontier and its classifier/probe were deleted 2026-08-17. Do not recreate its denominator or dispositions. Surviving authorities are emitter_producer_provenance, stage0_crate_layout, v2_emitter_direct_rust_door_contract and the later seed_retention_frontier. Drive real emission for refusals; deleted frontier_probe survey never produced execution evidence. Historical emit-surface dominance/current-module counts are not maintained standings."),
    p(text: "Wave1 foundation: #6558 body producer/#6526/#6523 witnesses proved real ingested bodies, not StageD MVP subsumption or FLAG E body_lowering_fold dissolution; #6523/#6538 naming/scaling did not prove final 03_name_resolve/03_resolve ingest wiring. #6575 closed FLAG D EnvironmentBindingKey identity with bind_eval_occurrence_identity_defect controls. #6578 self_host_logic_behavioral_transport proved emit→compile→run comparison for std.logic with inject-fault red. No v1 deletion in this wave; parallel work is within a dependency-gated wave, not across unpassed exits."),
    p(text: "Wave2: first real self-emitted, execution-qualified compiler modules replace corresponding v1 logic. Wave3: derive the remaining disposition through gunbc test //gunbc/instruments:self-host-frontier over observed stage0 .rs files. Exit requires emitted_unexecuted, reason_not_yet_declared and unbound_dissolution zero, with unclassified/stale_rows zero. Only unclassified/stale rows are instrument refusals; debt counts are reported below standard. Retained kernel rows need honest reasons/triggers, not a hand-counted fraction."),
    p(text: "Wave4: pipeline on emitted Rust, v1 compiler logic removed into the admitted pinned/content-addressed emitted bootstrap boundary, import grammar deleted and CI compile cone retired. No LOC target authorizes retained logic. TypeScript work opens afterwards, validated by actual target execution. Current replacement-cut sequencing outranks historical wave prose; src/v1 wholesale deletion is the terminal qualified cut."),
    p(text: "Import ladder is a separate timeline: B1/B2 #6462 reference-deps/equivalence enabled naming before syntax deletion; B3 migration ran alongside Waves2–3; B4 grammar deletion was terminal. Read current namespace_cut landing-order/stage authorities instead of treating this dated ladder as live instructions."),
    p(text: "Prerequisites retained: one std authority/de-fork (cross-tree wiring #5473), seed-only parallel representations and interpreter-kernel-D pure-eval/host boundary. Emit-on-demand is parallel, not a Wave1 blocker. Route-A cargo-green #5777/#5873, regen/drift #5873/#5639 are historical receipts, not current execution. Track A/B/T/Z, byte-oracle StageC and old active purity/precondition sequencing are retired; C linkage remains a second CompilationUnit realization that must not inherit Rust-only assumptions."),
  ]
}

data v2_self_hosting_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly { ruling: project_documentation_projections_are_not_checkout_artifacts },
  slug: "v2-self-hosting",
  title: "Plan — v2 self-hosting",
  body: v2_self_hosting_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "Delete this doc when Wave 4 lands: pipeline on emitted Rust, import grammar deleted, v1 collapsed to pinned kernel, CI compile cone gone. Absent v1 compiler logic is the authority at that point; this tracker is redundant. (The frontier carrier this condition used to name was deleted 2026-08-17 — it is not a retirement input any more.)")
  }
}
