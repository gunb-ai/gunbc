module gunbc.plans.solve_higher_order_design

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetirement, PlanRetiresWhen, PlanIsAuthorityOnly }
import std.markdown { MarkdownBlock }
import gunbc.plans.md_helpers { p }
import gunbc.design_ruling { project_documentation_projections_are_not_checkout_artifacts }

fn solve_higher_order_design_body() -> List<MarkdownBlock> {
  [
    p(text: "Ruling: solve is higher-order, never a substrate primitive. Structural solving already belongs to v2.std.constraints.ConstraintGraph/solve_constraints and ConstraintSatisfactionPredicate: finite candidate selection under structural equality. find_witness selects from a supplied finite CandidateSet; it neither generates iterative candidates nor evaluates numerical residuals. Extend those authorities for unification, resolution, affected-set closure and coercion; no parallel Residual/Constraint/solve vocabulary."),
    p(text: "Numerical solving remains absent. When a real consumer needs it, model three independent facts: (1) finite Loop measure plus std.termination.TerminationProof; (2) typed residual norm, units and acceptance/error bound; (3) an extdeps solver-method handler (Newton/LU/ODE/relaxation; LAPACK/ngspice/pure-dag realization). DescentEvidence is per-step evidence, not finite termination: a strictly decreasing real residual may never finish. An acceptance tolerance is grounded semantics, not a heuristic escape hatch."),
    p(text: "Encode cyclic equations as an acyclic residual function evaluated forward over a candidate, iterated by bounded Loop. Exhaustion without acceptance must return a typed, located refusal carrying iteration count and final residual. Never return best-so-far, clamp silently or substitute a default. Keep finite-bound proof separate from convergence acceptance."),
    p(text: "Language targets are shelved until after the Rust fixed point. SPICE/Verilog emission needs no compiler-internal numerical solver: emit netlist/RTL and run ngspice/verilator/iverilog through a HostTransportDescriptor/ProcessProgram extdeps row, with generic dispatch rather than a central switch. F6 numerical modeling is off that critical path and earns its cost only for a real in-substrate consumer."),
    p(text: "At un-shelving, attach structural rationale to existing constraint authority and the DESIGN anchor; model the numerical gap at its own consumer trigger, then retire this plan. A commentary String is not a substitute for the missing model; no new connective or behavior is required."),
  ]
}

data solve_higher_order_design_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly { ruling: project_documentation_projections_are_not_checkout_artifacts },
  slug: "solve-higher-order-design",
  title: "`solve` is higher-order, not a primitive — the standing rationale",
  body: solve_higher_order_design_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "This doc dissolves when the lane un-shelves: the **structural**-solve rationale migrates onto the existing `solve_constraints` / `ConstraintGraph` authority's typed doc-rows (`src/v2/std/constraints.dag`; `.dag` has no comment trivia — encode as `data … : String`) plus a DESIGN §4 anchor, and the **numerical**-solve gap is authored at its own trigger as the three orthogonal facts above (finite measure + `TerminationProof`, typed residual-acceptance contract, extdeps solver handler) — no parallel `Residual`/`Constraint` authority is minted. Until then, this is the single authority for the ruling.")
  }
}
