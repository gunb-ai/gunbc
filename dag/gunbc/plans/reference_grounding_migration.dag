module gunbc.plans.reference_grounding_migration

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetirement, PlanRetiresWhen, PlanIsAuthorityOnly }
import std.markdown { MarkdownBlock }
import gunbc.plans.md_helpers { p }
import gunbc.design_ruling { project_documentation_projections_are_not_checkout_artifacts }

fn reference_grounding_migration_body() -> List<MarkdownBlock> {
  [
    p(text: "Goal: replace opaque reference strings and repeated consumer parsing with walkable, single-authority edges. This is the carrier half of the post-#5943 grounding effort; v2.lens.grounding owns EXTRACT. DESIGN/domain carriers govern actual enforcement; the historical census is not a current guarantee."),
    p(text: "Partition by meaning: independent declaration→std.decl_ref.DeclarationRef, or QualifiedName when no selector is needed; locator→extdeps.uri.Uri; path→the existing path-literal/QualifiedName entry lane; closed discriminator→existing/earned coproduct (UriScheme, ReasoningEffort, Docker modes); derivable property→compute it, never store a copy; irreducible prose→keep. Reuse authorities before minting; per-field branded strings such as FieldName/ImportPath/TypeIdentity merely rename the same ungrounded edge."),
    p(text: "Role is different from reference: widget.id/record.owner/node.parent may describe the enclosing concept rather than name an independent entity. DeclarationRef is then wrong. EdgeLabel/FieldRef’s missing role/ownership relation must be earned from per-site adjudications, not a generic id/name/value/kind stop-list or threshold. Ledger rows record verdict, signal, decided-by and failure kind. Only accumulated necessity justifies an upstream role tag; do not guess its shape first."),
    p(text: "EXTRACT supplies candidate enclosing concept, field/type, resolved-qualified target, target structure and qualified enclosing name; layer/meta exclusions precede adjudication. Its historical folder-direction assumptions are not authority to restore the retired layering gate. Name coincidence is only a signal: closed-set provable cases can climb deterministically; meaning-dependent residual remains outside that ceiling, not RatchetForever. The detector finds, the ledger judges, the migration changes confirmed carriers. Preserve that separation and the detector’s regression role."),
    p(text: "Sequence: #5933 detector then #5943 unread-prose deletion; prove WallNow construction:String→ConstructionMechanism plus shared DeclarationRef (a real authority target checked by graph witness); migrate confirmed reference families one slice/fold at a time; Uri/UriScheme/closed-enum cases reuse their owners; accumulate role evidence in parallel before its carrier; route paths to the existing lane."),
    p(text: "Validate resolution/refusal through each actual consumer: dangling references must fail rather than silently become runtime misses. Grounding one field does not prevent the next bare string; the standing EXTRACT backstop and adjudication remain. No authored site list, new per-field brands, generic-name exclusions, thresholds or derivable-as-stored fields. Completion requires the declared retirement’s migrated references, earned role representation and empty unadjudicated EXTRACT population; recording a typed field alone is not that receipt."),
  ]
}

data reference_grounding_migration_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly { ruling: project_documentation_projections_are_not_checkout_artifacts },
  slug: "reference-grounding-migration",
  title: "Reference grounding -- migrate stringly-typed references to typed carriers",
  body: reference_grounding_migration_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "Delete this doc when the reference buckets are migrated and the property is witnessed rather than planned: every genuine-reference String field carries a typed reference (DeclarationRef / QualifiedName / Uri) or a closed enum, the role fields carry the EARNED EdgeLabel/FieldRef tag (justified by the adjudication ledger, not a guess), the WallNow construction field is a DeclarationRef, and v2.lens.grounding's EXTRACT pass returns empty over the corpus (no unadjudicated bare-String field coincides with a concept) -- at which point groundedness is a walked graph property, the grounding lens is the standing backstop for any regression, and this migration plan is redundant.")
  }
}
