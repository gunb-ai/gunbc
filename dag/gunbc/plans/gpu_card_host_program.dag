    home: GcOwnedElsewhere { owner: "gunbc.plans.serving_fleet_program::serving_fleet_program_plan", obligation: "host withdrawal and readmission through placement" },
    done: "a host can be withdrawn and readmitted, with both transitions observed.", needs: []),
  gc_row(id: GcN10, what: "The converge leg: observe, plan, apply, independent readback and typed refusals, including a drain or reboot required result and a later pass that reads the loaded driver back.",
    home: GcCreates { module: "gunbc.host.gpu_card_converge" },
    done: "the discriminating refusals in section 5.5 go red on the real path, and an undrained host is never rebooted.", needs: [GcN2a, GcN2b, GcN6, GcN8, GcN9, GcN14]),
  gc_row(id: GcN11, what: "Run the leg on each installed NVIDIA host, and remove the section-4 specimens.",
