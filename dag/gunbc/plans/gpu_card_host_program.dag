module gunbc.plans.gpu_card_host_program

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetiresWhen, PlanIsAuthorityOnly }
import std.markdown { MarkdownBlock, MarkdownTableRow, TableBlock, CodeBlock, AlignNone }
import gunbc.plans.md_helpers { h2, h3, p, li, ul, ol, cell, row }
import gunbc.design_ruling { project_documentation_projections_are_not_checkout_artifacts }
import std.optional { Present, Absent }
import std.nat { Nat }

// THE DESIGN CARRIER FOR "INSTALL A CARD, GET DRIVERS, POWER AND FANS RIGHT". DESIGN.md preamble: a plan's
// authority is its `.dag` carrier, so there is no docs/plans/*.md for it (`PlanIsAuthorityOnly`).
//
// Two conventions it holds itself to: every code reference names a module and symbol, never a
// file:line (DESIGN §3), and a measured figure is stated together with its standing -- measured,
// estimated, or read off a hand-written script -- because §4d forbids a bet being consumed as a fact.
// The figures in section 3 are RECEIPTS this repository took. None of them is an upstream fact, so none
// of them may land in extdeps.

fn t4(a: String, b: String, c: String, d: String) -> MarkdownTableRow {
  row(cells: [cell(text: a), cell(text: b), cell(text: c), cell(text: d)])
}

fn t3(a: String, b: String, c: String) -> MarkdownTableRow {
  row(cells: [cell(text: a), cell(text: b), cell(text: c)])
}

// THE BOUND IS ONE TYPED PREDICATE OVER A CENSUS (section 0). A card is in bound when it is installed
// in, or committed to, an operator-owned fleet host; every other card names why it is outside. The plan
// retires only when no committed row remains and every in-bound row has converged, so an incoming card
// keeps the program open rather than letting it retire around a no-op. These rows are the WORKING
// reading and are not the census authority: the census node creates gunbc.fleet.gpu_card_census, moves
// this predicate there, and this carrier then imports it rather than declaring it (delete-first).
type GpuCardBoundMembership
  = InstalledInFleetHost
  | CommittedToFleetHost
  | OutsideBound { because: String }

// An unconfirmed host is Absent, not a placeholder string: a placeholder satisfies a non-empty
// check while saying nothing, and D0 is what supplies the host. A row outside the bound carries its
// reason in OutsideBound, never in `host`.
//
// The parts of a reading are separate fields so a later node can join on them: how many cards, which
// product, and the slot each one occupies. `product` is still a name rather than a catalog reference:
// the A16 board and RTX 2000 Ada rows are on main, but the R9700 has no row, and joining a reading to
// its row is the census node's work. That node replaces the name with the catalog declaration and
// adds the GPU position within a board.
type GpuCardCensusReading {
  count: Nat?
  product: String
  slots: List<String>
  host: String?
  membership: GpuCardBoundMembership
}

fn gpu_card_in_bound(m: GpuCardBoundMembership) -> Bool {
  match m {
    InstalledInFleetHost => true
    CommittedToFleetHost => true
    OutsideBound { because: _ } => false
  }
}

data gpu_card_working_census: List<GpuCardCensusReading> = [
  GpuCardCensusReading { count: Present { value: 2 }, product: "NVIDIA A16", slots: ["SLOT2", "SLOT6"], host: Absent, membership: InstalledInFleetHost },
  GpuCardCensusReading { count: Present { value: 1 }, product: "NVIDIA RTX PRO 6000 Blackwell Workstation Edition", slots: [], host: Present { value: "srv1" }, membership: InstalledInFleetHost },
  GpuCardCensusReading { count: Present { value: 2 }, product: "NVIDIA RTX 2000 Ada Generation", slots: [], host: Absent, membership: InstalledInFleetHost },
  GpuCardCensusReading { count: Present { value: 2 }, product: "AMD Radeon AI PRO R9700", slots: [], host: Absent, membership: CommittedToFleetHost },
  GpuCardCensusReading { count: Present { value: 1 }, product: "NVIDIA RTX PRO 6000 Blackwell Max-Q", slots: [], host: Absent, membership: OutsideBound { because: "a rented Vast deployment on an x86 host the supplier owns, so this leg cannot converge its driver" } },
  GpuCardCensusReading { count: Present { value: 0 }, product: "NVIDIA A2", slots: [], host: Absent, membership: OutsideBound { because: "figures from external reports; no such card is in the fleet" } },
  GpuCardCensusReading { count: Present { value: 0 }, product: "NVIDIA T10", slots: [], host: Absent, membership: OutsideBound { because: "figures from external reports; no such card is in the fleet" } },
  GpuCardCensusReading { count: Absent, product: "NVIDIA GB10 (DGX Spark)", slots: [], host: Absent, membership: OutsideBound { because: "the driver ships with DGX OS on the Spark hosts and has its own program" } },
]

fn gc_membership_text(m: GpuCardBoundMembership) -> String {
  match m {
    InstalledInFleetHost => "in bound: installed"
    CommittedToFleetHost => "in bound: committed, not yet installed"
    OutsideBound { because } => join(["outside: ", because], "")
  }
}

fn gc_host_text(h: String?) -> String {
  match h {
    Present { value } => value
    Absent => "none recorded"
  }
}

fn gc_count_text(c: Nat?) -> String {
  match c {
    Present { value } => to_string(value)
    Absent => "unrecorded"
  }
}

fn gc_slots_text(slots: List<String>) -> String {
  if slots.length() == 0 { "unrecorded" } else { join(slots, ", ") }
}

fn gc_census_projection(r: GpuCardCensusReading) -> MarkdownTableRow {
  row(cells: [
    cell(text: gc_count_text(c: r.count)), cell(text: r.product), cell(text: gc_slots_text(slots: r.slots)),
    cell(text: gc_host_text(h: r.host)), cell(text: gc_membership_text(m: r.membership)),
  ])
}

// THE DEPENDENCY GRAPH IS TYPED ROWS; section 7's table is their projection. An id is a closed sum,
// so a misspelled node has no constructor. Each relation between nodes is a `needs` edge, and row
// prose names no node, so the declared graph is the whole graph. Each row has ONE home: an existing
// declaration it extends (which must resolve), the module it creates, an owner outside this program
// whose symbol must resolve, or the operator. A change that spans two homes is two rows.
type GpuCardNodeId
  = GcD0 | GcD1 | GcD2 | GcD3 | GcD4
  | GcN0a | GcN0b | GcN0c | GcN0d | GcN0e
  | GcN1 | GcN2a | GcN2b | GcN2c | GcN3a | GcN3b | GcN3c | GcN4a | GcN4b | GcN4c | GcN5 | GcN5b | GcN5c
  | GcN6a | GcN6b | GcN6c | GcN6d | GcN7 | GcN8 | GcN9 | GcN10 | GcN11
  | GcN12a | GcN12b | GcN12c | GcN12d | GcN12e
  | GcN13 | GcN14
  | GcGoal

type GpuCardNodeHome
  = GcExtends { symbol: String }
  | GcCreates { module: String }
  | GcOwnedElsewhere { owner: String, obligation: String }
  | GcOperatorDecides

type GpuCardNodeStanding = GcUnstarted | GcInReview { pr: String } | GcLanded { pr: String } | GcDecided

type GpuCardGraphRow {
  id: GpuCardNodeId
  what: String
  home: GpuCardNodeHome
  done: String
  needs: List<GpuCardNodeId>
  standing: GpuCardNodeStanding
}

fn gc_node_label(id: GpuCardNodeId) -> String {
  match id {
    GcD0 => "D0"
    GcD1 => "D1"
    GcD2 => "D2"
    GcD3 => "D3"
    GcD4 => "D4"
    GcN0a => "N0a"
    GcN0b => "N0b"
    GcN0c => "N0c"
    GcN0d => "N0d"
    GcN0e => "N0e"
    GcN1 => "N1"
    GcN2a => "N2a"
    GcN2b => "N2b"
    GcN2c => "N2c"
    GcN3a => "N3a"
    GcN3b => "N3b"
    GcN3c => "N3c"
    GcN4a => "N4a"
    GcN4b => "N4b"
    GcN4c => "N4c"
    GcN5 => "N5"
    GcN5b => "N5b"
    GcN5c => "N5c"
    GcN6a => "N6a"
    GcN6b => "N6b"
    GcN6c => "N6c"
    GcN6d => "N6d"
    GcN7 => "N7"
    GcN8 => "N8"
    GcN9 => "N9"
    GcN10 => "N10"
    GcN11 => "N11"
    GcN12a => "N12a"
    GcN12b => "N12b"
    GcN12c => "N12c"
    GcN12d => "N12d"
    GcN12e => "N12e"
    GcN13 => "N13"
    GcN14 => "N14"
    GcGoal => "G"
  }
}

fn gc_home_text(h: GpuCardNodeHome) -> String {
  match h {
    GcExtends { symbol } => join(["extends `", symbol, "`"], "")
    GcCreates { module } => join(["new `", module, "`"], "")
    GcOwnedElsewhere { owner, obligation } => join(["owned by `", owner, "`: ", obligation], "")
    GcOperatorDecides => "operator"
  }
}

fn gc_standing_text(s: GpuCardNodeStanding) -> String {
  match s {
    GcUnstarted => "unstarted"
    GcInReview { pr } => join(["in review, ", pr], "")
    GcLanded { pr } => join(["landed, ", pr], "")
    GcDecided => "decided"
  }
}

fn gc_needs_text(ids: List<GpuCardNodeId>) -> String {
  if ids.length() == 0 { "nothing" } else { join(map(ids, i => gc_node_label(id: i)), ", ") }
}

fn gc_row_projection(r: GpuCardGraphRow) -> MarkdownTableRow {
  row(cells: [
    cell(text: gc_node_label(id: r.id)),
    cell(text: join([r.what, " Done: ", r.done], "")),
    cell(text: gc_home_text(h: r.home)),
    cell(text: gc_needs_text(ids: r.needs)),
    cell(text: gc_standing_text(s: r.standing)),
  ])
}

fn gc_row(id: GpuCardNodeId, what: String, home: GpuCardNodeHome, done: String, needs: List<GpuCardNodeId>) -> GpuCardGraphRow {
  GpuCardGraphRow { id: id, what: what, home: home, done: done, needs: needs, standing: GcUnstarted }
}

fn gc_at(r: GpuCardGraphRow, standing: GpuCardNodeStanding) -> GpuCardGraphRow {
  GpuCardGraphRow { id: r.id, what: r.what, home: r.home, done: r.done, needs: r.needs, standing: standing }
}

fn gc_finished(s: GpuCardNodeStanding) -> Bool {
  match s {
    GcLanded { pr: _ } => true
    GcDecided => true
    GcUnstarted => false
    GcInReview { pr: _ } => false
  }
}

// A node can start when it is unstarted and every node it needs has landed or been decided. The list
// in section 7 is this fold, so it cannot drift from the rows.
fn gc_ready_labels(rows: List<GpuCardGraphRow>) -> String {
  let ready = filter(rows, r => match r.standing { GcUnstarted => true  _ => false }
    && all(r.needs, n => any(rows, q => gc_node_label(id: q.id) == gc_node_label(id: n) && gc_finished(s: q.standing))))
  join(map(ready, r => gc_node_label(id: r.id)), ", ")
}

