    home: GcCreates { module: "extdeps.amd.amd_smi" },
    done: "each operation parses a captured output and refuses an unsupported one, in a witness.", needs: []),
  gc_row(id: GcN12d, what: "The R9700 catalog row, with every figure cited.",
    home: GcCreates { module: "extdeps.gpu.amd" },
