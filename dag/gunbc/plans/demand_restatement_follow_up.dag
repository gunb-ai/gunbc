module gunbc.plans.demand_restatement_follow_up

import std.types { NonEmptyStr, List, String }

// THE ROWS D13 CUT (c) DID NOT MEASURE, named rather than counted away.
//
// Cut (c) deletes an authored `uses` row when the function's DERIVED service demand is nonempty,
// measured by resolving the module and reading `ItemInfo.service_names`. The census that types a
// row is a resolve of its module, and the population is not static while the cut is in flight:
// main gained new `uses` rows between the census and the merge, and each merge of main brought
// more. The rows below arrived that way, AFTER the measured population was fixed, and they are
// carried here instead of being deleted on the assumption that they would have typed the same way.
//
// DELETING THEM UNMEASURED WOULD BE THE FAIL-OPEN THIS CUT EXISTS TO AVOID: a row whose derived
// demand is empty is exactly the row whose deletion flips its function from effectful to pure, and
// the only thing that distinguishes the two is the measurement. Nine of the twenty-one sit in one
// module (`gunbc.machine_intake_mtcollins1_boot_run`), so a single unmeasured deletion there would
// be nine silent flips, not one.
//
// THE NEXT CUT TAKES THEM: re-resolve these five modules, apply the same criterion, and delete the
// rows whose derived demand is nonempty. Nothing about the criterion changes -- only the population
// is new.

data demand_restatement_follow_up_commit_range: NonEmptyStr =
  "5ff323b6d29..374d0ce4cdd" as NonEmptyStr

// Each entry carries its own row count, so the population's size is derived from the roster rather
// than restated beside it. Twenty-one rows in total; nine sit in one module, which is why an
// unmeasured deletion here would be nine silent flips rather than one.
data demand_restatement_follow_up_modules: List<String> = [
  "gunbc.machine_intake_mtcollins1_boot_run (9 rows)",
  "gunbc.auth.approval_keyring_converge (5 rows)",
  "gunbc.review_sheet_batch_actuator (4 rows)",
  "gunbc.authorization_claim_slot (2 rows)",
  "gunbc.machine_intake_megarac_media_attach (1 row)",
]
