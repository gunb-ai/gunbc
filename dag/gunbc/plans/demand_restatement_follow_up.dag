module gunbc.plans.demand_restatement_follow_up

import std.types { NonEmptyStr, List, String }

// THE COMMIT RANGE OVER WHICH THESE ROWS ARRIVED. Cut (c) deletes an authored `uses` row when the
// function's DERIVED service demand is nonempty, measured by resolving the module and reading
// `ItemInfo.service_names`. The census that types a row is a resolve of its module, and the
// population is not static while the cut is in flight: main gained rows between the census and the
// merge, and every merge of main brought more. The rows rostered below arrived that way, AFTER the
// measured population was fixed.

data demand_restatement_follow_up_commit_range: NonEmptyStr = "5ff323b6d29..a35c7cede3e" as NonEmptyStr

// THE ROSTER, carried rather than deleted on the assumption that these rows would have typed the
// same way. Deleting them unmeasured is the fail-open the cut exists to avoid: a row whose derived
// demand is EMPTY is exactly the row whose deletion flips its function from effectful to pure, and
// the only thing that distinguishes the two is the measurement. The first module carries most of
// them, so one unmeasured sweep there would be several silent flips rather than one. THE NEXT CUT
// TAKES THEM: re-resolve these modules, apply the same criterion, delete the rows whose derived
// demand is nonempty. The criterion does not change -- only the population is new.

data demand_restatement_follow_up_modules: List<String> = [
  "gunbc.machine_intake_mtcollins1_boot_run",
  "gunbc.auth.approval_keyring_converge",
  "gunbc.review_sheet_batch_actuator",
  "test.probe.review_sheet_tab_forged_probe",
  "gunbc.authorization_claim_slot",
  "gunbc.machine_intake_megarac_media_attach",
  "gunbc.review_sheet_tab_locator",
]

// THE MODULE PATHS, for a consumer that renders the roster as prose. The roster is module paths and
// nothing else: a per-module row COUNT would have no reader here -- nothing in this corpus renders a
// number into markdown -- and an unread field is the dangling declaration DESIGN 3c refuses. The
// next cut re-resolves each module to type its rows anyway, so it measures the counts itself rather
// than trusting a number carried from an earlier head.

fn demand_restatement_follow_up_module_paths() -> List<String> {
  demand_restatement_follow_up_modules
}

// THE ROWS THE CRITERION CANNOT TYPE AT ALL, kept by cut (c) and distinct from the roster above:
// those arrived after the census, these were IN it and came back untypeable. A `uses` row is
// deletable when its function's DERIVED service demand is nonempty, and derived demand comes from
// the module's registry entry -- so a module that does not resolve has no entry, and its rows have
// nothing to compare against. Deleting on a refusal is deleting on ignorance, which is why they
// stand. The two modules below refuse at PRE-EXISTING type errors this cut did not introduce and
// does not repair (`gunbc.auth.patterns` at its own line 60, expected String got Secret). Note the
// rows are ordinary `fn`s, NOT pattern declarations -- the reason they survive is the module, not
// the declaration kind. TRIGGER: when a module here resolves, the criterion types its rows and the
// next cut takes them by the same rule as every other row.

data demand_restatement_untypeable_by_refusing_module: List<String> = [
  "gunbc.auth.patterns",
  "gunbc.assimilate.bmc_bootstrap_provision",
]

// THE PATTERN-DECLARATION ROWS, the other half of what cut (c) kept. `pattern` declarations are not
// in the function registry, so the criterion does not range over them at all -- this is a scope
// boundary rather than a measurement that came back empty. TRIGGER: derived demand covers pattern
// declarations, or the rows are dispositioned under whatever authority owns patterns.

data demand_restatement_untypeable_by_declaration_kind: List<String> = [
  "gunbc.auth.credentials",
  "gunbc.tailscale_acl_phase2_credential",
]

// THE MODULES THE CRITERION COULD NOT TYPE, for the same prose consumer as the roster.

fn demand_restatement_untypeable_module_paths() -> List<String> {
  concat(demand_restatement_untypeable_by_refusing_module, demand_restatement_untypeable_by_declaration_kind)
}

