module gunbc.plans.closure_consolidation

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetiresWhen, PlanIsAuthorityOnly }
import std.markdown { MarkdownBlock, TableBlock, AlignNone }
import gunbc.markdown_helpers { h2, h3, p, li, ul, quote, cell, row }

fn closure_consolidation_body() -> List<MarkdownBlock> {
  [
    quote(blocks: [
      p(text: "**Goal (pinned, operator 2026-11-10):** a consumer reaches only the domain declarations and host authorities it actually needs. CI composition does not own domain behavior; the artifact registry does not duplicate producer dispatch; runtime demand does not depend on incidental whole-corpus loading. The original monolithic paths and their obsolete helpers have been removed."),
      p(text: "**Operator direction (2026-11-10, session bold-otter-603):** consolidate by responsibility, then eliminate unnecessary work. Dissolve `gunbc.ci.ci_spec` rather than rename it; make single-artifact generation selective by construction; keep the compiler demand-closure work under one authority. This plan is the authority; PR descriptions cite it and do not restate it."),
    ]),
    h2(text: "1. Displaced cost"),
    ul(items: [
      li(text: "**One CI fact costs the fleet.** `gunbc.ci.ci_spec` (4,697 lines, 77 imports, 401 declarations) is imported by 47 modules for 175 distinct names, none used by more than four. About 125 of those names are fleet-converge mode commands, and each imports the module it runs, so a consumer that wants a release-archive name or a one-line event clause acquires spark, R2, hardware intake, live deploy and host control. The required gate reaches it through two small imports (`gunbc.heal_workflow` `heal_same_repository_clause`, `gunbc.fleet.fleet_workflow_steps` `ci_cache_cargo_step_under`)."),
      li(text: "**One artifact costs every generator.** `gunbc.generated_artifact_emit` imports every producer, so `gunbc.instruments.generated_artifact_gate` `main_wet_one` for a single path acquires the whole generator population. Measured before #16156: about 26 to 29 minutes and 18 GB per workflow; after it, about 14 minutes up to resolve. A defect anywhere in that population stops every regeneration: on 2026-11-10 a ledger row (`gunbc.rung_drop.gunbc_run_unreached_declarations_not_realized`) and `gunbc.tools.review` each did."),
      li(text: "**Two spellings of one relation.** `gunbc.generated_artifact` `artifact_producer` names each artifact's producer, and `gunbc.generated_artifact_emit` `artifact_generate_unadorned` dispatches to producers separately; nothing proves they agree."),
    ]),
    h2(text: "2. Three problems, three homes"),
    p(text: "These are related and are not solved by one new abstraction that owns all three."),
    ul(items: [
      li(text: "**Domain authority versus CI adaptation versus composition.** What an operation is (its entry, credentials and receipt contract) is owned by its domain; how it becomes a workflow step is CI adaptation; which operations a workflow enrolls is composition. A CI adapter consumes a domain authority without importing unrelated operations. `gunbc.ci.ci_gate` already separates gate types and receipt semantics from execution and stays that way."),
      li(text: "**Artifact enrollment versus implementation.** The registry identifies the artifact and its producer; selecting a producer happens before any other producer is loaded."),
      li(text: "**Demand versus closure.** The import graph, the full dependency relation (dotted and bare references: `required_regen_host` `regen_module_edges`, `whole_pool_closure_edge_index`), the declarations realized and the host-keyed reads describe different populations. Shrinking one without the others overstates gains or breaks an implicit dependency. Reuse the relation's semantics; do not make every runtime operation walk the whole pool."),
    ]),
    h2(text: "3. Phases"),
    h3(text: "P0. Inventory and baseline"),
    p(text: "Acceptance: the full dependency relation is measured and costs are attributable to specific edges. Section 4 records it."),
    h3(text: "P1. CI leaf extraction"),
    p(text: "Move gates, release build, heal, retry, credential plumbing, deploy and the mtcollins1 local probe out of `gunbc.ci.ci_spec` to their domains: heal invocations beside heal orchestration, machine-specific probes beside `gunbc.machine_intake`. `gunbc.instruments.ci_gates` stops importing `CiSpec` and the gate roster from `ci_spec`. Acceptance: small consumers no longer reach `ci_spec`; every generated workflow is byte-identical."),
    h3(text: "P2. Fleet mode decomposition"),
    p(text: "Group mode-specific targets and invocations by domain; keep genuinely shared machinery shared. The run-step target roster (`gunbc.ci.ci_run_step_target`) moves toward a resolved symbol identity rather than hand-authored entry and function strings, without adding a whole-corpus scan to a fast-lane claim. Coordinated with `gunbc.plans.fleet_machine_authority` (the machine-registry program, #16252) so there is one fleet model. Acceptance: each mode has one authoritative definition; no duplicate target registration."),
    h3(text: "P3. Artifact producer consolidation"),
    p(text: "First an executed equivalence witness between `artifact_producer` and the current dispatch; then a typed producer adapter or compiler-supported entry selection that yields `ArtifactGenerationOutcome`, selected BEFORE the dispatch is loaded. `main_wet_one`'s unrostered-path and ambiguous-path refusals, the provenance header, validation and every committed-artifact byte comparison are kept; `main_wet` folds the same mechanism over its population. Acceptance: the requested producer loads without unrelated generators; output byte-identical."),
    h3(text: "P4. Runtime demand closure"),
    p(text: "Under the compiler demand-closure program, coordinated with session bright-ibex-807 (`gunbc.plans.read_set_convergence` answers whether a product is still valid, not what to load; if this plan adds skip-when-unchanged it consumes `v2.std.read_set` `validate_read_set`). Explicit demand edges or declared host membership for host-keyed reads (#16156, #16241); global bare-name lookup through a symbol index that keeps ambiguity and missing-name refusals. No allowlist and no silent fallback to loading the corpus. Acceptance: demand equivalence established against the wider path, with no silent omission."),
    h3(text: "P5. Deletion and final convergence"),
    p(text: "Each extraction removes the old export and import route in the same landing or a dependent one; no forwarding module named `ci_spec` survives. Dead declarations, scaffolds and superseded notes are deleted after classification against resolved references, registry enrollment, host reads and external invocation; authoritative operator-signed evidence is kept. Acceptance: the old boundaries are gone, not bypassed."),
    p(text: "Landing order: P1 alongside P4; P2 after P1; P3's equivalence witness alongside, its selective execution after a sound compiler boundary; P5 after each migration and once at the end."),
    h3(text: "Evidence each PR owes"),
    ul(items: [
      li(text: "A performance PR: before and after on the same pinned source and a comparable executor: wall time, phase costs, modules acquired, declarations realized, peak RSS. A smaller import count alone is not success."),
      li(text: "A structural PR: byte equality or behavior equivalence, plus a negative witness showing the refusal still fires."),
    ]),
    h2(text: "4. P0 inventory"),
    p(text: "Read at main `fd458f74e474`. The four quantities are kept apart because they are not interchangeable."),
    ul(items: [
      li(text: "**Import closure:** a walk of `import` lines from the entry. Not a bound in either direction: an import whose names are never referenced adds no edge to the full relation, and a bare reference adds an edge no import states."),
      li(text: "**Full dependency relation:** `required_regen_host` `regen_module_edges` (the union of `ref_out` and `bare_out` over the whole pool), dumped once; per-entry closures and per-edge attribution are computed over it."),
      li(text: "**Modules acquired:** the `GUNBC_READ_SET_OUT` receipt each run writes (`cli_run/demand_acquire.rs` `read_set_record`)."),
      li(text: "**Declarations realized, phase costs, peak RSS:** the `DeclarationRealizationProfile` diagnostic, the `[pre-entry] phase=` lines and `/usr/bin/time -v`."),
    ]),
    h3(text: "4.1 `gunbc.ci.ci_spec` declarations"),
    p(text: "Name-token reading over `dag/`, `src/v2/` and `src/` at the pinned revision: a candidate set, not a census. 401 declarations: 170 used outside the module, 188 internal helpers, 43 referenced nowhere. Six are used by a module that does not import them, which an import-only reading misses: `CiSpec` (`gunbc.rung_drop.floor_cut`), `ci_fmt_gate_note`, `ci_fmt_gate_line` and `gunbc_ci_heal_regen_invoke` (`gunbc.roadmap.roadmap_authority`), `site_pxe_edge_converge_receipt_path` (`gunbc.realization_census_rows`), `gunbc_ci_org_admin_app_token_prelude` (`gunbc.fleet.organization_runner_roster_read`). The 43 are P5 candidates, each checked against host-keyed reads before deletion."),
    h3(text: "4.2 Entry baselines"),
    p(text: "Seven entries on srv1, one at a time per lane, two lanes, one seed built from the pinned tree. The tree carried #16233's two fixes so regeneration could evaluate; they do not change what is acquired. Entries: E1 `claim_batch` over `test.claim.compiler_gate_workflow_witness` (the required gate's claims); E2, E3, E4 `main_wet_one` for `.github/workflows/witnesses.yml`, `.github/workflows/fleet-converge.yml` and `provisioning/srv1/gunbc-ghrunner.sudoers`; E5 `main_wet`; E6 `gunbc.fleet.fleet_converge_plan_cli` `fleet_converge_plan_wet` (refuses RunUnbound outside a fleet run, after compiling); E7 `claim_batch` over `test.claim.github_pull_request_decode_witness` (REST decoding over replayed fixtures)."),
    ul(items: [
      li(text: "**E1:** import closure 1,871 modules; full relation 1,707; 74 modules typechecked; 31 min 9 s; peak RSS 17.1 GB. Typechecked modules include `gunbc.host.host_effect_realize` (4 to 5 min alone), `gunbc.machine_intake`, `gunbc.roadmap` and `gunbc.live_deploy`."),
      li(text: "**E2, E3, E4:** import closure 2,248; full relation 3,239; acquired 3,408 files, the SAME 3,408 for each path; 14 min 22 s to 14 min 31 s; peak RSS 11.1 to 11.2 GB; `resolve_entry_graph_inclusive` 13.5 to 13.7 min of it."),
      li(text: "**E5:** the same 3,408 acquired; 16 min 53 s; 11.6 GB. One artifact costs 85 percent of all of them."),
      li(text: "**E6:** import closure 2,122; full relation 1,962; acquired 2,126; 8 min 40 s; 8.7 GB; resolve 8.6 min."),
      li(text: "**E7:** import closure 109; full relation 98; 4 min 5 s; 6.9 GB."),
    ]),
    h3(text: "4.3 Attribution"),
    ul(items: [
      li(text: "**The full relation does not attribute.** `gunbc.witness.compiler_gate_workflow` has 1,705 direct edges in it against a closure of 1,706, and `gunbc.instruments.generated_artifact_gate` 3,238 against 3,239: nearly every reachable module is a DIRECT neighbour, so cutting any one edge or removing any one module (including `gunbc.ci.ci_spec` and `gunbc.generated_artifact_emit`) drops at most one. The bare-reference half appears to join a spelling to every module that declares it rather than to the one declaration it resolves to; that is P4's first question, recorded here as a reading, not yet a finding."),
      li(text: "**Attribution today is by the import graph and the acquired receipt.** Over imports, `gunbc.ci.ci_spec` carries 1,801 modules and `gunbc.generated_artifact_emit` 2,244; the required gate's closure falls from 1,870 to 870 without its two small imports through `ci_spec`. Each P1 and P3 landing re-measures the acquired receipt and wall time for the entries above; that, not an import count, is the success measure."),
      li(text: "**Acquired exceeds the full relation** (3,408 against 3,239 for the generator entry): about 170 files arrive by a route that is not a reference edge, presumably host-keyed reads and probes. P4 names them."),
    ]),
    h3(text: "4.4 Instrument gaps found"),
    ul(items: [
      li(text: "`claim_batch` writes no `GUNBC_READ_SET_OUT` receipt, so a claim's acquired population is unmeasured."),
      li(text: "`gunbc run` printed no `DeclarationRealizationProfile` for these entries, so declarations realized is unmeasured on the run path."),
    ]),
    h3(text: "4.5 Re-measure after P1, P2 and P5 (2026-11-16, session warm-wolf-870, on srv1)"),
    p(text: "**Setup.** Both sides were measured by the same session on the same box (srv1, 128 cores, about 502 GB; other lanes shared it, load average about 9 to 19 during the runs and about 15 other-lane gunbc/claim_batch processes at peak), one entry at a time, each under `systemd-run --user --scope -p MemoryMax=40G` with `GUNBC_MEMORY_BUDGET_BYTES=34359738368` and `/usr/bin/time -v`. After side: main at `12bc0691a427`, where P5 (PR #16578) deleted `gunbc.ci.ci_spec`. Before side: `fd458f74e474` plus the two PR #16233 fixes the baseline carried (the `import extdeps.github.pulls` in `gunbc.tools.review`, and the brace-escapes in `a_field_default_is_evaluated_in_the_callers_scope`), materialized as commit `c5228a8` from the P0 inventory so it is byte-identical to the baseline corpus. Seeds are per-tree: a compiler built from each tree with `cargo build --release -p v1-compiler --bin gunbc --bin claim_batch`, matching section 4.1's one-seed-from-the-pinned-tree method."),
    p(text: "**Before-side reproduction.** Re-running the before side here reproduces section 4.2 within noise on every comparable figure (E1 31 min 10 s and 74 typechecked modules against the plan's 31 min 9 s and 74; the gate's three single-artifact entries each at 3,408 acquired against the plan's 3,408; E6 2,126 acquired; E5 11.60 GiB; E7 6.86 GiB). The deltas below are therefore the honest same-box comparison, and section 4.2's own numbers (a different day and load) are reference only."),
    TableBlock {
      header: row(cells: [cell(text: "Entry"), cell(text: "wall before -> after"), cell(text: "peak RSS GiB before -> after"), cell(text: "acquired files before -> after"), cell(text: "resolve_entry_graph_inclusive before -> after"), cell(text: "typechecked modules before -> after"), cell(text: "import closure before -> after")]),
      alignments: [AlignNone, AlignNone, AlignNone, AlignNone, AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "E1 claim_batch compiler_gate_workflow_witness"), cell(text: "31:10 -> 18:51"), cell(text: "17.08 -> 15.56"), cell(text: "unmeasured (claim_batch, 4.4)"), cell(text: "n/a on the claim path"), cell(text: "74 -> 52"), cell(text: "1871 -> 1480")]),
        row(cells: [cell(text: "E2 main_wet_one witnesses.yml"), cell(text: "14:08 -> 19:26"), cell(text: "11.11 -> 12.46"), cell(text: "3408 -> 3607"), cell(text: "13m20s -> 15m49s"), cell(text: "not printed"), cell(text: "2248 -> 2430")]),
        row(cells: [cell(text: "E3 main_wet_one fleet-converge.yml"), cell(text: "14:19 -> 22:46"), cell(text: "11.11 -> 12.65"), cell(text: "3408 -> 3607"), cell(text: "13m26s -> 16m08s"), cell(text: "not printed"), cell(text: "2248 -> 2430")]),
        row(cells: [cell(text: "E4 main_wet_one gunbc-ghrunner.sudoers"), cell(text: "14:11 -> 18:41"), cell(text: "11.22 -> 12.50"), cell(text: "3408 -> 3607"), cell(text: "13m24s -> 15m38s"), cell(text: "not printed"), cell(text: "2248 -> 2430")]),
        row(cells: [cell(text: "E5 main_wet"), cell(text: "16:35 -> 22:10"), cell(text: "11.60 -> 13.24"), cell(text: "3408 -> 3607"), cell(text: "13m34s -> 15m13s"), cell(text: "not printed"), cell(text: "2248 -> 2430")]),
        row(cells: [cell(text: "E6 fleet_converge_plan_wet (refuses RunUnbound after compile, exit 1, expected)"), cell(text: "7:51 -> 8:20"), cell(text: "8.74 -> 8.11"), cell(text: "2126 -> 1905"), cell(text: "7m46s -> 8m15s"), cell(text: "not printed"), cell(text: "2122 -> 1901")]),
        row(cells: [cell(text: "E7 claim_batch github_pull_request_decode_witness"), cell(text: "3:52 -> 3:50"), cell(text: "6.86 -> 6.97"), cell(text: "unmeasured (claim_batch, 4.4)"), cell(text: "n/a on the claim path"), cell(text: "not printed"), cell(text: "109 -> 108")]),
      ],
    },
    p(text: "wall and peak RSS are from `/usr/bin/time -v` (RSS in GiB). acquired is the `file` line count of the `GUNBC_READ_SET_OUT` read-set, equal to its distinct count and to the run's own `population` line (3411 closure files / 3408 acquired for the gate; 1906 / 1905 for the fleet plan). `resolve_entry_graph_inclusive` is the `[pre-entry] phase=` cost, printed on the `gunbc run` path only; `claim_batch` prints no such phase (its typecheck split is 24.5 min to 13.3 min for E1 and 32 s to 34 s for E7), so that column is marked n/a on the two claim entries. typechecked modules is the count of the per-module `typecheck <name> done` progress lines, which `claim_batch` prints for E1 only. import closure is a breadth-first walk over `import` lines using the P0 inventory's `clo.py` (present on srv1 under `/tmp/warm-wolf-870-measure/clo.py`; it is not a repository tool and is not committed here), comparison only; `gunbc.ci.ci_spec` is present in all four module closures on the before side and absent on the after side."),
    h3(text: "4.5.1 What the reading says"),
    ul(items: [
      li(text: "**E1 improved, and it is the entry whose closure actually contained ci_spec.** The compiler-gate workflow witness dropped from 74 to 52 typechecked modules, its typecheck split fell from 24.5 to 13.3 min, wall fell 31:10 to 18:51 and peak RSS 17.08 to 15.56 GiB; its import closure fell 1871 to 1480. Deleting `gunbc.ci.ci_spec` removed real work for this entry."),
      li(text: "**E6 improved modestly.** The fleet-plan entry's acquired fell 2126 to 1905 and peak RSS 8.74 to 8.11 GiB; wall and resolve are within load noise. It exits 1 after compiling with `fleet_converge_plan: RunUnbound` (GITHUB_REPOSITORY unset), which is expected, not a regression."),
      li(text: "**E2, E3, E4 and E5 -- the artifact gate -- got WORSE on every acquisition, memory and phase measure.** Acquired rose 3408 to 3607 (+199), peak RSS rose from about 11.1-11.6 GiB to about 12.5-13.2 GiB, `resolve_entry_graph_inclusive` rose from about 13.3 min to about 15.1-16.1 min, and wall rose from about 14 min to about 19-23 min. The import closure agrees (2248 to 2430, +182). Deleting ci_spec did NOT shrink the gate; it grew it, so the plan's hope that acquired would fall once ci_spec was gone is contradicted for the gate. The import-closure diff names what changed: 198 modules became reachable from the gate and 16 left it, `gunbc.ci.ci_spec` among those removed, and the additions dominated by CI-step modules (`gunbc.ci.ci_bash_step`, `gunbc.ci.ci_release_build`, `gunbc.ci.ci_retry` and the `*_ci_step` modules under `gunbc.fleet`, `gunbc.fabric` and `gunbc.auth`). That the deleted module and the newly-reachable CI-step family swap places is consistent with P1 and P2 having moved ci_spec's step definitions out of it into siblings the gate still reaches; that mechanism is an inference from this diff, and a per-module blame of those added modules against the P1 and P2 commits would confirm or refute it. Section 4.3's note that the bare-reference half joins a spelling to every module that declares it explains why a step landing in a broadly-referenced module would grow the gate's closure."),
      li(text: "**E7 is unchanged** within noise (wall 3:52 to 3:50, peak RSS 6.86 to 6.97 GiB, import closure 109 to 108); it never pulled ci_spec."),
      li(text: "**Seed.** One seed could serve both trees: the main seed evaluates the fd458 corpus too (E7 under the main seed: 4:00, 6.86 GiB, 21.1 s resolve, matching the before-seed run). Per-tree seeds were nevertheless used, because the baseline itself was one seed from the pinned tree and re-running the before side under the after compiler would stop reproducing that baseline."),
    ]),
    h3(text: "4.5.2 Unknowns and caveats"),
    ul(items: [
      li(text: "Wall time and peak RSS are load-sensitive on a shared box. Of the load-robust measures, `acquired` is the one that holds per entry; the typechecked-module count exists only for E1, and `resolve_entry_graph_inclusive` is not uniformly load-robust. For the gate (E2 to E5) acquired, peak RSS and `resolve_entry_graph_inclusive` all rose together, so the regression does not rest on wall time alone. For E6 the measures disagree: acquired fell 2126 to 1905 and its import closure fell 2122 to 1901 (the same direction), while `resolve_entry_graph_inclusive` rose 7m46s to 8m15s -- the opposite direction -- so the E6 reading leans on acquired and the closure, not on resolve."),
      li(text: "`claim_batch` still writes no `GUNBC_READ_SET_OUT` receipt (4.4), so acquired is unmeasured for E1 and E7; their acquisition proxy is the typechecked-module count and the typecheck split."),
      li(text: "`gunbc run` still prints no `DeclarationRealizationProfile` for these entries (4.4), so declarations realized remains unmeasured on the run path."),
      li(text: "Only E1 prints a typechecked-module count; E2 to E7 print none, so that column reads not printed rather than zero."),
      li(text: "The after-side E3 regenerated `.github/workflows/fleet-converge.yml` inside the disposable measurement tree only; nothing was committed or pushed and no workflow in the repository was touched (fleet-converge.yml is knowingly stale on main since PR #16334)."),
      li(text: "Raw logs, read-sets, `/usr/bin/time` output and the import-closure runs stay on srv1 under `/tmp/warm-wolf-870-measure/`; the measurement tools and logs are not committed."),
    ]),
    h3(text: "4.6 Why the gate grew after `ci_spec`'s deletion, and what was cut back (2026-11-18, session proud-tern-223, on srv1)"),
    p(text: "**Question.** Section 4.5 attributed the gate's growth by inference: the added modules being `gunbc.ci.ci_bash_step`, `gunbc.ci.ci_release_build`, `gunbc.ci.ci_retry` and the `*_ci_step` modules under `gunbc.fleet`, `gunbc.fabric` and `gunbc.auth` was read as P1 and P2 spreading `gunbc.ci.ci_spec`'s import surface, and section 4.5.1 said in terms that this was an inference from the diff that a per-module blame *would* confirm or refute. This section does that blame — for each added module, the import edge that brings it into the gate's closure and the commit that added that edge — and repairs the part the program caused."),
    p(text: "**Method.** The P0 tool's import semantics exactly (`^import <dotted>` over `dag/<dots as slashes>.dag` and `src/v2/<...>.dag` for `v2.*`), so the figures are comparable to 4.5's. Two trees: before `c5228a86b4fa` (4.5's own measurement tree, `fd458f74e474` plus the two PR #16233 fixes) and after `12bc0691a427`, entry `gunbc.instruments.generated_artifact_gate`. The reproduction is exact: closure 2,248 to 2,430, 198 modules added, 16 removed, `gunbc.ci.ci_spec` among the removed. From that graph the **frontier** is computed — the 103 edges whose importer was already reachable before and whose target was not. That set is minimal in the useful sense: cutting all of it returns the closure to the before side, so every added module enters through at least one frontier edge. Each edge is then attributed to the commit whose diff added that `import` line, over `fd458f74e474..12bc0691a427` — 206 commits, not the 36 the brief assumed. A commit counts as program work iff its **subject** names `ci_spec`, names this plan, or carries a plan-phase tag (`P1:` through `P7`); a feature PR whose body merely cites the plan as context does not, which is what keeps PR #16334 and the P8 re-lands on the other side. The classification was not taken on the rule alone: the 24 commits whose bodies cite the plan were read individually."),
    TableBlock {
      header: row(cells: [cell(text: "Bucket"), cell(text: "Added modules"), cell(text: "How it was decided")]),
      alignments: [AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "program-caused only"), cell(text: "114"), cell(text: "unreachable once every edge added by a `ci_spec`-dissolution commit is cut (50 such frontier edges)")]),
        row(cells: [cell(text: "unrelated main traffic only"), cell(text: "77"), cell(text: "unreachable once the other 53 frontier edges are cut; their commits are PR #16334 network install, #16621 hostname converge, #16309 spark, #16356 r2, #16586 sudoers, #16305/#16384 deployed intent, #16376 mac discovery, #16341 jit sweep")]),
        row(cells: [cell(text: "reachable either way"), cell(text: "7"), cell(text: "reached by both a program edge and an unrelated one")]),
      ],
    },
    p(text: "**The inference was right in kind and wrong in mechanism.** The added `*_ci_step` modules are not the cost: they are the honest residue of dissolving a god module, each reached because `gunbc.fleet.fleet_converge_workflow` renders a step it defines, and after the two repairs below no single import edge into them prunes two or more modules. The cost was **four string facts filed under heavy modules the renderers did not need the insides of** — two one-symbol and one two-symbol imports, both introduced inside this window, one by the program and one by a feature PR with the identical shape."),
    TableBlock {
      header: row(cells: [cell(text: "Importer"), cell(text: "Target it reads"), cell(text: "Symbols read"), cell(text: "Added modules dropped by cutting the edge"), cell(text: "Commit that added the edge")]),
      alignments: [AlignNone, AlignNone, AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "gunbc.fleet.fleet_converge_workflow"), cell(text: "gunbc.roadmap.roadmap_launch_deployment_receipt"), cell(text: "2 (artifact name, artifact dir)"), cell(text: "65, shared with the next row"), cell(text: "`bd5f703c1e43` P1 \"move receipt paths and artifact names out of `ci_spec` into their domains\" (PR #16418)")]),
        row(cells: [cell(text: "gunbc.roadmap.roadmap_launch_deployment_ci_step"), cell(text: "gunbc.roadmap.roadmap_launch_deployment_receipt"), cell(text: "1 (staging path)"), cell(text: "70 together with the row above"), cell(text: "`199f2b077548` P2 \"move the roadmap launch-deployment and live-deploy CI run steps out of `ci_spec`\" (PR #16445), which created the step module")]),
        row(cells: [cell(text: "gunbc.fleet.fleet_converge_workflow"), cell(text: "gunbc.host.network_install_ci"), cell(text: "1 (receipt path)"), cell(text: "70, shared with the next row"), cell(text: "`041051dd7d31` \"PXE 2c: the one-shot network install workflow\" (PR #16334) — **not** program work")]),
        row(cells: [cell(text: "gunbc.host.network_install_ci_step"), cell(text: "gunbc.host.network_install_ci"), cell(text: "1 (the same receipt path)"), cell(text: "included above"), cell(text: "`041051dd7d31` (PR #16334)")]),
      ],
    },
    p(text: "**Why one path string buys 65 modules.** `gunbc.roadmap.roadmap_launch_deployment_receipt` is a 1,100-line receipt *model*: it renders the receipt's record, so it imports `gunbc.fleet.fleet_converge_plan` to decode and compare the converge scope, and the plan module — 3,435 lines including its CLI surface — imports the workspace-commissioning store, the microvm slot controller, the service-activation policy and the resource ledger. That chain, not the string, is the 65. The string was moved *into* the model by P1 PR #16418, which then pointed the workflow's upload step at the model module for it. Likewise `gunbc.host.network_install_ci` is the install *executor* (44 direct imports, a 1,877-module closure reaching `gunbc.machine_intake.arrival_converge` and the BMC-recovery fleet) and never reads the `managed_host_network_install_receipt_path` it declares — that string is the CI step's own `receipt_rel`. Neither fact is asserted by any witness, which is why both were silently in the wrong module."),
    h3(text: "4.6.1 The repair"),
    ul(items: [
      li(text: "`b308e3471a23` — the four RLM launch-deployment receipt **location** declarations (artifact name, artifact dir, staging path, staging digest path) move verbatim, with their comment, from the receipt model to `gunbc.roadmap.roadmap_launch_deployment_receipt_location`: the location's own home, the shape this repository already uses for `gunbc.ci.release_bins_consumer_check_location` and `gunbc.fleet.fleet_plan_artifact_location` (7 lines, imports only `std.types`). The model keeps no import of it — no fact of the record depends on where the file is written — so the workflow's upload step and the CI run step read the location without acquiring the plan, the commissioning executor or the ledger. The declarations move; nothing re-exports them. No witness covers these four strings today and none is added here: no witness covered them before the move either (a search over `dag/test/` finds no citation of any of the four names, which is how they came to be filed under the wrong module unnoticed), and the precedent `*_location` modules carry none. What pins them is the byte-identical roster render in 4.6.3, which regenerates the workflow bodies that contain these exact strings — a stronger hold than a witness on the constant."),
      li(text: "`7ebc300a3d87` — `managed_host_network_install_receipt_path` moves verbatim, with its comment, to `gunbc.host.network_install_ci_step`, which already holds that step's sibling facts (its timeout, its digest command) and is where the string is consumed as the step's `receipt_rel`. No new module was minted: the narrow home already existed. `gunbc.host.network_install_ci` leaves the gate's closure entirely. Approved by the parent as the same defect shape as the program-caused one, carried in this PR as its own commit with its attribution (#16334, `041051dd7d31`) stated apart from the program's."),
      li(text: "Nothing else was reachable cheaply, and the ranking says so rather than asserting it. After these two cuts 116 of the added modules remain, 45 of them program-only, and **the largest number of them any single import edge in the closure now prunes is 1** — there is no second `receipt` or `network_install_ci` hiding behind one import. The 34 edges that prune one module each are recorded below."),
    ]),
    TableBlock {
      header: row(cells: [cell(text: "Edge still carrying program-only modules"), cell(text: "Modules that edge alone prunes"), cell(text: "Why it stays")]),
      alignments: [AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "32 edges `gunbc.fleet.fleet_converge_workflow` → a `gunbc.*` *_ci_step module, imported for 1–12 `*_invoke` renderers"), cell(text: "1 each"), cell(text: "the artifact genuinely renders those steps: the workflow emits the YAML whose body the renderer produces. Removing the import would mean un-rendering a fleet-converge step, which is a redesign of the artifact, not a misplaced fact.")]),
        row(cells: [cell(text: "`gunbc.host.host_name_resolution` → `extdeps.dns.resolver` (18 symbols)"), cell(text: "1"), cell(text: "the symbols are the resolver's own types (`Resolver`, `ResolvableName`, `resolve_name`, …), not a string; this is a real dependency, the widest edge left in the residual.")]),
        row(cells: [cell(text: "`gunbc.fleet.fleet_workflow_steps` → `gunbc.fleet.fleet_key_agent` (2 symbols)"), cell(text: "1"), cell(text: "`gunbc_ci_fleet_key_agent_script` and its cleanup script — the workflow emits those scripts, so it needs the factories.")]),
      ],
    },
    p(text: "Eleven of the 45 are reached through more than one of those edges at once, so no single cut removes them; the flat `1` across every edge is the point — the misplaced-fact shape is gone from the gate's closure and what remains is the fan-out of a workflow that renders forty-odd CI steps."),
    TableBlock {
      header: row(cells: [cell(text: "Tree"), cell(text: "Gate import closure"), cell(text: "Against the before side")]),
      alignments: [AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "before `c5228a86b4fa` (4.2/4.5 baseline)"), cell(text: "2,248"), cell(text: "—")]),
        row(cells: [cell(text: "after `12bc0691a427` (4.5 measurement)"), cell(text: "2,430"), cell(text: "+198")]),
        row(cells: [cell(text: "this head (PR #16660)"), cell(text: "2,348"), cell(text: "+116: 99 of the 198 recovered, 63 of them program-caused — 55% of that side")]),
      ],
    },
    h3(text: "4.6.2 What the reading says"),
    ul(items: [
      li(text: "**The gate bought its entire growth twice over by importing a whole module for a string, and both purchases were made inside this window.** `**The gate now acquires 98 fewer files and resolves 54 seconds faster than current main, measured back-to-back on the same box.** E2 (`main_wet_one` on `witnesses.yml`) acquires **3,527** distinct files at head against **3,625** on main tip, resolves in **14.83 min** against **15.72 min**, and peaks at **12.26 GiB** against **12.93 GiB**. Against 4.5's own before-side (3,408) that recovers 80 of the 199 files the window added.`"),
      li(text: "**The program caused the majority of the growth, contrary to the brief's expectation.** 114 of the 198 added modules are reachable only through edges added by `ci_spec`-dissolution commits; 77 through unrelated main traffic. The brief asked that the split be reported rather than assumed, and the assumption that 36-plus unrelated commits were the likely culprit does not hold — the window holds 206 commits and the larger share is program work."),
      li(text: "**The dissolution itself was not the problem.** P1/P2 replacing one `ci_spec` with some 40 domain `*_ci_step` modules costs the gate almost nothing per module: those step modules are leaf renderers whose imports are their own step's facts, and the residual 116 are reached through edges the artifact genuinely needs. The damage came from the two commits that moved *location strings* onto heavy neighbours while doing the dissolution."),
      li(text: "**`acquired` tracks the closure, as 4.5 found.** ` The two figures move together across all three trees: import closure 2,430 → 2,348 modules (−3.4%) and E2 acquired 3,625 → 3,527 files (−2.7%), with E5 (`main_wet`, the whole committed roster) landing on the same ordering — 3,625 acquired and 16.06 min at the merge-base, 3,625 and 14.95 min at main tip, 3,527 and 14.82 min at this head.`"),
    ]),
    h3(text: "4.6.3 Unknowns and caveats"),
    ul(items: [
      li(text: "Wall time and peak RSS are load-sensitive on the shared box; `acquired` and the import-closure count are the load-robust figures and lead here. ` The head/main pair was measured back-to-back inside one script, so the pair is comparable to itself; absolute wall time was taken while four other lanes were running `claim_batch`/`gunbc` jobs on the box, and the resolve phase is CPU-bound, so treat the wall figures as directional and the acquired and closure counts as the load-robust ones.`"),
      li(text: "E2 and E5 were re-measured head against current main on srv1, same box as 4.5, same method as 4.5 (`systemd-run --user --scope -p MemoryMax=40G`, `GUNBC_MEMORY_BUDGET_BYTES=34359738368`, `/usr/bin/time -v`, one entry at a time). ` E2 was measured on this head and on main tip; E5 (`main_wet`) was additionally measured on the merge-base, because the same run is the render proof. E3 and E4 (the `fleet-converge.yml` and sudoers single-artifact entries) were not re-measured separately: both fold through the same `artifact_generate` producer over a subset of E5's closure, so E5 bounds them.`"),
      li(text: "The commit classifier is a subject-line rule, so a program commit that had renamed itself away from the `ci_spec`/plan vocabulary would fall to the unrelated side."),
      li(text: "The frontier is computed on `import` lines only, matching the P0 tool; a module reached through a runtime-selected path would not appear. That is the same limitation 4.2's and 4.5's closure figures carry."),
      li(text: "Byte-identity of the committed artifacts was checked by rendering the **entire committed roster** through the regen producer `gunbc.generated_artifact_emit.artifact_generate` in three trees — this head, the merge-base `bcc9f6370160`, and main tip `d3e46b86c4ef` — from one seed binary on srv1. ` All three trees rendered the same bytes: the sha256 manifest over the committed workflows is identical at head, merge-base and main tip, and each tree came back at its own fixed point for every generated file except `provisioning/srv3/gunbc-ghrunner.sudoers` and `provisioning/srv4/gunbc-ghrunner.sudoers` — which drift identically in all three trees, including the two that do not contain this change, so the drift is not this PR's (this PR touches no sudoers authority).` Independently, GitHub's own `heal-generated-artifacts` actuator-plus-fixed-point proof ran on this head."),
      li(text: "The scratch entry that render used lives only on the disposable measurement trees; it is not committed, and no workflow in the repository was regenerated, rewritten, committed or pushed by this work."),
      li(text: "Raw logs, read-sets, `/usr/bin/time` output and the closure tools stay on srv1 under `/tmp/proud-tern-223/`; none of them is committed."),
    ]),
  ]
}

data closure_consolidation_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly,
  slug: "closure-consolidation",
  title: "Closure consolidation: dissolve ci_spec, select producers before loading them",
  body: closure_consolidation_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "P5's acceptance holds: `gunbc.ci.ci_spec` no longer exists and no forwarding module recreates its fan-in; `gunbc.generated_artifact_emit` selects a producer through `artifact_producer` before loading it and the second dispatch is deleted; single-artifact generation acquires only its producer's closure, with a before-and-after receipt; this plan deletes.") }
}
