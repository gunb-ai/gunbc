module gunbc.plans.contained_development_execution_g0_conditions

import std.decl_ref { DeclarationRef, WholeDeclaration }

// Single typed carrier for the G0 done-when conditions and the lifting count, so the
// count and conditions live in a typed carrier (gunbc.design_argument::source_annotations)
// and the lifting rule is a conjunction consumed by execution
// (gunbc.design_argument::fail_closed — not a string grep over plan prose). The plan
// module gunbc.plans.contained_development_execution_g0 renders human-readable prose and
// the lifting rule cites these symbols by name; it does not hold the count.

// The five states G0's headline names (roadmap_dispatch_actuator::g0_contained_development_execution).
type G0StateGroup = OperatorHome | Credentials | PrivilegeGroups | ControlPlaneStores | SharedState

// Typed identity for each condition row, selected BY VARIANT (never by matching free text in
// requires — gunbc.design_argument::fail_closed: a .contains() grep over free text is not a
// consumer; review 98735 F-KEY: a reword must not silently unselect a row).
type G0ConditionKey = ProtectHomeReadonlyRendered | OperatorHomeNotInHandedReadWritePaths | ProtectSystemStrictRendered | NoCredentialPathsInHandedSet | NoPerAttemptSecretsReach | NoSshPrivateKeyReach | SupplementaryGroupsNoRootEquivalent | NoNewPrivilegesAndRestrictSuid | NoPamInProperties | NoFabricHmacKeyInUnit | WritePathsUnderInstanceRoot | ProviderEventsLedgerScoped | SharedStateUmask0002 | NoEventCarrierWorktreeWrites | NoSpoolInFlightWrites

// One done-when condition: its typed key, which state it belongs to, what unreachability
// requires of a worker, and the repository symbol that models the state it protects.
type G0DoneWhenCondition = G0DoneWhenCondition {
  key: G0ConditionKey,
  group: G0StateGroup,
  requires: String,
  modelled_by: DeclarationRef,
}

data g0_state_groups: List<G0StateGroup> = [
  OperatorHome,
  Credentials,
  PrivilegeGroups,
  ControlPlaneStores,
  SharedState,
]

// One row per done-when condition across the five state groups. The count is never
// written down; it is read off this list by g0_condition_count.
data g0_done_when_conditions: List<G0DoneWhenCondition> = [
  G0DoneWhenCondition { key: ProtectHomeReadonlyRendered, group: OperatorHome, requires: "The worker unit property list rendered by gunbc.roadmap.roadmap_dispatch_actuator::dispatch_worker_unit_properties on the UnitRunOnSystemManager route contains ProtectHome=read-only (emitted by gunbc.roadmap.dispatch_worker_unit_confinement::dispatch_worker_unit_stream_properties), rendered to text by gunbc.extdeps.systemd.systemd_run::systemd_run_property_assignment, and the non-hardened route arm does NOT contain it. The negative case: if the check passes on the stripped render, it does not measure the property.", modelled_by: DeclarationRef { module_path: "gunbc.roadmap.dispatch_worker_unit_confinement", decl_name: "dispatch_worker_unit_stream_properties", field: WholeDeclaration } },
  G0DoneWhenCondition { key: OperatorHomeNotInHandedReadWritePaths, group: OperatorHome, requires: "No rendered ReadWritePaths= entry from the handed set (gunbc.roadmap.dispatch_worker_handed_set) begins with the operator home prefix (/home/<login>) unless the entry lies under the instance's own root. The srv2 preview root is under operator home by design (see the [srv2-root-inside-operator-home] finding). The negative case: a hand-constructed handed set containing /home/briansrls/some-path-outside-the-instance-root makes the check fail.", modelled_by: DeclarationRef { module_path: "gunbc.roadmap.roadmap_dashboard_instance", decl_name: "srv2_dashboard_preview_root", field: WholeDeclaration } },
  G0DoneWhenCondition { key: ProtectSystemStrictRendered, group: Credentials, requires: "The worker unit property list rendered by gunbc.roadmap.roadmap_dispatch_actuator::dispatch_worker_unit_properties contains ProtectSystem=strict (emitted by gunbc.roadmap.dispatch_worker_unit_confinement::dispatch_worker_unit_stream_properties) and the non-hardened route arm does not. The negative case: if the check passes on the stripped render, it does not measure the property.", modelled_by: DeclarationRef { module_path: "gunbc.roadmap.dispatch_worker_unit_confinement", decl_name: "dispatch_worker_unit_stream_properties", field: WholeDeclaration } },
  G0DoneWhenCondition { key: NoCredentialPathsInHandedSet, group: Credentials, requires: "No ReadWritePaths= entry from the handed set equals any HostCredentialCustodyRow's path field, the rendered unit carries no EnvironmentFile= pointing at a custody path, and no custody path appears in any ExecStart= argument. The negative case: a hand-crafted handed set or unit naming the fabric HMAC key path (/etc/gunbc-fabric-storage/state-writer-mac-key) makes the check fail.", modelled_by: DeclarationRef { module_path: "gunbc.fleet.host_credential_custody_roster", decl_name: "HostCredentialCustodyRow", field: WholeDeclaration } },
  G0DoneWhenCondition { key: NoPerAttemptSecretsReach, group: Credentials, requires: "No EnvironmentFile=, ReadWritePaths=, nor ExecStart= argument reaches the per-attempt credential snapshot path derived by gunbc.roadmap.roadmap_dispatch_actuator::dispatch_credential_snapshot_path_for_attempt (the seal is gunbc.dispatch_credential_snapshot::TakenCredentialSnapshot). The negative case: a hand-crafted unit naming the snapshot path makes the check fail.", modelled_by: DeclarationRef { module_path: "gunbc.roadmap.roadmap_dispatch_actuator", decl_name: "dispatch_credential_snapshot_path_for_attempt", field: WholeDeclaration } },
  G0DoneWhenCondition { key: NoSshPrivateKeyReach, group: Credentials, requires: "No EnvironmentFile=, ReadWritePaths=, nor ExecStart= argument reaches SSH private key material (the GKE-pinned SecretRef gunbc.fleet.fleet_ssh_access::fleet_automation_ssh_privkey_secret). The negative case: a hand-crafted unit with EnvironmentFile= naming the fleet-automation private key secret makes the check fail.", modelled_by: DeclarationRef { module_path: "gunbc.fleet.fleet_ssh_access", decl_name: "fleet_automation_ssh_privkey_secret", field: WholeDeclaration } },
  G0DoneWhenCondition { key: SupplementaryGroupsNoRootEquivalent, group: PrivilegeGroups, requires: "The intersection of the worker's declared supplementary group list (gunbc.fleet.fleet_posix_accounts::fleet_posix_worker_supplementary_groups) and the declared root-equivalent group list (gunbc.fleet.fleet_root_equivalent_groups::fleet_root_equivalent_group_names) is empty. The negative case: a hand-modified supplementary group list containing \"docker\" makes the check fail.", modelled_by: DeclarationRef { module_path: "gunbc.fleet.fleet_posix_accounts", decl_name: "fleet_posix_worker_supplementary_groups", field: WholeDeclaration } },
  G0DoneWhenCondition { key: NoNewPrivilegesAndRestrictSuid, group: PrivilegeGroups, requires: "The rendered hardened unit contains NoNewPrivileges=yes, RestrictSUIDSGID=yes, and (in SystemManager mode) the empty-valued bounding-set assignment CapabilityBoundingSet= (the token gunbc.extdeps.systemd.systemd_run::systemd_run_empty_capability_bounding_set_assignment emits for the EmptyCapabilityBoundingSet arm; there is no systemd directive named EmptyCapabilityBoundingSet assigned to yes); the stripped render does not contain them. The negative case: if the check passes on the stripped render, it does not measure the properties.", modelled_by: DeclarationRef { module_path: "extdeps.systemd.systemd_run", decl_name: "systemd_run_empty_capability_bounding_set_assignment", field: WholeDeclaration } },
  G0DoneWhenCondition { key: NoPamInProperties, group: PrivilegeGroups, requires: "The rendered unit contains no PAM substring in any property assignment (no PAMName=, no PAMTasksMax=). The negative case: a hand-crafted unit with PAMName=su makes the check fail.", modelled_by: DeclarationRef { module_path: "extdeps.systemd.systemd_run", decl_name: "systemd_run_property_assignment", field: WholeDeclaration } },
  G0DoneWhenCondition { key: NoFabricHmacKeyInUnit, group: ControlPlaneStores, requires: "The rendered unit text does not contain the fabric HMAC key path (gunbc.fabric.fabric_storage_state_location::fabric_state_key_host_path), does not contain EnvironmentFile= pointing at it, and no Environment= line names the fabric storage URL from gunbc.fabric.fabric_storage_client::fabric_storage_binding. The negative case: a hand-crafted unit with Environment=FABRIC_URL=... or EnvironmentFile= naming the HMAC key path makes the check fail.", modelled_by: DeclarationRef { module_path: "gunbc.fabric.fabric_storage_state_location", decl_name: "fabric_state_key_host_path", field: WholeDeclaration } },
  G0DoneWhenCondition { key: WritePathsUnderInstanceRoot, group: ControlPlaneStores, requires: "Every ReadWritePaths= entry is under the instance's own attempt-state root (gunbc.roadmap.roadmap_dashboard_instance::dashboard_instance_dispatch_attempt_state_root); no entry names another instance's attempts member. The negative case: a hand-crafted handed set with a path under another instance's root makes the check fail.", modelled_by: DeclarationRef { module_path: "gunbc.roadmap.roadmap_dashboard_instance", decl_name: "dashboard_instance_dispatch_attempt_state_root", field: WholeDeclaration } },
  G0DoneWhenCondition { key: ProviderEventsLedgerScoped, group: ControlPlaneStores, requires: "The provider-events ledger absolute path (from gunbc.roadmap.roadmap_attempt_state_store::attempt_state_directory_segment, joined with the worker-events file name) contains the instance's attempt-state root prefix and the attempt-key infix. The negative case: a path that omits the attempt-key infix or instance-root prefix makes the check fail.", modelled_by: DeclarationRef { module_path: "gunbc.roadmap.roadmap_attempt_state_store", decl_name: "attempt_state_directory_segment", field: WholeDeclaration } },
  G0DoneWhenCondition { key: SharedStateUmask0002, group: SharedState, requires: "The rendered hardened unit contains UMask=0002 (from gunbc.roadmap.dispatch_worker_unit_confinement::dispatch_dedicated_worker_umask, emitted by gunbc.roadmap.dispatch_worker_unit_confinement::dispatch_worker_umask_properties); the stripped render does not. The negative case: if the check passes on the stripped render, it does not measure the property.", modelled_by: DeclarationRef { module_path: "gunbc.roadmap.dispatch_worker_unit_confinement", decl_name: "dispatch_dedicated_worker_umask", field: WholeDeclaration } },
  G0DoneWhenCondition { key: NoEventCarrierWorktreeWrites, group: SharedState, requires: "No ReadWritePaths= entry contains the event-carrier worktree path from gunbc.roadmap.roadmap_event_carrier_directory::roadmap_event_carrier_directory for the instance. The negative case: a hand-crafted unit with the carrier directory in ReadWritePaths= makes the check fail.", modelled_by: DeclarationRef { module_path: "gunbc.roadmap.roadmap_event_carrier_directory", decl_name: "roadmap_event_carrier_directory", field: WholeDeclaration } },
  G0DoneWhenCondition { key: NoSpoolInFlightWrites, group: SharedState, requires: "No ReadWritePaths= entry contains the spool in_flight segment under the instance root (gunbc.host.host_layout::attempt_unit_spool_root). The negative case: a path containing in_flight under the instance root makes the check fail.", modelled_by: DeclarationRef { module_path: "gunbc.host.host_layout", decl_name: "attempt_unit_spool_root", field: WholeDeclaration } },
]

// The count is computed by reading the list off the carrier; nothing in this repo writes
// the number down.
fn g0_condition_count() -> Int {
  count(g0_done_when_conditions)
}

// The lifting rule as a conjunction: it holds exactly when one proof is supplied per
// condition AND every proof is true. The arity is the computed count, never a literal.
fn g0_lift_conjunction_holds(proofs: List<Bool>) -> Bool {
  count(proofs) == g0_condition_count() && all(proofs, p => p)
}

// The rows carrying one typed key (selection by VARIANT, review 98735 F-KEY).
fn g0_conditions_with_key(k: G0ConditionKey) -> List<G0DoneWhenCondition> {
  filter(g0_done_when_conditions, c => c.key == k)
}

// Identity guard: every key occurs EXACTLY ONCE. Duplicating a key (the writable wrong state)
// makes this red, so selection can never be quietly ambiguous
// (gunbc.design_argument::fail_closed: making it unwritable beats catching it).
fn g0_condition_keys_are_unique() -> Bool {
  all(g0_done_when_conditions, c => count(g0_conditions_with_key(c.key)) == 1)
}

// Every declared state group has at least one condition row.
fn g0_groups_covered() -> Bool {
  all(g0_state_groups, group => count(g0_conditions_for_group(group)) > 0)
}

// The readable name of a state group (used to render the plan's done-when list FROM these rows, so the
// prose is generated from the carrier rather than duplicating it).
fn g0_group_label(g: G0StateGroup) -> String {
  match g {
    OperatorHome => "operator home"
    Credentials => "credentials"
    PrivilegeGroups => "privilege groups"
    ControlPlaneStores => "control-plane stores"
    SharedState => "shared state"
  }
}

// The done-when conditions belonging to one group, read off the typed rows (matched by label so group
// membership relies only on String equality, which is a documented primitive).
// Membership is decided on the VARIANT, never on a rendered label (review 98676 FINDING 4;
// gunbc.design_argument::fail_closed: making the wrong state unwritable beats catching it --
// two labels edited to the same text cannot silently merge groups).
fn g0_conditions_for_group(g: G0StateGroup) -> List<G0DoneWhenCondition> {
  filter(g0_done_when_conditions, c => c.group == g)
}
