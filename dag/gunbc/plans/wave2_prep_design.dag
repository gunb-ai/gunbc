module gunbc.plans.wave2_prep_design


fn status_block() -> std.markdown.MarkdownBlock {
  gunbc.plans.md_helpers.quote(blocks: [
    gunbc.plans.md_helpers.p(text: "**Status: SUPERSEDED BY THE ROSTER CUT (2026-08-17) — quarry, not a plan.** Every mechanism this document names as its authority — `compiler_frontier_roster` and its 27 rows, `compiler_frontier_module_count_expected`, `compiler_frontier_self_emitted_baseline`, `compiler_frontier_census_attribution`, `compiler_frontier_sweep_order` and its monotonicity witness, `compiler_frontier_census_holds`, `compiler_frontier_band_a_emit_readiness_roster` — was deleted with the self-host frontier roster. The symbols below are NOT repointed to survivors, deliberately: there is no mapping from a roster row to a replacement, and inventing one would fabricate an authority this document never had. Per DESIGN §3, a plan authored while the deleted structure lived is re-read as quarry — its area map and its findings may still be evidence, but its sequencing is the old structure's gravity written down and is not authority over what replaces it. Read every symbol reference below as naming something that no longer exists. Original status line follows. **Status: design/scoping (checkpoint 0)** — Wave 2 prep for first real module self-emit flips. Design-first; NO load-bearing pipeline edits in this plan. Authored as a .dag Plan and NOT yet enrolled as a generated docs/plans md (no PlanArtifact, no plan_registry entry, no roadmap node) — enrollment is checkpoint 1; until then this module is reviewable from its own source. Authority chain: gunbc.plans.v2_self_hosting (wave sequencer) · general-body-producer-design (FLAG E / body producer) · namespace-resolution-design · type-env-single-authority-design (SymbolIndex index half) · **census carrier** v2.compiler.self_host.frontier (`frontier.dag`). DESIGN §2/§6: census counts and per-module ranks live on the carrier — this plan cites symbols, never a parallel ledger."),
  ])
}

fn section_1() -> List<std.markdown.MarkdownBlock> {
  [
    gunbc.plans.md_helpers.h2(text: "1. Module-flip census — cite the carrier"),
    gunbc.plans.md_helpers.p(text: "All census facts are execution-measured or knowledge-attributed on `src/v2/compiler/self_host/frontier.dag`. Read them there; do not transcribe counts into this plan."),
    gunbc.plans.md_helpers.ul(items: [
      gunbc.plans.md_helpers.li(text: "**Roster authority:** `compiler_frontier_roster` (27 rows) + `compiler_frontier_module_count_expected`."),
      gunbc.plans.md_helpers.li(text: "**Self-emitted baseline:** `compiler_frontier_self_emitted_baseline` and witness `compiler_frontier_self_emitted_baseline_holds`."),
      gunbc.plans.md_helpers.li(text: "**Census attribution:** `compiler_frontier_census_attribution` (wave label `^wave2_post_resolver_6451_body_stage_a_6443`)."),
      gunbc.plans.md_helpers.li(text: "**Sweep order:** `compiler_frontier_sweep_order` — tractability-ranked flip sequence; monotonicity witness `compiler_frontier_sweep_order_matches_tractability_rank_holds`."),
      gunbc.plans.md_helpers.li(text: "**Aggregate census gate:** `compiler_frontier_census_holds`."),
      gunbc.plans.md_helpers.li(text: "**Per-module facts:** each `compiler_frontier_row_*` carries `disposition`, `measured_probe.blocker_class`, `tractability_rank`, and `SeedRetained.migration_trigger` — the only per-module ledger."),
    ]),
    gunbc.plans.md_helpers.h3(text: "1.1 Wave 2 prefix (first ~11 in sweep order)"),
    gunbc.plans.md_helpers.p(text: "The Wave 2 tractability frontier is the **first eleven entries** of `compiler_frontier_sweep_order` on the frontier carrier. For each path, look up the matching `compiler_frontier_row_*` roster row for `closure_reads`, `tractability_rank`, blocker class, and `migration_trigger` — do not duplicate those fields here."),
    gunbc.plans.md_helpers.ol(items: [
      gunbc.plans.md_helpers.li(text: "`src/v2/compiler/parse_engine_hooks.dag` — row `compiler_frontier_row_parse_engine_hooks`"),
      gunbc.plans.md_helpers.li(text: "`src/v2/compiler/use_site_verdict.dag` — row `compiler_frontier_row_use_site_verdict`"),
      gunbc.plans.md_helpers.li(text: "`src/v2/compiler/discovery_enumeration.dag` — row `compiler_frontier_row_discovery_enumeration`"),
      gunbc.plans.md_helpers.li(text: "`src/v2/compiler/self_host.dag` — row `compiler_frontier_row_self_host`"),
      gunbc.plans.md_helpers.li(text: "`src/v2/compiler/materialization_carriers.dag` — row `compiler_frontier_row_materialization_carriers`"),
      gunbc.plans.md_helpers.li(text: "`src/v2/compiler/07_target_carriers.dag` — row `compiler_frontier_row_07_target_carriers`"),
      gunbc.plans.md_helpers.li(text: "`src/v2/compiler/fold_lowering.dag` — row `compiler_frontier_row_fold_lowering`"),
      gunbc.plans.md_helpers.li(text: "`src/v2/compiler/03_normalize.dag` — row `compiler_frontier_row_03_normalize`"),
      gunbc.plans.md_helpers.li(text: "`src/v2/compiler/03_resolve.dag` — row `compiler_frontier_row_03_resolve`"),
      gunbc.plans.md_helpers.li(text: "`src/v2/compiler/03_name_resolve.dag` — row `compiler_frontier_row_03_name_resolve`"),
      gunbc.plans.md_helpers.li(text: "`src/v2/compiler/04_infer.dag` — row `compiler_frontier_row_04_infer`"),
    ]),
    gunbc.plans.md_helpers.p(text: "**Interpretation (qualitative, carrier-grounded):** the prefix rows are `EmitSurfaceGap` with low `closure_reads` relative to the roster tail; the three `NameResolutionGap` rows (`compiler_frontier_row_00_compile`, `compiler_frontier_row_01_tokenize`, `compiler_frontier_row_03_body_producer`) sit at the back of `compiler_frontier_sweep_order`."),
  ]
}

fn section_2() -> List<std.markdown.MarkdownBlock> {
  [
    gunbc.plans.md_helpers.h2(text: "2. Flip order and Wave 1 exit gates"),
    gunbc.plans.md_helpers.h3(text: "2.1 Wave 1 exit (must be green before Wave 2 opens)"),
    gunbc.plans.md_helpers.p(text: "From gunbc.plans.v2_self_hosting Wave 1 — all four gates green-by-execution:"),
    gunbc.plans.md_helpers.ol(items: [
      gunbc.plans.md_helpers.li(text: "**General body producer** — real ingested fn bodies via forward grammar rows (Stage A FACT layer landed #6443; Stages A remainder / B / C / D in flight)."),
      gunbc.plans.md_helpers.li(text: "**Namespace SymbolIndex** — B1 merged + containment fill; unblocks rows whose `migration_trigger` is `^migrate_when_namespace_only_resolution_lands`."),
      gunbc.plans.md_helpers.li(text: "**FLAG D** — `EnvironmentBindingKey` identity re-grounding (required before feature closes)."),
      gunbc.plans.md_helpers.li(text: "**Weak self-host behavioral receipt** — e.g. `std/logic` emit → compile → run ≡ seed."),
    ]),
    gunbc.plans.md_helpers.p(text: "**No v1 deletion in Wave 1.**"),
    gunbc.plans.md_helpers.h3(text: "2.2 Wave 2 flip sequencing — three bands"),
    gunbc.plans.md_helpers.p(text: "Within the sweep-order prefix, flips group into three bands (not a flat serial list). Band A Wave-1-pre-flip readiness (`FlippableNow | BodyProducerGated | OtherGate`) lives on `v2.compiler.self_host.frontier_band_a_emit_readiness` (`compiler_frontier_band_a_emit_readiness_roster`, witness `compiler_frontier_band_a_emit_readiness_holds`; wired into `compiler_frontier_census_holds` on `frontier`) — cite the carrier, do not transcribe counts here."),
    gunbc.plans.md_helpers.ul(items: [
      gunbc.plans.md_helpers.li(text: "**Band A — leaf emit modules** (`parse_engine_hooks`, `use_site_verdict`, `discovery_enumeration`, `self_host`, `materialization_carriers`, `07_target_carriers`): parallelizable after Wave 1 gate 4; receipt = cargo-green + behavioral-equivalence vs seed (NOT byte-identity). Classification on `compiler_frontier_band_a_emit_readiness_roster`."),
      gunbc.plans.md_helpers.li(text: "**Band B — body-lowering seam** (`fold_lowering` → `03_normalize`, serial): FLAG E row-fold **remains** (Slice 0 production-identity forward fold; `body_lowering_fold.dag` still interim until Slice 4 deletion); Stage A fn_decl → Arrow rows land."),
      gunbc.plans.md_helpers.li(text: "**Band C — resolution-dependent pipeline** (`03_name_resolve` → `03_resolve` → `04_infer`, serial): hard-gated on Wave 1 SymbolIndex / namespace; fill before lookup before inference."),
    ]),
    gunbc.plans.md_helpers.h3(text: "2.3 Census ratchet discipline"),
    gunbc.plans.md_helpers.p(text: "Each flip updates the matching `compiler_frontier_row_*`: `SeedRetained` → `SelfEmitted` with a measured `FrontierProbeReceipt` when `^migrate_when_frontier_per_module_probe_receipt_binds` lands. Until then, disposition updates require a linked behavioral receipt — do not hand-edit blocker classes without probe execution."),
  ]
}

fn section_3() -> List<std.markdown.MarkdownBlock> {
  [
    gunbc.plans.md_helpers.h2(text: "3. FLAG E — row-fold design (dissolve `body_lowering_fold.dag`)"),
    gunbc.plans.md_helpers.h3(text: "3.1 What landed vs what remains"),
    gunbc.plans.md_helpers.p(text: "**LANDED (#6443) — FLAG E one table for sugar:** `SugarKey = SurfaceAtomKey | ProductionIdentityKey` (`v2.std.compilers.sugar`); `type_alias_rhs` migrated as proof row; normalize pipeline child-fold → `body_lower_finish` → `normalize_sugar_finish` (`03_normalize.dag`)."),
    gunbc.plans.md_helpers.p(text: "**LANDED (ingest reparse) — token-spine forward row selection:** `grammar_relation_row_forward_selection` in `v2.compiler.ingest` (`03_ingest.dag:202`) via `ForwardRowSelection` (`ForwardRowNone` / `ForwardRowOne` / `ForwardRowMany`) → `Outcome<Node>`; live round-trip consumers. Keys on token-spine frontier — **not** the body-producer seam; do not duplicate."),
    gunbc.plans.md_helpers.p(text: "**LANDED (emit) — backward row selection:** `grammar_relation_row_reverse_parse_selection` in `v2.std.grammar`, consumed by `06_translate.dag`."),
    gunbc.plans.md_helpers.p(text: "**INTERIM — hand-walker (`v2.compiler.body_lowering_fold`, ~1.5k LOC):** production-identity dispatch in `body_lower_production_emitted` / `body_lower_finish`. Dissolution contract on carrier: **do NOT port arms into `SugarRule` rows** — dissolve into **GrammarRelationRow forward fold** (general-body-producer-design §3)."),
    gunbc.plans.md_helpers.p(text: "**Two layers (clarifies `body_lowering_fold_note` ambiguity):**"),
    std.markdown.TableBlock {
      header: gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "layer"), gunbc.plans.md_helpers.cell(text: "mechanism"), gunbc.plans.md_helpers.cell(text: "owns")]),
      alignments: [std.markdown.AlignNone, std.markdown.AlignNone, std.markdown.AlignNone],
      rows: [
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "Sugar"), gunbc.plans.md_helpers.cell(text: "`SugarKey` → `SugarRule` table"), gunbc.plans.md_helpers.cell(text: "surface connective sugar, coproduct pipe chains")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "Body producer"), gunbc.plans.md_helpers.cell(text: "`GrammarRelationRow` forward selection + slot map"), gunbc.plans.md_helpers.cell(text: "fn bodies → `Behavior` substrate")]),
      ],
    },
    gunbc.plans.md_helpers.p(text: "The hand-walker dissolves into the **body-producer layer**, not into `SugarRule` extensions."),
    gunbc.plans.md_helpers.h3(text: "3.2 Target architecture"),
    gunbc.plans.md_helpers.ol(items: [
      gunbc.plans.md_helpers.li(text: "**Select** exactly one `GrammarRelationRow` by **production emitted identity** on the parse-tree node (mirror the exactly-one discipline of `grammar_relation_row_reverse_parse_selection` and ingest's `ForwardRowSelection`, but keyed on `^grammar_production_identity_node_projection` — not token spine)."),
      gunbc.plans.md_helpers.li(text: "**Apply** row forward slot map: captured/bound slots → core `NodeKind` + edges."),
      gunbc.plans.md_helpers.li(text: "**Delegate** fold-family **calls** → `fold_lowering.dag` (`fold_call_to_loop`); pass-through expr wrappers unwrap; metadata wrappers preserve shell."),
    ]),
    gunbc.plans.md_helpers.p(text: "**Placement:** normalize, after child-fold, before sugar — same `body_lower_finish` seam; implementation replaces call target with forward row fold."),
    gunbc.plans.md_helpers.h3(text: "3.3 Production-identity forward fold at normalize (Slice 0 — REMAINS)"),
    gunbc.plans.md_helpers.p(text: "Slice 0 does **not** add `grammar_relation_row_forward_selection` — that name is **already landed** in `03_ingest.dag` for reparse (token-spine keyed). `ObligationForwardDeterminism` / `ObligationSlotBijection` in `grammar.dag` remain unconsumed at the normalize/body-producer seam."),
    gunbc.plans.md_helpers.p(text: "**Slice 0 remains:** production-identity-keyed forward row select + slot-map apply at `body_lower_finish`, reusing the `ForwardRowNone` / `ForwardRowOne` / `ForwardRowMany` exactly-one pattern (or a shared helper extracted from ingest/backward — never a third selection authority). Wire `ObligationForwardDeterminism` + `ObligationSlotBijection` as the body-producer's first consumer."),
    gunbc.plans.md_helpers.h3(text: "3.4 Row inventory (hand-walker arms → rows)"),
    std.markdown.TableBlock {
      header: gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "slice"), gunbc.plans.md_helpers.cell(text: "productions"), gunbc.plans.md_helpers.cell(text: "core target"), gunbc.plans.md_helpers.cell(text: "dissolves")]),
      alignments: [std.markdown.AlignNone, std.markdown.AlignNone, std.markdown.AlignNone, std.markdown.AlignNone],
      rows: [
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "1"), gunbc.plans.md_helpers.cell(text: "fn_decl, fn_literal"), gunbc.plans.md_helpers.cell(text: "Arrow + domain + ^arrow_body_edge"), gunbc.plans.md_helpers.cell(text: "body_lower_fn_decl_to_arrow, param collectors")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "1b"), gunbc.plans.md_helpers.cell(text: "expr wrappers (pass-through)"), gunbc.plans.md_helpers.cell(text: "unwrap only"), gunbc.plans.md_helpers.cell(text: "body_lower_unwrap_*")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "2"), gunbc.plans.md_helpers.cell(text: "let_expr, if_expr, match_expr"), gunbc.plans.md_helpers.cell(text: "Bind / Branch / Match"), gunbc.plans.md_helpers.cell(text: "new rows; match arm patterns = honest residue")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "3"), gunbc.plans.md_helpers.cell(text: "primary/call, infix, postfix"), gunbc.plans.md_helpers.cell(text: "Transform"), gunbc.plans.md_helpers.cell(text: "body_lower_primary/postfix/infix_*; field access refused until namespace `.` lands")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "—"), gunbc.plans.md_helpers.cell(text: "fn_body, metadata, unmapped"), gunbc.plans.md_helpers.cell(text: "deferred / preserve / wrapper-retained refusal"), gunbc.plans.md_helpers.cell(text: "honest residue frontier")]),
      ],
    },
    gunbc.plans.md_helpers.p(text: "**Fold-call path:** delegate to `fold_call_to_loop` — callee-head keyed semantic desugar, not a grammar row."),
    gunbc.plans.md_helpers.h3(text: "3.5 SugarRule vs forward row — decision rule"),
    gunbc.plans.md_helpers.p(text: "If lowering needs per-production captured-slot bijection from the grammar relation, it is a **forward row**, not a `SugarRule` arm — prevents re-widening the sugar fork."),
    gunbc.plans.md_helpers.h3(text: "3.6 Implementation slices and acceptance"),
    std.markdown.TableBlock {
      header: gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "slice"), gunbc.plans.md_helpers.cell(text: "PR scope"), gunbc.plans.md_helpers.cell(text: "accept")]),
      alignments: [std.markdown.AlignNone, std.markdown.AlignNone, std.markdown.AlignNone],
      rows: [
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "0"), gunbc.plans.md_helpers.cell(text: "production-identity forward select + apply at normalize (`03_normalize` / body-producer seam); reuse ingest ForwardRowSelection discipline — NOT duplicate `03_ingest.dag` token-spine selection"), gunbc.plans.md_helpers.cell(text: "None/Many refuse; One selects + slot map applies; obligation carriers consumed; RED on duplicate-row / missing-row")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "1"), gunbc.plans.md_helpers.cell(text: "fn_decl/fn_literal rows + normalize hook"), gunbc.plans.md_helpers.cell(text: "MVP produce_* parity; FLAG D conform param refs; RED wrapper-retained")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "2"), gunbc.plans.md_helpers.cell(text: "let/if/match rows"), gunbc.plans.md_helpers.cell(text: "branch/match witnesses; RED stmt-seq refuses")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "3"), gunbc.plans.md_helpers.cell(text: "call/infix/postfix rows"), gunbc.plans.md_helpers.cell(text: "binop + call witnesses; RED field access refuses")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "4"), gunbc.plans.md_helpers.cell(text: "delete body_lowering_fold.dag"), gunbc.plans.md_helpers.cell(text: "file absent; corpus green; wrapper-retained ≤ residue frontier")]),
      ],
    },
    gunbc.plans.md_helpers.h3(text: "3.7 Dependencies blocking Slice 1"),
    gunbc.plans.md_helpers.ul(items: [
      gunbc.plans.md_helpers.li(text: "**SymbolIndex / namespace (Wave 1 gate 2):** fn_decl binding via module-root edges."),
      gunbc.plans.md_helpers.li(text: "**FLAG D:** occurrence-normalized param refs until binding-key re-grounding; witness `bind_eval_occurrence_identity_defect_note` documents flip trigger."),
    ]),
  ]
}

fn section_4() -> List<std.markdown.MarkdownBlock> {
  [
    gunbc.plans.md_helpers.h2(text: "4. SymbolIndex dependency map (sweep-order prefix)"),
    gunbc.plans.md_helpers.h3(text: "4.1 Substrate facts (single authority)"),
    gunbc.plans.md_helpers.ul(items: [
      gunbc.plans.md_helpers.li(text: "`SymbolIndex` — `v2.std.symbol_index` (`Map<QualifiedName, Node>`)."),
      gunbc.plans.md_helpers.li(text: "Fill — `v2.compiler.symbol_index_fill` (containment tree materialized)."),
      gunbc.plans.md_helpers.li(text: "Lookup — `symbol_index_lexical_lookup` (lexical up ancestor chain)."),
      gunbc.plans.md_helpers.li(text: "Consumer — `03_resolve.dag` (`try_symbol_index_atom_identity`)."),
      gunbc.plans.md_helpers.li(text: "Orchestrator — `03_name_resolve.dag` (`symbol_index_fill_module_roots`)."),
    ]),
    gunbc.plans.md_helpers.p(text: "**One-index invariant:** fill is policy-agnostic; `ResolutionPolicy` gates lookup only (namespace-resolution-design §7.5 + type-env-single-authority §7.5)."),
    gunbc.plans.md_helpers.h3(text: "4.2 Per-module tiers (prefix modules only)"),
    std.markdown.TableBlock {
      header: gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "module (sweep prefix)"), gunbc.plans.md_helpers.cell(text: "SymbolIndex tier"), gunbc.plans.md_helpers.cell(text: "namespace flip gate?")]),
      alignments: [std.markdown.AlignNone, std.markdown.AlignNone, std.markdown.AlignNone],
      rows: [
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "parse_engine_hooks … 07_target_carriers, fold_lowering (Band A+B leaf)"), gunbc.plans.md_helpers.cell(text: "none"), gunbc.plans.md_helpers.cell(text: "no")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "03_normalize"), gunbc.plans.md_helpers.cell(text: "indirect (fn_decl rows need module-root decl binding)"), gunbc.plans.md_helpers.cell(text: "yes for Slice 1 rows")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "03_name_resolve"), gunbc.plans.md_helpers.cell(text: "direct fill"), gunbc.plans.md_helpers.cell(text: "yes (^migrate_when_namespace_only_resolution_lands)")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "03_resolve"), gunbc.plans.md_helpers.cell(text: "direct consumer"), gunbc.plans.md_helpers.cell(text: "yes (^migrate_when_namespace_only_resolution_lands)")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "04_infer"), gunbc.plans.md_helpers.cell(text: "transitive (ResolvedTree)"), gunbc.plans.md_helpers.cell(text: "yes")]),
      ],
    },
    gunbc.plans.md_helpers.h3(text: "4.3 Band dependency order"),
    gunbc.plans.md_helpers.p(text: "Band A: no SymbolIndex work. Band B: `fold_lowering` blocked on `^migrate_when_body_lowering_generalizes`, not namespace. Band C: `symbol_index_fill` → `03_name_resolve` → `03_resolve` → `04_infer`; gates in §4.4 must land before Band C flips."),
    gunbc.plans.md_helpers.h3(text: "4.4 Band C gates"),
    std.markdown.TableBlock {
      header: gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "gate"), gunbc.plans.md_helpers.cell(text: "deliverable"), gunbc.plans.md_helpers.cell(text: "unblocks")]),
      alignments: [std.markdown.AlignNone, std.markdown.AlignNone, std.markdown.AlignNone],
      rows: [
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "B1 fill complete"), gunbc.plans.md_helpers.cell(text: "symbol_index_fill_containment_node promoted; variant-alias witnesses green"), gunbc.plans.md_helpers.cell(text: "03_name_resolve")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "B1 lookup wired"), gunbc.plans.md_helpers.cell(text: "symbol_index_lexical_lookup on import-scoped policy"), gunbc.plans.md_helpers.cell(text: "03_resolve")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "namespace Stage A"), gunbc.plans.md_helpers.cell(text: "scope_with_fn_decl_params dissolved"), gunbc.plans.md_helpers.cell(text: "03_normalize fn_decl rows + 03_resolve")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "FLAG D"), gunbc.plans.md_helpers.cell(text: "binding-key identity re-grounding"), gunbc.plans.md_helpers.cell(text: "eval param-ref parity")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "resolve scaffold removal"), gunbc.plans.md_helpers.cell(text: "dag_fn_decl_param_binding_atoms deleted"), gunbc.plans.md_helpers.cell(text: "03_resolve emit flip")]),
      ],
    },
  ]
}

fn section_5() -> List<std.markdown.MarkdownBlock> {
  [
    gunbc.plans.md_helpers.h2(text: "5. Risks and escalation"),
    std.markdown.TableBlock {
      header: gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "risk"), gunbc.plans.md_helpers.cell(text: "signal"), gunbc.plans.md_helpers.cell(text: "action")]),
      alignments: [std.markdown.AlignNone, std.markdown.AlignNone, std.markdown.AlignNone],
      rows: [
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "Port hand-walker into SugarRule"), gunbc.plans.md_helpers.cell(text: "new SugarLowering variants mirroring body_lower_*"), gunbc.plans.md_helpers.cell(text: "hard reject")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "Dual index"), gunbc.plans.md_helpers.cell(text: "separate fill per ResolutionPolicy"), gunbc.plans.md_helpers.cell(text: "escalate — Rule 1 violation")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "Flip before Wave 1 gates"), gunbc.plans.md_helpers.cell(text: "Band C flip with namespace debt open"), gunbc.plans.md_helpers.cell(text: "defer; keep SeedRetained honest")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "Parallel census ledger"), gunbc.plans.md_helpers.cell(text: "hand-authored docs/plans md with transcribed counts"), gunbc.plans.md_helpers.cell(text: "reject — cite frontier.dag carrier")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "Probe debt"), gunbc.plans.md_helpers.cell(text: "blocker class edited without frontier_probe"), gunbc.plans.md_helpers.cell(text: "keep KnowledgeAttributed until #6464 binds")]),
      ],
    },
  ]
}

fn wave2_prep_design_body() -> List<std.markdown.MarkdownBlock> {
  concat([status_block()],
    concat(section_1(),
      concat(section_2(),
        concat(section_3(),
          concat(section_4(), section_5())))))
}

data wave2_prep_design_plan: gunbc.plan.Plan = gunbc.plan.Plan {
  slug: "wave2-prep-design",
  title: "Wave 2 prep — module-flip census, FLAG E row-fold, SymbolIndex dependency map",
  body: wave2_prep_design_body(),
  retirement: gunbc.plan.PlanRetiresWhen { condition: std.dissolution.unbound_dissolution(description: "Delete when Wave 2 Band A–C flips are underway and either (a) body_lowering_fold.dag is deleted per §3 slice 4, or (b) the frontier carrier holds execution-measured per-module probes replacing knowledge-attributed census. Surviving checklist rows migrate into gunbc.plans.v2_self_hosting or the frontier carrier; enroll generated docs/plans md at checkpoint 1 only then — never hand-author the projection.")
  }
}
