module gunbc.plans.gunb_ai_projection

import std.markdown { MarkdownBlock }
import gunbc.plan { Plan, PlanRetiresWhen, PlanIsAuthorityOnly }
import gunbc.design_ruling { project_documentation_projections_are_not_checkout_artifacts }
import std.dissolution { unbound_dissolution }
import gunbc.plans.md_helpers { h2, p, li, ul }

// THE ONE HOME for the gunb.ai projection inventory. DESIGN §3: a plan's authority
// is its `.dag` carrier; per `gunbc.design_ruling`
// `project_documentation_projections_are_not_checkout_artifacts` (2026-10-13) its
// markdown is not a checkout artifact. Rostered through
// `gunbc.plan_registry.all_plans` by `gunbc.plan_registry_batch_g`. Figures are
// never transcribed here: each carries the command that re-derives it, so a rotting
// number is a failing probe, not an unreachable fact.

fn inventory_body() -> List<MarkdownBlock> {
  [
    p(text: "**Consumer:** every layer of the gunb.ai projection (tokens, primitives, layout, content model, pages, build+deploy) — each layer cites this inventory for what exists today and where its upstream is. Surveyed 2026-10-16 from `gunb-ai/frontend` HEAD and the live site; re-run the probes in §1 and §2 before acting on any row, since the site and gunbc both move."),
    h2(text: "1. What gunb.ai serves today — and how to re-derive the figures"),
    ul(items: [
      li(text: "**The served surface is what the workflow stages.** `.github/workflows/pages.yml` `deploy-pages` stages only `index.html`, `assets/`, `CNAME` into `_site` (read that workflow; it is the authority). Pages settings: `build_type=workflow`, source `main/`, `custom_domain=gunb.ai` — re-read with `gh api repos/gunb-ai/frontend/pages`."),
      li(text: "**Byte totals are measured, never held here.** Re-derive with: `gh repo clone gunb-ai/frontend -- --depth 1 && (cd frontend && wc -c index.html CNAME assets/*)` for the published set, and `wc -c` over `assets/site.css` / `assets/cards.js` for the two large files. The live `/` was checked byte-identical to tracked `index.html` with `curl https://gunb.ai/ | diff - index.html`."),
      li(text: "**Staleness is counted, not quoted.** Site last touched at `gunb-ai/frontend` HEAD (read with `gh api repos/gunb-ai/frontend --jq .pushed_at`); gunbc drift since: `git rev-list --count --since=<that date> origin/main`."),
      li(text: "**Never-served branch content:** everything outside the paths that workflow stages (workpad.html, legacy/, docs/, PROPOSAL.md, DESIGN.md, scripts/) is tracked but excluded from `_site`; confirmed 404 at gunb.ai (`curl -o /dev/null -w '%\{http_code\}' https://gunb.ai/workpad.html` etc.). Size them with `git ls-files | grep -v -E '^(index.html|CNAME|assets/)' | xargs wc -c`."),
    ]),
    h2(text: "2. Dead weight in the published set"),
    ul(items: [
      li(text: "**The deck is LIVE; this inventory row was wrong once and the correction is recorded so it is not re-lost.** An earlier survey claimed `assets/cards.js` renders nothing on the published page, on the evidence that `initDecks()` bails when `.card-track` is missing. That inference was false: `initDecks()` queries `[data-deck]` and builds the track markup itself, so an absent `.card-track` is its OUTPUT, not a precondition it requires. Re-derive the correction: `grep -o data-deck frontend/assets/cards.js` is positive (the selector it queries), and instrumenting the published page with headless Chromium (`--dump-dom --virtual-time-budget`, a settled commit) prints a document carrying the deck cards, deck nav and receipt rows the script builds — far larger than the bytes `curl` returns, which is the observation that overturned the first claim. Consequence for the plan: the deck is not dead weight; the operator has ruled it stays (parity first); its card content — the users-system nodes, artifacts and budget numbers, hand-authored inside `cards.js` with no `.dag` home (`grep -R UsersProfile dag/` is empty) — becomes typed data in the deck layer, ordered after masthead/hero/install/footer and named as a gap until it lands. Until then the generated page emits the mount element only, which is what the served HTML itself contains."),
      li(text: "**Icon files are served but referenced by nothing published.** The 16/32px favicons, apple-touch-icon and both maskables under `assets/` have zero referrers in the staged set (`git grep -l <name> HEAD -- index.html assets/site.css assets/cards.js assets/site.webmanifest` is empty for each), while `/assets/site.webmanifest` and `/assets/favicon.png` 404 because `legacy/site.webmanifest` (never staged) points `icons[]` at `/assets/*`."),
      li(text: "**Stale config elsewhere:** `gunb-ai/gunbc` still has Pages enabled (`gh api repos/gunb-ai/gunbc/pages` shows `build_type=legacy` though the site 404s), and `gunbc.io` does not resolve — the only domain in play is `gunb.ai`."),
    ]),
    h2(text: "3. Copy has no upstream"),
    p(text: "Every visible text line on `/` — title, h1, the four tagline lines, the three value-card headings and bodies, the footer — is hand-typed HTML. Re-check any line with `grep -R '<the sentence>' dag/`; all of them are zero hits today. No page-copy content model exists in `gunbc.*`: this is the content-model layer's modelling gap, and nothing on the site may be a hand-copied second version of a fact that has a home in gunbc (DESIGN §3)."),
    h2(text: "4. What gunbc already models (consume, never rebuild)"),
    ul(items: [
      li(text: "**Marks and files:** `gunbc.design.brand_mark` (`brand_mark_svg` over `BrandMarkKind` `FaceMark`|`RobotMark`, consumed by `gunbc.site.brand` `site_brand_mark`) and `gunbc.design.brand_mark_assets` (`brand_asset_targets`, `brand_asset_encode` — byte-exact raster via `gunbc.design.brand_mark_raster`), written out by `gunbc.design.brand_mark_assets_cli` (entry `v2_cli_main`, native CLI usage `<binary> <out-dir>`, capability `Filesystem.WriteBytes`). The site's `assets/mark.svg` is a hand-authored fork of the modeled glyph — verify with `git grep -A40 '<svg' -- assets/mark.svg` against `brand_mark_svg(kind: FaceMark, …)`; re-home, do not copy."),
      li(text: "**Colour:** `gunbc.design.palette` (`Swatch \{ name, color: Srgb8 \}`, `SwatchMemberKind` Filed/Derived, `SwatchSet \{ name, provenance, members \}`, `SwatchSetProvenance` HouseAuthored/InspiredByExternal/CitedUpstream) and `gunbc.design.catalog` (`island_pastel`, `okabe_ito`, `solarized`, rosters three provenanced sets in `palette_catalog`). `assets/site.css` keeps its colour literals inside `:root` only (re-check with a brace-range scan) but its hues and names share no lineage with `design.palette` — two colour systems, which pick A below resolves by making palette the only authority."),
      li(text: "**Type and measures:** `gunbc.design.typography` maps `InterfaceText` roles to CSS decls via `interface_text_decls`; `gunbc.design.scale` owns `ScaleToken`s (`length_token`, `named_length_token`, `font_token` over typed `CssLength`/`CssFontStack`) — this is the home the site's gap-measures and gaps belong in; `gunbc.site.web_fonts` self-hosts woff2 faces whose families come from `extdeps.fonts.google_fonts` source rows (`roboto_source`, `google_sans_source`). Today's site stacks (`JetBrains Mono`, `Noto Sans`) appear as literals in `gunbc.design.scale`, `gunbc.site.moodboard`, `gunbc.site.accent_study` and `extdeps.languages.css.values` — pick that family's one home before the tokens layer; do not hard-code a fourth copy."),
      li(text: "**Theme and material:** `gunbc.design.theme` (`Theme`, `ThemeRole`, `theme_gaps`, `theme_contrast_ok`, the `night_theme`/`day_theme` data rows) and `gunbc.design.material` (`Material`, `BuildRule`, register machinery). `gunbc.site.tokens` is an L5 facade whose own note sends consumers to those two."),
      li(text: "**Markup and page shell:** `gunbc.site.markup` (`txt`, `el`, `el_class`, `el_attrs`), `gunbc.site.document` (`site_document`, `site_document_over`, `site_styles`, `SiteThemeDecls`, `site_font_stylesheet_nodes`), `gunbc.site.element.*` (button, card, chip, text, styles, …)."),
      li(text: "**Brand in the head:** `gunbc.site.brand` (`site_brand_mark`, `site_brand_link`, `site_favicon_source`, `site_favicon_path`, `site_favicon_type`) is already consumed by the workspace site: `gunbc.roadmap.roadmap_serve` routes `site_favicon_path` through `SiteFaviconHandler` and renders `serve_text_response` from `site_favicon_source()`. That is the precedent for a generated site's favicon."),
      li(text: "**Review-site precedent:** `gunbc.site.accent_study` and `gunbc.site.moodboard` render option sets to HTML and are auditioned on srv1 (serve with `python3 -m http.server <port> --bind <its tailnet address>`, screenshot with the playwright headless chromium there; the ssh target and address come from the local ssh config, not from this document). srv1 does not share this worktree — generated output is rsynced there. `gunbc run <module> --function <fn> --arg name=value` is the invocation; positional argv is NativeCliDriver-only."),
    ]),
    h2(text: "5. Piece to home, or gap"),
    ul(items: [
      li(text: "Masthead mark, favicons, touch/maskable PNGs → **re-home** to `gunbc.design.brand_mark` + `gunbc.design.brand_mark_assets` (fixing the 404 manifest paths on the way)."),
      li(text: "Colours → **gap resolved by pick A**: `design.palette` gains the site's four hues as named swatches (see §6)."),
      li(text: "Type scale, spacing, radius, measures → **home exists, use it**: `gunbc.design.scale` `ScaleToken`s (as `gunbc.site.element.tokens` already does for radius/heights via `length_token`/`named_length_token`); the **gap** is only that the public site's own measure/gap register rows do not exist yet — declare them as `ScaleToken`s, do not hand-write CSS custom properties."),
      li(text: "Page shell, markup primitives, font loading → **consume** `gunbc.site.document`, `gunbc.site.markup`, `gunbc.site.element.*`, `gunbc.site.web_fonts`."),
      li(text: "Copy, links, install snippet → **gap**: typed content model with a named upstream per fact; links carry liveness checks."),
      li(text: "Deck → **drop or re-model from a real instrument**; parity cannot mean reproducing dead weight (see §2)."),
      li(text: "Never-served branch content (workpad, legacy, docs, scripts) → **retire with the repo**."),
      li(text: "Build and publish → **gap**: no site-build module exists (`gunbc.site.hosting`/`gunbc.site.build` are absent); the deploy CI workflow needs explicit operator sign-off (closed job roster)."),
    ]),
    h2(text: "6. Operator decisions (open)"),
    ul(items: [
      li(text: "**Colour provenance — PICKED A (swift-badger-498, 2026-10-16):** `gunbc.design.palette` gains the site's four hues (warm, moss, brass, clay ramps) as named swatches; swatch names describe the colour, not the use; `site.css` tokens derive from swatches with no literals. Values may move in the redesign; the structure is what lands now."),
      li(text: "**Deck fate** — drop the dead deck, or rebuild it from a real instrument. Open."),
      li(text: "**Copy upstream** — which instrument answers the page's claims, vs fixed operator copy. Open."),
      li(text: "**Pages target** — frontend stays the Pages repo with gunbc pushing `_site`, or publish from gunbc and retire frontend. Outward-facing; nothing goes live without an explicit ask. Open."),
      li(text: "**Deploy CI workflow** — job roster is closed; explicit sign-off required. Open."),
    ]),
    h2(text: "7. Next"),
    p(text: "Layer contracts (tokens, primitives, layout, content model, pages, build+deploy) sized to this inventory; then the tokens layer renders 2–4 options to the srv1 review site for an operator pick before the next layer. Every layer ships a witness or control that renders it and checks a property going red when the layer breaks (DESIGN §5); a typecheck or a grep is not a witness."),
  ]
}

data gunb_ai_projection_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly { ruling: project_documentation_projections_are_not_checkout_artifacts },
  slug: "gunb-ai-projection-inventory",
  title: "Plan — gunb.ai as a projection of gunbc: pre-modelling inventory",
  body: inventory_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "Delete this inventory when gunb.ai is generated wholly from gunbc .dag models — every page, asset, style token and copy string projected by a gunbc entry point, the hand-maintained gunb-ai/frontend source deleted, and a green witness renders the site and fails on a missing asset, dangling link or unknown token — at which point the inventory of what-was and the home-or-gap table are redundant.") }
}
