module gunbc.plans.census_scoped_run

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetiresWhen, PlanIsAuthorityOnly }
import std.markdown { MarkdownBlock, MarkdownTableRow, CodeBlock, TableBlock, AlignNone }
import gunbc.plans.md_helpers { h2, p, li, ul, cell, row }
import gunbc.design_ruling { project_documentation_projections_are_not_checkout_artifacts }

fn code(text: String) -> MarkdownBlock { CodeBlock { code: text } }

fn table2(header: MarkdownTableRow, rows: List<MarkdownTableRow>) -> MarkdownBlock {
  TableBlock { header: header, alignments: [AlignNone, AlignNone], rows: rows }
}

fn r2(a: String, b: String) -> MarkdownTableRow { row(cells: [cell(text: a), cell(text: b)]) }

fn section_0_status() -> List<MarkdownBlock> {
  [
    p(text: "**Status:** design for the census lane's first delivery: census improvement #1 (a scoped run), the run record that #3 (a diff between runs) reads, and #2 (source locations) where it touches them. **Consumer:** whoever implements the scoped census route and its diff. **Authority for every judgement about a change:** `DESIGN.md`. Every claim names the module and symbol it rests on (DESIGN §3, *cite the symbol, not the position*). The types and controls described here are declared in `v2.compiler.module_acquisition` and pinned by `v2.test.claim.census_scoped_acquisition`. This plan states why they have that shape, and deletes itself when the route they serve is landed (dissolution trigger below)."),
  ]
}

fn section_1_why() -> List<MarkdownBlock> {
  [
    h2(text: "1. Why the census reads a population today"),
    p(text: "`v2.compiler.compile` `native_lane_census_read` states the rule: a census reports what is wrong with every member, so it cannot be driven by the acquirer, whose first refusal refuses the whole acquisition (`v2.compiler.module_acquisition` `acquisition_loop` returns `AcquisitionRefused`). The subject closure (`v2.compiler.compile` `native_census_subject_closure`) is therefore computed after the whole-corpus ingest, from the import edges of accepted trees, and only annotates roots. Every question about native-seven's closure pays for the whole corpus."),
    p(text: "The rule is right about the failure it prevents: a truncated population reported as complete. It is wrong that reading everything is the only way to prevent it."),
  ]
}

fn section_2_acquisition() -> List<MarkdownBlock> {
  [
    h2(text: "2. Acquisition that records a block instead of stopping"),
    p(text: "There is one acquisition authority, `v2.compiler.module_acquisition`, and a second loop over the same `acquisition_lookup` and `acquisition_verdict_step`. `acquisition_loop` is unchanged: it is the compiler's door, and any refusal refuses. `acquire_census_closure_of` records a refusal local to one member or one edge and continues with the rest of the frontier. A refusal local to neither (grammar unprepared, entry underivable) still refuses."),
    code(text: "type CensusAcquisition\n  = CensusAcquisitionClosed  { entries, modules, reads }                // every request followed\n  | CensusAcquisitionBlocked { entries, modules, blocked: non-empty CensusBlock list, reads }\n  | CensusAcquisitionRefused { refusal }\n\ntype CensusBlock\n  = CensusMemberBlock { module, refusal, content, host_directory, requesters }\n  | CensusEdgeBlock   { refusal }"),
    p(text: "**A blocked member is observed once, with every requester.** The census loop keeps, per attempted member, its terminal refusal, the bytes the lookup's read returned, and every request that reached it. A diamond onto one malformed member yields one block with two requesters: not two reads, not two rows. The member is then marked known, so later requests reach it through the lookup's known-member shortcut. That shortcut runs after the lookup's cross-tree check, so sharing the observation never shares an edge's permission. A requester whose tree may not import the member is still denied after another requester reached it legally, and the other way round."),
    p(text: "**The refusal is carried whole. Its arm is its meaning, and the census adds no second classification.**"),
    table2(
      header: r2("arm", "what it establishes"),
      rows: [
        r2("`AcquisitionMemberRefused`", "the member's front end refused; its outgoing requests are unobserved"),
        r2("`AcquisitionMemberSitesUnreadable`", "the front end may have passed; reference discovery is incomplete. Not a front-end-stage refusal"),
        r2("`AcquisitionUnknownModule` (import, member or entry)", "a stated requirement names no module; no target or descendants are invented"),
        r2("`AcquisitionLookupRefused` carrying `ReferenceCrossTreeDenied`", "this edge is forbidden: not probed through, not routed around, target not marked bad"),
        r2("`AcquisitionLookupRefused` carrying another `ReferenceLookup` cause", "that cause's own meaning (unreadable file, module line missing or disagreeing)"),
        r2("`AcquisitionTreeUnbound`", "the invocation lacks a root binding; not evidence about repository source")
      ]
    ),
    p(text: "A qualified reference that names no module still requests nothing (`acquisition_unknown_step`), and the continuing loop does not turn it into a missing-import block. Behind a member block, whatever that member would have requested is **unobserved**, not absent. Only the Blocked arm can say so, and a blocked population is never reported as a closed one."),
  ]
}

fn section_3_ingest() -> List<MarkdownBlock> {
  [
    h2(text: "3. The census reads acquisition's bytes"),
    p(text: "The scoped population joins the census as `census_acquisition_ingest`: the admitted members' witnesses (`acquisition_ingest`), then each blocked member's own read, once. Both are built by one witness shape, `acquisition_read_witness`. It is never fed through `read_population`, which probes the filesystem again. A file edited between acquisition and census would then make the membership and the stage results describe different bytes. An edge block read nothing and enters nothing; it is reported from the acquisition. The whole-corpus run keeps its `read_population` door. Downstream of the ingest the census pipeline is unchanged: resolve, infer, cause grouping. Only the population differs."),
  ]
}

fn section_4_membership() -> List<MarkdownBlock> {
  [
    h2(text: "4. Closure membership has one authority"),
    p(text: "In a scoped run, \"in the subject closure\" is the acquired set. `native_census_subject_closure`'s import-only walk is not consulted: it misses the qualified-reference edges the acquirer follows, so two closure definitions would be a §3 fork. The whole-corpus annotation keeps its import-only walk, labelled as such, until it can be re-derived from the same acquisition (follow-on)."),
    p(text: "The subject module is derived from the label by one function, `v2.compiler.compile` `native_census_subject_module`. It uses the target-pattern authority, and the native lane's module-to-package correspondence (`gunbc.witness.v2_native_route` `native_route_module_package_text`) read backwards. The whole-corpus annotation uses the same function. Only a package label names one module; a single target or a subtree names none, and the census says so."),
    p(text: "**Fan-out is labelled with the relation it measured.** `native_census_closure_index` builds both graph directions from `normalized_tree_import_bindings`. When A reaches B only through a qualified reference, the scoped population includes B, but the reverse graph can still omit A from B's fan-out. The first delivery therefore reports fan-out as *import-edge reachability over the observed population, coverage incomplete*. It is not demand fan-out, and not evidence that two repairs are independent. Follow-on (preferred): feed the reachability fold the acquisition's observed request-to-selected-target relation."),
  ]
}

fn section_5_entry() -> List<MarkdownBlock> {
  [
    h2(text: "5. Subject and entry point"),
    ul(items: [
      li(text: "The subject is a target label bound by the instrument. The first subject is native-seven (`native_census_subject_label`). Later subjects are compiler entry closures, each as a further binding, never a changed meaning of an existing target."),
      li(text: "New driver verb, because it is a distinct acquisition request: `census-scoped <label> <source-root>...`. The label operand is the transport of the instrument's bound subject. The run record names the subject observed, and the consumer checks it against the binding."),
      li(text: "The instrument target is `//gunbc/instruments:v2-native-census-scoped`, in the existing `V2NativeCensusProducer` family (`gunbc.target_binding`); it is not a parallel producer."),
      li(text: "Preparation consumes the existing verified native-product reuse route; there is no census-specific cache. Cold and eligible-warm whole-command costs are reported separately. A compiler-source repair legitimately changes the product identity, so warm reuse cannot promise to skip preparation.")
    ]),
  ]
}

fn section_6_record() -> List<MarkdownBlock> {
  [
    h2(text: "6. Run record (the part of #5 that #3 needs)"),
    ul(items: [
      li(text: "It maps to `gunbc.repository_census_observation` (population, subject revision, method run). It is not a new census-observation type."),
      li(text: "Identity is the inputs actually read (captured content digests, with the revision recorded as claimed) and the executed compiler artifact (its verified preparation receipt), not only a source-closure digest."),
      li(text: "Contents: the subject; the scope (whole-corpus or scoped); the population and its digest; the acquisition status (closed or blocked, with the blocks); per module and stage the outcome: passed, refused (reason, and location once #2 lands), unobserved behind an earlier stage, or unobserved behind a block; the existing `NativeCensusCompleteness` facts; completion."),
      li(text: "Publication: an incomplete, run-identified record is written before preparation, and the completed one replaces it atomically. Without an observed terminal event the run reads incomplete, never a fabricated cause. An output failure cannot leave an older file readable as this run.")
    ]),
  ]
}

fn section_7_diff() -> List<MarkdownBlock> {
  [
    h2(text: "7. Diff semantics (#3)"),
    p(text: "The comparison grain for the first delivery is the module-and-stage obligation, keeping both runs' diagnostics. Root-level continuity is claimed only where an identity relation supports it; ambiguous matches stay unmatched. Different revisions are recorded, not refused, since comparing them is the point. Different subjects are refused. When the closure digest changes, the diff names the added and removed members and compares the common population."),
    table2(
      header: r2("before to after", "reported as"),
      rows: [
        r2("resolve refused, then resolve passed and infer refused", "cleared, and newly exposed"),
        r2("infer refused, then resolve refused", "infer now unobserved behind resolve (not cleared)"),
        r2("member present, then absent from a Closed after-run", "scope changed, member named"),
        r2("member present, then absent from a Blocked after-run", "unobserved, not scope changed"),
        r2("member newly visible after a repair, and refusing", "newly observed, not a regression"),
        r2("member unobserved (blocked or stopped run)", "incomplete evidence"),
        r2("only location or occurrence id moved", "location update, not churn")
      ]
    ),
  ]
}

fn section_8_controls() -> List<MarkdownBlock> {
  [
    h2(text: "8. Controls and acceptance"),
    p(text: "Landed with the acquisition (`v2.test.claim.census_scoped_acquisition`, `v2.test.claim.census_scoped_subject`, over the planted closure in `fixtures/census_scoped_acquisition`, which lies outside every corpus root):"),
    ul(items: [
      li(text: "acquisition around a member block and an edge block; every block named; nothing behind a block or outside the closure acquired; a closed case; the compiler's door still refusing the same closure;"),
      li(text: "a diamond onto one malformed member: one block, two requesters, the sibling observed;"),
      li(text: "a denied edge beside a permitted use of the same target, in both orders;"),
      li(text: "the census ingest holding the acquired and blocked reads, each once, and nothing behind a block;"),
      li(text: "the subject module derived from the label, and single-target and subtree labels naming none.")
    ]),
    p(text: "To add with the route: qualified-reference-only reachability, location movement, earlier-stage masking, and interruption before terminal publication."),
    p(text: "**Acceptance:** one real repair measured before and after through `//gunbc/instruments:v2-native-census-scoped`, producing a located comparison that names the cleared blocker and the next observation, plus the roadmap revisions that evidence justifies. Wall-time and peak figures are read from that instrument and `//gunbc/instruments:v2-native-census`, never restated here."),
  ]
}

fn census_scoped_run_body() -> List<MarkdownBlock> {
  concat(section_0_status(),
  concat(section_1_why(),
  concat(section_2_acquisition(),
  concat(section_3_ingest(),
  concat(section_4_membership(),
  concat(section_5_entry(),
  concat(section_6_record(),
  concat(section_7_diff(), section_8_controls()))))))))
}

data census_scoped_run_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly { ruling: project_documentation_projections_are_not_checkout_artifacts },
  slug: "census-scoped-run",
  title: "Scoped census run — acquisition around blocks, a run record, an honest diff",
  body: census_scoped_run_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "Delete this plan when census improvements #1-#3 are landed: //gunbc/instruments:v2-native-census-scoped runs the census over a subject's acquired closure, its run record is published as section 6 states, the diff reports the section 7 rows, and one real repair has been measured before and after through it. From then on v2.compiler.module_acquisition's census types, the instrument binding and their claims are the authority for what a scoped census means, and this plan would be a second statement of it.") }
}
