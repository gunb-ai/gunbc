module gunbc.plans.joint_incompatibility_claim_join

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetirement, PlanRetiresWhen, PlanIsAuthorityOnly }
import std.markdown { MarkdownBlock }
import gunbc.plans.md_helpers { p, quote }
import gunbc.design_ruling { project_documentation_projections_are_not_checkout_artifacts }

fn status_block() -> MarkdownBlock {
  quote(blocks: [
    p(text: "**Status: SCOPE RECORD, with checkpoint 1 (the instrument) LANDED beside it and nothing else built.** Answers the four questions the 2026-09-11 brief asked before any mechanism may be proposed: the cut, the cost, the placement, the refusal. The manager ruled 2026-09-11: checkpoint 1 yes; checkpoint 2 stops at the permission row and prefers the dashboard reader; the within-tree field case is an already-filed row's trigger, not a checkpoint; the operator picks the rest in §7. This record is deliberately NOT a rung drop and NOT a restatement of `gunbc.plans.ci_merge_freshness`: that record owns the class's ceiling and already carries instance 1 as its §7; this one scopes a mitigation beneath that ceiling and cites the ceiling rather than re-arguing it."),
  ])
}

fn section_1() -> List<MarkdownBlock> {
  [
    p(text: "**Goal/ceiling:** warn about individually green, textually disjoint PRs whose composition breaks declarations. gunbc.plans.ci_merge_freshness owns the whole stale-green class; gunbc.merge_admission.receipt_is_admissible requires current base-tree and gate-roster hashes but was held at GatingComputedDeferred by the failure-class prerequisites. This advisory is a partial interim mitigation, not a rung drop or substitute. Private #49 × #50 has no name signature and is outside every join."),
  ]
}

fn section_2() -> List<MarkdownBlock> {
  [
    p(text: "**Cut:** use declaration_index.import_surface_has, the declared ∪ variants ∪ reexported surface at (module,name), base-minus-head. Join added claims in each channel against a sibling’s removed surface, excluding claims the remover retires. Deletions, renames, moves, narrowed variants and dropped re-exports share this rule. ImportMember first; CitedSymbol and RosteredRow use the index’s other claim channels. Public specimens are #10933 × #10934 (DurableOriginRead/DisposableCacheRead variants), #10865 × the NJ census (grain_admits_single_cabinet rename), and #10925 × #10923 (mutation_status_is_commit_ambiguous moved to extdeps.transports.rest). The dropped re-export has an instrument control, not an observed specimen."),
    p(text: "**Residuals:** cross-PR fields have a derivable decl_fields removal set but referenced over-collects binders/labels, so that join yields candidates, not findings. Parameter lists/arity/signatures are absent from this index and require the type wall; freshness without name changes requires the ceiling. Import coverage must be reported only as the ImportMemberAbsent subclass, never the whole class."),
    p(text: "**Separate owner:** within-tree required-field changes are a selection obligation on gunbc.recurring_failure_mode.witness_that_fails_to_compile_is_absent_rather_than_red, not another checkpoint. #10979 closed the zero-field construction escape; #11050 exposed unreachable WorkflowRun construction sites. Compile every module whose referenced or authored_type_references names a declaration with removed/changed fields. Over-collection costs execution, not false findings, because compilation is the oracle. The row’s trigger was widened beyond claim roots; keep that ownership."),
  ]
}

fn section_3() -> List<MarkdownBlock> {
  [
    p(text: "**Computation:** namespace_baseline.base_records reconstructs untouched records plus touched merge-base paths, establishing absence from ls-tree, never read failure. The 2026-09-19 ruling removed wave admission; reconstruction survives for planning/joint_claim_join. Set differences and intersections cost summed delta size, not pairwise compilation. Sibling retrieval is the remaining cost: recompute from fetched refs/pull/N/head and merge bases rather than invent an artifact store with unmodeled staleness."),
    p(text: "**Instrument:** v1_compiler.bin.joint_claim_join (seed-growth owner gunbc.joint_claim_join_seed_growth), invoked as joint_claim_join <since>..<tip> [--window-seconds N], uses first-parent subjects and base_records/diff_sides. Report subjects, with_removals, with_added_claims, window_seconds, raw_candidates and findings. Retrospective claims must still be live at removal: exclude retirement by the remover and by intervening changes. An intervening surface re-add remains an explicitly unhandled widening; open sibling sets have no merged-between subject. Reproduce the original range 6a54695f6c7^..f078c59b0b4 at the default three-day window; precision/recall belong to the invocation, not copied totals. [Original false-positive analysis](https://github.com/gunb-ai/gunbc/blob/3e5a0f1f0dbc62e0d3589df44146858d3147c9e9/dag/gunbc/plans/joint_incompatibility_claim_join.dag) records #10443/#10617 and #10863/#10888, which motivated the intervening-retirement exclusion."),
  ]
}

fn section_4() -> List<MarkdownBlock> {
  [
    p(text: "**Reader ruling:** checkpoint 2 is the dashboard readiness reader, outside this repository, using its open heads/merge bases and checkout. Cache one delta per observed head and rejoin whenever any sibling changes. A CI rider recomputes siblings per push, misses later-opened siblings and needs pull-requests:read on a required job merely for an advisory. Stop at that permission boundary; the operator owns that trade. Do not add a RequiredCiPhase or required job; required_gate_bankruptcy closes that roster. No CI rider is built by this scope."),
    p(text: "If separately authorized, a ParsePhase rider could reuse ingestion and emit a run-log/::warning:: finding under contents:read without changing the phase verdict. Its push-time freshness residual must remain visible. Blocking is refused as a first move; it requires measured instrument precision over a stated window and the ceiling still deferred. If receipt_is_admissible gates first, do not build blocking and dissolve the consumer."),
  ]
}

fn section_5() -> List<MarkdownBlock> {
  [
    p(text: "**Finding contract:** one hit per removed surface entry × claiming site. removed names (module,name) and declared/variants/reexported origin; claimed_by names sibling PR/head SHA, claiming module, in_declaration and SourceLocation(rel_path,offset); channel is ImportMember, CitedSymbol or RosteredRow. Match DeclarationIntegrityFinding’s location so the advisory and later compiler failure identify the same claim. Never emit only “conflicts with an open PR.”"),
    p(text: "**Outcomes:** Hit is advisory; Clear reports open-PR and joined-claim denominators; NotEvaluated reports its cause when open set, sibling head or base is unavailable. API/ref/read failure is ignorance, never an empty clear set. Only listing evidence establishes absence."),
  ]
}

fn section_6() -> List<MarkdownBlock> {
  [
    p(text: "**Private boundary:** the audited strategy.private_witness_workflow built the public seed and copied private dag into public/private_overlay/dag, outside DAG_PARSE_SWEEP_ROOTS, without a parse-phase DeclarationIndex. Neither private-only nor public→private surface changes are covered. Admit the overlay as an extra source root before deriving its whole import set as another join subject. Authority: gunbc.guarantee_stall.joint_claim_join_private_corpus_unindexed_stall, AwaitsOneGrounding on that source-root capability; coordinate with the private workflow/compiler lane (#46). Merge versus squash does not change the composition hazard. These are dated workflow observations, not current deployment claims."),
  ]
}

fn section_7() -> List<MarkdownBlock> {
  [
    p(text: "**Validate/order:** checkpoint 1 instrument is the recorded landing; nothing on the merge path executes it. Controls cover variant deletion, rename/move and re-export loss; remover and intervening retirement exclusions; ordered-pair window; and a claim already present at the claimer’s base. A restoration must make each exclusion control RED. Checkpoint 2 routes the same typed finding to the dashboard; checkpoint 3 needs measured precision plus continued ceiling deferral; private extension waits for its typed stall. Within-tree field selection stays with its existing recurring-failure row. Refuse new required jobs, unapproved required-job permission changes, unmeasured blocking, pairwise compilation and claims of full-class coverage."),
  ]
}

fn joint_incompatibility_claim_join_body() -> List<MarkdownBlock> {
  concat([status_block()],
    concat(section_1(),
      concat(section_2(),
        concat(section_3(),
          concat(section_4(),
            concat(section_5(),
              concat(section_6(), section_7())))))))
}

data joint_incompatibility_claim_join_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly { ruling: project_documentation_projections_are_not_checkout_artifacts },
  slug: "joint-incompatibility-claim-join",
  title: "[SCOPE] Jointly-incompatible open PRs — a claim-channel × surface join over the declaration index, advisory-first",
  body: joint_incompatibility_claim_join_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "Delete this record when either holds: the merge-time freshness requirement of gunbc.plans.ci_merge_freshness §3 is in force as a witnessed property (receipt_is_admissible gating), at which point every join scoped here is redundant and any landed rider is deleted with this record; or the checkpoint-2 consumer has landed and the instrument has measured a window, at which point this scope is superseded by the rider's own carrier and the plan is redundant.")
  }
}
