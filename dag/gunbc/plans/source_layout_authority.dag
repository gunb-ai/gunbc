module gunbc.plans.source_layout_authority

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetiresWhen, PlanIsAuthorityOnly }
import gunbc.design_ruling { project_documentation_projections_are_not_checkout_artifacts }
import std.markdown { MarkdownBlock, MarkdownListItem, MarkdownTableRow, TableBlock, AlignNone }
import gunbc.plans.md_helpers { h2, p, li, ul, cell, row }
import std.types { String, NonEmptyStr }
import gunbc.source_layout_rulings {
  SourceLayoutRuling, SourceLayoutDecision,
  source_layout_rulings, source_layout_decisions,
  source_layout_decider, source_layout_ruled_on,
  source_layout_ruling_label, source_layout_decision_subject_label,
}

// THE PLAN FOR ONE STORAGE RULE (the name-to-path mapping), a name-only compiler, and the end of
// whole-tree ingestion. Section 3 is not authored here: the rulings and the decisions recorded with
// them are the typed rows of gunbc.source_layout_rulings, and this module only renders them, so the
// page cannot disagree with the carrier a later reader cites by symbol. This page carries no
// measurement; every population it reasons about is re-derived by the C0 generator or by the layout
// check of section 4.4, not transcribed (DESIGN section 6).

// ---- section 3, rendered from the carrier ---------------------------------------------------------

fn ruling_item(r: SourceLayoutRuling) -> MarkdownListItem {
  li(text: concat(concat(concat("**", source_layout_ruling_label(id: r.id) as String), ".** "), r.ruling as String))
}

fn decision_row(d: SourceLayoutDecision) -> MarkdownTableRow {
  row(cells: [
    cell(text: source_layout_decision_subject_label(subject: d.subject) as String),
    cell(text: d.decision as String),
  ])
}

fn rulings_heading_text() -> String {
  concat(
    concat(concat(concat("3. Rulings (", source_layout_decider as String), ", "), source_layout_ruled_on as String),
    ")"
  )
}

fn source_layout_rulings_section() -> List<MarkdownBlock> {
  [
    h2(text: rulings_heading_text()),
    ul(items: source_layout_rulings |> map(r => ruling_item(r: r))),
    p(text: "Decisions recorded with the rulings (no open decisions remain):"),
    TableBlock {
      header: row(cells: [cell(text: "Subject"), cell(text: "Decision")]),
      alignments: [AlignNone, AlignNone],
      rows: source_layout_decisions |> map(d => decision_row(d: d)),
    },
  ]
}

// ---- sections 1 and 2 -----------------------------------------------------------------------------

fn source_layout_authority_opening() -> List<MarkdownBlock> {
  [
    p(text: "**Goal:** one declared module-name→storage rule, demand-only v2 acquisition and separate whole-population checks. Typed gunbc.source_layout_rulings below owns R1–R11 and closed decisions; plan governance/registration owns this carrier’s role. Current namespace and cross-tree rulings govern historical implementation details."),
    p(text: "**Method:** module a.b.c ↔ <root(a)>/b/c.dag through v2.compiler.source_authority. The compiler handles module names; only storage handles paths. Module nodes precede file realization; SourceRef carries path/root/content hash at host boundaries. Namespace position is declared, never inferred from arbitrary file placement. The module header remains a checked projection for the seed until it retires. This replaces the bottom-up storage mapping from #6856/#6882; the deleted July designs survive at dbf227cb7f4a and 628ebe126bec (#9635 cleanup). Their Markdown/Rust write-back phases remain out of scope."),
    p(text: "**Evidence:** the GUNBC_MEMORY_COMPOSITION=1 receipt at 7792ce6f013 separated whole-tree token/index/head storage from the unmeasured closure working set; compare with runner_slot_desired, not copied totals. #13674’s seed token-pool release is independent. Whole-tree module-header discovery, bare-name reverse lookup and out-of-closure parse checking motivated this cut. The required native resolver, C0 generator and layout check must rederive populations; historical text scans are not binding evidence. v1 compatibility accepts references v2 refuses; repairing every R11 closure is required regardless of layout. v1 resolution itself is unchanged."),
  ]
}

// ---- sections 4 to 7 and the appendix -------------------------------------------------------------

fn source_layout_authority_design_and_plan() -> List<MarkdownBlock> {
  [
    p(text: "**Storage contract:** generic layout/rule/module_file/namespace enumeration/check live in v2.compiler.source_authority over SourceRootRef plus relative path. Import-free gunbc.source_layout supplies repository namespace/root policy at the entry boundary; namespace parents are derived and rows carry no authored/generated kind. CLI binds roots through its filesystem handler, with no new Rust harness. Lookup: name→logical root/path→bound host root→exact read→matching module header→SourceRef. Generatedness remains solely gunbc.generated_artifact_registry’s fact; layout does not load that registry. v2.test.claim.generated_dag_artifacts_at_rule_position separately checks committed/generated equality and declared rule position, as mitigation only under v1_required_lanes_withdrawn."),
    p(text: "**Refusals:** longest-prefix probing yields ModuleFilePresent | ModuleFileAbsent | ModuleFileRefused; only Absent tries a shorter prefix. Unreadable/wrong-kind/transport failures refuse; no prefix is unknown-module. cross_tree_import_admitted executes before reads and, under the 2026-10-25 cross_tree_admission_is_namespace_membership ruling, admits either direction between declared namespaces; undeclared endpoints give CrossTreeNamespaceUndeclared. Old dag→v2-directional refusal examples are superseded. The native witnesses-job layout check reads headers and refuses UndeclaredNamespace, NotAtRulePosition, ModuleLineMissing and DuplicateModule including case-fold collisions; no exception roster."),
    p(text: "**Demand closure:** entry→parse→requested names→module_file→parse until closed; files read must equal requested closure. Bare unresolved names refuse with spelling/local-module/visible-import diagnostics, never repository search. v2.compiler.lexical_scope supplies one shared pure fold: decided parameters/lets/loop carriers/module values make dotted heads projections; unbound heads are module candidates; pattern/import heads needing the unavailable symbol index are undecided and request nothing. Guessing must not read an unrelated same-named file. Unrequested required modules subsequently refuse at resolution. MatchArmScopeExitEdge/bind_carries_arm_scope_exit drops the exited arm’s atoms for the rest of a let-match while retaining enclosing arms; the rest can request a module whose spelling was an arm atom."),
    p(text: "**One branch/one PR:** C0–C4 are internal stages, never independently mergeable repository states. Final head contains layout, binding repairs, all v2 demand routes and deletion of replaced acquisition. Main receives refusing checks, not a migration move map. Current replacement-migration-doctrine governs sequencing."),
    p(text: "**C0:** typed rulings/decisions and plan_governance registration; DESIGN §3 amendment through gunbc.design_document; generic layout/exact-read model before consumers; target gunbc.source_layout; deterministic v2.workflow.source_reference_repoint generator; census every R11 compile closure. Refuse the entire sweep for two sources→one target, occupied nonmoving target, case-fold collision, existing target module identity or an unclassified occurrence. Classify typed module references separately from real paths; .dag-looking strings are not automatically references. The storage rule adds no import-direction law; acyclicity remains structural."),
    p(text: "**C1:** regenerate one sweep after each main merge: imports/qualified names/DeclarationRef/labels/typed identities/prose citations, file moves, module-based load-bearing references, NATIVE_COMPILE_ENTRY/REPORT_ENTRY and seed constants, renamed Rust mirrors, workflows/.gitattributes and all registered artifacts. No required CI comparison is implied after v1_required_lanes_withdrawn. Census and coordinate gunbc-private and other external citations. Resolve sweep conflicts by regeneration, not hand edits; seed-only path/mirror edits use v1_seed_standing."),
    p(text: "**C2:** real v2 resolution over the full R11 population, with zero unbound/ambiguous results; qualify/bind according to current namespace authority. Delete floor_unimported_bare_provider_debt_roster, its retired gate and unimported_bare_provider_gate only when native enforcement replaces them. R11 may cover most of the tree; that does not authorize narrowing."),
    p(text: "**C3:** CLI emit, native lane and program_assembly callers take roots/entry names and acquire by request. Delete parse-all closure_ingest, native_lane_closure_modules, compile-time source_root_read recursion, module_storage_bindings_for_source_roots/host manifest after enumerating consumers, and failure-path reverse lookup. native_lane_source_facts keeps its name over acquired modules; obsolete import/malformed-import facts go. Before deletion, compare old/new closures for both real entries within the branch; no fallback/selector survives."),
    p(text: "**Producer census:** SourceRootIngest may remain an in-memory acquired-closure carrier. Classify every non-test producer: verified module_acquisition.acquisition_ingest for CLI/native; explicit population native_lane_census_ingest/read_population, module_graph.load_reference_derived_pool/source_root_ingest_from_source_refs and namespace_xl2_rehearsal_census.xl2_stripped_ingest; direct_rust_door_fixture/claim fixtures. compile_door_ledger.closure_ingest is an unconsumed audit route at the recorded head, not an accepted second door; recheck its callers. No production entry may walk roots into an independently assembled ingest or bypass acquisition into v2_cli_run."),
    p(text: "**C4 witnesses:** all governed files at rule positions; malformed out-of-closure modules fail explicit population parsing but change neither entry compile verdict nor reads; every R11 route resolves; no whole-tree v2 index even on refusal. Longest-present wins, absent falls shorter, unreadable refuses, no prefix refuses, case-fold/header mismatch refuses. Cross-tree controls test declared membership in both directions and undeclared rejection. Dotted binder projections emit identically with absent/malformed/valid same-named files; genuine module references observe malformed files. module_acquisition claims cover match-bound heads and let-match scope exits. Both seed self-host emissions match modulo rename map, including ancestor-chain effects; seed/mirrors/native closures build; all generators are idempotent; deleted producers have no callers and every ingest producer is classified."),
    p(text: "**Move procedure:** same folder→rename to rule position; rule folder below source→move down; source folder below rule→include structure in module name (R6), except repeated x/x.dag→move up. Different branches require confirmed group decisions, never guesses: manual claims→v2.test.claim.manual; tools under gunbc/instruments→gunbc.instruments (R10); long/execution/emit/parse claim groups retain their corresponding namespace; product/printed_chassis and product move to their declared homes; dag/test groups join test siblings. C0 derives the complete table and refuses unclassified groups. **Boundaries:** no v1 resolver change, non-.dag migration, module-header deletion or July write-back implementation. Source-layout rulings, namespace-resolution §10/§13, namespace-cut parse-then-derive, demand_engine_program and replacement-migration-doctrine remain the authorities."),
  ]
}

fn source_layout_authority_body() -> List<MarkdownBlock> {
  concat(
    concat(source_layout_authority_opening(), source_layout_rulings_section()),
    source_layout_authority_design_and_plan()
  )
}

data source_layout_authority_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly { ruling: project_documentation_projections_are_not_checkout_artifacts },
  slug: "source-layout-authority",
  title: "Source layout authority: one storage rule, a name-only compiler, and the end of whole-tree ingestion",
  body: source_layout_authority_body(),
  retirement: PlanRetiresWhen {
    condition: unbound_dissolution(description: "Retire this plan when the cutover it describes has landed on main (every governed `.dag` file at its rule position, repaired v2 bindings, demand acquisition on every v2 compile route, every superseded acquisition route deleted) and the storage rule and layout are carried by `gunbc.source_layout` and `v2.compiler.source_authority`, so that a module name maps to its file through one declared authority and this page is no longer the reference for how.")
  },
}
