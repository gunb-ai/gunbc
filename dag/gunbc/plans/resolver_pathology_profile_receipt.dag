module gunbc.plans.resolver_pathology_profile_receipt

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetirement, PlanRetiresWhen, PlanIsAuthorityOnly }
import std.markdown { MarkdownBlock, CodeBlock, TableBlock, AlignNone }
import gunbc.plans.md_helpers { h2, h3, p, li, ul, cell, row, hr }

fn resolver_pathology_profile_receipt_body() -> List<MarkdownBlock> {
  [
    p(text: "**Status:** measurement doc only (no resolver refactor). Timestamped profiling receipt for ROADMAP §1 *profile the 518s resolve*. DESIGN.md remains authority."),
    p(text: "**Owner:** vivid-carp-798. This is a **historical measurement receipt** — the numbers below are the finding; they are not re-derived on any cadence. The `scripts/profile-cold-resolve.sh` harness that produced them was deleted 2026-07-23 with the rest of `scripts/`, so the receipt no longer ships a runnable entrypoint. Re-measuring is a fresh measurement against today's resolver, not a replay of this one; the durable fix remains substrate-emitted resolve timings (gunbc bash-emit #5828)."),
    hr(),
    h2(text: "1. How these numbers were taken"),
    p(text: "Cold resolve with `GUNBC_RESOLVED_GRAPH_CACHE_DIR` unset, per-entry resolve wall clock over the corpus, reported as top-N offenders plus an A/B on the `budget_roster_completeness_test` vs `fold_list_generic_instantiation` pair. Recorded here so the method survives the harness."),
    hr(),
    h2(text: "2. Measured top resolve offenders (warm typed_module_cache)"),
    TableBlock {
      header: row(cells: [cell(text: "Rank"), cell(text: "ms"), cell(text: "items"), cell(text: "entry")]),
      alignments: [AlignNone, AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "1"), cell(text: "9410"), cell(text: "1973"), cell(text: "v2/compiler/manual/dag_import_block_lexeme_stamp_test.dag")]),
        row(cells: [cell(text: "2"), cell(text: "6164"), cell(text: "2594"), cell(text: "v2/test/claim/emit_host_gate/target_coverage_completeness_test.dag")]),
        row(cells: [cell(text: "12"), cell(text: "1556"), cell(text: "2412"), cell(text: "complexity_gate/budget_roster_completeness_test.dag")]),
      ]
    },
    hr(),
    h2(text: "3. Pathological pair"),
    p(text: "**Pathological:** `budget_roster_completeness_test.dag` — cold resolve 5513ms, 2412 registry items. **Structural twin:** `fold_list_generic_instantiation.dag` — 159ms, 226 items. **Ratio:** 34.7× wall (operator ~450× targets typecheck/item work; see prose receipt)."),
    hr(),
    h2(text: "4. Hypothesis"),
    p(text: "**`reconcile_with_typed_cache` / `typecheck_module`** — fn-typed `List<LensSubjectComplexityBudgetRow>` roster rows pulling source-bridged `v2.compiler.*` modules. Not `resolve_modules` wiring (twins share 57-module closure at ~5.5s cold)."),
    hr(),
    h2(text: "5. Routed-entry work hidden behind resolve"),
    TableBlock {
      header: row(cells: [cell(text: "Observation"), cell(text: "Producer"), cell(text: "Subject"), cell(text: "Cost location"), cell(text: "What it foreclosed")]),
      alignments: [AlignNone, AlignNone, AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [
          cell(text: "One quiet-host, exit-zero end-to-end observation found pre-evaluation resolve dominating the query's own work. The historical figures are deliberately not copied into this row: no committed producer can re-derive them."),
          cell(text: "A one-off timed run by session `quick-cat-355` of the routed query that enumerated its own work across the then-open pull-request population. The exact argv and timing carrier were not retained in git, and the session is no longer addressable; this is therefore historical evidence, not a presently runnable benchmark."),
          cell(text: "One routed `.dag` entry whose query enumerated repository work across the live open-pull-request population. Resolve completed before any query evaluation, so the observation priced the fixed entry cost separately from the query's git/GitHub work."),
          cell(text: "Pre-evaluation entry resolution. The replacement preflight shows the remaining loader floor lives in the bare/reference fixpoint's pool census; it deliberately does not substitute an import-only walk, because that is a narrower population."),
          cell(text: "A lane could not economically ask whether a changed repository path intersected a routed entry's retained closure before landing. `claim_batch --print-entry-closure` is the surviving replacement producer: it emits the exact retained path population and a terminal `state=complete` receipt before typed resolution or evaluation."),
        ])
      ]
    },
    p(text: "**Next measurement rung:** a committed entry point that runs the full routed query and returns, in one receipt, total wall duration, pre-evaluation resolve duration, and query-own duration against a named subject revision and host condition. Until that exists, this row preserves only the measured obstruction and the replacement producer; it does not present the historical timing as re-derivable current performance."),
  ]
}

data resolver_pathology_profile_receipt_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly { ruling: "operator ruling 2026-08-28 (stability cleanup, PR 9635): the committed markdown projection for this stale plan is deleted; the .dag carrier remains the authority, per the a295e17415 precedent." },
  slug: "resolver-pathology-profile-receipt",
  title: "Resolver pathology — cold-resolve profile receipt",
  body: resolver_pathology_profile_receipt_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "Delete when resolve-phase timings are substrate-emitted and ROADMAP 1-resolver-pathology closes with a fix PR.")
  }
}
