module gunbc.plans.md_helpers

import std.markdown {
  MarkdownBlock, MarkdownListItem, MarkdownTaskItem,
  MarkdownTableCell, MarkdownTableRow,
  HeadingBlock, ParagraphBlock, UnorderedListBlock, OrderedListBlock,
  TaskListBlock, BlockquoteBlock,
  TextInline, H1, H2, H3, CheckboxState, Unchecked, ThematicBreak,
  MarkdownInline, SymbolRefInline,
}
import std.decl_ref { CitedSymbol }

fn h1(text: String) -> MarkdownBlock { HeadingBlock { level: H1, inlines: [TextInline { text: text }] } }
fn h2(text: String) -> MarkdownBlock { HeadingBlock { level: H2, inlines: [TextInline { text: text }] } }
fn h3(text: String) -> MarkdownBlock { HeadingBlock { level: H3, inlines: [TextInline { text: text }] } }
fn p(text: String) -> MarkdownBlock { ParagraphBlock { inlines: [TextInline { text: text }] } }
fn li(text: String) -> MarkdownListItem { MarkdownListItem { blocks: [p(text: text)] } }
fn li_blocks(blocks: List<MarkdownBlock>) -> MarkdownListItem { MarkdownListItem { blocks: blocks } }
fn ul(items: List<MarkdownListItem>) -> MarkdownBlock { UnorderedListBlock { items: items } }
fn ol(items: List<MarkdownListItem>) -> MarkdownBlock { OrderedListBlock { items: items } }
fn cell(text: String) -> MarkdownTableCell { MarkdownTableCell { inlines: [TextInline { text: text }] } }
fn row(cells: List<MarkdownTableCell>) -> MarkdownTableRow { MarkdownTableRow { cells: cells } }
fn quote(blocks: List<MarkdownBlock>) -> MarkdownBlock { BlockquoteBlock { blocks: blocks } }
fn tasks(items: List<MarkdownTaskItem>) -> MarkdownBlock { TaskListBlock { items: items } }
fn todo(text: String) -> MarkdownTaskItem { MarkdownTaskItem { state: Unchecked, blocks: [p(text: text)] } }
fn task(state: CheckboxState, text: String) -> MarkdownTaskItem { MarkdownTaskItem { state: state, blocks: [p(text: text)] } }
fn hr() -> MarkdownBlock { ThematicBreak }

// A PARAGRAPH, ITEM OR CELL THAT CITES A SYMBOL carries it as a SymbolRefInline beside its text, so the
// citation is a typed reference the decl-ref census resolves rather than characters in a string.
fn tx(text: String) -> MarkdownInline { TextInline { text: text } }
fn cite(symbol: CitedSymbol) -> MarkdownInline { SymbolRefInline { symbol: symbol } }
fn pi(inlines: List<MarkdownInline>) -> MarkdownBlock { ParagraphBlock { inlines: inlines } }
fn li_inlines(inlines: List<MarkdownInline>) -> MarkdownListItem { MarkdownListItem { blocks: [pi(inlines: inlines)] } }
fn cell_inlines(inlines: List<MarkdownInline>) -> MarkdownTableCell { MarkdownTableCell { inlines: inlines } }
