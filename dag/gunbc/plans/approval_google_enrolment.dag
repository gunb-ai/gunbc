module gunbc.plans.approval_google_enrolment

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetiresWhen, PlanIsAuthorityOnly }
import std.markdown { MarkdownBlock, TableBlock, AlignNone }
import gunbc.plans.md_helpers { h2, p, li, ul, ol, cell, row }
import gunbc.design_ruling { project_documentation_projections_are_not_checkout_artifacts }

fn approval_google_enrolment_body() -> List<MarkdownBlock> {
  [
    p(text: "Status: landed. The model, both cutovers (server and approve-ios) and census rows 1 to 8 landed in #14890 (`cb6548946213`); #14921 was closed as superseded. Work item `adhoc-144ab890-3ef`, authored 2026-10-23. Ruling: `gunbc.design_ruling` `approval_enrolment_is_google_sign_in`. Model: `gunbc.auth.approval_google_enrolment`, witness `test.claim.approval_google_enrolment_witness`. The cutover is the two child changes in section 4."),
    h2(text: "1. What enrolment becomes"),
    p(text: "The phone creates its Secure-Enclave decision key (Face ID, `approval_decision_key_access_policy`) and its App Attest key, builds `google_enrolment_transcript` from them, and signs in with Google using `nonce = google_enrolment_nonce(transcript)`. It attests over the same transcript and makes one POST: the ID token, both public keys and the attestation. The server's answer is total: enrolled, already enrolled (the same answer), or a typed refusal. After that, every approval is Face ID plus a signature by the decision key, the redemption path as it is today. App states: signed-out, enrolled, revoked. A failed or unanswered sign-in returns the app to signed-out, and the only exit is to sign in again."),
    h2(text: "2. Each question, and the existing home that answers it"),
    TableBlock {
      header: row(cells: [cell(text: "Question"), cell(text: "Answer"), cell(text: "Home")]),
      alignments: [AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "Who may enrol"), cell(text: "A Google token from the gunb.ai Workspace (`hd`) with a verified email, whose email is on the approver roster. Being a Workspace member is not enough on its own. The roster is a different fact from `approval_operator_login`, the tailnet login that the identity-header redemption still matches."), cell(text: "`gunbc.auth.google_workspace_login` `gunb_ai_hosted_domain`; `gunbc.auth.approval_decision_store` `approval_google_approver_emails`")]),
        row(cells: [cell(text: "How the token is verified"), cell(text: "`admit_google_approver` takes the UNVERIFIED claims and the signature realization's verdict and runs `verify_oidc_id_token` itself under `approval_google_enrolment_policy`: the Google issuer, the iOS client id as the admitted audience (read from the registration, never passed in), the Workspace domain, and the derived nonce. Because the generic verdict admits an audience that merely intersects and ignores `azp`, enrolment then requires the audience to be exactly the iOS client and `azp`, when present, to be the iOS client too. The fold is caller-sealed (`admit_callers`): whoever may call it may assert a verified signature. Child A's route is the production caller it admits next."), cell(text: "`extdeps.auth.oidc`; `gunbc.auth.oidc_id_token_verification` `oidc_id_token_signature_verify`; `gunbc.auth.tracker_web_oauth_client` `approve_ios_oauth_client`")]),
        row(cells: [cell(text: "What binds the token to the keys"), cell(text: "The nonce is the hash of the transcript (protocol, platform, decision key, attest key id). The server rebuilds it from the submitted keys, so a token replayed beside other keys refuses at the verdict's nonce check. The attestation must be over the same transcript and name the same attest key. No nonce store exists, because the nonce is derived rather than issued."), cell(text: "`gunbc.auth.approval_google_enrolment` `google_enrolment_transcript`, `google_enrolment_nonce`")]),
        row(cells: [cell(text: "Account continuity"), cell(text: "Before any write, the route creates the email's subject pin with the presented `sub` (create-once), and on a lost compare-and-set it rereads the pin. `join_subject_pin` mints `SubjectPinnedToPresentedSubject` only when the pin is this `sub`, and the enrolment stage requires that carrier. Two accounts racing under one address therefore cannot both enrol: the loser rereads the winner's `sub` and refuses."), cell(text: "`SubjectPinCreateOrRead`, `join_subject_pin`, `SubjectPinnedToPresentedSubject`")]),
        row(cells: [cell(text: "Idempotency"), cell(text: "`enrollment_id = hash(sub, decision key)`. Resending the same sign-in with the same key replays the stored enrolment: no write, no notification. A replay is admitted only when the stored record joins the request on every field it determines (id, sub, email, decision key, platform, attest key); otherwise it refuses with `GoogleEnrolmentStoredMismatch` naming the field. Resending is the whole recovery story, which is why the handshake and SubmissionUnknown have nothing left to do."), cell(text: "`google_enrollment_id`, `stored_enrolment_disagreement`, `GoogleEnrolmentReplays`")]),
        row(cells: [cell(text: "Revocation"), cell(text: "One compare-and-set write from active to revoked on the enrolment slot, served by the BROKER (the sole store writer), authenticated by the Tailscale identity against `approval_operator_login` and, for revoke, `approval_write_admission` (clever-eagle-893 decision of 2026-10-23, superseding the dashboard-session reading). The list and revoke routes refuse in production until peer attribution lands, because nothing yet mints `IdentityHeaderTrustEstablished`. A revoked key cannot re-enrol; the phone makes a new key and signs in again, which notifies."), cell(text: "`GoogleEnrolmentRevoked`, `deciding_google_enrollment`; route is child A")]),
        row(cells: [cell(text: "New-device notification"), cell(text: "Sent only when a new enrolment is written (`new_device_notice`), through the existing approval-notification publisher, never for a replay."), cell(text: "`gunbc.auth.approval_request_submission` `publish_notification`")]),
        row(cells: [cell(text: "The iOS client"), cell(text: "An iOS-type OAuth client in project gunbc-tracker, bundle ID ai.gunb.approve, with no secret. It was created by hand in the console, and that is recorded as a manual-step row."), cell(text: "`approve_ios_oauth_client`, `approve_ios_oauth_client_intervention`; `gunbc.auth.privileged_effect_census`")]),
      ],
    },
    p(text: "The existing enrolment handshake (`gunbc.auth.approval_enrolment_handshake`, Sept 30) has no production consumer. Every one of its states is keyed by the enrolment code: one storage slot per code, a status check authenticated by the code, and a pending/confirm step that exists only to recover a lost answer to a POST that spends a one-time code. With an idempotent POST and no code, none of that has a premise left, so the whole module is deleted (row 6 below). Nothing in it is carried forward."),
    h2(text: "3. Disposition census (consumers named; none of these roots is on the required gate)"),
    p(text: "Nothing in `gunbc.emitted_subject_build_gate` `emitted_subject_build_rows` imports any of these, so deleting them cannot break the required job. Every consumer is listed by name below, and the child changes must account for each one."),
    TableBlock {
      header: row(cells: [cell(text: "Removed"), cell(text: "Consumers outside the file"), cell(text: "Disposition")]),
      alignments: [AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "1. `gunbc.auth.approval_device_enrolment_code_issue` (the issue verb and its SSH placement)"), cell(text: "`gunbc.fleet.fleet_converge_workflow` (mode `ApprovalDeviceEnrolmentCodeIssue`, `fleet_converge_approval_device_enrolment_code_issue_step`); `gunbc.fleet.fleet_workflow_steps` `fleet_subject_mutation_group_approval_device_store`; `gunbc.ci.ci_spec` `gunbc_ci_approval_device_enrolment_code_issue_target` and `_invoke`; `gunbc.endpoint_authority_replacement_cut` row `enrolment_code_issue_ssh_target`; `gunbc.auth.approval_broker_endpoint` (references the issue verb); generated `.github/workflows/fleet-converge.yml`; `test.claim.approval_device_enrolment_code_witness`; `test.claim.workflow_dispatch_input_witness` (one clause)"), cell(text: "Delete the module, the mode arm, the step, the mutation group, both ci_spec rows and the endpoint row, and remove the issue-verb reference from `approval_broker_endpoint`. Regenerate fleet-converge.yml. Drop the clause from the dispatch-input witness.")]),
        row(cells: [cell(text: "2. `gunbc.auth.approval_device_enrolment_code` (minting and ntfy code delivery)"), cell(text: "`gunbc.auth.approval_request_submission` (`read_publisher_token` and `publish_notification` admit_callers); `gunbc.auth.approval_ntfy_access_readback` admit_callers; `gunbc.ci.ci_layer_roots` two exclusion reasons and their patterns; `v2.workflow.local_repo_wet_terminal` and `v2.workflow.floor_route_gap` rows; `test.claim.approval_device_enrolment_code_witness`, `_wet_witness`; `test.claim.approval_ntfy_access_readback_witness`, `_wet_witness`; comment sites in `live_deploy.emit`, `approval_broker_placement`, `approval_ntfy_runtime_observe`, `approval_device_routes`, `fleet_converge_workflow`"), cell(text: "Delete it. The shared publisher survives; remove only the two enrolment decl_refs. Remove the layer-root and src/v2 workflow rows together with the witnesses they name.")]),
        row(cells: [cell(text: "3. The code-keyed enrolment store in `gunbc.auth.approval_device_redemption`: `EnrolmentChallenge`, `EnrolmentSlotStanding`, `enrolment_admission`, `EnrolmentRefusal`, `issue_enrolment_code`, `commit_enrolment`, `observe_enrolment_slot`, `observe_enrollment`, `code_of_enrollment_id`, `IssuedCodeRecord` and the record-kind rows"), cell(text: "`gunbc.auth.approval_device_routes` (enrol, redeem, readback and push all read the slot through `observe_enrollment`); `gunbc.auth.approval_device_redemption_fixtures`; `test.claim.approval_device_redemption_witness`; `test.claim.approval_device_routes_witness`; prose in `ci_layer_roots`, `fleet_workflow_steps`, `recurring_failure_mode.wet_witness_premise_read_from_the_runner_it_happens_to_land_on`"), cell(text: "Replace. The store is re-keyed by `google_enrollment_id`, plus one pin slot per email. Redeem, readback and push take a `GoogleDeviceEnrollment` in place of `VerifiedDeviceEnrollment`, a delete-first cut with no adapter between the two. `approval_device_store_root` and its managed directory survive as the root. Existing code-path enrolments on srv1 stop deciding at the cutover, and the operator re-enrols by signing in.")]),
        row(cells: [cell(text: "4. Code-bearing wire in `gunbc.auth.approval_device_wire`: `enrolment_transcript(code, ...)`, `enrollment_id_for_code`, `EnrolmentRequest.code`, `EnrolmentRefusalWire` (7 arms), `EnrolmentGrant`"), cell(text: "`approval_device_redemption`, `approval_device_routes`, `approval_device_redemption_fixtures` (and `dag/test/fixture/approval_device_redemption/vectors.json`), `gunbc.approve_ios_swift_protocol`, `gunbc.approve_ios_swift_wire`, `gunbc.approve_ios_swift_protocol_vector_tests`, `gunbc.approve_ios_enrolment_machine`, `gunbc.approve_ios_swift_enrolment_machine`; witnesses `approval_device_wire_witness`, `wire_spelling_injective_witness`, `wire_shape_declaration_pairing_witness`; generated Swift `Protocol`, `Wire`, `DeviceKeys`, `AppState`, `ProtocolVectorTests`; prose in a recurring_failure_mode and a rung_drop row"), cell(text: "Replace with a Google enrolment request (`id_token`, keys, attestation) and a refusal wire derived from `GoogleEnrolmentRefusal`. Regenerate the vectors and the Swift. Leave historical prose rows as they are; they cite a past state.")]),
        row(cells: [cell(text: "5. `approval_device_routes` enrol route (`device_enrol_response`, `enrolment_refusal_*`, `attestation_for_request`)"), cell(text: "`gunbc.auth.approval_broker_serve` dispatch `DeviceEnrolHandler` and path `approval_device_enrol_path`; `test.claim.approval_device_routes_witness`, `_wet_witness`"), cell(text: "Replace in place: the same handler slot serves the Google enrol POST. Add list and revoke handlers.")]),
        row(cells: [cell(text: "6. `gunbc.auth.approval_enrolment_handshake` (whole module)"), cell(text: "`test.claim.approval_enrolment_handshake_witness`; an admit_callers row in `extdeps.apple.app_attest`; a comment in `approve_ios_enrolment_machine`"), cell(text: "Delete it, its witness and the admit_callers row.")]),
        row(cells: [cell(text: "7. The app's enrolment machine: `gunbc.approve_ios_enrolment_machine`, `gunbc.approve_ios_swift_enrolment_machine` (phases `unenrolled`, `prepared`, `submissionUnknown`, `enrolled`, `keyInvalidated`, `revoked`), hand-written Swift code entry (`Views.swift` code TextField, `AppState.prepare(code:)`, `submit`, `resolveUnknownSubmission`, `retrySubmission`), `EnrolmentState.swift` `PreparedEnrolment.code`"), cell(text: "`gunbc.census_closure_frontier` `approve_ios_enrolment_state_generator_frontier_rows`; `gunbc.generated_artifact` and `generated_artifact_emit` (two Swift artifacts); `gunbc.guarantee_stall.enrolment_commit_evidence_remains_caller_authored_stall`; witnesses `approve_ios_enrolment_machine_witness`, `_persist_order_witness`"), cell(text: "Replace with a generated three-state machine (signed-out, enrolled, revoked, plus key-invalidated, which reads as signed-out). Drop the SubmissionUnknown phase and the resolve and retry paths. Re-scope or retire the stall row by what it still claims. There is no QR code anywhere today.")]),
        row(cells: [cell(text: "8. ntfy pieces used only for code delivery: `gunbc.auth.approval_ntfy_access_readback`, `gunbc.auth.approval_ntfy_runtime_observe`"), cell(text: "`gunbc.live_deploy.release_locus` (runtime-observe entry, function and run-as); `gunbc.live_deploy.emit` `approval_broker_ntfy_runtime_observe_operation_at` (a per-release sudoers grant); `test.claim.live_deploy.approval_broker_helper_grant`; the two readback witnesses; prose in `approval_ntfy_deployment`, `release_locus`"), cell(text: "Delete both, with the release_locus rows and the sudoers grant. This changes the broker's deploy output, which is wise-bat-528's deploy to run. The publisher, `approval_ntfy_deployment` and approval notifications survive.")]),
        row(cells: [cell(text: "9. PR #14851 (24-hour code window)"), cell(text: "none"), cell(text: "Already closed.")]),
      ],
    },
    h2(text: "4. Children"),
    p(text: "The brief proposed a third child just for deletion. That diverges from DESIGN section 3 (delete-first; the replacement never coexists with the old path), so each deletion belongs to the change that replaces it. The server change and the app change are each one transition."),
    ol(items: [
      li(text: "**A. Server cutover.** Homes: `approval_device_routes`, `approval_device_wire`, `approval_device_redemption`, `approval_broker_serve`, plus this model. Build the Google enrol route (JWKS verify through `oidc_id_token_signature_verify` against the broker's own cache directory, attestation, the admission fold, compare-and-set writes of slot and pin, notification), and the list and revoke routes. Re-key redeem, readback and push to `GoogleDeviceEnrollment`. Delete census rows 1 to 6 and 8. Coordinate with quiet-crane-175, which is fixing the broker's JSON body marker; don't touch that marker. Deploy is wise-bat-528's."),
      li(text: "**B. App cutover.** Homes: `gunbc.approve_ios_enrolment_machine` (rewritten as the three-state generator), `approve_ios_swift_*`, `apps/approve-ios`. Native Google sign-in through GoogleSignIn-iOS at version 9.0.0 or later (the first release that takes a caller-supplied nonce), for client `approve_ios_oauth_client_id`, with NO `serverClientID`, so the token's audience is the iOS client alone. Uses the transcript nonce, the reversed-client-id URL scheme in `project.yml`, and one idempotent POST. Delete census row 7 and the Swift code entry. Depends on A's wire."),
    ]),
  ]
}

data approval_google_enrolment_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly { ruling: project_documentation_projections_are_not_checkout_artifacts },
  slug: "approval-google-enrolment",
  title: "Approval-app enrolment by Google sign-in",
  body: approval_google_enrolment_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "Retires when the approval broker admits enrolments only through gunbc.auth.approval_google_enrolment, census rows 1 to 8 have no surviving declaration, and the app's generated enrolment machine has no code or SubmissionUnknown state.") }
}
