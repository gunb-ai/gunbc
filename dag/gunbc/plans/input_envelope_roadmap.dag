module gunbc.plans.input_envelope_roadmap

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetirement, PlanRetiresWhen, PlanIsAuthorityOnly }
import std.markdown { MarkdownBlock }
import gunbc.plans.md_helpers { p }
import gunbc.design_ruling { project_documentation_projections_are_not_checkout_artifacts }

fn input_envelope_roadmap_body() -> List<MarkdownBlock> {
  [
    p(text: "Goal: refuse work whose input size is unknown, exceeds a declared ceiling, or contains an undeclared axis; make the scheduler consume the same input_admitted contract as WorkDemand."),
    p(text: "Method: retain InputSizeAxis (WitnessCount, SourceNodeCount, CorpusNodeCount), count-valued InputBound, and BoundedInput versus EnvelopeUnknown. input_admitted returns RefusedUndeclared for unknown envelopes and RefusedOverEnvelope for exceeded or missing axes; only fully covered inputs are Admitted. Existing unknown demands remain explicit."),
    p(text: "Remaining P2, requiring operator sign-off: derive witness ceilings from gunbc.ci.ci_layer_roots witness_discovery_scan_dirs and node ceilings from ci_floor_measurement; replace the Scaffold values in gunbc_ci_corpus_envelope, then wire runtime admission. P1 required the field but did not establish that runtime gate. Its 2000/500000/5000000 ceilings were operating-point choices, never measurements."),
    p(text: "Validate with input_envelope_admission: at-limit acceptance, over-limit refusal, undeclared-axis refusal, EnvelopeUnknown refusal, and a control that fails when refusal is removed. Retirement additionally requires every WorkDemand to carry a real bound or an explicit explanation for its unknown envelope."),
  ]
}

data input_envelope_roadmap_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly { ruling: project_documentation_projections_are_not_checkout_artifacts },
  slug: "input-envelope-roadmap",
  title: "InputEnvelope: bounded input declaration for WorkDemand + CI corpus instance",
  body: input_envelope_roadmap_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "Delete when P2 ceiling derivation lands and gunbc_ci_corpus_envelope carries derived values, input_admitted is wired as a runtime gate, and all WorkDemand instances carry either a real BoundedInput or an explicit escalation comment explaining why they are EnvelopeUnknown.")
  }
}
