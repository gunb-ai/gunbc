module gunbc.plans.planning_consolidation

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetiresWhen, PlanIsAuthorityOnly }
import std.markdown { MarkdownBlock }
import gunbc.markdown_helpers { h2, p, li, ul, ol, quote }

fn planning_consolidation_body() -> List<MarkdownBlock> {
  [
    quote(blocks: [
      p(text: "**Motivation (operator, 2026-11-11):** streamline and consolidate planning so it is quick and easy to see WHAT to work on and WHERE it lives -- by deforking as much as possible ahead of doing the actual work. The test for every piece of planning machinery is the one in `gunbc.design_argument::consumption`: something reads it over an executing route, or it is dangling. The operator does not consume most of this information today, so most of it is stranded; consolidation starts by removing what nothing reads, not by renaming it."),
      p(text: "**Grounding:** `gunbc.design_argument::planning_has_one_home` (#16285) for where a plan lives; `gunbc.design_argument::single_authority` and `gunbc.design_argument::atomic_concern` for what counts as one concern; `gunbc.design_argument::replacement_migration` for how a second home is removed."),
    ]),
    h2(text: "1. Operator rulings, 2026-11-11 (session bright-ibex-807)"),
    ul(items: [
      li(text: "**The name stays `gunbc.plans`.** Supersedes the 2026-11-10 D1 rename to designs; D6 (the name collision with DESIGN.md) is moot."),
      li(text: "**Scheduling is cut.** No time periods and no scheduling layer. Supersedes D1's \"the roadmap schedules work items into time periods\"; D5 is moot. What to work on is chosen by the operator day to day; scheduling is a function of constraints (labor, resources) that do not bind yet. At most, a plan or work item later carries an optional qualitative order or start/end date column, added only when something reads it."),
      li(text: "**Execution is anchored on fabric dispatch** (`product.fabric`, `gunbc.compute`, `gunbc.fabric`; half working today). The ctrl session dashboard is a side path: integrating the two is useful, but it is not the destination."),
      li(text: "**Display:** the operator consumes this DAG from the ctrl repository in the meantime. The gunbc daily workspace page survives in some form, consolidated and probably renamed; that is decided later, not here."),
    ]),
    h2(text: "2. The DAG, from why we plan to what executes"),
    p(text: "Each stage names its home and its reader. Measured at origin/main 2026-11-11 (`gunbc.roadmap` plus `gunbc.plans`: 158 files, about 103,000 lines; import graph from every `module`/`import` line under dag/ and src/v2/; srv1 unit and HTTP state read live the same day)."),
    ol(items: [
      li(text: "**Why we plan (policy):** `gunbc.design_argument::planning_has_one_home` and `gunbc.design_ruling`. Read by every session through DESIGN.md."),
      li(text: "**Plan (intent and reasoning):** `gunbc.plans.*`, registered in `gunbc.plan_registry`. Read on demand through `gunbc.plan_documentation`, which nothing imports (run by hand)."),
      li(text: "**Work item (the unit that is claimed, done, accepted or retired):** THREE homes today, nothing joins them: (A) item lists written as prose inside each plan -- no reader; (B) `gunbc.roadmap.roadmap_authority` node rows over `gunbc.roadmap.roadmap_model` `RoadmapNode` (6,595 lines, 272 nodes, 155 edges) -- read by the page and the belt; (C) ctrl dashboard work items -- the one with a live reader today (they spawn sessions)."),
      li(text: "**State:** `gunbc.roadmap.roadmap_event_log` (claimed, progress, retired, accepted after #16189). One home already."),
      li(text: "**Selection (what is ready):** readiness, frontier, spawner, launch admission. Beside them, scheduling remnants with no production importer at all: `roadmap_forecast` (1,104 lines), `roadmap_checkpoint_plan`, `roadmap_closing_contract_authoring`."),
      li(text: "**Execution:** fabric -- work request (`gunbc.compute.work_request`) to selection (`product.fabric.selection`) to grant, cell or seat (`gunbc.fabric.*`, `product.capacity`) to run, recorded in `gunbc.fabric.fabric_event_log`. The roadmap belt (`roadmap_belt_actuate`, 16,521 lines; with dispatch, attempt and session modules about 35,000 lines) is half an adapter into fabric (it imports `work_request`, `attempt_lifecycle`, `compute_seat_ensure`, `fabric_event_log_host`) and half its own machinery beside it. Live on srv1 2026-11-11: no belt tick timer exists; the belt exit and credential-recovery units are failed; discovery and publication are dead."),
      li(text: "**Display:** for now a projection of plans, work items and state that ctrl reads. Today the daily workspace page (`roadmap_page`, `roadmap_presentation`, styles, components; about 13,000 lines) is served by `gunbc-roadmap.service` and answers 503: the served binary cannot decode the `retired` event kind already in the log."),
    ]),
    h2(text: "3. Forks and stranded machinery the DAG exposes"),
    ul(items: [
      li(text: "**R1, work items have more than one home** (stage 3). The deforking that matters most: one record, one owner."),
      li(text: "**R2, the belt beside fabric** (stage 6). Candidates to check, not yet findings: `roadmap_attempt_state_store`, `roadmap_attempt_metering`, `roadmap_attempt_exit_spool`, `roadmap_attempt_worktree_claim`, `roadmap_dispatch_actuator` and the session-slot modules, each against the fabric module that may own the same fact (allocation store, event log, attempt lifecycle, quota). Whatever fabric owns, the belt consumes rather than restates; what remains is the thin edge from work item to work request and from fabric outcome back to work-item state."),
      li(text: "**R3, two event logs:** the roadmap's (work-item state) and fabric's (execution). Legitimate if they record different facts; a fork wherever attempt state is written to both."),
      li(text: "**R4, scheduling remnants:** cut by the 2026-11-11 ruling; each is removed after a consumer check by name."),
      li(text: "**R5, eighteen roadmap/plans modules with no production importer.** Some are roots a unit or timer runs (`roadmap_serve`, `roadmap_ingress`, `roadmap_belt_tick_cli`); the rest are reached only by tests, and each is a deletion candidate under the consumption claim."),
    ]),
    h2(text: "4. Phases"),
    ol(items: [
      li(text: "**Q0, done (2026-11-10):** prose citations of deleted plans removed; `node_carrier_clean` and `pointer_resolves` deleted (no production consumer); `md_helpers` and `demand_restatement_follow_up` moved out of the plans tree. The 16 plan-naming typed carriers on roadmap nodes (13 resolve, 3 dangle to the deleted `durable_work_handoff.dag`) are untouched pending the operator's live-or-stale ruling on those nodes."),
      li(text: "**Q1, the belt against fabric (R2, R3):** for each belt, dispatch, attempt and session module, name the fabric module that owns the same fact and whether the belt consumes it or restates it. Bounded `git grep` and source reading per module; the output is the real redundancy list, with a disposition per module (consume fabric, keep as the edge, or delete as unread)."),
      li(text: "**Q2, one work-item record (R1):** decide which home owns the record (D7) and collapse the others into it; typed references replace `Pointer { path: String }` so a renamed or deleted target fails loudly. One live plan migrates end to end as the specimen (D4)."),
      li(text: "**Q3, delete the stranded (R4, R5):** each module with no reader is removed after its consumers are enumerated by name; the scheduling remnants go first."),
      li(text: "**Q4, the display ctrl reads:** one projection of plans, work items and state that the ctrl repository consumes; the gunbc page's survival and name are decided here."),
      li(text: "**Q5, debt (D2):** the debt ledgers (rung drops, recurring failure modes, integration concerns, dissolution conditions) become one obligation-with-trigger record; each old ledger is deleted as it empties."),
    ]),
    h2(text: "5. Decisions"),
    ul(items: [
      li(text: "**D1, RULED 2026-11-10, amended 2026-11-11:** the 2026-11-10 ruling (plans become designs; the roadmap schedules work items into time periods) is superseded on both counts by section 1. What survives of it: a plan owns its intent, reasoning and its work items, and the dependency runs one way, from plans to whatever consumes them."),
      li(text: "**D2, RULED 2026-11-10:** the debt ledgers are consolidated soon, as one concept (Q5)."),
      li(text: "**D3, RULED 2026-11-10, not yet:** the control plane does not require a dashboard work item to name the plan work item it executes."),
      li(text: "**D4, open:** which plan migrates first (Q2). Proposed: `gunbc.plans.read_set_convergence`, whose phases are already discrete."),
      li(text: "**D5, moot 2026-11-11:** scheduling is cut."),
      li(text: "**D6, moot 2026-11-11:** the name stays `gunbc.plans`."),
      li(text: "**D7, open:** where the one work-item record lives -- inside the plan that owns the work, or in a shared record type the plan imports -- after Q1 shows what execution needs from it."),
      li(text: "**D8, open, after Q1:** what of the belt survives as the edge into fabric, and what is deleted."),
    ]),
  ]
}

data planning_consolidation_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly,
  slug: "planning-consolidation",
  title: "Planning consolidation: one DAG from why we plan to what executes, deforked",
  body: planning_consolidation_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "Every stage of section 2 has one home and a named reader, every fork in section 3 is collapsed or deleted, the open decisions are ruled, and this plan has itself been migrated into the ruled work-item home or deleted.") },
}
