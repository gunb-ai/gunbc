module gunbc.plans.planning_consolidation

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetiresWhen, PlanIsAuthorityOnly }
import std.markdown { MarkdownBlock }
import gunbc.markdown_helpers { h2, p, li, ul, ol, quote }

fn planning_consolidation_body() -> List<MarkdownBlock> {
  [
    quote(blocks: [
      p(text: "**Plan owns intent and decomposition. Work items own executable definitions. Item events own coordination and acceptance. Fabric owns execution. Workspace is a derived projection. No other planning authority exists.**"),
      p(text: "**Motivation (operator, 2026-11-11):** streamline and consolidate planning so it is quick and easy to see WHAT to work on and WHERE it lives, by deforking as much as possible ahead of doing the actual work. The test for every piece of planning machinery is `gunbc.design_argument::consumption`: something reads it over an executing route, or it is dangling. Most of this information is not consumed today, so most of it is stranded; consolidation starts by removing what nothing reads, not by renaming it."),
      p(text: "**Grounding:** `gunbc.design_argument::planning_has_one_home`, `gunbc.design_argument::single_authority`, `gunbc.design_argument::atomic_concern`, `gunbc.design_argument::replacement_migration`."),
    ]),
    h2(text: "1. Operator rulings and direction, 2026-11-11 (session bright-ibex-807)"),
    ul(items: [
      li(text: "**The name stays `gunbc.plans`.** Supersedes the 2026-11-10 D1 rename to designs; D6 is moot."),
      li(text: "**Scheduling is cut completely.** No Schedule type, no time-period records, no forecast state, no manually synchronized today list. What to work on today is a selection the operator makes in the workspace, not a durable fact. An order or date field appears only when a named consumer decides something from it. Supersedes D1's scheduling; D5 is moot."),
      li(text: "**Execution is anchored on fabric dispatch** (`product.fabric`, `gunbc.compute`, `gunbc.fabric`; half working today). The ctrl session dashboard is a side path: integrating the two is useful, but it is not the destination."),
      li(text: "**Display:** the operator consumes this from the ctrl repository in the meantime; the gunbc page may survive. Both are renderers of one projection (D10), and neither owns a work item."),
      li(text: "**The model, and the decisions D7 to D11 below, are the operator's direction of 2026-11-11** (a review the operator brought into the session and adopted)."),
    ]),
    h2(text: "2. The model"),
    p(text: "`Plan = Argument + WorkGraph`; `WorkGraph = WorkItems + ContainsEdges + DependencyEdges`; `WorkItem = Deliverable + AcceptanceContract + ExecutionIntent`; `ItemState = fold(ItemEvents)`; `ExecutionState = fold(FabricEvents)`; `Workspace = projection(Plans, WorkItems, ItemState, ExecutionState)`. In one sentence: plans explain and declare work, item events govern work, fabric executes work, and the workspace projects all three."),
    ol(items: [
      li(text: "**DESIGN and rulings** constrain everything below (`gunbc.design_argument`, `gunbc.design_ruling`)."),
      li(text: "**Plan:** objective, rationale, constraints and design evidence (references to measurements), plus the plan's ONE typed work graph: `items: List<WorkItem>` and `dependencies: List<WorkItemDependency>`. Its prose carries argument and evidence, never a phase list, item status, acceptance criteria or completion."),
      li(text: "**Work item:** `id: WorkItemId` (globally minted, so cross-plan dependencies can name it), `parent_item: WorkItemId?` (absent means top level), `deliverable`, `in_scope`, `out_of_scope`, `acceptance: AcceptanceContract { red_control, handback }`, `execution: ExecutionIntent?`. Project, milestone and task are positions in the containment graph of one record (the 2026-09-30 ruling), not record types; there is no separate project record, and a plan is not itself a work item."),
      li(text: "**Item events (coordination and acceptance):** `Claimed`, `Released`, `Accepted { execution_result, evidence }`, `Retired { reason }`. Home: the item event log (today `gunbc.roadmap.roadmap_event_log`)."),
      li(text: "**Fabric execution:** request to selection to lease or cell to run to result. Fabric events (`Requested`, `Selected`, `Leased`, `Started`, `ResultReturned`, `Failed`) are fabric's own (`gunbc.fabric.fabric_event_log`). The bridge is one typed identity, `ExecutionBinding { work_item_id, work_request_id }`. In progress is DERIVED (an open item with an active fabric execution), never written."),
      li(text: "**Workspace projection:** `WorkspaceRow { plan_id, work_item, item_state, active_execution?, latest_result?, acceptance_evidence? }`. The ctrl dashboard renders it now; the gunbc page may render the same rows. Summaries such as 7 of 10 accepted are derived."),
    ]),
    p(text: "**The grain rule, which keeps deforking from stripping useful reasoning:** the same fact at the same grain is authored once, and higher-level summaries are derived. A plan stating its aggregate objective and an item stating its local deliverable is two grains, not a fork. A plan restating an item's status, acceptance criteria or completion is a fork."),
    p(text: "**Evidence has three homes:** design evidence (measurements and observations supporting a plan's argument) is referenced from the plan; execution evidence (logs, result objects, resource receipts) is fabric's; acceptance evidence (proof the AcceptanceContract was met) is referenced by the Accepted event. PR and review history is projected from GitHub, not copied into a plan."),
    h2(text: "3. Today's forks against the model (measured at origin/main 2026-11-11)"),
    p(text: "`gunbc.roadmap` plus `gunbc.plans` is 158 files and about 103,000 lines. Import graph from every `module`/`import` line under dag/ and src/v2/; srv1 unit and HTTP state read live the same day."),
    ul(items: [
      li(text: "**Plan to work item.** `gunbc.plan` `Plan` is `{ slug, title, body: List<MarkdownBlock>, retirement, projection }`: phases, decisions and done-when are prose. `gunbc.roadmap.roadmap_model` `RoadmapNode` (272 rows in `roadmap_authority`, 6,595 lines; 153 `RoadmapEdge` rows) carries `TicketFields`. One fact, two homes: identity (a prose label beside a minted id), decomposition (phase order beside the `MemberOf` project tree, whose projects are a second kind of plan), dependency (prose beside edges), done-when (phase prose beside `red_control`/`handback`), state (plan prose and `done`, `current_state`, `last_verified_on`, `updates` beside the event log), why (plan body beside `brief`, `displaced_cost`), decisions (plan prose beside `gunbc.design_ruling`), and the link itself (`carriers: List<Pointer { label, path }>`, one way and untyped, three dangling). A third home is the ctrl dashboard work item, the only one with a live reader."),
      li(text: "**Where RoadmapNode's fields go:** headline and scope to the work item's deliverable and scope; `red_control`, `handback` to its AcceptanceContract; `parent` to `parent_item`; `RoadmapEdge` to `WorkItemDependency`; `dispatch` and the execution contract to `execution`; `carriers` deleted (containment and typed ids replace them); `done` and `current_state` deleted (derived from item events); `last_verified_on` to event or evidence metadata; `updates` to events or discussion; `owner` to the Claimed event; `brief` derived (plan context plus the item definition plus its acceptance contract plus relevant dependency state), never authored; `displaced_cost` to the plan's rationale unless genuinely item-local."),
      li(text: "**The belt beside fabric.** `roadmap_belt_actuate` (16,521 lines; with dispatch, attempt and session modules about 35,000) imports `gunbc.compute.work_request`, `attempt_lifecycle`, `compute_seat_ensure` and `gunbc.fabric.fabric_event_log_host`, and also keeps its own attempt state, metering, exit spool, worktree claim and session slots. Live on srv1: no belt tick timer exists; belt exit and credential recovery are failed; discovery and publication are dead. Its surviving shape is expected to be two adapters: work item to fabric work request, and fabric result to item event. Anything in it that owns allocation, attempt runtime state, leases, quotas or result state beside fabric is presumptively a duplicate."),
      li(text: "**Two event logs.** The roadmap log today also carries execution-shaped kinds (progress, blocked, handed_back, result_returned, published, verification_failed). Under D9 each gets a disposition: an item event, a fabric event, or removed; none is written to both."),
      li(text: "**Scheduling remnants** with no production importer: `roadmap_forecast` (1,104 lines), `roadmap_checkpoint_plan`, `roadmap_closing_contract_authoring`, plus `roadmap_alignment`. Cut."),
      li(text: "**Eighteen roadmap and plans modules with no production importer.** Some are roots a unit or timer runs (`roadmap_serve`, `roadmap_ingress`, `roadmap_belt_tick_cli`); the rest are reached only by tests."),
      li(text: "**Display.** The daily workspace page (`roadmap_page`, `roadmap_presentation`, styles, components; about 13,000 lines) is served by `gunbc-roadmap.service` and answers 503: the served binary cannot decode the `retired` event kind already in the log."),
    ]),
    h2(text: "4. Phases"),
    ol(items: [
      li(text: "**Q0, done (2026-11-10):** prose citations of deleted plans removed; `node_carrier_clean` and `pointer_resolves` deleted (no production consumer); `md_helpers` and `demand_restatement_follow_up` moved out of the plans tree. The 16 plan-naming typed carriers (13 resolve, 3 dangle) await the operator's live-or-stale ruling on those nodes."),
      li(text: "**Q1, audit:** each belt, attempt, dispatch, session, roadmap and workspace module is classified as exactly one of Authority (owns a fact nothing else owns), Adapter (translates one authority into another system's request or event), Projection (a read-only derived view with a real consumer), or Duplicate-or-orphan (owns an already-owned fact, or has no consumer; delete). Bounded: `git grep` and source reading per module, naming the owner each fact is checked against; the output is a disposition list, not a standing gate."),
      li(text: "**Q2:** introduce `Plan` with its WorkGraph and `WorkItem`, without migrating state."),
      li(text: "**Q3:** migrate one plan (D4) and its corresponding roadmap nodes, cut over at the root."),
      li(text: "**Q4:** bind work items to fabric requests through `ExecutionBinding`; remove duplicate attempt state; disposition every existing event kind under D9."),
      li(text: "**Q5:** publish `WorkspaceRow`; ctrl consumes it."),
      li(text: "**Q6:** retire the remaining roadmap nodes, the scheduling machinery and orphan views."),
      li(text: "**Q7, debt (D2):** the debt ledgers (rung drops, recurring failure modes, integration concerns, dissolution conditions) become one obligation-with-trigger record; each old ledger is deleted as it empties."),
    ]),
    h2(text: "5. Decisions"),
    ul(items: [
      li(text: "**D1, RULED 2026-11-10, superseded 2026-11-11:** plans becoming designs and the roadmap scheduling are both replaced by section 1."),
      li(text: "**D2, RULED 2026-11-10:** the debt ledgers are consolidated, as one concept (Q7)."),
      li(text: "**D3, RULED 2026-11-10, not yet:** the control plane does not require a dashboard work item to name the plan work item it executes."),
      li(text: "**D4, open:** which plan migrates first (Q3). Proposed: `gunbc.plans.read_set_convergence`."),
      li(text: "**D5 and D6, moot 2026-11-11.**"),
      li(text: "**D7, 2026-11-11:** a Plan owns one typed WorkGraph; its prose contains argument and evidence, not phase or status copies."),
      li(text: "**D8, 2026-11-11:** WorkItem membership is declared by `Plan.items`. A work item may name a parent item, but does not also name its plan."),
      li(text: "**D9, 2026-11-11:** item lifecycle and fabric execution are separate authorities; in progress is a projection of an active fabric execution."),
      li(text: "**D10, 2026-11-11:** the workspace is a projection contract (`WorkspaceRow`), not a particular UI; ctrl and the gunbc page may both render it."),
      li(text: "**D11, 2026-11-11:** every planning and execution module Q1 reads is classified as Authority, Adapter, Projection or Delete."),
    ]),
  ]
}

data planning_consolidation_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly,
  slug: "planning-consolidation",
  title: "Planning consolidation: plans own intent and work graphs, item events govern, fabric executes, the workspace projects",
  body: planning_consolidation_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "Every stage of section 2 has one home and a named reader, every fork in section 3 is collapsed or deleted, the open decisions are ruled, and this plan has itself been migrated into the ruled work-item home or deleted.") },
}
