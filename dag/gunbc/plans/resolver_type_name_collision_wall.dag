module gunbc.plans.resolver_type_name_collision_wall

import std.dissolution { unbound_dissolution }
import gunbc.plan { Plan, PlanRetirement, PlanRetiresWhen, PlanIsAuthorityOnly }
import std.markdown { MarkdownBlock }
import gunbc.plans.md_helpers { p }
import gunbc.design_ruling { project_documentation_projections_are_not_checkout_artifacts }

fn resolver_type_name_collision_wall_body() -> List<MarkdownBlock> {
  [
    p(text: "Goal: prevent distinct type authorities silently overwriting one unqualified binding. This is the model signed 2026-06-23, not an implementation receipt or authority to alter the current resolver: its future operator-gated guard PR requires the grounding de-fork first. dag_v2_defork_audit §2A owns the executed distribution."),
    p(text: "A1/#5615: global unqualified-name intern IDs made std.verification.TestClaim record and v2.std.verification.TestClaim coproduct share TypeEnv.bindings’ key. Blind rc_map_merge at both import assembly sites overwrote one; when the record won, Disj-only variant_fold never registered EqualsClaim/StructuralEqualsClaim. Closure expansion through ci_failure_class→sccache→cache_interface exposed it. Existing VariantCollision checks variant names, not enclosing type names. #5640’s AssertionClaim rename repaired the instance, not the class."),
    p(text: "Model: one checked merge replaces both duplicate import-binding folds. Absent key inserts; same_authority retains the existing binding; distinct authority emits blocking, located TypeNameCollision(name,module_a,module_b,span) and retains deterministic first-seen binding for reproducible errors. The signed proposal uses resolved.span.file to recognize one declaring authority reached by re-export, requiring no TypeBinding field. Confirm all merge loci, including std.types’ keywise branch, before implementation; current identity authority governs any later model reconciliation."),
    p(text: "Q2 RULED flag-ANY: require_structural_divergence=false. Distinct authorities collide even when byte/structurally identical; merge mirrors to one home instead of exempting them. Rejected flag-DIVERGENT would compare normalized connective/children/types modulo occurrence/span and tolerate drift-capable mirrors. No new comparison primitive is needed, but that weaker policy is not selected."),
    p(text: "Q3 RULED lands-already-green: grounding de-fork of algebra/nat/effects/float/integer precedes an active fail-closed guard landing. No dormant guard or later enable event. The dated live co-occurring pair was algebra/nat; effects/float/integer were latent re-arm risks. verification cleared through #5640; node/coercion/logic share no type names and are off this guard’s surface. Its exemption roster is deliberately empty, not missing node/coercion exceptions. Their module-basename reorganization remains audit category-(c), Route-C/v1-delete work."),
    p(text: "Validate the active guard on the exact floor closure with claim_executor --source-root dag --source-root src/v2 in both orders. Synthetic divergent pairs AND byte-identical mirrors must each fail with TypeNameCollision; removal restores green. A single authority re-exported through multiple paths must stay green. The post-rename affected_set_floor_runner_test both-order receipt is baseline evidence, not guard execution. No green claim without the full active-guard consumer."),
    p(text: "Open prerequisites: complete the five-authority de-fork (algebra ruling; nat/integer/float numeric tower #5428; effects-axis decision), confirm the shared merge helper covers every locus, then operator-gated resolver PR. This model does not decide module-basename reorganization or authorize another resolver precedence mechanism."),
  ]
}

data resolver_type_name_collision_wall_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly { ruling: project_documentation_projections_are_not_checkout_artifacts },
  slug: "resolver-type-name-collision-wall",
  title: "Resolver type-name-collision wall (§5 construction wall) — model-before-implement",
  body: resolver_type_name_collision_wall_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "Delete this model-only DESIGN doc once the resolver type-name-collision wall is implemented and merged — the flag-ANY guard fires fail-closed on any same-name cross-authority type pair (TypeNameCollision diagnostic), the floor closure lands already-green after the de-fork, and the discriminating RED witness (synthetic divergent + byte-identical-mirror pairs both fire) is proven by execution — so this model is realized in the resolver.")
  }
}
