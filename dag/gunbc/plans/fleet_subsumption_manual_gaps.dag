module gunbc.plans.fleet_subsumption_manual_gaps

import std.dissolution { unbound_dissolution }
import std.types { String, List }
import std.markdown { MarkdownBlock }
import gunbc.plan { Plan, PlanRetirement, PlanRetiresWhen, PlanIsAuthorityOnly }
import gunbc.plans.md_helpers { p }
import gunbc.design_ruling { project_documentation_projections_are_not_checkout_artifacts }

fn fsmg_intro() -> List<MarkdownBlock> {
  [
    p(text: "Goal: install/subsume the next host through modeled operations and independent readback, without manual shell or pasted tokens after initial identity bootstrap. This is the 2026-07-22 srv4 install/2026-07-23 OOM incident receipt, not current fleet standing. A performed hand step exposes missing workflow capability; it does not prove that capability exists. Each item retires only when a live consumer closes it."),
  ]
}

fn fsmg_secret_materialization() -> List<MarkdownBlock> {
  [
    p(text: "A1: SecretRef names a secret but does not establish scoped runtime custody. Model fetch→transport-bound handle (SSH key file/environment/stdin password)→cleanup on every scope exit; any file is mode0600. Historical manual cases were fleet SSH key, console sudo password, BMC credential and CI App key. Existing ctrl fetch/use/shred scripts demonstrate the missing shape, not an authority to retain them. Every secret-using transport must require the handle, not a raw path; removing materialization must break binding. Red controls: leaked cleanup and raw-temp-path admission. T2 wiring precedes T4 live receipt."),
  ]
}

fn fsmg_reach_secrets() -> List<MarkdownBlock> {
  [
    p(text: "A2: replace operator-pasted Secret Manager tokens with modeled ADC/SecretAccessGrant for the execution principal, least privilege per SecretRef. Existing host_standup reach-secrets and fleet_ssh_access out-of-band accessor notes own that gap. An ungranted read must refuse at planning, not wait for HTTP403; this is the deeper A1 prerequisite."),
  ]
}

fn fsmg_secret_liveness() -> List<MarkdownBlock> {
  [
    p(text: "A3: existence is not validity. The cited App key was revoked while hosts held a different live key; manual Secret Manager reconciliation repaired the 401. Validate SecretRef through read-only JWT/installation-token mint before touching a host. Rotate at that single authority, make hosts materialize from it and retire the canonical dashboard-host copy. Pointing at a revoked key must red before mutation."),
  ]
}

fn fsmg_slot_provisioning() -> List<MarkdownBlock> {
  [
    p(text: "B1: historical enable-only deployment assumed slot directories existed; width increase was manual while decrease drained. Operator copied runner2.334.0 from srv1, created base/cache paths and independently owned slot trees, then enabled. The readiness-blind enable path is now deleted: runner_activate_command requires BuildCacheInstanceReady and HostCompilePoolReady. Do not rewrite that historical defect as a successful modern path."),
    p(text: "Use a cited per-architecture ActionsRunnerRelease (URL/hash from github.com/actions/runner/releases), verified staging, modeled base/slot ownership and a single count-driven provision fold. Reconcile desired versus observed slots: seed increase, drain/remove decrease, then enable. Derive disk headroom as well as RAM; the historical hand cap from ten to five was not a modeled result. Independent directory enumeration and systemctl activity must show exactly admitted N; changed N affects exactly the delta. Wrong architecture/digest refuses before extraction."),
  ]
}

fn fsmg_runner_user() -> List<MarkdownBlock> {
  [
    p(text: "B2: autoinstall created ubuntu while deployment assumed the fleet runner identity. Declare runner user once, establish through autoinstall or prerequisite ensure including needed sudoers/authorized keys, never hand useradd. Missing user/required privilege/key refuses preflight before installer; current privilege authority governs the required grant, not an unconditional copied NOPASSWD policy."),
  ]
}

fn fsmg_fresh_host_prereqs() -> List<MarkdownBlock> {
  [
    p(text: "B3: every installer precondition needs a cited ensure before use: jobserver/FIFO, base directory+ownership, Docker and sccache (the latter two were modeled in the incident). Refuse naming the missing precondition, not halfway through installation."),
    p(text: "B3.1: host_toolchain_components/extdeps.rust.rustup cell is keyed by job principal’s RESOLVED toolchain, not host. Presence in a different toolchain never satisfies it. The apply arm/runner-floor HostToolchainKind was deferred pending argv materialization; incomplete matches in the seed made a hollow new variant unsafe. Model component add/remove through host_effect_apply with independent readback instead of hand action."),
    p(text: "Installation is insufficient: a systemd job may have a PATH without cargo bin while login shell succeeds. Only an in-job observation can supply ComponentSpawnReachability/resolved PATH for every enrolled host. Unknown stays UnknownRefused. Red controls retain both wrong-toolchain presence and complete-but-unreachable toolchain; probe observes and never repairs."),
  ]
}

fn fsmg_install_actuator() -> List<MarkdownBlock> {
  [
    p(text: "B4: configfs virtual-media install needs one stage→serve→attach→boot→detach actuator, consuming existing nbd/usb_gadget/bmc_virtual_media/VirtualMediaIntent rather than hand NBD/configfs/SOL orchestration. Detach requires independent install-complete/first-installed-boot observation before reboot can re-enter installer; failure to detach must red. The old srv3 NBD-proxy actuator alone did not cover configfs. Current physical-machine boot authority owns generalization; do not mint a new per-host workflow."),
  ]
}

fn fsmg_host_convergence() -> List<MarkdownBlock> {
  [
    p(text: "C: srv4 took GitHub runner work while absent from fleet_intent, so derived convergence could not name it. Enrollment is prerequisite: BMC-observed memory plus intended width/caps feeds conservation, rejecting PlanUnsound; copying another host’s template is not enrollment. Installer must structurally refuse hosts outside intent, and no host takes fleet work without a convergence receipt."),
    p(text: "Historical OOM mitigation used derived-equal same-board/RAM slot caps, preserved srv4’s own slice cap, added swap/oomd/reclaim timer and independently read state. It bounded each job’s memory failure instead of global collateral OOM. These observations are not current values or deployment authorization. At the incident, converge emit failed compilation and PerSlotMemoryCap apply refused; current host_convergence_circuit_residue records later withdrawal of converge-side actuation. Do not restore it from this dated plan."),
    p(text: "Priced gaps: authorized modeled actuation with readback; SwapDevice/SwapFile axis (typed allocation/mkswap/swapon/fstab and /proc/swaps observation); reclaim-timer ownership; construction enrollment wall. Swap remains separate from proving admitted runner conservation. Canonical host observations belong to the owning host-state rows, not this incident narrative."),
  ]
}

fn fsmg_priority() -> List<MarkdownBlock> {
  [
    p(text: "Historical priority: A1+B1, then A3, B2+B3, with deeper A2 identity and B4 actuator following their dependencies. No reorder waives enrollment/custody/current authorization. Done per item: next-host subsumption has no hand shell or pasted token after initial ADC, all steps consume modeled inputs and independent readback; an unenrolled host cannot take fleet work."),
  ]
}

fn fleet_subsumption_manual_gaps_body() -> List<MarkdownBlock> {
  concat(fsmg_intro(),
  concat(fsmg_secret_materialization(),
  concat(fsmg_reach_secrets(),
  concat(fsmg_secret_liveness(),
  concat(fsmg_slot_provisioning(),
  concat(fsmg_runner_user(),
  concat(fsmg_fresh_host_prereqs(),
  concat(fsmg_install_actuator(),
  concat(fsmg_host_convergence(), fsmg_priority())))))))))
}

data fleet_subsumption_manual_gaps_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly { ruling: project_documentation_projections_are_not_checkout_artifacts },
  slug: "fleet-subsumption-manual-gaps",
  title: "Fleet subsumption — manual steps the modeling workflow does not yet cover (srv4 receipts, 2026-07-22 install + 2026-07-23 host-convergence OOM)",
  body: fleet_subsumption_manual_gaps_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "Dissolves item-by-item as each gap is modeled and consumed on the live path: A1 MaterializedSecret effect, A2 SecretAccessGrant/ADC, A3 SecretRef liveness probe, B1 RunnerSlotProvision + ActionsRunnerRelease, B2 fleet-runner-user provision, B3 prereq chain completion, B4 configfs install actuator, C enrollment wall + converge actuation lane + SwapDevice member. The canonical host-state rows land on the operator sheet (1a lane); this doc is the incident receipt. Fully retired when srv5 (the next host) is subsumed with zero hand-run shell and read-back receipts for every step, and a host absent from fleet_intent structurally cannot take fleet work.") },
}
