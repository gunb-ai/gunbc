module gunbc.plans.transport_argv_anemia_dissolution

import std.types { String, List }
import std.markdown { MarkdownBlock }
import gunbc.plan { Plan, DissolutionTrigger, HasTrigger }
import gunbc.plans.md_helpers { h2, h3, p, li, ul, ol, quote }

fn taad_intro() -> List<MarkdownBlock> {
  [
    p(text: "Argv anemia: extdeps shell transports hand-spell each tool invocation as a bare argv String array — curl, dash-s, dash-k, and so on — where every flag is an opaque String that ENCODES a grounded concept. This is §2 anemic modeling (a String leaf hiding named parts) and it is the ROOT CAUSE of the redfish fail-open class found live against srv4 (2026-07-23): dash-f / --fail is a hand-typed flag, not a modeled success property, so it was trivially omittable — and was omitted in 11 sites (10 redfish ops + http.Client.PostJsonFromFile), each a §5 fail-open where a 401/403/404/5xx read as success. Construction — model the request, derive the argv — makes that class UNWRITABLE. The --fail-with-body patches already landed are the interim this plan deletes."),
    quote(blocks: [p(text: "The model is the request; the curl argv is one derived realization of it. A bare flag string is the anemic serialization standing where the modeled axis belonged.")]),
  ]
}

fn taad_widened_root() -> List<MarkdownBlock> {
  [
    h2(text: "The root, widened (operator direction, 2026-08-01)"),
    p(text: "This plan was written about the REQUEST half only — a flag is an anemic String, so model the request and derive the argv. That is true and stays. It is also half the class, and the missing half is where the live defects have since appeared. The outcome side is anemic in exactly the same way: a process result arrives as exit_code plus success plus stdout plus stderr, every caller re-derives what the tool's failure MEANT from those, and the derivation lands in prose in a business module. Measured on the corpus: 164 exit blocks declared across extdeps and none realized at runtime, 31 sites interpreting a shell op's stderr, 302 bare-String refusal fields."),
    quote(blocks: [p(text: "Model the operation, derive the invocation, preserve the process evidence, decode through the operation, render at the boundary.")]),
    p(text: "The tell that produced this widening: a publication module spelled `git ls-remote --heads` inside a refusal message. A domain layer reaches for the command spelling exactly when it has no stable operation identity to name — so the raw argv in a diagnostic is not untidiness, it is the anemia reporting itself."),
    h3(text: "Six layers, currently collapsed into two"),
    ol(items: [
      li(text: "DOMAIN OPERATION — what is being asked. Names no program, no flag, no stream."),
      li(text: "BOUND INVOCATION plus EXECUTION BINDING — which operation, against which admitted repository/worktree/cwd/credentials/deadline. std.operation_argv BoundOperationInvocation already is this layer; the execution binding is the part that must stop being smuggled through argv and ambient cwd."),
      li(text: "DERIVED REALIZATION — program plus args plus cwd. The ONLY layer that knows the spelling. It may appear in an execution receipt, redacted; it may never appear in a domain result."),
      li(text: "PROCESS OBSERVATION — completed versus spawn-refused versus wait-refused, and exited versus signaled versus timed-out versus killed. No precomputed success Bool, no minus-one sentinel."),
      li(text: "OPERATION DECODER — the operation's own reading of its evidence, producing typed located causes. stderr is EVIDENCE, never the classifier: no caller branches on a substring like `not a repository`."),
      li(text: "RENDERER — the only layer that produces prose, at the UI/CLI/diagnostic boundary, from the typed cause."),
    ]),
    h3(text: "What this rules out, stated so it is not re-derived later"),
    ul(items: [
      li(text: "Activating the 164 existing exit blocks as written. Most map a code to an English sentence, so realizing them wholesale moves the prose interpretation down one layer instead of removing it. They migrate just-in-time into layer 5, per operation, with their strings replaced by typed causes."),
      li(text: "Treating exit_code equals zero as a universal success model. The corpus already met this in ExpectedOutcome and OutcomeIsData: a probe may use its exit code as an ANSWER rather than a verdict. Process termination, operation observation, caller expectation, and log disposition are four facts, not one."),
      li(text: "Lossy stream decoding at the process boundary. Converting both streams with from_utf8_lossy and trimming before the operation sees them is a global policy that can replace undecodable bytes, erase significant trailing delimiters, and make NUL-delimited protocols unrepresentable. The boundary preserves bytes; the operation names its decoder and a decode failure is typed and located."),
      li(text: "A second invocation carrier. extdeps.exec.command ArgvCommand and HostEffect ThinInvocation converge ONTO BoundOperationInvocation consumer by consumer; they do not become the common abstraction and no third one is minted."),
      li(text: "Magic transport output sources standing in for declared response semantics. A REST operation already declares its typed response table; a runtime that ignores it and instead reads a magic output field name has bypassed the authority rather than realized it. Recorded because this plan's own target list already said NOT `success: Bool from exit_success` and an implementation added exactly that shape for HTTP before this row was read."),
    ]),
  ]
}

fn taad_decode() -> List<MarkdownBlock> {
  [
    h2(text: "Decode the flags (§2 decompress -> map -> reduce)"),
    p(text: "Each opaque flag is a typed axis of an HTTP request:"),
    ul(items: [
      li(text: "dash-s / dash-S — suppress the progress meter / still show errors: a verbosity axis."),
      li(text: "dash-f / --fail / --fail-with-body — FAIL when HTTP status is >= 400. THIS is the success-semantics; its omission IS the fail-open. --fail-with-body also keeps the error body for diagnosis."),
      li(text: "dash-k — skip TLS certificate verification: a tls-verify=off axis, needed for the fleet's self-signed BMC certs (should be an explicit modeled exception, never a silent default)."),
      li(text: "dash-u user-colon-pass — HTTP basic auth; --netrc-file F — netrc-file auth; a bearer header — token auth. One auth axis with N modes (and where the operator/WIF token attaches)."),
      li(text: "dash-X — HTTP method; dash-H — a request header; --data at-file — request body from a file; dash-L — follow redirects (a redirect policy); dash-o F — write body to a file vs stdout."),
    ]),
    p(text: "Reduce: these are not curl trivia, they are the axes of the DMTF/RFC-9110 request the operation already means. The argv array is the leaf; the request is the concept."),
  ]
}

fn taad_target() -> List<MarkdownBlock> {
  [
    h2(text: "The dissolution target already exists (§3 — extend, do not re-coin)"),
    p(text: "transport rest (config modeled in extdeps.transports.rest) is the DECLARED declarative peer handler — 28 files already use it, and both carrier notes name it as the dissolution target: redfish_http_hardwired_transport_note (dag/extdeps/bmc/http.dag) and http_client_handler_layering_note (dag/extdeps/http/client.dag). N handlers, one modeled shape, dispatch peripheral. So the move is NOT a new CurlOptions vocabulary (that would be a §3 fork); it is: HTTP operations become declarative transport rest rows, and the curl argv is DERIVED by the realization — always emitting the correct success flag because success is modeled."),
    h3(text: "What transport rest must gain first (the axes the hand-argv carries today)"),
    ol(items: [
      li(text: "TLS-verify toggle (insecure for self-signed BMC certs) — today only the curl handler's dash-k carries it."),
      li(text: "Auth modes: basic (user-colon-pass), netrc-file, bearer-token — grounding token attachment (this is also where the operator/WIF GCP token plugs in, so it converges with the credentialing lane)."),
      li(text: "Request-body-from-file."),
      li(text: "MODELED SUCCESS — the §5 keystone. A response that carries the HTTP status with a grounded 2xx success, NOT `success: Bool from exit_success`. Then fail-closed is a construction property and --fail is derived, never a droppable flag. This is what makes the whole fail-open class unwritable."),
    ]),
  ]
}

fn taad_lanes() -> List<MarkdownBlock> {
  [
    h2(text: "Three lanes"),
    h3(text: "Lane A — HTTP transport dissolution (curl argv -> transport rest)"),
    ol(items: [
      li(text: "Extend the rest model with the 4 items above (3 axes + modeled success)."),
      li(text: "Convert the 10 redfish.Http.* ops (dag/extdeps/bmc/http.dag) from hand-argv transport shell to declarative transport rest rows."),
      li(text: "Convert http.Client's 3 shell-handler ops (Get / PostJsonFromFile / DownloadToFile)."),
      li(text: "Sweep the remaining HTTP shell-transports. Deliverable: the curl-fail-open class is EXTINCT by construction, and the --fail-with-body interim patches (this branch) are deleted. Priced by the fail-open class it removes, not elegance."),
    ]),
    h3(text: "Lane B — general tool-argv modeling (the non-HTTP argv)"),
    ul(items: [
      li(text: "The non-HTTP bare argv: the busybox build sequence (mkdir / tar / make / sed / cp — dag/gunbc/busybox_bmc_build.dag) and the broader 262 argv-lines across 37 transport-shell files."),
      li(text: "Each shell tool becomes a modeled extdeps/tools/* service with typed operations — precedent already exists (sha256sum, jq, xorriso, sed, grep are modeled). The build sequence becomes typed tool ops, not a bare argv list."),
      li(text: "This is the broader §2 argv anemia and rides the shell -> intent lane (the intent IS the .dag graph; emit vs realization). Model just-in-time per real consumer, never a big-bang sweep."),
    ]),
    h3(text: "Lane C — the outcome half: direct-process observation, decoded through the operation"),
    p(text: "Lane C is the widened root made concrete, and it is first by READINESS rather than by priority — see the sequencing section, which states both criteria together so neither reads as a flat global ordering. What makes it ready is a live consumer waiting: Publication needs an exact remote head, and the only thing standing between it and one is a raw argv plus four untyped process fields. The exemplar is `git ls-remote --heads`, chosen because it exercises every missing seam without a general rewrite."),
    ol(items: [
      li(text: "E1 — the minimum process observation shape, consumed immediately rather than landed as an unused framework: completed versus spawn/wait refusal, exited versus signaled versus timed-out, streams retained faithfully, an explicit strict decoder, no global success projection."),
      li(text: "E2 — a repository-BOUND remote-head operation. It consumes the worker's admitted repository binding (worktree, remote, forge identity, credential binding), not a free `origin` string, so one repository's forge observation cannot be cross-paired with another's worktree."),
      li(text: "E3 — a typed advertisement decoder under extdeps.git: strict line decoding, validated object ids, full ref identity, located malformed-line refusal, duplicate-ref refusal, and NO cast from arbitrary text to CommitSha or NonEmptyStr. Witnessed by execution against a temporary local BARE repository — no network, no credentials."),
      li(text: "E4 — Publication consumes the typed observation. gunbc.roadmap_publish_observe stops seeing success, exit_code, stderr and advertised lines; the refusal preserves the cause structurally instead of flattening it into a sentence, and the renderer moves to the boundary."),
    ]),
    p(text: "Discriminating cases E3 owes, none of which need live GitHub: a local bare remote advertises the expected branch and sha; the branch then moves to another sha; an unavailable remote produces a process refusal rather than an empty list; a malformed fixture refuses at the exact line; an invalid object id refuses rather than being branded; and two refs of one name cannot collapse into a first-match answer."),
  ]
}

fn taad_mechanism_taxonomy() -> List<MarkdownBlock> {
  [
    h2(text: "The execution-mechanism taxonomy (PROPOSED on PR 7526, bright-dove-771 — not in this tree)"),
    p(text: "One declaration form, `transport shell`, was realized by five materially different mechanisms with nothing in the row to tell them apart. That is why a wall written against the spelling is always either too broad or too narrow: most rows saying `transport shell` are not shell at all. The seed's `dispatch_shell` calls `std::process::Command::new` on argv[0], so an ordinary executable is a direct exec and a shell is involved only when the executable IS a shell interpreter, or when the path is OpenSSH and the far side reinterprets."),
    ul(items: [
      li(text: "LocalProcess — direct local process execution (git, cargo, systemctl)."),
      li(text: "LocalShellScript — a local shell interpreter reads a script (sh, bash, dash, ksh, zsh)."),
      li(text: "RemoteShellCommand — OpenSSH, whose remote command is reconstructed and interpreted by the far-side shell. This is why the portable-character allowlist in extdeps.ssh.session exists, and why that operation is remote-shell execution rather than structured argv."),
      li(text: "RemoteStructuredExecution — deliberately DISTINCT and currently uninhabited by any handler. It names the future gunbc receiver that accepts a structured invocation and calls exec without shell reinterpretation, so the absence is visible instead of silently folded into the SSH arm."),
      li(text: "ForeignShellArtifact — not execution by this runtime at all: shell TEXT emitted for GitHub Actions run steps, cron, or git hooks. It shared a spelling with direct exec, which is the sharpest instance of the conflation."),
    ]),
    h3(text: "Why this is construction and not a label"),
    p(text: "STATUS FIRST, BECAUSE AN EARLIER REVISION OF THIS SECTION GOT IT WRONG. Every symbol named in this section exists ONLY on PR 7526 and is absent from this plan's tree and from main — verified by grep at both, not assumed (caught in review, 2026-08-01). The earlier revision headed this section with the word landed, which in this corpus means merged, and then named the carrier and its constructors as live facts. That is a canonical planning artifact presenting unmerged work as established substrate, which would misdirect anyone implementing from it. The shape below is what PR 7526 PROPOSES; it becomes fact here when that PR merges, and this paragraph deletes at that point."),
    p(text: "The proposed carriers are TWO, split along the interface/realization seam after review: `v2.std.execution_mechanism` keeps only the agnostic `ExecutionMechanism` coproduct, while the evidence type, `execution_mechanism_from_evidence`, the executable/shell/wrapper/OpenSSH recognition and the corpus consumer live in `extdeps.execution.mechanism` with their upstream citations. That split is itself the §3 rule this plan invokes elsewhere — the dispatch that selects a realization IS realization, so it sits peripheral and never in the pure-spec. An earlier revision of this paragraph named a single `v2.std` carrier holding all of it, which was the shape before that review. `ExecutionMechanism` is the five-arm coproduct and `execution_mechanism_from_evidence` derives it from `ExecutionMechanismEvidence` — spawn-an-executable, send-a-structured-invocation, or emit-shell-text. Nothing hand-labels a site, which matters because a hand-written label is the same anemia one layer up: a row could then claim a mechanism it does not use and nothing would catch it. Enrollment is likewise derived — `shell_transport_operation_rows` enumerates every shell-transport operation from the DECLARATIONS under dag and src/v2, so a newly authored operation enrolls by existing rather than by being added to a roster, which would be the parallel-ledger form of the same fact."),
    p(text: "The wall is fail-closed rather than best-effort: classification answers `ShellTransportMechanismClassified` or `ShellTransportMechanismRefused`, so a new site whose executable is not a literal REFUSES instead of being guessed into the nearest arm. A guess here would be the absorbing fallback — the taxonomy would stay green by construction while saying nothing true."),
    p(text: "Orthogonality worth keeping: mechanism is independent of `Placement` and `Materialization` in std.realization. Where work occurs and whether it is shared do not determine how an operation crosses its execution boundary."),
    h3(text: "Exec wrappers refuse rather than being classified from argv[0]"),
    p(text: "argv[0] is not always the thing that executes. `env`, `sudo`, `nohup`, `timeout`, `nice`, `setsid`, `stdbuf` and `xargs` select the effective executable through their OWN option grammar, so `env bash -s` is a LocalShellScript and `env git status` is a LocalProcess while both carry the same argv[0]. Classifying on argv[0] would have answered LocalProcess for both — and would have looked unambiguous doing it, because argv[0] IS a literal, so the existing ambiguity refusal never fires. `ExecutionMechanismRefusedWrapper` is therefore its own arm: a wrapper refuses until its invocation shape is grounded. Looking through without modeling that grammar was rejected deliberately, because parsing wrapper options inside the classifier would recreate argv anemia one layer in."),
    p(text: "The live census pins ten wrapper rows as counted residue — eight env and two sudo. That figure has a correction attached worth keeping, because it is the same defect this plan is about: an earlier source scan reported eight total, having missed two multiline env argv declarations that a line-anchored grep cannot see. The DERIVED census is the authority, not the grep — a name-level pattern match standing in for a structural read is exactly what the namespace and citation rules exist to stop."),
    h3(text: "What the census does NOT cover, stated so coverage is not mistaken for total"),
    p(text: "Enrollment is over parsed `transport shell` declarations. Bare argv reaching execution through the OTHER invocation carriers is outside it today: `extdeps.exec.command` `ArgvCommand`, `gunbc.host_effect` `ThinInvocation`, and `gunbc.typed_argv_exec`. The live specimen is `gunbc.runner_host_deploy` `runner_host_installer_command_argv`, which builds an `ArgvCommand` whose first element is a wrapper and which the census cannot see; a second hit is fixture-only. So an executable reaching execution through those carriers is unclassified and unrefused, wrapper or not."),
    p(text: "This is the coverage-by-illusion shape and the reason the bound is written down rather than left to a reader: the mechanism is real and the census is honestly derived, and a reader still concludes the class is closed because nothing states the denominator. Dissolve-on is consumer-by-consumer convergence of those carriers onto `BoundOperationInvocation` — the same convergence this plan already forbids forking away from — at which point one enrollment covers every invocation and this paragraph deletes."),
    p(text: "Bound on this row, restated now that the status paragraph above carries the harder half. The executed receipt lives on PR 7526 — a live-tree witness with per-mechanism RED controls, an ambiguity-wall control, and the wrapper case — and was read here rather than re-run. Note that the earlier version of this bound was not wrong, only insufficient: it disclosed that the EXECUTION had not been re-run here while leaving the impression that the CARRIER existed. Those are two different claims and only the first was hedged, which is how the section read as landed. A bound on evidence does not substitute for a bound on existence."),
  ]
}

fn taad_growth_walls() -> List<MarkdownBlock> {
  [
    h2(text: "Freeze growth before migrating the corpus"),
    p(text: "The corpus is larger than any one lane, so the migration is paced by consumers while NEW sites are walled. Each wall below is narrow and low-false-positive by construction, and each is a backstop AFTER the typed path exists for its class — a wall that fires before there is somewhere to go is a wall that gets exempted."),
    ul(items: [
      li(text: "No new shell.Exec.Run caller without a RetainedShellScript row."),
      li(text: "No new HostEffect ShellCommand producer."),
      li(text: "No new runtime use of git_shell_join_argv."),
      li(text: "No new operation result classified by parsing stderr."),
      li(text: "No new command spelling embedded in a domain refusal."),
      li(text: "No new `success: Bool from exit_success` where a typed operation observation already exists for that operation."),
      li(text: "No new string-valued exit arm once the typed outcome path is available for that operation."),
    ]),
    p(text: "The existing extdeps_shape_transport_policy lens has the right intent but a heuristic token policy, and the fail-closed plan records it as inert. It becomes the backstop after construction, never the primary repair."),
  ]
}

fn taad_sequence() -> List<MarkdownBlock> {
  [
    h2(text: "Sequencing, census, non-goals"),
    ul(items: [
      li(text: "ORDERING, ON TWO DIFFERENT CRITERIA — stated together because an earlier revision of this plan asserted `Lane A FIRST` here while the Lane C section asserted Lane C was `FIRST in wall-clock`, which are incompatible as flat global priorities and would have scheduled the wrong lane for anyone reading only one of them (caught in review of the widening PR, 2026-08-01). The reconciliation is that FIRST was doing two jobs. Lane A is first by PRIORITY: it closes a live fail-open class by construction and is bounded at ~13 HTTP ops, so it is the one whose delay costs safety. Lane C is first by READINESS: it has a consumer blocked right now — Publication needs an exact remote head and is holding a raw argv plus four untyped process fields in the meantime — and its exemplar is narrow enough to land without a general rewrite. Neither dominates the other, and in fact both are in flight concurrently on separate work items; what the two criteria jointly decide is only that LANE B IS LAST, because it is the largest and is paced by the shell -> intent lane rather than by anything in this plan."),
      li(text: "A note on why that contradiction survived a full authoring pass, since the same shape will recur: the widening added Lane C as a new section and updated the dissolution trigger to name three lanes, but left the lanes heading reading `Two lanes` and left this sequencing list untouched. The plan carried its lane count in three places and only two were edited. That is the parallel-representation defect this plan is itself about, appearing in the plan's own prose — the count is derivable from the lane sections and should not have been transcribed beside them at all. Recorded rather than merely fixed, because the fix below is still a transcription and will drift again."),
      li(text: "Census (the backlog): 37 files use transport shell; 262 argv lines total. Lane A = the HTTP subset (redfish 10 + http.client 3 + other HTTP shell-transports); Lane B = the remainder. A lens over argv arrays containing a known tool name is the coverage tracker and the anti-regression guard (a new curl op without modeled success reds)."),
      li(text: "Non-goal: minting a parallel option vocabulary. Extend transport rest (§3). Non-goal: rewriting every argv at once (Lane B is JIT per consumer)."),
      li(text: "Convergence: the redfish and http-client transport notes dissolve WITH this plan — Lane A is their shared, already-declared dissolution. The interim --fail-with-body flags are the fenced-out debt Lane A removes."),
    ]),
  ]
}

fn taad_outcome_source_census() -> List<MarkdownBlock> {
  [
    h2(text: "The declaration contradicts itself, and it does so 148 times"),
    p(text: "The rows above describe the anemia as a cross-layer loss: an operation declares typed outcomes, a caller downstream re-derives them from strings. A census of the transport output sources found a sharper form, and it is worth stating separately because it needs no second module to go wrong. THE CONTRADICTION IS INSIDE ONE DECLARATION."),
    p(text: "An operation declares an exit table keyed on the exit CODE — git.Core.HeadCommit declares `0 => Unit` and `128 => String \"Not a git repository\"`. Six lines above it, the same declaration's output block says `success: Bool from \"exit_success\"`. So the operation states that its outcome is a function of the exit code, and in the same breath discards the exit code and keeps a Bool derived from it. There is no downstream module involved and no drift over time: the authority and the realization are adjacent lines of one declaration, disagreeing on landing."),
    h3(text: "Measured, with the populations separated"),
    ul(items: [
      li(text: "Within dag/extdeps: 164 exit tables declared, 148 operations sourcing `success: Bool from \"exit_success\"`, 51 preserving `from \"exit_code\"`. The lossy form outnumbers the faithful one roughly three to one."),
      li(text: "Corpus-wide (dag plus src/v2): 184 exit tables, 151 exit_success, 54 exit_code. The extdeps figure is the one the earlier rows quote; both are correct for their own scope and neither supersedes the other."),
      li(text: "The stderr half is 89 `from \"stderr\"` sources, against the 31 sites measured as INTERPRETING stderr. The gap is the point: most sites that receive stderr do not yet classify on it, so the 31 is the live defect count and the 89 is the exposure that lets it grow."),
    ]),
    p(text: "Why this reframes the sequencing rather than merely adding a number. The plan already rules out activating the 164 exit tables as written, because they map codes to English sentences and realizing them wholesale relocates the prose one layer down. That still holds. But it left the impression that the tables are inert and the work is elsewhere, and this census says otherwise: the tables are inert BECAUSE the output block next to them threw away the key they are indexed by. Realizing an exit table is not only a matter of replacing its strings with typed causes; it first requires that the operation stop discarding the exit code, which is a change to 148 output blocks and not to the tables at all."),
    p(text: "That also settles which of exit_success and exit_code is the scaffold. They are not two options. exit_success is DERIVED from exit_code by a comparison to zero, so a declaration carrying both carries one fact twice, and a declaration carrying only exit_success has destroyed the one its own table needs. The faithful source is the integer."),
    p(text: "WHERE SUCCESS THEN LIVES, stated carefully because an earlier revision of this row got it wrong and the error would have misdirected the implementation. That revision said success is a projection belonging in the RENDERER. It is a projection, but the renderer is the wrong owner and the mistake contradicted this plan's own layer list one screen above: layer 6 turns a typed cause into PROSE, and success is not prose — a caller branching on it is making a decision, not displaying a sentence. Routing it there would have put a decision in the presentation layer, which is the single-authority violation this plan is written against (caught in review, 2026-08-01)."),
    p(text: "The owner is the CALLER'S EXPECTATION, which this plan already names as its own fact: the non-goals list states that process termination, operation observation, caller expectation, and log disposition are four facts rather than one, and cites ExpectedOutcome and OutcomeIsData as the places the corpus already met it — a probe may use its exit code as an ANSWER rather than a verdict, so no layer below the caller can know whether a nonzero code means failure. So the chain is: layer 4 preserves the termination fact, layer 5 decodes it into that operation's typed outcome, and whether a given outcome COUNTS as success is the caller's declared expectation applied to it. The renderer only says what happened, and it says it from the typed cause."),
    p(text: "STATED AS A BOUND RATHER THAN IMPLIED: this is a census, not a repair. No output block is changed by this row, the 148 remain, and nothing here has been proven by executing a migration. What it establishes is that the shell half of the outcome work has a denominator and a first mechanical step that is independent of the typed-cause modeling — which is what Lane C needed in order to be sized at all."),
    p(text: "The HTTP half is the same defect and the plan already names it: an implementation added `http_success: Bool` sourced from a magic key, and it was rejected for collapsing RFC 9110's five status classes into two and baking the boundary into the interpreter. That rejection generalizes here. A five-class classifier `http_status_class` was written into extdeps.transports.rest beside the RFC that defines it, but it sits on the HELD branch of that rejected PR and is NOT in this tree or on main — an earlier revision of this row asserted it was already there, which was false when written, since the same session had already decided to hold that branch (caught in review, 2026-08-01; the claim was also repeated in a brief to the REST lane, telling it to consume a symbol that does not exist). Its landing trigger is the REST response-table lane, PR 7528, which carries the surviving half of that work. The shell side has no equivalent classifier at all, and this census is what says how large its consumer set would be."),
  ]
}

fn transport_argv_anemia_dissolution_body() -> List<MarkdownBlock> {
  concat(taad_intro(),
  concat(taad_widened_root(),
  concat(taad_decode(),
  concat(taad_target(),
  concat(taad_lanes(),
  concat(taad_mechanism_taxonomy(),
  concat(taad_outcome_source_census(),
  concat(taad_growth_walls(), taad_sequence()))))))))
}

data transport_argv_anemia_dissolution_plan: Plan = Plan {
  slug: "transport-argv-anemia-dissolution",
  title: "Transport invocation and outcome anemia — model the operation, derive the invocation, decode through the operation, render at the boundary",
  body: transport_argv_anemia_dissolution_body(),
  dissolution: HasTrigger { text: "Dissolves when all three lanes close. Lane A: every HTTP operation is a declarative transport rest row whose DECLARED response table is the runtime authority for decoding a response into typed operation outcomes — curl argv derived, fail-closed by construction, the interim --fail-with-body patches removed, and no operation declaring a magic output field to observe its own response. Lane B: the non-HTTP tool argv is modeled through extdeps/tools/* or emitted via the shell -> intent lane, no bare flag-string load-bearing. Lane C: no domain module receives argv, exit code, success Bool, stdout lines or stderr; process evidence is preserved at the boundary, decoded by the operation into typed located causes, and rendered to prose only at the UI/CLI edge. redfish_http_hardwired_transport_note and http_client_handler_layering_note dissolve with Lane A. Tracked green by a coverage lens over argv arrays and by the growth walls above: zero unmodeled-success HTTP ops, zero new stderr-classified results, zero command spellings in domain refusals." },
}
