module gunbc.plans.transport_argv_anemia_dissolution

import std.dissolution { unbound_dissolution }
import std.types { String, List }
import std.markdown { MarkdownBlock }
import gunbc.plan { Plan, PlanRetirement, PlanRetiresWhen, PlanIsAuthorityOnly }
import gunbc.plans.md_helpers { p }
import gunbc.design_ruling { project_documentation_projections_are_not_checkout_artifacts }

fn taad_intro() -> List<MarkdownBlock> {
  [
    p(text: "Eliminate HTTP fail-open construction by modeling the request and deriving transport argv. The 2026-07-23 srv4 finding was omitted --fail in redfish/http.Client.PostJsonFromFile: HTTP 401/403/404/5xx appeared successful. --fail-with-body patches are interim debt."),
  ]
}

fn taad_decode() -> List<MarkdownBlock> {
  [
    p(text: "Request axes: verbosity (-s/-S); status failure with diagnostic body (--fail-with-body); explicit TLS-verification exception (-k for self-signed BMCs); basic/netrc-file/bearer auth; method (-X), headers (-H), body-from-file (--data @file), redirect policy (-L), output file/stdout (-o). These are DMTF/RFC-9110 concepts, not an independent CurlOptions vocabulary."),
  ]
}

fn taad_target() -> List<MarkdownBlock> {
  [
    p(text: "Extend extdeps.transports.rest, the existing target of redfish_http_hardwired_transport_note and http_client_handler_layering_note. Before conversion, add TLS verification, basic/netrc-file/bearer auth (including operator/WIF tokens), request-body-from-file and status-bearing grounded 2xx success. exit_success Bool is insufficient; derive curl failure flags from modeled success."),
  ]
}

fn taad_lanes() -> List<MarkdownBlock> {
  [
    p(text: "Lane A first: extend rest; convert redfish.Http operations in extdeps/bmc/http, then http.Client Get/PostJsonFromFile/DownloadToFile and remaining HTTP shell transports. Remove interim flags and dissolve both transport notes when the class is unwritable."),
    p(text: "Lane B construction seal landed: extdeps.exec.command.ArgvCommand is sole_constructor through argv_command, caller-sealed to typed builders in each tool’s cited extdeps home. Every record-construction caller converted together; partial sealing would retain dual authority. program: NonEmptyStr makes empty argv unrepresentable and removes command_runner’s corresponding refusals."),
    p(text: "The seal controls who constructs, not builder flag correctness. Transport-shell argv is a distinct population: names there are not resolved while the same control name in a function diagnoses. Citation-based conversion is BLOCKED on gunbc#8916 / compiler-guarantee gap-analysis row 29. posix_sh_program_command and bash_program_command remain shell-intent debt: a script argument is not modeled argv."),
    p(text: "Model tools just in time beside their upstream authority, never in the hub. Converted ArgvCommand builders include tar/make/curl/sed/coreutils (cat/cp/rm/printf/true/whoami), stat/hostname/chmod/mkdir/busybox/nbd, OpenSSH utilities, POSIX test, systemctl enable --now and claim_executor. busybox_bmc_build’s mkdir/tar/make/sed/cp transport sequence remains a typed-tool consumer to convert; sha256sum/jq/xorriso/sed/grep establish the pattern."),
    p(text: "Absolute program paths require observed target-host facts: mkdir/chmod cite sudoers NOPASSWD paths. For unread BMCs, fleet hosts or runner images, resolve through the target PATH; do not invent filesystem facts."),
  ]
}

fn taad_sequence() -> List<MarkdownBlock> {
  [
    p(text: "Validate with a coverage/anti-regression lens over argv arrays and known tools: a new HTTP operation without modeled success must red; the final count is zero unmodeled-success HTTP operations. The historical file/argv census is not live coverage. Lane B follows shell→intent per real consumer; no big-bang sweep or parallel option vocabulary."),
  ]
}

fn transport_argv_anemia_dissolution_body() -> List<MarkdownBlock> {
  concat(taad_intro(),
  concat(taad_decode(),
  concat(taad_target(),
  concat(taad_lanes(), taad_sequence()))))
}

data transport_argv_anemia_dissolution_plan: Plan = Plan {
  projection: PlanIsAuthorityOnly { ruling: project_documentation_projections_are_not_checkout_artifacts },
  slug: "transport-argv-anemia-dissolution",
  title: "Transport-argv anemia dissolution — model the request, derive the argv (kill the fail-open class by construction)",
  body: transport_argv_anemia_dissolution_body(),
  retirement: PlanRetiresWhen { condition: unbound_dissolution(description: "Dissolves when every HTTP operation is a declarative transport rest row (curl argv derived, fail-closed by construction, the interim --fail-with-body patches removed) AND the non-HTTP tool argv is modeled through extdeps/tools/* or emitted via the shell -> intent lane — no bare flag-string survives as load-bearing. redfish_http_hardwired_transport_note and http_client_handler_layering_note dissolve with Lane A (their shared dissolution). Tracked green by a coverage lens over argv arrays: zero unmodeled-success HTTP ops.") },
}
