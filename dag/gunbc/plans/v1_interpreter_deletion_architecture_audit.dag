module gunbc.plans.v1_interpreter_deletion_architecture_audit

import gunbc.plan { Plan, DissolutionTrigger, HasTrigger }
import std.markdown { MarkdownBlock, TableBlock, AlignNone }
import gunbc.plans.md_helpers { h2, h3, p, li, ul, ol, quote, cell, row }

fn v1_interpreter_deletion_architecture_audit_body() -> List<MarkdownBlock> {
  [
    p(text: "**Status:** audit-first deletion architecture (session smart-fox-879, 2026-07-26) · **INVESTIGATION ONLY — no `v1_interpreter.rs` code in this slice** · **DESIGN.md + the carriers remain the authority** (DESIGN §6). **`dag/gunbc/plans/v1_interpreter_deletion_architecture_audit.dag` is the authority**; generated md is its PlanArtifact projection. Parent seam: [interpreter-kernel-d](interpreter-kernel-d.md) + `gunbc.interpreter_kernel_model`. Companion: [cli-run-hollowing-plan](cli-run-hollowing-plan.md) §2.13 host-builtin bridge."),
    quote(blocks: [
      p(text: "**Read in 5 minutes.** `v1_interpreter.rs` (~11.5k LOC, 364 fns, measured 2026-07-26) is a **hybrid seed**: pure expression evaluation + host-effect dispatch. Total deletion is **not** one file delete — the seam splits on decidability per `gunbc.interpreter_kernel_model`. This audit derives the **operation-keyed effect-provider census**, separates semantic evaluation from filesystem/process/network/cache/fixture/resource guards, inventories std/extdeps models, and names misalignments that block clean deletion."),
    ]),
    h2(text: "0. Seam classification (landed model)"),
    TableBlock {
      header: row(cells: [cell(text: "class"), cell(text: "carrier"), cell(text: "deletion disposition")]),
      alignments: [AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "pure-eval authority"), cell(text: "`05_eval.dag` · `emit_host.dag` · `v2_evaluator.dag` · `host_transport.dag` · `host_run.dag`"), cell(text: "emit from v2; shrink eval core out of seed")]),
        row(cells: [cell(text: "pinned host-physics"), cell(text: "`recorded_fixture.rs` · `resolved_graph_cache.rs`"), cell(text: "terminal kernel until Materialization `CacheLookupResult` fold")]),
        row(cells: [cell(text: "hybrid remainder"), cell(text: "`v1_interpreter.rs` effect bridge + bridge builtins"), cell(text: "split: eval → GENERATED; dispatch → thin tap or `.dag` handlers")]),
      ],
    },
    h2(text: "1. Operation-keyed effect-provider census"),
    p(text: "**Key:** `Service.Operation` string (e.g. `git.Core.DiffUnified0`). Discovered at `InterpContext` construction from import-closure service items (`service_ops: HashMap<String, ServiceOp>`). Dispatch entry: `eval_method_call` → `eval_service_call` → mode branch → `dispatch_service_wet`."),
    h3(text: "1.1 Corpus scale (extdeps authority, measured 2026-07-26)"),
    ul(items: [
      li(text: "**84** services in `dag/extdeps/`"),
      li(text: "**~197** operations"),
      li(text: "**35** module files with `transport shell`"),
      li(text: "**27** module files with `transport rest`"),
      li(text: "**2** module files with `transport file` (`Filesystem.*`)"),
    ]),
    h3(text: "1.2 Provider routing (`dispatch_service_wet`)"),
    TableBlock {
      header: row(cells: [cell(text: "provider"), cell(text: "selection"), cell(text: "host physics"), cell(text: "examples")]),
      alignments: [AlignNone, AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "Native env"), cell(text: "`intent == shell.Env.Get`"), cell(text: "`std::env::var` (no subprocess)"), cell(text: "`shell.Env.Get`")]),
        row(cells: [cell(text: "Shell transport"), cell(text: "`is_shell_transport` (= transport has body)"), cell(text: "`std::process::Command`, wall-budget SIGKILL, argv E2BIG"), cell(text: "`git.Core.*`, `shell.Exec.*`, `Clock.UnixSecs`, `systemd.*`, `extdeps/tools/*`")]),
        row(cells: [cell(text: "File transport"), cell(text: "`is_file_transport` (= has `base_path`)"), cell(text: "`std::fs::{read,write,remove,read_dir}`"), cell(text: "`Filesystem.Read/Write/Delete/List`")]),
        row(cells: [cell(text: "REST transport"), cell(text: "fallback after shell/file"), cell(text: "HTTP client (TLS, auth, body)"), cell(text: "`github.*`, `gcp.*`, `http.Client.*`, `redfish.Http.*`, `llm.*`")]),
        row(cells: [cell(text: "Fixture replay"), cell(text: "Hermetic + `fixture_store`"), cell(text: "`recorded_fixture.rs` lookup by `(op_key, inputs_hash)`"), cell(text: "any imported service op")]),
        row(cells: [cell(text: "Published mock"), cell(text: "Hermetic + governed service + no fixture"), cell(text: "`eval_mock_response` from op `mock_response` block"), cell(text: "M4 `PublishedMockCase` corpus")]),
        row(cells: [cell(text: "Checkout carve-out"), cell(text: "Hermetic + `Filesystem.Read` + path under cwd minus `.git`/`target`"), cell(text: "real disk read as injected input"), cell(text: "corpus `.dag` reads")]),
      ],
    },
    h3(text: "1.3 Direct builtins (bypass service-op model)"),
    TableBlock {
      header: row(cells: [cell(text: "builtin"), cell(text: "provider"), cell(text: "notes")]),
      alignments: [AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "`filesystem_read`"), cell(text: "routes through `Filesystem.Read` if in closure"), cell(text: "§3 duplicate of service op + checkout carve-out")]),
        row(cells: [cell(text: "`emit_host_run_transport`"), cell(text: "temp workspace + cargo build + run"), cell(text: "requires `EffectAdmission::Admitted`; modeled in `emit_host.dag`")]),
        row(cells: [cell(text: "`emit_host_run_transport_cached`"), cell(text: "same + `.native_ready` warm marker"), cell(text: "native artifact cache; `std.emit_on_demand` authority")]),
        row(cells: [cell(text: "`emit_host_native_cache_evict`"), cell(text: "`std::fs::remove_dir_all`"), cell(text: "hermetic refuses")]),
        row(cells: [cell(text: "`observed_peak_resident_bytes`"), cell(text: "`/proc/self/status` VmHWM"), cell(text: "fail-closed if unavailable")]),
      ],
    },
    h3(text: "1.4 Bridge builtins (host-fed facts — not transport, but block pure-eval emit)"),
    p(text: "**~15 live projection bridges** (`resolve_type_node`, `symbol_*`, `*_facts_live`, `inert_lens_*`, …) delegate to `coproduct_reflection` or `cli_run` regex scans. **~30+ census/hygiene builtins** (`layer_import_facts`, `import_resolution_facts`, `non_fold_residue_*`, `fallback_arm_census_*`, `test_migration_debt_*`, …). Per cli-run-hollowing §2.14: each retires when its lens reads the node tree (#5364 class)."),
    h2(text: "2. Semantic evaluation vs guards"),
    h3(text: "2.1 Pure semantic evaluation (migrate to `05_eval` / emitted)"),
    ul(items: [
      li(text: "`Value` / `Env` / `CanonKey` / `InterpError` — runtime representation"),
      li(text: "`eval_expr*` / `eval_call` / `eval_match` / `eval_record_lit` — expression semantics"),
      li(text: "Pure builtins: strings, lists, maps, sets, hashes, folds, witnesses, contiguous-loop kernels"),
      li(text: "In-process memo: `eval_call_memo`, `pure_call_memo`, `parse_table_memo`"),
      li(text: "Per-ctx caches: `data_cache`, `param_name_cache`, `var_sym_cache`, `call_func_name_cache`"),
    ]),
    h3(text: "2.2 Resource / execution guards (not effect providers)"),
    TableBlock {
      header: row(cells: [cell(text: "guard"), cell(text: "location"), cell(text: "role")]),
      alignments: [AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "`ExecutionMode` Hermetic/Wet/Record"), cell(text: "`eval_service_call`"), cell(text: "fixture vs real dispatch")]),
        row(cells: [cell(text: "`effect_dispatch_count`"), cell(text: "`InterpContext`"), cell(text: "memo purity: WorldRead invalidates `eval_call_memo`")]),
        row(cells: [cell(text: "`fixture_store`"), cell(text: "`InterpContext`"), cell(text: "hermetic replay / record capture")]),
        row(cells: [cell(text: "`published_mock_keys` / `governed_services`"), cell(text: "lazy from `PublishedMockCase` data"), cell(text: "M4 hermetic governance")]),
        row(cells: [cell(text: "`hermetic_checkout_read_disposition`"), cell(text: "Filesystem carve-out"), cell(text: "commit-deterministic input access")]),
        row(cells: [cell(text: "`ExpectationDeclaration` / `ExpectedOutcome`"), cell(text: "per call-site `expect:`"), cell(text: "output policy; untraced default counted frontier")]),
        row(cells: [cell(text: "wall-budget / process-group kill"), cell(text: "`dispatch_shell`"), cell(text: "subprocess timeout")]),
        row(cells: [cell(text: "`ArgvExceedsHostArgMax`"), cell(text: "shell argv materialization"), cell(text: "E2BIG fail-closed")]),
        row(cells: [cell(text: "`CALL_DEPTH_LIMIT`"), cell(text: "`call_function` / closures"), cell(text: "refuse vs stack overflow")]),
        row(cells: [cell(text: "`require_admitted_transport`"), cell(text: "emit_host builtins"), cell(text: "`build_transport_admission` grant gate")]),
        row(cells: [cell(text: "output / effect-stream policy"), cell(text: "`set_output_policy`, `set_effect_stream_policy`"), cell(text: "trace suppression — `.dag` authority mirrored in seed")]),
      ],
    },
    h3(text: "2.3 Cache layers (distinct from fixture)"),
    ul(items: [
      li(text: "**In-ctx memo** (`data_cache`, eval memos) — per `InterpContext`; dies with eval"),
      li(text: "**`resolved_graph_cache.rs`** — cross-run, content-hash keyed, disk — **pinned host-physics**"),
      li(text: **`emit_host_run_transport_cached` `.native_ready`** — cross-run native artifact warm tier; modeled in `std.emit_on_demand` / `extdeps.realization.native_artifact_cache`"),
    ]),
    h2(text: "3. std/extdeps models vs v1 realization"),
    TableBlock {
      header: row(cells: [cell(text: "model"), cell(text: "module"), cell(text: "v1 relationship")]),
      alignments: [AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "Service-op + transport"), cell(text: "`dag/extdeps/**`"), cell(text: "**primary v1 dispatch authority** — shape in `.dag`, realization in seed")]),
        row(cells: [cell(text: "HostTransportDescriptor"), cell(text: "`v2.std.host_transport`"), cell(text: "modeled emit-host; seed builtins are only realization")]),
        row(cells: [cell(text: "emit_host pipeline"), cell(text: "`v2.compiler.emit_host`"), cell(text: "calls seed intrinsics; admission via `build_transport_admissible`")]),
        row(cells: [cell(text: "Effect grants"), cell(text: "`std.effect_grant`"), cell(text: "`admit_effect` at P-B seams — **not** wired into service-op dispatch")]),
        row(cells: [cell(text: "Effect-io host grant"), cell(text: "`v2.extdeps.runtimes.effect_io_host_grant`"), cell(text: "envelope per backend; frontier: v1 still uses ExecutionMode at dispatch")]),
        row(cells: [cell(text: "HostEffect coproduct"), cell(text: "`gunbc.host_effect` + `host_effect_realize`"), cell(text: "runtime-present spine — **parallel** to service-op path")]),
        row(cells: [cell(text: "EffectPlan"), cell(text: "`v2.std.effect_plan`"), cell(text: "composition algebra; leaves are `Do{effect}`")]),
        row(cells: [cell(text: "ResourceEffectBoundary"), cell(text: "`v2.std.runtime`"), cell(text: "v2_evaluator sets all allowances false — no v2 eval effects yet")]),
        row(cells: [cell(text: "Recorded fixtures"), cell(text: "`recorded_fixture.rs` + `PublishedMockCase`"), cell(text: "hermetic replay store")]),
        row(cells: [cell(text: "Resolved graph cache"), cell(text: "`extdeps.realization.resolved_graph` + seed"), cell(text: "cross-run resolve memo")]),
        row(cells: [cell(text: "Operation argv"), cell(text: "`v2.std.operation_argv`"), cell(text: "`shell_materialize_operation_argv` builtin mirrors `ArgvRefusalCause`")]),
      ],
    },
    h2(text: "4. Misalignments blocking deletion"),
    ol(items: [
      li(text: "**Dual effect authorities (highest priority).** Three parallel stacks: (1) service-op + `ExecutionMode`, (2) `std.effect_grant` Envelope at P-B seams only, (3) `gunbc.host_effect` apply for runtime-present sites. `effect_io_host_grant.dag` documents the frontier: seed dispatch still re-reads ExecutionMode."),
      li(text: "**emit_host modeled / seed-realized split.** `run_host_process` structurally complete; realization only via `eval_emit_host_run_transport*` builtins. Kernel D follow-on: wire `HostTransportDescriptor` into interpreter tap."),
      li(text: "**`ExecutionMode` conflation.** Bundles transport selection, fixture record, checkout carve-out, and partial emit_host admission. Open thread: dissolve into `(frame × verb × subtree)` grants."),
      li(text: "**`filesystem_read` duplicate surface.** Builtin re-implements `Filesystem.Read` with hermetic checkout logic — §3 nicknaming."),
      li(text: "**Bridge builtin / cli_run coupling.** ~40 `eval_builtin` arms call `cli_run` host feeds; misplaced in interpreter, block pure-eval emit surface."),
      li(text: "**v2 evaluator effect vacuum.** `ResourceEffectBoundary` all-deny; all effects exit through v1 until `EffectHandlerBinding` lands."),
      li(text: "**Transport detection heuristics.** `is_shell_transport` = has body; `is_file_transport` = has `base_path` — structural, not typed. Modeled counterpart: `ExtdepsTransportKind` rows (partial in shape-transport-policy lens)."),
      li(text: "**Vacuous `uses` clause.** `effect_dispatch_count` memo gate; no corpus func declares `uses` — odometer is backstop, not modeled effect declaration."),
    ]),
    h2(text: "5. Deletion sequencing (recommended PR slices)"),
    ol(items: [
      li(text: "**Phase A — pure eval emit (kernel D, in progress):** emit eval core from `05_eval.dag`; leave `eval_service_call` + transports in seed."),
      li(text: "**Phase B — effect bridge consolidation:** wire `HostTransportDescriptor` for emit-host; route runtime-present sites through `host_effect_apply`; replace ExecutionMode transport selection with grant `HandlerBinding` at envelope construction."),
      li(text: "**Phase C — bridge builtin dissolution:** per-lens node-tree readers retire `*_facts_live` / census builtins (#5364)."),
      li(text: "**Phase D — pinned kernel terminal:** collapse `recorded_fixture.rs` + `resolved_graph_cache.rs` onto Materialization `CacheLookupResult` fold."),
    ]),
    h2(text: "6. Explicit non-goals (this audit slice)"),
    ul(items: [
      li(text: "No `v1_interpreter.rs` refactor or LOC deletion."),
      li(text: "No `emit_host.dag` transport wiring PR (separate kernel-D follow-on)."),
      li(text: "No `regen --verify` flip or bulk HAND→GENERATED cutover."),
    ]),
  ]
}

data v1_interpreter_deletion_architecture_audit_plan: Plan = Plan {
  slug: "v1-interpreter-deletion-architecture-audit",
  title: "v1_interpreter host physics and effect bridge — deletion architecture audit",
  body: v1_interpreter_deletion_architecture_audit_body(),
  dissolution: HasTrigger {
    text: "Dissolves when kernel D Phase A–D land and this census is superseded by the frontier carrier + interpreter_kernel_model receipts — every misalignment row in §4 has a named consumer or is closed, and the operation-keyed provider table is generated from extdeps transport rows rather than hand-maintained in prose."
  }
}
