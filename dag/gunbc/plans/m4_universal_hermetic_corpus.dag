module gunbc.plans.m4_universal_hermetic_corpus


fn m4_universal_hermetic_corpus_body() -> List<std.markdown.MarkdownBlock> {
  [
    gunbc.plans.md_helpers.p(text: "**Status:** PLAN-FIRST · worker `fierce-crab-852` · DESIGN.md §3/§5/§6 authority — this doc is a dispatch tracker, not a fact ledger."),
    gunbc.plans.md_helpers.p(text: "**Predecessor:** M4.0 (#5188) — `eval_service_call` reads the published mock corpus as the single authority for hermetic realizability, but only from the **entry import closure** (`item_registry`). Filesystem co-locates its corpus via `import extdeps.filesystem.mock_corpus` in `filesystem_io.dag` (M4.0 per-layer opt-in). GovernedProbe keeps corpus in the same module as the service."),
    gunbc.plans.md_helpers.p(text: "**Problem:** Closure-scoped corpus resolution lets an entry **opt out** of governance by omitting the corpus import — the runtime and the M2 `mock_totality_lens` then read **different** models. §3 nicknaming trap: co-location is a transport workaround, not the authority fact."),
    std.markdown.ThematicBreak,
    gunbc.plans.md_helpers.h2(text: "0. Thesis — governance is universal, not opt-in"),
    std.markdown.CodeBlock { code: "  dag/ whole-tree published mock corpora     ← SINGLE authority (same modules M2 lens imports)\n    → precompute operation-key set ONCE per batch (whole-tree compile of dag/ roots)\n      → InterpContext carries immutable published_mock_keys + governed_services (O(1))\n        → eval_service_call: corpus-governed service + unpublished op → §5 fail-closed\n          → fixture replay OR inline mock (corpus-free services only)\n" },
    gunbc.plans.md_helpers.p(text: "The entry import closure decides **which code runs**; it must NOT decide **which operations are hermetically realizable**. That fact is global over the dag/ tree."),
    std.markdown.ThematicBreak,
    gunbc.plans.md_helpers.h2(text: "Phase 1 — PLAN-FIRST (model + witnesses before runtime)"),
    std.markdown.TableBlock {
      header: gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "Artifact"), gunbc.plans.md_helpers.cell(text: "Role")]),
      alignments: [std.markdown.AlignNone, std.markdown.AlignNone],
      rows: [
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "`dag/std/hermetic_replay.dag`"), gunbc.plans.md_helpers.cell(text: "Add `service` + `operation` fields on `PublishedMockCase` (alongside `operation_key` until dissolve)")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "`dag/test/fixture/m4_universal_governed_probe.dag`"), gunbc.plans.md_helpers.cell(text: "Service-only module (no corpus)")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "`dag/test/fixture/m4_universal_governed_corpus.dag`"), gunbc.plans.md_helpers.cell(text: "Corpus-only module (NOT imported by witness entry)")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "`dag/test/claim/m4_universal_corpus_witness.dag`"), gunbc.plans.md_helpers.cell(text: "§5 discriminating pair: GREEN published / RED unpublished **without** corpus in closure")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "`interp_recorded_fixture_test.rs`"), gunbc.plans.md_helpers.cell(text: "Subprocess proof on real `claim_batch` path")]),
      ],
    },
    gunbc.plans.md_helpers.p(text: "**RED before runtime:** witness entry imports probe service only → M4.0 closure scan misses corpus → `Forbidden` silently uses inline mock (vacuous). **GREEN after M4.1:** whole-tree precompute finds corpus → fail-closed on unpublished op."),
    std.markdown.ThematicBreak,
    gunbc.plans.md_helpers.h2(text: "Phase 2 — Runtime (load-bearing `v1_interpreter.rs` + `cli_run.rs`)"),
    gunbc.plans.md_helpers.ol(items: [
      std.markdown.MarkdownListItem { blocks: [
        gunbc.plans.md_helpers.p(text: "**`precompute_whole_tree_published_mock_keys(source_roots)`** in `cli_run.rs`"),
        gunbc.plans.md_helpers.ul(items: [
          gunbc.plans.md_helpers.li(text: "Scan dag source roots (paths ending in `/dag` or named `dag`)"),
          gunbc.plans.md_helpers.li(text: "`resolved_graph_from_sources(all modules)` — same tree `dag_compile_clean` validates"),
          gunbc.plans.md_helpers.li(text: "Evaluate every `data` item declared over `PublishedMockCase` (existing shape gate)"),
          gunbc.plans.md_helpers.li(text: "Return `HashSet<String>` of operation keys"),
        ]),
      ] },
      std.markdown.MarkdownListItem { blocks: [
        gunbc.plans.md_helpers.p(text: "**`InterpContext` extensions**"),
        gunbc.plans.md_helpers.ul(items: [
          gunbc.plans.md_helpers.li(text: "`whole_tree_published_keys: Option<Rc<HashSet<String>>>` — when set, supersedes closure scan"),
          gunbc.plans.md_helpers.li(text: "`governed_services: RefCell<Option<Rc<HashSet<String>>>>` — service names extracted once; `eval_service_call` uses `governed_services.contains(service_name)` (O(1)) instead of scanning all keys per call"),
        ]),
      ] },
      std.markdown.MarkdownListItem { blocks: [
        gunbc.plans.md_helpers.p(text: "**`make_eval_context_with_published_keys`** — thread precomputed keys from `claim_batch` / `handle_run_with_options` (precompute once per invocation, not per witness)"),
      ] },
      std.markdown.MarkdownListItem { blocks: [
        gunbc.plans.md_helpers.p(text: "**Key extraction** — prefer `service` + `operation` fields when present; fall back to `operation_key` during migration"),
      ] },
    ]),
    std.markdown.ThematicBreak,
    gunbc.plans.md_helpers.h2(text: "Phase 3 — Dissolve M4.0 opt-in"),
    std.markdown.TableBlock {
      header: gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "Mark"), gunbc.plans.md_helpers.cell(text: "Action")]),
      alignments: [std.markdown.AlignNone, std.markdown.AlignNone],
      rows: [
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "`feature:m4-universal-hermetic-corpus-load`"), gunbc.plans.md_helpers.cell(text: "Delete `import extdeps.filesystem.mock_corpus` from `filesystem_io.dag`")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "`feature:hermetic-published-mock-operation-ref`"), gunbc.plans.md_helpers.cell(text: "Delete `operation_key: String` once all rows carry `service` + `operation`")]),
      ],
    },
    std.markdown.ThematicBreak,
    gunbc.plans.md_helpers.h2(text: "§5 proof obligations"),
    std.markdown.TableBlock {
      header: gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "Witness"), gunbc.plans.md_helpers.cell(text: "GREEN"), gunbc.plans.md_helpers.cell(text: "RED (teeth)")]),
      alignments: [std.markdown.AlignNone, std.markdown.AlignNone, std.markdown.AlignNone],
      rows: [
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "`m4_governed_service_witness` (M4.0, corpus co-located)"), gunbc.plans.md_helpers.cell(text: "`Allowed` realizes"), gunbc.plans.md_helpers.cell(text: "`Forbidden` fail-closed")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "`m4_universal_corpus_witness` (M4.1, corpus **outside** closure)"), gunbc.plans.md_helpers.cell(text: "`Allowed` realizes"), gunbc.plans.md_helpers.cell(text: "`Forbidden` fail-closed")]),
        gunbc.plans.md_helpers.row(cells: [gunbc.plans.md_helpers.cell(text: "`filesystem` hermetic tests"), gunbc.plans.md_helpers.cell(text: "Read/Write governed without co-location import"), gunbc.plans.md_helpers.cell(text: "absent op fail-closed")]),
      ],
    },
    std.markdown.ThematicBreak,
    gunbc.plans.md_helpers.h2(text: "Open / deferred"),
    gunbc.plans.md_helpers.ul(items: [
      gunbc.plans.md_helpers.li(text: "**M5:** RecordedFixture store fork dissolution (unchanged from M4.0)"),
      gunbc.plans.md_helpers.li(text: "**Projection lens:** `feature:filesystem-mock-corpus-from-service-decl` — corpus projected from `service Filesystem` operation set (bind `node://adhoc-a9399cb3-628`)"),
      gunbc.plans.md_helpers.li(text: "**v2 std resolve:** delete `src/v2/std/hermetic_replay.dag` mirror when cross-tree import lands"),
    ]),
  ]
}

data m4_universal_hermetic_corpus_plan: gunbc.plan.Plan = gunbc.plan.Plan {
  slug: "m4-universal-hermetic-corpus",
  title: "gunbc.plan.Plan — M4.1: universal hermetic corpus governance",
  body: m4_universal_hermetic_corpus_body(),
  dissolution: gunbc.plan.HasTrigger {
    text: "Dissolve this tracker when M4.1 universal governance has landed and M4.0 opt-in is gone — `precompute_whole_tree_published_mock_keys` is the single authority, `m4_universal_corpus_witness` is green-by-execution on the floor, and the Phase-3 marks (`feature:m4-universal-hermetic-corpus-load`, `feature:hermetic-published-mock-operation-ref`) have fired (corpus co-location import + `operation_key` deleted) — at which point governance is universal-by-construction and this doc is redundant."
  }
}
