module gunbc.scm.write_spine

// THE TWO AUTHORING VERBS -- STAGE ONE SOURCE AT ONE PATH, AND FREEZE WHAT IS STAGED.
//
// WHAT THIS MODULE IS NOT ALLOWED TO DO, and it is the whole reason it is separate from an ingress.
// Neither verb here performs a host effect. `add` reads a file and `commit` does not, and the second
// half of that sentence is a correctness property rather than an efficiency one: a commit that
// re-read the worktree would freeze the bytes present at the instant of the COMMIT, not the bytes the
// author staged and then inspected. Every intervening edit would be swept in silently and the author
// would be told their reviewed snapshot was committed. That is the fabricated-plausible-output
// failure DESIGN section 5 forbids, and the only structural defence against it is that the commit
// verb has no filesystem operation to reach for -- so the read lives in the ingress and the freeze
// lives here, and the staged manifest is the only channel between them.
//
// STAGING IS A SNAPSHOT EDIT, NOT A PATCH. `gunbc.scm.staging.effective_candidate` already carries
// the whole of that reasoning and the data-loss defect that produced it: an absent stage inherits the
// checked-out commit's full corpus rather than answering with the empty one. This module consumes
// that decision and does not re-derive it, so an `add` of one path can never delete the paths nobody
// touched.

import std.types { String, NonEmptyStr, Int, List }
import gunbc.scm.object_store {
  ObjectId,
  AuthoredSourceObjectRef, authored_source_target_of,
  CorpusManifestObjectRef, CorpusManifestEntry, CorpusManifestRecord, CorpusManifestTarget,
  SourceStoreOutcome, SourceStored, SourceLocatorCollision, store_authored_source,
  PathUniqueManifestEntries, manifest_entries_with_path_replaced, manifest_entries_of_single,
  UniqueManifestStoreOutcome, UniqueManifestStored, UniqueManifestLocatorCollision,
  store_path_unique_manifest,
}
import gunbc.scm.repository_envelope {
  RepositoryEnvelope, RepositoryCommitRef,
  RepositoryManifestRoot,
  RepositoryManifestRootResolved, RepositoryManifestRootMissing,
  RepositoryManifestRootIsAuthoredSource, RepositoryManifestRootIsSemanticNode,
  repository_root_by_resolving,
}
import gunbc.scm.ordinary_commit {
  OrdinaryCommitMint, OrdinaryCommitMinted,
  OrdinaryCommitAllocatorInvalid, OrdinaryCommitParentMissing,
  mint_ordinary_commit,
}
import gunbc.scm.staging {
  StagingRefusal, EffectiveCandidate,
  CandidateFromStage, CandidateInheritedFromBase, CandidateEmptyCorpus, CandidateRefused,
  effective_candidate,
  StageStanding, StageMatchesBase, StageDiffersFromBase, StageWithNoBase,
  NoCandidateAndNoBase, StageStandingRefused,
  StageManifestMissingFromStore, StageManifestIsAuthoredSource, StageManifestIsSemanticNode,
  stage_standing,
}

// THE STAGING OUTCOME. Each refusal names a different owner and a different repair, which is why the
// two collision arms are not folded together: a source-locator collision says the object table
// already holds a DIFFERENT file under this file's identity, and a manifest-locator collision says
// the same about the snapshot.
//
// THERE IS NO DUPLICATE-PATH ARM. An earlier revision carried one and argued for keeping it on the
// ground that `store_corpus_manifest` owns that decision. That reasoning is what the carry_mint class
// looks like from the inside: this verb cannot produce a duplicate, so carrying the generic authority's
// arm described the CALLEE's domain in this operation's signature. The route now ends at
// `store_path_unique_manifest`, whose outcome has no such arm -- see `stage_source_at_path`.
type StageIngress
  = Staged {
      repository: RepositoryEnvelope,
      manifest: CorpusManifestObjectRef,
      source: AuthoredSourceObjectRef
    }
  | StageCandidateRefused { cause: StagingRefusal }
  | StageSourceLocatorCollision { identity: ObjectId }
  | StageManifestLocatorCollision { identity: ObjectId }

// THE CANDIDATE AS A RECORD, OR THE REFUSAL THAT MEANS THERE IS NONE. The empty-corpus arm is its own
// answer and NOT an empty record, which is the distinction staging spent a data-loss incident
// establishing: no history is an empty corpus, an unreadable base is not.
type CandidateRecord
  = CandidateRecordIs { record: CorpusManifestRecord }
  | CandidateRecordEmptyCorpus
  | CandidateRecordRefused { cause: StagingRefusal }

fn candidate_record(repository: RepositoryEnvelope) -> CandidateRecord {
  match effective_candidate(repository: repository) {
    CandidateRefused { cause: c } => CandidateRecordRefused { cause: c }
    CandidateEmptyCorpus => CandidateRecordEmptyCorpus
    CandidateFromStage { record: r } => CandidateRecordIs { record: r }
    CandidateInheritedFromBase { record: r } => CandidateRecordIs { record: r }
  }
}

// `add`, WITH THE BYTES ALREADY IN HAND.
//
// The text is a parameter rather than a path this function reads, so the identity of what gets staged
// is fixed by the caller's observation and cannot drift between the observation and the store. The
// ingress that performs the observation is `gunbc.scm.write_spine_ingress`; it is separate because
// this fold must remain runnable where no filesystem exists.
//
// THERE IS NO DUPLICATE-PATH ARM, AND THAT IS A CONSTRUCTION RESULT RATHER THAN AN OMISSION. An earlier
// revision carried one, because `store_corpus_manifest` accepts an arbitrary list and must ask. This
// route cannot produce a duplicate -- it derives its entries from a `CorpusManifestRecord`, whose
// sole constructor already admitted them as path-unique, by removing one path and appending exactly
// one entry -- and it now says so in the only way that counts: it hands
// `store_path_unique_manifest` a `PathUniqueManifestEntries`, whose outcome has no duplicate arm to
// match. The first version instead kept the arm and explained in a comment that it was unreachable,
// which is a signature that lies with a footnote. Found by external review.
fn stage_source_at_path(
  repository: RepositoryEnvelope,
  path: NonEmptyStr,
  text: String,
) -> StageIngress {
  match candidate_record(repository: repository) {
    CandidateRecordRefused { cause: c } => StageCandidateRefused { cause: c }
    CandidateRecordEmptyCorpus =>
      stage_into(repository: repository, base: none, path: path, text: text)
    CandidateRecordIs { record: record } =>
      stage_into(repository: repository, base: Present { value: record }, path: path, text: text)
  }
}

fn stage_into(
  repository: RepositoryEnvelope,
  base: CorpusManifestRecord?,
  path: NonEmptyStr,
  text: String,
) -> StageIngress {
  match store_authored_source(store: repository.store, text: text) {
    SourceLocatorCollision { identity: id, existing: _, incoming: _ } =>
      StageSourceLocatorCollision { identity: id }
    SourceStored { store: with_source, source: source } => {
      let target = authored_source_target_of(reference: source)
      let unique = match base {
        Absent => manifest_entries_of_single(path: path, source: target)
        Present { value: record } =>
          manifest_entries_with_path_replaced(base: record, path: path, source: target)
      }
      match store_path_unique_manifest(store: with_source, unique: unique) {
        UniqueManifestLocatorCollision { identity: id, existing: _, incoming: _ } =>
          StageManifestLocatorCollision { identity: id }
        UniqueManifestStored { store: with_manifest, manifest: manifest } =>
          Staged {
            repository: RepositoryEnvelope {
              store: with_manifest,
              commits: repository.commits,
              commit_allocator: repository.commit_allocator,
              checked_out: repository.checked_out,
              staged: Present { value: manifest },
            },
            manifest: manifest,
            source: source,
          }
      }
    }
  }
}

// `commit`.
//
// THE ROOT IS THE MANIFEST THE CANDIDATE ALREADY NAMES, TAKEN AS A BRAND RATHER THAN AS A LOCATOR.
// `stage_standing` hands back the reference the STORE produced for the record it actually found, so
// this verb never re-resolves and never has an opportunity to name a manifest the store does not
// hold. That is why the refusal surface below has no root-missing or wrong-kind arm: those states are
// not reachable from a branded root, and minting an arm for them would be a fabricated cause.
//
// IT ASKS `stage_standing`, NOT `effective_candidate`, AND THE FIRST WRITING ASKED THE WRONG ONE.
// `effective_candidate` answers WHAT the snapshot is; `stage_standing` answers whether that snapshot
// DIFFERS FROM THE ONE ALREADY COMMITTED. Committing needs the second, and asking the first admitted a
// commit that changes nothing:
//
//   commit C           -> checked_out = C, staged = Absent
//   commit again       -> the candidate is INHERITED FROM C, so its root IS C's root
//                      -> a second commit mints, with the same root and a new identity
//
// An empty change reported as a change, and the history grows a row that froze nothing. This
// module's own annotation two paragraphs down named that exact defect as the reason the stage must be
// consumed -- and then let it in through the inheritance door instead. The same arm also covers the
// case an author reaches deliberately: staging bytes that reproduce the committed manifest is a
// no-op, and it must be reported as one rather than minted.
//
// COMMITTING WITH NOTHING TO FREEZE IS A REFUSAL, NOT A NO-OP AND NOT AN EMPTY COMMIT. A repository
// with no checkout and no stage has no snapshot to freeze; answering with the empty corpus would
// commit a deletion of everything the author never asked for, which is the same widening the staging
// module refuses one level down.
//
// AND THERE IS NO INTEGRATION-SOURCE ARM, BECAUSE THE CONSTRUCTION THIS VERB INVOKES HAS NO
// INTEGRATION SOURCE. An earlier revision carried one and admitted in its own comment that it could
// not arise -- the `carry_mint` error this stack has already paid for once: honest about the callee's
// domain and dishonest about this operation's. The repair is not to re-report it or to translate it,
// but to invoke a construction from which the question is ABSENT: `mint_ordinary_commit` takes no
// integration argument, so there is no source that could be missing.
type StagedCommit
  = StagedCommitMinted { repository: RepositoryEnvelope, reference: RepositoryCommitRef }
  | StagedCommitCandidateRefused { cause: StagingRefusal }
  | StagedCommitNothingToFreeze
  | StagedCommitAllocatorInvalid { next_ordinal: Int }
  | StagedCommitParentMissing { parent: RepositoryCommitRef }

// THE COMMIT ADVANCES THE CHECKOUT AND CONSUMES THE STAGE IN ONE MOTION, and neither half is
// optional. Leaving the checkout behind would make the next `add` inherit from the OLD snapshot, so
// the commit just made would be invisible to the corpus that follows it. Leaving the stage in place
// would make the next commit freeze the same manifest again under a new identity.
fn advance_to_commit(repository: RepositoryEnvelope, reference: RepositoryCommitRef) -> RepositoryEnvelope {
  RepositoryEnvelope {
    store: repository.store,
    commits: repository.commits,
    commit_allocator: repository.commit_allocator,
    checked_out: Present { value: reference },
    staged: none,
  }
}

fn commit_staged(repository: RepositoryEnvelope, message: String) -> StagedCommit {
  match stage_standing(repository: repository) {
    StageStandingRefused { cause: c } => StagedCommitCandidateRefused { cause: c }
    NoCandidateAndNoBase => StagedCommitNothingToFreeze
    StageMatchesBase { candidate: _ } => StagedCommitNothingToFreeze
    StageWithNoBase { candidate: root } =>
      freeze_root(repository: repository, root: root, message: message)
    StageDiffersFromBase { candidate: root, committed: _ } =>
      freeze_root(repository: repository, root: root, message: message)
  }
}

// THE ROOT IS RE-RESOLVED AGAINST THIS REPOSITORY BEFORE IT IS FROZEN, and the cost is declared rather
// than dodged. `stage_standing` already found the record, so this is a second O(n) store lookup per
// commit -- exactly what `mint_repository_commit` has always cost, and the reason it is paid here is
// that the SEAL is what makes the pairing unwritable. Threading the sealed pair out through staging
// would avoid the lookup and is the right shape once staging's carriers move; carrying a bare
// reference forward to save it would put the pairing back in the author's hands.
//
// THE THREE WRONG-KIND ARMS CANNOT FIRE FROM HERE -- the root came from a record `stage_standing` just
// resolved out of this same store -- so they are NOT re-reported as fabricated causes. They collapse to
// the candidate-refusal arm, which is what they are from this verb's point of view: the candidate this
// repository names could not be read as a manifest.
fn freeze_root(
  repository: RepositoryEnvelope,
  root: CorpusManifestObjectRef,
  message: String,
) -> StagedCommit {
  match repository_root_by_resolving(
    repository: repository,
    root: CorpusManifestTarget { locator: root.locator },
  ) {
    RepositoryManifestRootMissing { root: r } =>
      StagedCommitCandidateRefused { cause: StageManifestMissingFromStore { staged: r } }
    RepositoryManifestRootIsAuthoredSource { root: r } =>
      StagedCommitCandidateRefused { cause: StageManifestIsAuthoredSource { staged: r } }
    RepositoryManifestRootIsSemanticNode { root: r } =>
      StagedCommitCandidateRefused { cause: StageManifestIsSemanticNode { staged: r } }
    RepositoryManifestRootResolved(subject) =>
      freeze_sealed_root(subject: subject, parent: repository.checked_out, message: message)
  }
}

fn freeze_sealed_root(
  subject: RepositoryManifestRoot,
  parent: RepositoryCommitRef?,
  message: String,
) -> StagedCommit {
  match mint_ordinary_commit(
    subject: subject,
    message: message,
    parent: parent,
  ) {
    OrdinaryCommitAllocatorInvalid { next_ordinal: n } =>
      StagedCommitAllocatorInvalid { next_ordinal: n }
    OrdinaryCommitParentMissing { parent: p } => StagedCommitParentMissing { parent: p }
    OrdinaryCommitMinted { repository: minted, reference: reference } =>
      StagedCommitMinted {
        repository: advance_to_commit(repository: minted, reference: reference),
        reference: reference,
      }
  }
}
