module gunbc.scm.repository_envelope

// THE REPOSITORY ENVELOPE: the layer that gunbc.scm.commit_closure_json_v1 deliberately is not.
//
// image.dag holds ONE ROOT AND ITS CLOSURE. A repository holds facts that carrier cannot express,
// and each one is a reason this module exists rather than a field bolted onto that one:
//
//   - AN EMPTY INITIALIZED STATE. `init` produces a repository with no commits and no root at all.
//     A carrier requiring a root would force `init` to invent a phantom commit, which would then be
//     indistinguishable from a real one in the log. So `commits` may be empty and `checked_out` may
//     be absent, and neither is an error.
//   - SEVERAL COMMITS OVER ONE NODE POPULATION. Commits share structure; embedding a closure per
//     commit would re-serialize every unchanged object once per commit. One object table, and each
//     commit root is a reference into it.
//   - A CHECKED-OUT SELECTION, which is local workspace state, not authoritative history.
//
// COMMIT IDENTITY IS NOT STORED AND NOT STORABLE HERE. A commit's identity is its root object's
// identity, and that is re-derived from structure on load exactly as image.dag re-derives every
// other. `message` is a log fact and participates in no identity; two commits with identical roots
// and different messages name the SAME program, which is the point of content addressing and not a
// collision.

import std.types { Bool, Int, List, String }

import extdeps.languages.json.emit {
  JsonValue,
  JsonKeyValue,
  JsonArray,
  JsonObject,
  JsonString,
  JsonNull,
  json_kv,
  json_array,
  json_object,
  json_string,
}
import extdeps.languages.json.parse {
  JsonMemberFound,
  JsonMemberAbsent,
  JsonMemberDuplicated,
  JsonMemberNotAnObject,
  json_object_unique_member,
}

import gunbc.scm.object_store { ObjectId, ObjectStore, empty_store, object_id_eq }
import gunbc.scm.commit_closure { uncontained_targets }
import gunbc.scm.commit_closure_json_v1 {
  ClosureDocRefusal,
  ClosureDocMemberMissing,
  ClosureDocMemberDuplicated,
  ClosureDocMemberWrongShape,
  ClosureDocNotAnObject,
  ClosureDocFormatUnrecognized,
  ClosureDocRootUnresolved,
  ClosureDocEdgeTargetUnresolved,
  DecodeAcc,
  DecodePositions,
  EncodeAcc,
  encode_object_table,
  object_id_key,
  position_of,
  encoded_root_reference,
  decode_object_table,
  position_reference,
  unexpected_member_key,
  resolve_reference,
  decode_target,
  TargetDecode,
  TargetDecoded,
  TargetDecodeFailed,
  read_string_member,
  MemberString,
  MemberArray,
  MemberFailed,
  read_member,
}

// THE ENCODING IS NOT CANONICAL WITH RESPECT TO INSERTION HISTORY, and that is declared here rather
// than left for someone to discover by diffing two repositories that ought to match.
//
// Objects are emitted in store_records_in_dependency_order, which is INSERTION order. Storing
// program A then B, versus B then A, yields the same semantic repository -- the same objects, the
// same derived identities, the same commits -- but a different position assignment, hence different
// bytes. So two repositories that are semantically equal can serialize differently.
//
// What that costs: byte comparison cannot be used to decide repository equality, and a mirror or a
// content-addressed repository image is not yet expressible. What it does NOT cost: nothing about
// identity or reconstruction, because every ObjectId is derived from structure and never from a
// position -- the references are image-local addresses, so a different assignment names the same
// objects. scm_env_re_encoding_is_stable pins the weaker property that DOES hold: one image
// re-encodes to itself byte-for-byte, which is what the position references depend on.
//
// dissolve-on: a deterministic emission order -- a topological order with a content-digest tie-break
// -- which is canonical because the digests are already content-derived. That is a real change to
// encode_object_table rather than a flag, so it is a separate slice, not a footnote.
data repository_envelope_format_tag: String = "gunbc-scm-repository-v1"

// THE IDENTITY RULE IS VERSIONED SEPARATELY FROM THE SCHEMA, AND THE TWO ARE DIFFERENT AXES.
//
// repository_envelope_format_tag versions the SHAPE of this document -- which members exist and what
// they mean. It says nothing about how a structural node becomes an ObjectId. Those can move
// independently: the schema could hold still while canonicalize_node_for_content_hash or the fnv1a64
// folding changed, and every stored repository would then reconstruct to DIFFERENT identities while
// still parsing perfectly. Nothing would refuse, and the commits a user had made would silently
// become commits they had not.
//
// Naming the rule in the document turns that silent reinterpretation into a typed refusal. It is
// deliberately NOT derived from the code that implements the rule: a tag computed from the current
// implementation would agree with itself by construction and could never disagree, which is the
// change-detector failure -- it would go green precisely when the rule changed.
data repository_node_identity_rule_tag: String = "fnv1a64-structural-canonical-v1"

type RepositoryCommitRecord {
  root_reference: String
  message: String
}

type RepositoryCommit {
  root: ObjectId
  message: String
}

type RepositoryEnvelope {
  store: ObjectStore
  commits: List<RepositoryCommit>
  checked_out: ObjectId?
}

// ENCODE AND DECODE HAVE DIFFERENT FAILURE POPULATIONS, SO THEY ARE DIFFERENT TYPES.
//
// One shared RepositoryRefusal made every total consumer of an ENCODE result state how it classifies
// RepositoryUnexpectedMember -- a decode-only fact that an encoder cannot produce, because an encoder
// receives a RepositoryEnvelope and never an input JSON object. The closed coproduct was doing its
// job and the carrier was lying to it: the exhaustiveness obligation is only as honest as the type it
// ranges over, and a union of two operations' failures forces each to handle the other's impossible
// states. Caught by review after a witness had to add exactly that impossible arm.
//
// Splitting also dissolves a conflation that was already live before the member sets landed. Both
// paths spelled their unresolved reference `String`, and the two strings are different things:
//
//   encode  -- the caller handed us an ObjectId that the store or the commit list does not contain
//   decode  -- the DOCUMENT named an image-local position, and no object decoded at that position
//
// An ObjectId and a wire position are not one type because both render as text. On the encode side
// the domain type is now carried directly, so the identity no longer round-trips through a string
// nobody can resolve back.
type RepositoryEncodeRefusal
  = RepositoryEncodeClosureDocRefusal { cause: ClosureDocRefusal }
  | RepositoryCommitRootNotInStore { root: ObjectId }
  | RepositoryCheckoutNotInCommits { selected: ObjectId }

// The decode side keeps `String` references for now, and that is a REMAINING conflation rather than
// a resolved one: an image-local position is still spelled as bare text here, and image.dag's whole
// reference vocabulary would have to be typed for this to be honest. Naming it here so the next
// reader finds a declared gap instead of re-deriving it.
type RepositoryDecodeRefusal
  = RepositoryDecodeClosureDocRefusal { cause: ClosureDocRefusal }
  | RepositoryIdentityRuleUnrecognized { found: String }
  | RepositoryCommitRootReferenceUnresolved { reference: String }
  | RepositoryCheckoutReferenceUnresolved { reference: String }
  | RepositoryUnexpectedMember { context: RepositoryMemberContext, key: String }

// THE CONTEXT VOCABULARY IS THIS LAYER'S, THE MEMBERSHIP MECHANISM IS SHARED. image.dag owns
// `unexpected_member_key`, which answers a context-free question -- which key is not in this set --
// and each layer names its own shapes. Adding `RepositoryEnvelopeMembers` to image.dag's context
// coproduct would have made the lower carrier enumerate the shapes of a layer above it, which is the
// inversion DESIGN section 3 names; duplicating the fold here instead would have been a second
// authority for one rule. Neither is necessary: the mechanism generalizes, the vocabulary does not.
type RepositoryMemberContext
  = RepositoryEnvelopeMembers
  | RepositoryCommitMembers

fn repository_member_set_refusal(
  v: JsonValue,
  allowed: List<String>,
  context: RepositoryMemberContext
) -> RepositoryDecodeRefusal? {
  match unexpected_member_key(v: v, allowed: allowed) {
    Absent => none
    Present { value: key } =>
      Present { value: RepositoryUnexpectedMember { context: context, key: key } }
  }
}

type RepositoryDecodeOutcome
  = RepositoryDecoded { envelope: RepositoryEnvelope }
  | RepositoryDecodeRefused { cause: RepositoryDecodeRefusal }

fn empty_repository() -> RepositoryEnvelope {
  RepositoryEnvelope { store: empty_store(), commits: [], checked_out: none }
}

// ------------------------------------------------------------------------------------------------
// Encoding
// ------------------------------------------------------------------------------------------------

// ABSENCE IS JsonNull, NOT THE EMPTY STRING, and the distinction is load-bearing rather than
// stylistic. The empty string is already what encoded_root_reference yields for a root that names no
// object -- the value decode refuses as unresolved. Spelling "no commit is checked out" the same way
// would fuse a legitimate repository state with a corruption signal, so an empty repository and a
// repository whose checkout reference is dangling would become one state (DESIGN section 5).
// CHECKED_OUT IS A COMMIT REFERENCE, NOT A NODE REFERENCE, and that is a construction wall rather
// than a check.
//
// An earlier revision resolved it against the OBJECT TABLE, which meant a document could name a
// checkout that was not any commit -- an arbitrary interior node, a child three levels down. Nothing
// refused it, because nothing asked the question: "checked out" means POSITIONED AT A COMMIT, and
// the carrier admitted states that are not that. Resolving against the COMMIT LIST instead means the
// invalid state has no spelling in the wire format at all, so it is unwritable rather than validated
// (DESIGN section 5). An out-of-range commit index still refuses, but a non-commit checkout can no
// longer be expressed to be refused.
//
// The reference is an index into the commits array, which is image-local exactly as node positions
// are: it means "the commit at this position in this document" and nothing outside it.
// The inverse of commit_reference_of, and it walks the SAME index sequence so the two cannot drift:
// both derive a position from an ordinary counter over the commits list, rather than one of them
// parsing a number the other formatted.
fn commit_at_reference(commits: List<RepositoryCommit>, reference: String) -> RepositoryCommit? {
  match fold(
    commits,
    init: CommitLookup { index: 0, found: none },
    f: fn(acc, c) { commit_lookup_step(acc: acc, c: c, wanted: reference) }
  ) {
    CommitLookup { index: _, found: found } => found
  }
}

type CommitLookup {
  index: Int
  found: RepositoryCommit?
}

fn commit_lookup_step(acc: CommitLookup, c: RepositoryCommit, wanted: String) -> CommitLookup {
  match acc.found {
    Present { value: _ } => CommitLookup { index: acc.index + 1, found: acc.found }
    Absent =>
      if position_reference(n: acc.index) == wanted {
        CommitLookup { index: acc.index + 1, found: Present { value: c } }
      } else {
        CommitLookup { index: acc.index + 1, found: none }
      }
  }
}

fn commit_reference_of(commits: List<RepositoryCommit>, selected: ObjectId) -> String {
  match fold(
    commits,
    init: CommitSearch { index: 0, found: none },
    f: fn(acc, c) { commit_search_step(acc: acc, c: c, wanted: selected) }
  ) {
    CommitSearch { index: _, found: found } =>
      match found {
        Present { value: reference } => reference
        Absent => ""
      }
  }
}

type CommitSearch {
  index: Int
  found: String?
}

// AN UNKNOWN CHECKOUT ENCODES TO THE EMPTY REFERENCE, which decode refuses -- the same treatment
// encoded_root_reference gives a root naming no object. The encoder cannot refuse (it returns a
// JsonValue, not an outcome), so what it must not do is emit something PLAUSIBLE: silently dropping
// the checkout or substituting the first commit would produce a document that loads cleanly and
// positions the user somewhere they never were.
fn commit_search_step(acc: CommitSearch, c: RepositoryCommit, wanted: ObjectId) -> CommitSearch {
  match acc.found {
    Present { value: _ } => CommitSearch { index: acc.index + 1, found: acc.found }
    Absent =>
      if object_id_eq(left: c.root, right: wanted) {
        CommitSearch { index: acc.index + 1, found: Present { value: position_reference(n: acc.index) } }
      } else {
        CommitSearch { index: acc.index + 1, found: none }
      }
  }
}

fn encode_optional_reference(commits: List<RepositoryCommit>, selected: ObjectId?) -> JsonValue {
  match selected {
    Absent => JsonNull
    Present { value: identity } =>
      json_string(s: commit_reference_of(commits: commits, selected: identity))
  }
}

fn encode_commit_record(acc: EncodeAcc, commit: RepositoryCommit) -> JsonValue {
  json_object(
    members: [
      json_kv(key: "root", value: encoded_root_reference(acc: acc, root: commit.root)),
      json_kv(key: "message", value: json_string(s: commit.message)),
    ]
  )
}

fn encode_commit_records(acc: EncodeAcc, commits: List<RepositoryCommit>) -> List<JsonValue> {
  map(commits, c => encode_commit_record(acc: acc, commit: c))
}

// THE CODEC IS NAMED FOR THE EXACT WIRE VERSION IT UNDERSTANDS, and `encode_repository` is the
// separate question of which version we currently EMIT. They are one function today and that is
// precisely why the names must differ now rather than later: once a document exists in the world,
// the v1 body must stay frozen, and the seam that lets a v2 arrive beside it has to be somewhere no
// author is tempted to "just add the field here".
//
// THIS FABRICATES NO v2. There is no second arm, no version enum member for a format that does not
// exist, and no migration claim -- building a synthetic second version now would test an invented
// migration rather than the one the product eventually needs.
fn encode_repository(repo: RepositoryEnvelope) -> JsonValue {
  encode_repository_v1(repo: repo)
}

fn encode_repository_v1(repo: RepositoryEnvelope) -> JsonValue {
  let acc = encode_object_table(store: repo.store)
  json_object(
    members: [
      json_kv(key: "format", value: json_string(s: repository_envelope_format_tag)),
      json_kv(key: "identity_rule", value: json_string(s: repository_node_identity_rule_tag)),
      json_kv(key: "objects", value: json_array(elements: acc.objects)),
      json_kv(
        key: "commits",
        value: json_array(elements: encode_commit_records(acc: acc, commits: repo.commits))
      ),
      json_kv(key: "checked_out", value: encode_optional_reference(commits: repo.commits, selected: repo.checked_out)),
    ]
  )
}

type RepositoryEncodeOutcome
  = RepositoryEncoded { value: JsonValue }
  | RepositoryEncodeRefused { cause: RepositoryEncodeRefusal }

// THE CHECKED ENCODER IS WHAT A PERSISTENCE BOUNDARY MUST CALL, and it exists because
// encode_repository CANNOT refuse -- it returns a JsonValue, so its only honest treatment of an
// unrepresentable input is the empty reference that decode later rejects. That is correct as far as
// it goes and it arrives too late for a writer: bytes are already on disk, the operation has already
// reported success, and the corruption surfaces on the next load, to whoever loads it rather than to
// whoever caused it. So the adjudication is lifted ahead of the write.
//
// The three ways a repository can be unrepresentable are exactly the three arms below, and they are
// separate causes rather than one because their remedies differ: an unresolvable EDGE means the
// object table is an incomplete closure, an unresolvable COMMIT ROOT means a commit names an object
// the store does not hold, and an unresolvable CHECKOUT means the selection names a non-commit.
// THE REPOSITORY STILL REFUSES A PARTIAL OBJECT TABLE, and that is a DELIBERATE non-change in a diff
// that made partial closures representable everywhere else. A commit closure may now legitimately be
// shipped incomplete, under a declared admission, because a delta is a real thing to send. A whole
// REPOSITORY written with dangling edges is not that -- nobody asked for it, no consumer wants it,
// and admitting it here would widen the change beyond what was decided. When a repository-grain
// partial write is actually wanted, it takes an admission exactly as the closure encoder does; until
// then this refusal stands rather than being loosened by proximity.
fn first_uncontained_target(store: ObjectStore) -> String? {
  fold(uncontained_targets(store: store), init: none, f: fn(acc, id) {
    match acc {
      Present { value: _ } => acc
      Absent => Present { value: object_id_key(identity: id) }
    }
  })
}

fn encode_repository_checked(repo: RepositoryEnvelope) -> RepositoryEncodeOutcome {
  let acc = encode_object_table(store: repo.store)
  match first_uncontained_target(store: repo.store) {
    Present { value: reference } =>
      RepositoryEncodeRefused { cause: RepositoryEncodeClosureDocRefusal { cause: ClosureDocEdgeTargetUnresolved { reference: reference } } }
    Absent =>
      match unresolved_commit_root(acc: acc, commits: repo.commits) {
        Present { value: root } =>
          RepositoryEncodeRefused { cause: RepositoryCommitRootNotInStore { root: root } }
        Absent =>
          match unresolved_checkout_selection(commits: repo.commits, selected: repo.checked_out) {
            Present { value: selected } =>
              RepositoryEncodeRefused { cause: RepositoryCheckoutNotInCommits { selected: selected } }
            Absent => RepositoryEncoded { value: encode_repository(repo: repo) }
          }
      }
  }
}

// These answer with the ObjectId the CALLER supplied, not with a wire string derived from it. The
// caller holds that identity and can act on it; a hex key it would have to parse back is the same
// fact rendered into a shape that has lost its type.
fn unresolved_commit_root(acc: EncodeAcc, commits: List<RepositoryCommit>) -> ObjectId? {
  fold(commits, init: none, f: fn(found, c) { unresolved_commit_root_step(acc: acc, found: found, commit: c) })
}

fn unresolved_commit_root_step(acc: EncodeAcc, found: ObjectId?, commit: RepositoryCommit) -> ObjectId? {
  match found {
    Present { value: _ } => found
    Absent =>
      // ASK THE TABLE, NOT THE ENCODING. This read the ENCODED root and compared it to "" -- the
      // old sentinel for "unresolvable" -- which worked only while an unresolvable root encoded to
      // an empty string. With the two-arm reference there is no sentinel: an uncontained root is a
      // legitimate arm, so the comparison went permanently false and this refusal silently stopped
      // firing. It typechecked, because the comparison was against a JsonValue by then.
      //
      // The repair is to stop routing a containment question through a representation at all. The
      // question is "does the table hold this object", and position_of answers it directly.
      match position_of(positions: acc.positions, identity: commit.root) {
        Present { value: _ } => none
        Absent => Present { value: commit.root }
      }
  }
}

fn unresolved_checkout_selection(commits: List<RepositoryCommit>, selected: ObjectId?) -> ObjectId? {
  match selected {
    Absent => none
    Present { value: identity } =>
      if commit_reference_of(commits: commits, selected: identity) == "" {
        Present { value: identity }
      } else {
        none
      }
  }
}

// ------------------------------------------------------------------------------------------------
// Decoding
// ------------------------------------------------------------------------------------------------

// COMMITS ACCUMULATE BY PREPEND AND ARE REVERSED ONCE AT THE CONSUMER. concat-at-end inside a fold
// copies the whole accumulator per commit, which is the quadratic shape DESIGN section 6 says is
// always fixed regardless of the realized n. This stack removed that shape from image.dag and from
// object_store.dag and then reintroduced it here in the same diff -- caught by review, and the point
// worth recording is that fixing a cost shape at the sites a review names is not the same as not
// having the defect: the sweep has to be over every accumulator the change touches, or the rule is
// applied one grep at a time.
//
// The list order is load-bearing -- it is the log order a reader sees, and
// scm_env_the_root_signature_distinguishes_order is the claim that would go red if the reverse were
// dropped or applied twice.
type CommitDecodeAcc {
  commits: List<RepositoryCommit>
  refusal: RepositoryDecodeRefusal?
}

// A commit record's member set is closed for the same reason the envelope's is: a writer that states
// a fact this reader discards, and then has it deleted on the next re-encode, has lost information
// while every operation reported success.
fn decode_commit_step(positions: DecodePositions, acc: CommitDecodeAcc, value: JsonValue) -> CommitDecodeAcc {
  match acc.refusal {
    Present { value: _ } => acc
    Absent =>
      match repository_member_set_refusal(
        v: value,
        allowed: ["root", "message"],
        context: RepositoryCommitMembers
      ) {
        Present { value: c } =>
          CommitDecodeAcc { commits: acc.commits, refusal: Present { value: c } }
        Absent => decode_commit_members(positions: positions, acc: acc, value: value)
      }
  }
}

fn commit_root_refusal(cause: ClosureDocRefusal) -> RepositoryDecodeRefusal {
  match cause {
    ClosureDocEdgeTargetUnresolved { reference: r } =>
      RepositoryCommitRootReferenceUnresolved { reference: r }
    _ => RepositoryDecodeClosureDocRefusal { cause: cause }
  }
}

fn decode_commit_members(positions: DecodePositions, acc: CommitDecodeAcc, value: JsonValue) -> CommitDecodeAcc {
  match acc.refusal {
    Present { value: _ } => acc
    Absent =>
      match read_member(v: value, key: "root") {
        MemberFailed { cause: c } =>
          CommitDecodeAcc { commits: acc.commits, refusal: Present { value: RepositoryDecodeClosureDocRefusal { cause: c } } }
        MemberObject { value: root_value } =>
          match decode_target(positions: positions, target_value: root_value) {
            // A COMMIT ROOT THAT RESOLVES TO NOTHING KEEPS ITS OWN REFUSAL. The generic target decoder
            // reports an unresolved reference without knowing WHOSE it was, and letting that through
            // unchanged would merge "an edge inside an object points nowhere" with "a commit names a
            // root this repository does not hold" -- two states with different owners and different
            // repairs, which is the conflation this module's refusal split exists to prevent. Every
            // other cause (a malformed digest, a target that is not one arm) has no repository-level
            // meaning and is wrapped as-is.
            TargetDecodeFailed { cause: c } =>
              CommitDecodeAcc {
                commits: acc.commits,
                refusal: Present { value: commit_root_refusal(cause: c) },
              }
            TargetDecoded { target: root } =>
              match read_string_member(v: value, key: "message") {
                MemberFailed { cause: c } =>
                  CommitDecodeAcc { commits: acc.commits, refusal: Present { value: RepositoryDecodeClosureDocRefusal { cause: c } } }
                MemberString { value: message } =>
                  CommitDecodeAcc {
                    commits: concat([RepositoryCommit { root: root, message: message }], acc.commits),
                    refusal: acc.refusal,
                  }
                _ =>
                  CommitDecodeAcc { commits: acc.commits, refusal: Present { value: RepositoryDecodeClosureDocRefusal { cause: ClosureDocMemberWrongShape { key: "message" } } } }
              }
          }
        _ =>
          CommitDecodeAcc { commits: acc.commits, refusal: Present { value: RepositoryDecodeClosureDocRefusal { cause: ClosureDocMemberWrongShape { key: "root" } } } }
      }
  }
}

// THE IDENTITY RULE IS CHECKED BEFORE ANY OBJECT IS DECODED, for the same reason the format tag is:
// a document written under a different node-identity rule would decode cleanly and reconstruct
// DIFFERENT identities, so discovering the mismatch after the walk would mean reporting a
// well-formed repository that silently is not the one that was stored.
// FORMAT DISPATCH IS ITS OWN STEP, and it selects a decoder that understands ONE exact schema. The
// shape a second version must take is a second arm here calling decode_repository_v2 -- never the v1
// body widened to admit v2's members, which would erase the reason the member sets are closed at all.
// The identity-rule tag stays a separate axis for the same reason it is separate today: a schema-v2
// document may still carry the v1 node-identity rule, and an identity migration may leave the JSON
// schema untouched.
type RepositoryFormat
  = RepositoryFormatV1
  | RepositoryFormatUnknown { found: String }

fn repository_format_of(tag: String) -> RepositoryFormat {
  if tag == repository_envelope_format_tag {
    RepositoryFormatV1
  } else {
    RepositoryFormatUnknown { found: tag }
  }
}

fn decode_repository(v: JsonValue) -> RepositoryDecodeOutcome {
  match read_string_member(v: v, key: "format") {
    MemberFailed { cause: c } => RepositoryDecodeRefused { cause: RepositoryDecodeClosureDocRefusal { cause: c } }
    MemberString { value: format } =>
      match repository_format_of(tag: format) {
        RepositoryFormatUnknown { found: f } =>
          RepositoryDecodeRefused { cause: RepositoryDecodeClosureDocRefusal { cause: ClosureDocFormatUnrecognized { found: f } } }
        RepositoryFormatV1 => decode_repository_v1(v: v)
      }
    _ => RepositoryDecodeRefused { cause: RepositoryDecodeClosureDocRefusal { cause: ClosureDocMemberWrongShape { key: "format" } } }
  }
}

// EXACTLY v1. Every member population below is v1's, and this body is frozen once a v1 document
// exists anywhere.
fn decode_repository_v1(v: JsonValue) -> RepositoryDecodeOutcome {
  match read_string_member(v: v, key: "identity_rule") {
    MemberFailed { cause: c } => RepositoryDecodeRefused { cause: RepositoryDecodeClosureDocRefusal { cause: c } }
    MemberString { value: rule } =>
      if rule != repository_node_identity_rule_tag {
        RepositoryDecodeRefused { cause: RepositoryIdentityRuleUnrecognized { found: rule } }
      } else {
        match repository_member_set_refusal(
          v: v,
          allowed: ["format", "identity_rule", "objects", "commits", "checked_out"],
          context: RepositoryEnvelopeMembers
        ) {
          Present { value: c } => RepositoryDecodeRefused { cause: c }
          Absent => decode_repository_body(v: v)
        }
      }
    _ => RepositoryDecodeRefused { cause: RepositoryDecodeClosureDocRefusal { cause: ClosureDocMemberWrongShape { key: "identity_rule" } } }
  }
}

fn decode_repository_body(v: JsonValue) -> RepositoryDecodeOutcome {
  match read_member(v: v, key: "objects") {
    MemberFailed { cause: c } => RepositoryDecodeRefused { cause: RepositoryDecodeClosureDocRefusal { cause: c } }
    MemberArray { elements: object_values } =>
      match decode_object_table(object_values: object_values) {
        DecodeAcc { store: store, positions: positions, next: _, refusal: table_refusal } =>
          match table_refusal {
            Present { value: c } => RepositoryDecodeRefused { cause: RepositoryDecodeClosureDocRefusal { cause: c } }
            Absent =>
              match read_member(v: v, key: "commits") {
                MemberFailed { cause: c } => RepositoryDecodeRefused { cause: RepositoryDecodeClosureDocRefusal { cause: c } }
                MemberArray { elements: commit_values } =>
                  match fold(
                    commit_values,
                    init: CommitDecodeAcc { commits: [], refusal: none },
                    f: fn(acc, cv) { decode_commit_step(positions: positions, acc: acc, value: cv) }
                  ) {
                    CommitDecodeAcc { commits: reversed_commits, refusal: commit_refusal } =>
                      match commit_refusal {
                        Present { value: c } => RepositoryDecodeRefused { cause: c }
                        Absent =>
                          decode_repository_checkout(
                            v: v, store: store, positions: positions, commits: reverse(reversed_commits)
                          )
                      }
                  }
                _ => RepositoryDecodeRefused { cause: RepositoryDecodeClosureDocRefusal { cause: ClosureDocMemberWrongShape { key: "commits" } } }
              }
          }
      }
    _ => RepositoryDecodeRefused { cause: RepositoryDecodeClosureDocRefusal { cause: ClosureDocMemberWrongShape { key: "objects" } } }
  }
}

// A DANGLING CHECKOUT REFERENCE REFUSES RATHER THAN DEGRADING TO "nothing checked out". Those are
// different states: one is an ordinary empty repository, the other is a document whose workspace
// selection names an object the table does not contain. Answering the first for the second would
// silently discard the user's position and present the result as a healthy repository.
fn decode_repository_checkout(
  v: JsonValue,
  store: ObjectStore,
  positions: DecodePositions,
  commits: List<RepositoryCommit>
) -> RepositoryDecodeOutcome {
  match json_object_unique_member(v: v, key: "checked_out") {
    JsonMemberAbsent =>
      RepositoryDecodeRefused { cause: RepositoryDecodeClosureDocRefusal { cause: ClosureDocMemberMissing { key: "checked_out" } } }
    JsonMemberDuplicated { count: _ } =>
      RepositoryDecodeRefused { cause: RepositoryDecodeClosureDocRefusal { cause: ClosureDocMemberDuplicated { key: "checked_out" } } }
    JsonMemberNotAnObject =>
      RepositoryDecodeRefused { cause: RepositoryDecodeClosureDocRefusal { cause: ClosureDocNotAnObject } }
    JsonMemberFound { value: found } =>
      match found {
        JsonNull =>
          RepositoryDecoded {
            envelope: RepositoryEnvelope { store: store, commits: commits, checked_out: none }
          }
        JsonString { value: reference } =>
          match commit_at_reference(commits: commits, reference: reference) {
            Absent =>
              RepositoryDecodeRefused { cause: RepositoryCheckoutReferenceUnresolved { reference: reference } }
            Present { value: selected } =>
              RepositoryDecoded {
                envelope: RepositoryEnvelope {
                  store: store, commits: commits, checked_out: Present { value: selected.root }
                }
              }
          }
        _ =>
          RepositoryDecodeRefused { cause: RepositoryDecodeClosureDocRefusal { cause: ClosureDocMemberWrongShape { key: "checked_out" } } }
      }
  }
}
