// THE TABLE MACHINERY NOW COMES FROM THE TABLE'S OWN MODULE, which is what this import used to
// contradict: a repository read its accumulators, positions and codec upward out of the commit
// closure, a layer whose own header says the repository is the one above it. What still comes from
// the closure is what the closure genuinely owns -- its refusal type and that type's classifier,
// because a repository document embeds a closure document and must be able to say so.
import gunbc.scm.object_table_json {
  ObjectTableDecodeRefusal,
  object_table_load_standing,
  DecodeAcc,
  DecodePositions,
  EncodeAcc,
  EncodePositions,
  encode_object_table,
  object_id_key,
  source_position_of,
  manifest_position_of,
  node_position_of,
  decode_object_table,
  resolve_reference,
}
// unexpected_member_key COMES FROM ITS OWNER, NOT FROM A NEIGHBOUR THAT ALSO IMPORTS IT. It is
// declared in gunbc.scm.json_member, and re-exporting it through the closure module made a
// repository's member-set question look like a closure-document fact -- the same layer inversion the
// json_member header was extracted to end, surviving as an import edge after the function moved.
import gunbc.scm.commit_closure_json_v2 {
  encoded_root_reference,
}
import gunbc.scm.load_standing {
  LoadStanding,
  LoadUnsupportedProtocol,
  LoadDocumentMalformed,
}

// THE ENCODING IS NOT CANONICAL WITH RESPECT TO INSERTION HISTORY, and that is declared here rather
// than left for someone to discover by diffing two repositories that ought to match.
//
// Objects are emitted in store_records_in_dependency_order. That is now a DERIVED post-order walk
// rather than insertion order -- this note said insertion order and was left stale when the walk
// landed. What survives of the original claim is narrower and still true: the walk fixes the order of
// each object relative to the ones it REFERENCES, and nothing more, so insertion history still decides
// TIE ORDER AMONG INDEPENDENT COMPONENTS. Storing program A then B, versus B then A, yields the same
// semantic repository -- same objects, same derived identities, same commits -- but a different
// position assignment, hence different bytes. So two repositories that are semantically equal can
// still serialize differently, for a smaller reason than before.
//
// What that costs: byte comparison cannot be used to decide repository equality, and a mirror or a
// content-addressed repository image is not yet expressible. What it does NOT cost: nothing about
// identity or reconstruction, because every ObjectId is derived from structure and never from a
// position -- the references are image-local addresses, so a different assignment names the same
// objects. scm_env_re_encoding_is_stable pins the weaker property that DOES hold: one image
// re-encodes to itself byte-for-byte, which is what the position references depend on.
//
// dissolve-on: a deterministic emission order -- a topological order with a content-digest tie-break
// -- which is canonical because the digests are already content-derived. That is a real change to
// encode_object_table rather than a flag, so it is a separate slice, not a footnote.
// v1 -> v2 MOVED FOR TWO CHANGES THAT WERE BOTH SCHEMA CHANGES BY THIS STACK'S OWN RULE, kept here
// because the rule they establish is what decides every later bump. The embedded object table is
// gunbc.scm.commit_closure_json_v2's, which gained authored-source entries, so a v1
// reader refuses documents that writer could produce. And a commit's `root` is now RESOLVED against
// that table at decode -- a root the table does not carry, or carries as a file, refuses here rather
// than being admitted and noticed later -- so the set of documents that decode is different in both
// directions. Either change alone would move the tag.
// V3, BECAUSE THE OBJECT-ENTRY LANGUAGE GREW A THIRD ARM. The embedded object table now admits
// {manifest} entries beside {kind, children} and {source}, so a v2 reader refuses documents this
// writer can produce -- the same rule that moved v1 to v2 when the source arm arrived. The commit
// closure moved the other way on its own axis and for its own reason: its subject is one root, and a
// manifest is not reachable from one, so its v4 emits nodes ALONE. The two documents version
// separately because the repository owns the mixed object population and the closure never did.
// v4 BECAUSE THE COMMIT ROOT CHANGED SUBJECT. The member is still spelled `root`, which is exactly
// why the tag has to move: a v3 document's `root` designates a SEMANTIC NODE and a v4 document's
// designates a CORPUS MANIFEST, so the same bytes in the same member mean different things. A reader
// that accepted both would resolve a v3 root against the manifest population and answer wrong-kind
// for a document that was never malformed. The identity rule does NOT move with it -- see below.
// v5 BECAUSE THE ENVELOPE GREW A MEMBER, AND THE BUMP IS FOR THE READER GOING FORWARD RATHER THAN
// BACK. `staged` is a new envelope member, so a v4 reader meeting a v5 document refuses it at
// `repository_member_set_refusal` as an unexpected member -- which is the correct outcome and only
// happens because the tag moved. Holding the tag still would have left a v4 build silently reading a
// v5 document with the stage member rejected as corruption, or, had the member set been widened,
// discarding a stage the document declares.
// v6 BECAUSE THE COMMIT MEMBER SET GREW, WHICH IS A DIFFERENT AXIS FROM v5's ENVELOPE GROWTH AND
// NEEDS THE TAG TO MOVE FOR THE SAME REASON. `integration` is a new member of every commit record, so
// a v5 reader meeting a v6 document refuses it at the commit member set -- loudly, as an unexpected
// member -- rather than reading a document whose provenance it cannot represent. Holding the tag
// still would have left a v5 build discarding the member on read and DELETING IT ON THE NEXT
// RE-ENCODE, which is the information loss the closed member set exists to prevent.
//
// v5 ABSENCE NORMALIZES TO NoSquashIntegration, AND THAT IS HISTORICAL FACT RATHER THAN A CONVENIENT
// DEFAULT. No v5 writer had a squash producer -- this cut introduces the first one -- so a v5
// document's silence about integration is not missing information, it is the complete truth about a
// repository in which no squash could have occurred. That is the same test v4's `staged` absence had
// to pass, and it passes for the same reason: the absence has ONE truthful value, and a format whose
// absence had two would have to refuse instead.
//
// THE NEW WRITER EMITS THE MEMBER EXPLICITLY and never leans on absence to mean the canonical state.
// An optional member whose omission means NoSquashIntegration would make "this commit integrated
// nothing" and "this writer forgot to say" the same bytes, which is the conflation the arm was
// spelled as a state to avoid, arriving through the wire instead of through the type.
data repository_envelope_format_tag: String = "gunbc-scm-repository-v6"

// v7: THE SHARDED ENVELOPE (the 2026-09-23 persistence ruling). The index document carries every
// repository fact EXCEPT object payloads -- commits, allocator, selection, stage, and
// `object_shards`, the roster of content-derived shard identities. Each object lives in its own
// shard document (gunbc.scm.object_shard_json) named by that identity, so a save after one
// candidate's change writes only the new shards plus the small index, and no operation ever
// rewrites another object's bytes. v4-v6 keep their frozen readers; the one v6 envelope in
// production reads through its reader and is rewritten as v7 on its next save.
data repository_envelope_format_tag_v7: String = "gunbc-scm-repository-v7"

// v8: THE INDEXED ENVELOPE (2026-10-03, the affected-set capture ruling: "it should only read the
// things it actually needs"). v7's index named its shards but not which object each held, so the one
// way to find any object -- a commit's root manifest, a source a candidate re-binds -- was to decode
// every shard. v8 adds `objects`, the object roster: one [identity, kind, shard] row per persisted
// object. A load can then answer every identity- and kind-grain question (commit roots, the staged
// reference, manifest-entry completeness) from the index alone, and read exactly the shards whose
// CONTENT an operation demands (gunbc.scm.repository_load load_repository_indexed,
// materialize_objects). Manifests sit alone in their shards (gunbc.scm.object_shard_json
// shard_partition), so a commit root's content is one manifest-sized read. A v7 envelope is migrated
// by gunbc.scm.repository_convert, which loads it whole once and re-saves it as v8.
data repository_envelope_format_tag_v8: String = "gunbc-scm-repository-v8"

// v9: THE TYPED INTAKE (the BaseAdvance follow-up to gunbc#13111). v8's index plus one commit member,
// `intake` (gunbc.scm.intake CommitIntake): which external revision a commit froze or advanced its
// line to. The index layout, the roster and the shards are v8's unchanged, so v8 stays loadable by
// the same indexed reader; its commits read back IntakeUnrecordedByFormat, and the next save writes
// v9 carrying that arm as JsonNull. No conversion entry is needed: nothing is re-read to migrate.
data repository_envelope_format_tag_v9: String = "gunbc-scm-repository-v9"

data repository_envelope_format_tag_v5: String = "gunbc-scm-repository-v5"

// v4 IS READ, NOT RETIRED, AND THE DIFFERENCE FROM v3 IS WHETHER A READER CAN PRODUCE THE VALUE.
//
// v3 has no reader because its `root` designates a semantic node and this carrier's designates a
// corpus manifest: producing the v4 type from a v3 document requires inventing authored bytes the
// semantic projection discarded, so there is nothing honest to return. The staging member is the
// opposite case. A v4 document was written by a build in which staging did not exist, so nothing was
// staged when it was written -- `Absent` is not a default chosen to make the read succeed, it is what
// that document actually says about its stage. A reader supplying it fabricates nothing.
//
// SO THE TEST IS NOT "IS THE PREDECESSOR OLD" BUT "CAN THE MISSING FACT BE ANSWERED WITHOUT INVENTING
// IT". Both v3 and v4 lack something v5 carries; only one of the two absences has a truthful value.
data repository_envelope_format_tag_v4: String = "gunbc-scm-repository-v4"

// THE FORMER TAG, CARRIED SO THE READER CAN REFUSE IT BY NAME. A v3 image is not corruption; it is a
// document this build's commit carrier cannot represent, and those are different facts with
// different remedies.
data repository_envelope_format_tag_v3: String = "gunbc-scm-repository-v3"

// THE IDENTITY RULE IS VERSIONED SEPARATELY FROM THE SCHEMA, AND THE TWO ARE DIFFERENT AXES.
//
// repository_envelope_format_tag versions the SHAPE of this document -- which members exist and what
// they mean. It says nothing about how a structural node becomes an ObjectId. Those can move
// independently: the schema could hold still while canonicalize_node_for_content_hash or the fnv1a64
// folding changed, and every stored repository would then reconstruct to DIFFERENT identities while
// still parsing perfectly. Nothing would refuse, and the commits a user had made would silently
// become commits they had not.
//
// Naming the rule in the document turns that silent reinterpretation into a typed refusal. It is
// deliberately NOT derived from the code that implements the rule: a tag computed from the current
// implementation would agree with itself by construction and could never disagree, which is the
// change-detector failure -- it would go green precisely when the rule changed.
// THE IDENTITY RULE MOVES ON ITS OWN AXIS, AND IT MOVED. The old value named ONE derivation --
// fnv1a64 over the canonicalized node structure -- and the store now derives a second family: an
// authored source's identity, from content_hash_tagged_structural over a domain tag and the text. A
// document carrying both families is reconstructed by a rule the old value does not describe, and a
// reader that accepted it and then met a source entry would reconstruct identities by a rule the
// document never claimed. That is the silent reinterpretation this tag exists to turn into a
// refusal.
//
// THE NAME MOVED WITH IT, AND THAT IS NOT COSMETIC. The symbol said `node` while the table it
// governs holds non-node identities, so the authority's own name asserted something false about its
// subject -- the meaning fork DESIGN section 3 names, in the one place whose whole job is to say
// which rule was used. It now names the OBJECT identity rule, and the value names the rule rather
// than one branch's hash function, because the rule is a total law over the object coproduct whose
// semantic-node branch delegates to v2.std.node content_hash.
//
// ON A FUTURE MANIFEST ARM, corrected: this note said such a branch "joins this same tag when it
// lands; it does not mint a third one". The first half is right and the second does not follow. A
// manifest arm joins this identity AUTHORITY rather than standing up a peer authority beside it --
// that is the section 3 point. But adding an arm and its derivation changes the authority's TOTAL
// LAW over the object coproduct, and this tag names the law, so the version advances with it. The
// tag is not pre-bumped for a branch that does not exist; what is corrected here is the transition
// rule, so the next author does not read this as permission to grow the law under a fixed name.
// V2: A THIRD IDENTITY FAMILY. The store derived two rules -- fnv1a64 over a canonicalized node, and
// content_hash_tagged_structural over a domain tag and text for an authored source. A corpus manifest
// adds a third, combining each entry's path with its source locator so a file moved to a new path is
// a different manifest even though no bytes changed. A document carrying a manifest is reconstructed
// by a rule the v1 value does not describe, which is exactly the silent reinterpretation this tag
// exists to turn into a refusal.
data repository_object_identity_rule_tag: String = "scm-object-identity-v2"

// THE GENERATION IDENTITY OF A PERSISTED ENVELOPE IS THE CONTENT HASH OF THE DOCUMENT'S OWN BYTES.
//
// This is the compare-and-set operand the guarded save (gunbc.scm.repository_save
// save_repository_sharded_guarded) matches between a writer's load and its write: a loader hands
// back the generation of the bytes it decoded, a saver observes the generation currently on disk,
// and a mismatch means someone else committed an envelope the writer never saw -- the save refuses
// rather than clobbering it. The 2026-09-22 incident is the receipt for the missing guard: the
// fmt-gate capture recorded scm_commit_ordinal 1, and four minutes later a stale-generation save
// silently rewrote the envelope commit-0-only, destroying the capture's commit while every
// operation reported success.
//
// The rule lives here, beside the format tags, because it is a FACT ABOUT THE FORMAT, owned by the
// format's authority: one derivation feeds both the loader (which hashes the bytes it read) and
// the guard (which hashes the bytes on disk now), so the two sides can never disagree about what
// a generation IS. It is deliberately over the document BYTES rather than any decoded projection:
// two byte-different documents that decode to one semantic repository (insertion-order ties, the
// non-canonical encoding the codec header declares) are nonetheless two GENERATIONS, because the
// guard's subject is the file on disk, not the repository it denotes. A hand edit that preserves
// semantics still moves the generation, and the next stale writer refuses -- conservative
// refusal is the guard's whole purpose.
//
// The hash family is the object identity's own family (fnv1a64 structural, the declared-rung
// locator family this format already uses for ObjectId): no second digest authority is minted for
// one compare, and the declared non-cryptographic rung of that family applies here unchanged --
// the guard separates writers that observed different bytes, it is not an adversarial-integrity
// claim. The cast is the established content_hash_atom idiom (the same submission_digest carries);
// an index document is non-empty by construction, since every format the loader admits carries a
// format member and an empty document refuses at that read.
fn repository_generation_of_content(content: String) -> Fnv1a64Structural {
  content_hash_atom(value: content as NonEmptyStr)
}

// ANCESTRY IS A COMMIT REFERENCE, NOT A NODE REFERENCE, and that is this module's own ruling reused
// rather than a fresh choice. The annotation on `checked_out` records why it resolves against the
// COMMIT LIST and not the object table: a node reference admits documents naming an arbitrary
// interior object -- a child three levels down -- as the thing being pointed at, and nothing refuses,
// because nothing asks the question. A parent has exactly that property. `root` may be a node
// reference because a commit's root IS a node; a parent may not, because a parent is a COMMIT, and
// spelling it as a node reference would readmit the precise state that ruling made unwritable.
//
// THE COMMIT LIST ORDER IS PRESENTATION, NEVER IDENTITY OR ANCESTRY. Every parent and checkout edge
// carries the commit's minted key, so inserting, deleting or reordering rows cannot silently retarget
// another edge. This removes the subject of the former append-only obligation rather than adding a
// wall that would become redundant at this cut.
// THE ROOT IS THE AUTHORED SNAPSHOT THIS COMMIT FREEZES, AND IT IS A CORPUS MANIFEST. It was a
// SemanticNodeObjectRef until gunbc#10522 section 5 ruled the subject: the authored snapshot is
// authoritative for what was authored, and structural interpretation is a derived view over it. A
// semantic root cannot hold that position, because the projection it comes from erases annotations
// and cannot represent source that does not ingest -- so a commit rooted at one could not freeze a
// comment-only edit or a malformed file, both of which a source-control system must be able to hold.
// The semantic reading of a commit is now DERIVED from the snapshot rather than stored beside it.
// `integration` IS NOT A SECOND ANCESTRY MEMBER, and the two sit side by side here precisely so the
// difference is visible at the carrier. `ancestry` answers WHERE THIS COMMIT SITS IN THIS HISTORY;
// `integration` answers WHAT SOURCE STATE PRODUCING IT CONSUMED. A squash-integrated commit has one
// immediate parent and one consumed source, and gunbc.scm.integration owns the second because
// admitting the source as a parent would make an operation INPUT into an ancestry EDGE.
type RepositoryCommit sole_constructor {
  reference: RepositoryCommitRef
  root: CorpusManifestObjectRef
  message: String
  ancestry: CommitAncestry
  integration: CommitIntegration
  intake: CommitIntake
}

// THE SELECTION IS A COMMIT REFERENCE, NOT A ROOT IDENTITY, and this carrier was LOSSY until
// review 56230 named it. `commits` may legitimately hold two rows with the same root and different
// messages -- gunbc.scm.log's own witness two_commits_sharing_a_root_still_get_distinct_references
// exists because it can -- so a root is NOT a unique key into this list. Storing one meant the
// selection could not express WHICH ROW was chosen, and every reader resolved it to the FIRST match.
//
// Measured before the repair: checking out the second of two shared-root commits and asking `status`
// reported the FIRST one's message. A user was told they were on a commit they had not selected.
//
// THE SELECTION NOW CARRIES THAT ROW'S MINTED COMMIT IDENTITY END TO END. Decode no longer converts
// a wire position to a root, and encode no longer searches for a row to recover a position. The
// selected identity remains stable when unrelated rows are inserted, deleted, or reordered.
//
// A root still identifies the program reconstructed by a commit; the minted reference identifies
// the commit record that carries that root, message, and ancestry. Two commits may therefore share
// a root without sharing an identity or making checkout ambiguous.
// THE STAGE IS A LOCATOR, NOT A STAGING AREA, and that is what makes an `add` verb a re-pointing.
//
// THE VERBS ARE IN THIS TREE NOW, and this paragraph used to say they were not. It said `add` and
// `commit` could not land until extdeps.filesystem declared a rename, because a safe conditional
// publication could not be spelled without one. That was true when written and is false here: the
// write spine publishes through generation-file compare-and-set, which gives exact-generation
// publication with independent readback and needs no rename. What is landed is the member, its codec,
// gunbc.scm.staging's observation of it, and the verbs themselves.
//
// What an author accumulates before committing is a set of path -> authored-source bindings. That is
// EXACTLY what a CorpusManifestObject is, and it is exactly what a commit root is, so a separate
// staging representation would be a second answer to one question (DESIGN section 3) and would need
// its own identity rule, its own codec, its own duplicate-path law and its own migration. The stage
// is therefore an ordinary manifest OBJECT in the ordinary store, and this member is one reference
// into it. An `add` mints a new manifest from the old one and moves this pointer; nothing accumulates
// anywhere else.
//
// WHICH MAKES A `commit` A RE-DESIGNATION AND NOT A CONVERSION. mint_repository_commit takes a
// CorpusManifestTarget, which is precisely what this member already holds, so committing translates
// nothing and can lose nothing in translation.
//
// AND MAKES "IS THERE ANYTHING TO COMMIT" DERIVED RATHER THAN STORED. It is the comparison of this
// locator with the checked-out commit's root, so the question is never a flag that can disagree with
// the objects.
//
// THE CONCLUSION DRAWN FROM THAT WAS WRONG AND THE LANDED VERB DOES CLEAR THE STAGE. This paragraph
// argued that committing need not reset the selection, because afterwards this member and the new
// commit's root would be the same manifest and the comparison would report clean by construction.
// The comparison does read clean -- but leaving the selection standing keeps an explicit OVERRIDE in
// place, and `Absent` versus `Present` is exactly the distinction the last paragraph of this note
// calls a data-loss defect rather than a nicety. `freeze_committable` therefore sets `staged: none`
// together with the checkout advance, in one function, so the next `add` inherits from the commit
// just written rather than from a selection the author has already spent.
//
// ONE SELECTION PER DOCUMENT, WHICH IS ONE WORKSPACE, AND THAT SCOPE IS STATED RATHER THAN HIDDEN.
// A candidate selection is a fact about one working context's pending intent, not about the
// repository's content or history, so two independently mutable workspaces over one document hold two
// selections and this member carries one. Next-rung trigger: a workspace subject this selection is
// keyed by, with contention over the shared commit allocator resolved at the repository's own
// authority. NOT "author identity" -- one author holds several workspaces, so that subsystem could
// land entire and leave this exactly where it is. gunbc.scm.staging's header carries the reasoning.
//
// ABSENT MEANS NO EXPLICIT OVERRIDE, NOT AN EMPTY CORPUS, and the difference is a data-loss defect
// rather than a nicety. gunbc.scm.staging derives the effective candidate: with no override it is the
// checked-out commit's own snapshot, so a first `add` over existing history will extend that corpus
// instead of replacing it with the single path just bound. `Present` over an empty manifest stays a
// different value -- an author explicitly selecting the empty corpus, which is a deletion of every
// tracked path and must remain expressible.
type RepositoryEnvelope {
  store: ObjectStore
  commits: List<RepositoryCommit>
  commit_allocator: MintedIdAllocator<RepositoryCommitSubject>
  checked_out: RepositoryCommitRef?
  staged: CorpusManifestObjectRef?
}

// ENCODE AND DECODE HAVE DIFFERENT FAILURE POPULATIONS, SO THEY ARE DIFFERENT TYPES.
//
// One shared RepositoryRefusal made every total consumer of an ENCODE result state how it classifies
// RepositoryUnexpectedMember -- a decode-only fact that an encoder cannot produce, because an encoder
// receives a RepositoryEnvelope and never an input JSON object. The closed coproduct was doing its
// job and the carrier was lying to it: the exhaustiveness obligation is only as honest as the type it
// ranges over, and a union of two operations' failures forces each to handle the other's impossible
// states. Caught by review after a witness had to add exactly that impossible arm.
//
// Splitting also dissolves a conflation that was already live before the member sets landed. Both
// paths spelled their unresolved reference `String`, and the two strings are different things:
//
//   encode  -- the caller handed us an ObjectId that the store or the commit list does not contain
//   decode  -- the DOCUMENT named an image-local position, and no object decoded at that position
//
// An ObjectId and a wire position are not one type because both render as text. On the encode side
// the domain type is now carried directly, so the identity no longer round-trips through a string
// nobody can resolve back.
// THE ENCODE DOMAIN CARRIES ONLY WHAT ENCODING CAN PRODUCE, and the arm this replaces is the same
// dishonest-domain shape the codec carried one layer down.
//
// RepositoryEncodeClosureDocRefusal wrapped the WHOLE closure-document decode population, of which
// encoding can produce exactly one. A reader could not tell from the type which of
// them were real, and a consumer matching it had to handle format-tag and unknown-connective causes
// that no encode path can raise. The type was answering for a domain it does not own.
//
// The surviving rule is the domain one: every arm below is a cause ENCODING CAN ACTUALLY RAISE. The
// population is eight, and this line previously said "the single producible cause ... the two sibling
// arms below" -- a description of an earlier, smaller coproduct left standing over a grown one. Three
// arms concern object identity (an uncontained target, a target that resolves to authored source, a
// commit root that does; each carries ObjectId rather than a rendered key, closing a string round-trip
// -- an identity left as text is one nobody can resolve back); one concerns a commit root absent from
// the store; and four concern the commit table (checkout selection, duplication, allocator range,
// parent order), carrying RepositoryCommitRef for the same reason.
//
// THE INTEGRATION ARM IS NAMED FOR PRIOR ADMISSION, NOT FOR MEMBERSHIP, AND THE DISTINCTION IS THE
// WHOLE INVARIANT. The rule producing it refuses an anchor that is not admitted BEFORE the row naming
// it, so an anchor PRESENT in the commit table but listed later is refused too. A name saying
// `NotInCommits` would describe a weaker check than the one that runs -- a reader deciding whether the
// ordering case is covered would read the name and conclude it is not -- and the decode sibling
// already carries the accurate spelling. One rule answering under two names is the meaning fork
// DESIGN section 3 refuses. The neighbouring parent arm keeps its older membership spelling because
// renaming it is a separate subject with its own consumers, not because the two are equivalent.
type RepositoryEncodeRefusal
  = RepositoryEncodeUncontainedTarget { target: ObjectId }
  | RepositoryEncodeTargetIsAuthoredSource { target: ObjectId }
  | RepositoryEncodeTargetIsCorpusManifest { target: ObjectId }
  | RepositoryEncodeCommitRootIsAuthoredSource { root: ObjectId }
  | RepositoryEncodeCommitRootIsSemanticNode { root: ObjectId }
  | RepositoryEncodeManifestSourceIsSemanticNode { source: ObjectId }
  | RepositoryEncodeManifestSourceIsCorpusManifest { source: ObjectId }
  | RepositoryCommitRootNotInStore { root: ObjectId }
  | RepositoryEncodeStagedNotInStore { staged: ObjectId }
  | RepositoryEncodeStagedIsAuthoredSource { staged: ObjectId }
  | RepositoryEncodeStagedIsSemanticNode { staged: ObjectId }
  | RepositoryCheckoutNotInCommits { selected: RepositoryCommitRef }
  | RepositoryCommitReferenceDuplicated { reference: RepositoryCommitRef }
  | RepositoryCommitReferenceOutsideAllocator { reference: RepositoryCommitRef, next_ordinal: Int }
  | RepositoryCommitParentNotInCommits { parent: RepositoryCommitRef }
  | RepositoryEncodeIntegrationSourceNotPreviouslyAdmitted { source: RepositoryCommitRef }
  | RepositoryEncodeStoreIsPartial { rostered_shards: Int }
  | RepositoryEncodeAppendCarriesSemanticNode { target: ObjectId }
  | RepositoryEncodeAppendShadowsRosteredIdentity { identity: ObjectId }
  | RepositoryEncodeIntakeNotInWholeFormat { commit: RepositoryCommitRef }

// THE SAME MISATTRIBUTION THIS TYPE ALREADY CLOSED ONCE, CLOSED AGAIN ONE LAYER OVER. The
// member-read arm below exists because dropping the envelope's own identity_rule member used to
// refuse as a CLOSURE DOCUMENT refusal, for a document whose closure was never reached -- the shared
// reader was homed in the closure module and carried its vocabulary. The object table was the same
// arrangement with the same consequence: a malformed OBJECT ENTRY in a repository's own table
// reported as the embedded closure document being malformed. Now that the table owns its causes, the
// repository names them as what they are.
//
// THERE IS NO CLOSURE ARM, AND THE ONE THAT WAS HERE IS DELETED. It survived the object-table
// extraction on a sentence -- "a repository document really does embed a closure document" -- which
// stopped being true when v3 landed: a repository carries its own mixed object table and a commit's
// root designation, never a nested closure document, so nothing on this head could produce the arm.
// An unproducible arm in a closed result type is the dishonest domain this module refuses elsewhere,
// and it forces every exhaustive consumer to answer a question the decoder cannot ask.
type RepositoryDecodeRefusal
  = RepositoryDecodeObjectTableRefused { cause: ObjectTableDecodeRefusal }
  | RepositoryMemberReadRefused { cause: MemberReadRefusal }
  | RepositoryFormatUnrecognized { found: String }
  | RepositoryFormatRetired { found: String }
  | RepositoryShardedIndexIsNotWhole { found: String }
  | RepositoryShardNotDecodable { detail: String }
  | RepositoryIndexHasNoObjectRoster { found: String }
  | RepositoryObjectRosterMalformed { detail: String }
  | RepositoryIdentityRuleUnrecognized { found: String }
  | RepositoryCommitRootReferenceUnresolved { reference: String }
  | RepositoryCommitRootNotInObjectTable { root: ObjectId }
  | RepositoryCommitRootIsAuthoredSource { root: ObjectId }
  | RepositoryCommitRootIsSemanticNode { root: ObjectId }
  | RepositoryDecodedManifestSourceIsSemanticNode { source: ObjectId }
  | RepositoryDecodedManifestSourceIsCorpusManifest { source: ObjectId }
  | RepositoryDecodedTargetIsAuthoredSource { target: ObjectId }
  | RepositoryDecodedTargetIsCorpusManifest { target: ObjectId }
  | RepositoryStagedReferenceUnresolved { reference: String }
  | RepositoryStagedNotInObjectTable { staged: ObjectId }
  | RepositoryStagedIsAuthoredSource { staged: ObjectId }
  | RepositoryStagedIsSemanticNode { staged: ObjectId }
  | RepositoryCheckoutReferenceUnresolved { reference: RepositoryCommitRef }
  | RepositoryCommitReferenceDuplicatedOnWire { reference: RepositoryCommitRef }
  | RepositoryCommitParentNotPreviouslyAdmitted { parent: RepositoryCommitRef }
  | RepositoryCommitIntegrationSourceNotPreviouslyAdmitted { source: RepositoryCommitRef }
  | RepositoryDecodedCommitReferenceOutsideAllocator { reference: RepositoryCommitRef, next_ordinal: Int }
  | RepositoryUnexpectedMember { context: RepositoryMemberContext, key: String }
  | RepositoryTargetReferenceRefused { cause: TargetReferenceRefusal }

// THE CONTEXT VOCABULARY IS THIS LAYER'S, THE MEMBERSHIP MECHANISM IS SHARED. gunbc.scm.json_member owns
// `unexpected_member_key`, which answers a context-free question -- which key is not in this set --
// and each layer names its own shapes. Adding `RepositoryEnvelopeMembers` to commit_closure_json_v2's context
// coproduct would have made the lower carrier enumerate the shapes of a layer above it, which is the
// inversion DESIGN section 3 names; duplicating the fold here instead would have been a second
// authority for one rule. Neither is necessary: the mechanism generalizes, the vocabulary does not.
type RepositoryMemberContext
  = RepositoryEnvelopeMembers
  | RepositoryCommitMembers

fn repository_member_set_refusal(
  v: JsonValue,
  allowed: List<String>,
  context: RepositoryMemberContext
) -> RepositoryDecodeRefusal? {
  match unexpected_member_key(v: v, allowed: allowed) {
    Absent => none
    Present { value: key } =>
      Present { value: RepositoryUnexpectedMember { context: context, key: key } }
  }
}

type RepositoryDecodeOutcome
  = RepositoryDecoded { envelope: RepositoryEnvelope }
  | RepositoryDecodeRefused { cause: RepositoryDecodeRefusal }

fn empty_repository() -> RepositoryEnvelope {
  RepositoryEnvelope {
    store: empty_store(),
    commits: [],
    commit_allocator: MintedIdAllocator { next_ordinal: 0 },
    checked_out: none,
    staged: none,
  }
}

type RepositoryCommitMint
  = RepositoryCommitMinted { repository: RepositoryEnvelope, reference: RepositoryCommitRef }
  | RepositoryCommitMintAllocatorInvalid { next_ordinal: Int }
  | RepositoryCommitMintRootMissing { root: ObjectId }
  | RepositoryCommitMintRootIsAuthoredSource { root: ObjectId }
  | RepositoryCommitMintRootIsSemanticNode { root: ObjectId }
  | RepositoryCommitMintParentMissing { parent: RepositoryCommitRef }

// PURE CONSTRUCTION WALL FOR INTERNAL HISTORIES. The allocator is carried by the repository and
// advanced atomically with the new row; it is never reconstructed as max+1, because deleting the
// highest row would then reuse an identity and let an old user-held reference resolve confidently to
// a different commit. A descendant accepts only an EXISTING parent, so construction order makes a
// cycle unwritable internally. This function performs no persistence, CLI action, or host effect.
//
// THE MINT TAKES A TARGET AND HANDS BACK A BRANDED ROOT, which is the resolve-at-the-boundary shape
// the reference types are for. A caller may hold a bare locator -- from a document, from a fixture,
// from anywhere -- so requiring a SemanticNodeObjectRef here would have moved the problem rather
// than solved it. What the row stores is the reference THE STORE handed back for the record it
// actually found, never the caller's word for it, so a RepositoryCommit's root cannot name a file.
//
// THE ROOT ADMISSION ASKS FOR A LOCATOR'S KIND, NOT FOR THE LOCATOR. `store_contains` answers about
// the locator and is kind-agnostic by design, so asking it here admitted the wrong kind as a commit
// root -- a commit that mints cleanly and then refuses at checkout, which is the wrong place for the
// refusal to appear and the wrong owner to name in it.
//
// THE KIND THE ROOT MUST BE IS NOW THE CORPUS MANIFEST, AND THE THREE REFUSALS ARE RE-AIMED RATHER
// THAN DELETED. A repository commit freezes an AUTHORED SNAPSHOT: gunbc#10522 section 5 ruled that the
// authored snapshot is authoritative for what was authored and that structural interpretation is a
// DERIVED VIEW, and `gunbc.scm.object_store` had already said a manifest "is the thing a repository
// commit freezes". A semantic root cannot be that subject, because it cannot represent a
// comment-only edit (annotations are erased from the semantic projection, so two authored snapshots
// differing only in a comment share one graph) and cannot represent malformed or not-yet-ingested
// source at all -- precisely the corpora a source-control system must still be able to freeze.
//
// So the wrong-kind population did not shrink: it moved. `RepositoryCommitMintRootIsCorpusManifest`
// became `RepositoryCommitMintRootIsSemanticNode`, and the authored-source arm keeps its meaning,
// because a bare file is not a snapshot of a corpus either. All THREE non-success arms of
// `find_corpus_manifest_record` are preserved distinctly: folding a wrong-kind occupant into
// "missing" would report a locator that IS occupied as empty, which is the partial-observer defect
// this module has paid for before.
//
// THREE QUESTIONS STAY SEPARATE, and this function answers only the first. WELL-FORMED SNAPSHOT
// DESIGNATION -- does the commit name a manifest of the required kind? -- is decided here. CURRENT
// RECOVERABILITY -- are that manifest's required sources present and of the right kind? -- is not,
// and a found manifest establishes nothing about its entries' targets. PUBLICATION ADMISSION --
// may THIS operation publish given the observed availability? -- belongs to the publishing verb.
// Answering the second or third here would make a mint refuse for a fact that is not about minting.
// `integration_anchor_resolves` STOOD HERE AND IS DELETED, HAVING OUTLIVED ITS QUESTION.
//
// It checked that a `SquashIntegrated` anchor pre-existed in the INPUT repository, on the ground that
// output membership is not evidence of input membership -- a real argument while the generic mint
// still accepted a raw `CommitIntegration` from any caller. That parameter is gone: `SquashIntegrated`
// is now reachable only through `store_and_admit_merge_basis`, whose subject requires a derived base
// and a conflict-free merge of the anchors' own manifests, and whose anchors were resolved from this
// repository's history. The anchor cannot fail to pre-exist, so the check has no subject rather than
// no callers.
//
// IT WAS LEFT STANDING AS A PUBLIC HELPER WITH NO CALL SITE, which DESIGN 3c names outright: a
// declaration nothing consumes is redundant work that costs authoring, review and maintenance and
// displaces nothing -- and worse here, a public membership check beside a sealed route invites a
// future caller to re-admit an integration on membership alone, which is the exact hole the seal was
// built to close. Found by external review.

// A ROOT THE STORE ITSELF JUST BRANDED HAS NOTHING LEFT TO RESOLVE, so this route cannot refuse for
// root resolution and its outcome type does not carry the arms.
//
// THE ROUTE EXISTS BECAUSE A CALLER CAN HOLD STRONGER EVIDENCE THAN `mint_repository_commit`
// ACCEPTS. That function takes a `CorpusManifestTarget`, which is a PROPOSITION about a locator, so
// its return type honestly carries the three ways resolving that proposition can fail. But a caller
// that has just received `CorpusManifestStored { store, manifest }` does not hold a proposition: it
// holds the `CorpusManifestObjectRef` THE STORE HANDED BACK, for an object that store demonstrably
// contains -- had the locator been absent or occupied by another kind, the store call would have
// returned its own refusal instead. Re-asking `find_corpus_manifest_record` there is asking a
// question that has already been answered, and then having to say something about an answer that
// cannot arrive.
//
// THE ALTERNATIVE THAT WAS BUILT FIRST AND REJECTED was for the caller to keep the generic route and
// TRANSLATE the three impossible root refusals into one coarser cause. That is worse than it looks.
// It fabricates a public arm no execution can produce, and it does so by REASONING ABOUT THE
// CALLER'S CONTEXT INSIDE A FUNCTION THAT CANNOT SEE IT -- a translator handed a
// `RepositoryCommitMint` has no evidence its argument came from the store one line earlier. And the
// three arms are not one fact even in the impossible case: a missing root would mean the object
// vanished, while a wrong-kind root would mean the locator now denotes something else, which
// contradicts a collision-aware insertion far more strongly. Collapsing them would erase the
// evidence needed to tell which invariant had failed.
//
// So the question is REMOVED rather than answered more elegantly, which is DESIGN section 5's
// construction over validation and section 4b's top rung: the invalid state has no constructor on
// this route.
//
// EVERY OTHER ADMISSION STILL RUNS. This is not a fast path around the mint's rules -- the allocator,
// the integration anchor's preexistence and the parent's existence are all still decided here, and
// `mint_repository_commit` now reaches them THROUGH this function rather than beside it, so there is
// one authority for those rules rather than two copies free to drift.
type BrandedRootMint
  = BrandedRootMinted { repository: RepositoryEnvelope, reference: RepositoryCommitRef }
  | BrandedRootAllocatorInvalid { next_ordinal: Int }
  | BrandedRootParentMissing { parent: RepositoryCommitRef }

// A BRAND PROVES KIND IN SOME STORE, NOT IN WHICH STORE, AND THAT IS THE GAP THIS CARRIER CLOSES.
//
// `CorpusManifestObjectRef` says "the store that produced me held a corpus manifest at this locator".
// It does not say WHICH store, so a mint taking a repository and a root as two independent parameters
// accepts a root branded by a different store entirely -- and the commit that results names a manifest
// its own repository does not hold. Everything downstream is well-formed: it encodes, it mints, and it
// refuses only later at checkout, in the wrong place and naming the wrong owner.
//
// THE LIVE CALLERS ALL PAIRED CORRECTLY, WHICH IS EXACTLY WHY THIS IS WORTH SEALING RATHER THAN
// CHECKING. The hazard was latent, so no test would have found it; `squash_merge` shows the shape most
// clearly, having had to hand-build a fresh envelope around the advanced store and then pass the
// reference beside it, with nothing but the author's care holding the two together.
//
// SO THE PAIR IS THE VALUE. `sole_constructor` means the only ways to obtain one are the two routes
// below, and both derive the root and the repository from ONE motion: resolving a locator against that
// repository's store, or storing entries into it. There is no argument through which the halves can be
// sourced separately.
type RepositoryManifestRoot sole_constructor {
  repository: RepositoryEnvelope
  root: CorpusManifestObjectRef
}

// RESOLVING KEEPS ALL THREE WRONG-KIND POPULATIONS APART, for the reason this stack has paid for
// before: a locator OCCUPIED by a file or a node is not an EMPTY locator, and reporting one as the
// other sends an author to restore an object that is already there.
type RepositoryManifestRootResolution
  = RepositoryManifestRootResolved(RepositoryManifestRoot)
  | RepositoryManifestRootMissing { root: ObjectId }
  | RepositoryManifestRootIsAuthoredSource { root: ObjectId }
  | RepositoryManifestRootIsSemanticNode { root: ObjectId }

fn repository_root_by_resolving(
  repository: RepositoryEnvelope,
  root: CorpusManifestTarget,
) -> RepositoryManifestRootResolution {
  match find_corpus_manifest_record(
    store: repository.store,
    identity: corpus_manifest_target_locator(target: root)
  ) {
    CorpusManifestAbsent { identity: r } => RepositoryManifestRootMissing { root: r }
    CorpusManifestIsAuthoredSource { identity: r } =>
      RepositoryManifestRootIsAuthoredSource { root: r }
    CorpusManifestIsSemanticNode { identity: r } =>
      RepositoryManifestRootIsSemanticNode { root: r }
    CorpusManifestFound(record) =>
      RepositoryManifestRootResolved(
        RepositoryManifestRoot { repository: repository, root: record.identity }
      )
  }
}

// STORING ADVANCES THE STORE AND BRANDS THE ROOT IN ONE MOTION, which is what a caller that just
// built a manifest needs. Before this existed, `squash_merge` stored into `repository.store`, then
// hand-assembled a new envelope around the advanced store, then passed the reference beside it -- three
// steps in which the pairing was the author's responsibility. Now the advanced repository and the root
// leave together and cannot be separated.
//
// THE RAW-LIST ROUTE THAT USED TO STAND HERE IS DELETED RATHER THAN KEPT BESIDE THIS ONE. Once the
// merge fold produced `PathUniqueManifestEntries` directly, its last consumer was gone, and a public
// store route taking a bare list is exactly the forge this stack has removed twice: nothing about the
// parameter establishes that the entries are path-unique, so keeping it would leave a second authority
// for storing a manifest whose only distinguishing feature is that it can be lied to.
// THE PATH-UNIQUE STORE ROUTE HAS TWO ARMS BECAUSE ITS ARGUMENT CANNOT CARRY A DUPLICATE.
//
// A producer that built its entries through the invariant-preserving constructions on
// `PathUniqueManifestEntries` has already settled the duplicate question, so asking it again here
// would be validation where construction was available, and its answer would be an arm no caller on
// this route could reach. It is not a second authority: the insertion, the identity and the
// canonicalization are `store_path_unique_manifest`'s, shared with the checking route. What differs is
// the one thing that should -- whether the duplicate question is asked at all. Ruled by external
// review, alongside the merge fold that produces the carrier.
type RepositoryManifestRootUniqueStore
  = RepositoryManifestRootUniqueStored(RepositoryManifestRoot)
  | RepositoryManifestRootUniqueLocatorCollision { identity: ObjectId }

fn repository_root_by_storing_unique(
  repository: RepositoryEnvelope,
  unique: PathUniqueManifestEntries,
) -> RepositoryManifestRootUniqueStore {
  match store_path_unique_manifest(store: repository.store, unique: unique) {
    UniqueManifestLocatorCollision { identity: i, existing: _, incoming: _ } =>
      RepositoryManifestRootUniqueLocatorCollision { identity: i }
    UniqueManifestStored { store: stored, manifest: reference } =>
      RepositoryManifestRootUniqueStored(
        RepositoryManifestRoot {
          repository: RepositoryEnvelope {
            store: stored,
            commits: repository.commits,
            commit_allocator: repository.commit_allocator,
            checked_out: repository.checked_out,
            staged: repository.staged,
          },
          root: reference,
        }
      )
  }
}

fn mint_commit_from_stored_manifest(
  subject: RepositoryManifestRoot,
  message: String,
  parent: RepositoryCommitRef?,
) -> BrandedRootMint {
  match admit_commit_subject(subject: subject, parent: parent) {
    CommitSubjectAllocatorInvalid { next_ordinal: n } => BrandedRootAllocatorInvalid { next_ordinal: n }
    CommitSubjectParentMissing { parent: p } => BrandedRootParentMissing { parent: p }
    CommitSubjectAdmitted(admitted) =>
      widen_minted_commit(minted: mint_repository_commit_admitted(admitted: admitted, message: message))
  }
}

// THE GENERIC ROUTE RESOLVES THE ROOT AND THEN DELEGATES, so the admission rules live in exactly one
// place. A caller holding only a locator still gets the three root refusals, because for that caller
// they are reachable and real.
fn mint_repository_commit(
  repository: RepositoryEnvelope,
  root: CorpusManifestTarget,
  message: String,
  parent: RepositoryCommitRef?,
) -> RepositoryCommitMint {
  match admit_commit_allocator(repository: repository) {
    CommitAllocatorInvalid { next_ordinal: n } =>
      RepositoryCommitMintAllocatorInvalid { next_ordinal: n }
    CommitAllocatorAdmitted =>
      match repository_root_by_resolving(repository: repository, root: root) {
        RepositoryManifestRootMissing { root: r } => RepositoryCommitMintRootMissing { root: r }
        RepositoryManifestRootIsAuthoredSource { root: r } =>
          RepositoryCommitMintRootIsAuthoredSource { root: r }
        RepositoryManifestRootIsSemanticNode { root: r } =>
          RepositoryCommitMintRootIsSemanticNode { root: r }
        RepositoryManifestRootResolved(subject) =>
          widen_branded_root_mint(
            mint: mint_commit_from_stored_manifest(
              subject: subject,
              message: message,
              parent: parent,
            )
          )
      }
  }
}

// ------------------------------------------------------------------------------------------------
// Intake commits (gunbc.scm.intake)
// ------------------------------------------------------------------------------------------------

// WHERE A LINE STANDS IN ITS EXTERNAL SOURCE: the nearest intake commit on a commit's ancestry, which
// is where the line was last placed onto an external revision. It is read from the commit table the
// index carries, so it costs no shard. Four states, never a default: an unrecorded commit on the line
// is a document older than the member and cannot be read past -- below it the line may have been
// placed anywhere -- so it is its own arm rather than a skip.
type LineIntake
  = LineIntakeAt { commit: RepositoryCommitRef, revision: IntakeRevision }
  | LineIntakeAbsent
  | LineIntakeUnrecorded { commit: RepositoryCommitRef }
  | LineIntakeUnreadable { at: RepositoryCommitRef }

type LineIntakeAcc {
  found: LineIntake?
}

fn intakes_by_ordinal(commits: List<RepositoryCommit>) -> Map<Int, CommitIntake> {
  fold(commits, init: empty_map(), f: fn(m, c) { map_insert(m, minted_id_ordinal(id: c.reference.identity), c.intake) })
}

fn line_intake(commits: List<RepositoryCommit>, head: RepositoryCommitRef) -> LineIntake {
  match ancestry_walk(start: head, history: repository_history(commits: commits)) {
    AncestryTraced { chain } => {
      let by_ordinal = intakes_by_ordinal(commits: commits)
      match fold(chain, init: LineIntakeAcc { found: none }, f: (acc, at) =>
        match acc.found {
          Present { value: _ } => acc
          Absent =>
            match map_lookup(m: by_ordinal, key: minted_id_ordinal(id: at.identity)) {
              Absent => LineIntakeAcc { found: Present { value: LineIntakeUnreadable { at: at } } }
              Present { value: intake } =>
                match intake_line_mark(intake: intake) {
                  LineNotMarked => acc
                  LineMarkUnrecorded => LineIntakeAcc { found: Present { value: LineIntakeUnrecorded { commit: at } } }
                  LineMarkedAt { revision } => LineIntakeAcc { found: Present { value: LineIntakeAt { commit: at, revision: revision } } }
                }
            }
        }).found {
        Absent => LineIntakeAbsent
        Present { value: found } => found
      }
    }
    AncestryBrokenAt { commit, missing_parent: _ } => LineIntakeUnreadable { at: commit }
    AncestryStartNotInHistory { start } => LineIntakeUnreadable { at: start }
    AncestryRevisitsACommit { detected_from } => LineIntakeUnreadable { at: detected_from }
  }
}

// THE INTAKE COMMIT THAT PLACED SOME LINE AT `revision`, if the repository holds one. A repository may
// hold several -- a base and the advances after it -- and each revision is placed at most once by
// the mint below, so the first match is the only one.
fn intake_commit_at_revision(commits: List<RepositoryCommit>, revision: IntakeRevision) -> RepositoryCommit? {
  (commits |> filter(c => match intake_line_mark(intake: c.intake) {
    LineMarkedAt { revision: r } => intake_revision_eq(left: r, right: revision)
    LineNotMarked => false
    LineMarkUnrecorded => false
  })).first()
}

// THE ADVANCE THAT LEAVES `from`, if one exists. An advance is admitted only from a revision no
// advance has left yet (mint_intake_advance), so at most one exists and the intake commits form ONE
// chain -- which is what makes "the tip" and "the later of two bases" questions with one answer.
fn intake_advance_from(commits: List<RepositoryCommit>, from: IntakeRevision) -> RepositoryCommit? {
  (commits |> filter(c => match c.intake {
    IntakeAdvance { from: f, to: _ } => intake_revision_eq(left: f, right: from)
    IntakeNone => false
    IntakeBase { revision: _ } => false
    IntakeUnrecordedByFormat => false
    IntakeStaleCapture { captured_against: _ } => false
  })).first()
}

// THE TIP OF THE INTAKE LINE: the intake commit no advance leaves. An advance is minted only onto a
// line whose intake stands at its `from`, and only from a revision no advance has left
// (mint_intake_advance), so intake commits form one chain and its tip is unique.
type IntakeTip {
  commit: RepositoryCommit
  revision: IntakeRevision
}

fn intake_tip(commits: List<RepositoryCommit>) -> IntakeTip? {
  let marked = commits |> flat_map(c => match intake_line_mark(intake: c.intake) {
    LineMarkedAt { revision } => [IntakeTip { commit: c, revision: revision }]
    LineNotMarked => []
    LineMarkUnrecorded => []
  })
  (marked |> filter(t =>
    !any(marked, other => match other.commit.intake {
      IntakeAdvance { from, to: _ } => intake_revision_eq(left: from, right: t.revision)
      IntakeNone => false
      IntakeBase { revision: _ } => false
      IntakeUnrecordedByFormat => false
      IntakeStaleCapture { captured_against: _ } => false
    }))).first()
}

// THE INTAKE MINTS: ONE ROUTE PER MINTABLE ARM, so each answers exactly the questions its arm has.
// A base is a root commit, so its route has no parent to look for and no line to continue; an advance
// descends from a commit whose line stands at exactly its `from`, so an advance can only ever
// CONTINUE the line it names -- applying the external change from S_k to S_k+1 onto a line placed
// anywhere but S_k is the defect this member exists to make unwritable (gunbc.recurring_failure_mode
// a_worktree_delta_against_one_base_applied_onto_another). The intake value is BUILT by each route
// rather than accepted, so IntakeUnrecordedByFormat (a reading of an old document) and IntakeNone
// (the ordinary routes' arm) are unwritable here rather than refused. A revision is placed once: a
// second commit placing a revision the repository already holds would make "the base commit for this
// revision" ambiguous.
//
// Neither route goes through staging, and that is deliberate: an advance whose external change
// touched nothing the manifest holds freezes its parent's root unchanged, which staging refuses as
// "nothing to freeze" but which is exactly the record a later candidate on that revision must descend
// from. Both run the publication completeness the staged route runs, over the root's own entries.
// The selection is left where it was; the caller moves it.
type IntakeRootRefusal
  = IntakeRootMissing { root: ObjectId }
  | IntakeRootIsAuthoredSource { root: ObjectId }
  | IntakeRootIsSemanticNode { root: ObjectId }
  | IntakeRootSourceUnrecoverable { cause: CorpusEntrySourceRefusal }

type IntakeRootResolution
  = IntakeRootResolved { subject: RepositoryManifestRoot }
  | IntakeRootRefused { cause: IntakeRootRefusal }

// THE ROOT IS RESOLVED ONCE, and the record that resolution finds is both the sealed subject and the
// entry population completeness reads, so the entries observed are the root's own.
fn resolve_intake_root(repository: RepositoryEnvelope, root: CorpusManifestTarget) -> IntakeRootResolution {
  match find_corpus_manifest_record(store: repository.store, identity: corpus_manifest_target_locator(target: root)) {
    CorpusManifestAbsent { identity: r } => IntakeRootRefused { cause: IntakeRootMissing { root: r } }
    CorpusManifestIsAuthoredSource { identity: r } => IntakeRootRefused { cause: IntakeRootIsAuthoredSource { root: r } }
    CorpusManifestIsSemanticNode { identity: r } => IntakeRootRefused { cause: IntakeRootIsSemanticNode { root: r } }
    CorpusManifestFound(record) =>
      match observe_corpus_source_completeness(store: repository.store, entries: record.entries) {
        CorpusSourceIncomplete { cause: c } => IntakeRootRefused { cause: IntakeRootSourceUnrecoverable { cause: c } }
        CorpusSourcesComplete => IntakeRootResolved { subject: RepositoryManifestRoot { repository: repository, root: record.identity } }
      }
  }
}

type IntakeBaseMint
  = IntakeBaseMinted { repository: RepositoryEnvelope, reference: RepositoryCommitRef }
  | IntakeBaseAllocatorInvalid { next_ordinal: Int }
  | IntakeBaseRootRefused { cause: IntakeRootRefusal }
  | IntakeBaseRevisionAlreadyPlaced { commit: RepositoryCommitRef }

fn mint_intake_base(
  repository: RepositoryEnvelope,
  root: CorpusManifestTarget,
  message: String,
  revision: IntakeRevision,
) -> IntakeBaseMint {
  match admit_commit_allocator(repository: repository) {
    CommitAllocatorInvalid { next_ordinal: n } => IntakeBaseAllocatorInvalid { next_ordinal: n }
    CommitAllocatorAdmitted =>
      match intake_commit_at_revision(commits: repository.commits, revision: revision) {
        Present { value: placed } => IntakeBaseRevisionAlreadyPlaced { commit: placed.reference }
        Absent =>
          match resolve_intake_root(repository: repository, root: root) {
            IntakeRootResolved { subject } => {
              let minted = mint_repository_commit_admitted(
                admitted: AdmittedCommitSubject {
                  subject: subject,
                  ancestry: RootCommit,
                  integration: NoSquashIntegration,
                  intake: IntakeBase { revision: revision },
                },
                message: message,
              )
              IntakeBaseMinted { repository: minted.repository, reference: minted.reference }
            }
            IntakeRootRefused { cause } => IntakeBaseRootRefused { cause: cause }
          }
      }
  }
}

type IntakeAdvanceMint
  = IntakeAdvanceMinted { repository: RepositoryEnvelope, reference: RepositoryCommitRef }
  | IntakeAdvanceAllocatorInvalid { next_ordinal: Int }
  | IntakeAdvanceParentMissing { parent: RepositoryCommitRef }
  | IntakeAdvanceRootRefused { cause: IntakeRootRefusal }
  | IntakeAdvanceDoesNotMove { revision: IntakeRevision }
  | IntakeAdvanceDiscontinuous { parent: RepositoryCommitRef, line: LineIntake }
  | IntakeAdvanceRevisionAlreadyPlaced { commit: RepositoryCommitRef }
  | IntakeAdvanceLineAlreadyAdvanced { commit: RepositoryCommitRef }

fn mint_intake_advance(
  repository: RepositoryEnvelope,
  root: CorpusManifestTarget,
  message: String,
  parent: RepositoryCommitRef,
  from: IntakeRevision,
  to: IntakeRevision,
) -> IntakeAdvanceMint {
  if intake_revision_eq(left: from, right: to) {
    IntakeAdvanceDoesNotMove { revision: to }
  } else {
    match admit_commit_allocator(repository: repository) {
      CommitAllocatorInvalid { next_ordinal: n } => IntakeAdvanceAllocatorInvalid { next_ordinal: n }
      CommitAllocatorAdmitted =>
        match admit_commit_parent(repository: repository, parent: Present { value: parent }) {
          CommitParentAbsent { parent: p } => IntakeAdvanceParentMissing { parent: p }
          CommitParentAdmitted { ancestry } =>
            match line_intake(commits: repository.commits, head: parent) {
              LineIntakeAt { commit, revision } =>
                if !intake_revision_eq(left: revision, right: from) {
                  IntakeAdvanceDiscontinuous { parent: parent, line: LineIntakeAt { commit: commit, revision: revision } }
                } else {
                  match intake_advance_from(commits: repository.commits, from: from) {
                    Present { value: onward } => IntakeAdvanceLineAlreadyAdvanced { commit: onward.reference }
                    Absent =>
                  match intake_commit_at_revision(commits: repository.commits, revision: to) {
                    Present { value: placed } => IntakeAdvanceRevisionAlreadyPlaced { commit: placed.reference }
                    Absent =>
                      match resolve_intake_root(repository: repository, root: root) {
                        IntakeRootResolved { subject } => {
                          let minted = mint_repository_commit_admitted(
                            admitted: AdmittedCommitSubject {
                              subject: subject,
                              ancestry: ancestry,
                              integration: NoSquashIntegration,
                              intake: IntakeAdvance { from: from, to: to },
                            },
                            message: message,
                          )
                          IntakeAdvanceMinted { repository: minted.repository, reference: minted.reference }
                        }
                        IntakeRootRefused { cause } => IntakeAdvanceRootRefused { cause: cause }
                      }
                  }
                  }
                }
              LineIntakeAbsent => IntakeAdvanceDiscontinuous { parent: parent, line: LineIntakeAbsent }
              LineIntakeUnrecorded { commit } => IntakeAdvanceDiscontinuous { parent: parent, line: LineIntakeUnrecorded { commit: commit } }
              LineIntakeUnreadable { at } => IntakeAdvanceDiscontinuous { parent: parent, line: LineIntakeUnreadable { at: at } }
            }
        }
    }
  }
}

// ------------------------------------------------------------------------------------------------
// Recording the intakes a pre-intake repository never wrote
// ------------------------------------------------------------------------------------------------

// THE TYPED READING OF A REPOSITORY WRITTEN BEFORE THE INTAKE MEMBER EXISTED, recorded once and in
// place (the parent ruling on gunbc#13402: no re-seed; srv2's shell-typed-invocation keeps its
// history). Its commits read back IntakeUnrecordedByFormat, so this admission is the one route by
// which an unrecorded commit acquires a recorded intake, and it asserts nothing the history cannot
// support: every unrecorded commit is covered exactly once and no recorded commit is touched; a
// root commit (and only a root) records the base its producer froze; every other commit records
// IntakeNone, or IntakeStaleCapture when its content was computed against a revision OTHER than its
// line's base -- and a "stale" capture against its own line's base refuses, because that would brand
// an on-base commit stale. What the revisions ARE is the caller's evidence (the belt reads them from
// its own legacy records); what may be RECORDED from them is this module's.
type LegacyIntakeRecord {
  commit: RepositoryCommitRef
  intake: CommitIntake
}

type LegacyIntakeRefusal
  = LegacyIntakeUnknownCommit { commit: RepositoryCommitRef }
  | LegacyIntakeAlreadyRecorded { commit: RepositoryCommitRef }
  | LegacyIntakeDuplicated { commit: RepositoryCommitRef }
  | LegacyIntakeUncovered { commit: RepositoryCommitRef }
  | LegacyIntakeRootNotBase { commit: RepositoryCommitRef }
  | LegacyIntakeBaseNotRoot { commit: RepositoryCommitRef }
  | LegacyIntakeNotRecordable { commit: RepositoryCommitRef }
  | LegacyStaleCaptureOnItsOwnBase { commit: RepositoryCommitRef }
  | LegacyIntakeLineUnreadable { commit: RepositoryCommitRef }

type LegacyIntakeRecording
  = LegacyIntakesRecorded { repository: RepositoryEnvelope }
  | LegacyIntakesNothingUnrecorded
  | LegacyIntakesRefused { cause: LegacyIntakeRefusal }

fn intake_is_unrecorded(intake: CommitIntake) -> Bool {
  match intake {
    IntakeUnrecordedByFormat => true
    IntakeNone => false
    IntakeBase { revision: _ } => false
    IntakeAdvance { from: _, to: _ } => false
    IntakeStaleCapture { captured_against: _ } => false
  }
}

fn legacy_record_shape_refusal(commit: RepositoryCommit, intake: CommitIntake) -> LegacyIntakeRefusal? {
  let is_root = match commit.ancestry {
    RootCommit => true
    DescendsFrom { parent: _ } => false
  }
  match intake {
    IntakeBase { revision: _ } => if is_root { none } else { Present { value: LegacyIntakeBaseNotRoot { commit: commit.reference } } }
    IntakeNone => if is_root { Present { value: LegacyIntakeRootNotBase { commit: commit.reference } } } else { none }
    IntakeStaleCapture { captured_against: _ } => if is_root { Present { value: LegacyIntakeRootNotBase { commit: commit.reference } } } else { none }
    IntakeAdvance { from: _, to: _ } => Present { value: LegacyIntakeNotRecordable { commit: commit.reference } }
    IntakeUnrecordedByFormat => Present { value: LegacyIntakeNotRecordable { commit: commit.reference } }
  }
}

type LegacyRecordAcc {
  by_ordinal: Map<Int, CommitIntake>
  refused: LegacyIntakeRefusal?
}

fn record_legacy_intakes(repository: RepositoryEnvelope, records: List<LegacyIntakeRecord>) -> LegacyIntakeRecording {
  let unrecorded = repository.commits |> filter(c => intake_is_unrecorded(intake: c.intake))
  if count(unrecorded) == 0 {
    LegacyIntakesNothingUnrecorded
  } else {
    let empty: Map<Int, CommitIntake> = empty_map()
    let acc = fold(records, init: LegacyRecordAcc { by_ordinal: empty, refused: none }, f: (acc, r) =>
      match acc.refused {
        Present { value: _ } => acc
        Absent =>
          match commit_at_reference(commits: repository.commits, reference: r.commit) {
            Absent => LegacyRecordAcc { by_ordinal: acc.by_ordinal, refused: Present { value: LegacyIntakeUnknownCommit { commit: r.commit } } }
            Present { value: c } =>
              if !intake_is_unrecorded(intake: c.intake) {
                LegacyRecordAcc { by_ordinal: acc.by_ordinal, refused: Present { value: LegacyIntakeAlreadyRecorded { commit: r.commit } } }
              } else if map_contains_key(acc.by_ordinal, minted_id_ordinal(id: r.commit.identity)) {
                LegacyRecordAcc { by_ordinal: acc.by_ordinal, refused: Present { value: LegacyIntakeDuplicated { commit: r.commit } } }
              } else {
                match legacy_record_shape_refusal(commit: c, intake: r.intake) {
                  Present { value: cause } => LegacyRecordAcc { by_ordinal: acc.by_ordinal, refused: Present { value: cause } }
                  Absent => LegacyRecordAcc { by_ordinal: map_insert(acc.by_ordinal, minted_id_ordinal(id: r.commit.identity), r.intake), refused: none }
                }
              }
          }
      })
    match acc.refused {
      Present { value: cause } => LegacyIntakesRefused { cause: cause }
      Absent =>
        match (unrecorded |> filter(c => !map_contains_key(acc.by_ordinal, minted_id_ordinal(id: c.reference.identity)))).first() {
          Present { value: missed } => LegacyIntakesRefused { cause: LegacyIntakeUncovered { commit: missed.reference } }
          Absent => {
            let recorded = RepositoryEnvelope {
              store: repository.store,
              commits: map(repository.commits, c => match map_lookup(m: acc.by_ordinal, key: minted_id_ordinal(id: c.reference.identity)) {
                Absent => c
                Present { value: intake } => RepositoryCommit { reference: c.reference, root: c.root, message: c.message, ancestry: c.ancestry, integration: c.integration, intake: intake }
              }),
              commit_allocator: repository.commit_allocator,
              checked_out: repository.checked_out,
              staged: repository.staged,
            }
            match legacy_stale_on_own_base(commits: recorded.commits) {
              Present { value: cause } => LegacyIntakesRefused { cause: cause }
              Absent => LegacyIntakesRecorded { repository: recorded }
            }
          }
        }
    }
  }
}

// A STALE CAPTURE MUST BE STALE AGAINST THE LINE IT NOW STANDS ON: checked after recording, because
// the line's base is itself one of the records.
fn legacy_stale_on_own_base(commits: List<RepositoryCommit>) -> LegacyIntakeRefusal? {
  fold(commits, init: none, f: (found, c) =>
    match found {
      Present { value: _ } => found
      Absent =>
        match c.intake {
          IntakeStaleCapture { captured_against } =>
            match line_intake(commits: commits, head: c.reference) {
              LineIntakeAt { commit: _, revision } =>
                if intake_revision_eq(left: revision, right: captured_against) { Present { value: LegacyStaleCaptureOnItsOwnBase { commit: c.reference } } } else { none }
              LineIntakeAbsent => Present { value: LegacyIntakeLineUnreadable { commit: c.reference } }
              LineIntakeUnrecorded { commit: _ } => Present { value: LegacyIntakeLineUnreadable { commit: c.reference } }
              LineIntakeUnreadable { at: _ } => Present { value: LegacyIntakeLineUnreadable { commit: c.reference } }
            }
          IntakeNone => none
          IntakeBase { revision: _ } => none
          IntakeAdvance { from: _, to: _ } => none
          IntakeUnrecordedByFormat => none
        }
    })
}

fn widen_branded_root_mint(mint: BrandedRootMint) -> RepositoryCommitMint {
  match mint {
    BrandedRootMinted { repository: r, reference: c } =>
      RepositoryCommitMinted { repository: r, reference: c }
    BrandedRootAllocatorInvalid { next_ordinal: n } =>
      RepositoryCommitMintAllocatorInvalid { next_ordinal: n }
    BrandedRootParentMissing { parent: p } => RepositoryCommitMintParentMissing { parent: p }
  }
}


// THE ROW CONSTRUCTION HAS ONE OUTCOME, AND ITS TYPE NOW SAYS SO.
//
// This function performs no admission: every question -- is the allocator sound, does the parent
// exist, does the integration anchor resolve -- has already been answered by the time it is reached,
// which is what `_admitted` meant. It nevertheless returned `BrandedRootMint`, a four-arm coproduct
// of which it could only ever produce one. That is harmless where the caller checked everything, and
// actively harmful for a caller whose route makes one of the OTHER arms impossible: it had no way to
// narrow, so it either matched a state it could not reach or invented a cause to close the match.
// `gunbc.scm.ordinary_commit` hit exactly that and its first draft translated the unreachable
// integration arm into a parent-missing -- a fabricated cause, the `callee_arm_carried_past_its_exclusion` error again.
//
// So the construction answers `MintedCommit`, and each admission route widens it to whatever
// coproduct ITS questions make reachable. The admission rules are not duplicated: they stay in the
// routes, and this is the single place a commit row is built.
type MintedCommit sole_constructor {
  repository: RepositoryEnvelope
  reference: RepositoryCommitRef
}

// THE PARENT ADMISSION, HELD ONCE. It was written so the ordinary and squash routes would ask it the
// same way rather than each writing their own lookup; squash no longer asks it at all, because its
// parent arrives already resolved inside `ResolvedMergeAnchors`. It is held once for the ordinary
// routes that remain, and the squash route reaching a parent WITHOUT this question is the point of
// the merge seal, not a gap in it.
type CommitParentAdmission
  = CommitParentAdmitted { ancestry: CommitAncestry }
  | CommitParentAbsent { parent: RepositoryCommitRef }

fn admit_commit_parent(
  repository: RepositoryEnvelope,
  parent: RepositoryCommitRef?,
) -> CommitParentAdmission {
  match parent {
    Absent => CommitParentAdmitted { ancestry: RootCommit }
    Present { value: parent_ref } =>
      match commit_at_reference(commits: repository.commits, reference: parent_ref) {
        Absent => CommitParentAbsent { parent: parent_ref }
        Present { value: _ } => CommitParentAdmitted { ancestry: DescendsFrom { parent: parent_ref } }
      }
  }
}

// THE ADMITTED SUBJECT, SEALED, BECAUSE THE OUTPUT BRAND WAS NEVER THE PROBLEM.
//
// `mint_repository_commit_admitted` answers a `sole_constructor MintedCommit`, which says the value
// came from here -- and says nothing about whether the admissions ran. The function is public, `.dag`
// has no module privacy, and it appends the commit row WITHOUT checking the allocator, the parent, or
// the integration anchor, because by contract those were already checked. So it was a forge factory:
// a caller could hand it any repository, any root, and a `DescendsFrom` naming a commit that does not
// exist, and receive a well-formed repository back. Sealing the OUTPUT cannot close that; the input
// relation is what needed carrying. Found by external review.
//
// SO THE ADMISSIONS MINT THE SUBJECT. `AdmittedCommitSubject` can only be built inside this module,
// and this function takes nothing else, so it cannot be reached with an unadmitted one.
//
// THE TWO ROUTES ARE NO LONGER VARIANTS OF ONE ADMISSION. That sentence stood here while squash still
// passed through `admit_commit_subject`, differing only in which questions it asked. It does not any
// more: an ordinary commit is admitted from a subject and a bare parent reference, while a squash is
// admitted from a sealed `AdmittedMergeSubject` whose anchors and merged manifests were established
// together. They share the ROW CONSTRUCTION and the allocator rule below, and they no longer share an
// admission -- which is the whole reason the integration parameter could be removed from this one.
// THE ALLOCATOR RULE, HELD ONCE. `next_ordinal < 0` was spelled independently in three executable
// places -- the generic route before root resolution, and both subject admissions -- directly beneath
// a rationale claiming the admission rules have one authority each. Three copies of a rule is three
// rules, and the seal that stops a bypass does nothing about drift between them. Found by external
// review.
type CommitAllocatorAdmission
  = CommitAllocatorAdmitted
  | CommitAllocatorInvalid { next_ordinal: Int }

fn admit_commit_allocator(repository: RepositoryEnvelope) -> CommitAllocatorAdmission {
  if repository.commit_allocator.next_ordinal < 0 {
    CommitAllocatorInvalid { next_ordinal: repository.commit_allocator.next_ordinal }
  } else {
    CommitAllocatorAdmitted
  }
}

type AdmittedCommitSubject sole_constructor {
  subject: RepositoryManifestRoot
  ancestry: CommitAncestry
  integration: CommitIntegration
  intake: CommitIntake
}

type CommitSubjectAdmission
  = CommitSubjectAdmitted(AdmittedCommitSubject)
  | CommitSubjectAllocatorInvalid { next_ordinal: Int }
  | CommitSubjectParentMissing { parent: RepositoryCommitRef }

// THE GENERIC PRODUCTION MINT IS ORDINARY-ONLY, BECAUSE MEMBERSHIP OF A SOURCE IS NOT AUTHORITY TO
// RECORD THAT IT WAS CONSUMED.
//
// This route used to take a raw `CommitIntegration` and admit it on the strength of the named source
// merely EXISTING. That made it a second, wide-open production root for `SquashIntegrated` -- the
// receipt `consumed_join` afterwards TRUSTS in order to refuse an honest merge -- sitting beside the
// merge route this stack had just spent two rounds sealing. Closing one door while an unlocked one
// stood next to it is not a wall. Found by external review.
//
// The parameter is REMOVED rather than validated: this function supplies `NoSquashIntegration` itself,
// so the integrated arm is unwritable through this route instead of refused by it (DESIGN 4b:
// construction over validation). `CommitSubjectIntegrationSourceMissing` goes with it -- there is no
// source to look for, so the question has no subject rather than an unknown answer, and the
// `integration_anchor_resolves` call it guarded is gone.
//
// THE MEASUREMENT THAT MADE THIS SAFE TO DO: every production call site already passed
// `NoSquashIntegration`. The only callers that passed `SquashIntegrated` were two FIXTURES fabricating
// integrated history, and they now have to perform a real merge to obtain one -- which is the stronger
// evidence anyway. An integration-bearing commit is reachable through exactly one route in this
// module: `store_and_admit_merge_basis`, whose subject requires a derived base and a conflict-free
// manifest merge.
fn admit_commit_subject(
  subject: RepositoryManifestRoot,
  parent: RepositoryCommitRef?,
) -> CommitSubjectAdmission {
  let repository = subject.repository
  match admit_commit_allocator(repository: repository) {
    CommitAllocatorInvalid { next_ordinal: n } => CommitSubjectAllocatorInvalid { next_ordinal: n }
    CommitAllocatorAdmitted =>
      match admit_commit_parent(repository: repository, parent: parent) {
        CommitParentAbsent { parent: p } => CommitSubjectParentMissing { parent: p }
        CommitParentAdmitted { ancestry: ancestry } =>
          CommitSubjectAdmitted(
            AdmittedCommitSubject {
              subject: subject,
              ancestry: ancestry,
              integration: NoSquashIntegration,
              intake: IntakeNone,
            }
          )
      }
  }
}

// THE ORDINARY ROUTE DOES NOT ASK THE INTEGRATION QUESTION, so its admission does not carry the
// answer -- and it no longer asks it because there is no integration to ask ABOUT. An earlier form of
// this note explained that `integration_anchor_resolves` returned `Absent` for `NoSquashIntegration`
// by construction, so skipping the call cost nothing. That reading described a route that still TOOK
// an integration; this one supplies `NoSquashIntegration` itself and the helper is deleted. The arm is
// ABSENT from this outcome rather than unreachable within it, which remains the difference between a
// caller that cannot ask and a caller that must match and invent.
// A BASIS THIS REPOSITORY ADMITTED -- SUBJECT, ANCESTRY AND INTEGRATION AS ONE FACT.
//
// The first version took an ordinary public `CommitAncestry` and checked only the allocator.
// `CommitAncestry` STATES A RELATION; it is not evidence that any repository admitted one, so a caller
// could construct `DescendsFrom { parent: <a reference this repository does not hold> }` and be handed
// a `MintedCommit` whose ancestry DANGLES.
//
// Sealing the ancestry alone did not close it, and the second external review said why: an
// `AdmittedCommitAncestry` proved admission in SOME repository, while the subject arrived as a
// SEPARATE argument carrying its own. An ancestry admitted against repository A could therefore be
// paired with a subject from repository B and mint a dangling parent in B -- the same defect one level
// up, because the evidence was still not bound to the thing it was evidence ABOUT. The integration had
// the identical hole: `CommitIntegration` arrived raw, its source never established anywhere.
//
// A COMPARISON WOULD HAVE BEEN VALIDATION WHERE CONSTRUCTION WAS AVAILABLE (DESIGN 5). Checking that
// the ancestry's repository equals the subject's is a check that can be satisfied while the realization
// still lies. So the three facts became ONE sealed value instead: the subject travels INSIDE the
// evidence, and every mint below derives the ancestry and the integration from `subject.repository`
// rather than accepting them. There are no two arguments left to mis-pair.
type AdmittedCommitBasis sole_constructor {
  subject: RepositoryManifestRoot
  ancestry: CommitAncestry
  integration: CommitIntegration
}

type BasisAdmission
  = BasisAdmitted(AdmittedCommitBasis)
  | BasisParentAbsent { parent: RepositoryCommitRef }

// A ROOT COMMIT HAS NO PARENT AND NO SOURCE, so this mint cannot refuse: both questions have no
// subject rather than an unknown answer.
fn admit_root_basis(subject: RepositoryManifestRoot) -> AdmittedCommitBasis {
  AdmittedCommitBasis {
    subject: subject,
    ancestry: RootCommit,
    integration: NoSquashIntegration,
  }
}

fn admit_descendant_basis(
  subject: RepositoryManifestRoot,
  parent: RepositoryCommitRef,
) -> BasisAdmission {
  match admit_base_in(subject: subject, reference: parent) {
    BaseAbsentInRepository { reference: r } => BasisParentAbsent { parent: r }
    BaseAdmitted { basis: b, committed: _ } => BasisAdmitted(b)
  }
}

// A COMMIT THIS REPOSITORY WAS OBSERVED TO HOLD, CARRYING THE ROW THAT OBSERVATION FOUND.
//
// `admit_merge_basis` USED TO STAND HERE AND IT WAS A PRODUCTION ROOT FOR A CONSUMPTION RECEIPT.
// Given any two references a repository happened to hold, it minted a basis carrying
// `SquashIntegrated { source }` -- the exact row `consumed_join` reads to refuse a LATER merge. `.dag`
// has no module privacy, so any caller could reach it and SPEND a branch without either merge
// authority having admitted the merge. Mere membership of a parent and a source is not authority to
// write that receipt; the empty commit was never the damage, the receipt is. Found by external review,
// in a function this stack added one round earlier while closing a different hole.
//
// So membership is now a VALUE rather than a check a mint repeats. `admit_commit_presence` is the only
// mint, it is this module's own lookup, and the row it found travels inside -- so a holder of a
// presence needs no second lookup to read that commit's root, and no consumer can assemble one from a
// reference it merely happens to have.
type CommitPresence sole_constructor {
  commit: RepositoryCommit
}

fn admit_commit_presence(
  repository: RepositoryEnvelope,
  reference: RepositoryCommitRef,
) -> CommitPresence? {
  match commit_at_reference(commits: repository.commits, reference: reference) {
    Absent => none
    Present { value: commit } => Present { value: CommitPresence { commit: commit } }
  }
}

// THE MERGE SUBJECT IS SEALED HERE, AND THAT IS WHY THE MERGE-BASE AUTHORITY MOVED INTO THIS MODULE.
//
// The transition used to take `repository + presence + presence + entries` as PEERS. Each argument was
// individually sealed and the combination was not, so presences established against one repository
// could be paired with a different one, and -- worse -- any two commits that merely EXISTED, plus any
// path-unique set a caller happened to hold, were sufficient to mint `SquashIntegrated`: the receipt
// `consumed_join` later trusts to refuse an honest merge. The previous round moved that root out of
// `admit_merge_basis`; review then found it had MOVED rather than closed, because the replacement
// still accepted peers. Membership is not authority over an operation. Found by external review.
//
// Closing it required the anchors to be nameable HERE, and they were declared one layer up, so the
// merge-base authority is co-homed into this module. That direction is forced: `RepositoryCommit`,
// `MintedCommit` and `AdmittedCommitSubject` are all sole-constructed here, so the seal chain cannot
// be moved up without dragging the entire mint stack with it, and a basis constructor living above
// this module could not build the subject it exists to produce. Splitting was tried first and is what
// surfaced that constraint (DESIGN 3, acyclicity). The merged entries arrive as `MergedManifestEntries`
// -- constructible only by `merge_manifests` -- so the conflict-free decision is carried rather than
// re-asserted, and `manifest_merge` imports only `object_store`, so naming it introduces no cycle.
type AdmittedMergeSubject sole_constructor {
  anchors: ResolvedMergeAnchors
  merged: MergedManifestEntries
  supersedes: RepositoryCommitRef?
}

// A CORRECTIVE SQUASH NAMES THE STALE INTEGRATION IT SUPERSEDES, AND THE NAMING IS ADMITTED, NOT
// ACCEPTED. The parent ruling on gunbc#13402: supersession must name the EXACT stale commit, by
// identity, ON THE TARGET'S LINE; it must actually be stale (an integration whose consumed source
// carries IntakeStaleCapture); it must not already be superseded on that line; and the new source
// must itself be fresh against its intake (typed line, no stale capture of its own). The admission
// carries the anchors it judged, so the merge it authorizes cannot be paired with other anchors.
type AdmittedSupersession sole_constructor {
  anchors: ResolvedMergeAnchors
  supersedes: RepositoryCommitRef
}

type SupersessionRefusal
  = SupersessionNotOnLine { named: RepositoryCommitRef }
  | SupersessionNotAnIntegration { named: RepositoryCommitRef }
  | SupersessionNotStale { named: RepositoryCommitRef }
  | SupersessionAlreadySuperseded { named: RepositoryCommitRef, by: RepositoryCommitRef }
  | SupersessionSourceNotFresh { source: RepositoryCommitRef }
  | SupersessionLineUnreadable { at: RepositoryCommitRef }

type SupersessionAdmission
  = SupersessionAdmitted(AdmittedSupersession)
  | SupersessionRefused { cause: SupersessionRefusal }

// WHETHER A COMMIT'S CONTENT IS A STALE CAPTURE: its own typed intake says so.
fn commit_is_stale_capture(commit: RepositoryCommit) -> Bool {
  match commit.intake {
    IntakeStaleCapture { captured_against: _ } => true
    IntakeNone => false
    IntakeBase { revision: _ } => false
    IntakeAdvance { from: _, to: _ } => false
    IntakeUnrecordedByFormat => false
  }
}

// THE INTEGRATION A LINE COMMIT RECORDS, AS (source, superseded) -- the one reading every line
// standing and every supersession admission shares.
type LineIntegration {
  at: RepositoryCommitRef
  source: RepositoryCommitRef
  supersedes: RepositoryCommitRef?
}

fn line_integration_of(commit: RepositoryCommit) -> LineIntegration? {
  match commit.integration {
    NoSquashIntegration => none
    SquashIntegrated { source } => Present { value: LineIntegration { at: commit.reference, source: source, supersedes: none } }
    SquashIntegratedSuperseding { source, supersedes } =>
      Present { value: LineIntegration { at: commit.reference, source: source, supersedes: Present { value: supersedes } } }
  }
}

fn admit_supersession(anchors: ResolvedMergeAnchors, supersedes: RepositoryCommitRef) -> SupersessionAdmission {
  let commits = anchors.repository.commits
  let target = anchors.target.commit.reference
  let source_commit = anchors.source.commit
  match ancestry_walk(start: target, history: repository_history(commits: commits)) {
    AncestryBrokenAt { commit, missing_parent: _ } => SupersessionRefused { cause: SupersessionLineUnreadable { at: commit } }
    AncestryStartNotInHistory { start } => SupersessionRefused { cause: SupersessionLineUnreadable { at: start } }
    AncestryRevisitsACommit { detected_from } => SupersessionRefused { cause: SupersessionLineUnreadable { at: detected_from } }
    AncestryTraced { chain } =>
      if !chain_contains(chain: chain, target: supersedes) {
        SupersessionRefused { cause: SupersessionNotOnLine { named: supersedes } }
      } else {
        let line = chain |> flat_map(r => match commit_at_reference(commits: commits, reference: r) {
          Absent => []
          Present { value: c } => match line_integration_of(commit: c) { Absent => [] Present { value: i } => [i] }
        })
        match (line |> filter(i => repository_commit_ref_eq(left: i.at, right: supersedes))).first() {
          Absent => SupersessionRefused { cause: SupersessionNotAnIntegration { named: supersedes } }
          Present { value: named } =>
            match commit_at_reference(commits: commits, reference: named.source) {
              Absent => SupersessionRefused { cause: SupersessionNotStale { named: supersedes } }
              Present { value: named_source } =>
                if !commit_is_stale_capture(commit: named_source) {
                  SupersessionRefused { cause: SupersessionNotStale { named: supersedes } }
                } else {
                  match (line |> filter(i => match i.supersedes {
                    Absent => false
                    Present { value: x } => repository_commit_ref_eq(left: x, right: supersedes)
                  })).first() {
                    Present { value: earlier } => SupersessionRefused { cause: SupersessionAlreadySuperseded { named: supersedes, by: earlier.at } }
                    Absent =>
                      if commit_is_stale_capture(commit: source_commit) {
                        SupersessionRefused { cause: SupersessionSourceNotFresh { source: source_commit.reference } }
                      } else {
                        match line_intake(commits: commits, head: source_commit.reference) {
                          LineIntakeAt { commit: _, revision: _ } =>
                            SupersessionAdmitted(AdmittedSupersession { anchors: anchors, supersedes: supersedes })
                          LineIntakeAbsent => SupersessionRefused { cause: SupersessionSourceNotFresh { source: source_commit.reference } }
                          LineIntakeUnrecorded { commit: _ } => SupersessionRefused { cause: SupersessionSourceNotFresh { source: source_commit.reference } }
                          LineIntakeUnreadable { at: _ } => SupersessionRefused { cause: SupersessionSourceNotFresh { source: source_commit.reference } }
                        }
                      }
                  }
                }
            }
        }
      }
  }
}

// WHAT A MERGE IS ASKED TO RECORD: a plain squash over derived anchors, or a corrective squash over an
// admitted supersession -- which carries its own anchors, so the two cannot be paired apart.
type MergeIntent
  = PlainSquash { anchors: ResolvedMergeAnchors }
  | SupersedingSquash(AdmittedSupersession)

// THE SIDES ARE NAMED HERE BECAUSE THE READ THAT NEEDS THEM IS HERE.
type MergeSideName
  = MergeBaseCommit
  | MergeSourceCommit
  | MergeTargetCommit

type MergeSubjectAdmission
  = MergeSubjectAdmitted(AdmittedMergeSubject)
  | MergeSubjectSideRootMissing { side: MergeSideName, root: ObjectId }
  | MergeSubjectSideRootIsAuthoredSource { side: MergeSideName, root: ObjectId }
  | MergeSubjectSideRootIsSemanticNode { side: MergeSideName, root: ObjectId }
  | MergeSubjectConflicted { conflicts: List<ManifestPathConflict> }
  | MergeSubjectSourceUnrecoverable { cause: CorpusEntrySourceRefusal }

type MergeSideRead
  = MergeSideReadRecord { record: CorpusManifestRecord }
  | MergeSideReadRefused(MergeSubjectAdmission)

fn read_anchor_manifest(
  repository: RepositoryEnvelope,
  side: MergeSideName,
  presence: CommitPresence,
) -> MergeSideRead {
  match find_corpus_manifest_record(
    store: repository.store,
    identity: presence.commit.root.locator,
  ) {
    CorpusManifestFound(record) => MergeSideReadRecord { record: record }
    CorpusManifestAbsent { identity: r } =>
      MergeSideReadRefused(MergeSubjectSideRootMissing { side: side, root: r })
    CorpusManifestIsAuthoredSource { identity: r } =>
      MergeSideReadRefused(MergeSubjectSideRootIsAuthoredSource { side: side, root: r })
    CorpusManifestIsSemanticNode { identity: r } =>
      MergeSideReadRefused(MergeSubjectSideRootIsSemanticNode { side: side, root: r })
  }
}

// THE SUBJECT IS BUILT FROM THE ANCHORS' OWN MANIFESTS, BECAUSE TWO INDEPENDENTLY SEALED VALUES ARE
// NOT A SEALED RELATION.
//
// The previous revision took `admit_merge_subject(anchors, merged)` as PEERS. Both arguments were
// sole-constructed, and that felt sufficient -- but `MergedManifestEntries` proves only "this is SOME
// conflict-free merge result", never "this is the result FOR THESE ANCHORS". The authorable
// counterexample is exact: hold valid anchors A, obtain a conflict-free `merged` from an unrelated
// triple B, and pair them. The route below then stores B's corpus, parents it on A's target, and
// writes `SquashIntegrated { source: A.source }` -- committing the wrong corpus AND spending A's
// source, on a merge of A's manifests that never happened. Sealing each argument had made the
// arguments honest and left the RELATION between them unwitnessed. Found by external review.
//
// So there is no seam to mis-pair any more. This function reads the three manifests from
// `anchors.repository` at the anchors' own roots, runs `merge_manifests` on exactly those records, and
// constructs the subject from THAT `ManifestMerged` arm and no other value. `merged` is never an
// argument, so no caller can supply one (DESIGN 4b: construction over validation). The three read
// refusals and the conflict travel out typed for the verb to carry one-to-one.
// A MERGE COMMIT IS PUBLISHED THE SAME WAY AN ORDINARY ONE IS, SO IT PASSES THE SAME ADMISSION.
//
// `SquashMerged` means a locally publishable, checkoutable commit -- the same claim `commit_staged`
// makes -- so inheriting the codec's deliberate permission for partial manifests would let the merge
// write a snapshot whose bytes cannot be recovered, and write a `SquashIntegrated` receipt SPENDING
// the source while doing it. The merge can reach that state without either side being at fault: a
// partial base or target contributes an entry whose authored source this store never held, and the
// path-grain merge decides that path without ever resolving it.
//
// The alternative was to state partial-merge semantics explicitly as a different contract. That would
// be a second meaning for "merged", and DESIGN 3 requires a materially different contract to carry a
// materially different name. It is one contract, so it gets one admission. Ruled by external review.
//
// THE COMPLETENESS OBSERVATION HAS NO SEPARATE FUNCTION, AND THAT IS THE WHOLE SEAM. An earlier
// revision factored it out as `admit_merged_sources(anchors, merged)` -- which took back, one function
// later, exactly the peer pair that removing it from `admit_merge_subject` had just sealed. `.dag` has
// no module privacy, so that helper was a live entry point at which a caller could hold admitted
// anchors A, obtain an unrelated conflict-free merge result B, and receive
// `AdmittedMergeSubject { anchors: A, merged: B }` whenever B's sources happened to exist in A's store.
// The route downstream would then commit B's corpus as a child of A's target and write
// `SquashIntegrated { source: A.source }` -- committing the wrong corpus AND spending A's source
// without ever merging A's manifests. Found by external review, which named this as reopening the seam
// the previous round had closed.
//
// So the subject is constructed inside the `ManifestMerged` branch below, from the `e` that THIS
// call's manifests produced, and there is no function anywhere that accepts the two as arguments.
// The pairing is not validated; it is unwritable.

fn admit_merge_subject(anchors: ResolvedMergeAnchors) -> MergeSubjectAdmission {
  admit_merge_subject_for(intent: PlainSquash { anchors: anchors })
}

fn admit_merge_subject_for(intent: MergeIntent) -> MergeSubjectAdmission {
  let anchors = match intent {
    PlainSquash { anchors: a } => a
    SupersedingSquash(admitted) => admitted.anchors
  }
  let supersedes = match intent {
    PlainSquash { anchors: _ } => none
    SupersedingSquash(admitted) => Present { value: admitted.supersedes }
  }
  let repository = anchors.repository
  match read_anchor_manifest(
    repository: repository,
    side: MergeBaseCommit,
    presence: anchors.base,
  ) {
    MergeSideReadRefused(refusal) => refusal
    MergeSideReadRecord { record: base_manifest } =>
      match read_anchor_manifest(
        repository: repository,
        side: MergeSourceCommit,
        presence: anchors.source,
      ) {
        MergeSideReadRefused(refusal) => refusal
        MergeSideReadRecord { record: source_manifest } =>
          match read_anchor_manifest(
            repository: repository,
            side: MergeTargetCommit,
            presence: anchors.target,
          ) {
            MergeSideReadRefused(refusal) => refusal
            MergeSideReadRecord { record: target_manifest } =>
              match merge_manifests(
                base: base_manifest,
                source: source_manifest,
                target: target_manifest,
              ) {
                ManifestConflicted { conflicts: c } => MergeSubjectConflicted { conflicts: c }
                ManifestMerged { merged: e } =>
                  match observe_corpus_source_completeness(
                    store: repository.store,
                    entries: path_unique_entry_list(unique: e.entries),
                  ) {
                    CorpusSourceIncomplete { cause: c } =>
                      MergeSubjectSourceUnrecoverable { cause: c }
                    CorpusSourcesComplete =>
                      MergeSubjectAdmitted(
                        AdmittedMergeSubject { anchors: anchors, merged: e, supersedes: supersedes },
                      )
                  }
              }
          }
      }
  }
}

// THE STORE-AND-BASIS TRANSITION IS ONE OPERATION, AND IT IS CO-HOMED WITH THE STORE IT ADVANCES.
//
// The merge used to store its manifest and THEN ask, of the advanced repository, whether its parent
// and source were present -- re-asking a question the pre-store walks had already settled, and
// carrying two arms no caller on that route could reach. The advance is what makes those arms
// unreachable: it changes `store` and copies the commit population UNCHANGED. That fact was true and
// unstated, so the returned value had forgotten it and the caller had to re-derive it.
//
// It is stated here instead. The presences are established BEFORE the advance, they are carried
// THROUGH it, and the basis is minted from the same ones that went in -- so there is no membership
// refusal after the advance, and the caller never passes anchors beside an advanced repository. This
// lives in the envelope rather than beside the merge because the envelope owns both
// `repository_root_by_storing_unique` and the basis seal, and the merge modules import THIS one:
// homing it there would invert the dependency (DESIGN 3, acyclicity). Ruled by external review.
type MergeStoreOutcome
  = MergeStoreAdvanced(AdmittedCommitBasis)
  | MergeStoreLocatorCollision { identity: ObjectId }

// THE STORED ROOT IS NAMED, NOT SHADOWED. This branch used to bind its `RepositoryManifestRoot` to
// `subject`, which is already this function's parameter name at a DIFFERENT type -- while `parent` and
// `source` were read from the outer `subject` a few lines above. It was correct only because those two
// reads happen before the shadow begins, so reordering the lets would have silently changed which
// subject the basis described, with both spellings typechecking. Nothing in the language objects to
// shadowing; the objection is that a load-bearing distinction was resting on statement order.
fn store_and_admit_merge_basis(subject: AdmittedMergeSubject) -> MergeStoreOutcome {
  let repository = subject.anchors.repository
  let parent = subject.anchors.target
  let source = subject.anchors.source
  match repository_root_by_storing_unique(repository: repository, unique: subject.merged.entries) {
    RepositoryManifestRootUniqueLocatorCollision { identity: i } =>
      MergeStoreLocatorCollision { identity: i }
    RepositoryManifestRootUniqueStored(stored_root) =>
      MergeStoreAdvanced(
        AdmittedCommitBasis {
          subject: stored_root,
          ancestry: DescendsFrom { parent: parent.commit.reference },
          integration: match subject.supersedes {
            Absent => SquashIntegrated { source: source.commit.reference }
            Present { value: x } => SquashIntegratedSuperseding { source: source.commit.reference, supersedes: x }
          },
        }
      )
  }
}

// ONE RESOLUTION ANSWERING BOTH QUESTIONS A BASE IS ASKED.
//
// A caller selecting a base wants two facts about the same commit: that the subject's repository
// admits it as a parent, and what root it committed. They are established by ONE
// `commit_at_reference`, so asking them as two calls walks the commit list twice and -- worse -- gives
// the second call a parent-missing arm the first has already excluded. Naming the pair here keeps the
// seal inside this module and leaves the caller with no unreachable cause to invent.
type BaseAdmission
  = BaseAdmitted { basis: AdmittedCommitBasis, committed: CorpusManifestObjectRef }
  | BaseAbsentInRepository { reference: RepositoryCommitRef }

fn admit_base_in(
  subject: RepositoryManifestRoot,
  reference: RepositoryCommitRef,
) -> BaseAdmission {
  match commit_at_reference(commits: subject.repository.commits, reference: reference) {
    Absent => BaseAbsentInRepository { reference: reference }
    Present { value: commit } =>
      BaseAdmitted {
        basis: AdmittedCommitBasis {
          subject: subject,
          ancestry: DescendsFrom { parent: reference },
          integration: NoSquashIntegration,
        },
        committed: commit.root,
      }
  }
}

// THE BASIS-TAKING ADMISSION, FOR CALLERS WHOSE FACTS THIS MODULE ALREADY ESTABLISHED.
//
// `admit_commit_subject` asks two questions and can refuse on either. A caller that reached
// its subject through a route which ALREADY found the parent in that subject's repository -- the
// staging standing does exactly that, via `admit_base_in` inside `base_snapshot` -- would then carry a
// parent-missing arm it cannot reach, and would have to invent a cause or explain in a comment that
// the arm is dead. That is the `callee_arm_carried_past_its_exclusion` shape this stack has now paid for four times: honest about
// the callee's domain, dishonest about the operation's.
//
// So the parent and source questions are ABSENT from this route, having been answered where the basis
// was minted. The allocator question is NOT absent, because it is a property of the repository rather
// than of the parent, and nothing upstream has answered it.
//
// THE NAME DROPPED "Ordinary" BECAUSE THE ROUTE IS NO LONGER THE ORDINARY ONE ALONE. Squash merge
// reaches this same admission, so a name promising an ordinary-commit subject described a narrower
// population than the type actually serves -- a stale authority statement of the kind this stack keeps
// finding. Found by external review.
//
// THIS TAKES THE BASIS AND NOTHING ELSE. An earlier revision took the subject, an admitted ancestry
// and a raw integration as three arguments, which is what let a caller pair evidence from one
// repository with a subject from another. Found by external review, twice: once for the ancestry being
// unsealed, and again for the seal not naming what it was evidence about.
type AncestralSubjectAdmission
  = AncestralSubjectAdmitted(AdmittedCommitSubject)
  | AncestralSubjectAllocatorInvalid { next_ordinal: Int }

fn admit_commit_subject_from_basis(
  basis: AdmittedCommitBasis,
) -> AncestralSubjectAdmission {
  match admit_commit_allocator(repository: basis.subject.repository) {
    CommitAllocatorInvalid { next_ordinal: n } =>
      AncestralSubjectAllocatorInvalid { next_ordinal: n }
    CommitAllocatorAdmitted =>
      AncestralSubjectAdmitted(
        AdmittedCommitSubject {
          subject: basis.subject,
          ancestry: basis.ancestry,
          integration: basis.integration,
          intake: IntakeNone,
        }
      )
  }
}
fn mint_repository_commit_admitted(
  admitted: AdmittedCommitSubject,
  message: String,
) -> MintedCommit {
  let repository = admitted.subject.repository
  let root = admitted.subject.root
  let ancestry = admitted.ancestry
  let integration = admitted.integration
  let allocation = mint_id(alloc: repository.commit_allocator)
  let reference = RepositoryCommitRef { identity: allocation.id }
  MintedCommit {
    repository: RepositoryEnvelope {
      store: repository.store,
      commits: concat(repository.commits, [RepositoryCommit {
        reference: reference,
        root: root,
        message: message,
        ancestry: ancestry,
        integration: integration,
        intake: admitted.intake,
      }]),
      commit_allocator: allocation.alloc,
      checked_out: repository.checked_out,
      staged: repository.staged,
    },
    reference: reference,
  }
}

fn widen_minted_commit(minted: MintedCommit) -> BrandedRootMint {
  BrandedRootMinted { repository: minted.repository, reference: minted.reference }
}

// ------------------------------------------------------------------------------------------------
// Encoding
// ------------------------------------------------------------------------------------------------

// ABSENCE IS JsonNull, NOT THE EMPTY STRING, and the distinction is load-bearing rather than
// stylistic. The empty string is already what encoded_root_reference yields for a root that names no
// object -- the value decode refuses as unresolved. Spelling "no commit is checked out" the same way
// would fuse a legitimate repository state with a corruption signal, so an empty repository and a
// repository whose checkout reference is dangling would become one state (DESIGN section 5).
// CHECKED_OUT IS A COMMIT REFERENCE, NOT A NODE REFERENCE, and that is a construction wall rather
// than a check.
//
// An earlier revision resolved checkout against the OBJECT TABLE, which admitted an arbitrary
// interior node as a selection. Resolution now asks the keyed commit population. The key is carried
// by the commit and remains the same when rows move; the fold is only a collection lookup and derives
// no identity from traversal order.
//
// COST SHAPE: this lookup is O(n), and std.types.List's fold has no early-exit arm: after a match,
// every remaining row is still visited while the accumulator carries the answer forward. The mint
// performs one lookup for each non-root commit, so minting a chain of n commits is O(n^2). This is
// declared rather than hidden behind the keyed vocabulary: the key makes references stable but does
// not make a List a keyed index. Dissolve when the repository has one structural keyed carrier whose
// lookup can stop at the key, not by adding a parallel Map that becomes a second authority over the
// commit population.
fn commit_at_reference(commits: List<RepositoryCommit>, reference: RepositoryCommitRef) -> RepositoryCommit? {
  fold(commits, init: none, f: fn(found, c) {
    match found {
      Present { value: _ } => found
      Absent =>
        if repository_commit_ref_eq(left: c.reference, right: reference) {
          Present { value: c }
        } else {
          none
        }
    }
  })
}

fn encode_optional_reference(selected: RepositoryCommitRef?) -> JsonValue {
  match selected {
    Absent => JsonNull
    Present { value: reference } => json_int(n: minted_id_ordinal(id: reference.identity))
  }
}

// THE STAGE IS SPELLED AS A TARGET REFERENCE, NOT AN ORDINAL, and the asymmetry with
// encode_optional_reference above is the subjects' rather than a style split. A checkout selects a
// COMMIT, which is a row in this document's own commit table and is named by its minted ordinal. A
// stage selects an OBJECT, which lives in the object table and is named the way every other object
// reference in this document is named -- by encoded_root_reference, the same spelling a commit root
// uses, because it is the same kind of thing pointing into the same table.
fn encode_optional_manifest_reference(acc: EncodeAcc, staged: CorpusManifestObjectRef?) -> JsonValue {
  match staged {
    Absent => JsonNull
    Present { value: reference } => encoded_root_reference(acc: acc, root: reference.locator)
  }
}

// THE COMMIT MEMBER POPULATION IS THE WRITTEN FORMAT'S, chosen by the same policy its reader takes.
// A pre-v9 writer has no `intake` member; which intakes such a writer may be handed is the checked
// route's question (encode_repository_checked), not this row's.
fn encode_commit_record(acc: EncodeAcc, commit: RepositoryCommit, commit_policy: CommitMemberPolicy) -> JsonValue {
  let members = [
    json_kv(key: "id", value: json_int(n: minted_id_ordinal(id: commit.reference.identity))),
    json_kv(key: "root", value: encoded_root_reference(acc: acc, root: commit.root.locator)),
    json_kv(key: "message", value: json_string(s: commit.message)),
    json_kv(key: "ancestry", value: encode_ancestry(ancestry: commit.ancestry)),
    json_kv(key: "integration", value: encode_integration(integration: commit.integration, commit_policy: commit_policy)),
  ]
  match commit_policy {
    CommitIntakeDeclared =>
      json_object(members: concat(members, [json_kv(key: "intake", value: encode_commit_intake(intake: commit.intake))]))
    CommitIntegrationDeclared => json_object(members: members)
    CommitIntegrationAbsentByFormat => json_object(members: members)
  }
}

// JsonNull FOR NoSquashIntegration AND AN ORDINAL FOR A CONSUMED SOURCE, which are disjoint shapes,
// so a damaged document cannot silently become an unintegrated commit. It is deliberately the SAME
// spelling `encode_ancestry` uses for the same kind of thing -- an optional commit reference into
// this document's own commit table -- because a second spelling for one wire concept is a nickname.
// v9 ADDS ONE SHAPE: a corrective integration is an object naming its source and the stale
// integration it supersedes. A pre-v9 writer has no spelling for it and writes the source alone; the
// checked whole route refuses such a repository rather than drop the supersession silently.
fn encode_integration(integration: CommitIntegration, commit_policy: CommitMemberPolicy) -> JsonValue {
  match integration {
    NoSquashIntegration => JsonNull
    SquashIntegrated { source: s } => json_int(n: minted_id_ordinal(id: s.identity))
    SquashIntegratedSuperseding { source: s, supersedes: x } =>
      match commit_policy {
        CommitIntakeDeclared =>
          json_object(members: [
            json_kv(key: "source", value: json_int(n: minted_id_ordinal(id: s.identity))),
            json_kv(key: "supersedes", value: json_int(n: minted_id_ordinal(id: x.identity))),
          ])
        CommitIntegrationDeclared => json_int(n: minted_id_ordinal(id: s.identity))
        CommitIntegrationAbsentByFormat => json_int(n: minted_id_ordinal(id: s.identity))
      }
  }
}

// A root commit is JsonNull; a parent is the minted commit ordinal encoded as a JSON integer. These
// are disjoint shapes, so damage cannot silently become a new root. Unlike the former row position,
// the ordinal names the same record after list insertion, deletion or reorder. The persisted
// allocator watermark prevents a deleted high key from being reused on the next mint.
//
// THE ENCODER NO LONGER SEARCHES FOR THE PARENT, and that deletion is the whole repair.
//
// It previously took the parent's ObjectId and walked the commit list for a row carrying that root,
// taking the FIRST match. Because two rows may legitimately share a root, that search could not
// answer the question it was asked: it returned the first OCCURRENCE of the parent's program, which
// on any revert is a different record than the parent. The commits argument is gone with it -- a
// reference needs no population to resolve against at encode time, so the parameter that made the
// search possible does not exist to be misused.
//
// THAT LAST CLAUSE WAS FALSE WHEN FIRST WRITTEN, AND THE REPAIR IS WHY IT NOW HOLDS. This branch
// removed the search from `encode_ancestry` and left `commits` threaded through the enclosing
// `encode_commit_record`, unread. main carries no such parameter, so the branch ADDED it back while
// this annotation declared it gone -- prose saying a mechanism is removed over code where the
// mechanism-shaped parameter remains, which is the class this lane repaired in gunbc#9282 and
// promptly re-authored one file away. It is deleted here rather than documented, because an unused
// population parameter at the exact site that used to search that population is not inert: it is the
// cheapest possible route back to the first-match defect, needing no new argument at any call site.
// Reported by external review; the added-not-left provenance is measured against main.
fn encode_ancestry(ancestry: CommitAncestry) -> JsonValue {
  match ancestry {
    RootCommit => JsonNull
    DescendsFrom { parent: parent } => json_int(n: minted_id_ordinal(id: parent.identity))
  }
}

fn encode_commit_records(acc: EncodeAcc, commits: List<RepositoryCommit>, commit_policy: CommitMemberPolicy) -> List<JsonValue> {
  map(commits, c => encode_commit_record(acc: acc, commit: c, commit_policy: commit_policy))
}

// THE CODEC IS NAMED FOR THE EXACT WIRE VERSION IT UNDERSTANDS, and `encode_repository` is the
// separate question of which version we currently EMIT. They are one function today and that is
// precisely why the names must differ now rather than later: once a document exists in the world,
// the v1 body must stay frozen, and the seam that lets a v2 arrive beside it has to be somewhere no
// author is tempted to "just add the field here".
//
// THIS FABRICATES NO FUTURE VERSION. There is no arm and no version enum member for a format that
// does not exist, and no migration claim -- building a synthetic next version now would test an
// invented migration rather than the one the product eventually needs.
//
// THE VERSIONED WRITER IS NAMED FOR THE VERSION IT WRITES, and it took this sweep twice to make that
// true. The paragraph said "this fabricates no v3" while the writer beneath it was already emitting
// the v3 tag through a function still called encode_repository_v2 -- the same stale-authority shape
// the sentence itself was complaining about, one version later. A writer whose name says v2 and
// whose bytes say v3 is a meaning fork in the only place a reader looks.
fn encode_repository(repo: RepositoryEnvelope) -> JsonValue {
  encode_repository_v6(repo: repo)
}

fn encode_repository_v6(repo: RepositoryEnvelope) -> JsonValue {
  encode_repository_v6_over_table(repo: repo, acc: encode_object_table(store: repo.store))
}

// THE ADMITTED ENVELOPE IS ASSEMBLED OVER THE TABLE ITS ADMISSION WAS DECIDED ON. The checked writer
// builds the object table to resolve commit roots against it, and then reached encode_repository,
// whose first act was to build the same table again from the same store -- two full walks of every
// object to produce, by construction, the identical accumulator. Taking the table as a parameter is
// what lets one derivation serve both the decision and the document; encode_repository_v6 keeps its
// store-only shape for the unchecked callers, which have no accumulator to hand it.
fn encode_repository_v6_over_table(repo: RepositoryEnvelope, acc: EncodeAcc) -> JsonValue {
  json_object(
    members: [
      json_kv(key: "format", value: json_string(s: repository_envelope_format_tag)),
      json_kv(key: "identity_rule", value: json_string(s: repository_object_identity_rule_tag)),
      json_kv(key: "objects", value: json_array(elements: acc.objects)),
      json_kv(
        key: "next_commit_ordinal",
        value: json_int(n: repo.commit_allocator.next_ordinal),
      ),
      json_kv(
        key: "commits",
        value: json_array(elements: encode_commit_records(acc: acc, commits: repo.commits, commit_policy: CommitIntegrationDeclared))
      ),
      json_kv(key: "checked_out", value: encode_optional_reference(selected: repo.checked_out)),
      json_kv(
        key: "staged",
        value: encode_optional_manifest_reference(acc: acc, staged: repo.staged),
      ),
    ]
  )
}

// THE v7 DOCUMENT IS THE INDEX: every member v6 carries except the object payloads, which become
// `object_shards` -- the roster of content-derived identities over the store's OWN order. The
// partition basis is the stored order, not the dependency order the monolith's table used:
// dependency order is a re-sort, and a re-sort is not stable across a load/save cycle (measured
// 2026-09-23 on the 7,051-object rehearsal: re-sorting the loaded store moved its tail, so the
// next save computed fourteen different shard identities for a two-object change). The stored
// order loads back exactly as written and only ever grows by append, so a sealed shard's name
// never moves. Commit roots and the staged reference spell the UNCONTAINED digest arm, because
// this document carries no object to point at; the commit closure format's own vocabulary,
// reused rather than paralleled.
fn encode_repository_v7(repo: RepositoryEnvelope) -> JsonValue {
  let empty_positions = EncodeAcc {
    positions: EncodePositions {
      nodes_by_identity: empty_map(),
      sources_by_identity: empty_map(),
      manifests_by_identity: empty_map(),
      next: 0,
    },
    objects: [],
  }
  json_object(
    members: [
      json_kv(key: "format", value: json_string(s: repository_envelope_format_tag_v7)),
      json_kv(key: "identity_rule", value: json_string(s: repository_object_identity_rule_tag)),
      json_kv(
        key: "object_shards",
        value: json_array(
          elements: map(
            shard_roster_of(objects: repo.store.objects),
            d => json_string(s: d),
          )
        ),
      ),
      json_kv(
        key: "next_commit_ordinal",
        value: json_int(n: repo.commit_allocator.next_ordinal),
      ),
      json_kv(
        key: "commits",
        value: json_array(elements: encode_commit_records(acc: empty_positions, commits: repo.commits, commit_policy: CommitIntegrationDeclared))
      ),
      json_kv(key: "checked_out", value: encode_optional_reference(selected: repo.checked_out)),
      json_kv(
        key: "staged",
        value: encode_optional_manifest_reference(acc: empty_positions, staged: repo.staged),
      ),
    ]
  )
}

// THE SHARDED WRITER'S ADMISSION IS THE MONOLITH'S, UNCHANGED: the same checked encoder adjudicates
// (its document is built and discarded -- the admission is the census, not the bytes), and only
// then does the v7 index encode. A store that cannot be written whole cannot be written sharded.
// The sharded writer now writes v9: v8's index plus each commit's typed intake. Its admission is the
// whole CENSUS (encode_repository_census_checked), not the whole SAVE route: the whole format cannot
// carry a recorded intake and refuses one, which is a fact about that format's bytes, not about
// whether this repository's store is sound.
fn encode_repository_sharded_checked(repo: RepositoryEnvelope) -> RepositoryEncodeOutcome {
  match encode_repository_census_checked(repo: repo) {
    RepositoryEncodeRefused { cause } => RepositoryEncodeRefused { cause: cause }
    RepositoryEncoded { value: _ } => RepositoryEncoded { value: encode_repository_v9(repo: repo) }
  }
}

fn scm_object_kind_tag(kind: ScmObjectKind) -> String {
  match kind {
    SemanticNodeKind => "node"
    AuthoredSourceKind => "source"
    CorpusManifestKind => "manifest"
  }
}

fn scm_object_kind_of_tag(tag: String) -> ScmObjectKind? {
  if tag == "node" {
    Present { value: SemanticNodeKind }
  } else if tag == "source" {
    Present { value: AuthoredSourceKind }
  } else if tag == "manifest" {
    Present { value: CorpusManifestKind }
  } else {
    none
  }
}

fn encode_rostered_row(row: RosteredObject) -> JsonValue {
  json_array(elements: [
    json_string(s: row.identity.digest as String),
    json_string(s: scm_object_kind_tag(kind: row.kind)),
    json_string(s: row.shard),
  ])
}

// v8 AND v9 SHARE THIS INDEX LAYOUT AND DIFFER ONLY INSIDE A COMMIT RECORD, so one body carries both,
// selected by the tag and the commit policy that travel together below. v8 stays a writer only so
// its frozen fixtures and the conversion witnesses can still produce one; production writes v9.
fn encode_repository_rostered_over(repo: RepositoryEnvelope, shards: List<String>, rows: List<RosteredObject>, tag: String, commit_policy: CommitMemberPolicy) -> JsonValue {
  let empty_positions = EncodeAcc {
    positions: EncodePositions {
      nodes_by_identity: empty_map(),
      sources_by_identity: empty_map(),
      manifests_by_identity: empty_map(),
      next: 0,
    },
    objects: [],
  }
  json_object(
    members: [
      json_kv(key: "format", value: json_string(s: tag)),
      json_kv(key: "identity_rule", value: json_string(s: repository_object_identity_rule_tag)),
      json_kv(key: "object_shards", value: json_array(elements: map(shards, d => json_string(s: d)))),
      json_kv(key: "objects", value: json_array(elements: map(rows, r => encode_rostered_row(row: r)))),
      json_kv(key: "next_commit_ordinal", value: json_int(n: repo.commit_allocator.next_ordinal)),
      json_kv(
        key: "commits",
        value: json_array(elements: encode_commit_records(acc: empty_positions, commits: repo.commits, commit_policy: commit_policy))
      ),
      json_kv(key: "checked_out", value: encode_optional_reference(selected: repo.checked_out)),
      json_kv(
        key: "staged",
        value: encode_optional_manifest_reference(acc: empty_positions, staged: repo.staged),
      ),
    ]
  )
}

fn encode_repository_v8(repo: RepositoryEnvelope) -> JsonValue {
  encode_repository_rostered(repo: repo, tag: repository_envelope_format_tag_v8, commit_policy: CommitIntegrationDeclared)
}

fn encode_repository_v9(repo: RepositoryEnvelope) -> JsonValue {
  encode_repository_rostered(repo: repo, tag: repository_envelope_format_tag_v9, commit_policy: CommitIntakeDeclared)
}

fn encode_repository_v9_over(repo: RepositoryEnvelope, shards: List<String>, rows: List<RosteredObject>) -> JsonValue {
  encode_repository_rostered_over(repo: repo, shards: shards, rows: rows, tag: repository_envelope_format_tag_v9, commit_policy: CommitIntakeDeclared)
}

fn encode_repository_rostered(repo: RepositoryEnvelope, tag: String, commit_policy: CommitMemberPolicy) -> JsonValue {
  let partition = shard_partition(objects: repo.store.objects)
  encode_repository_rostered_over(
    repo: repo,
    shards: map(partition, shard => shard_identity_of(member_digests: shard_members_of(objects: shard))),
    rows: sort_by(partition_rostered_rows(partition: partition), fn(r) { r.identity.digest as String }),
    tag: tag,
    commit_policy: commit_policy,
  )
}

// THE APPEND-ONLY ADMISSION: what the whole-store census asks, asked of exactly what this save adds.
// A partial store's rostered objects were admitted when they were written, and re-deciding them
// would re-read the repository this format exists not to read. So the census runs over the
// UNROSTERED resident objects (store_unrostered_objects) and over the envelope's own identity-grain
// members, which the roster answers at map cost: every new manifest's entry sources must not be a
// node or a manifest (absence is admitted exactly as the whole census admits it), every commit root
// and the staged reference must be a persisted or resident manifest, the checkout must name a commit,
// and the commit order must admit. A semantic node is refused outright: no append producer creates
// one, and its containment census needs the closure this save does not hold.
type AppendedShardsAndRows {
  shards: List<String>
  rows: List<RosteredObject>
}

fn appended_shards_and_rows(store: ObjectStore) -> AppendedShardsAndRows {
  let partition = shard_partition(objects: store_unrostered_objects(store: store))
  let held = fold(store_rostered_shards(store: store), init: empty_map(), f: fn(m, d) { map_insert(m, d, true) })
  let fresh = filter(
    map(partition, shard => shard_identity_of(member_digests: shard_members_of(objects: shard))),
    d => match map_lookup(m: held, key: d) { Present { value: _ } => false Absent => true },
  )
  AppendedShardsAndRows {
    shards: concat(store_rostered_shards(store: store), fresh),
    rows: sort_by(
      concat(store_rostered_rows(store: store), partition_rostered_rows(partition: partition)),
      fn(r) { r.identity.digest as String },
    ),
  }
}

fn appended_entry_kind(index: Map<String, ScmObject>, store: ObjectStore, source: ObjectId) -> ScmObjectKind? {
  match find_object_via(index: index, identity: source) {
    Present { value: object } => Present { value: scm_object_kind(object: object) }
    Absent =>
      match store_rostered_lookup(store: store, identity: source) {
        Present { value: held } => Present { value: held.kind }
        Absent => none
      }
  }
}

fn appended_manifest_refusal(
  index: Map<String, ScmObject>,
  store: ObjectStore,
  entries: List<CorpusManifestEntry>,
) -> RepositoryEncodeRefusal? {
  fold(entries, init: none, f: fn(found, entry) {
    match found {
      Present { value: _ } => found
      Absent => {
        let source = authored_source_target_locator(target: entry.source)
        match appended_entry_kind(index: index, store: store, source: source) {
          Absent => none
          Present { value: kind } =>
            match kind {
              AuthoredSourceKind => none
              SemanticNodeKind => Present { value: RepositoryEncodeManifestSourceIsSemanticNode { source: source } }
              CorpusManifestKind => Present { value: RepositoryEncodeManifestSourceIsCorpusManifest { source: source } }
            }
        }
      }
    }
  })
}

fn appended_object_refusal(store: ObjectStore) -> RepositoryEncodeRefusal? {
  match (store_shadowing_objects(store: store)).first() {
    Present { value: shadow } =>
      Present { value: RepositoryEncodeAppendShadowsRosteredIdentity { identity: scm_object_identity(object: shadow) } }
    Absent => appended_new_object_refusal(store: store)
  }
}

fn appended_new_object_refusal(store: ObjectStore) -> RepositoryEncodeRefusal? {
  let index = store_object_index(store: store)
  fold(store_unrostered_objects(store: store), init: none, f: fn(found, object) {
    match found {
      Present { value: _ } => found
      Absent =>
        match object {
          SemanticNodeObject(record) => Present { value: RepositoryEncodeAppendCarriesSemanticNode { target: record.identity.locator } }
          AuthoredSourceObject(_) => none
          CorpusManifestObject(record) => appended_manifest_refusal(index: index, store: store, entries: record.entries)
        }
    }
  })
}

fn manifest_ref_standing(store: ObjectStore, root: ObjectId) -> ManifestLocatorStanding {
  match find_corpus_manifest_ref(store: store, identity: root) {
    CorpusManifestRefFound(_) => ManifestLocatorResolved
    CorpusManifestRefAbsent { identity: r } => ManifestLocatorAbsent { root: r }
    CorpusManifestRefIsAuthoredSource { identity: r } => ManifestLocatorIsAuthoredSource { root: r }
    CorpusManifestRefIsSemanticNode { identity: r } => ManifestLocatorIsSemanticNode { root: r }
  }
}

fn appended_commit_root_standing(store: ObjectStore, commits: List<RepositoryCommit>) -> ManifestLocatorStanding {
  fold(commits, init: ManifestLocatorResolved, f: fn(found, c) {
    match found {
      ManifestLocatorResolved => manifest_ref_standing(store: store, root: c.root.locator)
      ManifestLocatorAbsent { root: _ } => found
      ManifestLocatorIsAuthoredSource { root: _ } => found
      ManifestLocatorIsSemanticNode { root: _ } => found
    }
  })
}

fn appended_staged_standing(store: ObjectStore, staged: CorpusManifestObjectRef?) -> ManifestLocatorStanding {
  match staged {
    Absent => ManifestLocatorResolved
    Present { value: reference } => manifest_ref_standing(store: store, root: reference.locator)
  }
}

fn encode_repository_appended_checked(repo: RepositoryEnvelope) -> RepositoryEncodeOutcome {
  match appended_object_refusal(store: repo.store) {
    Present { value: cause } => RepositoryEncodeRefused { cause: cause }
    Absent =>
      match appended_commit_root_standing(store: repo.store, commits: repo.commits) {
        ManifestLocatorAbsent { root } => RepositoryEncodeRefused { cause: RepositoryCommitRootNotInStore { root: root } }
        ManifestLocatorIsAuthoredSource { root } => RepositoryEncodeRefused { cause: RepositoryEncodeCommitRootIsAuthoredSource { root: root } }
        ManifestLocatorIsSemanticNode { root } => RepositoryEncodeRefused { cause: RepositoryEncodeCommitRootIsSemanticNode { root: root } }
        ManifestLocatorResolved =>
          match appended_staged_standing(store: repo.store, staged: repo.staged) {
            ManifestLocatorAbsent { root } => RepositoryEncodeRefused { cause: RepositoryEncodeStagedNotInStore { staged: root } }
            ManifestLocatorIsAuthoredSource { root } => RepositoryEncodeRefused { cause: RepositoryEncodeStagedIsAuthoredSource { staged: root } }
            ManifestLocatorIsSemanticNode { root } => RepositoryEncodeRefused { cause: RepositoryEncodeStagedIsSemanticNode { staged: root } }
            ManifestLocatorResolved =>
              match unresolved_checkout_selection(commits: repo.commits, selected: repo.checked_out) {
                Present { value: reference } =>
                  RepositoryEncodeRefused { cause: RepositoryCheckoutNotInCommits { selected: reference } }
                Absent =>
                  match admit_commit_order(commits: repo.commits, next_ordinal: repo.commit_allocator.next_ordinal).refusal {
                    Present { value: CommitReferenceDuplicated { reference } } =>
                      RepositoryEncodeRefused { cause: RepositoryCommitReferenceDuplicated { reference: reference } }
                    Present { value: CommitParentNotPreviouslyAdmitted { parent } } =>
                      RepositoryEncodeRefused { cause: RepositoryCommitParentNotInCommits { parent: parent } }
                    Present { value: CommitIntegrationSourceNotPreviouslyAdmitted { source } } =>
                      RepositoryEncodeRefused { cause: RepositoryEncodeIntegrationSourceNotPreviouslyAdmitted { source: source } }
                    Present { value: CommitReferenceOutsideAllocator { reference, next_ordinal: _ } } =>
                      RepositoryEncodeRefused {
                        cause: RepositoryCommitReferenceOutsideAllocator { reference: reference, next_ordinal: repo.commit_allocator.next_ordinal },
                      }
                    Absent => {
                      let appended = appended_shards_and_rows(store: repo.store)
                      RepositoryEncoded { value: encode_repository_v9_over(repo: repo, shards: appended.shards, rows: appended.rows) }
                    }
                  }
              }
          }
      }
  }
}

type RepositoryEncodeOutcome
  = RepositoryEncoded { value: JsonValue }
  | RepositoryEncodeRefused { cause: RepositoryEncodeRefusal }

// THE CHECKED ENCODER IS WHAT A PERSISTENCE BOUNDARY MUST CALL, and it exists because
// encode_repository CANNOT refuse -- it returns a JsonValue, so its only honest treatment of an
// unrepresentable input is the empty reference that decode later rejects. That is correct as far as
// it goes and it arrives too late for a writer: bytes are already on disk, the operation has already
// reported success, and the corruption surfaces on the next load, to whoever loads it rather than to
// whoever caused it. So the adjudication is lifted ahead of the write.
//
// The ways a repository can be unrepresentable are the arms of RepositoryEncodeRefusal, and they are
// separate causes rather than one because their remedies differ. This line carried a transcribed
// COUNT twice -- "the three ways", then "the eight arms" -- and was stale both times within a version
// of landing, because a coproduct already states its own cardinality and a copy of it rots the moment
// an arm lands. Grouped by remedy: an unresolvable EDGE means the
// object table is an incomplete closure; a target or commit root that resolves to AUTHORED SOURCE
// means something asked a file to stand where a semantic node belongs; an ABSENT commit root means a
// commit names an object the store does not hold; an unresolvable CHECKOUT means the selection names
// a non-commit; and duplication, allocator range and parent order are three ways the commit table
// itself is inconsistent.
// THE REPOSITORY STILL REFUSES A PARTIAL OBJECT TABLE, and that is a DELIBERATE non-change in a diff
// that made partial closures representable everywhere else. A commit closure may now legitimately be
// shipped incomplete, under a declared admission, because a delta is a real thing to send. A whole
// REPOSITORY written with dangling edges is not that -- nobody asked for it, no consumer wants it,
// and admitting it here would widen the change beyond what was decided. When a repository-grain
// partial write is actually wanted, it takes an admission exactly as the closure encoder does; until
// then this refusal stands rather than being loosened by proximity.
// AN uncontained target, not THE FIRST one, and the name says only what the evidence establishes.
//
// This returns whichever member the fold reaches first, but the refusal needs one ACTIONABLE EXAMPLE
// and nothing downstream depends on which. Naming it `first_` promised a stable ordering the witness
// does not check -- and could not cheaply check, since with a single uncontained object every member
// is also the first. Pinning order here would additionally freeze an incidental traversal order into
// the interface, which a later keyed or canonical representation of table_unresolved_identities should not
// be forced to preserve.
// THE WRONG-KIND POPULATION IS A SEPARATE REFUSAL, NOT A SILENT PASS. an_uncontained_target reads the
// ABSENT population only, which is correct for what it names -- and it was the ONLY guard here, so a
// requirement whose locator is occupied by an authored source walked straight through and got
// published. The census separates the two populations precisely so both get read; wiring only the
// absent half re-created the conflation one layer up.
fn a_source_occupied_target(census: ClosureCensus) -> ObjectId? {
  fold(census.source_occupied, init: none, f: fn(acc, id) {
    match acc {
      Present { value: _ } => acc
      Absent => Present { value: id }
    }
  })
}

// THE MANIFEST-OCCUPIED POPULATION IS ITS OWN GUARD, AND IT WAS THE ONE THAT WENT UNREAD. The census
// has separated three populations since the third object kind landed; this writer read two of them,
// so a semantic edge whose locator holds a MANIFEST passed the checked writer and was published as
// `uncontained` -- a fetchable absence for a locator that is occupied and can never be repaired by
// fetching. Reading two of three populations is the same defect as reading one of two, which the
// paragraph above this records catching a version ago.
fn a_manifest_occupied_target(census: ClosureCensus) -> ObjectId? {
  fold(census.manifest_occupied, init: none, f: fn(acc, id) {
    match acc {
      Present { value: _ } => acc
      Absent => Present { value: id }
    }
  })
}

// A MANIFEST'S SOURCE REQUIREMENT IS ADJUDICATED HERE TOO, AND IT WAS THE LAST WRONG-KIND STATE
// THIS WRITER COULD PUBLISH. encode_source_target asks the source-only index, so a locator occupied
// by a node or another manifest is simply missing from it and the writer spelled the target
// `uncontained` -- a fetchable absence for an occupied locator. The index made the contained
// spelling of a wrong kind unwritable; these two refusals are what stop the uncontained spelling
// from becoming its replacement.
//
// GENUINE ABSENCE IS NOT REFUSED, because a manifest naming a source this repository does not carry
// is a legitimate partial corpus -- the same standing an absent semantic child has. What the census
// prevents is a wrong kind arriving in that absent population.
fn a_manifest_source_at_a_node(census: ManifestSourceCensus) -> ObjectId? {
  fold(census.node_occupied, init: none, f: fn(acc, id) {
    match acc {
      Present { value: _ } => acc
      Absent => Present { value: id }
    }
  })
}

fn a_manifest_source_at_a_manifest(census: ManifestSourceCensus) -> ObjectId? {
  fold(census.manifest_occupied, init: none, f: fn(acc, id) {
    match acc {
      Present { value: _ } => acc
      Absent => Present { value: id }
    }
  })
}

fn an_uncontained_target(census: ClosureCensus) -> ObjectId? {
  fold(census.absent, init: none, f: fn(acc, id) {
    match acc {
      Present { value: _ } => acc
      Absent => Present { value: id }
    }
  })
}

// ONE CENSUS PER SUBJECT, DERIVED ONCE. Each of the five guards below used to call its own
// `table_*` accessor, and each of those re-derives a whole census to project one of its fields --
// so a healthy encode walked the store five times to read five fields of two results. The two
// subjects stay SEPARATE: semantic child requirements and authored-source requirements are
// different propositions about different kinds, and merging them would be the kind-blind
// observation this branch has spent its length removing. What is shared is the derivation, not the
// question.
// A PARTIAL STORE IS ITS OWN DECLARED ARM, and this whole-store encoder answers it by refusal: the
// envelope type is shared by every SCM verb, so the encoder can be handed one, and writing it whole
// would roster away every object it does not hold. The append-only writer
// (encode_repository_appended_checked) is the only route that writes a partial store.
// THE WHOLE SAVE ROUTE WRITES v6, WHICH HAS NO `intake` MEMBER. A commit whose intake is a base, an
// advance or a stale capture would be written without the one fact that makes it one, and read back unrecorded, so it
// refuses here by name. IntakeNone is written as the format's silence and reads back
// IntakeUnrecordedByFormat: a weaker claim than the writer held, never a different one.
fn encode_repository_checked(repo: RepositoryEnvelope) -> RepositoryEncodeOutcome {
  match (repo.commits |> filter(c => match c.intake {
    IntakeBase { revision: _ } => true
    IntakeAdvance { from: _, to: _ } => true
    IntakeNone => false
    IntakeUnrecordedByFormat => false
    IntakeStaleCapture { captured_against: _ } => true
  } || match c.integration {
    SquashIntegratedSuperseding { source: _, supersedes: _ } => true
    SquashIntegrated { source: _ } => false
    NoSquashIntegration => false
  })).first() {
    Present { value: c } => RepositoryEncodeRefused { cause: RepositoryEncodeIntakeNotInWholeFormat { commit: c.reference } }
    Absent => encode_repository_census_checked(repo: repo)
  }
}

fn encode_repository_census_checked(repo: RepositoryEnvelope) -> RepositoryEncodeOutcome {
  match repo.store.residence {
    WholeResidence => encode_repository_checked_whole(repo: repo)
    PartialResidence { rostered: _, shards, materialized: _ } =>
      RepositoryEncodeRefused { cause: RepositoryEncodeStoreIsPartial { rostered_shards: count(shards) } }
  }
}

fn encode_repository_checked_whole(repo: RepositoryEnvelope) -> RepositoryEncodeOutcome {
  let acc = encode_object_table(store: repo.store)
  let semantic = store_census(store: repo.store)
  let sources = manifest_source_census(store: repo.store)
  match a_source_occupied_target(census: semantic) {
    Present { value: target } =>
      RepositoryEncodeRefused { cause: RepositoryEncodeTargetIsAuthoredSource { target: target } }
    Absent =>
  match a_manifest_occupied_target(census: semantic) {
    Present { value: target } =>
      RepositoryEncodeRefused { cause: RepositoryEncodeTargetIsCorpusManifest { target: target } }
    Absent =>
  match a_manifest_source_at_a_node(census: sources) {
    Present { value: source } =>
      RepositoryEncodeRefused { cause: RepositoryEncodeManifestSourceIsSemanticNode { source: source } }
    Absent =>
  match a_manifest_source_at_a_manifest(census: sources) {
    Present { value: source } =>
      RepositoryEncodeRefused { cause: RepositoryEncodeManifestSourceIsCorpusManifest { source: source } }
    Absent =>
  match an_uncontained_target(census: semantic) {
    Present { value: target } =>
      RepositoryEncodeRefused { cause: RepositoryEncodeUncontainedTarget { target: target } }
    Absent =>
      match unresolved_commit_root(acc: acc, commits: repo.commits) {
        ManifestLocatorAbsent { root: root } =>
          RepositoryEncodeRefused { cause: RepositoryCommitRootNotInStore { root: root } }
        ManifestLocatorIsAuthoredSource { root: root } =>
          RepositoryEncodeRefused { cause: RepositoryEncodeCommitRootIsAuthoredSource { root: root } }
        ManifestLocatorIsSemanticNode { root: root } =>
          RepositoryEncodeRefused { cause: RepositoryEncodeCommitRootIsSemanticNode { root: root } }
        ManifestLocatorResolved =>
          match staged_locator_standing(acc: acc, staged: repo.staged) {
            ManifestLocatorAbsent { root: staged } =>
              RepositoryEncodeRefused { cause: RepositoryEncodeStagedNotInStore { staged: staged } }
            ManifestLocatorIsAuthoredSource { root: staged } =>
              RepositoryEncodeRefused { cause: RepositoryEncodeStagedIsAuthoredSource { staged: staged } }
            ManifestLocatorIsSemanticNode { root: staged } =>
              RepositoryEncodeRefused { cause: RepositoryEncodeStagedIsSemanticNode { staged: staged } }
            ManifestLocatorResolved =>
          match unresolved_checkout_selection(commits: repo.commits, selected: repo.checked_out) {
            Present { value: reference } =>
              RepositoryEncodeRefused { cause: RepositoryCheckoutNotInCommits { selected: reference } }
            Absent =>
              match admit_commit_order(
                commits: repo.commits,
                next_ordinal: repo.commit_allocator.next_ordinal,
              ).refusal {
                Present { value: CommitReferenceDuplicated { reference: reference } } =>
                  RepositoryEncodeRefused { cause: RepositoryCommitReferenceDuplicated { reference: reference } }
                Present { value: CommitParentNotPreviouslyAdmitted { parent: parent } } =>
                  RepositoryEncodeRefused { cause: RepositoryCommitParentNotInCommits { parent: parent } }
                Present { value: CommitIntegrationSourceNotPreviouslyAdmitted { source: source } } =>
                  RepositoryEncodeRefused { cause: RepositoryEncodeIntegrationSourceNotPreviouslyAdmitted { source: source } }
                Present { value: CommitReferenceOutsideAllocator { reference: reference, next_ordinal: _ } } =>
                  RepositoryEncodeRefused {
                    cause: RepositoryCommitReferenceOutsideAllocator {
                      reference: reference,
                      next_ordinal: repo.commit_allocator.next_ordinal,
                    }
                  }
                Absent => RepositoryEncoded { value: encode_repository_v6_over_table(repo: repo, acc: acc) }
              }
          }
          }
      }
  }
  }
  }
  }
  }
}

// These answer with the ObjectId the CALLER supplied, not with a wire string derived from it. The
// caller holds that identity and can act on it; a hex key it would have to parse back is the same
// fact rendered into a shape that has lost its type.
fn unresolved_commit_root(acc: EncodeAcc, commits: List<RepositoryCommit>) -> ManifestLocatorStanding {
  fold(
    commits,
    init: ManifestLocatorResolved,
    f: fn(found, c) { unresolved_commit_root_step(acc: acc, found: found, commit: c) }
  )
}

// ASK THE TABLE, NOT THE ENCODING. This read the ENCODED root and compared it to "" -- the old
// sentinel for "unresolvable" -- which worked only while an unresolvable root encoded to an empty
// string. With the two-arm reference there is no sentinel: an uncontained root is a legitimate arm,
// so the comparison went permanently false and this refusal SILENTLY STOPPED FIRING. It typechecked,
// because the comparison was against a JsonValue by then.
//
// The repair is to stop routing a containment question through a representation at all. The question
// is "does the table hold this object", and position_of answers it directly.
// A COMMIT ROOT MISSES THE NODE INDEX FOR TWO DIFFERENT REASONS, AND THEY ARE NOT THE SAME FACT.
//
// Asking node_position_of is the right FIRST question -- a root must resolve to a program, and the
// generic object index answered yes for a file. But treating every node-index miss as
// RepositoryCommitRootNotInStore reports ABSENCE for an object that is present and wrong-kind, which
// is the same conflation this branch closed at the closure grain, arriving one layer later.
//
// The state is inside the declared model rather than hypothetical: a SemanticNodeObjectRef proves node
// kind in SOME store, not in every future one, and a repository may retain a commit while its store is
// replaced. The table's source-occupied scan does not cover it either, because a commit root need not
// be referenced by any ordinary edge.
// THE MISS IS THREE-WAY, NOT TWO-WAY, and this type carried only two arms while a third kind existed.
// After the node index missed, the old classifier asked a KIND-BLIND index and reported every hit as
// an authored source -- so a commit whose root is a corpus manifest was published to an operator as
// "your root is a source file". That is the partial observer this whole branch is about: a
// well-formed answer of the right type about the wrong subject.
// THE RESOLVED KIND IS NOW THE MANIFEST, AND THE WRONG-KIND ARMS SWAPPED PLACES RATHER THAN THINNING.
// Three kinds occupy one locator space, so a root that fails to resolve as a manifest is still one of
// three distinct facts, and the population that used to be named `CommitRootIsCorpusManifest` is now
// `ManifestLocatorIsSemanticNode`. Collapsing either wrong-kind arm into `ManifestLocatorAbsent` would report an
// occupied locator as empty -- the same well-formed-answer-about-the-wrong-subject this type's own
// note above was written to stop.
type ManifestLocatorStanding
  = ManifestLocatorResolved
  | ManifestLocatorAbsent { root: ObjectId }
  | ManifestLocatorIsAuthoredSource { root: ObjectId }
  | ManifestLocatorIsSemanticNode { root: ObjectId }

fn manifest_locator_standing(acc: EncodeAcc, root: ObjectId) -> ManifestLocatorStanding {
  match manifest_position_of(positions: acc.positions, identity: root) {
    Present { value: _ } => ManifestLocatorResolved
    Absent =>
      match source_position_of(positions: acc.positions, identity: root) {
        Present { value: _ } => ManifestLocatorIsAuthoredSource { root: root }
        Absent =>
          match node_position_of(positions: acc.positions, identity: root) {
            Present { value: _ } => ManifestLocatorIsSemanticNode { root: root }
            Absent => ManifestLocatorAbsent { root: root }
          }
      }
  }
}

// NO STAGE IS RESOLVED, NOT ABSENT, AND THE COLLAPSE IS DELIBERATE HERE WHERE IT IS FORBIDDEN
// ELSEWHERE. ManifestLocatorAbsent means "a locator was designated and this table does not hold it",
// which is a fault; a repository with nothing staged designates no locator at all, so there is
// nothing for the table to fail to hold and nothing to refuse. Answering ManifestLocatorResolved for
// it says exactly that -- this envelope's stage raises no objection to being written -- rather than
// pretending an absent stage was found.
//
// The alternative shape, returning ManifestLocatorStanding?, forces every caller to handle a fourth
// case whose only content is "the question did not arise", and the caller cannot construct a refusal
// for it without inventing a digest to name. That was the first shape written here and it required
// exactly that fabrication, which is how the collapse was found to be the honest one.
fn staged_locator_standing(acc: EncodeAcc, staged: CorpusManifestObjectRef?) -> ManifestLocatorStanding {
  match staged {
    Absent => ManifestLocatorResolved
    Present { value: reference } => manifest_locator_standing(acc: acc, root: reference.locator)
  }
}

fn unresolved_commit_root_step(
  acc: EncodeAcc,
  found: ManifestLocatorStanding,
  commit: RepositoryCommit
) -> ManifestLocatorStanding {
  match found {
    ManifestLocatorResolved => manifest_locator_standing(acc: acc, root: commit.root.locator)
    ManifestLocatorAbsent { root: _ } => found
    ManifestLocatorIsAuthoredSource { root: _ } => found
    ManifestLocatorIsSemanticNode { root: _ } => found
  }
}

// A PARENT NAMING A COMMIT THIS REPOSITORY DOES NOT HOLD IS ADJUDICATED BEFORE THE WRITE, for the
// same reason the checkout is: encode_repository cannot refuse, so its only honest output is the
// empty reference decode later rejects -- which surfaces to whoever LOADS the document rather than to
// whoever caused it. A broken ancestry link is exactly the fact a reader must be able to trust.
//
// It answers with A parent, not THE FIRST one, matching an_uncontained_target: the refusal needs one
// actionable example and nothing downstream depends on which, so naming an order would freeze an
// incidental traversal into the interface.
// PERMANENT EXTERNAL-REALITY WALL. RepositoryCommit's sole constructor and the mint below make a
// cycle structurally impossible for INTERNAL histories: a child can name only a parent already in
// the repository. Decoded bytes are a different population. They can assert duplicate identities,
// a forward/dangling parent, a cycle, or an ordinal outside the persisted allocator watermark, so
// this single pass admits each row only after its parent and refuses at the first unadmitted edge.
// The constructor is never a reason to delete this pass. Across both paths the class remains at the
// mechanically-preventable boundary rung, not "structurally impossible" without qualification.
//
// This replaces the deleted all-start ancestry walk: history_step_at O(n) inside ancestry_walk O(n²)
// inside a_cyclic_commit O(n³) on every healthy encode and decode. Map membership makes this pass
// linear in rows under the substrate's keyed-map realization; no cycle traversal remains.
// THE INTEGRATION ANCHOR IS ADMITTED ON THE SAME RULE AS THE PARENT AND FOR A DIFFERENT REASON, so
// it is a separate arm rather than a second producer of the parent's. The parent rule exists to make
// a cycle unwritable; this one exists because A SQUASH CONSUMED A SOURCE THAT EXISTED WHEN IT RAN, so
// the anchor must already be admitted when the result is. The mint enforces exactly this against the
// INPUT repository, and without the same rule here the wire is the weaker of the two paths -- which
// DESIGN section 4b reads as the class's rung, since a rung is the MINIMUM across a class's in-scope
// paths and never the strongest one.
type CommitOrderRefusal
  = CommitReferenceDuplicated { reference: RepositoryCommitRef }
  | CommitParentNotPreviouslyAdmitted { parent: RepositoryCommitRef }
  | CommitIntegrationSourceNotPreviouslyAdmitted { source: RepositoryCommitRef }
  | CommitReferenceOutsideAllocator { reference: RepositoryCommitRef, next_ordinal: Int }

type CommitOrderAdmission {
  seen: Map<Int, Bool>
  refusal: CommitOrderRefusal?
}

// Two helpers rather than one returning a pair: the predicate is what the guard needs, and the
// reference is what the refusal needs, and folding them together would force the caller to destructure
// a value in the arm that does not use it.
fn integration_anchor_previously_admitted(seen: Map<Int, Bool>, integration: CommitIntegration) -> Bool {
  match integration {
    NoSquashIntegration => true
    SquashIntegrated { source: s } => map_contains_key(seen, minted_id_ordinal(id: s.identity))
    SquashIntegratedSuperseding { source: s, supersedes: x } =>
      map_contains_key(seen, minted_id_ordinal(id: s.identity)) && map_contains_key(seen, minted_id_ordinal(id: x.identity))
  }
}

fn integration_anchor_or(integration: CommitIntegration, fallback: RepositoryCommitRef) -> RepositoryCommitRef {
  match integration {
    NoSquashIntegration => fallback
    SquashIntegrated { source: s } => s
    SquashIntegratedSuperseding { source: s, supersedes: _ } => s
  }
}

fn admit_commit_order_step(next_ordinal: Int, acc: CommitOrderAdmission, c: RepositoryCommit) -> CommitOrderAdmission {
  match acc.refusal {
    Present { value: _ } => acc
    Absent =>
      let ordinal = minted_id_ordinal(id: c.reference.identity)
      if ordinal < 0 || ordinal >= next_ordinal {
        CommitOrderAdmission {
          seen: acc.seen,
          refusal: Present { value: CommitReferenceOutsideAllocator { reference: c.reference, next_ordinal: next_ordinal } },
        }
      } else if map_contains_key(acc.seen, ordinal) {
        CommitOrderAdmission {
          seen: acc.seen,
          refusal: Present { value: CommitReferenceDuplicated { reference: c.reference } },
        }
      } else if !integration_anchor_previously_admitted(seen: acc.seen, integration: c.integration) {
        CommitOrderAdmission {
          seen: acc.seen,
          refusal: Present {
            value: CommitIntegrationSourceNotPreviouslyAdmitted {
              source: integration_anchor_or(integration: c.integration, fallback: c.reference),
            }
          },
        }
      } else {
        match c.ancestry {
          RootCommit => CommitOrderAdmission { seen: map_insert(acc.seen, ordinal, true), refusal: none }
          DescendsFrom { parent: parent } =>
            if map_contains_key(acc.seen, minted_id_ordinal(id: parent.identity)) {
              CommitOrderAdmission { seen: map_insert(acc.seen, ordinal, true), refusal: none }
            } else {
              CommitOrderAdmission {
                seen: acc.seen,
                refusal: Present { value: CommitParentNotPreviouslyAdmitted { parent: parent } },
              }
            }
        }
      }
  }
}

fn admit_commit_order(commits: List<RepositoryCommit>, next_ordinal: Int) -> CommitOrderAdmission {
  fold(
    commits,
    init: CommitOrderAdmission { seen: empty_map(), refusal: none },
    f: fn(acc, c) { admit_commit_order_step(next_ordinal: next_ordinal, acc: acc, c: c) },
  )
}

fn repository_history(commits: List<RepositoryCommit>) -> RepositoryHistory {
  RepositoryHistory {
    steps: map(commits, c => AncestryStep { at: c.reference, ancestry: c.ancestry }),
  }
}

fn unresolved_checkout_selection(commits: List<RepositoryCommit>, selected: RepositoryCommitRef?) -> RepositoryCommitRef? {
  match selected {
    Absent => none
    Present { value: reference } =>
      match commit_at_reference(commits: commits, reference: reference) {
        Absent => Present { value: reference }
        Present { value: _ } => none
      }
  }
}

// ------------------------------------------------------------------------------------------------
// Decoding
// ------------------------------------------------------------------------------------------------

// COMMITS ACCUMULATE BY PREPEND AND ARE REVERSED ONCE AT THE CONSUMER. concat-at-end inside a fold
// copies the whole accumulator per commit, which is the quadratic shape DESIGN section 6 says is
// always fixed regardless of the realized n. This stack removed that shape from commit_closure_json_v2 and from
// object_store.dag and then reintroduced it here in the same diff -- caught by review, and the point
// worth recording is that fixing a cost shape at the sites a review names is not the same as not
// having the defect: the sweep has to be over every accumulator the change touches, or the rule is
// applied one grep at a time.
//
// The list order is load-bearing -- it is the log order a reader sees, and
// scm_env_the_root_signature_distinguishes_order is the claim that would go red if the reverse were
// dropped or applied twice.
type CommitDecodeAcc {
  commits: List<PendingCommit>
  refusal: RepositoryDecodeRefusal?
}

// The pending row carries only successfully decoded wire facts. `parent_reference` being absent
// means the document said RootCommit (JsonNull); malformed or absent members refuse before a row is
// admitted here.
type PendingCommit {
  reference: RepositoryCommitRef
  root: ObjectId
  message: String
  parent_reference: RepositoryCommitRef?
  integration: CommitIntegration
  intake: CommitIntake
}

type ResolvedCommitAcc {
  commits: List<RepositoryCommit>
  seen: Map<Int, Bool>
  refusal: RepositoryDecodeRefusal?
}

// DECODED BYTES REMAIN AN EXTERNAL POPULATION EVEN WHEN THE PURE MINT SEALS INTERNAL CONSTRUCTION.
// The mint makes cycles structurally impossible for internally constructed histories because a
// child accepts only an existing parent. It cannot constrain bytes authored elsewhere. This pass is
// therefore the permanent external-boundary wall, not scaffolding redundant with the mint: one
// authored-order fold admits each unique in-range key only after its parent, so duplicate, dangling,
// forward and cyclic edges all refuse at the first unadmitted edge. The old all-start ancestry walk
// was cubic; this keyed pass is linear in commits against the map.
// THE DOCUMENT'S ROOT LOCATOR BECOMES A NODE REFERENCE HERE, OR THE DOCUMENT REFUSES.
//
// This is the one boundary at which a file's locator can still arrive in a position that requires a
// program: inside the model the brand makes that unwritable, but a document is bytes and can say
// anything. So the store decoded from the same document is the authority that mints the brand, and
// the two negatives stay separate for the reason they do everywhere else -- an object table that
// does not carry the root at all is a different defect, with a different remedy, from one that
// carries a FILE under it.
//
// Refusing here rather than later is what makes the brand honest. Admitting the row with an
// unresolved root and leaving the encoder to notice would put a RepositoryEnvelope in a reader's
// hands whose commit root names nothing -- a value the type now claims cannot exist.
fn resolve_pending_commits(
  store: ObjectStore,
  pending: List<PendingCommit>,
  next_ordinal: Int
) -> ResolvedCommitAcc {
  match fold(
    pending,
    init: ResolvedCommitAcc { commits: [], seen: empty_map(), refusal: none },
    f: fn(acc, c) { resolve_pending_step(store: store, next_ordinal: next_ordinal, acc: acc, c: c) }
  ) {
    ResolvedCommitAcc { commits: reversed, seen: seen, refusal: refusal } =>
      ResolvedCommitAcc { commits: reverse(reversed), seen: seen, refusal: refusal }
  }
}

fn resolve_pending_step(
  store: ObjectStore,
  next_ordinal: Int,
  acc: ResolvedCommitAcc,
  c: PendingCommit
) -> ResolvedCommitAcc {
  match acc.refusal {
    Present { value: _ } => acc
    Absent =>
      match find_corpus_manifest_ref(store: store, identity: c.root) {
        CorpusManifestRefAbsent { identity: r } =>
          ResolvedCommitAcc {
            commits: acc.commits,
            seen: acc.seen,
            refusal: Present { value: RepositoryCommitRootNotInObjectTable { root: r } },
          }
        CorpusManifestRefIsAuthoredSource { identity: r } =>
          ResolvedCommitAcc {
            commits: acc.commits,
            seen: acc.seen,
            refusal: Present { value: RepositoryCommitRootIsAuthoredSource { root: r } },
          }
        CorpusManifestRefIsSemanticNode { identity: r } =>
          ResolvedCommitAcc {
            commits: acc.commits,
            seen: acc.seen,
            refusal: Present { value: RepositoryCommitRootIsSemanticNode { root: r } },
          }
        CorpusManifestRefFound(root) =>
          resolve_pending_step_admitted(
            next_ordinal: next_ordinal,
            acc: acc,
            c: c,
            root: root,
          )
      }
  }
}

fn resolve_pending_step_admitted(
  next_ordinal: Int,
  acc: ResolvedCommitAcc,
  c: PendingCommit,
  root: CorpusManifestObjectRef
) -> ResolvedCommitAcc {
  match acc.refusal {
    Present { value: _ } => acc
    Absent =>
      let ordinal = minted_id_ordinal(id: c.reference.identity)
      if ordinal < 0 || ordinal >= next_ordinal {
        ResolvedCommitAcc {
          commits: acc.commits,
          seen: acc.seen,
          refusal: Present {
            value: RepositoryDecodedCommitReferenceOutsideAllocator {
              reference: c.reference,
              next_ordinal: next_ordinal,
            }
          },
        }
      } else if map_contains_key(acc.seen, ordinal) {
        ResolvedCommitAcc {
          commits: acc.commits,
          seen: acc.seen,
          refusal: Present { value: RepositoryCommitReferenceDuplicatedOnWire { reference: c.reference } },
        }
      } else if !integration_anchor_previously_admitted(seen: acc.seen, integration: c.integration) {
        ResolvedCommitAcc {
          commits: acc.commits,
          seen: acc.seen,
          refusal: Present {
            value: RepositoryCommitIntegrationSourceNotPreviouslyAdmitted {
              source: integration_anchor_or(integration: c.integration, fallback: c.reference),
            }
          },
        }
      } else {
        match c.parent_reference {
          Present { value: parent } =>
            if !map_contains_key(acc.seen, minted_id_ordinal(id: parent.identity)) {
              ResolvedCommitAcc {
                commits: acc.commits,
                seen: acc.seen,
                refusal: Present { value: RepositoryCommitParentNotPreviouslyAdmitted { parent: parent } },
              }
            } else {
              ResolvedCommitAcc {
                commits: concat(
                  [RepositoryCommit {
                    reference: c.reference,
                    root: root,
                    message: c.message,
                    ancestry: DescendsFrom { parent: parent },
                    integration: c.integration,
                    intake: c.intake,
                  }],
                  acc.commits
                ),
                seen: map_insert(acc.seen, ordinal, true),
                refusal: none,
              }
            }
          Absent =>
            ResolvedCommitAcc {
              commits: concat(
                [RepositoryCommit {
                  reference: c.reference,
                  root: root,
                  message: c.message,
                  ancestry: RootCommit,
                  integration: c.integration,
                  intake: c.intake,
                }],
                acc.commits
              ),
              seen: map_insert(acc.seen, ordinal, true),
              refusal: none,
            }
        }
      }
  }
}

// A commit record's member set is closed for the same reason the envelope's is: a writer that states
// a fact this reader discards, and then has it deleted on the next re-encode, has lost information
// while every operation reported success.
fn commit_allowed_members(commit_policy: CommitMemberPolicy) -> List<String> {
  match commit_policy {
    CommitIntakeDeclared => ["id", "root", "message", "ancestry", "integration", "intake"]
    CommitIntegrationDeclared => ["id", "root", "message", "ancestry", "integration"]
    CommitIntegrationAbsentByFormat => ["id", "root", "message", "ancestry"]
  }
}

fn decode_commit_step(
  positions: DecodePositions,
  acc: CommitDecodeAcc,
  value: JsonValue,
  commit_policy: CommitMemberPolicy,
) -> CommitDecodeAcc {
  match acc.refusal {
    Present { value: _ } => acc
    Absent =>
      match repository_member_set_refusal(
        v: value,
        allowed: commit_allowed_members(commit_policy: commit_policy),
        context: RepositoryCommitMembers
      ) {
        Present { value: c } =>
          CommitDecodeAcc { commits: acc.commits, refusal: Present { value: c } }
        Absent => decode_commit_members(
          positions: positions,
          acc: acc,
          value: value,
          commit_policy: commit_policy,
        )
      }
  }
}

// THE COMMIT ROOT RESOLVES HERE, IN THE LAYER THAT OWNS THE ANSWER. The shared target-reference
// decoder returns the reference TEXT and never resolves it, so the only refusal it can hand back is a
// defect in the spelling -- which means this layer cannot be given another layer's cause to
// translate. The adapter that used to do that translating is deleted rather than moved: it existed
// only to undo a loss the producer no longer inflicts.
//
// The deletion is the point. That adapter mapped every unresolved reference to
// RepositoryCommitRootReferenceUnresolved, which was right only because the repository happened to
// make exactly one such call; it would have answered "this repository does not hold that commit
// root" for any genuine edge failure that ever reached it. Nothing now can.
type CommitRootDecode
  = CommitRootDecoded { root: ObjectId }
  | CommitRootRefused { cause: RepositoryDecodeRefusal }

fn decode_commit_root(positions: DecodePositions, root_value: JsonValue) -> CommitRootDecode {
  match decode_target_reference(target_value: root_value) {
    TargetReferenceRefused { cause: c } =>
      CommitRootRefused { cause: RepositoryTargetReferenceRefused { cause: c } }
    TargetUncontained { digest: root } => CommitRootDecoded { root: root }
    TargetContainedAt { reference: reference } =>
      match resolve_reference(positions: positions, reference: reference) {
        Present { value: found } =>
          CommitRootDecoded { root: scm_object_ref_locator(reference: found) }
        Absent =>
          CommitRootRefused { cause: RepositoryCommitRootReferenceUnresolved { reference: reference } }
      }
  }
}

type PendingParentRead
  = PendingParentRead { reference: RepositoryCommitRef? }
  | PendingParentRefused { cause: RepositoryDecodeRefusal }

fn repository_natural_from_json(value: JsonValue) -> Int? {
  match value {
    JsonNumber { lexeme: lexeme } =>
      match parse_int(s: lexeme as String) {
        Present { value: ordinal } =>
          if ordinal >= 0 && (ordinal as String) == (lexeme as String) {
            Present { value: ordinal }
          } else { none }
        Absent => none
      }
    _ => none
  }
}

fn repository_commit_ref_from_json(value: JsonValue) -> RepositoryCommitRef? {
  match repository_natural_from_json(value: value) {
    Absent => none
    Present { value: ordinal } =>
      Present { value: RepositoryCommitRef { identity: MintedId { ordinal: ordinal } } }
  }
}

// A MISSING `ancestry` MEMBER REFUSES; IT DOES NOT DEFAULT TO A ROOT COMMIT. Defaulting would make
// every commit in a document that predates this member read as a beginning of history, which is a
// well-formed repository that is not the one that was written -- the silent-reinterpretation failure
// the identity-rule tag exists to prevent, arriving through the schema axis instead.
//
// The member is REQUIRED rather than optional because no document exists to be compatible with: the
// only consumer of this encoder is a witness, rebuilt from source every run, so there is no durable
// artifact whose absence of this key has to be tolerated. Were one to exist, this would be a second
// format arm rather than a widened v1 body.
fn read_pending_parent_reference(value: JsonValue) -> PendingParentRead {
  match read_member_value(v: value, key: "ancestry") {
    MemberLookupFailed { cause: c } =>
      PendingParentRefused { cause: RepositoryMemberReadRefused { cause: c } }
    MemberValue { value: found } =>
      match found {
        JsonNull => PendingParentRead { reference: none }
        JsonBool { value: _ } => pending_parent_of_declared_reference(found: found)
        JsonNumber { lexeme: _ } => pending_parent_of_declared_reference(found: found)
        JsonString { value: _ } => pending_parent_of_declared_reference(found: found)
        JsonArray { elements: _ } => pending_parent_of_declared_reference(found: found)
        JsonObject { members: _ } => pending_parent_of_declared_reference(found: found)
      }
  }
}

fn pending_parent_of_declared_reference(found: JsonValue) -> PendingParentRead {
  match repository_commit_ref_from_json(value: found) {
    Present { value: reference } => PendingParentRead { reference: Present { value: reference } }
    Absent => PendingParentRefused {
      cause: RepositoryMemberReadRefused { cause: MemberReadWrongShape { key: "ancestry" } }
    }
  }
}

// A DECLARED `integration` MEMBER IS REQUIRED, NOT OPTIONAL, for the reason stated at the format tag:
// an omission that meant NoSquashIntegration would make "this commit integrated nothing" and "this
// writer said nothing" the same bytes. The absent-by-format arm is the ONLY place NoSquashIntegration
// is supplied without the document saying so, and it is sound only because no writer of that format
// had a squash producer.
type PendingIntegrationRead
  = PendingIntegrationRead { integration: CommitIntegration }
  | PendingIntegrationRefused { cause: RepositoryDecodeRefusal }

fn read_pending_integration(
  value: JsonValue,
  commit_policy: CommitMemberPolicy,
) -> PendingIntegrationRead {
  match commit_policy {
    CommitIntegrationAbsentByFormat => PendingIntegrationRead { integration: NoSquashIntegration }
    CommitIntegrationDeclared => read_declared_pending_integration(value: value, superseding_admitted: false)
    CommitIntakeDeclared => read_declared_pending_integration(value: value, superseding_admitted: true)
  }
}

fn read_declared_pending_integration(value: JsonValue, superseding_admitted: Bool) -> PendingIntegrationRead {
  match read_member_value(v: value, key: "integration") {
    MemberLookupFailed { cause: c } =>
      PendingIntegrationRefused { cause: RepositoryMemberReadRefused { cause: c } }
    MemberValue { value: found } =>
      match found {
        JsonNull => PendingIntegrationRead { integration: NoSquashIntegration }
        JsonBool { value: _ } => pending_integration_of_declared_reference(found: found)
        JsonNumber { lexeme: _ } => pending_integration_of_declared_reference(found: found)
        JsonString { value: _ } => pending_integration_of_declared_reference(found: found)
        JsonArray { elements: _ } => pending_integration_of_declared_reference(found: found)
        JsonObject { members: _ } =>
          if superseding_admitted { pending_superseding_integration(found: found) } else { pending_integration_of_declared_reference(found: found) }
      }
  }
}

fn pending_superseding_integration(found: JsonValue) -> PendingIntegrationRead {
  match unexpected_member_key(v: found, allowed: ["source", "supersedes"]) {
    Present { value: _ } => PendingIntegrationRefused { cause: RepositoryMemberReadRefused { cause: MemberReadWrongShape { key: "integration" } } }
    Absent =>
      match read_member_value(v: found, key: "source") {
        MemberLookupFailed { cause: c } => PendingIntegrationRefused { cause: RepositoryMemberReadRefused { cause: c } }
        MemberValue { value: sv } =>
          match read_member_value(v: found, key: "supersedes") {
            MemberLookupFailed { cause: c } => PendingIntegrationRefused { cause: RepositoryMemberReadRefused { cause: c } }
            MemberValue { value: xv } =>
              match repository_commit_ref_from_json(value: sv) {
                Absent => PendingIntegrationRefused { cause: RepositoryMemberReadRefused { cause: MemberReadWrongShape { key: "integration" } } }
                Present { value: s } =>
                  match repository_commit_ref_from_json(value: xv) {
                    Absent => PendingIntegrationRefused { cause: RepositoryMemberReadRefused { cause: MemberReadWrongShape { key: "integration" } } }
                    Present { value: x } => PendingIntegrationRead { integration: SquashIntegratedSuperseding { source: s, supersedes: x } }
                  }
              }
          }
      }
  }
}

// THE INTAKE MEMBER IS REQUIRED IN v9 AND ABSENT BEFORE IT, and the absent-by-format arm answers
// IntakeUnrecordedByFormat, never IntakeNone: the v8 belt wrote base commits whose message names the
// revision they froze, so that format's silence is not evidence of "no intake" (gunbc.scm.intake).
type PendingIntakeRead
  = PendingIntakeRead { intake: CommitIntake }
  | PendingIntakeRefused { cause: RepositoryDecodeRefusal }

fn read_pending_intake(value: JsonValue, commit_policy: CommitMemberPolicy) -> PendingIntakeRead {
  match commit_policy {
    CommitIntegrationAbsentByFormat => PendingIntakeRead { intake: IntakeUnrecordedByFormat }
    CommitIntegrationDeclared => PendingIntakeRead { intake: IntakeUnrecordedByFormat }
    CommitIntakeDeclared =>
      match read_member_value(v: value, key: "intake") {
        MemberLookupFailed { cause: c } => PendingIntakeRefused { cause: RepositoryMemberReadRefused { cause: c } }
        MemberValue { value: found } =>
          match decode_commit_intake(value: found) {
            CommitIntakeRefused { cause: c } => PendingIntakeRefused { cause: RepositoryMemberReadRefused { cause: c } }
            CommitIntakeDecoded { intake } => PendingIntakeRead { intake: intake }
          }
      }
  }
}

fn pending_integration_of_declared_reference(found: JsonValue) -> PendingIntegrationRead {
  match repository_commit_ref_from_json(value: found) {
    Present { value: reference } =>
      PendingIntegrationRead { integration: SquashIntegrated { source: reference } }
    Absent => PendingIntegrationRefused {
      cause: RepositoryMemberReadRefused { cause: MemberReadWrongShape { key: "integration" } }
    }
  }
}

fn decode_commit_members(
  positions: DecodePositions,
  acc: CommitDecodeAcc,
  value: JsonValue,
  commit_policy: CommitMemberPolicy,
) -> CommitDecodeAcc {
  match acc.refusal {
    Present { value: _ } => acc
    Absent =>
      match read_member_value(v: value, key: "id") {
        MemberLookupFailed { cause: c } =>
          CommitDecodeAcc { commits: acc.commits, refusal: Present { value: RepositoryMemberReadRefused { cause: c } } }
        MemberValue { value: id_value } =>
          match repository_commit_ref_from_json(value: id_value) {
            Absent => CommitDecodeAcc {
              commits: acc.commits,
              refusal: Present { value: RepositoryMemberReadRefused { cause: MemberReadWrongShape { key: "id" } } },
            }
            Present { value: reference } => decode_commit_members_after_reference(
              positions: positions,
              acc: acc,
              value: value,
              commit_reference: reference,
              commit_policy: commit_policy,
            )
          }
      }
  }
}

fn decode_commit_members_after_reference(
  positions: DecodePositions,
  acc: CommitDecodeAcc,
  value: JsonValue,
  commit_reference: RepositoryCommitRef,
  commit_policy: CommitMemberPolicy,
) -> CommitDecodeAcc {
      match read_member(v: value, key: "root") {
        MemberFailed { cause: c } =>
          CommitDecodeAcc { commits: acc.commits, refusal: Present { value: RepositoryMemberReadRefused { cause: c } } }
        MemberObject { value: root_value } =>
          match decode_commit_root(positions: positions, root_value: root_value) {
            CommitRootRefused { cause: c } =>
              CommitDecodeAcc { commits: acc.commits, refusal: Present { value: c } }
            CommitRootDecoded { root: root } =>
              match read_string_member(v: value, key: "message") {
                MemberFailed { cause: c } =>
                  CommitDecodeAcc { commits: acc.commits, refusal: Present { value: RepositoryMemberReadRefused { cause: c } } }
                MemberString { value: message } =>
                  match read_pending_parent_reference(value: value) {
                    PendingParentRefused { cause: c } =>
                      CommitDecodeAcc { commits: acc.commits, refusal: Present { value: c } }
                    PendingParentRead { reference: parent_reference } =>
                      match read_pending_integration(value: value, commit_policy: commit_policy) {
                        PendingIntegrationRefused { cause: c } =>
                          CommitDecodeAcc { commits: acc.commits, refusal: Present { value: c } }
                        PendingIntegrationRead { integration: integration } =>
                          match read_pending_intake(value: value, commit_policy: commit_policy) {
                            PendingIntakeRefused { cause: c } =>
                              CommitDecodeAcc { commits: acc.commits, refusal: Present { value: c } }
                            PendingIntakeRead { intake: intake } =>
                              CommitDecodeAcc {
                                commits: concat(
                                  [PendingCommit {
                                    reference: commit_reference,
                                    root: root,
                                    message: message,
                                    parent_reference: parent_reference,
                                    integration: integration,
                                    intake: intake,
                                  }],
                                  acc.commits
                                ),
                                refusal: acc.refusal,
                              }
                          }
                      }
                  }
                MemberArray { elements: _ } =>
                  CommitDecodeAcc { commits: acc.commits, refusal: Present { value: RepositoryMemberReadRefused { cause: MemberReadWrongShape { key: "message" } } } }
                MemberObject { value: _ } =>
                  CommitDecodeAcc { commits: acc.commits, refusal: Present { value: RepositoryMemberReadRefused { cause: MemberReadWrongShape { key: "message" } } } }
              }
          }
        MemberString { value: _ } =>
          CommitDecodeAcc { commits: acc.commits, refusal: Present { value: RepositoryMemberReadRefused { cause: MemberReadWrongShape { key: "root" } } } }
        MemberArray { elements: _ } =>
          CommitDecodeAcc { commits: acc.commits, refusal: Present { value: RepositoryMemberReadRefused { cause: MemberReadWrongShape { key: "root" } } } }
      }
}

// THE IDENTITY RULE IS CHECKED BEFORE ANY OBJECT IS DECODED, for the same reason the format tag is:
// a document written under a different node-identity rule would decode cleanly and reconstruct
// DIFFERENT identities, so discovering the mismatch after the walk would mean reporting a
// well-formed repository that silently is not the one that was stored.
// FORMAT DISPATCH IS ITS OWN STEP, and it selects a decoder that understands ONE exact schema. The
// shape a FOURTH version must take is a further arm here calling its own decoder -- never the v3
// body widened to admit the newer members, which would erase the reason the member sets are closed
// at all.
//
// THE ARMS AND THE CODEC FUNCTIONS ARE NAMED FOR THE TAG THEY ACTUALLY IMPLEMENT, which is the rule
// that made this rename mechanical rather than a judgment call: they said v2 while
// repository_envelope_format_tag moved to v3, and one spelling over two materially different
// contracts is the meaning fork DESIGN section 3 names -- with the wrong one left standing where a
// reader looks first.
// The identity-rule tag stays a separate axis for the same reason it is separate today: a schema-v3
// document may still carry an older node-identity rule, and an identity migration may leave the JSON
// schema untouched. This change moved BOTH, independently and for different reasons: the schema
// because the object-entry language grew a {manifest} arm, and the identity rule because a manifest
// is a third identity family.
// A RETIRED FORMAT IS ITS OWN ARM, NOT AN UNKNOWN ONE. `RepositoryFormatUnknown` means "this build
// has never heard of that tag"; v3 is a tag this build knows exactly, and knows it cannot read.
// Collapsing the two would tell an operator holding a real v3 repository that their format is
// unrecognized, which points them at the wrong repair.
//
// THERE IS DELIBERATELY NO v3 READER, and that is a ruling rather than an omission. A v3 commit root
// designates a semantic node; the v4 carrier's root is a CorpusManifestObjectRef. There is no
// conversion, because deriving a manifest from a semantic root would have to invent authored bytes
// the projection discarded -- comments, original placement, anything that did not survive ingestion.
// A migration needs authored-source and association evidence; where that evidence is absent the
// migration must say so rather than fabricate a snapshot. So this build refuses, loudly and by name.
//
// v4 IS A THIRD ARM RATHER THAN A SECOND SPELLING OF v5, and the arms are what keep the two readers
// from becoming one reader with a flag. Each arm names a member population, and a document is read by
// the reader for the population its own tag declares -- so a v4 document carrying a `staged` member
// refuses as an unexpected member, and a v5 document omitting one refuses as a missing member. A
// single tolerant reader admitting both would accept each of those, and each is a document nobody
// could have written.
type RepositoryFormat
  = RepositoryFormatV9
  | RepositoryFormatV8
  | RepositoryFormatV7
  | RepositoryFormatV6
  | RepositoryFormatV5
  | RepositoryFormatV4
  | RepositoryFormatRetiredV3
  | RepositoryFormatUnknown { found: String }

fn repository_format_of(tag: String) -> RepositoryFormat {
  if tag == repository_envelope_format_tag {
    RepositoryFormatV6
  } else if tag == repository_envelope_format_tag_v7 {
    RepositoryFormatV7
  } else if tag == repository_envelope_format_tag_v8 {
    RepositoryFormatV8
  } else if tag == repository_envelope_format_tag_v9 {
    RepositoryFormatV9
  } else if tag == repository_envelope_format_tag_v5 {
    RepositoryFormatV5
  } else {
    if tag == repository_envelope_format_tag_v4 {
      RepositoryFormatV4
    } else {
      if tag == repository_envelope_format_tag_v3 {
        RepositoryFormatRetiredV3
      } else {
        RepositoryFormatUnknown { found: tag }
      }
    }
  }
}

fn decode_repository(v: JsonValue) -> RepositoryDecodeOutcome {
  match read_string_member(v: v, key: "format") {
    MemberFailed { cause: c } => RepositoryDecodeRefused { cause: RepositoryMemberReadRefused { cause: c } }
    MemberString { value: format } =>
      match repository_format_of(tag: format) {
        RepositoryFormatUnknown { found: f } =>
          RepositoryDecodeRefused { cause: RepositoryFormatUnrecognized { found: f } }
        RepositoryFormatRetiredV3 =>
          RepositoryDecodeRefused {
            cause: RepositoryFormatRetired { found: repository_envelope_format_tag_v3 }
          }
        RepositoryFormatV9 =>
          RepositoryDecodeRefused { cause: RepositoryShardedIndexIsNotWhole { found: repository_envelope_format_tag_v9 } }
        RepositoryFormatV8 =>
          RepositoryDecodeRefused { cause: RepositoryShardedIndexIsNotWhole { found: repository_envelope_format_tag_v8 } }
        RepositoryFormatV7 =>
          RepositoryDecodeRefused { cause: RepositoryShardedIndexIsNotWhole { found: repository_envelope_format_tag_v7 } }
        RepositoryFormatV6 => decode_repository_v6(v: v)
        RepositoryFormatV5 => decode_repository_v5(v: v)
        RepositoryFormatV4 => decode_repository_v4(v: v)
      }
    MemberArray { elements: _ } => RepositoryDecodeRefused { cause: RepositoryMemberReadRefused { cause: MemberReadWrongShape { key: "format" } } }
    MemberObject { value: _ } => RepositoryDecodeRefused { cause: RepositoryMemberReadRefused { cause: MemberReadWrongShape { key: "format" } } }
  }
}

// EXACTLY v4. Every member population below is v4's, and this body freezes once a v4 document exists
// anywhere -- at which point a v5 arrives as its own reader beside this one rather than as an edit to
// it. v3's reader is NOT beside it: v3 was retired rather than kept, because its commit root names a
// population this carrier cannot hold, and a reader that cannot produce the type is not a reader.
// WHETHER THE DOCUMENT DECLARES A STAGE IS THE FORMAT'S FACT, SO THE FORMAT'S READER SUPPLIES IT.
//
// The two readers below differ in exactly this and nothing else, and it is carried as a value rather
// than duplicated as a second body because a duplicated body drifts: the next member added to v5
// would have to be added twice, and the reader that was missed would go on decoding documents into a
// value that omits it, silently.
//
// IT IS A TYPE AND NOT A Bool because the two states have different content. "The document declares
// a stage member, read it" and "this format has no stage, and Absent is what such a document says
// about staging" are different propositions, and a Bool named `has_staged` records only the first
// one's truth value while the annotation carrying the second lives somewhere a reader may not look.
type StageMemberPolicy
  = StageMemberDeclared
  | StageMemberAbsentByFormat

// WHETHER A COMMIT RECORD DECLARES ITS INTEGRATION IS THE FORMAT'S FACT, SO THE FORMAT'S READER
// SUPPLIES IT -- the same shape `StageMemberPolicy` already carries one level up, and a type rather
// than a Bool for the same reason: "the record declares the member, read it" and "this format has no
// integration member, and NoSquashIntegration is what such a document SAYS about integration" are
// different propositions, and only the second needs the historical argument that no v5 writer had a
// squash producer. It is named for the COMMIT's member population rather than for integration alone
// since v9 added `intake` to it: one axis per format, not one Bool per member.
type CommitMemberPolicy
  = CommitIntakeDeclared
  | CommitIntegrationDeclared
  | CommitIntegrationAbsentByFormat

fn decode_repository_v6(v: JsonValue) -> RepositoryDecodeOutcome {
  decode_repository_versioned(
    v: v,
    allowed: ["format", "identity_rule", "objects", "commits", "next_commit_ordinal", "checked_out", "staged"],
    policy: StageMemberDeclared,
    commit_policy: CommitIntegrationDeclared,
  )
}

// EXACTLY v5, AND FROZEN. Its envelope member population is v6's -- the two differ only inside a
// commit record -- so the split is carried by `commit_policy` and by nothing else. A v5 document
// carrying an `integration` member refuses here as an unexpected member, correctly, because no v5
// writer could have produced one.
fn decode_repository_v5(v: JsonValue) -> RepositoryDecodeOutcome {
  decode_repository_versioned(
    v: v,
    allowed: ["format", "identity_rule", "objects", "commits", "next_commit_ordinal", "checked_out", "staged"],
    policy: StageMemberDeclared,
    commit_policy: CommitIntegrationAbsentByFormat,
  )
}

// EXACTLY v4, AND FROZEN. Its member population is v4's, which is v5's without `staged`, so a v4
// document carrying one refuses here as an unexpected member -- correctly, because no v4 writer could
// have produced it. This body does not grow: a v6 arrives as its own reader beside these two.
fn decode_repository_v4(v: JsonValue) -> RepositoryDecodeOutcome {
  decode_repository_versioned(
    v: v,
    allowed: ["format", "identity_rule", "objects", "commits", "next_commit_ordinal", "checked_out"],
    policy: StageMemberAbsentByFormat,
    commit_policy: CommitIntegrationAbsentByFormat,
  )
}

// THE v7 INDEX DOCUMENT IS NOT A WHOLE REPOSITORY -- it names its objects by content identity and
// leaves their payloads to the shards, so decode_repository refuses it by name: reading it as one
// would fabricate an empty store. The loader (gunbc.scm.repository_load) decodes the index here,
// reads exactly the rostered shards, assembles the store through gunbc.scm.object_store
// store_assemble_decoded, and only then runs the shared body -- the same censuses, commit table and
// selection adjudications every version runs.
type RepositoryShardedIndex {
  document: JsonValue
  shard_digests: List<String>
  roster: RepositoryObjectRoster
  commit_policy: CommitMemberPolicy
}

// WHETHER THE INDEX CARRIES AN OBJECT ROSTER IS THE FORMAT'S FACT: v7 has none (its objects are
// findable only by decoding every shard), v8 declares one. A type, not a Bool, so an indexed reader
// meeting a v7 index refuses by naming what is missing rather than reading an empty roster as
// "this repository holds no objects".
type RepositoryObjectRoster
  = ObjectRosterAbsentByFormat
  | ObjectRosterDeclared { rows: List<RosteredObject> }

type ObjectRosterRead
  = ObjectRosterRowsRead { rows: List<RosteredObject>, seen: Map<String, Bool> }
  | ObjectRosterRefused { detail: String }

fn object_roster_string_at(elements: List<JsonValue>, position: Int) -> String? {
  match (elements |> skip(n: position)).first() {
    Absent => none
    Present { value: element } =>
      match element {
        JsonString { value: text } => Present { value: text }
        JsonNull => none
        JsonBool { value: _ } => none
        JsonNumber { lexeme: _ } => none
        JsonArray { elements: _ } => none
        JsonObject { members: _ } => none
      }
  }
}

fn object_roster_step(acc: ObjectRosterRead, value: JsonValue) -> ObjectRosterRead {
  match acc {
    ObjectRosterRefused { detail: _ } => acc
    ObjectRosterRowsRead { rows, seen } =>
      match value {
        JsonArray { elements } =>
          if count(elements) != 3 {
            ObjectRosterRefused { detail: "an objects row is not an [identity, kind, shard] triple" }
          } else {
            match object_roster_string_at(elements: elements, position: 0) {
              Absent => ObjectRosterRefused { detail: "an objects row's identity is not a string" }
              Present { value: hex } =>
                match fnv1a64_structural_hex_digest(hex: hex) {
                  Absent => ObjectRosterRefused { detail: join(["an objects row names an invalid identity digest: ", hex], "") }
                  Present { value: identity } =>
                    match map_lookup(m: seen, key: hex) {
                      Present { value: _ } => ObjectRosterRefused { detail: join(["the object roster names identity ", hex, " twice"], "") }
                      Absent =>
                        match object_roster_string_at(elements: elements, position: 1) {
                          Absent => ObjectRosterRefused { detail: "an objects row's kind is not a string" }
                          Present { value: tag } =>
                            match scm_object_kind_of_tag(tag: tag) {
                              Absent => ObjectRosterRefused { detail: join(["an objects row names unknown kind ", tag], "") }
                              Present { value: kind } =>
                                match object_roster_string_at(elements: elements, position: 2) {
                                  Absent => ObjectRosterRefused { detail: "an objects row's shard is not a string" }
                                  Present { value: shard } =>
                                    ObjectRosterRowsRead {
                                      rows: concat([RosteredObject { identity: identity, kind: kind, shard: shard }], rows),
                                      seen: map_insert(seen, hex, true),
                                    }
                                }
                            }
                        }
                    }
                }
            }
          }
        JsonNull => ObjectRosterRefused { detail: "an objects row is not an array" }
        JsonBool { value: _ } => ObjectRosterRefused { detail: "an objects row is not an array" }
        JsonNumber { lexeme: _ } => ObjectRosterRefused { detail: "an objects row is not an array" }
        JsonString { value: _ } => ObjectRosterRefused { detail: "an objects row is not an array" }
        JsonObject { members: _ } => ObjectRosterRefused { detail: "an objects row is not an array" }
      }
  }
}

// EVERY ROW NAMES A SHARD THE INDEX ROSTERS. A row pointing outside object_shards names a document
// the loader would never be told exists, so it refuses here rather than at the first demand for it.
fn decode_object_roster(values: List<JsonValue>, shard_digests: List<String>) -> ObjectRosterRead {
  let shards = fold(shard_digests, init: empty_map(), f: fn(m, d) { map_insert(m, d, true) })
  match fold(values, init: ObjectRosterRowsRead { rows: [], seen: empty_map() }, f: fn(acc, v) { object_roster_step(acc: acc, value: v) }) {
    ObjectRosterRefused { detail } => ObjectRosterRefused { detail: detail }
    ObjectRosterRowsRead { rows, seen } =>
      match (rows |> filter(r => match map_lookup(m: shards, key: r.shard) { Present { value: _ } => false Absent => true })).first() {
        Present { value: stray } =>
          ObjectRosterRefused {
            detail: join(["the object roster places ", stray.identity.digest as String, " in shard ", stray.shard, ", which object_shards does not roster"], ""),
          }
        Absent => ObjectRosterRowsRead { rows: reverse(rows), seen: seen }
      }
  }
}

type RepositoryShardedIndexDecode
  = ShardedIndexDecoded { index: RepositoryShardedIndex }
  | ShardedIndexRefused { cause: RepositoryDecodeRefusal }

type ShardDigestRead
  = ShardDigestsRead { digests: List<String> }
  | ShardDigestsRefused { reason: String }

fn shard_digest_step(acc: ShardDigestRead, value: JsonValue) -> ShardDigestRead {
  match acc {
    ShardDigestsRefused { reason: _ } => acc
    ShardDigestsRead { digests } =>
      match value {
        JsonString { value: digest } =>
          ShardDigestsRead { digests: concat(digests, [digest]) }
        JsonNull =>
          ShardDigestsRefused { reason: "object_shards carries a non-string member" }
        JsonBool { value: _ } =>
          ShardDigestsRefused { reason: "object_shards carries a non-string member" }
        JsonNumber { lexeme: _ } =>
          ShardDigestsRefused { reason: "object_shards carries a non-string member" }
        JsonArray { elements: _ } =>
          ShardDigestsRefused { reason: "object_shards carries a non-string member" }
        JsonObject { members: _ } =>
          ShardDigestsRefused { reason: "object_shards carries a non-string member" }
      }
  }
}

fn decode_repository_v7_index(v: JsonValue) -> RepositoryShardedIndexDecode {
  decode_repository_sharded_index(
    v: v,
    allowed: ["format", "identity_rule", "object_shards", "commits", "next_commit_ordinal", "checked_out", "staged"],
    roster_declared: false,
    commit_policy: CommitIntegrationDeclared,
  )
}

fn decode_repository_v8_index(v: JsonValue) -> RepositoryShardedIndexDecode {
  decode_repository_sharded_index(
    v: v,
    allowed: ["format", "identity_rule", "object_shards", "objects", "commits", "next_commit_ordinal", "checked_out", "staged"],
    roster_declared: true,
    commit_policy: CommitIntegrationDeclared,
  )
}

// v9's ENVELOPE MEMBER POPULATION IS v8's; the formats differ only inside a commit record, so the
// split is carried by `commit_policy` and nothing else -- the shape v5/v6 already have.
fn decode_repository_v9_index(v: JsonValue) -> RepositoryShardedIndexDecode {
  decode_repository_sharded_index(
    v: v,
    allowed: ["format", "identity_rule", "object_shards", "objects", "commits", "next_commit_ordinal", "checked_out", "staged"],
    roster_declared: true,
    commit_policy: CommitIntakeDeclared,
  )
}

fn decode_sharded_index_roster(v: JsonValue, digests: List<String>, roster_declared: Bool, commit_policy: CommitMemberPolicy) -> RepositoryShardedIndexDecode {
  if !roster_declared {
    ShardedIndexDecoded { index: RepositoryShardedIndex { document: v, shard_digests: digests, roster: ObjectRosterAbsentByFormat, commit_policy: commit_policy } }
  } else {
    match read_member(v: v, key: "objects") {
      MemberArray { elements } =>
        match decode_object_roster(values: elements, shard_digests: digests) {
          ObjectRosterRefused { detail } =>
            ShardedIndexRefused { cause: RepositoryObjectRosterMalformed { detail: detail } }
          ObjectRosterRowsRead { rows, seen: _ } =>
            ShardedIndexDecoded {
              index: RepositoryShardedIndex { document: v, shard_digests: digests, roster: ObjectRosterDeclared { rows: rows }, commit_policy: commit_policy },
            }
        }
      MemberFailed { cause: c } => ShardedIndexRefused { cause: RepositoryMemberReadRefused { cause: c } }
      MemberString { value: _ } =>
        ShardedIndexRefused { cause: RepositoryMemberReadRefused { cause: MemberReadWrongShape { key: "objects" } } }
      MemberObject { value: _ } =>
        ShardedIndexRefused { cause: RepositoryMemberReadRefused { cause: MemberReadWrongShape { key: "objects" } } }
    }
  }
}

fn decode_repository_sharded_index(v: JsonValue, allowed: List<String>, roster_declared: Bool, commit_policy: CommitMemberPolicy) -> RepositoryShardedIndexDecode {
  match read_string_member(v: v, key: "identity_rule") {
    MemberFailed { cause: c } => ShardedIndexRefused { cause: RepositoryMemberReadRefused { cause: c } }
    MemberString { value: rule } =>
      if rule != repository_object_identity_rule_tag {
        ShardedIndexRefused { cause: RepositoryIdentityRuleUnrecognized { found: rule } }
      } else {
        match repository_member_set_refusal(
          v: v,
          allowed: allowed,
          context: RepositoryEnvelopeMembers
        ) {
          Present { value: c } => ShardedIndexRefused { cause: c }
          Absent =>
            match read_member(v: v, key: "object_shards") {
              MemberFailed { cause: c } =>
                ShardedIndexRefused { cause: RepositoryMemberReadRefused { cause: c } }
              MemberArray { elements: shard_values } =>
                match fold(
                  shard_values,
                  init: ShardDigestsRead { digests: [] },
                  f: fn(acc, sv) { shard_digest_step(acc: acc, value: sv) },
                ) {
                  ShardDigestsRefused { reason } =>
                    ShardedIndexRefused {
                      cause: RepositoryMemberReadRefused { cause: MemberReadWrongShape { key: "object_shards" } },
                    }
                  ShardDigestsRead { digests } =>
                    decode_sharded_index_roster(v: v, digests: digests, roster_declared: roster_declared, commit_policy: commit_policy)
                }
              MemberString { value: _ } =>
                ShardedIndexRefused {
                  cause: RepositoryMemberReadRefused { cause: MemberReadWrongShape { key: "object_shards" } },
                }
              MemberObject { value: _ } =>
                ShardedIndexRefused {
                  cause: RepositoryMemberReadRefused { cause: MemberReadWrongShape { key: "object_shards" } },
                }
            }
        }
      }
    MemberArray { elements: _ } => ShardedIndexRefused { cause: RepositoryMemberReadRefused { cause: MemberReadWrongShape { key: "identity_rule" } } }
    MemberObject { value: _ } => ShardedIndexRefused { cause: RepositoryMemberReadRefused { cause: MemberReadWrongShape { key: "identity_rule" } } }
  }
}

fn decode_repository_v7_finish(v: JsonValue, store: ObjectStore, commit_policy: CommitMemberPolicy) -> RepositoryDecodeOutcome {
  match read_member_value(v: v, key: "next_commit_ordinal") {
    MemberLookupFailed { cause: c } => RepositoryDecodeRefused { cause: RepositoryMemberReadRefused { cause: c } }
    MemberValue { value: found } =>
      match repository_natural_from_json(value: found) {
        Absent => RepositoryDecodeRefused {
          cause: RepositoryMemberReadRefused { cause: MemberReadWrongShape { key: "next_commit_ordinal" } }
        }
        Present { value: next_ordinal } =>
          decode_repository_body_with_store(
            v: v,
            next_ordinal: next_ordinal,
            policy: StageMemberDeclared,
            commit_policy: commit_policy,
            store: store,
            positions: empty_map(),
          )
      }
  }
}

fn decode_repository_versioned(
  v: JsonValue,
  allowed: List<String>,
  policy: StageMemberPolicy,
  commit_policy: CommitMemberPolicy,
) -> RepositoryDecodeOutcome {
  match read_string_member(v: v, key: "identity_rule") {
    MemberFailed { cause: c } => RepositoryDecodeRefused { cause: RepositoryMemberReadRefused { cause: c } }
    MemberString { value: rule } =>
      if rule != repository_object_identity_rule_tag {
        RepositoryDecodeRefused { cause: RepositoryIdentityRuleUnrecognized { found: rule } }
      } else {
        match repository_member_set_refusal(
          v: v,
          allowed: allowed,
          context: RepositoryEnvelopeMembers
        ) {
          Present { value: c } => RepositoryDecodeRefused { cause: c }
          Absent => decode_repository_body(v: v, policy: policy, commit_policy: commit_policy)
        }
      }
    MemberArray { elements: _ } => RepositoryDecodeRefused { cause: RepositoryMemberReadRefused { cause: MemberReadWrongShape { key: "identity_rule" } } }
    MemberObject { value: _ } => RepositoryDecodeRefused { cause: RepositoryMemberReadRefused { cause: MemberReadWrongShape { key: "identity_rule" } } }
  }
}

fn decode_repository_body(v: JsonValue, policy: StageMemberPolicy, commit_policy: CommitMemberPolicy) -> RepositoryDecodeOutcome {
  match read_member_value(v: v, key: "next_commit_ordinal") {
    MemberLookupFailed { cause: c } => RepositoryDecodeRefused { cause: RepositoryMemberReadRefused { cause: c } }
    MemberValue { value: found } =>
      match repository_natural_from_json(value: found) {
        Absent => RepositoryDecodeRefused {
          cause: RepositoryMemberReadRefused { cause: MemberReadWrongShape { key: "next_commit_ordinal" } }
        }
        Present { value: next_ordinal } => decode_repository_body_with_allocator(
          v: v,
          next_ordinal: next_ordinal,
          policy: policy,
          commit_policy: commit_policy,
        )
      }
  }
}

// THE READER ADJUDICATES ITS FINISHED TABLE, RATHER THAN EACH ENTRY AS IT ARRIVES.
//
// The contained spelling of a reference resolves a POSITION, so the entry decoder can refuse a node
// or manifest standing where a source or program belongs. Its UNCONTAINED sibling cannot: an
// uncontained reference is a digest, and whether that digest is occupied is a question about the
// whole decoded store, which does not exist yet while the entry is being read. So changing the
// reference SPELLING changed wrong-kind admission -- contained refused, uncontained admitted -- and
// the checked writer refused stores this reader accepted.
//
// PER-ENTRY WOULD STILL BE WRONG even if the store were available, because the occupying object may
// appear AFTER the entry that refers to it. The judgment belongs to the finished population, and the
// population is the one the census authority already computes.
//
// BOTH SUBJECTS ARE ADJUDICATED, AND THE FIRST REPAIR HERE CARRIED ONLY ONE. A manifest's authored
// source and a node's semantic child are two different requirements over the same locators; closing
// the manifest-source route left the semantic-child route open, so a program whose only child named
// a manifest by digest still reached RepositoryDecoded while the checked writer refused the same
// store. Reading one of two subjects is the same defect as reading one of two populations, which is
// what the census was split for.
//
// THE PROJECTIONS ARE THE WRITER'S, NOT A SECOND SET. a_source_occupied_target and its three
// siblings take a CENSUS rather than a store precisely so both directions can ask one authority the
// same question; a reader-local copy taking a store would be a second authority for one rule, and
// re-derived the census once per question besides.
//
// GENUINE ABSENCE IS NOT WHAT THESE FOUR GUARDS ANSWER, AND SAYING THEY MATCH THE WRITER ON IT WAS
// TOO BROAD. The absence policy is per SUBJECT, and the two subjects do not share it:
//
//   a manifest source this document does not carry   admitted by both writer and reader; a partial
//                                                    corpus is legitimate
//   a semantic child this document does not carry    REFUSED by the checked writer, as
//                                                    RepositoryEncodeUncontainedTarget; not a
//                                                    proposition these four guards make at all
//
// What these guards answer is narrower than either: they read the OCCUPIED populations only, so an
// absent locator passes them whatever its subject, and the absent semantic child is refused by the
// writer's own guard rather than here. The refusals carry the ObjectId they actually know rather
// than a wire position, because at this point there is no position -- the reference was a digest.
fn decode_repository_body_with_allocator(
  v: JsonValue,
  next_ordinal: Int,
  policy: StageMemberPolicy,
  commit_policy: CommitMemberPolicy,
) -> RepositoryDecodeOutcome {
  match read_member(v: v, key: "objects") {
    MemberFailed { cause: c } => RepositoryDecodeRefused { cause: RepositoryMemberReadRefused { cause: c } }
    MemberArray { elements: object_values } =>
      match decode_object_table(object_values: object_values) {
        DecodeAcc { admission: admission, positions: positions, next: _, refusal: table_refusal } =>
          match table_refusal {
            Present { value: c } => RepositoryDecodeRefused { cause: RepositoryDecodeObjectTableRefused { cause: c } }
            Absent =>
              decode_repository_body_with_store(
                v: v,
                next_ordinal: next_ordinal,
                policy: policy,
                commit_policy: commit_policy,
                store: store_admission_store(admission: admission),
                positions: positions,
              )
          }
      }
    MemberString { value: _ } => RepositoryDecodeRefused { cause: RepositoryMemberReadRefused { cause: MemberReadWrongShape { key: "objects" } } }
    MemberObject { value: _ } => RepositoryDecodeRefused { cause: RepositoryMemberReadRefused { cause: MemberReadWrongShape { key: "objects" } } }
  }
}





// A DANGLING CHECKOUT REFERENCE REFUSES RATHER THAN DEGRADING TO "nothing checked out". Those are
// different states: one is an ordinary empty repository, the other is a document whose workspace
// selection names an object the table does not contain. Answering the first for the second would
// silently discard the user's position and present the result as a healthy repository.
//
// THE TWO SELECTIONS ARE DECODED SEPARATELY AND THE ENVELOPE IS ASSEMBLED ONCE. This function used
// to construct a whole RepositoryEnvelope in each of its two success arms, so every member added to
// the carrier had to be written into both, and a member written into one was a decoded document
// silently missing a field on the other path. Returning the SELECTION and assembling in one place
// removes the site where that divergence can be authored, rather than adding a check that the two
// literals agree.
type CheckoutSelectionDecode
  = CheckoutSelectionDecoded { selected: RepositoryCommitRef? }
  | CheckoutSelectionRefused { cause: RepositoryDecodeRefusal }

fn decode_repository_checkout(
  v: JsonValue,
  commits: List<RepositoryCommit>,
) -> CheckoutSelectionDecode {
  match read_member_value(v: v, key: "checked_out") {
    MemberLookupFailed { cause: c } =>
      CheckoutSelectionRefused { cause: RepositoryMemberReadRefused { cause: c } }
    MemberValue { value: found } =>
      match found {
        JsonNull => CheckoutSelectionDecoded { selected: none }
        JsonBool { value: _ } => checkout_selection_of_declared_reference(found: found, commits: commits)
        JsonNumber { lexeme: _ } => checkout_selection_of_declared_reference(found: found, commits: commits)
        JsonString { value: _ } => checkout_selection_of_declared_reference(found: found, commits: commits)
        JsonArray { elements: _ } => checkout_selection_of_declared_reference(found: found, commits: commits)
        JsonObject { members: _ } => checkout_selection_of_declared_reference(found: found, commits: commits)
      }
  }
}

fn checkout_selection_of_declared_reference(found: JsonValue, commits: List<RepositoryCommit>) -> CheckoutSelectionDecode {
  match repository_commit_ref_from_json(value: found) {
    Absent => CheckoutSelectionRefused {
      cause: RepositoryMemberReadRefused { cause: MemberReadWrongShape { key: "checked_out" } }
    }
    Present { value: reference } =>
      match commit_at_reference(commits: commits, reference: reference) {
        Absent =>
          CheckoutSelectionRefused { cause: RepositoryCheckoutReferenceUnresolved { reference: reference } }
        Present { value: _ } =>
          CheckoutSelectionDecoded { selected: Present { value: reference } }
      }
  }
}

// A DANGLING STAGE REFUSES FOR THE SAME REASON A DANGLING CHECKOUT DOES, and the wrong-kind arms are
// separate from the absent one for the reason every wrong-kind population in this module is: a
// locator occupied by a source or a node is not an empty locator, and reporting it as one tells the
// operator to restore an object that is already there.
type StagedDecode
  = StagedDecoded { staged: CorpusManifestObjectRef? }
  | StagedRefused { cause: RepositoryDecodeRefusal }

fn decode_repository_stage(
  v: JsonValue,
  store: ObjectStore,
  positions: DecodePositions,
  policy: StageMemberPolicy,
) -> StagedDecode {
  match policy {
    StageMemberAbsentByFormat => StagedDecoded { staged: none }
    StageMemberDeclared =>
      match read_member_value(v: v, key: "staged") {
        MemberLookupFailed { cause: c } =>
          StagedRefused { cause: RepositoryMemberReadRefused { cause: c } }
        MemberValue { value: found } =>
          match found {
            JsonNull => StagedDecoded { staged: none }
            JsonBool { value: _ } => decode_declared_stage(store: store, positions: positions, found: found)
            JsonNumber { lexeme: _ } => decode_declared_stage(store: store, positions: positions, found: found)
            JsonString { value: _ } => decode_declared_stage(store: store, positions: positions, found: found)
            JsonArray { elements: _ } => decode_declared_stage(store: store, positions: positions, found: found)
            JsonObject { members: _ } => decode_declared_stage(store: store, positions: positions, found: found)
          }
      }
  }
}

fn decode_declared_stage(
  store: ObjectStore,
  positions: DecodePositions,
  found: JsonValue,
) -> StagedDecode {
  match decode_target_reference(target_value: found) {
    TargetReferenceRefused { cause: c } =>
      StagedRefused { cause: RepositoryTargetReferenceRefused { cause: c } }
    TargetUncontained { digest: digest } => resolve_stage_locator(store: store, staged: digest)
    TargetContainedAt { reference: reference } =>
      match resolve_reference(positions: positions, reference: reference) {
        Present { value: object } =>
          resolve_stage_locator(store: store, staged: scm_object_ref_locator(reference: object))
        Absent =>
          StagedRefused { cause: RepositoryStagedReferenceUnresolved { reference: reference } }
      }
  }
}

fn resolve_stage_locator(store: ObjectStore, staged: ObjectId) -> StagedDecode {
  match find_corpus_manifest_ref(store: store, identity: staged) {
    CorpusManifestRefAbsent { identity: r } =>
      StagedRefused { cause: RepositoryStagedNotInObjectTable { staged: r } }
    CorpusManifestRefIsAuthoredSource { identity: r } =>
      StagedRefused { cause: RepositoryStagedIsAuthoredSource { staged: r } }
    CorpusManifestRefIsSemanticNode { identity: r } =>
      StagedRefused { cause: RepositoryStagedIsSemanticNode { staged: r } }
    CorpusManifestRefFound(root) => StagedDecoded { staged: Present { value: root } }
  }
}

fn decode_repository_selections(
  v: JsonValue,
  store: ObjectStore,
  positions: DecodePositions,
  commits: List<RepositoryCommit>,
  next_ordinal: Int,
  policy: StageMemberPolicy,
) -> RepositoryDecodeOutcome {
  match decode_repository_checkout(v: v, commits: commits) {
    CheckoutSelectionRefused { cause: c } => RepositoryDecodeRefused { cause: c }
    CheckoutSelectionDecoded { selected: selected } =>
      match decode_repository_stage(v: v, store: store, positions: positions, policy: policy) {
        StagedRefused { cause: c } => RepositoryDecodeRefused { cause: c }
        StagedDecoded { staged: staged } =>
          RepositoryDecoded {
            envelope: RepositoryEnvelope {
              store: store,
              commits: commits,
              commit_allocator: MintedIdAllocator { next_ordinal: next_ordinal },
              checked_out: selected,
              staged: staged,
            }
          }
      }
  }
}

fn decode_repository_body_with_store(
  v: JsonValue,
  next_ordinal: Int,
  policy: StageMemberPolicy,
  commit_policy: CommitMemberPolicy,
  store: ObjectStore,
  positions: DecodePositions,
) -> RepositoryDecodeOutcome {
              let semantic = store_census(store: store)
              let sources = manifest_source_census(store: store)
              match a_manifest_source_at_a_node(census: sources) {
                Present { value: source } =>
                  RepositoryDecodeRefused {
                    cause: RepositoryDecodedManifestSourceIsSemanticNode { source: source }
                  }
                Absent =>
              match a_manifest_source_at_a_manifest(census: sources) {
                Present { value: source } =>
                  RepositoryDecodeRefused {
                    cause: RepositoryDecodedManifestSourceIsCorpusManifest { source: source }
                  }
                Absent =>
              match a_source_occupied_target(census: semantic) {
                Present { value: target } =>
                  RepositoryDecodeRefused {
                    cause: RepositoryDecodedTargetIsAuthoredSource { target: target }
                  }
                Absent =>
              match a_manifest_occupied_target(census: semantic) {
                Present { value: target } =>
                  RepositoryDecodeRefused {
                    cause: RepositoryDecodedTargetIsCorpusManifest { target: target }
                  }
                Absent =>
              match read_member(v: v, key: "commits") {
                MemberFailed { cause: c } => RepositoryDecodeRefused { cause: RepositoryMemberReadRefused { cause: c } }
                MemberArray { elements: commit_values } =>
                  match fold(
                    commit_values,
                    init: CommitDecodeAcc { commits: [], refusal: none },
                    f: fn(acc, cv) {
                      decode_commit_step(
                        positions: positions,
                        acc: acc,
                        value: cv,
                        commit_policy: commit_policy,
                      )
                    }
                  ) {
                    CommitDecodeAcc { commits: reversed_commits, refusal: commit_refusal } =>
                      match commit_refusal {
                        Present { value: c } => RepositoryDecodeRefused { cause: c }
                        Absent =>
                          match resolve_pending_commits(
                            store: store,
                            pending: reverse(reversed_commits),
                            next_ordinal: next_ordinal,
                          ) {
                            ResolvedCommitAcc { commits: commits, seen: _, refusal: resolve_refusal } =>
                              match resolve_refusal {
                                Present { value: c } => RepositoryDecodeRefused { cause: c }
                                Absent =>
                                  decode_repository_selections(
                                    v: v,
                                    store: store,
                                    positions: positions,
                                    commits: commits,
                                    next_ordinal: next_ordinal,
                                    policy: policy,
                                  )
                              }
                          }
                      }
                  }
                MemberString { value: _ } => RepositoryDecodeRefused { cause: RepositoryMemberReadRefused { cause: MemberReadWrongShape { key: "commits" } } }
                MemberObject { value: _ } => RepositoryDecodeRefused { cause: RepositoryMemberReadRefused { cause: MemberReadWrongShape { key: "commits" } } }
              }
              }
              }
              }
          }
}


// ------------------------------------------------------------------------------------------------
// Publication standing
// ------------------------------------------------------------------------------------------------

// THE SECOND FORMAT'S CLASSIFIER, AND IT WAS MISSING RATHER THAN UNNECESSARY.
//
// gunbc.scm.commit_closure_json_v2 and gunbc.scm.object_table_json each classify their own refusals
// into the format-agnostic vocabulary; this document format did not, so any consumer deciding what to
// do with a refused repository load had to reach into RepositoryDecodeRefusal and assign a standing
// itself -- one format's error enum answering a format-agnostic question, which is the placement
// defect that closed gunbc#8940 and the reason gunbc.scm.load_standing exists at all. Found by
// auditing every route into the supersession decision rather than by a failure, because a missing
// classifier fails silently: nothing refuses, the consumer simply invents the answer.
//
// EVERY ARM DESCENDS TO THE AUTHORITY THAT OWNS ITS CAUSE. The closure-document arm delegates to that
// format's own classifier; the member-read and target-reference arms descend per cause in place,
// because gunbc.scm.json_member and gunbc.scm.target_reference carry no classifier of their own. A
// bare binding in a payload-carrying arm is the tell DESIGN names for "total at the level examined,
// blind one level down", so a new cause in either population fails to compile HERE.
//
// THE TARGET-REFERENCE ARM CARRIES A MemberReadRefusal OF ITS OWN, and it was the one place that
// claim was false: TargetReferenceMemberReadRefused was matched with a bare payload binding while the
// sibling member-read arm descended the identical population a few lines above. Both now descend, so
// the four member-read causes are enumerated wherever they are reached rather than only where they
// arrive undecorated.
//
// THE IDENTITY RULE IS A PROTOCOL FACT, NOT DAMAGE, and this is the arm most likely to be got wrong.
// A document naming an identity rule this build does not implement is bytes that may be perfectly
// good and unreadable ONLY HERE -- the same shape as an unrecognized format tag. Calling it malformed
// would let an older reader destroy a newer writer's repository over a rule it simply lacks, which is
// the one outcome the standing vocabulary exists to prevent.
//
// THE TWO ANCESTRY ARMS WERE ADDED BY INTEGRATION, NOT BY EITHER SIDE, and they are classified here
// rather than left to the merge because a textually clean merge is what produced the gap. This
// classifier landed on main total over the refusal population as it stood; the ancestry decode landed
// on a branch that widened that population by two. Neither change is wrong and neither touched the
// other's lines, so git merged both and the exhaustive match silently stopped being exhaustive --
// the obligation is created by the integration itself. It surfaces loudly because the match descends,
// which is the property the paragraph above was written to defend, now with a receipt.
//
// BOTH ARE MALFORMED RATHER THAN UNSUPPORTED, and the cyclic one is the arm worth stating a reason
// for. An unresolved parent reference is a document naming a commit it does not contain, which is the
// same damage the root and checkout arms above already carry. A cycle is NOT a rule a newer writer
// might legitimately implement and this build might lack: acyclicity is a substrate law, so no
// conforming writer emits one at any version. Classifying it as unsupported would tell a reader to
// stand aside for a document that is damaged, which inverts the remedy.
// THE PROTOCOL STANDING IS PROJECTED HERE BECAUSE THE FORMAT IS OWNED HERE. A surface that has to
// tell an operator "this build does not read your repository's format" needs the DECLARED TAG, and the
// only honest source of it is the module that decides formats. Duplicating a tag table in a renderer
// or a CLI would be a second authority for the same fact, and it would drift the moment a version
// moves -- which is exactly the event that makes anyone need this projection.
//
// IT IS NOT `LoadStanding`, and the difference is the point. `repository_envelope_load_standing`
// answers what a CONSUMER MAY DO -- LoadUnsupportedProtocol equally covers an unrecognized tag and a
// retired one, and that is correct for permission. It cannot answer WHAT TO SAY, because "a format
// this build has never heard of" and "the format this repository was written in, which this build has
// retired" have different remedies: one is someone else's document, the other is your own repository
// and a reader you no longer have.
//
// THE FAMILY IS EVERY PROTOCOL-SHAPED REFUSAL, NOT ONLY THE TWO FORMAT ONES. An earlier cut carried
// retired and unrecognized-format and swept everything else into one arm, which put
// `RepositoryIdentityRuleUnrecognized` -- a document whose FORMAT this build reads, declaring an
// identity rule it does not -- in with ordinary schema failures, so a surface rendered it as "not a
// repository document". That is the same discard one member along, and the identity rule is versioned
// on its own axis precisely so it can move without the format moving.
//
// THIS PROJECTION ANSWERS WHICH PROTOCOL FACT THE DECODER OBSERVED. IT ESTABLISHES NOTHING ABOUT THE
// BODY. `decode_repository` reads the format member and returns before any body validation, so
// `{"format": "gunbc-scm-repository-v3"}` -- no identity rule, no objects, no commits -- reaches
// `RepositoryProtocolRetiredFormat` exactly like a complete historical document. A consumer may
// therefore say WHICH PROTOCOL WAS DECLARED and that this build has no reader for it; it may NOT say
// the document is intact, that a repository is present, or that any history exists. Recovering those
// would require reading the retired format, which is the thing deliberately not shipped.
//
// The last arm is a wildcard and means only "not one of the protocol facts above". It does NOT mean
// foreign, non-repository, or validated -- a consumer inferring provenance from it would be reading a
// negative as evidence about content.
type RepositoryDocumentProtocol
  = RepositoryProtocolRetiredFormat { found: String }
  | RepositoryProtocolUnrecognizedFormat { found: String }
  | RepositoryProtocolUnrecognizedIdentityRule { found: String }
  | RepositoryProtocolIndexHasNoObjectRoster { found: String }
  | RepositoryProtocolNotAProtocolRefusal

fn repository_document_protocol(cause: RepositoryDecodeRefusal) -> RepositoryDocumentProtocol {
  match cause {
    RepositoryFormatRetired { found: f } => RepositoryProtocolRetiredFormat { found: f }
    RepositoryFormatUnrecognized { found: f } => RepositoryProtocolUnrecognizedFormat { found: f }
    RepositoryIdentityRuleUnrecognized { found: f } =>
      RepositoryProtocolUnrecognizedIdentityRule { found: f }
    RepositoryDecodeObjectTableRefused { cause: _ } => RepositoryProtocolNotAProtocolRefusal
    RepositoryShardedIndexIsNotWhole { found: _ } => RepositoryProtocolNotAProtocolRefusal
    RepositoryShardNotDecodable { detail: _ } => RepositoryProtocolNotAProtocolRefusal
    RepositoryIndexHasNoObjectRoster { found: f } => RepositoryProtocolIndexHasNoObjectRoster { found: f }
    RepositoryObjectRosterMalformed { detail: _ } => RepositoryProtocolNotAProtocolRefusal
    RepositoryMemberReadRefused { cause: _ } => RepositoryProtocolNotAProtocolRefusal
    RepositoryCommitRootReferenceUnresolved { reference: _ } => RepositoryProtocolNotAProtocolRefusal
    RepositoryCommitRootNotInObjectTable { root: _ } => RepositoryProtocolNotAProtocolRefusal
    RepositoryCommitRootIsAuthoredSource { root: _ } => RepositoryProtocolNotAProtocolRefusal
    RepositoryCommitRootIsSemanticNode { root: _ } => RepositoryProtocolNotAProtocolRefusal
    RepositoryDecodedManifestSourceIsSemanticNode { source: _ } => RepositoryProtocolNotAProtocolRefusal
    RepositoryDecodedManifestSourceIsCorpusManifest { source: _ } => RepositoryProtocolNotAProtocolRefusal
    RepositoryDecodedTargetIsAuthoredSource { target: _ } => RepositoryProtocolNotAProtocolRefusal
    RepositoryDecodedTargetIsCorpusManifest { target: _ } => RepositoryProtocolNotAProtocolRefusal
    RepositoryStagedReferenceUnresolved { reference: _ } => RepositoryProtocolNotAProtocolRefusal
    RepositoryStagedNotInObjectTable { staged: _ } => RepositoryProtocolNotAProtocolRefusal
    RepositoryStagedIsAuthoredSource { staged: _ } => RepositoryProtocolNotAProtocolRefusal
    RepositoryStagedIsSemanticNode { staged: _ } => RepositoryProtocolNotAProtocolRefusal
    RepositoryCheckoutReferenceUnresolved { reference: _ } => RepositoryProtocolNotAProtocolRefusal
    RepositoryCommitReferenceDuplicatedOnWire { reference: _ } => RepositoryProtocolNotAProtocolRefusal
    RepositoryCommitParentNotPreviouslyAdmitted { parent: _ } => RepositoryProtocolNotAProtocolRefusal
    RepositoryCommitIntegrationSourceNotPreviouslyAdmitted { source: _ } => RepositoryProtocolNotAProtocolRefusal
    RepositoryDecodedCommitReferenceOutsideAllocator { reference: _, next_ordinal: _ } => RepositoryProtocolNotAProtocolRefusal
    RepositoryUnexpectedMember { context: _, key: _ } => RepositoryProtocolNotAProtocolRefusal
    RepositoryTargetReferenceRefused { cause: _ } => RepositoryProtocolNotAProtocolRefusal
  }
}

fn repository_envelope_load_standing(cause: RepositoryDecodeRefusal) -> LoadStanding {
  match cause {
    RepositoryFormatUnrecognized { found: _ } => LoadUnsupportedProtocol
    RepositoryFormatRetired { found: _ } => LoadUnsupportedProtocol
    RepositoryShardedIndexIsNotWhole { found: _ } => LoadUnsupportedProtocol
    RepositoryShardNotDecodable { detail: _ } => LoadDocumentMalformed
    RepositoryIndexHasNoObjectRoster { found: _ } => LoadUnsupportedProtocol
    RepositoryObjectRosterMalformed { detail: _ } => LoadDocumentMalformed
    RepositoryIdentityRuleUnrecognized { found: _ } => LoadUnsupportedProtocol
    RepositoryDecodeObjectTableRefused { cause: c } => object_table_load_standing(cause: c)
    RepositoryMemberReadRefused { cause: c } =>
      match c {
        MemberReadSubjectNotObject => LoadDocumentMalformed
        MemberReadMissing { key: _ } => LoadDocumentMalformed
        MemberReadDuplicated { key: _ } => LoadDocumentMalformed
        MemberReadWrongShape { key: _ } => LoadDocumentMalformed
      }
    RepositoryTargetReferenceRefused { cause: c } =>
      match c {
        TargetReferenceMemberReadRefused { cause: m } =>
          match m {
            MemberReadSubjectNotObject => LoadDocumentMalformed
            MemberReadMissing { key: _ } => LoadDocumentMalformed
            MemberReadDuplicated { key: _ } => LoadDocumentMalformed
            MemberReadWrongShape { key: _ } => LoadDocumentMalformed
          }
        TargetReferenceUnexpectedMember { key: _ } => LoadDocumentMalformed
        TargetReferenceNotOneArm { found: _ } => LoadDocumentMalformed
        TargetReferenceUncontainedDigestInvalid { found: _ } => LoadDocumentMalformed
      }
    RepositoryCommitRootReferenceUnresolved { reference: _ } => LoadDocumentMalformed
    RepositoryCommitRootNotInObjectTable { root: _ } => LoadDocumentMalformed
    RepositoryCommitRootIsAuthoredSource { root: _ } => LoadDocumentMalformed
    RepositoryCommitRootIsSemanticNode { root: _ } => LoadDocumentMalformed
    RepositoryDecodedManifestSourceIsSemanticNode { source: _ } => LoadRequirementAtWrongKind
    RepositoryDecodedManifestSourceIsCorpusManifest { source: _ } => LoadRequirementAtWrongKind
    RepositoryDecodedTargetIsAuthoredSource { target: _ } => LoadRequirementAtWrongKind
    RepositoryDecodedTargetIsCorpusManifest { target: _ } => LoadRequirementAtWrongKind
    RepositoryStagedReferenceUnresolved { reference: _ } => LoadDocumentMalformed
    RepositoryStagedNotInObjectTable { staged: _ } => LoadDocumentMalformed
    RepositoryStagedIsAuthoredSource { staged: _ } => LoadDocumentMalformed
    RepositoryStagedIsSemanticNode { staged: _ } => LoadDocumentMalformed
    RepositoryCheckoutReferenceUnresolved { reference: _ } => LoadDocumentMalformed
    RepositoryCommitReferenceDuplicatedOnWire { reference: _ } => LoadDocumentMalformed
    RepositoryCommitParentNotPreviouslyAdmitted { parent: _ } => LoadDocumentMalformed
    RepositoryCommitIntegrationSourceNotPreviouslyAdmitted { source: _ } => LoadDocumentMalformed
    RepositoryDecodedCommitReferenceOutsideAllocator { reference: _, next_ordinal: _ } => LoadDocumentMalformed
    RepositoryUnexpectedMember { context: _, key: _ } => LoadDocumentMalformed
  }
}

// THE FOUR REFUSALS ARE DISTINGUISHED BECAUSE THEY HAVE DIFFERENT REMEDIES AND DIFFERENT BLAME.
// Collapsing them into one "no base" arm would be the absorbing fallback DESIGN section 5 names: a
// failure arm must refuse, never widen, and a widened arm destroys the signal that would rank the
// precise deficit for repair. An unwalkable history is damage to be investigated; an already-consumed
// source is an unsupported OPERATION on an intact repository; disjoint histories are two repositories
// that never shared anything. Those are three different conversations with the operator.
//
// THE CONSUMED ARM CARRIES ALL THREE SIDES OF THE JOIN, and that is not diagnostic garnish. Without
// the recording commit the operator cannot tell WHICH earlier squash is responsible; without the
// anchor they cannot tell WHICH source state was consumed; without the current source they cannot
// tell whether they asked for a replay or a continuation. A reader given only "no base" would
// reasonably conclude the histories are unrelated, which is the opposite of the truth -- they are
// related by an integration that already happened.
// A BASE THAT IS THE SOURCE MEANS THE SOURCE IS ALREADY IN THE TARGET'S HISTORY, AND IT IS ITS OWN
// REFUSAL.
//
// THE FIRST SPELLING OF THIS ARM FORKED A WORD THIS SUBSYSTEM HAD ALREADY SPENT. It was
// `MergeBaseSourceAlreadyIntegrated`, sitting directly beside `MergeBaseSourceAlreadyConsumed`, where
// "integrated" already names ONE mechanism: the explicit `SquashIntegrated` receipt a squash writes.
// This arm fires for an ordinary ancestor/descendant chain carrying no receipt at all, so the name
// gave one word two mechanisms in adjacent arms of one type -- the meaning fork section 3 forbids,
// and the more dangerous direction of it, because a reader who trusts the name looks for a receipt
// that does not exist. The name now states the structural fact: the source is an ancestor of the
// target. Found by external review, on this arm's first appearance.
//
// Two degenerate topologies reach it: merging a commit into ITSELF, where the nearest common ancestor
// of one chain with itself is that commit; and squashing an ANCESTOR into its own descendant, where
// the ancestor is already the base. Both used to derive a base and merge cleanly -- the source side
// carries no changes against a base that IS the source, so the algebra returned the target's own
// entries, and the verb minted a child whose root equals its parent's root.
//
// THAT IS WORSE THAN AN EMPTY COMMIT, and the receipt is why. The mint also writes a
// `SquashIntegrated { source }`, which is exactly the row `consumed_join` reads to refuse a LATER
// merge of that source. So merging a branch into itself, or re-merging an ancestor, silently spent
// the source: the no-op is recorded as an integration, and the honest merge that follows is refused
// by a receipt for work that never happened. The write path already refuses a commit that freezes
// nothing (`gunbc.scm.write_spine`); the merge path did not, and nothing joined the two rules.
//
// Found by probing degenerate topology after external review asked whether the seals held there.
// THE SUCCESSFUL OUTCOME CARRIES THE THREE RESOLVED ROWS, NOT THE BASE REFERENCE ALONE.
//
// A consumer of a derived base needs the same three commits this function has just proven present:
// `squash_merge` read each side's manifest and, to do so, looked each reference up AGAIN in the very
// commit list this module walked -- and carried a commit-missing arm for an answer its own success
// had already excluded. That is the `callee_arm_carried_past_its_exclusion` shape, and the repair is not to translate the arm but
// to make the question ABSENT downstream by handing back what was found.
//
// THE ROWS ARE FREE HERE AND NOWHERE ELSE. `commits` is in scope; the walks proved target and source
// resolve; the base is in BOTH traced chains, so it is a member of this history by construction. A
// consumer holding only references cannot re-establish any of that without asking again.
//
// THE ANCHORS CARRY PRESENCES RATHER THAN BARE ROWS, so membership is a value the envelope issued and
// not a property a later caller must re-establish. That is what lets the store-and-basis transition
// mint a consumption receipt without asking again whether these commits exist. Holding the envelope
// rather than a bare commit list does NOT give this module store-based refusals: a presence reads the
// commit population only.
//
// THIS MODULE DOES NOT RESOLVE MANIFESTS. Carrying resolved MANIFESTS
// instead of rows was the alternative, and it would give a function that answers "what is the base"
// a store dependency and refusal reasons about manifest integrity, which is a different question with
// different blame. The rows carry `root`, so the consumer that DOES own the store resolves manifests
// itself and keeps its own wrong-kind refusals, which are real and stay.
// THE ANCHORS CARRY THE REPOSITORY THEY WERE RESOLVED AGAINST, so no consumer ever holds a repository
// beside them. Three presences establish membership in SOME repository; the one they were looked up in
// is the fact that makes them mean anything, and leaving it out is what forced every downstream seal to
// take a repository as a peer -- reintroducing exactly the mis-pairing the presences were sealed to
// prevent. It is set once, by the resolution that performed the lookups. DESIGN 5: the invalid pairing
// has no constructor rather than a check.
//
// WHAT THIS DOES AND DOES NOT ESTABLISH, because the boundary is easy to overstate and I did.
// I described this as "a foreign reference refuses rather than resolving". That is FALSE.
// `RepositoryCommitRef` wraps a `MintedId`, which is an ORDINAL allocated per repository, so a
// reference taken from another repository is not detectably foreign at all: ordinal N exists here too,
// and it resolves -- to a different commit. Nothing refuses.
//
// What the carrier establishes is narrower and is the part that matters for the seal: all three
// presences are looked up in ONE repository and are carried beside the repository they were looked up
// in, so no downstream consumer can pair them with a different one. Cross-repository substitution INTO
// the anchors is unconstructible. A caller naming the WRONG commits of the right repository is a
// different failure, it is not detectable from an ordinal, and this type does not claim to catch it.
//
// THE ARITY IS A CENSUS RESULT, NOT THE INVARIANT -- stated because the next reader will otherwise
// preserve the wrong property. That every function in `gunbc.scm.staging` takes one argument is an
// observation about today's code, not the rule. A one-argument function can still accept a forgeable
// plain product, and a multi-argument function may legitimately consume genuinely independent facts.
// The load-bearing property is that every same-module route to a sealed constructor derives the
// related fields FROM ONE OBSERVED AUTHORITY rather than from independently sourced peers. Ruled by
// external review, which narrowed both of these claims after I made them too strong.
type ResolvedMergeAnchors sole_constructor {
  repository: RepositoryEnvelope
  base: CommitPresence
  source: CommitPresence
  target: CommitPresence
}

// THE REFUSALS ARE THEIR OWN TYPE BECAUSE A CONSUMER DOWNSTREAM OF THE DERIVATION CARRIES ONLY THEM.
// `squash_merge` runs the derived arm itself and re-wraps only the four refusals, so a
// `SquashMergeBaseRefused` carrying the whole outcome admitted `MergeBaseDerived`, a state no
// execution of that verb constructs -- the `callee_arm_carried_past_its_exclusion` shape, found by
// external review on this stack for the sixth time. Splitting the derivation's ANSWER from its
// REFUSALS is what makes the downstream arm unconstructible rather than merely unreachable
// (DESIGN 4b rung 4), and it is not a duplication: the four arms have one home, here.
type MergeBaseRefusal
  = MergeBaseSourceIsAncestorOfTarget {
      target: RepositoryCommitRef,
      source: RepositoryCommitRef,
    }
  | MergeBaseSourceAlreadyConsumed {
      recorded_at: RepositoryCommitRef,
      consumed: RepositoryCommitRef,
      source: RepositoryCommitRef,
    }
  | MergeBaseHistoryUnwalkable { side: MergeBaseSide, walk: AncestryWalk }
  | MergeBaseHistoriesDisjoint { target: RepositoryCommitRef, source: RepositoryCommitRef }

type MergeBaseOutcome
  = MergeBaseDerived { anchors: ResolvedMergeAnchors }
  | MergeBaseNotDerived { refusal: MergeBaseRefusal }

// WHICH SIDE FAILED IS PART OF THE FACT, not a detail a renderer may add. "The target history is
// broken" and "the source history is broken" send an operator to different repositories.
type MergeBaseSide
  = MergeBaseTargetSide
  | MergeBaseSourceSide

type ConsumedJoin
  = ConsumedJoinFound { recorded_at: RepositoryCommitRef, consumed: RepositoryCommitRef }
  | ConsumedJoinNone

// THE JOIN IS DESCENT, NOT EQUALITY, and one predicate covers both replay and continuation because
// they are the same question asked of different points in one lineage. `source_chain` is the current
// source's ancestry INCLUDING the source itself -- ancestry_walk's chain is descendant-first and
// starts at the walked commit -- so `chain_contains` answers "equals or descends from" in one read.
//
// An equality-only predicate would admit any descendant of a consumed source, which is exactly the
// continued-branch form of the resurrection defect. A root-keyed predicate would admit a descendant
// whose content changed AND refuse an independent history that coincided in content. Both wrong
// implementations are refuted by executed controls rather than by this paragraph; see
// gunbc.test.claim.scm.scm_merge_base_witness_test.
fn consumed_join_step(
  commits: List<RepositoryCommit>,
  source_chain: List<RepositoryCommitRef>,
  found: ConsumedJoin,
  target_commit_ref: RepositoryCommitRef,
) -> ConsumedJoin {
  match found {
    ConsumedJoinFound { recorded_at: _, consumed: _ } => found
    ConsumedJoinNone =>
      match commit_at_reference(commits: commits, reference: target_commit_ref) {
        Absent => found
        Present { value: c } =>
          match c.integration {
            NoSquashIntegration => found
            SquashIntegrated { source: anchor } =>
              if chain_contains(chain: source_chain, target: anchor) {
                ConsumedJoinFound { recorded_at: target_commit_ref, consumed: anchor }
              } else {
                found
              }
            SquashIntegratedSuperseding { source: anchor, supersedes: _ } =>
              if chain_contains(chain: source_chain, target: anchor) {
                ConsumedJoinFound { recorded_at: target_commit_ref, consumed: anchor }
              } else {
                found
              }
          }
      }
  }
}

fn consumed_join(
  commits: List<RepositoryCommit>,
  target_chain: List<RepositoryCommitRef>,
  source_chain: List<RepositoryCommitRef>,
) -> ConsumedJoin {
  fold(target_chain, init: ConsumedJoinNone, f: fn(found, t) {
    consumed_join_step(
      commits: commits,
      source_chain: source_chain,
      found: found,
      target_commit_ref: t,
    )
  })
}

// THE FIRST COMMON REFERENCE WALKING THE TARGET CHAIN FROM ITS TIP. The chain is descendant-first, so
// the first target ancestor that also appears in the source chain is the nearest common ancestor --
// no ordering fact is invented, because "nearer" here means "fewer edges from the target tip", which
// is the order the walk already produced.
fn nearest_common_step(
  source_chain: List<RepositoryCommitRef>,
  found: RepositoryCommitRef?,
  candidate: RepositoryCommitRef,
) -> RepositoryCommitRef? {
  match found {
    Present { value: _ } => found
    Absent =>
      if chain_contains(chain: source_chain, target: candidate) {
        Present { value: candidate }
      } else {
        none
      }
  }
}

fn nearest_common_ancestor(
  target_chain: List<RepositoryCommitRef>,
  source_chain: List<RepositoryCommitRef>,
) -> RepositoryCommitRef? {
  fold(target_chain, init: none, f: fn(found, t) {
    nearest_common_step(source_chain: source_chain, found: found, candidate: t)
  })
}

// THE ANCHOR CONSTRUCTION IS INLINE, BECAUSE A PUBLIC RESOLVER WAS A BYPASS AROUND THIS FUNCTION.
//
// `resolve_merge_anchors(repository, base, source, target)` USED TO STAND BESIDE THIS ONE, taking three
// bare references and minting `MergeBaseDerived` once all three were merely PRESENT. `.dag` has no
// module privacy, so it was reachable directly -- and a caller reaching it could nominate any present
// commit as the "base", replay a source this target had already consumed, or pair tips whose histories
// never meet, and still receive the success carrier. Every question that makes a base legitimate --
// `consumed_join` and `nearest_common_ancestor` -- lives HERE and was skipped entirely.
//
// Sealing `ResolvedMergeAnchors` did not prevent that: the seal restricts WHICH MODULE may construct
// the value, and the bypass was in the same module. A caller's intended sequencing is not a constraint
// on a helper's public domain. Found by external review, one round after the seal was added -- the
// third time in this stack that a wall has been placed where the door was not.
//
// So the presences are resolved in the ADMITTED BRANCH and nowhere else. There is no longer a function
// that turns raw references into anchors, so the only route to `MergeBaseDerived` runs through the
// consumed join and the common-ancestor search above it (DESIGN 4b: construction over validation).

fn merge_base(
  repository: RepositoryEnvelope,
  target: RepositoryCommitRef,
  source: RepositoryCommitRef,
) -> MergeBaseOutcome {
  let commits = repository.commits
  let history = repository_history(commits: commits)
  match ancestry_walk(start: target, history: history) {
    AncestryTraced { chain: target_chain } =>
      match ancestry_walk(start: source, history: history) {
        AncestryTraced { chain: source_chain } =>
          match consumed_join(
            commits: commits,
            target_chain: target_chain,
            source_chain: source_chain,
          ) {
            ConsumedJoinFound { recorded_at: r, consumed: c } =>
              MergeBaseNotDerived {
                refusal: MergeBaseSourceAlreadyConsumed {
                  recorded_at: r,
                  consumed: c,
                  source: source,
                },
              }
            ConsumedJoinNone =>
              match nearest_common_ancestor(target_chain: target_chain, source_chain: source_chain) {
                Present { value: base } =>
                  if repository_commit_ref_eq(left: base, right: source) {
                    MergeBaseNotDerived {
                      refusal: MergeBaseSourceIsAncestorOfTarget { target: target, source: source },
                    }
                  } else {
                    match admit_commit_presence(repository: repository, reference: base) {
                      Absent =>
                        MergeBaseNotDerived {
                          refusal: MergeBaseHistoryUnwalkable {
                            side: MergeBaseTargetSide,
                            walk: AncestryStartNotInHistory { start: base },
                          },
                        }
                      Present { value: base_at } =>
                        match admit_commit_presence(repository: repository, reference: source) {
                          Absent =>
                            MergeBaseNotDerived {
                              refusal: MergeBaseHistoryUnwalkable {
                                side: MergeBaseSourceSide,
                                walk: AncestryStartNotInHistory { start: source },
                              },
                            }
                          Present { value: source_at } =>
                            match admit_commit_presence(repository: repository, reference: target) {
                              Absent =>
                                MergeBaseNotDerived {
                                  refusal: MergeBaseHistoryUnwalkable {
                                    side: MergeBaseTargetSide,
                                    walk: AncestryStartNotInHistory { start: target },
                                  },
                                }
                              Present { value: target_at } =>
                                MergeBaseDerived {
                                  anchors: ResolvedMergeAnchors {
                                    repository: repository,
                                    base: base_at,
                                    source: source_at,
                                    target: target_at,
                                  },
                                }
                            }
                        }
                    }
                  }
                Absent =>
                  MergeBaseNotDerived {
                    refusal: MergeBaseHistoriesDisjoint { target: target, source: source },
                  }
              }
          }
        other =>
          MergeBaseNotDerived {
            refusal: MergeBaseHistoryUnwalkable { side: MergeBaseSourceSide, walk: other },
          }
      }
    other =>
      MergeBaseNotDerived {
        refusal: MergeBaseHistoryUnwalkable { side: MergeBaseTargetSide, walk: other },
      }
  }
}
