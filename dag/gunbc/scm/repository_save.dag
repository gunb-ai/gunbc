module gunbc.scm.repository_save

// WRITING A REPOSITORY TO A PATH, WITH THE ADJUDICATION AHEAD OF THE WRITE.
//
// The mirror of `gunbc.scm.repository_load`, split from it for the reason `extdeps.languages.json`
// splits `parse` from `emit`: reading and writing are two directions of one grammar, not one
// operation with a mode flag. They fail differently and are consumed separately -- a caller that
// only loads must not link a writer.
//
// THIS MODULE EXISTS BECAUSE `encode_repository` CANNOT REFUSE. It returns a JsonValue, so its only
// honest treatment of an unrepresentable repository is an empty reference that `decode_repository`
// rejects later. `repository_envelope`'s header states the consequence, the whole reason this
// module calls the CHECKED encoder: by the time an unrepresentable repository is caught on load,
// the bytes are on disk, the write has reported success, and the corruption surfaces to WHOEVER
// LOADS IT rather than whoever caused it. Lifting the adjudication ahead of the write keeps the
// fault with its author.
//
// SO THE ORDER IS LOAD-BEARING, NOT INCIDENTAL: encode-checked, THEN write. No arm in this type
// reports a write for a repository that failed adjudication, because no such call is made -- the
// refusal returns before `Filesystem.Write` is reached. That is the construction form of the rule
// (DESIGN section 5), not a check that the write was skipped.
//
// THE THREE ARMS HAVE TWO DIFFERENT OWNERS, the same discipline the load side carries:
//
//   save refused by codec  the CALLER's fact about the VALUE. This repository cannot be written by
//                          any writer to any path: a commit root absent from the store, a checkout
//                          selecting a commit that is not there. Changing the path does not help.
//   file unwritable        the HOST's fact about the PATH. The repository is well-formed; the
//                          directory is missing, or read-only, or the disk is full. Changing the
//                          path may well help.
//
// Collapsing them would tell a caller to fix their repository when their directory is read-only,
// or to check permissions when their repository is inconsistent. Opposite remedies, as on the load
// side.
//
// EVERY ARM CARRIES THE PATH, as the load arms do: a refusal that does not say what it was writing
// is not located.
//
// NOT `WriteOwnerOnly`. A repository document is not a secret, and narrowing its mode here would be
// a deployment policy fact smuggled into the persistence operation -- the layer inversion DESIGN
// section 3 names. A caller with a confidentiality requirement states it; this module does not
// decide it on their behalf.

import std.types { String, Int, Bool }
import extdeps.filesystem.filesystem_io
import extdeps.filesystem.filesystem_io {
  FilesystemReadSucceeded,
  FilesystemReadRefused,
  filesystem_read_outcome,
}
import extdeps.filesystem.filesystem_io { FilesystemEstablishedAbsence, filesystem_established_absence_path }
import extdeps.languages.json.emit { serialize_json }
import std.measure { ByteSize, byte_size }
import std.checked_arithmetic { nat_magnitude }
import gunbc.scm.repository_envelope {
  RepositoryEnvelope,
  RepositoryEncodeOutcome,
  RepositoryEncoded,
  RepositoryEncodeRefused,
  RepositoryEncodeRefusal,
  encode_repository_checked,
}

// THE BYTE COUNT IS A MAGNITUDE, NOT A NUMBER, and it is carried as one. `ByteSize` is
// `std.measure`'s `Measure<Memory, One, Nat>`, the single authority for a quantity of bytes, so
// this row reuses the magnitude the repository already models rather than a bare `Int` whose unit
// lives only in a field name. The raw scalar is legitimate at the `extdeps.filesystem` boundary
// under cited-spec fidelity -- the host really does report an `Int` -- and what the rule forbids
// is propagating it inward, the step this type used to take (review 56828).
//
// AND THE CROSSING REFUSES RATHER THAN CLAMPS, which is why there is a fourth arm. `ByteSize`
// counts a `Nat`, the host reports an `Int`, and the only available crossing
// (`std.checked_arithmetic` `nat_magnitude`) takes an ABSOLUTE VALUE -- applied to a negative it
// would turn a nonsense report into a plausible byte count, the fabricated-plausible-output
// failure in one line. So the negative is refused as its own arm carrying what the host said, and
// `nat_magnitude` is applied only on the non-negative domain where it is the identity. A boundary
// obligation (DESIGN section 4b): external reality observed, typed, and admitted or refused -- not
// a class on the ladder, so no next-rung trigger.
//
// NO WITNESS COVERS THAT FOURTH ARM AND THAT IS A LIMIT, NOT AN OVERSIGHT. Reaching it requires a
// host write that SUCCEEDS and then reports a negative count, which no substrate-only fixture can
// author -- this module's witness is `SubstrateInputsOnly`, and a real write refuses at the
// hermetic boundary before any count is produced. So the arm is reachable by the mechanism and
// unreachable by any input this repository can currently express. It is kept because the
// alternative is not "no arm" but `nat_magnitude` silently turning the negative into a byte
// count; deleting the arm would delete the refusal, not the case.
type RepositorySave
  = RepositorySaved { path: String, written: ByteSize }
  | RepositorySaveRefusedByCodec { path: String, cause: RepositoryEncodeRefusal }
  | RepositoryFileUnwritable { path: String, error: String }
  | RepositoryWriteByteCountUnrepresentable { path: String, reported: Int }

// CREATING A REPOSITORY IS NOT SAVING ONE, AND THE DIFFERENCE IS THE WRITE ITSELF.
//
// save_repository writes unconditionally, which is correct for its subject: persisting a repository
// that already exists must replace the bytes that are there. Initialization is the opposite subject
// -- it must happen ONLY where nothing exists -- and for a long time it was expressed as "observe an
// absence, then call save_repository". That is two operations with a gap, and an actor creating the
// file in the gap makes the save truncate exactly the bytes the observation was taken to protect.
// The observation was honest; the write was not conditioned on it.
//
// No re-observation closes that. The fix is that the existence test and the creation become ONE act,
// which is what Filesystem.WriteCreateNew provides -- so this function refuses a path that exists
// rather than checking whether it exists. Construction over validation (DESIGN section 5) at a
// boundary where validation structurally cannot win.
//
// The refusal reuses RepositoryFileUnwritable rather than minting a create-specific arm: the caller's
// remedy is the same -- the bytes are not yours to write and the host says why -- and the error text
// is the host's own. A second arm would be a second spelling of one outcome (section 3), and one that
// classified the cause from the error TEXT would be a heuristic standing in for an observation.
// THE CREATE THAT AN ESTABLISHED ABSENCE AUTHORIZES, AND THE ONLY ONE IT CAN.
//
// create_repository below takes a bare String, which is right for its own subject -- a caller that
// has some other reason to create at a path may use it. It is the WRONG entry for a caller whose
// permission came from an absence, because taking the token and a separate path lets the two name
// different subjects and nothing detects it. Review on gunbc#10026 found exactly that: init matched
// ScmInitMayCreate(_), threw the token away, and wrote to an independently computed path.
//
// So the absence-authorized create derives its target from the token itself. There is no second
// target to disagree with, which is the difference between a capability that is CONSUMED and one
// that is merely carried past the actuation.
fn create_repository_at_absence(
  absence: FilesystemEstablishedAbsence,
  repo: RepositoryEnvelope,
) -> RepositorySave {
  create_repository(path: filesystem_established_absence_path(absence: absence), repo: repo)
}

fn create_repository(path: String, repo: RepositoryEnvelope) -> RepositorySave {
  match encode_repository_checked(repo: repo) {
    RepositoryEncodeRefused { cause: cause } =>
      RepositorySaveRefusedByCodec { path: path, cause: cause }
    RepositoryEncoded { value: v } => {
      let write = Filesystem.WriteCreateNew(path: path, content: serialize_json(v: v))
      if !write.success {
        RepositoryFileUnwritable { path: path, error: write.error }
      } else if write.bytes_written < 0 {
        RepositoryWriteByteCountUnrepresentable { path: path, reported: write.bytes_written }
      } else {
        RepositorySaved { path: path, written: byte_size(count: nat_magnitude(a: write.bytes_written)) }
      }
    }
  }
}

fn save_repository(path: String, repo: RepositoryEnvelope) -> RepositorySave {
  match encode_repository_checked(repo: repo) {
    RepositoryEncodeRefused { cause: cause } =>
      RepositorySaveRefusedByCodec { path: path, cause: cause }
    RepositoryEncoded { value: v } => {
      let write = Filesystem.Write(path: path, content: serialize_json(v: v))
      if !write.success {
        RepositoryFileUnwritable { path: path, error: write.error }
      } else if write.bytes_written < 0 {
        RepositoryWriteByteCountUnrepresentable { path: path, reported: write.bytes_written }
      } else {
        RepositorySaved { path: path, written: byte_size(count: nat_magnitude(a: write.bytes_written)) }
      }
    }
  }
}

// ------------------------------------------------------------------------------------------------
// Conditional publication
// ------------------------------------------------------------------------------------------------

// PUBLISHING A CHANGE TO A DOCUMENT SOMEONE ELSE MAY ALSO BE CHANGING.
//
// save_repository above is correct for its subject and wrong for this one. Its write is
// unconditional, which is what "persist this repository" means; but "persist this repository AS A
// CHANGE TO THE ONE I READ" is a different operation, and performing it with an unconditional write
// is the lost update:
//
//   A loads document D          B loads document D
//   A derives D + stage a       B derives D + commit c
//   A writes                    B writes
//   -> whichever writes second silently discards the other's work, and reports success
//
// Nothing here is malformed, so nothing refuses; the losing author is told their operation
// succeeded. That is the fabricated-plausible-output failure at a persistence boundary.
//
// THE FIX IS NOT A RE-READ BEFORE THE WRITE, and that is the trap this construction exists to avoid.
// Read-then-write is two operations with the race living between them, so the check can be satisfied
// while the property fails -- and a check that can be satisfied without its property holding is worse
// than none, because it gets cited as coverage (DESIGN section 4b). `create_repository` above shows
// the shape that works: it does not observe an absence and then write, it uses
// Filesystem.WriteCreateNew so the test and the creation are ONE act.
//
// SO THE CONDITION IS ESTABLISHED BY EXCLUSION, NOT BY OBSERVATION. WriteCreateNew publishes a path
// only where none existed, so creating a sibling lock path SUCCEEDS FOR EXACTLY ONE WRITER and fails
// for every other -- a right to publish established the way a document is.
//
// AND THAT EXCLUSION IS THE OPERATION'S, NOT AN `O_EXCL` OPEN OF THE LOCK PATH. This note said the
// latter and it is wrong about the landed handler:
// extdeps.filesystem.rust_realization rust_file_write_create_new_fn_def exclusively allocates a
// PRIVATE STAGING file, writes it, calls sync_all, and then publishes it to the target with
// std::fs::hard_link. The exclusive open and the create-only publication are two different steps, and
// the property this construction depends on comes from the second. Citing the shorthand instead of
// the producer is how a claim about a mechanism drifts from the mechanism. Inside that exclusion the expected-value comparison is no longer racing a
// protocol-following writer, because there is no protocol-following writer to race: the interval
// between the comparison and the write is covered by the exclusion that opened it. This is the
// mechanism git uses for the same problem, and it is available here where a conditional replace is
// not: extdeps.filesystem.filesystem_io declares Write, WriteOwnerOnly, WriteCreateNew, Read, Delete
// and List, and NO rename -- so the other standard construction, write-a-temp-then-atomically-rename,
// cannot be spelled at all.
//
// WHAT THIS DOES NOT ESTABLISH, STATED RATHER THAN IMPLIED. Two residual gaps survive and neither is
// closed by anything above:
//
//   a writer that does not take the lock   Filesystem.Write remains callable, and save_repository
//                                          itself is one such writer. Exclusion binds participants,
//                                          so this is a protocol and not a wall. RUNG: mitigatable.
//   a lock left behind by a crash          the lock is a file, and a process that dies holding one
//                                          leaves it. This module will not break such a lock: a
//                                          stale lock and a live one are indistinguishable from
//                                          here, and breaking on a guess is exactly the confidence
//                                          threshold DESIGN section 5 calls a smuggled heuristic. It
//                                          refuses and names the lock path, which is actionable.
//   A TORN DOCUMENT                        THE EXCLUSION DOES NOT MAKE THE WRITE ATOMIC, and this is
//                                          a SEPARATE property from the race, not a consequence of
//                                          closing it. Filesystem.Write replaces contents in place,
//                                          so a process that dies partway through leaves bytes that
//                                          are neither the old document nor the new one -- and no
//                                          reader, holding no lock, can tell that from corruption.
//                                          Old-or-new publication needs write-elsewhere-then-
//                                          atomically-rename, and there is no rename to call. The
//                                          lock narrows who can be writing; it does nothing about
//                                          what a half-finished write leaves behind. RUNG:
//                                          mitigatable, by the decode refusing the torn bytes on the
//                                          next load -- which is a loud failure and not a recovery.
//
// SO THE NEXT-RUNG TRIGGER BELOW RETIRES ONE OF THESE AND NOT THE OTHER, and conflating them was the
// first draft's error. A conditional replace closes the race; ATOMIC replacement closes the tear. A
// rename-based publication delivers both, which is why it is named as the capability rather than
// "a conditional write".
//
// NEXT-RUNG TRIGGER, NAMED AS THE CAPABILITY: a filesystem operation that installs a complete
// document at a path AS ONE ACT, and only if the path still holds a value the caller observed --
// reporting the mismatch rather than overwriting, and leaving either the whole old document or the
// whole new one at every instant in between. Both halves are required: the conditional half retires
// the race and the atomic half retires the tear, and a primitive with only one leaves the other
// exactly where it is. It is an extdeps.filesystem capability -- POSIX supplies it as rename(2) over
// a temporary in the same directory -- and not something this module can construct from Write,
// WriteCreateNew, Read, Delete and List.

// THE OUTCOMES A PUBLICATION HAS, AND THEY ARE NOT THE OUTCOMES A SAVE HAS.
//
// `RepositoryPublished` carries the save so a caller reads the byte count and the write's own
// refusals through the one carrier that owns them. The three arms above it are publication's own, and
// each names a different actor:
//
//   lock not established  the exclusive create of the lock path did not succeed. THAT IS ALL IT
//                         SAYS, and the first draft of this arm said more: it was named "lock
//                         unavailable" and its note asserted that another publication holds the
//                         right to write. WriteCreateNew's failure channel cannot establish that.
//                         One failed boolean and one host error string equally cover an existing
//                         lock, a directory that is not writable, a path that does not exist, and a
//                         full disk -- so naming the busy case is the same well-formed-answer-about-
//                         the-wrong-subject this stack has now paid for repeatedly. The arm carries
//                         the lock path and the HOST'S OWN error, and classifying that text would be
//                         a heuristic standing in for an observation the boundary does not offer.
//   stale base            the document changed since it was read. The caller's derivation was made
//                         against bytes that are no longer there, so publishing it would discard
//                         whatever replaced them. The remedy is to re-load and redo the operation.
//   base unreadable       the document could not be read back under the lock at all.
//
// STALE BASE IS NOT A FAILURE OF THE DOCUMENT AND IS NOT REPORTED AS ONE. Both versions are perfectly
// valid repositories; what is invalid is applying a change derived from one on top of the other.
//
// THE LOCK IS RELEASED ON EVERY ARM THAT TOOK IT, and it is released BEFORE the outcome is built
// rather than by a caller, because a caller cannot be relied on to and there is no scope-exit
// construct here to do it. `release_publication_lock` is therefore called on the refusal paths as
// well as the success path, and its own result is deliberately discarded: a failure to delete the
// lock cannot un-publish a write that already happened, so reporting it as the operation's outcome
// would misname a completed publication as a failed one. It leaves a stale lock, which the arm above
// says is refused loudly rather than broken silently.
type RepositoryPublication
  = RepositoryPublished { path: String, save: RepositorySave }
  | PublicationLockNotEstablished { path: String, lock_path: String, error: String }
  | PublicationBaseChanged { path: String }
  | PublicationBaseUnreadable { path: String, error: String }

// THE LOCK PATH IS DERIVED FROM THE DOCUMENT PATH AND IS NOT A PARAMETER. A caller that could choose
// it could choose a different one from the caller it is racing, and the exclusion would exclude
// nobody -- the two publications would each hold their own lock and write the same document. Deriving
// it is what makes "one document, one lock" true by construction.
fn publication_lock_path(path: String) -> String {
  concat(path, ".publishing")
}

data publication_lock_content: String = "gunbc scm publication lock"

fn release_publication_lock(lock_path: String) -> Bool {
  Filesystem.Delete(path: lock_path).success
}

// PUBLISH `repo` TO `path`, BUT ONLY IF `path` STILL HOLDS `expected`.
//
// `expected` is the document the caller decoded its base from, carried here from
// gunbc.scm.repository_load's success arm rather than re-derived. Re-encoding the base envelope to
// produce it would compare this build's rendering of a value against the file, which agrees only by
// assumption -- and the assumption is the thing being checked.
fn publish_repository(path: String, expected: String, repo: RepositoryEnvelope) -> RepositoryPublication {
  let lock_path = publication_lock_path(path: path)
  let lock = Filesystem.WriteCreateNew(path: lock_path, content: publication_lock_content)
  if !lock.success {
    PublicationLockNotEstablished { path: path, lock_path: lock_path, error: lock.error }
  } else {
    publish_under_lock(path: path, lock_path: lock_path, expected: expected, repo: repo)
  }
}

fn publish_under_lock(
  path: String,
  lock_path: String,
  expected: String,
  repo: RepositoryEnvelope,
) -> RepositoryPublication {
  let read = Filesystem.Read(path: path)
  match filesystem_read_outcome(content: read.content, success: read.success, error: read.error) {
    FilesystemReadRefused { error: e } => {
      let _ = release_publication_lock(lock_path: lock_path)
      PublicationBaseUnreadable { path: path, error: e }
    }
    FilesystemReadSucceeded { content: found } =>
      if found != expected {
        let _ = release_publication_lock(lock_path: lock_path)
        PublicationBaseChanged { path: path }
      } else {
        let save = save_repository(path: path, repo: repo)
        let _ = release_publication_lock(lock_path: lock_path)
        RepositoryPublished { path: path, save: save }
      }
  }
}
