module gunbc.scm.commit_closure

// WHAT A COMMIT CLOSURE IS, INDEPENDENT OF HOW IT IS WRITTEN DOWN.
//
// A closure is a set of content-addressed objects plus the root the commit names. That is the whole
// logical content. Positions, JSON, member names and format tags are all facts about ONE WAY of
// writing it down, and none of them belong here -- this module is what every realization must agree
// about, and a realization is chosen beside it, never inside it.
//
// THE PROPERTY THIS MODULE EXISTS TO MAKE REPRESENTABLE, and it is the reason the format it replaces
// had to be recut rather than extended:
//
//   A closure may be INCOMPLETE, and an incomplete closure must be able to NAME WHAT IS MISSING.
//
// The predecessor format could not express that, and not by oversight. It recorded structure only --
// kind, edge labels, and which EARLIER POSITION each edge pointed at -- with every identity re-derived
// on load. A backward position cannot name an object the document does not contain, so an unresolved
// reference named nothing at all and "supply the missing object" was unperformable. The disposition
// was absent BY CONSTRUCTION, not by low population.
//
// WHY THAT FORMAT WAS RIGHT TO DO IT, because the recut gives something up and must say so. Omitting
// identities was a construction wall, not an accident: a decoder is a SECOND PRODUCER, reading
// identities from a file it does not control, and a wire that carries an identity is a wire a decoder
// can lie in. With no such field, forging an identity is not caught -- it is UNWRITABLE. The store
// would otherwise answer for a locator whose payload was never hashed to it, and checkout would
// reconstruct a program the commit never named.
//
// SO THE TWO PROPERTIES ARE ONE DECISION SEEN FROM TWO SIDES:
//
//   unforgeable identity   =>  no identity on the wire
//   nameable absent object =>  an identity on the wire
//
// The recut keeps both by asking what each reference NEEDS to name. A reference to an object the
// document CONTAINS needs no identity -- the object is right there, and its identity is derived from
// its own bytes. Only a reference to an object the document LACKS needs one, and that is the single
// place a digest cannot do the damage the predecessor feared: there is NO PAYLOAD IN THE DOCUMENT for
// a forged digest to be mis-bound to. So the forgeable surface is exactly the set of objects the
// document does not contain -- the set for which forgery has nothing to bind.
//
// THE TRUST ROOT MOVES, AND THIS IS THE HONEST STATEMENT OF WHAT IS WEAKER.
//
// Deriving a supplied object's identity from its own bytes and comparing proves "I got the object THIS
// DOCUMENT NAMED". It does NOT prove "I got the object the COMMIT named" -- a forged uncontained-arm digest
// names an attacker-chosen object, and the supplied impostor matches the forgery exactly because that
// is what was forged. The closure then reconstructs with the impostor in place of the real object: a
// program the commit never named, reached through the very arm this recut adds.
//
// That is closed by ONE CONDITION, stated here as a condition rather than assumed -- and the
// condition is about the LOGICAL ROOT IDENTITY, not about the bytes:
//
//   The root identity DERIVED from contained structure plus uncontained child identities MUST be
//   compared against an expected commit identity the consumer obtains from OUTSIDE the document.
//
// This needs no new machinery, because object_store already derives a record's identity from its
// kind and its children's target identities. An uncontained child contributes its stated digest to
// its parent's derived identity and transitively to the root's, so substituting Hc with Hx changes
// the derived root. A forged document is therefore a document that does not reconstruct to the
// commit you asked for, and the comparison catches it.
//
// WHY NOT HASH THE WIRE BYTES, which was this clause's first form and was wrong. Byte identity makes
// representation detail semantic: the same logical closure emitted with a different object-table
// order, or under a different encoding entirely, would become a DIFFERENT commit. That undoes the
// separation this whole recut exists to make -- the logical closure is the concept, a serialization
// is one way of writing it down. Two identities, kept apart:
//
//   commit identity      = the derived Merkle root over canonical logical structure
//   publication identity = an optional digest of exact publication bytes, for corruption detection
//                          or envelope authentication, and NEVER the semantic commit identity
//
// But note precisely what changed: the predecessor's guarantee was UNCONDITIONAL -- the format had no
// field to lie in -- and this one is CONDITIONAL on an expected commit identity being obtained
// independently. A reader of this format must not inherit the old file's unconditional claim. It is
// strictly weaker, it is the price of being able to name what is missing, and it is paid knowingly.
//
// AND THE RUNG OF THE DIGEST ITSELF IS NOT AUTHENTICATION. ObjectId is fnv1a64 structural. It
// establishes structural consistency and refuses collisions at the current local rung; it is not an
// adversarial or cross-tenant cryptographic commitment, and calling this "Merkle" must not import
// that stronger claim. dissolve-on: a computing cryptographic digest reachable from .dag.

import std.types { Bool, Int, List, list_length }
import gunbc.scm.object_store {
  ObjectId,
  ObjectRecord,
  ScmObject,
  SemanticNodeObject,
  AuthoredSourceObject,
  CorpusManifestObject,
  ObjectStore,
  StoredEdge,
  SemanticNodeTarget,
  NodeRecordLookup,
  NodeRecordFound,
  NodeRecordAbsent,
  NodeRecordIsAuthoredSource,
  CorpusManifestRecord,
  CorpusManifestEntry,
  AuthoredSourceLookup,
  AuthoredSourceFound,
  AuthoredSourceAbsent,
  AuthoredSourceIsSemanticNode,
  AuthoredSourceIsCorpusManifest,
  authored_source_target_locator,
  find_authored_source_record,
  object_id_eq,
  resolve_node_target,
  node_target_locator,
  store_records_in_dependency_order,
}

// WHY AN ADMISSION IS A VALUE AND NOT A FLAG, and this is the difference between moving a wall and
// keeping one.
//
// Before the recut, an incomplete closure COULD NOT BE WRITTEN: the encoder computed which references
// were unresolvable and refused. After the recut it CAN be written -- that is the entire point -- and
// the danger is that the only thing left stopping an accidental partial write is a caller who
// remembers to check. That is validation, and validation of exactly the shape that decays: the
// encoder accepts a closure plus a caller's assurance, and one day the assurance is wrong.
//
// So the uncontained arm is constructible ONLY from an evidenced decision. The arm CARRIES the admission,
// the admission is `sole_constructor` and minted here, and an encoder therefore cannot fabricate one
// to get itself out of trouble -- it has to be HANDED one by whoever decided a partial closure was
// publishable. An undeclared partial closure has no constructor, so it is not refused, it is
// unwritable, which is where the predecessor's guarantee lived too.
//
// THE REVIEW TELL, stated so it can be checked against a later diff: if a consumer of this module
// grows a check that the encoder used to perform, the wall was MOVED rather than kept, and this
// paragraph is the thing that was violated.
// THE RUNG THIS ACTUALLY OCCUPIES, AND IT IS LOWER THAN TWO REVIEWERS READ IT AS.
//
// `sole_constructor` stops a caller writing the RECORD LITERAL. It does not stop a caller calling
// the public mint below, because .dag has no module privacy -- so the token is unforgeable in shape
// and freely OBTAINABLE in practice. Worse, it is not bound to any subject:
//
//   admit closure A  ->  token T
//   encode closure B with T  ->  ACCEPTED
//
// THE ADMISSION IS BOUND TO ITS SUBJECT, and that binding is the whole guarantee.
//
// THE DEFECT THIS REPLACES. The predecessor was PartialClosureAdmission { reason } -- a token minted
// by a public function, carrying no subject. The encoder took a closure PLUS an optional token and
// checked only that a token was PRESENT, never that it was ABOUT the closure being encoded:
//
//     admit closure A -> token T
//     encode closure B with T -> ACCEPTED
//
// That is authority substitution in its exact form: a true admission about one subject answering for
// another because no relation binds them. sole_constructor did not help, because `.dag` has no
// module privacy -- it blocks the record literal while the public mint stays freely callable. And
// the mutation that existed (delete the check) could never have caught it: deleting a check proves
// the check is READ, which a bearer token satisfies perfectly.
//
// WHY THE REPAIR IS A SHAPE, NOT A CHECK. The carrier holds the closure it admits, so the encoder
// takes ONE argument and there is no second closure to disagree with it. "A token for A used on B"
// is not refused at runtime -- it has no spelling. The mismatch is unconstructible rather than
// caught, which is DESIGN section 4b's top rung and the reason no validator appears beside this.
//
// `unresolved` is DERIVED here from the closure rather than supplied, so it cannot disagree with the
// objects it describes; a caller-supplied population would reintroduce the same substitution one
// field down. The mint refuses a COMPLETE closure, because admitting a partial write for something
// with nothing missing is a category error and would make the carrier's own name a lie.
//
// REMAINING RUNG, stated so it is not read as more than it is: `unresolved` is a List, so an EMPTY
// admitted population is representable in the type even though this mint cannot produce one. The
// corpus has no NonEmptyList, and minting one solely for this field would grow net concepts to buy a
// guarantee the mint's refusal already provides -- so the emptiness exclusion sits at mitigatable
// while the SUBJECT BINDING, which is what the defect was about, is structural. Next-rung trigger: a
// NonEmptyList authority earning its place from more than one consumer.
type AdmittedPartialCommitClosure sole_constructor {
  closure: CommitClosure
  unresolved: List<ObjectId>
  reason: PartialClosureReason
  image: WellKindedClosure
}

// THE REFUSALS ARE ARMS OF THE OUTCOME, not a coproduct beside it. The note here used to say there
// was exactly one way to be refused -- the closure has nothing missing -- and predicted that a second
// genuine refusal would join this coproduct and break every match at the use sites. That is exactly
// what happened: a closure requiring a semantic node at a locator an authored source occupies is
// UNSATISFIABLE rather than partial, since no fetch can repair an occupied locator, so admitting it
// would mint a transfer nobody can complete. It names the whole population rather than the first,
// because a caller repairing one and retrying should not have to discover the rest one round at a
// time.
type PartialClosureAdmissionOutcome
  = PartialClosureAdmitted { admitted: AdmittedPartialCommitClosure }
  | ClosureCompleteSoNothingToAdmit
  | ClosureRequiresNodeAtWrongKind {
      source_occupied: List<ObjectId>,
      manifest_occupied: List<ObjectId>
    }

// WHY A CLOSED VOCABULARY RATHER THAN A STRING. A reason nobody can enumerate is a reason nobody can
// refuse, and the two admitted causes have genuinely different owners: one is a transfer decision,
// the other is a graft that object_store deliberately supports.
type PartialClosureReason
  = ClosureTrimmedForTransfer
  | ClosureGraftedWithoutChildren

fn admit_partial_commit_closure(
  closure: CommitClosure,
  reason: PartialClosureReason
) -> PartialClosureAdmissionOutcome {
  match admit_well_kinded_closure(closure: closure) {
    NotWellKinded { source_occupied: sources, manifest_occupied: manifests } =>
      ClosureRequiresNodeAtWrongKind {
        source_occupied: sources,
        manifest_occupied: manifests,
      }
    WellKinded { admitted: image, unresolved: unresolved } =>
      if list_length(items: unresolved) == 0 {
        ClosureCompleteSoNothingToAdmit
      } else {
        PartialClosureAdmitted {
          admitted: AdmittedPartialCommitClosure {
            closure: closure,
            unresolved: unresolved,
            reason: reason,
            image: image,
          }
        }
      }
  }
}

fn admitted_reason(admitted: AdmittedPartialCommitClosure) -> PartialClosureReason {
  admitted.reason
}

fn admitted_closure(admitted: AdmittedPartialCommitClosure) -> CommitClosure {
  admitted.closure
}

fn admitted_unresolved(admitted: AdmittedPartialCommitClosure) -> List<ObjectId> {
  admitted.unresolved
}

// A FIELD READ, NOT A RE-DERIVATION. The image was minted by the one census-guarded literal above
// and carried here, so this cannot answer about a different population than the admission did. It
// used to re-derive, which is what made the guarantee restatable rather than carried.
fn admitted_well_kinded(admitted: AdmittedPartialCommitClosure) -> WellKindedClosure {
  admitted.image
}

// A CLOSURE WHOSE EVERY REQUIREMENT IS SATISFIABLE, WHICH IS NOT THE SAME AS COMPLETE.
//
// The encoder must never see a closure requiring a semantic node where an authored source sits: it
// has no honest spelling for that. Emitting the contained arm publishes bytes the decoder refuses;
// emitting the uncontained arm publishes a fetchable absence that no fetch can repair. Both were
// shipped on this branch in turn, which is why the guarantee is now a CARRIER rather than a check --
// `.dag` has no module privacy, so a judgment written at the two intended entry points leaves the raw
// encoder importable and the bad state perfectly representable through it.
//
// sole_constructor seals it: the only way to obtain one is admit_well_kinded_closure, which runs the
// census. An ABSENT population is fine here and is the partial-closure case the format exists for --
// this carrier is about KIND, not about completeness.
//
// IT CARRIES THE DERIVED POPULATION, NOT THE STORE IT CAME FROM. Holding the store left the encoder
// looking at every object a repository happened to contain, which is how unreachable inventory
// reached a document whose subject is one root -- and once a manifest can sit in a store it is also
// how the encoder would acquire an arm it has no honest way to write. With the nodes derived here,
// the encoder's parameter cannot name a manifest at all: unconstructible rather than validated.
type WellKindedClosure sole_constructor {
  root: SemanticNodeTarget
  nodes: List<ObjectRecord>
}

// THE ADMITTED ARM CARRIES THE UNRESOLVED POPULATION BESIDE THE IMAGE, which is what lets the
// partial admission below delegate here instead of walking the closure a second time. Both facts
// come from ONE derivation of ONE closure, so they cannot disagree; two walks would be the authority
// substitution this carrier exists to remove, and DESIGN section 2 prices the second one as
// redundant regardless of how small the closure happens to be.
//
// UNRESOLVED IS ON THE OUTCOME, NOT ON WellKindedClosure. The carrier is about KIND. A closure with
// an absent child is perfectly well-kinded -- that is the partial-write case the format exists for
// -- so putting completeness inside the carrier would make its name answer a question it does not
// decide.
type WellKindedAdmission
  = WellKinded {
      admitted: WellKindedClosure,
      unresolved: List<ObjectId>
    }
  | NotWellKinded {
      source_occupied: List<ObjectId>,
      manifest_occupied: List<ObjectId>
    }

// ONE REFUSAL ARM CARRYING TWO POPULATIONS, rather than two arms. Splitting by class would make a
// closure that is wrong in both ways report only whichever arm was tested first, so a caller
// repairing one class and retrying would discover the other a round later -- the same objection this
// module already records against naming the first identity instead of the population, one level up.
// THE ONLY PLACE IN THE CORPUS A WellKindedClosure IS BUILT, and the census that authorizes it is
// in the same expression as the literal.
//
// THIS REPLACES A PUBLIC well_kinded_image(closure) THAT RAN NO CENSUS. sole_constructor stops a
// caller writing the record literal, and `.dag` has no module privacy, so that helper was a freely
// callable mint for the exact state the carrier exists to exclude -- the bearer-token defect this
// module already records, one level down, in the function that was supposed to have fixed it. The
// repair is the same repair: there is no mint to call, because the literal never leaves the branch
// its evidence guards.
fn admit_well_kinded_closure(closure: CommitClosure) -> WellKindedAdmission {
  let derived = derive_semantic_closure(store: closure.store, root: closure.root)
  if list_length(items: wrong_kind_identities(census: derived.census)) > 0 {
    NotWellKinded {
      source_occupied: derived.census.source_occupied,
      manifest_occupied: derived.census.manifest_occupied,
    }
  } else {
    WellKinded {
      admitted: WellKindedClosure { root: closure.root, nodes: derived.nodes },
      unresolved: derived.census.absent,
    }
  }
}

// NOT well_kinded_store. A store-shaped name over a List<ObjectRecord> would say the carrier still
// holds a store, and a consumer that genuinely needs an ObjectStore should have to say so rather
// than receive a narrower thing under the old name.
fn well_kinded_nodes(admitted: WellKindedClosure) -> List<ObjectRecord> {
  admitted.nodes
}

fn well_kinded_root(admitted: WellKindedClosure) -> SemanticNodeTarget {
  admitted.root
}

// A closure is the store plus the root the commit names. Nothing about how it is written down.
type CommitClosure {
  store: ObjectStore
  root: SemanticNodeTarget
}

// WHY THE WIRE ARM IS "UNCONTAINED" AND THIS FUNCTION SAYS "UNRESOLVED", which is not two names for
// one thing (DESIGN section 3) but two different facts one join apart.
//
// CONTAINED / UNCONTAINED is INTRINSIC to the document: it states whether this document carries the
// object's payload, and that is true of the bytes forever, wherever they are read. UNRESOLVED is
// RELATIVE: it is what you get by joining an uncontained identity against the store you actually
// have. An object this document does not carry may already sit in the local store, in another
// generation, in a cache, or at a remote -- so it is uncontained here and not unresolved for you.
//
// Naming the wire arm "absent" would have frozen a relative availability observation into immutable
// vocabulary, which is exactly the state-space conflation that makes a reader draw "missing" from a
// document that only ever said "not carried here".
//
//   uncontained identities  +  the store you have  ->  unresolved identities
//
// THE ACCEPTANCE TEST OF THE WHOLE RECUT, in one function.
//
// This is what the predecessor could not have at any price: the set of object identities the closure
// REFERS TO and DOES NOT CONTAIN. Each is a content address, so each names exactly what to fetch.
// A backward position could never appear in this list, because a position that does not resolve
// inside the document denotes nothing outside it.
//
// An EMPTY list is the complete closure. That is the ordinary case and it is not a special arm --
// completeness is "nothing is missing", derived, never a stored flag that could disagree with the
// objects beside it.

// TABLE COMPLETENESS WITHOUT A ROOT, because two different consumers ask two different questions and
// only one of them has a root to ask about.
//
// A COMMIT closure asks "is anything this program reaches missing", which includes its own root. A
// REPOSITORY object table asks only "does any edge point at a record this table does not hold" --
// it carries many commits over one population, so there is no single root and the roots it does
// have are checked separately against the commit list. Folding the root into this would have forced
// the repository to invent one.
// UNCONTAINED TARGETS ACCUMULATE BY PREPEND AND ARE REVERSED ONCE, the same idiom this stack applies
// in commit_closure_json_v2 encode_step and in repository_envelope's commit fold. It is restated at
// the third site because the first two were not enough: this module documented the rule and then
// reintroduced the shape it forbids, which is the §6 point exactly -- fixing a cost shape where a
// review names it is not the same as not having the defect, and the sweep has to cover every
// accumulator a change introduces.
//
// BOTH LEVELS WERE QUADRATIC, and the inner one is why the per-record helper takes the caller's
// accumulator instead of returning a fresh list. Building a list per record and joining it at the
// top copies the whole accumulator once per RECORD; prepending each child onto the single threaded
// accumulator copies nothing at either level, and one linear reverse at the top restores authored
// order exactly.
//
// THE REVERSE IS LOAD-BEARING, AND THAT SENTENCE COST A MEASUREMENT RATHER THAN AN ASSERTION. An
// earlier revision of this comment claimed order was already observed and named two existing claims
// as the evidence. It was false: names_exactly is a MEMBERSHIP fold and every closure fixture
// asserted exactly ONE missing identity, and a one-element list reversed is itself. Dropping the
// reverse was measured to leave every claim in the file green. The claim that holds it up is
// two_uncontained_children_are_named_in_order, written for this and verified both ways -- with the
// reverse exit=0, without it exit=1.
//
// The realized n is not the argument. A delta encoder folds this over the whole store, and DESIGN §6
// rejects "n is small here" as a non-time-stable fact: reuse is what changes n.

// AN AUTHORED SOURCE HAS NO OUTBOUND REFERENCES, so it contributes nothing to the unresolved set --
// and that is a fact about its shape rather than a skip. Writing it as a match makes the reason
// visible at the site: a later object kind that DOES carry references cannot be added without this
// fold refusing to compile, whereas a filter on "is it a node" would silently ignore it.

// A REQUIREMENT IS UNSATISFIED FOR ONE OF TWO REASONS, AND THEY HAVE DIFFERENT REMEDIES.
//
// This fold used to ask store_contains_node_target, a Bool, and treat every false as a fetchable
// absence. That merged "no object is at L" with "an authored source is at L" -- states whose remedies
// are not merely different but incompatible. An absence is repaired by fetching the object. An
// occupied locator cannot be repaired by fetching anything: something is already there, and it is the
// wrong kind. Putting the second into the population every consumer reads as fetchable is what let an
// admitted partial closure emit bytes this same build refuses at decode, because the encoder's
// position index is over OBJECTS and happily found the file to emit a contained reference to.
//
// So the traversal classifies rather than tests, and the two populations stay apart all the way up.
//
// A THIRD POPULATION, FOR THE SAME REASON THERE WAS A SECOND. `source_occupied` exists because "no
// object is at L" and "an authored source is at L" have incompatible remedies. A CORPUS MANIFEST at
// L is a third such state, and folding it into `source_occupied` would report a manifest as a file:
// a well-formed answer of the right type and the wrong meaning, which is the exact class this
// module's history is made of. The refusal names what it actually found.
type ClosureCensus {
  absent: List<ObjectId>
  source_occupied: List<ObjectId>
  manifest_occupied: List<ObjectId>
}

fn empty_census() -> ClosureCensus {
  ClosureCensus { absent: [], source_occupied: [], manifest_occupied: [] }
}

// Both lists accumulate by prepend and are reversed once at the top, the idiom this module already
// documents for store_census and then had to be reminded of twice.
fn census_of_target(store: ObjectStore, acc: ClosureCensus, target: SemanticNodeTarget) -> ClosureCensus {
  match resolve_node_target(store: store, target: target) {
    NodeRecordFound(_) => acc
    NodeRecordAbsent { identity: identity } =>
      ClosureCensus {
        absent: concat([identity], acc.absent),
        source_occupied: acc.source_occupied,
        manifest_occupied: acc.manifest_occupied,
      }
    NodeRecordIsAuthoredSource { identity: identity } =>
      ClosureCensus {
        absent: acc.absent,
        source_occupied: concat([identity], acc.source_occupied),
        manifest_occupied: acc.manifest_occupied,
      }
    NodeRecordIsCorpusManifest { identity: identity } =>
      ClosureCensus {
        absent: acc.absent,
        source_occupied: acc.source_occupied,
        manifest_occupied: concat([identity], acc.manifest_occupied),
      }
  }
}

// THE ONE DERIVATION AUTHORITY, and the reason it is one rather than two.
//
// A commit closure is the population ROOT-REACHABLE from its root, not every object its store
// happens to hold. Those coincided only while nothing produced unreachable objects, which is exactly
// the condition this codec's predecessor recorded as its own dissolution trigger; a corpus manifest
// is the event that makes it false. A repository holding an unrelated manifest must still be able to
// publish the closure rooted at P, so "a manifest exists in the store" is not a fact about P.
//
// WHAT COMES BACK IS NODES ONLY, AND THAT IS A DISCOVERY RATHER THAN A NARROWING FOR CONVENIENCE.
// Starting from a SemanticNodeTarget every traversable edge is again a SemanticNodeTarget -- an
// ObjectRecord carries a kind and children and nothing else -- so there is no typed path from a
// commit root to an authored source. The authored sources that used to appear in these documents
// were never reachable content; they were repository inventory arriving through an encoder that
// serialized the whole store. A coproduct with an authored-source arm here would be uninhabited, and
// an uninhabited arm is decoration.
//
// The wrong-kind populations survive that narrowing and are not in tension with it: they are facts
// encountered WHILE DERIVING the closure, at required node positions, rather than members of it.
//
// VISITED COVERS ALL THREE OUTCOMES, not just the found ones. Keying only on admitted nodes would
// re-classify a shared child once per parent, so a diamond over one absent object would report that
// object twice and every consumer counting the population would be off by the graph's shape.
type ClosureWalk {
  nodes: List<ObjectRecord>
  visited: List<ObjectId>
  census: ClosureCensus
}

fn walk_visited(acc: ClosureWalk, identity: ObjectId) -> Bool {
  fold(
    acc.visited,
    init: false,
    f: fn(seen, seen_id) { seen || object_id_eq(left: seen_id, right: identity) }
  )
}

// CHILDREN BEFORE THE PARENT THAT NAMES THEM, appended in that order for the same reason
// emit_in_dependency_order appends: a decoder assigning positions as it reads must have seen every
// referenced object before the reference. BOTH LISTS PREPEND AND THE NODES ARE REVERSED ONCE at the
// derivation, the corpus idiom -- appending copied the whole accumulator on every step, which bought
// the emitted order with a quadratic that one linear reverse gets for free. `visited` is never
// reversed because nothing reads its order; it answers a membership question only.
//
// WHAT REMAINS QUADRATIC IS THE MEMBERSHIP TEST, not the list construction, and the two are separate
// defects that were previously stated as one. `walk_visited` is a linear scan, so the walk is still
// quadratic in the reachable count; that one is retired by a keyed collection and not by an
// accumulator idiom.
fn walk_target(store: ObjectStore, acc: ClosureWalk, target: SemanticNodeTarget) -> ClosureWalk {
  let locator = node_target_locator(target: target)
  if walk_visited(acc: acc, identity: locator) {
    acc
  } else {
    let seen = ClosureWalk {
      nodes: acc.nodes,
      visited: concat([locator], acc.visited),
      census: acc.census,
    }
    match resolve_node_target(store: store, target: target) {
      NodeRecordFound(record) =>
        match fold(
          record.children,
          init: seen,
          f: fn(inner, child) { walk_target(store: store, acc: inner, target: child.target) }
        ) {
          after =>
            ClosureWalk {
              nodes: concat([record], after.nodes),
              visited: after.visited,
              census: after.census,
            }
        }
      NodeRecordAbsent { identity: identity } =>
        ClosureWalk {
          nodes: seen.nodes,
          visited: seen.visited,
          census: ClosureCensus {
            absent: concat([identity], seen.census.absent),
            source_occupied: seen.census.source_occupied,
            manifest_occupied: seen.census.manifest_occupied,
          },
        }
      NodeRecordIsAuthoredSource { identity: identity } =>
        ClosureWalk {
          nodes: seen.nodes,
          visited: seen.visited,
          census: ClosureCensus {
            absent: seen.census.absent,
            source_occupied: concat([identity], seen.census.source_occupied),
            manifest_occupied: seen.census.manifest_occupied,
          },
        }
      NodeRecordIsCorpusManifest { identity: identity } =>
        ClosureWalk {
          nodes: seen.nodes,
          visited: seen.visited,
          census: ClosureCensus {
            absent: seen.census.absent,
            source_occupied: seen.census.source_occupied,
            manifest_occupied: concat([identity], seen.census.manifest_occupied),
          },
        }
    }
  }
}

type SemanticClosureDerivation {
  nodes: List<ObjectRecord>
  census: ClosureCensus
}

fn derive_semantic_closure(
  store: ObjectStore,
  root: SemanticNodeTarget
) -> SemanticClosureDerivation {
  match walk_target(
    store: store,
    acc: ClosureWalk { nodes: [], visited: [], census: empty_census() },
    target: root
  ) {
    walk =>
      SemanticClosureDerivation {
        nodes: reverse(walk.nodes),
        census: ClosureCensus {
          absent: reverse(walk.census.absent),
          source_occupied: reverse(walk.census.source_occupied),
          manifest_occupied: reverse(walk.census.manifest_occupied),
        },
      }
  }
}

fn census_in_record(store: ObjectStore, acc: ClosureCensus, record: ObjectRecord) -> ClosureCensus {
  fold(
    record.children,
    init: acc,
    f: fn(inner, child) { census_of_target(store: store, acc: inner, target: child.target) }
  )
}

fn census_in_object(store: ObjectStore, acc: ClosureCensus, object: ScmObject) -> ClosureCensus {
  match object {
    AuthoredSourceObject(_) => acc
    CorpusManifestObject(_) => acc
    SemanticNodeObject(record) => census_in_record(store: store, acc: acc, record: record)
  }
}

fn store_census(store: ObjectStore) -> ClosureCensus {
  match fold(
    store_records_in_dependency_order(store: store),
    init: empty_census(),
    f: fn(acc, object) { census_in_object(store: store, acc: acc, object: object) }
  ) {
    ClosureCensus { absent: a, source_occupied: w, manifest_occupied: m } =>
      ClosureCensus {
        absent: reverse(a),
        source_occupied: reverse(w),
        manifest_occupied: reverse(m),
      }
  }
}

// THE ROOT IS A REQUIREMENT LIKE ANY OTHER, so it is classified by the same three-way resolve. A
// closure whose store does not hold its own root is the sharpest incompleteness there is; a closure
// whose root locator holds a FILE is not incomplete at all, it is wrong-kind, and the two must not
// arrive at the caller as one list.
// THE CLOSURE'S CENSUS IS THE DERIVATION'S CENSUS, AND ASKING IT ANY OTHER WAY IS A SECOND
// AUTHORITY. It used to be the whole store's census concatenated with the root's, which counted
// requirements of objects the root cannot reach and counted the root's own requirements twice over
// where the root was also a table entry. Both are gone: there is one walk, from the root, and every
// population reported here was encountered on it.
fn closure_census(closure: CommitClosure) -> ClosureCensus {
  derive_semantic_closure(store: closure.store, root: closure.root).census
}

// THE TABLE'S OWN QUESTION, WITHOUT A ROOT, because two consumers ask two different things and only
// one of them has a root to ask about. A COMMIT closure asks "is anything this program reaches
// missing", which includes its own root. A REPOSITORY object table carries many commits over one
// population, so it has no single root and checks its roots separately against the commit list.
//
// This replaces uncontained_targets, which answered one list. It answers the absent population only,
// for the same reason unresolved_identities does: a locator occupied by the wrong kind is not
// something the repository can fetch, and reporting it here would put it back into the population
// whose whole meaning is "get these and the table completes".
// ── THE OTHER REQUIREMENT A STORE CARRIES, AND IT IS NOT A SEMANTIC ONE ──
//
// ClosureCensus answers "does a semantic child requirement resolve to a node". A MANIFEST ENTRY
// states a different requirement about a different kind: an authored source must sit at this
// locator. Nothing censused it, and the consequence was a false absence rather than a loud refusal:
// encode_source_target asks the source index, and a locator occupied by a NODE is simply missing
// from that index, so the writer emitted `uncontained` -- a fetchable absence for a locator that is
// occupied and can never be repaired by fetching. The per-kind index made the CONTAINED half
// unwritable; this census is what makes the UNCONTAINED half honest.
//
// THREE POPULATIONS, AND ABSENCE IS DELIBERATELY NOT ONE OF THE REFUSALS. A manifest naming a source
// this store does not carry is a legitimate partial corpus, exactly as an absent semantic child is a
// legitimate partial closure. What may not happen is a WRONG KIND arriving in that absent
// population, which is the conflation this separates.
type ManifestSourceCensus {
  absent: List<ObjectId>
  node_occupied: List<ObjectId>
  manifest_occupied: List<ObjectId>
}

fn empty_manifest_source_census() -> ManifestSourceCensus {
  ManifestSourceCensus { absent: [], node_occupied: [], manifest_occupied: [] }
}

fn manifest_source_census_of_entry(
  store: ObjectStore,
  acc: ManifestSourceCensus,
  entry: CorpusManifestEntry
) -> ManifestSourceCensus {
  let identity = authored_source_target_locator(target: entry.source)
  match find_authored_source_record(store: store, identity: identity) {
    AuthoredSourceFound(_) => acc
    AuthoredSourceAbsent { identity: absent_identity } =>
      ManifestSourceCensus {
        absent: concat([absent_identity], acc.absent),
        node_occupied: acc.node_occupied,
        manifest_occupied: acc.manifest_occupied,
      }
    AuthoredSourceIsSemanticNode { identity: occupied } =>
      ManifestSourceCensus {
        absent: acc.absent,
        node_occupied: concat([occupied], acc.node_occupied),
        manifest_occupied: acc.manifest_occupied,
      }
    AuthoredSourceIsCorpusManifest { identity: occupied } =>
      ManifestSourceCensus {
        absent: acc.absent,
        node_occupied: acc.node_occupied,
        manifest_occupied: concat([occupied], acc.manifest_occupied),
      }
  }
}

fn manifest_source_census_in_object(
  store: ObjectStore,
  acc: ManifestSourceCensus,
  object: ScmObject
) -> ManifestSourceCensus {
  match object {
    SemanticNodeObject(_) => acc
    AuthoredSourceObject(_) => acc
    CorpusManifestObject(record) =>
      fold(
        record.entries,
        init: acc,
        f: fn(inner, entry) {
          manifest_source_census_of_entry(store: store, acc: inner, entry: entry)
        }
      )
  }
}

fn manifest_source_census(store: ObjectStore) -> ManifestSourceCensus {
  match fold(
    store_records_in_dependency_order(store: store),
    init: empty_manifest_source_census(),
    f: fn(acc, object) { manifest_source_census_in_object(store: store, acc: acc, object: object) }
  ) {
    ManifestSourceCensus { absent: a, node_occupied: n, manifest_occupied: m } =>
      ManifestSourceCensus {
        absent: reverse(a),
        node_occupied: reverse(n),
        manifest_occupied: reverse(m),
      }
  }
}

fn table_manifest_source_node_occupied_identities(store: ObjectStore) -> List<ObjectId> {
  manifest_source_census(store: store).node_occupied
}

fn table_manifest_source_manifest_occupied_identities(store: ObjectStore) -> List<ObjectId> {
  manifest_source_census(store: store).manifest_occupied
}

fn table_unresolved_identities(store: ObjectStore) -> List<ObjectId> {
  store_census(store: store).absent
}

fn table_source_occupied_identities(store: ObjectStore) -> List<ObjectId> {
  store_census(store: store).source_occupied
}

fn table_manifest_occupied_identities(store: ObjectStore) -> List<ObjectId> {
  store_census(store: store).manifest_occupied
}

// THE FETCHABLE POPULATION IS THE ABSENT ONE, AND ONLY THE ABSENT ONE. Every consumer of this list
// treats membership as "get this object and the closure completes"; a wrong-kind locator would make
// that false, so it is not here.
fn unresolved_identities(closure: CommitClosure) -> List<ObjectId> {
  closure_census(closure: closure).absent
}

fn source_occupied_identities(closure: CommitClosure) -> List<ObjectId> {
  closure_census(closure: closure).source_occupied
}

fn manifest_occupied_identities(closure: CommitClosure) -> List<ObjectId> {
  closure_census(closure: closure).manifest_occupied
}

// EVERY WRONG-KIND IDENTITY, WHICH IS WHAT AN ADMISSION REFUSES ON -- as distinct from either
// population alone, which is what a consumer repairing one class at a time asks for.
fn wrong_kind_identities(census: ClosureCensus) -> List<ObjectId> {
  concat(census.source_occupied, census.manifest_occupied)
}

// COMPLETE MEANS EVERY REQUIREMENT IS SATISFIED, which is both populations empty. A closure whose
// root or child locator holds a file is not complete -- it is not even partial, since nothing can be
// fetched to finish it.
fn closure_is_complete(closure: CommitClosure) -> Bool {
  let census = closure_census(closure: closure)
  (list_length(items: census.absent) == 0)
    && (list_length(items: wrong_kind_identities(census: census)) == 0)
}
