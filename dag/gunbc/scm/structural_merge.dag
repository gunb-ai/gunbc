module gunbc.scm.structural_merge

import std.types { Bool, Int, String, List }

import v2.std.node {
  Node,
  NodeKind,
  Edge,
  EdgeLabel,
  Named,
  Positional,
  Symbol,
  Hash,
  node_synthetic,
  content_hash,
  symbol_identity_digest,
}

import gunbc.scm.object_store {
  ObjectId,
  ObjectStore,
  StoreResult,
  store_node,
  object_id_eq,
}
import gunbc.scm.checkout {
  Commit,
  commit_of_root,
  checkout,
  CheckedOut,
  CheckoutRefused,
  CheckoutRefusal,
}

// THIS IS THE SLICE THAT EARNS THE SUBSTRATE. Slices 1 and 2 gave commits an identity and gave two
// of them a decision, but at whole-program grain: if both sides changed anything, somebody had to
// choose. That is no better than a file-grain tool, because "the file" and "the program" are just
// two sizes of the same blunt unit.
//
// Here the decision descends. Two people who edited DIFFERENT named children of one node both land,
// with no choice asked of anyone, because the disagreement is located at the child that actually
// disagrees rather than at the largest thing containing it. That is not a smarter diff -- there is
// no diff. It is the same three-identity comparison slice 2 already made, applied at every named
// edge instead of only at the root.
//
// WHY NAMED EDGES ONLY, AND WHY THE POSITIONAL CASE REFUSES. A named edge says what a child IS, so
// two sides can be compared at it without inventing a correspondence. Positional children carry no
// such statement: matching left's third child to right's third child is an ALIGNMENT guess, and a
// guess that silently succeeds is exactly the fabricated plausible output DESIGN §5 forbids. So a
// node whose children are positional, where all three sides moved, refuses with a typed reason and
// asks for a choice. It does NOT fall back to whole-node grain quietly -- that would be the
// absorbing fallback wearing a different hat, and it would zero the frequency of the very deficit
// that tells us positional alignment needs modeling.
//
// COST SHAPE, stated rather than discovered later: the descent recomputes `content_hash` on each
// subtree it compares, so it is O(size x depth) rather than O(size). It is not a copied accumulator
// or a quadratic fold -- the walk visits each node once per level of its own depth -- but it is
// above the floor, and the fix is a hash memo keyed on the node, which is the Realization pattern
// DESIGN §2 already names. dissolve-on: v2.std.node carrying a memoized structural hash.

type MergePath {
  segments: List<Symbol>
}

fn root_path() -> MergePath { MergePath { segments: [] } }

fn extend_path(path: MergePath, segment: Symbol) -> MergePath {
  MergePath { segments: concat(path.segments, [segment]) }
}

// EVERY ARM NAMES A DIFFERENT DISAGREEMENT. A single "conflict" would be the state-space conflation
// DESIGN's failure-mode list warns about: a deleted-versus-edited child and two independently added
// children are different situations with different remedies, and collapsing them means the caller
// cannot tell which one they are looking at.
type ChoiceReason
  = BothSidesChangedOneChild
  | OneSideDeletedWhatTheOtherChanged
  | BothSidesAddedDifferentContent
  | KindsDisagree
  | PositionalChildrenAreNotStructurallyMergeable

type NodeMergeOutcome
  = NodeMerged { node: Node }
  | NodeChoiceRequired { path: MergePath, reason: ChoiceReason }

fn symbol_eq(left: Symbol, right: Symbol) -> Bool {
  symbol_identity_digest(sym: left).digest == symbol_identity_digest(sym: right).digest
}

fn node_id(n: Node) -> ObjectId { content_hash(n: n) }

fn node_eq(left: Node, right: Node) -> Bool {
  object_id_eq(left: node_id(n: left), right: node_id(n: right))
}

// A node's KIND is compared through the same identity authority as everything else: the identity of
// that kind carrying no children. Nothing here mints a second notion of "same kind".
fn kind_id(kind: NodeKind) -> ObjectId {
  content_hash(n: node_synthetic(kind: kind, children: []))
}

fn kinds_agree(base: Node, left: Node, right: Node) -> Bool {
  object_id_eq(left: kind_id(kind: base.kind), right: kind_id(kind: left.kind))
    && object_id_eq(left: kind_id(kind: base.kind), right: kind_id(kind: right.kind))
}

fn edge_is_named(e: Edge) -> Bool {
  match e.label {
    Named { name: _ } => true
    Positional => false
  }
}

fn all_edges_named(children: List<Edge>) -> Bool {
  fold(children, init: true, f: fn(acc, e) { acc && edge_is_named(e: e) })
}

fn edge_has_name(e: Edge, name: Symbol) -> Bool {
  match e.label {
    Positional => false
    Named { name: n } => symbol_eq(left: n, right: name)
  }
}

fn find_child(children: List<Edge>, name: Symbol) -> Node? {
  fold(children, init: none, f: fn(acc, e) {
    if edge_has_name(e: e, name: name) { Present { value: e.target } } else { acc }
  })
}

fn edge_names(children: List<Edge>) -> List<Symbol> {
  fold(children, init: [], f: fn(acc, e) {
    match e.label {
      Positional => acc
      Named { name: n } => concat(acc, [n])
    }
  })
}

fn names_contains(names: List<Symbol>, name: Symbol) -> Bool {
  fold(names, init: false, f: fn(acc, n) { acc || symbol_eq(left: n, right: name) })
}

// CANONICAL ORDER FOR NEWLY ADDED LABELS. Labels the base already had keep the base's order, so a
// merge that changes nothing about a child cannot renumber it. Labels that BOTH sides added have no
// base order to inherit, and taking them in "left's additions then right's additions" would make the
// merged identity depend on which proposal the caller named first -- an accident of the caller, not
// a fact about the programs. Ordering them by their symbol's own digest is side-independent, so
// swapping the two proposals produces the same bytes.
fn hex_lt_at(a: String, b: String, i: Int) -> Bool {
  if i >= string_length(s: a) {
    false
  } else {
    let ca = code_point_int(ch: char_at(a, i))
    let cb = code_point_int(ch: char_at(b, i))
    if ca < cb { true } else { if ca > cb { false } else { hex_lt_at(a: a, b: b, i: i + 1) } }
  }
}

fn symbol_lt(left: Symbol, right: Symbol) -> Bool {
  hex_lt_at(
    a: symbol_identity_digest(sym: left).digest as String,
    b: symbol_identity_digest(sym: right).digest as String,
    i: 0,
  )
}

fn insert_ordered(sorted: List<Symbol>, name: Symbol) -> List<Symbol> {
  if fold(sorted, init: false, f: fn(acc, n) { acc || symbol_eq(left: n, right: name) }) {
    sorted
  } else {
    let before = fold(sorted, init: [], f: fn(acc, n) {
      if symbol_lt(left: n, right: name) { concat(acc, [n]) } else { acc }
    })
    let after = fold(sorted, init: [], f: fn(acc, n) {
      if symbol_lt(left: n, right: name) { acc } else { concat(acc, [n]) }
    })
    concat(concat(before, [name]), after)
  }
}

fn canonical_additions(base_names: List<Symbol>, side_names: List<Symbol>, seed: List<Symbol>) -> List<Symbol> {
  fold(side_names, init: seed, f: fn(acc, n) {
    if names_contains(names: base_names, name: n) { acc } else { insert_ordered(sorted: acc, name: n) }
  })
}

fn merged_label_order(base: Node, left: Node, right: Node) -> List<Symbol> {
  let base_names = edge_names(children: base.children)
  let additions = canonical_additions(
    base_names: base_names,
    side_names: edge_names(children: right.children),
    seed: canonical_additions(
      base_names: base_names,
      side_names: edge_names(children: left.children),
      seed: [],
    ),
  )
  concat(base_names, additions)
}

// The per-label decision. Its four settled arms are the same three-identity comparison slice 2 makes
// at the root, plus the one genuinely new move: when all three sides have the child and all three
// differ, DESCEND -- the disagreement may be located further down, and refusing here would be
// answering a question we have not asked yet.
type ChildDecision
  = ChildResolved { child: Node? }
  | ChildNeedsChoice { path: MergePath, reason: ChoiceReason }

fn optional_node_eq(left: Node?, right: Node?) -> Bool {
  match left {
    Absent =>
      match right {
        Absent => true
        Present { value: _ } => false
      }
    Present { value: l } =>
      match right {
        Absent => false
        Present { value: r } => node_eq(left: l, right: r)
      }
  }
}

// The first settled arm covers both sides saying the same thing about this label -- INCLUDING both
// having removed it, which is why the comparison is over Node? rather than over nodes.
// What kind of disagreement the last arm reports depends on which of the three sides has the child.
fn merge_child(
  path: MergePath,
  name: Symbol,
  base_child: Node?,
  left_child: Node?,
  right_child: Node?
) -> ChildDecision {
  if optional_node_eq(left: left_child, right: right_child) {
    ChildResolved { child: left_child }
  } else {
    if optional_node_eq(left: base_child, right: left_child) {
      ChildResolved { child: right_child }
    } else {
      if optional_node_eq(left: base_child, right: right_child) {
        ChildResolved { child: left_child }
      } else {
        match base_child {
          Absent =>
            ChildNeedsChoice {
              path: extend_path(path: path, segment: name),
              reason: BothSidesAddedDifferentContent,
            }
          Present { value: b } =>
            match left_child {
              Absent =>
                ChildNeedsChoice {
                  path: extend_path(path: path, segment: name),
                  reason: OneSideDeletedWhatTheOtherChanged,
                }
              Present { value: l } =>
                match right_child {
                  Absent =>
                    ChildNeedsChoice {
                      path: extend_path(path: path, segment: name),
                      reason: OneSideDeletedWhatTheOtherChanged,
                    }
                  Present { value: r } =>
                    match merge_nodes(
                      path: extend_path(path: path, segment: name),
                      base: b,
                      left: l,
                      right: r,
                    ) {
                      NodeMerged { node: merged } => ChildResolved { child: Present { value: merged } }
                      NodeChoiceRequired { path: p, reason: reason } =>
                        ChildNeedsChoice { path: p, reason: reason }
                    }
                }
            }
        }
      }
    }
  }
}

type MergeChildrenAcc {
  edges: List<Edge>
  choice: NodeMergeOutcome?
}

// THE FIRST choice required, in canonical label order, is the one reported, and the fold stops
// deciding after it. Collecting every disagreement would make the reported location depend on how
// many other labels happened to disagree, which is a fact about the fold rather than about the
// programs -- and the caller has to settle this one before the rest are even well posed.
fn merge_children_step(
  path: MergePath,
  base: Node,
  left: Node,
  right: Node,
  acc: MergeChildrenAcc,
  name: Symbol
) -> MergeChildrenAcc {
  match acc.choice {
    Present { value: _ } => acc
    Absent =>
      match merge_child(
        path: path,
        name: name,
        base_child: find_child(children: base.children, name: name),
        left_child: find_child(children: left.children, name: name),
        right_child: find_child(children: right.children, name: name),
      ) {
        ChildNeedsChoice { path: p, reason: reason } =>
          MergeChildrenAcc {
            edges: acc.edges,
            choice: Present { value: NodeChoiceRequired { path: p, reason: reason } },
          }
        ChildResolved { child: child } =>
          match child {
            Absent => acc
            Present { value: kept } =>
              MergeChildrenAcc {
                edges: concat(acc.edges, [Edge { label: Named { name: name }, target: kept }]),
                choice: acc.choice,
              }
          }
      }
  }
}

// When every named child settles, the node is REBUILT from the settled children rather than copied
// from a side, so its identity is derived from what was agreed. That is what makes a combined
// program a first-class program with its own identity instead of a patched copy of one proposal.
fn merge_nodes(path: MergePath, base: Node, left: Node, right: Node) -> NodeMergeOutcome {
  if node_eq(left: left, right: right) {
    NodeMerged { node: left }
  } else {
    if node_eq(left: base, right: left) {
      NodeMerged { node: right }
    } else {
      if node_eq(left: base, right: right) {
        NodeMerged { node: left }
      } else {
        if !kinds_agree(base: base, left: left, right: right) {
          NodeChoiceRequired { path: path, reason: KindsDisagree }
        } else {
          if !(all_edges_named(children: base.children)
                 && all_edges_named(children: left.children)
                 && all_edges_named(children: right.children)) {
            NodeChoiceRequired {
              path: path,
              reason: PositionalChildrenAreNotStructurallyMergeable,
            }
          } else {
            let merged = fold(
              merged_label_order(base: base, left: left, right: right),
              init: MergeChildrenAcc { edges: [], choice: none },
              f: fn(acc, name) {
                merge_children_step(
                  path: path, base: base, left: left, right: right, acc: acc, name: name,
                )
              },
            )
            match merged.choice {
              Present { value: outcome } => outcome
              Absent =>
                NodeMerged {
                  node: node_synthetic(kind: base.kind, children: merged.edges),
                }
            }
          }
        }
      }
    }
  }
}

// THE STORE BOUNDARY. The descent above is pure: it compares and rebuilds Nodes and never touches a
// store. Reading the three programs and writing the merged one happen here, once, at the edges --
// so an incomplete closure is a REFUSAL about the store, kept distinct from a choice required about
// the programs. Those are different states with different remedies, and one arm for both would be
// the state-space conflation DESIGN's failure-mode list names.
type StructuralOutcome
  = StructurallyMerged { root: ObjectId }
  | StructuralChoiceRequired { path: MergePath, reason: ChoiceReason }
  | StructuralRefused { cause: CheckoutRefusal }

type StructuralResult {
  store: ObjectStore
  outcome: StructuralOutcome
}

fn structural_merge(store: ObjectStore, base: Commit, left: Commit, right: Commit) -> StructuralResult {
  match checkout(store: store, commit: base) {
    CheckoutRefused { cause: cause } =>
      StructuralResult { store: store, outcome: StructuralRefused { cause: cause } }
    CheckedOut { program: base_program } =>
      match checkout(store: store, commit: left) {
        CheckoutRefused { cause: cause } =>
          StructuralResult { store: store, outcome: StructuralRefused { cause: cause } }
        CheckedOut { program: left_program } =>
          match checkout(store: store, commit: right) {
            CheckoutRefused { cause: cause } =>
              StructuralResult { store: store, outcome: StructuralRefused { cause: cause } }
            CheckedOut { program: right_program } =>
              match merge_nodes(
                path: root_path(),
                base: base_program,
                left: left_program,
                right: right_program,
              ) {
                NodeChoiceRequired { path: path, reason: reason } =>
                  StructuralResult {
                    store: store,
                    outcome: StructuralChoiceRequired { path: path, reason: reason },
                  }
                NodeMerged { node: merged } => {
                  let written = store_node(store: store, n: merged)
                  StructuralResult {
                    store: written.store,
                    outcome: StructurallyMerged { root: written.identity },
                  }
                }
              }
          }
      }
  }
}
