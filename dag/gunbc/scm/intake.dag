module gunbc.scm.intake

// WHAT A COMMIT TOOK IN FROM OUTSIDE THIS REPOSITORY, AS A TYPED MEMBER OF THE COMMIT.
//
// A repository whose history starts from another system's tree -- the belt seeds a project repository
// from the git revision a dispatch branched from -- has to say WHICH revision each intake froze. Until
// gunbc#13111's follow-up that fact lived in the commit MESSAGE ('project base: <sha>'), a string the
// belt wrote and three belt sites compared by string equality: an untyped carrier for the one fact a
// capture's correctness depends on (gunbc.recurring_failure_mode
// a_worktree_delta_against_one_base_applied_onto_another). It is a member now, beside `integration`,
// and for the same reason `integration` is a member: it records what producing this commit CONSUMED,
// which `ancestry` does not say.
//
// THREE MINTABLE ARMS AND ONE DECODED ONE. `IntakeNone` is an ordinary commit: its root was authored
// here. `IntakeBase` froze an external revision's tree as a root commit. `IntakeAdvance` moved a line
// from one external revision to the next: its root is its parent's root re-bound over exactly the
// external change between the two, so "which base did this line assume" is answered by the nearest
// intake commit on the line, never by a string. `IntakeUnrecordedByFormat` is what a document written
// before the member existed (format v8 and older) says about intake: nothing. It is NOT IntakeNone --
// the v8 belt wrote base commits whose message names a revision, so reading that format's silence as
// "no intake" would assert a fact the document does not carry. Only the decoder produces it, and the
// intake admission in gunbc.scm.repository_envelope refuses it as a mint argument.

import std.types { String, List, Bool }
import extdeps.git.object_store { GitObjectId, git_object_id_eq }
import gunbc.merge_admission_subject { render_git_object_id_wire, parse_git_object_id_wire }
import extdeps.languages.json.emit { JsonValue, JsonNull, JsonBool, JsonNumber, JsonString, JsonArray, JsonObject, json_string, json_object, json_kv }
import gunbc.scm.json_member {
  MemberReadRefusal, MemberReadWrongShape,
  MemberRead, MemberString, MemberArray, MemberObject, MemberFailed,
  read_string_member, unexpected_member_key,
}

// AN EXTERNAL REVISION, ONE ARM PER UPSTREAM SYSTEM. Git is the only one a producer intakes from
// today; its object id is extdeps.git's authority, carried whole (family and digest) rather than as
// hex text, so a sha1 and a sha256 id can never compare equal on spelling.
type IntakeRevision
  = GitIntakeRevision { id: GitObjectId }

type CommitIntake
  = IntakeNone
  | IntakeBase { revision: IntakeRevision }
  | IntakeAdvance { from: IntakeRevision, to: IntakeRevision }
  | IntakeUnrecordedByFormat

fn intake_revision_eq(left: IntakeRevision, right: IntakeRevision) -> Bool {
  match left {
    GitIntakeRevision { id: l } =>
      match right {
        GitIntakeRevision { id: r } => git_object_id_eq(left: l, right: r)
      }
  }
}

// THE REVISION'S OWN WIRE SPELLING IS THE FAMILY-PREFIXED ONE (sha1:<hex>), the repository's rule for
// git ids it writes itself; untagged hex is admitted only for text git itself printed.
fn intake_revision_wire(revision: IntakeRevision) -> String {
  match revision {
    GitIntakeRevision { id } => render_git_object_id_wire(oid: id)
  }
}

fn intake_revision_of_wire(text: String) -> IntakeRevision? {
  match parse_git_object_id_wire(raw: text) {
    Absent => none
    Present { value: id } => Present { value: GitIntakeRevision { id: id } }
  }
}

// THE REVISION A COMMIT LEAVES ITS LINE AT, if it is an intake commit: a base leaves the line at the
// revision it froze, an advance at the revision it moved to. An ordinary commit leaves the line where
// its parent left it, and an unrecorded one cannot say -- the two are kept apart by the caller.
type IntakeLineMark
  = LineMarkedAt { revision: IntakeRevision }
  | LineNotMarked
  | LineMarkUnrecorded

fn intake_line_mark(intake: CommitIntake) -> IntakeLineMark {
  match intake {
    IntakeNone => LineNotMarked
    IntakeBase { revision } => LineMarkedAt { revision: revision }
    IntakeAdvance { from: _, to } => LineMarkedAt { revision: to }
    IntakeUnrecordedByFormat => LineMarkUnrecorded
  }
}

// ------------------------------------------------------------------------------------------------
// Wire (format v9 commit member `intake`)
// ------------------------------------------------------------------------------------------------
//
// JsonNull is the unrecorded arm -- the only spelling a v9 writer has for a commit it carried forward
// from an older document -- and every recorded arm is an object with a closed member set, so damage
// cannot silently become "no intake".

fn encode_commit_intake(intake: CommitIntake) -> JsonValue {
  match intake {
    IntakeUnrecordedByFormat => JsonNull
    IntakeNone => json_object(members: [json_kv(key: "kind", value: json_string(s: "none"))])
    IntakeBase { revision } =>
      json_object(members: [
        json_kv(key: "kind", value: json_string(s: "base")),
        json_kv(key: "revision", value: json_string(s: intake_revision_wire(revision: revision))),
      ])
    IntakeAdvance { from, to } =>
      json_object(members: [
        json_kv(key: "kind", value: json_string(s: "advance")),
        json_kv(key: "from", value: json_string(s: intake_revision_wire(revision: from))),
        json_kv(key: "to", value: json_string(s: intake_revision_wire(revision: to))),
      ])
  }
}

type CommitIntakeDecode
  = CommitIntakeDecoded { intake: CommitIntake }
  | CommitIntakeRefused { cause: MemberReadRefusal }

fn decode_commit_intake(value: JsonValue) -> CommitIntakeDecode {
  match value {
    JsonNull => CommitIntakeDecoded { intake: IntakeUnrecordedByFormat }
    JsonObject { members: _ } => decode_commit_intake_object(value: value)
    JsonBool { value: _ } => CommitIntakeRefused { cause: MemberReadWrongShape { key: "intake" } }
    JsonNumber { lexeme: _ } => CommitIntakeRefused { cause: MemberReadWrongShape { key: "intake" } }
    JsonString { value: _ } => CommitIntakeRefused { cause: MemberReadWrongShape { key: "intake" } }
    JsonArray { elements: _ } => CommitIntakeRefused { cause: MemberReadWrongShape { key: "intake" } }
  }
}

fn decode_commit_intake_object(value: JsonValue) -> CommitIntakeDecode {
  match read_string_member(v: value, key: "kind") {
    MemberFailed { cause } => CommitIntakeRefused { cause: cause }
    MemberArray { elements: _ } => CommitIntakeRefused { cause: MemberReadWrongShape { key: "kind" } }
    MemberObject { value: _ } => CommitIntakeRefused { cause: MemberReadWrongShape { key: "kind" } }
    MemberString { value: kind } =>
      if kind == "none" {
        intake_members_closed(value: value, allowed: ["kind"], intake: IntakeNone)
      } else if kind == "base" {
        match decode_intake_revision_member(value: value, key: "revision") {
          IntakeRevisionMemberRefused { cause } => CommitIntakeRefused { cause: cause }
          IntakeRevisionMemberRead { revision } =>
            intake_members_closed(value: value, allowed: ["kind", "revision"], intake: IntakeBase { revision: revision })
        }
      } else if kind == "advance" {
        match decode_intake_revision_member(value: value, key: "from") {
          IntakeRevisionMemberRefused { cause } => CommitIntakeRefused { cause: cause }
          IntakeRevisionMemberRead { revision: from } =>
            match decode_intake_revision_member(value: value, key: "to") {
              IntakeRevisionMemberRefused { cause } => CommitIntakeRefused { cause: cause }
              IntakeRevisionMemberRead { revision: to } =>
                intake_members_closed(value: value, allowed: ["kind", "from", "to"], intake: IntakeAdvance { from: from, to: to })
            }
        }
      } else {
        CommitIntakeRefused { cause: MemberReadWrongShape { key: "kind" } }
      }
  }
}

fn intake_members_closed(value: JsonValue, allowed: List<String>, intake: CommitIntake) -> CommitIntakeDecode {
  match unexpected_member_key(v: value, allowed: allowed) {
    Present { value: key } => CommitIntakeRefused { cause: MemberReadWrongShape { key: join(["intake.", key], "") } }
    Absent => CommitIntakeDecoded { intake: intake }
  }
}

type IntakeRevisionMemberRead
  = IntakeRevisionMemberRead { revision: IntakeRevision }
  | IntakeRevisionMemberRefused { cause: MemberReadRefusal }

fn decode_intake_revision_member(value: JsonValue, key: String) -> IntakeRevisionMemberRead {
  match read_string_member(v: value, key: key) {
    MemberFailed { cause } => IntakeRevisionMemberRefused { cause: cause }
    MemberArray { elements: _ } => IntakeRevisionMemberRefused { cause: MemberReadWrongShape { key: key } }
    MemberObject { value: _ } => IntakeRevisionMemberRefused { cause: MemberReadWrongShape { key: key } }
    MemberString { value: text } =>
      match intake_revision_of_wire(text: text) {
        Absent => IntakeRevisionMemberRefused { cause: MemberReadWrongShape { key: key } }
        Present { value: revision } => IntakeRevisionMemberRead { revision: revision }
      }
  }
}
