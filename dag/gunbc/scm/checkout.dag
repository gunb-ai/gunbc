module gunbc.scm.checkout

import std.types { List, String }

import v2.std.node { Node, Edge, node_synthetic }

import gunbc.scm.repository_envelope {
  RepositoryEnvelope,
  RepositoryCommit,
  commit_at_reference,
}
import gunbc.scm.ancestry { RepositoryCommitRef }

import gunbc.scm.object_store {
  ObjectId,
  ObjectRecord,
  ObjectStore,
  StoredEdge,
  find_object,
}

// A COMMIT IS A ROOT IDENTITY AND NOTHING ELSE. No parent, no author, no timestamp, no message, no
// branch. Those are facts about proposals and acceptances -- about who asked for something and who
// agreed to it -- and fusing them into the program's identity is what forces a whole-tree snapshot
// and a single timeline. Keeping the commit to its root is what lets two commits be compared,
// deduplicated and reconstructed without consulting any history at all.
type Commit {
  root: ObjectId
}

type CheckoutRefusal
  = MissingObject { identity: ObjectId }

type CheckoutOutcome
  = CheckedOut { program: Node }
  | CheckoutRefused { cause: CheckoutRefusal }

// THE REFUSAL IS THE POINT OF THE OPERATION, not an error path bolted onto it. A checkout that could
// not tell a complete closure from an incomplete one would satisfy its round-trip test while proving
// nothing, so the missing-object arm is the discriminating half of the reconstruction claim. It
// carries the exact identity that was absent: a checkout must never search for another object with
// the same name, substitute a plausible one, or fall back to whatever the store currently holds --
// each of those is the fabricated-plausible-output arm DESIGN section 5 forbids, and each would make
// the program's meaning depend on the store's current population rather than on the commit.
// EDGES ACCUMULATE BY PREPEND AND ARE REVERSED ONCE AT THE CONSUMER. concat-at-end inside a fold
// copies the whole accumulator per child, so rebuilding one node cost O(children^2) for work that is
// O(children) -- the cost shape DESIGN section 6 says is always fixed regardless of the realized n,
// because "n is small here" is not a fact that stays true under reuse.
//
// The reverse is load-bearing, not cosmetic: these edges are handed to node_synthetic in order, and
// under a positional discipline the order IS the program. A dropped or doubled reverse would rebuild
// `f(x, y)` as `f(y, x)` silently.
type CheckoutEdgeAcc {
  edges: List<Edge>
  refusal: CheckoutRefusal?
}

fn checkout_edge_step(store: ObjectStore, acc: CheckoutEdgeAcc, stored: StoredEdge) -> CheckoutEdgeAcc {
  match acc.refusal {
    Present { value: _ } => acc
    Absent =>
      match checkout_object(store: store, identity: stored.target) {
        CheckoutRefused { cause: cause } =>
          CheckoutEdgeAcc { edges: acc.edges, refusal: Present { value: cause } }
        CheckedOut { program: child } =>
          CheckoutEdgeAcc {
            edges: concat([Edge { label: stored.label, target: child }], acc.edges),
            refusal: acc.refusal,
          }
      }
  }
}

fn checkout_record(store: ObjectStore, record: ObjectRecord) -> CheckoutOutcome {
  match fold(
    record.children,
    init: CheckoutEdgeAcc { edges: [], refusal: none },
    f: fn(acc, stored) { checkout_edge_step(store: store, acc: acc, stored: stored) },
  ) {
    CheckoutEdgeAcc { edges: edges, refusal: refusal } =>
      match refusal {
        Present { value: cause } => CheckoutRefused { cause: cause }
        Absent =>
          CheckedOut { program: node_synthetic(kind: record.kind, children: reverse(edges)) }
      }
  }
}

fn checkout_object(store: ObjectStore, identity: ObjectId) -> CheckoutOutcome {
  match find_object(store: store, identity: identity) {
    Absent => CheckoutRefused { cause: MissingObject { identity: identity } }
    Present { value: record } => checkout_record(store: store, record: record)
  }
}

// CHECKOUT CONSULTS THE COMMIT AND THE STORE, AND NOTHING ELSE -- not names, branches, proposals,
// acceptances, an index, or "latest". That exclusion is the claim: a program's meaning is fixed when
// the commit is made, so growing the store afterwards cannot change what an existing commit means.
// A selection that stayed live would make every later contribution retroactively edit every earlier
// agreement, which is precisely the property that makes a monotonic store unable to name a program
// on its own.
fn checkout(store: ObjectStore, commit: Commit) -> CheckoutOutcome {
  checkout_object(store: store, identity: commit.root)
}

// The rebuilt program carries OccurrenceSynthetic throughout, because occurrence identity is
// deliberately outside the stored object: v2.std.node content_hash already folds only kind, edge
// labels and child digests, so two parses of one program that minted different occurrence ids store
// and reconstruct identically. Round-trip equality is therefore asserted on content identity, never
// on occurrence provenance -- and asserting it on provenance would be asserting the one property the
// model says must not matter.
fn commit_of_root(root: ObjectId) -> Commit {
  Commit { root: root }
}

// ------------------------------------------------------------------------------------------------
// The checkout verb, at repository grain
// ------------------------------------------------------------------------------------------------

// TWO GRAINS OF ONE VERB, IN THE MODULE THAT OWNS IT. Above, checkout answers what a commit MEANS --
// it reconstructs the program from the root closure. Here it answers which intrinsic commit a repository selects.
// AT. Those are the two halves of the same operation, and putting the second in its own module would
// have minted a second name for one verb: the module would have had to be called something that is
// not "checkout" while being exactly checkout, which is the nicknaming DESIGN section 3 forbids.
// Import direction was checked rather than assumed -- gunbc.scm.repository_envelope reaches
// object_store, ancestry, target_reference, json_member and the closure carriers, and none of them
// reach this module, so the edge added here closes no cycle.
//
// CHECKOUT HAS NOTHING TO SAY ABOUT ANCESTRY, AND THAT IS DERIVED RATHER THAN OMITTED. The silence
// is stated here explicitly, because a later reader finding no mention of ancestry in a verb that
// selects a commit would reasonably read it as an oversight and "fix" it.
//
// A commit's program is its ROOT CLOSURE. Ancestry is a chain over COMMITS. Those are two different
// graphs over two different populations, and the reconstruction above walks only the first: it
// consults the commit and the store, and nothing else. So no ancestor needs to exist, or be
// readable, or be consistent, for a checkout to be exactly right.
//
// THE CONSEQUENCE IS NOT COSMETIC, AND IT HAS A WITNESS: a commit whose stated parent is missing
// CHECKS OUT SUCCESSFULLY, while an ancestry walk from that same commit answers AncestryBrokenAt.
// One repository, one commit, two questions, two DIFFERENT answers -- both correct, because the
// history is truncated and the program is not. Making checkout refuse there would be inventing a
// dependency the model does not have, and would mean a damaged history could silently cost a user
// access to programs that are wholly intact.
//
// THE REFUSAL ARMS CARRY NO REPOSITORY, and that is the root-commit discipline applied one layer
// out. Had a failed checkout answered an envelope with nothing selected, "this checkout did not
// happen" and "this repository has nothing checked out" would share a representation -- the second
// being an ordinary state the envelope's own header calls not an error. A caller could not then tell
// a refused checkout from a fresh repository, which is the state-space conflation this stack has now
// removed at three layers.
//
// NO Bool PREDICATE OVER THIS COPRODUCT IS EXPORTED, and that is deliberate rather than an
// oversight. A `checkout_succeeded` convenience was written and removed before this landed: its only
// consumer would have been the witness asserting it works, which makes it an artifact with no final
// consumer (DESIGN section 6). The same objection was raised against a sibling helper in
// gunbc.scm.ancestry (review 56207) and resolved the same way. Consumers match the arms, so a fourth
// arm fails to compile at every site rather than being silently absorbed into a false.
//
// THE TWO REFUSALS ARE SEPARATE BECAUSE THEIR OWNERS ARE OPPOSITE. An unresolved reference is the
// CALLER'S fact -- they named an identity this repository has no commit for. An unreconstructable
// program is the STORE'S fact -- the repository holds the commit and has lost an object it needs.
// One is a bad argument, the other is damage, and collapsing them would hand a user "no such commit"
// for a commit that plainly exists in their log.
type RepositoryCheckout
  = RepositoryCheckedOut { repository: RepositoryEnvelope, program: Node }
  | CheckoutReferenceUnresolved { reference: RepositoryCommitRef }
  | CheckoutProgramUnreconstructable { reference: RepositoryCommitRef, cause: CheckoutRefusal }

// THIS WRITES NOTHING. It answers a NEW envelope with the selection moved, leaving its argument
// untouched, so the verb stays a pure transform over facts the repository already holds. Persisting
// the result is a separate operation at a boundary this module deliberately does not reach.
//
// The reference is the same intrinsic commit identity `log` renders and `status`
// resolves -- so the three verbs name commits the one way, and resolution goes through
// commit_at_reference rather than a second lookup that could drift from it.
fn checkout_repository_at(repo: RepositoryEnvelope, reference: RepositoryCommitRef) -> RepositoryCheckout {
  match commit_at_reference(commits: repo.commits, reference: reference) {
    Absent => CheckoutReferenceUnresolved { reference: reference }
    Present { value: selected } =>
      match checkout(store: repo.store, commit: commit_of_root(root: selected.root)) {
        CheckoutRefused { cause: cause } =>
          CheckoutProgramUnreconstructable { reference: reference, cause: cause }
        CheckedOut { program: program } =>
          RepositoryCheckedOut {
            repository: RepositoryEnvelope {
              store: repo.store,
              commits: repo.commits,
              commit_allocator: repo.commit_allocator,
              checked_out: Present { value: reference },
            },
            program: program,
          }
      }
  }
}
