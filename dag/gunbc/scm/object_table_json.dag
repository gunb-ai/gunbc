module gunbc.scm.object_table_json

// DECODING THE OBJECT TABLE IS ONE OPERATION WITH ONE FAILURE POPULATION, and this module owns both.
// It was previously homed inside gunbc.scm.commit_closure_json_v2 with its failures typed as THAT
// module's ClosureDocRefusal, so seven object-population causes sat in a coproduct that also answers
// for envelope format and closure-root facts. A consumer matching that type had to handle causes
// from three different owners, and no reader could tell from the type which owner produced which.
//
// THE MEASURED COST WAS NOT STYLISTIC, and it is the reason this cut is a correctness fix rather
// than tidiness. closure_document_load_standing maps ObjectTableObjectCollision to
// LoadIdentityCollision and the OTHER SIX tag/reference causes to LoadDocumentMalformed. Per
// gunbc.scm.load_standing, LoadDocumentMalformed is THE ONLY standing that
// standing_may_supersede_generation answers true for. So any consumer that classified the seven
// together -- at the grain of one wrapping arm rather than per cause -- would hand an identity
// collision the one standing permitted to overwrite a newer generation. Both colliding records are
// legitimate and the coincidence is honest, so that is a valid generation destroyed by a reader's
// own collapse: the DESIGN gunbc.scm specimen, where an older reader supersedes a newer writer's
// document through a single outer arm that looked total.
//
// THE FORMAT VOCABULARY STAYS HERE, NOT IN gunbc.scm.object_store. These causes name JSON tags and
// document-local references, and object_store is format-agnostic -- it imports only v2.std.node and
// std.types and mentions JSON nowhere. Moving a `found: String` JSON tag into it would be the layer
// inversion gunbc.scm.json_member's header already names. The object TABLE is a JSON-document
// concept; the object STORE is not.
//
// THIS MODULE OWNS ITS OWN CLASSIFIER, which is a deliberate departure from the sibling extraction.
// gunbc.scm.json_member carries no classifier: the closure classifier descends into MemberReadRefusal
// in place, as it also does into TargetReferenceRefusal. Descent would be correct here too. It is not
// what this module does, because descent-in-place makes the closure module grow a new inner arm every
// time THIS module gains a cause, so it would pay maintenance for a population it does not own.
// Delegation is the only form where adding an object-table cause is one edit in one module.
//
// WHAT THE DELEGATION DOES AND DOES NOT MAKE UNREPRESENTABLE, stated precisely because an earlier
// revision of this paragraph overclaimed it and a reviewer was right to catch that (review 55811).
//
// UNREPRESENTABLE: naming an INDIVIDUAL object-table cause in a match over ClosureDocRefusal. A
// consumer cannot write `ObjectTableObjectCollision => LoadDocumentMalformed`, because the closure
// type's arms do not include it. That is the specific misclassification that was writable before this
// cut and is not writable after it, and it is the dangerous one: it targets exactly one cause, needs
// no wildcard, and reads as total.
//
// STILL WRITABLE: collapsing the whole population behind the wrapper binding --
// `ClosureDocObjectTableRefused { cause: _ } => LoadDocumentMalformed`. That would give a collision
// the supersession-permitting standing just as surely. This cut does NOT wall it, and the rung for
// that class is MECHANICALLY PREVENTABLE, not structural: what changed is that the collapse now
// requires a bare binding over a foreign authority's population, which is the tell DESIGN already
// names, rather than an innocuous-looking per-cause arm.
//
// THE TRIGGER FIRED, AND THE REMEDY IT NAMED IS NOW BUILT. This paragraph used to say the wall was
// unavailable, and the reason it gave was true when written: decode_object_step raised member-read
// and unexpected-member causes alongside the object-table ones, so its failure population was
// genuinely MIXED and narrowing its result would have made the type claim an owner for causes it did
// not own. The stated next-rung trigger was a decode_object_table whose member-read and
// unexpected-member causes are themselves owned elsewhere, leaving a residue this module can own
// outright.
//
// That is exactly what the corpus-manifest cut produced. Those causes are arms of
// ObjectTableDecodeRefusal now, together with the target-reference and entry-shape causes, so the
// population is no longer mixed and decode_object_table's result is narrowed to this type. The
// closure document wraps once at its own boundary rather than supplying the vocabulary the table
// refuses in.
//
// WHAT THAT DOES AND DOES NOT BUY. A consumer of the object table no longer receives a
// ClosureDocRefusal at all, so the wrapper it could have collapsed is not in its hands. The collapse
// remains writable one layer up, by a consumer of ClosureDocRefusal binding
// `ClosureDocObjectTableRefused { cause: _ }` bare -- that is one module, one arm, and a bare binding
// over a foreign authority's population, which is the tell rather than the wall.
//
// NEXT-RUNG TRIGGER, restated for what is left: module privacy in .dag, which would let the
// delegating classifier be the only reachable route from a closure refusal to a standing. Until then
// the residue is mechanically preventable and this comment is the thing saying so.

import std.types { String }
import gunbc.scm.object_store { ObjectId }
import gunbc.scm.target_reference { TargetReferenceRefusal }
import gunbc.scm.json_member {
  MemberReadRefusal,
  MemberReadSubjectNotObject,
  MemberReadMissing,
  MemberReadDuplicated,
  MemberReadWrongShape,
}
import gunbc.scm.load_standing {
  LoadStanding,
  LoadDocumentMalformed,
  LoadIdentityCollision,
}

// FOURTEEN CAUSES, TWO REMEDIES, AND THE SPLIT BETWEEN THEM IS THE WHOLE POINT OF THE TYPE.
//
// All but one say the document does not conform to a schema this build claims to understand: an
// entry member that is missing, duplicated or the wrong shape, a member the closed set does not
// admit, a tag naming a kind, connective, behavior or label outside the closed vocabulary, or a
// reference naming a position the document does not carry -- or naming one it DOES carry that holds
// the wrong kind of object for the position that named it. Those are malformed bytes to a reader
// that should have understood them. The wrong-kind arms are the one boundary at which a file or a
// manifest can still be presented in a node position, or a node in a manifest entry's source: inside
// the model the reference types make each unwritable, but a document is bytes and can say anything,
// so the wall there is a typed refusal rather than a constructor.
//
// ObjectTableObjectCollision is NOT that, and conflating it with the other THIRTEEN is the error this type
// exists to prevent. Two distinct records claiming one structural locator is an honest hash
// coincidence between two legitimate objects, not damage to either. It is a limitation of the
// locator's representation, and the remedy is to widen the locator -- never to discard a generation.
// THE MEMBER SETS OF AN OBJECT-TABLE ENTRY, WHICH ARE NOT FACTS ABOUT ANY DOCUMENT THAT EMBEDS ONE.
//
// These lived in gunbc.scm.commit_closure_json_v2's context coproduct while that module was the only
// table consumer. It no longer is, and three of them -- the authored-source entry, the manifest entry
// and a manifest entry's own members -- describe shapes a commit-closure document cannot contain at
// all. The test that moved them is whether the context could exist in a repository object table with
// no closure document anywhere near it; for every arm here the answer is yes.
//
// The node-entry and kind and edge shapes come too, and NOT because there are now two consumers.
// They come because {kind, children}, the kind variants and the edge variants are literally the same
// schema in both tables. Duplicating them per consumer would give one schema two authorities, which
// is the fork this move exists to close rather than a symmetry worth having.
type ObjectTableMemberContext
  = ObjectTableSemanticNodeMembers
  | ObjectTableAuthoredSourceMembers
  | ObjectTableCorpusManifestMembers
  | ObjectTableManifestEntryMembers
  | ObjectTableTypeKindMembers
  | ObjectTableAtomKindMembers
  | ObjectTableComputationKindMembers
  | ObjectTableNamedEdgeMembers
  | ObjectTablePositionalEdgeMembers

type ObjectTableDecodeRefusal
  = ObjectTableMemberReadRefused { cause: MemberReadRefusal }
  | ObjectTableTargetReferenceRefused { cause: TargetReferenceRefusal }
  | ObjectTableUnexpectedMember { context: ObjectTableMemberContext, key: String }
  | ObjectTableUnknownKindTag { found: String }
  | ObjectTableUnknownConnectiveTag { found: String }
  | ObjectTableUnknownBehaviorTag { found: String }
  | ObjectTableUnknownLabelTag { found: String }
  | ObjectTableEdgeTargetUnresolved { reference: String }
  | ObjectTableEdgeTargetIsAuthoredSource { reference: String }
  | ObjectTableEdgeTargetIsCorpusManifest { reference: String }
  | ObjectTableManifestPathEmpty
  | ObjectTableManifestSourceUnresolved { reference: String }
  | ObjectTableManifestSourceIsSemanticNode { reference: String }
  | ObjectTableManifestSourceIsCorpusManifest { reference: String }
  | ObjectTableObjectCollision { identity: ObjectId }

// THE AUTHORITY THAT OWNS THE CAUSES OWNS THE STANDING DECISION, per DESIGN section 3: the dispatch
// selecting a realization is itself realization, so each format classifies ITS OWN refusals into the
// shared vocabulary and the consumer sees only the standing. gunbc.scm.load_standing's header states
// the same rule from the other side -- a new format is a new classifier beside its own refusals.
//
// This match is exhaustive over the fourteen and assigns per cause, never per group. The collision arm is
// the load-bearing one: it must not reach LoadDocumentMalformed, because that is the only standing
// permitting supersession.
fn object_table_load_standing(cause: ObjectTableDecodeRefusal) -> LoadStanding {
  match cause {
    ObjectTableObjectCollision { identity: _ } => LoadIdentityCollision
    ObjectTableMemberReadRefused { cause: c } =>
      match c {
        MemberReadSubjectNotObject => LoadDocumentMalformed
        MemberReadMissing { key: _ } => LoadDocumentMalformed
        MemberReadDuplicated { key: _ } => LoadDocumentMalformed
        MemberReadWrongShape { key: _ } => LoadDocumentMalformed
      }
    ObjectTableUnexpectedMember { context: _, key: _ } => LoadDocumentMalformed
    ObjectTableTargetReferenceRefused { cause: c } => target_reference_load_standing(cause: c)
    ObjectTableUnknownKindTag { found: _ } => LoadDocumentMalformed
    ObjectTableUnknownConnectiveTag { found: _ } => LoadDocumentMalformed
    ObjectTableUnknownBehaviorTag { found: _ } => LoadDocumentMalformed
    ObjectTableUnknownLabelTag { found: _ } => LoadDocumentMalformed
    ObjectTableEdgeTargetUnresolved { reference: _ } => LoadDocumentMalformed
    ObjectTableEdgeTargetIsAuthoredSource { reference: _ } => LoadDocumentMalformed
    ObjectTableEdgeTargetIsCorpusManifest { reference: _ } => LoadDocumentMalformed
    ObjectTableManifestPathEmpty => LoadDocumentMalformed
    ObjectTableManifestSourceUnresolved { reference: _ } => LoadDocumentMalformed
    ObjectTableManifestSourceIsSemanticNode { reference: _ } => LoadDocumentMalformed
    ObjectTableManifestSourceIsCorpusManifest { reference: _ } => LoadDocumentMalformed
  }
}
