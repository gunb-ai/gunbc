module gunbc.scm.ordinary_commit

// THE ORDINARY COMMIT MINT: A COMMIT THAT CONSUMED NOTHING, MINTED FROM EVIDENCE RATHER THAN FROM
// REFERENCES.
//
// An ordinary commit answers FEWER questions than the generic route asks, so it deserves an outcome
// shaped to the questions it actually has. That is the whole reason this module is not
// `mint_repository_commit` with a narrower comment.
//
// A SECOND, WIDER MINT LIVED HERE AND IS DELETED RATHER THAN KEPT FOR SYMMETRY. `mint_ordinary_commit`
// took a bare parent reference, looked it up through an admission that duplicated
// `admit_commit_subject` line for line, and carried a parent-missing arm for the lookup. Nothing ever
// called it: the write spine reaches its parent through `base_snapshot`, which has ALREADY found that
// commit, so the only live caller needs the basis-taking route below. A declaration with no consumer
// is DESIGN section 3c's red state regardless of how well it is modelled, and keeping a duplicated
// admission beside the one authority is the section 3 fork on top of it. Found by external review.

import std.types { String, Int }

import gunbc.scm.repository_envelope {
  MintedCommit,
  AncestralSubjectAdmission, AncestralSubjectAdmitted,
  AncestralSubjectAllocatorInvalid,
  AdmittedCommitBasis,
  admit_commit_subject_from_basis,
  mint_repository_commit_admitted,
}

// THE NARROW MINT. Two arms rather than three, because its caller hands it an ancestry that was
// ADMITTED where the parent was found rather than a reference this function would have to look up.
//
// IT TAKES ONE `AdmittedCommitBasis` AND NOTHING BESIDE IT, AND THE FIRST TWO VERSIONS DID NOT.
//
// The first took a bare `CommitAncestry`, which states a relation and evidences nothing, so this
// public mint accepted `DescendsFrom { parent: <absent> }` and answered with a commit whose ancestry
// dangles -- strictly worse than the parent-missing arm its introduction deleted. The second sealed
// the ancestry but still took the SUBJECT as a separate argument, so evidence admitted against one
// repository could be paired with a subject from another and dangle in that one instead. The subject
// now travels inside the evidence, so this signature has nothing left to mis-pair. Both found by
// external review.
type AncestralCommitMint
  = AncestralCommitMinted(MintedCommit)
  | AncestralCommitAllocatorInvalid { next_ordinal: Int }

fn mint_ancestral_commit(
  basis: AdmittedCommitBasis,
  message: String,
) -> AncestralCommitMint {
  match admit_commit_subject_from_basis(basis: basis) {
    AncestralSubjectAllocatorInvalid { next_ordinal: n } =>
      AncestralCommitAllocatorInvalid { next_ordinal: n }
    AncestralSubjectAdmitted(admitted) =>
      AncestralCommitMinted(mint_repository_commit_admitted(admitted: admitted, message: message))
  }
}
