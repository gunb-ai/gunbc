module gunbc.scm.ordinary_commit

// MINTING A COMMIT THAT CONSUMED NOTHING, AS A CONSTRUCTION RATHER THAN AS AN ARGUMENT.
//
// WHY THIS EXISTS AT ALL, AND IT IS NOT A CONVENIENCE WRAPPER. `mint_commit_from_stored_manifest`
// takes a `CommitIntegration`, so its outcome must carry `BrandedRootIntegrationSourceMissing` -- an
// honest arm, because for a MERGE that source can genuinely be absent. An ordinary commit passes
// `NoSquashIntegration`, which has no source at all, so that arm is unreachable from this route and
// every consumer downstream was being made to match on a state this operation cannot produce.
//
// THE FIRST ATTEMPT KEPT THE ARM AND SAID SO IN A COMMENT. That is the `carry_mint` error this stack
// has already paid for once: preserving the callee's causes is honest about the CALLEE's domain and
// dishonest about the OPERATION's, and an annotation admitting a state is impossible while the type
// still carries it is a signature that lies with a footnote. Re-reporting it as a parent-missing
// would have been worse -- a fabricated cause, which is the sin one level down from this one.
//
// SO THE QUESTION IS REMOVED RATHER THAN ANSWERED. This function takes no integration parameter,
// supplies `NoSquashIntegration` itself, and narrows the result to the three outcomes an ordinary
// commit can actually reach. DESIGN section 4b: construction over proof, proof over validation --
// the state is not refused here, it is unwritable through this route.
//
// IT IS NOT A SECOND MINT. The parent admission is `admit_commit_parent` and the row is built by
// `mint_repository_commit_admitted` -- the same two functions the squash route uses -- so the
// allocator discipline, the parent-preexistence rule and the row's shape have exactly one authority
// each. What differs is only WHICH QUESTIONS THIS ROUTE ASKS, which is the thing that should differ.

import std.types { String, Int }
import gunbc.scm.ancestry { RepositoryCommitRef, CommitAncestry }

import gunbc.scm.repository_envelope {
  RepositoryEnvelope,
  RepositoryManifestRoot,
  MintedCommit,
  OrdinaryCommitSubjectAdmission, OrdinaryCommitSubjectAdmitted,
  OrdinaryCommitSubjectAllocatorInvalid, OrdinaryCommitSubjectParentMissing,
  OrdinaryAncestralSubjectAdmission, OrdinaryAncestralSubjectAdmitted,
  OrdinaryAncestralSubjectAllocatorInvalid,
  AdmittedCommitAncestry,
  admit_ordinary_commit_subject, admit_ordinary_commit_subject_from_ancestry,
  mint_repository_commit_admitted,
}

type OrdinaryCommitMint
  = OrdinaryCommitMinted(MintedCommit)
  | OrdinaryCommitAllocatorInvalid { next_ordinal: Int }
  | OrdinaryCommitParentMissing { parent: RepositoryCommitRef }

// THE INTEGRATION QUESTION IS NOT ASKED HERE, WHICH IS DIFFERENT FROM BEING ANSWERED HERE.
//
// This route runs the two admissions an ordinary commit actually has -- the allocator and the parent
// -- and then reaches `mint_repository_commit_admitted`, whose outcome is the single-constructor
// `MintedCommit`. There is no integration arm to match, so there is nothing to translate and no
// opportunity to fabricate a cause. The first draft of this module DID translate it, into a
// parent-missing, behind a comment explaining that it could not fire; that comment was the tell.
//
// THE ADMISSION RULES ARE NOT DUPLICATED. `admit_commit_parent` is the same function the squash route
// calls, and the row is built by the same constructor. What differs between the routes is only which
// questions they ask, which is exactly what should differ.
//
// AND THE SUBJECT IS THE SEALED PAIR, so this helper cannot be handed a repository and a root that came
// from different stores. It takes no repository argument at all: there is only one repository here, the
// one the root was resolved or stored against.
//
// THE INTEGRATION ARM IS GONE FOR THE THIRD AND FINAL TIME, and the first two attempts are worth
// recording because they were the same reflex. Attempt one kept the generic arm and explained in a
// comment that it could not fire. Attempt two translated it into a parent-missing. Both are the
// fabricated cause this stack keeps paying for -- a match closed with an answer nobody could have
// observed. The question is now absent from the ADMISSION, not merely from this fold:
// `admit_ordinary_commit_subject` never asks it, so there is no arm here to handle.
fn mint_ordinary_commit(
  subject: RepositoryManifestRoot,
  message: String,
  parent: RepositoryCommitRef?,
) -> OrdinaryCommitMint {
  match admit_ordinary_commit_subject(subject: subject, parent: parent) {
    OrdinaryCommitSubjectAllocatorInvalid { next_ordinal: n } =>
      OrdinaryCommitAllocatorInvalid { next_ordinal: n }
    OrdinaryCommitSubjectParentMissing { parent: p } => OrdinaryCommitParentMissing { parent: p }
    OrdinaryCommitSubjectAdmitted(admitted) =>
      OrdinaryCommitMinted(mint_repository_commit_admitted(admitted: admitted, message: message))
  }
}

// THE NARROW MINT. Two arms rather than three, because its caller hands it an ancestry that was
// ADMITTED where the parent was found rather than a reference this function would have to look up.
//
// IT TAKES `AdmittedCommitAncestry`, NOT `CommitAncestry`, AND THE FIRST VERSION TOOK THE LATTER. A
// bare `CommitAncestry` states a relation and evidences nothing, so this public mint would accept
// `DescendsFrom { parent: <absent> }` and answer with a commit whose ancestry dangles -- strictly
// worse than the parent-missing arm its introduction deleted. Found by external review.
type AncestralCommitMint
  = AncestralCommitMinted(MintedCommit)
  | AncestralCommitAllocatorInvalid { next_ordinal: Int }

fn mint_ancestral_commit(
  subject: RepositoryManifestRoot,
  message: String,
  admitted_ancestry: AdmittedCommitAncestry,
) -> AncestralCommitMint {
  match admit_ordinary_commit_subject_from_ancestry(
    subject: subject,
    admitted_ancestry: admitted_ancestry,
  ) {
    OrdinaryAncestralSubjectAllocatorInvalid { next_ordinal: n } =>
      AncestralCommitAllocatorInvalid { next_ordinal: n }
    OrdinaryAncestralSubjectAdmitted(admitted) =>
      AncestralCommitMinted(mint_repository_commit_admitted(admitted: admitted, message: message))
  }
}
