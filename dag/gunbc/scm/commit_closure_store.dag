module gunbc.scm.commit_closure_store

// PERSISTENCE: the host-effect half of the COMMIT-CLOSURE image.
//
// THE GRAIN IS IN THE NAME ON PURPOSE. This saves and loads ONE ROOT AND ITS REACHABLE CLOSURE, not
// a repository. A repository has facts this carrier cannot express -- an empty initialized state
// with no root at all, several commits sharing one node population, a checked-out selection, pending
// authored work, source projections -- and every one of them lives in an envelope ABOVE this file.
// An earlier revision called this module `repository`, which would have collided with that envelope
// exactly when it arrives and would have pushed `init` toward inventing a phantom commit merely to
// satisfy a carrier that demands a root.
//
// gunbc.scm.commit_closure_json_v1 is pure -- ObjectStore to JsonValue and back -- and is proven by floor witnesses
// because it can be. THIS module cannot be, and the reason is structural rather than an omission:
// Filesystem.Read and Filesystem.Write are effects, and the required floor evaluates hermetically,
// so a witness calling them is REFUSED at the hermetic boundary before the assertion runs. Mocking
// that refusal away would prove the round trip against a fabricated filesystem -- the exact
// fabricated-plausible-output failure the persistence claim exists to rule out.
//
// So the standings are deliberately different and must not be conflated (DESIGN section 4b, rung
// honesty is measured per path): the CODEC is floor-verified; PERSISTENCE is verified by direct
// execution in Wet mode against a real path. `commit_closure_round_trip_probe` below is that executable
// subject, and it carries its own discriminating arm rather than only reporting success.

import std.types { Bool, Int, List, String }
import extdeps.filesystem.filesystem_io { Filesystem }
import std.process { ProcessExit, ExitSuccess, exit_failure }

import extdeps.languages.json.emit { JsonValue, serialize_json }
import extdeps.languages.json.parse { parse_json }

import v2.std.node {
  Node, Edge, Named, TypeNode, Connective, Atom, Conj, Symbol, node_synthetic,
}
import gunbc.scm.object_store {
  ObjectId, ObjectStore, StoreOutcome, Stored, LocatorCollision, empty_store, store_node,
}
import gunbc.scm.commit_closure_json_v1 {
  ClosureDocRefusal,
  ClosureDocEncodeOutcome,
  ClosureDocEncoded,
  ClosureDocEncodeRefused,
  encode_closure_document_checked,
  ClosureDocLoadOutcome,
  ClosureDocLoaded,
  ClosureDocRefused,
  encode_closure_document,
  decode_closure_document,
}

// THE HOST'S THREE PARALLEL FIELDS ARE FOLDED INTO A COPRODUCT AT THE BOUNDARY, AND THIS IS THE
// POINT OF THE TYPE. Filesystem.Write reports `success: Bool`, `error: String` and `bytes_written`
// as three independent members, so the shape admits states the operation cannot actually be in --
// success with an error, failure with bytes written. That is the state-space conflation DESIGN
// section 5 names. Reading it once, here, into a two-armed outcome means no consumer downstream ever
// has to decide which member to believe, and no consumer can read `.content` from a failed read.
type CommitClosureRefusal
  = CommitClosureWriteFailed { path: String, error: String }
  | CommitClosureReadFailed { path: String, error: String }
  | CommitClosureTextNotJson { path: String }
  | CommitClosureDocumentRefused { path: String, cause: ClosureDocRefusal }

type CommitClosureSaveOutcome
  = CommitClosureSaved { path: String }
  | CommitClosureSaveRefused { cause: CommitClosureRefusal }

type CommitClosureLoadOutcome
  = CommitClosureLoaded { store: ObjectStore, root: ObjectId }
  | CommitClosureLoadRefused { cause: CommitClosureRefusal }

// ENCODING IS ADJUDICATED BEFORE ANYTHING IS WRITTEN, and the ordering is the point.
//
// An earlier revision encoded unconditionally and reported CommitClosureSaved whenever the
// filesystem write succeeded. For an INCOMPLETE closure -- which object_store's copy_object can
// legitimately build -- that wrote bytes carrying unresolvable references, reported success, and the
// very next load refused them. A successful write must never upgrade an encoding failure into
// Saved; the write is not the claim, the loadability of what was written is.
//
// Refusing BEFORE the write also means a failed save leaves no partial file at the path at all,
// rather than replacing a good repository with an unloadable one.
func commit_closure_save(path: String, store: ObjectStore, root: ObjectId) -> CommitClosureSaveOutcome {
  match encode_closure_document_checked(store: store, root: root) {
    ClosureDocEncodeRefused { cause: cause } =>
      CommitClosureSaveRefused {
        cause: CommitClosureDocumentRefused { path: path, cause: cause },
      }
    ClosureDocEncoded { value: encoded } => {
      let written = Filesystem.Write(path: path, content: serialize_json(v: encoded))
      if written.success {
        CommitClosureSaved { path: path }
      } else {
        CommitClosureSaveRefused {
          cause: CommitClosureWriteFailed { path: path, error: written.error },
        }
      }
    }
  }
}

// EVERY FAILURE ARM REFUSES AND NAMES THE PATH. None widens, defaults, or answers an empty store.
// An unreadable repository and an EMPTY one are different states with different remedies, and
// answering `empty_store()` for the first would be the empty-observation narrow -- the caller would
// proceed to commit against a repository it believed had no history.
func commit_closure_load(path: String) -> CommitClosureLoadOutcome {
  let read = Filesystem.Read(path: path)
  if !read.success {
    CommitClosureLoadRefused {
      cause: CommitClosureReadFailed { path: path, error: read.error },
    }
  } else {
    match parse_json(s: read.content) {
      Absent => CommitClosureLoadRefused { cause: CommitClosureTextNotJson { path: path } }
      Present { value: parsed } =>
        match decode_closure_document(v: parsed) {
          ClosureDocRefused { cause: cause } =>
            CommitClosureLoadRefused {
              cause: CommitClosureDocumentRefused { path: path, cause: cause },
            }
          ClosureDocLoaded { store: store, root: root } =>
            CommitClosureLoaded { store: store, root: root }
        }
    }
  }
}


// ------------------------------------------------------------------------------------------------
// The executable subject. This is what proves persistence, because a floor witness structurally
// cannot -- see the module header.
// ------------------------------------------------------------------------------------------------

// A PATH GRANT IS NOT MODELED HERE, and that is a scope statement rather than an oversight.
// extdeps.realization.artifact_store_fs guards its writes with a scratch-area grant because it has a
// policy to enforce; a repository path supplied by a user has no such policy yet, and inventing one
// with no consumer would be speculative. When repository location becomes a policy question, the
// grant belongs at that boundary, not retrofitted here.
// dissolve-on: a modeled repository-location policy.

fn commit_closure_probe_atom(identity: Symbol) -> Node {
  node_synthetic(kind: TypeNode { connective: Atom { identity: identity } }, children: [])
}

fn commit_closure_probe_program() -> Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: ^probe_left }, target: commit_closure_probe_atom(identity: ^PL) },
      Edge { label: Named { name: ^probe_right }, target: commit_closure_probe_atom(identity: ^PR) },
    ],
  )
}

// THE PROBE ASSERTS BOTH DIRECTIONS, and the second is what makes the first mean anything.
//
// Writing a file and reading it back proves only that the filesystem works. The claim under test is
// that what comes back IS THE SAME PROGRAM, so the probe compares the reconstructed root identity
// against the one it saved -- and then it corrupts the file and requires a REFUSAL. A save/load pair
// with no corruption arm would pass identically if load fabricated a store on any input, which is
// precisely the failure persistence is supposed to exclude. That corruption step is the `clobber`
// write below: it overwrites with text that is not this image, and the load after it must refuse or
// the probe fails -- if that arm ever greens, load is fabricating rather than decoding.
//
// WHY THIS RATIONALE SITS HERE RATHER THAN BESIDE THE LINE IT DESCRIBES. It was originally two `//`
// lines inside the function body, which `gunbc run` ACCEPTED and the required floor REFUSED
// (DESIGN section 4c models annotations at module-item grain only). The same source, two acceptance
// paths, two verdicts -- so a green Wet-mode probe proved nothing about whether CI would take the
// file. That is the standing acceptance-path gap, met head-on: the lenient path is the one this
// module is exercised through, so it cannot be the path that decides admissibility.
func commit_closure_round_trip_probe(path: String) -> ProcessExit {
  let put = store_node(store: empty_store(), n: commit_closure_probe_program())
  match put {
    LocatorCollision { identity: _, existing: _, incoming: _ } =>
      return exit_failure(reason: "commit-closure probe: fixture collided in an empty store")
    Stored { store: store, identity: root } => {
      match commit_closure_save(path: path, store: store, root: root) {
        CommitClosureSaveRefused { cause: _ } =>
          return exit_failure(reason: "commit-closure probe: save refused")
        CommitClosureSaved { path: _ } => {
          match commit_closure_load(path: path) {
            CommitClosureLoadRefused { cause: _ } =>
              return exit_failure(reason: "commit-closure probe: load refused a file we just wrote")
            CommitClosureLoaded { store: _, root: loaded_root } => {
              if (loaded_root.digest as String) != (root.digest as String) {
                return exit_failure(reason: "commit-closure probe: reloaded root is a different program")
              }
              let clobber = Filesystem.Write(path: path, content: "{\"format\": \"not-a-gunbc-image\"}")
              if !clobber.success {
                return exit_failure(reason: "commit-closure probe: could not write the corruption case")
              }
              match commit_closure_load(path: path) {
                CommitClosureLoaded { store: _, root: _ } =>
                  return exit_failure(reason: "commit-closure probe: a corrupted image LOADED -- load fabricates")
                CommitClosureLoadRefused { cause: _ } =>
                  return ExitSuccess
              }
            }
          }
        }
      }
    }
  }
}
