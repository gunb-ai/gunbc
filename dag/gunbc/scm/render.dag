  RepositoryStatus,
  render_status_checkout,
  render_commit_count,
  render_staged,
}

// A document of plain text lines: one Leaf block, one line per string.
//
// `Append` is the honest cursor action for a verb's answer. `Overwrite` and `Clear` exist for a
// surface that redraws itself, and a read verb does not -- it emits an answer once. Choosing
// Overwrite here would make the answer's persistence depend on the destination's cursor
// addressability, which is a property of the handler and not a fact about the answer.
fn text_lines_document(lines: List<String>) -> Document {
  Document {
    blocks: [
      Leaf {
        frame: RenderFrame {
          lines: map(lines, l => plain_line(text: l)),
          cursor_action: Append,
        }
      }
    ]
  }
}

// WHETHER THIS COMMIT'S PROGRAM IS HELD, said in the row rather than left to the reader.
//
// `gunbc.scm.log` reports this per row because the envelope can decide it, and a row whose program
// is missing CANNOT BE CHECKED OUT. Rendering it identically to an ordinary row would present an
// unusable commit as usable -- the reader's next action differs, so the rendering must.
// THE HELD ROW RENDERS EMPTY, AND THAT IS NOT A CLAIM THAT IT CHECKS OUT. `LoggedCommitManifestHeld`
// says this store holds the manifest, not that it holds every source the manifest names, so the
// suffix says nothing rather than saying "checkoutable" -- advertising held-ness as recoverability
// would be a larger claim than the observation supports. Whether the sources are present is a
// separate walk (gunbc.scm.checkout recover_corpus), and when a surface wants to report it, it
// reports THAT observation rather than borrowing this one.
fn log_standing_suffix(standing: LoggedCommitStanding) -> String {
  match standing {
    LoggedCommitManifestHeld => ""
    LoggedCommitRootMissingFromStore => "  (snapshot not held -- cannot be checked out)"
    LoggedCommitRootIsAuthoredSource => "  (root is a source file, not a corpus snapshot -- cannot be checked out)"
    LoggedCommitRootIsSemanticNode => "  (root is a program node, not a corpus snapshot -- cannot be checked out)"
  }
}

fn log_row_line(row: CommitLogRow) -> String {
  concat(row.message, log_standing_suffix(standing: row.standing))
}

// NO COMMITS IS AN ANSWER, NOT AN ABSENCE OF ONE. An empty repository read successfully and
// truthfully has nothing to list; rendering that as no output would make it indistinguishable from a
// verb that failed to produce lines -- the empty-observation narrow, carried to a human.
fn commit_log_lines(log: CommitLog) -> List<String> {
  match log {
    NoCommitsYet => ["no commits yet"]
    CommitLogRows { rows: rows } => map(rows, r => log_row_line(row: r))
  }
}

fn scm_log_document(result: ScmReadResult<CommitLog>) -> Document {
  match result {
    ScmReadRepositoryUnavailable { cause: cause } =>
      text_lines_document(lines: repository_load_refusal_lines(cause: cause))
    ScmReadAnswered { path: _, answer: log } =>
      text_lines_document(lines: commit_log_lines(log: log))
  }
}

// The status lines come from the verb module; only the document structure is decided here. See the
// header: this is the anti-fork constraint, and the witness measures it.
fn repository_status_lines(status: RepositoryStatus) -> List<String> {
  concat(
    [
      render_status_checkout(checkout: status.checkout),
      render_commit_count(commit_count: status.commit_count),
    ],
    render_staged(staged: status.staged),
  )
}

fn scm_status_document(result: ScmReadResult<RepositoryStatus>) -> Document {
  match result {
    ScmReadRepositoryUnavailable { cause: cause } =>
      text_lines_document(lines: repository_load_refusal_lines(cause: cause))
    ScmReadAnswered { path: _, answer: status } =>
      text_lines_document(lines: repository_status_lines(status: status))
  }
}

// THE EXIT STATUS IS A SEPARATE DECISION FROM THE BYTES, AND THIS IS WHERE IT IS MADE.
//
// An unavailable repository still renders a document worth printing -- the located refusal above --
// and must still exit nonzero, because a script branching on this verb has to be able to tell "the
// log is empty" from "there is no repository here". That is exactly the pair `CliWireResponse`
// exists to carry, and it is why the exit status cannot be derived from the rendering.
//
// AN EMPTY REPOSITORY EXITS SUCCESS. `NoCommitsYet` is an ANSWER: the read succeeded and the honest
// report is that there are no commits. Exiting nonzero there would tell a caller the read failed,
// which is the not-applicable-rendered-as-malformed conflation carried to an exit code -- opposite
// owners, opposite repairs, one signal.
fn scm_read_exit<T>(result: ScmReadResult<T>) -> ProcessExit {
  match result {
    ScmReadAnswered { path: _, answer: _ } => ExitSuccess
    ScmReadRepositoryUnavailable { cause: _ } =>
      exit_failure(reason: "repository unavailable")
  }
}

fn scm_log_cli_response(
  result: ScmReadResult<CommitLog>,
  target: RenderTarget,
  capability: RenderCapability
) -> CliWireResponse {
  cli_wire_response(
    doc: scm_log_document(result: result),
    target: target,
    capability: capability,
    exit: scm_read_exit(result: result),
  )
}

fn scm_status_cli_response(
  result: ScmReadResult<RepositoryStatus>,
  target: RenderTarget,
  capability: RenderCapability
) -> CliWireResponse {
  cli_wire_response(
    doc: scm_status_document(result: result),
    target: target,
    capability: capability,
    exit: scm_read_exit(result: result),
  )
}

// A WRITE VERB'S ANSWER. The read verbs answer with a document the repository already contains;
// a write verb answers with what the write DID, and its four outcomes are not one line with a
// flag -- each names a different thing that went wrong and a different next action.
//
// WHAT THESE LINES DELIBERATELY DO NOT SAY. The codec refusal carries a typed
// `RepositoryEncodeRefusal` (uncontained target, root not in store, checkout not in commits,
// duplicated reference, reference outside allocator, parent not in commits) and this renderer
// does not decompose it, so the operator learns THAT encoding refused and not WHICH invariant
// failed. That is a real loss and it is named here rather than hidden: rendering it needs a
// per-arm function over ObjectId and RepositoryCommitRef, which is its own change. The byte
// count on the success arm is likewise omitted rather than approximated.
fn repository_save_lines(save: RepositorySave) -> List<String> {
  match save {
    RepositorySaved { path: p, written: _ } =>
      [concat("wrote repository at ", p)]
    RepositorySaveRefusedByCodec { path: p, cause: _ } =>
      [
        concat("cannot encode repository for ", p),
        "  the envelope did not satisfy its own containment invariants"
      ]
    RepositoryFileUnwritable { path: p, error: e } =>
      [concat("cannot write repository at ", p), concat("  ", e)]
    RepositoryWriteByteCountUnrepresentable { path: p, reported: _ } =>
      [
        concat("wrote repository at ", p),
        "  but the host reported a byte count that is not a magnitude"
      ]
  }
}

// THE WRITE SUCCEEDED OR IT DID NOT, and the unrepresentable-count arm FAILS even though bytes
// reached the disk: a write whose reported size is not a magnitude has not been confirmed, and
// reporting success for it would be the fabricated-plausible-output §5 forbids.
fn scm_save_exit(save: RepositorySave) -> ProcessExit {
  match save {
    RepositorySaved { path: _, written: _ } => ExitSuccess
    RepositorySaveRefusedByCodec { path: _, cause: _ } =>
      exit_failure(reason: "repository not encodable")
    RepositoryFileUnwritable { path: _, error: _ } =>
      exit_failure(reason: "repository not writable")
    RepositoryWriteByteCountUnrepresentable { path: _, reported: _ } =>
      exit_failure(reason: "repository write unconfirmed")
  }
}

fn scm_save_document(save: RepositorySave) -> Document {
  text_lines_document(lines: repository_save_lines(save: save))
}

fn scm_save_cli_response(
  save: RepositorySave,
  target: RenderTarget,
  capability: RenderCapability
) -> CliWireResponse {
  cli_wire_response(
    doc: scm_save_document(save: save),
    target: target,
    capability: capability,
    exit: scm_save_exit(save: save),
  )
}

// A REFUSED INIT PRINTS WHY AND EXITS FAILURE. The two refusals render differently because the
// operator's next action differs: an existing repository is not a mistake to correct, while a
// foreign file at that path is a choice about someone else's bytes.
fn scm_init_lines(outcome: ScmInitOutcome) -> List<String> {
  match outcome {
    ScmInitialized { path: p, written: _ } =>
      [concat("initialized repository at ", p)]
    ScmInitWriteRefused { save: save } => repository_save_lines(save: save)
    ScmInitRefused { cause: cause } => scm_init_refusal_lines(cause: cause)
  }
}

// ONE SENTENCE FOR THE PROTOCOL FACT, so init and the read path cannot drift into describing the same
// observation two ways. It says what was DECLARED and that this build has no reader; it does not say a
// repository is present, because the decoder returned before validating any body.
fn unsupported_document_line(protocol: RepositoryDocumentProtocol) -> String {
  match protocol {
    RepositoryProtocolRetiredFormat { found: f } =>
      concat("the document declares retired repository format ", f)
    RepositoryProtocolUnrecognizedFormat { found: f } =>
      concat("the document declares unrecognized repository format ", f)
    RepositoryProtocolUnrecognizedIdentityRule { found: f } =>
      concat("the document declares unrecognized object identity rule ", f)
    RepositoryProtocolNotAProtocolRefusal => "the document could not be read as a repository"
  }
}

fn scm_init_refusal_lines(cause: ScmInitRefusal) -> List<String> {
  match cause {
    ScmInitRepositoryPresent { path: p } =>
      [
        concat("refusing to initialize ", p),
        "  a repository is already there, and init would replace its whole history"
      ]
    ScmInitUnsupportedDocumentPresent { path: p, protocol: protocol } =>
      [
        concat("refusing to initialize ", p),
        concat("  ", unsupported_document_line(protocol: protocol)),
        "  its contents were not validated, and init would destroy the bytes that are there"
      ]
    ScmInitForeignFilePresent { path: p } =>
      [
        concat("refusing to initialize ", p),
        "  a file is already there that is not a repository, and init would destroy it"
      ]
    ScmInitPathUnobserved { path: p, cause: c } =>
      [
        concat("refusing to initialize ", p),
        concat("  the path could not be observed, so nothing about it is established -- ", c)
      ]
    ScmInitNameNotAnEntry { name: n, cause: c } =>
      [
        concat("refusing to initialize ", n),
        concat("  that is not one entry of the directory, so no path was built from it -- ", c)
      ]
  }
}

fn scm_init_exit(outcome: ScmInitOutcome) -> ProcessExit {
  match outcome {
    ScmInitialized { path: _, written: _ } => ExitSuccess
    ScmInitWriteRefused { save: save } => scm_save_exit(save: save)
    ScmInitRefused { cause: cause } => scm_init_refusal_exit(cause: cause)
  }
}

fn scm_init_refusal_exit(cause: ScmInitRefusal) -> ProcessExit {
  match cause {
    ScmInitRepositoryPresent { path: _ } =>
      exit_failure(reason: "repository already present")
    ScmInitUnsupportedDocumentPresent { path: _, protocol: _ } =>
      exit_failure(reason: "path occupied by a document declaring a protocol this build does not read")
    ScmInitForeignFilePresent { path: _ } =>
      exit_failure(reason: "path occupied by a non-repository file")
    ScmInitPathUnobserved { path: _, cause: _ } =>
      exit_failure(reason: "path could not be observed")
    ScmInitNameNotAnEntry { name: _, cause: _ } =>
      exit_failure(reason: "name is not one entry of the directory")
  }
}

fn scm_init_cli_response(
  outcome: ScmInitOutcome,
  target: RenderTarget,
  capability: RenderCapability
) -> CliWireResponse {
  cli_wire_response(
    doc: text_lines_document(lines: scm_init_lines(outcome: outcome)),
    target: target,
    capability: capability,
    exit: scm_init_exit(outcome: outcome),
  )
}


// ------------------------------------------------------------------------------------------------
// The write verbs
// ------------------------------------------------------------------------------------------------

// A PUBLICATION'S OUTCOME, AND THE TWO REFUSALS THAT ARE NOT FAULTS IN THE DOCUMENT.
//
// A changed base and an unestablished lock both leave two perfectly valid repositories behind; what
// failed is applying a derivation made against one on top of the other. So neither line tells the
// operator their repository is broken, and the base-changed line says what to DO -- re-run against the
// new document -- because the remedy is not obvious from the refusal alone.
//
// THE LOCK LINE DOES NOT SAY THE LOCK IS HELD. gunbc.scm.repository_save states why: the create-only
// write's failure channel equally covers an existing lock, an unwritable directory and a full disk, so
// naming the busy case would be asserting a cause that was never observed. It names the path and
// repeats the host's own error, which is what an operator can act on.
fn repository_publication_lines(publication: RepositoryPublication) -> List<String> {
  match publication {
    RepositoryPublished { path: _, save: save } => repository_save_lines(save: save)
    PublicationLockNotEstablished { path: p, lock_path: lock, error: e } =>
      [
        concat("cannot claim the right to publish to ", p),
        concat("  the publication lock at ", concat(lock, " could not be created")),
        concat("  ", e),
      ]
    PublicationBaseChanged { path: p } =>
      [
        concat("refused to publish to ", p),
        "  the document changed after this command read it, so publishing would discard that change",
        "  nothing was written; re-run this command to apply it to the current document",
      ]
    PublicationBaseUnreadable { path: p, error: e } =>
      [concat("cannot re-read ", concat(p, " to publish against it")), concat("  ", e)]
  }
}

fn scm_publication_exit(publication: RepositoryPublication) -> ProcessExit {
  match publication {
    RepositoryPublished { path: _, save: save } => scm_save_exit(save: save)
    PublicationLockNotEstablished { path: _, lock_path: _, error: _ } =>
      exit_failure(reason: "publication lock not established")
    PublicationBaseChanged { path: _ } => exit_failure(reason: "publication base changed")
    PublicationBaseUnreadable { path: _, error: _ } =>
      exit_failure(reason: "publication base unreadable")
  }
}

fn staging_refusal_lines(cause: StagingRefusal) -> List<String> {
  match cause {
    StagePathEmpty => ["the path to stage is empty"]
    StageSourceLocatorCollision { identity: _, existing: _, incoming: _ } =>
      ["the staged file collides with a different object already under its identity"]
    StageManifestMissingFromStore { staged: _ } =>
      ["the staged corpus names a snapshot this repository's object store does not hold"]
    StageManifestIsAuthoredSource { staged: _ } =>
      ["the staged corpus names a file where a snapshot belongs"]
    StageManifestIsSemanticNode { staged: _ } =>
      ["the staged corpus names a program where a snapshot belongs"]
    StageBaseUnresolved { reference: _ } =>
      ["the checked-out selection names a commit this repository does not contain"]
    StageBaseManifestMissingFromStore { root: _ } =>
      ["the checked-out commit names a snapshot this repository's object store does not hold"]
    StageBaseManifestIsAuthoredSource { root: _ } =>
      ["the checked-out commit names a file where a snapshot belongs"]
    StageBaseManifestIsSemanticNode { root: _ } =>
      ["the checked-out commit names a program where a snapshot belongs"]
    StageManifestDuplicatePath { path: p } =>
      [concat("the staged corpus binds one path twice: ", p as String)]
    StageManifestLocatorCollision { identity: _, existing: _, incoming: _ } =>
      ["the staged corpus collides with a different object already under its identity"]
  }
}

fn scm_add_lines(result: ScmWriteResult<StagingOutcome>) -> List<String> {
  match result {
    ScmWrote { path: _, applied: _, publication: publication } =>
      repository_publication_lines(publication: publication)
    ScmWriteRepositoryUnavailable { cause: cause } => repository_load_refusal_lines(cause: cause)
    ScmWriteSourceUnreadable { path: p, error: e } =>
      [concat("cannot read ", p), concat("  ", e)]
    ScmWriteVerbRefused { path: _, cause: cause } => staging_refusal_lines(cause: cause)
  }
}

fn scm_add_exit(result: ScmWriteResult<StagingOutcome>) -> ProcessExit {
  match result {
    ScmWrote { path: _, applied: _, publication: publication } =>
      scm_publication_exit(publication: publication)
    ScmWriteRepositoryUnavailable { cause: _ } => exit_failure(reason: "repository unavailable")
    ScmWriteSourceUnreadable { path: _, error: _ } => exit_failure(reason: "source unreadable")
    ScmWriteVerbRefused { path: _, cause: _ } => exit_failure(reason: "nothing staged")
  }
}

fn scm_add_cli_response(
  result: ScmWriteResult<StagingOutcome>,
  target: RenderTarget,
  capability: RenderCapability
) -> CliWireResponse {
  cli_wire_response(
    doc: text_lines_document(lines: scm_add_lines(result: result)),
    target: target,
    capability: capability,
    exit: scm_add_exit(result: result),
  )
}

// NOTHING TO COMMIT IS NOT A FAILURE, AND ITS LINE SAYS WHICH NOTHING IT IS. An empty repository and
// a repository whose candidate already matches its base are different situations with different next
// actions, and a single "nothing to commit" would make them one.
fn scm_commit_lines(result: ScmCommitResult) -> List<String> {
  match result {
    ScmCommitted { path: _, publication: publication } =>
      repository_publication_lines(publication: publication)
    ScmCommitRepositoryUnavailable { cause: cause } => repository_load_refusal_lines(cause: cause)
    ScmCommitCandidateRefused { path: _, cause: cause } => staging_refusal_lines(cause: cause)
    ScmCommitMintRefused { path: _, mint: _ } =>
      ["the commit could not be minted from the staged corpus"]
    ScmCommitNothingToCommit { path: _, standing: standing } =>
      match standing {
        NoCandidateAndNoBase => ["nothing to commit: no corpus has been staged"]
        StageMatchesBase { candidate: _ } =>
          ["nothing to commit: the staged corpus matches the checked-out commit"]
        StageDiffersFromBase { candidate: _, committed: _ } =>
          ["nothing to commit was reported for a corpus that differs from its base"]
        StageWithNoBase { candidate: _ } =>
          ["nothing to commit was reported for a corpus with no base"]
        StageStandingRefused { cause: cause } => staging_refusal_lines(cause: cause)
      }
  }
}

// THE TWO IMPOSSIBLE STANDINGS ABOVE EXIT FAILURE RATHER THAN SUCCESS. `commit_staged` returns
// NothingToCommit only for the matching and empty standings, so a differing candidate arriving there
// means this renderer and that verb disagree -- and the honest report of a disagreement between two
// authorities is a failure, not a reassuring line printed with exit 0.
fn scm_commit_exit(result: ScmCommitResult) -> ProcessExit {
  match result {
    ScmCommitted { path: _, publication: publication } =>
      scm_publication_exit(publication: publication)
    ScmCommitRepositoryUnavailable { cause: _ } => exit_failure(reason: "repository unavailable")
    ScmCommitCandidateRefused { path: _, cause: _ } => exit_failure(reason: "staged corpus unreadable")
    ScmCommitMintRefused { path: _, mint: _ } => exit_failure(reason: "commit not mintable")
    ScmCommitNothingToCommit { path: _, standing: standing } =>
      match standing {
        NoCandidateAndNoBase => ExitSuccess
        StageMatchesBase { candidate: _ } => ExitSuccess
        StageDiffersFromBase { candidate: _, committed: _ } =>
          exit_failure(reason: "commit verb and standing disagree")
        StageWithNoBase { candidate: _ } =>
          exit_failure(reason: "commit verb and standing disagree")
        StageStandingRefused { cause: _ } => exit_failure(reason: "staged corpus unreadable")
      }
  }
}

fn scm_commit_cli_response(
  result: ScmCommitResult,
  target: RenderTarget,
  capability: RenderCapability
) -> CliWireResponse {
  cli_wire_response(
    doc: text_lines_document(lines: scm_commit_lines(result: result)),
    target: target,
    capability: capability,
    exit: scm_commit_exit(result: result),
  )
}
