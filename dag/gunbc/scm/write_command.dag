module gunbc.scm.write_command

// WHAT A WRITE-SIDE SCM COMMAND PRODUCES, WITH NO IDEA WHERE IT IS GOING.
//
// The mirror of gunbc.scm.read_command, and split from it for the reason repository_save is split
// from repository_load: reading and writing are two directions with different failure populations,
// consumed separately. A read verb composes load-then-ask; a write verb composes
// LOAD-THEN-ACT-THEN-SAVE, which is three steps and three ways to fail, and the third one is the
// reason this module exists rather than each verb restating it.
//
// NOTHING HERE CHOOSES A DESTINATION OR A PHRASING, as on the read side.
//
// ---------------------------------------------------------------------------------------------
// EVERY WRITE VERB PUBLISHES CONDITIONALLY. NONE OF THEM SAVES.
// ---------------------------------------------------------------------------------------------
//
// Both verbs below load a document, derive a new envelope from it, and write. Written with
// `save_repository` -- whose write is unconditional, correctly, for its own subject -- that is a lost
// update: two overlapping `add` invocations load the same document and the second write discards the
// first one's binding, silently and with a success report. An `add` can equally discard a commit that
// was published between its load and its write.
//
// So neither verb calls it. Both call `publish_repository`, which takes the document THIS operation
// decoded its base from and writes only if the path still holds it, under an exclusion established by
// a create-only lock. The mechanism, the two residual gaps it does not close, and the next-rung
// trigger are all stated at that function; they are not restated here, because a second copy of a
// safety claim is a second thing to keep true.
//
// WHAT THAT MEANS FOR THESE VERBS: a concurrent change makes them REFUSE, located, with the caller's
// derivation intact and unpublished. It does not make them merge, retry, or rebase. Re-running the
// verb against the new base is the caller's decision, and this module does not take it for them --
// an automatic retry would re-read a document the author has not seen and apply an intent formed
// against different content.
//
// NOTHING HERE NAMES A DESTINATION OR CHOOSES A PHRASING, as on the read side.

import std.types { String }
import extdeps.filesystem.filesystem_io
import extdeps.filesystem.filesystem_io {
  FilesystemReadSucceeded,
  FilesystemReadRefused,
  filesystem_read_outcome,
}
import gunbc.scm.repository_load {
  RepositoryLoaded,
  RepositoryLoadRefused,
  RepositoryLoadRefusal,
  load_repository,
}
import gunbc.scm.repository_save {
  RepositorySave,
  RepositorySaved,
  RepositorySaveRefusedByCodec,
  RepositoryFileUnwritable,
  RepositoryWriteByteCountUnrepresentable,
  RepositoryPublication,
  RepositoryPublished,
  PublicationLockNotEstablished,
  PublicationBaseChanged,
  PublicationBaseUnreadable,
  publish_repository,
}
import gunbc.scm.staging {
  StagingRefusal,
  StagingOutcome,
  Staged,
  StagingRefused,
  StagedCommit,
  StagedCommitted,
  NothingToCommit,
  StagedCommitRefused,
  StagedCommitCandidateRefused,
  StageStanding,
  RepositoryCommitMint,
  stage_authored_source,
  commit_staged,
}

// THE FOUR WAYS A WRITE VERB ENDS, AND THEY HAVE FOUR DIFFERENT OWNERS.
//
//   repository unavailable   the document could not be loaded. Nothing was attempted.
//   source unreadable        the host could not read the file being staged. Nothing was attempted.
//   verb refused             the repository was loaded and the OPERATION does not apply -- a path
//                            that names nothing, a stage that is not there, nothing to commit.
//                            Nothing was written.
//   published                the operation applied and publication was attempted; the
//                            `RepositoryPublication` carries what happened -- written, refused by a
//                            concurrent change, or blocked on the publication lock -- and it carries
//                            it rather than this type flattening it, because those arms have their
//                            own owners that repository_save's header separates.
//
// NOTHING WAS WRITTEN IS THE INVARIANT OF THE FIRST THREE ARMS, and it holds by construction: the
// save call is reached only on the success path of the act, so no arm here reports a refusal for an
// operation that had already touched the document.
type ScmWriteResult<T>
  = ScmWrote { path: String, applied: T, publication: RepositoryPublication }
  | ScmWriteRepositoryUnavailable { cause: RepositoryLoadRefusal }
  | ScmWriteSourceUnreadable { path: String, error: String }
  | ScmWriteVerbRefused { path: String, cause: StagingRefusal }

// A COMMIT REFUSES DIFFERENTLY FROM AN ADD, so it has its own refusal arms rather than being forced
// through StagingRefusal. "There is nothing staged" and "the stage names a manifest this store does
// not hold" are not the same fact, and the mint's own refusal population -- an invalid allocator, a
// parent that is not there -- belongs to the mint and is carried whole.
type ScmCommitResult
  = ScmCommitted { path: String, publication: RepositoryPublication }
  | ScmCommitRepositoryUnavailable { cause: RepositoryLoadRefusal }
  | ScmCommitNothingToCommit { path: String, standing: StageStanding }
  | ScmCommitCandidateRefused { path: String, cause: StagingRefusal }
  | ScmCommitMintRefused { path: String, mint: RepositoryCommitMint }

// `add <path>`: READ THE FILE, BIND ITS PATH IN THE STAGE, WRITE THE DOCUMENT.
//
// THE CORPUS PATH AND THE HOST PATH ARE TWO ARGUMENTS, NOT ONE, and that is the load-bearing shape.
// `corpus_path` is the name the manifest binds and the name a checkout will recreate; `source_path`
// is where the bytes are read from right now. They coincide for an ordinary `add` in a working
// directory and they are not the same fact: deriving one from the other would put the working
// directory's layout into the committed snapshot, so a repository checked out elsewhere would carry
// the original author's paths.
//
// AN UNREADABLE SOURCE REFUSES AND DOES NOT STAGE AN EMPTY FILE. `AuthoredSourceEmpty` is a real
// content -- the empty file is its own object, with its own identity -- so admitting a failed read as
// empty content would freeze a file the author never wrote and would do it silently, since the
// resulting manifest is perfectly well-formed. The success channel is what separates them, which is
// why the whole observation is folded rather than the content projected out of it.
fn scm_add(path: String, corpus_path: String, source_path: String) -> ScmWriteResult<StagingOutcome> {
  match load_repository(path: path) {
    RepositoryLoadRefused { cause: cause } => ScmWriteRepositoryUnavailable { cause: cause }
    RepositoryLoaded { path: p, envelope: envelope, document: document } => {
      let read = Filesystem.Read(path: source_path)
      match filesystem_read_outcome(content: read.content, success: read.success, error: read.error) {
        FilesystemReadRefused { error: e } => ScmWriteSourceUnreadable { path: source_path, error: e }
        FilesystemReadSucceeded { content: content } =>
          match stage_authored_source(repository: envelope, path: corpus_path, text: content) {
            StagingRefused { cause: cause } => ScmWriteVerbRefused { path: p, cause: cause }
            Staged { repository: staged_repo, staged: staged } =>
              ScmWrote {
                path: p,
                applied: Staged { repository: staged_repo, staged: staged },
                publication: publish_repository(
                  path: p,
                  expected: document,
                  repo: staged_repo,
                ),
              }
          }
      }
    }
  }
}

fn scm_commit(path: String, message: String) -> ScmCommitResult {
  match load_repository(path: path) {
    RepositoryLoadRefused { cause: cause } => ScmCommitRepositoryUnavailable { cause: cause }
    RepositoryLoaded { path: p, envelope: envelope, document: document } =>
      match commit_staged(repository: envelope, message: message) {
        NothingToCommit { standing: standing } =>
          ScmCommitNothingToCommit { path: p, standing: standing }
        StagedCommitCandidateRefused { cause: cause } =>
          ScmCommitCandidateRefused { path: p, cause: cause }
        StagedCommitRefused { mint: mint } => ScmCommitMintRefused { path: p, mint: mint }
        StagedCommitted { repository: committed, reference: _ } =>
          ScmCommitted {
            path: p,
            publication: publish_repository(path: p, expected: document, repo: committed),
          }
      }
  }
}
