module gunbc.compile_pool_ensure


data compile_pool_ensure_scope_disposition: std.disposition.Disposition = std.disposition.SingleAuthority

data ensure_is_idempotent_note: String = "THE COMPILE-POOL SLICE IS A RECONCILE TARGET, NOT AN INSTALL-ON-EVERY-PASS MUTATION. A slice whose memory.max and memory.high already match the derived pool size is EnsureAlreadyConverged — writing the unit again would churn systemd and risk a brief cgroup reset while cache-miss compilers are the slice's children. The admission therefore compares OBSERVED limits against the sizing authority before emitting lines, exactly as build_cache_ensure consults placement before rendering a cache unit."

type CompilePoolEnsureRefusal
  = EnsurePoolTopologyUndeclared { detail: std.types.NonEmptyStr }
  | EnsurePoolSizingUnresolved { detail: std.types.NonEmptyStr }
  | EnsureCachePlacementUnknown { detail: std.types.NonEmptyStr }
  | EnsurePoolSliceUnobservable { detail: std.types.NonEmptyStr }
  | EnsurePoolSliceNamedDoesNotMatch { declared: std.types.NonEmptyStr, observed: std.types.NonEmptyStr }

type EnsureCompilePoolAdmission
  = EnsureCompilePoolAlreadyConverged { slice_unit: std.types.NonEmptyStr, sized_bytes: std.measure.ByteSize }
  | EnsureCompilePoolAdmitted { slice_unit: std.types.NonEmptyStr, sized_bytes: std.measure.ByteSize, slice_unit_file: extdeps.systemd.unit_file.SystemdUnitFile }
  | EnsureCompilePoolRefused { reason: CompilePoolEnsureRefusal }

data cache_placement_unknown_refuses_note: String = "A SERVER WHOSE PLACEMENT CANNOT BE ESTABLISHED IS NOT A CONVERGED SERVER, and ensuring a compile pool beside it would be deciding to parent every cache-miss compiler under a slice whose sibling cache endpoint may still be runner-owned or unread. ServerPlacementUnknown therefore refuses BEFORE slice observation is consulted — the same ordering build_cache_ensure uses for placement-unknown before path state, and for the same reason: unknown is not a positive reading that permits host mutation."

type EnsureCompilePoolAdmissionFold<R> {
  already_converged: fn(std.types.NonEmptyStr, std.measure.ByteSize) -> R
  admitted: fn(std.types.NonEmptyStr, std.measure.ByteSize, extdeps.systemd.unit_file.SystemdUnitFile) -> R
  refused: fn(CompilePoolEnsureRefusal) -> R
}

fn ensure_compile_pool_admission_fold<R>(
  admission: EnsureCompilePoolAdmission,
  fold: EnsureCompilePoolAdmissionFold<R>,
) -> R {
  match admission {
    EnsureCompilePoolAlreadyConverged { slice_unit: u, sized_bytes: b } =>
      fold.already_converged(u, b)
    EnsureCompilePoolAdmitted { slice_unit: u, sized_bytes: b, slice_unit_file: f } =>
      fold.admitted(u, b, f)
    EnsureCompilePoolRefused { reason: r } => fold.refused(r)
  }
}

fn slice_limits_match_declared(limits: gunbc.build_cache_instance.CgroupMemoryLimits, required: std.measure.ByteSize) -> Bool {
  (std.measure.byte_size_count(b: limits.memory_max) == std.measure.byte_size_count(b: required))
    && (std.measure.byte_size_count(b: limits.memory_high) == std.measure.byte_size_count(b: required))
}

fn slice_already_converged(
  observed: gunbc.host_compile_pool.CompilePoolObservation,
  declared: std.types.NonEmptyStr,
  required: std.measure.ByteSize,
) -> Bool {
  match observed {
    gunbc.host_compile_pool.CompilePoolSliceObserved { slice_unit: u, limits: lim } =>
      ((u as String) == (declared as String)) && slice_limits_match_declared(limits: lim, required: required)
    gunbc.host_compile_pool.CompilePoolSliceAbsent { slice_unit: _ } => false
    gunbc.host_compile_pool.CompilePoolObservationUnavailable { reason: _ } => false
  }
}

fn ensure_compile_pool_slice_from_observation(
  declared: String,
  sized: std.measure.ByteSize,
  observed: gunbc.host_compile_pool.CompilePoolObservation,
) -> EnsureCompilePoolAdmission {
  match slice_already_converged(observed: observed, declared: declared as std.types.NonEmptyStr, required: sized) {
    true =>
      EnsureCompilePoolAlreadyConverged {
        slice_unit: declared as std.types.NonEmptyStr,
        sized_bytes: sized,
      }
    false =>
      match observed {
        gunbc.host_compile_pool.CompilePoolObservationUnavailable { reason: r } =>
          EnsureCompilePoolRefused {
            reason: EnsurePoolSliceUnobservable {
              detail: gunbc.build_cache_instance.unavailable_reason_detail(reason: r),
            },
          }
        gunbc.host_compile_pool.CompilePoolSliceAbsent { slice_unit: _ } =>
          EnsureCompilePoolAdmitted {
            slice_unit: declared as std.types.NonEmptyStr,
            sized_bytes: sized,
            slice_unit_file: gunbc.build_cache_unit.compile_pool_slice_unit_file(slice_unit: declared as std.types.NonEmptyStr, sized: sized),
          }
        gunbc.host_compile_pool.CompilePoolSliceObserved { slice_unit: obs, limits: _ } =>
          match (obs as String) == declared {
            false =>
              EnsureCompilePoolRefused {
                reason: EnsurePoolSliceNamedDoesNotMatch {
                  declared: declared as std.types.NonEmptyStr,
                  observed: obs,
                },
              }
            true =>
              EnsureCompilePoolAdmitted {
                slice_unit: declared as std.types.NonEmptyStr,
                sized_bytes: sized,
                slice_unit_file: gunbc.build_cache_unit.compile_pool_slice_unit_file(slice_unit: declared as std.types.NonEmptyStr, sized: sized),
              }
          }
      }
  }
}

fn admit_ensure_compile_pool_slice(
  topology: gunbc.host_layout.CompilePoolPlacement,
  sizing: gunbc.fleet_host_budget.CompilePoolResolution,
  cache_placement: gunbc.build_cache_instance.BuildCacheServerPlacement,
  observed: gunbc.host_compile_pool.CompilePoolObservation,
) -> EnsureCompilePoolAdmission {
  match topology {
    gunbc.host_layout.CompilePoolInRunnerSlots =>
      EnsureCompilePoolRefused {
        reason: EnsurePoolTopologyUndeclared {
          detail: "gunbc_compile_pool_placement is CompilePoolInRunnerSlots: no managed compile-pool slice is declared, so there is no pool unit to ensure" as std.types.NonEmptyStr,
        },
      }
    gunbc.host_layout.CompilePoolSliceDeclared { slice_unit: declared } =>
      match sizing {
        gunbc.fleet_host_budget.CompilePoolUnresolved { reason: sr } =>
          EnsureCompilePoolRefused {
            reason: EnsurePoolSizingUnresolved { detail: sr as std.types.NonEmptyStr },
          }
        gunbc.fleet_host_budget.CompilePoolDerived { bytes: b } =>
          match cache_placement {
            gunbc.build_cache_instance.ServerPlacementUnknown { detail: d } =>
              EnsureCompilePoolRefused {
                reason: EnsureCachePlacementUnknown { detail: d },
              }
            gunbc.build_cache_instance.ServerManagedUnitOwned { unit: _ } =>
              ensure_compile_pool_slice_from_observation(
                declared: declared,
                sized: b,
                observed: observed,
              )
            gunbc.build_cache_instance.ServerRunnerOwned { slot: _, lifecycle: _ } =>
              ensure_compile_pool_slice_from_observation(
                declared: declared,
                sized: b,
                observed: observed,
              )
            gunbc.build_cache_instance.ServerUnsupervised { cgroup: _ } =>
              ensure_compile_pool_slice_from_observation(
                declared: declared,
                sized: b,
                observed: observed,
              )
            gunbc.build_cache_instance.ServerPlacementAbsent =>
              ensure_compile_pool_slice_from_observation(
                declared: declared,
                sized: b,
                observed: observed,
              )
          }
      }
  }
}

fn ensure_yields_slice(admission: EnsureCompilePoolAdmission) -> Bool {
  ensure_compile_pool_admission_fold(
    admission: admission,
    fold: EnsureCompilePoolAdmissionFold {
      already_converged: fn(_, _) { false },
      admitted: fn(_, _, _) { true },
      refused: fn(_) { false },
    },
  )
}

// Named for its admission type, not generically. This was `ensure_is_converged` and collided with
// gunbc.build_cache_ensure's identically-spelled helper over EnsureBuildCacheAdmission, which both witness
// modules reference bare — see that module's annotation on build_cache_ensure_is_converged for the full
// account, including the selection-invariance defect that hid the collision from this PR's own CI.
fn compile_pool_ensure_is_converged(admission: EnsureCompilePoolAdmission) -> Bool {
  ensure_compile_pool_admission_fold(
    admission: admission,
    fold: EnsureCompilePoolAdmissionFold {
      already_converged: fn(_, _) { true },
      admitted: fn(_, _, _) { false },
      refused: fn(_) { false },
    },
  )
}
