module gunbc.bmc_fan_monitor


type BmcFanMonitoringSample {
  elapsed: std.measure.Second
  safety_refusal: String?
}

type BmcFanMonitoringReceipt {
  sample_count: Int
  elapsed: std.measure.Second
  required_elapsed: std.measure.Second
  maximum_sample_gap: std.measure.Second
}

type BmcFanMonitoringResult
  = BmcFanMonitoringCompleted { receipt: BmcFanMonitoringReceipt }
  | BmcFanMonitoringRefused {
      reason: String,
      receipt: BmcFanMonitoringReceipt,
    }

fn bmc_fan_assess_monitoring_samples_rec(
  remaining: List<BmcFanMonitoringSample>,
  previous_elapsed: std.measure.Second,
  sample_count: Int,
  required_elapsed: std.measure.Second,
  maximum_sample_gap: std.measure.Second,
) -> BmcFanMonitoringResult {
  if remaining.length() == 0 {
    let receipt = BmcFanMonitoringReceipt {
      sample_count: sample_count,
      elapsed: previous_elapsed,
      required_elapsed: required_elapsed,
      maximum_sample_gap: maximum_sample_gap,
    }
    if sample_count == 0 {
      BmcFanMonitoringRefused {
        reason: "post-restart monitoring produced no safety samples",
        receipt: receipt,
      }
    } else if second_count(previous_elapsed) >= second_count(required_elapsed) {
      BmcFanMonitoringCompleted {
        receipt: receipt,
      }
    } else {
      BmcFanMonitoringRefused {
        reason: "post-restart monitoring window ended before its admitted bound",
        receipt: receipt,
      }
    }
  } else {
    let sample = remaining.first()
    let sample_gap_seconds = second_count(sample.elapsed) - second_count(previous_elapsed)
    let receipt = BmcFanMonitoringReceipt {
      sample_count: sample_count + 1,
      elapsed: sample.elapsed,
      required_elapsed: required_elapsed,
      maximum_sample_gap: maximum_sample_gap,
    }
    if second_count(sample.elapsed) <= second_count(previous_elapsed) {
      BmcFanMonitoringRefused {
        reason: "post-restart monitoring samples are not strictly time-ordered",
        receipt: receipt,
      }
    } else if sample_gap_seconds > second_count(maximum_sample_gap) {
      BmcFanMonitoringRefused {
        reason: "post-restart monitoring sample gap exceeded its admitted cadence",
        receipt: receipt,
      }
    } else {
      match sample.safety_refusal {
        Present { value: reason } =>
          BmcFanMonitoringRefused { reason: reason, receipt: receipt }
        Absent =>
          bmc_fan_assess_monitoring_samples_rec(
            remaining: remaining.skip(n: 1),
            previous_elapsed: sample.elapsed,
            sample_count: sample_count + 1,
            required_elapsed: required_elapsed,
            maximum_sample_gap: maximum_sample_gap,
          )
      }
    }
  }
}

fn bmc_fan_assess_monitoring_samples(
  samples: List<BmcFanMonitoringSample>,
  required_elapsed: std.measure.Second,
  maximum_sample_gap: std.measure.Second,
) -> BmcFanMonitoringResult {
  if second_count(required_elapsed) <= 0 || second_count(maximum_sample_gap) <= 0 {
    BmcFanMonitoringRefused {
      reason: "post-restart monitoring bound and maximum sample gap must be positive",
      receipt: BmcFanMonitoringReceipt {
        sample_count: 0,
        elapsed: second(0),
        required_elapsed: required_elapsed,
        maximum_sample_gap: maximum_sample_gap,
      },
    }
  } else {
    bmc_fan_assess_monitoring_samples_rec(
      remaining: samples,
      previous_elapsed: second(0),
      sample_count: 0,
      required_elapsed: required_elapsed,
      maximum_sample_gap: maximum_sample_gap,
    )
  }
}
