module gunbc.roadmap_spawner

import gunbc.roadmap_model {
  RoadmapNode, RoadmapEdge, Pointer, RoadmapNodeId,
  Intricacy, IntricacyLow, IntricacyMedium, IntricacyHigh,
  Volume, VolumeSmall, VolumeMedium, VolumeLarge,
  Acceptance, PrsMerged, ManualAcceptance,
  NodeSizing, Unsized, Sized,
  SectionElement, Prose, Group, SectionGroup,
  RoadmapParent, TopLevel, UnderParent, roadmap_parent,
}
import gunbc.roadmap_status { RoadmapItem, DerivableLine, AuthoredLine, PlainLine, SupersededLine, item_is_done, item_superseded_by }
import gunbc.roadmap_document { RoadmapDocument, RoadmapSection }
import gunbc.roadmap_authority { roadmap_authority, authored_merged_prs }
import extdeps.languages.json.emit {
  JsonValue, JsonNull,
  serialize_json,
  quote_json_string,
  json_null,
  json_string,
  json_int,
  json_array,
  json_object,
  json_kv,
  json_str_list,
}

fn element_nodes(e: SectionElement) -> List<RoadmapNode> {
  match e {
    Prose { prose: _ } => []
    Group { group } => group.nodes
  }
}

fn element_edges(e: SectionElement) -> List<RoadmapEdge> {
  match e {
    Prose { prose: _ } => []
    Group { group } => group.edges
  }
}

fn section_nodes(s: RoadmapSection) -> List<RoadmapNode> {
  fold(s.elements, init: [], f: (acc, e) => concat(acc, element_nodes(e: e)))
}

fn section_edges(s: RoadmapSection) -> List<RoadmapEdge> {
  fold(s.elements, init: [], f: (acc, e) => concat(acc, element_edges(e: e)))
}

fn doc_all_nodes(doc: RoadmapDocument) -> List<RoadmapNode> {
  let lane_nodes = fold(doc.lead_lanes, init: [], f: (acc, s) => concat(acc, section_nodes(s: s)))
  fold(doc.sections, init: lane_nodes, f: (acc, s) => concat(acc, section_nodes(s: s)))
}

fn doc_all_edges(doc: RoadmapDocument) -> List<RoadmapEdge> {
  let lane_edges = fold(doc.lead_lanes, init: [], f: (acc, s) => concat(acc, section_edges(s: s)))
  fold(doc.sections, init: lane_edges, f: (acc, s) => concat(acc, section_edges(s: s)))
}

fn node_parent_ids(edges: List<RoadmapEdge>, id: RoadmapNodeId) -> List<RoadmapNodeId> {
  edges |> filter(e => e.child == id) |> map(e => e.parent)
}

fn node_dep_done(nodes: List<RoadmapNode>, edges: List<RoadmapEdge>, id: RoadmapNodeId, merged: List<Int>) -> Bool {
  all(node_parent_ids(edges: edges, id: id), pid =>
    any(nodes, n => n.node == pid && item_is_done(item: n.line, merged: merged)))
}

fn node_is_spawnable(n: RoadmapNode, nodes: List<RoadmapNode>, edges: List<RoadmapEdge>, merged: List<Int>) -> Bool {
  match n.sizing {
    Unsized => false
    Sized { intricacy: _, volume: _, repo: _, acceptance: _ } =>
      !item_is_done(item: n.line, merged: merged)
        && node_dep_done(nodes: nodes, edges: edges, id: n.node, merged: merged)
  }
}

fn next_spawnable(doc: RoadmapDocument, merged: List<Int>) -> List<RoadmapNode> {
  let nodes = doc_all_nodes(doc: doc)
  let edges = doc_all_edges(doc: doc)
  nodes |> filter(n => node_is_spawnable(n: n, nodes: nodes, edges: edges, merged: merged))
}

fn node_is_sized(n: RoadmapNode) -> Bool {
  match n.sizing {
    Unsized => false
    Sized { intricacy: _, volume: _, repo: _, acceptance: _ } => true
  }
}

fn node_is_upcoming(n: RoadmapNode, nodes: List<RoadmapNode>, edges: List<RoadmapEdge>, merged: List<Int>) -> Bool {
  node_is_sized(n: n)
    && !item_is_done(item: n.line, merged: merged)
    && !node_dep_done(nodes: nodes, edges: edges, id: n.node, merged: merged)
}

fn node_is_frontier_done(n: RoadmapNode, merged: List<Int>) -> Bool {
  node_is_sized(n: n) && item_is_done(item: n.line, merged: merged)
}

type SpawnFrontier {
  ready: List<RoadmapNode>
  upcoming: List<RoadmapNode>
  done: List<RoadmapNode>
  superseded: List<RoadmapNode>
}

fn node_is_superseded(n: RoadmapNode) -> Bool {
  !(item_superseded_by(item: n.line) == "")
}

fn spawn_frontier(doc: RoadmapDocument, merged: List<Int>) -> SpawnFrontier {
  let nodes = doc_all_nodes(doc: doc)
  let edges = doc_all_edges(doc: doc)
  SpawnFrontier {
    ready: next_spawnable(doc: doc, merged: merged),
    upcoming: nodes |> filter(n => node_is_upcoming(n: n, nodes: nodes, edges: edges, merged: merged)),
    done: nodes |> filter(n => node_is_frontier_done(n: n, merged: merged)),
    superseded: nodes |> filter(n => node_is_superseded(n: n)),
  }
}

fn json_str(s: String) -> String {
  quote_json_string(s: s)
}

fn intricacy_str(i: Intricacy) -> String {
  match i {
    IntricacyLow => "low"
    IntricacyMedium => "medium"
    IntricacyHigh => "high"
  }
}

fn volume_str(v: Volume) -> String {
  match v {
    VolumeSmall => "small"
    VolumeMedium => "medium"
    VolumeLarge => "large"
  }
}

fn acceptance_json_value(a: Acceptance, line: RoadmapItem) -> JsonValue {
  match a {
    PrsMerged => match line {
      DerivableLine { prs, title: _, description: _ } =>
        json_object(members: [
          json_kv(key: "kind", value: json_string(s: "prs_merged")),
          json_kv(key: "prs", value: json_array(elements: prs |> map(n => json_int(n: n)))),
        ])
      AuthoredLine { done: _, content: _ } =>
        json_object(members: [
          json_kv(key: "kind", value: json_string(s: "prs_merged_model_error")),
          json_kv(key: "prs", value: json_array(elements: [])),
        ])
      PlainLine { content: _ } =>
        json_object(members: [
          json_kv(key: "kind", value: json_string(s: "prs_merged_model_error")),
          json_kv(key: "prs", value: json_array(elements: [])),
        ])
      SupersededLine { by: _, content: _ } =>
        json_object(members: [
          json_kv(key: "kind", value: json_string(s: "prs_merged_model_error")),
          json_kv(key: "prs", value: json_array(elements: [])),
        ])
    }
    ManualAcceptance =>
      json_object(members: [
        json_kv(key: "kind", value: json_string(s: "manual")),
      ])
  }
}

fn node_title(item: RoadmapItem) -> String {
  match item {
    DerivableLine { prs: _, title, description: _ } => title
    AuthoredLine { done: _, content } => content
    PlainLine { content } => content
    SupersededLine { by: _, content } => content
  }
}

fn node_plan_doc_json(carriers: List<Pointer>) -> JsonValue {
  let plans = carriers |> filter(p => p.label == "plan")
  if count(plans) > 0 {
    fold(plans, init: json_null(), f: (acc, p) => match acc {
      JsonNull => json_string(s: p.path)
      _ => acc
    })
  } else {
    json_null()
  }
}

fn node_json_value(n: RoadmapNode, intricacy: Intricacy, volume: Volume, repo: String, acceptance: Acceptance, edges: List<RoadmapEdge>) -> JsonValue {
  let parent_id_value = match roadmap_parent(edges: edges, node: n.node) {
    TopLevel => json_null()
    UnderParent { parent: pid } => json_string(s: pid)
  }
  let owner_value = if n.owner == "" { json_null() } else { json_string(s: n.owner) }
  let title = node_title(item: n.line)
  json_object(members: [
    json_kv(key: "node_id", value: json_string(s: n.node)),
    json_kv(key: "title", value: json_string(s: title)),
    json_kv(key: "repo", value: json_string(s: repo)),
    json_kv(key: "intricacy", value: json_string(s: intricacy_str(i: intricacy))),
    json_kv(key: "volume", value: json_string(s: volume_str(v: volume))),
    json_kv(key: "parent_node_id", value: parent_id_value),
    json_kv(key: "parent_node_ids", value: json_array(elements: node_parent_ids(edges: edges, id: n.node) |> map(id => json_string(s: id)))),
    json_kv(key: "owner", value: owner_value),
    json_kv(key: "plan_doc", value: node_plan_doc_json(carriers: n.carriers)),
    json_kv(key: "acceptance", value: acceptance_json_value(a: acceptance, line: n.line)),
  ])
}

fn node_json(n: RoadmapNode, intricacy: Intricacy, volume: Volume, repo: String, acceptance: Acceptance, edges: List<RoadmapEdge>) -> String {
  serialize_json(v: node_json_value(n: n, intricacy: intricacy, volume: volume, repo: repo, acceptance: acceptance, edges: edges))
}

fn node_unmet_parent_ids(nodes: List<RoadmapNode>, edges: List<RoadmapEdge>, id: RoadmapNodeId, merged: List<Int>) -> List<RoadmapNodeId> {
  node_parent_ids(edges: edges, id: id)
    |> filter(pid => !any(nodes, n => n.node == pid && item_is_done(item: n.line, merged: merged)))
}

fn ready_array_json(nodes: List<RoadmapNode>, edges: List<RoadmapEdge>) -> String {
  serialize_json(v: json_array(elements: nodes |> map(n => match n.sizing {
    Unsized => json_object(members: [])
    Sized { intricacy, volume, repo, acceptance } =>
      node_json_value(n: n, intricacy: intricacy, volume: volume, repo: repo, acceptance: acceptance, edges: edges)
  })))
}

fn roadmap_spawn_request_json(doc: RoadmapDocument, merged: List<Int>, anchor_commit: String) -> String {
  let nodes = next_spawnable(doc: doc, merged: merged)
  let edges = doc_all_edges(doc: doc)
  serialize_json(v: json_object(members: [
    json_kv(key: "schema", value: json_string(s: "roadmap-spawn-request/v1")),
    json_kv(key: "anchor_commit", value: json_string(s: anchor_commit)),
    json_kv(key: "ready", value: json_array(elements: nodes |> map(n => match n.sizing {
      Unsized => json_object(members: [])
      Sized { intricacy, volume, repo, acceptance } =>
        node_json_value(n: n, intricacy: intricacy, volume: volume, repo: repo, acceptance: acceptance, edges: edges)
    }))),
  ]))
}

fn upcoming_node_json(n: RoadmapNode, nodes: List<RoadmapNode>, edges: List<RoadmapEdge>, merged: List<Int>) -> String {
  let unmet = node_unmet_parent_ids(nodes: nodes, edges: edges, id: n.node, merged: merged)
  serialize_json(v: json_object(members: [
    json_kv(key: "node_id", value: json_string(s: n.node)),
    json_kv(key: "title", value: json_string(s: node_title(item: n.line))),
    json_kv(key: "unmet_parents", value: json_array(elements: unmet |> map(id => json_string(s: id)))),
  ]))
}

fn upcoming_array_json(frontier_upcoming: List<RoadmapNode>, nodes: List<RoadmapNode>, edges: List<RoadmapEdge>, merged: List<Int>) -> String {
  serialize_json(v: json_array(elements: frontier_upcoming |> map(n =>
    json_object(members: [
      json_kv(key: "node_id", value: json_string(s: n.node)),
      json_kv(key: "title", value: json_string(s: node_title(item: n.line))),
      json_kv(key: "unmet_parents", value: json_array(elements: node_unmet_parent_ids(nodes: nodes, edges: edges, id: n.node, merged: merged) |> map(id => json_string(s: id)))),
    ])
  )))
}

fn done_ids_json(frontier_done: List<RoadmapNode>) -> String {
  json_str_list(items: frontier_done |> map(n => n.node))
}

data dispatch_brief_template: String = "Node: <node_id>\nWhy now: <displaced cost / what it unblocks>\nNon-goals: <explicitly out of scope>\nM0 evidence: <prove current state / reproduce the gap>\nM1 smallest change: <first implementation slice>\nM2 RED control: <perturbation that goes red>\nM3 green receipt: <execution on the real path>\nStop and return if: <named hand-back conditions>\nFiles likely touched: <paths>\nCommands to run: <repro/verify commands>\nExpected artifact: <what comes back even if the fix does not land>"

fn roadmap_dispatch_json_value(doc: RoadmapDocument, merged: List<Int>) -> JsonValue {
  let nodes = doc_all_nodes(doc: doc)
  let edges = doc_all_edges(doc: doc)
  let frontier = spawn_frontier(doc: doc, merged: merged)
  json_object(members: [
    json_kv(key: "schema", value: json_string(s: "roadmap-dispatch/v1")),
    json_kv(key: "ready", value: json_array(elements: frontier.ready |> map(n => match n.sizing {
      Unsized => json_object(members: [])
      Sized { intricacy, volume, repo, acceptance } =>
        node_json_value(n: n, intricacy: intricacy, volume: volume, repo: repo, acceptance: acceptance, edges: edges)
    }))),
    json_kv(key: "upcoming", value: json_array(elements: frontier.upcoming |> map(n =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: n.node)),
        json_kv(key: "title", value: json_string(s: node_title(item: n.line))),
        json_kv(key: "unmet_parents", value: json_array(elements: node_unmet_parent_ids(nodes: nodes, edges: edges, id: n.node, merged: merged) |> map(id => json_string(s: id)))),
      ])
    ))),
    json_kv(key: "done", value: json_array(elements: frontier.done |> map(n => json_string(s: n.node)))),
    json_kv(key: "superseded", value: json_array(elements: frontier.superseded |> map(n =>
      json_object(members: [
        json_kv(key: "node_id", value: json_string(s: n.node)),
        json_kv(key: "superseded_by", value: json_string(s: item_superseded_by(item: n.line))),
      ])
    ))),
  ])
}

fn roadmap_dispatch_json(doc: RoadmapDocument, merged: List<Int>) -> String {
  serialize_json(v: roadmap_dispatch_json_value(doc: doc, merged: merged))
}

fn roadmap_dispatch_file_content() -> String {
  serialize_json(v: json_object(members: [
    json_kv(key: "schema", value: json_string(s: "roadmap-dispatch-file/v1")),
    json_kv(key: "brief_template", value: json_string(s: dispatch_brief_template)),
    json_kv(key: "dispatch", value: roadmap_dispatch_json_value(doc: roadmap_authority(), merged: authored_merged_prs())),
  ]))
}
