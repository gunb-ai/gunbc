module gunbc.dispatch.credential_acquisition

import std.types { String, Bool, Int, NonEmptyStr, EpochSecs }
import std.content_hash { content_hash_of_value }
import std.decl_ref { decl_ref }
import std.durable_compare_and_set {
  cas_attempt, CasExpectation, ExpectSlotAbsent, ExpectSlotGeneration,
  CasCommitted, CasPreconditionFailed, CasStoreRefused,
  CasObservedReadable, CasObservedUnreadable,
  CasReadableAbsent, CasReadablePresent,
  CasGeneration, cas_generation_count, cas_unreadable_slot_detail,
  CasSlotObservationRefused, CasGenerationPublicationRefused, CasGenerationSpaceExhausted,
}
import gunbc.durable_cas_file_store {
  CasAttemptAdmitted, CasAttemptDigestMismatch, CasAttemptDigestIncomparable,
  CasAttemptKeyNotSlotAddressable, admit_cas_attempt, file_compare_and_set, DefaultAccessCreateOnly,
  observe_cas_slot_state,
}
import gunbc.compute.attempt_lifecycle {
  AttemptState, AttemptReserved, AttemptLaunching, AttemptTerminal, AttemptRecovered,
  AttemptTransition, AttemptAdvanced, AttemptLostRace, AttemptTransitionRefused,
  attempt_state_wire, attempt_state_decode, compute_pre_launch_ceiling_seconds,
}
import gunbc.compute.recorded_cgroup_drain {
  RecordedCgroupDrain, RecordedCgroupMaySeal, RecordedCgroupPreserve, recorded_cgroup_may_seal,
  observe_recorded_invocation_cgroup_drain,
}
import gunbc.dispatch_credential_snapshot {
  SnapshotExecutor, ClaudeFromSnapshot, CursorFromSnapshot,
  TakenCredentialSnapshot, dispatch_credential_snapshot_take, dispatch_credential_snapshot_discard,
  DispatchCredentialSnapshot, DispatchSnapshotTaken, DispatchSnapshotRefused,
  DispatchSnapshotRefusal, SnapshotWriteFailed,
  CredentialSnapshotDiscard, CredentialSnapshotRemoved, CredentialSnapshotRemovalFailed,
}
import gunbc.dispatch_attempt { DispatchAttempt }
import gunbc.host_custody_export_receipt { SnapshotCustodyDeclaration }
import gunbc.fabric.fabric_event_log_host { now_epoch_seconds }
import extdeps.languages.json.emit { JsonValue, json_object, json_kv, json_string, json_int, serialize_json }
import extdeps.languages.json.parse {
  parse_json_document, JsonDocumentParsed, JsonDocumentUnreadable,
  json_object_unique_member, JsonMemberFound, JsonMemberAbsent, JsonMemberDuplicated, JsonMemberNotAnObject,
  JsonString, JsonNumber,
}
import extdeps.filesystem.filesystem_io { Filesystem }
import std.algebra { trim }

data credential_tombstone_body: String = "{\"tombstone\":true}\n"

data credential_acquisition_slots_dirname: String = "credential-acquisition-slots"

fn credential_acquisition_slots_root(instance_root: String) -> NonEmptyStr {
  join([instance_root, "/", credential_acquisition_slots_dirname], "") as NonEmptyStr
}

fn credential_acquisition_reference(identity: String, executor: SnapshotExecutor) -> NonEmptyStr {
  join([identity, "-", match executor { ClaudeFromSnapshot => "claude"  CursorFromSnapshot => "cursor" }], "") as NonEmptyStr
}

type CredentialAcquisitionRecord {
  identity: String
  reference: String
  executor_word: String
  snapshot_path: String
  producer_pid: String
  producer_namespace: String
  boot_id: String
  belt_unit: String
  invocation_id: String
  control_group: String
  opened_at: EpochSecs
  launch_deadline: EpochSecs
  state: AttemptState
}

fn credential_record_with_state(r: CredentialAcquisitionRecord, state: AttemptState) -> CredentialAcquisitionRecord {
  CredentialAcquisitionRecord {
    identity: r.identity, reference: r.reference, executor_word: r.executor_word, snapshot_path: r.snapshot_path,
    producer_pid: r.producer_pid, producer_namespace: r.producer_namespace, boot_id: r.boot_id,
    belt_unit: r.belt_unit, invocation_id: r.invocation_id, control_group: r.control_group,
    opened_at: r.opened_at, launch_deadline: r.launch_deadline, state: state,
  }
}

fn credential_record_json(r: CredentialAcquisitionRecord) -> String {
  serialize_json(v: json_object(members: [
    json_kv(key: "identity", value: json_string(s: r.identity)),
    json_kv(key: "reference", value: json_string(s: r.reference)),
    json_kv(key: "executor", value: json_string(s: r.executor_word)),
    json_kv(key: "snapshot_path", value: json_string(s: r.snapshot_path)),
    json_kv(key: "producer_pid", value: json_string(s: r.producer_pid)),
    json_kv(key: "producer_namespace", value: json_string(s: r.producer_namespace)),
    json_kv(key: "boot_id", value: json_string(s: r.boot_id)),
    json_kv(key: "belt_unit", value: json_string(s: r.belt_unit)),
    json_kv(key: "invocation_id", value: json_string(s: r.invocation_id)),
    json_kv(key: "control_group", value: json_string(s: r.control_group)),
    json_kv(key: "opened_at", value: json_int(n: r.opened_at)),
    json_kv(key: "launch_deadline", value: json_int(n: r.launch_deadline)),
    json_kv(key: "state", value: json_string(s: attempt_state_wire(s: r.state))),
    json_kv(key: "detail", value: json_string(s: match r.state { AttemptTerminal { verdict: _, detail: d } => d  AttemptReserved => ""  AttemptLaunching => "" })),
  ]))
}

fn credential_member(doc: JsonValue, key: String) -> String? {
  match json_object_unique_member(v: doc, key: key) {
    JsonMemberFound { value } => match value { JsonString { value: s } => Present { value: s }  _ => none }
    _ => none
  }
}

fn credential_member_epoch(doc: JsonValue, key: String) -> EpochSecs? {
  match json_object_unique_member(v: doc, key: key) {
    JsonMemberFound { value } => match value { JsonNumber { lexeme: n } => match parse_int(s: n as String) { Present { value: i } => if i < 0 { none } else { Present { value: i } }  Absent => none }  _ => none }
    _ => none
  }
}

fn credential_record_decode(text: String) -> CredentialAcquisitionRecord? {
  match parse_json_document(s: text) {
    JsonDocumentUnreadable { gap: _ } => none
    JsonDocumentParsed { value: doc } =>
      match credential_member(doc: doc, key: "identity") {
        Absent => none
        Present { value: identity } =>
          match credential_member(doc: doc, key: "reference") {
            Absent => none
            Present { value: reference } =>
              match credential_member(doc: doc, key: "executor") {
                Absent => none
                Present { value: executor_word } =>
                  match credential_member(doc: doc, key: "snapshot_path") {
                    Absent => none
                    Present { value: snapshot_path } =>
                      match credential_member(doc: doc, key: "producer_pid") {
                        Absent => none
                        Present { value: producer_pid } =>
                          match credential_member(doc: doc, key: "producer_namespace") {
                            Absent => none
                            Present { value: producer_namespace } =>
                              match credential_member(doc: doc, key: "boot_id") {
                                Absent => none
                                Present { value: boot_id } =>
                                  match credential_member(doc: doc, key: "belt_unit") {
                                    Absent => none
                                    Present { value: belt_unit } =>
                                      match credential_member(doc: doc, key: "invocation_id") {
                                        Absent => none
                                        Present { value: invocation_id } =>
                                          match credential_member(doc: doc, key: "control_group") {
                                            Absent => none
                                            Present { value: control_group } =>
                                              match credential_member_epoch(doc: doc, key: "opened_at") {
                                                Absent => none
                                                Present { value: opened_at } =>
                                                  match credential_member_epoch(doc: doc, key: "launch_deadline") {
                                                    Absent => none
                                                    Present { value: launch_deadline } =>
                                                      match credential_member(doc: doc, key: "state") {
                                                        Absent => none
                                                        Present { value: word } =>
                                                          match attempt_state_decode(word: word, detail: match credential_member(doc: doc, key: "detail") { Present { value: d } => d  Absent => "" }) {
                                                            Absent => none
                                                            Present { value: state } =>
                                                              Present { value: CredentialAcquisitionRecord {
                                                                identity: identity, reference: reference, executor_word: executor_word, snapshot_path: snapshot_path,
                                                                producer_pid: producer_pid, producer_namespace: producer_namespace, boot_id: boot_id,
                                                                belt_unit: belt_unit, invocation_id: invocation_id, control_group: control_group,
                                                                opened_at: opened_at, launch_deadline: launch_deadline, state: state,
                                                              } }
                                                          }
                                                      }
                                                  }
                                              }
                                          }
                                      }
                                  }
                              }
                          }
                      }
                  }
              }
          }
      }
  }
}

fn credential_commit_bytes(root: NonEmptyStr, record: CredentialAcquisitionRecord, expected: CasExpectation) -> AttemptTransition
  admit_callers: [
    decl_ref(module_path: "gunbc.dispatch.credential_acquisition", decl_name: "credential_open"),
    decl_ref(module_path: "gunbc.dispatch.credential_acquisition", decl_name: "credential_advance"),
  ]
{
  let payload = credential_record_json(r: record) as NonEmptyStr
  match admit_cas_attempt(attempt: cas_attempt(
    key: record.reference as NonEmptyStr,
    expected: expected,
    proposed: payload,
    proposed_content: content_hash_of_value(value: payload),
  )) {
    CasAttemptKeyNotSlotAddressable { key: k } => AttemptTransitionRefused { detail: join(["the credential reference is not slot-addressable: ", k as String], "") }
    CasAttemptDigestMismatch { claimed: _, actual: _ } => AttemptTransitionRefused { detail: "the credential record digest did not match its bytes" }
    CasAttemptDigestIncomparable { claimed: _, actual: _ } => AttemptTransitionRefused { detail: "the credential record digest was incomparable" }
    CasAttemptAdmitted { verified: v } =>
      match file_compare_and_set(root: root, publication: DefaultAccessCreateOnly, verified: v) {
        CasCommitted { committed: c } => AttemptAdvanced { state: record.state, generation: c.generation }
        CasPreconditionFailed { expected: e, observed: o } =>
          AttemptLostRace {
            expected: match e { ExpectSlotGeneration { generation: g } => join(["generation ", to_string(value: cas_generation_count(g: g))], "")  ExpectSlotAbsent => "an absent slot" },
            observed: match o { CasReadablePresent { version: v2 } => join(["generation ", to_string(value: cas_generation_count(g: v2.generation))], "")  CasReadableAbsent => "an absent slot" },
          }
        CasStoreRefused { cause: c } =>
          AttemptTransitionRefused {
            detail: match c {
              CasSlotObservationRefused { cause: u } => join(["the credential store refused the read: ", cas_unreadable_slot_detail(cause: u)], "")
              CasGenerationPublicationRefused { detail: d } => join(["the credential store refused the write: ", d as String], "")
              CasGenerationSpaceExhausted { head: h } => join(["the credential store generation space is exhausted at head ", to_string(value: cas_generation_count(g: h))], "")
            },
          }
      }
  }
}

fn credential_open(root: NonEmptyStr, record: CredentialAcquisitionRecord) -> AttemptTransition {
  credential_commit_bytes(
    root: root,
    record: credential_record_with_state(r: record, state: AttemptReserved),
    expected: ExpectSlotAbsent)
}

fn credential_advance(root: NonEmptyStr, reference: NonEmptyStr, expected: CasGeneration, next_state: AttemptState) -> AttemptTransition {
  match observe_cas_slot_state(root: root, key: reference) {
    CasObservedUnreadable { cause: c } =>
      AttemptTransitionRefused { detail: join(["the credential slot could not be read: ", cas_unreadable_slot_detail(cause: c)], "") }
    CasObservedReadable { readable: r } =>
      match r {
        CasReadableAbsent =>
          AttemptLostRace { expected: join(["generation ", to_string(value: cas_generation_count(g: expected))], ""), observed: "an absent slot" }
        CasReadablePresent { version: v } =>
          match credential_record_decode(text: v.value as String) {
            Absent =>
              AttemptTransitionRefused { detail: join(["the credential slot at generation ", to_string(value: cas_generation_count(g: v.generation)), " cannot be decoded"], "") }
            Present { value: rec } =>
              if rec.reference != (reference as String) {
                AttemptTransitionRefused { detail: join(["the credential slot keyed ", reference as String, " names reference ", rec.reference], "") }
              } else {
                credential_commit_bytes(
                  root: root,
                  record: credential_record_with_state(r: rec, state: next_state),
                  expected: ExpectSlotGeneration { generation: expected })
              }
          }
      }
  }
}

fn credential_begin_launch(root: NonEmptyStr, reference: NonEmptyStr, expected: CasGeneration) -> AttemptTransition {
  credential_advance(root: root, reference: reference, expected: expected, next_state: AttemptLaunching)
}

fn credential_terminate(root: NonEmptyStr, reference: NonEmptyStr, expected: CasGeneration, detail: String) -> AttemptTransition {
  credential_advance(
    root: root,
    reference: reference,
    expected: expected,
    next_state: AttemptTerminal { verdict: AttemptRecovered, detail: detail })
}

type LaunchLostOutcome
  = LaunchAdmitted
  | LaunchLostSnapshotDiscarded
  | LaunchLostDiscardFailed { reason: NonEmptyStr }

fn credential_begin_launch_or_discard(
  root: NonEmptyStr,
  reference: NonEmptyStr,
  expected: CasGeneration,
  snapshot: TakenCredentialSnapshot,
) -> LaunchLostOutcome {
  match credential_begin_launch(root: root, reference: reference, expected: expected) {
    AttemptAdvanced { state: _, generation: _ } => LaunchAdmitted
    AttemptLostRace { expected: _, observed: _ } =>
      match dispatch_credential_snapshot_discard(snapshot: snapshot) {
        CredentialSnapshotRemoved => LaunchLostSnapshotDiscarded
        CredentialSnapshotRemovalFailed { reason: r } => LaunchLostDiscardFailed { reason: r }
      }
    AttemptTransitionRefused { detail: _ } =>
      match dispatch_credential_snapshot_discard(snapshot: snapshot) {
        CredentialSnapshotRemoved => LaunchLostSnapshotDiscarded
        CredentialSnapshotRemovalFailed { reason: r } => LaunchLostDiscardFailed { reason: r }
      }
  }
}

type CredentialOccupy
  = CredentialOccupied
  | CredentialOccupyFailed { detail: String }

fn credential_occupy_tombstone(path: String) -> CredentialOccupy {
  let created = Filesystem.WriteCreateNew(path: path, content: credential_tombstone_body)
  if created.success {
    CredentialOccupied
  } else {
    let over = Filesystem.Write(path: path, content: credential_tombstone_body)
    if over.success {
      CredentialOccupied
    } else {
      CredentialOccupyFailed { detail: over.error }
    }
  }
}

type CredentialSealReceipt
  = CredentialSealed { path: String }
  | CredentialSealFailed { detail: String }
  | CredentialSealNotOwed

fn credential_seal_after_terminate(record: CredentialAcquisitionRecord, drain: RecordedCgroupDrain) -> CredentialSealReceipt {
  if recorded_cgroup_may_seal(d: drain) {
    match credential_occupy_tombstone(path: record.snapshot_path) {
      CredentialOccupied => CredentialSealed { path: record.snapshot_path }
      CredentialOccupyFailed { detail: d } => CredentialSealFailed { detail: d }
    }
  } else {
    CredentialSealNotOwed
  }
}

type CredentialRecoveryDecision
  = CredentialRecoveryPreserve { reason: String }
  | CredentialRecoveryMayClose { reason: String }

fn credential_recovery_decide(record: CredentialAcquisitionRecord, drain: RecordedCgroupDrain, now: EpochSecs) -> CredentialRecoveryDecision {
  match record.state {
    AttemptReserved =>
      if now < record.launch_deadline {
        CredentialRecoveryPreserve { reason: "W: reserved inside the declared window" }
      } else {
        CredentialRecoveryMayClose { reason: "reserved past deadline with no launch" }
      }
    AttemptLaunching =>
      if recorded_cgroup_may_seal(d: drain) {
        CredentialRecoveryMayClose { reason: recorded_cgroup_drain_detail_or_empty(d: drain) }
      } else {
        CredentialRecoveryPreserve { reason: recorded_cgroup_drain_detail_or_empty(d: drain) }
      }
    AttemptTerminal { verdict: _, detail: _ } =>
      CredentialRecoveryPreserve { reason: "already terminal" }
  }
}

fn recorded_cgroup_drain_detail_or_empty(d: RecordedCgroupDrain) -> String {
  match d {
    RecordedCgroupMaySeal { detail: s } => s
    RecordedCgroupPreserve { detail: s } => s
  }
}

fn credential_recover_slot(root: NonEmptyStr, reference: NonEmptyStr, now: EpochSecs) -> String {
  match observe_cas_slot_state(root: root, key: reference) {
    CasObservedUnreadable { cause: c } => join(["preserve unreadable ", reference as String, ": ", cas_unreadable_slot_detail(cause: c)], "")
    CasObservedReadable { readable: r } =>
      match r {
        CasReadableAbsent => join(["absent ", reference as String], "")
        CasReadablePresent { version: v } =>
          match credential_record_decode(text: v.value as String) {
            Absent => join(["undecodable ", reference as String], "")
            Present { value: rec } => {
              let drain = observe_recorded_invocation_cgroup_drain(
                unit: rec.belt_unit as NonEmptyStr,
                recorded_id: rec.invocation_id,
                recorded_control_group: rec.control_group)
              match credential_recovery_decide(record: rec, drain: drain, now: now) {
                CredentialRecoveryPreserve { reason: why } => join(["preserve ", reference as String, ": ", why], "")
                CredentialRecoveryMayClose { reason: why } =>
                  match credential_terminate(root: root, reference: reference, expected: v.generation, detail: why) {
                    AttemptLostRace { expected: e, observed: o } => join(["terminate lost ", reference as String, ": ", e, " vs ", o], "")
                    AttemptTransitionRefused { detail: d } => join(["terminate refused ", reference as String, ": ", d], "")
                    AttemptAdvanced { state: _, generation: _ } =>
                      match credential_seal_after_terminate(record: rec, drain: drain) {
                        CredentialSealed { path: p } => join(["sealed ", p], "")
                        CredentialSealFailed { detail: d } => join(["seal failed ", reference as String, ": ", d], "")
                        CredentialSealNotOwed => join(["terminated without seal ", reference as String], "")
                      }
                  }
              }
            }
          }
      }
  }
}

fn credential_snapshot_is_tombstone(text: String) -> Bool {
  trim(s: text) == trim(s: credential_tombstone_body)
}

fn credential_recover_listed(root: NonEmptyStr, listing: String, now: EpochSecs) -> String {
  if trim(s: listing) == "" {
    "no credential slots"
  } else {
    credential_recover_slot(root: root, reference: trim(s: listing) as NonEmptyStr, now: now)
  }
}

fn credential_register_then_take(
  attempt: DispatchAttempt,
  executor: SnapshotExecutor,
  custody: SnapshotCustodyDeclaration,
  snapshot: NonEmptyStr,
  belt_unit: String,
  invocation_id: String,
  control_group: String,
) -> DispatchCredentialSnapshot {
  match now_epoch_seconds() {
    Absent =>
      DispatchSnapshotRefused { reason: SnapshotWriteFailed { path: snapshot, detail: "the host clock could not be read" } }
    Present { value: now } => {
      let record = CredentialAcquisitionRecord {
        identity: attempt.attempt_key,
        reference: credential_acquisition_reference(identity: attempt.attempt_key, executor: executor) as String,
        executor_word: match executor { ClaudeFromSnapshot => "claude"  CursorFromSnapshot => "cursor" },
        snapshot_path: snapshot as String,
        producer_pid: "unobserved",
        producer_namespace: "unobserved",
        boot_id: "unobserved",
        belt_unit: belt_unit,
        invocation_id: invocation_id,
        control_group: control_group,
        opened_at: now,
        launch_deadline: now + compute_pre_launch_ceiling_seconds,
        state: AttemptReserved,
      }
      let root = credential_acquisition_slots_root(instance_root: attempt.instance.instance_root as String)
      match credential_open(root: root, record: record) {
        AttemptLostRace { expected: e, observed: o } =>
          DispatchSnapshotRefused { reason: SnapshotWriteFailed { path: snapshot, detail: join(["credential open lost: expected ", e, " found ", o], "") } }
        AttemptTransitionRefused { detail: d } =>
          DispatchSnapshotRefused { reason: SnapshotWriteFailed { path: snapshot, detail: d } }
        AttemptAdvanced { state: _, generation: g } =>
          match dispatch_credential_snapshot_take(attempt: attempt, executor: executor, custody: custody, snapshot: snapshot) {
            DispatchSnapshotRefused { reason: r } => DispatchSnapshotRefused { reason: r }
            DispatchSnapshotTaken { snapshot: snap } =>
              match credential_begin_launch_or_discard(root: root, reference: record.reference as NonEmptyStr, expected: g, snapshot: snap) {
                LaunchAdmitted => DispatchSnapshotTaken { snapshot: snap }
                LaunchLostSnapshotDiscarded =>
                  DispatchSnapshotRefused { reason: SnapshotWriteFailed { path: snapshot, detail: "begin_launch lost; snapshot discarded" } }
                LaunchLostDiscardFailed { reason: r } =>
                  DispatchSnapshotRefused { reason: SnapshotWriteFailed { path: snapshot, detail: r as String } }
              }
          }
      }
    }
  }
}
