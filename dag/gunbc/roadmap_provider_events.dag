module gunbc.roadmap_provider_events

import std.types { String, NonEmptyStr, Int, Bool, List, FilePath }
import extdeps.languages.json.grammar {
  JsonTextParseResult, JsonTextParseOk, JsonTextParseFail,
  json_text_parseable,
  json_text_parse_string,
  json_text_skip_ws,
  json_text_starts_with_at,
}

type CodexItemActivity
  = CodexRunningCommand
  | CodexEditingFiles
  | CodexUsingConnectedTool
  | CodexSearching
  | CodexUpdatingPlan
  | CodexReasoningItem
  | CodexReporting
  | CodexUnclassifiedItem

type CodexProviderEventKind
  = CodexThreadStarted
  | CodexTurnStarted
  | CodexItemStarted { activity: CodexItemActivity }
  | CodexItemCompleted { activity: CodexItemActivity }
  | CodexTurnCompleted
  | CodexTurnFailed
  | CodexError

type CodexProviderEvent {
  line_number: Int
  raw: String
  kind: CodexProviderEventKind
}

type CodexEventParse
  = CodexEventsParsed { events: List<CodexProviderEvent> }
  | CodexEventsRefused {
      events_before_refusal: List<CodexProviderEvent>,
      line_number: Int,
      raw: String,
      reason: String,
    }

type CodexParseFold {
  events: List<CodexProviderEvent>
  next_line_number: Int
  total_lines: Int
  refused: Bool
  refused_line_number: Int
  refused_raw: String
  refused_reason: String
}

type ProviderExecutionState
  = ProviderNotStarted
  | ProviderStarting { activity: String }
  | ProviderRunning { activity: String }
  | ProviderCompleted { activity: String }
  | ProviderFailed { activity: String, detail: String }
  | ProviderEventsRefused { activity: String, detail: String }

data codex_provider_event_line_observation_budget_chars: Int = 65536

data codex_provider_projection_type_chars: Int = 128
data codex_provider_projection_detail_chars: Int = 4096

data codex_provider_event_projection_filter: NonEmptyStr = join([
  "fromjson | def event_type: if (.type | type) == \"string\" then .type[0:",
  to_string(codex_provider_projection_type_chars),
  "] else \"unknown\" end; def item_type: if (.item.type | type) == \"string\" then .item.type[0:",
  to_string(codex_provider_projection_type_chars),
  "] else \"unknown\" end; def bounded_text: if . == null then \"\" elif type == \"string\" then .[0:",
  to_string(codex_provider_projection_detail_chars),
  "] elif type == \"object\" and (.message | type) == \"string\" then .message[0:",
  to_string(codex_provider_projection_detail_chars),
  "] else tostring[0:",
  to_string(codex_provider_projection_detail_chars),
  "] end; (event_type) as $type | if $type == \"item.started\" or $type == \"item.completed\" then {\"type\":$type,\"item\":{\"type\":item_type}} elif $type == \"turn.failed\" then {\"type\":$type,\"error\":{\"message\":(.error | bounded_text)}} elif $type == \"error\" then {\"type\":$type,\"message\":((.message // .error) | bounded_text)} else {\"type\":$type} end",
], "") as NonEmptyStr

fn codex_provider_event_projection_args(path: FilePath) -> List<String> {
  [
    "--raw-input",
    "--compact-output",
    codex_provider_event_projection_filter as String,
    path as String,
  ]
}

data codex_jsonl_projection_note: String = "The attempt-owned provider-events.jsonl remains the complete Codex protocol authority. Workflow observation first runs a separately modeled jq capability over that file. `--raw-input` plus `fromjson` proves exactly one JSON value per physical JSONL line before emitting only a bounded envelope (top-level event type, bounded item type, and a bounded terminal error detail); two values on one line, a multiline value, and malformed JSON all refuse. Large command aggregated_output therefore becomes opaque to the synchronous dashboard without becoming lost evidence or an invented success. The exact jq executable and identity probe are part of dispatch-platform Ensure and dashboard provisioning; absence refuses before dispatch and is also visible as an observation refusal for retained attempts. A malformed raw event makes jq nonzero, so no parsed prefix is accepted as a complete observation."

data codex_jsonl_classifier_note: String = "Codex --json is the provider protocol authority: one JSON object per line with thread.started, turn.started, item.*, turn.completed, turn.failed, and error event types. The raw stream is structurally reduced by codex_provider_event_projection_filter before this bounded total envelope classifier runs. The shared RFC 8259 grammar proves each projected line parseable, then the classifier requires the emitted top-level `type` member to be the first object member before selecting a closed event variant. That fail-closed envelope rule prevents a nested item or user-authored string containing `type: turn.completed` from fabricating terminal success. Projected lines are mechanically bounded; the remaining line budget is a red control against projector drift and refuses before grammar descent with the payload elided. Unknown, reordered, malformed, or truncated projected lines still refuse with their located evidence and parsed prefix. A refusal is a workflow fact, never dropped as console noise. Item activity is only a presentation projection from the bounded item type; terminal success/failure comes only from the anchored top-level turn.completed, turn.failed, or error envelope, never from tmux Spawned."

data codex_projected_envelope_walk_note: String = "review 44058. Both reads below are ANCHORED walks over the projector's own envelope shape, not scans. codex_line_contains_type_token, which this replaces, searched the whole line for a `\"type\":\"…\"` fragment in either spacing — so an agent_message whose text quoted `\"type\":\"file_change\"` reclassified the pane's activity, the same fragment-scan class the top-level classifier already refused to use for terminal events and the same one the dashboard health readback was repaired for. The projector emits exactly {\"type\":…} for plain events and {\"type\":…,\"item\":{\"type\":…}} for item events, so both members have a known position and the walk either lands on it or answers false. codex_envelope_member_value_start is the single step both readings share (DESIGN 2, one concept)."

fn codex_envelope_object_first_member(raw: String, at: Int) -> Int? {
  let start = json_text_skip_ws(s: raw, i: at)
  if json_text_starts_with_at(s: raw, i: start, lit: "\{") {
    Present { value: start + 1 }
  } else {
    none
  }
}

fn codex_envelope_member_value_start(raw: String, at: Int, key: String) -> Int? {
  let quoted = join(["\"", key, "\""], "")
  let key_start = json_text_skip_ws(s: raw, i: at)
  if !json_text_starts_with_at(s: raw, i: key_start, lit: quoted) {
    none
  } else {
    let colon = json_text_skip_ws(
      s: raw,
      i: key_start + string_length(s: quoted),
    )
    if json_text_starts_with_at(s: raw, i: colon, lit: ":") {
      Present { value: json_text_skip_ws(s: raw, i: colon + 1) }
    } else {
      none
    }
  }
}

fn codex_envelope_string_member_is(raw: String, at: Int, expected: String) -> Bool {
  let token = join(["\"", expected, "\""], "")
  let after = json_text_skip_ws(s: raw, i: at + string_length(s: token))
  json_text_starts_with_at(s: raw, i: at, lit: token)
    && (
      json_text_starts_with_at(s: raw, i: after, lit: ",")
        || json_text_starts_with_at(s: raw, i: after, lit: "\}")
    )
}

fn codex_line_has_top_level_type(raw: String, event_type: String) -> Bool {
  match codex_envelope_object_first_member(raw: raw, at: 0) {
    Absent => false
    Present { value: member } =>
      match codex_envelope_member_value_start(raw: raw, at: member, key: "type") {
        Absent => false
        Present { value: value_start } =>
          codex_envelope_string_member_is(
            raw: raw,
            at: value_start,
            expected: event_type,
          )
      }
  }
}

fn codex_line_item_type_is(raw: String, item_type: String) -> Bool {
  match codex_envelope_object_first_member(raw: raw, at: 0) {
    Absent => false
    Present { value: member } =>
      match codex_envelope_member_value_start(raw: raw, at: member, key: "type") {
        Absent => false
        Present { value: type_value } =>
          match json_text_parse_string(s: raw, i: type_value) {
            JsonTextParseFail { end: _ } => false
            JsonTextParseOk { end: after_type } => {
              let comma = json_text_skip_ws(s: raw, i: after_type)
              if !json_text_starts_with_at(s: raw, i: comma, lit: ",") {
                false
              } else {
                match codex_envelope_member_value_start(
                  raw: raw,
                  at: comma + 1,
                  key: "item",
                ) {
                  Absent => false
                  Present { value: item_object } =>
                    match codex_envelope_object_first_member(
                      raw: raw,
                      at: item_object,
                    ) {
                      Absent => false
                      Present { value: item_member } =>
                        match codex_envelope_member_value_start(
                          raw: raw,
                          at: item_member,
                          key: "type",
                        ) {
                          Absent => false
                          Present { value: item_value } =>
                            codex_envelope_string_member_is(
                              raw: raw,
                              at: item_value,
                              expected: item_type,
                            )
                        }
                    }
                }
              }
            }
          }
      }
  }
}

fn codex_item_activity(raw: String) -> CodexItemActivity {
  if codex_line_item_type_is(raw: raw, item_type: "command_execution") {
    CodexRunningCommand
  } else if codex_line_item_type_is(raw: raw, item_type: "file_change") {
    CodexEditingFiles
  } else if codex_line_item_type_is(raw: raw, item_type: "mcp_tool_call") {
    CodexUsingConnectedTool
  } else if codex_line_item_type_is(raw: raw, item_type: "web_search") {
    CodexSearching
  } else if codex_line_item_type_is(raw: raw, item_type: "plan_update") {
    CodexUpdatingPlan
  } else if codex_line_item_type_is(raw: raw, item_type: "reasoning") {
    CodexReasoningItem
  } else if codex_line_item_type_is(raw: raw, item_type: "agent_message") {
    CodexReporting
  } else {
    CodexUnclassifiedItem
  }
}

fn codex_item_activity_label(activity: CodexItemActivity) -> String {
  match activity {
    CodexRunningCommand => "running command"
    CodexEditingFiles => "editing files"
    CodexUsingConnectedTool => "using connected tool"
    CodexSearching => "searching"
    CodexUpdatingPlan => "updating plan"
    CodexReasoningItem => "reasoning"
    CodexReporting => "reporting"
    CodexUnclassifiedItem => "provider item"
  }
}

fn codex_event_from_complete_line(
  raw: String,
  line_number: Int,
) -> CodexProviderEvent? {
  if codex_line_has_top_level_type(raw: raw, event_type: "thread.started") {
    Present { value: CodexProviderEvent {
      line_number: line_number,
      raw: raw,
      kind: CodexThreadStarted,
    } }
  } else if codex_line_has_top_level_type(raw: raw, event_type: "turn.started") {
    Present { value: CodexProviderEvent {
      line_number: line_number,
      raw: raw,
      kind: CodexTurnStarted,
    } }
  } else if codex_line_has_top_level_type(raw: raw, event_type: "item.started") {
    Present { value: CodexProviderEvent {
      line_number: line_number,
      raw: raw,
      kind: CodexItemStarted { activity: codex_item_activity(raw: raw) },
    } }
  } else if codex_line_has_top_level_type(raw: raw, event_type: "item.completed") {
    Present { value: CodexProviderEvent {
      line_number: line_number,
      raw: raw,
      kind: CodexItemCompleted { activity: codex_item_activity(raw: raw) },
    } }
  } else if codex_line_has_top_level_type(raw: raw, event_type: "turn.completed") {
    Present { value: CodexProviderEvent {
      line_number: line_number,
      raw: raw,
      kind: CodexTurnCompleted,
    } }
  } else if codex_line_has_top_level_type(raw: raw, event_type: "turn.failed") {
    Present { value: CodexProviderEvent {
      line_number: line_number,
      raw: raw,
      kind: CodexTurnFailed,
    } }
  } else if codex_line_has_top_level_type(raw: raw, event_type: "error") {
    Present { value: CodexProviderEvent {
      line_number: line_number,
      raw: raw,
      kind: CodexError,
    } }
  } else {
    none
  }
}

fn codex_parse_fold_line(
  state: CodexParseFold,
  line: String,
  max_line_chars: Int,
) -> CodexParseFold {
  if state.refused {
    CodexParseFold {
      events: state.events,
      next_line_number: state.next_line_number + 1,
      total_lines: state.total_lines,
      refused: state.refused,
      refused_line_number: state.refused_line_number,
      refused_raw: state.refused_raw,
      refused_reason: state.refused_reason,
    }
  } else {
    let raw = trim(line)
    let raw_chars = string_length(s: raw)
    let is_trailing_empty = raw == ""
      && state.next_line_number == state.total_lines
    if is_trailing_empty {
      CodexParseFold {
        events: state.events,
        next_line_number: state.next_line_number + 1,
        total_lines: state.total_lines,
        refused: false,
        refused_line_number: 0,
        refused_raw: "",
        refused_reason: "",
      }
    } else if raw_chars > max_line_chars {
      CodexParseFold {
        events: state.events,
        next_line_number: state.next_line_number + 1,
        total_lines: state.total_lines,
        refused: true,
        refused_line_number: state.next_line_number,
        refused_raw: join([
          "<oversized Codex JSONL event elided: ",
          to_string(raw_chars),
          " chars>",
        ], ""),
        refused_reason: join([
          "Codex JSONL event exceeds observation line budget ",
          to_string(max_line_chars),
          " chars; full raw remains in attempt evidence",
        ], ""),
      }
    } else if raw == "" {
      CodexParseFold {
        events: state.events,
        next_line_number: state.next_line_number + 1,
        total_lines: state.total_lines,
        refused: true,
        refused_line_number: state.next_line_number,
        refused_raw: line,
        refused_reason: "empty line inside Codex JSONL stream",
      }
    } else if !json_text_parseable(s: raw) {
      CodexParseFold {
        events: state.events,
        next_line_number: state.next_line_number + 1,
        total_lines: state.total_lines,
        refused: true,
        refused_line_number: state.next_line_number,
        refused_raw: line,
        refused_reason: "malformed or truncated Codex JSONL object",
      }
    } else {
      match codex_event_from_complete_line(
        raw: raw,
        line_number: state.next_line_number,
      ) {
        Present { value: event } =>
          CodexParseFold {
            events: append(state.events, [event]),
            next_line_number: state.next_line_number + 1,
            total_lines: state.total_lines,
            refused: false,
            refused_line_number: 0,
            refused_raw: "",
            refused_reason: "",
          }
        Absent =>
          CodexParseFold {
            events: state.events,
            next_line_number: state.next_line_number + 1,
            total_lines: state.total_lines,
            refused: true,
            refused_line_number: state.next_line_number,
            refused_raw: line,
            refused_reason: "unknown Codex JSONL event type",
          }
      }
    }
  }
}

fn parse_codex_jsonl_with_line_budget(
  text: String,
  max_line_chars: Int,
) -> CodexEventParse {
  if text == "" {
    CodexEventsParsed { events: [] }
  } else {
    let lines = split(s: text, delimiter: "\n")
    let state = fold(
      lines,
      init: CodexParseFold {
        events: [],
        next_line_number: 1,
        total_lines: count(lines),
        refused: false,
        refused_line_number: 0,
        refused_raw: "",
        refused_reason: "",
      },
      f: fn(acc, line) {
        codex_parse_fold_line(
          state: acc,
          line: line,
          max_line_chars: max_line_chars,
        )
      },
    )
    if state.refused {
      CodexEventsRefused {
        events_before_refusal: state.events,
        line_number: state.refused_line_number,
        raw: state.refused_raw,
        reason: state.refused_reason,
      }
    } else {
      CodexEventsParsed { events: state.events }
    }
  }
}

fn parse_codex_jsonl(text: String) -> CodexEventParse {
  parse_codex_jsonl_with_line_budget(
    text: text,
    max_line_chars: codex_provider_event_line_observation_budget_chars,
  )
}

fn provider_execution_fold_event(
  state: ProviderExecutionState,
  event: CodexProviderEvent,
) -> ProviderExecutionState {
  match state {
    ProviderCompleted { activity: _ } => state
    ProviderFailed { activity: _, detail: _ } => state
    ProviderEventsRefused { activity: _, detail: _ } => state
    _ =>
      match event.kind {
        CodexThreadStarted => ProviderStarting { activity: "thread started" }
        CodexTurnStarted => ProviderRunning { activity: "agent started" }
        CodexItemStarted { activity } =>
          ProviderRunning { activity: codex_item_activity_label(activity: activity) }
        CodexItemCompleted { activity } =>
          ProviderRunning {
            activity: join(
              [codex_item_activity_label(activity: activity), " completed"],
              "",
            ),
          }
        CodexTurnCompleted =>
          ProviderCompleted { activity: "agent turn completed" }
        CodexTurnFailed =>
          ProviderFailed { activity: "agent turn failed", detail: event.raw }
        CodexError =>
          ProviderFailed { activity: "provider error", detail: event.raw }
      }
  }
}

fn provider_execution_state(parsed: CodexEventParse) -> ProviderExecutionState {
  match parsed {
    CodexEventsParsed { events } =>
      fold(
        events,
        init: ProviderNotStarted,
        f: fn(state, event) {
          provider_execution_fold_event(state: state, event: event)
        },
      )
    CodexEventsRefused {
      events_before_refusal,
      line_number,
      raw,
      reason,
    } =>
      let prior = fold(
        events_before_refusal,
        init: ProviderNotStarted,
        f: fn(state, event) {
          provider_execution_fold_event(state: state, event: event)
        },
      )
      ProviderEventsRefused {
        activity: match prior {
          ProviderNotStarted => "event stream refused"
          ProviderStarting { activity } =>
            join(["last observed · ", activity], "")
          ProviderRunning { activity } =>
            join(["last observed · ", activity], "")
          ProviderCompleted { activity } =>
            join(["last observed · ", activity], "")
          ProviderFailed { activity, detail: _ } =>
            join(["last observed · ", activity], "")
          ProviderEventsRefused { activity, detail: _ } =>
            join(["last observed · ", activity], "")
        },
        detail: join([
          "line ", to_string(line_number), ": ", reason, "; raw=", raw,
        ], ""),
      }
  }
}

fn provider_execution_state_label(state: ProviderExecutionState) -> String {
  match state {
    ProviderNotStarted => "not_started"
    ProviderStarting { activity: _ } => "starting"
    ProviderRunning { activity: _ } => "running"
    ProviderCompleted { activity: _ } => "completed"
    ProviderFailed { activity: _, detail: _ } => "failed"
    ProviderEventsRefused { activity: _, detail: _ } => "events_refused"
  }
}

fn provider_execution_activity(state: ProviderExecutionState) -> String {
  match state {
    ProviderNotStarted => "waiting for provider events"
    ProviderStarting { activity } => activity
    ProviderRunning { activity } => activity
    ProviderCompleted { activity } => activity
    ProviderFailed { activity, detail: _ } => activity
    ProviderEventsRefused { activity, detail: _ } => activity
  }
}

fn provider_execution_detail(state: ProviderExecutionState) -> String {
  match state {
    ProviderFailed { activity: _, detail } => detail
    ProviderEventsRefused { activity: _, detail } => detail
    _ => ""
  }
}
