module gunbc.rung_drop_amendment.kit_call_shape_drifted_on_first_use

import std.types { NonEmptyStr }
import gunbc.rung_drop_amendment { RungDropAmendment }

data kit_call_shape_drifted_on_first_use: RungDropAmendment = RungDropAmendment {
  drop_identity: "kit_call_shape_restates_the_home_signature" as NonEmptyStr,

  amended: "2026-10-24",

  later_event: "the restated signature drifted from its declaration on its first real use: #14843 shipped the list_push candidate row with kit_call params xs and x, while the declared home on #14751 is std.algebra fn list_push<T>(xs: FreeMonoid<T>, item: T). Found by reading the row against the declaration when adopting the kit (sunny-bee-153), before any kit run. The row was corrected to item when it moved into ambient_name_homes(); the declaration was not changed, because it is the authority and the row restates it (ruling relayed by tidy-ant-251).",

  bearing: "the drop's whole population, and the hazard its reason names: a second authority for a signature disagreed with the first at the first opportunity. It failed toward loud, as the drop states: a fixture calling list_push(xs: ..., x: ...) does not bind the declaration, so the kit would have read KitNotRunnable (a located no-observation), never KitMigrated. The drift was caught by reading, so this is evidence of the hazard and of the fail-loud direction, not a measured kit run."
}
