module gunbc.rung_drop_amendment.value_depth_runtime_tests_named_in_the_population

import std.types { NonEmptyStr }
import gunbc.rung_drop_amendment { RungDropAmendment }

data value_depth_runtime_tests_named_in_the_population: RungDropAmendment = RungDropAmendment {
  drop_identity: "rust_unit_tests_off_the_merge_path" as NonEmptyStr,

  amended: "2026-10-01",

  later_event: "gunbc#12886 repaired gunbc.recurring_failure_mode recursion_over_value_depth_uncounted_by_the_call_limit (native recursion over a value's depth killed the interpreter, rc=134, below the call-depth limit) and its deep-value RUNTIME evidence joins this drop's population by name: v1_interpreter value_depth_walker_tests (a 262,144-deep chain and list driven through the iterative Value Drop, every walker under value_depth_guarded, and the located JSON-depth refusal at serde_json's probed read limit) and cli_run collect_node_values_depth_tests. They cannot sit on the floor instead: building a value that deep costs one interpreted step per level, past the eval-step budget, and a shallower value does not overflow and so discriminates nothing.",

  bearing: "the population grows by these two test modules; the loss, reason and restoration trigger are unchanged and they return to the merge path with the rest of the population. The STRUCTURAL half of the same evidence is NOT in this population: the census of unguarded recursive Value walkers (unguarded_recursive_value_walkers, in src/v1/stage0/build.rs) runs in v1-compiler's build script and refuses the build, so every lane that compiles the crate -- the required lint step among them -- enforces it on every merge (measured red: stripping the guard from value_fast_eq fails the build naming that walker)."
}
