module gunbc.dgx_spark_procurement

import std.types { NonEmptyStr, String, List, Int, Bool }
import product.placement_supply { HostIdentity }
import extdeps.systems.types { IntegratedComputeSystemCatalogRow }
import extdeps.systems.nvidia_fleet_lifecycle {
  FleetLifecycleEnvelope,
  FleetLifecycleStatus,
  StatusOk,
  StatusWarning,
  StatusError,
  DeviceIdentity,
  fleet_lifecycle_operation_tool_name,
}
import extdeps.systems.nvidia { nvidia_dgx_spark_4tb_catalog }
import extdeps.router.verizon_cr1000a { Cr1000aDhcpLeaseRow }
import gunbc.fleet_intent_network { operator_host_srv5, operator_host_srv6 }

// SPARK-0 (2026-08-05). Three deliberately separate fact classes, per the brief: (1) the vendor catalog (extdeps.systems.nvidia) -- what NVIDIA documents the product to be; (2) operator procurement intent (this module) -- that two units were ordered and that srv5/srv6 are RESERVED identities for them; (3) deployment observation -- physical binding evidence (serials, MACs, IPs, installed OS build) that does not exist yet and must never be fabricated. A reserved identity is explicitly NOT enrollment: srv5/srv6 do not appear in gunbc.fleet_intent_network's endpoint list, gunbc.fleet_intent's ComputeHost list, or any phase matrix/compute offer.
// SPARK-LANE-A (2026-08-06) revises the identity home only: the `srv5_reserved`/`srv6_reserved` rows minted here are deleted and the identities are imported from gunbc.fleet_intent_network, which is the single authority for a host's fleet identity (§3 -- one concept, one home; SPARK-0 forked it privately only because that file was mid-refactor and out of scope at the time). Reserved-not-enrolled is unchanged and is now carried structurally by the router-binding wall below rather than by prose alone.
type HardwareProcurementIntent {
  vendor_catalog: IntegratedComputeSystemCatalogRow
  unit_count: Int
  reserved_identities: List<HostIdentity>
  ordered_note: NonEmptyStr
}

// SPARK-LANE-A. The router-side half of a reserved identity: a DHCP static reservation on the operator's LAN router is the act that turns "an identity we intend to use" into "an address the fleet can reach", and gunbc.fleet_intent_network's network_endpoint note records that this act had no carrier anywhere in the tree. It has one now. The reservation is NOT re-modeled here: it is the cited extdeps.router.verizon_cr1000a Cr1000aDhcpLeaseRow (mac x ipv4 x lease), the same row gunbc.network_identity_subsumption already consumes for srv3 -- minting a second mac/address pair beside it would be the §3 nickname failure. `reservation` is Optional because for srv5/srv6 the hardware has not physically arrived: no MAC exists to reserve against and no address has been chosen, so BOTH halves of the row are unobservable and the honest state is Absent. Absent here means "no observation yet" as a downstream coverage obligation (§3 external-decomposition: the obligation is recorded by the observer, never as an `Unobserved` property authored into the upstream router module), and it is fail-closed: `admit_dgx_spark_deployment` refuses on it, so the absence blocks admission rather than being skipped past.
type DgxSparkRouterBinding {
  identity: HostIdentity
  reservation: Cr1000aDhcpLeaseRow?
}

data srv5_router_binding: DgxSparkRouterBinding = DgxSparkRouterBinding {
  identity: operator_host_srv5,
  reservation: none,
}

data srv6_router_binding: DgxSparkRouterBinding = DgxSparkRouterBinding {
  identity: operator_host_srv6,
  reservation: none,
}

data dgx_spark_router_bindings: List<DgxSparkRouterBinding> = [srv5_router_binding, srv6_router_binding]

// Derived, not spelled: the set of reserved identities IS the set of identities carrying a router binding row, so the two cannot disagree (§2 -- a second hand-written identity list would be a duplicate of this one, and the duplicate is what drifts).
fn dgx_spark_reserved_identities() -> List<HostIdentity> {
  map(dgx_spark_router_bindings, b => b.identity)
}

data dgx_spark_procurement_intent: HardwareProcurementIntent = HardwareProcurementIntent {
  vendor_catalog: nvidia_dgx_spark_4tb_catalog,
  unit_count: 2,
  reserved_identities: dgx_spark_reserved_identities(),
  ordered_note: "2x NVIDIA DGX Spark ordered; not yet arrived as of 2026-08-06 (operator, relayed via bold-eagle-107 / HOST-0 SPARK-0 brief).",
}

type DgxSparkDeployment {
  identity: HostIdentity
  catalog: IntegratedComputeSystemCatalogRow
  identity_observation: FleetLifecycleEnvelope
  router_reservation: Cr1000aDhcpLeaseRow
}

type DgxSparkAdmissionRefusalReason
  = DeploymentAdmissionNoEvidence
  | DeploymentAdmissionWrongTool { observed_tool: NonEmptyStr }
  | DeploymentAdmissionHostMismatch { observed_host: NonEmptyStr, requested_identity: HostIdentity }
  | DeploymentAdmissionObservationNotOk { observed_status: FleetLifecycleStatus, observed_rc: Int }
  | DeploymentAdmissionIdentityNotReserved { requested_identity: HostIdentity }
  | DeploymentAdmissionRouterBindingMismatch { binding_identity: HostIdentity, requested_identity: HostIdentity }
  | DeploymentAdmissionRouterBindingPending { requested_identity: HostIdentity }

type DgxSparkAdmissionOutcome
  = DgxSparkDeploymentAdmitted { deployment: DgxSparkDeployment }
  | DgxSparkDeploymentRefused { reason: DgxSparkAdmissionRefusalReason }

fn host_identity_is_reserved(identity: HostIdentity) -> Bool {
  fold(
    dgx_spark_reserved_identities(),
    init: false,
    f: (acc, reserved) => acc || reserved == identity,
  )
}

// The whole admission decision as a first-refusal chain, ending at the single construction site for DgxSparkDeploymentAdmitted. The chain is nested rather than flat precisely so that the success arm is reachable only past every check: there is no sibling arm that constructs an admitted deployment, so adding a check cannot be bypassed by forgetting to re-order one. The reservation is destructured at the point it is needed, so "the binding is reserved" is not checked once and then trusted -- the admitted deployment is built FROM the reservation value, and an Absent reservation has no value to build from.
fn admit_observed_dgx_spark_deployment(
  identity: HostIdentity,
  catalog: IntegratedComputeSystemCatalogRow,
  envelope: FleetLifecycleEnvelope,
  router_binding: DgxSparkRouterBinding,
) -> DgxSparkAdmissionOutcome {
  if envelope.tool != fleet_lifecycle_operation_tool_name(op: DeviceIdentity) {
    DgxSparkDeploymentRefused {
      reason: DeploymentAdmissionWrongTool { observed_tool: envelope.tool }
    }
  } else {
    if identity != (envelope.host as HostIdentity) {
      DgxSparkDeploymentRefused {
        reason: DeploymentAdmissionHostMismatch {
          observed_host: envelope.host,
          requested_identity: identity,
        }
      }
    } else {
      if !envelope_reports_success(envelope: envelope) {
        DgxSparkDeploymentRefused {
          reason: DeploymentAdmissionObservationNotOk {
            observed_status: envelope.status,
            observed_rc: envelope.rc,
          }
        }
      } else {
        if !host_identity_is_reserved(identity: identity) {
          DgxSparkDeploymentRefused {
            reason: DeploymentAdmissionIdentityNotReserved { requested_identity: identity }
          }
        } else {
          if router_binding.identity != identity {
            DgxSparkDeploymentRefused {
              reason: DeploymentAdmissionRouterBindingMismatch {
                binding_identity: router_binding.identity,
                requested_identity: identity,
              }
            }
          } else {
            match router_binding.reservation {
              Present { value: reservation } =>
                DgxSparkDeploymentAdmitted {
                  deployment: DgxSparkDeployment {
                    identity: identity,
                    catalog: catalog,
                    identity_observation: envelope,
                    router_reservation: reservation,
                  }
                }
              Absent =>
                DgxSparkDeploymentRefused {
                  reason: DeploymentAdmissionRouterBindingPending { requested_identity: identity }
                }
            }
          }
        }
      }
    }
  }
}

// A tool ran is not a tool succeeded. The cited envelope carries BOTH a status and an exit code and they are independent facts (a StatusWarning `Endpoint degraded` observation is documented as "tool ran successfully but returned warning or failure status due to device health signals"), so success is the conjunction, never either one alone.
fn envelope_reports_success(envelope: FleetLifecycleEnvelope) -> Bool {
  match envelope.status {
    StatusOk => envelope.rc == 0
    StatusWarning => false
    StatusError => false
  }
}

// The construction wall: a DgxSparkDeployment cannot be admitted from catalog + procurement intent alone -- that refusal is the deliverable this file exists to prove, not an incidental side effect. Per review 49071: presence of a device_identity.py envelope alone is not sufficient either -- the envelope's host (the orchestrator's target identity for the observation it actually ran) must equal the identity being admitted, or a valid observation of one host could bind a deployment for a different one. Per review 49094: the refusal causes are a closed DgxSparkAdmissionRefusalReason coproduct, not free-text prose (DESIGN §3/§5 undeclared-sum), matching the sibling FleetLifecycleFailureClass pattern one file over.
// SPARK-LANE-A adds the three checks the SPARK-0 wall was missing, each of which admitted a state that is plainly wrong rather than merely unproven: (1) a device_identity.py envelope reporting StatusError with rc=1 -- a FAILED observation -- was admitted, because only the tool name and host were read (a §5 fail-open: the failure arm of the observation was treated as evidence of success); (2) an arbitrary HostIdentity was admitted, so an observation of a host nobody ordered could mint a DGX Spark deployment; (3) admission was decoupled from the router binding, so a unit could be "deployed" with no reachable address reserved for it. The identity check derives from the binding roster rather than a second list, so "reserved" has one meaning here.
fn admit_dgx_spark_deployment(
  identity: HostIdentity,
  catalog: IntegratedComputeSystemCatalogRow,
  identity_observation: FleetLifecycleEnvelope?,
  router_binding: DgxSparkRouterBinding,
) -> DgxSparkAdmissionOutcome {
  match identity_observation {
    Absent => DgxSparkDeploymentRefused { reason: DeploymentAdmissionNoEvidence }
    Present { value: envelope } =>
      admit_observed_dgx_spark_deployment(
        identity: identity,
        catalog: catalog,
        envelope: envelope,
        router_binding: router_binding,
      )
  }
}

// SPARK-LANE-A: the procurement-grain convergence read. Per-unit disposition is DERIVED by calling admit_dgx_spark_deployment, never by a second copy of its checks -- a forked convergence rule would let a unit read "converged" here while the wall refuses it (§2/§3).
type DgxSparkUnitDisposition
  = DgxSparkUnitDeployed { deployment: DgxSparkDeployment }
  | DgxSparkUnitPending { identity: HostIdentity, reason: DgxSparkAdmissionRefusalReason }

type DgxSparkProcurementConvergence
  = DgxSparkProcurementConverged { deployments: List<DgxSparkDeployment> }
  | DgxSparkProcurementPending { pending: List<DgxSparkUnitDisposition> }

// Two arms, not three: a unit is deployed or it is pending with a typed, located cause. There is deliberately no `Unknown` arm -- every reason a unit is not deployed is one of the closed DgxSparkAdmissionRefusalReason causes, so "we could not tell" cannot masquerade as a verdict (§5 state-space conflation). This is a diff-shaped read but NOT an instance of the gunbc.membership_reconcile spine: that spine reconciles a desired member set against an OBSERVED member set of the same type with teardown as the Removed arm, and here the two sides are different types (a reserved identity vs an admitted deployment) and there is no teardown -- you cannot retract a machine that was never present. Instantiating the spine would mean inventing an M that fits neither side, so the genericity would buy nothing and cost a fake member type.
fn observation_for_identity(
  identity: HostIdentity,
  observations: List<FleetLifecycleEnvelope>,
) -> FleetLifecycleEnvelope? {
  fold(
    observations,
    init: none,
    f: (acc, envelope) =>
      match acc {
        Present { value: found } => Present { value: found }
        Absent =>
          if (envelope.host as HostIdentity) == identity {
            Present { value: envelope }
          } else {
            none
          }
      }
  )
}

fn dgx_spark_unit_disposition(
  binding: DgxSparkRouterBinding,
  observations: List<FleetLifecycleEnvelope>,
) -> DgxSparkUnitDisposition {
  match admit_dgx_spark_deployment(
    identity: binding.identity,
    catalog: dgx_spark_procurement_intent.vendor_catalog,
    identity_observation: observation_for_identity(identity: binding.identity, observations: observations),
    router_binding: binding,
  ) {
    DgxSparkDeploymentAdmitted { deployment: d } => DgxSparkUnitDeployed { deployment: d }
    DgxSparkDeploymentRefused { reason: r } =>
      DgxSparkUnitPending { identity: binding.identity, reason: r }
  }
}

fn converge_dgx_spark_procurement(
  bindings: List<DgxSparkRouterBinding>,
  observations: List<FleetLifecycleEnvelope>,
) -> DgxSparkProcurementConvergence {
  let dispositions = map(bindings, b => dgx_spark_unit_disposition(binding: b, observations: observations))
  let pending = flat_map(dispositions, d =>
    match d {
      DgxSparkUnitPending { identity: i, reason: r } => [DgxSparkUnitPending { identity: i, reason: r }]
      DgxSparkUnitDeployed { deployment: _ } => []
    }
  )
  let deployments = flat_map(dispositions, d =>
    match d {
      DgxSparkUnitDeployed { deployment: dep } => [dep]
      DgxSparkUnitPending { identity: _, reason: _ } => []
    }
  )
  if count(pending) > 0 {
    DgxSparkProcurementPending { pending: pending }
  } else {
    DgxSparkProcurementConverged { deployments: deployments }
  }
}

// The LIVE read, as of 2026-08-06: the real binding roster against an EMPTY observation list. The empty list is not a placeholder standing in for observations that exist -- no read transport for the fleet-lifecycle tools is bound anywhere in the tree (extdeps.systems.nvidia_fleet_lifecycle models the operation shape only), and the units have not arrived, so zero observations is the true observed population. This converges the day both units are reserved on the router AND a real device_identity.py envelope for each is supplied; today it is Pending with two DeploymentAdmissionNoEvidence rows, and that is the whole point.
fn dgx_spark_procurement_convergence() -> DgxSparkProcurementConvergence {
  converge_dgx_spark_procurement(bindings: dgx_spark_router_bindings, observations: [])
}
