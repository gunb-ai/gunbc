data descent_derivation_walkers: V1ComplexityCapability = V1ComplexityCapability {
  capability: "descent-derivation-walkers" as NonEmptyStr,
  v1_symbol: "collect_descent_vars" as NonEmptyStr,
  disposition: NeedsMigration {
    destination_module: "v2.lens.cost" as NonEmptyStr,
    phase: "parity C4 — the largest slice, now bounded by this row" as NonEmptyStr,
    note: "This is what is genuinely seed-local: the walkers that PRODUCE the shared vocabulary by traversing the v1 AST — collect_descent_vars, classify_self_call_evidence, all_self_calls_descend, is_child_descent_expr, is_list_shrink_expr and their neighbours, each threading si: Map<String, NewlineIndex> and matching on v1 syntax. They do not port; they are re-expressed as a fold over the closed v2 Node kernel, which is why the parity ruling says do not port src/v1/complexity.dag wholesale. With the three shared-substrate rows above discharging the vocabulary, C4's real surface is this derivation layer plus the interprocedural memo." as NonEmptyStr
  }
}

