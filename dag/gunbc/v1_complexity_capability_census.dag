data v1_complexity_inventory_roster: List<V1ComplexityInventoryRow> = [
  asymptotic_class_and_dominance,
  polynomial_degree_reading,
  size_expression_algebra,
  cost_expression_algebra,
  bounded_summation,
  retained_max_expression,
