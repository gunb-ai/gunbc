data roster_completeness_note: String = "Completeness is an identity join, not a count (DESIGN §5). The roster's own hygiene properties are: every capability key is distinct, every v1 symbol resolves in src/v1/complexity.dag, and every cited destination symbol resolves in the file its row names. What this census does NOT claim is that the roster exhausts src/v1/complexity.dag's 201 declarations — it is a capability inventory, not a declaration inventory, and many declarations are helpers of a rostered capability rather than capabilities themselves. A declaration-grain completeness claim would need its own discovered, closed subject universe; asserting one here from a hand-authored list would be the quieter snapshot DESIGN §5 rejects."

fn capability_is_deferred(c: V1ComplexityCapability) -> Bool {
  match c.disposition {
    AlreadyInV2 { carrier: _, note: _ } => false
    AvailableInSharedSubstrate { carrier: _, note: _ } => false
    NeedsMigration { destination_module: _, phase: _, note: _ } => false
    SupersededByBetterModel { superseded_by: _, note: _ } => false
    DeliberatelyRetired { reason: _ } => false
    DispositionDeferred { question: _, decided_by: _ } => true
  }
}

fn capability_needs_migration(c: V1ComplexityCapability) -> Bool {
  match c.disposition {
    AlreadyInV2 { carrier: _, note: _ } => false
    AvailableInSharedSubstrate { carrier: _, note: _ } => false
    NeedsMigration { destination_module: _, phase: _, note: _ } => true
    SupersededByBetterModel { superseded_by: _, note: _ } => false
    DeliberatelyRetired { reason: _ } => false
    DispositionDeferred { question: _, decided_by: _ } => false
  }
}

fn capability_is_discharged(c: V1ComplexityCapability) -> Bool {
  match c.disposition {
    AlreadyInV2 { carrier: _, note: _ } => true
    AvailableInSharedSubstrate { carrier: _, note: _ } => true
    NeedsMigration { destination_module: _, phase: _, note: _ } => false
    SupersededByBetterModel { superseded_by: _, note: _ } => true
    DeliberatelyRetired { reason: _ } => false
    DispositionDeferred { question: _, decided_by: _ } => false
  }
}

data capability_cited_carrier_note: String = "Returns the destination citation for the arms that carry one, so the witness can resolve every named symbol through a single seam rather than re-matching the coproduct per check. The arms that name no destination symbol — NeedsMigration names a module and a phase, DeliberatelyRetired a reason, DispositionDeferred a question — return Absent, and the witness only asserts resolution where a symbol was actually claimed. Absent here means 'this arm cites no symbol by construction', never 'the symbol could not be found'; the two are different states and the witness must not conflate them."

fn capability_cited_carrier(c: V1ComplexityCapability) -> CitedSymbol? {
  match c.disposition {
    AlreadyInV2 { carrier: cs, note: _ } => Present { value: cs }
    AvailableInSharedSubstrate { carrier: cs, note: _ } => Present { value: cs }
    NeedsMigration { destination_module: _, phase: _, note: _ } => none
    SupersededByBetterModel { superseded_by: cs, note: _ } => Present { value: cs }
    DeliberatelyRetired { reason: _ } => none
    DispositionDeferred { question: _, decided_by: _ } => none
  }
}

fn capability_migration_phase(c: V1ComplexityCapability) -> String {
  match c.disposition {
    AlreadyInV2 { carrier: _, note: _ } => ""
    AvailableInSharedSubstrate { carrier: _, note: _ } => ""
    NeedsMigration { destination_module: _, phase: p, note: _ } => p
    SupersededByBetterModel { superseded_by: _, note: _ } => ""
    DeliberatelyRetired { reason: _ } => ""
    DispositionDeferred { question: _, decided_by: _ } => ""
  }
}

fn capability_deferred_question(c: V1ComplexityCapability) -> String {
  match c.disposition {
    AlreadyInV2 { carrier: _, note: _ } => ""
    AvailableInSharedSubstrate { carrier: _, note: _ } => ""
    NeedsMigration { destination_module: _, phase: _, note: _ } => ""
    SupersededByBetterModel { superseded_by: _, note: _ } => ""
    DeliberatelyRetired { reason: _ } => ""
    DispositionDeferred { question: q, decided_by: _ } => q
  }
}

fn v1_complexity_deferred_count() -> Nat {
  fold(v1_complexity_capability_roster, init: 0, f: (acc, c) =>
    if capability_is_deferred(c: c) { acc + 1 } else { acc })
}

fn v1_complexity_migration_count() -> Nat {
  fold(v1_complexity_capability_roster, init: 0, f: (acc, c) =>
    if capability_needs_migration(c: c) { acc + 1 } else { acc })
}

fn v1_complexity_discharged_count() -> Nat {
  fold(v1_complexity_capability_roster, init: 0, f: (acc, c) =>
    if capability_is_discharged(c: c) { acc + 1 } else { acc })
}

data census_reads_note: String = "The derived reads this census supports, none of them stored: how much of the parity program is already discharged by landed substrate (the AlreadyInV2 plus AvailableInSharedSubstrate population), how much is genuinely owed (NeedsMigration), and how much is blocked on a decision nobody has made (DispositionDeferred). The third number is the one that should be smallest and should shrink to zero at C0 sign-off; a census where it grows is a census being used to avoid deciding."
