  v1_symbol: "cost_account_space_from_summary" as NonEmptyStr,
  disposition: NeedsMigration {
    destination_module: "std.realization_schedule" as NonEmptyStr,
    phase: "parity C5 — realization bridge" as NonEmptyStr,
    note: "CENSUS FINDING — a live instance of the citation class DESIGN §3 names, and direct evidence for parity open question 3. The function's own note says it fills 'CostAccount.space (basis Derived)'. Verified against the tree: it returns a bare ByteSize?, constructs no CostAccount, and v1.complexity does not import std.realization_schedule at all — while std.realization_schedule's CostBasis is Predicted | Measured, with no Derived arm anywhere in the tree. So the seed already records an INTENT for a derived basis that the single authority cannot represent, and the name cost_account_space_from_summary is a nickname for what the function actually computes, a peak-space evaluation at a closed size environment. That makes the three-valued CostBasis widening a documented gap rather than a speculative widening — still an operator amendment, but now with a receipt." as NonEmptyStr
  }
}

