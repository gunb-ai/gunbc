type CapabilityWorkKind
  = NoWorkOwed
  | IntegrationWork
  | MigrationWork
  | RetirementWork

data capability_work_kind_note: String = "The projection the previous revision got wrong. Three of the six arms owe no further parity work (CompleteInV2, SupersededByBetterModel, Retired); the other three owe DIFFERENT KINDS of work, and collapsing integration into 'discharged' is what understated C4. Every arm maps to exactly one kind, so the partition is total by construction and a newly added arm cannot silently fall outside it."

fn capability_work_kind(c: V1ComplexityInventoryRow) -> CapabilityWorkKind {
  match c.disposition {
    CompleteInV2 { carrier: _, note: _ } => NoWorkOwed
    SupersededByBetterModel { superseded_by: _, note: _ } => NoWorkOwed
    Retired { reason: _ } => NoWorkOwed
    IntegrationOwed { substrate_carrier: _, phase: _, note: _ } => IntegrationWork
    MigrationOwed { destination: _, producer: _, phase: _, note: _ } => MigrationWork
    RetirementOwed { trigger: _, note: _ } => RetirementWork
  }
}

fn capability_work_owed(c: V1ComplexityInventoryRow) -> Bool {
  match capability_work_kind(c: c) {
    NoWorkOwed => false
    IntegrationWork => true
    MigrationWork => true
    RetirementWork => true
  }
}

data capability_cited_carrier_note: String = "Returns the destination citation for the arms that carry one. Retired and RetirementOwed cite no destination declaration by construction — a retirement names a trigger, not a carrier — and return Absent. Absent here means 'this arm cites no declaration by construction', never 'the declaration could not be resolved'; the two are different states and the resolution witness must not conflate them."

fn capability_cited_carrier(c: V1ComplexityInventoryRow) -> std.decl_ref.DeclarationRef? {
  match c.disposition {
    CompleteInV2 { carrier: r, note: _ } => Present { value: r }
    IntegrationOwed { substrate_carrier: r, phase: _, note: _ } => Present { value: r }
    SupersededByBetterModel { superseded_by: r, note: _ } => Present { value: r }
    MigrationOwed { destination: _, producer: _, phase: _, note: _ } => none
    RetirementOwed { trigger: _, note: _ } => none
    Retired { reason: _ } => none
  }
}

fn capability_all_declaration_refs(rows: List<V1ComplexityInventoryRow>) -> List<std.decl_ref.DeclarationRef> {
  fold(rows, init: [], f: fn(acc, c) {
    match capability_cited_carrier(c: c) {
      Present { value: r } => concat(concat(acc, [c.v1_carrier]), [r])
      Absent => concat(acc, [c.v1_carrier])
    }
  })
}

fn capability_work_count(rows: List<V1ComplexityInventoryRow>, kind: CapabilityWorkKind) -> std.nat.Nat {
  fold(rows, init: 0, f: (acc, c) =>
    if capability_work_kind(c: c) == kind { acc + 1 } else { acc })
}

data census_reads_note: String = "The derived reads this census supports, none of them stored: how much of the program is already complete, how much owes INTEGRATION of substrate v2 has not consumed, how much owes MIGRATION out of the seed, and how much owes RETIREMENT once a replacement executes. The integration figure is the one the previous revision hid inside 'discharged', and it is the number that makes C4's size honest."

data inventory_identity_note: String = "Identity distinctness is VALIDATED here, not constructed — stated plainly because the previous revision claimed the stronger property. A closed coproduct constrains WHICH identities may exist; it does not stop a List from carrying one twice. inventory_item_key projects each row's identity to a comparable key (a residue's key includes the capability it qualifies, so the same hazard against two different capabilities is two identities, which is correct), and the witness folds a seen-map over it. When C0(b2) derives the population from DeclFact the distinctness becomes a property of the derivation rather than of an authored list, and this validation retires with the list."

fn complexity_capability_key(c: ComplexityCapabilityId) -> String {
  match c {
    AsymptoticClassAndDominance => "asymptotic-class-and-dominance"
    PolynomialDegreeReading => "polynomial-degree-reading"
    SizeExpressionAlgebra => "size-expression-algebra"
    CostExpressionAlgebra => "cost-expression-algebra"
    BoundedSummation => "bounded-summation"
    RetainedMaxExpression => "retained-max-expression"
    WorkAndSpan => "work-and-span"
    OutputSizeDerivation => "output-size-derivation"
    PeakSpaceDerivation => "peak-space-derivation"
    SpaceTimeDuality => "space-time-duality"
    CertaintyAxis => "certainty-axis"
    ConcreteInputEvaluation => "concrete-input-evaluation"
    InterproceduralSummaryMemo => "interprocedural-summary-memo"
    CallGraphAndScc => "call-graph-and-scc"
    DescentEvidenceVocabulary => "descent-evidence-vocabulary"
    CostBoundVocabulary => "cost-bound-vocabulary"
    LoweringTargetVocabulary => "lowering-target-vocabulary"
    DescentDerivationWalkers => "descent-derivation-walkers"
    RecursionPatternClassification => "recursion-pattern-classification"
    ParserProgressFactProduction => "parser-progress-fact-production"
    CollectionMethodCostShapes => "collection-method-cost-shapes"
    StructuralBoundReport => "structural-bound-report"
    CostExpressionRendering => "cost-expression-rendering"
    SizeVariableLegend => "size-variable-legend"
    CostAccountSpaceBridge => "cost-account-space-bridge"
  }
}

fn complexity_residue_key(r: V1ComplexityResidueId) -> String {
  match r {
    SummaryEvictionHazard => "summary-eviction-hazard"
    ParserProgressV1WalkerRealization => "parser-progress-v1-walker-realization"
  }
}

fn inventory_item_key(item: V1ComplexityInventoryItem) -> String {
  match item {
    SemanticCapabilityItem { capability: c } => concat("capability:", complexity_capability_key(c: c))
    LegacyHazardItem { hazard: h, of_capability: c } =>
      concat(concat("hazard:", complexity_residue_key(r: h)), concat("@", complexity_capability_key(c: c)))
    LegacyRealizationItem { realization: r, of_capability: c } =>
      concat(concat("realization:", complexity_residue_key(r: r)), concat("@", complexity_capability_key(c: c)))
  }
}

fn inventory_row_is_semantic_capability(row: V1ComplexityInventoryRow) -> Bool {
  match row.item {
    SemanticCapabilityItem { capability: _ } => true
    LegacyHazardItem { hazard: _, of_capability: _ } => false
    LegacyRealizationItem { realization: _, of_capability: _ } => false
  }
}

fn inventory_row_semantic_capability(row: V1ComplexityInventoryRow) -> ComplexityCapabilityId? {
  match row.item {
    SemanticCapabilityItem { capability: c } => Present { value: c }
    LegacyHazardItem { hazard: _, of_capability: _ } => Absent
    LegacyRealizationItem { realization: _, of_capability: _ } => Absent
  }
}

fn inventory_semantic_capability_count() -> std.nat.Nat {
  fold(v1_complexity_inventory_roster, init: 0, f: fn(acc, r) {
    if inventory_row_is_semantic_capability(row: r) { acc + 1 } else { acc }
  })
}

fn inventory_residue_count() -> std.nat.Nat {
  fold(v1_complexity_inventory_roster, init: 0, f: (acc, r) =>
    if inventory_row_is_semantic_capability(row: r) { acc } else { acc + 1 })
}

fn inventory_identity_keys() -> List<String> {
  fold(v1_complexity_inventory_roster, init: [], f: fn(acc, r) {
    concat(acc, [inventory_item_key(item: r.item)])
  })
}

fn key_occurrence_count(keys: List<String>, k: String) -> std.nat.Nat {
  fold(keys, init: 0, f: (n, other) => if other == k { n + 1 } else { n })
}

fn keys_are_distinct(keys: List<String>) -> Bool {
  fold(keys, init: true, f: (ok, k) => ok && key_occurrence_count(keys: keys, k: k) == 1)
}

fn inventory_identity_keys_distinct() -> Bool {
  keys_are_distinct(keys: inventory_identity_keys())
}

data capability_retirement_trigger_naming_note: std.dissolution.DissolutionCondition = unbound_dissolution(description: "NAMED CapabilityRetirementTrigger, not RetirementTrigger, and the reason is a §3 finding this census caught in itself. A bare RetirementTrigger ALREADY EXISTS in the tree as a VARIANT of gunbc.stage0_rust_honest_frontier_projection RustHonestFrontierDeferredAxis. Declaring a top-level type of that name shadowed the variant and broke lifecycle_totality_counts_retirement_trigger_as_underived_axis wi")
