  hand_authored_declarations: [
    DeclarationRef {
      module_path: "v1_compiler.target_invocation_host",
      decl_name: "instrument_revision",
      field: WholeDeclaration
    },
    DeclarationRef {
      module_path: "v1_compiler.target_invocation_host",
      decl_name: "select_base_population",
