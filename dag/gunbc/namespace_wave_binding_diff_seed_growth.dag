module gunbc.namespace_wave_binding_diff_seed_growth

import gunbc.roadmap.roadmap_model { RoadmapNodeId }
import gunbc.seed_growth { SeedGrowthJustification }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data namespace_wave_binding_diff_seed_growth_justification: SeedGrowthJustification = SeedGrowthJustification {
  hand_authored_declarations: [
    DeclarationRef {
      module_path: "v1_compiler.target_invocation_host",
      decl_name: "instrument_revision",
      field: WholeDeclaration
    },
    DeclarationRef {
      module_path: "v1_compiler.target_invocation_host",
      decl_name: "base_population",
      field: WholeDeclaration
    },
    DeclarationRef {
      module_path: "v1_compiler.target_invocation_host",
      decl_name: "BaseTreeGuard",
      field: WholeDeclaration
    }
  ],

  reason: "The producer arm for the Wave 1+ binding-diff admission gate (gunbc.target_binding, label //gunbc/instruments:namespace-wave-binding-diff). Its host part is only what no .dag fold can do: read GUNBC_WAVE_SHARD and GUNBC_CENSUS_SUBJECTS from the environment, acquire the label's own source closure and the stage0 tree id for the instrument revision, list the merge-base tree with git, check it out as a base worktree and run this executable's ambient-name census inside it. The decisions made inside the interpreted label (gunbc.instruments.namespace_wave_binding_diff and namespace_wave_binding_shard) are the shard plan, base selection and coverage, the occurrence join, the three receipt records and the verdict. The host DOES decide one thing: which merge-base modules enter the base census population (base_population, a whole-word git grep of the ruled names, with each file named by its own module declaration). That is a heuristic population choice held in the seed, not a binding-level fact; its next rung is the census or resolution reader selecting the population in .dag, which the trigger below covers. It sits in the host because the census reads a whole corpus at two revisions through the compiler front end, which an interpreted .dag entry cannot afford, and it is how a wave's rewrite is admitted at its own head. It serves the v2 self-host program under gunbc.v1.v1_maintenance_standing v1_seed_standing: it measures the namespace cut and changes no language behavior.",

  owning_dissolution_lane: "v1-hand-queue-drain" as RoadmapNodeId,

  trigger: "Delete these declarations when gunbc test's producer dispatch is emitted rather than hand-mirrored (the capability gunbc.target_invocation_seed_growth names for target_invocation_host as a whole) AND an emitted driver can list a git tree, materialize a base worktree and run a built census in it, handing its rows to a .dag fold, AND the base population is selected by the census or resolution reader rather than a text match, SUFFICIENT FOR //gunbc/instruments:namespace-wave-binding-diff to run with no hand-authored producer body.",

  current_boundary: "src/v1/stage0/src/target_invocation_host.rs run_namespace_wave_binding_diff and run_base_ambient_name_census, behind gunbc test //gunbc/instruments:namespace-wave-binding-diff"
}
