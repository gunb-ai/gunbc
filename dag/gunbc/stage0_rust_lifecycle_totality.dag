module gunbc.stage0_rust_lifecycle_totality

import gunbc.stage0_rust_host_observation {
  RustManifestObserved,
  RustSourceHostObservation
}
import gunbc.stage0_rust_source_lifecycle_scaffold {
  derived_generated_stage0_repo_paths,
  derived_hand_maintained_stage0_repo_paths,
  derived_partition_crate_lib_repo_paths,
  lifecycle_row_well_formed,
  list_concat_unique,
  path_in_list,
  path_occurrence_count,
  residue_lifecycle_repo_paths,
  rust_source_lifecycle_residue_rows,
  RustMaintenanceDisposition,
  RustSourceLifecycleRow
}
import std.content_hash { Fnv1a64Structural }
import v2.std.algebra { any, filter, fold_list, length, list_map, list_snoc_item }
import v2.std.collection { List }
import v2.std.text { String }

data stage0_rust_lifecycle_totality_note: String = "C1 carrier (Lane C / v1-honest-frontier): derives exact path sets from gunbc.stage0_rust_host_observation RustManifestObserved — tracked, generated, well-formed maintenance-disposition, unclassified, stale, duplicate, role-without-disposition, disposition-without-retirement-trigger. Completeness is an identity join over exact paths, never a count oracle (DESIGN section 5). Discovery (did we find every tracked path?) and decision (does every found path carry a disposition?) stay separate axes."

type LifecycleTotalityReceipt
  = LifecycleTotalityDerived {
      tracked_paths: List<String>,
      generated_paths: List<String>,
      maintenance_disposition_paths: List<String>,
      unclassified_paths: List<String>,
      stale_disposition_paths: List<String>,
      duplicate_disposition_paths: List<String>,
      role_without_disposition_paths: List<String>,
      disposition_without_retirement_trigger_paths: List<String>
    }
  | LifecycleTotalityObservationRefused

fn well_formed_maintenance_disposition_paths() -> List<String> {
  list_map(
    xs: filter(
      xs: rust_source_lifecycle_residue_rows,
      predicate: fn(row) { lifecycle_row_well_formed(row: row) }
    ),
    f: fn(row) { row.path }
  )
}

fn derived_file_grain_classified_repo_paths() -> List<String> {
  let from_generated = derived_generated_stage0_repo_paths()
  let with_hand = list_concat_unique(
    acc: from_generated,
    items: derived_hand_maintained_stage0_repo_paths()
  )
  let with_residue = list_concat_unique(acc: with_hand, items: residue_lifecycle_repo_paths())
  list_concat_unique(acc: with_residue, items: derived_partition_crate_lib_repo_paths())
}

fn exact_unclassified_tracked_paths(
  tracked_paths: List<String>,
  classified_paths: List<String>
) -> List<String> {
  filter(
    xs: tracked_paths,
    predicate: fn(path) { !path_in_list(path: path, paths: classified_paths) }
  )
}

fn exact_stale_disposition_paths(
  tracked_paths: List<String>,
  lifecycle_paths: List<String>
) -> List<String> {
  filter(
    xs: lifecycle_paths,
    predicate: fn(path) { !path_in_list(path: path, paths: tracked_paths) }
  )
}

fn exact_duplicate_disposition_paths(lifecycle_paths: List<String>) -> List<String> {
  fold_list(
    xs: lifecycle_paths,
    empty: [],
    cons: fn(acc, path) {
      if path_occurrence_count(paths: lifecycle_paths, needle: path) > 1
        && !path_in_list(path: path, paths: acc) {
        list_snoc_item(xs: acc, item: path)
      } else {
        acc
      }
    }
  )
}

fn exact_role_without_disposition_paths(
  cargo_bin_repo_paths: List<String>,
  disposition_paths: List<String>
) -> List<String> {
  filter(
    xs: cargo_bin_repo_paths,
    predicate: fn(path) { !path_in_list(path: path, paths: disposition_paths) }
  )
}

fn maintenance_disposition_has_retirement_trigger(
  disposition: RustMaintenanceDisposition
) -> Bool {
  match disposition {
    Generated { authority: _ } => true
    EmitFrom { authority: _ } => true
    DeleteWith { roadmap_node: node } => !((node as String) == "")
    RetainedKernel { reason: reason } => !(reason == "")
    HandScaffold { reason: reason, dissolve_on: dissolve_on } =>
      !(reason == "") && !(dissolve_on == "")
  }
}

fn row_lacks_retirement_trigger(row: RustSourceLifecycleRow) -> Bool {
  any(
    xs: row.maintenance_dispositions,
    predicate: fn(disposition) {
      !maintenance_disposition_has_retirement_trigger(disposition: disposition)
    }
  )
}

fn exact_disposition_without_retirement_trigger_paths() -> List<String> {
  list_map(
    xs: filter(
      xs: rust_source_lifecycle_residue_rows,
      predicate: fn(row) { row_lacks_retirement_trigger(row: row) }
    ),
    f: fn(row) { row.path }
  )
}

fn lifecycle_totality_receipt(
  observation: RustSourceHostObservation
) -> LifecycleTotalityReceipt {
  match observation {
    RustManifestObserved {
      repository_revision: revision,
      tracked_rust_repo_paths: tracked_paths,
      cargo_bin_repo_paths: cargo_bin_repo_paths,
      manifest_content_identity: _,
      prior_tracked_rust_repo_paths: _
    } =>
      if revision == "" {
        LifecycleTotalityObservationRefused
      } else {
        let generated_paths = derived_generated_stage0_repo_paths()
        let maintenance_disposition_paths = well_formed_maintenance_disposition_paths()
        let classified_paths = derived_file_grain_classified_repo_paths()
        let lifecycle_paths = classified_paths
        LifecycleTotalityDerived {
          tracked_paths: tracked_paths,
          generated_paths: generated_paths,
          maintenance_disposition_paths: maintenance_disposition_paths,
          unclassified_paths: exact_unclassified_tracked_paths(
            tracked_paths: tracked_paths,
            classified_paths: classified_paths
          ),
          stale_disposition_paths: exact_stale_disposition_paths(
            tracked_paths: tracked_paths,
            lifecycle_paths: lifecycle_paths
          ),
          duplicate_disposition_paths: exact_duplicate_disposition_paths(
            lifecycle_paths: lifecycle_paths
          ),
          role_without_disposition_paths: exact_role_without_disposition_paths(
            cargo_bin_repo_paths: cargo_bin_repo_paths,
            disposition_paths: maintenance_disposition_paths
          ),
          disposition_without_retirement_trigger_paths: exact_disposition_without_retirement_trigger_paths()
        }
      }
    _ => LifecycleTotalityObservationRefused
  }
}

fn lifecycle_discovery_complete(receipt: LifecycleTotalityReceipt) -> Bool {
  match receipt {
    LifecycleTotalityDerived {
      tracked_paths: tracked,
      generated_paths: generated_paths,
      maintenance_disposition_paths: maintenance_disposition_paths,
      unclassified_paths: unclassified_paths,
      stale_disposition_paths: stale_disposition_paths,
      duplicate_disposition_paths: duplicate_disposition_paths,
      role_without_disposition_paths: role_without_disposition_paths,
      disposition_without_retirement_trigger_paths: disposition_without_retirement_trigger_paths
    } => length(xs: tracked) > 0
    LifecycleTotalityObservationRefused => false
  }
}

fn lifecycle_decision_complete(receipt: LifecycleTotalityReceipt) -> Bool {
  match receipt {
    LifecycleTotalityDerived {
      tracked_paths: tracked_paths,
      generated_paths: generated_paths,
      maintenance_disposition_paths: maintenance_disposition_paths,
      unclassified_paths: unclassified,
      stale_disposition_paths: stale_disposition_paths,
      duplicate_disposition_paths: duplicate_disposition_paths,
      role_without_disposition_paths: role_without_disposition_paths,
      disposition_without_retirement_trigger_paths: disposition_without_retirement_trigger_paths
    } =>
      length(xs: unclassified) == 0
    LifecycleTotalityObservationRefused => false
  }
}

fn lifecycle_totality_witness_observation(extra_paths: List<String>) -> RustManifestObserved {
  let classified = derived_file_grain_classified_repo_paths()
  RustManifestObserved {
    repository_revision: "witness-deadbeef",
    manifest_content_identity: Fnv1a64Structural { digest: "abc1230000000000" },
    tracked_rust_repo_paths: list_concat_unique(acc: classified, items: extra_paths),
    prior_tracked_rust_repo_paths: classified,
    cargo_bin_repo_paths: ["src/v1/stage0/src/main.rs"]
  }
}
