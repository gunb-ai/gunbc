// THE PROTECTED HALF OF HEAL PUBLICATION (gunbc#10958 Phase B). It runs from the DEFAULT BRANCH'S
// workflow definition, on a runner no pull request's job has touched, with the default branch
// checked out and the pull request's tree never fetched. Its inputs are a downloaded candidate, the
// workflow_run event GitHub delivered, and what the GitHub API answers; its policy is its own
// checkout's registry.
//
// TWO ENTRIES, ONE ADMISSION. heal_publication_admit_wet runs BEFORE the workflow federates to any
// credential: a candidate that does not admit never causes an App token to be minted.
// heal_publication_publish_wet runs after, re-observes everything and admits again -- the branch may
// have moved while the credential was obtained, and only the admission it performs itself can mint
// the AdmittedHealPublication its writes consume -- and then writes, fast-forward only, and reads
// back.

data heal_publication_candidate_directory_env: NonEmptyStr = "HEAL_CANDIDATE_DIRECTORY"

data github_event_path_env_name: NonEmptyStr = "GITHUB_EVENT_PATH"

data heal_publication_receipt_path: String = "target/heal-publication-receipt.txt"

// WHICH REPOSITORY IS PUBLISHED TO, WHICH RUN MAY HAVE PRODUCED THE CANDIDATE, AND WHICH PATHS ARE
// PUBLISHABLE, AS ONE RECORD. The boundary (gunbc.heal_publication_boundary) already takes all three
// as observations; this module used to fill them from the public repository alone. gunbc-private's
// publisher runs this same transaction over its own record, so the admission and the writes are one
// protocol and the repositories differ only in the facts named here.
type HealPublicationSubject {
  repository: Repository
  candidate_producer_workflow_path: String
  committed_artifact_paths: List<String>
}

fn public_heal_publication_subject() -> HealPublicationSubject {
  HealPublicationSubject {
    repository: gunbc_repository,
    candidate_producer_workflow_path: artifact_path(a: HealWorkflowYamlArtifact),
    committed_artifact_paths: committed_generated_artifact_paths(),
  }
}

// ── Observation ─────────────────────────────────────────────────────────────────────────────

// NOTHING TO PUBLISH IS ITS OWN ARM, NOT A REFUSAL AND NOT AN ADMISSION. gunbc.heal_candidate writes
// a manifest on every run that concluded success, so a manifest carrying zero entries is the phase
// saying the tree was clean -- a fact it observed, and one this publisher may act on. A manifest that
// is ABSENT after a successful heal is the opposite: the candidate was owed and did not arrive, and
// that stays a refusal. Collapsing the two is what made a missed repair look like a quiet green.
type PublisherRun
  = PublisherRunAdmitted { admitted: AdmittedHealPublication, blobs: List<ObservedBlobContent>, pull_number: Int }
  | PublisherRunNothingToPublish
  | PublisherRunRefused { cause: String }

type ObservedBlobContent {
  blob_hex: String
  content: String
}

fn env_value(name: NonEmptyStr) -> String? {
  match shell.Env.Get(name: name).value {
    Absent => none
    Present { value: raw } => if trim(s: raw) == "" { none } else { Present { value: trim(s: raw) } }
  }
}

fn read_candidate_blob(directory: String, blob_hex: String) -> ObservedBlobRead {
  match git_sha1_object_id(hex: blob_hex) {
    Absent => ObservedBlobReadRefused { observation: ProposedBlobReadRefused { blob_hex: blob_hex, detail: "not a blob id" } }
    Present { value: oid } => {
      let path = candidate_file_path(directory: directory, file_name: candidate_blob_file_name(blob: oid))
      let read = Filesystem.Read(path: path)
      if !read.success {
        ObservedBlobReadRefused { observation: ProposedBlobReadRefused { blob_hex: blob_hex, detail: concat("unreadable: ", read.error) } }
      } else {
        match blob_id_of(content: read.content) {
          BlobIdRefused { cause } => ObservedBlobReadRefused { observation: ProposedBlobReadRefused { blob_hex: blob_hex, detail: cause } }
          BlobIdComputed { oid: computed } =>
            ObservedBlobReadDone {
              observation: ProposedBlobComputed { blob_hex: blob_hex, computed_hex: git_object_id_wire_hex(oid: computed) as String },
              content: ObservedBlobContent { blob_hex: blob_hex, content: read.content }
            }
        }
      }
    }
  }
}

type ObservedBlobRead
  = ObservedBlobReadDone { observation: ProposedBlobObservation, content: ObservedBlobContent }
  | ObservedBlobReadRefused { observation: ProposedBlobObservation }

fn observed_blob_observation(r: ObservedBlobRead) -> ProposedBlobObservation {
  match r {
    ObservedBlobReadDone { observation, content: _ } => observation
    ObservedBlobReadRefused { observation } => observation
  }
}

fn observed_blob_contents(reads: List<ObservedBlobRead>) -> List<ObservedBlobContent> {
  fold(reads, init: [], f: fn(acc, r) {
    match r {
      ObservedBlobReadDone { observation: _, content } => concat(acc, [content])
      ObservedBlobReadRefused { observation: _ } => acc
    }
  })
}

// EVERY REFUSAL LEAVES BY ITS OWN ARM'S NAME AND PAYLOAD, so a reader recovers the arm from the line.
fn refusal_line(refusal: HealPublicationRefusal) -> String {
  join([heal_publication_refusal_token(r: refusal) as String, ": ", heal_publication_refusal_detail(r: refusal)], "")
}

fn event_refusal_message(kind: String, detail: String) -> String {
  join(["HealPublicationEventUnreadable: ", kind, " ", detail], "")
}

// OBSERVE, THEN ADMIT. The two addressing checks here -- a head ref that cannot reach a REST path
// intact, and a candidate that did not decode -- stop before any request is made with a value the
// candidate chose; everything else is decided by admit_heal_publication over the full observation.
fn observe_and_admit_wet(subject: HealPublicationSubject) -> PublisherRun
{
  match env_value(name: heal_publication_candidate_directory_env) {
    Absent => PublisherRunRefused { cause: "HealPublicationContextUnreadable: HEAL_CANDIDATE_DIRECTORY is not set" }
    Present { value: directory } =>
      match env_value(name: github_event_path_env_name) {
        Absent => PublisherRunRefused { cause: "HealPublicationContextUnreadable: GITHUB_EVENT_PATH is not set" }
        Present { value: event_path } =>
          match workflow_run_event_from_event_path(path: event_path) {
            WorkflowRunEventMemberAbsent { member } => PublisherRunRefused { cause: event_refusal_message(kind: "member absent", detail: member) }
            WorkflowRunEventMemberMalformed { member, detail } => PublisherRunRefused { cause: event_refusal_message(kind: concat("member malformed ", member), detail: detail) }
            WorkflowRunEventMalformed { detail } => PublisherRunRefused { cause: event_refusal_message(kind: "malformed", detail: detail) }
            WorkflowRunEventPayloadReadRefused { path, cause } => PublisherRunRefused { cause: event_refusal_message(kind: concat("unreadable ", path), detail: cause) }
            WorkflowRunEventObserved { event } => {
              let manifest = Filesystem.Read(path: candidate_file_path(directory: directory, file_name: heal_repair_candidate_manifest_file_name as String))
              if !manifest.success {
                PublisherRunRefused { cause: concat("CandidateUnreadable: the manifest could not be read: ", manifest.error) }
              } else {
                match decode_heal_repair_candidate(text: manifest.content) {
                  CandidateUndecodable { refusal } =>
                    PublisherRunRefused { cause: refusal_line(refusal: refusal) }
                  CandidateDecoded { candidate } =>
                    if candidate_names_no_paths(c: candidate) {
                      PublisherRunNothingToPublish
                    } else if !head_ref_is_addressable(head_ref: candidate.head_ref as String) {
                      PublisherRunRefused {
                        cause: refusal_line(refusal: HeadRefNotAddressable { head_ref: candidate.head_ref as String })
                      }
                    } else {
                      observe_candidate_world_wet(
                        subject: subject,
                        directory: directory,
                        candidate: candidate,
                        run: TriggeringRunFacts {
                          workflow_path: event.workflow_path,
                          originating_event: event.originating_event,
                          conclusion: event.conclusion,
                          head_sha: event.head_sha as String,
                          head_branch: event.head_branch,
                          head_repository_full_name: event.head_repository_full_name,
                          repository_full_name: event.repository_full_name
                        }
                      )
                    }
                }
              }
            }
          }
      }
  }
}

// THE PUBLISH PATH'S REFUSAL TEXT CARRIES NO BODY AND NO CAUSE TEXT. Every caller here runs with a
// credential in hand (the App installation token on the writes and readbacks, the job token on the
// PR-state read and the receipt comment), and the text reaches stderr through exit_failure. A response
// body or a transport cause can echo request material, so only the HTTP status is kept; GitHub error
// bodies have no closed-vocabulary code to keep (compare gunbc.github_effect_perform
// publisher_refusal_text, which keeps Google's).
fn rest_refusal_text(o: RestRefusal) -> String {
  match o {
    RestStatusRefused { status, body: _ } => concat("status ", to_string(status as Int))
    RestTransportRefused { cause: _ } => "transport refused (cause withheld on a credential path)"
    RestBodyUndecodable { status, cause: _ } => join(["status ", to_string(status as Int), " undecodable (cause withheld on a credential path)"], "")
  }
}

// CREDENTIAL-FREE ADMIT OBSERVATION (heal publisher admit fix). Admit reaches NO auth-declaring
// operation, so a step that holds no publication credential can still admit. Four facts, four
// credential-free sources, no token anywhere:
//   * the run facts are the workflow_run event payload the fold already parsed (parameter `run`);
//   * the pull-request IDENTITY (number, head/base refs) is the SEALED CANDIDATE'S OWN -- credential-free
//     admit has no transport that answers number/head/base independently, so it does NOT claim to verify
//     them here; the LIVE cross-check (github.Pulls.Get number + head.ref + base.ref vs the sealed
//     candidate) runs at PUBLISH, at the credential site next to the write (see
//     classify_publish_pull_request), so a pull request retargeted after sealing fails closed;
//   * head LIVENESS is a live, credential-free `git ls-remote` of refs/pull/<n>/head against the
//     PUBLIC repository, whose sha lands in observations.branch_head_sha -- the boundary then refuses
//     with HeadMoved if it disagrees with the sealed expected_head_sha, and with
//     TriggeringRunSubjectDisagreed if the payload disagrees, so the three sources (live ref, event
//     payload, sealed candidate) must all name one head or admission fails closed. Nothing picks a
//     winner and nothing falls back to a branch tip, a peeled tag, or github.sha;
//   * the BASE TREE is one `git fetch` of that single ref into a freshly allocated, isolated object
//     store, then read with LOCAL git plumbing (read-tree + ls-files --stage) -- no network after the
//     fetch, no credential.
// "The pull request is still OPEN" is deliberately NOT observed here: it is not a ref, so no git
// transport can answer it credential-free. It is checked at PUBLISH (which holds the job token and
// sits closer to the write), before anything is written.
fn observe_candidate_world_wet(subject: HealPublicationSubject, directory: String, candidate: HealRepairCandidate, run: TriggeringRunFacts) -> PublisherRun
{
  let owner = subject.repository.owner as String
  let repo = subject.repository.name as String
  let ref_name = concat("refs/pull/", to_string(candidate.pull_number), "/head")
  let public_url = concat("https://github.com/", owner, "/", repo, ".git")
  let sealed_head = candidate.expected_head_sha as String
  // One isolated store, allocated fresh per run, holds the one fetched ref. Never a fixed path.
  let mk = shell.Mktemp.Dir()
  if !mk.success {
    return PublisherRunRefused { cause: refusal_line(refusal: ExpectedHeadUnreadable { expected: sealed_head, detail: "could not allocate the isolated fetch store" }) }
  }
  let store = mk.path
  if git.Plumbing.InitBareAt(address: GitWorktreeAt { path: store }, path: store).exit_code != 0 {
    return PublisherRunRefused { cause: refusal_line(refusal: ExpectedHeadUnreadable { expected: sealed_head, detail: "could not initialise the isolated fetch store" }) }
  }
  // LIVENESS. The live PR head, read credential-free from the public repository. An empty advertisement
  // is NOT absence of a problem: the ref is gone, so the candidate does not admit.
  let ls = git.Core.LsRemoteRefInRepo(repo: store, remote: public_url, ref_name: ref_name)
  if ls.exit_code != 0 {
    return PublisherRunRefused { cause: refusal_line(refusal: HeadRefNotAddressable { head_ref: candidate.head_ref as String }) }
  }
  let live_oid = match (match split(s: trim(s: ls.advertised), delimiter: "\t").first() { Absent => none  Present { value: wire_field } => git_object_id_from_untagged_hex(hex: wire_field) }) {
    Present { value: oid } => oid
    Absent => return PublisherRunRefused { cause: refusal_line(refusal: HeadRefNotAddressable { head_ref: candidate.head_ref as String }) }
  }
  // Fetch that one ref into the isolated store, then read its tree with LOCAL plumbing.
  let fetched = git.Core.FetchForcedRefInRepo(repo: store, remote: public_url, refspec: concat("+", ref_name, ":refs/heal-publisher/candidate-head"))
  if fetched.exit_code != 0 {
    return PublisherRunRefused { cause: refusal_line(refusal: ExpectedHeadUnreadable { expected: sealed_head, detail: concat("the candidate head could not be fetched into the isolated store: ", fetched.stderr) }) }
  }
  // Read the fetched head's full file set into a per-run index file under the isolated store. `git
  // read-tree` accepts the commit directly and stages its root tree; `git write-tree` then answers that
  // root tree's OWN object id, which is the base_tree_sha the policy names (the tree, not the commit).
  // A fetched tree is never truncated, so base_tree_truncated stays false; the boundary's truncation
  // refusal is retained as strictness kept from the old REST read, not widened by it.
  let live_hex = git_object_id_wire_hex(oid: live_oid) as String
  // The index is the bare store's OWN default index (git resolves $GIT_DIR/index == <store>/index for a
  // bare repo addressed with `-C <store>`); LsFilesStageZInRepo below reads that same default with no
  // GIT_INDEX_FILE, so read-tree, write-tree and ls-files must all name it or they see three different
  // indexes and the staged listing comes back empty.
  let index_file = concat(store as String, "/index") as FilePath
  let read_tree = git.Plumbing.ReadTreeIntoIndex(address: GitDirectoryAt { path: store, run_in: store }, index: index_file, treeish: live_hex)
  if read_tree.exit_code != 0 {
    return PublisherRunRefused { cause: refusal_line(refusal: BaseTreeUnreadable { tree_sha: live_hex, detail: concat("the candidate head tree could not be read into the index: ", read_tree.stderr) }) }
  }
  let written = git.Plumbing.WriteTreeFromIndex(address: GitDirectoryAt { path: store, run_in: store }, index: index_file)
  // A write-tree that EXITS NONZERO is refused even when its stdout would otherwise decode -- a failed
  // completion is not a tree, and decoding a parseable-but-failed stdout would let a broken index through.
  // The decision is the pure classify_write_tree_completion below, so a bounded control can prove the
  // exit-code gate discriminates on exit_code alone; the stderr is preserved into the refusal detail.
  let head_tree_hex = match classify_write_tree_completion(exit_code: written.exit_code, stdout: written.tree, stderr: written.stderr) {
    WriteTreeCompleted { tree_hex } => tree_hex as String
    WriteTreeRejected { detail } => return PublisherRunRefused { cause: refusal_line(refusal: BaseTreeUnreadable { tree_sha: live_hex, detail: detail }) }
  }
  let staged = git.Core.LsFilesStageZInRepo(repo: store)
  if !staged.success {
    return PublisherRunRefused { cause: refusal_line(refusal: BaseTreeUnreadable { tree_sha: head_tree_hex, detail: "the staged candidate file set could not be listed" }) }
  }
  // An unrenderable (non-ASCII) base path never names a candidate path (candidate paths are ASCII
  // generated-artifact paths), so it is carried as the empty string, which base_entry_for can never
  // match -- it refuses rather than matching something else, exactly as heal_candidate's own reader does.
  let base_tree = match git_decode_ls_files_stage_z(payload: utf8_encode_bytes(s: staged.raw), format: GitObjectFormatSha1) {
    GitLsFilesStageZRefused { cause: _ } =>
      return PublisherRunRefused { cause: refusal_line(refusal: BaseTreeUnreadable { tree_sha: head_tree_hex, detail: "the staged file set did not decode" }) }
    GitLsFilesStageZDecoded { entries } =>
      map(entries, e => GitTreeItemWire {
        path: match git_ascii_field_text(octets: git_path_octets(path: e.path)) { Present { value: text } => text as String  Absent => "" },
        mode: git_encode_tree_mode(mode: e.mode) as String,
        type: "blob",
        sha: git_object_id_wire_hex(oid: e.oid) as String,
        size: none
      })
  }
  let reads = map(candidate.entries, e => read_candidate_blob(directory: directory, blob_hex: git_object_id_wire_hex(oid: e.proposed_blob) as String))
  let observations = PublisherObservations {
    repository_full_name: subject.repository.full_name as NonEmptyStr,
    default_branch: subject.repository.default_branch as NonEmptyStr,
    candidate_producer_workflow_path: subject.candidate_producer_workflow_path as NonEmptyStr,
    run: run,
    branch_head_sha: git_object_id_wire_hex(oid: live_oid) as String,
    base_tree_sha: head_tree_hex,
    base_tree_truncated: false,
    base_tree: base_tree,
    proposed_blobs: map(reads, r => observed_blob_observation(r: r))
  }
  match admit_heal_publication(
    candidate: candidate,
    observations: observations,
    policy: publisher_path_policy(committed_artifact_paths: subject.committed_artifact_paths)
  ) {
    HealPublicationRefused { refusal } =>
      PublisherRunRefused { cause: refusal_line(refusal: refusal) }
    HealPublicationAdmitted { admitted } =>
      PublisherRunAdmitted { admitted: admitted, blobs: observed_blob_contents(reads: reads), pull_number: candidate.pull_number }
  }
}

// ── The credential-free gate ────────────────────────────────────────────────────────────────

fn heal_publication_admit_wet() -> ProcessExit
{
  heal_publication_admit_for(subject: public_heal_publication_subject())
}

fn heal_publication_admit_for(subject: HealPublicationSubject) -> ProcessExit
{
  match observe_and_admit_wet(subject: subject) {
    PublisherRunRefused { cause } => exit_failure(reason: cause)
    PublisherRunNothingToPublish => ExitSuccess
    PublisherRunAdmitted { admitted: _, blobs: _, pull_number: _ } => ExitSuccess
  }
}

// ── The transaction ─────────────────────────────────────────────────────────────────────────

type BlobWrites
  = BlobsWritten
  | BlobWritesRefused { refusal: PublicationWriteRefusal }

fn content_for(blobs: List<ObservedBlobContent>, blob_hex: String) -> String? {
  match (blobs |> filter(b => b.blob_hex == blob_hex) |> first) {
    Absent => none
    Present { value: b } => Present { value: b.content }
  }
}

fn write_blob_wet(subject: HealPublicationSubject, publisher_token: Secret, entry: AdmittedEntry, blobs: List<ObservedBlobContent>) -> BlobWrites
{
  let path = entry.path.value as String
  let hex = git_object_id_wire_hex(oid: entry.blob) as String
  match content_for(blobs: blobs, blob_hex: hex) {
    Absent => BlobWritesRefused { refusal: BlobWriteRefused { path: path, detail: "the admitted blob's bytes were not retained" } }
    Present { value: content } =>
      match github.GitDatabase.CreateBlob(
        auth_token: publisher_token, owner: subject.repository.owner, repo: subject.repository.name,
        content: content, encoding: git_blob_encoding_utf8
      ) {
        RestRefused { refusal } =>
          BlobWritesRefused { refusal: BlobWriteRefused { path: path, detail: rest_refusal_text(o: refusal) } }
        RestAnswered { answer: created } =>
          if created.blob.sha != hex {
            BlobWritesRefused { refusal: BlobIdentityDisagreed { path: path, admitted: hex, created: created.blob.sha } }
          } else {
            BlobsWritten
          }
      }
  }
}

fn write_blobs_wet(subject: HealPublicationSubject, publisher_token: Secret, admitted: AdmittedHealPublication, blobs: List<ObservedBlobContent>) -> BlobWrites
{
  fold(admitted.entries, init: BlobsWritten, f: fn(acc, e) {
    match acc {
      BlobWritesRefused { refusal } => BlobWritesRefused { refusal: refusal }
      BlobsWritten => write_blob_wet(subject: subject, publisher_token: publisher_token, entry: e, blobs: blobs)
    }
  })
}

fn tree_entry_input(e: AdmittedEntry) -> GitTreeEntryInput {
  GitTreeEntryInput {
    path: e.path.value as String,
    mode: git_encode_tree_mode(mode: e.mode) as String,
    type: git_tree_mode_object_type(mode: e.mode) as String,
    sha: git_object_id_wire_hex(oid: e.blob) as String
  }
}

fn refused_exit(refusal: PublicationWriteRefusal) -> ProcessExit {
  exit_failure(reason: match refusal {
    BlobWriteRefused { path, detail } => join(["BlobWriteRefused: path=", path, " ", detail], "")
    BlobIdentityDisagreed { path, admitted, created } => join(["BlobIdentityDisagreed: path=", path, " admitted=", admitted, " created=", created], "")
    TreeWriteRefused { detail } => concat("TreeWriteRefused: ", detail)
    CommitWriteRefused { detail } => concat("CommitWriteRefused: ", detail)
    CommitShapeDisagreed { detail } => concat("CommitShapeDisagreed: ", detail)
    ReferenceNotFastForward { detail } => concat("ReferenceNotFastForward: the branch moved after admission; nothing was published: ", detail)
    ReferenceWriteRefused { detail } => concat("ReferenceWriteRefused: ", detail)
  })
}

fn receipt_text(r: HealPublicationReceipt) -> String {
  join([
    "HealPublished repository=", r.repository_full_name as String,
    " branch=", r.head_ref as String,
    " parent=", r.parent as String,
    " published_head=", r.published_head as String,
    " tree=", r.tree,
    " paths=", join(r.paths, ","),
    "\n"
  ], "")
}

// THE STATUS SAYS WHETHER A 422 MEANS A MOVED BRANCH. Update a reference answers 422 for a write that
// is not a fast-forward, which after an admission against the expected head is exactly a branch that
// moved in between; any other refusal is a refusal of a different kind. A 5xx is ambiguous about
// whether the write landed, so it is not a refusal at all: the readback decides.
fn publish_admitted_wet(subject: HealPublicationSubject, publisher_token: Secret, pull_number: Int, admitted: AdmittedHealPublication, blobs: List<ObservedBlobContent>) -> ProcessExit
{
  let owner = subject.repository.owner
  let repo = subject.repository.name
  match write_blobs_wet(subject: subject, publisher_token: publisher_token, admitted: admitted, blobs: blobs) {
    BlobWritesRefused { refusal } => refused_exit(refusal: refusal)
    BlobsWritten =>
      match github.GitDatabase.CreateTree(
        auth_token: publisher_token, owner: owner, repo: repo,
        base_tree: admitted.base_tree_sha, tree: map(admitted.entries, e => tree_entry_input(e: e))
      ) {
        RestRefused { refusal } => refused_exit(refusal: TreeWriteRefused { detail: rest_refusal_text(o: refusal) })
        RestAnswered { answer: tree } =>
          match github.GitDatabase.CreateCommit(
            auth_token: publisher_token, owner: owner, repo: repo,
            message: admitted.message as String, tree: tree.created.sha, parents: [admitted.expected_head_sha as String]
          ) {
            RestRefused { refusal } => refused_exit(refusal: CommitWriteRefused { detail: rest_refusal_text(o: refusal) })
            RestAnswered { answer: commit } =>
              if commit.commit.tree.sha != tree.created.sha
                || count(commit.commit.parents) != 1
                || !any(commit.commit.parents, p => p.sha == (admitted.expected_head_sha as String)) {
                refused_exit(refusal: CommitShapeDisagreed { detail: "the created commit does not name the created tree and exactly the expected head as parent" })
              } else {
                match github.GitDatabase.UpdateRefFastForward(
                  auth_token: publisher_token, owner: owner, repo: repo,
                  ref: concat("heads/", admitted.head_ref as String), sha: commit.commit.sha
                ) {
                  RestAnswered { answer: _ } => readback_wet(subject: subject, publisher_token: publisher_token, pull_number: pull_number, admitted: admitted, created_commit: commit.commit.sha, created_tree: tree.created.sha)
                  RestRefused { refusal } => match refusal {
                    RestStatusRefused { status, body } =>
                      if (status as Int) == 422 {
                        refused_exit(refusal: ReferenceNotFastForward { detail: rest_refusal_text(o: refusal) })
                      } else if (status as Int) >= 500 {
                        readback_wet(subject: subject, publisher_token: publisher_token, pull_number: pull_number, admitted: admitted, created_commit: commit.commit.sha, created_tree: tree.created.sha)
                      } else {
                        refused_exit(refusal: ReferenceWriteRefused { detail: rest_refusal_text(o: refusal) })
                      }
                    RestTransportRefused { cause: _ } => readback_wet(subject: subject, publisher_token: publisher_token, pull_number: pull_number, admitted: admitted, created_commit: commit.commit.sha, created_tree: tree.created.sha)
                    RestBodyUndecodable { status: _, cause: _ } => readback_wet(subject: subject, publisher_token: publisher_token, pull_number: pull_number, admitted: admitted, created_commit: commit.commit.sha, created_tree: tree.created.sha)
                  }
                }
              }
          }
      }
  }
}

fn readback_wet(subject: HealPublicationSubject, publisher_token: Secret, pull_number: Int, admitted: AdmittedHealPublication, created_commit: String, created_tree: String) -> ProcessExit
{
  let owner = subject.repository.owner
  let repo = subject.repository.name
  // READBACK CREDENTIAL (heal-publisher admit fix, gunb-ai/gunbc#<this>). These four reads are CONTENTS
  // reads (git refs/commits/trees and a comparison), reachable by the installation token that ALREADY
  // performed the writes; they used to pass an EMPTY auth_token and fall through to the service auth_source
  // (GITHUB_TOKEN), which does not resolve in this publisher's wet run (that is the very defect that kept
  // admit from observing). An auth-declaring op with no resolvable token refuses closed pre-send with
  // AuthDeclaredButUnwired, so the read-back would fail AFTER the fast-forward had already moved the ref
  // - a red job with a moved head and no receipt. Pass the publisher token explicitly, the same identity
  // that owns the write, exactly as the writes above do.
  match github.GitDatabase.GetRef(auth_token: publisher_token, owner: owner, repo: repo, ref: concat("heads/", admitted.head_ref as String)) {
    RestRefused { refusal } =>
      exit_failure(reason: concat("HealPublicationUnverified: the branch could not be read back: ", rest_refusal_text(o: refusal)))
    RestAnswered { answer: branch } =>
      match github.GitDatabase.GetCommit(auth_token: publisher_token, owner: owner, repo: repo, commit_sha: branch.reference.object.sha) {
        RestRefused { refusal } =>
          exit_failure(reason: concat("HealPublicationUnverified: the branch head could not be read back: ", rest_refusal_text(o: refusal)))
        RestAnswered { answer: head } =>
          match github.GitDatabase.GetTreeRecursive(auth_token: publisher_token, owner: owner, repo: repo, tree_sha: head.commit.tree.sha) {
            RestRefused { refusal } =>
              exit_failure(reason: concat("HealPublicationUnverified: the published tree could not be read back: ", rest_refusal_text(o: refusal)))
            RestAnswered { answer: head_tree } =>
              match github.Commits.Compare(
                auth_token: publisher_token, owner: owner, repo: repo,
                basehead: join([admitted.expected_head_sha as String, "...", branch.reference.object.sha], "")
              ) {
                RestRefused { refusal } =>
                  exit_failure(reason: concat("HealPublicationUnverified: the comparison against the expected head could not be read back: ", rest_refusal_text(o: refusal)))
                RestAnswered { answer: comparison } => {
                  let changed = match comparison.comparison.files {
                    Absent => []
                    Present { value: files } => map(files, f => f.filename)
                  }
                  let truncated = match comparison.comparison.files {
                    Absent => true
                    Present { value: files } => count(files) >= comparison_files_listing_cap
                  }
                  match publication_readback_verdict(
                    admitted: admitted,
                    created_commit_sha: created_commit,
                    created_tree_sha: created_tree,
                    readback: PublicationReadback {
                      branch_head_sha: branch.reference.object.sha,
                      head_parents: map(head.commit.parents, p => p.sha),
                      head_tree_sha: head.commit.tree.sha,
                      changed_paths: changed,
                      comparison_truncated: truncated,
                      head_tree_truncated: head_tree.tree_object.truncated,
                      head_tree: head_tree.tree_object.tree
                    }
                  ) {
                    HealPublicationUnverified { detail } => exit_failure(reason: concat("HealPublicationUnverified: ", detail))
                    HealPublicationWriteRefused { refusal } => refused_exit(refusal: refusal)
                    HealPublished { receipt } => {
                      let text = receipt_text(r: receipt)
                      let w = Filesystem.Write(path: heal_publication_receipt_path, content: text)
                      if !w.success {
                        exit_failure(reason: join(["HealPublishedReceiptUnwritten: the publication landed and was read back, but ", heal_publication_receipt_path, " could not be written: ", w.error, " -- ", text], ""))
                      } else {
                        post_receipt_wet(subject: subject, pull_number: pull_number, text: text)
                      }
                    }
                  }
                }
              }
          }
      }
  }
}

// ── The credentialed entry ──────────────────────────────────────────────────────────────────

fn heal_publication_publish_wet() -> ProcessExit
{
  heal_publication_publish_for(subject: public_heal_publication_subject())
}

// THE RECEIPT NAMES EACH ARTIFACT THE BOT COMMIT CHANGED, ON THE PULL REQUEST, so a reader of the PR
// learns what the repair touched without opening a run. It is posted only after the publication was
// read back, with the job's own token (pull_requests: write; the App token is contents-only). A
// comment failure fails the job on purpose: a repair nobody was told about is the silent state this
// job exists to end.
fn post_receipt_wet(subject: HealPublicationSubject, pull_number: Int, text: String) -> ProcessExit
{
  match env_value(name: github_token_env_name) {
    Absent => exit_failure(reason: "HealReceiptUnposted: the publication landed and was read back, but the job's own token is not in the environment, so the receipt could not be commented")
    Present { value: job_token } =>
      match github.Issues.CreateComment(
        auth_token: job_token as Secret, owner: subject.repository.owner, repo: subject.repository.name,
        issue_number: pull_number, body: text
      ) {
        RestAnswered { answer: _ } => ExitSuccess
        RestRefused { refusal } =>
          exit_failure(reason: join(["HealReceiptUnposted: the publication landed and was read back, but the receipt comment was refused: ", rest_refusal_text(o: refusal), " -- ", text], ""))
      }
  }
}

data github_token_env_name: NonEmptyStr = "GITHUB_TOKEN"
data heal_publisher_wif_access_token_env_name: NonEmptyStr = "WIF_ACCESS_TOKEN"
data runner_temp_env_name: NonEmptyStr = "RUNNER_TEMP"
data heal_publisher_app_key_file_name: String = "heal-publisher-app-key"

fn heal_publication_publish_for(subject: HealPublicationSubject) -> ProcessExit
{
  match observe_and_admit_wet(subject: subject) {
    PublisherRunRefused { cause } => exit_failure(reason: cause)
    PublisherRunNothingToPublish => ExitSuccess
    PublisherRunAdmitted { admitted, blobs, pull_number } =>
      match ensure_pull_request_open_wet(subject: subject, pull_number: pull_number, expected_head_ref: admitted.head_ref as String, expected_base_ref: admitted.base_ref as String) {
        PullRequestOpenCheckRefused { reason } => exit_failure(reason: reason)
        PullRequestOpenCheckPassed =>
          match env_value(name: heal_publisher_wif_access_token_env_name) {
            Absent => exit_failure(reason: "HealPublisherFederationMissing: the workflow federation step supplied no access token")
            Present { value: wif } =>
              match env_value(name: runner_temp_env_name) {
                Absent => exit_failure(reason: "HealPublisherKeyStageMissing: RUNNER_TEMP is unset, so the App key has nowhere owner-only to stage")
                Present { value: temp } =>
                  match mint_publisher_installation_token(
                    wif_access_token: wif as Secret,
                    key_path: join([temp, "/", heal_publisher_app_key_file_name], "") as NonEmptyStr,
                    repository_name: subject.repository.name
                  ) {
                    PublisherTokenNotMinted { cause } => exit_failure(reason: cause)
                    PublisherTokenMinted { token } =>
                      publish_admitted_wet(subject: subject, publisher_token: token, pull_number: pull_number, admitted: admitted, blobs: blobs)
                  }
              }
          }
      }
  }
}

// "The pull request is still OPEN" is checked here, at publish, NOT at admit: openness is not a ref, so
// no git transport can answer it credential-free, and admit must hold no credential. Publish already
// holds the job's own token (the same GITHUB_TOKEN post_receipt_wet comments with, whose pull-requests
// permission the emitter grants) and sits immediately before the write, so the time-of-check gap is
// smaller than it would be at admit. The read is the EXISTING github.Pulls interface with the job token
// passed explicitly as auth_token (no second, no-auth GitHub service -- DESIGN 3 forbids the meaning
// fork). A closed pull request, or a state that cannot be read at all, refuses with a typed cause
// BEFORE the App installation token is minted and before any blob, tree, commit or ref write. A
// candidate for a closed PR never reaches mint_publisher_installation_token.
type PullRequestOpenCheck = PullRequestOpenCheckPassed | PullRequestOpenCheckRefused { reason: String }

// The pull request exactly as the publish step OBSERVES it from the LIVE github.Pulls.Get read (made under
// the job token), held separate from the decision so every arm is checkable hermetically on supplied values.
type PublishPullRequestState =
    PublishPrObserved { number: Int, head_ref: String, base_ref: String, open: Bool }
  | PublishPrStateUnreadable { detail: String }
  | PublishPrCredentialAbsent

// THE DECISION, pure and offline-testable. Fail-closed first: an absent credential or an unreadable state
// refuses, because a publish that cannot READ the pull request must not write. Then the identity cross-check
// the credential-free admit cannot perform: the LIVE pull request must be the very one the sealed candidate
// describes (its number, its head ref, and its BASE ref), or a different or retargeted pull request would be
// fast-forwarded onto the wrong branch. Then the OPEN check. Any failure refuses BEFORE the App token is
// minted and before any write.
fn classify_publish_pull_request(obs: PublishPullRequestState, pull_number: Int, expected_head_ref: String, expected_base_ref: String) -> PullRequestOpenCheck {
  match obs {
    PublishPrCredentialAbsent =>
      PullRequestOpenCheckRefused { reason: "HealPublishPreconditionUnmet: the publish step's own token is absent, so the pull request cannot be verified; refusing to publish" }
    PublishPrStateUnreadable { detail } =>
      PullRequestOpenCheckRefused { reason: join(["HealPublishPreconditionUnmet: the pull request could not be read; refusing to publish: ", detail], "") }
    PublishPrObserved { number, head_ref, base_ref, open } =>
      if number != pull_number {
        PullRequestOpenCheckRefused { reason: refusal_line(refusal: PullRequestNumberDisagreed { candidate: pull_number, observed: number }) }
      } else if head_ref != expected_head_ref {
        PullRequestOpenCheckRefused { reason: refusal_line(refusal: PullRequestHeadRefDisagreed { candidate: expected_head_ref, observed: head_ref }) }
      } else if base_ref != expected_base_ref {
        PullRequestOpenCheckRefused { reason: refusal_line(refusal: PullRequestBaseRefDisagreed { candidate: expected_base_ref, observed: base_ref }) }
      } else if !open {
        PullRequestOpenCheckRefused { reason: refusal_line(refusal: PullRequestNotOpen { pull_number: pull_number }) }
      } else {
        PullRequestOpenCheckPassed
      }
  }
}

fn ensure_pull_request_open_wet(subject: HealPublicationSubject, pull_number: Int, expected_head_ref: String, expected_base_ref: String) -> PullRequestOpenCheck {
  let obs = match env_value(name: github_token_env_name) {
    Absent => PublishPrCredentialAbsent
    Present { value: job_token } =>
      match github.Pulls.Get(auth_token: job_token as Secret, owner: subject.repository.owner, repo: subject.repository.name, pull_number: pull_number) {
        RestRefused { refusal } => PublishPrStateUnreadable { detail: rest_refusal_text(o: refusal) }
        RestAnswered { answer: pr } =>
          PublishPrObserved { number: pr.pr.number, head_ref: pr.pr.head.ref as String, base_ref: pr.pr.base.ref as String, open: match pr.pr.state { Open => true  Closed => false } }
      }
  }
  classify_publish_pull_request(obs: obs, pull_number: pull_number, expected_head_ref: expected_head_ref, expected_base_ref: expected_base_ref)
}

// THE WRITE-TREE COMPLETION, pure and offline-testable. git.Plumbing.WriteTreeFromIndex can exit nonzero while
// still printing something that LOOKS like an object id (a partial write, a lock race). Decoding that stdout as a
// tree would let a broken index through the fence, so the completion is decided on exit_code FIRST: a nonzero exit
// is refused regardless of stdout, and the stderr is carried into the refusal. Only a zero exit whose stdout decodes
// to a git object id yields a tree. Splitting this out lets a bounded control prove the gate discriminates on
// exit_code alone, with the identical parseable stdout on both sides (deleting the check cannot leave the suite green).
type WriteTreeCompletion = WriteTreeCompleted { tree_hex: String } | WriteTreeRejected { detail: String }

fn classify_write_tree_completion(exit_code: Int, stdout: String, stderr: String) -> WriteTreeCompletion {
  if exit_code != 0 {
    WriteTreeRejected { detail: concat("git write-tree exited nonzero: ", trim(s: stderr)) }
  } else {
    match git_object_id_from_untagged_hex(hex: trim(s: stdout)) {
      Present { value: oid } => WriteTreeCompleted { tree_hex: git_object_id_wire_hex(oid: oid) as String }
      Absent => WriteTreeRejected { detail: "git write-tree exited 0 but printed no decodable object id" }
    }
  }
}
