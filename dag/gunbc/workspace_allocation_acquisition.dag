module gunbc.workspace_allocation_acquisition

import std.types { NonEmptyStr, Timestamp }
import std.decl_ref { decl_ref }
import gunbc.clock_read { clock_now_probed_at }
import gunbc.auth.approval_capability { utc_instant_is_canonical, utc_instant_before }
import gunbc.fabric_storage_client { FabricStorageBinding }
import gunbc.principal_projection { PrincipalRef }
import gunbc.workspace_acquisition_invocation { workspace_acquisition_actor_admits, workspace_cancel_unelected_actor, workspace_establish_actor_protocol }
import gunbc.workspace_allocation_plan { workspace_reservation_apply, workspace_reservation_recover, WorkspaceReservationObserved, WorkspaceReservationApplyRefused }
import gunbc.workspace_allocation_store {
  WorkspaceAllocation, WorkspaceStoreWrite, WorkspaceStoreWritten, WorkspaceStoreWriteRefused,
  WorkspaceStoreReadOk, WorkspaceStoreUnreadable, WorkspaceReleased, WorkspaceWanted,
  WorkspaceRetired, WorkspaceTerminationRequested, WorkspaceAcquiring, WorkspaceRecorded,
  workspace_read_owner, workspace_write_allocation, workspace_commit_owner_transition,
  workspace_record_reservation, workspace_settle_unstarted_retirement, workspace_retired_at,
}

// The plan apply authority admits this caller only. Every acquisition therefore follows a read
// of the committed plan, and retirement switches to read-only recovery of a possibly acquired
// hold. The fleet convergence lease still serializes host apply and teardown effects.
fn workspace_apply_recorded_plan(store: FabricStorageBinding, fabric_root: NonEmptyStr, owner: PrincipalRef, idempotency_key: NonEmptyStr, observed_at: Timestamp) -> WorkspaceStoreWrite {
  match clock_now_probed_at() {
    Absent => WorkspaceStoreWriteRefused { reason: "actual clock is unreadable before reservation acquisition" }
    Present { value: actual_now } => match workspace_begin_acquisition(store: store, owner: owner, idempotency_key: idempotency_key, now: actual_now) {
    WorkspaceStoreWritten { allocation: ready } => if (ready.phase == WorkspaceReleased) { WorkspaceStoreWritten { allocation: ready } }
    else if (ready.desired == WorkspaceRetired && ready.phase == WorkspaceTerminationRequested && (match ready.reservation { Absent => true Present { value: _ } => false })) {
      workspace_settle_unstarted_retirement(store: store, owner: owner, idempotency_key: idempotency_key, observed_at: actual_now)
    } else { match ready.plan {
      Absent => WorkspaceStoreWriteRefused { reason: "allocation has no durably recorded reservation plan" }
      Present { value: prepared } => {
        let applied = match ready.desired {
          WorkspaceRetired => workspace_reservation_recover(root: fabric_root, plan: prepared)
          WorkspaceWanted => if workspace_acquisition_actor_admits(store: store, plan: prepared) {
            workspace_reservation_apply(root: fabric_root, plan: prepared)
          } else { workspace_reservation_recover(root: fabric_root, plan: prepared) }
        }
        match applied {
          WorkspaceReservationObserved { reservation: held } => workspace_record_reservation(store: store, reservation: held, observed_at: actual_now)
          WorkspaceReservationApplyRefused { reason: detail } => if (ready.desired == WorkspaceRetired && ready.phase == WorkspaceAcquiring) {
            workspace_settle_unelected_retirement(store: store, owner: owner, idempotency_key: idempotency_key, observed_at: actual_now)
          } else { WorkspaceStoreWriteRefused { reason: detail as String } }
        }
      }
    } }
    other => other
  }
  }
}

// Winning this owner CAS establishes a durable acquisition obligation before any local hold CAS.
// Retirement preserves Acquiring, so a stale reader cannot erase an acquisition in progress.
fn workspace_begin_acquisition(store: FabricStorageBinding, owner: PrincipalRef, idempotency_key: NonEmptyStr, now: Timestamp) -> WorkspaceStoreWrite
  admit_callers: [decl_ref(module_path: "gunbc.workspace_allocation_acquisition", decl_name: "workspace_apply_recorded_plan")]
{
  match workspace_read_owner(store: store, owner: owner) {
    WorkspaceStoreUnreadable { reason: detail } => WorkspaceStoreWriteRefused { reason: detail }
    WorkspaceStoreReadOk { snapshot: observed } => match filter(observed.allocations, a => a.request.idempotency_key == idempotency_key).first() {
      Absent => WorkspaceStoreWriteRefused { reason: "allocation request is absent" }
      Present { value: allocation } => if (allocation.phase == WorkspaceReleased) { WorkspaceStoreWritten { allocation: allocation } }
      else if !utc_instant_is_canonical(t: now) || !utc_instant_is_canonical(t: allocation.request.expires_at) {
        WorkspaceStoreWriteRefused { reason: "reservation acquisition requires canonical clock and absolute expiry" }
      } else if (allocation.desired == WorkspaceWanted && !utc_instant_before(a: now, b: allocation.request.expires_at)) {
        workspace_write_allocation(store: store, snapshot: observed, allocation: workspace_retired_at(allocation: allocation, reason: "Lease expired before acquisition; cleanup obligation retained", observed_at: now))
      } else if (allocation.desired == WorkspaceRetired && allocation.phase != WorkspaceAcquiring) {
        match allocation.reservation {
          Present { value: _ } => WorkspaceStoreWritten { allocation: allocation }
          Absent => WorkspaceStoreWriteRefused { reason: "retired allocation never acquired an acquisition obligation" }
        }
      } else { match allocation.plan {
        Absent => WorkspaceStoreWriteRefused { reason: "allocation has no recorded plan" }
        Present { value: acquisition_plan } => if (allocation.phase == WorkspaceAcquiring) { WorkspaceStoreWritten { allocation: allocation } }
        else { match allocation.reservation {
          Present { value: _ } => WorkspaceStoreWritten { allocation: allocation }
          Absent => if (allocation.desired != WorkspaceWanted || allocation.phase != WorkspaceRecorded) {
            WorkspaceStoreWriteRefused { reason: "allocation cannot begin acquisition from its current state" }
          } else if !workspace_establish_actor_protocol(store: store, plan: acquisition_plan) {
            WorkspaceStoreWriteRefused { reason: "acquisition protocol publication refused before owner transition" }
          } else { workspace_write_allocation(store: store, snapshot: observed, allocation: WorkspaceAllocation { retired_at: allocation.retired_at, recorded_at: allocation.recorded_at,
            desired: allocation.desired, request: allocation.request, plan: allocation.plan, reservation: none,
            phase: WorkspaceAcquiring, connection: "", observed_at: allocation.observed_at, reason: "Reservation acquisition in progress",
          }) }
        } }
      } }
    }
  }
}


// This is the only alternate owner transition: cancellation wins the immutable actor slot first.
// Owner CAS still consumes the exact retired row; failure leaves the tombstone for retry.
fn workspace_settle_unelected_retirement(store: FabricStorageBinding, owner: PrincipalRef, idempotency_key: NonEmptyStr, observed_at: Timestamp) -> WorkspaceStoreWrite {
  match workspace_read_owner(store: store, owner: owner) {
    WorkspaceStoreUnreadable { reason: detail } => WorkspaceStoreWriteRefused { reason: detail }
    WorkspaceStoreReadOk { snapshot: observed } => match filter(observed.allocations, a => a.request.idempotency_key == idempotency_key).first() {
      Absent => WorkspaceStoreWriteRefused { reason: "allocation request is absent" }
      Present { value: allocation } => if allocation.desired != WorkspaceRetired || allocation.phase != WorkspaceAcquiring {
        WorkspaceStoreWriteRefused { reason: "only a retired acquisition can cancel its unelected actor" }
      } else { match allocation.reservation {
        Present { value: _ } => WorkspaceStoreWriteRefused { reason: "reservation requires actual sanitation" }
        Absent => match allocation.plan {
          Absent => WorkspaceStoreWriteRefused { reason: "acquisition plan is unreadable" }
          Present { value: prepared } => if !workspace_cancel_unelected_actor(store: store, plan: prepared) {
            WorkspaceStoreWriteRefused { reason: "acquisition actor exists or is unreadable; queued hold effects remain an obligation" }
          } else { workspace_commit_owner_transition(store: store, snapshot: observed, allocation: WorkspaceAllocation {
            recorded_at: allocation.recorded_at, retired_at: allocation.retired_at,
            desired: WorkspaceRetired, request: allocation.request, plan: allocation.plan, reservation: none,
            phase: WorkspaceReleased, connection: "", observed_at: observed_at,
            reason: "Retired before any acquisition actor was elected; immutable cancellation fences late actor election",
          }) }
        }
      } }
    }
  }
}
