module gunbc.workspace_allocation_acquisition

import std.types { NonEmptyStr, Timestamp }
import std.decl_ref { decl_ref }
import gunbc.clock_read { clock_now_probed_at }
import gunbc.auth.approval_capability { utc_instant_is_canonical, utc_instant_before }
import gunbc.fabric.fabric_storage_client { FabricStorageBinding }
import gunbc.fabric.fabric_allocation_store { FabricAllocationStore }
import gunbc.principal_projection { PrincipalRef }
import gunbc.workspace_acquisition_invocation {
  workspace_acquisition_actor_admits, workspace_cancel_unelected_actor, workspace_establish_actor_protocol,
  workspace_recorded_actor, RecordedActorAbsent, RecordedActorInvocation, RecordedActorCancelled, RecordedActorLegacyBareId, RecordedActorUnreadable,
  UnitInvocationObservation, workspace_slot_invocation_reading, workspace_prior_actor_standing,
  WorkspacePriorActorStanding, PriorActorUnobservable,
  workspace_rearm_actor, workspace_cancel_elected_actor, workspace_current_acquisition_invocation, workspace_acquisition_store }
import gunbc.systemd_unit_invocation_liveness { unit_run_wire }
import std.durable_compare_and_set { CasGeneration }
import gunbc.workspace_reservation_record { WorkspaceReservationPlan }
import gunbc.workspace_allocation { WorkspaceReservation }
import gunbc.workspace_allocation_plan {
  workspace_reservation_apply, workspace_reservation_recover, WorkspaceReservationObserved, WorkspaceReservationApplyRefused,
  WorkspaceActorIntent, ActorIntentAcquire, ActorIntentRetire, workspace_actor_takeover_decision, workspace_reservation_hold_observation,
  TakeoverRecoverHeld, TakeoverRearmActor, TakeoverCancelActor, TakeoverRetain,
}
import gunbc.workspace_allocation_store {
  WorkspaceAllocation, WorkspaceStoreWrite, WorkspaceStoreWritten, WorkspaceStoreWriteRefused,
  WorkspaceStoreReadOk, WorkspaceStoreUnreadable, WorkspaceReleased, WorkspaceWanted,
  WorkspaceRetired, WorkspaceTerminationRequested, WorkspaceAcquiring, WorkspaceRecorded,
  workspace_read_owner, workspace_write_allocation, workspace_commit_owner_transition,
  workspace_record_reservation, workspace_settle_unstarted_retirement, workspace_retired_at, workspace_allocation_store }

// The plan apply authority admits this caller only. Every acquisition therefore follows a read
// of the committed plan, and retirement switches to read-only recovery of a possibly acquired
// hold. The fleet convergence lease still serializes host apply and teardown effects.
fn workspace_apply_recorded_plan(store: FabricStorageBinding, cells: FabricAllocationStore, owner: PrincipalRef, idempotency_key: NonEmptyStr, observed_at: Timestamp) -> WorkspaceStoreWrite {
  match clock_now_probed_at() {
    Absent => WorkspaceStoreWriteRefused { reason: "actual clock is unreadable before reservation acquisition" }
    Present { value: actual_now } => match workspace_begin_acquisition(store: store, owner: owner, idempotency_key: idempotency_key, now: actual_now) {
    WorkspaceStoreWritten { allocation: ready } => if (ready.phase == WorkspaceReleased) { WorkspaceStoreWritten { allocation: ready } }
    else if (ready.desired == WorkspaceRetired && ready.phase == WorkspaceTerminationRequested && (match ready.reservation { Absent => true Present { value: _ } => false })) {
      workspace_settle_unstarted_retirement(store: workspace_allocation_store(binding: store), owner: owner, idempotency_key: idempotency_key, observed_at: actual_now)
    } else { match ready.plan {
      Absent => WorkspaceStoreWriteRefused { reason: "allocation has no durably recorded reservation plan" }
      Present { value: prepared } => {
        let applied = match ready.desired {
          WorkspaceRetired => workspace_reservation_recover(cells: cells, plan: prepared)
          WorkspaceWanted => if workspace_acquisition_actor_admits(store: workspace_acquisition_store(binding: store), plan: prepared) {
            workspace_reservation_apply(cells: cells, plan: prepared)
          } else { match workspace_take_over_actor(store: store, cells: cells, plan: prepared, intent: ActorIntentAcquire, slot: workspace_slot_invocation_reading(plan: prepared)) {
            TakeoverRecovered { reservation: held } => WorkspaceReservationObserved { reservation: held }
            TakeoverRearmed => workspace_reservation_apply(cells: cells, plan: prepared)
            TakeoverCancelled => WorkspaceReservationApplyRefused { reason: "acquisition actor was cancelled; a wanted request cannot reacquire through it" }
            TakeoverRefused { reason } => WorkspaceReservationApplyRefused { reason: reason }
          } }
        }
        match applied {
          WorkspaceReservationObserved { reservation: held } => workspace_record_reservation(store: workspace_allocation_store(binding: store), reservation: held, observed_at: actual_now)
          WorkspaceReservationApplyRefused { reason: detail } => if (ready.desired == WorkspaceRetired && ready.phase == WorkspaceAcquiring) {
            workspace_settle_unelected_retirement(store: store, cells: cells, owner: owner, idempotency_key: idempotency_key, observed_at: actual_now, slot: workspace_slot_invocation_reading(plan: prepared))
          } else { WorkspaceStoreWriteRefused { reason: detail as String } }
        }
      }
    } }
    other => other
  }
  }
}

// Winning this owner CAS establishes a durable acquisition obligation before any local hold CAS.
// Retirement preserves Acquiring, so a stale reader cannot erase an acquisition in progress.
fn workspace_begin_acquisition(store: FabricStorageBinding, owner: PrincipalRef, idempotency_key: NonEmptyStr, now: Timestamp) -> WorkspaceStoreWrite
  admit_callers: [decl_ref(module_path: "gunbc.workspace_allocation_acquisition", decl_name: "workspace_apply_recorded_plan")]
{
  match workspace_read_owner(store: workspace_allocation_store(binding: store), owner: owner) {
    WorkspaceStoreUnreadable { reason: detail } => WorkspaceStoreWriteRefused { reason: detail }
    WorkspaceStoreReadOk { snapshot: observed } => match filter(observed.allocations, a => a.request.idempotency_key == idempotency_key).first() {
      Absent => WorkspaceStoreWriteRefused { reason: "allocation request is absent" }
      Present { value: allocation } => if (allocation.phase == WorkspaceReleased) { WorkspaceStoreWritten { allocation: allocation } }
      else if !utc_instant_is_canonical(t: now) || !utc_instant_is_canonical(t: allocation.request.expires_at) {
        WorkspaceStoreWriteRefused { reason: "reservation acquisition requires canonical clock and absolute expiry" }
      } else if (allocation.desired == WorkspaceWanted && !utc_instant_before(a: now, b: allocation.request.expires_at)) {
        workspace_write_allocation(store: workspace_allocation_store(binding: store), snapshot: observed, allocation: workspace_retired_at(allocation: allocation, reason: "Lease expired before acquisition; cleanup obligation retained", observed_at: now))
      } else if (allocation.desired == WorkspaceRetired && allocation.phase != WorkspaceAcquiring) {
        match allocation.reservation {
          Present { value: _ } => WorkspaceStoreWritten { allocation: allocation }
          Absent => WorkspaceStoreWriteRefused { reason: "retired allocation never acquired an acquisition obligation" }
        }
      } else { match allocation.plan {
        Absent => WorkspaceStoreWriteRefused { reason: "allocation has no recorded plan" }
        Present { value: acquisition_plan } => if (allocation.phase == WorkspaceAcquiring) { WorkspaceStoreWritten { allocation: allocation } }
        else { match allocation.reservation {
          Present { value: _ } => WorkspaceStoreWritten { allocation: allocation }
          Absent => if (allocation.desired != WorkspaceWanted || allocation.phase != WorkspaceRecorded) {
            WorkspaceStoreWriteRefused { reason: "allocation cannot begin acquisition from its current state" }
          } else if !workspace_establish_actor_protocol(store: workspace_acquisition_store(binding: store), plan: acquisition_plan) {
            WorkspaceStoreWriteRefused { reason: "acquisition protocol publication refused before owner transition" }
          } else { workspace_write_allocation(store: workspace_allocation_store(binding: store), snapshot: observed, allocation: WorkspaceAllocation { retired_at: allocation.retired_at, recorded_at: allocation.recorded_at,
            desired: allocation.desired, request: allocation.request, plan: allocation.plan, reservation: none,
            phase: WorkspaceAcquiring, connection: "", observed_at: allocation.observed_at, reason: "Reservation acquisition in progress",
          }) }
        } }
      } }
    }
  }
}


// This is the only alternate owner transition: cancellation wins the immutable actor slot first.
// Owner CAS still consumes the exact retired row; failure leaves the tombstone for retry.
fn workspace_settle_unelected_retirement(store: FabricStorageBinding, cells: FabricAllocationStore, owner: PrincipalRef, idempotency_key: NonEmptyStr, observed_at: Timestamp, slot: UnitInvocationObservation) -> WorkspaceStoreWrite {
  match workspace_read_owner(store: workspace_allocation_store(binding: store), owner: owner) {
    WorkspaceStoreUnreadable { reason: detail } => WorkspaceStoreWriteRefused { reason: detail }
    WorkspaceStoreReadOk { snapshot: observed } => match filter(observed.allocations, a => a.request.idempotency_key == idempotency_key).first() {
      Absent => WorkspaceStoreWriteRefused { reason: "allocation request is absent" }
      Present { value: allocation } => if allocation.desired != WorkspaceRetired || allocation.phase != WorkspaceAcquiring {
        WorkspaceStoreWriteRefused { reason: "only a retired acquisition can cancel its unelected actor" }
      } else { match allocation.reservation {
        Present { value: _ } => WorkspaceStoreWriteRefused { reason: "reservation requires actual sanitation" }
        Absent => match allocation.plan {
          Absent => WorkspaceStoreWriteRefused { reason: "acquisition plan is unreadable" }
          Present { value: prepared } => if !(workspace_cancel_unelected_actor(store: workspace_acquisition_store(binding: store), plan: prepared) || workspace_retirement_took_over_actor(store: store, cells: cells, plan: prepared, slot: slot)) {
            WorkspaceStoreWriteRefused { reason: "acquisition actor is live, unreadable or holds the slot; queued hold effects remain an obligation" }
          } else { workspace_commit_owner_transition(store: workspace_allocation_store(binding: store), snapshot: observed, allocation: WorkspaceAllocation {
            recorded_at: allocation.recorded_at, retired_at: allocation.retired_at,
            desired: WorkspaceRetired, request: allocation.request, plan: allocation.plan, reservation: none,
            phase: WorkspaceReleased, connection: "", observed_at: observed_at,
            reason: "Retired with no live acquisition actor and no hold; the cancellation tombstone fences any late actor",
          }) }
        }
      } }
    }
  }
}

// ELECTED-ACTOR TAKEOVER. Read the recorded actor, then whether its invocation has ended, then the
// slot's hold -- in that order -- and act on the pure decision. Every effect is a CAS from the
// exact recorded actor generation, so concurrent replacements cannot both proceed to a hold CAS.
type WorkspaceActorTakeoverOutcome
  = TakeoverRecovered { reservation: WorkspaceReservation }
  | TakeoverRearmed
  | TakeoverCancelled
  | TakeoverRefused { reason: NonEmptyStr }

fn workspace_take_over_actor(store: FabricStorageBinding, cells: FabricAllocationStore, plan: WorkspaceReservationPlan, intent: WorkspaceActorIntent, slot: UnitInvocationObservation) -> WorkspaceActorTakeoverOutcome {
  if cells.root != plan.root { TakeoverRefused { reason: "prepared plan names another allocation store" } }
  else { match workspace_recorded_actor(store: workspace_acquisition_store(binding: store), plan: plan) {
    RecordedActorAbsent => TakeoverRefused { reason: "no acquisition actor was elected for this plan" }
    RecordedActorCancelled { generation: _ } => match intent {
      ActorIntentRetire => TakeoverCancelled
      ActorIntentAcquire => TakeoverRefused { reason: "acquisition actor was cancelled" }
    }
    RecordedActorUnreadable { reason } => TakeoverRefused { reason: reason }
    RecordedActorInvocation { generation, run } => workspace_take_over_recorded(store: store, cells: cells, plan: plan, intent: intent, generation: generation, prior: workspace_prior_actor_standing(recorded: run, slot: slot), prior_wire: unit_run_wire(run: run) as NonEmptyStr)
    RecordedActorLegacyBareId { generation, invocation_id } => workspace_take_over_recorded(store: store, cells: cells, plan: plan, intent: intent, generation: generation, prior: PriorActorUnobservable { reason: "the acquisition actor record is a pre-carrier bare InvocationID; its unit run cannot be observed" }, prior_wire: invocation_id as String as NonEmptyStr)
  } }
}

// Retired intent is the operator's release (workspace_request_release_at records desired=Retired): an
// UNOBSERVABLE holder (any cause) is then admitted for cancellation, while a LIVE one never is.
fn workspace_take_over_recorded(store: FabricStorageBinding, cells: FabricAllocationStore, plan: WorkspaceReservationPlan, intent: WorkspaceActorIntent, generation: CasGeneration, prior: WorkspacePriorActorStanding, prior_wire: NonEmptyStr) -> WorkspaceActorTakeoverOutcome {
  let hold = workspace_reservation_hold_observation(cells: cells, plan: plan)
  match workspace_actor_takeover_decision(plan: plan, hold: hold, prior: prior, intent: intent) {
    TakeoverRecoverHeld { reservation } => TakeoverRecovered { reservation: reservation }
    TakeoverRetain { reason } => TakeoverRefused { reason: reason }
    TakeoverCancelActor => if workspace_cancel_elected_actor(store: workspace_acquisition_store(binding: store), plan: plan, generation: generation, prior_wire: prior_wire) { TakeoverCancelled }
      else { TakeoverRefused { reason: "another reader replaced the terminal actor first" } }
    TakeoverRearmActor => match workspace_current_acquisition_invocation(plan: plan) {
      Absent => TakeoverRefused { reason: "this controller cannot attest its own invocation" }
      Present { value: current } => if workspace_rearm_actor(store: workspace_acquisition_store(binding: store), plan: plan, generation: generation, invocation: current) { TakeoverRearmed }
        else { TakeoverRefused { reason: "another reader replaced the terminal actor first" } }
    }
  }
}

fn workspace_retirement_took_over_actor(store: FabricStorageBinding, cells: FabricAllocationStore, plan: WorkspaceReservationPlan, slot: UnitInvocationObservation) -> Bool {
  match workspace_take_over_actor(store: store, cells: cells, plan: plan, intent: ActorIntentRetire, slot: slot) {
    TakeoverCancelled => true
    TakeoverRecovered { reservation: _ } => false
    TakeoverRearmed => false
    TakeoverRefused { reason: _ } => false
  }
}
