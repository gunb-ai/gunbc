module gunbc.runner_service_activation

import std.types { String, NonEmptyStr, Bool, Int, List, list_length }
import std.disposition { Disposition, SingleAuthority }
import gunbc.executor_privileged_operation {
  ExecutorPrivilegedOperation,
  SystemdEnableUnit,
  SystemdStartUnit,
  executor_privileged_operation_shell_command,
}
import gunbc.runner_host_deploy {
  RunnerHostDeploy, RunnerHostAdmission, RunnerHostEnrolled, RunnerHostUnenrolled,
  fleet_runner_host_deploys,
}
import gunbc.runner_activation {
  BuildCacheInstanceReady, HostCompilePoolReady,
  RunnerActivationAdmission, RunnerActivationAdmitted, RunnerActivationRefused,
  admit_runner_activation,
}
import gunbc.runner_slot_provision { desired_runner_slot_members }
import gunbc.guarantee_rung_drop {
  GuaranteeStall,
  OutsideTheLadder, StructurallyGuaranteed,
  AwaitsOneGrounding,
  BoundedPopulation,
  stall_report_message,
}
import gunbc.runner_lifecycle { runner_unit_name_for_instance }

data runner_service_activation_scope_disposition: Disposition = SingleAuthority

data activation_is_two_transitions_note: String = "ENABLE AND START ARE TWO TRANSITIONS AND THIS MODULE IS THE PLACE THEY STAY TWO. The emitted apply.sh carried daemon-reload and disable and nothing else: enable count zero, start count zero, so convergence materialized runner trees and the host's serving capacity did not move. Every capacity increase of 2026-08-25 -- srv1, srv3 and srv4 each 5 to 21 -- was finished by a hand-run `systemctl enable --now` loop after apply reported success, which is manual application committed to nothing.\\n\\nTHE HAND LOOP IS NOT THE SPECIFICATION FOR THE REPAIR, and re-emitting what it did would re-fuse the two facts it fused. `enable` is DURABLE BOOT INTENT: it authorizes a future boot to start the broker under readiness conditions that nobody will re-observe at that boot, which makes it the STRONGER of the two grants rather than the milder-sounding one. `start` is IMMEDIATE ACTIVITY under conditions observable right now. They are separately admitted here, separately granted in gunbc.executor_privileged_operation, and separately rendered, so `enable --now` has no spelling on this path -- not by convention, but because no sudoers line derived from either operation matches the fused argv.\\n\\nBOTH CONSUME THE SAME ACTIVATION ADMISSION, which is gunbc.runner_activation's wall and not a second one. That wall exists because letting a slot accept work is what lets its first cache-miss compile spawn a build-cache server inside the runner's own cgroup, and materializing a slot cannot."

data readiness_unobserved_is_not_readiness_absent_note: String = "THE OBSERVATION ARRIVES AS A PARAMETER AND HAS ITS OWN UNAVAILABLE ARM, rather than being manufactured here. A planner that built its own BuildCacheInstanceReady would be fabricating the observation the receipt exists to carry -- the forgeable-receipt residual gunbc.runner_activation's own note names, committed deliberately instead of inherited. So this module never constructs a receipt; it consumes one or it consumes the reason none was available.\\n\\nWHY THE UNAVAILABLE ARM IS NOT FOLDED INTO A REFUSED ADMISSION AT THE CALLER: `no observation transaction exists to ask` and `the observation answered and disagreed` have different owners and different repairs, and the second is a host fact while the first is a gap in this repository. Collapsing them would make a missing seam read as a converged host failing a check. The arm carries its reason, the admission it produces carries that reason forward, and the emitted script prints it -- so a reader of apply.sh learns which of the two they are looking at.\\n\\nIT ALSO MAKES THE RED AUTHORABLE, which is the property that decides whether the witness below is evidence or decoration (DESIGN section 4b). If this module answered `unobserved` from a constant, no fixture could ever reach the admitted arm, the emitted-activation assertion would be permanently red, and its green counterpart would be unwritable. With the observation as an input, a fixture authors both poles."

type RunnerServiceTransition
  = RunnerEnableTransition
  | RunnerStartTransition

type RunnerActivationReadiness
  = ActivationReadinessObserved {
      cache_ready: BuildCacheInstanceReady
      pool_ready: HostCompilePoolReady
    }
  | ActivationReadinessUnobserved { reason: NonEmptyStr }

type RunnerTransitionPlan
  = TransitionAdmitted {
      transition: RunnerServiceTransition
      operations: List<ExecutorPrivilegedOperation>
    }
  | TransitionRefused {
      transition: RunnerServiceTransition
      host_label: NonEmptyStr
      reason: NonEmptyStr
    }

fn runner_transition_verb_label(transition: RunnerServiceTransition) -> String {
  match transition {
    RunnerEnableTransition => "enable"
    RunnerStartTransition => "start"
  }
}

// THE TRANSITION'S OWN STAKE, SPELLED PER MEMBER, because a shared refusal sentence would make the
// two transitions look like one operation reported twice. What a reader needs from a refusal is what
// they are being denied, and the two denials are not the same denial.
fn runner_transition_stake(transition: RunnerServiceTransition) -> String {
  match transition {
    RunnerEnableTransition =>
      "enable is durable boot intent: it authorizes every FUTURE boot to start this unit under readiness conditions nobody re-observes at that boot, so it is the stronger of the two grants and is withheld first"
    RunnerStartTransition =>
      "start is immediate activity: it lets this unit accept work now, and the first cache-miss compile of that work is what spawns a build-cache server in whichever cgroup the slot sits in"
  }
}

fn runner_transition_operation(
  transition: RunnerServiceTransition,
  unit: NonEmptyStr,
) -> ExecutorPrivilegedOperation {
  match transition {
    RunnerEnableTransition => SystemdEnableUnit { unit: unit }
    RunnerStartTransition => SystemdStartUnit { unit: unit }
  }
}

// THE UNITS ARE THE DESIRED SLOT MEMBERS, NOT THE COMMITTED WIDTH. desired_runner_slot_members
// already removes the fabric execution slot from the roster, and reaching for the raw index
// sequence here would activate a GitHub Actions unit on top of a slot this fleet carved out for
// compute fabric -- gunbc.runner_slot_provision records that exact defect as one it already fixed
// once, and re-deriving the roster locally would reintroduce it in a second place.
fn runner_host_activation_units(deploy: RunnerHostDeploy) -> List<NonEmptyStr> {
  map(
    desired_runner_slot_members(deploy: deploy),
    m => runner_unit_name_for_instance(instance_name: m.instance_name as String),
  )
}

fn runner_activation_admission_from_readiness(
  host_admission: RunnerHostAdmission,
  readiness: RunnerActivationReadiness,
) -> RunnerActivationAdmission {
  match readiness {
    ActivationReadinessObserved { cache_ready: c, pool_ready: p } =>
      admit_runner_activation(host_admission: host_admission, cache_ready: c, pool_ready: p)
    ActivationReadinessUnobserved { reason: why } =>
      match host_admission {
        RunnerHostEnrolled { deploy: d } =>
          RunnerActivationRefused {
            host_label: d.host_label,
            reason: concat(
              "runner_service_activation: no activation-readiness observation was available for this host, so neither transition can be admitted. This is an unread question, not a failed check -- ",
              why as String,
            ) as NonEmptyStr,
          }
        RunnerHostUnenrolled { host_label: l, reason: r } =>
          RunnerActivationRefused { host_label: l, reason: r }
      }
  }
}

// EACH TRANSITION IS ADMITTED ON ITS OWN CALL. The admission value is shared -- there is one wall,
// and inventing a second for start would be a nickname for it -- but the ADMISSION EVENT is per
// transition, so a future policy that grants durable boot intent while withholding immediate
// activity (or the reverse, which is what a drain does) has a place to sit that is not a rewrite.
// A single function returning both plans at once would have foreclosed that by construction.
fn admit_runner_transition(
  transition: RunnerServiceTransition,
  admission: RunnerActivationAdmission,
  units: List<NonEmptyStr>,
) -> RunnerTransitionPlan {
  match admission {
    RunnerActivationAdmitted { deploy: _, cache_ready: _, pool_ready: _ } =>
      TransitionAdmitted {
        transition: transition,
        operations: map(units, u => runner_transition_operation(transition: transition, unit: u)),
      }
    RunnerActivationRefused { host_label: l, reason: r } =>
      TransitionRefused {
        transition: transition,
        host_label: l,
        reason: concat(
          concat(
            concat("systemctl ", runner_transition_verb_label(transition: transition)),
            " is not admitted on this host: ",
          ),
          concat(concat(r as String, " -- "), runner_transition_stake(transition: transition)),
        ) as NonEmptyStr,
      }
  }
}

// ENABLE PRECEDES START, AND THE ORDER IS THE ONE THE TRANSITIONS THEMSELVES IMPLY rather than a
// preference: a unit started before it is enabled serves until the next boot and then silently
// stops being capacity, which is the state this whole lane was dispatched to remove. The list is
// the emission order.
fn runner_host_transition_plans(
  host_admission: RunnerHostAdmission,
  readiness: RunnerActivationReadiness,
  units: List<NonEmptyStr>,
) -> List<RunnerTransitionPlan> {
  let admission = runner_activation_admission_from_readiness(
    host_admission: host_admission,
    readiness: readiness,
  )
  [
    admit_runner_transition(transition: RunnerEnableTransition, admission: admission, units: units),
    admit_runner_transition(transition: RunnerStartTransition, admission: admission, units: units),
  ]
}

fn runner_activation_plans_for_deploy(
  host_admission: RunnerHostAdmission,
  deploy: RunnerHostDeploy,
  readiness: RunnerActivationReadiness,
) -> List<RunnerTransitionPlan> {
  runner_host_transition_plans(
    host_admission: host_admission,
    readiness: readiness,
    units: runner_host_activation_units(deploy: deploy),
  )
}

// A REFUSED TRANSITION EMITS A REFUSAL LINE AND THE SIBLINGS CONTINUE. It does NOT exit, and that
// is the deliberate half of the shape rather than the lenient half. Materialization is authorized
// independently of activation -- writing a slot's files cannot spawn a cache server -- so aborting
// apply on an activation refusal would withdraw an authorized effect because an unrelated one was
// denied. What must never happen is the third arm: emitting nothing, which is what the script did
// before this module existed and is indistinguishable from a host with no activation work. The
// refusal is typed, located on the host, carries its cause, and is counted by the row below.
fn runner_transition_apply_lines(plan: RunnerTransitionPlan) -> List<String> {
  match plan {
    TransitionAdmitted { transition: _, operations: ops } =>
      map(ops, op => executor_privileged_operation_shell_command(op: op))
    TransitionRefused { transition: _, host_label: l, reason: r } =>
      [
        concat(
          concat("echo 'fleet_converge_apply: REFUSED-ACTIVATION host=", l as String),
          concat(concat(" ", r as String), "' >&2"),
        ),
      ]
  }
}

fn runner_transition_plan_line(plan: RunnerTransitionPlan) -> String {
  match plan {
    TransitionAdmitted { transition: t, operations: ops } =>
      concat(
        concat("ACTIVATE runner-service ", runner_transition_verb_label(transition: t)),
        concat(" units=", to_string(list_length(items: ops))),
      )
    TransitionRefused { transition: t, host_label: l, reason: r } =>
      concat(
        concat("REFUSED-ACTIVATION runner-service ", runner_transition_verb_label(transition: t)),
        concat(concat(" host=", l as String), concat(" ", r as String)),
      )
  }
}

// THE ONE SPELLING OF "NOBODY CAN ASK THIS YET". Every production caller in the tree supplies this
// row rather than authoring its own sentence, because the reason is a fact about the REPOSITORY --
// there is no host observation transaction -- and not about the caller that noticed. Two callers
// with two wordings would drift the moment the transaction lands for one of them, and the drift
// would be invisible: both would still say "unobserved".
//
// IT IS DATA AND NOT A FUNCTION, so the day the transaction exists this row's deletion is what
// breaks every caller that was leaning on it, one by one, loudly (DESIGN section 3, delete-first).
data runner_activation_readiness_unobserved_no_transaction: RunnerActivationReadiness = ActivationReadinessUnobserved {
  reason: "no host observation transaction exists yet: fleet convergence observes directory membership, the generation store and the hostname, and nothing reads the build-cache endpoint owner or the compile-pool slice, so neither receipt gunbc.runner_activation requires can be produced (docs/plans/runner-service-capacity-convergence.md, the shared blocker)" as NonEmptyStr,
}

// THE EMISSION ORDER, READABLE AS A VALUE. A consumer that wanted to assert enable-before-start had
// to destructure the plan list positionally, which reads the ORDER out of the shape of the list
// rather than out of the transitions themselves. This renders the sequence the transitions name.
fn runner_transition_plan_transition(plan: RunnerTransitionPlan) -> RunnerServiceTransition {
  match plan {
    TransitionAdmitted { transition: t, operations: _ } => t
    TransitionRefused { transition: t, host_label: _, reason: _ } => t
  }
}

fn runner_transition_sequence_label(plans: List<RunnerTransitionPlan>) -> String {
  fold(
    plans,
    init: "",
    f: (acc, p) => {
      let v = runner_transition_verb_label(transition: runner_transition_plan_transition(plan: p))
      if acc == "" { v } else { concat(acc, concat(",", v)) }
    },
  )
}

fn runner_transition_is_refused(plan: RunnerTransitionPlan) -> Bool {
  match plan {
    TransitionAdmitted { transition: _, operations: _ } => false
    TransitionRefused { transition: _, host_label: _, reason: _ } => true
  }
}

fn runner_activation_refusal_count(plans: List<RunnerTransitionPlan>) -> Int {
  fold(plans, init: 0, f: (acc, p) => if runner_transition_is_refused(plan: p) { acc + 1 } else { acc })
}

fn runner_activation_admitted_operation_count(plans: List<RunnerTransitionPlan>) -> Int {
  fold(
    plans,
    init: 0,
    f: (acc, p) =>
      match p {
        TransitionAdmitted { transition: _, operations: ops } => acc + list_length(items: ops)
        TransitionRefused { transition: _, host_label: _, reason: _ } => acc
      },
  )
}

// THE ADMISSION HAS NO REACHABLE GREEN ON ANY HOST TODAY, AND THAT IS A TYPED ROW RATHER THAN A
// SENTENCE IN A PR BODY. Without it the next reader sees enable-count-0 replaced by refuse-count-N
// and cannot tell a PERMANENT STRUCTURAL refusal from a transient one -- which is the mirror of
// DESIGN section 4b's unauthorable-RED question, pointed the other way: a gate whose only reachable
// state is refusal is not a decoration, it is the laundering shape the Building-&-checks fixed-point
// entry records, where a gate's only closing move does not exist. The difference between that
// failure and this row is only that this one says so.
//
// THE SINGLE REASON, NAMED: admit_runner_activation requires a HostCompilePoolReady, and its one
// producer -- gunbc.host_compile_pool derive_host_compile_pool_ready -- answers
// PoolNotDeclaredInTopology for every host because gunbc.fleet_host_budget's
// gunbc_compile_pool_placement is CompilePoolInRunnerSlots. That module's own note already states
// this and calls it the correct answer rather than a gap, so nothing here is being worked around.
//
// WHY A STALL AND NOT A RUNG DROP, because the distinction decides whether this row is honest. A
// GuaranteeRungDrop asserts that a guarantee FELL, and nothing fell: before this module the emitted
// script had no activation transition at all and the hand-run `systemctl enable --now` loop that
// supplied one was ungated, so the class was off the ladder already. What this lane adds is a
// constructor that cannot activate without an admission, plus the honest report that the admission
// never greens yet. That is section 4b(2)'s untracked-stall clause exactly -- a class below its
// ceiling naming what it waits on -- and filing it as a drop would manufacture a regression to make
// a declaration fit a shape.
//
// THE POPULATION IS BOUNDED AND ENUMERATED rather than UncountedNotEnumerable, because it genuinely
// is: gunbc.runner_host_deploys fleet_runner_host_deploys is the closed roster, every member of it
// refuses, and a host outside it refuses one wall earlier on enrollment.
data runner_activation_reachable_green_stall: GuaranteeStall = GuaranteeStall {
  subject: "gunbc.runner_service_activation runner_activation_admission_from_readiness -- both service transitions refuse on every enrolled host",
  current: OutsideTheLadder,
  ceiling: StructurallyGuaranteed,
  blocker: AwaitsOneGrounding {
    grounding: "gunbc.fleet_host_budget gunbc_compile_pool_placement is CompilePoolInRunnerSlots, so gunbc.host_compile_pool derive_host_compile_pool_ready answers PoolNotDeclaredInTopology fleet-wide and no HostCompilePoolReady receipt can be produced for any host",
  },
  population: BoundedPopulation {
    members: map(fleet_runner_host_deploys, d => d.host_label as String),
  },
  next_rung_trigger: "gunbc_compile_pool_placement declares a managed compile-pool slice, in the same motion that shrinks runner_pool so the host allocation still conserves; at that point derive_host_compile_pool_ready can answer ready, the admission has a reachable green, and this row's current rung is the wall's own rung rather than off-ladder",
}

fn runner_activation_stall_report() -> String {
  stall_report_message(s: runner_activation_reachable_green_stall)
}
