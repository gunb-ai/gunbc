module gunbc.srv4_seeded_install_media_artifact


data srv4_autoinstall_user_data_body: std.types.NonEmptyStr = autoinstall_user_data(
  payload: srv4_ubuntu_autoinstall_on_iso,
) as std.types.NonEmptyStr

data srv4_seeded_nocloud_dir_on_iso: std.types.NonEmptyStr = ubuntu_seeded_install_media_default_nocloud_dir(
  hostname: srv4_ubuntu_autoinstall_on_iso.identity.hostname,
)

data srv4_seeded_grub_kernel_cmdline: std.types.NonEmptyStr = ubuntu_seeded_install_media_grub_kernel_cmdline(
  nocloud_dir: srv4_seeded_nocloud_dir_on_iso,
)

data srv4_seeded_install_media_content_hash: std.content_hash.ContentHash = seeded_install_media_content_hash(
  stock_content_sha256: noble_numbat_2404_3_live_server_arm64.content_sha256 as std.types.NonEmptyStr,
  autoinstall_user_data_body: srv4_autoinstall_user_data_body,
  grub_kernel_cmdline: srv4_seeded_grub_kernel_cmdline,
  nocloud_dir_on_iso: srv4_seeded_nocloud_dir_on_iso,
)

data srv4_seeded_install_media_artifact: extdeps.provisioning.ubuntu_seeded_install_media.UbuntuSeededInstallMediaArtifactRow = extdeps.provisioning.ubuntu_seeded_install_media.UbuntuSeededInstallMediaArtifactRow {
  stock_artifact: noble_numbat_2404_3_live_server_arm64,
  autoinstall: srv4_ubuntu_autoinstall_on_iso,
  autoinstall_user_data_body: srv4_autoinstall_user_data_body,
  grub_kernel_cmdline: srv4_seeded_grub_kernel_cmdline,
  nocloud_dir_on_iso: srv4_seeded_nocloud_dir_on_iso,
  content_hash: srv4_seeded_install_media_content_hash,
}

data srv4_seeded_ubuntu_install_media_install_path: std.types.NonEmptyStr = ubuntu_seeded_install_media_install_path(
  artifact: srv4_seeded_install_media_artifact,
)
