module gunbc.namespace_reference_derived_closure_contract

import std.occurrence_identity { OccurrenceId }
import std.types { Bool, FilePath, Int, List, String }

data namespace_reference_derived_closure_contract_note: String = "THE CLOSING CONDITION for roadmap node namespace-reference-derived-closure, transcribed at the node's own six-clause grain. Each clause is a closed capability and is established only by assessing the corresponding typed production observation: an earlier same-file neighbour is visible; a sibling decision branch is excluded; a later declaration is excluded; two distinct same-spelled declaration identities both survive for the canonical ambiguity fold; repeated mentions project one provider-file dependency; and an unrelated loaded file never enters that projection. Missing and refused evidence are the same derived frontier, duplicate admissions cannot erase a missing capability, and zero progress is red.\n\nThis module deliberately does NOT derive visibility or dependencies. namespace_reference_derived_closure_acceptance_admissions is empty until the gated node supplies observations obtained by EXECUTING its production candidate producer and dependency projection. The fixture witnesses may construct observations to prove this fold discriminates, but the quarantined closing witness consumes only that production-admission function; copying fixture observations into it would be specification-without-execution and would not satisfy the contract."

data namespace_reference_derived_closure_contract_dissolution_note: String = "DISSOLVES BY GREENING, never deletion. The implementation adds production-derived observations to namespace_reference_derived_closure_acceptance_admissions as each clause becomes executable. When all six establish, the unchanged closing witness greens; its QuarantineProbeExpectRed exclusion and known-red roster entry delete in the same change, promoting it to the ordinary discovery corpus as the permanent regression wall."

type ReferenceDerivedClosureCapability
  = SameFileEarlierNeighbourVisible
  | SiblingDecisionBranchExcluded
  | LaterDeclarationExcluded
  | DistinctSameSpelledDeclarationsPreserved
  | RepeatedMentionsCollapseDependency
  | UnrelatedLoadedFileExcluded

type ReferenceDerivedClosureObservation
  = SameFileNeighbourObservation {
      neighbour: OccurrenceId,
      visible_candidates: List<OccurrenceId>,
    }
  | SiblingBranchObservation {
      own_branch_declaration: OccurrenceId,
      sibling_branch_declaration: OccurrenceId,
      visible_candidates: List<OccurrenceId>,
    }
  | LaterDeclarationObservation {
      later_declaration: OccurrenceId,
      visible_candidates: List<OccurrenceId>,
    }
  | DistinctHomonymObservation {
      first_declaration: OccurrenceId,
      second_declaration: OccurrenceId,
      visible_candidates: List<OccurrenceId>,
    }
  | RepeatedMentionDependencyObservation {
      provider_file: FilePath,
      projected_dependencies: List<FilePath>,
    }
  | UnrelatedLoadedFileObservation {
      provider_file: FilePath,
      unrelated_loaded_file: FilePath,
      projected_dependencies: List<FilePath>,
    }

type ReferenceDerivedClosureScenarioFailure
  = SameFileNeighbourMissing
  | SiblingBranchLeaked
  | LaterDeclarationLeaked
  | DistinctDeclarationCollapsed
  | RepeatedMentionDuplicatedDependency
  | UnrelatedLoadedFileDependencyLeaked

type ReferenceDerivedClosureAcceptanceReceipt sole_constructor {
  capability: ReferenceDerivedClosureCapability
}

type ReferenceDerivedClosureAdmission
  = ReferenceDerivedClosureEstablished {
      receipt: ReferenceDerivedClosureAcceptanceReceipt,
    }
  | ReferenceDerivedClosureRefused {
      capability: ReferenceDerivedClosureCapability,
      failure: ReferenceDerivedClosureScenarioFailure,
    }

fn occurrence_present(xs: List<OccurrenceId>, wanted: OccurrenceId) -> Bool {
  xs |> any(x => x.value == wanted.value)
}

fn file_present(xs: List<FilePath>, wanted: FilePath) -> Bool {
  xs |> any(x => (x as String) == (wanted as String))
}

fn established(capability: ReferenceDerivedClosureCapability) -> ReferenceDerivedClosureAdmission {
  ReferenceDerivedClosureEstablished {
    receipt: ReferenceDerivedClosureAcceptanceReceipt { capability: capability },
  }
}

fn refused(
  capability: ReferenceDerivedClosureCapability,
  failure: ReferenceDerivedClosureScenarioFailure,
) -> ReferenceDerivedClosureAdmission {
  ReferenceDerivedClosureRefused { capability: capability, failure: failure }
}

fn assess_reference_derived_closure_observation(
  observation: ReferenceDerivedClosureObservation,
) -> ReferenceDerivedClosureAdmission {
  match observation {
    SameFileNeighbourObservation { neighbour, visible_candidates } =>
      if count(visible_candidates) == 1
        && occurrence_present(xs: visible_candidates, wanted: neighbour) {
        established(capability: SameFileEarlierNeighbourVisible)
      } else {
        refused(capability: SameFileEarlierNeighbourVisible, failure: SameFileNeighbourMissing)
      }
    SiblingBranchObservation {
      own_branch_declaration,
      sibling_branch_declaration,
      visible_candidates,
    } =>
      if count(visible_candidates) == 1
        && occurrence_present(xs: visible_candidates, wanted: own_branch_declaration)
        && !occurrence_present(xs: visible_candidates, wanted: sibling_branch_declaration) {
        established(capability: SiblingDecisionBranchExcluded)
      } else {
        refused(capability: SiblingDecisionBranchExcluded, failure: SiblingBranchLeaked)
      }
    LaterDeclarationObservation { later_declaration, visible_candidates } =>
      if !occurrence_present(xs: visible_candidates, wanted: later_declaration) {
        established(capability: LaterDeclarationExcluded)
      } else {
        refused(capability: LaterDeclarationExcluded, failure: LaterDeclarationLeaked)
      }
    DistinctHomonymObservation {
      first_declaration,
      second_declaration,
      visible_candidates,
    } =>
      if first_declaration.value != second_declaration.value
        && count(visible_candidates) == 2
        && occurrence_present(xs: visible_candidates, wanted: first_declaration)
        && occurrence_present(xs: visible_candidates, wanted: second_declaration) {
        established(capability: DistinctSameSpelledDeclarationsPreserved)
      } else {
        refused(capability: DistinctSameSpelledDeclarationsPreserved, failure: DistinctDeclarationCollapsed)
      }
    RepeatedMentionDependencyObservation { provider_file, projected_dependencies } =>
      if count(projected_dependencies) == 1
        && file_present(xs: projected_dependencies, wanted: provider_file) {
        established(capability: RepeatedMentionsCollapseDependency)
      } else {
        refused(capability: RepeatedMentionsCollapseDependency, failure: RepeatedMentionDuplicatedDependency)
      }
    UnrelatedLoadedFileObservation {
      provider_file,
      unrelated_loaded_file,
      projected_dependencies,
    } =>
      if count(projected_dependencies) == 1
        && file_present(xs: projected_dependencies, wanted: provider_file)
        && !file_present(xs: projected_dependencies, wanted: unrelated_loaded_file) {
        established(capability: UnrelatedLoadedFileExcluded)
      } else {
        refused(capability: UnrelatedLoadedFileExcluded, failure: UnrelatedLoadedFileDependencyLeaked)
      }
  }
}

fn reference_derived_closure_required_capabilities() -> List<ReferenceDerivedClosureCapability> {
  [
    SameFileEarlierNeighbourVisible,
    SiblingDecisionBranchExcluded,
    LaterDeclarationExcluded,
    DistinctSameSpelledDeclarationsPreserved,
    RepeatedMentionsCollapseDependency,
    UnrelatedLoadedFileExcluded,
  ]
}

fn reference_derived_closure_missing_capabilities(
  admissions: List<ReferenceDerivedClosureAdmission>,
) -> List<ReferenceDerivedClosureCapability> {
  reference_derived_closure_required_capabilities()
    |> filter(required => !(admissions |> any(admission => match admission {
      ReferenceDerivedClosureEstablished { receipt } => receipt.capability == required
      ReferenceDerivedClosureRefused { capability: _, failure: _ } => false
    })))
}

fn reference_derived_closure_closing_frontier_count(
  admissions: List<ReferenceDerivedClosureAdmission>,
) -> Int {
  count(reference_derived_closure_missing_capabilities(admissions: admissions))
}

fn reference_derived_closure_closing_contract_holds(
  admissions: List<ReferenceDerivedClosureAdmission>,
) -> Bool {
  reference_derived_closure_closing_frontier_count(admissions: admissions) == 0
}

fn namespace_reference_derived_closure_acceptance_admissions() -> List<ReferenceDerivedClosureAdmission> {
  []
}
