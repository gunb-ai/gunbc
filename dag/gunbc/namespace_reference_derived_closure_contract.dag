module gunbc.namespace_reference_derived_closure_contract

import gunbc.namespace_reference_derived_closure_admission {
  ReferenceDerivedClosureAdmission,
  ReferenceDerivedClosureCapability,
  ReferenceDerivedClosureEstablished,
  ReferenceDerivedClosureRefused,
  ReferenceDerivedClosureUnavailable,
  RepeatedMentionsCollapseDependency,
  UnrelatedLoadedFileExcluded,
  SameFileEarlierNeighbourVisible,
  SiblingDecisionBranchExcluded,
  LaterDeclarationExcluded,
  DistinctSameSpelledDeclarationsPreserved,
}
import std.types { Bool, Int, List, String }

data namespace_reference_derived_closure_contract_note: String = "THE CLOSING CONDITION for roadmap node namespace-reference-derived-closure, transcribed at the node's own six-clause grain. Each clause is a closed capability and is established only by assessing the corresponding typed production observation: an earlier same-file neighbour is visible; a sibling decision branch is excluded; a later declaration is excluded; two distinct same-spelled declaration identities both survive for the canonical ambiguity fold; repeated mentions project one provider-file dependency; and an unrelated loaded file never enters that projection. The first four observations carry the result of the MERGED P1 resolve_reference_occurrence_binding kernel, so the check cannot substitute a second none/one/many decision. Missing, refused, and explicitly unavailable evidence all remain in the derived frontier; duplicate admissions cannot erase a missing capability, and zero progress is red.\n\nThis module deliberately does NOT derive visibility or dependencies and does NOT import v1.* — witness_layer_roots is dag plus src/v2 only, so a dag/gunbc import of src/v1 would break ordinary discovery and quarantine resolve. Each lane owns ONE per-clause supplier function; the six-row admissions list is composed inline at the acceptance witness seam (test.claim.namespace_reference_derived_closure_acceptance), which imports both this contract and the v1 production observers. The fixture witnesses in test.claim.namespace_reference_derived_closure_contract_test prove this fold discriminates."

data namespace_reference_derived_closure_contract_dissolution_note: String = "DISSOLVES BY GREENING, never deletion. As each clause's supplier establishes by execution, the acceptance witness replaces that row's literal Unavailable with the real admission. When all six establish, the unchanged closing witness greens; its QuarantineProbeExpectRed exclusion and known-red roster entry delete in the same change, promoting it to the ordinary discovery corpus as the permanent regression wall."

fn reference_derived_closure_required_capabilities() -> List<ReferenceDerivedClosureCapability> {
  [
    SameFileEarlierNeighbourVisible,
    SiblingDecisionBranchExcluded,
    LaterDeclarationExcluded,
    DistinctSameSpelledDeclarationsPreserved,
    RepeatedMentionsCollapseDependency,
    UnrelatedLoadedFileExcluded,
  ]
}

fn reference_derived_closure_missing_capabilities(
  admissions: List<ReferenceDerivedClosureAdmission>,
) -> List<ReferenceDerivedClosureCapability> {
  reference_derived_closure_required_capabilities()
    |> filter(required =>
      !(admissions |> any(admission => match admission {
        ReferenceDerivedClosureEstablished { receipt } => receipt.capability == required
        ReferenceDerivedClosureRefused { capability: _, failure: _ } => false
        ReferenceDerivedClosureUnavailable { capability: _, trigger: _ } => false
      }))
        || admissions |> any(admission => match admission {
          ReferenceDerivedClosureEstablished { receipt: _ } => false
          ReferenceDerivedClosureRefused { capability, failure: _ } => capability == required
          ReferenceDerivedClosureUnavailable { capability, trigger: _ } => capability == required
        })
    )
}

fn reference_derived_closure_closing_frontier_count(
  admissions: List<ReferenceDerivedClosureAdmission>,
) -> Int {
  count(reference_derived_closure_missing_capabilities(admissions: admissions))
}

fn reference_derived_closure_closing_contract_holds(
  admissions: List<ReferenceDerivedClosureAdmission>,
) -> Bool {
  reference_derived_closure_closing_frontier_count(admissions: admissions) == 0
}
