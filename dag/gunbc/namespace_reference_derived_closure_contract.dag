module gunbc.namespace_reference_derived_closure_contract


data namespace_reference_derived_closure_contract_note: String = "THE CLOSING CONDITION for roadmap node namespace-reference-derived-closure, transcribed at the node's own six-clause grain. Each clause is a closed capability and is established only by assessing the corresponding typed production observation: an earlier same-file neighbour is visible; a sibling decision branch is excluded; a later declaration is excluded; two distinct same-spelled declaration identities both survive for the canonical ambiguity fold; repeated mentions project one provider-file dependency; and an unrelated loaded file never enters that projection. The first four observations carry the result of the MERGED P1 resolve_reference_occurrence_binding kernel, so the check cannot substitute a second none/one/many decision. Missing, refused, and explicitly unavailable evidence all remain in the derived frontier; duplicate admissions cannot erase a missing capability, and zero progress is red.\n\nThis module deliberately does NOT derive visibility or dependencies. namespace_reference_derived_closure_acceptance_admissions carries six typed unavailable rows today: structural visibility/order/ambiguity wait on the P2a candidate producer in #7515, dependency dedupe waits on its binding projection, and pool-independent closure waits on that projection's Class-B wall. The fixture witnesses construct observations to prove this fold discriminates, but the quarantined closing witness consumes only the production-admission function; copying fixture observations into it would be specification-without-execution and would not satisfy the contract."

data namespace_reference_derived_closure_contract_dissolution_note: String = "DISSOLVES BY GREENING, never deletion. The implementation adds production-derived observations to namespace_reference_derived_closure_acceptance_admissions as each clause becomes executable. When all six establish, the unchanged closing witness greens; its QuarantineProbeExpectRed exclusion and known-red roster entry delete in the same change, promoting it to the ordinary discovery corpus as the permanent regression wall."

fn reference_derived_closure_required_capabilities() -> List<gunbc.namespace_reference_derived_closure_admission.ReferenceDerivedClosureCapability> {
  [
    gunbc.namespace_reference_derived_closure_admission.SameFileEarlierNeighbourVisible,
    gunbc.namespace_reference_derived_closure_admission.SiblingDecisionBranchExcluded,
    gunbc.namespace_reference_derived_closure_admission.LaterDeclarationExcluded,
    gunbc.namespace_reference_derived_closure_admission.DistinctSameSpelledDeclarationsPreserved,
    gunbc.namespace_reference_derived_closure_admission.RepeatedMentionsCollapseDependency,
    gunbc.namespace_reference_derived_closure_admission.UnrelatedLoadedFileExcluded,
  ]
}

fn reference_derived_closure_missing_capabilities(
  admissions: List<gunbc.namespace_reference_derived_closure_admission.ReferenceDerivedClosureAdmission>,
) -> List<gunbc.namespace_reference_derived_closure_admission.ReferenceDerivedClosureCapability> {
  reference_derived_closure_required_capabilities()
    |> filter(required =>
      !(admissions |> any(admission => match admission {
        gunbc.namespace_reference_derived_closure_admission.ReferenceDerivedClosureEstablished { receipt } => receipt.capability == required
        gunbc.namespace_reference_derived_closure_admission.ReferenceDerivedClosureRefused { capability: _, failure: _ } => false
        gunbc.namespace_reference_derived_closure_admission.ReferenceDerivedClosureUnavailable { capability: _, trigger: _ } => false
      }))
        || admissions |> any(admission => match admission {
          gunbc.namespace_reference_derived_closure_admission.ReferenceDerivedClosureEstablished { receipt: _ } => false
          gunbc.namespace_reference_derived_closure_admission.ReferenceDerivedClosureRefused { capability, failure: _ } => capability == required
          gunbc.namespace_reference_derived_closure_admission.ReferenceDerivedClosureUnavailable { capability, trigger: _ } => capability == required
        })
    )
}

fn reference_derived_closure_closing_frontier_count(
  admissions: List<gunbc.namespace_reference_derived_closure_admission.ReferenceDerivedClosureAdmission>,
) -> Int {
  count(reference_derived_closure_missing_capabilities(admissions: admissions))
}

fn reference_derived_closure_closing_contract_holds(
  admissions: List<gunbc.namespace_reference_derived_closure_admission.ReferenceDerivedClosureAdmission>,
) -> Bool {
  reference_derived_closure_closing_frontier_count(admissions: admissions) == 0
}

fn namespace_reference_derived_closure_acceptance_admissions() -> List<gunbc.namespace_reference_derived_closure_admission.ReferenceDerivedClosureAdmission> {
  [
    gunbc.namespace_reference_derived_closure_admission.ReferenceDerivedClosureUnavailable {
      capability: gunbc.namespace_reference_derived_closure_admission.SameFileEarlierNeighbourVisible,
      trigger: gunbc.namespace_reference_derived_closure_admission.P2aStructuralCandidateProducer7515,
    },
    gunbc.namespace_reference_derived_closure_admission.ReferenceDerivedClosureUnavailable {
      capability: gunbc.namespace_reference_derived_closure_admission.SiblingDecisionBranchExcluded,
      trigger: gunbc.namespace_reference_derived_closure_admission.P2aStructuralCandidateProducer7515,
    },
    gunbc.namespace_reference_derived_closure_admission.ReferenceDerivedClosureUnavailable {
      capability: gunbc.namespace_reference_derived_closure_admission.LaterDeclarationExcluded,
      trigger: gunbc.namespace_reference_derived_closure_admission.P2aStructuralCandidateProducer7515,
    },
    gunbc.namespace_reference_derived_closure_admission.ReferenceDerivedClosureUnavailable {
      capability: gunbc.namespace_reference_derived_closure_admission.DistinctSameSpelledDeclarationsPreserved,
      trigger: gunbc.namespace_reference_derived_closure_admission.P2aStructuralCandidateProducer7515,
    },
    gunbc.namespace_reference_derived_closure_admission.ReferenceDerivedClosureUnavailable {
      capability: gunbc.namespace_reference_derived_closure_admission.RepeatedMentionsCollapseDependency,
      trigger: gunbc.namespace_reference_derived_closure_admission.P2aReferenceDependencyProjection7515,
    },
    gunbc.namespace_reference_derived_closure_admission.ReferenceDerivedClosureUnavailable {
      capability: gunbc.namespace_reference_derived_closure_admission.UnrelatedLoadedFileExcluded,
      trigger: gunbc.namespace_reference_derived_closure_admission.P2aPoolIndependentDependencyProjection7515,
    },
  ]
}
