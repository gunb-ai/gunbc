module gunbc.namespace_reference_derived_closure_contract

import gunbc.namespace_reference_derived_closure_admission {
  ReferenceDerivedClosureAdmission,
  ReferenceDerivedClosureCapability,
  ReferenceDerivedClosureEstablished,
  ReferenceDerivedClosureRefused,
  ReferenceDerivedClosureUnavailable,
  RepeatedMentionsCollapseDependency,
  UnrelatedLoadedFileExcluded,
  SameFileEarlierNeighbourVisible,
  SiblingDecisionBranchExcluded,
  LaterDeclarationExcluded,
  DistinctSameSpelledDeclarationsPreserved,
  P2aReferenceDependencyProjection7515,
  P2aPoolIndependentDependencyProjection7515,
}
import std.types { Bool, Int, List, String }
import v1.gunbc.namespace_reference_derived_closure_production_admissions {
  observe_same_file_earlier_neighbour_visible,
  observe_sibling_decision_branch_excluded,
  observe_later_declaration_excluded,
  observe_distinct_same_spelled_declarations_preserved,
}

data namespace_reference_derived_closure_contract_note: String = "THE CLOSING CONDITION for roadmap node namespace-reference-derived-closure, transcribed at the node's own six-clause grain. Each clause is a closed capability and is established only by assessing the corresponding typed production observation: an earlier same-file neighbour is visible; a sibling decision branch is excluded; a later declaration is excluded; two distinct same-spelled declaration identities both survive for the canonical ambiguity fold; repeated mentions project one provider-file dependency; and an unrelated loaded file never enters that projection. The first four observations carry the result of the MERGED P1 resolve_reference_occurrence_binding kernel, so the check cannot substitute a second none/one/many decision. Missing, refused, and explicitly unavailable evidence all remain in the derived frontier; duplicate admissions cannot erase a missing capability, and zero progress is red.\n\nThis module deliberately does NOT derive visibility or dependencies. namespace_reference_derived_closure_acceptance_admissions is the sole production admission seam owned here; v1.gunbc.namespace_reference_derived_closure_production_admissions exposes per-clause observe_* production paths that wire into it as each clause lands. The fixture witnesses in test.claim.namespace_reference_derived_closure_contract_test prove this fold discriminates; the quarantined closing witness consumes only namespace_reference_derived_closure_acceptance_admissions — copying fixture observations into it would be specification-without-execution."

data namespace_reference_derived_closure_contract_dissolution_note: String = "DISSOLVES BY GREENING, never deletion. Production-derived observations are added to namespace_reference_derived_closure_acceptance_admissions as each clause becomes executable. When all six establish, the unchanged closing witness greens; its QuarantineProbeExpectRed exclusion and known-red roster entry delete in the same change, promoting it to the ordinary discovery corpus as the permanent regression wall."

fn reference_derived_closure_required_capabilities() -> List<ReferenceDerivedClosureCapability> {
  [
    SameFileEarlierNeighbourVisible,
    SiblingDecisionBranchExcluded,
    LaterDeclarationExcluded,
    DistinctSameSpelledDeclarationsPreserved,
    RepeatedMentionsCollapseDependency,
    UnrelatedLoadedFileExcluded,
  ]
}

fn reference_derived_closure_missing_capabilities(
  admissions: List<ReferenceDerivedClosureAdmission>,
) -> List<ReferenceDerivedClosureCapability> {
  reference_derived_closure_required_capabilities()
    |> filter(required =>
      !(admissions |> any(admission => match admission {
        ReferenceDerivedClosureEstablished { receipt } => receipt.capability == required
        ReferenceDerivedClosureRefused { capability: _, failure: _ } => false
        ReferenceDerivedClosureUnavailable { capability: _, trigger: _ } => false
      }))
        || admissions |> any(admission => match admission {
          ReferenceDerivedClosureEstablished { receipt: _ } => false
          ReferenceDerivedClosureRefused { capability, failure: _ } => capability == required
          ReferenceDerivedClosureUnavailable { capability, trigger: _ } => capability == required
        })
    )
}

fn reference_derived_closure_closing_frontier_count(
  admissions: List<ReferenceDerivedClosureAdmission>,
) -> Int {
  count(reference_derived_closure_missing_capabilities(admissions: admissions))
}

fn reference_derived_closure_closing_contract_holds(
  admissions: List<ReferenceDerivedClosureAdmission>,
) -> Bool {
  reference_derived_closure_closing_frontier_count(admissions: admissions) == 0
}

fn namespace_reference_derived_closure_acceptance_admissions() -> List<ReferenceDerivedClosureAdmission> {
  [
    observe_same_file_earlier_neighbour_visible(),
    observe_sibling_decision_branch_excluded(),
    observe_later_declaration_excluded(),
    observe_distinct_same_spelled_declarations_preserved(),
    ReferenceDerivedClosureUnavailable {
      capability: RepeatedMentionsCollapseDependency,
      trigger: P2aReferenceDependencyProjection7515,
    },
    ReferenceDerivedClosureUnavailable {
      capability: UnrelatedLoadedFileExcluded,
      trigger: P2aPoolIndependentDependencyProjection7515,
    },
  ]
}
