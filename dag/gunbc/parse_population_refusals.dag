fn parse_population_declared_refusal_classes() -> List<RefusalClass> {
  [
    RefusalClass {
      drop: "population_parse_service_requires_transport_members",
      cause: "parse_g0_tokens_remain",
      keys: requires_transport_members_keys()
    }
  ]
}
