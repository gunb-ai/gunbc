module gunbc.parse_population_refusals

import std.types { List, String }

// THE POPULATION PARSE'S DECLARED REFUSALS (rung drops, DESIGN section 4b(3)). `gunbc test //gunbc/instruments:v2-native-cli` walks
// `parse-population` over the live trees; this module is the exact set of modules that verb is permitted to refuse, by module file
// key (`<tree>:<path>`) and parse cause, one class per standing drop and cause the verb reports; a module is in exactly one class.
// The rule is two-sided: a module outside the list that fails to parse (or fails for another cause) is red, and a listed module that
// parses is red, so a list can only shrink; a listed module the verb never meets is red too (`v2.cli.population_verbs`
// `population_parse_report`), so an entry cannot outlive its file. A class is retired by the capability its drop's restoration trigger
// names, never by editing a list.
type RefusalClass {
  drop: String
  cause: String
  keys: List<String>
}

// Nested shorthand record initializers (gunbc.rung_drop population_parse_nested_record_shorthand).
fn nested_record_shorthand_keys() -> List<String> {
  [
    "dag:test/claim/request_authentication_witness.dag"
  ]
}

// Matches on an index expression (gunbc.rung_drop population_parse_indexed_match_scrutinee).
fn indexed_match_scrutinee_keys() -> List<String> {
  [
    "dag:extdeps/linux/proc_mountinfo.dag",
    "dag:gunbc/floor_cost_distribution.dag",
    "dag:gunbc/gate_closure_decline_census.dag",
    "dag:gunbc/instruments/native_emission_controls.dag"
  ]
}

// The same construct inside a `test fn`, where the verb reports the marker cause (gunbc.rung_drop population_parse_indexed_match_scrutinee).
fn indexed_match_scrutinee_in_test_keys() -> List<String> {
  [
    "dag:test/claim/cause_assertion_census_witness.dag",
    "dag:test/claim/check_removal_residual_witness.dag",
    "dag:test/claim/floor/floor_phase_attribution_witness.dag",
    "dag:test/claim/runner/runner_capacity_operator_access_witness.dag",
    "dag:test/claim/runner/runner_microvm_shakedown_workflow_witness.dag",
    "dag:test/claim/runner/runner_placement_witness.dag"
  ]
}

fn parse_population_declared_refusal_classes() -> List<RefusalClass> {
  [
    RefusalClass {
      drop: "population_parse_nested_record_shorthand",
      cause: "parse_g0_tokens_remain",
      keys: nested_record_shorthand_keys()
    },
    RefusalClass {
      drop: "population_parse_indexed_match_scrutinee",
      cause: "parse_g0_tokens_remain",
      keys: indexed_match_scrutinee_keys()
    },
    RefusalClass {
      drop: "population_parse_indexed_match_scrutinee",
      cause: "parse_declaration_marker_not_test",
      keys: indexed_match_scrutinee_in_test_keys()
    }
  ]
}
