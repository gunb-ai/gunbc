fn parse_population_declared_refusal_classes() -> List<RefusalClass> {
  [
    RefusalClass {
      drop: "population_parse_service_requires_transport_members",
      cause: "parse_g0_tokens_remain",
      keys: requires_transport_members_keys()
    },
    RefusalClass {
      drop: "population_parse_keyword_lambda_binder",
      cause: "parse_g0_tokens_remain",
      keys: keyword_lambda_binder_keys()
    },
    RefusalClass {
      drop: "population_parse_keyword_lambda_binder",
      cause: "parse_declaration_marker_not_test",
      keys: keyword_lambda_binder_in_test_keys()
    },
    RefusalClass {
      drop: "population_parse_match_arm_guard",
      cause: "parse_g0_tokens_remain",
      keys: match_arm_guard_keys()
    },
    RefusalClass {
      drop: "population_parse_null_coalesce",
      cause: "parse_g0_tokens_remain",
      keys: null_coalesce_keys()
    },
    RefusalClass {
      drop: "population_parse_field_refinement",
      cause: "parse_g0_tokens_remain",
      keys: field_refinement_keys()
    },
    RefusalClass {
      drop: "population_parse_nested_record_shorthand",
      cause: "parse_g0_tokens_remain",
      keys: nested_record_shorthand_keys()
    },
    RefusalClass {
      drop: "population_parse_indexed_match_scrutinee",
      cause: "parse_g0_tokens_remain",
      keys: indexed_match_scrutinee_keys()
    },
    RefusalClass {
      drop: "population_parse_indexed_match_scrutinee",
      cause: "parse_declaration_marker_not_test",
      keys: indexed_match_scrutinee_in_test_keys()
    },
    RefusalClass {
      drop: "population_parse_caret_expression",
      cause: "parse_declaration_marker_not_test",
      keys: caret_expression_in_test_keys()
    },
    RefusalClass {
      drop: "population_parse_block_operand",
      cause: "parse_declaration_marker_not_test",
      keys: block_operand_in_test_keys()
    },
    RefusalClass {
      drop: "population_parse_for_loop",
      cause: "parse_g0_tokens_remain",
      keys: for_loop_keys()
    },
    RefusalClass {
      drop: "population_parse_dotted_import_name",
      cause: "parse_g0_tokens_remain",
      keys: dotted_import_name_keys()
    },
    RefusalClass {
      drop: "population_parse_keyword_path_segment",
      cause: "parse_keyword_as_path_segment",
      keys: keyword_path_segment_keys()
    },
    RefusalClass {
      drop: "population_parse_keyword_value_name",
      cause: "parse_keyword_as_value_name",
      keys: keyword_value_name_keys()
    }
  ]
}
