module gunbc.parse_population_refusals

import std.types { List, String }

// THE POPULATION PARSE'S DECLARED REFUSALS (rung drops, DESIGN section 4b(3)). `gunbc test //gunbc/instruments:v2-native-cli` walks
// `parse-population` over the live trees; this module is the exact set of modules that verb is permitted to refuse, by module file key
// (`<tree>:<path>`) and parse cause, one class per standing drop. The rule is two-sided: a module outside the list that fails to
// parse (or fails for another cause) is red, and a listed module that parses is red, so a list can only shrink; the walked control
// additionally requires that the verb met every listed module, so an entry cannot outlive its file. A class is retired by the
// capability its drop's restoration trigger names, never by editing a list.
type RefusalClass {
  drop: String
  cause: String
  keys: List<String>
}

// Operations declaring `requires <TypeList>` together with transport, exit or mock_response members: v2's grammar stops at the first
// member after the requires list (gunbc.rung_drop population_parse_service_requires_transport_members).
fn requires_transport_members_keys() -> List<String> {
  [
    "dag:extdeps/bmc/http.dag",
