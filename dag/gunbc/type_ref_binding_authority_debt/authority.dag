module gunbc.type_ref_binding_authority_debt

import std.types { String }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }

type TypeRefDebtRosterFreezeState
  = ProvisionalUnfrozen
  | Frozen

data type_ref_debt_roster_freeze_state: TypeRefDebtRosterFreezeState = Frozen

data type_ref_census_sha: String = "f531ba548d01fd70d9b8eb825b17f542578ce485"

data type_ref_census_sha_note: String = "PIN: the hard-UnresolvedType FREEZE census that closed this universe was evaluated against exactly this commit (type_ref_census_sha) with the N1 arm on and peel #7630 (b951e724c2) present. Disagreement is decidable: re-run compile_clean_diagnostic_histogram at the recorded SHA with GUNBC_TYPE_REF_DEBT_ADMIT=0 and compare. Same defect class as merge-admission deciding a head without the identity of the evaluated state."

data type_ref_binding_authority_debt_charter_note: String = "N1 (import-strip section 14 / swift-fox-347): pool-present type refs without binding authority refuse as UnresolvedType (same shape as absent-from-pool). The ARM REFUSES — never FloorNotYet / advisory-only class enforcement (UnlistedImportUse trap). Compile-clean, resolve typecheck gates, gunbc run/serve, and regen/self-compile hard filters share identity-grain debt / expect-red admission so incidental sites stay typed/located/counted without stopping the line — not by disabling the gate. Dissolve direction on this carrier: N2 containment grant replaces type_ref_has_binding_authority's interim import-local body; bulk type-keyed rows dissolve as a measurable event (e.g. NonEmptyStr's site set), never per-site import additions (N5: residue repair, no import lines). Honest asymmetry: values/fns bind namespace-only since #7178; types refuse-unless-imported until N2."

data type_ref_debt_freeze_sequencing_note: String = "FREEZE STATE = Frozen (peel #7630 merged as b951e724c2; freeze census pin type_ref_census_sha). New-sites-refuse: UnresolvedType identities absent from debt + expect-red TSVs block compile-clean / resolve / run / regen. Roster expansion after freeze is a typed debt-contract change, never a silent admit."

data type_ref_debt_freeze_early_receipt: String = "FREEZE-EARLY RECEIPT (quiet-hawk-219 / provisional peel+arm combined census): a roster frozen before the peel fix would have refused 229 pre-existing sites as new under new-sites-refuse, each landing on an author who added nothing; measured revealed_delta unique identity = 229, retired_delta = 0 (scratch recipe df4c428366e + cherry-pick b7dfcef3465; artifacts under provisional_peel_combined/). That receipt justified waiting for #7630; the freeze census supersedes it as the closed universe."

data type_ref_debt_freeze_census_receipt: String = "FREEZE CENSUS (post-#7630 pin f531ba548d01fd70d9b8eb825b17f542578ce485): identity-grain unique UnresolvedType on compile-clean histogram = 2854; raw SITE lines = 3506; dup_extra = 652. Classification (subset rule + exec discriminator): incidental_debt = 2848; deliberate expect-red = 6 (section-14 probe fixtures only); unclassified = 0. Heal/run closure folded +1 Temperature@measure.dag:4899-4910 (compile-clean miss) → incidental_debt = 2849 enrolled. Expect-red population unchanged vs provisional (6 ContentHash / probe.shared.types.ContentHash probe sites). Peel revealed_delta overlap still present as incidental: 185 of 229 (span/content drift retired the rest; no unexpected deliberate)."

data type_ref_debt_freeze_vs_provisional_delta_note: String = "FREEZE vs PROVISIONAL-COMBINED (2155 at scratch d8a5a37c = baseline 1926 ∪ revealed 229 → pin 2854): net +699 = 988 new − 289 gone, identity-grain. Causal split: (c) span-shift re-keying ≈209 paired (same name×file, new span; 289 provisional IDs vanished, mostly this mirror plus 65 pure retires); (a) same-(name,file) fan-out under the arm/peel on already-seen pairs = 344 (the advisory-without-arm residue scaling into hard UnresolvedType fires, not a single-digit second-drop alone); (b) pure-mint new (name,file) = 435 — 80 on files absent from the scratch tree (main-added modules/tests) and 355 on scratch-present files that gained new refuse-unless-imported type refs under ordinary main motion (zero of those named ContentHash; debt population grows until N2). Discriminator already classified all of them; no re-bucket."

data type_ref_debt_site_disposition_note: String = "Per-site disposition discriminator is DELIBERATE vs INCIDENTAL — NOT path prefix. Subset = files containing unbound/refusal assertion vocabulary (word-bounded) OR section-14 RED probe fixtures. Outside the subset = incidental BY SUBSET RULE: a deliberate expect-red control must assert something about the refusal, so it would almost certainly carry the unbound/refusal vocabulary (almost certainly is the honest quantifier — not a proof). Inside the subset = execution discriminator only: DOES THE TEST/CONTROL FAIL IF THE REFERENCE BINDS? Yes → expect-red (not debt). No → incidental. Undecidable → unclassified_sites.tsv (third bucket kept alive; empty only when measured empty, never by emptying the bucket in the method)."

data type_ref_debt_roster_keying_note: String = "Rows keyed TYPE x site (file, span_start, span_end), not site alone. Ranking in provisional_debt_by_type.tsv makes N2 grant dissolution a checkable event ('this grant dissolved these N rows of type T') and ranks which single grounding buys the most. Every TSV carries census_sha as the first header field. Gate loader matches the flat TYPE\\tfile\\tstart\\tend identity."

data type_ref_roster_regenerator_choice: String = "CHOICE (b) — quiet-hawk-219 decision surface, swift-fox-347, refined: regenerate_from_census.py is an OFFLINE AUTHORING TOOL. HALF 1 PURE dissolved at freeze: census→bucket partition is gunbc.type_ref_binding_authority_debt.roster_pure_regen type_ref_fold_labeled_sites_to_roster_buckets (witness: type_ref_roster_pure_regen_witness_test). HALF 2 HOST-EFFECT — deliberate/incidental execution discriminator remains the documented offline procedure (type_ref_roster_host_effect_classify_procedure_note); the .py may still run that discriminator and host-serialize TSV outputs, but must not re-own the pure partition fold."

data type_ref_roster_pure_regen_dissolve_trigger: String = "DISSOLVED at freeze regeneration touch (type_ref_census_sha f531ba548d01…): HALF 1 PURE fold now gunbc.type_ref_binding_authority_debt.roster_pure_regen.type_ref_fold_labeled_sites_to_roster_buckets. The Python pure partition must not return as a second authority."

data type_ref_roster_host_effect_classify_procedure_note: String = "HALF 2 HOST-EFFECT — authoring-time measurement PROCEDURE, not a Scaffold. Procedure: for each site in the unbound/refusal-vocab subset (plus section-14 RED fixtures), ask by execution whether the control fails if the reference binds; label deliberate expect-red / incidental / unclassified; record bind-outcome evidence on the classification row. Typed OUTPUT rows are the checked artifact (expect_red_controls.tsv reasons, etc.). May keep living as offline documentation + occasional authoring re-run when peel reveals new sites. No dissolve-on. Not promised to become a .dag fold at freeze."

data type_ref_roster_host_effect_classify_optional_trigger: String = "OPTIONAL only — not a dissolve obligation: IF Wet/host_effect machinery makes the fails-if-binds discriminator a modeled witness (typed host-effect plan + read-back), THEN re-home this procedure onto that witness and retire the prose procedure note. Until that capability exists, half 2 stays a documented offline procedure."

data type_ref_binding_authority_debt_dissolve_trigger: String = "dissolve-on: (1) DONE — witty-badger-200 peel fix + freeze census → type_ref_census_sha pinned, type_ref_debt_roster_freeze_state = Frozen, new-sites-refuse armed; (2) N2 containment binding authority for type positions swaps type_ref_has_binding_authority body → type-keyed roster shrinks by typed disposition to empty → delete carriers + this scaffold. Partial type-keyed shrinks are legitimate monotone progress. No import additions."

data type_ref_binding_authority_debt_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.type_ref_binding_authority_debt",
    decl_name: "type_ref_binding_authority_debt_dissolve_trigger",
    field: WholeDeclaration
  }
}
