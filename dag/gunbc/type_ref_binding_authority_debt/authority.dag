module gunbc.type_ref_binding_authority_debt

import std.types { String }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }

type TypeRefDebtRosterFreezeState
  = ProvisionalUnfrozen
  | Frozen

data type_ref_debt_roster_freeze_state: TypeRefDebtRosterFreezeState = ProvisionalUnfrozen

data type_ref_census_sha: String = "89dbea7d896b3ae95195117374a8c0c9454f341e"

data type_ref_census_sha_note: String = "PIN: the hard-UnresolvedType census that closed this provisional universe was evaluated against exactly this commit (type_ref_census_sha). ContentHash 51 vs 47 was classification moving deliberate expect-red sites off the debt roster against ONE tree — not main advancing. Freeze is against this SHA (then peel re-census may advance it), never against 'today'. Disagreement is decidable: re-run compile_clean_diagnostic_histogram at the recorded SHA with GUNBC_TYPE_REF_DEBT_ADMIT=0 and compare. Same defect class as merge-admission deciding a head without the identity of the evaluated state."

data type_ref_binding_authority_debt_charter_note: String = "N1 (import-strip section 14 / swift-fox-347): pool-present type refs without binding authority refuse as UnresolvedType (same shape as absent-from-pool). The ARM REFUSES — never FloorNotYet / advisory-only class enforcement (UnlistedImportUse trap). Compile-clean stays green via an identity-grain debt roster, not by disabling the gate. Dissolve direction on this carrier: N2 containment grant replaces type_ref_has_binding_authority's interim import-local body; bulk type-keyed rows dissolve as a measurable event (e.g. NonEmptyStr's site set), never per-site import additions (N5: residue repair, no import lines). Honest asymmetry: values/fns bind namespace-only since #7178; types refuse-unless-imported until N2."

data type_ref_debt_freeze_sequencing_note: String = "FREEZE STATE = ProvisionalUnfrozen until witty-badger-200's peel_alias_once_for_field_access diagnostics-drop fix lands AND a census re-run closes the universe at a new type_ref_census_sha. Rationale (quiet-hawk-219): the hard UnresolvedType census is a LOWER BOUND while peel suppresses sites; freezing new-sites-refuse against a short denominator would red PRs whose authors added nothing when peel reveals pre-existing sites. Revealed sites are additive to classification. PR-ready flip waits on Frozen. Meanwhile: arm, deliberate-vs-incidental classification, and debt machinery proceed."

data type_ref_debt_site_disposition_note: String = "Per-site disposition discriminator is DELIBERATE vs INCIDENTAL — NOT path prefix. Subset = files containing unbound/refusal assertion vocabulary (word-bounded) OR section-14 RED probe fixtures. Outside the subset = incidental BY CONSTRUCTION. Inside the subset = execution discriminator only: DOES THE TEST/CONTROL FAIL IF THE REFERENCE BINDS? Yes → expect-red (not debt). No → incidental. Undecidable → unclassified_sites.tsv (third bucket kept alive; empty only when measured empty, never by construction). regenerate_from_census.py is the carrier for that procedure."

data type_ref_debt_roster_keying_note: String = "Rows keyed TYPE x site (file, span_start, span_end), not site alone. Ranking in provisional_debt_by_type.tsv makes N2 grant dissolution a checkable event ('this grant dissolved these N rows of type T') and ranks which single grounding buys the most. Every TSV carries census_sha as the first header field. Gate loader matches the flat TYPE\\tfile\\tstart\\tend identity."

data type_ref_binding_authority_debt_dissolve_trigger: String = "dissolve-on: (1) witty-badger-200 peel fix + re-census → update type_ref_census_sha, flip type_ref_debt_roster_freeze_state to Frozen and arm new-sites-refuse; (2) N2 containment binding authority for type positions swaps type_ref_has_binding_authority body → type-keyed roster shrinks by typed disposition to empty → delete carriers + this scaffold. Partial type-keyed shrinks are legitimate monotone progress. No import additions."

data type_ref_binding_authority_debt_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.type_ref_binding_authority_debt",
    decl_name: "type_ref_binding_authority_debt_dissolve_trigger",
    field: WholeDeclaration
  }
}
