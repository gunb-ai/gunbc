module gunbc.type_ref_binding_authority_debt

import std.types { String }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }

type TypeRefDebtRosterFreezeState
  = ProvisionalUnfrozen
  | Frozen

data type_ref_debt_roster_freeze_state: TypeRefDebtRosterFreezeState = Frozen

data type_ref_census_sha: String = "f531ba548d01fd70d9b8eb825b17f542578ce485"

data type_ref_census_sha_note: String = "PIN: the hard-UnresolvedType FREEZE census that closed this universe was evaluated against exactly this commit (type_ref_census_sha) with the N1 arm on and peel #7630 (b951e724c2) present. Disagreement is decidable: re-run compile_clean_diagnostic_histogram at the recorded SHA with GUNBC_TYPE_REF_DEBT_ADMIT=0 and compare. Same defect class as merge-admission deciding a head without the identity of the evaluated state."

data type_ref_binding_authority_debt_charter_note: String = "N1 (import-strip section 14 / swift-fox-347): pool-present type refs without binding authority refuse as UnresolvedType (same shape as absent-from-pool). The ARM REFUSES — never FloorNotYet / advisory-only class enforcement (UnlistedImportUse trap). Compile-clean, resolve typecheck gates, gunbc run/serve, and regen/self-compile hard filters share identity-grain debt / expect-red admission so incidental sites stay typed/located/counted without stopping the line — not by disabling the gate. Dissolve direction on this carrier: N2 containment grant replaces type_ref_has_binding_authority's interim import-local body; bulk type-keyed rows dissolve as a measurable event (e.g. NonEmptyStr's site set), never per-site import additions (N5: residue repair, no import lines). Honest asymmetry: values/fns bind namespace-only since #7178; types refuse-unless-imported until N2."

data type_ref_debt_freeze_sequencing_note: String = "FREEZE STATE = Frozen (peel #7630 merged as b951e724c2; freeze census pin type_ref_census_sha). New-sites-refuse: UnresolvedType identities absent from debt + expect-red TSVs block compile-clean / resolve / run / regen. Roster expansion after freeze is a typed debt-contract change, never a silent admit."

data type_ref_debt_freeze_early_receipt: String = "FREEZE-EARLY RECEIPT (quiet-hawk-219 / provisional peel+arm combined census): a roster frozen before the peel fix would have refused 229 pre-existing sites as new under new-sites-refuse, each landing on an author who added nothing; measured revealed_delta unique identity = 229, retired_delta = 0 (scratch recipe df4c428366e + cherry-pick b7dfcef3465; artifacts under provisional_peel_combined/). That receipt justified waiting for #7630; the freeze census supersedes it as the closed universe."

data type_ref_debt_freeze_census_receipt: String = "FREEZE CENSUS (post-#7630 pin f531ba548d01fd70d9b8eb825b17f542578ce485): identity-grain unique UnresolvedType on compile-clean histogram = 2854; raw SITE lines = 3506; dup_extra = 652. Classification (subset rule + exec discriminator): incidental_debt = 2848; deliberate expect-red = 6 (section-14 probe fixtures only); unclassified = 0. Heal/run closure folded +1 Temperature@measure.dag:4899-4910 (compile-clean miss) → incidental_debt = 2849 enrolled. Expect-red population unchanged vs provisional (6 ContentHash / probe.shared.types.ContentHash probe sites). Peel revealed_delta overlap still present as incidental: 185 of 229 (span/content drift retired the rest; no unexpected deliberate)."

data type_ref_debt_freeze_vs_provisional_delta_note: String = "FREEZE vs PROVISIONAL-COMBINED (2155 at scratch d8a5a37c = baseline 1926 ∪ revealed 229 → pin 2854): exclusive identity-grain partition, zero-tolerance. NEW 988 = 209 rekey-new + 344 same-(name,file) fan-out + 435 pure-mint. VANISHED 289 = 209 rekey-old (1:1 mirrors of rekey-new) + 15 same-nf shrink (provisional-only spans on shared name×file with no freeze partner) + 65 pure-retire (name×file gone). 988 − 289 = +699. Rekeys cancel in the net; surviving growth = 344 fan-out + 435 pure-mint − 15 shrink − 65 retire. Pure-mint 435 unchanged under reconciliation (80 on scratch-absent files / 355 on scratch-present; 0 named ContentHash — debt grows under ordinary main motion until N2). Grain: TYPE×file×span; buckets disjoint by construction."

data type_ref_debt_site_disposition_note: String = "Per-site disposition discriminator is DELIBERATE vs INCIDENTAL — NOT path prefix. Subset = files containing unbound/refusal assertion vocabulary (word-bounded) OR section-14 RED probe fixtures. Outside the subset = incidental BY SUBSET RULE: a deliberate expect-red control must assert something about the refusal, so it would almost certainly carry the unbound/refusal vocabulary (almost certainly is the honest quantifier — not a proof). Inside the subset = execution discriminator only: DOES THE TEST/CONTROL FAIL IF THE REFERENCE BINDS? Yes → expect-red (not debt). No → incidental. Undecidable → unclassified_sites.tsv (third bucket kept alive; empty only when measured empty, never by emptying the bucket in the method)."

data type_ref_debt_universe_openness_note: String = "UNIVERSE OPENNESS (DESIGN §5 monotone-debt condition 1 — declared, not inflated): the frozen UnresolvedType census at type_ref_census_sha enumerated the population ONE resolve context reveals (whole-tree pool / compile-clean histogram). Narrow-closure contexts (discovery entries, regen plan-resolve) fire the N1 arm at sites that whole-tree resolve hid by pool-membership coincidence (#6985 Class B). So the subject universe is resolve-context-dependent and therefore OPEN — condition 1 does not currently hold. The freeze stands as a BOUNDED INTERIM admission contract over the enumerated whole-tree population (new-sites-refuse still hard on identities absent from debt+expect-red). Named next-rung trigger: N2 containment binding for type positions, which makes binding closure-independent and closes the universe. Declared openness is honest interim debt; an undeclared one would be rung inflation."

data type_ref_import_add_discriminator_note: String = "DECIDABLE DISCRIMINATOR (quiet-hawk-219 / calm-badger): an import-add is EXPLICITATION iff the importing module references a symbol the imported module DECLARES (a true dependency fact made explicit — converts Class-B coincidental pool binding into explicit binding authority). It is PADDING iff not (census-residue / pool-padder — the N5/N7 exclusion). Mechanical: for each imported name N from module M, ask whether the importer's body references N and whether M declares N; both true → explicitation; else → padding. Wall candidate later; judgment call forbidden."

data type_ref_class_b_explicitation_count: Int = 36

data type_ref_class_b_explicitation_count_note: String = "RUNNING COUNT of Class-B EXPLICITATION import symbols (type_ref_import_add_discriminator_note) under N1. Rationale: every explicitation zeroes a false-fire that would otherwise price N2; uncounted, that displaced cost drains away invisibly (author-side absorbing fallback); counted, N2's case grows on a measured quantity. Seed 905307fb = 28 symbols (rust_wire_serde 12 + grounding 9 + naming_policy_test 7) — each names the DEFINER of a referenced type (verified). +5 on v2.std.node (std.occurrence_identity OccurrenceId/NodeOccurrenceIdentity/OccurrenceSynthetic/OccurrenceMinted/node_occurrence_identity_minted) after review 47295 made the qualified facade RHS refuse without leaf authority. +2 on v2.std.orchestration + v2.std.effect_plan (re-home std.nat→v2.std.nat so max_attempts binds the Peano Nat those fields reference, not the std.nat CommutativeSemiring fork). +1 on v2.workflow.ci_floor_plan (same Nat re-home — regen plan-resolve surfaces the fork under narrow closure). Dissolve-on: N2 containment binding empties the need; N7 deletes the import lines mechanically with every other import. NOT a freeze-TSV rewrite."

data type_ref_debt_roster_keying_note: String = "Rows keyed TYPE x site (file, span_start, span_end), not site alone. Ranking in provisional_debt_by_type.tsv makes N2 grant dissolution a checkable event ('this grant dissolved these N rows of type T') and ranks which single grounding buys the most. Every TSV carries census_sha as the first header field. Gate loader matches the flat TYPE\\tfile\\tstart\\tend identity."
data type_ref_roster_regenerator_choice: String = "CHOICE (b) — quiet-hawk-219 decision surface, swift-fox-347, refined: regenerate_from_census.py is an OFFLINE AUTHORING TOOL. NEVER invoked from CI, claim_executor, compile-clean, or any enrolled floor consumer. SINGLE AUTHORITY for census→bucket partition: that script (HALF 2 host-effect classify labels each site; then one labeled→buckets fold + TSV host serialize). Checked floor artifacts remain the SHA-pinned TSVs + type_ref_census_sha — not the authoring tool. HALF 2 procedure note: type_ref_roster_host_effect_classify_procedure_note."

data type_ref_roster_pure_regen_dissolve_trigger: String = "RETRACTED premature DISSOLVED claim (review 47277): roster_pure_regen.dag was an unused second authority while regenerate_from_census.py still partitioned labeled sites into incidental/expect_red/unclassified — DESIGN §2–§3 dual-authority. Deleted the unused .dag fold. SINGLE AUTHORITY now: offline regenerate_from_census.py. Dissolve-on: an enrolled floor/authoring consumer runs a modeled labeled→buckets fold as the sole partition; then Python must call that fold (or delete its partition arm) — never keep both."

data type_ref_roster_host_effect_classify_procedure_note: String = "HALF 2 HOST-EFFECT — authoring-time measurement PROCEDURE, not a Scaffold. Procedure: for each site in the unbound/refusal-vocab subset (plus section-14 RED fixtures), ask by execution whether the control fails if the reference binds; label deliberate expect-red / incidental / unclassified; record bind-outcome evidence on the classification row. Typed OUTPUT rows are the checked artifact (expect_red_controls.tsv reasons, etc.). May keep living as offline documentation + occasional authoring re-run when peel reveals new sites. No dissolve-on. Not promised to become a .dag fold at freeze."

data type_ref_roster_host_effect_classify_optional_trigger: String = "OPTIONAL only — not a dissolve obligation: IF Wet/host_effect machinery makes the fails-if-binds discriminator a modeled witness (typed host-effect plan + read-back), THEN re-home this procedure onto that witness and retire the prose procedure note. Until that capability exists, half 2 stays a documented offline procedure."

data type_ref_binding_authority_debt_dissolve_trigger: String = "dissolve-on: (1) DONE — witty-badger-200 peel fix + freeze census → type_ref_census_sha pinned, type_ref_debt_roster_freeze_state = Frozen, new-sites-refuse armed; (2) N2 containment binding authority for type positions swaps type_ref_has_binding_authority body → type-keyed roster shrinks by typed disposition to empty → delete carriers + this scaffold AND the cli_run HAND-RUST admission transport (`CLI_RUN_TYPE_REF_BINDING_AUTHORITY_DEBT_ADMISSION_SCAFFOLD_MARKER` / `type_ref_unresolved_admitted_for_compile_clean` + TSV loaders). Partial type-keyed shrinks are legitimate monotone progress. No import additions."

data type_ref_binding_authority_debt_hand_rust_receipt: String = "HAND-RUST GATE receipt (review 47269): N1 admission is seed-retained host transport in cli_run.rs (~125 LOC typed block; net cli_run +168 vs main including call-site wiring). DELETE WHEN: remove scaffold token cli_run_type_ref_binding_authority_debt_admission (`CLI_RUN_TYPE_REF_BINDING_AUTHORITY_DEBT_ADMISSION_SCAFFOLD_MARKER`) plus load_type_ref_site_identity_tsv / type_ref_unresolved_admitted_for_compile_clean / debt+expect-red OnceLock loaders — declaration-grain pin `rg -F 'CLI_RUN_TYPE_REF_BINDING_AUTHORITY_DEBT_ADMISSION_SCAFFOLD_MARKER: &str =' src/v1/stage0/src/cli_run.rs` == 1 until deletion. Explicit deferral lane: N2 type-position containment (docs/plans/namespace-resolution-design.md; import-strip §14 / docs/plans/import-strip-witness-discovery-cascade-diagnosis.md). Semantic debt census (TSVs + type_ref_census_sha) is a DIFFERENT carrier — this receipt covers only the hand-Rust consumer. Not a census shrink of the seed until N2 empties the roster."

data type_ref_binding_authority_debt_hand_rust_plan_anchor: String = "docs/plans/import-strip-witness-discovery-cascade-diagnosis.md"

data type_ref_binding_authority_debt_hand_rust_loc_delta_net: Int = 125

data type_ref_binding_authority_debt_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.type_ref_binding_authority_debt",
    decl_name: "type_ref_binding_authority_debt_dissolve_trigger",
    field: WholeDeclaration
  }
}

data type_ref_generic_use_site_residual_owner: String = "quiet-hawk-219 namespace migration (import deletion) — N2 type-position containment"

data type_ref_generic_use_site_residual_lane: String = "N2 containment binding for type positions (docs/plans/namespace-resolution-design.md; import-strip §14 / docs/plans/import-strip-witness-discovery-cascade-diagnosis.md). Same dissolve lane as type_ref_binding_authority_debt_dissolve_trigger step (2)."

data type_ref_generic_use_site_residual_dissolve_trigger: String = "dissolve-on: N2 swaps type_ref_has_binding_authority's interim import-local body to containment for type positions — at that point is_user_generic_use_site pool expansion without binding-authority UnresolvedType is unwritable by construction (the gate applies to every use-site path, leaf and generic). PRIMARY path is N2 construction, not a second freeze census under a mid-PR arm widen. DELETE WHEN: this residual scaffold + type_ref_generic_use_site_follow_up_note on v1.compiler.resolve, once the N2 body swap lands and a discriminating RED proves generic unbound pool-hits refuse."

data type_ref_generic_use_site_residual_rung_note: String = "§4b honesty: current path = known fail-open substrate arm (is_user_generic_use_site expands pool hit without binding-authority UnresolvedType — silent fabrication class for Generic<T> only). Attainable ceiling = structurally impossible / construction via N2 containment binding. Below ceiling is a named residual, not an undeclared gap. N1 chartered scope = leaf type-ref path only (f531ba548d freeze census); mid-PR widen stripped per quiet-hawk-219 (reviews 47291/47314/47317 decline-apply-now)."

data type_ref_generic_use_site_residual_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.type_ref_binding_authority_debt",
    decl_name: "type_ref_generic_use_site_residual_dissolve_trigger",
    field: WholeDeclaration
  }
}
