module gunbc.fleet_convergence_verdict


// THE fleet-atomic-convergence-verdict fold (operator directive 2026-08-08): ONE verdict
// over the whole fleet, joining the knob-grain converge receipts (the slice1 circuit's
// ConvergeCliReceipt) with the lifecycle-phase cells (the observe_host_phase matrix).
// The load-bearing law is fail-closed at the CELL: a required cell nobody observed
// PREVENTS fleet convergence — it never defaults green — and the not-converged causes
// keep their remedies distinct (unobserved: build/run the producer; unreachable: fix
// reach; refused/conflict: resolve the contradiction; drifted: run the converge). The
// current defect this fold makes countable rather than prose: the fleet phase matrix has
// exactly ONE real producer cell today (srv3, prefix:os-install-actuated), so every
// other required cell reads unobserved and the fleet verdict is honestly NOT converged
// until producers land receipts — that number going down IS the arc's progress.
type RequiredCellStanding
  = CellConverged { host: product.placement_supply.HostIdentity, phase_label: String }
  | CellUnobserved { host: product.placement_supply.HostIdentity, phase_label: String }
  | CellUnreachable { host: product.placement_supply.HostIdentity, phase_label: String }
  | CellDrifted { host: product.placement_supply.HostIdentity, phase_label: String }
  | CellConflict { host: product.placement_supply.HostIdentity, phase_label: String }

// Projection keeps the full six-arm ObservationVerdict fidelity: std.upsert_decision.Absent and
// UnknownRefused are both "nobody observed this" (no producer, or a producer with no
// committed observation) and land in CellUnobserved; Inaccessible is a producer that
// ASKED and could not reach — a different remedy, kept distinct; Conflict is its own arm
// (a wrong-machine or contradictory observation is neither drift nor unreachability).
fn required_cell_standing(c: gunbc.host_phase_status.HostPhaseCellStatus) -> RequiredCellStanding {
  let host = c.cell.host
  let label = c.cell.phase_label
  match host_phase_cell_verdict(c: c) {
    Converged => CellConverged { host: host, phase_label: label }
    Absent => CellUnobserved { host: host, phase_label: label }
    UnknownRefused => CellUnobserved { host: host, phase_label: label }
    Inaccessible => CellUnreachable { host: host, phase_label: label }
    Drifted => CellDrifted { host: host, phase_label: label }
    Conflict => CellConflict { host: host, phase_label: label }
  }
}

fn cell_standing_is_converged(s: RequiredCellStanding) -> Bool {
  match s {
    CellConverged { host: _, phase_label: _ } => true
    CellUnobserved { host: _, phase_label: _ } => false
    CellUnreachable { host: _, phase_label: _ } => false
    CellDrifted { host: _, phase_label: _ } => false
    CellConflict { host: _, phase_label: _ } => false
  }
}

// A host's knob-grain standing joins by IDENTITY with its lifecycle cells. A host with
// no converge receipt at all is unobserved at knob grain — the same fail-closed arm as
// an unobserved cell, never a default green.
type HostKnobStanding
  = KnobConverged { host: product.placement_supply.HostIdentity }
  | KnobNotConverged { host: product.placement_supply.HostIdentity, reason: String }
  | KnobUnobserved { host: product.placement_supply.HostIdentity }

// Duplicate receipts for ONE host identity are a CONTRADICTION to classify, never a
// pick (the machine-id hazard, msg_1c4e0bce: both Sparks share one /etc/machine-id and
// shipped identical host keys, so two machines CAN claim one identity until
// host-identity-converge runs — first-wins would render that collision a verdict).
// 0 receipts -> Unobserved; exactly 1 -> judged on its own validity; >1 -> NotConverged
// with the ambiguity named, whatever the duplicates claim.
fn host_knob_standing(host: product.placement_supply.HostIdentity, receipts: List<gunbc.fleet_converge_cli.ConvergeCliReceipt>) -> HostKnobStanding {
  let mine = filter(receipts, r => r.host == (host as String))
  if length(mine) == 0 {
    KnobUnobserved { host: host }
  } else {
    if length(mine) > 1 {
      KnobNotConverged { host: host, reason: "ambiguous: multiple converge receipts claim this one host identity — a collision to investigate, never a pick" }
    } else {
      let r = mine.first()
      if converge_cli_receipt_converged(r: r) {
        KnobConverged { host: host }
      } else {
        KnobNotConverged { host: host, reason: "converge receipt present but not converged" }
      }
    }
  }
}

fn host_knob_standing_is_converged(s: HostKnobStanding) -> Bool {
  match s {
    KnobConverged { host: _ } => true
    KnobNotConverged { host: _, reason: _ } => false
    KnobUnobserved { host: _ } => false
  }
}

type HostConvergenceStanding {
  host: product.placement_supply.HostIdentity
  knob: HostKnobStanding
  cells: List<RequiredCellStanding>
}

fn host_convergence_standing(
  intent: gunbc.host_assimilation_program.HostEnrollmentIntent,
  receipts: List<gunbc.fleet_converge_cli.ConvergeCliReceipt>,
) -> HostConvergenceStanding {
  HostConvergenceStanding {
    host: intent.host,
    knob: host_knob_standing(host: intent.host, receipts: receipts),
    cells: map(host_phase_cells_for_enrollment(intent: intent), c => required_cell_standing(c: c)),
  }
}

fn host_standing_is_converged(s: HostConvergenceStanding) -> Bool {
  host_knob_standing_is_converged(s: s.knob)
    && fold(s.cells, init: true, f: fn(acc, c) { acc && cell_standing_is_converged(s: c) })
}

type FleetConvergenceVerdict
  = FleetConverged { host_count: Int }
  | FleetNotConverged { standings: List<HostConvergenceStanding> }

// The atomic fold: converged only when EVERY enrolled host converges at BOTH grains.
// The not-converged arm carries every host's full standing rather than a count, so the
// blocking cells are readable without re-deriving anything — the verdict IS the work
// list. An empty enrollment refuses convergence (a fleet of zero hosts is an observation
// gap, not a converged fleet).
fn fleet_convergence_verdict(
  enrollments: List<gunbc.host_assimilation_program.HostEnrollmentIntent>,
  receipts: List<gunbc.fleet_converge_cli.ConvergeCliReceipt>,
) -> FleetConvergenceVerdict {
  let standings = map(enrollments, e => host_convergence_standing(intent: e, receipts: receipts))
  if length(standings) > 0
    && fold(standings, init: true, f: fn(acc, s) { acc && host_standing_is_converged(s: s) }) {
    FleetConverged { host_count: length(standings) }
  } else {
    FleetNotConverged { standings: standings }
  }
}

fn fleet_unobserved_cell_count(standings: List<HostConvergenceStanding>) -> Int {
  fold(standings, init: 0, f: fn(acc, s) {
    acc + fold(s.cells, init: 0, f: fn(a, c) {
      match c {
        CellUnobserved { host: _, phase_label: _ } => a + 1
        _ => a
      }
    })
  })
}
