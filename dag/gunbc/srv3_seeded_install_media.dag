module gunbc.srv3_seeded_install_media

import extdeps.os.ubuntu_seeded_install_media_toolchain {
  install_media_remaster_toolchain_requirement,
  install_media_remaster_toolchain_is_complete,
}
import extdeps.os.ubuntu_autoinstall { NoCloudLocal, NoCloudNet }
import gunbc.os_install { srv3_ubuntu_autoinstall_on_iso }
import gunbc.srv3_seeded_install_media_artifact {
  srv3_seeded_install_media_artifact,
  srv3_seeded_ubuntu_install_media_install_path,
  srv3_seeded_grub_kernel_cmdline,
  srv3_seeded_install_media_content_hash,
  srv3_autoinstall_user_data_body,
}
import gunbc.srv3_host_effect_apply {
  srv3_seeded_install_media_toolchain_ensure_apply,
  srv3_seeded_install_media_remaster_apply,
  srv3_reconciliation_to_process_exit,
}
import gunbc.host_effect_realize {
  srv3_seeded_install_media_toolchain_privileged_apt_install_is_gated,
}
import gunbc.os_install_actuator_selection { srv3_os_install_actuator_host }
import gunbc.fleet_intent { srv1_host, ComputeHost }
import std.disposition { Disposition, RealizationDispatch, Scaffold, SingleAuthority, Terminal }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.types { NonEmptyStr, String, Bool }
import std.resources { Network }

data gunbc_srv3_seeded_install_media_scope_disposition: Disposition = Terminal {
  reason: "srv3 seeded autoinstall ISO — remaster stock ISO with embedded nocloud user-data + GRUB autoinstall ds=nocloud; content-hash keyed on stock sha256 + autoinstall payload; dissolves NoCloudNet seed-delivery gap when proven by unattended boot execution."
}

data srv3_seeded_install_media_remaster_scaffold: Disposition = Terminal {
  reason: "srv3_seeded_install_media_remaster() routes through host_effect_apply to install_media_remaster_reconcile() in-process (TypedReconcileOnHost cell, dag/gunbc/host_effect_realize.dag) - no shell script is built, serialized, or run for this effect"
}

data srv3_seeded_install_media_toolchain_ensure_scaffold: Disposition = Terminal {
  reason: "srv3_seeded_install_media_toolchain_ensure routes through host_effect_apply realize_seeded_install_media_toolchain_ensure_on_host (SeededInstallMediaToolchainOnHost cell, dag/gunbc/host_effect_realize.dag) - no shell script is built, serialized, or run for this effect"
}

data install_media_remaster_toolchain_ensure_dissolution_trigger: Disposition = Terminal {
  reason: "install_media_remaster_toolchain_ensure dissolved onto host_effect_apply realize_seeded_install_media_toolchain_ensure_on_host (srv3_ensure_apt_tool + xorriso version probe) - no concat-built bash script remains"
}

data srv3_seeded_install_media_unattended_not_proven_marker: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.srv3_os_install_actuate_scope",
    decl_name: "srv3_autoinstall_seed_delivery_refusal",
    field: WholeDeclaration
  }
}

func srv3_seeded_install_media_toolchain_ensure() -> ProcessExit
  uses net: Network
{
  srv3_reconciliation_to_process_exit(
    r: srv3_seeded_install_media_toolchain_ensure_apply(),
    failure_prefix: "seeded-install-media-toolchain-ensure: ",
  )
}

func srv3_seeded_install_media_remaster() -> ProcessExit
  uses net: Network
{
  let ensure_exit = srv3_reconciliation_to_process_exit(
    r: srv3_seeded_install_media_toolchain_ensure_apply(),
    failure_prefix: "seeded-install-media-remaster: toolchain ensure failed: ",
  )
  match ensure_exit {
    ExitSuccess => {}
    _ => return ensure_exit
  }
  srv3_reconciliation_to_process_exit(
    r: srv3_seeded_install_media_remaster_apply(),
    failure_prefix: "seeded-install-media-remaster: ",
  )
}

fn srv3_seeded_install_media_actuator_host() -> ComputeHost {
  srv3_os_install_actuator_host
}

fn srv3_seeded_install_media_actuator_host_is_srv1() -> Bool {
  srv3_seeded_install_media_actuator_host() == srv1_host
}

fn srv3_seeded_install_media_install_path_is_versioned() -> Bool {
  string_contains(
    s: srv3_seeded_ubuntu_install_media_install_path as String,
    pattern: "ubuntu-24.04.3-live-server-srv3-seeded.iso",
  )
}

fn srv3_seeded_autoinstall_delivery_is_on_iso() -> Bool {
  match srv3_ubuntu_autoinstall_on_iso.delivery {
    NoCloudLocal => true
    NoCloudNet { seed_url: _ } => false
  }
}

fn srv3_seeded_grub_cmdline_names_nocloud() -> Bool {
  string_contains(s: srv3_seeded_grub_kernel_cmdline as String, pattern: "autoinstall ds=nocloud")
}

fn srv3_seeded_install_media_unattended_not_proven_yet() -> Bool {
  match srv3_seeded_install_media_unattended_not_proven_marker {
    Scaffold { dissolves_to: _, bind: _ } => true
    Terminal { reason: _ } => false
  }
}

fn srv3_seeded_install_media_remaster_toolchain_is_modeled() -> Bool {
  install_media_remaster_toolchain_is_complete(
    requirement: install_media_remaster_toolchain_requirement,
  )
}

fn srv3_seeded_install_media_toolchain_ensure_is_privileged_gated() -> Bool {
  srv3_seeded_install_media_toolchain_privileged_apt_install_is_gated()
}
