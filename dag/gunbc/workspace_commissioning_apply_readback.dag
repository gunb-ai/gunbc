module gunbc.workspace_commissioning_apply_readback

import std.types { Bool, String, NonEmptyStr }
import std.decl_ref { decl_ref }
import std.durable_compare_and_set { CasGeneration }
import extdeps.filesystem.filesystem_io { Filesystem, filesystem_exact_read, FilesystemExactPathRead, FilesystemExactPathAbsent }
import gunbc.runner_microvm_cell_readiness_store { read_store_ownership, OwnershipRead }
import gunbc.runner_microvm_slot_unit { workspace_launch_credential_source_path }
import gunbc.workspace_commissioning_store { workspace_commissioning_record_text }
import gunbc.workspace_commissioning_transaction { WorkspaceCommissioningPrepared }
import gunbc.workspace_slot_mutation {
  WorkspaceSlotMutationLease, WorkspaceSlotMutationLeaseHeld, workspace_slot_mutation_still_owned,
  workspace_slot_mutation_key, workspace_commissioning_mutation_owner, workspace_slot_mutation_release_fenced,
  workspace_commissioning_mutation_recover, WorkspaceCommissioningMutationRetained,
  WorkspaceCommissioningMutationReleased,
}

import v2.std.algebra { filter }
import gunbc.build_cache_instance { RunnerSlotIdentity, runner_slot_instance_name }
import gunbc.runner_microvm_slot_unit { microvm_slot_unit_instance_name, microvm_slot_unit_timeout_stop }
import gunbc.runner_microvm_slot_controller { slot_controller_receipt_prefix, outcome_text, SlotControllerCommissioned }
import gunbc.runner_microvm_slot_start {
  MicrovmSlotStartRun, SlotStartCompleted, UnitPropertyRead, ControllerReceiptRead,
  MicrovmUnitStartSubject, microvm_unit_start_observed, microvm_invocation_observe, InvocationTerminated,
}
import gunbc.workspace_commissioning_transaction {
  WorkspaceCommissioningProvenance, WorkspaceCommissioningRecordRead, WorkspaceCommissioningCommitted,
}
import gunbc.workspace_commissioning_store {
  workspace_commissioning_store_root, workspace_commissioning_store_observe,
  WorkspaceCommissioningStoreObserved, WorkspaceCommissioningStoreRefused,
}
import gunbc.workspace_commissioning_runtime { workspace_commissioning_runtime_refusal }
import gunbc.workspace_commissioning_admission_observe { workspace_commissioning_no_hold_refusal }
import gunbc.workspace_initial_sanitation { workspace_observe_initial_sanitation, WorkspaceInitialSanitationReadback }
import gunbc.runner_microvm_network { SlotNetworkSanitationSubject }
import gunbc.runner_microvm_cell_readiness { CellReadinessStoreRead, StoreRead, StoreRootOwned, CellSettled, record_cell }
import gunbc.runner_microvm_cell_readiness_store { read_cell_readiness_store }
import product.fabric.sanitation { CellReady }

// This readback is necessary before credential removal, not a fleet-apply terminal. Its caller
// must retain the shared mutation exclusion through removal, absence readback and settlement.
// Only actual host reads can construct it; fixture observations cannot mint the result.
type WorkspaceCommissioningApplyReadback sole_constructor {
  provenance: WorkspaceCommissioningProvenance
  invocation: NonEmptyStr
}

type WorkspaceCommissioningApplyReadbackResult
  = WorkspaceCommissioningApplyObserved { readback: WorkspaceCommissioningApplyReadback }
  | WorkspaceCommissioningApplyReadbackRefused { reason: String }

fn workspace_commissioning_terminal_succeeded(slot: RunnerSlotIdentity,
  invocation: NonEmptyStr, result: MicrovmSlotStartRun) -> Bool {
  match result {
    SlotStartCompleted { unit, invocation_id, exec_main_status: UnitPropertyRead { value: "0" },
      controller_receipt: ControllerReceiptRead { path: _, text } } =>
      unit == microvm_slot_unit_instance_name(slot_instance: runner_slot_instance_name(slot: slot) as String)
        && invocation_id == invocation && text == outcome_text(o: SlotControllerCommissioned)
    _ => false
  }
}

// Initial apply must reread generation ZERO. The ordinary supply reader permits later settled
// generations for subsequent allocations and therefore cannot discharge this commissioning gate.
fn workspace_commissioning_initial_ready(slot: RunnerSlotIdentity, reading: CellReadinessStoreRead) -> Bool {
  let cell = runner_slot_instance_name(slot: slot) as String
  match reading {
    StoreRead { ownership: StoreRootOwned, records } => {
      let own = filter(records, r => (record_cell(record: r) as String) == cell)
      own.count() == 1 && (match own.first() {
        Present { value: CellSettled { cell: _, generation: 0, readiness: CellReady { cell: ready } } } => (ready as String) == cell
        _ => false
      })
    }
    _ => false
  }
}

fn workspace_commissioning_apply_observe(provenance: WorkspaceCommissioningProvenance,
  release_dir: NonEmptyStr, login: NonEmptyStr, network: SlotNetworkSanitationSubject,
  invocation: NonEmptyStr) -> WorkspaceCommissioningApplyReadbackResult {
  let instance = runner_slot_instance_name(slot: provenance.slot) as String
  let subject = MicrovmUnitStartSubject {
    unit: microvm_slot_unit_instance_name(slot_instance: instance),
    receipt_prefix: slot_controller_receipt_prefix(instance: instance), bound: microvm_slot_unit_timeout_stop(),
  }
  let terminal = microvm_unit_start_observed(subject: subject, invocation: invocation)
  if !workspace_commissioning_terminal_succeeded(slot: provenance.slot, invocation: invocation, result: terminal) {
    WorkspaceCommissioningApplyReadbackRefused { reason: "the exact controller invocation has no successful commissioning terminal" }
  } else { match workspace_commissioning_runtime_refusal(provenance: provenance, release_dir: release_dir, login: login) {
    Present { value: reason } => WorkspaceCommissioningApplyReadbackRefused { reason: reason }
    Absent => match workspace_commissioning_no_hold_refusal(provenance: provenance) {
      Present { value: reason } => WorkspaceCommissioningApplyReadbackRefused { reason: reason }
      Absent => match workspace_observe_initial_sanitation(subject: network) {
        WorkspaceInitialSanitationReadback { observation } => if observation.slot != provenance.slot
          || observation.observation_identity != provenance.sanitation_observation {
          WorkspaceCommissioningApplyReadbackRefused { reason: "post-controller sanitation does not match the reviewed slot subject" }
        } else { match workspace_commissioning_store_observe(root: workspace_commissioning_store_root, provenance: provenance) {
          WorkspaceCommissioningStoreRefused { reason } => WorkspaceCommissioningApplyReadbackRefused { reason: reason }
          WorkspaceCommissioningStoreObserved { snapshot } => match snapshot.reading {
            WorkspaceCommissioningRecordRead { record: WorkspaceCommissioningCommitted { provenance: stored } } =>
              if stored != provenance || !workspace_commissioning_initial_ready(slot: provenance.slot, reading: read_cell_readiness_store()) {
                WorkspaceCommissioningApplyReadbackRefused { reason: "committed provenance and generation-zero readiness do not agree" }
              } else { match microvm_invocation_observe(unit: subject.unit, invocation: invocation) {
                InvocationTerminated => WorkspaceCommissioningApplyObserved { readback: WorkspaceCommissioningApplyReadback {
                  provenance: provenance, invocation: invocation,
                } }
                _ => WorkspaceCommissioningApplyReadbackRefused { reason: "controller invocation changed or became unreadable during protected readback" }
              } }
            _ => WorkspaceCommissioningApplyReadbackRefused { reason: "commissioning journal is not committed" }
          }
        } }
        _ => WorkspaceCommissioningApplyReadbackRefused { reason: "post-controller sanitation is unreadable" }
      }
    }
  } }
}

// This result is constructed only after independent readback, exact credential removal and
// generation-fenced exclusion release. The enclosing fleet apply still owns its generation gate.
type WorkspaceCommissioningApplyCompleted sole_constructor {
  provenance: WorkspaceCommissioningProvenance
  invocation: NonEmptyStr
}

type WorkspaceCommissioningApplyFinish
  = WorkspaceCommissioningApplyFinished { completed: WorkspaceCommissioningApplyCompleted }
  | WorkspaceCommissioningApplyFinishRefused { reason: String }

fn workspace_commissioning_credential_absent(path: String) -> Bool {
  let read = Filesystem.Read(path: path)
  match filesystem_exact_read(path: path, content: read.content, success: read.success, error: read.error, error_kind: read.error_kind) {
    FilesystemExactPathAbsent { path: _ } => true
    _ => false
  }
}

fn workspace_commissioning_credential_remove(provenance: WorkspaceCommissioningProvenance) -> Bool
  admit_callers: [decl_ref(module_path: "gunbc.workspace_commissioning_apply_readback", decl_name: "workspace_commissioning_apply_finish")]
{
  let path = workspace_launch_credential_source_path(instance: runner_slot_instance_name(slot: provenance.slot) as String)
  let read = Filesystem.Read(path: path)
  match filesystem_exact_read(path: path, content: read.content, success: read.success, error: read.error, error_kind: read.error_kind) {
    FilesystemExactPathAbsent { path: _ } => true
    FilesystemExactPathRead { path: _, content } => if content != (workspace_commissioning_record_text(record: WorkspaceCommissioningPrepared { provenance: provenance }) as String) { false }
      else { match read_store_ownership(path: path) {
        OwnershipRead { ownership: StoreRootOwned } => {
          let removed = Filesystem.Delete(path: path)
          removed.success && workspace_commissioning_credential_absent(path: path)
        }
        _ => false
      } }
    _ => false
  }
}

fn workspace_commissioning_apply_finish(readback: WorkspaceCommissioningApplyReadback,
  lease: WorkspaceSlotMutationLease, release_dir: NonEmptyStr, login: NonEmptyStr,
  network: SlotNetworkSanitationSubject) -> WorkspaceCommissioningApplyFinish {
  let provenance = readback.provenance
  match lease {
    WorkspaceSlotMutationLeaseHeld { held } => if held.key != workspace_slot_mutation_key(slot_key: runner_slot_instance_name(slot: provenance.slot))
      || held.owner != workspace_commissioning_mutation_owner(plan_hash: provenance.plan_hash)
      || !workspace_slot_mutation_still_owned(held: held) {
      WorkspaceCommissioningApplyFinishRefused { reason: "commissioning no longer owns its exact mutation exclusion" }
    } else { match workspace_commissioning_apply_observe(provenance: provenance, release_dir: release_dir,
      login: login, network: network, invocation: readback.invocation) {
      WorkspaceCommissioningApplyReadbackRefused { reason } => WorkspaceCommissioningApplyFinishRefused { reason: reason }
      WorkspaceCommissioningApplyObserved { readback: fresh } => if !workspace_commissioning_credential_remove(provenance: provenance) {
        WorkspaceCommissioningApplyFinishRefused { reason: "canonical commissioning credential could not be removed and read back absent; exclusion retained" }
      } else if !workspace_slot_mutation_still_owned(held: held) {
        WorkspaceCommissioningApplyFinishRefused { reason: "commissioning exclusion changed during credential removal" }
      } else if !workspace_slot_mutation_release_fenced(lease: lease) {
        WorkspaceCommissioningApplyFinishRefused { reason: "commissioning exclusion release is unsettled; recover before reporting FullyApplied" }
      } else { WorkspaceCommissioningApplyFinished { completed: WorkspaceCommissioningApplyCompleted {
        provenance: provenance, invocation: fresh.invocation,
      } } }
    } }
    _ => WorkspaceCommissioningApplyFinishRefused { reason: "commissioning has no exclusive slot mutation authority" }
  }
}

// This entry never starts a controller. The enclosing durable fleet transaction must supply
// its recorded acquired generation and invocation, not infer them from whichever actor is live.
// A still-running, failed or changed invocation refuses through the ordinary strong readback.
fn workspace_commissioning_apply_recover_completed(provenance: WorkspaceCommissioningProvenance,
  acquired: CasGeneration, invocation: NonEmptyStr, release_dir: NonEmptyStr, login: NonEmptyStr,
  network: SlotNetworkSanitationSubject) -> WorkspaceCommissioningApplyFinish {
  match workspace_commissioning_apply_observe(provenance: provenance, release_dir: release_dir,
    login: login, network: network, invocation: invocation) {
    WorkspaceCommissioningApplyReadbackRefused { reason } => WorkspaceCommissioningApplyFinishRefused { reason: reason }
    WorkspaceCommissioningApplyObserved { readback } => {
      let slot_key = runner_slot_instance_name(slot: provenance.slot)
      match workspace_commissioning_mutation_recover(slot_key: slot_key, plan_hash: provenance.plan_hash, acquired: acquired) {
        WorkspaceCommissioningMutationRetained { lease } => workspace_commissioning_apply_finish(
          readback: readback, lease: lease, release_dir: release_dir, login: login, network: network)
        WorkspaceCommissioningMutationReleased => if !workspace_commissioning_credential_absent(
          path: workspace_launch_credential_source_path(instance: slot_key as String)) {
          WorkspaceCommissioningApplyFinishRefused { reason: "released commissioning still has a credential or unreadable credential path" }
        } else { match workspace_commissioning_mutation_recover(slot_key: slot_key,
          plan_hash: provenance.plan_hash, acquired: acquired) {
          WorkspaceCommissioningMutationReleased => WorkspaceCommissioningApplyFinished {
            completed: WorkspaceCommissioningApplyCompleted { provenance: provenance, invocation: readback.invocation },
          }
          _ => WorkspaceCommissioningApplyFinishRefused { reason: "commissioning mutation changed during completed-release recovery" }
        } }
        _ => WorkspaceCommissioningApplyFinishRefused { reason: "recorded commissioning exclusion is absent, changed or unreadable; no recovery authority established" }
      }
    }
  }
}
