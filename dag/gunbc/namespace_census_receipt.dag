module gunbc.namespace_census_receipt

import std.types { String, List }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }

type NamespaceCensusReproductionStep
  = PinCorpusWorktree
  | PrepareScratchDirectories
  | GenerateSyntheticRoot
  | CompileSyntheticRoot
  | ParseDiagnostics
  | DeriveProviderScenarios
  | GroupAmbiguityOccurrences
  | ClassifyOwnerNameText
  | VerifyReceipt

data namespace_census_reproduction_steps: List<NamespaceCensusReproductionStep> = [
  PinCorpusWorktree,
  PrepareScratchDirectories,
  GenerateSyntheticRoot,
  CompileSyntheticRoot,
  ParseDiagnostics,
  DeriveProviderScenarios,
  GroupAmbiguityOccurrences,
  ClassifyOwnerNameText,
  VerifyReceipt,
]

data namespace_census_reproduction_note: String = "The ordered reproduction workflow authority for the pinned namespace census receipt. Each step names an intent; docs/probes/namespace_census_2026-07-31.md currently hand-projects these intents into a shell block. Measurement values and pinned identities remain single-authority in that receipt's summary.json and are checked by VerifyReceipt."

data namespace_census_shell_projection_dissolution_trigger: String = "🟡 dissolve-on: namespace_census_reproduction_steps rendered through the canonical orchestration-to-bash emitter (bash-emit #5828), replacing the hand-authored shell projection in docs/probes/namespace_census_2026-07-31.md without changing the typed step authority"

data namespace_census_shell_projection_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.namespace_census_receipt",
    decl_name: "namespace_census_shell_projection_dissolution_trigger",
    field: WholeDeclaration,
  }
}
