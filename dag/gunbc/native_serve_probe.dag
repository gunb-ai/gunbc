module gunbc.native_serve_probe

import std.types { Int, List, String, Bool, CommitSha }
import std.algebra { Cons, Empty }
import std.process { ProcessExit, ExitSuccess, ExitFailure }
import gunbc.native_serve { native_serve_stuck_exit_code }
import gunbc.serve_liveness {
  observe_serve_liveness, serve_liveness_read_reason, ServeLivenessRead,
  ServeLivenessObserved, ServeLivenessUnreachable, ServeLivenessBodyUnparseable, ServeLivenessBodyNotAnObject,
  ServeLivenessRevisionAbsent, ServeLivenessRevisionDuplicated, ServeLivenessRevisionNotAString,
  ServeLivenessRevisionMalformed
}

// THE READER FOR `gunbc test //gunbc/instruments:native-serve`. The seed host emits and builds
// gunbc.instruments.native_serve_fixture, starts it, writes each request below to a real TCP
// connection exactly as written here, and hands back what came off the wire, unjudged. Every
// verdict is made here: the cases, the expected answers, and what the run established. The host
// decides nothing about a case -- it is the same split gunbc.native_claim_program makes for its
// programs, so the instrument cannot hold on a judgment written in hand Rust.
//
// THE BUDGET CASES RUN LAST because the last one ends the process: four requests that never return are
// each refused at the deadline (with an ordinary request served between them), and the next request
// meets the stuck-worker ceiling and is refused with the 503 before the process exits.
//
// THE THREE TERMINATIONS: success is held; code 1 is a case the service answered wrongly; code 2 is
// no observation (the service never announced, the responses do not join the cases one for one,
// the refused start did not refuse).

data native_serve_probe_not_held_code: Int = 1
data native_serve_probe_no_observation_code: Int = 2

// The release this run launches under. Any 40-hex value; the /livez case reads it back.
fn native_serve_probe_release_revision() -> String {
  "0123456789abcdef0123456789abcdef01234567"
}

// The per-request deadline this run launches under (--request-deadline-ms), short so the budget
// cases cost half a second each. The default deadline is gunbc.native_serve's, not this.
fn native_serve_probe_request_deadline_ms() -> String {
  "500"
}

// The launch the door must refuse BEFORE it binds: a branch name where a revision belongs.
fn native_serve_probe_refused_revision() -> String {
  "main"
}

type NativeServeExpect
  = ExpectBody { status: Int, body: String }
  | ExpectStatus { status: Int }
  | ExpectHeader { status: Int, line: String }
  | ExpectBodyPrefix { status: Int, prefix: String }
  | ExpectLiveness

type NativeServeProbeCase {
  identity: String
  request: String
  expect: NativeServeExpect
}

fn native_serve_probe_cases() -> List<NativeServeProbeCase> {
  [
    NativeServeProbeCase {
      identity: "handler_route_reads_framed_identity",
      request: "GET /hello HTTP/1.1\r\nHost: probe\r\nTailscale-User-Login: alice@example\r\n\r\n",
      expect: ExpectBody { status: 200, body: "hello, alice@example\n" },
    },
    NativeServeProbeCase {
      identity: "handler_route_reads_exactly_the_framed_body",
      request: "POST /echo HTTP/1.1\r\nHost: probe\r\nContent-Length: 11\r\n\r\nhello world",
      expect: ExpectBody { status: 200, body: "hello world" },
    },
    NativeServeProbeCase {
      identity: "handler_refuses_an_unrouted_path",
      request: "GET /nope HTTP/1.1\r\nHost: probe\r\n\r\n",
      expect: ExpectBody { status: 404, body: "no route for GET /nope\n" },
    },
    NativeServeProbeCase {
      identity: "door_refuses_a_duplicated_content_length",
      request: "POST /echo HTTP/1.1\r\nContent-Length: 2\r\ncontent-length: 2\r\n\r\nhi",
      expect: ExpectBody { status: 400, body: "bad request: duplicate Content-Length header\n" },
    },
    NativeServeProbeCase {
      identity: "door_refuses_a_duplicated_identity_header",
      request: "GET /hello HTTP/1.1\r\nTailscale-User-Login: a@x\r\ntailscale-user-login: b@x\r\n\r\n",
      expect: ExpectBody { status: 400, body: "bad request: duplicate Tailscale-User-Login header\n" },
    },
    NativeServeProbeCase {
      identity: "door_refuses_a_target_that_is_not_origin_form",
      request: "GET http://probe/hello HTTP/1.1\r\n\r\n",
      expect: ExpectStatus { status: 400 },
    },
    NativeServeProbeCase {
      identity: "door_refuses_a_body_over_its_limit_before_reading_it",
      request: "POST /echo HTTP/1.1\r\nContent-Length: 2000000\r\n\r\n",
      expect: ExpectStatus { status: 400 },
    },
    NativeServeProbeCase {
      identity: "handler_header_is_written_as_a_typed_field",
      request: "GET /redirect HTTP/1.1\r\n\r\n",
      expect: ExpectHeader { status: 303, line: "Location: /hello" },
    },
    NativeServeProbeCase {
      identity: "door_refuses_to_write_a_header_value_carrying_crlf",
      request: "GET /split-header HTTP/1.1\r\n\r\n",
      expect: ExpectBody { status: 500, body: "the handler's response cannot be written: a header value carries CR, LF or NUL\n" },
    },
    NativeServeProbeCase {
      identity: "door_refuses_to_write_a_content_type_carrying_crlf",
      request: "GET /split-content-type HTTP/1.1\r\n\r\n",
      expect: ExpectBody { status: 500, body: "the handler's response cannot be written: the content type carries CR, LF or NUL\n" },
    },
    NativeServeProbeCase {
      identity: "liveness_is_answered_before_the_handler_and_names_the_release",
      request: "GET /livez HTTP/1.1\r\n\r\n",
      expect: ExpectLiveness,
    },
    NativeServeProbeCase {
      identity: "budget_a_handler_that_never_returns_is_refused_at_the_deadline",
      request: "GET /spin HTTP/1.1\r\n\r\n",
      expect: ExpectBodyPrefix { status: 500, prefix: "the request exceeded its 500 ms deadline" },
    },
    NativeServeProbeCase {
      identity: "budget_a_later_request_is_still_served",
      request: "GET /hello HTTP/1.1\r\nTailscale-User-Login: alice@example\r\n\r\n",
      expect: ExpectBody { status: 200, body: "hello, alice@example\n" },
    },
    NativeServeProbeCase {
      identity: "budget_second_stuck_worker_is_refused",
      request: "GET /spin HTTP/1.1\r\n\r\n",
      expect: ExpectBodyPrefix { status: 500, prefix: "the request exceeded its 500 ms deadline" },
    },
    NativeServeProbeCase {
      identity: "budget_third_stuck_worker_is_refused",
      request: "GET /spin HTTP/1.1\r\n\r\n",
      expect: ExpectBodyPrefix { status: 500, prefix: "the request exceeded its 500 ms deadline" },
    },
    NativeServeProbeCase {
      identity: "budget_fourth_stuck_worker_reaches_the_ceiling",
      request: "GET /spin HTTP/1.1\r\n\r\n",
      expect: ExpectBodyPrefix { status: 500, prefix: "the request exceeded its 500 ms deadline" },
    },
    NativeServeProbeCase {
      identity: "budget_past_the_stuck_worker_ceiling_the_process_refuses_and_exits",
      request: "GET /hello HTTP/1.1\r\nTailscale-User-Login: alice@example\r\n\r\n",
      expect: ExpectBodyPrefix { status: 503, prefix: "service unavailable: 4 requests are still running past their deadline (ceiling 4)" },
    },
  ]
}

// What the host writes, in case order. The host joins responses to cases by this order.
fn native_serve_probe_requests() -> List<String> {
  native_serve_probe_cases() |> map(c => c.request)
}

type NativeServeWire {
  status: Int
  head_lines: List<String>
  body: String
}

// The head binder is re-bound with its type because match-arm binders are not yet typed from the
// scrutinee (gunbc.rung_drop.match_arm_binder_typing_lost_to_lexical_carrier); untyped, the builtin
// split over it refuses as not in scope.
fn native_serve_wire_parse(response: String) -> NativeServeWire? {
  match split(s: response, delimiter: "\r\n\r\n") {
    Cons { head: head, tail: rest } =>
      let head_text: String = head
      let head_lines = split(s: head_text, delimiter: "\r\n")
      let status_text = if starts_with(s: head, prefix: "HTTP/1.1 ") && string_length(s: head) >= 12 {
        substring(s: head, start: 9, end: 12)
      } else {
        ""
      }
      match parse_int(s: status_text) {
        Present { value: status } => NativeServeWire { status: status, head_lines: head_lines, body: join(rest, "\r\n\r\n") }
        Absent => none
      }
    Empty => none
  }
}

fn native_serve_liveness_unread(identity: String, read: ServeLivenessRead) -> String {
  concat(identity, concat(": ", serve_liveness_read_reason(r: read) as String))
}

fn native_serve_liveness_failure(identity: String, read: ServeLivenessRead) -> String {
  match read {
    ServeLivenessObserved { revision: r } =>
      let observed = r as String
      if observed == native_serve_probe_release_revision() { "" }
      else { concat(identity, concat(": /livez names revision ", observed)) }
    ServeLivenessUnreachable { detail: _ } => native_serve_liveness_unread(identity: identity, read: read)
    ServeLivenessBodyUnparseable => native_serve_liveness_unread(identity: identity, read: read)
    ServeLivenessBodyNotAnObject => native_serve_liveness_unread(identity: identity, read: read)
    ServeLivenessRevisionAbsent => native_serve_liveness_unread(identity: identity, read: read)
    ServeLivenessRevisionDuplicated { count: _ } => native_serve_liveness_unread(identity: identity, read: read)
    ServeLivenessRevisionNotAString => native_serve_liveness_unread(identity: identity, read: read)
    ServeLivenessRevisionMalformed { text: _ } => native_serve_liveness_unread(identity: identity, read: read)
  }
}

fn native_serve_case_failure(c: NativeServeProbeCase, response: String) -> String {
  match native_serve_wire_parse(response: response) {
    Absent => concat(c.identity, ": the response is not an HTTP/1.1 status line and body")
    Present { value: w } =>
      match c.expect {
        ExpectBody { status: s, body: b } =>
          if w.status != s { concat(c.identity, concat(": status ", to_string(value: w.status))) }
          else if w.body != b { concat(c.identity, concat(": body [", concat(w.body, "]"))) }
          else { "" }
        ExpectHeader { status: s, line: l } =>
          if w.status != s { concat(c.identity, concat(": status ", to_string(value: w.status))) }
          else if (w.head_lines |> filter(x => x == l) |> count) != 1 { concat(c.identity, concat(": no header line [", concat(l, "]"))) }
          else { "" }
        ExpectBodyPrefix { status: s, prefix: pre } =>
          if w.status != s { concat(c.identity, concat(": status ", to_string(value: w.status))) }
          else if !starts_with(s: w.body, prefix: pre) { concat(c.identity, concat(": body [", concat(w.body, "]"))) }
          else { "" }
        ExpectStatus { status: s } =>
          if w.status != s { concat(c.identity, concat(": status ", to_string(value: w.status))) } else { "" }
        ExpectLiveness =>
          if w.status != 200 { concat(c.identity, concat(": status ", to_string(value: w.status))) } else {
            native_serve_liveness_failure(identity: c.identity, read: observe_serve_liveness(body: w.body))
          }
      }
  }
}

fn native_serve_case_failures(cases: List<NativeServeProbeCase>, responses: List<String>, acc: List<String>) -> List<String>? {
  match cases {
    Empty =>
      match responses {
        Empty => acc
        Cons { head: _, tail: _ } => none
      }
    Cons { head: c, tail: more } =>
      match responses {
        Empty => none
        Cons { head: r, tail: rs } =>
          let f = native_serve_case_failure(c: c, response: r)
          native_serve_case_failures(cases: more, responses: rs, acc: if f == "" { acc } else { acc |> list_push(f) })
      }
  }
}

fn no_observation(reason: String) -> ProcessExit {
  ExitFailure { code: native_serve_probe_no_observation_code, reason: concat("no observation: ", reason) }
}

// announcement: the line the served process printed once bound. responses: one per request, in
// order. refused_status / refused_stderr: the run launched with native_serve_probe_refused_revision.
// served_exit_status: how the served process ended after the last case, as the host observed it
// within a bounded wait (negative when it was still running and had to be killed). The last budget
// case drives it past the stuck-worker ceiling, so it must have exited by itself with the code
// gunbc.native_serve declares -- not merely answered the 503.
fn native_serve_probe_standing(announcement: String, responses: List<String>, refused_status: Int, refused_stderr: String, served_exit_status: Int) -> ProcessExit {
  if !starts_with(s: announcement, prefix: "native-serve listening on ") {
    no_observation(reason: concat("the service did not announce a bound address: ", announcement))
  } else if refused_status != 2 || !starts_with(s: refused_stderr, prefix: "REFUSED: ") {
    ExitFailure { code: native_serve_probe_not_held_code, reason: concat("a launch with a non-revision release was not refused before binding (status ", concat(to_string(value: refused_status), ")")) }
  } else {
    match native_serve_case_failures(cases: native_serve_probe_cases(), responses: responses, acc: []) {
      Absent => no_observation(reason: "the responses do not join the cases one for one")
      Present { value: failures } =>
        if (failures |> count) > 0 {
          ExitFailure { code: native_serve_probe_not_held_code, reason: concat("not held: ", failures |> join(separator: "; ")) }
        } else if served_exit_status != native_serve_stuck_exit_code {
          ExitFailure { code: native_serve_probe_not_held_code, reason: concat("not held: past the stuck-worker ceiling the process did not exit with ", concat(to_string(value: native_serve_stuck_exit_code), concat(" (observed ", concat(to_string(value: served_exit_status), ")")))) }
        } else { ExitSuccess }
    }
  }
}
