
module gunbc.generated_artifact

import gunbc.os_install { HostAutoinstall }
import gunbc.ci.release_bins_consumer_check_location { release_bins_consumer_check_script_directory, release_bins_consumer_check_script_name }
import gunbc.fleet.fleet_intent { ComputeHost }
import product.host_identity { HostIdentity }
import std.algebra { FreeMonoid, contains, for_all }
import v2.std.text { string_eq }

type GeneratedArtifact
  = WitnessFloorYamlArtifact
  | FleetConvergeYamlArtifact
  | MicrovmShakedownYamlArtifact
  | InstrumentDispatchYamlArtifact
  | HealWorkflowYamlArtifact
  | HealPublisherWorkflowYamlArtifact
  | DriftWatchWorkflowYamlArtifact
  | GunbAiPagesWorkflowYamlArtifact
  | BranchRunGrantBrokerWorkflowYamlArtifact
  | HostedRunnerShadowGateYamlArtifact
  | GitignoreArtifact
  | GitattributesArtifact
  | CargoConfigArtifact
  | DesignArtifact
  | DocsArtifact { projection: DocsProjection }
  | GithooksPrePushArtifact
  | GithooksPreCommitArtifact
  | ReleaseBinsConsumerCheckScriptArtifact
  | GeneratedArtifactMergeDriverArtifact
  | RunnerDeployArtifact
  | Stage0CrateLayoutGeneratedDagArtifact
  | Stage0CrateLayoutGeneratedRsArtifact
  | Stage0CratePartitionGeneratedDagArtifact
  | Stage0ExecutableAssemblyGeneratedDagArtifact
  | Stage0LinkedPartitionCratesArtifact
  | SeedRetentionFrontierGeneratedRsArtifact
  | V1InterpreterDispatchGeneratedRsArtifact
  | EvaluationBudgetConsequenceGeneratedRsArtifact
  | ReleaseLocusSeedConstantsGeneratedRsArtifact
  | FileTransportRealizationGeneratedRsArtifact
  | NativeRouteSeedBoundaryGeneratedRsArtifact
  | InstrumentRegistryGeneratedRsArtifact
  | Fci1BoundedExecutionContextArtifact
  | AutoinstallUserDataArtifact { spec: HostAutoinstall }
  | RunnerHostSudoersArtifact { host: HostIdentity }
  | CouponCadQueryProgramArtifact
  | WholeCorpusCompileMeasuredRootDemandsArtifact
  | ApprovalDeviceVectorsArtifact
  | ApproveIosProjectYmlArtifact
  | ApproveIosProtocolSwiftArtifact
  | ApproveIosWireSwiftArtifact
  | ApproveIosProtocolVectorTestsSwiftArtifact
  | ApproveIosEnrolmentMachineSwiftArtifact
  | ApproveIosOperationErrorsSwiftArtifact
  | ApproveIosEnrolmentMachineTestsSwiftArtifact
  | ApproveIosOperationErrorsTestsSwiftArtifact
  | RoadmapAuthorityAcceptedScenarioAcceptanceArtifact
  | RoadmapAuthoritySupersededScenarioAcceptanceArtifact
  | RoadmapAuthoritySupersededScenarioRevocationArtifact
  | RoadmapAuthoritySupersededScenarioRetiredArtifact
  | RoadmapAuthorityAbsentNodeAcceptanceArtifact

type DocsProjection
  = DesignFailureModesProjection
  | DesignRungDropsProjection
  | ContributorOnboardingProjection

data docs_projections: List<DocsProjection> = [DesignFailureModesProjection, DesignRungDropsProjection, ContributorOnboardingProjection]

data docs_projection_directory: String = "docs"

fn docs_projection_name(projection: DocsProjection) -> String {
  match projection {
    DesignFailureModesProjection => "design-failure-modes.md"
    DesignRungDropsProjection => "design-rung-drops.md"
    ContributorOnboardingProjection => "onboarding.md"
  }
}

// THE ROADMAP-AUTHORITY EVENT LOG (five committed JSON files). Each row is ONE file that the hermetic
// witnesses walk with the real Filesystem.List through the floor's checkout carve-out; the bytes are the log's
// own emitter applied to the scenario table in gunbc.roadmap.roadmap_authority_fixture, and the producer row
// names the declaration that produces them. CrossLanguageClientTest is the honest consumer: the stage0
// interpreter -- a different implementation, in Rust, from the .dag model that defines these bytes -- reads
// the file as its oracle for those bytes, and the byte witness reddens drift. That is what this disposition
// is for; a stale commit fails the drift gate here rather than silently passing in the run that reads it.

// CompilerRunInput: the compiler reads the file as a declared input at arm time, before any source
// resolves (gunbc.whole_corpus_compile_demand_projection).
// CargoToolchain: cargo itself reads the file, discovered from the invocation's directory, before
// any target is built (gunbc.repo.cargo_config_emit).
// CrossLanguageClientTest: a client written in another language reads the file as its test oracle
// for bytes this tree defines (gunbc.auth.approval_device_redemption_fixtures, read by the iOS
// app's XCTest), so a stale commit fails the drift gate here rather than silently passing there.
// XcodeProjectGenerator: XcodeGen reads the file on the operator's Mac and writes the Xcode project
// and the target's Info.plist from it (gunbc.approve_ios_project); neither output is committed.
// SwiftCompiler: swiftc, driven by xcodebuild on the operator's Mac, compiles the file into the app
// or its test bundle (gunbc.approve_ios_swift_protocol and its siblings, printed by
// the Swift grammar rows v2.extdeps.languages.swift.rows).
type RepoConsumer
  = GitProtocol
  | CargoToolchain
  | GithubActionsWorkflow
  | ProjectDocumentation
  | HostReconciler
  | CompilerRunInput
  | CrossLanguageClientTest
  | XcodeProjectGenerator
  | SwiftCompiler

type CommitPolicy
  = CommitRequired { consumer: RepoConsumer }
  | NotCommitted

// THE PATH IS A PROJECTION OF ITS PARTS, NOT THE OTHER WAY ROUND. Every row below CONSTRUCTS its
// path from a directory and an entry name -- some literal, some computed from a spec host or a plan
// slug -- and the joined string was the only thing this module published. A consumer that must LIST
// the directory and look for the entry inside that listing therefore had to split the string on its
// last separator, re-deriving by parsing exactly what the construction already knew. That is
// decompose-after-compose: redundant by gunbc.design_argument::minimize_redundancy, and asymmetric in failure, because a
// parse has error cases a construction does not. So artifact_location is the single match and
// artifact_path is derived from it. THE PATH BYTES ARE UNCHANGED and that is load-bearing rather
// than incidental: artifact_path feeds the drift gate's committed-file read, so a change here would
// silently repoint every adjudicated artifact.
//
// WHY THE ROOT DIRECTORY IS `.` AND NOT THE EMPTY STRING. A root-level artifact's directory is the
// repository root, which is a real directory that can be listed; the empty string is not a
// directory at all and would have to be special-cased at every consumer that wants to observe one.
// Carrying `.` means a listing consumer needs no arm for `this artifact has no directory`, and the
// join is the only place that knows the root renders without a prefix.

// THE ROW IS KEYED BY HOST IDENTITY, NOT BY THE DEPLOY ROW, AND THAT IS AN ACYCLICITY FACT RATHER
// THAN A PREFERENCE. gunbc.runner.runner_host_deploy reaches this module transitively
// (runner_host_deploy -> runner_slot_allocation -> ci_failure_class -> merge_admission ->
// commit_workflow -> generated_artifact), so importing the deploy roster here closes the one
// structural law the import graph has (gunbc.design_argument::single_authority) and the compiler refuses it. The identity
// is the same key the deploy dispatch already resolves on, so nothing is lost: the registry names
// the population from the enrollment authority (gunbc.fleet.fleet_intent, which is also what decides
// whether a host takes fleet work at all), and gunbc.generated_artifact_emit -- which sits above
// both -- resolves the identity to its deploy row and REFUSES by name for a host that has none.
//
// THE ENTRY NAME IS THE DROP-IN THE OPERATOR INSTALLS, carried with a .sudoers suffix so a rendered
// file sitting in a provisioning directory is not mistaken for a live system file. It is a literal
// here because every location row in this module is a literal here; the drop-in installs as
// /etc/sudoers.d/gunbc-ghrunner on the executor fleet.
data runner_host_sudoers_artifact_name: String = "gunbc-ghrunner.sudoers"

type ArtifactLocation {
  directory: String
  name: String
}

fn artifact_location(a: GeneratedArtifact) -> ArtifactLocation {
  match a {
    WitnessFloorYamlArtifact => ArtifactLocation { directory: ".github/workflows", name: "witnesses.yml" }
    FleetConvergeYamlArtifact => ArtifactLocation { directory: ".github/workflows", name: "fleet-converge.yml" }
    MicrovmShakedownYamlArtifact => ArtifactLocation { directory: ".github/workflows", name: "microvm-shakedown.yml" }
    InstrumentDispatchYamlArtifact => ArtifactLocation { directory: ".github/workflows", name: "instrument-dispatch.yml" }
    HealWorkflowYamlArtifact => ArtifactLocation { directory: ".github/workflows", name: "heal.yml" }
    HealPublisherWorkflowYamlArtifact => ArtifactLocation { directory: ".github/workflows", name: "heal-publish.yml" }
    DriftWatchWorkflowYamlArtifact => ArtifactLocation { directory: ".github/workflows", name: "drift-watch.yml" }
    GunbAiPagesWorkflowYamlArtifact => ArtifactLocation { directory: ".github/workflows", name: "gunb-ai-pages.yml" }
    BranchRunGrantBrokerWorkflowYamlArtifact => ArtifactLocation { directory: ".github/workflows", name: "branch-run-grant-broker.yml" }
    HostedRunnerShadowGateYamlArtifact => ArtifactLocation { directory: ".github/workflows", name: "hosted-runner-shadow-gate.yml" }
    GitignoreArtifact => ArtifactLocation { directory: ".", name: ".gitignore" }
    GitattributesArtifact => ArtifactLocation { directory: ".", name: ".gitattributes" }
    CargoConfigArtifact => ArtifactLocation { directory: ".cargo", name: "config.toml" }
    DesignArtifact => ArtifactLocation { directory: ".", name: "DESIGN.md" }
    DocsArtifact { projection } => ArtifactLocation { directory: docs_projection_directory, name: docs_projection_name(projection: projection) }
    GithooksPrePushArtifact => ArtifactLocation { directory: ".githooks", name: "pre-push" }
    GithooksPreCommitArtifact => ArtifactLocation { directory: ".githooks", name: "pre-commit" }
    ReleaseBinsConsumerCheckScriptArtifact =>
      ArtifactLocation { directory: release_bins_consumer_check_script_directory, name: release_bins_consumer_check_script_name }
    GeneratedArtifactMergeDriverArtifact => ArtifactLocation { directory: ".githooks", name: "generated-artifact-merge" }
    RunnerDeployArtifact => ArtifactLocation { directory: ".github", name: "fleet-runner-deploy.manifest" }
    CouponCadQueryProgramArtifact =>
      ArtifactLocation { directory: "manufacturing", name: "hole_diameter_ladder_r1.py" }
    // WHERE THIS REPOSITORY COMMITS ITS MEASURED-ROOT DEMANDS PROJECTION: a literal row, like every
    // other row of this match. It is read by the generated-artifact registry that writes the file and
    // by the instrument argv that hands it to a compile (through artifact_path below), so the two
    // cannot name different files. The bytes are rendered by
    // gunbc.whole_corpus_compile_demand_projection, which holds no path of its own.
    WholeCorpusCompileMeasuredRootDemandsArtifact => ArtifactLocation { directory: "tools", name: "whole_corpus_compile_measured_root_demands.json" }
    ApprovalDeviceVectorsArtifact => ArtifactLocation { directory: "dag/test/fixture/approval_device_redemption", name: "vectors.json" }
    ApproveIosProjectYmlArtifact => ArtifactLocation { directory: "apps/approve-ios", name: "project.yml" }
    ApproveIosProtocolSwiftArtifact => ArtifactLocation { directory: "apps/approve-ios/Approve", name: "Protocol.swift" }
    ApproveIosWireSwiftArtifact => ArtifactLocation { directory: "apps/approve-ios/Approve", name: "Wire.swift" }
    ApproveIosProtocolVectorTestsSwiftArtifact => ArtifactLocation { directory: "apps/approve-ios/ApproveTests", name: "ProtocolVectorTests.swift" }
    ApproveIosEnrolmentMachineSwiftArtifact => ArtifactLocation { directory: "apps/approve-ios/Approve", name: "EnrolmentMachine.swift" }
    ApproveIosOperationErrorsSwiftArtifact => ArtifactLocation { directory: "apps/approve-ios/Approve", name: "OperationErrors.swift" }
    ApproveIosEnrolmentMachineTestsSwiftArtifact => ArtifactLocation { directory: "apps/approve-ios/ApproveTests", name: "EnrolmentMachineTests.swift" }
    ApproveIosOperationErrorsTestsSwiftArtifact => ArtifactLocation { directory: "apps/approve-ios/ApproveTests", name: "OperationErrorsTests.swift" }
    RoadmapAuthorityAcceptedScenarioAcceptanceArtifact => ArtifactLocation { directory: "fixtures/roadmap_authority/events/roadmap-authority-scenario-accepted", name: "01-acceptance.json" }
    RoadmapAuthoritySupersededScenarioAcceptanceArtifact => ArtifactLocation { directory: "fixtures/roadmap_authority/events/roadmap-authority-scenario-superseded", name: "01-acceptance.json" }
    RoadmapAuthoritySupersededScenarioRevocationArtifact => ArtifactLocation { directory: "fixtures/roadmap_authority/events/roadmap-authority-scenario-superseded", name: "02-revocation.json" }
    RoadmapAuthoritySupersededScenarioRetiredArtifact => ArtifactLocation { directory: "fixtures/roadmap_authority/events/roadmap-authority-scenario-superseded", name: "03-retired.json" }
    RoadmapAuthorityAbsentNodeAcceptanceArtifact => ArtifactLocation { directory: "fixtures/roadmap_authority/events/roadmap-authority-scenario-absent-node", name: "01-acceptance.json" }
    Stage0CrateLayoutGeneratedDagArtifact => ArtifactLocation { directory: "dag/gunbc/stage0", name: "stage0_crate_layout_generated.dag" }
    Stage0CrateLayoutGeneratedRsArtifact => ArtifactLocation { directory: "src/v1/stage0/src", name: "bootstrap_stage0_crate_layout_generated.rs" }
    Stage0CratePartitionGeneratedDagArtifact => ArtifactLocation { directory: "dag/gunbc/stage0", name: "stage0_crate_partition_generated.dag" }
    Stage0ExecutableAssemblyGeneratedDagArtifact => ArtifactLocation { directory: "dag/gunbc/stage0", name: "stage0_executable_assembly_generated.dag" }
    Stage0LinkedPartitionCratesArtifact => ArtifactLocation { directory: "src/v1/stage0", name: "linked_partition_crates.generated.txt" }
    SeedRetentionFrontierGeneratedRsArtifact => ArtifactLocation { directory: "src/v1/stage0/src", name: "bootstrap_seed_retention_frontier_generated.rs" }
    V1InterpreterDispatchGeneratedRsArtifact => ArtifactLocation { directory: "src/v1/stage0/src", name: "v1_interpreter_dispatch_generated.rs" }
    EvaluationBudgetConsequenceGeneratedRsArtifact => ArtifactLocation { directory: "src/v1/stage0/src", name: "evaluation_budget_consequence_generated.rs" }
    ReleaseLocusSeedConstantsGeneratedRsArtifact => ArtifactLocation { directory: "src/v1/stage0/src", name: "release_locus_seed_constants_generated.rs" }
    FileTransportRealizationGeneratedRsArtifact => ArtifactLocation { directory: "src/v1/stage0/src", name: "gunbc_file_transport_generated.rs" }
    NativeRouteSeedBoundaryGeneratedRsArtifact => ArtifactLocation { directory: "src/v1/stage0/src", name: "native_route_seed_boundary_generated.rs" }
    InstrumentRegistryGeneratedRsArtifact => ArtifactLocation { directory: "src/v1/stage0/src", name: "instrument_registry_generated.rs" }
    Fci1BoundedExecutionContextArtifact => ArtifactLocation { directory: "tools", name: "fabric_ci_fci1_bounded_execution_context.env" }
    AutoinstallUserDataArtifact { spec } =>
      ArtifactLocation { directory: concat("provisioning/", spec.host), name: "user-data" }
    RunnerHostSudoersArtifact { host } =>
      ArtifactLocation {
        directory: concat("provisioning/", host as String),
        name: runner_host_sudoers_artifact_name
      }
  }
}

fn artifact_directory(a: GeneratedArtifact) -> String {
  artifact_location(a: a).directory
}

fn artifact_name(a: GeneratedArtifact) -> String {
  artifact_location(a: a).name
}

fn artifact_path(a: GeneratedArtifact) -> String {
  let l = artifact_location(a: a)
  if l.directory == "." { l.name } else { concat(concat(l.directory, "/"), l.name) }
}

// PLAN MARKDOWN COMMIT DISPOSITION IS `Plan.projection` AND NOTHING ELSE (`gunbc.plan`
// `PlanProjection`). This function reads that field; it does not override it.
// THE COUPON PROGRAM IS GENERATED BUT NOT COMMITTED, because RepoConsumer answers a narrower
// question than "what eventually consumes these bytes": it answers WHY THEY MUST PERSIST IN A GIT
// CHECKOUT. A CAD kernel executing an emitted program establishes no such requirement -- the kernel
// reads a materialized workspace, not a checkout -- so widening this roster for it would conflate
// the program consumer, the solid consumer, the mesh consumer, the slicer and the printer under one
// name. The arm becomes justified only when a concrete workflow says an operator or workstation
// must obtain THIS FILE from a repository checkout; at that point it is narrow
// (FabricationWorkstationCheckout), with a receipt.
//
// NotCommitted does not mean ungeneratable: it excludes the artifact from the committed drift
// population, which is exactly right for a projection whose terminal consumer is a fabrication
// workspace with a pinned kernel rather than this tree.
fn artifact_commit_policy(a: GeneratedArtifact) -> CommitPolicy {
  match a {
    GitignoreArtifact => CommitRequired { consumer: GitProtocol }
    GitattributesArtifact => CommitRequired { consumer: GitProtocol }
    CargoConfigArtifact => CommitRequired { consumer: CargoToolchain }
    GithooksPrePushArtifact => CommitRequired { consumer: GitProtocol }
    GithooksPreCommitArtifact => CommitRequired { consumer: GitProtocol }
    ReleaseBinsConsumerCheckScriptArtifact => CommitRequired { consumer: GithubActionsWorkflow }
    GeneratedArtifactMergeDriverArtifact => CommitRequired { consumer: GitProtocol }
    WitnessFloorYamlArtifact => CommitRequired { consumer: GithubActionsWorkflow }
    FleetConvergeYamlArtifact => CommitRequired { consumer: GithubActionsWorkflow }
    MicrovmShakedownYamlArtifact => CommitRequired { consumer: GithubActionsWorkflow }
    InstrumentDispatchYamlArtifact => CommitRequired { consumer: GithubActionsWorkflow }
    HealWorkflowYamlArtifact => CommitRequired { consumer: GithubActionsWorkflow }
    HealPublisherWorkflowYamlArtifact => CommitRequired { consumer: GithubActionsWorkflow }
    DriftWatchWorkflowYamlArtifact => CommitRequired { consumer: GithubActionsWorkflow }
    GunbAiPagesWorkflowYamlArtifact => CommitRequired { consumer: GithubActionsWorkflow }
    BranchRunGrantBrokerWorkflowYamlArtifact => CommitRequired { consumer: GithubActionsWorkflow }
    HostedRunnerShadowGateYamlArtifact => CommitRequired { consumer: GithubActionsWorkflow }
    DesignArtifact => CommitRequired { consumer: ProjectDocumentation }
    DocsArtifact { projection: _ } => NotCommitted
    RunnerDeployArtifact => NotCommitted
    CouponCadQueryProgramArtifact => NotCommitted
    WholeCorpusCompileMeasuredRootDemandsArtifact => CommitRequired { consumer: CompilerRunInput }
    ApprovalDeviceVectorsArtifact => CommitRequired { consumer: CrossLanguageClientTest }
    ApproveIosProjectYmlArtifact => CommitRequired { consumer: XcodeProjectGenerator }
    ApproveIosProtocolSwiftArtifact => CommitRequired { consumer: SwiftCompiler }
    ApproveIosWireSwiftArtifact => CommitRequired { consumer: SwiftCompiler }
    ApproveIosProtocolVectorTestsSwiftArtifact => CommitRequired { consumer: SwiftCompiler }
    ApproveIosEnrolmentMachineSwiftArtifact => CommitRequired { consumer: SwiftCompiler }
    ApproveIosOperationErrorsSwiftArtifact => CommitRequired { consumer: SwiftCompiler }
    ApproveIosEnrolmentMachineTestsSwiftArtifact => CommitRequired { consumer: SwiftCompiler }
    ApproveIosOperationErrorsTestsSwiftArtifact => CommitRequired { consumer: SwiftCompiler }
    RoadmapAuthorityAcceptedScenarioAcceptanceArtifact => CommitRequired { consumer: CrossLanguageClientTest }
    RoadmapAuthoritySupersededScenarioAcceptanceArtifact => CommitRequired { consumer: CrossLanguageClientTest }
    RoadmapAuthoritySupersededScenarioRevocationArtifact => CommitRequired { consumer: CrossLanguageClientTest }
    RoadmapAuthoritySupersededScenarioRetiredArtifact => CommitRequired { consumer: CrossLanguageClientTest }
    RoadmapAuthorityAbsentNodeAcceptanceArtifact => CommitRequired { consumer: CrossLanguageClientTest }
    Stage0CrateLayoutGeneratedDagArtifact => CommitRequired { consumer: GitProtocol }
    Stage0CrateLayoutGeneratedRsArtifact => CommitRequired { consumer: GitProtocol }
    Stage0CratePartitionGeneratedDagArtifact => CommitRequired { consumer: GitProtocol }
    Stage0ExecutableAssemblyGeneratedDagArtifact => CommitRequired { consumer: GitProtocol }
    Stage0LinkedPartitionCratesArtifact => CommitRequired { consumer: GitProtocol }
    SeedRetentionFrontierGeneratedRsArtifact => CommitRequired { consumer: GitProtocol }
    V1InterpreterDispatchGeneratedRsArtifact => CommitRequired { consumer: GitProtocol }
    EvaluationBudgetConsequenceGeneratedRsArtifact => CommitRequired { consumer: GitProtocol }
    ReleaseLocusSeedConstantsGeneratedRsArtifact => CommitRequired { consumer: GitProtocol }
    FileTransportRealizationGeneratedRsArtifact => CommitRequired { consumer: GitProtocol }
    NativeRouteSeedBoundaryGeneratedRsArtifact => CommitRequired { consumer: GitProtocol }
    InstrumentRegistryGeneratedRsArtifact => CommitRequired { consumer: GitProtocol }
    Fci1BoundedExecutionContextArtifact => CommitRequired { consumer: HostReconciler }
    AutoinstallUserDataArtifact { spec: _ } => NotCommitted
    RunnerHostSudoersArtifact { host: _ } => CommitRequired { consumer: HostReconciler }
  }
}

fn artifact_is_committed(a: GeneratedArtifact) -> Bool {
  match artifact_commit_policy(a: a) {
    CommitRequired { consumer: _ } => true
    NotCommitted => false
  }
}

// THE DOCUMENTATION FAMILY IS THE VARIANT SET, NOT THE COMMIT POLICY. CommitRequired vs
// NotCommitted answers whether a checkout must carry the bytes; this predicate answers whether
// the artifact's only declared consumer is ProjectDocumentation. The two must stay independent
// so a new PlanProjectsCommittedMarkdown row cannot hide from the "only Design stays committed"
// join by also being absent from a hand-written family list.
fn artifact_is_project_documentation(a: GeneratedArtifact) -> Bool {
  match a {
    DesignArtifact => true
    DocsArtifact { projection: _ } => true
    WitnessFloorYamlArtifact => false
    FleetConvergeYamlArtifact => false
    MicrovmShakedownYamlArtifact => false
    InstrumentDispatchYamlArtifact => false
    HealWorkflowYamlArtifact => false
    HealPublisherWorkflowYamlArtifact => false
    DriftWatchWorkflowYamlArtifact => false
    GunbAiPagesWorkflowYamlArtifact => false
    BranchRunGrantBrokerWorkflowYamlArtifact => false
    HostedRunnerShadowGateYamlArtifact => false
    GitignoreArtifact => false
    GitattributesArtifact => false
    CargoConfigArtifact => false
    GithooksPrePushArtifact => false
    GithooksPreCommitArtifact => false
    ReleaseBinsConsumerCheckScriptArtifact => false
    GeneratedArtifactMergeDriverArtifact => false
    RunnerDeployArtifact => false
    Stage0CrateLayoutGeneratedDagArtifact => false
    Stage0CrateLayoutGeneratedRsArtifact => false
    Stage0CratePartitionGeneratedDagArtifact => false
    Stage0ExecutableAssemblyGeneratedDagArtifact => false
    Stage0LinkedPartitionCratesArtifact => false
    SeedRetentionFrontierGeneratedRsArtifact => false
    V1InterpreterDispatchGeneratedRsArtifact => false
    EvaluationBudgetConsequenceGeneratedRsArtifact => false
    ReleaseLocusSeedConstantsGeneratedRsArtifact => false
    FileTransportRealizationGeneratedRsArtifact => false
    NativeRouteSeedBoundaryGeneratedRsArtifact => false
    InstrumentRegistryGeneratedRsArtifact => false
    Fci1BoundedExecutionContextArtifact => false
    AutoinstallUserDataArtifact { spec: _ } => false
    RunnerHostSudoersArtifact { host: _ } => false
    CouponCadQueryProgramArtifact => false
    WholeCorpusCompileMeasuredRootDemandsArtifact => false
    ApprovalDeviceVectorsArtifact => false
    ApproveIosProjectYmlArtifact => false
    ApproveIosProtocolSwiftArtifact => false
    ApproveIosWireSwiftArtifact => false
    ApproveIosProtocolVectorTestsSwiftArtifact => false
    ApproveIosEnrolmentMachineSwiftArtifact => false
    ApproveIosOperationErrorsSwiftArtifact => false
    ApproveIosEnrolmentMachineTestsSwiftArtifact => false
    ApproveIosOperationErrorsTestsSwiftArtifact => false

    RoadmapAuthorityAcceptedScenarioAcceptanceArtifact => false
    RoadmapAuthoritySupersededScenarioAcceptanceArtifact => false
    RoadmapAuthoritySupersededScenarioRevocationArtifact => false
    RoadmapAuthoritySupersededScenarioRetiredArtifact => false
    RoadmapAuthorityAbsentNodeAcceptanceArtifact => false
  }
}

fn artifact_is_commit_required_project_documentation(a: GeneratedArtifact) -> Bool {
  match artifact_commit_policy(a: a) {
    CommitRequired { consumer } => match consumer {
      ProjectDocumentation => true
      GitProtocol => false
      CargoToolchain => false
      GithubActionsWorkflow => false
      HostReconciler => false
      CompilerRunInput => false
      CrossLanguageClientTest => false
      XcodeProjectGenerator => false
      SwiftCompiler => false
    }
    NotCommitted => false
  }
}

fn artifact_eq(a: GeneratedArtifact, b: GeneratedArtifact) -> Bool {
  artifact_path(a: a) == artifact_path(a: b)
}

// THE JOIN KEY: artifact path x producer. The path is what a consumer census finds a v1 reference
// under; the producer is the declaration that census keys the .dag population by. A row is the
// claim "everything in this path was authored at this declaration".



// THE ONE COMMAND AN AUTHOR RUNS TO REGENERATE EVERY COMMITTED PROJECTION. It is named here, beside
// the artifacts it regenerates (moved out of gunbc.ci.ci_spec, gunbc.plans.closure_consolidation P1),
// rather than in each consumer because three places tell an author to run it -- the merge driver's
// refusal recipe, its two witnesses -- and a second spelling would drift from the entry the workflow
// uses.
// It was `ci_heal_author_commit_regen_command` while heal's author-commit arm was its only caller;
// that arm is gone with the push, and the command is not heal's (gunbc#10958).

// WHAT THIS MODULE MUST NOT IMPORT, stated where its lightness is owned. Every importer of this
// registry -- 69 modules today -- pays for this module's whole import closure, so an import that
// serves nothing here is a tax on all of them: the registry once reached the whole-corpus admission
// chain through the measured-root demands RENDERER for two path constants, 695 modules and 2.45 GiB
// of peak RSS for a directory and a file name that artifact_location above now holds as a literal row.
// These two paths are the named heavy side, at identity grain -- a byte or file-count limit would
// drift with unrelated growth and pass a closure that swapped one heavy import for another. Same
// shape as gunbc.roadmap.privileged_helper_closure's declared exclusion, not a second mechanism for
// it. The consumer is test.claim.generated_artifact_closure_witness, whose live claim goes red the
// moment either path is imported here again.
data generated_artifact_forbidden_closure_paths: List<String> = [
  "dag/gunbc/whole_corpus_compile_demand_projection.dag",
  "dag/gunbc/whole_corpus_compile_admission.dag"
]

// Judged on a CLOSURE rather than on this module's own import lines: the closure is what every
// importer pays for, and a transitive edge reaches the heavy side as cheaply as a direct one.
fn generated_artifact_closure_excludes_forbidden(closure: FreeMonoid<String>) -> Bool {
  for_all(xs: closure, predicate: fn(path) { !contains(xs: generated_artifact_forbidden_closure_paths, item: path, eq: string_eq) })
}
