
module gunbc.generated_artifact

import gunbc.os_install { HostAutoinstall, fleet_autoinstall_specs }
import gunbc.plan { Plan, plan_doc_directory, plan_doc_name, PlanProjectsCommittedMarkdown, PlanIsAuthorityOnly }
import gunbc.plan_registry { all_plans }
import gunbc.generated_artifact_merge_driver { generated_artifact_merge_driver_script_directory, generated_artifact_merge_driver_script_name }
import gunbc.fleet_intent { ComputeHost, fleet_intent_known_hosts }
import product.placement_supply { HostIdentity }
import std.decl_ref { DeclarationRef, decl_ref, declaration_ref_display_key }
import v2.std.decl_ref_resolution {
  DeclarationRefResolution,
  declaration_ref_resolution_is_resolved, declaration_ref_resolution_arm_key,
  resolve_declaration_ref_live
}

type GeneratedArtifact
  = WitnessFloorYamlArtifact
  | FleetConvergeYamlArtifact
  | FleetDesiredAdmissionYamlArtifact
  | GitignoreArtifact
  | GitattributesArtifact
  | RoadmapArtifact
  | DesignArtifact
  | DesignFailureModesArtifact
  | DesignRungDropsArtifact
  | GithooksPrePushArtifact
  | GithooksPreCommitArtifact
  | GeneratedArtifactMergeDriverArtifact
  | RunnerDeployArtifact
  | Stage0CrateLayoutGeneratedDagArtifact
  | Stage0CrateLayoutGeneratedRsArtifact
  | Stage0CratePartitionGeneratedDagArtifact
  | Stage0ExecutableAssemblyGeneratedDagArtifact
  | SeedRetentionFrontierGeneratedRsArtifact
  | V1InterpreterDispatchGeneratedRsArtifact
  | EvaluationBudgetConsequenceGeneratedRsArtifact
  | FileTransportRealizationGeneratedRsArtifact
  | Fci1BoundedExecutionContextArtifact
  | AutoinstallUserDataArtifact { spec: HostAutoinstall }
  | RunnerHostSudoersArtifact { host: HostIdentity }
  | PlanArtifact { plan: Plan }
  | CouponCadQueryProgramArtifact

data generated_artifact_registry: List<GeneratedArtifact> = concat(
  concat(
    concat(
      [WitnessFloorYamlArtifact, FleetConvergeYamlArtifact, FleetDesiredAdmissionYamlArtifact, GitignoreArtifact, GitattributesArtifact, RoadmapArtifact, DesignArtifact, DesignFailureModesArtifact, DesignRungDropsArtifact, GithooksPrePushArtifact, GithooksPreCommitArtifact, GeneratedArtifactMergeDriverArtifact, RunnerDeployArtifact, Stage0CrateLayoutGeneratedDagArtifact, Stage0CrateLayoutGeneratedRsArtifact, Stage0CratePartitionGeneratedDagArtifact, Stage0ExecutableAssemblyGeneratedDagArtifact, SeedRetentionFrontierGeneratedRsArtifact, V1InterpreterDispatchGeneratedRsArtifact, EvaluationBudgetConsequenceGeneratedRsArtifact, CouponCadQueryProgramArtifact, Fci1BoundedExecutionContextArtifact, FileTransportRealizationGeneratedRsArtifact],
      map(fleet_autoinstall_specs, s => AutoinstallUserDataArtifact { spec: s })
    ),
    map(fleet_intent_known_hosts, h => RunnerHostSudoersArtifact { host: h.identity })
  ),
  map(all_plans, pl => PlanArtifact { plan: pl })
)

type RepoConsumer
  = GitProtocol
  | GithubActionsWorkflow
  | ProjectDocumentation
  | HostReconciler

type CommitPolicy
  = CommitRequired { consumer: RepoConsumer }
  | NotCommitted

// WHO REPAIRS A CONCURRENTLY-DIVERGED PROJECTION IS NOT ITS COMMIT POLICY. Both kinds below stay
// committed, stay in the generated-artifact drift population, and stay protected by the refusing
// merge driver. This axis answers only who pays to derive the merged authorities after that driver
// has done its job.
//
// The rung-drop ledger remains the exceptional committed projection whose authority is a
// small authored append while the projection is unbounded. Requiring every lane to run the
// whole-tree regenerator before it can finish an otherwise mechanical merge puts that shared
// projection on every lane's critical path. heal-generated-artifacts already checks out the
// pushed branch head, derives every committed artifact from that head's authorities, commits
// the result. So for that artifact heal
// IS the route, not one of two: this arm is what the selector returns and what the emitted recipe
// instructs, and no value in this module means "either actuator". THAT EXCLUSIVITY IS THE MODELED
// POLICY AND IS ASSERTED IN BOTH DIRECTIONS by
// gunbc.test.claim.generated_artifact_assessment_witness_test
// `only_design_ledgers_delegate_concurrent_regeneration_to_heal`.
//
// The failure-mode ledger is no longer in this pair: its committed projection was the merge
// hotspot, so it is NotCommitted (generated on demand) and its membership list is derived from
// the row directory rather than hand-appended. Independent failure-mode appends do not share
// a committed merge region.
//
// THE PROVISIONAL BYTES ARE THE BASE-SIDE PROJECTION, NEVER THE DRIVER-LEFT WORKTREE BYTES. This
// sentence previously said ours, which is the action gunbc.generated_artifact_merge_driver measured
// as row-deleting across four heads and now instructs against in its own step 1: the driver leaves
// the ours side in the worktree, so staging it commits this branch's rows over the base's and drops
// every row the base added since the merge base. Taking the base side is not a resolution either --
// it leaves the tree authority-ahead-of-artifact by exactly this branch's rows, which is the state
// heal exists to close -- but it is preservation-safe, and that is the whole requirement on a
// provisional head.
//
// THE ORDERING IS THE INVARIANT, and it is what both actuators owe -- "who runs the regenerator" is
// an actuator choice, while deriving against a pre-merge branch is a defect either one can commit:
// preserve the base-side projection, complete the authored-authority merge, publish that as H0,
// heal derives the projection from H0's AUTHORITIES, publish H1, verify H1. DERIVE ONLY AFTER THE
// INTEGRATED AUTHORITY STATE EXISTS AS THE SUBJECT.
// The required generated-artifact phase remains unchanged: it may red on H0 and must agree on H1.
//
// Every other artifact retains AuthorRegeneratesBeforeMerge. In particular this is not inferred
// from ProjectDocumentation: DESIGN.md and ROADMAP.md do not share the ledger's append/content
// asymmetry, and widening by consumer would silently move future documents onto a repair route
// nobody judged for them.
type ConcurrentDivergenceRepair
  = AuthorRegeneratesBeforeMerge
  | HealRegeneratesAfterProvisionalMerge

fn concurrent_divergence_repair(a: GeneratedArtifact) -> ConcurrentDivergenceRepair {
  match a {
    DesignRungDropsArtifact => HealRegeneratesAfterProvisionalMerge
    _ => AuthorRegeneratesBeforeMerge
  }
}

fn heal_regenerated_after_provisional_merge_artifacts() -> List<GeneratedArtifact> {
  filter(generated_artifact_registry, a => match concurrent_divergence_repair(a: a) {
    AuthorRegeneratesBeforeMerge => false
    HealRegeneratesAfterProvisionalMerge => true
  })
}

fn heal_regenerated_after_provisional_merge_paths() -> List<String> {
  map(heal_regenerated_after_provisional_merge_artifacts(), a => artifact_path(a: a))
}

// THE PATH IS A PROJECTION OF ITS PARTS, NOT THE OTHER WAY ROUND. Every row below CONSTRUCTS its
// path from a directory and an entry name -- some literal, some computed from a spec host or a plan
// slug -- and the joined string was the only thing this module published. A consumer that must LIST
// the directory and look for the entry inside that listing therefore had to split the string on its
// last separator, re-deriving by parsing exactly what the construction already knew. That is
// decompose-after-compose: redundant by DESIGN section 2, and asymmetric in failure, because a
// parse has error cases a construction does not. So artifact_location is the single match and
// artifact_path is derived from it. THE PATH BYTES ARE UNCHANGED and that is load-bearing rather
// than incidental: artifact_path feeds the drift gate's committed-file read, so a change here would
// silently repoint every adjudicated artifact.
//
// WHY THE ROOT DIRECTORY IS `.` AND NOT THE EMPTY STRING. A root-level artifact's directory is the
// repository root, which is a real directory that can be listed; the empty string is not a
// directory at all and would have to be special-cased at every consumer that wants to observe one.
// Carrying `.` means a listing consumer needs no arm for `this artifact has no directory`, and the
// join is the only place that knows the root renders without a prefix.

// THE ROW IS KEYED BY HOST IDENTITY, NOT BY THE DEPLOY ROW, AND THAT IS AN ACYCLICITY FACT RATHER
// THAN A PREFERENCE. gunbc.runner_host_deploy reaches this module transitively
// (runner_host_deploy -> runner_slot_allocation -> ci_failure_class -> merge_admission ->
// commit_workflow -> generated_artifact), so importing the deploy roster here closes the one
// structural law the import graph has (DESIGN section 3) and the compiler refuses it. The identity
// is the same key the deploy dispatch already resolves on, so nothing is lost: the registry names
// the population from the enrollment authority (gunbc.fleet_intent, which is also what decides
// whether a host takes fleet work at all), and gunbc.generated_artifact_emit -- which sits above
// both -- resolves the identity to its deploy row and REFUSES by name for a host that has none.
//
// THE ENTRY NAME IS THE DROP-IN THE OPERATOR INSTALLS, carried with a .sudoers suffix so a rendered
// file sitting in a provisioning directory is not mistaken for a live system file. It is a literal
// here because every location row in this module is a literal here; the drop-in installs as
// /etc/sudoers.d/gunbc-ghrunner on the executor fleet.
data runner_host_sudoers_artifact_name: String = "gunbc-ghrunner.sudoers"

type ArtifactLocation {
  directory: String
  name: String
}

fn artifact_location(a: GeneratedArtifact) -> ArtifactLocation {
  match a {
    WitnessFloorYamlArtifact => ArtifactLocation { directory: ".github/workflows", name: "witnesses.yml" }
    FleetConvergeYamlArtifact => ArtifactLocation { directory: ".github/workflows", name: "fleet-converge.yml" }
    FleetDesiredAdmissionYamlArtifact => ArtifactLocation { directory: ".github/workflows", name: "fleet-desired.yml" }
    GitignoreArtifact => ArtifactLocation { directory: ".", name: ".gitignore" }
    GitattributesArtifact => ArtifactLocation { directory: ".", name: ".gitattributes" }
    RoadmapArtifact => ArtifactLocation { directory: ".", name: "ROADMAP.md" }
    DesignArtifact => ArtifactLocation { directory: ".", name: "DESIGN.md" }
    DesignFailureModesArtifact => ArtifactLocation { directory: "docs", name: "design-failure-modes.md" }
    DesignRungDropsArtifact => ArtifactLocation { directory: "docs", name: "design-rung-drops.md" }
    GithooksPrePushArtifact => ArtifactLocation { directory: ".githooks", name: "pre-push" }
    GithooksPreCommitArtifact => ArtifactLocation { directory: ".githooks", name: "pre-commit" }
    GeneratedArtifactMergeDriverArtifact =>
      ArtifactLocation {
        directory: generated_artifact_merge_driver_script_directory,
        name: generated_artifact_merge_driver_script_name
      }
    RunnerDeployArtifact => ArtifactLocation { directory: ".github", name: "fleet-runner-deploy.manifest" }
    CouponCadQueryProgramArtifact =>
      ArtifactLocation { directory: "manufacturing", name: "hole_diameter_ladder_r1.py" }
    Stage0CrateLayoutGeneratedDagArtifact => ArtifactLocation { directory: "dag/gunbc/stage0", name: "stage0_crate_layout_generated.dag" }
    Stage0CrateLayoutGeneratedRsArtifact => ArtifactLocation { directory: "src/v1/stage0/src", name: "bootstrap_stage0_crate_layout_generated.rs" }
    Stage0CratePartitionGeneratedDagArtifact => ArtifactLocation { directory: "dag/gunbc/stage0", name: "stage0_crate_partition_generated.dag" }
    Stage0ExecutableAssemblyGeneratedDagArtifact => ArtifactLocation { directory: "dag/gunbc/stage0", name: "stage0_executable_assembly_generated.dag" }
    SeedRetentionFrontierGeneratedRsArtifact => ArtifactLocation { directory: "src/v1/stage0/src", name: "bootstrap_seed_retention_frontier_generated.rs" }
    V1InterpreterDispatchGeneratedRsArtifact => ArtifactLocation { directory: "src/v1/stage0/src", name: "v1_interpreter_dispatch_generated.rs" }
    EvaluationBudgetConsequenceGeneratedRsArtifact => ArtifactLocation { directory: "src/v1/stage0/src", name: "evaluation_budget_consequence_generated.rs" }
    FileTransportRealizationGeneratedRsArtifact => ArtifactLocation { directory: "src/v1/stage0/src", name: "gunbc_file_transport_generated.rs" }
    Fci1BoundedExecutionContextArtifact => ArtifactLocation { directory: "tools", name: "fabric_ci_fci1_bounded_execution_context.env" }
    AutoinstallUserDataArtifact { spec } =>
      ArtifactLocation { directory: concat("provisioning/", spec.host), name: "user-data" }
    RunnerHostSudoersArtifact { host } =>
      ArtifactLocation {
        directory: concat("provisioning/", host as String),
        name: runner_host_sudoers_artifact_name
      }
    PlanArtifact { plan } =>
      ArtifactLocation { directory: plan_doc_directory, name: plan_doc_name(slug: plan.slug) }
  }
}

fn artifact_directory(a: GeneratedArtifact) -> String {
  artifact_location(a: a).directory
}

fn artifact_name(a: GeneratedArtifact) -> String {
  artifact_location(a: a).name
}

fn artifact_path(a: GeneratedArtifact) -> String {
  let l = artifact_location(a: a)
  if l.directory == "." { l.name } else { concat(concat(l.directory, "/"), l.name) }
}

// THE PLAN DECIDES ITS OWN ARM, NOT THIS ROW. A plan whose markdown the repository removed on
// purpose (gunbc.plan PlanIsAuthorityOnly) is still rostered, still generated, and still refused
// if its generation refuses -- it is simply not expected on disk. Answering CommitRequired for
// every plan is what let a deleted projection read as an absent one, and once a drift phase
// adjudicates the population that reads as an obligation to recreate the deleted file.
// THE COUPON PROGRAM IS GENERATED BUT NOT COMMITTED, because RepoConsumer answers a narrower
// question than "what eventually consumes these bytes": it answers WHY THEY MUST PERSIST IN A GIT
// CHECKOUT. A CAD kernel executing an emitted program establishes no such requirement -- the kernel
// reads a materialized workspace, not a checkout -- so widening this roster for it would conflate
// the program consumer, the solid consumer, the mesh consumer, the slicer and the printer under one
// name. The arm becomes justified only when a concrete workflow says an operator or workstation
// must obtain THIS FILE from a repository checkout; at that point it is narrow
// (FabricationWorkstationCheckout), with a receipt.
//
// NotCommitted does not mean ungeneratable: it excludes the artifact from the committed drift
// population, which is exactly right for a projection whose terminal consumer is a fabrication
// workspace with a pinned kernel rather than this tree.
fn artifact_commit_policy(a: GeneratedArtifact) -> CommitPolicy {
  match a {
    GitignoreArtifact => CommitRequired { consumer: GitProtocol }
    GitattributesArtifact => CommitRequired { consumer: GitProtocol }
    GithooksPrePushArtifact => CommitRequired { consumer: GitProtocol }
    GithooksPreCommitArtifact => CommitRequired { consumer: GitProtocol }
    GeneratedArtifactMergeDriverArtifact => CommitRequired { consumer: GitProtocol }
    WitnessFloorYamlArtifact => CommitRequired { consumer: GithubActionsWorkflow }
    FleetConvergeYamlArtifact => CommitRequired { consumer: GithubActionsWorkflow }
    FleetDesiredAdmissionYamlArtifact => CommitRequired { consumer: GithubActionsWorkflow }
    RoadmapArtifact => CommitRequired { consumer: ProjectDocumentation }
    DesignArtifact => CommitRequired { consumer: ProjectDocumentation }
    DesignFailureModesArtifact => NotCommitted
    DesignRungDropsArtifact => CommitRequired { consumer: ProjectDocumentation }
    PlanArtifact { plan } =>
      match plan.projection {
        PlanProjectsCommittedMarkdown => CommitRequired { consumer: ProjectDocumentation }
        PlanIsAuthorityOnly { ruling: _ } => NotCommitted
      }
    RunnerDeployArtifact => NotCommitted
    CouponCadQueryProgramArtifact => NotCommitted
    Stage0CrateLayoutGeneratedDagArtifact => CommitRequired { consumer: GitProtocol }
    Stage0CrateLayoutGeneratedRsArtifact => CommitRequired { consumer: GitProtocol }
    Stage0CratePartitionGeneratedDagArtifact => CommitRequired { consumer: GitProtocol }
    Stage0ExecutableAssemblyGeneratedDagArtifact => CommitRequired { consumer: GitProtocol }
    SeedRetentionFrontierGeneratedRsArtifact => CommitRequired { consumer: GitProtocol }
    V1InterpreterDispatchGeneratedRsArtifact => CommitRequired { consumer: GitProtocol }
    EvaluationBudgetConsequenceGeneratedRsArtifact => CommitRequired { consumer: GitProtocol }
    FileTransportRealizationGeneratedRsArtifact => CommitRequired { consumer: GitProtocol }
    Fci1BoundedExecutionContextArtifact => CommitRequired { consumer: HostReconciler }
    AutoinstallUserDataArtifact { spec: _ } => NotCommitted
    RunnerHostSudoersArtifact { host: _ } => CommitRequired { consumer: HostReconciler }
  }
}

fn artifact_is_committed(a: GeneratedArtifact) -> Bool {
  match artifact_commit_policy(a: a) {
    CommitRequired { consumer: _ } => true
    NotCommitted => false
  }
}

fn committed_generated_artifacts() -> List<GeneratedArtifact> {
  filter(generated_artifact_registry, a => artifact_is_committed(a: a))
}

fn committed_generated_artifact_paths() -> List<String> {
  map(committed_generated_artifacts(), a => artifact_path(a: a))
}

// Disposition authority (reference only; do not fork the lifecycle here):
// gunbc.non_fold_residue.non_fold_residue_frontier enrolls
// dag/gunbc/generated_artifact.dag::artifact_eq with the typed nfr_reason_land_red_era reason and
// nfr_dissolve_owning_fold trigger. The live non_fold_residue_clean_holds witness refuses both an
// unrostered predicate and a stale roster row; its synthetic malformed-row RED witnesses that
// reason without a dissolution trigger is invalid. This equality residue therefore grows only under
// that one bounded census row and deletes when the owning fold derives equality from inhabitance.

fn artifact_eq(a: GeneratedArtifact, b: GeneratedArtifact) -> Bool {
  match a {
    WitnessFloorYamlArtifact => match b { WitnessFloorYamlArtifact => true  _ => false }
    FleetConvergeYamlArtifact => match b { FleetConvergeYamlArtifact => true  _ => false }
    FleetDesiredAdmissionYamlArtifact => match b { FleetDesiredAdmissionYamlArtifact => true  _ => false }
    GitignoreArtifact => match b { GitignoreArtifact => true  _ => false }
    GitattributesArtifact => match b { GitattributesArtifact => true  _ => false }
    RoadmapArtifact => match b { RoadmapArtifact => true  _ => false }
    DesignArtifact => match b { DesignArtifact => true  _ => false }
    DesignFailureModesArtifact => match b { DesignFailureModesArtifact => true  _ => false }
    DesignRungDropsArtifact => match b { DesignRungDropsArtifact => true  _ => false }
    GithooksPrePushArtifact => match b { GithooksPrePushArtifact => true  _ => false }
    GithooksPreCommitArtifact => match b { GithooksPreCommitArtifact => true  _ => false }
    GeneratedArtifactMergeDriverArtifact => match b { GeneratedArtifactMergeDriverArtifact => true  _ => false }
    RunnerDeployArtifact => match b { RunnerDeployArtifact => true  _ => false }
    CouponCadQueryProgramArtifact => match b { CouponCadQueryProgramArtifact => true  _ => false }
    Stage0CrateLayoutGeneratedDagArtifact => match b { Stage0CrateLayoutGeneratedDagArtifact => true  _ => false }
    Stage0CrateLayoutGeneratedRsArtifact => match b { Stage0CrateLayoutGeneratedRsArtifact => true  _ => false }
    Stage0CratePartitionGeneratedDagArtifact => match b { Stage0CratePartitionGeneratedDagArtifact => true  _ => false }
    Stage0ExecutableAssemblyGeneratedDagArtifact => match b { Stage0ExecutableAssemblyGeneratedDagArtifact => true  _ => false }
    SeedRetentionFrontierGeneratedRsArtifact => match b { SeedRetentionFrontierGeneratedRsArtifact => true  _ => false }
    V1InterpreterDispatchGeneratedRsArtifact => match b { V1InterpreterDispatchGeneratedRsArtifact => true  _ => false }
    EvaluationBudgetConsequenceGeneratedRsArtifact => match b { EvaluationBudgetConsequenceGeneratedRsArtifact => true  _ => false }
    FileTransportRealizationGeneratedRsArtifact => match b { FileTransportRealizationGeneratedRsArtifact => true  _ => false }
    Fci1BoundedExecutionContextArtifact => match b { Fci1BoundedExecutionContextArtifact => true  _ => false }
    AutoinstallUserDataArtifact { spec } => match b { AutoinstallUserDataArtifact { spec: spec2 } => spec.host == spec2.host  _ => false }
    RunnerHostSudoersArtifact { host } => match b { RunnerHostSudoersArtifact { host: host2 } => (host as String) == (host2 as String)  _ => false }
    PlanArtifact { plan } => match b { PlanArtifact { plan: plan2 } => plan.slug == plan2.slug  _ => false }
  }
}

fn registry_contains(a: GeneratedArtifact) -> Bool {
  any(generated_artifact_registry, x => artifact_eq(a: x, b: a))
}

// THE PRODUCER OF EACH ARTIFACT, AS A DECLARATION REFERENCE. Every artifact rostered above is a
// projection of one .dag declaration -- the `expected_*` function gunbc.generated_artifact_emit
// artifact_generate_unadorned dispatches to -- and that declaration is where a v1 reference inside
// the artifact is AUTHORED: a `target/release/gunbc` argv in witnesses.yml is a literal in
// gunbc.witness_floor_workflow, not a fact about the YAML. So the workflow YAML, .gitattributes, the
// git hooks and the committed stage0 mirrors are not four consumer media with no declaration
// identity (gunbc.v1_consumer_census ConsumerMedium WorkflowArgv, GitHookScript,
// CommittedGeneratedMirror): each is the .dag medium seen through a producer, and a consumer census
// that keys the .dag population at declaration grain already holds their rows. What that reduction
// needs to be SOUND is exactly this map plus the join below: an artifact whose producer is not a
// declaration in the .dag population would be a generated file whose v1 references no declaration
// join can see, and it has to refuse by name rather than be swept by a second scanner -- a scanner
// would rediscover the same relation under a path key and double-count the blocking column.
//
// This map and the emit dispatch are one fact spelled twice, and that is stated rather than hidden:
// the dispatch CALLS the producer, this row NAMES it, and the substrate has no reflection from a
// call site to a DeclarationRef that would let one be derived from the other. The join below checks
// that every name here resolves; it does not check that the name is the one the dispatch calls.
// That second half is decidable -- a fold over artifact_generate_unadorned's match arms pairing each
// variant with the call target it reaches -- and is this class's next-rung trigger, not a ceiling.
//
// WHO CONSUMES THE JOIN, AND WHEN (DESIGN section 3c, a declared frontier). Today the executing
// consumer is test.claim.generated_artifact_producer_coverage_witness_test on the required floor,
// which refuses a push that leaves any registry row's producer unresolvable. The census-side
// consumer is gunbc.v1_consumer_census v1_consumer_population_for: it may count WorkflowArgv,
// GitHookScript, CommittedGeneratedMirror and the .gitattributes rows as JOINED media only when
// every_generated_artifact_producer_covered holds over the same pool roots its .dag-medium producer
// folds, and must otherwise stay PopulationMeasuredLowerBound. That read lands in the change that
// gives the census a per-medium joined_media state (PR #10939, tools.v1_consumer_discovery); it is
// not authored here because the census on main carries no such state yet, and adding one beside
// that in-flight change would be the second vocabulary section 3 forbids. Trigger: #10939 merged.
fn artifact_producer(a: GeneratedArtifact) -> DeclarationRef {
  match a {
    WitnessFloorYamlArtifact => decl_ref(module_path: "gunbc.witness_floor_workflow", decl_name: "expected_witness_floor_yml")
    FleetConvergeYamlArtifact => decl_ref(module_path: "gunbc.fleet_converge_workflow", decl_name: "expected_fleet_converge_yml")
    FleetDesiredAdmissionYamlArtifact => decl_ref(module_path: "gunbc.fleet_desired_admission_workflow", decl_name: "expected_fleet_desired_yml")
    GitignoreArtifact => decl_ref(module_path: "gunbc.gitignore_emit", decl_name: "expected_gitignore")
    GitattributesArtifact => decl_ref(module_path: "gunbc.gitattributes_emit", decl_name: "expected_gitattributes")
    RoadmapArtifact => decl_ref(module_path: "gunbc.roadmap_authority", decl_name: "expected_roadmap_md")
    DesignArtifact => decl_ref(module_path: "gunbc.design_document", decl_name: "expected_design_md")
    DesignFailureModesArtifact => decl_ref(module_path: "gunbc.design_ledgers", decl_name: "expected_design_failure_modes_md")
    DesignRungDropsArtifact => decl_ref(module_path: "gunbc.design_ledgers", decl_name: "expected_design_rung_drops_md")
    GithooksPrePushArtifact => decl_ref(module_path: "gunbc.githooks_pre_push_emit", decl_name: "expected_githooks_pre_push_sh")
    GithooksPreCommitArtifact => decl_ref(module_path: "gunbc.githooks_pre_commit_emit", decl_name: "expected_githooks_pre_commit_sh")
    GeneratedArtifactMergeDriverArtifact => decl_ref(module_path: "gunbc.generated_artifact_merge_driver", decl_name: "expected_generated_artifact_merge_driver_sh")
    RunnerDeployArtifact => decl_ref(module_path: "gunbc.runner_deploy_emit", decl_name: "expected_runner_deploy_manifest")
    CouponCadQueryProgramArtifact => decl_ref(module_path: "product.printed_chassis.cadquery_realization", decl_name: "expected_coupon_cadquery_program")
    Stage0CrateLayoutGeneratedDagArtifact => decl_ref(module_path: "gunbc.stage0_crate_layout_emit", decl_name: "expected_stage0_crate_layout_generated_dag")
    Stage0CrateLayoutGeneratedRsArtifact => decl_ref(module_path: "gunbc.stage0_crate_layout_emit", decl_name: "expected_stage0_crate_layout_generated_rs")
    Stage0CratePartitionGeneratedDagArtifact => decl_ref(module_path: "gunbc.stage0_crate_partition_emit", decl_name: "expected_stage0_crate_partition_generated_dag")
    Stage0ExecutableAssemblyGeneratedDagArtifact => decl_ref(module_path: "gunbc.stage0_executable_assembly_emit", decl_name: "expected_stage0_executable_assembly_generated_dag")
    SeedRetentionFrontierGeneratedRsArtifact => decl_ref(module_path: "gunbc.seed_retention_frontier_emit", decl_name: "expected_seed_retention_frontier_generated_rs")
    V1InterpreterDispatchGeneratedRsArtifact => decl_ref(module_path: "gunbc.v1_interpreter_dispatch_emit", decl_name: "expected_v1_interpreter_dispatch_generated_rs")
    EvaluationBudgetConsequenceGeneratedRsArtifact => decl_ref(module_path: "gunbc.evaluation_budget_consequence_emit", decl_name: "expected_evaluation_budget_consequence_generated_rs")
    FileTransportRealizationGeneratedRsArtifact => decl_ref(module_path: "extdeps.filesystem.rust_realization", decl_name: "expected_gunbc_file_transport_generated_rs")
    Fci1BoundedExecutionContextArtifact => decl_ref(module_path: "gunbc.fci1_bounded_execution_context_emit", decl_name: "expected_fci1_bounded_execution_context_env")
    AutoinstallUserDataArtifact { spec: _ } => decl_ref(module_path: "gunbc.os_install_emit", decl_name: "autoinstall_user_data")
    RunnerHostSudoersArtifact { host: _ } => decl_ref(module_path: "gunbc.runner_host_grants", decl_name: "runner_host_sudoers_content")
    PlanArtifact { plan: _ } => decl_ref(module_path: "gunbc.plan", decl_name: "expected_plan_md")
  }
}

// THE JOIN KEY: artifact path x producer. The path is what a consumer census finds a v1 reference
// under; the producer is the declaration that census keys the .dag population by. A row is the
// claim "everything in this path was authored at this declaration".
type GeneratedArtifactProducerRow {
  artifact_path: String
  producer: DeclarationRef
}

fn artifact_producer_row(a: GeneratedArtifact) -> GeneratedArtifactProducerRow {
  GeneratedArtifactProducerRow { artifact_path: artifact_path(a: a), producer: artifact_producer(a: a) }
}

fn generated_artifact_producer_rows() -> List<GeneratedArtifactProducerRow> {
  map(generated_artifact_registry, a => artifact_producer_row(a: a))
}

// THE COVERAGE VERDICT, ONE PER ROW, AND THE REFUSAL IS THE RESOLVER'S OWN ARM. The producer is
// resolved by v2.std.decl_ref_resolution -- module absent, declaration absent, field absent,
// ambiguous, or resolved -- against the live tree by key, so a producer that has been renamed,
// moved to another module or deleted refuses with the arm that says which, and the artifact path it
// leaves uncovered is carried beside it. Nothing here scans the artifact's bytes: the question is
// whether the declaration join REACHES this artifact, not what the artifact contains.
type GeneratedArtifactProducerCoverage
  = GeneratedArtifactProducerCovered { row: GeneratedArtifactProducerRow }
  | GeneratedArtifactProducerUncovered { row: GeneratedArtifactProducerRow, resolution: DeclarationRefResolution }

fn generated_artifact_producer_coverage_of(row: GeneratedArtifactProducerRow, resolution: DeclarationRefResolution) -> GeneratedArtifactProducerCoverage {
  if declaration_ref_resolution_is_resolved(resolution: resolution) {
    GeneratedArtifactProducerCovered { row: row }
  } else {
    GeneratedArtifactProducerUncovered { row: row, resolution: resolution }
  }
}

fn generated_artifact_producer_coverage_row(row: GeneratedArtifactProducerRow, pool_roots: List<String>) -> GeneratedArtifactProducerCoverage {
  generated_artifact_producer_coverage_of(
    row: row,
    resolution: resolve_declaration_ref_live(ref: row.producer, pool_roots: pool_roots)
  )
}

fn generated_artifact_producer_coverage_over(rows: List<GeneratedArtifactProducerRow>, pool_roots: List<String>) -> List<GeneratedArtifactProducerCoverage> {
  map(rows, r => generated_artifact_producer_coverage_row(row: r, pool_roots: pool_roots))
}

fn generated_artifact_producer_coverage_is_refused(c: GeneratedArtifactProducerCoverage) -> Bool {
  match c {
    GeneratedArtifactProducerCovered { row: _ } => false
    GeneratedArtifactProducerUncovered { row: _, resolution: _ } => true
  }
}

// THE REFUSAL SET over a supplied row population. The registry fold below hands it the real rows; a
// witness hands it a planted row whose producer names no declaration, which is the only way an
// uncovered artifact can be authored while GeneratedArtifact stays closed and every rostered
// producer resolves.
fn generated_artifact_producer_refusals_over(rows: List<GeneratedArtifactProducerRow>, pool_roots: List<String>) -> List<GeneratedArtifactProducerCoverage> {
  filter(generated_artifact_producer_coverage_over(rows: rows, pool_roots: pool_roots), c => generated_artifact_producer_coverage_is_refused(c: c))
}

fn generated_artifact_producer_refusals(pool_roots: List<String>) -> List<GeneratedArtifactProducerCoverage> {
  generated_artifact_producer_refusals_over(rows: generated_artifact_producer_rows(), pool_roots: pool_roots)
}

fn every_generated_artifact_producer_covered(pool_roots: List<String>) -> Bool {
  count(generated_artifact_producer_refusals(pool_roots: pool_roots)) == 0
}

// LOCATED: the artifact path, the producer it claims, and the resolver arm that refused it.
fn generated_artifact_producer_coverage_rendered(c: GeneratedArtifactProducerCoverage) -> String {
  match c {
    GeneratedArtifactProducerCovered { row } =>
      concat(concat(concat("generated artifact ", row.artifact_path), " covered by producer "), declaration_ref_display_key(ref: row.producer))
    GeneratedArtifactProducerUncovered { row, resolution } =>
      concat(concat(concat(concat(concat("generated artifact ", row.artifact_path), " UNCOVERED: producer "), declaration_ref_display_key(ref: row.producer)), " "), declaration_ref_resolution_arm_key(resolution: resolution))
  }
}
