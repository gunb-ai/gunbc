module gunbc.design_subject_registry

import std.types { NonEmptyStr, String }
import std.decl_ref { DeclarationRef, decl_ref }
import gunbc.design_truth {
  ContractProofUnmeasured,
  DesignContract,
  DesignRealization,
  DesignRetirementEvent,
  DesignSubjectIdentity,
  RealizationContractProof,
  UnscheduledDesignSubjectIdentity,
  UnscheduledSubject,
}

data design_subject_registry_note: String = "THE DECLARED SUBJECT POPULATION. One row per design subject whose standing documents would otherwise restate in prose. This registry is deliberately SMALL at landing: the mechanism is proven by the witness against planted fixtures covering every fold arm, and the production population grows one migrated design thread at a time, in the monotone shape gunbc.prose_row_frontier already uses -- migrate a thread, make recurrence unwritable there, extend the roster. A registry that tried to absorb every open thread at once would be the corpus-wide rewrite this program deliberately is not."

data namespace_symbol_index_binding_subject_note: String = "THE FIRST SUBJECT, AND IT WAS CHOSEN FOR BEING DISCRIMINATING RATHER THAN IMPORTANT. Its stale sentence is on record in two generated documents: docs/plans/general-body-producer-design.md states the fn_decl-to-Arrow producer rows and scaffold dissolution are 'gated on the namespace lane's containment SymbolIndex', and gunbc.design_document repeats the same clause in the body-lowering open thread, so DESIGN.md carries it too. The gate named there is discharged -- v2.std.symbol_index declares SymbolIndex and symbol_index_lexical_lookup, and v2.compiler.resolve lookup_symbol_index_atom_identity consumes that lookup on the production resolution path -- and neither sentence moved, because nothing in this repository could observe that it should.\n\nWHAT THIS SUBJECT DOES AND DOES NOT CLAIM, stated because the correction is easy to overstate in the opposite direction. It claims exactly that decl-name binding through the containment SymbolIndex is AVAILABLE AS A PRODUCTION AUTHORITY. It does NOT claim the body producer's Stage A is complete, that the fn_decl-to-Arrow rows are written, or that the wrapper-retained frontier is dissolved -- those remain open, and a projection that implied otherwise would be the pessimistic sentence's optimistic twin. The subject is narrow on purpose: the smallest crossing specimen is the requirement plus one.\n\nWHY UNSCHEDULED RATHER THAN A DELIVERABLE SUBJECT: the namespace roadmap nodes cover the REMAINING work, and this prerequisite is discharged, so binding it to one of them would put an already-true fact inside a row whose active set is declared minus accepted -- it could never leave. The DeliverableSubject arm is exercised by the witness rather than in production today, and that asymmetry is named here rather than left for a reader to infer."

fn namespace_symbol_index_binding_subject() -> DesignSubjectIdentity {
  UnscheduledSubject {
    identity: "ds_namespace_symbol_index_binding" as UnscheduledDesignSubjectIdentity,
  }
}

fn namespace_symbol_index_binding_contract() -> DesignContract {
  DesignContract {
    subject: namespace_symbol_index_binding_subject(),
    requirement: decl_ref(
      module_path: "v2.std.symbol_index",
      decl_name: "SymbolIndex",
    ),
  }
}

data namespace_symbol_index_binding_proof_unmeasured_note: String = "THIS ROW CARRIES NO DIGEST, DELIBERATELY, AND THE FIRST DRAFT IS WHY. contract_digest began as a required field, so this row had to carry something and carried 0000000000000000 -- a fabricated value in the one position whose entire job is to record which contract structure the realization was proven against. Nothing distinguished it from a measured digest; the fold would have compared it, mismatched, and reported DesignContractChanged permanently, with no way to tell a real drift from a placeholder. That is the fabricated-plausible-output failure inside the carrier built to remove exactly that class, which is the only reason it is worth this much prose.\n\nMEASUREMENT WAS ATTEMPTED AND IS UNAFFORDABLE AT THIS SEAM, so the state is typed rather than guessed. Deriving the digest needs decl_facts over the pool; the attempt exceeded a 45-minute remote executor budget, and CONFIDENCE-0 independently measured a corpus-wide reverse query at 409s wall with ~92% in load_bare_edge_index. A pin nobody can afford to re-derive is unfalsifiable in practice even when the number is right, so pinning one would have bought the appearance of rigour and none of it.\n\nWHAT THE ARM COSTS, stated so no reader over-reads the standing: this subject's derived standing is DesignRealizedContractProofUnmeasured, not DesignRealized. The implementation exists and is reached from its named production consumer -- that half is witnessed -- but contract-drift detection is NOT active for this row, so editing v2.std.symbol_index SymbolIndex will not move its standing. TRIGGER: the declaration-grain consumption authority reconciled with CONFIDENCE-0 (subject in, consumers out, index amortized once per process). Its point-query interface makes deriving one declaration's structural digest affordable, at which point this arm becomes ProvenAgainstContract with a measured value and this note deletes."

fn namespace_symbol_index_binding_contract_proof() -> RealizationContractProof {
  ContractProofUnmeasured {
    reason: "deriving the digest requires decl_facts over the whole pool; the measurement exceeded a 45-minute remote executor budget and a pin that cannot be re-derived per consumer is unfalsifiable",
    trigger: "declaration-grain consumption authority lands with a point-query interface (subject in, consumers out, index amortized once per process), making a single declaration's structural digest affordable to derive and re-verify",
  }
}

fn namespace_symbol_index_binding_realization() -> DesignRealization {
  DesignRealization {
    subject: namespace_symbol_index_binding_subject(),
    implementation: decl_ref(
      module_path: "v2.std.symbol_index",
      decl_name: "symbol_index_lexical_lookup",
    ),
    production_consumer: decl_ref(
      module_path: "v2.compiler.resolve",
      decl_name: "lookup_symbol_index_atom_identity",
    ),
    evidence: decl_ref(
      module_path: "test.claim.design_truth_witness",
      decl_name: "namespace_symbol_index_binding_is_realized",
    ),
    contract_proof: namespace_symbol_index_binding_contract_proof(),
  }
}

data declared_design_contracts_note: String = "The declared population. design_standing is a fold over these rows plus the live declaration facts; no row here carries a status, and there is no field any of them could carry that would let a standing be authored instead of derived."

data declared_design_contracts: List<DesignContract> = [
  namespace_symbol_index_binding_contract(),
]

data declared_design_realizations: List<DesignRealization> = [
  namespace_symbol_index_binding_realization(),
]

data declared_design_retirements_note: String = "EMPTY IS A REAL STATE, NOT A PLACEHOLDER. No subject has been retired, and the arm exists so that retirement is recorded as an event naming a successor rather than expressed by deleting a contract row -- the shape gunbc.roadmap_model adopted for acceptance after the 2026-07-28 verdict, for the same reason: a fact expressed by absence cannot be told apart from a fact nobody wrote."

data declared_design_retirements: List<DesignRetirementEvent> = []
