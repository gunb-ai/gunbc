module gunbc.owned_ci


data owned_ci_authority_note: String = "Owned CI control plane v0 state carriers (docs/plans/owned-ci-control-plane-design.md). Poll-first subject discovery, durable filesystem queue with expiring lease, one local executor, Checks projection honesty boundary."

data owned_ci_dry_run_github_boundary_note: String = "dry_run discovers from the local mirror only: GitHub REST PR poll and Checks create/update are skipped; executor stages are not run. Mirror git-fetch remains (local mirror refresh, not REST)."

data owned_ci_operator_rerun_surface_note: String = "v0 operator rerun: ci_control_plane --enqueue-rerun-sha <40-hex> (or OWNED_CI_ENQUEUE_RERUN_SHA) enqueues OperatorRerun with subject_key rerun:<sha> matching ci_execution_plan.ci_subject_identity_key."

data owned_ci_state_root_rel: String = ".gunbc/owned-ci"
data owned_ci_check_name: std.types.NonEmptyStr = "gunbc-ci"
data owned_ci_default_lease: std.measure.Second = second(count: 3600)

type QueueLease {
  holder: String
  expires_at: extdeps.auth.jwt.NumericDate
}

fn owned_ci_default_lease_seconds_count() -> Int {
  second_count(s: owned_ci_default_lease)
}

type CiRunQueueState
  = QueuePending
  | QueueClaimed { lease: QueueLease }
  | QueueCompleted
  | QueueFailed { detail: String }
  | QueueRefused { cause: String }

type CheckPublicationState
  = CheckPublicationNotStarted
  | CheckPublicationQueued { check_run_id: Int? }
  | CheckPublicationInProgress { check_run_id: Int }
  | CheckPublicationCompleted { check_run_id: Int, conclusion: extdeps.github.checks.CheckConclusion }
  | CheckPublicationPending { local_conclusion: extdeps.github.checks.CheckConclusion, details_url: std.types.NonEmptyStr }
  | CheckPublicationFailed { cause: std.types.NonEmptyStr, local_conclusion: extdeps.github.checks.CheckConclusion }

fn owned_ci_state_root(workspace_root: String) -> String {
  concat(workspace_root, concat("/", owned_ci_state_root_rel))
}

fn owned_ci_index_rel_path() -> String {
  concat(owned_ci_state_root_rel, "/index.json")
}

fn owned_ci_run_record_rel_path(run_id: String) -> String {
  concat(concat(concat(owned_ci_state_root_rel, "/runs/"), run_id), "/run.json")
}

type OwnedCiFilesystemText
  = OwnedCiFilesystemTextPresent { content: String }
  | OwnedCiFilesystemTextEmpty
  | OwnedCiFilesystemTextMissing { cause: String }

fn owned_ci_classify_filesystem_text(path: String) -> OwnedCiFilesystemText {
  let read_out = Filesystem.Read(path: path)
  if !read_out.success {
    OwnedCiFilesystemTextMissing { cause: read_out.error }
  } else if read_out.content == "" {
    OwnedCiFilesystemTextEmpty
  } else {
    OwnedCiFilesystemTextPresent { content: read_out.content }
  }
}

data owned_ci_run_id_note: String = "Run ids are path segments under .gunbc/owned-ci/runs/<run_id>/run.json on both the writer (ci_control_plane new_run_id) and the served /ci/run/<run_id> reader. path_segment_is_safe alone is insufficient: the brand must also match the produced grammar <unix_seconds>-<8_hex_from_head_sha> so a traversal-shaped segment cannot reach filesystem_read by convention alone."

fn owned_ci_run_id_char_is_digit(c: String) -> Bool {
  (c != "") && string_contains(s: "0123456789", pattern: c)
}

fn owned_ci_run_id_char_is_hex(c: String) -> Bool {
  (c != "") && string_contains(s: "0123456789abcdefABCDEF", pattern: c)
}

fn owned_ci_run_id_find_char(s: String, ch: String, i: Int) -> Int {
  if i >= string_length(s: s) {
    0 - 1
  } else if char_at(s: s, i: i) == ch {
    i
  } else {
    owned_ci_run_id_find_char(s: s, ch: ch, i: i + 1)
  }
}

fn owned_ci_run_id_digits_only(s: String, i: Int, end: Int) -> Bool {
  if i >= end {
    true
  } else {
    owned_ci_run_id_char_is_digit(c: char_at(s: s, i: i))
      && owned_ci_run_id_digits_only(s: s, i: i + 1, end: end)
  }
}

fn owned_ci_run_id_hex_only(s: String, i: Int, end: Int) -> Bool {
  if i >= end {
    true
  } else {
    owned_ci_run_id_char_is_hex(c: char_at(s: s, i: i))
      && owned_ci_run_id_hex_only(s: s, i: i + 1, end: end)
  }
}

fn owned_ci_run_id_matches_produced_grammar(run_id: String) -> Bool {
  let hyphen = owned_ci_run_id_find_char(s: run_id, ch: "-", i: 0)
  if hyphen < 1 {
    false
  } else {
    let len = string_length(s: run_id)
    let suffix_start = hyphen + 1
    let suffix_len = len - suffix_start
    (suffix_len == 8)
      && owned_ci_run_id_digits_only(s: run_id, i: 0, end: hyphen)
      && owned_ci_run_id_hex_only(s: run_id, i: suffix_start, end: len)
      && (owned_ci_run_id_find_char(s: run_id, ch: "-", i: suffix_start) == 0 - 1)
  }
}

fn owned_ci_run_id_admits(run_id: String) -> Bool {
  path_segment_is_safe(raw: run_id)
    && owned_ci_run_id_matches_produced_grammar(run_id: run_id)
}

fn owned_ci_queue_pending_rel_dir() -> String {
  concat(owned_ci_state_root_rel, "/queue/pending")
}

fn owned_ci_queue_claimed_rel_dir() -> String {
  concat(owned_ci_state_root_rel, "/queue/claimed")
}

type PrPollGithubReadAdmission
  = PrPollGithubReadAdmitted
  | PrPollGithubReadRefused { cause: std.types.NonEmptyStr }

fn owned_ci_pr_poll_missing_github_token_cause() -> std.types.NonEmptyStr {
  "GITHUB_TOKEN required for owned-ci poll (fail-closed: cannot discover PR subjects without GitHub read)" as std.types.NonEmptyStr
}

fn owned_ci_pr_poll_empty_github_token_cause() -> std.types.NonEmptyStr {
  "GITHUB_TOKEN empty (fail-closed: cannot discover PR subjects)" as std.types.NonEmptyStr
}

fn owned_ci_pr_poll_github_read_admission(token_observation: String?) -> PrPollGithubReadAdmission {
  match token_observation {
    Absent =>
      PrPollGithubReadRefused { cause: owned_ci_pr_poll_missing_github_token_cause() }
    Present { value: token } =>
      if token == "" {
        PrPollGithubReadRefused { cause: owned_ci_pr_poll_empty_github_token_cause() }
      } else {
        PrPollGithubReadAdmitted
      }
  }
}

type QueueLeaseExpiryDecision
  = LeaseClockExpired
  | LeaseClockNotExpired
  | LeaseClockRefused { cause: std.types.NonEmptyStr }

type QueueLeaseReclaimDecision
  = ReclaimExpiredLease
  | RetainActiveLease
  | LeaseReclaimRefused { cause: std.types.NonEmptyStr }

type QueueLeaseValidityDecision
  = LeaseValidForHolder
  | LeaseInvalidHolder
  | LeaseExpiredForHolder
  | LeaseValidityRefused { cause: std.types.NonEmptyStr }

fn queue_lease_expiry_decision(lease: QueueLease, now: extdeps.auth.jwt.NumericDate) -> QueueLeaseExpiryDecision {
  match lease.expires_at {
    NumericDateWholeSeconds { seconds: exp } =>
      match now {
        NumericDateWholeSeconds { seconds: n } =>
          if n >= exp {
            LeaseClockExpired
          } else {
            LeaseClockNotExpired
          }
        NumericDateFractionalSeconds { whole_seconds: _, fractional_digits: _ } =>
          LeaseClockRefused {
            cause: "queue lease clock now carries fractional seconds; POSIX lease reclaim requires whole-second NumericDate" as std.types.NonEmptyStr,
          }
      }
    NumericDateFractionalSeconds { whole_seconds: _, fractional_digits: _ } =>
      LeaseClockRefused {
        cause: "queue lease expires_at carries fractional seconds; POSIX lease reclaim requires whole-second NumericDate" as std.types.NonEmptyStr,
      }
  }
}

fn queue_lease_reclaim_decision(lease: QueueLease, now: extdeps.auth.jwt.NumericDate) -> QueueLeaseReclaimDecision {
  match queue_lease_expiry_decision(lease: lease, now: now) {
    LeaseClockExpired => ReclaimExpiredLease
    LeaseClockNotExpired => RetainActiveLease
    LeaseClockRefused { cause: c } => LeaseReclaimRefused { cause: c }
  }
}

fn queue_lease_validity(lease: QueueLease, holder: String, now: extdeps.auth.jwt.NumericDate) -> QueueLeaseValidityDecision {
  if lease.holder == holder {
    match queue_lease_expiry_decision(lease: lease, now: now) {
      LeaseClockExpired => LeaseExpiredForHolder
      LeaseClockNotExpired => LeaseValidForHolder
      LeaseClockRefused { cause: c } => LeaseValidityRefused { cause: c }
    }
  } else {
    LeaseInvalidHolder
  }
}

data check_publication_predicate_family_disposition: std.disposition.Disposition = Terminal {
  reason: "check_publication_reports_github_success and check_publication_is_pending_honest are total matches over CheckPublicationState — all six variants (CheckPublicationNotStarted, CheckPublicationQueued, CheckPublicationInProgress, CheckPublicationCompleted, CheckPublicationPending, CheckPublicationFailed) carry an explicit arm, no top-level wildcard false arm. Same disposition and same reason as runner_incarnation runner_slot_installation_predicate_family_disposition: these dissolve at authoring, so unlike fleet_runner_connectivity connectivity_verdict_is_* (wildcard false arms, enrolled in non_fold_residue_frontier) an NFR row would stale the roster. Adding a variant to CheckPublicationState therefore breaks these matches loudly rather than silently answering false."
}

fn check_publication_reports_github_success(state: CheckPublicationState) -> Bool {
  match state {
    CheckPublicationCompleted { check_run_id: _, conclusion: c } =>
      check_conclusion_is_success(c: c)
    CheckPublicationPending { local_conclusion: _, details_url: _ } => false
    CheckPublicationNotStarted => false
    CheckPublicationQueued { check_run_id: _ } => false
    CheckPublicationInProgress { check_run_id: _ } => false
    CheckPublicationFailed { cause: _, local_conclusion: _ } => false
  }
}

fn check_publication_is_pending_honest(state: CheckPublicationState) -> Bool {
  match state {
    CheckPublicationPending { local_conclusion: _, details_url: _ } => true
    CheckPublicationNotStarted => false
    CheckPublicationQueued { check_run_id: _ } => false
    CheckPublicationInProgress { check_run_id: _ } => false
    CheckPublicationCompleted { check_run_id: _, conclusion: _ } => false
    CheckPublicationFailed { cause: _, local_conclusion: _ } => false
  }
}

fn owned_ci_details_url(base_url: String, run_id: String) -> String {
  concat(concat(base_url, "/ci/run/"), run_id)
}

fn owned_ci_check_status_for_queue(state: CiRunQueueState) -> extdeps.github.checks.CheckStatus {
  match state {
    QueuePending => Queued
    QueueClaimed { lease: _ } => InProgress
    QueueCompleted => Completed
    QueueFailed { detail: _ } => Completed
    QueueRefused { cause: _ } => Completed
  }
}

fn owned_ci_check_conclusion_for_queue(state: CiRunQueueState, publication: CheckPublicationState) -> extdeps.github.checks.CheckConclusion? {
  match state {
    QueuePending => none
    QueueClaimed { lease: _ } => none
    QueueCompleted =>
      match publication {
        CheckPublicationCompleted { check_run_id: _, conclusion: c } => Present { value: c }
        CheckPublicationPending { local_conclusion: c, details_url: _ } => Present { value: c }
        CheckPublicationFailed { cause: _, local_conclusion: c } => Present { value: c }
        CheckPublicationNotStarted => none
        CheckPublicationQueued { check_run_id: _ } => none
        CheckPublicationInProgress { check_run_id: _ } => none
      }
    QueueFailed { detail: _ } => Present { value: Failure }
    QueueRefused { cause: _ } => Present { value: Failure }
  }
}
