module gunbc.floor_demand

import std.types { String, NonEmptyStr, Bool, List, Int }
import std.nat { nat_max }
import std.measure {
  ByteSize, byte_size, byte_size_count, Second, second, EventsPerMinute, events_per_minute, events_per_minute_count,
  MeasureSubtraction, measure_sub, Memory, One, HardwareThreadCount, hardware_thread_count,
  GrainRounding, GrainRounded, GrainUnrepresentable, round_up_to_grain, gibibyte_grain,
}
import std.disposition { Disposition, SingleAuthority }
import std.checked_arithmetic {
  CheckedInt, CheckedIntReady, CheckedIntOverflow, IntegerOverflow, checked_int_add, checked_add_results,
}
import extdeps.storage.types { Ephemeral }
import extdeps.toolchain.types { Architecture, Aarch64, X86_64 }
import product.fabric.envelope { MemoryRequirement, StorageRequirement }

data floor_demand_disposition: Disposition = SingleAuthority

// WHAT THE FLOOR JOB DEMANDS OF A MACHINE, IN ONE PLACE, AS RECEIPTS RATHER THAN AS PROSE.
//
// Three authorities each carried a piece of this before: gunbc.runner_slot_allocation held the
// measured peak the cell wall gates on, gunbc.ci_floor_measurement held the per-run cgroup peak
// carrier, and the 2026-09-12 uncensored measurement that sized the 26/25 GiB cell lived only in a
// comment beside the literal it justified. The floor's Work (gunbc.fabric_witness_run) stated eight
// threads and nothing else, so anything sizing a machine for it -- the cell, a microVM guest --
// had to read the demand out of a paragraph. This module is the demand's home: the receipts are
// typed, the lower bound is a fold over them, and the Work's envelope and the guest shape both read
// it from here. It is a leaf on purpose, so that the slot allocation, the CI measurement module and
// the floor's Work can all import it without a cycle.

// ── the per-run cgroup peak carrier (moved here from gunbc.ci_floor_measurement) ────────────────
//
// AN OBSERVATION IS EVIDENCE ONLY TOGETHER WITH THE CONDITIONS IT WAS TAKEN UNDER. armed_memory_high
// is what the cgroup's memory.high WAS for that run, so a peak stays decidable against the line it
// was actually taken under and never re-interprets itself against a later declaration. The four
// 2026-07-11 receipts below keep proving exactly what they always proved -- the caps of that day were
// applied and the reclaim clamp held within 0.65 MiB -- whatever the row says today.
type FloorRunCgroupPeakReceipt
  = FloorRunCgroupPeakMeasured {
      run_id: String,
      runner_unit: String,
      cgroup_peak: ByteSize,
      armed_memory_high: ByteSize,
      floor_outcome: String,
    }
  | FloorRunCgroupPeakUnmeasured

data gunbc_ci_floor_run_peak_receipt_overshoot_ceiling: ByteSize = byte_size(681574)

data gunbc_ci_floor_run_peak_receipts: List<FloorRunCgroupPeakReceipt> = [
  FloorRunCgroupPeakMeasured {
    run_id: "29137081535",
    runner_unit: "actions-runner@srv1-01.service",
    cgroup_peak: byte_size(16106127360),
    armed_memory_high: byte_size(16106127360),
    floor_outcome: "timeout",
  },
  FloorRunCgroupPeakMeasured {
    run_id: "29142398465",
    runner_unit: "actions-runner@srv1-03.service",
    cgroup_peak: byte_size(16106127360),
    armed_memory_high: byte_size(16106127360),
    floor_outcome: "timeout",
  },
  FloorRunCgroupPeakMeasured {
    run_id: "29159082043",
    runner_unit: "actions-runner@srv2-01.service",
    cgroup_peak: byte_size(16106127360),
    armed_memory_high: byte_size(16106127360),
    floor_outcome: "timeout",
  },
  FloorRunCgroupPeakMeasured {
    run_id: "29112500694",
    runner_unit: "actions-runner@srv2-02.service",
    cgroup_peak: byte_size(16106127360),
    armed_memory_high: byte_size(16106127360),
    floor_outcome: "timeout",
  },
]

fn floor_run_peak_receipt_at_throttle_line(receipt: FloorRunCgroupPeakReceipt) -> Bool {
  match receipt {
    FloorRunCgroupPeakMeasured { run_id: _, runner_unit: _, cgroup_peak: peak, armed_memory_high: high, floor_outcome: _ } =>
      floor_run_peak_within_throttle_overshoot(peak: peak, high: high)
    FloorRunCgroupPeakUnmeasured => false
  }
}

fn floor_run_peak_within_throttle_overshoot(peak: ByteSize, high: ByteSize) -> Bool {
  let overshoot_ceiling = gunbc_ci_floor_run_peak_receipt_overshoot_ceiling
  byte_size_count(b: peak) >= byte_size_count(b: high)
    && byte_size_count(b: peak) <= (byte_size_count(b: high) + byte_size_count(b: overshoot_ceiling))
}

// ── the two receipts the demand is read from ───────────────────────────────────────────────────
//
// A READING IS ONE OF TWO KINDS AND THE KIND DECIDES WHAT IT MAY BE USED FOR. A peak that sits
// strictly below the line it was armed under is UNCENSORED: the workload stopped growing on its
// own, so the peak is the demand of that run. A peak at or over its armed line is a THROTTLE PIN:
// the kernel was holding the workload at the line, so the reading says the demand is AT LEAST
// that and says nothing about how far past it the workload wanted to go. Both bound the CHARGE the
// cgroup reached, so both feed the charge-ceiling fold. Only an uncensored reading may SIZE anything, which is why
// gunbc_floor_measured_peak_observation is drawn from the uncensored receipt alone and
// gunbc.runner_slot_allocation's wall guards its input with gunbc_floor_measured_peak_is_uncensored.
type FloorPeakReadingKind
  = UncensoredPeak { peak: ByteSize }
  | ThrottlePin { peak: ByteSize, armed_line: ByteSize }
  | PeakUnmeasured

fn floor_peak_reading_kind(receipt: FloorRunCgroupPeakReceipt) -> FloorPeakReadingKind {
  match receipt {
    FloorRunCgroupPeakUnmeasured => PeakUnmeasured
    FloorRunCgroupPeakMeasured { run_id: _, runner_unit: _, cgroup_peak: peak, armed_memory_high: high, floor_outcome: _ } =>
      if byte_size_count(b: peak) < byte_size_count(b: high) {
        UncensoredPeak { peak: peak }
      } else {
        ThrottlePin { peak: peak, armed_line: high }
      }
  }
}

// THE UNCENSORED MEASUREMENT BEHIND THE 26/25 GiB CELL (operator ruling 2026-09-12), typed here for
// the first time. It was taken on the lane CI actually runs, on srv1, under
// `systemd-run --user --scope -p MemoryMax=64G` with MALLOC_ARENA_MAX=2, against commit
// 975706293d0f02c83ecda5f978607ad9e54b11b8 with a binary of sha256 5cc271009d24...7a471:
//
//   claim_executor --required-ci --required-lane witnesses --source-root dag --source-root src/v2
//   verdict FloorClean  planned=3762 executed=3762  claims_failed=0  stall 0 faults/min
//
// The scope's memory.high was `max`, so the armed line recorded here is the scope's 64 GiB
// MemoryMax: the reading sat 40 GiB under it, which is what makes it a demand rather than another
// pin. THE RULING TOOK A LARGER FIGURE THAN THIS ROW CARRIES, and the difference is stated rather
// than smoothed: the run heartbeat's own cgroup-charge reading peaked at about 24.7 GiB against
// the scope's 22.74 GiB memory.peak, the ruling could not say which level the larger reading named,
// and it sized the cell to the larger one in the fail-closed direction. The heartbeat figure
// survives only as a rounded rendering, so the PRECISE byte count typed here is the scope's, and
// the ruling's rounding to 25 GiB is carried by gunbc.runner_slot_allocation's memory_high row,
// where it always was. Nothing here re-derives that row; the receipt is what it rested on.
data gunbc_floor_uncensored_demand_receipt: FloorRunCgroupPeakReceipt = FloorRunCgroupPeakMeasured {
  run_id: "srv1 systemd-run scope, 2026-09-12, commit 975706293d0f",
  runner_unit: "systemd-run --user --scope -p MemoryMax=64G",
  cgroup_peak: byte_size(24412725248),
  armed_memory_high: byte_size(68719476736),
  floor_outcome: "FloorClean",
}

// THE FLOOR IS PINNED AT THE 26/25 GiB ROW AGAIN, ONE WEEK AFTER THE ROW WAS SIZED TO END PINNING.
// Read from the required-witnesses-floor job of merge-group run 35408627003 (job 105803508248,
// srv1-03, 2026-09-19, the composed revision of gunbc#11662), from the run's own [floor-cgroup]
// heartbeat at beat-30: max=27917287424 high=26843545600 peak=26849763328, memory.high events
// 1928, memory.max events 0, oom_kill 0, verdict FloorClean, whole-job wall 46m28s. The peak
// overshoots the armed line by 5.9 MiB -- past the 0.65 MiB reclaim-clamp signature of the July
// receipts, so this is not merely the line being touched -- and 1928 high events say the kernel
// was holding it there. Under the 2026-09-12 ruling's own rule, a line BELOW a measured peak is
// known to be too low; this receipt says 25 GiB is such a line. It is recorded rather than argued
// away: a cell sized "to end welding to the throttle line" that welds a week later is a finding
// about demand growth, and the fold below carries it into every consumer as the lower bound it is.
data gunbc_floor_throttle_pin_receipt_2026_09_19: FloorRunCgroupPeakReceipt = FloorRunCgroupPeakMeasured {
  run_id: "35408627003",
  runner_unit: "actions-runner@srv1-03.service",
  cgroup_peak: byte_size(26849763328),
  armed_memory_high: byte_size(26843545600),
  floor_outcome: "FloorClean",
}

fn gunbc_floor_demand_receipts() -> List<FloorRunCgroupPeakReceipt> {
  [gunbc_floor_uncensored_demand_receipt, gunbc_floor_throttle_pin_receipt_2026_09_19]
}

// THE SIZING INPUT IS THE UNCENSORED RECEIPT AND NOTHING ELSE. These two rows keep the names
// gunbc.runner_slot_allocation has gated on since 2026-08-17 (they moved here; they did not
// change meaning), and they are DERIVED from the receipt rather than typed beside it, so the
// wall's input and the receipt cannot disagree. The armed line is not re-exported as a third
// row: the reading kind below carries it inside ThrottlePin, and nothing reads it as a bare figure.
fn floor_peak_receipt_peak(receipt: FloorRunCgroupPeakReceipt) -> ByteSize {
  match receipt {
    FloorRunCgroupPeakUnmeasured => byte_size(0)
    FloorRunCgroupPeakMeasured { run_id: _, runner_unit: _, cgroup_peak: peak, armed_memory_high: _, floor_outcome: _ } => peak
  }
}

data gunbc_floor_measured_peak_observation: ByteSize = floor_peak_receipt_peak(receipt: gunbc_floor_uncensored_demand_receipt)

fn gunbc_floor_measured_peak_is_uncensored() -> Bool {
  match floor_peak_reading_kind(receipt: gunbc_floor_uncensored_demand_receipt) {
    UncensoredPeak { peak: _ } => true
    ThrottlePin { peak: _, armed_line: _ } => false
    PeakUnmeasured => false
  }
}

// THE CHARGE CEILING IS THE LARGEST PEAK ANY RECEIPT REACHED, CENSORED OR NOT -- AND IT IS NOT THE
// DEMAND. memory.peak charges page cache beside anonymous memory, and a run held at its
// memory.high line finishes clean precisely because the cache half of that charge is reclaimable:
// the 2026-09-19 pin's 1928 high events are the kernel giving that half back. So this figure bounds
// what the cgroup was CHARGED, which is the fact the throttle-line witnesses want, and sizing a
// machine to it would consume a bet as a fact (DESIGN 4d; an earlier revision of this module
// stated it as the Work's minimum and was withdrawn). The Work's minimum is the resident held-set
// lower bound below, derived from raw memory.stat beats.
fn floor_cgroup_charge_ceiling(receipts: List<FloorRunCgroupPeakReceipt>) -> ByteSize {
  byte_size(fold(receipts, init: 0, f: (acc, r) => nat_max(acc, byte_size_count(b: floor_peak_receipt_peak(receipt: r)))))
}

fn gunbc_floor_cgroup_charge_ceiling() -> ByteSize {
  floor_cgroup_charge_ceiling(receipts: gunbc_floor_demand_receipts())
}

// ── the resident held-set demand ─────────────────────────────────────────────────────────────────
//
// WHAT A MACHINE HAS TO HOLD is the part of the charge reclaim cannot give back: anonymous pages,
// shmem, and the kernel's unreclaimable slab, stacks, page tables, per-cpu and socket memory --
// the disjoint terms beat_held_set folds, stated there. The instrument is the floor heartbeat's own `[floor-cgroup] stat_level=` line
// (v1_compiler cli_run required_floor_runner floor_cgroup_stat_beat), which reads the leaf's
// memory.stat once per beat and prints its counters raw, one flat list, no grouping. A
// receipt carries the raw beats, and the demand is the MAXIMUM of the held set (beat_held_set,
// the non-overlapping rule below) over them, with the file bytes of the same beat beside it, so the
// allowance can be checked against what the cache actually held when the anonymous demand peaked.
// memory.stat has no peak counter, so a per-beat maximum is a lower bound on the true peak by
// whatever a sub-minute spike hid; the cadence is carried so a reader knows the grain.
// ONE BEAT'S memory.stat READINGS, RAW, so a beat cited as evidence is a value a fold can read rather
// than a sentence, and so the derivation below can be checked against the components it folds.
// Every field is the kernel's own counter as the heartbeat printed it, in bytes; nothing is summed
// here. The stall rate is the heartbeat's own stall clause beside the memory_stat line, and it rides
// the carrier that clause's producer returns -- gunbc.memory_stall_refusal
// memory_stall_major_fault_rate yields std.measure EventsPerMinute -- so the receipt and the
// instrument hold one representation of one quantity.
// THE SEAM A BEAT WAS SAMPLED IN, AS A CLOSED VOCABULARY, so which phase established the peak is
// a value a fold reads rather than a sentence a transcriber wrote. The floor names its own seams
// (v1_compiler.cli_run required_floor_runner floor_seam) and there are exactly these six; the
// heartbeat has always read that slot for its human line, and the stat beat now prints it on its
// OWN line beside the counters. Before that the two facts were separate stderr streams joined
// only by the order the lines happened to appear in -- a positional citation (DESIGN 3), which any
// line emitted between them by another thread invalidates silently.
//
// THREE ARMS ARE NOT SEAMS AND THAT IS THE POINT. SeamNotYetEntered is a beat taken before the first
// floor_seam call -- genuinely un-attributed, and rendering it as the first seam would attribute
// entry-time memory to preparation. SeamUnrecorded is a beat transcribed from a line that carried
// no seam field at all, which is every beat taken before the instrument grew one: the 2026-09-19
// receipt below is such a receipt, and this arm is what makes its un-attributability structural
// rather than a caveat in prose. SeamUnreadable is the instrument reporting that the seam SLOT
// ITSELF could not be read -- a poisoned lock -- which is a third distinct fact and exists because
// the instrument can print it (review 69767): a vocabulary that cannot receive a token its own
// producer emits forces the transcriber to map it onto some OTHER arm, and that mapping is a
// fabrication no reader can see. None of the three may size or attribute anything.
//
// WHAT THIS VOCABULARY DOES NOT COVER, stated so its absence is not read as a reading: checkout and
// the toolchain build are JOB STEPS BEFORE THIS PROCESS EXISTS, so no in-process beat can carry
// them. Their wall is the job's own step timing (gunbc_floor_job_wall_receipt_2026_09_19
// build_step_wall), and attributing memory to them needs a reader outside claim_executor.
type FloorSeam
  = SeamStrictPreparation
  | SeamPublishedMockProjection
  | SeamSiteProjection
  | SeamDiscoveryAuthority
  | SeamClaimScopeProjection
  | SeamClaimEvaluationFold
  | SeamNotYetEntered
  | SeamUnrecorded
  | SeamUnreadable

type FloorMemoryStatBeat {
  beat: Int
  seam: FloorSeam
  charge: ByteSize
  anon: ByteSize
  file: ByteSize
  shmem: ByteSize
  unevictable: ByteSize
  slab_unreclaimable: ByteSize
  slab_reclaimable: ByteSize
  kernel_stack: ByteSize
  pagetables: ByteSize
  percpu: ByteSize
  sock: ByteSize
  file_dirty: ByteSize
  stall: BeatStall
}

// THE STALL CLAUSE, WHICH MAY NOT HAVE READ. The heartbeat computes its stall window from
// /proc counters and renders `na` when they do not read, and the floor's entry beat carries no
// window at all -- so an unread stall is a state the INSTRUMENT ROUTINELY EMITS and the receipt
// must be able to receive it (review 69767). Before this it could not, and the only way to
// transcribe such a beat was to write a rate of zero, which is the healthiest reading the field
// can carry: fabricating progress, exactly inverted from the truth.
//
// StallUnread IS NOT UNSTALLED. receipt_last_unstalled_beat and receipt_peak_reading_standing both
// treat it as failing their test rather than passing it, because "we could not tell" is not
// evidence of calm, and the cache allowance derived from an unstalled beat would otherwise rest
// on a beat nobody observed.
type BeatStall
  = StallRead { rate: EventsPerMinute }
  | StallUnread

fn beat_stall_is_zero(b: FloorMemoryStatBeat) -> Bool {
  match b.stall {
    StallUnread => false
    StallRead { rate: r } => events_per_minute_count(r: r) == 0
  }
}

fn beat_stall_is_positive(b: FloorMemoryStatBeat) -> Bool {
  match b.stall {
    StallUnread => false
    StallRead { rate: r } => events_per_minute_count(r: r) > 0
  }
}

// THE HELD-SET RULE, STATED ONCE AND EXPLICITLY NON-OVERLAPPING. memory.stat's counters are not a
// partition: `file` INCLUDES shmem/tmpfs pages, and `unevictable` is an LRU-list state counter
// over pages that `anon` and `file` already count by type. A sum that took every "unreclaimable-
// looking" key would double-count. What a guest with no swap must HOLD is therefore folded from
// disjoint counters only:
//
//   anon               swap-backed, unreclaimable without swap
//   shmem              swap-backed, counted inside `file` by the kernel and so added here in place
//                      of `file`, never beside it
//   slab_unreclaimable, kernel_stack, pagetables, percpu, sock
//                      kernel memory charged to the cgroup that reclaim cannot free
//
// `file` less `shmem` is the reclaimable page cache; `slab_reclaimable` is reclaimable; and
// `unevictable` is deliberately NOT a term, because its pages are already inside `anon` or `file`.
// The figure this yields is a RESIDENT HELD-SET LOWER BOUND for the beat, and that is what the
// Work's memory minimum is: the Work states what it must hold, at the grain the heartbeat samples.
//
// THE SUM IS CHECKED CONSTRUCTION, NOT A STRUCTURAL BOUND. Seven counters that are disjoint IN THE
// KERNEL'S ACCOUNTING sum to at most memory.current, which fits the realization's i64 with room;
// but this fold reads what a heartbeat LINE printed, and a torn line owes no such invariant. So the
// terms are added through std.checked_arithmetic, pre-checked, and a beat whose sum would cross
// the bound answers CheckedIntOverflow naming the operation and operands rather than a wrapped
// count that would read as a small demand.
fn beat_held_set(b: FloorMemoryStatBeat) -> CheckedInt {
  checked_add_results(
    a: checked_add_results(
      a: checked_add_results(
        a: checked_add_results(
          a: checked_add_results(
            a: checked_int_add(a: byte_size_count(b: b.anon), b: byte_size_count(b: b.shmem)),
            b: CheckedIntReady { value: byte_size_count(b: b.slab_unreclaimable) },
          ),
          b: CheckedIntReady { value: byte_size_count(b: b.kernel_stack) },
        ),
        b: CheckedIntReady { value: byte_size_count(b: b.pagetables) },
      ),
      b: CheckedIntReady { value: byte_size_count(b: b.percpu) },
    ),
    b: CheckedIntReady { value: byte_size_count(b: b.sock) },
  )
}

// THE RECLAIMABLE CACHE IS file LESS shmem, AND THE SUBTRACTION IS TYPED: the kernel's own
// accounting says shmem is inside file, but this reader carries what a line printed and a line can
// be torn, so a beat with shmem > file refuses through std.measure's MeasureSubtraction rather
// than being floored to zero -- a zero cache reads exactly like a run with no cache, which is the
// fabricated equal-measures difference that authority exists to forbid.
fn beat_reclaimable_cache(b: FloorMemoryStatBeat) -> MeasureSubtraction<Memory, One> {
  measure_sub(a: b.file, b: b.shmem)
}

// THE RECEIPT CARRIES THE RAW BEATS, AND ITS TWO DISTINGUISHED BEATS ARE DERIVED, NOT AUTHORED:
// the PEAK is the beat with the largest held set, and the LAST UNSTALLED beat is the highest-
// numbered beat before the peak whose stall clause read zero -- the cache the slot still held
// while it was not thrashing, which the guest's cache allowance is derived from. Both folds refuse
// (Absent) on an empty or all-stalled list rather than inventing a beat.
// THE SWAP POLICY A READING WAS TAKEN UNDER, because a held set means DIFFERENT THINGS on each
// side of it. With swap available, anonymous pages the workload still wants can leave residency
// without the workload failing, so a held set read while swap-in is rising is a LOWER BOUND on
// what the run wanted to hold -- censored on the axis reclaim cannot answer, which is exactly how
// the 2026-09-19 receipt was censored. With swap off, a workload that exceeds its ceiling is
// killed rather than spilled, so a run that COMPLETES under that policy read its true demand.
//
// THE ARM RECORDS HOW THE FIGURE WAS OBTAINED, NOT JUST WHAT IT IS (DESIGN 4d). The heartbeat's
// cgroup envelope prints max, high, current and peak -- it does NOT print memory.swap.max -- so a
// receipt taken from a job log CANNOT read the attempt's swap ceiling, only cite the row that
// declares it. SwapMaxDeclaredUnread is that state and names its declaring authority; SwapMaxRead
// is for an instrument that reads the file. Conflating them would let a declared row be consumed
// as a reading, which is the bet-as-fact the corpus refuses.
type RunSwapPolicy
  = SwapMaxRead { swap_max: ByteSize }
  | SwapMaxDeclaredUnread { declared: ByteSize, declaring_authority: NonEmptyStr }
  | SwapDisabled

type FloorHeldSetReceipt {
  run_id: NonEmptyStr
  runner_unit: NonEmptyStr
  beat_cadence: Second
  beats_sampled: Int
  beats: List<FloorMemoryStatBeat>
  run_completed: Bool
  swap_policy: RunSwapPolicy
}

// THE PEAK OVER A RUN'S BEATS, AS A COPRODUCT: the beat with the largest held set and that set's
// bytes; no beats at all; or a beat whose held set the machine could not represent, carrying the
// overflow -- which is a torn receipt and refuses everything downstream rather than being skipped.
type HeldSetPeak
  = HeldSetPeakAt { beat: FloorMemoryStatBeat, bytes: ByteSize }
  | HeldSetPeakNoBeats
  | HeldSetPeakUnrepresentable { cause: IntegerOverflow }

fn held_set_peak_step(acc: HeldSetPeak, b: FloorMemoryStatBeat) -> HeldSetPeak {
  match acc {
    HeldSetPeakUnrepresentable { cause: c } => HeldSetPeakUnrepresentable { cause: c }
    HeldSetPeakNoBeats =>
      match beat_held_set(b: b) {
        CheckedIntOverflow { cause: c } => HeldSetPeakUnrepresentable { cause: c }
        CheckedIntReady { value: v } => HeldSetPeakAt { beat: b, bytes: byte_size(v) }
      }
    HeldSetPeakAt { beat: pb, bytes: pv } =>
      match beat_held_set(b: b) {
        CheckedIntOverflow { cause: c } => HeldSetPeakUnrepresentable { cause: c }
        CheckedIntReady { value: v } =>
          if v > byte_size_count(b: pv) { HeldSetPeakAt { beat: b, bytes: byte_size(v) } } else { HeldSetPeakAt { beat: pb, bytes: pv } }
      }
  }
}

fn receipt_held_set_peak(r: FloorHeldSetReceipt) -> HeldSetPeak {
  fold(r.beats, init: HeldSetPeakNoBeats, f: (acc, b) => held_set_peak_step(acc: acc, b: b))
}

fn receipt_peak_beat(r: FloorHeldSetReceipt) -> FloorMemoryStatBeat? {
  match receipt_held_set_peak(r: r) {
    HeldSetPeakAt { beat: b, bytes: _ } => Present { value: b }
    HeldSetPeakNoBeats => none
    HeldSetPeakUnrepresentable { cause: _ } => none
  }
}

// WHICH SEAM ESTABLISHED THE PEAK, DERIVED FROM THE RECEIPT AND REFUSING WHERE IT CANNOT BE SAID.
// This is the whole point of carrying the seam: a consumer asking what to reduce needs the phase
// the demand was established in, and until now that answer came from a reader eyeballing which
// heartbeat line sat above which stat line. The fold takes the peak beat the existing held-set
// fold already selects -- one derivation of "the peak", not a second one -- and reports its seam.
//
// IT REFUSES ON THE TWO NON-SEAM ARMS RATHER THAN NAMING THEM AS PHASES. A receipt whose peak beat
// is SeamUnrecorded cannot attribute its peak at all, and saying so is the honest answer; the
// alternative -- letting SeamUnrecorded flow out as though it were a phase -- would let a
// pre-instrument receipt look attributed. The 2026-09-19 receipt is exactly that case, so this
// function answers PeakSeamUnattributable for it today, which is a true statement about what that
// run recorded rather than a defect in this fold.
// THE REFUSAL CAUSE IS TYPED, NOT A SENTENCE, because the four ways a peak can fail to be
// attributed are four different facts with four different remedies, and a reader who has to
// parse prose to tell them apart is doing the same guessing this module exists to end (review
// 69719). An earlier revision folded the seam through a Bool and could then only emit a
// DISJUNCTIVE cause -- "sampled before the first seam, OR transcribed from a line without one" --
// for a case where the arm is known exactly. Collapsing a known discriminator and then
// apologising for it in the message is the absorbing fallback DESIGN 5 forbids, one layer up from
// the positional join the seam field removes.
//
// PeakBeatSampledBeforeAnySeam is a live run whose first beat landed before any seam was entered:
// the remedy is to read a later beat. PeakBeatSeamUnrecorded is a receipt transcribed from a
// pre-instrument log: the remedy is a new run. ReceiptHasNoBeats is an unmeasured receipt.
// ReceiptTorn carries the overflow from the beat whose held set does not sum. Different facts,
// different remedies, no prose to parse.
type PeakUnattributableCause
  = PeakBeatSampledBeforeAnySeam { beat: Int }
  | PeakBeatSeamUnrecorded { beat: Int }
  | PeakBeatSeamUnreadable { beat: Int }
  | ReceiptHasNoBeats
  | ReceiptTorn { overflow: IntegerOverflow }

type PeakSeamAttribution
  = PeakAttributedTo { seam: FloorSeam, beat: Int, bytes: ByteSize }
  | PeakSeamUnattributable { cause: PeakUnattributableCause }

// THE MATCH IS ON THE PEAK BEAT'S SEAM DIRECTLY, so every arm of FloorSeam is answered here and
// a new arm added to that coproduct cannot silently fall into either bucket -- it fails to
// compile until this fold says which it is.
fn receipt_peak_seam(r: FloorHeldSetReceipt) -> PeakSeamAttribution {
  match receipt_held_set_peak(r: r) {
    HeldSetPeakNoBeats => PeakSeamUnattributable { cause: ReceiptHasNoBeats }
    HeldSetPeakUnrepresentable { cause: c } => PeakSeamUnattributable { cause: ReceiptTorn { overflow: c } }
    HeldSetPeakAt { beat: b, bytes: v } =>
      match b.seam {
        SeamNotYetEntered => PeakSeamUnattributable { cause: PeakBeatSampledBeforeAnySeam { beat: b.beat } }
        SeamUnrecorded => PeakSeamUnattributable { cause: PeakBeatSeamUnrecorded { beat: b.beat } }
        SeamUnreadable => PeakSeamUnattributable { cause: PeakBeatSeamUnreadable { beat: b.beat } }
        SeamStrictPreparation => PeakAttributedTo { seam: b.seam, beat: b.beat, bytes: v }
        SeamPublishedMockProjection => PeakAttributedTo { seam: b.seam, beat: b.beat, bytes: v }
        SeamSiteProjection => PeakAttributedTo { seam: b.seam, beat: b.beat, bytes: v }
        SeamDiscoveryAuthority => PeakAttributedTo { seam: b.seam, beat: b.beat, bytes: v }
        SeamClaimScopeProjection => PeakAttributedTo { seam: b.seam, beat: b.beat, bytes: v }
        SeamClaimEvaluationFold => PeakAttributedTo { seam: b.seam, beat: b.beat, bytes: v }
      }
  }
}

fn later_unstalled_before(peak: FloorMemoryStatBeat, a: FloorMemoryStatBeat, b: FloorMemoryStatBeat) -> FloorMemoryStatBeat {
  if b.beat < peak.beat && beat_stall_is_zero(b: b) && (b.beat > a.beat || !(a.beat < peak.beat && beat_stall_is_zero(b: a))) { b } else { a }
}

// THE LAST UNSTALLED BEAT: the highest-numbered beat before the peak whose stall clause read zero.
// The fold seeds with the peak itself, which never qualifies, so a result equal to the peak means
// no beat qualified and the answer is Absent rather than the peak dressed as evidence.
fn receipt_last_unstalled_beat(r: FloorHeldSetReceipt) -> FloorMemoryStatBeat? {
  match receipt_peak_beat(r: r) {
    Absent => none
    Present { value: p } => {
      let best = fold(r.beats, init: p, f: (a, b) => later_unstalled_before(peak: p, a: a, b: b))
      if best.beat < p.beat && beat_stall_is_zero(b: best) { Present { value: best } } else { none }
    }
  }
}

// THE STANDING IS DERIVED FROM THE RECEIPT, NOT AUTHORED BESIDE IT: a receipt with no beats is
// the unmeasured state; a receipt with a beat the machine cannot sum is a torn receipt and stands
// as its own arm, carrying the overflow, so it can neither size anything nor be mistaken for
// unmeasured; only a receipt with a representable peak is Measured.
type FloorHeldSetStanding
  = HeldSetUnmeasured { instrument: NonEmptyStr }
  | HeldSetReceiptUnrepresentable { cause: IntegerOverflow }
  | HeldSetMeasured { receipt: FloorHeldSetReceipt, peak: ByteSize }

fn held_set_standing_of(receipt: FloorHeldSetReceipt, instrument: NonEmptyStr) -> FloorHeldSetStanding {
  match receipt_held_set_peak(r: receipt) {
    HeldSetPeakNoBeats => HeldSetUnmeasured { instrument: instrument }
    HeldSetPeakUnrepresentable { cause: c } => HeldSetReceiptUnrepresentable { cause: c }
    HeldSetPeakAt { beat: _, bytes: v } => HeldSetMeasured { receipt: receipt, peak: v }
  }
}

// THE FIRST RECEIPT, FROM THE FIRST FLOOR RUN CARRYING THE INSTRUMENT (this change's own CI run
