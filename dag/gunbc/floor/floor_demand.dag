// THE WORK STATES WHAT IT MUST HOLD AND NOTHING MORE. The cache a guest is granted above this is a
// fact about the GUEST -- how much room its kernel gets for file pages before it starts to thrash
// -- and it lives with the guest shape (gunbc.runner_microvm
// gunbc_runner_microvm_guest_cache_allowance), derived from the receipt's last unstalled beat.
// Putting it here would make every offer in the fleet answer for a policy about one realization.
fn floor_memory_requirement_of(standing: FloorHeldSetStanding) -> MemoryRequirement? {
  match standing {
    HeldSetUnmeasured { instrument: _ } => none
    HeldSetReceiptUnrepresentable { cause: _ } => none
    HeldSetMeasured { receipt: _, peak: v } => Present { value: MemoryRequirement { min_bytes: v } }
  }
}

// MEASURED, BY THE RECEIPT ABOVE. The Unmeasured arm is what this returned until that run, and
// it stays constructible because a fresh corpus without the instrument's receipt is exactly the
// state it represents; the Work states no memory while it stands, and the guest shape refuses on
// that absence rather than being sized to the charge ceiling.
data gunbc_floor_held_set_instrument: NonEmptyStr = "the required-witnesses-floor job's [floor-cgroup] stat_level= seam= stall_per_min= memory_stat= heartbeat lines on the host slot, raw beats transcribed, the held set derived by beat_held_set and its maximum taken over the run's beats, and the peak's seam read from the same line by receipt_peak_seam"

fn gunbc_floor_held_set_standing() -> FloorHeldSetStanding {
  held_set_standing_of(receipt: gunbc_floor_memory_stat_receipt_2026_09_23, instrument: gunbc_floor_held_set_instrument)
}

fn floor_memory_requirement() -> MemoryRequirement? {
  floor_memory_requirement_of(standing: gunbc_floor_held_set_standing())
}

// ── storage ────────────────────────────────────────────────────────────────────────────────────
//
// THE FLOOR'S STORAGE DEMAND WAS NEVER STATED ANYWHERE, and on a shared host slot nothing forced
// the question: the slot writes into a filesystem with hundreds of gibibytes free and the disk
// axis "admits nothing numeric" in gunbc.runner_slot_allocation. A microVM guest has exactly the
// workspace image it is handed, so the question has to be answered before one is sized. It is
// answered as a SUM OF MEASURED COMPONENTS, each carrying the architecture it was measured on,
// because the components come from different places and only some of them are arm64 readings:
//
//   checkout tree     du -sb of the worktree at 7261964510, excluding .git and target -- source
//                     bytes, architecture-neutral
//   git object store  the full-history pack actions/checkout materialises at fetch-depth 0
//                     (git count-objects size-pack, 519.85 MiB) -- architecture-neutral
//   rust toolchain    du -sb of a 1.93.0 aarch64 toolchain carrying the clippy and rustfmt
//                     components rust-toolchain.toml names -- an arm64 reading
//   cargo registry    CARGO_HOME after a cold fetch of the workspace's dependencies -- source
//                     crates, architecture-neutral, read on the x86_64 run below
//   build tree        target/ after `cargo build --release -p v1-compiler --bin claim_executor
//                     --bin gunbc` from a wiped CARGO_HOME with RUSTC_WRAPPER unset, on a
//                     6-vCPU x86_64 BuildBuddy executor, 2026-09-19 (BuildBuddy invocation
//                     abbc8fb7-69eb-4ef0-b8a4-5504084196c9): a PROXY reading, since arm64 object
//                     code differs in size from x86_64 object code
//
// The sum is a LOWER BOUND on the guest's working set for the same reason the memory figure is:
// it counts what the job materialises and not the transient it passes through (rustup extracts
// each component beside its tarball, cargo unpacks beside its .crate). The arm64 cold-build receipt
// planned in gunbc.floor_cold_build_receipt replaces the proxy components with readings from the
// guest itself, and this note's "proxy" rows delete when it lands.
type StorageComponentReceipt {
  component: NonEmptyStr
  bytes: ByteSize
  measured_on: Architecture
}

data gunbc_floor_storage_components: List<StorageComponentReceipt> = [
  StorageComponentReceipt { component: "checkout tree", bytes: byte_size(103107266), measured_on: Aarch64 },
  StorageComponentReceipt { component: "git object store, full history", bytes: byte_size(545103872), measured_on: Aarch64 },
  StorageComponentReceipt { component: "rust toolchain 1.93.0 with clippy and rustfmt", bytes: byte_size(543035523), measured_on: Aarch64 },
  StorageComponentReceipt { component: "cargo registry after cold fetch", bytes: byte_size(58151348), measured_on: X86_64 },
  StorageComponentReceipt { component: "target after cold release build of claim_executor and gunbc", bytes: byte_size(558310704), measured_on: X86_64 },
]

// THE TOTAL IS CHECKED CONSTRUCTION for the same reason the held set is: the components are
// transcribed receipts and a transcription owes no bound.
fn storage_components_total(components: List<StorageComponentReceipt>) -> CheckedInt {
  fold(components, init: CheckedIntReady { value: 0 }, f: (acc, c) => checked_add_results(a: acc, b: CheckedIntReady { value: byte_size_count(b: c.bytes) }))
}

// ROUNDED UP TO WHOLE-GIBIBYTE GRAIN, in the fail-closed direction the corpus already applies to
// demand figures (gunbc.whole_corpus_compile_admission, gunbc.runner_slot_allocation): rounding
// down would admit a workspace the measured sum does not fit. THE ROUNDER IS std.measure
// round_up_to_grain AND THIS IS ITS GIBIBYTE BINDING, not a second rounder: the checked
// `n + (g - 1)` this function used to carry fixed the grain, so a policy with a declared grain
// could not reuse it, and asked the wrong overflow question for any grain that is not a power of
// two (at the gibibyte the two questions coincide, so every consumer's refusal set is unchanged).
// The refusal arm and its IntegerOverflow cause are unchanged for every consumer.
fn round_up_to_gibibyte_grain(bytes: ByteSize) -> GrainRounding {
  round_up_to_grain(bytes: bytes, grain: gibibyte_grain())
}

// THE FLOOR'S STORAGE DEMAND, OR THE OVERFLOW THAT KEPT IT FROM BEING STATED. A consumer that
// wants a StorageRequirement matches this and refuses on the second arm; nothing here substitutes
// a bound for a figure that could not be computed.
type FloorStorageDemand
  = StorageDemandStated { requirement: StorageRequirement }
  | StorageDemandUnrepresentable { cause: IntegerOverflow }

// EPHEMERAL, BECAUSE THE FLOOR KEEPS NOTHING: every job wipes its toolchain homes and starts from
// a fresh checkout, and the microVM attempt's workspace ceases to exist with the attempt.
fn floor_storage_demand() -> FloorStorageDemand {
  match storage_components_total(components: gunbc_floor_storage_components) {
    CheckedIntOverflow { cause: c } => StorageDemandUnrepresentable { cause: c }
    CheckedIntReady { value: total } =>
      match round_up_to_gibibyte_grain(bytes: byte_size(total)) {
        GrainUnrepresentable { cause: c } => StorageDemandUnrepresentable { cause: c }
        GrainRounded { bytes: b } => StorageDemandStated { requirement: StorageRequirement { min_bytes: b, persistence: Ephemeral } }
      }
  }
}

// THE COLD x86_64 BUILD WALL FROM THE SAME RUN THAT PRODUCED THE TWO PROXY STORAGE COMPONENTS
// (BuildBuddy invocation abbc8fb7-69eb-4ef0-b8a4-5504084196c9, 6 vCPU, 7451388 kB MemTotal,
// CARGO_HOME wiped, RUSTC_WRAPPER unset): `cargo build --release -p v1-compiler --bin
// claim_executor --bin gunbc` completed in 267 s. It is a foreign-architecture reading, typed with
// its architecture like the storage rows, and it exists so the cold-build plan's prediction can
// name a producer for the figure it reasons from rather than transcribe it.
type ColdBuildStepWallReceipt {
  invocation: NonEmptyStr
  measured_on: Architecture
  vcpus: HardwareThreadCount
  build_step_wall: Second
}

data gunbc_cold_build_step_wall_x86_64_2026_09_19: ColdBuildStepWallReceipt = ColdBuildStepWallReceipt {
  invocation: "abbc8fb7-69eb-4ef0-b8a4-5504084196c9",
  measured_on: X86_64,
  vcpus: hardware_thread_count(count: 6),
  build_step_wall: second(count: 267),
}

// ── wall ───────────────────────────────────────────────────────────────────────────────────────
//
// THE WHOLE-JOB WALL OF THE SAME 2026-09-19 RUN THE PIN RECEIPT COMES FROM, read from the Actions
// job's own startedAt/completedAt (00:14:56 to 01:01:24) and from the build step's Finished line.
// The build step took 3m17s WITH sccache reachable, which is the condition a guest does not have:
// this receipt is the warm baseline the planned cold receipt is compared against, not a cold
// figure. Ten of the eleven measured phases sit in the witnesses lane, so a cold build changes the
// build step and not the whole.
type FloorJobWallReceipt {
  run_id: NonEmptyStr
  job_id: NonEmptyStr
  runner_unit: NonEmptyStr
  whole_job_wall: Second
  build_step_wall: Second
  sccache_reachable: Bool
}

data gunbc_floor_job_wall_receipt_2026_09_19: FloorJobWallReceipt = FloorJobWallReceipt {
  run_id: "35408627003",
  job_id: "105803508248",
  runner_unit: "actions-runner@srv1-03.service",
  whole_job_wall: second(count: 2788),
  build_step_wall: second(count: 198),
  sccache_reachable: true,
}
