module gunbc.self_host_step_memory_demand

import std.types { String, NonEmptyStr, Bool, List, Int }
import std.measure { ByteSize, byte_size, byte_size_count }
import std.disposition { ConstructionMechanism, SingleAuthority }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.checked_arithmetic { CheckedInt, CheckedIntReady, CheckedIntOverflow, checked_add_results }

data self_host_step_memory_demand_disposition: ConstructionMechanism = SingleAuthority

// WHAT ONE `gunbc test //gunbc/instruments:self-host` (AND ITS SIBLING v2-native-cli) HOLDS, BY OWNER,
// BY SCALE AND BY THE CHANGE THAT ENDS IT -- as typed rows rather than as a paragraph of a run log.
//
// THE PEAK IS NOT RUSTC'S AND IT IS NOT THE EMITTED PRODUCT'S. The step's high-water mark is held by the
// SEED PROCESS inside its own in-process emission, before cargo starts; when cargo runs, the seed is
// still resident (it holds the whole-tree acquisition pool through the build) and rustc stacks on it
// at a LOWER total. The product under test costs almost nothing. So the demand has three owners and
// only one of them sets the number a slot is sized to.
//
// MEASURED VS INFERRED (DESIGN 4d). `MeasuredByStagedRelease` rows were read back as a resident-set
// pair around a release of exactly that structure (`cli_run::memory_composition`, the
// `[memory-composition] release=` lines): what malloc_trim returns after the release was freed, so the
// figure is that structure's live size, not an allocator's retention. `InferredFromClosureRegression`
// rows are a two-closure regression and are a BET: the reader who consumes one as a fact is the defect.
//
// HOW EVERY FIGURE RE-DERIVES: the instrument is the run itself -- `GUNBC_MEMORY_COMPOSITION=1 gunbc
// test //gunbc/instruments:self-host` under `systemd-run --user --scope -p MemoryMax=22G -p
// MemorySwapMax=0` with the 1 s beat sampler sampling the scope's memory.current/memory.peak and each
// process's VmRSS, phases cut at the step's own log seams. Receipt ids below name the run directory
// shape (self_host_cold_run, native_cli_cold_run, composition_run); the seed revision is d0f2067f8b1
// on aarch64 srv1 with GUNBC_NATIVE_CACHE_ROOT unset (a COLD run).

type StepDemandOwner
  = SeedProcess
  | CargoAndRustc
  | ProductUnderTest

// THE FOUR GROWTH AXES A BUCKET CAN HAVE, and each names what its bytes scale WITH:
//   WholeTree     -- the number of modules and bytes the seed acquires under the source roots,
//                    independent of which closure is being emitted;
//   EntryClosure  -- the emitted entry's own transitive closure (v2.compiler.compile's size);
//   EmittedCrate  -- the size of the Rust crate that rustc compiles, a consequence of the closure;
//   Fixed         -- the process baseline.
type StepDemandScale
  = WholeTree
  | EntryClosure
  | EmittedCrate
  | Fixed

// WHAT ENDS A BUCKET. Each arm is a change, not a knob: a bucket disappears when the structure that
// holds it stops being built, never when its allocator is tuned.
type StepDemandEnder
  = ClosureScopedIngestion
  | PoolReleasedAfterCensus
  | PoolReleasedBeforeResolution
  | NativeCompilerReplacesInterpreter
  | ShrinksOnlyWithEmittedCrate
  | NeverEnds

type StepBucketStanding
  = MeasuredByStagedRelease
  | MeasuredBySamplerBeat
  | InferredFromClosureRegression { read_obligation: NonEmptyStr }

type StepMemoryBucket {
  structure: NonEmptyStr
  owner: StepDemandOwner
  scale: StepDemandScale
  bytes: ByteSize
  standing: StepBucketStanding
  live_at_seed_peak: Bool
  live_during_cargo: Bool
  ender: StepDemandEnder
  instrument: NonEmptyStr
}

data self_host_composition_run_instrument: NonEmptyStr = "GUNBC_MEMORY_COMPOSITION=1 gunbc test //gunbc/instruments:self-host, [memory-composition] release= lines (cli_run::memory_composition)"
data self_host_beat_instrument: NonEmptyStr = "1 s sampler over the systemd-run scope's memory.current/memory.peak and each pid's VmRSS, phases cut at the step's own log seams"

