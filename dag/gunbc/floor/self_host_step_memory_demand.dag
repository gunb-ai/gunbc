// ── folds over the rows ─────────────────────────────────────────────────────────────────────────

fn step_scale_is_whole_tree(s: StepDemandScale) -> Bool {
  match s {
    WholeTree => true
    EntryClosure => false
    EmittedCrate => false
    Fixed => false
  }
}

fn step_scale_is_entry_closure(s: StepDemandScale) -> Bool {
  match s {
    WholeTree => false
    EntryClosure => true
    EmittedCrate => false
    Fixed => false
  }
}

fn step_buckets_total(buckets: List<StepMemoryBucket>) -> CheckedInt {
  fold(buckets, init: CheckedIntReady { value: 0 }, f: (acc, b) => checked_add_results(a: acc, b: CheckedIntReady { value: byte_size_count(b: b.bytes) }))
}

// WHAT SCALES WITH THE CORPUS, summed, and what scales with the entry closure. The remainder of the
// step's peak is cargo's and the product's, which are NOT live at the seed's high-water mark.
fn step_whole_tree_bytes() -> CheckedInt {
  step_buckets_total(buckets: self_host_step_memory_buckets |> filter(b => step_scale_is_whole_tree(s: b.scale)))
}

fn step_entry_closure_bytes() -> CheckedInt {
  step_buckets_total(buckets: self_host_step_memory_buckets |> filter(b => step_scale_is_entry_closure(s: b.scale)))
}

fn step_live_at_seed_peak(b: StepMemoryBucket) -> Bool {
  b.live_at_seed_peak
}

fn step_seed_peak_bytes() -> CheckedInt {
  step_buckets_total(buckets: self_host_step_memory_buckets |> filter(b => step_live_at_seed_peak(b: b)))
}

fn step_live_during_cargo(b: StepMemoryBucket) -> Bool {
  b.live_during_cargo
}

fn step_cargo_phase_bytes() -> CheckedInt {
  step_buckets_total(buckets: self_host_step_memory_buckets |> filter(b => step_live_during_cargo(b: b)))
}

// THE STEP'S PEAK IS THE LARGER OF TWO MOMENTS, NOT THEIR SUM: the seed's emission (everything
// live_at_seed_peak) and the cargo build (everything live_during_cargo, which still holds the
// seed's pool). Summing every bucket would charge rustc against a transient the seed had already
// released.
fn step_demand_is_moment_maximum(seed_moment: Int, cargo_moment: Int, peak: Int) -> Bool {
  (peak == seed_moment && seed_moment >= cargo_moment) || (peak == cargo_moment && cargo_moment >= seed_moment)
}

// ── THE TREND, AS A ROW ─────────────────────────────────────────────────────────────────────────
//
// IS THE DEMAND STRICTLY DECREASING OVER TIME? NO, and the row says what would make it so. Over a
// growing corpus every WholeTree bucket grows monotonically with the module count (the seed pools and
// censuses the whole tree to emit one closure), and the EntryClosure bucket grows with
// v2.compiler.compile's own size; neither shrinks on its own. The demand falls only under a named
// change, and each change removes a SET of buckets, so the trend is a staircase that is flat or rising
// between changes, never a slope.
type StepDemandTrend {
  change: StepDemandEnder
  removes_scale: StepDemandScale
  removes_from_seed_peak: Bool
  removes_from_cargo_phase: Bool
  lowers_step_peak: Bool
  evidence: NonEmptyStr
}

data self_host_step_demand_trend: List<StepDemandTrend> = [
  StepDemandTrend {
    change: PoolReleasedAfterCensus,
    removes_scale: WholeTree,
    removes_from_seed_peak: false,
    removes_from_cargo_phase: true,
    lowers_step_peak: false,
    evidence: "the staged release at the cargo seam took the seed from 6.9 GB to 36 MB (run composition_run) and the cargo phase process sum fell from 13.5 GB to 6.5 GB, while the seed's own reconcile stage -- which needs the pool -- still reached 14.4 GB",
  },
  StepDemandTrend {
    change: PoolReleasedBeforeResolution,
    removes_scale: WholeTree,
    removes_from_seed_peak: true,
    removes_from_cargo_phase: true,
    lowers_step_peak: true,
    evidence: "counterfactual run (GUNBC_MEMORY_COMPOSITION_DROP_POOL_BEFORE_RESOLVE=1, one self-host step, 22G scope, rc 0): the cgroup peak fell from 14,393,454,592 to 10,485,690,368 bytes, 3.9 GB, with the step still green -- the closure resolution does not need the whole-tree token pool once the census is taken",
  },
  StepDemandTrend {
    change: ClosureScopedIngestion,
    removes_scale: WholeTree,
    removes_from_seed_peak: true,
    removes_from_cargo_phase: true,
    lowers_step_peak: true,
    evidence: "every WholeTree bucket above is built from the 8,196 pooled modules of which 7,959 are compiled for the census only; the tree-scale buckets are 12.4 GB of the 14.4 GB peak (4 measured, 1 inferred)",
  },
  StepDemandTrend {
    change: NativeCompilerReplacesInterpreter,
    removes_scale: EntryClosure,
    removes_from_seed_peak: true,
    removes_from_cargo_phase: false,
    lowers_step_peak: true,
    evidence: "the native generation-two compiler would hold its own closure working set instead of the interpreter's; its footprint has not been measured and this row does not claim one",
  },
  StepDemandTrend {
    change: ShrinksOnlyWithEmittedCrate,
    removes_scale: EmittedCrate,
    removes_from_seed_peak: false,
    removes_from_cargo_phase: true,
    lowers_step_peak: false,
    evidence: "rustc's sum was 6.3 GB for a 243-file crate and 5.3 GB for a 208-file crate: about 28 MB per emitted file under rustc, independent of the seed",
  },
]

// WHAT A CUTOVER RECEIPT READS FROM HERE. gunbc.cutover_receipt's readings (the witnesses cold-run
// row) take the per-phase table above as its per-step memory carrier rather than minting a second
// one; this is the projection it joins on.
fn self_host_step_phase_readings_for_step(step: NonEmptyStr) -> List<StepPhaseReading> {
  self_host_step_phase_readings |> filter(r => r.step == step)
}

// THE BUCKET ROWS AND THE PHASE ROWS ARE TWO SEPARATE MEASUREMENTS OF ONE RUN (staged release versus
// sampler beat), so the sum of the buckets live at a moment must land within a stated tolerance of
// the phase reading at that moment. A bucket set that drifts from the sampler's reading -- a structure
// missing, a figure re-measured on a different tree -- fails here rather than reading green.
fn step_within_percent(sum: Int, reading: Int, percent: Int) -> Bool {
  let slack = reading * percent / 100
  sum <= reading + slack && sum + slack >= reading
}

fn step_peak_reading_of(phase: NonEmptyStr, step: NonEmptyStr) -> Int {
  fold(self_host_step_phase_readings_for_step(step: step) |> filter(r => r.phase == phase), init: 0, f: (acc, r) => byte_size_count(b: r.cgroup_current_max))
}

fn step_buckets_reconcile_with_beats() -> Bool {
  match step_seed_peak_bytes() {
    CheckedIntOverflow { cause: _ } => false
    CheckedIntReady { value: seed } =>
      match step_cargo_phase_bytes() {
        CheckedIntOverflow { cause: _ } => false
        CheckedIntReady { value: cargo } =>
          step_within_percent(sum: seed, reading: step_peak_reading_of(phase: "compile.emit", step: "self-host"), percent: 2)
          && step_within_percent(sum: cargo, reading: step_peak_reading_of(phase: "cargo_build_baseline", step: "self-host"), percent: 5)
      }
  }
}

fn self_host_step_memory_demand_readout() -> ProcessExit {
  if step_buckets_reconcile_with_beats() { ExitSuccess } else { exit_failure(reason: "the self-host step bucket rows do not reconcile with the sampler beat readings") }
}
