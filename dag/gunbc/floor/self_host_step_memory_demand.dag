// ── the per-phase readings, the instrument's own output ─────────────────────────────────────────
//
// THE SEAMS ARE THE STEP'S OWN LOG LINES (`started compile.frontend`, `compile.reconcile done`,
// `started compile.emit`, `emission arena released`, `emitted crate built`, `discriminating red
// established`), so a phase boundary is a line a reader can grep, not a time chosen afterwards.
// cgroup_current_max includes page cache and so can exceed the process sum; process_rss_sum_max is
// seed + rustc + the rest of the process tree at one beat.
type StepPhaseReading {
  step: NonEmptyStr
  phase: NonEmptyStr
  seed_rss_max: ByteSize
  rustc_rss_sum_max: ByteSize
  cgroup_current_max: ByteSize
}

data self_host_step_phase_readings: List<StepPhaseReading> = [
  StepPhaseReading { step: "self-host", phase: "pre_entry_pool_and_census", seed_rss_max: byte_size(7120000000), rustc_rss_sum_max: byte_size(0), cgroup_current_max: byte_size(7120000000) },
  StepPhaseReading { step: "self-host", phase: "compile.frontend_normalize", seed_rss_max: byte_size(7890000000), rustc_rss_sum_max: byte_size(0), cgroup_current_max: byte_size(7890000000) },
  StepPhaseReading { step: "self-host", phase: "compile.reconcile", seed_rss_max: byte_size(14360000000), rustc_rss_sum_max: byte_size(0), cgroup_current_max: byte_size(14370000000) },
  StepPhaseReading { step: "self-host", phase: "compile.analyses", seed_rss_max: byte_size(14370000000), rustc_rss_sum_max: byte_size(0), cgroup_current_max: byte_size(14380000000) },
  StepPhaseReading { step: "self-host", phase: "compile.emit", seed_rss_max: byte_size(14370000000), rustc_rss_sum_max: byte_size(0), cgroup_current_max: byte_size(14390000000) },
  StepPhaseReading { step: "self-host", phase: "cargo_build_baseline", seed_rss_max: byte_size(7080000000), rustc_rss_sum_max: byte_size(6330000000), cgroup_current_max: byte_size(13760000000) },
  StepPhaseReading { step: "self-host", phase: "discriminating_red_rebuild", seed_rss_max: byte_size(7130000000), rustc_rss_sum_max: byte_size(6320000000), cgroup_current_max: byte_size(14040000000) },
  StepPhaseReading { step: "self-host", phase: "controls", seed_rss_max: byte_size(7130000000), rustc_rss_sum_max: byte_size(0), cgroup_current_max: byte_size(7840000000) },
  StepPhaseReading { step: "v2-native-cli", phase: "pre_entry_pool_and_census", seed_rss_max: byte_size(7120000000), rustc_rss_sum_max: byte_size(0), cgroup_current_max: byte_size(7120000000) },
  StepPhaseReading { step: "v2-native-cli", phase: "compile.frontend_normalize", seed_rss_max: byte_size(7820000000), rustc_rss_sum_max: byte_size(0), cgroup_current_max: byte_size(7820000000) },
  StepPhaseReading { step: "v2-native-cli", phase: "compile.reconcile", seed_rss_max: byte_size(14190000000), rustc_rss_sum_max: byte_size(0), cgroup_current_max: byte_size(14200000000) },
  StepPhaseReading { step: "v2-native-cli", phase: "compile.analyses", seed_rss_max: byte_size(14210000000), rustc_rss_sum_max: byte_size(0), cgroup_current_max: byte_size(14220000000) },
  StepPhaseReading { step: "v2-native-cli", phase: "compile.emit", seed_rss_max: byte_size(14210000000), rustc_rss_sum_max: byte_size(0), cgroup_current_max: byte_size(14230000000) },
  StepPhaseReading { step: "v2-native-cli", phase: "cargo_build_baseline", seed_rss_max: byte_size(7100000000), rustc_rss_sum_max: byte_size(5120000000), cgroup_current_max: byte_size(12550000000) },
  StepPhaseReading { step: "v2-native-cli", phase: "discriminating_red_rebuild", seed_rss_max: byte_size(7130000000), rustc_rss_sum_max: byte_size(5310000000), cgroup_current_max: byte_size(12950000000) },
  StepPhaseReading { step: "v2-native-cli", phase: "controls", seed_rss_max: byte_size(7130000000), rustc_rss_sum_max: byte_size(0), cgroup_current_max: byte_size(7780000000) },
