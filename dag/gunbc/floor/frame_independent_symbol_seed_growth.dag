module gunbc.frame_independent_symbol_seed_growth

import gunbc.roadmap_model { RoadmapNodeId }
import gunbc.seed_growth { SeedGrowthJustification }
import std.decl_ref { DeclarationRef, WholeDeclaration }

// Forward-freeze receipt for the v1 seed realization of the already-modeled Symbol identity
// rule: equality is decided by lexeme, never by the ordinal at which one evaluation frame met
// that lexeme. Required-floor deliberately creates a fresh InterpContext per claim, while values
// can cross that boundary through the declared pure-producer share; the old per-frame ordinal
// therefore made equal spellings unequal and distinct spellings equal.
data frame_independent_symbol_seed_growth_justification: SeedGrowthJustification = SeedGrowthJustification {
  hand_authored_declarations: [
    DeclarationRef { module_path: "v1_compiler.v1_interpreter", decl_name: "canonical_symbol_spelling", field: WholeDeclaration }
  ],
  reason: "WHY RUST IS STILL NEEDED: required-floor execution and its fresh-per-claim InterpContext lifecycle remain in the v1 seed, so the realization that interns the Symbol carrier is still Rust. canonical_symbol_spelling is the ONE new shipped module-scope declaration in the diff against origin/main: the census over added fn/type/const/static declarations also reports Symbol, but Symbol already existed and is an ExistingSeedItemModified carrier; PartialEq::eq and Hash::hash are methods inside replacement impls, not module-scope items; SPELLINGS is function-local; and the two added test functions are cfg(test) evidence rather than shipped seed growth. The new function centralizes process-canonical spelling construction so every frame receives one identity for one lexeme. It adds no language behavior or semantic concept: it removes the seed fork from v2.std.symbol symbol_equality_is_lexeme_equality at the required-floor boundary. The companion change to fields_get removes its accidental binary-search dependence on frame-local symbol order; that is an ExistingSeedItemModified body, not a new item.",
  owning_dissolution_lane: "v1-hand-queue-drain" as RoadmapNodeId,
  trigger: "Delete canonical_symbol_spelling when the v2 evaluator owns Symbol construction and Value structural equality, and the v1 interpreter seed retires; the trigger requires the evaluator migration, not merely an empty cross-claim share roster, because ordinary values and matches require the same identity law.",
  current_boundary: "v2.std.symbol symbol_equality_is_lexeme_equality -> v1_compiler.v1_interpreter Symbol / canonical_symbol_spelling -> Value structural equality and pattern matching -> required-floor fresh evaluation frames"
}
