module gunbc.floor_materialization

// P1 — the in-process INDEX-BUILD share, declared. Every floor consumer (spec gates + witness
// entries + the floor-runner/entry-selection prelude) resolves against ONE shared MultiEntryIndex —
// union-resolve S1 (#6234) materializes the parse + typecheck index once per (thread, source_roots)
// via process_shared_index (cli_run.rs:1737); each consumer then assembles its own view over that
// shared index. N consumers demanding one index-build with no Share is the ladder's rule-1
// AuthoredDuplication at a SharedStateFrame (one claim_executor process); S1 already did the rule-1
// REWIRE (the index is readonly, so the plural reads are legal at the VALUE tier). This module
// DECLARES that correct-but-undeclared share as a ReferenceTier provider row so it is
// ladder-visible and a regression (a consumer that builds a private index instead of reading the
// share) is countable, not re-discovered per lens/gate.

// GRAIN (merry-moth-539, 2026-07-09) — three DISTINCT quantities, kept apart so the share is not
// mislabeled a lie: (1) index-build(dag,src/v2) = 1 materialization, K readers = THIS module's P1
// (identity union-INDEX-build, deliberately NOT 'union-resolve' so it cannot collide with the
// entry-resolve grain); (2) per-entry CLOSURE resolves = K today = gunbc.ci_materialization's
// resolves_total receipt (resolve_entry_graph still fires once per distinct entry — S1 shares the
// INDEX, not the per-entry closures; memo_deduplicates_resolve_count proves once-PER-ENTRY), the
// ratchet target that the graph-major node-store rewire collapses K->~1; (3) readers of the share =
// K = this module's reader_count. Case study: S1 already bought index=1 (declared here); the
// remaining duplication is the K closure resolves (counted there); the graph-major node-store
// rewire kills those. Declaring the share moves nothing at runtime, so this lane does NOT touch
// ci_floor_declared_resolve_count.

data floor_index_build_share_provider_id: String = "process_shared_index"

data floor_entry_walk_memo_provider_id: String = "walk_memo"

data floor_index_build_identity: String = "union-index-build(dag,src/v2)"

fn floor_executor_process_frame() -> std.materialization_ladder.Frame {
  std.materialization_ladder.Frame { name: "claim_executor-process", kind: SharedStateFrame }
}

data floor_index_build_share_provider: CacheProvider = provider_row(
  id: floor_index_build_share_provider_id,
  scope: [floor_executor_process_frame()],
  coverage: CoversIdentities { identities: [floor_index_build_identity] },
  tier: ReferenceTier,
  retention: scope_released_retention(capacity: CapacityUnbounded)
)

data floor_index_build_share_providers: List<CacheProvider> = [floor_index_build_share_provider]

// ReferenceTier declared DIRECTLY via provider_row, deliberately NOT provider_from_catalog: the
// catalog door births STORE tiers from cited upstream facts (that is P2 =
// extdeps.realization.resolved_graph.resolved_graph_cache, the cross-process content-keyed store
// graph-major S2b adopts). ReferenceTier is keyless by shape (the dependency edge IS the address)
// and enters only via provider_row; forcing an in-process name-keyed share through the catalog
// would project ExistenceKeyed and be refused/mislabeled (#6352). The share's legitimacy is the
// value tier — the product of the rule-1 rewire S1 already did — not obligation discharge.

fn gate_consumer_site(g: Gate) -> String {
  match g {
    EmitHostGate => "gate:EmitHostGate"
    CheapClaimPoolGate => "gate:CheapClaimPoolGate"
    ExtdepsExternalAuthorityGate => "gate:ExtdepsExternalAuthorityGate"
    DagCompileCleanGate => "gate:DagCompileCleanGate"
    GeneratedArtifactDriftGate => "gate:GeneratedArtifactDriftGate"
    ExtdepsScopePlacementGate => "gate:ExtdepsScopePlacementGate"
    ProseRowIntroductionGate => "gate:ProseRowIntroductionGate"
    SourceRootIngestGate => "gate:SourceRootIngestGate"
  }
}

// EMPTY, and that is a measured state rather than an unfilled roster. The floor once resolved two
// fixed prelude entries against the shared index before any batch ran — the affected-set floor
// runner and the entry-selection lens — mirroring the host's FLOOR_RUNNER_ENTRY /
// ENTRY_SELECTION_ENTRY constants. Both existed only to answer the selection question, and both
// were deleted with affected-set selection (2026-08-15), so the floor now has no prelude entry at
// all and reader_count over this list is zero by construction rather than by omission.
//
// The drift this row was written to record still stands as history: entry #2 was once
// v2.workflow.affected_set_selection rather than the host's v2.lens.affected_set.entry_selection,
// corrected in #6432 review — a hand-copy of a host constant disagreeing with the constant. 🟡
// dissolve-on: the list stays empty through the floor rebuild, at which point this carrier and its
// witness delete together rather than being repopulated; if a prelude entry is ever needed again it
// is declared once in .dag and consumed by BOTH the host and this row, never hand-copied.

data floor_prelude_consumer_sites: List<String> = []

fn floor_index_build_consumer_sites(gates: List<Gate>, witnesses: List<ScheduleWitnessEntry>) -> List<String> {
  concat(
    floor_prelude_consumer_sites,
    concat(
      gates |> map(g => gate_consumer_site(g: g)),
      witnesses |> map(w => w.entry)
    )
  )
}

fn floor_index_build_value_usage(gates: List<Gate>, witnesses: List<ScheduleWitnessEntry>) -> ValueUsage {
  ValueUsage {
    identity: floor_index_build_identity,
    consumers: floor_index_build_consumer_sites(gates: gates, witnesses: witnesses)
      |> map(s => ValueConsumerEdge { access: ReadAccess, site: s })
  }
}

fn floor_index_build_reader_count(gates: List<Gate>, witnesses: List<ScheduleWitnessEntry>) -> Int {
  floor_index_build_consumer_sites(gates: gates, witnesses: witnesses) |> count
}

fn floor_index_build_materialization(gates: List<Gate>, witnesses: List<ScheduleWitnessEntry>) -> ValueMaterialization {
  value_materialization(
    usage: floor_index_build_value_usage(gates: gates, witnesses: witnesses),
    providers: floor_index_build_share_providers
  )
}

data floor_index_build_no_providers: List<CacheProvider> = []

fn floor_index_build_materialization_without_provider(gates: List<Gate>, witnesses: List<ScheduleWitnessEntry>) -> ValueMaterialization {
  value_materialization(
    usage: floor_index_build_value_usage(gates: gates, witnesses: witnesses),
    providers: floor_index_build_no_providers
  )
}

// P1 (this module's in-process ReferenceTier share = process_shared_index) and P2
// (extdeps.realization.resolved_graph.resolved_graph_cache, PerHostFilesystem/ContentAddressed,
// released never with an exact 10 GiB byte ceiling and provider-native replacement, projecting
// through provider_from_catalog to a content-keyed ArtifactTier) are two providers of ONE
// computation identity (the resolved graph), never two unrelated stores (the fnv1a64 dual-surface
// discipline). P1 discharges same-process index-build plurality (rule-1 rewire, value tier); P2
// discharges the cross-process/cross-run isolation-LCA obligation (compile subprocess vs
// claim_executor frontier), which a reference cannot cross. DISSOLVE-ON: when graph-major S2b is
// default-on, the cross-run (UnboundedSiblingsFrame) frame enrolls and P2's provider row goes live
// beside this one; the per-shard W-x same-process residual (Rc<ResolvedGraph> !Send) collapses to
// whole-run once under the Rc->Arc migration (graph-major S3).

// LIVE — std.materialization_ladder landed on main (#6375). The enrolled witness
// dag/test/claim/floor_materialization_witness_test.dag IS the authority (green-by-execution on the
// CI floor, GithubActionsCiJob surface of gunbc.commit_workflow.commit_gate_roster):
// floor_index_build_materialization -> ValueSharedByReference (provider_id process_shared_index,
// reader_count == live consumer count) and the RED control
// floor_index_build_materialization_without_provider -> ValueRefusedNoCarrierProvider (providers
// empty), so the share is green because DECLARED and covering, not because nothing looked.
// reader_count folds the live roster (project_ci_floor_gates + project_ci_floor_witness_entries +
// the 2 prelude entries), so enrolling this very witness grows the consumer set it counts —
// self-consistent, never circular. CI-MEASURED (run 29066096492): enrolling this witness left the
// floor's resolves_total UNCHANGED at 3 — the witness POOLS warm against the shared index (its
// import closure is already materialized by the batch-1 compile-clean whole-tree pass, so its
// per-entry resolve is a walk_memo hit, resolve_nanos=0, excluded from the count), so the
// declaration adds ZERO cold-resolve debt and this lane does NOT touch
// ci_floor_declared_resolve_count. An earlier predicted 3->4 bump was retracted after measurement:
// the third-std.materialization_ladder-importer-pays hypothesis was wrong — enrollment does not
// always pay (merry-moth-539's caution, confirmed by the fail-closed gate that redded the
// mispredicted 4).

// S2a increment C (cross-worker-typecheck-share-design.md §4.5) — process-scoped typecheck store
// share, declared alongside P1 index-build share.

data floor_typecheck_store_share_note: String = "C2 — the in-process TYPECHECK-STORE share, declared. Adaptive floor workers arm ONE process-scoped typed_module_cache via SharedTypecheckCaches when the memory governor's target_width > 1 (cli_run.rs cross_worker_store + shared_typecheck_store.rs serde byte transport); at width=1 workers stay on private per-index Rc (serde retention without cross-worker benefit breaks CI budget — design §7). The pump thread keeps process_shared_index (private Rc). Identity union-typecheck-store(dag,src/v2) is deliberately distinct from P1's union-index-build. 🟡 dissolve-on: serde byte transport retires when store-path Rc→Arc lands (design §4.2)."

data floor_typecheck_store_share_provider_id: String = "process_shared_typecheck_store"

data floor_typecheck_store_identity: String = "union-typecheck-store(dag,src/v2)"

data floor_typecheck_store_share_provider: CacheProvider = provider_row(
  id: floor_typecheck_store_share_provider_id,
  scope: [floor_executor_process_frame()],
  coverage: CoversIdentities { identities: [floor_typecheck_store_identity] },
  tier: ReferenceTier,
  retention: scope_released_retention(capacity: CapacityUnbounded)
)

data floor_typecheck_store_share_providers: List<CacheProvider> = [floor_typecheck_store_share_provider]

// The two minimum co-readers of the adaptive worker pool at W>=2
// (cross-worker-typecheck-share-design.md §4.4). Runtime width may exceed 2 under the memory
// governor; the ladder counts declared readonly sites, not live W. The pump thread uses private
// process_shared_index (P1); only admitted worker shards clone Arc<RwLock<SharedTypecheckCaches>>
// and read the shared typed store.

data floor_typecheck_store_consumer_sites: List<String> = [
  "cli_run.rs:run_discovery_corpus_with_options:adaptive-worker-shard",
  "cli_run.rs:run_discovery_corpus_with_options:adaptive-worker-shard:co-reader"
]

fn floor_typecheck_store_value_usage() -> ValueUsage {
  ValueUsage {
    identity: floor_typecheck_store_identity,
    consumers: floor_typecheck_store_consumer_sites
      |> map(s => ValueConsumerEdge { access: ReadAccess, site: s })
  }
}

fn floor_typecheck_store_reader_count() -> Int {
  floor_typecheck_store_consumer_sites |> count
}

fn floor_typecheck_store_materialization() -> ValueMaterialization {
  value_materialization(
    usage: floor_typecheck_store_value_usage(),
    providers: floor_typecheck_store_share_providers
  )
}

data floor_typecheck_store_no_providers: List<CacheProvider> = []

fn floor_typecheck_store_materialization_without_provider() -> ValueMaterialization {
  value_materialization(
    usage: floor_typecheck_store_value_usage(),
    providers: floor_typecheck_store_no_providers
  )
}

// C3 — the HOST-PERSISTED tier over the SAME identity as C2. C2 discharges typed-module
// plurality inside ONE executor process; this row says where the value lives when that process is
// gone. The frame is UnboundedSiblingsFrame, not SharedStateFrame: recurring invocations of the
// fold on a runner host are successive siblings with no shared mutable state to rewire — there is
// no LCA process in which the repetition could have been carried, which is precisely the ladder's
// isolation-LCA obligation that only a STORE tier can discharge. ArtifactTier, not CasTier:
// tier_axes assigns CasTier the RemoteNetwork placement, and this store is a host-local directory
// (LocalFilesystem) — the same axis reading that puts extdeps.realization.resolved_graph's
// per-host content-addressed store at ArtifactTier.
//
// NOT A SECOND STORE BESIDE extdeps.realization.resolved_graph.resolved_graph_cache. That store is
// content-addressed and per-host too, and the question "why two" is the right one to ask. They key
// DIFFERENT COMPUTATIONS: resolved_graph_cache keys a whole entry's resolved graph by its closure
// subject, and this row keys ONE TYPED MODULE by its own content. The grains are not
// interchangeable — a one-module edit invalidates a whole closure subject and only that module and
// its dependents here, which is the entire reason a per-module grain buys anything the whole-graph
// grain does not. They also share the compiler-identity term rather than each deriving one
// (resolved_graph_cache transform_content_digest), which is the fnv1a64 dual-surface discipline
// applied: two providers, one identity authority, no second key scheme.

// WHAT THIS DELIVERS TODAY, named so the row is not read as more than it is: the typed-module
// content key's compiler-identity term is the running binary's content digest, and build.rs embeds
// the checkout's commit in that binary, so a rebuild at ANY new commit — including a corpus-only
// .dag commit — re-keys every entry. The relief therefore covers SAME-BUILD, CROSS-PROCESS reuse:
// the witness fold and the generated-artifact drift gate are two processes over one corpus running
// one built binary, and the second pays typecheck preparation again today. Cross-push reuse is a
// separate change to how compiler identity is derived and is NOT claimed by this row.

data floor_typecheck_store_persist_provider_id: String = "host_persisted_typecheck_store"

fn floor_runner_host_frame() -> std.materialization_ladder.Frame {
  std.materialization_ladder.Frame { name: "runner-host", kind: UnboundedSiblingsFrame }
}

// The ladder refuses ReleasedNever with CapacityUnbounded (RetentionUnbounded) and with
// CapacityUnobserved (RetentionUnobserved), so a byte ceiling and an at-capacity disposition are
// OBLIGATIONS this row discharges rather than options it selects. ByteCapacity and not
// EntryCountCapacity: the ceiling that matters on a runner host is disk, and an entry bound over a
// payload whose size is not fixed establishes no byte bound. RefuseNewStore and not
// ReplaceExisting: replacement is a second mechanism with its own correctness surface, and this
// bridge does not need one — a full store declines publication, counts the refusal, and the run is
// merely cold. Its realization is shared_typecheck_store PersistentTypedStore, held in lockstep by
// persist_cap_matches_modeled_authority.

data floor_typecheck_store_persist_cap_bytes: ByteSize = byte_size(count: 8589934592)

data floor_typecheck_store_persist_provider: CacheProvider = provider_row(
  id: floor_typecheck_store_persist_provider_id,
  scope: [floor_runner_host_frame()],
  coverage: CoversIdentities { identities: [floor_typecheck_store_identity] },
  tier: ArtifactTier { keying: ContentKeyed },
  retention: persistent_retention(capacity: CapacityBounded {
    limit: ByteCapacity { limit: ExactLimit { value: floor_typecheck_store_persist_cap_bytes } },
    at_capacity: RefuseNewStore
  })
)

// The two sibling processes that each demand union-typecheck-store(dag,src/v2) over one corpus
// under one built binary. They execute apart by construction, so the repetition between them is
// not authored duplication a rewire could remove — their obligation LCA is the runner host, which
// is not a shared-state frame, and only a STORE tier reaches across it. The demand nature is
// PureComputation: same module text, same resolved dependency closure, same compiler binary ⇒ same
// typed result, which is what makes ContentKeyed reuse sound here without declaring any staleness
// envelope. Nothing is read from the world.

fn floor_witness_fold_process_frame() -> std.materialization_ladder.Frame {
  std.materialization_ladder.Frame { name: "witness-fold-process", kind: SharedStateFrame }
}

fn floor_drift_gate_process_frame() -> std.materialization_ladder.Frame {
  std.materialization_ladder.Frame { name: "drift-gate-process", kind: SharedStateFrame }
}

fn floor_typecheck_store_cross_process_demands() -> List<FrameDemand> {
  [
    FrameDemand {
      identity: floor_typecheck_store_identity,
      site: [floor_runner_host_frame(), floor_witness_fold_process_frame()],
      nature: PureComputation
    },
    FrameDemand {
      identity: floor_typecheck_store_identity,
      site: [floor_runner_host_frame(), floor_drift_gate_process_frame()],
      nature: PureComputation
    }
  ]
}

data floor_typecheck_store_persist_providers: List<CacheProvider> = [floor_typecheck_store_persist_provider]

data floor_typecheck_store_no_cost_floor_exemptions: List<String> = []

fn floor_typecheck_store_persist_verdicts() -> List<LadderVerdict> {
  materialization_ladder(
    demands: floor_typecheck_store_cross_process_demands(),
    providers: floor_typecheck_store_persist_providers,
    cost_floor_exempt: floor_typecheck_store_no_cost_floor_exemptions
  )
}

// RED CONTROLS. Each is the SAME demand set with exactly one obligation withdrawn from the
// provider, so the green above is green because the ladder looked and admitted it, never because
// nothing looked. Each red names the DISTINCT refusal it must produce, so a provider that fails
// for the wrong reason does not pass as the right one.

data floor_typecheck_store_persist_provider_unbounded: CacheProvider = provider_row(
  id: floor_typecheck_store_persist_provider_id,
  scope: [floor_runner_host_frame()],
  coverage: CoversIdentities { identities: [floor_typecheck_store_identity] },
  tier: ArtifactTier { keying: ContentKeyed },
  retention: persistent_retention(capacity: CapacityUnbounded)
)

data floor_typecheck_store_persist_provider_unobserved: CacheProvider = provider_row(
  id: floor_typecheck_store_persist_provider_id,
  scope: [floor_runner_host_frame()],
  coverage: CoversIdentities { identities: [floor_typecheck_store_identity] },
  tier: ArtifactTier { keying: ContentKeyed },
  retention: persistent_retention(capacity: CapacityUnobserved)
)

// Scope too narrow: the in-process row cannot answer a cross-process demand. A reference does not
// survive the process that holds it, which is the whole reason this tier exists — so the existing
// C2 provider, offered alone against these two demands, must REFUSE rather than appear to cover
// them.

fn floor_typecheck_store_persist_verdicts_unbounded() -> List<LadderVerdict> {
  materialization_ladder(
    demands: floor_typecheck_store_cross_process_demands(),
    providers: [floor_typecheck_store_persist_provider_unbounded],
    cost_floor_exempt: floor_typecheck_store_no_cost_floor_exemptions
  )
}

fn floor_typecheck_store_persist_verdicts_unobserved() -> List<LadderVerdict> {
  materialization_ladder(
    demands: floor_typecheck_store_cross_process_demands(),
    providers: [floor_typecheck_store_persist_provider_unobserved],
    cost_floor_exempt: floor_typecheck_store_no_cost_floor_exemptions
  )
}

// The scope control is the SAME store row with only its scope withdrawn to one process — not the
// C2 ReferenceTier share, which is not a store tier at all and would refuse for the unrelated
// reason that no store provider exists. Withdrawing one obligation at a time is what makes each
// red name its own refusal.

data floor_typecheck_store_persist_provider_process_scoped: CacheProvider = provider_row(
  id: floor_typecheck_store_persist_provider_id,
  scope: [floor_executor_process_frame()],
  coverage: CoversIdentities { identities: [floor_typecheck_store_identity] },
  tier: ArtifactTier { keying: ContentKeyed },
  retention: persistent_retention(capacity: CapacityBounded {
    limit: ByteCapacity { limit: ExactLimit { value: floor_typecheck_store_persist_cap_bytes } },
    at_capacity: RefuseNewStore
  })
)

fn floor_typecheck_store_persist_verdicts_process_scoped() -> List<LadderVerdict> {
  materialization_ladder(
    demands: floor_typecheck_store_cross_process_demands(),
    providers: [floor_typecheck_store_persist_provider_process_scoped],
    cost_floor_exempt: floor_typecheck_store_no_cost_floor_exemptions
  )
}

fn floor_typecheck_store_persist_verdicts_without_provider() -> List<LadderVerdict> {
  materialization_ladder(
    demands: floor_typecheck_store_cross_process_demands(),
    providers: floor_typecheck_store_no_providers,
    cost_floor_exempt: floor_typecheck_store_no_cost_floor_exemptions
  )
}
