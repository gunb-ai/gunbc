module gunbc.os_install_actuator_selection



type OsInstallActuatorRequirementKind
  = BmcNetworkReach
  | ActuatorToolchainGrant
  | InstallMediaArtifactRealizable
  | InstallWindowAvailability

type OsInstallActuatorReachFacts {
  srv1_reaches_target_bmc: Bool
  srv2_reaches_target_bmc: Bool
}

type OsInstallActuatorTieBreakPolicy
  = OperatorHostPreference { order: List<product.placement_supply.HostIdentity> }
  | LeastLoadedHost

type OsInstallActuatorSelection
  = ActuatorSelected { host: gunbc.fleet_intent.ComputeHost }
  | ActuatorUnsatisfiable { reason: String }

data os_install_actuator_requirement_kinds: List<OsInstallActuatorRequirementKind> = [
  BmcNetworkReach,
  ActuatorToolchainGrant,
  InstallMediaArtifactRealizable,
  InstallWindowAvailability,
]

data srv3_os_install_actuator_candidate_hosts: List<gunbc.fleet_intent.ComputeHost> = [srv1_host, srv2_host]

data srv3_install_target_bmc_address: std.types.NonEmptyStr = asrock_srv3_live_bmc_host

type ActuatorToolchainHostObservation {
  host: product.placement_supply.HostIdentity
  satisfied: Bool
}

data srv1_actuator_toolchain_observation: ActuatorToolchainHostObservation = ActuatorToolchainHostObservation {
  host: operator_host_srv1,
  satisfied: true,
}

data srv1_install_window_load: Int = 13
data srv2_install_window_load: Int = 13

data srv2_actuator_toolchain_observation: ActuatorToolchainHostObservation = ActuatorToolchainHostObservation {
  host: operator_host_srv2,
  satisfied: true,
}

data srv3_os_install_actuator_per_host_observation_forks_dissolution_trigger: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.os_install_actuator_selection",
    decl_name: "OsInstallActuatorReachFacts",
    field: WholeDeclaration
  }
}

data srv3_os_install_actuator_host_unsatisfiable_fallback_dissolution_trigger: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.os_install_actuator_selection",
    decl_name: "srv3_os_install_actuator_host",
    field: WholeDeclaration
  }
}

data live_srv3_actuator_reach_facts: OsInstallActuatorReachFacts = OsInstallActuatorReachFacts {
  srv1_reaches_target_bmc: true,
  srv2_reaches_target_bmc: true,
}

data srv3_os_install_actuator_tie_break_policy: OsInstallActuatorTieBreakPolicy = OperatorHostPreference {
  order: [operator_host_srv1, operator_host_srv2],
}

fn host_identity_is_actuator_candidate(identity: product.placement_supply.HostIdentity) -> Bool {
  identity == operator_host_srv1 || identity == operator_host_srv2
}

fn host_identity_on_operator_lan(identity: product.placement_supply.HostIdentity) -> Bool {
  host_identity_is_actuator_candidate(identity: identity)
}

fn reach_fact_for_host(facts: OsInstallActuatorReachFacts, identity: product.placement_supply.HostIdentity) -> Bool {
  if identity == operator_host_srv1 {
    facts.srv1_reaches_target_bmc
  } else if identity == operator_host_srv2 {
    facts.srv2_reaches_target_bmc
  } else {
    false
  }
}

fn os_install_actuator_requirement_bmc_network_reach(
  candidate: gunbc.fleet_intent.ComputeHost,
  facts: OsInstallActuatorReachFacts,
) -> Bool {
  host_identity_on_operator_lan(identity: candidate.identity)
    && reach_fact_for_host(facts: facts, identity: candidate.identity)
    && network_reachability(from: HostLan, to: BmcManagement)
    && srv3_bmc_endpoint.address == srv3_install_target_bmc_address
    && srv3_bmc_endpoint.locality == Lan
    && operator_lan_segment.locality == Lan
}

fn optional_actuator_toolchain_observation_when_matching(
  row: ActuatorToolchainHostObservation,
  host: product.placement_supply.HostIdentity,
) -> ActuatorToolchainHostObservation? {
  if row.host == host {
    Present { value: row }
  } else {
    none
  }
}

fn actuator_toolchain_observation_for_host(
  host: product.placement_supply.HostIdentity,
) -> ActuatorToolchainHostObservation? {
  fold(
    [srv1_actuator_toolchain_observation, srv2_actuator_toolchain_observation],
    init: none,
    f: (acc, row) => {
      match acc {
        Present { value: _ } => acc
        Absent => optional_actuator_toolchain_observation_when_matching(row: row, host: host)
      }
    },
  )
}

fn actuator_host_satisfies_toolchain_requirement(
  host: product.placement_supply.HostIdentity,
  requirement: extdeps.bmc.os_install_actuator_toolchain.ActuatorToolchainRequirement,
) -> Bool {
  match actuator_toolchain_observation_for_host(host: host) {
    Present { value: row } =>
      row.satisfied
        && actuator_toolchain_requirement_is_complete(requirement: requirement)
    Absent => false
  }
}

fn os_install_actuator_requirement_toolchain_grant(candidate: gunbc.fleet_intent.ComputeHost) -> Bool {
  actuator_host_satisfies_toolchain_requirement(
    host: candidate.identity,
    requirement: os_install_actuator_toolchain_requirement,
  )
}

fn os_install_actuator_requirement_install_media_realizable(candidate: gunbc.fleet_intent.ComputeHost) -> Bool {
  host_identity_is_actuator_candidate(identity: candidate.identity)
}

fn install_window_load_for_host(identity: product.placement_supply.HostIdentity) -> Int {
  if identity == operator_host_srv1 {
    srv1_install_window_load
  } else if identity == operator_host_srv2 {
    srv2_install_window_load
  } else {
    0
  }
}

fn os_install_actuator_requirement_install_window_availability(candidate: gunbc.fleet_intent.ComputeHost) -> Bool {
  install_window_load_for_host(identity: candidate.identity) >= 0
}

fn os_install_actuator_requirement_satisfied(
  kind: OsInstallActuatorRequirementKind,
  candidate: gunbc.fleet_intent.ComputeHost,
  reach_facts: OsInstallActuatorReachFacts,
) -> Bool {
  match kind {
    BmcNetworkReach =>
      os_install_actuator_requirement_bmc_network_reach(candidate: candidate, facts: reach_facts)
    ActuatorToolchainGrant =>
      os_install_actuator_requirement_toolchain_grant(candidate: candidate)
    InstallMediaArtifactRealizable =>
      os_install_actuator_requirement_install_media_realizable(candidate: candidate)
    InstallWindowAvailability =>
      os_install_actuator_requirement_install_window_availability(candidate: candidate)
  }
}

fn accumulate_os_install_actuator_requirement_satisfaction(
  acc: Bool,
  kind: OsInstallActuatorRequirementKind,
  candidate: gunbc.fleet_intent.ComputeHost,
  reach_facts: OsInstallActuatorReachFacts,
) -> Bool {
  acc && os_install_actuator_requirement_satisfied(
    kind: kind,
    candidate: candidate,
    reach_facts: reach_facts,
  )
}

fn host_satisfies_os_install_actuator_requirements(
  candidate: gunbc.fleet_intent.ComputeHost,
  reach_facts: OsInstallActuatorReachFacts,
) -> Bool {
  fold(
    os_install_actuator_requirement_kinds,
    init: true,
    f: (acc, kind) => accumulate_os_install_actuator_requirement_satisfaction(
      acc: acc,
      kind: kind,
      candidate: candidate,
      reach_facts: reach_facts,
    ),
  )
}

fn optional_compute_host_when_identity_matches(
  host: gunbc.fleet_intent.ComputeHost,
  identity: product.placement_supply.HostIdentity,
) -> gunbc.fleet_intent.ComputeHost? {
  if host.identity == identity {
    Present { value: host }
  } else {
    none
  }
}

fn find_host_by_identity(hosts: List<gunbc.fleet_intent.ComputeHost>, identity: product.placement_supply.HostIdentity) -> gunbc.fleet_intent.ComputeHost? {
  fold(
    hosts,
    init: none,
    f: (acc, host) => {
      match acc {
        Present { value: _ } => acc
        Absent => optional_compute_host_when_identity_matches(host: host, identity: identity)
      }
    },
  )
}

fn accumulate_satisfying_actuator_hosts(
  acc: List<gunbc.fleet_intent.ComputeHost>,
  candidate: gunbc.fleet_intent.ComputeHost,
  reach_facts: OsInstallActuatorReachFacts,
) -> List<gunbc.fleet_intent.ComputeHost> {
  if host_satisfies_os_install_actuator_requirements(candidate: candidate, reach_facts: reach_facts) {
    concat(acc, [candidate])
  } else {
    acc
  }
}

fn satisfying_os_install_actuator_hosts(
  candidates: List<gunbc.fleet_intent.ComputeHost>,
  reach_facts: OsInstallActuatorReachFacts,
) -> List<gunbc.fleet_intent.ComputeHost> {
  fold(
    candidates,
    init: [],
    f: (acc, candidate) => accumulate_satisfying_actuator_hosts(
      acc: acc,
      candidate: candidate,
      reach_facts: reach_facts,
    ),
  )
}

fn select_by_operator_host_preference(
  satisfying: List<gunbc.fleet_intent.ComputeHost>,
  order: List<product.placement_supply.HostIdentity>,
) -> gunbc.fleet_intent.ComputeHost? {
  fold(
    order,
    init: none,
    f: (acc, preferred_id) => {
      match acc {
        Present { value: _ } => acc
        Absent => find_host_by_identity(hosts: satisfying, identity: preferred_id)
      }
    },
  )
}

fn prefer_least_loaded_actuator_host(current: gunbc.fleet_intent.ComputeHost, candidate: gunbc.fleet_intent.ComputeHost) -> gunbc.fleet_intent.ComputeHost? {
  if install_window_load_for_host(identity: candidate.identity) < install_window_load_for_host(identity: current.identity) {
    Present { value: candidate }
  } else {
    Present { value: current }
  }
}

fn select_by_least_loaded_host(satisfying: List<gunbc.fleet_intent.ComputeHost>) -> gunbc.fleet_intent.ComputeHost? {
  fold(
    satisfying,
    init: none,
    f: (acc, host) => {
      match acc {
        Absent => Present { value: host }
        Present { value: current } => prefer_least_loaded_actuator_host(current: current, candidate: host)
      }
    },
  )
}

fn apply_os_install_actuator_tie_break(
  satisfying: List<gunbc.fleet_intent.ComputeHost>,
  policy: OsInstallActuatorTieBreakPolicy,
) -> gunbc.fleet_intent.ComputeHost? {
  match policy {
    OperatorHostPreference { order: order } =>
      select_by_operator_host_preference(satisfying: satisfying, order: order)
    LeastLoadedHost =>
      select_by_least_loaded_host(satisfying: satisfying)
  }
}

fn select_os_install_actuator_host(
  candidates: List<gunbc.fleet_intent.ComputeHost>,
  reach_facts: OsInstallActuatorReachFacts,
  tie_break: OsInstallActuatorTieBreakPolicy,
) -> OsInstallActuatorSelection {
  let satisfying = satisfying_os_install_actuator_hosts(
    candidates: candidates,
    reach_facts: reach_facts,
  )
  if satisfying.length() == 0 {
    ActuatorUnsatisfiable {
      reason: "no candidate host satisfies OsInstallActuatorRequirement conjunction for srv3 install",
    }
  } else {
    match apply_os_install_actuator_tie_break(satisfying: satisfying, policy: tie_break) {
      Present { value: host } => ActuatorSelected { host: host }
      Absent =>
        ActuatorUnsatisfiable {
          reason: "tie-break policy failed to select among satisfying actuator hosts",
        }
    }
  }
}

data srv3_os_install_actuator_selection: OsInstallActuatorSelection = select_os_install_actuator_host(
  candidates: srv3_os_install_actuator_candidate_hosts,
  reach_facts: live_srv3_actuator_reach_facts,
  tie_break: srv3_os_install_actuator_tie_break_policy,
)

data srv3_os_install_actuator_host: gunbc.fleet_intent.ComputeHost = match srv3_os_install_actuator_selection {
  ActuatorSelected { host: h } => h
  ActuatorUnsatisfiable { reason: _ } => srv1_host
}

fn srv3_os_install_actuator_selection_is_selected_on_live_fleet() -> Bool {
  match srv3_os_install_actuator_selection {
    ActuatorSelected { host: _ } => true
    ActuatorUnsatisfiable { reason: _ } => false
  }
}

fn srv3_os_install_actuator_host_is_derived_srv1() -> Bool {
  match srv3_os_install_actuator_selection {
    ActuatorSelected { host: h } => h == srv1_host
    ActuatorUnsatisfiable { reason: _ } => false
  }
}

fn srv3_os_install_actuator_host_selected_because_requirements_and_policy() -> Bool {
  host_satisfies_os_install_actuator_requirements(
    candidate: srv1_host,
    reach_facts: live_srv3_actuator_reach_facts,
  )
    && host_satisfies_os_install_actuator_requirements(
      candidate: srv2_host,
      reach_facts: live_srv3_actuator_reach_facts,
    )
    && srv1_install_window_load == srv2_install_window_load
    && match srv3_os_install_actuator_tie_break_policy {
      OperatorHostPreference { order: order } => order.first() == operator_host_srv1
      LeastLoadedHost => false
    }
    && srv3_os_install_actuator_host_is_derived_srv1()
}

fn srv3_os_install_actuator_host_failover_fixture_selects_srv2() -> Bool {
  let failover_reach = OsInstallActuatorReachFacts {
    srv1_reaches_target_bmc: false,
    srv2_reaches_target_bmc: true,
  }
  match select_os_install_actuator_host(
    candidates: srv3_os_install_actuator_candidate_hosts,
    reach_facts: failover_reach,
    tie_break: srv3_os_install_actuator_tie_break_policy,
  ) {
    ActuatorSelected { host: h } => h == srv2_host
    ActuatorUnsatisfiable { reason: _ } => false
  }
}
