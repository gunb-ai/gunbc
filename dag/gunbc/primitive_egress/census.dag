// ---------------------------------------------------------------------------------------------
// INPUT CARRIERS. Every fold below takes its population as a PARAMETER, so a witness can supply a
// planted surface fact, edge or disposition row and watch one finding go red (DESIGN section 3:
// a witness discriminates at one interface). The production binding is in
// gunbc.primitive_egress.census_live, which is the only module that reads the live tree.
// ---------------------------------------------------------------------------------------------

// One spelling on one realization surface, before the join. `form` is the call form the surface
// realizes: the builtin registry types free calls, algebra templates type method calls, a contract
// row is formless, and an interpreter arm carries the form its arm family dispatches.
type SurfaceFact {
  surface: PrimitiveSurfaceAuthority
  spelling: String
  form: CallForm
  arm: String?
}

fn surface_fact(surface: PrimitiveSurfaceAuthority, spelling: String, form: CallForm) -> SurfaceFact {
  SurfaceFact { surface: surface, spelling: spelling, form: form, arm: none }
}

// An interpreter fact carries its arm identity so the qualification can see when one arm
// dispatches spellings of two identities (the D0 SurfaceJoinsTwoIdentities class).
fn surface_fact_on_arm(surface: PrimitiveSurfaceAuthority, spelling: String, form: CallForm, arm: String) -> SurfaceFact {
  SurfaceFact { surface: surface, spelling: spelling, form: form, arm: Present { value: arm } }
}

fn arm_call_form(form: InterpreterDispatchForm) -> CallForm {
  match form {
    FreeCall => FreeForm
    MethodCall => MethodForm
    ServiceDispatch => FormlessSurface
    NativeSpecial => FreeForm
    UnknownForm { label: _ } => FormlessSurface
  }
}

fn interpreter_arm_fact(arm: InterpreterPrimitiveDispatchArm) -> SurfaceFact {
  surface_fact_on_arm(surface: InterpreterDispatch, spelling: arm.authored_spelling as String, form: arm_call_form(form: arm.form), arm: arm.arm.identity as String)
}

// A roster row whose spelling names several operations with `|` (the Filesystem checkout
// carve-out: "Filesystem.Read|List") is one arm realizing two operations, and D13 grain is the
// operation: one surface fact per alternative, each carrying the service prefix.
fn interpreter_arm_facts(arm: InterpreterPrimitiveDispatchArm) -> List<SurfaceFact> {
  let spelling = arm.authored_spelling as String
  if string_contains(spelling, "|") {
    let parts = spelling |> split("|")
    let head = match parts |> first { Present { value: h } => h  Absent => spelling }
    let prefix = match head |> split(".") |> first { Present { value: p } => concat(p, ".")  Absent => "" }
    parts |> enumerate |> map(pair =>
      surface_fact_on_arm(
        surface: InterpreterDispatch,
        spelling: if pair.first == 0 { pair.second } else { concat(prefix, pair.second) },
        form: arm_call_form(form: arm.form),
        arm: arm.arm.identity as String,
      )
    )
  } else {
    [interpreter_arm_fact(arm: arm)]
  }
}

// The resolver's callee identity for one call site, as gunbc.v1 cli_run
// compile_dag_primitive_call_edges answers it. Only the first arm and the algebra arm carry an
// identity the resolver ESTABLISHED; the plain-method and undetermined arms carry a spelling the
// resolver could not bind, and the service arm is a bound-provider operation rather than a primitive.
type PrimitiveCalleeIdentity
  = RuntimePrimitiveCallee { primitive_name: String, projected_from_module: String?, projected_from_decl: String? }
  | AlgebraMethodCallee { template_name: String }
  | ServiceOperationCallee { service_name: String, operation: String }
  | PlainMethodCallee { spelling: String }
  | UndeterminedFreeCallee { spelling: String }

type PrimitiveCallEdge {
  caller_module: String
  caller_decl: String
  authored_spelling: String
  callee: PrimitiveCalleeIdentity
  span_file: String
  span_start: Int
}

type PrimitiveCallEntryRefusal {
  entry: String
  cause: String
}

type PrimitiveCallEdgeCensus
  = PrimitiveCallEdgeCensusRefused { cause: String }
  | PrimitiveCallEdgeCensusObserved {
      entries_resolved: List<String>
      entries_refused: List<PrimitiveCallEntryRefusal>
      edges: List<PrimitiveCallEdge>
    }

// ---------------------------------------------------------------------------------------------
// THE JOIN.
// ---------------------------------------------------------------------------------------------

type JoinedSurfaceFact {
  fact: SurfaceFact
  join: CanonicalJoin
}

fn join_surface_fact(fact: SurfaceFact) -> JoinedSurfaceFact {
  JoinedSurfaceFact { fact: fact, join: canonical_join(surface: Present { value: fact.surface }, spelling: fact.spelling) }
}

// Which layer a caller inhabits, read off the resolver's own module identity. `v2.` is src/v2 and
// `v1.` is the seed's own .dag; everything else is the dag/ layer. A test module in any layer is
// bucketed apart so production consumer counts are not inflated by witnesses.
type CallerLayer
  = V2Caller
  | V1Caller
  | DagCaller
  | TestCaller

fn caller_layer(module_path: String) -> CallerLayer {
  if starts_with(module_path, "test.") || string_contains(module_path, ".test.") || starts_with(module_path, "v2.test.") {
    TestCaller
  } else if starts_with(module_path, "v2.") {
    V2Caller
  } else if starts_with(module_path, "v1.") {
    V1Caller
  } else {
    DagCaller
  }
}

fn caller_layer_label(layer: CallerLayer) -> String {
  match layer {
    V2Caller => "v2"
    V1Caller => "v1"
    DagCaller => "dag"
    TestCaller => "test"
  }
}

// The consumer side of the join at identity grain: how many call sites reach the identity from
// each layer, through which route, and how many sites SPELL it without the resolver having
// established the callee.
type ConsumerTally {
  v2_sites: Int
  v1_sites: Int
  dag_sites: Int
  test_sites: Int
  v2_modules: List<String>
  v1_modules: List<String>
  dag_modules: List<String>
  test_modules: List<String>
  unresolved_sites: Int
  unresolved_callers: List<String>
}

fn empty_consumer_tally() -> ConsumerTally {
  ConsumerTally { v2_sites: 0, v1_sites: 0, dag_sites: 0, test_sites: 0, v2_modules: [], v1_modules: [], dag_modules: [], test_modules: [], unresolved_sites: 0, unresolved_callers: [] }
}

fn push_distinct(xs: List<String>, x: String) -> List<String> {
  if xs |> any(y => y == x) { xs } else { list_push(xs, x) }
}

fn tally_resolved(t: ConsumerTally, layer: CallerLayer, module: String) -> ConsumerTally {
  match layer {
    V2Caller => ConsumerTally { v2_sites: t.v2_sites + 1, v1_sites: t.v1_sites, dag_sites: t.dag_sites, test_sites: t.test_sites, v2_modules: push_distinct(xs: t.v2_modules, x: module), v1_modules: t.v1_modules, dag_modules: t.dag_modules, test_modules: t.test_modules, unresolved_sites: t.unresolved_sites, unresolved_callers: t.unresolved_callers }
    V1Caller => ConsumerTally { v2_sites: t.v2_sites, v1_sites: t.v1_sites + 1, dag_sites: t.dag_sites, test_sites: t.test_sites, v2_modules: t.v2_modules, v1_modules: push_distinct(xs: t.v1_modules, x: module), dag_modules: t.dag_modules, test_modules: t.test_modules, unresolved_sites: t.unresolved_sites, unresolved_callers: t.unresolved_callers }
    DagCaller => ConsumerTally { v2_sites: t.v2_sites, v1_sites: t.v1_sites, dag_sites: t.dag_sites + 1, test_sites: t.test_sites, v2_modules: t.v2_modules, v1_modules: t.v1_modules, dag_modules: push_distinct(xs: t.dag_modules, x: module), test_modules: t.test_modules, unresolved_sites: t.unresolved_sites, unresolved_callers: t.unresolved_callers }
    TestCaller => ConsumerTally { v2_sites: t.v2_sites, v1_sites: t.v1_sites, dag_sites: t.dag_sites, test_sites: t.test_sites + 1, v2_modules: t.v2_modules, v1_modules: t.v1_modules, dag_modules: t.dag_modules, test_modules: push_distinct(xs: t.test_modules, x: module), unresolved_sites: t.unresolved_sites, unresolved_callers: t.unresolved_callers }
  }
}

fn tally_unresolved(t: ConsumerTally, caller: String) -> ConsumerTally {
  ConsumerTally { v2_sites: t.v2_sites, v1_sites: t.v1_sites, dag_sites: t.dag_sites, test_sites: t.test_sites, v2_modules: t.v2_modules, v1_modules: t.v1_modules, dag_modules: t.dag_modules, test_modules: t.test_modules, unresolved_sites: t.unresolved_sites + 1, unresolved_callers: push_distinct(xs: t.unresolved_callers, x: caller) }
}

fn tally_total_sites(t: ConsumerTally) -> Int {
  t.v2_sites + t.v1_sites + t.dag_sites + t.test_sites
}

// How one edge joins: to a canonical identity as an ESTABLISHED consumer, to a canonical identity
// as a site the resolver left unresolved, to a service operation (not a primitive), or to a
// spelling on no surface at all. A service operation the interpreter realizes with a primitive
// arm of its own ("Filesystem.Read", "Filesystem.List") is a primitive identity at OPERATION
// grain; every other service operation is a bound-provider call by construction and a receipt
// count only (a record-field closure invoked as a method, an unresolved
// free call to nothing the census knows -- reported as a receipt count, never as an identity).
type EdgeJoin
  = EstablishedConsumer { identity: PrimitiveIdentity }
  | UnresolvedConsumer { identity: PrimitiveIdentity }
  | ServiceOperationSite { service_name: String, operation: String }
  | OffSurfaceSite { spelling: String }

fn edge_join(edge: PrimitiveCallEdge, on_surface: fn(PrimitiveIdentity) -> Bool) -> EdgeJoin {
  match edge.callee {
    RuntimePrimitiveCallee { primitive_name: n, projected_from_module: _, projected_from_decl: _ } =>
      EstablishedConsumer { identity: canonical_join(surface: none, spelling: n).identity }
    AlgebraMethodCallee { template_name: t } =>
      EstablishedConsumer { identity: canonical_join(surface: none, spelling: t).identity }
    ServiceOperationCallee { service_name: s, operation: op } => {
      let id = canonical_join(surface: none, spelling: concat(s, ".", op)).identity
      if on_surface(id) { EstablishedConsumer { identity: id } } else { ServiceOperationSite { service_name: s, operation: op } }
    }
    PlainMethodCallee { spelling: sp } => {
      let id = canonical_join(surface: none, spelling: sp).identity
      if on_surface(id) { UnresolvedConsumer { identity: id } } else { OffSurfaceSite { spelling: sp } }
    }
    UndeterminedFreeCallee { spelling: sp } => {
      let id = canonical_join(surface: none, spelling: sp).identity
      if on_surface(id) { UnresolvedConsumer { identity: id } } else { OffSurfaceSite { spelling: sp } }
    }
  }
}

type ConsumerFold {
  tallies: Map<String, ConsumerTally>
  service_sites: Int
  off_surface_sites: Int
  off_surface_spellings: List<String>
}

fn consumer_fold(edges: List<PrimitiveCallEdge>, on_surface: fn(PrimitiveIdentity) -> Bool) -> ConsumerFold {
  edges |> fold(
    init: ConsumerFold { tallies: empty_map(), service_sites: 0, off_surface_sites: 0, off_surface_spellings: [] },
    f: fn(acc, edge) {
      match edge_join(edge: edge, on_surface: on_surface) {
        EstablishedConsumer { identity: id } => {
          let key = identity_name(identity: id)
          let prior = match map_get(acc.tallies, key) { Present { value: t } => t  Absent => empty_consumer_tally() }
          ConsumerFold {
            tallies: map_insert(acc.tallies, key, tally_resolved(t: prior, layer: caller_layer(module_path: edge.caller_module), module: edge.caller_module)),
            service_sites: acc.service_sites, off_surface_sites: acc.off_surface_sites, off_surface_spellings: acc.off_surface_spellings,
          }
        }
        UnresolvedConsumer { identity: id } => {
          let key = identity_name(identity: id)
          let prior = match map_get(acc.tallies, key) { Present { value: t } => t  Absent => empty_consumer_tally() }
          ConsumerFold {
            tallies: map_insert(acc.tallies, key, tally_unresolved(t: prior, caller: concat(edge.caller_module, " ", edge.caller_decl))),
            service_sites: acc.service_sites, off_surface_sites: acc.off_surface_sites, off_surface_spellings: acc.off_surface_spellings,
          }
        }
        ServiceOperationSite { service_name: _, operation: _ } =>
          ConsumerFold { tallies: acc.tallies, service_sites: acc.service_sites + 1, off_surface_sites: acc.off_surface_sites, off_surface_spellings: acc.off_surface_spellings }
        OffSurfaceSite { spelling: sp } =>
          ConsumerFold { tallies: acc.tallies, service_sites: acc.service_sites, off_surface_sites: acc.off_surface_sites + 1, off_surface_spellings: push_distinct(xs: acc.off_surface_spellings, x: sp) }
      }
    }
  )
}

// ---------------------------------------------------------------------------------------------
// IDENTITY STANDING: the second projection the contract asks for -- current route state,
// separately from the semantic class.
// ---------------------------------------------------------------------------------------------

// The evidence join, then the DERIVED disposition. Exactly one evidence row per identity is the
// precondition; the class is a function of that row and the derived seed-growth ownership.
type DispositionMatch
  = ExactlyOneDisposition { evidence: PrimitiveEvidence, qualified: QualifiedEvidence, disposition: PrimitiveDisposition }
  | NoDisposition
  | MultipleDispositions { rows: List<PrimitiveEvidence> }

type IdentityStanding {
  identity: PrimitiveIdentity
  name: String
  spellings: List<String>
  facts: List<JoinedSurfaceFact>
  contract: Bool
  registry: Bool
  algebra: Bool
  interpreter_arm: Bool
  emit_bridge: Bool
  interpreter_arm_count: Int
  modeled_bodies: List<DeclarationRef>
  host_seams: List<DeclarationRef>
  divergent_bodies: List<DeclarationRef>
  consumers: ConsumerTally
  disposition: DispositionMatch
  seed_growth: SeedGrowthOwnership
}

fn facts_carry_surface(facts: List<JoinedSurfaceFact>, surface: PrimitiveSurfaceAuthority) -> Bool {
  facts |> any(f => f.fact.surface == surface)
}

fn count_surface(facts: List<JoinedSurfaceFact>, surface: PrimitiveSurfaceAuthority) -> Int {
  count(facts |> filter(f => f.fact.surface == surface))
}

fn distinct_joined_identities(joined: List<JoinedSurfaceFact>) -> List<PrimitiveIdentity> {
  joined |> fold(init: [], f: fn(acc, j) {
    if acc |> any(id => primitive_identity_eq(left: id, right: j.join.identity)) { acc } else { list_push(acc, j.join.identity) }
  })
}

fn projection_declarations(rows: List<PrimitiveProjection>, identity: PrimitiveIdentity, wanted: fn(ProjectionFidelity) -> Bool) -> List<DeclarationRef> {
  rows
    |> filter(fn(r) { primitive_identity_eq(left: r.primitive, right: identity) && wanted(r.fidelity) })
    |> map(r => r.declaration)
}

fn is_modeled(f: ProjectionFidelity) -> Bool {
  match f { ModeledProjection => true  HostRealizedSeam => false  DivergentProjection { divergence: _ } => false }
}

fn is_host_seam(f: ProjectionFidelity) -> Bool {
  match f { HostRealizedSeam => true  ModeledProjection => false  DivergentProjection { divergence: _ } => false }
}

fn is_divergent(f: ProjectionFidelity) -> Bool {
  match f { DivergentProjection { divergence: _ } => true  ModeledProjection => false  HostRealizedSeam => false }
}

fn disposition_match(rows: List<PrimitiveEvidence>, identity: PrimitiveIdentity, ownership: SeedGrowthOwnership, ctx: QualificationContext) -> DispositionMatch {
  let matches = rows |> filter(fn(r) { primitive_identity_eq(left: r.identity, right: identity) })
  let n = count(matches)
  if n == 0 { NoDisposition }
  else if n == 1 {
    match matches |> first {
      Present { value: r } => {
        let qualified = qualify_evidence(e: r, ctx: ctx)
        ExactlyOneDisposition { evidence: r, qualified: qualified, disposition: derive_primitive_disposition(e: qualified, ownership: ownership) }
      }
      Absent => NoDisposition
    }
  }
  else { MultipleDispositions { rows: matches } }
}

// THE QUALIFICATION CONTEXT FOR ONE IDENTITY: the resolver the census was handed, and the facts
// the surface join established for this identity (algebra template present, interpreter arm
// present, a ServiceDispatch arm, an arm shared with another identity, its projection rows).
fn arm_shared_with_another_identity(joined: List<JoinedSurfaceFact>, identity: PrimitiveIdentity) -> Bool {
  let own_arms = joined
    |> filter(fn(j) { primitive_identity_eq(left: j.join.identity, right: identity) })
    |> fold(init: [], f: fn(acc, j) { match j.fact.arm { Present { value: a } => push_distinct(xs: acc, x: a)  Absent => acc } })
  joined |> any(fn(j) {
    match j.fact.arm {
      Present { value: a } => (own_arms |> any(x => x == a)) && !primitive_identity_eq(left: j.join.identity, right: identity)
      Absent => false
    }
  })
}

fn qualification_context_for(identity: PrimitiveIdentity, facts: List<JoinedSurfaceFact>, joined: List<JoinedSurfaceFact>, projections: List<PrimitiveProjection>, resolve: fn(DeclarationRef) -> DeclarationRefResolution, witness_prefixes: List<String>) -> QualificationContext {
  QualificationContext {
    resolve: resolve,
    has_algebra_template: facts_carry_surface(facts: facts, surface: AlgebraTemplate),
    has_interpreter_arm: facts_carry_surface(facts: facts, surface: InterpreterDispatch),
    has_service_dispatch_form: facts |> any(fn(f) { match f.fact.arm { Present { value: a } => starts_with(a, "service_dispatch.")  Absent => false } }),
    arm_shared_with_another_identity: arm_shared_with_another_identity(joined: joined, identity: identity),
    projection_declarations: projections |> filter(fn(r) { primitive_identity_eq(left: r.primitive, right: identity) }) |> map(r => r.declaration),
    witness_module_prefixes: witness_prefixes,
  }
}

// Seed-growth ownership joins the primitive's runtime name against the declarations every
// SeedGrowthJustification row enumerates. A primitive whose host realization is declared under a
// different name answers NoSeedGrowthRow, which is reported, never silently owned.
fn seed_growth_ownership(decls: List<DeclarationRef>, name: String, evidence: List<PrimitiveEvidence>) -> SeedGrowthOwnership {
  let producers = evidence |> fold(init: [], f: fn(acc, e) {
    match e.compiler_query {
      QueryOverAcceptedProduct { judgment_subject: _, accepted_compiler_product: _, current_host_producer: p, deletion_trigger: _ } => list_push(acc, p)
      NotACompilerQuery => acc
    }
  })
  let owned = decls |> filter(fn(d) { d.decl_name == name || (producers |> any(fn(p) { p.module_path == d.module_path && p.decl_name == d.decl_name })) })
  if count(owned) == 0 { NoSeedGrowthRow } else { SeedGrowthRows { declarations: owned } }
}

fn identity_standing(
  identity: PrimitiveIdentity,
  joined: List<JoinedSurfaceFact>,
  projections: List<PrimitiveProjection>,
  consumers: ConsumerFold,
  dispositions: List<PrimitiveEvidence>,
  seed_growth_decls: List<DeclarationRef>,
  resolve: fn(DeclarationRef) -> DeclarationRefResolution,
  witness_prefixes: List<String>,
) -> IdentityStanding {
  let name = identity_name(identity: identity)
  let facts = joined |> filter(fn(j) { primitive_identity_eq(left: j.join.identity, right: identity) })
  let own_rows = dispositions |> filter(fn(r) { primitive_identity_eq(left: r.identity, right: identity) })
  let ownership = seed_growth_ownership(decls: seed_growth_decls, name: name, evidence: own_rows)
  IdentityStanding {
    identity: identity,
    name: name,
    spellings: facts |> fold(init: [], f: fn(acc, f) { push_distinct(xs: acc, x: f.fact.spelling) }),
    facts: facts,
    contract: facts_carry_surface(facts: facts, surface: PrimitiveContractRow),
    registry: facts_carry_surface(facts: facts, surface: BuiltinRegistry),
    algebra: facts_carry_surface(facts: facts, surface: AlgebraTemplate),
    interpreter_arm: facts_carry_surface(facts: facts, surface: InterpreterDispatch),
    emit_bridge: facts_carry_surface(facts: facts, surface: EmitHandler),
    interpreter_arm_count: count_surface(facts: facts, surface: InterpreterDispatch),
    modeled_bodies: projection_declarations(rows: projections, identity: identity, wanted: is_modeled),
    host_seams: projection_declarations(rows: projections, identity: identity, wanted: is_host_seam),
    divergent_bodies: projection_declarations(rows: projections, identity: identity, wanted: is_divergent),
    consumers: match map_get(consumers.tallies, name) { Present { value: t } => t  Absent => empty_consumer_tally() },
    disposition: disposition_match(rows: dispositions, identity: identity, ownership: ownership, ctx: qualification_context_for(identity: identity, facts: facts, joined: joined, projections: projections, resolve: resolve, witness_prefixes: witness_prefixes)),
    seed_growth: ownership,
  }
}

// ---------------------------------------------------------------------------------------------
// THE CENSUS.
// ---------------------------------------------------------------------------------------------

type CensusInputs {
  surface_facts: List<SurfaceFact>
  edges: List<PrimitiveCallEdge>
  entries_refused: List<PrimitiveCallEntryRefusal>
  projections: List<PrimitiveProjection>
  dispositions: List<PrimitiveEvidence>
  seed_growth_decls: List<DeclarationRef>
  resolve: fn(DeclarationRef) -> DeclarationRefResolution
  witness_module_prefixes: List<String>
}

// Which population first brought an identity into the universe -- carried so the receipt can
// say that an identity exists because a consumer resolved to it, or because a projection or a
// seed-growth row names it, even when no realization surface carries its spelling.
type IdentityOrigin
  = OnRealizationSurface
  | ConsumerEstablishedOnly
  | ProjectionOnly
  | SeedGrowthOnly

type IdentityOriginRow {
  identity: PrimitiveIdentity
  origin: IdentityOrigin
}

type PrimitiveCensus {
  standings: List<IdentityStanding>
  origins: List<IdentityOriginRow>
  consumer_fold: ConsumerFold
  entries_refused: List<PrimitiveCallEntryRefusal>
  dispositions_naming_no_identity: List<PrimitiveEvidence>
}

fn push_identity(acc: List<PrimitiveIdentity>, id: PrimitiveIdentity) -> List<PrimitiveIdentity> {
  if identity_listed(identities: acc, id: id) { acc } else { list_push(acc, id) }
}

// The identities a resolver-established consumer edge names, joined canonically. A service
// operation names an operation-grain identity ("Filesystem.Read"); it enters the universe only
// through a realization surface (the interpreter carve-out), so here it is not minted -- every
// other service call is a bound-provider call, not a primitive.
fn consumer_established_identities(edges: List<PrimitiveCallEdge>) -> List<PrimitiveIdentity> {
  edges |> fold(init: [], f: fn(acc, edge) {
    match edge.callee {
      RuntimePrimitiveCallee { primitive_name: n, projected_from_module: _, projected_from_decl: _ } =>
        push_identity(acc: acc, id: canonical_join(surface: none, spelling: n).identity)
      AlgebraMethodCallee { template_name: t } =>
        push_identity(acc: acc, id: canonical_join(surface: none, spelling: t).identity)
      ServiceOperationCallee { service_name: _, operation: _ } => acc
      PlainMethodCallee { spelling: _ } => acc
      UndeterminedFreeCallee { spelling: _ } => acc
    }
  })
}

fn projection_identities(projections: List<PrimitiveProjection>) -> List<PrimitiveIdentity> {
  projections |> fold(init: [], f: fn(acc, p) { push_identity(acc: acc, id: p.primitive) })
}

// A seed-growth declaration names a primitive identity through an EXPLICIT mapping: an evidence
// row whose compiler-query standing names that declaration as the current host producer. The
// declaration then owns the identity (seed_growth_ownership) and, if no other population carries
// it, brings it into the universe as SeedGrowthOnly. A seed-growth helper no row names is not a
// primitive and mints nothing; an evidence row whose producer no seed-growth row owns is the
// typed refusal SeedGrowthOwnershipAbsent, derived at classification.
fn producer_is_owned(decls: List<DeclarationRef>, producer: DeclarationRef) -> Bool {
  decls |> any(fn(d) { d.module_path == producer.module_path && d.decl_name == producer.decl_name })
}

fn seed_growth_identities(decls: List<DeclarationRef>, evidence: List<PrimitiveEvidence>) -> List<PrimitiveIdentity> {
  evidence |> fold(init: [], f: fn(acc, e) {
    match e.compiler_query {
      QueryOverAcceptedProduct { judgment_subject: _, accepted_compiler_product: _, current_host_producer: p, deletion_trigger: _ } =>
        if producer_is_owned(decls: decls, producer: p) { push_identity(acc: acc, id: e.identity) } else { acc }
      NotACompilerQuery => acc
    }
  })
}

type IdentityUniverse {
  identities: List<PrimitiveIdentity>
  origins: List<IdentityOriginRow>
}

// THE DENOMINATOR IS THE UNION, BUILT BEFORE ANY STANDING: realization-surface identities,
// resolver-established consumer identities, projection identities, and seed-growth-mapped
// identities. An identity from any one of them receives a standing; nothing attached later can
// introduce or lose one.
fn identity_universe(joined: List<JoinedSurfaceFact>, edges: List<PrimitiveCallEdge>, projections: List<PrimitiveProjection>, seed_growth_decls: List<DeclarationRef>, evidence: List<PrimitiveEvidence>) -> IdentityUniverse {
  let surface = distinct_joined_identities(joined: joined)
  let step1 = surface |> fold(init: IdentityUniverse { identities: [], origins: [] }, f: fn(u, id) {
    IdentityUniverse { identities: push_identity(acc: u.identities, id: id), origins: list_push(u.origins, IdentityOriginRow { identity: id, origin: OnRealizationSurface }) }
  })
  let step2 = consumer_established_identities(edges: edges) |> fold(init: step1, f: fn(u, id) {
    if identity_listed(identities: u.identities, id: id) { u } else {
      IdentityUniverse { identities: list_push(u.identities, id), origins: list_push(u.origins, IdentityOriginRow { identity: id, origin: ConsumerEstablishedOnly }) }
    }
  })
  let step3 = projection_identities(projections: projections) |> fold(init: step2, f: fn(u, id) {
    if identity_listed(identities: u.identities, id: id) { u } else {
      IdentityUniverse { identities: list_push(u.identities, id), origins: list_push(u.origins, IdentityOriginRow { identity: id, origin: ProjectionOnly }) }
    }
  })
  seed_growth_identities(decls: seed_growth_decls, evidence: evidence) |> fold(init: step3, f: fn(u, id) {
    if identity_listed(identities: u.identities, id: id) { u } else {
      IdentityUniverse { identities: list_push(u.identities, id), origins: list_push(u.origins, IdentityOriginRow { identity: id, origin: SeedGrowthOnly }) }
    }
  })
}

fn primitive_census(inputs: CensusInputs) -> PrimitiveCensus {
  let joined = inputs.surface_facts |> map(f => join_surface_fact(fact: f))
  let universe = identity_universe(joined: joined, edges: inputs.edges, projections: inputs.projections, seed_growth_decls: inputs.seed_growth_decls, evidence: inputs.dispositions)
  let identities = universe.identities
  let on_surface = fn(id) { identity_listed(identities: identities, id: id) }
  let consumers = consumer_fold(edges: inputs.edges, on_surface: on_surface)
  PrimitiveCensus {
    standings: identities |> map(id => identity_standing(
      identity: id, joined: joined, projections: inputs.projections, consumers: consumers,
      dispositions: inputs.dispositions, seed_growth_decls: inputs.seed_growth_decls,
      resolve: inputs.resolve, witness_prefixes: inputs.witness_module_prefixes,
    )),
    origins: universe.origins,
    consumer_fold: consumers,
    entries_refused: inputs.entries_refused,
    dispositions_naming_no_identity: inputs.dispositions |> filter(fn(r) { !identity_listed(identities: identities, id: r.identity) }),
  }
}

// ---------------------------------------------------------------------------------------------
// FINDINGS. Each is an identity LIST; a count is rendered from it, never authored.
// ---------------------------------------------------------------------------------------------

fn standings_where(c: PrimitiveCensus, p: fn(IdentityStanding) -> Bool) -> List<IdentityStanding> {
  c.standings |> filter(p)
}

fn registry_without_contract(c: PrimitiveCensus) -> List<IdentityStanding> {
  standings_where(c: c, p: fn(s) { s.registry && !s.contract })
}

fn contract_without_interpreter_arm(c: PrimitiveCensus) -> List<IdentityStanding> {
  standings_where(c: c, p: fn(s) { s.contract && !s.interpreter_arm })
}

fn interpreter_arm_without_contract(c: PrimitiveCensus) -> List<IdentityStanding> {
  standings_where(c: c, p: fn(s) { s.interpreter_arm && !s.contract })
}

fn has_any_consumer(s: IdentityStanding) -> Bool {
  tally_total_sites(t: s.consumers) > 0
}

fn emitted_bridge_without_consumer(c: PrimitiveCensus) -> List<IdentityStanding> {
  standings_where(c: c, p: fn(s) { s.emit_bridge && !has_any_consumer(s: s) })
}

fn unused_primitives(c: PrimitiveCensus) -> List<IdentityStanding> {
  standings_where(c: c, p: fn(s) { !has_any_consumer(s: s) && s.consumers.unresolved_sites == 0 })
}

fn consumers_with_unresolved_callee(c: PrimitiveCensus) -> List<IdentityStanding> {
  standings_where(c: c, p: fn(s) { s.consumers.unresolved_sites > 0 })
}

// An identity realized by more than one interpreter arm, or by an interpreter arm AND a modeled
// .dag body the builtin intercept shadows: two routes that can disagree about one meaning.
fn duplicate_realizations(c: PrimitiveCensus) -> List<IdentityStanding> {
  standings_where(c: c, p: fn(s) { s.interpreter_arm_count > 1 || (s.interpreter_arm && count(s.modeled_bodies) > 0) })
}

fn interpreter_arm_without_emitted_route(c: PrimitiveCensus) -> List<IdentityStanding> {
  standings_where(c: c, p: fn(s) { s.interpreter_arm && !s.emit_bridge && count(s.modeled_bodies) == 0 && s.consumers.v2_sites > 0 })
}

fn zero_disposition(c: PrimitiveCensus) -> List<IdentityStanding> {
  standings_where(c: c, p: fn(s) { match s.disposition { NoDisposition => true  ExactlyOneDisposition { evidence: _, qualified: _, disposition: _ } => false  MultipleDispositions { rows: _ } => false } })
}

fn multiple_disposition(c: PrimitiveCensus) -> List<IdentityStanding> {
  standings_where(c: c, p: fn(s) { match s.disposition { MultipleDispositions { rows: _ } => true  ExactlyOneDisposition { evidence: _, qualified: _, disposition: _ } => false  NoDisposition => false } })
}

fn exactly_one_disposition(c: PrimitiveCensus) -> List<IdentityStanding> {
  standings_where(c: c, p: fn(s) { match s.disposition { ExactlyOneDisposition { evidence: _, qualified: _, disposition: _ } => true  MultipleDispositions { rows: _ } => false  NoDisposition => false } })
}

fn standing_disposition_class(s: IdentityStanding) -> DispositionClass? {
  match s.disposition {
    ExactlyOneDisposition { evidence: _, qualified: _, disposition: d } => Present { value: disposition_class(d: d) }
    NoDisposition => none
    MultipleDispositions { rows: _ } => none
  }
}

fn standings_of_origin(c: PrimitiveCensus, wanted: IdentityOrigin) -> List<IdentityStanding> {
  let ids = c.origins |> filter(fn(o) { origin_label(o: o.origin) == origin_label(o: wanted) }) |> map(o => o.identity)
  standings_where(c: c, p: fn(s) { identity_listed(identities: ids, id: s.identity) })
}

fn origin_label(o: IdentityOrigin) -> String {
  match o {
    OnRealizationSurface => "surface"
    ConsumerEstablishedOnly => "consumer_only"
    ProjectionOnly => "projection_only"
    SeedGrowthOnly => "seed_growth_only"
  }
}

fn consumer_only_identities(c: PrimitiveCensus) -> List<IdentityStanding> { standings_of_origin(c: c, wanted: ConsumerEstablishedOnly) }
fn projection_only_identities(c: PrimitiveCensus) -> List<IdentityStanding> { standings_of_origin(c: c, wanted: ProjectionOnly) }
fn seed_growth_only_identities(c: PrimitiveCensus) -> List<IdentityStanding> { standings_of_origin(c: c, wanted: SeedGrowthOnly) }

fn standings_of_class(c: PrimitiveCensus, wanted: DispositionClass) -> List<IdentityStanding> {
  standings_where(c: c, p: fn(s) {
    match standing_disposition_class(s: s) {
      Present { value: k } => disposition_class_label(c: k) == disposition_class_label(c: wanted)
      Absent => false
    }
  })
}

fn unresolved_standings(c: PrimitiveCensus) -> List<IdentityStanding> {
  standings_of_class(c: c, wanted: UnresolvedClass)
}

fn v2_projection(c: PrimitiveCensus) -> List<IdentityStanding> {
  standings_where(c: c, p: fn(s) { s.consumers.v2_sites > 0 })
}

fn v1_only_projection(c: PrimitiveCensus) -> List<IdentityStanding> {
  standings_where(c: c, p: fn(s) { s.consumers.v1_sites > 0 && s.consumers.v2_sites == 0 && s.consumers.dag_sites == 0 })
}

fn shared_v1_v2_identities(c: PrimitiveCensus) -> List<IdentityStanding> {
  standings_where(c: c, p: fn(s) { s.consumers.v1_sites > 0 && s.consumers.v2_sites > 0 })
}

fn aliased_identities(c: PrimitiveCensus) -> List<IdentityStanding> {
  standings_where(c: c, p: fn(s) { count(s.spellings) > 1 })
}

fn compiler_query_without_seed_growth_row(c: PrimitiveCensus) -> List<IdentityStanding> {
  standings_of_class(c: c, wanted: CompilerQueryFrontierClass)
    |> filter(fn(s) { match s.seed_growth { NoSeedGrowthRow => true  SeedGrowthRows { declarations: _ } => false } })
}

// ---------------------------------------------------------------------------------------------
// THE EXIT STANDING. The landing bar from the acceptance contract: every joined identity carries
// exactly one disposition, no disposition row names an identity outside the join, and no
// production entry was refused by the resolver. Unresolved identities do NOT fail the census;
// they are explicit and migration-blocking for their own primitive.
// ---------------------------------------------------------------------------------------------

type CensusStanding
  = CensusHeld
  | CensusDidNotHold { cause: NonEmptyStr }
  | CensusRefused { cause: NonEmptyStr }

fn names_of(ss: List<IdentityStanding>) -> String {
  ss |> map(s => s.name) |> join(separator: ",")
}

fn census_standing(c: PrimitiveCensus) -> CensusStanding {
  if count(c.entries_refused) > 0 {
    CensusRefused { cause: concat("resolver refused ", to_string(count(c.entries_refused)), " admitted entries; the consumer population is incomplete: ", c.entries_refused |> map(r => r.entry) |> join(separator: ",")) as NonEmptyStr }
  } else if count(c.standings) == 0 {
    CensusRefused { cause: "no primitive identity joined any surface" as NonEmptyStr }
  } else if count(zero_disposition(c: c)) > 0 {
    CensusDidNotHold { cause: concat("identities with no disposition: ", names_of(ss: zero_disposition(c: c))) as NonEmptyStr }
  } else if count(multiple_disposition(c: c)) > 0 {
    CensusDidNotHold { cause: concat("identities with more than one disposition: ", names_of(ss: multiple_disposition(c: c))) as NonEmptyStr }
  } else if count(c.dispositions_naming_no_identity) > 0 {
    CensusDidNotHold { cause: concat("disposition rows naming no joined identity: ", c.dispositions_naming_no_identity |> map(r => identity_name(identity: r.identity)) |> join(separator: ",")) as NonEmptyStr }
  } else {
    CensusHeld
  }
}

fn identity_listed(identities: List<PrimitiveIdentity>, id: PrimitiveIdentity) -> Bool {
  identities |> any(x => primitive_identity_eq(left: x, right: id))
}
