module gunbc.primitive_egress.dispositions_collection

import std.types { Bool, Int, List, NonEmptyStr, String }
import std.decl_ref { decl_ref }
import gunbc.primitive_egress.category { PrimitiveCategory, TextOps, NumericBit, Crypto, Encoding, Unicode, ProcessEffect, MeasurementEffect, PointerIdentity, CollectionKernel, LanguageKernel, SeedQuery, ContentHash, ClockEffect, NetworkEffect, EntropyEffect, AuthContextEffect, FilesystemEffect, DemandBinding }
import gunbc.primitive_egress.disposition {
  PrimitiveDispositionRow, DagBodyRequired, ReferenceBodyAbsent, ContractAbsent, ConflictingRealizations, SubjectUnestablished,
  PureDagComputationClass, BoundHostEffectClass, TargetKernelRealizationClass, CompilerQueryFrontierClass, UnresolvedClass,
  pure_dag, host_effect, target_kernel, compiler_query, unresolved, mixed, authority, authority_required, body_at,
  provider_required, provider_declared, reference_at, unqualified, qualified_by,
}

// COLLECTION and LANGUAGE-KERNEL identities, classified per the container ruling pinned on
// gunbc#11626: modeled pure operations, faithful target kernels selected THROUGH the operation
// authority, and kernel constructors/eliminators that the census cannot yet call operations.
fn dispositions_collection_rows() -> List<PrimitiveDispositionRow> {
  [
    pure_dag(name: "reverse", category: CollectionKernel, authority: authority(module_path: "std.algebra", decl_name: "free_monoid_collection_templates"), inputs: "xs: FreeMonoid<T>", result: "the reversed sequence", body: DagBodyRequired),
    pure_dag(name: "set_union", category: CollectionKernel, authority: authority(module_path: "std.algebra", decl_name: "finite_power_set_templates"), inputs: "a, b: FinitePowerSet<T>", result: "the union; key equality is the T Eq instance", body: DagBodyRequired),
    pure_dag(name: "map_merge", category: CollectionKernel, authority: authority(module_path: "std.algebra", decl_name: "finitely_supported_function_templates"), inputs: "base, overlay: Map<K,V>", result: "the map with overlay winning on shared keys (duplicate-key policy is the modeled fact the ruling requires)", body: DagBodyRequired),
    pure_dag(name: "map_keys", category: CollectionKernel, authority: authority(module_path: "std.algebra", decl_name: "finitely_supported_function_templates"), inputs: "m: Map<K,V>", result: "List<K> in HOST-UNSPECIFIED order (std.primitive_identity primitive_map_keys_traversal); every consumer that emits must use sorted_map_keys", body: DagBodyRequired),
    pure_dag(name: "sorted_map_keys", category: CollectionKernel, authority: authority_required(home: "std.algebra: a finitely-supported-function template beside map_keys (std.primitive_identity records its absence)"), inputs: "m: Map<K,V> with K: Ord", result: "List<K> in canonical order", body: DagBodyRequired),
    pure_dag(name: "map_values", category: CollectionKernel, authority: authority(module_path: "std.algebra", decl_name: "finitely_supported_function_templates"), inputs: "m: Map<K,V>", result: "List<V> in host-unspecified order", body: DagBodyRequired),
    pure_dag(name: "list_push", category: CollectionKernel, authority: authority(module_path: "std.algebra", decl_name: "free_monoid_collection_templates"), inputs: "xs: FreeMonoid<T>, x: T", result: "xs with x appended; amortized O(1) per list_push_contract", body: DagBodyRequired),
    pure_dag(name: "map", category: CollectionKernel, authority: authority(module_path: "std.algebra", decl_name: "free_monoid_collection_templates"), inputs: "xs: FreeMonoid<T>, f: fn(T) -> U", result: "FreeMonoid<U> in source order", body: DagBodyRequired),
    pure_dag(name: "filter", category: CollectionKernel, authority: authority(module_path: "std.algebra", decl_name: "free_monoid_collection_templates"), inputs: "xs, pred", result: "the order-preserving subsequence", body: DagBodyRequired),
    pure_dag(name: "filter_map", category: CollectionKernel, authority: authority(module_path: "std.primitives", decl_name: "filter_map_contract"), inputs: "xs, f: fn(T) -> U?", result: "the Present results in order; contract only, no realization on any surface", body: DagBodyRequired),
    pure_dag(name: "flat_map", category: CollectionKernel, authority: authority(module_path: "std.algebra", decl_name: "free_monoid_collection_templates"), inputs: "xs, f: fn(T) -> FreeMonoid<U>", result: "the concatenation in order", body: DagBodyRequired),
    pure_dag(name: "fold_list", category: CollectionKernel, authority: authority(module_path: "std.algebra", decl_name: "free_monoid_collection_templates"), inputs: "xs, init, f", result: "the left fold in source order (SourcePreservingOrder); spelled fold on the algebra/contract surfaces and fold_list on the interpreter/emit surfaces (primitive_fold_list_spelling_fork_note)", body: DagBodyRequired),
    pure_dag(name: "fold_list_right", category: CollectionKernel, authority: authority_required(home: "std.algebra free_monoid_collection_templates (a right-fold template beside fold)"), inputs: "xs, init, f", result: "the right fold; interpreter native intercept only, no contract, template or bridge", body: DagBodyRequired),
    pure_dag(name: "any", category: CollectionKernel, authority: authority(module_path: "std.algebra", decl_name: "free_monoid_collection_templates"), inputs: "xs, pred", result: "Bool", body: DagBodyRequired),
    pure_dag(name: "all", category: CollectionKernel, authority: authority(module_path: "std.algebra", decl_name: "free_monoid_collection_templates"), inputs: "xs, pred", result: "Bool", body: DagBodyRequired),
    pure_dag(name: "first", category: CollectionKernel, authority: authority(module_path: "std.algebra", decl_name: "free_monoid_collection_templates"), inputs: "xs", result: "T?: Absent on empty", body: DagBodyRequired),
    pure_dag(name: "last", category: CollectionKernel, authority: authority(module_path: "std.algebra", decl_name: "free_monoid_collection_templates"), inputs: "xs", result: "T?: Absent on empty", body: DagBodyRequired),
    pure_dag(name: "skip", category: CollectionKernel, authority: authority(module_path: "std.algebra", decl_name: "free_monoid_collection_templates"), inputs: "xs, n", result: "the suffix after n", body: DagBodyRequired),
    pure_dag(name: "take", category: CollectionKernel, authority: authority(module_path: "std.algebra", decl_name: "free_monoid_collection_templates"), inputs: "xs, n", result: "the prefix of n", body: DagBodyRequired),
    pure_dag(name: "sort_by", category: CollectionKernel, authority: authority(module_path: "std.algebra", decl_name: "free_monoid_collection_templates"), inputs: "xs, key: fn(T) -> K", result: "the stable sort by key", body: DagBodyRequired),
    pure_dag(name: "sort", category: CollectionKernel, authority: authority(module_path: "std.primitives", decl_name: "sort_contract"), inputs: "xs: FreeMonoid<T> with T: Ord", result: "the sorted sequence; contract only, no realization", body: DagBodyRequired),
    pure_dag(name: "dedup", category: CollectionKernel, authority: authority(module_path: "std.primitives", decl_name: "dedup_contract"), inputs: "xs", result: "first occurrences in order; contract only, no realization", body: DagBodyRequired),
    pure_dag(name: "enumerate", category: CollectionKernel, authority: authority(module_path: "std.algebra", decl_name: "free_monoid_collection_templates"), inputs: "xs", result: "pairs (index, element)", body: DagBodyRequired),
    pure_dag(name: "zip", category: CollectionKernel, authority: authority(module_path: "std.primitives", decl_name: "zip_contract"), inputs: "xs, ys", result: "pairs to the shorter length; contract only", body: DagBodyRequired),
    pure_dag(name: "sum", category: CollectionKernel, authority: authority(module_path: "std.primitives", decl_name: "sum_contract"), inputs: "xs: FreeMonoid<Int>", result: "the ring sum; contract only", body: DagBodyRequired),
    pure_dag(name: "max_by", category: CollectionKernel, authority: authority(module_path: "std.primitives", decl_name: "max_by_contract"), inputs: "xs, key", result: "T?: the maximum by key; contract only", body: DagBodyRequired),
    pure_dag(name: "contains", category: CollectionKernel, authority: authority(module_path: "std.algebra", decl_name: "free_monoid_collection_templates"), inputs: "xs: FreeMonoid<T>, x: T", result: "Bool: element membership (v2.std.algebra contains takes an explicit eq)", body: body_at(module_path: "v2.std.algebra", decl_name: "contains")),
    pure_dag(name: "is_empty", category: CollectionKernel, authority: authority(module_path: "std.algebra", decl_name: "free_monoid_collection_templates"), inputs: "xs", result: "Bool", body: DagBodyRequired),
    pure_dag(name: "empty", category: CollectionKernel, authority: authority(module_path: "std.algebra", decl_name: "free_monoid_scalar_templates"), inputs: "(none)", result: "the monoid identity", body: DagBodyRequired),
    pure_dag(name: "member", category: CollectionKernel, authority: authority(module_path: "std.algebra", decl_name: "finite_power_set_templates"), inputs: "x, s: FinitePowerSet<T>", result: "Bool (std.primitive_identity: member disagrees in ARITY between FinitePowerSet and PointwisePower profiles -- receiver-polymorphic, one identity)", body: DagBodyRequired),
    pure_dag(name: "union", category: CollectionKernel, authority: authority(module_path: "std.algebra", decl_name: "finite_power_set_templates"), inputs: "a, b", result: "the set union on the algebra surface; realized by operator syntax, no call arm", body: DagBodyRequired),
    pure_dag(name: "intersect", category: CollectionKernel, authority: authority(module_path: "std.algebra", decl_name: "finite_power_set_templates"), inputs: "a, b", result: "the set intersection", body: DagBodyRequired),
    pure_dag(name: "diff", category: CollectionKernel, authority: authority(module_path: "std.algebra", decl_name: "finite_power_set_templates"), inputs: "a, b", result: "the set difference", body: DagBodyRequired),
    pure_dag(name: "map_is_empty", category: CollectionKernel, authority: authority(module_path: "std.algebra", decl_name: "finitely_supported_function_templates"), inputs: "m: Map<K,V>", result: "Bool; registry + bridge + arm, no contract and no template", body: DagBodyRequired),
    pure_dag(name: "empty_set", category: CollectionKernel, authority: authority(module_path: "std.algebra", decl_name: "finite_power_set_templates"), inputs: "(none)", result: "the empty FinitePowerSet", body: DagBodyRequired),
    pure_dag(name: "set_insert", category: CollectionKernel, authority: authority(module_path: "std.algebra", decl_name: "finite_power_set_templates"), inputs: "s, x", result: "s with x adjoined", body: DagBodyRequired),
    pure_dag(name: "map_contains_key", category: CollectionKernel, authority: authority(module_path: "std.algebra", decl_name: "finitely_supported_function_templates"), inputs: "m, k", result: "Bool; map_has is its second spelling on both arm families", body: DagBodyRequired),
    pure_dag(name: "empty_map", category: CollectionKernel, authority: authority(module_path: "std.algebra", decl_name: "finitely_supported_function_templates"), inputs: "(none)", result: "the empty finitely-supported function", body: body_at(module_path: "v2.std.collection", decl_name: "empty_map")),
    target_kernel(name: "map_get", category: CollectionKernel, authority: decl_ref(module_path: "std.algebra", decl_name: "finitely_supported_function_templates"), semantics: "Optional<V>: Present iff k in support, by K equality; total (v2.std.collection map_get is a DIVERGENT projection returning Outcome<Optional<V>> and must be reconciled by the lane)", realization: "v1_rt::map_get over the persistent HAMT (Rc<Map>)", reference: ReferenceBodyAbsent, equivalence: unqualified(obligation: "a v2.test witness that runs the modeled reference body and the native kernel over one fixture and asserts equal results, order visibility and refusal shape -- owed by COLLECTION-KERNEL-0 before the bridge is selected through the operation authority")),
    target_kernel(name: "map_insert", category: CollectionKernel, authority: decl_ref(module_path: "std.algebra", decl_name: "finitely_supported_function_templates"), semantics: "the function updated at k, persistent (the input map is unchanged), later insert wins", realization: "v1_rt::rc_map_insert over the persistent HAMT", reference: reference_at(module_path: "v2.std.collection", decl_name: "map_insert"), equivalence: unqualified(obligation: "a v2.test witness that runs the modeled reference body and the native kernel over one fixture and asserts equal results, order visibility and refusal shape -- owed by COLLECTION-KERNEL-0 before the bridge is selected through the operation authority")),
    target_kernel(name: "lookup", category: CollectionKernel, authority: decl_ref(module_path: "std.algebra", decl_name: "finitely_supported_function_templates"), semantics: "Optional<V> by K equality -- the same question as map_get through the method spelling; three interpreter arms (short-circuit, free, method) realize one meaning", realization: "eval_method_call lookup short-circuit + free_call.lookup + map_grounding.lookup, all over the HAMT", reference: reference_at(module_path: "v2.std.collection", decl_name: "map_lookup"), equivalence: unqualified(obligation: "a v2.test witness that runs the modeled reference body and the native kernel over one fixture and asserts equal results, order visibility and refusal shape -- owed by COLLECTION-KERNEL-0 before the bridge is selected through the operation authority")),
    target_kernel(name: "set_contains", category: CollectionKernel, authority: decl_ref(module_path: "std.algebra", decl_name: "finite_power_set_templates"), semantics: "Bool by T equality", realization: "v1_rt::set_contains over the persistent set", reference: ReferenceBodyAbsent, equivalence: unqualified(obligation: "a v2.test witness that runs the modeled reference body and the native kernel over one fixture and asserts equal results, order visibility and refusal shape -- owed by COLLECTION-KERNEL-0 before the bridge is selected through the operation authority")),
    target_kernel(name: "get", category: CollectionKernel, authority: decl_ref(module_path: "std.algebra", decl_name: "free_monoid_collection_templates"), semantics: "indexed get: Optional<T> at an Int index on a FreeMonoid, or map get on the two map profiles (receiver-polymorphic, one identity)", realization: "free_call.get / method_call.get over the Rc<Vec> or HAMT", reference: ReferenceBodyAbsent, equivalence: unqualified(obligation: "a v2.test witness that runs the modeled reference body and the native kernel over one fixture and asserts equal results, order visibility and refusal shape -- owed by COLLECTION-KERNEL-0 before the bridge is selected through the operation authority")),
    unresolved(name: "Some", category: LanguageKernel, cause: SubjectUnestablished { detail: "Some is a registry row typing the Optional Present constructor as a call; no interpreter arm, bridge or contract carries it because the constructor is language syntax, not an operation -- the census cannot say whether it is an operation identity at all" as NonEmptyStr }, evidence: "v1.compiler.infer_method builtin_function_registry row Some; no arm on gunbc.v1_interpreter_primitive_surface; no rt row", candidates: [CompilerQueryFrontierClass, PureDagComputationClass], settling: "COLLECTION-KERNEL-0 decides whether Optional construction is a kernel constructor (delete the registry row, type it as a variant constructor) or an operation with a template"),
    unresolved(name: "discriminant", category: LanguageKernel, cause: SubjectUnestablished { detail: "discriminant reads the variant name of a coproduct value as a String: a reflection over the value graph that no modeled operation declares; it is neither a host effect nor a pure operation with an authority" as NonEmptyStr }, evidence: "free_call.discriminant arm; registry row; no contract/template/bridge", candidates: [PureDagComputationClass, CompilerQueryFrontierClass], settling: "COLLECTION-KERNEL-0 rules whether variant reflection is a kernel eliminator (modeled on std.node) or a query"),
    unresolved(name: "with", category: LanguageKernel, cause: SubjectUnestablished { detail: "with is record update: a registry row and an algebra template (finitely_supported_function_templates carries with) but no interpreter free-call arm -- the interpreter realizes record update as syntax, so the spelling names a constructor on one surface and an operation on another" as NonEmptyStr }, evidence: "registry row with; algebra template with; with_contract; no arm, no bridge", candidates: [PureDagComputationClass], settling: "COLLECTION-KERNEL-0 rules whether record update is kernel syntax or a modeled operation; then either the template or the registry row is deleted"),
    unresolved(name: "append", category: CollectionKernel, cause: ConflictingRealizations { detail: "append names ELEMENT PUSH on the algebra template ([ReceiverSelf, ReceiverElement]) and the free_call.list_push arm, but CONCATENATION on the method_call.concat arm (concat | append | push) and the append_contract (work m, output n+m); the same (method, append) spelling has two meanings on two surfaces" as NonEmptyStr }, evidence: "std.algebra free_monoid_collection_templates append; gunbc.v1_interpreter_primitive_surface free_call.list_push and method_call.concat; std.primitives append_contract; rt row append", candidates: [PureDagComputationClass], settling: "split the spelling: rename the concat-meaning method spelling or delete it, so append joins list_push everywhere; then the row becomes PureDagComputation under list_push"),
    unresolved(name: "coproduct_nullary_inhabitants", category: LanguageKernel, cause: SubjectUnestablished { detail: "enumerates the nullary variants of a coproduct type by name: reflection over the compiled type graph carried on a v4 bridge arm with no registry row, contract or template" as NonEmptyStr }, evidence: "gunbc.v1_interpreter_primitive_surface v4_bridge arm coproduct_nullary_inhabitants; realized by coproduct_reflection::eval_coproduct_nullary_inhabitants", candidates: [CompilerQueryFrontierClass, PureDagComputationClass], settling: "SEED-QUERY-0 rules whether type-variant enumeration is a compiler query (over the accepted type product) or a std.node operation"),
    unresolved(name: "qualified_name_from_dotted_string", category: LanguageKernel, cause: ConflictingRealizations { detail: "v2.std.qualified_name declares qualified_name_from_dotted_string with a real body AND the interpreter carries a v4 bridge arm of the same name that intercepts it: two meanings for one spelling with no projection-roster row saying they are one authority" as NonEmptyStr }, evidence: "src/v2/std/qualified_name.dag declaration; gunbc.v1_interpreter_primitive_surface v4_bridge.qualified_name_from_dotted_string", candidates: [PureDagComputationClass], settling: "a std.primitive_projection row (ModeledProjection or Divergent) for the declaration, then the bridge arm is deleted or the body is"),
    unresolved(name: "parse_table_insert", category: CollectionKernel, cause: SubjectUnestablished { detail: "parse_table_insert/parse_table_lookup are the v2 parser memo carrier realized by try_parse_table_memo_dispatch: a mutable memo keyed on parser state, which is neither a modeled collection operation nor a declared host effect" as NonEmptyStr }, evidence: "gunbc.v1_interpreter_primitive_surface TryParseTableMemoDispatchSite rows; no registry row, contract, template or bridge", candidates: [TargetKernelRealizationClass, PureDagComputationClass], settling: "the v2 prepared-choice plan (gunbc#11422) replaces the per-token memo; then both arms delete, else COLLECTION-KERNEL-0 models the memo as a persistent map"),
    unresolved(name: "parse_table_lookup", category: CollectionKernel, cause: SubjectUnestablished { detail: "the read half of the parse-table memo; see parse_table_insert" as NonEmptyStr }, evidence: "TryParseTableMemoDispatchSite row parse_table_lookup", candidates: [TargetKernelRealizationClass, PureDagComputationClass], settling: "same as parse_table_insert"),
    unresolved(name: "index_by", category: CollectionKernel, cause: ContractAbsent { detail: "index_by has a contract row and an rt bridge (rc_index_by) and a v4 bridge arm but no registry row and no algebra template: the named registry+algebra dual-absence specimen of std.primitive_identity, so its signature is not modeled anywhere a resolver can read" as NonEmptyStr }, evidence: "std.primitives index_by_contract; extdeps.languages.rust.emit rt row index_by; primitive_index_by_definition SignatureUngrounded", candidates: [PureDagComputationClass], settling: "COLLECTION-KERNEL-0 declares the finitely-supported-function template (key: fn(T) -> K -> Map<K, T>, last-wins policy); then PureDagComputation"),
  ]
}
