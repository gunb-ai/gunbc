module gunbc.primitive_egress.dispositions_seed_query

import std.types { Bool, Int, List, NonEmptyStr, String }
import std.decl_ref { decl_ref }
import gunbc.primitive_egress.category { PrimitiveCategory, TextOps, NumericBit, Crypto, Encoding, Unicode, ProcessEffect, MeasurementEffect, PointerIdentity, CollectionKernel, LanguageKernel, SeedQuery, ContentHash, ClockEffect, NetworkEffect, EntropyEffect, AuthContextEffect, FilesystemEffect, DemandBinding }
import gunbc.primitive_egress.disposition {
  PrimitiveDispositionRow, DagBodyRequired, ReferenceBodyAbsent, ContractAbsent, ConflictingRealizations, SubjectUnestablished,
  PureDagComputationClass, BoundHostEffectClass, TargetKernelRealizationClass, CompilerQueryFrontierClass, UnresolvedClass,
  pure_dag, host_effect, target_kernel, compiler_query, unresolved, mixed, authority, authority_required, body_at,
  provider_required, provider_declared, reference_at, unqualified, qualified_by,
}

// COMPILER-QUERY FRONTIER identities: the subject is compiler state or a compiler qualification
// product (declaration index, resolver bindings, compile diagnostics, policy brackets). Their seed
// host producer is named per row; executing consumers and seed-growth ownership are DERIVED by
// the census join, never authored here. The two rows this census adds
// (builtin_function_registry_keys, compile_dag_primitive_call_edges) sit in their own denominator
// and carry the same option-A trigger their precedent carries in
// gunbc.evaluation_store_address_census_seed_growth.
fn dispositions_seed_query_rows() -> List<PrimitiveDispositionRow> {
  [
    compiler_query(name: "decl_facts", subject: "every declaration in the pool: (rel_path, name, kind) in canonical order", product: "the accepted declaration index the resolver already built (std.materialization_ladder: construct once, carry the qualified product; never rebuild a corpus index per witness)", producer: decl_ref(module_path: "v1_compiler.coproduct_reflection", decl_name: "eval_decl_facts"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "decl_facts_at", subject: "the declarations reachable at a qualified name", product: "the accepted declaration index the resolver already built (std.materialization_ladder: construct once, carry the qualified product; never rebuild a corpus index per witness)", producer: decl_ref(module_path: "v1_compiler.coproduct_reflection", decl_name: "eval_decl_facts_at"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "export_signature_facts", subject: "the exported signatures of every module", product: "the accepted declaration index the resolver already built (std.materialization_ladder: construct once, carry the qualified product; never rebuild a corpus index per witness)", producer: decl_ref(module_path: "v1_compiler.coproduct_reflection", decl_name: "eval_export_signature_facts"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "data_decl_type_facts", subject: "the declared type of every data declaration", product: "the accepted declaration index the resolver already built (std.materialization_ladder: construct once, carry the qualified product; never rebuild a corpus index per witness)", producer: decl_ref(module_path: "v1_compiler.coproduct_reflection", decl_name: "eval_data_decl_type_facts"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "type_declarer_qualified_names", subject: "the qualified names of the modules declaring a bare type name", product: "the accepted declaration index the resolver already built (std.materialization_ladder: construct once, carry the qualified product; never rebuild a corpus index per witness)", producer: decl_ref(module_path: "v1_compiler.coproduct_reflection", decl_name: "eval_type_declarer_qualified_names"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "concept_decl_facts", subject: "concept declarations, parse-only over the disk pool", product: "the accepted declaration index the resolver already built (std.materialization_ladder: construct once, carry the qualified product; never rebuild a corpus index per witness)", producer: decl_ref(module_path: "v1_compiler.coproduct_reflection", decl_name: "eval_concept_decl_facts"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "concept_decl_facts_live", subject: "concept declarations of the RUNNING program (ctx.modules), SourcePreservingOrder", product: "the loaded program's own module set -- already in memory; the query is a projection of it", producer: decl_ref(module_path: "v1_compiler.coproduct_reflection", decl_name: "eval_concept_decl_facts_live"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "data_init_decl_facts_live", subject: "data initializers of the running program", product: "the loaded program's own module set", producer: decl_ref(module_path: "v1_compiler.coproduct_reflection", decl_name: "eval_data_init_decl_facts_live"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "fn_arrow_decl_facts_live", subject: "fn arrow (callable) declarations of the running program", product: "the loaded program's own module set", producer: decl_ref(module_path: "v1_compiler.coproduct_reflection", decl_name: "eval_fn_arrow_decl_facts_live"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "fact_cardinality_decl_facts", subject: "declaration facts with their cardinality", product: "the accepted declaration index the resolver already built (std.materialization_ladder: construct once, carry the qualified product; never rebuild a corpus index per witness)", producer: decl_ref(module_path: "v1_compiler.cli_run", decl_name: "fact_cardinality_decl_facts"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "module_declaration_facts", subject: "the module declarations under the pool", product: "the accepted declaration index the resolver already built (std.materialization_ladder: construct once, carry the qualified product; never rebuild a corpus index per witness)", producer: decl_ref(module_path: "v1_compiler.cli_run", decl_name: "module_declaration_facts"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "module_declaration_facts_at", subject: "the module declaration at one path", product: "the accepted declaration index the resolver already built (std.materialization_ladder: construct once, carry the qualified product; never rebuild a corpus index per witness)", producer: decl_ref(module_path: "v1_compiler.cli_run", decl_name: "module_declaration_fact_at"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "import_resolution_facts", subject: "which imports resolve, per importer, over the pool", product: "the resolver's import-resolution product (ImportResolutionObservation)", producer: decl_ref(module_path: "v1_compiler.cli_run", decl_name: "import_resolution_facts_with_observation"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "reference_resolution_facts", subject: "reference edges as import facts", product: "the resolver's reference-resolution product", producer: decl_ref(module_path: "v1_compiler.cli_run", decl_name: "reference_resolution_facts"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "dependency_resolution_facts", subject: "dependency resolution over pool and importer roots", product: "the resolver's dependency product", producer: decl_ref(module_path: "v1_compiler.cli_run", decl_name: "dependency_resolution_facts"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "layer_import_facts", subject: "cross-layer import edges", product: "the resolver's import graph", producer: decl_ref(module_path: "v1_compiler.cli_run", decl_name: "layer_import_facts"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "parsed_import_statements", subject: "the import statements of one supplied source text", product: "the tokenizer/parser product for that source (the source is supplied, not acquired)", producer: decl_ref(module_path: "v1_compiler.cli_run", decl_name: "parsed_import_statements"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "namespace_structural_observation_admissions", subject: "structural namespace observations over one supplied source", product: "the resolver's namespace observation for that source", producer: decl_ref(module_path: "v1_compiler.cli_run", decl_name: "namespace_structural_observation_admissions"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "observe_declared_import_closure_symbol_binding", subject: "how a symbol binds under a declared-import-closure-only compile", product: "the class-B binding observation of the compile", producer: decl_ref(module_path: "v1_compiler.cli_run", decl_name: "observe_declared_import_closure_symbol_binding"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "compile_dag_diagnostic_census", subject: "the full per-class diagnostic census of compiling one supplied program", product: "the compile's diagnostic product", producer: decl_ref(module_path: "v1_compiler.cli_run.emit_host", decl_name: "compile_dag_diagnostic_census"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "compile_dag_rust_emit_check", subject: "whether one supplied program compiles clean to the Rust target", product: "the compile-clean verdict of the emit pipeline", producer: decl_ref(module_path: "v1_compiler.cli_run.emit_host", decl_name: "compile_dag_rust_emit_check"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "compile_dag_multi_module_fixture", subject: "compile a multi-module fixture handed as sources", product: "the compile product of the supplied fixture", producer: decl_ref(module_path: "v1_compiler.cli_run.emit_host", decl_name: "compile_dag_multi_module_fixture"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "claim_scope_dag_multi_module_fixture", subject: "scoped-claim compile of a supplied multi-module fixture", product: "the claim-scope compile product", producer: decl_ref(module_path: "v1_compiler.cli_run.emit_host", decl_name: "claim_scope_dag_multi_module_fixture"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "compile_dag_reference_occurrence_binding_census", subject: "reference-occurrence-grain binding of one supplied source vector", product: "the resolver's occurrence-binding product", producer: decl_ref(module_path: "v1_compiler.cli_run.emit_host", decl_name: "compile_dag_reference_occurrence_binding_census"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "compile_dag_importer_resolved_call_edges", subject: "ResolvedCallee edges from importers of a home module", product: "the resolver's CalleeEdge product over the selected entries", producer: decl_ref(module_path: "v1_compiler.cli_run.emit_host", decl_name: "compile_dag_importer_resolved_call_edges"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "compile_dag_callsite_resolved_call_edges", subject: "ResolvedCallee edges from call-form callers", product: "the resolver's CalleeEdge product over the selected entries", producer: decl_ref(module_path: "v1_compiler.cli_run.emit_host", decl_name: "compile_dag_callsite_resolved_call_edges"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "compile_dag_call_form_leaf_guard", subject: "whether any admitted src/v2 file carries a call form of a leaf outside exact resolution", product: "the tokenizer product over the pool", producer: decl_ref(module_path: "v1_compiler.cli_run.emit_host", decl_name: "compile_dag_call_form_leaf_guard"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "compile_dag_primitive_call_edges", subject: "every call site whose resolver-established callee is a primitive, an algebra method, a service op, or nothing -- THIS census's own consumer edge", product: "the resolver's CallTargetIdentity / MethodSemantics product over every entry of the pool", producer: decl_ref(module_path: "v1_compiler.cli_run.emit_host", decl_name: "compile_dag_primitive_call_edges"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "builtin_function_registry_keys", subject: "the key set of v1.compiler.infer_method builtin_function_registry", product: "the compiled registry map itself (its Node-bearing values cannot be evaluated by the interpreter)", producer: decl_ref(module_path: "v1_compiler.cli_run.emit_host", decl_name: "builtin_function_registry_keys"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "symbol_lexeme", subject: "the lexeme of an interned Symbol", product: "the interpreter's interning table (a compiler-state table; identity on the Rust target where Symbol is String)", producer: decl_ref(module_path: "v1_compiler.v1_interpreter", decl_name: "symbol_lexeme"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "symbol_intern_lexeme", subject: "the Symbol for a lexeme", product: "the interning table", producer: decl_ref(module_path: "v1_compiler.v1_interpreter", decl_name: "symbol_intern_lexeme"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "emit_rust_reference_derived_rows_bridge", subject: "the reference-derived rows the Rust emitter would produce for the pool", product: "the emitter's derived-row product", producer: decl_ref(module_path: "v1_compiler.cli_run", decl_name: "emit_rust_reference_derived_rows_bridge"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "resolution_silent_pick_is_enabled", subject: "whether the resolver's silent-pick measurement bracket is armed", product: "compiler policy state (a thread-local bracket)", producer: decl_ref(module_path: "v1_compiler.v1_rt", decl_name: "resolution_silent_pick_is_enabled"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "resolution_silent_pick_record_global_bare_lcp_pick", subject: "record a global-bare LCP pick into the resolver measurement bracket", product: "compiler measurement state", producer: decl_ref(module_path: "v1_compiler.v1_rt", decl_name: "resolution_silent_pick_record_global_bare_lcp_pick"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "resolution_silent_pick_record_global_bare_lcp_tie", subject: "record a global-bare LCP tie", product: "compiler measurement state", producer: decl_ref(module_path: "v1_compiler.v1_rt", decl_name: "resolution_silent_pick_record_global_bare_lcp_tie"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "resolution_silent_pick_record_fn_parent_first_hit", subject: "record a fn-parent first hit", product: "compiler measurement state", producer: decl_ref(module_path: "v1_compiler.v1_rt", decl_name: "resolution_silent_pick_record_fn_parent_first_hit"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "name_resolution_policy_is_namespace_only", subject: "the resolver's name-resolution policy (NamespaceOnly)", product: "compiler policy state", producer: decl_ref(module_path: "v1_compiler.v1_rt", decl_name: "name_resolution_policy_is_namespace_only"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "type_ref_hit_ne_bind_measure_active", subject: "whether the type-ref hit-ne-bind measurement arm is armed", product: "compiler measurement state", producer: decl_ref(module_path: "v1_compiler.v1_rt", decl_name: "type_ref_hit_ne_bind_measure_active"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "witness_layer_roots_compile_clean_check", subject: "whether the witness layer roots compile clean", product: "the compile-clean qualification product of the floor", producer: decl_ref(module_path: "v1_compiler.cli_run", decl_name: "witness_layer_roots_compile_clean_check"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "witness_layer_roots_compile_clean_emit_check", subject: "whether the witness layer roots compile clean to the emit target", product: "the compile-clean qualification product", producer: decl_ref(module_path: "v1_compiler.cli_run", decl_name: "witness_layer_roots_compile_clean_emit_check"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "witness_compile_clean_cli_floor_verdicts_agree", subject: "whether the CLI and floor compile-clean verdicts agree", product: "two compile-clean products compared", producer: decl_ref(module_path: "v1_compiler.cli_run", decl_name: "witness_compile_clean_cli_floor_verdicts_agree"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "census_corpus_roots_follow_layer_authority", subject: "whether census corpus roots follow the ci layer-roots authority", product: "the layer-roots product", producer: decl_ref(module_path: "v1_compiler.cli_run", decl_name: "census_corpus_roots_follow_layer_authority"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "class_b_import_closure_gate_not_affected_skip", subject: "whether the class-B import-closure gate may skip an unaffected change", product: "the affected-set product of the compile", producer: decl_ref(module_path: "v1_compiler.cli_run", decl_name: "class_b_import_closure_gate_not_affected_skip_for_ci"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
    compiler_query(name: "extdeps_qualified_name_resolves_in_derived_module_set", subject: "whether a qualified name resolves in the derived module set", product: "the resolver's module set", producer: decl_ref(module_path: "v1_compiler.cli_run", decl_name: "qualified_name_resolves_in_derived_module_set"), trigger: "a v2 query Judgment over the accepted declaration index answers this for every executing consumer; then the coproduct_reflection walk and the arm delete together (SEED-QUERY-0, consumer by consumer)"),
  ]
}
