module gunbc.primitive_egress.dispositions_text

import std.types { Bool, Int, List, NonEmptyStr, String }
import std.decl_ref { decl_ref }
import gunbc.primitive_egress.category { PrimitiveCategory, TextOps, NumericBit, Crypto, Encoding, Unicode, ProcessEffect, MeasurementEffect, PointerIdentity, CollectionKernel, LanguageKernel, SeedQuery, ContentHash, ClockEffect, NetworkEffect, EntropyEffect, AuthContextEffect, FilesystemEffect, DemandBinding }
import gunbc.primitive_egress.disposition {
  PrimitiveDispositionRow, DagBodyRequired, ReferenceBodyAbsent, ContractAbsent, ConflictingRealizations, SubjectUnestablished,
  PureDagComputationClass, BoundHostEffectClass, TargetKernelRealizationClass, CompilerQueryFrontierClass, UnresolvedClass,
  pure_dag, host_effect, target_kernel, compiler_query, unresolved, mixed, authority, authority_required, body_at,
  provider_required, provider_declared, reference_at, unqualified, qualified_by,
}

// TEXT, ENCODING, UNICODE, CRYPTO and NUMERIC identities. Every row here is PureDagComputation:
// the result is a function of modeled inputs and every failure is a typed result. That the seed
// realizes most of them in Rust today is a fact about the route, carried on the census standing,
// and is not evidence about the class. The operation authority is the algebra template where one
// exists and a named required home where the lane (TEXT-0, ENCODING-0, UNICODE-0, CRYPTO-0,
// NUMERIC-BIT-0) must declare it.
fn dispositions_text_rows() -> List<PrimitiveDispositionRow> {
  [
    pure_dag(name: "length", category: TextOps, authority: authority(module_path: "std.algebra", decl_name: "free_monoid_scalar_templates"), inputs: "xs: FreeMonoid<T> (String is FreeMonoid<Char>: code points, never bytes -- measured on v1_rt::string_length)", result: "Int, the element count; total, no refusal", body: body_at(module_path: "v2.std.algebra", decl_name: "length")),
    pure_dag(name: "concat", category: TextOps, authority: authority(module_path: "std.algebra", decl_name: "free_monoid_scalar_templates"), inputs: "left, right: FreeMonoid<T>", result: "the monoid product; total; contract concat_contract prices n+m", body: DagBodyRequired),
    pure_dag(name: "substring", category: TextOps, authority: authority(module_path: "std.algebra", decl_name: "free_monoid_scalar_templates"), inputs: "s: String, start: Int, end: Int (code-point offsets)", result: "String slice; the refusal for start > end or end > length is unmodeled today and must be a typed result, not a host panic", body: DagBodyRequired),
    pure_dag(name: "char_at", category: TextOps, authority: authority(module_path: "std.algebra", decl_name: "free_monoid_scalar_templates"), inputs: "s: String, pos: Int", result: "the code point at pos as a one-char String; out-of-range refusal unmodeled", body: DagBodyRequired),
    pure_dag(name: "string_contains", category: TextOps, authority: authority(module_path: "std.algebra", decl_name: "free_monoid_scalar_templates"), inputs: "s: String, pattern: String", result: "Bool: substring containment (distinct from element containment `contains`)", body: DagBodyRequired),
    pure_dag(name: "starts_with", category: TextOps, authority: authority(module_path: "std.algebra", decl_name: "free_monoid_scalar_templates"), inputs: "s: String, prefix: String", result: "Bool", body: DagBodyRequired),
    pure_dag(name: "ends_with", category: TextOps, authority: authority(module_path: "std.algebra", decl_name: "free_monoid_scalar_templates"), inputs: "s: String, suffix: String", result: "Bool", body: DagBodyRequired),
    pure_dag(name: "trim", category: TextOps, authority: authority(module_path: "std.algebra", decl_name: "free_monoid_scalar_templates"), inputs: "s: String", result: "String with leading and trailing Unicode whitespace removed; std.algebra trim declares the pure-dag seam body", body: body_at(module_path: "std.algebra", decl_name: "trim")),
    pure_dag(name: "split", category: TextOps, authority: authority(module_path: "std.algebra", decl_name: "free_monoid_scalar_templates"), inputs: "s: String, separator: String", result: "List<String>; the empty-separator and trailing-separator conventions are the modeling obligation", body: DagBodyRequired),
    pure_dag(name: "join", category: TextOps, authority: authority(module_path: "std.algebra", decl_name: "free_monoid_scalar_templates"), inputs: "parts: List<String>, separator: String", result: "String", body: DagBodyRequired),
    pure_dag(name: "repeat", category: TextOps, authority: authority(module_path: "std.primitives", decl_name: "repeat_contract"), inputs: "s: String, n: Int", result: "String; std.primitives repeat_contract prices it; no registry row, arm or bridge realizes it", body: DagBodyRequired),
    pure_dag(name: "chars", category: TextOps, authority: authority(module_path: "std.algebra", decl_name: "free_monoid_scalar_templates"), inputs: "s: String", result: "List<String> of code points", body: DagBodyRequired),
    pure_dag(name: "to_lower", category: TextOps, authority: authority(module_path: "std.algebra", decl_name: "free_monoid_scalar_templates"), inputs: "s: String", result: "String; Unicode case mapping is the UNICODE-0 dependency, but the operation is a pure function of its input", body: DagBodyRequired),
    pure_dag(name: "to_upper", category: TextOps, authority: authority(module_path: "std.algebra", decl_name: "free_monoid_scalar_templates"), inputs: "s: String", result: "String; same Unicode case-mapping dependency as to_lower", body: DagBodyRequired),
    pure_dag(name: "replace", category: TextOps, authority: authority(module_path: "std.algebra", decl_name: "free_monoid_scalar_templates"), inputs: "s: String, from: String, to: String", result: "String with every occurrence replaced", body: DagBodyRequired),
    pure_dag(name: "replace_section", category: TextOps, authority: authority(module_path: "std.primitives", decl_name: "replace_section_contract"), inputs: "s: String, start: Int, end: Int, replacement: String", result: "String; contract only (replace_section_contract), no realization on any surface", body: DagBodyRequired),
    pure_dag(name: "to_string", category: TextOps, authority: authority(module_path: "std.algebra", decl_name: "free_monoid_scalar_templates"), inputs: "x: Int | Bool | String | Symbol", result: "the canonical decimal / literal rendering; the rendering of composite values is NOT part of the modeled contract", body: DagBodyRequired),
    pure_dag(name: "to_int", category: TextOps, authority: authority(module_path: "std.algebra", decl_name: "free_monoid_scalar_templates"), inputs: "s: String", result: "Int? -- algebra template to_int on FreeMonoidScalarProfile returns Int; the registry row types a free call; neither an interpreter arm nor a bridge realizes it under this spelling (parse_int does)", body: DagBodyRequired),
    pure_dag(name: "parse_int", category: TextOps, authority: authority(module_path: "std.algebra", decl_name: "free_monoid_scalar_templates"), inputs: "s: String", result: "Int?: Absent on a non-decimal string rather than a refusal", body: DagBodyRequired),
    pure_dag(name: "str_eq", category: TextOps, authority: authority(module_path: "std.primitives", decl_name: "str_eq_contract"), inputs: "a: String, b: String", result: "Bool: code-point equality", body: DagBodyRequired),
    pure_dag(name: "chars_to_string", category: TextOps, authority: authority_required(home: "std.algebra free_monoid_scalar_templates (chars_to_string is the inverse of chars and needs the template)"), inputs: "chars: List<String>", result: "String: the monoid fold of one-char strings; no contract row", body: DagBodyRequired),
    pure_dag(name: "scan_while", category: TextOps, authority: authority(module_path: "std.primitives", decl_name: "scan_while_contract"), inputs: "s: String, start: Int, pred: fn(Int) -> Bool", result: "Int: first offset at or after start whose code point fails pred; a lexer kernel over FreeMonoid<Char>", body: DagBodyRequired),
    pure_dag(name: "scan_to_eol", category: TextOps, authority: authority(module_path: "std.primitives", decl_name: "scan_to_eol_contract"), inputs: "s: String, start: Int", result: "Int: offset of the next newline or the length", body: DagBodyRequired),
    pure_dag(name: "scan_string_end", category: TextOps, authority: authority(module_path: "std.primitives", decl_name: "scan_string_end_contract"), inputs: "s: String, start: Int", result: "Int: offset past the closing quote honoring escapes", body: DagBodyRequired),
    pure_dag(name: "skip_horizontal_ws", category: TextOps, authority: authority(module_path: "std.primitives", decl_name: "skip_horizontal_ws_contract"), inputs: "s: String, start: Int", result: "Int: first offset at or after start that is not space or tab", body: DagBodyRequired),
    pure_dag(name: "record_source_chars_index_lookup", category: TextOps, authority: authority_required(home: "std.algebra: an offset-to-code-point index over FreeMonoid<Char>"), inputs: "file: String, offset: Int", result: "the code-point index of a byte offset in an already-acquired source; the acquisition is the caller's, this is arithmetic over the source text", body: DagBodyRequired),
    pure_dag(name: "code_point", category: Encoding, authority: authority(module_path: "std.primitives", decl_name: "code_point_contract"), inputs: "c: String (one code point)", result: "Int: the Unicode scalar value", body: DagBodyRequired),
    pure_dag(name: "from_code_point", category: Encoding, authority: authority(module_path: "std.primitives", decl_name: "from_code_point_contract"), inputs: "cp: Int", result: "String of one code point; a surrogate or out-of-range Int must be a typed refusal", body: DagBodyRequired),
    pure_dag(name: "utf8_encode_bytes", category: Encoding, authority: authority_required(home: "std.encoding (UTF-8 encoder over the NUMERIC-BIT-0 word substrate)"), inputs: "s: String", result: "Bytes: the UTF-8 encoding", body: DagBodyRequired),
    pure_dag(name: "utf8_decode_bytes", category: Encoding, authority: authority_required(home: "std.encoding (UTF-8 decoder; boundary refusals are ENCODING-0 rows)"), inputs: "bytes: Bytes", result: "String or a typed decode refusal at the first invalid sequence", body: DagBodyRequired),
    pure_dag(name: "bytes_octets", category: Encoding, authority: authority_required(home: "std.bytes"), inputs: "bytes: Bytes", result: "List<Int> of octets 0..255", body: DagBodyRequired),
    pure_dag(name: "octets_bytes", category: Encoding, authority: authority_required(home: "std.bytes"), inputs: "octets: List<Int>", result: "Bytes; an Int outside 0..255 is a typed refusal", body: DagBodyRequired),
    pure_dag(name: "to_bytes", category: Encoding, authority: authority(module_path: "std.primitives", decl_name: "to_bytes_contract"), inputs: "x: String", result: "Bytes: contract only (to_bytes_contract); no registry row, arm or bridge realizes it", body: DagBodyRequired),
    pure_dag(name: "to_json", category: Encoding, authority: authority(module_path: "extdeps.languages.json.emit", decl_name: "serialize_json"), inputs: "x: value", result: "String: contract only (to_json_contract); the JSON emitter that exists is extdeps.languages.json.emit, which no surface realizes under this spelling", body: DagBodyRequired),
    pure_dag(name: "parse_roadmap_acceptance_event_history_jsonl", category: Encoding, authority: authority(module_path: "extdeps.languages.json.parse", decl_name: "parse_json_document"), inputs: "text: String (already-acquired JSONL)", result: "the parsed event history or a located parse refusal; a pure function of the text -- the acquisition is the caller's", body: DagBodyRequired),
    pure_dag(name: "project_roadmap_acceptance_event_history_from_authority_text_host", category: Encoding, authority: authority(module_path: "extdeps.languages.json.parse", decl_name: "parse_json_document"), inputs: "authority_text: String", result: "the projected event history; pure over its text argument", body: DagBodyRequired),
    pure_dag(name: "is_xid_start", category: Unicode, authority: authority_required(home: "extdeps.unicode (pinned UCD version; generated property tables are artifacts, never hand rows)"), inputs: "cp: Int", result: "Bool: XID_Start per the pinned UCD DerivedCoreProperties", body: DagBodyRequired),
    pure_dag(name: "is_xid_continue", category: Unicode, authority: authority_required(home: "extdeps.unicode (pinned UCD version; generated property tables are artifacts, never hand rows)"), inputs: "cp: Int", result: "Bool: XID_Continue per the pinned UCD", body: DagBodyRequired),
    pure_dag(name: "is_emoji_ident", category: Unicode, authority: authority_required(home: "extdeps.unicode (pinned UCD version; generated property tables are artifacts, never hand rows)"), inputs: "cp: Int", result: "Bool: the identifier-admissible emoji property per the pinned UCD", body: DagBodyRequired),
    pure_dag(name: "hmac_sha256_hex", category: Crypto, authority: authority_required(home: "extdeps.crypto.mac (HMAC-SHA-256 over the ENCODING-0 byte substrate and the NUMERIC-BIT-0 words)"), inputs: "key_hex: String, message: String", result: "String?: the lowercase hex tag; Absent when key_hex is not hex -- a deterministic function of its inputs (RFC 2104 / FIPS 180-4), so it is modeled, and the native implementation is admitted only as a realization qualified against the RFC test vectors", body: DagBodyRequired),
    pure_dag(name: "hmac_sha256_verify_hex", category: Crypto, authority: authority_required(home: "extdeps.crypto.mac (HMAC-SHA-256 over the ENCODING-0 byte substrate and the NUMERIC-BIT-0 words)"), inputs: "key_hex: String, message: String, tag_hex: String", result: "Bool: constant-time tag equality; the comparison is part of the modeled contract (hmac_sha256_verify_hex_contract) because a visible tag would let callers compare in variable time", body: DagBodyRequired),
    pure_dag(name: "contiguous_loop_elementwise_kernel", category: NumericBit, authority: authority(module_path: "std.primitives", decl_name: "contiguous_loop_elementwise_kernel_contract"), inputs: "xs: List<Int>, f: fn(Int) -> Int", result: "List<Int>: elementwise map over a contiguous carrier; the contract prices it as a kernel but its meaning is `map`, so the modeled operation is the fold and the contiguous loop is a realization", body: DagBodyRequired),
    pure_dag(name: "contiguous_loop_elementwise_float_kernel", category: NumericBit, authority: authority(module_path: "std.primitives", decl_name: "contiguous_loop_elementwise_float_kernel_contract"), inputs: "xs: List<Float>, f: fn(Float) -> Float", result: "List<Float>: elementwise map; same standing as the Int kernel", body: DagBodyRequired),
    pure_dag(name: "clamp", category: NumericBit, authority: authority(module_path: "std.algebra", decl_name: "ordered_ring_templates"), inputs: "x, lo, hi: an OrderedRing element", result: "the element clamped into [lo, hi]; algebra template + rt bridge, no interpreter arm", body: DagBodyRequired),
    pure_dag(name: "add", category: NumericBit, authority: authority(module_path: "std.algebra", decl_name: "ordered_ring_templates"), inputs: "a, b: OrderedRing", result: "a + b -- an algebra-template operation realized by the language's operator syntax rather than a call arm; the template is the semantic authority and std.algebra derives Int.add from ring inhabitance", body: DagBodyRequired),
    pure_dag(name: "mul", category: NumericBit, authority: authority(module_path: "std.algebra", decl_name: "ordered_ring_templates"), inputs: "a, b: OrderedRing", result: "a * b -- an algebra-template operation realized by the language's operator syntax rather than a call arm; the template is the semantic authority and std.algebra derives Int.add from ring inhabitance", body: DagBodyRequired),
    pure_dag(name: "negate", category: NumericBit, authority: authority(module_path: "std.algebra", decl_name: "ordered_ring_templates"), inputs: "a: OrderedRing", result: "-a -- an algebra-template operation realized by the language's operator syntax rather than a call arm; the template is the semantic authority and std.algebra derives Int.add from ring inhabitance", body: DagBodyRequired),
    pure_dag(name: "zero", category: NumericBit, authority: authority(module_path: "std.algebra", decl_name: "ordered_ring_templates"), inputs: "(none)", result: "the additive identity -- an algebra-template operation realized by the language's operator syntax rather than a call arm; the template is the semantic authority and std.algebra derives Int.add from ring inhabitance", body: DagBodyRequired),
    pure_dag(name: "one", category: NumericBit, authority: authority(module_path: "std.algebra", decl_name: "ordered_ring_templates"), inputs: "(none)", result: "the multiplicative identity -- an algebra-template operation realized by the language's operator syntax rather than a call arm; the template is the semantic authority and std.algebra derives Int.add from ring inhabitance", body: DagBodyRequired),
    pure_dag(name: "compare", category: NumericBit, authority: authority(module_path: "std.algebra", decl_name: "ordered_ring_templates"), inputs: "a, b: OrderedRing", result: "Ordering -- an algebra-template operation realized by the language's operator syntax rather than a call arm; the template is the semantic authority and std.algebra derives Int.add from ring inhabitance", body: DagBodyRequired),
    pure_dag(name: "reciprocal", category: NumericBit, authority: authority(module_path: "std.algebra", decl_name: "approximate_field_templates"), inputs: "a: ApproximateField", result: "one over a; zero is a typed refusal -- an algebra-template operation realized by the language's operator syntax rather than a call arm; the template is the semantic authority and std.algebra derives Int.add from ring inhabitance", body: DagBodyRequired),
    pure_dag(name: "bottom", category: NumericBit, authority: authority(module_path: "std.algebra", decl_name: "boolean_algebra_templates"), inputs: "(none)", result: "the lattice bottom -- BooleanAlgebraProfile template; realized by operator syntax, no call arm", body: DagBodyRequired),
    pure_dag(name: "top", category: NumericBit, authority: authority(module_path: "std.algebra", decl_name: "boolean_algebra_templates"), inputs: "(none)", result: "the lattice top -- BooleanAlgebraProfile template; realized by operator syntax, no call arm", body: DagBodyRequired),
    pure_dag(name: "meet", category: NumericBit, authority: authority(module_path: "std.algebra", decl_name: "boolean_algebra_templates"), inputs: "a, b: BooleanAlgebra", result: "a and b -- BooleanAlgebraProfile template; realized by operator syntax, no call arm", body: DagBodyRequired),
    pure_dag(name: "complement", category: NumericBit, authority: authority(module_path: "std.algebra", decl_name: "boolean_algebra_templates"), inputs: "a: BooleanAlgebra", result: "not a -- BooleanAlgebraProfile template; realized by operator syntax, no call arm", body: DagBodyRequired),
  ]
}
