module gunbc.primitive_egress.dispositions_hosts

import std.types { Bool, Int, List, NonEmptyStr, String }
import std.decl_ref { decl_ref }
import gunbc.primitive_egress.category { PrimitiveCategory, TextOps, NumericBit, Crypto, Encoding, Unicode, ProcessEffect, MeasurementEffect, PointerIdentity, CollectionKernel, LanguageKernel, SeedQuery, ContentHash, ClockEffect, NetworkEffect, EntropyEffect, AuthContextEffect, FilesystemEffect, DemandBinding }
import gunbc.primitive_egress.disposition {
  PrimitiveDispositionRow, DagBodyRequired, ReferenceBodyAbsent, ContractAbsent, ConflictingRealizations, SubjectUnestablished,
  PureDagComputationClass, BoundHostEffectClass, TargetKernelRealizationClass, CompilerQueryFrontierClass, UnresolvedClass,
  pure_dag, host_effect, target_kernel, compiler_query, unresolved, mixed, authority, authority_required, body_at,
  provider_required, provider_declared, reference_at, unqualified, qualified_by,
}

// BOUND HOST EFFECTS, the content-hash kernels, pointer identity, and every seed builtin whose
// present realization conflates a file acquisition with the computation over what it acquired.
// The conflated rows are Unresolved { MixedSemanticQuestions } by the acceptance contract: they
// are NOT forced into whichever class is convenient, and each names the split that settles it.
fn dispositions_hosts_rows() -> List<PrimitiveDispositionRow> {
  [
    host_effect(name: "filesystem_read", category: FilesystemEffect, operation: "Filesystem.Read at a path", subject: "the file entry at a caller-supplied path (logical subject: that path's bytes, not the mechanism)", provider: provider_declared(module_path: "extdeps.filesystem.filesystem_io", decl_name: "Filesystem"), ambient: "free_call.filesystem_read arm + v1_rt::filesystem_read + the eval_service_call Filesystem.Read|List checkout carve-out; ambient today, bound via D13 DemandBinding in EFFECTS-1 cut (c)"),
    host_effect(name: "emit_host_run_transport", category: ProcessEffect, operation: "run an emitted host program: build then execute under a declared environment", subject: "a ProcessExecutionRequest (executable, argv, environment, working directory, result channels) -- the gunbc#11626 Process ruling; NOT NetworkEffect", provider: provider_required(shape: "LocalProcessProvider realizing ProcessExecutionRequest -> ProviderUnavailable | ExecutableUnresolved | SpawnRefused | Spawned | Exited | Signaled | TimedOut | Cancelled | OutputUnreadable | OutputTruncated"), ambient: "free_call.emit_host_run_transport -> cli_run::emit_host (cargo build + process spawn), ambient"),
    host_effect(name: "emit_host_run_transport_cached", category: ProcessEffect, operation: "emit_host_run_transport composed with materialization/cache policy", subject: "the same process request, served through the materialization ladder when an admitted artifact exists (two composed subjects: process execution + artifact store lookup)", provider: provider_required(shape: "the Process provider above composed with std.materialization_provider ArtifactRequest; the cache half is not a ProcessEffect fact"), ambient: "free_call.emit_host_run_transport_cached, ambient"),
    host_effect(name: "emit_host_native_cache_evict", category: FilesystemEffect, operation: "evict the emit-host native build cache under a workspace dir", subject: "a materialization store mutation (the gunbc#11626 ruling: cache/store mutation, NOT Process)", provider: provider_required(shape: "std.artifact_store ArtifactStore eviction over the emit-host cache subject"), ambient: "free_call.emit_host_native_cache_evict, ambient filesystem removal"),
    host_effect(name: "toolchain_home_interference_probe", category: ProcessEffect, operation: "observe whether the shared toolchain home is being rewritten by a neighbour", subject: "host environment observation (the ruling: not automatically Process, not automatically Filesystem); the logical subject is the toolchain installation state", provider: provider_required(shape: "an environment-observation provider answering the toolchain-home state as a typed observation"), ambient: "free_call.toolchain_home_interference_probe, ambient"),
    host_effect(name: "observed_monotonic_nanos", category: ClockEffect, operation: "read the monotonic clock", subject: "a std.observation ClockBasis reading (monotonic, not wall)", provider: provider_declared(module_path: "std.observation", decl_name: "ClockLookup"), ambient: "free_call.observed_monotonic_nanos over std::time::Instant, ambient"),
    host_effect(name: "observed_peak_resident_bytes", category: MeasurementEffect, operation: "read the process peak resident set size", subject: "a host resource measurement of THIS process (VmHWM); a /proc read is the mechanism, not the subject", provider: provider_required(shape: "a process-resource measurement provider answering Measured<Byte>"), ambient: "free_call.observed_peak_resident_bytes -> cli_run::peak_rss_vhwm_bytes over /proc/self/status, ambient"),
    host_effect(name: "trace_mark", category: MeasurementEffect, operation: "emit an instrumentation mark", subject: "an instrumentation channel (the ruling: instrumentation provider, not semantic time); the mark is an observation event", provider: provider_declared(module_path: "std.observation", decl_name: "ObservationEvent"), ambient: "free_call.trace_mark -> v1_rt::trace_mark, ambient stderr/trace sink"),
    pure_dag(name: "shell_materialize_operation_argv", category: ProcessEffect, authority: authority_required(home: "std.process: pure ProcessExecutionRequest construction from an operation row, workspace, files and environment"), inputs: "operation: String, workspace_dir: String, files: List, environment: List", result: "the argv/request value; a pure construction (ruling: pure .dag request construction)", body: DagBodyRequired),
    pure_dag(name: "shell_transport_operation_rows", category: ProcessEffect, authority: authority_required(home: "std.process: the modeled operation/transport contract rows as data"), inputs: "(none)", result: "the transport operation rows; modeled contract data, not an effect", body: DagBodyRequired),
    target_kernel(name: "hash_combine", category: ContentHash, authority: decl_ref(module_path: "std.content_hash", decl_name: "HashFamily"), semantics: "h(left ++ NUL ++ right) over the FNV-1a64 structural family: the combine preimage is left, a NUL code point, right (CONTENT-HASH-0 cut 1 models it via content_hash_atom byte-identically)", realization: "v1_rt::hash_combine (FNV-1a 64 over the concatenated preimage)", reference: reference_at(module_path: "std.content_hash", decl_name: "content_hash_atom"), equivalence: unqualified(obligation: "byte-identity of the native digest against the modeled preimage on the store-identity fixtures, owed by CONTENT-HASH-0 cut 1; cut 2 models the kernel on the NUMERIC-BIT-0 words and ENCODING-0 bytes and deletes the bridge")),
    target_kernel(name: "atom_identity_hash", category: ContentHash, authority: decl_ref(module_path: "std.content_hash", decl_name: "HashFamily"), semantics: "FNV-1a64 over the UTF-8 bytes of an atom lexeme -- std.content_hash Fnv1a64Structural", realization: "v1_rt::atom_identity_hash", reference: reference_at(module_path: "std.content_hash", decl_name: "content_hash_atom"), equivalence: unqualified(obligation: "byte-identity of the native digest against the modeled preimage on the store-identity fixtures, owed by CONTENT-HASH-0 cut 1; cut 2 models the kernel on the NUMERIC-BIT-0 words and ENCODING-0 bytes and deletes the bridge")),
    unresolved(name: "hash", category: ContentHash, cause: SubjectUnestablished { detail: "hash_contract prices a generic hash but no registry row, arm, template or bridge realizes a primitive spelled hash; std.content_hash is the modeled family and nothing routes this spelling to it" as NonEmptyStr }, evidence: "std.primitives hash_contract only", candidates: [PureDagComputationClass], settling: "CONTENT-HASH-0 deletes the orphan contract or binds it to a HashFamily member"),
    unresolved(name: "rc_ptr_eq", category: PointerIdentity, cause: SubjectUnestablished { detail: "pointer equality of two shared carriers is a fact about the REALIZATION (whether two references share one allocation), not about the value graph; no modeled operation has it as a result and no semantic decision may depend on it (IDENTITY-0)" as NonEmptyStr }, evidence: "free_call.rc_ptr_eq arm with spellings rc_ptr_eq and rc_vec_ptr_eq; registry rows; rt bridges; no contract or template", candidates: [TargetKernelRealizationClass], settling: "IDENTITY-0 replaces every semantic consumer with structural equality or a modeled identity; then the arm and bridges delete -- it is admissible only as a cost-only accelerator selected inside a kernel, never as a source-level operation"),
    unresolved(name: "doc_graph_doc_count", category: FilesystemEffect, cause: mixed(questions: ["which files/bytes are acquired (a Filesystem demand at operation/logical-subject grain, bound at a root)", "what is computed over the acquired corpus (a pure fold, or a compiler query where the product is compiler state)"]), evidence: "free_call.doc_graph_doc_count -> cli_run::doc_graph over docs/ markdown files read from disk", candidates: [BoundHostEffectClass, PureDagComputationClass], settling: "split into an acquired-inventory input (bound Filesystem provider) and a .dag fold over it; the gunbc.parsed_import_statement_bridge_seed_growth dissolution names the shape: the native context fold supplies the acquired inventory to the census"),
    unresolved(name: "doc_graph_orphan_count", category: FilesystemEffect, cause: mixed(questions: ["which files/bytes are acquired (a Filesystem demand at operation/logical-subject grain, bound at a root)", "what is computed over the acquired corpus (a pure fold, or a compiler query where the product is compiler state)"]), evidence: "cli_run::doc_graph_orphan_count over the same acquired doc graph", candidates: [BoundHostEffectClass, PureDagComputationClass], settling: "split into an acquired-inventory input (bound Filesystem provider) and a .dag fold over it; the gunbc.parsed_import_statement_bridge_seed_growth dissolution names the shape: the native context fold supplies the acquired inventory to the census"),
