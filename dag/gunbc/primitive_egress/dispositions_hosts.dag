    evidence_row(name: "shell_materialize_operation_argv", category: ProcessEffect, external_subject: NoExternalSubject, computation: computes(authority: authority_required(home: "std.process: pure ProcessExecutionRequest construction from an operation row, workspace, files and environment"), inputs: "operation: String, workspace_dir: String, files: List, environment: List", result: "the argv/request value; a pure construction (ruling: pure .dag request construction); total", body: DagBodyRequired), refusals: RefusalsTyped, realization: NoNativeRealizationClaim, compiler_query: NotACompilerQuery, conflict: NoMeaningConflict, located: "shell_materialize_operation_argv: the realization surfaces the census joins (registry row / contract row / algebra template / rt bridge / interpreter arm as present) and the authority named in the computation standing", next: "the owning lane lands the .dag body under the declared authority and switches one production consumer; the interpreter arm and bridge then delete for that consumer"),
    evidence_row(name: "shell_transport_operation_rows", category: ProcessEffect, external_subject: NoExternalSubject, computation: computes(authority: authority_required(home: "std.process: the modeled operation/transport contract rows as data"), inputs: "(none)", result: "the transport operation rows; modeled contract data, not an effect; total", body: DagBodyRequired), refusals: RefusalsTyped, realization: NoNativeRealizationClaim, compiler_query: NotACompilerQuery, conflict: NoMeaningConflict, located: "shell_transport_operation_rows: the realization surfaces the census joins (registry row / contract row / algebra template / rt bridge / interpreter arm as present) and the authority named in the computation standing", next: "the owning lane lands the .dag body under the declared authority and switches one production consumer; the interpreter arm and bridge then delete for that consumer"),
    evidence_row(name: "hash_combine", category: ContentHash, external_subject: NoExternalSubject, computation: computes(authority: authority(module_path: "std.content_hash", decl_name: "HashFamily"), inputs: "left, right: String (or one lexeme)", result: "a 64-bit digest; total", body: DagBodyRequired), refusals: RefusalsTyped, realization: realizes(module_path: "std.content_hash", decl_name: "HashFamily", semantics: "h(left ++ NUL ++ right) over the FNV-1a64 structural family: the combine preimage is left, a NUL code point, right (CONTENT-HASH-0 cut 1 models it via content_hash_atom byte-identically)", realization: "v1_rt::hash_combine (FNV-1a 64 over the concatenated preimage)", reference: reference_at(module_path: "std.content_hash", decl_name: "content_hash_atom"), equivalence: unqualified(obligation: "byte-identity of the native digest against the modeled preimage on the store-identity fixtures, owed by CONTENT-HASH-0 cut 1 (the gunbc#11626 ruling names the FNV kernel as a target-kernel realization until the NUMERIC-BIT-0 words and ENCODING-0 bytes land; the derivation records it as a candidate until that witness exists)")), compiler_query: NotACompilerQuery, conflict: NoMeaningConflict, located: "hash_combine: the algebra template named as the authority, the rt bridge and the interpreter arm", next: "the owning lane lands the reference body and the equivalence witness; the emitter then selects the native kernel through the operation authority"),
