    evidence_row(name: "Filesystem.List", category: FilesystemEffect, external_subject: observes(operation: "Filesystem.List", subject: "the entries of one directory under the hermetic checkout root (a different result shape, ordering question and refusal set from Read)", provider: provider_declared(module_path: "extdeps.filesystem.filesystem_io", decl_name: "Filesystem"), ambient: "the same eval_service_call carve-out, the List alternative; ambient"), computation: NoPureComputationHalf, refusals: RefusalsNotApplicable, realization: NoNativeRealizationClaim, compiler_query: NotACompilerQuery, conflict: NoMeaningConflict, located: "Filesystem.List: the interpreter arm and bridge named in the ambient realization", next: "derive the DependencyDemand at operation/logical-subject grain (D13) and bind the provider at a composition root; then the ambient arm deletes for the switched consumer"),
    evidence_row(name: "emit_host_run_transport", category: ProcessEffect, external_subject: observes(operation: "run an emitted host program: build then execute under a declared environment", subject: "a ProcessExecutionRequest (executable, argv, environment, working directory, result channels) -- the gunbc#11626 Process ruling; NOT Network", provider: provider_required(shape: "LocalProcessProvider realizing ProcessExecutionRequest -> ProviderUnavailable | ExecutableUnresolved | SpawnRefused | Spawned | Exited | Signaled | TimedOut | Cancelled | OutputUnreadable | OutputTruncated"), ambient: "free_call.emit_host_run_transport -> cli_run::emit_host (cargo build + process spawn), ambient"), computation: NoPureComputationHalf, refusals: RefusalsNotApplicable, realization: NoNativeRealizationClaim, compiler_query: NotACompilerQuery, conflict: NoMeaningConflict, located: "emit_host_run_transport: the interpreter arm and bridge named in the ambient realization", next: "derive the DependencyDemand at operation/logical-subject grain (D13) and bind the provider at a composition root; then the ambient arm deletes for the switched consumer"),
    evidence_row(name: "emit_host_run_transport_cached", category: ProcessEffect, external_subject: observes(operation: "emit_host_run_transport composed with materialization/cache policy", subject: "the same process request, served through the materialization ladder when an admitted artifact exists", provider: provider_required(shape: "the Process provider above composed with std.materialization_provider ArtifactRequest; the cache half is not a Process fact"), ambient: "free_call.emit_host_run_transport_cached, ambient"), computation: NoPureComputationHalf, refusals: RefusalsNotApplicable, realization: NoNativeRealizationClaim, compiler_query: NotACompilerQuery, conflict: NoMeaningConflict, located: "emit_host_run_transport_cached: the interpreter arm and bridge named in the ambient realization", next: "derive the DependencyDemand at operation/logical-subject grain (D13) and bind the provider at a composition root; then the ambient arm deletes for the switched consumer"),
    evidence_row(name: "emit_host_native_cache_evict", category: FilesystemEffect, external_subject: observes(operation: "evict the emit-host native build cache under a workspace dir", subject: "a materialization store mutation (the gunbc#11626 ruling: cache/store mutation, NOT Process)", provider: provider_required(shape: "std.artifact_store ArtifactStore eviction over the emit-host cache subject"), ambient: "free_call.emit_host_native_cache_evict, ambient filesystem removal"), computation: NoPureComputationHalf, refusals: RefusalsNotApplicable, realization: NoNativeRealizationClaim, compiler_query: NotACompilerQuery, conflict: NoMeaningConflict, located: "emit_host_native_cache_evict: the interpreter arm and bridge named in the ambient realization", next: "derive the DependencyDemand at operation/logical-subject grain (D13) and bind the provider at a composition root; then the ambient arm deletes for the switched consumer"),
    evidence_row(name: "toolchain_home_interference_probe", category: ProcessEffect, external_subject: observes(operation: "observe whether the shared toolchain home is being rewritten by a neighbour", subject: "host environment observation (the ruling: not automatically Process, not automatically Filesystem); the logical subject is the toolchain installation state", provider: provider_required(shape: "an environment-observation provider answering the toolchain-home state as a typed observation"), ambient: "free_call.toolchain_home_interference_probe, ambient"), computation: NoPureComputationHalf, refusals: RefusalsNotApplicable, realization: NoNativeRealizationClaim, compiler_query: NotACompilerQuery, conflict: NoMeaningConflict, located: "toolchain_home_interference_probe: the interpreter arm and bridge named in the ambient realization", next: "derive the DependencyDemand at operation/logical-subject grain (D13) and bind the provider at a composition root; then the ambient arm deletes for the switched consumer"),
    evidence_row(name: "observed_monotonic_nanos", category: ClockEffect, external_subject: observes(operation: "read the monotonic clock", subject: "a std.observation ClockBasis reading (monotonic, not wall)", provider: provider_declared(module_path: "std.observation", decl_name: "ClockLookup"), ambient: "free_call.observed_monotonic_nanos over std::time::Instant, ambient"), computation: NoPureComputationHalf, refusals: RefusalsNotApplicable, realization: NoNativeRealizationClaim, compiler_query: NotACompilerQuery, conflict: NoMeaningConflict, located: "observed_monotonic_nanos: the interpreter arm and bridge named in the ambient realization", next: "derive the DependencyDemand at operation/logical-subject grain (D13) and bind the provider at a composition root; then the ambient arm deletes for the switched consumer"),
    evidence_row(name: "observed_peak_resident_bytes", category: MeasurementEffect, external_subject: observes(operation: "read the process peak resident set size", subject: "a host resource measurement of THIS process (VmHWM); a /proc read is the mechanism, not the subject", provider: provider_required(shape: "a process-resource measurement provider answering Measured<Byte>"), ambient: "free_call.observed_peak_resident_bytes -> cli_run::peak_rss_vhwm_bytes over /proc/self/status, ambient"), computation: NoPureComputationHalf, refusals: RefusalsNotApplicable, realization: NoNativeRealizationClaim, compiler_query: NotACompilerQuery, conflict: NoMeaningConflict, located: "observed_peak_resident_bytes: the interpreter arm and bridge named in the ambient realization", next: "derive the DependencyDemand at operation/logical-subject grain (D13) and bind the provider at a composition root; then the ambient arm deletes for the switched consumer"),
