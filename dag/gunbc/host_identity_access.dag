module gunbc.host_identity_access


data host_identity_hostnamectl_path: NonEmptyStr = fleet_hostnamectl_command_path

fn host_identity_ssh_access(host: ComputeHost, ssh_host: NonEmptyStr) -> DeployAccess {
  let principal = fleet_posix_principal(key: FleetAccountOperator)
  DeployAccess {
    principal: principal,
    host: host,
    transport: SshShell { ssh_host: ssh_host },
    privileged_commands: grounded_principal_privileged_commands(p: principal),
  }
}

data host_identity_srv1_access: DeployAccess = host_identity_ssh_access(
  host: srv1_host,
  ssh_host: operator_host_srv1 as NonEmptyStr,
)

data host_identity_srv2_access: DeployAccess = host_identity_ssh_access(
  host: srv2_host,
  ssh_host: operator_host_srv2 as NonEmptyStr,
)

data host_identity_srv4_access: DeployAccess = host_identity_ssh_access(
  host: srv4_host,
  ssh_host: operator_host_srv4 as NonEmptyStr,
)

data host_identity_srv3_access_note: String = "srv3 gains the same direct-SSH access shape as srv4 (operator, 2026-07-24: 'same access pattern as srv4'), now that its host OS is a modeled endpoint (gunbc.fleet_intent_network.srv3_host_lan_endpoint, 192.168.1.221) rather than BMC-only. This row is how you reach srv3 ITSELF, and it is NOT interchangeable with ci_deploy_srv1_operator_access: the latter reaches the host an OsInstallActuator run drives srv3's BMC FROM, which is a different machine. Consumed through gunbc.host_toolchain_ensure.host_toolchain_direct_access, which the reach pairing derives from the resolved TARGET host — so the kind-aware split (BuildCache targets srv3, OsInstallActuator targets the selected actuator host) falls out of target resolution instead of being a second parallel lookup that could disagree with it. LIVENESS: unproven — as of 2026-07-24 the fleet-automation-ssh-key is authorized on srv3 for no user probed (briansrls/ubuntu/root/installserver all refuse publickey), so this row declares the intended shape and its first live use must fail closed until key distribution lands (fleet_subsumption_manual_gaps A1/B2)."

data host_identity_srv3_access: DeployAccess = host_identity_ssh_access(
  host: srv3_host,
  ssh_host: operator_host_srv3 as NonEmptyStr,
)

fn host_identity_operator_principal_name() -> NonEmptyStr {
  grounded_posix_principal_name(
    p: fleet_posix_principal(key: FleetAccountOperator)
  )
}
