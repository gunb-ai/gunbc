module gunbc.host_identity_access


data host_identity_hostnamectl_path: NonEmptyStr = fleet_hostnamectl_command_path

fn host_identity_ssh_access(host: ComputeHost, ssh_host: NonEmptyStr) -> DeployAccess {
  let principal = fleet_posix_principal(key: FleetAccountOperator)
  DeployAccess {
    principal: principal,
    host: host,
    transport: SshShell { ssh_host: ssh_host },
    privileged_commands: grounded_principal_privileged_commands(p: principal),
  }
}

data host_identity_srv1_access: DeployAccess = host_identity_ssh_access(
  host: srv1_host,
  ssh_host: operator_host_srv1 as NonEmptyStr,
)

data host_identity_srv2_access: DeployAccess = host_identity_ssh_access(
  host: srv2_host,
  ssh_host: operator_host_srv2 as NonEmptyStr,
)

data host_identity_srv4_access: DeployAccess = host_identity_ssh_access(
  host: srv4_host,
  ssh_host: operator_host_srv4 as NonEmptyStr,
)

data host_identity_srv3_access_note: String = "srv3 gains the same direct-SSH access shape as srv4 (operator, 2026-07-24: 'same access pattern as srv4'), now that its host OS is a modeled endpoint (gunbc.fleet_intent_network.srv3_host_lan_endpoint, 192.168.1.221) rather than BMC-only. This row is how you reach srv3 ITSELF, and it is NOT interchangeable with ci_deploy_srv1_operator_access: the latter reaches the host an OsInstallActuator run drives srv3's BMC FROM, which is a different machine. Consumed through gunbc.host_toolchain_ensure.host_toolchain_direct_access, which the reach pairing derives from the resolved TARGET host — so the kind-aware split (BuildCache targets srv3, OsInstallActuator targets the selected actuator host) falls out of target resolution instead of being a second parallel lookup that could disagree with it. NETWORK REACH is NOT direct despite the shape mirroring srv4: srv3 is a fabric-only target reached through srv2, modeled as gunbc.fleet_reach.srv3_reach (ProxyJump interim, dissolving to FabricTunnel when the fabric works). This transport's SshShell ssh_host realizes OVER that reach — the network path (how packets get to srv3) is deliberately INDEPENDENT of the shell/auth transport (how a command runs once reached), per the operator rule 2026-07-24; encoding the jump INTO the transport (so SshShell carries a Reach rather than a bare host alias) is the reach-independent-of-shell decomposition (step b, coordinated with the shell→dag transport-wall lane). LIVENESS grounded 2026-07-25 (corrected from an earlier over-broad claim): srv3 IS reachable and a command DOES run today — session -> srv2 (briansrls) -> ubuntu@srv3 authenticated by srv2's local node-orch key (~/.node-orch/id_ed25519 = node-orch@srv2, which ubuntu@srv3's authorized_keys trusts); proven by execution (hostname=srv3, aarch64, 128 cores, Ubuntu 24.04.3). So both the network reach AND a working shell path exist via that bootstrap credential. The NARROWER real gap: the FLEET identity (fleet-automation-ssh-key) is not yet on srv3 — srv3 was autoinstalled Jul 13 with ssh.authorized-keys EMPTY and hand-keyed post-install with node-orch@srv2 / briansrls@srv1 / macbook only, so the modeled DeployAccess principal (FleetAccountOperator) does not yet have a key srv3 trusts. That is a one-time host_authorized_keys_reconcile upsert over the working node-orch hop (fleet_subsumption_manual_gaps A1/B2), NOT an unreachable host. Reach realizable; a bootstrap shell path works; the fleet-identity shell path is pending key distribution — three facts held separate."

data host_identity_srv3_access: DeployAccess = host_identity_ssh_access(
  host: srv3_host,
  ssh_host: operator_host_srv3 as NonEmptyStr,
)

fn host_identity_operator_principal_name() -> NonEmptyStr {
  grounded_posix_principal_name(
    p: fleet_posix_principal(key: FleetAccountOperator)
  )
}
