      at_assert(n: "XCTAssertEqual", a: [sw_call(f: sw_path(b: "Route", m: "request"), a: [sw_pos(v: sw_path(b: "f", m: "escalation_id"))]), at_envelope(v: fx_env_request_path)]),
      sw_let(n: "g", e: at_decode(decoder: "enrolmentGrant", e: at_data_utf8(e: at_envelope(v: fx_env_enrolment_grant)))),
      at_assert(n: "XCTAssertEqual", a: [sw_call(f: sw_path(b: "Route", m: "enrollment"), a: [sw_pos(v: sw_path(b: "g", m: "enrollment_id"))]), at_envelope(v: fx_env_enrollment_path)]),
    ]),
    at_test(
      doc: ["path_segment over every input -> encoded vector the .dag fold emitted: \"id-\" + padded", "base64url of the UTF-8 bytes."],
      n: "testPathSegmentMatchesEveryVector", th: true,
      b: [
        at_each(section: "path_segment", b: [
          at_assert(n: "XCTAssertEqual", a: [sw_call(f: sw_path(b: "Route", m: "segment"), a: [sw_pos(v: sw_path(b: "v", m: "input"))]), sw_path(b: "v", m: "encoded"), sw_path(b: "v", m: "input")]),
        ]),
        sw_cmt_stmt(c: ["Alphabet control: the URL-safe variant, padded, never \"+\" or \"/\"."], s: sw_let(n: "seg", e: sw_call(f: sw_path(b: "Route", m: "segment"), a: [sw_pos(v: sw_str(s: "\u{FFFF}?>"))]))),
        at_assert(n: "XCTAssertTrue", a: [sw_op(
          l: sw_op(l: sw_call(f: sw_path(b: "seg", m: "hasPrefix"), a: [sw_pos(v: sw_str(s: "id-"))]), o: SwiftLogicalAndOperator, r: sw_not(e: sw_call(f: sw_path(b: "seg", m: "contains"), a: [sw_pos(v: sw_str(s: "+"))]))),
          o: SwiftLogicalAndOperator,
          r: sw_not(e: sw_call(f: sw_path(b: "seg", m: "contains"), a: [sw_pos(v: sw_str(s: "/"))]))
        )]),
      ]
    ),
    // The escaping contract, driven by the fixture. Both the character and the bytes it must become
    // come out of vectors.json's escape section, whose expectations the .dag serializer itself produced
    // (see escape_vector_json in the fixture). Nothing here spells a character or an expected escape:
    // the old version hand-typed one input and hand-typed its expected "\u00XX", so it proved nothing
    // about the escape table and survived any change to it.
    at_test(doc: ["The emitter's escaping is serialize_json's, over every specimen the fixture carries."], n: "testEmitterEscapesLikeSerializeJson", th: true, b: [
      sw_let(n: "vectors", e: sw_try(e: sw_calln(f: "XCTUnwrap", a: [
        sw_pos(v: sw_mem(b: at_load(), m: "escape")),
        sw_pos(v: sw_str(s: "vectors.json has no escape section — it is emitted by gunbc.auth.approval_device_redemption_fixtures escape_specimens")),
      ]))),
      at_assert(n: "XCTAssertFalse", a: [sw_path(b: "vectors", m: "isEmpty"), sw_str(s: "no escape specimens")]),
      sw_for(n: "v", e: sw_id(n: "vectors"), s: [
        at_assert(n: "XCTAssertEqual", a: [
          sw_mem(b: sw_call(f: sw_path(b: "WireJson", m: "string"), a: [sw_pos(v: sw_path(b: "v", m: "input"))]), m: "serialized"),
          sw_path(b: "v", m: "string_json"),
          sw_path(b: "v", m: "input"),
        ]),
        at_assert(n: "XCTAssertEqual", a: [
          sw_mem(b: sw_call(f: sw_path(b: "WireJson", m: "object"), a: [sw_pos(v: sw_arr(e: [sw_tuple(e: [sw_pos(v: sw_str(s: "k")), sw_pos(v: sw_call(f: sw_dot(n: "array"), a: [sw_pos(v: sw_arr(e: [sw_call(f: sw_dot(n: "string"), a: [sw_pos(v: sw_path(b: "v", m: "input"))])]))]))])]))]), m: "serialized"),
          sw_path(b: "v", m: "object_json"),
          sw_path(b: "v", m: "input"),
        ]),
      ]),
    ]),
  ]
}

// XCTAssertEqual(WireEncode.<codec>(try WireDecode.<codec>(Data(body.utf8))), body)
fn at_round_trip(doc: List<String>, n: String, v: EnvelopeVector, codec: String) -> SwiftDecl {
  at_test(doc: doc, n: n, th: true, b: [
    sw_let(n: "body", e: at_envelope(v: v)),
    at_assert(n: "XCTAssertEqual", a: [sw_call(f: sw_path(b: "WireEncode", m: codec), a: [sw_pos(v: at_decode(decoder: codec, e: at_data_utf8(e: sw_id(n: "body"))))]), sw_id(n: "body")]),
  ])
}

data approve_ios_tests_header: List<String> = [
  "The Swift byte builders against the vectors the .dag witness EMITS from device_redemption_signing_input",
  "and google_enrolment_transcript and google_enrolment_nonce (dag/test/fixture/approval_device_redemption/vectors.json). No expected byte",
  "is written here: a hand-copied expectation would be a second authority for the join.",
  "GENERATED from gunbc.approve_ios_swift_protocol_vector_tests from the Swift grammar rows (v2.extdeps.languages.swift.rows); do not edit.",
]

// The test bundle's resource name is DERIVED, never re-spelled (DESIGN §5: the fact lives in exactly
// one .dag declaration). Bundle(for:).url(forResource:withExtension:) takes the stem and extension
// apart, and the only authority for the file's name is gunbc.generated_artifact's location row for
// ApprovalDeviceVectorsArtifact — artifact_location(ApprovalDeviceVectorsArtifact).name — so the stem and
// extension below are that row's `name` split on its dot. A hand-typed "vectors"/"json" was a second
// authority: renaming the emitted fixture left load() looking for a file that no longer existed, and
// nothing but the MacBook-only XCTest noticed.
fn approve_ios_vectors_artifact_name() -> String {
  artifact_location(a: ApprovalDeviceVectorsArtifact).name
}

// The name load() asks Bundle for is THIS row's, not a hand-typed pair:
// artifact_location(ApprovalDeviceVectorsArtifact) from gunbc.generated_artifact. Splitting is done once, as a total match that
// yields a ResourceParts or nothing at all, and the boundary below refuses when it yields nothing — so
// the emitted Swift cannot be built from a half-name. There is no "" sentinel and no scan of the
// rendered text: a malformed artifact row produces a typed refusal with a located reason (DESIGN §5,
// unwritable not checked, no fabricated default). The stem/extension the file does contain are read off
// the matched value, so no second spelling of them exists in this module.
type ResourceParts {
  stem: String
  extension: String
}

fn approve_ios_vectors_resource_parts(name: String) -> ResourceParts? {
  let parts = split(s: name, delimiter: ".")
  if count(parts) != 2 {
    Absent
  } else {
    match parts.first() {
      Present { value: stem } =>
        match parts.last() {
          Present { value: ext } =>
            if stem == "" || ext == "" {
              Absent
            } else {
              Present { value: ResourceParts { stem: stem, extension: ext } }
            }
          Absent => Absent
        }
      Absent => Absent
    }
  }
}

fn approve_ios_vectors_artifact_resource_parts() -> ResourceParts? {
  approve_ios_vectors_resource_parts(name: approve_ios_vectors_artifact_name())
}

// The no-parts case, named so the boundary can be driven from a claim without a type application at the
// call site (the dialect has no precedent for calling optional_absent<T>() explicitly). Same value the
// match above produces for a malformed row.
fn approve_ios_vectors_no_resource_parts() -> ResourceParts? {
  Absent
}

fn approve_ios_protocol_vector_tests_swift_file(parts: ResourceParts) -> SwiftSourceFile {
  SwiftSourceFile {
    declarations: [
      sw_cmt(c: approve_ios_tests_header, d: sw_import(n: "XCTest")),
      SwiftImportDecl { attributes: [SwiftAttribute { name: "testable", arguments: [] }], module_name: "Approve" },
      at_vectors(),
      SwiftClassDecl { attributes: [], modifiers: [SwiftFinalModifier], name: "ProtocolVectorTests", inherits: [sw_t(n: "XCTestCase")], members: at_tests(parts: parts) },
    ],
  }
}

// One name shared by the refusal and the positive witness, so the two cannot disagree about what was
// refused. Carried as a value, not baked into the emitted bytes: no Swift text is produced on this arm.
data approve_ios_vectors_resource_refusal_reason: Symbol = "approve-ios-vectors-resource-name-not-a-stem-and-extension"

// The escape section is assembled from other rows, so a row set emptied at the source would leave the
// escaping test looping over nothing and passing. That is the failure this file already refuses for
// load() ("a green run with no vectors would establish nothing"), and it is reachable here from one
// direction load() has not. Refuse the emission instead.
fn approve_ios_vectors_escape_specimens_present() -> Bool {
  count(escape_specimens) > 0
}

data approve_ios_vectors_escape_refusal_reason: Symbol = "approve-ios-vectors-escape-section-has-no-specimens"

// Two guards remain, and both are guards over VALUES, not scans of rendered text: an artifact row whose
// name is not <stem>.<extension>, and an escape row set with nothing in it. The envelope case has no
// guard at all any more — at_envelope takes the fixture's EnvelopeVector row, so there is no name here
// that could fail to match a row. What used to detect that fault (a .contains("envelope(\"\")") grep over
// the emitted Swift, plus the Absent => "" that made the grep necessary) is deleted: DESIGN §5 counts a
// typecheck-plus-grep as no consumer at all. Driveable so the witness can assert the refusals themselves
// return true, rather than committing a claim that is red at head.
fn approve_ios_vectors_emission(parts: ResourceParts?, escape_present: Bool) -> SwiftRowEmission {
  match parts {
    Absent => SwiftRowEmissionRefused { reason: approve_ios_vectors_resource_refusal_reason }
    Present { value: p } =>
      if !escape_present {
        SwiftRowEmissionRefused { reason: approve_ios_vectors_escape_refusal_reason }
      } else {
        swift_rows_emit_source_file(f: approve_ios_protocol_vector_tests_swift_file(parts: p))
      }
  }
}

fn expected_approve_ios_protocol_vector_tests_swift() -> SwiftRowEmission {
  approve_ios_vectors_emission(parts: approve_ios_vectors_artifact_resource_parts(), escape_present: approve_ios_vectors_escape_specimens_present())
}
