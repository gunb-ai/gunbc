module gunbc.floor_materialization

import std.types { Bool, Int, List, String }
import std.materialization_ladder {
  Frame, SharedStateFrame,
  CacheProvider, ReferenceTier,
  CoversIdentities,
  scope_exit_eviction,
  provider_row,
  ValueUsage, ValueConsumerEdge, ReadAccess,
  ValueMaterialization, value_materialization
}

data floor_materialization_note: String = "P1 — the in-process resolve share, declared. Every v2 lens is a pure reader over one resolved graph (InferredTree -> dependency_lens -> DependencyView, then O(edges) reachability); N lenses demanding one resolve-identity with no Share is the ladder's rule-1 AuthoredDuplication at a SharedStateFrame (one claim_executor process). The fix is the rule-1 REWIRE, not a cache: union-resolve S1 (#6234) already resolves the union closure ONCE per (thread, source_roots) via process_shared_index (cli_run.rs:1737) and hands every consumer a reference; the resolved graph is readonly, so the plural reads are legal at the VALUE tier (ValueSharedByReference). This module DECLARES that correct-but-undeclared share as a ReferenceTier provider row so it is ladder-visible and a regression (a consumer that resolves privately instead of reading the share) is countable, not re-discovered per lens. Companion runtime receipt: gunbc.ci_materialization's resolves_total (cold entry resolves paid) — the measured half; this reader_count is the declared half. The two are DIFFERENT quantities (many readers, one resolve) and pair as the before/after case study, so declaring the share does not move ci_floor_declared_resolve_count."

data floor_resolve_share_provider_id: String = "process_shared_index"

data floor_resolve_identity: String = "union-resolve(dag,src/v2)"

fn floor_executor_process_frame() -> Frame {
  Frame { name: "claim_executor-process", kind: SharedStateFrame }
}

data floor_resolve_share_provider: CacheProvider = provider_row(
  id: floor_resolve_share_provider_id,
  scope: [floor_executor_process_frame()],
  coverage: CoversIdentities { identities: [floor_resolve_identity] },
  tier: ReferenceTier,
  eviction: scope_exit_eviction()
)

data floor_resolve_share_providers: List<CacheProvider> = [floor_resolve_share_provider]

data floor_resolve_share_provider_tier_note: String = "ReferenceTier declared DIRECTLY via provider_row, deliberately NOT provider_from_catalog: the catalog door births STORE tiers from cited upstream facts (that is P2 = resolved_graph_cache, the cross-process content-keyed store graph-major S2b adopts). ReferenceTier is keyless by shape (the dependency edge IS the address) and enters only via provider_row; forcing an in-process name-keyed share through the catalog would project ExistenceKeyed and be refused/mislabeled (#6352). The share's legitimacy is the value tier — the product of the rule-1 rewire S1 already did — not obligation discharge."

fn floor_resolve_value_usage(consumer_sites: List<String>) -> ValueUsage {
  ValueUsage {
    identity: floor_resolve_identity,
    consumers: consumer_sites |> map(s => ValueConsumerEdge { access: ReadAccess, site: s })
  }
}

fn floor_resolve_materialization(consumer_sites: List<String>) -> ValueMaterialization {
  value_materialization(
    usage: floor_resolve_value_usage(consumer_sites: consumer_sites),
    providers: floor_resolve_share_providers
  )
}

data floor_resolve_p1_p2_convergence_note: String = "P1 (this module's in-process ReferenceTier share = process_shared_index) and P2 (extdeps.realization.resolved_graph.resolved_graph_cache, PerHostFilesystem/ContentAddressed/SizeBounded 10GiB, projecting through provider_from_catalog to ArtifactTier{ContentKeyed}) are two providers of ONE computation identity (the resolved graph), never two unrelated stores (the fnv1a64 dual-surface discipline). P1 discharges same-process plurality (rule-1 rewire, value tier); P2 discharges the cross-process/cross-run isolation-LCA obligation (compile subprocess vs claim_executor frontier), which a reference cannot cross. DISSOLVE-ON: when graph-major S2b is default-on, the cross-run (UnboundedSiblingsFrame) frame enrolls and P2's provider row goes live beside this one; per-shard W-x same-process residual (Rc<ResolvedGraph> !Send) collapses to whole-run once under the Rc->Arc migration (graph-major S3)."

data floor_materialization_status_note: String = "DRAFT — unverified pending #6375 (std.materialization_ladder carriers are only on session/merry-moth-539, not main). Verification step: merge #6375, then claim_batch the floor_materialization witness green-by-execution (ValueSharedByReference with reader_count == live consumer count; RED control providers=[] -> ValueRefusedNoCarrierProvider). Consumer-roster SOURCE (which live roster fills consumer_sites) is confirmed with merry-moth before the witness wires it."
