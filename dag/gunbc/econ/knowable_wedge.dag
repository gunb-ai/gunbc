module gunbc.econ.knowable_wedge


data knowable_wedge_note: String = "Knowable wedge = publicly cited umbrella price minus a cost floor derivable from cited hardware rows, given explicitly declared utilization/amortization/exchange-rate assumptions. Opaque inputs refuse — never estimate around Unknown."

// Per-thread cost allocation divides by HardwareThreadCount on both sides — umbrella_row.vcpus (GithubActionsRunnerPriceRow) and hetzner_dedicated_server_threads (CpuFacts catalog threads). The carrier grounds SMT-sibling counting; no parallel Bool assertion.
data wedge_fx_assumption_frontier: String = "eur_to_usd_numerator/denominator are explicitly declared WedgeAssumptions inputs (refuses ExchangeRateUnknown on zero denominator), not cited extdeps facts. dissolve-on: extdeps.forex authority + MoneyRate<From,To> carrier when a second FX consumer appears."

type WedgeAssumptions {
  runner_utilization_bp: std.measure.BasisPoint
  amortization_months: std.measure.AmortizationMonths
  eur_to_usd_numerator: std.nat.Nat
  eur_to_usd_denominator: std.nat.Nat
}

type WedgeAssumptionsInput
  = WedgeAssumptionsDeclared { assumptions: WedgeAssumptions }
  | WedgeAssumptionsUnknown

type KnowableWedgeRefusalCause
  = AssumptionsUnknown
  | UtilizationUnknown
  | AmortizationUnknown
  | ExchangeRateUnknown
  | ServerThreadCountUnknown
  | RunnerThreadCountUnknown
  | UmbrellaCurrencyMismatch
  | FloorCurrencyMismatch
  | FloorExceedsUmbrella

type RunnerCostFloorResult
  = RunnerCostFloorDerived { floor: std.measure.MoneyPerMinute }
  | RunnerCostFloorRefused { cause: KnowableWedgeRefusalCause }

type KnowableWedgeDerived {
  umbrella_per_minute: std.measure.MoneyPerMinute
  cost_floor_per_minute: std.measure.MoneyPerMinute
  wedge_per_minute: std.measure.MoneyPerMinute
}

type KnowableWedgeResult
  = KnowableWedgeComputed { wedge: KnowableWedgeDerived }
  | KnowableWedgeRefused { cause: KnowableWedgeRefusalCause }

fn minutes_per_billing_month() -> std.nat.Nat {
  std.measure.billing_month_as_hour_count() * std.measure.minutes_per_hour()
}

fn money_per_minute_from_money_per_month(monthly: std.measure.MoneyPerMonth) -> std.measure.MoneyPerMinute {
  std.measure.MoneyPerMinute {
    amount: std.measure.money_amount_micro(count: std.measure.money_per_month_micros(q: monthly) / minutes_per_billing_month()),
    currency: monthly.currency,
  }
}

fn convert_money_per_minute_eur_to_usd(
  eur: std.measure.MoneyPerMinute,
  numerator: std.nat.Nat,
  denominator: std.nat.Nat,
) -> std.measure.MoneyPerMinute? {
  if denominator <= 0 {
    none
  } else {
    match eur.currency {
      std.currency.Eur =>
        Present {
          value: std.measure.MoneyPerMinute {
            amount: std.measure.money_amount_micro(count: (std.measure.money_per_minute_micros(q: eur) * numerator) / denominator),
            currency: std.currency.Usd,
          }
        }
      _ => none
    }
  }
}

fn subtract_money_per_minute_usd(umbrella: std.measure.MoneyPerMinute, floor: std.measure.MoneyPerMinute) -> std.measure.MoneyPerMinute? {
  let umbrella_micros = std.measure.money_per_minute_micros(q: umbrella)
  let floor_micros = std.measure.money_per_minute_micros(q: floor)
  if umbrella_micros < floor_micros {
    none
  } else {
    Present {
      value: std.measure.MoneyPerMinute {
        amount: std.measure.money_amount_micro(count: umbrella_micros - floor_micros),
        currency: std.currency.Usd,
      }
    }
  }
}

fn derive_monthly_eur_with_amortization(
  row: extdeps.pricing.hetzner_dedicated.HetznerDedicatedServerPriceRow,
  amortization_months: std.measure.AmortizationMonths,
) -> std.measure.MoneyPerMonth? {
  let months = std.measure.amortization_months_count(m: amortization_months)
  if months <= 0 {
    none
  } else {
    let monthly = std.measure.money_per_month_micros(q: row.monthly)
    let setup = extdeps.pricing.hetzner_dedicated.hetzner_dedicated_setup_fee_micros(row: row)
    Present {
      value: std.measure.MoneyPerMonth {
        amount: std.measure.money_amount_micro(count: monthly + (setup / months)),
        currency: std.currency.Eur,
      }
    }
  }
}

fn derive_runner_cost_floor_per_minute_usd(
  row: extdeps.pricing.hetzner_dedicated.HetznerDedicatedServerPriceRow,
  runner_vcpus: std.measure.HardwareThreadCount,
  assumptions: WedgeAssumptions,
) -> RunnerCostFloorResult {
  if std.measure.basis_point_count(bp: assumptions.runner_utilization_bp) <= 0 {
    RunnerCostFloorRefused { cause: UtilizationUnknown }
  } else if std.measure.amortization_months_count(m: assumptions.amortization_months) <= 0 {
    RunnerCostFloorRefused { cause: AmortizationUnknown }
  } else if assumptions.eur_to_usd_denominator <= 0 {
    RunnerCostFloorRefused { cause: ExchangeRateUnknown }
  } else {
    let server_vcpus = extdeps.pricing.hetzner_dedicated.hetzner_dedicated_server_threads(row: row)
    let server_count = std.measure.hardware_thread_count_value(t: server_vcpus)
    let runner_count = std.measure.hardware_thread_count_value(t: runner_vcpus)
    if server_count <= 0 {
      RunnerCostFloorRefused { cause: ServerThreadCountUnknown }
    } else if runner_count <= 0 {
      RunnerCostFloorRefused { cause: RunnerThreadCountUnknown }
    } else {
      match derive_monthly_eur_with_amortization(
        row: row,
        amortization_months: assumptions.amortization_months,
      ) {
        Present { value: monthly_eur } => {
          let per_minute_server_eur = money_per_minute_from_money_per_month(monthly: monthly_eur)
          let per_minute_runner_eur = std.measure.MoneyPerMinute {
            amount: std.measure.money_amount_micro(
              count: (std.measure.money_per_minute_micros(q: per_minute_server_eur) * runner_count) / server_count
            ),
            currency: std.currency.Eur,
          }
          let utilized_runner_eur = std.measure.MoneyPerMinute {
            amount: std.measure.money_amount_micro(
              count: (std.measure.money_per_minute_micros(q: per_minute_runner_eur) * std.measure.basis_point_unity_count()) / std.measure.basis_point_count(bp: assumptions.runner_utilization_bp)
            ),
            currency: std.currency.Eur,
          }
          match convert_money_per_minute_eur_to_usd(
            eur: utilized_runner_eur,
            numerator: assumptions.eur_to_usd_numerator,
            denominator: assumptions.eur_to_usd_denominator,
          ) {
            Present { value: floor_usd } =>
              RunnerCostFloorDerived { floor: floor_usd }
            _ => RunnerCostFloorRefused { cause: ExchangeRateUnknown }
          }
        }
        _ => RunnerCostFloorRefused { cause: AmortizationUnknown }
      }
    }
  }
}

fn derive_github_hetzner_ci_minute_wedge(
  umbrella_row: extdeps.pricing.github_actions.GithubActionsRunnerPriceRow,
  floor_row: extdeps.pricing.hetzner_dedicated.HetznerDedicatedServerPriceRow,
  assumptions_input: WedgeAssumptionsInput,
) -> KnowableWedgeResult {
  match assumptions_input {
    WedgeAssumptionsUnknown => KnowableWedgeRefused { cause: AssumptionsUnknown }
    WedgeAssumptionsDeclared { assumptions: assumptions } => {
      match umbrella_row.per_minute.currency {
        std.currency.Usd => {
          match floor_row.monthly.currency {
            std.currency.Eur => {
              match derive_runner_cost_floor_per_minute_usd(
                row: floor_row,
                runner_vcpus: umbrella_row.vcpus,
                assumptions: assumptions,
              ) {
                RunnerCostFloorDerived { floor: floor_usd } => {
                  match subtract_money_per_minute_usd(
                    umbrella: umbrella_row.per_minute,
                    floor: floor_usd,
                  ) {
                    Present { value: wedge_usd } =>
                      KnowableWedgeComputed {
                        wedge: KnowableWedgeDerived {
                          umbrella_per_minute: umbrella_row.per_minute,
                          cost_floor_per_minute: floor_usd,
                          wedge_per_minute: wedge_usd,
                        }
                      }
                    _ =>
                      KnowableWedgeRefused { cause: FloorExceedsUmbrella }
                  }
                }
                RunnerCostFloorRefused { cause: cause } =>
                  KnowableWedgeRefused { cause: cause }
              }
            }
            std.currency.Usd => KnowableWedgeRefused { cause: FloorCurrencyMismatch }
          }
        }
        std.currency.Eur => KnowableWedgeRefused { cause: UmbrellaCurrencyMismatch }
      }
    }
  }
}
