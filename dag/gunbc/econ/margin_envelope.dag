module gunbc.econ.margin_envelope


// Margin envelopes are DERIVED from filed SEC component rows at read time (extdeps.sec.facts filed_facts_derive_not_store_note) — never stored fields on issuer fact rows. Basis points are integer-derived from whole-dollar filed amounts via std.measure.BasisPoint: (profit * 10000) / revenue.
type MarginKind = GrossMargin | OperatingMargin

type MarginEnvelope {
  margin_low_bp: std.measure.BasisPoint
  margin_high_bp: std.measure.BasisPoint
}

type MarginEnvelopeRefusalCause
  = RevenueUnfiled
  | ProfitUnfiled
  | RevenueNonPositive
  | EnvelopeDerivationRefused

type MarginEnvelopeResult
  = MarginEnvelopeDerived { envelope: MarginEnvelope, margin_kind: MarginKind }
  | MarginEnvelopeRefused { cause: MarginEnvelopeRefusalCause }

fn margin_envelope_from_whole_dollar_counts(revenue: std.nat.Nat, profit: std.nat.Nat) -> MarginEnvelope? {
  if revenue <= 0 {
    none
  } else {
    let low_count = (profit * 10000) / revenue
    let high_count = ((profit * 10000) + revenue - 1) / revenue
    Present {
      value: MarginEnvelope {
        margin_low_bp: std.measure.basis_point(count: low_count),
        margin_high_bp: std.measure.basis_point(count: high_count),
      }
    }
  }
}

fn derive_margin_envelope_from_filed_facts(
  revenue: extdeps.sec.facts.FiledMonetaryFact,
  profit: extdeps.sec.facts.FiledMonetaryFact,
  margin_kind: MarginKind,
) -> MarginEnvelopeResult {
  match extdeps.sec.facts.filed_amount(fact: revenue) {
    Present { value: rev } =>
      match extdeps.sec.facts.filed_amount(fact: profit) {
        Present { value: prf } => {
          let rev_count = extdeps.sec.facts.usd_whole_dollars_count(m: rev)
          let prf_count = extdeps.sec.facts.usd_whole_dollars_count(m: prf)
          if rev_count <= 0 {
            MarginEnvelopeRefused { cause: RevenueNonPositive }
          } else {
            match margin_envelope_from_whole_dollar_counts(revenue: rev_count, profit: prf_count) {
              Present { value: envelope } =>
                MarginEnvelopeDerived { envelope: envelope, margin_kind: margin_kind }
              _ => MarginEnvelopeRefused { cause: EnvelopeDerivationRefused }
            }
          }
        }
        _ => MarginEnvelopeRefused { cause: ProfitUnfiled }
      }
    _ => MarginEnvelopeRefused { cause: RevenueUnfiled }
  }
}

fn margin_envelope_in_band(envelope: MarginEnvelope, low_bp: std.measure.BasisPoint, high_bp: std.measure.BasisPoint) -> Bool {
  (std.measure.basis_point_count(bp: envelope.margin_low_bp) >= std.measure.basis_point_count(bp: low_bp))
    && (std.measure.basis_point_count(bp: envelope.margin_high_bp) <= std.measure.basis_point_count(bp: high_bp))
    && (std.measure.basis_point_count(bp: envelope.margin_low_bp) <= std.measure.basis_point_count(bp: envelope.margin_high_bp))
}
