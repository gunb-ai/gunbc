module gunbc.econ.llm_attempt_receipt


data llm_attempt_receipt_note: String = "Typed receipt for one LLM attempt against gunbc work, sibling to gunbc.econ.knowable_wedge and gunbc.econ.scm_serving_model. This is a RECEIPT in the observing product layer, never a fact owned by an upstream provider (DESIGN external-upstream-decomposition rule): extdeps.llm.anthropic owns the provider wire contract, this module owns what WE observed when we ran something. It carries counts, durations and outcomes only -- no throughput, no cost, no tokens-per-second field exists anywhere in the record, so a transcribed rate is unrepresentable rather than lens-caught (same move as the guarantee-recovery claims carrier, which stores no rung). Every rate below is DERIVED from the stored pair and refuses when the pair cannot support it."

data llm_token_count_authority_note: String = "TokenCount, token_count and token_count_value are CONSUMED from std.measure, never redeclared here. An earlier revision of this module declared the alias locally as Measure of Count at One over Nat and cited extdeps.pricing.billing_units as precedent for the downstream placement; review 48816 refused that citation and was right. The billing_units aliases introduce their own phantom markers, so MoneyRate of PerStoredUnitMonth is a genuinely new point in the type space that cannot be written in std without importing vendor vocabulary; Measure of Count at One over Nat takes only arguments std.measure already owns, and that module already names the shape three times (HardwareThreadCount, CharacterCount, AmortizationMonths). A local fourth name was therefore the DESIGN section 3 fork, not a downstream instantiation, and the regen cost cited to justify it was a cost of doing the right thing rather than a reason not to. The carrier now lives beside its siblings under std.measure token_count_note."

data llm_model_identity_brand_note: String = "Requested and resolved model identity are DISTINCT named carriers, not one string used twice. The dispatch receipt bar (gunbc.dispatch_selection dispatch_execution_receipt_bar_note) says the system must never display what was REQUESTED as though it proved what RAN, and holding them in separate fields on separate types is what keeps the two facts addressable. MEASURED LIMIT, NOT A WALL (probe executed 2026-08-05 on this branch): a scratch entry passing a RequestedModelIdentity into a parameter declared ResolvedModelIdentity RESOLVED AND RAN GREEN, so brand() on NonEmptyStr does not refuse cross-brand substitution at this slice. An earlier revision of this note claimed the substitution 'does not compile' and cited a witness named requested_model_identity_is_not_resolved_model_identity that was never written -- both the claim and the citation were false, caught by executing the probe rather than by reading the type. So the honest rung here is MITIGATABLE, the same rung std.measure token_count_note records for the Count-axis family: distinct names buy reading clarity and separate construction sites, not unwritability. NEXT-RUNG TRIGGER: the brand-refinement enforcement path that would make cross-brand assignment a typecheck refusal, or distinct record carriers rather than two brands over one primitive; until one of those lands, a compile-red control is the only evidence that would establish the wall, and no such control exists."

type RequestedModelIdentity = std.types.NonEmptyStr where brand("RequestedModelIdentity")
type ResolvedModelIdentity = std.types.NonEmptyStr where brand("ResolvedModelIdentity")

data llm_artifact_identity_note: String = "A marketing model name is not an artifact. serving_runtime_identity and model_artifact_identity bind the exact served thing -- quantization, build, adapter set -- because two attempts naming the same model at different quantizations are different economic subjects. These stay NonEmptyStr at this slice: the cited artifact rows that would ground them (model catalog, GGUF sizes, runtime versions) land with the pricing rows in the follow-on, and grounding them early would mint a second artifact authority beside the one those rows will carry."

type LlmTaskClass
  = DagReview
  | DagPatch
  | WitnessRepair
  | ArchitectureJudgment

type ReviewDisposition
  = ReviewAccepted
  | ReviewRejected { reason: std.types.NonEmptyStr }
  | ReviewEscalated { reason: std.types.NonEmptyStr }

type LlmTokenUsage {
  input: std.measure.TokenCount
  cached_input: std.measure.TokenCount
  output: std.measure.TokenCount
}

data llm_usage_observation_note: String = "Usage is a three-state observation, never a zero default. An attempt whose provider reported no usage is NOT an attempt that consumed nothing: conflating the two is the absorbing-fallback shape DESIGN section 5 forbids, one level down -- bottom-as-answer standing in for bottom-as-ignorance. So LlmUsageUnobserved carries a located reason and every economic derivation over it refuses, while the attempt itself and its disposition remain fully readable. Execution is not refused because accounting is missing."

type LlmUsageObservation
  = LlmUsageObserved { usage: LlmTokenUsage }
  | LlmUsageUnobserved { reason: std.types.NonEmptyStr }

type PrefixCacheObservation
  = PrefixCacheHit { reused: std.measure.TokenCount }
  | PrefixCacheMiss
  | PrefixCacheUnobserved { reason: std.types.NonEmptyStr }

data llm_concurrency_grain_note: String = "Admitted sessions and active sequences are separate observations because they are separate facts: sixteen review agents do not ordinarily decode at once -- most are cloning, compiling, waiting on witnesses or on review. A server sustaining four active sequences can therefore admit considerably more than four agent sessions. Reporting either number as the other is the measurement error that makes a concurrency sweep unreadable, so the receipt records both and derives neither."

type ConcurrencyObservation {
  admitted_sessions: std.nat.Nat
  active_sequences: std.nat.Nat
}

data llm_phase_duration_note: String = "Durations are optional per phase and stay on Nanosecond, the canonical exact elapsed-time carrier (std.measure nanosecond_millisecond_projection_note: measurement, ordering, joining and attribution must retain Nanosecond; millisecond is presentation only). Queue delay is recorded beside prefill and decode because time-to-first-token under load is the quantity a concurrency sweep is actually buying, and a receipt that stored only decode would make a queue-bound host look fast."

type AttemptPhaseDurations {
  queue: std.measure.Nanosecond?
  prefill: std.measure.Nanosecond?
  decode: std.measure.Nanosecond?
}

data llm_substrate_identity_note: String = "The receipt binds the substrate revision that produced the task, not only the model that answered it. Escalation rate is endogenous to TWO independent variables -- the local model improving, and gunbc's own construction guarantees making tasks need less judgment -- and both push it down. Without the substrate identity on the economic receipt a falling escalation rate is credited to whichever variable was being worked on at the time, and the 'progressively smaller models suffice' thesis is a claim about the SECOND one, so it cannot be measured without this field."

type SubstrateIdentity {
  compiler_revision: std.types.NonEmptyStr
  authority_snapshot: std.types.NonEmptyStr
}

type LlmAttemptReceipt {
  attempt_identity: std.types.NonEmptyStr
  task_class: LlmTaskClass

  prompt_policy_identity: std.types.NonEmptyStr
  context_policy_identity: std.types.NonEmptyStr
  substrate: SubstrateIdentity

  requested_model: RequestedModelIdentity
  resolved_model: ResolvedModelIdentity
  model_artifact_identity: std.types.NonEmptyStr
  serving_runtime_identity: std.types.NonEmptyStr
  machine_opportunity_identity: std.types.NonEmptyStr

  concurrency: ConcurrencyObservation
  prefix_cache: PrefixCacheObservation

  usage: LlmUsageObservation
  durations: AttemptPhaseDurations
  wall_energy: std.measure.Joule?

  disposition: ReviewDisposition
}

// Throughput is an exact fraction over the SAME FieldOfFractions of std.nat.Nat authority gunbc.econ.acquisition ConversionRate consumes -- output tokens over elapsed nanoseconds -- and nothing divides until a consumer explicitly asks for the floor projection. Storing tokens-per-second as a scalar would bake one rounding into the authority and make a cross-host comparison depend on when the division happened. The floor projection below is a DECLARED lossy view and is total by typed refusal: it returns none on a zero denominator rather than dividing, because the record stays publicly constructible even though every derivation that PRODUCES one refuses a zero window first.
type TokenThroughput = std.algebra.FieldOfFractions<std.nat.Nat>

type ThroughputRefusalCause
  = ThroughputUsageUnobserved
  | DecodeDurationUnobserved
  | ZeroDecodeDuration

type DecodeThroughputResult
  = DecodeThroughputDerived { throughput: TokenThroughput }
  | DecodeThroughputRefused { cause: ThroughputRefusalCause }

fn derive_decode_throughput(receipt: LlmAttemptReceipt) -> DecodeThroughputResult {
  match receipt.usage {
    LlmUsageUnobserved { reason: _ } =>
      DecodeThroughputRefused { cause: ThroughputUsageUnobserved }
    LlmUsageObserved { usage: u } =>
      match receipt.durations.decode {
        none => DecodeThroughputRefused { cause: DecodeDurationUnobserved }
        Present { value: d } =>
          if nanosecond_count(n: d) == 0 {
            DecodeThroughputRefused { cause: ZeroDecodeDuration }
          } else {
            DecodeThroughputDerived {
              throughput: std.algebra.FieldOfFractions {
                num: token_count_value(t: u.output),
                denom: nanosecond_count(n: d),
              }
            }
          }
      }
  }
}

fn nanoseconds_per_second() -> std.nat.Nat {
  1000000000
}

fn throughput_per_second_floor(t: TokenThroughput) -> std.nat.Nat? {
  if t.denom == 0 {
    none
  } else {
    Present { value: (t.num * nanoseconds_per_second()) / t.denom }
  }
}

// Accepted task goodput is the primary quantity, not token throughput: a cheap attempt that produced a rejected finding is not useful work, and a host that doubles its token rate while halving its acceptance rate has bought nothing. So the numerator counts ACCEPTED dispositions only -- escalated and rejected attempts consume the window and contribute zero -- which is exactly what makes this metric fall when a smaller local model is pushed past its envelope. Refuses on an empty roster and on a zero window rather than reporting a goodput of nothing over nothing.
fn attempt_is_accepted(d: ReviewDisposition) -> Bool {
  match d {
    ReviewAccepted => true
    ReviewRejected { reason: _ } => false
    ReviewEscalated { reason: _ } => false
  }
}

fn attempt_is_escalated(d: ReviewDisposition) -> Bool {
  match d {
    ReviewAccepted => false
    ReviewRejected { reason: _ } => false
    ReviewEscalated { reason: _ } => true
  }
}

fn accepted_attempt_count(receipts: List<LlmAttemptReceipt>) -> std.nat.Nat {
  v2.std.algebra.fold_list(
    xs: receipts,
    empty: 0,
    cons: fn(acc, r) { if attempt_is_accepted(d: r.disposition) { acc + 1 } else { acc } }
  )
}

fn escalated_attempt_count(receipts: List<LlmAttemptReceipt>) -> std.nat.Nat {
  v2.std.algebra.fold_list(
    xs: receipts,
    empty: 0,
    cons: fn(acc, r) { if attempt_is_escalated(d: r.disposition) { acc + 1 } else { acc } }
  )
}

fn attempt_roster_count(receipts: List<LlmAttemptReceipt>) -> std.nat.Nat {
  v2.std.algebra.fold_list(xs: receipts, empty: 0, cons: fn(acc, r) { acc + 1 })
}

type GoodputRefusalCause
  = EmptyAttemptRoster
  | ZeroObservationWindow

type AcceptedGoodput = std.algebra.FieldOfFractions<std.nat.Nat>

type AcceptedGoodputResult
  = AcceptedGoodputDerived { goodput: AcceptedGoodput }
  | AcceptedGoodputRefused { cause: GoodputRefusalCause }

fn derive_accepted_goodput(
  receipts: List<LlmAttemptReceipt>,
  window: std.measure.Nanosecond,
) -> AcceptedGoodputResult {
  if attempt_roster_count(receipts: receipts) == 0 {
    AcceptedGoodputRefused { cause: EmptyAttemptRoster }
  } else {
    if nanosecond_count(n: window) == 0 {
      AcceptedGoodputRefused { cause: ZeroObservationWindow }
    } else {
      AcceptedGoodputDerived {
        goodput: std.algebra.FieldOfFractions {
          num: accepted_attempt_count(receipts: receipts),
          denom: nanosecond_count(n: window),
        }
      }
    }
  }
}

data llm_escalation_fraction_note: String = "Frontier escalation fraction is derived over the same roster as an exact fraction, so it joins the substrate identity above: the pair of them is what distinguishes 'the local model got better' from 'the work got easier'. Refuses on an empty roster rather than reporting zero escalations out of zero attempts, which reads as a perfect local tier."

type EscalationFraction = std.algebra.FieldOfFractions<std.nat.Nat>

type EscalationFractionResult
  = EscalationFractionDerived { fraction: EscalationFraction }
  | EscalationFractionRefused { cause: GoodputRefusalCause }

fn derive_escalation_fraction(receipts: List<LlmAttemptReceipt>) -> EscalationFractionResult {
  let total = attempt_roster_count(receipts: receipts)
  if total == 0 {
    EscalationFractionRefused { cause: EmptyAttemptRoster }
  } else {
    EscalationFractionDerived {
      fraction: std.algebra.FieldOfFractions {
        num: escalated_attempt_count(receipts: receipts),
        denom: total,
      }
    }
  }
}

data llm_attempt_receipt_frontier_note: String = "DECLARED FRONTIER -- this slice lands the mechanism and its discriminating evidence, NOT a production consumer. The gunbc.dispatch_selection seam that will carry these receipts today types its observed arm as DispatchUsageObserved of a List of NonEmptyStr, and its only construction site in the tree is dispatch_usage_unobserved, so no real attempt has ever been recorded and there is nothing yet to re-home. Calling that seam typed would be the specification-without-execution trap DESIGN section 5 names. NEXT TRIGGER: provider usage capture on the dispatch path replaces the untyped arm with LlmUsageObservation and persists one receipt per real attempt; the cited token-rate rows and cost-per-accepted-task derivation follow in their own slice, where extdeps.pricing.billing_units gains per-token markers beside its storage markers. This module derives no cost precisely because those rates are not yet cited, and fabricating a rate to make the arithmetic run is what the follow-on exists to prevent."
