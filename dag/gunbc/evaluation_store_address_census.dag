module gunbc.evaluation_store_address_census

import std.types { Bool, List, String, NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration, declaration_ref_eq }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

type ResolvedCallEdge {
  caller_module: NonEmptyStr
  caller_decl: NonEmptyStr
  callee_module: NonEmptyStr
  callee_decl: NonEmptyStr
}

type ResolvedCallEdgeCensus
  = ResolvedCallEdgeCensusRefused { cause: NonEmptyStr }
  | ResolvedCallEdgeCensusObserved { edges: List<ResolvedCallEdge> }

fn workspace_resolved_call_edges(entry: NonEmptyStr) -> ResolvedCallEdgeCensus {
  compile_dag_resolved_call_edges(
    [entry as String],
    ["__WORKSPACE_CHECKOUT__"],
    entry as String
  )
}

fn unique_declaration_refs(xs: List<DeclarationRef>) -> List<DeclarationRef> {
  xs |> fold(
    init: [],
    f: (acc, r) =>
      if acc |> fold(init: false, f: (hit, o) => hit || declaration_ref_eq(a: r, b: o)) {
        acc
      } else {
        concat(acc, [r])
      }
  )
}

fn evaluation_store_address_mutation_census() -> ResolvedCallEdgeCensus {
  workspace_resolved_call_edges(
    entry: "dag/test/fixture/evaluation_store_address_alias/mutation_entry.dag" as NonEmptyStr
  )
}

fn evaluation_store_address_production_census() -> ResolvedCallEdgeCensus {
  compile_dag_importer_resolved_call_edges(
    [
      "std.materialization_provider",
      "std.materialization_object",
      "extdeps.realization.materialization_store_local"
    ],
    ["/test/"]
  )
}

fn bound_callers_of_edges(
  edges: List<ResolvedCallEdge>,
  callee_module: String,
  callee_decl: String
) -> List<DeclarationRef> {
  unique_declaration_refs(xs: edges |> fold(
    init: [],
    f: (acc, edge) =>
      if (edge.callee_module as String) == callee_module
        && (edge.callee_decl as String) == callee_decl {
        concat(acc, [DeclarationRef {
          module_path: edge.caller_module,
          decl_name: edge.caller_decl,
          field: WholeDeclaration
        }])
      } else {
        acc
      }
  ))
}

fn evaluation_store_address_ref_in_module(module_path: String, name: String, xs: List<DeclarationRef>) -> Bool {
  xs |> fold(
    init: false,
    f: (acc, r) => acc || (((r.module_path as String) == module_path) && ((r.decl_name as String) == name))
  )
}
