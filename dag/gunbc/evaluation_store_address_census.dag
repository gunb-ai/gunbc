module gunbc.evaluation_store_address_census

import std.types { Bool, List, String, NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration, declaration_ref_eq }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

type ResolvedCallEdge {
  caller_module: NonEmptyStr
  caller_decl: NonEmptyStr
  callee_module: NonEmptyStr
  callee_decl: NonEmptyStr
}

type ResolvedCallEdgeCensus
  = ResolvedCallEdgeCensusRefused { cause: NonEmptyStr }
  | ResolvedCallEdgeCensusObserved { edges: List<ResolvedCallEdge> }

data evaluation_store_address_home_modules: List<String> = [
  "std.materialization_provider",
  "std.materialization_object",
  "extdeps.realization.materialization_store_local"
]

data evaluation_store_address_production_exclude: List<String> = ["/test/"]

data evaluation_store_address_fixture_home_modules: List<String> = [
  "test.fixture.evaluation_store_address_alias.home"
]

data evaluation_store_address_fixture_roots: List<String> = [
  "dag/test/fixture/evaluation_store_address_alias"
]

data evaluation_store_address_production_leaves: List<String> = [
  "evaluation_store_address",
  "persist_evaluation_store_address",
  "evaluation_store_address_digest"
]

data evaluation_store_address_fixture_leaves: List<String> = [
  "evaluation_store_address"
]

fn evaluation_store_address_mutation_census() -> ResolvedCallEdgeCensus {
  evaluation_store_address_fixture_callsite_census()
}

fn evaluation_store_address_import_only_census() -> ResolvedCallEdgeCensus {
  compile_dag_importer_resolved_call_edges(
    evaluation_store_address_home_modules,
    evaluation_store_address_production_exclude,
    [],
    evaluation_store_address_production_leaves
  )
}

fn evaluation_store_address_production_census() -> ResolvedCallEdgeCensus {
  compile_dag_callsite_resolved_call_edges(
    evaluation_store_address_home_modules,
    evaluation_store_address_production_exclude,
    [],
    evaluation_store_address_production_leaves
  )
}

fn evaluation_store_address_fixture_import_only_census() -> ResolvedCallEdgeCensus {
  compile_dag_importer_resolved_call_edges(
    evaluation_store_address_fixture_home_modules,
    [],
    evaluation_store_address_fixture_roots,
    evaluation_store_address_fixture_leaves
  )
}

fn evaluation_store_address_fixture_callsite_census() -> ResolvedCallEdgeCensus {
  compile_dag_callsite_resolved_call_edges(
    evaluation_store_address_fixture_home_modules,
    [],
    evaluation_store_address_fixture_roots,
    evaluation_store_address_fixture_leaves
  )
}

fn bound_callers_of_edges(
  edges: List<ResolvedCallEdge>,
  callee_module: String,
  callee_decl: String
) -> List<DeclarationRef> {
  edges |> fold(
    init: [],
    f: (acc, edge) =>
      if (edge.callee_module as String) == callee_module
        && (edge.callee_decl as String) == callee_decl {
        concat(acc, [DeclarationRef {
          module_path: edge.caller_module,
          decl_name: edge.caller_decl,
          field: WholeDeclaration
        }])
      } else {
        acc
      }
  )
}

fn evaluation_store_address_ref_in_module(
  module_path: String,
  name: String,
  xs: List<DeclarationRef>
) -> Bool {
  xs |> fold(
    init: false,
    f: (acc, r) =>
      acc || ((r.module_path as String) == module_path && (r.decl_name as String) == name)
  )
}
