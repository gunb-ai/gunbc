module gunbc.evaluation_store_address_census

import std.types { Bool, List, String, NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration, declaration_ref_eq }
import gunbc.materialization_provider_targets { evaluation_store_address_producer }
import tools.multi_module_compile_fixture { FixtureSource, fixture_source }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

type ResolvedCallEdge {
  caller_module: NonEmptyStr
  caller_decl: NonEmptyStr
  callee_module: NonEmptyStr
  callee_decl: NonEmptyStr
}

type ResolvedCallEdgeCensus
  = ResolvedCallEdgeCensusRefused { cause: NonEmptyStr }
  | ResolvedCallEdgeCensusObserved { edges: List<ResolvedCallEdge> }

fn fixture_resolved_call_edges(sources: List<FixtureSource>, entry: NonEmptyStr) -> ResolvedCallEdgeCensus {
  compile_dag_resolved_call_edges(
    sources |> map(s => s.path as String),
    sources |> map(s => s.content),
    entry as String
  )
}

fn unique_declaration_refs(xs: List<DeclarationRef>) -> List<DeclarationRef> {
  xs |> fold(
    init: [],
    f: (acc, r) =>
      if acc |> fold(init: false, f: (hit, o) => hit || declaration_ref_eq(a: r, b: o)) {
        acc
      } else {
        concat(acc, [r])
      }
  )
}

fn census_edges(census: ResolvedCallEdgeCensus) -> List<ResolvedCallEdge> {
  match census {
    ResolvedCallEdgeCensusRefused { cause: _ } => []
    ResolvedCallEdgeCensusObserved { edges } => edges
  }
}

fn evaluation_store_address_mutation_edges() -> List<ResolvedCallEdge> {
  census_edges(census: fixture_resolved_call_edges(
    sources: [
      fixture_source("esa_alias/home.dag", "module test.fixture.evaluation_store_address_alias.home\n\nfn evaluation_store_address() -> Int {\n  0\n}\n\nfn home_marker() -> Int {\n  1\n}\n"),
      fixture_source("esa_alias/decoy.dag", "module test.fixture.evaluation_store_address_alias.decoy\n\nfn evaluation_store_address() -> Bool {\n  true\n}\n\nfn decoy_caller() -> Bool {\n  evaluation_store_address()\n}\n"),
      fixture_source("esa_alias/aliased.dag", "module test.fixture.evaluation_store_address_alias.aliased\n\nimport test.fixture.evaluation_store_address_alias.home { evaluation_store_address }\n\nfn aliased_call() -> Int {\n  evaluation_store_address()\n}\n"),
      fixture_source("esa_alias/same_leaf.dag", "module test.fixture.evaluation_store_address_alias.same_leaf\n\nimport test.fixture.evaluation_store_address_alias.home { home_marker }\nimport test.fixture.evaluation_store_address_alias.decoy { evaluation_store_address }\n\nfn same_leaf_imported_call() -> Bool {\n  evaluation_store_address()\n}\n\nfn same_leaf_home_marker_use() -> Int {\n  home_marker()\n}\n"),
      fixture_source("esa_alias/qualified.dag", "module test.fixture.evaluation_store_address_alias.qualified\n\nfn qualified_call() -> Int {\n  test.fixture.evaluation_store_address_alias.home.evaluation_store_address()\n}\n"),
      fixture_source("esa_alias/mutation_entry.dag", "module test.fixture.evaluation_store_address_alias.mutation_entry\n\nimport test.fixture.evaluation_store_address_alias.aliased { aliased_call }\nimport test.fixture.evaluation_store_address_alias.same_leaf { same_leaf_imported_call }\nimport test.fixture.evaluation_store_address_alias.qualified { qualified_call }\n\nfn mutation_touch() -> Int {\n  aliased_call() + qualified_call()\n}\n\nfn mutation_touch_decoy() -> Bool {\n  same_leaf_imported_call()\n}\n")
    ],
    entry: "esa_alias/mutation_entry.dag" as NonEmptyStr
  ))
}

fn bound_callers_of_edges(
  edges: List<ResolvedCallEdge>,
  callee_module: String,
  callee_decl: String
) -> List<DeclarationRef> {
  unique_declaration_refs(xs: edges |> fold(
    init: [],
    f: (acc, edge) =>
      if (edge.callee_module as String) == callee_module
        && (edge.callee_decl as String) == callee_decl {
        concat(acc, [DeclarationRef {
          module_path: edge.caller_module,
          decl_name: edge.caller_decl,
          field: WholeDeclaration
        }])
      } else {
        acc
      }
  ))
}

fn evaluation_store_address_alias_mutation_callers() -> List<DeclarationRef> {
  bound_callers_of_edges(
    edges: evaluation_store_address_mutation_edges(),
    callee_module: "test.fixture.evaluation_store_address_alias.home",
    callee_decl: "evaluation_store_address"
  )
}

fn evaluation_store_address_same_leaf_decoy_callers() -> List<DeclarationRef> {
  bound_callers_of_edges(
    edges: evaluation_store_address_mutation_edges(),
    callee_module: "test.fixture.evaluation_store_address_alias.decoy",
    callee_decl: "evaluation_store_address"
  )
}

fn evaluation_store_address_ref_in_module(module_path: String, name: String, xs: List<DeclarationRef>) -> Bool {
  xs |> fold(
    init: false,
    f: (acc, r) => acc || (((r.module_path as String) == module_path) && ((r.decl_name as String) == name))
  )
}
