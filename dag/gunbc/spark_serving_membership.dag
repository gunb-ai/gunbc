module gunbc.spark_serving_membership

import std.types { String, Bool, List, NonEmptyStr, FilePath, Int }
import std.content_hash { content_hash_atom, serialize_content_hash }
import product.placement_supply { HostIdentity }
import gunbc.ownership { Ownership, Owned, Ensured }
import gunbc.spark_serving_release {
  SparkServingOccurrence,
  SparkServingRelease,
}
import gunbc.membership_reconcile {
  MembershipPlan,
  membership_reconcile,
  membership_plan_admitting_outcome,
  membership_write_count,
  membership_removal_count,
  membership_refusal_count,
  membership_effects,
  EffectsOrRefusal,
}
import gunbc.spark_serving_install_paths {
  SparkServingUserUnitSpec,
  spark_serving_user_unit_path,
  spark_serving_user_unit_spec,
  spark_serving_user_unit_spec_structural_hash,
}
import gunbc.spark_serving_desired {
  spark_serving_desired_bind_host_port,
  spark_serving_automation_principal_login,
}
import gunbc.spark_serving_unit_identity { spark_serving_unit_name }
import gunbc.spark_serving_unit_render { spark_serving_desired_user_unit_content_identity }

data spark_serving_membership_authority_note: String = "Member-grain membership reconcile for Spark serving install. key_of is host × principal × resource address — stable identity for the managed resource, never release/model/unit content. state_digest is the value at that address (runtime closure, model manifest, unit spec, linger). Ollama upgrade or model drift is MemberChanged on the same address, never Remove+Add. Ensured linger converges on drift; non-owned removal refuses with no effect arm (R5)."

data spark_serving_primary_model_slot: NonEmptyStr = "primary" as NonEmptyStr

// ENABLEMENT IS ITS OWN RESOURCE, NOT A PREFIX ON THE CONTENT DIGEST.
//
// The unit member carried ONE digest and enablement was folded into it by prefixing the bytes --
// `join(["disabled:", read_stdout])`. That is a product (content x enablement) collapsed into a
// scalar, and the collapse produced a wrong REMEDY, not merely an imprecise report: byte-perfect
// content that happened to be disabled hashed differently, read as content drift, and selected
// WriteUserUnitFile plus a manager reload -- rewriting a correct file in order to enable it.
//
// Two addresses, because they are two resources with two remediations. Content drift writes the
// file; enablement drift enables the unit; and a host needing only the second no longer pays for
// the first. The minimal effect set falls out of modeling the subjects separately rather than being
// computed by a rule on top of a fused value.
type SparkServingResourceAddress
  = SparkServingRuntimeRootAddress
  | SparkServingUserUnitAddress
  | SparkServingUserUnitRegistrationAddress
  | SparkServingUserUnitEnablementAddress
  | SparkServingUserUnitActivityAddress
  | SparkServingModelSlotAddress { slot: NonEmptyStr }
  | SparkServingLingerAddress

type SparkServingMemberAt = String

type SparkServingMember {
  host: HostIdentity
  principal: NonEmptyStr
  address: SparkServingResourceAddress
  state_digest: NonEmptyStr
  ownership: Ownership
}

type SparkServingUserUnitWriteIntent {
  path: FilePath
  spec: SparkServingUserUnitSpec
}

fn spark_serving_resource_address_wire(address: SparkServingResourceAddress) -> String {
  match address {
    SparkServingRuntimeRootAddress => "runtime-root"
    SparkServingUserUnitAddress =>
      join(["user-unit:", spark_serving_unit_name], "")
    SparkServingUserUnitRegistrationAddress =>
      join(["user-unit-registration:", spark_serving_unit_name], "")
    SparkServingUserUnitEnablementAddress =>
      join(["user-unit-enablement:", spark_serving_unit_name], "")
    SparkServingUserUnitActivityAddress =>
      join(["user-unit-activity:", spark_serving_unit_name], "")
    SparkServingModelSlotAddress { slot: slot } =>
      join(["model-slot:", slot as String], "")
    SparkServingLingerAddress => "linger"
  }
}

fn spark_serving_member_key(member: SparkServingMember) -> String {
  join([
    member.host as String,
    "|",
    member.principal as String,
    "|",
    spark_serving_resource_address_wire(address: member.address),
  ], "")
}

fn spark_serving_member_key_eq(a: String, b: String) -> Bool {
  a == b
}

fn spark_serving_member_value_eq(a: SparkServingMember, b: SparkServingMember) -> Bool {
  a.state_digest == b.state_digest
}

fn spark_serving_member_ownership(member: SparkServingMember) -> Ownership? {
  Present { value: member.ownership }
}

fn spark_serving_serving_principal() -> NonEmptyStr {
  spark_serving_automation_principal_login()
}

// The desired unit member's state is the identity of the bytes that will be WRITTEN, taken through
// the same function the observation takes over the bytes it READS. Hashing the typed spec instead
// would put the two sides in different identity domains, so a converged host could never match.
fn spark_serving_user_unit_state_digest() -> NonEmptyStr {
  spark_serving_desired_user_unit_content_identity()
}

// The DESIRED enablement is a constant, because the model declares the unit must survive a reboot.
// It is a member value rather than a Bool on the unit member so that reconcile answers the question
// -- an enablement mismatch is a MemberChanged at this address, selecting only the enable effect.
data spark_serving_user_unit_enabled_state: NonEmptyStr = "user-unit-enabled" as NonEmptyStr

// ENABLEMENT IS PERSISTENCE; ACTIVITY IS WHETHER IT IS RUNNING NOW. Two facts, and the reason they
// are two members rather than one is that they have different remedies and either can hold without
// the other. `systemctl --user enable` makes a unit start at boot and starts nothing; a unit can be
// enabled and dead, and it can be running while disabled -- which serves today and vanishes at the
// next reboot.
//
// WHY THIS WAS NOT A MEMBER UNTIL NOW, stated because the gap was real and was found by reasoning
// about the verdict rather than by a failure. The install used `enable --now`, which fuses the two,
// so the enabled member reconciling as converged USUALLY implied a running unit. Usually is not a
// guarantee: a unit that died after being enabled -- a crash, an OOM kill, a manual stop -- left
// every resource member converged with nothing serving, and the only thing that noticed was the
// terminal health probe at the very end. That is detection by symptom. The membership diff already
// knew the unit was dead; it had no address at which to say so, so it said nothing and let the
// convergence verdict rest on a generation probe catching it.
//
// With activity as its own member, an enabled-but-dead unit is a MemberChanged at THIS address and
// selects a start -- a plan, not a postmortem.
data spark_serving_user_unit_active_state: NonEmptyStr = "user-unit-active" as NonEmptyStr

data spark_serving_user_unit_stopped_state: NonEmptyStr = "user-unit-stopped" as NonEmptyStr

data spark_serving_user_unit_disabled_state: NonEmptyStr = "user-unit-disabled" as NonEmptyStr

data spark_serving_user_unit_not_registered_state: NonEmptyStr = "user-unit-not-registered" as NonEmptyStr

// REGISTRATION IS A SEPARATE SUBJECT FROM ENABLEMENT, AND ITS STATE IS THE DEFINITION THE MANAGER
// HOLDS -- NOT A BOOLEAN.
//
// systemd answers is-enabled with not-found when no unit is registered at all. That is a fact about
// REGISTRATION, not a value of enablement: enablement is only meaningful over a unit the manager
// knows about, so not-found is the absence of the subject enablement would be about. Modelling it as
// an enablement value conflated two states whose remedies differ -- a registered-but-disabled unit
// needs enable, an unregistered one needs write then reload then enable -- and let the enablement
// member reconcile as a CHANGE to something that did not exist.
//
// A bare registered marker would be just as wrong one level down. Writing new bytes does not change
// what the manager already loaded, so a unit that is registered against a STALE definition is not
// converged, and a state that says only registered cannot tell the two apart. The state therefore
// names the content the manager has consumed.
//
// THE IDENTITY IS TAKEN OVER OBSERVATIONS ONLY. It would be easy to define freshness as observed
// bytes equal desired bytes, and that is the error this module already records one comment up: an
// earlier revision returned the DESIRED digest when bytes matched, so the observed side imported the
// answer it was supposed to establish. Instead the observed registration names the digest actually
// on disk and the desired registration names the desired digest, so equality FALLS OUT of the same
// comparison every other member uses, and the two sides stay in one identity domain.
fn spark_serving_user_unit_registration_state(content_digest: NonEmptyStr) -> NonEmptyStr {
  concat("user-unit-registered:", content_digest as String) as NonEmptyStr
}

// A unit the manager knows about while its file is gone is a real, observable, and wrong state. It
// is not absence (the manager holds a definition) and not staleness against known bytes (there are
// none), so it gets its own value rather than being folded into either.
data spark_serving_user_unit_registered_without_content_state: NonEmptyStr = "user-unit-registered-without-content" as NonEmptyStr

fn spark_serving_desired_user_unit_registration_state_digest() -> NonEmptyStr {
  spark_serving_user_unit_registration_state(
    content_digest: spark_serving_desired_user_unit_content_identity(),
  )
}

fn spark_serving_user_unit_enabled_state_digest() -> NonEmptyStr {
  spark_serving_user_unit_enabled_state
}

fn spark_serving_user_unit_active_state_digest() -> NonEmptyStr {
  spark_serving_user_unit_active_state
}

type ExecutorLingerEnabled {}

type ExecutorLingerDisabled {}

type SparkServingExecutorLingerState
  = ExecutorLingerEnabled {}
  | ExecutorLingerDisabled {}

fn spark_serving_executor_linger_state_label(state: SparkServingExecutorLingerState) -> NonEmptyStr {
  match state {
    ExecutorLingerEnabled {} => "enabled" as NonEmptyStr
    ExecutorLingerDisabled {} => "disabled" as NonEmptyStr
  }
}

fn spark_serving_executor_linger_state_digest_for(state: SparkServingExecutorLingerState) -> NonEmptyStr {
  content_hash_atom(
    value: spark_serving_executor_linger_state_label(state: state),
  ).digest as NonEmptyStr
}

fn spark_serving_desired_executor_linger_state() -> SparkServingExecutorLingerState {
  ExecutorLingerEnabled {}
}

fn spark_serving_observed_executor_linger_disabled_state() -> SparkServingExecutorLingerState {
  ExecutorLingerDisabled {}
}

fn spark_serving_executor_linger_state_digest() -> NonEmptyStr {
  spark_serving_executor_linger_state_digest_for(
    state: spark_serving_desired_executor_linger_state(),
  )
}

fn spark_serving_executor_linger_disabled_state_digest() -> NonEmptyStr {
  spark_serving_executor_linger_state_digest_for(
    state: spark_serving_observed_executor_linger_disabled_state(),
  )
}

fn spark_serving_user_unit_file_write_intent() -> SparkServingUserUnitWriteIntent {
  SparkServingUserUnitWriteIntent {
    path: spark_serving_user_unit_path(),
    spec: spark_serving_user_unit_spec(
      bind_host_port: spark_serving_desired_bind_host_port() as NonEmptyStr,
    ),
  }
}

fn spark_serving_member(
  host: HostIdentity,
  principal: NonEmptyStr,
  address: SparkServingResourceAddress,
  state_digest: NonEmptyStr,
  ownership: Ownership,
) -> SparkServingMember {
  SparkServingMember {
    host: host,
    principal: principal,
    address: address,
    state_digest: state_digest,
    ownership: ownership,
  }
}

fn spark_serving_desired_members(
  occurrence: SparkServingOccurrence,
  serving_release: SparkServingRelease,
) -> List<SparkServingMember> {
  let host = occurrence.host
  let principal = spark_serving_serving_principal()
  let closure_digest = serving_release.runtime.closure_digest
  let model_digest = serialize_content_hash(hash: serving_release.model.identity) as NonEmptyStr
  [
    spark_serving_member(
      host: host,
      principal: principal,
      address: SparkServingRuntimeRootAddress,
      state_digest: closure_digest,
      ownership: Owned,
    ),
    spark_serving_member(
      host: host,
      principal: principal,
      address: SparkServingUserUnitAddress,
      state_digest: spark_serving_user_unit_state_digest(),
      ownership: Owned,
    ),
    spark_serving_member(
      host: host,
      principal: principal,
      address: SparkServingUserUnitRegistrationAddress,
      state_digest: spark_serving_desired_user_unit_registration_state_digest(),
      ownership: Owned,
    ),
    spark_serving_member(
      host: host,
      principal: principal,
      address: SparkServingUserUnitEnablementAddress,
      state_digest: spark_serving_user_unit_enabled_state_digest(),
      ownership: Owned,
    ),
    spark_serving_member(
      host: host,
      principal: principal,
      address: SparkServingUserUnitActivityAddress,
      state_digest: spark_serving_user_unit_active_state_digest(),
      ownership: Owned,
    ),
    spark_serving_member(
      host: host,
      principal: principal,
      address: SparkServingModelSlotAddress { slot: spark_serving_primary_model_slot },
      state_digest: model_digest,
      ownership: Owned,
    ),
    spark_serving_member(
      host: host,
      principal: principal,
      address: SparkServingLingerAddress,
      state_digest: spark_serving_executor_linger_state_digest(),
      ownership: Ensured,
    ),
  ]
}

fn spark_serving_membership_reconcile(
  desired: List<SparkServingMember>,
  observed: List<SparkServingMember>,
) -> MembershipPlan<SparkServingMember, SparkServingMemberAt> {
  membership_plan_admitting_outcome(
    outcome: membership_reconcile(
      desired: desired,
      observed: observed,
      key_of: spark_serving_member_key,
      key_eq: spark_serving_member_key_eq,
      value_eq: spark_serving_member_value_eq,
      ownership_of: spark_serving_member_ownership,
    ),
  )
}

fn spark_serving_membership_effects(
  plan: MembershipPlan<SparkServingMember, SparkServingMemberAt>,
) -> EffectsOrRefusal<SparkServingMember> {
  membership_effects(plan: plan)
}

fn spark_serving_membership_noop(plan: MembershipPlan<SparkServingMember, SparkServingMemberAt>) -> Bool {
  membership_write_count(plan: plan) == 0
    && membership_removal_count(plan: plan) == 0
    && membership_refusal_count(plan: plan) == 0
}
