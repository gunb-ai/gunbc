module gunbc.spark_serving_membership


data spark_serving_membership_authority_note: String = "Member-grain membership reconcile for Spark serving install. key_of is host × principal × resource address — stable identity for the managed resource, never release/model/unit content. state_digest is the value at that address (runtime closure, model manifest, unit spec, linger). Ollama upgrade or model drift is MemberChanged on the same address, never Remove+Add. Ensured linger converges on drift; non-owned removal refuses with no effect arm (R5)."

data spark_serving_primary_model_slot: std.types.NonEmptyStr = "primary" as std.types.NonEmptyStr

type SparkServingResourceAddress
  = SparkServingRuntimeRootAddress
  | SparkServingUserUnitAddress
  | SparkServingModelSlotAddress { slot: std.types.NonEmptyStr }
  | SparkServingLingerAddress

type SparkServingMemberAt = String

type SparkServingMember {
  host: product.placement_supply.HostIdentity
  principal: std.types.NonEmptyStr
  address: SparkServingResourceAddress
  state_digest: std.types.NonEmptyStr
  ownership: gunbc.ownership.Ownership
}

type SparkServingUserUnitWriteIntent {
  path: std.types.FilePath
  spec: gunbc.spark_serving_install_paths.SparkServingUserUnitSpec
}

fn spark_serving_resource_address_wire(address: SparkServingResourceAddress) -> String {
  match address {
    SparkServingRuntimeRootAddress => "runtime-root"
    SparkServingUserUnitAddress =>
      join(["user-unit:", gunbc.spark_serving_unit_identity.spark_serving_unit_name], "")
    SparkServingModelSlotAddress { slot: slot } =>
      join(["model-slot:", slot as String], "")
    SparkServingLingerAddress => "linger"
  }
}

fn spark_serving_member_key(member: SparkServingMember) -> String {
  join([
    member.host as String,
    "|",
    member.principal as String,
    "|",
    spark_serving_resource_address_wire(address: member.address),
  ], "")
}

fn spark_serving_member_key_eq(a: String, b: String) -> Bool {
  a == b
}

fn spark_serving_member_value_eq(a: SparkServingMember, b: SparkServingMember) -> Bool {
  a.state_digest == b.state_digest
}

fn spark_serving_member_ownership(member: SparkServingMember) -> gunbc.ownership.Ownership? {
  Present { value: member.ownership }
}

fn spark_serving_serving_principal() -> std.types.NonEmptyStr {
  gunbc.spark_serving_desired.spark_serving_automation_principal_login()
}

fn spark_serving_user_unit_state_digest() -> std.types.NonEmptyStr {
  gunbc.spark_serving_install_paths.spark_serving_user_unit_spec_structural_hash(
    spec: gunbc.spark_serving_install_paths.spark_serving_user_unit_spec(
      bind_host_port: gunbc.spark_serving_desired.spark_serving_desired_bind_host_port() as std.types.NonEmptyStr,
    ),
  ).digest as std.types.NonEmptyStr
}

type ExecutorLingerEnabled {}

type ExecutorLingerDisabled {}

type SparkServingExecutorLingerState
  = ExecutorLingerEnabled {}
  | ExecutorLingerDisabled {}

fn spark_serving_executor_linger_state_label(state: SparkServingExecutorLingerState) -> std.types.NonEmptyStr {
  match state {
    ExecutorLingerEnabled {} => "enabled" as std.types.NonEmptyStr
    ExecutorLingerDisabled {} => "disabled" as std.types.NonEmptyStr
  }
}

fn spark_serving_executor_linger_state_digest_for(state: SparkServingExecutorLingerState) -> std.types.NonEmptyStr {
  std.content_hash.content_hash_atom(
    value: spark_serving_executor_linger_state_label(state: state),
  ).digest as std.types.NonEmptyStr
}

fn spark_serving_desired_executor_linger_state() -> SparkServingExecutorLingerState {
  ExecutorLingerEnabled {}
}

fn spark_serving_observed_executor_linger_disabled_state() -> SparkServingExecutorLingerState {
  ExecutorLingerDisabled {}
}

fn spark_serving_executor_linger_state_digest() -> std.types.NonEmptyStr {
  spark_serving_executor_linger_state_digest_for(
    state: spark_serving_desired_executor_linger_state(),
  )
}

fn spark_serving_executor_linger_disabled_state_digest() -> std.types.NonEmptyStr {
  spark_serving_executor_linger_state_digest_for(
    state: spark_serving_observed_executor_linger_disabled_state(),
  )
}

fn spark_serving_user_unit_file_write_intent() -> SparkServingUserUnitWriteIntent {
  SparkServingUserUnitWriteIntent {
    path: gunbc.spark_serving_install_paths.spark_serving_user_unit_path(),
    spec: gunbc.spark_serving_install_paths.spark_serving_user_unit_spec(
      bind_host_port: gunbc.spark_serving_desired.spark_serving_desired_bind_host_port() as std.types.NonEmptyStr,
    ),
  }
}

fn spark_serving_member(
  host: product.placement_supply.HostIdentity,
  principal: std.types.NonEmptyStr,
  address: SparkServingResourceAddress,
  state_digest: std.types.NonEmptyStr,
  ownership: gunbc.ownership.Ownership,
) -> SparkServingMember {
  SparkServingMember {
    host: host,
    principal: principal,
    address: address,
    state_digest: state_digest,
    ownership: ownership,
  }
}

fn spark_serving_desired_members(
  occurrence: gunbc.spark_serving_release.SparkServingOccurrence,
  serving_release: gunbc.spark_serving_release.SparkServingRelease,
) -> List<SparkServingMember> {
  let host = occurrence.host
  let principal = spark_serving_serving_principal()
  let closure_digest = serving_release.runtime.closure_digest
  let model_digest = std.content_hash.serialize_content_hash(hash: serving_release.model.identity) as std.types.NonEmptyStr
  [
    spark_serving_member(
      host: host,
      principal: principal,
      address: SparkServingRuntimeRootAddress,
      state_digest: closure_digest,
      ownership: gunbc.ownership.Owned,
    ),
    spark_serving_member(
      host: host,
      principal: principal,
      address: SparkServingUserUnitAddress,
      state_digest: spark_serving_user_unit_state_digest(),
      ownership: gunbc.ownership.Owned,
    ),
    spark_serving_member(
      host: host,
      principal: principal,
      address: SparkServingModelSlotAddress { slot: spark_serving_primary_model_slot },
      state_digest: model_digest,
      ownership: gunbc.ownership.Owned,
    ),
    spark_serving_member(
      host: host,
      principal: principal,
      address: SparkServingLingerAddress,
      state_digest: spark_serving_executor_linger_state_digest(),
      ownership: gunbc.ownership.Ensured,
    ),
  ]
}

fn spark_serving_membership_reconcile(
  desired: List<SparkServingMember>,
  observed: List<SparkServingMember>,
) -> gunbc.membership_reconcile.MembershipPlan<SparkServingMember, SparkServingMemberAt> {
  gunbc.membership_reconcile.membership_plan_admitting_outcome(
    outcome: gunbc.membership_reconcile.membership_reconcile(
      desired: desired,
      observed: observed,
      key_of: spark_serving_member_key,
      key_eq: spark_serving_member_key_eq,
      value_eq: spark_serving_member_value_eq,
      ownership_of: spark_serving_member_ownership,
    ),
  )
}

fn spark_serving_membership_effects(
  plan: gunbc.membership_reconcile.MembershipPlan<SparkServingMember, SparkServingMemberAt>,
) -> gunbc.membership_reconcile.EffectsOrRefusal<SparkServingMember> {
  gunbc.membership_reconcile.membership_effects(plan: plan)
}

fn spark_serving_membership_noop(plan: gunbc.membership_reconcile.MembershipPlan<SparkServingMember, SparkServingMemberAt>) -> Bool {
  gunbc.membership_reconcile.membership_write_count(plan: plan) == 0
    && gunbc.membership_reconcile.membership_removal_count(plan: plan) == 0
    && gunbc.membership_reconcile.membership_refusal_count(plan: plan) == 0
}
