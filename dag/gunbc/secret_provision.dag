module gunbc.secret_provision

import std.types { NonEmptyStr, String, Bool }
import std.measure { CharacterCount, character_count, character_count_value }
import std.upsert_decision {
  ObservationVerdict,
  UpsertClassification,
  UpsertDecision,
  Converged,
  Absent,
  Apply,
}
import std.human_intervention {
  HumanIntervention,
  HumanInterventionIdentity,
  HumanInterventionFrequency,
  ProvisioningHumanBurden,
  FleetOnce,
  NoDischargeSiteModeled,
  human_intervention_count_at,
}
import extdeps.cloud.gcp.secret_ref { SecretRef, HashPending, secret_ref_hash_known }
import gunbc.fleet_secrets_config { fleet_secrets_gcp_project }
import gunbc.auth.access_token_source {
  AccessEnsurePlan,
  AccessTokenResolution,
  AccessTokenUpsertRequired,
  AccessTokenEnsureRefused,
  GoogleCloudInteractiveAuthenticationRequired,
}

// SECRET-PROVISION-0 (2026-08-07). Workflow-driven, idempotent GCP Secret Manager
// materialization. Model-only: nothing in this module executes, observes, or touches
// Secret Manager; it names the workflow that replaces the hand-run REST sequences in
// bmc_onboard and bmc_bootstrap_provision with a typed intent → observation → receipt
// fold. Payload bytes are GENERATED at materialization time and never authored in
// source; the only thing the model carries is an opaque SecretRef identity.

type GeneratedPayloadSpec {
  password_length: CharacterCount
}

type SecretProvisionIntent {
  identity: SecretRef
  payload: GeneratedPayloadSpec
}

type SecretExistenceObservation
  = SecretResourceAbsent
  | SecretResourcePresent { resource_name: String }

type SecretMaterializationPlan
  = CreateSecretThenAddVersion
  | AddVersionToExistingSecret

type SecretMaterializationAction
  = SecretCreatedAndVersioned { version_resource: String }
  | VersionMaterialized { version_resource: String }

type SecretProvisionReceipt {
  identity: SecretRef
  action: SecretMaterializationAction
  payload_password_length: CharacterCount
}

type SecretProvisionRefusalCause
  = SecretProvisionAccessRefused { reason: NonEmptyStr }
  | DurabilityReadBackMismatch { version_resource: String }
  | PayloadGenerationFailed

type SecretProvisionProgress
  = ProgressMaterialized { receipt: SecretProvisionReceipt }
  | ProgressAwaitingHuman { intervention: HumanIntervention }
  | ProgressRefused { cause: SecretProvisionRefusalCause }

type SecretProvisionOutcome
  = SecretProvisioned { receipt: SecretProvisionReceipt }
  | SecretProvisionHumanInterventionRequired { intervention: HumanIntervention }
  | SecretProvisionRefused { cause: SecretProvisionRefusalCause }

data secret_provision_payload_generation_note: String = "Generated payloads use extdeps.entropy.Urandom.ReadPassword at realization time. The intent carries only GeneratedPayloadSpec.password_length (std.measure.CharacterCount) — never the secret value. bmc_onboard's mint_bmc_credential is the live specimen this workflow supersedes; its parallel bmc_credential_length_chars: Int scaffold dissolves when this carrier is wired."

fn fleet_secret_ref(secret_id: NonEmptyStr) -> SecretRef {
  SecretRef {
    project: fleet_secrets_gcp_project,
    secret: secret_id,
    version: "latest",
    hash_state: HashPending,
  }
}

fn secret_provision_intervention(
  identity: NonEmptyStr,
  frequency: HumanInterventionFrequency,
  subject: NonEmptyStr,
  instruction: NonEmptyStr,
) -> HumanIntervention {
  HumanIntervention {
    identity: identity as HumanInterventionIdentity,
    frequency: frequency,
    subject: subject,
    instruction: instruction,
    completion_evidence: NoDischargeSiteModeled,
  }
}

data gcp_fleet_secrets_access_token_intervention_identity: NonEmptyStr = "gcp-fleet-secrets-access-token"

fn gcp_fleet_secrets_access_token_intervention() -> HumanIntervention {
  secret_provision_intervention(
    identity: gcp_fleet_secrets_access_token_intervention_identity,
    frequency: FleetOnce,
    subject: "fleet secrets project GCP credentials",
    instruction: "Authenticate to Google Cloud with access to the fleet secrets project. Paid once for the fleet until workload-identity federation supersedes interactive gcloud auth."
  )
}

fn secret_provision_human_burden() -> ProvisioningHumanBurden {
  ProvisioningHumanBurden {
    interventions: [gcp_fleet_secrets_access_token_intervention()],
  }
}

fn human_intervention_for_access_upsert(plan: AccessEnsurePlan) -> HumanIntervention {
  match plan {
    GoogleCloudInteractiveAuthenticationRequired {} => gcp_fleet_secrets_access_token_intervention()
  }
}

fn classify_secret_existence(obs: SecretExistenceObservation) -> ObservationVerdict {
  match obs {
    SecretResourceAbsent => Absent
    SecretResourcePresent { resource_name: _ } => Converged
  }
}

fn decision_for_secret_materialization(
  obs: SecretExistenceObservation,
) -> UpsertDecision<SecretMaterializationPlan> {
  match obs {
    SecretResourceAbsent => Apply { plan: CreateSecretThenAddVersion }
    SecretResourcePresent { resource_name: _ } => Apply { plan: AddVersionToExistingSecret }
  }
}

fn classify_secret_materialization_upsert(
  obs: SecretExistenceObservation,
) -> UpsertClassification<SecretMaterializationPlan> {
  UpsertClassification {
    verdict: classify_secret_existence(obs: obs),
    decision: decision_for_secret_materialization(obs: obs),
  }
}

fn classify_access_token_resolution(resolution: AccessTokenResolution) -> SecretProvisionProgress {
  match resolution {
    AccessTokenUpsertRequired { plan: plan } =>
      ProgressAwaitingHuman { intervention: human_intervention_for_access_upsert(plan: plan) }
    AccessTokenEnsureRefused { reason: reason } =>
      ProgressRefused { cause: SecretProvisionAccessRefused { reason: reason } }
    AccessTokenReady { token: _ } =>
      ProgressRefused {
        cause: SecretProvisionAccessRefused {
          reason: "classify_access_token_resolution is for pre-token deficit only" as NonEmptyStr,
        },
      }
  }
}

fn classify_secret_provision_progress(
  progress: SecretProvisionProgress,
) -> SecretProvisionOutcome {
  match progress {
    ProgressMaterialized { receipt: receipt } => SecretProvisioned { receipt: receipt }
    ProgressAwaitingHuman { intervention: intervention } =>
      SecretProvisionHumanInterventionRequired { intervention: intervention }
    ProgressRefused { cause: cause } => SecretProvisionRefused { cause: cause }
  }
}

fn secret_provision_receipt(
  intent: SecretProvisionIntent,
  plan: SecretMaterializationPlan,
  version_resource: String,
) -> SecretProvisionReceipt {
  match plan {
    CreateSecretThenAddVersion =>
      SecretProvisionReceipt {
        identity: intent.identity,
        action: SecretCreatedAndVersioned { version_resource: version_resource },
        payload_password_length: intent.payload.password_length,
      }
    AddVersionToExistingSecret =>
      SecretProvisionReceipt {
        identity: intent.identity,
        action: VersionMaterialized { version_resource: version_resource },
        payload_password_length: intent.payload.password_length,
      }
  }
}

fn secret_provision_intent(
  secret_id: NonEmptyStr,
  payload_password_length: CharacterCount,
) -> SecretProvisionIntent {
  SecretProvisionIntent {
    identity: fleet_secret_ref(secret_id: secret_id),
    payload: GeneratedPayloadSpec { password_length: payload_password_length },
  }
}

fn intent_identity_is_opaque(intent: SecretProvisionIntent) -> Bool {
  !secret_ref_hash_known(ref: intent.identity)
}

fn generated_payload_password_char_count(spec: GeneratedPayloadSpec) -> Nat {
  character_count_value(c: spec.password_length)
}
