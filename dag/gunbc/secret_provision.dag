module gunbc.secret_provision

import extdeps.cloud.gcp.secret_manager {
  SmResolvedVersionIdentity, SmVersionIdProjection, SmVersionIdProjected,
  SmVersionIdNotAVersionResource, sm_resolved_version_id,
  SmVersionSecretProjection, SmVersionSecretProjected, SmVersionSecretNotAVersionResource,
  sm_resolved_version_secret_resource,
}
import std.types { NonEmptyStr, String, Bool }
import std.nat { Nat }
import std.measure { CharacterCount, character_count, character_count_value }
import std.content_hash {
  ContentHash,
  ContentHashComparison,
  ContentHashEqual,
  ContentHashDifferent,
  ContentHashCrossFamilyIncomparable,
  compare_content_hash,
  Sha256Digest,
  as_content_hash_cryptographic,
}
import std.upsert_decision {
  ObservationVerdict,
  UpsertClassification,
  UpsertDecision,
  Converged,
  Absent,
  Drifted,
  Conflict,
  Inaccessible,
  UnknownRefused,
  Apply,
  Noop,
  Refuse,
}
import std.human_intervention {
  HumanIntervention,
  HumanInterventionIdentity,
  HumanInterventionFrequency,
  ProvisioningHumanBurden,
  FleetOnce,
  NoDischargeSiteModeled,
  human_intervention_count_at,
}
import extdeps.cloud.gcp.secret_ref { SecretRef, HashPending, secret_ref_secret_resource }
import gunbc.fleet_secrets_config { fleet_secrets_gcp_project }

// SECRET-PROVISION-0 (model-only). Materialization is keyed by secret-container observation ×
// provisioning-attempt identity × payload identity × prior exact-version receipt — not container
// presence alone. gcp.SecretManager.AddVersion is NOT idempotent: every successful call mints a
// new SecretVersion. Retry after materialization must recover the exact version_resource from the
// durable receipt, read THAT version (never latest), verify payload identity, and classify Noop;
// only the absence of a prior materialization for this attempt authorizes AddVersion.
// Authorization is GitHub OIDC → WIF → fleet-automation@; the FleetOnce human burden is
// establishing the WIF binding, not supplying access tokens.
type SecretProvisionAttemptIdentity = NonEmptyStr where brand("SecretProvisionAttemptIdentity")

type OperatorCapturedInBoxCredential {}

type WorkflowGeneratedCredential {
  password_length: CharacterCount
}

// A CREDENTIAL THIS REPOSITORY OBSERVED IS NOT A CREDENTIAL IT CHOSE, AND THE TWO MAY NOT SHARE AN
// ARM. Both existing arms are Spark secrets whose bytes this system either generated or captured
// from a device it was commissioning. A printer LAN access code is neither: the printer issued it,
// the operator holds it, and we only ever read it. Filing one under SparkAdministratorCredential
// would make payload_identity_from_credential answer GeneratedPayloadIdentity { password_length },
// which asserts we chose the bytes and knows only how MANY there are -- so two different codes of
// equal length would compare as the same payload, and the read-back verification that is the whole
// point of provisioning would pass on the wrong secret.
//
// The observed arm therefore carries a ContentHash and resolves to ObservedPayloadIdentity, which
// compare_payload_identities answers Differs against a generated one -- NOT Incomparable. That
// distinction is worth stating precisely here because this annotation asserted the wrong one when
// the arm landed, and a witness had already disproved it in the same commit. Incomparable is
// reserved for two ContentHash values whose hash FAMILIES differ (structural against cryptographic),
// where no comparison exists to make. Generated against observed is a real and decidable comparison,
// and Differs is the arm that carries the safety, because a provisioning read-back treats it as a
// mismatch and refuses. Claiming the stronger-sounding arm made the guarantee sound structural when
// it is ordinary and sufficient.
//
// WHAT THIS ARM DOES NOT YET ESTABLISH. The ContentHash here is supplied by the caller, and
// secret_provision_receipt copies a payload_identity straight into the receipt with no read-back
// dominating the mint -- so a fabricated digest can today mint a receipt carrying a false identity.
// What stops that becoming printer authorization is the still-empty receipt roster, NOT anything
// intrinsic to this arm, and saying otherwise would be exactly the rung inflation section 4b names.
// The ordering that makes it fail-closed by construction is owed by the actuator: snapshot once,
// derive both the upload body and the expected digest from that ONE snapshot, add the version, read
// the exact version back, derive the observed digest, and reach the sealed mint only on a match.
// Then a wrong expected digest can only prevent a receipt, never forge one.
//
// This is the third arm the delivery lane needs before any printer code can be provisioned through
// the modelled path at all.
// ONE CANONICAL DIGEST FAMILY, NOT THE OPEN UNION. ContentHash is a coproduct over Fnv1a64
// structural fingerprints and the SHA-1/256/512 cryptographic families, and admitting all of them
// here would let a credential be named by a 64-bit STRUCTURAL fingerprint -- a family whose stated
// purpose is cheap structural identity, not resistance to a chosen collision. For "did these exact
// credential bytes survive provisioning unchanged" there is no reason to carry family polymorphism
// at all: this repository computes the digest itself, so it can simply pick one. The witnesses that
// landed with this arm used Fnv1a64 digests for credential bytes, which was wrong in exactly the
// direction this field now names.
//
// THIS IS A DECLARATION AND NOT YET A WALL, AND THE COMPILER ALREADY SAYS SO. The obvious sentence
// to write here is that Sha256Digest makes the wrong families UNSPELLABLE at construction. It is
// false today: under `gunbc run` an Fnv1a64Structural value -- a different product whose field is
// NAMED differently (digest, not hex) and refined to 16 hex characters rather than 64 -- is accepted
// in this position.
//
// WHY, LOCATED IN THE COMPILER RATHER THAN GUESSED AT. v1.compiler.infer declares twelve
// DeclaredTypePosition variants and states that only three have producers; PositionRecordLiteralField
// -- exactly this construction -- is named among THE NINE AWAITING A PRODUCER, which "produce
// nothing yet" and emit "no diagnostic, blocking or advisory". The shared declared_type_inhabitance
// relation already contains a nominal-product refusal; this seam simply never builds a
// DeclaredTypeObligation to hand it. So the check is ABSENT AT THIS POSITION, and its next-rung
// trigger is already written down there: a producer at this grammar seam.
//
// TWO EARLIER READINGS OF THIS ARE RECORDED AS WRONG, because each was a comfortable one. I first
// filed it under std.content_hash's Phase B gap; that row is specifically about union-level
// ContentHash ==/!= across families, and this failure happens before any comparison exists. I then
// wrote that the field IS typechecked and the acceptance is structural matching between compatible
// products -- inferred from a control where an Int in the same position IS refused. That control is
// real but does not license the conclusion: an absent obligation at this seam explains both
// observations, and "the checker is lax" is a strictly stronger claim than "the checker never ran
// here". Reading a partial refusal as evidence of a working-but-permissive check is how a coverage
// hole gets recorded as a design choice.
//
// So this field's honest guarantee is that a correct caller states its intent and a reviewer can see
// a violation. That is validation, not construction, and the gap is the compiler's declared one
// rather than anything this module can close.
//
// WHERE THE SMUGGLED VALUE ACTUALLY DIES, MEASURED RATHER THAN ARGUED -- AND IT IS NOT WHERE EITHER
// GUESS PUT IT. The obvious worry, once the typecheck is known not to wall this, is that a
// mislabelled Fnv1a64Structural flows on into as_content_hash_cryptographic, is wrapped as the
// Sha256Hash VARIANT, and is then compared down the same-family arm against a genuine read-back --
// never reaching ContentHashCrossFamilyIncomparable, and so silently answering a question about two
// digests that were never comparable. That would be silent wrongness, which §5 puts outside the
// ladder entirely.
//
// It does not happen, and the reason is field ACCESS rather than family comparison. The probe
// refuses at evaluation with NoSuchField { type_name: "Fnv1a64Structural", field: "hex" }: the two
// products are compatible enough to pass the assignment yet differ in the very field the consumer
// reads, because Sha256Digest names it hex and Fnv1a64Structural names it digest. So the value dies
// loudly at the first read, before any ContentHash is constructed and long before any comparison.
//
// THE HONEST RUNG THAT LEAVES. This is a loud, typed, located runtime refusal -- mitigation, the
// bottom rung -- and not the construction wall the field's type suggests. It is also not a property
// of this carrier: it holds because THIS consumer happens to read .hex, so a future path that
// carries the value without reading that field would not be protected by it. The earlier version of
// this sentence claimed the actuator's read-back was the protection. That was the right conclusion
// reached through the wrong mechanism, which is worth recording, because a correct conclusion resting
// on a wrong mechanism survives exactly until someone changes the mechanism.
type OperatorHeldCredential {
  sha256: Sha256Digest
}

type SecretProvisionCredential
  = SparkFactoryCredential { payload: OperatorCapturedInBoxCredential }
  | SparkAdministratorCredential { payload: WorkflowGeneratedCredential }
  | OperatorHeldObservedCredential { payload: OperatorHeldCredential }

type PayloadIdentity
  = GeneratedPayloadIdentity { password_length: CharacterCount }
  | ObservedPayloadIdentity { content_hash: ContentHash }

type SecretContainerObservation
  = SecretContainerAbsent
  | SecretContainerPresentAwaitingAttemptVersion { resource_name: String }
  | SecretContainerPresent { resource_name: String }

type SecretVersionMaterializationReceipt {
  attempt_identity: SecretProvisionAttemptIdentity
  version_resource: String
  payload_identity: PayloadIdentity
  identity: SecretRef
}

type SecretVersionPayloadObservation
  = VersionPayloadMatches { payload_identity: PayloadIdentity }
  | VersionPayloadMismatch {
      expected: PayloadIdentity,
      observed: PayloadIdentity,
    }
  | VersionPayloadUnreadable { version_resource: String }

type SecretMaterializationContext {
  container: SecretContainerObservation
  attempt_identity: SecretProvisionAttemptIdentity
  payload_identity: PayloadIdentity
  prior_receipt: SecretVersionMaterializationReceipt?
  version_payload: SecretVersionPayloadObservation?
}

type SecretMaterializationPlan
  = CreateSecretAndInitialVersion
  | AddVersionToExistingSecret

type SecretMaterializationAction
  = SecretCreatedAndVersioned { version_resource: String }
  | VersionMaterialized { version_resource: String }

type SecretProvisionReceipt {
  attempt_identity: SecretProvisionAttemptIdentity
  identity: SecretRef
  action: SecretMaterializationAction
  payload_identity: PayloadIdentity
}

type SecretProvisionRefusalCause
  = SecretProvisionAccessRefused { reason: NonEmptyStr }
  | DurabilityReadBackMismatch { version_resource: String }
  | PayloadGenerationFailed
  | PriorMaterializationAmbiguous { resource_name: String }
  | VersionPayloadIdentityMismatch

type SecretProvisionProgress
  = ProgressMaterialized { receipt: SecretProvisionReceipt }
  | ProgressAwaitingHuman { intervention: HumanIntervention }
  | ProgressRefused { cause: SecretProvisionRefusalCause }

type SecretProvisionOutcome
  = SecretProvisioned { receipt: SecretProvisionReceipt }
  | SecretProvisionHumanInterventionRequired { intervention: HumanIntervention }
  | SecretProvisionRefused { cause: SecretProvisionRefusalCause }

type SecretProvisionIntent {
  attempt_identity: SecretProvisionAttemptIdentity
  identity: SecretRef
  credential: SecretProvisionCredential
}

fn fleet_secret_ref(secret_id: NonEmptyStr) -> SecretRef {
  SecretRef {
    project: fleet_secrets_gcp_project,
    secret: secret_id,
    version: "pending",
    hash_state: HashPending,
  }
}

fn secret_ref_pin_version(ref: SecretRef, version: NonEmptyStr) -> SecretRef {
  SecretRef {
    project: ref.project,
    secret: ref.secret,
    version: version,
    hash_state: ref.hash_state,
  }
}

fn payload_identity_from_credential(credential: SecretProvisionCredential) -> PayloadIdentity? {
  match credential {
    SparkFactoryCredential { payload: _ } => Absent
    SparkAdministratorCredential { payload: payload } =>
      Present {
        value: GeneratedPayloadIdentity { password_length: payload.password_length },
      }
    OperatorHeldObservedCredential { payload: payload } =>
      Present {
        value: ObservedPayloadIdentity {
          content_hash: as_content_hash_cryptographic(digest: payload.sha256),
        },
      }
  }
}

// Three-valued because a cross-family ContentHash pair is neither equal nor different: collapsing
// it to false would report "the payload changed" for two digests that were never comparable, and
// std.content_hash's own comparison note forbids exactly that collapse. Mirrors extdeps.pin
// admit_pin_integrity, which refuses on incomparable rather than answering (review 50315).
type PayloadIdentityComparison
  = PayloadIdentityMatch
  | PayloadIdentityDiffers
  | PayloadIdentityIncomparable

fn compare_payload_identities(a: PayloadIdentity, b: PayloadIdentity) -> PayloadIdentityComparison {
  match a {
    GeneratedPayloadIdentity { password_length: la } =>
      match b {
        GeneratedPayloadIdentity { password_length: lb } =>
          if la == lb { PayloadIdentityMatch } else { PayloadIdentityDiffers }
        ObservedPayloadIdentity { content_hash: _ } => PayloadIdentityDiffers
      }
    ObservedPayloadIdentity { content_hash: ha } =>
      match b {
        GeneratedPayloadIdentity { password_length: _ } => PayloadIdentityDiffers
        ObservedPayloadIdentity { content_hash: hb } =>
          match compare_content_hash(left: ha, right: hb) {
            ContentHashEqual => PayloadIdentityMatch
            ContentHashDifferent => PayloadIdentityDiffers
            ContentHashCrossFamilyIncomparable => PayloadIdentityIncomparable
          }
      }
  }
}

fn secret_provision_intervention(
  identity: NonEmptyStr,
  frequency: HumanInterventionFrequency,
  subject: NonEmptyStr,
  instruction: NonEmptyStr,
) -> HumanIntervention {
  HumanIntervention {
    identity: identity as HumanInterventionIdentity,
    frequency: frequency,
    subject: subject,
    instruction: instruction,
    completion_evidence: NoDischargeSiteModeled,
  }
}

data gcp_fleet_secrets_wif_binding_intervention_identity: NonEmptyStr = "gcp-fleet-secrets-wif-binding"

fn gcp_fleet_secrets_wif_binding_intervention() -> HumanIntervention {
  secret_provision_intervention(
    identity: gcp_fleet_secrets_wif_binding_intervention_identity,
    frequency: FleetOnce,
    subject: "fleet secrets project workload-identity federation",
    instruction: "Establish the GitHub Actions workload-identity federation binding to the fleet automation service account on the fleet secrets project. Paid once for the fleet; workflow_dispatch jobs thereafter receive short-lived credentials through OIDC federation — no pasted tokens or long-lived keys."
  )
}

fn secret_provision_human_burden() -> ProvisioningHumanBurden {
  ProvisioningHumanBurden {
    interventions: [gcp_fleet_secrets_wif_binding_intervention()],
  }
}

fn prior_receipt_matches_context(
  receipt: SecretVersionMaterializationReceipt,
  ctx: SecretMaterializationContext,
) -> PayloadIdentityComparison {
  if receipt.attempt_identity == ctx.attempt_identity {
    compare_payload_identities(a: receipt.payload_identity, b: ctx.payload_identity)
  } else {
    PayloadIdentityDiffers
  }
}

fn classify_secret_materialization(
  ctx: SecretMaterializationContext,
) -> UpsertClassification<SecretMaterializationPlan> {
  match ctx.prior_receipt {
    Present { value: receipt } =>
      match prior_receipt_matches_context(receipt: receipt, ctx: ctx) {
        PayloadIdentityIncomparable =>
          UpsertClassification {
            verdict: Conflict,
            decision: Refuse {
              reason: "prior materialization receipt payload identity is a cross-family content hash and cannot be compared to this attempt" as NonEmptyStr,
            },
          }
        PayloadIdentityDiffers =>
        UpsertClassification {
          verdict: Conflict,
          decision: Refuse {
            reason: "prior materialization receipt does not match this attempt identity and payload identity" as NonEmptyStr,
          },
        }
        PayloadIdentityMatch =>
        match ctx.version_payload {
          Present { value: VersionPayloadMatches { payload_identity: observed } } =>
            match compare_payload_identities(a: receipt.payload_identity, b: observed) {
              PayloadIdentityMatch =>
                UpsertClassification { verdict: Converged, decision: Noop }
              PayloadIdentityIncomparable =>
                UpsertClassification {
                  verdict: Conflict,
                  decision: Refuse {
                    reason: "observed version payload identity is a cross-family content hash and cannot be compared to the prior materialization receipt" as NonEmptyStr,
                  },
                }
              PayloadIdentityDiffers =>
                UpsertClassification {
                  verdict: Conflict,
                  decision: Refuse {
                    reason: "exact version payload identity does not match prior materialization receipt" as NonEmptyStr,
                  },
                }
            }
          Present { value: VersionPayloadMismatch { expected: _, observed: _ } } =>
            UpsertClassification {
              verdict: Conflict,
              decision: Refuse {
                reason: "exact version read-back payload identity mismatch" as NonEmptyStr,
              },
            }
          Present { value: VersionPayloadUnreadable { version_resource: _ } } =>
            UpsertClassification {
              verdict: Inaccessible,
              decision: Refuse {
                reason: "exact version payload unreadable for materialization retry" as NonEmptyStr,
              },
            }
          Absent =>
            UpsertClassification {
              verdict: UnknownRefused,
              decision: Refuse {
                reason: "prior materialization receipt requires exact-version payload read-back before Noop" as NonEmptyStr,
              },
            }
        }
      }
    Absent =>
      match ctx.container {
        SecretContainerAbsent =>
          UpsertClassification {
            verdict: Absent,
            decision: Apply { plan: CreateSecretAndInitialVersion },
          }
        SecretContainerPresentAwaitingAttemptVersion { resource_name: _ } =>
          UpsertClassification {
            verdict: Drifted,
            decision: Apply { plan: AddVersionToExistingSecret },
          }
        SecretContainerPresent { resource_name: resource_name } =>
          UpsertClassification {
            verdict: Conflict,
            decision: Refuse {
              reason: concat(
                "secret container exists but no prior exact-version materialization receipt for this attempt — AddVersion refused",
                resource_name,
              ) as NonEmptyStr,
            },
          }
      }
  }
}

fn classify_secret_provision_progress(
  progress: SecretProvisionProgress,
) -> SecretProvisionOutcome {
  match progress {
    ProgressMaterialized { receipt: receipt } => SecretProvisioned { receipt: receipt }
    ProgressAwaitingHuman { intervention: intervention } =>
      SecretProvisionHumanInterventionRequired { intervention: intervention }
    ProgressRefused { cause: cause } => SecretProvisionRefused { cause: cause }
  }
}

// ONE RESOLVED IDENTITY IN, BOTH FIELDS DERIVED, AND A MALFORMED ONE MINTS NOTHING.
//
// This took version_resource and version as separate caller arguments, which made a
// self-contradicting receipt spellable: an action naming ".../versions/7" beside an identity pinned
// to "12", with nothing able to notice. They are one fact -- the identity Secret Manager returned
// from the write -- so the receipt derives both from it and that disagreement has no constructor.
//
// THE PROJECTION CAN REFUSE, AND THIS PROPAGATES IT RATHER THAN ABSORBING IT. SmResolvedVersionIdentity
// is a BRAND, not a validated carrier: any module can write `"anything" as SmResolvedVersionIdentity`,
// and a witness in this repository already does. So a supplied identity may not be a version resource
// at all, and the only honest arms are to mint a receipt from a well-formed one or to refuse. Picking
// a plausible segment out of a malformed string would put a value that was never a version resource
// into the field downstream pins a credential fetch on.
//
// SCOPE, STATED SO THE CLASS IS NOT READ AS CLOSED: this makes the receipt internally consistent and
// makes a malformed identity unable to produce one. It does NOT make the receipt effect-earned.
// SecretProvisionReceipt still has no seal and this fn is still pure, so a caller can supply a
// well-formed identity that came from nowhere. That half needs the provisioning actuator to be the
// sole minter, taking the identity from a performed AddVersion response rather than a parameter.
// A RECEIPT WHOSE IDENTITY DISAGREES WITH THE ACTION IT RECORDS IS WORSE THAN NO RECEIPT, and the
// blend that produced one was invisible: project and secret were taken from the INTENT while the
// version was taken from the RESOLVED resource. An intent for secret A answered with
// projects/P/secrets/B/versions/9 minted an identity for A/9 and recorded B/9 as the action -- two
// different secrets in one row, each field individually true. The identity now comes entirely from
// the resolved resource, and a resolved resource naming a different secret than the intent refuses
// instead of being averaged with it. Section 3: each fact lives in exactly one place, and the place
// is the response, because that is what the service actually did.
type SecretProvisionReceiptMint
  = ReceiptMinted { receipt: SecretProvisionReceipt }
  | ReceiptRefusedMalformedIdentity { supplied: String }
  | ReceiptRefusedResolvedSecretDisagreesWithIntent { intended: String, resolved: String }

// THE REFUSAL LOGIC IS SEPARATED FROM THE MINT SO THAT SEALING THE MINT DOES NOT DELETE ITS REDS.
// Both refusals below are decisions about the CONTENT of a resolved identity -- is it a version
// resource at all, and does the secret it names agree with the intent -- and neither needs an effect
// to be exercised. The mint, by contrast, must become reachable only from a performed AddVersion, or
// a receipt is forgeable by any caller that can spell one.
//
// Keeping them fused would force a choice between two bad ends: seal the mint and lose the ability to
// author these REDs at all, or leave it public so the witnesses keep working and the forgery stays
// open. §4b asks whether the RED is authorable BEFORE the wall is written, and here it is -- from a
// pure fixture, with no network and no fabricated evidence. So the classification stays public and
// total, and only the construction of a receipt from it becomes effect-earned.
type ResolvedIdentityClassification
  = ResolvedIdentityUsable { version: NonEmptyStr, version_resource: String }
  | ResolvedIdentityMalformed { supplied: String }
  | ResolvedIdentityDisagreesWithIntent { intended: String, resolved: String }

fn classify_resolved_identity(
  intent: SecretProvisionIntent,
  resolved: SmResolvedVersionIdentity,
) -> ResolvedIdentityClassification {
  match sm_resolved_version_id(identity: resolved) {
    SmVersionIdNotAVersionResource { supplied: supplied } =>
      ResolvedIdentityMalformed { supplied: supplied }
    SmVersionIdProjected { version: version } =>
      match sm_resolved_version_secret_resource(identity: resolved) {
        SmVersionSecretNotAVersionResource { supplied: supplied } =>
          ResolvedIdentityMalformed { supplied: supplied }
        SmVersionSecretProjected { secret_resource: resolved_secret } =>
          if (resolved_secret as String) != secret_ref_secret_resource(ref: intent.identity) {
            ResolvedIdentityDisagreesWithIntent {
              intended: secret_ref_secret_resource(ref: intent.identity),
              resolved: resolved as String,
            }
          } else {
            ResolvedIdentityUsable { version: version, version_resource: resolved as String }
          }
      }
  }
}

fn secret_provision_receipt(
  intent: SecretProvisionIntent,
  plan: SecretMaterializationPlan,
  resolved: SmResolvedVersionIdentity,
  payload_identity: PayloadIdentity,
) -> SecretProvisionReceiptMint {
  match classify_resolved_identity(intent: intent, resolved: resolved) {
    ResolvedIdentityMalformed { supplied: supplied } =>
      ReceiptRefusedMalformedIdentity { supplied: supplied }
    ResolvedIdentityDisagreesWithIntent { intended: i, resolved: r } =>
      ReceiptRefusedResolvedSecretDisagreesWithIntent { intended: i, resolved: r }
    ResolvedIdentityUsable { version: version, version_resource: version_resource } => {
      let pinned = secret_ref_pin_version(ref: intent.identity, version: version)
      match plan {
        CreateSecretAndInitialVersion =>
          ReceiptMinted { receipt: SecretProvisionReceipt {
            attempt_identity: intent.attempt_identity,
            identity: pinned,
            action: SecretCreatedAndVersioned { version_resource: version_resource },
            payload_identity: payload_identity,
          } }
        AddVersionToExistingSecret =>
          ReceiptMinted { receipt: SecretProvisionReceipt {
            attempt_identity: intent.attempt_identity,
            identity: pinned,
            action: VersionMaterialized { version_resource: version_resource },
            payload_identity: payload_identity,
          } }
      }
    }
  }
}

fn secret_provision_intent(
  attempt_identity: SecretProvisionAttemptIdentity,
  secret_id: NonEmptyStr,
  credential: SecretProvisionCredential,
) -> SecretProvisionIntent {
  SecretProvisionIntent {
    attempt_identity: attempt_identity,
    identity: fleet_secret_ref(secret_id: secret_id),
    credential: credential,
  }
}

// ZERO HERE MEANS "THIS CREDENTIAL HAS NO GENERATED PAYLOAD", NOT "ITS PASSWORD IS EMPTY", which is
// already what the factory arm returns and why that reading is safe to extend. An observed credential
// never had a generated length: we read bytes the printer issued, and the only thing we know about
// them is their digest. Deriving a length from a hash would be fabrication, and reporting the real
// byte count would answer a question this function does not ask -- it is named for the GENERATED
// payload specifically. The one consumer is a witness, so no production path can read the zero as a
// size; were that to change, the honest shape is an option rather than a sentinel.
fn generated_payload_password_char_count(credential: SecretProvisionCredential) -> Nat {
  match credential {
    SparkFactoryCredential { payload: _ } => character_count_value(c: character_count(count: 0))
    OperatorHeldObservedCredential { payload: _ } => character_count_value(c: character_count(count: 0))
    SparkAdministratorCredential { payload: payload } =>
      character_count_value(c: payload.password_length)
  }
}
