module gunbc.materialization_store_budgets

import std.types { List, NonEmptyStr }
import std.dissolution { DissolutionCondition, unbound_dissolution }
import std.measure { ByteSize, byte_size, measure_count }
import std.nat { Nat }
import std.cache_identity { typed_module_artifact_kind, compute_work_artifact_kind }
import extdeps.realization.materialization_store_local { LocalStoreFamilyBudget, local_store_budget_sum, materialization_store_local_facts_at }
import extdeps.cache.types { CacheInterfaceCatalogFacts }

// THE DURABLE STORE'S BUDGETS ARE POLICY, AND POLICY IS THIS LAYER'S FACT (DESIGN section 3). The
// transport (extdeps.realization.materialization_store_local) owns the budget's shape and its
// enforcement and receives these rows as a parameter; the per-host figures live here, beside the
// consumer that opens the durable root, so revising one never edits the transport. One root per host
// is structural (std.materialization_store_grant DurableHostVolumeRoot names one path), so the host
// ceiling is the declared sum of these rows and nothing else.

// POLICY, NAMED AS POLICY: 4 GiB for typed-module results per host. It is not derived from a
// measurement -- the only measured predecessor stored closure snapshots of ~3.65 GB each, which is not
// the per-module grain the store holds -- and its REVISION TRIGGER is the TypecheckModuleRequest
// consumer (PR C2) measuring real per-module entries on the durable root.
data materialization_store_typed_module_budget_policy: ByteSize = byte_size(count: 4294967296)

// THE COMPUTE FAMILY'S BUDGET IS RETAINED RECORDS x RECORD SIZE, and both factors are named.
// Retained records: a build's record must stay served for as long as a dependent compile or claim run
// of the same tree is in flight, and a host runs at most gunbc.compute.host_capacity compute_pool_slots
// (2) compute units at once, so at most two builds can be under an outstanding dependent obligation.
// Record size: one release build of the default bins, binaries carried as byte parts -- gunbc 38814272 +
// claim_batch 36982312 bytes under rustc 1.93.0, measured 2026-10-03 by `cargo build --release -p
// v1-compiler --bin gunbc --bin claim_batch` + `stat -c %s` on a BuildBuddy runner; the text parts
// (outcome, log, output manifest) are a rounding error beside them. REVISION TRIGGER: the compute
// family's own commits measured on the durable root (its occupancy index), or a change to
// compute_pool_slots.
data materialization_store_compute_work_record_size_measured: ByteSize = byte_size(count: 75796584)

data materialization_store_compute_work_retained_records: Nat = 2

data materialization_store_compute_work_budget_policy: ByteSize = byte_size(count: measure_count(m: materialization_store_compute_work_record_size_measured) * materialization_store_compute_work_retained_records)

data materialization_store_durable_family_budgets: List<LocalStoreFamilyBudget> = [
  LocalStoreFamilyBudget { family: typed_module_artifact_kind, budget: materialization_store_typed_module_budget_policy },
  LocalStoreFamilyBudget { family: compute_work_artifact_kind, budget: materialization_store_compute_work_budget_policy },
]

// The one host-wide figure: the sum of the durable root's declared family budgets.
data materialization_store_host_ceiling_bytes: ByteSize = local_store_budget_sum(budgets: materialization_store_durable_family_budgets)

// The catalog row for the store as DEPLOYED: the realization's facts at this layer's host ceiling.
data materialization_store_local_facts: CacheInterfaceCatalogFacts = materialization_store_local_facts_at(ceiling: materialization_store_host_ceiling_bytes)

// THE COMPUTE ROW IS CONSUMED BY EXECUTION: gunbc.compute.work_provider_local compute_durable_store
// opens the durable root with these rows on every compute request it memoizes. The TYPED-MODULE row's
// production consumer is still a declared frontier (DESIGN section 3c), named below; the witnesses pass
// fixture rows of their own, and the host-ceiling control reads the figure above.
data materialization_store_durable_budgets_consumer_frontier: DissolutionCondition = unbound_dissolution(description: "TRIGGER: the TypecheckModuleRequest consumer (PR C2) opens DurableHostVolumeRoot through extdeps.realization.materialization_store_local passing materialization_store_durable_family_budgets. SUFFICIENT FOR: these rows bound a production store on every run that consumes it; until then they are read only by the host-ceiling control, and this row is retired by that landing and nothing else." as NonEmptyStr)
