module gunbc.spark_bootstrap_provision






// The Spark bootstrap credential population, as convergence subjects rather than as callable
// mutation tools. An earlier revision of this module carried two patterns that dispatched
// CreateSecret / SetSecretIamPolicy / AddVersion unconditionally from whatever process invoked
// them. Those are deleted here rather than kept beside the model, because a pattern that mutates
// a cloud resource with no observe step, no membership diff, no attempt identity and no
// independent readback is not a convergence member — it is a terminal tool, and leaving it
// callable is what made the manual apply possible in the first place.
//
// What this module now owns: the exact credential population, the allocation of an external
// secret handle to each occurrence, and the classification of the two containers that already
// exist in Secret Manager. What it deliberately does NOT own: actuation. The cloud executor is
// the OIDC/WIF-authenticated workflow, and it consumes this model.

data spark_provision_scope_note: String = "This module models subjects and allocations; it does not actuate. The prior revision's spark_secret_containers_create / spark_secret_iam_converge / spark_secret_material_write patterns were deleted rather than repaired in place, because each was unconditional: create with no prior Get, SetIamPolicy with no GetIamPolicy and no etag (which REPLACES a policy rather than amending it, so unrelated bindings on any secret that had them would have been dropped), and AddVersion with no attempt identity (which mints a version per call, so an interrupted run sprawls). Repairing them as patterns would have preserved the shape whose availability was the defect."

// ── The population ────────────────────────────────────────────────────────────────────────
// FOUR occurrences, not two. An earlier revision carried two global secret ids -- one hotspot,
// one administrator -- which cannot represent this population: the factory hotspot value differs
// per device (the two SSIDs are distinct rows in gunbc.spark_bootstrap_credential), so one global
// hotspot secret would have to hold two different credentials, and because AddVersion never
// overwrites, the second write would silently become a new version of the first rather than a
// separate credential. This is the same host-scope error the POSIX principal split already fixed
// one carrier over: an account is per host, and so is a bootstrap credential.

type SparkCredentialKind
  = FactoryHotspotCredential
  | AdministratorCredential

type SparkCredentialOccurrence {
  host: product.placement_supply.HostIdentity
  kind: gunbc.spark_bootstrap_provision.SparkCredentialKind
}

fn spark_srv5() -> product.placement_supply.HostIdentity { "srv5" }
fn spark_srv6() -> product.placement_supply.HostIdentity { "srv6" }

fn spark_credential_occurrence(host: product.placement_supply.HostIdentity, kind: gunbc.spark_bootstrap_provision.SparkCredentialKind) -> gunbc.spark_bootstrap_provision.SparkCredentialOccurrence {
  SparkCredentialOccurrence { host: host, kind: kind }
}

fn spark_credential_population() -> List<gunbc.spark_bootstrap_provision.SparkCredentialOccurrence> {
  [
    SparkCredentialOccurrence { host: spark_srv5(), kind: FactoryHotspotCredential },
    gunbc.spark_bootstrap_provision.SparkCredentialOccurrence { host: spark_srv5(), kind: AdministratorCredential },
    gunbc.spark_bootstrap_provision.SparkCredentialOccurrence { host: spark_srv6(), kind: FactoryHotspotCredential },
    gunbc.spark_bootstrap_provision.SparkCredentialOccurrence { host: spark_srv6(), kind: AdministratorCredential }
  ]
}

fn spark_occurrence_eq(a: gunbc.spark_bootstrap_provision.SparkCredentialOccurrence, b: gunbc.spark_bootstrap_provision.SparkCredentialOccurrence) -> Bool {
  a.host == b.host && spark_credential_kind_eq(a: a.kind, b: b.kind)
}

fn spark_credential_kind_is_hotspot(k: gunbc.spark_bootstrap_provision.SparkCredentialKind) -> Bool {
  match k {
    FactoryHotspotCredential => true
    AdministratorCredential => false
  }
}

fn spark_credential_kind_eq(a: gunbc.spark_bootstrap_provision.SparkCredentialKind, b: gunbc.spark_bootstrap_provision.SparkCredentialKind) -> Bool {
  spark_credential_kind_is_hotspot(k: a) == spark_credential_kind_is_hotspot(k: b)
}

// ── The external handle ───────────────────────────────────────────────────────────────────
// A Secret Manager resource name is an ALLOCATED external handle for an occurrence. It is not
// the occurrence identity, and it must not be reverse-parsed to recover the host or the kind.
// gunbc.spark_bootstrap_credential already settled the naming law this obeys -- names are
// carried, never computed from a rendered HostIdentity -- because a computed name makes the
// secret namespace a function of how a host happens to be spelled today.
//
// No allocation has been made for any of the four occurrences, and Pending is therefore the only
// honest arm. Authoring four plausible ids here would be exactly the fabrication the naming law
// forbids: a name nobody allocated, asserted as though it referred to something.
type SparkSecretAllocation
  = SparkSecretAllocated { occurrence: gunbc.spark_bootstrap_provision.SparkCredentialOccurrence, handle: std.types.NonEmptyStr }
  | SparkSecretAllocationPending { occurrence: gunbc.spark_bootstrap_provision.SparkCredentialOccurrence }

fn spark_secret_allocation(occurrence: gunbc.spark_bootstrap_provision.SparkCredentialOccurrence) -> gunbc.spark_bootstrap_provision.SparkSecretAllocation {
  SparkSecretAllocationPending { occurrence: occurrence }
}

// ── The two containers that already exist ─────────────────────────────────────────────────
// Created 2026-08-09 by an interactive apply that this module no longer admits. They are real
// starting-state observations and they are NOT accepted convergence output, so they are named as
// legacy state rather than adopted as the authority for any occurrence. In particular the single
// hotspot container cannot be the authority for a hotspot credential, because there are two
// distinct factory values and it can hold only one of them without the other becoming a silent
// prior version.
//
// They are not edited or deleted from here. Retirement runs through the same convergence workflow
// once the four correct resources exist and no consumer references these.
type SparkLegacyContainerStanding
  = ObservedLegacyUnbound { handle: std.types.NonEmptyStr }

data spark_legacy_hotspot_container: gunbc.spark_bootstrap_provision.SparkLegacyContainerStanding = ObservedLegacyUnbound { handle: "spark-hotspot-password" }

data spark_legacy_administrator_container: gunbc.spark_bootstrap_provision.SparkLegacyContainerStanding = ObservedLegacyUnbound { handle: "spark-administrator-password" }

data spark_legacy_containers: List<gunbc.spark_bootstrap_provision.SparkLegacyContainerStanding> = [
  spark_legacy_hotspot_container,
  spark_legacy_administrator_container
]

data spark_legacy_container_note: String = "Two containers exist in gunbai-secrets from an interactive apply on 2026-08-09, each carrying secretAccessor + secretVersionAdder for the BMC assimilator service account. They classify ObservedLegacyUnbound: real observations of starting state, not accepted output, and not the authority for any occurrence. Neither carries a version -- no payload was ever written -- so nothing depends on them. Two independent reasons they cannot simply be adopted: the population is four and these are two, and the principal bound on them is the BMC assimilator, which is the wrong authority per spark_cloud_principal_note."

// ── The principal ─────────────────────────────────────────────────────────────────────────
// The deleted patterns granted access to the BMC assimilator service account. That was a
// cross-domain privilege expansion, not a convenient reuse: that principal is declared as a BMC
// assimilator scoped to the srv3 BMC secret, so binding it to Spark bootstrap credentials makes
// BMC assimilation the authority for Spark provisioning. It is also the nickname trap in its
// usual form -- one identity acquiring a second meaning because it happened to be nearby.
//
// The replacement is a semantic identity for the fleet's cloud convergence executor. It carries
// no allocated service-account handle yet, and the pending arm is the honest state: allocating
// one is a cloud mutation, which is precisely what this module no longer performs.
// ── The principal, and what is actually known about it ────────────────────────────────────
// The semantic identity is stable; the service-account email is an ALLOCATION with its own
// observation standing. An earlier revision fused them and returned Allocated while its own note
// said the allocation was not independently verified. Those two statements cannot coexist: the
// carrier reported a rung its evidence did not establish, which is the inflation this project
// forbids -- and it was mine, in the same commit that recorded the evidence as second-hand.
// Until the WIF workflow reads it back, Reported is the honest arm.
type FleetCloudConvergence {}

// THE SECOND PRINCIPAL, and it is not a naming exercise. Reconciling an IAM policy
// requires getIamPolicy + setIamPolicy; reading a secret requires versions.access.
// One principal holding all three can grant itself anything and then read it, so
// the authorization question "may this workflow change who can read the fleet key"
// would be answered by the same credential that answers "may this workflow read the
// fleet key". Splitting them is what makes the grant path approval-gated rather than
// self-serving: the administrator can change the policy and CANNOT read a payload;
// the convergence principal can read the payloads it is granted and CANNOT change
// any policy, including its own.
//
// This split is FORCED by measurement, not chosen for tidiness. Run 31336704811 at
// head da9d440f8f4 probed fleet-cloud-convergence against fleet-automation-ssh-key
// and got back exactly one permission, secretmanager.versions.access.
// secretmanager.secrets.getIamPolicy did NOT come back, and secrets.get returned a
// live 403 -- so the convergence principal provably cannot read a policy, and the
// overbreadth question stays UNOBSERVABLE until the administrator principal exists.
// That is the whole reason effective access stands at PartiallyObserved.
type FleetCloudGrantAdministrator {}

type FleetCloudPrincipalKey
  = FleetCloudConvergencePrincipal { role: gunbc.spark_bootstrap_provision.FleetCloudConvergence }
  | FleetCloudGrantAdministratorPrincipal { role: gunbc.spark_bootstrap_provision.FleetCloudGrantAdministrator }

// Which operations a principal ROLE may ever reach, before any grant is consulted.
// This is a ceiling on the credential itself, so a grant cell naming an operation
// outside its principal's ceiling cannot be satisfied by adding a binding.
// Data plane: never setIamPolicy, and never getIamPolicy either -- a principal that can read the
// policy can enumerate who else holds the key, which is a disclosure the data plane has no
// business performing. Control plane: reads and writes policy but CANNOT reach a payload, and
// AddVersion is excluded as well as AccessVersion because a principal that can write a version can
// overwrite the credential it is only supposed to be adjudicating.
fn principal_role_admits_operation(principal: gunbc.spark_bootstrap_provision.FleetCloudPrincipalKey, op: gunbc.spark_bootstrap_provision.SecretManagerOperation) -> Bool {
  match principal {
    FleetCloudConvergencePrincipal { role: _ } =>
      match op {
        SmAccessVersion => true
        SmAddVersion => true
        SmGetSecret => true
        SmDisableVersion => false
        SmDestroyVersion => false
        SmGetIamPolicy => false
        SmSetIamPolicy => false
      }
    FleetCloudGrantAdministratorPrincipal { role: _ } =>
      match op {
        SmGetIamPolicy => true
        SmSetIamPolicy => true
        SmGetSecret => true
        SmAccessVersion => false
        SmAddVersion => false
        SmDisableVersion => false
        SmDestroyVersion => false
      }
  }
}

// The property that makes the split worth having, stated so a witness can execute it
// rather than a comment asserting it: no operation is admitted to both roles except
// the metadata read, and neither role admits the pair (SmAccessVersion, SmSetIamPolicy).
fn no_principal_can_both_grant_and_read(principal: gunbc.spark_bootstrap_provision.FleetCloudPrincipalKey) -> Bool {
  !(principal_role_admits_operation(principal: principal, op: SmSetIamPolicy)
    && principal_role_admits_operation(principal: principal, op: SmAccessVersion))
}

type FleetCloudPrincipalAllocationStanding
  = CloudPrincipalUnallocated { principal: gunbc.spark_bootstrap_provision.FleetCloudPrincipalKey }
  | CloudPrincipalReported { principal: gunbc.spark_bootstrap_provision.FleetCloudPrincipalKey, reported_member: String, source: std.types.NonEmptyStr }
  | CloudPrincipalAllocated { principal: gunbc.spark_bootstrap_provision.FleetCloudPrincipalKey, member: String, readback: std.types.NonEmptyStr }

// GROUNDED 2026-08-09 by execution, not by report. A read-only GitHub OIDC -> WIF job on this
// branch obtained a token as this service account with no key, no pasted credential and no gcloud,
// and probed its own permissions. The reported allocation is therefore confirmed by an observation
// this session can cite: run 31335059188 at head 6b79d061c4a.
fn fleet_cloud_principal_standing() -> gunbc.spark_bootstrap_provision.FleetCloudPrincipalAllocationStanding {
  CloudPrincipalAllocated {
    principal: FleetCloudConvergencePrincipal { role: gunbc.spark_bootstrap_provision.FleetCloudConvergence {} },
    member: "serviceAccount:fleet-cloud-convergence@gunbai-secrets.iam.gserviceaccount.com",
    readback: "GitHub Actions run 31335059188 at 6b79d061c4a: OIDC/WIF token issued for this SA; testIamPermissions answered from the resource side"
  }
}

// ── Domain operations, projected into the one kernel ──────────────────────────────────────
// The Secret Manager operation population is a domain fact and belongs here. The DECISION is not:
// std.access.AccessDecision is the only admitted/refused sum, and decision_meet the only
// conjunction, so this module mints neither.
type SecretManagerOperation
  = SmGetSecret
  | SmGetIamPolicy
  | SmSetIamPolicy
  | SmAddVersion
  | SmAccessVersion
  | SmDisableVersion
  | SmDestroyVersion

fn sm_operation_rank(op: gunbc.spark_bootstrap_provision.SecretManagerOperation) -> Int {
  match op {
    SmGetSecret => 1
    SmGetIamPolicy => 2
    SmSetIamPolicy => 3
    SmAddVersion => 4
    SmAccessVersion => 5
    SmDisableVersion => 6
    SmDestroyVersion => 7
  }
}

fn sm_operation_eq(a: gunbc.spark_bootstrap_provision.SecretManagerOperation, b: gunbc.spark_bootstrap_provision.SecretManagerOperation) -> Bool {
  sm_operation_rank(op: a) == sm_operation_rank(op: b)
}

// ── Scope, and whether it moves ───────────────────────────────────────────────────────────
// FrozenAtGrant is load-bearing: "global over the current Spark population" must not silently mean
// that a machine added tomorrow inherits today's authority. Adding srv7 widens a grant only where
// the policy says TracksNamespaceMembership.
// FROZEN MUST NAME WHAT IT WAS FROZEN AT. The prior revision spelled this as a bare enum beside a
// resource list, which is a label rather than a mechanism: nothing recorded WHICH population the
// grant was frozen against, so "frozen" could not be checked and a later edit widening the list
// would have been indistinguishable from the original grant. FrozenAtGrant now carries the roster
// identity it was granted against, so a scope whose roster no longer matches the live population is
// a detectable condition rather than a silent widening.
type SparkRosterIdentity {
  roster: std.types.NonEmptyStr
  revision: std.types.NonEmptyStr
}

type AccessScopeEvolution
  = FrozenAtGrant { frozen_at: gunbc.spark_bootstrap_provision.SparkRosterIdentity }
  | TracksNamespaceMembership { roster: std.types.NonEmptyStr }

type SparkCloudScope {
  resources: List<std.types.NonEmptyStr>
  evolution: gunbc.spark_bootstrap_provision.AccessScopeEvolution
}

// THE CONTEXT A GRANT NEEDS TO BE ADJUDICATED, which the prior revision simply did not carry. A
// grant with no workflow, no revision, no purpose, no duration and no approval is not a decidable
// authorization subject: every question worth asking about it -- who may use it, for how long, on
// whose authority, and for what -- had no field to be answered from, so the decision could only ever
// be about operation and resource. These are context, not evidence: they describe the request, and
// what proves the request was really made under them is the evidence side.
type SparkGrantApproval
  = GrantApprovedBy { approver: std.types.NonEmptyStr, receipt: std.types.NonEmptyStr }
  | GrantApprovalPending { requested_from: std.types.NonEmptyStr }
  | GrantApprovalNotSought

type SparkCloudContext {
  workflow: std.types.NonEmptyStr
  revision: std.types.NonEmptyStr
  purpose: std.types.NonEmptyStr
  duration_seconds: Int
  max_uses: Int
  approval: gunbc.spark_bootstrap_provision.SparkGrantApproval
}

type SparkCloudGrant {
  principal: gunbc.spark_bootstrap_provision.FleetCloudPrincipalKey
  operations: List<gunbc.spark_bootstrap_provision.SecretManagerOperation>
  scope: gunbc.spark_bootstrap_provision.SparkCloudScope
  context: gunbc.spark_bootstrap_provision.SparkCloudContext
}

// The thin projection into the kernel. This module supplies the domain types; std.authorization_
// profile supplies the request shape and std.access the decision, so nothing about admission is
// re-invented here -- the profile is a type application, not a parallel access system.
type SparkCloudRequest =
  EffectRequest<gunbc.spark_bootstrap_provision.FleetCloudPrincipalKey, gunbc.spark_bootstrap_provision.SecretManagerOperation, std.types.NonEmptyStr, gunbc.spark_bootstrap_provision.SparkCloudContext, gunbc.spark_bootstrap_provision.WifCredentialIssuanceStanding>

fn spark_cloud_request(
  grant: gunbc.spark_bootstrap_provision.SparkCloudGrant,
  cell: gunbc.spark_bootstrap_provision.AccessGrantCell,
  evidence: gunbc.spark_bootstrap_provision.WifCredentialIssuanceStanding
) -> gunbc.spark_bootstrap_provision.SparkCloudRequest {
  std.authorization_profile.EffectRequest {
    subject: grant.principal,
    effect: cell.operation,
    target: cell.resource,
    context: grant.context,
    evidence: evidence
  }
}

// A grant is adjudicated as a SUBJECT of the kernel, not judged by a local fold. The projection
// exists so the request can be handed to std.access unchanged.
fn spark_cloud_access_request(
  grant: gunbc.spark_bootstrap_provision.SparkCloudGrant,
  cell: gunbc.spark_bootstrap_provision.AccessGrantCell,
  evidence: gunbc.spark_bootstrap_provision.WifCredentialIssuanceStanding
) -> std.access.AccessRequest<gunbc.spark_bootstrap_provision.FleetCloudPrincipalKey, EffectAuthorizationAction<gunbc.spark_bootstrap_provision.SecretManagerOperation>, std.types.NonEmptyStr, gunbc.spark_bootstrap_provision.SparkCloudContext, gunbc.spark_bootstrap_provision.WifCredentialIssuanceStanding> {
  effect_access_request(request: spark_cloud_request(grant: grant, cell: cell, evidence: evidence))
}

// An exact cell: one principal, one operation, one resource. Replaces a global present/absent
// standing, which could not answer which operation on which resource -- so "the principal is
// bound" read as coverage while naming nothing.
type AccessGrantCell {
  operation: gunbc.spark_bootstrap_provision.SecretManagerOperation
  resource: std.types.NonEmptyStr
}

type AccessGrantCellStanding
  = GrantCellPresent { cell: gunbc.spark_bootstrap_provision.AccessGrantCell }
  | GrantCellAbsent { cell: gunbc.spark_bootstrap_provision.AccessGrantCell }
  | GrantCellUnobserved { cell: gunbc.spark_bootstrap_provision.AccessGrantCell }

fn spark_scope_admits(scope: gunbc.spark_bootstrap_provision.SparkCloudScope, resource: std.types.NonEmptyStr) -> Bool {
  fold(scope.resources, init: false, f: (acc, r) => acc || r == resource)
}

fn spark_grant_admits_operation(grant: gunbc.spark_bootstrap_provision.SparkCloudGrant, op: gunbc.spark_bootstrap_provision.SecretManagerOperation) -> Bool {
  fold(grant.operations, init: false, f: (acc, o) => acc || sm_operation_eq(a: o, b: op))
}

// The projection. Two independent refusal coordinates -- action and object -- so an operation the
// grant never carried and a resource outside scope are different denials, not one blurred no.
// The subject is DERIVED from the grant, never a literal. The prior revision wrote the string
// "FleetCloudConvergence" into every refusal location, which was survivable while one principal
// existed and became a falsehood the moment the second one did: a refusal against the grant
// administrator would have been located against the convergence principal, so the diagnostic would
// name the wrong subject at exactly the moment someone needed it to be right.
fn spark_principal_label(principal: gunbc.spark_bootstrap_provision.FleetCloudPrincipalKey) -> String {
  match principal {
    FleetCloudConvergencePrincipal { role: _ } => "FleetCloudConvergence"
    FleetCloudGrantAdministratorPrincipal { role: _ } => "FleetCloudGrantAdministrator"
  }
}

fn spark_grant_refusal_location(grant: gunbc.spark_bootstrap_provision.SparkCloudGrant, cell: gunbc.spark_bootstrap_provision.AccessGrantCell) -> std.access.AccessRefusalLocation {
  std.access.AccessRefusalLocation {
    profile: "spark_cloud_grant",
    subject: spark_principal_label(principal: grant.principal),
    action: "secret-manager-operation",
    object: cell.resource as String
  }
}

// THE CEILING IS CHECKED FIRST, and it is not the same question as the grant. A grant naming an
// operation outside its principal's role ceiling cannot be satisfied by adding an IAM binding --
// the credential is not allowed to reach that operation at all -- so that refusal is about the
// subject, not the action, and adding a binding in response would be the wrong remedy.
fn spark_cloud_grant_decision(grant: gunbc.spark_bootstrap_provision.SparkCloudGrant, cell: gunbc.spark_bootstrap_provision.AccessGrantCell) -> std.access.AccessDecision {
  if !principal_role_admits_operation(principal: grant.principal, op: cell.operation) {
    Deny { refusal: std.access.AccessRefusal {
      cause: std.access.AccessSubjectNotRecognized { subject: "operation outside this principal's role ceiling; the split forbids it regardless of any binding" },
      location: spark_grant_refusal_location(grant: grant, cell: cell) } }
  } else if !spark_grant_admits_operation(grant: grant, op: cell.operation) {
    Deny { refusal: std.access.AccessRefusal {
      cause: std.access.AccessActionNotGranted { action: "operation outside the granted population" },
      location: spark_grant_refusal_location(grant: grant, cell: cell) } }
  } else if !spark_scope_admits(scope: grant.scope, resource: cell.resource) {
    Deny { refusal: std.access.AccessRefusal {
      cause: std.access.AccessObjectNotGranted { object: "resource outside the granted scope" },
      location: spark_grant_refusal_location(grant: grant, cell: cell) } }
  } else {
    Permit
  }
}

// Actuation additionally requires the principal to be independently observed. A Reported principal
// is a claim about the cloud nobody in this run verified, so it cannot authorize an effect -- and
// this is where decision_meet does the conjoining rather than a second fold.
fn spark_principal_decision(standing: gunbc.spark_bootstrap_provision.FleetCloudPrincipalAllocationStanding) -> std.access.AccessDecision {
  match standing {
    CloudPrincipalAllocated { principal: _, member: _, readback: _ } => Permit
    CloudPrincipalReported { principal: _, reported_member: _, source: _ } =>
      Deny { refusal: std.access.AccessRefusal {
        cause: std.access.AccessEvidenceAbsent { evidence: "principal allocation is externally reported and not read back by this run" },
        location: std.access.AccessRefusalLocation {
          profile: "spark_cloud_principal", subject: "FleetCloudConvergence",
          action: "actuate", object: "spark-cloud-population" } } }
    CloudPrincipalUnallocated { principal: _ } =>
      Deny { refusal: std.access.AccessRefusal {
        cause: std.access.AccessSubjectNotRecognized { subject: "no allocated cloud principal" },
        location: std.access.AccessRefusalLocation {
          profile: "spark_cloud_principal", subject: "FleetCloudConvergence",
          action: "actuate", object: "spark-cloud-population" } } }
  }
}

fn spark_actuation_decision(
  standing: gunbc.spark_bootstrap_provision.FleetCloudPrincipalAllocationStanding,
  grant: gunbc.spark_bootstrap_provision.SparkCloudGrant,
  cell: gunbc.spark_bootstrap_provision.AccessGrantCell
) -> std.access.AccessDecision {
  decision_meet(
    a: spark_principal_decision(standing: standing),
    b: spark_cloud_grant_decision(grant: grant, cell: cell))
}

data spark_access_adapter_note: String = "This module is an ADAPTER, not an access system. It supplies the domain operation population, the resource identity and the scope rows; std.access supplies AccessRequest, AccessDecision, the typed refusal coordinates and decision_meet. No second admitted/refused sum is minted here. Independence is a property of the grant -- principal x operation x resource x context -- and never of a username, a uid, a service-account count, or how many credential values happen to exist. Two passwords under one project-wide binding are not independent access; one short-lived token over two exact resources may be far tighter."

// ── Effective access, at the strength the instrument supports ─────────────────────────────
// WIF ISSUANCE and CAPABILITY are two observations, not one. The first is about the credential
// path; the second is about a permission on a resource. Fusing them let a single run stand for
// both, which is how "the workflow authenticated" would come to mean "the access is understood".
type WifCredentialIssuanceStanding
  = WifIssuanceObserved { principal: std.types.NonEmptyStr, workflow: std.types.NonEmptyStr, revision: std.types.NonEmptyStr, receipt: std.types.NonEmptyStr }
  | WifIssuanceUnobserved { cause: std.types.NonEmptyStr }

fn spark_wif_issuance_standing() -> gunbc.spark_bootstrap_provision.WifCredentialIssuanceStanding {
  WifIssuanceObserved {
    principal: "serviceAccount:fleet-cloud-convergence@gunbai-secrets.iam.gserviceaccount.com",
    workflow: "spark-cloud-observe",
    revision: "6b79d061c4a",
    receipt: "GitHub Actions run 31335059188; 600s token, no key, no credentials file, no gcloud"
  }
}

// THE INSTRUMENT DOES NOT SUPPORT AN ABSENCE CLAIM. An earlier revision of this section recorded
// EffectiveAccessIncomplete with an exact missing-cell population and asserted there was no
// Overbroad finding, on the strength of testIamPermissions returning an empty object. That reading
// is wrong: the API returns the empty set for a resource that does not exist, is documented as a
// permission-aware-UI helper rather than an authorization check, and is not a guarantee of denial.
// So an empty response is exactly the ambiguity a 403 carries -- denied, or absent -- and I had
// claimed it RESOLVED that ambiguity. Positive returns remain good evidence; silence is not a
// construction wall for absence.
//
// Overbreadth is likewise UNOBSERVED rather than absent: nothing enumerated the policy, so no
// probe could have found a binding it did not think to ask about.
type EffectiveAccessStanding
  = EffectiveAccessExact { observed_cells: List<gunbc.spark_bootstrap_provision.AccessGrantCell> }
  | EffectiveAccessOverbroad { extra_cells: List<gunbc.spark_bootstrap_provision.AccessGrantCell> }
  | EffectiveAccessPartiallyObserved {
      positively_observed: List<gunbc.spark_bootstrap_provision.AccessGrantCell>
      requested_but_not_returned: List<gunbc.spark_bootstrap_provision.AccessGrantCell>
      overbreadth_unobserved_cause: std.types.NonEmptyStr
    }
  | EffectiveAccessUnobserved { cause: std.types.NonEmptyStr }

// The ONE cell the run positively established. A returned permission is a real observation; it is
// the only kind this probe produced.
fn spark_positively_observed_cells() -> List<gunbc.spark_bootstrap_provision.AccessGrantCell> {
  [ AccessGrantCell { operation: SmAccessVersion, resource: "fleet-automation-ssh-key" } ]
}

// Requested and not returned. NOT called missing: for these subjects the run never established
// that the resource exists, so absence of permission and absence of resource are not separated.
fn spark_requested_but_not_returned_cells() -> List<gunbc.spark_bootstrap_provision.AccessGrantCell> {
  [
    AccessGrantCell { operation: SmGetSecret, resource: "fleet-automation-ssh-key" },
    gunbc.spark_bootstrap_provision.AccessGrantCell { operation: SmGetSecret, resource: "spark-hotspot-password" },
    gunbc.spark_bootstrap_provision.AccessGrantCell { operation: SmAccessVersion, resource: "spark-hotspot-password" },
    gunbc.spark_bootstrap_provision.AccessGrantCell { operation: SmAddVersion, resource: "spark-hotspot-password" },
    gunbc.spark_bootstrap_provision.AccessGrantCell { operation: SmGetSecret, resource: "spark-administrator-password" },
    gunbc.spark_bootstrap_provision.AccessGrantCell { operation: SmAccessVersion, resource: "spark-administrator-password" },
    gunbc.spark_bootstrap_provision.AccessGrantCell { operation: SmAddVersion, resource: "spark-administrator-password" }
  ]
}

fn spark_effective_access_standing() -> gunbc.spark_bootstrap_provision.EffectiveAccessStanding {
  EffectiveAccessPartiallyObserved {
    positively_observed: spark_positively_observed_cells(),
    requested_but_not_returned: spark_requested_but_not_returned_cells(),
    overbreadth_unobserved_cause: "no policy enumeration was performed; a probe cannot find a binding it did not ask about, so overbreadth is unobserved rather than absent"
  }
}

data spark_effective_access_receipt_note: String = "Measured 2026-08-09, GitHub Actions run 31335059188 at head 6b79d061c4a, read-only. WHAT IS ESTABLISHED: GitHub OIDC exchanged through WIF issued a 600-second token for fleet-cloud-convergence@ with no key, no credentials file and no gcloud, and that token positively exercised secretmanager.versions.access on fleet-automation-ssh-key. WHAT IS NOT ESTABLISHED, corrected after an overclaim in the prior revision of this row: nothing about absence. testIamPermissions returns the empty set for a resource that does not exist, is documented as a permission-aware-UI helper rather than an authorization check, and may fail open -- so an empty response carries exactly the denied-or-absent ambiguity a 403 carries, and the prior claim that it RESOLVED that ambiguity was wrong. The seven cells are therefore requested-but-not-returned, never a missing-cell population, and overbreadth is UNOBSERVED rather than absent because no policy enumeration ran. Also observed: the Cloud Resource Manager API is disabled on the project, so the project-level principal readback did not execute; the principal is grounded by the ISSUANCE receipt instead, which is a different and narrower fact."
// ── The convergence shape this model is consumed by ───────────────────────────────────────
// Declared as the required sequence rather than implemented as callable mutation, because the
// executor is the OIDC/WIF workflow. Each arm names why it exists.
//
//   observe container        Get before Create. Absent -> create then read back the exact
//                            resource; matching -> Noop; conflicting -> Refuse with the exact
//                            differences; unreadable -> Refuse. Never "call Create and read 409
//                            as already-done", which is what the prior revision did and what its
//                            own measured receipt refuted.
//
//   reconcile IAM            GetIamPolicy -> membership diff -> preserve unrelated admitted
//                            bindings -> amend only owned members -> SetIamPolicy carrying the
//                            observed etag -> GetIamPolicy readback. The etag is not politeness:
//                            setIamPolicy replaces the policy, so a blind write drops bindings it
//                            never saw, and a concurrent update overwrites silently without the
//                            read-modify-write cycle.
//
//   materialize              At most one AddVersion per attempt identity. A durable receipt names
//                            the exact version created, so an interrupted run resumes by
//                            ACCESSING that version rather than minting another. Never retry
//                            AddVersion because a process outcome was lost -- a lost outcome is
//                            not evidence the write did not land.
//
//   read back                A separate AccessVersion against the exact recorded version,
//                            compared by payload identity. The writer reporting its own returned
//                            value is not a readback, and `latest` is a moving alias that cannot
//                            witness which version this run wrote.
data spark_convergence_shape_note: String = "observe container (Get before Create; absent/matching/conflicting/unreadable are four distinct verdicts) -> reconcile IAM (GetIamPolicy, membership diff, preserve unrelated bindings, SetIamPolicy with observed etag, readback) -> materialize (at most one AddVersion per attempt identity, receipt naming the exact version) -> independent readback (AccessVersion at that exact version, compared by payload identity). Secret material never crosses a string-shaped CLI boundary: base64 is wire encoding, not confidentiality, and gunbc.spark_bootstrap_credential's sensitive-input policy already refuses secrets appearing in argv or standard streams. Material is generated or fetched inside the admitted run and projected to base64 at the REST boundary."

data spark_provision_frontier_note: String = "NOT BUILT, and named so the absence is countable rather than implied: the four secret allocations, the container observe/classify operation, the IAM membership diff, the materialization attempt identity and receipt, the independent payload-identity readback, the allocated fleet cloud-convergence principal, the shared GitHub-to-GCP federation authority, and the generated workflow that executes all of it under OIDC/WIF. Until those exist the Spark cloud population converges 0 of 4 occurrences, and the two existing containers do not reduce that number."

// ── Container observation: Get before Create ──────────────────────────────────────────────
// Four verdicts, because "absent", "already correct", "present but not ours to write into" and
// "could not be read" have four different remedies. The prior revision collapsed all of them into
// calling Create and reading a 409, which is the absorbing fallback in its cheapest form: an error
// arm standing in for an observation nobody made.

type SparkContainerObservation
  = SparkContainerAbsent
  | SparkContainerPresent { handle: std.types.NonEmptyStr, version_count: Int }
  | SparkContainerUnreadable { cause: std.types.NonEmptyStr }

type SparkContainerVerdict
  = SparkContainerCreateRequired
  | SparkContainerConverged { handle: std.types.NonEmptyStr }
  | SparkContainerConflicted { handle: std.types.NonEmptyStr, cause: std.types.NonEmptyStr }
  | SparkContainerRefused { cause: std.types.NonEmptyStr }

// A container that ALREADY carries a version is Conflicted, not Converged. Writing into it would
// make this run's credential a SECOND version of something nobody in this run authored, and
// because AddVersion never overwrites, the prior value stays live and accessible. Adopting it
// silently is how one occurrence ends up holding two different credentials.
fn classify_spark_container(
  allocation: gunbc.spark_bootstrap_provision.SparkSecretAllocation,
  observation: gunbc.spark_bootstrap_provision.SparkContainerObservation
) -> gunbc.spark_bootstrap_provision.SparkContainerVerdict {
  match allocation {
    SparkSecretAllocationPending { occurrence: _ } =>
      SparkContainerRefused { cause: "occurrence has no allocated handle; there is nothing to observe by, and guessing a name is the fabrication the carried-never-derived law forbids" }
    SparkSecretAllocated { occurrence: _, handle: _ } =>
      match observation {
        SparkContainerAbsent => SparkContainerCreateRequired
        SparkContainerUnreadable { cause: c } => SparkContainerRefused { cause: c }
        SparkContainerPresent { handle: h, version_count: n } =>
          if n > 0 {
            SparkContainerConflicted { handle: h, cause: "container already carries a version this run did not write; AddVersion never overwrites, so writing here would leave two live credentials for one occurrence" }
          } else {
            SparkContainerConverged { handle: h }
          }
      }
  }
}

// ── IAM: membership diff, never a blind replace ───────────────────────────────────────────
// setIamPolicy REPLACES the policy rather than amending it, so the desired write is computed as a
// delta against an observed policy and unrelated bindings are carried through untouched. The
// owned-universe parameter is what makes "unrelated" decidable: a member outside it is preserved
// even when it is not desired, because this model does not own it and removing it would be acting
// outside our authority.

// THE GRAIN IS role x member x condition, not member. The prior revision diffed flat member
// strings, which cannot express the question a policy actually answers: the same member appearing
// under roles/secretmanager.secretAccessor and under roles/secretmanager.admin is ONE entry in a
// member-grain diff, so demoting a principal from admin to accessor reads as "already present,
// nothing to do" and the admin binding survives. Worse in the preserve direction: a member-grain
// preserve carries a member through without carrying WHICH role it was preserved under, so
// reassembling a policy from it has to guess.
//
// A cell is one (role, member, condition) triple -- the exact unit an IAM decision is made on. The
// wire binding list is recovered by grouping cells back by (role, condition) at the boundary, so a
// cell nobody authored survives the round trip instead of being dropped by a role-level replace.
type SparkIamDelta {
  add: List<extdeps.cloud.gcp.iam.GcpIamBindingCell>
  remove: List<extdeps.cloud.gcp.iam.GcpIamBindingCell>
  preserve: List<extdeps.cloud.gcp.iam.GcpIamBindingCell>
}

// Condition equality is part of cell identity, not a detail. Two cells with the same role and
// member but different conditions are DIFFERENT grants -- one may be time-boxed and the other
// permanent -- so treating them as equal would let a conditional grant be silently replaced by an
// unconditional one, or an unconditional one survive a reconcile that meant to bound it.
// Cell identity and membership are the GCP IAM authority's, consumed here rather than re-derived.
// An earlier revision of this module defined spark_condition_eq / spark_cell_eq / spark_cell_in
// locally; once the same mechanism landed in extdeps.cloud.gcp.iam for the BMC callers, keeping
// these was a second semantics for one concept -- exactly the fork this lane exists to remove.
fn spark_condition_eq(a: extdeps.cloud.gcp.iam.IamCondition?, b: extdeps.cloud.gcp.iam.IamCondition?) -> Bool {
  gcp_condition_eq(a: a, b: b)
}

fn spark_cell_eq(a: extdeps.cloud.gcp.iam.GcpIamBindingCell, b: extdeps.cloud.gcp.iam.GcpIamBindingCell) -> Bool {
  gcp_cell_eq(a: a, b: b)
}

fn spark_cell_in(c: extdeps.cloud.gcp.iam.GcpIamBindingCell, xs: List<extdeps.cloud.gcp.iam.GcpIamBindingCell>) -> Bool {
  gcp_cell_in(c: c, xs: xs)
}

// gunbc.bootstrap.Ownership is asked at CELL grain too. A model that owns (member M, role accessor) does not
// thereby own (member M, role admin): the second may have been granted by someone else for a
// reason this model cannot see, so removing it would be acting outside our authority even though
// the member is one we recognise.
fn spark_iam_delta(
  observed: List<extdeps.cloud.gcp.iam.GcpIamBindingCell>,
  desired_owned: List<extdeps.cloud.gcp.iam.GcpIamBindingCell>,
  owned_universe: List<extdeps.cloud.gcp.iam.GcpIamBindingCell>
) -> gunbc.spark_bootstrap_provision.SparkIamDelta {
  SparkIamDelta {
    add: desired_owned |> filter(c => !spark_cell_in(c: c, xs: observed)),
    remove: observed |> filter(c => spark_cell_in(c: c, xs: owned_universe) && !spark_cell_in(c: c, xs: desired_owned)),
    preserve: observed |> filter(c => !spark_cell_in(c: c, xs: owned_universe))
  }
}

// The etag is not politeness. Without the observed etag a concurrent update is overwritten with no
// signal, so a write that cannot name the policy it read REFUSES rather than proceeding.
type SparkObservedEtag
  = SparkEtagObserved { etag: std.types.NonEmptyStr }
  | SparkEtagMissing

type SparkIamWriteAdmission
  = SparkIamWriteAdmitted { etag: std.types.NonEmptyStr, delta: gunbc.spark_bootstrap_provision.SparkIamDelta }
  | SparkIamWriteRefused { cause: std.types.NonEmptyStr }

fn admit_spark_iam_write(observed_etag: gunbc.spark_bootstrap_provision.SparkObservedEtag, delta: gunbc.spark_bootstrap_provision.SparkIamDelta) -> gunbc.spark_bootstrap_provision.SparkIamWriteAdmission {
  match observed_etag {
    SparkEtagMissing =>
      SparkIamWriteRefused { cause: "no observed etag; a policy write that cannot name the policy it read silently overwrites a concurrent update" }
    SparkEtagObserved { etag: e } => SparkIamWriteAdmitted { etag: e, delta: delta }
  }
}

// ── Materialization: at most one AddVersion per attempt identity ──────────────────────────
// AddVersion mints a version per call and never overwrites, so "retry because the last outcome was
// lost" is the one move that must be unreachable: a lost process outcome is not evidence the write
// did not land, and treating it as such sprawls versions for a single intended credential.

// The two occurrence kinds are NOT symmetric in where their material comes from, and this is the
// asymmetry the convergence shape's "generate or fetch inside the admitted run" does not cover. An
// administrator credential can be generated by the run. A FACTORY hotspot credential cannot: it is
// a value printed on the device, so there is nothing to generate and nothing to fetch it from. Its
// only honest source is an operator observation entering through the sensitive-input boundary.
type SparkMaterializationSource
  = GeneratedInRun { recipe: std.types.NonEmptyStr }
  | ObservedFromDevice { note: std.types.NonEmptyStr }

// A generated factory credential is a fabricated observation of physical hardware -- the value
// would be a plausible string that is not what is printed on the device, and every downstream
// check would pass while the credential was simply wrong. So the pairing is refused rather than
// documented.
type SparkSourceAdmission
  = SparkSourceAdmitted { source: gunbc.spark_bootstrap_provision.SparkMaterializationSource }
  | SparkSourceRefused { cause: std.types.NonEmptyStr }

fn admit_spark_material_source(kind: gunbc.spark_bootstrap_provision.SparkCredentialKind, source: gunbc.spark_bootstrap_provision.SparkMaterializationSource) -> gunbc.spark_bootstrap_provision.SparkSourceAdmission {
  match kind {
    AdministratorCredential => SparkSourceAdmitted { source: source }
    FactoryHotspotCredential =>
      match source {
        ObservedFromDevice { note: n } => SparkSourceAdmitted { source: ObservedFromDevice { note: n } }
        GeneratedInRun { recipe: _ } =>
          SparkSourceRefused { cause: "a factory hotspot credential is printed on the device and cannot be generated; generating one fabricates an observation of physical hardware that every downstream check would accept" }
      }
  }
}

type SparkMaterializationIdentity {
  occurrence: gunbc.spark_bootstrap_provision.SparkCredentialOccurrence
  payload_identity: std.types.NonEmptyStr
}

type SparkReadbackVerdict
  = SparkReadbackMatched { version: std.types.NonEmptyStr }
  | SparkReadbackMismatched { version: std.types.NonEmptyStr }
  | SparkReadbackUnavailable { cause: std.types.NonEmptyStr }

type SparkMaterializationReceipt {
  identity: gunbc.spark_bootstrap_provision.SparkMaterializationIdentity
  handle: std.types.NonEmptyStr
  exact_version: std.types.NonEmptyStr
  readback: gunbc.spark_bootstrap_provision.SparkReadbackVerdict
}

// Three attempt states, because "never tried", "issued and unconfirmed" and "confirmed" have three
// different resolutions. The middle one is the whole point: it resolves by OBSERVING the store,
// never by issuing a second AddVersion.
// Four states. SparkAttemptJournaled is the only route to a first write: the attempt is durably
// recorded BEFORE the effect is issued, so a crash between journal and issue lands in
// IssuedUnconfirmed and resolves by observation rather than by a second AddVersion.
type SparkAttemptRecord
  = SparkAttemptNone
  | SparkAttemptJournaled { identity: gunbc.spark_bootstrap_provision.SparkMaterializationIdentity }
  | SparkAttemptIssuedUnconfirmed { identity: gunbc.spark_bootstrap_provision.SparkMaterializationIdentity }
  | SparkAttemptConfirmed { receipt: gunbc.spark_bootstrap_provision.SparkMaterializationReceipt }

type SparkMaterializationDecision
  = SparkMaterializeOnce { identity: gunbc.spark_bootstrap_provision.SparkMaterializationIdentity }
  | SparkMaterializeNoop { exact_version: std.types.NonEmptyStr }
  | SparkMaterializeObserveStore { identity: gunbc.spark_bootstrap_provision.SparkMaterializationIdentity }
  | SparkMaterializeRefused { cause: std.types.NonEmptyStr }

// THE ONLY producer of a materialization decision. A public spark_materialize_once existed here and
// is deleted: it let any caller mint SparkMaterializeOnce without consulting the attempt record,
// which made the whole at-most-once argument advisory -- the wall was in the prose and the bypass
// was in the interface.
//
// The confirmed arm now JOINS the receipt's own fields. A receipt carrying exact_version 7 beside a
// readback for version 8 previously produced Noop, because nothing compared them; two fields that
// must agree and are never checked are two facts, not one.
fn decide_spark_materialization(record: gunbc.spark_bootstrap_provision.SparkAttemptRecord) -> gunbc.spark_bootstrap_provision.SparkMaterializationDecision {
  match record {
    SparkAttemptNone => SparkMaterializeRefused { cause: "no attempt identity supplied; a materialization without one cannot be resumed, because nothing distinguishes a retry from a first attempt" }
    SparkAttemptJournaled { identity: i } => SparkMaterializeOnce { identity: i }
    SparkAttemptIssuedUnconfirmed { identity: i } => SparkMaterializeObserveStore { identity: i }
    SparkAttemptConfirmed { receipt: r } =>
      match r.readback {
        SparkReadbackMatched { version: v } =>
          if (v as String) == (r.exact_version as String) {
            SparkMaterializeNoop { exact_version: v }
          } else {
            SparkMaterializeRefused { cause: "receipt names one version and its readback verified a different one; the receipt does not attest to the version it claims" }
          }
        SparkReadbackMismatched { version: _ } => SparkMaterializeRefused { cause: "recorded version read back a payload identity that does not match what this attempt wrote; the stored credential is not the one this receipt claims" }
        SparkReadbackUnavailable { cause: c } => SparkMaterializeRefused { cause: c }
      }
  }
}

// AN EXACT VERSION ADDRESS IS NOT A PAYLOAD MATCH. The prior revision of this function turned any
// non-`latest` string into SparkReadbackMatched, which is fabricated success in its purest form: it
// consumed no AccessVersion response, no decoded payload, no expected identity and no comparison,
// yet produced the verdict that discharges a receipt. Naming an exact version is NECESSARY evidence
// and it is not sufficient, so admission and matching are now two operations and this one can only
// ever yield an address.
type SparkVersionAddressAdmission
  = SparkVersionAddressAdmitted { version: std.types.NonEmptyStr }
  | SparkVersionAddressRefused { cause: std.types.NonEmptyStr }

fn admit_spark_readback_version(version: std.types.NonEmptyStr) -> gunbc.spark_bootstrap_provision.SparkVersionAddressAdmission {
  if (version as String) == "latest" {
    SparkVersionAddressRefused { cause: "readback named the moving alias latest rather than an exact version; it cannot witness which version this run wrote" }
  } else {
    SparkVersionAddressAdmitted { version: version }
  }
}

// The matched verdict is reachable ONLY through a comparison of an expected identity against one
// decoded from an actual access of that exact version. Both identities are inputs; neither is
// assumed, and no arm produces Matched without them agreeing.
fn compare_spark_readback(
  address: gunbc.spark_bootstrap_provision.SparkVersionAddressAdmission,
  expected_identity: std.types.NonEmptyStr,
  observed_identity: std.types.NonEmptyStr
) -> gunbc.spark_bootstrap_provision.SparkReadbackVerdict {
  match address {
    SparkVersionAddressRefused { cause: c } => SparkReadbackUnavailable { cause: c }
    SparkVersionAddressAdmitted { version: v } =>
      if expected_identity == observed_identity {
        SparkReadbackMatched { version: v }
      } else {
        SparkReadbackMismatched { version: v }
      }
  }
}


// ── Demand: derived from the SELECTED effects, never authored ─────────────────────────────
// The population of access this workflow needs is a PROJECTION of the effects it will actually
// perform. An earlier revision authored it: SparkCloudGrant.operations x SparkCloudScope.resources
// was a hand-maintained roster crossed into cells, which is wrong twice over. It is a second
// inventory of what the code needs, maintained by hand beside the code, so it drifts; and the
// cross product grants every listed operation on every listed resource, so a plan that only reads
// secret A and writes secret B acquires write on A and read on B for free.
//
// One cell per (selected invocation, required permission). The resource comes from the effect, so
// it is exactly the one that effect touches.
type ExternalAccessDemand {
  source_effect: std.types.NonEmptyStr
  executor: gunbc.spark_bootstrap_provision.FleetCloudPrincipalKey
  invocation: v2.std.operation_argv.OperationRef
  permission: std.types.NonEmptyStr
  resource: std.types.NonEmptyStr
  context: gunbc.spark_bootstrap_provision.SparkCloudContext
}

data no_access_demand: List<gunbc.spark_bootstrap_provision.ExternalAccessDemand> = []

// A selected step: the effect plus the identity of the plan step that selected it. source_effect
// is what makes a demand cell explicable -- it answers "why is this permission being requested"
// with a step a reader can find, rather than leaving the cell to be justified by the roster it
// came from.
type SelectedSparkEffect {
  step: std.types.NonEmptyStr
  effect: extdeps.cloud.gcp.secret_manager.SecretManagerEffect
}

// An operation whose permission projection is EMPTY blocks actuation rather than producing no
// demand. Those are different states: "this effect needs nothing" would admit the effect with no
// grant at all, which is the fail-open an empty list quietly performs.
type DemandProjection
  = DemandDerived { cells: List<gunbc.spark_bootstrap_provision.ExternalAccessDemand> }
  | DemandIncomplete { step: std.types.NonEmptyStr, operation: v2.std.operation_argv.OperationRef, cause: std.types.NonEmptyStr }

fn spark_demand_for_selected(
  selected: gunbc.spark_bootstrap_provision.SelectedSparkEffect,
  executor: gunbc.spark_bootstrap_provision.FleetCloudPrincipalKey,
  context: gunbc.spark_bootstrap_provision.SparkCloudContext
) -> gunbc.spark_bootstrap_provision.DemandProjection {
  let op = secret_manager_effect_operation(e: selected.effect)
  let perms = secret_manager_effect_required_permissions(e: selected.effect)
  if count(perms) == 0 {
    DemandIncomplete {
      step: selected.step,
      operation: op,
      cause: "no extdeps permission mapping for this operation; actuation is blocked rather than admitted with an empty requirement"
    }
  } else {
    DemandDerived {
      cells: fold(perms, init: no_access_demand, f: (acc, p) =>
        acc |> list_push(ExternalAccessDemand {
          source_effect: selected.step,
          executor: executor,
          invocation: op,
          permission: p as std.types.NonEmptyStr,
          resource: secret_manager_effect_resource(e: selected.effect),
          context: context
        }))
    }
  }
}

// Fold a selected plan into its exact demand population. A step whose projection is incomplete
// refuses the WHOLE derivation rather than contributing nothing and letting the rest look
// complete -- a partial demand population read as total is how an ungranted effect slips through.
fn spark_plan_demand(
  selected: List<gunbc.spark_bootstrap_provision.SelectedSparkEffect>,
  executor: gunbc.spark_bootstrap_provision.FleetCloudPrincipalKey,
  context: gunbc.spark_bootstrap_provision.SparkCloudContext
) -> gunbc.spark_bootstrap_provision.DemandProjection {
  fold(selected, init: DemandDerived { cells: no_access_demand }, f: (acc, sel) =>
    match acc {
      DemandIncomplete { step: st, operation: o, cause: c } => DemandIncomplete { step: st, operation: o, cause: c }
      DemandDerived { cells: got } =>
        match spark_demand_for_selected(selected: sel, executor: executor, context: context) {
          DemandIncomplete { step: st, operation: o, cause: c } => DemandIncomplete { step: st, operation: o, cause: c }
          DemandDerived { cells: more } =>
            DemandDerived { cells: fold(more, init: got, f: (inner, c) => inner |> list_push(c)) }
        }
    })
}

// THE CEILING IS NORMATIVE AND SEPARATE. Derived demand says what the code will request; it never
// says what is allowed. A selected DestroyVersion produces a real demand cell AND is refused here,
// which is the whole point: adding a dangerous call to the workflow must not authorize it.
fn spark_demand_decision(demand: gunbc.spark_bootstrap_provision.ExternalAccessDemand) -> std.access.AccessDecision {
  if !principal_role_admits_operation_ref(principal: demand.executor, op: demand.invocation) {
    Deny { refusal: std.access.AccessRefusal {
      cause: std.access.AccessSubjectNotRecognized { subject: "operation outside this principal's role ceiling; no binding can admit it" },
      location: std.access.AccessRefusalLocation {
        profile: "spark_access_demand",
        subject: spark_principal_label(principal: demand.executor),
        action: demand.invocation.operation,
        object: demand.resource as String } } }
  } else {
    Permit
  }
}


// THE CEILING, KEYED ON THE REAL OPERATION IDENTITY. This is now the authority; the
// SecretManagerOperation-keyed function below delegates to it and is a shrinking shim.
//
// Naming the operations as strings HERE is not the roster this lane deleted: these are the
// normative policy rows -- which operations a principal may ever reach -- and policy is authored
// by definition. What must never be authored is the DEMAND (what the code needs), and that now
// derives from the selected effects via the extdeps OperationRef.
//
// An operation this policy has no row for is REFUSED, not admitted: a new Secret Manager
// operation must be ruled on before any principal can reach it.
fn principal_role_admits_operation_ref(principal: gunbc.spark_bootstrap_provision.FleetCloudPrincipalKey, op: v2.std.operation_argv.OperationRef) -> Bool {
  match principal {
    FleetCloudConvergencePrincipal { role: _ } =>
      op.operation == "AccessVersion" || op.operation == "AddVersion" || op.operation == "GetSecret"
    FleetCloudGrantAdministratorPrincipal { role: _ } =>
      op.operation == "GetSecretIamPolicy" || op.operation == "SetSecretIamPolicy" || op.operation == "GetSecret"
  }
}

// ── Secret demand: derived from consumers, not from a fixed denominator ────────────────────
// THE FOUR-CREDENTIAL POPULATION IS NOT A DEMAND POPULATION. spark_credential_population is a
// roster of credentials that could exist for a host; it says nothing about whether any workflow
// still needs one. Treating it as demand made a post-OOBE factory hotspot credential an automatic
// blocker on serving, because "four occurrences, none allocated" reads as four outstanding
// obligations regardless of whether anything consumes them.
//
// Demand comes from a CONSUMER: a named workflow that will actually read or write the credential,
// and the operation it will use. A credential with no active consumer creates no access demand and
// no routine grant -- it is retained for recovery, retired, or unobserved, and each of those is a
// different standing with a different remedy.
type SecretConsumer {
  consumer: std.types.NonEmptyStr
  operation: v2.std.operation_argv.OperationRef
}

type SecretDemandStanding
  = SecretDemandActive { secret: std.types.NonEmptyStr, consumers: List<gunbc.spark_bootstrap_provision.SecretConsumer> }
  | SecretDemandRetainedForRecovery { secret: std.types.NonEmptyStr, recovery_consumer: std.types.NonEmptyStr }
  | SecretDemandRetiredAfterOobe { secret: std.types.NonEmptyStr, reason: std.types.NonEmptyStr }
  | SecretDemandUnobserved { secret: std.types.NonEmptyStr, cause: std.types.NonEmptyStr }

// Only an ACTIVE standing yields routine access demand. Retained-for-recovery is deliberately not
// active: a recovery credential is reachable by an explicit recovery workflow, not by the standing
// grant every serving run carries, which is what keeps a break-glass credential from being live
// authority in the ordinary path.
fn secret_demand_is_active(standing: gunbc.spark_bootstrap_provision.SecretDemandStanding) -> Bool {
  match standing {
    SecretDemandActive { secret: _, consumers: cs } => count(cs) > 0
    SecretDemandRetainedForRecovery { secret: _, recovery_consumer: _ } => false
    SecretDemandRetiredAfterOobe { secret: _, reason: _ } => false
    SecretDemandUnobserved { secret: _, cause: _ } => false
  }
}

// An ACTIVE standing with an empty consumer list is a contradiction, not an active demand: it
// claims consumers exist while naming none. secret_demand_is_active refuses it above rather than
// letting the arm's NAME stand in for the fact.
data spark_secret_demand_note: String = "Demand is derived from named consumers and the operation each will perform, never from the credential roster. The factory hotspot credential is RetiredAfterOobe on both Sparks -- both machines are past out-of-box setup, so no selected workflow reads it -- and it therefore creates no access demand and cannot block serving. The administrator credential is RetainedForRecovery: reachable by an explicit recovery or rotation workflow, not by the standing grant a serving run carries. The fleet SSH key is Active with the managed host-access convergence executor as its consumer. The serving API credential's standing is Unobserved rather than assumed: the pinned artifact and its acquisition path are not yet selected, and authoring an Active row for it would fabricate a consumer that does not exist in any plan."

// SERVING INSTALL SCOPE IS DERIVED FROM OBSERVED PRIVILEGE, NEVER CHOSEN.
//
// srv5 was measured before anything was installed: `sudo -n` refuses, and the container socket
// refuses the admitted principal. Those are not two independent limitations -- they are ONE cause
// with two consequences, because both a system unit and a container require an escalation this
// principal does not hold. What remains is user scope.
//
// This is modeled as a derivation rather than recorded as a scope because an unexplained scope
// invites a later reader to "upgrade" it to a system unit, which silently reintroduces the
// out-of-band human step the workflow path exists to eliminate. Stated as a consequence, that
// upgrade is visibly a change to the OBSERVATION -- it requires granting privilege first.
type HostPrivilegeObservation {
  host: std.types.NonEmptyStr
  passwordless_sudo: Bool
  container_socket_admits_principal: Bool
}

// UserUnitScope carries its ground so the reason travels with the decision. InstallScopeUnobserved
// is a distinct arm because "we did not measure privilege" and "we measured it and found none" are
// different states with different remedies -- collapsing them would let an unmeasured host default
// into user scope and read as derived when nothing was observed.
type ServiceInstallScope
  = SystemUnitScope { host: std.types.NonEmptyStr }
  | ContainerScope { host: std.types.NonEmptyStr }
  | UserUnitScope { host: std.types.NonEmptyStr, ground: std.types.NonEmptyStr }
  | InstallScopeUnobserved { host: std.types.NonEmptyStr, cause: std.types.NonEmptyStr }

fn derive_install_scope(observation: gunbc.spark_bootstrap_provision.HostPrivilegeObservation) -> gunbc.spark_bootstrap_provision.ServiceInstallScope {
  if observation.passwordless_sudo {
    SystemUnitScope { host: observation.host }
  } else {
    if observation.container_socket_admits_principal {
      ContainerScope { host: observation.host }
    } else {
      UserUnitScope {
        host: observation.host,
        ground: "passwordless sudo refused and container socket refused the admitted principal; both closures share one cause, so user scope is what remains" as std.types.NonEmptyStr,
      }
    }
  }
}

// The srv5 observation as measured on 2026-08-10 through the read-only canary probe, before any
// mutation. It is an observation row: a later host with different privilege derives a different
// scope from the same function, which is the point of deriving rather than declaring.
fn srv5_privilege_observation() -> gunbc.spark_bootstrap_provision.HostPrivilegeObservation {
  HostPrivilegeObservation {
    host: "srv5" as std.types.NonEmptyStr,
    passwordless_sudo: false,
    container_socket_admits_principal: false,
  }
}

