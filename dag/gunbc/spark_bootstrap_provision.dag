module gunbc.spark_bootstrap_provision

// THE PRODUCER for the Spark bootstrap secrets. gunbc.spark_bootstrap_credential names two
// SecretRefs and records that nothing creates them; this module is the thing that creates them,
// so that the refs become materialized by an APPLY rather than by a human opening a console and
// pasting a password into a form. That distinction is the whole point: a hand-placed secret has
// no receipt, no idempotence, and no readback, and the srv4 subsumption session is the record of
// what that costs.
//
// Shape is taken verbatim from gunbc.assimilate.bmc_bootstrap_provision, which is proven live
// against this same project. Only the resources differ. What deliberately does NOT match is token
// acquisition: the BMC pattern calls shell.GCloud.AuthPrintAccessToken() directly and carries a
// marked fork for it, so copying that call would have minted a THIRD authority for one concept.
// This pattern takes the resolved token as a parameter, which is what
// gunbc.auth.access_token_source.ensure_access_token already returns.

data spark_provision_authority_note: String = "Three operations, three different idempotence characters, kept in separate patterns rather than behind one convenient verb. MEASURED, not assumed: CreateSecret does NOT converge at this seam — a second run answers HTTP 409 ALREADY_EXISTS and the pattern fails, because 409 is a declared error response and nothing here turns it into a success. An earlier revision of this note claimed the opposite ('a second run answers 409 and the desired state is reached either way'), which was an assertion about the API written without executing the re-run; the re-run was then executed and refuted it. AddVersion does not converge either, for a different reason: every call mints a new version, so a retry sprawls versions rather than settling, which is the property gunbc.auth.secret_rotation names. SetSecretIamPolicy DOES converge — it sets a policy to a desired value, so repeating it is a no-op on an already-correct binding. That asymmetry is why IAM convergence is its own pattern: bundling it behind CreateSecret meant a re-run died on 409 before reaching the bindings, so drifted bindings were unrepairable by re-running the only thing that set them. The container create is therefore a ONE-SHOT with a typed failure on re-run, and binding convergence is separately re-runnable."

// 🟡 dissolve-on: spark_secret_containers_create is one-shot rather than convergent — a re-run
// fails on 409 ALREADY_EXISTS instead of classifying 'already present' as the desired state
// reached. The rung here is mitigatable (the failure is typed, located, and loud; it cannot
// silently double-create) and NOT mechanically preventable, because nothing stops a caller
// re-running it and taking the abort. DISSOLVES WHEN the create routes through an upsert
// classification that reads 409 as Converged/Noop the way gunbc.auth.access_token_source
// classifies its ensure, at which point this pattern and spark_secret_iam_converge can rejoin.
// Next-rung trigger named rather than left implicit, per the guarantee ladder's no-untracked-stall
// obligation.
data spark_container_create_not_convergent_dissolve_on: String = "🟡 dissolve-on: spark_secret_containers_create aborts on HTTP 409 ALREADY_EXISTS rather than classifying an existing secret as the desired state reached. DISSOLVES WHEN CreateSecret dispatch routes through an UpsertClassification that maps 409 to Noop, letting create and IAM convergence rejoin into one re-runnable pattern. Measured on 2026-08-09: first apply returned both secret names and both binding etags; immediate reapply failed with 409 on the first secret."

data spark_hotspot_secret_id: NonEmptyStr = "spark-hotspot-password"
data spark_administrator_secret_id: NonEmptyStr = "spark-administrator-password"

// The two secrets the bootstrap actually needs, as the names the store will carry. They are
// separate secrets rather than two versions of one because they are two different credentials with
// different lifetimes: the hotspot password is a factory-network fact that dies when the Spark
// joins the fleet network, and the administrator password outlives it.
data spark_bootstrap_secret_ids: List<NonEmptyStr> = [
  spark_hotspot_secret_id,
  spark_administrator_secret_id
]

// Least privilege, and the same two roles the BMC secret carries: read the version, and add a
// version. Neither role can delete a secret or read any OTHER secret in the project, because the
// binding is set on the secret RESOURCE rather than on the project.
fn spark_secret_iam_bindings() -> List<GcpBinding> {
  [
    GcpBinding {
      role: role_secretmanager_secret_accessor,
      members: [bmc_assimilator_sa_member()]
    },
    GcpBinding {
      role: role_secretmanager_secret_version_adder,
      members: [bmc_assimilator_sa_member()]
    }
  ]
}

// Create the CONTAINERS only. No payload crosses this pattern, so it needs no credential material
// at all — only the admin token — and an operator can apply it before the Spark passwords exist.
// ONE-SHOT: see spark_container_create_not_convergent_dissolve_on. A re-run against existing
// secrets fails loudly on 409 rather than doing anything silent, which is the acceptable form of
// this deficit; the unacceptable form would be swallowing the 409 and reporting success.
pattern spark_secret_containers_create(access_token: Secret) -> {
  hotspot_name: String,
  administrator_name: String
}
  uses net: std.resources.Network
{
  node hotspot: gcp.SecretManager.CreateSecret(
    access_token: access_token,
    project_id: bmc_secrets_project_id,
    secret_id: spark_hotspot_secret_id
  )

  node administrator: gcp.SecretManager.CreateSecret(
    access_token: access_token,
    project_id: bmc_secrets_project_id,
    secret_id: spark_administrator_secret_id
  )

  return {
    hotspot_name: hotspot.name,
    administrator_name: administrator.name
  }
}

// Converge the BINDINGS. Separated from creation because SetSecretIamPolicy sets a policy to a
// desired value and is therefore genuinely re-runnable, while creation is not. Keeping them in one
// pattern made the convergent half unreachable on any host where the containers already existed,
// which is every host after the first apply — so the only operation that could repair drifted
// least-privilege bindings was gated behind an operation guaranteed to abort.
//
// MEASURED, and stated at the strength the measurement supports: re-running this against secrets
// that already carry the correct bindings SUCCEEDS and leaves the binding content byte-identical.
// It is NOT a no-op — the policy etag advances on every run, because this writes the desired policy
// rather than comparing first and skipping. Re-runnable and idempotent-in-result is the claim;
// idempotent-in-effect is not, and a caller reasoning about write volume or audit-log noise needs
// the difference. Receipt 2026-08-09: etags moved BwZYnwVip+g= -> BwZYny9Ox7I= and
// BwZYnwVp5OE= -> BwZYny9WBCY= while both secrets kept exactly secretAccessor + secretVersionAdder
// for the assimilator service account.
pattern spark_secret_iam_converge(access_token: Secret) -> {
  hotspot_binding_etag: String,
  administrator_binding_etag: String
}
  uses net: std.resources.Network
{
  node hotspot_bind: gcp.SecretManager.SetSecretIamPolicy(
    access_token: access_token,
    project_id: bmc_secrets_project_id,
    secret: spark_hotspot_secret_id,
    bindings: spark_secret_iam_bindings()
  )

  node administrator_bind: gcp.SecretManager.SetSecretIamPolicy(
    access_token: access_token,
    project_id: bmc_secrets_project_id,
    secret: spark_administrator_secret_id,
    bindings: spark_secret_iam_bindings()
  )

  return {
    hotspot_binding_etag: hotspot_bind.ok_etag,
    administrator_binding_etag: administrator_bind.ok_etag
  }
}

// Write the MATERIAL, and read back the exact version that was written. The payloads are
// PARAMETERS and never data rows: a credential authored into this file would be a credential
// published to everyone who can read the repository, which is the one outcome the whole secret
// boundary exists to prevent.
//
// The readback names the version it verifies rather than reading `latest`. That is not caution
// about the store — it is that `latest` is a moving alias, so a success proved through it is
// compatible with some other writer having landed a different version in between, and the receipt
// would then attest to a payload this run did not write.
pattern spark_secret_material_write(
  access_token: Secret,
  hotspot_name: String,
  administrator_name: String,
  hotspot_payload_b64: String,
  administrator_payload_b64: String
) -> {
  hotspot_version: SmResolvedVersionIdentity,
  administrator_version: SmResolvedVersionIdentity
}
  uses net: std.resources.Network
{
  node hotspot_v: gcp.SecretManager.AddVersion(
    access_token: access_token,
    secret_name: hotspot_name,
    payload_b64: hotspot_payload_b64
  )

  node administrator_v: gcp.SecretManager.AddVersion(
    access_token: access_token,
    secret_name: administrator_name,
    payload_b64: administrator_payload_b64
  )

  return {
    hotspot_version: hotspot_v.name,
    administrator_version: administrator_v.name
  }
}
