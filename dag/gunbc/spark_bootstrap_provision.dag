module gunbc.spark_bootstrap_provision

import std.access {
  AccessDecision, Permit, Deny, decision_meet,
  AccessRefusal, AccessRefusalLocation,
  AccessActionNotGranted, AccessObjectNotGranted, AccessEvidenceAbsent, AccessSubjectNotRecognized
}

// The Spark bootstrap credential population, as convergence subjects rather than as callable
// mutation tools. An earlier revision of this module carried two patterns that dispatched
// CreateSecret / SetSecretIamPolicy / AddVersion unconditionally from whatever process invoked
// them. Those are deleted here rather than kept beside the model, because a pattern that mutates
// a cloud resource with no observe step, no membership diff, no attempt identity and no
// independent readback is not a convergence member — it is a terminal tool, and leaving it
// callable is what made the manual apply possible in the first place.
//
// What this module now owns: the exact credential population, the allocation of an external
// secret handle to each occurrence, and the classification of the two containers that already
// exist in Secret Manager. What it deliberately does NOT own: actuation. The cloud executor is
// the OIDC/WIF-authenticated workflow, and it consumes this model.

data spark_provision_scope_note: String = "This module models subjects and allocations; it does not actuate. The prior revision's spark_secret_containers_create / spark_secret_iam_converge / spark_secret_material_write patterns were deleted rather than repaired in place, because each was unconditional: create with no prior Get, SetIamPolicy with no GetIamPolicy and no etag (which REPLACES a policy rather than amending it, so unrelated bindings on any secret that had them would have been dropped), and AddVersion with no attempt identity (which mints a version per call, so an interrupted run sprawls). Repairing them as patterns would have preserved the shape whose availability was the defect."

// ── The population ────────────────────────────────────────────────────────────────────────
// FOUR occurrences, not two. An earlier revision carried two global secret ids -- one hotspot,
// one administrator -- which cannot represent this population: the factory hotspot value differs
// per device (the two SSIDs are distinct rows in gunbc.spark_bootstrap_credential), so one global
// hotspot secret would have to hold two different credentials, and because AddVersion never
// overwrites, the second write would silently become a new version of the first rather than a
// separate credential. This is the same host-scope error the POSIX principal split already fixed
// one carrier over: an account is per host, and so is a bootstrap credential.

type SparkCredentialKind
  = FactoryHotspotCredential
  | AdministratorCredential

type SparkCredentialOccurrence {
  host: HostIdentity
  kind: SparkCredentialKind
}

fn spark_srv5() -> HostIdentity { "srv5" }
fn spark_srv6() -> HostIdentity { "srv6" }

fn spark_credential_occurrence(host: HostIdentity, kind: SparkCredentialKind) -> SparkCredentialOccurrence {
  SparkCredentialOccurrence { host: host, kind: kind }
}

fn spark_credential_population() -> List<SparkCredentialOccurrence> {
  [
    SparkCredentialOccurrence { host: spark_srv5(), kind: FactoryHotspotCredential },
    SparkCredentialOccurrence { host: spark_srv5(), kind: AdministratorCredential },
    SparkCredentialOccurrence { host: spark_srv6(), kind: FactoryHotspotCredential },
    SparkCredentialOccurrence { host: spark_srv6(), kind: AdministratorCredential }
  ]
}

fn spark_occurrence_eq(a: SparkCredentialOccurrence, b: SparkCredentialOccurrence) -> Bool {
  a.host == b.host && spark_credential_kind_eq(a: a.kind, b: b.kind)
}

fn spark_credential_kind_is_hotspot(k: SparkCredentialKind) -> Bool {
  match k {
    FactoryHotspotCredential => true
    AdministratorCredential => false
  }
}

fn spark_credential_kind_eq(a: SparkCredentialKind, b: SparkCredentialKind) -> Bool {
  spark_credential_kind_is_hotspot(k: a) == spark_credential_kind_is_hotspot(k: b)
}

// ── The external handle ───────────────────────────────────────────────────────────────────
// A Secret Manager resource name is an ALLOCATED external handle for an occurrence. It is not
// the occurrence identity, and it must not be reverse-parsed to recover the host or the kind.
// gunbc.spark_bootstrap_credential already settled the naming law this obeys -- names are
// carried, never computed from a rendered HostIdentity -- because a computed name makes the
// secret namespace a function of how a host happens to be spelled today.
//
// No allocation has been made for any of the four occurrences, and Pending is therefore the only
// honest arm. Authoring four plausible ids here would be exactly the fabrication the naming law
// forbids: a name nobody allocated, asserted as though it referred to something.
type SparkSecretAllocation
  = SparkSecretAllocated { occurrence: SparkCredentialOccurrence, handle: NonEmptyStr }
  | SparkSecretAllocationPending { occurrence: SparkCredentialOccurrence }

fn spark_secret_allocation(occurrence: SparkCredentialOccurrence) -> SparkSecretAllocation {
  SparkSecretAllocationPending { occurrence: occurrence }
}

// ── The two containers that already exist ─────────────────────────────────────────────────
// Created 2026-08-09 by an interactive apply that this module no longer admits. They are real
// starting-state observations and they are NOT accepted convergence output, so they are named as
// legacy state rather than adopted as the authority for any occurrence. In particular the single
// hotspot container cannot be the authority for a hotspot credential, because there are two
// distinct factory values and it can hold only one of them without the other becoming a silent
// prior version.
//
// They are not edited or deleted from here. Retirement runs through the same convergence workflow
// once the four correct resources exist and no consumer references these.
type SparkLegacyContainerStanding
  = ObservedLegacyUnbound { handle: NonEmptyStr }

data spark_legacy_hotspot_container: SparkLegacyContainerStanding = ObservedLegacyUnbound { handle: "spark-hotspot-password" }

data spark_legacy_administrator_container: SparkLegacyContainerStanding = ObservedLegacyUnbound { handle: "spark-administrator-password" }

data spark_legacy_containers: List<SparkLegacyContainerStanding> = [
  spark_legacy_hotspot_container,
  spark_legacy_administrator_container
]

data spark_legacy_container_note: String = "Two containers exist in gunbai-secrets from an interactive apply on 2026-08-09, each carrying secretAccessor + secretVersionAdder for the BMC assimilator service account. They classify ObservedLegacyUnbound: real observations of starting state, not accepted output, and not the authority for any occurrence. Neither carries a version -- no payload was ever written -- so nothing depends on them. Two independent reasons they cannot simply be adopted: the population is four and these are two, and the principal bound on them is the BMC assimilator, which is the wrong authority per spark_cloud_principal_note."

// ── The principal ─────────────────────────────────────────────────────────────────────────
// The deleted patterns granted access to the BMC assimilator service account. That was a
// cross-domain privilege expansion, not a convenient reuse: that principal is declared as a BMC
// assimilator scoped to the srv3 BMC secret, so binding it to Spark bootstrap credentials makes
// BMC assimilation the authority for Spark provisioning. It is also the nickname trap in its
// usual form -- one identity acquiring a second meaning because it happened to be nearby.
//
// The replacement is a semantic identity for the fleet's cloud convergence executor. It carries
// no allocated service-account handle yet, and the pending arm is the honest state: allocating
// one is a cloud mutation, which is precisely what this module no longer performs.
// ── The principal, and what is actually known about it ────────────────────────────────────
// The semantic identity is stable; the service-account email is an ALLOCATION with its own
// observation standing. An earlier revision fused them and returned Allocated while its own note
// said the allocation was not independently verified. Those two statements cannot coexist: the
// carrier reported a rung its evidence did not establish, which is the inflation this project
// forbids -- and it was mine, in the same commit that recorded the evidence as second-hand.
// Until the WIF workflow reads it back, Reported is the honest arm.
type FleetCloudConvergence {}

type FleetCloudPrincipalKey = FleetCloudConvergence

type FleetCloudPrincipalAllocationStanding
  = CloudPrincipalUnallocated { principal: FleetCloudPrincipalKey }
  | CloudPrincipalReported { principal: FleetCloudPrincipalKey, reported_member: String, source: NonEmptyStr }
  | CloudPrincipalAllocated { principal: FleetCloudPrincipalKey, member: String, readback: NonEmptyStr }

fn fleet_cloud_principal_standing() -> FleetCloudPrincipalAllocationStanding {
  CloudPrincipalReported {
    principal: FleetCloudConvergence {},
    reported_member: "serviceAccount:fleet-cloud-convergence@gunbai-secrets.iam.gserviceaccount.com",
    source: "witty-raven-412 msg_1e6d1b42; not read back by this session"
  }
}

// ── Domain operations, projected into the one kernel ──────────────────────────────────────
// The Secret Manager operation population is a domain fact and belongs here. The DECISION is not:
// std.access.AccessDecision is the only admitted/refused sum, and decision_meet the only
// conjunction, so this module mints neither.
type SecretManagerOperation
  = SmGetSecret
  | SmGetIamPolicy
  | SmSetIamPolicy
  | SmAddVersion
  | SmAccessVersion
  | SmDisableVersion
  | SmDestroyVersion

fn sm_operation_rank(op: SecretManagerOperation) -> Int {
  match op {
    SmGetSecret => 1
    SmGetIamPolicy => 2
    SmSetIamPolicy => 3
    SmAddVersion => 4
    SmAccessVersion => 5
    SmDisableVersion => 6
    SmDestroyVersion => 7
  }
}

fn sm_operation_eq(a: SecretManagerOperation, b: SecretManagerOperation) -> Bool {
  sm_operation_rank(op: a) == sm_operation_rank(op: b)
}

// ── Scope, and whether it moves ───────────────────────────────────────────────────────────
// FrozenAtGrant is load-bearing: "global over the current Spark population" must not silently mean
// that a machine added tomorrow inherits today's authority. Adding srv7 widens a grant only where
// the policy says TracksNamespaceMembership.
type AccessScopeEvolution
  = FrozenAtGrant
  | TracksNamespaceMembership

type SparkCloudScope {
  resources: List<NonEmptyStr>
  evolution: AccessScopeEvolution
}

type SparkCloudGrant {
  principal: FleetCloudPrincipalKey
  operations: List<SecretManagerOperation>
  scope: SparkCloudScope
}

// An exact cell: one principal, one operation, one resource. Replaces a global present/absent
// standing, which could not answer which operation on which resource -- so "the principal is
// bound" read as coverage while naming nothing.
type AccessGrantCell {
  operation: SecretManagerOperation
  resource: NonEmptyStr
}

type AccessGrantCellStanding
  = GrantCellPresent { cell: AccessGrantCell }
  | GrantCellAbsent { cell: AccessGrantCell }
  | GrantCellUnobserved { cell: AccessGrantCell }

fn spark_scope_admits(scope: SparkCloudScope, resource: NonEmptyStr) -> Bool {
  fold(scope.resources, init: false, f: (acc, r) => acc || r == resource)
}

fn spark_grant_admits_operation(grant: SparkCloudGrant, op: SecretManagerOperation) -> Bool {
  fold(grant.operations, init: false, f: (acc, o) => acc || sm_operation_eq(a: o, b: op))
}

// The projection. Two independent refusal coordinates -- action and object -- so an operation the
// grant never carried and a resource outside scope are different denials, not one blurred no.
fn spark_cloud_grant_decision(grant: SparkCloudGrant, cell: AccessGrantCell) -> AccessDecision {
  if !spark_grant_admits_operation(grant: grant, op: cell.operation) {
    Deny { refusal: AccessRefusal {
      cause: AccessActionNotGranted { action: "operation outside the granted population" },
      location: AccessRefusalLocation {
        profile: "spark_cloud_grant", subject: "FleetCloudConvergence",
        action: "secret-manager-operation", object: cell.resource as String } } }
  } else {
    if !spark_scope_admits(scope: grant.scope, resource: cell.resource) {
      Deny { refusal: AccessRefusal {
        cause: AccessObjectNotGranted { object: "resource outside the granted scope" },
        location: AccessRefusalLocation {
          profile: "spark_cloud_grant", subject: "FleetCloudConvergence",
          action: "secret-manager-operation", object: cell.resource as String } } }
    } else {
      Permit
    }
  }
}

// Actuation additionally requires the principal to be independently observed. A Reported principal
// is a claim about the cloud nobody in this run verified, so it cannot authorize an effect -- and
// this is where decision_meet does the conjoining rather than a second fold.
fn spark_principal_decision(standing: FleetCloudPrincipalAllocationStanding) -> AccessDecision {
  match standing {
    CloudPrincipalAllocated { principal: _, member: _, readback: _ } => Permit
    CloudPrincipalReported { principal: _, reported_member: _, source: _ } =>
      Deny { refusal: AccessRefusal {
        cause: AccessEvidenceAbsent { evidence: "principal allocation is externally reported and not read back by this run" },
        location: AccessRefusalLocation {
          profile: "spark_cloud_principal", subject: "FleetCloudConvergence",
          action: "actuate", object: "spark-cloud-population" } } }
    CloudPrincipalUnallocated { principal: _ } =>
      Deny { refusal: AccessRefusal {
        cause: AccessSubjectNotRecognized { subject: "no allocated cloud principal" },
        location: AccessRefusalLocation {
          profile: "spark_cloud_principal", subject: "FleetCloudConvergence",
          action: "actuate", object: "spark-cloud-population" } } }
  }
}

fn spark_actuation_decision(
  standing: FleetCloudPrincipalAllocationStanding,
  grant: SparkCloudGrant,
  cell: AccessGrantCell
) -> AccessDecision {
  decision_meet(
    a: spark_principal_decision(standing: standing),
    b: spark_cloud_grant_decision(grant: grant, cell: cell))
}

data spark_access_adapter_note: String = "This module is an ADAPTER, not an access system. It supplies the domain operation population, the resource identity and the scope rows; std.access supplies AccessRequest, AccessDecision, the typed refusal coordinates and decision_meet. No second admitted/refused sum is minted here. Independence is a property of the grant -- principal x operation x resource x context -- and never of a username, a uid, a service-account count, or how many credential values happen to exist. Two passwords under one project-wide binding are not independent access; one short-lived token over two exact resources may be far tighter."

// ── The convergence shape this model is consumed by ───────────────────────────────────────
// Declared as the required sequence rather than implemented as callable mutation, because the
// executor is the OIDC/WIF workflow. Each arm names why it exists.
//
//   observe container        Get before Create. Absent -> create then read back the exact
//                            resource; matching -> Noop; conflicting -> Refuse with the exact
//                            differences; unreadable -> Refuse. Never "call Create and read 409
//                            as already-done", which is what the prior revision did and what its
//                            own measured receipt refuted.
//
//   reconcile IAM            GetIamPolicy -> membership diff -> preserve unrelated admitted
//                            bindings -> amend only owned members -> SetIamPolicy carrying the
//                            observed etag -> GetIamPolicy readback. The etag is not politeness:
//                            setIamPolicy replaces the policy, so a blind write drops bindings it
//                            never saw, and a concurrent update overwrites silently without the
//                            read-modify-write cycle.
//
//   materialize              At most one AddVersion per attempt identity. A durable receipt names
//                            the exact version created, so an interrupted run resumes by
//                            ACCESSING that version rather than minting another. Never retry
//                            AddVersion because a process outcome was lost -- a lost outcome is
//                            not evidence the write did not land.
//
//   read back                A separate AccessVersion against the exact recorded version,
//                            compared by payload identity. The writer reporting its own returned
//                            value is not a readback, and `latest` is a moving alias that cannot
//                            witness which version this run wrote.
data spark_convergence_shape_note: String = "observe container (Get before Create; absent/matching/conflicting/unreadable are four distinct verdicts) -> reconcile IAM (GetIamPolicy, membership diff, preserve unrelated bindings, SetIamPolicy with observed etag, readback) -> materialize (at most one AddVersion per attempt identity, receipt naming the exact version) -> independent readback (AccessVersion at that exact version, compared by payload identity). Secret material never crosses a string-shaped CLI boundary: base64 is wire encoding, not confidentiality, and gunbc.spark_bootstrap_credential's sensitive-input policy already refuses secrets appearing in argv or standard streams. Material is generated or fetched inside the admitted run and projected to base64 at the REST boundary."

data spark_provision_frontier_note: String = "NOT BUILT, and named so the absence is countable rather than implied: the four secret allocations, the container observe/classify operation, the IAM membership diff, the materialization attempt identity and receipt, the independent payload-identity readback, the allocated fleet cloud-convergence principal, the shared GitHub-to-GCP federation authority, and the generated workflow that executes all of it under OIDC/WIF. Until those exist the Spark cloud population converges 0 of 4 occurrences, and the two existing containers do not reduce that number."

// ── Container observation: Get before Create ──────────────────────────────────────────────
// Four verdicts, because "absent", "already correct", "present but not ours to write into" and
// "could not be read" have four different remedies. The prior revision collapsed all of them into
// calling Create and reading a 409, which is the absorbing fallback in its cheapest form: an error
// arm standing in for an observation nobody made.

type SparkContainerObservation
  = SparkContainerAbsent
  | SparkContainerPresent { handle: NonEmptyStr, version_count: Int }
  | SparkContainerUnreadable { cause: NonEmptyStr }

type SparkContainerVerdict
  = SparkContainerCreateRequired
  | SparkContainerConverged { handle: NonEmptyStr }
  | SparkContainerConflicted { handle: NonEmptyStr, cause: NonEmptyStr }
  | SparkContainerRefused { cause: NonEmptyStr }

// A container that ALREADY carries a version is Conflicted, not Converged. Writing into it would
// make this run's credential a SECOND version of something nobody in this run authored, and
// because AddVersion never overwrites, the prior value stays live and accessible. Adopting it
// silently is how one occurrence ends up holding two different credentials.
fn classify_spark_container(
  allocation: SparkSecretAllocation,
  observation: SparkContainerObservation
) -> SparkContainerVerdict {
  match allocation {
    SparkSecretAllocationPending { occurrence: _ } =>
      SparkContainerRefused { cause: "occurrence has no allocated handle; there is nothing to observe by, and guessing a name is the fabrication the carried-never-derived law forbids" }
    SparkSecretAllocated { occurrence: _, handle: _ } =>
      match observation {
        SparkContainerAbsent => SparkContainerCreateRequired
        SparkContainerUnreadable { cause: c } => SparkContainerRefused { cause: c }
        SparkContainerPresent { handle: h, version_count: n } =>
          if n > 0 {
            SparkContainerConflicted { handle: h, cause: "container already carries a version this run did not write; AddVersion never overwrites, so writing here would leave two live credentials for one occurrence" }
          } else {
            SparkContainerConverged { handle: h }
          }
      }
  }
}

// ── IAM: membership diff, never a blind replace ───────────────────────────────────────────
// setIamPolicy REPLACES the policy rather than amending it, so the desired write is computed as a
// delta against an observed policy and unrelated bindings are carried through untouched. The
// owned-universe parameter is what makes "unrelated" decidable: a member outside it is preserved
// even when it is not desired, because this model does not own it and removing it would be acting
// outside our authority.

type SparkIamDelta {
  add: List<String>
  remove: List<String>
  preserve: List<String>
}

fn spark_member_in(m: String, xs: List<String>) -> Bool {
  fold(xs, init: false, f: (acc, x) => acc || x == m)
}

fn spark_iam_delta(
  observed: List<String>,
  desired_owned: List<String>,
  owned_universe: List<String>
) -> SparkIamDelta {
  SparkIamDelta {
    add: desired_owned |> filter(m => !spark_member_in(m: m, xs: observed)),
    remove: observed |> filter(m => spark_member_in(m: m, xs: owned_universe) && !spark_member_in(m: m, xs: desired_owned)),
    preserve: observed |> filter(m => !spark_member_in(m: m, xs: owned_universe))
  }
}

// The etag is not politeness. Without the observed etag a concurrent update is overwritten with no
// signal, so a write that cannot name the policy it read REFUSES rather than proceeding.
type SparkObservedEtag
  = SparkEtagObserved { etag: NonEmptyStr }
  | SparkEtagMissing

type SparkIamWriteAdmission
  = SparkIamWriteAdmitted { etag: NonEmptyStr, delta: SparkIamDelta }
  | SparkIamWriteRefused { cause: NonEmptyStr }

fn admit_spark_iam_write(observed_etag: SparkObservedEtag, delta: SparkIamDelta) -> SparkIamWriteAdmission {
  match observed_etag {
    SparkEtagMissing =>
      SparkIamWriteRefused { cause: "no observed etag; a policy write that cannot name the policy it read silently overwrites a concurrent update" }
    SparkEtagObserved { etag: e } => SparkIamWriteAdmitted { etag: e, delta: delta }
  }
}

// ── Materialization: at most one AddVersion per attempt identity ──────────────────────────
// AddVersion mints a version per call and never overwrites, so "retry because the last outcome was
// lost" is the one move that must be unreachable: a lost process outcome is not evidence the write
// did not land, and treating it as such sprawls versions for a single intended credential.

// The two occurrence kinds are NOT symmetric in where their material comes from, and this is the
// asymmetry the convergence shape's "generate or fetch inside the admitted run" does not cover. An
// administrator credential can be generated by the run. A FACTORY hotspot credential cannot: it is
// a value printed on the device, so there is nothing to generate and nothing to fetch it from. Its
// only honest source is an operator observation entering through the sensitive-input boundary.
type SparkMaterializationSource
  = GeneratedInRun { recipe: NonEmptyStr }
  | ObservedFromDevice { note: NonEmptyStr }

// A generated factory credential is a fabricated observation of physical hardware -- the value
// would be a plausible string that is not what is printed on the device, and every downstream
// check would pass while the credential was simply wrong. So the pairing is refused rather than
// documented.
type SparkSourceAdmission
  = SparkSourceAdmitted { source: SparkMaterializationSource }
  | SparkSourceRefused { cause: NonEmptyStr }

fn admit_spark_material_source(kind: SparkCredentialKind, source: SparkMaterializationSource) -> SparkSourceAdmission {
  match kind {
    AdministratorCredential => SparkSourceAdmitted { source: source }
    FactoryHotspotCredential =>
      match source {
        ObservedFromDevice { note: n } => SparkSourceAdmitted { source: ObservedFromDevice { note: n } }
        GeneratedInRun { recipe: _ } =>
          SparkSourceRefused { cause: "a factory hotspot credential is printed on the device and cannot be generated; generating one fabricates an observation of physical hardware that every downstream check would accept" }
      }
  }
}

type SparkMaterializationIdentity {
  occurrence: SparkCredentialOccurrence
  payload_identity: NonEmptyStr
}

type SparkReadbackVerdict
  = SparkReadbackMatched { version: NonEmptyStr }
  | SparkReadbackMismatched { version: NonEmptyStr }
  | SparkReadbackUnavailable { cause: NonEmptyStr }

type SparkMaterializationReceipt {
  identity: SparkMaterializationIdentity
  handle: NonEmptyStr
  exact_version: NonEmptyStr
  readback: SparkReadbackVerdict
}

// Three attempt states, because "never tried", "issued and unconfirmed" and "confirmed" have three
// different resolutions. The middle one is the whole point: it resolves by OBSERVING the store,
// never by issuing a second AddVersion.
type SparkAttemptRecord
  = SparkAttemptNone
  | SparkAttemptIssuedUnconfirmed { identity: SparkMaterializationIdentity }
  | SparkAttemptConfirmed { receipt: SparkMaterializationReceipt }

type SparkMaterializationDecision
  = SparkMaterializeOnce { identity: SparkMaterializationIdentity }
  | SparkMaterializeNoop { exact_version: NonEmptyStr }
  | SparkMaterializeObserveStore { identity: SparkMaterializationIdentity }
  | SparkMaterializeRefused { cause: NonEmptyStr }

fn decide_spark_materialization(record: SparkAttemptRecord) -> SparkMaterializationDecision {
  match record {
    SparkAttemptNone => SparkMaterializeRefused { cause: "no attempt identity supplied; a materialization without one cannot be resumed, because nothing distinguishes a retry from a first attempt" }
    SparkAttemptIssuedUnconfirmed { identity: i } => SparkMaterializeObserveStore { identity: i }
    SparkAttemptConfirmed { receipt: r } =>
      match r.readback {
        SparkReadbackMatched { version: v } => SparkMaterializeNoop { exact_version: v }
        SparkReadbackMismatched { version: v } => SparkMaterializeRefused { cause: "recorded version read back a payload identity that does not match what this attempt wrote; the stored credential is not the one this receipt claims" }
        SparkReadbackUnavailable { cause: c } => SparkMaterializeRefused { cause: c }
      }
  }
}

fn spark_materialize_once(identity: SparkMaterializationIdentity) -> SparkMaterializationDecision {
  SparkMaterializeOnce { identity: identity }
}

// The readback must name the version it verified. `latest` is a moving alias, so a success proved
// through it is compatible with another writer having landed a different version in between, and
// the receipt would then attest to a payload this run did not write.
fn admit_spark_readback_version(version: NonEmptyStr) -> SparkReadbackVerdict {
  if (version as String) == "latest" {
    SparkReadbackUnavailable { cause: "readback named the moving alias latest rather than an exact version; it cannot witness which version this run wrote" }
  } else {
    SparkReadbackMatched { version: version }
  }
}
