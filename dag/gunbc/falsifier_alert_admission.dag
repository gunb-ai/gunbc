module gunbc.falsifier_alert_admission

import std.types { NonEmptyStr, String }
import extdeps.github.actions { github_event_name_schedule, github_event_name_workflow_dispatch, workflow_run_activity_completed }
import extdeps.github.expressions {
  Expression, ContextAccess, StringLiteral, LogicalOr, LogicalAnd, Equals,
  Github, serialize_expression
}
import extdeps.github.workflow_run_event {
  WorkflowRunEvent,
  WorkflowRunEventObservation,
  WorkflowRunEventObserved,
  WorkflowRunEventMemberAbsent,
  WorkflowRunEventMemberMalformed,
  WorkflowRunEventMalformed,
  WorkflowRunEventPayloadReadRefused
}

data falsifier_alert_admission_purpose_note: String = "ALERT-1(c). THE PRE-EXECUTION TRUST WALL. This alert holds issues: write, so before it reads or acts on ANY content originating from an observed run it must establish that the run is the one it exists to observe. The threat is not exotic: workflow_run fires for runs of the named workflow on any branch and from any originating event, including one produced by a fork's pull request or an unapproved dispatch, and the alert then downloads an artifact from that run and renders its contents into an issue it has write access to. Without this wall, the content of an attacker-influenced run reaches a privileged writer.\n\nADMISSION IS THE CONJUNCTION OF FIVE FACTS, all of which must hold: the workflow is affected-set-falsifier, the repository is gunb-ai/gunbc, the head branch is main, the originating event is a schedule or an approved workflow_dispatch, and the activity is completed. Each is a separate coordinate and each refusal names which one failed — a single boolean 'not trusted' would tell an operator nothing about whether they are looking at a misconfiguration or an attack.\n\nIT IS TO BE ENFORCED TWICE, AND THAT IS NOT REDUNDANCY IN THE DESIGN §2 SENSE. NEITHER POINT IS WIRED YET: this change is ALERT-0..3 modeling and moves no behavior, so the live workflow still carries no job-level `if` and its embedded program does not call falsifier_alert_admit. Saying otherwise in the present tense is the rung inflation DESIGN §4b names — a carrier described by the guarantee it is designed to reach rather than the one it holds — and review 49460 caught this sentence doing exactly that. At cutover the generated workflow carries a job-level `if` derived from falsifier_alert_job_condition so the job does not start, and this program re-evaluates the same facts from the payload it reads itself. They are different mechanisms against different failure modes: the job-level guard is cheap and stops the runner from ever holding the token, but it is written in a foreign expression language and can be silently weakened by an edit to the workflow; the in-program check reads the payload the alert is actually about to act on, and so cannot be bypassed by a workflow edit. Neither subsumes the other, so neither is a second representation of the other — the shared authority is this module's predicate, which the workflow's condition is derived from."

data falsifier_alert_observed_workflow_name: NonEmptyStr = "affected-set-falsifier"

data falsifier_alert_workflow_identity_note: String = "THE TRIGGER MATCHES BY NAME BECAUSE THAT IS THE ONLY SHAPE GITHUB EXPOSES THERE; THE TRUST WALL DOES NOT. A workflow's display `name:` is a mutable string — it is whatever the `name:` key in the yaml says today, it is editable in any PR that touches the file, and two workflows may carry the same one. That is adequate as a coarse activation filter, where the cost of a wrong match is a job that starts and then refuses. It is NOT an identity for an authorization decision made by a program holding issues: write, because it means the answer to `is this the run I exist to observe` is decided by a renameable label.\n\nThe wall therefore also binds the workflow's FILE PATH, which is the stable identifier for `which workflow` — a workflow is the file, and renaming the display name does not move it. The path is checked in addition to, not instead of, the name: the name is what the trigger filtered on, so a mismatch between the two is itself a fact worth refusing on rather than silently preferring one. workflow_id (GitHub's numeric identifier for the workflow, stable across renames AND path moves) is decoded and carried so a future revision can pin it, but it is deliberately not compared yet: pinning it means writing a repository-specific integer into this module, which is a real fact that should be observed and recorded rather than typed from memory. Its dissolve-on is that observation."

data falsifier_alert_expected_workflow_path: NonEmptyStr = ".github/workflows/falsifier.yml"

data falsifier_alert_expected_repository: NonEmptyStr = "gunb-ai/gunbc"

data falsifier_alert_expected_head_branch: NonEmptyStr = "main"

data falsifier_alert_originating_event_note: String = "The admitted originating events are `schedule` and `workflow_dispatch`, and the workflow_dispatch arm carries a real caveat rather than being waved through. GitHub requires write access to dispatch a workflow, so a dispatch is already an authenticated act by someone with repository write — that is the sense in which it is `approved`, and it is the strongest statement this payload supports, because the event does not carry an approval record for the alert to verify independently. `push` and `pull_request` are deliberately NOT admitted even though the falsifier could in principle be triggered by them: a pull_request-originated run can carry a contributor's head, which is exactly the content this wall exists to keep away from a privileged writer, and a push-originated run is not part of the cadence this alert reports on. The head_branch check is a second, independent barrier on the same concern rather than a duplicate of it — an originating event can be legitimate while the head is not main, and a run on main can arrive from an event this alert should not report."

type RepositoryField
  = EnclosingRepository
  | HeadRepository

type FalsifierAlertAdmission
  = AlertAdmitted { event: WorkflowRunEvent }
  | AlertRefusedWorkflowNotObserved { observed: String, expected: NonEmptyStr }
  | AlertRefusedWorkflowPathNotObserved { observed: String, expected: NonEmptyStr }
  | AlertRefusedRepositoryNotOwned { field: RepositoryField, observed: String, expected: NonEmptyStr }
  | AlertRefusedHeadBranchNotMain { observed: String, expected: NonEmptyStr }
  | AlertRefusedOriginatingEventNotAdmitted { observed: String }
  | AlertRefusedActivityNotCompleted { observed: String, expected: String }
  | AlertRefusedEventUnreadable { observation: WorkflowRunEventObservation }

fn falsifier_alert_originating_event_admitted(event_name: String) -> Bool {
  event_name == github_event_name_schedule || event_name == github_event_name_workflow_dispatch
}

fn falsifier_alert_admit_event(event: WorkflowRunEvent) -> FalsifierAlertAdmission {
  if event.workflow_name != (falsifier_alert_observed_workflow_name as String) {
    AlertRefusedWorkflowNotObserved {
      observed: event.workflow_name,
      expected: falsifier_alert_observed_workflow_name
    }
  } else if event.workflow_path != (falsifier_alert_expected_workflow_path as String) {
    AlertRefusedWorkflowPathNotObserved {
      observed: event.workflow_path,
      expected: falsifier_alert_expected_workflow_path
    }
  } else if event.repository_full_name != (falsifier_alert_expected_repository as String) {
    AlertRefusedRepositoryNotOwned {
      field: EnclosingRepository,
      observed: event.repository_full_name,
      expected: falsifier_alert_expected_repository
    }
  } else if event.head_repository_full_name != (falsifier_alert_expected_repository as String) {
    AlertRefusedRepositoryNotOwned {
      field: HeadRepository,
      observed: event.head_repository_full_name,
      expected: falsifier_alert_expected_repository
    }
  } else if event.head_branch != (falsifier_alert_expected_head_branch as String) {
    AlertRefusedHeadBranchNotMain {
      observed: event.head_branch,
      expected: falsifier_alert_expected_head_branch
    }
  } else if !falsifier_alert_originating_event_admitted(event_name: event.originating_event) {
    AlertRefusedOriginatingEventNotAdmitted { observed: event.originating_event }
  } else if event.activity != workflow_run_activity_completed {
    AlertRefusedActivityNotCompleted {
      observed: event.activity,
      expected: workflow_run_activity_completed
    }
  } else {
    AlertAdmitted { event: event }
  }
}

data falsifier_alert_head_repository_note: String = "head_repository is checked against the SAME expected repository as the enclosing repository, and the two checks are not a copy of one another. `repository` is where the workflow run lives; `head_repository` is where the code it ran CAME FROM, and on a fork-originated run those differ — that divergence is precisely the fork case, and it is the one shape where an admitted-looking run carries foreign content. Checking only the enclosing repository would admit exactly that run. They share a refusal variant because the remedy is the same (this is not our code, stop), but the variant names WHICH coordinate failed through a RepositoryField discriminator rather than leaving it to be inferred from the observed value. review 49380 caught that an earlier revision claimed the observed value made them distinguishable, which was not true: a consumer holding only the observed string cannot tell a fork-originated run (head_repository diverged — the attack shape) from a plain wrong-repo delivery, and those are different incidents even though both stop. The field is the fact; the observed value is evidence for it."

fn falsifier_alert_admit(observation: WorkflowRunEventObservation) -> FalsifierAlertAdmission {
  match observation {
    WorkflowRunEventObserved { event: e } => falsifier_alert_admit_event(event: e)
    WorkflowRunEventMemberAbsent { member: _ } =>
      AlertRefusedEventUnreadable { observation: observation }
    WorkflowRunEventMemberMalformed { member: _, detail: _ } =>
      AlertRefusedEventUnreadable { observation: observation }
    WorkflowRunEventMalformed { detail: _ } =>
      AlertRefusedEventUnreadable { observation: observation }
    WorkflowRunEventPayloadReadRefused { path: _, cause: _ } =>
      AlertRefusedEventUnreadable { observation: observation }
  }
}

data falsifier_alert_no_bool_projection_note: String = "THERE IS DELIBERATELY NO falsifier_alert_is_admitted PREDICATE. An earlier revision carried one, and review 49400 was right to object: a Bool projection over FalsifierAlertAdmission throws away the located reason at exactly the boundary this module's purpose note argues it must be preserved, and once such a helper exists it is the convenient thing to reach for — a caller writes `if is_admitted` and the coordinate that failed is gone, which is the state this whole coproduct exists to prevent. Callers match on the admission and answer each arm; a caller that genuinely only needs a yes/no writes that match at its own use site, where the reason it is discarding is visible in the code discarding it."

data falsifier_alert_job_condition_note: String = "The generated workflow's job-level condition is DERIVED from this module's constants rather than hand-typed into the YAML, so the two enforcement points cannot drift apart in what they consider admissible. The condition can only express the subset of the wall that GitHub's expression language can see in the event context — workflow name, head branch and originating event — which is why it is the cheap outer guard and not the wall itself: head_repository and the activity are re-read from the payload by the program. A condition that could express everything would still not remove the in-program check, for the reason the purpose note gives.\n\nIT IS BUILT AS A TYPED extdeps.github.expressions Expression AND SERIALIZED, not concatenated as text (review 49400). The earlier revision assembled the condition by nesting concat over raw expression fragments, which is a foreign-language program in normal form authored outside the module that owns that language — precisely the ExecutableSourceString class gunbc.falsifier_alert_residue declares in this same change as the thing to shrink. Emitting new residue while declaring residue is the failure mode worth catching, and the fix is the ordinary one: the expression grammar already had a model, it was missing two operators, so the operators landed there and this site selects from them."

fn falsifier_alert_workflow_run_field(field: String) -> Expression {
  ContextAccess { context: Github, path: ["event", "workflow_run", field] }
}

data falsifier_alert_condition_distributed_note: String = "THE CONDITION IS BUILT IN DISTRIBUTED FORM — `A && B && schedule || A && B && dispatch` — rather than factored with a parenthesized alternation, and the repetition is deliberate. GitHub binds && tighter than ||, so the factored shape `A && B && (s || d)` REQUIRES the parentheses to mean what it reads as; without them it parses as `(A && B && s) || d`, whose right arm admits a workflow_dispatch run of ANY workflow on ANY branch. That is the trust wall failing open on its outer half while every in-program check still passes — the worst kind of defect here, because nothing downstream would notice.\n\nThe first attempt answered that by making extdeps.github.expressions parenthesize every Or. review 49430 refused it: that module is read in both directions and the parser has no grouping construct, so emission would have gained syntax ingest could not read (DESIGN §4). The distributed form needs no grouping at all — it is already correct under upstream's own precedence — so the hazard is answered at the authoring site and the shared grammar is untouched. Both arms are derived from the same constants, so they cannot disagree about the workflow or the branch."

fn falsifier_alert_originating_event_arm(event_name: String) -> Expression {
  LogicalAnd {
    left: Equals {
      left: falsifier_alert_workflow_run_field(field: "name"),
      right: StringLiteral { value: falsifier_alert_observed_workflow_name as String }
    },
    right: LogicalAnd {
      left: Equals {
        left: falsifier_alert_workflow_run_field(field: "head_branch"),
        right: StringLiteral { value: falsifier_alert_expected_head_branch as String }
      },
      right: Equals {
        left: falsifier_alert_workflow_run_field(field: "event"),
        right: StringLiteral { value: event_name }
      }
    }
  }
}

fn falsifier_alert_job_condition_expression() -> Expression {
  LogicalOr {
    left: falsifier_alert_originating_event_arm(event_name: github_event_name_schedule),
    right: falsifier_alert_originating_event_arm(event_name: github_event_name_workflow_dispatch)
  }
}

fn falsifier_alert_job_condition() -> String {
  serialize_expression(expression: falsifier_alert_job_condition_expression())
}
