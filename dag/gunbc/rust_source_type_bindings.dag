module gunbc.rust_source_type_bindings

import std.types { List, String, Bool, NonEmptyStr }
import std.decl_ref { DeclarationRef, decl_ref }
import std.target_representation {
  SourceTypeTargetBinding, CheckpointRowMigration, CheckpointRowDisposition,
  MigratedToExactBinding, ProvenUniqueKernelBinding, StillBareNameDebt
}
import extdeps.languages.rust.representation {
  RustRepresentation, RustStdString, RustI64, RustF64, RustBool, RustUnit, RustVecU8, RustSerdeJsonValue
}

// THE CORPUS'S HALF OF THE THREE-IDENTITY SPLIT (std.target_representation): which of THIS corpus's
// declarations realize natively on the Rust target, keyed on the exact declaration. The target's half
// -- what each representation spells -- lives in extdeps.languages.rust.representation and names no
// source declaration. A declaration absent here renders its own structure; an opaque declaration
// absent here has nothing to render and the renderer refuses, which is why every opaque provider
// that used to ride a bare-name row (Symbol, Unit, Json, Bytes, Secret) has an exact row.
//
// WHY EVERY ROW HERE IS ONE THE BARE TABLE ALREADY ANSWERED, and no more: extdeps.languages.rust.types
// rust_checkpoint_scalar_arity_note and v1.compiler.coercion numeric_realization_roster_extension_note
// both hold the same rule -- a row may be added only for a declaration whose native realization is
// ALREADY TRUE, never to make a failing site compile. These rows restate, at declaration grain, the
// realizations the spelling-keyed table was answering by name; they add no new realization. The
// declarations of the same spelling that are NOT here (v2.std.text String, std.string_type String,
// v2.std.logic Bool) are the ones v1.compiler.coercion structural_declaration_modules_for already
// gates as structural, and their absence here is the same fact stated once at the exact key.
fn rust_source_binding(module_path: String, decl_name: String, representation: RustRepresentation) -> SourceTypeTargetBinding<RustRepresentation> {
  SourceTypeTargetBinding {
    source: decl_ref(module_path: module_path, decl_name: decl_name),
    representation: representation
  }
}

data rust_source_type_binding_rows: List<SourceTypeTargetBinding<RustRepresentation>> = [
  rust_source_binding(module_path: "v2.std.node", decl_name: "Symbol", representation: RustStdString),
  rust_source_binding(module_path: "std.types", decl_name: "Secret", representation: RustStdString),
  rust_source_binding(module_path: "std.integer", decl_name: "Int", representation: RustI64),
  rust_source_binding(module_path: "std.float", decl_name: "Float", representation: RustF64),
  rust_source_binding(module_path: "std.types", decl_name: "Bool", representation: RustBool),
  rust_source_binding(module_path: "std.types", decl_name: "Unit", representation: RustUnit),
  rust_source_binding(module_path: "v2.std.cardinality", decl_name: "Unit", representation: RustUnit),
  rust_source_binding(module_path: "std.types", decl_name: "Bytes", representation: RustVecU8),
  rust_source_binding(module_path: "std.types", decl_name: "Json", representation: RustSerdeJsonValue)
]

fn rust_bound_declaration_refs() -> List<DeclarationRef> {
  rust_source_type_binding_rows |> map(r => r.source)
}

// THE VERDICT ON EVERY BARE-NAME ROW OF extdeps.languages.rust.types rust_type_checkpoints, one per
// name that table carried when this authority landed. The witness test.claim.self_host_symbol_identity_binding
// holds the roster and the table to each other: a Migrated name must be ABSENT from the bare table
// (its deletion is the census), a Proven or Debt name must be PRESENT, and a table row with no
// verdict is a refusal. So the spelling-keyed table can only shrink by a declared verdict.
//
// WHAT "KERNEL MINT" MEANS HERE, checkably: a reference the compiler creates with no declaration
// behind it, reaching v1.compiler.coercion lookup_checkpoint with decl_file == "" -- a literal's type
// (v1.compiler.types: LitStr, LitSymbol -> string_type; LitInt -> int_type; LitBool -> bool_type), a
// synthesized unit, a builtin's signature. Those callers hold a spelling and nothing else, so the bare
// row is their only authority and it survives for exactly them. A NAME'S DECLARATIONS never ride that
// arm once threaded: they carry a DeclarationRef and answer from the exact rows above.
//
// Symbol is Migrated and DELETED rather than kept for a kernel mint, although a Symbol literal is
// kernel-minted: v1.compiler.types types `^x` as string_type, and v1.compiler.emit's LitSymbol arm
// already reads its suffix from the String row when no Symbol row exists (its authored fallback), so
// the literal mint never needed a Symbol row -- it needed the kernel String row, which is what its
// type says. Nothing else reached the Symbol row with an empty decl_file: the seed's generated
// modules carry no v2.std.node Symbol reference (measured at authorship: the only seed files spelling
// a Symbol type are the hand-retained v2 pilot oracles, which the emitter does not produce).
fn checkpoint_row_migration_rows() -> List<CheckpointRowMigration> {
  [
    CheckpointRowMigration {
      dag_name: "Symbol" as NonEmptyStr,
      disposition: MigratedToExactBinding { bindings: [decl_ref(module_path: "v2.std.node", decl_name: "Symbol")] }
    },
    CheckpointRowMigration {
      dag_name: "String" as NonEmptyStr,
      disposition: ProvenUniqueKernelBinding {
        proof: "The kernel string_type is minted by v1.compiler.types for every string literal and carries no declaration; both .dag declarations of the spelling (v2.std.text, std.string_type) are gated structural by v1.compiler.coercion structural_declaration_modules_for and never reach this row. The bare reference spelling `String` cannot be captured: the only import that could shadow it binds the SAME token, so in a module importing v2.std.text String every `String` reference IS the text carrier and the kernel spelling is unreachable there by construction -- shadowing is the identity on one token. Symbol was captured precisely because its token differed from its spelling." as NonEmptyStr
      }
    },
    CheckpointRowMigration {
      dag_name: "Int" as NonEmptyStr,
      disposition: StillBareNameDebt {
        reason: "std.integer Int has an exact row (RustI64; native by v1.compiler.coercion numeric_realization_declaring_modules). v2.std.integer Int (GroupCompletion<v2.std.nat.Nat>) is answered i64 by the bare-name bypass today and no authority has ruled that this is its modeled realization rather than an accident of the bypass; the kernel int_type mint rides the same row." as NonEmptyStr,
        restoration_trigger: "A ruling on v2.std.integer Int's Rust realization sufficient to author its exact row or its structural gate, after which this bare row serves only the kernel mint and its verdict becomes ProvenUniqueKernelBinding (i64 is a primitive token no use-line can shadow)." as NonEmptyStr
      }
    },
    CheckpointRowMigration {
      dag_name: "Float" as NonEmptyStr,
      disposition: StillBareNameDebt {
        reason: "std.float Float has an exact row (RustF64). v2.std.float Float (= Float64) is answered f64 by the bare-name bypass with no ruling that this is its modeled realization; the kernel float_type mint rides the same row." as NonEmptyStr,
        restoration_trigger: "The same ruling as Int, for v2.std.float Float; then ProvenUniqueKernelBinding on the f64 primitive token." as NonEmptyStr
      }
    },
    CheckpointRowMigration {
      dag_name: "Bool" as NonEmptyStr,
      disposition: ProvenUniqueKernelBinding {
        proof: "std.types Bool has an exact row (RustBool); v2.std.logic Bool is gated structural by structural_declaration_modules_for and never reaches this row; what remains is the kernel bool_type mint (LitBool), and `bool` is a primitive token no use-line can shadow." as NonEmptyStr
      }
    },
    CheckpointRowMigration {
      dag_name: "Unit" as NonEmptyStr,
      disposition: ProvenUniqueKernelBinding {
        proof: "Both declarations of Unit (std.types, v2.std.cardinality) have exact rows (RustUnit); what remains is the kernel unit_type mint for empty-conj values, and `()` is a primitive token no use-line can shadow." as NonEmptyStr
      }
    },
    CheckpointRowMigration {
      dag_name: "Bytes" as NonEmptyStr,
      disposition: StillBareNameDebt {
        reason: "std.types Bytes has an exact row (RustVecU8, spelled std::vec::Vec<u8>). The bare row answers the unqualified `Vec<u8>` for callers that have not yet threaded a DeclarationRef; no kernel literal mints Bytes, so the row's only remaining consumer is that residue." as NonEmptyStr,
        restoration_trigger: "The Rust renderer threads exact declaration identity into every checkpoint-spelling caller (v1.compiler.emit_rust rust_scalar_checkpoint_spelling and its callers), so that no reference to std.types Bytes reaches the spelling-keyed arm; then this row deletes and the verdict becomes MigratedToExactBinding." as NonEmptyStr
      }
    },
    CheckpointRowMigration {
      dag_name: "Secret" as NonEmptyStr,
      disposition: StillBareNameDebt {
        reason: "std.types Secret (nominal_opaque = String) has an exact row (RustStdString, spelled std::string::String). It shares Symbol's capture CLASS -- an opaque provider spelled by the bare token String -- but not its population: at authorship no module importing v2.std.text String references Secret, so the bare row stands for unthreaded callers only." as NonEmptyStr,
        restoration_trigger: "The same threading capability as Bytes; then MigratedToExactBinding." as NonEmptyStr
      }
    },
    CheckpointRowMigration {
      dag_name: "Json" as NonEmptyStr,
      disposition: StillBareNameDebt {
        reason: "std.types Json has an exact row (RustSerdeJsonValue). A second opaque declaration of the spelling, extdeps.languages.json.subject Json, is answered serde_json::Value by the bare-name bypass; two opaque declarations of one spelling is a DESIGN section 3 nickname this authority records and does not resolve." as NonEmptyStr,
        restoration_trigger: "Consolidation of the two Json declarations into one authority (or an explicit exact row for extdeps.languages.json.subject Json with its own grounding), plus the threading capability; then MigratedToExactBinding." as NonEmptyStr
      }
    }
  ]
}

// ACCEPTANCE FOR THE SYMBOL CAPTURE IS BY FAILING-SITE IDENTITY, NOT BY COUNT. The instrument is the
// XL-0 freeze's own typeck run -- gunbc#9664's emit of the 05_eval closure followed by cargo check --
// classified by an error block being E0308 and pairing the text carrier (Rc<im::Vector<i64>>) with the
// host string (std::string::String). Every block in that subset names one of the DECLARERS below as
// the function whose parameter was declared Symbol in .dag and rendered as the captured bare token.
// GO is that subset empty on the same instrument with no declarer below reappearing under any other
// error class; NO-GO is the total falling while identities move. Counts are deliberately not
// transcribed here (DESIGN section 6: name the instrument, never copy its numbers).
type SymbolCaptureDeclarer {
  declarer: DeclarationRef
  symbol_position: NonEmptyStr
}

fn symbol_capture_declarer(module_path: String, decl_name: String, symbol_position: String) -> SymbolCaptureDeclarer {
  SymbolCaptureDeclarer {
    declarer: decl_ref(module_path: module_path, decl_name: decl_name),
    symbol_position: symbol_position as NonEmptyStr
  }
}

fn symbol_capture_declarers() -> List<SymbolCaptureDeclarer> {
  [
    symbol_capture_declarer(module_path: "v2.std.grammar", decl_name: "grammar_formal_nonterminal_occurrence", symbol_position: "identity"),
    symbol_capture_declarer(module_path: "v2.std.grammar", decl_name: "grammar_formal_terminal", symbol_position: "identity"),
    symbol_capture_declarer(module_path: "v2.std.grammar", decl_name: "grammar_formal_production", symbol_position: "lhs"),
    symbol_capture_declarer(module_path: "v2.std.grammar", decl_name: "grammar_formal_terminal_free", symbol_position: "identity"),
    symbol_capture_declarer(module_path: "v2.std.grammar", decl_name: "grammar_named_edge", symbol_position: "name"),
    symbol_capture_declarer(module_path: "v2.std.compilers.target_model", decl_name: "target_model_named_edge", symbol_position: "name"),
    symbol_capture_declarer(module_path: "v2.std.compilers.target_model", decl_name: "projection_bundle_symbol_field", symbol_position: "field"),
    symbol_capture_declarer(module_path: "v2.std.compilers.target_model", decl_name: "target_value_expr_diagnostic", symbol_position: "reason"),
    symbol_capture_declarer(module_path: "v2.std.compilers.target_model", decl_name: "projection_bundle_child", symbol_position: "name"),
    symbol_capture_declarer(module_path: "v2.std.compilers.target_model", decl_name: "target_atom_realization_conj_child", symbol_position: "edge_name"),
    symbol_capture_declarer(module_path: "v2.extdeps.languages.dag", decl_name: "dag_grammar_terminal", symbol_position: "token_class"),
    symbol_capture_declarer(module_path: "v2.extdeps.languages.dag", decl_name: "dag_grammar_nonterminal", symbol_position: "production"),
    symbol_capture_declarer(module_path: "v2.extdeps.languages.dag", decl_name: "dag_named_edge", symbol_position: "name"),
    symbol_capture_declarer(module_path: "v2.extdeps.languages.dag", decl_name: "dag_grammar_production", symbol_position: "name"),
    symbol_capture_declarer(module_path: "v2.extdeps.languages.dag", decl_name: "dag_literal_lex_rule", symbol_position: "token_class"),
    symbol_capture_declarer(module_path: "v2.extdeps.languages.dag", decl_name: "dag_type_atom_node", symbol_position: "identity"),
    symbol_capture_declarer(module_path: "v2.extdeps.languages.dag", decl_name: "dag_arrow_with_body_node", symbol_position: "return_type_binding"),
    symbol_capture_declarer(module_path: "v2.extdeps.languages.dag", decl_name: "dag_keyword_lex_rule", symbol_position: "token_class"),
    symbol_capture_declarer(module_path: "v2.extdeps.languages.dag", decl_name: "dag_lex_token_symbol", symbol_position: "sym"),
    symbol_capture_declarer(module_path: "v2.extdeps.languages.dag", decl_name: "dag_grammar_terminal_lexeme", symbol_position: "token_class"),
    symbol_capture_declarer(module_path: "v2.std.integer", decl_name: "integer_inhabitant_atom", symbol_position: "id"),
    symbol_capture_declarer(module_path: "v2.std.qualified_name", decl_name: "qualified_name_from_dotted_string", symbol_position: "return FreeMonoid<Symbol>"),
    symbol_capture_declarer(module_path: "v2.compiler.translate", decl_name: "target_bundle_child", symbol_position: "edge_name")
  ]
}
