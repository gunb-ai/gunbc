module gunbc.codex_app_server_press



data codex_press_note: String = "Account-standing observation for the Codex app-server specimen. This module does NOT claim a provider turn. Rate-limit standing is PER limit_id (rateLimitsByLimitId): a live Pro account can exhaust the codex bucket while codex_bengalfox remains at usedPercent 0 — collapsing to one account-level Ready|QuotaReached is false. CodexPressAccountReady gates on the native limit_id codex bucket only; every bucket verdict is retained on the evidence for ProviderNativeLimitBucket bridging. Empty rateLimits:\{\} is Incomplete. Trip stdin must send initialized after initialize or id=3 may never arrive."

data codex_press_hermetic_evidence_root: std.types.FilePath = "/tmp/gunbc-codex-press-evidence" as std.types.FilePath

data account_trip_digest_mode_note: String = "Hermetic parse helpers (parse_account_trip_stdout_for_tests) use AccountTripDigestStructural — content_hash_of_value fingerprints with zero host effects, so discovery stays mock-free. Wet observe_codex_account_preflight uses AccountTripDigestRetainPrivateSha512 under a caller-supplied evidence_root. Structural digests are NOT durable content identities; private SHA-512 retention is."

data account_standing_authenticated_rate_limits_readable_note: String = "CODEX-BUCKET-SCOPED, not account-wide entitlement or limit input. AccountStandingAuthenticatedRateLimitsReadable and CodexPressAccountReady gate on codex_default_rate_limit_id alone — the backward-compatible rateLimits mirror key (live limitId=codex), NOT proof that an unspecified-model turn/start draws that bucket (see extdeps.llm.codex_app_server codex_model_to_limit_bucket_gap_note). Ready means that one bucket shows remaining capacity (usedPercent below 100 without rateLimitReachedType). Sibling buckets stay on evidence.rate_limit_buckets and must not be erased into this classification. INVERTED FAILURE: codex free while a sibling bucket (e.g. codex_bengalfox) is exhausted still yields Ready here — fabricated-plausible account standing if a consumer treats CodexPressAccountReady or this classification as account-wide eligibility. Any consumer needing account-wide entitlement or per-bucket limit input MUST read evidence.rate_limit_buckets per limit_id (CodexRateLimitBucketVerdict) and bridge ProviderNativeLimitBucket \{ native_key: limit_id \} per codex_rate_limit_subject_encoding_note — never ProviderAccountLimit, and never CodexPressAccountReady alone as the limit axis. spendControlReached true is exhaustion when observed; live exhaustion often has it false — usedPercent and rateLimitReachedType are the operative facts. Bridge into gunbc.provider_standing LimitObservedAvailable|LimitUnavailableUntilReset dissolves when that consumer lands on this receipt."

type AccountTripDigestMode
  = AccountTripDigestStructural
  | AccountTripDigestRetainPrivateSha512

type CodexRuntimeBundleReceiptRef {
  receipt_identity: std.content_hash.ContentHash
}

type ProviderProbeKey = std.types.NonEmptyStr

type AmbientCodexCredentialContext {
  codex_home: std.types.FilePath
}

type CodexAccountPreflightSubject {
  runtime: CodexRuntimeBundleReceiptRef
  interface: gunbc.provider_interface_binding.ProviderInterfaceBinding
  probe_key: ProviderProbeKey
  credential: AmbientCodexCredentialContext
}

type CodexPressItinerary = List<extdeps.llm.codex_app_server.CodexAppServerMethod>

fn codex_press_account_trip_methods() -> CodexPressItinerary {
  [
    CodexAppServerInitialize,
    CodexAppServerAccountRead,
    CodexAppServerAccountRateLimitsRead,
  ]
}

data codex_press_turn_itinerary_target_note: String = "TARGET plan only — not executed by observe_codex_account_preflight. A TurnStarted constructor must not exist until both thread/start and turn/start responses supply exact provider IDs joined to a WorkerTurn."

data codex_credential_liveness_note: String = "account/read IS NOT credential liveness (continuity receipt 2026-08-13). The same dead CODEX_HOME answered chatgpt/pro on one probe and account:null a minute later — realm is non-deterministic until a background token refresh fails. Liveness derives ONLY from account/rateLimits/read exercising the token upstream: decodable buckets mean the credential was live for that trip; an empty bucket list after a typed rate-limits result means dead, not unobserved. Realm and liveness are independent axes — a CodexChatgptRealm { plan: pro } beside CodexCredentialDead is the trap the standing bridge must not collapse."

type CodexCredentialLiveness
  = CodexCredentialLive { bucket_count: Int }
  | CodexCredentialDead { reason: std.types.NonEmptyStr }
  | CodexCredentialLivenessUnobserved { reason: std.types.NonEmptyStr }

data codex_supervised_turn_delegation_note: String = "Supervised-runner execution lease, runner-written terminal receipt, and turn/start admission live in gunbc.codex_supervised_turn on std.temporal_effect HeldLease — not a forked session carrier in this module."

fn codex_press_turn_itinerary_target() -> CodexPressItinerary {
  concat(
    codex_press_account_trip_methods(),
    [CodexAppServerThreadStart, CodexAppServerTurnStart],
  )
}

fn codex_press_method_itinerary() -> CodexPressItinerary {
  codex_press_turn_itinerary_target()
}

data codex_press_standing_evidence_note: String = "Account standing is derived from ONE held-open app-server --stdio session: three JSON-RPC requests (ids 1/2/3) with per-id typed result/error correlation and duplicate-id refusal. Wire capture is retained privately under a caller-supplied evidence_root via gunbc.provider_wire_evidence (SHA-512 content-addressed stdout/stderr). Unknown NDJSON frames are digested SHA-512 through the same retention path; retention failure is Incomplete, never silent drop. AuthenticatedRateLimitsReadable requires AccountTripResponseUnique on ids 1/2/3 with typed result bodies AND retained wire evidence. Incomplete is refused (RED). Login/quota are typed arms. methods_attempted is the typed itinerary, never a free-form string that can disagree with the outcome. Production placement supplies gunbc.host_layout.ProviderRuntimePlacement.wire_evidence_root (srv1 via srv1_provider_runtime_placement) and GunbcHostLayout.roadmap_codex_home."

type AccountTripFrameDisposition
  = AccountTripResultOk
  | AccountTripLoginRequiredSignal
  | AccountTripQuotaSignal
  | AccountTripMissing
  | AccountTripNativeCauseUnknown { message: std.types.NonEmptyStr }
  | AccountTripNativeCauseNumericCode { code: Int }
  | AccountTripNativeCauseMessageUnreadable

type AccountTripResponseObservation
  = AccountTripResponseAbsent
  | AccountTripResponseUnique { response: AccountTripFrameDisposition }
  | AccountTripResponseDuplicate { id: Int, count: Int }

type AccountStandingClassification
  = AccountStandingAuthenticatedRateLimitsReadable
  | AccountStandingLoginRequired
  | AccountStandingQuotaReached
  | AccountStandingInitializeMissing
  | AccountStandingIncomplete

type CodexRateLimitBucketVerdict
  = CodexBucketCapacityAvailable { limit_id: std.types.NonEmptyStr }
  | CodexBucketUnavailableUntilReset {
      limit_id: std.types.NonEmptyStr
      reached_type: std.types.NonEmptyStr?
      resets_at: std.types.EpochSecs?
    }
  | CodexBucketCapacityUnknown { limit_id: std.types.NonEmptyStr }

data codex_account_realm_note: String = "THE REALM IS THE FACT THE DISPOSITION THREW AWAY. disposition_from_account_read_result decodes `account` to AccountTripResultOk when the object is nonempty and stops there, so an apiKey account, a Bedrock account and a personal ChatGPT subscription all reach the same Ready. Those are three different credential realizations (extdeps.llm.codex_app_server codex_account_union_note), and a profile requiring personal ChatGPT OAuth is satisfied by exactly one of them.\n\nThis coproduct is the decode of that union, plus the states the wire can reach that the union does not name: a null or absent account, a `type` this pin does not recognize, and a plan string outside the cited enum. Every one of those is its own arm, because the remedies differ — log in, update the pin, refuse the profile.\n\nCodexChatgptRealm carries the decoded plan rather than a Bool because entitlement is NOT derivable here. Which plans entitle which work is gunbc policy and lives at the standing bridge; this module's job is to say truthfully what upstream reported."

type CodexPlanTypeReading
  = CodexPlanTypeObserved { plan: extdeps.llm.codex_app_server.CodexPlanType }
  | CodexPlanTypeUnrecognized { native: std.types.NonEmptyStr }
  | CodexPlanTypeMalformed { cause: std.types.NonEmptyStr }

type CodexAccountRealm
  = CodexApiKeyRealm
  | CodexAmazonBedrockRealm
  | CodexChatgptRealm { plan: CodexPlanTypeReading }
  | CodexAccountRealmAbsent
  | CodexAccountRealmUnrecognizedType { native: std.types.NonEmptyStr }
  | CodexAccountRealmUnobserved { reason: std.types.NonEmptyStr }

fn codex_plan_type_from_wire(native: String) -> CodexPlanTypeReading {
  if native == "" {
    CodexPlanTypeMalformed {
      cause: "account/read chatgpt planType is an empty string" as std.types.NonEmptyStr,
    }
  } else if native == (codex_plan_type_wire_name(p: CodexPlanFree) as String) {
    CodexPlanTypeObserved { plan: CodexPlanFree }
  } else if native == (codex_plan_type_wire_name(p: CodexPlanGo) as String) {
    CodexPlanTypeObserved { plan: CodexPlanGo }
  } else if native == (codex_plan_type_wire_name(p: CodexPlanPlus) as String) {
    CodexPlanTypeObserved { plan: CodexPlanPlus }
  } else if native == (codex_plan_type_wire_name(p: CodexPlanPro) as String) {
    CodexPlanTypeObserved { plan: CodexPlanPro }
  } else if native == (codex_plan_type_wire_name(p: CodexPlanProlite) as String) {
    CodexPlanTypeObserved { plan: CodexPlanProlite }
  } else if native == (codex_plan_type_wire_name(p: CodexPlanTeam) as String) {
    CodexPlanTypeObserved { plan: CodexPlanTeam }
  } else if native == (codex_plan_type_wire_name(p: CodexPlanSelfServeBusinessUsageBased) as String) {
    CodexPlanTypeObserved { plan: CodexPlanSelfServeBusinessUsageBased }
  } else if native == (codex_plan_type_wire_name(p: CodexPlanBusiness) as String) {
    CodexPlanTypeObserved { plan: CodexPlanBusiness }
  } else if native == (codex_plan_type_wire_name(p: CodexPlanEnt26) as String) {
    CodexPlanTypeObserved { plan: CodexPlanEnt26 }
  } else if native == (codex_plan_type_wire_name(p: CodexPlanEnterpriseCbpUsageBased) as String) {
    CodexPlanTypeObserved { plan: CodexPlanEnterpriseCbpUsageBased }
  } else if native == (codex_plan_type_wire_name(p: CodexPlanEnterprise) as String) {
    CodexPlanTypeObserved { plan: CodexPlanEnterprise }
  } else if native == (codex_plan_type_wire_name(p: CodexPlanEdu) as String) {
    CodexPlanTypeObserved { plan: CodexPlanEdu }
  } else if native == (codex_plan_type_wire_name(p: CodexPlanUnknown) as String) {
    CodexPlanTypeObserved { plan: CodexPlanUnknown }
  } else {
    CodexPlanTypeUnrecognized { native: native as std.types.NonEmptyStr }
  }
}

fn codex_chatgpt_plan_reading(account: extdeps.languages.json.emit.JsonValue) -> CodexPlanTypeReading {
  match json_object_unique_member(v: account, key: codex_account_plan_type_key as String) {
    JsonMemberFound { value: extdeps.languages.json.emit.JsonString { value: p } } => codex_plan_type_from_wire(native: p)
    JsonMemberFound { value: _ } =>
      CodexPlanTypeMalformed {
        cause: "account/read chatgpt planType is not a JSON string" as std.types.NonEmptyStr,
      }
    JsonMemberAbsent =>
      CodexPlanTypeMalformed {
        cause: "account/read chatgpt account omits the required planType member" as std.types.NonEmptyStr,
      }
    JsonMemberDuplicated { count: _ } =>
      CodexPlanTypeMalformed {
        cause: "account/read chatgpt account carries duplicate planType members" as std.types.NonEmptyStr,
      }
    JsonMemberNotAnObject =>
      CodexPlanTypeMalformed {
        cause: "account/read account member is not a JSON object" as std.types.NonEmptyStr,
      }
  }
}

fn codex_account_not_an_object_realm() -> CodexAccountRealm {
  CodexAccountRealmUnobserved {
    reason: "account/read account member is neither an object nor null" as std.types.NonEmptyStr,
  }
}

fn codex_account_realm_from_account_value(account: extdeps.languages.json.emit.JsonValue) -> CodexAccountRealm {
  match account {
    JsonNull => CodexAccountRealmAbsent
    JsonObject { members: _ } =>
      match json_object_unique_member(v: account, key: codex_account_type_key as String) {
        JsonMemberFound { value: extdeps.languages.json.emit.JsonString { value: t } } =>
          if t == (codex_account_type_wire_name(t: CodexAccountTypeChatgpt) as String) {
            CodexChatgptRealm { plan: codex_chatgpt_plan_reading(account: account) }
          } else if t == (codex_account_type_wire_name(t: CodexAccountTypeApiKey) as String) {
            CodexApiKeyRealm
          } else if t == (codex_account_type_wire_name(t: CodexAccountTypeAmazonBedrock) as String) {
            CodexAmazonBedrockRealm
          } else if t == "" {
            CodexAccountRealmUnobserved {
              reason: "account/read account type is an empty string" as std.types.NonEmptyStr,
            }
          } else {
            CodexAccountRealmUnrecognizedType { native: t as std.types.NonEmptyStr }
          }
        JsonMemberFound { value: _ } =>
          CodexAccountRealmUnobserved {
            reason: "account/read account type is not a JSON string" as std.types.NonEmptyStr,
          }
        JsonMemberAbsent =>
          CodexAccountRealmUnobserved {
            reason: "account/read account omits the required type discriminant" as std.types.NonEmptyStr,
          }
        JsonMemberDuplicated { count: _ } =>
          CodexAccountRealmUnobserved {
            reason: "account/read account carries duplicate type members" as std.types.NonEmptyStr,
          }
        JsonMemberNotAnObject =>
          CodexAccountRealmUnobserved {
            reason: "account/read account member is not a JSON object" as std.types.NonEmptyStr,
          }
      }
    JsonString { value: _ } => codex_account_not_an_object_realm()
    JsonNumber { lexeme: _ } => codex_account_not_an_object_realm()
    JsonBool { value: _ } => codex_account_not_an_object_realm()
    JsonArray { elements: _ } => codex_account_not_an_object_realm()
  }
}

fn codex_account_realm_from_result(result: extdeps.languages.json.emit.JsonValue) -> CodexAccountRealm {
  match json_object_unique_member(
    v: result,
    key: codex_account_read_result_account_key as String,
  ) {
    JsonMemberFound { value: account } =>
      codex_account_realm_from_account_value(account: account)
    JsonMemberAbsent => CodexAccountRealmAbsent
    JsonMemberDuplicated { count: _ } =>
      CodexAccountRealmUnobserved {
        reason: "account/read result carries duplicate account members" as std.types.NonEmptyStr,
      }
    JsonMemberNotAnObject =>
      CodexAccountRealmUnobserved {
        reason: "account/read result is not a JSON object" as std.types.NonEmptyStr,
      }
  }
}

data codex_account_realm_unobserved_default: std.types.NonEmptyStr = "codex app-server account/read produced no decodable account frame on this trip" as std.types.NonEmptyStr

type CodexAccountStandingEvidence {
  itinerary: CodexPressItinerary
  initialize: AccountTripResponseObservation
  account_read: AccountTripResponseObservation
  account_realm: CodexAccountRealm
  credential_liveness: CodexCredentialLiveness
  rate_limits: AccountTripResponseObservation
  rate_limit_buckets: List<CodexRateLimitBucketVerdict>
  unknown_frame_digests: List<std.content_hash.ContentHash>
  stderr_digest: std.content_hash.ContentHash?
  classification: AccountStandingClassification
}

type CodexAccountStandingSummary {
  evidence: CodexAccountStandingEvidence
}

data provider_process_exit_divergence_note: String = "ProviderProcessExit is the press receipt projection, not a second std.process authority. std.process.ProcessExit (ExitSuccess | ExitFailure with code and reason) models CLI/program exit semantics with a typed reason string. ProcessExitObservation in gunbc.provider_wire_evidence models shell.Exec transport (success bool + optional exit_code from the host). ProviderProcessExited carries only the parsed sentinel exit code while ProviderProcessObservationFailed means the mux marker or exit observation was absent — a press-parse outcome, not a host refusal reason. Converge when shell→intent typed stdio transport lands (docs/plans/shell-intent-emit-realization-design.md) and replaces sentinel reparsing — this coproduct deletes with that scaffold."

type ProviderProcessExit
  = ProviderProcessExited { code: Int }
  | ProviderProcessObservationFailed

type ProviderProcessReceipt {
  exit: ProviderProcessExit
  wire: gunbc.provider_wire_evidence.ProviderWireEvidenceReceipt?
}

type CodexAccountStandingReceipt {
  subject: CodexAccountPreflightSubject
  standing: CodexAccountStandingSummary
  wire_evidence: gunbc.provider_wire_evidence.ProviderWireEvidenceReceipt?
  process: ProviderProcessReceipt
}

type CodexPressOutcome
  = CodexPressAccountReady {
      receipt: CodexAccountStandingReceipt
    }
  | CodexPressLoginRequired {
      reason: std.types.NonEmptyStr
      receipt: CodexAccountStandingReceipt
    }
  | CodexPressUnavailable {
      reason: std.types.NonEmptyStr
      process: ProviderProcessReceipt
    }
  | CodexPressRefused {
      reason: std.types.NonEmptyStr
      receipt: CodexAccountStandingReceipt
    }

fn codex_press_outcome_wire_status(outcome: CodexPressOutcome) -> String {
  match outcome {
    CodexPressAccountReady { receipt: _ } => "account_authenticated_rate_limits_readable"
    CodexPressLoginRequired { reason: _, receipt: _ } => "login_required"
    CodexPressUnavailable { reason: _, process: _ } => "unavailable"
    CodexPressRefused { reason: _, receipt: _ } => "press_refused"
  }
}

fn codex_press_outcome_operator_caption(outcome: CodexPressOutcome) -> String {
  match outcome {
    CodexPressAccountReady { receipt: _ } => "authenticated; codex capacity available"
    CodexPressLoginRequired { reason: _, receipt: _ } => "login required"
    CodexPressUnavailable { reason: _, process: _ } => "unavailable"
    CodexPressRefused { reason, receipt: _ } =>
      if (reason as String).contains("quota") {
        "codex quota exhausted"
      } else {
        "refused"
      }
  }
}

fn account_standing_projection(classification: AccountStandingClassification) -> String {
  match classification {
    AccountStandingAuthenticatedRateLimitsReadable =>
      "initialize_ok; account_read_ok; rate_limits_observed"
    AccountStandingLoginRequired => "initialize_ok; login_required"
    AccountStandingQuotaReached => "initialize_ok; account_read_ok; rate_limits_quota_reached"
    AccountStandingInitializeMissing => "initialize_missing"
    AccountStandingIncomplete => "initialize_ok; account_or_limits_incomplete"
  }
}

fn account_standing_summary_from_evidence(
  evidence: CodexAccountStandingEvidence,
) -> CodexAccountStandingSummary {
  CodexAccountStandingSummary { evidence: evidence }
}

fn standing_is_redacted_projection(summary: CodexAccountStandingSummary) -> Bool {
  let s = account_standing_projection(classification: summary.evidence.classification)
  s.contains("@") == false
    && s.contains("access_token") == false
    && s.contains("refresh_token") == false
}

fn binding_from_initialize_session(
  bundle: gunbc.package_delivery.CodexRuntimeBundle,
  projected: gunbc.provider_interface_binding.ProviderInterfaceBinding,
) -> gunbc.provider_interface_binding.ProviderInterfaceBinding {
  gunbc.provider_interface_binding.ProviderInterfaceBinding {
    interface: projected.interface,
    transport: CodexAppServerStdio,
    executable: projected.executable,
    runtime_identity: codex_bundle_identity(bundle: bundle),
    protocol_schema_identity: bundle.receipt.protocol_schema_identity,
  }
}

data codex_press_stdio_sentinel_mux_dissolve_note: std.dissolution.DissolutionCondition = unbound_dissolution(description: "Interim stdout/stderr/exit capture muxes shell.Exec.Run output through literal ---GUNBC_EXIT---/---GUNBC_STDOUT---/---GUNBC_STDERR--- sentinels (codex_press_account_trip_script → split_gunbc_stdio_capture). Wrapped in retained_foreign with dissolve-on v2.workflow.bash_emit. The sentinel concat itself dissolves when shell→intent typed stdio transport replaces foreign script muxing (docs/plans/shell-intent-emit-realization-design.md Phase 2 host-effect route for runtime-present press sites).")

fn codex_press_account_trip_script(
  executable: std.types.FilePath,
  codex_home: std.types.FilePath,
) -> String {
  concat(
    "export CODEX_HOME='",
    concat(
      codex_home as String,
      concat(
        "'; REQ=$(mktemp); OUT=$(mktemp); ERR=$(mktemp); ",
        concat(
          "printf '%s\\n' '",
          concat(
            codex_app_server_initialize_request_line() as String,
            concat(
              "' >\"$REQ\"; printf '%s\\n' '",
              concat(
                codex_app_server_initialized_notification_line() as String,
                concat(
                  "' >>\"$REQ\"; printf '%s\\n' '",
                  concat(
                    codex_app_server_account_read_request_line() as String,
                    concat(
                      "' >>\"$REQ\"; printf '%s\\n' '",
                      concat(
                        codex_app_server_rate_limits_read_request_line() as String,
                        concat(
                          "' >>\"$REQ\"; cat \"$REQ\" | '",
                          concat(
                            executable as String,
                            "' app-server --stdio >\"$OUT\" 2>\"$ERR\"; EC=$?; echo \"---GUNBC_EXIT---$EC---\"; echo '---GUNBC_STDOUT---'; cat \"$OUT\"; echo '---GUNBC_STDERR---'; cat \"$ERR\"; rm -f \"$REQ\" \"$OUT\" \"$ERR\"; exit \"$EC\"",
                          ),
                        ),
                      ),
                    ),
                  ),
                ),
              ),
            ),
          ),
        ),
      ),
    ),
  )
}

fn json_rpc_id_as_int(v: extdeps.languages.json.emit.JsonValue) -> Int? {
  match v {
    JsonNumber { lexeme: l } => parse_int(s: l as String)
    JsonNull => none
    JsonBool { value: _ } => none
    JsonString { value: _ } => none
    JsonArray { elements: _ } => none
    JsonObject { members: _ } => none
  }
}

data json_rpc_error_message_note: String = "NO CANNED MESSAGE (review 50535). This read previously answered the literal \"json-rpc error\" whenever err.message was absent, empty, or any non-string shape — a structured error carrying code plus data, a nested message object, an array, null — so a real provider cause was reported as a fabricated string that reads exactly like a message the server sent (DESIGN §5 fabricated plausible output). The arms now separate: a genuine string message is carried verbatim, and every shape that is not one lands on AccountTripNativeCauseMessageUnreadable, which carries no text at all. That variant is deliberately field-free — inventing a description of the shape we failed to read would re-introduce the same fabrication one level down; the frame's own retained wire evidence is where the unread bytes stay recoverable."

fn json_rpc_error_message(err: extdeps.languages.json.emit.JsonValue) -> std.types.NonEmptyStr? {
  match json_object_unique_member(v: err, key: "message") {
    JsonMemberFound { value: extdeps.languages.json.emit.JsonString { value: msg } } =>
      if msg == "" {
        none
      } else {
        Present { value: msg as std.types.NonEmptyStr }
      }
    JsonMemberFound { value: _ } => none
    JsonMemberAbsent => none
    JsonMemberDuplicated { count: _ } => none
    JsonMemberNotAnObject => none
  }
}

fn native_cause_from_json_rpc_error(err: extdeps.languages.json.emit.JsonValue) -> AccountTripFrameDisposition {
  match json_rpc_error_message(err: err) {
    Present { value: msg } => AccountTripNativeCauseUnknown { message: msg }
    Absent => AccountTripNativeCauseMessageUnreadable
  }
}

fn disposition_from_initialize_result(result: extdeps.languages.json.emit.JsonValue) -> AccountTripFrameDisposition {
  match json_object_unique_member(
    v: result,
    key: codex_initialize_result_user_agent_key as String,
  ) {
    JsonMemberFound { value: extdeps.languages.json.emit.JsonString { value: ua } } =>
      if ua == "" {
        AccountTripMissing
      } else {
        AccountTripResultOk
      }
    JsonMemberAbsent => AccountTripMissing
    JsonMemberDuplicated { count: _ } => AccountTripMissing
    JsonMemberNotAnObject => AccountTripMissing
  }
}

fn disposition_from_account_read_result(result: extdeps.languages.json.emit.JsonValue) -> AccountTripFrameDisposition {
  match json_object_unique_member(
    v: result,
    key: codex_account_read_result_account_key as String,
  ) {
    JsonMemberFound { value: extdeps.languages.json.emit.JsonNull } => AccountTripLoginRequiredSignal
    JsonMemberFound { value: extdeps.languages.json.emit.JsonObject { members: ms } } =>
      if count(ms) == 0 {
        AccountTripMissing
      } else {
        AccountTripResultOk
      }
    JsonMemberFound { value: _ } => AccountTripMissing
    JsonMemberAbsent =>
      match json_object_unique_member(
        v: result,
        key: codex_account_read_result_requires_openai_auth_key as String,
      ) {
        JsonMemberFound { value: extdeps.languages.json.emit.JsonBool { value: true } } => AccountTripLoginRequiredSignal
        _ => AccountTripMissing
      }
    JsonMemberDuplicated { count: _ } => AccountTripMissing
    JsonMemberNotAnObject => AccountTripMissing
  }
}

fn json_number_as_int(v: extdeps.languages.json.emit.JsonValue) -> Int? {
  match v {
    JsonNumber { lexeme: l } => parse_int(s: l as String)
    JsonNull => none
    JsonBool { value: _ } => none
    JsonString { value: _ } => none
    JsonArray { elements: _ } => none
    JsonObject { members: _ } => none
  }
}

fn json_number_as_epoch_secs(v: extdeps.languages.json.emit.JsonValue) -> std.types.EpochSecs? {
  match json_number_as_int(v: v) {
    Absent => none
    Present { value: n } =>
      if n < 0 {
        none
      } else {
        Present { value: n }
      }
  }
}

data rate_limit_used_percent_carrier_frontier: String = "usedPercent is a DIMENSIONLESS RATIO and std.measure.Percent (Measure<Dimensionless, One, Nat>) is its authority — this is a consumer of that carrier, not a new unit, and no nickname is minted here. It is carried as bounded Int TODAY for exactly the reason std.measure.percent_from_computed_int_frontier states: percent(count: Nat) admits a LITERAL Nat only, and runtime eval refuses a computed Int→Nat cast, while this value is decoded from the app-server's JSON (json_number_as_int) and is therefore computed by construction. Same wall, same disposition as extdeps.color.srgb HslProjection s_pct/l_pct, which are bounded Int percent counts citing that identical frontier. DISSOLVE-ON: the numeric-tower Int=Nat grounding extending to computed values (same lane as the CrossRepresentationEquality guard removal) — at which point this fn returns Percent? and the comparison against the exhaustion threshold reads through percent_count with no change of meaning."

fn rate_limit_window_used_percent(window: extdeps.languages.json.emit.JsonValue) -> Int? {
  match json_object_unique_member(
    v: window,
    key: codex_rate_limits_window_used_percent_key as String,
  ) {
    JsonMemberFound { value: pct } => json_number_as_int(v: pct)
    JsonMemberAbsent => none
    JsonMemberDuplicated { count: _ } => none
    JsonMemberNotAnObject => none
  }
}

fn rate_limit_window_is_saturated(window: extdeps.languages.json.emit.JsonValue) -> Bool {
  match rate_limit_window_used_percent(window: window) {
    Absent => false
    Present { value: pct } => pct >= 100
  }
}

fn rate_limit_window_shows_remaining_capacity(window: extdeps.languages.json.emit.JsonValue) -> Bool {
  match rate_limit_window_used_percent(window: window) {
    Absent => false
    Present { value: pct } => pct < 100
  }
}

fn rate_limits_snapshot_has_exhaustion_signal(snapshot: extdeps.languages.json.emit.JsonValue) -> Bool {
  match json_object_unique_member(
    v: snapshot,
    key: codex_rate_limits_snapshot_rate_limit_reached_type_key as String,
  ) {
    JsonMemberFound { value: extdeps.languages.json.emit.JsonString { value: t } } => t != ""
    _ =>
      match json_object_unique_member(
        v: snapshot,
        key: codex_rate_limits_snapshot_spend_control_reached_key as String,
      ) {
        JsonMemberFound { value: extdeps.languages.json.emit.JsonBool { value: true } } => true
        _ =>
          rate_limits_snapshot_window_saturated(
            snapshot: snapshot,
            key: codex_rate_limits_snapshot_primary_key as String,
          )
            || rate_limits_snapshot_window_saturated(
              snapshot: snapshot,
              key: codex_rate_limits_snapshot_secondary_key as String,
            )
      }
  }
}

fn rate_limits_snapshot_window_saturated(snapshot: extdeps.languages.json.emit.JsonValue, key: String) -> Bool {
  match json_object_unique_member(v: snapshot, key: key) {
    JsonMemberFound { value: window } => rate_limit_window_is_saturated(window: window)
    JsonMemberAbsent => false
    JsonMemberDuplicated { count: _ } => false
    JsonMemberNotAnObject => false
  }
}

fn rate_limits_snapshot_window_has_capacity(snapshot: extdeps.languages.json.emit.JsonValue, key: String) -> Bool {
  match json_object_unique_member(v: snapshot, key: key) {
    JsonMemberFound { value: window } =>
      rate_limit_window_shows_remaining_capacity(window: window)
    JsonMemberAbsent => false
    JsonMemberDuplicated { count: _ } => false
    JsonMemberNotAnObject => false
  }
}

fn rate_limits_primary_resets_at(snapshot: extdeps.languages.json.emit.JsonValue) -> std.types.EpochSecs? {
  match json_object_unique_member(
    v: snapshot,
    key: codex_rate_limits_snapshot_primary_key as String,
  ) {
    JsonMemberFound { value: window } =>
      match json_object_unique_member(
        v: window,
        key: codex_rate_limits_window_resets_at_key as String,
      ) {
        JsonMemberFound { value: ts } => json_number_as_epoch_secs(v: ts)
        _ => none
      }
    _ => none
  }
}

fn rate_limits_reached_type(snapshot: extdeps.languages.json.emit.JsonValue) -> std.types.NonEmptyStr? {
  match json_object_unique_member(
    v: snapshot,
    key: codex_rate_limits_snapshot_rate_limit_reached_type_key as String,
  ) {
    JsonMemberFound { value: extdeps.languages.json.emit.JsonString { value: t } } =>
      if t == "" {
        none
      } else {
        Present { value: t as std.types.NonEmptyStr }
      }
    _ => none
  }
}

data rate_limit_id_reading_note: String = "THREE DISTINGUISHABLE WIRE STATES, NOT ONE (review 50532). This read previously collapsed absent-key, empty-string, and wrong-shape into one synthesized codex_default_rate_limit_id, which consumers could not tell from a real wire id of the same text — the DESIGN section 5 absorbing fallback (a failure arm must refuse, never widen). The harm is specific and this module's own account_standing_authenticated_rate_limits_readable_note already names it: downstream reads buckets BY limit_id, so a bucket whose real id was codex_bengalfox emitted under the fabricated id codex misattributes a sibling bucket's limits to the codex bucket — exactly the inverted failure that note warns produces fabricated-plausible account standing. Only ONE of the three states legitimately defaults: an ABSENT key is the backward-compatible rateLimits mirror shape, whose id is codex by the mirror's definition rather than by fabrication. An empty or non-string id is malformed wire and refuses. On refusal the caller emits NO bucket rather than one under a guessed name: every CodexRateLimitBucketVerdict variant requires a limit_id, so a malformed id cannot name a bucket at all, and emitting none is strictly safer than emitting one that a per-limit_id consumer will read as a different bucket."

type CodexRateLimitIdReading
  = CodexRateLimitIdObserved { limit_id: std.types.NonEmptyStr }
  | CodexRateLimitIdAbsentLegacyMirror
  | CodexRateLimitIdMalformed { cause: std.types.NonEmptyStr }

fn rate_limits_snapshot_limit_id(snapshot: extdeps.languages.json.emit.JsonValue) -> CodexRateLimitIdReading {
  match json_object_unique_member(
    v: snapshot,
    key: codex_rate_limits_snapshot_limit_id_key as String,
  ) {
    JsonMemberFound { value: extdeps.languages.json.emit.JsonString { value: id } } =>
      if id == "" {
        CodexRateLimitIdMalformed {
          cause: "rateLimits snapshot limitId is an empty string" as std.types.NonEmptyStr,
        }
      } else {
        CodexRateLimitIdObserved { limit_id: id as std.types.NonEmptyStr }
      }
    JsonMemberFound { value: _ } =>
      CodexRateLimitIdMalformed {
        cause: "rateLimits snapshot limitId is not a JSON string" as std.types.NonEmptyStr,
      }
    JsonMemberAbsent => CodexRateLimitIdAbsentLegacyMirror
    JsonMemberDuplicated { count: _ } =>
      CodexRateLimitIdMalformed {
        cause: "rateLimits snapshot carries duplicate limitId members" as std.types.NonEmptyStr,
      }
    JsonMemberNotAnObject =>
      CodexRateLimitIdMalformed {
        cause: "rateLimits snapshot is not a JSON object" as std.types.NonEmptyStr,
      }
  }
}

fn verdict_from_rate_limits_snapshot(
  limit_id: std.types.NonEmptyStr,
  snapshot: extdeps.languages.json.emit.JsonValue,
) -> CodexRateLimitBucketVerdict {
  if rate_limits_snapshot_has_exhaustion_signal(snapshot: snapshot) {
    CodexBucketUnavailableUntilReset {
      limit_id: limit_id,
      reached_type: rate_limits_reached_type(snapshot: snapshot),
      resets_at: rate_limits_primary_resets_at(snapshot: snapshot),
    }
  } else if rate_limits_snapshot_window_has_capacity(
    snapshot: snapshot,
    key: codex_rate_limits_snapshot_primary_key as String,
  )
    || rate_limits_snapshot_window_has_capacity(
      snapshot: snapshot,
      key: codex_rate_limits_snapshot_secondary_key as String,
    ) {
    CodexBucketCapacityAvailable { limit_id: limit_id }
  } else {
    CodexBucketCapacityUnknown { limit_id: limit_id }
  }
}

fn rate_limit_buckets_from_by_limit_id(by_id: extdeps.languages.json.emit.JsonValue) -> List<CodexRateLimitBucketVerdict> {
  match by_id {
    JsonObject { members: ms } =>
      fold(
        ms,
        init: [],
        f: (acc, kv) =>
          if kv.key == "" {
            acc
          } else {
            acc |> list_push(
              verdict_from_rate_limits_snapshot(
                limit_id: kv.key as std.types.NonEmptyStr,
                snapshot: kv.value,
              ),
            )
          },
      )
    _ => []
  }
}

fn rate_limit_buckets_from_result(result: extdeps.languages.json.emit.JsonValue) -> List<CodexRateLimitBucketVerdict> {
  match json_object_unique_member(
    v: result,
    key: codex_rate_limits_result_by_limit_id_key as String,
  ) {
    JsonMemberFound { value: by_id } =>
      match by_id {
        JsonObject { members: _ } => rate_limit_buckets_from_by_limit_id(by_id: by_id)
        _ => rate_limit_buckets_from_legacy_rate_limits(result: result)
      }
    JsonMemberAbsent => rate_limit_buckets_from_legacy_rate_limits(result: result)
    JsonMemberDuplicated { count: _ } => []
    JsonMemberNotAnObject => []
  }
}

fn rate_limit_buckets_from_legacy_rate_limits(
  result: extdeps.languages.json.emit.JsonValue,
) -> List<CodexRateLimitBucketVerdict> {
  match json_object_unique_member(
    v: result,
    key: codex_rate_limits_result_rate_limits_key as String,
  ) {
    JsonMemberFound { value: snapshot } =>
      match snapshot {
        JsonObject { members: _ } =>
          match rate_limits_snapshot_limit_id(snapshot: snapshot) {
            CodexRateLimitIdObserved { limit_id: observed } =>
              [
                verdict_from_rate_limits_snapshot(
                  limit_id: observed,
                  snapshot: snapshot,
                ),
              ]
            CodexRateLimitIdAbsentLegacyMirror =>
              [
                verdict_from_rate_limits_snapshot(
                  limit_id: extdeps.llm.codex_app_server.codex_default_rate_limit_id,
                  snapshot: snapshot,
                ),
              ]
            CodexRateLimitIdMalformed { cause: _ } => []
          }
        _ => []
      }
    _ => []
  }
}

fn disposition_from_rate_limits_result(result: extdeps.languages.json.emit.JsonValue) -> AccountTripFrameDisposition {
  match json_object_unique_member(
    v: result,
    key: codex_rate_limits_result_rate_limits_key as String,
  ) {
    JsonMemberFound { value: snapshot } =>
      match snapshot {
        JsonObject { members: _ } => AccountTripResultOk
        JsonNull => AccountTripMissing
        _ => AccountTripMissing
      }
    JsonMemberAbsent => AccountTripMissing
    JsonMemberDuplicated { count: _ } => AccountTripMissing
    JsonMemberNotAnObject => AccountTripMissing
  }
}

fn codex_bucket_verdict_for_limit_id(
  buckets: List<CodexRateLimitBucketVerdict>,
  limit_id: std.types.NonEmptyStr,
) -> CodexRateLimitBucketVerdict? {
  fold(
    buckets,
    init: none,
    f: (acc, bucket) =>
      match acc {
        Present { value: _ } => acc
        Absent =>
          match bucket {
            CodexBucketCapacityAvailable { limit_id: id } =>
              if id == limit_id {
                Present { value: bucket }
              } else {
                none
              }
            CodexBucketUnavailableUntilReset { limit_id: id, reached_type: _, resets_at: _ } =>
              if id == limit_id {
                Present { value: bucket }
              } else {
                none
              }
            CodexBucketCapacityUnknown { limit_id: id } =>
              if id == limit_id {
                Present { value: bucket }
              } else {
                none
              }
          }
      },
  )
}

fn classification_from_codex_default_bucket(
  buckets: List<CodexRateLimitBucketVerdict>,
) -> AccountStandingClassification {
  if count(buckets) == 0 {
    AccountStandingIncomplete
  } else {
    match codex_bucket_verdict_for_limit_id(
      buckets: buckets,
      limit_id: extdeps.llm.codex_app_server.codex_default_rate_limit_id,
    ) {
      Absent => AccountStandingIncomplete
      Present { value: CodexBucketCapacityAvailable { limit_id: _ } } =>
        AccountStandingAuthenticatedRateLimitsReadable
      Present { value: CodexBucketUnavailableUntilReset { limit_id: _, reached_type: _, resets_at: _ } } =>
        AccountStandingQuotaReached
      Present { value: CodexBucketCapacityUnknown { limit_id: _ } } =>
        AccountStandingIncomplete
    }
  }
}

data account_trip_structured_error_code_note: String = "Business classifications Login/Quota are authorized only by typed result members or a structured JSON-RPC error `code` string that exactly matches a known native code from extdeps.llm.codex_app_server. Free-text `message` alone yields AccountTripNativeCauseUnknown → Incomplete — never Ready/Login/Quota (provider-audit handback)."

fn disposition_from_structured_rpc_error(err: extdeps.languages.json.emit.JsonValue) -> AccountTripFrameDisposition {
  match json_object_unique_member(v: err, key: "code") {
    JsonMemberFound { value: extdeps.languages.json.emit.JsonString { value: code } } =>
      if code == (codex_structured_error_code_rate_limit_reached as String)
        || code == (codex_structured_error_code_quota_exceeded as String) {
        AccountTripQuotaSignal
      } else if code == (codex_structured_error_code_authentication_required as String)
        || code == (codex_account_read_result_requires_openai_auth_key as String) {
        AccountTripLoginRequiredSignal
      } else {
        native_cause_from_json_rpc_error(err: err)
      }
    JsonMemberFound { value: extdeps.languages.json.emit.JsonNumber { lexeme: n } } =>
      AccountTripNativeCauseNumericCode { code: n }
    _ =>
      native_cause_from_json_rpc_error(err: err)
  }
}

fn disposition_for_id_response(id: Int, obj: extdeps.languages.json.emit.JsonValue) -> AccountTripFrameDisposition {
  match json_object_unique_member(v: obj, key: "error") {
    JsonMemberFound { value: err } => disposition_from_structured_rpc_error(err: err)
    JsonMemberAbsent =>
      match json_object_unique_member(v: obj, key: "result") {
        JsonMemberFound { value: result } =>
          if id == 1 {
            disposition_from_initialize_result(result: result)
          } else if id == 2 {
            disposition_from_account_read_result(result: result)
          } else if id == 3 {
            disposition_from_rate_limits_result(result: result)
          } else {
            AccountTripMissing
          }
        JsonMemberAbsent => AccountTripMissing
        JsonMemberDuplicated { count: _ } => AccountTripMissing
        JsonMemberNotAnObject => AccountTripMissing
      }
    JsonMemberDuplicated { count: _ } => AccountTripMissing
    JsonMemberNotAnObject => AccountTripMissing
  }
}

fn absorb_id_response(
  current: AccountTripResponseObservation,
  id: Int,
  disposition: AccountTripFrameDisposition,
) -> AccountTripResponseObservation {
  match current {
    AccountTripResponseAbsent =>
      AccountTripResponseUnique { response: disposition }
    AccountTripResponseUnique { response: _ } =>
      AccountTripResponseDuplicate { id: id, count: 2 }
    AccountTripResponseDuplicate { id: id, count: n } =>
      AccountTripResponseDuplicate { id: id, count: n + 1 }
  }
}

fn observation_is_duplicate(obs: AccountTripResponseObservation) -> Bool {
  match obs {
    AccountTripResponseDuplicate { id: _, count: _ } => true
    AccountTripResponseAbsent => false
    AccountTripResponseUnique { response: _ } => false
  }
}

fn observation_to_disposition(obs: AccountTripResponseObservation) -> AccountTripFrameDisposition {
  match obs {
    AccountTripResponseAbsent => AccountTripMissing
    AccountTripResponseUnique { response: r } => r
    AccountTripResponseDuplicate { id: _, count: _ } => AccountTripMissing
  }
}

type AccountTripParseAcc {
  initialize: AccountTripResponseObservation
  account_read: AccountTripResponseObservation
  account_realm: CodexAccountRealm
  rate_limits: AccountTripResponseObservation
  rate_limit_buckets: List<CodexRateLimitBucketVerdict>
  unknown_frame_digests: List<std.content_hash.ContentHash>
  retention_failed: Bool
}

fn empty_account_trip_parse_acc() -> AccountTripParseAcc {
  AccountTripParseAcc {
    initialize: AccountTripResponseAbsent,
    account_read: AccountTripResponseAbsent,
    account_realm: CodexAccountRealmUnobserved { reason: codex_account_realm_unobserved_default },
    rate_limits: AccountTripResponseAbsent,
    rate_limit_buckets: [],
    unknown_frame_digests: [],
    retention_failed: false,
  }
}

fn digest_account_trip_line(
  line: String,
  evidence_root: std.types.FilePath,
  mode: AccountTripDigestMode,
) -> std.content_hash.ContentHash? {
  if line == "" {
    none
  } else {
    match mode {
      AccountTripDigestStructural =>
        Present { value: content_hash_of_value(value: line as std.types.NonEmptyStr) }
      AccountTripDigestRetainPrivateSha512 =>
        match retain_private_evidence_bytes_detailed(root: evidence_root, bytes: line) {
          PrivateEvidenceBytesRetentionRefused { cause: _ } => none
          PrivateEvidenceBytesRetained { ref: _, content_digest: digest, byte_count: _ } =>
            Present { value: digest }
        }
    }
  }
}

fn push_unknown_digest(
  acc: AccountTripParseAcc,
  line: String,
  evidence_root: std.types.FilePath,
  mode: AccountTripDigestMode,
) -> AccountTripParseAcc {
  match digest_account_trip_line(line: line, evidence_root: evidence_root, mode: mode) {
    Absent =>
      match mode {
        AccountTripDigestStructural =>
          AccountTripParseAcc {
            initialize: acc.initialize,
            account_read: acc.account_read,
                    account_realm: acc.account_realm,
            rate_limits: acc.rate_limits,
            rate_limit_buckets: acc.rate_limit_buckets,
            unknown_frame_digests: acc.unknown_frame_digests,
            retention_failed: acc.retention_failed,
          }
        AccountTripDigestRetainPrivateSha512 =>
          AccountTripParseAcc {
            initialize: acc.initialize,
            account_read: acc.account_read,
                    account_realm: acc.account_realm,
            rate_limits: acc.rate_limits,
            rate_limit_buckets: acc.rate_limit_buckets,
            unknown_frame_digests: acc.unknown_frame_digests,
            retention_failed: true,
          }
      }
    Present { value: digest } =>
      AccountTripParseAcc {
        initialize: acc.initialize,
        account_read: acc.account_read,
                    account_realm: acc.account_realm,
        rate_limits: acc.rate_limits,
        rate_limit_buckets: acc.rate_limit_buckets,
        unknown_frame_digests: acc.unknown_frame_digests |> list_push(digest),
        retention_failed: acc.retention_failed,
      }
  }
}

fn buckets_from_rate_limits_frame(
  current: AccountTripResponseObservation,
  prior_buckets: List<CodexRateLimitBucketVerdict>,
  obj: extdeps.languages.json.emit.JsonValue,
) -> List<CodexRateLimitBucketVerdict> {
  match current {
    AccountTripResponseAbsent =>
      match json_object_unique_member(v: obj, key: "result") {
        JsonMemberFound { value: result } => rate_limit_buckets_from_result(result: result)
        _ => []
      }
    AccountTripResponseUnique { response: _ } => prior_buckets
    AccountTripResponseDuplicate { id: _, count: _ } => prior_buckets
  }
}

data codex_account_realm_duplicate_frame_note: String = "FIRST FRAME WINS, mirroring buckets_from_rate_limits_frame. A duplicate id=2 response already makes the disposition AccountTripResponseDuplicate, which the classifier treats as Incomplete, so the realm from a second frame could never be trusted anyway — and letting it overwrite would mean a later frame silently replacing the account the first one reported. Duplicates keep the prior value and the duplicate observation carries the refusal."

fn realm_from_account_read_frame(
  current: AccountTripResponseObservation,
  prior_realm: CodexAccountRealm,
  obj: extdeps.languages.json.emit.JsonValue,
) -> CodexAccountRealm {
  match current {
    AccountTripResponseAbsent =>
      match json_object_unique_member(v: obj, key: "result") {
        JsonMemberFound { value: result } => codex_account_realm_from_result(result: result)
        JsonMemberAbsent => prior_realm
        JsonMemberDuplicated { count: _ } => prior_realm
        JsonMemberNotAnObject => prior_realm
      }
    AccountTripResponseUnique { response: _ } => prior_realm
    AccountTripResponseDuplicate { id: _, count: _ } => prior_realm
  }
}

fn absorb_account_trip_line(
  acc: AccountTripParseAcc,
  line: String,
  evidence_root: std.types.FilePath,
  mode: AccountTripDigestMode,
) -> AccountTripParseAcc {
  let trimmed = line.trim()
  if trimmed == "" {
    acc
  } else {
    match parse_json(s: trimmed) {
      Absent =>
        push_unknown_digest(
          acc: acc,
          line: trimmed,
          evidence_root: evidence_root,
          mode: mode,
        )
      Present { value: parsed } =>
        match json_object_unique_member(v: parsed, key: "id") {
          JsonMemberFound { value: idv } =>
            match gunbc.codex_app_server_press.json_rpc_id_as_int(v: idv) {
              Absent =>
                push_unknown_digest(
                  acc: acc,
                  line: trimmed,
                  evidence_root: evidence_root,
                  mode: mode,
                )
              Present { value: n } =>
                let disposition = disposition_for_id_response(id: n, obj: parsed)
                if n == 1 {
                  AccountTripParseAcc {
                    initialize: absorb_id_response(
                      current: acc.initialize,
                      id: n,
                      disposition: disposition,
                    ),
                    account_read: acc.account_read,
                    account_realm: acc.account_realm,
                    rate_limits: acc.rate_limits,
                    rate_limit_buckets: acc.rate_limit_buckets,
                    unknown_frame_digests: acc.unknown_frame_digests,
                    retention_failed: acc.retention_failed,
                  }
                } else if n == 2 {
                  AccountTripParseAcc {
                    initialize: acc.initialize,
                    account_read: absorb_id_response(
                      current: acc.account_read,
                      id: n,
                      disposition: disposition,
                    ),
                    account_realm: realm_from_account_read_frame(
                      current: acc.account_read,
                      prior_realm: acc.account_realm,
                      obj: parsed,
                    ),
                    rate_limits: acc.rate_limits,
                    rate_limit_buckets: acc.rate_limit_buckets,
                    unknown_frame_digests: acc.unknown_frame_digests,
                    retention_failed: acc.retention_failed,
                  }
                } else if n == 3 {
                  AccountTripParseAcc {
                    initialize: acc.initialize,
                    account_read: acc.account_read,
                    account_realm: acc.account_realm,
                    rate_limits: absorb_id_response(
                      current: acc.rate_limits,
                      id: n,
                      disposition: disposition,
                    ),
                    rate_limit_buckets: buckets_from_rate_limits_frame(
                      current: acc.rate_limits,
                      prior_buckets: acc.rate_limit_buckets,
                      obj: parsed,
                    ),
                    unknown_frame_digests: acc.unknown_frame_digests,
                    retention_failed: acc.retention_failed,
                  }
                } else {
                  push_unknown_digest(
                    acc: acc,
                    line: trimmed,
                    evidence_root: evidence_root,
                    mode: mode,
                  )
                }
            }
          _ =>
            push_unknown_digest(
              acc: acc,
              line: trimmed,
              evidence_root: evidence_root,
              mode: mode,
            )
        }
    }
  }
}

fn codex_credential_liveness_from_rate_trip(
  rate_limits: AccountTripResponseObservation,
  buckets: List<CodexRateLimitBucketVerdict>,
) -> CodexCredentialLiveness {
  match observation_to_disposition(obs: rate_limits) {
    AccountTripLoginRequiredSignal =>
      CodexCredentialDead {
        reason: "account/rateLimits/read refused login; token not exercised upstream" as std.types.NonEmptyStr,
      }
    AccountTripQuotaSignal =>
      CodexCredentialLivenessUnobserved {
        reason: "account/rateLimits/read reported quota on the liveness probe" as std.types.NonEmptyStr,
      }
    AccountTripResultOk =>
      if count(buckets) > 0 {
        CodexCredentialLive { bucket_count: count(buckets) }
      } else {
        CodexCredentialDead {
          reason: "account/rateLimits/read returned no decodable buckets; token not exercised upstream" as std.types.NonEmptyStr,
        }
      }
    AccountTripMissing =>
      CodexCredentialLivenessUnobserved {
        reason: "account/rateLimits/read response missing on this trip" as std.types.NonEmptyStr,
      }
    AccountTripNativeCauseUnknown { message: m } =>
      CodexCredentialLivenessUnobserved { reason: m }
    AccountTripNativeCauseNumericCode { code: c } =>
      CodexCredentialLivenessUnobserved {
        reason: concat("account/rateLimits/read json-rpc error code ", to_string(n: c), "") as std.types.NonEmptyStr,
      }
    AccountTripNativeCauseMessageUnreadable =>
      CodexCredentialLivenessUnobserved {
        reason: "account/rateLimits/read error message unreadable" as std.types.NonEmptyStr,
      }
  }
}

fn classify_account_trip(acc: AccountTripParseAcc) -> AccountStandingClassification {
  if acc.retention_failed {
    AccountStandingIncomplete
  } else if observation_is_duplicate(obs: acc.initialize)
    || observation_is_duplicate(obs: acc.account_read)
    || observation_is_duplicate(obs: acc.rate_limits) {
    AccountStandingIncomplete
  } else {
    let init = observation_to_disposition(obs: acc.initialize)
    let acct = observation_to_disposition(obs: acc.account_read)
    let rate = observation_to_disposition(obs: acc.rate_limits)
    match init {
      AccountTripMissing => AccountStandingInitializeMissing
      AccountTripLoginRequiredSignal => AccountStandingLoginRequired
      AccountTripQuotaSignal => AccountStandingIncomplete
      AccountTripNativeCauseUnknown { message: _ } => AccountStandingIncomplete
      AccountTripNativeCauseNumericCode { code: _ } => AccountStandingIncomplete
      AccountTripNativeCauseMessageUnreadable => AccountStandingIncomplete
      AccountTripResultOk =>
        match acct {
          AccountTripLoginRequiredSignal => AccountStandingLoginRequired
          AccountTripMissing => AccountStandingIncomplete
          AccountTripQuotaSignal => AccountStandingIncomplete
          AccountTripNativeCauseUnknown { message: _ } => AccountStandingIncomplete
          AccountTripNativeCauseNumericCode { code: _ } => AccountStandingIncomplete
          AccountTripNativeCauseMessageUnreadable => AccountStandingIncomplete
          AccountTripResultOk =>
            match rate {
              AccountTripResultOk =>
                classification_from_codex_default_bucket(buckets: acc.rate_limit_buckets)
              AccountTripQuotaSignal => AccountStandingQuotaReached
              AccountTripLoginRequiredSignal => AccountStandingLoginRequired
              AccountTripMissing => AccountStandingIncomplete
              AccountTripNativeCauseUnknown { message: _ } => AccountStandingIncomplete
              AccountTripNativeCauseNumericCode { code: _ } => AccountStandingIncomplete
              AccountTripNativeCauseMessageUnreadable => AccountStandingIncomplete
            }
        }
    }
  }
}

fn parse_account_trip_session(
  stdout: String,
  stderr: String,
  evidence_root: std.types.FilePath,
  mode: AccountTripDigestMode,
) -> CodexAccountStandingEvidence {
  let acc = fold(
    split(s: stdout, delimiter: "\n"),
    init: empty_account_trip_parse_acc(),
    f: (a, line) =>
      absorb_account_trip_line(
        acc: a,
        line: line,
        evidence_root: evidence_root,
        mode: mode,
      ),
  )
  let stderr_bytes = if stderr == "" { "(empty-stderr)" } else { stderr }
  let stderr_digest = digest_account_trip_line(
    line: stderr_bytes,
    evidence_root: evidence_root,
    mode: mode,
  )
  let retention_failed = match mode {
    AccountTripDigestStructural => acc.retention_failed
    AccountTripDigestRetainPrivateSha512 =>
      acc.retention_failed
        || match stderr_digest {
          Absent => true
          Present { value: _ } => false
        }
  }
  let acc_final = AccountTripParseAcc {
    initialize: acc.initialize,
    account_read: acc.account_read,
    account_realm: acc.account_realm,
    rate_limits: acc.rate_limits,
    rate_limit_buckets: acc.rate_limit_buckets,
    unknown_frame_digests: acc.unknown_frame_digests,
    retention_failed: retention_failed,
  }
  CodexAccountStandingEvidence {
    itinerary: codex_press_account_trip_methods(),
    initialize: acc_final.initialize,
    account_read: acc_final.account_read,
    account_realm: acc_final.account_realm,
    credential_liveness: codex_credential_liveness_from_rate_trip(
      rate_limits: acc_final.rate_limits,
      buckets: acc_final.rate_limit_buckets,
    ),
    rate_limits: acc_final.rate_limits,
    rate_limit_buckets: acc_final.rate_limit_buckets,
    unknown_frame_digests: acc_final.unknown_frame_digests,
    stderr_digest: stderr_digest,
    classification: classify_account_trip(acc: acc_final),
  }
}

type GunbcStdioCapture {
  stdout: String
  stderr: String
  exit_code: Int?
}

fn parse_gunbc_exit_marker(combined: String) -> Int? {
  let parts = split(s: combined, delimiter: "---GUNBC_EXIT---")
  match parts.skip(n: 1).first() {
    Absent => none
    Present { value: after } => {
      let code_parts = split(s: after, delimiter: "---")
      match code_parts.first() {
        Absent => none
        Present { value: code_s } => parse_int(s: code_s.trim())
      }
    }
  }
}

fn split_gunbc_stdio_capture(combined: String) -> GunbcStdioCapture {
  let exit_code = parse_gunbc_exit_marker(combined: combined)
  let parts = split(s: combined, delimiter: "---GUNBC_STDOUT---")
  match parts.skip(n: 1).first() {
    Absent =>
      GunbcStdioCapture { stdout: combined, stderr: "", exit_code: exit_code }
    Present { value: after_marker } => {
      let err_parts = split(s: after_marker, delimiter: "---GUNBC_STDERR---")
      match err_parts.first() {
        Absent =>
          GunbcStdioCapture {
            stdout: after_marker.trim(),
            stderr: "",
            exit_code: exit_code,
          }
        Present { value: out } =>
          match err_parts.skip(n: 1).first() {
            Absent =>
              GunbcStdioCapture {
                stdout: out.trim(),
                stderr: "",
                exit_code: exit_code,
              }
            Present { value: err } =>
              GunbcStdioCapture {
                stdout: out.trim(),
                stderr: err.trim(),
                exit_code: exit_code,
              }
          }
      }
    }
  }
}

fn preflight_subject_from_bundle(
  bundle: gunbc.package_delivery.CodexRuntimeBundle,
  binding: gunbc.provider_interface_binding.ProviderInterfaceBinding,
  probe_key: ProviderProbeKey,
  codex_home: std.types.FilePath,
) -> CodexAccountPreflightSubject {
  CodexAccountPreflightSubject {
    runtime: CodexRuntimeBundleReceiptRef {
      receipt_identity: bundle.receipt.receipt_identity,
    },
    interface: binding,
    probe_key: probe_key,
    credential: AmbientCodexCredentialContext { codex_home: codex_home },
  }
}

fn outcome_from_standing_receipt(receipt: CodexAccountStandingReceipt) -> CodexPressOutcome {
  match receipt.wire_evidence {
    Absent =>
      CodexPressUnavailable {
        reason: "account standing requires retained wire evidence" as std.types.NonEmptyStr,
        process: receipt.process,
      }
    Present { value: _ } => {
      let classification = receipt.standing.evidence.classification
      match classification {
        AccountStandingAuthenticatedRateLimitsReadable =>
          CodexPressAccountReady { receipt: receipt }
        AccountStandingLoginRequired =>
          CodexPressLoginRequired {
            reason: "codex app-server account trip requires login" as std.types.NonEmptyStr,
            receipt: receipt,
          }
        AccountStandingQuotaReached =>
          CodexPressRefused {
            reason: "codex quota exhausted at account/rateLimits/read" as std.types.NonEmptyStr,
            receipt: receipt,
          }
        AccountStandingInitializeMissing =>
          CodexPressRefused {
            reason: "codex app-server trip missing initialize result" as std.types.NonEmptyStr,
            receipt: receipt,
          }
        AccountStandingIncomplete =>
          CodexPressRefused {
            reason: "codex app-server account trip incomplete" as std.types.NonEmptyStr,
            receipt: receipt,
          }
      }
    }
  }
}

fn parse_account_trip_stdout_for_tests(stdout: String) -> CodexAccountStandingEvidence {
  parse_account_trip_session(
    stdout: stdout,
    stderr: "",
    evidence_root: codex_press_hermetic_evidence_root,
    mode: AccountTripDigestStructural,
  )
}

fn process_receipt_from_capture(
  capture: GunbcStdioCapture,
  wire: gunbc.provider_wire_evidence.ProviderWireEvidenceReceipt?,
  run_success: Bool,
) -> ProviderProcessReceipt {
  match capture.exit_code {
    Present { value: code } =>
      ProviderProcessReceipt {
        exit: ProviderProcessExited { code: code },
        wire: wire,
      }
    Absent =>
      if run_success {
        ProviderProcessReceipt {
          exit: ProviderProcessObservationFailed,
          wire: wire,
        }
      } else {
        ProviderProcessReceipt {
          exit: ProviderProcessObservationFailed,
          wire: wire,
        }
      }
  }
}

fn observe_codex_account_preflight(
  bundle: gunbc.package_delivery.CodexRuntimeBundle,
  probe_key: ProviderProbeKey,
  evidence_root: std.types.FilePath,
  codex_home: std.types.FilePath,
) -> CodexPressOutcome {
  match project_codex_app_server_stdio_binding(bundle: bundle) {
    RequiredProviderInterfaceUnavailable { interface: _, reason } =>
      CodexPressUnavailable {
        reason: reason,
        process: ProviderProcessReceipt {
          exit: ProviderProcessObservationFailed,
          wire: none,
        },
      }
    ProviderInterfaceResolved { binding: projected } => {
      let present = shell.Test.IsFile(path: projected.executable.path)
      if present.is_file == false {
        CodexPressUnavailable {
          reason: "bundled Codex native executable absent at binding path" as std.types.NonEmptyStr,
          process: ProviderProcessReceipt {
            exit: ProviderProcessObservationFailed,
            wire: none,
          },
        }
      } else {
        let script = retained_foreign(
          body: codex_press_account_trip_script(
            executable: projected.executable.path,
            codex_home: codex_home,
          ),
          reason: "Codex app-server held-open account session; exit+stdout/stderr captured for typed NDJSON id correlation" as std.types.NonEmptyStr,
        )
        let run = shell.Exec.Run(script: script)
        let capture = split_gunbc_stdio_capture(combined: run.stdout)
        let wire_capture = retain_provider_wire_capture(
          evidence_root: evidence_root,
          stdout: capture.stdout,
          stderr: capture.stderr,
          success: run.success,
          exit_code: capture.exit_code,
        )
        let process = process_receipt_from_capture(
          capture: capture,
          wire: match wire_capture {
            ProviderWireCaptureOk { receipt: wire } => Present { value: wire }
            ProviderWireCaptureRefused { cause: _ } => none
          },
          run_success: run.success,
        )
        match wire_capture {
          ProviderWireCaptureRefused { cause: reason } =>
            CodexPressUnavailable {
              reason: reason,
              process: process,
            }
          ProviderWireCaptureOk { receipt: wire } => {
            let evidence = parse_account_trip_session(
              stdout: capture.stdout,
              stderr: capture.stderr,
              evidence_root: evidence_root,
              mode: AccountTripDigestRetainPrivateSha512,
            )
            let session_binding = binding_from_initialize_session(
              bundle: bundle,
              projected: projected,
            )
            let subject = preflight_subject_from_bundle(
              bundle: bundle,
              binding: session_binding,
              probe_key: probe_key,
              codex_home: codex_home,
            )
            let receipt = CodexAccountStandingReceipt {
              subject: subject,
              standing: account_standing_summary_from_evidence(evidence: evidence),
              wire_evidence: Present { value: wire },
              process: ProviderProcessReceipt {
                exit: process.exit,
                wire: Present { value: wire },
              },
            }
            match capture.exit_code {
              Present { value: code } =>
                if code != 0 {
                  CodexPressUnavailable {
                    reason: "codex app-server process exited nonzero" as std.types.NonEmptyStr,
                    process: receipt.process,
                  }
                } else {
                  outcome_from_standing_receipt(receipt: receipt)
                }
              Absent =>
                CodexPressUnavailable {
                  reason: "codex app-server process exit observation refused" as std.types.NonEmptyStr,
                  process: receipt.process,
                }
            }
          }
        }
      }
    }
  }
}
