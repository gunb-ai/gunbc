module gunbc.codex_app_server_press

import std.types { NonEmptyStr, String, FilePath, List, Bool }
import gunbc.roadmap_workflow_command { AttemptKey }
import gunbc.roadmap_model { RoadmapNodeIdentity }
import gunbc.provider_interface_binding {
  ProviderInterfaceBinding,
  ProviderInterfaceResolved,
  RequiredProviderInterfaceUnavailable,
  observe_bind_codex_app_server_stdio,
  project_codex_app_server_stdio_binding,
}
import gunbc.package_delivery { CodexRuntimeBundle }
import extdeps.llm.codex_app_server {
  CodexAppServerMethod,
  CodexAppServerInitialize,
  CodexAppServerAccountRead,
  CodexAppServerAccountRateLimitsRead,
  CodexAppServerThreadStart,
  CodexAppServerTurnStart,
  codex_app_server_initialize_request_line,
  codex_app_server_account_read_request_line,
  codex_app_server_rate_limits_read_request_line,
}
import gunbc.retained_shell_script { retained_foreign }
import extdeps.shell

data codex_press_note: String = "Account-standing observation for the Codex app-server specimen. This module does NOT claim a provider turn: thread/start and turn/start are target itinerary only until a subjectful WorkerTurn binding lands. An account-ready result must never be labeled turn-started."

data codex_press_specimen_node_identity: RoadmapNodeIdentity = "codex-app-server-press-vertical" as RoadmapNodeIdentity

type CodexPressStart {
  node_identity: RoadmapNodeIdentity
  attempt_key: AttemptKey
  turn_key: String
  binding: ProviderInterfaceBinding
  workspace_root: FilePath
  head_sha: String
}

type CodexPressItinerary = List<CodexAppServerMethod>

fn codex_press_account_trip_methods() -> CodexPressItinerary {
  [
    CodexAppServerInitialize,
    CodexAppServerAccountRead,
    CodexAppServerAccountRateLimitsRead,
  ]
}

data codex_press_turn_itinerary_target_note: String = "TARGET plan only — not executed by observe_codex_press_account_trip. A TurnStarted constructor must not exist until both thread/start and turn/start responses supply exact provider IDs joined to a WorkerTurn."

fn codex_press_turn_itinerary_target() -> CodexPressItinerary {
  concat(
    codex_press_account_trip_methods(),
    [CodexAppServerThreadStart, CodexAppServerTurnStart],
  )
}

fn codex_press_method_itinerary() -> CodexPressItinerary {
  codex_press_turn_itinerary_target()
}

type CodexPressStartAdmission
  = CodexPressStartAdmitted {
      start: CodexPressStart
      itinerary: CodexPressItinerary
    }
  | CodexPressBindingUnavailable {
      reason: NonEmptyStr
    }

fn admit_codex_press_start(
  node_identity: RoadmapNodeIdentity,
  attempt_key: AttemptKey,
  turn_key: String,
  bundle: CodexRuntimeBundle,
  workspace_root: FilePath,
  head_sha: String,
) -> CodexPressStartAdmission {
  match observe_bind_codex_app_server_stdio(bundle: bundle) {
    ProviderInterfaceResolved { binding } =>
      CodexPressStartAdmitted {
        start: CodexPressStart {
          node_identity: node_identity,
          attempt_key: attempt_key,
          turn_key: turn_key,
          binding: binding,
          workspace_root: workspace_root,
          head_sha: head_sha,
        },
        itinerary: codex_press_account_trip_methods(),
      }
    RequiredProviderInterfaceUnavailable { interface: _, reason } =>
      CodexPressBindingUnavailable { reason: reason }
  }
}

fn admit_codex_press_start_projected(
  node_identity: RoadmapNodeIdentity,
  attempt_key: AttemptKey,
  turn_key: String,
  bundle: CodexRuntimeBundle,
  workspace_root: FilePath,
  head_sha: String,
) -> CodexPressStartAdmission {
  match project_codex_app_server_stdio_binding(bundle: bundle) {
    ProviderInterfaceResolved { binding } =>
      CodexPressStartAdmitted {
        start: CodexPressStart {
          node_identity: node_identity,
          attempt_key: attempt_key,
          turn_key: turn_key,
          binding: binding,
          workspace_root: workspace_root,
          head_sha: head_sha,
        },
        itinerary: codex_press_account_trip_methods(),
      }
    RequiredProviderInterfaceUnavailable { interface: _, reason } =>
      CodexPressBindingUnavailable { reason: reason }
  }
}

data codex_press_standing_summary_note: String = "Standing summaries are REDACTED projections of account-trip stdout, NOT retained raw NDJSON frames. Raw wire bytes, request IDs, and unknown notifications are not yet modeled; do not treat these strings as evidence stronger than a typed standing classification."

type CodexAccountStandingSummary {
  methods_attempted: NonEmptyStr
  redacted_standing: String
}

type CodexAccountStandingReceipt {
  node_identity: RoadmapNodeIdentity
  attempt_key: AttemptKey
  standing: CodexAccountStandingSummary
}

type CodexPressOutcome
  = CodexPressAccountReady {
      receipt: CodexAccountStandingReceipt
    }
  | CodexPressLoginRequired {
      reason: NonEmptyStr
      standing: CodexAccountStandingSummary
    }
  | CodexPressUnavailable {
      reason: NonEmptyStr
    }
  | CodexPressRefused {
      reason: NonEmptyStr
      standing: CodexAccountStandingSummary
    }

fn codex_press_outcome_wire_status(outcome: CodexPressOutcome) -> String {
  match outcome {
    CodexPressAccountReady { receipt: _ } => "account_ready"
    CodexPressLoginRequired { reason: _, standing: _ } => "login_required"
    CodexPressUnavailable { reason: _ } => "unavailable"
    CodexPressRefused { reason: _, standing: _ } => "press_refused"
  }
}

fn codex_press_outcome_operator_caption(outcome: CodexPressOutcome) -> String {
  match outcome {
    CodexPressAccountReady { receipt: _ } => "account ready"
    CodexPressLoginRequired { reason: _, standing: _ } => "login required"
    CodexPressUnavailable { reason: _ } => "unavailable"
    CodexPressRefused { reason, standing: _ } =>
      if (reason as String).contains("quota") {
        "quota exhausted"
      } else {
        "refused"
      }
  }
}

fn codex_press_account_trip_script(executable: FilePath) -> String {
  concat(
    "REQ=$(mktemp); OUT=$(mktemp); ",
    concat(
      "printf '%s\\n' '",
      concat(
        codex_app_server_initialize_request_line() as String,
        concat(
          "' >\"$REQ\"; printf '%s\\n' '",
          concat(
            codex_app_server_account_read_request_line() as String,
            concat(
              "' >>\"$REQ\"; printf '%s\\n' '",
              concat(
                codex_app_server_rate_limits_read_request_line() as String,
                concat(
                  "' >>\"$REQ\"; (cat \"$REQ\"; sleep 3) | '",
                  concat(
                    executable as String,
                    "' app-server --stdio >\"$OUT\" 2>/dev/null; cat \"$OUT\"; rm -f \"$REQ\" \"$OUT\"",
                  ),
                ),
              ),
            ),
          ),
        ),
      ),
    ),
  )
}

fn redact_press_stdout_for_receipt(stdout: String) -> String {
  if stdout.contains("userAgent") == false {
    "initialize_missing"
  } else if stdout.contains("requiresOpenaiAuth") || stdout.contains("authentication required") {
    "initialize_ok; login_required"
  } else if stdout.contains("rate_limit_reached") {
    "initialize_ok; account_read_ok; rate_limits_quota_reached"
  } else if stdout.contains("\"account\"") {
    "initialize_ok; account_read_ok; rate_limits_observed"
  } else {
    "initialize_ok; account_or_limits_incomplete"
  }
}

fn account_standing_summary(redacted: String) -> CodexAccountStandingSummary {
  CodexAccountStandingSummary {
    methods_attempted: "initialize; account/read; account/rateLimits/read" as NonEmptyStr,
    redacted_standing: redacted,
  }
}

fn observe_codex_press_account_trip(
  binding: ProviderInterfaceBinding,
  node_identity: RoadmapNodeIdentity,
  attempt_key: AttemptKey,
  turn_key: String,
  head_sha: String,
) -> CodexPressOutcome {
  let script = retained_foreign(
    body: codex_press_account_trip_script(executable: binding.executable.path),
    reason: "Codex app-server account-standing trip pending typed stdio session transport" as NonEmptyStr,
  )
  let run = shell.Exec.Run(script: script)
  let summary = redact_press_stdout_for_receipt(stdout: run.stdout)
  let standing = account_standing_summary(redacted: summary)
  if run.success == false {
    CodexPressUnavailable {
      reason: "codex app-server account trip exec refused" as NonEmptyStr,
    }
  } else if summary.contains("initialize_missing") {
    CodexPressRefused {
      reason: "codex app-server trip missing initialize result" as NonEmptyStr,
      standing: standing,
    }
  } else if summary.contains("login_required") {
    CodexPressLoginRequired {
      reason: "codex app-server account trip requires login" as NonEmptyStr,
      standing: standing,
    }
  } else if summary.contains("quota_reached") {
    CodexPressRefused {
      reason: "codex quota exhausted at account/rateLimits/read" as NonEmptyStr,
      standing: standing,
    }
  } else if summary.contains("account_read_ok") {
    CodexPressAccountReady {
      receipt: CodexAccountStandingReceipt {
        node_identity: node_identity,
        attempt_key: attempt_key,
        standing: standing,
      },
    }
  } else {
    CodexPressRefused {
      reason: "codex app-server account trip incomplete" as NonEmptyStr,
      standing: standing,
    }
  }
}

fn press_codex_app_server_for_bundle(
  bundle: CodexRuntimeBundle,
  node_identity: RoadmapNodeIdentity,
  attempt_key: AttemptKey,
  turn_key: String,
  workspace_root: FilePath,
  head_sha: String,
) -> CodexPressOutcome {
  match admit_codex_press_start(
    node_identity: node_identity,
    attempt_key: attempt_key,
    turn_key: turn_key,
    bundle: bundle,
    workspace_root: workspace_root,
    head_sha: head_sha,
  ) {
    CodexPressBindingUnavailable { reason } =>
      CodexPressUnavailable { reason: reason }
    CodexPressStartAdmitted { start, itinerary: _ } =>
      observe_codex_press_account_trip(
        binding: start.binding,
        node_identity: start.node_identity,
        attempt_key: start.attempt_key,
        turn_key: start.turn_key,
        head_sha: start.head_sha,
      )
  }
}
