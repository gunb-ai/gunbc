module gunbc.codex_app_server_press

import std.types { NonEmptyStr, String }
import gunbc.provider_interface_binding {
  ProviderInterfaceBinding,
  ProviderInterfaceResolution,
  ProviderInterfaceResolved,
  RequiredProviderInterfaceUnavailable,
  bind_codex_app_server_stdio,
}
import gunbc.package_delivery {
  CodexRuntimeBundle,
}
import extdeps.llm.codex_app_server {
  CodexAppServerMethod,
  CodexAppServerInitialize,
  CodexAppServerAccountRead,
  CodexAppServerRateLimitsRead,
  CodexAppServerThreadTurn,
}

data codex_press_note: String = "ONE press → one attributable attempt/turn. Sequence: Start → initialize → account/read → rateLimits/read → thread/turn → terminal receipt. Live JSON-RPC execution and credential lease land next; this module owns the subjectful Start carrier and the method itinerary so the UI cannot treat dispatch-accepted as work observed."

type CodexPressAttemptId = NonEmptyStr where brand("CodexPressAttemptId")
type CodexPressTurnId = NonEmptyStr where brand("CodexPressTurnId")

type CodexPressStart {
  attempt: CodexPressAttemptId
  turn: CodexPressTurnId
  binding: ProviderInterfaceBinding
}

type CodexPressItinerary = List<CodexAppServerMethod>

fn codex_press_method_itinerary() -> CodexPressItinerary {
  [
    CodexAppServerInitialize,
    CodexAppServerAccountRead,
    CodexAppServerRateLimitsRead,
    CodexAppServerThreadTurn,
  ]
}

type CodexPressStartAdmission
  = CodexPressStartAdmitted {
      start: CodexPressStart
      itinerary: CodexPressItinerary
    }
  | CodexPressBindingUnavailable {
      reason: NonEmptyStr
    }

fn admit_codex_press_start(
  attempt: CodexPressAttemptId,
  turn: CodexPressTurnId,
  bundle: CodexRuntimeBundle,
) -> CodexPressStartAdmission {
  match bind_codex_app_server_stdio(bundle: bundle) {
    ProviderInterfaceResolved { binding } =>
      CodexPressStartAdmitted {
        start: CodexPressStart {
          attempt: attempt,
          turn: turn,
          binding: binding,
        },
        itinerary: codex_press_method_itinerary(),
      }
    RequiredProviderInterfaceUnavailable { interface: _, reason } =>
      CodexPressBindingUnavailable { reason: reason }
  }
}
