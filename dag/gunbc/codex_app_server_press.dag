data codex_press_note: String = "Account-standing observation for the Codex app-server specimen. This module does NOT claim a provider turn: thread/start and turn/start are target itinerary only until a subjectful WorkerTurn binding lands. AccountStandingAuthenticatedRateLimitsReadable means initialize+account/read succeeded AND RateLimitSnapshot capacity decode shows the account can accept work (window usedPercent below 100, spendControlReached not true, rateLimitReachedType absent). An empty rateLimits object answers the endpoint without proving capacity and classifies Incomplete — never Ready. An authenticated/capacity-available result must never be labeled turn-started."

data codex_press_hermetic_evidence_root: FilePath = "/tmp/gunbc-codex-press-evidence" as FilePath

data account_trip_digest_mode_note: String = "Hermetic parse helpers (parse_account_trip_stdout_for_tests) use AccountTripDigestStructural — content_hash_of_value fingerprints with zero host effects, so discovery stays mock-free. Wet observe_codex_account_preflight uses AccountTripDigestRetainPrivateSha512 under a caller-supplied evidence_root. Structural digests are NOT durable content identities; private SHA-512 retention is."

data account_standing_authenticated_rate_limits_readable_note: String = "Ready requires decoded capacity from the cited RateLimitSnapshot fields (primary/secondary usedPercent, spendControlReached, rateLimitReachedType). Empty rateLimits:\{\} is Incomplete. QuotaReached covers spend-control, reached-type, and saturated windows. Bridge into gunbc.provider_standing LimitObservedAvailable|LimitUnavailableUntilReset|LimitExhausted dissolves when that consumer lands on this receipt."

type AccountTripDigestMode
  = AccountTripDigestStructural
  | AccountTripDigestRetainPrivateSha512

type CodexRuntimeBundleReceiptRef {
  receipt_identity: ContentHash
}

type ProviderProbeKey = NonEmptyStr

type AmbientCodexCredentialContext {
  codex_home: FilePath
}

type CodexAccountPreflightSubject {
  runtime: CodexRuntimeBundleReceiptRef
  interface: ProviderInterfaceBinding
  probe_key: ProviderProbeKey
  credential: AmbientCodexCredentialContext
}

type CodexPressItinerary = List<CodexAppServerMethod>

fn codex_press_account_trip_methods() -> CodexPressItinerary {
  [
    CodexAppServerInitialize,
    CodexAppServerAccountRead,
    CodexAppServerAccountRateLimitsRead,
  ]
}

data codex_press_turn_itinerary_target_note: String = "TARGET plan only — not executed by observe_codex_account_preflight. A TurnStarted constructor must not exist until both thread/start and turn/start responses supply exact provider IDs joined to a WorkerTurn."

fn codex_press_turn_itinerary_target() -> CodexPressItinerary {
  concat(
    codex_press_account_trip_methods(),
    [CodexAppServerThreadStart, CodexAppServerTurnStart],
  )
}

fn codex_press_method_itinerary() -> CodexPressItinerary {
  codex_press_turn_itinerary_target()
}

data codex_press_standing_evidence_note: String = "Account standing is derived from ONE held-open app-server --stdio session: three JSON-RPC requests (ids 1/2/3) with per-id typed result/error correlation and duplicate-id refusal. Wire capture is retained privately under a caller-supplied evidence_root via gunbc.provider_wire_evidence (SHA-512 content-addressed stdout/stderr). Unknown NDJSON frames are digested SHA-512 through the same retention path; retention failure is Incomplete, never silent drop. AuthenticatedRateLimitsReadable requires AccountTripResponseUnique on ids 1/2/3 with typed result bodies AND retained wire evidence. Incomplete is refused (RED). Login/quota are typed arms. methods_attempted is the typed itinerary, never a free-form string that can disagree with the outcome. Production placement supplies gunbc.host_layout.ProviderRuntimePlacement.wire_evidence_root (srv1 via srv1_provider_runtime_placement) and GunbcHostLayout.roadmap_codex_home."

type AccountTripFrameDisposition
  = AccountTripResultOk
  | AccountTripLoginRequiredSignal
  | AccountTripQuotaSignal
  | AccountTripMissing
  | AccountTripNativeCauseUnknown { message: NonEmptyStr }

type AccountTripResponseObservation
  = AccountTripResponseAbsent
  | AccountTripResponseUnique { response: AccountTripFrameDisposition }
  | AccountTripResponseDuplicate { id: Int, count: Int }

type AccountStandingClassification
  = AccountStandingAuthenticatedRateLimitsReadable
  | AccountStandingLoginRequired
  | AccountStandingQuotaReached
  | AccountStandingInitializeMissing
  | AccountStandingIncomplete

type CodexAccountStandingEvidence {
  itinerary: CodexPressItinerary
  initialize: AccountTripResponseObservation
  account_read: AccountTripResponseObservation
  rate_limits: AccountTripResponseObservation
  unknown_frame_digests: List<ContentHash>
  stderr_digest: ContentHash?
  classification: AccountStandingClassification
}

type CodexAccountStandingSummary {
  evidence: CodexAccountStandingEvidence
}

type ProviderProcessExit
  = ProviderProcessExited { code: Int }
  | ProviderProcessObservationFailed

type ProviderProcessReceipt {
  exit: ProviderProcessExit
  wire: ProviderWireEvidenceReceipt?
}

type CodexAccountStandingReceipt {
  subject: CodexAccountPreflightSubject
  standing: CodexAccountStandingSummary
  wire_evidence: ProviderWireEvidenceReceipt?
  process: ProviderProcessReceipt
}

type CodexPressOutcome
  = CodexPressAccountReady {
      receipt: CodexAccountStandingReceipt
    }
  | CodexPressLoginRequired {
      reason: NonEmptyStr
      receipt: CodexAccountStandingReceipt
    }
  | CodexPressUnavailable {
      reason: NonEmptyStr
      process: ProviderProcessReceipt
    }
  | CodexPressRefused {
      reason: NonEmptyStr
      receipt: CodexAccountStandingReceipt
    }

fn codex_press_outcome_wire_status(outcome: CodexPressOutcome) -> String {
  match outcome {
    CodexPressAccountReady { receipt: _ } => "account_authenticated_rate_limits_readable"
    CodexPressLoginRequired { reason: _, receipt: _ } => "login_required"
    CodexPressUnavailable { reason: _, process: _ } => "unavailable"
    CodexPressRefused { reason: _, receipt: _ } => "press_refused"
  }
}

fn codex_press_outcome_operator_caption(outcome: CodexPressOutcome) -> String {
  match outcome {
    CodexPressAccountReady { receipt: _ } => "authenticated; capacity available"
    CodexPressLoginRequired { reason: _, receipt: _ } => "login required"
    CodexPressUnavailable { reason: _, process: _ } => "unavailable"
    CodexPressRefused { reason, receipt: _ } =>
      if (reason as String).contains("quota") {
        "quota exhausted"
      } else {
        "refused"
      }
  }
}

fn account_standing_projection(classification: AccountStandingClassification) -> String {
  match classification {
    AccountStandingAuthenticatedRateLimitsReadable =>
      "initialize_ok; account_read_ok; rate_limits_observed"
    AccountStandingLoginRequired => "initialize_ok; login_required"
    AccountStandingQuotaReached => "initialize_ok; account_read_ok; rate_limits_quota_reached"
    AccountStandingInitializeMissing => "initialize_missing"
    AccountStandingIncomplete => "initialize_ok; account_or_limits_incomplete"
  }
}

fn account_standing_summary_from_evidence(
  evidence: CodexAccountStandingEvidence,
) -> CodexAccountStandingSummary {
  CodexAccountStandingSummary { evidence: evidence }
}

fn standing_is_redacted_projection(summary: CodexAccountStandingSummary) -> Bool {
  let s = account_standing_projection(classification: summary.evidence.classification)
  s.contains("@") == false
    && s.contains("access_token") == false
    && s.contains("refresh_token") == false
}

fn binding_from_initialize_session(
  bundle: CodexRuntimeBundle,
  projected: ProviderInterfaceBinding,
) -> ProviderInterfaceBinding {
  ProviderInterfaceBinding {
    interface: projected.interface,
    transport: CodexAppServerStdio,
    executable: projected.executable,
    runtime_identity: codex_bundle_identity(bundle: bundle),
    protocol_schema_identity: bundle.receipt.protocol_schema_identity,
  }
}

fn codex_press_account_trip_script(
  executable: FilePath,
  codex_home: FilePath,
) -> String {
  concat(
    "export CODEX_HOME='",
    concat(
      codex_home as String,
      concat(
        "'; REQ=$(mktemp); OUT=$(mktemp); ERR=$(mktemp); ",
        concat(
          "printf '%s\\n' '",
          concat(
            codex_app_server_initialize_request_line() as String,
            concat(
              "' >\"$REQ\"; printf '%s\\n' '",
              concat(
                codex_app_server_account_read_request_line() as String,
                concat(
                  "' >>\"$REQ\"; printf '%s\\n' '",
                  concat(
                    codex_app_server_rate_limits_read_request_line() as String,
                    concat(
                      "' >>\"$REQ\"; cat \"$REQ\" | '",
                      concat(
                        executable as String,
                        "' app-server --stdio >\"$OUT\" 2>\"$ERR\"; EC=$?; echo \"---GUNBC_EXIT---$EC---\"; echo '---GUNBC_STDOUT---'; cat \"$OUT\"; echo '---GUNBC_STDERR---'; cat \"$ERR\"; rm -f \"$REQ\" \"$OUT\" \"$ERR\"; exit \"$EC\"",
                      ),
                    ),
                  ),
                ),
              ),
            ),
          ),
        ),
      ),
    ),
  )
}

fn json_rpc_id_as_int(v: JsonValue) -> Int? {
  match v {
    JsonNumber { lexeme: l } => parse_int(s: l as String)
    JsonNull => none
    JsonBool { value: _ } => none
    JsonString { value: _ } => none
    JsonArray { elements: _ } => none
    JsonObject { members: _ } => none
  }
}

fn json_rpc_error_message(err: JsonValue) -> NonEmptyStr {
  match json_object_unique_member(v: err, key: "message") {
    JsonMemberFound { value: JsonString { value: msg } } =>
      if msg == "" {
        "json-rpc error" as NonEmptyStr
      } else {
        msg as NonEmptyStr
      }
    _ => "json-rpc error" as NonEmptyStr
  }
}

fn disposition_from_initialize_result(result: JsonValue) -> AccountTripFrameDisposition {
  match json_object_unique_member(
    v: result,
    key: codex_initialize_result_user_agent_key as String,
  ) {
    JsonMemberFound { value: JsonString { value: ua } } =>
      if ua == "" {
        AccountTripMissing
      } else {
        AccountTripResultOk
      }
    JsonMemberAbsent => AccountTripMissing
    JsonMemberDuplicated { count: _ } => AccountTripMissing
    JsonMemberNotAnObject => AccountTripMissing
  }
}

fn disposition_from_account_read_result(result: JsonValue) -> AccountTripFrameDisposition {
  match json_object_unique_member(
    v: result,
    key: codex_account_read_result_requires_openai_auth_key as String,
  ) {
    JsonMemberFound { value: JsonBool { value: true } } => AccountTripLoginRequiredSignal
    _ =>
      match json_object_unique_member(
        v: result,
        key: codex_account_read_result_account_key as String,
      ) {
        JsonMemberFound { value: JsonNull } => AccountTripLoginRequiredSignal
        JsonMemberFound { value: JsonObject { members: ms } } =>
          if count(ms) == 0 {
            AccountTripMissing
          } else {
            AccountTripResultOk
          }
        JsonMemberFound { value: _ } => AccountTripMissing
        JsonMemberAbsent => AccountTripMissing
        JsonMemberDuplicated { count: _ } => AccountTripMissing
        JsonMemberNotAnObject => AccountTripMissing
      }
  }
}

fn json_number_as_int(v: JsonValue) -> Int? {
  match v {
    JsonNumber { lexeme: l } => parse_int(s: l as String)
    JsonNull => none
    JsonBool { value: _ } => none
    JsonString { value: _ } => none
    JsonArray { elements: _ } => none
    JsonObject { members: _ } => none
  }
}

fn rate_limit_window_used_percent(window: JsonValue) -> Int? {
  match json_object_unique_member(
    v: window,
    key: codex_rate_limits_window_used_percent_key as String,
  ) {
    JsonMemberFound { value: pct } => json_number_as_int(v: pct)
    JsonMemberAbsent => none
    JsonMemberDuplicated { count: _ } => none
    JsonMemberNotAnObject => none
  }
}

fn rate_limit_window_is_saturated(window: JsonValue) -> Bool {
  match rate_limit_window_used_percent(window: window) {
    Absent => false
    Present { value: pct } => pct >= 100
  }
}

fn rate_limit_window_shows_remaining_capacity(window: JsonValue) -> Bool {
  match rate_limit_window_used_percent(window: window) {
    Absent => false
    Present { value: pct } => pct < 100
  }
}

fn rate_limits_snapshot_has_exhaustion_signal(snapshot: JsonValue) -> Bool {
  match json_object_unique_member(
    v: snapshot,
    key: codex_rate_limits_snapshot_spend_control_reached_key as String,
  ) {
    JsonMemberFound { value: JsonBool { value: true } } => true
    _ =>
      match json_object_unique_member(
        v: snapshot,
        key: codex_rate_limits_snapshot_rate_limit_reached_type_key as String,
      ) {
        JsonMemberFound { value: JsonString { value: t } } => t != ""
        JsonMemberFound { value: JsonNull } => false
        JsonMemberFound { value: _ } => false
        JsonMemberAbsent => false
        JsonMemberDuplicated { count: _ } => false
        JsonMemberNotAnObject => false
      }
  }
}

fn rate_limits_snapshot_window_saturated(snapshot: JsonValue, key: String) -> Bool {
  match json_object_unique_member(v: snapshot, key: key) {
    JsonMemberFound { value: window } => rate_limit_window_is_saturated(window: window)
    JsonMemberAbsent => false
    JsonMemberDuplicated { count: _ } => false
    JsonMemberNotAnObject => false
  }
}

fn rate_limits_snapshot_window_has_capacity(snapshot: JsonValue, key: String) -> Bool {
  match json_object_unique_member(v: snapshot, key: key) {
    JsonMemberFound { value: window } =>
      rate_limit_window_shows_remaining_capacity(window: window)
    JsonMemberAbsent => false
    JsonMemberDuplicated { count: _ } => false
    JsonMemberNotAnObject => false
  }
}

fn disposition_from_rate_limits_snapshot(snapshot: JsonValue) -> AccountTripFrameDisposition {
  if rate_limits_snapshot_has_exhaustion_signal(snapshot: snapshot)
    || rate_limits_snapshot_window_saturated(
      snapshot: snapshot,
      key: codex_rate_limits_snapshot_primary_key as String,
    )
    || rate_limits_snapshot_window_saturated(
      snapshot: snapshot,
      key: codex_rate_limits_snapshot_secondary_key as String,
    ) {
    AccountTripQuotaSignal
  } else if rate_limits_snapshot_window_has_capacity(
    snapshot: snapshot,
    key: codex_rate_limits_snapshot_primary_key as String,
  )
    || rate_limits_snapshot_window_has_capacity(
      snapshot: snapshot,
      key: codex_rate_limits_snapshot_secondary_key as String,
    ) {
    AccountTripResultOk
  } else {
    AccountTripMissing
  }
}

fn disposition_from_rate_limits_result(result: JsonValue) -> AccountTripFrameDisposition {
  match json_object_unique_member(
    v: result,
    key: codex_rate_limits_result_rate_limits_key as String,
  ) {
    JsonMemberFound { value: snapshot } =>
      disposition_from_rate_limits_snapshot(snapshot: snapshot)
    JsonMemberAbsent => AccountTripMissing
    JsonMemberDuplicated { count: _ } => AccountTripMissing
    JsonMemberNotAnObject => AccountTripMissing
  }
}

data account_trip_structured_error_code_note: String = "Business classifications Login/Quota are authorized only by typed result members or a structured JSON-RPC error `code` string that exactly matches a known native code from extdeps.llm.codex_app_server. Free-text `message` alone yields AccountTripNativeCauseUnknown → Incomplete — never Ready/Login/Quota (provider-audit handback)."

fn disposition_from_structured_rpc_error(err: JsonValue) -> AccountTripFrameDisposition {
  match json_object_unique_member(v: err, key: "code") {
    JsonMemberFound { value: JsonString { value: code } } =>
      if code == (codex_structured_error_code_rate_limit_reached as String)
        || code == (codex_structured_error_code_quota_exceeded as String) {
        AccountTripQuotaSignal
      } else if code == (codex_structured_error_code_authentication_required as String)
        || code == (codex_account_read_result_requires_openai_auth_key as String) {
        AccountTripLoginRequiredSignal
      } else {
        AccountTripNativeCauseUnknown { message: json_rpc_error_message(err: err) }
      }
    JsonMemberFound { value: JsonNumber { lexeme: n } } =>
      AccountTripNativeCauseUnknown {
        message: concat("json-rpc numeric error code ", n as String) as NonEmptyStr,
      }
    _ =>
      AccountTripNativeCauseUnknown { message: json_rpc_error_message(err: err) }
  }
}

fn disposition_for_id_response(id: Int, obj: JsonValue) -> AccountTripFrameDisposition {
  match json_object_unique_member(v: obj, key: "error") {
    JsonMemberFound { value: err } => disposition_from_structured_rpc_error(err: err)
    JsonMemberAbsent =>
      match json_object_unique_member(v: obj, key: "result") {
        JsonMemberFound { value: result } =>
          if id == 1 {
            disposition_from_initialize_result(result: result)
          } else if id == 2 {
            disposition_from_account_read_result(result: result)
          } else if id == 3 {
            disposition_from_rate_limits_result(result: result)
          } else {
            AccountTripMissing
          }
        JsonMemberAbsent => AccountTripMissing
        JsonMemberDuplicated { count: _ } => AccountTripMissing
        JsonMemberNotAnObject => AccountTripMissing
      }
    JsonMemberDuplicated { count: _ } => AccountTripMissing
    JsonMemberNotAnObject => AccountTripMissing
  }
}

fn absorb_id_response(
  current: AccountTripResponseObservation,
  id: Int,
  disposition: AccountTripFrameDisposition,
) -> AccountTripResponseObservation {
  match current {
    AccountTripResponseAbsent =>
      AccountTripResponseUnique { response: disposition }
    AccountTripResponseUnique { response: _ } =>
      AccountTripResponseDuplicate { id: id, count: 2 }
    AccountTripResponseDuplicate { id: id, count: n } =>
      AccountTripResponseDuplicate { id: id, count: n + 1 }
  }
}

fn observation_is_duplicate(obs: AccountTripResponseObservation) -> Bool {
  match obs {
    AccountTripResponseDuplicate { id: _, count: _ } => true
    AccountTripResponseAbsent => false
    AccountTripResponseUnique { response: _ } => false
  }
}

fn observation_to_disposition(obs: AccountTripResponseObservation) -> AccountTripFrameDisposition {
  match obs {
    AccountTripResponseAbsent => AccountTripMissing
    AccountTripResponseUnique { response: r } => r
    AccountTripResponseDuplicate { id: _, count: _ } => AccountTripMissing
  }
}

type AccountTripParseAcc {
  initialize: AccountTripResponseObservation
  account_read: AccountTripResponseObservation
  rate_limits: AccountTripResponseObservation
  unknown_frame_digests: List<ContentHash>
  retention_failed: Bool
}

fn empty_account_trip_parse_acc() -> AccountTripParseAcc {
  AccountTripParseAcc {
    initialize: AccountTripResponseAbsent,
    account_read: AccountTripResponseAbsent,
    rate_limits: AccountTripResponseAbsent,
    unknown_frame_digests: [],
    retention_failed: false,
  }
}

fn digest_account_trip_line(
  line: String,
  evidence_root: FilePath,
  mode: AccountTripDigestMode,
) -> ContentHash? {
  if line == "" {
    none
  } else {
    match mode {
      AccountTripDigestStructural =>
        Present { value: content_hash_of_value(value: line as NonEmptyStr) }
      AccountTripDigestRetainPrivateSha512 =>
        match retain_private_evidence_bytes_detailed(root: evidence_root, bytes: line) {
          Absent => none
          Present { value: retained } => Present { value: retained.content_digest }
        }
    }
  }
}

fn push_unknown_digest(
  acc: AccountTripParseAcc,
  line: String,
  evidence_root: FilePath,
  mode: AccountTripDigestMode,
) -> AccountTripParseAcc {
  match digest_account_trip_line(line: line, evidence_root: evidence_root, mode: mode) {
    Absent =>
      match mode {
        AccountTripDigestStructural =>
          AccountTripParseAcc {
            initialize: acc.initialize,
            account_read: acc.account_read,
            rate_limits: acc.rate_limits,
            unknown_frame_digests: acc.unknown_frame_digests,
            retention_failed: acc.retention_failed,
          }
        AccountTripDigestRetainPrivateSha512 =>
          AccountTripParseAcc {
            initialize: acc.initialize,
            account_read: acc.account_read,
            rate_limits: acc.rate_limits,
            unknown_frame_digests: acc.unknown_frame_digests,
            retention_failed: true,
          }
      }
    Present { value: digest } =>
      AccountTripParseAcc {
        initialize: acc.initialize,
        account_read: acc.account_read,
        rate_limits: acc.rate_limits,
        unknown_frame_digests: acc.unknown_frame_digests |> list_push(digest),
        retention_failed: acc.retention_failed,
      }
  }
}

fn absorb_account_trip_line(
  acc: AccountTripParseAcc,
  line: String,
  evidence_root: FilePath,
  mode: AccountTripDigestMode,
) -> AccountTripParseAcc {
  let trimmed = line.trim()
  if trimmed == "" {
    acc
  } else {
    match parse_json(s: trimmed) {
      Absent =>
        push_unknown_digest(
          acc: acc,
          line: trimmed,
          evidence_root: evidence_root,
          mode: mode,
        )
      Present { value: parsed } =>
        match json_object_unique_member(v: parsed, key: "id") {
          JsonMemberFound { value: idv } =>
            match json_rpc_id_as_int(v: idv) {
              Absent =>
                push_unknown_digest(
                  acc: acc,
                  line: trimmed,
                  evidence_root: evidence_root,
                  mode: mode,
                )
              Present { value: n } =>
                let disposition = disposition_for_id_response(id: n, obj: parsed)
                if n == 1 {
                  AccountTripParseAcc {
                    initialize: absorb_id_response(
                      current: acc.initialize,
                      id: n,
                      disposition: disposition,
                    ),
                    account_read: acc.account_read,
                    rate_limits: acc.rate_limits,
                    unknown_frame_digests: acc.unknown_frame_digests,
                    retention_failed: acc.retention_failed,
                  }
                } else if n == 2 {
                  AccountTripParseAcc {
                    initialize: acc.initialize,
                    account_read: absorb_id_response(
                      current: acc.account_read,
                      id: n,
                      disposition: disposition,
                    ),
                    rate_limits: acc.rate_limits,
                    unknown_frame_digests: acc.unknown_frame_digests,
                    retention_failed: acc.retention_failed,
                  }
                } else if n == 3 {
                  AccountTripParseAcc {
                    initialize: acc.initialize,
                    account_read: acc.account_read,
                    rate_limits: absorb_id_response(
                      current: acc.rate_limits,
                      id: n,
                      disposition: disposition,
                    ),
                    unknown_frame_digests: acc.unknown_frame_digests,
                    retention_failed: acc.retention_failed,
                  }
                } else {
                  push_unknown_digest(
                    acc: acc,
                    line: trimmed,
                    evidence_root: evidence_root,
                    mode: mode,
                  )
                }
            }
          _ =>
            push_unknown_digest(
              acc: acc,
              line: trimmed,
              evidence_root: evidence_root,
              mode: mode,
            )
        }
    }
  }
}

fn classify_account_trip(acc: AccountTripParseAcc) -> AccountStandingClassification {
  if acc.retention_failed {
    AccountStandingIncomplete
  } else if observation_is_duplicate(obs: acc.initialize)
    || observation_is_duplicate(obs: acc.account_read)
    || observation_is_duplicate(obs: acc.rate_limits) {
    AccountStandingIncomplete
  } else {
    let init = observation_to_disposition(obs: acc.initialize)
    let acct = observation_to_disposition(obs: acc.account_read)
    let rate = observation_to_disposition(obs: acc.rate_limits)
    match init {
      AccountTripMissing => AccountStandingInitializeMissing
      AccountTripLoginRequiredSignal => AccountStandingLoginRequired
      AccountTripQuotaSignal => AccountStandingIncomplete
      AccountTripNativeCauseUnknown { message: _ } => AccountStandingIncomplete
      AccountTripResultOk =>
        match acct {
          AccountTripLoginRequiredSignal => AccountStandingLoginRequired
          AccountTripMissing => AccountStandingIncomplete
          AccountTripQuotaSignal => AccountStandingIncomplete
          AccountTripNativeCauseUnknown { message: _ } => AccountStandingIncomplete
          AccountTripResultOk =>
            match rate {
              AccountTripResultOk => AccountStandingAuthenticatedRateLimitsReadable
              AccountTripQuotaSignal => AccountStandingQuotaReached
              AccountTripLoginRequiredSignal => AccountStandingLoginRequired
              AccountTripMissing => AccountStandingIncomplete
              AccountTripNativeCauseUnknown { message: _ } => AccountStandingIncomplete
            }
        }
    }
  }
}

fn parse_account_trip_session(
  stdout: String,
  stderr: String,
  evidence_root: FilePath,
  mode: AccountTripDigestMode,
) -> CodexAccountStandingEvidence {
  let acc = fold(
    split(s: stdout, delimiter: "\n"),
    init: empty_account_trip_parse_acc(),
    f: (a, line) =>
      absorb_account_trip_line(
        acc: a,
        line: line,
        evidence_root: evidence_root,
        mode: mode,
      ),
  )
  let stderr_bytes = if stderr == "" { "(empty-stderr)" } else { stderr }
  let stderr_digest = digest_account_trip_line(
    line: stderr_bytes,
    evidence_root: evidence_root,
    mode: mode,
  )
  let retention_failed = match mode {
    AccountTripDigestStructural => acc.retention_failed
    AccountTripDigestRetainPrivateSha512 =>
      acc.retention_failed
        || match stderr_digest {
          Absent => true
          Present { value: _ } => false
        }
  }
  let acc_final = AccountTripParseAcc {
    initialize: acc.initialize,
    account_read: acc.account_read,
    rate_limits: acc.rate_limits,
    unknown_frame_digests: acc.unknown_frame_digests,
    retention_failed: retention_failed,
  }
  CodexAccountStandingEvidence {
    itinerary: codex_press_account_trip_methods(),
    initialize: acc_final.initialize,
    account_read: acc_final.account_read,
    rate_limits: acc_final.rate_limits,
    unknown_frame_digests: acc_final.unknown_frame_digests,
    stderr_digest: stderr_digest,
    classification: classify_account_trip(acc: acc_final),
  }
}

type GunbcStdioCapture {
  stdout: String
  stderr: String
  exit_code: Int?
}

fn parse_gunbc_exit_marker(combined: String) -> Int? {
  let parts = split(s: combined, delimiter: "---GUNBC_EXIT---")
  match parts.skip(n: 1).first() {
    Absent => none
    Present { value: after } => {
      let code_parts = split(s: after, delimiter: "---")
      match code_parts.first() {
        Absent => none
        Present { value: code_s } => parse_int(s: code_s.trim())
      }
    }
  }
}

fn split_gunbc_stdio_capture(combined: String) -> GunbcStdioCapture {
  let exit_code = parse_gunbc_exit_marker(combined: combined)
  let parts = split(s: combined, delimiter: "---GUNBC_STDOUT---")
  match parts.skip(n: 1).first() {
    Absent =>
      GunbcStdioCapture { stdout: combined, stderr: "", exit_code: exit_code }
    Present { value: after_marker } => {
      let err_parts = split(s: after_marker, delimiter: "---GUNBC_STDERR---")
      match err_parts.first() {
        Absent =>
          GunbcStdioCapture {
            stdout: after_marker.trim(),
            stderr: "",
            exit_code: exit_code,
          }
        Present { value: out } =>
          match err_parts.skip(n: 1).first() {
            Absent =>
              GunbcStdioCapture {
                stdout: out.trim(),
                stderr: "",
                exit_code: exit_code,
              }
            Present { value: err } =>
              GunbcStdioCapture {
                stdout: out.trim(),
                stderr: err.trim(),
                exit_code: exit_code,
              }
          }
      }
    }
  }
}

fn preflight_subject_from_bundle(
  bundle: CodexRuntimeBundle,
  binding: ProviderInterfaceBinding,
  probe_key: ProviderProbeKey,
  codex_home: FilePath,
) -> CodexAccountPreflightSubject {
  CodexAccountPreflightSubject {
    runtime: CodexRuntimeBundleReceiptRef {
      receipt_identity: bundle.receipt.receipt_identity,
    },
    interface: binding,
    probe_key: probe_key,
    credential: AmbientCodexCredentialContext { codex_home: codex_home },
  }
}

fn outcome_from_standing_receipt(receipt: CodexAccountStandingReceipt) -> CodexPressOutcome {
  match receipt.wire_evidence {
    Absent =>
      CodexPressUnavailable {
        reason: "account standing requires retained wire evidence" as NonEmptyStr,
        process: receipt.process,
      }
    Present { value: _ } => {
      let classification = receipt.standing.evidence.classification
      match classification {
        AccountStandingAuthenticatedRateLimitsReadable =>
          CodexPressAccountReady { receipt: receipt }
        AccountStandingLoginRequired =>
          CodexPressLoginRequired {
            reason: "codex app-server account trip requires login" as NonEmptyStr,
            receipt: receipt,
          }
        AccountStandingQuotaReached =>
          CodexPressRefused {
            reason: "codex quota exhausted at account/rateLimits/read" as NonEmptyStr,
            receipt: receipt,
          }
        AccountStandingInitializeMissing =>
          CodexPressRefused {
            reason: "codex app-server trip missing initialize result" as NonEmptyStr,
            receipt: receipt,
          }
        AccountStandingIncomplete =>
          CodexPressRefused {
            reason: "codex app-server account trip incomplete" as NonEmptyStr,
            receipt: receipt,
          }
      }
    }
  }
}

fn parse_account_trip_stdout_for_tests(stdout: String) -> CodexAccountStandingEvidence {
  parse_account_trip_session(
    stdout: stdout,
    stderr: "",
    evidence_root: codex_press_hermetic_evidence_root,
    mode: AccountTripDigestStructural,
  )
}

fn process_receipt_from_capture(
  capture: GunbcStdioCapture,
  wire: ProviderWireEvidenceReceipt?,
  run_success: Bool,
) -> ProviderProcessReceipt {
  match capture.exit_code {
    Present { value: code } =>
      ProviderProcessReceipt {
        exit: ProviderProcessExited { code: code },
        wire: wire,
      }
    Absent =>
      if run_success {
        ProviderProcessReceipt {
          exit: ProviderProcessObservationFailed,
          wire: wire,
        }
      } else {
        ProviderProcessReceipt {
          exit: ProviderProcessObservationFailed,
          wire: wire,
        }
      }
  }
}

fn observe_codex_account_preflight(
  bundle: CodexRuntimeBundle,
  probe_key: ProviderProbeKey,
  evidence_root: FilePath,
  codex_home: FilePath,
) -> CodexPressOutcome {
  match project_codex_app_server_stdio_binding(bundle: bundle) {
    RequiredProviderInterfaceUnavailable { interface: _, reason } =>
      CodexPressUnavailable {
        reason: reason,
        process: ProviderProcessReceipt {
          exit: ProviderProcessObservationFailed,
          wire: none,
        },
      }
    ProviderInterfaceResolved { binding: projected } => {
      let present = shell.Test.IsFile(path: projected.executable.path)
      if present.is_file == false {
        CodexPressUnavailable {
          reason: "bundled Codex native executable absent at binding path" as NonEmptyStr,
          process: ProviderProcessReceipt {
            exit: ProviderProcessObservationFailed,
            wire: none,
          },
        }
      } else {
        let script = retained_foreign(
          body: codex_press_account_trip_script(
            executable: projected.executable.path,
            codex_home: codex_home,
          ),
          reason: "Codex app-server held-open account session; exit+stdout/stderr captured for typed NDJSON id correlation" as NonEmptyStr,
        )
        let run = shell.Exec.Run(script: script)
        let capture = split_gunbc_stdio_capture(combined: run.stdout)
        let wire_evidence = retain_provider_wire_capture(
          evidence_root: evidence_root,
          stdout: capture.stdout,
          stderr: capture.stderr,
          success: run.success,
          exit_code: capture.exit_code,
        )
        let process = process_receipt_from_capture(
          capture: capture,
          wire: wire_evidence,
          run_success: run.success,
        )
        match wire_evidence {
          Absent =>
            CodexPressUnavailable {
              reason: "provider wire evidence retention refused" as NonEmptyStr,
              process: process,
            }
          Present { value: wire } => {
            let evidence = parse_account_trip_session(
              stdout: capture.stdout,
              stderr: capture.stderr,
              evidence_root: evidence_root,
              mode: AccountTripDigestRetainPrivateSha512,
            )
            let session_binding = binding_from_initialize_session(
              bundle: bundle,
              projected: projected,
            )
            let subject = preflight_subject_from_bundle(
              bundle: bundle,
              binding: session_binding,
              probe_key: probe_key,
              codex_home: codex_home,
            )
            let receipt = CodexAccountStandingReceipt {
              subject: subject,
              standing: account_standing_summary_from_evidence(evidence: evidence),
              wire_evidence: Present { value: wire },
              process: ProviderProcessReceipt {
                exit: process.exit,
                wire: Present { value: wire },
              },
            }
            match capture.exit_code {
              Present { value: code } =>
                if code != 0 {
                  CodexPressUnavailable {
                    reason: "codex app-server process exited nonzero" as NonEmptyStr,
                    process: receipt.process,
                  }
                } else {
                  outcome_from_standing_receipt(receipt: receipt)
                }
              Absent =>
                CodexPressUnavailable {
                  reason: "codex app-server process exit observation refused" as NonEmptyStr,
                  process: receipt.process,
                }
            }
          }
        }
      }
    }
  }
}
