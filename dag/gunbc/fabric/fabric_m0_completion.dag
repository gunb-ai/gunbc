module gunbc.fabric_m0_completion

import std.types { List, NonEmptyStr, Bool }
import std.content_hash { Sha256Digest, content_hash_eq_cryptographic }
import std.scoped_authorization { AttemptIdentity }
import gunbc.fabric_m0_origin_readback {
  OriginReading,
  OriginReadingOutcome,
  OriginReadingTaken,
  OriginReadingUnavailable,
  OriginFetchOutcome,
  OriginObjectStaged,
  OriginObjectAbsent,
  OriginFetchUnavailable,
  origin_reading_digest,
  origin_reading_path,
}
import product.fabric.identity { WorkKey }
import product.fabric.work {
  OutputObligation,
  OutputObligationKind,
  output_obligation_kind_material,
  OutputObligationsResolution,
  OutputObligationsResolved,
  OutputObligationsUnreadable,
  ResolvedOutputObligations,
  OutputObligationsUnreadableCause,
  WorkKeyDoesNotMatchContract,
}

// The fabric-M0 durable-completion authority: the single function that may call a job successful.
// It is modeled before any cache exists because a cache accelerates a completion contract and
// cannot supply one — building the fast path first produces something that looks like storage
// without establishing that a successful job's required outputs outlive the worker.
//
// WHY THE DIGEST CARRIERS BELOW ARE Sha256Digest AND NOT ContentHash: std.content_hash makes
// ContentHash a family coproduct whose Fnv1a64Structural arm is a structural FINGERPRINT, minted
// for computation identity and not from transferred bytes. A union-typed field would let a
// structural fingerprint stand where a byte-integrity digest is required, and until Phase B of
// feature:content-hash-family-grounded lands, the substrate still admits cross-family `==` at
// typecheck. Pinning the family AT THE CARRIER is the same move GateRosterHash and v2.std.node.Hash
// already make for Fnv1a64Structural, and it puts this class at structurally impossible rather than
// validated: there is no constructor here that accepts a structural fingerprint as an integrity
// digest, so the confusion has no representation instead of a check that could be skipped.
// PATH-SCOPED, PER 4b(1): that reading holds on the source-to-dag acceptance path. The emitted Rust
// mirror of these carriers is a public struct with public fields (gunbc.model.population), so a
// consumer writing Rust against the seed is outside the guarantee, and a class's rung is the
// MINIMUM across its in-scope paths. Fabric-M0 has no Rust consumer today, so the rung holds NOW
// with that named degradation condition rather than absolutely.

// SUBJECT IDENTITY COMES FROM THE CONTRACT, NOT FROM THIS GATE.
//
// An earlier revision minted RequiredArtifactId and RequiredReceiptId here and carried two parallel
// rosters. Both were this module's own coinage: the two verdict paths differed only in type name,
// so the duplication looked like domain structure while being invented vocabulary. product.fabric.work
// now owns the subject identity as OutputObligation -- one id WITH a kind -- so the rosters collapse
// to one and the gate keys by the identity the contract issued.
//
// KIND IS PART OF THE KEY, NOT DECORATION. An artifact obligation and a terminal-result obligation
// may carry the same id, so a join on id alone silently lets one discharge the other. Every lookup
// below compares id AND kind.
fn obligation_eq(a: OutputObligation, b: OutputObligation) -> Bool {
  (a.id == b.id)
    && (output_obligation_kind_material(kind: a.kind) == output_obligation_kind_material(kind: b.kind))
}

// A display name for diagnostics only. It never keys a lookup -- obligation_eq does -- so a
// collision here costs a confusing message, never a wrong verdict.
fn obligation_subject_name(o: OutputObligation) -> NonEmptyStr {
  (o.id as NonEmptyStr) + " [" + output_obligation_kind_material(kind: o.kind) + "]"
}

// What an independent reader observed at the origin, WITHOUT consulting the producer's cache.
//
// ReadbackUnknown is a third arm rather than a failure because a lost acknowledgement does not
// establish that the write failed, and an object's mere existence does not establish it is the
// intended object. Folding unknown into either decided arm is the absorbing fallback DESIGN 5
// forbids: into failure it discards a possibly-committed result and re-executes; into success it
// publishes green over bytes nobody has read.
// THE CONFIRMING ARM CARRIES A READING, NOT A DIGEST, and that is the whole difference between
// this shape and the one it replaces. A digest field admitted any 64-hex value an author cared to
// write beside any provenance they cared to claim; OriginReading is sole_constructor in
// gunbc.fabric_m0_origin_readback, so the only way to reach this arm is to have actually digested a
// file, and the file is named in the same value. See that module for what the seal does and does
// not close, and for the next-rung trigger; it is cited here rather than restated.
type OriginReadback
  = ReadbackConfirmed { reading: OriginReading }
  | ReadbackAbsent
  | ReadbackUnknown { cause: NonEmptyStr }

// The pure translation from a read that was attempted to what the authority consumes. An
// unavailable reading is UNKNOWN, never absence: failing to digest the staged output says nothing
// about what the origin holds.
fn origin_readback_of(outcome: OriginReadingOutcome) -> OriginReadback {
  match outcome {
    OriginReadingTaken { reading: r } => ReadbackConfirmed { reading: r }
    OriginReadingUnavailable { staged_path: _, cause: c } => ReadbackUnknown { cause: c }
  }
}

// The same translation for a read that staged its own output. The fetch's absent arm is a store
// answer -- the origin was asked at the key and said there is nothing -- so it is ReadbackAbsent,
// not unknown; an unreachable fetch stays UNKNOWN. The key is dropped here on purpose: the subject
// this readback is joined under is the obligation the caller names, and carrying the key beside it
// would be a second spelling of one identity.
fn origin_readback_of_fetch(fetch: OriginFetchOutcome) -> OriginReadback {
  match fetch {
    OriginObjectStaged { key: _, reading: r } => ReadbackConfirmed { reading: r }
    OriginObjectAbsent { key: _ } => ReadbackAbsent
    OriginFetchUnavailable { key: _, cause: c } => ReadbackUnknown { cause: c }
  }
}

type CommittedOutput {
  obligation: OutputObligation
  attempt: AttemptIdentity
  recorded_digest: Sha256Digest
}

// The computation's own verdict, kept separate from every storage fact below it.
type ComputationOutcome
  = ComputationSucceeded
  | ComputationFailed { cause: NonEmptyStr }

// Per-obligation verdicts, and the three-valued space the roster fold lives in.
// ObligationUnenumerable is the roster-grain arm: not one obligation that failed, but a population
// nobody could list. It dominates the meet because a job whose obligations cannot be enumerated
// cannot be shown complete by any number of satisfied siblings -- and keeping it as a VERDICT rather
// than an early return is what lets the readable rosters still be assessed beside it. "Cannot
// enumerate this population" is not "stop examining every other population".
type ObligationVerdict
  = ObligationSatisfied
  | ObligationUnsatisfied { subject: NonEmptyStr, cause: NonEmptyStr }
  | ObligationUndetermined { subject: NonEmptyStr, cause: NonEmptyStr }
  | ObligationUnenumerable { subject: NonEmptyStr, cause: NonEmptyStr }

// Unsatisfied DOMINATES undetermined, which is not arbitrary: an absent required object is already
// decided, so no later readback can turn the population complete, while an unknown one may still
// reconcile. Taking the meet in the other direction would park a definitely-incomplete result in
// pending forever, and taking it toward satisfied would publish success over a missing output.
fn obligation_meet(a: ObligationVerdict, b: ObligationVerdict) -> ObligationVerdict {
  if obligation_rank(v: a) >= obligation_rank(v: b) { a } else { b }
}

// One ordering, stated once. Unenumerable dominates Unsatisfied dominates Undetermined dominates
// Satisfied: a decided absence cannot be reconciled away, so it must not sit behind an unknown that
// may still resolve; and an unlistable roster outranks both because it is not even a claim about a
// particular obligation.
fn obligation_rank(v: ObligationVerdict) -> Int {
  match v {
    ObligationSatisfied => 0
    ObligationUndetermined { subject: _, cause: _ } => 1
    ObligationUnsatisfied { subject: _, cause: _ } => 2
    ObligationUnenumerable { subject: _, cause: _ } => 3
  }
}

fn readback_digest_verdict(subject: NonEmptyStr, recorded: Sha256Digest, readback: OriginReadback) -> ObligationVerdict {
  match readback {
    ReadbackConfirmed { reading: r } =>
      if content_hash_eq_cryptographic(left: recorded, right: origin_reading_digest(reading: r)) {
        ObligationSatisfied
      } else {
        ObligationUnsatisfied {
          subject: subject,
          cause: "origin readback digest differs from the committed record; the readback digested "
            + origin_reading_path(reading: r),
        }
      }
    ReadbackAbsent => ObligationUnsatisfied { subject: subject, cause: "required artifact absent at origin" }
    ReadbackUnknown { cause: c } => ObligationUndetermined { subject: subject, cause: c }
  }
}

// THE READ IS A SEPARATE POPULATION FROM THE WRITE, JOINED HERE RATHER THAN ASSEMBLED BY THE CALLER.
//
// This shape exists because the previous one carried `readback` as a FIELD of each committed row,
// which made a readback exist for every committed object by construction: "no origin read was
// performed for this subject" had no representation, and the nearest expressible thing --
// ReadbackUnknown -- was a value a caller had to deliberately choose. A record whose read result is
// always present and whose two compared halves are both supplied by one caller is checking a claim
// about a commit rather than the commit; it is the seeded-true fold answering "complete" over a
// population it never examined.
//
// Splitting them makes the unexamined case the DEFAULT rather than an option: an observation
// population that no reader wrote to is empty, every required subject misses its join, and the fold
// cannot reach success. Undetermined rather than unsatisfied is deliberate -- an unperformed read
// says nothing about whether the object is there, so it must reconcile, not fail.
//
// What this does NOT establish, stated plainly: nothing here proves a reader ran. That is the
// observation-to-slot boundary std.durable_compare_and_set already declares outside its guarantee,
// and no pure fold can close it. What it does establish is that the AUTHORITY performs the join, so
// a missing read is structurally distinguishable from a satisfied one instead of being absorbed.
//
// THE GAP THIS SHAPE USED TO CARRY IS NOW CONSTRUCTED SHUT, AND THE PART THAT IS NOT IS NAMED.
//
// An observation's digest used to be ASSERTED beside a provenance stamp -- the rostered class
// gunbc.recurring_failure_mode subject_and_its_digest_as_independent_parameters, whose declared
// repair is to derive the digest from the value at the point the value is obtained. That repair is
// applied: ReadbackConfirmed carries an OriginReading, sole_constructor in
// gunbc.fabric_m0_origin_readback, whose only mint computes the digest over the file named in the
// same value. On the source-to-dag acceptance path there is no constructor that pairs a digest with
// a file it was not taken from, so that sub-class is structurally impossible rather than validated
// -- measured, not asserted, by test.claim.fabric_m0_origin_readback_seal.
//
// WHAT REMAINS, and it is what keeps the enclosing class at MITIGATABLE: the staged path is still
// chosen by whoever calls the mint, so "the digested file was the origin readback's own output and
// not a cache copy" is not yet constructed. gunbc.fabric_m0_origin_readback owns that boundary and
// names the capability that closes it; it is cited here, not restated, because a second statement
// of one trigger is a second authority for it.
// The manifest is a subject too, but it is not an obligation, so the subject is a coproduct rather
// than a string. Deriving a string key from an obligation would reintroduce exactly the collision
// product.fabric.work warns about when ids are concatenated.
type ObservationSubject
  = ObligationSubject { obligation: OutputObligation }
  | CommitManifestSubject {}

fn observation_subject_eq(a: ObservationSubject, b: ObservationSubject) -> Bool {
  match a {
    CommitManifestSubject {} =>
      match b {
        CommitManifestSubject {} => true
        other => false
      }
    ObligationSubject { obligation: oa } =>
      match b {
        ObligationSubject { obligation: ob } => obligation_eq(a: oa, b: ob)
        other => false
      }
  }
}

fn observation_subject_name(s: ObservationSubject) -> NonEmptyStr {
  match s {
    CommitManifestSubject {} => "commit-manifest"
    ObligationSubject { obligation: o } => obligation_subject_name(o: o)
  }
}

type OriginObservation {
  subject: ObservationSubject
  readback: OriginReadback
}

fn readback_verdict_for(observations: List<OriginObservation>, subject: ObservationSubject, recorded: Sha256Digest) -> ObligationVerdict {
  let seen = observations |> filter(o => observation_subject_eq(a: o.subject, b: subject))
  let name = observation_subject_name(s: subject)
  if seen.count() == 0 {
    ObligationUndetermined { subject: name, cause: "no origin read is recorded for this subject" }
  } else if seen.count() > 1 {
    ObligationUnsatisfied { subject: name, cause: "several origin observations claim this subject; no authoritative read" }
  } else {
    match seen |> first {
      Present { value: o } => readback_digest_verdict(subject: name, recorded: recorded, readback: o.readback)
      Absent => ObligationUndetermined { subject: name, cause: "no origin read is recorded for this subject" }
    }
  }
}

// AMBIGUITY REFUSES RATHER THAN RESOLVING BY POSITION. The former shape took the first match, so a
// second, conflicting or undetermined row for the same identity was discarded before any fold could
// see it -- and evidence dropped at selection cannot be recovered by preserving everything after it.
// An unconstrained list whose first element wins establishes neither a unique admitted observation
// nor an authoritative choice among a history, so this refuses and names the count.
fn committed_outputs_for(committed: List<CommittedOutput>, wanted: OutputObligation, attempt: AttemptIdentity) -> List<CommittedOutput> {
  committed |> filter(c => obligation_eq(a: c.obligation, b: wanted) && (c.attempt == attempt))
}

// ONE VERDICT PATH. The artifact and receipt versions of this function differed only in type name,
// which is what made the split invented rather than modelled.
fn required_output_verdict(
  committed: List<CommittedOutput>,
  observations: List<OriginObservation>,
  members: List<ManifestMember>,
  wanted: OutputObligation,
  attempt: AttemptIdentity
) -> ObligationVerdict {
  let name = obligation_subject_name(o: wanted)
  let rows = committed_outputs_for(committed: committed, wanted: wanted, attempt: attempt)
  if rows.count() == 0 {
    ObligationUnsatisfied { subject: name, cause: "no committed output bound to this attempt" }
  } else if rows.count() > 1 {
    ObligationUnsatisfied { subject: name, cause: "several committed outputs claim this identity for one attempt; no authoritative row" }
  } else {
    match rows |> first {
      Present { value: c } =>
        obligation_meet(
          a: readback_verdict_for(
            observations: observations,
            subject: ObligationSubject { obligation: wanted },
            recorded: c.recorded_digest
          ),
          b: manifest_membership_verdict(members: members, subject: wanted, expected: c.recorded_digest)
        )
      Absent => ObligationUnsatisfied { subject: name, cause: "no committed output bound to this attempt" }
    }
  }
}

// The manifest names the committed set, so membership is CHECKED rather than asserted by a comment.
//
// Independent checks of several objects do not establish the relationships between them: without
// this, the contract said only "these objects each passed, and something labelled this attempt's
// manifest passed", never "that manifest names these objects at these contents". Reconstructing a
// result after the worker is gone needs the second.
type ManifestMember {
  obligation: OutputObligation
  content: Sha256Digest
}

fn manifest_membership_verdict(members: List<ManifestMember>, subject: OutputObligation, expected: Sha256Digest) -> ObligationVerdict {
  let named = members |> filter(m => obligation_eq(a: m.obligation, b: subject))
  let subject = obligation_subject_name(o: subject)
  if named.count() == 0 {
    ObligationUnsatisfied { subject: subject, cause: "commit manifest does not name this required object" }
  } else if named.count() > 1 {
    ObligationUnsatisfied { subject: subject, cause: "commit manifest names this required object more than once" }
  } else {
    match named |> first {
      Present { value: m } =>
        if content_hash_eq_cryptographic(left: m.content, right: expected) {
          ObligationSatisfied
        } else {
          ObligationUnsatisfied { subject: subject, cause: "commit manifest names a different content for this required object" }
        }
      Absent => ObligationUnsatisfied { subject: subject, cause: "commit manifest does not name this required object" }
    }
  }
}

type CommitManifest {
  attempt: AttemptIdentity
  manifest_digest: Sha256Digest
  members: List<ManifestMember>
}

fn manifest_verdict(manifest: CommitManifest, observations: List<OriginObservation>, attempt: AttemptIdentity) -> ObligationVerdict {
  if (manifest.attempt == attempt) == false {
    ObligationUnsatisfied { subject: "commit-manifest", cause: "manifest is bound to a different attempt" }
  } else {
    readback_verdict_for(observations: observations, subject: CommitManifestSubject {}, recorded: manifest.manifest_digest)
  }
}

// Each roster contributes verdicts whether or not its SIBLING could be read.
// THE ROSTER COMES FROM A RESOLUTION, NOT FROM THE CALLER.
//
// This is the repair for the defect that outlived every other one here: the caller used to CHOOSE
// between a declared roster and an unreadable one, so a caller that never read the obligations could
// declare empty and mint terminal success. product.fabric.work now seals ResolvedOutputObligations,
// whose only mint is resolve_output_obligations, so an empty roster is a RESOLVED value and cannot
// be asserted at this gate.
//
// WHAT THE SEAL DOES NOT CLOSE, and this function does. A sealed resolution is unforgeable but
// still SUBSTITUTABLE: a caller may hold a perfectly valid resolution for work B while asking this
// gate to judge work A. The seal binds a roster to its own contract; only the gate knows which work
// it was asked about, so the work_key comparison lives here and nowhere else.
fn roster_verdicts(
  resolution: OutputObligationsResolution,
  judged_work: WorkKey,
  committed: List<CommittedOutput>,
  observations: List<OriginObservation>,
  members: List<ManifestMember>,
  attempt: AttemptIdentity
) -> List<ObligationVerdict> {
  match resolution {
    OutputObligationsUnreadable { contract: c, cause: cause } =>
      [ObligationUnenumerable {
        subject: (c as NonEmptyStr),
        cause: unreadable_cause_text(cause: cause)
      }]
    OutputObligationsResolved { value: resolved } =>
      if (resolved.work_key == judged_work) == false {
        [ObligationUnenumerable {
          subject: (resolved.contract as NonEmptyStr),
          cause: "resolved obligations are bound to a different work than the one being judged"
        }]
      } else {
        resolved.required
          |> map(wanted => required_output_verdict(
               committed: committed,
               observations: observations,
               members: members,
               wanted: wanted,
               attempt: attempt
             ))
      }
  }
}

// The refusal is typed at the carrier, so this renders it rather than re-deciding it.
fn unreadable_cause_text(cause: OutputObligationsUnreadableCause) -> NonEmptyStr {
  match cause {
    WorkKeyDoesNotMatchContract {} => "a foreign work key cannot seal this contract's roster"
  }
}

fn storage_assessment(
  attempt: AttemptIdentity,
  resolution: OutputObligationsResolution,
  judged_work: WorkKey,
  committed: List<CommittedOutput>,
  observations: List<OriginObservation>,
  manifest: CommitManifest
) -> List<ObligationVerdict> {
  concat(
    roster_verdicts(
      resolution: resolution,
      judged_work: judged_work,
      committed: committed,
      observations: observations,
      members: manifest.members,
      attempt: attempt
    ),
    [manifest_verdict(manifest: manifest, observations: observations, attempt: attempt)]
  )
}

fn verdict_is_unresolved(v: ObligationVerdict) -> Bool {
  match v {
    ObligationSatisfied => false
    ObligationUnsatisfied { subject: _, cause: _ } => true
    ObligationUndetermined { subject: _, cause: _ } => true
    ObligationUnenumerable { subject: _, cause: _ } => true
  }
}

fn unresolved_obligations(verdicts: List<ObligationVerdict>) -> List<ObligationVerdict> {
  verdicts |> filter(v => verdict_is_unresolved(v: v))
}

fn verdicts_meet(verdicts: List<ObligationVerdict>) -> ObligationVerdict {
  fold(verdicts, init: ObligationSatisfied, f: (acc, v) => obligation_meet(a: acc, b: v))
}

// PublishObligationsUnreadable IS RE-HOMED, NOT DELETED. That arm used to be reached by a
// caller-supplied unreadable roster. That state is now unwritable ON THE SOURCE-TO-DAG PATH, which
// is the honest scope and not an absolute claim (4b(1); the Rust mirror caveat above applies here
// too): product.fabric.work makes
// output_obligations a REQUIRED field of the contract, so "the roster could not be read" has no
// producer at all. The arm survives because it is still reachable from two states that are real --
// a typed OutputObligationsUnreadable from resolve_output_obligations, and a resolution bound to a
// different work than the one being judged. Deleting it would have discarded a live refusal;
// keeping it uninhabited would have been the decoration DESIGN 4b calls worse than absent.
type JobPublication
  = PublishSuccess { attempt: AttemptIdentity, manifest_digest: Sha256Digest }
  | PublishComputationFailed { attempt: AttemptIdentity, cause: NonEmptyStr, unresolved: List<ObligationVerdict> }
  | PublishFinalizationFailed { attempt: AttemptIdentity, subject: NonEmptyStr, cause: NonEmptyStr, unresolved: List<ObligationVerdict> }
  | PublishPendingReconciliation { attempt: AttemptIdentity, subject: NonEmptyStr, cause: NonEmptyStr, unresolved: List<ObligationVerdict> }
  | PublishObligationsUnreadable { attempt: AttemptIdentity, subject: NonEmptyStr, cause: NonEmptyStr, unresolved: List<ObligationVerdict> }

// THE SUCCESS AUTHORITY. Total over five outcomes.
//
// SHORT-CIRCUIT THE CHOICE OF OUTCOME, NEVER THE COLLECTION OF EVIDENCE. The storage assessment is
// computed FIRST and unconditionally -- it is a pure fold over supplied observations, so computing
// it neither performs a read nor delays recognising the build failure -- and only then does the
// computation verdict decide the published outcome. Failure dominance is therefore a property of
// the RESULT rather than of skipping the assessment, which is what the earlier shape got wrong: a
// failed build returned before any obligation was examined, so a job that failed to compile AND had
// an unresolved receipt upload reported the compile error and silently dropped the reconciliation
// work. Both facts are true and only the second says what to do next.
//
// Success remains the last arm and is reachable only from a wholly satisfied assessment.
fn admit_job_publication(
  attempt: AttemptIdentity,
  computation: ComputationOutcome,
  resolution: OutputObligationsResolution,
  judged_work: WorkKey,
  committed: List<CommittedOutput>,
  observations: List<OriginObservation>,
  manifest: CommitManifest
) -> JobPublication {
  let verdicts = storage_assessment(
    attempt: attempt,
    resolution: resolution,
    judged_work: judged_work,
    committed: committed,
    observations: observations,
    manifest: manifest
  )
  let unresolved = unresolved_obligations(verdicts: verdicts)
  match computation {
    ComputationFailed { cause: c } =>
      PublishComputationFailed { attempt: attempt, cause: c, unresolved: unresolved }
    ComputationSucceeded =>
      match verdicts_meet(verdicts: verdicts) {
        ObligationSatisfied => PublishSuccess { attempt: attempt, manifest_digest: manifest.manifest_digest }
        ObligationUnsatisfied { subject: s, cause: c } =>
          PublishFinalizationFailed { attempt: attempt, subject: s, cause: c, unresolved: unresolved }
        ObligationUndetermined { subject: s, cause: c } =>
          PublishPendingReconciliation { attempt: attempt, subject: s, cause: c, unresolved: unresolved }
        ObligationUnenumerable { subject: s, cause: c } =>
          PublishObligationsUnreadable { attempt: attempt, subject: s, cause: c, unresolved: unresolved }
      }
  }
}
