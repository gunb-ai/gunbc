module gunbc.fabric.fabric_storage_placement

import gunbc.fabric.fabric_storage_address { fabric_storage_route_prefix }

import std.types { String, NonEmptyStr, FilePath, Int, Bool, Port, List }
import std.algebra { trim }
import product.host_identity { HostIdentity }
import gunbc.fleet.fleet_intent_network { fleet_intent_network }
import gunbc.roadmap.roadmap_dashboard_instance {
  HostDashboardInstance, dashboard_instance_child, dashboard_ownership_marker_in,
  ProdRoleRealization, ProdRoleRealizedBy, ProdRoleRealizationRefused, ProdRoleRealizationRefusal,
}
import gunbc.owned_directory { OwnedDirectoryTarget, OwnedDirectoryManaged }
import std.effect_grant { Read, Write, Execute }
import extdeps.tailscale.serve { tailscale_serve_unix_proxy_peer }
import gunbc.ownership { Ensured }
import gunbc.managed_directory {
  ManagedDirectory, DirectoryDependent, srv1_dashboard_service_principal,
  EntriesUnmanaged, EntriesReadableByDependents, managed_directory_entry_mode, ManagedEntryModeDerived, ManagedEntryModeRefused,
}
import gunbc.fleet.fleet_posix_accounts { fleet_posix_ci_runner_user }
import gunbc.fabric.fabric_storage_file_store {
  FabricStorageOperations, FabricStoreStanding, FabricStoreReady, FabricStoreUnready,
  fabric_store_open, fabric_store_declared_root, fabric_store_area_paths,
  fabric_storage_slots, fabric_storage_state_slots,
  fabric_storage_file_head, fabric_storage_file_put, fabric_storage_file_advance, fabric_storage_file_closure,
}
import std.fabric_storage { FabricObject, FabricObjectRef, FabricHeadExpectation, FabricHeadRead, FabricPut, FabricHeadAdvance, FabricClosureRead }
import std.nat { Nat }
import extdeps.filesystem.filesystem_io { Filesystem, filesystem_listing_observation, FilesystemDirectoryListed, FilesystemDirectoryListingRefused, FilesystemDirectorySubjectRefused }
import extdeps.access.posix { FileMode, PermissionBits, PosixUser, file_mode_bits, file_mode_octal, file_mode_of_octal_text }

// WHERE THE FABRIC DB IS: one host holds the store's files and answers the endpoint. This is the
// POLICY fact of the three (DESIGN 3) -- std.fabric_storage is the interface, the file store and the
// served handler are its realization, and which host and which root is this row. Moving the store is
// a row change here; nothing downstream names the host.
//
// ONE PLACEMENT, NOT A REPLICA SET (operator approval 2026-09-19): a head needs exactly one
// linearization point, and an unreachable placement refuses acquisitions rather than failing over.
// Replication is docs/plans/fabric-storage.md.

type FabricStoragePlacement
  = FabricStorageUnplaced
  | FabricStoragePlacementRefused { cause: ProdRoleRealizationRefusal }
  | FabricStoragePlaced { host: HostIdentity, instance: HostDashboardInstance, endpoint: NonEmptyStr, door_socket: NonEmptyStr }

// The endpoint is the placed host's tailnet name on the store's own HTTPS listener, derived from the
// fleet network's tailnet domain rather than spelled: an unset domain leaves the store unplaced
// instead of guessing an address. (gunbc.fleet.fleet_tailnet tailnet_base_url_from
// derives the same URL shape but answers an undeclared domain with a fabricated .invalid address; a
// placement must refuse there instead, so it is not reused.)
//
// A DEDICATED LISTENER AT THE ROOT MOUNT, not a --set-path mount on the dashboard's 443: whether
// tailscale strips a mount path before proxying is not modeled in extdeps.tailscale.serve, and a root
// mount makes the question not arise -- the request path the caller sends is the path the handler
// routes on. 10000 because srv1's 443 carries the dashboard and its 8443 the approval notification
// server (gunbc.auth.approval_ntfy_deployment approval_ntfy_serve_port); tailscale serve admits
// HTTPS listeners on 443, 8443 and 10000 only.
data fabric_storage_https_port: Port = 10000

// THE DOOR IS A UNIX SOCKET, NOT A LOOPBACK PORT. A loopback TCP listener is reachable by every
// account on the placed host, each able to present a forged Tailscale-User-Login; a socket's peer
// is attested by the kernel (SO_PEERCRED, read by `gunbc serve --unix-socket`), and its directory
// admits exactly the writers declared below. tailscale serve proxies to it as root
// (extdeps.tailscale.serve tailscale_serve_unix_target), so a proxied request's peer is root and a
// local writer's peer is itself -- the two populations the door tells apart.
fn fabric_storage_door_directory_path(instance: HostDashboardInstance) -> NonEmptyStr {
  dashboard_instance_child(root: instance.instance_root, child: "fabric-storage-door") as String as NonEmptyStr
}

fn fabric_storage_door_socket(instance: HostDashboardInstance) -> NonEmptyStr {
  join([fabric_storage_door_directory_path(instance: instance) as String, "/door.sock"], "") as NonEmptyStr
}

// The peer the tailscale proxy connects as. tailscaled runs as root, and since v1.98.9 only root may
// configure a unix proxy target at all (TS-2026-005), so a root peer is the proxy and its request's
// login header is the principal; every other peer is its own principal and the header is ignored.
data fabric_storage_door_proxy_peer: NonEmptyStr = tailscale_serve_unix_proxy_peer



// THE FABRIC DB'S TWO STORES, ONE DECLARATION EACH. Where the fabric DB's files live on the instance
// that holds the placement (gunbc.fabric.fabric_storage_file_store). It is this module's fact -- the
// placement decides where the store is -- and the deployment creates exactly the directories
// fabric_storage_directory_demands declares from it. It replaced the per-instance event-log mirror root:
// no executor keeps a copy of the log any more, so only the placement's host holds a root at all.
//
// ONE STORE PER INSTANCE, NOT ONE SHARED ACROSS THEM: only the placed instance demands the root, and the
// door process there is its one in-process writer; every other writer reaches it as a request
// (gunbc.fabric.fabric_storage_client). The authenticated state namespace is a SECOND store under the
// same parent (its own objects and heads, never the public namespace's), so it has its own member
// declaration under this one rather than a suffix spelled at its readers.
//
// THE DECLARATION CARRIES NO MODE, AND THAT IS A STATED DIVERGENCE from the sealed-store declarations
// that do (gunbc.roadmap.roadmap_attempt_worktree_claim_root worktree_claim_slots): these directories'
// owner, group and mode derive from the writers declared below (fabric_storage_directory, through
// gunbc.managed_directory), and a mode spelled here would be a second authority for the same bits.
// The store (fabric_storage_placed_store, fabric_state_storage_store) and the directory rows
// (fabric_storage_store_directories) both derive from those rows, so deleting a row removes both.
// THE CHAINS ARE DATA ROWS IN THE MINT'S OWN MODULE (gunbc.fabric.fabric_storage_file_store:
// fabric_storage_slots, fabric_storage_state_slots), because ONE generic mint reads them there and takes
// no path; a third spelling of either chain here, or a per-store copy of the mint, would be a second
// authority over where the store lives. THE STATE NAMESPACE sits under the public store's root, so its
// row spells the whole chain from the instance root -- the public root must provision before state means
// anything, and a host with no public store cannot have a state store.
// These two functions are the roots for the substrate's DEMAND ROWS (provisioning, census). They derive
// from the same rows the mint reads, through the same join; answering a root here grants no store, because
// only fabric_store_open constructs FabricStorageOperations.
fn fabric_storage_store_root(instance: HostDashboardInstance) -> NonEmptyStr {
  fabric_store_declared_root(members: fabric_storage_slots, root: instance.instance_root) as String as NonEmptyStr
}

fn fabric_state_storage_root(instance: HostDashboardInstance) -> NonEmptyStr {
  fabric_store_declared_root(members: fabric_storage_state_slots, root: instance.instance_root) as String as NonEmptyStr
}

fn fabric_storage_control_directory_path(instance: HostDashboardInstance) -> NonEmptyStr {
  dashboard_instance_child(root: instance.instance_root, child: "fabric-storage-control") as String as NonEmptyStr
}

fn fabric_storage_ownership_marker_path(instance: HostDashboardInstance) -> NonEmptyStr {
  dashboard_ownership_marker_in(root: fabric_storage_control_directory_path(instance: instance) as String as FilePath, instance_id: instance.instance_id) as String as NonEmptyStr
}

data fabric_storage_marker_observer: PosixUser = fleet_posix_ci_runner_user

fn fabric_storage_control_directory(instance: HostDashboardInstance) -> ManagedDirectory {
  let service = srv1_dashboard_service_principal()
  ManagedDirectory {
    member: "fabric-storage-control",
    path: fabric_storage_control_directory_path(instance: instance) as String as FilePath,
    owner: service,
    group_principal: fabric_storage_marker_observer,
    dependents: [
      DirectoryDependent { who: service, needs: [Read, Write, Execute] },
      DirectoryDependent { who: fabric_storage_marker_observer, needs: [Read, Execute] },
    ],
    ownership: Ensured,
    entries: EntriesUnmanaged,
  }
}

fn fabric_storage_ownership_marker_content(instance: HostDashboardInstance) -> NonEmptyStr {
  join(["deployment=", instance.deployment.name as String, "\nhost=", instance.host_identity as String, "\n"], "") as NonEmptyStr
}

type FabricStorageOwnershipMarkerSpec {
  path: NonEmptyStr
  content: NonEmptyStr
  mode: FileMode
  owner: NonEmptyStr
  group: NonEmptyStr
}

data fabric_storage_ownership_marker_mode: FileMode = FileMode {
  owner: PermissionBits { read: true, write: true, execute: false },
  group: PermissionBits { read: true, write: false, execute: false },
  other: PermissionBits { read: true, write: false, execute: false },
  setuid: false,
  setgid: false,
  sticky: false,
}

fn fabric_storage_ownership_marker_spec(instance: HostDashboardInstance) -> FabricStorageOwnershipMarkerSpec {
  FabricStorageOwnershipMarkerSpec {
    path: fabric_storage_ownership_marker_path(instance: instance),
    content: fabric_storage_ownership_marker_content(instance: instance),
    mode: fabric_storage_ownership_marker_mode,
    owner: srv1_dashboard_service_principal().name,
    group: srv1_dashboard_service_principal().name,
  }
}

type FabricStorageMarkerReading {
  path: NonEmptyStr
  content: String
  mode: String
  owner: String
  group: String
}

type FabricStorageMarkerVerdict
  = FabricStorageMarkerExact
  | FabricStorageMarkerMismatched { field: NonEmptyStr, expected: String, observed: String }

fn fabric_storage_marker_mode_matches(spec: FileMode, observed: String) -> Bool {
  match file_mode_of_octal_text(text: observed) {
    Present { value: m } => file_mode_octal(mode: m) == file_mode_octal(mode: spec)
    Absent => false
  }
}

fn fabric_storage_marker_verdict(spec: FabricStorageOwnershipMarkerSpec, reading: FabricStorageMarkerReading) -> FabricStorageMarkerVerdict {
  if !((reading.path as String) == (spec.path as String)) { FabricStorageMarkerMismatched { field: "path", expected: spec.path as String, observed: reading.path as String } }
  else if !(reading.content == (spec.content as String)) { FabricStorageMarkerMismatched { field: "content", expected: spec.content as String, observed: reading.content } }
  else if !fabric_storage_marker_mode_matches(spec: spec.mode, observed: reading.mode) { FabricStorageMarkerMismatched { field: "mode", expected: file_mode_octal(mode: spec.mode), observed: reading.mode } }
  else if !(trim(s: reading.owner) == (spec.owner as String)) { FabricStorageMarkerMismatched { field: "owner", expected: spec.owner as String, observed: reading.owner } }
  else if !(trim(s: reading.group) == (spec.group as String)) { FabricStorageMarkerMismatched { field: "group", expected: spec.group as String, observed: reading.group } }
  else { FabricStorageMarkerExact }
}

// WHETHER AN INSTANCE HOLDS THE PLACEMENT: the store is the prod deployment's state, so the placement
// FOLLOWS gunbc.deployment_risk prod_role_selection through the realization (gunbc.roadmap.roadmap_dashboard_instance
// prod_role_realization): the instance whose deployment the holder token names holds it, every other
// instance -- and every instance under a refused realization -- does not. Moving prod is an edit to
// the selection row; nothing here names srv1.
fn fabric_storage_placed_on(realization: ProdRoleRealization, instance: HostDashboardInstance) -> Bool {
  match realization {
    ProdRoleRealizedBy { holder } => holder.instance.deployment == instance.deployment
    ProdRoleRealizationRefused { cause: _ } => false
  }
}

fn fabric_storage_endpoint_for(host: HostIdentity) -> NonEmptyStr? {
  match fleet_intent_network.tailnet_domain {
    Absent => none
    Present { value: domain } => Present { value: join(["https://", host as String, ".", domain as String, ":", to_string(fabric_storage_https_port), fabric_storage_route_prefix], "") as NonEmptyStr }
  }
}

// UNDER A REFUSED REALIZATION THE PLACEMENT REFUSES with the realization's typed cause; it never falls
// back to srv1 (DESIGN 5). The runtime placement over the ACTUATED realization is
// gunbc.fabric.fabric_storage_binding fabric_storage_placement: this module is imported by
// gunbc.live_deploy.spec, which cannot see the desired roster that decides actuatability.
fn fabric_storage_placement_under(realization: ProdRoleRealization) -> FabricStoragePlacement {
  match realization {
    ProdRoleRealizationRefused { cause } => FabricStoragePlacementRefused { cause: cause }
    ProdRoleRealizedBy { holder } => {
      let instance = holder.instance
      let host = instance.host_identity as String as HostIdentity
      match fabric_storage_endpoint_for(host: host) {
        Absent => FabricStorageUnplaced
        Present { value: e } => FabricStoragePlaced {
          host: host,
          instance: instance,
          endpoint: e,
          door_socket: fabric_storage_door_socket(instance: instance),
        }
      }
    }
  }
}

// ── WHO WRITES THE STORE, AND SO WHAT ITS DIRECTORIES ARE ────────────────────────────────────────
//
// ONE PRINCIPAL WRITES THIS STORE'S FILES: the served endpoint (gunbc.live_deploy.emit
// live_deploy_fabric_storage_unit_file), running as the dashboard service principal. Every writer --
// a remote host through tailscale serve, and the placed host's own jobs and operator through the
// door socket -- reaches the files only as a request to that process, so the door's admission
// (gunbc.fabric.fabric_storage_serve) is the one wall over every writer. Until 2026-09-27 the CI job
// principal ALSO wrote the files directly (FabricStorageLocalFiles, bound for the placed host by
// gunbc.fabric.fabric_storage_binding fabric_storage_binding_for), and the areas were group ghrunner so it
// could; that in-process route is retired (operator ruling relayed by proud-deer-538), and with it
// the group. A writer now needs no filesystem grant on the store at all: it needs to reach the door.
//
// Both writes are create-only in flat directories: an object is an exclusive create, and a head
// generation is a staged sibling hard-linked into its name (gunbc.durable_cas_file_store
// DefaultAccessCreateOnly), so the service needs Read, Write and Execute on objects/ and heads/ and
// Execute on the root. Nothing is writable after publication; the entry mode is derived from the
// same dependents (gunbc.managed_directory managed_directory_entry_mode).
//
// WHAT THIS DOES NOT WALL: root, and the service principal itself -- any process running as the
// operator account can write the files without passing the door. Those are outside the door's
// model and stated here so they are chosen, not inherited.
//
// THE ENTRIES ARE NOT REPAIRED BY THE ENSURE ANY MORE: the service is the only writer, and it
// publishes every entry at the declared mode itself (fabric_storage_placed_file_root). Entries the
// CI principal wrote in process before the door cutover are ghrunner's and were repaired to
// other-read by the ensure this replaces; the service reads them through that bit, and a read
// that fails refuses loudly at the store rather than being papered over here.
fn fabric_storage_directory(member: NonEmptyStr, path: NonEmptyStr, writes: Bool) -> ManagedDirectory {
  let service = srv1_dashboard_service_principal()
  ManagedDirectory {
    member: member,
    path: path as String as FilePath,
    owner: service,
    group_principal: service,
    dependents: [
      DirectoryDependent { who: service, needs: if writes { [Read, Write, Execute] } else { [Execute] } },
    ],
    ownership: Ensured,
    entries: EntriesUnmanaged,
  }
}

// THE DOOR'S DIRECTORY IS THE LOCAL WRITER ROSTER. A local process reaches the socket only by
// traversing this directory, and the door's handler admits a local peer only if it is one of these
// dependents (gunbc.fabric.fabric_storage_serve fabric_storage_door_local_writers) -- one declaration read
// twice, by the kernel and by the handler. The service owns it; the CI runner (fleet-converge jobs on
// the placed host) is its group and needs only to traverse to connect: the socket itself is opened
// to every class by `gunbc serve --unix-socket`, so its directory is the whole filesystem wall.
fn fabric_storage_door_dependents() -> List<DirectoryDependent> {
  let service = srv1_dashboard_service_principal()
  [
    DirectoryDependent { who: service, needs: [Read, Write, Execute] },
    DirectoryDependent { who: fleet_posix_ci_runner_user, needs: [Execute] },
  ]
}

fn fabric_storage_door_directory(instance: HostDashboardInstance) -> ManagedDirectory {
  ManagedDirectory {
    member: "fabric-storage-door",
    path: fabric_storage_door_directory_path(instance: instance) as String as FilePath,
    owner: srv1_dashboard_service_principal(),
    group_principal: fleet_posix_ci_runner_user,
    dependents: fabric_storage_door_dependents(),
    ownership: Ensured,
    entries: EntriesUnmanaged,
  }
}

fn fabric_storage_door_local_writers() -> List<NonEmptyStr> {
  map(fabric_storage_door_dependents(), d => d.who.name)
}

// ONE ENTRY MODE FOR THE STORE, OR A REFUSAL. Both writable areas derive it from their own
// dependents; they must agree, because the store publishes objects and heads under one declared
// mode, and a disagreement means the two areas' readers differ -- a modeling change this function
// refuses to paper over by picking one.
type FabricStorageEntryMode
  = FabricStorageEntryModeDerived { mode: FileMode }
  | FabricStorageEntryModeRefused { detail: NonEmptyStr }

fn fabric_storage_entry_mode_of(objects: ManagedDirectory, heads: ManagedDirectory) -> FabricStorageEntryMode {
  match managed_directory_entry_mode(d: objects) {
    ManagedEntryModeRefused { member, path: _, reason } => FabricStorageEntryModeRefused { detail: join([member as String, ": ", reason as String], "") as NonEmptyStr }
    ManagedEntryModeDerived { mode: o } =>
      match managed_directory_entry_mode(d: heads) {
        ManagedEntryModeRefused { member, path: _, reason } => FabricStorageEntryModeRefused { detail: join([member as String, ": ", reason as String], "") as NonEmptyStr }
        ManagedEntryModeDerived { mode: h } =>
          if file_mode_bits(mode: o) == file_mode_bits(mode: h) { FabricStorageEntryModeDerived { mode: o } }
          else { FabricStorageEntryModeRefused { detail: "the objects and heads areas derive different entry modes" as NonEmptyStr } }
      }
  }
}

fn fabric_storage_entry_mode(instance: HostDashboardInstance) -> FabricStorageEntryMode {
  let areas = fabric_store_area_paths(members: fabric_storage_slots, instance: instance)
  fabric_storage_entry_mode_of(
    objects: fabric_storage_directory(member: "fabric-storage-objects", path: areas.objects, writes: true),
    heads: fabric_storage_directory(member: "fabric-storage-heads", path: areas.heads, writes: true),
  )
}

// THE FABRIC DB, A SEALED VALUE MINTED FROM ITS DECLARATION. FabricStorage is sole_constructor and this
// file builds it in one place, fabric_storage_placed_store, which takes the instance and NOTHING ELSE: the
// root is derived here from fabric_storage_slots and that instance, the entry mode from the declared
// writers (fabric_storage_entry_mode), the directory is listed, and only a listed directory yields a
// store. It holds DATA -- the instance it was minted for, the derived root and the entry mode -- and the
// store's operations are the functions below that take it (fabric_namespace_head, _put, _advance,
// _closure), each running the file store over the record's root. No function anywhere takes a path and
// answers a FabricStorage; spelling one (literal or cast) is a SoleConstructorViolation. The served door
// (gunbc.fabric.fabric_storage_serve) takes this type. Non-generic and never a variant arm, because the
// seal does not reach variant construction (test.claim.sole_constructor_completeness_audit_probe f13).
// WHAT IS SEALED IS CONSTRUCTION: a forged store, or one around a root its declaration did not derive,
// does not compile. Field reads are not sealed, so a holder can read the wrapped areas; that, and any module
// running the file store over a path of its own, is the declared residual
// gunbc.recurring_failure_mode a_slot_store_is_built_over_a_literal_path_by_any_module. NOT established:
// a store minted for instance A refused where B is required (one type for both).
// FabricStorage WRAPS the sealed operations record: it carries no root, no objects/heads and no mode of
// its own, so the root is derived once, in fabric_store_open, and every route reaches the file store
// through that one record. What this contract adds over the wrapped record is the ENTRY-MODE REFUSAL
// below -- the public namespace refuses while its writers are undeclared, where compute's capacity ledger
// (gunbc.compute.host_capacity) has no such refusal -- and the instance the store was minted for.
type FabricStorage sole_constructor {
  instance: NonEmptyStr
  ops: FabricStorageOperations
}

// THE PLACED STORE, WITH THE DERIVED ENTRY MODE, which is what the served handler binds, so every entry
// it publishes carries the bits the declared readers need.
type FabricStoragePlacedRoot
  = FabricStoragePlacedRootReady { store: FabricStorage }
  | FabricStoragePlacedRootRefused { detail: NonEmptyStr }

// THE ENTRY-MODE REFUSAL IS THIS MINT'S, and it comes FIRST: the public namespace publishes at a declared
// mode, and while its writers are undeclared NO store is minted -- not a store that would post at the
// process umask instead. The observation of the directory (list the declared root, then stand up its
// areas) belongs to the ONE generic mint, which takes the declared chain and this instance and never a
// path; a refusal there is carried out with its area and its cause rather than yielding a store whose
// every operation would refuse.
fn fabric_storage_placed_store(instance: HostDashboardInstance) -> FabricStoragePlacedRoot {
  match fabric_storage_entry_mode(instance: instance) {
    FabricStorageEntryModeRefused { detail } => FabricStoragePlacedRootRefused { detail: detail }
    FabricStorageEntryModeDerived { mode } =>
      match fabric_store_open(members: fabric_storage_slots, instance: instance, entry_mode: Present { value: mode }) {
        FabricStoreUnready { area: a, detail: d } =>
          FabricStoragePlacedRootRefused { detail: join(["the fabric DB (", a, ") is not standing: ", d], "") as NonEmptyStr }
        FabricStoreReady { store: ops } => FabricStoragePlacedRootReady { store: FabricStorage { instance: instance.instance_id, ops: ops } }
      }
  }
}

// THE AUTHENTICATED STATE NAMESPACE, SEALED THE SAME WAY AND AS ITS OWN TYPE, so the public namespace's
// store cannot be handed where the state store is required (gunbc.fabric.fabric_storage_state_serve takes
// this type). Its entries publish at the writing process's umask, as they did before it was sealed: no
// entry mode is declared for this namespace, and choosing one is not this change's.
type FabricStateStorage sole_constructor {
  instance: NonEmptyStr
  ops: FabricStorageOperations
}

type FabricStateStorageReading
  = FabricStateStorageReady { store: FabricStateStorage }
  | FabricStateStorageUnready { detail: NonEmptyStr }

// THE SAME GENERIC MINT, the state chain's data row, and no entry mode: a mint copied per store would be
// a second authority over where the state store lives, and the only difference between this and the
// public store is the row it reads and the refusal the public store adds.
fn fabric_state_storage_store(instance: HostDashboardInstance) -> FabricStateStorageReading {
  match fabric_store_open(members: fabric_storage_state_slots, instance: instance, entry_mode: none) {
    FabricStoreUnready { area: a, detail: d } =>
      FabricStateStorageUnready { detail: join(["the fabric state store (", a, ") is not standing: ", d], "") as NonEmptyStr }
    FabricStoreReady { store: ops } => FabricStateStorageReady { store: FabricStateStorage { instance: instance.instance_id, ops: ops } }
  }
}

// THE STORES' OPERATIONS. The served protocol (gunbc.fabric.fabric_storage_protocol fabric_storage_respond)
// answers either namespace, so it takes this variant, whose arms each carry a sealed store: building one
// needs a minted store, and the variant adds no route to a root. Each operation runs the file store
// (gunbc.fabric.fabric_storage_file_store) over the record's root, the public namespace at its declared
// entry mode and the state namespace at none, exactly as the door bound them before the seal.
type FabricStorageNamespace
  = FabricPublicNamespace { store: FabricStorage }
  | FabricStateNamespace { store: FabricStateStorage }

// THE NAMESPACE SELECTS WHICH SEALED OPERATIONS RECORD to run; it does not rebuild one from a root. Each
// arm's record was minted by the one mint, already carrying the posture that namespace publishes at --
// the public namespace at its declared entry mode, the state namespace at none (the process umask).
fn fabric_namespace_ops(namespace: FabricStorageNamespace) -> FabricStorageOperations {
  match namespace {
    FabricPublicNamespace { store } => store.ops
    FabricStateNamespace { store } => store.ops
  }
}

fn fabric_namespace_head(namespace: FabricStorageNamespace, name: NonEmptyStr) -> FabricHeadRead {
  fabric_storage_file_head(root: fabric_namespace_ops(namespace: namespace), name: name)
}

fn fabric_namespace_put(namespace: FabricStorageNamespace, object: FabricObject) -> FabricPut {
  fabric_storage_file_put(root: fabric_namespace_ops(namespace: namespace), object: object)
}

fn fabric_namespace_advance(namespace: FabricStorageNamespace, name: NonEmptyStr, expected: FabricHeadExpectation, target: FabricObjectRef) -> FabricHeadAdvance {
  fabric_storage_file_advance(root: fabric_namespace_ops(namespace: namespace), name: name, expected: expected, target: target)
}

fn fabric_namespace_closure(namespace: FabricStorageNamespace, name: NonEmptyStr, bound: Nat) -> FabricClosureRead {
  fabric_storage_file_closure(root: fabric_namespace_ops(namespace: namespace), name: name, bound: bound)
}

fn fabric_storage_store_directories(instance: HostDashboardInstance) -> List<ManagedDirectory> {
  let root = fabric_storage_store_root(instance: instance)
  let areas = fabric_store_area_paths(members: fabric_storage_slots, instance: instance)
  let state_root = fabric_state_storage_root(instance: instance)
  let state_areas = fabric_store_area_paths(members: fabric_storage_state_slots, instance: instance)
  [
    fabric_storage_directory(member: "fabric-storage-root", path: root, writes: false),
    fabric_storage_directory(member: "fabric-storage-objects", path: areas.objects, writes: true),
    fabric_storage_directory(member: "fabric-storage-heads", path: areas.heads, writes: true),
    fabric_storage_state_directory(member: "fabric-state-root", path: state_root),
    fabric_storage_state_directory(member: "fabric-state-objects", path: state_areas.objects),
    fabric_storage_state_directory(member: "fabric-state-heads", path: state_areas.heads),
    fabric_storage_door_directory(instance: instance),
    fabric_storage_control_directory(instance: instance),
  ]
}

// THE STORE'S DIRECTORIES AS THE PLACED INSTANCE'S DEMAND. The root alone is not a store -- the file
// store writes objects and heads under it, and a create-new under an absent area refuses not_found --
// so every area is demanded, each a managed directory whose owner, group and mode derive from the
// writers declared above; a writer the owner and group do not cover refuses in the provider
// (gunbc.owned_directory owned_directory_mode) rather than widening. Every other instance demands
// nothing, so a lab twin never creates srv1's store. The store is durable history: nothing the
// deployment does removes it.
fn fabric_storage_directory_demands(realization: ProdRoleRealization, instance: HostDashboardInstance) -> List<OwnedDirectoryTarget> {
  if fabric_storage_placed_on(realization: realization, instance: instance) {
    map(fabric_storage_store_directories(instance: instance), d => OwnedDirectoryManaged { directory: d })
  } else {
    []
  }
}

// The authenticated state space shares the fabric DB service and CAS implementation, but never
// shares its object directory with the legacy CI-writable namespace. A public head alias therefore
// cannot expose private state objects. Only the store service writes here, even for local callers.
fn fabric_storage_state_directory(member: NonEmptyStr, path: NonEmptyStr) -> ManagedDirectory {
  let service = srv1_dashboard_service_principal()
  ManagedDirectory {
    member: member, path: path as String as FilePath, owner: service, group_principal: service,
    dependents: [DirectoryDependent { who: service, needs: [Read, Write, Execute] }],
    ownership: Ensured, entries: EntriesUnmanaged,
  }
}
