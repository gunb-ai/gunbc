module gunbc.fabric_m0_commit

import std.types { List, NonEmptyStr }
import std.content_hash { Sha256Digest }
import std.scoped_authorization { AttemptIdentity }
import product.fabric.identity { WorkKey }
import product.fabric.work { OutputObligationsResolution }
import std.durable_compare_and_set { CasOutcome }
import gunbc.fabric_m0_origin_readback {
  OriginReading,
  OriginReadingOutcome,
  OriginReadingTaken,
  OriginReadingUnavailable,
  OriginFetchOutcome,
  OriginObjectStaged,
  OriginObjectAbsent,
  OriginFetchUnavailable,
}
import gunbc.fabric_m0_completion {
  ComputationOutcome,
  CommittedOutput,
  CommitManifest,
  OriginObservation,
  CommitManifestSubject,
  ManifestMember,
  OriginReadback,
  ReadbackConfirmed,
  ReadbackAbsent,
  ReadbackUnknown,
  JobPublication,
  admit_job_publication,
}

// The commit boundary: it turns what the STORE said about the manifest slot into the readback the
// completion authority consumes, and it is the only place allowed to make that translation.
//
// WHY THIS LAYER EXISTS AT ALL rather than the caller handing a readback straight to
// admit_job_publication: the completion authority takes an OriginReadback as a given, so somebody
// has to derive one honestly from a real conditional write. Doing that at the call site would put
// the timeout rule below in every caller, which is the second-representation failure -- and the
// arm most likely to be got wrong is the one that costs nothing to get wrong locally.

// A store answer and the ABSENCE of a store answer are different facts.
//
// std.durable_compare_and_set's CasOutcome distinguishes committed, precondition-failed and
// store-refused, and every one of those is something the store SAID. A request that timed out or
// whose acknowledgement was lost obtained none of them, so rendering it as any CasOutcome would
// manufacture a store verdict to fit the branches available -- fabricating the one fact the caller
// most needs to not be invented. It is a sibling of the outcome, never an arm of it.
type CommitTransportOutcome
  = StoreAnswered { slot: NonEmptyStr, outcome: CasOutcome<Sha256Digest> }
  | StoreDidNotAnswer { slot: NonEmptyStr, cause: NonEmptyStr }

// THE SLOT AN ANSWER IS ABOUT, carried so it can be compared with the slot we asked about.
//
// std.durable_compare_and_set declares this boundary rather than closing it: its CasSlotVersion
// deliberately drops the key, and it records that an unkeyed observation describes NO slot, so
// cas_decide never reads attempt.key and an observation read from slot B still commits to slot A
// when the generations agree. It names the realization as the owner of that relation, and this
// module is that realization's boundary, so the comparison lives here or nowhere.
//
// One authority for the slot name: the key is DERIVED from the attempt rather than passed beside
// it, because a caller-supplied key next to a caller-supplied attempt is two spellings of one fact
// and they can disagree -- which is the shape the CAS module already had to correct once.
// The namespace is RECEIVED, never spelled here. A versioned namespace is a binding decision owned
// by whoever selects and configures the durable origin, so a literal prefix in this fold would be
// business policy sitting inside an interface -- the layer inversion DESIGN 3 names, whose tell is
// exactly this: a literal carried where a parameter belongs.
//
// What stays derived is the KEY, because that is the part with a correctness argument: taking a
// caller-supplied key beside a caller-supplied attempt would be two spellings of one fact that can
// disagree. Receiving the namespace and deriving the key from it keeps one authority for the
// derivation while leaving the namespace free to be versioned, re-homed, or bound to an on-fleet
// origin without touching this module.
type CommitNamespace = NonEmptyStr where brand("CommitNamespace")

fn commit_slot_key(namespace: CommitNamespace, attempt: AttemptIdentity) -> NonEmptyStr {
  namespace + "/" + attempt
}

fn transport_slot(transport: CommitTransportOutcome) -> NonEmptyStr {
  match transport {
    StoreAnswered { slot: s, outcome: _ } => s
    StoreDidNotAnswer { slot: s, cause: _ } => s
  }
}

// A foreign-slot answer is UNKNOWN about our object, never absence and never confirmation.
//
// It is not a softer refusal: an answer about someone else's slot carries no information about
// ours, so reporting absence would assert something nobody observed, and reporting confirmation
// would be the wrong-slot commit this check exists to stop. Unknown with a cause naming the
// mismatch is the honest state, and it cannot publish success.
fn slot_mismatch_readback(expected: NonEmptyStr, actual: NonEmptyStr) -> OriginReadback {
  ReadbackUnknown { cause: "store answered about a different slot: expected " + expected + ", answer names " + actual }
}

// What an independent reader saw at the manifest slot afterwards, kept separate from what the write
// call returned. A write that reported success and a read that confirms the intended bytes are two
// observations, and only the second establishes the object is there to be recovered.
//
// THE HOLE THIS SHAPE USED TO LEAVE, and why the repair is a different shape rather than a stronger
// check. The local cache and the durable origin address the SAME immutable object by the SAME
// content key, so a cache hit and an origin read are byte-identical and indistinguishable once the
// digest is in hand. The previous shape said so and carried a ReadSource stamp beside the observed
// digest, refusing the cache arm in the fold below. That was VALIDATION STANDING WHERE CONSTRUCTION
// WAS AVAILABLE, and it failed its own review tell exactly: the check was satisfied by editing the
// DECLARATION -- writing DurableOriginRead instead of DisposableCacheRead -- while the realization
// still digested a local copy. Worse, the digest itself was an author's assertion, so a caller
// could stamp origin provenance over a digest taken from nothing at all.
//
// THE CONSTRUCTION: ManifestRead carries an OriginReading, which is sole_constructor in
// gunbc.fabric_m0_origin_readback and is produced only by the operation that digests a named file.
// There is no stamp to edit, because there is no stamp: a confirming read is reachable only by
// having digested a file, and the file is named in the same value. ReadSource, DurableOriginRead
// and DisposableCacheRead are DELETED rather than kept beside it -- a stamp surviving next to the
// construction would be the second authority DESIGN 3 forbids, and the fold arm that refused it is
// dissolved with it (DESIGN 4b(4): the lower-rung production handling goes, the evidence stays).
//
// WHAT IS STILL A DECLARED BOUNDARY: which file the readback staged. That is
// gunbc.fabric_m0_origin_readback's subject and its trigger; it is cited here, not restated.
type ManifestReadbackObservation
  = ManifestRead { reading: OriginReading }
  | ManifestNotFound
  | ManifestReadUnavailable { cause: NonEmptyStr }

// The mint side of the boundary, kept as a pure fold so this authority performs no effect. The read
// itself is gunbc.fabric_m0_origin_readback's; this only says what a taken or untaken reading means
// about the manifest slot. An unavailable reading is UNKNOWN, never absence.
fn manifest_read_of(outcome: OriginReadingOutcome) -> ManifestReadbackObservation {
  match outcome {
    OriginReadingTaken { reading: r } => ManifestRead { reading: r }
    OriginReadingUnavailable { staged_path: _, cause: c } => ManifestReadUnavailable { cause: c }
  }
}

// THE SAME FOLD OVER A SELF-STAGING FETCH, and the one that reaches ManifestNotFound. manifest_read_of
// above cannot: a caller-named file that is not there is an UNAVAILABLE reading, because nothing
// about a missing local file says the ORIGIN holds no object. A fetch that asked the origin for the
// manifest's key and was told there is none is the only route to absence, and it arrives here as
// the fetch's own arm rather than as a caller's assertion. The staged arm carries the reading the
// fetch minted over its own output, so a confirmation reached through this fold digested bytes the
// origin returned, at a path the caller never chose. This change adds the fold, not the producer.
fn manifest_read_of_origin_fetch(fetch: OriginFetchOutcome) -> ManifestReadbackObservation {
  match fetch {
    OriginObjectStaged { key: _, reading: r } => ManifestRead { reading: r }
    OriginObjectAbsent { key: _ } => ManifestNotFound
    OriginFetchUnavailable { key: _, cause: c } => ManifestReadUnavailable { cause: c }
  }
}

// WHAT A CALLER THAT KNOWS IT READ A CACHE SHOULD RETURN. This is a SAFE HELPER, not a total
// classifier, and the difference is the whole honesty of this module.
//
// What it does give: nothing on this path can reach a confirmation. ManifestRead is unreachable
// from here because OriginReading is, so a caller routing through this function cannot publish a
// cache hit as durability no matter what it writes -- and the cause is kept rather than collapsed
// to a bare unknown, so a reader of a pending job learns which provider answered and why that did
// not establish durability.
//
// WHAT IT DOES NOT GIVE, stated because an earlier revision of this comment claimed it did: this
// function does not make a cache read UNABLE to reach a confirmation by some other route. Nothing
// stops a caller handing a /var/cache path to read_origin_staged_file; the digest would be computed
// honestly over those bytes and the reading would confirm. That is path PROVENANCE, which is a
// different fact from the path-digest coherence OriginReading establishes, and it is exactly the
// mitigatable enclosing class gunbc.fabric_m0_origin_readback declares with its capability trigger.
// Using this helper is a discipline; the construction underneath it is the digest, not the source.
fn cache_manifest_read(provider: NonEmptyStr) -> ManifestReadbackObservation {
  ManifestReadUnavailable {
    cause: "manifest read from disposable cache " + provider + ", not the durable origin; durability unestablished",
  }
}

// THE TRANSLATION, and the only rule in this module with teeth.
//
// THE READ DECIDES WHAT DURABLE STATE EXISTS; the write outcome decides only what happened to THIS
// invocation. Those are different questions and publication cares about the first, so the fold is
// driven by the observation and consults the transport for exactly one thing: whether "not found"
// is established or merely unobserved.
//
// An unanswered write with nothing found yields Unknown, NOT absent -- "we stopped waiting" and "we
// observed non-commitment" are different facts, and collapsing them either re-executes work that may
// already be committed or publishes over bytes nobody read. When the store DID answer, its answer
// plus a fruitless read does establish absence.
//
// CasPreconditionFailed USED TO SHORT-CIRCUIT TO ABSENT HERE, and that was wrong in the case this
// module exists to serve. A precondition failure proves only that the requested conditional
// transition did not happen on this invocation; it does not prove the desired state is missing. The
// slot key is DERIVED FROM THE ATTEMPT, so the occupant of attempt A's slot is most often A's own
// earlier write -- the lost-acknowledgement retry: A writes, the acknowledgement is lost, the retry
// asks create-if-absent, the store answers precondition-failed because A's own manifest is already
// there. Reporting that as absence fails a job whose result is committed and readable. A CONFLICTING
// occupant is still caught, one layer up: the readback digest is compared against the recorded
// manifest digest, so a foreign manifest at our slot reports a content mismatch rather than success.
fn manifest_readback(namespace: CommitNamespace, attempt: AttemptIdentity, transport: CommitTransportOutcome, observed: ManifestReadbackObservation) -> OriginReadback {
  let expected = commit_slot_key(namespace: namespace, attempt: attempt)
  let actual = transport_slot(transport: transport)
  if (expected == actual) == false {
    slot_mismatch_readback(expected: expected, actual: actual)
  } else {
    manifest_readback_for_slot(transport: transport, observed: observed)
  }
}

fn manifest_readback_for_slot(transport: CommitTransportOutcome, observed: ManifestReadbackObservation) -> OriginReadback {
  match observed {
    ManifestRead { reading: r } => ReadbackConfirmed { reading: r }
    ManifestReadUnavailable { cause: rc } => ReadbackUnknown { cause: rc }
    ManifestNotFound =>
      match transport {
        StoreAnswered { slot: _, outcome: _ } => ReadbackAbsent
        StoreDidNotAnswer { slot: _, cause: c } => ReadbackUnknown { cause: c }
      }
  }
}

// The manifest states WHAT WAS OWED; it no longer carries a read result.
fn commit_manifest(attempt: AttemptIdentity, manifest_digest: Sha256Digest, members: List<ManifestMember>) -> CommitManifest {
  CommitManifest {
    attempt: attempt,
    manifest_digest: manifest_digest,
    members: members,
  }
}

// A store that says committed is still not a recovered result: the manifest is only confirmed by an
// independent read of the intended object, so what this boundary contributes to the completion
// authority is an OBSERVATION -- the READ's verdict -- and never the write's.
//
// This is the only manifest observation the authority will find under that subject, and it is
// DERIVED here from the transport and the read rather than accepted from the caller. A caller of
// publish_after_commit supplies reads of the required objects; it cannot supply the manifest's,
// because the slot the manifest lives at is derived from the namespace and the attempt one layer
// down and a hand-supplied observation could disagree with it.
fn manifest_observation(
  namespace: CommitNamespace,
  attempt: AttemptIdentity,
  transport: CommitTransportOutcome,
  observed: ManifestReadbackObservation
) -> OriginObservation {
  OriginObservation {
    subject: CommitManifestSubject {},
    readback: manifest_readback(namespace: namespace, attempt: attempt, transport: transport, observed: observed),
  }
}

// The consumer: one call from a real commit attempt to a published outcome.
//
// CONSUMPTION STATE, STATED HONESTLY (DESIGN 3c). gunbc.fabric_m0_publication publish_work is the
// named join that holds a run's Work and calls this function; the instrument
// tools.fabric_m0_origin_readback_probe is the second caller, driving the whole gate over real
// bytes. That join is itself a DECLARED FRONTIER. Rewriting this paragraph as CONSUMED while the
// route terminated in a test was false.
//
// THIS PARAGRAPH IS MAIN'S, RESTORED, AND THE RESTORATION IS THE POINT. gunbc#10933 corrected it in
// the same commit that added publish_work -- an atomic, correct edit -- and this branch silently
// carried the superseded `exercised by the enrolled witnesses and by nothing else` text back over
// it. THE RESURRECTION ENTERED EARLY, at the `--ours` resolution taken when gunbc#10934's squash
// collided -- there WAS a conflict there, which is what an `--ours` resolution answers -- and the
// check run at that moment asked only whether main had touched the file AFTER the squash. It had
// touched it BEFORE, inside the range that question excludes.
//
// EVERY LATER INTEGRATION THEN CARRIED IT FORWARD LEGITIMATELY AND SILENTLY, and that is the half
// worth recording: by then only one side had touched this file, so git had nothing to conflict about
// and correctly kept the branch text. Merge 542e069b64 is the observation -- its base already
// contained gunbc#10933, and its result nonetheless carried the superseded paragraph. No conflict
// was raised at that merge and no merge commit touched this file. A clean merge is exactly the thing
// that will not tell you, and a three-dot diff compares against the merge base, so branch text
// reverting main reads there as no change at all; only `git diff origin/main HEAD` shows it. That is
// why the receipt is here rather than in a commit message.
//
// WHAT IS CHANGED FROM MAIN'S TEXT, and only this: the second consumer is named, and the clause
// `today it is reached by enrolled witnesses and by no job-ending on a run path` is DROPPED. That
// clause is a live open-world negative with no producer and no date -- nothing derives it, nothing
// recomputes it, and the mutation that falsifies it is the one least likely to touch this comment.
// The trigger below states the same fact positively, as the capability that closes the frontier,
// which is the tracked shape and carries the whole meaning.
//
// THE NAMED CONSUMER THAT DECIDES THE CHECK: gunbc.fabric_m0_job_ending end_required_job.
// THE REMAINING FRONTIER TRIGGER: wiring that ending into required-CI (or another real job
// process) so the check conclusion is the CheckConclusion it returns, once an independent origin
// readback is constructible on the run path -- the roadmap's compute-artifact-return-and-
// materialization capability. Naming a smaller artifact -- one fold, one witness file, one
// emitted script -- would be satisfied while the capability stayed dead. Sibling lanes own origin
// binding and cache; fabricating a confirming readback on the required-CI path would be the silent
// default this gate exists to refuse, and main's text said `DurableOriginRead` there, a variant
// gunbc#10934 deleted -- the decayed citation DESIGN 3's cite-the-symbol rule exists to prevent. It
// is no longer expressible at all: a confirming readback carries an OriginReading, which only
// gunbc.fabric_m0_origin_readback read_origin_staged_file can produce.
//
// This is a consumption frontier, NOT a guarantee drop: the gate's walls are enrolled and executing
// over the population they are declared for, so no rung is being lowered by the wait.
fn publish_after_commit(
  namespace: CommitNamespace,
  attempt: AttemptIdentity,
  computation: ComputationOutcome,
  resolution: OutputObligationsResolution,
  judged_work: WorkKey,
  committed: List<CommittedOutput>,
  observations: List<OriginObservation>,
  manifest_digest: Sha256Digest,
  members: List<ManifestMember>,
  transport: CommitTransportOutcome,
  observed: ManifestReadbackObservation
) -> JobPublication {
  admit_job_publication(
    attempt: attempt,
    computation: computation,
    resolution: resolution,
    judged_work: judged_work,
    committed: committed,
    observations: concat(
      observations,
      [manifest_observation(namespace: namespace, attempt: attempt, transport: transport, observed: observed)]
    ),
    manifest: commit_manifest(attempt: attempt, manifest_digest: manifest_digest, members: members)
  )
}
