  OriginReadingTaken, OriginReadingUnavailable, read_origin_staged_file, origin_reading_digest, origin_reading_path,
}
import gunbc.fabric_m0_completion { OriginReadback, ReadbackConfirmed, ReadbackAbsent, ReadbackUnknown }
import gunbc.fabric_m0_origin_filesystem { content_addressed_origin_key }
import gunbc.fabric_m0_origin_host {
  fabric_origin_primary_placement, fabric_origin_replica_placement,
  fabric_origin_handoff_incoming_path, fabric_origin_handoff_outgoing_path,
  FabricOriginAutomationLogin, FabricOriginAutomationGrounded, FabricOriginAutomationUnallocated, fabric_origin_automation_login,
}
