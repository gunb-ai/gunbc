module gunbc.fabric_storage_state_policy

import gunbc.secret_provision { SecretRef, fleet_secret_ref, secret_ref_pin_version }

// Desired bootstrap pin. Provisioning must observe and verify this version before custody or
// migration may report success; declaring the target is not evidence that the secret exists.
data fabric_state_key_secret_ref: SecretRef = secret_ref_pin_version(
  ref: fleet_secret_ref(secret_id: "fabric-state-writer-mac-key"), version: "1",
)
