module gunbc.fabric.fabric_ci_step

// THE CI RUN-STEP LEAF OF THE FABRIC DOMAIN: the `gunbc run` target and invoke of the
// fabric_writer_identity_observe step, beside the domain whose entry module it invokes
// (gunbc.fabric.fabric_writer_identity_observe). The shared run-step machinery is
// v2.workflow.gunbc_invoke_step_emit, gunbc.ci.ci_layer_roots and
// gunbc.ci.ci_run_step_target; the roster stays in gunbc.ci.ci_spec, which imports the
// target. A step module imports the shared machinery, never ci_spec.

import std.types { String }
import v2.workflow.gunbc_invoke_step_emit { gunbc_run_step_script }
import gunbc.ci.ci_run_step_target { GunbcRunStepTarget }
import gunbc.ci.ci_layer_roots { witness_layer_roots }
import gunbc.fabric.fabric_writer_identity_observe {
  fabric_writer_identity_receipt_path
}

data gunbc_ci_fabric_writer_identity_observe_target: GunbcRunStepTarget = GunbcRunStepTarget {
  entry: "dag/gunbc/fabric/fabric_writer_identity_observe.dag",
  function: "fabric_writer_identity_observe_wet",
}

fn gunbc_ci_fabric_writer_identity_observe_invoke() -> String {
  gunbc_run_step_script(
    source_roots: witness_layer_roots,
    entry: gunbc_ci_fabric_writer_identity_observe_target.entry,
    function: gunbc_ci_fabric_writer_identity_observe_target.function,
    claim_run: false,
    receipt_rel: fabric_writer_identity_receipt_path
  )
}
