module gunbc.fabric_m0_publication

import std.types { List }
import std.content_hash { Sha256Digest }
import std.scoped_authorization { AttemptIdentity }
import product.fabric.work {
  Work,
  resolve_output_obligations,
  ObligationsJudgedAtAdmissionGate,
}
import gunbc.fabric_m0_completion {
  ComputationOutcome,
  CommittedOutput,
  OriginObservation,
  ManifestMember,
  JobPublication,
}
import gunbc.fabric_m0_commit {
  CommitNamespace,
  CommitTransportOutcome,
  ManifestReadbackObservation,
  publish_after_commit,
}

// DECLARED FRONTIER, not a closed consumer (DESIGN 3c).
//
// What this fold buys over the pre-change state: it names the join point
// so the capability trigger has a subject (Work + resolve at the
// admission gate + publish_after_commit) instead of an unnamed future
// caller of publish_after_commit. It returns JobPublication unchanged --
// a second admission coproduct beside that type would nickname the
// decision and drop unresolved obligation verdicts.
//
// This join holds a run's Work, resolves that Work's obligations at the
// admission gate, and returns the publication the completion authority
// produces. Nothing here selects an origin or a cache -- those are sibling
// lanes. The commit transport and the origin observations are received, never
// invented.
//
// CONSUMERS, NAMED POSITIVELY (DESIGN 3c): this fold is called by
// test.claim.fabric_m0_publication_witness, which exercises it across the five
// publication arms. THE FRONTIER IS THE CAPABILITY THAT CLOSES IT, not a claim
// about what is absent: a job-ending that already holds a run's Work, that
// attempt's commit transport, and an INDEPENDENT ORIGIN READBACK of the commit
// manifest, and that decides the process or check conclusion from the
// JobPublication this fold returns.
//
// WHY THE REQUIRED-CI ENDING IS NOT THAT CAPABILITY, which is the part worth
// keeping: claim_executor --required-ci accumulates phase failures and maps the
// process exit to a GitHub check through floor_exit_to_check_conclusion. That
// ending never constructs CommitTransportOutcome or ManifestReadbackObservation.
// Wiring this join into it without an independent origin readback would refuse
// every green job (ReadbackUnknown) or fabricate a confirming readback. The
// missing capability is named on gunbc.fabric_m0_commit publish_after_commit.
//
// THE COMPLEMENT IS DATED, NOT ASSERTED LIVE. Measured at gunbc#10972 against
// main 51405ad9e3f: the five witness call sites above were the only callers of
// publish_work in the corpus. The previous form of this paragraph said `TODAY
// this fold is reached by enrolled witnesses and by no job-ending`, and TODAY is
// a word rather than a binding -- nothing derives that negative, nothing
// recomputes it, and the mutation that falsifies it (adding a job-ending caller)
// happens in a different file and would not touch this comment. A dated
// observation cannot rot; a live open-world negative does.
//
// THAT SENTENCE NAMED DurableOriginRead UNTIL NOW, and the symbol has not existed since gunbc#10934
// deleted the ReadSource stamp. A citation naming a declaration that no longer resolves is the
// decay DESIGN 3's cite-the-symbol rule exists to prevent, and fabricating one is no longer even
// expressible: a confirming readback carries an OriginReading, which only
// gunbc.fabric_m0_origin_readback read_origin_staged_file can produce. The hazard the sentence
// warns about is real and unchanged; only its spelling was stale.

fn publish_work<P>(
  work: Work<P>,
  attempt: AttemptIdentity,
  computation: ComputationOutcome,
  committed: List<CommittedOutput>,
  observations: List<OriginObservation>,
  namespace: CommitNamespace,
  manifest_digest: Sha256Digest,
  members: List<ManifestMember>,
  transport: CommitTransportOutcome,
  observed: ManifestReadbackObservation
) -> JobPublication {
  publish_after_commit(
    namespace: namespace,
    attempt: attempt,
    computation: computation,
    resolution: resolve_output_obligations(
      contract: work.contract,
      requirements: work.requirements,
      work_key: work.id.key,
      judgment: ObligationsJudgedAtAdmissionGate,
    ),
    judged_work: work.id.key,
    committed: committed,
    observations: observations,
    manifest_digest: manifest_digest,
    members: members,
    transport: transport,
    observed: observed
  )
}
