module gunbc.fabric_storage_client

import gunbc.fabric_storage_state_auth_io { fabric_state_signed_request }
import gunbc.fabric_storage_address { fabric_storage_state_suffix, fabric_storage_route_prefix }

import std.types { String, NonEmptyStr, Int, List }
import std.nat { Nat }
import extdeps.http.client
import extdeps.http.client { http_client_max_time_flag }
import std.measure { Second, second }
import extdeps.tools.curl { CurlExitOutcome, CurlTransferCompleted, curl_exit_outcome, curl_exit_outcome_name, classify_curl_http_code_after_newline, CurlWroteHttpStatus, CurlWroteNoHttpStatus }
import std.fabric_storage {
  FabricObject, FabricObjectRef, fabric_object_preimage, fabric_object_ref_wire,
  FabricHeadExpectation, ExpectHeadAbsent, ExpectHeadAt,
  FabricStorageFault, FabricStoreUnreachable, FabricReplyUndecodable,
  FabricPut, FabricPutRefused, FabricHeadRead, FabricHeadReadRefused,
  FabricHeadAdvance, FabricHeadAdvanceRefused, FabricClosureRead, FabricClosureRefused,
}
import gunbc.fabric_storage_wire {
  fabric_storage_unwire_head, fabric_storage_unwire_put, fabric_storage_unwire_advance, fabric_storage_unwire_closure,
  FabricIdentityRead, FabricIdentityUnproxied, FabricIdentityReadRefused, fabric_storage_unwire_identity,
}
import gunbc.fabric_storage_file_store {
  FabricStorageFileRoot, fabric_storage_file_head, fabric_storage_file_put, fabric_storage_file_advance, fabric_storage_file_closure,
}

// THE FABRIC DB AS A CALLER REACHES IT: std.fabric_storage's four operations, each bound to one of
// three handlers. The binding is realization and sits here, at the periphery (DESIGN 3: the dispatch
// that selects a realization is itself realization):
//
//   FabricStorageDoorSocket   the caller IS the placed host; one bounded POST to the door's unix
//                             socket, where the kernel attests the caller to the door.
//   FabricStorageServed       every other host; one bounded HTTPS POST to the placed host's endpoint
//                             (tailscale serve, which proxies to the same socket).
//   FabricStorageLocalFiles   the file store in process, over a root the caller names. NO PLACEMENT
//                             DERIVES IT: it is the realization the door itself runs, and the one a
//                             claim or instrument uses over its own temp root. Since 2026-09-27 the
//                             placed host's writers reach the placed store only through the door
//                             (operator ruling relayed by proud-deer-538), so every write to it passes
//                             one admission (gunbc.fabric_storage_serve).
//
// There is no fallback between them: a call that cannot reach its door answers
// FabricStoreUnreachable and the caller refuses -- it never reads a local copy.
//
// UNREACHABLE IS DECIDED HERE, FROM THE TRANSPORT, BEFORE ANY REPLY EXISTS. curl's exit status is
// classified by extdeps.tools.curl; any nonzero status is the store not being reached. A reply with
// an HTTP status other than 200 means the endpoint answered something that is not this protocol's
// outcome -- a version skew, an unknown operation -- and is FabricReplyUndecodable, never a store
// arm. Only a 200 body is decoded, and decoding refuses anything that is not fabric_storage/1.
type FabricStorageBinding
  = FabricStorageLocalFiles { root: FabricStorageFileRoot }
  | FabricStorageDoorSocket { socket: NonEmptyStr, route_prefix: NonEmptyStr }
  | FabricStorageServed { endpoint: NonEmptyStr }
  | FabricStorageBindingUnplaced
  | FabricStorageBindingRefused { detail: NonEmptyStr }



data fabric_storage_unplaced_detail: NonEmptyStr = "the fabric DB is unplaced" as NonEmptyStr

// The declared transport bounds: connecting is a handshake to one tailnet peer; a whole request is
// one store operation on local disk plus the closure's transfer. These bound a wait that was
// otherwise unbounded, not a measured cost.
data fabric_storage_connect_bound: Second = second(count: 5)
data fabric_storage_request_bound: Second = second(count: 60)

// ONE ROUND TRIP, classified. The reply body carries curl's appended status line last.
type ServedReply
  = ServedAnswered { body: String }
  | ServedFault { fault: FabricStorageFault }

fn served_reply_from(exit_code: Int, stdout: String, stderr: String) -> ServedReply {
  match curl_exit_outcome(code: exit_code) {
    CurlTransferCompleted => served_reply_from_status(stdout: stdout)
    other => ServedFault { fault: FabricStoreUnreachable { detail: join([curl_exit_outcome_name(outcome: other), ": ", stderr], "") as NonEmptyStr } }
  }
}

// The status line is read by extdeps.tools.curl's own classifier for `-w '\n%{http_code}'`, never
// re-parsed here; the body is everything before that final line.
fn served_reply_from_status(stdout: String) -> ServedReply {
  let lines = split(stdout, separator: "\n")
  let body = join(lines |> take(n: length(lines) - 1), "\n")
  match classify_curl_http_code_after_newline(stdout: stdout) {
    CurlWroteNoHttpStatus { cause: c } => ServedFault { fault: FabricReplyUndecodable { detail: c } }
    CurlWroteHttpStatus { status: st } =>
      if (st as Int) == 200 { ServedAnswered { body: body } }
      else { ServedFault { fault: FabricReplyUndecodable { detail: join(["HTTP ", to_string(st as Int), ": ", body], "") as NonEmptyStr } } }
  }
}

fn served_post_raw(endpoint: NonEmptyStr, operation: String, request: String) -> ServedReply {
  let r = http.Client.PostStdinWithin(
    url: join([endpoint as String, "/", operation], "") as NonEmptyStr,
    request_body: request,
    connect_seconds: http_client_max_time_flag(max_time: fabric_storage_connect_bound),
    max_seconds: http_client_max_time_flag(max_time: fabric_storage_request_bound),
  )
  served_reply_from(exit_code: r.exit_code, stdout: r.body, stderr: r.stderr)
}

// The socket carries the same protocol at the same route; the authority in the URL is only what
// HTTP requires to be present, and the door routes on the path alone.
fn door_post(socket: NonEmptyStr, route_prefix: NonEmptyStr, operation: String, request: String) -> ServedReply {
  if (route_prefix as String).ends_with(suffix: fabric_storage_state_suffix) {
    match fabric_state_signed_request(operation: operation, request: request) {
      Absent => ServedFault { fault: FabricStoreUnreachable { detail: "fabric state credential or clock unavailable" } }
      Present { value: envelope } => door_post_raw(socket: socket, route_prefix: route_prefix, operation: "authenticated", request: envelope)
    }
  } else { door_post_raw(socket: socket, route_prefix: route_prefix, operation: operation, request: request) }
}

fn door_post_raw(socket: NonEmptyStr, route_prefix: NonEmptyStr, operation: String, request: String) -> ServedReply {
  let r = http.Client.PostStdinWithinUnixSocket(
    socket: socket,
    url: join(["http://localhost", route_prefix as String, "/", operation], "") as NonEmptyStr,
    request_body: request,
    connect_seconds: http_client_max_time_flag(max_time: fabric_storage_connect_bound),
    max_seconds: http_client_max_time_flag(max_time: fabric_storage_request_bound),
  )
  served_reply_from(exit_code: r.exit_code, stdout: r.body, stderr: r.stderr)
}

fn expectation_request_words(expected: FabricHeadExpectation) -> String {
  match expected {
    ExpectHeadAbsent => "absent"
    ExpectHeadAt { object: o } => join(["at ", fabric_object_ref_wire(object: o) as String], "")
  }
}

// ── THE FOUR OPERATIONS, BOUND ───────────────────────────────────────────────────────────────

fn fabric_storage_head(binding: FabricStorageBinding, name: NonEmptyStr) -> FabricHeadRead {
  match binding {
    FabricStorageBindingUnplaced => FabricHeadReadRefused { fault: FabricStoreUnreachable { detail: fabric_storage_unplaced_detail } }
    FabricStorageBindingRefused { detail: d } => FabricHeadReadRefused { fault: FabricStoreUnreachable { detail: d } }
    FabricStorageLocalFiles { root: r } => fabric_storage_file_head(root: r, name: name)
    FabricStorageDoorSocket { socket: k, route_prefix: route } =>
      match door_post(socket: k, route_prefix: route, operation: "head", request: name as String) {
        ServedFault { fault: f } => FabricHeadReadRefused { fault: f }
        ServedAnswered { body: b } => fabric_storage_unwire_head(text: b)
      }
    FabricStorageServed { endpoint: e } =>
      match served_post(endpoint: e, operation: "head", request: name as String) {
        ServedFault { fault: f } => FabricHeadReadRefused { fault: f }
        ServedAnswered { body: b } => fabric_storage_unwire_head(text: b)
      }
  }
}

fn fabric_storage_put(binding: FabricStorageBinding, object: FabricObject) -> FabricPut {
  match binding {
    FabricStorageBindingUnplaced => FabricPutRefused { fault: FabricStoreUnreachable { detail: fabric_storage_unplaced_detail } }
    FabricStorageBindingRefused { detail: d } => FabricPutRefused { fault: FabricStoreUnreachable { detail: d } }
    FabricStorageLocalFiles { root: r } => fabric_storage_file_put(root: r, object: object)
    FabricStorageDoorSocket { socket: k, route_prefix: route } =>
      match door_post(socket: k, route_prefix: route, operation: "put", request: fabric_object_preimage(object: object) as String) {
        ServedFault { fault: f } => FabricPutRefused { fault: f }
        ServedAnswered { body: b } => fabric_storage_unwire_put(text: b)
      }
    FabricStorageServed { endpoint: e } =>
      match served_post(endpoint: e, operation: "put", request: fabric_object_preimage(object: object) as String) {
        ServedFault { fault: f } => FabricPutRefused { fault: f }
        ServedAnswered { body: b } => fabric_storage_unwire_put(text: b)
      }
  }
}

fn fabric_storage_advance(binding: FabricStorageBinding, name: NonEmptyStr, expected: FabricHeadExpectation, target: FabricObjectRef) -> FabricHeadAdvance {
  match binding {
    FabricStorageBindingUnplaced => FabricHeadAdvanceRefused { fault: FabricStoreUnreachable { detail: fabric_storage_unplaced_detail } }
    FabricStorageBindingRefused { detail: d } => FabricHeadAdvanceRefused { fault: FabricStoreUnreachable { detail: d } }
    FabricStorageLocalFiles { root: r } => fabric_storage_file_advance(root: r, name: name, expected: expected, target: target)
    FabricStorageDoorSocket { socket: k, route_prefix: route } =>
      match door_post(socket: k, route_prefix: route, operation: "advance", request: join([name as String, " ", expectation_request_words(expected: expected), " ", fabric_object_ref_wire(object: target) as String], "")) {
        ServedFault { fault: f } => FabricHeadAdvanceRefused { fault: f }
        ServedAnswered { body: b } => fabric_storage_unwire_advance(text: b)
      }
    FabricStorageServed { endpoint: e } =>
      match served_post(endpoint: e, operation: "advance", request: join([name as String, " ", expectation_request_words(expected: expected), " ", fabric_object_ref_wire(object: target) as String], "")) {
        ServedFault { fault: f } => FabricHeadAdvanceRefused { fault: f }
        ServedAnswered { body: b } => fabric_storage_unwire_advance(text: b)
      }
  }
}

fn fabric_storage_closure(binding: FabricStorageBinding, name: NonEmptyStr, bound: Nat) -> FabricClosureRead {
  match binding {
    FabricStorageBindingUnplaced => FabricClosureRefused { fault: FabricStoreUnreachable { detail: fabric_storage_unplaced_detail } }
    FabricStorageBindingRefused { detail: d } => FabricClosureRefused { fault: FabricStoreUnreachable { detail: d } }
    FabricStorageLocalFiles { root: r } => fabric_storage_file_closure(root: r, name: name, bound: bound)
    FabricStorageDoorSocket { socket: k, route_prefix: route } =>
      match door_post(socket: k, route_prefix: route, operation: "closure", request: join([name as String, " ", to_string(bound)], "")) {
        ServedFault { fault: f } => FabricClosureRefused { fault: f }
        ServedAnswered { body: b } => fabric_storage_unwire_closure(text: b)
      }
    FabricStorageServed { endpoint: e } =>
      match served_post(endpoint: e, operation: "closure", request: join([name as String, " ", to_string(bound)], "")) {
        ServedFault { fault: f } => FabricClosureRefused { fault: f }
        ServedAnswered { body: b } => fabric_storage_unwire_closure(text: b)
      }
  }
}

// ── THE PRESENTED IDENTITY, READ ─────────────────────────────────────────────────────────────
// Not a store operation and not in std.fabric_storage: a reading of the principal THIS caller
// presents at the served door, taken through the same round trip its writes take. The placed host
// answers FabricIdentityUnproxied -- its writes run in process and no proxy stands between it and
// the files, so there is no header to read and none is invented.
fn fabric_storage_presented_identity(binding: FabricStorageBinding) -> FabricIdentityRead {
  match binding {
    FabricStorageBindingUnplaced => FabricIdentityReadRefused { fault: FabricStoreUnreachable { detail: fabric_storage_unplaced_detail } }
    FabricStorageBindingRefused { detail: d } => FabricIdentityReadRefused { fault: FabricStoreUnreachable { detail: d } }
    FabricStorageLocalFiles { root: _ } => FabricIdentityUnproxied
    FabricStorageDoorSocket { socket: k, route_prefix: route } =>
      match door_post(socket: k, route_prefix: route, operation: "identity", request: "") {
        ServedFault { fault: f } => FabricIdentityReadRefused { fault: f }
        ServedAnswered { body: b } => fabric_storage_unwire_identity(text: b)
      }
    FabricStorageServed { endpoint: e } =>
      match served_post(endpoint: e, operation: "identity", request: "") {
        ServedFault { fault: f } => FabricIdentityReadRefused { fault: f }
        ServedAnswered { body: b } => fabric_storage_unwire_identity(text: b)
      }
  }
}

// All state clients reach the one authenticated service, including the placed host's controller.
// A file binding is reserved for injected local fixtures, never production state placement.


fn served_post(endpoint: NonEmptyStr, operation: String, request: String) -> ServedReply {
  if (endpoint as String).ends_with(suffix: fabric_storage_state_suffix) {
    match fabric_state_signed_request(operation: operation, request: request) {
      Absent => ServedFault { fault: FabricStoreUnreachable { detail: "fabric state credential or clock unavailable" } }
      Present { value: envelope } => served_post_raw(endpoint: endpoint, operation: "authenticated", request: envelope)
    }
  } else { served_post_raw(endpoint: endpoint, operation: operation, request: request) }
}
