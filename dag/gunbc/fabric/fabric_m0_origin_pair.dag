module gunbc.fabric_m0_origin_pair

import std.types { Bool, List, NonEmptyStr, String }
import std.content_hash { Sha256Digest, content_hash_eq_cryptographic }
import product.placement_supply { HostIdentity }
import gunbc.fabric_m0_origin_readback { origin_reading_digest, origin_reading_path }
import gunbc.fabric_m0_completion { OriginReadback, ReadbackConfirmed, ReadbackAbsent, ReadbackUnknown }

// WHEN AN OBJECT IN A TWO-HOST FILESYSTEM ORIGIN IS DURABLE, AND WHAT TO DO WHEN IT IS NOT.
//
// The M0 blob origin is one logical origin with two physical copies: the primary host is the sole
// writer, the replica host holds a synchronous copy. An object is durable only when BOTH copies were
// independently read back and each reading's digest is the expected SHA-256. This module is that
// judgement and nothing else: it performs no put, fetch or replication, and the admitted placements are
// the host intent's (gunbc.fabric_m0_origin_host), passed in rather than decided here.
//
// TWO READINGS ARE NOT TWO COPIES. Each readback carries the placement it was taken at - host and role
// together - and the judgement admits a pair only when those are exactly the admitted primary and the
// admitted replica. Two readings from one host, swapped roles, or a reading from a host outside the pair
// refuse, because a durability rule meant to survive the loss of a host cannot be satisfied by a count.
//
// A NON-DURABLE ANSWER NAMES ITS REMEDY. A reconciler must not have to rediscover what is wrong:
//   ReplicaDeficient        - the primary holds the expected bytes and the named replica placement has
//                             no copy (copy primary to replica) or could not be observed (observe again);
//   PrimaryUnobservable     - the primary could not be read; nothing is known that licenses a copy;
//   PrimaryMissing          - the primary holds no object while the replica is confirmed: a repair of
//                             the primary from the replica, which M0 does not perform automatically and
//                             which is kept apart from "replica missing" because its direction is reversed;
//   NotInstalled            - neither host holds the object; the put itself must run again;
//   Refused                 - bindings that do not describe one object on the admitted pair, or confirmed
//                             bytes that are not the expected digest on either host (corruption, which
//                             no retry repairs into the intended object).
// None of these but Durable may advance a manifest or head.
//
// THIS IS A RECEIPT FOR ONE ATTEMPT, NOT LIVE STANDING. The answer describes the readbacks it was given;
// a later health or repair decision takes fresh per-host observations.
//
// RUNG, STATED. HostBoundOriginReadback is sealed: its production mint is
// gunbc.fabric_m0_origin_remote fabric_origin_remote_readback, which derives the SSH target from the
// placement, has the helper stage the object on that host, copies it back and takes the controller's own
// reading - so a production readback cannot carry a placement it was not taken at. The one other
// admitted caller is this module's witness fixture. What is not established is that the route has run
// against a host; that needs the helper installed, which is not authorized.

type OriginPairRole
  = OriginPrimary
  | OriginReplica

fn origin_pair_role_name(role: OriginPairRole) -> String {
  match role {
    OriginPrimary => "primary"
    OriginReplica => "replica"
  }
}

fn origin_pair_role_eq(a: OriginPairRole, b: OriginPairRole) -> Bool {
  origin_pair_role_name(role: a) == origin_pair_role_name(role: b)
}

type FabricOriginPlacement {
  host: HostIdentity
  role: OriginPairRole
}

fn fabric_origin_placement_eq(a: FabricOriginPlacement, b: FabricOriginPlacement) -> Bool {
  (a.host as String) == (b.host as String) && origin_pair_role_eq(a: a.role, b: b.role)
}

fn placement_label(p: FabricOriginPlacement) -> String {
  join([origin_pair_role_name(role: p.role), " ", p.host as String], "")
}

type HostBoundOriginReadback sole_constructor {
  placement: FabricOriginPlacement
  key: NonEmptyStr
  readback: OriginReadback
}

fn host_bound_origin_readback_seal(placement: FabricOriginPlacement, key: NonEmptyStr, readback: OriginReadback) -> HostBoundOriginReadback
  admit_callers: [
    decl_ref(module_path: "gunbc.fabric_m0_origin_remote", decl_name: "fabric_origin_remote_readback"),
    decl_ref(module_path: "test.claim.fabric_m0_origin_pair_witness_test", decl_name: "at_key"),
  ]
  = HostBoundOriginReadback { placement: placement, key: key, readback: readback }

type OriginReplicaDeficiency
  = OriginReplicaHasNoCopy
  | OriginReplicaUnobservable { cause: NonEmptyStr }

type OriginPairDurability
  = OriginPairDurable
  | OriginPairReplicaDeficient { replica: FabricOriginPlacement, deficiency: OriginReplicaDeficiency }
  | OriginPairPrimaryUnobservable { primary: FabricOriginPlacement, cause: NonEmptyStr }
  | OriginPairPrimaryMissing { primary: FabricOriginPlacement, replica: FabricOriginPlacement }
  | OriginPairNotInstalled { primary: FabricOriginPlacement }
  | OriginPairRefused { cause: NonEmptyStr }

// WHAT ONE HOST'S READBACK SAYS ABOUT THE EXPECTED OBJECT.
type OriginCopyStanding
  = OriginCopyMatches
  | OriginCopyDiffers { observed_at: String }
  | OriginCopyMissing
  | OriginCopyUnobserved { cause: NonEmptyStr }

fn origin_copy_standing(readback: OriginReadback, expected: Sha256Digest) -> OriginCopyStanding {
  match readback {
    ReadbackConfirmed { reading } =>
      if content_hash_eq_cryptographic(left: expected, right: origin_reading_digest(reading: reading)) {
        OriginCopyMatches
      } else {
        OriginCopyDiffers { observed_at: origin_reading_path(reading: reading) as String }
      }
    ReadbackAbsent => OriginCopyMissing
    ReadbackUnknown { cause } => OriginCopyUnobserved { cause: cause }
  }
}

fn binding_refusal(admitted_primary: FabricOriginPlacement, admitted_replica: FabricOriginPlacement, primary: HostBoundOriginReadback, replica: HostBoundOriginReadback) -> String {
  if (admitted_primary.host as String) == (admitted_replica.host as String) {
    join(["the admitted primary and replica are both ", admitted_primary.host as String, "; one host holds one copy"], "")
  } else if !origin_pair_role_eq(a: admitted_primary.role, b: OriginPrimary) || !origin_pair_role_eq(a: admitted_replica.role, b: OriginReplica) {
    join(["the admitted placements are ", placement_label(p: admitted_primary), " and ", placement_label(p: admitted_replica), ", not one primary and one replica"], "")
  } else if !fabric_origin_placement_eq(a: primary.placement, b: admitted_primary) {
    join(["the primary readback was taken at ", placement_label(p: primary.placement), ", which is not the admitted ", placement_label(p: admitted_primary)], "")
  } else if !fabric_origin_placement_eq(a: replica.placement, b: admitted_replica) {
    join(["the replica readback was taken at ", placement_label(p: replica.placement), ", which is not the admitted ", placement_label(p: admitted_replica)], "")
  } else if (primary.key as String) != (replica.key as String) {
    join(["the primary readback is of ", primary.key as String, " and the replica readback is of ", replica.key as String, "; they describe different objects"], "")
  } else {
    ""
  }
}

fn origin_pair_durability(
  admitted_primary: FabricOriginPlacement,
  admitted_replica: FabricOriginPlacement,
  primary: HostBoundOriginReadback,
  replica: HostBoundOriginReadback,
  expected: Sha256Digest,
) -> OriginPairDurability {
  let refusal = binding_refusal(admitted_primary: admitted_primary, admitted_replica: admitted_replica, primary: primary, replica: replica)
  if refusal != "" {
    OriginPairRefused { cause: refusal as NonEmptyStr }
  } else {
    let p = origin_copy_standing(readback: primary.readback, expected: expected)
    let r = origin_copy_standing(readback: replica.readback, expected: expected)
    match p {
      OriginCopyDiffers { observed_at } => OriginPairRefused { cause: join(["the ", placement_label(p: primary.placement), " holds different bytes at ", primary.key as String, " (read at ", observed_at, ")"], "") as NonEmptyStr }
      OriginCopyUnobserved { cause } =>
        match r {
          OriginCopyDiffers { observed_at } => OriginPairRefused { cause: join(["the ", placement_label(p: replica.placement), " holds different bytes at ", replica.key as String, " (read at ", observed_at, ")"], "") as NonEmptyStr }
          other => OriginPairPrimaryUnobservable { primary: primary.placement, cause: cause }
        }
      OriginCopyMissing =>
        match r {
          OriginCopyMatches => OriginPairPrimaryMissing { primary: primary.placement, replica: replica.placement }
          OriginCopyDiffers { observed_at } => OriginPairRefused { cause: join(["the ", placement_label(p: replica.placement), " holds different bytes at ", replica.key as String, " (read at ", observed_at, ")"], "") as NonEmptyStr }
          OriginCopyMissing => OriginPairNotInstalled { primary: primary.placement }
          OriginCopyUnobserved { cause: _ } => OriginPairNotInstalled { primary: primary.placement }
        }
      OriginCopyMatches =>
        match r {
          OriginCopyMatches => OriginPairDurable
          OriginCopyDiffers { observed_at } => OriginPairRefused { cause: join(["the ", placement_label(p: replica.placement), " holds different bytes at ", replica.key as String, " (read at ", observed_at, ")"], "") as NonEmptyStr }
          OriginCopyMissing => OriginPairReplicaDeficient { replica: replica.placement, deficiency: OriginReplicaHasNoCopy }
          OriginCopyUnobserved { cause } => OriginPairReplicaDeficient { replica: replica.placement, deficiency: OriginReplicaUnobservable { cause: cause } }
        }
    }
  }
}

fn origin_pair_is_durable(d: OriginPairDurability) -> Bool {
  match d {
    OriginPairDurable => true
    OriginPairReplicaDeficient { replica: _, deficiency: _ } => false
    OriginPairPrimaryUnobservable { primary: _, cause: _ } => false
    OriginPairPrimaryMissing { primary: _, replica: _ } => false
    OriginPairNotInstalled { primary: _ } => false
    OriginPairRefused { cause: _ } => false
  }
}
