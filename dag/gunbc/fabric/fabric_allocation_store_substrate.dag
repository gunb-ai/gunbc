module gunbc.fabric_allocation_store_substrate

import std.types { String, Bool, NonEmptyStr }
import gunbc.fabric_control_plane { fabric_control_plane_store_root }
import gunbc.fabric_cell_effect { FabricCellSubstrateOwner, CellSubstrateRootOwned }
import extdeps.posix.identity { PosixOwnerSpec, PosixUserId, PosixGroupId }
import extdeps.posix.path_ownership { posix_owner_spec_equal }
import extdeps.filesystem.filesystem_io { FilesystemEstablishedAbsence }

// The store root is durable control-plane substrate, not an incidental directory created by a
// reservation. The CAS realization explicitly refuses a missing root and never removes one.
//
// OWNER DERIVATION, bounded to the writer population that exists today. The only live non-test
// reservation caller is tools.fabric_control_plane_live_probe, whose instrument requires EUID 0;
// no persistent executor exists yet. Root ownership therefore describes the present production
// writer rather than guessing the future executor principal. Re-derive this standing when a
// non-root production reservation caller is modeled (expected at FCI-3). EnsureOwnedDirectory is
// re-convergent, so that event changes this desired state rather than requiring a teardown.
type AllocationStoreWriterStanding
  = AllocationStoreRootWriterOnly {
      live_caller: NonEmptyStr
      rederive_trigger: NonEmptyStr
    }

type AllocationStoreSubstrateSpec {
  path: NonEmptyStr
  presence_ancestor: NonEmptyStr
  presence_parent_entry: NonEmptyStr
  presence_target_entry: NonEmptyStr
  owner: FabricCellSubstrateOwner
  mode: NonEmptyStr
  writer_standing: AllocationStoreWriterStanding
}

fn fabric_allocation_store_substrate_spec() -> AllocationStoreSubstrateSpec {
  AllocationStoreSubstrateSpec {
    path: fabric_control_plane_store_root(),
    presence_ancestor: "/var/lib/gunbc" as NonEmptyStr,
    presence_parent_entry: "fabric" as NonEmptyStr,
    presence_target_entry: "allocation" as NonEmptyStr,
    owner: CellSubstrateRootOwned,
    mode: "0700" as NonEmptyStr,
    writer_standing: AllocationStoreRootWriterOnly {
      live_caller: "tools.fabric_control_plane_live_probe under EUID 0" as NonEmptyStr,
      rederive_trigger: "a non-root production reservation caller is modeled" as NonEmptyStr,
    },
  }
}

fn allocation_store_presence_parent(spec: AllocationStoreSubstrateSpec) -> NonEmptyStr {
  join([spec.presence_ancestor as String, "/", spec.presence_parent_entry as String], "") as NonEmptyStr
}

fn allocation_store_presence_coordinates_match_path(spec: AllocationStoreSubstrateSpec) -> Bool {
  join([allocation_store_presence_parent(spec: spec) as String, "/", spec.presence_target_entry as String], "")
    == spec.path as String
}

type AllocationStoreDirectoryPrestate
  = AllocationStoreDirectoryAbsent { path: NonEmptyStr, evidence: FilesystemEstablishedAbsence }
  | AllocationStoreDirectoryPresentExpected { path: NonEmptyStr, owner: PosixOwnerSpec, mode: NonEmptyStr }
  | AllocationStoreDirectoryPresentUnexpected {
      path: NonEmptyStr
      observed_owner: PosixOwnerSpec
      observed_mode: NonEmptyStr
      desired_owner: PosixOwnerSpec
      desired_mode: NonEmptyStr
    }

type AllocationStoreDirectoryObservation
  = AllocationStoreDirectoryObserved { prestate: AllocationStoreDirectoryPrestate }
  | AllocationStoreDirectoryObservationRefused { path: NonEmptyStr, cause: String }

fn allocation_store_desired_owner() -> PosixOwnerSpec {
  PosixOwnerSpec { user: PosixUserId { value: 0 }, group: PosixGroupId { value: 0 } }
}

// GNU stat %a omits the leading special-bits zero carried by the install/chmod serialization.
// The observed spelling is projected from the spec rather than copied as a second literal.
fn allocation_store_desired_stat_mode(spec: AllocationStoreSubstrateSpec) -> NonEmptyStr {
  substring(s: spec.mode as String, start: 1, end: string_length(s: spec.mode as String)) as NonEmptyStr
}

fn allocation_store_directory_present(
  path: NonEmptyStr,
  owner: PosixOwnerSpec,
  mode: NonEmptyStr,
) -> AllocationStoreDirectoryPrestate {
  let spec = fabric_allocation_store_substrate_spec()
  let desired_owner = allocation_store_desired_owner()
  let desired_mode = allocation_store_desired_stat_mode(spec: spec)
  if posix_owner_spec_equal(left: owner, right: desired_owner) && mode == desired_mode {
    AllocationStoreDirectoryPresentExpected { path: path, owner: owner, mode: mode }
  } else {
    AllocationStoreDirectoryPresentUnexpected {
      path: path,
      observed_owner: owner,
      observed_mode: mode,
      desired_owner: desired_owner,
      desired_mode: desired_mode,
    }
  }
}

fn allocation_store_directory_absent(
  path: NonEmptyStr,
  evidence: FilesystemEstablishedAbsence,
) -> AllocationStoreDirectoryPrestate {
  AllocationStoreDirectoryAbsent { path: path, evidence: evidence }
}

fn allocation_store_directory_prestate_wire(prestate: AllocationStoreDirectoryPrestate) -> String {
  match prestate {
    AllocationStoreDirectoryAbsent { path: p, evidence: e } =>
      join(["allocation-store:absent:path=", p as String, ":listed-parent=", e.directory, ":missing-entry=", e.name], "")
    AllocationStoreDirectoryPresentExpected { path: p, owner: o, mode: m } =>
      join(["allocation-store:present-expected:path=", p as String, ":uid=", to_string(o.user.value), ":gid=", to_string(o.group.value), ":mode=", m as String], "")
    AllocationStoreDirectoryPresentUnexpected { path: p, observed_owner: o, observed_mode: m, desired_owner: d, desired_mode: dm } =>
      join(["allocation-store:present-unexpected:path=", p as String, ":uid=", to_string(o.user.value), ":gid=", to_string(o.group.value), ":mode=", m as String, ":desired-uid=", to_string(d.user.value), ":desired-gid=", to_string(d.group.value), ":desired-mode=", dm as String], "")
  }
}

fn allocation_store_directory_prestate_path(prestate: AllocationStoreDirectoryPrestate) -> NonEmptyStr {
  match prestate {
    AllocationStoreDirectoryAbsent { path: p, evidence: _ } => p
    AllocationStoreDirectoryPresentExpected { path: p, owner: _, mode: _ } => p
    AllocationStoreDirectoryPresentUnexpected { path: p, observed_owner: _, observed_mode: _, desired_owner: _, desired_mode: _ } => p
  }
}

type AllocationStoreEffect
  = AllocationStoreDirectoryEnsure { spec: AllocationStoreSubstrateSpec }

fn fabric_allocation_store_ensure_effect() -> AllocationStoreEffect {
  AllocationStoreDirectoryEnsure { spec: fabric_allocation_store_substrate_spec() }
}
