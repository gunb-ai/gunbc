// THE OPERATOR'S REAL WORKSPACE, CARRIED FROM THE HOST THAT HOLDS IT TO THE HOST THAT MEASURES IT.
//
// The recoverable-workspace stage-0 measurement (gunbc.fabric.workspace_checkpoint_instrument) runs
// on srv3, but the workspace it is about lives on srv1: a gunbc clone and one session's .claude
// directory. No session holds a key that reaches both, and none is minted for this: the route is two
// dispatched jobs through the workspace bucket. This module is the first job. On srv1 it enumerates
// the source roots as the runner's own principal, drops every path the credential exclusion names
// and every build output, stands a same-size, same-path synthetic placeholder in for every
// transcript file, packs the real members and the placeholders into one tar, reads the tar's
// membership and sizes back and refuses if any credential is carried or any transcript member is not
// its placeholder at its planned size, and puts the tar into the workspace bucket
// under the SHA-256 of its bytes. The srv3 job is dispatched with that address and fetches it.
//
// A ROOT THE RUNNER CANNOT READ REFUSES, NAMING WHAT IS MISSING. The enumeration runs as the job
// user; a permission it lacks is not widened here, and a partial enumeration is not a smaller
// workspace: the refusal carries find's own denials, the runner principal, and the root's owner
// and mode, which is what the operator needs to decide the grant.

// ── THE SOURCE ─────────────────────────────────────────────────────────────────────────────────

// A ROOT IS A DIRECTORY ON THE PACKING HOST, AND WHAT IS NOT WORKSPACE BENEATH IT. Build output is
// named by its root-relative prefix: it is regenerated, not recovered, so it is never carried.
type WorkspaceSourceRoot {
  label: NonEmptyStr
  path: NonEmptyStr
  build_output: List<NonEmptyStr>
}

// THE SRV1 HOST PATHS, pinned rather than guessed (warm-badger-442, 2026-10-05, read from a session's
// mountinfo on node srv1). The clone and the Codex home are fixed; the Codex auth file is excluded as
// a credential and its sessions and history as transcripts.
data workspace_source_fixed_roots: List<WorkspaceSourceRoot> = [
  WorkspaceSourceRoot { label: "gunbc-clone", path: "/home/briansrls/gunbc", build_output: ["target/"] },
  WorkspaceSourceRoot { label: "codex-state", path: "/home/briansrls/.codex", build_output: [] },
]

// ── THE AGENT-STATE ROOT: A DECLARED INPUT, ADMITTED AGAINST WHAT EXISTS (warm-badger-442) ───────
//
// Claude agent state lives per auth slot, /home/briansrls/.claude@<slot> (mounted at
// /session-home/.claude inside session containers), and the operator's credential swaps move WHICH
// slot is active -- so the slot is not a constant of this module. It is the dispatch input
// agent_state_slot (environment WORKSPACE_AGENT_STATE_SLOT), and it is admitted only when it names
// one of the .claude@* directories observed in the home at pack time: a closed choice over what
// exists. There is no default and no fallback to "the active one": an absent or unknown slot refuses,
// naming the observed slots, and the admitted slot and its path are printed in the receipt.
data workspace_agent_state_slot_env: NonEmptyStr = "WORKSPACE_AGENT_STATE_SLOT"

data workspace_agent_state_home: NonEmptyStr = "/home/briansrls"

data workspace_agent_state_prefix: NonEmptyStr = ".claude@"

type WorkspaceAgentStateSlot
  = AgentStateSlotAdmitted { slot: NonEmptyStr, root: WorkspaceSourceRoot }
  | AgentStateSlotAbsent { observed: List<String> }
  | AgentStateSlotUnknown { requested: String, observed: List<String> }

// THE SLOTS A HOME LISTING HOLDS: each directory whose last segment is .claude@<slot>, <slot> nonempty.
fn workspace_observed_agent_state_slots(dirs: List<String>) -> List<String> {
  flat_map(dirs, d => {
    let last = match reverse(split(d, separator: "/")) { Cons { head: h, tail: _ } => h  Empty => "" }
    let prefix = workspace_agent_state_prefix as String
    if starts_with(s: last, prefix: prefix) && length(last) > length(prefix) { [substring(s: last, start: length(prefix), end: length(last))] } else { [] }
  })
}

fn workspace_agent_state_slot_admission(requested: String?, observed: List<String>) -> WorkspaceAgentStateSlot {
  match requested {
    Absent => AgentStateSlotAbsent { observed: observed }
    Present { value: r } =>
      if r == "" {
        AgentStateSlotAbsent { observed: observed }
      } else if any(observed, o => o == r) {
        AgentStateSlotAdmitted {
          slot: r as NonEmptyStr,
          root: WorkspaceSourceRoot { label: concat("claude-agent-state-", r) as NonEmptyStr, path: join([workspace_agent_state_home as String, "/", workspace_agent_state_prefix as String, r], "") as NonEmptyStr, build_output: [] },
        }
      } else {
        AgentStateSlotUnknown { requested: r, observed: observed }
      }
  }
}

fn workspace_agent_state_slot_words(admission: WorkspaceAgentStateSlot) -> String {
  match admission {
    AgentStateSlotAdmitted { slot: s, root: r } => join(["agent_state_slot=", s as String, " path=", r.path as String], "")
    AgentStateSlotAbsent { observed: o } => join(["agent_state_slot=refused-absent observed=", join(o, ","), " (", workspace_agent_state_slot_env as String, " names no slot; there is no default)"], "")
    AgentStateSlotUnknown { requested: r, observed: o } => join(["agent_state_slot=refused-unknown requested=", r, " observed=", join(o, ","), " (no ", workspace_agent_state_home as String, "/", workspace_agent_state_prefix as String, r, " exists)"], "")
  }
}

fn workspace_agent_state_slot_observe() -> WorkspaceAgentStateSlot {
  let requested = match shell.Env.Get(name: workspace_agent_state_slot_env).value {
    Absent => none
    Present { value: v } => Present { value: replace(v, "\n", "") }
  }
  let dirs = shell.Find.ListDirs(path: workspace_agent_state_home as FilePath)
  workspace_agent_state_slot_admission(requested: requested, observed: workspace_observed_agent_state_slots(dirs: map(dirs.dirs, d => d as String)))
}

data workspace_source_pack_host: NonEmptyStr = "srv1"

// ── THE CREDENTIAL EXCLUSION: ONE ROW, LISTED VERBATIM IN EVERY RECEIPT ────────────────────────
//
// Each rule tests ONE PATH SEGMENT, and a path is excluded when any of its segments matches -- so a
// rule naming a directory (.ssh, .aws) excludes everything beneath it, and a rule naming a file
// excludes that file wherever it sits. The pair rule names a directory by its parent, as .config/gh
// does. Matching is case-sensitive.
//
// EXACT NAMES, NOT SUBSTRINGS. An earlier row excluded every segment CONTAINING "token" or
// "credentials", which dropped 48 and 3 tracked source files of the gunbc clone (every module whose
// name mentions a token, such as dag/gunbc/auth/access_token_source.dag), so a stage-0 measurement
// would have described a smaller workspace than the operator's and the stage-1 byte-equality would
// have covered less of it. Each rule below names a credential file or directory that a tool writes
// under that exact name (the Claude login, Codex's auth file, netrc and git/npm/pypi credential
// files, SSH and GnuPG homes, cloud CLI configs, key and certificate files by suffix, dotenv files),
// and no tracked file of the clone bears any of them (checked at this change).
//
// EVERY CREDENTIAL EXCLUSION IS NAMED IN THE RECEIPT (its path, never its bytes), so a tracked source
// file that a later change gives one of these names is visible as excluded rather than silently
// dropped; the claim that no tracked file bears them is checked by reading the receipt, not assumed.
//
// WHAT A NAME RULE CANNOT DO, stated rather than implied: a secret stored under some other name, or
// pasted into an agent transcript's CONTENT, is not caught by any path rule. The pack's guarantee is
// that every file the receipt lists as excluded was excluded, never that the carried bytes hold no
// secret.
// A SEGMENT RULE tests one path segment (and, for a pair, its parent); a PATH RULE is either a
// segment rule applied to every segment, or a rule over the whole path. Two types, so the
// per-segment matcher cannot be handed a path-level rule and has no arm to answer it with.
type WorkspaceSegmentRule
  = SegmentEquals { text: NonEmptyStr }
  | SegmentPrefix { text: NonEmptyStr }
  | SegmentSuffix { text: NonEmptyStr }
  | SegmentPair { parent: NonEmptyStr, child: NonEmptyStr }

type WorkspaceExclusionRule
  = AnySegment { rule: WorkspaceSegmentRule }
  | SuffixUnder { ancestor: NonEmptyStr, suffix: NonEmptyStr }

// WHY A PATH IS NOT CARRIED, as a class the receipt counts separately: a credential (never carried,
// a secret) or transcript content (not carried by operator decision, 2026-10-05: the pack carries
// agent configuration and state, never conversation content).
type WorkspaceExclusionClass
  = CredentialExclusion
  | TranscriptExclusion

type WorkspaceExclusion {
  spelling: NonEmptyStr
  class: WorkspaceExclusionClass
  rule: WorkspaceExclusionRule
}

data workspace_credential_exclusions: List<WorkspaceExclusion> = [
  WorkspaceExclusion { class: CredentialExclusion, spelling: "~/.claude/.credentials.json", rule: AnySegment { rule: SegmentEquals { text: ".credentials.json" } } },
  WorkspaceExclusion { class: CredentialExclusion, spelling: "~/.codex/auth.json", rule: AnySegment { rule: SegmentEquals { text: "auth.json" } } },
  WorkspaceExclusion { class: CredentialExclusion, spelling: ".netrc", rule: AnySegment { rule: SegmentEquals { text: ".netrc" } } },
  WorkspaceExclusion { class: CredentialExclusion, spelling: ".git-credentials", rule: AnySegment { rule: SegmentEquals { text: ".git-credentials" } } },
  WorkspaceExclusion { class: CredentialExclusion, spelling: ".npmrc", rule: AnySegment { rule: SegmentEquals { text: ".npmrc" } } },
  WorkspaceExclusion { class: CredentialExclusion, spelling: ".pypirc", rule: AnySegment { rule: SegmentEquals { text: ".pypirc" } } },
  WorkspaceExclusion { class: CredentialExclusion, spelling: "*.pem", rule: AnySegment { rule: SegmentSuffix { text: ".pem" } } },
  WorkspaceExclusion { class: CredentialExclusion, spelling: "*.key", rule: AnySegment { rule: SegmentSuffix { text: ".key" } } },
  WorkspaceExclusion { class: CredentialExclusion, spelling: "id_rsa", rule: AnySegment { rule: SegmentEquals { text: "id_rsa" } } },
  WorkspaceExclusion { class: CredentialExclusion, spelling: "id_ecdsa", rule: AnySegment { rule: SegmentEquals { text: "id_ecdsa" } } },
  WorkspaceExclusion { class: CredentialExclusion, spelling: "id_ed25519", rule: AnySegment { rule: SegmentEquals { text: "id_ed25519" } } },
  WorkspaceExclusion { class: CredentialExclusion, spelling: "id_dsa", rule: AnySegment { rule: SegmentEquals { text: "id_dsa" } } },
  WorkspaceExclusion { class: CredentialExclusion, spelling: "id_ecdsa_sk", rule: AnySegment { rule: SegmentEquals { text: "id_ecdsa_sk" } } },
  WorkspaceExclusion { class: CredentialExclusion, spelling: "id_ed25519_sk", rule: AnySegment { rule: SegmentEquals { text: "id_ed25519_sk" } } },
  WorkspaceExclusion { class: CredentialExclusion, spelling: ".ssh", rule: AnySegment { rule: SegmentEquals { text: ".ssh" } } },
  WorkspaceExclusion { class: CredentialExclusion, spelling: ".gnupg", rule: AnySegment { rule: SegmentEquals { text: ".gnupg" } } },
  WorkspaceExclusion { class: CredentialExclusion, spelling: ".aws", rule: AnySegment { rule: SegmentEquals { text: ".aws" } } },
  WorkspaceExclusion { class: CredentialExclusion, spelling: ".config/gh", rule: AnySegment { rule: SegmentPair { parent: ".config", child: "gh" } } },
  WorkspaceExclusion { class: CredentialExclusion, spelling: ".config/gcloud", rule: AnySegment { rule: SegmentPair { parent: ".config", child: "gcloud" } } },
  WorkspaceExclusion { class: CredentialExclusion, spelling: ".docker/config.json", rule: AnySegment { rule: SegmentPair { parent: ".docker", child: "config.json" } } },
  WorkspaceExclusion { class: CredentialExclusion, spelling: ".env", rule: AnySegment { rule: SegmentEquals { text: ".env" } } },
  WorkspaceExclusion { class: CredentialExclusion, spelling: ".env.*", rule: AnySegment { rule: SegmentPrefix { text: ".env." } } },
]

// ── TRANSCRIPT CONTENT: NOT CARRIED, BY OPERATOR DECISION (2026-10-05) ───────────────────────────
//
// The pack carries agent configuration and state (settings, CLAUDE.md and agent definitions, memory,
// plugin configuration) and never conversation content. Claude Code writes each session's transcript
// as a .jsonl file under projects/ (subagent transcripts too) and its prompt history as
// history.jsonl; Codex writes its session rollouts under sessions/ and its history as
// history.jsonl. Memory files under projects/<project>/memory/ are .md, not .jsonl, so they are
// carried. Like the credential row, this is a NAME rule: content under another name is carried, and
// the receipt counts what each row excluded, in files and bytes.
data workspace_transcript_exclusions: List<WorkspaceExclusion> = [
  WorkspaceExclusion { class: TranscriptExclusion, spelling: "projects/**/*.jsonl", rule: SuffixUnder { ancestor: "projects", suffix: ".jsonl" } },
  WorkspaceExclusion { class: TranscriptExclusion, spelling: "history.jsonl", rule: AnySegment { rule: SegmentEquals { text: "history.jsonl" } } },
  WorkspaceExclusion { class: TranscriptExclusion, spelling: ".codex/sessions", rule: AnySegment { rule: SegmentPair { parent: ".codex", child: "sessions" } } },
]

// EVERY EXCLUSION THE PACK APPLIES, credentials first: a credential that also looks like a transcript
// is counted as the credential it is.
fn workspace_exclusions() -> List<WorkspaceExclusion> {
  concat(workspace_credential_exclusions, workspace_transcript_exclusions)
}

fn workspace_exclusion_spellings(exclusions: List<WorkspaceExclusion>) -> String {
  join(map(exclusions, x => x.spelling as String), " ")
}

fn workspace_rule_matches_segment(rule: WorkspaceSegmentRule, segment: String, parent: String?) -> Bool {
  match rule {
    SegmentEquals { text: t } => segment == (t as String)
    SegmentPrefix { text: t } => starts_with(s: segment, prefix: t as String)
    SegmentSuffix { text: t } => ends_with(s: segment, suffix: t as String)
    SegmentPair { parent: p, child: c } =>
      match parent {
        Absent => false
        Present { value: up } => up == (p as String) && segment == (c as String)
      }
  }
}

// A SUFFIX-UNDER RULE TESTS THE LAST SEGMENT AGAINST ITS SUFFIX AND ANY EARLIER SEGMENT AGAINST ITS
// ANCESTOR, so projects/<project>/<session>.jsonl and projects/<project>/<session>/subagents/x.jsonl
// both match while a .jsonl outside projects/ does not.
fn workspace_suffix_under_matches(ancestor: String, suffix: String, segments: List<String>, seen_ancestor: Bool) -> Bool {
  match segments {
    Empty => false
    Cons { head: s, tail: Empty } => seen_ancestor && ends_with(s: s, suffix: suffix)
    Cons { head: s, tail: rest } => workspace_suffix_under_matches(ancestor: ancestor, suffix: suffix, segments: rest, seen_ancestor: seen_ancestor || s == ancestor)
  }
}

fn workspace_segments_match(rule: WorkspaceSegmentRule, segments: List<String>, parent: String?) -> Bool {
  match segments {
    Empty => false
    Cons { head: s, tail: rest } =>
      workspace_rule_matches_segment(rule: rule, segment: s, parent: parent) || workspace_segments_match(rule: rule, segments: rest, parent: Present { value: s })
  }
}

// THE FIRST EXCLUSION A PATH MATCHES, OR NONE. The path is split on "/"; empty segments (a leading
// slash, a doubled one) are not names and match nothing.
fn workspace_path_exclusion(exclusions: List<WorkspaceExclusion>, path: String) -> WorkspaceExclusion? {
  let segments = filter(split(path, separator: "/"), s => s != "")
  match exclusions {
    Empty => none
    Cons { head: x, tail: rest } =>
      if workspace_rule_matches_path(rule: x.rule, segments: segments) { Present { value: x } } else { workspace_path_exclusion(exclusions: rest, path: path) }
  }
}

fn workspace_rule_matches_path(rule: WorkspaceExclusionRule, segments: List<String>) -> Bool {
  match rule {
    SuffixUnder { ancestor: a, suffix: x } => workspace_suffix_under_matches(ancestor: a as String, suffix: x as String, segments: segments, seen_ancestor: false)
    AnySegment { rule: r } => workspace_segments_match(rule: r, segments: segments, parent: none)
  }
}

fn workspace_path_is_build_output(root: WorkspaceSourceRoot, relative: String) -> Bool {
  any(root.build_output, prefix => starts_with(s: relative, prefix: prefix as String))
}

// ── THE PLAN: WHAT THE ENUMERATION ADMITS INTO THE PACK ────────────────────────────────────────
//
// One enumeration line is find's `%y\t%m\t%P\t%l\t%s` (shell.Find FilesAndSymlinksWithMode): the type
// letter, the mode, the root-relative path, the link target, the size in bytes. A member is the root's path without its
// leading slash joined to the relative path, so one tar created from "/" holds every root under its
// own absolute location and two roots never collide.
type WorkspaceSourceMemberKind = SourceFile | SourceSymlink

type WorkspaceSourceLine
  = WorkspaceSourceMember { member: NonEmptyStr, kind: WorkspaceSourceMemberKind }
  | WorkspaceSourceExcluded { member: NonEmptyStr, kind: WorkspaceSourceMemberKind, by: WorkspaceExclusion, bytes: ByteSize }
  | WorkspaceSourceBuildOutput { member: NonEmptyStr }
  | WorkspaceSourceUnparsed { line: String }

fn workspace_root_member(root: WorkspaceSourceRoot, relative: String) -> String {
  let base = root.path as String
  let trimmed = if starts_with(s: base, prefix: "/") { substring(s: base, start: 1, end: length(base)) } else { base }
  join([trimmed, "/", relative], "")
}

fn workspace_source_line(root: WorkspaceSourceRoot, exclusions: List<WorkspaceExclusion>, line: String) -> WorkspaceSourceLine {
  match split(line, separator: "\t") {
    Cons { head: kind, tail: Cons { head: _, tail: Cons { head: relative, tail: Cons { head: _, tail: Cons { head: size_text, tail: Empty } } } } } =>
      match parse_int(s: size_text) {
        Absent => WorkspaceSourceUnparsed { line: line }
        Present { value: n } =>
          if relative == "" || n < 0 {
            WorkspaceSourceUnparsed { line: line }
          } else {
            workspace_source_line_sized(root: root, exclusions: exclusions, kind: kind, relative: relative, size: byte_size(count: n), line: line)
          }
      }
    Empty => WorkspaceSourceUnparsed { line: line }
    Cons { head: _, tail: _ } => WorkspaceSourceUnparsed { line: line }
  }
}

fn workspace_source_member_kind(kind: String) -> WorkspaceSourceMemberKind? {
  if kind == "f" { Present { value: SourceFile } } else if kind == "l" { Present { value: SourceSymlink } } else { none }
}

fn workspace_source_line_sized(root: WorkspaceSourceRoot, exclusions: List<WorkspaceExclusion>, kind: String, relative: String, size: ByteSize, line: String) -> WorkspaceSourceLine {
  let member = workspace_root_member(root: root, relative: relative) as NonEmptyStr
  match workspace_source_member_kind(kind: kind) {
    Absent => WorkspaceSourceUnparsed { line: line }
    Present { value: k } =>
      match workspace_path_exclusion(exclusions: exclusions, path: member as String) {
        Present { value: x } => WorkspaceSourceExcluded { member: member, kind: k, by: x, bytes: size }
        Absent =>
          if workspace_path_is_build_output(root: root, relative: relative) {
            WorkspaceSourceBuildOutput { member: member }
          } else {
            WorkspaceSourceMember { member: member, kind: k }
          }
      }
  }
}

type WorkspaceSourceTally {
  members: List<NonEmptyStr>
  files: Int
  symlinks: Int
  excluded: Int
  excluded_credentials: Int
  excluded_credential_members: List<NonEmptyStr>
  excluded_credential_bytes: ByteSize
  excluded_transcripts: Int
  excluded_transcript_bytes: ByteSize
  transcript_placeholders: List<WorkspaceTranscriptPlaceholder>
  build_output: Int
  unparsed: List<String>
}

// THE EXCLUDED SIZES OF ONE CLASS, partitioned by matching the class itself.
fn workspace_excluded_sizes(lines: List<WorkspaceSourceLine>, class: WorkspaceExclusionClass) -> List<ByteSize> {
  flat_map(lines, l => match l {
    WorkspaceSourceExcluded { member: _, kind: _, by: x, bytes: b } =>
      match class {
        CredentialExclusion => match x.class { CredentialExclusion => [b]  TranscriptExclusion => [] }
        TranscriptExclusion => match x.class { CredentialExclusion => []  TranscriptExclusion => [b] }
      }
    WorkspaceSourceMember { member: _, kind: _ } => []
    WorkspaceSourceBuildOutput { member: _ } => []
    WorkspaceSourceUnparsed { line: _ } => []
  })
}

// ── TRANSCRIPT PLACEHOLDERS: THE SIZE AND PATH CARRIED, THE CONTENT NOT (operator, 2026-10-05) ───
//
// Transcripts are the workspace's largest and highest-churn population, so dropping them would make
// stage 0 describe a cheaper workspace than the operator's. Each excluded transcript FILE is carried
// as a placeholder at the SAME member path with the SAME byte size, its bytes the seeded keystream
// of extdeps.crypto.seeded_filler keyed by the member path: incompressible, so neither kopia nor the
// chunk store's dedup sees less than the real content would cost, and reproducible, so two packs of
// one unchanged tree carry identical placeholders. A placeholder is minted ONLY from a line the
// TranscriptExclusion class excluded, and the match below has no arm that mints one from a
// credential, so a credential's path and size never appear in the archive. A transcript SYMLINK
// carries no content to stand in for and is excluded as before. What a placeholder cannot carry is
// stated, not implied: the content's compressibility and its churn; the receipt says so.
type WorkspaceTranscriptPlaceholder {
  member: NonEmptyStr
  size: ByteSize
}

fn workspace_transcript_placeholders(lines: List<WorkspaceSourceLine>) -> List<WorkspaceTranscriptPlaceholder> {
  flat_map(lines, l => match l {
    WorkspaceSourceExcluded { member: m, kind: k, by: x, bytes: b } =>
      match x.class {
        CredentialExclusion => []
        TranscriptExclusion => match k { SourceFile => [WorkspaceTranscriptPlaceholder { member: m, size: b }]  SourceSymlink => [] }
      }
    WorkspaceSourceMember { member: _, kind: _ } => []
    WorkspaceSourceBuildOutput { member: _ } => []
    WorkspaceSourceUnparsed { line: _ } => []
  })
}

data workspace_transcript_caveat: NonEmptyStr = "transcript content synthetic, sizes preserved, static tree; NOT a 10 s / 60 s verdict"

fn workspace_bytes_total(sizes: List<ByteSize>) -> ByteSize {
  byte_size(count: fold(sizes, init: 0, f: (acc, b) => acc + measure_count(m: b)))
}

fn workspace_source_tally(root: WorkspaceSourceRoot, exclusions: List<WorkspaceExclusion>, listing: String) -> WorkspaceSourceTally {
  let lines = map(filter(split(listing, separator: "\n"), l => l != ""), l => workspace_source_line(root: root, exclusions: exclusions, line: l))
  WorkspaceSourceTally {
    members: flat_map(lines, l => match l {
      WorkspaceSourceMember { member: m, kind: _ } => [m]
      WorkspaceSourceExcluded { member: _, kind: _, by: _, bytes: _ } => []
      WorkspaceSourceBuildOutput { member: _ } => []
      WorkspaceSourceUnparsed { line: _ } => []
    }),
    files: length(filter(lines, l => match l { WorkspaceSourceMember { member: _, kind: SourceFile } => true  WorkspaceSourceMember { member: _, kind: SourceSymlink } => false  WorkspaceSourceExcluded { member: _, kind: _, by: _, bytes: _ } => false  WorkspaceSourceBuildOutput { member: _ } => false  WorkspaceSourceUnparsed { line: _ } => false })),
    symlinks: length(filter(lines, l => match l { WorkspaceSourceMember { member: _, kind: SourceSymlink } => true  WorkspaceSourceMember { member: _, kind: SourceFile } => false  WorkspaceSourceExcluded { member: _, kind: _, by: _, bytes: _ } => false  WorkspaceSourceBuildOutput { member: _ } => false  WorkspaceSourceUnparsed { line: _ } => false })),
    excluded: length(filter(lines, l => match l { WorkspaceSourceExcluded { member: _, kind: _, by: _, bytes: _ } => true  WorkspaceSourceMember { member: _, kind: _ } => false  WorkspaceSourceBuildOutput { member: _ } => false  WorkspaceSourceUnparsed { line: _ } => false })),
    excluded_credentials: length(workspace_excluded_sizes(lines: lines, class: CredentialExclusion)),
    excluded_credential_members: flat_map(lines, l => match l {
      WorkspaceSourceExcluded { member: m, kind: _, by: x, bytes: _ } => match x.class { CredentialExclusion => [m]  TranscriptExclusion => [] }
      WorkspaceSourceMember { member: _, kind: _ } => []
      WorkspaceSourceBuildOutput { member: _ } => []
      WorkspaceSourceUnparsed { line: _ } => []
    }),
    excluded_credential_bytes: workspace_bytes_total(sizes: workspace_excluded_sizes(lines: lines, class: CredentialExclusion)),
    excluded_transcripts: length(workspace_excluded_sizes(lines: lines, class: TranscriptExclusion)),
    excluded_transcript_bytes: workspace_bytes_total(sizes: workspace_excluded_sizes(lines: lines, class: TranscriptExclusion)),
    transcript_placeholders: workspace_transcript_placeholders(lines: lines),
    build_output: length(filter(lines, l => match l { WorkspaceSourceBuildOutput { member: _ } => true  WorkspaceSourceMember { member: _, kind: _ } => false  WorkspaceSourceExcluded { member: _, kind: _, by: _, bytes: _ } => false  WorkspaceSourceUnparsed { line: _ } => false })),
    unparsed: flat_map(lines, l => match l {
      WorkspaceSourceUnparsed { line: t } => [t]
      WorkspaceSourceMember { member: _, kind: _ } => []
      WorkspaceSourceExcluded { member: _, kind: _, by: _, bytes: _ } => []
      WorkspaceSourceBuildOutput { member: _ } => []
    }),
  }
}

// ── THE READBACK: WHAT THE ARCHIVE ACTUALLY HOLDS, BEFORE ANY BYTE LEAVES THE HOST ─────────────
//
// The pack is built from the filtered lists, so a credential should never be in it and a transcript
// should be there only as its placeholder. That is provenance by construction, and it is NOT enough
// at a confidentiality boundary: a name and a size are exactly what a real transcript shares with
// its placeholder. So this reads what the archive ACTUALLY holds and refuses otherwise. Names come
// from `tar -tf` (archive_listing) and run through the same matcher: a credential-class name refuses
// outright, and a transcript-class name refuses unless it is a staged placeholder. Every staged
// placeholder must then be, IN THE ARCHIVE, a regular file (the verbose listing's own type letter,
// size_listing) of its planned size whose bytes -- extracted back out of the archive and hashed,
// archived_digests -- are the SHA-256 the filler produced when it was staged. A real transcript of
// the same size differs in digest and refuses. Each failure is its own typed refusal.
type WorkspaceStagedPlaceholder {
  member: NonEmptyStr
  size: ByteSize
  expected_digest: Sha256Digest
}

type WorkspacePackReadback
  = WorkspacePackClean { members: Int }
  | WorkspacePackCarriesExcluded { member: NonEmptyStr, by: WorkspaceExclusion }
  | WorkspacePackPlaceholderAbsent { member: NonEmptyStr }
  | WorkspacePackPlaceholderNotRegular { member: NonEmptyStr, type_letter: String }
  | WorkspacePackPlaceholderSizeDiffers { member: NonEmptyStr, planned: ByteSize, archived: ByteSize }
  | WorkspacePackPlaceholderUnread { member: NonEmptyStr }
  | WorkspacePackPlaceholderDigestDiffers { member: NonEmptyStr, expected: Sha256Digest, archived: String }

fn workspace_pack_readback(exclusions: List<WorkspaceExclusion>, placeholders: List<WorkspaceStagedPlaceholder>, archive_listing: String, size_listing: String, archived_digests: Map<String, String>) -> WorkspacePackReadback {
  let planned = fold(placeholders, init: empty_map(), f: (m, p) => map_insert(m: m, key: p.member as String, value: p.size))
  match workspace_pack_readback_lines(exclusions: exclusions, planned: planned, lines: filter(split(archive_listing, separator: "\n"), l => l != ""), seen: 0) {
    WorkspacePackClean { members: n } => {
      let archived = fold(flat_map(filter(split(size_listing, separator: "\n"), l => l != ""), l => workspace_archived_entry(line: l)), init: empty_map(), f: (m, a) => map_insert(m: m, key: a.member, value: a))
      workspace_pack_placeholder_checks(placeholders: placeholders, archived: archived, digests: archived_digests, members: n)
    }
    WorkspacePackCarriesExcluded { member: m, by: x } => WorkspacePackCarriesExcluded { member: m, by: x }
    WorkspacePackPlaceholderAbsent { member: m } => WorkspacePackPlaceholderAbsent { member: m }
    WorkspacePackPlaceholderNotRegular { member: m, type_letter: t } => WorkspacePackPlaceholderNotRegular { member: m, type_letter: t }
    WorkspacePackPlaceholderSizeDiffers { member: m, planned: p, archived: a } => WorkspacePackPlaceholderSizeDiffers { member: m, planned: p, archived: a }
    WorkspacePackPlaceholderUnread { member: m } => WorkspacePackPlaceholderUnread { member: m }
    WorkspacePackPlaceholderDigestDiffers { member: m, expected: e, archived: a } => WorkspacePackPlaceholderDigestDiffers { member: m, expected: e, archived: a }
  }
}

fn workspace_pack_readback_lines(exclusions: List<WorkspaceExclusion>, planned: Map<String, ByteSize>, lines: List<String>, seen: Int) -> WorkspacePackReadback {
  match lines {
    Empty => WorkspacePackClean { members: seen }
    Cons { head: l, tail: rest } =>
      match workspace_path_exclusion(exclusions: exclusions, path: l) {
        Absent => workspace_pack_readback_lines(exclusions: exclusions, planned: planned, lines: rest, seen: seen + 1)
        Present { value: x } =>
          match x.class {
            CredentialExclusion => WorkspacePackCarriesExcluded { member: l as NonEmptyStr, by: x }
            TranscriptExclusion =>
              if map_contains_key(m: planned, key: l) {
                workspace_pack_readback_lines(exclusions: exclusions, planned: planned, lines: rest, seen: seen + 1)
              } else {
                WorkspacePackCarriesExcluded { member: l as NonEmptyStr, by: x }
              }
          }
      }
  }
}

// ONE VERBOSE-LISTING LINE: its type letter (the first character of the mode word: '-' a regular
// file, 'l' a symlink, 'h' a hard link, ...), its size, and its name. Five leading words (mode,
// uid/gid, size, date, time), each possibly padded by several spaces; the name is the rest of the
// line verbatim, so a name with spaces survives. A symlink's or hard link's name carries its target
// after it (" -> t", " link to t"), so such a line never names a placeholder exactly and a planned
// member archived as one reads as absent -- refused either way.
type WorkspaceArchivedEntry {
  member: String
  type_letter: String
  size: ByteSize
}

fn workspace_archived_entry(line: String) -> List<WorkspaceArchivedEntry> {
  match workspace_verbose_fields(words: split(line, separator: " "), fields: [], wanted: 5) {
    Absent => []
    Present { value: parsed } =>
      match parsed.fields {
        Cons { head: mode, tail: Cons { head: _, tail: Cons { head: size_text, tail: _ } } } =>
          match parse_int(s: size_text) {
            Absent => []
            Present { value: n } => if n < 0 || parsed.rest == "" { [] } else { [WorkspaceArchivedEntry { member: parsed.rest, type_letter: substring(s: mode, start: 0, end: 1), size: byte_size(count: n) }] }
          }
        Cons { head: _, tail: Cons { head: _, tail: Empty } } => []
        Cons { head: _, tail: Empty } => []
        Empty => []
      }
  }
}

type WorkspaceVerboseFields {
  fields: List<String>
  rest: String
}

fn workspace_verbose_fields(words: List<String>, fields: List<String>, wanted: Int) -> WorkspaceVerboseFields? {
  if wanted == 0 {
    Present { value: WorkspaceVerboseFields { fields: fields, rest: join(words, " ") } }
  } else {
    match words {
      Empty => none
      Cons { head: w, tail: rest } =>
        if w == "" {
          workspace_verbose_fields(words: rest, fields: fields, wanted: wanted)
        } else {
          workspace_verbose_fields(words: rest, fields: concat(fields, [w]), wanted: wanted - 1)
        }
    }
  }
}

// Every side is keyed by member name, so the check is one lookup per placeholder rather than a scan
// of the archive per placeholder.
fn workspace_pack_placeholder_checks(placeholders: List<WorkspaceStagedPlaceholder>, archived: Map<String, WorkspaceArchivedEntry>, digests: Map<String, String>, members: Int) -> WorkspacePackReadback {
  match placeholders {
    Empty => WorkspacePackClean { members: members }
    Cons { head: p, tail: rest } =>
      match map_lookup(m: archived, key: p.member as String) {
        Absent => WorkspacePackPlaceholderAbsent { member: p.member }
        Present { value: a } =>
          if a.type_letter != "-" {
            WorkspacePackPlaceholderNotRegular { member: p.member, type_letter: a.type_letter }
          } else if measure_count(m: a.size) != measure_count(m: p.size) {
            WorkspacePackPlaceholderSizeDiffers { member: p.member, planned: p.size, archived: a.size }
          } else {
            match map_lookup(m: digests, key: p.member as String) {
              Absent => WorkspacePackPlaceholderUnread { member: p.member }
              Present { value: d } =>
                if d != (p.expected_digest.hex as String) {
                  WorkspacePackPlaceholderDigestDiffers { member: p.member, expected: p.expected_digest, archived: d }
                } else {
                  workspace_pack_placeholder_checks(placeholders: rest, archived: archived, digests: digests, members: members)
                }
            }
          }
      }
  }
}

// ── THE INPUT OBJECT'S PLACE IN THE WORKSPACE BUCKET ───────────────────────────────────────────

data fabric_workspace_source_prefix: NonEmptyStr = "sources/"

fn fabric_workspace_source_key(address: FabricBlobAddress) -> NonEmptyStr {
  concat(fabric_workspace_source_prefix as String, fabric_blob_object_name(address: address) as String) as NonEmptyStr
}

data workspace_source_receipt_path: String = "target/workspace-source-pack-receipt.txt"

// Spans on this process's monotonic clock, derived by std.checkpointed_workspace
// workspace_age_between from two typed instants; an underivable span is named, never zero.
fn workspace_source_instant(label: String) -> ObservationInstant {
  ObservationInstant { domain: ProcessMonotonic { process: "workspace-source-pack" }, basis: WallClock, since_origin: nanosecond(count: observed_monotonic_nanos(label)) }
}

fn workspace_source_span_words(start: ObservationInstant, end_label: String) -> String {
  match workspace_age_between(from: start, to: workspace_source_instant(label: end_label)) {
    WorkspaceAgeOf { age: a } => join([to_string(nanosecond_count(n: a) / 1000000), "ms"], "")
    WorkspaceAgeUndefined { order: _ } => "unmeasured(instants did not order in one clock domain)"
  }
}

// ── THE PACK, ON THE SOURCE HOST ───────────────────────────────────────────────────────────────

type WorkspaceSourceEnumeration
  = WorkspaceSourceEnumerated { root: WorkspaceSourceRoot, tally: WorkspaceSourceTally }
  | WorkspaceSourceUnreadable { root: WorkspaceSourceRoot, detail: String }

fn workspace_runner_principal() -> String {
  let id = shell.Id.UserName()
  if id.success { trim_newline(s: id.stdout) } else { join(["unnamed (id -un failed: ", id.stderr, ")"], "") }
}

fn trim_newline(s: String) -> String {
  replace(s, "\n", "")
}

fn workspace_source_enumerate(root: WorkspaceSourceRoot) -> WorkspaceSourceEnumeration {
  let listing = shell.Find.FilesAndSymlinksWithMode(root: root.path as FilePath)
  if listing.success == false {
    let owner = shell.Stat.OwnerOf(path: root.path as FilePath)
    let mode = shell.Stat.ModeOf(path: root.path as FilePath)
    WorkspaceSourceUnreadable {
      root: root,
      detail: join([
        "the runner principal ", workspace_runner_principal(), " could not enumerate ", root.path as String,
        " (owner ", trim_newline(s: owner.stdout), ", mode ", trim_newline(s: mode.stdout), "); find reported: ", listing.stderr,
      ], ""),
    }
  } else {
    let tally = workspace_source_tally(root: root, exclusions: workspace_exclusions(), listing: listing.stdout)
    match tally.unparsed {
      Empty => WorkspaceSourceEnumerated { root: root, tally: tally }
      Cons { head: first_line, tail: _ } => WorkspaceSourceUnreadable { root: root, detail: join(["the enumeration printed a line that is not a file or symlink record: ", first_line], "") }
    }
  }
}

fn workspace_source_enumerate_all(roots: List<WorkspaceSourceRoot>) -> List<WorkspaceSourceEnumeration> {
  map(roots, r => workspace_source_enumerate(root: r))
}

fn workspace_source_refusals(enumerations: List<WorkspaceSourceEnumeration>) -> List<String> {
  flat_map(enumerations, e => match e {
    WorkspaceSourceUnreadable { root: r, detail: d } => [join([r.label as String, ": ", d], "")]
    WorkspaceSourceEnumerated { root: _, tally: _ } => []
  })
}

fn workspace_source_tallies(enumerations: List<WorkspaceSourceEnumeration>) -> List<WorkspaceSourceTally> {
  flat_map(enumerations, e => match e {
    WorkspaceSourceEnumerated { root: _, tally: t } => [t]
    WorkspaceSourceUnreadable { root: _, detail: _ } => []
  })
}

fn workspace_tally_line(e: WorkspaceSourceEnumeration) -> String {
  match e {
    WorkspaceSourceEnumerated { root: r, tally: t } =>
      join(["root ", r.label as String, " path=", r.path as String, " files=", to_string(t.files), " symlinks=", to_string(t.symlinks), " excluded=", to_string(t.excluded), " excluded_credentials=", to_string(t.excluded_credentials), " excluded_credential_bytes=", to_string(measure_count(m: t.excluded_credential_bytes)), " excluded_credential_paths=", join(map(t.excluded_credential_members, m => m as String), ","), " excluded_transcripts=", to_string(t.excluded_transcripts), " excluded_transcript_bytes=", to_string(measure_count(m: t.excluded_transcript_bytes)), " transcript_placeholders=", to_string(length(t.transcript_placeholders)), " build_output=", to_string(t.build_output)], "")
    WorkspaceSourceUnreadable { root: r, detail: _ } => join(["root ", r.label as String, " path=", r.path as String, " UNREADABLE"], "")
  }
}

fn workspace_put_words(put: FabricBlobPut) -> String {
  match put {
    FabricBlobStored { address: _ } => "stored"
    FabricBlobOccupied { address: _ } => "already-present"
    FabricBlobPutRefused { address: _, fault: f } => join(["refused: ", fabric_blob_fault_text(fault: f)], "")
    FabricBlobPutOutcomeUnknown { address: _, cause: c } => join(["outcome-unknown: ", c as String], "")
    FabricBlobPutRefusedTooLarge { address: _, size: s, bound: b } => join(["too-large: ", to_string(measure_count(m: s)), " > ", to_string(measure_count(m: b))], "")
  }
}

fn workspace_put_landed(put: FabricBlobPut) -> Bool {
  match put {
    FabricBlobStored { address: _ } => true
    FabricBlobOccupied { address: _ } => true
    FabricBlobPutRefused { address: _, fault: _ } => false
    FabricBlobPutOutcomeUnknown { address: _, cause: _ } => false
    FabricBlobPutRefusedTooLarge { address: _, size: _, bound: _ } => false
  }
}

fn workspace_source_receipt_head(enumerations: List<WorkspaceSourceEnumeration>) -> String {
  join([
    "workspace_source_pack host=", workspace_source_pack_host as String, "\n",
    "credential_exclusions=", workspace_exclusion_spellings(exclusions: workspace_credential_exclusions), "\n",
    "transcript_exclusions=", workspace_exclusion_spellings(exclusions: workspace_transcript_exclusions), " (carried as same-size, same-path placeholders)\n",
    join(map(enumerations, e => workspace_tally_line(e: e)), "\n"), "\n",
  ], "")
}

fn workspace_source_finish(receipt: String, outcome: ProcessExit) -> ProcessExit {
  let w = Filesystem.Write(path: workspace_source_receipt_path, content: receipt)
  if w.success == false {
    exit_failure(reason: join(["workspace_source_pack: receipt write failed: ", w.error, "\n", receipt], ""))
  } else {
    outcome
  }
}

fn workspace_run_ok(run: ProcessRunOutcome) -> String? {
  match run {
    ProcessNotSpawned { program: p, cause: c } => Present { value: join([p as String, " did not run: ", c as String], "") }
    ProcessRan { observation: o } => if o.exit_code == 0 { none } else { Present { value: join(["exit ", to_string(o.exit_code), ": ", o.stderr], "") } }
  }
}

fn workspace_source_pack_wet() -> ProcessExit {
  let host = match hostname_short_read(transport: LocalShell) {
    HostnameShortCaptured { value: v } => v
    HostnameShortCaptureRefused { reason: _ } => ""
  }
  if host != (workspace_source_pack_host as String) {
    exit_failure(reason: join(["workspace_source_pack: the source lives on ", workspace_source_pack_host as String, " but this job runs on '", host, "'; dispatch it with host=", workspace_source_pack_host as String], ""))
  } else {
    let slot = workspace_agent_state_slot_observe()
    let slot_line = concat(workspace_agent_state_slot_words(admission: slot), "\n")
    match slot {
      AgentStateSlotAbsent { observed: _ } => workspace_source_finish(receipt: join(["workspace_source_pack host=", host, "\n", slot_line, "verdict=refused-agent-state-slot\n"], ""), outcome: exit_failure(reason: concat("workspace_source_pack: ", slot_line)))
      AgentStateSlotUnknown { requested: _, observed: _ } => workspace_source_finish(receipt: join(["workspace_source_pack host=", host, "\n", slot_line, "verdict=refused-agent-state-slot\n"], ""), outcome: exit_failure(reason: concat("workspace_source_pack: ", slot_line)))
      AgentStateSlotAdmitted { slot: _, root: agent } => {
        let enumerations = workspace_source_enumerate_all(roots: concat(workspace_source_fixed_roots, [agent]))
        let head = concat(workspace_source_receipt_head(enumerations: enumerations), slot_line)
        match workspace_source_refusals(enumerations: enumerations) {
          Cons { head: _, tail: _ } =>
            workspace_source_finish(receipt: concat(head, "verdict=refused-source-unreadable\n"), outcome: exit_failure(reason: join(concat(["workspace_source_pack: a source root is unreadable by the runner; no permission is widened here:"], workspace_source_refusals(enumerations: enumerations)), "\n")))
          Empty => workspace_source_pack_readable(head: head, tallies: workspace_source_tallies(enumerations: enumerations))
        }
      }
    }
  }
}

fn workspace_source_pack_readable(head: String, tallies: List<WorkspaceSourceTally>) -> ProcessExit {
  let staging = shell.Mktemp.Dir()
  if staging.success == false {
    workspace_source_finish(receipt: concat(head, "verdict=refused-no-staging\n"), outcome: exit_failure(reason: "workspace_source_pack: no private staging directory could be minted"))
  } else {
    let placeholders = flat_map(tallies, t => t.transcript_placeholders)
    let placeholder_root = join([staging.path as String, "/placeholders"], "")
    let head2 = concat(head, workspace_placeholder_words(placeholders: placeholders))
    match workspace_stage_placeholders(root: placeholder_root, placeholders: placeholders, staged: []) {
      WorkspacePlaceholdersRefused { why: why } => {
        let removed = shell.Remove.RecursiveForce(path: staging.path)
        workspace_source_finish(receipt: join([head2, "verdict=refused-placeholder-unstaged staging_removed=", if removed.success { "yes" } else { "no" }, "\n"], ""), outcome: exit_failure(reason: concat("workspace_source_pack: a transcript placeholder could not be staged: ", why)))
      }
      WorkspacePlaceholdersStaged { placeholders: staged } => {
        let pack_start = workspace_source_instant(label: "workspace-source-pack-start")
        let built = workspace_pack_archive(staging: staging.path as String, members: flat_map(tallies, t => t.members), placeholders: staged, placeholder_root: placeholder_root)
        let pack_span = workspace_source_span_words(start: pack_start, end_label: "workspace-source-pack-end")
        match built {
          WorkspacePackRefused { verdict: v, why: why } => workspace_source_refuse_archive(head: head2, staging: staging.path as String, verdict: v, why: why)
          WorkspacePackBuilt { archive: archive, readback: r } =>
            match workspace_pack_readback_refusal(readback: r) {
              Present { value: refusal } => workspace_source_refuse_archive(head: head2, staging: staging.path as String, verdict: refusal.verdict, why: refusal.why)
              Absent => workspace_source_publish(head: concat(head2, join(["archive_members=", to_string(workspace_pack_clean_members(readback: r)), " placeholders_digest_checked=", to_string(length(staged)), " pack=", pack_span, "\n"], "")), archive: archive, staging: staging.path as String)
            }
        }
      }
    }
  }
}

fn workspace_placeholder_words(placeholders: List<WorkspaceTranscriptPlaceholder>) -> String {
  join([
    "transcript_placeholders files=", to_string(length(placeholders)),
    " bytes=", to_string(measure_count(m: workspace_bytes_total(sizes: map(placeholders, p => p.size)))),
    " filler=extdeps.crypto.seeded_filler seed=member-path\n",
    workspace_transcript_caveat as String, "\n",
  ], "")
}

type WorkspacePlaceholderStaging
  = WorkspacePlaceholdersStaged { placeholders: List<WorkspaceStagedPlaceholder> }
  | WorkspacePlaceholdersRefused { why: String }

// EACH PLACEHOLDER AT <root>/<member>, its parent directories made first, and its SHA-256 taken from
// the staged bytes: that digest is what the archive readback requires the archived member to hash
// to. The first refusal stops the staging; nothing is packed from a partly staged tree.
fn workspace_stage_placeholders(root: String, placeholders: List<WorkspaceTranscriptPlaceholder>, staged: List<WorkspaceStagedPlaceholder>) -> WorkspacePlaceholderStaging {
  match placeholders {
    Empty => WorkspacePlaceholdersStaged { placeholders: staged }
    Cons { head: p, tail: rest } => {
      let path = join([root, "/", p.member as String], "")
      let parent = join(workspace_all_but_last(xs: split(path, separator: "/")), "/")
      let made = shell.Mkdir.Parents(path: parent as FilePath)
      if made.success == false {
        WorkspacePlaceholdersRefused { why: concat("mkdir -p failed: ", parent) }
      } else {
        match seeded_filler_write(seed: p.member, size: p.size, path: path as NonEmptyStr) {
          SeededFillerRefused { path: _, step: st, detail: d } => WorkspacePlaceholdersRefused { why: join([p.member as String, ": ", seeded_filler_step_words(step: st), ": ", d], "") }
          SeededFillerWritten { path: _, size: _ } =>
            match workspace_file_digest(path: path) {
              Absent => WorkspacePlaceholdersRefused { why: concat("the staged placeholder could not be hashed: ", p.member as String) }
              Present { value: d } => workspace_stage_placeholders(root: root, placeholders: rest, staged: concat(staged, [WorkspaceStagedPlaceholder { member: p.member, size: p.size, expected_digest: d }]))
            }
        }
      }
    }
  }
}

fn workspace_file_digest(path: String) -> Sha256Digest? {
  let d = sha256sum.Sha256.DigestFile(path: path as NonEmptyStr)
  if d.success == false { none } else { sha256_hex_digest(hex: substring(s: d.line, start: 0, end: 64)) }
}

fn workspace_all_but_last(xs: List<String>) -> List<String> {
  match xs {
    Empty => []
    Cons { head: _, tail: Empty } => []
    Cons { head: x, tail: rest } => concat([x], workspace_all_but_last(xs: rest))
  }
}

// ── THE ARCHIVE: BUILT FROM BOTH SOURCES, READ BACK, AND ITS PLACEHOLDERS EXTRACTED AND HASHED ──
//
// The real members are read relative to "/" and the placeholders relative to their staging root,
// under the same member names, into one tar. The readback then lists the archive twice (names, then
// types and sizes), extracts exactly the placeholder members into a fresh directory, and hashes each
// extracted file. Every step's failure is a typed refusal; the readback's verdict is returned whole
// so the caller words it.
//
// Two orderings carry the reasons. The placeholder root is made FIRST: the second -C must name a
// directory even when no transcript was planned, so a workspace with no transcripts packs through
// the same two-list route with an empty second list, and the staging directory the lists are written
// into exists whatever was staged. And the LOCATED refusals come before extraction: names, types and
// sizes are judged from the listings alone, with each placeholder's digest assumed, so a missing or
// malformed member is refused by name rather than as a failed extract of the whole list.
type WorkspacePackArchive
  = WorkspacePackBuilt { archive: String, readback: WorkspacePackReadback }
  | WorkspacePackRefused { verdict: String, why: String }

fn workspace_pack_archive(staging: String, members: List<NonEmptyStr>, placeholders: List<WorkspaceStagedPlaceholder>, placeholder_root: String) -> WorkspacePackArchive {
  let list_path = join([staging, "/members"], "")
  let placeholder_list_path = join([staging, "/placeholder-members"], "")
  let archive = join([staging, "/workspace-source.tar"], "")
  let root_made = shell.Mkdir.Parents(path: placeholder_root as FilePath)
  if root_made.success == false {
    WorkspacePackRefused { verdict: "refused-placeholder-root-unmade", why: concat("the placeholder staging root could not be made: ", placeholder_root) }
  } else {
    let listed = Filesystem.Write(path: list_path, content: concat(join(map(members, m => m as String), "\n"), "\n"))
    let placeholder_listed = Filesystem.Write(path: placeholder_list_path, content: join(map(placeholders, p => concat(p.member as String, "\n")), ""))
    if listed.success == false || placeholder_listed.success == false {
      WorkspacePackRefused { verdict: "refused-member-list-unwritten", why: join(["a member list could not be written: ", listed.error, placeholder_listed.error], "") }
    } else {
      match workspace_run_ok(run: run_shell_command_observe_outcome(command: tar_create_from_two_lists_command(archive: archive, first_directory: "/", first_list: list_path, second_directory: placeholder_root, second_list: placeholder_list_path), transport: LocalExec)) {
        Present { value: why } => WorkspacePackRefused { verdict: "refused-pack-failed", why: concat("tar refused: ", why) }
        Absent =>
          match workspace_archive_listings(archive: archive) {
            Absent => WorkspacePackRefused { verdict: "refused-readback-failed", why: "the archive could not be listed back" }
            Present { value: listings } => {
              let structural = workspace_pack_readback(exclusions: workspace_exclusions(), placeholders: placeholders, archive_listing: listings.names, size_listing: listings.sizes, archived_digests: fold(placeholders, init: empty_map(), f: (m, p) => map_insert(m: m, key: p.member as String, value: p.expected_digest.hex as String)))
              match workspace_pack_readback_refusal(readback: structural) {
                Present { value: _ } => WorkspacePackBuilt { archive: archive, readback: structural }
                Absent =>
              match workspace_archived_placeholder_digests(staging: staging, archive: archive, placeholder_list: placeholder_list_path, placeholders: placeholders) {
                Absent => WorkspacePackRefused { verdict: "refused-placeholder-extract-failed", why: "the placeholder members could not be extracted back out of the archive" }
                Present { value: digests } => {
                  let r = workspace_pack_readback(exclusions: workspace_exclusions(), placeholders: placeholders, archive_listing: listings.names, size_listing: listings.sizes, archived_digests: digests)
                  let expected = length(members) + length(placeholders)
                  match r {
                    WorkspacePackClean { members: n } =>
                      if n != expected {
                        WorkspacePackRefused { verdict: "refused-member-count-mismatch", why: join(["the archive holds ", to_string(n), " members but the lists named ", to_string(expected)], "") }
                      } else {
                        WorkspacePackBuilt { archive: archive, readback: r }
                      }
                    WorkspacePackCarriesExcluded { member: _, by: _ } => WorkspacePackBuilt { archive: archive, readback: r }
                    WorkspacePackPlaceholderAbsent { member: _ } => WorkspacePackBuilt { archive: archive, readback: r }
                    WorkspacePackPlaceholderNotRegular { member: _, type_letter: _ } => WorkspacePackBuilt { archive: archive, readback: r }
                    WorkspacePackPlaceholderSizeDiffers { member: _, planned: _, archived: _ } => WorkspacePackBuilt { archive: archive, readback: r }
                    WorkspacePackPlaceholderUnread { member: _ } => WorkspacePackBuilt { archive: archive, readback: r }
                    WorkspacePackPlaceholderDigestDiffers { member: _, expected: _, archived: _ } => WorkspacePackBuilt { archive: archive, readback: r }
                  }
                }
              }
              }
            }
          }
      }
    }
  }
}

// THE ARCHIVED PLACEHOLDER BYTES, HASHED: extract exactly the placeholder members into
// <staging>/readback and sha256sum each. A member that did not extract or could not be hashed is
// simply absent from the map, which the readback refuses as unread. An empty plan extracts nothing.
fn workspace_archived_placeholder_digests(staging: String, archive: String, placeholder_list: String, placeholders: List<WorkspaceStagedPlaceholder>) -> Map<String, String>? {
  match placeholders {
    Empty => Present { value: empty_map() }
    Cons { head: _, tail: _ } => {
      let into = join([staging, "/readback"], "")
      let made = shell.Mkdir.Parents(path: into as FilePath)
      if made.success == false {
        none
      } else {
        match workspace_run_ok(run: run_shell_command_observe_outcome(command: tar_extract_listed_command(archive: archive, into_directory: into, member_list: placeholder_list), transport: LocalExec)) {
          Present { value: _ } => none
          Absent => Present { value: fold(placeholders, init: empty_map(), f: (m, p) => match workspace_file_digest(path: join([into, "/", p.member as String], "")) {
            Present { value: d } => map_insert(m: m, key: p.member as String, value: d.hex as String)
            Absent => m
          }) }
        }
      }
    }
  }
}

type WorkspaceReadbackRefusal {
  verdict: String
  why: String
}

fn workspace_pack_clean_members(readback: WorkspacePackReadback) -> Int {
  match readback {
    WorkspacePackClean { members: n } => n
    WorkspacePackCarriesExcluded { member: _, by: _ } => 0
    WorkspacePackPlaceholderAbsent { member: _ } => 0
    WorkspacePackPlaceholderNotRegular { member: _, type_letter: _ } => 0
    WorkspacePackPlaceholderSizeDiffers { member: _, planned: _, archived: _ } => 0
    WorkspacePackPlaceholderUnread { member: _ } => 0
    WorkspacePackPlaceholderDigestDiffers { member: _, expected: _, archived: _ } => 0
  }
}

fn workspace_pack_readback_refusal(readback: WorkspacePackReadback) -> WorkspaceReadbackRefusal? {
  match readback {
    WorkspacePackClean { members: _ } => none
    WorkspacePackCarriesExcluded { member: m, by: x } =>
      Present { value: WorkspaceReadbackRefusal { verdict: join(["refused-excluded-member member=", m as String, " rule=", x.spelling as String], ""), why: join(["the archive carries ", m as String, ", which the workspace exclusion ", x.spelling as String, " names and no placeholder stands for"], "") } }
    WorkspacePackPlaceholderAbsent { member: m } =>
      Present { value: WorkspaceReadbackRefusal { verdict: concat("refused-placeholder-absent member=", m as String), why: concat("the archive holds no member for the transcript placeholder ", m as String) } }
    WorkspacePackPlaceholderNotRegular { member: m, type_letter: t } =>
      Present { value: WorkspaceReadbackRefusal { verdict: join(["refused-placeholder-not-regular member=", m as String, " type=", t], ""), why: join(["the transcript placeholder ", m as String, " is archived as type '", t, "', not a regular file"], "") } }
    WorkspacePackPlaceholderSizeDiffers { member: m, planned: p, archived: a } =>
      Present { value: WorkspaceReadbackRefusal { verdict: join(["refused-placeholder-size member=", m as String, " planned=", to_string(measure_count(m: p)), " archived=", to_string(measure_count(m: a))], ""), why: join(["the transcript placeholder ", m as String, " is archived at ", to_string(measure_count(m: a)), " bytes, not its planned ", to_string(measure_count(m: p))], "") } }
    WorkspacePackPlaceholderUnread { member: m } =>
      Present { value: WorkspaceReadbackRefusal { verdict: concat("refused-placeholder-unread member=", m as String), why: concat("the archived bytes of the transcript placeholder could not be extracted and hashed: ", m as String) } }
    WorkspacePackPlaceholderDigestDiffers { member: m, expected: e, archived: a } =>
      Present { value: WorkspaceReadbackRefusal { verdict: join(["refused-placeholder-digest member=", m as String, " expected=", e.hex as String, " archived=", a], ""), why: join(["the archived bytes of ", m as String, " are not its staged placeholder (sha256 ", a, ", expected ", e.hex as String, "); the archive may carry real transcript content"], "") } }
  }
}

fn workspace_source_refuse_archive(head: String, staging: String, verdict: String, why: String) -> ProcessExit {
  let removed = shell.Remove.RecursiveForce(path: staging as FilePath)
  workspace_source_finish(receipt: join([head, "verdict=", verdict, " archive_removed=", if removed.success { "yes" } else { "no" }, "\n"], ""), outcome: exit_failure(reason: join(["workspace_source_pack: ", why, "; nothing was uploaded"], "")))
}

type WorkspaceArchiveListings {
  names: String
  sizes: String
}

fn workspace_archive_listings(archive: String) -> WorkspaceArchiveListings? {
  match run_shell_command_observe_outcome(command: tar_list_command(archive: archive), transport: LocalExec) {
    ProcessNotSpawned { program: _, cause: _ } => none
    ProcessRan { observation: names } =>
      if names.exit_code != 0 {
        none
      } else {
        match run_shell_command_observe_outcome(command: tar_list_sizes_command(archive: archive), transport: LocalExec) {
          ProcessNotSpawned { program: _, cause: _ } => none
          ProcessRan { observation: sizes } => if sizes.exit_code != 0 { none } else { Present { value: WorkspaceArchiveListings { names: names.stdout, sizes: sizes.stdout } } }
        }
      }
  }
}

fn workspace_source_publish(head: String, archive: String, staging: String) -> ProcessExit {
  match read_staged_fabric_blob(path: archive as NonEmptyStr) {
    FabricBlobReadRefused { fault: f } => workspace_source_finish(receipt: concat(head, "verdict=refused-archive-unread\n"), outcome: exit_failure(reason: concat("workspace_source_pack: ", fabric_blob_fault_text(fault: f))))
    FabricBlobRead { reading: r } => {
      let address = FabricBlobAddress { key: fabric_blob_reading_digest(reading: r) }
      let head2 = join([head, "address=", fabric_blob_object_name(address: address) as String, " bytes=", to_string(measure_count(m: fabric_blob_reading_size(reading: r))), "\n"], "")
      match select_access_token_source() {
        AccessTokenSourceUnavailable { cause: c } => workspace_source_finish(receipt: concat(head2, "verdict=refused-no-token-source\n"), outcome: exit_failure(reason: concat("workspace_source_pack: ", c as String)))
        AccessTokenSourceSelected { source: s } => {
          let up_start = workspace_source_instant(label: "workspace-source-upload-start")
          let put = put_fabric_blob(address: address, reading: r, key: fabric_workspace_source_key(address: address), bound: fabric_workspace_object_bound(), purpose: FabricWorkspace {}, token_source: s)
          let up_span = workspace_source_span_words(start: up_start, end_label: "workspace-source-upload-end")
          let removed = shell.Remove.RecursiveForce(path: staging as FilePath)
          let receipt = join([head2, "upload=", workspace_put_words(put: put.verdict), " upload_span=", up_span, " staging_removed=", if removed.success { "yes" } else { "no" }, "\n"], "")
          match put.credential {
            WriteCredentialResidueRemains { cause: why } =>
              workspace_source_finish(receipt: join([receipt, "credential=RESIDUE ", why as String, "\nverdict=", if workspace_put_landed(put: put.verdict) { "published-with-residue" } else { "refused-upload-with-residue" }, "\n"], ""), outcome: exit_failure(reason: join(["workspace_source_pack: the write credential was left behind and requires cleanup: ", why as String, " (upload=", workspace_put_words(put: put.verdict), ")"], "")))
            WriteCredentialShredded =>
          if workspace_put_landed(put: put.verdict) {
            workspace_source_finish(receipt: concat(receipt, "verdict=published\n"), outcome: ExitSuccess)
          } else {
            workspace_source_finish(receipt: concat(receipt, "verdict=refused-upload\n"), outcome: exit_failure(reason: concat("workspace_source_pack: the archive was not published: ", workspace_put_words(put: put.verdict))))
          }
          }
        }
      }
    }
  }
}
