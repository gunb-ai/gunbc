module gunbc.fabric.fabric_cell_grant

import std.types { NonEmptyStr, String, Timestamp }
import std.decl_ref { decl_ref }
import std.measure { Measure }
import std.nat { Nat }
import std.content_hash { content_hash_of_value }
import std.durable_compare_and_set {
  CasGeneration, CasStoreFailure, CasSlotObservationRefused, CasUnreadableSlot,
  CasSuccessorGeneration, CasSuccessorExhausted, cas_generation_count,
}
import std.durable_exclusive_hold {
  DurableHoldOwnerRef, DurableHoldReleaseRef,
  HoldSlotAbsent, HoldSlotFree, HoldSlotHeld, HoldSlotUndecodable, HoldObservationUnavailable,
  HoldAcquireOccupied, HoldAcquireSlotUndecodable, HoldAcquireObservationUnavailable,
}
import gunbc.workspace_slot_mutation {
  workspace_slot_mutation_acquire, workspace_slot_mutation_release,
  WorkspaceSlotMutationAdmitted, WorkspaceSlotMutationRefused,
}
import gunbc.durable_exclusive_hold_file_store {
  FileHoldAcquired, FileHoldOccupied, FileHoldAcquireLost,
  FileHoldAcquireStoreUnavailable, FileHoldSlotUndecodable, FileHoldKeyNotSlotAddressable,
  FileHoldAcquirePlanned, FileHoldAcquireNotEligible,
  file_hold_acquire_prepare, file_hold_acquire_commit,
  file_hold_acquire_plan_landing, file_hold_acquire_plan_for_owner,
  observe_file_hold,
}
import product.fabric.identity { FabricIdentity, DemandKey, WorkKey, OfferKey, ExecutionAttemptKey, GrantKey }
import product.fabric.work { Work }
import product.fabric.selection { SelectedOffer }
import product.fabric.budget { MoneyAccount, MoneyReservationRequest }
import product.fabric.execution {
  Attempt, ExecutionGrant, ReservationRef, LeaseKey, LeaseIdentity, FabricGrantEvidence,
}
import product.fabric.grant_issue { GrantIssue, GrantCommitted, GrantRefused, GrantIssueRefusal, issue_grant, derive_grant_key }
import extdeps.accounting.encumbrance { EncumbranceLedger }
import gunbc.fabric.fabric_control_plane { selected_cell_allocation_key }

// FCI-2 OVER A CELL: SELECTION, RESERVATION AND COMMITMENT AS ONE DURABLE TRANSITION.
//
// product.fabric.grant_issue issue_grant is the issuance kernel, and it declares two residuals it
// cannot close from where it sits (its "WHAT THIS DOES NOT ESTABLISH" note): the lease it fences
// is a caller-supplied description rather than a held reservation, and the duplicate check reads a
// caller-supplied `outstanding` list, so two evaluations handed the same stale empty list each
// commit. Both close here, by one move: the grant is written INTO the cell's hold.
//
// The hold slot is append-only compare-and-set (gunbc.durable_exclusive_hold_file_store). The live
// read that admits an acquire also fixes the generation a commit will land on, so the grant's lease
// can name that generation BEFORE the write, the grant key derives from it, and the hold's owner is
// the grant key. One CAS write therefore commits reservation and grant together:
// - no grant without a hold, and no hold without its grant, because there is one write;
// - at most one live grant per cell, because a held slot refuses every other acquire, which is the
//   population `outstanding` was standing in for. Within this transition the population IS the
//   slot, so issue_grant is handed an empty roster with that justification and no other;
// - the lease's generation is the slot's own, so a grant whose generation is no longer the slot's
//   current hold is detectably not live (cell_grant_standing below).
//
// THE CELL IS READ OFF THE WINNER. The slot key is selected_cell_allocation_key of the selected
// offer, the same derivation fabric_control_plane reserves under, so a caller cannot grant one cell
// against a ranking that chose another. The resource ReservationRef IS that slot key, which gives
// a release directive a reference that names a cell (the control plane's "THREE GAPS" note, gap
// ONE, for grants issued here).
//
// WHAT THIS DOES NOT ESTABLISH, so no reader budgets for it.
// - MONEY IS NOT DURABLE. The MoneyAccount and the EncumbranceLedger are values in and out, as in
//   issue_grant; a crash after the write loses the advanced account. The hold is the durable
//   authority for WHO may execute; whether the money ledger is durable is product.fabric.budget's
//   question, not this transition's.
// - RELEASE AND SANITATION are FCI-4. A cell held by a grant key is not released by
//   fabric_control_plane end_cell_hold, whose owner is the money reservation reference; the release
//   path for a granted cell lands with FCI-4's receipt admission.
// - The re-read below is the agreement half FCI-3's executor needs; the executor that calls it in
//   a later process, before starting anything, is FCI-3 and is the named consumer
//   (gunbc.runner.runner_attempt_launch reservation_authorization_grant_producer_frontier).

type CellGrant<Q, S>
  = CellGranted { grant: ExecutionGrant<NonEmptyStr>, account: MoneyAccount, ledger: EncumbranceLedger<Q, S> }
  // The slot is held. Re-issuing against a held cell is the duplicate-grant case, whatever holds it.
  | CellAlreadyGranted { slot_key: NonEmptyStr, holder: DurableHoldOwnerRef, generation: CasGeneration }
  // Issuance refused before anything was written; the cell is untouched.
  | CellGrantIssueRefused { slot_key: NonEmptyStr, refusal: GrantIssueRefusal<NonEmptyStr, Q, S> }
  // Another writer committed the slot between this read and this write; re-observe.
  | CellGrantLost { slot_key: NonEmptyStr }
  | CellGrantStoreUnavailable { slot_key: NonEmptyStr, cause: CasStoreFailure }
  | CellGrantSlotUndecodable { slot_key: NonEmptyStr, generation: CasGeneration, detail: NonEmptyStr }
  | CellGrantGenerationsExhausted { slot_key: NonEmptyStr, head: CasGeneration }
  | CellGrantAttemptRefused { slot_key: NonEmptyStr, detail: NonEmptyStr }

fn cell_grant_lease(slot_key: NonEmptyStr, generation: CasGeneration) -> LeaseIdentity {
  LeaseIdentity {
    lease_key: (slot_key as String) as LeaseKey,
    // The exact reserved claim is the slot: one slot key names one cell, never the host.
    resource_fingerprint: content_hash_of_value(value: slot_key),
    generation: cas_generation_count(g: generation),
  }
}

fn cell_grant_owner(grant: ExecutionGrant<NonEmptyStr>) -> DurableHoldOwnerRef {
  (grant.id.key as String) as DurableHoldOwnerRef
}

fn grant_selected_cell<Q, S>(
  root: NonEmptyStr,
  work: Work<NonEmptyStr>,
  attempt: Attempt<NonEmptyStr>,
  selected: SelectedOffer<NonEmptyStr>,
  account: MoneyAccount,
  money_request: MoneyReservationRequest,
  ledger: EncumbranceLedger<Q, S>,
  resource_liability: Measure<Q, S, Nat>,
  demand: FabricIdentity<NonEmptyStr, DemandKey>,
  evidence: FabricGrantEvidence,
  issued_at: Timestamp,
) -> CellGrant<Q, S> {
  let slot_key = selected_cell_allocation_key(offer: selected.candidate.offer)
  match workspace_slot_mutation_acquire(slot_key: slot_key, owner: (concat("grant-issue|", attempt.id.key as String)) as DurableHoldOwnerRef) {
    WorkspaceSlotMutationRefused { reason } => CellGrantAttemptRefused { slot_key: slot_key, detail: reason }
    WorkspaceSlotMutationAdmitted { lease } => {
      let result = grant_selected_cell_under_exclusion(
        root: root, slot_key: slot_key, work: work, attempt: attempt, selected: selected,
        account: account, money_request: money_request, ledger: ledger,
        resource_liability: resource_liability, demand: demand, evidence: evidence, issued_at: issued_at)
      if workspace_slot_mutation_release(lease: lease) { result }
      else { CellGrantAttemptRefused { slot_key: slot_key,
        detail: "grant operation returned but mutation exclusion is unsettled; observe the cell hold before recovery" } }
    }
  }
}

fn grant_selected_cell_under_exclusion<Q, S>(
  root: NonEmptyStr,
  slot_key: NonEmptyStr,
  work: Work<NonEmptyStr>,
  attempt: Attempt<NonEmptyStr>,
  selected: SelectedOffer<NonEmptyStr>,
  account: MoneyAccount,
  money_request: MoneyReservationRequest,
  ledger: EncumbranceLedger<Q, S>,
  resource_liability: Measure<Q, S, Nat>,
  demand: FabricIdentity<NonEmptyStr, DemandKey>,
  evidence: FabricGrantEvidence,
  issued_at: Timestamp,
) -> CellGrant<Q, S>
  admit_callers: [decl_ref(module_path: "gunbc.fabric.fabric_cell_grant", decl_name: "grant_selected_cell")]
{
  // The owner on this first plan is never written: it is replaced by the grant key below. It names
  // the attempt so a reader of a crash trace sees whose read this was.
  match file_hold_acquire_prepare(root: root, slot_key: slot_key, requested_owner: (concat("grant-issue|", attempt.id.key as String)) as DurableHoldOwnerRef) {
    FileHoldAcquireNotEligible { slot_key: _, refusal: r } => match r {
      HoldAcquireOccupied { generation: g, holder: h } => CellAlreadyGranted { slot_key: slot_key, holder: h, generation: g }
      HoldAcquireSlotUndecodable { generation: g, detail: d } => CellGrantSlotUndecodable { slot_key: slot_key, generation: g, detail: d }
      HoldAcquireObservationUnavailable { cause: c } =>
        CellGrantStoreUnavailable { slot_key: slot_key, cause: CasSlotObservationRefused { cause: c } }
    }
    FileHoldAcquirePlanned { plan: plan } => match file_hold_acquire_plan_landing(plan: plan) {
      CasSuccessorExhausted { head: h } => CellGrantGenerationsExhausted { slot_key: slot_key, head: h }
      CasSuccessorGeneration { generation: landing } => match issue_grant(
        work: work,
        attempt: attempt,
        selected: selected,
        outstanding: [],
        account: account,
        money_request: money_request,
        ledger: ledger,
        resource_reference: (slot_key as String) as ReservationRef,
        resource_liability: resource_liability,
        lease: cell_grant_lease(slot_key: slot_key, generation: landing),
        demand: demand,
        evidence: evidence,
        issued_at: issued_at,
      ) {
        GrantRefused { refusal: r } => CellGrantIssueRefused { slot_key: slot_key, refusal: r }
        GrantCommitted { grant: grant, account: a, ledger: l } =>
          match file_hold_acquire_commit(plan: file_hold_acquire_plan_for_owner(plan: plan, owner: cell_grant_owner(grant: grant))) {
            FileHoldAcquired { slot_key: _, owner: _, generation: g } =>
              if cas_generation_count(g: g) == cas_generation_count(g: landing) {
                CellGranted { grant: grant, account: a, ledger: l }
              } else {
                CellGrantAttemptRefused { slot_key: slot_key,
                  detail: "the hold landed on a generation other than the one its plan derived; the grant's lease does not name it" }
              }
            FileHoldOccupied { slot_key: _, holder: h, generation: g } => CellAlreadyGranted { slot_key: slot_key, holder: h, generation: g }
            FileHoldAcquireLost { slot_key: _ } => CellGrantLost { slot_key: slot_key }
            FileHoldAcquireStoreUnavailable { slot_key: _, cause: c } => CellGrantStoreUnavailable { slot_key: slot_key, cause: c }
            FileHoldSlotUndecodable { slot_key: _, generation: g, detail: d } => CellGrantSlotUndecodable { slot_key: slot_key, generation: g, detail: d }
            FileHoldKeyNotSlotAddressable { slot_key: _ } =>
              CellGrantAttemptRefused { slot_key: slot_key, detail: "allocation key is not slot-addressable" }
          }
      }
    }
  }
}

// THE RE-READ: IS THIS GRANT THE CELL'S CURRENT HOLD? Only CellGrantLive authorizes. Every other
// arm is a reason to start nothing, and they are separate because their remedies differ: a
// released or superseded grant is over and is not retried; an absent slot means the grant was
// never committed here at all (a grant authored outside this transition); an unreadable store says
// nothing about the grant.
type CellGrantStanding
  = CellGrantLive
  | CellGrantReleased { generation: CasGeneration, released_by: DurableHoldReleaseRef }
  | CellGrantSuperseded { holder: DurableHoldOwnerRef, generation: CasGeneration }
  | CellGrantNeverCommitted
  | CellGrantUnreadable { generation: CasGeneration, detail: NonEmptyStr }
  | CellGrantStoreUnobserved { cause: CasUnreadableSlot }

fn cell_grant_standing(root: NonEmptyStr, grant: ExecutionGrant<NonEmptyStr>) -> CellGrantStanding {
  match observe_file_hold(root: root, key: (grant.context.lease.lease_key as String) as NonEmptyStr) {
    HoldSlotAbsent => CellGrantNeverCommitted
    HoldSlotFree { generation: g, released_by: r } => CellGrantReleased { generation: g, released_by: r }
    HoldSlotHeld { generation: g, owner: o } =>
      if (o as String) == (cell_grant_owner(grant: grant) as String) && cas_generation_count(g: g) == grant.context.lease.generation {
        CellGrantLive
      } else {
        CellGrantSuperseded { holder: o, generation: g }
      }
    HoldSlotUndecodable { generation: g, detail: d } => CellGrantUnreadable { generation: g, detail: d }
    HoldObservationUnavailable { cause: c } => CellGrantStoreUnobserved { cause: c }
  }
}

// FCI-3'S RE-READ, FROM COORDINATES A LATER PROCESS ALREADY HOLDS. The executor that starts a
// guest runs in another process than the issuer and does not receive the grant record; it holds
// the Work, the attempt, the selected offer and the cell. The hold's owner is the grant key, a
// content digest over exactly those coordinates and the lease (product.fabric.grant_issue
// derive_grant_key), so the executor re-derives the key at the generation the slot reports and
// compares. Nothing the executor is handed can make a mismatch read as live:
// - grant removed (slot free or absent) -> CellGrantReadReleased / CellGrantReadAbsent;
// - grant corrupt or for another attempt, work or offer (owner is not this derivation) ->
//   CellGrantReadForeign;
// - grant expired (released and re-granted) -> CellGrantReadForeign at the later generation.
// Only CellGrantReadLive authorizes a target process, and it carries the generation the guest is
// bound to.
type CellGrantReread
  = CellGrantReadLive { generation: CasGeneration, grant: GrantKey }
  | CellGrantReadAbsent
  | CellGrantReadReleased { generation: CasGeneration, released_by: DurableHoldReleaseRef }
  | CellGrantReadForeign { holder: DurableHoldOwnerRef, generation: CasGeneration }
  | CellGrantReadUnreadable { generation: CasGeneration, detail: NonEmptyStr }
  | CellGrantReadStoreUnobserved { cause: CasUnreadableSlot }

fn reread_cell_grant(
  root: NonEmptyStr,
  slot_key: NonEmptyStr,
  work: FabricIdentity<NonEmptyStr, WorkKey>,
  attempt: FabricIdentity<NonEmptyStr, ExecutionAttemptKey>,
  offer: FabricIdentity<NonEmptyStr, OfferKey>,
) -> CellGrantReread {
  match observe_file_hold(root: root, key: slot_key) {
    HoldSlotAbsent => CellGrantReadAbsent
    HoldSlotFree { generation: g, released_by: r } => CellGrantReadReleased { generation: g, released_by: r }
    HoldSlotHeld { generation: g, owner: o } => {
      let key = derive_grant_key(work: work, attempt: attempt, offer: offer, lease: cell_grant_lease(slot_key: slot_key, generation: g))
      if (o as String) == (key as String) { CellGrantReadLive { generation: g, grant: key } }
      else { CellGrantReadForeign { holder: o, generation: g } }
    }
    HoldSlotUndecodable { generation: g, detail: d } => CellGrantReadUnreadable { generation: g, detail: d }
    HoldObservationUnavailable { cause: c } => CellGrantReadStoreUnobserved { cause: c }
  }
}
