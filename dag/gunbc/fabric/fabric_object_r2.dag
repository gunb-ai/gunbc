module gunbc.fabric.fabric_object_r2

import std.types { String, NonEmptyStr, FilePath }
import v2.std.optional { Present, Absent }
import std.durable_compare_and_set { CasGenerationPublicationRefused }
import std.fabric_storage {
  FabricObject, FabricObjectRef, FabricAddressedObject, fabric_object_addressed,
  fabric_object_preimage, fabric_object_ref_wire, fabric_object_decode, fabric_object_verified,
  FabricObjectVerified, FabricObjectVerificationFailed,
  FabricPut, FabricObjectStored, FabricPutRefused,
  FabricObjectGet, FabricObjectFetched, FabricObjectGetRefused,
  FabricStoreUnreachable, FabricStoreRefused, FabricObjectMissing, FabricReplyUndecodable,
}
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.shell
import gunbc.auth.access_token_source { AccessTokenSource }
import gunbc.cloudflare.r2_origin { BucketPurpose }
import gunbc.cloudflare.r2_staged_transfer {
  WriteCredentialCustody, WriteCredentialShredded,
  R2ObjectStored, R2ObjectAlreadyPresent, R2ObjectTagMoved, R2PutRefused, R2PutOutcomeUnknown,
  R2FetchStaged, R2FetchObjectAbsent, R2FetchStoreRefused, R2FetchTransportUnanswered, R2FetchLocalFailure,
  r2_release_staging, r2_put_staged_file, r2_fetch_into_staging,
}
import gunbc.fabric.fabric_blob_r2 {
  FabricBlobReadDirection, FabricBlobWriteDirection, FabricBlobTargetReady, FabricBlobTargetRefused, resolve_fabric_blob_target,
}

// std.fabric_storage OBJECTS OVER R2: THE OBJECT HALF THE R2 HEAD (gunbc.fabric_storage_r2_head) SAYS
// THE COMPOSED REALIZATION OWES. An object is stored as its canonical preimage
// (std.fabric_storage fabric_object_preimage, the one byte form every realization carries) under a
// key derived from its ref, create-only by the bucket purpose's admission. A get decodes the
// preimage and routes it through fabric_object_verified, so a store answering other bytes is
// corrupt, never trusted. The ref is the structural family std.fabric_storage mints, a LOCATOR and
// not a cryptographic identity (gunbc.recurring_failure_mode
// fabric_object_identity_is_a_structural_locator); this module inherits that standing and does not
// restate it as verification.
//
// AN OCCUPIED KEY IS STORED, NOT A CONFLICT, BECAUSE THE KEY IS THE OBJECT'S OWN REF: an occupant
// under that key holds bytes whose structural ref is this one, which is what the store promises; a
// reader still verifies. Unknown outcome refuses, so the caller reads before it advances a head.

data fabric_object_r2_prefix: NonEmptyStr = "objects/"

fn fabric_object_r2_key(object: FabricObjectRef) -> NonEmptyStr {
  concat(fabric_object_r2_prefix as String, fabric_object_ref_wire(object: object) as String) as NonEmptyStr
}

type FabricObjectR2Put {
  put: FabricPut
  credential: WriteCredentialCustody
}

fn fabric_object_r2_unput(cause: NonEmptyStr) -> FabricObjectR2Put {
  FabricObjectR2Put { put: FabricPutRefused { fault: FabricStoreRefused { cause: CasGenerationPublicationRefused { detail: cause } } }, credential: WriteCredentialShredded }
}

fn put_fabric_object_r2(object: FabricObject, purpose: BucketPurpose, token_source: AccessTokenSource) -> FabricObjectR2Put {
  let addressed = fabric_object_addressed(object: object)
  match resolve_fabric_blob_target(direction: FabricBlobWriteDirection, key: fabric_object_r2_key(object: addressed.ref), purpose: purpose) {
    FabricBlobTargetRefused { cause: c } => fabric_object_r2_unput(cause: c)
    FabricBlobTargetReady { target: target } => {
      let staging = shell.Mktemp.Dir()
      if staging.success == false {
        fabric_object_r2_unput(cause: "no private directory could be minted to stage the object; nothing was put")
      } else {
        let path = join([staging.path as String, "/object"], "")
        let w = Filesystem.Write(path: path, content: fabric_object_preimage(object: object) as String)
        if w.success == false {
          fabric_object_r2_unput(cause: concat("the object could not be staged: ", w.error) as NonEmptyStr)
        } else {
          let put = r2_put_staged_file(target: target, local_path: path as FilePath, token_source: token_source)
          let removed = shell.Remove.RecursiveForce(path: staging.path)
          FabricObjectR2Put {
            put: match put.verdict {
              R2ObjectStored { tag: _ } => FabricObjectStored { object: addressed.ref }
              R2ObjectAlreadyPresent => FabricObjectStored { object: addressed.ref }
              R2ObjectTagMoved => FabricPutRefused { fault: FabricStoreRefused { cause: CasGenerationPublicationRefused { detail: "the store answered an If-Match failure to a create-only object put" } } }
              R2PutRefused { cause: c } => FabricPutRefused { fault: FabricStoreRefused { cause: CasGenerationPublicationRefused { detail: c } } }
              R2PutOutcomeUnknown { cause: c } => FabricPutRefused { fault: FabricStoreUnreachable { detail: c } }
            },
            credential: put.credential,
          }
        }
      }
    }
  }
}

fn get_fabric_object_r2(object: FabricObjectRef, purpose: BucketPurpose, token_source: AccessTokenSource) -> FabricObjectGet {
  match resolve_fabric_blob_target(direction: FabricBlobReadDirection, key: fabric_object_r2_key(object: object), purpose: purpose) {
    FabricBlobTargetRefused { cause: c } => FabricObjectGetRefused { fault: FabricStoreRefused { cause: CasGenerationPublicationRefused { detail: c } } }
    FabricBlobTargetReady { target: target } =>
      match r2_fetch_into_staging(target: target, token_source: token_source) {
        R2FetchObjectAbsent { staging: _ } => FabricObjectGetRefused { fault: FabricObjectMissing { object: object } }
        R2FetchStoreRefused { cause: c, staging: _ } => FabricObjectGetRefused { fault: FabricStoreRefused { cause: CasGenerationPublicationRefused { detail: c } } }
        R2FetchTransportUnanswered { cause: c, staging: _ } => FabricObjectGetRefused { fault: FabricStoreUnreachable { detail: c } }
        R2FetchLocalFailure { cause: c, staging: _ } => FabricObjectGetRefused { fault: FabricStoreUnreachable { detail: concat("the object could not be staged locally: ", c as String) as NonEmptyStr } }
        R2FetchStaged { staged_path: p, staging_dir: d, tag: _ } => {
          let read = Filesystem.Read(path: p as String)
          let released = r2_release_staging(dir: d)
          if read.success == false {
            FabricObjectGetRefused { fault: FabricStoreUnreachable { detail: concat("the staged object could not be read: ", p as String) as NonEmptyStr } }
          } else {
            match fabric_object_decode(preimage: read.content) {
              Absent => FabricObjectGetRefused { fault: FabricReplyUndecodable { detail: concat("the stored bytes are not a fabric object preimage: ", fabric_object_ref_wire(object: object) as String) as NonEmptyStr } }
              Present { value: content } =>
                match fabric_object_verified(asked: object, content: content) {
                  FabricObjectVerificationFailed { fault: f } => FabricObjectGetRefused { fault: f }
                  FabricObjectVerified { stored: st } => FabricObjectFetched { stored: st }
                }
            }
          }
        }
      }
  }
}
