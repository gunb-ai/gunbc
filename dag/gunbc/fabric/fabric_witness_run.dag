// THE EXACT BUILD-LANE WORK, NOT ANOTHER CI COMMAND.
//
// The old floor model stopped at floor_work_contract(source: SourceManifestRef): its caller could
// label any string a source manifest, and the checkout, environment, cache posture, credentials,
// executable provenance and terminal outputs lived only in the Actions realization. That was enough
// to price a hypothetical floor shape and not enough to answer what the fabric would run. The
// carrier below closes only that question. It projects every execution-defining coordinate into the
// existing product.fabric.work WorkContract, then uses work_for; WorkKey remains the one core identity
// and no Grant, executor, cell or process-start surface is introduced here.
//
// Git commit and tree are separate GitObjectIds because they answer different questions: the commit
// pins provenance/history while the verified tree pins bytes. A branch or working directory stays
// representable at the input boundary so construction can return a typed refusal; it has no route to
// Work. Lists are checked non-empty before hashing, so [] cannot become a plausible empty manifest.
type RequiredBuildSource
  = ExactGitSource { commit: GitObjectId, verified_tree: GitObjectId, verification_receipt: NonEmptyStr }
  | MovingGitRef { ref_name: NonEmptyStr }
  | WorkingDirectorySource { path: NonEmptyStr }

type RequiredBuildEnvironmentEntry { name: NonEmptyStr, value: NonEmptyStr }

type RequiredBuildExecutionSpec {
  source: RequiredBuildSource
  checkout_materialization: List<NonEmptyStr>
  toolchain_provenance: List<NonEmptyStr>
  executable_provenance: List<NonEmptyStr>
  command: ArgvCommand
  environment: List<RequiredBuildEnvironmentEntry>
  cache_policy: List<NonEmptyStr>
  permitted_credential_refs: List<NonEmptyStr>
  output_manifest: List<NonEmptyStr>
  terminal_result_manifest: List<NonEmptyStr>
}

type RequiredBuildWorkRefusal
  = RequiredBuildMovingRefRefused { ref_name: NonEmptyStr }
  | RequiredBuildWorkingDirectoryRefused { path: NonEmptyStr }
  | RequiredBuildCoordinateMissing { coordinate: NonEmptyStr }

type RequiredBuildWorkBinding
  = RequiredBuildWorkBound {
      work: Work<NonEmptyStr>
      source_tree_digest: ContentHash
      environment_materialization_digest: ContentHash
    }
  | RequiredBuildWorkRefused { cause: RequiredBuildWorkRefusal }

type RequiredBuildFrozenIdentities {
  work_key: WorkKey
  source_tree_digest: ContentHash
  environment_materialization_digest: ContentHash
}

type RequiredBuildFrozenIdentityProjection
  = RequiredBuildFrozenIdentitiesProjected { identities: RequiredBuildFrozenIdentities }
  | RequiredBuildFrozenIdentitiesRefused { cause: RequiredBuildWorkRefusal }

// Canonical sequence encoding. Delimiters alone are not an encoding: ["a", "b"] and
// ["a<delimiter>b"] collapse. Every scalar is length-prefixed and every sequence carries its
// cardinality, so arbitrary payload code points cannot move a boundary.
fn framed_string(value: String) -> NonEmptyStr {
  concat(to_string(value.length()), concat(":", value))
}

fn non_empty_strings_material(label: NonEmptyStr, values: List<NonEmptyStr>) -> NonEmptyStr? {
  match values {
    Empty {} => none
    Cons { head: _, tail: _ } => Present {
      value: fold(
        values,
        init: concat(label, concat(":", concat(to_string(values.length()), ":"))),
        f: fn(acc, value) { concat(acc, framed_string(value: value)) },
      )
    }
  }
}

fn environment_material(entries: List<RequiredBuildEnvironmentEntry>) -> NonEmptyStr? {
  match entries {
    Empty {} => none
    Cons { head: _, tail: _ } => Present { value: fold(
      entries,
      init: concat("environment:", concat(to_string(entries.length()), ":")),
      f: fn(acc, entry) { concat(acc, concat(framed_string(value: entry.name), framed_string(value: entry.value))) },
    ) }
  }
}

fn command_material(command: ArgvCommand) -> NonEmptyStr {
  let words = argv_words(command: command)
  fold(
    words,
    init: concat("argv:", concat(to_string(words.length()), ":")),
    f: fn(acc, word) { concat(acc, framed_string(value: word)) },
  )
}

fn action_ref_material(action: ActionRef) -> NonEmptyStr {
  concat("action:", concat(framed_string(value: action.owner), concat(framed_string(value: action.repo), framed_string(value: action.ref))))
}

fn required_build_contract_from_materials(
  source: NonEmptyStr,
  checkout: NonEmptyStr,
  toolchain: NonEmptyStr,
  executable: NonEmptyStr,
  command: NonEmptyStr,
  environment: NonEmptyStr,
  cache: NonEmptyStr,
  credentials: NonEmptyStr,
  outputs: NonEmptyStr,
  terminal: NonEmptyStr,
) -> WorkContract {
  WorkContract {
    program: concat("gunbc.required-witnesses-build.program:", framed_string(value: command)),
    steps: [
      WorkStep { step_id: "checkout-materialize", resumability: ReceiptSatisfiable },
      WorkStep { step_id: "toolchain-and-executable-materialize", resumability: ReceiptSatisfiable },
      WorkStep { step_id: "required-witnesses-build", resumability: ReceiptSatisfiable },
    ],
    source: concat("gunbc.required-witnesses-build.source:", concat(framed_string(value: source), framed_string(value: checkout))),
    inputs: concat("gunbc.required-witnesses-build.inputs:", concat(framed_string(value: environment), concat(framed_string(value: cache), framed_string(value: credentials)))),
    runtime_closure: concat("gunbc.required-witnesses-build.runtime:", concat(framed_string(value: toolchain), framed_string(value: executable))),
    effect_contract: "gunbc.required-witnesses-build.effects.checkout-read-cache-and-permitted-credentials-only",
    output_contract: concat("gunbc.required-witnesses-build.outputs:", concat(framed_string(value: outputs), framed_string(value: terminal))),
  }
}

fn bind_required_witnesses_build_work(
  principal: NonEmptyStr,
  spec: RequiredBuildExecutionSpec,
) -> RequiredBuildWorkBinding {
  match spec.source {
    MovingGitRef { ref_name } => RequiredBuildWorkRefused { cause: RequiredBuildMovingRefRefused { ref_name: ref_name } }
    WorkingDirectorySource { path } => RequiredBuildWorkRefused { cause: RequiredBuildWorkingDirectoryRefused { path: path } }
    ExactGitSource { commit, verified_tree, verification_receipt } =>
      match non_empty_strings_material(label: "checkout", values: spec.checkout_materialization) {
        Absent => RequiredBuildWorkRefused { cause: RequiredBuildCoordinateMissing { coordinate: "checkout-materialization" } }
        Present { value: checkout } => match non_empty_strings_material(label: "toolchain", values: spec.toolchain_provenance) {
          Absent => RequiredBuildWorkRefused { cause: RequiredBuildCoordinateMissing { coordinate: "toolchain-provenance" } }
          Present { value: toolchain } => match non_empty_strings_material(label: "executable", values: spec.executable_provenance) {
            Absent => RequiredBuildWorkRefused { cause: RequiredBuildCoordinateMissing { coordinate: "executable-provenance" } }
            Present { value: executable } => match environment_material(entries: spec.environment) {
              Absent => RequiredBuildWorkRefused { cause: RequiredBuildCoordinateMissing { coordinate: "environment" } }
              Present { value: environment } => match non_empty_strings_material(label: "cache", values: spec.cache_policy) {
                Absent => RequiredBuildWorkRefused { cause: RequiredBuildCoordinateMissing { coordinate: "cache-policy" } }
                Present { value: cache } => match non_empty_strings_material(label: "credentials", values: spec.permitted_credential_refs) {
                  Absent => RequiredBuildWorkRefused { cause: RequiredBuildCoordinateMissing { coordinate: "permitted-credential-refs" } }
                  Present { value: credentials } => match non_empty_strings_material(label: "outputs", values: spec.output_manifest) {
                    Absent => RequiredBuildWorkRefused { cause: RequiredBuildCoordinateMissing { coordinate: "output-manifest" } }
                    Present { value: outputs } => match non_empty_strings_material(label: "terminal", values: spec.terminal_result_manifest) {
                      Absent => RequiredBuildWorkRefused { cause: RequiredBuildCoordinateMissing { coordinate: "terminal-result-manifest" } }
                      Present { value: terminal } => {
                        let source = concat("git-source:", concat(framed_string(value: git_object_id_wire_hex(oid: commit)), concat(framed_string(value: git_object_id_wire_hex(oid: verified_tree)), framed_string(value: verification_receipt))))
                        let command = command_material(command: spec.command)
                        let contract = required_build_contract_from_materials(source: source, checkout: checkout, toolchain: toolchain, executable: executable, command: command, environment: environment, cache: cache, credentials: credentials, outputs: outputs, terminal: terminal)
                        let requirements = floor_execution_requirements()
                        let work = work_for(principal: principal, contract: contract, requirements: requirements)
                        RequiredBuildWorkBound {
                          work: work,
                          source_tree_digest: git_object_id_content_hash(oid: verified_tree),
                          environment_materialization_digest: content_hash_of_value(value: concat("environment-materialization:", concat(framed_string(value: checkout), concat(framed_string(value: toolchain), concat(framed_string(value: executable), concat(framed_string(value: environment), concat(framed_string(value: cache), framed_string(value: credentials)))))))),
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
  }
}

// THE POSSESSED WORK FOR THE ONE TARGET LANE. Source identity is an input from the PR checkout
// verifier, never a historical literal transcribed into production. The checkout, bootstrap, build
// and run facts mirror the authorities the current Actions realization consumes; this value does
// not make Actions execute through the fabric. FCI-3 owns that later authority cut.
fn required_witnesses_build_work(source: RequiredBuildSource) -> RequiredBuildWorkBinding {
  bind_required_witnesses_build_work(
    principal: "gunbc",
    spec: RequiredBuildExecutionSpec {
          source: source,
          checkout_materialization: [action_ref_material(action: checkout_action), "fetch-depth=0", ci_toolchain_home_isolation_script()],
          toolchain_provenance: [action_ref_material(action: setup_rust_action), "rust-toolchain.toml:1.93.0+clippy+rustfmt", ci_pin_rustup_default_script()],
          executable_provenance: [repo_self_build_all_bins_command(), "target/release/claim_executor"],
          command: build_lane_run_command(),
          environment: [
            RequiredBuildEnvironmentEntry { name: "HOME", value: "derived-from-RUNNER_TEMP" },
            RequiredBuildEnvironmentEntry { name: "CARGO_HOME", value: "derived-from-RUNNER_TEMP/cargo" },
            RequiredBuildEnvironmentEntry { name: "RUSTUP_HOME", value: "derived-from-RUNNER_TEMP/rustup" },
          ],
          cache_policy: ["setup-rust-cache=false", "delete-and-recreate-RUNNER_TEMP/rustup-and-cargo", "step-reuse-permitted"],
          permitted_credential_refs: ["github.actions.checkout-token"],
          output_manifest: ["required-ci-phase-ledger", "required-build-lane-log"],
          terminal_result_manifest: ["required-ci-exit-status", "required-ci-terminal-summary"],
    },
  )
}

fn required_witnesses_build_frozen_identities(source: RequiredBuildSource) -> RequiredBuildFrozenIdentityProjection {
  match required_witnesses_build_work(source: source) {
    RequiredBuildWorkRefused { cause } => RequiredBuildFrozenIdentitiesRefused { cause: cause }
    RequiredBuildWorkBound { work, source_tree_digest, environment_materialization_digest } =>
      RequiredBuildFrozenIdentitiesProjected {
        identities: RequiredBuildFrozenIdentities {
          work_key: work.id.key,
          source_tree_digest: source_tree_digest,
          environment_materialization_digest: environment_materialization_digest,
        }
      }
  }
}

// The handoff instrument for the next serial gate. It renders only identities, never secret
// material or environment values; a refused construction stays visibly refused.
fn required_witnesses_build_frozen_identity_wire(
  commit_hex: NonEmptyStr,
  tree_hex: NonEmptyStr,
  verification_receipt: NonEmptyStr,
) -> String {
  let projection = match git_sha1_object_id(hex: commit_hex) {
    Absent => RequiredBuildFrozenIdentitiesRefused { cause: RequiredBuildCoordinateMissing { coordinate: "source-commit" } }
    Present { value: commit } => match git_sha1_object_id(hex: tree_hex) {
      Absent => RequiredBuildFrozenIdentitiesRefused { cause: RequiredBuildCoordinateMissing { coordinate: "verified-source-tree" } }
      Present { value: tree } => required_witnesses_build_frozen_identities(
        source: ExactGitSource { commit: commit, verified_tree: tree, verification_receipt: verification_receipt },
      )
    }
  }
  match projection {
    RequiredBuildFrozenIdentitiesRefused { cause: _ } => "refused"
    RequiredBuildFrozenIdentitiesProjected { identities } => join([
      concat("work_key=", identities.work_key),
      concat("source_tree_digest=", serialize_content_hash(hash: identities.source_tree_digest)),
      concat("environment_materialization_digest=", serialize_content_hash(hash: identities.environment_materialization_digest)),
    ], "\n")
  }
}

// THE FLOOR'S PROGRAM AND CONTRACTS. NOTHING ELSE.
//
// This module used to own authorize_floor_run and a FloorRunRefusal coproduct.
// Both moved to product.fabric.supply, because comparing a Work's requirements
// against a SupplierOffer's capabilities is provider-neutral fungibility and nothing in
// ShapeNotCovered / TrustDomainMismatch / CapabilitiesNotOffered was ever about
// the floor. A gunbc module answering a fabric question is a gunbc module that
// will answer it differently from the next consumer.
//
// THE FABRIC DEFINES THE WITNESS RUN. IT DOES NOT YET RUN IT.
//
// THIS PARAGRAPH PREVIOUSLY CLAIMED THE OPPOSITE AND THE CLAIM WAS FALSE. It read
// that the argv is "PRODUCED BY THE FABRIC UNDER A GRANT" and that "no grant, no
// command -- so the authorization is not a label beside the run, it is the only
// thing that can yield a run". Measured against the live tree: the run command
// is a lane word away from NULLARY, there is no grant anywhere on the workflow path, and of the ten
// functions in this module exactly ONE has a production consumer outside it --
// this one (`required_ci_lane_command`, through its two lane bindings), imported by
// gunbc.witness_floor_workflow to render a shell word.
// Work contract, execution requirements, offer fungibility, affordability, buy
// terms, admission terms, satisfaction requirement and grant duration have ZERO.
//
// So the sentence described a wall that does not exist, in the module that IS this
// repository's claim to running its own CI on the fabric. That is rung inflation
// (DESIGN section 4b), and it is worse than sitting low: a class reported at the
// top rung never ranks for climbing, and a reader planning the cutover against
// this paragraph would have budgeted for extending an allocator that was never
// built. It cost exactly that once already -- answering "where is the fabric in
// our CI" required measuring past this prose rather than reading it.
//
// WHAT IS TRUE: the command is DEFINED BY THE FABRIC WORK AUTHORITY and CURRENTLY
// TRANSPORTED BY GITHUB ACTIONS. GitHub owns triggering, queueing, runner
// selection, concurrency, execution lifecycle, logs and check publication. The
// fabric owns what the Work IS.
//
// AND THE WALL BELONGS SOMEWHERE ELSE THAN WHERE THAT SENTENCE PUT IT, which is
// the more useful half of the correction. A Grant authorizes REALIZATION OF AN
// ATTEMPT, not construction of a command value. Inspecting, hashing, comparing,
// caching or rendering a command spends no resource; executing it does. So the
// invariant to build toward is:
//
//     no committed Grant  ->  no process and no host effect
//
// NOT "no grant, no command". Threading a Grant into this constructor would fuse
// semantic Work identity with scheduling authority and make one Work compare
// unequal to itself depending on whose Grant it ran under -- a defect, not a
// stricter version of the same idea. NEXT-RUNG TRIGGER: an executor that holds an
// ExecutionGrant against a reserved slot, at which point the invariant above
// becomes structural and this paragraph is rewritten as an ordinary description.
//
// What is deliberately NOT here, because GitHub Actions still supplies it while
// it still triggers: polling, durable state, the compare-and-swap authority
// transition, supersession, and check publication. Those are the CONTROL plane
// and they are only needed once the fabric owns triggering. Attempting them now
// would build a second scheduler beside a live one.

// The floor's contract. Every field is a fact about WHAT is promised, never
// about where or when it runs -- scheduling facts live in ExecutionRequirements
// beside it, so revising a thread estimate cannot mint a new semantic Work.
//
// ONE STEP, THREE PHASES (2026-08-20; phase list narrowed 2026-08-21). This read "Two steps, not one, because the
// workflow gates them separately and the v1 parse gate is a blocking step in its
// own right: collapsing them into one step would make a parse failure and a floor
// failure indistinguishable in the receipt, which is the distinction
// gunbc#8466 -> #8519 was paid to learn."
//
// THE CONCERN WAS RIGHT AND IS NOW BETTER SERVED, which is why the row changed
// rather than the concern being dropped. The workflow no longer gates the phases
// separately -- the operator directed that the sequencing move out of the GitHub
// Actions step list and into the binary -- so a contract listing two steps is a
// SECOND, now-false description of a job shape that has one. What made the two
// steps worth having was the receipt's ability to say WHICH part failed, and that
// distinction survives at a finer grain: `--required-ci` reports its phases and
// prints `FAILED PHASE <name>` per failure, so parse, regen and floor are three
// distinguishable outcomes where there were two. Measured on the first CI run of
// the composed step (32347573121), which reported `phases_run=4 failed=2` and
// named both -- a regen drift AND a floor failure -- where a step ladder would
// have surfaced them one merge at a time. That measurement is quoted at its own
// date: the run had four phases because the 2026-08-21 operator ruling had not
// yet cut the roster to three (merge-admission-capture, regen-determinism,
// receipt-selftest, receipt-vs-changed-authorities and merge-admission-stamp are
// gone from the required mode). The property it establishes -- per-phase
// attribution in one receipt -- is unchanged by the count.
//
// WHAT THIS DOES COST, stated rather than glossed: resumability was per-step, so
// a green parse could previously be receipt-satisfied and skipped on a rerun.
// One step means one receipt and the whole run repeats. That is a real
// consequence of the consolidation, not an oversight, and the phase-grain
// resumability that would restore it belongs with the cost basis rather than
// here.
fn floor_work_contract(source: SourceManifestRef) -> WorkContract {
  WorkContract {
    program: "gunbc.claim_executor",
    steps: [
      WorkStep { step_id: "required-ci", resumability: ReceiptSatisfiable },
    ],
    source: source,
    inputs: floor_inputs_manifest_ref(),
    runtime_closure: "gunbc.toolchain.rust-1.93.0+clippy+rustfmt",
    effect_contract: "gunbc.floor.effects.read-only-corpus",
    output_contract: "gunbc.floor.outputs.required-floor-summary",
  }
}

// OUR FLOOR IS arm64. THE CLASS IS NOT.
//
// This function previously spelled the architecture INSIDE a capability tag --
// "gunbc.capabilities.linux-aarch64-rust-toolchain" -- which made an accident of
// our own supply look like a property of the execution class. Ampere is what we
// happen to stock; the product must serve x86 and arm at the lowest cost, and
// rented x86 is a supplier we now anticipate. A class that names its
// architecture cannot admit one it did not, which is the GitHub-vocabulary
// argument one layer over.
//
// The capability tag below therefore names the toolchain and NOT the machine.
// That our floor happens to be arm64 is a fact about our fleet's supply, not a
// property of the class -- see the note below for why it is not yet a value.
//
// WHY NO Architecture VALUE IS DECLARED HERE YET, and the receipt for it.
// Matching a declared architecture against an offer's requires the OFFER to
// carry one, and SupplierOffer has 25 constructors in tree, so the field and the arm
// that reads it land together. An earlier revision of this module declared
// `floor_architecture() -> Architecture = Aarch64` anyway, with a comment
// explaining that the consuming arm would come later. It had ZERO consumers,
// and v2.lens.inert_carrier caught it on CI as an unrostered inert carrier --
// in the same commit whose message refused to add an unread field to SupplierOffer by
// citing review 53848's declared-but-nothing-derives-it defect. Refusing the
// defect on one side of a module boundary and authoring it on the other is the
// same defect, and the lens was a better reader of that than I was.
//
// So the architecture decision lives in prose and in the recut plan until it has
// a consumer. That is the honest state: a decision recorded is not a carrier
// modeled, and minting the carrier early buys nothing except a row that lies
// about being load-bearing.

// WHAT A FLOOR RUN REQUIRES OF ITS EXECUTOR, AND WHY THAT IS HONESTLY NOTHING.
//
// A floor run is OUR OWN work on OUR OWN fleet, and it demonstrably runs today on slots that
// provide none of the isolation guarantees -- a reused writable root by design, the host's process
// namespace, and /home/ghrunner shared across every slot. Declaring a requirement the floor does
// not actually have would be inventing a gap: the run would be modeled as ineligible for the
// executor it has been green on for months, and the first person to trust the model would go
// looking for a break that is not there.
//
// SO THE EMPTY PROFILE HERE IS A MEASUREMENT, NOT A PLACEHOLDER. It says the floor asks for no
// tenancy guarantee, which is true and is exactly why the floor was safe to run this way. The gap
// this model exists to express belongs to CUSTOMER work, where the tenant is not us -- see
// product.fabric.isolation tenant_workload_isolation_requirement and the witness that measures
// today's slots against it.
//
// CONSUMPTION STATUS, STATED PLAINLY BECAUSE THIS MODULE'S OWN HEADER INSISTS ON IT: the fold that
// reads this (floor_offer_fungibility -> offer_fungibility_for) has NO production consumer, exactly
// as its siblings ShapeNotCovered and CapabilitiesNotOffered do not. This is the modeled decision
// the broker will consume, not a live wall, and calling it enforcement would be the rung inflation
// the paragraph above already records for affordability. NEXT-RUNG TRIGGER is the same one: a
// broker fold that selects an Offer for this Demand.
fn floor_isolation_requirement() -> IsolationProfile {
  IsolationProfile { guarantees: [] }
}

// THE FLOOR IS CONTROL-PLANE WORK AND SAYS SO. This is the demand the capacity
// class exists to protect: our own scheduler, reconciliation, admission and
// receipt work, which must never be satisfied by capacity sanctioned for
// customer execution. Declared on the side we ORIGINATE, so no supplier can
// author it and the refusal is decided at admission rather than after ranking.
fn floor_execution_requirements() -> ExecutionRequirements {
  ExecutionRequirements {
    capacity_class: ControlPlaneCapacity,
    shape: Shape {
      hard: HardRequirements { threads: hardware_thread_count(count: 8) },
      envelope: unstated_envelope(),
    },
    capabilities: "gunbc.capabilities.linux-rust-toolchain",
    trust_domain: "gunbc.trust.internal-fleet",
    isolation: floor_isolation_requirement(),
  }
}

// THE SOURCE ROOTS ARE NOT THIS MODULE'S FACT. gunbc.ci_layer_roots
// witness_layer_roots is the existing authority -- the live workflow already
// folds it into its --source-root flags -- so declaring a list here was a fork
// of it, which is the violation one level above the one review 53848 caught.
// Consumed, not redeclared.
//
// The argv is a TOTAL fold over that authority, so adding a root changes the
// command with nothing to remember. An earlier revision of this module hand-
// expanded the pairs and declared a substrate gap with a dissolution trigger,
// on the grounds that expanding one element into two needs a flat-map and the
// substrate has neither flatten nor list destructuring. Both observations were
// true and the conclusion was wrong: `fold` exists and is exactly the primitive
// required -- the workflow module two files away was already using it for this
// same job. I declared a language-layer gap without enumerating the language,
// which is the failure my own notes name as searching by remembered name rather
// than reading the authority surface.

fn floor_inputs_manifest_ref() -> ArtifactManifestRef {
  concat("gunbc.floor.inputs.source-roots:", join(witness_layer_roots, "+"))
}
// ONE COMMAND SHAPE, TWO LANES (operator ruling, 2026-08-25: "we can add it as a parallel
// job in github actions - we can do the same for regen now, we have more runners" /
// "basically i would put regen + v2 full compile in one job, and witnesses into another
// one").
//
// The required run's phases were composed into one process on 2026-08-20 and were therefore
// SERIAL. They are also independent, which is the expensive combination: the witness floor
// costs ~30 minutes and everything else waited behind it for no reason any data dependency
// names, so the required check's wall clock was a SUM of things that could have been a MAX.
// Two jobs with no `needs` edge make it a max.
//
// THE LANE IS THE ONLY THING THE TRANSPORT NAMES. It does not name phases, order them, or
// wire one phase's precondition to another step's verdict -- which phases a lane owns is
// decided in the binary, by an exhaustive match, so re-routing the roster is a change there
// and never an edit to a YAML step list. That is the surviving half of the 2026-08-20
// consolidation directive; the half the split supersedes is stated in
// `gunbc.witness_floor_workflow`, beside the jobs it is about.
//
// WHY THIS PARTITION AND NOT ANOTHER. `build` is the EMISSION lane -- regen compares the
// emitted stage0 mirrors against what is committed, and v2-emission compiles a v2 entry to
// Rust; both ask "does the compiler still produce its outputs". `witnesses` is the CORPUS
// lane -- the parse sweep and the floor fold, both asking "does the authored corpus hold".
// The split is along the subject, not along a stopwatch, which is why it stays legible when
// the costs move.
//
// A SINGLE ARGV, NOT TWO. Two hand-built invocations would be two spellings of the binary
// path, the mode flag and the source roots, free to drift silently in exactly the way #8629
// removed once already; the lane is a parameter of one command rather than a second command.
fn required_ci_lane_command(lane: String) -> ArgvCommand {
  claim_executor_command(
    mode_flag: "--required-ci",
    operands: append(
      fold(
        witness_layer_roots,
        init: [],
        f: fn(acc, root) { append(acc, items: ["--source-root", root]) },
      ),
      items: ["--required-lane", lane],
    ),
  )
}

data required_ci_lane_build: String = "build"

data required_ci_lane_witnesses: String = "witnesses"

// The witnesses lane: the .dag parse sweep and the witness floor fold. Named for its lane
// rather than for the floor alone, because the parse phase rides here too and a name that
// said `floor` would be a second, narrower account of what this command runs.
fn witnesses_lane_run_command() -> ArgvCommand {
  required_ci_lane_command(lane: required_ci_lane_witnesses)
}

// The build lane: regen's first-generation comparison and the v2 emission compile.
fn build_lane_run_command() -> ArgvCommand {
  required_ci_lane_command(lane: required_ci_lane_build)
}

// THE FLOOR IS MODELED AS AN ORDINARY PRICED DEMAND. NO PRICE IS CLEARED TODAY.
//
// The design intent is real and unchanged: gunbc's own CI should enter the market
// on the same terms as any other demand, so that the opportunity cost of running
// our own work stays a computable quantity and the arbitrage -- run our CI on our
// hardware, or sell that capacity and rent -- does not degrade into a
// hand-maintained spreadsheet. This fold takes the budget ceiling as an argument
// for exactly that reason.
//
// WHAT WAS OVERSTATED, corrected in the same pass as the paragraph above: this
// previously read that the ceiling is an argument "precisely so that there is no
// arm here that admits a floor run without clearing a price", present tense, as
// though the guard were live. It is not reachable. `floor_offer_affordability` and
// `floor_buy_terms` have NO production consumer -- the only function in this module
// that any non-test module calls is `required_ci_lane_command` -- so no floor run has ever
// cleared a price, and no arm could have admitted one without doing so, because no
// arm runs at all. A fold with no caller cannot enforce anything, and describing it
// as enforcement is the same inflation this file's header paragraph now records.
//
// The fold stays: it is the modeled decision the broker will consume, and deleting
// it would be deleting the design rather than the overstatement. What changes is
// that it is described as UNCONSUMED, so its status is a countable gap instead of
// an assumed guarantee. NEXT-RUNG TRIGGER: a broker fold that selects a SupplierOffer for
// this Demand, at which point affordability is on the live path and this row
// becomes an ordinary description of a check that runs.
//
// Control-plane work is a separately privileged class. That exclusion must not
// leak here: a floor run is customer work that happens to be ours.

fn floor_offer_fungibility<P>(offer: SupplierOffer<P>) -> OfferFungibility {
  offer_fungibility_for(requirements: floor_execution_requirements(), offer: offer)
}

// THE FLOOR'S GRANT DURATION IS AN ESTIMATE, NOT A MEASUREMENT. `~30 min wall`
// is the wall-clock this document's own "Building & checks" section records
// for the three consecutive green `--required-ci` runs on main (32203661157
// and neighbors) -- a measured receipt, not a guess -- but it is still an
// ESTIMATE of what THIS run will take, not the exact duration of a run that
// has not happened yet. Spelling it as EstimatedGrantDuration rather than
// ExactGrantDuration is therefore not caution for its own sake: it is the
// only honest constructor available, and it is what lets a rate-quoted offer
// land on AffordableUnderEstimate instead of silently borrowing the
// certainty ExactGrantDuration would claim.
fn floor_grant_duration() -> GrantDuration {
  EstimatedGrantDuration { seconds: second(count: 1800) }
}

fn floor_offer_affordability<P>(
  offer: SupplierOffer<P>,
  maximum_buy_order: MoneyAmountMicro,
  budget_currency: CurrencyCode,
) -> DemandOfferAffordability {
  offer_affordability_for(
    offer: offer,
    maximum_buy_order: maximum_buy_order,
    budget_currency: budget_currency,
    duration: floor_grant_duration(),
  )
}

// THE FLOOR'S DEMAND. This is where "ordinary priced demand" stops being a
// property of a fold's signature and becomes a row someone can read.
//
// REUSE IS A POLICY ON THE DEMAND, NOT A PROPERTY OF THE WORK. The cutover runs
// with terminal_receipt_may_satisfy = false and new_attempt_required = true, so
// an identical Work that already has an accepted receipt still executes. That
// is deliberately conservative -- it preserves today's Actions behaviour while
// the purity of the floor as a function of the tree is unproven -- and it is
// expressed HERE rather than in the Work key, because turning reuse on later
// must edit a policy row and not edit what a Work IS. The two were conflated in
// the plan's own section 13 and in the sign-off that answered it; the carriers
// never conflated them, which is why this needed no new modeling.
//
// step_reuse_permitted stays TRUE: a materialization provider may still
// accelerate a rerun. That is not the same claim as "the step completed" -- a
// build cache making the second attempt faster is not a receipt.

fn floor_satisfaction_requirement() -> SatisfactionRequirement {
  SatisfactionRequirement {
    terminal_receipt_may_satisfy: false,
    new_attempt_required: true,
    step_reuse_permitted: true,
  }
}

fn floor_buy_terms(
  account: BudgetAccountId,
  reservation_price: MoneyAmountMicro,
  maximum_buy_order: MoneyAmountMicro,
) -> BuyTerms {
  BuyTerms {
    budget_account: account,
    currency: Usd,
    reservation_price: reservation_price,
    maximum_buy_order: maximum_buy_order,
  }
}

// THE FLOOR HAS NO PRIVILEGE FIELD BECAUSE THERE IS NO LONGER A FIELD TO HAVE.
//
// This note used to read that priority_class is not a privilege escape -- that
// the floor competes on price like any other demand, and that a class orders
// demands that can all be afforded rather than admitting one that cannot. The
// claim was correct and it was prose: the field was a String, so nothing
// enforced it and a witness beside it could only assert the string's spelling.
//
// The field is deleted (product.fabric.demand records why) and the ordering it
// gestured at is derived by product.fabric.contention from the margin between
// what a buyer will pay and what serving them costs. So the floor's terms carry
// no rank at all, and there is no spelling in which gunbc jumps the queue: to
// win contention the floor must post the better margin, which is the same test
// every other buyer takes. That is the standing claim made structural rather
// than asserted -- if this ever became the field that let gunbc jump the queue,
// the arbitrage would be lost and the opportunity cost of our own work would
// have stopped being computable.

fn floor_admission_terms(buy: BuyTerms, deadline: Timestamp?) -> AdmissionTerms {
  AdmissionTerms {
    deadline: deadline,
    buy: buy,
  }
}
