module gunbc.fabric_m0_origin_commit

import std.types { NonEmptyStr, FilePath, List, Bool, String }
import std.process { ProcessExit, exit_failure }
import std.content_hash { Sha256Digest, ContentHash, Sha256Hash }
import std.scoped_authorization { AttemptIdentity }
import std.durable_compare_and_set {
  CasCommitted,
  CasPreconditionFailed,
  CasStoreRefused,
  CasSlotVersion,
  CasReadablePresent,
  ExpectSlotAbsent,
  CasGenerationPublicationRefused,
  cas_generation_first,
}
import gunbc.auth.access_token_source { AccessTokenSource }
import gunbc.fabric_m0_origin_readback {
  OriginFetchOutcome,
  OriginObjectStaged,
  OriginObjectAbsent,
  OriginFetchUnavailable,
  origin_reading_digest,
}
import gunbc.fabric_m0_job_ending { JobEnding, process_exit_of_job_ending, publication_exit_reason }
import gunbc.cloudflare.r2_origin_object {
  OriginPut,
  WriteCredentialCustody,
  WriteCredentialShredded,
  WriteCredentialResidueRemains,
  OriginPutOutcome,
  OriginObjectStored,
  OriginObjectAlreadyPresent,
  OriginPutRefused,
  OriginPutOutcomeUnknown,
  put_origin_object,
  fetch_origin_object,
}
import gunbc.fabric_m0_completion { OriginReadback, ReadbackAbsent, ReadbackUnknown, origin_readback_of_fetch }
import std.decl_ref { DeclarationRef, decl_ref }
import product.data_category { BuildOutput }
import product.data_class {
  Classified, DataEffectPermit, classify_build_output, SinkKind, DurableOrigin, DataOperation, StoreDurably,
}
import product.fabric.provider_route { ProviderRoute, provider_route_eq }
import gunbc.fabric_m0_commit {
  CommitNamespace,
  CommitTransportOutcome,
  StoreAnswered,
  StoreDidNotAnswer,
  ManifestReadbackObservation,
  commit_slot_key,
  manifest_read_of_origin_fetch,
}

// THE COMMIT BOUNDARY BOUND TO THE DURABLE ORIGIN. gunbc.fabric_m0_commit declares what a store
// answer and an independent readback MEAN; this module is the realization that OBTAINS them from
// the R2 origin -- one PUT of the manifest at the slot derived from the attempt, and one self-
// staging fetch of the same slot -- and seals the pair so a caller cannot combine a transport
// about one slot with a readback of another. It sits peripheral to the interface on purpose
// (DESIGN 3: the dispatch that selects a realization is itself realization): fabric_m0_commit does
// not import the vendor module, this module does.
//
// WHY THE TRANSPORT IS DERIVED FROM THE PUT AND THE FETCH TOGETHER, and this is the one modeling
// decision here. CommitTransportOutcome speaks the CAS vocabulary: a precondition failure carries
// the OCCUPANT it lost to. An R2 create-if-absent PUT answers 412 with no body, so the occupant is
// not in the PUT's answer at all -- it is in the fetch that follows. Three of the four PUT arms
// translate on their own; the 412 arm is honest only once the fetch has been taken, so the fold
// takes both. That is also why the lost-acknowledgement retry publishes rather than parks: the
// slot key is derived from the attempt and the PUT is If-None-Match: *, so the occupant of
// attempt A's slot is most often A's own earlier write, and the readback digest one layer up is
// what decides whether it is.
//
// THE GENERATION IS A DEDUCTION, NOT AN OBSERVATION, and it is stated as one. Under create-if-
// absent exactly one version can ever exist at a slot, so both a stored object and a found
// occupant are at cas_generation_first. If the write discipline ever admits overwrite, this
// sentence is the first thing that becomes false, and the fold below is where it breaks.
//
// A 412 WHOSE FETCH FOUND NOTHING OR COULD NOT BE TAKEN IS UNKNOWN, NOT ABSENT AND NOT PRESENT:
// the store said occupied and the read said otherwise, so nobody observed the occupant. That is
// rendered as StoreDidNotAnswer with the contradiction as its cause -- the arm whose meaning is
// exactly "no store verdict was obtained about this slot" -- and the completion authority turns
// it into reconciliation rather than a decision.
fn transport_of_origin_put(slot: NonEmptyStr, manifest_digest: Sha256Digest, put: OriginPutOutcome, fetch: OriginFetchOutcome) -> CommitTransportOutcome {
  match put {
    OriginObjectStored { key: _ } =>
      StoreAnswered {
        slot: slot,
        outcome: CasCommitted { committed: first_version(digest: manifest_digest) },
      }
    OriginPutRefused { key: _, cause: c } =>
      StoreAnswered { slot: slot, outcome: CasStoreRefused { cause: CasGenerationPublicationRefused { detail: c } } }
    OriginPutOutcomeUnknown { key: _, cause: c } => StoreDidNotAnswer { slot: slot, cause: c }
    OriginObjectAlreadyPresent { key: _ } =>
      match fetch {
        OriginObjectStaged { key: _, reading: r } =>
          StoreAnswered {
            slot: slot,
            outcome: CasPreconditionFailed {
              expected: ExpectSlotAbsent,
              observed: CasReadablePresent { version: first_version(digest: origin_reading_digest(reading: r)) },
            },
          }
        OriginObjectAbsent { key: _ } =>
          StoreDidNotAnswer { slot: slot, cause: "origin answered 412 (occupied) at the slot and the fetch found nothing there; the occupant was not observed" }
        OriginFetchUnavailable { key: _, cause: c } =>
          StoreDidNotAnswer { slot: slot, cause: "origin answered 412 (occupied) at the slot and the fetch could not be taken: " + c }
      }
  }
}

fn first_version(digest: Sha256Digest) -> CasSlotVersion<Sha256Digest> {
  CasSlotVersion { generation: cas_generation_first(), content: Sha256Hash(digest), value: digest }
}

// THE PAIR THE COMPLETION AUTHORITY CONSUMES, SEALED. Both halves are about the one slot this
// module derived, and only commit_manifest_to_origin can produce the value, so a transport about
// slot A cannot be handed in beside a readback of slot B.
//
// THE CREDENTIAL'S CUSTODY RIDES BESIDE, NOT INSIDE. Durability is decided from transport and
// observed; whether the write token is still on disk is a separate fact the completion authority
// does not judge and this value must not lose, so it is carried out to the ending as its own field
// (gunbc#11157 review 64512: an earlier cut let a confirmed fetch erase a leaked credential).
type OriginCommitObservation sole_constructor {
  slot: NonEmptyStr
  transport: CommitTransportOutcome
  observed: ManifestReadbackObservation
  credential: WriteCredentialCustody
}

// ONE PUT, ONE FETCH, ONE SLOT. The manifest file is the caller's (what was owed is a claim the
// commit makes); the digest the readback carries is the fetch's own, taken over the bytes the
// origin returned into a directory the fetch minted. The recorded digest is compared with that
// reading one layer up, never here.
//
// CONSUMERS (DESIGN 3c): tools.fabric_m0_origin_object_probe canary_ending, the identified canary
// whose process conclusion follows the JobEnding built over this observation. The pure fold above
// is exercised by test.claim.fabric_m0_origin_commit_witness across every PUT x fetch arm.
fn commit_manifest_to_origin(
  namespace: CommitNamespace,
  attempt: AttemptIdentity,
  manifest_path: FilePath,
  manifest_digest: Sha256Digest,
  token_source: AccessTokenSource,
) -> OriginCommitObservation {
  let slot = commit_slot_key(namespace: namespace, attempt: attempt)
  let put = put_origin_object(local_path: manifest_path, key: slot, token_source: token_source)
  let fetch = fetch_origin_object(key: slot, token_source: token_source)
  OriginCommitObservation {
    slot: slot,
    transport: transport_of_origin_put(slot: slot, manifest_digest: manifest_digest, put: put.verdict, fetch: fetch),
    observed: manifest_read_of_origin_fetch(fetch: fetch),
    credential: put.credential,
  }
}

// A REQUIRED OBJECT'S READBACK, DERIVED FROM ITS PUT AND ITS FETCH TOGETHER, for the same reason
// the manifest transport is. A fetch that staged bytes confirms whatever the PUT said, and an
// unreachable fetch is unknown whatever the PUT said -- those arms are origin_readback_of_fetch's.
// The arm that needs the PUT is ABSENCE: a 404 after a PUT whose outcome is UNKNOWN (a 5xx, a
// dropped connection) is not evidence the object is missing -- the write may have landed after
// the read -- and rendering it ReadbackAbsent would fail a job whose output is committed. Only a
// PUT the store REFUSED makes the 404 a decided absence; a 404 after the store said stored or
// present is a contradiction nobody has resolved, and stays unknown with the contradiction named.
fn object_readback_of_origin_put(put: OriginPutOutcome, fetch: OriginFetchOutcome) -> OriginReadback {
  match fetch {
    OriginObjectAbsent { key: k } =>
      match put {
        OriginPutRefused { key: _, cause: _ } => ReadbackAbsent
        OriginPutOutcomeUnknown { key: _, cause: c } =>
          ReadbackUnknown { cause: "the PUT at " + k + " reached no verdict (" + c + ") and the fetch found nothing; the object may land after the read" }
        OriginObjectStored { key: _ } =>
          ReadbackUnknown { cause: "origin said stored at " + k + " and the fetch found nothing there" }
        OriginObjectAlreadyPresent { key: _ } =>
          ReadbackUnknown { cause: "origin said present at " + k + " and the fetch found nothing there" }
      }
    other => origin_readback_of_fetch(fetch: fetch)
  }
}

// THE OUTPUT BOUNDARY. A job's produced file enters the commit path here and enters classified:
// product.data_class classify_build_output is admit_callers-sealed to this declaration, so the
// MINT is reachable only through this boundary. THE BOUNDARY ITSELF IS OPEN (review 65270): this
// is an exported function taking any FilePath, so the seal is one hop deep -- an importer that
// holds a path can label it BuildOutput by calling here, and the canary and the witnesses do
// exactly that. What the label therefore establishes today is "these bytes were handed to the
// commit path as job output", a fact about the ROUTE, not a fact about their producer. Rung 1 for
// the class "a file not produced by the job is labelled as its output". NEXT-RUNG TRIGGER,
// capability grain: a job producer in this tree -- the M0 module that runs the work and owns the
// output directory -- becomes the sole admitted caller of job_output_bytes through its own
// admit_callers list, with the canary re-homed as that producer's fixture; sufficient for
// restating this note as "only the job's own producer can say BuildOutput". Not satisfied by
// sealing to the canary, which is not a producer.
fn job_output_bytes(local_path: FilePath) -> Classified<BuildOutput, FilePath> {
  classify_build_output(value: local_path)
}

// THE ROUTE THE DURABLE ORIGIN IS, BY DECLARATION. The provider is the Cloudflare vendor row, the
// service the R2 upstream authority, the region the fleet bucket's jurisdiction as
// gunbc.cloudflare.r2_origin declares it -- cited so a data-handling row and this sink agree by
// declaration identity and not by matching strings (the same rule product.fabric.provider_route
// states for every route).
fn fabric_durable_origin_route() -> ProviderRoute {
  ProviderRoute {
    provider: decl_ref(module_path: "extdeps.vendor.cloudflare", decl_name: "cloudflare"),
    service: decl_ref(module_path: "extdeps.cloudflare.r2", decl_name: "extdeps_external_authority_anchor"),
    region: decl_ref(module_path: "gunbc.cloudflare.r2_origin", decl_name: "gunbc_fleet_r2_bucket_allocations"),
  }
}

// ONE PUT, ONE FETCH, ONE KEY, for a required object. The readback the completion authority
// joins under the caller's obligation is derived here from both answers and never assembled by
// the caller from one of them.
//
// THE WRITE TAKES THE PERMIT, NEVER THE BARE PATH -- AT THIS ENTRY POINT, AND THAT IS THE WHOLE
// CLAIM (DESIGN 4b meta-obligation 1, review 65145). The object put to the durable origin is
// classified data (BuildOutput) leaving the process, so commit_object_to_origin is reachable only
// with a DataEffectPermit<BuildOutput, FilePath> -- minted by product.data_class admit_data_effect
// for a DurableOrigin sink on this route, under the data-handling map and the active posture. A
// caller cannot author the permit (test.probe.data_effect_permit_forged_probe), and a caller holding
// a String literal where the permit is declared refuses; a caller holding a FilePath is admitted
// silently today (gunbc.recurring_failure_mode
// refined_alias_argument_exempt_from_declared_type_inhabitance, test.probe
// .durable_write_takes_the_value_probe). The path the PUT reads is the permit's revealed payload,
// so the bytes THIS entry writes are exactly the bytes admitted.
//
// WHAT IS NOT WALLED: the transport underneath. gunbc.cloudflare.r2_origin_object put_origin_object
// is exported with no admit_callers and takes a bare path; commit_manifest_to_origin below calls it
// for the manifest, and tools.fabric_m0_origin_object_probe roundtrip calls it for the fixture, so
// a module that imports the transport can still PUT unclassified bytes to the same bucket. This
// entry is therefore a permit-taking door beside an open one: rung 1 for the class "job output
// written without admission", not construction. NEXT-RUNG TRIGGER, capability grain: the transport's
// mint is admit_callers-sealed to the permit-taking entries (this one, and a manifest entry that
// takes its own permit once the manifest has a category), so that no caller outside them can spell
// a PUT -- at which point the roundtrip probe routes through a permit or is deleted. Not satisfied
// by sealing this module's callers alone. That seal lives in r2_origin_object, which gunbc#11214
// is editing, and is not taken here.
//
// CONSUMERS (DESIGN 3c): tools.fabric_m0_origin_object_probe canary_ending; the fold above is
// exercised by test.claim.fabric_m0_origin_commit_witness.
type OriginObjectCommit sole_constructor {
  readback: OriginReadback
  credential: WriteCredentialCustody
}

// THE PERMIT MUST BE FOR THIS EFFECT, NOT MERELY FOR THIS CATEGORY (review 65175). The type binds
// category and payload; it does not bind the sink or the operation, so a BuildOutput permit
// admitted for a log channel, for another provider's route, or for transmission would otherwise
// authorise a durable PUT here. One judgement, in the module that owns the effect: the permit's
// sink is a DurableOrigin on the fleet R2 route and its operation is StoreDurably, or the write
// refuses before any transport is touched. Same shape as product.fabric.provider_admission's
// PermitStanding: the standing is a coproduct the caller matches, never a Bool.
type OriginWritePermitStanding
  = PermitAuthorisesThisOrigin
  | PermitNamesAnotherSink { sink: SinkKind }
  | PermitNamesAnotherRoute { route: ProviderRoute }
  | PermitNamesAnotherOperation { operation: DataOperation }

fn origin_write_permit_standing(permit: DataEffectPermit<BuildOutput, FilePath>) -> OriginWritePermitStanding {
  match permit.sink.kind {
    DurableOrigin { route: r } =>
      if provider_route_eq(a: r, b: fabric_durable_origin_route()) {
        match permit.operation {
          StoreDurably => PermitAuthorisesThisOrigin
          other => PermitNamesAnotherOperation { operation: permit.operation }
        }
      } else {
        PermitNamesAnotherRoute { route: r }
      }
    other => PermitNamesAnotherSink { sink: permit.sink.kind }
  }
}

type OriginObjectWrite
  = OriginObjectWritten { commit: OriginObjectCommit }
  | OriginObjectWriteRefused { standing: OriginWritePermitStanding }

fn commit_object_to_origin(permit: DataEffectPermit<BuildOutput, FilePath>, key: NonEmptyStr, token_source: AccessTokenSource) -> OriginObjectWrite {
  match origin_write_permit_standing(permit: permit) {
    PermitAuthorisesThisOrigin => {
      let put = put_origin_object(local_path: permit.value, key: key, token_source: token_source)
      let fetch = fetch_origin_object(key: key, token_source: token_source)
      OriginObjectWritten { commit: OriginObjectCommit {
        readback: object_readback_of_origin_put(put: put.verdict, fetch: fetch),
        credential: put.credential,
      } }
    }
    other => OriginObjectWriteRefused { standing: other }
  }
}

// THE EXIT, WITH CUSTODY IN IT. The publication decides the conclusion and, on a clean run, the
// exit follows it unchanged. A run that left write-credential material on disk may NOT exit zero
// whatever it published: that is a typed, located refusal naming the leak AND what the publication
// decided, so nothing true is discarded in either direction -- the reader learns both that the
// object is durable and that cleanup is owed. It is not a fallback: there is no arm here that
// answers success for anything but a clean publication of success.
fn residue_cause_text(c: WriteCredentialCustody) -> String {
  match c {
    WriteCredentialShredded => ""
    WriteCredentialResidueRemains { cause: r } => r as String
  }
}

fn credential_residue_causes(custodies: List<WriteCredentialCustody>) -> List<String> {
  custodies |> map(c => residue_cause_text(c: c)) |> filter(t => (t == "") == false)
}

fn process_exit_with_credential_custody(ending: JobEnding, custodies: List<WriteCredentialCustody>) -> ProcessExit {
  let residue = credential_residue_causes(custodies: custodies)
  if residue.count() == 0 {
    process_exit_of_job_ending(ending: ending)
  } else {
    let joined = fold(residue, init: "", f: (acc, r) => if acc == "" { r } else { acc + "; " + r })
    exit_failure(reason: "write credential material may remain and requires cleanup (" + joined + "); publication: " + publication_exit_reason(publication: ending.publication))
  }
}
