module gunbc.fabric_storage_serve

import std.types { String, NonEmptyStr, Int, List, CommitSha }
import extdeps.http.server { ServeWireResponse }
import std.fabric_storage {
  FabricObject, fabric_object_decode, fabric_object_ref_of_wire, FabricHeadExpectation, ExpectHeadAbsent, ExpectHeadAt,
  FabricReplyUndecodable, FabricHeadNameRefused, FabricWriterRefused,
  FabricPutRefused, FabricHeadReadRefused, FabricHeadAdvanceRefused, FabricClosureRefused,
}
import gunbc.fabric_storage_file_store {
  FabricStorageFileRoot, fabric_storage_file_head, fabric_storage_file_put, fabric_storage_file_advance, fabric_storage_file_closure,
}
import gunbc.fabric_storage_wire { FabricDoorPrincipal, fabric_storage_wire_head, fabric_storage_wire_put, fabric_storage_wire_advance, fabric_storage_wire_closure, fabric_storage_wire_identity }
import gunbc.fabric_writer_roster { fabric_door_writer_admission_over, fabric_door_principal_of, fabric_served_writer_roster, fabric_door_local_roster, FabricDoorWriterAdmitted, FabricDoorWriterRefused }
import gunbc.roadmap_dashboard_instance { prod_role_realization_refusal_detail }
import gunbc.fabric_storage_placement { fabric_storage_placement, FabricStoragePlaced, FabricStorageUnplaced, FabricStoragePlacementRefused, fabric_storage_route_prefix, fabric_storage_placed_file_root, FabricStoragePlacedRootReady, FabricStoragePlacedRootRefused }

// THE FABRIC DB ENDPOINT: the store side of the served handler bound to std.fabric_storage. One
// `gunbc serve` process on the placed host, compiled once, answers each request by running the
// file store (gunbc.fabric_storage_file_store) against local disk and writing the outcome in the one
// wire form (gunbc.fabric_storage_wire). This module decides nothing about the log: it realizes four
// store operations and nothing else.
//
// SINGLE WRITER BY CONSTRUCTION. Every append reaches this process on the one host holding the
// files, and the head compare-and-set is O_EXCL on that local disk: two concurrent requests that
// both pass the expectation still race for ONE generation file, and exactly one creates it. The
// serve accept loop being serial is not relied on.
//
// NOTHING LIVES IN MEMORY. Each request reads and writes the files; a restart loses nothing and
// there is no cache to rebuild or to go stale.
//
// ACCESS: THE DOOR IS A UNIX SOCKET (gunbc.fabric_storage_placement fabric_storage_door_socket),
// reached two ways: through `tailscale serve`, which proxies to it as root and names the tailnet
// user in Tailscale-User-Login, and directly by the placed host's own writers, whose account the
// kernel attests (`gunbc serve --unix-socket` hands the handler `peer_user`). THE WRITER WALL: a
// put or advance is admitted only for a proxied login in gunbc.fabric_writer_roster's served roster
// or a local peer in the door directory's roster -- the header is believed only from the proxy --
// and an absent login, an unrostered login or account, and an unattested peer are refused as a
// typed store outcome (FabricWriterRefused) that touches no file. Reads (head, closure) and the
// identity echo stay open to whoever reaches the door: they move nothing. The store's files are
// the service principal's alone (fabric_storage_directory), so no writer reaches them except as a
// request here -- root and the service account itself excepted, which is stated there.
//
// EVERY TYPED OUTCOME IS HTTP 200. The status says the protocol was answered; the arm is in the
// body. A non-200 means the request itself was not this protocol (unknown operation, malformed
// request), and the caller reads that as FabricReplyUndecodable -- never as a store outcome.

data fabric_storage_closure_bound_cap: Int = 65536

fn text_response(status: Int, body: String) -> ServeWireResponse {
  ServeWireResponse { status: status, content_type_label: "text/plain; charset=utf-8", body: body }
}

fn ok(body: String) -> ServeWireResponse {
  text_response(status: 200, body: body)
}

fn words(text: String) -> List<String> {
  split(trim_line(s: text), separator: " ")
}

fn trim_line(s: String) -> String {
  match first(split(s, separator: "\n")) { Present { value: l } => l  Absent => "" }
}

fn word(ws: List<String>, i: Int) -> String {
  match first(ws |> skip(n: i)) { Present { value: w } => w  Absent => "" }
}

fn head_name(w: String) -> NonEmptyStr? {
  if w == "" { none } else { Present { value: w as NonEmptyStr } }
}

fn malformed(detail: String) -> ServeWireResponse {
  text_response(status: 400, body: join(["fabric_storage/1 malformed request: ", detail, "\n"], ""))
}

// Request bodies:
//   head      <name>
//   closure   <name> <bound>
//   put       <canonical preimage>
//   advance   <name> absent <target>   |   <name> at <expected-ref> <target>
//   identity  (no body)
fn fabric_storage_respond(root: FabricStorageFileRoot, rosters: FabricDoorRosters, operation: String, body: String, principal: FabricDoorPrincipal) -> ServeWireResponse {
  let ws = words(text: body)
  let admission = fabric_door_writer_admission_over(logins: rosters.logins, locals: rosters.locals, principal: principal)
  match operation {
    "identity" => ok(body: fabric_storage_wire_identity(principal: principal))
    "head" =>
      match head_name(w: word(ws: ws, i: 0)) {
        Absent => malformed(detail: "head names no head")
        Present { value: n } => ok(body: fabric_storage_wire_head(read: fabric_storage_file_head(root: root, name: n)))
      }
    "closure" =>
      match head_name(w: word(ws: ws, i: 0)) {
        Absent => malformed(detail: "closure names no head")
        Present { value: n } =>
          match parse_int(s: word(ws: ws, i: 1)) {
            Absent => malformed(detail: "closure bound is not an integer")
            Present { value: b } =>
              if b < 1 || b > fabric_storage_closure_bound_cap { malformed(detail: "closure bound out of range") }
              else { ok(body: fabric_storage_wire_closure(read: fabric_storage_file_closure(root: root, name: n, bound: b))) }
          }
      }
    "put" =>
      match admission {
        FabricDoorWriterRefused { refusal: r } => ok(body: fabric_storage_wire_put(put: FabricPutRefused { fault: FabricWriterRefused { refusal: r } }))
        FabricDoorWriterAdmitted { principal: _ } =>
      match fabric_object_decode(preimage: body) {
        Absent => malformed(detail: "put body is not one fabric object")
        Present { value: o } => ok(body: fabric_storage_wire_put(put: fabric_storage_file_put(root: root, object: o)))
      }
      }
    "advance" =>
      match admission {
        FabricDoorWriterRefused { refusal: r } => ok(body: fabric_storage_wire_advance(advance: FabricHeadAdvanceRefused { fault: FabricWriterRefused { refusal: r } }))
        FabricDoorWriterAdmitted { principal: _ } =>
      match head_name(w: word(ws: ws, i: 0)) {
        Absent => malformed(detail: "advance names no head")
        Present { value: n } =>
          match advance_request(ws: ws) {
            Absent => malformed(detail: "advance expectation or target unreadable")
            Present { value: req } => ok(body: fabric_storage_wire_advance(advance: fabric_storage_file_advance(root: root, name: n, expected: req.expected, target: req.target)))
          }
      }
      }
    _ => text_response(status: 404, body: join(["fabric_storage/1 no operation ", operation, "\n"], ""))
  }
}

type AdvanceRequest {
  expected: FabricHeadExpectation
  target: std.fabric_storage.FabricObjectRef
}

fn advance_request(ws: List<String>) -> AdvanceRequest? {
  match word(ws: ws, i: 1) {
    "absent" =>
      match fabric_object_ref_of_wire(wire: word(ws: ws, i: 2)) {
        Present { value: t } => Present { value: AdvanceRequest { expected: ExpectHeadAbsent, target: t } }
        Absent => none
      }
    "at" =>
      match fabric_object_ref_of_wire(wire: word(ws: ws, i: 2)) {
        Absent => none
        Present { value: e } =>
          match fabric_object_ref_of_wire(wire: word(ws: ws, i: 3)) {
            Present { value: t } => Present { value: AdvanceRequest { expected: ExpectHeadAt { object: e }, target: t } }
            Absent => none
          }
      }
    _ => none
  }
}

// The mount is /fabric-storage/<operation>; only POST is admitted, since every operation carries a body.
fn fabric_storage_operation_of(path: String) -> String? {
  let prefix = join([fabric_storage_route_prefix, "/"], "")
  if starts_with(s: path, prefix: prefix) { Present { value: substring(s: path, start: length(prefix), end: length(path)) } } else { none }
}

// THE TWO ROSTERS THE DOOR ADMITS AGAINST: proxied logins (gunbc.fabric_writer_roster
// fabric_served_writer_roster) and local peers (fabric_door_local_roster). A parameter, so a claim
// can supply both; the served entry below binds the derived ones.
type FabricDoorRosters {
  logins: List<NonEmptyStr>
  locals: List<NonEmptyStr>
}

fn fabric_storage_serve_handle_over(root: FabricStorageFileRoot, rosters: FabricDoorRosters, method: String, path: String, body: String, tailscale_identity: String, peer_user: String) -> ServeWireResponse {
  if method != "POST" {
    text_response(status: 405, body: "fabric_storage/1 only POST is admitted\n")
  } else {
    match fabric_storage_operation_of(path: path) {
      Absent => text_response(status: 404, body: join(["fabric_storage/1 no route ", path, "\n"], ""))
      Present { value: op } => fabric_storage_respond(root: root, rosters: rosters, operation: op, body: body, principal: fabric_door_principal_of(tailscale_identity: tailscale_identity, peer_user: peer_user))
    }
  }
}

// THE SERVED ENTRY, in the shape `gunbc serve --function` binds (the roadmap serve seam's). The
// store root is the placement's; an unplaced store answers 503 on every request rather than
// choosing a root.
fn fabric_storage_serve_handle(method: String, path: String, body: String, tailscale_identity: String, peer_user: String, release_revision: CommitSha) -> ServeWireResponse {
  match fabric_storage_placement() {
    FabricStorageUnplaced => text_response(status: 503, body: "fabric_storage/1 the fabric DB is unplaced\n")
    FabricStoragePlacementRefused { cause } => text_response(status: 503, body: join(["fabric_storage/1 ", prod_role_realization_refusal_detail(cause: cause), "\n"], ""))
    FabricStoragePlaced { host: _, store_root: r, endpoint: _, door_socket: _ } =>
      match fabric_storage_placed_file_root(store_root: r) {
        FabricStoragePlacedRootRefused { detail } => text_response(status: 503, body: join(["fabric_storage/1 the store's entry mode is refused: ", detail as String, "\n"], ""))
        FabricStoragePlacedRootReady { root } => fabric_storage_serve_handle_over(root: root, rosters: FabricDoorRosters { logins: fabric_served_writer_roster(), locals: fabric_door_local_roster() }, method: method, path: path, body: body, tailscale_identity: tailscale_identity, peer_user: peer_user)
      }
  }
}
