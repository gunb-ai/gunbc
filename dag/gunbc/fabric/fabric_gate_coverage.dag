// WHY THIS EXISTS, STATED AS THE FAILURE IT ANSWERS. gunbc.fabric_ci_program declares, per gate, the
// mutations that discriminate its exit predicate. Nothing joined those declarations to the evidence
// that discharges them, so a gate's coverage was ASSERTED IN PROSE by whoever wrote the pull request.
// It was asserted wrongly at least once: the FCI-2 issuance kernel was described as enrolling each
// discriminating mutation of its gate while "expired-reservation" had no decision arm anywhere in the
// change. The claim was not caught by a check, because the claim was not IN a check -- it was in a
// sentence, and no sentence is reachable from an Accepted program (DESIGN 4c).
//
// So this module makes the join total. Every declared mutation of every gate must carry exactly one
// enrolment row, and that row is a COPRODUCT: either it names the witness that discharges the
// mutation, or it declares the mutation undischarged WITH a restoration trigger. There is no third
// arm and no default, so the missing row is not silence -- it is a located refusal.
//
// THE CLASS THIS BELONGS TO. A coverage claim computed from a roster is a different object from a
// coverage claim written beside one. This is the second: the roster of gates is the authority, the
// enrolment list is measured against it, and the disagreement is typed.
//
// THE TRIGGER THIS PARAGRAPH USED TO CARRY HAS FIRED, AND THE RUNG STATEMENT IS REWRITTEN RATHER
// THAN LEFT STANDING. It read that the module could not verify that a named witness EXISTS or
// EXECUTES, and named as its trigger a carrier joining exact gate obligation x exact witness
// declaration x adjudicated revision x expected terminal observation, admitting exactly one
// covered binding per obligation. That carrier is `gate_standing` and its production caller is
// `adjudicate_published_ledger`, which reads the terminal ledger the required floor publishes on
// every run, refuses a ledger bound to another revision, and derives one standing per obligation.
// A nomination whose witness did not run, ran as a tolerated known red, returned something other
// than a held verdict, or was observed twice is REFUSED, and the refusal reds a required step.
//
// WHAT IS STILL NOT ESTABLISHED, stated so the climb is not read as further than it went. First,
// the join key is the qualified name the wire carries, not the declaration -- see
// NominationObservation. Second, a witness that ran and passed is evidence that a claim of that
// name holds, never that the claim discriminates the MUTATION the roster enrols it against; that
// relation is authored and this module cannot read it. TRIGGER (DESIGN 4b(3)): a mutation carrier
// the witness itself names -- an enrolment the WITNESS declares rather than the roster asserts --
// SUFFICIENT FOR a witness renamed onto a different property to stop discharging the obligation it
// was enrolled for. Third, the prepared-subject half of the revision binding has no production
// caller; its own trigger is stated at `adjudicate_published_ledger`.
type MutationDischarge
  = DischargedByWitness { witness: WitnessIdentity }
  | Undischarged { reason: NonEmptyStr, restoration_trigger: NonEmptyStr }

type MutationEnrolment {
  gate: NonEmptyStr
  mutation: NonEmptyStr
  discharge: MutationDischarge
}

// EVERY ARM IS LOCATED BY (gate, mutation), because a coverage complaint that does not name its
// subject sends the reader back to the roster to find it, which is the cost this module removes.
type CoverageRefusal
  = GateIdDeclaredSeveralTimes { gate: NonEmptyStr }
  | MutationDeclaredSeveralTimes { gate: NonEmptyStr, mutation: NonEmptyStr }
  | MutationHasNoEnrolmentRow { gate: NonEmptyStr, mutation: NonEmptyStr }
  | MutationHasSeveralEnrolmentRows { gate: NonEmptyStr, mutation: NonEmptyStr }
  | EnrolmentNamesUnknownGate { gate: NonEmptyStr, mutation: NonEmptyStr }
  | EnrolmentNamesUndeclaredMutation { gate: NonEmptyStr, mutation: NonEmptyStr }

// THE VERDICT DOES NOT CARRY A BOOLEAN "COVERED". A total join whose undischarged list is nonempty is
// a correct and useful answer -- it is the honest state of FCI-2 today -- and collapsing it to a
// boolean would force every consumer to choose between refusing on a truthfully declared gap and
// ignoring the gap entirely. The gate program itself only requires that the join be TOTAL.
//
// A CONSUMER THAT REQUIRES COVERAGE MUST NOT TEST THIS LIST. An earlier version of this sentence
// told consumers to do exactly that, which was wrong in the direction that matters: an empty
// UNDISCHARGED list means every obligation carries an authored NOMINATION, and a nomination is a
// sentence somebody wrote. It is not execution evidence, and a roster whose every row was optimistically
// discharged would satisfy that test while nothing had ever run. Coverage is answered by
// gate_standing over observed evidence at an adjudicated revision; this verdict answers only whether
// the enrolment is WELL-FORMED. The two questions are separate functions precisely so that one
// cannot be read as the other.
type CoverageVerdict
  = CoverageTotal {
      discharged: List<MutationEnrolment>,
      undischarged: List<MutationEnrolment>,
    }
  | CoverageRefused { refusals: List<CoverageRefusal> }

fn enrolments_for(
  enrolments: List<MutationEnrolment>,
  gate: NonEmptyStr,
  mutation: NonEmptyStr,
) -> List<MutationEnrolment> {
  filter(enrolments, e => e.gate == gate && e.mutation == mutation)
}

fn gate_declares_mutation(gates: List<FabricCiGate>, gate: NonEmptyStr, mutation: NonEmptyStr) -> Bool {
  any(gates, g => g.id == gate && any(g.discriminating_mutations, m => m == mutation))
}

// DIRECTION ZERO, AND IT MUST RUN FIRST. The join treats (gate, mutation) as an IDENTITY, and an
// identity that is not unique on the authority side makes "exactly once" unenforceable from the
// enrolment side alone: a gate declaring one mutation twice is visited twice, each visit finds the
// same single enrolment row, and one row silently answers two obligations.
//
// THIS CODE HAS NOW OSCILLATED BETWEEN TWO FORMS, AND BOTH ARE QUADRATIC. Read this before
// changing it back.
//
// Form A (carried prefix): fold carrying every name seen so far, emitting when an identity's
// prefix count reaches 1 -- its second occurrence. Form B (this one): count each name against the
// whole input and skip names already named. A previous revision replaced B with A, and the comment
// it left behind condemned B as "the copied-accumulator cost defect section 6 says is always
// fixed". Review 61163 then flagged A for the same defect, and this revision restored B. Each
// revision criticised the other and neither removed the quadratic.
//
// WHAT IS ACTUALLY TRUE OF EACH. The comparison bound is n*(n-1)/2 either way: exact duplicate
// detection needs a map, set or ordering to beat it and std carries none, and std.keyed_roster --
// the corpus authority for this question -- pays the same, one keyed_occurrence_count per row.
// That bound is a floor, not a shortcut.
//
// The two differ only in what the ACCUMULATOR copies. Form A's prefix holds every occurrence, so
// its appends copy lists of length 0,1,...,n-1: quadratic copying on EVERY input. Form B's
// accumulator holds only distinct duplicate names, so it copies 0,1,...,d-1 where d is the number
// of distinct duplicates. On a well-formed roster d is 0 and nothing is copied at all.
//
// SO FORM B IS STRICTLY BETTER, AND IT IS STILL NOT CLOSED. An earlier version of this note
// claimed the accumulator "no longer grows with the input". That is FALSE, and false in exactly
// the population this function exists to diagnose: for [a1,a1,a2,a2,...] there are 2d inputs and d
// distinct duplicates, so the copying is quadratic in the input. "Zero on a well-formed roster"
// does not discharge the malformed path of a FAIL-CLOSED adjudicator -- malformed rosters are its
// entire subject.
//
// THE REMAINING FIX IS NAMED, NOT DEFERRED VAGUELY: build the accumulator by PREPENDING with
// `Cons` rather than appending with `concat`/`list_snoc_item`, which are `list_append` and fold
// over their left operand. That makes accumulation O(1) per emission and leaves only the
// comparison floor. It is not done here because no module under dag/ currently constructs
// FreeMonoid cells directly, and this branch has no way to execute a .dag witness to confirm the
// construction -- landing it unverified would trade a measured cost for an unmeasured
// correctness risk. C2 remains open on this point.
fn count_name_in(seen: List<NonEmptyStr>, name: NonEmptyStr) -> Int {
  fold(seen, init: 0, f: (acc, s) => if s == name { acc + 1 } else { acc })
}

fn fabric_name_already_in(seen: List<NonEmptyStr>, name: NonEmptyStr) -> Bool {
  fold(seen, init: false, f: (acc, s) => if s == name { true } else { acc })
}

// THE COST STATEMENT FOR THIS FUNCTION LIVES ABOVE count_name_in, where both forms this code has
// oscillated between are compared. In short: the comparison bound is quadratic and is a floor;
// the accumulator below is bounded by the number of DISTINCT DUPLICATE names, which is zero on a
// well-formed roster and d on a malformed one -- so its `concat` still copies quadratically on
// exactly the malformed inputs this adjudicator exists to diagnose. That is an OPEN cost
// obligation, not a discharged one, and the named remedy is prepending with `Cons`.
//
// std.keyed_roster is the corpus authority for duplicate detection and is NOT reused here because
// it answers a narrower question: it returns the FIRST duplicate as evidence, where a coverage
// refusal must locate EVERY one. It pays the same comparison bound, one keyed_occurrence_count
// per row.
fn fabric_duplicated_names(names: List<NonEmptyStr>) -> List<NonEmptyStr> {
  fold(names, init: [], f: (acc, n) =>
    if count_name_in(names, n) > 1 && !fabric_name_already_in(acc, n) {
      concat(acc, [n])
    } else {
      acc
    })
}

fn duplicate_gate_ids(gates: List<FabricCiGate>) -> List<CoverageRefusal> {
  map(
    fabric_duplicated_names(map(gates, g => g.id)),
    n => GateIdDeclaredSeveralTimes { gate: n })
}

fn duplicate_mutations_of(g: FabricCiGate) -> List<CoverageRefusal> {
  map(
    fabric_duplicated_names(g.discriminating_mutations),
    m => MutationDeclaredSeveralTimes { gate: g.id, mutation: m })
}

fn duplicate_authority_identities(gates: List<FabricCiGate>) -> List<CoverageRefusal> {
  concat(duplicate_gate_ids(gates), flat_map(gates, g => duplicate_mutations_of(g)))
}

// DIRECTION ONE: every declared mutation is answered exactly once.
fn unanswered_mutations(
  gates: List<FabricCiGate>,
  enrolments: List<MutationEnrolment>,
) -> List<CoverageRefusal> {
  flat_map(gates, g =>
    fold(g.discriminating_mutations, init: [], f: (acc, m) => {
      let rows = enrolments_for(enrolments, g.id, m)
      if rows.length() == 0 {
        concat(acc, [MutationHasNoEnrolmentRow { gate: g.id, mutation: m }])
      } else if rows.length() > 1 {
        concat(acc, [MutationHasSeveralEnrolmentRows { gate: g.id, mutation: m }])
      } else {
        acc
      }
    }))
}

// DIRECTION TWO: every enrolment answers something the roster actually declares. Without this arm the
// join is satisfiable by enrolling mutations nobody asked about, which is how a coverage number grows
// while coverage does not -- and it separates the two ways an enrolment can be foreign, because a
// misspelled gate and a misspelled mutation are different authoring mistakes with different repairs.
fn foreign_enrolments(
  gates: List<FabricCiGate>,
  enrolments: List<MutationEnrolment>,
) -> List<CoverageRefusal> {
  fold(enrolments, init: [], f: (acc, e) => {
    if !any(gates, g => g.id == e.gate) {
      concat(acc, [EnrolmentNamesUnknownGate { gate: e.gate, mutation: e.mutation }])
    } else if !gate_declares_mutation(gates, e.gate, e.mutation) {
      concat(acc, [EnrolmentNamesUndeclaredMutation { gate: e.gate, mutation: e.mutation }])
    } else {
      acc
    }
  })
}

// ONE AUTHORITY FOR THE SPLIT ITSELF, which is a narrower change than an earlier version of this
// note claimed. That version said the rule deciding an enrolment's arm "was written in two places"
// and is "now written exactly once". Both are false: `is_discharged` below already existed and
// was already the single shared predicate. What was duplicated was the SPLIT CONSTRUCTION -- the
// `filter(p)` / `filter(!p)` pair spelled inline at the call site -- so the two sides were
// assembled separately and could drift apart in their pairing (a caller taking one side from here
// and the other from elsewhere), even though each consulted the same predicate. Naming the
// partition makes the PAIR the unit that is constructed once. The predicate authority is
// unchanged by this commit and gets no credit from it.
//
// WHY THIS IS NOT ONE FOLD, deliberately. The obvious "single fold returning both lists" builds
// each side with `concat(acc.side, [row])`, which copies a growing accumulator once per row: it
// would trade two LINEAR passes for one QUADRATIC one, introducing the exact cost-shape defect
// section 6 forbids in order to satisfy a structural reading of the same section. `filter` is
// `fold_list_right` with `Cons`, so it is linear and allocates no intermediate copies; two of
// them is 2n, not n^2. The section 6 obligation this actually owes is a single authority for the
// decision; that authority is the constructor match below, and it already held before this change.
fn is_discharged(e: MutationEnrolment) -> Bool {
  match e.discharge {
    DischargedByWitness { witness } => true,
    Undischarged { reason, restoration_trigger } => false,
  }
}

type EnrolmentPartition {
  discharged: List<MutationEnrolment>
  undischarged: List<MutationEnrolment>
}

fn partition_enrolments(enrolments: List<MutationEnrolment>) -> EnrolmentPartition {
  EnrolmentPartition {
    discharged: filter(enrolments, e => is_discharged(e)),
    undischarged: filter(enrolments, e => !is_discharged(e)),
  }
}

// TOTAL IN BOTH DIRECTIONS, AND FAIL-CLOSED: any refusal in either direction refuses the whole
// verdict rather than reporting a partition computed over a roster known to be wrong (DESIGN 5).
fn gate_coverage(
  gates: List<FabricCiGate>,
  enrolments: List<MutationEnrolment>,
) -> CoverageVerdict {
  let refusals = concat(
    duplicate_authority_identities(gates),
    concat(
      unanswered_mutations(gates, enrolments),
      foreign_enrolments(gates, enrolments),
    ),
  )
  if refusals.length() > 0 {
    CoverageRefused { refusals: refusals }
  } else {
    let split = partition_enrolments(enrolments)
    CoverageTotal { discharged: split.discharged, undischarged: split.undischarged }
  }
}

fn fabric_gate_coverage() -> CoverageVerdict {
  gate_coverage(fabric_ci_gates(), fabric_mutation_enrolments())
}

// THE ENROLMENT ROSTER. Two rules govern what may be written here, and both exist because the
// cheapest way to make this lens green is to lie to it.
//
// FIRST: DischargedByWitness may name only a witness THIS AUTHOR HAS READ, in a test module, that
// asserts the refusal or identity the mutation names. It may not name a witness that merely touches
// the subject. Nothing in the substrate can check this yet -- see the next-rung trigger above -- so
// it is diligence, and it is stated here rather than assumed so that a reviewer knows what claim a
// row is making.
//
// SECOND, AND IT IS THE LOAD-BEARING ONE: the safe direction is Undischarged. A gate this author has
// not assessed is enrolled as undischarged with that stated as the reason, NOT omitted and NOT
// optimistically discharged. Undischarged over-reports the work remaining; a wrong DischargedByWitness
// under-reports it and is indistinguishable from real coverage at every consumer. So where this
// roster is ignorant it says so, and the FCI-0 and FCI-1 rows below say exactly that: this lane built
// FCI-2 and has not read the evidence for the gates on either side of it.
//
// TWO ROWS ARE NOW DISCHARGED BECAUSE THEIR TRIGGER FIRED, which is the only way a row may change
// arm. They read Undischarged while their witnesses were in flight, with "the FCI-2 issuance kernel
// lands on main" as the restoration trigger; it has landed, and both declarations were then verified
// AT THE MODULE DECLARATION rather than inferred from the file path -- the module is
// test.claim.fabric_grant_issuance_witness, which is NOT what the containing path spells. An earlier
// revision of these two rows named a path-derived namespace that never existed, so the check that
// promotes a row is the same check that caught the fabrication.
fn fabric_mutation_enrolments() -> List<MutationEnrolment> {
  [
    MutationEnrolment { gate: "FCI-0", mutation: "command-word", discharge: Undischarged { reason: "FCI-0 evidence not read by this lane; enrolled undischarged rather than assumed.", restoration_trigger: "The FCI-0 owner replaces this row with the witness that discriminates the mutation." } },
    MutationEnrolment { gate: "FCI-0", mutation: "environment-entry", discharge: Undischarged { reason: "FCI-0 evidence not read by this lane; enrolled undischarged rather than assumed.", restoration_trigger: "The FCI-0 owner replaces this row with the witness that discriminates the mutation." } },
    MutationEnrolment { gate: "FCI-0", mutation: "verified-tree", discharge: Undischarged { reason: "FCI-0 evidence not read by this lane; enrolled undischarged rather than assumed.", restoration_trigger: "The FCI-0 owner replaces this row with the witness that discriminates the mutation." } },
    MutationEnrolment { gate: "FCI-0", mutation: "toolchain-identity", discharge: Undischarged { reason: "FCI-0 evidence not read by this lane; enrolled undischarged rather than assumed.", restoration_trigger: "The FCI-0 owner replaces this row with the witness that discriminates the mutation." } },
    MutationEnrolment { gate: "FCI-0", mutation: "output-declaration", discharge: Undischarged { reason: "FCI-0 evidence not read by this lane; enrolled undischarged rather than assumed.", restoration_trigger: "The FCI-0 owner replaces this row with the witness that discriminates the mutation." } },
    MutationEnrolment { gate: "FCI-1", mutation: "reservation-state-owned-by-submitter", discharge: Undischarged { reason: "FCI-1 evidence has not been read by this lane; enrolled undischarged rather than assumed.", restoration_trigger: "The FCI-1 owner replaces this row with the witness that discriminates the mutation." } },
    MutationEnrolment { gate: "FCI-1", mutation: "reservation-generation-changed-in-disposable-store", discharge: Undischarged { reason: "FCI-1 evidence has not been read by this lane; enrolled undischarged rather than assumed.", restoration_trigger: "The FCI-1 owner replaces this row with the witness that discriminates the mutation." } },
    MutationEnrolment { gate: "FCI-1", mutation: "reservation-payload-work-mismatch", discharge: Undischarged { reason: "FCI-1 evidence has not been read by this lane; enrolled undischarged rather than assumed.", restoration_trigger: "The FCI-1 owner replaces this row with the witness that discriminates the mutation." } },
    MutationEnrolment { gate: "FCI-1", mutation: "selected-offer-cell-mismatch", discharge: Undischarged { reason: "FCI-1 evidence has not been read by this lane; enrolled undischarged rather than assumed.", restoration_trigger: "The FCI-1 owner replaces this row with the witness that discriminates the mutation." } },
    MutationEnrolment { gate: "FCI-1", mutation: "cell-substrate-not-converged", discharge: Undischarged { reason: "FCI-1 evidence has not been read by this lane; enrolled undischarged rather than assumed.", restoration_trigger: "The FCI-1 owner replaces this row with the witness that discriminates the mutation." } },
    MutationEnrolment { gate: "FCI-1", mutation: "cell-resource-boundary-digest-mismatch", discharge: Undischarged { reason: "FCI-1 evidence has not been read by this lane; enrolled undischarged rather than assumed.", restoration_trigger: "The FCI-1 owner replaces this row with the witness that discriminates the mutation." } },
    MutationEnrolment { gate: "FCI-1", mutation: "reservation-release-not-observed", discharge: Undischarged { reason: "FCI-1 evidence has not been read by this lane; enrolled undischarged rather than assumed.", restoration_trigger: "The FCI-1 owner replaces this row with the witness that discriminates the mutation." } },
    MutationEnrolment { gate: "FCI-1", mutation: "reservation-unexpected-extra-generation", discharge: Undischarged { reason: "FCI-1 evidence has not been read by this lane; enrolled undischarged rather than assumed.", restoration_trigger: "The FCI-1 owner replaces this row with the witness that discriminates the mutation." } },
    MutationEnrolment { gate: "FCI-1", mutation: "reservation-release-destroys-cell-substrate", discharge: Undischarged { reason: "FCI-1 evidence has not been read by this lane; enrolled undischarged rather than assumed.", restoration_trigger: "The FCI-1 owner replaces this row with the witness that discriminates the mutation." } },
    MutationEnrolment { gate: "FCI-1", mutation: "multiple-cells", discharge: Undischarged { reason: "FCI-1 evidence has not been read by this lane; enrolled undischarged rather than assumed.", restoration_trigger: "The FCI-1 owner replaces this row with the witness that discriminates the mutation." } },
    MutationEnrolment { gate: "FCI-1", mutation: "unowned-cell", discharge: Undischarged { reason: "FCI-1 evidence has not been read by this lane; enrolled undischarged rather than assumed.", restoration_trigger: "The FCI-1 owner replaces this row with the witness that discriminates the mutation." } },
    MutationEnrolment { gate: "FCI-2", mutation: "duplicate-grant", discharge: DischargedByWitness { witness: WitnessIdentity { module_path: "test.claim.fabric_grant_issuance_witness", function: "a_second_grant_for_one_attempt_is_refused" } } },
    MutationEnrolment { gate: "FCI-2", mutation: "work-mismatch", discharge: DischargedByWitness { witness: WitnessIdentity { module_path: "test.claim.fabric_grant_issuance_witness", function: "an_attempt_naming_another_work_is_refused" } } },
    MutationEnrolment { gate: "FCI-2", mutation: "expired-reservation", discharge: Undischarged { reason: "The issuance kernel has no expiry decision arm: a reservation carries no epoch that issuance reads, so no input distinguishes a live reservation from an expired one and the refusal is unauthorable. This row is the mutation whose absence was asserted as covered in a pull request description before this lens existed.", restoration_trigger: "A lifetime-held canonical reservation verdict exists that issuance must consume, sufficient for an expired reservation to be UNABLE TO AUTHORIZE -- an epoch merely being modeled and read is insufficient, because reading or copying an expired epoch still satisfies that sentence." } },
    MutationEnrolment { gate: "FCI-3", mutation: "grant-removed", discharge: Undischarged { reason: "FCI-3 is unbuilt: no executor re-reads a committed grant.", restoration_trigger: "Process start consumes a capability constructible only from a grant observed live at start, sufficient for absent, corrupt or expired input to yield ZERO target processes -- re-reading the grant is insufficient, since an executor may re-read and start anyway." } },
    MutationEnrolment { gate: "FCI-3", mutation: "grant-corrupt", discharge: Undischarged { reason: "FCI-3 is unbuilt: no executor re-reads a committed grant.", restoration_trigger: "Process start consumes a capability constructible only from a grant observed live at start, sufficient for absent, corrupt or expired input to yield ZERO target processes -- re-reading the grant is insufficient, since an executor may re-read and start anyway." } },
    MutationEnrolment { gate: "FCI-3", mutation: "grant-expired", discharge: Undischarged { reason: "FCI-3 is unbuilt: no executor re-reads a committed grant.", restoration_trigger: "Process start consumes a capability constructible only from a grant observed live at start, sufficient for absent, corrupt or expired input to yield ZERO target processes -- re-reading the grant is insufficient, since an executor may re-read and start anyway." } },
    MutationEnrolment { gate: "FCI-4", mutation: "duplicate-receipt", discharge: Undischarged { reason: "FCI-4 is unbuilt: nothing admits a receipt.", restoration_trigger: "Admission advances a standing population atomically under the deduplication key, sufficient for a second delivery to add no standing -- a dedup path that merely exists is insufficient if a second path can admit around it." } },
    MutationEnrolment { gate: "FCI-4", mutation: "foreign-receipt", discharge: Undischarged { reason: "FCI-4 is unbuilt: nothing admits a receipt.", restoration_trigger: "Admission requires the receipt to agree with the attempt on subject AND principal, sufficient for a foreign receipt to be refused -- deduplication by a fenced key establishes neither agreement and would satisfy a key-only trigger while the defect stood." } },
    MutationEnrolment { gate: "FCI-4", mutation: "release-before-sanitation", discharge: Undischarged { reason: "FCI-4 is unbuilt: nothing releases a cell.", restoration_trigger: "Release CONSUMES a capability constructible only from confirmed successful sanitation, sufficient for no release to exist that is not so ordered -- one path ordered after sanitation is insufficient, because it does not exclude a second release path." } },
    MutationEnrolment { gate: "FCI-4", mutation: "failed-sanitation", discharge: Undischarged { reason: "FCI-4 is unbuilt: nothing sanitizes a cell.", restoration_trigger: "Release CONSUMES a capability constructible only from confirmed successful sanitation, sufficient for no release to exist that is not so ordered -- one path ordered after sanitation is insufficient, because it does not exclude a second release path." } },
    MutationEnrolment { gate: "FCI-5", mutation: "receipt-absent", discharge: Undischarged { reason: "FCI-5 is unbuilt: no shadow job derives a conclusion.", restoration_trigger: "A deployed shadow job can produce a passing conclusion ONLY by consuming an admitted successful receipt whose FULL SUBJECT IDENTITY agrees with the exact Work that job submitted, sufficient for absent, refused, unsuccessful and different-subject receipts alike to produce no passing shadow standing -- deriving the conclusion only from an admitted receipt is insufficient, because a receipt genuinely and correctly admitted for another Work satisfies that sentence while the subject-mismatch mutation survives." } },
    MutationEnrolment { gate: "FCI-5", mutation: "receipt-refused", discharge: Undischarged { reason: "FCI-5 is unbuilt: no shadow job derives a conclusion.", restoration_trigger: "A deployed shadow job can produce a passing conclusion ONLY by consuming an admitted successful receipt whose FULL SUBJECT IDENTITY agrees with the exact Work that job submitted, sufficient for absent, refused, unsuccessful and different-subject receipts alike to produce no passing shadow standing -- deriving the conclusion only from an admitted receipt is insufficient, because a receipt genuinely and correctly admitted for another Work satisfies that sentence while the subject-mismatch mutation survives." } },
    MutationEnrolment { gate: "FCI-5", mutation: "receipt-subject-mismatch", discharge: Undischarged { reason: "FCI-5 is unbuilt: no shadow job derives a conclusion.", restoration_trigger: "A deployed shadow job can produce a passing conclusion ONLY by consuming an admitted successful receipt whose FULL SUBJECT IDENTITY agrees with the exact Work that job submitted, sufficient for absent, refused, unsuccessful and different-subject receipts alike to produce no passing shadow standing -- deriving the conclusion only from an admitted receipt is insufficient, because a receipt genuinely and correctly admitted for another Work satisfies that sentence while the subject-mismatch mutation survives." } },
    MutationEnrolment { gate: "FCI-6", mutation: "direct-invocation-present", discharge: Undischarged { reason: "FCI-6 is unbuilt: the required check has not cut over.", restoration_trigger: "The fabric-derived result is the required merge-admission dependency AND no direct required-witnesses-build invocation remains reachable, sufficient for the two not to coexist -- making the fabric result required does not by itself remove the direct invocation." } },
    MutationEnrolment { gate: "FCI-6", mutation: "fabric-result-not-required", discharge: Undischarged { reason: "FCI-6 is unbuilt: the required check has not cut over.", restoration_trigger: "The fabric-derived result IS the required merge-admission dependency, sufficient for no merge to be admissible without it -- a fabric result that merely exists, or is reported alongside the direct one, leaves this mutation live." } },
    MutationEnrolment { gate: "FCI-6", mutation: "receipt-absent", discharge: Undischarged { reason: "FCI-6 is unbuilt: the required check has not cut over.", restoration_trigger: "The required conclusion is DERIVED FROM an admitted receipt and has no other source, sufficient for an absent receipt to yield no passing required conclusion -- a required fabric check that can conclude by any other route leaves this mutation live." } },
  ]
}

// ============================================================================
// EARNED STANDING. The census above answers "is the enrolment WELL-FORMED?".
// It cannot answer "is this obligation COVERED?", because a DischargedByWitness row is a
// NOMINATION written by an author and nothing in the join reads evidence. The FCI authority states
// the boundary itself: a gate may acquire standing only from an executed receipt, and no such
// receipt join existed. This is that join.
//
// THE SEPARATION IS THE WHOLE POINT. A nomination is authored and says which declaration SHOULD
// discharge an obligation. An observation is evidence and says which declaration DID run, over what
// subject, and what it terminated as. Standing is DERIVED from the pair and is authored by nobody.
// Hold the obligations and the nominations fixed, remove the evidence, and well-formedness is
// unchanged while standing must collapse -- that is the acceptance test this construction exists to
// pass, and the reason the two verdicts are separate functions rather than one widened one.
//
// WHY THIS IS NOT THE EXISTING RECEIPT ADMISSION. product.fabric.execution admit_receipt_for_grant
// compares attempt and lease relations; it consumes no gate obligation, no witness declaration and
// no expected observation. A receipt correctly admitted for ITS OWN subject is irrelevant to this
// consumer's question -- the same shape as the FCI-5 counterexample where a receipt genuinely
// admitted for another Work satisfied a trigger while the mutation survived. Relevance to the
// obligation is a relation this module must establish and may not inherit.
// THESE NAMES ARE FABRIC-SCOPED BECAUSE BARE NAMES RESOLVE CORPUS-WIDE. This module first
// declared them as StandingCause, standing_for, render_disposition, render_cause and
// render_standing, each of which already had a declarer elsewhere in the corpus -- and
// render_disposition's other declarer is floor_terminal_ledger_wire, a module this one IMPORTS.
//
// gunbc.bare_name_fork_lens states the mechanism exactly: two modules declaring one bare name is
// an error at neither declaration, only at a CALL SITE, and only under a closure containing both
// declarers. A per-entry compile contains one and reports clean; the floor's whole-corpus
// preparation contains both and refuses. That is why this was invisible to every check available
// to me and visible only to the gate -- and why the diagnostic pointed at
// frontier_ingestion_probe, a module I never touched.
type GateStandingCause
  = NominationHasNoObservation { witness: WitnessIdentity }
  | NominationIsHeldAsAKnownRed { witness: WitnessIdentity }
  | ObservedWrongTerminal { witness: WitnessIdentity }
  | SeveralObservationsForOneNomination { witness: WitnessIdentity }
  | NotNominated {}

type ObligationStanding
  = Covered { gate: NonEmptyStr, mutation: NonEmptyStr, witness: WitnessIdentity }
  | NotCovered { gate: NonEmptyStr, mutation: NonEmptyStr, cause: GateStandingCause }

// Standing is refused wholesale when the census is refused: a partition computed over a roster known
// to disagree with its authority would report coverage for obligations that may not exist.
type GateStandingVerdict
  = StandingDerived { covered: List<ObligationStanding>, uncovered: List<ObligationStanding> }
  | StandingRefusedUnwellFormedEnrolment { refusals: List<CoverageRefusal> }
  | StandingRefusedLedgerIsOfAnotherSubject { observed: Fnv1a64Structural, adjudicated: Fnv1a64Structural }
  | StandingRefusedLedgerIsOfAnotherRevision {}
  | StandingRefusedLedgerIsNotCandidateBound {}

fn witness_identity_eq(a: WitnessIdentity, b: WitnessIdentity) -> Bool {
  a.module_path == b.module_path && a.function == b.function
}

// THE ADJUDICATION SUBJECT IS AN OBSERVATION, NOT A ROW TYPE, AND THAT IS WHAT LETS ONE CORE SERVE
// BOTH READERS. The witnesses hand this module typed ClaimTerminalRows; production hands it rows
// PARSED BACK from a published ledger, which carry a wire tag and a qualified name and no
// ClaimAttemptTerminal at all. Keying the standing logic on either row type would have forked the
// adequacy question in two -- one typed, one string-keyed -- and the fork would be invisible,
// because each half would be green against its own fixtures while disagreeing about which witness
// discharges an obligation. So both row types PROJECT into this one carrier and the standing
// derivation has a single definition.
//
// THE JOIN KEY IS THE QUALIFIED NAME BECAUSE THAT IS WHAT THE ARTIFACT CARRIES. A published ledger
// row has no module/function pair to join on; it has the one string the wire renders from that
// pair. This is spelling-keyed where declaration identity would be preferable, and it is forced
// rather than chosen: the identity is reconstructible only through the same encoding. What keeps
// it honest is that the encoding has ONE producer -- witness_identity_qualified_name -- used by the
// renderer and by this projection, so the two sides cannot disagree about the spelling.
type NominationObservation {
  qualified: String
  expectation: ClaimExpectation
  holds: Bool
}

fn observation_of_terminal_row(r: ClaimTerminalRow) -> NominationObservation {
  NominationObservation {
    qualified: witness_identity_qualified_name(identity: r.identity),
    expectation: r.expectation,
    holds: terminal_holds(r.terminal),
  }
}

// THE READBACK PROJECTION READS THE TAG, NOT A RECONSTRUCTED TERMINAL, AND THE DIFFERENCE IS
// HONESTY ABOUT WHAT THE ARTIFACT HOLDS. Inverting the wire into a ClaimAttemptTerminal is not
// total: BudgetRefused renders one detail string from three fields, so a reconstruction would have
// to invent the cpu and wall figures it lost. Inventing them to satisfy a type is the fabricated
// plausible output DESIGN section 5 forbids. The one fact this adjudication needs -- did the
// witness return and hold -- IS carried losslessly, by exactly one tag, and that tag is named by
// its producer rather than respelled here.
fn observation_of_readback_row(r: LedgerReadbackRow) -> NominationObservation {
  NominationObservation {
    qualified: r.qualified,
    expectation: r.expectation,
    holds: r.terminal_tag == ledger_returned_true_tag,
  }
}

fn observations_naming(
  observations: List<NominationObservation>,
  witness: WitnessIdentity,
) -> List<NominationObservation> {
  filter(observations, o => o.qualified == witness_identity_qualified_name(identity: witness))
}

// ADEQUACY IS "THE WITNESS ESTABLISHED ITS PROPERTY", NOT "THE CLAIM AGREED WITH THE ROSTER".
//
// An earlier revision made adequacy the agreement of ClaimExpectation with ClaimObservation, so an
// ExpectedRed row observing holds=false earned Covered. That is a FAIL-OPEN, and it is the FCI-5
// counterexample one level deeper: ExpectedRed is the FLOOR's bookkeeping -- this claim is a known
// red we tolerate, counted as known_red_held -- and agreeing with that expectation is agreement
// about the FLOOR's question, not evidence for the GATE's. A witness held as a known red asserted
// nothing about its mutation; treating it as coverage lets a KNOWN-BROKEN witness discharge an
// obligation, which is the exact state a coverage instrument exists to refuse.
//
// So a gate obligation is discharged only by a witness that RETURNED AND HELD, and an ExpectedRed
// nomination is a NAMED cause rather than a silent non-coverage: it says the roster itself already
// records this witness as not establishing anything.
fn terminal_holds(terminal: ClaimAttemptTerminal) -> Bool {
  match terminal {
    Returned { observation } => match observation {
      ObservedVerdict { holds } => holds,
      ObservationUnrepresentable { reason } => false,
    },
    RuntimeErrored { message } => false,
    Panicked { payload } => false,
    NotAttempted { halted_by } => false,
    BudgetRefused { safety } => false,
    HostToolUnresolved { name, probed } => false,
    RouteGap { operation, ground } => false,
  }
}

fn expectation_is_to_hold(expectation: ClaimExpectation) -> Bool {
  match expectation {
    ExpectedToHold => true,
    ExpectedRed => false,
  }
}

// ONE NOMINATION, ONE OBSERVATION, ONE REVISION, ONE ADEQUATE TERMINAL. Anything else is a named
// cause. Note that exactly-one is required of the BINDING, not of the witness: a declaration may
// deliberately discharge two obligations, but an ambiguous or duplicated observation may never be
// counted as coverage.
fn gate_standing_for(
  e: MutationEnrolment,
  observations: List<NominationObservation>,
) -> ObligationStanding {
  match e.discharge {
    Undischarged { reason, restoration_trigger } =>
      NotCovered { gate: e.gate, mutation: e.mutation, cause: NotNominated {} },
    DischargedByWitness { witness } => {
      let seen = observations_naming(observations, witness)
      if seen.length() == 0 {
        NotCovered { gate: e.gate, mutation: e.mutation, cause: NominationHasNoObservation { witness: witness } }
      } else if seen.length() > 1 {
        NotCovered { gate: e.gate, mutation: e.mutation, cause: SeveralObservationsForOneNomination { witness: witness } }
      } else if !all(seen, o => expectation_is_to_hold(o.expectation)) {
        NotCovered { gate: e.gate, mutation: e.mutation, cause: NominationIsHeldAsAKnownRed { witness: witness } }
      } else if !all(seen, o => o.holds) {
        NotCovered { gate: e.gate, mutation: e.mutation, cause: ObservedWrongTerminal { witness: witness } }
      } else {
        Covered { gate: e.gate, mutation: e.mutation, witness: witness }
      }
    },
  }
}

// THE SAME SPLIT, THE SAME REASONING, one authority per population. See partition_enrolments
// above for why this stays two linear filters rather than becoming one quadratic fold.
fn is_covered(s: ObligationStanding) -> Bool {
  match s {
    Covered { gate, mutation, witness } => true,
    NotCovered { gate, mutation, cause } => false,
  }
}

type StandingPartition {
  covered: List<ObligationStanding>
  uncovered: List<ObligationStanding>
}

fn partition_standings(standings: List<ObligationStanding>) -> StandingPartition {
  StandingPartition {
    covered: filter(standings, s => is_covered(s)),
    uncovered: filter(standings, s => !is_covered(s)),
  }
}

// THE ADJUDICATION SUBJECT IS TWO FACTS, AND AN EARLIER REVISION READ ONLY ONE. It compared the
// prepared-subject digest and never read repository_snapshot at all, so standing could not change
// when the revision did: two commits can share a prepared inventory whenever their difference lies
// outside the prepared population, and the module's own positive fixture -- which always built
// UnpublishedWorkingTree -- earned coverage. That is a local prepared-subject calculation wearing
// the name of revision-bound admission. The ledger authority says as much in its own header: the ref
// says WHICH commit a human opens, the digest says WHAT was admitted, and they diverge on every run.
//
// AN UNPUBLISHED WORKING TREE CANNOT EARN CANDIDATE-BOUND STANDING AT ALL. It names no commit, so
// there is no revision for the evidence to be bound to, and admitting it would let standing be
// earned for a tree nobody can name. Both refusals are wholesale rather than per-row, because a
// ledger of the wrong revision is not a ledger with no coverage.
fn gate_standing(
  gates: List<FabricCiGate>,
  enrolments: List<MutationEnrolment>,
  binding: LedgerBinding,
  rows: List<ClaimTerminalRow>,
  adjudicated_revision: RepositorySnapshot,
  adjudicated_subject: Fnv1a64Structural,
) -> GateStandingVerdict {
  gate_standing_over_observations(
    gates,
    enrolments,
    binding,
    map(rows, r => observation_of_terminal_row(r)),
    adjudicated_revision,
    adjudicated_subject,
  )
}

// THE DROPPED GUARD IS A VALUE, NOT A SENTENCE, AND THAT IS THE WHOLE REPAIR.
//
// An earlier revision of the production entry passed the ledger's OWN prepared subject in as the
// adjudicated one and explained in an annotation that the comparison was therefore vacuous. Both
// halves of that were bad. The comparison still EXECUTED, permanently true, so a reader of the
// executed path sees a subject guard and reads it as coverage -- and no Accepted program can read
// the annotation saying otherwise (DESIGN 4c). A guard that cannot fail is not a weak guard; it is
// a decoration that will be cited as one.
//
// So the caller now STATES which it has. SubjectNotIndependentlyBound is not a null and not a
// default: it says this caller has no digest that came from anywhere but the ledger, so no
// comparison is performed and none is claimed. The arm that compares is reachable only from a
// caller holding a digest it did not read out of the artifact -- which the witnesses hold and
// production does not.
type SubjectAdmission
  = SubjectAdjudicated { digest: Fnv1a64Structural }
  | SubjectNotIndependentlyBound {}

fn gate_standing_over_observations(
  gates: List<FabricCiGate>,
  enrolments: List<MutationEnrolment>,
  binding: LedgerBinding,
  observations: List<NominationObservation>,
  adjudicated_revision: RepositorySnapshot,
  adjudicated_subject: Fnv1a64Structural,
) -> GateStandingVerdict {
  gate_standing_admitted(
    gates,
    enrolments,
    binding,
    observations,
    adjudicated_revision,
    SubjectAdjudicated { digest: adjudicated_subject },
  )
}

// The tail every admitted path shares: the roster must be well formed, and standing is derived per
// obligation. Extracted so the subject arms below differ ONLY in whether they compare, rather than
// each carrying its own copy of the derivation -- two copies of this would be two places for the
// adequacy rule to drift.
fn derive_standing(
  gates: List<FabricCiGate>,
  enrolments: List<MutationEnrolment>,
  observations: List<NominationObservation>,
) -> GateStandingVerdict {
  match gate_coverage(gates, enrolments) {
    CoverageRefused { refusals } => StandingRefusedUnwellFormedEnrolment { refusals: refusals },
    CoverageTotal { discharged, undischarged } => {
      let all_standings = map(concat(discharged, undischarged), e => gate_standing_for(e, observations))
      let split = partition_standings(all_standings)
      StandingDerived { covered: split.covered, uncovered: split.uncovered }
    },
  }
}

fn gate_standing_admitted(
  gates: List<FabricCiGate>,
  enrolments: List<MutationEnrolment>,
  binding: LedgerBinding,
  observations: List<NominationObservation>,
  adjudicated_revision: RepositorySnapshot,
  adjudicated_subject: SubjectAdmission,
) -> GateStandingVerdict {
  match binding.repository_snapshot {
    UnpublishedWorkingTree => StandingRefusedLedgerIsNotCandidateBound {},
    PublishedCommit { commit } => match adjudicated_revision {
      UnpublishedWorkingTree => StandingRefusedLedgerIsNotCandidateBound {},
      PublishedCommit { commit: wanted } =>
        if !git_object_id_eq(commit, wanted) {
          StandingRefusedLedgerIsOfAnotherRevision {}
        } else {
          match adjudicated_subject {
            SubjectNotIndependentlyBound {} => derive_standing(gates, enrolments, observations),
            SubjectAdjudicated { digest } =>
              if binding.prepared_subject.digest != digest.digest {
                StandingRefusedLedgerIsOfAnotherSubject {
                  observed: binding.prepared_subject,
                  adjudicated: digest,
                }
              } else {
                derive_standing(gates, enrolments, observations)
              },
          }
        },
    },
  }
}

// ── CAN THE PRODUCER EVER SUPPLY WHAT THIS CONSUMER DEMANDS? ──────────────────────────────────
//
// THE DEFECT THIS ANSWERS, MEASURED. The required step below demands a terminal-ledger row for every
// nominated witness. On main's own ordinary run every test.claim.fabric identity was
// declined_outside_gate_closure and not_executed, so the ledger carried no row for either FCI-2
// nomination and the step reddened on every pull request that did not happen to edit those files.
// That is a wall whose verdict does not depend on the repository -- the same defect as a wall that
// can only pass, and it reached six approvals.
//
// THE JUDGMENT LIVES HERE AND NOT IN gate_coverage, AND THE BOUNDARY IS THE POINT. "Is this
// nomination well formed" and "can this producer supply this consumer's evidence" are different
// questions with different inputs: a perfectly well-formed nomination can be unusable against a
// particular producer without becoming malformed. So the census keeps answering the first and the
// roster stays CoverageTotal, while this binding refuses -- which preserves the nomination-versus-
// standing distinction rather than collapsing it. The floor stays ignorant of fabric gates; the
// dependency runs one way, from whoever asserts coverage to the planning authority.
//
// IT IS THE ORDINARY DECISION, DELIBERATELY, AND THIS IS THE SUBTLE HALF. required_floor_site_
// disposition computes the policy answer BEFORE the changed-witness overlay, and that is the fact
// this consumer needs. Joining against the effective plan of the invocation at hand would accept a
// nomination whose witness the author edited in the same pull request -- changed-witness selection
// schedules it, it passes, the join accepts, and the NEXT ordinary run fails. That is precisely the
// one-run escape this check exists to remove, reintroduced by the check. Nor may the overlay's tag
// simply be refused: an ordinarily planned witness can also carry PlannedAsChangedWitness, so
// refusing it would manufacture a false incompatibility.
//
// WHAT THIS DOES NOT ESTABLISH, because a prefix is not a plan and this function is not the whole
// predicate: it does not prove the DECLARATION EXISTS, and it does not prove the module was
// prepared -- DeclinedOutsideGateClosure names a module never prepared at all and is decided
// elsewhere. Those are settled by the invocation's own evidence: a nomination that is ordinarily
// Planned and still has no observation in the published ledger is refused below, which is exactly
// where a fabricated function name under a matching module prefix lands.
type PlanningIncompatibility {
  gate: NonEmptyStr
  mutation: NonEmptyStr
  witness: WitnessIdentity
  disposition: RequiredFloorDisposition
}

fn ordinary_disposition_of(witness: WitnessIdentity) -> RequiredFloorDisposition {
  required_floor_site_disposition(
    module_path: witness.module_path as String,
    identity: witness_identity_qualified_name(identity: witness),
  )
}

fn disposition_is_ordinarily_planned(d: RequiredFloorDisposition) -> Bool {
  match d {
    Planned => true,
    PlannedAsChangedWitness => false,
    DeclinedLongModule { matched_prefix } => false,
    DeclinedFixtureMember { matched_prefix } => false,
    DeclinedOutsideRequiredGate => false,
    DeclinedOutsideGateClosure => false,
    DeclinedDiscoveryExcluded { matched_substring } => false,
    DeclinedCostDebt => false,
  }
}

fn render_ordinary_disposition(d: RequiredFloorDisposition) -> String {
  match d {
    Planned => "planned",
    PlannedAsChangedWitness => "planned-as-changed-witness",
    DeclinedLongModule { matched_prefix } => concat("declined-long-module:", matched_prefix),
    DeclinedFixtureMember { matched_prefix } => concat("declined-fixture-member:", matched_prefix),
    DeclinedOutsideRequiredGate => "declined-outside-required-gate",
    DeclinedOutsideGateClosure => "declined-outside-gate-closure",
    DeclinedDiscoveryExcluded { matched_substring } => concat("declined-discovery-excluded:", matched_substring),
    DeclinedCostDebt => "declined-cost-debt",
  }
}

fn planning_incompatibilities(enrolments: List<MutationEnrolment>) -> List<PlanningIncompatibility> {
  flat_map(enrolments, e => match e.discharge {
    Undischarged { reason, restoration_trigger } => [],
    DischargedByWitness { witness } => {
      let d = ordinary_disposition_of(witness)
      if disposition_is_ordinarily_planned(d) { [] } else {
        [PlanningIncompatibility { gate: e.gate, mutation: e.mutation, witness: witness, disposition: d }]
      }
    },
  })
}

fn render_incompatibility(i: PlanningIncompatibility) -> String {
  concat(concat("  UNPLANNABLE ", i.gate as String),
    concat(concat("|", i.mutation as String),
      concat(concat("|", witness_identity_qualified_name(identity: i.witness)),
             concat("|", render_ordinary_disposition(i.disposition)))))
}

// ── THE RETAINED CONSUMER ──────────────────────────────────────────────────────────────────────
//
// EVERYTHING ABOVE IS A DECISION PROCEDURE WITH NO PRODUCTION CALLER, AND A DECISION PROCEDURE
// NOTHING CALLS IS SPECIFICATION WITHOUT EXECUTION. The witnesses establish that gate_standing
// refuses what it should refuse; they establish nothing about the repository, because their rows
// are fixtures. What makes the derivation a fact about THIS tree is a caller that hands it the
// ledger the required floor actually published, at the revision under adjudication.
//
// THE SUBJECT IS THE PUBLISHED ARTIFACT, NOT A SECOND MEASUREMENT. The floor already renders
// v2.workflow.floor_terminal_ledger_wire's ledger on every required run; this entry reads that same
// file back through that same grammar. It runs no witness, prepares no subject and walks no corpus,
// so its cost is one parse plus one fold over the enrolment roster -- the incremental read, decode
// and adjudication the operator ruling requires of a step that lives inside an existing lane. A
// second execution of the floor's population here would be the cut `fabric-evidence` job wearing a
// step's name, which the workflow authority forbids by its own restoration condition.
//
// THE TWO ADJUDICATED ARGUMENTS ARE THE CALLER'S, DELIBERATELY. The revision and the prepared
// subject say WHAT THIS RUN IS ADJUDICATING, and reading them out of the same file that supplies
// the evidence would make the comparison a tautology -- the ledger would agree with itself and the
// revision wall would be permanently green. They arrive from the run's own environment, so a ledger
// left over from another commit is refused rather than believed.
type FabricStandingReport {
  holds: Bool
  text: String
}

fn standing_refused(text: String) -> FabricStandingReport {
  FabricStandingReport { holds: false, text: text }
}

fn render_gate_standing_cause(cause: GateStandingCause) -> String {
  match cause {
    NominationHasNoObservation { witness } =>
      concat("no-observation:", witness_identity_qualified_name(identity: witness)),
    NominationIsHeldAsAKnownRed { witness } =>
      concat("held-as-known-red:", witness_identity_qualified_name(identity: witness)),
    ObservedWrongTerminal { witness } =>
      concat("wrong-terminal:", witness_identity_qualified_name(identity: witness)),
    SeveralObservationsForOneNomination { witness } =>
      concat("several-observations:", witness_identity_qualified_name(identity: witness)),
    NotNominated {} => "not-nominated",
  }
}

fn render_obligation_standing(s: ObligationStanding) -> String {
  match s {
    Covered { gate, mutation, witness } =>
      concat(concat("  covered ", gate as String), concat(concat("|", mutation as String),
        concat("|", witness_identity_qualified_name(identity: witness)))),
    NotCovered { gate, mutation, cause } =>
      concat(concat("  UNCOVERED ", gate as String), concat(concat("|", mutation as String),
        concat("|", render_gate_standing_cause(cause)))),
  }
}

fn render_refusal(r: CoverageRefusal) -> String {
  match r {
    GateIdDeclaredSeveralTimes { gate } => concat("  duplicate-gate ", gate as String),
    MutationDeclaredSeveralTimes { gate, mutation } =>
      concat(concat("  duplicate-mutation ", gate as String), concat("|", mutation as String)),
    MutationHasNoEnrolmentRow { gate, mutation } =>
      concat(concat("  unenrolled-mutation ", gate as String), concat("|", mutation as String)),
    MutationHasSeveralEnrolmentRows { gate, mutation } =>
      concat(concat("  several-enrolments ", gate as String), concat("|", mutation as String)),
    EnrolmentNamesUnknownGate { gate, mutation } =>
      concat(concat("  unknown-gate ", gate as String), concat("|", mutation as String)),
    EnrolmentNamesUndeclaredMutation { gate, mutation } =>
      concat(concat("  undeclared-mutation ", gate as String), concat("|", mutation as String)),
  }
}

fn lines_of(items: List<String>) -> String {
  fold(items, init: "", f: (acc, line) => concat(acc, concat("\n", line)))
}

// WHAT REDS IS A BROKEN CLAIM OF COVERAGE, NOT A DECLARED GAP, AND GETTING THAT BACKWARDS WOULD
// HAVE MADE THIS STEP UNCONDITIONALLY RED.
//
// The enrolment roster is a coproduct on purpose: a mutation is either discharged by a named
// witness or DECLARED UNDISCHARGED with a restoration trigger. Most rows are the second today.
// Reddening on every uncovered obligation would therefore fail every run from the first one, which
// is the mirror of the vacuous check -- a wall whose verdict does not depend on the repository
// establishes nothing in either direction, and one that is always red gets disabled rather than
// fixed. So an Undischarged row is REPORTED and does not decide the step; it is already visible,
// countable and carrying its trigger.
//
// What reds is a NOMINATION THAT DOES NOT STAND: the roster claims a witness discharges a mutation
// and the published ledger says that witness did not run, ran as a tolerated known red, returned
// something other than a held verdict, or was observed more than once. That is the state a prose
// coverage claim used to be able to reach unchallenged, and it is authorable in this repository by
// deleting or renaming an enrolled witness -- which is what makes this a wall rather than a
// decoration. Both refusal families remain red: an unwell-formed roster and a ledger of the wrong
// revision are failures of the adjudication itself, not declared debt.
// A ROW THE ROSTER NEVER CLAIMED. NotNominated is the ONLY cause that means "no coverage was
// asserted"; every other cause means a coverage assertion failed to stand.
fn standing_is_undeclared(s: ObligationStanding) -> Bool {
  match s {
    Covered { gate, mutation, witness } => false,
    NotCovered { gate, mutation, cause } => match cause {
      NotNominated {} => true,
      NominationHasNoObservation { witness } => false,
      NominationIsHeldAsAKnownRed { witness } => false,
      ObservedWrongTerminal { witness } => false,
      SeveralObservationsForOneNomination { witness } => false,
    },
  }
}

fn render_standing_verdict(v: GateStandingVerdict) -> FabricStandingReport {
  match v {
    StandingRefusedUnwellFormedEnrolment { refusals } =>
      standing_refused(concat(
        concat("FCI-STANDING refused=unwell-formed-enrolment refusals=", refusals.length() as String),
        lines_of(map(refusals, r => render_refusal(r))))),
    StandingRefusedLedgerIsOfAnotherSubject { observed, adjudicated } =>
      standing_refused(concat(
        concat("FCI-STANDING refused=ledger-of-another-subject observed=", observed.digest),
        concat(" adjudicated=", adjudicated.digest))),
    StandingRefusedLedgerIsOfAnotherRevision {} =>
      standing_refused("FCI-STANDING refused=ledger-of-another-revision"),
    StandingRefusedLedgerIsNotCandidateBound {} =>
      standing_refused("FCI-STANDING refused=ledger-is-not-candidate-bound"),
    StandingDerived { covered, uncovered } => {
      let broken = filter(uncovered, s => !standing_is_undeclared(s))
      let declared = filter(uncovered, s => standing_is_undeclared(s))
      FabricStandingReport {
        holds: broken.length() == 0,
        text: concat(
          concat(
            concat("FCI-STANDING verdict=", if broken.length() == 0 { "nominations-stand" } else { "nomination-broken" }),
            concat(concat(" covered=", covered.length() as String),
                   concat(concat(" broken=", broken.length() as String),
                          concat(" declared-undischarged=", declared.length() as String)))),
          concat(lines_of(map(broken, s => render_obligation_standing(s))),
                 lines_of(map(covered, s => render_obligation_standing(s))))),
      }
    },
  }
}

// WHAT THIS ENTRY BINDS INDEPENDENTLY, AND WHAT IT DOES NOT -- STATED HERE BECAUSE THE ALTERNATIVE
// IS A PERMANENTLY GREEN COMPARISON WEARING A WALL'S NAME.
//
// THE REVISION IS INDEPENDENTLY BOUND. The ledger header carries the commit the FLOOR was told it
// was running at; the caller supplies the commit of the tree it is standing in, read by a different
// instrument in a different process. A ledger left in target/ by an earlier run of another commit
// therefore refuses, which is the whole failure this guard exists for.
//
// THE PREPARED SUBJECT IS NOT. Recomputing it here would be the whole-tree preparation this step
// exists to avoid paying twice, and no other artifact of the run carries it, so the only value
// available to compare against is the one the ledger itself states. Passing that value in would be
// a comparison whose passing value is also its broken value -- green whether or not the subject is
// right -- so this entry does not take one, and the subject guard's production standing is DROPPED
// rather than faked. TRIGGER (DESIGN 4b(3)): an output of the floor step carrying this run's
// prepared-subject digest, SUFFICIENT FOR this adjudication to compare the ledger's header against
// a digest it did not read out of the ledger. The guard itself stays live and covered by witnesses
// through gate_standing, which every fixture exercises; what is dropped is its production caller.
//
// THE SEAL IS CONSUMED, NOT MERELY PARSED. An earlier revision destructured footer_digest and
// ignored it, so a ledger whose ROWS had been edited while its footer was left alone parsed cleanly
// and adjudicated as evidence. Structural readability is not integrity: the count says how many
// rows, the digest says WHICH, and only the second survives a row being rewritten in place.
// readback_digest_agrees recomputes it from the rows this reader parsed and compares it to the one
// the file carries -- that is the wire authority's own check, so consuming it is not a second
// opinion about integrity, it is the first consumer of the one that already existed.
//
// THE DEMAND IS CHECKED BEFORE THE ARTIFACT, and the order carries a meaning. A roster that
// nominates witnesses the producer will never ordinarily plan is wrong whatever any particular
// ledger happens to contain, so reporting it as a coverage gap would send the reader to look for
// missing evidence when the demand itself is unsatisfiable. Refusing first names the actual fault.
//
// THE SEAL DOES NOT COVER EVERY FIELD, so two more admissions run beside it. readback_rows_digest
// is computed over the SERIALIZED ROWS only: the footer's row count and the header's roster
// identity are neither rows nor inputs to it, so a ledger whose count is replaced with
// "not-a-count", or whose roster identity is overwritten wholesale, passed the seal comparison
// untouched. Both were reachable counterexamples against a consumer that checked the seal alone.
//
// Both are now recomputed from the rows this reader parsed, and each refuses under its OWN cause
// so no negative can pass on the wrong field.
//
// WHAT THESE TWO ARE NOT. They are self-consistency: they establish that the artifact agrees with
// itself, never that it is the ledger some plan expected. An earlier note here argued the count
// should therefore not be checked at all, on the grounds that a truncation rewriting the rows AND
// the count AND the digest together would satisfy it. That is right, and it is an argument that
// the check is INSUFFICIENT, not that it is empty -- it does not reach the mutation it was
// written against, which alters one field and leaves the rest of a genuine ledger intact.
//
// The independent question -- is this the ledger the plan expected -- still needs a planned count
// from the producer's own lifecycle, which this consumer does not hold. readback_footer_count_agrees
// takes that Int and is deliberately NOT called here. Nothing below may cite these two as having
// answered it.
fn adjudicate_published_ledger(
  ledger_text: String,
  adjudicated_commit_hex: String,
) -> FabricStandingReport {
  adjudicate_ledger_for(fabric_mutation_enrolments(), ledger_text, adjudicated_commit_hex)
}

// THE ROSTER IS A PARAMETER SO THE ARTIFACT PATH STAYS REACHABLE UNDER TEST, and that is a real
// seam rather than a testing convenience. The demand check refuses FIRST and, on today's tree,
// refuses always -- so with the production roster wired in, no witness could reach the parse, the
// seal, the revision guard or the standing derivation at all. Every one of them would have gone on
// passing while asserting nothing about the code it names, which is the failure this module keeps
// finding in its own evidence.
//
// The production entry above binds the real roster and is the only caller that does. A witness
// binds a fixture roster whose nominations ARE ordinarily planned, so it exercises the artifact
// path; another binds one that is not, and exercises the refusal. Neither can drift from the
// production behaviour, because both run this same function.
fn adjudicate_ledger_for(
  enrolments: List<MutationEnrolment>,
  ledger_text: String,
  adjudicated_commit_hex: String,
) -> FabricStandingReport {
  let unplannable = planning_incompatibilities(enrolments)
  if unplannable.length() > 0 {
    standing_refused(concat(
      concat("FCI-STANDING refused=nomination-not-planned-by-producer count=", unplannable.length() as String),
      lines_of(map(unplannable, i => render_incompatibility(i)))))
  } else {
  let readback = parse_ledger(text: ledger_text)
  match readback {
    LedgerUnreadable { reason, at } =>
      standing_refused(concat("FCI-STANDING refused=ledger-unreadable reason=", reason as String)),
    LedgerRead { repository_snapshot, prepared_subject, roster_identity, rows, footer_row_count_wire, footer_digest } =>
      if !readback_digest_agrees(readback: readback) {
        standing_refused("FCI-STANDING refused=ledger-seal-disagrees-with-its-rows")
      } else if !readback_footer_count_matches_its_own_rows(readback: readback) {
        standing_refused("FCI-STANDING refused=ledger-footer-count-disagrees-with-its-rows")
      } else if !readback_roster_identity_agrees(readback: readback) {
        standing_refused("FCI-STANDING refused=ledger-roster-identity-disagrees-with-its-rows")
      } else {
      match admit_repository_snapshot_wire(wire: repository_snapshot) {
        SnapshotWireUnrecognized { offending } =>
          standing_refused(concat("FCI-STANDING refused=ledger-snapshot-unrecognized offending=", offending)),
        SnapshotAdmitted { snapshot: observed_snapshot } =>
          match admit_repository_snapshot_wire(wire: adjudicated_commit_hex) {
            SnapshotWireUnrecognized { offending } =>
              standing_refused(concat("FCI-STANDING refused=adjudicated-revision-unrecognized offending=", offending)),
            SnapshotAdmitted { snapshot: adjudicated_snapshot } =>
              match fnv1a64_structural_hex_digest(hex: prepared_subject) {
                Absent =>
                  standing_refused(concat("FCI-STANDING refused=ledger-subject-unrecognized offending=", prepared_subject)),
                Present { value: observed_subject } =>
                  render_standing_verdict(gate_standing_admitted(
                    fabric_ci_gates(),
                    enrolments,
                    LedgerBinding {
                      repository_snapshot: observed_snapshot,
                      prepared_subject: observed_subject,
                    },
                    map(rows, r => observation_of_readback_row(r)),
                    adjudicated_snapshot,
                    SubjectNotIndependentlyBound {},
                  )),
              },
          },
      }
      },
  }
  }
}
