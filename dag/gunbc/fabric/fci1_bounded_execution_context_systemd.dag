module gunbc.fci1_bounded_execution_context_systemd

import std.types { List, NonEmptyStr, String }
import extdeps.systemd { WorkingDirectoryProperty, MemoryMax, MemoryHigh }
import extdeps.systemd.systemd_run { SystemdRunProperty }
import gunbc.fci1_bounded_execution_context {
  Fci1BoundedExecutionContext, finite_byte_size_count,
}
import v2.std.optional { Present, Absent }

// This is realization, not part of either the product context or the systemd interface. It is the
// only binding from the FCI-1 envelope to transient-unit properties. Callers cannot supply a
// property population, so duplicate WorkingDirectory/MemoryMax settings and observation-only
// properties have no constructor on this path. Byte spellings are projections of FiniteByteSize,
// never independently authored strings.
fn fci1_bounded_context_systemd_properties(
  context: Fci1BoundedExecutionContext,
) -> List<SystemdRunProperty> {
  let required = [
    SystemdRunProperty {
      property: WorkingDirectoryProperty,
      value: context.checkout_root as String as NonEmptyStr,
    },
    SystemdRunProperty {
      property: MemoryMax,
      value: to_string(finite_byte_size_count(size: context.memory_max)) as NonEmptyStr,
    },
  ]
  match context.memory_high {
    Present { value: high } => list_push(required, SystemdRunProperty {
      property: MemoryHigh,
      value: to_string(finite_byte_size_count(size: high)) as NonEmptyStr,
    })
    Absent => required
  }
}
