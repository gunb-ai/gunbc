// THE FABRIC EVENT LOG: THE CARRIER FOR EVERY CAPACITY TRANSACTION, REALIZED ON THE FABRIC DB.
// One immutable object per event, addressed by its content; one named head per partition, advanced
// by a compare-and-set on the expected head; no chain-wide head. The store is std.fabric_storage, reached
// through the binding gunbc.fabric_storage_client derives for the executing host -- in process on the
// placed host, over its served endpoint everywhere else. Nothing here names a host or a transport.
//
// THE PARENT IS A LINK THE STORE HOLDS. An event object links to its parent's object, derived from
// the event's own parent field (one source), so a partition read is one closure the store walks and
// the full chain always arrives. The git realization this replaced kept the parent only inside the
// event's JSON; a ref fetch transferred the tip alone and every deeper read refused (P0-B). The
// event id IS the object's ref, in its wire form: the store assigns it, as product.capacity.event_chain
// requires.
//
// CUTOVER (2026-09-19): partitions start empty in the fabric DB. Nothing is imported from the git log
// -- this realization never derives state from the one it replaced -- and termed leases make the
// drain sufficient: see docs/plans/fabric-storage.md. The git repository is left read-only on its host as
// history and is consulted by nothing.

// WHY A LOG OPERATION REFUSED, TYPED. A store fault carries std.fabric_storage's arm unchanged, so an
// unreachable store, a missing object, a corrupt object and a store refusal stay distinct all the way
// to the consumer. A lost race is not here: it is EventAppendStale, an outcome with both heads.
type EventLogRefusal
  = EventLogStoreFault { fault: FabricStorageFault }
  | EventLogParentMismatch
  | EventLogEventUndecodable { id: EventId, reason: String }
  | EventLogIdUnreadable { id: EventId }
  | EventLogEventEmpty

fn event_log_refusal_wire(cause: EventLogRefusal) -> String {
  match cause {
    EventLogStoreFault { fault: f } => fabric_storage_fault_wire(fault: f)
    EventLogParentMismatch => "the event's parent is not the head the append expects"
    EventLogEventUndecodable { id: i, reason: why } => join(["event ", i as String, " undecodable: ", why], "")
    EventLogIdUnreadable { id: i } => join(["event id ", i as String, " is not an object ref"], "")
    EventLogEventEmpty => "the event's wire text is empty"
  }
}

// WHERE THE LOG IS FROM THE EXECUTING HOST: the fabric DB binding for this executor.
fn event_log_binding_for(executor: HostIdentity) -> FabricStorageBinding {
  fabric_storage_binding_for(placement: fabric_storage_placement(), executor: executor)
}

fn event_id_of(object: FabricObjectRef) -> EventId {
  fabric_object_ref_wire(object: object) as String as EventId
}

type EventObject
  = EventObjectBuilt { object: FabricObject }
  | EventObjectRefused { cause: EventLogRefusal }

fn event_object<P>(event: ChainEvent<P>, encode: fn(ChainEvent<P>) -> String) -> EventObject {
  let body = encode(event)
  if body == "" {
    EventObjectRefused { cause: EventLogEventEmpty }
  } else {
    match event.parent {
      Absent => EventObjectBuilt { object: FabricObject { links: [], body: body as NonEmptyStr } }
      Present { value: p } =>
        match fabric_object_ref_of_wire(wire: p as String) {
          Absent => EventObjectRefused { cause: EventLogIdUnreadable { id: p } }
          Present { value: r } => EventObjectBuilt { object: FabricObject { links: [r], body: body as NonEmptyStr } }
        }
    }
  }
}

fn store_expectation(expected: HeadExpectation) -> FabricHeadExpectation? {
  match expected {
    HeadAbsent => Present { value: ExpectHeadAbsent }
    HeadAt { id: h } => match fabric_object_ref_of_wire(wire: h as String) { Present { value: r } => Present { value: ExpectHeadAt { object: r } }  Absent => none }
  }
}

fn log_head(reading: std.fabric_storage.FabricHeadReading) -> HeadExpectation {
  match reading {
    FabricHeadAbsent => HeadAbsent
    FabricHeadAt { object: o, generation: _ } => HeadAt { id: event_id_of(object: o) }
  }
}

// HEAD OBSERVATION ASKS THE STORE. Absence is the store's own arm, never inferred from a failure.
type HeadObservation
  = HeadObserved { head: HeadExpectation }
  | HeadObservationRefused { cause: EventLogRefusal }

fn event_log_observe_head(store: FabricStorageBinding, partition: PartitionId) -> HeadObservation {
  match fabric_storage_head(binding: store, name: partition as String as NonEmptyStr) {
    FabricHeadReadRefused { fault: f } => HeadObservationRefused { cause: EventLogStoreFault { fault: f } }
    FabricHeadObserved { reading: r } => HeadObserved { head: log_head(reading: r) }
  }
}

// READING A PARTITION: one closure from the head, each held object decoded as an event, and the
// collected envelopes handed to the pure walk so the chain's shape is decided by one authority.
// THE ONE READ BUDGET FOR A PARTITION CLOSURE: how many events a single read of any partition may
// walk before it refuses as ChainBudgetExhausted. Owned here, beside the read it bounds, and
// consumed by every reader of the log (the seat and quota transactions through the pool-event
// read, the pair-serving authority and host-placement folds, the partition-read instrument), so a
// bound that moves moves once.
fn event_log_read_budget() -> Nat { 4096 }

// THE LOG IS ONE CARRIER FOR EVERY PARTITION KIND. A partition's payload type and its codec are
// the partition owner's (pool events here; the pair-serving authority and host placement in
// gunbc.spark.pair_serving_authority_log), so the read and the append take the codec as a value:
// one store walk, one put-and-advance, N payload types -- never a second log per kind.
type PartitionRead<P>
  = PartitionReadOk { head: HeadExpectation, walk: ChainWalk<P> }
  | PartitionReadRefused { cause: EventLogRefusal }

type DecodeState<P> {
  envs: List<ChainEnvelope<P>>
  refused: EventLogRefusal?
}

fn decode_envelopes<P>(objects: List<FabricStoredObject>, decode: fn(String) -> EventDecode<P>) -> DecodeState<P> {
  fold(objects, init: DecodeState { envs: [] as List<ChainEnvelope<P>>, refused: none }, f: (acc, s) =>
    match acc.refused {
      Present { value: _ } => acc
      Absent =>
        match decode(s.content.body as String) {
          EventUndecodable { reason: why } => DecodeState { envs: acc.envs, refused: Present { value: EventLogEventUndecodable { id: event_id_of(object: s.object), reason: why } } }
          EventDecoded { event: e } => DecodeState { envs: concat(acc.envs, [ChainEnvelope { id: event_id_of(object: s.object), event: e }]), refused: none }
        }
    })
}

fn event_log_read_partition_with<P>(store: FabricStorageBinding, partition: PartitionId, budget: Nat, decode: fn(String) -> EventDecode<P>) -> PartitionRead<P> {
  match fabric_storage_closure(binding: store, name: partition as String as NonEmptyStr, bound: budget) {
    FabricClosureRefused { fault: f } => PartitionReadRefused { cause: EventLogStoreFault { fault: f } }
    FabricClosureBudgetExhausted { at: a, bound: _ } => PartitionReadOk { head: HeadAt { id: event_id_of(object: a) }, walk: ChainBudgetExhausted { at: event_id_of(object: a) } }
    FabricClosureRead { reading: r, newest_first: xs } => {
      let d = decode_envelopes(objects: xs, decode: decode)
      match d.refused {
        Present { value: c } => PartitionReadRefused { cause: c }
        Absent => PartitionReadOk { head: log_head(reading: r), walk: chain_from_head(envs: d.envs, head: log_head(reading: r), budget: budget) }
      }
    }
  }
}

fn event_log_read_partition(store: FabricStorageBinding, partition: PartitionId, budget: Nat) -> PartitionRead<PoolEvent> {
  event_log_read_partition_with(store: store, partition: partition, budget: budget, decode: fn(t) { pool_event_decode(text: t) })
}

// APPEND: put the event's object, then advance the partition head from the expected one. The store
// decides the race: a moved head is stale, carrying the head that won; every other failure is the
// store's typed fault. The object is built from the event, so the bytes published are the bytes
// hashed -- no path, no shared scratch, no second writer's bytes (the git realization's empty-blob
// defect has no constructor here: an object body is NonEmptyStr).
type EventAppend
  = EventAppended { id: EventId }
  | EventAppendStale { expected: HeadExpectation, observed: HeadExpectation }
  | EventAppendRefused { cause: EventLogRefusal }

fn event_log_append_with<P>(store: FabricStorageBinding, partition: PartitionId, event: ChainEvent<P>, expected: HeadExpectation, encode: fn(ChainEvent<P>) -> String) -> EventAppend {
  if !head_expectation_eq(a: event_parent_expectation(e: event), b: expected) {
    EventAppendRefused { cause: EventLogParentMismatch }
  } else {
    match event_object(event: event, encode: encode) {
      EventObjectRefused { cause: c } => EventAppendRefused { cause: c }
      EventObjectBuilt { object: object } =>
        match store_expectation(expected: expected) {
          Absent => EventAppendRefused { cause: match expected { HeadAt { id: i } => EventLogIdUnreadable { id: i }  HeadAbsent => EventLogParentMismatch } }
          Present { value: x } =>
            match fabric_storage_put(binding: store, object: object) {
              FabricPutRefused { fault: f } => EventAppendRefused { cause: EventLogStoreFault { fault: f } }
              FabricObjectStored { object: r } =>
                match fabric_storage_advance(binding: store, name: partition as String as NonEmptyStr, expected: x, target: r) {
                  FabricHeadAdvanced { object: o, generation: _ } => EventAppended { id: event_id_of(object: o) }
                  FabricHeadMoved { expected: _, observed: now } => EventAppendStale { expected: expected, observed: log_head(reading: now) }
                  FabricHeadAdvanceRefused { fault: f } => EventAppendRefused { cause: EventLogStoreFault { fault: f } }
                }
            }
        }
    }
  }
}

fn event_log_append(store: FabricStorageBinding, partition: PartitionId, event: ChainEvent<PoolEvent>, expected: HeadExpectation) -> EventAppend {
  event_log_append_with(store: store, partition: partition, event: event, expected: expected, encode: fn(e) { pool_event_wire_text(event: e) })
}

// THE SEAT TRANSACTION, WET AND BOUNDED: read, fold, propose, append; a stale append re-reads and
// decides again, at most `attempts` times, and exhaustion is its own typed outcome rather than a
// seat. The grant is minted only from an admitted append.
// EVERY OUTCOME CARRIES THE ATTEMPT IT LANDED ON, so a receipt can say whether the writer won its
// first compare-and-set or re-folded after a stale one: the difference between "nobody else was
// there" and "someone was, and the fence held".
type SeatAcquisition
  = SeatGranted { grant: LeaseGrant, generation: Nat, attempts_used: Nat }
  | SeatFull { wire: String, attempts_used: Nat }
  | SeatContended { attempts: Nat }
  | SeatAcquireRefused { step: String, reason: String, attempts_used: Nat }
  | SeatStoreRefused { cause: EventLogRefusal, attempts_used: Nat }

type SeatAttemptState {
  done: SeatAcquisition?
  attempted: Nat
}

// ── READING THE POOL WITHOUT TAKING FROM IT ───────────────────────────────────────────────────
//
// seat_attempt below learns whether a pool has room by PROPOSING an acquire and seeing it refused.
// That is an outcome, and a caller who needs to know the standing BEFORE deciding cannot use it:
// asking costs an attempt, and a refusal is indistinguishable from a race it lost.
//
// gunbc.serving.turn_admission needs the standing as an observation, because its whole discipline is
// that an unread axis refuses rather than admitting -- and a seat inferred from a failed CAS is
// exactly the fabricated reading it exists to forbid.
//
// SO THIS IS THE SAME CHAIN MINUS THE APPEND: read the partition, walk it, fold it into the pool,
// and take a reading. Every step is the one seat_attempt already runs, which is what keeps this a
// second QUESTION rather than a second authority -- there is no separate notion here of what a seat
// is or when a pool is full.
type SeatStandingObservation
  = SeatRoomObserved { headroom: Nat, generation: Nat }
  | SeatFullObserved { generation: Nat }
  | SeatStandingUnobserved { step: String, reason: String }
  | SeatStandingStoreRefused { cause: EventLogRefusal }

fn fabric_seat_observe(store: FabricStorageBinding, partition: PartitionId, root: Pool<Count, One>, at: EpochSecs, budget: Nat) -> SeatStandingObservation {
  match event_log_read_partition(store: store, partition: partition, budget: budget) {
    PartitionReadRefused { cause: c } => SeatStandingStoreRefused { cause: c }
    PartitionReadOk { head: _, walk: walk } =>
      match walk {
        ChainIncomplete { missing: m, newest_first_so_far: _ } =>
          SeatStandingUnobserved { step: "chain", reason: join(["partition chain is missing event ", m as String], "") }
        ChainBudgetExhausted { at: a } =>
          SeatStandingUnobserved { step: "chain", reason: join(["partition chain exceeded the read budget at ", a as String], "") }
        ChainWalked { oldest_first: xs } =>
          match pool_fold(root: root, oldest_first: xs) {
            PoolFoldRefused { at_event: e, wire: w } =>
              SeatStandingUnobserved { step: "fold", reason: join(["event ", e as String, " refused: ", w], "") }
            PoolFolded { pool: p, generation: g } =>
              match pool_reading_at(pool: p, at: at) {
                PoolReadingRefused { at: t, anchor: a } =>
                  SeatStandingUnobserved { step: "reading", reason: join(["instant ", to_string(t), " precedes the pool anchor ", to_string(a)], "") }
                PoolRead { committed: _, ceiling: _, headroom: h, over_committed: _ } =>
                  if h.count > 0 { SeatRoomObserved { headroom: h.count, generation: g } }
                  else { SeatFullObserved { generation: g } }
              }
          }
      }
  }
}

fn seat_attempt(store: FabricStorageBinding, partition: PartitionId, root: Pool<Count, One>, actor: NonEmptyStr, request: SeatRequest, policy: LeasePolicy, budget: Nat, attempt: Nat) -> SeatAcquisition? {
  match event_log_read_partition(store: store, partition: partition, budget: budget) {
    PartitionReadRefused { cause: c } => Present { value: SeatStoreRefused { cause: c, attempts_used: attempt } }
    PartitionReadOk { head: head, walk: walk } =>
      match walk {
        ChainIncomplete { missing: m, newest_first_so_far: _ } => Present { value: SeatAcquireRefused { step: "chain", reason: join(["partition chain is missing event ", m as String], ""), attempts_used: attempt } }
        ChainBudgetExhausted { at: a } => Present { value: SeatAcquireRefused { step: "chain", reason: join(["partition chain exceeded the read budget at ", a as String], ""), attempts_used: attempt } }
        ChainWalked { oldest_first: xs } =>
          match pool_fold(root: root, oldest_first: xs) {
            PoolFoldRefused { at_event: e, wire: w } => Present { value: SeatAcquireRefused { step: "fold", reason: join(["event ", e as String, " refused: ", w], ""), attempts_used: attempt } }
            PoolFolded { pool: p, generation: g } =>
              match propose_acquire(pool: p, generation: g, head: head, partition: partition, actor: actor, request: request) {
                SeatRefused { wire: w } => Present { value: SeatFull { wire: w, attempts_used: attempt } }
                SeatProposed { event: e, expected_head: x } =>
                  match event_log_append(store: store, partition: partition, event: e, expected: x) {
                    EventAppendRefused { cause: c } => Present { value: SeatStoreRefused { cause: c, attempts_used: attempt } }
                    EventAppendStale { expected: _, observed: _ } => none
                    EventAppended { id: h } =>
                      match grant_from_admission(request: request, admission: AppendAdmitted { new_head: h, generation: g + 1 }, policy: policy) {
                        Absent => Present { value: SeatAcquireRefused { step: "grant", reason: "an admitted append minted no grant", attempts_used: attempt } }
                        Present { value: grant } => Present { value: SeatGranted { grant: grant, generation: g + 1, attempts_used: attempt } }
                      }
                  }
              }
          }
      }
  }
}

// THE RELEASE LAW IS SPELLED TWICE HERE AND THE TWO SPELLINGS MUST AGREE. The comparison itself lives
// with the type (product.capacity.lease release_law_eq), not here: an equality authored at a consumer
// is the second spelling of the concept it compares. The pool root carries the
// law it enforces on its own history; the caller's LeasePolicy carries the law it believes it is
// acquiring under. Nothing joined them, so a pool could hold a seat past expiry while the caller and
// its witnesses described a fence that frees it -- a safety law with two independent spellings drifts,
// and the drift is invisible because each side is internally consistent. A mismatch is refused before
// anything is appended rather than resolved in favour of either side: neither is authoritative over
// the other, and picking one silently would be the same fail-open in a different costume.
fn fabric_seat_acquire(store: FabricStorageBinding, partition: PartitionId, root: Pool<Count, One>, actor: NonEmptyStr, request: SeatRequest, policy: LeasePolicy, attempts: Nat, budget: Nat) -> SeatAcquisition {
  if !release_law_eq(left: root.release_law, right: policy.release_law) {
    SeatAcquireRefused {
      step: "release-law",
      reason: join([
        "the pool root enforces ", release_law_wire(law: root.release_law),
        " while the lease policy declares ", release_law_wire(law: policy.release_law),
        ", so the seat would be held under one law and released under another",
      ], ""),
      attempts_used: 0,
    }
  } else {
  let st = fold(nat_range_inclusive(lo: 1, hi: attempts), init: SeatAttemptState { done: none, attempted: 0 }, f: (acc, i) =>
    match acc.done {
      Present { value: _ } => acc
      Absent => SeatAttemptState { done: seat_attempt(store: store, partition: partition, root: root, actor: actor, request: request, policy: policy, budget: budget, attempt: i), attempted: i }
    })
  match st.done {
    Present { value: d } => d
    Absent => SeatContended { attempts: attempts }
  }
  }
}

fn seat_acquisition_wire(a: SeatAcquisition) -> String {
  match a {
    SeatGranted { grant: g, generation: gen, attempts_used: n } => join(["granted ", g.reference as String, " fence=", g.fence.grant as String, "@", to_string(gen), " expires_at=", to_string(g.expires_at), " attempt=", to_string(n)], "")
    SeatFull { wire: w, attempts_used: n } => join(["full ", w, " attempt=", to_string(n)], "")
    SeatContended { attempts: n } => join(["contended after ", to_string(n), " attempts"], "")
    SeatAcquireRefused { step: s, reason: why, attempts_used: n } => join(["refused at ", s, ": ", why, " attempt=", to_string(n)], "")
    SeatStoreRefused { cause: c, attempts_used: n } => join(["refused by the fabric DB: ", event_log_refusal_wire(cause: c), " attempt=", to_string(n)], "")
  }
}

// THE STORE ENSURE, run ON the placed host: the fabric DB's two areas under its placement root.
// The root's parent, ownership and mode are the substrate's obligation; a missing or unwritable
// parent refuses.
fn fabric_storage_placement_ensure_wet() -> ProcessExit {
  match fabric_storage_placement() {
    FabricStorageUnplaced => exit_failure(reason: "fabric DB placement ensure refused: the fabric DB is unplaced")
    FabricStoragePlaced { host: _, store_root: r, endpoint: _ } =>
      match fabric_storage_file_root_ensure(root: fabric_storage_file_root(root: r)) {
        FabricStorageRootReady => ExitSuccess
        FabricStorageRootRefused { area: a, detail: why } => exit_failure(reason: join(["fabric DB placement ensure refused at ", a, ": ", why], ""))
      }
  }
}
