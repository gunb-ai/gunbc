module gunbc.fabric_storage_protocol

import std.types { String, NonEmptyStr, Int, List, CommitSha }
import std.nat { Nat }
import extdeps.http.server { ServeWireResponse }
import std.fabric_storage {
  FabricObject, fabric_object_decode, fabric_object_ref_of_wire, FabricHeadExpectation, ExpectHeadAbsent, ExpectHeadAt,
  FabricReplyUndecodable, FabricHeadNameRefused,
  FabricPutRefused, FabricHeadReadRefused, FabricHeadAdvanceRefused, FabricClosureRefused,
}
import gunbc.fabric_storage_file_store {
  FabricStorageFileRoot, fabric_storage_file_head, fabric_storage_file_put, fabric_storage_file_advance, fabric_storage_file_closure,
}
import gunbc.fabric_storage_wire { fabric_storage_wire_head, fabric_storage_wire_put, fabric_storage_wire_advance, fabric_storage_wire_closure, fabric_storage_wire_identity, DoorProxied }
import extdeps.tailscale.identity { tailnet_identity_of }

import v2.std.algebra { skip }

data fabric_storage_closure_bound_cap: Nat = 65536

fn text_response(status: Int, body: String) -> ServeWireResponse {
  ServeWireResponse { headers: [], status: status, content_type_label: "text/plain; charset=utf-8", body: body }
}

fn ok(body: String) -> ServeWireResponse {
  text_response(status: 200, body: body)
}

fn words(text: String) -> List<String> {
  split(trim_line(s: text), separator: " ")
}

fn trim_line(s: String) -> String {
  match first(split(s, separator: "\n")) { Present { value: l } => l  Absent => "" }
}

fn word(ws: List<String>, i: Int) -> String {
  match first(ws |> skip(n: i)) { Present { value: w } => w  Absent => "" }
}

fn head_name(w: String) -> NonEmptyStr? {
  if w == "" { none } else { Present { value: w as NonEmptyStr } }
}

fn malformed(detail: String) -> ServeWireResponse {
  text_response(status: 400, body: join(["fabric_storage/1 malformed request: ", detail, "\n"], ""))
}

// Request bodies:
//   head      <name>
//   closure   <name> <bound>
//   put       <canonical preimage>
//   advance   <name> absent <target>   |   <name> at <expected-ref> <target>
//   identity  (no body)
fn fabric_storage_respond(root: FabricStorageFileRoot, operation: String, body: String, tailscale_identity: String) -> ServeWireResponse {
  let ws = words(text: body)
  match operation {
    "identity" => ok(body: fabric_storage_wire_identity(principal: DoorProxied { identity: tailnet_identity_of(header_value: tailscale_identity) }))
    "head" =>
      match head_name(w: word(ws: ws, i: 0)) {
        Absent => malformed(detail: "head names no head")
        Present { value: n } => ok(body: fabric_storage_wire_head(read: fabric_storage_file_head(root: root, name: n)))
      }
    "closure" =>
      match head_name(w: word(ws: ws, i: 0)) {
        Absent => malformed(detail: "closure names no head")
        Present { value: n } =>
          match parse_int(s: word(ws: ws, i: 1)) {
            Absent => malformed(detail: "closure bound is not an integer")
            Present { value: b } =>
              if b < 1 || b > fabric_storage_closure_bound_cap { malformed(detail: "closure bound out of range") }
              else { ok(body: fabric_storage_wire_closure(read: fabric_storage_file_closure(root: root, name: n, bound: b))) }
          }
      }
    "put" =>
      match fabric_object_decode(preimage: body) {
        Absent => malformed(detail: "put body is not one fabric object")
        Present { value: o } => ok(body: fabric_storage_wire_put(put: fabric_storage_file_put(root: root, object: o)))
      }
    "advance" =>
      match head_name(w: word(ws: ws, i: 0)) {
        Absent => malformed(detail: "advance names no head")
        Present { value: n } =>
          match advance_request(ws: ws) {
            Absent => malformed(detail: "advance expectation or target unreadable")
            Present { value: req } => ok(body: fabric_storage_wire_advance(advance: fabric_storage_file_advance(root: root, name: n, expected: req.expected, target: req.target)))
          }
      }
    _ => text_response(status: 404, body: join(["fabric_storage/1 no operation ", operation, "\n"], ""))
  }
}

type AdvanceRequest {
  expected: FabricHeadExpectation
  target: std.fabric_storage.FabricObjectRef
}

fn advance_request(ws: List<String>) -> AdvanceRequest? {
  match word(ws: ws, i: 1) {
    "absent" =>
      match fabric_object_ref_of_wire(wire: word(ws: ws, i: 2)) {
        Present { value: t } => Present { value: AdvanceRequest { expected: ExpectHeadAbsent, target: t } }
        Absent => none
      }
    "at" =>
      match fabric_object_ref_of_wire(wire: word(ws: ws, i: 2)) {
        Absent => none
        Present { value: e } =>
          match fabric_object_ref_of_wire(wire: word(ws: ws, i: 3)) {
            Present { value: t } => Present { value: AdvanceRequest { expected: ExpectHeadAt { object: e }, target: t } }
            Absent => none
          }
      }
    _ => none
  }
}
