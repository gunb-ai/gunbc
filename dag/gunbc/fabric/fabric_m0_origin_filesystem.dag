module gunbc.fabric_m0_origin_filesystem

import std.types { Bool, FilePath, Int, List, NonEmptyStr, String }
import std.content_hash { Sha256Digest }
import std.algebra { trim }
import extdeps.shell
import extdeps.filesystem.filesystem_io {
  Filesystem,
  FilesystemEntryNameAdmission, FilesystemEntryNameAdmitted, FilesystemEntryNameRefused, admit_filesystem_entry_name,
  FilesystemListingObservation, filesystem_listing_observation,
  FilesystemEntryPresence, FilesystemEntryAbsent, FilesystemEntryListed, FilesystemEntryPresenceIndeterminate,
  FilesystemEntrySubjectRefused, filesystem_entry_presence,
}
import gunbc.fabric_m0_origin_readback {
  OriginPutOutcome, OriginObjectStored, OriginObjectAlreadyPresent, OriginPutRefused, OriginPutOutcomeUnknown,
  OriginFetchOutcome, OriginObjectStaged, OriginObjectAbsent, OriginFetchUnavailable,
  OriginReadingTaken, OriginReadingUnavailable, read_origin_staged_file,
}

// A DURABLE ORIGIN ON A HOST FILESYSTEM: the second realization of the fabric M0 origin contract.
//
// gunbc.fabric_m0_origin_readback owns what an origin put and an origin fetch ANSWER
// (OriginPutOutcome, OriginFetchOutcome); gunbc.cloudflare.r2_origin_object obtains those answers
// from R2. This module obtains the same answers from a directory tree on a host, so every consumer
// above the interface - gunbc.fabric_m0_commit, gunbc.fabric_m0_completion readback_digest_verdict -
// judges a filesystem origin exactly as it judges R2, with no second vocabulary. It holds no policy
// about which host, which root, or which objects: those are the caller's.
//
// LAYOUT, under an origin root the caller names:
//   <root>/objects/<directories...>/<name>   installed objects, one file per key, never replaced
//   <root>/staging/                          uniquely named files a put writes before installing
// A content-addressed object is <root>/objects/sha256/<64-hex digest>.
//
// THIS REALIZATION CREATES NO DIRECTORY. Every directory a key passes through - objects/, each
// intermediate segment, and staging/ - must already exist, created and fsynced by host convergence.
// A directory created by a put would name itself in its parent without that parent being fsynced, so
// the object inside it could survive a crash while the path to it did not; and a put that created
// objects/ would found an origin the caller only meant to write into. So a key whose directories are
// not already established is refused, and the only directory this module ever fsyncs after a link is
// the key's own, already-established parent.
//
// THE PUT IS CREATE-IF-ABSENT BY CONSTRUCTION, NOT BY A CHECK. The bytes are copied into a unique
// staging file and fsynced, then hard-linked to the object path. link(2) refuses when the destination
// exists, so "check absent, then write" never happens and there is no window in which a concurrent
// writer's bytes are replaced. The key's directory is fsynced after the link so the new name itself is
// durable. The staging name is then removed as best effort: a cleanup failure never demotes an
// installed object, and a leftover staging alias is harmless only while the service account is the
// sole writer beneath the root, which is the host binding's obligation.
//
// WHAT A FAILED LINK MEANS IS DECIDED BY A SECOND OBSERVATION, never by the exit status. `ln` exits
// nonzero both when the name is taken and when anything else went wrong, so the put asks the key's
// directory whether the name now exists: listed means the key was occupied (the fetch that follows
// decides whether by these bytes), not listed means the link was refused, and a listing that could not
// be taken is an unknown outcome.
//
// A FETCH MAY CONFIRM ONLY WHAT IS DURABLE. A put that linked the object but could not fsync its
// directory answers unknown, and the name is still visible afterwards - so a fetch that merely copied
// what it could see would turn that unknown into a confirmation that a crash could erase. Before
// staging a read, the fetch fsyncs the installed object and its directory; if either fails, the fetch
// is unavailable and no reading is minted. A later fetch whose fsyncs succeed is the reconciliation
// the unknown put asked for.
//
// THE FETCH STAGES ITS OWN OUTPUT, exactly as the R2 fetch does: it copies the installed object into a
// directory it minted and hands THAT path to read_origin_staged_file, so the confirming digest is taken
// over the fetch's own copy and never over the caller's file. The staged copy is left in place, as the
// R2 fetch leaves its own: the reading names that path.
//
// ABSENCE IS ESTABLISHED BY A LISTING THAT SUCCEEDED, never by a copy that failed: the key's directory
// is listed and absence is concluded only when that listing succeeded and does not name the object.
//
// WHAT "INSIDE THE ROOT" MEANS, AT ITS HONEST GRAIN. Segment admission refuses lexical traversal - an
// empty segment, ".", "..", an embedded separator. Pathname resolution still follows symbolic links in
// intermediate components, so the origin root and every directory a key passes through are also
// observed to be real directories and NOT symbolic links (POSIX test -d and test -h) before any effect,
// a symlinked component refuses, and a fetch observes the object leaf itself to be a regular file and
// not a symbolic link before it syncs or copies it. That observation and the effect that follows are separate operations: a symbolic
// link substituted between them is not prevented here. Closing that window is a beneath-root
// resolution capability (openat2 RESOLVE_BENEATH or directory file descriptors) this substrate does not
// model; until it does, the host binding owes the guarantee that only the origin's service account
// can write beneath the root.
//
// DURABILITY, STATED AT ITS HONEST GRAIN. fsync on the staged file, the installed object and its
// directory is what this realization can ask of one host; the established ancestors are convergence's.
// It says nothing about the disk's write cache, and it is one copy on one machine: surviving the loss
// of that host is the replication lane's property, not this module's.

type FilesystemOriginRoot {
  root: FilePath
}

fn origin_objects_directory(root: FilesystemOriginRoot) -> String {
  join([root.root as String, "/objects"], "")
}

fn origin_staging_directory(root: FilesystemOriginRoot) -> String {
  join([root.root as String, "/staging"], "")
}

// ---------------------------------------------------------------------------------------------
// Keys.

// A KEY IS A SEQUENCE OF ADMITTED DIRECTORY-ENTRY NAMES, joined by "/". Each segment goes through
// extdeps.filesystem.filesystem_io admit_filesystem_entry_name, so "", ".", "..", an embedded
// separator and a newline are refused by the authority that owns what a component is. The admission
// is pure and takes a String so its empty-input refusal is testable; the effectful entries take a
// NonEmptyStr, because their answers are keyed by the object and an empty key names none.
type OriginKeyAdmission
  = OriginKeyAdmitted { key: NonEmptyStr, segments: List<String> }
  | OriginKeyRefused { key: String, cause: NonEmptyStr }

fn admit_origin_key(key: String) -> OriginKeyAdmission {
  let segments = split(s: key, delimiter: "/")
  let refusals = map(segments, seg => match admit_filesystem_entry_name(name: seg) {
    FilesystemEntryNameRefused { name: _, cause } => cause
    FilesystemEntryNameAdmitted(_) => ""
  }) |> filter(c => c != "")
  if key == "" {
    OriginKeyRefused { key: key, cause: "an origin key is empty, so it names no object" }
  } else {
    match refusals |> first {
      Present { value: cause } => OriginKeyRefused { key: key, cause: join(["origin key '", key, "' has a segment that is not a directory-entry name: ", cause], "") as NonEmptyStr }
      Absent => OriginKeyAdmitted { key: key as NonEmptyStr, segments: segments }
    }
  }
}

// THE CONTENT-ADDRESSED KEY OF A SHA-256 DIGEST: one directory, sha256/, established by convergence, so
// a content-addressed put never needs a directory created. The key is derived from the digest alone,
// so every writer of the same bytes names the same object and create-if-absent arbitrates between them.
fn content_addressed_origin_key(digest: Sha256Digest) -> NonEmptyStr {
  join(["sha256/", digest.hex as String], "") as NonEmptyStr
}

fn origin_object_path(root: FilesystemOriginRoot, segments: List<String>) -> String {
  join([origin_objects_directory(root: root), "/", join(segments, "/")], "")
}

// The directories a key passes through, outermost first: objects/ itself, then each prefix of the
// key's segments except the last. The origin root is observed separately by every put and fetch, so a
// root that is itself a symbolic link refuses before anything beneath it is touched.
fn origin_key_directories(root: FilesystemOriginRoot, segments: List<String>) -> List<String> {
  concat(
    [origin_objects_directory(root: root)],
    map(enumerate(segments |> take(n: count(segments) - 1)), pair => join([origin_objects_directory(root: root), "/", join(segments |> take(n: pair.first + 1), "/")], "")),
  )
}

fn origin_key_parent(root: FilesystemOriginRoot, segments: List<String>) -> String {
  match origin_key_directories(root: root, segments: segments) |> skip(n: count(segments) - 1) |> first {
    Present { value: d } => d
    Absent => origin_objects_directory(root: root)
  }
}

fn last_segment(segments: List<String>) -> String {
  match segments |> skip(n: count(segments) - 1) |> first {
    Present { value: s } => s
    Absent => ""
  }
}

// ---------------------------------------------------------------------------------------------
// Established directories.

// WHAT ONE DIRECTORY WAS OBSERVED TO BE. PURE over the two tests, so each arm is reachable from a
// fixture. A path that test -d does not accept is not established, whatever the reason; a path that is
// a directory only by way of a symbolic link is refused, because every later effect through it would
// resolve somewhere the key does not name.
type OriginDirectoryStanding
  = OriginDirectoryEstablished
  | OriginDirectoryNotEstablished { path: String }
  | OriginDirectoryIsSymbolicLink { path: String }

fn origin_directory_standing(path: String, is_directory: Bool, is_symbolic_link: Bool) -> OriginDirectoryStanding {
  if is_symbolic_link {
    OriginDirectoryIsSymbolicLink { path: path }
  } else if is_directory {
    OriginDirectoryEstablished
  } else {
    OriginDirectoryNotEstablished { path: path }
  }
}

fn observe_origin_directory(path: String) -> OriginDirectoryStanding {
  origin_directory_standing(
    path: path,
    is_directory: shell.Test.IsDirectory(path: path as FilePath).is_directory,
    is_symbolic_link: shell.Test.IsSymbolicLink(path: path as FilePath).is_symbolic_link,
  )
}

fn directory_refusal_cause(standing: OriginDirectoryStanding) -> String {
  match standing {
    OriginDirectoryEstablished => ""
    OriginDirectoryNotEstablished { path } => join(["origin directory ", path, " is not an established directory; this realization creates none, so host convergence must establish it first"], "")
    OriginDirectoryIsSymbolicLink { path } => join(["origin directory ", path, " is a symbolic link, so a path through it would resolve outside what the key names"], "")
  }
}

// The first directory, outermost first, that is not an established real directory - or "" when all are.
fn first_unestablished(paths: List<String>) -> String {
  fold(paths, init: "", f: fn(acc, p) {
    if acc != "" { acc } else { directory_refusal_cause(standing: observe_origin_directory(path: p)) }
  })
}

// ---------------------------------------------------------------------------------------------
// Put.

// WHAT THE LINK AND THE LISTING AFTER IT OBSERVED. PURE, so every arm is reachable from a fixture.
type OriginLinkObservation
  = OriginLinkInstalled { durable: Bool }
  | OriginLinkFailed { presence: FilesystemEntryPresence }

fn filesystem_put_decide(key: NonEmptyStr, link: OriginLinkObservation) -> OriginPutOutcome {
  match link {
    OriginLinkInstalled { durable } =>
      if durable {
        OriginObjectStored { key: key }
      } else {
        OriginPutOutcomeUnknown { key: key, cause: join(["the object was linked at ", key as String, " but its directory could not be fsynced, so the name may not survive a crash; reconcile by fetching the key"], "") as NonEmptyStr }
      }
    OriginLinkFailed { presence } =>
      match presence {
        FilesystemEntryListed { directory: _, name: _ } => OriginObjectAlreadyPresent { key: key }
        FilesystemEntryAbsent(_) => OriginPutRefused { key: key, cause: join(["the link to ", key as String, " failed and the key's directory does not list it, so the store refused the install"], "") as NonEmptyStr }
        FilesystemEntryPresenceIndeterminate { cause } => OriginPutOutcomeUnknown { key: key, cause: join(["the link to ", key as String, " failed and whether the key is now occupied could not be observed: ", cause], "") as NonEmptyStr }
        FilesystemEntrySubjectRefused { directory: _, name: _, cause } => OriginPutRefused { key: key, cause: cause as NonEmptyStr }
      }
  }
}

fn list_directory(directory: String) -> FilesystemListingObservation {
  let l = Filesystem.List(path: directory)
  filesystem_listing_observation(directory: directory, success: l.success, entries: l.entries, error: l.error)
}

fn put_filesystem_origin_object(root: FilesystemOriginRoot, local_path: FilePath, key: NonEmptyStr) -> OriginPutOutcome {
  match admit_origin_key(key: key as String) {
    OriginKeyRefused { key: _, cause } => OriginPutRefused { key: key, cause: cause }
    OriginKeyAdmitted { key: admitted, segments } => {
      let unestablished = first_unestablished(paths: concat([root.root as String, origin_staging_directory(root: root)], origin_key_directories(root: root, segments: segments)))
      if unestablished != "" {
        OriginPutRefused { key: admitted, cause: unestablished as NonEmptyStr }
      } else {
        let parent = origin_key_parent(root: root, segments: segments)
        let staging = shell.Mktemp.FileInDirectory(dir: origin_staging_directory(root: root) as FilePath)
        if !staging.success {
          OriginPutRefused { key: admitted, cause: join(["no staging file could be created under ", origin_staging_directory(root: root)], "") as NonEmptyStr }
        } else {
          let staged = trim(staging.path as String) as FilePath
          let outcome = if !shell.Copy.File(source: local_path, destination: staged).success {
            OriginPutRefused { key: admitted, cause: join(["the bytes at ", local_path as String, " could not be copied into staging"], "") as NonEmptyStr }
          } else if !shell.Sync.Path(path: staged).success {
            OriginPutRefused { key: admitted, cause: "the staged copy could not be fsynced, so it was not installed" }
          } else if shell.Link.Hard(source: staged, destination: origin_object_path(root: root, segments: segments) as FilePath).success {
            filesystem_put_decide(key: admitted, link: OriginLinkInstalled { durable: shell.Sync.Path(path: parent as FilePath).success })
          } else {
            filesystem_put_decide(key: admitted, link: OriginLinkFailed { presence: filesystem_entry_presence(listing: list_directory(directory: parent), name: last_segment(segments: segments)) })
          }
          let removed = shell.Remove.FileForce(path: staged)
          outcome
        }
      }
    }
  }
}

// ---------------------------------------------------------------------------------------------
// Fetch.

// WHAT A FETCH OBSERVED BEFORE IT MAY READ. PURE, so each arm is reachable from a fixture: whether the
// key's directory lists the object, whether the object and its directory were fsynced, and whether the
// fetch's own copy was staged.
type OriginObjectListing
  = OriginObjectListed
  | OriginObjectNotListed
  | OriginObjectListingIndeterminate { cause: NonEmptyStr }

// WHAT THE LISTED LEAF IS. A listing says a name exists; it does not say the name is a regular file
// inside the tree. A leaf that is a symbolic link would be followed by sync and copy to wherever it
// points, and a confirming reading minted from bytes the origin does not hold - so before stabilizing
// or copying, the leaf is observed not to be a symbolic link (test -h) and to be a regular file
// (test -f). Anything else is unavailable, never a reading.
type OriginObjectLeafStanding
  = OriginObjectRegularFile
  | OriginObjectSymbolicLink { path: String }
  | OriginObjectNotRegularFile { path: String }

fn origin_object_leaf_standing(path: String, is_symbolic_link: Bool, is_regular_file: Bool) -> OriginObjectLeafStanding {
  if is_symbolic_link {
    OriginObjectSymbolicLink { path: path }
  } else if is_regular_file {
    OriginObjectRegularFile
  } else {
    OriginObjectNotRegularFile { path: path }
  }
}

fn observe_origin_object_leaf(path: String) -> OriginObjectLeafStanding {
  origin_object_leaf_standing(
    path: path,
    is_symbolic_link: shell.Test.IsSymbolicLink(path: path as FilePath).is_symbolic_link,
    is_regular_file: shell.Test.IsFile(path: path as FilePath).is_file,
  )
}

type OriginStabilization
  = OriginStabilized
  | OriginNotStabilized { cause: NonEmptyStr }

type OriginCopyObservation
  = OriginCopyStaged { staged_path: NonEmptyStr }
  | OriginCopyFailed

fn origin_object_listing(presence: FilesystemEntryPresence) -> OriginObjectListing {
  match presence {
    FilesystemEntryListed { directory: _, name: _ } => OriginObjectListed
    FilesystemEntryAbsent(_) => OriginObjectNotListed
    FilesystemEntryPresenceIndeterminate { cause } => OriginObjectListingIndeterminate { cause: cause as NonEmptyStr }
    FilesystemEntrySubjectRefused { directory: _, name: _, cause } => OriginObjectListingIndeterminate { cause: cause as NonEmptyStr }
  }
}

fn filesystem_fetch_decide(key: NonEmptyStr, listing: OriginObjectListing, leaf: OriginObjectLeafStanding, stabilization: OriginStabilization, copy: OriginCopyObservation) -> OriginFetchOutcome {
  match listing {
    OriginObjectNotListed => OriginObjectAbsent { key: key }
    OriginObjectListingIndeterminate { cause } => OriginFetchUnavailable { key: key, cause: cause }
    OriginObjectListed =>
      match leaf {
        OriginObjectSymbolicLink { path } => OriginFetchUnavailable { key: key, cause: join(["the object at ", path, " is a symbolic link; following it would read bytes the origin does not hold, so no reading is minted"], "") as NonEmptyStr }
        OriginObjectNotRegularFile { path } => OriginFetchUnavailable { key: key, cause: join(["the listed name ", path, " is not a regular file, so it is not an installed object"], "") as NonEmptyStr }
        OriginObjectRegularFile =>
          match stabilization {
            OriginNotStabilized { cause } => OriginFetchUnavailable { key: key, cause: join(["the object at ", key as String, " is visible but its durability could not be established, so no reading is minted: ", cause as String], "") as NonEmptyStr }
            OriginStabilized =>
              match copy {
                OriginCopyFailed => OriginFetchUnavailable { key: key, cause: join(["the object at ", key as String, " is listed but could not be copied out for reading"], "") as NonEmptyStr }
                OriginCopyStaged { staged_path } =>
                  match read_origin_staged_file(staged_path: staged_path) {
                    OriginReadingTaken { reading } => OriginObjectStaged { key: key, reading: reading }
                    OriginReadingUnavailable { staged_path: _, cause } => OriginFetchUnavailable { key: key, cause: cause }
                  }
              }
          }
      }
  }
}

fn stabilize_origin_object(object_path: String, parent: String) -> OriginStabilization {
  if !shell.Sync.Path(path: object_path as FilePath).success {
    OriginNotStabilized { cause: join(["the installed object ", object_path, " could not be fsynced"], "") as NonEmptyStr }
  } else if !shell.Sync.Path(path: parent as FilePath).success {
    OriginNotStabilized { cause: join(["the object's directory ", parent, " could not be fsynced"], "") as NonEmptyStr }
  } else {
    OriginStabilized
  }
}

fn fetch_filesystem_origin_object(root: FilesystemOriginRoot, key: NonEmptyStr) -> OriginFetchOutcome {
  match admit_origin_key(key: key as String) {
    OriginKeyRefused { key: _, cause } => OriginFetchUnavailable { key: key, cause: cause }
    OriginKeyAdmitted { key: admitted, segments } => {
      let unestablished = first_unestablished(paths: concat([root.root as String], origin_key_directories(root: root, segments: segments)))
      if unestablished != "" {
        OriginFetchUnavailable { key: admitted, cause: unestablished as NonEmptyStr }
      } else {
        let parent = origin_key_parent(root: root, segments: segments)
        let object_path = origin_object_path(root: root, segments: segments)
        match origin_object_listing(presence: filesystem_entry_presence(listing: list_directory(directory: parent), name: last_segment(segments: segments))) {
          OriginObjectListed =>
            match observe_origin_object_leaf(path: object_path) {
              OriginObjectSymbolicLink { path } => filesystem_fetch_decide(key: admitted, listing: OriginObjectListed, leaf: OriginObjectSymbolicLink { path: path }, stabilization: OriginStabilized, copy: OriginCopyFailed)
              OriginObjectNotRegularFile { path } => filesystem_fetch_decide(key: admitted, listing: OriginObjectListed, leaf: OriginObjectNotRegularFile { path: path }, stabilization: OriginStabilized, copy: OriginCopyFailed)
              OriginObjectRegularFile =>
                match stabilize_origin_object(object_path: object_path, parent: parent) {
                  OriginNotStabilized { cause } => filesystem_fetch_decide(key: admitted, listing: OriginObjectListed, leaf: OriginObjectRegularFile, stabilization: OriginNotStabilized { cause: cause }, copy: OriginCopyFailed)
                  OriginStabilized => {
                    let staging = shell.Mktemp.Dir()
                    if !staging.success {
                      OriginFetchUnavailable { key: admitted, cause: "no private directory could be minted to stage the object's bytes, so nothing was read" }
                    } else {
                      let staged = join([trim(staging.path as String), "/object"], "")
                      let copied = shell.Copy.File(source: object_path as FilePath, destination: staged as FilePath).success
                      filesystem_fetch_decide(key: admitted, listing: OriginObjectListed, leaf: OriginObjectRegularFile, stabilization: OriginStabilized, copy: if copied { OriginCopyStaged { staged_path: staged as NonEmptyStr } } else { OriginCopyFailed })
                    }
                  }
                }
            }
          other => filesystem_fetch_decide(key: admitted, listing: other, leaf: OriginObjectRegularFile, stabilization: OriginStabilized, copy: OriginCopyFailed)
        }
      }
    }
  }
}
