module gunbc.fabric_db_file_store

import std.types { String, NonEmptyStr, Int, Bool, List, FilePath }
import extdeps.shell
import std.nat { Nat, nat_range_inclusive }
import std.durable_compare_and_set {
  ExpectSlotAbsent, ExpectSlotGeneration, CasExpectation, CasCommitted, CasPreconditionFailed, CasStoreRefused,
  CasObservedReadable, CasObservedUnreadable, CasReadableAbsent, CasReadablePresent,
  CasSlotObservationRefused, CasGenerationPublicationRefused, CasUnreadableMalformed, CasUnreadableReadRefused,
}
import std.fabric_db {
  FabricObjectRef, FabricObject, FabricStoredObject, fabric_object_ref_of, fabric_object_ref_wire, fabric_object_ref_of_wire, fabric_object_ref_eq,
  fabric_object_preimage, fabric_object_decode, fabric_object_verified, FabricObjectVerified, FabricObjectVerificationFailed,
  FabricHeadReading, FabricHeadAbsent, FabricHeadAt, FabricHeadExpectation, fabric_head_admits,
  FabricDbFault, FabricStoreRefused, FabricObjectMissing, FabricObjectCorrupt, FabricHeadNameRefused,
  FabricPut, FabricObjectStored, FabricPutRefused,
  FabricHeadRead, FabricHeadObserved, FabricHeadReadRefused,
  FabricHeadAdvance, FabricHeadAdvanced, FabricHeadMoved, FabricHeadAdvanceRefused,
  FabricObjectGet, FabricObjectFetched, FabricObjectGetRefused,
  FabricClosureRead, FabricClosureBudgetExhausted, FabricClosureRefused,
}
import gunbc.durable_cas_file_store {
  observe_cas_slot_state, file_compare_and_set, DefaultAccessCreateOnly, cas_key_is_slot_addressable,
  admit_cas_attempt_for_derived_payload, DerivedPayloadAdmitted, DerivedPayloadKeyNotSlotAddressable,
}
import extdeps.filesystem.filesystem_io {
  Filesystem,
  FilesystemCreateNew, FilesystemCreated, FilesystemCreateTargetOccupied, FilesystemCreateRefused, FilesystemCreateKindUnrecognized,
  FilesystemExactRead, FilesystemExactPathRead, FilesystemExactPathAbsent, FilesystemExactPathUnreadable, FilesystemExactPathKindUnrecognized,
  filesystem_create_new, filesystem_exact_read, filesystem_failure_kind_name,
}

// THE FIRST REALIZATION OF std.fabric_db: ONE FILE-BACKED STORE, ONE LINEARIZATION POINT.
//
// Two areas under one root. Heads are gunbc.durable_cas_file_store slots under <root>/heads -- the
// generation-suffixed O_EXCL compare-and-set, reused whole, never re-spelled. Objects are
// <root>/objects/<ref>, each created once with the same atomic create-new publication the CAS store
// binds by default (staged, synced, hard-linked into its name), so an object name never holds a
// partial document. Nothing here deletes or rewrites.
//
// SINGLE WRITER, BY PLACEMENT (operator approval 2026-09-19). O_EXCL serializes writers only against
// ONE store instance, so every writer reaches this store on the one host that holds it -- the
// ssh-reached verb in gunbc.fabric_db_verb -- and no host keeps a second writable copy. Replication
// and failover are the program in docs/plans/fabric-db.md, not this module.
//
// THE ROOT IS NOT CREATED HERE (the CAS store's rule, for the same reason): creating the directory
// that defines the store's identity is a convergence decision, made by fabric_db_file_root_ensure,
// not a side effect of one write.

type FabricDbFileRoot {
  objects: NonEmptyStr
  heads: NonEmptyStr
}

fn fabric_db_file_root(root: NonEmptyStr) -> FabricDbFileRoot {
  FabricDbFileRoot {
    objects: join([root as String, "/objects"], "") as NonEmptyStr,
    heads: join([root as String, "/heads"], "") as NonEmptyStr,
  }
}

fn fabric_db_object_path(root: FabricDbFileRoot, object: FabricObjectRef) -> String {
  join([root.objects as String, "/", fabric_object_ref_wire(object: object) as String], "")
}

fn fabric_db_read_refused(detail: String) -> FabricDbFault {
  FabricStoreRefused { cause: CasSlotObservationRefused { cause: CasUnreadableReadRefused { detail: detail as NonEmptyStr } } }
}

fn fabric_db_publication_refused(detail: String) -> FabricDbFault {
  FabricStoreRefused { cause: CasGenerationPublicationRefused { detail: detail as NonEmptyStr } }
}

// ── OBJECTS ──────────────────────────────────────────────────────────────────────────────────

// READING AN OBJECT, classified by the host's failure kind and never its text; the bytes are then
// decoded and verified against the ref they were asked for, so no caller ever reads through a
// corrupt or colliding object.
fn fabric_db_object_from_read(asked: FabricObjectRef, exact: FilesystemExactRead) -> FabricObjectGet {
  match exact {
    FilesystemExactPathAbsent { path: _ } => FabricObjectGetRefused { fault: FabricObjectMissing { object: asked } }
    FilesystemExactPathUnreadable { path: _, kind: k, error: _ } =>
      FabricObjectGetRefused { fault: fabric_db_read_refused(detail: join(["object unreadable: ", filesystem_failure_kind_name(kind: k)], "")) }
    FilesystemExactPathKindUnrecognized { path: _, observed: o, error: _ } =>
      FabricObjectGetRefused { fault: fabric_db_read_refused(detail: join(["object read failure kind unrecognized: ", o], "")) }
    FilesystemExactPathRead { path: _, content: c } =>
      match fabric_object_decode(preimage: c) {
        Absent => FabricObjectGetRefused { fault: FabricObjectCorrupt { object: asked, detail: "held bytes are not a fabric object" } }
        Present { value: o } =>
          match fabric_object_verified(asked: asked, content: o) {
            FabricObjectVerified { stored: s } => FabricObjectFetched { stored: s }
            FabricObjectVerificationFailed { fault: f } => FabricObjectGetRefused { fault: f }
          }
      }
  }
}

fn fabric_db_file_get(root: FabricDbFileRoot, object: FabricObjectRef) -> FabricObjectGet {
  let path = fabric_db_object_path(root: root, object: object)
  let read = Filesystem.Read(path: path)
  fabric_db_object_from_read(asked: object, exact: filesystem_exact_read(path: path, content: read.content, success: read.success, error: read.error, error_kind: read.error_kind))
}

// PUTTING AN OBJECT. Its ref is derived from its bytes, so a put names nothing the caller chose. A
// put is idempotent -- the name already holding THESE bytes is the object already stored -- and an
// occupied name holding OTHER bytes is a digest collision, refused as corruption rather than read
// through: the digest family is non-cryptographic (std.content_hash content_hash_of_value), and this
// arm is what keeps a collision loud.
fn fabric_db_put_from_create(object: FabricObject, created: FilesystemCreateNew, existing: FabricObjectGet) -> FabricPut {
  let r = fabric_object_ref_of(object: object)
  match created {
    FilesystemCreated { path: _ } => FabricObjectStored { object: r }
    FilesystemCreateTargetOccupied { path: _ } =>
      match existing {
        FabricObjectFetched { stored: s } =>
          if fabric_object_preimage(object: s.content) == fabric_object_preimage(object: object) { FabricObjectStored { object: r } }
          else { FabricPutRefused { fault: FabricObjectCorrupt { object: r, detail: "a different object already holds this digest" } } }
        FabricObjectGetRefused { fault: f } => FabricPutRefused { fault: f }
      }
    FilesystemCreateRefused { path: _, kind: k, error: _ } =>
      FabricPutRefused { fault: fabric_db_publication_refused(detail: join(["object publication refused: ", filesystem_failure_kind_name(kind: k)], "")) }
    FilesystemCreateKindUnrecognized { path: _, observed: o, error: _ } =>
      FabricPutRefused { fault: fabric_db_publication_refused(detail: join(["object publication failure kind unrecognized: ", o], "")) }
  }
}

fn fabric_db_file_put(root: FabricDbFileRoot, object: FabricObject) -> FabricPut {
  let r = fabric_object_ref_of(object: object)
  let path = fabric_db_object_path(root: root, object: r)
  let write = Filesystem.WriteCreateNew(path: path, content: fabric_object_preimage(object: object) as String)
  let created = filesystem_create_new(path: write.path, success: write.success, error: write.error, error_kind: write.error_kind)
  match created {
    FilesystemCreateTargetOccupied { path: _ } => fabric_db_put_from_create(object: object, created: created, existing: fabric_db_file_get(root: root, object: r))
    FilesystemCreated { path: _ } => fabric_db_put_from_create(object: object, created: created, existing: FabricObjectGetRefused { fault: FabricObjectMissing { object: r } })
    FilesystemCreateRefused { path: _, kind: _, error: _ } => fabric_db_put_from_create(object: object, created: created, existing: FabricObjectGetRefused { fault: FabricObjectMissing { object: r } })
    FilesystemCreateKindUnrecognized { path: _, observed: _, error: _ } => fabric_db_put_from_create(object: object, created: created, existing: FabricObjectGetRefused { fault: FabricObjectMissing { object: r } })
  }
}

// ── HEADS ────────────────────────────────────────────────────────────────────────────────────

// A HEAD NAME MUST ADDRESS A SLOT: the CAS store's one predicate (no separator), asked here so a
// name that would navigate out of the heads area is refused as the caller's, not the store's.
fn fabric_db_head_name_admitted(name: NonEmptyStr) -> Bool {
  cas_key_is_slot_addressable(key: name)
}

fn fabric_db_file_head(root: FabricDbFileRoot, name: NonEmptyStr) -> FabricHeadRead {
  if !fabric_db_head_name_admitted(name: name) {
    FabricHeadReadRefused { fault: FabricHeadNameRefused { name: name } }
  } else {
    match observe_cas_slot_state(root: root.heads, key: name) {
      CasObservedUnreadable { cause: c } => FabricHeadReadRefused { fault: FabricStoreRefused { cause: CasSlotObservationRefused { cause: c } } }
      CasObservedReadable { readable: r } =>
        match r {
          CasReadableAbsent => FabricHeadObserved { reading: FabricHeadAbsent }
          CasReadablePresent { version: v } =>
            match fabric_object_ref_of_wire(wire: v.value as String) {
              Present { value: o } => FabricHeadObserved { reading: FabricHeadAt { object: o, generation: v.generation } }
              Absent => FabricHeadReadRefused {
                fault: FabricStoreRefused { cause: CasSlotObservationRefused { cause: CasUnreadableMalformed { detail: join(["head value is not an object ref: ", v.value as String], "") as NonEmptyStr } } }
              }
            }
        }
    }
  }
}

fn fabric_db_cas_expectation(reading: FabricHeadReading) -> CasExpectation {
  match reading {
    FabricHeadAbsent => ExpectSlotAbsent
    FabricHeadAt { object: _, generation: g } => ExpectSlotGeneration { generation: g }
  }
}

// ADVANCING A HEAD: the target must be a stored, verified object; the head read must admit the
// writer's expectation (else the head moved -- a lost race, carrying both sides); then the slot's
// generation compare-and-set decides the winner against every concurrent writer. A precondition the
// CAS refuses is re-read so the outcome names what beat this writer, and a re-read that cannot
// observe refuses with its own cause rather than inventing a winner.
fn fabric_db_file_advance(root: FabricDbFileRoot, name: NonEmptyStr, expected: FabricHeadExpectation, target: FabricObjectRef) -> FabricHeadAdvance {
  match fabric_db_file_get(root: root, object: target) {
    FabricObjectGetRefused { fault: f } => FabricHeadAdvanceRefused { fault: f }
    FabricObjectFetched { stored: _ } =>
      match fabric_db_file_head(root: root, name: name) {
        FabricHeadReadRefused { fault: f } => FabricHeadAdvanceRefused { fault: f }
        FabricHeadObserved { reading: observed } =>
          if !fabric_head_admits(expected: expected, observed: observed) {
            FabricHeadMoved { expected: expected, observed: observed }
          } else {
            match admit_cas_attempt_for_derived_payload(key: name, expected: fabric_db_cas_expectation(reading: observed), proposed: fabric_object_ref_wire(object: target)) {
              DerivedPayloadKeyNotSlotAddressable { key: k } => FabricHeadAdvanceRefused { fault: FabricHeadNameRefused { name: k } }
              DerivedPayloadAdmitted { verified: v } =>
                match file_compare_and_set(root: root.heads, publication: DefaultAccessCreateOnly, verified: v) {
                  CasCommitted { committed: c } => FabricHeadAdvanced { object: target, generation: c.generation }
                  CasStoreRefused { cause: c } => FabricHeadAdvanceRefused { fault: FabricStoreRefused { cause: c } }
                  CasPreconditionFailed { expected: _, observed: _ } =>
                    match fabric_db_file_head(root: root, name: name) {
                      FabricHeadReadRefused { fault: f } => FabricHeadAdvanceRefused { fault: f }
                      FabricHeadObserved { reading: now } => FabricHeadMoved { expected: expected, observed: now }
                    }
                }
            }
          }
      }
  }
}

// ── CLOSURE ──────────────────────────────────────────────────────────────────────────────────

// THE WHOLE CHAIN, READ WHERE IT IS HELD. From the head, every object reachable along links, each
// fetched and verified; a link naming an absent object refuses FabricObjectMissing with that ref,
// and running out of the bound refuses rather than returning the part that fit.
// SEEN IS A SET KEYED BY THE REF'S WIRE FORM, so each step's membership test is constant rather
// than a scan of everything fetched so far -- a partition of n events costs n fetches, not n^2
// comparisons.
type ClosureState {
  pending: List<FabricObjectRef>
  newest_first: List<FabricStoredObject>
  seen: Set<String>
  refused: FabricDbFault?
}

fn closure_seen(st: ClosureState, r: FabricObjectRef) -> Bool {
  set_contains(st.seen, fabric_object_ref_wire(object: r) as String)
}

fn closure_step(root: FabricDbFileRoot, st: ClosureState) -> ClosureState {
  match st.refused {
    Present { value: _ } => st
    Absent =>
      match first(st.pending) {
        Absent => st
        Present { value: next } => {
          let rest = st.pending |> skip(n: 1)
          if closure_seen(st: st, r: next) {
            ClosureState { pending: rest, newest_first: st.newest_first, seen: st.seen, refused: none }
          } else {
            match fabric_db_file_get(root: root, object: next) {
              FabricObjectGetRefused { fault: f } => ClosureState { pending: rest, newest_first: st.newest_first, seen: st.seen, refused: Present { value: f } }
              FabricObjectFetched { stored: s } => ClosureState { pending: concat(rest, s.content.links), newest_first: concat(st.newest_first, [s]), seen: set_insert(st.seen, fabric_object_ref_wire(object: next) as String), refused: none }
            }
          }
        }
      }
  }
}

fn fabric_db_file_closure(root: FabricDbFileRoot, name: NonEmptyStr, bound: Nat) -> FabricClosureRead {
  match fabric_db_file_head(root: root, name: name) {
    FabricHeadReadRefused { fault: f } => FabricClosureRefused { fault: f }
    FabricHeadObserved { reading: FabricHeadAbsent } => FabricClosureRead { reading: FabricHeadAbsent, newest_first: [] }
    FabricHeadObserved { reading: FabricHeadAt { object: h, generation: g } } => {
      let st = fold(nat_range_inclusive(lo: 1, hi: bound), init: ClosureState { pending: [h], newest_first: [], seen: empty_set(), refused: none }, f: (acc, _i) => closure_step(root: root, st: acc))
      match st.refused {
        Present { value: f } => FabricClosureRefused { fault: f }
        Absent =>
          match first(st.pending) {
            Present { value: at } => FabricClosureBudgetExhausted { at: at, bound: bound }
            Absent => FabricClosureRead { reading: FabricHeadAt { object: h, generation: g }, newest_first: st.newest_first }
          }
      }
    }
  }
}

// ── THE ROOT ─────────────────────────────────────────────────────────────────────────────────

// THE PLACEMENT ENSURE, run ON the store's host: both areas created if absent. The root's parent,
// its ownership and mode are the substrate's obligation; a missing or unwritable parent refuses.
type FabricDbRootStanding
  = FabricDbRootReady
  | FabricDbRootRefused { area: String, detail: String }

fn fabric_db_file_root_ensure(root: FabricDbFileRoot) -> FabricDbRootStanding {
  let o = shell.Mkdir.Parents(path: root.objects as FilePath)
  if !o.success {
    FabricDbRootRefused { area: "objects", detail: join(["could not create ", root.objects as String], "") }
  } else {
    let h = shell.Mkdir.Parents(path: root.heads as FilePath)
    if !h.success { FabricDbRootRefused { area: "heads", detail: join(["could not create ", root.heads as String], "") } } else { FabricDbRootReady }
  }
}
