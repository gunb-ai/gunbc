// THE FIRST REALIZATION OF std.fabric_storage: ONE FILE-BACKED STORE, ONE LINEARIZATION POINT.
//
// Two areas under one root. Heads are gunbc.durable_cas_file_store slots under <root>/heads -- the
// generation-suffixed O_EXCL compare-and-set, reused whole, never re-spelled. Objects are
// <root>/objects/<ref>, each created once with the same atomic create-new publication the CAS store
// binds by default (staged, synced, hard-linked into its name), so an object name never holds a
// partial document. Nothing here deletes or rewrites.
//
// SINGLE WRITER, BY PLACEMENT (operator approval 2026-09-19). O_EXCL serializes writers only against
// ONE store instance, so every writer reaches this store on the one host that holds it -- in process
// there, and through the served endpoint (gunbc.fabric.fabric_storage_serve, reached by gunbc.fabric.fabric_storage_client)
// from every other host -- and no host keeps a second writable copy. Replication
// and failover are the program in docs/plans/fabric-storage.md, not this module.
//
// THE ROOT IS NOT CREATED BY A WRITE (the CAS store's rule, for the same reason): standing up the
// directory that defines the store's identity is a placement decision, made once by the mint below
// against the declared member chain, never as a side effect of one write.

// THE ENTRY MODE IS THE PLACEMENT'S FACT, NOT THIS REALIZATION'S. Who reads the store's files is
// decided by who the placement declares as its writers and readers
// (gunbc.fabric.fabric_storage_placement fabric_storage_placed_store); a root built with no declared
// mode publishes at the writing process's umask, which is what a single-principal fixture wants and
// what a store with two principals must not rely on.
// SEALED CONSTRUCTION: only this module builds the record. A forged record literal or cast elsewhere is a SoleConstructorViolation. The path mints that used to live here are
// DELETED: the only route to this record is the ONE declaration-driven mint below. The rung established
// is construction: a consumer cannot be handed a FORGED store record. It is not a claim that no caller can
// choose the directory: HostDashboardInstance has no sole constructor and isolated_dashboard_instance
// accepts any root, so fabric_store_open can still be reached over a chosen directory, and any module can
// still build a plain store over a literal path with Filesystem + file_slot_store_over. That residual is
// recorded once in gunbc.recurring_failure_mode a_slot_store_is_built_over_a_literal_path_by_any_module
// (route 3, owned by the ambient-authority lane); no rung is claimed for it.
type FabricStorageOperations sole_constructor {
  objects: NonEmptyStr
  heads: NonEmptyStr
  entry_mode: FileMode?
}

// ── ONE FAMILY, ONE RULE ───────────────────────────────────────────────────────────────────────
//
// §6b root generalization: the fabric stores differ only in WHICH declared member chain under a host
// instance's root they sit on. One mint takes a member chain -- read from a data row, never a path --
// and every store in the family is an instance of it. The public CAS sits at instance_root/fabric-
// storage; its state space is a member under that; compute's capacity ledger (gunbc.compute.
// host_capacity, which declares its own chain) sits under instance_root/compute. The mode each
// directory is ENROLLED with belongs to the substrate's demand rows, not to the mint: the mint only
// opens what the substrate provisioned.
data fabric_storage_slots: List<NonEmptyStr> = ["fabric-storage"]
data fabric_storage_state_slots: List<NonEmptyStr> = ["fabric-storage", "state"]

// The root the declaration picks: the member chain applied in order under the instance root. The ONE
// place that spells the join; every route to a fabric store root goes through it.
fn fabric_store_declared_root(members: List<NonEmptyStr>, root: FilePath) -> FilePath {
  match first(members) {
    Absent => root
    Present { value: head } =>
      fabric_store_declared_root(members: skip(members, n: 1), root: dashboard_instance_child(root: root, child: head as String))
  }
}

// THE TWO AREAS A STORE'S DECLARATION IMPLIES, spelled exactly once. The operations use them, and the
// substrate's provisioning rows (gunbc.fabric.fabric_storage_placement
// fabric_storage_store_directories) ask for the SAME paths from the SAME row, so a store and the
// directories it needs cannot disagree. This is a path pair, not a store: constructing it grants no
// capability -- only FabricStorageOperations, minted below, does.
type FabricStoreAreas { objects: NonEmptyStr, heads: NonEmptyStr }

fn fabric_store_area_paths(members: List<NonEmptyStr>, instance: HostDashboardInstance) -> FabricStoreAreas {
  let root = fabric_store_declared_root(members: members, root: instance.instance_root)
  FabricStoreAreas {
    objects: join([root as String, "/objects"], "") as NonEmptyStr,
    heads: join([root as String, "/heads"], "") as NonEmptyStr,
  }
}

// THE MINT. It takes the declared member chain and the business key -- never a path, never a directory
// someone chose. It first lists the store root the declaration picks: a root the substrate has not
// provisioned is Unready, and no caller can hand the mint a directory to paper over that. Then it LISTS the two
// AREAS under that root and creates nothing: a missing area is Unready naming it (creation and mode are
// the owned-directory rows'). `entry_mode` is a PUBLISHING posture, not a
// location: the placement mint derives it from the writer rosters (refusing while they are unresolved)
// and hands it here; stores with no declared publication mode pass Absent and post at the process umask,
// exactly as they did before.
type FabricStoreStanding = FabricStoreReady { store: FabricStorageOperations } | FabricStoreUnready { area: String, detail: String }

fn fabric_store_open(members: List<NonEmptyStr>, instance: HostDashboardInstance, entry_mode: FileMode?) -> FabricStoreStanding {
  let root = fabric_store_declared_root(members: members, root: instance.instance_root)
  let areas = fabric_store_area_paths(members: members, instance: instance)
  let listing = Filesystem.List(path: root as String)
  match filesystem_listing_observation(directory: root as String, success: listing.success, entries: listing.entries, error: listing.error) {
    FilesystemDirectorySubjectRefused { directory: _, cause: c } =>
      FabricStoreUnready { area: "root", detail: join(["the store's directory ", root as String, " is not admissible: ", c], "") }
    FilesystemDirectoryListingRefused { directory: _, error: e } =>
      FabricStoreUnready { area: "root", detail: join(["the store's directory ", root as String, " could not be listed: ", e], "") }
    FilesystemDirectoryListed(_) => fabric_store_area_standing(areas: areas, entry_mode: entry_mode)
  }
}

// EACH AREA IS OBSERVED, NEVER CREATED. Creation (and the mode) belongs to the owned-directory rows
// fabric_storage_store_directories / compute_capacity_directories derive from the same declaration, so an
// area no row has provisioned is Unready naming that area, never a directory made here at the umask.
fn fabric_store_area_standing(areas: FabricStoreAreas, entry_mode: FileMode?) -> FabricStoreStanding {
  let o = Filesystem.List(path: areas.objects as String)
  if !o.success {
    FabricStoreUnready { area: "objects", detail: join([areas.objects as String, " is not provisioned: ", o.error], "") }
  } else {
    let h = Filesystem.List(path: areas.heads as String)
    if !h.success {
      FabricStoreUnready { area: "heads", detail: join([areas.heads as String, " is not provisioned: ", h.error], "") }
    } else {
      FabricStoreReady { store: FabricStorageOperations { objects: areas.objects, heads: areas.heads, entry_mode: entry_mode } }
    }
  }
}

fn fabric_storage_head_publication(root: FabricStorageOperations) -> CasGenerationPublication {
  match root.entry_mode {
    Absent => DefaultAccessCreateOnly
    Present { value: m } => DeclaredModeCreateOnly { mode: m }
  }
}

// ONE CREATE-NEW PUBLICATION EITHER WAY; the declared mode only decides the published bits.
// CasExpectation, stated: this is the ExpectSlotAbsent arm done by the filesystem (O_EXCL create-new) over a
// CONTENT-ADDRESSED name, so a lost race publishes identical bytes and no generation line exists to advance. It DIVERGES from
// std.durable_compare_and_set on purpose: an immutable object has no head to compare. Every MUTABLE fact here (the head)
// advances through fabric_storage_cas_expectation -> file_compare_and_set_windowed, the one CAS authority.
fn fabric_storage_object_create(root: FabricStorageOperations, path: String, content: String) -> FilesystemCreateNew {
  match root.entry_mode {
    Absent => {
      let w = Filesystem.WriteCreateNew(path: path, content: content)
      filesystem_create_new(path: w.path, success: w.success, error: w.error, error_kind: w.error_kind)
    }
    Present { value: m } => {
      let w = Filesystem.WriteCreateNewWithMode(path: path, content: content, mode: file_mode_bits(mode: m))
      filesystem_create_new(path: w.path, success: w.success, error: w.error, error_kind: w.error_kind)
    }
  }
}

fn fabric_storage_object_path(root: FabricStorageOperations, object: FabricObjectRef) -> String {
  join([root.objects as String, "/", fabric_object_ref_wire(object: object) as String], "")
}

fn fabric_storage_read_refused(detail: String) -> FabricStorageFault {
  FabricStoreRefused { cause: CasSlotObservationRefused { cause: CasUnreadableReadRefused { detail: detail as NonEmptyStr } } }
}

fn fabric_storage_publication_refused(detail: String) -> FabricStorageFault {
  FabricStoreRefused { cause: CasGenerationPublicationRefused { detail: detail as NonEmptyStr } }
}

// ── OBJECTS ──────────────────────────────────────────────────────────────────────────────────

// READING AN OBJECT, classified by the host's failure kind and never its text; the bytes are then
// decoded and verified against the ref they were asked for, so no caller ever reads through a
// corrupt or colliding object.
fn fabric_storage_object_from_read(asked: FabricObjectRef, exact: FilesystemExactRead) -> FabricObjectGet {
  match exact {
    FilesystemExactPathAbsent { path: _ } => FabricObjectGetRefused { fault: FabricObjectMissing { object: asked } }
    FilesystemExactPathUnreadable { path: _, kind: k, error: _ } =>
      FabricObjectGetRefused { fault: fabric_storage_read_refused(detail: join(["object unreadable: ", filesystem_failure_kind_name(kind: k)], "")) }
    FilesystemExactPathKindUnrecognized { path: _, observed: o, error: _ } =>
      FabricObjectGetRefused { fault: fabric_storage_read_refused(detail: join(["object read failure kind unrecognized: ", o], "")) }
    FilesystemExactPathRead { path: _, content: c } =>
      match fabric_object_decode(preimage: c) {
        Absent => FabricObjectGetRefused { fault: FabricObjectCorrupt { object: asked, detail: "held bytes are not a fabric object" } }
        Present { value: o } =>
          match fabric_object_verified(asked: asked, content: o) {
            FabricObjectVerified { stored: s } => FabricObjectFetched { stored: s }
            FabricObjectVerificationFailed { fault: f } => FabricObjectGetRefused { fault: f }
          }
      }
  }
}

fn fabric_storage_file_get(root: FabricStorageOperations, object: FabricObjectRef) -> FabricObjectGet {
  let path = fabric_storage_object_path(root: root, object: object)
  let read = Filesystem.Read(path: path)
  fabric_storage_object_from_read(asked: object, exact: filesystem_exact_read(path: path, content: read.content, success: read.success, error: read.error, error_kind: read.error_kind))
}

// PUTTING AN OBJECT. Its ref is derived from its bytes, so a put names nothing the caller chose. A
// put is idempotent -- the name already holding THESE bytes is the object already stored -- and an
// occupied name holding OTHER bytes is refused as corruption rather than read through.
//
// THE COLLISION ARM STAYS. The digest family is non-cryptographic (gunbc.recurring_failure_mode
// fabric_object_identity_is_a_structural_locator), so a collision is a thing an ordinary workload
// can actually meet and the arm is a wall against an accident. It must not be removed when the
// family becomes cryptographic either: under that family a collision stops being noise and becomes
// an ATTACK, which is exactly when the check earns its keep.
//
// THE REF IS RECEIVED, NOT RE-DERIVED: the object and its ref arrive as ONE carrier, minted once at
// the entry below, so this function cannot be handed a ref for some other object's bytes.
// BOTH HALVES OF THE ADDRESSED OBJECT COME OFF THE CARRIER, and the write below reads a.object
// rather than the outer `object` deliberately. They are the same VALUE; the difference is SHAPE.
// Reading the outer binding is the spelling that lets a later edit change one side without the
// other, which is how the peer-parameter defect FabricAddressedObject exists to close gets back in.
fn fabric_storage_file_put(root: FabricStorageOperations, object: FabricObject) -> FabricPut {
  let a = fabric_object_addressed(object: object)
  let r = a.ref
  let path = fabric_storage_object_path(root: root, object: r)
  let created = fabric_storage_object_create(root: root, path: path, content: fabric_object_preimage(object: a.object) as String)
  match created {
    FilesystemCreated { path: _ } => FabricObjectStored { object: r }
    FilesystemCreateTargetOccupied { path: _ } =>
      match fabric_storage_file_get(root: root, object: r) {
        FabricObjectFetched { stored: s } =>
          if fabric_object_preimage(object: s.content) == fabric_object_preimage(object: a.object) { FabricObjectStored { object: r } }
          else { FabricPutRefused { fault: FabricObjectCorrupt { object: r, detail: "a different object already holds this digest" } } }
        FabricObjectGetRefused { fault: f } => FabricPutRefused { fault: f }
      }
    FilesystemCreateRefused { path: _, kind: k, error: _ } =>
      FabricPutRefused { fault: fabric_storage_publication_refused(detail: join(["object publication refused: ", filesystem_failure_kind_name(kind: k)], "")) }
    FilesystemCreateKindUnrecognized { path: _, observed: o, error: _ } =>
      FabricPutRefused { fault: fabric_storage_publication_refused(detail: join(["object publication failure kind unrecognized: ", o], "")) }
  }
}

// ── HEADS ────────────────────────────────────────────────────────────────────────────────────

// A HEAD NAME MUST ADDRESS A SLOT: the CAS store's one predicate (no separator), asked here so a
// name that would navigate out of the heads area is refused as the caller's, not the store's.
fn fabric_storage_head_name_admitted(name: NonEmptyStr) -> Bool {
  cas_key_is_slot_addressable(key: name)
}

fn fabric_storage_file_head(root: FabricStorageOperations, name: NonEmptyStr) -> FabricHeadRead {
  if !fabric_storage_head_name_admitted(name: name) {
    FabricHeadReadRefused { fault: FabricHeadNameRefused { name: name } }
  } else {
    match observe_cas_slot_state(root: root.heads, key: name) {
      CasObservedUnreadable { cause: c } => FabricHeadReadRefused { fault: FabricStoreRefused { cause: CasSlotObservationRefused { cause: c } } }
      CasObservedReadable { readable: r } =>
        match r {
          CasReadableAbsent => FabricHeadObserved { reading: FabricHeadAbsent }
          CasReadablePresent { version: v } =>
            match fabric_object_ref_of_wire(wire: v.value as String) {
              Present { value: o } => FabricHeadObserved { reading: FabricHeadAt { object: o, generation: v.generation } }
              Absent => FabricHeadReadRefused {
                fault: FabricStoreRefused { cause: CasSlotObservationRefused { cause: CasUnreadableMalformed { detail: join(["head value is not an object ref: ", v.value as String], "") as NonEmptyStr } } }
              }
            }
        }
    }
  }
}

fn fabric_storage_cas_expectation(reading: FabricHeadReading) -> CasExpectation {
  match reading {
    FabricHeadAbsent => ExpectSlotAbsent
    FabricHeadAt { object: _, generation: g } => ExpectSlotGeneration { generation: g }
  }
}

// ADVANCING A HEAD: the target must be a stored, verified object; the head read must admit the
// writer's expectation (else the head moved -- a lost race, carrying both sides); then the slot's
// generation compare-and-set decides the winner against every concurrent writer. A precondition the
// CAS refuses is re-read so the outcome names what beat this writer, and a re-read that cannot
// observe refuses with its own cause rather than inventing a winner.
fn fabric_storage_file_advance(root: FabricStorageOperations, name: NonEmptyStr, expected: FabricHeadExpectation, target: FabricObjectRef) -> FabricHeadAdvance {
  match fabric_storage_file_get(root: root, object: target) {
    FabricObjectGetRefused { fault: f } => FabricHeadAdvanceRefused { fault: f }
    FabricObjectFetched { stored: _ } =>
      match fabric_storage_file_head(root: root, name: name) {
        FabricHeadReadRefused { fault: f } => FabricHeadAdvanceRefused { fault: f }
        FabricHeadObserved { reading: observed } =>
          if !fabric_head_admits(expected: expected, observed: observed) {
            FabricHeadMoved { expected: expected, observed: observed }
          } else {
            match admit_cas_attempt_for_derived_payload(key: name, expected: fabric_storage_cas_expectation(reading: observed), proposed: fabric_object_ref_wire(object: target)) {
              DerivedPayloadKeyNotSlotAddressable { key: k } => FabricHeadAdvanceRefused { fault: FabricHeadNameRefused { name: k } }
              DerivedPayloadAdmitted { verified: v } =>
                match file_compare_and_set(root: root.heads, publication: fabric_storage_head_publication(root: root), verified: v) {
                  CasCommitted { committed: c } => FabricHeadAdvanced { object: target, generation: c.generation }
                  CasStoreRefused { cause: c } => FabricHeadAdvanceRefused { fault: FabricStoreRefused { cause: c } }
                  CasPreconditionFailed { expected: _, observed: _ } =>
                    match fabric_storage_file_head(root: root, name: name) {
                      FabricHeadReadRefused { fault: f } => FabricHeadAdvanceRefused { fault: f }
                      FabricHeadObserved { reading: now } => FabricHeadMoved { expected: expected, observed: now }
                    }
                }
            }
          }
      }
  }
}

// ── CLOSURE ──────────────────────────────────────────────────────────────────────────────────

// THE WHOLE CHAIN, READ WHERE IT IS HELD. From the head, every object reachable along links, each
// fetched and verified; a link naming an absent object refuses FabricObjectMissing with that ref,
// and running out of the bound refuses rather than returning the part that fit.
// SEEN IS A SET KEYED BY THE REF'S WIRE FORM, so each step's membership test is constant rather
// than a scan of everything fetched so far -- a partition of n events costs n fetches, not n^2
// comparisons.
type ClosureState {
  pending: List<FabricObjectRef>
  newest_first: List<FabricStoredObject>
  seen: Set<String>
  refused: FabricStorageFault?
}

fn closure_seen(st: ClosureState, r: FabricObjectRef) -> Bool {
  set_contains(st.seen, fabric_object_ref_wire(object: r) as String)
}

fn closure_step(root: FabricStorageOperations, st: ClosureState) -> ClosureState {
  match st.refused {
    Present { value: _ } => st
    Absent =>
      match first(st.pending) {
        Absent => st
        Present { value: next } => {
          let rest = st.pending |> skip(n: 1)
          if closure_seen(st: st, r: next) {
            ClosureState { pending: rest, newest_first: st.newest_first, seen: st.seen, refused: none }
          } else {
            match fabric_storage_file_get(root: root, object: next) {
              FabricObjectGetRefused { fault: f } => ClosureState { pending: rest, newest_first: st.newest_first, seen: st.seen, refused: Present { value: f } }
              FabricObjectFetched { stored: s } => ClosureState { pending: concat(rest, s.content.links), newest_first: concat(st.newest_first, [s]), seen: set_insert(st.seen, fabric_object_ref_wire(object: next) as String), refused: none }
            }
          }
        }
      }
  }
}

// Stop when the observed closure ends, not after allocating the full configured upper bound.
// Each advancing step consumes one unit exactly as the former bounded fold did.
fn closure_pump(root: FabricStorageOperations, st: ClosureState, steps: Nat, bound: Nat) -> ClosureState {
  if steps >= bound || st.pending.count() == 0 { st }
  else { match st.refused {
    Present { value: _ } => st
    Absent => closure_pump(root: root, st: closure_step(root: root, st: st), steps: steps + 1, bound: bound)
  } }
}

fn fabric_storage_file_closure(root: FabricStorageOperations, name: NonEmptyStr, bound: Nat) -> FabricClosureRead {
  match fabric_storage_file_head(root: root, name: name) {
    FabricHeadReadRefused { fault: f } => FabricClosureRefused { fault: f }
    FabricHeadObserved { reading: FabricHeadAbsent } => FabricClosureRead { reading: FabricHeadAbsent, newest_first: [] }
    FabricHeadObserved { reading: FabricHeadAt { object: h, generation: g } } => {
      let st = closure_pump(root: root, st: ClosureState { pending: [h], newest_first: [], seen: empty_set(), refused: none }, steps: 0, bound: bound)
      match st.refused {
        Present { value: f } => FabricClosureRefused { fault: f }
        Absent =>
          match first(st.pending) {
            Present { value: at } => FabricClosureBudgetExhausted { at: at, bound: bound }
            Absent => FabricClosureRead { reading: FabricHeadAt { object: h, generation: g }, newest_first: st.newest_first }
          }
      }
    }
  }
}

