module gunbc.fabric.fci1_bounded_execution_context_emit

import std.types { String }
import std.measure { finite_byte_size_count }
import gunbc.fabric.fci1_bounded_execution_context {
  Fci1BoundedExecutionContextBuilt,
  Fci1MemoryMaxNonPositive,
  Fci1MemoryHighNonPositive,
  Fci1MemoryHighExceedsMax,
  fci1_bounded_execution_context,
}
import std.optional { Present, Absent }
import gunbc.live_deploy.slice_bounds { fci1_controls_slice_unit_name, fci1_controls_slice_memory_max }
import gunbc.fabric.fci1_controls_slice { fci1_controls_slice_unit_text, fci1_controls_slice_unit_path }
import std.measure { byte_size_count }
import extdeps.systemd { SliceProperty, WorkingDirectoryProperty, RuntimeDirectoryProperty, MemoryMax, MemoryHigh, systemd_unit_property_wire }

type Fci1BoundedExecutionContextEmission
  = Fci1BoundedExecutionContextEmitted { content: String }
  | Fci1BoundedExecutionContextEmissionRefused { reason: String }

// THIS FUNCTION IS THE MEDIUM-AS-STRING CARRIER OF THE PAIR, AND IT RETIRES ON THE SAME TRIGGER AS
// THE TWO SHELL FILES IT FEEDS. The bash is built by `join([...])` here rather than by orchestration
// emit, which is the tell DESIGN section 6 names, admitted as an interim only because the trigger
// below names the capability that actually replaces it.
//
// dissolve-on: the bash target grammar gains the constructs the two shell files need ([[ ]] with
// glob matching, function definitions with local and return, $(<file) reads, and an a && b || c list
// rendered without a subshell), so this carrier and those files can be built as
// v2.extdeps.languages.bash_build nodes and emitted by v2.workflow.bash_emit, or as typed
// host_effect_apply. CORRECTED 2026-09-28: #12430 classed this (c), "route available today". It is
// (b), a missing target-language capability.
// -- the same condition carried by tools/fabric_ci_fci1_live_instrument.sh (the bounded controls
// moved to gunbc.instruments.fabric_ci_fci1_bounded_controls_actuator).
//
// THE MARK IS HERE AND NOT ONLY ON THOSE TWO FILES BECAUSE THE TRIGGER WOULD OTHERWISE RETIRE THEM
// AND LEAVE THIS ONE STANDING. A reader of this module has no way to reach a marker written in the
// shell it emits, so the coverage would be real and invisible; DESIGN section 6 puts the mark on the
// carrier rather than in a parallel ledger for exactly that reason.

// Bootstrap-safe projection of the typed context coordinates needed before the first gunbc call.
// Checkout root is deliberately absent: the instrument derives that live from its own path, then
// passes the same root to the context and to WorkingDirectory. This artifact carries no second path
// selector and no independently authored byte spelling.
// SCAFFOLD - dissolve-on: the bash target grammar (v2.extdeps.languages.bash rows, built by
// v2.extdeps.languages.bash_build, serialized by v2.workflow.bash_emit) gains here-documents,
// [[ ]] conditionals, function definitions with return, and || lists; this env is then emitted from
// those nodes. The install/remove lifecycle below is string-built shell for the same reason and on
// the same trigger as the two FCI-1 scripts that source it; it adds no new trigger.
fn expected_fci1_bounded_execution_context_env() -> Fci1BoundedExecutionContextEmission {
  match fci1_bounded_execution_context(checkout_root: ".") {
    Fci1MemoryMaxNonPositive { observed: value } =>
      Fci1BoundedExecutionContextEmissionRefused {
        reason: join(["FCI-1 MemoryMax is not finite-positive: ", to_string(value)], ""),
      }
    Fci1MemoryHighNonPositive { observed: value } =>
      Fci1BoundedExecutionContextEmissionRefused {
        reason: join(["FCI-1 MemoryHigh is not finite-positive: ", to_string(value)], ""),
      }
    Fci1MemoryHighExceedsMax { high: high, max: max } =>
      Fci1BoundedExecutionContextEmissionRefused {
        reason: join([
          "FCI-1 MemoryHigh exceeds MemoryMax: high=", to_string(finite_byte_size_count(size: high)),
          " max=", to_string(finite_byte_size_count(size: max)),
        ], ""),
      }
    Fci1BoundedExecutionContextBuilt { context: context } =>
      match context.memory_high {
        Absent => Fci1BoundedExecutionContextEmissionRefused {
          reason: "FCI-1 bounded driver requires the runner-workload MemoryHigh projection",
        }
        Present { value: high } => Fci1BoundedExecutionContextEmitted { content: join([
          "#!/usr/bin/env bash\n",
          "# GENERATED by dag/gunbc/fabric/fci1_bounded_execution_context_emit.dag — DO NOT HAND-EDIT.\n",
          "FCI1_MEMORY_MAX_BYTES=", to_string(finite_byte_size_count(size: context.memory_max)), "\n",
          "FCI1_MEMORY_HIGH_BYTES=", to_string(finite_byte_size_count(size: high)), "\n",
          "FCI1_DRIVER_UNIT=", context.driver_unit as String, "\n",
          "readonly FCI1_MEMORY_MAX_BYTES FCI1_MEMORY_HIGH_BYTES FCI1_DRIVER_UNIT\n",
          "fci1_install_controls_slice() {\n",
          "  [[ ! -e ", fci1_controls_slice_unit_path(), " ]] || { echo 'ControlRefused: ", fci1_controls_slice_unit_path(), " already exists' >&2; return 2; }\n",
          "  cat >", fci1_controls_slice_unit_path(), " <<'FCI1_SLICE_UNIT'\n",
          fci1_controls_slice_unit_text(),
          "FCI1_SLICE_UNIT\n",
          "  [[ -f ", fci1_controls_slice_unit_path(), " ]] || { echo 'ControlRefused: slice unit write failed' >&2; fci1_remove_controls_slice; return 2; }\n",
          "  systemctl daemon-reload || { echo 'ControlRefused: daemon-reload failed' >&2; fci1_remove_controls_slice; return 2; }\n",
          "  [[ $(systemctl show ", fci1_controls_slice_unit_name as String, " --property=MemoryMax --value) == ", to_string(byte_size_count(b: fci1_controls_slice_memory_max())), " ]] || { echo 'ControlRefused: slice cap not live' >&2; fci1_remove_controls_slice; return 2; }\n",
          "}\n",
          "fci1_remove_controls_slice() {\n",
          "  local s=0\n",
          "  systemctl stop ", fci1_controls_slice_unit_name as String, " 2>/dev/null || [[ $(systemctl show ", fci1_controls_slice_unit_name as String, " --property=LoadState --value) == not-found ]] || { echo 'ControlRefused: slice stop failed' >&2; s=1; }\n",
          "  rm -f ", fci1_controls_slice_unit_path(), " || { echo 'ControlRefused: slice unit removal failed' >&2; s=1; }\n",
          "  systemctl daemon-reload || { echo 'ControlRefused: daemon-reload after slice removal failed' >&2; s=1; }\n",
          "  [[ ! -e ", fci1_controls_slice_unit_path(), " ]] || { echo 'ControlRefused: slice unit file still present' >&2; s=1; }\n",
          "  return $s\n",
          "}\n",
          "fci1_run_bounded_driver() {\n",
          "  local checkout_root=$1; shift\n",
          "  systemd-run --quiet --wait --pipe --collect --unit=\"$FCI1_DRIVER_UNIT\" \\\n",
          "    --property=\"", systemd_unit_property_wire(property: WorkingDirectoryProperty) as String, "=$checkout_root\" \\\n",
          "    --property=\"", systemd_unit_property_wire(property: SliceProperty) as String, "=", fci1_controls_slice_unit_name as String, "\" \\\n",
          "    --property=\"", systemd_unit_property_wire(property: MemoryMax) as String, "=$FCI1_MEMORY_MAX_BYTES\" \\\n",
          "    --property=\"", systemd_unit_property_wire(property: MemoryHigh) as String, "=$FCI1_MEMORY_HIGH_BYTES\" -- \"$@\"\n",
          "}\n",
          "fci1_run_bounded_submitter() {\n",
          "  local unit=$1 checkout_root=$2; shift 2\n",
          "  systemd-run --quiet --wait --pipe --collect --unit=\"$unit\" \\\n",
          "    --property=\"", systemd_unit_property_wire(property: WorkingDirectoryProperty) as String, "=$checkout_root\" \\\n",
          "    --property=\"", systemd_unit_property_wire(property: SliceProperty) as String, "=", fci1_controls_slice_unit_name as String, "\" \\\n",
          "    --property=\"", systemd_unit_property_wire(property: MemoryMax) as String, "=$FCI1_MEMORY_MAX_BYTES\" \\\n",
          "    --property=\"", systemd_unit_property_wire(property: MemoryHigh) as String, "=$FCI1_MEMORY_HIGH_BYTES\" -- \"$@\"\n",
          "}\n",
          "fci1_run_bounded_dependent_submitter() {\n",
          "  local unit=$1 checkout_root=$2 runtime_directory=$3; shift 3\n",
          "  systemd-run --quiet --wait --pipe --collect --unit=\"$unit\" \\\n",
          "    --property=\"", systemd_unit_property_wire(property: WorkingDirectoryProperty) as String, "=$checkout_root\" \\\n",
          "    --property=\"", systemd_unit_property_wire(property: SliceProperty) as String, "=", fci1_controls_slice_unit_name as String, "\" \\\n",
          "    --property=\"", systemd_unit_property_wire(property: MemoryMax) as String, "=$FCI1_MEMORY_MAX_BYTES\" \\\n",
          "    --property=\"", systemd_unit_property_wire(property: MemoryHigh) as String, "=$FCI1_MEMORY_HIGH_BYTES\" \\\n",
          "    --property=\"", systemd_unit_property_wire(property: RuntimeDirectoryProperty) as String, "=$runtime_directory\" -- \"$@\"\n",
          "}\n",
          "fci1_run_unbounded_memory_control() {\n",
          "  local unit=$1 checkout_root=$2; shift 2\n",
          "  systemd-run --quiet --wait --pipe --collect --unit=\"$unit\" \\\n",
          "    --property=\"", systemd_unit_property_wire(property: WorkingDirectoryProperty) as String, "=$checkout_root\" \\\n",
          "    --property=\"", systemd_unit_property_wire(property: MemoryMax) as String, "=infinity\" -- \"$@\"\n",
          "}\n",
        ], "") }
      }
  }
}
