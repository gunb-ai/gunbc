module gunbc.fabric.fabric_allocation_store

import std.types { NonEmptyStr, String }
import std.durable_compare_and_set { CasSlotObservation, CasGeneration, CasOutcome }
import std.durable_exclusive_hold { DurableHoldOwnerRef, DurableHoldReleaseRef, DurableHoldObservation }
import gunbc.managed_directory { DeclaredDirectoryMode, DirectoryOwnerOnly }
import gunbc.host_state_root { HostStateTree, host_state_tree_path }
import gunbc.durable_cas_file_store { observe_cas_slot_state, file_compare_and_set, CasGenerationPublication, VerifiedCasAttempt }
import gunbc.durable_exclusive_hold_file_store {
  observe_file_hold, file_hold_acquire, file_hold_acquire_prepare, file_hold_acquire_commit, file_hold_release_assess, file_hold_release_commit,
  FileHoldAcquireOutcome, FileHoldAcquirePreparation, FileHoldAcquirePlan, FileHoldReleaseAssessment, FileHoldReleasePlan, FileHoldReleaseOutcome,
}
import gunbc.runner.runner_microvm_cell_readiness_store { read_store_ownership, StoreOwnershipReading }
import extdeps.filesystem.filesystem_io { Filesystem, filesystem_listing_observation, FilesystemDirectoryListed, FilesystemDirectoryListingRefused, FilesystemDirectorySubjectRefused }

// THE FABRIC ALLOCATION STORE: one durable exclusive hold per runner cell (gunbc.fabric.fabric_control_plane
// fabric_cell_allocation_key), the slot whose committed generation says which reservation holds the cell.
// A HOST SINGLETON: no instance keys it, because the cells it allocates are the host's and every broker on
// the host must contend in ONE store for the compare-and-set to mean exclusion. Its root derives from the
// host-state tree (gunbc.host_state_root HostStateTree: host_state_tree() in production,
// isolated_host_state_tree(dir) in a wet witness) plus the two member declarations below, never from a literal.
//
// THE TWO DECLARATIONS. The store lives one directory below a namespace directory the substrate also owns
// (gunbc.fabric.fabric_allocation_store_substrate creates both, owner-only and root-owned), so each has its
// own member: the namespace under the host-state tree root, the store under the namespace. The store
// (fabric_allocation_store), the substrate's provisioning spec and every reader of the path derive from
// these two rows, so deleting one removes them all.
type FabricAllocationStoreDeclaration { member: NonEmptyStr, mode: DeclaredDirectoryMode }

data fabric_allocation_namespace_slots: FabricAllocationStoreDeclaration = FabricAllocationStoreDeclaration {
  member: "fabric" as NonEmptyStr,
  mode: DirectoryOwnerOnly,
}

data fabric_allocation_store_slots: FabricAllocationStoreDeclaration = FabricAllocationStoreDeclaration {
  member: "allocation" as NonEmptyStr,
  mode: DirectoryOwnerOnly,
}

fn fabric_allocation_namespace_path(tree: HostStateTree) -> NonEmptyStr {
  join([host_state_tree_path(tree: tree) as String, "/", fabric_allocation_namespace_slots.member as String], "") as NonEmptyStr
}

fn fabric_allocation_store_path(tree: HostStateTree) -> NonEmptyStr {
  join([fabric_allocation_namespace_path(tree: tree) as String, "/", fabric_allocation_store_slots.member as String], "") as NonEmptyStr
}

// THE ALLOCATION STORE, A SEALED VALUE MINTED FROM ITS DECLARATIONS. FabricAllocationStore is sole_constructor
// and this file builds it in one place, fabric_allocation_store, which takes the host-state tree and NOTHING
// ELSE: the root is derived here, the directory is listed, and only a listed directory yields a store. It holds
// DATA -- the derived root -- and the store's operations are the functions below that take it: the hold
// operations (gunbc.durable_exclusive_hold_file_store) its brokers use, the raw slot observation and commit its
// two readers below the hold vocabulary use, and the root-custody read the commissioning admission requires of the
// directory itself. No function anywhere takes a path and answers an allocation store. Non-generic and never a
// variant arm (test.claim.sole_constructor_completeness_audit_probe f13).
//
// WHAT IS SEALED IS CONSTRUCTION: a forged store, or one around a root the declarations did not derive, does not
// compile. Field reads are not sealed, so a holder can read store.root -- and the reservation plan does, on
// purpose: it persists which store it was prepared against (gunbc.workspace_reservation_record
// WorkspaceReservationPlan.root) and refuses to apply against another, so the persisted bytes stay what they were.
// That read, and any module calling the hold library over a path of its own, is the declared residual
// gunbc.recurring_failure_mode a_slot_store_is_built_over_a_literal_path_by_any_module.
type FabricAllocationStore sole_constructor {
  root: NonEmptyStr
}

type FabricAllocationStoreReading
  = FabricAllocationStoreReady { store: FabricAllocationStore }
  | FabricAllocationStoreUnready { detail: NonEmptyStr }

fn fabric_allocation_store(tree: HostStateTree) -> FabricAllocationStoreReading {
  let root = fabric_allocation_store_path(tree: tree)
  let listing = Filesystem.List(path: root as String)
  match filesystem_listing_observation(directory: root as String, success: listing.success, entries: listing.entries, error: listing.error) {
    FilesystemDirectorySubjectRefused { directory: _, cause: c } => FabricAllocationStoreUnready { detail: join(["the allocation store's directory is not admissible: ", c], "") as NonEmptyStr }
    FilesystemDirectoryListingRefused { directory: _, error: e } => FabricAllocationStoreUnready { detail: join(["the allocation store's directory could not be listed: ", e], "") as NonEmptyStr }
    FilesystemDirectoryListed(_) => FabricAllocationStoreReady { store: FabricAllocationStore { root: root } }
  }
}

// ── THE STORE'S OPERATIONS, each over the record's root ────────────────────────────────────────────

fn fabric_allocation_observe_hold(store: FabricAllocationStore, key: NonEmptyStr) -> DurableHoldObservation {
  observe_file_hold(root: store.root, key: key)
}

fn fabric_allocation_acquire_hold(store: FabricAllocationStore, key: NonEmptyStr, owner: DurableHoldOwnerRef) -> FileHoldAcquireOutcome {
  file_hold_acquire(root: store.root, slot_key: key, requested_owner: owner)
}

fn fabric_allocation_prepare_acquire(store: FabricAllocationStore, key: NonEmptyStr, owner: DurableHoldOwnerRef) -> FileHoldAcquirePreparation {
  file_hold_acquire_prepare(root: store.root, slot_key: key, requested_owner: owner)
}

// A plan carries the root it was prepared over (gunbc.durable_exclusive_hold_file_store FileHoldAcquirePlan, sole
// constructor); the store is taken so a business module commits through this module rather than the hold library.
fn fabric_allocation_commit_acquire(store: FabricAllocationStore, plan: FileHoldAcquirePlan) -> FileHoldAcquireOutcome {
  file_hold_acquire_commit(plan: plan)
}

fn fabric_allocation_assess_release(store: FabricAllocationStore, key: NonEmptyStr, owner: DurableHoldOwnerRef, generation: CasGeneration, released_by: DurableHoldReleaseRef) -> FileHoldReleaseAssessment {
  file_hold_release_assess(root: store.root, slot_key: key, owner: owner, acquired_generation: generation, released_by: released_by)
}

fn fabric_allocation_commit_release(store: FabricAllocationStore, plan: FileHoldReleasePlan) -> FileHoldReleaseOutcome {
  file_hold_release_commit(plan: plan)
}

fn fabric_allocation_observe_slot(store: FabricAllocationStore, key: NonEmptyStr) -> CasSlotObservation<NonEmptyStr> {
  observe_cas_slot_state(root: store.root, key: key)
}

fn fabric_allocation_commit_slot(store: FabricAllocationStore, publication: CasGenerationPublication, verified: VerifiedCasAttempt) -> CasOutcome<NonEmptyStr> {
  file_compare_and_set(root: store.root, publication: publication, verified: verified)
}

fn fabric_allocation_custody(store: FabricAllocationStore) -> StoreOwnershipReading {
  read_store_ownership(path: store.root as String)
}
