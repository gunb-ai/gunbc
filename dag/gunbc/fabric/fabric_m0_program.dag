module gunbc.fabric_m0_program

import std.types { List, NonEmptyStr }
import gunbc.fabric_ci_program { FabricCiGate }

// The fabric-M0 storage program, as gate PREDICATES. Like gunbc.fabric_ci_program there is no
// status field, and for the same reason: a gate acquires standing only from an executed receipt,
// and no such receipt join exists for M0 yet. A model, a source review and an executed receipt are
// three different standings, so a Done field here would let the first quietly read as the third.
//
// FabricCiGate is IMPORTED rather than re-declared. M0 is a separate program from FCI-0..FCI-6 --
// it must integrate with the selected runner without absorbing the required-check migration -- but
// "a gate" is one concept, and minting FabricM0Gate beside it would be the fork the fabric
// authority census already recorded nine times in this layer.
//
// WHAT THIS ROSTER IS NOT: it is not a schedule, and the day windows from the dispatch brief are
// deliberately absent. A dated allocation that assumes named owners and granted origin access is a
// proposal about people, not a predicate about the system, and rows here are read as the latter.

fn fabric_m0_gates() -> List<FabricCiGate> {
  [
    FabricCiGate {
      id: "F0",
      owned_question: "What must be true before a job may be called successful, and who decides?",
      exit_predicate: "One success authority derives required artifact and receipt obligations independently of what the producer returned; withholding either prevents success; an unreadable declaration is not an empty one; a failed computation stays failed though every receipt commits.",
      positive_control: "A complete attempt whose declared obligations are all committed and read back publishes success.",
      discriminating_mutations: ["withheld-required-artifact", "withheld-required-receipt", "unreadable-obligation-declaration", "readback-digest-mismatch", "foreign-attempt-evidence", "manifest-attempt-mismatch", "storage-success-inverting-failed-build"],
      frozen_output_identities: ["attempt-identity", "required-artifact-roster", "required-receipt-roster", "commit-manifest-digest"],
      non_goals: ["origin-procurement", "cache-implementation", "peer-fetch", "required-check-cutover"],
    },
    FabricCiGate {
      id: "F1",
      owned_question: "Which one durable origin holds committed results, and what may each principal actually do to it?",
      exit_predicate: "One selected account, bucket, endpoint and storage class with cited dated tariff facts, a versioned namespace, installed least-privilege grants and bounded credentials; an enrolled host performs intended operations while forbidden ones refuse, and read-denied is distinguishable from object-absent.",
      positive_control: "An enrolled host creates, reads and lists within its exact scope.",
      discriminating_mutations: ["foreign-scope-access", "unauthorized-delete", "expired-credential", "read-denied-reported-as-absent"],
      frozen_output_identities: ["origin-account", "bucket-and-prefix", "namespace-version", "grant-roster"],
      non_goals: ["multi-provider-abstraction", "mesh-replication", "cache-affinity-scheduling"],
    },
    FabricCiGate {
      id: "F2",
      owned_question: "What makes a set of bytes durably committed rather than merely uploaded?",
      exit_predicate: "Verified blob and receipt publication with a canonical manifest and one immutable attempt-bound commit identity published only after its dependencies are accepted; an independent reader reconstructs the commit without consulting the producer's cache; a lost acknowledgement stays undetermined until readback reconciles the exact intended object.",
      positive_control: "One attempt commits its complete required population and an independent reader confirms it.",
      discriminating_mutations: ["wrong-digest", "truncated-blob", "missing-referenced-object", "incomplete-required-population", "wrong-attempt", "conflicting-publication", "retry-overwrites-conflicting-result"],
      frozen_output_identities: ["commit-identity", "manifest-digest", "required-receipt-population-frozen-before-finalization"],
      non_goals: ["cache-fill", "eviction-tuning"],
    },
    FabricCiGate {
      id: "F3",
      owned_question: "Which code path can publish a green job, and what evidence must it consume first?",
      exit_predicate: "No published success precedes the required durable commit, on interruption and cancellation paths as well as the ordinary one; receipts are collected outside the guest before teardown; a killed finalizer cannot leave a falsely successful job; commit retry is distinguished from a new execution attempt.",
      positive_control: "One job reaches published success only after its required population is committed and read back.",
      discriminating_mutations: ["green-before-commit", "finalizer-killed", "guest-teardown-destroys-sole-receipt-copy", "commit-failure-reported-as-compiler-failure", "retry-counted-as-new-attempt"],
      frozen_output_identities: ["success-signal-authority", "finalization-outcome", "attempt-identity"],
      non_goals: ["required-check-cutover", "shadow-job-ownership"],
    },
    FabricCiGate {
      id: "F4",
      owned_question: "What may a node serve from local storage without weakening any committed result?",
      exit_predicate: "Cryptographic content addressing with private temporary fills verified before atomic publication, immutable serving with no writable guest alias, bounded capacity with explicit eviction or admission refusal, misses served only from origin, and deleting all cache state destroys no committed output or receipt.",
      positive_control: "A warm node serves a verified hit for a previously committed object.",
      discriminating_mutations: ["interrupted-fill-served-as-hit", "corrupted-byte-served-as-hit", "oversized-object-destroys-unrelated-entries", "peer-fetch", "cache-exhaustion-conflated-with-origin-failure"],
      frozen_output_identities: ["cache-key", "blob-digest", "capacity-policy"],
      non_goals: ["peer-mesh", "advanced-eviction-tuning", "blanket-bit-rot-guarantee"],
    },
    FabricCiGate {
      id: "F5",
      owned_question: "Does a real enrolled workload consume the cache, and what did it actually cost?",
      exit_predicate: "One actual enrolled CI consumer requests and consumes cached objects under named input, toolchain and platform identity rules; pinned cold and warm runs produce the same required outputs; per-attempt per-layer receipts separate logical lookup outcome from physical origin traffic, and uninstrumented layers are recorded rather than read as zero.",
      positive_control: "A pinned workload runs cold then warm through the intended consumer with identical required output identities.",
      discriminating_mutations: ["unused-cas-service", "key-omits-correctness-relevant-input", "missing-telemetry-read-as-zero-usage", "object-hit-rate-reported-as-byte-hit-rate"],
      frozen_output_identities: ["cached-population", "cache-key-inputs", "per-layer-receipt-schema"],
      non_goals: ["hit-rate-floor", "speedup-promise", "node-local-cache-drive-sizing"],
    },
    FabricCiGate {
      id: "F6",
      owned_question: "Does every required M0 property hold on the whole enrolled population, by execution?",
      exit_predicate: "Every required property carries a runnable command, implementation identity, actual environment and persisted evidence over the declared enrolled population; a fresh node reconstructs committed results from origin with peer access disabled; every enrolled node is verified or explicitly excluded by an authorized scope decision.",
      positive_control: "The full enrolled population passes the live fault matrix with correct semantic outcomes, not merely a passing count.",
      discriminating_mutations: ["source-only-finding-promoted-to-executed-standing", "convenient-subset-redefines-population", "passing-count-without-semantic-outcome"],
      frozen_output_identities: ["enrolled-node-population", "enrolled-workload-population", "closure-evidence-roster"],
      non_goals: ["dogfood-window-completion", "multi-tenant-isolation-review", "unrelated-customer-workloads"],
    },
  ]
}
