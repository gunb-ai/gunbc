module gunbc.fabric_event_log_host

import std.types { String, NonEmptyStr, FilePath, EpochSecs }
import std.algebra { trim }
import extdeps.clock { Clock }
import product.placement_supply { HostIdentity }
import gunbc.roadmap_dashboard_instance { HostDashboardInstance, DashboardInstanceByHost, DashboardInstanceForHost, DashboardInstanceHostUnknown, dashboard_instance_for_host, dashboard_instance_event_log_root }
import gunbc.fabric_event_log { fabric_event_log_placement, event_log_remote_for, EventLogLayout, event_log_layout, fabric_event_log_event_refs_backfill_over }
import v2.std.optional { Present }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.resources { Network }
import gunbc.spark.fabric_reach { ExecutorReachKnown, ExecutorReachUnknown, observe_executor_reach }

// WHERE THE EVENT LOG IS FROM THE EXECUTING HOST'S POINT OF VIEW: the dashboard instance declared
// for the host supplies the executor's root (the mirror lives under it) and the identity the
// remote is derived against. Shared by every consumer that transacts on the log from a host --
// the harness's seats, the belt's quotas -- so the layout is derived once.

type HostEventLogLayout
  = HostLayoutResolved { layout: EventLogLayout, executor: HostIdentity }
  | HostLayoutRefused { detail: String }

fn event_log_layout_for_host(short_hostname: String) -> HostEventLogLayout {
  match dashboard_instance_for_host(host: trim(s: short_hostname)) {
    DashboardInstanceHostUnknown { host: h } => HostLayoutRefused { detail: join(["no dashboard instance is declared for host ", h], "") }
    DashboardInstanceForHost { instance: i } =>
      HostLayoutResolved {
        layout: event_log_layout(root: dashboard_instance_event_log_root(instance: i), remote: event_log_remote_for(placement: fabric_event_log_placement, executor: (i.host_identity as String) as HostIdentity)),
        executor: (i.host_identity as String) as HostIdentity,
      }
  }
}

// The instant a transaction speaks at, read from the executing host's clock as epoch seconds.
fn now_epoch_seconds() -> EpochSecs? {
  match parse_int(s: trim(s: Clock.UnixSecs().unix_secs)) {
    Present { value: n } => if n < 0 { none } else { Present { value: n } }
    Absent => none
  }
}

// THE OPERATOR'S DOOR FOR THE EVENT-REF BACKFILL, on the placed host (gunbc.fabric_event_log
// fabric_event_log_event_refs_backfill_over is the transaction; this resolves the executor's
// layout and refuses off the placed host through the layout's remote kind):
//   gunbc run --source-root dag --source-root src/v2 --entry dag/gunbc/fabric/fabric_event_log_host.dag \
//     --function fabric_event_log_event_refs_backfill_wet
fn fabric_event_log_event_refs_backfill_wet() -> ProcessExit
  uses net: Network
{
  match observe_executor_reach() {
    ExecutorReachUnknown { cause: c } => exit_failure(reason: join(["fabric event log backfill: ", c], ""))
    ExecutorReachKnown { short_hostname: executor, path: _ } =>
      match event_log_layout_for_host(short_hostname: executor) {
        HostLayoutRefused { detail: d } => exit_failure(reason: join(["fabric event log backfill: ", d], ""))
        HostLayoutResolved { layout: layout, executor: _ } => fabric_event_log_event_refs_backfill_over(layout: layout)
      }
  }
}
