module gunbc.fabric_event_log_host

import std.types { String, NonEmptyStr, FilePath, EpochSecs }
import std.algebra { trim }
import extdeps.clock { Clock }
import product.placement_supply { HostIdentity }
import gunbc.roadmap_dashboard_instance { HostDashboardInstance, DashboardInstanceByHost, DashboardInstanceForHost, DashboardInstanceHostUnknown, dashboard_instance_for_host }
import gunbc.fabric_event_log { event_log_binding_for }
import gunbc.fabric_db_client { FabricDbBinding }
import v2.std.optional { Present }

// WHERE THE EVENT LOG IS FROM THE EXECUTING HOST'S POINT OF VIEW: the dashboard instance declared
// for the host supplies the identity the fabric DB binding is derived against -- in process on the
// placed host, the served endpoint anywhere else. The executor keeps no copy of the log, so no
// executor root is involved. Shared by every consumer that transacts on the log from a host -- the
// harness's seats, the belt's quotas -- so the binding is derived once.

type HostEventLogStore
  = HostStoreResolved { store: FabricDbBinding, executor: HostIdentity }
  | HostStoreRefused { detail: String }

fn event_log_store_for_host(short_hostname: String) -> HostEventLogStore {
  match dashboard_instance_for_host(host: trim(s: short_hostname)) {
    DashboardInstanceHostUnknown { host: h } => HostStoreRefused { detail: join(["no dashboard instance is declared for host ", h], "") }
    DashboardInstanceForHost { instance: i } =>
      HostStoreResolved {
        store: event_log_binding_for(executor: (i.host_identity as String) as HostIdentity),
        executor: (i.host_identity as String) as HostIdentity,
      }
  }
}

// The instant a transaction speaks at, read from the executing host's clock as epoch seconds.
fn now_epoch_seconds() -> EpochSecs? {
  match parse_int(s: trim(s: Clock.UnixSecs().unix_secs)) {
    Present { value: n } => if n < 0 { none } else { Present { value: n } }
    Absent => none
  }
}
