module gunbc.ci_floor_population_receipt_registry

import std.types { Bool, NonEmptyStr, String }
import std.nat { Nat }

type CiEvidenceSubject {
  github_run_id: Nat?,
  github_run_attempt: Nat?,
  github_job_id: Nat?,
  head_commit: NonEmptyStr?,
  tested_tree: NonEmptyStr?,
  walk_attempt_id: NonEmptyStr?,
  artifact_digest: NonEmptyStr?,
}

type FloorPopulationReceiptKind
  = PhaseJournal {}
  | BatchWall {}
  | CompileCleanWall {}
  | Component {}
  | Resolve {}
  | SelectionDegradation {}
  | Materialization {}
  | OnSuccessMaterialization {}
  | PopulationBudgetRefusal {}
  | NativeTransition {}
  | GateWarmCost {}
  | WitnessRowCost {}
  | WetWitnessRowOutcome {}
  | WitnessRowCostDrift {}
  | CompileCleanCostDrift {}
  | CompileCleanCost {}
  | ScopedWitnessExecution {}
  | WorkerObservation {}
  | WorkerTerminal {}
  | AttemptDirectory {}
  | PopulationReceiptManifest {}

type FloorPopulationReceiptProducerPhase
  = BeforeFloor {}
  | DuringFloor {}
  | OnSuccessStage {}
  | AfterFloorAlways {}
  | OptionalWorker {}

type FloorPopulationReceiptRegistryRow {
  kind: FloorPopulationReceiptKind,
  path: NonEmptyStr,
  producer_phase: FloorPopulationReceiptProducerPhase,
  required_for_settlement: Bool,
}

type ManifestObservationStanding
  = ObservedPresent { size_bytes: Nat, content_digest: NonEmptyStr? }
  | ObservedMissing { producer_phase_reached: Bool }
  | NotApplicable { reason: NonEmptyStr }

type FloorPopulationReceiptManifestRow {
  subject: CiEvidenceSubject,
  kind: FloorPopulationReceiptKind,
  expected_path: NonEmptyStr,
  standing: ManifestObservationStanding,
  producer_phase: FloorPopulationReceiptProducerPhase,
}

data ci_floor_population_receipt_manifest_path: String = "target/floor-population-receipt-manifest.tsv"

data ci_floor_population_receipt_registry_note: String = "Exact path registry for CI-floor population persistence (operator review on #7785): one modeled roster, not a multiline literal nickname. required_for_settlement marks the subset that admission/native/attribution folds consume; the full roster is uploaded so red-path evidence is durable. Manifest path is always written after the floor (AfterFloorAlways) so if-no-files-found: error is sound — the manifest itself is the guaranteed file. Dissolve-on: a harvester emits CiFloorPopulationEvidence from artifact bytes and this registry becomes the path authority for that fold."

fn ci_floor_population_receipt_registry() -> List<FloorPopulationReceiptRegistryRow> {
  [
    FloorPopulationReceiptRegistryRow {
      kind: PopulationReceiptManifest {},
      path: "target/floor-population-receipt-manifest.tsv" as NonEmptyStr,
      producer_phase: AfterFloorAlways {},
      required_for_settlement: true
    },
    FloorPopulationReceiptRegistryRow {
      kind: PhaseJournal {},
      path: "target/floor-phase-journal.tsv" as NonEmptyStr,
      producer_phase: DuringFloor {},
      required_for_settlement: true
    },
    FloorPopulationReceiptRegistryRow {
      kind: BatchWall {},
      path: "target/floor-batch-wall-receipt.txt" as NonEmptyStr,
      producer_phase: DuringFloor {},
      required_for_settlement: true
    },
    FloorPopulationReceiptRegistryRow {
      kind: CompileCleanWall {},
      path: "target/floor-compile-clean-wall-receipt.txt" as NonEmptyStr,
      producer_phase: DuringFloor {},
      required_for_settlement: true
    },
    FloorPopulationReceiptRegistryRow {
      kind: Component {},
      path: "target/floor-component-receipt.json" as NonEmptyStr,
      producer_phase: DuringFloor {},
      required_for_settlement: true
    },
    FloorPopulationReceiptRegistryRow {
      kind: Resolve {},
      path: "target/floor-resolve-receipt.txt" as NonEmptyStr,
      producer_phase: DuringFloor {},
      required_for_settlement: false
    },
    FloorPopulationReceiptRegistryRow {
      kind: SelectionDegradation {},
      path: "target/floor-selection-degradation-receipt.txt" as NonEmptyStr,
      producer_phase: DuringFloor {},
      required_for_settlement: false
    },
    FloorPopulationReceiptRegistryRow {
      kind: Materialization {},
      path: "target/floor-materialization-receipt.txt" as NonEmptyStr,
      producer_phase: DuringFloor {},
      required_for_settlement: false
    },
    FloorPopulationReceiptRegistryRow {
      kind: PopulationBudgetRefusal {},
      path: "target/floor-population-budget-refusal.txt" as NonEmptyStr,
      producer_phase: DuringFloor {},
      required_for_settlement: false
    },
    FloorPopulationReceiptRegistryRow {
      kind: NativeTransition {},
      path: "target/native-selected-witness-transition-receipt.tsv" as NonEmptyStr,
      producer_phase: DuringFloor {},
      required_for_settlement: true
    },
    FloorPopulationReceiptRegistryRow {
      kind: GateWarmCost {},
      path: "target/floor-gate-warm-cost-receipt.tsv" as NonEmptyStr,
      producer_phase: DuringFloor {},
      required_for_settlement: false
    },
    FloorPopulationReceiptRegistryRow {
      kind: WitnessRowCost {},
      path: "target/floor-witness-row-cost-receipt.tsv" as NonEmptyStr,
      producer_phase: DuringFloor {},
      required_for_settlement: false
    },
    FloorPopulationReceiptRegistryRow {
      kind: WetWitnessRowOutcome {},
      path: "target/floor-wet-witness-row-outcome-receipt.tsv" as NonEmptyStr,
      producer_phase: DuringFloor {},
      required_for_settlement: false
    },
    FloorPopulationReceiptRegistryRow {
      kind: WitnessRowCostDrift {},
      path: "target/floor-witness-row-cost-drift-receipt.tsv" as NonEmptyStr,
      producer_phase: DuringFloor {},
      required_for_settlement: false
    },
    FloorPopulationReceiptRegistryRow {
      kind: CompileCleanCostDrift {},
      path: "target/floor-compile-clean-cost-drift-receipt.tsv" as NonEmptyStr,
      producer_phase: DuringFloor {},
      required_for_settlement: false
    },
    FloorPopulationReceiptRegistryRow {
      kind: CompileCleanCost {},
      path: "target/floor-compile-clean-cost-receipt.tsv" as NonEmptyStr,
      producer_phase: DuringFloor {},
      required_for_settlement: false
    },
    FloorPopulationReceiptRegistryRow {
      kind: ScopedWitnessExecution {},
      path: "target/scoped-witness-execution-receipt.tsv" as NonEmptyStr,
      producer_phase: DuringFloor {},
      required_for_settlement: false
    },
    FloorPopulationReceiptRegistryRow {
      kind: WorkerObservation {},
      path: "target/floor-worker-observation-receipt.tsv" as NonEmptyStr,
      producer_phase: OptionalWorker {},
      required_for_settlement: false
    },
    FloorPopulationReceiptRegistryRow {
      kind: WorkerTerminal {},
      path: "target/floor-worker-terminal-*.tsv" as NonEmptyStr,
      producer_phase: OptionalWorker {},
      required_for_settlement: false
    },
    FloorPopulationReceiptRegistryRow {
      kind: AttemptDirectory {},
      path: "target/floor-attempt-*/" as NonEmptyStr,
      producer_phase: OnSuccessStage {},
      required_for_settlement: true
    },
  ]
}

fn ci_floor_population_receipt_registry_paths() -> List<String> {
  ci_floor_population_receipt_registry() |> map(r => r.path as String)
}

fn ci_floor_population_receipts_upload_paths() -> String {
  ci_floor_population_receipt_registry_paths() |> join(separator: "\n")
}

fn ci_floor_population_receipt_registry_row_count() -> Nat {
  length(xs: ci_floor_population_receipt_registry())
}

fn ci_floor_population_receipt_registry_includes_manifest() -> Bool {
  ci_floor_population_receipt_registry()
    |> any(r => match r.kind {
      PopulationReceiptManifest {} => true
      _ => false
    })
}

fn ci_floor_population_receipt_registry_includes_gate_warm_cost() -> Bool {
  ci_floor_population_receipt_registry()
    |> any(r => match r.kind {
      GateWarmCost {} => true
      _ => false
    })
}

fn ci_evidence_subject_incomplete() -> CiEvidenceSubject {
  CiEvidenceSubject {
    github_run_id: none,
    github_run_attempt: none,
    github_job_id: none,
    head_commit: none,
    tested_tree: none,
    walk_attempt_id: none,
    artifact_digest: none,
  }
}

fn ci_evidence_subject_fields_present(s: CiEvidenceSubject) -> Bool {
  match s.github_run_id {
    Absent => false
    Present { value: _ } => match s.github_run_attempt {
      Absent => false
      Present { value: _ } => match s.github_job_id {
        Absent => false
        Present { value: _ } => match s.head_commit {
          Absent => false
          Present { value: _ } => match s.tested_tree {
            Absent => false
            Present { value: _ } => match s.walk_attempt_id {
              Absent => false
              Present { value: _ } => match s.artifact_digest {
                Absent => false
                Present { value: _ } => true
              }
            }
          }
        }
      }
    }
  }
}
