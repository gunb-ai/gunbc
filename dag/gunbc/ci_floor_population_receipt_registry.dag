module gunbc.ci_floor_population_receipt_registry

import std.types { Bool, NonEmptyStr, String }
import std.nat { Nat }
import std.content_hash { Sha256Digest, sha256_hex_digest }
import extdeps.git.object_store { GitObjectId, git_object_id_from_untagged_hex }
import gunbc.merge_admission_subject { WalkAttemptId, walk_attempt_id }

type CiEvidenceSubjectWire {
  github_run_id: String?,
  github_run_attempt: String?,
  github_job_key: String?,
  head_commit: String?,
  tested_tree: String?,
  walk_attempt_id: String?,
  artifact_digest: String?,
}

type CiEvidenceSubject {
  github_run_id: NonEmptyStr,
  github_run_attempt: NonEmptyStr,
  github_job_key: NonEmptyStr,
  head_commit: GitObjectId,
  tested_tree: GitObjectId,
  walk_attempt_id: WalkAttemptId,
  artifact_digest: Sha256Digest,
}

type FloorPopulationReceiptKind
  = PhaseJournal {}
  | BatchWall {}
  | CompileCleanWall {}
  | Component {}
  | Resolve {}
  | SelectionDegradation {}
  | Materialization {}
  | OnSuccessMaterialization {}
  | PopulationBudgetRefusal {}
  | NativeTransition {}
  | GateWarmCost {}
  | WitnessRowCost {}
  | WetWitnessRowOutcome {}
  | WitnessRowCostDrift {}
  | CompileCleanCostDrift {}
  | CompileCleanCost {}
  | ScopedWitnessExecution {}
  | WorkerObservation {}
  | WorkerTerminal {}
  | AttemptDirectory {}
  | PopulationReceiptManifest {}

type FloorPopulationReceiptProducerPhase
  = BeforeFloor {}
  | DuringFloor {}
  | OnSuccessStage {}
  | AfterFloorAlways {}
  | OptionalWorker {}

type ProducerPhaseStanding
  = PhaseReached {}
  | PhaseNotReached {}
  | PhaseStandingUnknown {}

type FloorPopulationReceiptRegistryRow {
  kind: FloorPopulationReceiptKind,
  path: NonEmptyStr,
  producer_phase: FloorPopulationReceiptProducerPhase,
  required_for_settlement: Bool,
}

type ManifestObservationStanding
  = ObservedPresent { size_bytes: Nat, content_digest: NonEmptyStr? }
  | ObservedMissing {}
  | NotApplicable { reason: NonEmptyStr }

type FloorPopulationReceiptManifestRow {
  subject: CiEvidenceSubject,
  kind: FloorPopulationReceiptKind,
  expected_pattern: NonEmptyStr,
  observed_path: NonEmptyStr?,
  standing: ManifestObservationStanding,
  producer_phase: FloorPopulationReceiptProducerPhase,
  producer_phase_standing: ProducerPhaseStanding,
}

type RegistryWellFormedVerdict
  = RegistryWellFormed { row_count: Nat }
  | DuplicateKind { kind_label: NonEmptyStr }
  | DuplicatePath { path: NonEmptyStr }
  | MissingRequiredKind { kind_label: NonEmptyStr }
  | UnknownObservedPath { path: NonEmptyStr }

data ci_floor_population_receipt_manifest_path: String = "target/floor-population-receipt-manifest.tsv"

data ci_floor_population_receipt_manifest_schema: String = "gunbc.ci_floor_population_receipt_manifest.v2"

data ci_floor_population_receipt_registry_note: String = "Exact path registry for CI-floor population persistence (operator review on #7785 commit 3): one modeled roster, not a multiline literal nickname. required_for_settlement marks the subset that admission/native/attribution folds consume; the full roster is uploaded so red-path evidence is durable. Manifest v2 emits a subject header plus one row per concrete file (wildcard expansion; attempt directories enumerate contained receipts). CiEvidenceSubjectWire carries raw optional fields; CiEvidenceSubject is valid-by-construction (GitObjectId / WalkAttemptId / Sha256Digest). Dissolve-on: harvester emits CiFloorPopulationEvidence from artifact bytes + Actions step metadata and this registry becomes the path authority for that fold."

fn floor_population_receipt_kind_label(kind: FloorPopulationReceiptKind) -> String {
  match kind {
    PhaseJournal {} => "PhaseJournal"
    BatchWall {} => "BatchWall"
    CompileCleanWall {} => "CompileCleanWall"
    Component {} => "Component"
    Resolve {} => "Resolve"
    SelectionDegradation {} => "SelectionDegradation"
    Materialization {} => "Materialization"
    OnSuccessMaterialization {} => "OnSuccessMaterialization"
    PopulationBudgetRefusal {} => "PopulationBudgetRefusal"
    NativeTransition {} => "NativeTransition"
    GateWarmCost {} => "GateWarmCost"
    WitnessRowCost {} => "WitnessRowCost"
    WetWitnessRowOutcome {} => "WetWitnessRowOutcome"
    WitnessRowCostDrift {} => "WitnessRowCostDrift"
    CompileCleanCostDrift {} => "CompileCleanCostDrift"
    CompileCleanCost {} => "CompileCleanCost"
    ScopedWitnessExecution {} => "ScopedWitnessExecution"
    WorkerObservation {} => "WorkerObservation"
    WorkerTerminal {} => "WorkerTerminal"
    AttemptDirectory {} => "AttemptDirectory"
    PopulationReceiptManifest {} => "PopulationReceiptManifest"
  }
}

fn floor_population_receipt_producer_phase_label(phase: FloorPopulationReceiptProducerPhase) -> String {
  match phase {
    BeforeFloor {} => "BeforeFloor"
    DuringFloor {} => "DuringFloor"
    OnSuccessStage {} => "OnSuccessStage"
    AfterFloorAlways {} => "AfterFloorAlways"
    OptionalWorker {} => "OptionalWorker"
  }
}

fn producer_phase_standing_label(standing: ProducerPhaseStanding) -> String {
  match standing {
    PhaseReached {} => "Reached"
    PhaseNotReached {} => "NotReached"
    PhaseStandingUnknown {} => "Unknown"
  }
}

