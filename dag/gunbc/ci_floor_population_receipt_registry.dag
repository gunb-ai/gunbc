module gunbc.ci_floor_population_receipt_registry

import std.types { Bool, NonEmptyStr, String }
import std.nat { Nat }

type FloorPopulationReceiptKind
  = PhaseJournal {}
  | BatchWall {}
  | CompileCleanWall {}
  | Component {}
  | Resolve {}
  | SelectionDegradation {}
  | Materialization {}
  | OnSuccessMaterialization {}
  | PopulationBudgetRefusal {}
  | NativeTransition {}
  | GateWarmCost {}
  | WitnessRowCost {}
  | WetWitnessRowOutcome {}
  | WitnessRowCostDrift {}
  | CompileCleanCostDrift {}
  | CompileCleanCost {}
  | ScopedWitnessExecution {}
  | WorkerObservation {}
  | WorkerTerminal {}
  | AttemptDirectory {}
  | PopulationReceiptManifest {}

type FloorPopulationReceiptProducerPhase
  = BeforeFloor {}
  | DuringFloor {}
  | OnSuccessStage {}
  | AfterFloorAlways {}
  | OptionalWorker {}

type FloorReceiptLocator
  = ExactReceiptFile { path: NonEmptyStr }
  | ReceiptFamily {
      directory: NonEmptyStr,
      filename_prefix: NonEmptyStr,
      filename_suffix: NonEmptyStr
    }
  | AttemptReceiptDirectory { root_prefix: NonEmptyStr }

type FloorPopulationReceiptRegistryRow {
  kind: FloorPopulationReceiptKind,
  locator: FloorReceiptLocator,
  producer_phase: FloorPopulationReceiptProducerPhase,
  required_for_settlement: Bool,
}

type RegistryWellFormedVerdict
  = RegistryWellFormed { row_count: Nat }
  | DuplicateKind { kind_label: NonEmptyStr }
  | DuplicatePath { path: NonEmptyStr }
  | MissingRequiredKind { kind_label: NonEmptyStr }
  | UnknownObservedPath { path: NonEmptyStr }

data ci_floor_population_receipt_registry_note: String = "Expected receipt identities and producer phases only (operator ruling on #7785): FloorReceiptLocator is the typed coproduct (ExactReceiptFile | ReceiptFamily | AttemptReceiptDirectory) — path spelling no longer decides meaning. Subject/manifest/standing live in gunbc.ci_floor_population_evidence. Dissolve-on: attempt-scoped exact root target/floor-evidence/<walk-attempt>/ retires Family/AttemptDirectory locators."

fn floor_population_receipt_kind_label(kind: FloorPopulationReceiptKind) -> String {
  match kind {
    PhaseJournal {} => "PhaseJournal"
    BatchWall {} => "BatchWall"
    CompileCleanWall {} => "CompileCleanWall"
    Component {} => "Component"
    Resolve {} => "Resolve"
    SelectionDegradation {} => "SelectionDegradation"
    Materialization {} => "Materialization"
    OnSuccessMaterialization {} => "OnSuccessMaterialization"
    PopulationBudgetRefusal {} => "PopulationBudgetRefusal"
    NativeTransition {} => "NativeTransition"
    GateWarmCost {} => "GateWarmCost"
    WitnessRowCost {} => "WitnessRowCost"
    WetWitnessRowOutcome {} => "WetWitnessRowOutcome"
    WitnessRowCostDrift {} => "WitnessRowCostDrift"
    CompileCleanCostDrift {} => "CompileCleanCostDrift"
    CompileCleanCost {} => "CompileCleanCost"
    ScopedWitnessExecution {} => "ScopedWitnessExecution"
    WorkerObservation {} => "WorkerObservation"
    WorkerTerminal {} => "WorkerTerminal"
    AttemptDirectory {} => "AttemptDirectory"
    PopulationReceiptManifest {} => "PopulationReceiptManifest"
  }
}

fn floor_population_receipt_producer_phase_label(phase: FloorPopulationReceiptProducerPhase) -> String {
  match phase {
    BeforeFloor {} => "BeforeFloor"
    DuringFloor {} => "DuringFloor"
    OnSuccessStage {} => "OnSuccessStage"
    AfterFloorAlways {} => "AfterFloorAlways"
    OptionalWorker {} => "OptionalWorker"
  }
}

fn floor_receipt_locator_upload_pattern(locator: FloorReceiptLocator) -> String {
  match locator {
    ExactReceiptFile { path } => path as String
    ReceiptFamily { directory, filename_prefix, filename_suffix } =>
      concat(
        concat(directory as String, "/"),
        concat(concat(filename_prefix as String, "*"), filename_suffix as String)
      )
    AttemptReceiptDirectory { root_prefix } => concat(root_prefix as String, "*/")
  }
}

fn exact(path: String) -> FloorReceiptLocator {
  ExactReceiptFile { path: path as NonEmptyStr }
}

