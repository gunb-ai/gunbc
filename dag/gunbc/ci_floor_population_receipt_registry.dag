fn settlement_required_kind_labels() -> List<String> {
  [
    "PopulationReceiptManifest",
    "PhaseJournal",
    "BatchWall",
    "CompileCleanWall",
    "Component",
    "NativeTransition",
    "AttemptDirectory",
  ]
}

fn ci_floor_population_receipt_registry_paths() -> List<String> {
  ci_floor_population_receipt_registry() |> map(r => r.path as String)
}

fn ci_floor_population_receipt_registry_kind_labels() -> List<String> {
  ci_floor_population_receipt_registry() |> map(r => floor_population_receipt_kind_label(kind: r.kind))
}

fn ci_floor_population_receipts_upload_paths() -> String {
  ci_floor_population_receipt_registry_paths() |> join(separator: "\n")
}

fn ci_floor_population_receipt_registry_row_count() -> Nat {
  length(xs: ci_floor_population_receipt_registry())
}

fn ci_floor_population_receipt_registry_body_tsv() -> String {
  ci_floor_population_receipt_registry()
    |> filter(r => !(floor_population_receipt_kind_label(kind: r.kind) == "PopulationReceiptManifest"))
    |> map(r => concat(
      concat(floor_population_receipt_kind_label(kind: r.kind), "\t"),
      concat(
        concat(r.path as String, "\t"),
        floor_population_receipt_producer_phase_label(phase: r.producer_phase)
      )
    ))
    |> join(separator: "\n")
}

fn string_list_contains_exact(xs: List<String>, needle: String) -> Bool {
  xs |> any(x => x == needle)
}

fn registry_path_matches_pattern(path: String, pattern: String) -> Bool {
  if pattern == "target/floor-worker-terminal-*.tsv" {
    string_contains(s: path, pattern: "target/floor-worker-terminal-")
      && string_contains(s: path, pattern: ".tsv")
      && !(string_contains(s: path, pattern: "*"))
  } else if pattern == "target/floor-attempt-*/" {
    string_contains(s: path, pattern: "target/floor-attempt-")
      && !(string_contains(s: path, pattern: "*"))
  } else {
    path == pattern
  }
}

fn registry_rows_duplicate_kind(rows: List<FloorPopulationReceiptRegistryRow>) -> NonEmptyStr? {
  fold(rows, init: { seen: [] as List<String>, dup: none as NonEmptyStr? }, f: fn(acc, r) {
    let label = floor_population_receipt_kind_label(kind: r.kind)
    if string_list_contains_exact(xs: acc.seen, needle: label) {
      { seen: acc.seen, dup: Present { value: label as NonEmptyStr } }
    } else {
      { seen: concat(acc.seen, [label]), dup: acc.dup }
    }
  }).dup
}

fn registry_rows_duplicate_path(rows: List<FloorPopulationReceiptRegistryRow>) -> NonEmptyStr? {
  fold(rows, init: { seen: [] as List<String>, dup: none as NonEmptyStr? }, f: fn(acc, r) {
    let path = r.path as String
    if string_list_contains_exact(xs: acc.seen, needle: path) {
      { seen: acc.seen, dup: Present { value: r.path } }
    } else {
      { seen: concat(acc.seen, [path]), dup: acc.dup }
    }
  }).dup
}

fn registry_rows_missing_required_kind(rows: List<FloorPopulationReceiptRegistryRow>) -> NonEmptyStr? {
  let labels = rows |> map(r => floor_population_receipt_kind_label(kind: r.kind))
  fold(settlement_required_kind_labels(), init: none as NonEmptyStr?, f: fn(acc, required) {
    match acc {
      Present { value: _ } => acc
      Absent => {
        if string_list_contains_exact(xs: labels, needle: required) {
          none
        } else {
          Present { value: required as NonEmptyStr }
        }
      }
    }
  })
}

fn registry_rows_well_formed(rows: List<FloorPopulationReceiptRegistryRow>) -> RegistryWellFormedVerdict {
  match registry_rows_duplicate_kind(rows: rows) {
    Present { value: kind_label } => DuplicateKind { kind_label: kind_label }
    Absent => match registry_rows_duplicate_path(rows: rows) {
      Present { value: path } => DuplicatePath { path: path }
      Absent => match registry_rows_missing_required_kind(rows: rows) {
        Present { value: kind_label } => MissingRequiredKind { kind_label: kind_label }
        Absent => RegistryWellFormed { row_count: length(xs: rows) }
      }
    }
  }
}

fn ci_floor_population_receipt_registry_well_formed() -> RegistryWellFormedVerdict {
  registry_rows_well_formed(rows: ci_floor_population_receipt_registry())
}

fn observe_path_against_registry(path: NonEmptyStr) -> RegistryWellFormedVerdict {
  let p = path as String
  let matched = ci_floor_population_receipt_registry()
    |> any(r => registry_path_matches_pattern(path: p, pattern: r.path as String))
  if matched {
    RegistryWellFormed { row_count: 1 }
  } else {
    UnknownObservedPath { path: path }
  }
}

fn planted_duplicate_kind_rows() -> List<FloorPopulationReceiptRegistryRow> {
  let row = FloorPopulationReceiptRegistryRow {
    kind: PhaseJournal {},
    path: "target/floor-phase-journal.tsv" as NonEmptyStr,
    producer_phase: DuringFloor {},
    required_for_settlement: true
  }
  let dup = FloorPopulationReceiptRegistryRow {
    kind: PhaseJournal {},
    path: "target/floor-phase-journal-dup.tsv" as NonEmptyStr,
    producer_phase: DuringFloor {},
    required_for_settlement: true
  }
  [row, dup]
}

fn planted_duplicate_path_rows() -> List<FloorPopulationReceiptRegistryRow> {
  let row = FloorPopulationReceiptRegistryRow {
    kind: PhaseJournal {},
    path: "target/floor-phase-journal.tsv" as NonEmptyStr,
    producer_phase: DuringFloor {},
    required_for_settlement: true
  }
  let dup = FloorPopulationReceiptRegistryRow {
    kind: BatchWall {},
    path: "target/floor-phase-journal.tsv" as NonEmptyStr,
    producer_phase: DuringFloor {},
    required_for_settlement: true
  }
  [row, dup]
}

fn nonempty_string_opt(raw: String?) -> NonEmptyStr? {
  match raw {
    Absent => none
    Present { value: s } => {
      if s == "" {
        none
      } else {
        Present { value: s as NonEmptyStr }
      }
    }
  }
}

fn ci_evidence_subject_from_wire(w: CiEvidenceSubjectWire) -> CiEvidenceSubject? {
  match nonempty_string_opt(raw: w.github_run_id) {
    Absent => none
    Present { value: run_id } => match nonempty_string_opt(raw: w.github_run_attempt) {
      Absent => none
      Present { value: run_attempt } => match nonempty_string_opt(raw: w.github_job_key) {
        Absent => none
        Present { value: job_key } => match nonempty_string_opt(raw: w.head_commit) {
          Absent => none
          Present { value: head_raw } => match nonempty_string_opt(raw: w.tested_tree) {
            Absent => none
            Present { value: tree_raw } => match nonempty_string_opt(raw: w.walk_attempt_id) {
              Absent => none
              Present { value: walk_raw } => match nonempty_string_opt(raw: w.artifact_digest) {
                Absent => none
                Present { value: digest_raw } => match git_object_id_from_untagged_hex(hex: head_raw as String) {
                  Absent => none
                  Present { value: head } => match git_object_id_from_untagged_hex(hex: tree_raw as String) {
                    Absent => none
                    Present { value: tree } => match walk_attempt_id(raw: walk_raw as String) {
                      Absent => none
                      Present { value: walk } => match sha256_hex_digest(hex: digest_raw as String) {
                        Absent => none
                        Present { value: digest } => Present {
                          value: CiEvidenceSubject {
                            github_run_id: run_id,
                            github_run_attempt: run_attempt,
                            github_job_key: job_key,
                            head_commit: head,
                            tested_tree: tree,
                            walk_attempt_id: walk,
                            artifact_digest: digest,
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

fn ci_evidence_subject_wire_incomplete() -> CiEvidenceSubjectWire {
  CiEvidenceSubjectWire {
    github_run_id: none,
    github_run_attempt: none,
    github_job_key: none,
    head_commit: none,
    tested_tree: none,
    walk_attempt_id: none,
    artifact_digest: none,
  }
}

fn ci_evidence_subject_wire_fields_present(w: CiEvidenceSubjectWire) -> Bool {
  match ci_evidence_subject_from_wire(w: w) {
    Present { value: _ } => true
    Absent => false
  }
}
