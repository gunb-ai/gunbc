module gunbc.ci_floor_population_receipt_registry

import std.types { Bool, NonEmptyStr, String }
import std.nat { Nat }

type FloorPopulationReceiptKind
  = PhaseJournal {}
  | BatchWall {}
  | CompileCleanWall {}
  | Component {}
  | NativeTransition {}
  | OnSuccessStage1 {}
  | OnSuccessStage2 {}
  | OnSuccessMaterialization {}
  | WorkerObservation {}
  | WorkerTerminal {}
  | PopulationReceiptManifest {}
  | Resolve {}
  | SelectionDegradation {}
  | Materialization {}
  | PopulationBudgetRefusal {}
  | GateWarmCost {}
  | WitnessRowCost {}
  | WetWitnessRowOutcome {}
  | WitnessRowCostDrift {}
  | CompileCleanCostDrift {}
  | CompileCleanCost {}
  | ScopedWitnessExecution {}

type FloorPopulationReceiptProducerPhase
  = BeforeFloor {}
  | DuringFloor {}
  | OnSuccessStage {}
  | AfterFloorAlways {}
  | OptionalWorker {}

type FloorReceiptLocator
  = ExactRelative { relative_path: NonEmptyStr }
  | ReceiptFamily {
      relative_directory: NonEmptyStr,
      filename_prefix: NonEmptyStr,
      filename_suffix: NonEmptyStr
    }

type FloorPopulationReceiptRegistryRow {
  kind: FloorPopulationReceiptKind,
  locator: FloorReceiptLocator,
  producer_phase: FloorPopulationReceiptProducerPhase,
  journal_phase: NonEmptyStr,
  required_for_settlement: Bool,
}

type RegistryWellFormedVerdict
  = RegistryWellFormed { row_count: Nat }
  | DuplicateKind { kind_label: NonEmptyStr }
  | DuplicatePath { path: NonEmptyStr }
  | MissingRequiredKind { kind_label: NonEmptyStr }
  | UnknownObservedPath { path: NonEmptyStr }

data ci_floor_population_receipt_registry_note: String = "Expected receipt identities relative to FloorEvidenceRoot = target/floor-evidence/<WalkAttemptId>/ (operator ruling on #7785). FloorReceiptLocator is ExactRelative or ReceiptFamily under that root — never a global target/floor-* scrape. required_for_settlement marks the subset write_floor_receipt must observe atomically."

fn floor_population_receipt_kind_label(kind: FloorPopulationReceiptKind) -> String {
  match kind {
    PhaseJournal {} => "PhaseJournal"
    BatchWall {} => "BatchWall"
    CompileCleanWall {} => "CompileCleanWall"
    Component {} => "Component"
    NativeTransition {} => "NativeTransition"
    OnSuccessStage1 {} => "OnSuccessStage1"
    OnSuccessStage2 {} => "OnSuccessStage2"
    OnSuccessMaterialization {} => "OnSuccessMaterialization"
    WorkerObservation {} => "WorkerObservation"
    WorkerTerminal {} => "WorkerTerminal"
    PopulationReceiptManifest {} => "PopulationReceiptManifest"
    Resolve {} => "Resolve"
    SelectionDegradation {} => "SelectionDegradation"
    Materialization {} => "Materialization"
    PopulationBudgetRefusal {} => "PopulationBudgetRefusal"
    GateWarmCost {} => "GateWarmCost"
    WitnessRowCost {} => "WitnessRowCost"
    WetWitnessRowOutcome {} => "WetWitnessRowOutcome"
    WitnessRowCostDrift {} => "WitnessRowCostDrift"
    CompileCleanCostDrift {} => "CompileCleanCostDrift"
    CompileCleanCost {} => "CompileCleanCost"
    ScopedWitnessExecution {} => "ScopedWitnessExecution"
  }
}

fn floor_population_receipt_producer_phase_label(phase: FloorPopulationReceiptProducerPhase) -> String {
  match phase {
    BeforeFloor {} => "BeforeFloor"
    DuringFloor {} => "DuringFloor"
    OnSuccessStage {} => "OnSuccessStage"
    AfterFloorAlways {} => "AfterFloorAlways"
    OptionalWorker {} => "OptionalWorker"
  }
}

fn floor_receipt_locator_upload_pattern(locator: FloorReceiptLocator) -> String {
  match locator {
    ExactRelative { relative_path } => relative_path as String
    ReceiptFamily { relative_directory, filename_prefix, filename_suffix } =>
      concat(
        concat(relative_directory as String, "/"),
        concat(concat(filename_prefix as String, "*"), filename_suffix as String)
      )
  }
}

fn exact_rel(path: String) -> FloorReceiptLocator {
  ExactRelative { relative_path: path as NonEmptyStr }
}

fn ci_floor_population_receipt_registry() -> List<FloorPopulationReceiptRegistryRow> {
  [
    FloorPopulationReceiptRegistryRow {
      kind: PopulationReceiptManifest {},
      locator: exact_rel(path: "manifest.tsv"),
      producer_phase: AfterFloorAlways {},
      journal_phase: "AfterFloorAlways" as NonEmptyStr,
      required_for_settlement: true
    },
    FloorPopulationReceiptRegistryRow {
      kind: PhaseJournal {},
      locator: exact_rel(path: "phase-journal.tsv"),
      producer_phase: DuringFloor {},
      journal_phase: "DuringFloor" as NonEmptyStr,
      required_for_settlement: true
    },
    FloorPopulationReceiptRegistryRow {
      kind: BatchWall {},
      locator: exact_rel(path: "receipts/batch-wall.txt"),
      producer_phase: DuringFloor {},
      journal_phase: "batch-wall-receipt" as NonEmptyStr,
      required_for_settlement: true
    },
    FloorPopulationReceiptRegistryRow {
      kind: CompileCleanWall {},
      locator: exact_rel(path: "receipts/compile-clean-wall.txt"),
      producer_phase: DuringFloor {},
      journal_phase: "compile-clean-wall-receipt" as NonEmptyStr,
      required_for_settlement: true
    },
    FloorPopulationReceiptRegistryRow {
      kind: Component {},
      locator: exact_rel(path: "receipts/component.json"),
      producer_phase: DuringFloor {},
      journal_phase: "floor-component-receipt" as NonEmptyStr,
      required_for_settlement: true
    },
    FloorPopulationReceiptRegistryRow {
      kind: NativeTransition {},
      locator: exact_rel(path: "receipts/native-transition.tsv"),
      producer_phase: DuringFloor {},
      journal_phase: "native-transition-receipt" as NonEmptyStr,
      required_for_settlement: true
    },
    FloorPopulationReceiptRegistryRow {
      kind: OnSuccessStage1 {},
      locator: exact_rel(path: "stages/1/receipt.tsv"),
      producer_phase: OnSuccessStage {},
      journal_phase: "on-success-stage-1" as NonEmptyStr,
      required_for_settlement: true
    },
    FloorPopulationReceiptRegistryRow {
      kind: OnSuccessStage2 {},
      locator: exact_rel(path: "stages/2/receipt.tsv"),
      producer_phase: OnSuccessStage {},
      journal_phase: "on-success-stage-2" as NonEmptyStr,
      required_for_settlement: true
    },
    FloorPopulationReceiptRegistryRow {
      kind: OnSuccessMaterialization {},
      locator: exact_rel(path: "receipts/on-success-materialization.txt"),
      producer_phase: OnSuccessStage {},
      journal_phase: "on-success-materialization" as NonEmptyStr,
      required_for_settlement: true
    },
    FloorPopulationReceiptRegistryRow {
      kind: WorkerObservation {},
      locator: exact_rel(path: "workers/observation.tsv"),
      producer_phase: OptionalWorker {},
      journal_phase: "coordinator-observation" as NonEmptyStr,
      required_for_settlement: false
    },
    FloorPopulationReceiptRegistryRow {
      kind: WorkerTerminal {},
      locator: ReceiptFamily {
        relative_directory: "workers" as NonEmptyStr,
        filename_prefix: "terminal-" as NonEmptyStr,
        filename_suffix: ".tsv" as NonEmptyStr
      },
      producer_phase: OptionalWorker {},
      journal_phase: "OptionalWorker" as NonEmptyStr,
      required_for_settlement: false
    },
  ]
}

fn settlement_required_kind_labels() -> List<String> {
  [
    "PopulationReceiptManifest",
    "PhaseJournal",
    "BatchWall",
    "CompileCleanWall",
    "Component",
    "NativeTransition",
    "OnSuccessStage1",
    "OnSuccessStage2",
    "OnSuccessMaterialization",
  ]
}

fn ci_floor_population_receipt_registry_paths() -> List<String> {
  ci_floor_population_receipt_registry()
    |> map(r => floor_receipt_locator_upload_pattern(locator: r.locator))
}

fn ci_floor_population_receipt_registry_kind_labels() -> List<String> {
  ci_floor_population_receipt_registry() |> map(r => floor_population_receipt_kind_label(kind: r.kind))
}

fn ci_floor_population_receipts_upload_paths_for_attempt(attempt_id: String) -> String {
  let root = concat("target/floor-evidence/", attempt_id)
  ci_floor_population_receipt_registry_paths()
    |> map(p => concat(concat(root, "/"), p))
    |> join(separator: "\n")
}

data ci_floor_population_receipts_upload_glob_note: String = "Archival-only (#7785 commit 4A, blocker 1): a target/floor-evidence/* wildcard sweeps in every sibling attempt a reused self-hosted target/ happens to still be carrying, not just the one this walk produced. No production upload step reads this function; it exists for a future hand-run archival/debug pull of every retained attempt root on a runner, never for the always() CI upload."

fn ci_floor_population_receipts_upload_glob() -> String {
  "target/floor-evidence/*"
}

data ci_floor_population_receipts_upload_path_exact_expression_note: String = "The production upload path (#7785 commit 4A, blocker 1): the EXACT FloorEvidenceRoot this walk wrote, read back from the finalize step's own declared output rather than recomposed here from github.* context. References the step id finalize_floor_evidence, which every consumer of this expression must give its --finalize-floor-evidence invocation (ci_floor_population_receipt_manifest_step)."

fn ci_floor_population_receipts_upload_path_exact_expression() -> String {
  "${{ steps.finalize_floor_evidence.outputs.floor_evidence_root }}"
}

fn ci_floor_population_receipts_walk_attempt_exact_expression() -> String {
  "${{ steps.finalize_floor_evidence.outputs.walk_attempt }}"
}

fn ci_floor_population_receipt_registry_row_count() -> Nat {
  length(xs: ci_floor_population_receipt_registry())
}

data ci_floor_population_receipt_registry_fingerprint_pin_note: String = "Cross-language pin (#7785 commit 4A, blocker 3): byte-equal (mod the file's single trailing newline) to the committed dag/gunbc/ci_floor_population_receipt_registry.fingerprint file, which claim_executor_floor_evidence.rs also reads verbatim via include_str! and asserts against its own fingerprint_from_rows(). A .dag registry edit that does not update BOTH this literal and the committed file reds witness_registry_fingerprint_pinned_to_committed_file here and registry_fingerprint_pairs_const on the Rust side, from two independent directions."

data ci_floor_population_receipt_registry_fingerprint_pin: String = "PopulationReceiptManifest|manifest.tsv|AfterFloorAlways|AfterFloorAlways|1\nPhaseJournal|phase-journal.tsv|DuringFloor|DuringFloor|1\nBatchWall|receipts/batch-wall.txt|DuringFloor|batch-wall-receipt|1\nCompileCleanWall|receipts/compile-clean-wall.txt|DuringFloor|compile-clean-wall-receipt|1\nComponent|receipts/component.json|DuringFloor|floor-component-receipt|1\nNativeTransition|receipts/native-transition.tsv|DuringFloor|native-transition-receipt|1\nOnSuccessStage1|stages/1/receipt.tsv|OnSuccessStage|on-success-stage-1|1\nOnSuccessStage2|stages/2/receipt.tsv|OnSuccessStage|on-success-stage-2|1\nOnSuccessMaterialization|receipts/on-success-materialization.txt|OnSuccessStage|on-success-materialization|1\nWorkerObservation|workers/observation.tsv|OptionalWorker|coordinator-observation|0\nWorkerTerminal|workers/terminal-*.tsv|OptionalWorker|OptionalWorker|0"

fn ci_floor_population_receipt_registry_fingerprint() -> String {
  ci_floor_population_receipt_registry()
    |> map(r => concat(
      concat(floor_population_receipt_kind_label(kind: r.kind), "|"),
      concat(
        concat(floor_receipt_locator_upload_pattern(locator: r.locator), "|"),
        concat(
          concat(floor_population_receipt_producer_phase_label(phase: r.producer_phase), "|"),
          concat(
            concat(r.journal_phase as String, "|"),
            if r.required_for_settlement { "1" } else { "0" }
          )
        )
      )
    ))
    |> join(separator: "\n")
}

fn ci_floor_population_receipts_upload_paths() -> String {
  ci_floor_population_receipts_upload_glob()
}

fn string_list_contains_exact(xs: List<String>, needle: String) -> Bool {
  xs |> any(x => x == needle)
}

fn registry_locator_matches_relpath(path: String, locator: FloorReceiptLocator) -> Bool {
  match locator {
    ExactRelative { relative_path } => path == (relative_path as String)
    ReceiptFamily { relative_directory, filename_prefix, filename_suffix } => {
      let dir = concat(relative_directory as String, "/")
      string_contains(s: path, pattern: dir)
        && string_contains(s: path, pattern: filename_prefix as String)
        && string_contains(s: path, pattern: filename_suffix as String)
        && !(string_contains(s: path, pattern: "*"))
    }
  }
}

fn registry_rows_duplicate_kind(rows: List<FloorPopulationReceiptRegistryRow>) -> NonEmptyStr? {
  fold(rows, init: { seen: [], dup: none }, f: fn(acc, r) {
    let label = floor_population_receipt_kind_label(kind: r.kind)
    if string_list_contains_exact(xs: acc.seen, needle: label) {
      { seen: acc.seen, dup: Present { value: label as NonEmptyStr } }
    } else {
      { seen: concat(acc.seen, [label]), dup: acc.dup }
    }
  }).dup
}

fn registry_rows_duplicate_path(rows: List<FloorPopulationReceiptRegistryRow>) -> NonEmptyStr? {
  fold(rows, init: { seen: [], dup: none }, f: fn(acc, r) {
    let path = floor_receipt_locator_upload_pattern(locator: r.locator)
    if string_list_contains_exact(xs: acc.seen, needle: path) {
      { seen: acc.seen, dup: Present { value: path as NonEmptyStr } }
    } else {
      { seen: concat(acc.seen, [path]), dup: acc.dup }
    }
  }).dup
}

fn registry_rows_missing_required_kind(rows: List<FloorPopulationReceiptRegistryRow>) -> NonEmptyStr? {
  let labels = rows |> map(r => floor_population_receipt_kind_label(kind: r.kind))
  fold(settlement_required_kind_labels(), init: none, f: fn(acc, required) {
    match acc {
      Present { value: _ } => acc
      Absent => {
        if string_list_contains_exact(xs: labels, needle: required) {
          none
        } else {
          Present { value: required as NonEmptyStr }
        }
      }
    }
  })
}

fn registry_rows_well_formed(rows: List<FloorPopulationReceiptRegistryRow>) -> RegistryWellFormedVerdict {
  match registry_rows_duplicate_kind(rows: rows) {
    Present { value: kind_label } => DuplicateKind { kind_label: kind_label }
    Absent => match registry_rows_duplicate_path(rows: rows) {
      Present { value: path } => DuplicatePath { path: path }
      Absent => match registry_rows_missing_required_kind(rows: rows) {
        Present { value: kind_label } => MissingRequiredKind { kind_label: kind_label }
        Absent => RegistryWellFormed { row_count: length(xs: rows) }
      }
    }
  }
}

fn ci_floor_population_receipt_registry_well_formed() -> RegistryWellFormedVerdict {
  registry_rows_well_formed(rows: ci_floor_population_receipt_registry())
}

fn observe_path_against_registry(path: NonEmptyStr) -> RegistryWellFormedVerdict {
  let p = path as String
  let matched = ci_floor_population_receipt_registry()
    |> any(r => registry_locator_matches_relpath(path: p, locator: r.locator))
  if matched {
    RegistryWellFormed { row_count: 1 }
  } else {
    UnknownObservedPath { path: path }
  }
}

fn planted_duplicate_kind_rows() -> List<FloorPopulationReceiptRegistryRow> {
  let row = FloorPopulationReceiptRegistryRow {
    kind: PhaseJournal {},
    locator: exact_rel(path: "phase-journal.tsv"),
    producer_phase: DuringFloor {},
    journal_phase: "DuringFloor" as NonEmptyStr,
    required_for_settlement: true
  }
  let dup = FloorPopulationReceiptRegistryRow {
    kind: PhaseJournal {},
    locator: exact_rel(path: "phase-journal-dup.tsv"),
    producer_phase: DuringFloor {},
    journal_phase: "DuringFloor" as NonEmptyStr,
    required_for_settlement: true
  }
  [row, dup]
}

fn planted_duplicate_path_rows() -> List<FloorPopulationReceiptRegistryRow> {
  let row = FloorPopulationReceiptRegistryRow {
    kind: PhaseJournal {},
    locator: exact_rel(path: "phase-journal.tsv"),
    producer_phase: DuringFloor {},
    journal_phase: "DuringFloor" as NonEmptyStr,
    required_for_settlement: true
  }
  let dup = FloorPopulationReceiptRegistryRow {
    kind: BatchWall {},
    locator: exact_rel(path: "phase-journal.tsv"),
    producer_phase: DuringFloor {},
    journal_phase: "batch-wall-receipt" as NonEmptyStr,
    required_for_settlement: true
  }
  [row, dup]
}
