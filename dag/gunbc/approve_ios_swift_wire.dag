  SwiftInfixOperator, SwiftLogicalOrOperator, SwiftLogicalAndOperator, SwiftNilCoalescingOperator, SwiftClosedRangeOperator,
  SwiftHalfOpenRangeOperator, SwiftAddAssignmentOperator, SwiftNotEqualOperator, SwiftNilLiteral,
