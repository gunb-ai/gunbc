module gunbc.auth.approval_broker_cutover

import std.types { NonEmptyStr, String, Int, Bool, List, Port }
import std.measure { ByteSize }
import gunbc.serve_liveness {
  serve_liveness_path,
  ServeLivenessRead, ServeLivenessUnreachable,
  ServeLivenessObserved, ServeLivenessBodyUnparseable, ServeLivenessBodyNotAnObject,
  ServeLivenessRevisionAbsent, ServeLivenessRevisionDuplicated, ServeLivenessRevisionNotAString,
  ServeLivenessRevisionMalformed,
  observe_serve_liveness, serve_liveness_read_reason,
}
import gunbc.auth.approval_broker_endpoint {
  approval_broker_loopback_base_url,
  approval_broker_listen_port, approval_broker_dark_listen_port,
  approval_broker_confirm_path_template, approval_broker_submit_path,
  approval_broker_status_path_template,
  approval_broker_confirm_front_door, approval_broker_status_front_door,
}
import extdeps.tailscale.serve { TailscaleServeEndpoint, tailscale_serve_enable_argv }

// ── MOVING THE APPROVAL LOOP WITHOUT EVER HAVING TWO WRITERS ─────────────────────────────────
// THE HAZARD IS NOT THE MOVE, IT IS THE OVERLAP. The approval store keeps 0600 generations under a
// single-writer discipline: a decision wins by being the one that committed, and "the one" is a
// property of there being one process able to commit. Two implementations serving /approve against
// one store is not a slower or messier cutover, it is a different store -- a request could be
// filed by one process and redeemed by the other, or two redemptions could each believe they won.
//
// AND THE OTHER DIRECTION IS EQUALLY REAL. Removing the routes from the roadmap in the same motion
// that introduces the broker leaves a window in which NOBODY serves them, and an approval link
// already on a phone is a capability that outlives the deployment that issued it. An outage of the
// approval loop is strictly worse than the co-tenancy the split repairs.
//
// So the transition is neither atomic nor free-running: it is a STAGED TRANSACTION whose stages are
// ordered, whose entry conditions are evidence rather than intention, and whose advance is a fold
// that REFUSES with a located cause when the evidence is absent. DESIGN section 6 names a
// hand-authored migration script as out-of-band actuation; this is the authority that plan reads,
// so "which stage are we at and may we advance" is answered from modeled evidence rather than from
// whoever is holding the terminal.
//
// WHAT THIS MODULE IS NOT. It does not actuate. It decides admission, and an operator or a deploy
// plan performs the stage and brings back the observation. That split is deliberate: an advance
// that could both decide and act would be able to report success for an effect nobody observed,
// which is the fabricated-plausible-output arm DESIGN section 5 forbids at exactly this boundary.

// ── WHO THE APPROVAL PATHS ARE ROUTED TO, AS ONE THREE-VALUED FACT ──────────────────────────
// TWO EARLIER CUTS OF THIS ROW WERE BOTH WRONG, IN OPPOSITE DIRECTIONS, AND THE SECOND ERROR IS
// INSTRUCTIVE. First there was no row at all and an ordinary apply could put the broker where the
// front door reaches it while the roadmap still served those paths -- two routed writers, forbidden
// only by prose (review 68050). The repair introduced a two-valued switch and used the broker's
// PORT as the lever: dark while the roadmap still mounted the rows, serving afterwards.
//
// THAT LEVER WAS A PROXY FOR THE WRONG FACT, and review 68075 found what it cost. The front-door
// mounts kept naming the SERVING port, so stage 4 would have repointed /approve and /approvals at
// 127.0.0.1:8085 while the broker was bound to 18085 -- every approval link on a phone dying at
// that instant, the roadmap no longer routed to paths it was still serving, and stage 5's probes
// then refusing forever so the plan could never reach stage 6. A staged transaction that deadlocks
// in its worst state is worse than the atomic cut it was chosen over.
//
// THE REAL QUANTITY HAS THREE VALUES, NOT TWO, and every earlier cut failed by forcing it into two.
// Between repointing the front door and retiring the roadmap's rows there is a legitimate middle
// state -- the broker is routed, the roadmap still HOLDS the rows but nothing reaches them -- and a
// two-valued row cannot express it, so it collapsed either into an outage or into two writers.
//
//   ApprovalPathsRoutedToRoadmap  stages 1-3: the roadmap answers; the broker is deployed on the
//                                 dark port with no front-door mount. Unreachable twice over.
//   ApprovalPathsRoutedToBroker   stages 4-5: the broker answers on the serving port behind the
//                                 two mounts; the roadmap's rows exist and nothing routes to them.
//   ApprovalPathsOwnedByBroker    stage 6+: the roadmap's rows are gone.
//
// EVERY DERIVED FACT READS THIS ONE ROW -- the broker's deploy port, whether the front-door mounts
// are installed, and whether the roadmap projects its four rows -- so they cannot disagree about
// who may write the store, and AT MOST ONE PARTY IS ROUTED AT EVERY VALUE. That is the property the
// port proxy was reaching for, stated over routing, which is what actually decides it.
//
// EACH ADVANCE IS ONE ROW EDIT WITH ITS CONSEQUENCES BOUND TOGETHER: stage 4 moves the broker onto
// the serving port AND installs the mounts pointing at it, in one motion, so the front door can
// never name a port nothing is bound to. Stage 6 deletes the roadmap's rows and changes nothing
// about routing. The plan still refuses each advance until the prior stage is discharged.
type ApprovalRouteOwnership
  = ApprovalPathsRoutedToRoadmap
  | ApprovalPathsRoutedToBroker
  | ApprovalPathsOwnedByBroker

data approval_route_ownership: ApprovalRouteOwnership = ApprovalPathsRoutedToRoadmap

// THE PORT THE DEPLOY BINDS THE BROKER TO, derived rather than chosen. While the roadmap is the
// routed answerer the only admissible port is the dark one; from the moment the front door names
// the broker, the two must agree, so they are read from the same row.
fn approval_broker_deploy_port() -> Port {
  match approval_route_ownership {
    ApprovalPathsRoutedToRoadmap => approval_broker_dark_listen_port
    ApprovalPathsRoutedToBroker => approval_broker_listen_port
    ApprovalPathsOwnedByBroker => approval_broker_listen_port
  }
}

// WHETHER THE FRONT DOOR CARRIES THE TWO APPROVAL MOUNTS AT ALL. This is the half the port proxy
// could not express: a mount that exists must name the port the broker is on, and while the roadmap
// answers there must be no mount.
fn approval_front_door_mounts_installed() -> Bool {
  match approval_route_ownership {
    ApprovalPathsRoutedToRoadmap => false
    ApprovalPathsRoutedToBroker => true
    ApprovalPathsOwnedByBroker => true
  }
}

fn roadmap_still_mounts_approval_routes() -> Bool {
  match approval_route_ownership {
    ApprovalPathsRoutedToRoadmap => true
    ApprovalPathsRoutedToBroker => true
    ApprovalPathsOwnedByBroker => false
  }
}

// THE ONE INVARIANT EVERY ARM MUST SATISFY: exactly one party is routed to the approval paths.
// The roadmap is routed when it holds the rows and no mount diverts them; the broker is routed when
// a mount names it. Neither two nor zero is admissible, and this is the projection a claim asserts
// over every arm rather than over the one the row happens to hold.
fn roadmap_is_routed_for_approvals() -> Bool {
  roadmap_still_mounts_approval_routes() && !approval_front_door_mounts_installed()
}

fn broker_is_routed_for_approvals() -> Bool {
  approval_front_door_mounts_installed()
}

type ApprovalBrokerCutoverStage
  = DeployDark
  | ProveRelease
  | MeasureDemand
  | RepointFrontDoor
  | ProbeRouteClasses
  | RetireRoadmapRoutes

fn approval_broker_cutover_stages() -> List<ApprovalBrokerCutoverStage> {
  [DeployDark, ProveRelease, MeasureDemand, RepointFrontDoor, ProbeRouteClasses, RetireRoadmapRoutes]
}

fn approval_broker_cutover_stage_label(stage: ApprovalBrokerCutoverStage) -> NonEmptyStr {
  match stage {
    DeployDark => "deploy-dark" as NonEmptyStr
    ProveRelease => "prove-release" as NonEmptyStr
    MeasureDemand => "measure-demand" as NonEmptyStr
    RepointFrontDoor => "repoint-front-door" as NonEmptyStr
    ProbeRouteClasses => "probe-route-classes" as NonEmptyStr
    RetireRoadmapRoutes => "retire-roadmap-routes" as NonEmptyStr
  }
}

// WHAT EACH STAGE IS FOR, in the order the ordering exists to enforce:
//
//   1. DeployDark        -- the broker unit and slice are installed and started on the DARK port,
//                           which nothing proxies to. Its store access is idle. The roadmap is
//                           still the only process anything routes an approval to, so there is
//                           still exactly one writer.
//   2. ProveRelease      -- the dark process reads back the release it was launched with. A process
//                           that cannot say which release it is must never be routed to, because
//                           every later stage's evidence would be about an unknown build.
//   3. MeasureDemand     -- the six readings the slice bound was asked to be derived from, taken
//                           against the dark process: cold bind and load peak, idle resident,
//                           submission-plus-notification peak, confirm-page peak, redemption peak,
//                           status-poll peak. Until this stage the bound in gunbc.live_deploy.emit
//                           is a ceiling proved by containment, not a measurement (that row says so
//                           itself), and this stage is what replaces it.
//   4. RepointFrontDoor  -- the two approval mounts move to the broker. THIS is the stage that
//                           makes the broker a writer, and stage 6 is what stops the roadmap being
//                           one; between them the roadmap is REACHABLE but no longer ROUTED, which
//                           is why probing comes before retiring.
//   5. ProbeRouteClasses -- all four route classes are exercised THROUGH the front door. This is
//                           also where the one thing this corpus does not know about the upstream
//                           is settled: whether a --set-path mount presents the mount prefix to the
//                           backend (gunbc.auth.approval_broker_endpoint
//                           approval_broker_front_door_path_preservation). A 404 here is a located
//                           refusal with the roadmap still able to serve, which is the whole reason
//                           this stage is before the next one and not after it.
//   6. RetireRoadmapRoutes -- the cutover arm and its projection are deleted from
//                           gunbc.roadmap_serve, and the roadmap process stops being able to reach
//                           the store or either keyring at all.

// ── THE EVIDENCE ─────────────────────────────────────────────────────────────────────────────
// EACH FIELD IS AN OBSERVATION SOMEONE BROUGHT BACK, never an intention someone declared. The
// distinction is the whole value of the type: a stage whose entry condition is "we decided to" can
// always be satisfied, and a plan that can always advance is not a plan.

type DarkDeploymentStanding
  = DarkUnitNotStarted { detail: NonEmptyStr }
  | DarkUnitListening { port: Port }

// THE RELEASE READBACK IS DERIVED FROM THE BYTES THE PROCESS ANSWERED, NOT DECLARED (review 68036).
// It used to be a free-standing pair an operator could construct either way, which made the one
// stage whose whole job is "prove this process is the build you deployed" satisfiable by saying so.
// It is now produced by release_readback_from_livez below, which parses the liveness document
// through gunbc.serve_liveness -- so the arm this evidence carries is decided by the process, and
// the detail on the refusing arm is that module's located reason rather than prose someone typed.
type ReleaseReadback
  = ReleaseNotReadBack { detail: NonEmptyStr }
  | ReleaseReadBack { revision: NonEmptyStr }

// THE URL STAGE 2 PROBES. It is loopback and it names the liveness path from its authority, so a
// rename of either moves the probe with it. The PORT is the argument because stage 2 runs against
// the DARK broker: probing the serving port would be probing whatever is already there.
fn approval_broker_liveness_url(port: Port) -> NonEmptyStr {
  join([
    approval_broker_loopback_base_url(port: port) as String,
    serve_liveness_path as String,
  ], "") as NonEmptyStr
}

// THE ONLY WAY TO BUILD THE ADMITTING ARM. Every refusing arm of the read maps to
// ReleaseNotReadBack carrying that read's own reason; only an observed, 40-hex-validated revision
// produces ReleaseReadBack. So a stage cannot be advanced past "prove release" by a body that
// answered 200 with nothing useful in it -- a 200 is the caller's observation, and what the process
// SAID is what this decides on.
fn release_readback_from_read(read: ServeLivenessRead) -> ReleaseReadback {
  match read {
    ServeLivenessObserved { revision: rev } => ReleaseReadBack { revision: rev as String as NonEmptyStr }
    ServeLivenessUnreachable { detail: _ } => ReleaseNotReadBack { detail: serve_liveness_read_reason(r: read) }
    ServeLivenessBodyUnparseable => ReleaseNotReadBack { detail: serve_liveness_read_reason(r: read) }
    ServeLivenessBodyNotAnObject => ReleaseNotReadBack { detail: serve_liveness_read_reason(r: read) }
    ServeLivenessRevisionAbsent => ReleaseNotReadBack { detail: serve_liveness_read_reason(r: read) }
    ServeLivenessRevisionDuplicated { count: _ } => ReleaseNotReadBack { detail: serve_liveness_read_reason(r: read) }
    ServeLivenessRevisionNotAString => ReleaseNotReadBack { detail: serve_liveness_read_reason(r: read) }
    ServeLivenessRevisionMalformed { text: _ } => ReleaseNotReadBack { detail: serve_liveness_read_reason(r: read) }
  }
}

fn release_readback_from_livez(body: String) -> ReleaseReadback {
  let read = observe_serve_liveness(body: body)
  match read {
    ServeLivenessObserved { revision: rev } => ReleaseReadBack { revision: rev as String as NonEmptyStr }
    ServeLivenessBodyUnparseable => ReleaseNotReadBack { detail: serve_liveness_read_reason(r: read) }
    ServeLivenessBodyNotAnObject => ReleaseNotReadBack { detail: serve_liveness_read_reason(r: read) }
    ServeLivenessRevisionAbsent => ReleaseNotReadBack { detail: serve_liveness_read_reason(r: read) }
    ServeLivenessRevisionDuplicated { count: _ } => ReleaseNotReadBack { detail: serve_liveness_read_reason(r: read) }
    ServeLivenessRevisionNotAString => ReleaseNotReadBack { detail: serve_liveness_read_reason(r: read) }
    ServeLivenessRevisionMalformed { text: _ } => ReleaseNotReadBack { detail: serve_liveness_read_reason(r: read) }
  }
}

// THE SIX READINGS ARE ONE VALUE BECAUSE THEY ARE ONE QUESTION. A bound derived from five of them
// is a bound with an unmeasured peak in it, and the peak that is missing is the one that will be
// hit. Absence is not zero, so the unmeasured state is its own arm rather than a reading of 0.
// THE READINGS ARE ByteSize, NOT Int, AND THE REASON IS THIS STAGE'S OWN PRODUCT (review 68036).
// Stage 3 exists to TIGHTEN gunbc.live_deploy.emit approval_broker_slice_memory_max and
// approval_broker_slice_memory_high from these numbers, and those two rows are ByteSize. A bare Int
// here would have put the measurement and the bound it feeds in two different unit systems at the
// one seam where they are compared -- so a reading could be handed to a bound without anything
// establishing they were the same quantity. std.measure already owns this, and the same PR consumes
// it correctly one module away; a second unit system for bytes is the section 3 fork.
//
// declared_concurrency stays an Int because it is a COUNT of in-flight requests, not a quantity of
// memory -- and that is the distinction ByteSize exists to keep, not an exception to it.
type BrokerDemandReading
  = DemandUnmeasured { missing: NonEmptyStr }
  | DemandMeasured {
      cold_load_peak: ByteSize
      idle_resident: ByteSize
      submission_peak: ByteSize
      confirm_page_peak: ByteSize
      redemption_peak: ByteSize
      status_poll_peak: ByteSize
      declared_concurrency: Int
    }

type FrontDoorStanding
  = FrontDoorPointsAtRoadmap
  | FrontDoorPointsAtBroker { port: Port }

// ONE ARM PER ROUTE CLASS, and a class is UNPROBED until an answer came back through the front
// door. A probe that was skipped and a probe that returned a 404 are different facts about the
// deployment and must not fold together, because the first says nothing was learned and the second
// says something was learned and it was bad -- DESIGN's not-met versus cannot-tell.
type RouteClassProbe
  = RouteClassUnprobed
  | RouteClassRefused { status: Int, detail: NonEmptyStr }
  | RouteClassAnswered { status: Int }

type ApprovalBrokerCutoverEvidence {
  dark: DarkDeploymentStanding
  release_readback: ReleaseReadback
  demand: BrokerDemandReading
  front_door: FrontDoorStanding
  confirm_probe: RouteClassProbe
  decide_probe: RouteClassProbe
  submit_probe: RouteClassProbe
  status_probe: RouteClassProbe
}

// ── ADMISSION ────────────────────────────────────────────────────────────────────────────────
// EVERY REFUSAL NAMES THE STAGE AND WHAT IS MISSING. None of them is a boolean false: a caller that
// cannot advance learns which observation to go and take, which is the difference between a typed
// refusal and a gate.
type CutoverRefusal
  = DarkDeploymentNotListening { detail: NonEmptyStr }
  | DarkDeploymentOnTheServingPort { port: Port }
  | ReleaseUnreadable { detail: NonEmptyStr }
  | DemandNotMeasured { missing: NonEmptyStr }
  | FrontDoorStillAtRoadmap
  | RouteClassNotProbed { route: NonEmptyStr }
  | RouteClassProbeRefused { route: NonEmptyStr, status: Int, detail: NonEmptyStr }
  | BothWritersWouldBeLive { detail: NonEmptyStr }

type CutoverAdmission
  = StageAdmitted { stage: ApprovalBrokerCutoverStage }
  | StageRefused { stage: ApprovalBrokerCutoverStage, cause: CutoverRefusal }

fn route_class_admission(route: NonEmptyStr, probe: RouteClassProbe) -> CutoverRefusal? {
  match probe {
    RouteClassUnprobed => Present { value: RouteClassNotProbed { route: route } }
    RouteClassRefused { status: st, detail: d } =>
      Present { value: RouteClassProbeRefused { route: route, status: st, detail: d } }
    RouteClassAnswered { status: _ } => Absent
  }
}

fn first_refusal(causes: List<CutoverRefusal?>) -> CutoverRefusal? {
  fold(causes, init: none, f: (acc, c) =>
    match acc {
      Present { value: _ } => acc
      Absent => c
    }
  )
}

fn all_route_classes_probed(e: ApprovalBrokerCutoverEvidence) -> CutoverRefusal? {
  first_refusal(causes: [
    route_class_admission(route: approval_broker_confirm_path_template, probe: e.confirm_probe),
    route_class_admission(route: "POST \{capability\} decide" as NonEmptyStr, probe: e.decide_probe),
    route_class_admission(route: approval_broker_submit_path, probe: e.submit_probe),
    route_class_admission(route: approval_broker_status_path_template, probe: e.status_probe),
  ])
}

// THE DARK STAGE'S OWN REFUSAL IS THE ONE THAT KEEPS THE STAGING HONEST. A "dark" deployment that
// came up on the SERVING port is not dark: the front door would reach it, and the stage whose whole
// purpose is to observe the broker while it is not a writer would be observing a second writer.
fn dark_deployment_admission(e: ApprovalBrokerCutoverEvidence) -> CutoverRefusal? {
  match e.dark {
    DarkUnitNotStarted { detail: d } => Present { value: DarkDeploymentNotListening { detail: d } }
    DarkUnitListening { port: p } =>
      if p == approval_broker_listen_port {
        Present { value: DarkDeploymentOnTheServingPort { port: p } }
      } else {
        Absent
      }
  }
}

fn release_admission(e: ApprovalBrokerCutoverEvidence) -> CutoverRefusal? {
  match e.release_readback {
    ReleaseNotReadBack { detail: d } => Present { value: ReleaseUnreadable { detail: d } }
    ReleaseReadBack { revision: _ } => Absent
  }
}

fn demand_admission(e: ApprovalBrokerCutoverEvidence) -> CutoverRefusal? {
  match e.demand {
    DemandUnmeasured { missing: m } => Present { value: DemandNotMeasured { missing: m } }
    DemandMeasured {
      cold_load_peak: _, idle_resident: _, submission_peak: _,
      confirm_page_peak: _, redemption_peak: _, status_poll_peak: _,
      declared_concurrency: _,
    } => Absent
  }
}

fn front_door_admission(e: ApprovalBrokerCutoverEvidence) -> CutoverRefusal? {
  match e.front_door {
    FrontDoorPointsAtRoadmap => Present { value: FrontDoorStillAtRoadmap }
    FrontDoorPointsAtBroker { port: _ } => Absent
  }
}

// ── ENTERING A STAGE AND DISCHARGING IT ARE TWO QUESTIONS ───────────────────────────────────
// THE FIRST CUT HAD ONLY ONE FOLD AND ITS ONE PRODUCTION CALLER ASKED THE WRONG QUESTION (review
// 68058). Admission is CUMULATIVE over PRIOR stages -- what must already be observed before this
// stage may be attempted -- so `admission(ProveRelease)` consulted the dark deployment and NOT the
// release readback, which is correct for what it means and useless as a check that the release was
// proved. The dark-install entry asked it anyway and reported success for a broker that never
// bound its port or answered a branch name, while the annotation above that entry asserted the
// opposite. That is rung inflation on a check of my own (DESIGN section 4b, and section 4b's prior
// question: is the RED authorable before the check is written -- here it was not).
//
// SO THE PER-STAGE OBSERVATION IS NAMED ONCE and the two questions are both derived from it:
// admission folds the stages BEFORE this one, discharge folds the stages UP TO AND INCLUDING it.
// One roster, so a new stage cannot be added to one question and forgotten in the other.
//
// RetireRoadmapRoutes HAS NO OWN OBSERVATION because its discharge is not something anyone reports:
// it is roadmap_approval_mount being flipped, which approval_broker_cutover_complete reads
// directly. A stage whose completion is a corpus fact must not also have an evidence field, or the
// two can disagree and the one that is asserted wins.
fn cutover_stage_own_cause(
  stage: ApprovalBrokerCutoverStage,
  e: ApprovalBrokerCutoverEvidence,
) -> CutoverRefusal? {
  match stage {
    DeployDark => dark_deployment_admission(e: e)
    ProveRelease => release_admission(e: e)
    MeasureDemand => demand_admission(e: e)
    RepointFrontDoor => front_door_admission(e: e)
    ProbeRouteClasses => all_route_classes_probed(e: e)
    RetireRoadmapRoutes => none
  }
}

fn cutover_causes_through(
  stage: ApprovalBrokerCutoverStage,
  e: ApprovalBrokerCutoverEvidence,
) -> CutoverRefusal? {
  match stage {
    DeployDark => cutover_stage_own_cause(stage: DeployDark, e: e)
    ProveRelease => first_refusal(causes: [
      cutover_stage_own_cause(stage: DeployDark, e: e),
      cutover_stage_own_cause(stage: ProveRelease, e: e),
    ])
    MeasureDemand => first_refusal(causes: [
      cutover_stage_own_cause(stage: DeployDark, e: e),
      cutover_stage_own_cause(stage: ProveRelease, e: e),
      cutover_stage_own_cause(stage: MeasureDemand, e: e),
    ])
    RepointFrontDoor => first_refusal(causes: [
      cutover_stage_own_cause(stage: DeployDark, e: e),
      cutover_stage_own_cause(stage: ProveRelease, e: e),
      cutover_stage_own_cause(stage: MeasureDemand, e: e),
      cutover_stage_own_cause(stage: RepointFrontDoor, e: e),
    ])
    ProbeRouteClasses => first_refusal(causes: [
      cutover_stage_own_cause(stage: DeployDark, e: e),
      cutover_stage_own_cause(stage: ProveRelease, e: e),
      cutover_stage_own_cause(stage: MeasureDemand, e: e),
      cutover_stage_own_cause(stage: RepointFrontDoor, e: e),
      cutover_stage_own_cause(stage: ProbeRouteClasses, e: e),
    ])
    RetireRoadmapRoutes => first_refusal(causes: [
      cutover_stage_own_cause(stage: DeployDark, e: e),
      cutover_stage_own_cause(stage: ProveRelease, e: e),
      cutover_stage_own_cause(stage: MeasureDemand, e: e),
      cutover_stage_own_cause(stage: RepointFrontDoor, e: e),
      cutover_stage_own_cause(stage: ProbeRouteClasses, e: e),
    ])
  }
}

// MAY THIS STAGE BE ATTEMPTED: every EARLIER stage's observation is in. The refusal reported is the
// first missing one, which is the one to go and take.
fn approval_broker_cutover_admission(
  stage: ApprovalBrokerCutoverStage,
  e: ApprovalBrokerCutoverEvidence,
) -> CutoverAdmission {
  let cause = match stage {
    DeployDark => none
    ProveRelease => cutover_causes_through(stage: DeployDark, e: e)
    MeasureDemand => cutover_causes_through(stage: ProveRelease, e: e)
    RepointFrontDoor => cutover_causes_through(stage: MeasureDemand, e: e)
    ProbeRouteClasses => cutover_causes_through(stage: RepointFrontDoor, e: e)
    RetireRoadmapRoutes => cutover_causes_through(stage: ProbeRouteClasses, e: e)
  }
  match cause {
    Present { value: c } => StageRefused { stage: stage, cause: c }
    Absent => StageAdmitted { stage: stage }
  }
}

// HAS THIS STAGE BEEN DISCHARGED: its OWN observation is in, and every earlier one too. This is the
// question a caller asks when it has just performed a stage and wants to know whether it worked --
// which is what the dark install asks, and what it previously got wrong by asking the other one.
fn approval_broker_cutover_stage_discharged(
  stage: ApprovalBrokerCutoverStage,
  e: ApprovalBrokerCutoverEvidence,
) -> CutoverAdmission {
  match cutover_causes_through(stage: stage, e: e) {
    Present { value: c } => StageRefused { stage: stage, cause: c }
    Absent => StageAdmitted { stage: stage }
  }
}

fn cutover_refusal_reason(c: CutoverRefusal) -> NonEmptyStr {
  match c {
    DarkDeploymentNotListening { detail: d } =>
      join(["the approval broker is not listening on its dark port: ", d as String], "") as NonEmptyStr
    DarkDeploymentOnTheServingPort { port: p } =>
      join([
        "the approval broker came up on the SERVING port ", to_string(p),
        ", so it is not dark: the front door can reach it and the store would have two writers. ",
        "Bind the dark port (gunbc.auth.approval_broker_endpoint approval_broker_dark_listen_port) ",
        "for every stage before the front door is repointed.",
      ], "") as NonEmptyStr
    ReleaseUnreadable { detail: d } =>
      join(["the dark broker did not read back a release revision: ", d as String,
            ". Every later stage's evidence would be about an unknown build."], "") as NonEmptyStr
    DemandNotMeasured { missing: m } =>
      join([
        "the broker's own memory demand is unmeasured: ", m as String,
        ". Its slice bound is currently a ceiling proved by containment in the pre-split roadmap ",
        "closure, not a measurement, and repointing traffic before measuring would mean sizing a ",
        "live writer from a number about a different process.",
      ], "") as NonEmptyStr
    FrontDoorStillAtRoadmap =>
      "the front door still proxies the approval paths to the roadmap port; nothing has moved yet" as NonEmptyStr
    RouteClassNotProbed { route: r } =>
      join([
        "route class ", r as String, " was never probed through the front door. Unprobed is not ",
        "passing: it says nothing was learned, which is exactly the state the roadmap's rows must ",
        "not be removed under.",
      ], "") as NonEmptyStr
    RouteClassProbeRefused { route: r, status: st, detail: d } =>
      join([
        "route class ", r as String, " answered ", to_string(st), " through the front door: ",
        d as String,
        ". If this is a 404 on an /approve path, the discriminator is the one ",
        "gunbc.auth.approval_broker_endpoint approval_broker_front_door_path_preservation names: a ",
        "--set-path mount that strips its prefix presents /<capability> to a table matching ",
        "/approve/<capability>. Repair it in the model, with the roadmap still able to serve.",
      ], "") as NonEmptyStr
    BothWritersWouldBeLive { detail: d } =>
      join(["refusing: this would leave two processes able to write the approval store -- ", d as String], "") as NonEmptyStr
  }
}

// ── WHERE THE PLAN IS ────────────────────────────────────────────────────────────────────────
// THE FURTHEST ADMITTED STAGE, derived from evidence rather than tracked as state. A recorded
// position is a second authority for something the observations already determine, and it is the
// one that goes stale when a stage is rolled back.
fn approval_broker_cutover_position(e: ApprovalBrokerCutoverEvidence) -> ApprovalBrokerCutoverStage {
  fold(approval_broker_cutover_stages(), init: DeployDark, f: (acc, stage) =>
    match approval_broker_cutover_stage_discharged(stage: stage, e: e) {
      StageAdmitted { stage: s } => s
      StageRefused { stage: _, cause: _ } => acc
    }
  )
}

// THE TERMINAL CONDITION, stated as the fact stage 6 establishes rather than as a stage that has
// been performed: the roadmap no longer mounts an approval route. It reads roadmap_approval_mount
// -- the declaration that DECIDES it -- rather than an evidence field an operator supplied, which
// is the correction review 68050 forced: the field restated a corpus fact, so a caller could assert
// the cutover complete while the rows were still mounted, and a plan reading its own intent is not
// reading anything.
fn approval_broker_cutover_complete(e: ApprovalBrokerCutoverEvidence) -> Bool {
  !roadmap_still_mounts_approval_routes()
    && match approval_broker_cutover_admission(stage: RetireRoadmapRoutes, e: e) {
      StageAdmitted { stage: _ } => true
      StageRefused { stage: _, cause: _ } => false
    }
}

// ── WHAT STAGE 4 INSTALLS ────────────────────────────────────────────────────────────────────
// THE TWO MOUNTS ARE A VALUE THE PLAN CARRIES, not a command someone types at stage 4. That is the
// difference between a modeled deploy step and the hand-authored migration script DESIGN section 6
// classifies as out-of-band actuation: the argv the operator runs and the argv the plan reasons
// about are the same projection of the same endpoint, so "was the front door repointed" is a
// question about a value rather than about what was typed.
//
// THEY ADD MAPPINGS RATHER THAN REPLACING ONE, and that is what keeps the roadmap serving
// everything else through the cutover. tailscale keys a mapping on (listener port x mount path x
// service), so two --set-path endpoints on the same https listener sit beside the roadmap's root
// mount instead of rebinding it -- the collision the endpoint key exists to make expressible, here
// deliberately avoided rather than deliberately caused.
fn approval_broker_front_door_endpoints(https_port: Port, backend_port: Port) -> List<TailscaleServeEndpoint> {
  [
    approval_broker_confirm_front_door(https_port: https_port, backend_port: backend_port),
    approval_broker_status_front_door(https_port: https_port, backend_port: backend_port),
  ]
}

// THE BACKEND IS approval_broker_deploy_port(), NOT A LITERAL. Naming the serving port here while
// the broker was bound to the dark one is the defect review 68075 found: the mounts and the unit
// read the same row now, so the front door cannot name a port nothing is listening on.
fn approval_broker_front_door_enable_argv(https_port: Port) -> List<List<String>> {
  map(
    approval_broker_front_door_endpoints(https_port: https_port, backend_port: approval_broker_deploy_port()),
    e => tailscale_serve_enable_argv(endpoint: e),
  )
}

// ── WHAT THE DARK INSTALL ASKS THIS PLAN, IN PRODUCTION ─────────────────────────────────────
// REVIEW 68050'S SECOND FINDING: the admission fold had no production consumer, so it gated
// nothing -- an inert lens, which DESIGN section 4b calls a lie rather than a weak wall. This is
// the consumer. gunbc.live_deploy.apply's dark-install entry probes the broker it just installed
// and hands the reading here, so stage 2 is DECIDED by what the process answered rather than by an
// operator saying it answered.
//
// THE OTHER STAGES' EVIDENCE IS DELIBERATELY ABSENT RATHER THAN FABRICATED. A deploy that has just
// installed the broker has taken no demand measurement, repointed no front door and probed no route
// class, and supplying plausible arms for them would be exactly the fabricated-output failure this
// plan exists to prevent. So this builds the evidence it HAS and leaves the rest at its unmeasured
// and unprobed arms, which is why the admission it can reach is ProveRelease and no further -- the
// cumulative rule then refuses every later stage on its own missing observation, by name.
// THE DARK ARM IS DERIVED FROM THE PROBE, NOT FROM THE CALLER'S ARGUMENT (review 68058). It was
// built from the port the deploy intended to use, which made "is a broker listening" a restatement
// of "we asked systemd to start one". A probe that did not land is a unit that is not listening,
// and that is the only thing that can distinguish them from here.
fn dark_install_evidence(listening_port: Port, read: ServeLivenessRead) -> ApprovalBrokerCutoverEvidence {
  ApprovalBrokerCutoverEvidence {
    dark: match read {
      ServeLivenessUnreachable { detail: d } => DarkUnitNotStarted { detail: d }
      _ => DarkUnitListening { port: listening_port }
    },
    release_readback: release_readback_from_read(read: read),
    demand: DemandUnmeasured { missing: "the six readings stage 3 takes against this dark process" as NonEmptyStr },
    front_door: FrontDoorPointsAtRoadmap,
    confirm_probe: RouteClassUnprobed,
    decide_probe: RouteClassUnprobed,
    submit_probe: RouteClassUnprobed,
    status_probe: RouteClassUnprobed,
  }
}

// IT ASKS DISCHARGE, NOT ADMISSION, and that is the whole correction. Admission for ProveRelease
// asks whether the release readback MAY BE ATTEMPTED; discharge asks whether it SUCCEEDED. The
// first is a constant pass from this caller and was being reported as a receipt that the plan is
// consumed -- worse than an absent check, because it was cited as evidence (review 68058).
//
// WHAT NOW GOES RED FROM THIS CALLER, stated so the claim is not read as stronger than it is: a
// probe that did not land, bytes that are not JSON, a JSON value that is not an object, a document
// with no revision member or two of them, a non-string revision, and a revision that is not 40
// lowercase hex. What CANNOT go red from here is the serving-port arm of dark_deployment_admission,
// because approval_broker_deploy_port() makes that placement unwritable -- that arm's red is
// authorable only over a supplied observation, and it is exercised there.
fn dark_install_release_discharged(listening_port: Port, read: ServeLivenessRead) -> CutoverAdmission {
  approval_broker_cutover_stage_discharged(
    stage: ProveRelease,
    e: dark_install_evidence(listening_port: listening_port, read: read),
  )
}
