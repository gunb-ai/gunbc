
module gunbc.auth.hosted_ci_secrets_federation

// ── THE HOSTED-RUNNER SHADOW GATE'S CREDENTIAL READER, ONE DEDICATED LOW-PRIVILEGE ACCOUNT ──────────
//
// The hosted-runner shadow gate (gunbc.witness.hosted_runner_shadow_gate_workflow) joins the tailnet
// and reaches the remote-build hosts, so it needs TWO CI-scoped credentials: the hosted-CI remote-build
// SSH private half (gunbc.compute.remote_build::remote_build_ci_ssh_privkey_secret) and the Tailscale CI
// OAuth client secret (gunbc.tailscale_ci_oauth_client::tailscale_oauth_client_secret_ref). Both live in
// GCP Secret Manager (project gunbai-secrets, number 582015116396 -- the operator's policy). The gate
// reads them over GitHub->GCP workload identity, NOT from GitHub Actions secrets. The client ID itself is
// public (gunbc.tailscale_ci_oauth_client::ci_oauth_client_id) and the gate passes that model constant
// to the tailscale action; the annotation on the secret is the operator's rotation pairing record, and
// no fetch reads it.
//
// WHY ITS OWN ACCOUNT AND NOT fleet-cloud-convergence. gunbc.auth.fleet_secret_accessor_roster is the
// cell roster for the FLEET CONVERGENCE principal (fleet-cloud-convergence@gunbai-secrets), and that
// account holds the R2 write token and the standing fleet secrets; a shadow-gate run reaching it would be
// a severe escalation. The gate gets its OWN account, holding only the two CI cells it reads.
//
// WHY A DEDICATED, CLAIM-PINNED PROVIDER AND NOT THE REPOSITORY-WIDE ONE (manager ruling 2026-11-20).
// Through the repository-wide github-oidc provider (github_gcp_federation::github_wif_provider) ANY job
// of this repository -- pull_request, merge_group, witnesses -- could mint this account's token and read
// both secrets. That is the exploited shape recorded at gunbc.auth.heal_publisher_federation (gunbc#10887,
// where the bot App key was reachable from a pull_request job for exactly this reason). The gate's remote
// legs therefore run ONLY on a workflow_dispatch at refs/heads/main, and this pool's single provider
// pins membership to exactly that surface via shadow_gate_workflow_claim_pins (gunbc.auth.oidc_claim_pins):
// repository numeric identity, the shadow-gate workflow FILE at reviewed main, ref refs/heads/main, event
// workflow_dispatch. The event+ref pins are what narrow the population -- a workflow-PATH pin alone does
// not, because on pull_request the workflow_ref claim names the PR's OWN copy of the file (finding relayed
// by gentle-crab-832 from review of #16803). Fork pull requests receive no OIDC token under any shape.
// The capability gap this leaves (the shadow verdict exists only at dispatch, not on PRs; closing it needs
// the build host to verify a GitHub OIDC token scoped to the PR and build that commit isolated, so no
// PR-authored code ever holds the key) is recorded in gunbc.integration_concern.
//
// THE ACCESSOR CELLS ARE PINNED TO ONE VERSION each, the native-product-read discipline: the account can
// read exactly one version of each secret, pinned by IAM condition (resource.name == the versioned
// resource), so a NEW version is not readable until the model relays it and iam-converge rebinds. The
// operator relayed both versions on 2026-11-20 (gcloud secrets versions list --project=gunbai-secrets):
// remote-build-ci-ssh-key version 1 enabled (created 2026-11-20T19:36:30Z), tailscale-oauth-client-secret
// version 1 enabled (created 2026-11-20T19:13:51Z); neither has another or a destroyed version. ONE
// version constant per secret (review 97015: a version decided in two places is a single_authority fork) --
// the SecretRef rows carry no version; the pin applies it here, and the custody witness asserts equality.

import std.types { String, NonEmptyStr, List, Map }
import std.optional { Present }
import extdeps.cloud.gcp.gcp { ServiceAccountEmail, WifProvider, wif_provider_resource, wif_pool_resource }
import gunbc.auth.github_gcp_federation { fleet_secrets_project_number, github_wif_issuer_uri, federated_service_account_member }
import gunbc.auth.oidc_claim_pins { OidcClaimPin, claim_pins_attribute_condition, shadow_gate_workflow_claim_pins }
import gunbc.auth.heal_publisher_provision { DedicatedFederation, StandingPoolImpersonation }
import gunbc.auth.managed_host_boot_federation { pinned_version_accessor_grant_for }
import gunbc.secret_provision { secret_ref_pin_version }
import gunbc.compute.remote_build { remote_build_ci_ssh_privkey_secret }
import gunbc.tailscale_ci_oauth_client { tailscale_oauth_client_secret_ref }

// THE ACCOUNT. Low-privilege, keyless, WIF-only: no user-managed key ever issues for it, and the ONLY
// way in is this pool's pinned provider (a shadow-gate dispatch at reviewed main).
data hosted_ci_secrets_service_account: ServiceAccountEmail = "hosted-ci-secrets@gunbai-secrets.iam.gserviceaccount.com"

data hosted_ci_secrets_service_account_id: NonEmptyStr = "hosted-ci-secrets"

data hosted_ci_secrets_wif_pool_id: NonEmptyStr = "github-hosted-shadow-gate"

data hosted_ci_secrets_wif_provider_id: NonEmptyStr = "github-hosted-shadow-gate-oidc"

// THE PINNED VERSIONS -- operator relay of 2026-11-20 (see header). Each is the ONE enabled version of
// its secret the gate may read; iam-converge binds the accessor cell to exactly that version resource.
data hosted_ci_ssh_key_secret_version: NonEmptyStr = "1"
data tailscale_oauth_client_secret_version: NonEmptyStr = "1"

data hosted_ci_secrets_attribute_mapping: Map<String, String> = {
  "google.subject": "assertion.sub",
  "attribute.repository_id": "assertion.repository_id",
  "attribute.repository_owner_id": "assertion.repository_owner_id",
  "attribute.workflow_ref": "assertion.workflow_ref",
  "attribute.ref": "assertion.ref",
  "attribute.event_name": "assertion.event_name",
}

fn hosted_ci_secrets_attribute_condition() -> String {
  claim_pins_attribute_condition(pins: shadow_gate_workflow_claim_pins())
}

fn hosted_ci_secrets_principal_set() -> String {
  join(
    [
      "principalSet://iam.googleapis.com/",
      wif_pool_resource(project_number: fleet_secrets_project_number, pool_id: hosted_ci_secrets_wif_pool_id as String),
      "/*",
    ],
    ""
  )
}

fn hosted_ci_secrets_provider() -> WifProvider {
  WifProvider {
    name: hosted_ci_secrets_wif_provider_id,
    pool: hosted_ci_secrets_wif_pool_id,
    issuer_uri: github_wif_issuer_uri,
    attribute_mapping: Present { value: hosted_ci_secrets_attribute_mapping },
    attribute_condition: Present { value: hosted_ci_secrets_attribute_condition() },
  }
}

fn hosted_ci_secrets_provider_resource() -> String {
  wif_provider_resource(project_number: fleet_secrets_project_number, provider: hosted_ci_secrets_provider())
}

fn hosted_ci_secrets_federation() -> DedicatedFederation {
  DedicatedFederation {
    label: "hosted-CI shadow gate secrets reader (shadow-gate dispatch at reviewed main only)",
    pool_id: hosted_ci_secrets_wif_pool_id,
    pool_display_name: "Hosted shadow gate (main)",
    provider_id: hosted_ci_secrets_wif_provider_id,
    attribute_mapping: hosted_ci_secrets_attribute_mapping,
    attribute_condition: hosted_ci_secrets_attribute_condition(),
    impersonation: StandingPoolImpersonation { principal_set: hosted_ci_secrets_principal_set() },
    service_account: hosted_ci_secrets_service_account,
    service_account_id: hosted_ci_secrets_service_account_id,
    service_account_display_name: "Hosted-CI shadow gate secrets reader (WIF-only, two pinned secret versions, no keys)",
    service_account_member: federated_service_account_member(email: hosted_ci_secrets_service_account),
    secret_grants: [
      pinned_version_accessor_grant_for(
        title_prefix: "hosted-ci-ssh-key",
        description: "gunbc.auth.hosted_ci_secrets_federation: the one version of the hosted-CI remote-build SSH private half the shadow gate reads",
        target: secret_ref_pin_version(ref: remote_build_ci_ssh_privkey_secret, version: hosted_ci_ssh_key_secret_version),
      ),
      pinned_version_accessor_grant_for(
        title_prefix: "tailscale-oauth-client",
        description: "gunbc.auth.hosted_ci_secrets_federation: the one version of the Tailscale CI OAuth client secret the shadow gate reads",
        target: secret_ref_pin_version(ref: tailscale_oauth_client_secret_ref, version: tailscale_oauth_client_secret_version),
      ),
    ],
  }
}
