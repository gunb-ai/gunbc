module gunbc.auth.hosted_ci_secrets_federation

// ── THE HOSTED-RUNNER SHADOW GATE'S CREDENTIAL READER, ONE DEDICATED LOW-PRIVILEGE ACCOUNT ──────────
//
// The hosted-runner shadow gate (gunbc.witness.hosted_runner_shadow_gate_workflow, PR#2) joins the tailnet
// and reaches the remote-build hosts, so it needs TWO CI-scoped credentials: the hosted-CI remote-build SSH
// private half (gunbc.compute.remote_build::remote_build_ci_ssh_privkey_secret) and the Tailscale CI OAuth
// client secret (gunbc.tailscale_ci_oauth_client::tailscale_oauth_client_secret_ref). Both live in GCP
// Secret Manager (project gunbai-secrets, number 582015116396 — the operator's policy). The gate reads them
// over GitHub→GCP workload identity, NOT from GitHub Actions secrets.
//
// WHY ITS OWN ACCOUNT AND NOT fleet-cloud-convergence. gunbc.auth.fleet_secret_accessor_roster is the cell
// roster for the FLEET CONVERGENCE principal (fleet-cloud-convergence@gunbai-secrets), and
// gunbc.auth.fleet_convergence_federation pins that principal to workflow_dispatch at refs/heads/main and
// REFUSES pull_request — while the shadow gate runs on pull_request and merge_group. The gate cannot be
// that principal, and it must not be: that account holds the R2 write token and the standing fleet secrets,
// so a pull-request run reaching it would be a severe escalation. So the gate gets its OWN account, holding
// only the two CI cells it reads, federated through the repository's WIDE github-oidc provider — the exact
// shape gunbc.native_product_federation::native_product_read_federation uses for its one pinned read token.
//
// WHY THE REPOSITORY-WIDE PROVIDER AND NOT A NEW DEDICATED, WORKFLOW-PINNED POOL (the (B)-buys-nothing
// ruling). A dedicated pool pinned to the shadow-gate workflow file plus the pull_request/merge_group
// events looks tighter, but on pull_request a job_workflow_ref / workflow-file pin names the PR's OWN copy
// of the workflow: any same-repository writer who can open a pull request can edit the pinned file, so the
// pin does NOT separate them from the population the repository-wide provider already admits (a run of this
// repository, subject == gunb-ai/gunbc). Fork pull requests receive no OIDC token under either shape. What
// the dedicated pool would add is review surface and a new claim-pin population, for no reduction in who can
// reach the credentials. The blast radius is CI-scoped by design — a forced-command gunbc-build key (see
// gunbc.compute.remote_build::remote_build_serve_entry_command, which admits only the store-apply verb over
// an admitted source ref) and an OAuth client that only mints EPHEMERAL tag:ci-dispatch nodes (see
// gunbc.tailscale_ci_oauth_client::ci_oauth_client_ephemeral). The residual is stated honestly: with the
// repository-wide provider, any job of this repository could mint a token for this account, so BOTH secrets
// must be kept CI-scoped and never widened to a host or standing credential.
//
// THE ACCESSOR CELLS ARE PINNED TO ONE VERSION, the native-product-read discipline: the account can read
// exactly one version of each secret, pinned by IAM condition (resource.name == the versioned resource), so
// a NEW version is not readable until the model relays it and iam-converge rebinds. The version is the
// OPERATOR'S RELAY — the facts record creation (2026-11-20) but not the version number, and a version
// written before it was read would be a guessed number in a security row (review 95989), so these stay
// "pending" and the pinned condition matches NOTHING until the operator relays the enabled version. Until
// then the gate's read REFUSES rather than reading an unconfirmed version.

import std.types { String, NonEmptyStr, List }
import extdeps.cloud.gcp.gcp { ServiceAccountEmail }
import gunbc.auth.heal_publisher_provision { DedicatedFederation, StandingPoolImpersonation }
import gunbc.auth.github_gcp_federation {
  github_wif_pool_id, github_wif_provider_id, github_wif_attribute_mapping, github_wif_attribute_condition,
  github_wif_principal_set, federated_service_account_member,
}
import gunbc.auth.managed_host_boot_federation { pinned_version_accessor_grant_for }
import gunbc.secret_provision { secret_ref_pin_version }
import gunbc.compute.remote_build { remote_build_ci_ssh_privkey_secret }
import gunbc.tailscale_ci_oauth_client { tailscale_oauth_client_secret_ref }

// THE ACCOUNT. Low-privilege, keyless, WIF-only: no user-managed key ever issues for it, and the ONLY way
// in is the repository-wide provider (this repository's runs).
data hosted_ci_secrets_service_account: ServiceAccountEmail = "hosted-ci-secrets@gunbai-secrets.iam.gserviceaccount.com"

data hosted_ci_secrets_service_account_id: NonEmptyStr = "hosted-ci-secrets"

// THE PINNED VERSIONS — OPERATOR RELAY, currently "pending" (see the header). Each is the ONE enabled
// version of its secret the gate may read; flip to the relayed number and iam-converge rebinds the cell.
data hosted_ci_ssh_key_secret_version: NonEmptyStr = "pending"
data tailscale_oauth_client_secret_version: NonEmptyStr = "pending"

fn hosted_ci_secrets_federation() -> DedicatedFederation {
  DedicatedFederation {
    label: "hosted-CI shadow gate secrets reader",
    pool_id: github_wif_pool_id,
    pool_display_name: "GitHub Actions",
    provider_id: github_wif_provider_id,
    attribute_mapping: github_wif_attribute_mapping,
    attribute_condition: github_wif_attribute_condition(),
    impersonation: StandingPoolImpersonation { principal_set: github_wif_principal_set() },
    service_account: hosted_ci_secrets_service_account,
    service_account_id: hosted_ci_secrets_service_account_id,
    service_account_display_name: "Hosted-CI shadow gate secrets reader (WIF-only, two pinned secret versions, no keys)",
    service_account_member: federated_service_account_member(email: hosted_ci_secrets_service_account),
    secret_grants: [
      pinned_version_accessor_grant_for(
        title_prefix: "hosted-ci-ssh-key",
        description: "gunbc.auth.hosted_ci_secrets_federation: the one version of the hosted-CI remote-build SSH private half the shadow gate reads",
        target: secret_ref_pin_version(ref: remote_build_ci_ssh_privkey_secret, version: hosted_ci_ssh_key_secret_version),
      ),
      pinned_version_accessor_grant_for(
        title_prefix: "tailscale-oauth-client",
        description: "gunbc.auth.hosted_ci_secrets_federation: the one version of the Tailscale CI OAuth client secret the shadow gate reads",
        target: secret_ref_pin_version(ref: tailscale_oauth_client_secret_ref, version: tailscale_oauth_client_secret_version),
      ),
    ],
  }
}
