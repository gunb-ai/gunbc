module gunbc.auth.mac_keyring

import std.types { String, NonEmptyStr, Secret, Int, Bool }
import extdeps.numeric.base16 { base16_is_lower_digit_code_point }
import extdeps.crypto.mac { MacKey, MacKeyId, MacSuite, HmacSha256, mac_key_material_hex_length }
import extdeps.filesystem.filesystem_io { Filesystem, FilesystemExactRead, FilesystemExactPathRead, FilesystemExactPathAbsent, FilesystemExactPathUnreadable, FilesystemExactPathKindUnrecognized, filesystem_exact_read }

// Shared key-file realization, extracted intact from approval_decision_store. Historical exported
// names remain available there; state storage need not load approval workflow/store machinery.
data approval_mac_key_suite: MacSuite = HmacSha256

// ABSENT AND UNREADABLE ARE TWO REFUSALS WITH TWO REMEDIES (review 66990; the doctrine
// extdeps.filesystem.filesystem_io filesystem_file_observation carries: absence is established by a
// listing that succeeded, never by a failed read): an absent
// key means the materialization frontier has not run; an unreadable one means it ran and the unit
// cannot read what it wrote -- a permission on the file, not a missing step. Reading `content`
// alone and calling "" absent would report the second as the first, which fails toward good news.
// THE FAILURES ARE THEIR OWN COPRODUCT so a refusal downstream can carry exactly a failure and
// never the loaded key (review 67005: a refusal arm that could hold the success state validates
// instead of constructing).
type ApprovalKeyringRefusal
  = ApprovalKeyFileAbsent { path: NonEmptyStr }
  | ApprovalKeyFileUnreadable { path: NonEmptyStr, error: String }
  | ApprovalKeyMalformed { path: NonEmptyStr, length: Int }

type ApprovalKeyringRead
  = ApprovalKeyLoaded { key: MacKey }
  | ApprovalKeyringRefused { cause: ApprovalKeyringRefusal }

fn is_lower_hex(s: String) -> Bool {
  all(s.chars(), cp => base16_is_lower_digit_code_point(cp: cp))
}

// THE MATERIAL IS 64 LOWERCASE HEX DIGITS AND NOTHING ELSE; a trailing newline from an editor is
// refused rather than trimmed, because a key that verifies with one reader and not another is
// worse than one that refuses everywhere. An empty file is malformed, not absent: absence is the
// filesystem's answer, established by the exact read below, never inferred from empty content.
fn approval_keyring_from_content(path: NonEmptyStr, key_id: MacKeyId, content: String) -> ApprovalKeyringRead {
  if content.length() != mac_key_material_hex_length(s: approval_mac_key_suite) || !is_lower_hex(s: content) {
    ApprovalKeyringRefused { cause: ApprovalKeyMalformed { path: path, length: content.length() } }
  } else {
    ApprovalKeyLoaded { key: MacKey { id: key_id, suite: approval_mac_key_suite, material: content as Secret } }
  }
}

// ONE READER FOR EVERY MAC KEY FILE THE APPROVAL LOOP HOLDS. The capability key and the submission
// key (gunbc.auth.approval_request_submission) differ only in path and key id, so those are
// parameters; the 64-lower-hex rule and the absent/unreadable/malformed partition are stated once.
// A second copy of this fold drifted (it dropped the hex check) within a day of being written, and
// the drift reported a malformed server key to the filer as its own 403.
fn approval_keyring_from_exact_read(path: NonEmptyStr, key_id: MacKeyId, exact: FilesystemExactRead) -> ApprovalKeyringRead {
  match exact {
    FilesystemExactPathRead { path: _, content: c } => approval_keyring_from_content(path: path, key_id: key_id, content: c)
    FilesystemExactPathAbsent { path: _ } => ApprovalKeyringRefused { cause: ApprovalKeyFileAbsent { path: path } }
    FilesystemExactPathUnreadable { path: _, kind: _, error: e } => ApprovalKeyringRefused { cause: ApprovalKeyFileUnreadable { path: path, error: e } }
    FilesystemExactPathKindUnrecognized { path: _, observed: o, error: e } => ApprovalKeyringRefused { cause: ApprovalKeyFileUnreadable { path: path, error: concat(o, concat(": ", e)) } }
  }
}

fn read_mac_keyring(path: NonEmptyStr, key_id: MacKeyId) -> ApprovalKeyringRead {
  let read = Filesystem.Read(path: path as String)
  approval_keyring_from_exact_read(path: path, key_id: key_id, exact: filesystem_exact_read(path: path as String, content: read.content, success: read.success, error: read.error, error_kind: read.error_kind))
}
