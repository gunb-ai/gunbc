module gunbc.auth.org_admin_credential

import std.types { NonEmptyStr, Timestamp }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.github.org_admin_auth { OrgAdminCredentialShape, OrgAdminCredentialKind, OrgActionsCapability, FineGrainedPersonalAccessToken, GitHubAppInstallationAccessToken }

type SecretMaterialIdentity { name: NonEmptyStr }
type CredentialArtifactIdentity { name: NonEmptyStr }
type AcquisitionTransactionIdentity { name: NonEmptyStr }
type CeremonyIdentity { name: NonEmptyStr }
type DependencyIdentity { name: NonEmptyStr }

type CredentialBootstrapActorRole = GitHubOrganizationOwner | GitHubAppManager
type CredentialBootstrapSurface = GitHubTokenSettingsWebPage | GitHubOAuthConsentWebPage | GitHubOAuthDeviceFlow | GitHubAppRegistrationAndInstallWebPage
type AcceptedAuthenticatorClass = ProviderPasswordAuthenticator | TotpAuthenticator | HardwareSecurityKeyAuthenticator | FederatedIdentityProviderAuthenticator

type HumanAuthorizationCeremonyReceipt {
  ceremony: CeremonyIdentity
  provider: NonEmptyStr
  human_actor: NonEmptyStr
  provider_account: NonEmptyStr
  interaction_surface: CredentialBootstrapSurface
  authorized_action: NonEmptyStr
  target_resource: NonEmptyStr
  accepted_authenticator_classes: List<AcceptedAuthenticatorClass>
  observed_role: CredentialBootstrapActorRole
  provider_result_identity: NonEmptyStr
  completed_at: Timestamp
}

type AcquisitionProofPurpose = ProveRequesterIdentity | ProveApplicationIdentity | AuthorizeOrganizationAccess
type AcquisitionRequirement
  = CredentialProof { credential: CredentialArtifactIdentity, purpose: AcquisitionProofPurpose }
  | HumanAuthorizationCeremony { ceremony: CeremonyIdentity }
  | AuthorityResourceStanding { resource: NonEmptyStr }
  | AuthorizationGrantStanding { grant: NonEmptyStr }
  | ApprovalReceipt { approver: NonEmptyStr, approved_request: NonEmptyStr }
  | AuthenticatorBindingStanding { actor_account: NonEmptyStr, authenticator: NonEmptyStr }
  | WorkloadOrDeviceAttestation { attestation: NonEmptyStr }
  | CustodyUseStanding { secret: SecretMaterialIdentity }

type CredentialArtifact {
  identity: CredentialArtifactIdentity
  credential: OrgAdminCredentialShape
  issuer_identity: NonEmptyStr
  subject_identity: NonEmptyStr
  target_identity: NonEmptyStr
  acquisition_transaction: AcquisitionTransactionIdentity
}

type CredentialAcquisitionTransaction {
  identity: AcquisitionTransactionIdentity
  issuer_identity: NonEmptyStr
  requested_output: CredentialArtifactIdentity
  requirements: List<AcquisitionRequirement>
  execution_receipt: NonEmptyStr
  output: CredentialArtifactIdentity
}

type CredentialGenealogyRoot
  = HumanAuthorizationCeremonyRoot { ceremony: CeremonyIdentity }
  | ExternalIssuerTrustBoundary { issuer: NonEmptyStr }
  | ExternalAccountRecoveryBoundary { provider_account: NonEmptyStr }
  | WorkloadOrDeviceAttestationRoot { attestation: NonEmptyStr }
  | FactoryOrHardwareTrustAnchor { anchor: NonEmptyStr }

type AcquiredUsing { requirement: AcquisitionRequirement, transaction: AcquisitionTransactionIdentity, output: CredentialArtifactIdentity }

type CredentialGenealogyStanding
  = CredentialGenealogyComplete { acquisition_roots: List<CredentialGenealogyRoot>, transaction_set_digest: NonEmptyStr }
  | CredentialGenealogyMissingProducer { artifact: CredentialArtifactIdentity }
  | CredentialGenealogyMissingDependency { transaction: AcquisitionTransactionIdentity, dependency: DependencyIdentity }
  | CredentialGenealogyAmbiguousProducer { artifact: CredentialArtifactIdentity, producers: List<AcquisitionTransactionIdentity> }
  | CredentialGenealogyCycleDetected { cycle: List<AcquisitionTransactionIdentity> }
  | CredentialGenealogyUnclassifiedRoot { root: DependencyIdentity }
  | CredentialGenealogyRecoveryBoundaryUnmodeled { provider_account: NonEmptyStr }
  | CredentialGenealogyHumanCeremonyMissing

type DependencyInvalidationEffect = InvalidatesCurrentUse | ReducesCurrentScope | BlocksFutureMinting | BlocksHumanRecovery | MakesCustodyUnavailable | HistoricalOnly
type CurrentUseRequires { credential: CredentialArtifactIdentity, dependency: DependencyIdentity, exact_capability: OrgActionsCapability, invalidation_effect: DependencyInvalidationEffect }
type RenewalRequires { credential_kind: OrgAdminCredentialKind, dependency: DependencyIdentity, replacement_transaction: AcquisitionTransactionIdentity, invalidation_effect: DependencyInvalidationEffect }

type CredentialRenewalCandidate
  = ProgrammaticRenewalCandidate { transaction: AcquisitionTransactionIdentity }
  | HumanRenewalCandidate { ceremony: CeremonyIdentity, credential_expires_at: Timestamp, latest_safe_start: Timestamp }
  | NoRenewalCandidate
type CredentialContinuityStanding
  = CredentialContinuityCurrent { projected_through: Timestamp }
  | CredentialContinuityDue { latest_safe_start: Timestamp }
  | CredentialContinuityAtRisk
  | CredentialContinuityUnavailable

type SecretMaterialStore
  = GitHubActionsOrganizationSecret { organization: NonEmptyStr, secret_name: NonEmptyStr }
  | GitHubActionsRepositorySecret { repository: NonEmptyStr, secret_name: NonEmptyStr }
  | LocalOperatorCredentialStore { profile: NonEmptyStr }
type SecretMaterialReader = FleetOrgActionsObserveLane | FleetOrgActionsApplyLane | OperatorReadOnlyValidationLane
type CredentialCustodyStanding
  = CredentialAvailableToExactPrincipal { principal: SecretMaterialReader }
  | CredentialAvailableButWrongPrincipal
  | CredentialTemporarilyUnavailable
  | CredentialMaterialMissing
  | CredentialSuspectedCompromised
  | CredentialDestroyed
type RotationObligation = RotateBeforeExpiry { latest_rotation_at: Timestamp } | RenewablePerInvocation
type SecretDeletionSemantics = RevokeUpstreamThenDeleteStoredVersion | DeleteEphemeralTokenAfterInvocation
type SecretLossRemedy = RotateAndRevalidate | RemintFromProtectedAppKey
type SecretRestoreTestCadence = RestoreTestAtEveryRotation | RestoreTestBeforeAppKeyRotation
type SecretProtectionContract { deletion: SecretDeletionSemantics, loss_remedy: SecretLossRemedy, restore_test_cadence: SecretRestoreTestCadence }

type OrgAdminProbeEndpoint { method: NonEmptyStr, path_template: NonEmptyStr }
data list_organization_runner_groups_probe: OrgAdminProbeEndpoint = OrgAdminProbeEndpoint { method: "GET", path_template: "/orgs/\{org\}/actions/runner-groups" }
type ProbeEffect = TargetResourceReadOnly | ProviderAuditEventPossible | CredentialLastUsedMayAdvance
type CredentialCapabilityProbeReceipt {
  material: SecretMaterialIdentity
  credential_kind: OrgAdminCredentialKind
  exact_capability: OrgActionsCapability
  endpoint: OrgAdminProbeEndpoint
  organization: NonEmptyStr
  observed_at: Timestamp
  producer: DeclarationRef
  effects: List<ProbeEffect>
}

type CredentialOperationStanding
  = CredentialOperationUsable { capability: OrgActionsCapability, target: NonEmptyStr, valid_through: Timestamp, probe_receipt: CredentialCapabilityProbeReceipt }
  | CredentialOperationProbeRequired { capability: OrgActionsCapability }
  | CredentialOperationMaterialUnavailable
  | CredentialOperationExpired
  | CredentialOperationRevoked
  | CredentialOperationSuspended
  | CredentialOperationAuthorizationMissing
  | CredentialOperationInsufficientCapability
  | CredentialOperationProviderUnknown

type SecretMaterial {
  identity: SecretMaterialIdentity
  artifact: CredentialArtifact
  genealogy: CredentialGenealogyStanding
  current_use_requirements: List<CurrentUseRequires>
  renewal_requirements: List<RenewalRequires>
  renewal_candidate: CredentialRenewalCandidate
  continuity: CredentialContinuityStanding
  store: SecretMaterialStore
  readers: List<SecretMaterialReader>
  custody: CredentialCustodyStanding
  rotation: RotationObligation
  protection: SecretProtectionContract
  operation_standings: List<CredentialOperationStanding>
}

type OrgAdminCredentialRefusal
  = OrgAdminCredentialMissing { identity: SecretMaterialIdentity }
  | OrgAdminCredentialReaderDenied { reader: SecretMaterialReader }
  | OrgAdminCredentialGenealogyIncomplete { standing: CredentialGenealogyStanding }
  | OrgAdminCredentialMaterialUnavailable { standing: CredentialCustodyStanding }
  | OrgAdminCredentialCapabilityProbeRequired { capability: OrgActionsCapability }
  | OrgAdminCredentialOperationNotUsable { capability: OrgActionsCapability, standing: CredentialOperationStanding? }
  | OrgAdminAppKeyUnreadable { resource: NonEmptyStr, http_status: String }
  | OrgAdminInstallationTokenRefused { installation: NonEmptyStr, status_line: String }
type OrgAdminCredentialAdmission = OrgAdminCredentialAdmitted { material: SecretMaterialIdentity } | OrgAdminCredentialRefused { cause: OrgAdminCredentialRefusal }

// THE TWO ARMS ABOVE WERE REFUSAL TEXT BEFORE THEY WERE REFUSALS, and that is the defect they
// close. The org-actions CI prelude in gunbc.ci_spec already stopped the line on both conditions and
// already printed a sentence beginning "OrgAdminAppKeyUnreadable:" / "OrgAdminInstallationTokenRefused:",
// so the NAMES existed, were located, and were load-bearing -- in a shell string. Nothing in the
// type system knew them, no consumer could match on them, and a reader grepping the refusal
// coproduct for either name found nothing. Reporting that as "the refusals are already typed and
// located" was rung inflation (§4b(1)): the evidence establishing the rung was an echo, and an echo
// establishes nothing a program can act on.
//
// So the arms are declared here, where the rest of this credential's refusal vocabulary lives, and
// the prelude's sentence is RENDERED from them rather than written beside them. That is the
// direction that matters: with the message derived, the shell text cannot drift from the type,
// because there is only one place the words exist. Editing the declaration while the realization
// lies is the §5 tell this arrangement removes -- there is no second copy left to lie.
//
// WHY THE STATUS FIELDS ARE String AND NOT A PARSED CODE. The producer is a shell prelude, and what
// it holds at that point is `$SM_CODE` -- an unexpanded shell word, not an integer this model can
// see. Typing the field as Int would force the renderer's caller to fabricate one, which would make
// the type prettier and the receipt false. It carries what is actually known.

// The remedy names the converge that fixes it. A refusal that stops the line without saying which
// modeled entry restarts it sends the reader to a terminal to improvise, which is the loop this
// whole lane exists to remove.
fn org_admin_app_key_unreadable_message(resource: String, http_status: String) -> String {
  join([
    "OrgAdminAppKeyUnreadable: Secret Manager answered HTTP ", http_status, " for ", resource,
    " to the fleet-cloud-convergence principal. 403 means the version exists and is not readable OR does not exist",
    " -- REMEDY: run org_admin_app_key_access_converge_with_supplied_token (gunbc.fleet.org_actions_converge)",
    " with a control-plane token to bind roles/secretmanager.secretAccessor, and confirm the version exists.",
    " Minting NO token."
  ], "")
}

// Three distinct causes present identically at this boundary, so the sentence names all three
// rather than guessing one. Collapsing them to the likeliest would send the reader to the App
// settings page when the key had in fact been revoked.
fn org_admin_installation_token_refused_message(installation: String, status_line: String) -> String {
  join([
    "OrgAdminInstallationTokenRefused: GitHub answered ", status_line, " for the ", installation,
    " installation; a revoked key, a removed installation, or a missing Self-hosted-runners permission",
    " each look like this -- inspect the App's installation on the organization"
  ], "")
}

fn reader_is_authorized(material: SecretMaterial, reader: SecretMaterialReader) -> Bool { any(material.readers, r => r == reader) }

fn standing_for_capability(standings: List<CredentialOperationStanding>, exact_operation: OrgActionsCapability) -> CredentialOperationStanding? {
  fold(standings, init: none, f: fn(found, standing) { match found {
    Present { value } => Present { value: value }
    Absent => match standing {
      CredentialOperationUsable { capability: c, target: _, valid_through: _, probe_receipt: _ } => if c == exact_operation { Present { value: standing } } else { none }
      CredentialOperationProbeRequired { capability: c } => if c == exact_operation { Present { value: standing } } else { none }
      CredentialOperationMaterialUnavailable => none
      CredentialOperationExpired => none
      CredentialOperationRevoked => none
      CredentialOperationSuspended => none
      CredentialOperationAuthorizationMissing => none
      CredentialOperationInsufficientCapability => none
      CredentialOperationProviderUnknown => none
    }
  } })
}

fn capability_is_usable(material: SecretMaterial, exact_operation: OrgActionsCapability, observed_at: Timestamp) -> Bool {
  match standing_for_capability(standings: material.operation_standings, exact_operation: exact_operation) {
    Present { value } => match value {
      CredentialOperationUsable { capability: _, target: _, valid_through, probe_receipt: _ } => observed_at <= valid_through
      CredentialOperationProbeRequired { capability: _ } => false
      CredentialOperationMaterialUnavailable => false
      CredentialOperationExpired => false
      CredentialOperationRevoked => false
      CredentialOperationSuspended => false
      CredentialOperationAuthorizationMissing => false
      CredentialOperationInsufficientCapability => false
      CredentialOperationProviderUnknown => false
    }
    Absent => false
  }
}

fn first_unusable_capability(material: SecretMaterial, required_capabilities: List<OrgActionsCapability>, observed_at: Timestamp) -> OrgActionsCapability? {
  fold(required_capabilities, init: none, f: fn(found, needed) { match found {
    Present { value } => Present { value: value }
    Absent => if capability_is_usable(material: material, exact_operation: needed, observed_at: observed_at) { none } else { Present { value: needed } }
  } })
}

fn admit_org_admin_credential(material: SecretMaterial?, reader: SecretMaterialReader, required_capabilities: List<OrgActionsCapability>, observed_at: Timestamp) -> OrgAdminCredentialAdmission {
  match material {
    Absent => OrgAdminCredentialRefused { cause: OrgAdminCredentialMissing { identity: SecretMaterialIdentity { name: "github-org-admin" } } }
    Present { value } => {
      let held = value
      if !reader_is_authorized(material: held, reader: reader) {
      OrgAdminCredentialRefused { cause: OrgAdminCredentialReaderDenied { reader: reader } }
    } else { match held.genealogy {
      CredentialGenealogyComplete { acquisition_roots: _, transaction_set_digest: _ } => match held.custody {
        CredentialAvailableToExactPrincipal { principal } => if principal != reader {
          OrgAdminCredentialRefused { cause: OrgAdminCredentialReaderDenied { reader: reader } }
        } else { match first_unusable_capability(material: held, required_capabilities: required_capabilities, observed_at: observed_at) {
          Absent => OrgAdminCredentialAdmitted { material: held.identity }
          Present { value } => {
            let missing_capability = value
            let found = standing_for_capability(standings: held.operation_standings, exact_operation: missing_capability)
            match found {
              Present { value } => match value {
                CredentialOperationProbeRequired { capability: due } => OrgAdminCredentialRefused { cause: OrgAdminCredentialCapabilityProbeRequired { capability: due } }
                CredentialOperationUsable { capability: _, target: _, valid_through: _, probe_receipt: _ } => OrgAdminCredentialRefused { cause: OrgAdminCredentialOperationNotUsable { capability: missing_capability, standing: found } }
                CredentialOperationMaterialUnavailable => OrgAdminCredentialRefused { cause: OrgAdminCredentialOperationNotUsable { capability: missing_capability, standing: found } }
                CredentialOperationExpired => OrgAdminCredentialRefused { cause: OrgAdminCredentialOperationNotUsable { capability: missing_capability, standing: found } }
                CredentialOperationRevoked => OrgAdminCredentialRefused { cause: OrgAdminCredentialOperationNotUsable { capability: missing_capability, standing: found } }
                CredentialOperationSuspended => OrgAdminCredentialRefused { cause: OrgAdminCredentialOperationNotUsable { capability: missing_capability, standing: found } }
                CredentialOperationAuthorizationMissing => OrgAdminCredentialRefused { cause: OrgAdminCredentialOperationNotUsable { capability: missing_capability, standing: found } }
                CredentialOperationInsufficientCapability => OrgAdminCredentialRefused { cause: OrgAdminCredentialOperationNotUsable { capability: missing_capability, standing: found } }
                CredentialOperationProviderUnknown => OrgAdminCredentialRefused { cause: OrgAdminCredentialOperationNotUsable { capability: missing_capability, standing: found } }
              }
              Absent => OrgAdminCredentialRefused { cause: OrgAdminCredentialOperationNotUsable { capability: missing_capability, standing: none } }
            }
          }
        } }
        unavailable => OrgAdminCredentialRefused { cause: OrgAdminCredentialMaterialUnavailable { standing: unavailable } }
      }
      incomplete => OrgAdminCredentialRefused { cause: OrgAdminCredentialGenealogyIncomplete { standing: incomplete } }
    } }
    }
  }
}

data interim_credential_kind: OrgAdminCredentialKind = FineGrainedPersonalAccessToken
data terminal_credential_kind: OrgAdminCredentialKind = GitHubAppInstallationAccessToken
data materialized_secret_authority: DeclarationRef = DeclarationRef { module_path: "gunbc.auth.materialized_secret", decl_name: "with_materialized_secret", field: WholeDeclaration }
