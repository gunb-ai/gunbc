module gunbc.auth.org_admin_credential

import std.types { NonEmptyStr, Timestamp }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.github.org_admin_auth {
  OrgAdminCredentialShape,
  OrgAdminCredentialKind,
  FineGrainedPersonalAccessToken,
  GitHubAppInstallationAccessToken,
  credential_supports_org_actions_converge
}

// Policy over the upstream shapes. Secret bytes never inhabit this model. A SecretMaterial row
// names custody, authorized readers, rotation, expiry, and executed validation. Consumption still
// goes through gunbc.auth.materialized_secret.with_materialized_secret; this is its standing, not a
// second materializer.
type SecretMaterialIdentity { name: NonEmptyStr }

type CredentialBootstrapActorRole
  = GitHubOrganizationOwner
  | GitHubAppManager

type CredentialBootstrapSurface
  = GitHubTokenSettingsWebPage
  | GitHubOAuthConsentWebPage
  | GitHubOAuthDeviceFlow
  | GitHubAppRegistrationAndInstallWebPage

type CredentialBootstrapProof
  = GitHubPasswordSecondFactorAndOrganizationRole
  | GitHubPasswordSecondFactorAndAppManagerRole

type HumanBootstrapReceipt {
  actor_role: CredentialBootstrapActorRole
  surface: CredentialBootstrapSurface
  proof: CredentialBootstrapProof
  completed_at: Timestamp
  stale_after: Timestamp
}

type CredentialDerivation
  = MintGitHubAppInstallationToken
  | ExchangeOAuthAuthorizationCode
  | RefreshOAuthUserToken

// Acquisition genealogy answers how a credential first became obtainable. Runtime dependency is
// separate below: the browser session that registered an app is in this tree, while the private
// key that must still exist whenever a token is minted is in CredentialRuntimeDependency.
type CredentialAcquisitionGenealogy
  = HumanCredentialBootstrap { receipt: HumanBootstrapReceipt }
  | CredentialAcquiredFrom {
      parent: CredentialAcquisitionGenealogy,
      derivation: CredentialDerivation,
      programmatically_renewable: Bool
    }

type CredentialRuntimeDependency
  = RuntimeCredentialRoot {
      material: SecretMaterialIdentity,
      standing: CredentialStanding
    }
  | RuntimeCredentialDerived {
      material: SecretMaterialIdentity,
      parent: CredentialRuntimeDependency,
      derivation: CredentialDerivation,
      standing: CredentialStanding
    }

type CredentialChainStanding
  = CredentialChainCurrent
  | CredentialChainStale { invalidating_fact: CredentialInvalidatingFact? }
  | CredentialChainMissing

fn credential_standing_chain_value(standing: CredentialStanding, observed_at: Timestamp) -> CredentialChainStanding {
  match standing {
    CredentialCurrent { evidence_digest: _, exact_producer: _, valid_until } =>
      if observed_at <= valid_until {
        CredentialChainCurrent
      } else {
        CredentialChainStale { invalidating_fact: Present { value: TimeExpiry { expired_at: valid_until } } }
      }
    CredentialProvisionallyUsable { missing_or_stale_fact: _, permitted_reader: _, expires_at: _ } => CredentialChainStale { invalidating_fact: none }
    CredentialStale { invalidating_fact } => CredentialChainStale { invalidating_fact: Present { value: invalidating_fact } }
    CredentialMissing => CredentialChainMissing
  }
}

fn runtime_dependency_standing(dependency: CredentialRuntimeDependency, observed_at: Timestamp) -> CredentialChainStanding {
  match dependency {
    RuntimeCredentialRoot { material: _, standing } => credential_standing_chain_value(standing: standing, observed_at: observed_at)
    RuntimeCredentialDerived { material: _, parent, derivation: _, standing } => {
      let parent_standing = runtime_dependency_standing(dependency: parent, observed_at: observed_at)
      match parent_standing {
        CredentialChainMissing => CredentialChainMissing
        CredentialChainStale { invalidating_fact } => CredentialChainStale { invalidating_fact: invalidating_fact }
        CredentialChainCurrent => credential_standing_chain_value(standing: standing, observed_at: observed_at)
      }
    }
  }
}

fn acquisition_genealogy_standing(
  genealogy: CredentialAcquisitionGenealogy,
  observed_at: Timestamp,
) -> CredentialChainStanding {
  match genealogy {
    HumanCredentialBootstrap { receipt } => if observed_at <= receipt.stale_after {
      CredentialChainCurrent
    } else {
      CredentialChainStale { invalidating_fact: Present { value: TimeExpiry { expired_at: receipt.stale_after } } }
    }
    CredentialAcquiredFrom { parent, derivation: _, programmatically_renewable: _ } =>
      acquisition_genealogy_standing(genealogy: parent, observed_at: observed_at)
  }
}

fn acquisition_bootstrap_count(genealogy: CredentialAcquisitionGenealogy) -> Int {
  match genealogy {
    HumanCredentialBootstrap { receipt: _ } => 1
    CredentialAcquiredFrom { parent, derivation: _, programmatically_renewable: _ } =>
      acquisition_bootstrap_count(genealogy: parent)
  }
}

fn acquisition_genealogy_is_well_founded(genealogy: CredentialAcquisitionGenealogy) -> Bool {
  acquisition_bootstrap_count(genealogy: genealogy) == 1
}

type CredentialRenewalObligation
  = RenewalAutomatic { derivation: CredentialDerivation }
  | RenewalOperatorScheduled { due_at: Timestamp }

fn renewal_obligation(genealogy: CredentialAcquisitionGenealogy) -> CredentialRenewalObligation {
  match genealogy {
    HumanCredentialBootstrap { receipt } => RenewalOperatorScheduled { due_at: receipt.stale_after }
    CredentialAcquiredFrom { parent, derivation, programmatically_renewable } =>
      if programmatically_renewable {
        RenewalAutomatic { derivation: derivation }
      } else {
        renewal_obligation(genealogy: parent)
      }
  }
}

type SecretMaterialStore
  = GitHubActionsOrganizationSecret { organization: NonEmptyStr, secret_name: NonEmptyStr }
  | GitHubActionsRepositorySecret { repository: NonEmptyStr, secret_name: NonEmptyStr }
  | LocalOperatorCredentialStore { profile: NonEmptyStr }

type SecretMaterialReader
  = FleetOrgActionsObserveLane
  | FleetOrgActionsApplyLane
  | OperatorReadOnlyValidationLane

type RotationObligation
  = RotateBeforeExpiry { latest_rotation_at: Timestamp }
  | RenewablePerInvocation

type SecretDeletionSemantics
  = RevokeUpstreamThenDeleteStoredVersion
  | DeleteEphemeralTokenAfterInvocation

type SecretLossRemedy
  = RotateAndRevalidate
  | RemintFromProtectedAppKey

type SecretRestoreTestCadence
  = RestoreTestAtEveryRotation
  | RestoreTestBeforeAppKeyRotation

type SecretProtectionContract {
  deletion: SecretDeletionSemantics
  loss_remedy: SecretLossRemedy
  restore_test_cadence: SecretRestoreTestCadence
}

type CredentialInvalidatingFact
  = TimeExpiry { expired_at: Timestamp }
  | CredentialRevoked { observed_at: Timestamp }
  | OrganizationOwnershipChanged { observed_at: Timestamp }
  | CredentialScopeChanged { observed_at: Timestamp }

type CredentialEvidenceGap
  = CredentialValidationNeverExecuted
  | CredentialValidationReceiptExpired
  | CredentialRuntimeParentNotCurrent

type CredentialStanding
  = CredentialCurrent {
      evidence_digest: NonEmptyStr,
      exact_producer: DeclarationRef,
      valid_until: Timestamp
    }
  | CredentialProvisionallyUsable {
      missing_or_stale_fact: CredentialEvidenceGap,
      permitted_reader: SecretMaterialReader,
      expires_at: Timestamp
    }
  | CredentialStale { invalidating_fact: CredentialInvalidatingFact }
  | CredentialMissing

type OrgAdminProbeEndpoint {
  method: NonEmptyStr
  path_template: NonEmptyStr
}

data list_organization_runner_groups_probe: OrgAdminProbeEndpoint = OrgAdminProbeEndpoint {
  method: "GET",
  path_template: "/orgs/\{org\}/actions/runner-groups"
}

type OrgAdminCredentialValidationReceipt {
  material: SecretMaterialIdentity
  credential_kind: OrgAdminCredentialKind
  endpoint: OrgAdminProbeEndpoint
  organization: NonEmptyStr
  validated_at: Timestamp
}

type SecretMaterial {
  identity: SecretMaterialIdentity
  credential: OrgAdminCredentialShape
  acquisition_genealogy: CredentialAcquisitionGenealogy
  runtime_dependency: CredentialRuntimeDependency
  store: SecretMaterialStore
  readers: List<SecretMaterialReader>
  rotation: RotationObligation
  protection: SecretProtectionContract
  validation: OrgAdminCredentialValidationReceipt?
}

type OrgAdminCredentialRefusal
  = OrgAdminCredentialMissing { identity: SecretMaterialIdentity }
  | OrgAdminCredentialReaderDenied { reader: SecretMaterialReader }
  | OrgAdminCredentialAcquisitionGenealogyMalformed
  | OrgAdminCredentialStandingNotCurrent
  | OrgAdminCredentialStale { invalidating_fact: CredentialInvalidatingFact }
  | OrgAdminCredentialCapabilityMissing
  | OrgAdminCredentialValidationMissing
  | OrgAdminCredentialValidationSubjectMismatch

type OrgAdminCredentialAdmission
  = OrgAdminCredentialAdmitted { material: SecretMaterialIdentity }
  | OrgAdminCredentialRefused { cause: OrgAdminCredentialRefusal }

fn reader_is_authorized(material: SecretMaterial, reader: SecretMaterialReader) -> Bool {
  any(material.readers, r => r == reader)
}

fn admit_org_admin_credential(
  material: SecretMaterial?,
  reader: SecretMaterialReader,
  observed_at: Timestamp,
) -> OrgAdminCredentialAdmission {
  match material {
    Absent => OrgAdminCredentialRefused {
      cause: OrgAdminCredentialMissing { identity: SecretMaterialIdentity { name: "github-org-admin" } }
    }
    Present { value: held } =>
      if !reader_is_authorized(material: held, reader: reader) {
        OrgAdminCredentialRefused { cause: OrgAdminCredentialReaderDenied { reader: reader } }
      } else if !acquisition_genealogy_is_well_founded(genealogy: held.acquisition_genealogy) {
        OrgAdminCredentialRefused { cause: OrgAdminCredentialAcquisitionGenealogyMalformed }
      } else if !credential_supports_org_actions_converge(shape: held.credential) {
        OrgAdminCredentialRefused { cause: OrgAdminCredentialCapabilityMissing }
      } else {
        let acquisition_standing = acquisition_genealogy_standing(
          genealogy: held.acquisition_genealogy,
          observed_at: observed_at
        )
        let live_standing = match acquisition_standing {
          CredentialChainCurrent => runtime_dependency_standing(
            dependency: held.runtime_dependency,
            observed_at: observed_at
          )
          CredentialChainStale { invalidating_fact } => CredentialChainStale { invalidating_fact: invalidating_fact }
          CredentialChainMissing => CredentialChainMissing
        }
        match live_standing {
          CredentialChainMissing => OrgAdminCredentialRefused { cause: OrgAdminCredentialStandingNotCurrent }
          CredentialChainStale { invalidating_fact } => match invalidating_fact {
            Absent => OrgAdminCredentialRefused { cause: OrgAdminCredentialStandingNotCurrent }
            Present { value: fact } => OrgAdminCredentialRefused {
              cause: OrgAdminCredentialStale { invalidating_fact: fact }
            }
          }
          CredentialChainCurrent => match held.validation {
            Absent => OrgAdminCredentialRefused { cause: OrgAdminCredentialValidationMissing }
            Present { value: receipt } =>
              if receipt.material != held.identity || receipt.credential_kind != held.credential.kind {
                OrgAdminCredentialRefused { cause: OrgAdminCredentialValidationSubjectMismatch }
              } else {
                OrgAdminCredentialAdmitted { material: held.identity }
              }
          }
        }
      }
  }
}

// Interim: a human creates the least-privilege fine-grained PAT and deposits it in the selected
// store. Terminal: store only the GitHub App private key and mint the one-hour installation token
// per invocation. Neither row contains secret bytes or chooses a shell/REST realization.
data interim_credential_kind: OrgAdminCredentialKind = FineGrainedPersonalAccessToken
data terminal_credential_kind: OrgAdminCredentialKind = GitHubAppInstallationAccessToken

data materialized_secret_authority: DeclarationRef = DeclarationRef {
  module_path: "gunbc.auth.materialized_secret",
  decl_name: "with_materialized_secret",
  field: WholeDeclaration
}
