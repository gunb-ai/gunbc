// ── THE SIX DEVICE ROUTES, as folds the broker mounts ────────────────────────────────────────
// Each fold takes what the serve entry hands a route -- the body, the path suffix where there is
// one, the serving process and the observed instant -- and returns the status and JSON body the
// wire spells. The broker (gunbc.auth.approval_broker_serve) owns routing, markers and the writer
// gate's placement; the redemption and wire modules own every decision; this module is the
// adapter between them and it decides nothing an authority module has not already decided.
//
// EVERY OPERATION IS A POST AND ITS AUTHENTICATION RIDES IN THE BODY (decision msg_5b415336): the
// enrolment POST carries a Google ID token and an App Attest attestation; the redeem POST carries a signature and a platform proof; the
// three reads and the push update carry a ReadAuthentication -- an App Attest assertion over the
// route's framed client data -- and are admitted only for an ACTIVE enrolment inside the skew
// window around the observed instant.
//
// WHAT NO ROUTE HERE DOES: mint a verified value -- SignatureVerified,
// AttestationVerified, AssertionAuthentic and the admitted enrolment/redemption are minted by the
// seams and folds they belong to, and this module only carries them from the verifier to the
// gate.

type DeviceRouteResponse {
  status: HttpStatus
  body: String
}

fn device_refusal_json(reason: String) -> String {
  serialize_json(v: json_object(members: [json_kv(key: "refused", value: json_string(s: reason))]))
}

fn device_refused(status: HttpStatus, reason: String) -> DeviceRouteResponse {
  DeviceRouteResponse { status: status, body: device_refusal_json(reason: reason) }
}

// The instant every route decides at: the clock probe admitted only as a canonical UTC instant.
fn device_observed_at() -> Timestamp? {
  match clock_now_probed_at() {
    Absent => none
    Present { value: t } => if utc_instant_is_canonical(t: t as Timestamp) { Present { value: t as Timestamp } } else { none }
  }
}

// THE INSTANT IS PROBED ONCE PER REQUEST, and a probe that is not a canonical UTC instant refuses
// the request rather than deciding under an unknown time.
fn device_clock_refused() -> DeviceRouteResponse {
  device_refused(status: 503, reason: "the clock did not answer a canonical UTC instant")
}

fn device_instant_plus(t: Timestamp, s: Second) -> Timestamp {
  Clock.TimestampAdd(timestamp: t, offset: second_count(s: s)).result
}

// ── The verifier's expectations, from the configuration ──────────────────────────────────────
type VerifierExpectations
  = VerifierReady { app_id: NonEmptyStr, config: AppAttestVerifierConfig }
  | VerifierUnconfigured { missing: NonEmptyStr }

fn verifier_expectations() -> VerifierExpectations {
  match approval_app_attest_verifier {
    AppAttestVerifierAwaitingOperator { missing: m } => VerifierUnconfigured { missing: m }
    AppAttestVerifierConfigured { app_id_prefix: _, bundle_id: _, environment: _, admitted_validation_categories: _, expected_bundle_version: _ } =>
      match approval_app_attest_app_id(c: approval_app_attest_verifier) {
        Absent => VerifierUnconfigured { missing: "app id" }
        Present { value: app_id } => VerifierReady { app_id: app_id, config: approval_app_attest_verifier }
      }
  }
}

fn attestation_expectation_for(app_id: NonEmptyStr, config: AppAttestVerifierConfig, key_id: AttestKeyId, client_data: NonEmptyStr, observed_at: Timestamp) -> AttestationExpectation? {
  match config {
    AppAttestVerifierAwaitingOperator { missing: _ } => none
    AppAttestVerifierConfigured { app_id_prefix: _, bundle_id: _, environment: env, admitted_validation_categories: cats, expected_bundle_version: ver } =>
      Present { value: AttestationExpectation { key_id: key_id, client_data: client_data, app_id: app_id, environment: env, observed_at: observed_at, admitted_validation_categories: cats, expected_bundle_version: ver } }
  }
}

fn assertion_expectation_for(app_id: NonEmptyStr, config: AppAttestVerifierConfig, key_id: AttestKeyId, public_key_point_b64url: NonEmptyStr, client_data: NonEmptyStr) -> AssertionExpectation? {
  match config {
    AppAttestVerifierAwaitingOperator { missing: _ } => none
    AppAttestVerifierConfigured { app_id_prefix: _, bundle_id: _, environment: _, admitted_validation_categories: cats, expected_bundle_version: ver } =>
      Present { value: AssertionExpectation { key_id: key_id, public_key_point_b64url: public_key_point_b64url, client_data: client_data, app_id: app_id, admitted_validation_categories: cats, expected_bundle_version: ver } }
  }
}

// The App Attest assertion for an enrolment's evidence over given client data: the verifier's
// verdict, or a refusal minted through the seam when the object does not decode as base64 or the
// enrolment is not an iOS one.
fn assertion_for_enrollment(enrollment: GoogleDeviceEnrollment, assertion_b64: NonEmptyStr, client_data: NonEmptyStr, app_id: NonEmptyStr, config: AppAttestVerifierConfig, gate: DeviceCryptoGate) -> SidecarResult<AssertionVerification> {
  match enrollment.evidence {
    AndroidAttestedDecisionKey => SidecarAnswered { verification: AssertionRefused { cause: AssertionUndecodable { cause: "no assertion verifier for an Android enrolment" } } }
    IosAttestedAppInstance { attest_key_id: k, attest_public_key_b64url: pk, receipt_b64: _ } =>
      match base64_decode(s: assertion_b64 as String, variant: Standard) {
        Absent => SidecarAnswered { verification: AssertionRefused { cause: AssertionUndecodable { cause: "assertion_b64 is not base64" } } }
        Present { value: _ } =>
          match assertion_expectation_for(app_id: app_id, config: config, key_id: k, public_key_point_b64url: pk, client_data: client_data) {
            Absent => SidecarAnswered { verification: AssertionRefused { cause: AssertionUndecodable { cause: "verifier unconfigured" } } }
            Present { value: e } => sidecar_assertion_verification(gate: gate, object_b64: assertion_b64, e: e)
          }
      }
  }
}

// ── Authenticated reads ──────────────────────────────────────────────────────────────────────
type DeviceReadAdmission
  = DeviceReadAdmitted { enrollment: GoogleDeviceEnrollment }
  | DeviceReadRefused { status: HttpStatus, reason: String }

// The window is closed below and open above, in whole seconds from the observed instant: a pure
// comparison over gunbc.auth.approval_capability utc_instant_seconds_after, so no clock call and no
// negative offset handed to a Nat carrier. Both instants must be canonical; either one failing is
// outside the window.
fn requested_at_within_skew(requested_at: Timestamp, observed_at: Timestamp) -> Bool {
  utc_instant_is_canonical(t: requested_at) && utc_instant_is_canonical(t: observed_at)
    && seconds_within_half_open_window(d: utc_instant_seconds_after(later: requested_at, earlier: observed_at), w: second_count(s: approval_device_read_skew) as Int)
}

fn seconds_within_half_open_window(d: Int, w: Int) -> Bool {
  d >= 0 - w && d < w
}

// ADMISSION OF A READ: a bound native verifier realization, an ACTIVE enrolment named by the body, a
// claimed time inside the skew window, an assertion under that enrolment's App Attest key over
// exactly this route's client data, and that assertion's counter committed past the enrolment's
// standing (gunbc.auth.approval_assertion_counter) BEFORE the operation runs. A revoked or unknown
// enrolment is refused before any verification runs; an unbound realization before anything is read.
//
// THE COUNTER IS WHAT MAKES A CAPTURED ASSERTION SINGLE-USE here: the skew window bounds when a
// read may be presented, not how often, so without the standing a captured authenticated read
// replays inside it -- recovering the fetch response, or, on the push update, rolling the APNs
// registration back to an older token. The redemption POST does NOT consult the standing: its
// replay wall is the server-minted expiring challenge and the one-decision CAS slot of
// redeem_device_over_store, and because Apple's counter is monotonic across the key, a redemption
// that does not advance the standing leaves the reads' strict comparison sound.
fn admit_device_read(realization: DeviceCryptoRealization, auth: ReadAuthentication, client_data: NonEmptyStr, observed_at: Timestamp) -> DeviceReadAdmission {
  match device_crypto_gate(r: realization) {
    DeviceCryptoGateRefused { status: st, reason: why } => DeviceReadRefused { status: st, reason: why }
    admitted => admit_device_read_realized(auth: auth, client_data: client_data, observed_at: observed_at, gate: admitted)
  }
}

// THE SIDECAR FAILING IS A 503 WITH ITS CAUSE, never a verification and never a fallback to the interpreted folds.
fn sidecar_unavailable_reason(cause: NonEmptyStr) -> String {
  "the device-crypto verifier is unavailable: " + (cause as String)
}

fn sidecar_failure_response(cause: NonEmptyStr) -> DeviceRouteResponse {
  device_refused(status: 503, reason: sidecar_unavailable_reason(cause: cause))
}

fn admit_device_read_realized(auth: ReadAuthentication, client_data: NonEmptyStr, observed_at: Timestamp, gate: DeviceCryptoGate) -> DeviceReadAdmission {
  match verifier_expectations() {
    VerifierUnconfigured { missing: m } => DeviceReadRefused { status: 503, reason: "the App Attest verifier is not configured: " + (m as String) }
    VerifierReady { app_id: app_id, config: config } =>
      match observe_google_enrolment(root: approval_device_store_root, enrollment_id: auth.enrollment_id) {
        GoogleEnrolmentAbsent => DeviceReadRefused { status: 404, reason: "no such enrolment" }
        GoogleEnrolmentRevoked { enrollment: _, revoked_at: _ } => DeviceReadRefused { status: 403, reason: "the enrolment is revoked" }
        GoogleEnrolmentUnreadable { detail: d } => DeviceReadRefused { status: 503, reason: d as String }
        GoogleEnrolmentActive { enrollment: e } =>
          if !requested_at_within_skew(requested_at: auth.requested_at, observed_at: observed_at) {
            DeviceReadRefused { status: 403, reason: "requested_at is outside the read skew window" }
          } else {
            match assertion_for_enrollment(enrollment: e, assertion_b64: auth.assertion_b64, client_data: client_data, app_id: app_id, config: config, gate: gate) {
              SidecarFailed { cause: why } => DeviceReadRefused { status: 503, reason: sidecar_unavailable_reason(cause: why) }
              SidecarAnswered { verification: AssertionRefused { cause: _ } } => DeviceReadRefused { status: 403, reason: "the read assertion did not verify" }
              SidecarAnswered { verification: AssertionAuthentic { authentic: a } } =>
                if a.client_data != client_data { DeviceReadRefused { status: 403, reason: "the read assertion covers other bytes" } }
                else {
                  match admit_assertion_counter(root: approval_assertion_counter_root, enrollment_id: e.enrollment_id, observed: a.counter) {
                    AssertionCounterAdmitted { enrollment_id: _, counter: _ } => DeviceReadAdmitted { enrollment: e }
                    refused => DeviceReadRefused { status: assertion_counter_refusal_status(a: refused), reason: assertion_counter_refusal_reason(a: refused) }
                  }
                }
            }
          }
      }
  }
}

// ── POST /approve/device/enrol ───────────────────────────────────────────────────────────────
// ONE total match from the model's refusal to its status, reason and wire arm each; the wire arm
// spells through google_enrolment_refusal_wire_label, covered by the injectivity witness.
fn google_enrolment_refusal_status(r: GoogleEnrolmentRefusal) -> HttpStatus {
  match r {
    GoogleEnrolmentTokenRefused { cause: _ } => 403
    GoogleEnrolmentAudienceNotExact => 403
    GoogleEnrolmentAuthorizedPartyNotAdmitted => 403
    GoogleEnrolmentEmailAbsent => 403
    GoogleEnrolmentNotAnApprover { email: _ } => 403
    GoogleEnrolmentSubjectMismatch { email: _ } => 403
    GoogleEnrolmentAttestationRefused { cause: _ } => 403
    GoogleEnrolmentAttestationForOtherBytes => 403
    GoogleEnrolmentAttestKeyMismatch => 403
    GoogleEnrolmentAndroidUnrealized => 501
    GoogleEnrolmentRevokedKey => 403
    GoogleEnrolmentStoredMismatch { field: _ } => 409
    GoogleEnrolmentStoreUnreadable { detail: _ } => 503
  }
}

fn google_enrolment_refusal_reason(r: GoogleEnrolmentRefusal) -> String {
  match r {
    GoogleEnrolmentTokenRefused { cause: c } => "the ID token was refused: " + oidc_id_token_refusal_reason(cause: c)
    GoogleEnrolmentAudienceNotExact => "the ID token's audience is not exactly the Approve client"
    GoogleEnrolmentAuthorizedPartyNotAdmitted => "the ID token's authorized party is not the Approve client"
    GoogleEnrolmentEmailAbsent => "the ID token carries no email"
    GoogleEnrolmentNotAnApprover { email: _ } => "the signed-in account is not an approver"
    GoogleEnrolmentSubjectMismatch { email: _ } => "another Google account is already pinned to this address"
    GoogleEnrolmentAttestationRefused { cause: _ } => "the attestation did not verify"
    GoogleEnrolmentAttestationForOtherBytes => "the attestation covers other bytes"
    GoogleEnrolmentAttestKeyMismatch => "the attestation is for another App Attest key"
    GoogleEnrolmentAndroidUnrealized => "Android enrolment is not realized"
    GoogleEnrolmentRevokedKey => "this key was revoked; create a new key and sign in again"
    GoogleEnrolmentStoredMismatch { field: _ } => "the stored enrolment for this key disagrees with the request"
    GoogleEnrolmentStoreUnreadable { detail: d } => d as String
  }
}

fn stored_enrolment_field_wire(f: StoredEnrolmentField) -> StoredEnrolmentFieldWire {
  match f {
    StoredFieldEnrollmentId => StoredFieldWireEnrollmentId
    StoredFieldGoogleSubject => StoredFieldWireGoogleSubject
    StoredFieldGoogleEmail => StoredFieldWireGoogleEmail
    StoredFieldDecisionKey => StoredFieldWireDecisionKey
    StoredFieldPlatform => StoredFieldWirePlatform
    StoredFieldAttestKeyId => StoredFieldWireAttestKeyId
  }
}

fn google_enrolment_refusal_wire(r: GoogleEnrolmentRefusal) -> GoogleEnrolmentRefusalWire {
  match r {
    GoogleEnrolmentTokenRefused { cause: _ } => GoogleRefusalTokenRefused
    GoogleEnrolmentAudienceNotExact => GoogleRefusalAudienceNotExact
    GoogleEnrolmentAuthorizedPartyNotAdmitted => GoogleRefusalAuthorizedPartyNotAdmitted
    GoogleEnrolmentEmailAbsent => GoogleRefusalEmailAbsent
    GoogleEnrolmentNotAnApprover { email: _ } => GoogleRefusalNotAnApprover
    GoogleEnrolmentSubjectMismatch { email: _ } => GoogleRefusalSubjectMismatch
    GoogleEnrolmentAttestationRefused { cause: _ } => GoogleRefusalAttestationRefused
    GoogleEnrolmentAttestationForOtherBytes => GoogleRefusalAttestationForOtherBytes
    GoogleEnrolmentAttestKeyMismatch => GoogleRefusalAttestKeyMismatch
    GoogleEnrolmentAndroidUnrealized => GoogleRefusalAndroidUnrealized
    GoogleEnrolmentRevokedKey => GoogleRefusalRevokedKey
    GoogleEnrolmentStoredMismatch { field: f } => GoogleRefusalStoredMismatch { field: stored_enrolment_field_wire(f: f) }
    GoogleEnrolmentStoreUnreadable { detail: _ } => GoogleRefusalStoreUnreadable
  }
}

fn google_enrolment_refused(r: GoogleEnrolmentRefusal) -> DeviceRouteResponse {
  DeviceRouteResponse {
    status: google_enrolment_refusal_status(r: r),
    body: google_enrolment_refusal_json(reason: google_enrolment_refusal_reason(r: r), kind: google_enrolment_refusal_wire(r: r)),
  }
}

// The App Attest attestation over the transcript of the SUBMITTED keys: the same bytes the token's
// nonce is checked against, so one fresh sign-in vouches for exactly one key pair.
fn attestation_for_request(r: GoogleEnrolmentRequest, app_id: NonEmptyStr, config: AppAttestVerifierConfig, observed_at: Timestamp, gate: DeviceCryptoGate) -> SidecarResult<AttestationVerification> {
  match base64_decode(s: r.attestation_b64 as String, variant: Standard) {
    Absent => SidecarAnswered { verification: AttestationRefused { cause: AttestationUndecodable { cause: "attestation_b64 is not base64" } } }
    Present { value: _ } =>
      match attestation_expectation_for(app_id: app_id, config: config, key_id: r.attest_key_id, client_data: google_enrolment_keys_transcript(k: google_enrolment_keys_of(r: r)), observed_at: observed_at) {
        Absent => SidecarAnswered { verification: AttestationRefused { cause: AttestationUndecodable { cause: "verifier unconfigured" } } }
        Present { value: e } => sidecar_attestation_verification(gate: gate, object_b64: r.attestation_b64, e: e)
      }
  }
}

fn google_enrolment_keys_of(r: GoogleEnrolmentRequest) -> GoogleEnrolmentKeys {
  GoogleEnrolmentKeys { platform: r.platform, decision_key: r.decision_key, attest_key_id: r.attest_key_id }
}

// THE BROKER'S OWN JWKS CACHE (ruling of clever-eagle-893, 2026-10-23: no second fetch path): the
// one cache layout of gunbc.auth.oidc_id_token_verification, rooted at the broker's managed
// directory instead of a dashboard instance's.
fn approval_jwks_cache_layout() -> JwksCacheLayout {
  JwksCacheLayout {
    dir: approval_jwks_cache_root as String as FilePath,
    file: join([approval_jwks_cache_root as String, "/", jwks_cache_file_name], ""),
  }
}

// A fresh id for the signature verification's scratch files: 128 bits of entropy as lowercase hex.
fn device_verify_id() -> NonEmptyStr? {
  match base64_decode(s: trim(Urandom.ReadBytes(count: 16).octets_b64), variant: Standard) {
    Absent => none
    Present { value: octets } =>
      if count(octets) != 16 { none }
      else {
        match base64_octets(values: octets) {
          QualifiedOctetsRefused { observed: _ } => none
          QualifiedOctetsReady { value: q } => Present { value: base16_encode_lower(octets: q) as NonEmptyStr }
        }
      }
  }
}

// THE NEW-DEVICE NOTICE, pushed to every enrolled approver device (gunbc.auth.approval_apns_publish
// new_device_push_notice). Sent only for a GoogleEnrolmentWrites, never a replay. An enrolment whose
// notice was not delivered is still written: the route answers 503 so the phone resends, the resend
// replays the same grant, and no second notice is sent -- the undelivered notice is named in the
// response, never swallowed. THE FIRST DEVICE HAS NOBODY TO TELL: no registered recipient (and no
// enrolment that failed to read) is a delivered notice, not a refusal, or the first enrolment could
// never complete; an enrolment that did not read is named, because it might have been the recipient.
fn publish_new_device_notice(notice: NewDeviceNotice) -> String?
  admit_callers: [
    decl_ref(module_path: "gunbc.auth.approval_device_routes", decl_name: "device_enrol_admit"),
  ]
{
  let pushed = notify_devices(targets: read_device_push_targets(), sender: read_apns_sender(), notice: new_device_push_notice(enrollment_id: notice.enrollment_id))
  match pushed {
    DeviceNotificationNoRecipient { unregistered: _, unreadable: ur } =>
      if length(ur) == 0 { none } else { Present { value: device_notification_sentence(n: pushed) } }
    DeviceNotificationNotAttempted { detail: _ } => Present { value: device_notification_sentence(n: pushed) }
    DeviceNotificationAttempted { outcomes: _, unregistered: _, unreadable: _ } =>
      if device_notification_reached_anyone(n: pushed) { none } else { Present { value: device_notification_sentence(n: pushed) } }
  }
}

fn device_enrol_response(body: String, process: ApprovalServingProcess) -> DeviceRouteResponse {
  match device_observed_at() {
    Absent => device_clock_refused()
    Present { value: now } =>
      match Clock.UnixSecs() {
        epoch_read =>
          match parse_int(s: trim(epoch_read.unix_secs)) {
            Absent => device_refused(status: 503, reason: "the clock's epoch reading refused, so the token verdict cannot be decided")
            Present { value: epoch } => device_enrol_response_at(realization: approval_device_crypto_realization, body: body, process: process, observed_at: now, epoch: epoch)
          }
      }
  }
}

fn device_enrol_grant(e: GoogleDeviceEnrollment) -> DeviceRouteResponse {
  DeviceRouteResponse { status: 200, body: enrolment_grant_json(g: EnrolmentGrant { enrollment_id: e.enrollment_id }) }
}

fn device_enrol_response_at(realization: DeviceCryptoRealization, body: String, process: ApprovalServingProcess, observed_at: Timestamp, epoch: Int) -> DeviceRouteResponse {
  match approval_write_admission(asker: process) {
    ApprovalWriteRefused { holder: h, asker: a } => device_refused(status: 503, reason: approval_write_refusal_reason(holder: h, asker: a) as String)
    ApprovalWriteAdmitted { writer: _ } =>
      match decode_google_enrolment_request(text: body) {
        WireRefused { at: a, cause: c } => device_refused(status: 400, reason: "enrolment request refused at " + (a as String) + ": " + (c as String))
        WireDecoded { value: r } =>
          match device_crypto_gate(r: realization) {
            DeviceCryptoGateRefused { status: st, reason: why } => device_refused(status: st, reason: why)
            admitted =>
              match verifier_expectations() {
                VerifierUnconfigured { missing: m } => device_refused(status: 503, reason: "the App Attest verifier is not configured: " + (m as String))
                VerifierReady { app_id: app_id, config: config } =>
                  match oidc_id_token_wire_decode(token: r.id_token as JwtCompactSerialization) {
                    OidcIdTokenWireRefused { reason: why } => device_refused(status: 400, reason: "the ID token did not decode: " + why)
                    OidcIdTokenWireDecoded { claims: claims, header: _, signing_input: _ } =>
                      match device_verify_id() {
                        Absent => device_refused(status: 503, reason: "the entropy draw for the token verification refused")
                        Present { value: verify_id } =>
                          device_enrol_admit(
                            r: r, claims: claims,
                            signature: oidc_id_token_signature_verify(layout: approval_jwks_cache_layout(), id_token: r.id_token as JwtCompactSerialization, now_epoch: epoch, verify_id: verify_id),
                            app_id: app_id, config: config, gate: admitted, observed_at: observed_at, epoch: epoch,
                          )
                      }
                  }
              }
          }
      }
  }
}

// The admission order is the plan's: token verdict (policy from the SUBMITTED keys), attestation over
// the same transcript, the subject pin's create-or-read, then the slot read and the model's
// admission. Nothing is written to the enrolment slot without the pin join, and a refused
// attestation writes nothing at all.
fn device_enrol_admit(r: GoogleEnrolmentRequest, claims: OidcIdTokenClaims, signature: OidcIdTokenSignature, app_id: NonEmptyStr, config: AppAttestVerifierConfig, gate: DeviceCryptoGate, observed_at: Timestamp, epoch: Int) -> DeviceRouteResponse {
  match admit_google_approver(claims: claims, signature: signature, keys: google_enrolment_keys_of(r: r), observed_at: NumericDateWholeSeconds { seconds: epoch }) {
    GoogleApproverRefused { cause: c } => google_enrolment_refused(r: c)
    GoogleApproverAdmitted { approver: approver } =>
      match attestation_for_request(r: r, app_id: app_id, config: config, observed_at: observed_at, gate: gate) {
        SidecarFailed { cause: why } => sidecar_failure_response(cause: why)
        SidecarAnswered { verification: AttestationRefused { cause: c } } => google_enrolment_refused(r: GoogleEnrolmentAttestationRefused { cause: c })
        SidecarAnswered { verification: attestation } =>
          match join_subject_pin(approver: approver, observed: create_or_read_subject_pin(root: approval_device_store_root, email: approver.email, subject: approver.subject)) {
            SubjectPinRefused { cause: c } => google_enrolment_refused(r: c)
            SubjectPinJoined { pinned: pinned } =>
              let slot = observe_google_enrolment(root: approval_device_store_root, enrollment_id: google_enrollment_id(subject: approver.subject, decision_key: r.decision_key))
              let admission = google_enrolment_admission(pinned: pinned, attestation: attestation, slot: slot, observed_at: observed_at)
              match admission {
                GoogleEnrolmentRefused { cause: c } => google_enrolment_refused(r: c)
                GoogleEnrolmentReplays { enrollment: e } => device_enrol_grant(e: e)
                GoogleEnrolmentWrites { enrollment: e } =>
                  match commit_google_enrolment(root: approval_device_store_root, enrollment: e) {
                    DeviceStoreSlotOccupied => device_refused(status: 409, reason: "the enrolment was created concurrently; resend to read it back")
                    DeviceStoreRefused { detail: d } => device_refused(status: 503, reason: d as String)
                    DeviceStoreWritten =>
                      match new_device_notice(a: admission) {
                        Absent => device_enrol_grant(e: e)
                        Present { value: notice } =>
                          match publish_new_device_notice(notice: notice) {
                            Absent => device_enrol_grant(e: e)
                            Present { value: undelivered } => device_refused(status: 503, reason: "enrolled, but the new-device notice was not delivered (resend to read the enrolment back): " + undelivered)
                          }
                      }
                  }
              }
          }
      }
  }
}

// ── POST /approve/device/redeem ──────────────────────────────────────────────────────────────
// EXHAUSTIVE over the closed outcome (review 69672 of gunbc#12000: a wildcard let a new arm inherit
// 403 silently and made the claim over this map non-discriminating). A new outcome is a compile
// refusal here until someone says what it answers.
fn redemption_status(o: DeviceRedemptionOutcome) -> HttpStatus {
  match o {
    DeviceRedeemed { decision: _ } => 200
    DeviceAlreadyDecided { decision: _ } => 200
    DeviceEnrollmentUnknown => 404
    DeviceEnrollmentRevoked { enrollment_id: _ } => 403
    DeviceEnrollmentNotAnApprover { email: _ } => 403
    DeviceEscalationNotFiled { escalation_id: _ } => 404
    DeviceStoreUnreadable { detail: _ } => 503
    DeviceKeyringUnavailable { cause: _ } => 503
    DeviceSignedForAnotherRequest { field: _ } => 403
    DeviceChallengeExpired { expires_at: _, observed_at: _ } => 403
    DeviceChallengeNotIssuedHere => 403
    DeviceCapabilityTagMalformed => 400
    DeviceCapabilityRefused { cause: _ } => 403
    DeviceSignatureRefused { verification: _ } => 403
    DevicePlatformProofRefused { cause: _ } => 403
    DevicePlatformProofForOtherBytes => 403
    DevicePlatformProofWrongKey => 403
    DevicePlatformUnrealized => 501
    DeviceLostTheRace => 409
    DeviceCommitRefused { detail: _ } => 503
  }
}

// The signature verdict for a redemption: the seam's verdict under the enrolment's decision key
// over exactly the signing input's framed bytes. With no active enrolment there is no key to
// verify under, and the fold refuses on the slot before it reads this value; SignatureInvalid is
// the honest carrier for "not verified", never a success.
fn redemption_signature(slot: GoogleEnrolmentSlot, r: SignedRedemption, gate: DeviceCryptoGate) -> SidecarResult<SignatureVerification> {
  match slot {
    GoogleEnrolmentActive { enrollment: e } => sidecar_signature_verification(gate: gate, key: e.decision_key, signature: r.signature, message: device_redemption_signing_input(i: r.signing_input))
    GoogleEnrolmentRevoked { enrollment: _, revoked_at: _ } => SidecarAnswered { verification: SignatureInvalid { suite: EcdsaP256Sha256 } }
    GoogleEnrolmentAbsent => SidecarAnswered { verification: SignatureInvalid { suite: EcdsaP256Sha256 } }
    GoogleEnrolmentUnreadable { detail: _ } => SidecarAnswered { verification: SignatureInvalid { suite: EcdsaP256Sha256 } }
  }
}

fn redemption_assertion(slot: GoogleEnrolmentSlot, r: SignedRedemption, app_id: NonEmptyStr, config: AppAttestVerifierConfig, gate: DeviceCryptoGate) -> SidecarResult<AssertionVerification> {
  match slot {
    GoogleEnrolmentActive { enrollment: e } =>
      match r.platform_proof {
        AndroidDecisionKeyOnly => SidecarAnswered { verification: AssertionRefused { cause: AssertionUndecodable { cause: "no platform proof verifier for Android" } } }
        IosAppAttestAssertion { assertion_b64: b } => assertion_for_enrollment(enrollment: e, assertion_b64: b, client_data: device_redemption_signing_input(i: r.signing_input), app_id: app_id, config: config, gate: gate)
      }
    GoogleEnrolmentRevoked { enrollment: _, revoked_at: _ } => SidecarAnswered { verification: AssertionRefused { cause: AssertionUndecodable { cause: "no active enrolment" } } }
    GoogleEnrolmentAbsent => SidecarAnswered { verification: AssertionRefused { cause: AssertionUndecodable { cause: "no active enrolment" } } }
    GoogleEnrolmentUnreadable { detail: _ } => SidecarAnswered { verification: AssertionRefused { cause: AssertionUndecodable { cause: "no active enrolment" } } }
  }
}

fn device_redeem_response(body: String, process: ApprovalServingProcess) -> DeviceRouteResponse {
  match device_observed_at() {
    Absent => device_clock_refused()
    Present { value: now } => device_redeem_response_at(realization: approval_device_crypto_realization, body: body, process: process, observed_at: now)
  }
}

fn device_redeem_response_at(realization: DeviceCryptoRealization, body: String, process: ApprovalServingProcess, observed_at: Timestamp) -> DeviceRouteResponse {
  match approval_write_admission(asker: process) {
    ApprovalWriteRefused { holder: h, asker: a } => device_refused(status: 503, reason: approval_write_refusal_reason(holder: h, asker: a) as String)
    ApprovalWriteAdmitted { writer: _ } =>
      match decode_signed_redemption(text: body) {
        WireRefused { at: a, cause: c } => device_refused(status: 400, reason: "redemption refused at " + (a as String) + ": " + (c as String))
        WireDecoded { value: r } =>
          match device_crypto_gate(r: realization) {
            DeviceCryptoGateRefused { status: st, reason: why } => device_refused(status: st, reason: why)
            admitted =>
              match verifier_expectations() {
                VerifierUnconfigured { missing: m } => device_refused(status: 503, reason: "the App Attest verifier is not configured: " + (m as String))
                VerifierReady { app_id: app_id, config: config } => {
                  let slot = observe_google_enrolment(root: approval_device_store_root, enrollment_id: r.signing_input.enrollment_id)
                  match redemption_signature(slot: slot, r: r, gate: admitted) {
                    SidecarFailed { cause: why } => sidecar_failure_response(cause: why)
                    SidecarAnswered { verification: signature } =>
                      match redemption_assertion(slot: slot, r: r, app_id: app_id, config: config, gate: admitted) {
                        SidecarFailed { cause: why } => sidecar_failure_response(cause: why)
                        SidecarAnswered { verification: assertion } => {
                          let outcome = redeem_device_over_store(
                            root: approval_decision_store_root,
                            keyring: read_approval_keyring(),
                            enrolment: slot,
                            signed: r.signing_input,
                            signature: signature,
                            assertion: assertion,
                            observed_at: observed_at,
                          )
                          DeviceRouteResponse { status: redemption_status(o: outcome), body: redemption_response_json(r: redemption_response_of(o: outcome)) }
                        }
                      }
                  }
                }
              }
          }
      }
  }
}

// ── POST /approve/device/pending ─────────────────────────────────────────────────────────────
fn device_pending_response(body: String) -> DeviceRouteResponse {
  match device_observed_at() {
    Absent => device_clock_refused()
    Present { value: now } => device_pending_response_at(realization: approval_device_crypto_realization, body: body, observed_at: now)
  }
}

fn device_pending_response_at(realization: DeviceCryptoRealization, body: String, observed_at: Timestamp) -> DeviceRouteResponse {
  match decode_read_request(text: body) {
    WireRefused { at: a, cause: c } => device_refused(status: 400, reason: "read refused at " + (a as String) + ": " + (c as String))
    WireDecoded { value: auth } =>
      match admit_device_read(realization: realization, auth: auth, client_data: device_read_client_data(path: approval_device_pending_path, enrollment_id: auth.enrollment_id, requested_at: auth.requested_at), observed_at: observed_at) {
        DeviceReadRefused { status: s, reason: r } => device_refused(status: s, reason: r)
        DeviceReadAdmitted { enrollment: _ } =>
          match pending_escalations(root: approval_decision_store_root, observed_at: observed_at) {
            PendingEscalationsRefused { detail: d } => device_refused(status: 503, reason: d)
            PendingEscalationsListed { pending: rows, unreadable: u } =>
              if count(u) > 0 { device_refused(status: 503, reason: "an escalation slot could not be read: " + join(map(u, x => x as String), ", ")) }
              else { DeviceRouteResponse { status: 200, body: pending_list_json(rows: map(rows, r => PendingApproval { escalation_id: r.escalation_id, request_revision: r.request_revision })) } }
          }
      }
  }
}

// ── POST /approve/device/requests/<segment> ──────────────────────────────────────────────────
data approval_redemption_challenge_window: Second = second(count: 300)

type ChallengeIssuance
  = ChallengeIssued { challenge: RedemptionChallenge }
  | ChallengeIssuanceRefused { detail: String }

// The stateless challenge: the MAC under the capability key over redemption_challenge_message,
// exactly what device_redemption_admission recomputes to check it.
fn issue_redemption_challenge(key: MacKey, request: StoredApprovalRequest, enrollment_id: NonEmptyStr, observed_at: Timestamp) -> ChallengeIssuance {
  let expires_at = device_instant_plus(t: observed_at, s: approval_redemption_challenge_window)
  match mac_sign(key: key, message: redemption_challenge_message(escalation_id: request.escalation_id, request_revision: request.request_revision, enrollment_id: enrollment_id, expires_at: expires_at)) {
    MacKeyMaterialNotHex { key_id: _ } => ChallengeIssuanceRefused { detail: "the capability key material is not hex" }
    MacSigned { tag: t } => ChallengeIssued { challenge: RedemptionChallenge { expires_at: expires_at, nonce_hex: t.hex } }
  }
}

fn verb_capability_for(key: MacKey, request: StoredApprovalRequest, approve: Bool) -> VerbCapability? {
  let claims = claims_for(request: request, decision: if approve { ProposeApprove } else { ProposeDeny })
  match issue_capability(claims: claims, key: key) {
    CapabilityIssuanceRefused { cause: _ } => none
    CapabilityIssued { capability: c } => Present { value: VerbCapability { capability_text: approval_capability_signing_input(c: claims), capability_tag_b64url: c.tag_b64url } }
  }
}

fn device_request_response(body: String, segment: String) -> DeviceRouteResponse {
  match device_observed_at() {
    Absent => device_clock_refused()
    Present { value: now } => device_request_response_at(realization: approval_device_crypto_realization, body: body, segment: segment, observed_at: now)
  }
}

fn device_request_response_at(realization: DeviceCryptoRealization, body: String, segment: String, observed_at: Timestamp) -> DeviceRouteResponse {
  match decode_path_segment(presented: segment) {
    PathSegmentMalformed { cause: c } => device_refused(status: 400, reason: "request path: " + (c as String))
    PathSegmentNonCanonical { presented: _, canonical: _ } => device_refused(status: 400, reason: "request path segment is not canonical")
    PathSegmentDecoded { identity: escalation_id } =>
      match decode_read_request(text: body) {
        WireRefused { at: a, cause: c } => device_refused(status: 400, reason: "read refused at " + (a as String) + ": " + (c as String))
        WireDecoded { value: auth } =>
          match admit_device_read(realization: realization, auth: auth, client_data: device_read_client_data(path: device_request_path(escalation_id: escalation_id), enrollment_id: auth.enrollment_id, requested_at: auth.requested_at), observed_at: observed_at) {
            DeviceReadRefused { status: s, reason: r } => device_refused(status: s, reason: r)
            DeviceReadAdmitted { enrollment: e } =>
              match observe_escalation(root: approval_decision_store_root, escalation_id: escalation_id) {
                EscalationNotFiled => device_refused(status: 404, reason: "no such escalation")
                EscalationDecided { decision: _ } => device_refused(status: 409, reason: "the escalation is already decided")
                EscalationUnreadable { detail: d } => device_refused(status: 503, reason: d as String)
                EscalationPending { request: req } =>
                  match read_approval_keyring() {
                    ApprovalKeyringRefused { cause: _ } => device_refused(status: 503, reason: "the capability keyring is unavailable")
                    ApprovalKeyLoaded { key: key } =>
                      match issue_redemption_challenge(key: key, request: req, enrollment_id: e.enrollment_id, observed_at: observed_at) {
                        ChallengeIssuanceRefused { detail: d } => device_refused(status: 503, reason: d)
                        ChallengeIssued { challenge: ch } =>
                          match verb_capability_for(key: key, request: req, approve: true) {
                            Absent => device_refused(status: 503, reason: "the approve capability could not be issued")
                            Present { value: approve } =>
                              match verb_capability_for(key: key, request: req, approve: false) {
                                Absent => device_refused(status: 503, reason: "the deny capability could not be issued")
                                Present { value: deny } =>
                                  DeviceRouteResponse { status: 200, body: fetched_request_json(f: FetchedRequest {
                                    escalation_id: req.escalation_id, request_revision: req.request_revision,
                                    stored_request_text: stored_request_json(r: req) as NonEmptyStr,
                                    challenge: ch, approve: approve, deny: deny,
                                  }) }
                              }
                          }
                      }
                  }
              }
          }
      }
  }
}

// ── POST /approve/device/enrollments/<segment> ───────────────────────────────────────────────
// The readback authenticates under the enrolment it asks about, so a revoked enrolment answers
// through the read gate's refusal, and an unknown one is 404 before any verification.
fn device_enrollment_readback_response(body: String, segment: String) -> DeviceRouteResponse {
  match device_observed_at() {
    Absent => device_clock_refused()
    Present { value: now } => device_enrollment_readback_response_at(realization: approval_device_crypto_realization, body: body, segment: segment, observed_at: now)
  }
}

fn device_enrollment_readback_response_at(realization: DeviceCryptoRealization, body: String, segment: String, observed_at: Timestamp) -> DeviceRouteResponse {
  match decode_path_segment(presented: segment) {
    PathSegmentMalformed { cause: c } => device_refused(status: 400, reason: "enrollment path: " + (c as String))
    PathSegmentNonCanonical { presented: _, canonical: _ } => device_refused(status: 400, reason: "enrollment path segment is not canonical")
    PathSegmentDecoded { identity: enrollment_id } =>
      match decode_read_request(text: body) {
        WireRefused { at: a, cause: c } => device_refused(status: 400, reason: "read refused at " + (a as String) + ": " + (c as String))
        WireDecoded { value: auth } =>
          if auth.enrollment_id != enrollment_id { device_refused(status: 403, reason: "the read speaks for another enrolment") }
          else {
            match admit_device_read(realization: realization, auth: auth, client_data: device_read_client_data(path: device_enrollment_path(enrollment_id: enrollment_id), enrollment_id: auth.enrollment_id, requested_at: auth.requested_at), observed_at: observed_at) {
              DeviceReadRefused { status: s, reason: r } => device_refused(status: s, reason: r)
              DeviceReadAdmitted { enrollment: _ } =>
                match enrolment_readback_of(slot: observe_google_enrolment(root: approval_device_store_root, enrollment_id: enrollment_id)) {
                  Absent => device_refused(status: 404, reason: "no such enrolment")
                  Present { value: rb } => DeviceRouteResponse { status: 200, body: enrolment_readback_json(r: rb) }
                }
            }
          }
      }
  }
}

// ── POST /approve/device/push ────────────────────────────────────────────────────────────────
fn device_push_update_response(body: String, process: ApprovalServingProcess) -> DeviceRouteResponse {
  match device_observed_at() {
    Absent => device_clock_refused()
    Present { value: now } => device_push_update_response_at(realization: approval_device_crypto_realization, body: body, process: process, observed_at: now)
  }
}

fn device_push_update_response_at(realization: DeviceCryptoRealization, body: String, process: ApprovalServingProcess, observed_at: Timestamp) -> DeviceRouteResponse {
  match approval_write_admission(asker: process) {
    ApprovalWriteRefused { holder: h, asker: a } => device_refused(status: 503, reason: approval_write_refusal_reason(holder: h, asker: a) as String)
    ApprovalWriteAdmitted { writer: _ } =>
      match decode_push_update_request(text: body) {
        WireRefused { at: a, cause: c } => device_refused(status: 400, reason: "push update refused at " + (a as String) + ": " + (c as String))
        WireDecoded { value: r } =>
          match admit_device_read(realization: realization, auth: r.auth, client_data: device_push_update_client_data(enrollment_id: r.auth.enrollment_id, requested_at: r.auth.requested_at, push: r.push), observed_at: observed_at) {
            DeviceReadRefused { status: s, reason: rr } => device_refused(status: s, reason: rr)
            DeviceReadAdmitted { enrollment: e } =>
              match commit_push_registration(root: approval_device_store_root, enrollment_id: e.enrollment_id, push: r.push) {
                PushRegistrationRefused { detail: d } => device_refused(status: 503, reason: "push registration not stored: " + (d as String))
                PushRegistrationRaced => device_refused(status: 503, reason: "a concurrent push update for this enrolment won; present the token again")
                PushRegistrationWritten => DeviceRouteResponse { status: 200, body: serialize_json(v: json_object(members: [json_kv(key: "stored", value: json_string(s: e.enrollment_id as String))])) }
                PushRegistrationUnchanged => DeviceRouteResponse { status: 200, body: serialize_json(v: json_object(members: [json_kv(key: "stored", value: json_string(s: e.enrollment_id as String))])) }
              }
          }
      }
  }
}

// ── GET /approve/devices and POST /approve/devices/revoke/{id} ───────────────────────────────
// THE OPERATOR'S TWO ROUTES (ruling of clever-eagle-893, 2026-10-23). The broker is the store's sole
// writer, so it serves them, and the principal is the Tailscale identity against approval_operator_login
// -- the same gate the capability redemption uses -- not a dashboard session. The gate is honest about
// what is attributed: IdentityHeaderTrustEstablished is minted by nothing until peer attribution
// lands (approval_identity_attribution_frontier), so these routes REFUSE in production until then.
// Revoke additionally passes the single-writer gate.
fn device_operator_refusal(presented: TailnetIdentity) -> DeviceRouteResponse? {
  match approval_identity_trust {
    IdentityHeaderTrustNotEstablished { blocker: b } => Present { value: device_refused(status: 503, reason: "the operator identity is not attributed: " + (b as String)) }
    IdentityHeaderUnattributed { residual: r } => Present { value: device_refused(status: 503, reason: "the operator identity is not attributed: " + (r as String)) }
    IdentityHeaderTrustEstablished { evidence: _ } =>
      match match_tailnet_identity(presented: presented, expected: approval_operator_login) {
        IdentityMatches { login: _ } => none
        IdentityMismatch { presented: p, expected: e } => Present { value: device_refused(status: 403, reason: identity_match_reason(m: IdentityMismatch { presented: p, expected: e })) }
        IdentityMissing { expected: e } => Present { value: device_refused(status: 403, reason: identity_match_reason(m: IdentityMissing { expected: e })) }
      }
  }
}

fn device_listing_row_json(slot: GoogleEnrolmentSlot) -> String {
  match slot {
    GoogleEnrolmentActive { enrollment: e } => device_listing_member(e: e, standing: "active")
    GoogleEnrolmentRevoked { enrollment: e, revoked_at: _ } => device_listing_member(e: e, standing: "revoked")
    GoogleEnrolmentAbsent => ""
    GoogleEnrolmentUnreadable { detail: _ } => ""
  }
}

fn device_listing_member(e: GoogleDeviceEnrollment, standing: String) -> String {
  serialize_json(v: json_object(members: [
    json_kv(key: "enrollment_id", value: json_string(s: e.enrollment_id as String)),
    json_kv(key: "google_email", value: json_string(s: e.google_email as String)),
    json_kv(key: "attest_key_id", value: json_string(s: device_attest_key_of(e: e))),
    json_kv(key: "enrolled_at", value: json_string(s: e.enrolled_at)),
    json_kv(key: "standing", value: json_string(s: standing)),
  ]))
}

fn device_attest_key_of(e: GoogleDeviceEnrollment) -> String {
  match e.evidence {
    IosAttestedAppInstance { attest_key_id: k, attest_public_key_b64url: _, receipt_b64: _ } => k as String
    AndroidAttestedDecisionKey => ""
  }
}

fn device_list_response(presented: TailnetIdentity) -> DeviceRouteResponse {
  match device_operator_refusal(presented: presented) {
    Present { value: refused } => refused
    Absent =>
      match list_google_enrolments(root: approval_device_store_root) {
        GoogleEnrolmentListingRefused { detail: d } => device_refused(status: 503, reason: d as String)
        GoogleEnrolmentsListed { slots: slots } =>
          DeviceRouteResponse { status: 200, body: "[" + join(filter(map(slots, s => device_listing_row_json(slot: s)), r => r != ""), ",") + "]" }
      }
  }
}

fn device_revoke_response(presented: TailnetIdentity, segment: String, process: ApprovalServingProcess) -> DeviceRouteResponse {
  match device_operator_refusal(presented: presented) {
    Present { value: refused } => refused
    Absent =>
      match approval_write_admission(asker: process) {
        ApprovalWriteRefused { holder: h, asker: a } => device_refused(status: 503, reason: approval_write_refusal_reason(holder: h, asker: a) as String)
        ApprovalWriteAdmitted { writer: _ } =>
          match decode_path_segment(presented: segment) {
            PathSegmentMalformed { cause: c } => device_refused(status: 400, reason: "enrollment path: " + (c as String))
            PathSegmentNonCanonical { presented: _, canonical: _ } => device_refused(status: 400, reason: "enrollment path segment is not canonical")
            PathSegmentDecoded { identity: enrollment_id } =>
              match device_observed_at() {
                Absent => device_clock_refused()
                Present { value: now } =>
                  match revoke_google_enrolment(root: approval_device_store_root, slot: observe_google_enrolment(root: approval_device_store_root, enrollment_id: enrollment_id), revoked_at: now) {
                    DeviceStoreWritten => DeviceRouteResponse { status: 200, body: "{\"revoked\":true}" }
                    DeviceStoreSlotOccupied => device_refused(status: 409, reason: "the enrolment changed concurrently; read the list and retry")
                    DeviceStoreRefused { detail: d } => device_refused(status: 409, reason: d as String)
                  }
              }
          }
      }
  }
}
