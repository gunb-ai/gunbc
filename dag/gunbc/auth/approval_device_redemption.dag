// ── What this module is ──────────────────────────────────────────────────────────────────────
// The protocol between the roadmap server and the operator's phone for redeeming an approval with
// a device-bound, biometric-gated signature: one protocol, platform realizations beside it. This
// module is the MODEL; extdeps.apple.* and extdeps.google/android.* model the upstream interfaces.
//
// WHY A DEVICE SIGNATURE. The loopback deployment cannot attribute Tailscale-User-Login to the proxy
// (gunbc.auth.approval_decision_store approval_identity_attribution_frontier), so a capability alone
// could only ever have recorded its bearer. A signature under an enrolled key the enclave (or
// Keystore) releases only on the operator's biometric attributes the decision to that enrolment
// without trusting anything on the socket.
//
// THIS IS THE ONE REDEMPTION ROUTE (ruling gunbc.design_ruling
// one_approval_route_for_every_privileged_action). The bearer route that redeemed a capability
// alone -- gunbc.auth.approval_broker redeem_capability behind POST /approve/{capability}, its link
// delivered by ntfy -- was deleted in the device cutover, together with the ntfy publish and the
// header arms that let a record name "the bearer of capability ...". The cutover's own frontiers
// (gunbc.auth.approval_device_cutover_frontier, gunbc.auth.approval_device_routes_frontier) were
// deleted with it and are replaced by the reading they demanded, taken in the Approve app on the
// operator's phone: escalation
// gcp-iam-bootstrap-delta-b6408304fcc2908fa37769be958b1b6555902f00244b91d0b7a25994fb14f1e3-run-40767618826-attempt-1,
// decided_by brian@gunb.ai at 2026-10-28T21:30:31Z, read back from the decision store record
// /var/lib/gunbc/approvals/<escalation_id>.2 on srv1. redeem_device_over_store is
// the one-off approved access redemption authority: every admitted redemption names an enrolled
// Google login, and a disclosed capability admits nothing without the enrolled device.
//
// ENROLMENT IS GOOGLE SIGN-IN (ruling gunbc.design_ruling approval_enrolment_is_google_sign_in):
// the enrolment and the admission that mints it are gunbc.auth.approval_google_enrolment's, and this
// module only STORES and READS them. There is no enrolment code and no issuing verb.
//
// VERIFIED FACTS ARE SOLE-CONSTRUCTED. Every value that stands for "this was checked" -- a verified
// enrolment, an admitted redemption -- is minted by exactly one fold, and every effect that depends
// on it (enrolment commit, decision commit) takes that value and nothing looser. A caller cannot
// reach the decision commit with raw claims and a login it chose.

// THE DECISION KEY'S ACCESS POLICY, one fact the iOS realization creates the key under: a changed
// biometric set invalidates it, so a face added to the operator's phone inherits no authority.
// THE DECISION KEY'S ACCESS POLICY, one fact the iOS realization creates the key under: a changed
// biometric set invalidates it, so a face added to the operator's phone inherits no authority.
data approval_decision_key_access_policy: EnclaveKeyAccessPolicy = BiometryCurrentSet

// ── Push provider outcome ────────────────────────────────────────────────────────────────────
// Named for what a provider can establish: it ACCEPTED the message. Not delivered, not displayed,
// never consent. retryable is Apple's reading of its own status, not a policy here.
type PushProvider
  = ProviderApns
  | ProviderFcm

type PushProviderOutcome
  = PushProviderAccepted { provider: PushProvider, receipt: NonEmptyStr }
  | PushProviderRefused { provider: PushProvider, status: Int, detail: String, retryable: Bool }
  | PushRegistrationInvalid { provider: PushProvider, detail: String }
  | PushProviderUnreached { provider: PushProvider, cause: String }
  | PushProviderUndecodable { provider: PushProvider, status: Int, cause: String }

fn apns_refusal_retryable(c: ApnsRefusalClass) -> Bool {
  match c {
    ApnsBadRequest => false
    ApnsAuthenticationRefused => false
    ApnsBadPath => false
    ApnsBadMethod => false
    ApnsTokenUnregistered => false
    ApnsPayloadTooLarge => false
    ApnsTooManyRequests => true
    ApnsServerError => true
    ApnsServiceUnavailable => true
    ApnsStatusUnlisted { status: _ } => false
  }
}

// APNs 410 is the one refusal that is a REGISTRATION fact: the token is dead and will never work,
// so the remedy is re-registration, not retry.
fn push_outcome_of_apns(o: ApnsSendOutcome) -> PushProviderOutcome {
  match o {
    ApnsAccepted { apns_id } => PushProviderAccepted { provider: ProviderApns, receipt: apns_id }
    ApnsRefused { status, class, reason } =>
      match class {
        ApnsTokenUnregistered => PushRegistrationInvalid { provider: ProviderApns, detail: reason }
        ApnsBadRequest => PushProviderRefused { provider: ProviderApns, status: status, detail: reason, retryable: apns_refusal_retryable(c: class) }
        ApnsAuthenticationRefused => PushProviderRefused { provider: ProviderApns, status: status, detail: reason, retryable: apns_refusal_retryable(c: class) }
        ApnsBadPath => PushProviderRefused { provider: ProviderApns, status: status, detail: reason, retryable: apns_refusal_retryable(c: class) }
        ApnsBadMethod => PushProviderRefused { provider: ProviderApns, status: status, detail: reason, retryable: apns_refusal_retryable(c: class) }
        ApnsPayloadTooLarge => PushProviderRefused { provider: ProviderApns, status: status, detail: reason, retryable: apns_refusal_retryable(c: class) }
        ApnsTooManyRequests => PushProviderRefused { provider: ProviderApns, status: status, detail: reason, retryable: apns_refusal_retryable(c: class) }
        ApnsServerError => PushProviderRefused { provider: ProviderApns, status: status, detail: reason, retryable: apns_refusal_retryable(c: class) }
        ApnsServiceUnavailable => PushProviderRefused { provider: ProviderApns, status: status, detail: reason, retryable: apns_refusal_retryable(c: class) }
        ApnsStatusUnlisted { status: _ } => PushProviderRefused { provider: ProviderApns, status: status, detail: reason, retryable: apns_refusal_retryable(c: class) }
      }
    ApnsUnreached { cause } => PushProviderUnreached { provider: ProviderApns, cause: cause }
    ApnsUndecodable { status, cause } => PushProviderUndecodable { provider: ProviderApns, status: status, cause: cause }
  }
}

// ── Redemption admission ─────────────────────────────────────────────────────────────────────
// THE ONE REDEMPTION FOLD over the store's parts: the slot read (observe_escalation), claims
// (claims_for), capability verification (verify_capability) and generation-2 commit
// (commit_broker_decision). What ADMITS is a verified device signature and platform proof under a
// verified, active enrolment of an approver, and decided_by names that enrolment's Google login.
type DeviceRedemptionOutcome
  = DeviceRedeemed { decision: BrokerDecision }
  | DeviceAlreadyDecided { decision: BrokerDecision }
  | DeviceEnrollmentUnknown
  | DeviceEnrollmentRevoked { enrollment_id: NonEmptyStr }
  | DeviceEnrollmentNotAnApprover { email: NonEmptyStr }
  | DeviceEscalationNotFiled { escalation_id: NonEmptyStr }
  | DeviceStoreUnreadable { detail: NonEmptyStr }
  | DeviceKeyringUnavailable { cause: ApprovalKeyringRefusal }
  | DeviceSignedForAnotherRequest { field: NonEmptyStr }
  | DeviceChallengeExpired { expires_at: Timestamp, observed_at: Timestamp }
  | DeviceChallengeNotIssuedHere
  | DeviceCapabilityTagMalformed
  | DeviceCapabilityRefused { cause: CapabilityRefusal }
  | DeviceSignatureRefused { verification: SignatureVerification }
  | DevicePlatformProofRefused { cause: AssertionRefusal }
  | DevicePlatformProofForOtherBytes
  | DevicePlatformProofWrongKey
  | DevicePlatformUnrealized
  | DeviceLostTheRace
  | DeviceCommitRefused { detail: NonEmptyStr }

// THE OUTCOME'S WIRE NAME, one total match over the sum: the app branches on this word, so it is
// derived from the arm and never typed beside it -- renaming or splitting an arm changes the word
// here, and the envelope fixture built through redemption_response_of changes with it.
fn device_redemption_outcome_wire(o: DeviceRedemptionOutcome) -> NonEmptyStr {
  match o {
    DeviceRedeemed { decision: _ } => "DeviceRedeemed" as NonEmptyStr
    DeviceAlreadyDecided { decision: _ } => "DeviceAlreadyDecided" as NonEmptyStr
    DeviceEnrollmentUnknown => "DeviceEnrollmentUnknown" as NonEmptyStr
    DeviceEnrollmentRevoked { enrollment_id: _ } => "DeviceEnrollmentRevoked" as NonEmptyStr
    DeviceEnrollmentNotAnApprover { email: _ } => "DeviceEnrollmentNotAnApprover" as NonEmptyStr
    DeviceEscalationNotFiled { escalation_id: _ } => "DeviceEscalationNotFiled" as NonEmptyStr
    DeviceStoreUnreadable { detail: _ } => "DeviceStoreUnreadable" as NonEmptyStr
    DeviceKeyringUnavailable { cause: _ } => "DeviceKeyringUnavailable" as NonEmptyStr
    DeviceSignedForAnotherRequest { field: _ } => "DeviceSignedForAnotherRequest" as NonEmptyStr
    DeviceChallengeExpired { expires_at: _, observed_at: _ } => "DeviceChallengeExpired" as NonEmptyStr
    DeviceChallengeNotIssuedHere => "DeviceChallengeNotIssuedHere" as NonEmptyStr
    DeviceCapabilityTagMalformed => "DeviceCapabilityTagMalformed" as NonEmptyStr
    DeviceCapabilityRefused { cause: _ } => "DeviceCapabilityRefused" as NonEmptyStr
    DeviceSignatureRefused { verification: _ } => "DeviceSignatureRefused" as NonEmptyStr
    DevicePlatformProofRefused { cause: _ } => "DevicePlatformProofRefused" as NonEmptyStr
    DevicePlatformProofForOtherBytes => "DevicePlatformProofForOtherBytes" as NonEmptyStr
    DevicePlatformProofWrongKey => "DevicePlatformProofWrongKey" as NonEmptyStr
    DevicePlatformUnrealized => "DevicePlatformUnrealized" as NonEmptyStr
    DeviceLostTheRace => "DeviceLostTheRace" as NonEmptyStr
    DeviceCommitRefused { detail: _ } => "DeviceCommitRefused" as NonEmptyStr
  }
}

// The redeem route's answer, built from the outcome and nothing else.
fn redemption_response_of(o: DeviceRedemptionOutcome) -> RedemptionResponse {
  RedemptionResponse { outcome: device_redemption_outcome_wire(o: o), message: device_redemption_reason(o: o) }
}

fn device_redemption_reason(o: DeviceRedemptionOutcome) -> NonEmptyStr {
  match o {
    DeviceRedeemed { decision: d } => match d {
      BrokerApproved { escalation_id: _, revision: _, decided_by: _, decided_at: _, obligation: _ } => "approved and recorded" as NonEmptyStr
      BrokerDenied { escalation_id: _, revision: _, decided_by: _, decided_at: _, reason: _ } => "denied and recorded" as NonEmptyStr
    }
    DeviceAlreadyDecided { decision: _ } => "this escalation was already decided; nothing changed" as NonEmptyStr
    DeviceEnrollmentUnknown => "this device is not enrolled" as NonEmptyStr
    DeviceEnrollmentRevoked { enrollment_id: _ } => "this device's enrolment has been revoked" as NonEmptyStr
    DeviceEnrollmentNotAnApprover { email: _ } => "the account this device enrolled under is not an approver" as NonEmptyStr
    DeviceEscalationNotFiled { escalation_id: _ } => "no request is filed under this escalation" as NonEmptyStr
    DeviceStoreUnreadable { detail: d } => d
    DeviceKeyringUnavailable { cause: _ } => "the server's capability key is unavailable" as NonEmptyStr
    DeviceSignedForAnotherRequest { field: f } => join(["the signed bytes do not match the stored request: ", f as String], "") as NonEmptyStr
    DeviceChallengeExpired { expires_at: _, observed_at: _ } => "the challenge expired; reopen the request and decide again" as NonEmptyStr
    DeviceChallengeNotIssuedHere => "the challenge was not issued by this server" as NonEmptyStr
    DeviceCapabilityTagMalformed => "the capability tag is not its canonical base64url spelling" as NonEmptyStr
    DeviceCapabilityRefused { cause: c } => capability_refusal_reason(r: c) as NonEmptyStr
    DeviceSignatureRefused { verification: _ } => "the device signature did not verify under the enrolled key" as NonEmptyStr
    DevicePlatformProofRefused { cause: _ } => "the app-instance assertion did not verify" as NonEmptyStr
    DevicePlatformProofForOtherBytes => "the app-instance assertion was made over different bytes" as NonEmptyStr
    DevicePlatformProofWrongKey => "the app-instance assertion is not from the enrolled app instance" as NonEmptyStr
    DevicePlatformUnrealized => "this platform has no verifier yet" as NonEmptyStr
    DeviceLostTheRace => "another decision landed first; this one changed nothing" as NonEmptyStr
    DeviceCommitRefused { detail: d } => d
  }
}

// THE ADMITTED REDEMPTION: minted only by device_redemption_admission, consumed only by
// commit_admitted_redemption. It carries the claims the capability authenticated and the login the
// verified enrolment names -- nothing a caller of the commit could supply.
type AdmittedDeviceRedemption sole_constructor {
  claims: ApprovalCapabilityClaims
  enrollment_id: NonEmptyStr
  decided_by: NonEmptyStr
  execute_by: Timestamp
  observed_at: Timestamp
}

type DeviceAdmission
  = DeviceAdmitted { admitted: AdmittedDeviceRedemption }
  | DeviceNotAdmitted { outcome: DeviceRedemptionOutcome }

// The server's own rendering of what the device must have signed, from the STORED request.
fn signing_field_disagreement(
  signed: DeviceRedemptionSigningInput,
  enrollment: GoogleDeviceEnrollment,
  request: StoredApprovalRequest,
  capability_text: NonEmptyStr,
) -> NonEmptyStr? {
  if signed.audience != approval_device_audience { Present { value: "audience" } }
  else if signed.enrollment_id != enrollment.enrollment_id { Present { value: "enrollment_id" } }
  else if signed.escalation_id != request.escalation_id { Present { value: "escalation_id" } }
  else if signed.request_revision != request.request_revision { Present { value: "request_revision" } }
  else if (signed.stored_request_text as String) != stored_request_json(r: request) { Present { value: "stored_request_text" } }
  else if signed.capability_text != capability_text { Present { value: "capability_text" } }
  else { none }
}

// THE SIGNATURE JOINS only when the verified evidence names the ENROLLED key and EXACTLY the bytes
// this server rendered. A verified signature under another key, or over another message, admits
// nothing.
fn device_signature_joins(signature: SignatureVerification, enrollment: GoogleDeviceEnrollment, signed_bytes: NonEmptyStr) -> Bool {
  match signature {
    SignatureVerified { verified: v } =>
      v.message == signed_bytes && v.key.point_b64url == enrollment.decision_key.point_b64url && v.key.suite == enrollment.decision_key.suite
    SignatureInvalid { suite: _ } => false
    SignatureMalformed { declared: _, expected: _ } => false
    VerifyingKeyMalformed { declared: _, expected: _ } => false
    SignatureSuiteMismatch { key_suite: _, signature_suite: _ } => false
    VerifyingKeyUndecodable { point_b64url: _ } => false
    SignatureUndecodable { b64url: _ } => false
  }
}

// THE PLATFORM PROOF JOINS to the enrolment's own verified evidence: an iOS assertion must be
// authentic under the enrolled App Attest key AND its stored public key, and over exactly the signed
// bytes. THIS IS THE PRODUCT'S REPLAY AUTHORITY, not Apple's counter: an authentic assertion is
// admitted without comparing its counter to a stored one (Apple's step 5, which
// extdeps.apple.app_attest AssertionAuthentic deliberately does not claim), because the signed bytes
// carry a server-minted, expiring challenge bound to one escalation revision and the decision slot
// admits one decision per escalation. Android has no verifier, so it
// refuses rather than passing on the signature alone.
fn platform_proof_disagreement(enrollment: GoogleDeviceEnrollment, assertion: AssertionVerification, signed_bytes: NonEmptyStr) -> DeviceRedemptionOutcome? {
  match enrollment.evidence {
    AndroidAttestedDecisionKey => Present { value: DevicePlatformUnrealized }
    IosAttestedAppInstance { attest_key_id: k, attest_public_key_b64url: pk, receipt_b64: _ } =>
      match assertion {
        AssertionRefused { cause: c } => Present { value: DevicePlatformProofRefused { cause: c } }
        AssertionAuthentic { authentic: v } =>
          if v.key_id != k || v.public_key_point_b64url != pk { Present { value: DevicePlatformProofWrongKey } }
          else if v.client_data != signed_bytes { Present { value: DevicePlatformProofForOtherBytes } }
          else { none }
      }
  }
}

// EVERY GATE, AND NO EFFECT: decidable without a store, including the accepting path.
fn device_redemption_admission(
  key: MacKey,
  enrollment: GoogleDeviceEnrollment,
  request: StoredApprovalRequest,
  signed: DeviceRedemptionSigningInput,
  signature: SignatureVerification,
  assertion: AssertionVerification,
  observed_at: Timestamp,
) -> DeviceAdmission {
  let signed_bytes = device_redemption_signing_input(i: signed)
  let claims = claims_for(request: request, decision: signed.decision)
  let capability_text = approval_capability_signing_input(c: claims)
  let disagreement = signing_field_disagreement(signed: signed, enrollment: enrollment, request: request, capability_text: capability_text)
  if !email_on_roster(email: enrollment.google_email, roster: approval_google_approver_emails) {
    DeviceNotAdmitted { outcome: DeviceEnrollmentNotAnApprover { email: enrollment.google_email } }
  } else {
    match disagreement {
      Present { value: f } => DeviceNotAdmitted { outcome: DeviceSignedForAnotherRequest { field: f } }
      Absent =>
  if !utc_instant_before(a: observed_at, b: signed.challenge.expires_at) {
    DeviceNotAdmitted { outcome: DeviceChallengeExpired { expires_at: signed.challenge.expires_at, observed_at: observed_at } }
  } else {
    let challenge_message = redemption_challenge_message(escalation_id: request.escalation_id, request_revision: request.request_revision, enrollment_id: enrollment.enrollment_id, expires_at: signed.challenge.expires_at)
    match mac_verify(key: key, message: challenge_message, tag_hex: signed.challenge.nonce_hex) {
      MacVerified { verified: _ } =>
        match capability_tag_hex(capability: ApprovalCapability { claims: claims, tag_b64url: signed.capability_tag_b64url }) {
          Absent => DeviceNotAdmitted { outcome: DeviceCapabilityTagMalformed }
          Present { value: tag_hex } =>
        match verify_capability(
          capability: ApprovalCapability { claims: claims, tag_b64url: signed.capability_tag_b64url },
          expectation: approval_capability_expectation,
          mac_result: mac_verify(key: key, message: capability_text, tag_hex: tag_hex),
          observed_at: observed_at,
        ) {
          CapabilityRefused { cause: c } => DeviceNotAdmitted { outcome: DeviceCapabilityRefused { cause: c } }
          CapabilityAuthentic { claims: cl } =>
            if !device_signature_joins(signature: signature, enrollment: enrollment, signed_bytes: signed_bytes) {
              DeviceNotAdmitted { outcome: DeviceSignatureRefused { verification: signature } }
            } else {
              match platform_proof_disagreement(enrollment: enrollment, assertion: assertion, signed_bytes: signed_bytes) {
                Present { value: o } => DeviceNotAdmitted { outcome: o }
                Absent => DeviceAdmitted {
                  admitted: AdmittedDeviceRedemption {
                    claims: cl, enrollment_id: enrollment.enrollment_id, decided_by: enrollment.google_email,
                    execute_by: request.expires_at, observed_at: observed_at,
                  }
                }
              }
            }
        }
        }
      MacTagMismatch { key_id: _ } => DeviceNotAdmitted { outcome: DeviceChallengeNotIssuedHere }
      MacKeyUnknown { key_id: _ } => DeviceNotAdmitted { outcome: DeviceChallengeNotIssuedHere }
      MacKeyRetired { key_id: _, retired_at: _ } => DeviceNotAdmitted { outcome: DeviceChallengeNotIssuedHere }
      MacSuiteMismatch { expected: _, key_suite: _ } => DeviceNotAdmitted { outcome: DeviceChallengeNotIssuedHere }
      MacTagMalformed { octets_declared: _, octets_expected: _ } => DeviceNotAdmitted { outcome: DeviceChallengeNotIssuedHere }
    }
  }
    }
  }
}

// THE ONLY DECISION COMMIT ON THIS ROUTE, and it takes the admitted value -- not claims, not a login.
fn commit_admitted_redemption(root: NonEmptyStr, admitted: AdmittedDeviceRedemption) -> DeviceRedemptionOutcome {
  let cl = admitted.claims
  let decision = match cl.decision {
    ProposeApprove => BrokerApproved {
      escalation_id: cl.escalation_id, revision: cl.request_revision, decided_by: admitted.decided_by, decided_at: admitted.observed_at,
      obligation: ExecutionObligation { authority: cl.authority, intent_revision: cl.request_revision, execute_by: admitted.execute_by },
    }
    ProposeDeny => BrokerDenied {
      escalation_id: cl.escalation_id, revision: cl.request_revision, decided_by: admitted.decided_by, decided_at: admitted.observed_at,
      reason: "denied by the operator on the enrolled device",
    }
  }
  match commit_broker_decision(root: root, decision: decision) {
    StoreWritten => DeviceRedeemed { decision: decision }
    StoreSlotOccupied => DeviceLostTheRace
    StoreRefused { detail: d } => DeviceCommitRefused { detail: d }
  }
}

// THE ROUTE'S FOLD: the enrolment standing is read from the store by the realization and passed in
// as its slot standing, so revocation is the store's fact, not a field a caller sets.
fn redeem_device_over_store(
  root: NonEmptyStr,
  keyring: ApprovalKeyringRead,
  enrolment: GoogleEnrolmentSlot,
  signed: DeviceRedemptionSigningInput,
  signature: SignatureVerification,
  assertion: AssertionVerification,
  observed_at: Timestamp,
) -> DeviceRedemptionOutcome {
  match deciding_google_enrollment(slot: enrolment) {
    Absent =>
      match enrolment {
        GoogleEnrolmentRevoked { enrollment: e, revoked_at: _ } => DeviceEnrollmentRevoked { enrollment_id: e.enrollment_id }
        GoogleEnrolmentUnreadable { detail: d } => DeviceStoreUnreadable { detail: d }
        GoogleEnrolmentAbsent => DeviceEnrollmentUnknown
        GoogleEnrolmentActive { enrollment: _ } => DeviceEnrollmentUnknown
      }
    Present { value: enrollment } =>
      match observe_escalation(root: root, escalation_id: signed.escalation_id) {
        EscalationNotFiled => DeviceEscalationNotFiled { escalation_id: signed.escalation_id }
        EscalationUnreadable { detail: d } => DeviceStoreUnreadable { detail: d }
        EscalationDecided { decision: d } => DeviceAlreadyDecided { decision: d }
        EscalationPending { request: req } =>
          match keyring {
            ApprovalKeyringRefused { cause: c } => DeviceKeyringUnavailable { cause: c }
            ApprovalKeyLoaded { key: key } =>
              match device_redemption_admission(key: key, enrollment: enrollment, request: req, signed: signed, signature: signature, assertion: assertion, observed_at: observed_at) {
                DeviceNotAdmitted { outcome: o } => o
                DeviceAdmitted { admitted: a } => commit_admitted_redemption(root: root, admitted: a)
              }
          }
      }
  }
}

// ── The enrolment store ──────────────────────────────────────────────────────────────────────
// ONE CAS SLOT PER ENROLMENT, keyed by google_enrollment_id: generation 1 is the enrolment, generation
// 2 its revocation (gunbc.auth.approval_google_enrolment google_enrolment_record_kind_generation).
// Beside them, one create-once slot per approver email holds the Google subject pinned to it. Records
// are owner-only, as the approval store's are. The parse that re-mints a stored enrolment lives in
// approval_google_enrolment, the module its sole constructor is sealed to.
// THE BROKER'S HOST-SINGLETON STORES live under the host-state tree (gunbc.host_state_root), each at its own
// member. One broker deployment, so each mint takes the tree and nothing else. A declaration carries only the
// member: each directory row is a gunbc.managed_directory ManagedDirectory, whose mode is DERIVED from its
// declared dependents, so a declared mode here would be a second authority for that fact.
fn approval_broker_store_path(tree: HostStateTree, member: NonEmptyStr) -> NonEmptyStr {
  join([host_state_tree_path(tree: tree) as String, "/", member as String], "") as NonEmptyStr
}

// ── The device store ───────────────────────────────────────────────────────────────────────────
// THE ONE DECLARATION OF THE DEVICE STORE (enrolments and subject pins share its slot namespace, told apart
// by key prefix: they are two record kinds of one store, not two stores).
type ApprovalDeviceStoreSlotsDeclaration { member: NonEmptyStr }

data approval_device_store_slots: ApprovalDeviceStoreSlotsDeclaration = ApprovalDeviceStoreSlotsDeclaration {
  member: "approval-devices" as NonEmptyStr,
}

// A SEALED VALUE MINTED FROM THAT DECLARATION, as gunbc.roadmap.roadmap_attempt_worktree_claim_root
// WorktreeClaimStore is: sole_constructor, non-generic, never a variant arm, built only by
// approval_device_store, which lists the derived directory and answers Ready only for a listed one. Every
// enrolment, subject-pin, push-registration and windowed-slot operation below takes it (the windowed slots are
// #15124's head-only facts: the push registration and gunbc.auth.approval_apns_publish's provider token); none
// takes a root.
type ApprovalDeviceStore sole_constructor {
  slots: SlotStore
}

type ApprovalDeviceStoreReading
  = ApprovalDeviceStoreReady { store: ApprovalDeviceStore }
  | ApprovalDeviceStoreUnready { detail: String }

fn approval_device_store(tree: HostStateTree) -> ApprovalDeviceStoreReading {
  let root = approval_broker_store_path(tree: tree, member: approval_device_store_slots.member)
  let listed = Filesystem.List(path: root as String)
  match filesystem_listing_observation(directory: root as String, success: listed.success, entries: listed.entries, error: listed.error) {
    FilesystemDirectorySubjectRefused { directory: _, cause: c } => ApprovalDeviceStoreUnready { detail: join(["the approval device store's directory is not admissible: ", c], "") }
    FilesystemDirectoryListingRefused { directory: _, error: e } => ApprovalDeviceStoreUnready { detail: join(["the approval device store's directory could not be listed: ", e], "") }
    FilesystemDirectoryListed(_) => ApprovalDeviceStoreReady { store: ApprovalDeviceStore { slots: file_slot_store(root: root) } }
  }
}

// THE STORE DIRECTORY IS CONVERGED BY THE BROKER INSTALL (gunbc.live_deploy.emit
// approval_broker_dark_install_release_steps), at the path derived from the same declaration as the mint over
// the production tree. The owner is the operator's account, because the verbs that read and write it
// (approval_device_routes) run as that account and nothing else needs it, so the derived mode is owner-only.
// Ownership is Ensured, not Owned: the directory holds enrolled devices, which must survive a retract of the
// deployment that created it.
fn approval_device_store_directory() -> ManagedDirectory {
  ManagedDirectory {
    member: "approval-device-store" as NonEmptyStr,
    path: approval_broker_store_path(tree: host_state_tree(), member: approval_device_store_slots.member) as String as FilePath,
    owner: fleet_posix_operator_user,
    group_principal: fleet_posix_operator_user,
    dependents: [DirectoryDependent { who: fleet_posix_operator_user, needs: [Read, Write, Execute] }],
    ownership: Ensured,
    entries: EntriesUnmanaged,
  }
}

// ── The broker's JWKS cache ──────────────────────────────────────────────────────────────────────
// THE BROKER'S OWN JWKS CACHE (ruling of clever-eagle-893, 2026-10-23: no second fetch path): the cache of
// Google's signing keys, kept beside the device store so the broker never reaches a dashboard instance's
// directory. It wraps the one JWKS cache carrier (gunbc.auth.oidc_id_token_verification JwksCacheRoot) that
// the verification code takes; its identity is this sealed type, distinct from the instance cache's
// InstanceJwksCache, so neither stands where the other is required. Data only; construction is what is sealed.
type BrokerJwksCache sole_constructor {
  cache: JwksCacheRoot
}

type BrokerJwksCacheReading
  = BrokerJwksCacheReady { cache: BrokerJwksCache }
  | BrokerJwksCacheUnready { detail: String }

fn broker_jwks_cache(tree: HostStateTree) -> BrokerJwksCacheReading {
  let cache = broker_jwks_cache_root(tree: tree)
  let listed = Filesystem.List(path: cache.root as String)
  match filesystem_listing_observation(directory: cache.root as String, success: listed.success, entries: listed.entries, error: listed.error) {
    FilesystemDirectorySubjectRefused { directory: _, cause: c } => BrokerJwksCacheUnready { detail: join(["the broker JWKS cache's directory is not admissible: ", c], "") }
    FilesystemDirectoryListingRefused { directory: _, error: e } => BrokerJwksCacheUnready { detail: join(["the broker JWKS cache's directory could not be listed: ", e], "") }
    FilesystemDirectoryListed(_) => BrokerJwksCacheReady { cache: BrokerJwksCache { cache: cache } }
  }
}

// Ensured for the same reason as the device store, at the path derived from the broker's member declaration
// (gunbc.auth.oidc_id_token_verification broker_jwks_cache_slots, through broker_jwks_cache_root).
fn approval_jwks_cache_directory() -> ManagedDirectory {
  ManagedDirectory {
    member: "approval-jwks-cache" as NonEmptyStr,
    path: broker_jwks_cache_root(tree: host_state_tree()).root as String as FilePath,
    owner: fleet_posix_operator_user,
    group_principal: fleet_posix_operator_user,
    dependents: [DirectoryDependent { who: fleet_posix_operator_user, needs: [Read, Write, Execute] }],
    ownership: Ensured,
    entries: EntriesUnmanaged,
  }
}

type DeviceStoreWrite
  = DeviceStoreWritten
  | DeviceStoreSlotOccupied
  | DeviceStoreRefused { detail: NonEmptyStr }

fn device_store_write(devices: ApprovalDeviceStore, key: NonEmptyStr, expected: CasExpectation, payload: NonEmptyStr) -> DeviceStoreWrite {
  match admit_cas_attempt_for_derived_payload(key: key, expected: expected, proposed: payload) {
    DerivedPayloadKeyNotSlotAddressable { key: _ } => DeviceStoreRefused { detail: "device store key is not slot-addressable" }
    DerivedPayloadAdmitted { verified: v } =>
      match slot_commit(store: devices.slots, publication: OwnerOnlyCreateOnly, verified: v) {
        CasCommitted { committed: _ } => DeviceStoreWritten
        CasPreconditionFailed { expected: _, observed: _ } => DeviceStoreSlotOccupied
        CasStoreRefused { cause: _ } => DeviceStoreRefused { detail: "device store refused the publication" }
      }
  }
}

fn observe_google_enrolment(devices: ApprovalDeviceStore, enrollment_id: NonEmptyStr) -> GoogleEnrolmentSlot {
  match slot_observe(store: devices.slots, key: enrollment_id) {
    CasObservedUnreadable { cause: c } => GoogleEnrolmentUnreadable { detail: concat("enrolment slot unreadable: ", cas_unreadable_slot_detail(cause: c)) as NonEmptyStr }
    CasObservedReadable { readable: r } => match r {
      CasReadableAbsent => GoogleEnrolmentAbsent
      CasReadablePresent { version: ver } => parse_google_enrolment_record(text: ver.value as String, generation: ver.generation)
    }
  }
}

// THE ONLY ENROLMENT WRITE: creating the enrolment is one CAS expecting an absent slot, so a resent
// POST that raced its twin lands on DeviceStoreSlotOccupied rather than overwriting.
fn commit_google_enrolment(devices: ApprovalDeviceStore, enrollment: GoogleDeviceEnrollment) -> DeviceStoreWrite {
  device_store_write(devices: devices, key: enrollment.enrollment_id, expected: ExpectSlotAbsent, payload: google_enrolment_json(e: enrollment) as NonEmptyStr)
}

// REVOCATION IS ONE CAS from generation 1 to 2, and lands only on a live enrolment.
fn revoke_google_enrolment(devices: ApprovalDeviceStore, slot: GoogleEnrolmentSlot, revoked_at: Timestamp) -> DeviceStoreWrite {
  match slot {
    GoogleEnrolmentActive { enrollment: e } =>
      device_store_write(devices: devices, key: e.enrollment_id, expected: ExpectSlotGeneration { generation: google_enrolment_record_kind_generation(k: GoogleEnrolledRecord) }, payload: google_revocation_json(e: e, revoked_at: revoked_at) as NonEmptyStr)
    GoogleEnrolmentAbsent => DeviceStoreRefused { detail: "only a live enrolment can be revoked" }
    GoogleEnrolmentRevoked { enrollment: _, revoked_at: _ } => DeviceStoreRefused { detail: "only a live enrolment can be revoked" }
    GoogleEnrolmentUnreadable { detail: _ } => DeviceStoreRefused { detail: "only a live enrolment can be revoked" }
  }
}

// THE SUBJECT PIN: attempt the create with the presented subject; on a lost CAS reread the slot.
// The observation is the only thing the pin join reads, so two accounts racing under one address
// cannot both reach an enrolment.
fn create_or_read_subject_pin(devices: ApprovalDeviceStore, email: NonEmptyStr, subject: NonEmptyStr) -> SubjectPinCreateOrRead {
  match device_store_write(devices: devices, key: subject_pin_key(email: email), expected: ExpectSlotAbsent, payload: subject_pin_json(email: email, subject: subject) as NonEmptyStr) {
    DeviceStoreWritten => SubjectPinCreatedForPresented
    DeviceStoreRefused { detail: d } => SubjectPinUnreadable { detail: d }
    DeviceStoreSlotOccupied => {
      match slot_observe(store: devices.slots, key: subject_pin_key(email: email)) {
        CasObservedUnreadable { cause: c } => SubjectPinUnreadable { detail: concat("subject pin slot unreadable: ", cas_unreadable_slot_detail(cause: c)) as NonEmptyStr }
        CasObservedReadable { readable: r } => match r {
          CasReadableAbsent => SubjectPinUnreadable { detail: "subject pin slot lost the create and then read absent" }
          CasReadablePresent { version: ver } => parse_subject_pin(text: ver.value as String, email: email)
        }
      }
    }
  }
}

// THE READBACK IS A PROJECTION OF THE STORED SLOT, never a second enumeration of it: a live
// enrolment reads back active, a revoked one revoked, and a slot that holds no enrolment has no
// readback, so the route refuses it rather than inventing a standing.
fn enrolment_readback_of(slot: GoogleEnrolmentSlot) -> EnrolmentReadback? {
  match slot {
    GoogleEnrolmentActive { enrollment: e } => Present { value: EnrolmentReadback { enrollment_id: e.enrollment_id, standing: EnrolmentStandingActive } }
    GoogleEnrolmentRevoked { enrollment: e, revoked_at: _ } => Present { value: EnrolmentReadback { enrollment_id: e.enrollment_id, standing: EnrolmentStandingRevoked } }
    GoogleEnrolmentAbsent => none
    GoogleEnrolmentUnreadable { detail: _ } => none
  }
}

// EVERY ENROLMENT, for the devices list: the store's slot keys that are enrolment ids, each read
// through observe_google_enrolment. A key whose slot cannot be read is named, never skipped.
type GoogleEnrolmentListing
  = GoogleEnrolmentsListed { slots: List<GoogleEnrolmentSlot> }
  | GoogleEnrolmentListingRefused { detail: NonEmptyStr }

fn list_google_enrolments(devices: ApprovalDeviceStore) -> GoogleEnrolmentListing {
  match slot_keys(store: devices.slots) {
    CasSlotKeysListingRefused { root: _, detail: d } => GoogleEnrolmentListingRefused { detail: d as NonEmptyStr }
    CasSlotKeysSubjectRefused { root: r, cause: c } => GoogleEnrolmentListingRefused { detail: join(["store root ", r as String, " is not an admissible directory: ", c], "") as NonEmptyStr }
    CasSlotKeysListed { keys: keys } =>
      GoogleEnrolmentsListed { slots: map(filter(keys, k => starts_with(s: k as String, prefix: "genr-")), k => observe_google_enrolment(devices: devices, enrollment_id: k)) }
  }
}

// ── The push registration slot ───────────────────────────────────────────────────────────────
// A PUSH REGISTRATION IS A HEAD-ONLY FACT: the token the enrolled app last presented. Its history is
// not an audit trail -- a rotated token is dead, and who decided is the enrolment's record, not this
// one's -- so it is a WINDOWED compare-and-set slot in the device store (gunbc.durable_cas_file_store
// slot_observe_windowed / slot_commit_windowed over ApprovalDeviceStore's slots), never a growing generation line and never a last-write-wins file.
// It used to be the second: an owner-only create-new file under a root nothing ensured, so a ROTATED
// token -- the device routes' own case ("a rotated APNs token to reach
// the server without a new enrolment") -- refused on the existing file. The key is server-derived from
// the verified enrolment's id, and its "push-" prefix keeps it out of list_google_enrolments.
data approval_push_slot_window_k: Int = 2

fn push_registration_key(enrollment_id: NonEmptyStr) -> NonEmptyStr {
  join(["push-", enrollment_id as String], "") as NonEmptyStr
}

type PushRegistrationSlot
  = PushRegistrationAbsent
  | PushRegistrationStored { registration: PushRegistration, generation: CasGeneration }
  | PushRegistrationUnreadable { detail: NonEmptyStr }

type PushRegistrationWrite
  = PushRegistrationWritten
  | PushRegistrationUnchanged
  | PushRegistrationRaced
  | PushRegistrationRefused { detail: NonEmptyStr }

fn push_slot_window() -> CasGenerationWindow? {
  match cas_generation_window(k: approval_push_slot_window_k) {
    CasGenerationWindowAdmitted { window: w } => Present { value: w }
    CasGenerationWindowTooNarrow { k: _ } => none
  }
}

fn observe_push_registration(devices: ApprovalDeviceStore, enrollment_id: NonEmptyStr) -> PushRegistrationSlot {
  match push_slot_window() {
    Absent => PushRegistrationUnreadable { detail: "the push slot window is narrower than the store admits" }
    Present { value: w } =>
      match slot_observe_windowed(store: devices.slots, key: push_registration_key(enrollment_id: enrollment_id), window: w) {
        CasObservedUnreadable { cause: c } => PushRegistrationUnreadable { detail: concat("push registration slot unreadable: ", cas_unreadable_slot_detail(cause: c)) as NonEmptyStr }
        CasObservedReadable { readable: r } => match r {
          CasReadableAbsent => PushRegistrationAbsent
          CasReadablePresent { version: ver } => match decode_push_update(text: ver.value as String) {
            WireRefused { at: a, cause: c } => PushRegistrationUnreadable { detail: join(["stored push registration refused at ", a as String, ": ", c as String], "") as NonEmptyStr }
            WireDecoded { value: reg } => PushRegistrationStored { registration: reg, generation: ver.generation }
          }
        }
      }
  }
}

// THE PUT IS ONE CAS FROM WHAT WAS READ: absent expects absent, stored expects its generation, and
// the same registration again writes nothing (the app re-presents its token on every launch). A lost
// race is its own answer, so the route can say "retry" rather than "stored".
fn commit_push_registration(devices: ApprovalDeviceStore, enrollment_id: NonEmptyStr, push: PushRegistration) -> PushRegistrationWrite
  admit_callers: [
    decl_ref(module_path: "gunbc.auth.approval_device_routes", decl_name: "device_push_update_response_at"),
  ]
{
  let payload = push_update_json(p: push) as NonEmptyStr
  match observe_push_registration(devices: devices, enrollment_id: enrollment_id) {
    PushRegistrationUnreadable { detail: d } => PushRegistrationRefused { detail: d }
    PushRegistrationAbsent => push_registration_cas(devices: devices, enrollment_id: enrollment_id, expected: ExpectSlotAbsent, payload: payload)
    PushRegistrationStored { registration: stored, generation: g } =>
      if push_update_json(p: stored) == (payload as String) { PushRegistrationUnchanged }
      else { push_registration_cas(devices: devices, enrollment_id: enrollment_id, expected: ExpectSlotGeneration { generation: g }, payload: payload) }
  }
}

// The window's reclamation of generations below the head is the store's: an incomplete one leaves
// an extra generation that the next commit reclaims, and the head this answer reports is unaffected.
fn push_registration_cas(devices: ApprovalDeviceStore, enrollment_id: NonEmptyStr, expected: CasExpectation, payload: NonEmptyStr) -> PushRegistrationWrite {
  match push_slot_window() {
    Absent => PushRegistrationRefused { detail: "the push slot window is narrower than the store admits" }
    Present { value: w } =>
      match admit_cas_attempt_for_derived_payload(key: push_registration_key(enrollment_id: enrollment_id), expected: expected, proposed: payload) {
        DerivedPayloadKeyNotSlotAddressable { key: _ } => PushRegistrationRefused { detail: "push registration key is not slot-addressable" }
        DerivedPayloadAdmitted { verified: v } =>
          match slot_commit_windowed(store: devices.slots, publication: OwnerOnlyCreateOnly, verified: v, window: w).outcome {
            CasCommitted { committed: _ } => PushRegistrationWritten
            CasPreconditionFailed { expected: _, observed: _ } => PushRegistrationRaced
            CasStoreRefused { cause: _ } => PushRegistrationRefused { detail: "device store refused the push registration" }
          }
      }
  }
}

// ── The APNs provider-token slot ─────────────────────────────────────────────────────────────
// gunbc.auth.approval_apns_publish caches its signed provider token as one more head-only windowed slot
// in this store (its key and payload are that module's). The slot operations are this module's,
// because ApprovalDeviceStore's operations live where it is declared and the publish module reads no
// root and calls no store operation of gunbc.durable_cas_file_store.
fn observe_device_windowed_slot(devices: ApprovalDeviceStore, key: NonEmptyStr, window: CasGenerationWindow) -> CasSlotObservation<NonEmptyStr> {
  slot_observe_windowed(store: devices.slots, key: key, window: window)
}

fn commit_device_windowed_slot(devices: ApprovalDeviceStore, verified: VerifiedCasAttempt, window: CasGenerationWindow) -> CasOutcome<NonEmptyStr> {
  slot_commit_windowed(store: devices.slots, publication: OwnerOnlyCreateOnly, verified: verified, window: window).outcome
}

// ── Frontiers ────────────────────────────────────────────────────────────────────────────────
data ecdsa_verification_realization_frontier: DissolutionCondition = unbound_dissolution(
  description: "THE VERIFIERS ARE .dag, NOT HOST PRIMITIVES (operator refusal of the host-Rust route on gunbc#11588/#11592; decision msg_54c92f2f 2026-09-21), and they are AUTHORED: extdeps.crypto.signature verify_signature binds nist_p256 through signature_verification_from_implementation, and extdeps.apple.app_attest verify_attestation / verify_assertion run Apple's steps over the CBOR, COSE, WebAuthn, DER/X.509/PEM readers, SHA-256/SHA-384 and the P-256/P-384 family fold, supplying attestation_verification_from_implementation and assertion_verification_from_implementation (gunbc#11970, #11975, #11981 and the verifier change beside them; Apple's real assertion signature verifies under the sample credential key by execution). WHAT REMAINS IS AN EXECUTION ROUTE: one interpreted P-256 verification costs what the roadmap row v1-interpreter-p256-verify-cost-shape's named instrument re-derives (gunbc#11645's cost shape) and a P-384 chain link is more, so the interpreted broker cannot run them per request; the folds bind as ONE natively emitted realization handler of the seams once MachineWidth<N> reification (gunbc#11819) lets the crypto closure emit, and the interpreter cost itself is the v1-performance row v1-interpreter-p256-verify-cost-shape, not this frontier's -- SUFFICIENT FOR the device routes to mint SignatureVerified, AttestationVerified and AssertionAuthentic from real bytes in usable time, AND FOR ONE NAMED PARAMETER FACT THAT VERIFICATION DOES NOT ESTABLISH: test.claim.p256_dag_ecdsa_witness the_base_point_has_order_n, or a native claim asserting exactly n*G == infinity for the published base point together with a discriminating control that (n-1)*G != infinity. That fact is named HERE rather than left inside the generic verifier statement because a passing signature vector does not imply the published base point has the declared order, so a frontier that only promised working verification would retire while the order fact stayed dead (DESIGN section 4b(3): a trigger naming less than the capability it restores is satisfied while the capability stays dead). It left the required floor because the scalar multiplication reached the 8000ms wall deadline before any verdict, which no declared eval-step drop may cover; its cheap conjunct, the_base_point_is_on_the_curve, stays on the floor",
)

data ios_realization_frontier: DissolutionCondition = unbound_dissolution(
  description: "the SwiftUI client at apps/approve-ios generating its decision key in the Secure Enclave under approval_decision_key_access_policy, attesting with App Attest over google_enrolment_transcript, registering for APNs, fetching with assertion-authenticated reads, and redeeming with SignedRedemption, its byte builders checked against gunbc.auth.approval_device_redemption_fixtures vectors, built and uploaded to TestFlight -- SUFFICIENT FOR one physical-phone approval to read back with decided_by naming the enrolled Google email. Its project.yml and Info.plist are derived (gunbc.approve_ios_project) and its vectors are derived (gunbc.auth.approval_device_redemption_fixtures); its protocol, wire and vector-test Swift is printed from transcribed syntax trees (gunbc.approve_ios_app approve_ios_transcribed_swift_frontier) and the rest is hand-authored realization (gunbc.approve_ios_app approve_ios_retained_swift_rows), and its build is executed by no required lane (gunbc.approve_ios_app approve_ios_build_unexecuted_frontier)",
)

data approval_target_frontier: DissolutionCondition = unbound_dissolution(
  description: "gunbc.auth.approval_decision_store StoredApprovalRequest gains a typed ApprovalTarget (authority, subject, operator sentence derived from the subject) rendered by stored_request_json, and carries the access lifetime (gunbc.auth.access_request AccessLifetime) distinct from the link's expires_at, landed after the Mt. Collins first boot releases the store -- SUFFICIENT FOR the app to show the host and what is granted for how long from the one stored record, never the link expiry in its place, and for the device signature to cover both",
)

data android_realization_frontier: DissolutionCondition = unbound_dissolution(
  description: "an Android client that generates the decision key in Keystore with per-operation biometric authorization, submits its attestation chain over google_enrolment_transcript, registers with FCM, and redeems with SignedRedemption, plus the server's Android key-attestation verifier (first trusted KeyDescription occurrence, revocation, current Google roots) and FCM publish, replacing google_enrolment_admission's GoogleRefusalAndroidUnrealized and the redemption's DevicePlatformUnrealized arms -- SUFFICIENT FOR an approval decided on a physical Android device to read back with decided_by naming the enrolled Google email",
)

