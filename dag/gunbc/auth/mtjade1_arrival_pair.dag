module gunbc.auth.mtjade1_arrival_pair

import std.types { List, Map, NonEmptyStr, String }
import std.optional { Present }
import extdeps.cloud.gcp.gcp {
  ServiceAccountEmail, WifPool, WifProvider, wif_provider_resource, wif_pool_resource,
}
import gunbc.auth.github_gcp_federation {
  fleet_secrets_project_id, fleet_secrets_project_number, github_wif_issuer_uri, federated_service_account_member,
}
import gunbc.auth.gcp_secret_access { SecretAccessGrant }
import gunbc.auth.managed_host_boot_federation { pinned_version_accessor_grant_for }
import gunbc.auth.oidc_claim_pins { OidcClaimPin, claim_pins_attribute_condition, fleet_converge_job_claim_pins }
import gunbc.secret_provision { mtjade1_bmc_gunbc_arrival_accessor_ref }
import gunbc.auth.arrival_federation_pair {
  mtjade1_arrival_federation_pair, arrival_wif_pool_id, arrival_wif_provider_id,
  arrival_service_account_id, arrival_service_account, arrival_environment,
  arrival_pool_display_name,
  arrival_wif_pool, arrival_wif_provider, arrival_wif_attribute_mapping,
  arrival_provider_resource, arrival_principal_set, arrival_principal_member,
  arrival_secret_grants,
}

// mtjade1's pair is a ROW of the general ArrivalFederationPair shape (gunbc.auth.arrival_federation_pair,
// PXE 1d-b), not a per-host hard-coding. Every name below is DERIVED from that row by the shared fns; the
// arrival_federation_pair_witness proves each derived string equals the literal mtjade1 declared, so this
// is a cut at the root, not a second spelling. A new arrival host adds a row there; nothing here changes.

// Names, WIF pair and the one version-pinned accessor. PrivilegedEffect rows live in
// gunbc.auth.mtjade1_arrival_federation so gcp-iam-converge and fleet-converge.yml do not
// close over the selection fold.

data mtjade1_arrival_pool_id: NonEmptyStr = arrival_wif_pool_id(pair: mtjade1_arrival_federation_pair)
data mtjade1_arrival_pool_display_name: NonEmptyStr = arrival_pool_display_name(pair: mtjade1_arrival_federation_pair)
data mtjade1_arrival_provider_id: NonEmptyStr = arrival_wif_provider_id(pair: mtjade1_arrival_federation_pair)
data mtjade1_arrival_service_account_id: NonEmptyStr = arrival_service_account_id(pair: mtjade1_arrival_federation_pair)
data mtjade1_arrival_service_account: ServiceAccountEmail = arrival_service_account(pair: mtjade1_arrival_federation_pair)
data mtjade1_arrival_environment: NonEmptyStr = arrival_environment(pair: mtjade1_arrival_federation_pair)

data mtjade1_arrival_wif_pool: WifPool = arrival_wif_pool(pair: mtjade1_arrival_federation_pair)

fn mtjade1_arrival_claim_pins() -> List<OidcClaimPin> {
  fleet_converge_job_claim_pins(environment: mtjade1_arrival_environment)
}

data mtjade1_arrival_wif_attribute_mapping: Map<String, String> = arrival_wif_attribute_mapping

fn mtjade1_arrival_wif_provider() -> WifProvider {
  arrival_wif_provider(pair: mtjade1_arrival_federation_pair)
}

fn mtjade1_arrival_provider_resource() -> String {
  arrival_provider_resource(pair: mtjade1_arrival_federation_pair)
}

fn mtjade1_arrival_principal_set() -> String {
  arrival_principal_set(pair: mtjade1_arrival_federation_pair)
}

fn mtjade1_arrival_principal_member() -> String {
  arrival_principal_member(pair: mtjade1_arrival_federation_pair)
}

fn mtjade1_arrival_secret_grants() -> List<SecretAccessGrant> {
  arrival_secret_grants(pair: mtjade1_arrival_federation_pair)
}
