import std.process { ProcessExit, ExitSuccess, ExitFailure, exit_failure }
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.cloud.gcp.iam_admin
import extdeps.cloud.gcp.iam_deny
import extdeps.cloud.gcp.secret_manager
import extdeps.cloud.gcp.iam {
  GcpPolicy, GcpBinding, GcpIamBindingCell, GcpIamOwnedCellUniverse,
  gcp_policy_from_wire, gcp_policy_cells, gcp_cell_in, reconcile_gcp_policy,
  GcpPolicyAlreadyConverged, GcpPolicyDeltaRequired, GcpPolicyRepresentationLossy,
}
import extdeps.transports.rest { RestOutcome, RestStatusRefused }
import gunbc.cli_wire { CliWireResponse, CliWirePrintable }
import gunbc.actions_run_binding { actions_variable_trimmed }
import gunbc.auth.access_token_source { read_supplied_access_token, SuppliedTokenReady, SuppliedTokenUnavailable }
import gunbc.auth.github_gcp_federation { fleet_secrets_project_id }
import gunbc.auth.gcp_iam_converge { gcp_iam_observe_dedicated_federation, gcp_iam_converge_targets, iam_converge_service_account, iam_observe_service_account, iam_converge_denied_permissions, same_key_set, cell_preimage, observe_and_plan_estate, GcpIamEstateRefused, PolicyReading, PolicyObserved, PolicyResourceAbsent, PolicyUnreadable }
import gunbc.auth.heal_publisher_provision {
  DedicatedFederation, observe_and_classify, create_absent_subjects, federation_fully_present,
  FederationClassified, FederationUnclassified, rest_ok, rest_refusal_text, outcome_is_not_found,
}
import gunbc.auth.gcp_iam_bootstrap_model {
  IamBootstrapRole, iam_bootstrap_roles, iam_bootstrap_role_name, iam_bootstrap_role_id, iam_bootstrap_role_permissions, iam_bootstrap_role_matches,
  IamBootstrapResource, BootstrapProject, BootstrapPool, BootstrapAccount, BootstrapSecret, IamBootstrapBinding,
  iam_bootstrap_resource_key, iam_bootstrap_capability_bindings, iam_bootstrap_trust_bindings,
  iam_bootstrap_apply_federation, iam_bootstrap_deny_policy_id, iam_bootstrap_attachment_point,
  iam_bootstrap_deny_rules, iam_bootstrap_deny_matches, iam_bootstrap_model_admitted,
}

// Operator-authorized initial setup. This entry does not forge an app approval or workflow
// identity. Its credential is never a fallback in the ongoing approval-gated job.
// Trust is last. Existing mismatched roles, providers and deny policies refuse instead of being
// adopted or patched; existing foreign policy cells are preserved through the shared reconciler.
type IamBootstrapStage = BootstrapIdentities | BootstrapRoles | BootstrapDeny | BootstrapCapabilities | BootstrapPrivilegeReadback | BootstrapWorkflowTrust

data iam_bootstrap_stages: List<IamBootstrapStage> = [BootstrapIdentities, BootstrapRoles, BootstrapDeny, BootstrapCapabilities, BootstrapPrivilegeReadback, BootstrapWorkflowTrust]

type IamBootstrapProgress { completed: List<IamBootstrapStage>, refusal: String }

fn iam_bootstrap_stage_admitted(stage: IamBootstrapStage, completed: List<IamBootstrapStage>) -> Bool {
  let required = match stage {
    BootstrapIdentities => []
    BootstrapRoles => [BootstrapIdentities]
    BootstrapDeny => [BootstrapIdentities]
    BootstrapCapabilities => [BootstrapRoles, BootstrapDeny]
    BootstrapPrivilegeReadback => [BootstrapCapabilities]
    BootstrapWorkflowTrust => [BootstrapDeny, BootstrapPrivilegeReadback]
  }
  all(required, prerequisite => any(completed, done => done == prerequisite))
}

fn iam_bootstrap_stage_wire(stage: IamBootstrapStage) -> String {
  match stage { BootstrapIdentities => "identities" BootstrapRoles => "roles" BootstrapDeny => "deny" BootstrapCapabilities => "capabilities" BootstrapPrivilegeReadback => "privilege-readback" BootstrapWorkflowTrust => "workflow-trust" }
}

fn iam_bootstrap_plan() -> CliWireResponse {
  let federation = gcp_iam_observe_dedicated_federation()
  let boundary = [
    concat("project ", fleet_secrets_project_id as String),
    concat("workflow provider ", federation.provider_id as String),
    concat("workflow condition ", federation.attribute_condition),
    concat("workflow principal set ", federation.principal_set),
    concat("deny policy ", iam_bootstrap_deny_policy_id as String),
    concat("deny principal serviceAccount:", iam_converge_service_account as String),
    concat("deny permissions ", join(iam_converge_denied_permissions, ",")),
    "Target bootstrap creates only bare pools/accounts; target providers and workload trust remain approval-gated.",
  ]
  let roles = map(iam_bootstrap_roles, r => join(["role ", iam_bootstrap_role_name(role: r) as String, " permissions=", join(iam_bootstrap_role_permissions(role: r), ",")], ""))
  let cells = map(iam_bootstrap_capability_bindings() + iam_bootstrap_trust_bindings(), b => join([
    "binding ", iam_bootstrap_resource_key(resource: b.resource), " ", cell_preimage(c: b.cell),
  ], ""))
  CliWirePrintable { bytes: join(["Bootstrap stages: ", join(map(iam_bootstrap_stages, s => iam_bootstrap_stage_wire(stage: s)), " -> "), "\n", join(boundary + roles + cells, "\n")], ""),
    exit: if iam_bootstrap_model_admitted() { ExitSuccess } else { exit_failure(reason: "bootstrap model does not preserve the declared trust boundary") } }
}

fn iam_bootstrap_ensure_identity(f: DedicatedFederation, own_trust: Bool, token: Secret) -> String {
  let before = observe_and_classify(f: f, token: token)
  match before {
    FederationUnclassified { reasons } => join(reasons, "; ")
    FederationClassified { create_pool, create_provider, create_account } => {
      let created = create_absent_subjects(f: f, token: token, c: FederationClassified {
        create_pool: create_pool, create_provider: own_trust && create_provider, create_account: create_account })
      if created != "" { created } else {
        let after = observe_and_classify(f: f, token: token)
        match after {
          FederationUnclassified { reasons } => join(reasons, "; ")
          FederationClassified { create_pool: pool_missing, create_provider: _, create_account: account_missing } =>
            if pool_missing || account_missing || (own_trust && !federation_fully_present(c: after)) {
              concat(f.label, ": named creation is not yet established by readback; no rights granted")
            } else { "" }
        }
      }
    }
  }
}

fn iam_bootstrap_ensure_role(role: IamBootstrapRole, token: Secret) -> String {
  let seen = gcp.IamAdmin.GetProjectRole(access_token: token, project_id: fleet_secrets_project_id, role_id: iam_bootstrap_role_id(role: role))
  if rest_ok(o: seen.outcome) {
    if iam_bootstrap_role_matches(role: role, name: seen.name, permissions: seen.included_permissions, stage: seen.stage, deleted: seen.deleted) { "" }
    else { concat(iam_bootstrap_role_name(role: role) as String, ": existing role differs; no automatic privilege expansion or adoption") }
  } else if !outcome_is_not_found(o: seen.outcome) { rest_refusal_text(o: seen.outcome) }
  else {
    let made = gcp.IamAdmin.CreateProjectRole(access_token: token, project_id: fleet_secrets_project_id,
      role_id: iam_bootstrap_role_id(role: role), title: iam_bootstrap_role_id(role: role), permissions: iam_bootstrap_role_permissions(role: role))
    if !rest_ok(o: made.outcome) { rest_refusal_text(o: made.outcome) }
    else {
      let check = gcp.IamAdmin.GetProjectRole(access_token: token, project_id: fleet_secrets_project_id, role_id: iam_bootstrap_role_id(role: role))
      if rest_ok(o: check.outcome) && iam_bootstrap_role_matches(role: role, name: check.name, permissions: check.included_permissions, stage: check.stage, deleted: check.deleted) { "" }
      else { concat(iam_bootstrap_role_name(role: role) as String, ": created role did not read back exactly; no rights granted") }
    }
  }
}

fn iam_bootstrap_ensure_deny(token: Secret) -> String {
  let seen = gcp.IamDeny.GetPolicy(access_token: token, attachment_point: iam_bootstrap_attachment_point(), policy_id: iam_bootstrap_deny_policy_id)
  if rest_ok(o: seen.outcome) {
    if iam_bootstrap_deny_matches(rules: seen.rules) { "" } else { "existing bootstrap deny policy differs; refusing to weaken or adopt it" }
  } else if !outcome_is_not_found(o: seen.outcome) { rest_refusal_text(o: seen.outcome) }
  else {
    let made = gcp.IamDeny.CreatePolicy(access_token: token, attachment_point: iam_bootstrap_attachment_point(), policy_id: iam_bootstrap_deny_policy_id, rules: iam_bootstrap_deny_rules())
    if !rest_ok(o: made.outcome) { rest_refusal_text(o: made.outcome) }
    else {
      let check = gcp.IamDeny.GetPolicy(access_token: token, attachment_point: iam_bootstrap_attachment_point(), policy_id: iam_bootstrap_deny_policy_id)
      if rest_ok(o: check.outcome) && iam_bootstrap_deny_matches(rules: check.rules) { "" }
      else { "deny creation accepted but exact readback is not established; no capabilities or workflow trust granted" }
    }
  }
}

fn iam_bootstrap_policy_reading(outcome: RestOutcome, bindings: List<GcpBinding>?, etag: String, version: Int?) -> PolicyReading {
  if rest_ok(o: outcome) { PolicyObserved { policy: gcp_policy_from_wire(bindings: bindings, etag: etag, version: version) } }
  else if outcome_is_not_found(o: outcome) { PolicyResourceAbsent }
  else { PolicyUnreadable { cause: rest_refusal_text(o: outcome) } }
}

fn iam_bootstrap_read_policy(resource: IamBootstrapResource, token: Secret) -> PolicyReading {
  match resource {
    BootstrapProject => {
      let r = gcp.ResourceManager.GetIamPolicy(access_token: token, project_id: fleet_secrets_project_id)
      iam_bootstrap_policy_reading(outcome: r.outcome, bindings: r.bindings, etag: r.etag, version: r.version)
    }
    BootstrapPool { pool } => {
      let r = gcp.IamAdmin.GetWorkloadIdentityPoolIamPolicy(access_token: token, project_id: fleet_secrets_project_id, pool_id: pool)
      iam_bootstrap_policy_reading(outcome: r.outcome, bindings: r.bindings, etag: r.etag, version: r.version)
    }
    BootstrapAccount { account } => {
      let r = gcp.IamAdmin.GetServiceAccountIamPolicy(access_token: token, project_id: fleet_secrets_project_id, service_account: account)
      iam_bootstrap_policy_reading(outcome: r.outcome, bindings: r.bindings, etag: r.etag, version: r.version)
    }
    BootstrapSecret { secret } => {
      let r = gcp.SecretManager.GetSecretIamPolicy(access_token: token, project_id: fleet_secrets_project_id, secret: secret)
      iam_bootstrap_policy_reading(outcome: r.outcome, bindings: r.bindings, etag: r.etag, version: r.version)
    }
  }
}

fn iam_bootstrap_write_policy(resource: IamBootstrapResource, policy: GcpPolicy, token: Secret) -> RestOutcome {
  match resource {
    BootstrapProject => gcp.ResourceManager.SetIamPolicy(access_token: token, project_id: fleet_secrets_project_id, policy: policy).outcome
    BootstrapPool { pool } => gcp.IamAdmin.SetWorkloadIdentityPoolIamPolicy(access_token: token, project_id: fleet_secrets_project_id, pool_id: pool, policy: policy).outcome
    BootstrapAccount { account } => gcp.IamAdmin.SetServiceAccountIamPolicy(access_token: token, project_id: fleet_secrets_project_id, service_account: account, policy: policy).outcome
    BootstrapSecret { secret } => gcp.SecretManager.SetSecretIamPolicy(access_token: token, project_id: fleet_secrets_project_id, secret: secret, policy: policy).outcome
  }
}

fn iam_bootstrap_ensure_binding(binding: IamBootstrapBinding, token: Secret) -> String {
  match iam_bootstrap_read_policy(resource: binding.resource, token: token) {
    PolicyResourceAbsent => concat(iam_bootstrap_resource_key(resource: binding.resource), ": binding subject absent")
    PolicyUnreadable { cause } => cause
    PolicyObserved { policy: before } => match reconcile_gcp_policy(observed: before, desired_owned: [binding.cell], owned_universe: GcpIamOwnedCellUniverse { cells: [binding.cell] }) {
      GcpPolicyRepresentationLossy { conditional_roles: _ } => "policy representation loses conditions; refusing write"
      GcpPolicyAlreadyConverged { policy: _ } => ""
      GcpPolicyDeltaRequired { policy: after, added: _, removed, preserved: _ } => if count(removed) != 0 || before.etag == "" {
        "bootstrap policy addition needs a nonempty etag and may remove no cells"
      } else {
        let changed = iam_bootstrap_write_policy(resource: binding.resource, policy: after, token: token)
        if !rest_ok(o: changed) { rest_refusal_text(o: changed) }
        else { match iam_bootstrap_read_policy(resource: binding.resource, token: token) {
          PolicyObserved { policy: checked } => if gcp_cell_in(c: binding.cell, xs: gcp_policy_cells(p: checked)) { "" } else { "policy write answered but the desired binding is absent on readback" }
          _ => "policy write answered but independent readback is unavailable"
        } }
      }
    }
  }
}

fn iam_bootstrap_execute_stage(stage: IamBootstrapStage, token: Secret) -> String {
  match stage {
    BootstrapIdentities => {
      let own = fold([gcp_iam_observe_dedicated_federation(), iam_bootstrap_apply_federation()], init: "", f: (prior, f) =>
        if prior != "" { prior } else { iam_bootstrap_ensure_identity(f: f, own_trust: true, token: token) })
      if own != "" { own } else { fold(gcp_iam_converge_targets, init: "", f: (prior, f) =>
        if prior != "" { prior } else { iam_bootstrap_ensure_identity(f: f, own_trust: false, token: token) }) }
    }
    BootstrapRoles => fold(iam_bootstrap_roles, init: "", f: (prior, role) => if prior != "" { prior } else { iam_bootstrap_ensure_role(role: role, token: token) })
    BootstrapDeny => iam_bootstrap_ensure_deny(token: token)
    BootstrapCapabilities => fold(iam_bootstrap_capability_bindings(), init: "", f: (prior, binding) => if prior != "" { prior } else { iam_bootstrap_ensure_binding(binding: binding, token: token) })
    BootstrapPrivilegeReadback => iam_bootstrap_privilege_readback(token: token)
    BootstrapWorkflowTrust => {
      let guarded = iam_bootstrap_ensure_deny(token: token)
      if guarded != "" { guarded } else { fold(iam_bootstrap_trust_bindings(), init: "", f: (prior, binding) => if prior != "" { prior } else { iam_bootstrap_ensure_binding(binding: binding, token: token) }) }
    }
  }
}

// A create-only local receipt starts before cloud effects. Each stage has its own receipt; a
// process loss leaves its started record visible. Named creates and etag-fenced additions can be
// re-observed under a new receipt identity, never silently counted as completed from an exit code.
fn iam_bootstrap_apply() -> ProcessExit {
  let receipt = actions_variable_trimmed(name: "GUNBC_IAM_BOOTSTRAP_RECEIPT")
  if !path_segment_is_safe(raw: receipt) || !iam_bootstrap_model_admitted() { exit_failure(reason: "bootstrap requires a safe receipt identity and an admitted model") }
  else { match read_supplied_access_token() {
    SuppliedTokenUnavailable { cause } => exit_failure(reason: cause as String)
    SuppliedTokenReady { token } => {
      let started = Filesystem.WriteCreateNew(path: concat("target/gcp-iam-bootstrap-", receipt, "-started.txt"), content: "operator bootstrap started; not a convergence receipt\n")
      if !started.success { exit_failure(reason: "bootstrap receipt already exists or cannot be recorded; nothing applied") }
      else {
        let result = fold(iam_bootstrap_stages, init: IamBootstrapProgress { completed: [], refusal: "" }, f: (prior, stage) =>
          if prior.refusal != "" { prior }
          else if !iam_bootstrap_stage_admitted(stage: stage, completed: prior.completed) {
            IamBootstrapProgress { completed: prior.completed, refusal: "bootstrap stage prerequisites are not established; no further effects" }
          } else {
            let outcome = iam_bootstrap_execute_stage(stage: stage, token: token)
            let saved = Filesystem.WriteCreateNew(path: concat("target/gcp-iam-bootstrap-", receipt, "-", iam_bootstrap_stage_wire(stage: stage), ".txt"),
              content: if outcome == "" { "stage checks completed; see the stage authority for configuration/probe scope\n" } else { concat("refused: ", outcome) })
            if !saved.success { IamBootstrapProgress { completed: prior.completed, refusal: "stage receipt failed; inspect cloud state before another attempt" } }
            else if outcome != "" { IamBootstrapProgress { completed: prior.completed, refusal: outcome } }
            else { IamBootstrapProgress { completed: prior.completed + [stage], refusal: "" } }
          })
        if result.refusal == "" { ExitSuccess } else { exit_failure(reason: result.refusal) }
      }
    }
  } }
}

// Permission-test answers are diagnostic, not an authorization oracle. Missing permissions do
// not prove absence. These probes run only after the named resources and policies read back;
// both positive and negative expectations must match, and real authenticated reads follow.
type IamBootstrapProbe = IamBootstrapProbeRead { permissions: List<String> } | IamBootstrapProbeUnreadable { reason: String }

fn iam_bootstrap_probe_result(outcome: RestOutcome, permissions: List<String>?) -> IamBootstrapProbe {
  if rest_ok(o: outcome) { IamBootstrapProbeRead { permissions: match permissions { Present { value } => value Absent => [] } } }
  else { IamBootstrapProbeUnreadable { reason: rest_refusal_text(o: outcome) } }
}

fn iam_bootstrap_probe(resource: IamBootstrapResource, permissions: List<String>, token: Secret) -> IamBootstrapProbe {
  match resource {
    BootstrapProject => {
      let r = gcp.ResourceManager.TestIamPermissions(access_token: token, project_id: fleet_secrets_project_id, permissions: permissions)
      iam_bootstrap_probe_result(outcome: r.outcome, permissions: r.permissions)
    }
    BootstrapPool { pool } => {
      let r = gcp.IamAdmin.TestWorkloadIdentityPoolIamPermissions(access_token: token, project_id: fleet_secrets_project_id, pool_id: pool, permissions: permissions)
      iam_bootstrap_probe_result(outcome: r.outcome, permissions: r.permissions)
    }
    BootstrapAccount { account } => {
      let r = gcp.IamAdmin.TestServiceAccountIamPermissions(access_token: token, project_id: fleet_secrets_project_id, service_account: account, permissions: permissions)
      iam_bootstrap_probe_result(outcome: r.outcome, permissions: r.permissions)
    }
    BootstrapSecret { secret } => {
      let r = gcp.SecretManager.TestSecretIamPermissions(access_token: token, project_id: fleet_secrets_project_id, secret: secret, permissions: permissions)
      iam_bootstrap_probe_result(outcome: r.outcome, permissions: r.permissions)
    }
  }
}

fn iam_bootstrap_check_probe(resource: IamBootstrapResource, requested: List<String>, expected: List<String>, token: Secret) -> String {
  match iam_bootstrap_probe(resource: resource, permissions: requested, token: token) {
    IamBootstrapProbeUnreadable { reason } => reason
    IamBootstrapProbeRead { permissions } => if same_key_set(a: permissions, b: expected) { "" }
      else { concat(iam_bootstrap_resource_key(resource: resource), ": permission probe differs from the declared expectation") }
  }
}

fn iam_bootstrap_positive_probes(token: Secret) -> String {
  fold(filter(iam_bootstrap_capability_bindings(), b => b.cell.member == concat("serviceAccount:", iam_converge_service_account as String)), init: "", f: (prior, binding) => {
    if prior != "" { prior } else { match filter(iam_bootstrap_roles, role => (iam_bootstrap_role_name(role: role) as String) == binding.cell.role).first() {
      Absent => "apply binding has no declared custom role"
      Present { value: role } => iam_bootstrap_check_probe(resource: binding.resource, requested: iam_bootstrap_role_permissions(role: role), expected: iam_bootstrap_role_permissions(role: role), token: token)
    } }
  })
}

fn iam_bootstrap_negative_probes(token: Secret) -> String {
  let accounts = fold([iam_observe_service_account, iam_converge_service_account], init: "", f: (prior, account) =>
    if prior != "" { prior } else { iam_bootstrap_check_probe(resource: BootstrapAccount { account: account }, requested: ["iam.serviceAccounts.setIamPolicy"], expected: [], token: token) })
  if accounts != "" { accounts } else {
    iam_bootstrap_check_probe(resource: BootstrapPool { pool: gcp_iam_observe_dedicated_federation().pool_id }, requested: ["iam.workloadIdentityPoolProviders.create"], expected: [], token: token)
  }
}

fn iam_bootstrap_is_forbidden(outcome: RestOutcome) -> Bool {
  match outcome { RestStatusRefused { status, body: _ } => (status as Int) == 403 _ => false }
}

// The operator must already be authorized to impersonate for this readback. Bootstrap never
// grants itself tokenCreator to make a failed probe pass. No service-account key is created.
fn iam_bootstrap_privilege_readback(token: Secret) -> String {
  let apply = gcp.IAM.GenerateAccessToken(access_token: token, target_sa: iam_converge_service_account, lifetime: "600s")
  if !rest_ok(o: apply.outcome) { concat("apply-account readback credential unavailable; workflow trust withheld: ", rest_refusal_text(o: apply.outcome)) }
  else {
    let positive = iam_bootstrap_positive_probes(token: apply.access_token)
    if positive != "" { positive } else {
      let negative = iam_bootstrap_negative_probes(token: apply.access_token)
      if negative != "" { negative } else {
        let observer = gcp.IAM.GenerateAccessToken(access_token: token, target_sa: iam_observe_service_account, lifetime: "600s")
        if !rest_ok(o: observer.outcome) { concat("observer readback credential unavailable; workflow trust withheld: ", rest_refusal_text(o: observer.outcome)) }
        else { match observe_and_plan_estate(token: observer.access_token) {
          GcpIamEstateRefused { reasons } => concat("observer cannot establish the declared estate: ", join(reasons, "; "))
          _ => fold(gcp_iam_observe_dedicated_federation().secret_grants, init: "", f: (prior, grant) => if prior != "" { prior } else {
            let permitted = gcp.SecretManager.AccessVersion(access_token: observer.access_token, project_id: grant.target.project, secret: grant.target.secret, version: grant.target.version)
            if !rest_ok(o: permitted.outcome) { "observer cannot read its pinned approval-submission credential" }
            else {
              let denied = gcp.SecretManager.AccessVersion(access_token: apply.access_token, project_id: grant.target.project, secret: grant.target.secret, version: grant.target.version)
              if iam_bootstrap_is_forbidden(outcome: denied.outcome) { "" } else { "apply account did not receive exact HTTP 403 for the known readable approval credential; workflow trust withheld" }
            }
          })
        } }
      }
    }
  }
}
