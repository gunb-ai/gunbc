// Operator-authorized initial setup. This entry does not forge an app approval or workflow
// identity. Its credential is never a fallback in the ongoing approval-gated job.
//
// ITS RESIDUAL ROLE IS THE FIRST-TIME ROOT BOOTSTRAP ONLY. A subject declared after the root exists --
// a new secret in any grant set or custody row, a new target's account or pool -- is bound by the
// bootstrap delta (gunbc.auth.gcp_iam_bootstrap_delta classifies, gunbc.auth.gcp_iam_bootstrap_delta_run
// files one approval and applies as iam-bootstrap), never by rerunning this ceremony. What only this
// ceremony writes: the services, the custom roles, the deny policies, the project cells, and the
// trust roots -- the converge job's and the bootstrap delta job's pools, providers and accounts and
// who may become each -- none of which iam-bootstrap may touch (gunbc.auth.gcp_iam_bootstrap_model
// iam_bootstrap_cell_owner: the ceremony folds iam_bootstrap_root_ceremony_bindings and nothing else).
// Trust is last. Existing mismatched roles, providers and deny policies refuse instead of being
// adopted or patched; existing foreign policy cells are preserved through the shared reconciler.
type IamBootstrapStage = BootstrapServices | BootstrapIdentities | BootstrapTrustRootTags | BootstrapRoles | BootstrapDeny | BootstrapAuthorityCleanup | BootstrapCapabilities | BootstrapJournalBucket | BootstrapProbeAuthority | BootstrapPrivilegeReadback | BootstrapProbeCleanup | BootstrapWorkflowTrust

// A STAGE IS OWED IFF ITS DECLARED POPULATION IS NONEMPTY. `data iam_bootstrap_stages` is the run's
// folded row and stays a single-line literal (#14608: the host parser silently does not admit multi-line
// membership rows -- that is exactly how trust-root-tags and journal-bucket vanished on 2026-10-27: the
// run executed 10 stages, wrote no receipt for the other two, and cost no refusal, because every in-run
// check folded over the row itself). THE CLAIMS ARE WHAT PIN THE ROW TO THIS PREDICATE: every owed
// stage must appear, in order, or the witness refuses (test.claim.
// gcp_iam_bootstrap_journal_first_use_witness the_folded_stage_row_covers_every_owed_stage). The
// populations here are the SAME ones the capability stage writes and the post-run proof folds, so a
// stage whose work is declared cannot quietly drop out of a run.
fn iam_bootstrap_stage_owed(stage: IamBootstrapStage) -> Bool {
  match stage {
    BootstrapServices => count(iam_bootstrap_required_services) > 0
    BootstrapIdentities => count(iam_bootstrap_bound_secrets()) > 0 || count(iam_bootstrap_stage_identities(stage: BootstrapIdentities)) > 0
    BootstrapTrustRootTags => count(ceremony_trust_root_cells()) > 0
    BootstrapRoles => count(iam_bootstrap_roles) > 0
    BootstrapDeny => count(iam_bootstrap_deny_policies()) > 0
    BootstrapAuthorityCleanup => true
    BootstrapCapabilities => count(iam_bootstrap_root_ceremony_bindings()) > 0
    BootstrapJournalBucket => count(iam_bootstrap_journal_cells()) > 0
    BootstrapProbeAuthority => true
    BootstrapPrivilegeReadback => true
    BootstrapProbeCleanup => true
    BootstrapWorkflowTrust => true
  }
}

data iam_bootstrap_stages: List<IamBootstrapStage> = [BootstrapServices, BootstrapIdentities, BootstrapJournalBucket, BootstrapTrustRootTags, BootstrapRoles, BootstrapDeny, BootstrapAuthorityCleanup, BootstrapCapabilities, BootstrapProbeAuthority, BootstrapPrivilegeReadback, BootstrapProbeCleanup, BootstrapWorkflowTrust]

type IamBootstrapProgress { completed: List<IamBootstrapStage>, refusal: String }

fn iam_bootstrap_stage_admitted(stage: IamBootstrapStage, completed: List<IamBootstrapStage>) -> Bool {
  let required = match stage {
    BootstrapServices => []
    BootstrapIdentities => [BootstrapServices]
    BootstrapTrustRootTags => [BootstrapIdentities]
    BootstrapRoles => [BootstrapIdentities]
    BootstrapDeny => [BootstrapIdentities, BootstrapTrustRootTags]
    BootstrapAuthorityCleanup => [BootstrapDeny]
    BootstrapCapabilities => [BootstrapRoles, BootstrapDeny, BootstrapAuthorityCleanup, BootstrapJournalBucket]
    BootstrapJournalBucket => [BootstrapIdentities]
    BootstrapProbeAuthority => [BootstrapCapabilities]
    BootstrapPrivilegeReadback => [BootstrapCapabilities, BootstrapTrustRootTags, BootstrapProbeAuthority]
    BootstrapProbeCleanup => [BootstrapProbeAuthority]
    BootstrapWorkflowTrust => [BootstrapDeny, BootstrapAuthorityCleanup, BootstrapPrivilegeReadback, BootstrapProbeCleanup]
  }
  all(filter(required, prerequisite => iam_bootstrap_stage_owed(stage: prerequisite)), prerequisite => any(completed, done => done == prerequisite))
}

fn iam_bootstrap_stage_wire(stage: IamBootstrapStage) -> String {
  match stage { BootstrapServices => "services" BootstrapIdentities => "identities" BootstrapTrustRootTags => "trust-root-tags" BootstrapRoles => "roles" BootstrapDeny => "deny" BootstrapAuthorityCleanup => "authority-cleanup" BootstrapCapabilities => "capabilities" BootstrapJournalBucket => "journal-bucket" BootstrapProbeAuthority => "probe-authority" BootstrapProbeCleanup => "probe-cleanup" BootstrapPrivilegeReadback => "privilege-readback" BootstrapWorkflowTrust => "workflow-trust" }
}

fn iam_bootstrap_plan() -> CliWireResponse {
  let federation = gcp_iam_observe_dedicated_federation()
  let boundary = [
    concat("project ", fleet_secrets_project_id as String),
    concat("workflow provider ", federation.provider_id as String),
    concat("workflow condition ", federation.attribute_condition),
    concat("workflow principal set ", match standing_principal_set(f: federation) { Present { value: ps } => ps  Absent => "none standing (run-scoped)" }),
    concat("deny policies ", join(map(iam_bootstrap_deny_policies(), d => d.policy_id as String), ",")),
    concat("deny principal serviceAccount:", iam_converge_service_account as String),
    concat("deny permissions ", join(iam_converge_denied_permissions, ",")),
    "The ceremony creates only the three own-trust identities; every target pool, provider, account and cell is the approval-gated delta's.",
    concat("Root cells only (gunbc.auth.gcp_iam_bootstrap_model iam_bootstrap_root_ceremony_bindings); every target, grant-set and custody cell is the approval-gated delta's. Root secrets are never created here: an absent one refuses and names its value ceremony (custody_container_ceremony); present ones get only this ceremony's own cells: ", join(map(iam_bootstrap_bound_secrets(), x => x as String), ",")),
    bootstrap_authority_dependency_plan(),
    concat("Empty pool initialization requires the separately confirmed exclusive window: GUNBC_IAM_BOOTSTRAP_POOL_WINDOW=", iam_bootstrap_pool_window),
    "Initializer: declared empty pool only -> one journaled publication -> exact independent readback with etag -> normal CAS updates. Uncertain publication is never replayed.",
    "Temporary authority intent: GUNBC_IAM_BOOTSTRAP_AUTHORITY_ID + GUNBC_IAM_BOOTSTRAP_AUTHORITY_EXPIRES_AT (canonical UTC, at most one hour).",
    "Temporary probe intent: GUNBC_IAM_BOOTSTRAP_PROBE_ID + GUNBC_IAM_BOOTSTRAP_PROBE_EXPIRES_AT (canonical UTC, at most one hour); run identity: GUNBC_IAM_BOOTSTRAP_RECEIPT.",
    concat("The grant targets ", iam_bootstrap_operator_member, " after verified Google subject ", iam_bootstrap_operator_subject, "; retry cannot renew or republish it."),
  ]
  let roles = map(iam_bootstrap_roles, r => join(["role ", iam_bootstrap_role_name(role: r) as String, " permissions=", join(iam_bootstrap_role_permissions(role: r), ",")], ""))
  let cells = map(iam_bootstrap_stage_bindings(stage: BootstrapCapabilities) + iam_bootstrap_trust_bindings(), b => join([
    "binding ", iam_bootstrap_resource_key(resource: b.resource), " ", cell_preimage(c: b.cell),
  ], ""))
  let input_refusals = dedicated_federation_input_refusals(federations: iam_bootstrap_identity_federations())
  CliWirePrintable { bytes: join(["Bootstrap stages: ", join(map(iam_bootstrap_stages, s => iam_bootstrap_stage_wire(stage: s)), " -> "), "\n", join(boundary + roles + cells, "\n")], ""),
    exit: if !iam_bootstrap_model_admitted() { exit_failure(reason: "bootstrap model does not preserve the declared trust boundary") }
      else if count(input_refusals) > 0 { exit_failure(reason: join(input_refusals, "; ")) } else { ExitSuccess } }
}

fn iam_bootstrap_ensure_identity(f: DedicatedFederation, own_trust: Bool, token: Secret) -> String {
  let before = observe_and_classify(f: f, token: token)
  match before {
    FederationUnclassified { reasons } => join(reasons, "; ")
    FederationPermissionDenied { pool: _, account: _, causes } => concat("the operator token is denied a declared subject: ", join(causes, "; "))
    FederationClassified { create_pool, create_provider, create_account } => {
      let created = create_absent_subjects(f: f, token: token, c: FederationClassified {
        create_pool: create_pool, create_provider: own_trust && create_provider, create_account: create_account })
      if created != "" { created } else {
        let after = observe_and_classify(f: f, token: token)
        match after {
          FederationUnclassified { reasons } => join(reasons, "; ")
          FederationPermissionDenied { pool: _, account: _, causes } => concat("the operator token is denied a declared subject: ", join(causes, "; "))
          FederationClassified { create_pool: pool_missing, create_provider: _, create_account: account_missing } =>
            if pool_missing || account_missing || (own_trust && !federation_fully_present(c: after)) {
              concat(f.label, ": named creation is not yet established by readback; no rights granted")
            } else { "" }
        }
      }
    }
  }
}

// THE BARE-SECRET ROUTE (iam_bootstrap_ensure_bare_secret). The ceremony creates no trust-root secret: the
// secrets it binds a cell on (iam_bootstrap_bound_secrets) are trust roots, whose containers are their
// value ceremonies' (custody_container_ceremony), so an absent one refuses and names that ceremony. Every
// delta-owned secret (a grant set's, a target's) is created bare by the delta apply through this same
// route, so no recurring identity needs the project-level secretmanager.secrets.create. Bare means no
// version: the container carries no payload until the mint flow adds one.
//
// A CREATE IS JOURNALED ACROSS RUNS AND WORKSPACES, in the durable bootstrap journal
// (gunbc.auth.gcp_iam_bootstrap_journal, a GCS bucket of gunbai-secrets), never in the checkout: a rerun
// in another workspace must see the same elections. A GET that answers 404 after an ambiguous create does not establish
// absence (gunbc.secret_provision_actuator SecretContainerCreation), so the fact that a create may
// have committed must outlive the run that issued it. Per secret and operation (the bootstrap
// receipt, or the approved digest for the delta) the journal holds an election written BEFORE CreateSecret, then exactly one of:
//   closed   -- the container was observed present (after a definite create, or later);
//   refused  -- the service definitely refused; a new operation may elect again;
//   disposed -- an explicit operator disposition (iam_bootstrap_custody_create_dispose).
// An election with none of these is UNRESOLVED and blocks every later automatic create of that
// secret, even when a later GET answers absent; observing the container present settles it.
type CustodyContainerObservation = CustodyObservedPresent | CustodyObservedAbsent | CustodyObservationRefused { cause: String }

type CustodyContainerCreateOutcome = CustodyCreated | CustodyCreateRefused { cause: String } | CustodyCreateOutcomeUnknown { cause: String }

type CustodyCreateJournal = CustodyJournalRead { unresolved: List<String> } | CustodyJournalUnreadable { cause: String }

type CustodyContainerStep
  = CustodyContainerLeave
  | CustodyContainerSettle { operations: List<String> }
  | CustodyContainerCreateBare
  | CustodyContainerRunCeremonyFirst { ceremony: TrustRootCeremony }
  | CustodyContainerRefuse { reason: String }

// WHO MAY CREATE A SECRET'S CONTAINER is a separate fact from who owns a cell on it (side chat on
// gunbc#14360): IamBootstrapApply owns iam-observe's read cell on the approval-submission MAC key, never
// the key's creation. A trust-root secret's container is its value ceremony's, the ceremony that binds
// its other root cells (gunbc.auth.gcp_iam_trust_roots ceremony_trust_root_cells), which creates it with
// its pinned first version.
fn custody_container_ceremony(secret: NonEmptyStr) -> TrustRootCeremony? {
  match filter(ceremony_trust_root_cells(), t => (t.secret as String) == (secret as String) && match t.ceremony { IamBootstrapApply => false  _ => true }).first() {
    Present { value: t } => Present { value: t.ceremony }
    Absent => none
  }
}

type CustodyAfterCreate = CustodyReadBack | CustodyCreateRefusedDefinitely { reason: String } | CustodyCreateStops { reason: String }

// ONE OPERATION'S MARKS AS LISTED in the bootstrap journal (gunbc.auth.gcp_iam_bootstrap_journal): a
// mark is a create-once object, so its presence is the record and its name is its identity.
type CustodyOperationRecords {
  operation: String
  elected: Bool
  closed: Bool
  refused: Bool
  disposed: Bool
}

fn custody_records_of(secret: NonEmptyStr, names: List<String>) -> List<CustodyOperationRecords> {
  let key = iam_bootstrap_resource_key(resource: BootstrapSecret { secret: secret })
  map(journal_listed_consents(subject: JournalBareSecretCreate, resource_key: key, names: names), op => CustodyOperationRecords {
    operation: op,
    elected: journal_has(names: names, subject: JournalBareSecretCreate, resource_key: key, consent: op, mark: JournalElection),
    closed: journal_has(names: names, subject: JournalBareSecretCreate, resource_key: key, consent: op, mark: JournalClosure),
    refused: journal_has(names: names, subject: JournalBareSecretCreate, resource_key: key, consent: op, mark: JournalRefusal),
    disposed: journal_has(names: names, subject: JournalBareSecretCreate, resource_key: key, consent: op, mark: JournalDisposal),
  })
}

// A RESOLUTION WITHOUT ITS ELECTION, or an operation that is not a safe identity, makes the journal
// unreadable, which refuses, rather than settling an election and admitting a re-create.
fn custody_journal_of(secret: NonEmptyStr, records: List<CustodyOperationRecords>) -> CustodyCreateJournal {
  let invalid = filter(records, r => !path_segment_is_safe(raw: r.operation) || (!r.elected && (r.closed || r.refused || r.disposed)))
  if count(invalid) > 0 {
    CustodyJournalUnreadable { cause: join(["create journal records close an election that is absent or name an unsafe operation: ", join(map(invalid, r => r.operation), ",")], "") }
  } else {
    CustodyJournalRead { unresolved: map(filter(records, r => r.elected && !(r.closed || r.refused || r.disposed)), r => r.operation) }
  }
}

fn custody_container_step(secret: NonEmptyStr, o: CustodyContainerObservation, journal: CustodyCreateJournal) -> CustodyContainerStep {
  match custody_container_ceremony(secret: secret) {
    Present { value: c } => match o {
      CustodyObservedPresent => CustodyContainerLeave
      CustodyObservedAbsent => CustodyContainerRunCeremonyFirst { ceremony: c }
      CustodyObservationRefused { cause } => CustodyContainerRefuse { reason: join([secret as String, ": the container could not be observed: ", cause], "") }
    }
    Absent => bootstrap_custody_container_step(secret: secret, o: o, journal: journal)
  }
}

fn bootstrap_custody_container_step(secret: NonEmptyStr, o: CustodyContainerObservation, journal: CustodyCreateJournal) -> CustodyContainerStep {
  match journal {
    CustodyJournalUnreadable { cause } => CustodyContainerRefuse { reason: join([secret as String, ": the create journal is unreadable, so an earlier ambiguous create cannot be excluded: ", cause], "") }
    CustodyJournalRead { unresolved } => match o {
      CustodyObservationRefused { cause } => CustodyContainerRefuse { reason: join([secret as String, ": the container could not be observed: ", cause], "") }
      CustodyObservedPresent => if count(unresolved) == 0 { CustodyContainerLeave } else { CustodyContainerSettle { operations: unresolved } }
      CustodyObservedAbsent => if count(unresolved) == 0 { CustodyContainerCreateBare } else {
        CustodyContainerRefuse { reason: join([secret as String, ": an earlier create is unresolved (", join(unresolved, ","), "), and absence after an ambiguous create is not evidence; no automatic create until the container is observed or the operator disposes it (iam_bootstrap_custody_create_dispose)"], "") }
      }
    }
  }
}

fn custody_after_create(secret: NonEmptyStr, c: CustodyContainerCreateOutcome) -> CustodyAfterCreate {
  match c {
    CustodyCreated => CustodyReadBack
    CustodyCreateRefused { cause } => CustodyCreateRefusedDefinitely { reason: join([secret as String, ": bare container creation refused: ", cause], "") }
    CustodyCreateOutcomeUnknown { cause } => CustodyCreateStops { reason: join([secret as String, ": bare container creation outcome unknown; its election stays unresolved and blocks every later automatic create: ", cause], "") }
  }
}

fn custody_observation_of(o: SecretObservationOutcome) -> CustodyContainerObservation {
  match o {
    SecretContainerObserved { container: _ } => CustodyObservedPresent
    SecretContainerAbsent { project: _, secret_id: _ } => CustodyObservedAbsent
    SecretObservationRefused { cause } => CustodyObservationRefused { cause: cause as String }
  }
}

fn custody_create_outcome_of(c: SecretContainerCreation) -> CustodyContainerCreateOutcome {
  match c {
    SecretContainerCreated { container: _ } => CustodyCreated
    SecretContainerCreationRefused { cause } => CustodyCreateRefused { cause: cause as String }
    SecretContainerCreationOutcomeUnknown { cause } => CustodyCreateOutcomeUnknown { cause: cause as String }
  }
}

fn custody_journal_read(secret: NonEmptyStr, token: Secret) -> CustodyCreateJournal {
  match journal_list(bucket: iam_bootstrap_journal_bucket, subject: JournalBareSecretCreate, resource_key: iam_bootstrap_resource_key(resource: BootstrapSecret { secret: secret }), token: token) {
    JournalListingUnreadable { cause } => CustodyJournalUnreadable { cause: cause as String }
    JournalListed { names } => custody_journal_of(secret: secret, records: custody_records_of(secret: secret, names: names))
  }
}

fn custody_mark(secret: NonEmptyStr, operation: String, mark: JournalMark, token: Secret) -> JournalMarkOutcome {
  journal_mark_outcome(o: journal_mark(bucket: iam_bootstrap_journal_bucket, subject: JournalBareSecretCreate, resource_key: iam_bootstrap_resource_key(resource: BootstrapSecret { secret: secret }), consent: operation, mark: mark, token: token))
}

fn custody_marked(o: JournalMarkOutcome) -> Bool {
  match o { JournalMarkRecorded => true  JournalMarkAlreadyPresent => true  JournalMarkRefused { cause: _ } => false }
}

fn custody_journal_close(secret: NonEmptyStr, operations: List<String>, token: Secret) -> BareSecretOutcome {
  fold(operations, init: BareSecretSettled, f: (prior, op) => match prior {
    BareSecretRefused { reason: _ } => prior
    BareSecretSettled => if custody_marked(o: custody_mark(secret: secret, operation: op, mark: JournalClosure, token: token)) { BareSecretSettled }
      else { bare_secret_refused(reason: join([secret as String, ": observed present but the closing journal mark for ", op, " could not be recorded"], "")) }
  })
}

// THE ONE BARE-CREATE ROUTE, called by the ceremony (its receipt as the operation) and by the bootstrap
// delta (the approved digest as the operation): elect in the durable journal BEFORE CreateSecret; an
// unresolved election under any operation blocks every later automatic create, whatever a later GET
// answers; observing the container present settles it.
// WHAT THE ONE BARE-CREATE ROUTE ANSWERS: settled is a constructor (review 82849); the ceremony's stage
// text is rendered from it at the ceremony's call site only.
type BareSecretOutcome = BareSecretSettled | BareSecretRefused { reason: NonEmptyStr }

fn bare_secret_refused(reason: String) -> BareSecretOutcome {
  let stated = if reason == "" { "bare secret create refused with no stated cause" } else { reason }
  BareSecretRefused { reason: stated as NonEmptyStr }
}


fn iam_bootstrap_ensure_bare_secret(secret: NonEmptyStr, operation: String, token: Secret) -> BareSecretOutcome {
  if !path_segment_is_safe(raw: operation) { bare_secret_refused(reason: "a bare secret create needs a safe operation identity") }
  else { match custody_container_step(secret: secret, o: custody_observation_of(o: observe_secret_container(project: fleet_secrets_project_id, secret_id: secret, token: token)), journal: custody_journal_read(secret: secret, token: token)) {
    CustodyContainerLeave => BareSecretSettled
    CustodyContainerSettle { operations } => custody_journal_close(secret: secret, operations: operations, token: token)
    CustodyContainerRefuse { reason } => bare_secret_refused(reason: reason)
    CustodyContainerRunCeremonyFirst { ceremony } => bare_secret_refused(reason: join([secret as String, ": a trust-root secret whose container is its value ceremony's; this ceremony creates no trust-root secret. Run ", trust_root_ceremony_entry(ceremony: ceremony), " first, then rerun this ceremony to bind its own cell"], ""))
    CustodyContainerCreateBare => match custody_mark(secret: secret, operation: operation, mark: JournalElection, token: token) {
      JournalMarkRefused { cause } => bare_secret_refused(reason: join([secret as String, ": the create election could not be recorded; no create issued: ", cause as String], ""))
      JournalMarkAlreadyPresent => bare_secret_refused(reason: concat(secret as String, ": this operation already elected a create; it is not issued twice"))
      JournalMarkRecorded => match custody_after_create(secret: secret, c: custody_create_outcome_of(c: create_secret_container(project: fleet_secrets_project_id, secret_id: secret, token: token))) {
        CustodyCreateStops { reason } => bare_secret_refused(reason: reason)
        CustodyCreateRefusedDefinitely { reason } =>
          if custody_marked(o: custody_mark(secret: secret, operation: operation, mark: JournalRefusal, token: token)) { bare_secret_refused(reason: reason) }
          else { bare_secret_refused(reason: concat(reason, "; the refusal could not be journaled, so the election stays unresolved")) }
        CustodyReadBack =>
          match custody_observation_of(o: observe_secret_container(project: fleet_secrets_project_id, secret_id: secret, token: token)) {
            CustodyObservedPresent => custody_journal_close(secret: secret, operations: [operation], token: token)
            CustodyObservedAbsent => bare_secret_refused(reason: concat(secret as String, ": created but not yet visible on readback; the election stays unresolved and no rights are granted"))
            CustodyObservationRefused { cause } => bare_secret_refused(reason: join([secret as String, ": created but readback refused; the election stays unresolved: ", cause], ""))
          }
      }
    }
  } }
}

fn iam_bootstrap_ensure_custody_container(secret: NonEmptyStr, token: Secret) -> String {
  match iam_bootstrap_ensure_bare_secret(secret: secret, operation: actions_variable_trimmed(name: "GUNBC_IAM_BOOTSTRAP_RECEIPT"), token: token) {
    BareSecretSettled => ""
    BareSecretRefused { reason } => reason as String
  }
}

// THE ONLY RETIREMENT OF AN UNRESOLVED CREATE THAT NO OBSERVATION SETTLES: an operator names the
// secret and the operation, having established out of band that the create did not commit, and the
// disposition is a create-once journal mark. It refuses for an unsafe operation, an election that does
// not exist, or one already closed, refused or disposed. The operator's token reaches the journal.
fn iam_bootstrap_custody_create_dispose() -> ProcessExit {
  let secret = actions_variable_trimmed(name: "GUNBC_IAM_BOOTSTRAP_CUSTODY_SECRET")
  let op = actions_variable_trimmed(name: "GUNBC_IAM_BOOTSTRAP_CUSTODY_OPERATION")
  if secret == "" || !path_segment_is_safe(raw: op) { exit_failure(reason: "a secret name and a safe operation identity are required") }
  else { match read_supplied_access_token() {
    SuppliedTokenUnavailable { cause } => exit_failure(reason: cause as String)
    SuppliedTokenReady { token } => match custody_journal_read(secret: secret as NonEmptyStr, token: token) {
      CustodyJournalUnreadable { cause } => exit_failure(reason: cause)
      CustodyJournalRead { unresolved } => if !any(unresolved, x => x == op) { exit_failure(reason: "no unresolved create election exists for that secret and operation") }
        else if custody_marked(o: custody_mark(secret: secret as NonEmptyStr, operation: op, mark: JournalDisposal, token: token)) { ExitSuccess }
        else { exit_failure(reason: "the disposition could not be recorded") }
    }
  } }
}

fn iam_bootstrap_ensure_role(role: IamBootstrapRole, token: Secret) -> String {
  match gcp.IamAdmin.GetProjectRole(access_token: token, project_id: fleet_secrets_project_id, role_id: iam_bootstrap_role_id(role: role)) {
    RestAnswered { answer: seen } =>
      if iam_bootstrap_role_matches(role: role, name: seen.name, permissions: seen.included_permissions, stage: seen.stage, deleted: seen.deleted) { "" }
      else { concat(iam_bootstrap_role_name(role: role) as String, ": existing role differs; no automatic privilege expansion or adoption") }
    RestRefused { refusal: seen_refusal } =>
      if !outcome_is_not_found(o: seen_refusal) { rest_refusal_text(o: seen_refusal) }
      else {
        match gcp.IamAdmin.CreateProjectRole(access_token: token, project_id: fleet_secrets_project_id,
          role_id: iam_bootstrap_role_id(role: role), title: iam_bootstrap_role_id(role: role), permissions: iam_bootstrap_role_permissions(role: role)) {
          RestRefused { refusal: made_refusal } => rest_refusal_text(o: made_refusal)
          RestAnswered { answer: _ } =>
            match gcp.IamAdmin.GetProjectRole(access_token: token, project_id: fleet_secrets_project_id, role_id: iam_bootstrap_role_id(role: role)) {
              RestAnswered { answer: check } =>
                if iam_bootstrap_role_matches(role: role, name: check.name, permissions: check.included_permissions, stage: check.stage, deleted: check.deleted) { "" }
                else { concat(iam_bootstrap_role_name(role: role) as String, ": created role did not read back exactly; no rights granted") }
              RestRefused { refusal: _ } => concat(iam_bootstrap_role_name(role: role) as String, ": created role did not read back exactly; no rights granted")
            }
        }
      }
  }
}

// EVERY DECLARED DENY POLICY, in order; the first refusal stops the rest.
fn iam_bootstrap_ensure_deny(token: Secret) -> String {
  fold(iam_bootstrap_deny_policies(), init: "", f: (prior, d) => if prior != "" { prior } else { iam_bootstrap_ensure_deny_bounded(policy: d, token: token, remaining: 0) })
}

fn iam_bootstrap_ensure_deny_bounded(policy: IamBootstrapDenyPolicy, token: Secret, remaining: Int) -> String {
  match gcp.IamDeny.GetPolicy(access_token: token, attachment_point: iam_bootstrap_attachment_point(), policy_id: policy.policy_id) {
    RestAnswered { answer: seen } =>
      if iam_bootstrap_deny_rules_match(observed: seen.rules, declared: policy.rules) { "" } else { concat(policy.policy_id as String, ": existing bootstrap deny policy differs; refusing to weaken or adopt it") }
    RestRefused { refusal: seen_refusal } =>
      if !outcome_is_not_found(o: seen_refusal) { rest_refusal_text(o: seen_refusal) }
      else {
        if remaining > 0 && !iam_bootstrap_current_authority_live() { "authority deadline or clock does not admit another deny installation attempt" }
        else {
          match gcp.IamDeny.CreatePolicy(access_token: token, attachment_point: iam_bootstrap_attachment_point(), policy_id: policy.policy_id, rules: policy.rules) {
            RestRefused { refusal: made_refusal } =>
              if bootstrap_deny_retry_admitted(refusal: made_refusal, remaining: remaining, live: iam_bootstrap_current_authority_live()) {
                if sleep_delay_seconds_second_carrier_projection(duration: second(count: 10)) {
                  iam_bootstrap_ensure_deny_bounded(policy: policy, token: token, remaining: remaining - 1)
                } else { "deny authority propagation wait failed" }
              } else { rest_refusal_text(o: made_refusal) }
            RestAnswered { answer: _ } => iam_bootstrap_deny_creation_readback(policy: policy, token: token, remaining: 6)
          }
        }
      }
  }
}

// A POLICY READ HAS TWO ARMS, and each reading is a function of exactly one: the answered body, or
// the refusal. A not-found refusal is the resource's absence; any other refusal is unreadable.
fn iam_bootstrap_policy_reading(bindings: List<GcpBinding>?, etag: String, version: Int?) -> PolicyReading {
  PolicyObserved { policy: gcp_policy_from_wire(bindings: bindings, etag: etag, version: version) }
}

fn iam_bootstrap_policy_refused(refusal: RestRefusal) -> PolicyReading {
  if outcome_is_not_found(o: refusal) { PolicyResourceAbsent }
  else { PolicyUnreadable { cause: rest_refusal_text(o: refusal) } }
}

// Preserve a successful but unfenced pool read as an explicit unmet dependency. A refused pool read
// takes iam_bootstrap_policy_refused, so transport failure and resource absence keep their standing.
fn iam_bootstrap_pool_policy_reading(bindings: List<GcpBinding>?, etag: String?, version: Int?) -> PolicyReading {
  match etag {
    Present { value: revision } => if revision != "" {
      iam_bootstrap_policy_reading(bindings: bindings, etag: revision, version: version)
    } else { PolicyUnreadable { cause: "pool policy publication prerequisite unmet: successful read has no concurrency token; unconditional replacement is not admitted" } }
    Absent => PolicyUnreadable { cause: "pool policy publication prerequisite unmet: successful read has no concurrency token; unconditional replacement is not admitted" }
  }
}

fn iam_bootstrap_read_policy(resource: IamBootstrapResource, token: Secret) -> PolicyReading {
  match resource {
    BootstrapProject =>
      match gcp.ResourceManager.GetIamPolicy(access_token: token, project_id: fleet_secrets_project_id) {
        RestAnswered { answer: r } => iam_bootstrap_policy_reading(bindings: r.bindings, etag: r.etag, version: r.version)
        RestRefused { refusal } => iam_bootstrap_policy_refused(refusal: refusal)
      }
    BootstrapPool { pool } =>
      match gcp.IamAdmin.GetWorkloadIdentityPoolIamPolicy(access_token: token, project_id: fleet_secrets_project_id, pool_id: pool) {
        RestAnswered { answer: r } =>
          if (match r.audit_configs { Absent => false Present { value: rows } => count(rows) != 0 }) {
            PolicyUnreadable { cause: "pool policy audit configuration is outside bootstrap representation; no replacement" }
          } else { iam_bootstrap_pool_policy_reading(bindings: r.bindings, etag: r.etag, version: r.version) }
        RestRefused { refusal } => iam_bootstrap_policy_refused(refusal: refusal)
      }
    BootstrapAccount { account } =>
      match gcp.IamAdmin.GetServiceAccountIamPolicy(access_token: token, project_id: fleet_secrets_project_id, service_account: account) {
        RestAnswered { answer: r } => iam_bootstrap_policy_reading(bindings: r.bindings, etag: r.etag, version: r.version)
        RestRefused { refusal } => iam_bootstrap_policy_refused(refusal: refusal)
      }
    BootstrapSecret { secret } =>
      match gcp.SecretManager.GetSecretIamPolicy(access_token: token, project_id: fleet_secrets_project_id, secret: secret) {
        RestAnswered { answer: r } => iam_bootstrap_policy_reading(bindings: r.bindings, etag: r.etag, version: r.version)
        RestRefused { refusal } => iam_bootstrap_policy_refused(refusal: refusal)
      }
    BootstrapBucket { bucket } =>
      match gcp.Storage.GetBucketIamPolicy(access_token: token, bucket: bucket) {
        RestAnswered { answer: r } => iam_bootstrap_policy_reading(bindings: r.bindings, etag: r.etag, version: r.version)
        RestRefused { refusal } => iam_bootstrap_policy_refused(refusal: refusal)
      }
  }
}

// A POLICY WRITE'S ANSWER IS NOT ITS EVIDENCE -- every write here is followed by an independent
// readback -- so the answered arm carries nothing. The refusal stays the transport's own value,
// unclassified, because the authority path decides on its status (bootstrap_authority_publication_refused).
type IamBootstrapPolicyWrite = BootstrapPolicyWritten | BootstrapPolicyWriteRefused { refusal: RestRefusal }

fn iam_bootstrap_write_policy(resource: IamBootstrapResource, policy: GcpPolicy, token: Secret) -> IamBootstrapPolicyWrite {
  match resource {
    BootstrapProject => match gcp.ResourceManager.SetIamPolicy(access_token: token, project_id: fleet_secrets_project_id, policy: policy) {
      RestAnswered { answer: _ } => BootstrapPolicyWritten
      RestRefused { refusal } => BootstrapPolicyWriteRefused { refusal: refusal }
    }
    BootstrapPool { pool } => match gcp.IamAdmin.SetWorkloadIdentityPoolIamPolicy(access_token: token, project_id: fleet_secrets_project_id, pool_id: pool, policy: policy) {
      RestAnswered { answer: _ } => BootstrapPolicyWritten
      RestRefused { refusal } => BootstrapPolicyWriteRefused { refusal: refusal }
    }
    BootstrapAccount { account } => match gcp.IamAdmin.SetServiceAccountIamPolicy(access_token: token, project_id: fleet_secrets_project_id, service_account: account, policy: policy) {
      RestAnswered { answer: _ } => BootstrapPolicyWritten
      RestRefused { refusal } => BootstrapPolicyWriteRefused { refusal: refusal }
    }
    BootstrapSecret { secret } => match gcp.SecretManager.SetSecretIamPolicy(access_token: token, project_id: fleet_secrets_project_id, secret: secret, policy: policy) {
      RestAnswered { answer: _ } => BootstrapPolicyWritten
      RestRefused { refusal } => BootstrapPolicyWriteRefused { refusal: refusal }
    }
    BootstrapBucket { bucket } => match gcp.Storage.SetBucketIamPolicy(access_token: token, bucket: bucket, bindings: policy.bindings, etag: policy.etag, version: policy.version) {
      RestAnswered { answer: _ } => BootstrapPolicyWritten
      RestRefused { refusal } => BootstrapPolicyWriteRefused { refusal: refusal }
    }
  }
}

// THE JOURNAL BUCKET EXISTS BEFORE ITS CELLS ARE BOUND: created by the ceremony when absent (409 means
// present), with uniform bucket-level access and public access prevented.
// THE JOURNAL BUCKET'S IDENTITY AND ACCESS MODEL, joined to the declared rows on all five axes (name,
// project number, location, uniform bucket-level access, public access prevention).
type JournalBucketIdentity = JournalBucketAdmitted | JournalBucketMismatch { reason: NonEmptyStr }

fn journal_bucket_identity(bucket: NonEmptyStr, name: String, project_number: String?, location: String?, uniform_access: Bool?, public_access_prevention: String?) -> JournalBucketIdentity {
  if name != (bucket as String) { JournalBucketMismatch { reason: "the journal bucket readback names another bucket" } }
  else if !(match project_number { Present { value: p } => p == fleet_secrets_project_number  Absent => false }) { JournalBucketMismatch { reason: "the journal bucket is not in the declared project (or its project number is unreadable)" } }
  else if !(match location { Present { value: l } => l == (iam_bootstrap_journal_bucket_location as String)  Absent => false }) { JournalBucketMismatch { reason: "the journal bucket is not in the declared location" } }
  else if !(match uniform_access { Present { value: u } => u == iam_bootstrap_journal_bucket_uniform_access  Absent => false }) { JournalBucketMismatch { reason: "the journal bucket's uniform bucket-level access is not the declared setting" } }
  else if !(match public_access_prevention { Present { value: p } => p == (iam_bootstrap_journal_bucket_public_access_prevention as String)  Absent => false }) { JournalBucketMismatch { reason: "the journal bucket's public access prevention is not the declared setting" } }
  else { JournalBucketAdmitted }
}

// A create (or a 409 meaning a retried or concurrent create got there first) is not its evidence: the
// bucket is read back before its cells are bound, which is what makes InsertBucket's idempotent
// annotation true for this caller.
fn journal_bucket_answer_identity(bucket: NonEmptyStr, b: GcsBucketWire) -> JournalBucketIdentity {
  let ubla = match b.iam_configuration { Absent => none  Present { value: c } => match c.uniform_bucket_level_access { Absent => none  Present { value: u } => u.enabled } }
  let pap = match b.iam_configuration { Absent => none  Present { value: c } => c.public_access_prevention }
  journal_bucket_identity(bucket: bucket, name: b.name, project_number: b.project_number, location: b.location, uniform_access: ubla, public_access_prevention: pap)
}

fn journal_bucket_identity_text(i: JournalBucketIdentity) -> String {
  match i { JournalBucketAdmitted => ""  JournalBucketMismatch { reason } => concat("journal bucket refused before any journal cell is bound: ", reason as String) }
}

fn iam_bootstrap_journal_bucket_readback(bucket: NonEmptyStr, token: Secret) -> String {
  match gcp.Storage.GetBucket(access_token: token, bucket: bucket) {
    RestAnswered { answer: b } => journal_bucket_identity_text(i: journal_bucket_answer_identity(bucket: bucket, b: b))
    RestRefused { refusal } => concat("journal bucket created or present but its readback refused: ", rest_refusal_text(o: refusal))
  }
}

fn iam_bootstrap_ensure_journal_bucket(bucket: NonEmptyStr, token: Secret) -> String {
  match gcp.Storage.GetBucket(access_token: token, bucket: bucket) {
    RestAnswered { answer: b } => journal_bucket_identity_text(i: journal_bucket_answer_identity(bucket: bucket, b: b))
    RestRefused { refusal } => if !outcome_is_not_found(o: refusal) { concat("journal bucket unreadable: ", rest_refusal_text(o: refusal)) }
      else { match gcp.Storage.InsertBucket(access_token: token, project_id: fleet_secrets_project_id, bucket: bucket, location: iam_bootstrap_journal_bucket_location,
          uniform_bucket_level_access: iam_bootstrap_journal_bucket_uniform_access, public_access_prevention: iam_bootstrap_journal_bucket_public_access_prevention) {
        RestAnswered { answer: _ } => iam_bootstrap_journal_bucket_readback(bucket: bucket, token: token)
        RestRefused { refusal: c } => match c { RestStatusRefused { status, body: _ } => if (status as Int) == 409 { iam_bootstrap_journal_bucket_readback(bucket: bucket, token: token) } else { concat("journal bucket create refused: ", rest_refusal_text(o: c)) }  _ => concat("journal bucket create refused: ", rest_refusal_text(o: c)) }
      } }
  }
}

fn iam_bootstrap_ensure_binding(binding: IamBootstrapBinding, token: Secret) -> String {
  let prerequisite = match binding.resource {
    BootstrapPool { pool } => iam_bootstrap_initialize_pool_policy(pool: pool, token: token)
    BootstrapProject => ""
    BootstrapAccount { account: _ } => ""
    BootstrapSecret { secret: _ } => ""
    BootstrapBucket { bucket: _ } => ""
  }
  if prerequisite != "" { prerequisite } else { iam_bootstrap_ensure_fenced_binding(binding: binding, token: token) }
}

fn iam_bootstrap_ensure_fenced_binding(binding: IamBootstrapBinding, token: Secret) -> String {
  match iam_bootstrap_read_policy(resource: binding.resource, token: token) {
    PolicyResourceAbsent => concat(iam_bootstrap_resource_key(resource: binding.resource), ": binding subject absent")
    PolicyUnreadable { cause } => cause
    PolicyObserved { policy: before } => match reconcile_gcp_policy(observed: before, desired_owned: [binding.cell], owned_universe: GcpIamOwnedCellUniverse { cells: [binding.cell] }) {
      GcpPolicyRepresentationLossy { conditional_roles: _ } => "policy representation loses conditions; refusing write"
      GcpPolicyAlreadyConverged { policy: _ } => ""
      GcpPolicyDeltaRequired { policy: after, added: _, removed, preserved: _ } => if count(removed) != 0 || before.etag == "" {
        "bootstrap policy addition needs a nonempty etag and may remove no cells"
      } else {
        match iam_bootstrap_write_policy(resource: binding.resource, policy: after, token: token) {
          BootstrapPolicyWriteRefused { refusal } => rest_refusal_text(o: refusal)
          BootstrapPolicyWritten => match iam_bootstrap_read_policy(resource: binding.resource, token: token) {
            PolicyObserved { policy: checked } => if gcp_cell_in(c: binding.cell, xs: gcp_policy_cells(p: checked)) { "" } else { "policy write answered but the desired binding is absent on readback" }
            PolicyResourceAbsent => "policy write answered but independent readback is unavailable"
            PolicyUnreadable { cause: _ } => "policy write answered but independent readback is unavailable"
          }
        }
      }
    }
  }
}

// ── THE CEREMONY EXECUTES A PLAN: one pure selector per stage, read by the executor and the plan text ──
// The stage dispatcher folds exactly the selector's value through a generic executor that names no
// population, so which cells and identities the ceremony touches is decided here and nowhere else, and
// test.claim.gcp_iam_bootstrap_population_split_witness reads the same selectors.
fn iam_bootstrap_stage_bindings_over(stage: IamBootstrapStage, targets: List<DedicatedFederation>, grant_set_secrets: List<NonEmptyStr>) -> List<IamBootstrapBinding> {
  match stage {
    BootstrapCapabilities => iam_bootstrap_root_ceremony_bindings_over(targets: targets, grant_set_secrets: grant_set_secrets)
    BootstrapServices => []  BootstrapIdentities => []  BootstrapTrustRootTags => []  BootstrapRoles => []  BootstrapDeny => []  BootstrapAuthorityCleanup => []
    BootstrapJournalBucket => []  BootstrapProbeAuthority => []  BootstrapPrivilegeReadback => []  BootstrapProbeCleanup => []  BootstrapWorkflowTrust => []
  }
}

fn iam_bootstrap_stage_identities_over(stage: IamBootstrapStage, targets: List<DedicatedFederation>) -> List<IamBootstrapIdentity> {
  match stage {
    BootstrapIdentities => iam_bootstrap_ceremony_identity_population_over(targets: targets)
    BootstrapServices => []  BootstrapCapabilities => []  BootstrapTrustRootTags => []  BootstrapRoles => []  BootstrapDeny => []  BootstrapAuthorityCleanup => []
    BootstrapJournalBucket => []  BootstrapProbeAuthority => []  BootstrapPrivilegeReadback => []  BootstrapProbeCleanup => []  BootstrapWorkflowTrust => []
  }
}

fn iam_bootstrap_stage_bindings(stage: IamBootstrapStage) -> List<IamBootstrapBinding> {
  iam_bootstrap_stage_bindings_over(stage: stage, targets: gcp_iam_converge_targets, grant_set_secrets: gcp_iam_converge_grant_set_secrets())
}

fn iam_bootstrap_stage_identities(stage: IamBootstrapStage) -> List<IamBootstrapIdentity> {
  iam_bootstrap_stage_identities_over(stage: stage, targets: gcp_iam_converge_targets)
}

// THE GENERIC EXECUTORS: each folds what it is handed and names no population.
fn iam_bootstrap_execute_bindings(bindings: List<IamBootstrapBinding>, token: Secret) -> String {
  fold(bindings, init: "", f: (prior, binding) => if prior != "" { prior } else { iam_bootstrap_ensure_binding(binding: binding, token: token) })
}

fn iam_bootstrap_execute_identities(identities: List<IamBootstrapIdentity>, token: Secret) -> String {
  fold(identities, init: "", f: (prior, i) => if prior != "" { prior } else { iam_bootstrap_ensure_identity(f: i.federation, own_trust: i.own_trust, token: token) })
}

// ── THE TRUST-ROOT TAG STAGE (gunbc.auth.gcp_iam_bootstrap_model iam_bootstrap_trust_root_wall_rule) ──
// Ensures the project-parented key gunbai-secrets/gunbc-trust-root, its value root, and a binding of
// that value on each own-trust account, each read back. A create whose Operation is not done refuses
// (no poll is modeled for Resource Manager operations; the stage is idempotent, so a rerun observes).
// It runs before the deny stage, so the wall's condition names a tag that exists.
type TrustRootTagsOutcome = TrustRootTagsBound | TrustRootTagsRefused { reason: NonEmptyStr }

fn trust_root_tags_refused(reason: String) -> TrustRootTagsOutcome {
  let stated = if reason == "" { "trust-root tag stage refused with no stated cause" } else { reason }
  TrustRootTagsRefused { reason: stated as NonEmptyStr }
}

fn trust_root_tags_stage_text(o: TrustRootTagsOutcome) -> String {
  match o { TrustRootTagsBound => ""  TrustRootTagsRefused { reason } => reason as String }
}

type TagResourceStanding = TagResourcePresent { name: NonEmptyStr } | TagResourcePending { what: String } | TagResourceRefused { reason: String }

fn tag_create_standing(what: String, done: Bool?, error: GoogleRpcStatus?) -> TagResourceStanding {
  match error {
    Present { value: e } => TagResourceRefused { reason: join([what, ": create failed: ", match e.message { Present { value: m } => m  Absent => "no message" }], "") }
    Absent => TagResourcePending { what: what }
  }
}

fn ensure_trust_root_tag_key(token: Secret) -> TagResourceStanding {
  match gcp.ResourceManager.GetNamespacedTagKey(access_token: token, namespaced_name: iam_bootstrap_trust_root_tag_key_namespaced()) {
    RestAnswered { answer: k } => match trust_root_tag_key_admission(name: k.name, parent: k.parent, short_name: k.short_name, namespaced_name: k.namespaced_name) {
      TrustRootTagAdmitted { name } => TagResourcePresent { name: name }
      TrustRootTagRefused { reason } => TagResourceRefused { reason: reason }
    }
    RestRefused { refusal } => if !outcome_is_not_found(o: refusal) { TagResourceRefused { reason: rest_refusal_text(o: refusal) } }
      else { match gcp.ResourceManager.CreateTagKey(access_token: token, parent: iam_bootstrap_trust_root_tag_key_parent(), short_name: iam_bootstrap_trust_root_tag_key_short, description: "gunbc trust root: iam-bootstrap is denied account writes on resources carrying it") {
        RestAnswered { answer: a } => tag_create_standing(what: "trust-root tag key", done: a.done, error: a.error)
        RestRefused { refusal: c } => TagResourceRefused { reason: concat("trust-root tag key create refused: ", rest_refusal_text(o: c)) }
      } }
  }
}

fn ensure_trust_root_tag_value(key_name: NonEmptyStr, token: Secret) -> TagResourceStanding {
  match gcp.ResourceManager.GetNamespacedTagValue(access_token: token, namespaced_name: iam_bootstrap_trust_root_tag_value_namespaced()) {
    RestAnswered { answer: v } => match trust_root_tag_value_admission(key_name: key_name as String, name: v.name, parent: v.parent, short_name: v.short_name, namespaced_name: v.namespaced_name) {
      TrustRootTagAdmitted { name } => TagResourcePresent { name: name }
      TrustRootTagRefused { reason } => TagResourceRefused { reason: reason }
    }
    RestRefused { refusal } => if !outcome_is_not_found(o: refusal) { TagResourceRefused { reason: rest_refusal_text(o: refusal) } }
      else { match gcp.ResourceManager.CreateTagValue(access_token: token, parent: key_name, short_name: iam_bootstrap_trust_root_tag_value_short, description: "the account is a gunbc trust root") {
        RestAnswered { answer: a } => tag_create_standing(what: "trust-root tag value", done: a.done, error: a.error)
        RestRefused { refusal: c } => TagResourceRefused { reason: concat("trust-root tag value create refused: ", rest_refusal_text(o: c)) }
      } }
  }
}

fn tag_bound_on(parent: String, value_name: NonEmptyStr, token: Secret) -> TagBindingReading? {
  match gcp.ResourceManager.ListTagBindings(access_token: token, parent: parent as NonEmptyStr) {
    RestRefused { refusal: _ } => none
    RestAnswered { answer: l } => Present { value: trust_root_tag_binding_reading(parent: parent, value_name: value_name, bindings: l.tag_bindings, next_page_token: l.next_page_token) }
  }
}

fn ensure_trust_root_tag_binding(parent: String, value_name: NonEmptyStr, token: Secret) -> TrustRootTagsOutcome {
  match tag_bound_on(parent: parent, value_name: value_name, token: token) {
    Absent => trust_root_tags_refused(reason: concat(parent, ": tag bindings unreadable"))
    Present { value: TagBindingIncomplete } => trust_root_tags_refused(reason: concat(parent, ": tag binding listing has another page and no exact row; a partial listing is not absence"))
    Present { value: TagBindingEstablished } => TrustRootTagsBound
    Present { value: TagBindingAbsent } => match gcp.ResourceManager.CreateTagBinding(access_token: token, parent: parent as NonEmptyStr, tag_value: value_name) {
      RestRefused { refusal } => trust_root_tags_refused(reason: join([parent, ": tag binding create refused: ", rest_refusal_text(o: refusal)], ""))
      RestAnswered { answer: a } => match a.error {
        Present { value: e } => trust_root_tags_refused(reason: join([parent, ": tag binding failed: ", match e.message { Present { value: m } => m  Absent => "no message" }], ""))
        Absent => match tag_bound_on(parent: parent, value_name: value_name, token: token) {
          Present { value: TagBindingEstablished } => TrustRootTagsBound
          Present { value: TagBindingAbsent } => trust_root_tags_refused(reason: concat(parent, ": tag binding not yet visible on readback; rerun the ceremony once it is"))
          Present { value: TagBindingIncomplete } => trust_root_tags_refused(reason: concat(parent, ": tag binding readback listing has another page and no exact row; a partial listing is not absence"))
          Absent => trust_root_tags_refused(reason: concat(parent, ": tag binding readback unreadable"))
        }
      }
    }
  }
}

fn iam_bootstrap_ensure_trust_root_tags(token: Secret) -> TrustRootTagsOutcome {
  match ensure_trust_root_tag_key(token: token) {
    TagResourceRefused { reason } => trust_root_tags_refused(reason: reason)
    TagResourcePending { what } => trust_root_tags_refused(reason: concat(what, " creation is not yet done; rerun the ceremony once it is"))
    TagResourcePresent { name: key } => match ensure_trust_root_tag_value(key_name: key, token: token) {
      TagResourceRefused { reason } => trust_root_tags_refused(reason: reason)
      TagResourcePending { what } => trust_root_tags_refused(reason: concat(what, " creation is not yet done; rerun the ceremony once it is"))
      TagResourcePresent { name: value } => fold(iam_bootstrap_trust_root_tag_parents(), init: TrustRootTagsBound, f: (acc, parent) => match acc {
        TrustRootTagsRefused { reason: _ } => acc
        TrustRootTagsBound => ensure_trust_root_tag_binding(parent: parent, value_name: value, token: token)
      })
    }
  }
}

fn iam_bootstrap_execute_stage(stage: IamBootstrapStage, token: Secret) -> String {
  match stage {
    BootstrapServices => fold(iam_bootstrap_required_services, init: "", f: (prior, api) => if prior != "" { prior } else { iam_bootstrap_ensure_service(service: api, token: token) })
    BootstrapIdentities => {
      let identities = iam_bootstrap_execute_identities(identities: iam_bootstrap_stage_identities(stage: stage), token: token)
      if identities != "" { identities } else { fold(iam_bootstrap_bound_secrets(), init: "", f: (prior, secret) =>
        if prior != "" { prior } else { iam_bootstrap_ensure_custody_container(secret: secret, token: token) }) }
    }
    BootstrapTrustRootTags => trust_root_tags_stage_text(o: iam_bootstrap_ensure_trust_root_tags(token: token))
    BootstrapRoles => fold(iam_bootstrap_roles, init: "", f: (prior, role) => if prior != "" { prior } else { iam_bootstrap_ensure_role(role: role, token: token) })
    BootstrapDeny => fold(iam_bootstrap_deny_policies(), init: "", f: (prior, d) => if prior != "" { prior } else {
      match gcp.IamDeny.GetPolicy(access_token: token, attachment_point: iam_bootstrap_attachment_point(), policy_id: d.policy_id) {
        RestAnswered { answer: seen } =>
          if iam_bootstrap_deny_rules_match(observed: seen.rules, declared: d.rules) { "" } else { concat(d.policy_id as String, ": existing deny policy differs; no authority granted") }
        RestRefused { refusal: seen_refusal } =>
          if !outcome_is_not_found(o: seen_refusal) { rest_refusal_text(o: seen_refusal) }
          else {
            let authority = iam_bootstrap_authority_converge(token: token, withdrawing: false)
            if authority != "" { authority } else { iam_bootstrap_ensure_deny_bounded(policy: d, token: token, remaining: 30) }
          }
      }
    })
    BootstrapAuthorityCleanup => iam_bootstrap_authority_converge(token: token, withdrawing: true)
    BootstrapCapabilities => iam_bootstrap_execute_bindings(bindings: iam_bootstrap_stage_bindings(stage: stage), token: token)
    BootstrapJournalBucket => iam_bootstrap_ensure_journal_bucket(bucket: iam_bootstrap_journal_bucket, token: token)
    BootstrapProbeAuthority => iam_bootstrap_probe_authority_converge(token: token, withdrawing: false)
    BootstrapPrivilegeReadback => iam_bootstrap_privilege_readback(token: token)
    BootstrapProbeCleanup => iam_bootstrap_probe_authority_converge(token: token, withdrawing: true)
    BootstrapWorkflowTrust => {
      let guarded = iam_bootstrap_ensure_deny(token: token)
      if guarded != "" { guarded } else { fold(iam_bootstrap_trust_bindings(), init: "", f: (prior, binding) => if prior != "" { prior } else { iam_bootstrap_ensure_binding(binding: binding, token: token) }) }
    }
  }
}

// A create-only local receipt starts before cloud effects. Each stage has its own receipt; a
// process loss leaves its started record visible. Named creates and etag-fenced additions can be
// re-observed under a new receipt identity, never silently counted as completed from an exit code.
// ── THE POST-RUN PROOF OF THE CELLS THIS CEREMONY OWNS ─────────────────────────
// The delta refuses ROOT CEREMONY CELLS MISSING over exactly the cells the owner relation
// (gunbc.auth.gcp_iam_bootstrap_model iam_bootstrap_cell_owner) hands to this ceremony, and its refusal
// tells the operator this ceremony repairs them. That claim is only honest if the ceremony itself can
// fail when it has not established them. It could not: every in-run check folded over whatever the
// folded stage list happened to execute, and the observer readback deliberately withholds nothing from
// ceremony-owned cells the observer cannot reach (their standing is this ceremony's own work). So a
// ceremony that never ran the journal-bucket or trust-root-tags stage wrote nothing, produced no
// refusal, and exited 0 while the next fleet-converge refused on its own behalf (the 2026-10-27
// incident, receipt iam-ceremony-20261027T055742Z: 10 of 12 stage receipts, no setIamPolicy in the
// REST log, ExitSuccess). THE CEREMONY NOW PROVES ITS OWN POPULATION WITH ITS OWN TOKEN AFTER THE
// FOLD, AND REFUSES LOUDLY IF ANY CELL IT OWNS IS NOT ESTABLISHED. Fail-closed: an absent or unreadable
// policy counts as not established. The wording of each cell is ceremony_cell_phrase, the same phrase
// the delta's refusal uses, so the two sides cannot drift into two dialects (DESIGN section 3).
type CeremonySubjectReading { subject: IamBootstrapResource, reading: PolicyReading }

fn ceremony_unestablished_cell_phrases(readings: List<CeremonySubjectReading>) -> List<String> {
  flat_map(iam_bootstrap_ceremony_owned_cells(), b =>
    match filter(readings, r => iam_bootstrap_resource_key(resource: r.subject) == iam_bootstrap_resource_key(resource: b.resource)).first() {
      Absent => [ceremony_cell_phrase(b: b)]
      Present { value: r } => match r.reading {
        PolicyObserved { policy } => if gcp_cell_in(c: b.cell, xs: gcp_policy_cells(p: policy)) { [] } else { [ceremony_cell_phrase(b: b)] }
        PolicyResourceAbsent => [ceremony_cell_phrase(b: b)]
        PolicyUnreadable { cause } => [concat(ceremony_cell_phrase(b: b), " (policy unreadable: ", cause, ")")]
      }
    })
}

// THE POPULATION THE POST-RUN PROOF COVERS: every cell the owner relation gives this ceremony. THE
// SAME FILTER THE DELTA'S ROOT-CELL CHECK FOLDS (root_cell_repair_ceremony over the same roster), so
// one population drives both sides of the ceremony/delta meaning (DESIGN section 2).
fn iam_bootstrap_ceremony_owned_cells() -> List<IamBootstrapBinding> {
  distinct_by_key(xs: iam_bootstrap_root_ceremony_bindings(), key: b => concat(iam_bootstrap_resource_key(resource: b.resource), cell_preimage(c: b.cell)))
}

fn ceremony_owned_proof_refusal(readings: List<CeremonySubjectReading>) -> String {
  let outstanding = ceremony_unestablished_cell_phrases(readings: readings)
  if count(outstanding) == 0 { "" } else {
    concat("ROOT CEREMONY CELLS NOT ESTABLISHED: this ceremony owns these cells and its own policy read does not show them bound: ", join(outstanding, "; "))
  }
}

fn iam_bootstrap_apply() -> ProcessExit {
  let receipt = actions_variable_trimmed(name: "GUNBC_IAM_BOOTSTRAP_RECEIPT")
  let input_refusals = dedicated_federation_input_refusals(federations: iam_bootstrap_identity_federations())
  if !path_segment_is_safe(raw: receipt) || !iam_bootstrap_model_admitted() { exit_failure(reason: "bootstrap requires a safe receipt identity and an admitted model") }
  else if count(input_refusals) > 0 { exit_failure(reason: join(input_refusals, "; ")) }
  else { match read_supplied_access_token() {
    SuppliedTokenUnavailable { cause } => exit_failure(reason: cause as String)
    SuppliedTokenReady { token } => {
      let started = Filesystem.WriteCreateNew(path: concat("target/gcp-iam-bootstrap-", receipt, "-started.txt"), content: "operator bootstrap started; not a convergence receipt\n")
      if !started.success { exit_failure(reason: "bootstrap receipt already exists or cannot be recorded; nothing applied") }
      else {
        let result = fold(iam_bootstrap_stages, init: IamBootstrapProgress { completed: [], refusal: "" }, f: (prior, stage) =>
          if prior.refusal != "" { prior }
          else if !iam_bootstrap_stage_admitted(stage: stage, completed: prior.completed) {
            IamBootstrapProgress { completed: prior.completed, refusal: "bootstrap stage prerequisites are not established; no further effects" }
          } else {
            let outcome = iam_bootstrap_execute_stage(stage: stage, token: token)
            let saved = Filesystem.WriteCreateNew(path: concat("target/gcp-iam-bootstrap-", receipt, "-", iam_bootstrap_stage_wire(stage: stage), ".txt"),
              content: if outcome == "" { "stage checks completed; see the stage authority for configuration/probe scope\n" } else { concat("refused: ", outcome) })
            if !saved.success { IamBootstrapProgress { completed: prior.completed, refusal: "stage receipt failed; inspect cloud state before another attempt" } }
            else if outcome != "" { IamBootstrapProgress { completed: prior.completed, refusal: outcome } }
            else { IamBootstrapProgress { completed: prior.completed + [stage], refusal: "" } }
          })
        // THE POST-RUN PROOF RUNS AFTER THE FOLD AND BEFORE THE AUTHORITY WITHDRAWALS: it measures what
        // this run established, read with the ceremony's own token, so a stage that vanished from the
        // folded list -- or whose write silently no-oped -- cannot green the ceremony.
        let proof_readings = map(roster_subjects(roster: iam_bootstrap_ceremony_owned_cells()), s =>
          CeremonySubjectReading { subject: s, reading: iam_bootstrap_read_policy(resource: s, token: token) })
        let owned_proof = ceremony_owned_proof_refusal(readings: proof_readings)
        let probe_cleanup = iam_bootstrap_probe_authority_converge(token: token, withdrawing: true)
        let deny_cleanup = iam_bootstrap_authority_converge(token: token, withdrawing: true)
        let cleanup = concat(probe_cleanup, if probe_cleanup != "" && deny_cleanup != "" { "; " } else { "" }, deny_cleanup)
        if result.refusal == "" && cleanup == "" && owned_proof == "" { ExitSuccess }
        else { exit_failure(reason: concat(result.refusal, if owned_proof == "" { "" } else { concat(if result.refusal == "" { "" } else { "; " }, owned_proof) }, if cleanup == "" { "" } else { concat("; authority cleanup outstanding: ", cleanup) })) }
      }
    }
  } }
}

// Permission-test answers are diagnostic, not an authorization oracle. Missing permissions do
// not prove absence. These probes run only after the named resources and policies read back;
// both positive and negative expectations must match, and real authenticated reads follow.
type IamBootstrapProbe = IamBootstrapProbeRead { permissions: List<String> } | IamBootstrapProbeUnreadable { reason: String }

fn iam_bootstrap_probe_result(permissions: List<String>?) -> IamBootstrapProbe {
  IamBootstrapProbeRead { permissions: match permissions { Present { value } => value Absent => [] } }
}

fn iam_bootstrap_probe_refused(refusal: RestRefusal) -> IamBootstrapProbe {
  IamBootstrapProbeUnreadable { reason: rest_refusal_text(o: refusal) }
}

fn iam_bootstrap_probe(resource: IamBootstrapResource, permissions: List<String>, token: Secret) -> IamBootstrapProbe {
  match resource {
    BootstrapProject => match gcp.ResourceManager.TestIamPermissions(access_token: token, project_id: fleet_secrets_project_id, permissions: permissions) {
      RestAnswered { answer: r } => iam_bootstrap_probe_result(permissions: r.permissions)
      RestRefused { refusal } => iam_bootstrap_probe_refused(refusal: refusal)
    }
    BootstrapPool { pool } => match gcp.IamAdmin.TestWorkloadIdentityPoolIamPermissions(access_token: token, project_id: fleet_secrets_project_id, pool_id: pool, permissions: permissions) {
      RestAnswered { answer: r } => iam_bootstrap_probe_result(permissions: r.permissions)
      RestRefused { refusal } => iam_bootstrap_probe_refused(refusal: refusal)
    }
    BootstrapAccount { account } => match gcp.IamAdmin.TestServiceAccountIamPermissions(access_token: token, project_id: fleet_secrets_project_id, service_account: account, permissions: permissions) {
      RestAnswered { answer: r } => iam_bootstrap_probe_result(permissions: r.permissions)
      RestRefused { refusal } => iam_bootstrap_probe_refused(refusal: refusal)
    }
    BootstrapSecret { secret } => match gcp.SecretManager.TestSecretIamPermissions(access_token: token, project_id: fleet_secrets_project_id, secret: secret, permissions: permissions) {
      RestAnswered { answer: r } => iam_bootstrap_probe_result(permissions: r.permissions)
      RestRefused { refusal } => iam_bootstrap_probe_refused(refusal: refusal)
    }
    BootstrapBucket { bucket: _ } => IamBootstrapProbeUnreadable { reason: "bucket permission probes are not modeled; the journal cells are read back by policy, not probed" }
  }
}

fn iam_bootstrap_check_probe(resource: IamBootstrapResource, requested: List<String>, expected: List<String>, token: Secret) -> String {
  match iam_bootstrap_probe(resource: resource, permissions: requested, token: token) {
    IamBootstrapProbeUnreadable { reason } => reason
    IamBootstrapProbeRead { permissions } => if same_key_set(a: permissions, b: expected) { "" }
      else { concat(iam_bootstrap_resource_key(resource: resource), ": permission probe differs from the declared expectation") }
  }
}

fn iam_bootstrap_positive_probes(token: Secret) -> String {
  fold(filter(iam_bootstrap_stage_bindings(stage: BootstrapCapabilities), b => b.cell.member == concat("serviceAccount:", iam_converge_service_account as String)), init: "", f: (prior, binding) => {
    if prior != "" { prior } else { match filter(iam_bootstrap_roles, role => (iam_bootstrap_role_name(role: role) as String) == binding.cell.role).first() {
      Absent => "apply binding has no declared custom role"
      Present { value: role } => iam_bootstrap_check_probe(resource: binding.resource, requested: iam_bootstrap_role_permissions(role: role), expected: iam_bootstrap_role_permissions(role: role), token: token)
    } }
  })
}

fn iam_bootstrap_negative_probes(token: Secret) -> String {
  let accounts = fold([iam_observe_service_account, iam_converge_service_account, iam_bootstrap_service_account], init: "", f: (prior, account) =>
    if prior != "" { prior } else { iam_bootstrap_check_probe(resource: BootstrapAccount { account: account }, requested: ["iam.serviceAccounts.setIamPolicy"], expected: [], token: token) })
  let pool = if accounts != "" { accounts } else {
    fold([gcp_iam_observe_dedicated_federation().pool_id, gcp_iam_bootstrap_wif_pool_id], init: "", f: (prior, pool) =>
      if prior != "" { prior } else { iam_bootstrap_check_probe(resource: BootstrapPool { pool: pool }, requested: ["iam.workloadIdentityPoolProviders.create"], expected: [], token: token) })
  }
  if pool != "" { pool } else { fold(gcp_iam_converge_grant_set_secrets(), init: "", f: (prior, secret) =>
    if prior != "" { prior } else { iam_bootstrap_check_probe(resource: BootstrapSecret { secret: secret }, requested: grant_set_payload_permissions, expected: [], token: token) }) }
}

// iam-bootstrap's EFFECTIVE tag-detach authority, read as itself, on both axes: the account axis on each
// trust root and the tag-value axis on the trust-root value. The operator's answer on the same probe is
// the control that it discriminates (tag_detach_probe_verdict).
fn tag_detach_axis_text(what: String, v: TagDetachProbeVerdict) -> String {
  match v {
    TagDetachAbsent => ""
    TagDetachUndiscriminating => concat(what, ": the tag-detach probe does not discriminate (the operator's answer lacks it); workflow trust withheld")
    TagDetachHeld => concat(what, ": iam-bootstrap holds tag-detach authority; workflow trust withheld")
  }
}

fn tag_detach_probe_read(o: IamBootstrapProbe) -> List<String>? {
  match o { IamBootstrapProbeRead { permissions } => Present { value: permissions }  IamBootstrapProbeUnreadable { reason: _ } => none }
}

// The trust-root value the probe may count: the key, then the value, each read by its namespaced name and
// admitted by the same folds the tag stage uses. Absence is a refusal here: the stage ran before.
fn admitted_trust_root_tag_value(token: Secret) -> TrustRootTagAdmission {
  match gcp.ResourceManager.GetNamespacedTagKey(access_token: token, namespaced_name: iam_bootstrap_trust_root_tag_key_namespaced()) {
    RestRefused { refusal } => TrustRootTagRefused { reason: concat("the trust-root tag key is unreadable: ", rest_refusal_text(o: refusal)) }
    RestAnswered { answer: k } => match trust_root_tag_key_admission(name: k.name, parent: k.parent, short_name: k.short_name, namespaced_name: k.namespaced_name) {
      TrustRootTagRefused { reason } => TrustRootTagRefused { reason: reason }
      TrustRootTagAdmitted { name: key } => match gcp.ResourceManager.GetNamespacedTagValue(access_token: token, namespaced_name: iam_bootstrap_trust_root_tag_value_namespaced()) {
        RestRefused { refusal } => TrustRootTagRefused { reason: concat("the trust-root tag value is unreadable: ", rest_refusal_text(o: refusal)) }
        RestAnswered { answer: v } => trust_root_tag_value_admission(key_name: key as String, name: v.name, parent: v.parent, short_name: v.short_name, namespaced_name: v.namespaced_name)
      }
    }
  }
}

fn tag_value_probe(value_name: NonEmptyStr, token: Secret) -> List<String>? {
  match gcp.ResourceManager.TestTagValueIamPermissions(access_token: token, tag_value: value_name, permissions: iam_bootstrap_tag_value_detach_permissions) {
    RestAnswered { answer: r } => Present { value: match r.permissions { Present { value: ps } => ps  Absent => [] } }
    RestRefused { refusal: _ } => none
  }
}

fn iam_bootstrap_tag_detach_probe(token: Secret) -> String {
  match iam_bootstrap_probe_token(token: token, account: iam_bootstrap_service_account, remaining: 85) {
    BootstrapProbeTokenRefused { reason } => concat("bootstrap-account readback credential unavailable; workflow trust withheld: ", reason)
    BootstrapProbeTokenReady { access_token: bootstrap_token } => {
      let accounts = fold(iam_bootstrap_trust_root_tagged_accounts(), init: "", f: (prior, account) =>
        if prior != "" { prior } else {
          let r = BootstrapAccount { account: account }
          match tag_detach_probe_read(o: iam_bootstrap_probe(resource: r, permissions: iam_bootstrap_tag_detach_permissions, token: token)) {
            Absent => concat(account as String, ": the operator's tag-detach control is unreadable; workflow trust withheld")
            Present { value: control } => match tag_detach_probe_read(o: iam_bootstrap_probe(resource: r, permissions: iam_bootstrap_tag_detach_permissions, token: bootstrap_token)) {
              Absent => concat(account as String, ": iam-bootstrap's tag-detach probe is unreadable; workflow trust withheld")
              Present { value: subject } => tag_detach_axis_text(what: account as String, v: tag_detach_probe_verdict(requested: iam_bootstrap_tag_detach_permissions, control: control, subject: subject))
            }
          }
        })
      if accounts != "" { accounts } else {
        match admitted_trust_root_tag_value(token: token) {
          TrustRootTagRefused { reason } => concat(reason, "; the detach probe counts nothing, workflow trust withheld")
          TrustRootTagAdmitted { name: value_name } => match tag_value_probe(value_name: value_name, token: token) {
            Absent => "the operator's tag-value detach control is unreadable; workflow trust withheld"
            Present { value: control } => match tag_value_probe(value_name: value_name, token: bootstrap_token) {
              Absent => "iam-bootstrap's tag-value detach probe is unreadable; workflow trust withheld"
              Present { value: subject } => tag_detach_axis_text(what: value_name as String, v: tag_detach_probe_verdict(requested: iam_bootstrap_tag_value_detach_permissions, control: control, subject: subject))
            }
          }
        }
      }
    }
  }
}

fn iam_bootstrap_is_forbidden(refusal: RestRefusal) -> Bool {
  match refusal { RestStatusRefused { status, body: _ } => (status as Int) == 403  RestTransportRefused { cause: _ } => false  RestBodyUndecodable { status: _, cause: _ } => false }
}

// Readback uses a temporary, exact-account token permission for the verified operator.
// Its grant is retired before workflow trust; no signing permission or account key is added.
// ── THE ROOT-BOUNDARY READBACK (side chat on gunbc#14360, first use) ─────────────────────────
// Before workflow trust the ceremony proves ITS OWN population only: every root cell it binds, read in
// place by the observer, plus the probes above (roles, the deny boundary, the absence of forbidden
// reach). A target that is absent or unbound is the delta's work (SubjectNotBootstrapped there, by
// design), so it must not block the trust that lets the delta run at all.
type RootReadback = RootReadbackAdmitted | RootReadbackRefused { reason: NonEmptyStr }

fn iam_bootstrap_root_readback_roster() -> List<IamBootstrapBinding> {
  iam_bootstrap_stage_bindings(stage: BootstrapCapabilities)
}

fn iam_bootstrap_root_readback_verdict(delta: BootstrapDelta) -> RootReadback {
  match delta {
    BootstrapObserved { root_residual: _ } => RootReadbackAdmitted
    BootstrapDeltaRequired { subjects, root_residual: _ } => RootReadbackRefused { reason: concat("root cells are not read back; workflow trust withheld: ", join(map(subjects, x => subject_not_bootstrapped_text(s: x)), " || ")) as NonEmptyStr }
    BootstrapDeltaRefused { reasons } => RootReadbackRefused { reason: concat("the root readback refuses; workflow trust withheld: ", join(reasons, "; ")) as NonEmptyStr }
  }
}

fn iam_bootstrap_privilege_readback(token: Secret) -> String {
  match iam_bootstrap_probe_token(token: token, account: iam_converge_service_account, remaining: 85) {
    BootstrapProbeTokenRefused { reason } => concat("apply-account readback credential unavailable; workflow trust withheld: ", reason)
    BootstrapProbeTokenReady { access_token: apply_token } => {
      let positive = iam_bootstrap_positive_probes(token: apply_token)
      if positive != "" { positive } else {
        let negative = iam_bootstrap_negative_probes(token: apply_token)
        let detach = if negative != "" { negative } else { iam_bootstrap_tag_detach_probe(token: token) }
        if detach != "" { detach } else {
          match iam_bootstrap_probe_token(token: token, account: iam_observe_service_account, remaining: 85) {
            BootstrapProbeTokenRefused { reason } => concat("observer readback credential unavailable; workflow trust withheld: ", reason)
            BootstrapProbeTokenReady { access_token: observer_token } => {
              let roster = iam_bootstrap_root_readback_roster()
              let observed = map(roster_subjects(roster: roster), s => observe_bootstrap_subject(subject: s, token: observer_token))
              match iam_bootstrap_root_readback_verdict(delta: bootstrap_delta_over(roster: roster, observations: observed)) {
                RootReadbackRefused { reason } => reason as String
                RootReadbackAdmitted => iam_bootstrap_observer_secret_readback(observer_token: observer_token, apply_token: apply_token)
              }
            }
          }
        }
      }
    }
  }
}

// The observer reads its pinned approval-submission credential and the apply account is refused it.
fn iam_bootstrap_observer_secret_readback(observer_token: Secret, apply_token: Secret) -> String {
  fold(gcp_iam_observe_dedicated_federation().secret_grants, init: "", f: (prior, grant) => if prior != "" { prior } else {
    match gcp.SecretManager.AccessVersion(access_token: observer_token, project_id: grant.target.project, secret: grant.target.secret, version: grant.target.version) {
      RestRefused { refusal: _ } => "observer cannot read its pinned approval-submission credential"
      RestAnswered { answer: _ } =>
        match gcp.SecretManager.AccessVersion(access_token: apply_token, project_id: grant.target.project, secret: grant.target.secret, version: grant.target.version) {
          RestRefused { refusal: denied } => if iam_bootstrap_is_forbidden(refusal: denied) { "" } else { "apply account did not receive exact HTTP 403 for the known readable approval credential; workflow trust withheld" }
          RestAnswered { answer: _ } => "apply account did not receive exact HTTP 403 for the known readable approval credential; workflow trust withheld"
        }
    }
  })
}

type IamBootstrapProbeToken = BootstrapProbeTokenReady { access_token: Secret } | BootstrapProbeTokenRefused { reason: String }

// Permission propagation may lag readback. Retry only explicit permission refusals,
// within both a bounded count and the original absolute authority deadline.
fn iam_bootstrap_probe_token(token: Secret, account: ServiceAccountEmail, remaining: Int) -> IamBootstrapProbeToken {
  match gcp.IAM.GenerateAccessToken(access_token: token, target_sa: account, lifetime: "600s") {
    RestAnswered { answer: generated } => BootstrapProbeTokenReady { access_token: generated.access_token }
    RestRefused { refusal: generated_refusal } => {
      let intent = BootstrapAuthorityIntent { operation: actions_variable_trimmed(name: "GUNBC_IAM_BOOTSTRAP_PROBE_ID"),
        expires_at: actions_variable_trimmed(name: "GUNBC_IAM_BOOTSTRAP_PROBE_EXPIRES_AT") as Timestamp }
      let live = match approval_instant_now() { Absent => false Present { value: now } => bootstrap_authority_may_grant(intent: intent, now: now) }
      if bootstrap_deny_retry_admitted(refusal: generated_refusal, remaining: remaining, live: live) {
        if sleep_delay_seconds_second_carrier_projection(duration: second(count: 5)) {
          iam_bootstrap_probe_token(token: token, account: account, remaining: remaining - 1)
        } else { BootstrapProbeTokenRefused { reason: "probe permission propagation wait failed" } }
      } else { BootstrapProbeTokenRefused { reason: rest_refusal_text(o: generated_refusal) } }
    }
  }
}

// These local bootstrap records are durable before effects and stay outside the cloud authority
// they establish. They must travel with recovery. Read failure is never treated as absence.
type IamAuthorityRecord = AuthorityRecordAbsent | AuthorityRecordPresent { bytes: String } | AuthorityRecordRefused

fn iam_authority_record(name: String) -> IamAuthorityRecord {
  let listed = Filesystem.List(path: "target")
  if !listed.success { AuthorityRecordRefused } else {
    let read = Filesystem.Read(path: concat("target/", name))
    let present = filesystem_listing_names_entry(listing: listed.entries, name: name)
    if present && read.success { AuthorityRecordPresent { bytes: read.content } }
    else if !present && !read.success { AuthorityRecordAbsent }
    else { AuthorityRecordRefused }
  }
}

fn iam_authority_record_matches(record: IamAuthorityRecord, wire: String) -> Bool {
  match record { AuthorityRecordAbsent => true AuthorityRecordPresent { bytes } => bytes == wire AuthorityRecordRefused => false }
}

// A reading that is not an observed policy carries no revision; absent and unreadable are one case here.
fn iam_bootstrap_observed_policy(reading: PolicyReading) -> GcpPolicy? {
  match reading { PolicyObserved { policy } => Present { value: policy }  PolicyResourceAbsent => none  PolicyUnreadable { cause: _ } => none }
}

fn iam_authority_record_present(record: IamAuthorityRecord) -> Bool {
  match record { AuthorityRecordPresent { bytes: _ } => true  AuthorityRecordAbsent => false  AuthorityRecordRefused => false }
}

fn iam_authority_pin(name: String, wire: String) -> Bool {
  let saved = Filesystem.WriteCreateNew(path: concat("target/", name), content: wire)
  if saved.success { true } else { match iam_authority_record(name: name) {
    AuthorityRecordPresent { bytes } => bytes == wire
    AuthorityRecordAbsent => false
    AuthorityRecordRefused => false
  } }
}

// The fixed subject comes from the operator's explicit authorization; only operation identity
// and absolute deadline are inputs. They are pinned before publication and cannot drift on retry.
// THESE AUTHORITY RECORDS STAY IN target/ (ruling by warm-crane-219, 2026-10-19): the temporary-authority
// intents precede the bootstrap journal's bucket, which this very ceremony creates, and the ceremony runs
// on the operator workstation, whose checkout persists between its runs. Trigger: if the ceremony ever
// runs in CI (an ephemeral workspace), these records move to the journal
// (gunbc.auth.gcp_iam_bootstrap_journal) like the pool and bare-create records did.
fn iam_bootstrap_authority_converge(token: Secret, withdrawing: Bool) -> String {
  let operation = actions_variable_trimmed(name: "GUNBC_IAM_BOOTSTRAP_AUTHORITY_ID")
  let expiry = actions_variable_trimmed(name: "GUNBC_IAM_BOOTSTRAP_AUTHORITY_EXPIRES_AT")
  if operation == "" && expiry == "" {
    if withdrawing { "" } else { "dependency unsatisfied: temporary deny administration needs an authority operation ID and absolute expiry; verified organization IAM write authority is its prerequisite" }
  } else {
    let intent = BootstrapAuthorityIntent { operation: operation, expires_at: expiry as Timestamp }
    if !bootstrap_authority_intent_valid(intent: intent) { "authority intent has an invalid operation identity or UTC deadline" }
    else {
      let actor = if withdrawing { "" } else { iam_bootstrap_operator_readback(token: token) }
      if actor != "" { actor } else {
        let ancestry = if withdrawing { "" } else { iam_bootstrap_authority_ancestry(token: token) }
        if ancestry != "" { ancestry } else { iam_bootstrap_authority_reconcile(intent: intent, token: token, withdrawing: withdrawing) }
      }
    }
  }
}

fn iam_bootstrap_authority_reconcile(intent: BootstrapAuthorityIntent, token: Secret, withdrawing: Bool) -> String {
  iam_bootstrap_cell_authority_reconcile(intent: intent, stem: concat("gcp-iam-authority-", intent.operation),
    wire: bootstrap_authority_intent_wire(intent: intent), cell: bootstrap_authority_cell(intent: intent),
    resource: BootstrapOrganizationAuthority, token: token, withdrawing: withdrawing)
}

type IamBootstrapAuthorityResource = BootstrapOrganizationAuthority | BootstrapAccountAuthority { resource: IamBootstrapResource }

fn iam_bootstrap_authority_resource_read(resource: IamBootstrapAuthorityResource, token: Secret) -> PolicyReading {
  match resource {
    BootstrapOrganizationAuthority => iam_bootstrap_organization_policy_read(token: token)
    BootstrapAccountAuthority { resource: account } => iam_bootstrap_read_policy(resource: account, token: token)
  }
}

fn iam_bootstrap_authority_resource_write(resource: IamBootstrapAuthorityResource, policy: GcpPolicy, token: Secret) -> IamBootstrapPolicyWrite {
  match resource {
    BootstrapOrganizationAuthority => match gcp.ResourceManager.SetOrganizationIamPolicy(access_token: token, organization: iam_bootstrap_authority_organization, policy: policy) {
      RestAnswered { answer: _ } => BootstrapPolicyWritten
      RestRefused { refusal } => BootstrapPolicyWriteRefused { refusal: refusal }
    }
    BootstrapAccountAuthority { resource: account } => iam_bootstrap_write_policy(resource: account, policy: policy, token: token)
  }
}

// Deny administration and probe access share one election, deadline, CAS and cleanup protocol.
fn iam_bootstrap_cell_authority_reconcile(intent: BootstrapAuthorityIntent, stem: String, wire: String,
  cell: GcpIamBindingCell, resource: IamBootstrapAuthorityResource, token: Secret, withdrawing: Bool) -> String {
  let intent_name = concat(stem, "-intent.txt")
  let elected_name = concat(stem, "-publication-elected.txt")
  let closed_name = concat(stem, "-publication-closed.txt")
  let retired_name = concat(stem, "-retired.txt")
  let intent_record = iam_authority_record(name: intent_name)
  let elected_record = iam_authority_record(name: elected_name)
  let closed_record = iam_authority_record(name: closed_name)
  let retired_record = iam_authority_record(name: retired_name)
  if !all([intent_record, elected_record, closed_record, retired_record], r => iam_authority_record_matches(record: r, wire: wire)) {
    "authority journal unreadable or intent changed; no authority effects"
  } else {
    let owned = iam_authority_record_present(record: intent_record)
    let elected = iam_authority_record_present(record: elected_record)
    let closed = iam_authority_record_present(record: closed_record)
    let retired = iam_authority_record_present(record: retired_record)
    if !owned && (elected || closed || retired) { "authority intent missing beside publication history; recovery evidence unavailable" }
    else { match iam_bootstrap_authority_resource_read(resource: resource, token: token) {
      PolicyObserved { policy } => {
        let present = gcp_cell_in(c: cell, xs: gcp_policy_cells(p: policy))
        if !owned && present { "existing authority cell has no ownership journal; refusing adoption or removal" }
        else if !owned && withdrawing { "" }
        else if !owned && !iam_authority_pin(name: intent_name, wire: wire) { "authority intent could not be durably pinned" }
        else {
          let live = match approval_instant_now() { Present { value: now } => bootstrap_authority_may_grant(intent: intent, now: now) Absent => false }
          let action = bootstrap_authority_action(observed: if present { AuthorityPresent } else { AuthorityAbsent },
            publication_elected: elected, publication_closed: closed, retired: retired, withdrawing: withdrawing, live: live)
          match action {
            AuthorityRefused => "authority dependency unresolved: expired, unowned, or publication may still commit; no grant retry or renewal"
            AuthoritySettled => if withdrawing && iam_authority_pin(name: retired_name, wire: wire) { "" }
              else { "authority operation is retired; a new authorized intent is required to grant again" }
            UseAuthority => if iam_authority_pin(name: closed_name, wire: wire) { "" } else { "authority publication readback could not be recorded" }
            PublishAuthority => iam_bootstrap_authority_policy_change(cell: cell, wire: wire, resource: resource, before: policy, removing: false, token: token, elected_name: elected_name, closed_name: closed_name, retired_name: retired_name)
            RemoveAuthority => if !iam_authority_pin(name: closed_name, wire: wire) { "authority readback could not be recorded before cleanup" }
              else {
                let removed = iam_bootstrap_authority_policy_change(cell: cell, wire: wire, resource: resource, before: policy, removing: true, token: token, elected_name: elected_name, closed_name: closed_name, retired_name: retired_name)
                if removed != "" || withdrawing { removed } else { "expired or retired authority cleaned up; no use admitted" }
              }
          }
        }
      }
      PolicyUnreadable { cause } => concat("authority IAM read dependency unresolved: ", cause)
      PolicyResourceAbsent => "authority policy resource absent; no authority change attempted"
    } }
  }
}

// Both publication and retirement use the existing cell reconciler and its etag. The owned
// universe is exactly this conditioned cell; pre-existing unconditional or unrelated grants survive.
fn iam_bootstrap_authority_policy_change(cell: GcpIamBindingCell, wire: String, resource: IamBootstrapAuthorityResource, before: GcpPolicy, removing: Bool, token: Secret, elected_name: String, closed_name: String, retired_name: String) -> String {
  match reconcile_gcp_policy(observed: before, desired_owned: if removing { [] } else { [cell] }, owned_universe: GcpIamOwnedCellUniverse { cells: [cell] }) {
    GcpPolicyRepresentationLossy { conditional_roles: _ } => "authority policy loses conditions; authority change refused"
    GcpPolicyAlreadyConverged { policy: _ } => "authority policy moved before the intended change; reconverge"
    GcpPolicyDeltaRequired { policy: after, added: _, removed: _, preserved: _ } => if before.etag == "" { "authority mutation requires an etag" }
    else {
      let elected = if removing { true } else { Filesystem.WriteCreateNew(path: concat("target/", elected_name), content: wire).success }
      if !elected { "authority publication already elected or election unreadable; reread, never issue a second grant" }
      else {
      match iam_bootstrap_authority_resource_write(resource: resource, policy: after, token: token) {
        BootstrapPolicyWriteRefused { refusal: changed } => {
          let terminal_refusal = if !removing && bootstrap_authority_publication_refused(refusal: changed) { iam_authority_pin(name: closed_name, wire: wire) } else { false }
          concat(if terminal_refusal { "authority IAM writer dependency refused without publication: " } else { "authority mutation not established; recovery remains owed: " }, rest_refusal_text(o: changed))
        }
        BootstrapPolicyWritten =>
          if !removing && !iam_authority_pin(name: closed_name, wire: wire) { "acknowledged authority publication could not be recorded; recovery remains owed" }
          else { match iam_bootstrap_authority_resource_read(resource: resource, token: token) {
            PolicyObserved { policy: checked } => {
              let present = gcp_cell_in(c: cell, xs: gcp_policy_cells(p: checked))
              if present == removing { "authority mutation lacks the required independent readback" }
              else if !iam_authority_pin(name: if removing { retired_name } else { closed_name }, wire: wire) { "authority readback receipt failed; reconverge from journal" }
              else { "" }
            }
            PolicyResourceAbsent => "authority mutation answered but policy readback is unavailable; recovery remains owed"
            PolicyUnreadable { cause: _ } => "authority mutation answered but policy readback is unavailable; recovery remains owed"
          } }
      }
      }
    }
  }
}

// Recovery can withdraw the exact owned grant without rerunning identities, deny installation,
// or workload provisioning. Expired grants still require this physical policy cleanup.
fn iam_bootstrap_authority_cleanup() -> ProcessExit {
  match read_supplied_access_token() {
    SuppliedTokenUnavailable { cause } => exit_failure(reason: cause as String)
    SuppliedTokenReady { token } => {
      let result = iam_bootstrap_authority_converge(token: token, withdrawing: true)
      if result == "" { ExitSuccess } else { exit_failure(reason: result) }
    }
  }
}


fn iam_bootstrap_organization_policy_read(token: Secret) -> PolicyReading {
  match gcp.ResourceManager.GetOrganizationIamPolicy(access_token: token, organization: iam_bootstrap_authority_organization) {
    RestAnswered { answer: r } => iam_bootstrap_policy_reading(bindings: r.bindings, etag: r.etag, version: r.version)
    RestRefused { refusal } => iam_bootstrap_policy_refused(refusal: refusal)
  }
}

fn iam_bootstrap_authority_ancestry(token: Secret) -> String {
  match gcp.ResourceManager.GetProject(access_token: token, project_id: fleet_secrets_project_id) {
    RestRefused { refusal } => concat("project ancestry unreadable: ", rest_refusal_text(o: refusal))
    RestAnswered { answer: p } =>
      if p.project_id != fleet_secrets_project_id || p.resource_name != concat("projects/", fleet_secrets_project_number) || p.state != "ACTIVE" {
        "project ancestry subject or active state differs; no authority grant"
      } else { match p.parent {
        Absent => "project has no organization ancestor; organization attachment is an unresolved dependency, not an instruction to move it"
        Present { value: parent } => iam_bootstrap_follow_parent(parent: parent, visited: [], remaining: 12, token: token)
      } }
  }
}

fn iam_bootstrap_follow_parent(parent: String, visited: List<String>, remaining: Int, token: Secret) -> String {
  if remaining <= 0 || any(visited, p => p == parent) { "ancestry traversal incomplete or cyclic; no authority grant" }
  else if bootstrap_parent_name_valid(name: parent, kind: "organizations") {
    if parent == (iam_bootstrap_authority_organization as String) { "" } else { "project organization differs from the pinned authority subject" }
  } else if bootstrap_parent_name_valid(name: parent, kind: "folders") {
    match gcp.ResourceManager.GetFolder(access_token: token, folder: parent as NonEmptyStr) {
      RestRefused { refusal } => concat("folder ancestry unreadable: ", rest_refusal_text(o: refusal))
      RestAnswered { answer: f } =>
        if f.name != parent || f.state != "ACTIVE" { "folder ancestry subject or active state differs" }
        else { iam_bootstrap_follow_parent(parent: f.parent, visited: visited + [parent], remaining: remaining - 1, token: token) }
    }
  } else { "invalid ancestry resource name; no authority grant" }
}


fn iam_bootstrap_current_authority_live() -> Bool {
  let intent = BootstrapAuthorityIntent {
    operation: actions_variable_trimmed(name: "GUNBC_IAM_BOOTSTRAP_AUTHORITY_ID"),
    expires_at: actions_variable_trimmed(name: "GUNBC_IAM_BOOTSTRAP_AUTHORITY_EXPIRES_AT") as Timestamp,
  }
  match approval_instant_now() { Present { value: now } => bootstrap_authority_may_grant(intent: intent, now: now) Absent => false }
}

// An accepted asynchronous create is followed only by bounded reads, never another create.
fn iam_bootstrap_deny_creation_readback(policy: IamBootstrapDenyPolicy, token: Secret, remaining: Int) -> String {
  match gcp.IamDeny.GetPolicy(access_token: token, attachment_point: iam_bootstrap_attachment_point(), policy_id: policy.policy_id) {
    RestAnswered { answer: check } =>
      if iam_bootstrap_deny_rules_match(observed: check.rules, declared: policy.rules) { "" } else { concat(policy.policy_id as String, ": created deny policy differs; no capabilities granted") }
    RestRefused { refusal: check_refusal } =>
      if outcome_is_not_found(o: check_refusal) && remaining > 0 {
        if sleep_delay_seconds_second_carrier_projection(duration: second(count: 10)) {
          iam_bootstrap_deny_creation_readback(policy: policy, token: token, remaining: remaining - 1)
        } else { "deny creation readback wait failed" }
      } else { concat("deny creation accepted but exact readback is not established: ", rest_refusal_text(o: check_refusal)) }
  }
}


type OperatorReadbackStanding = OperatorReadbackAdmitted | OperatorReadbackRefused { reason: String }

fn iam_bootstrap_operator_readback_standing(token: Secret) -> OperatorReadbackStanding {
  match google.OidcUserInfo.Get(access_token: token) {
    RestRefused { refusal } => OperatorReadbackRefused { reason: concat("bootstrap operator identity unreadable: ", rest_refusal_text(o: refusal)) }
    RestAnswered { answer: actor } =>
      if bootstrap_operator_matches(subject: actor.subject, claims: OidcStandardClaims { email: actor.email, email_verified: actor.email_verified, name: none }) { OperatorReadbackAdmitted }
      else { OperatorReadbackRefused { reason: "bootstrap credential is not the admitted Google subject with its pinned verified IAM email; no grant" } }
  }
}

fn iam_bootstrap_operator_readback(token: Secret) -> String {
  match iam_bootstrap_operator_readback_standing(token: token) {
    OperatorReadbackAdmitted => ""
    OperatorReadbackRefused { reason } => reason
  }
}


// The operator confirmed exclusive pool-policy writers on 2026-09-29. This one-off
// initialization is not CAS. Its journal must stay in this same recovery workspace;
// ambiguous outcomes never authorize another unconditional request.
data iam_bootstrap_pool_window: String = "exclusive-pool-policy-initialization-20260929"

fn iam_bootstrap_pool_initial_cells(pool: NonEmptyStr) -> List<GcpIamBindingCell> {
  map(filter(iam_bootstrap_stage_bindings(stage: BootstrapCapabilities), binding => binding.resource == BootstrapPool { pool: pool }), binding => binding.cell)
}

fn iam_bootstrap_pool_seedable(audit_configured: Bool, bindings: List<GcpBinding>?, etag: String?, version: Int?) -> Bool {
  !audit_configured && (match bindings { Absent => true Present { value: rows } => count(rows) == 0 })
    && (match etag { Absent => true Present { value: revision } => revision == "" })
    && (match version { Absent => true Present { value: number } => number == 0 || number == 1 || number == 3 })
}

fn iam_bootstrap_pool_initialized(policy: GcpPolicy, cells: List<GcpIamBindingCell>) -> Bool {
  policy.etag != "" && count(cells) > 0
    && count(gcp_policy_cells(p: policy)) == count(cells)
    && all(cells, cell => gcp_cell_in(c: cell, xs: gcp_policy_cells(p: policy)))
}

// ── A POOL'S FIRST POLICY PUBLICATION: ONE IMPLEMENTATION, TWO ADMISSIONS ──────────────────────
// A pool whose policy was never published reads with no etag, so its first write cannot be fenced. The
// journaled initializer below is the only route that makes that write: declared-empty pool only -> one
// journaled publication -> exact independent readback with etag -> normal fenced CAS for anything
// after. The ROOT CEREMONY calls it for its own pools under the operator-confirmed exclusive window; the
// BOOTSTRAP DELTA calls it for a target pool under the approved digest (ruling by warm-crane-219,
// 2026-10-19), whose writers are serialized by the apply job's concurrency group
// (gunbc.fleet.fleet_converge_workflow fleet_converge_gcp_iam_bootstrap_concurrency, "gcp-iam-converge",
// shared with the converge and the request job). An out-of-band writer is caught by the exact
// readback, which refuses and never replays. The uncertain-publication rule is the same for both:
// an elected or closed journal with no revisioned policy is unresolved, and nothing retries it.
type PoolInitAdmission
  = PoolInitOperatorWindow
  | PoolInitApprovedDelta { digest: String }

fn pool_init_admission_wire(a: PoolInitAdmission) -> String {
  match a { PoolInitOperatorWindow => iam_bootstrap_pool_window  PoolInitApprovedDelta { digest } => concat("approved-delta-", digest) }
}

// WHAT THE INITIALIZER MAY DO, given its journal and what it read: pure, so every arm is witnessed.
type PoolInitDecision
  = PoolInitNothing
  | PoolInitCloseJournal
  | PoolInitPublish
  | PoolInitRefused { reason: String }

fn pool_initialization_decision(elected: Bool, closed: Bool, observed: GcpPolicy?, seedable: Bool, cells: List<GcpIamBindingCell>) -> PoolInitDecision {
  if count(cells) == 0 { PoolInitRefused { reason: "pool is outside the declared bootstrap capability roster" } }
  else { match observed {
    Present { value: policy } => if !elected || closed { PoolInitNothing }
      else if iam_bootstrap_pool_initialized(policy: policy, cells: cells) { PoolInitCloseJournal }
      else { PoolInitRefused { reason: "unresolved initial pool write differs from readback; do not apply later policy changes" } }
    Absent => if elected || closed { PoolInitRefused { reason: "initial pool publication is unresolved or its revision disappeared; no unconditional retry" } }
      else if !seedable { PoolInitRefused { reason: "unfenced pool policy is not empty; no initialization admitted" } }
      else { PoolInitPublish }
  } }
}

// THE READBACK AFTER THE ONE PUBLICATION: exactly the approved cells, with a revision, or a refusal.
type PoolInitReadback = PoolInitReadbackExact | PoolInitReadbackRefused { reason: String }

fn pool_initialization_readback(reading: PolicyReading, cells: List<GcpIamBindingCell>) -> PoolInitReadback {
  match reading {
    PolicyObserved { policy } => if iam_bootstrap_pool_initialized(policy: policy, cells: cells) { PoolInitReadbackExact }
      else { PoolInitReadbackRefused { reason: "pool initialization readback differs; workflow trust withheld" } }
    PolicyResourceAbsent => PoolInitReadbackRefused { reason: "pool initialization readback lacks its policy revision; workflow trust withheld" }
    PolicyUnreadable { cause: _ } => PoolInitReadbackRefused { reason: "pool initialization readback lacks its policy revision; workflow trust withheld" }
  }
}

type PoolInitAdmissionStanding = PoolInitAdmitted | PoolInitAdmissionRefused { reason: String }

fn pool_init_admission(admission: PoolInitAdmission, token: Secret) -> PoolInitAdmissionStanding {
  match admission {
    PoolInitOperatorWindow => if actions_variable_trimmed(name: "GUNBC_IAM_BOOTSTRAP_POOL_WINDOW") != iam_bootstrap_pool_window {
      PoolInitAdmissionRefused { reason: "empty pool initialization requires the operator-confirmed exclusive maintenance window" }
    } else { match iam_bootstrap_operator_readback_standing(token: token) {
      OperatorReadbackAdmitted => PoolInitAdmitted
      OperatorReadbackRefused { reason } => PoolInitAdmissionRefused { reason: reason }
    } }
    PoolInitApprovedDelta { digest: _ } => PoolInitAdmitted
  }
}

// WHAT THE ONE PUBLICATION ROUTE ANSWERS, as a closed sum: settled (published and read back exactly, or
// already published) is constructed explicitly, and every other path is a refusal with its reason, so
// no empty message can read as success (review 82849). A refusal whose text came back empty is still
// a refusal.
type PoolPublication = PoolPublicationSettled | PoolPublicationRefused { reason: NonEmptyStr }

fn pool_publication_refused(reason: String) -> PoolPublication {
  let stated = if reason == "" { "pool first publication refused with no stated cause" } else { reason }
  PoolPublicationRefused { reason: stated as NonEmptyStr }
}

// THE CEREMONY'S CALL: its own pools, its own cells, the operator window. The ceremony's stages speak
// the stage-text convention ("" = stage done), so this is where the typed answer is rendered for them.
fn iam_bootstrap_initialize_pool_policy(pool: NonEmptyStr, token: Secret) -> String {
  match iam_bootstrap_publish_initial_pool_policy(pool: pool, cells: iam_bootstrap_pool_initial_cells(pool: pool), admission: PoolInitOperatorWindow, token: token) {
    PoolPublicationSettled => ""
    PoolPublicationRefused { reason } => reason as String
  }
}

// A POOL'S FIRST PUBLICATION IS ELECTED ONCE PER RESOURCE LIFETIME: its election and closure occupy one
// slot whatever the consent, which rides in the record's body. Two concurrent applies under different
// digests therefore contend for one create-once object; the second meets the store's 412 and refuses, so
// the journal itself is the exclusion (the gcp-iam-converge concurrency group is a second, not the only,
// guard). Bare creates keep a slot per operation: the upstream create is itself 409-exclusive.
data pool_first_publication_slot: String = "once"

// THE ONE DERIVATION OF A POOL'S JOURNAL OBJECTS: every pool write takes its name from here.
fn pool_journal_object(pool: NonEmptyStr, mark: JournalMark) -> NonEmptyStr {
  journal_object_name(subject: JournalPoolFirstPublication, resource_key: iam_bootstrap_resource_key(resource: BootstrapPool { pool: pool }), consent: pool_first_publication_slot, mark: mark)
}

fn pool_election_object(pool: NonEmptyStr, consent: String) -> NonEmptyStr {
  pool_journal_object(pool: pool, mark: JournalElection)
}

fn pool_journal_write(pool: NonEmptyStr, consent: String, mark: JournalMark, token: Secret) -> JournalMarkOutcome {
  journal_mark_outcome(o: journal_mark_named(bucket: iam_bootstrap_journal_bucket, name: pool_journal_object(pool: pool, mark: mark), subject: JournalPoolFirstPublication, resource_key: iam_bootstrap_resource_key(resource: BootstrapPool { pool: pool }), consent: consent, token: token))
}

fn pool_journal_mark(pool: NonEmptyStr, consent: String, mark: JournalMark, token: Secret) -> Bool {
  match pool_journal_write(pool: pool, consent: consent, mark: mark, token: token) {
    JournalMarkRecorded => true  JournalMarkAlreadyPresent => true  JournalMarkRefused { cause: _ } => false
  }
}

// THE POOL'S ELECTIONS AS JOURNALED, over every consent: `elected` means some election under any consent
// has no closure, and is what pool_initialization_decision refuses to reissue over; `closed` means every
// election has its closure. The journal is the durable bootstrap journal, never the checkout.
type PoolJournalStanding = PoolJournalRead { elected: Bool, closed: Bool, unresolved: List<String> } | PoolJournalUnreadable { cause: NonEmptyStr }

fn pool_journal_standing(pool_key: String, names: List<String>) -> PoolJournalStanding {
  let consents = journal_listed_consents(subject: JournalPoolFirstPublication, resource_key: pool_key, names: names)
  let elected_consents = filter(consents, c => journal_has(names: names, subject: JournalPoolFirstPublication, resource_key: pool_key, consent: c, mark: JournalElection))
  let orphans = filter(consents, c => !journal_has(names: names, subject: JournalPoolFirstPublication, resource_key: pool_key, consent: c, mark: JournalElection))
  let unresolved = filter(elected_consents, c => !journal_has(names: names, subject: JournalPoolFirstPublication, resource_key: pool_key, consent: c, mark: JournalClosure))
  if count(orphans) > 0 { PoolJournalUnreadable { cause: concat("pool journal records close an election that is absent: ", join(orphans, ",")) as NonEmptyStr } }
  else { PoolJournalRead { elected: count(unresolved) > 0, closed: count(elected_consents) > 0 && count(unresolved) == 0, unresolved: unresolved } }
}

fn iam_bootstrap_publish_initial_pool_policy(pool: NonEmptyStr, cells: List<GcpIamBindingCell>, admission: PoolInitAdmission, token: Secret) -> PoolPublication {
  let consent = pool_init_admission_wire(a: admission)
  let pool_key = iam_bootstrap_resource_key(resource: BootstrapPool { pool: pool })
  if !path_segment_is_safe(raw: pool as String) { pool_publication_refused(reason: "pool id is not a safe journal segment") }
  else { match journal_list(bucket: iam_bootstrap_journal_bucket, subject: JournalPoolFirstPublication, resource_key: pool_key, token: token) {
    JournalListingUnreadable { cause } => pool_publication_refused(reason: concat("the pool journal is unreadable; retain the recovery obligation: ", cause as String))
    JournalListed { names } => match pool_journal_standing(pool_key: pool_key, names: names) {
    PoolJournalUnreadable { cause } => pool_publication_refused(reason: cause as String)
    PoolJournalRead { elected, closed, unresolved } =>
    match gcp.IamAdmin.GetWorkloadIdentityPoolIamPolicy(access_token: token, project_id: fleet_secrets_project_id, pool_id: pool) {
    RestRefused { refusal } => pool_publication_refused(reason: rest_refusal_text(o: refusal))
    RestAnswered { answer: read } =>
    if (match read.audit_configs { Absent => false Present { value: rows } => count(rows) != 0 }) {
      pool_publication_refused(reason: "pool policy audit configuration is outside bootstrap representation; no replacement")
    } else { match pool_initialization_decision(elected: elected, closed: closed,
        observed: iam_bootstrap_observed_policy(reading: iam_bootstrap_pool_policy_reading(bindings: read.bindings, etag: read.etag, version: read.version)),
        seedable: iam_bootstrap_pool_seedable(audit_configured: false, bindings: read.bindings, etag: read.etag, version: read.version), cells: cells) {
      PoolInitNothing => PoolPublicationSettled
      PoolInitRefused { reason } => {
        let named = if count(unresolved) > 0 { join([reason, " (unresolved elections: ", join(unresolved, ","), "; operator recovery: verify the pool's policy, then record its closure)"], "") } else { reason }
        pool_publication_refused(reason: named)
      }
      PoolInitCloseJournal => if all(unresolved, c => pool_journal_mark(pool: pool, consent: c, mark: JournalClosure, token: token)) { PoolPublicationSettled } else { pool_publication_refused(reason: "pool initialized but completion journal failed; recover before continuing") }
      PoolInitPublish => match pool_init_admission(admission: admission, token: token) {
        PoolInitAdmissionRefused { reason } => pool_publication_refused(reason: reason)
        PoolInitAdmitted => match pool_journal_write(pool: pool, consent: consent, mark: JournalElection, token: token) {
          JournalMarkRefused { cause } => pool_publication_refused(reason: concat("pool initialization election could not be recorded; no write: ", cause as String))
          JournalMarkAlreadyPresent => pool_publication_refused(reason: "pool initialization election already taken (once per pool, any consent); a concurrent or earlier publication holds it; recover without another write")
          JournalMarkRecorded => {
            match gcp.IamAdmin.SetWorkloadIdentityPoolIamPolicy(access_token: token, project_id: fleet_secrets_project_id, pool_id: pool,
              policy: GcpPolicy { bindings: gcp_cells_bindings(cs: cells), etag: "", version: 3 }) {
            RestRefused { refusal: changed } => pool_publication_refused(reason: concat("initial pool publication requires readback recovery; no unconditional retry: ", rest_refusal_text(o: changed)))
            RestAnswered { answer: _ } => {
              let reread = match gcp.IamAdmin.GetWorkloadIdentityPoolIamPolicy(access_token: token, project_id: fleet_secrets_project_id, pool_id: pool) {
                RestAnswered { answer: checked } => iam_bootstrap_pool_policy_reading(bindings: checked.bindings, etag: checked.etag, version: checked.version)
                RestRefused { refusal } => iam_bootstrap_policy_refused(refusal: refusal)
              }
              match pool_initialization_readback(reading: reread, cells: cells) {
                PoolInitReadbackExact => if pool_journal_mark(pool: pool, consent: consent, mark: JournalClosure, token: token) { PoolPublicationSettled } else { pool_publication_refused(reason: "pool initialized but completion journal failed") }
                PoolInitReadbackRefused { reason } => pool_publication_refused(reason: reason)
              }
            }
            }
          }
        }
      }
    } }
    }
    }
  } }
}


fn iam_bootstrap_probe_cell(intent: BootstrapAuthorityIntent) -> GcpIamBindingCell {
  GcpIamBindingCell { role: iam_bootstrap_role_name(role: BootstrapProbeToken) as String,
    member: iam_bootstrap_operator_member, condition: Present { value: IamCondition {
      title: concat("gunbc-bootstrap-probe-", intent.operation),
      description: Present { value: "Temporary exact-account bootstrap readback; physical cleanup required after expiry." },
      expression: concat("request.time < timestamp('", intent.expires_at as String, "')"),
    } } }
}

fn iam_bootstrap_probe_authority_converge(token: Secret, withdrawing: Bool) -> String {
  let intent = BootstrapAuthorityIntent {
    operation: actions_variable_trimmed(name: "GUNBC_IAM_BOOTSTRAP_PROBE_ID"),
    expires_at: actions_variable_trimmed(name: "GUNBC_IAM_BOOTSTRAP_PROBE_EXPIRES_AT") as Timestamp,
  }
  if intent.operation == "" && intent.expires_at == "" {
    if withdrawing { "" } else { "probe token authority requires a pinned operation identity and absolute expiry" }
  } else if !bootstrap_authority_intent_valid(intent: intent) { "probe authority intent is invalid" }
  else {
    let actor = if withdrawing { "" } else { iam_bootstrap_operator_readback(token: token) }
    if actor != "" { actor } else {
      fold(iam_bootstrap_probe_accounts, init: "", f: (prior, account) => {
        let cell = iam_bootstrap_probe_cell(intent: intent)
        let subject = BootstrapAccount { account: account }
        let result = if prior != "" && !withdrawing { prior } else {
          iam_bootstrap_cell_authority_reconcile(intent: intent,
            stem: concat("gcp-iam-probe-", intent.operation, "-", account as String),
            wire: concat(iam_bootstrap_resource_key(resource: subject), ";", cell_preimage(c: cell)),
            cell: cell, resource: BootstrapAccountAuthority { resource: subject }, token: token, withdrawing: withdrawing)
        }
        if prior == "" { result } else if result == "" || result == prior { prior } else { concat(prior, "; ", result) }
      })
    }
  }
}

fn iam_bootstrap_probe_cleanup() -> ProcessExit {
  match read_supplied_access_token() {
    SuppliedTokenUnavailable { cause } => exit_failure(reason: cause as String)
    SuppliedTokenReady { token } => {
      let result = iam_bootstrap_probe_authority_converge(token: token, withdrawing: true)
      if result == "" { ExitSuccess } else { exit_failure(reason: result) }
    }
  }
}


// These API consumers are the existing bootstrap/approval operations, not every GCP API.
// THE GCP SERVICES THE JOURNAL-BUCKET STAGE CALLS (gcp.Storage GetBucket / InsertBucket / bucket IAM /
// objects), so the roster below can be checked to enable them before first use.
data iam_bootstrap_journal_bucket_services: List<GcpService> = [GcpStorage]

data iam_bootstrap_required_services: List<String> = [
  "iam.googleapis.com", "iamcredentials.googleapis.com", "cloudresourcemanager.googleapis.com",
  "secretmanager.googleapis.com", "sts.googleapis.com", "storage.googleapis.com",
]

fn iam_bootstrap_service_enabled(name: String, state: String, service: String) -> Bool {
  name == concat("projects/", fleet_secrets_project_number, "/services/", service)
    && (match gcp_service_usage_state_from_wire(raw: state) { Present { value: st } => match st { ServiceUsageStateEnabled => true  ServiceUsageStateDisabled => false  ServiceUsageStateUnspecified => false }  Absent => false })
}

fn iam_bootstrap_ensure_service(service: String, token: Secret) -> String {
  if !any(iam_bootstrap_required_services, declared => declared == service) { "service is outside bootstrap dependencies" }
  else {
    match gcp.ServiceUsage.GetService(access_token: token, project_id: fleet_secrets_project_id, service_id: service) {
    RestRefused { refusal } => rest_refusal_text(o: refusal)
    RestAnswered { answer: seen } =>
    if iam_bootstrap_service_enabled(name: seen.name, state: seen.state, service: service) { "" }
    else if seen.name != concat("projects/", fleet_secrets_project_number, "/services/", service) { "service observation belongs to another project or API" }
    else {
      let unknown = "API enablement observation is unknown; no mutation admitted"
      match gcp_service_usage_state_from_wire(raw: seen.state) {
        Present { value: st } => match st {
          ServiceUsageStateDisabled => {
            match gcp.ServiceUsage.BatchEnableServices(access_token: token, project_id: fleet_secrets_project_id, service_ids: [service]) {
              RestRefused { refusal } => rest_refusal_text(o: refusal)
              RestAnswered { answer: _ } => iam_bootstrap_service_readback(service: service, token: token, remaining: 25)
            }
          }
          ServiceUsageStateEnabled => unknown
          ServiceUsageStateUnspecified => unknown
        }
        Absent => unknown
      }
    }
    }
  }
}

// An accepted long-running operation is not readiness. Poll only GetService.
fn iam_bootstrap_service_readback(service: String, token: Secret, remaining: Int) -> String {
  match gcp.ServiceUsage.GetService(access_token: token, project_id: fleet_secrets_project_id, service_id: service) {
    RestRefused { refusal } => rest_refusal_text(o: refusal)
    RestAnswered { answer: seen } =>
      if iam_bootstrap_service_enabled(name: seen.name, state: seen.state, service: service) { "" }
      else if remaining <= 1 { concat("API enablement accepted but readiness remains unestablished: ", service) }
      else if sleep_delay_seconds_second_carrier_projection(duration: second(count: 5)) {
        iam_bootstrap_service_readback(service: service, token: token, remaining: remaining - 1)
      } else { "API enablement readback wait failed" }
  }
}
