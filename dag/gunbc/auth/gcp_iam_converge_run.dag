module gunbc.auth.gcp_iam_converge_run

import std.types { Int, List, NonEmptyStr, String, Secret, Bool }
import std.measure { Second, second, second_count }
import std.process { ProcessExit, ExitSuccess, ExitFailure, exit_failure }
import std.scoped_authorization { AttemptIdentity, AuthorizationRequest }
import v2.std.optional { Present, Absent }
import std.algebra { trim }
import extdeps.github.actions_environment { github_run_id_variable_name }
import gunbc.actions_run_binding { actions_variable_trimmed }
import gunbc.auth.access_token_source { ensure_access_token, WorkloadIdentityToken, AccessTokenReady, AccessTokenUpsertRequired, AccessTokenEnsureRefused }
import gunbc.auth.approval_gate {
  approval_refusal_text, ApprovalRecorded, ApprovalNotRecorded, approval_recorded_from_poll,
  approval_instant_now, approval_expires_at, approval_poll_ticks, PollObservedAt, PollBudgetExhausted, PollClockUnreadable,
  approval_file_stored_request, ApprovalFiled, ApprovalFilingRefused,
  approval_post_signed_envelope, SignedEnvelopeAnswered, SignedEnvelopeNotSent,
}
import gunbc.auth.approval_request_client { stored_request_from_authorization }
import gunbc.auth.approval_decision_store { StoredApprovalRequest, request_revision_of }
import gunbc.auth.approval_broker_endpoint { approval_broker_actuation_mint_url, approval_broker_listen_port }
import gunbc.auth.heal_publisher_provision { DedicatedFederation, provision_dedicated_federation }
import gunbc.auth.gcp_iam_converge {
  GcpIamEstateDiff, GcpIamEstatePlan, GcpIamEstateNoop, GcpIamEstateApply, GcpIamEstateRefused,
  GcpIamRequest, GcpIamRequested, GcpIamUnrequestable,
  gcp_iam_converge_targets, gcp_iam_converge_request, observe_and_plan_estate, diff_targets,
}

// ── THE CONVERGING RUN (fleet-converge mode gcp_iam_converge, its own job on srv1) ────────────
// Two credentials, never interchanged:
//   OBSERVE -- the job's WIF token for iam-observe (the job's `environment` pins it). Every plan,
//              every re-plan and the final readback read through it, so the evidence that the change
//              landed is NOT produced by the credential that made it.
//   ACTUATE -- a token for iam-converge minted by the approval broker after the operator's tap
//              (gunbc.auth.gcp_iam_actuation_mint), used for exactly one call: the provisioning
//              protocol over the approved targets.
// There is no operator-token arm: the observe token resolves ONLY from the workload identity arm,
// and a run with GUNBC_GCP_ACCESS_TOKEN_FILE set is not thereby admitted to anything.

data gcp_iam_converge_file_window: Second = second(count: 1800)

data gcp_iam_converge_poll_cadence: Second = second(count: 15)

data gcp_iam_converge_poll_ticks: Int = 120

data gcp_iam_converge_submit_timeout: Second = second(count: 30)

// THE STEP BUDGET IS DERIVED FROM THE CONSENT WINDOW, not chosen beside it: the run waits at most the
// filing window for the tap, and plan, mint, apply and readback are bounded API calls. Ten minutes
// over the window is the actuation allowance, the same as the minted token's lifetime.
fn gcp_iam_converge_step_timeout_minutes() -> Int {
  second_count(s: gcp_iam_converge_file_window) / 60 + 10
}

fn observe_token() -> Secret? {
  match ensure_access_token(source: WorkloadIdentityToken) {
    AccessTokenReady { token: t } => Present { value: t }
    AccessTokenUpsertRequired { plan: _ } => Absent
    AccessTokenEnsureRefused { reason: _ } => Absent
  }
}

fn run_attempt() -> AttemptIdentity? {
  let id = actions_variable_trimmed(name: github_run_id_variable_name as NonEmptyStr)
  if id == "" { none } else { Present { value: concat("run-", id) as AttemptIdentity } }
}

// THE MINT ANSWER'S FIRST LINE IS THE TOKEN (gunbc.auth.approval_broker_serve
// actuation_mint_response); curl's --fail-with-body makes a non-2xx `success: false`, so a refusal
// body is never read as a token.
type MintedToken
  = MintedTokenReceived { token: Secret }
  | MintedTokenRefused { reason: String }

fn first_line(s: String) -> String {
  match split(s: s, sep: "\n").first() {
    Present { value: l } => trim(s: l)
    Absent => ""
  }
}

fn request_actuation_token(stored: StoredApprovalRequest) -> MintedToken
{
  match approval_post_signed_envelope(stored: stored, body_file_name: "gcp-iam-converge-mint.json", url: approval_broker_actuation_mint_url(port: approval_broker_listen_port), timeout: gcp_iam_converge_submit_timeout) {
    SignedEnvelopeNotSent { reason: r } => MintedTokenRefused { reason: r }
    SignedEnvelopeAnswered { success: ok, body: b } =>
      if !ok {
        MintedTokenRefused { reason: b }
      } else if first_line(s: b) == "" {
        MintedTokenRefused { reason: "the broker answered 200 with no token line" }
      } else {
        MintedTokenReceived { token: first_line(s: b) as Secret }
      }
  }
}

fn target_approved(f: DedicatedFederation, d: GcpIamEstateDiff) -> Bool {
  fold(diff_targets(d: d), init: false, f: (acc, t) => acc || t == f.label)
}

// THE APPROVED TARGETS, in declaration order, each under the one provisioning protocol. The first
// failure stops the fold: a later target is not attempted on a half-converged estate.
fn actuate_approved(d: GcpIamEstateDiff, token: Secret) -> ProcessExit
{
  fold(filter(gcp_iam_converge_targets, f => target_approved(f: f, d: d)), init: ExitSuccess, f: (acc, f) =>
    match acc {
      ExitSuccess => provision_dedicated_federation(f: f, token: token)
      failed => failed
    }
  )
}

// THE CONSENT STILL HOLDS iff re-planning under the observe credential yields the same revision.
// Anything else -- the estate converged by someone else, drifted, or refuses now -- stops the run
// before the minted token is used.
fn replan_matches(approved: AuthorizationRequest<GcpIamEstateDiff>, observe: Secret, attempt: AttemptIdentity) -> String
{
  match observe_and_plan_estate(token: observe) {
    GcpIamEstateNoop => "the estate converged between the tap and the actuation; the minted token is unused"
    GcpIamEstateRefused { reasons: rs } => concat("the estate now refuses: ", join(rs, "; "))
    GcpIamEstateApply { diff: d } =>
      match gcp_iam_converge_request(d: d, attempt: attempt) {
        GcpIamUnrequestable { reason: why } => why as String
        GcpIamRequested { request: now } =>
          if request_revision_of(request: now) == request_revision_of(request: approved) { "" }
          else { "the diff moved after the operator consented; refusing to apply a change they did not see" }
      }
  }
}

fn readback_converged(observe: Secret) -> ProcessExit
{
  match observe_and_plan_estate(token: observe) {
    GcpIamEstateNoop => ExitSuccess
    GcpIamEstateRefused { reasons: rs } => exit_failure(reason: concat("gcp iam converge: readback refuses: ", join(rs, "; ")))
    GcpIamEstateApply { diff: d } => exit_failure(reason: concat("gcp iam converge: actuation returned, but the independent readback still shows a diff for ", join(diff_targets(d: d), ", ")))
  }
}

fn converge_approved(request: AuthorizationRequest<GcpIamEstateDiff>, stored: StoredApprovalRequest, observe: Secret, attempt: AttemptIdentity) -> ProcessExit
{
  match request_actuation_token(stored: stored) {
    MintedTokenRefused { reason: r } => exit_failure(reason: concat("gcp iam converge: the broker did not mint the actuation credential: ", r))
    MintedTokenReceived { token: t } => {
      let moved = replan_matches(approved: request, observe: observe, attempt: attempt)
      if moved != "" {
        exit_failure(reason: concat("gcp iam converge: ", moved))
      } else {
        match actuate_approved(d: request.subject, token: t) {
          ExitFailure { code: c, reason: r } => ExitFailure { code: c, reason: r }
          ExitSuccess => readback_converged(observe: observe)
        }
      }
    }
  }
}

fn converge_requested(request: AuthorizationRequest<GcpIamEstateDiff>, observe: Secret, attempt: AttemptIdentity) -> ProcessExit
{
  match approval_instant_now() {
    Absent => exit_failure(reason: "gcp iam converge: clock unreadable; the request cannot be filed")
    Present { value: issued } => {
      let expires = approval_expires_at(issued: issued, window: gcp_iam_converge_file_window)
      let stored = stored_request_from_authorization(request: request, issued_at: issued, expires_at: expires)
      match approval_file_stored_request(stored: stored, body_file_name: "gcp-iam-converge-submit.json", submit_timeout: gcp_iam_converge_submit_timeout) {
        ApprovalFilingRefused { reason: r } => exit_failure(reason: concat("gcp iam converge: filing refused: ", r))
        ApprovalFiled =>
          match approval_poll_ticks(remaining: gcp_iam_converge_poll_ticks, cadence: gcp_iam_converge_poll_cadence, escalation_id: request.escalation_id, expires_at: expires) {
            PollClockUnreadable => exit_failure(reason: "gcp iam converge: clock unreadable while waiting for the decision")
            PollBudgetExhausted { escalation_id: _, observed_at: _ } => exit_failure(reason: "gcp iam converge: filed; no decision within the window, nothing applied")
            PollObservedAt { standing: s, observed_at: _ } =>
              match approval_recorded_from_poll(poll: s, request: request) {
                ApprovalNotRecorded { cause: c } => exit_failure(reason: concat("gcp iam converge: not approved, nothing applied: ", approval_refusal_text(cause: c)))
                ApprovalRecorded { authorization: _ } => converge_approved(request: request, stored: stored, observe: observe, attempt: attempt)
              }
          }
      }
    }
  }
}

fn gcp_iam_converge_wet() -> ProcessExit
{
  match run_attempt() {
    Absent => exit_failure(reason: "gcp iam converge: GITHUB_RUN_ID is unset; this entry runs only as the fleet-converge job")
    Present { value: attempt } =>
      match observe_token() {
        Absent => exit_failure(reason: "gcp iam converge: no workload identity token for iam-observe; an operator token is not an admitted source")
        Present { value: observe } =>
          match observe_and_plan_estate(token: observe) {
            GcpIamEstateNoop => ExitSuccess
            GcpIamEstateRefused { reasons: rs } => exit_failure(reason: concat("gcp iam converge: refused, nothing requested: ", join(rs, "; ")))
            GcpIamEstateApply { diff: d } =>
              match gcp_iam_converge_request(d: d, attempt: attempt) {
                GcpIamUnrequestable { reason: why } => exit_failure(reason: why as String)
                GcpIamRequested { request: q } => converge_requested(request: q, observe: observe, attempt: attempt)
              }
          }
      }
  }
}
