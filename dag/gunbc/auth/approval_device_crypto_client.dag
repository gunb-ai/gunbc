  device_crypto_signature_path, device_crypto_attestation_path, device_crypto_assertion_path, device_crypto_p256_order_path,
  p256_multiple_request_json, P256Multiple, OrderMinusOne,
  SignatureCheck, signature_check_request_json, attestation_check_request_json, assertion_check_request_json,
