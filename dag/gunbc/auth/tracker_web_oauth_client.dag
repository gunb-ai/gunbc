module gunbc.auth.tracker_web_oauth_client

import std.types { String, NonEmptyStr, List, Bool, Int, Port }
import std.dissolution { DissolutionCondition, unbound_dissolution }
import std.roster_frontier { FrontierRow, frontier_row_path }
import extdeps.cloud.gcp.secret_ref { SecretRef }
import gunbc.secret_provision { fleet_secret_ref, secret_ref_pin_version }
import gunbc.auth.google_workspace_login {
  GoogleLoginClientTrackerWeb, GoogleLoginEnvironment, GoogleLoginEnvironmentTest,
  GoogleLoginEnvironmentStage, GoogleLoginEnvironmentProd,
  TrackerWebOauthClientBinding, TrackerWebOauthClientStanding,
  TrackerWebOauthClientBound, TrackerWebOauthClientUnbound, gunb_ai_hosted_domain,
}
import gunbc.auth.google_workspace_admin_convergence { WorkspaceIdentityBinding }
import gunbc.auth.oidc_deployment_config {
  oidc_config_schema, oidc_config_env_var, oidc_session_lifetime_seconds, oidc_login_transaction_lifetime_seconds,
}
import gunbc.roadmap_dashboard_instance { srv1_dashboard_lab_id, srv1_dashboard_live_id }
import gunbc.fleet_tailnet { fleet_tailnet_domain }
import gunbc.fleet_intent { srv1_host, srv2_host }
import extdeps.languages.json.emit {
  json_object, json_kv, json_string, json_int, json_array, serialize_json,
}
import v2.std.collection { Present, Absent }

// REDIRECT URIS BELONG TO AN ENVIRONMENT, NOT A HOST (operator 2026-10-11). The binding is
// tracker-web × {test, stage, prod}. An instance is assigned an environment; that environment
// owns the OAuth client and the redirect URI set Google admits. Today's srv1/srv2 ts.net URIs
// are the current REALIZATION of the test environment, not the identity of the binding.
// The stable target is the owned domain (oidc_deployment_config already names tracker[-dev].gunb.ai).
// DNS + a TLS path (Tailscale serve certs cover only *.ts.net) is a declared frontier, not this change.

data tracker_web_test_oauth_client_id: NonEmptyStr = "433089409875-2c1u5obhaeafee9ve7igpopt5oiqoa8k.apps.googleusercontent.com" as NonEmptyStr

data tracker_web_test_oauth_console_project: NonEmptyStr = "433089409875" as NonEmptyStr

data tracker_web_test_oauth_workspace_customer: NonEmptyStr = "gunb.ai" as NonEmptyStr

data tracker_web_test_oauth_desired_revision: NonEmptyStr = "tracker-web-test-2026-10-11" as NonEmptyStr

data tracker_web_oauth_callback_path: String = "/auth/google/callback"

data tracker_web_test_target_owned_domain: NonEmptyStr = "tracker-dev.gunb.ai" as NonEmptyStr

data tracker_web_test_srv2_public_port: Port = 18082

data tracker_web_test_lab_https_port: Port = 8444

fn tracker_web_oauth_public_redirect_uri(host_identity: String, https_port: Port) -> NonEmptyStr {
  match fleet_tailnet_domain {
    Absent => join(["https://", host_identity, ":", to_string(https_port), tracker_web_oauth_callback_path], "") as NonEmptyStr
    Present { value: domain } =>
      join(["https://", host_identity, ".", domain as String, ":", to_string(https_port), tracker_web_oauth_callback_path], "") as NonEmptyStr
  }
}

data tracker_web_test_srv2_redirect_uri: NonEmptyStr = tracker_web_oauth_public_redirect_uri(
  host_identity: srv2_host.identity as String,
  https_port: tracker_web_test_srv2_public_port,
)

data tracker_web_test_lab_redirect_uri: NonEmptyStr = tracker_web_oauth_public_redirect_uri(
  host_identity: srv1_host.identity as String,
  https_port: tracker_web_test_lab_https_port,
)

type TrackerWebRedirectRealization {
  assigned_instance_id: NonEmptyStr?
  uri: NonEmptyStr
}

fn tracker_web_test_redirect_realizations() -> List<TrackerWebRedirectRealization> {
  [
    TrackerWebRedirectRealization {
      assigned_instance_id: Present { value: srv1_dashboard_lab_id },
      uri: tracker_web_test_lab_redirect_uri,
    },
    TrackerWebRedirectRealization {
      assigned_instance_id: none,
      uri: tracker_web_test_srv2_redirect_uri,
    },
  ]
}

fn tracker_web_environment_redirect_uris(realizations: List<TrackerWebRedirectRealization>) -> List<NonEmptyStr> {
  map(realizations, r => r.uri)
}

fn tracker_web_test_oauth_client_binding() -> TrackerWebOauthClientBinding {
  TrackerWebOauthClientBinding {
    client: GoogleLoginClientTrackerWeb,
    environment: GoogleLoginEnvironmentTest,
    client_id: tracker_web_test_oauth_client_id,
    redirect_uris: tracker_web_environment_redirect_uris(realizations: tracker_web_test_redirect_realizations()),
    hosted_domain: gunb_ai_hosted_domain,
    admitted_audiences: [tracker_web_test_oauth_client_id],
  }
}

fn tracker_web_oauth_standing_for_environment(environment: GoogleLoginEnvironment) -> TrackerWebOauthClientStanding {
  match environment {
    GoogleLoginEnvironmentTest => TrackerWebOauthClientBound { binding: tracker_web_test_oauth_client_binding() }
    GoogleLoginEnvironmentStage => TrackerWebOauthClientUnbound {
      environment: environment,
      reason: "no tracker-web STAGE OAuth client is declared; instances assigned stage stay unconfigured until one exists" as NonEmptyStr,
    }
    GoogleLoginEnvironmentProd => TrackerWebOauthClientUnbound {
      environment: environment,
      reason: "no tracker-web PROD OAuth client is declared; production serve stays unconfigured until one exists" as NonEmptyStr,
    }
  }
}

fn tracker_web_instance_environment(instance_id: NonEmptyStr) -> GoogleLoginEnvironment? {
  if (instance_id as String) == (srv1_dashboard_lab_id as String) {
    Present { value: GoogleLoginEnvironmentTest }
  } else if (instance_id as String) == (srv1_dashboard_live_id as String) {
    Present { value: GoogleLoginEnvironmentProd }
  } else {
    none
  }
}

fn tracker_web_test_workspace_identity_binding() -> WorkspaceIdentityBinding {
  let b = tracker_web_test_oauth_client_binding()
  WorkspaceIdentityBinding {
    customer: tracker_web_test_oauth_workspace_customer,
    project: tracker_web_test_oauth_console_project,
    client: b.client_id,
    top_org_unit: "/" as NonEmptyStr,
    redirect_uris: b.redirect_uris,
    desired_revision: tracker_web_test_oauth_desired_revision,
  }
}

data tracker_web_test_console_redirect_uris_actuation: NonEmptyStr = "2026-10-11 operator (via bright-moth-475): added https://srv1.tailecbe08.ts.net:8444/auth/google/callback to client 433089409875-2c1u5obhaeafee9ve7igpopt5oiqoa8k; the client now carries the srv2 :18082 and srv1 :8444 URIs. Console step; no Auth Platform write API." as NonEmptyStr

data tracker_web_test_secret_manager_actuation: NonEmptyStr = "2026-10-11 operator (via bright-moth-475): created Secret Manager secret tracker-web-dev-oauth-client-secret in gunbai-secrets, version 1." as NonEmptyStr

data tracker_web_dev_oauth_client_secret_ref: SecretRef = secret_ref_pin_version(
  ref: fleet_secret_ref(secret_id: "tracker-web-dev-oauth-client-secret"),
  version: "1",
)

data tracker_web_dev_oauth_client_secret_host_path: NonEmptyStr = "/etc/gunbc-oidc/tracker-web-dev-client-secret" as NonEmptyStr

data tracker_web_dev_oidc_config_host_path: NonEmptyStr = "/etc/gunbc-oidc/tracker-web-dev.json" as NonEmptyStr

type TrackerWebOidcServeConfig {
  config_path: NonEmptyStr
  redirect_uri: NonEmptyStr
  secret_file: NonEmptyStr
  binding: TrackerWebOauthClientBinding
}

fn tracker_web_realization_for_instance(instance_id: NonEmptyStr) -> TrackerWebRedirectRealization? {
  filter(tracker_web_test_redirect_realizations(), r =>
    match r.assigned_instance_id {
      Absent => false
      Present { value: id } => (id as String) == (instance_id as String)
    }
  ).first()
}

fn tracker_web_oidc_serve_config(instance_id: NonEmptyStr) -> TrackerWebOidcServeConfig? {
  match tracker_web_instance_environment(instance_id: instance_id) {
    Absent => none
    Present { value: env } =>
      match tracker_web_oauth_standing_for_environment(environment: env) {
        TrackerWebOauthClientUnbound { environment: _, reason: _ } => none
        TrackerWebOauthClientBound { binding: b } =>
          match tracker_web_realization_for_instance(instance_id: instance_id) {
            Absent => none
            Present { value: r } =>
              Present {
                value: TrackerWebOidcServeConfig {
                  config_path: tracker_web_dev_oidc_config_host_path,
                  redirect_uri: r.uri,
                  secret_file: tracker_web_dev_oauth_client_secret_host_path,
                  binding: b,
                }
              }
          }
      }
  }
}

fn tracker_web_oidc_config_document(cfg: TrackerWebOidcServeConfig) -> String {
  let b = cfg.binding
  serialize_json(v: json_object(members: [
    json_kv(key: "schema", value: json_string(s: oidc_config_schema)),
    json_kv(key: "client_id", value: json_string(s: b.client_id as String)),
    json_kv(key: "client_secret_file", value: json_string(s: cfg.secret_file as String)),
    json_kv(key: "redirect_uri", value: json_string(s: cfg.redirect_uri as String)),
    json_kv(key: "admitted_audiences", value: json_array(elements: map(b.admitted_audiences, a => json_string(s: a as String)))),
    json_kv(key: "expected_hosted_domain", value: json_string(s: b.hosted_domain.domain as String)),
    json_kv(key: "session_lifetime_seconds", value: json_int(n: oidc_session_lifetime_seconds)),
    json_kv(key: "login_transaction_lifetime_seconds", value: json_int(n: oidc_login_transaction_lifetime_seconds)),
  ]))
}

fn tracker_web_oidc_env_assignment(cfg: TrackerWebOidcServeConfig) -> NonEmptyStr {
  join([oidc_config_env_var as String, "=", cfg.config_path as String], "") as NonEmptyStr
}

fn production_has_no_oidc_serve_config() -> Bool {
  match tracker_web_oidc_serve_config(instance_id: srv1_dashboard_live_id) {
    Absent => true
    Present { value: _ } => false
  }
}

data srv2_hand_started_oidc_unit_dissolution: DissolutionCondition = unbound_dissolution(
  description: "TRIGGER: a DesiredDeployment whose serve unit and oidc-config/v1 file are emitted for an instance assigned the tracker-web TEST environment that currently realizes https://srv2.tailecbe08.ts.net:18082/auth/google/callback, sufficient to delete the hand-started gunbc-dash-18082.service and the hand-placed oidc-config.json as the live login path. A custody delivery of the client secret onto srv2 without a modeled serve unit is not this trigger." as NonEmptyStr
)

data srv2_hand_started_oidc_unit_frontier: FrontierRow = frontier_row_path(
  path: "gunbc-dash-18082.service",
  reason: "srv2 tracker-web TEST login is a hand-started transient user unit with a hand-placed oidc-config.json; live_deploy does not own that instance in this change",
  dissolution: srv2_hand_started_oidc_unit_dissolution,
)

data tracker_web_test_owned_domain_dissolution: DissolutionCondition = unbound_dissolution(
  description: "TRIGGER: DNS for tracker-dev.gunb.ai plus a TLS path that is not Tailscale's *.ts.net certificate, sufficient for the TEST environment's Google redirect URI set to be the owned-domain URIs and for today's srv1/srv2 ts.net realizations to retire. A row that only names the domain, or a Tailscale serve HTTPS listener on ts.net, is not this trigger." as NonEmptyStr
)

data tracker_web_test_owned_domain_frontier: FrontierRow = frontier_row_path(
  path: "tracker-dev.gunb.ai",
  reason: "the TEST environment's stable redirect target is tracker-dev.gunb.ai; today's ts.net URIs are the current realization until DNS and a non-tailnet TLS path exist",
  dissolution: tracker_web_test_owned_domain_dissolution,
)
