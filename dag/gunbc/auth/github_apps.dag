module gunbc.auth.github_apps

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.upsert_decision { ObservationVerdict, Converged, Drifted, UnknownRefused }
import extdeps.cloud.gcp.secret_ref { SecretRef, HashPending }
import extdeps.github.app {
  GitHubAppId,
  GitHubAppInstallationId,
  GitHubAppRegistration,
  GitHubAppInstallation,
  GitHubAppPermission,
  GitHubAppPermissionName,
  GitHubAppPermissionAccess,
  AppAccessRead,
  AppAccessWrite,
  GitHubAppPublicKeyFingerprint,
  sha256_base64_key_fingerprint,
  key_fingerprint_eq,
  permission_access_at_least,
  permission_name_eq
}
import gunbc.fleet_secrets_config { fleet_secrets_gcp_project }

type DeclaredGitHubApp {
  owner_login: NonEmptyStr
  app_id: GitHubAppId
  client_id: NonEmptyStr
  slug: NonEmptyStr
}

data gunbai_bot_declared: DeclaredGitHubApp = DeclaredGitHubApp {
  owner_login: "gunb-ai",
  app_id: GitHubAppId { value: 3909950 },
  client_id: "Iv23lidZeLYckmtvN3e8",
  slug: "gunbai",
}

data gunbai_ci_declared: DeclaredGitHubApp = DeclaredGitHubApp {
  owner_login: "gunb-ai",
  app_id: GitHubAppId { value: 2653532 },
  client_id: "Iv23liq8VGaImxKCyjaR",
  slug: "gunbai-ci",
}

data gunbai_ci_app_pem_secret: SecretRef = SecretRef {
  project: fleet_secrets_gcp_project,
  secret: "ci-github-app-private-key",
  version: "latest",
  hash_state: HashPending,
}

data gunbai_ci_declared_installation_id: GitHubAppInstallationId = GitHubAppInstallationId { value: 104134109 }

type ManagedGitHubAppKeyRole
  = ActiveSigningKey
  | RetiringSigningKey

type ManagedGitHubAppKey {
  fingerprint: GitHubAppPublicKeyFingerprint
  role: ManagedGitHubAppKeyRole
}

data gunbai_bot_declared_key: ManagedGitHubAppKey = ManagedGitHubAppKey {
  fingerprint: sha256_base64_key_fingerprint(digest: "B+ANMzYq0nhBn6L7STPkdsEw07QkdXXvbj0gjxvt5BQ="),
  role: ActiveSigningKey,
}

type GitHubAppObservation<T>
  = AppObserved { value: T }
  | AppUnobserved { reason: NonEmptyStr }

data gunbai_bot_registration_observation: GitHubAppObservation<GitHubAppRegistration> = AppUnobserved { reason: "no App-JWT-authenticated observation producer runs in this tree; gunbai[bot] has no modeled key custody" }

data gunbai_bot_installation_observation: GitHubAppObservation<GitHubAppInstallation> = AppUnobserved { reason: "no App-JWT-authenticated observation producer runs in this tree; gunbai[bot] has no modeled key custody" }

data gunbai_ci_installation_observation: GitHubAppObservation<GitHubAppInstallation> = AppUnobserved { reason: "no App-JWT-authenticated observation producer runs in this tree; ci-github-app-private-key is modeled but no JWT-mint producer consumes it" }

data gunbai_bot_key_observation: GitHubAppObservation<ManagedGitHubAppKey> = AppUnobserved { reason: "GitHub App private-key inventory requires App-JWT authentication" }

data gunbai_bot_webhook_observation: GitHubAppObservation<NonEmptyStr> = AppUnobserved { reason: "webhook endpoint, secret presence, subscribed events and delivery health are unobserved" }

type GitHubAppConsumer {
  consumer: DeclarationRef
  purpose: NonEmptyStr
  required_permissions: List<GitHubAppPermission>
}

type GitHubAppEnrollment {
  declared: DeclaredGitHubApp
  consumers: List<GitHubAppConsumer>
}

fn perm(wire_name: NonEmptyStr, access: GitHubAppPermissionAccess) -> GitHubAppPermission {
  GitHubAppPermission { name: GitHubAppPermissionName { wire_name: wire_name }, access: access }
}

data gunbai_ci_enrollment: GitHubAppEnrollment = GitHubAppEnrollment {
  declared: gunbai_ci_declared,
  consumers: [
    {
      consumer: DeclarationRef {
        module_path: "gunbc.runner_host_deploy",
        decl_name: "srv4_runner_host_deploy",
        field: WholeDeclaration
      },
      purpose: "register ephemeral self-hosted runners on a fleet host",
      required_permissions: [
        perm(wire_name: "metadata", access: AppAccessRead),
        perm(wire_name: "administration", access: AppAccessWrite),
      ]
    }
  ]
}

data gunbai_bot_enrollment: GitHubAppEnrollment = GitHubAppEnrollment {
  declared: gunbai_bot_declared,
  consumers: [
    {
      consumer: DeclarationRef {
        module_path: "gunbc.ci_workflow",
        decl_name: "ci_heal_commit_push_step",
        field: WholeDeclaration
      },
      purpose: "push the regenerated generated-artifact commit to the admitted attempt branch, including the .github/workflows/** projections that define the self-hosted CI this heal runs under",
      required_permissions: [
        perm(wire_name: "metadata", access: AppAccessRead),
        perm(wire_name: "contents", access: AppAccessWrite),
        perm(wire_name: "workflows", access: AppAccessWrite),
      ]
    },
    {
      consumer: DeclarationRef {
        module_path: "tools.ci_heal_dispatch",
        decl_name: "main",
        field: WholeDeclaration
      },
      purpose: "dispatch the heal revalidation run against the immutable healed head",
      required_permissions: [
        perm(wire_name: "metadata", access: AppAccessRead),
        perm(wire_name: "actions", access: AppAccessWrite),
      ]
    }
  ]
}

data enrollment_consumer_is_the_effecting_step_note: String = "A CONSUMER ROW NAMES THE DECLARATION THAT PERFORMS THE EFFECT, not one that merely precedes or classifies it (cursor/composer-2.5, review 48030). The heal row originally cited gunbc.ci_workflow ci_heal_regen_step while describing a push; regen only writes the local worktree and ci_heal_commit_push_step is what reaches GitHub, so contents:write was attributed to a step that never authenticates. It read as correct because permissions live on the enrollment row rather than on the referenced declaration — the misattribution changed no derived value and would have gone on being copied.\n\nWHY workflows:write ALSO LANDS ON THE PUSH STEP rather than on gunbc.generated_artifact artifact_heal_policy: that fold decides WHICH paths are eligible, it does not push them. Both permissions belong to the one declaration that performs the authenticated push, which is why this is a single consumer row and not two."

data no_permissions: List<GitHubAppPermission> = []

data no_permission_names: List<GitHubAppPermissionName> = []

fn permission_name_in_list(name: GitHubAppPermissionName, names: List<GitHubAppPermissionName>) -> Bool {
  fold_list(
    xs: names,
    empty: false,
    cons: fn(found, n) { found || permission_name_eq(a: n, b: name) }
  )
}

fn enrollment_permissions(enrollment: GitHubAppEnrollment) -> List<GitHubAppPermission> {
  fold_list(
    xs: enrollment.consumers,
    empty: no_permissions,
    cons: fn(acc, c) { concat(acc, c.required_permissions) }
  )
}

fn permission_names(perms: List<GitHubAppPermission>) -> List<GitHubAppPermissionName> {
  fold_list(
    xs: perms,
    empty: no_permission_names,
    cons: fn(acc, p) {
      if permission_name_in_list(name: p.name, names: acc) { acc } else { concat(acc, [p.name]) }
    }
  )
}

fn permission_max_access(perms: List<GitHubAppPermission>, name: GitHubAppPermissionName) -> GitHubAppPermissionAccess {
  fold_list(
    xs: perms,
    empty: AppAccessRead,
    cons: fn(acc, p) {
      if permission_name_eq(a: p.name, b: name) && permission_access_at_least(held: p.access, requested: acc) { p.access } else { acc }
    }
  )
}

fn app_required_permissions(enrollment: GitHubAppEnrollment) -> List<GitHubAppPermission> {
  let all = enrollment_permissions(enrollment: enrollment)
  map(permission_names(perms: all), n => GitHubAppPermission { name: n, access: permission_max_access(perms: all, name: n) })
}

data gunbai_bot_required_permissions: List<GitHubAppPermission> = app_required_permissions(enrollment: gunbai_bot_enrollment)

data gunbai_ci_required_permissions: List<GitHubAppPermission> = app_required_permissions(enrollment: gunbai_ci_enrollment)

data installation_granted_permissions_note: String = "WHAT THE INSTALLATION ACTUALLY GRANTS — an operator-signed record of GitHub's state, deliberately NOT derived from the consumers' required set. The two are separate facts and the whole point of this module is that their difference is countable: app_required_permissions says what the code needs, this row says what GitHub currently hands out, and ungranted_required_permissions is the gap. Deriving one from the other would make the gap unrepresentable and the requirement self-satisfying.\n\nWHY IT IS A DECLARED ROW RATHER THAN AN OBSERVATION: reading an installation's permissions requires App-JWT authentication against the private key in gunbai_ci_app_pem_secret, and no JWT-mint producer runs in this tree (the same reason every GitHubAppObservation here is AppUnobserved). Until one exists this is a declaration, and its honest failure mode is stated rather than hidden: if this row claims a grant GitHub has not made, the heal's push is rejected at the remote with GH013 — loud, located, attributable to this row — never a silent wrong answer. The conservative direction (claiming less than is granted) costs only an author commit. Dissolve-on: an App-JWT observation producer lands, at which point this row becomes the declared side of an ordinary Converged/Drifted verdict like every other row in this module.\n\nTHE workflows GRANT IS THE LIVE GAP. gunbc.generated_artifact artifact_heal_policy derives .github/workflows/** heal eligibility from whether this row holds workflows:write. It does not, so those paths stay AuthorCommitRequired and the auto-heal cannot repair the self-hosted workflow definitions it runs under — a PR whose ci.yml drifts blocks on a human commit. Granting workflows:write to the gunbai app installation on gunb-ai/gunbc and adding that one permission here flips the policy by data; no heal shell, path list, or job definition is edited, because auto_push_eligible_committed_artifact_paths already derives from the same fold."

data gunbai_bot_installation_granted_permissions: List<GitHubAppPermission> = [
  perm(wire_name: "metadata", access: AppAccessRead),
  perm(wire_name: "contents", access: AppAccessWrite),
  perm(wire_name: "actions", access: AppAccessWrite),
]

fn app_holds_permission(
  granted: List<GitHubAppPermission>,
  required: GitHubAppPermission
) -> Bool {
  permission_name_in_list(name: required.name, names: permission_names(perms: granted))
    && permission_access_at_least(
         held: permission_max_access(perms: granted, name: required.name),
         requested: required.access
       )
}

fn ungranted_required_permissions(
  enrollment: GitHubAppEnrollment,
  granted: List<GitHubAppPermission>
) -> List<GitHubAppPermission> {
  filter(
    app_required_permissions(enrollment: enrollment),
    r => !app_holds_permission(granted: granted, required: r)
  )
}

data gunbai_bot_ungranted_permissions: List<GitHubAppPermission> = ungranted_required_permissions(
  enrollment: gunbai_bot_enrollment,
  granted: gunbai_bot_installation_granted_permissions
)

data heal_workflow_projection_permission: GitHubAppPermission = perm(wire_name: "workflows", access: AppAccessWrite)

fn heal_app_can_push_workflow_paths() -> Bool {
  app_holds_permission(
    granted: gunbai_bot_installation_granted_permissions,
    required: heal_workflow_projection_permission
  )
}

fn permissions_subsumed(held: List<GitHubAppPermission>, required: List<GitHubAppPermission>) -> Bool {
  fold_list(
    xs: required,
    empty: true,
    cons: fn(ok, r) {
      ok && permission_name_in_list(name: r.name, names: permission_names(perms: held))
         && permission_access_at_least(held: permission_max_access(perms: held, name: r.name), requested: r.access)
    }
  )
}

fn permissions_equal(a: List<GitHubAppPermission>, b: List<GitHubAppPermission>) -> Bool {
  permissions_subsumed(held: b, required: a) && permissions_subsumed(held: a, required: b)
}

fn app_permission_grant_verdict(
  enrollment: GitHubAppEnrollment,
  observed: GitHubAppObservation<GitHubAppInstallation>
) -> ObservationVerdict {
  match observed {
    AppUnobserved { reason: _ } => UnknownRefused
    AppObserved { value } =>
      if permissions_equal(a: app_required_permissions(enrollment: enrollment), b: value.permissions) {
        Converged
      } else {
        Drifted
      }
  }
}

fn key_fingerprint_verdict(
  declared: ManagedGitHubAppKey,
  observed: GitHubAppObservation<ManagedGitHubAppKey>
) -> ObservationVerdict {
  match observed {
    AppUnobserved { reason: _ } => UnknownRefused
    AppObserved { value } =>
      if key_fingerprint_eq(a: value.fingerprint, b: declared.fingerprint) { Converged } else { Drifted }
  }
}

data gunbai_bot_key_verdict: ObservationVerdict = key_fingerprint_verdict(declared: gunbai_bot_declared_key, observed: gunbai_bot_key_observation)

data gunbai_bot_permission_verdict: ObservationVerdict = app_permission_grant_verdict(enrollment: gunbai_bot_enrollment, observed: gunbai_bot_installation_observation)

data gunbai_ci_permission_verdict: ObservationVerdict = app_permission_grant_verdict(enrollment: gunbai_ci_enrollment, observed: gunbai_ci_installation_observation)
