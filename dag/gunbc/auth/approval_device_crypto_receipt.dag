module gunbc.auth.approval_device_crypto_receipt

import std.types { String, List, NonEmptyStr }
import gunbc.native_serve { NativeServeStartup, NativeServeStartupPassed, NativeServeStartupRefused }
import gunbc.auth.approval_device_crypto_realization {
  DeviceCryptoObligation, DeviceCryptoHandlerReceipt, NativeDeviceCryptoBound, device_crypto_admission,
  DeviceCryptoAdmitted, DeviceCryptoRefused,
}

// THE HALF OF THE STARTUP SELF-CHECK THAT JUDGES A RECEIPT, apart from the folds that earn it, so the one place that
// mints a receipt and asks gunbc.auth.approval_device_crypto_realization device_crypto_admission whether it covers the
// population is shared by the verifier (gunbc.auth.approval_device_crypto_self_check device_crypto_startup, which
// executes the obligations and supplies the binary's digest) and by the control that drops obligations
// (gunbc.instruments.native_serve_startup_refusal_fixture). A receipt that omits an obligation is refused by
// device_crypto_admission naming the evidence it lacks; the startup carries that refusal and the door then refuses to bind.
data device_crypto_handler_identity: NonEmptyStr = "gunbc.auth.approval_device_crypto_serve native_serve_handle"

fn device_crypto_receipt_startup(covered: List<DeviceCryptoObligation>, exact_revision: NonEmptyStr) -> NativeServeStartup {
  let receipt = DeviceCryptoHandlerReceipt {
    handler_identity: device_crypto_handler_identity,
    exact_revision: exact_revision,
    covered: covered,
  }
  match device_crypto_admission(r: NativeDeviceCryptoBound { receipt: receipt }) {
    DeviceCryptoAdmitted { handler_identity: h, exact_revision: r } =>
      NativeServeStartupPassed { note: concat(h as String, concat(" @ sha256:", r as String)) }
    DeviceCryptoRefused { status: _, reason: why } => NativeServeStartupRefused { reason: why }
  }
}
