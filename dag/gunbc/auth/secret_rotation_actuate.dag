data secret_rotation_actuate_frontier_note: String = "HOST SCOPE: this module's GcloudPrintToken path is for operator-workstation actuation (local gunbc run / dashboard dispatch where gcloud user auth exists). GHA self-hosted runner slots do not carry gcloud — binding GcloudPrintToken there fails at runtime. Runner actuation must use gunbc.github_actions_wif once that authority exists on origin/main. WIF FRONTIER (present state): gunbc.github_actions_wif is absent from main; rows exist only on origin/session/pi-reach-0, PR #7971 CLOSED without merge — dead work, not in flight. Revival versus fresh authoring is an operator decision — no private duplicate rows here. When the authority exists, runner actuation binds github_actions_wif_pool, github_actions_wif_provider, github_actions_wif_provider_resource, github_actions_wif_attribute_condition, and github_actions_wif_principal_set, impersonating fleet-automation@ with access_token output — never auth_token, never a pasted operator token (ACCESS_TOKEN_TYPE_UNSUPPORTED upstream)."

fn version_number_from_resolved_identity(identity: SmResolvedVersionIdentity) -> NonEmptyStr? {
  let parts = split(s: identity as String, delimiter: "/versions/")
  if count(parts) != 2 {
    Absent
  } else {
    match parts |> skip(n: 1) |> first {
      Present { value: version_id } =>
        if version_id != "" && !string_contains(s: version_id, pattern: "/") {
          Present { value: version_id as NonEmptyStr }
        } else {
          Absent
        }
      Absent => Absent
    }
  }
}

fn read_back_added_version(
  token: Secret,
  secret_ref: SecretRef,
  added_identity: SmResolvedVersionIdentity,
) -> ReadBackOutcome {
  match version_number_from_resolved_identity(identity: added_identity) {
    Absent =>
      ReadBackRefused {
        cause: ReadBackPayloadUnverified {
          cause: "added version identity is not a well-formed version resource" as NonEmptyStr,
        },
      }
    Present { value: version_number } => {
      let access = gcp.SecretManager.AccessVersion(
        access_token: token,
        project_id: secret_ref.project,
        secret: secret_ref.secret,
        version: version_number,
      )
      verify_read_back(
        decoded: decode_sm_access_version_wire_response(
          name: access.name as String,
          data_b64: access.data_b64,
        ),
        expected: added_identity,
        payload: PayloadMatchesWritten,
      )
    }
  }
}

fn disable_targets(
  token: Secret,
  targets: List<VersionTarget>,
) -> List<DisableReceipt> {
  fold_list(
    xs: targets,
    empty: [],
    cons: fn(acc, target) {
      let result = gcp.SecretManager.DisableVersion(
        access_token: token,
        version_name: target.identity,
        etag: target.etag,
      )
      match admit_disable_receipt(version: target.identity, observed_state: result.state) {
        Present { value: receipt } => concat(acc, [receipt])
        Absent => acc
      }
    },
  )
}

fn destroy_targets(
  token: Secret,
  targets: List<VersionTarget>,
) -> List<DestroyReceipt> {
  fold_list(
    xs: targets,
    empty: [],
    cons: fn(acc, target) {
      let result = gcp.SecretManager.DestroyVersion(
        access_token: token,
        version_name: target.identity,
        etag: target.etag,
      )
      match admit_destroy_receipt(version: target.identity, observed_state: result.state) {
        Present { value: receipt } => concat(acc, [receipt])
        Absent => acc
      }
    },
  )
}

fn list_secret_inventory(token: Secret, secret_ref: SecretRef) -> VersionInventory {
  let response = gcp.SecretManager.ListVersions(
    access_token: token,
    secret_name: secret_ref_secret_resource(ref: secret_ref),
    page_size: 100,
    page_token: "",
  )
  inventory_from_list_response(
    response: ListSecretVersionsResponse {
      versions: response.versions,
      next_page_token: match response.next_page_token {
        Present { value: t } => Present { value: t }
        Absent => Absent
      },
    },
  )
}

func execute_secret_rotation(
  intent: SecretRotationIntent,
  attempt: RotationAttempt,
  evidence: List<ConsumerVersionEvidence>,
  replacement: Secret,
  token_source: AccessTokenSource,
) -> SecretRotationOutcome
  uses net: Network
{
  match authorize_add_version(attempt: attempt) {
    AddVersionRefused { cause: cause } =>
      match cause {
        AlreadyRotated { added: added } =>
          RotationAlreadyComplete { added: added }
        AddAlreadySucceeded { added: added } =>
          RotationAlreadyComplete { added: added }
        AddAlreadyIssued { intent_id: _ } =>
          RotationRefused {
            cause: IssuedAddUnresolved {
              cause: "add already issued without persisted expected identity; list inventory before retry" as NonEmptyStr,
            },
          }
      }
    AddVersionAuthorized { intent_id: _ } =>
      match ensure_access_token(source: token_source) {
        AccessTokenUpsertRequired { plan: plan } =>
          RotationRefused {
            cause: IssuedAddUnresolved {
              cause: access_token_upsert_required_reason(plan: plan) as NonEmptyStr,
            },
          }
        AccessTokenEnsureRefused { reason: reason } =>
          RotationRefused {
            cause: IssuedAddUnresolved { cause: reason },
          }
        AccessTokenReady { token: token } => {
          let added_identity = match attempt {
            AttemptNotStarted { intent_id: _ } => {
              let payload_b64 = encode_sm_access_version_payload_wire(credential: replacement)
              let add_out = gcp.SecretManager.AddVersion(
                access_token: token,
                secret_name: secret_ref_secret_resource(ref: intent.subject),
                payload_b64: payload_b64,
              )
              match decode_sm_resolved_version_identity_wire(name: add_out.name as String) {
                SmResolvedVersionIdentityDecoded { identity: identity } => identity
                SmResolvedVersionIdentityDecodeRefused { cause: _ } =>
                  return RotationRefused {
                    cause: IssuedAddUnresolved {
                      cause: "AddVersion returned a version identity the wire decoder refused" as NonEmptyStr,
                    },
                  }
              }
            }
            AttemptAddIssued { intent_id: _ } =>
              return RotationRefused {
                cause: IssuedAddUnresolved {
                  cause: "attempt add issued without persisted expected identity; observe inventory before retry" as NonEmptyStr,
                },
              }
            AttemptAdded { intent_id: _, added: added } => added
            AttemptCompleted { intent_id: _, added: added } => added
          }
          let read_back = read_back_added_version(
            token: token,
            secret_ref: intent.subject,
            added_identity: added_identity,
          )
          match read_back {
            ReadBackRefused { cause: cause } =>
              RotationRefused { cause: ReadBackFailed { cause: cause } }
            ReadBackConfirmed { added: added, payload: _ } => {
              let inventory = list_secret_inventory(token: token, secret_ref: intent.subject)
              match authorize_retirement(
                intent: intent,
                added: added,
                evidence: evidence,
                inventory: inventory,
              ) {
                RetirementRefused { cause: cause } =>
                  RotationRefused { cause: RetirementNotAuthorized { cause: cause } }
                RetirementAuthorized { targets: targets, destroy_permitted: destroy_permitted } => {
                  let disabled = disable_targets(token: token, targets: targets)
                  let effect = if destroy_permitted {
                    match authorize_destroy(
                      intent: intent,
                      evidence: evidence,
                      inventory: inventory,
                      added: added,
                      disabled: targets,
                    ) {
                      DestroyRefused { cause: cause } =>
                        return RotationRefused { cause: DestroyNotAuthorized { cause: cause } }
                      DestroyAuthorized { targets: destroy_targets_list } =>
                        RetirementApplied {
                          disabled: disabled,
                          destroyed: destroy_targets(token: token, targets: destroy_targets_list),
                        }
                    }
                  } else {
                    RetirementApplied { disabled: disabled, destroyed: [] }
                  }
                  emit_rotation_receipt(
                    intent: intent,
                    read_back: read_back,
                    proofs: all_consumer_proofs(
                      requirement: intent.verification,
                      evidence: evidence,
                      secret: intent.subject,
                      added: added,
                    ),
                    effect: effect,
                    branch: BranchStandingUnknown {
                      cause: "rotation actuation does not model branch revocation" as NonEmptyStr,
                    },
                  )
                }
              }
            }
          }
        }
      }
  }
}
