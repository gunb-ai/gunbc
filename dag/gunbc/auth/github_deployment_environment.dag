module gunbc.auth.github_deployment_environment

import std.types { String, NonEmptyStr, List, Bool }
import extdeps.github.deployment_environments {
  GitHubEnvironmentProtectionSettings,
  SelectedBranchesAndTags, DeploymentBranchPolicyRule, DeploymentBranchPolicyRefType, PolicyRefBranch, PolicyRefTag,
  RequiredReviewers,
  EnvironmentDeploymentBranchPolicy,
  EnvironmentReviewerRequirement,
  AllBranchesAndTags,
  ProtectedBranchesOnly,
  NoRequiredReviewers,
}
import gunbc.auth.arrival_federation_pair {
  srv15_arrival_federation_pair,
  arrival_lane_environment,
}

// THE BOUNDARY FOR WHICH CODE MAY ASK TO MUTATE srv1 AS ROOT is this environment's GitHub protection,
// applied by an operator in the repository settings: the selected branch rule `main` only. Jobs that
// bind ci_deploy_srv1_access name this environment. A github.ref == main job `if` is not that boundary:
// a branch dispatch runs that branch's YAML. WHETHER a job may mutate is not this environment's fact: it
// is the operator's device approval each job files (gunbc.fleet.srv1_root_mutation_approval_run). The
// required reviewer was removed by the operator on 2026-10-28, after one approval (fleet-converge run
// 40556605128) and one denial (run 40614818089) were witnessed on real dispatches, which is the removal
// condition of gunbc.design_ruling srv1_root_mutation_approval_is_filed_by_the_job.

data srv1_production_environment_name: NonEmptyStr = "srv1-production"

data srv1_production_required_protection: GitHubEnvironmentProtectionSettings = GitHubEnvironmentProtectionSettings {
  name: srv1_production_environment_name as String,
  deployment_branch_policy: SelectedBranchesAndTags { rules: [DeploymentBranchPolicyRule { name: "main", ref_type: PolicyRefBranch }] },
  reviewer_requirement: NoRequiredReviewers,
}

type EnvironmentProtectionStanding
  = EnvironmentProtectionUnobserved { required: GitHubEnvironmentProtectionSettings, read_obligation: String }
  | EnvironmentProtectionHolds { required: GitHubEnvironmentProtectionSettings }
  | EnvironmentProtectionDiverges { required: GitHubEnvironmentProtectionSettings, detail: String }

data srv1_production_protection_standing: EnvironmentProtectionStanding = EnvironmentProtectionUnobserved {
  required: srv1_production_required_protection,
  read_obligation: "GET /repos/gunb-ai/gunbc/environments/srv1-production (and its deployment-branch-policy / required-reviewers) must show deployment_branch_policy { protected_branches: false, custom_branch_policies: true } with exactly one branch rule named main in GET .../deployment-branch-policies and no required_reviewers protection rule. The operator applies that in the GitHub environment UI; the workflow file cannot.",
}

fn deployment_rule_is_a_branch(rule: DeploymentBranchPolicyRule) -> Bool {
  match rule.ref_type {
    PolicyRefBranch => true
    PolicyRefTag => false
  }
}

fn environment_protection_restricts_to_main(settings: GitHubEnvironmentProtectionSettings) -> Bool {
  match settings.deployment_branch_policy {
    SelectedBranchesAndTags { rules: rs } => count(rs) == 1 && any(rs, r => r.name == "main" && deployment_rule_is_a_branch(rule: r))
    AllBranchesAndTags => false
    ProtectedBranchesOnly => false
  }
}

fn environment_protection_requires_reviewers(settings: GitHubEnvironmentProtectionSettings) -> Bool {
  match settings.reviewer_requirement {
    RequiredReviewers => true
    NoRequiredReviewers => false
  }
}

fn srv1_production_required_protection_is_the_boundary() -> Bool {
  environment_protection_restricts_to_main(settings: srv1_production_required_protection)
    && !environment_protection_requires_reviewers(settings: srv1_production_required_protection)
    && (srv1_production_required_protection.name as String) == (srv1_production_environment_name as String)
}

// THE srv15-arrival ENVIRONMENT, modeled before it is created (smart-crane-730, PXE 2c out-of-repo
// brief). The arrival job keys on ${{inputs.arrival_subject}}-arrival
// (gunbc.fleet.fleet_converge_workflow fleet_converge_arrival_environment_expression), so this
// environment's NAME is that same derivation over gunbc.auth.arrival_federation_pair's srv15 row --
// no "srv15-arrival" text is spelled here (single_authority). It differs from srv1-production in
// exactly one respect, the operator's design: REQUIRED REVIEWERS are part of its protection (the
// srv1 reviewer was removed after its witnessed approvals; the arrival lane keeps them). Whether the
// lane's dispatch may mutate anything is NOT this environment's fact -- the accessor gate is
// gunbc.secret_provision.accessor_ref_from_pin, which yields Absent while the version pin stands
// TranscribedUncited, so the arrival door refuses closed before any secret traffic.
data srv15_arrival_environment_name: NonEmptyStr =
  arrival_lane_environment(pair: srv15_arrival_federation_pair, lane: "arrival")

// The reviewer identity is THE ONE FIELD filled from the operator's decision. It is now FILLED:
// briansrls, GitHub user id 11205878 (operator decision msg_a6718a1d, relayed by smart-crane-730 and
// approved by default; recommendation was msg_bda70b7b). While the standing was Awaiting, this row
// refused to answer yes on creation -- the environment was not created and no API call was made; the
// creation now proceeds ONLY through the API call reproducing the protection below exactly, and the
// read-back must show this principal.
type ArrivalReviewerDecision
  = ArrivalReviewerAwaitingOperatorDecision { candidates: List<NonEmptyStr>, decision_obligation: String }
  | ArrivalReviewerDecided { principal: NonEmptyStr }

data srv15_arrival_reviewer_decision: ArrivalReviewerDecision = ArrivalReviewerDecided {
  principal: "briansrls (GitHub user id 11205878; operator decision msg_a6718a1d relayed by smart-crane-730, approved by default)",
}

data srv15_arrival_required_protection: GitHubEnvironmentProtectionSettings = GitHubEnvironmentProtectionSettings {
  name: srv15_arrival_environment_name as String,
  deployment_branch_policy: SelectedBranchesAndTags { rules: [DeploymentBranchPolicyRule { name: "main", ref_type: PolicyRefBranch }] },
  reviewer_requirement: RequiredReviewers,
}

data srv15_arrival_protection_standing: EnvironmentProtectionStanding = EnvironmentProtectionUnobserved {
  required: srv15_arrival_required_protection,
  read_obligation: "After creation, GET /repos/gunb-ai/gunbc/environments/srv15-arrival (and its deployment-branch-policy / required-reviewers) must show deployment_branch_policy { protected_branches: false, custom_branch_policies: true } with exactly one branch rule named main in GET .../deployment-branch-policies and a required_reviewers protection rule listing exactly the decided principal briansrls, GitHub user id 11205878 (operator decision msg_a6718a1d). The operator applies that in the GitHub environment UI or the API call reproduces it exactly; the workflow file cannot.",
}

fn srv15_arrival_required_protection_is_the_boundary() -> Bool {
  environment_protection_restricts_to_main(settings: srv15_arrival_required_protection)
    && environment_protection_requires_reviewers(settings: srv15_arrival_required_protection)
    && (srv15_arrival_required_protection.name as String) == (srv15_arrival_environment_name as String)
}

// A port that cannot establish its effect refuses: creation is permitted only once the reviewer is a
// DECIDED principal. The committed standing is Decided (the operator's decision, msg_a6718a1d); an
// Awaiting standing -- as this row held before that decision -- answers false, and any supplied
// Awaiting stays refused.
fn srv15_arrival_environment_creation_permitted(decision: ArrivalReviewerDecision) -> Bool {
  match decision {
    ArrivalReviewerDecided { principal: _ } => true
    ArrivalReviewerAwaitingOperatorDecision { candidates: _, decision_obligation: _ } => false
  }
}
