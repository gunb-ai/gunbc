module gunbc.auth.deployment_gate_operator_steps

// The OPERATOR'S OWN ACTS for moving the srv1 deployment gate from the GitHub "Review deployments"
// click onto the existing ntfy tap, modelled as std.human_intervention rows rather than as prose
// in a runbook. The plan that argues for them is gunbc.plans.ntfy_deployment_gate_approval; this
// file carries their burden, so that the human cost of this design is countable next to the other
// human burdens in the provisioning fleet (DESIGN §2: an alternative that quietly keeps a human
// step is not cheaper, it is uncounted).
//
// WHY EVERY ROW HERE IS AN OPERATOR ACT AND NOT AN AUTOMATION. GitHub's own UI is the only place
// that can create a GitHub App's client ID and private key, install the App on an organization, and
// tick a custom deployment protection rule onto a protected environment. The agent does not touch
// GitHub environment settings at all in this design; that is a hard constraint of the work item,
// not a convenience.
//
// WHY NO ROW MAY BE DISCHARGED BY EDITING A FLAG BESIDE IT (DESIGN §5). Each row states the
// observation that shows the act happened, and the two rows that could silently open the srv1
// boundary — enabling the rule and removing the human reviewer — state their observation as a
// READ BACK FROM GITHUB, not as a checkbox. In particular the removal row must not be dischargeable
// before the enablement row's approve-AND-reject witness exists: the ordering is the thing that
// keeps the gate shut at every instant.
//
// WHY THIS FILE CARRIES NO TESTS. No module under dag/gunbc/auth does, and it is not an accident: a
// production module that ships fixtures ships values someone can mistake for observations, and a
// guarded act built from a fixture is the prose guard it replaced wearing a type. Every witness for
// these rows, and every fixture they mutate, lives in
// test.claim.deployment_gate_operator_steps_witness. What stays here is the rows and the folds
// that decide them.

import std.types {
  String,
  List,
  Bool,
}

import std.human_intervention {
  HumanIntervention,
  HumanInterventionFrequency,
  HumanInterventionIdentity,
  FleetOnce,
  NoDischargeSiteModeled,
  DischargedAt,
  human_intervention_frequency_eq,
}
import extdeps.github.app { GitHubAppPermission }
import gunbc.auth.deployment_gate_authorization {
  gate_app_permissions,
  ReviewerRemovalAdmission,
  RemovalAdmitted,
  RemovalRefused,
  RemovalRefusalReason,
  DeploymentGateTrialEvidence,
}
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.auth.github_deployment_environment { srv1_production_environment_name }

// The repository the App is installed on. Named once, in one row, so the installation subject and
// the rule-enablement subject cannot drift apart into two different repos.
data deployment_gate_repository: NonEmptyStr = "gunb-ai/gunbc"

// The environment whose gate moves. Reused from the row that already owns the srv1 boundary rather
// than re-spelled as a literal, so a rename there cannot leave these rows pointing at nothing.
data deployment_gate_environment: NonEmptyStr = srv1_production_environment_name

// THE PERMISSIONS THE OPERATOR MUST GRANT. Not a description of them: the same typed rows the
// model says the review call needs, so the instruction, the activation check and the refusal red all
// read one authority (§3). Verbatim upstream: Actions Read-only, Deployments Read and write. Contents
// is NOT on that list; an App granted Contents:write here holds something the upstream never asked
// for, on the identity that releases srv1 root mutation.
data deployment_gate_app_permissions: List<GitHubAppPermission> = gate_app_permissions

// ---------------------------------------------------------------------------
// The five operator acts
// ---------------------------------------------------------------------------

// 1. Register the App. Its private key is the credential that, once a human has tapped, releases
// srv1 root mutation; its custody is part of the instruction because a key pasted into a workflow
// secret is a different (and rejected) design.
data app_registration_step: HumanIntervention = HumanIntervention {
  identity: "github.deployment-rule.app.register" as HumanInterventionIdentity,
  frequency: FleetOnce,
  subject: "gunb-ai/gunbc custom deployment protection rule App registration",
  instruction: "In the GitHub Apps UI, create one new GitHub App owned by gunb-ai for the sole purpose of answering a custom deployment protection rule. Set repository permissions to exactly Actions: Read-only and Deployments: Read and write and nothing else, and subscribe to the deployment_protection_rule event. Generate and hand its private key to the broker's host-custody path (the same path as the broker's other secrets), never to a workflow secret. Record the App's numeric app id.",
  completion_evidence: NoDischargeSiteModeled
}

// 2. Install it on the one repository. The installation id is what the review call's token is
// minted against, so an install on the wrong repository would make every review a 404 — a silent
// failure mode worth naming in the instruction.
data app_installation_step: HumanIntervention = HumanIntervention {
  identity: "github.deployment-rule.app.install" as HumanInterventionIdentity,
  frequency: FleetOnce,
  subject: "App installation on gunb-ai/gunbc",
  instruction: "Install the App on exactly the repository named by deployment_gate_repository, with no repository-access widening. Confirm the installation returns an installation id the broker can mint an installation access token against, and that minting it succeeds for that repository.",
  completion_evidence: NoDischargeSiteModeled
}

// 3. Configure the webhook URL and enable the webhook. This design does NOT depend on GitHub
// reaching the broker — discovery is the run's own request plus the broker's outbound poll — so
// this row exists because GitHub requires a webhook URL for the rule to be publishable at all, and
// the instruction says so rather than implying the broker listens.
data webhook_configuration_step: HumanIntervention = HumanIntervention {
  identity: "github.deployment-rule.webhook.configure" as HumanInterventionIdentity,
  frequency: FleetOnce,
  subject: "App webhook configuration",
  instruction: "Set the App's webhook URL to a DISABLED endpoint (no receiver) and leave the signing secret recorded but unused. The selected route reads NOTHING from a delivery: discovery is an earlier ungated job in the run filing the approval request, and the broker answers GitHub outbound with an installation token. WHAT THAT IMPLIES is stated in the model as an open standing rather than assumed — gunbc.extdeps.github.deployment_protection_rule.rule_delivery_independence carries the inference that GitHub accepts the App's review without having delivered the webhook, with the read obligation that settles it. If that trial comes back refused, THIS ROW CHANGES: it becomes a real (tailnet-relayed) receiver and the fallback route is selected. The broker is reachable only on the tailnet (ntfy on srv1 behind tailscale serve), so a fallback receiver must be tailnet-relayed and NOT a public listener; do NOT open any inbound path to the tailnet-only approval broker to satisfy this row; a public GitHub exposure of the broker is a rejected alternative.",
  completion_evidence: NoDischargeSiteModeled
}

// 4. Enable the rule on srv1-production. Witnessed by a read back from GitHub, and the branch
// policy must still read as one main-only rule afterwards: enabling a rule must not have taken the
// branch boundary with it.
data rule_enablement_step: HumanIntervention = HumanIntervention {
  identity: "github.deployment-rule.enable.srv1-production" as HumanInterventionIdentity,
  frequency: FleetOnce,
  subject: "custom deployment protection rule enabled on srv1-production",
  instruction: "On the environment named by deployment_gate_environment, enable the App's custom deployment protection rule. Then read the environment back: GET /repos/gunb-ai/gunbc/environments/srv1-production must still report deployment_branch_policy \{protected_branches:false, custom_branch_policies:true\} with exactly one branch rule named main, and the required_reviewers rule must still be present at this stage. Do not remove any reviewer in this step.",
  completion_evidence: NoDischargeSiteModeled
}

// 5. Remove the human required-reviewer — the only row here that WEAKENS a gate.
//
// THE ADMISSION IS A PARAMETER, NOT A SENTENCE. An earlier revision of this row said in its
// `instruction` that the act requires an admitted ReviewerRemovalAdmission, and left it there: the
// row was a constant, the check was prose, and prose is what a reviewer correctly called an
// unenforced guard twice before. The act is now a FUNCTION of the admission
// (reviewer_removal_act_for), and the only arm that yields a renderable intervention is the admitted
// one. What is left in `instruction` is what an operator reads while doing it — not the check.
data reviewer_removal_step: HumanIntervention = HumanIntervention {
  identity: "github.deployment-rule.reviewer-removal.srv1-production" as HumanInterventionIdentity,
  frequency: FleetOnce,
  subject: "required reviewer removed from srv1-production",
  instruction: "Re-read the environment and its deployment-branch-policies after the removal and confirm the main-only branch rule is the protection that remains: GET /repos/gunb-ai/gunbc/environments/srv1-production must still report deployment_branch_policy \{protected_branches:false, custom_branch_policies:true\} with exactly one branch rule named main. If that readback comes back without the branch rule, the boundary has been weakened twice — restore it before anything else runs.",
  completion_evidence: DischargedAt {
    evidence: DeclarationRef {
      module_path: "gunbc.auth.deployment_gate_authorization",
      decl_name: "admit_reviewer_removal",
      field: WholeDeclaration,
    },
  }
}

// THE ACT, AS A FUNCTION OF WHAT WAS WITNESSED. RemovalAdmitted carries the sealed receipt pair — two
// ACCEPTED CALL receipts, one approve one reject, different runs, both on the environment named by the
// admission — so the evidence that unlocks the act is the evidence that the rule actually answered,
// minted only by the call route. RemovalRefused yields a Blocked value: no intervention, no renderable
// row, and the reason says which arm is missing. The stage-1 frontier therefore yields Blocked, and
// there is no path from a Bool or a string to the Ready arm.
type ReviewerRemovalStepDecision
  = ReviewerRemovalReady {
    intervention: HumanIntervention,
    evidence: DeploymentGateTrialEvidence,
  }
  | ReviewerRemovalBlocked { missing: RemovalRefusalReason }

fn reviewer_removal_act_for(admission: ReviewerRemovalAdmission) -> ReviewerRemovalStepDecision {
  match admission {
    RemovalAdmitted { evidence: evidence } =>
      ReviewerRemovalReady {
        intervention: reviewer_removal_step,
        evidence: evidence,
      }
    RemovalRefused { missing: missing } => ReviewerRemovalBlocked { missing: missing }
  }
}

// Whether the act has a renderable row at all. Kept as the single place that asks, so a caller cannot
// pattern-match only the Ready arm and forget the other.
fn reviewer_removal_is_renderable(decision: ReviewerRemovalStepDecision) -> Bool {
  match decision {
    ReviewerRemovalReady { intervention: _, evidence: _ } => true
    ReviewerRemovalBlocked { missing: _ } => false
  }
}

data deployment_gate_operator_steps: List<HumanIntervention> = [
  app_registration_step,
  app_installation_step,
  webhook_configuration_step,
  rule_enablement_step,
  reviewer_removal_step
]

// ---------------------------------------------------------------------------
// Discriminating fns — the ordering and the count are enforced, not narrated
// ---------------------------------------------------------------------------

fn human_frequency_is_fleet_once(f: HumanInterventionFrequency) -> Bool {
  human_intervention_frequency_eq(a: f, b: FleetOnce)
}

// Every act in this design is once-per-fleet. A row that drifted to BreakGlassOnly would drop out
// of the counted burden while still being performed; a row that drifted to EveryProvision would
// overstate an act that happens once.
fn all_steps_are_fleet_once(steps: List<HumanIntervention>) -> Bool {
  steps |> all(s => human_frequency_is_fleet_once(f: s.frequency))
}

// How many rows carry a given identity. A brand-checked identity is supposed to make two rows
// sharing one impossible, but the brand is a name, not a uniqueness proof — so uniqueness is
// checked, and one completion cannot stand for two acts.
fn count_with_identity(steps: List<HumanIntervention>, identity: String) -> Int {
  steps |> filter(s => (s.identity as String) == identity) |> count
}

// The one ordering that matters for the boundary. The reviewer removal is the only row here that
// WEAKENS a gate, so it must come strictly after the row that turns the App gate on; a fold that
// treated them as one step would open an interval in which srv1 root mutation is gated by nothing.
type RemovalOrderAcc {
  seen_enable: Bool
  removal_before_enable: Bool
}

fn removal_is_strictly_after_enablement(steps: List<HumanIntervention>) -> Bool {
  let walked = fold(
    steps,
    init: RemovalOrderAcc { seen_enable: false, removal_before_enable: false },
    f: fn(st, s) {
      RemovalOrderAcc {
        seen_enable: st.seen_enable || (s.identity as String) == (rule_enablement_step.identity as String),
        removal_before_enable: st.removal_before_enable
          || ((s.identity as String) == (reviewer_removal_step.identity as String) && !st.seen_enable)
      }
    }
  )
  walked.seen_enable && !walked.removal_before_enable
}
