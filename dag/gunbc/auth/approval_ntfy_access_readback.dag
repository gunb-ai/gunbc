// ── THE PRIVATE CHANNEL IS READ BACK, NOT DECLARED ──────────────────────────────────────────
// An enrolment code is a credential delivered over the approval topic, so the topic's ACL IS the
// code's confidentiality: a subscriber who is not the operator receives the code and can enrol
// as the operator. gunbc.auth.approval_ntfy_deployment only DECLARES that ACL (a human step with
// NoDischargeSiteModeled); this module reads the live list back from the server and admits exactly
// one shape -- anything else, including a readback that did not run or did not parse, refuses.
// Refusal is the default: the only arm that admits is AclEstablished, and it is reached only by
// the runtime binding AND every listing check below holding on one reading (DESIGN §5; §3b leasing/grants row -- a grant
// is established by readback of who may perform the effect, never by the declaration).
//
// THE EXACT ACL, stated once:
//   default access (auth-default-access)          deny-all
//   user `*` (anonymous)                          no grants          -- unprivileged subscribe refused
//   approval_ntfy_publisher_user, role user       write-only on the topic, nothing else
//   approval_ntfy_operator_user,  role user       read-only on the topic, nothing else
//   any other user (admin or not)                 absent
// "Absent" rather than "no access to the topic" because an admin reads every topic and a further
// user's wildcard grant may match it; admitting only the three rows makes that question vanish
// instead of re-implementing ntfy's pattern matching here.
type ApprovalNtfyAclDeviation
  = AclListingUnparseable { line: String, cause: String }
  | AclDefaultAccessNotDeny { observed: NtfyPermission }
  | AclAnonymousRoleNotAnonymous { observed: NtfyRole }
  | AclAnonymousHasAccess { access: NtfyUserAccess }
  | AclPrincipalMissing { user: String }
  | AclPrincipalDuplicated { user: String }
  | AclPublisherNotWriteOnly { role: NtfyRole, access: NtfyUserAccess }
  | AclOperatorNotReadOnly { role: NtfyRole, access: NtfyUserAccess }
  | AclUnexpectedPrincipal { user: String, role: NtfyRole }
  | ActiveNtfyRuntimeUnbound { gap: ActiveNtfyRuntimeGap }

// ── THE LISTING IS ONLY THE SERVER'S IF IT IS BOUND TO THE RUNNING SERVER ─────────────────
// `ntfy access --config C` reads the auth database C names. It does not ask the running server,
// which may run another binary or another config, may override auth-file or auth-default-access on
// its command line or in its environment (extdeps.ntfy.serve), or may answer from its ACL cache.
// So the listing is admitted only beside a set of MODELED READS of the active runtime, each one an
// extdeps argv run under a timeout, and none of them a shell program:
//
//   unit        systemctl show: ActiveState, MainPID, Environment, EnvironmentFiles, PassEnvironment
//   pid stat    /proc/<MainPID>/stat starttime            -- read FIRST, and again LAST
//   boot, tick  /proc/stat btime, getconf CLK_TCK        -- the process's start, in epoch seconds
//   argv        /proc/<MainPID>/cmdline                  -- exactly `<binary> serve --config <cfg>`
//   binary      stat %Z of the declared binary, and its --version
//   manager env systemctl show-environment
//   uid         id -u of the server's principal
//   sockets     /proc/net/tcp and tcp6
//   config      identity (inode, ctime), then its text, then identity again   (as the server's principal)
//   auth file   identity (inode, ctime, birth), then the listing, then identity again
//   listing     env -i ntfy access --config <cfg>                    (as the server's principal)
//   front door  tailscale serve status --json                        (as root)
//
// WHAT EACH JOIN ESTABLISHES, stated at the grain it was realized (operator ruling on #12077):
//   - MainPID is the UNIT'S: systemd names it, and a unit that is not active or has MainPID 0 --
//     a server started outside systemd -- refuses.
//   - The unit's MainPID and its starttime are read first and last; any difference is a restart
//     between the reads, and refuses. That bracket encloses every other read.
//   - The ENVIRONMENT is the systemd-declared launch environment of that systemd-owned process: the
//     manager's environment, the unit's Environment= and PassEnvironment=. Any NTFY_* name there
//     refuses, and so does any EnvironmentFile=, whose contents this read does not see. It is not
//     /proc/<pid>/environ, which needs ptrace-read access and would put PID wildcards in sudoers.
//   - The EXECUTABLE is the declared binary by argv[0] of /proc/<pid>/cmdline, unchanged since the
//     process started (its status-change time predates the start), at the modeled version.
//   - The CONFIG predates the start by its ctime (which its owner cannot set, unlike mtime), and its
//     inode and ctime are the same before and after its text is read, so the text read is that
//     file's; it names the declared
//     auth-file, deny-all, no access cache and the declared listener, and the command line and
//     environment name none of those options.
//   - The AUTH FILE was born before the process started, and its inode and ctime are the same
//     before and after the listing, so the listing is of one file that was not swapped during it.
//     A birth time the filesystem does not report refuses. The listing itself runs under
//     `env -i`, so no ambient NTFY_CONFIG_FILE, NTFY_AUTH_FILE, NTFY_AUTH_DEFAULT_ACCESS or
//     NTFY_DATABASE_URL can redirect what it reads.
//   - LISTENERS are attributed by the socket's owning UID, not by the process: every TCP socket
//     the server's principal listens on must be 127.0.0.1:2586, and at least one must exist. Wider
//     in scope than a per-process join -- any process running as that principal is held to it.
//   - THE FRONT DOOR is tailscale serve on this node. No listener may be Funnel-enabled; a Funnel
//     listener publishes the node to the public internet. Tailnet reach is bounded by the tailnet
//     ACL, and every route still meets ntfy's own authorizer, which is what the listing binds.
//
// FAIL-CLOSED PER READ: a read that cannot be spawned, exits nonzero (a timeout exits 124) or
// yields output its parser does not place refuses with RuntimeReadFailed naming THAT read. None
// defaults and none is skipped. Until every join holds, the channel is unestablished, whatever the
// listing says.
type NtfyRuntimeRead
  = ReadUnitBefore
  | ReadPidStatBefore
  | ReadBootTime
  | ReadClockTicks
  | ReadCommandLine
  | ReadBinaryCtime
  | ReadVersion
  | ReadManagerEnvironment
  | ReadServerUid
  | ReadTcpSocketTable
  | ReadTcp6SocketTable
  | ReadConfigIdentityBefore
  | ReadConfig
  | ReadConfigIdentityAfter
  | ReadAuthFileIdentityBefore
  | ReadAccessList
  | ReadAuthFileIdentityAfter
  | ReadFrontDoor
  | ReadUnitAfter
  | ReadPidStatAfter

type NtfyRuntimeReadFailure
  = ReadNotSpawned { program: String, cause: String }
  | ReadExitedNonzero { exit_code: Int, stderr: String }
  | ReadUnparseable { detail: String }

type ActiveNtfyRuntimeGap
  = RuntimeReadFailed { read: NtfyRuntimeRead, failure: NtfyRuntimeReadFailure }
  | RuntimeUnitNotActive { active_state: String, main_pid: String }
  | RuntimeRestartedDuringRead { before: String, after: String }
  | RuntimeCommandLineNotDeclared { observed: List<String> }
  | RuntimeBinaryChangedSinceStart { changed: FileTime, start: ProcessStartInstant }
  | RuntimeVersionNotModeled { observed: String }
  | RuntimeEnvironmentFilesPresent { files: String }
  | RuntimeEnvironmentOverrides { names: List<String> }
  | RuntimeConfigChangedSinceStart { changed: FileTime, start: ProcessStartInstant }
  | RuntimeConfigChangedDuringRead { before: String, after: String }
  | RuntimeAuthFileChangedDuringRead { before: String, after: String }
  | RuntimeConfigNotRegularFile { observed: String }
  | RuntimeAuthFileNotRegularFile { observed: String }
  | RuntimeConfigUnreadable { line: String, cause: String }
  | RuntimeConfigOptionNotSingle { key: String, values: List<String> }
  | RuntimeConfigDefaultAccessNotDeny { observed: String }
  | RuntimeConfigAccessCacheEnabled { observed: String }
  | RuntimeConfigListenNotDeclared { observed: String }
  | RuntimeConfigAuthFileNotDeclared { observed: String }
  | RuntimeAuthFileBirthUnknown
  | RuntimeAuthFileReplacedSinceStart { born: FileTime, start: ProcessStartInstant }
  | RuntimeListenerNotDeclared { local_address: String }
  | RuntimeNoListener
  | FrontDoorFunnelled { host_ports: List<String> }
  | ActiveProcessJoinsUnbound { joins: List<ActiveProcessJoin>, trigger: DissolutionCondition }

// ── THE JOINS THIS READING DOES NOT MAKE, AND SO REFUSES ON ────────────────────────────────
// Four facts bind the listing to the PROCESS rather than to its declarations, and each needs
// ptrace-read access to MainPID as the server's principal: its actual environment (a launch
// wrapper such as `/usr/bin/env NTFY_...=x /usr/bin/ntfy serve ...` leaves the final cmdline and
// every systemd declaration clean), /proc/MainPID/exe (another executable given the expected argv
// passes an argv and a stat of /usr/bin/ntfy), and the auth-file's and 127.0.0.1:2586 socket's
// inodes among MainPID's open fds (a pre-existing database renamed over the path after start, or a
// same-uid decoy on 2586, passes every other read here). Reading them per PID would put PID
// wildcards in sudoers, which is refused; the fixed, caller-sealed observation helper that reads
// them without one is its own change. Until it lands the channel is UNESTABLISHED: every reading
// that passes every other check still refuses on this gap, so issuance cannot happen, and nothing
// is weakened in the meantime. The helper's contract landing (gunbc#12124) does not retire this gap;
// the classifier making the joins does.
type ActiveProcessJoin
  = JoinProcessEnvironmentNames
  | JoinProcessExecutable
  | JoinAuthFileHeldByProcess
  | JoinListenerSocketHeldByProcess

data active_process_joins: List<ActiveProcessJoin> = [JoinProcessEnvironmentNames, JoinProcessExecutable, JoinAuthFileHeldByProcess, JoinListenerSocketHeldByProcess]

data active_process_joins_trigger: DissolutionCondition = unbound_dissolution(description: "dissolve-on: the classifier MAKES the four joins, not merely that their helper exists. The helper contract landed with gunbc#12124 (gunbc.auth.approval_ntfy_runtime_observe: approval_ntfy_runtime_observe_helper_argv, ntfy_runtime_observe_encode / ntfy_runtime_observe_decode, the per-release sudoers grant), which is necessary and NOT sufficient: the gap retires only when this module reads that helper's observation through the one sealed root and refuses on each join -- MainPID's environment carries no NTFY_* name; /proc/MainPID/exe is the declared binary by target and inode; the declared auth-file's inode is among MainPID's open fds; the 127.0.0.1:2586 socket's inode is among them -- each with its own RED, in the follow-up to gunbc#12077 that wires them.")

fn active_process_join_label(j: ActiveProcessJoin) -> String {
  match j {
    JoinProcessEnvironmentNames => "MainPID's actual environment has no NTFY_* name"
    JoinProcessExecutable => "/proc/MainPID/exe is the declared binary"
    JoinAuthFileHeldByProcess => "the auth-file's inode is among MainPID's open fds"
    JoinListenerSocketHeldByProcess => "the 127.0.0.1:2586 socket's inode is among MainPID's fds"
  }
}

type ApprovalNtfyAclVerdict
  = AclEstablished
  | AclRefused { deviation: ApprovalNtfyAclDeviation }

// ── THE READS, AS MODELED COMMANDS ─────────────────────────────────────────────────────────
// Every read is an extdeps argv builder. Seven reads are elevated over FIVE distinct argv -- the
// config identity (read before and after), the config text, the auth-file identity (before and
// after), the env -i listing, and the tailscale serve status -- and those five are the ONLY sudoers
// lines this needs, each an exact argv with no PID in it (the PID-bearing reads are world-readable
// procfs).
data approval_ntfy_read_timeout: Second = second(count: 10)
data approval_ntfy_read_kill_after: Second = second(count: 2)

fn approval_ntfy_timed(command: ArgvCommand) -> ArgvCommand {
  timeout_command(duration: approval_ntfy_read_timeout, kill_after: approval_ntfy_read_kill_after, command: command)
}

fn as_ntfy_server(command: ArgvCommand) -> ArgvCommand {
  sudo_elevate_as_command(user: approval_ntfy_principal_name, command: argv_words(command: command))
}

data approval_ntfy_unit_properties: List<SystemdUnitProperty> = [ActiveState, MainPID, EnvironmentProperty, EnvironmentFilesProperty, PassEnvironmentProperty]

fn approval_ntfy_read_command(read: NtfyRuntimeRead, pid: String) -> ArgvCommand {
  approval_ntfy_timed(command: match read {
    ReadUnitBefore => systemctl_show_properties_command(unit: approval_ntfy_unit_name, properties: approval_ntfy_unit_properties)
    ReadUnitAfter => systemctl_show_properties_command(unit: approval_ntfy_unit_name, properties: approval_ntfy_unit_properties)
    ReadPidStatBefore => cat_command(path: procfs_pid_file_path(pid: pid, file: "stat"))
    ReadPidStatAfter => cat_command(path: procfs_pid_file_path(pid: pid, file: "stat"))
    ReadBootTime => cat_command(path: procfs_stat_path)
    ReadClockTicks => getconf_clock_ticks_command()
    ReadCommandLine => cat_command(path: procfs_pid_file_path(pid: pid, file: "cmdline"))
    ReadBinaryCtime => stat_ctime_epoch_command(path: approval_ntfy_binary_path as String)
    ReadVersion => ntfy_version_command(binary: approval_ntfy_binary_path)
    ReadManagerEnvironment => systemctl_show_environment_command()
    ReadServerUid => id_uid_of_command(user: approval_ntfy_principal_name)
    ReadTcpSocketTable => cat_command(path: procfs_path_literal(p: ProcNetTcp) as String)
    ReadTcp6SocketTable => cat_command(path: procfs_path_literal(p: ProcNetTcp6) as String)
    ReadConfigIdentityBefore => as_ntfy_server(command: stat_identity_command(path: approval_ntfy_config_path as String))
    ReadConfig => as_ntfy_server(command: cat_command(path: approval_ntfy_config_path as String))
    ReadConfigIdentityAfter => as_ntfy_server(command: stat_identity_command(path: approval_ntfy_config_path as String))
    ReadAuthFileIdentityBefore => as_ntfy_server(command: stat_identity_command(path: approval_ntfy_auth_file_path as String))
    ReadAccessList => as_ntfy_server(command: env_cleared_command(command: ntfy_access_list_command(binary: approval_ntfy_binary_path, config: approval_ntfy_config_path)))
    ReadAuthFileIdentityAfter => as_ntfy_server(command: stat_identity_command(path: approval_ntfy_auth_file_path as String))
    ReadFrontDoor => sudo_elevate_command(command: argv_words(command: tailscale_serve_status_json_command()))
  })
}

// ── THE READING: what the one root gathers ─────────────────────────────────────────────────
type NtfyRuntimeReads {
  unit_before: ProcessRunOutcome
  pid_stat_before: ProcessRunOutcome
  boot_time: ProcessRunOutcome
  clock_ticks: ProcessRunOutcome
  command_line: ProcessRunOutcome
  binary_ctime: ProcessRunOutcome
  version: ProcessRunOutcome
  manager_environment: ProcessRunOutcome
  server_uid: ProcessRunOutcome
  net_tcp: ProcessRunOutcome
  net_tcp6: ProcessRunOutcome
  config_identity_before: ProcessRunOutcome
  config: ProcessRunOutcome
  config_identity_after: ProcessRunOutcome
  auth_file_identity_before: ProcessRunOutcome
  access_list: ProcessRunOutcome
  auth_file_identity_after: ProcessRunOutcome
  front_door: ProcessRunOutcome
  unit_after: ProcessRunOutcome
  pid_stat_after: ProcessRunOutcome
}

// The unit read yields no MainPID to read the rest at, so only it was taken.
type NtfyRuntimeReading
  = RuntimeUnitUnresolved { unit_before: ProcessRunOutcome }
  | RuntimeReadsTaken { pid: String, reads: NtfyRuntimeReads }

fn approval_ntfy_run(read: NtfyRuntimeRead, pid: String) -> ProcessRunOutcome
  uses net: Network
  admit_callers: [
    decl_ref(module_path: "gunbc.auth.approval_ntfy_access_readback", decl_name: "approval_ntfy_runtime_reading"),
  ]
{
  run_shell_command_observe_outcome(command: approval_ntfy_read_command(read: read, pid: pid), transport: LocalExec)
}

// THE ONLY EFFECTFUL READER, sealed to the one root. It accepts nothing: every read is a function of
// the declarations and of the MainPID its own first read returned. The unit and its process's
// starttime are read first and last, so every other read sits inside the bracket.
fn approval_ntfy_runtime_reading() -> NtfyRuntimeReading
  uses net: Network
  admit_callers: [
    decl_ref(module_path: "gunbc.auth.approval_device_routes", decl_name: "issue_device_enrolment_code"),
  ]
{
  let unit_before = approval_ntfy_run(read: ReadUnitBefore, pid: "")
  match approval_ntfy_unit_main_pid(run: unit_before) {
    Absent => RuntimeUnitUnresolved { unit_before: unit_before }
    Present { value: pid } => {
      let pid_stat_before = approval_ntfy_run(read: ReadPidStatBefore, pid: pid)
      let boot_time = approval_ntfy_run(read: ReadBootTime, pid: pid)
      let clock_ticks = approval_ntfy_run(read: ReadClockTicks, pid: pid)
      let command_line = approval_ntfy_run(read: ReadCommandLine, pid: pid)
      let binary_ctime = approval_ntfy_run(read: ReadBinaryCtime, pid: pid)
      let version = approval_ntfy_run(read: ReadVersion, pid: pid)
      let manager_environment = approval_ntfy_run(read: ReadManagerEnvironment, pid: pid)
      let server_uid = approval_ntfy_run(read: ReadServerUid, pid: pid)
      let net_tcp = approval_ntfy_run(read: ReadTcpSocketTable, pid: pid)
      let net_tcp6 = approval_ntfy_run(read: ReadTcp6SocketTable, pid: pid)
      let config_identity_before = approval_ntfy_run(read: ReadConfigIdentityBefore, pid: pid)
      let config = approval_ntfy_run(read: ReadConfig, pid: pid)
      let config_identity_after = approval_ntfy_run(read: ReadConfigIdentityAfter, pid: pid)
      let auth_file_identity_before = approval_ntfy_run(read: ReadAuthFileIdentityBefore, pid: pid)
      let access_list = approval_ntfy_run(read: ReadAccessList, pid: pid)
      let auth_file_identity_after = approval_ntfy_run(read: ReadAuthFileIdentityAfter, pid: pid)
      let front_door = approval_ntfy_run(read: ReadFrontDoor, pid: pid)
      let unit_after = approval_ntfy_run(read: ReadUnitAfter, pid: pid)
      let pid_stat_after = approval_ntfy_run(read: ReadPidStatAfter, pid: pid)
      RuntimeReadsTaken { pid: pid, reads: NtfyRuntimeReads {
        unit_before: unit_before, pid_stat_before: pid_stat_before, boot_time: boot_time, clock_ticks: clock_ticks,
        command_line: command_line, binary_ctime: binary_ctime, version: version, manager_environment: manager_environment,
        server_uid: server_uid, net_tcp: net_tcp, net_tcp6: net_tcp6,
        config_identity_before: config_identity_before, config: config, config_identity_after: config_identity_after,
        auth_file_identity_before: auth_file_identity_before, access_list: access_list, auth_file_identity_after: auth_file_identity_after,
        front_door: front_door,
        unit_after: unit_after, pid_stat_after: pid_stat_after,
      } }
    }
  }
}

// ── PURE READERS OF ONE READ ───────────────────────────────────────────────────────────────
fn run_failure(run: ProcessRunOutcome) -> NtfyRuntimeReadFailure? {
  match run {
    ProcessNotSpawned { program: p, cause: c } => Present { value: ReadNotSpawned { program: p as String, cause: c as String } }
    ProcessRan { observation: o } =>
      if o.exit_code != 0 { Present { value: ReadExitedNonzero { exit_code: o.exit_code, stderr: trim(s: o.stderr) } } } else { none }
  }
}

fn run_stdout(run: ProcessRunOutcome) -> String {
  match run {
    ProcessRan { observation: o } => o.stdout
    ProcessNotSpawned { program: _, cause: _ } => ""
  }
}

fn unit_property(text: String, key: String) -> String? {
  match first(filter(split(s: text, delimiter: "\n"), l => starts_with(s: l, prefix: key + "="))) {
    Present { value: l } => Present { value: substring(s: l, start: string_length(s: key) + 1, end: string_length(s: l)) }
    Absent => none
  }
}

// The unit's MainPID, when the unit read ran, is active, and names a process.
fn approval_ntfy_unit_main_pid(run: ProcessRunOutcome) -> String? {
  match run_failure(run: run) {
    Present { value: _ } => none
    Absent => match unit_property(text: run_stdout(run: run), key: "MainPID") {
      Present { value: p } =>
        if p == "" || p == "0" || unit_property(text: run_stdout(run: run), key: "ActiveState") != Present { value: "active" } { none }
        else { Present { value: p } }
      Absent => none
    }
  }
}

fn runtime_refused(gap: ActiveNtfyRuntimeGap) -> ApprovalNtfyAclVerdict {
  AclRefused { deviation: ActiveNtfyRuntimeUnbound { gap: gap } }
}

fn read_failed(read: NtfyRuntimeRead, failure: NtfyRuntimeReadFailure) -> ApprovalNtfyAclVerdict {
  runtime_refused(gap: RuntimeReadFailed { read: read, failure: failure })
}

fn unparseable(read: NtfyRuntimeRead, detail: String) -> ApprovalNtfyAclVerdict {
  read_failed(read: read, failure: ReadUnparseable { detail: detail })
}

type ReadRun {
  read: NtfyRuntimeRead
  run: ProcessRunOutcome
}

fn reads_in_order(r: NtfyRuntimeReads) -> List<ReadRun> {
  [
    ReadRun { read: ReadUnitBefore, run: r.unit_before },
    ReadRun { read: ReadPidStatBefore, run: r.pid_stat_before },
    ReadRun { read: ReadBootTime, run: r.boot_time },
    ReadRun { read: ReadClockTicks, run: r.clock_ticks },
    ReadRun { read: ReadCommandLine, run: r.command_line },
    ReadRun { read: ReadBinaryCtime, run: r.binary_ctime },
    ReadRun { read: ReadVersion, run: r.version },
    ReadRun { read: ReadManagerEnvironment, run: r.manager_environment },
    ReadRun { read: ReadServerUid, run: r.server_uid },
    ReadRun { read: ReadTcpSocketTable, run: r.net_tcp },
    ReadRun { read: ReadTcp6SocketTable, run: r.net_tcp6 },
    ReadRun { read: ReadConfigIdentityBefore, run: r.config_identity_before },
    ReadRun { read: ReadConfig, run: r.config },
    ReadRun { read: ReadConfigIdentityAfter, run: r.config_identity_after },
    ReadRun { read: ReadAuthFileIdentityBefore, run: r.auth_file_identity_before },
    ReadRun { read: ReadAccessList, run: r.access_list },
    ReadRun { read: ReadAuthFileIdentityAfter, run: r.auth_file_identity_after },
    ReadRun { read: ReadFrontDoor, run: r.front_door },
    ReadRun { read: ReadUnitAfter, run: r.unit_after },
    ReadRun { read: ReadPidStatAfter, run: r.pid_stat_after },
  ]
}

fn first_failed_read(runs: List<ReadRun>) -> ApprovalNtfyAclVerdict? {
  match first(filter(runs, x => match run_failure(run: x.run) { Present { value: _ } => true  Absent => false })) {
    Present { value: x } => match run_failure(run: x.run) {
      Present { value: f } => Present { value: read_failed(read: x.read, failure: f) }
      Absent => none
    }
    Absent => none
  }
}

// THE TIMES THIS READING COMPARES. Every one is a whole Unix-epoch second (std.types EpochSecs), and
// each carries how it was obtained, so a comparison never meets a bare number of unknown origin.
//
// The process start is DERIVED, never read (proc(5)): /proc/stat `btime` is the boot instant in
// epoch seconds, /proc/<pid>/stat field 22 `starttime` is clock ticks since boot, and
// sysconf(_SC_CLK_TCK) is ticks per second. started = btime + starttime / CLK_TCK, the division
// truncating to a whole second. The tick count stays a tick count beside the instant derived from it.
type ProcessStartInstant {
  boot_time: EpochSecs
  start_ticks: Int
  ticks_per_second: Int
  started: EpochSecs
}

// A file time as stat(1) prints it from statx(2): `%Z` is stx_ctime (status change, which the file's
// owner cannot set) and `%W` is stx_btime (birth), each truncated to a whole epoch second. stat
// prints 0 for a birth time the filesystem does not report; that is read as ABSENT, never as 1970.
type FileTimeKind
  = StatusChangeTime
  | BirthTime

type FileTime {
  kind: FileTimeKind
  at: EpochSecs
}

fn epoch_secs_of(n: Int) -> EpochSecs? {
  if n < 0 { none } else { Present { value: n } }
}

fn process_start_instant(boot_time: EpochSecs, start_ticks: Int, ticks_per_second: Int) -> ProcessStartInstant {
  ProcessStartInstant {
    boot_time: boot_time,
    start_ticks: start_ticks,
    ticks_per_second: ticks_per_second,
    started: (boot_time as Int) + (start_ticks / ticks_per_second),
  }
}

// DOES THE FILE TIME PREDATE THE START? Both sides are whole seconds and the start is truncated, so a
// file time in the same second as the start cannot be ordered before it and does NOT predate it: the
// equal second refuses. That is the conservative reading of the granularity, not an approximation.
fn file_time_predates_start(t: FileTime, start: ProcessStartInstant) -> Bool {
  (t.at as Int) < (start.started as Int)
}

fn file_time_kind_label(k: FileTimeKind) -> String {
  match k {
    StatusChangeTime => "ctime"
    BirthTime => "birth"
  }
}

fn file_time_label(t: FileTime) -> String {
  file_time_kind_label(k: t.kind) + " " + to_string(t.at as Int)
}

fn process_start_label(s: ProcessStartInstant) -> String {
  to_string(s.started as Int) + " (btime " + to_string(s.boot_time as Int) + " + " + to_string(s.start_ticks) + " ticks / " + to_string(s.ticks_per_second) + ")"
}

fn pid_start_ticks(read: NtfyRuntimeRead, text: String) -> Int? {
  match proc_pid_stat_start_time(content: text) {
    StartTimeObserved { ticks_since_boot: t } => Present { value: t }
    _ => none
  }
}

// ── THE CLASSIFIER: the fixture seam, and nothing but a verdict ────────────────────────────
// Pure over one reading. It returns AclEstablished or AclRefused and carries no value an effectful
// function could accept in place of the reads: the only caller that turns AclEstablished into an
// effect is gunbc.auth.approval_device_routes issue_device_enrolment_code, which took the reading
// itself immediately before it asks.
fn approval_ntfy_channel_verdict(reading: NtfyRuntimeReading) -> ApprovalNtfyAclVerdict {
  match approval_ntfy_modeled_joins_verdict(reading: reading) {
    AclRefused { deviation: d } => AclRefused { deviation: d }
    AclEstablished => runtime_refused(gap: ActiveProcessJoinsUnbound { joins: active_process_joins, trigger: active_process_joins_trigger })
  }
}

// EVERY JOIN THIS READING MAKES, and nothing else: AclEstablished here means every modeled read
// held -- NOT that the channel is established, which approval_ntfy_channel_verdict alone answers,
// and which also requires the joins in ActiveProcessJoinsUnbound.
fn approval_ntfy_modeled_joins_verdict(reading: NtfyRuntimeReading) -> ApprovalNtfyAclVerdict {
  match reading {
    RuntimeUnitUnresolved { unit_before: u } => match run_failure(run: u) {
      Present { value: f } => read_failed(read: ReadUnitBefore, failure: f)
      Absent => match unit_property(text: run_stdout(run: u), key: "MainPID") {
        Absent => unparseable(read: ReadUnitBefore, detail: "no MainPID= line")
        Present { value: p } => runtime_refused(gap: RuntimeUnitNotActive {
          active_state: match unit_property(text: run_stdout(run: u), key: "ActiveState") { Present { value: s } => s  Absent => "" },
          main_pid: p,
        })
      }
    }
    RuntimeReadsTaken { pid: pid, reads: r } => match first_failed_read(runs: reads_in_order(r: r)) {
      Present { value: v } => v
      Absent => approval_ntfy_bracketed(pid: pid, r: r)
    }
  }
}

// Every read ran. The bracket first: the same active unit, the same MainPID, the same starttime.
fn approval_ntfy_bracketed(pid: String, r: NtfyRuntimeReads) -> ApprovalNtfyAclVerdict {
  match approval_ntfy_unit_main_pid(run: r.unit_after) {
    Absent => runtime_refused(gap: RuntimeRestartedDuringRead { before: pid, after: match unit_property(text: run_stdout(run: r.unit_after), key: "MainPID") { Present { value: p } => p  Absent => "" } })
    Present { value: after_pid } =>
      if after_pid != pid { runtime_refused(gap: RuntimeRestartedDuringRead { before: pid, after: after_pid }) }
      else { match pid_start_ticks(read: ReadPidStatBefore, text: run_stdout(run: r.pid_stat_before)) {
        Absent => unparseable(read: ReadPidStatBefore, detail: "no starttime field")
        Present { value: t0 } => match pid_start_ticks(read: ReadPidStatAfter, text: run_stdout(run: r.pid_stat_after)) {
          Absent => unparseable(read: ReadPidStatAfter, detail: "no starttime field")
          Present { value: t1 } =>
            if t0 != t1 { runtime_refused(gap: RuntimeRestartedDuringRead { before: pid + "@" + to_string(t0), after: pid + "@" + to_string(t1) }) }
            else { approval_ntfy_started(t0: t0, r: r) }
        }
      } }
  }
}

fn approval_ntfy_started(t0: Int, r: NtfyRuntimeReads) -> ApprovalNtfyAclVerdict {
  match proc_stat_boot_time(content: run_stdout(run: r.boot_time)) {
    BootTimeObserved { epoch_seconds: btime } => match clock_ticks_reading(stdout: run_stdout(run: r.clock_ticks)) {
      ClockTicksObserved { per_second: hz } => approval_ntfy_process(start: process_start_instant(boot_time: btime, start_ticks: t0, ticks_per_second: hz), r: r)
      _ => unparseable(read: ReadClockTicks, detail: "CLK_TCK is not a positive integer")
    }
    _ => unparseable(read: ReadBootTime, detail: "no btime line")
  }
}

fn approval_ntfy_declared_cmdline() -> List<String> {
  [approval_ntfy_binary_path as String, ntfy_serve_verb as String, ntfy_config_flag as String, approval_ntfy_config_path as String]
}

fn string_lists_equal(a: List<String>, b: List<String>) -> Bool {
  count(a) == count(b) && join(a, "\n") == join(b, "\n")
}

// /proc/<pid>/cmdline: the argv words, each NUL-terminated.
fn cmdline_words(text: String) -> List<String> {
  let parts = split(s: text, delimiter: "\x00")
  match last(parts) {
    Present { value: "" } => parts.take(n: count(parts) - 1)
    _ => parts
  }
}

// The process: its argv, its executable, its version.
fn approval_ntfy_process(start: ProcessStartInstant, r: NtfyRuntimeReads) -> ApprovalNtfyAclVerdict {
  let argv = cmdline_words(text: run_stdout(run: r.command_line))
  let version = trim(s: run_stdout(run: r.version))
  let modeled = ntfy_version_line_prefix + substring(s: ntfy_access_upstream_version, start: 1, end: string_length(s: ntfy_access_upstream_version))
  if !string_lists_equal(a: argv, b: approval_ntfy_declared_cmdline()) { runtime_refused(gap: RuntimeCommandLineNotDeclared { observed: argv }) }
  else { match binary_ctime_of(text: run_stdout(run: r.binary_ctime)) {
    Absent => unparseable(read: ReadBinaryCtime, detail: "not a non-negative integer")
    Present { value: ctime } =>
      if !file_time_predates_start(t: ctime, start: start) { runtime_refused(gap: RuntimeBinaryChangedSinceStart { changed: ctime, start: start }) }
      else { if version != modeled { runtime_refused(gap: RuntimeVersionNotModeled { observed: version }) }
      else { approval_ntfy_environment(start: start, r: r) } }
  } }
}

// Names of `A=b c` assignments as systemd renders Environment=: space-separated, a quoted
// assignment carrying its quote.
fn assignment_names(text: String) -> List<String> {
  map(filter(split(s: trim(s: text), delimiter: " "), w => w != ""), w => match first(split(s: replace(s: w, from: "\"", to: ""), delimiter: "=")) { Present { value: n } => n  Absent => w })
}

fn ntfy_names(names: List<String>) -> List<String> {
  filter(names, n => starts_with(s: n, prefix: ntfy_environment_prefix))
}

fn approval_ntfy_environment(start: ProcessStartInstant, r: NtfyRuntimeReads) -> ApprovalNtfyAclVerdict {
  let unit = run_stdout(run: r.unit_before)
  let files = match unit_property(text: unit, key: "EnvironmentFiles") { Present { value: f } => trim(s: f)  Absent => "" }
  let unit_names = concat(
    assignment_names(text: match unit_property(text: unit, key: "Environment") { Present { value: e } => e  Absent => "" }),
    assignment_names(text: match unit_property(text: unit, key: "PassEnvironment") { Present { value: e } => e  Absent => "" }))
  let manager_names = assignment_names(text: join(split(s: run_stdout(run: r.manager_environment), delimiter: "\n"), " "))
  let overrides = ntfy_names(names: concat(unit_names, manager_names))
  if files != "" { runtime_refused(gap: RuntimeEnvironmentFilesPresent { files: files }) }
  else { if count(overrides) != 0 { runtime_refused(gap: RuntimeEnvironmentOverrides { names: overrides }) }
  else { match file_identity(text: run_stdout(run: r.config_identity_before)) {
    Absent => unparseable(read: ReadConfigIdentityBefore, detail: "not `inode ctime birth type`")
    Present { value: before } => match file_identity(text: run_stdout(run: r.config_identity_after)) {
      Absent => unparseable(read: ReadConfigIdentityAfter, detail: "not `inode ctime birth type`")
      Present { value: after } =>
        if !file_identity_same(a: before, b: after) { runtime_refused(gap: RuntimeConfigChangedDuringRead { before: file_identity_label(i: before), after: file_identity_label(i: after) }) }
        else { if before.file_type != stat_regular_file_type { runtime_refused(gap: RuntimeConfigNotRegularFile { observed: before.file_type }) }
        else { if !file_time_predates_start(t: before.ctime, start: start) { runtime_refused(gap: RuntimeConfigChangedSinceStart { changed: before.ctime, start: start }) }
        else { approval_ntfy_config_binding(start: start, r: r) } } }
    }
  } } }
}

fn single_config_value(entries: List<NtfyConfigEntry>, o: NtfyServeOption) -> String? {
  let vs = ntfy_config_values(entries: entries, o: o)
  if count(vs) == 1 { first(vs) } else { none }
}

fn approval_ntfy_config_binding(start: ProcessStartInstant, r: NtfyRuntimeReads) -> ApprovalNtfyAclVerdict {
  match ntfy_config_read(text: run_stdout(run: r.config)) {
    NtfyConfigUnreadable { line: l, cause: c } => runtime_refused(gap: RuntimeConfigUnreadable { line: l, cause: c })
    NtfyConfigFlat { entries: es } =>
      match single_config_value(entries: es, o: NtfyAuthFile) {
        Absent => runtime_refused(gap: RuntimeConfigOptionNotSingle { key: "auth-file", values: ntfy_config_values(entries: es, o: NtfyAuthFile) })
        Present { value: auth_file } =>
          if auth_file != (approval_ntfy_auth_file_path as String) { runtime_refused(gap: RuntimeConfigAuthFileNotDeclared { observed: auth_file }) }
          else { match single_config_value(entries: es, o: NtfyAuthDefaultAccess) {
            Absent => runtime_refused(gap: RuntimeConfigOptionNotSingle { key: "auth-default-access", values: ntfy_config_values(entries: es, o: NtfyAuthDefaultAccess) })
            Present { value: default_access } =>
              if default_access != "deny-all" { runtime_refused(gap: RuntimeConfigDefaultAccessNotDeny { observed: default_access }) }
              else { match first(filter(ntfy_config_values(entries: es, o: NtfyAuthAccessCache), v => v != "false")) {
                Present { value: v } => runtime_refused(gap: RuntimeConfigAccessCacheEnabled { observed: v })
                Absent => match single_config_value(entries: es, o: NtfyListenHttp) {
                  Absent => runtime_refused(gap: RuntimeConfigOptionNotSingle { key: "listen-http", values: ntfy_config_values(entries: es, o: NtfyListenHttp) })
                  Present { value: listen } =>
                    if listen != approval_ntfy_endpoint() { runtime_refused(gap: RuntimeConfigListenNotDeclared { observed: listen }) }
                    else { approval_ntfy_auth_file(start: start, r: r) }
                }
              } }
          } }
      }
  }
}

// A path's identity as stat printed it: inode, ctime, birth (Absent where stat printed 0 because the
// filesystem does not say), and its type ("regular file", "symbolic link", ...).
type FileIdentity {
  inode: String
  ctime: FileTime
  birth: FileTime?
  file_type: String
}

fn file_time_of(kind: FileTimeKind, n: Int) -> FileTime? {
  match epoch_secs_of(n: n) {
    Absent => none
    Present { value: at } => Present { value: FileTime { kind: kind, at: at } }
  }
}

// The binary's `stat %Z`: one status-change time.
fn binary_ctime_of(text: String) -> FileTime? {
  match parse_int(s: trim(s: text)) {
    Absent => none
    Present { value: n } => file_time_of(kind: StatusChangeTime, n: n)
  }
}

fn birth_time_of(n: Int) -> FileTime? {
  if n == 0 { none } else { file_time_of(kind: BirthTime, n: n) }
}

fn file_identity(text: String) -> FileIdentity? {
  let words = filter(split(s: trim(s: text), delimiter: " "), w => w != "")
  if count(words) < 4 { none } else {
    match first(words) {
      Absent => none
      Present { value: inode } => match first(skip(words, n: 1)) {
        Absent => none
        Present { value: c } => match first(skip(words, n: 2)) {
          Absent => none
          Present { value: b } => match parse_int(s: c) {
            Absent => none
            Present { value: ctime_n } => match parse_int(s: b) {
              Absent => none
              Present { value: birth_n } => match file_time_of(kind: StatusChangeTime, n: ctime_n) {
                Absent => none
                Present { value: ctime } =>
                  if parse_int(s: inode) == none || birth_n < 0 { none }
                  else { Present { value: FileIdentity { inode: inode, ctime: ctime, birth: birth_time_of(n: birth_n), file_type: join(skip(words, n: 3), " ") } } }
              }
            }
          }
        }
      }
    }
  }
}

fn file_identity_same(a: FileIdentity, b: FileIdentity) -> Bool {
  a.inode == b.inode && (a.ctime.at as Int) == (b.ctime.at as Int) && birth_label(t: a.birth) == birth_label(t: b.birth) && a.file_type == b.file_type
}

fn birth_label(t: FileTime?) -> String {
  match t { Absent => "birth unknown"  Present { value: v } => file_time_label(t: v) }
}

fn file_identity_label(i: FileIdentity) -> String {
  "inode " + i.inode + " " + file_time_label(t: i.ctime)
}

fn approval_ntfy_auth_file(start: ProcessStartInstant, r: NtfyRuntimeReads) -> ApprovalNtfyAclVerdict {
  match file_identity(text: run_stdout(run: r.auth_file_identity_before)) {
    Absent => unparseable(read: ReadAuthFileIdentityBefore, detail: "not `inode ctime birth type`")
    Present { value: before } => match file_identity(text: run_stdout(run: r.auth_file_identity_after)) {
      Absent => unparseable(read: ReadAuthFileIdentityAfter, detail: "not `inode ctime birth type`")
      Present { value: after } =>
        if !file_identity_same(a: before, b: after) { runtime_refused(gap: RuntimeAuthFileChangedDuringRead { before: file_identity_label(i: before), after: file_identity_label(i: after) }) }
        else { if before.file_type != stat_regular_file_type { runtime_refused(gap: RuntimeAuthFileNotRegularFile { observed: before.file_type }) }
        else { match before.birth {
          Absent => runtime_refused(gap: RuntimeAuthFileBirthUnknown)
          Present { value: born } =>
            if !file_time_predates_start(t: born, start: start) { runtime_refused(gap: RuntimeAuthFileReplacedSinceStart { born: born, start: start }) }
            else { approval_ntfy_listeners(r: r) }
        } } }
    }
  }
}

fn listener_is_declared(row: TcpSocketRow) -> Bool {
  (match row.local_port { TcpPortBound { port: p } => p == approval_ntfy_listen_port  TcpPortUnbound => false })
    && (match tcp_local_ipv4_dotted_little_endian(local_address: row.local_address) { Present { value: a } => a == (approval_ntfy_listen_address as String)  Absent => false })
}

// Every TCP socket the server's principal LISTENS on, in either table, must be the declared v4
// endpoint (a v6 listener, e.g. a `::` wildcard, serves v4 too), and at least one must exist.
fn approval_ntfy_listeners(r: NtfyRuntimeReads) -> ApprovalNtfyAclVerdict {
  let uid = trim(s: run_stdout(run: r.server_uid))
  if parse_int(s: uid) == none { unparseable(read: ReadServerUid, detail: "not an integer") }
  else { match proc_net_tcp_table(text: run_stdout(run: r.net_tcp)) {
    ProcNetTcpUnparseable { line: l } => unparseable(read: ReadTcpSocketTable, detail: l)
    ProcNetTcpParsed { rows: rows4 } => match proc_net_tcp_table(text: run_stdout(run: r.net_tcp6)) {
      ProcNetTcpUnparseable { line: l } => unparseable(read: ReadTcp6SocketTable, detail: l)
      ProcNetTcpParsed { rows: rows6 } => {
        let mine4 = filter(rows4, x => x.state == tcp_listen_state_hex && x.uid == uid)
        let mine6 = filter(rows6, x => x.state == tcp_listen_state_hex && x.uid == uid)
        match first(concat(mine6, filter(mine4, x => !listener_is_declared(row: x)))) {
          Present { value: bad } => runtime_refused(gap: RuntimeListenerNotDeclared { local_address: bad.local_address })
          Absent => if count(mine4) == 0 { runtime_refused(gap: RuntimeNoListener) } else { approval_ntfy_front_door(r: r) }
        }
      }
    }
  } }
}

fn approval_ntfy_front_door(r: NtfyRuntimeReads) -> ApprovalNtfyAclVerdict {
  match tailscale_serve_status_funnel_listeners(status_json: run_stdout(run: r.front_door)) {
    FunnelStatusUnreadable => unparseable(read: ReadFrontDoor, detail: "serve status did not read as the documented JSON")
    FunnelListeners { host_ports: hs } =>
      if count(hs) != 0 { runtime_refused(gap: FrontDoorFunnelled { host_ports: hs }) }
      else { match ntfy_access_read(stdout: run_stdout(run: r.access_list)) {
        NtfyAccessUnparseable { line: l, cause: c } => AclRefused { deviation: AclListingUnparseable { line: l, cause: c } }
        NtfyAccessListed { listing: listing } => approval_ntfy_acl_of_listing(listing: listing)
      } }
  }
}

fn approval_ntfy_read_label(read: NtfyRuntimeRead) -> String {
  match read {
    ReadUnitBefore => "the unit (first)"
    ReadPidStatBefore => "the process start (first)"
    ReadBootTime => "the boot time"
    ReadClockTicks => "the clock tick rate"
    ReadCommandLine => "the process command line"
    ReadBinaryCtime => "the binary's change time"
    ReadVersion => "the binary's version"
    ReadManagerEnvironment => "the service manager's environment"
    ReadServerUid => "the server principal's uid"
    ReadTcpSocketTable => "/proc/net/tcp"
    ReadTcp6SocketTable => "/proc/net/tcp6"
    ReadConfigIdentityBefore => "the config's identity (first)"
    ReadConfig => "the config"
    ReadConfigIdentityAfter => "the config's identity (last)"
    ReadAuthFileIdentityBefore => "the auth file's identity (first)"
    ReadAccessList => "the ntfy access listing"
    ReadAuthFileIdentityAfter => "the auth file's identity (last)"
    ReadFrontDoor => "the tailscale serve status"
    ReadUnitAfter => "the unit (last)"
    ReadPidStatAfter => "the process start (last)"
  }
}

fn approval_ntfy_read_failure_sentence(f: NtfyRuntimeReadFailure) -> String {
  match f {
    ReadNotSpawned { program: p, cause: c } => "'" + p + "' could not be spawned: " + c
    ReadExitedNonzero { exit_code: e, stderr: x } => "exit " + to_string(e) + (if e == 124 { " (timed out)" } else { "" }) + ": " + x
    ReadUnparseable { detail: d } => "its output did not read: " + d
  }
}

fn approval_ntfy_runtime_gap_sentence(g: ActiveNtfyRuntimeGap) -> String {
  match g {
    RuntimeReadFailed { read: r, failure: f } => "the read of " + approval_ntfy_read_label(read: r) + " failed, " + approval_ntfy_read_failure_sentence(f: f)
    RuntimeUnitNotActive { active_state: s, main_pid: p } => "unit " + (approval_ntfy_unit_name as String) + " is '" + s + "' with MainPID '" + p + "', so no systemd-owned server is running"
    RuntimeRestartedDuringRead { before: b, after: a } => "the server changed between the first and last reads (" + b + " -> " + a + ")"
    RuntimeCommandLineNotDeclared { observed: a } => "the server's argv is [" + join(a, " ") + "], not [" + join(approval_ntfy_declared_cmdline(), " ") + "]"
    RuntimeBinaryChangedSinceStart { changed: c, start: s } => "the binary changed at " + file_time_label(t: c) + ", not before the server started at " + process_start_label(s: s)
    RuntimeVersionNotModeled { observed: v } => "the binary reports '" + v + "', not the modeled ntfy " + ntfy_access_upstream_version
    RuntimeEnvironmentFilesPresent { files: f } => "the unit reads EnvironmentFile " + f + ", whose contents this read does not see"
    RuntimeEnvironmentOverrides { names: n } => "the server's launch environment sets " + join(n, ", ") + ", which override its config"
    RuntimeConfigChangedSinceStart { changed: m, start: a } => "the server config changed at " + file_time_label(t: m) + ", not before the server started at " + process_start_label(s: a)
    RuntimeConfigChangedDuringRead { before: b, after: a } => "the server config changed while it was read (" + b + " -> " + a + ")"
    RuntimeConfigNotRegularFile { observed: t } => "the declared config path is a " + t + ", not a regular file, so its identity is not the identity of what is read through it"
    RuntimeAuthFileNotRegularFile { observed: t } => "the declared auth-file path is a " + t + ", not a regular file, so its identity is not the identity of what is listed through it"
    RuntimeAuthFileChangedDuringRead { before: b, after: a } => "the auth file changed while it was listed (" + b + " -> " + a + ")"
    RuntimeConfigUnreadable { line: l, cause: c } => "the server config did not read flat at '" + l + "': " + c
    RuntimeConfigOptionNotSingle { key: k, values: v } => "the server config gives " + k + " " + to_string(count(v)) + " values, not one"
    RuntimeConfigDefaultAccessNotDeny { observed: v } => "the server config sets auth-default-access '" + v + "', not deny-all"
    RuntimeConfigAccessCacheEnabled { observed: v } => "the server config sets auth-access-cache '" + v + "'"
    RuntimeConfigListenNotDeclared { observed: v } => "the server config listens on '" + v + "', not " + approval_ntfy_endpoint()
    RuntimeConfigAuthFileNotDeclared { observed: v } => "the server config names auth-file '" + v + "', not " + (approval_ntfy_auth_file_path as String)
    RuntimeAuthFileBirthUnknown => "the filesystem does not report the auth file's birth time"
    RuntimeAuthFileReplacedSinceStart { born: b, start: s } => "the auth file was created at " + file_time_label(t: b) + ", not before the server started at " + process_start_label(s: s)
    RuntimeListenerNotDeclared { local_address: a } => "the server's principal listens on " + a + ", not only " + approval_ntfy_endpoint()
    RuntimeNoListener => "the server's principal holds no listening socket on " + approval_ntfy_endpoint()
    FrontDoorFunnelled { host_ports: h } => "tailscale Funnel publishes " + join(h, ", ") + " to the public internet"
    ActiveProcessJoinsUnbound { joins: js, trigger: _ } => "the listing is not yet bound to the running process itself (" + join(map(js, j => active_process_join_label(j: j)), "; ") + "); issuance refuses until the per-release runtime-observation helper lands"
  }
}

fn permission_is(p: NtfyPermission, want: NtfyPermission) -> Bool {
  match p {
    NtfyReadWrite => match want { NtfyReadWrite => true  _ => false }
    NtfyReadOnly => match want { NtfyReadOnly => true  _ => false }
    NtfyWriteOnly => match want { NtfyWriteOnly => true  _ => false }
    NtfyDenyAll => match want { NtfyDenyAll => true  _ => false }
  }
}

fn role_is_user(r: NtfyRole) -> Bool {
  match r { NtfyRoleUser => true  _ => false }
}

// A named principal holds EXACTLY one grant, on the topic's literal name, with the wanted permission.
fn holds_exactly(u: NtfyAccessUser, want: NtfyPermission) -> Bool {
  role_is_user(r: u.role) && (match u.access {
    AdminAllTopics => false
    TopicGrants { grants: gs } =>
      count(gs) == 1 && all(gs, g => g.topic_pattern == (approval_ntfy_topic as String) && permission_is(p: g.permission, want: want))
  })
}

// THE `*` ROW IS THE ANONYMOUS PRINCIPAL ONLY AT THE anonymous ROLE (user/types.go Everyone,
// RoleAnonymous). A `*` row at another role is not the principal ntfy's authorizer applies to an
// unauthenticated subscriber, so its no-access shape says nothing about that subscriber.
fn role_is_anonymous(r: NtfyRole) -> Bool {
  match r { NtfyRoleAnonymous => true  _ => false }
}

fn has_no_access(a: NtfyUserAccess) -> Bool {
  match a {
    AdminAllTopics => false
    TopicGrants { grants: gs } => count(gs) == 0
  }
}

fn is_declared_principal(name: String) -> Bool {
  name == ntfy_everyone_user || name == (approval_ntfy_publisher_user as String) || name == (approval_ntfy_operator_user as String)
}

fn users_named(listing: NtfyAccessListing, name: String) -> List<NtfyAccessUser> {
  filter(listing.users, u => u.name == name)
}

fn one_user(listing: NtfyAccessListing, name: String) -> ApprovalNtfyAclDeviation? {
  let n = count(users_named(listing: listing, name: name))
  if n == 0 { Present { value: AclPrincipalMissing { user: name } } }
  else { if n > 1 { Present { value: AclPrincipalDuplicated { user: name } } } else { none } }
}

// THE ADMISSION FOLD over an observed listing. Checks run in a fixed order and the first deviation
// is the cause, so the refusal is located rather than a count.
fn approval_ntfy_acl_of_listing(listing: NtfyAccessListing) -> ApprovalNtfyAclVerdict {
  let everyone = ntfy_everyone_user
  let publisher = approval_ntfy_publisher_user as String
  let operator = approval_ntfy_operator_user as String
  if !permission_is(p: listing.default_access, want: NtfyDenyAll) { AclRefused { deviation: AclDefaultAccessNotDeny { observed: listing.default_access } } }
  else { match first(filter(listing.users, u => !is_declared_principal(name: u.name))) {
    Present { value: extra } => AclRefused { deviation: AclUnexpectedPrincipal { user: extra.name, role: extra.role } }
    Absent => match one_user(listing: listing, name: everyone) {
      Present { value: d } => AclRefused { deviation: d }
      Absent => match one_user(listing: listing, name: publisher) {
        Present { value: d } => AclRefused { deviation: d }
        Absent => match one_user(listing: listing, name: operator) {
          Present { value: d } => AclRefused { deviation: d }
          Absent => approval_ntfy_acl_of_principals(
            anonymous: users_named(listing: listing, name: everyone),
            publisher: users_named(listing: listing, name: publisher),
            operator: users_named(listing: listing, name: operator),
          )
        }
      }
    }
  } }
}

fn approval_ntfy_acl_of_principals(anonymous: List<NtfyAccessUser>, publisher: List<NtfyAccessUser>, operator: List<NtfyAccessUser>) -> ApprovalNtfyAclVerdict {
  match first(anonymous) {
    Absent => AclRefused { deviation: AclPrincipalMissing { user: ntfy_everyone_user } }
    Present { value: a } =>
      if !role_is_anonymous(r: a.role) { AclRefused { deviation: AclAnonymousRoleNotAnonymous { observed: a.role } } }
      else { if !has_no_access(a: a.access) { AclRefused { deviation: AclAnonymousHasAccess { access: a.access } } }
      else { match first(publisher) {
        Absent => AclRefused { deviation: AclPrincipalMissing { user: approval_ntfy_publisher_user as String } }
        Present { value: p } =>
          if !holds_exactly(u: p, want: NtfyWriteOnly) { AclRefused { deviation: AclPublisherNotWriteOnly { role: p.role, access: p.access } } }
          else { match first(operator) {
            Absent => AclRefused { deviation: AclPrincipalMissing { user: approval_ntfy_operator_user as String } }
            Present { value: o } =>
              if !holds_exactly(u: o, want: NtfyReadOnly) { AclRefused { deviation: AclOperatorNotReadOnly { role: o.role, access: o.access } } }
              else { AclEstablished }
          } }
      } } }
  }
}

fn approval_ntfy_acl_deviation_sentence(d: ApprovalNtfyAclDeviation) -> String {
  match d {
    AclListingUnparseable { line: l, cause: c } => "the ntfy access listing did not parse at '" + l + "': " + c
    AclDefaultAccessNotDeny { observed: _ } => "the server's default access is not deny-all, so an unlisted principal may subscribe"
    AclAnonymousRoleNotAnonymous { observed: _ } => "the access list's '*' row is not at the anonymous role, so it is not the unauthenticated principal"
    AclAnonymousHasAccess { access: _ } => "the anonymous user '*' holds access, so an unprivileged subscriber may read"
    AclPrincipalMissing { user: u } => "the access list has no user '" + u + "'"
    AclPrincipalDuplicated { user: u } => "the access list names user '" + u + "' more than once"
    AclPublisherNotWriteOnly { role: _, access: _ } => "the publisher '" + (approval_ntfy_publisher_user as String) + "' does not hold exactly write-only on '" + (approval_ntfy_topic as String) + "'"
    AclOperatorNotReadOnly { role: _, access: _ } => "the operator '" + (approval_ntfy_operator_user as String) + "' does not hold exactly read-only on '" + (approval_ntfy_topic as String) + "'"
    AclUnexpectedPrincipal { user: u, role: _ } => "the access list names a further user '" + u + "', who is not the publisher or the operator"
    ActiveNtfyRuntimeUnbound { gap: g } => "the access list is not bound to the running ntfy server: " + approval_ntfy_runtime_gap_sentence(g: g)
  }
}
