module gunbc.auth.credentials

import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.cloud.gcp.adc_document {
  decode_adc_document,
  AdcDocumentDecoded,
  AdcDocumentDecodeRefused,
  GcpApplicationDefaultCredentials,
  AdcDocumentRefusal,
}
import extdeps.cloud.gcp.secret_manager {
  decode_sm_access_version_wire_response,
  SmAccessVersionWireDecoded,
  SmAccessVersionWireDecodeRefused,
  utf8_secret_from_access_payload,
}

type GcpSecretCredentialOutcome
  = GcpSecretCredentialReady {
      credential: Secret
      resolved_version: SmResolvedVersionIdentity
    }
  | GcpSecretCredentialWireDecodeRefused {
      identity_cause: SmResolvedVersionIdentityRefusal?
      payload_cause: SmAccessVersionPayloadRefusal?
    }

pattern gcp_secret_credential(
  project_id: NonEmptyStr,
  secret_name: NonEmptyStr,
  version: NonEmptyStr = "latest"
) -> GcpSecretCredentialOutcome
  uses net: std.resources.Network
{
  auth = shell.GCloud.AuthPrintAccessToken()
  result = gcp.SecretManager.AccessVersion(
    access_token: auth.access_token,
    project_id: project_id,
    secret: secret_name,
    version: version
  )
  return match decode_sm_access_version_wire_response(
    name: result.name as String,
    data_b64: result.data_b64
  ) {
    SmAccessVersionWireDecoded { identity: identity, payload: payload } =>
      GcpSecretCredentialReady {
        credential: utf8_secret_from_access_payload(payload: payload),
        resolved_version: identity,
      }
    SmAccessVersionWireDecodeRefused { identity_cause: identity_cause, payload_cause: payload_cause } =>
      GcpSecretCredentialWireDecodeRefused {
        identity_cause: identity_cause,
        payload_cause: payload_cause,
      }
  }
}

// The ADC read can fail two ways the previous shape could not express: the file
// may not be readable, and its bytes may not decode into the three fields. The
// old `gcloud.Auth.ReadADC` asked a `transport file` to hand back parsed JSON
// members, so both failures had nowhere to go. Threading an outcome keeps them
// typed and located rather than fabricating a token (§5).
type GcpAdcTokenOutcome
  = GcpAdcTokenReady { token: Secret }
  | GcpAdcReadRefused { path: String, cause: String }
  | GcpAdcDocumentRefused { path: String, cause: AdcDocumentRefusal }

pattern gcp_oauth_access_token_via_adc_refresh(
  adc_path: std.types.FilePath = "~/.config/gcloud/application_default_credentials.json"
) -> GcpAdcTokenOutcome
  uses net: std.resources.Network
{
  node read = Filesystem.Read(path: adc_path as String)
  return match read.success {
    true =>
      match decode_adc_document(document: read.content as Secret) {
        AdcDocumentDecoded { credentials: credentials } =>
          gcp_adc_token_from_credentials(credentials: credentials)
        AdcDocumentDecodeRefused { cause: cause } =>
          GcpAdcDocumentRefused { path: adc_path as String, cause: cause }
      }
    false =>
      GcpAdcReadRefused { path: adc_path as String, cause: read.error }
  }
}

pattern gcp_adc_token_from_credentials(
  credentials: GcpApplicationDefaultCredentials
) -> GcpAdcTokenOutcome
  uses net: std.resources.Network
{
  refresh = oauth2.Google.Refresh(
    client_id: credentials.client_id,
    client_secret: credentials.client_secret,
    refresh_token: credentials.refresh_token
  )
  return GcpAdcTokenReady { token: refresh.access_token }
}

pattern gcp_oauth_access_token_via_gcloud() -> GcpAdcTokenOutcome {
  auth = shell.GCloud.AuthPrintAccessToken()
  return GcpAdcTokenReady { token: auth.access_token }
}

pattern gcp_oauth_access_token(strategy: GcpOAuth2AccessTokenStrategy) -> GcpAdcTokenOutcome
{
  node result = match strategy {
    GcloudCli => gcp_oauth_access_token_via_gcloud()
    AdcRefresh { adc_path: path } => gcp_oauth_access_token_adc_for_path(path: path)
  }
  return result
}

pattern gcp_oauth_access_token_adc_for_path(path: std.types.FilePath?) -> GcpAdcTokenOutcome
  uses net: std.resources.Network
{
  node result = match path {
    Present { value: p } => gcp_oauth_access_token_via_adc_refresh(adc_path: p)
    Absent => gcp_oauth_access_token_via_adc_refresh()
    _ => gcp_oauth_access_token_via_adc_refresh()
  }
  return result
}
