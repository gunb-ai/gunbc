module gunbc.auth.credentials

import extdeps.cloud.gcp.secret_manager {
  decode_sm_access_version_wire_response,
  SmAccessVersionWireDecoded,
  SmAccessVersionWireDecodeRefused,
  utf8_secret_from_access_payload,
}

type GcpSecretCredentialOutcome
  = GcpSecretCredentialReady {
      credential: Secret
      resolved_version: SmResolvedVersionIdentity
    }
  | GcpSecretCredentialWireDecodeRefused {
      identity_cause: SmResolvedVersionIdentityRefusal?
      payload_cause: SmAccessVersionPayloadRefusal?
    }

pattern gcp_secret_credential(
  project_id: NonEmptyStr,
  secret_name: NonEmptyStr,
  version: NonEmptyStr = "latest"
) -> GcpSecretCredentialOutcome
  uses net: std.resources.Network
{
  auth = shell.GCloud.AuthPrintAccessToken()
  result = gcp.SecretManager.AccessVersion(
    access_token: auth.access_token,
    project_id: project_id,
    secret: secret_name,
    version: version
  )
  return match decode_sm_access_version_wire_response(
    name: result.name as String,
    data_b64: result.data_b64
  ) {
    SmAccessVersionWireDecoded { identity: identity, payload: payload } =>
      GcpSecretCredentialReady {
        credential: utf8_secret_from_access_payload(payload: payload),
        resolved_version: identity,
      }
    SmAccessVersionWireDecodeRefused { identity_cause: identity_cause, payload_cause: payload_cause } =>
      GcpSecretCredentialWireDecodeRefused {
        identity_cause: identity_cause,
        payload_cause: payload_cause,
      }
  }
}

pattern gcp_oauth_access_token_via_adc_refresh(
  adc_path: std.types.FilePath = "~/.config/gcloud/application_default_credentials.json"
) -> { token: Secret }
  uses net: std.resources.Network
{
  adc = gcloud.Auth.ReadADC(path: adc_path)
  refresh = oauth2.Google.Refresh(
    client_id: adc.client_id,
    client_secret: adc.client_secret,
    refresh_token: adc.refresh_token
  )
  return { token: refresh.access_token }
}

pattern gcp_oauth_access_token_via_gcloud() -> { token: Secret } {
  auth = shell.GCloud.AuthPrintAccessToken()
  return { token: auth.access_token }
}

pattern gcp_oauth_access_token(strategy: GcpOAuth2AccessTokenStrategy) -> { token: Secret }
{
  node result = match strategy {
    GcloudCli => gcp_oauth_access_token_via_gcloud()
    AdcRefresh { adc_path: path } => gcp_oauth_access_token_adc_for_path(path: path)
  }
  return { token: result.token }
}

pattern gcp_oauth_access_token_adc_for_path(path: std.types.FilePath?) -> { token: Secret }
  uses net: std.resources.Network
{
  node result = match path {
    Present { value: p } => gcp_oauth_access_token_via_adc_refresh(adc_path: p)
    Absent => gcp_oauth_access_token_via_adc_refresh()
    _ => gcp_oauth_access_token_via_adc_refresh()
  }
  return { token: result.token }
}
