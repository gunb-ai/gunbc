import gunbc.ci.ci_layer_roots { witness_layer_roots }
import gunbc.ci.ci_retry { ci_retry_body_run, ci_retry_step }
import gunbc.fleet.organization_runner_roster_read_credential { organization_runner_roster_read_token_request_body }

// The GitHub App credential steps: the installation-token mint every App-authenticated step runs
// (org admin, organization roster read, the App-key version verify, the heal publisher) and the App
// JWT prelude. Moved out of gunbc.ci.ci_spec (gunbc.plans.closure_consolidation P1). They share one
// module rather than joining their domains' small modules because the shared prelude reaches
// gunbc.ci.ci_retry (about 400 modules); gunbc.auth.heal_publisher_federation and
// gunbc.fleet.organization_runner_roster_read_credential stay light for their other consumers.

// THE ORG-ADMIN CREDENTIAL IS MINTED IN-RUN FROM THE App KEY THE FLEET ALREADY HOLDS; NO HUMAN
// TOKEN EXISTS. The interim in docs/plans/org-admin-credential-acquisition.md asked the operator to
// mint a fine-grained PAT and paste it into an Actions secret. That step was never taken, and it
// was never necessary: the gunbai-ci GitHub App (gunbc.auth.github_apps gunbai_ci_declared) is
// installed on the organization, its private key sits in Secret Manager behind the same WIF read
// the fleet key uses, and the runner installer already mints registration tokens with it. So this
// prelude follows the fleet-key lifecycle exactly -- WIF token by env, the SecretRef's own access
// URL, a 0600 file under RUNNER_TEMP, a trap armed before the key touches disk -- then signs a
// ten-minute RS256 JWT with openssl, exchanges it for a one-hour installation token
// (extdeps.github.org_admin_auth installation_token_citation), wipes the key, and exports the token
// into THIS step's environment only. Nothing reaches GITHUB_ENV; the trap unsets it on exit.
//
// THE HTTP STATUS IS CLASSIFIED, NOT COLLAPSED (the lesson gunbc_ci_fleet_key_agent_prelude's
// administrator sibling records): the mint POST writes its headers and body to files, and anything
// but 201 refuses with the status line, so a revoked key, a removed installation and a missing
// permission each surface as what they are rather than as a JSON decode traceback.
type AppInstallationTokenMint {
  file_stem: String
  key_secret: SecretRef
  app_id: Int
  app_slug: String
  installation_id: Int
  export_env_names: FreeSemigroup<String>
  key_unreadable_message: String
  token_refused_message: String
  minted_message: String
  request_body: String?
  observation_record: String?
}

fn app_mint_path(stem: String, suffix: String) -> String {
  join(["\"$RUNNER_TEMP/", stem, suffix, "\""], "")
}

fn app_mint_cleanup_command(spec: AppInstallationTokenMint) -> String {
  join([
    "cleanup() { rm -f \"$KEY_FILE\" \"$HDR_FILE\" \"$JWT_FILE\" \"$TOKEN_HEADERS\" \"$TOKEN_BODY\" ",
    app_mint_path(stem: spec.file_stem, suffix: "-app-key-sm-body"),
    "; unset ",
    join(non_empty_to_list(xs: spec.export_env_names), " "),
    "; }"
  ], "")
}

fn app_mint_request_body_argument(spec: AppInstallationTokenMint) -> String {
  match spec.request_body {
    Absent => ""
    Present { value: body } => join(["-H 'Content-Type: application/json' -d '", body, "' "], "")
  }
}

fn app_mint_token_request_command(spec: AppInstallationTokenMint) -> String {
  join([
    "curl -sS -X POST -H @\"$JWT_FILE\" -H 'Accept: application/vnd.github+json' ",
    app_mint_request_body_argument(spec: spec),
    "-D \"$TOKEN_HEADERS\" -o \"$TOKEN_BODY\" \"",
    github_app_installation_access_token_url(installation_id: spec.installation_id),
    "\""
  ], "")
}

fn app_mint_export_commands(spec: AppInstallationTokenMint) -> List<String> {
  concat(
    [concat("export ", spec.export_env_names.head)],
    map(spec.export_env_names.tail, n => join(["export ", n, "=\"$", spec.export_env_names.head, "\""], ""))
  )
}

// THE OBSERVATION RECORD, for the one caller whose verdict is decided in .dag rather than by this
// script's exit: the app-key version verifier (gunbc.auth.ci_app_key_rotation). Each line is what one
// boundary answered -- Secret Manager's status for the exact version, the resource name it said it
// answered about, GitHub's status line for the exchange -- written BEFORE the arm that refuses on it,
// so a refusal still leaves its cause for the verdict step that runs after. It carries no key, JWT or
// token material, and it is not in the cleanup trap because that later step reads it. Absent for
// every caller that only needs the token.
fn app_mint_record_steps(spec: AppInstallationTokenMint, key: String, value_expression: String) -> List<PipelineStep> {
  match spec.observation_record {
    Absent => []
    Present { value: path_expression } =>
      [ci_retry_step(command: join(["printf '", key, " %s\\n' ", value_expression, " >> ", path_expression], ""))]
  }
}

// ONE MINT FOR EVERY IN-RUN INSTALLATION TOKEN, because the sequence is one fact: read the App key
// from Secret Manager with this run's federated token, sign a JWT bounded by
// github_app_jwt_lifetime_seconds, exchange it for an installation token, wipe the key and then the
// JWT the moment each stops being needed, and export the token into this step's environment only.
// WHAT THE CALLERS DIFFER IN IS PARAMETERS, NOT SEQUENCE: which App, which installation, which
// secret, what the token may do (request_body down-scopes it at the mint), which environment names
// carry it, and what each failure says. A second copy of this ladder per caller is the duplication
// gunbc.design_argument::minimize_redundancy names, and it would drift in the direction that matters -- one copy learning to
// wipe a key that the other leaves behind.
//
// THE APP JWT CAN MINT A TOKEN FOR EVERY INSTALLATION OF ITS APP, so it is strictly more powerful
// than the installation token it buys; it is written to a 0600 file, spent once, and removed before
// the token is read out of the response.

fn github_app_installation_token_prelude(spec: AppInstallationTokenMint) -> List<PipelineStep> {
  concat(concat(concat(concat(concat(concat(concat(
    [
      ci_retry_step(command: "set -euo pipefail"),
      ci_retry_step(command: "umask 077"),
      ci_retry_step(command: concat("KEY_FILE=", app_mint_path(stem: spec.file_stem, suffix: "-app-key"))),
      ci_retry_step(command: concat("HDR_FILE=", app_mint_path(stem: spec.file_stem, suffix: "-auth-header"))),
      ci_retry_step(command: concat("JWT_FILE=", app_mint_path(stem: spec.file_stem, suffix: "-app-jwt"))),
      ci_retry_step(command: concat("TOKEN_HEADERS=", app_mint_path(stem: spec.file_stem, suffix: "-token-headers"))),
      ci_retry_step(command: concat("TOKEN_BODY=", app_mint_path(stem: spec.file_stem, suffix: "-token-body"))),
      ci_retry_step(command: app_mint_cleanup_command(spec: spec)),
      ci_retry_step(command: "trap cleanup EXIT"),
      ci_retry_step(command: gunbc_ci_auth_header_file_write_command()),
      ci_retry_step(command: concat("SM_BODY=", app_mint_path(stem: spec.file_stem, suffix: "-app-key-sm-body"))),
      ci_retry_step(command: join([
        "SM_CODE=\"$(curl -sS -o \"$SM_BODY\" -w '%\{http_code}' -H @\"$HDR_FILE\" \"",
        secret_ref_access_url(ref: spec.key_secret),
        "\")\""
      ], "")),
      ci_retry_step(command: "rm -f \"$HDR_FILE\"")
    ],
    app_mint_record_steps(spec: spec, key: app_key_record_key_status_key, value_expression: "\"$SM_CODE\"")),
    [
      ci_retry_step(command: join([
        "if [ \"$SM_CODE\" != 200 ]; then rm -f \"$SM_BODY\"; echo \"",
        spec.key_unreadable_message,
        "\" >&2; exit 1; fi"
      ], ""))
    ]),
    app_mint_record_steps(
      spec: spec,
      key: app_key_record_resolved_name_key,
      value_expression: "\"$(python3 -c 'import sys,json; print(json.load(open(sys.argv[1]))[\"name\"])' \"$SM_BODY\")\""
    )),
    [
      ci_retry_step(command: "python3 -c 'import sys,json,base64; sys.stdout.buffer.write(base64.b64decode(json.load(open(sys.argv[1]))[\"payload\"][\"data\"]))' \"$SM_BODY\" > \"$KEY_FILE\""),
      ci_retry_step(command: "rm -f \"$SM_BODY\""),
      ci_retry_step(command: "chmod 600 \"$KEY_FILE\""),
      ci_retry_step(command: "NOW=$(date +%s)"),
      ci_retry_step(command: "b64url() { base64 -w0 | tr '+/' '-_' | tr -d '='; }"),
      ci_retry_step(command: join(["JWT_HEADER=$(printf '%s' '", jws_protected_header_json(alg: JwsRs256, kid: none), "' | b64url)"], "")),
      ci_retry_step(command: join([
        "JWT_PAYLOAD=$(printf '", github_app_jwt_claims_json_of(iat: "%d", exp: "%d", iss: "%s"), "' \"$((NOW-",
        to_string(github_app_jwt_backdate_seconds),
        "))\" \"$((NOW+",
        to_string(github_app_jwt_lifetime_seconds),
        "))\" \"",
        to_string(spec.app_id),
        "\" | b64url)"
      ], "")),
      ci_retry_step(command: "JWT_SIG=$(printf '%s.%s' \"$JWT_HEADER\" \"$JWT_PAYLOAD\" | openssl dgst -sha256 -sign \"$KEY_FILE\" | b64url)"),
      ci_retry_step(command: "rm -f \"$KEY_FILE\""),
      ci_retry_step(command: "printf 'Authorization: Bearer %s.%s.%s\\n' \"$JWT_HEADER\" \"$JWT_PAYLOAD\" \"$JWT_SIG\" > \"$JWT_FILE\""),
      ci_retry_step(command: app_mint_token_request_command(spec: spec)),
      ci_retry_step(command: "rm -f \"$JWT_FILE\"")
    ]),
    app_mint_record_steps(
      spec: spec,
      key: app_key_record_token_status_key,
      value_expression: "\"$(head -n1 \"$TOKEN_HEADERS\" | tr -d '\\r')\""
    )),
    [
      ci_retry_step(command: join([
        "if ! head -n1 \"$TOKEN_HEADERS\" | grep -q ' 201 '; then echo \"",
        spec.token_refused_message,
        "\" >&2; exit 1; fi"
      ], "")),
      ci_retry_step(command: join([
        spec.export_env_names.head,
        "=\"$(python3 -c 'import sys,json; print(json.load(open(sys.argv[1]))[\"token\"])' \"$TOKEN_BODY\")\""
      ], "")),
      ci_retry_step(command: "rm -f \"$TOKEN_HEADERS\" \"$TOKEN_BODY\"")
    ]),
    concat(
      map(app_mint_export_commands(spec: spec), c => ci_retry_step(command: c)),
      [ci_retry_step(command: join(["echo \"", spec.minted_message, "\""], ""))]
    )
  )
}

fn org_installation_token_mint(request_body: String?, scope_note: String) -> AppInstallationTokenMint {
  AppInstallationTokenMint {
    file_stem: "org-admin",
    key_secret: gunbai_ci_app_pem_secret,
    app_id: gunbai_ci_declared.app_id.value,
    app_slug: gunbai_ci_declared.slug as String,
    installation_id: gunbai_ci_declared_installation_id.value,
    export_env_names: FreeSemigroup { head: "GUNBC_ORG_ADMIN_TOKEN", tail: ["GH_TOKEN"] },
    key_unreadable_message: org_admin_app_key_unreadable_message(
      resource: secret_ref_version_resource(ref: gunbai_ci_app_pem_secret),
      http_status: "$SM_CODE"
    ),
    token_refused_message: org_admin_installation_token_refused_message(
      installation: "gunbai-ci",
      status_line: "$(head -n1 \"$TOKEN_HEADERS\" | tr -d '\\r')"
    ),
    minted_message: join([
      "org-admin: installation token minted in-run for app ",
      gunbai_ci_declared.slug as String,
      " installation ",
      to_string(gunbai_ci_declared_installation_id.value),
      " (", scope_note, "one-hour lifetime; key wiped; token held in this step's environment only)"
    ], ""),
    request_body: request_body,
    observation_record: none
  }
}

fn org_admin_app_token_mint() -> AppInstallationTokenMint {
  org_installation_token_mint(request_body: none, scope_note: "")
}

// THE ROSTER READER'S MINT: the same implementation, down-scoped at the mint to
// organization_self_hosted_runners read (gunbc.fleet.organization_runner_roster_read_credential).
fn org_roster_read_app_token_mint() -> AppInstallationTokenMint {
  org_installation_token_mint(
    request_body: Present { value: organization_runner_roster_read_token_request_body(installation: gunbai_ci_declared_installation_id) },
    scope_note: "organization_self_hosted_runners read only; "
  )
}

fn gunbc_ci_org_admin_app_token_prelude() -> List<PipelineStep> {
  github_app_installation_token_prelude(spec: org_admin_app_token_mint())
}

fn gunbc_ci_org_roster_read_app_token_prelude() -> List<PipelineStep> {
  github_app_installation_token_prelude(spec: org_roster_read_app_token_mint())
}

// THE APP-KEY VERSION VERIFIER, as two steps: a mint over the EXACT version the dispatch names,
// then a verdict over what that mint observed. They are two steps because the mint refuses by
// exiting -- as every caller of this prelude must -- and a verdict inside the same script would
// never run on the refusals it exists to type. The verdict step runs on always() and reads the
// observation record. It is the same mint the org-admin step performs, over a different key
// version, so there is one place key material is written.
//
// The version reaches the key's resource name as a RUNTIME parameter: the dispatch input is in
// APP_KEY_VERSION, and the SecretRef the prelude reads carries that variable where a number would
// be. That is why the selector guard comes FIRST and admits only a positive decimal integer -- the
// alias and anything else never reach the URL. The guard is the shell's copy of
// extdeps.cloud.gcp.secret_manager sm_version_id_is_number, which the verdict re-applies in .dag
// over the same input, so a value one admits and the other refuses reds the verdict.
fn gunbc_ci_app_key_version_verify_key_ref() -> SecretRef {
  SecretRef {
    project: gunbai_ci_app_pem_secret.project,
    secret: gunbai_ci_app_pem_secret.secret,
    version: join(["$", app_key_version_env_name as String], "") as NonEmptyStr,
    hash_state: gunbai_ci_app_pem_secret.hash_state,
  }
}

fn app_key_version_verify_mint() -> AppInstallationTokenMint {
  AppInstallationTokenMint {
    file_stem: "app-key-verify",
    key_secret: gunbc_ci_app_key_version_verify_key_ref(),
    app_id: gunbai_ci_declared.app_id.value,
    app_slug: gunbai_ci_declared.slug as String,
    installation_id: gunbai_ci_declared_installation_id.value,
    export_env_names: FreeSemigroup { head: "GUNBC_APP_KEY_VERIFY_TOKEN", tail: [] },
    key_unreadable_message: join([
      "AppKeyVersionUnreadable: Secret Manager answered HTTP $SM_CODE for ",
      secret_ref_version_resource(ref: gunbc_ci_app_key_version_verify_key_ref()),
      "; the verdict step below types the cause. Minting NO token."
    ], ""),
    token_refused_message: "AppKeyInstallationTokenRefused: GitHub answered $(head -n1 \"$TOKEN_HEADERS\" | tr -d '\\r') to the exchange signed with this version; the verdict step below types the cause.",
    minted_message: join([
      "app-key-verify: an installation token was minted with version $", app_key_version_env_name as String,
      " for app ", gunbai_ci_declared.slug as String,
      " (key wiped; token unused and unset on exit)"
    ], ""),
    request_body: none,
    observation_record: Present { value: join(["\"$", app_key_verify_record_env_name as String, "\""], "") }
  }
}

fn gunbc_ci_app_key_version_verify_mint_script() -> String {
  gunbc_invoke_step_emit_pipeline(
    p: Pipeline {
      steps: concat(
        [
          ci_retry_step(command: "set -euo pipefail"),
          ci_retry_step(command: join([": > \"$", app_key_verify_record_env_name as String, "\""], "")),
          ci_retry_step(command: join([
            "case \"$", app_key_version_env_name as String,
            "\" in ''|0*|*[!0-9]*) echo \"AppKeyVersionSelectorRefused: '$", app_key_version_env_name as String,
            "' is not a Secret Manager version number; the alias is refused rather than resolved. Reading NO key.\" >&2; exit 1;; esac"
          ], "")),
        ],
        github_app_installation_token_prelude(spec: app_key_version_verify_mint())
      ),
      on_failure: FailFast
    }
  )
}

fn gunbc_ci_app_key_version_verify_verdict_invoke() -> String {
  gunbc_run_step_script(
    source_roots: witness_layer_roots,
    entry: "dag/gunbc/auth/ci_app_key_rotation.dag",
    function: "ci_app_key_version_verify_wet",
    claim_run: false,
    receipt_rel: Present { value: app_key_verify_receipt_path }
  )
}

// THE APP-JWT PRELUDE (operator decision 2026-09-05, option (b)). GET /app and
// GET /app/hook/config authenticate as the APP; the installation access token that
// gunbc_ci_org_admin_app_token_prelude exports reaches NEITHER, and that prelude wipes both
// the key and the JWT the instant it has its installation token.
//
// The alternative considered was retaining that prelude's JWT across its whole step. It was
// rejected on exposure, not on diff size: the App JWT can mint installation tokens for every
// installation of the App, so it is strictly more powerful than the installation token beside
// it, and keeping it resident for a whole step widens the window on the strongest credential
// in the system to save one Secret Manager read. This prelude instead re-reads the key,
// signs a JWT bounded by github_app_jwt_lifetime_seconds, and wipes the key immediately.
//
// ONLY THE PATH IS EXPORTED. GUNBC_APP_JWT_HEADER_FILE names a 0600 file holding the
// Authorization header; the token never enters an argv (where /proc would expose it to every
// process on the runner) and never enters the converge process's own environment. The trap
// wipes the file whether the step succeeds, fails, or is cancelled.
// THE KEY-UNREADABLE GUARD, AS A MODELED BRANCH RATHER THAN AN OPAQUE SHELL STRING (review 60996).
// The first cut wrote `if [ "$APP_SM_CODE" != 200 ]; then ...; exit 1; fi` inside a Run command, so
// the branch, its body and its exit were three shell facts the substrate could not see -- a
// pipeline reader could not tell this step branches at all. std.orchestration already models
// exactly this: Predicate.IntNe is the integer test, If carries the arms, and Exit carries the
// status, with bash emission in v2.extdeps.languages.bash_orch_if and operand-alphabet refusal in
// 05_emit_orchestration (^orch_emit_int_ne_operand_invalid), so metachar injection is unwritable at
// emit rather than trusted. The remaining Run commands here are single non-branching invocations,
// which Do is the modeled carrier for; the control flow is what had to stop being a string.
fn app_jwt_key_unreadable_message() -> String {
  join([
    "AppJwtKeyUnreadable: Secret Manager answered HTTP $APP_SM_CODE for ",
    secret_ref_version_resource(ref: gunbai_ci_app_pem_secret),
    " to the fleet-cloud-convergence principal. 403 means the version exists and is not readable OR does not exist -- REMEDY: run org_admin_app_key_access_converge_with_supplied_token (gunbc.fleet.org_actions_converge) with a control-plane token to bind roles/secretmanager.secretAccessor. Minting NO App JWT."
  ], "")
}

fn app_jwt_key_unreadable_guard() -> PipelineStep {
  If {
    cond: IntNe { lhs: "\"$APP_SM_CODE\"", rhs: "200" },
    then_: Pipeline {
      steps: [
        Do { run: ci_retry_body_run(command: "rm -f \"$APP_SM_BODY\"") },
        Do { run: ci_retry_body_run(command: join(["echo \"", app_jwt_key_unreadable_message(), "\" >&2"], "")) },
        Exit { status: "1" }
      ],
      on_failure: FailFast
    },
    else_: Absent
  }
}

fn gunbc_ci_app_jwt_prelude() -> List<PipelineStep> {
  [
    Do { run: ci_retry_body_run(command: "set -euo pipefail") },
    Do { run: ci_retry_body_run(command: "umask 077") },
    Do { run: ci_retry_body_run(command: "APP_KEY_FILE=\"$RUNNER_TEMP/app-jwt-key\"") },
    Do { run: ci_retry_body_run(command: "APP_SM_HDR=\"$RUNNER_TEMP/app-jwt-sm-header\"") },
    Do { run: ci_retry_body_run(command: "APP_SM_BODY=\"$RUNNER_TEMP/app-jwt-sm-body\"") },
    Do { run: ci_retry_body_run(command: "GUNBC_APP_JWT_HEADER_FILE=\"$RUNNER_TEMP/app-jwt-header\"") },
    Do {
      run: ci_retry_body_run(
        command: "app_jwt_cleanup() { rm -f \"$APP_KEY_FILE\" \"$APP_SM_HDR\" \"$APP_SM_BODY\" \"$GUNBC_APP_JWT_HEADER_FILE\"; unset GUNBC_APP_JWT_HEADER_FILE; }"
      )
    },
    Do { run: ci_retry_body_run(command: "trap app_jwt_cleanup EXIT") },
    Do { run: ci_retry_body_run(command: gunbc_ci_auth_header_file_write_command_to(header_file: "APP_SM_HDR")) },
    Do {
      run: ci_retry_body_run(
        command: join([
          "APP_SM_CODE=\"$(curl -sS -o \"$APP_SM_BODY\" -w '%\{http_code}' -H @\"$APP_SM_HDR\" \"",
          secret_ref_access_url(ref: gunbai_ci_app_pem_secret),
          "\")\""
        ], "")
      )
    },
    Do { run: ci_retry_body_run(command: "rm -f \"$APP_SM_HDR\"") },
    app_jwt_key_unreadable_guard(),
    Do { run: ci_retry_body_run(command: "python3 -c 'import sys,json,base64; sys.stdout.buffer.write(base64.b64decode(json.load(open(sys.argv[1]))[\"payload\"][\"data\"]))' \"$APP_SM_BODY\" > \"$APP_KEY_FILE\"") },
    Do { run: ci_retry_body_run(command: "rm -f \"$APP_SM_BODY\"") },
    Do { run: ci_retry_body_run(command: "chmod 600 \"$APP_KEY_FILE\"") },
    Do { run: ci_retry_body_run(command: "APP_NOW=$(date +%s)") },
    Do { run: ci_retry_body_run(command: "app_b64url() { base64 -w0 | tr '+/' '-_' | tr -d '='; }") },
    Do { run: ci_retry_body_run(command: join(["APP_JWT_HEADER=$(printf '%s' '", jws_protected_header_json(alg: JwsRs256, kid: none), "' | app_b64url)"], "")) },
    Do {
      run: ci_retry_body_run(
        command: join([
          "APP_JWT_PAYLOAD=$(printf '", github_app_jwt_claims_json_of(iat: "%d", exp: "%d", iss: "%s"), "' \"$((APP_NOW-",
          to_string(github_app_jwt_backdate_seconds),
          "))\" \"$((APP_NOW+",
          to_string(github_app_jwt_lifetime_seconds),
          "))\" \"",
          to_string(gunbai_ci_declared.app_id.value),
          "\" | app_b64url)"
        ], "")
      )
    },
    Do { run: ci_retry_body_run(command: "APP_JWT_SIG=$(printf '%s.%s' \"$APP_JWT_HEADER\" \"$APP_JWT_PAYLOAD\" | openssl dgst -sha256 -sign \"$APP_KEY_FILE\" | app_b64url)") },
    Do { run: ci_retry_body_run(command: "rm -f \"$APP_KEY_FILE\"") },
    Do { run: ci_retry_body_run(command: "printf 'Authorization: Bearer %s.%s.%s\\n' \"$APP_JWT_HEADER\" \"$APP_JWT_PAYLOAD\" \"$APP_JWT_SIG\" > \"$GUNBC_APP_JWT_HEADER_FILE\"") },
    Do { run: ci_retry_body_run(command: "chmod 600 \"$GUNBC_APP_JWT_HEADER_FILE\"") },
    Do { run: ci_retry_body_run(command: "unset APP_JWT_HEADER APP_JWT_PAYLOAD APP_JWT_SIG") },
    Do { run: ci_retry_body_run(command: "export GUNBC_APP_JWT_HEADER_FILE") },
    Do {
      run: ci_retry_body_run(
        command: join([
          "echo \"app-control-plane: short-lived App JWT minted in-run for app ",
          gunbai_ci_declared.slug as String,
          " (",
          to_string(github_app_jwt_lifetime_seconds),
          "s lifetime; key wiped; header file 0600, path exported, contents never in argv or environment)\""
        ], "")
      )
    }
  ]
}

fn heal_publisher_token_mint(app: DeclaredGitHubApp, installation: GitHubAppInstallationId, f: HealPublisherFederation) -> AppInstallationTokenMint {
  AppInstallationTokenMint {
    file_stem: "heal-publisher",
    key_secret: gunbai_bot_app_pem_secret,
    app_id: app.app_id.value,
    app_slug: app.slug as String,
    installation_id: installation.value,
    export_env_names: FreeSemigroup { head: "GITHUB_TOKEN", tail: [] },
    key_unreadable_message: heal_publisher_federation_key_unreadable_message(f: f, http_status: "$SM_CODE"),
    token_refused_message: heal_publisher_token_refused_message(
      status_line: "$(head -n1 \"$TOKEN_HEADERS\" | tr -d '\\r')"
    ),
    minted_message: join([
      "heal-publisher: installation token minted in-run for app ",
      app.slug as String,
      " installation ",
      to_string(installation.value),
      " (one hour, contents:write on this repository only; key wiped; token held in this step's environment only)"
    ], ""),
    request_body: Present { value: heal_publisher_federation_installation_token_request_body(f: f) },
    observation_record: none
  }
}
