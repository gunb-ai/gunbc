module gunbc.auth.auth_store_key

import std.types { String, NonEmptyStr, Bool, Int }

// THE ONE SHAPE AN EXTERNALLY SUPPLIED IDENTIFIER MAY HAVE BEFORE IT NAMES A FILE. A login
// transaction's state arrives in the callback query and a session id arrives in the Cookie header;
// both are then joined into a path under the instance's auth store. Both are minted here as unpadded
// base64url (RFC 4648 section 5) of 32 entropy octets, so the admitted alphabet is exactly
// [A-Za-z0-9_-]: no "/", no ".", no NUL, never empty -- a value that could climb out of its store
// ("../x", "a/b") or name nothing has no AuthStoreKey. The type is sole_constructor, so the store
// path functions that take it (gunbc.auth.login_transaction_store login_transaction_file_path,
// gunbc.auth.session_store session_store_file_path) cannot be handed a raw request string: every
// route from the wire to the filesystem passes auth_store_key_of, and a value it refuses is refused
// by the store operation with its own typed arm.
type AuthStoreKey sole_constructor {
  value: NonEmptyStr
}

// An upper bound well above the 43-character minted form, so a pathological header cannot become a
// pathological file name.
data auth_store_key_max_length: Int = 128

fn auth_store_key_code_point_admitted(cp: Int) -> Bool {
  (cp >= 65 && cp <= 90) || (cp >= 97 && cp <= 122) || (cp >= 48 && cp <= 57) || cp == 45 || cp == 95
}

fn auth_store_key_of(raw: String) -> AuthStoreKey? {
  if raw == "" || string_length(s: raw) > auth_store_key_max_length || !all(raw |> chars, cp => auth_store_key_code_point_admitted(cp: cp)) {
    none
  } else {
    Present { value: AuthStoreKey { value: raw as NonEmptyStr } }
  }
}
