module gunbc.auth.gcp_iam_bootstrap_authority

import std.types { String, Timestamp, Bool, List, path_segment_is_safe }
import extdeps.cloud.gcp.iam { GcpIamBindingCell, IamCondition }
import gunbc.auth.approval_capability { utc_instant_is_canonical, utc_instant_before, utc_instant_seconds_after }
import gunbc.auth.gcp_iam_converge { cell_preimage }

// The operator authorized this named human principal. No caller-controlled member, role, or
// project is accepted. Ongoing iam-converge is never the beneficiary of bootstrap authority.
data iam_bootstrap_operator_member: String = "user:briansrls@gunb.ai"

type BootstrapAuthorityIntent { operation: String, expires_at: Timestamp }

type BootstrapAuthorityDependency = ProjectPolicyRead | ProjectPolicyWrite | TemporaryDenyAdministration | DenyPolicyReadback | TemporaryAuthorityRetired

fn bootstrap_authority_requires(subject: BootstrapAuthorityDependency) -> List<BootstrapAuthorityDependency> {
  match subject {
    ProjectPolicyRead => []
    ProjectPolicyWrite => [ProjectPolicyRead]
    TemporaryDenyAdministration => [ProjectPolicyWrite]
    DenyPolicyReadback => [TemporaryDenyAdministration]
    TemporaryAuthorityRetired => [ProjectPolicyRead, ProjectPolicyWrite, DenyPolicyReadback]
  }
}

fn bootstrap_authority_intent_valid(intent: BootstrapAuthorityIntent) -> Bool {
  path_segment_is_safe(raw: intent.operation) && string_length(s: intent.operation) <= 48 && utc_instant_is_canonical(t: intent.expires_at)
}

// The absolute deadline is immutable in the durable intent. Reading it on retry never renews it.
fn bootstrap_authority_may_grant(intent: BootstrapAuthorityIntent, now: Timestamp) -> Bool {
  bootstrap_authority_intent_valid(intent: intent) && utc_instant_is_canonical(t: now)
    && utc_instant_before(a: now, b: intent.expires_at)
    && utc_instant_seconds_after(later: intent.expires_at, earlier: now) <= 3600
}

fn bootstrap_authority_cell(intent: BootstrapAuthorityIntent) -> GcpIamBindingCell {
  GcpIamBindingCell { role: "roles/iam.denyAdmin", member: iam_bootstrap_operator_member,
    condition: Present { value: IamCondition {
      title: concat("gunbc-bootstrap-deny-", intent.operation),
      description: Present { value: "Temporary dependency for gunbc IAM deny-policy installation; cleanup remains owed after expiry." },
      expression: join(["request.time < timestamp('", intent.expires_at as String, "')"], ""),
    } } }
}

fn bootstrap_authority_intent_wire(intent: BootstrapAuthorityIntent) -> String {
  concat("project:gunbai-secrets;", cell_preimage(c: bootstrap_authority_cell(intent: intent)))
}

type BootstrapAuthorityObservation = AuthorityAbsent | AuthorityPresent | AuthorityUnreadable

type BootstrapAuthorityAction = PublishAuthority | UseAuthority | RemoveAuthority | AuthoritySettled | AuthorityRefused

// One durable publication election prevents a retired grant from being reissued. An absent
// policy cell after an unresolved publication is NOT evidence that a queued write cannot land.
fn bootstrap_authority_action(observed: BootstrapAuthorityObservation, publication_elected: Bool, publication_closed: Bool, retired: Bool, withdrawing: Bool, live: Bool) -> BootstrapAuthorityAction {
  match observed {
    AuthorityUnreadable => AuthorityRefused
    AuthorityPresent => if !publication_elected { AuthorityRefused }
      else if withdrawing || retired || !live { RemoveAuthority } else { UseAuthority }
    AuthorityAbsent => if retired { AuthoritySettled }
      else if publication_elected { if publication_closed && withdrawing { AuthoritySettled } else { AuthorityRefused } }
      else if withdrawing { AuthoritySettled }
      else if live { PublishAuthority } else { AuthorityRefused }
  }
}
