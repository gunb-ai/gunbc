module gunbc.auth.bmc_assimilator_cells

import std.types { List, String }
import std.list { distinct_by_key }
import gunbc.auth.gcp_secret_access { SecretAccessGrant }
import gunbc.auth.secret_access_grant { DeclaredSecretGrant, grant_member }

// THE BMC ASSIMILATOR'S DECLARED GRANTS AS CELLS AND MEMBERS. A cell is the IAM binding
// (gunbc.auth.gcp_secret_access SecretAccessGrant) each declared grant composes; the member is each
// grant's own principal (grant_member), distinct.
type BmcAssimilatorCells { cells: List<SecretAccessGrant>, members: List<String> }

fn bmc_cell_key(cell: SecretAccessGrant) -> String {
  concat(concat(cell.target.secret as String, " "), cell.role)
}

fn bmc_assimilator_cells_over(grants: List<DeclaredSecretGrant>) -> BmcAssimilatorCells {
  let cells: List<SecretAccessGrant> = map(grants, g => g.cell)
  let members: List<String> = map(grants, g => grant_member(grant: g))
  BmcAssimilatorCells { cells: distinct_by_key(xs: cells, key: c => bmc_cell_key(cell: c)), members: distinct_by_key(xs: members, key: m => m) }
}
