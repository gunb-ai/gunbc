module gunbc.auth.fleet_convergence_federation

import std.types { String, NonEmptyStr, List, Map, Bool }
import std.optional { Present }
import extdeps.cloud.gcp.gcp { ServiceAccountEmail, WifProvider, wif_provider_resource, wif_pool_resource }
import gunbc.auth.github_gcp_federation { fleet_secrets_project_number, github_wif_issuer_uri, federated_service_account_member }
import gunbc.auth.oidc_claim_pins { OidcClaimPin, claim_pins_attribute_condition, claim_pins_admit, fleet_converge_workflow_claim_pins }
import gunbc.auth.heal_publisher_provision { DedicatedFederation, StandingPoolImpersonation }
import gunbc.gcp_estate_observation { fleet_cloud_convergence_sa_email }

// ── fleet-cloud-convergence IS REACHABLE FROM THE FLEET-CONVERGE WORKFLOW AT MAIN, DISPATCHED, AND NOTHING ELSE ──
// The account holds secret access a pull request must never reach (the R2 write-token accessor among
// it, gunbc.cloudflare.r2_mint_secret_access). Through the repository-wide github-oidc provider any
// job in the repository -- a pull request's, the merge queue's, a branch dispatch, heal-publish,
// witnesses -- could impersonate it. This pool's one provider pins the repository by numeric
// identity, the fleet-converge workflow file at main, the main ref and a workflow_dispatch event
// (the claim-pin shape of every dedicated fleet-converge federation, minus the job `environment`,
// which the two consumer jobs below do not declare). Its principal set is this pool alone.
//
// PINNED CONSUMERS (the jobs of fleet-converge.yml that authenticate as this account): `fleet-converge`
// and `rlm-launch-deployment-receipt`, both workflow_dispatch. They reach it through
// gunbc.fleet_host_key_enrollment probe_identity_secret_access_requirement, which names this provider.
// The service account and its secret grants already exist; this federation adds only the way in, so it
// carries no secret grants and the converge creates nothing but the pool, provider and binding.
data fleet_convergence_wif_pool_id: NonEmptyStr = "github-fleet-convergence"

data fleet_convergence_wif_provider_id: NonEmptyStr = "github-fleet-convergence-oidc"

data fleet_convergence_attribute_mapping: Map<String, String> = {
  "google.subject": "assertion.sub",
  "attribute.repository_id": "assertion.repository_id",
  "attribute.workflow_ref": "assertion.workflow_ref"
}

fn fleet_convergence_claim_pins() -> List<OidcClaimPin> {
  fleet_converge_workflow_claim_pins()
}

fn fleet_convergence_attribute_condition() -> String {
  claim_pins_attribute_condition(pins: fleet_convergence_claim_pins())
}

fn fleet_convergence_principal_set() -> String {
  join(["principalSet://iam.googleapis.com/", wif_pool_resource(project_number: fleet_secrets_project_number, pool_id: fleet_convergence_wif_pool_id as String), "/*"], "")
}

fn fleet_convergence_provider() -> WifProvider {
  WifProvider {
    name: fleet_convergence_wif_provider_id,
    pool: fleet_convergence_wif_pool_id,
    issuer_uri: github_wif_issuer_uri,
    attribute_mapping: Present { value: fleet_convergence_attribute_mapping },
    attribute_condition: Present { value: fleet_convergence_attribute_condition() },
  }
}

fn fleet_convergence_provider_resource() -> String {
  wif_provider_resource(project_number: fleet_secrets_project_number, provider: fleet_convergence_provider())
}

fn fleet_convergence_federation() -> DedicatedFederation {
  DedicatedFederation {
    label: "fleet cloud convergence (fleet-converge dispatch at main only)",
    pool_id: fleet_convergence_wif_pool_id,
    pool_display_name: "Fleet convergence (main)",
    provider_id: fleet_convergence_wif_provider_id,
    attribute_mapping: fleet_convergence_attribute_mapping,
    attribute_condition: fleet_convergence_attribute_condition(),
    impersonation: StandingPoolImpersonation { principal_set: fleet_convergence_principal_set() },
    service_account: fleet_cloud_convergence_sa_email,
    service_account_id: "fleet-cloud-convergence",
    service_account_display_name: "Fleet cloud convergence (WIF-only, no keys)",
    service_account_member: federated_service_account_member(email: fleet_cloud_convergence_sa_email),
    secret_grants: [],
  }
}
