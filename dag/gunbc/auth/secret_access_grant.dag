module gunbc.auth.secret_access_grant

import std.logic { Bool }
import std.types { NonEmptyStr, String, List }
import extdeps.cloud.gcp.gcp { ServiceAccountEmail }
import extdeps.cloud.gcp.iam { GcpBinding }
import extdeps.cloud.gcp.secret_ref { secret_ref_secret_resource }
import gunbc.auth.gcp_secret_access { SecretAccessGrant }

type GrantPrincipalCondition {
  workflow_or_job: NonEmptyStr
  attribute_condition: NonEmptyStr
}

type GrantPrincipal {
  service_account: ServiceAccountEmail
  condition: GrantPrincipalCondition
}

type OperatorSignoff
  = Signed { signed_by: NonEmptyStr, note: NonEmptyStr }
  | Unsigned

type GrantProvenance
  = DeclaredInModel
  | AppliedOutOfBand { applied_at: NonEmptyStr, note: NonEmptyStr }

// A DECLARED, signed-off record. It COMPOSES the IAM binding cell (gunbc.auth.gcp_secret_access
// SecretAccessGrant: secret, role, condition) rather than restating it, so there is one authority
// for the cell and this type owns only what the cell lacks: who, why, sign-off, provenance.
type DeclaredSecretGrant {
  cell: SecretAccessGrant
  principal: GrantPrincipal
  consumer: NonEmptyStr
  justification: NonEmptyStr
  signoff: OperatorSignoff
  provenance: GrantProvenance
}

fn grant_is_legacy(grant: DeclaredSecretGrant) -> Bool {
  match grant.provenance {
    AppliedOutOfBand { applied_at: _, note: _ } => true
    DeclaredInModel => false
  }
}

fn grant_is_signed(grant: DeclaredSecretGrant) -> Bool {
  match grant.signoff {
    Signed { signed_by: _, note: _ } => true
    Unsigned => false
  }
}

fn grant_member(grant: DeclaredSecretGrant) -> String {
  concat("serviceAccount:", grant.principal.service_account as String)
}

fn signed_grant_binding(grant: DeclaredSecretGrant) -> GcpBinding {
  GcpBinding {
    role: grant.cell.role,
    members: [grant_member(grant: grant)],
    condition: grant.cell.condition
  }
}

fn signed_grants_only(grants: List<DeclaredSecretGrant>) -> List<DeclaredSecretGrant> {
  filter(grants, g => grant_is_signed(grant: g))
}

fn signed_grant_bindings(grants: List<DeclaredSecretGrant>) -> List<GcpBinding> {
  map(signed_grants_only(grants: grants), g => signed_grant_binding(grant: g))
}

fn grant_targets_secret(grant: DeclaredSecretGrant, secret_resource: String) -> Bool {
  secret_ref_secret_resource(ref: grant.cell.target) == secret_resource
}
