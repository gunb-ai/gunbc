module gunbc.auth.secret_manager_shell_fetch

import std.types { String }
import std.measure { Second, second, second_count }

// The shell realization of one pinned Secret Manager version read: the transport bounds, the curl
// and the payload decode every CI prelude that materializes a secret consumes. Moved out of
// gunbc.ci.ci_spec unchanged (gunbc.plans.closure_consolidation P1), so a consumer of the fetch no
// longer loads the whole CI composition. The REST realization of the same read is
// gunbc.auth.secret_ref_credential.

// ONE PINNED SECRET MANAGER VERSION TO THE FILE $DEST_FILE NAMES: the auth header the prelude wrote
// (HDR_FILE), a bounded curl of the secret's access URL to RESP_FILE, the base64 payload decoded
// into DEST_FILE. Every prelude that materializes a secret -- the BMC credential, the capability
// and submission MAC keys, the D0 door's submission key -- consumes THIS producer, so the transport
// bounds and the decode are one fact (review 69591: a fourth authored copy of this fetch had
// arrived carrying bounds the other three lacked). The bounds: a handshake to Secret Manager and
// one small payload.
data gunbc_ci_sm_connect_timeout: Second = second(count: 10)
data gunbc_ci_sm_max_time: Second = second(count: 60)

fn gunbc_ci_sm_secret_to_dest_file_command(url: String) -> String {
  join([
    "curl -sSf --connect-timeout ", to_string(second_count(s: gunbc_ci_sm_connect_timeout)),
    " --max-time ", to_string(second_count(s: gunbc_ci_sm_max_time)),
    " -o \"$RESP_FILE\" -H @\"$HDR_FILE\" \"", url, "\" && ", gunbc_ci_sm_decode_payload_to_file(),
  ], "")
}

// The Secret Manager access response's payload decoder, one row for the string-built runners and the
// bash_build one.
data gunbc_ci_sm_decode_payload_program: String = "import sys,json,base64; sys.stdout.buffer.write(base64.b64decode(json.load(open(sys.argv[1]))[\"payload\"][\"data\"]))"

fn gunbc_ci_sm_decode_payload_to_file() -> String {
  join(["python3 -c '", gunbc_ci_sm_decode_payload_program, "' \"$RESP_FILE\" > \"$DEST_FILE\""], "")
}
