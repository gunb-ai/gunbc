module gunbc.auth.github_credential

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.github.app { GitHubAppPermission, GitHubAppPermissionName, GitHubAppPermissionAccess, AppAccessRead, GitHubAppInstallationId, permission_name_eq }
import extdeps.github.actions_token { actions_token_can_carry }
import extdeps.github.effect { GitHubEffect, github_effect_required_permissions }
import gunbc.auth.github_apps {
  DeclaredGitHubApp,
  GitHubAppControlPlaneState,
  control_plane_grants,
  gunbai_bot_declared,
  gunbai_bot_signer_custody,
  gunbai_ci_declared,
  gunbai_ci_declared_installation_id,
  SignerCustody,
  ObservedInstallation,
  InstallationReadbackUnavailable,
  app_control_plane_state
}

type GitHubCredentialProfileRef { name: NonEmptyStr }

type GitHubCredentialAuthority
  = ActionsJobCredential {
      workflow: DeclarationRef
      job: DeclarationRef
    }
  | ManagedAppInstallationCredential {
      app: DeclaredGitHubApp
      installation: GitHubAppInstallationId
      profile: GitHubCredentialProfileRef
    }

data credential_selection_note: String = "THE CREDENTIAL ATTACHED TO THE EFFECT IS THE ONE THAT AUTHORIZES IT. The prior cut derived .github/workflows/** push eligibility from an authored gunbai[bot] permission list while the live heal pushed with the Actions job's GITHUB_TOKEN via actions/checkout's persisted credential. Those are different credentials, so a green fold proved only that a detached Boolean was self-consistent — it could have reported AutoPushEligible for a push GitHub would reject. Selection is therefore an explicit argument here, never a global, and a declared MIGRATION TARGET is not a selection: naming ManagedAppInstallationCredential as where this should go does not make it the credential the push currently uses."

type CredentialCapability
  = CredentialGrants
  | CredentialKindCannotSatisfy { missing: GitHubAppPermissionName }
  | CredentialGrantNotObserved { missing: GitHubAppPermissionName }

fn actions_job_capability(required: GitHubAppPermission) -> CredentialCapability {
  if actions_token_can_carry(name: required.name) {
    CredentialGrants
  } else {
    CredentialKindCannotSatisfy { missing: required.name }
  }
}

fn credential_capability(
  authority: GitHubCredentialAuthority,
  control_plane: GitHubAppControlPlaneState,
  required: GitHubAppPermission
) -> CredentialCapability {
  match authority {
    ActionsJobCredential { workflow: _, job: _ } => actions_job_capability(required: required)
    ManagedAppInstallationCredential { app: _, installation: _, profile: _ } =>
      if control_plane_grants(state: control_plane, required: required) {
        CredentialGrants
      } else {
        CredentialGrantNotObserved { missing: required.name }
      }
  }
}

fn capability_is_grant(c: CredentialCapability) -> Bool {
  match c {
    CredentialGrants => true
    CredentialKindCannotSatisfy { missing: _ } => false
    CredentialGrantNotObserved { missing: _ } => false
  }
}

data app_installation_metadata_baseline: GitHubAppPermission = GitHubAppPermission {
  name: GitHubAppPermissionName { wire_name: "metadata" },
  access: AppAccessRead
}

data metadata_baseline_is_credential_scoped_note: String = "GitHub App installations carry metadata:read as a baseline; the Actions job credential has no metadata scope because Actions grants that access implicitly. So the baseline is added for the App credential kind ONLY. Putting it on the effect instead made every ordinary GITHUB_TOKEN push refuse, which witness_app_grant_cannot_rescue_actions_job_credential reported as false before this split — the control found it, not review."

fn effect_required_permissions_for(
  authority: GitHubCredentialAuthority,
  effect: GitHubEffect
) -> List<GitHubAppPermission> {
  match authority {
    ActionsJobCredential { workflow: _, job: _ } => github_effect_required_permissions(effect: effect)
    ManagedAppInstallationCredential { app: _, installation: _, profile: _ } =>
      concat([app_installation_metadata_baseline], github_effect_required_permissions(effect: effect))
  }
}

fn unsatisfied_capabilities(
  authority: GitHubCredentialAuthority,
  control_plane: GitHubAppControlPlaneState,
  effect: GitHubEffect
) -> List<CredentialCapability> {
  filter(
    map(
      effect_required_permissions_for(authority: authority, effect: effect),
      r => credential_capability(authority: authority, control_plane: control_plane, required: r)
    ),
    c => !capability_is_grant(c: c)
  )
}

fn credential_authorizes(
  authority: GitHubCredentialAuthority,
  control_plane: GitHubAppControlPlaneState,
  effect: GitHubEffect
) -> Bool {
  count(unsatisfied_capabilities(authority: authority, control_plane: control_plane, effect: effect)) == 0
}

data live_heal_push_credential: GitHubCredentialAuthority = ActionsJobCredential {
  workflow: DeclarationRef {
    module_path: "gunbc.ci_workflow",
    decl_name: "gunbc_ci_workflow",
    field: WholeDeclaration
  },
  job: DeclarationRef {
    module_path: "gunbc.ci_workflow",
    decl_name: "ci_heal_generated_artifacts_job",
    field: WholeDeclaration
  }
}

data live_heal_dispatch_credential: GitHubCredentialAuthority = ActionsJobCredential {
  workflow: DeclarationRef {
    module_path: "gunbc.ci_workflow",
    decl_name: "gunbc_ci_workflow",
    field: WholeDeclaration
  },
  job: DeclarationRef {
    module_path: "gunbc.ci_workflow",
    decl_name: "ci_heal_generated_artifacts_job",
    field: WholeDeclaration
  }
}

data heal_push_migration_target: GitHubCredentialAuthority = ManagedAppInstallationCredential {
  app: gunbai_bot_declared,
  installation: gunbai_ci_declared_installation_id,
  profile: GitHubCredentialProfileRef { name: "heal-branch-advance" }
}

data heal_push_migration_target_note: String = "A DECLARED TARGET, NOT A SELECTION. Switching the heal push onto this credential requires three things this repository does not have: signer custody for the gunbai app (gunbai_bot_signer_custody is SignerCustodyAbsent — the modeled PEM belongs to gunbai-ci, a different app), an installation readback that observes the grant, and a realization that mints the token and binds it to the push with checkout credential persistence disabled. The installation id carried here is gunbai-ci's and is a PLACEHOLDER: gunbai's own installation id is not observed anywhere in this tree, and inventing one would be the fabrication this recut exists to remove. Until a readback supplies it, every fold consuming this row refuses through the credential path, so the placeholder can never authorize."

data live_heal_control_plane: GitHubAppControlPlaneState = app_control_plane_state(
  app: gunbai_bot_declared,
  custody: gunbai_bot_signer_custody,
  observed: InstallationReadbackUnavailable,
  required: [],
  reason: "heal branch advance over .github/workflows/**"
)
