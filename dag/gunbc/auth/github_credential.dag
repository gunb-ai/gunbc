module gunbc.auth.github_credential


type GitHubCredentialProfileRef { name: NonEmptyStr }

type GitPushCredentialBinding
  = CheckoutPersistedActionsCredential { checkout_step: DeclarationRef }

type PendingAppDecision =
  | PrivilegePartitionUndecided

data pending_app_decision_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.auth.github_credential",
    decl_name: "heal_push_migration_target",
    field: WholeDeclaration
  }
}

type ManagedAppCredentialTarget
  = AppUndecided {
      profile: GitHubCredentialProfileRef
      pending: PendingAppDecision
    }
  | InstallationUnresolved {
      app: DeclaredGitHubApp
      profile: GitHubCredentialProfileRef
    }
  | InstallationResolved {
      app: DeclaredGitHubApp
      installation: GitHubAppInstallationId
      profile: GitHubCredentialProfileRef
    }

type GitHubCredentialAuthority
  = ActionsJobCredential { grant: EffectiveActionsJobGrant }
  | ManagedAppInstallationCredential {
      app: DeclaredGitHubApp
      installation: GitHubAppInstallationId
      profile: GitHubCredentialProfileRef
    }

type PushBindingResolution
  = PushBindingResolved {
      binding: GitPushCredentialBinding
      authority: GitHubCredentialAuthority
    }
  | PushCredentialBindingMissing { checkout_step: DeclarationRef }
  | PushCredentialLeaseUnresolved { checkout_step: DeclarationRef }
  | PushBindingStepKindUnsupported { checkout_step: DeclarationRef }
  | PushBindingActionMismatch { checkout_step: DeclarationRef }
  | PushBindingInputDuplicated {
      checkout_step: DeclarationRef
      input: NonEmptyStr
    }
  | PushBindingInputUnsupported {
      checkout_step: DeclarationRef
      input: NonEmptyStr
      observed_kind: YamlValueKind
    }

type CredentialCapability
  = CredentialGrants
  | CredentialKindCannotSatisfy { missing: GitHubPermissionAxis }
  | CredentialScopeNotGranted { missing: GitHubPermissionAxis }
  | CredentialForkPolicyUnobserved { missing: GitHubPermissionAxis }
  | CredentialAxisNotModeled { missing: GitHubPermissionAxis }
  | CredentialDeclaredAccessInvalid { missing: GitHubPermissionAxis }
  | CredentialGrantNotObserved { missing: GitHubPermissionAxis }
  | CredentialSubjectMismatch { missing: GitHubPermissionAxis }

fn actions_job_capability(
  grant: EffectiveActionsJobGrant,
  required: GitHubAppPermission
) -> CredentialCapability {
  match effective_actions_grant(grant: grant, name: required.name) {
    ActionsGrantScopeUnavailable => CredentialKindCannotSatisfy { missing: required.name }
    ActionsGrantAxisNotModeled => CredentialAxisNotModeled { missing: required.name }
    ActionsGrantDeclaredAccessInvalid { axis: _, declared: _, allowed: _ } =>
      CredentialDeclaredAccessInvalid { missing: required.name }
    ActionsGrantForkPolicyUnobserved => CredentialForkPolicyUnobserved { missing: required.name }
    ActionsGrantNone => CredentialScopeNotGranted { missing: required.name }
    ActionsGrantResolved { access: held } =>
      if permission_access_at_least(held: held, requested: required.access) {
        CredentialGrants
      } else {
        CredentialScopeNotGranted { missing: required.name }
      }
  }
}

fn control_plane_subject_app(state: GitHubAppControlPlaneState) -> GitHubAppId? {
  match state {
    InstallationGrantObserved { installation } => Present { value: installation.app_id }
    PermissionObservationRefused { app: _, duplicate: _ } => none
    SignerCustodyUnresolved { app: _, custody: _ } => none
    AppRegistrationUnobserved { app: _ } => none
    InstallationUnobserved { app: _, reason: _ } => none
    AppRegistrationPermissionMissing { request: _ } => none
    InstallationPermissionApprovalPending { request: _ } => none
  }
}

// Projects the whole observed installation, not just its id. The id-only
// projection forced the caller to re-match the control plane to reach the
// permissions, and that second match was unreachable in six of its seven arms
// because this projection answers Present in exactly one state (review 49193).
fn control_plane_observed_installation(state: GitHubAppControlPlaneState) -> GitHubAppInstallation? {
  match state {
    InstallationGrantObserved { installation } => Present { value: installation }
    PermissionObservationRefused { app: _, duplicate: _ } => none
    SignerCustodyUnresolved { app: _, custody: _ } => none
    AppRegistrationUnobserved { app: _ } => none
    InstallationUnobserved { app: _, reason: _ } => none
    AppRegistrationPermissionMissing { request: _ } => none
    InstallationPermissionApprovalPending { request: _ } => none
  }
}

fn managed_credential_capability(
  app: DeclaredGitHubApp,
  installation: GitHubAppInstallationId,
  control_plane: GitHubAppControlPlaneState,
  required: GitHubAppPermission
) -> CredentialCapability {
  match control_plane_subject_app(state: control_plane) {
    Absent => CredentialGrantNotObserved { missing: required.name }
    Present { value: observed_app } =>
      if observed_app.value != app.app_id.value {
        CredentialSubjectMismatch { missing: required.name }
      } else {
        match control_plane_observed_installation(state: control_plane) {
          Absent => CredentialGrantNotObserved { missing: required.name }
          Present { value: obs } =>
            if obs.installation_id.value != installation.value {
              CredentialSubjectMismatch { missing: required.name }
            } else if installation_holds(installation: obs, required: required) {
              CredentialGrants
            } else {
              CredentialGrantNotObserved { missing: required.name }
            }
        }
      }
  }
}

fn credential_capability(
  authority: GitHubCredentialAuthority,
  control_plane: GitHubAppControlPlaneState,
  required: GitHubAppPermission
) -> CredentialCapability {
  match authority {
    ActionsJobCredential { grant } => actions_job_capability(grant: grant, required: required)
    ManagedAppInstallationCredential { app, installation, profile: _ } =>
      managed_credential_capability(
        app: app,
        installation: installation,
        control_plane: control_plane,
        required: required
      )
  }
}

fn capability_is_grant(c: CredentialCapability) -> Bool {
  match c {
    CredentialGrants => true
    CredentialKindCannotSatisfy { missing: _ } => false
    CredentialScopeNotGranted { missing: _ } => false
    CredentialForkPolicyUnobserved { missing: _ } => false
    CredentialAxisNotModeled { missing: _ } => false
    CredentialDeclaredAccessInvalid { missing: _ } => false
    CredentialGrantNotObserved { missing: _ } => false
    CredentialSubjectMismatch { missing: _ } => false
  }
}

data app_installation_metadata_baseline: GitHubAppPermission = GitHubAppPermission {
  name: MetadataAxis,
  access: AppAccessRead
}

data no_baseline_permissions: List<GitHubAppPermission> = []

fn authority_baseline_permissions(
  authority: GitHubCredentialAuthority
) -> List<GitHubAppPermission> {
  match authority {
    ActionsJobCredential { grant: _ } => no_baseline_permissions
    ManagedAppInstallationCredential { app: _, installation: _, profile: _ } =>
      [app_installation_metadata_baseline]
  }
}

fn required_permissions_for(
  authority: GitHubCredentialAuthority,
  required: List<GitHubAppPermission>
) -> List<GitHubAppPermission> {
  concat(authority_baseline_permissions(authority: authority), required)
}

fn effect_required_permissions_for(
  authority: GitHubCredentialAuthority,
  effect: GitHubEffect
) -> List<GitHubAppPermission> {
  required_permissions_for(
    authority: authority,
    required: github_effect_required_permissions(effect: effect)
  )
}

fn unsatisfied_capabilities_for_required(
  authority: GitHubCredentialAuthority,
  control_plane: GitHubAppControlPlaneState,
  required: List<GitHubAppPermission>
) -> List<CredentialCapability> {
  filter(
    map(
      required_permissions_for(authority: authority, required: required),
      r => credential_capability(authority: authority, control_plane: control_plane, required: r)
    ),
    c => !capability_is_grant(c: c)
  )
}

fn unsatisfied_capabilities(
  authority: GitHubCredentialAuthority,
  control_plane: GitHubAppControlPlaneState,
  effect: GitHubEffect
) -> List<CredentialCapability> {
  unsatisfied_capabilities_for_required(
    authority: authority,
    control_plane: control_plane,
    required: github_effect_required_permissions(effect: effect)
  )
}

fn credential_authorizes_required(
  authority: GitHubCredentialAuthority,
  control_plane: GitHubAppControlPlaneState,
  required: List<GitHubAppPermission>
) -> Bool {
  count(
    unsatisfied_capabilities_for_required(
      authority: authority,
      control_plane: control_plane,
      required: required
    )
  ) == 0
}

fn credential_authorizes(
  authority: GitHubCredentialAuthority,
  control_plane: GitHubAppControlPlaneState,
  effect: GitHubEffect
) -> Bool {
  count(unsatisfied_capabilities(authority: authority, control_plane: control_plane, effect: effect)) == 0
}

data heal_push_migration_target: ManagedAppCredentialTarget = AppUndecided {
  profile: GitHubCredentialProfileRef { name: "heal-branch-advance" },
  pending: PrivilegePartitionUndecided
}

fn resolved_target_credential(target: ManagedAppCredentialTarget) -> GitHubCredentialAuthority? {
  match target {
    AppUndecided { profile: _, pending: _ } => none
    InstallationUnresolved { app: _, profile: _ } => none
    InstallationResolved { app, installation, profile } =>
      Present { value: ManagedAppInstallationCredential { app: app, installation: installation, profile: profile } }
  }
}
