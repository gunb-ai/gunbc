module gunbc.auth.github_credential


type GitHubCredentialProfileRef { name: std.types.NonEmptyStr }

type GitPushCredentialBinding
  = CheckoutPersistedActionsCredential { checkout_step: std.decl_ref.DeclarationRef }

type PendingAppDecision =
  | PrivilegePartitionUndecided

data pending_app_decision_scaffold: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: std.disposition.SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.auth.github_credential",
    decl_name: "heal_push_migration_target",
    field: std.decl_ref.WholeDeclaration
  }
}

type ManagedAppCredentialTarget
  = AppUndecided {
      profile: GitHubCredentialProfileRef
      pending: PendingAppDecision
    }
  | InstallationUnresolved {
      app: gunbc.auth.github_apps.DeclaredGitHubApp
      profile: GitHubCredentialProfileRef
    }
  | InstallationResolved {
      app: gunbc.auth.github_apps.DeclaredGitHubApp
      installation: extdeps.github.app.GitHubAppInstallationId
      profile: GitHubCredentialProfileRef
    }

type GitHubCredentialAuthority
  = ActionsJobCredential { grant: extdeps.github.actions_token.EffectiveActionsJobGrant }
  | ManagedAppInstallationCredential {
      app: gunbc.auth.github_apps.DeclaredGitHubApp
      installation: extdeps.github.app.GitHubAppInstallationId
      profile: GitHubCredentialProfileRef
    }

type PushBindingResolution
  = PushBindingResolved {
      binding: GitPushCredentialBinding
      authority: GitHubCredentialAuthority
    }
  | PushCredentialBindingMissing { checkout_step: std.decl_ref.DeclarationRef }
  | PushCredentialLeaseUnresolved { checkout_step: std.decl_ref.DeclarationRef }
  | PushBindingStepKindUnsupported { checkout_step: std.decl_ref.DeclarationRef }
  | PushBindingActionMismatch { checkout_step: std.decl_ref.DeclarationRef }
  | PushBindingInputDuplicated {
      checkout_step: std.decl_ref.DeclarationRef
      input: std.types.NonEmptyStr
    }
  | PushBindingInputUnsupported {
      checkout_step: std.decl_ref.DeclarationRef
      input: std.types.NonEmptyStr
      observed_kind: extdeps.languages.yaml.types.YamlValueKind
    }

type CredentialCapability
  = CredentialGrants
  | CredentialKindCannotSatisfy { missing: extdeps.github.app.GitHubPermissionAxis }
  | CredentialScopeNotGranted { missing: extdeps.github.app.GitHubPermissionAxis }
  | CredentialForkPolicyUnobserved { missing: extdeps.github.app.GitHubPermissionAxis }
  | CredentialAxisNotModeled { missing: extdeps.github.app.GitHubPermissionAxis }
  | CredentialDeclaredAccessInvalid { missing: extdeps.github.app.GitHubPermissionAxis }
  | CredentialGrantNotObserved { missing: extdeps.github.app.GitHubPermissionAxis }
  | CredentialSubjectMismatch { missing: extdeps.github.app.GitHubPermissionAxis }

fn actions_job_capability(
  grant: extdeps.github.actions_token.EffectiveActionsJobGrant,
  required: extdeps.github.app.GitHubAppPermission
) -> CredentialCapability {
  match extdeps.github.actions_token.effective_actions_grant(grant: grant, name: required.name) {
    extdeps.github.actions_token.ActionsGrantScopeUnavailable => CredentialKindCannotSatisfy { missing: required.name }
    extdeps.github.actions_token.ActionsGrantAxisNotModeled => CredentialAxisNotModeled { missing: required.name }
    extdeps.github.actions_token.ActionsGrantDeclaredAccessInvalid { axis: _, declared: _, allowed: _ } =>
      CredentialDeclaredAccessInvalid { missing: required.name }
    extdeps.github.actions_token.ActionsGrantForkPolicyUnobserved => CredentialForkPolicyUnobserved { missing: required.name }
    extdeps.github.actions_token.ActionsGrantNone => CredentialScopeNotGranted { missing: required.name }
    extdeps.github.actions_token.ActionsGrantResolved { access: held } =>
      if extdeps.github.app.permission_access_at_least(held: held, requested: required.access) {
        CredentialGrants
      } else {
        CredentialScopeNotGranted { missing: required.name }
      }
  }
}

fn control_plane_subject_app(state: gunbc.auth.github_apps.GitHubAppControlPlaneState) -> extdeps.github.app.GitHubAppId? {
  match state {
    gunbc.auth.github_apps.InstallationGrantObserved { installation } => Present { value: installation.app_id }
    gunbc.auth.github_apps.PermissionObservationRefused { app: _, duplicate: _ } => none
    gunbc.auth.github_apps.SignerCustodyUnresolved { app: _, custody: _ } => none
    gunbc.auth.github_apps.AppRegistrationUnobserved { app: _ } => none
    gunbc.auth.github_apps.InstallationUnobserved { app: _, reason: _ } => none
    gunbc.auth.github_apps.AppRegistrationPermissionMissing { request: _ } => none
    gunbc.auth.github_apps.InstallationPermissionApprovalPending { request: _ } => none
  }
}

// Projects the whole observed installation, not just its id. The id-only
// projection forced the caller to re-match the control plane to reach the
// permissions, and that second match was unreachable in six of its seven arms
// because this projection answers Present in exactly one state (review 49193).
fn control_plane_observed_installation(state: gunbc.auth.github_apps.GitHubAppControlPlaneState) -> GitHubAppInstallation? {
  match state {
    gunbc.auth.github_apps.InstallationGrantObserved { installation } => Present { value: installation }
    gunbc.auth.github_apps.PermissionObservationRefused { app: _, duplicate: _ } => none
    gunbc.auth.github_apps.SignerCustodyUnresolved { app: _, custody: _ } => none
    gunbc.auth.github_apps.AppRegistrationUnobserved { app: _ } => none
    gunbc.auth.github_apps.InstallationUnobserved { app: _, reason: _ } => none
    gunbc.auth.github_apps.AppRegistrationPermissionMissing { request: _ } => none
    gunbc.auth.github_apps.InstallationPermissionApprovalPending { request: _ } => none
  }
}

fn managed_credential_capability(
  app: gunbc.auth.github_apps.DeclaredGitHubApp,
  installation: extdeps.github.app.GitHubAppInstallationId,
  control_plane: gunbc.auth.github_apps.GitHubAppControlPlaneState,
  required: extdeps.github.app.GitHubAppPermission
) -> CredentialCapability {
  match control_plane_subject_app(state: control_plane) {
    Absent => CredentialGrantNotObserved { missing: required.name }
    Present { value: observed_app } =>
      if observed_app.value != app.app_id.value {
        CredentialSubjectMismatch { missing: required.name }
      } else {
        match control_plane_observed_installation(state: control_plane) {
          Absent => CredentialGrantNotObserved { missing: required.name }
          Present { value: obs } =>
            if obs.installation_id.value != installation.value {
              CredentialSubjectMismatch { missing: required.name }
            } else if gunbc.auth.github_apps.installation_holds(installation: obs, required: required) {
              CredentialGrants
            } else {
              CredentialGrantNotObserved { missing: required.name }
            }
        }
      }
  }
}

fn credential_capability(
  authority: GitHubCredentialAuthority,
  control_plane: gunbc.auth.github_apps.GitHubAppControlPlaneState,
  required: extdeps.github.app.GitHubAppPermission
) -> CredentialCapability {
  match authority {
    ActionsJobCredential { grant } => actions_job_capability(grant: grant, required: required)
    ManagedAppInstallationCredential { app, installation, profile: _ } =>
      managed_credential_capability(
        app: app,
        installation: installation,
        control_plane: control_plane,
        required: required
      )
  }
}

fn capability_is_grant(c: CredentialCapability) -> Bool {
  match c {
    CredentialGrants => true
    CredentialKindCannotSatisfy { missing: _ } => false
    CredentialScopeNotGranted { missing: _ } => false
    CredentialForkPolicyUnobserved { missing: _ } => false
    CredentialAxisNotModeled { missing: _ } => false
    CredentialDeclaredAccessInvalid { missing: _ } => false
    CredentialGrantNotObserved { missing: _ } => false
    CredentialSubjectMismatch { missing: _ } => false
  }
}

data app_installation_metadata_baseline: extdeps.github.app.GitHubAppPermission = extdeps.github.app.GitHubAppPermission {
  name: extdeps.github.app.MetadataAxis,
  access: extdeps.github.app.AppAccessRead
}

data no_baseline_permissions: List<extdeps.github.app.GitHubAppPermission> = []

fn authority_baseline_permissions(
  authority: GitHubCredentialAuthority
) -> List<extdeps.github.app.GitHubAppPermission> {
  match authority {
    ActionsJobCredential { grant: _ } => no_baseline_permissions
    ManagedAppInstallationCredential { app: _, installation: _, profile: _ } =>
      [app_installation_metadata_baseline]
  }
}

fn required_permissions_for(
  authority: GitHubCredentialAuthority,
  required: List<extdeps.github.app.GitHubAppPermission>
) -> List<extdeps.github.app.GitHubAppPermission> {
  concat(authority_baseline_permissions(authority: authority), required)
}

fn effect_required_permissions_for(
  authority: GitHubCredentialAuthority,
  effect: extdeps.github.effect.GitHubEffect
) -> List<extdeps.github.app.GitHubAppPermission> {
  required_permissions_for(
    authority: authority,
    required: extdeps.github.effect.github_effect_required_permissions(effect: effect)
  )
}

fn unsatisfied_capabilities_for_required(
  authority: GitHubCredentialAuthority,
  control_plane: gunbc.auth.github_apps.GitHubAppControlPlaneState,
  required: List<extdeps.github.app.GitHubAppPermission>
) -> List<CredentialCapability> {
  filter(
    map(
      required_permissions_for(authority: authority, required: required),
      r => credential_capability(authority: authority, control_plane: control_plane, required: r)
    ),
    c => !capability_is_grant(c: c)
  )
}

fn unsatisfied_capabilities(
  authority: GitHubCredentialAuthority,
  control_plane: gunbc.auth.github_apps.GitHubAppControlPlaneState,
  effect: extdeps.github.effect.GitHubEffect
) -> List<CredentialCapability> {
  unsatisfied_capabilities_for_required(
    authority: authority,
    control_plane: control_plane,
    required: extdeps.github.effect.github_effect_required_permissions(effect: effect)
  )
}

fn credential_authorizes_required(
  authority: GitHubCredentialAuthority,
  control_plane: gunbc.auth.github_apps.GitHubAppControlPlaneState,
  required: List<extdeps.github.app.GitHubAppPermission>
) -> Bool {
  count(
    unsatisfied_capabilities_for_required(
      authority: authority,
      control_plane: control_plane,
      required: required
    )
  ) == 0
}

fn credential_authorizes(
  authority: GitHubCredentialAuthority,
  control_plane: gunbc.auth.github_apps.GitHubAppControlPlaneState,
  effect: extdeps.github.effect.GitHubEffect
) -> Bool {
  count(unsatisfied_capabilities(authority: authority, control_plane: control_plane, effect: effect)) == 0
}

data heal_push_migration_target: ManagedAppCredentialTarget = AppUndecided {
  profile: GitHubCredentialProfileRef { name: "heal-branch-advance" },
  pending: PrivilegePartitionUndecided
}

fn resolved_target_credential(target: ManagedAppCredentialTarget) -> GitHubCredentialAuthority? {
  match target {
    AppUndecided { profile: _, pending: _ } => none
    InstallationUnresolved { app: _, profile: _ } => none
    InstallationResolved { app, installation, profile } =>
      Present { value: ManagedAppInstallationCredential { app: app, installation: installation, profile: profile } }
  }
}
