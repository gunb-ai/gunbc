module gunbc.auth.managed_accessor_credential

import std.types { NonEmptyStr, PathSegment, Secret, String }
import std.optional { Absent, Present }
import product.host_identity { HostIdentity }
import gunbc.auth.arrival_federation_pair { arrival_accessor_ref, arrival_federation_pair_for_host }
import gunbc.auth.access_token_source { select_access_token_source, AccessTokenSourceSelected, AccessTokenSourceUnavailable }
import gunbc.auth.secret_ref_credential {
  fetch_secret_ref_credential,
  SecretCredentialFetch, SecretCredentialReady, SecretCredentialAccessUpsertRequired,
  SecretCredentialWireDecodeRefused, SecretCredentialFetchRefused, SecretCredentialResolvedVersionMismatch,
}
import gunbc.auth.private_secret_file { with_private_secret_file, PrivateSecretFileCompleted, PrivateSecretFileCompletedResidueRemains, PrivateSecretFileNotEntered, PrivateSecretFileNotEnteredResidueRemains }
import gunbc.secret_provision { read_obligation_of_standing }
import extdeps.cloud.gcp.secret_ref { SecretRef }
import extdeps.cloud.gcp.secret_manager { sm_resolved_version_id, SmVersionIdProjected }

// THE MANAGED ACCESSOR CREDENTIAL, BRACKETED ONCE, SHARED BY EVERY LANE THAT NEEDS IT.
//
// WHY THIS EXISTS (gunbc.design_argument::root_generalization): two lanes -- the arrival run
// (gunbc.machine_intake.arrival_run) and the network-install entry (gunbc.host.network_install_ci) --
// need the SAME rule: read the unit's managed accessor credential from Secret Manager through the
// committed federation pair, never invent a pinned version, use the job's own workload identity, and
// hold the credential in a 0600 file for exactly the duration of one bracket. The arrival run held
// that rule inline; the install entry's first draft copied it, and the copies had already drifted on
// the pin refusal's citation obligation (review 96599). This module is the single implementation both
// callers use; the ORDER, the BRANCHING, and the REFUSAL TAXONOMY live only here, so the two lanes
// cannot disagree about what a refused credential read means.
//
// WHAT STAYS WITH EACH CALLER: everything lane-specific around the bracket -- arrival's capture row,
// BMC binding, netrc binding, and gated door; the install entry's identity routing, override, and
// plan. And the lane's own consequence sentence: this module states the FACTS (which stage refused,
// with what obligation or cause); the caller states what that refusal costs its lane.
//
// NO STAGE ANSWERS YES WHEN IT CANNOT ESTABLISH ITS EFFECT (gunbc.design_argument::fail_closed): an
// absent pair row, an uncited pin, an unavailable token source, a refused or upsert-required secret
// read, an unprojectable version, or a bracket that cannot verify its own removal each returns a typed
// ManagedAccessorCredentialRefused carrying its facts -- never a file, never a credential.

type ManagedAccessorCredentialStage
  = PairAbsent
  | PinUncited { obligation: NonEmptyStr }
  | TokenUnavailable { cause: NonEmptyStr }
  | CredentialReadRefused { detail: NonEmptyStr }
  | VersionNotResource
  | BracketResidue { cause: NonEmptyStr }

type ManagedAccessorCredentialOutcome<R>
  = ManagedAccessorCredentialCompleted { value: R }
  | ManagedAccessorCredentialRefused { stage: ManagedAccessorCredentialStage }

// What the bracket hands the caller: the pinned accessor the read used (so the caller can name it in
// its own evidence), the credential itself (for transports with a non-argv channel, such as netrc),
// the 0600 file path, and the resolved version id the read answered about.
type ManagedAccessorCredentialBundle {
  accessor: SecretRef
  credential: Secret
  credential_file: NonEmptyStr
  version: NonEmptyStr
}

// Fetch, verify, bracket, call, shred. `use` sees the bundle only while the 0600 file exists; every
// pre-bracket stage refuses before any secret traffic spends budget, and the pin gate is THE gate
// (gunbc.auth.arrival_federation_pair.arrival_accessor_ref via gunbc.secret_provision's
// accessor_ref_from_pin): a standing that is not CitedToAuthority yields no ref and no fabricated
// version, exactly as the arrival run has always refused (reviews 94066, 94085).
fn with_managed_accessor_credential<R>(
  host: HostIdentity,
  file_name: PathSegment,
  use: fn(ManagedAccessorCredentialBundle) -> R,
) -> ManagedAccessorCredentialOutcome<R> {
  match arrival_federation_pair_for_host(host: host) {
    Absent => ManagedAccessorCredentialRefused { stage: PairAbsent }
    Present { value: pair } =>
      match arrival_accessor_ref(pair: pair) {
        Absent =>
          ManagedAccessorCredentialRefused {
            stage: PinUncited { obligation: read_obligation_of_standing(pair.accessor_standing) },
          }
        Present { value: accessor } =>
          match select_access_token_source() {
            AccessTokenSourceUnavailable { cause: cause } =>
              ManagedAccessorCredentialRefused { stage: TokenUnavailable { cause: cause } }
            AccessTokenSourceSelected { source: source } =>
              match fetch_secret_ref_credential(secret_ref: accessor, token_source: source) {
                SecretCredentialReady { credential: credential, resolved_version: resolved_version } =>
                  match sm_resolved_version_id(identity: resolved_version) {
                    SmVersionIdProjected { version: version } =>
                      match with_private_secret_file(
                        file_name: file_name,
                        content: credential,
                        use: fn(credential_file) {
                          ManagedAccessorCredentialCompleted {
                            value: use(ManagedAccessorCredentialBundle {
                              accessor: accessor,
                              credential: credential,
                              credential_file: credential_file,
                              version: version,
                            }),
                          }
                        },
                      ) {
                        PrivateSecretFileCompleted { value: value } => value
                        PrivateSecretFileCompletedResidueRemains { value: _ } =>
                          ManagedAccessorCredentialRefused {
                            stage: BracketResidue { cause: "the credential file left residue after teardown" },
                          }
                        PrivateSecretFileNotEntered { cause: cause } =>
                          ManagedAccessorCredentialRefused { stage: BracketResidue { cause: cause } }
                        PrivateSecretFileNotEnteredResidueRemains { cause: cause } =>
                          ManagedAccessorCredentialRefused { stage: BracketResidue { cause: cause } }
                      }
                    _ => ManagedAccessorCredentialRefused { stage: VersionNotResource }
                  }
                SecretCredentialAccessUpsertRequired { plan: plan } =>
                  ManagedAccessorCredentialRefused { stage: CredentialReadRefused { detail: credential_fetch_detail(SecretCredentialAccessUpsertRequired { plan: plan }) } }
                SecretCredentialWireDecodeRefused { identity_cause: identity_cause, payload_cause: payload_cause } =>
                  ManagedAccessorCredentialRefused { stage: CredentialReadRefused { detail: credential_fetch_detail(SecretCredentialWireDecodeRefused { identity_cause: identity_cause, payload_cause: payload_cause }) } }
                SecretCredentialFetchRefused { reason: reason } =>
                  ManagedAccessorCredentialRefused { stage: CredentialReadRefused { detail: credential_fetch_detail(SecretCredentialFetchRefused { reason: reason }) } }
                SecretCredentialResolvedVersionMismatch { requested: requested, resolved: resolved } =>
                  ManagedAccessorCredentialRefused { stage: CredentialReadRefused { detail: credential_fetch_detail(SecretCredentialResolvedVersionMismatch { requested: requested, resolved: resolved }) } }
              }
          }
      }
  }
}

// The typed account of a non-ready secret read. Each refusal kind keeps its own words: an upsert
// requirement is not a decode failure is not a transport refusal is not a version mismatch --
// collapsing them sends the reader to inspect the wrong component.
fn credential_fetch_detail(fetch: SecretCredentialFetch) -> NonEmptyStr {
  match fetch {
    SecretCredentialAccessUpsertRequired { plan: _ } =>
      "the accessor needs a secret access upsert before it can be read" as NonEmptyStr
    SecretCredentialWireDecodeRefused { identity_cause: _, payload_cause: _ } =>
      "the secret response did not decode" as NonEmptyStr
    SecretCredentialFetchRefused { reason: reason } =>
      concat("the secret read was refused: ", reason as String) as NonEmptyStr
    SecretCredentialResolvedVersionMismatch { requested: requested, resolved: resolved } =>
      concat(
        "the secret resolved a different version than requested: requested ",
        concat(requested, concat(" resolved ", resolved)),
      ) as NonEmptyStr
    SecretCredentialReady { credential: _, resolved_version: _ } =>
      "unreachable: a ready read is bracketed, not refused" as NonEmptyStr
  }
}

// THE CANONICAL REFUSAL TEXT. The lane tag and the consequence sentence are the caller's -- the facts
// (stage, unit, obligation, cause, detail) are this module's, so a lane cannot quietly drop the
// citation obligation the way the install draft's copy did (review 96599).
fn managed_accessor_credential_refusal(
  lane: NonEmptyStr,
  host: HostIdentity,
  stage: ManagedAccessorCredentialStage,
  consequence: NonEmptyStr,
) -> String {
  concat(
    concat(lane as String, concat(": ", stage_sentence(host: host, stage: stage))),
    concat("; ", consequence as String),
  )
}

fn stage_sentence(host: HostIdentity, stage: ManagedAccessorCredentialStage) -> String {
  let unit = host as String
  match stage {
    PairAbsent =>
      concat(
        "no arrival federation pair row exists for the unit ",
        concat(unit, "; the managed accessor credential has no named accessor locus (gunbc.auth.arrival_federation_pair)"),
      )
    PinUncited { obligation: obligation } =>
      concat(
        "the accessor version pin for ",
        concat(
          unit,
          concat(
            " is absent or not cited to authority (gunbc.auth.arrival_federation_pair.arrival_accessor_ref); the pinned accessor version is never invented; the citation that would ground it: ",
            obligation as String,
          ),
        ),
      )
    TokenUnavailable { cause: cause } =>
      concat(
        "no access token source is available for ",
        concat(unit, concat("'s managed accessor credential read (", concat(cause as String, ")"))),
      )
    CredentialReadRefused { detail: detail } =>
      concat(
        "the managed accessor credential read for ",
        concat(
          unit,
          concat(" was refused or needs a secret access upsert (gunbc.auth.secret_ref_credential): ", detail as String),
        ),
      )
    VersionNotResource =>
      concat("the resolved accessor version for ", concat(unit, " is not a version resource (extdeps.cloud.gcp.secret_manager)"))
    BracketResidue { cause: cause } =>
      concat(
        "the credential file bracket for ",
        concat(
          unit,
          concat(" did not open, or left residue after teardown (gunbc.auth.private_secret_file): ", cause as String),
        ),
      )
  }
}
