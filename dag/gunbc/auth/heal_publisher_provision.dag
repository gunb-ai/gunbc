module gunbc.auth.heal_publisher_provision

import std.process { ProcessExit, ExitSuccess, ExitFailure, exit_failure }
import std.types { NonEmptyStr, String, Secret, List, Bool, Map }
import std.resources { Network }
import v2.std.optional { Present, Absent }
import extdeps.cloud.gcp.iam {
  GcpPolicy, GcpBinding, GcpIamBindingCell, GcpIamOwnedCellUniverse,
  GcpPolicyAlreadyConverged, GcpPolicyDeltaRequired, GcpPolicyRepresentationLossy,
  reconcile_gcp_policy, gcp_policy_cells, gcp_cell_in, gcp_policy_from_wire
}
import extdeps.cloud.gcp.iam_admin
import extdeps.cloud.gcp.gcp { ServiceAccountEmail }
import extdeps.transports.rest { RestOutcome, RestOk, RestStatusRefused, RestTransportRefused, RestBodyUndecodable }
import gunbc.auth.access_token_source {
  read_supplied_access_token, SuppliedTokenReady, SuppliedTokenUnavailable,
  AccessTokenSource, OperatorSuppliedToken, secret_access_token_path_env
}
import gunbc.auth.github_gcp_federation { fleet_secrets_project_id, github_wif_issuer_uri }
import gunbc.auth.heal_publisher_federation {
  heal_publisher_wif_pool_id, heal_publisher_wif_pool_display_name,
  heal_publisher_wif_provider_id, heal_publisher_wif_attribute_mapping, heal_publisher_wif_attribute_condition,
  heal_publisher_wif_principal_set, heal_publisher_service_account, heal_publisher_service_account_id,
  heal_publisher_service_account_display_name, heal_publisher_service_account_member
}
import gunbc.auth.gcp_secret_access { SecretAccessGrant, secret_accessor_grant, secret_access_ensure_for_member }
import gunbc.auth.github_apps { gunbai_bot_app_pem_secret }
import gunbc.gcp_estate_observation { role_iam_workload_identity_user }

// ONE-TIME PROVISIONING OF THE PUBLISHER'S OWN IDENTITY, run by an operator with a control-plane
// token (gunbc.auth.access_token_source secret_access_token_path_env). It handles no key material at
// all: the App key already exists as gunbai-ci's, so this run creates the identity that may read it
// and never touches the bytes.
//
// NEITHER ENTRY IS A ONE-SHOT IN THE SENSE THAT MATTERS. Three creates cannot be one request, so a
// failure at the third leaves the first two committed and the operator reruns. That rerun is the
// case the shape below is built for: a 409 is carried as an unverified presence, the reconcilable
// step still runs, and the run refuses at the end naming what nobody read -- rather than aborting at
// the first create and leaving the rest to be done by hand.

fn rest_refusal_text(o: RestOutcome) -> String {
  match o {
    RestOk => "ok"
    RestStatusRefused { status, body } => join(["status ", to_string(status as Int), ": ", body], "")
    RestTransportRefused { cause } => concat("transport: ", cause as String)
    RestBodyUndecodable { status, cause } => join(["status ", to_string(status as Int), " undecodable: ", cause as String], "")
  }
}

fn rest_ok(o: RestOutcome) -> Bool {
  match o {
    RestOk => true
    RestStatusRefused { status: _, body: _ } => false
    RestTransportRefused { cause: _ } => false
    RestBodyUndecodable { status: _, cause: _ } => false
  }
}

// ONE DEDICATED FEDERATION, AS A RECORD. The heal publisher was the first job to get its own pool,
// provider and service account; the Mt. Collins boot (gunbc.auth.mtcollins1_boot_federation) is the
// second. The provisioning below was written against the heal publisher's names, and a second copy
// differing only in those names would be two authorities for one provisioning protocol (DESIGN §3),
// so the names are a record and each federation binds its own. Everything else -- the 409 handling,
// the impersonation reconcile with readback, the grant last -- is the one protocol.
type DedicatedFederation {
  label: String
  pool_id: NonEmptyStr
  pool_display_name: NonEmptyStr
  provider_id: NonEmptyStr
  attribute_mapping: Map<String, String>
  attribute_condition: String
  principal_set: String
  service_account: ServiceAccountEmail
  service_account_id: NonEmptyStr
  service_account_display_name: NonEmptyStr
  service_account_member: String
  secret_grants: List<SecretAccessGrant>
}

fn heal_publisher_dedicated_federation() -> DedicatedFederation {
  DedicatedFederation {
    label: "heal publisher provision",
    pool_id: heal_publisher_wif_pool_id,
    pool_display_name: heal_publisher_wif_pool_display_name,
    provider_id: heal_publisher_wif_provider_id,
    attribute_mapping: heal_publisher_wif_attribute_mapping,
    attribute_condition: heal_publisher_wif_attribute_condition(),
    principal_set: heal_publisher_wif_principal_set(),
    service_account: heal_publisher_service_account,
    service_account_id: heal_publisher_service_account_id,
    service_account_display_name: heal_publisher_service_account_display_name,
    service_account_member: heal_publisher_service_account_member(),
    secret_grants: [secret_accessor_grant(target: gunbai_bot_app_pem_secret)],
  }
}

// THE ONE CELL THIS ENTRY OWNS on the service account's own policy: who may act as it.
//
// THE MEMBER IS THE WHOLE POOL, AND THIS NOTE USED TO CLAIM MORE THAN THAT BUYS. It read "the only
// identity that can impersonate this account is a token that already satisfied the provider's
// condition" -- true only because the pool holds exactly one provider today. The member is
// heal_publisher_wif_principal_set(), which ends in `/*`: every identity in the pool, not every
// identity that satisfied heal_publisher_wif_attribute_condition. Adding a second provider to this
// pool would widen impersonation silently, and the sentence above would have kept vouching for it.
//
// THE TIGHTENING IS AVAILABLE AND IS NOT TAKEN HERE. The provider maps attribute.repository_id and
// attribute.workflow_ref, so the member could be scoped to one of those rather than to `/*`. It is
// left as a stated frontier because narrowing a live impersonation binding is only safe when the
// scoped value is verified to match what GitHub actually asserts: a value that is merely plausible
// removes the publisher's ability to mint a token at all, which is heal broken rather than heal
// tightened. TRIGGER: an observed federation receipt carrying the asserted attribute, compared
// against the scoped member before the narrowed cell is written.
//
// Until then the pool is the honest description of the member, and the guard that actually holds is
// the provider's attribute condition -- one provider, whose condition is the wall.
fn impersonation_cell(f: DedicatedFederation) -> GcpIamBindingCell {
  GcpIamBindingCell {
    role: role_iam_workload_identity_user,
    member: f.principal_set,
    condition: none
  }
}

fn heal_publisher_impersonation_cell() -> GcpIamBindingCell {
  impersonation_cell(f: heal_publisher_dedicated_federation())
}

fn impersonation_owned(f: DedicatedFederation) -> GcpIamOwnedCellUniverse {
  GcpIamOwnedCellUniverse { cells: [impersonation_cell(f: f)] }
}

// A WHOLE-POLICY REPLACE THAT RETURNED 200 HAS NOT BEEN SHOWN TO CONTAIN THE CELL IT WAS WRITTEN FOR,
// so the write is followed by looking for that cell in what came back.
fn impersonation_binding_present_for(f: DedicatedFederation, policy: GcpPolicy) -> Bool {
  gcp_cell_in(c: impersonation_cell(f: f), xs: gcp_policy_cells(p: policy))
}

fn impersonation_binding_present(policy: GcpPolicy) -> Bool {
  impersonation_binding_present_for(f: heal_publisher_dedicated_federation(), policy: policy)
}

fn bind_impersonation(f: DedicatedFederation, token: Secret) -> ProcessExit
  uses net: Network
{
  let observed = gcp.IamAdmin.GetServiceAccountIamPolicy(
    access_token: token,
    project_id: fleet_secrets_project_id,
    service_account: f.service_account
  )
  if !rest_ok(o: observed.outcome) {
    exit_failure(reason: join([f.label, ": the service account's policy could not be read: ", rest_refusal_text(o: observed.outcome)], ""))
  } else {
    let observed_policy = gcp_policy_from_wire(bindings: observed.bindings, etag: observed.etag, version: observed.version)
    match reconcile_gcp_policy(
      observed: observed_policy,
      desired_owned: [impersonation_cell(f: f)],
      owned_universe: impersonation_owned(f: f)
    ) {
      GcpPolicyRepresentationLossy { conditional_roles: _ } =>
        exit_failure(reason: concat(concat(f.label, ": "), "the service account's policy was read at a representation that mangles conditional bindings, so reconciling against it could replace somebody's restricted access. Refusing."))
      GcpPolicyAlreadyConverged { policy: p } =>
        if impersonation_binding_present_for(f: f, policy: p) {
          ExitSuccess
        } else {
          exit_failure(reason: concat(concat(f.label, ": "), "reconciliation reported the service account policy converged, but the impersonation cell is absent from the policy it reported"))
        }
      GcpPolicyDeltaRequired { policy: desired_policy, added: _, removed: _, preserved: _ } => {
        let written = gcp.IamAdmin.SetServiceAccountIamPolicy(
          access_token: token,
          project_id: fleet_secrets_project_id,
          service_account: f.service_account,
          policy: desired_policy
        )
        if !rest_ok(o: written.outcome) {
          exit_failure(reason: join([f.label, ": the service account's policy could not be written: ", rest_refusal_text(o: written.outcome)], ""))
        } else if impersonation_binding_present_for(f: f, policy: gcp_policy_from_wire(bindings: written.bindings, etag: written.etag, version: written.version)) {
          ExitSuccess
        } else {
          exit_failure(reason: concat(concat(f.label, ": "), "setIamPolicy returned 200 but the policy it returned does not carry the impersonation cell"))
        }
      }
    }
  }
}

// WHAT ONE CREATE ESTABLISHED. Created is the only arm this run may call converged on its own
// evidence. AlreadyPresentUnverified is a 409: a resource with that id exists and this run did not
// observe its CONFIGURATION, which for the provider is the attribute condition -- the single fact
// that decides which workflows may federate at all -- so reporting it as converged would be this
// run asserting a security property it never read. CreateRefused is everything else.
type SubjectCreation
  = SubjectCreated
  | SubjectAlreadyPresentUnverified
  | SubjectCreateRefused { cause: String }

fn subject_creation(o: RestOutcome) -> SubjectCreation {
  match o {
    RestOk => SubjectCreated
    RestStatusRefused { status, body } =>
      if (status as Int) == 409 {
        SubjectAlreadyPresentUnverified
      } else {
        SubjectCreateRefused { cause: join(["status ", to_string(status as Int), ": ", body], "") }
      }
    RestTransportRefused { cause } => SubjectCreateRefused { cause: concat("transport: ", cause as String) }
    RestBodyUndecodable { status, cause } =>
      SubjectCreateRefused { cause: join(["status ", to_string(status as Int), " undecodable: ", cause as String], "") }
  }
}

fn creation_refusal(subject: String, c: SubjectCreation) -> String {
  match c {
    SubjectCreated => ""
    SubjectAlreadyPresentUnverified => ""
    SubjectCreateRefused { cause } => join([subject, ": ", cause, ". "], "")
  }
}

fn creation_unverified(subject: String, c: SubjectCreation) -> String {
  match c {
    SubjectCreated => ""
    SubjectAlreadyPresentUnverified => join([subject, " "], "")
    SubjectCreateRefused { cause: _ } => ""
  }
}

// THE IMPERSONATION BINDING IS REACHED EVEN WHEN A SUBJECT WAS ALREADY PRESENT, because it is a
// read-reconcile-write with its own readback: it is the one step here that is safe to repeat and
// that establishes its own result. A run that skipped it on a 409 would leave the binding unmade in
// exactly the rerun case this shape exists for. It is NOT reached when a create was refused, which
// is why this decides first and the caller performs second -- an argument position would have run
// the binding against an account this run just failed to create.
type FederationDisposition
  = FederationBindable
  | FederationStopped { reason: String }

// WHAT THE CREATE PHASE LEAVES FOR THE RECONCILE PHASE. Halted means no reconcilable step may run --
// a create was refused, or the account is not the declared one. Reconcilable means both bindings
// SHOULD run, and carries the unverified subjects forward so the run can refuse AFTER reconciling
// rather than instead of it.
type FederationOutcome
  = FederationHalted { reason: String }
  | FederationReconcilable { unverified: String }

fn federation_verdict(
  pool: SubjectCreation,
  provider: SubjectCreation,
  account: SubjectCreation
) -> FederationDisposition {
  federation_verdict_for(label: "heal publisher provision", pool: pool, provider: provider, account: account)
}

fn federation_verdict_for(
  label: String,
  pool: SubjectCreation,
  provider: SubjectCreation,
  account: SubjectCreation
) -> FederationDisposition {
  let refusals = join([
    creation_refusal(subject: "the pool", c: pool),
    creation_refusal(subject: "the provider", c: provider),
    creation_refusal(subject: "the service account", c: account)
  ], "")
  if refusals != "" {
    FederationStopped { reason: join([label, ": a subject could not be created -- ", refusals], "") }
  } else {
    FederationBindable
  }
}

// A 409 DOES NOT STOP THE RUN AND DOES NOT LET IT REPORT SUCCESS. The binding is still reconciled --
// that is the whole point of rerunning -- and the run then refuses, naming the subjects whose
// configuration nobody read, so the operator's next move is a classification rather than a guess.
fn unverified_subjects(pool: SubjectCreation, provider: SubjectCreation, account: SubjectCreation) -> String {
  join([
    creation_unverified(subject: "pool", c: pool),
    creation_unverified(subject: "provider", c: provider),
    creation_unverified(subject: "service-account", c: account)
  ], "")
}

fn bound_verdict(unverified: String, bound: ProcessExit) -> ProcessExit {
  bound_verdict_for(label: "heal publisher provision", unverified: unverified, bound: bound)
}

fn bound_verdict_for(label: String, unverified: String, bound: ProcessExit) -> ProcessExit {
  if unverified == "" {
    bound
  } else {
    match bound {
      ExitSuccess =>
        exit_failure(reason: join([
          label, ": the impersonation binding is reconciled and read back, but these subjects already ",
          "existed and this run did not read their configuration: ", unverified,
          "-- classify them against gunbc.gcp_estate_adoption gcp_estate_desired_roster before treating this federation ",
          "as provisioned. A provider whose attribute condition differs from the declared one admits workflows this ",
          "model never authorized, and a 409 establishes only that the id is taken."
        ], ""))
      _ => bound
    }
  }
}

fn provision_federation(f: DedicatedFederation, token: Secret) -> FederationOutcome
  uses net: Network
{
  let pool = gcp.IamAdmin.CreateWorkloadIdentityPool(
    access_token: token,
    project_id: fleet_secrets_project_id,
    pool_id: f.pool_id,
    display_name: f.pool_display_name
  )
  let provider = gcp.IamAdmin.CreateWorkloadIdentityPoolProvider(
    access_token: token,
    project_id: fleet_secrets_project_id,
    pool_id: f.pool_id,
    provider_id: f.provider_id,
    issuer_uri: github_wif_issuer_uri,
    attribute_mapping: f.attribute_mapping,
    attribute_condition: f.attribute_condition as NonEmptyStr
  )
  let account = gcp.IamAdmin.CreateServiceAccount(
    access_token: token,
    project_id: fleet_secrets_project_id,
    account_id: f.service_account_id,
    display_name: f.service_account_display_name
  )
  let pool_c = subject_creation(o: pool.outcome)
  let provider_c = subject_creation(o: provider.outcome)
  let account_c = subject_creation(o: account.outcome)
  match federation_verdict_for(label: f.label, pool: pool_c, provider: provider_c, account: account_c) {
    FederationStopped { reason: r } => FederationHalted { reason: r }
    FederationBindable =>
      match account_c {
        SubjectCreated =>
          if (account.email as String) != (f.service_account as String) {
            FederationHalted { reason: join([
              f.label, ": the created service account is ", account.email as String,
              ", not the declared ", f.service_account as String,
              " -- the federation declares the account the workflow presents, so a different address would leave the workflow federating to nothing"
            ], "") }
          } else {
            FederationReconcilable { unverified: unverified_subjects(pool: pool_c, provider: provider_c, account: account_c) }
          }
        _ =>
          FederationReconcilable { unverified: unverified_subjects(pool: pool_c, provider: provider_c, account: account_c) }
      }
  }
}

// THE ONE ENTRY. The pool, its single provider, the service account, who may act as it, and what it
// may read. It is one entry rather than two because there is no longer a key-custody step with
// failure modes of its own: the App key already exists in Secret Manager as gunbai-bot's, labelled
// purpose=ci-heal-push by the effort that was meant to build this publisher, so all this run adds is
// a reader.
//
// AN EARLIER REVISION CREATED THE SECRET TOO -- snapshot, container, verified version -- for a
// dedicated App that was never registered. That machinery is deleted rather than kept for a future
// caller: gunbc.secret_provision_actuator still owns it, and a second, unused copy of a credential
// path is the redundant work DESIGN section 2 prices, on the one surface where a stale copy is most
// dangerous.
//
// THE GRANT IS LAST, AND ON PURPOSE. The accessor binding names the service account, so it cannot be
// made before that account exists; running it against a missing principal would write a policy for a
// member that is not there, and setIamPolicy is a whole-policy replace.
fn grant_secret_reads(fed: DedicatedFederation, token: Secret) -> ProcessExit
  uses net: Network
{
  fold(fed.secret_grants, init: ExitSuccess, f: (acc, g) =>
    match acc {
      ExitSuccess => secret_access_ensure_for_member(grant: g, member: fed.service_account_member, token_source: OperatorSuppliedToken { token: token })
      failed => failed
    }
  )
}

// BOTH RECONCILABLE STEPS RUN BEFORE ANY UNVERIFIED-SUBJECT REFUSAL, and the first cut of this got
// it wrong in a way only a rerun could show. It applied the unverified verdict to the impersonation
// binding and then gated the accessor grant on that ProcessExit -- so on the SECOND run, where the
// three creates answer 409 and the verdict is a refusal by design, the grant became unreachable and
// silently never happened. So the refusal is applied ONCE, at the end, to the pair.
fn provision_dedicated_federation(f: DedicatedFederation, token: Secret) -> ProcessExit
  uses net: Network
{
  match provision_federation(f: f, token: token) {
    FederationHalted { reason: r } => exit_failure(reason: r)
    FederationReconcilable { unverified: u } =>
      match bind_impersonation(f: f, token: token) {
        ExitFailure { code: c, reason: r } => ExitFailure { code: c, reason: r }
        ExitSuccess =>
          match grant_secret_reads(fed: f, token: token) {
            ExitFailure { code: c, reason: r } => ExitFailure { code: c, reason: r }
            ExitSuccess => bound_verdict_for(label: f.label, unverified: u, bound: ExitSuccess)
          }
      }
  }
}

fn dedicated_federation_provision_with_supplied_token(f: DedicatedFederation) -> ProcessExit
  uses net: Network
{
  match read_supplied_access_token() {
    SuppliedTokenUnavailable { cause: c } => exit_failure(reason: c as String)
    SuppliedTokenReady { token: t } => provision_dedicated_federation(f: f, token: t)
  }
}

fn heal_publisher_federation_provision_with_supplied_token() -> ProcessExit
  uses net: Network
{
  dedicated_federation_provision_with_supplied_token(f: heal_publisher_dedicated_federation())
}
