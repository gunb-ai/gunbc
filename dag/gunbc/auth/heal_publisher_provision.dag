import gunbc.auth.heal_publisher_federation {
  HealPublisherFederation, public_heal_publisher_federation, private_heal_publisher_federation,
  heal_publisher_wif_attribute_mapping, heal_publisher_federation_attribute_condition,
  heal_publisher_federation_principal_set, heal_publisher_federation_service_account_member
}
import gunbc.auth.gcp_secret_access { SecretAccessGrant, secret_accessor_grant }
import gunbc.auth.github_apps { gunbai_bot_app_pem_secret }
import gunbc.gcp.gcp_estate_observation { role_iam_workload_identity_user, role_iam_service_account_token_creator }

// ONE-TIME PROVISIONING OF THE PUBLISHER'S OWN IDENTITY, run by an operator with a control-plane
// token (gunbc.auth.access_token_source secret_access_token_path_env). It handles no key material at
// all: the App key already exists as gunbai-ci's, so this run creates the identity that may read it
// and never touches the bytes.
//
// NEITHER ENTRY IS A ONE-SHOT IN THE SENSE THAT MATTERS. Three creates cannot be one request, so a
// failure at the third leaves the first two committed and the operator reruns. That rerun is the
// case the shape below is built for: the run READS what exists before it writes anything, a subject
// that exists and matches its declaration is taken as present, and one that exists and differs halts
// the run with nothing granted (provision_dedicated_federation).

fn rest_refusal_text(o: RestRefusal) -> String {
  match o {
    RestStatusRefused { status, body } => join(["status ", to_string(status as Int), ": ", body], "")
    RestTransportRefused { cause } => concat("transport: ", cause as String)
    RestBodyUndecodable { status, cause } => join(["status ", to_string(status as Int), " undecodable: ", cause as String], "")
  }
}

// ONE DEDICATED FEDERATION, AS A RECORD. The heal publisher was the first job to get its own pool,
// provider and service account; the managed-host boot (gunbc.auth.managed_host_boot_federation) is the
// second. The provisioning below was written against the heal publisher's names, and a second copy
// differing only in those names would be two authorities for one provisioning protocol (DESIGN §3),
// so the names are a record and each federation binds its own. Everything else -- the 409 handling,
// the impersonation reconcile with readback, the grant last -- is the one protocol.
// WHO MAY ACT AS A FEDERATION'S ACCOUNT. Every federation but one binds its whole pool standing: the
// provider's attribute condition is the wall, and any token that passes it may impersonate. A
// run-scoped federation binds nothing standing -- its pool admits branch dispatches, so a standing
// binding would hand the account to unreviewed code -- and a run gains the account only through a
// time-conditioned cell naming that run's id, written after the operator approves that exact run
// (gunbc.auth.branch_run_grant).
//
// A DELEGATING federation binds its pool standing too, but as token creator rather than workload
// identity user, because its account is the first link of a delegation chain and not the identity the
// run acts as: GenerateAccessToken with delegates needs iam.serviceAccounts.implicitDelegation on the
// first delegate, which roles/iam.workloadIdentityUser does not carry. The account's own reach is the
// next link, written on the target's policy (gunbc.review_sheet_federation is the one inhabitant).
type FederationImpersonation
  = StandingPoolImpersonation { principal_set: String }
  | StandingPoolDelegation { principal_set: String }
  | RunScopedImpersonation

type DedicatedFederation {
  label: String
  pool_id: NonEmptyStr
  pool_display_name: NonEmptyStr
  provider_id: NonEmptyStr
  attribute_mapping: Map<String, String>
  attribute_condition: String
  impersonation: FederationImpersonation
  service_account: ServiceAccountEmail
  service_account_id: NonEmptyStr
  service_account_display_name: NonEmptyStr
  service_account_member: String
  secret_grants: List<SecretAccessGrant>
}

// EVERY PUBLISHER FEDERATION IS THE SAME PROTOCOL OVER ITS OWN RECORD, and both read the one
// gunbai-bot key: the repositories differ in who may act, never in what the account may read.
fn publisher_dedicated_federation(label: String, f: HealPublisherFederation) -> DedicatedFederation {
  DedicatedFederation {
    label: label,
    pool_id: f.pool_id,
    pool_display_name: f.pool_display_name,
    provider_id: f.provider_id,
    attribute_mapping: heal_publisher_wif_attribute_mapping,
    attribute_condition: heal_publisher_federation_attribute_condition(f: f),
    impersonation: StandingPoolImpersonation { principal_set: heal_publisher_federation_principal_set(f: f) },
    service_account: f.service_account,
    service_account_id: f.service_account_id,
    service_account_display_name: f.service_account_display_name,
    service_account_member: heal_publisher_federation_service_account_member(f: f),
    secret_grants: [secret_accessor_grant(target: gunbai_bot_app_pem_secret)],
  }
}

fn heal_publisher_dedicated_federation() -> DedicatedFederation {
  publisher_dedicated_federation(label: "heal publisher provision", f: public_heal_publisher_federation())
}

fn private_heal_publisher_dedicated_federation() -> DedicatedFederation {
  publisher_dedicated_federation(label: "private heal publisher provision", f: private_heal_publisher_federation())
}

// THE ONE CELL THIS ENTRY OWNS on the service account's own policy: who may act as it.
//
// THE MEMBER IS THE WHOLE POOL, AND THIS NOTE USED TO CLAIM MORE THAN THAT BUYS. It read "the only
// identity that can impersonate this account is a token that already satisfied the provider's
// condition" -- true only because the pool holds exactly one provider today. The member is
// heal_publisher_wif_principal_set(), which ends in `/*`: every identity in the pool, not every
// identity that satisfied heal_publisher_wif_attribute_condition. Adding a second provider to this
// pool would widen impersonation silently, and the sentence above would have kept vouching for it.
//
// THE TIGHTENING IS AVAILABLE AND IS NOT TAKEN HERE. The provider maps attribute.repository_id and
// attribute.workflow_ref, so the member could be scoped to one of those rather than to `/*`. It is
// left as a stated frontier because narrowing a live impersonation binding is only safe when the
// scoped value is verified to match what GitHub actually asserts: a value that is merely plausible
// removes the publisher's ability to mint a token at all, which is heal broken rather than heal
// tightened. TRIGGER: an observed federation receipt carrying the asserted attribute, compared
// against the scoped member before the narrowed cell is written.
//
// Until then the pool is the honest description of the member, and the guard that actually holds is
// the provider's attribute condition -- one provider, whose condition is the wall.
fn standing_impersonation_cell(principal_set: String) -> GcpIamBindingCell {
  GcpIamBindingCell {
    role: role_iam_workload_identity_user,
    member: principal_set,
    condition: none
  }
}

// THE STANDING CELLS A FEDERATION OWNS on its account's policy: one for a standing pool, none for a
// run-scoped federation, whose run cells are owned by the grant that writes them.
fn impersonation_cells(f: DedicatedFederation) -> List<GcpIamBindingCell> {
  match f.impersonation {
    StandingPoolImpersonation { principal_set: ps } => [standing_impersonation_cell(principal_set: ps)]
    StandingPoolDelegation { principal_set: ps } => [GcpIamBindingCell { role: role_iam_service_account_token_creator, member: ps, condition: none }]
    RunScopedImpersonation => []
  }
}

fn standing_principal_set(f: DedicatedFederation) -> String? {
  match f.impersonation {
    StandingPoolImpersonation { principal_set: ps } => Present { value: ps }
    StandingPoolDelegation { principal_set: ps } => Present { value: ps }
    RunScopedImpersonation => none
  }
}

fn heal_publisher_impersonation_cell() -> GcpIamBindingCell {
  standing_impersonation_cell(principal_set: heal_publisher_federation_principal_set(f: public_heal_publisher_federation()))
}

fn impersonation_owned(f: DedicatedFederation) -> GcpIamOwnedCellUniverse {
  GcpIamOwnedCellUniverse { cells: impersonation_cells(f: f) }
}

// A WHOLE-POLICY REPLACE THAT RETURNED 200 HAS NOT BEEN SHOWN TO CONTAIN THE CELL IT WAS WRITTEN FOR,
// so the write is followed by looking for that cell in what came back.
fn impersonation_binding_present_for(f: DedicatedFederation, policy: GcpPolicy) -> Bool {
  all(impersonation_cells(f: f), c => gcp_cell_in(c: c, xs: gcp_policy_cells(p: policy)))
}

fn impersonation_binding_present(policy: GcpPolicy) -> Bool {
  impersonation_binding_present_for(f: heal_publisher_dedicated_federation(), policy: policy)
}

fn bind_impersonation(f: DedicatedFederation, token: Secret) -> ProcessExit
{
  match gcp.IamAdmin.GetServiceAccountIamPolicy(
    access_token: token,
    project_id: fleet_secrets_project_id,
    service_account: f.service_account
  ) {
    RestRefused { refusal } =>
      exit_failure(reason: join([f.label, ": the service account's policy could not be read: ", rest_refusal_text(o: refusal)], ""))
    RestAnswered { answer: observed } => {
      let observed_policy = gcp_policy_from_wire(bindings: observed.bindings, etag: observed.etag, version: observed.version)
      match reconcile_gcp_policy(
        observed: observed_policy,
        desired_owned: impersonation_cells(f: f),
        owned_universe: impersonation_owned(f: f)
      ) {
        GcpPolicyRepresentationLossy { conditional_roles: _ } =>
          exit_failure(reason: concat(concat(f.label, ": "), "the service account's policy was read at a representation that mangles conditional bindings, so reconciling against it could replace somebody's restricted access. Refusing."))
        GcpPolicyAlreadyConverged { policy: p } =>
          if impersonation_binding_present_for(f: f, policy: p) {
            ExitSuccess
          } else {
            exit_failure(reason: concat(concat(f.label, ": "), "reconciliation reported the service account policy converged, but the impersonation cell is absent from the policy it reported"))
          }
        GcpPolicyDeltaRequired { policy: desired_policy, added: _, removed: _, preserved: _ } =>
          match gcp.IamAdmin.SetServiceAccountIamPolicy(
            access_token: token,
            project_id: fleet_secrets_project_id,
            service_account: f.service_account,
            policy: desired_policy
          ) {
            RestRefused { refusal } =>
              exit_failure(reason: join([f.label, ": the service account's policy could not be written: ", rest_refusal_text(o: refusal)], ""))
            RestAnswered { answer: written } =>
              if impersonation_binding_present_for(f: f, policy: gcp_policy_from_wire(bindings: written.bindings, etag: written.etag, version: written.version)) {
                ExitSuccess
              } else {
                exit_failure(reason: concat(concat(f.label, ": "), "setIamPolicy returned 200 but the policy it returned does not carry the impersonation cell"))
              }
          }
      }
    }
  }
}

// WHAT ONE CREATE ESTABLISHED. Created is the only arm this run may call converged on its own
// evidence. AlreadyPresentUnverified is a 409: a resource with that id exists and this run did not
// observe its CONFIGURATION, which for the provider is the attribute condition -- the single fact
// that decides which workflows may federate at all -- so reporting it as converged would be this
// run asserting a security property it never read. CreateRefused is everything else.
// subject_creation classifies a REFUSED create only; an answered pool or provider create is
// SubjectCreated only once its long-running operation is done (created_after_operation), and an
// answered account create, which is not an operation, is SubjectCreated at the call site.
type SubjectCreation
  = SubjectCreated
  | SubjectAlreadyPresentUnverified
  | SubjectCreateRefused { cause: String }

fn subject_creation(o: RestRefusal) -> SubjectCreation {
  match o {
    RestStatusRefused { status, body } =>
      if (status as Int) == 409 {
        SubjectAlreadyPresentUnverified
      } else {
        SubjectCreateRefused { cause: join(["status ", to_string(status as Int), ": ", body], "") }
      }
    RestTransportRefused { cause } => SubjectCreateRefused { cause: concat("transport: ", cause as String) }
    RestBodyUndecodable { status, cause } =>
      SubjectCreateRefused { cause: join(["status ", to_string(status as Int), " undecodable: ", cause as String], "") }
  }
}

// ── OBSERVE, CLASSIFY, AND ONLY THEN WRITE (side-chat review 5286225278 on gunbc#12101) ─────────
// The first protocol treated a 409 as an "unverified presence", went on to bind the pool as the
// account's impersonator and to grant the secret cells, and refused only at the END. A pre-existing
// provider with a lax condition would therefore have been handed the secrets before anything said so.
// Now nothing is written through a subject until its configuration has been READ and classified
// against the declaration: the pool, its WHOLE provider population (deleted ones included), each
// provider's issuer, mapping and condition, and the account. An existing subject that does not match
// halts the run with no write at all; adopting an existing, differing subject is a separate path this
// entry does not take. A create is issued only for a subject observed ABSENT, and the run re-reads
// and re-classifies after creating, so a policy write only ever follows a readback that matched.

type PoolReading
  = PoolObservedAbsent
  | PoolObserved { pool: WifPoolWire }
  | PoolForbidden { cause: String }
  | PoolUnreadable { cause: String }

type ProvidersReading
  = ProvidersObserved { providers: List<WifProviderWire> }
  | ProvidersUnreadable { cause: String }

type AccountReading
  = AccountObservedAbsent
  | AccountObserved { email: String }
  | AccountForbidden { cause: String }
  | AccountUnreadable { cause: String }

// PERMISSION_DENIED IS ITS OWN ARM, never a reason string: what it means depends on the reader. For a
// resource-local reader (the converge's iam-observe) it is "absent or unbound", which only
// gunbc.auth.gcp_iam_bootstrap_delta classifies; for an operator token it is a refused read.
type FederationClassification
  = FederationClassified { create_pool: Bool, create_provider: Bool, create_account: Bool }
  | FederationPermissionDenied { pool: Bool, account: Bool, causes: List<String> }
  | FederationUnclassified { reasons: List<String> }

fn outcome_is_not_found(o: RestRefusal) -> Bool {
  match o {
    RestStatusRefused { status, body: _ } => (status as Int) == 404
    RestTransportRefused { cause: _ } => false
    RestBodyUndecodable { status: _, cause: _ } => false
  }
}

fn outcome_is_forbidden(o: RestRefusal) -> Bool {
  match o {
    RestStatusRefused { status, body: _ } => (status as Int) == 403
    RestTransportRefused { cause: _ } => false
    RestBodyUndecodable { status: _, cause: _ } => false
  }
}

fn string_or_empty(v: String?) -> String {
  match v {
    Present { value: x } => x
    Absent => ""
  }
}

fn bool_or_false(v: Bool?) -> Bool {
  match v {
    Present { value: x } => x
    Absent => false
  }
}

fn ends_with_segment(name: String, segment: String) -> Bool {
  ends_with(s: name, suffix: concat("/", segment))
}

fn mapping_equal(a: Map<String, String>?, b: Map<String, String>) -> Bool {
  match a {
    Absent => false
    Present { value: m } => m == b
  }
}

fn pool_reasons(f: DedicatedFederation, pool: PoolReading) -> List<String> {
  match pool {
    PoolObservedAbsent => []
    PoolForbidden { cause: _ } => []
    PoolUnreadable { cause: c } => [concat("the pool could not be read: ", c)]
    PoolObserved { pool: p } => concat(
      if ends_with_segment(name: p.name, segment: f.pool_id as String) { [] } else { [concat("the pool read back as ", p.name)] },
      concat(
        if bool_or_false(v: p.disabled) { ["the pool is disabled"] } else { [] },
        if string_or_empty(v: p.state) == "ACTIVE" { [] } else { [concat("the pool state is ", string_or_empty(v: p.state))] },
      ),
    )
  }
}

fn provider_reasons(f: DedicatedFederation, p: WifProviderWire) -> List<String> {
  let issuer = match p.oidc { Present { value: o } => o.issuer_uri  Absent => "" }
  concat(
    if ends_with_segment(name: p.name, segment: f.provider_id as String) { [] } else { [concat("an undeclared provider is in the pool: ", p.name)] },
    concat(
      if string_or_empty(v: p.state) == "ACTIVE" { [] } else { [join(["provider ", p.name, " state is ", string_or_empty(v: p.state)], "")] },
      concat(
        if bool_or_false(v: p.disabled) { [concat("provider is disabled: ", p.name)] } else { [] },
        concat(
          if issuer == (github_wif_issuer_uri as String) { [] } else { [join(["provider ", p.name, " issuer is '", issuer, "'"], "")] },
          concat(
            if string_or_empty(v: p.attribute_condition) == f.attribute_condition { [] } else { [join(["provider ", p.name, " condition is '", string_or_empty(v: p.attribute_condition), "', not the declared one"], "")] },
            if mapping_equal(a: p.attribute_mapping, b: f.attribute_mapping) { [] } else { [join(["provider ", p.name, " attribute mapping differs from the declared one"], "")] },
          ),
        ),
      ),
    ),
  )
}

fn providers_reasons(f: DedicatedFederation, providers: ProvidersReading) -> List<String> {
  match providers {
    ProvidersUnreadable { cause: c } => [concat("the provider population could not be read: ", c)]
    ProvidersObserved { providers: ps } =>
      if ps.length() > 1 {
        concat([join(["the pool holds ", to_string(ps.length()), " providers; exactly one is declared"], "")], flat_map(ps, p => provider_reasons(f: f, p: p)))
      } else {
        flat_map(ps, p => provider_reasons(f: f, p: p))
      }
  }
}

fn account_reasons(f: DedicatedFederation, account: AccountReading) -> List<String> {
  match account {
    AccountObservedAbsent => []
    AccountForbidden { cause: _ } => []
    AccountUnreadable { cause: c } => [concat("the service account could not be read: ", c)]
    AccountObserved { email: e } =>
      if e == (f.service_account as String) { [] } else { [join(["the service account read back as ", e, ", not ", f.service_account as String], "")] }
  }
}

fn providers_absent(providers: ProvidersReading) -> Bool {
  match providers {
    ProvidersObserved { providers: ps } => ps.length() == 0
    ProvidersUnreadable { cause: _ } => false
  }
}

// THE CLASSIFIER IS PURE: the witness supplies readings, and the only arm that lets the run proceed
// is one where every present subject matched field by field.
fn classify_dedicated_federation(f: DedicatedFederation, pool: PoolReading, providers: ProvidersReading, account: AccountReading) -> FederationClassification {
  let reasons = concat(pool_reasons(f: f, pool: pool), concat(providers_reasons(f: f, providers: providers), account_reasons(f: f, account: account)))
  let pool_denied = match pool { PoolForbidden { cause } => [concat("pool: ", cause)]  PoolObservedAbsent => []  PoolObserved { pool: _ } => []  PoolUnreadable { cause: _ } => [] }
  let account_denied = match account { AccountForbidden { cause } => [concat("service account: ", cause)]  AccountObservedAbsent => []  AccountObserved { email: _ } => []  AccountUnreadable { cause: _ } => [] }
  if reasons.length() > 0 {
    FederationUnclassified { reasons: reasons }
  } else if count(pool_denied) + count(account_denied) > 0 {
    FederationPermissionDenied { pool: count(pool_denied) > 0, account: count(account_denied) > 0, causes: pool_denied + account_denied }
  } else {
    FederationClassified {
      create_pool: match pool { PoolObservedAbsent => true  PoolObserved { pool: _ } => false  PoolForbidden { cause: _ } => false  PoolUnreadable { cause: _ } => false },
      create_provider: providers_absent(providers: providers),
      create_account: match account { AccountObservedAbsent => true  AccountObserved { email: _ } => false  AccountForbidden { cause: _ } => false  AccountUnreadable { cause: _ } => false },
    }
  }
}

fn federation_fully_present(c: FederationClassification) -> Bool {
  match c {
    FederationClassified { create_pool: a, create_provider: b, create_account: d } => !a && !b && !d
    FederationPermissionDenied { pool: _, account: _, causes: _ } => false
    FederationUnclassified { reasons: _ } => false
  }
}

fn read_pool(f: DedicatedFederation, token: Secret) -> PoolReading
{
  match gcp.IamAdmin.GetWorkloadIdentityPool(access_token: token, project_id: fleet_secrets_project_id, pool_id: f.pool_id) {
    RestAnswered { answer: r } =>
      PoolObserved { pool: WifPoolWire { name: r.pool_name, display_name: r.display_name, disabled: r.disabled, state: r.state } }
    RestRefused { refusal } =>
      if outcome_is_not_found(o: refusal) {
        PoolObservedAbsent
      } else {
        if outcome_is_forbidden(o: refusal) {
          PoolForbidden { cause: rest_refusal_text(o: refusal) }
        } else {
          PoolUnreadable { cause: rest_refusal_text(o: refusal) }
        }
      }
  }
}

fn read_providers(f: DedicatedFederation, token: Secret) -> ProvidersReading
{
  match gcp.IamAdmin.ListWorkloadIdentityPoolProviders(access_token: token, project_id: fleet_secrets_project_id, pool_id: f.pool_id) {
    RestAnswered { answer: r } =>
      ProvidersObserved { providers: match r.providers { Present { value: ps } => ps  Absent => [] } }
    RestRefused { refusal } =>
      if outcome_is_not_found(o: refusal) {
        ProvidersObserved { providers: [] }
      } else {
        ProvidersUnreadable { cause: rest_refusal_text(o: refusal) }
      }
  }
}

fn read_account(f: DedicatedFederation, token: Secret) -> AccountReading
{
  match gcp.IamAdmin.GetServiceAccount(access_token: token, project_id: fleet_secrets_project_id, sa_email: f.service_account) {
    RestAnswered { answer: r } =>
      AccountObserved { email: r.email as String }
    RestRefused { refusal } =>
      if outcome_is_not_found(o: refusal) {
        AccountObservedAbsent
      } else {
        if outcome_is_forbidden(o: refusal) {
          AccountForbidden { cause: rest_refusal_text(o: refusal) }
        } else {
          AccountUnreadable { cause: rest_refusal_text(o: refusal) }
        }
      }
  }
}

fn observe_and_classify(f: DedicatedFederation, token: Secret) -> FederationClassification
{
  classify_dedicated_federation(f: f, pool: read_pool(f: f, token: token), providers: read_providers(f: f, token: token), account: read_account(f: f, token: token))
}

fn unclassified_exit(f: DedicatedFederation, phase: String, reasons: List<String>) -> ProcessExit {
  exit_failure(reason: join([f.label, ": ", phase, " -- nothing was granted: ", join(reasons, "; "), ". Adopting an existing, differing subject is a separate path; this entry does not take it."], ""))
}

// A CREATE IS ISSUED ONLY FOR A SUBJECT OBSERVED ABSENT, so every answer but a 200 is a halt: a 409
// here means someone created the id between the read and the write.
fn create_if(wanted: Bool, subject: String, creation: SubjectCreation) -> String {
  if !wanted {
    ""
  } else {
    match creation {
      SubjectCreated => ""
      SubjectAlreadyPresentUnverified => join([subject, " appeared between the read and the create; "], "")
      SubjectCreateRefused { cause } => join([subject, ": ", cause, "; "], "")
    }
  }
}

fn workload_identity_resource_id_refusal(f: DedicatedFederation, input: String, id: NonEmptyStr, operation: String) -> List<String> {
  if workload_identity_resource_id_admitted(id: id) { [] } else { [join([
    f.label, ": ", input, " \"", id as String, "\" is ", to_string(string_length(s: id as String)), " characters; ", operation, " admits ",
    to_string(workload_identity_resource_id_min_characters), " to ", to_string(workload_identity_resource_id_max_characters),
    " characters of [a-z0-9-], not beginning ", workload_identity_resource_id_reserved_prefix,
  ], "")] }
}

// The upstream refuses a malformed pool id, an over-long pool display name or a malformed provider id
// only once a run holds a token, so every route that may create a pool or provider reads its whole
// creation population here before it reads one.
fn dedicated_federation_input_refusals(federations: List<DedicatedFederation>) -> List<String> {
  flat_map(federations, f =>
    workload_identity_resource_id_refusal(f: f, input: "pool id", id: f.pool_id, operation: "CreateWorkloadIdentityPool")
    + (if workload_identity_pool_display_name_admitted(name: f.pool_display_name) { [] } else { [join([
      f.label, ": pool display name \"", f.pool_display_name as String, "\" is ", to_string(string_length(s: f.pool_display_name as String)),
      " characters; CreateWorkloadIdentityPool admits at most ", to_string(workload_identity_pool_display_name_max_characters),
    ], "")] })
    + workload_identity_resource_id_refusal(f: f, input: "provider id", id: f.provider_id, operation: "CreateWorkloadIdentityPoolProvider"))
}

// A create that answered 200 is created only once its long-running operation is done; a failed, spent
// or unreadable operation halts the run and the create is not reissued (gunbc.auth.gcp_operation_wait).
fn created_after_operation(waited: String) -> SubjectCreation {
  if waited == "" { SubjectCreated } else { SubjectCreateRefused { cause: waited } }
}

fn create_absent_subjects(f: DedicatedFederation, token: Secret, c: FederationClassification) -> String
{
  match c {
    FederationUnclassified { reasons: _ } => "unclassified; nothing created"
    FederationPermissionDenied { pool: _, account: _, causes: cs } => concat("permission denied to the reading identity; nothing created: ", join(cs, "; "))
    FederationClassified { create_pool: cp, create_provider: cv, create_account: ca } => {
      let pool = if cp {
        create_if(wanted: true, subject: "the pool", creation: match gcp.IamAdmin.CreateWorkloadIdentityPool(access_token: token, project_id: fleet_secrets_project_id, pool_id: f.pool_id, display_name: f.pool_display_name) {
          RestAnswered { answer: a } => created_after_operation(waited: wif_create_operation_wait(token: token, subject: WifPoolOperation { pool_id: f.pool_id as String }, operation_name: a.operation_name, done: a.done, error: a.error, render_refusal: o => rest_refusal_text(o: o)))
          RestRefused { refusal } => subject_creation(o: refusal)
        })
      } else { "" }
      if pool != "" {
        return pool
      }
      let provider = if cv {
        create_if(wanted: true, subject: "the provider", creation: match gcp.IamAdmin.CreateWorkloadIdentityPoolProvider(access_token: token, project_id: fleet_secrets_project_id, pool_id: f.pool_id, provider_id: f.provider_id, issuer_uri: github_wif_issuer_uri, attribute_mapping: f.attribute_mapping, attribute_condition: f.attribute_condition as NonEmptyStr) {
          RestAnswered { answer: a } => created_after_operation(waited: wif_create_operation_wait(token: token, subject: WifProviderOperation { pool_id: f.pool_id as String, provider_id: f.provider_id as String }, operation_name: a.operation_name, done: a.done, error: a.error, render_refusal: o => rest_refusal_text(o: o)))
          RestRefused { refusal } => subject_creation(o: refusal)
        })
      } else { "" }
      if provider != "" {
        return provider
      }
      if ca {
        create_if(wanted: true, subject: "the service account", creation: match gcp.IamAdmin.CreateServiceAccount(access_token: token, project_id: fleet_secrets_project_id, account_id: f.service_account_id, display_name: f.service_account_display_name) {
          RestAnswered { answer: _ } => SubjectCreated
          RestRefused { refusal } => subject_creation(o: refusal)
        })
      } else { "" }
    }
  }
}

// THE ORDER IS THE PROTOCOL: observe and classify; create only what was absent; re-observe and
// require every subject present and matching; only then write who may act as the account. What it
// may read is NOT written here: a federation's secret_grants are gcp_iam_converge target cells, bound by
// the converge (and its bootstrap delta) under one approval, never under this operator token (writer
// census, gunbc#14360). No policy write precedes a matching readback of the pool, its whole provider
// population and the account.
fn provision_dedicated_federation(f: DedicatedFederation, token: Secret) -> ProcessExit
{
  let before = observe_and_classify(f: f, token: token)
  match before {
    FederationUnclassified { reasons: rs } => return unclassified_exit(f: f, phase: "an existing subject does not match its declaration", reasons: rs)
    FederationPermissionDenied { pool: _, account: _, causes: cs } => return unclassified_exit(f: f, phase: "the reading identity is denied a declared subject", reasons: cs)
    FederationClassified { create_pool: _, create_provider: _, create_account: _ } => {}
  }
  let created = create_absent_subjects(f: f, token: token, c: before)
  if created != "" {
    return exit_failure(reason: join([f.label, ": a create did not land -- nothing was granted: ", created], ""))
  }
  let after = observe_and_classify(f: f, token: token)
  match after {
    FederationUnclassified { reasons: rs } => unclassified_exit(f: f, phase: "the readback after creating does not match the declaration", reasons: rs)
    FederationPermissionDenied { pool: _, account: _, causes: cs } => unclassified_exit(f: f, phase: "the readback after creating is denied to the reading identity", reasons: cs)
    FederationClassified { create_pool: _, create_provider: _, create_account: _ } =>
      if !federation_fully_present(c: after) {
        exit_failure(reason: concat(f.label, ": a created subject is not yet visible on readback -- nothing was granted; rerun once it reads back"))
      } else {
        bind_impersonation(f: f, token: token)
      }
  }
}

fn dedicated_federation_provision_with_supplied_token(f: DedicatedFederation) -> ProcessExit
{
  let input_refusals = dedicated_federation_input_refusals(federations: [f])
  if count(input_refusals) > 0 { exit_failure(reason: join(input_refusals, "; ")) }
  else { match read_supplied_access_token() {
    SuppliedTokenUnavailable { cause: c } => exit_failure(reason: c as String)
    SuppliedTokenReady { token: t } => provision_dedicated_federation(f: f, token: t)
  } }
}

fn heal_publisher_federation_provision_with_supplied_token() -> ProcessExit
{
  dedicated_federation_provision_with_supplied_token(f: heal_publisher_dedicated_federation())
}

