module gunbc.auth.mtcollins1_branch_boot_trust

import std.types { Bool, List, Map, NonEmptyStr, String }
import std.optional { Present, Absent }
import extdeps.cloud.gcp.gcp { ServiceAccountEmail, WifProvider, wif_provider_resource, wif_pool_resource }
import gunbc.auth.github_gcp_federation { fleet_secrets_project_number, github_wif_issuer_uri, federated_service_account_member }
import gunbc.auth.oidc_claim_pins {
  OidcClaimPin, OidcPresentedClaim, claim_pins_attribute_condition, claim_pins_admit, oidc_equals, oidc_equals_any,
  oidc_starts_with, presented_from_pins, with_presented_value, workflow_dispatch_event_name,
  fleet_converge_workflow_ref_heads_prefix,
}
import gunbc.repository { gunbc_repository_numeric_identity }
import gunbc.auth.heal_publisher_provision { DedicatedFederation, StandingPoolImpersonation }
import gunbc.auth.managed_host_boot_federation { boot_federation_for, provisioned_federation_of, ManagedHostBootFederation }
import gunbc.auth.gcp_secret_access { SecretAccessGrant, secret_accessor_grant }
import gunbc.host.boot_medium_reader_key { boot_medium_reader_ssh_key, boot_medium_reader_ssh_privkey_secret }
import gunbc.fleet.fleet_ssh_access { fleet_automation_ssh_privkey_secret }
import gunbc.fleet.fleet_host_identity { operator_host_mtcollins1 }

// ── THE APPROVAL-FREE mtcollins1 BOOT FROM A SAME-REPOSITORY BRANCH (operator rulings 2026-10-22/23) ──
// WHAT WAS RULED, in the operator's own words, in this lane on 2026-10-23 -- and the 2026-10-22 ruling
// that a mtcollins1 boot "is not sensitive". These EXTEND the 2026-09-23 and 2026-09-25 rulings already
// cited in gunbc.auth.privileged_effect_census, which removed the approval for main-dispatched
// mtcollins1_boot and host_reset_return:
//   "permission to boot it endlessly"; booting from a non-main integration branch "shouldn't need an
//   approval"; merry-fox-82 is the dedicated mtcollins1 lane.
//
// THE TRUST IS IAM-SIDE, AND THAT IS THE WHOLE DESIGN. A branch can rewrite its own workflow file, so a
// check inside fleet-converge.yml would be a bypass wearing a gate's clothes. Nothing here reads
// workflow text: what admits a run is GCP evaluating this provider's attribute condition against claims
// the GitHub OIDC issuer signed -- the repository by NUMERIC identity (a fork is a different number),
// the fleet-converge workflow file on a heads ref, a workflow_dispatch event, the git ref equal to a
// rostered branch, and the job's `environment` equal to the boot environment's NAME. That name reaches
// the job from the code-declared federation names in gunbc.auth.managed_host_boot_federation, never
// from the file a branch edits. A branch that rewrites fleet-converge.yml, renames its `environment:`,
// or invents a branch name mints no claim this admits.
//
// WHY A POOL, PROVIDER AND ACCOUNT OF ITS OWN, AND NOT A WIDENING OF WHAT EXISTS. Three facts about
// this corpus make the obvious routes impossible rather than merely unwise:
//   1. GcpIamEffect has CreateProvider and NO UpdateProvider (gunbc.auth.gcp_iam_converge): a provider's
//      condition and attribute mapping are write-once. The branch trust must reason over the git REF and
//      the job ENVIRONMENT, and the dispatch pool's provider maps neither -- it cannot be taught.
//   2. The classifier reads a pool and requires EXACTLY ONE provider (gunbc.auth.heal_publisher_provision
//      providers_reasons: "the pool holds N providers; exactly one is declared"), compared against the
//      one the federation declares. Adding a second provider to github-fleet-converge-dispatch would
//      make every federation naming that pool refuse to classify -- the run-scoped accounts of the modes
//      that DO keep a grant (run_scoped_modes: hetzner_cloud_server_read, plan, apply) would stop
//      converging, including modes that have nothing to do with this host.
//   3. Widening the standing binding on the EXISTING mtcollins1-boot-run account is refused by that
//      account's own doctrine (gunbc.auth.heal_publisher_provision): a run-scoped federation "binds
//      nothing standing -- its pool admits branch dispatches, so a standing binding would hand the
//      account to unreviewed code -- and a run gains the account only through a time-conditioned cell
//      naming that run's id, written after the operator approves that exact run". mtcollins1-boot-run
//      is that account, and host_reset_return still depends on it staying that way.
// So this route gets its own pool, its own provider with its own condition, and its own account,
// reached from no other provider. The dispatch pool, its provider, the run-scoped accounts, the broker
// and the per-run grant are all UNTOUCHED -- which is what keeps every other mode on its grant. The
// pool and account are created by iam-bootstrap's delta from this declaration (a target's pool and
// account are DeltaOwned: gunbc.auth.gcp_iam_bootstrap_model iam_bootstrap_cell_owner), and the
// provider by gcp_iam_converge. NOTHING HERE IS APPLIED BY HAND.
//
// WHY THIS IS NOT A SECOND APPROVAL ROUTE (gunbc.design_ruling
// one_approval_route_for_every_privileged_action). That ruling binds a privileged effect "that a human
// can attend" to the one approval-broker route, and lets the administrator edge survive only for an
// UNATTENDED MintsHostRootReach. A BMC power cycle is neither attended -- the operator gave STANDING
// consent out of band for this one mode, the same consent the 2026-09-23/25 rulings recorded for the
// main-dispatched twin, moved to the branch case -- nor does it mint host root. So there is no second
// broker, no second consent object, and nothing here asks a human to attend: it is a no-approval
// SELECTION. Every other row of run_scoped_modes() keeps its per-run grant, issued only after operator
// approval; host_reset_return has no row in that table and this module changes nothing about it.
//
// WHAT IT WIDENS, SAID PLAINLY (the PR body says it in these terms): anyone who can push to a rostered
// branch of gunb-ai/gunbc can drive mtcollins1's BMC -- power-cycle it and mount its virtual CD -- with
// no per-run approval. The gate is the roster; the ability to push is the credential. It is confined to
// this host and this mode; the unit maintenance hold still stops a boot on a held unit from any ref; and
// what the account may read are the SAME pinned versions the admitted boot federation declares (the
// BMC's published cd_version, and the fleet automation key's version) -- that key is the fleet operator
// key which a BMC-only boot never uses and which is not an authorized_keys entry on mtcollins1, so no
// host root comes of it.

// THE ROSTER OF BRANCHES HELD TO CARRY THE APPROVAL-FREE BOOT. A roster and not a prefix, on purpose:
// a new branch earns the route by landing a change to THIS list in a reviewed PR, which is what keeps
// "anyone with branch push" from quietly becoming "anyone with branch push plus a name they just made
// up". Deliberately the dedicated lane's own boot branch, and nothing else.
data mtcollins1_boot_trusted_branches: List<NonEmptyStr> = [
  "session/merry-fox-82-mc1-boot-branch",
]

fn mtcollins1_boot_trusted_branch_ref(branch: String) -> String {
  join(["refs/heads/", branch], "")
}

// THE CLOSED LIST OF ADMITTED REFS. EqualsAny, never a starts_with: an unlisted branch is refused
// exactly as an unequal claim is, and the alternative -- a prefix -- is the widening the 2026-10-10
// split-identity ruling in gunbc.auth.oidc_claim_pins refuses for privileged identities. An empty
// roster admits nothing: the poison value is not a branch name any run can present.
fn mtcollins1_boot_trusted_ref_pin() -> OidcClaimPin {
  match mtcollins1_boot_trusted_branches.first() {
    Present { value: b } =>
      oidc_equals_any(
        claim: "ref",
        value: mtcollins1_boot_trusted_branch_ref(branch: b as String),
        alternatives: map(mtcollins1_boot_trusted_branches.skip(n: 1), x => mtcollins1_boot_trusted_branch_ref(branch: x as String)),
      )
    Absent => oidc_equals(claim: "ref", value: "__GUNBC_MTCOLLINS1_BOOT_NO_TRUSTED_BRANCH__")
  }
}

// THE GITHUB ENVIRONMENT THE BOOT JOB DECLARES, read from the admitted boot federation's own names
// rather than restated: it is the same string the job's `environment:` key renders from, so pinning it
// here pins the job -- a job that renames its own environment is not the boot job and is refused.
// No branch route can exist without a provisioned boot identity to name that environment.
fn mtcollins1_boot_trusted_environment() -> String? {
  match provisioned_federation_of(s: boot_federation_for(host: operator_host_mtcollins1)) {
    Present { value: f } => Present { value: f.names.environment as String }
    Absent => none
  }
}

// THE ENVIRONMENT PIN, POISONED BY DEFAULT. This is the fail-closed half of the route, and it belongs
// HERE -- in the pin list -- rather than in the caller that assembles it, because the pins are the whole
// membership rule and they have TWO PROJECTIONS (gunbc.auth.oidc_claim_pins): the CEL GCP stores and the
// admission this corpus evaluates are both folds over this one list. A caller cannot be trusted to add
// the pin, because the provider is not built through the guarded path: mtcollins1_boot_branch_provider()
// reads mtcollins1_boot_branch_claim_pins() directly, and so does the workflow's credential renderer, so
// anything that guarded this only in mtcollins1_boot_branch_federation() would leave the converged
// PROVIDER admitting more than the federation describes.
//
// So an unknown environment is not "no environment pin" -- that would make the provider LESS restrictive
// than the route it stands for, which is fail-open in the one place the brief said the wall must be. It
// is a value no dispatch can present, exactly as an empty roster poisons the ref pin: the condition keeps
// its environment conjunct and matches nothing.
fn mtcollins1_boot_trusted_environment_pin() -> OidcClaimPin {
  match mtcollins1_boot_trusted_environment() {
    Present { value: e } => oidc_equals(claim: "environment", value: e)
    Absent => oidc_equals(claim: "environment", value: "__GUNBC_MTCOLLINS1_BOOT_NO_ENVIRONMENT__")
  }
}

data mtcollins1_boot_branch_wif_pool_id: NonEmptyStr = "github-mtcollins1-boot-branch"

data mtcollins1_boot_branch_wif_pool_display_name: NonEmptyStr = "MtCollins1 boot branch"

// 25 characters, inside the 4..32 upstream constrains: a 35-character id once failed this fleet's
// converge at CreateWorkloadIdentityPoolProvider with 400 INVALID_ARGUMENT, and the check here is the
// shape of that lesson.
data mtcollins1_boot_branch_wif_provider_id: NonEmptyStr = "mtcollins1-boot-branch"

data mtcollins1_boot_branch_service_account_id: NonEmptyStr = "mtcollins1-boot-branch"

data mtcollins1_boot_branch_service_account: ServiceAccountEmail =
  "mtcollins1-boot-branch@gunbai-secrets.iam.gserviceaccount.com"

// THE MAPPED CLAIMS. The ref and the environment are what the condition reasons over, so they are
// asserted attributes of THIS provider; nothing else is mapped, because a mapping no condition reads is
// reach without use.
data mtcollins1_boot_branch_attribute_mapping: Map<String, String> = {
  "google.subject": "assertion.sub",
  "attribute.repository_id": "assertion.repository_id",
  "attribute.workflow_ref": "assertion.workflow_ref",
  "attribute.ref": "assertion.ref",
  "attribute.environment": "assertion.environment"
}

// THE PINS, as data. repository_id and repository_owner_id are the numeric identity, not the slug: a
// fork of this repository has this slug and a DIFFERENT number, and the 2026-10-10 split-identity
// ruling in gunbc.auth.oidc_claim_pins makes a fork's refusal turn on the number for exactly that
// reason. workflow_ref pins the fleet-converge file on any heads ref; the ref pin then closes the set
// to the roster.
fn mtcollins1_boot_branch_claim_pins() -> List<OidcClaimPin> {
  let base = [
    oidc_equals(claim: "repository_id", value: to_string(gunbc_repository_numeric_identity.repository_id)),
    oidc_equals(claim: "repository_owner_id", value: to_string(gunbc_repository_numeric_identity.owner_id)),
    oidc_starts_with(claim: "workflow_ref", value: fleet_converge_workflow_ref_heads_prefix()),
    oidc_equals(claim: "event_name", value: workflow_dispatch_event_name),
    mtcollins1_boot_trusted_ref_pin(),
  ]
  // UNCONDITIONAL. There is deliberately no match over the option here: a match is what let the absent
  // case return `base`, and a branch of a membership rule that returns the rule minus one conjunct is
  // how a provider ends up admitting a job in no environment at all.
  concat(base, [mtcollins1_boot_trusted_environment_pin()])
}

fn mtcollins1_boot_branch_attribute_condition() -> String {
  claim_pins_attribute_condition(pins: mtcollins1_boot_branch_claim_pins())
}

// THE ADMISSION THIS CORPUS CAN EVALUATE, over presented claims: the same pin list read as a predicate
// rather than as CEL, so a RED can ask "does THIS run's claim set reach the approval-free boot" and be
// answered against the provisioned condition itself.
fn mtcollins1_boot_branch_admits(claims: List<OidcPresentedClaim>) -> Bool {
  claim_pins_admit(pins: mtcollins1_boot_branch_claim_pins(), claims: claims)
}

// THE CLAIMS A DISPATCH OF THIS BRANCH, IN THIS ENVIRONMENT, PRESENTS -- everything the pins name, at
// the values a real dispatch signs, so a RED states a scenario instead of a fixture.
fn mtcollins1_boot_branch_presented_claims(branch: String, environment: String) -> List<OidcPresentedClaim> {
  let base = presented_from_pins(pins: mtcollins1_boot_branch_claim_pins())
  with_presented_value(
    claims: with_presented_value(claims: base, claim: "ref", value: mtcollins1_boot_trusted_branch_ref(branch: branch)),
    claim: "environment",
    value: environment,
  )
}

// IS THIS BRANCH HELD TO CARRY THE APPROVAL-FREE BOOT? The selection authority asks this; the provider's
// condition enforces the same list independently in GCP, and a run must satisfy both.
fn mtcollins1_boot_branch_is_trusted(branch: String) -> Bool {
  any(mtcollins1_boot_trusted_branches, b => (b as String) == branch)
}

// THE PRINCIPAL SET OF THIS PROVIDER ALONE -- not `pool/*`. Naming the provider is what makes the
// standing binding cover tokens THIS condition minted and nothing any other provider might mint; and
// unlike a pool-wide set it cannot be widened by someone else adding a provider here.
fn mtcollins1_boot_branch_principal_set() -> String {
  join([
    "principalSet://iam.googleapis.com/",
    wif_pool_resource(project_number: fleet_secrets_project_number, pool_id: mtcollins1_boot_branch_wif_pool_id as String),
    "/provider/",
    mtcollins1_boot_branch_wif_provider_id as String,
    "/*",
  ], "")
}

fn mtcollins1_boot_branch_provider() -> WifProvider {
  WifProvider {
    name: mtcollins1_boot_branch_wif_provider_id,
    pool: mtcollins1_boot_branch_wif_pool_id,
    issuer_uri: github_wif_issuer_uri,
    attribute_mapping: Present { value: mtcollins1_boot_branch_attribute_mapping },
    attribute_condition: Present { value: mtcollins1_boot_branch_attribute_condition() },
  }
}

fn mtcollins1_boot_branch_provider_resource() -> String {
  wif_provider_resource(project_number: fleet_secrets_project_number, provider: mtcollins1_boot_branch_provider())
}

// THE FEDERATION, or none. Four states refuse it, each named so a witness can ask about the one it
// cares about: an EMPTY ROSTER (no branch may federate this identity), an UNPROVISIONED BOOT identity (the
// same refusal the run-scoped route uses, so a host with no admitted boot identity gets no branch route
// either), an UNNAMEABLE ENVIRONMENT (the fail-open guard below), and AN INCOMPLETE POLICY (a branch boot
// that could not read its BMC credential, or could not do the readback it advertises -- see
// mtcollins1_boot_branch_secret_grants). Refusing means NO pool, NO provider and NO service account: the
// route disappears from gunbc.auth.gcp_iam_converge_targets rather than existing with a policy nobody
// accounted for.
fn mtcollins1_boot_branch_federation() -> DedicatedFederation? {
  mtcollins1_boot_branch_federation_with(reader: mtcollins1_boot_branch_reader_grant())
}

// WHY THE ROUTE DOES NOT EXIST, OR NONE WHEN IT DOES. ONE function holds every refusal, so a refusal can
// never name a reason that is not the reason, and the builder below cannot drift from the explanation it
// gives. Each state is named because an operator reading a refusal should learn what to DO.
fn mtcollins1_boot_branch_route_refusal_cause_with(reader: SecretAccessGrant?) -> NonEmptyStr? {
  match provisioned_federation_of(s: boot_federation_for(host: operator_host_mtcollins1)) {
    Absent =>
      Present { value: "the host's own boot identity is unprovisioned, so there is no boot policy for a branch to be narrowed from" as NonEmptyStr }
    Present { value: f } =>
      if mtcollins1_boot_trusted_branches.length() == 0 {
        // THE ROSTER IS THE PERMISSION, so this asks what the roster HOLDS -- not whether one named entry
        // is trusted, which is true by construction for an entry taken from the roster itself and would
        // read as a trust check while being an emptiness check.
        Present { value: "no branch is rostered for the approval-free boot, so the route is not declared at all" as NonEmptyStr }
      } else if match mtcollins1_boot_trusted_environment() { Absent => true  Present { value: _ } => false } {
        // NOT REDUNDANT WITH THE ARM ABOVE. The two states coincide TODAY -- an unprovisioned boot is
        // exactly the one with no environment -- and a guard that is only accidentally equivalent to the
        // thing it protects is the shape that lets the next refactor reopen the hole.
        Present { value: "the boot federation names no environment, so its environment pin cannot be mirrored without dropping the conjunct" as NonEmptyStr }
      } else if mtcollins1_boot_branch_secret_grants_with(f: f, reader: reader).length() == 0 {
        // THE STATE TODAY, AND THE ONLY STATE THAT SHOULD PRODUCE IT: the reader key is unminted. Naming
        // the missing credential and the change that installs it makes the refusal actionable instead of
        // a mystery. Both cells or nothing -- see mtcollins1_boot_branch_secret_grants.
        Present { value: "the boot medium reader key is not minted, so the branch account could only be given an incomplete policy (the BMC credential without the key the served-medium readback runs over); mint it through the FleetKeypairMint converge mode (PR #15329) to open this route" as NonEmptyStr }
      } else {
        none
      }
  }
}

// THE REFUSAL FOR THE ROUTE AS IT ACTUALLY STANDS, with the reader credential the world currently provides.
fn mtcollins1_boot_branch_route_refusal_cause() -> NonEmptyStr? {
  mtcollins1_boot_branch_route_refusal_cause_with(reader: mtcollins1_boot_branch_reader_grant())
}

// THE SAME BUILDER, ASKED ABOUT A READER CREDENTIAL IT MAY OR MAY NOT BE GIVEN. Everything else about the
// route -- pool, provider, pins, account, role -- is identical in both states, so the ONLY thing the mint
// changes is whether this returns a federation at all. That is the property the witnesses assert: pass a
// minted reader grant and you get the post-mint shape (exactly two cells, the fleet key absent); pass none,
// which is what mtcollins1_boot_branch_federation does today, and you get nothing.
fn mtcollins1_boot_branch_federation_with(reader: SecretAccessGrant?) -> DedicatedFederation? {
  match mtcollins1_boot_branch_route_refusal_cause_with(reader: reader) {
    Present { value: _ } => none
    // THE BOOT IS PROVISIONED HERE BY CONSTRUCTION: the refusal function above returns "unprovisioned" for
    // exactly this standing, so reaching the Absent arm below would mean the two reads of the standing
    // disagreed. It answers none rather than panicking, so a disagreement cannot manufacture a federation.
    Absent => match provisioned_federation_of(s: boot_federation_for(host: operator_host_mtcollins1)) {
      Absent => none
      Present { value: boot } =>
      Present { value: DedicatedFederation {
          label: "mtcollins1 boot from a trusted gunbc branch (approval-free, per the operator rulings 2026-10-22/23)",
          pool_id: mtcollins1_boot_branch_wif_pool_id,
          pool_display_name: mtcollins1_boot_branch_wif_pool_display_name,
          provider_id: mtcollins1_boot_branch_wif_provider_id,
          attribute_mapping: mtcollins1_boot_branch_attribute_mapping,
          attribute_condition: mtcollins1_boot_branch_attribute_condition(),
          // THE ARM'S ONLY FIELD, and that is the whole point of it: the binding's ROLE is fixed by
          // standing_impersonation_cell, so a federation cannot widen what its pool may impersonate.
          impersonation: StandingPoolImpersonation {
            principal_set: mtcollins1_boot_branch_principal_set(),
          },
          service_account: mtcollins1_boot_branch_service_account,
          service_account_id: mtcollins1_boot_branch_service_account_id,
          service_account_display_name: "Mt. Collins boot from a trusted branch (WIF-only, no keys)",
          service_account_member: federated_service_account_member(email: mtcollins1_boot_branch_service_account),
          // NOT f.secret_grants. The boot federation carries TWO cells (managed_host_boot_federation
          // admit_boot_federation:171-174): this host's pinned BMC credential AND
          // fleet_automation_ssh_privkey_secret. The fleet key is FLEET-WIDE -- one private key that
          // authenticates to every enrolled host -- and the main boot identity earns it because the
          // reviewed main job uses it for the census served-medium readback (mtcollins1_boot_run:2577,
          // 3231 -> boot_medium_served_readback, over ssh to the store host). This route has no reviewed
          // job text behind it: a rostered branch is the author of its own fleet-converge.yml. Handing
          // the same key to an identity that unreviewed code can federate at will converts "anyone with
          // branch push can cycle mtcollins1's power" (which the operator ruled) into "anyone with branch
          // push can SSH into the whole fleet as the automation principal" (which nobody ruled, and which
          // DESIGN.md section 4b rung honesty would call reach inflation if the census called it narrow).
          // So the account holds EXACTLY what a boot of this one host needs, and the readback that needs
          // ssh goes over the forced-command reader key instead -- see
          // mtcollins1_boot_branch_secret_grants.
          // THE SAME LIST THE GUARD ABOVE TESTED: one computation decides both whether the route exists and
          // what it holds, so the guard cannot be satisfied by a different set than the one converged.
          // THE SAME LIST THE REFUSAL ABOVE TESTED: one computation decides both whether the route exists
          // and what it holds, so the guard cannot be satisfied by a set other than the one converged.
          secret_grants: mtcollins1_boot_branch_secret_grants_with(f: boot, reader: reader),
        } }
    }
  }
}

// ── THE BRANCH ACCOUNT'S POLICY: TWO CELLS, OR THE ROUTE DOES NOT EXIST ──────────────────────
// WHY THE MIRROR WAS A DEFECT. The boot federation carries TWO cells (this module's own source,
// managed_host_boot_federation admit_boot_federation:171-174): this host's pinned BMC credential AND
// fleet_automation_ssh_privkey_secret. That second cell is FLEET-WIDE -- one private key that
// authenticates as the automation principal to every enrolled host, which is why
// gunbc.fleet.fleet_ssh_access models it as the fleet's own credential rather than a host's. The main
// boot identity earns it because the reviewed main boot job uses it for the census served-medium
// readback: mtcollins1_boot_run:2577 and :3231 call boot_medium_served_readback, which ssh's to the
// store host over the agent the job materializes.
//
// Copying f.secret_grants onto the branch account therefore handed an identity that UNREVIEWED CODE can
// federate at will -- a rostered branch authors its own fleet-converge.yml, and the workflow_ref pin is a
// heads-prefix starts_with, not an equality (review 87197) -- the key that opens the fleet. Nobody ruled
// that. The operator's words cover the BMC of ONE machine; they do not cover ssh into every machine.
//
// THE CENSUS ROW WAS WRONG BECAUSE OF IT. branch_boot_credential_effect_approval_free claims
// MintsResourceScopedCredential. A token that unlocks a project-wide-usable ssh key is not
// resource-scoped, so the row recorded a reach narrower than the credential actually minted -- rung
// inflation in DESIGN.md section 4b's exact sense ("the reported rung equals the rung established by
// executed evidence"; "rung inflation is worse than sitting low"). Narrowing the policy is what makes the
// row true again; the row is not being re-labelled to match a wider account.
data mtcollins1_boot_branch_bmc_secret_id: NonEmptyStr = "bmc-mtcollins1-gunbc"

// THE BMC CELL, TAKEN FROM THE ADMITTED BOOT FEDERATION RATHER THAN RE-DERIVED: the same secret, the
// same pinned version, the same version-condition expression. One pin, two identities -- a rotation moves
// both together and a branch boot cannot read an unpinned or older version.
//
// Matched BY SECRET ID, never by position. An index-0 grab would be a silent fleet-key handover the first
// time someone reorders the boot federation's cells, which is the failure mode this whole section exists
// to close.
fn mtcollins1_boot_branch_bmc_grant(f: ManagedHostBootFederation) -> SecretAccessGrant? {
  let bmc = filter(f.secret_grants, g => g.target.secret == mtcollins1_boot_branch_bmc_secret_id)
  match bmc.first() {
    Present { value: g } => Present { value: g }
    Absent => none
  }
}

// READ OVER THE READER KEY, NOT THE FLEET KEY -- AND THE CORPUS ASKED FOR THIS FIRST.
// gunbc.host.boot_medium_served_readback:269-272 already names this change: "the branch account narrowed
// to the BMC credential and THIS KEY -- which is the third change of the mtcollins1 approval-free branch
// boot plan (work item adhoc-0abea207-7ec)". The reader key is forced-command to one sha256sum of one
// served-link path, with no agent forwarding, no pty and no port forwarding
// (boot_medium_reader_key.boot_medium_reader_restrictions): on the store host it can read the digest of
// one path, which is exactly what the readback needs and nothing more.
//
// IT IS NOT MINTED YET, AND THE ROUTE REFUSES FOR THAT REASON, NOT DESPITE IT.
// boot_medium_reader_ssh_key is none and boot_medium_reader_ssh_privkey_secret is version "pending"; the
// module says so in its own header (boot_medium_reader_key:31-34): "until then there is no authorized
// entry to converge and no readback over this key, and both refuse by that name rather than fall back to
// the fleet key." Minting it is a wet action through the approval route -- not mine to take.
//
// WHY NOT JUST GIVE IT THE BMC CELL AND LET THE READBACK FAIL? It would fail closed (remote_answer_of
// yields exit 255 -> boot_medium_served_refusal_before_attach, media attach and power untouched), so
// nothing unsound would happen -- but the model would be advertising an approval-free boot that cannot
// complete, and a capability that is advertised and then refused at the evidence step is the same
// dishonesty as a rung reported above its evidence. Refusing at SELECTION, with a named cause, before any
// runner is occupied, is the honest shape.
fn mtcollins1_boot_branch_reader_grant() -> SecretAccessGrant? {
  match boot_medium_reader_ssh_key {
    Absent => none
    Present { value: _ } =>
      if boot_medium_reader_ssh_privkey_secret.version == "pending" {
        none
      } else {
        Present { value: secret_accessor_grant(target: boot_medium_reader_ssh_privkey_secret) }
      }
  }
}

// BOTH CELLS OR NO ROUTE. Neither cell is optional, so there is no reachable state in which the branch
// identity exists with a SUBSET of this policy -- a partially-provisioned policy is how an account ends up
// holding a credential nobody accounted for, or booting without the evidence it claims to have. An empty
// list makes mtcollins1_boot_branch_federation return none, which drops the route from
// gunbc.auth.gcp_iam_converge_targets entirely: no pool, no provider, no service account, and
// boot_credential_source_from_branch_selection refuses by name. Nothing is created half-way.
// THE LAW, WITH THE READER CREDENTIAL AS AN INPUT. The reader standing is a parameter rather than a
// global read so BOTH sides of this law are assertable: today, with the key unminted, and after #15329
// converges the mint. mtcollins1_boot_branch_secret_grants below is the only caller that matters -- it
// feeds the real standing in -- and the witnesses pass a standing they construct. A law that can only be
// evaluated in the state the world happens to be in is a law that cannot be tested at its boundary.
fn mtcollins1_boot_branch_secret_grants_with(f: ManagedHostBootFederation, reader: SecretAccessGrant?) -> List<SecretAccessGrant> {
  match mtcollins1_boot_branch_bmc_grant(f: f) {
    Absent => []
    Present { value: bmc } => match reader {
      Absent => []
      Present { value: r } => [bmc, r]
    }
  }
}

fn mtcollins1_boot_branch_secret_grants(f: ManagedHostBootFederation) -> List<SecretAccessGrant> {
  mtcollins1_boot_branch_secret_grants_with(f: f, reader: mtcollins1_boot_branch_reader_grant())
}

// WHY THE POLICY IS NARROWER THAN THE BOOT'S, AS A PREDICATE THE WITNESSES CAN ASK. The fleet key must be
// ABSENT from the branch account's cells while PRESENT in the boot's -- so if a refactor re-mirrors
// f.secret_grants, or someone "helpfully" adds the fleet key because the main boot has it, this fails
// instead of converging.
fn mtcollins1_boot_branch_policy_excludes_the_fleet_key(f: ManagedHostBootFederation) -> Bool {
  let branch_secrets = map(mtcollins1_boot_branch_secret_grants(f: f), g => g.target.secret as String)
  let boot_secrets = map(f.secret_grants, g => g.target.secret as String)
  !any(branch_secrets, sec => sec == (fleet_automation_ssh_privkey_secret.secret as String))
    && any(boot_secrets, sec => sec == (fleet_automation_ssh_privkey_secret.secret as String))
    && all(branch_secrets, sec => sec == (mtcollins1_boot_branch_bmc_secret_id as String)
      || sec == (boot_medium_reader_ssh_privkey_secret.secret as String))
}

// THE ROUTE IS CLOSED UNTIL THE READER KEY EXISTS. True today, because the keypair is unminted; a witness
// asserts it so that the closure is a stated property and not an accident, and so that minting the key is
// the ONLY thing that can open the route.
fn mtcollins1_boot_branch_route_is_closed_until_the_reader_key_is_minted() -> Bool {
  match mtcollins1_boot_branch_federation() {
    Absent => true
    Present { value: _ } =>
      boot_medium_reader_ssh_key != none
        && boot_medium_reader_ssh_privkey_secret.version != "pending"
  }
}

fn first_trusted_branch() -> String {
  match mtcollins1_boot_trusted_branches.first() {
    Present { value: b } => b as String
    Absent => ""
  }
}

fn mtcollins1_boot_branch_federations() -> List<DedicatedFederation> {
  match mtcollins1_boot_branch_federation() {
    Present { value: f } => [f]
    Absent => []
  }
}
