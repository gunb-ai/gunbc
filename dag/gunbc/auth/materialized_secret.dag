module gunbc.auth.materialized_secret

import std.types { String, NonEmptyStr, Bool, Int, List, Secret, FilePath }
import std.upsert_decision { ObservationVerdict, Converged, Drifted, Conflict, Inaccessible, UnknownRefused }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration, decl_ref }
import extdeps.cloud.gcp.secret_ref { SecretRef }
import extdeps.cloud.gcp.secret_manager { SmVersionState, SmEnabled, SmDisabled, SmDestroyed }
import extdeps.shell
import gunbc.readback_independence {
  ReadBackProbe,
  ProbeInert,
  ProbeMayEstablish,
  readback_evidence_verdict,
  readback_probe_is_independent,
}
import gunbc.host.host_phase_status { observation_verdict_eq, host_phase_verdict_from }

// A1's authority — the lifecycle that turns a SecretRef into a usable credential and takes it away
// again. What the model carried before this was the two ENDS and not the middle:
// extdeps.cloud.gcp.secret_ref.SecretRef names a secret,
// gunbc.auth.secret_ref_credential.fetch_secret_ref_credential fetches its bytes, and everything
// between those two — bind the bytes to the transport that needs them (an ssh -i keyfile, an env
// var, a password on stdin), keep them 0600 and scoped, and destroy them afterwards — was performed
// by hand for every credential in the srv4 subsumption session. Hand-performed steps are where the
// fleet's credential incidents come from, and the shape of the fix is not a helper that does those
// steps: it is making the UNSCOPED state unwritable. So the production constructor of a
// MaterializedSecret is with_materialized_secret, which takes the use as a FUNCTION and returns
// that function's result — never the handle (the only other one is the caller-sealed widen sketch
// below, the red control's specimen). The bracket itself never yields a handle, and it touches no
// bytes: it checks the existence and liveness facts it is given and calls `use`. Writing the bytes
// and shredding them after the body returns belong to the binding leg that places them --
// gunbc.auth.private_secret_file with_private_secret_file for the file bindings; StdinPassword is
// realized by a transport row that takes the secret on stdin (extdeps.bmc.http SetAccountPassword);
// EnvVar is still on the scaffold frontier -- so the plan's 'shred is by construction (the handle
// drop), not a remembered step' holds today for the file legs only. What the bracket does NOT yet establish is that `use`
// cannot hand the handle back out: see the residuals on the construction wall below. Note what the handle deliberately does
// NOT carry: a path field. A transport that could read a temp path off the handle would make the
// raw path reachable again, and the plan's own RED is exactly 'a transport handed a raw temp path
// (not a MaterializedSecret handle) reds'.

// The three bindings are the three the srv4 session actually performed by hand, taken from the A1
// gap row verbatim rather than generalized ahead of a consumer. They are separate variants and not
// one 'path' because the transport contract differs in kind: SshKeyFile must be a 0600 file on disk
// (ssh refuses a loose-permissioned key, so the mode is part of the binding's meaning), EnvVar
// never touches disk and carries a name the child process reads, StdinPassword never persists at
// all. Collapsing them to a path would force the two non-file bindings to invent a file, which is
// how a secret ends up on disk that never needed to be there.

// BearerHeaderFile is the fourth binding, added by the first consumer that performs it (the hosted harness
// route, gunbc.harness.harness_hosted_route): an HTTP API whose credential rides one
// "Authorization: Bearer" header line in a 0600 file that curl reads with -H @file. It is a file for the
// same reason SshKeyFile is -- the transport reads a path -- and it is not SshKeyFile because the bytes
// are a header line, not a key, and nothing about ssh's permission check applies to it.
type SecretBinding
  = SshKeyFile
  | EnvVar { name: NonEmptyStr }
  | StdinPassword
  | BearerHeaderFile

type MaterializedSecret sole_constructor {
  ref: SecretRef
  binding: SecretBinding
}

type MaterializationRefusal
  = SecretNotLive { verdict: ObservationVerdict }
  | SecretVersionUnusable { state: SmVersionState }
  | LivenessProbeNotIndependent { probe_label: NonEmptyStr }

type MaterializationOutcome<R>
  = MaterializationCompleted { value: R }
  | MaterializationRefused { cause: MaterializationRefusal }

// A3, and it is A1's first slice rather than a separate probe module because liveness is a fact
// about a materialization, not about a secret sitting still. The incident it comes from: Secret
// Manager held ci-github-app-private-key at SmEnabled while the key it contained (fingerprint
// 0c7a15...) had been DELETED from the GitHub App, and the live key (64a8af...) existed only on the
// hosts. Every existence check the model could perform said yes. srv4's runner registration then
// 401'd, and the divergence was diagnosed and reconciled by hand. SmEnabled answers 'this version
// exists and is not disabled' — a fact about the STORE — and the question that matters is whether
// the upstream that consumes the credential still accepts it. Those are different questions and the
// first was standing in for the second, which is the same presupposition failure
// gunbc.host.host_swap_backing found in the swap cap: a value reported green because the condition under
// which it would MEAN something was assumed rather than observed.

fn secret_existence_verdict(state: SmVersionState) -> ObservationVerdict {
  match state {
    SmEnabled => Converged
    SmDisabled => std.upsert_decision.Drifted
    SmDestroyed => std.upsert_decision.Absent
  }
}

// Liveness DOMINATES existence, asymmetrically, exactly as observed swap backing dominates a
// MemorySwapMax cap. An enabled version whose key upstream rejects is not a usable credential, and
// an enabled version nobody has probed is not KNOWN to be one — so the qualified verdict is
// Converged only when both agree, and every other liveness state passes through in place of the
// existence answer. The arm that matters most is the unprobed one: with no liveness observation the
// qualified verdict is UnknownRefused, never Converged. That is the arm that would have stopped the
// srv4 401 before any host was touched, because the model's existence check was green throughout
// the incident and would have stayed green under any amount of care.

fn secret_liveness_qualified_verdict(
  existence: ObservationVerdict,
  liveness: ObservationVerdict,
) -> ObservationVerdict {
  match liveness {
    Converged => existence
    std.upsert_decision.Absent => std.upsert_decision.Absent
    std.upsert_decision.Drifted => std.upsert_decision.Drifted
    Conflict => Conflict
    Inaccessible => Inaccessible
    UnknownRefused => UnknownRefused
  }
}

// The liveness probe, classified under the read-back independence criterion rather than trusted.
// Minting a GitHub App installation token with the key is read-only against the subject: it asks
// GitHub whether this key is accepted and cannot MAKE a revoked key accepted, so it is ProbeInert
// and its Converged survives. The classification is doing real work even though it passes today,
// because the tempting shape for a liveness check is exactly the one that would fail it — a probe
// that repairs on miss (rotate the key, add a new version, re-register the app) reports success it
// caused, and the hand reconciliation this gap row describes was precisely that repair performed by
// a human. A probe that both diagnoses and repairs cannot be the thing that certifies the
// diagnosis.

data github_app_jwt_mint_probe: ReadBackProbe = ReadBackProbe {
  label: "mint a GitHub App installation token with the SecretRef's private key",
  subject: "the private key this SecretRef holds is the one GitHub currently accepts",
  effect_on_subject: ProbeInert,
}

data liveness_self_repairing_probe_sketch: ReadBackProbe = ReadBackProbe {
  label: "mint a token, adding a fresh key version on failure",
  subject: "the private key this SecretRef holds is the one GitHub currently accepts",
  effect_on_subject: ProbeMayEstablish {
    mechanism: "the repair arm rotates the key it is testing, so a Converged result may report the version the probe itself just wrote — the hand reconciliation of the srv4 incident, automated",
  },
}

fn secret_ref_liveness_verdict(
  probe: ReadBackProbe,
  observed: ObservationVerdict?,
) -> ObservationVerdict {
  readback_evidence_verdict(p: probe, observed: host_phase_verdict_from(observation: observed))
}

// THE construction wall. MaterializedSecret is sole_constructor, so a record literal or cast of it
// outside this module is a located compile refusal (SoleConstructorViolation), and the two
// constructions that remain are both in this file: this bracket, and the widen sketch below, which
// admit_callers seals to the one red-control witness that executes it. The bracket hands the value
// to `use` rather than returning it. The refusal arm carries no handle at all, which is the same
// EffectsOrRefusal shape the runner-host enrollment wall uses: a refused materialization cannot be
// accidentally treated as a successful one, because it has nothing to treat. The three refusal
// causes stay separate because their remedies are different work: SecretNotLive is a credential to
// reconcile with its upstream, SecretVersionUnusable is a store state to fix,
// LivenessProbeNotIndependent is a probe to replace.
// WHAT THE SEAL ESTABLISHES, AND ON WHICH ROUTE: native v2 refuses foreign construction via
// v2.compiler.infer infer_sole_constructor_diags (literal, cast, sealed variant, parameter
// default). The seed refuses literal and cast (src/v1/04_infer.dag
// sole_constructor_construction_diags, at declaring-file grain) and still misses coproduct
// variants (f13) and parameter defaults (f19). Witnessed by
// test.claim.materialized_secret_seal_witness.
// HONEST RESIDUALS, each with the capability that closes it:
// (1) EGRESS. `use` is fn(MaterializedSecret) -> R with R unconstrained, so R = MaterializedSecret
// returns the handle out of the bracket. The handle carries no bytes and no path, so what escapes is
// a descriptor, not the secret — but 'no expression a caller can write holds it afterwards' is not
// true yet. Closes when a scope rule refuses a bracket result type that mentions the handle.
// (2) PARAMETER-DEFAULT CONSTRUCTION ON THE SEED. Native v2 walks BinderDefaultEdge in
// infer_sole_constructor_diags. The seed still does not reach the check for a record literal in
// a parameter-default position (test.claim.sole_constructor_completeness_audit_probe f19).
// Closes when the seed construction judgment covers every introduction form.

fn with_materialized_secret<R>(
  ref: SecretRef,
  binding: SecretBinding,
  existence: SmVersionState,
  probe: ReadBackProbe,
  liveness_observation: ObservationVerdict?,
  use: fn(MaterializedSecret) -> R,
) -> MaterializationOutcome<R> {
  if !readback_probe_is_independent(p: probe) {
    MaterializationRefused {
      cause: LivenessProbeNotIndependent { probe_label: probe.label },
    }
  } else {
    if !observation_verdict_eq(a: secret_existence_verdict(state: existence), b: Converged) {
      MaterializationRefused { cause: SecretVersionUnusable { state: existence } }
    } else {
      let liveness = secret_ref_liveness_verdict(probe: probe, observed: liveness_observation)
      if observation_verdict_eq(a: liveness, b: Converged) {
        MaterializationCompleted {
          value: use(MaterializedSecret { ref: ref, binding: binding }),
        }
      } else {
        MaterializationRefused { cause: SecretNotLive { verdict: liveness } }
      }
    }
  }
}

// CORRECTION, found in review (review 42890) and it is an instance of this module's own subject
// matter turned on itself. The bracket originally folded existence and liveness into ONE qualified
// verdict and then refused with SecretNotLive whatever came out — so SecretVersionUnusable was
// declared and unreachable on the authority path, and two refusals with different remedies
// collapsed onto one shape: a destroyed store version and an upstream-revoked key both emerged as
// SecretNotLive { verdict: Absent }. The note two declarations above claimed the three causes stay
// separate BECAUSE their remedies are different work, and the code did not do it — the claim was
// true about the type and false about the fold. The destroyed-version witness did not catch it
// because it only asserted that materialization refused, never which cause it named, which is the
// same weak assertion this lane keeps warning about in other people's tests. The axes are now
// dispatched in order: the STORE axis first, because a version that is disabled or destroyed is
// unusable whatever any probe says about the key it used to hold, and only then the UPSTREAM axis.
// secret_liveness_qualified_verdict survives as the combined-STATUS authority for cell consumers
// that want one verdict; it is no longer what decides a materialization, because a status verdict
// and a refusal cause answer different questions.

// The forbidden arm as an executable declaration: materialize whenever the store says the version
// exists, which is what every hand-run credential step in the srv4 session effectively did. It is
// not a strawman — it is the behaviour that produced the 401, written down so a gate can reject it
// and so the authority's refusal is proven to be a decision rather than a coincidence. Because it
// mints the same sealed handle from existence alone, it is a second constructor: admit_callers
// seals it to the one witness that executes it as a red control, so no production module can
// reach it.

fn materialize_existence_only_widen_sketch<R>(
  ref: SecretRef,
  binding: SecretBinding,
  existence: SmVersionState,
  use: fn(MaterializedSecret) -> R,
) -> MaterializationOutcome<R>
  admit_callers: [
    decl_ref(module_path: "test.claim.materialized_secret", decl_name: "witness_red_control_existence_only_rejected_by_gate"),
  ]
{
  if observation_verdict_eq(a: secret_existence_verdict(state: existence), b: Converged) {
    MaterializationCompleted {
      value: use(MaterializedSecret { ref: ref, binding: binding }),
    }
  } else {
    MaterializationRefused { cause: SecretVersionUnusable { state: existence } }
  }
}

fn materialization_completed<R>(outcome: MaterializationOutcome<R>) -> Bool {
  match outcome {
    MaterializationCompleted { value: _ } => true
    MaterializationRefused { cause: _ } => false
  }
}

fn materialization_gate_accepts<R>(
  outcome: MaterializationOutcome<R>,
  liveness: ObservationVerdict,
) -> Bool {
  if observation_verdict_eq(a: liveness, b: Converged) {
    true
  } else {
    !materialization_completed(outcome: outcome)
  }
}

data materialized_secret_binding_realization_note: String = "SshKeyFile binding leg LANDED (2026-08-13, SECRETREF-WIRE-0 stop-the-line), and its mechanics moved (2026-10-25) to gunbc.auth.private_secret_file with_private_secret_file: bytes written through Filesystem.WriteOwnerOnly (mode 0600 at creation, O_EXCL, not write-then-chmod) in a fresh 0700 directory per call (under RUNNER_TEMP when set, else mktemp -d), never under worktree target/, and the file removed with rm -f and the directory with rmdir after the bracket body returns, on every arm, with a typed residue arm when either removal fails. StdinPassword has its first realization at the Redfish boundary: extdeps.bmc.http SetAccountPassword and CreateAccount take the password-bearing body as `request_body: Secret` bound to the operation's `stdin:`, so no file exists; that is the binding realized by the transport row, not yet a with_materialized_secret leg. EnvVar remains on the scaffold frontier; the full with_materialized_secret liveness bracket is unchanged."

fn trim_nonempty_file_path(raw: String) -> FilePath? {
  let trimmed = raw.trim()
  if trimmed == "" {
    none
  } else {
    Present { value: trimmed as FilePath }
  }
}

fn private_scoped_materialization_root() -> FilePath? {
  match shell.Env.Get(name: "RUNNER_TEMP" as NonEmptyStr).value {
    Present { value: runner_temp } => trim_nonempty_file_path(raw: runner_temp)
    Absent => {
      let created = shell.Mktemp.Dir()
      if created.success {
        trim_nonempty_file_path(raw: created.path as String)
      } else {
        none
      }
    }
  }
}

fn gunbc_private_materialization_dir(root: FilePath) -> FilePath {
  concat(root as String, "/gunbc-private") as FilePath
}

fn ensure_gunbc_private_materialization_dir(root: FilePath) -> Bool {
  let private_dir = gunbc_private_materialization_dir(root: root)
  let made = shell.Mkdir.Parents(path: private_dir)
  if made.success == false {
    false
  } else {
    shell.Chmod.OwnerOnlyDirectory(path: private_dir).success
  }
}

// THE FILE LEG OF EVERY FILE BINDING (SshKeyFile, BearerHeaderFile) IS gunbc.auth.private_secret_file
// with_private_secret_file. with_materialized_ssh_key_file stood here and was moved out, not copied:
// it was one of three realizations of one rule (owner-only file in a private directory, removed on
// every arm), and this module's closure is too heavy to be the shared home (see the note in
// private_secret_file). The root helpers above remain because gunbc.fleet.printer_project_delivery
// realizes a non-secret payload under them.

// A1 lands on top of a declared scaffold and says so: authenticating to Secret Manager at all
// currently depends on an access token the operator pastes by hand roughly hourly, because no
// modeled workflow identity can reach the store. That is A2 (reach-secrets ADC), already a
// DeclaredGap in host_standup P0:reach-secrets-network and in fleet_ssh_access. This lane does not
// smuggle a fix for it — the fetch leg simply inherits whatever credential is live — and A1's
// dependence on it is recorded here so that the day A2 lands, the thing to delete is a named row
// rather than an assumption nobody wrote down.

// What is modeled in this module is the LIFECYCLE and its refusals. The
// fetch leg already exists as
// gunbc.auth.secret_ref_credential.fetch_secret_ref_credential over the
// extdeps.cloud.gcp.secret_manager AccessVersion operation — this module
// does not re-model it. The SshKeyFile binding leg LANDED 2026-08-13 and
// its mechanics now live in gunbc.auth.private_secret_file
// with_private_secret_file; mechanism and receipt live in
// materialized_secret_binding_realization_note. STILL FRONTIER: EnvVar, and
// StdinPassword as a typed host-effect bracket — and the
// liveness OBSERVATION: no GitHub App token-mint producer runs in this
// tree, so with_materialized_secret with liveness_observation none
// REFUSES UnknownRefused. That refusal is deliberate and loud;
// materializing on store existence alone is the incident this lane
// refuses.
//
// WHO THIS SCAFFOLD'S FRONTIER IS FOR, named because leaving it unnamed
// already cost a session real work: this dissolve target (bind
// gunbc.host.host_effect HostEffectTransport) fits the SshKeyFile leg because
// its only live consumer, gunbc.spark_credential_workflow
// run_with_materialized_fleet_ssh_binding, feeds the materialized binding
// into gunbc.fleet.fleet_known_hosts_anchor fleet_ssh_execution_context_of and
// from there into HostEffectTransport.FleetSsh's context field — a real,
// wired path that authenticates a transport TO a fleet
// gunbc.fleet.fleet_intent.ComputeHost, exactly the subject HostEffectTransport
// is built for (per gunbc.plans.fleet_subsumption_manual_gaps: "every
// fleet transport that needs a secret (ssh, sudo, ipmitool, scp-of-key)
// consumes a MaterializedSecret"). EnvVar and StdinPassword inherit that
// same population and no other: a caller materializing a credential to
// authenticate sudo, ipmitool, or scp-of-key against an enrolled
// ComputeHost. They are NOT the answer to a runner-local, job-scoped
// materialization — a GitHub Actions runner keeping a secret file or
// agent alive across several steps of its own job, authenticating nothing
// about a fleet host. That case cannot bind to HostEffectTransport at
// all: gunbc.host.host_effect HostEffectIntent.target is a NodeControlPlane,
// and both fleet-addressed NodeControlPlane arms (HostOs, BmcController) require a
// gunbc.fleet.fleet_intent.ComputeHost — a full enrolled hardware identity a
// transient runner does not have and should not fabricate.
// RunnerLocalHost now provides an honest target only for effects explicitly modeled as
// runner-local; it does not make fleet-targeted secret materialization admissible.
// gunbc.ci.ci_deploy_target_host already refuses the identical conflation for LocalShell apply
// ("runner identity does not prove target host"). A
// future EnvVar or StdinPassword binding written to solve that case would
// materialize correctly and then have nowhere honest to dissolve to — the
// module would look reused when the subject had actually changed
// underneath it.
data materialized_secret_binding_realization_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.host.host_effect",
    decl_name: "HostEffectTransport",
    field: WholeDeclaration,
  }
}
