module gunbc.auth.approval_request_client

import std.types { Bool, NonEmptyStr, String, Timestamp, Secret }
import std.scoped_authorization { AuthorizationRequest }
import extdeps.crypto.mac {
  MacKey, MacSigned, MacKeyMaterialNotHex, HmacSha256, MacKeyId,
}
import gunbc.auth.approval_capability { utc_instant_is_canonical }
import gunbc.auth.approval_decision_store {
  StoredApprovalRequest, request_revision_of, approval_mac_key_id,
}
import gunbc.auth.approval_request_submission {
  approval_submission_mac_key_id, sign_submission,
}
import gunbc.fleet_posix_accounts { fleet_operator_email }
import gunbc.roadmap_dashboard_instance { srv1_live_dashboard_instance }

data approval_request_submit_path: NonEmptyStr = "/approvals"

fn approval_loopback_origin() -> NonEmptyStr {
  let instance = srv1_live_dashboard_instance()
  concat(
    concat("http://", instance.listen_host as String),
    concat(":", to_string(instance.listen_port)),
  ) as NonEmptyStr
}

fn approval_submit_url() -> NonEmptyStr {
  concat(approval_loopback_origin() as String, approval_request_submit_path as String) as NonEmptyStr
}

fn approval_status_url(escalation_id: NonEmptyStr) -> NonEmptyStr {
  concat(
    concat(approval_loopback_origin() as String, concat(approval_request_submit_path as String, "/")),
    escalation_id as String,
  ) as NonEmptyStr
}

fn stored_request_from_authorization<Subject>(
  request: AuthorizationRequest<Subject>,
  issued_at: Timestamp,
  expires_at: Timestamp,
) -> StoredApprovalRequest {
  StoredApprovalRequest {
    escalation_id: request.escalation_id,
    request_revision: request_revision_of(request: request),
    attempt: request.attempt,
    requester: fleet_operator_email,
    purpose: request.purpose,
    destructive: request.destructive,
    issued_at: issued_at,
    expires_at: expires_at,
    key_id: approval_mac_key_id,
  }
}

type SubmissionMac
  = SubmissionMacReady { tag_hex: NonEmptyStr }
  | SubmissionMacKeyNotHex { key_id: MacKeyId }

fn sign_stored_request(key_material: String, request: StoredApprovalRequest) -> SubmissionMac {
  let key = MacKey {
    id: approval_submission_mac_key_id,
    suite: HmacSha256,
    material: key_material as Secret,
  }
  match sign_submission(key: key, request: request) {
    MacKeyMaterialNotHex { key_id: k } => SubmissionMacKeyNotHex { key_id: k }
    MacSigned { tag: t } => SubmissionMacReady { tag_hex: t.hex }
  }
}

fn kv_line_value(body: String, key: String) -> String {
  let prefix = concat(key, "=")
  fold(body.split(delimiter: "\n"), init: "", f: (acc, line) =>
    if starts_with(s: line, prefix: prefix) {
      substring(s: line, start: prefix.length(), end: line.length())
    } else {
      acc
    }
  )
}

fn kv_required_instant(body: String, key: String) -> String {
  let v = kv_line_value(body: body, key: key)
  if utc_instant_is_canonical(t: v as Timestamp) {
    v
  } else {
    ""
  }
}

type FiledApprovalStatus
  = StatusNotFiled
  | StatusPending { expires_at: Timestamp }
  | StatusApproved {
      revision: NonEmptyStr
      decided_by: NonEmptyStr
      decided_at: Timestamp
      execute_by: Timestamp
    }
  | StatusDenied {
      revision: NonEmptyStr
      decided_by: NonEmptyStr
      decided_at: Timestamp
      reason: NonEmptyStr
    }
  | StatusUnreadable { detail: NonEmptyStr }

type ApprovalPollStanding
  = PollStillPending
  | PollApproved {
      revision: NonEmptyStr
      decided_by: NonEmptyStr
      decided_at: Timestamp
      execute_by: Timestamp
    }
  | PollDenied {
      revision: NonEmptyStr
      decided_by: NonEmptyStr
      decided_at: Timestamp
      reason: NonEmptyStr
    }
  | PollExpired
  | PollNotFiled
  | PollUnreadable { detail: NonEmptyStr }

fn approval_poll_standing(
  status: FiledApprovalStatus,
  observed_at: Timestamp,
  expires_at: Timestamp,
) -> ApprovalPollStanding {
  if observed_at > expires_at {
    match status {
      StatusApproved { revision: r, decided_by: by, decided_at: at, execute_by: until } =>
        PollApproved { revision: r, decided_by: by, decided_at: at, execute_by: until }
      StatusDenied { revision: r, decided_by: by, decided_at: at, reason: why } =>
        PollDenied { revision: r, decided_by: by, decided_at: at, reason: why }
      StatusUnreadable { detail: d } => PollUnreadable { detail: d }
      _ => PollExpired
    }
  } else {
    match status {
      StatusNotFiled => PollNotFiled
      StatusPending { expires_at: _ } => PollStillPending
      StatusApproved { revision: r, decided_by: by, decided_at: at, execute_by: until } =>
        PollApproved { revision: r, decided_by: by, decided_at: at, execute_by: until }
      StatusDenied { revision: r, decided_by: by, decided_at: at, reason: why } =>
        PollDenied { revision: r, decided_by: by, decided_at: at, reason: why }
      StatusUnreadable { detail: d } => PollUnreadable { detail: d }
    }
  }
}

fn parse_filed_approval_status(body: String) -> FiledApprovalStatus {
  let standing = kv_line_value(body: body, key: "standing")
  if standing == "not-filed" {
    StatusNotFiled
  } else if standing == "pending" {
    let expires = kv_required_instant(body: body, key: "expires_at")
    if expires == "" {
      StatusUnreadable { detail: "pending standing is missing a canonical expires_at" as NonEmptyStr }
    } else {
      StatusPending { expires_at: expires as Timestamp }
    }
  } else if standing == "approved" {
    let revision = kv_line_value(body: body, key: "revision")
    let decided_by = kv_line_value(body: body, key: "decided_by")
    let decided_at = kv_required_instant(body: body, key: "decided_at")
    let execute_by = kv_required_instant(body: body, key: "execute_by")
    if revision == "" || decided_by == "" || decided_at == "" || execute_by == "" {
      StatusUnreadable { detail: "approved standing is missing revision, decided_by, decided_at, or execute_by" as NonEmptyStr }
    } else {
      StatusApproved {
        revision: revision as NonEmptyStr,
        decided_by: decided_by as NonEmptyStr,
        decided_at: decided_at as Timestamp,
        execute_by: execute_by as Timestamp,
      }
    }
  } else if standing == "denied" {
    let revision = kv_line_value(body: body, key: "revision")
    let decided_by = kv_line_value(body: body, key: "decided_by")
    let decided_at = kv_required_instant(body: body, key: "decided_at")
    let reason = kv_line_value(body: body, key: "reason")
    if revision == "" || decided_by == "" || decided_at == "" || reason == "" {
      StatusUnreadable { detail: "denied standing is missing revision, decided_by, decided_at, or reason" as NonEmptyStr }
    } else {
      StatusDenied {
        revision: revision as NonEmptyStr,
        decided_by: decided_by as NonEmptyStr,
        decided_at: decided_at as Timestamp,
        reason: reason as NonEmptyStr,
      }
    }
  } else if standing == "unreadable" {
    let detail = kv_line_value(body: body, key: "detail")
    if detail == "" {
      StatusUnreadable { detail: "unreadable standing has empty detail" as NonEmptyStr }
    } else {
      StatusUnreadable { detail: detail as NonEmptyStr }
    }
  } else if standing == "" {
    StatusUnreadable { detail: "status text has no standing= line" as NonEmptyStr }
  } else {
    StatusUnreadable { detail: concat("unknown standing: ", standing) as NonEmptyStr }
  }
}

fn approval_post_already_filed(body: String) -> Bool {
  string_contains(s: body, pattern: "already filed")
}

fn approval_post_admits_poll(success: Bool, body: String) -> Bool {
  success || approval_post_already_filed(body: body)
}
