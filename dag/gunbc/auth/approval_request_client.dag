  approval_writer_authority, approval_writer_process, ApprovalServingProcess, RoadmapProcess, BrokerProcess,
}
import gunbc.auth.approval_broker_endpoint {
  approval_broker_loopback_base_url, approval_broker_listen_port, approval_broker_submit_path,
}

// THE CLIENT DIALS THE WRITER, AND WHICH PROCESS THAT IS IS NOT THIS MODULE'S FACT. It used to read
// the roadmap instance's listen bind, which was right while the roadmap held the store and silently
// wrong from the stage-4 posture flip onward: run 37265259209 (gcp_iam_converge, srv1) POSTed to the
// roadmap's port and was refused with a 503 naming the broker as writer. The origin is now derived
// from gunbc.auth.approval_writer_authority -- the same row both serving processes consult before a
// store effect -- so the address a client dials and the process that admits the write cannot
// disagree; the broker's address and paths come from gunbc.auth.approval_broker_endpoint.
data approval_request_submit_path: NonEmptyStr = approval_broker_submit_path

// AND THE WRITER LIVES ON THE PROD-ROLE HOLDER'S DEPLOYMENT (gunbc.deployment_risk
// prod_role_selection). Whichever process the authority row names, it is served by the holder's
// instance -- the roadmap at that instance's listen bind, the broker on that host's loopback -- so both
// arms resolve through gunbc.roadmap.roadmap_dashboard_instance prod_role_realization. Under NoProdRole neither
// is installed anywhere and the origin REFUSES with the realization's typed cause; it never falls back
// to srv1.
// THE ORIGIN CARRIES ITS HOST. A loopback origin means something only on the host it is loopback ON,
// so the resolved arm names the holder instance's host beside the endpoint; dropping it would let an
// executor on another host dial a stale writer there instead of refusing.
type ApprovalLoopbackOrigin
  = ApprovalLoopbackOriginResolved { host: NonEmptyStr, origin: NonEmptyStr }
  | ApprovalLoopbackOriginRefused { cause: ProdRoleRealizationRefusal }

fn approval_loopback_origin_of(instance: HostDashboardInstance) -> NonEmptyStr {
  concat(
    concat("http://", instance.listen_host as String),
    concat(":", to_string(instance.listen_port)),
  ) as NonEmptyStr
}

fn approval_loopback_origin_for(writer: ApprovalServingProcess, realization: ProdRoleRealization) -> ApprovalLoopbackOrigin {
  match realization {
    ProdRoleRealizationRefused { cause } => ApprovalLoopbackOriginRefused { cause: cause }
    ProdRoleRealizedBy { holder } =>
      match writer {
        RoadmapProcess => ApprovalLoopbackOriginResolved { host: holder.instance.host_identity, origin: approval_loopback_origin_of(instance: holder.instance) }
        BrokerProcess => ApprovalLoopbackOriginResolved { host: holder.instance.host_identity, origin: approval_broker_loopback_base_url(port: approval_broker_listen_port) }
      }
  }
}

fn approval_loopback_origin_under(realization: ProdRoleRealization) -> ApprovalLoopbackOrigin {
  approval_loopback_origin_for(writer: approval_writer_process(authority: approval_writer_authority), realization: realization)
}

fn approval_loopback_origin() -> ApprovalLoopbackOrigin {
  approval_loopback_origin_under(realization: prod_role_actuated_realization())
}

fn approval_loopback_origin_refusal_detail(cause: ProdRoleRealizationRefusal) -> NonEmptyStr {
  join(["approval broker origin unresolved: ", prod_role_realization_refusal_detail(cause: cause)], "") as NonEmptyStr
}

// ── THE EXECUTOR MUST BE THE ORIGIN'S HOST, BEFORE ANY LOCAL HTTP ─────────────────────────────
// CLASSIFIER VERSUS CAPABILITY, the split gunbc.live_deploy.role_singleton_convergence uses for its
// admission. classify_approval_origin is pure and fixture-callable and returns a STANDING, never a
// token. The token -- DialableApprovalOrigin, the only thing a URL can be built from -- is minted by
// one sealed function, reachable only from approval_origin_admission_here, which reads this
// executor's own short hostname itself (gunbc.hostname_read, the established local-host read) and
// is in turn sealed to the two effectful approval_gate compositions. So no caller can hand in a
// hostname, and no URL exists for an executor that is not the prod-role holder's host.
type DialableApprovalOrigin sole_constructor {
  host: NonEmptyStr
  origin: NonEmptyStr
}

type ApprovalOriginStanding
  = ApprovalOriginWouldDial { host: NonEmptyStr, origin: NonEmptyStr }
  | ApprovalOriginUnresolved { cause: ProdRoleRealizationRefusal }
  | ApprovalExecutorNotTheOriginHost { origin_host: NonEmptyStr, executor_host: String }
  | ApprovalExecutorHostUnobserved { reason: String }
  | ApprovalOriginHostUnresolved { origin_host: NonEmptyStr, reason: String }

// THE LOOPBACK ORIGIN IS ACTUATED AS A NAME AND THE EXECUTOR ANSWERS AS A NAME, AND NEITHER IS AN
// IDENTITY UNTIL THE ALLOCATION'S SELECTOR SAYS IT IS -- and the join that decides whether the two are
// one machine is the ONE the fleet shares (gunbc.hostname_allocation::observed_host_selector_join), not
// a second copy written here: a generalization beside a surviving leaf is a second path
// (gunbc.design_argument::root_generalization). The old form compared the two strings, so an approval
// request raised on the host that answers "butch" was refused as "not the origin host" forever -- and a
// rename moved the refusal to whichever host inherited the name. The join's refusals are mapped onto this
// file's standings by WHICH SIDE failed: the dispatch's word about the origin host (JoinExpected*) is an
// origin the roster cannot name, and the kernel's answer (JoinObserved*) is an executor nobody observed;
// the dispatch is judged first, as it is at every other site, because a dispatch that names no host has
// no business asking whether this machine is it.
fn classify_approval_origin(origin: ApprovalLoopbackOrigin, executor: HostnameShortCapture) -> ApprovalOriginStanding {
  match origin {
    ApprovalLoopbackOriginRefused { cause } => ApprovalOriginUnresolved { cause: cause }
    ApprovalLoopbackOriginResolved { host, origin: o } =>
      match executor {
        HostnameShortCaptureRefused { reason } => ApprovalExecutorHostUnobserved { reason: reason }
        HostnameShortCaptured { value } =>
          match observed_host_selector_join(expected: host as String, observed: value) {
            ObservedHostSelectorAgreed { host: _ } => ApprovalOriginWouldDial { host: host, origin: o }
            ObservedHostSelectorJoinRefused { cause: c } => approval_origin_refusal_of_join(host: host, cause: c)
          }
      }
  }
}

// WHICH SIDE OF THE JOIN FAILED decides which standing an operator is told about: the two refusals send
// them to different places -- the dispatch that named no such host, or the machine whose answer no roster
// can place.
fn approval_origin_refusal_of_join(host: NonEmptyStr, cause: ObservedHostJoinRefusal) -> ApprovalOriginStanding {
  match cause {
    JoinObservedUnnamed { observed: _ } => ApprovalExecutorHostUnobserved { reason: observed_host_join_refusal_text(cause: cause) }
    JoinObservedAmbiguous { observed: _, candidates: _ } => ApprovalExecutorHostUnobserved { reason: observed_host_join_refusal_text(cause: cause) }
    JoinObservedUnknown { observed: _ } => ApprovalExecutorHostUnobserved { reason: observed_host_join_refusal_text(cause: cause) }
    JoinExpectedUnnamed { expected: _ } => ApprovalOriginHostUnresolved { origin_host: host, reason: observed_host_join_refusal_text(cause: cause) }
    JoinExpectedAmbiguous { expected: _, candidates: _ } => ApprovalOriginHostUnresolved { origin_host: host, reason: observed_host_join_refusal_text(cause: cause) }
    JoinExpectedUnknown { expected: _ } => ApprovalOriginHostUnresolved { origin_host: host, reason: observed_host_join_refusal_text(cause: cause) }
    JoinHostsDisagree { expected: _, observed: answered } =>
      ApprovalExecutorNotTheOriginHost { origin_host: host, executor_host: answered as String }
  }
}

type ApprovalOriginAdmission
  = ApprovalOriginDialable { dial: DialableApprovalOrigin }
  | ApprovalOriginNotAdmitted { standing: ApprovalOriginStanding }

fn mint_dialable_approval_origin(host: NonEmptyStr, origin: NonEmptyStr) -> DialableApprovalOrigin admit_callers: [
  decl_ref(module_path: "gunbc.auth.approval_request_client", decl_name: "approval_origin_admission_here"),
] {
  DialableApprovalOrigin { host: host, origin: origin }
}

// The live admission: the actuated origin against this process's own host, read here and nowhere else.
fn approval_origin_admission_here() -> ApprovalOriginAdmission admit_callers: [
  decl_ref(module_path: "gunbc.auth.approval_gate", decl_name: "approval_standing_read"),
  decl_ref(module_path: "gunbc.auth.approval_gate", decl_name: "approval_file_stored_request"),
] {
  let standing = classify_approval_origin(origin: approval_loopback_origin(), executor: hostname_short_read(transport: LocalShell))
  match standing {
    ApprovalOriginWouldDial { host, origin } => ApprovalOriginDialable { dial: mint_dialable_approval_origin(host: host, origin: origin) }
    ApprovalOriginUnresolved { cause: _ } => ApprovalOriginNotAdmitted { standing: standing }
    ApprovalExecutorNotTheOriginHost { origin_host: _, executor_host: _ } => ApprovalOriginNotAdmitted { standing: standing }
    ApprovalExecutorHostUnobserved { reason: _ } => ApprovalOriginNotAdmitted { standing: standing }
    ApprovalOriginHostUnresolved { origin_host: _, reason: _ } => ApprovalOriginNotAdmitted { standing: standing }
  }
}

fn approval_origin_standing_detail(standing: ApprovalOriginStanding) -> NonEmptyStr {
  match standing {
    ApprovalOriginWouldDial { host: _, origin: _ } => "approval origin admitted" as NonEmptyStr
    ApprovalOriginUnresolved { cause } => approval_loopback_origin_refusal_detail(cause: cause)
    ApprovalExecutorNotTheOriginHost { origin_host, executor_host } =>
      join(["approval writer is loopback on ", origin_host as String, " (the prod-role holder's host) but this executor is ", executor_host, "; refusing before any request"], "") as NonEmptyStr
    ApprovalExecutorHostUnobserved { reason } =>
      join(["this executor's host could not be read or resolved (", reason, "); refusing before any request to the approval writer"], "") as NonEmptyStr
    ApprovalOriginHostUnresolved { origin_host, reason } =>
      join(["the actuated approval origin names ", origin_host as String, ", which the host roster does not resolve (",
            reason, "); refusing before any request to the approval writer"], "") as NonEmptyStr
  }
}

fn approval_submit_url(dial: DialableApprovalOrigin) -> NonEmptyStr {
  concat(dial.origin as String, approval_request_submit_path as String) as NonEmptyStr
}

fn approval_status_url(dial: DialableApprovalOrigin, escalation_id: NonEmptyStr) -> NonEmptyStr {
  concat(
    concat(dial.origin as String, concat(approval_request_submit_path as String, "/")),
    escalation_id as String,
  ) as NonEmptyStr
}

fn stored_request_from_authorization<Subject>(
  request: AuthorizationRequest<Subject>,
  issued_at: Timestamp,
  expires_at: Timestamp,
) -> StoredApprovalRequest {
  StoredApprovalRequest {
    escalation_id: request.escalation_id,
    request_revision: request_revision_of(request: request),
    attempt: request.attempt,
    requester: fleet_operator_email,
    purpose: request.purpose,
    destructive: request.destructive,
    issued_at: issued_at,
    expires_at: expires_at,
    key_id: approval_mac_key_id,
  }
}

type SubmissionMac
  = SubmissionMacReady { tag_hex: NonEmptyStr }
  | SubmissionMacKeyNotHex { key_id: MacKeyId }

fn sign_stored_request(key_material: String, request: StoredApprovalRequest) -> SubmissionMac {
  let key = MacKey {
    id: approval_submission_mac_key_id,
    suite: HmacSha256,
    material: key_material as Secret,
  }
  match sign_submission(key: key, request: request) {
    MacKeyMaterialNotHex { key_id: k } => SubmissionMacKeyNotHex { key_id: k }
    MacSigned { tag: t } => SubmissionMacReady { tag_hex: t.hex }
  }
}

type ApprovalPollStanding
  = PollStillPending
  | PollApproved {
      revision: NonEmptyStr
      decided_by: NonEmptyStr
      decided_at: Timestamp
      execute_by: Timestamp
    }
  | PollDenied {
      revision: NonEmptyStr
      decided_by: NonEmptyStr
      decided_at: Timestamp
      reason: NonEmptyStr
    }
  | PollExpired
  | PollNotFiled
  | PollUnreadable { detail: NonEmptyStr }

// THE BOUNDARY IS THE CAPABILITY'S: expires_at is the instant a request STOPS being decidable
// (gunbc.auth.approval_capability admits only observed_at < expires_at), so equality is expired
// here too -- a client that still called the operator's request pending at the very second the
// broker can no longer redeem the capability would wait for a decision that cannot land.
// THE FILED REQUEST'S OWN WINDOW GOVERNS A PENDING STANDING. A pending status carries the
// expires_at the broker filed (the one the operator was shown); the caller's expires_at is the
// window it would file under and governs only a request that is NOT filed. A rerun that computes
// a fresh window may therefore not extend a pending filing past what was filed, and a decision is
// a decision whenever it is read.
fn approval_poll_standing(
  status: FiledApprovalStatus,
  observed_at: Timestamp,
  expires_at: Timestamp,
) -> ApprovalPollStanding {
  match status {
    StatusApproved { revision: r, decided_by: by, decided_at: at, execute_by: until } =>
      PollApproved { revision: r, decided_by: by, decided_at: at, execute_by: until }
    StatusDenied { revision: r, decided_by: by, decided_at: at, reason: why } =>
      PollDenied { revision: r, decided_by: by, decided_at: at, reason: why }
    StatusUnreadable { detail: d } => PollUnreadable { detail: d }
    StatusPending { expires_at: filed } => if utc_instant_before(a: observed_at, b: filed) { PollStillPending } else { PollExpired }
    StatusNotFiled => if utc_instant_before(a: observed_at, b: expires_at) { PollNotFiled } else { PollExpired }
  }
}
