module gunbc.auth.srv15_bmc_secret_versions_receipt

// ============================ WHAT THIS IS ============================
// THE METADATA-ONLY VERSIONS READ OF bmc-srv15-admin, DECIDED IN THE MODEL (operator ruling
// msg_0b62002f, relayed by smart-crane-730 as msg_5ea15e47). The srv15 arrival accessor pin
// (srv15_bmc_gunbc_arrival_accessor_version) must cite ONE ENABLED version by number — and its
// standing says TranscribedUncited, which mints ZERO secret grants, so the citation has to be
// grounded in a receipt, not in a transcription. That receipt is produced here: a read of
// projects/gunbai-secrets/secrets/bmc-srv15-admin/versions — the LIST route only — folded into
// Srv15BmcSecretVersionsReceipt, written by the gcp-iam-converge job's read step and uploaded as
// a run artifact; the pin later cites it (CitedToAuthority, locator ending versions/<number>,
// the run URL attached).
//
// METADATA ONLY, BY CONSTRUCTION. The transport call this module makes is
// gcp.SecretManager.ListVersions — the extdeps operation declared `readonly`, GET on
// /v1/{secret_name}/versions, whose answered arm is ListSecretVersionsResponse: rows of
// name/state/createTime and NOTHING ELSE -- the state arriving as the wire string ("ENABLED" et al.)
// and reaching the typed lifecycle sum only through extdeps' sm_version_state_of projection, so an
// unrecognized spelling refuses below rather than decoding into a fabricated state. The payload-carrying routes (AccessSecretVersion,
// AddVersion) are never called from anywhere here, and nothing in this module accepts a payload
// value at all. The bearer token reaches the transport as a Secret through the same
// observe_token() channel the converge's plan steps use; it is never argv, never a receipt field.
//
// THE READ REFUSES, BY NAME, AND NEVER FALLS BACK (the ruling's words: permission-denied refuses
// by name rather than falling back). The named causes, each raised at its decision point in
// srv15_bmc_secret_versions_fold:
//   Srv15SecretReadCredentialRefused      the job could not present a workload identity at all
//   Srv15SecretReadTransportFailed        the exchange never answered (dns/tls/timeout)
//   Srv15SecretReadPermissionDenied       HTTP 403 — this job identity lacks metadata read on THIS
//                                         secret; the fix is an operator grant, never a different
//                                         identity, never a cached list, never skipping the step
//   Srv15SecretReadSecretAbsent           HTTP 404 — the secret does not exist yet; the pin cannot
//                                         be grounded before the provisioning that creates it
//   Srv15SecretReadResponseUnreadable     an answered body that failed typed decoding, or a status
//                                         this read may not fold; a body we cannot read is not a
//                                         population
//   Srv15SecretReadPaginated              nextPageToken present — the rows are a PREFIX, and a pin
//                                         grounded on a prefix is the silent-narrowing failure the
//                                         token exists to represent; we do not chase pages
//   Srv15SecretReadNoEnabledVersion       the population is complete and no row is ENABLED
//   Srv15SecretReadAmbiguousEnabledVersion two-or-more rows are ENABLED — "the" enabled version is
//                                         not a fact this read can ground
//
// WHY A REFUSAL KILLS THE STEP RATHER THAN SKIPPING IT: the step exists to ground a
// credential-version citation; its artifact is the evidence. An evidence-generating step that can
// silently abstain is how ledgers fill with ungrounded citations, so the wet entry exits failure
// on every named refusal — only an accepted receipt is ever written or uploaded.

import std.types { Bool, Int, List, NonEmptyStr, String, Secret }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.algebra { length, list_append, string_concat_join, FreeMonoid, Empty, Cons }
import std.integer { int_to_decimal_string }
import std.optional { Optional, Absent, Present }
import extdeps.transports.rest { RestResult, RestAnswered, RestRefused, RestRefusal, RestStatusRefused, RestTransportRefused, RestBodyUndecodable, RestCredentialRefused }
import extdeps.cloud.gcp.secret_manager {
  GcpSecretVersion,
  SmVersionState,
  sm_version_state_of, sm_version_state_wire,
  SmEnabled,
  SmDisabled,
  SmDestroyed,
  sm_resolved_version_id,
  SmVersionIdProjected,
  SmVersionIdNotAVersionResource,
}
import extdeps.github.actions_environment { github_runner_temp_variable_name }
import gunbc.actions_run_binding { actions_variable_trimmed }
import gunbc.auth.approval_run_identity { run_attempt }
import gunbc.auth.gcp_iam_converge_run { observe_token }
import gunbc.secret_provision { srv15_bmc_gunbc_secret_ref }
import gunbc.fleet.fleet_secrets_config { fleet_secrets_gcp_project }

// ============================ THE RECEIPT ============================
// The row as READ: the version number as the digits the name's versions/<n> tail reports, the
// state as the lifecycle sum, createTime as Google's own string. No clock is invented: createTime
// is the API's field, and the run that observed it rides beside it rather than being laundered
// into a fabricated instant.
type Srv15SecretVersionRow {
  number: String
  state: SmVersionState
  create_time: String
}

type Srv15BmcSecretVersionsReceipt {
  project: NonEmptyStr
  secret: NonEmptyStr
  versions: List<Srv15SecretVersionRow>
  observed_by_run: NonEmptyStr
}

// ============================ THE NAMED REFUSALS ============================
type Srv15SecretVersionsReadRefusal
  = Srv15SecretReadCredentialRefused { detail: String }
  | Srv15SecretReadTransportFailed { cause: NonEmptyStr }
  | Srv15SecretReadPermissionDenied { http_status: Int, message: String }
  | Srv15SecretReadSecretAbsent { http_status: Int, message: String }
  | Srv15SecretReadResponseUnreadable { detail: String }
  | Srv15SecretReadPaginated { rows_seen: Int }
  | Srv15SecretReadNoEnabledVersion { rows_seen: Int }
  | Srv15SecretReadAmbiguousEnabledVersion { enabled_numbers: List<String> }

type Srv15SecretVersionsReadOutcome
  = Srv15SecretVersionsAccepted { receipt: Srv15BmcSecretVersionsReceipt }
  | Srv15SecretVersionsRefused { cause: Srv15SecretVersionsReadRefusal }

// ============================ THE FOLD ============================
// The answer is the typed RestResult of the readonly ListVersions call — the transport already
// separated "answered with rows" from every way an exchange fails, so this fold never re-parses a
// body and never guesses a status from a string. The decision ORDER is the ruling's order:
// credential first (no identity to ask with), transport, permission (403 refuses by name),
// absence (404), decode failure, then the page-token completeness law, then the enabled-version
// law. Anything unmapped (401, 429, 5xx, 3xx) is ResponseUnreadable: an exchange that is not one
// of the decisions this read was ruled to fold is not a foldable answer, and a port that cannot
// establish its effect refuses — it never answers yes.
fn srv15_bmc_secret_versions_fold(
  project: NonEmptyStr,
  secret: NonEmptyStr,
  observed_by_run: NonEmptyStr,
  answer: RestResult<Srv15SecretVersionsAnswer>,
) -> Srv15SecretVersionsReadOutcome {
  match answer {
    RestRefused { refusal: refusal } => refuse_of(refusal: refusal)
    RestAnswered { answer: answered } => fold_rows(
      project: project,
      secret: secret,
      observed_by_run: observed_by_run,
      rows: answered.versions,
      next_page_token: answered.next_page_token,
    )
  }
}

// The answered shape is the readonly operation's output, carried here as one type so the fold's
// input, the wet's call, and the witness's supplied answers all speak the same thing.
type Srv15SecretVersionsAnswer {
  versions: List<GcpSecretVersion>
  next_page_token: Optional<String>
}

fn refuse_of(refusal: RestRefusal) -> Srv15SecretVersionsReadOutcome {
  match refusal {
    RestCredentialRefused { refusal: _ } => Srv15SecretVersionsRefused {
      cause: Srv15SecretReadCredentialRefused { detail: "the job could not present a workload identity for the versions read" }
    }
    RestTransportRefused { cause: cause } => Srv15SecretVersionsRefused {
      cause: Srv15SecretReadTransportFailed { cause: cause }
    }
    RestBodyUndecodable { status: status, cause: cause } => Srv15SecretVersionsRefused {
      cause: Srv15SecretReadResponseUnreadable {
        detail: string_concat_join(
          fields: ["HTTP ", int_to_decimal_string(value: status as Int), " answered a body that failed typed decoding: ", cause as String],
          separator: "",
        )
      }
    }
    RestStatusRefused { status: status, body: body } => {
      let code = status as Int
      match code {
        403 => Srv15SecretVersionsRefused {
          cause: Srv15SecretReadPermissionDenied { http_status: 403, message: body }
        }
        404 => Srv15SecretVersionsRefused {
          cause: Srv15SecretReadSecretAbsent { http_status: 404, message: body }
        }
        other => Srv15SecretVersionsRefused {
          cause: Srv15SecretReadResponseUnreadable {
            detail: string_concat_join(
              fields: ["the read answered HTTP ", int_to_decimal_string(value: other), " without a decision this read may fold"],
              separator: "",
            )
          }
        }
      }
    }
  }
}

fn fold_rows(
  project: NonEmptyStr,
  secret: NonEmptyStr,
  observed_by_run: NonEmptyStr,
  rows: List<GcpSecretVersion>,
  next_page_token: Optional<String>,
) -> Srv15SecretVersionsReadOutcome {
  match next_page_token {
    Present { value: _ } => Srv15SecretVersionsRefused {
      cause: Srv15SecretReadPaginated { rows_seen: length(xs: rows) }
    }
    Absent =>
      if !row_states_readable(rows: rows) then Srv15SecretVersionsRefused {
        cause: Srv15SecretReadResponseUnreadable {
          detail: "a version row carried a state spelling the lifecycle sum does not name -- a row whose state cannot be read is not a population",
        }
      }
      else match enabled_numbers(rows: rows) {
        Empty => Srv15SecretVersionsRefused {
          cause: Srv15SecretReadNoEnabledVersion { rows_seen: length(xs: rows) }
        }
        Cons { head: single, tail: rest } =>
          match rest {
            Empty => Srv15SecretVersionsAccepted {
              receipt: Srv15BmcSecretVersionsReceipt {
                project: project,
                secret: secret,
                versions: to_rows(rows: rows),
                observed_by_run: observed_by_run,
              }
            }
            Cons { head: _, tail: _ } => Srv15SecretVersionsRefused {
              cause: Srv15SecretReadAmbiguousEnabledVersion { enabled_numbers: enabled_numbers(rows: rows) }
            }
          }
      }
  }
}

fn enabled_numbers(rows: List<GcpSecretVersion>) -> List<String> {
  match rows {
    Empty => []
    Cons { head: head, tail: tail } =>
      match enabled_numbers(rows: tail) {
        rest =>
          match sm_version_state_of(head.state) {
            Present { value: SmEnabled } =>
              match sm_resolved_version_id(head.name) {
                SmVersionIdProjected { version: v } => list_append(left: [v as String], right: rest)
                SmVersionIdNotAVersionResource { supplied: _ } => rest
              }
            _ => rest
          }
      }
  }
}

// Every row's state must PROJECT to the lifecycle sum; one unprojectable spelling makes the whole
// read unreadable (refused by name at fold_rows), never silently skipped -- a population with a
// row nobody can read is not a population.
fn row_states_readable(rows: List<GcpSecretVersion>) -> Bool {
  match rows {
    Empty => true
    Cons { head: head, tail: tail } =>
      (match sm_version_state_of(head.state) {
        Present { value: sm_state } => true
        Absent => false
      })
        && row_states_readable(rows: tail)
  }
}

fn to_rows(rows: List<GcpSecretVersion>) -> List<Srv15SecretVersionRow> {
  match rows {
    Empty => []
    Cons { head: head, tail: tail } =>
      match sm_resolved_version_id(head.name) {
        SmVersionIdProjected { version: v } =>
          list_append(
            left: [Srv15SecretVersionRow {
              number: v as String,
              // Projected; the fold refuses unprojectable spellings BEFORE reaching this line
              // (row_states_readable), so None cannot occur -- and were it ever reached, the
              // fail-closed reading is DESTROYED: a state we cannot name is never the enabled one.
              state: match sm_version_state_of(head.state) {
                Present { value: state } => state
                Absent => SmDestroyed
              },
              create_time: head.create_time,
            }],
            right: to_rows(rows: tail),
          )
        SmVersionIdNotAVersionResource { supplied: _ } => to_rows(rows: tail)
      }
  }
}

// ============================ THE RECEIPT'S CANONICAL TEXT ============================
// The artifact's bytes. Field names are the wire names the pin's citation and every later reader
// use; the state word is emitted by THE ONE wire authority, extdeps.cloud.gcp.secret_manager's
// sm_version_state_wire -- this module keeps no second spelling of its own.

fn srv15_versions_receipt_json(receipt: Srv15BmcSecretVersionsReceipt) -> String {
  string_concat_join(
    fields: [
      "{\"secret\":\"", receipt.secret as String,
      "\",\"project\":\"", receipt.project as String,
      "\",\"observedByRun\":\"", receipt.observed_by_run as String,
      "\",\"versions\":[", rows_json(rows: receipt.versions), "]}",
    ],
    separator: "",
  )
}

fn rows_json(rows: List<Srv15SecretVersionRow>) -> String {
  match rows {
    Empty => ""
    Cons { head: head, tail: tail } =>
      match tail {
        Empty => row_json(row: head)
        Cons { head: _, tail: _ } =>
          string_concat_join(
            fields: [row_json(row: head), ",", rows_json(rows: tail)],
            separator: "",
          )
      }
  }
}

fn row_json(row: Srv15SecretVersionRow) -> String {
  string_concat_join(
    fields: [
      "{\"name\":\"projects/", fleet_secrets_gcp_project as String, "/secrets/", srv15_bmc_gunbc_secret_ref.secret,
      "/versions/", row.number, "\",\"state\":\"", sm_version_state_wire(state: row.state),
      "\",\"createTime\":\"", row.create_time, "\"}",
    ],
    separator: "",
  )
}

// ============================ THE WET ENTRY (gcp-iam-converge read step) ============================
// ONE SHOT, READ ONLY, FAIL CLOSED. Sequence, each step refusing by name:
//   1. the run identity must be present (same law as the converge's request step);
//   2. the job's wif_auth step must have exported its token (WIF_ACCESS_TOKEN, read in-process by
//      the WorkloadIdentityToken arm of gunbc.auth.access_token_source -- Secret, never argv) —
//      no identity, no read, no skip;
//   3. the readonly ListVersions exchange (typed transport; token never leaves the Secret carrier);
//   4. the fold above; any named refusal exits failure with the cause's name IN the reason;
//   5. the accepted receipt is written 0600 under RUNNER_TEMP and its exact path reported by the
//      step's own log line; the job's upload step publishes exactly that file.
fn srv15_bmc_secret_versions_read_wet() -> ProcessExit {
  match run_attempt() {
    Absent => exit_failure(reason: "srv15-bmc-versions: no run identity; the versions read is a run act, not a local one")
    Present { value: attempt } =>
      match observe_token() {
        Absent => exit_failure(reason: "srv15-bmc-versions: Srv15SecretReadCredentialRefused; the job could not present a workload identity")
        Present { value: token } =>
          match srv15_bmc_secret_versions_fold(
            project: fleet_secrets_gcp_project,
            secret: srv15_bmc_gunbc_secret_ref.secret,
            observed_by_run: srv15_versions_run_url(run_id: attempt as String),
            answer: gcp.SecretManager.ListVersions(
              access_token: token,
              secret_name: srv15_versions_wire_name(),
            ),
          ) {
            Srv15SecretVersionsRefused { cause: cause } =>
              exit_failure(reason: string_concat_join(
                fields: ["srv15-bmc-versions refused: ", refusal_name(cause: cause)],
                separator: "",
              ))
            Srv15SecretVersionsAccepted { receipt: receipt } => {
              let temp = actions_variable_trimmed(name: github_runner_temp_variable_name)
              if temp == "" {
                exit_failure(reason: "srv15-bmc-versions: RUNNER_TEMP is unset; the receipt has nowhere durable to land")
              } else {
                let receipt_path = string_concat_join(fields: [temp, "/srv15-bmc-secret-versions-receipt.json"], separator: "")
                let written = Filesystem.WriteOwnerOnly(path: receipt_path, content: srv15_versions_receipt_json(receipt: receipt))
                if !written.success {
                  exit_failure(reason: string_concat_join(fields: ["srv15-bmc-versions: could not write the receipt: ", written.error], separator: ""))
                } else {
                  ExitSuccess
                }
              }
            }
          }
      }
  }
}

// The wire name of the secret, projected from the standing's locator — one authority for the
// resource string; the step cannot ask for a different secret than the standing names.
fn srv15_versions_wire_name() -> String {
  string_concat_join(
    fields: ["projects/", fleet_secrets_gcp_project as String, "/secrets/", srv15_bmc_gunbc_secret_ref.secret],
    separator: "",
  )
}

// The run URL of the gcp-iam-converge run that made this read — the locator the pin will carry.
// Composed from the repository this workflow lives in and the run id the Actions environment
// publishes; no host is invented beyond github.com itself.
fn srv15_versions_run_url(run_id: String) -> String {
  string_concat_join(
    fields: ["https://github.com/gunb-ai/gunbc/actions/runs/", run_id],
    separator: "",
  )
}

// The refusal's NAME, so the step's log and any later reader see WHICH law fired; the message
// bodies stay with the refusal, and the receipt never carries them (an evidence step that leaks
// response bodies into artifacts turns a log into an exfiltration surface).
fn refusal_name(cause: Srv15SecretVersionsReadRefusal) -> String {
  match cause {
    Srv15SecretReadCredentialRefused { detail: _ } => "Srv15SecretReadCredentialRefused"
    Srv15SecretReadTransportFailed { cause: c } => string_concat_join(fields: ["Srv15SecretReadTransportFailed:", c as String], separator: "")
    Srv15SecretReadPermissionDenied { http_status: _, message: _ } => "Srv15SecretReadPermissionDenied (grant metadata read on bmc-srv15-admin to this job identity; never fall back)"
    Srv15SecretReadSecretAbsent { http_status: _, message: _ } => "Srv15SecretReadSecretAbsent"
    Srv15SecretReadResponseUnreadable { detail: _ } => "Srv15SecretReadResponseUnreadable"
    Srv15SecretReadPaginated { rows_seen: _ } => "Srv15SecretReadPaginated"
    Srv15SecretReadNoEnabledVersion { rows_seen: _ } => "Srv15SecretReadNoEnabledVersion"
    Srv15SecretReadAmbiguousEnabledVersion { enabled_numbers: _ } => "Srv15SecretReadAmbiguousEnabledVersion"
  }
}
