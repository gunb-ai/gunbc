module gunbc.auth.fleet_secret_accessor_roster


import gunbc.fabric.fabric_storage_state_policy { fabric_state_key_secret_ref }
import gunbc.claude_code_credential { claude_code_oauth_harness_secret_ref }
import gunbc.auth.tracker_web_oauth_client { tracker_web_test_oauth_client_secret_ref }
import gunbc.auth.github_apps { gunbai_bot_app_pem_secret }
import gunbc.flex_vast_credential { flex_vast_api_key_secret_ref }
import gunbc.fleet.fleet_ssh_access { mtcollins1_ssh_host_key_secret }

// ONE ROSTER OF ACCESSOR GRANTS, ONE CONVERGE (review 67306). The first grant a lane needed was
// written as gunbc.spark.secret_access_ensure; the second (the Mt. Collins BMC credential, after
// boot run 35245186544 got 403 on it) was about to be a copy of that module differing in one
// SecretRef. A grant is a row, not a module: this roster carries every accessor cell the fleet's
// convergence principal must hold; the GCP IAM converge, not this module, binds them. gunbc.spark.secret_access_ensure keeps its entries as thin bindings over its row here
// so its consumers (the host convergence census, its witness) are not renamed by the move.
import extdeps.cloud.gcp.secret_ref { SecretRef }
import gunbc.spark.credential_workflow { spark_administrator_password_secret_ref }
import gunbc.secret_provision { mtcollins1_bmc_gunbc_secret_ref, openrouter_free_tier_key_secret_ref }
import gunbc.auth.approval_decision_store { approval_mac_key_secret_ref }
import gunbc.auth.approval_request_submission { approval_submission_mac_key_secret_ref }
import gunbc.auth.approval_store_receipt { approval_store_receipt_mac_key_secret_ref }
import gunbc.auth.approval_ntfy_deployment { approval_ntfy_publisher_token_secret_ref }
import gunbc.auth.approval_apns_publish { approval_apns_auth_key_secret_ref }
import gunbc.oracle_oci.api { oci_api_signing_key_secret_ref }
import gunbc.auth.gcp_secret_access { SecretAccessGrant, secret_accessor_grant }
import extdeps.cloud.gcp.iam { role_secretmanager_secret_version_adder }
import gunbc.codex_harness_credential { codex_auth_harness_secret_ref }
import gunbc.host.boot_medium_reader_key { boot_medium_reader_ssh_privkey_secret }
import gunbc.cursor_harness_credential { cursor_api_key_harness_secret_ref }
import std.types { List, String }

type FleetAccessorGrantRow {
  lane: String
  target: SecretRef
}

data spark_accessor_row: FleetAccessorGrantRow = FleetAccessorGrantRow { lane: "spark administrator password", target: spark_administrator_password_secret_ref }

// APPLIED LIVE 2026-09-17 through gunbc.auth.gcp_secret_access under the operator's token (one
// getIamPolicy, one setIamPolicy on bmc-mtcollins1-gunbc); boot run 35249658152 then fetched the
// credential over WIF where run 35245186544 had got 403.
data mtcollins1_bmc_accessor_row: FleetAccessorGrantRow = FleetAccessorGrantRow { lane: "mtcollins1 BMC credential", target: mtcollins1_bmc_gunbc_secret_ref }

// THE APPROVAL MAC KEYS ARE ROWS HERE TOO (review 67340): the provisioning entry
// (gunbc.auth.approval_mac_key_provision) selects them from this roster rather than carrying its
// own list, so the set of accessor cells the principal must hold has one source. The capability and
// submission keys were applied live 2026-09-17 by that entry (capability key already bound;
// submission key one setIamPolicy).
data approval_capability_mac_key_accessor_row: FleetAccessorGrantRow = FleetAccessorGrantRow { lane: "approval capability MAC key (server)", target: approval_mac_key_secret_ref }
data approval_submission_mac_key_accessor_row: FleetAccessorGrantRow = FleetAccessorGrantRow { lane: "approval submission MAC key (runner + server)", target: approval_submission_mac_key_secret_ref }

// THE STORE RECEIPT KEY (gunbc.auth.approval_store_receipt): read on srv1 by the broker, which mints
// receipts, and by the fabric store's serve process, which verifies them. NOT YET APPLIED: the
// provisioning entry binds it under the operator's token in the same run that mints version 1.
data approval_store_receipt_mac_key_accessor_row: FleetAccessorGrantRow = FleetAccessorGrantRow { lane: "approval store receipt MAC key (srv1 broker + fabric store)", target: approval_store_receipt_mac_key_secret_ref }

// THE NTFY PUBLISHER TOKEN, read by gunbc.fleet.host_credential_custody_converge over WIF. NOT YET
// APPLIED: until this ensure runs under the operator's token, the custody mode's Secret Manager
// read refuses and the receipt names the secret -- loud, never a guessed grant.
data approval_ntfy_publisher_token_accessor_row: FleetAccessorGrantRow = FleetAccessorGrantRow { lane: "approval ntfy publisher token (srv1 custody)", target: approval_ntfy_publisher_token_secret_ref }

// THE APNs AUTH KEY, read over WIF by gunbc.fleet.host_credential_custody_converge (arm
// ApprovalApnsAuthKey) to place it on srv1 for the broker's provider token. It lands WITH the key: the
// operator added version 1 on 2026-10-25, so the row no longer names a secret that does not exist
// (this roster's fold stops at the first refusal). NOT YET APPLIED: until the ensure runs under the
// operator's token, the custody read refuses and names the secret.
data approval_apns_auth_key_accessor_row: FleetAccessorGrantRow = FleetAccessorGrantRow { lane: "approval APNs auth key (srv1 broker custody)", target: approval_apns_auth_key_secret_ref }

data fabric_state_key_accessor_row: FleetAccessorGrantRow = FleetAccessorGrantRow { lane: "fabric state service credential (controller and website custody)", target: fabric_state_key_secret_ref }

// THE WORKER-TURN CREDENTIALS (node adhoc-932f2935-e8e), both read by
// gunbc.fleet.host_credential_custody_converge over WIF for placement on their custody host. NOT YET
// APPLIED: until the ensure runs, those reads refuse and name the secret.
data cursor_api_key_harness_accessor_row: FleetAccessorGrantRow = FleetAccessorGrantRow { lane: "cursor worker-turn API key", target: cursor_api_key_harness_secret_ref }
data codex_auth_harness_accessor_row: FleetAccessorGrantRow = FleetAccessorGrantRow { lane: "codex worker-turn subscription auth.json", target: codex_auth_harness_secret_ref }

// THE ONE WRITE GRANT, kept as its own roster because it is a different role and a different risk:
// codex rotates its refresh token on its custody host, and the custody converge reads the host file
// back and adds it as a new version (gunbc.codex_harness_credential codex_harness_add_version). secretVersionAdder can add versions and cannot
// read, disable or destroy them, so a converge that writes back cannot remove the version it read.
data codex_auth_harness_version_adder_row: FleetAccessorGrantRow = FleetAccessorGrantRow { lane: "codex worker-turn auth.json write-back", target: codex_auth_harness_secret_ref }

// THE BOOT MEDIUM READER KEY'S MINT (gunbc.host.boot_medium_reader_key_mint): a main fleet-converge run
// generates the keypair and adds the private half as a version. It adds and nothing else -- it cannot read,
// disable or destroy a version -- so the run that writes the key cannot read it back.
data boot_medium_reader_key_version_adder_row: FleetAccessorGrantRow = FleetAccessorGrantRow { lane: "boot medium reader key mint", target: boot_medium_reader_ssh_privkey_secret }

data fleet_version_adder_grant_roster: List<FleetAccessorGrantRow> = [
  codex_auth_harness_version_adder_row,
  boot_medium_reader_key_version_adder_row,
]

// THE OPENROUTER FREE-TIER KEY, read by the hosted harness route (gunbc.harness.harness_hosted_route)
// on every bind -- a recurring automated read, so it rides the workload's accessor cell rather than an
// operator session (gunbc.auth.authorization_pattern_selection).
data openrouter_free_tier_key_accessor_row: FleetAccessorGrantRow = FleetAccessorGrantRow { lane: "OpenRouter free-tier key (hosted harness route)", target: openrouter_free_tier_key_secret_ref }

// The OCI API signing key, read on srv1 by the custody converge (gunbc.fleet.host_credential_custody_converge
// OracleOciApiSigningKey).
data oracle_oci_api_signing_key_accessor_row: FleetAccessorGrantRow = FleetAccessorGrantRow { lane: "oracle oci api signing key (srv1 custody)", target: oci_api_signing_key_secret_ref }

// THE CLAUDE CODE SUBSCRIPTION TOKEN, read over WIF by gunbc.fleet.host_credential_custody_converge to
// deliver it to srv1 for the roadmap belt's explicit Claude dispatch (gunbc.claude_code_credential).
// The operator creates the secret's first version; the converge binds the accessor.
data claude_code_oauth_harness_accessor_row: FleetAccessorGrantRow = FleetAccessorGrantRow { lane: "claude code subscription OAuth token (srv1 belt custody)", target: claude_code_oauth_harness_secret_ref }

data tracker_web_test_oauth_client_secret_accessor_row: FleetAccessorGrantRow = FleetAccessorGrantRow { lane: "tracker-web TEST OAuth client secret (srv1 lab custody)", target: tracker_web_test_oauth_client_secret_ref }

data gunbai_bot_app_pem_accessor_row: FleetAccessorGrantRow = FleetAccessorGrantRow { lane: "gunbai-bot App private key (heal WIF and srv1 publication custody)", target: gunbai_bot_app_pem_secret }

// THE STABLE SSH HOST KEY OF MTCOLLINS1 (operator option A, 2026-10-22), read over WIF by
// gunbc.fleet.host_credential_custody_converge (arm Mtcollins1SshHostKey) to place it on mtcollins1 in
// memory on every boot. NOT YET APPLIED TWICE OVER: the grant itself lands only when this roster's
// ensure runs, AND the secret does not exist until the operator mints it -- until both are true the
// custody read refuses and names the secret, which is the honest state, not a failure to hide.
data mtcollins1_ssh_host_key_accessor_row: FleetAccessorGrantRow = FleetAccessorGrantRow { lane: "mtcollins1 stable SSH host key (per-boot in-memory custody)", target: mtcollins1_ssh_host_key_secret }

// THE FLEX POOL'S VAST.AI API KEY, read over WIF by gunbc.fleet.host_credential_custody_converge to place
// it on srv1 for the flex loop (gunbc.flex_vast_credential).
data flex_vast_api_key_accessor_row: FleetAccessorGrantRow = FleetAccessorGrantRow { lane: "flex pool Vast.ai API key (srv1 custody)", target: flex_vast_api_key_secret_ref }

data fleet_accessor_grant_roster: List<FleetAccessorGrantRow> = [
  cursor_api_key_harness_accessor_row,
  codex_auth_harness_accessor_row,
  spark_accessor_row,
  mtcollins1_bmc_accessor_row,
  approval_capability_mac_key_accessor_row,
  approval_submission_mac_key_accessor_row,
  approval_store_receipt_mac_key_accessor_row,
  approval_ntfy_publisher_token_accessor_row,
  approval_apns_auth_key_accessor_row,
  fabric_state_key_accessor_row,
  openrouter_free_tier_key_accessor_row,
  oracle_oci_api_signing_key_accessor_row,
  claude_code_oauth_harness_accessor_row,
  tracker_web_test_oauth_client_secret_accessor_row,
  gunbai_bot_app_pem_accessor_row,
  flex_vast_api_key_accessor_row,
  mtcollins1_ssh_host_key_accessor_row,
]

fn fleet_accessor_grant(row: FleetAccessorGrantRow) -> SecretAccessGrant {
  secret_accessor_grant(target: row.target)
}

fn fleet_version_adder_grant(row: FleetAccessorGrantRow) -> SecretAccessGrant {
  SecretAccessGrant { target: row.target, role: role_secretmanager_secret_version_adder, condition: none }
}

// NO ENTRY FOLDS THIS ROSTER UNDER AN OPERATOR TOKEN ANY MORE (operator, 2026-10-18, relayed by
// warm-crane-219: "for ALL keys"). Every row that is not a trust root is a converge grant-set cell
// (gunbc.auth.gcp_iam_converge fleet_roster_grants), bound under the estate's one approval with its
// bootstrap cells bound by the bootstrap delta; the trust-root rows (gunbc.auth.gcp_iam_trust_roots) are
// bound only by the first-time root ceremony (gunbc.auth.approval_mac_key_provision for the MAC keys,
// gunbc.fleet.org_actions_converge for the gunbai-ci App key). The operator-token fold that stood here
// was a second path beside both and is deleted (DESIGN 3, replacement migrations).
