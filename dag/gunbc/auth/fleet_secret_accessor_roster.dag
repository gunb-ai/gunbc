module gunbc.auth.fleet_secret_accessor_roster

// ONE ROSTER OF ACCESSOR GRANTS, ONE CONVERGE (review 67306). The first grant a lane needed was
// written as gunbc.spark.secret_access_ensure; the second (the Mt. Collins BMC credential, after
// boot run 35245186544 got 403 on it) was about to be a copy of that module differing in one
// SecretRef. A grant is a row, not a module: this roster carries every accessor cell the fleet's
// convergence principal must hold, and one entry folds the ensure over all of them under the
// operator's token -- the control plane that may call setIamPolicy is deliberately not the
// workload. gunbc.spark.secret_access_ensure keeps its entries as thin bindings over its row here
// so its consumers (the host convergence census, its witness) are not renamed by the move.
import extdeps.cloud.gcp.secret_ref { SecretRef }
import gunbc.spark.credential_workflow { spark_administrator_password_secret_ref }
import gunbc.secret_provision { mtcollins1_bmc_gunbc_secret_ref }
import gunbc.auth.approval_decision_store { approval_mac_key_secret_ref }
import gunbc.auth.approval_request_submission { approval_submission_mac_key_secret_ref }
import gunbc.auth.gcp_secret_access { SecretAccessGrant, secret_accessor_grant, secret_access_ensure_for }
import gunbc.auth.access_token_source {
  AccessTokenSource, OperatorSuppliedToken, read_supplied_access_token, SuppliedTokenReady, SuppliedTokenUnavailable,
}
import std.process { ProcessExit, ExitSuccess, ExitFailure, exit_failure }
import std.types { List, String }

type FleetAccessorGrantRow {
  lane: String
  target: SecretRef
}

data spark_accessor_row: FleetAccessorGrantRow = FleetAccessorGrantRow { lane: "spark administrator password", target: spark_administrator_password_secret_ref }

// APPLIED LIVE 2026-09-17 through gunbc.auth.gcp_secret_access under the operator's token (one
// getIamPolicy, one setIamPolicy on bmc-mtcollins1-gunbc); boot run 35249658152 then fetched the
// credential over WIF where run 35245186544 had got 403.
data mtcollins1_bmc_accessor_row: FleetAccessorGrantRow = FleetAccessorGrantRow { lane: "mtcollins1 BMC credential", target: mtcollins1_bmc_gunbc_secret_ref }

// THE TWO APPROVAL MAC KEYS ARE ROWS HERE TOO (review 67340): the provisioning entry
// (gunbc.auth.approval_mac_key_provision) selects them from this roster rather than carrying its
// own pair, so the set of accessor cells the principal must hold has one source. Both applied
// live 2026-09-17 by that entry (capability key already bound; submission key one setIamPolicy).
data approval_capability_mac_key_accessor_row: FleetAccessorGrantRow = FleetAccessorGrantRow { lane: "approval capability MAC key (server)", target: approval_mac_key_secret_ref }
data approval_submission_mac_key_accessor_row: FleetAccessorGrantRow = FleetAccessorGrantRow { lane: "approval submission MAC key (runner + server)", target: approval_submission_mac_key_secret_ref }

data fleet_accessor_grant_roster: List<FleetAccessorGrantRow> = [
  spark_accessor_row,
  mtcollins1_bmc_accessor_row,
  approval_capability_mac_key_accessor_row,
  approval_submission_mac_key_accessor_row,
]

fn fleet_accessor_grant(row: FleetAccessorGrantRow) -> SecretAccessGrant {
  secret_accessor_grant(target: row.target)
}

// THE FOLD STOPS AT THE FIRST REFUSAL: a grant that did not converge is reported with its lane, and
// the rows after it are not attempted, so a partial pass never reads as a full one.
fn fleet_accessor_grants_ensure(token_source: AccessTokenSource) -> ProcessExit
{
  fold(fleet_accessor_grant_roster, init: ExitSuccess, f: (acc, row) =>
    match acc {
      ExitSuccess =>
        match secret_access_ensure_for(grant: fleet_accessor_grant(row: row), token_source: token_source) {
          ExitSuccess => ExitSuccess
          ExitFailure { code: c, reason: why } => ExitFailure { code: c, reason: join(["accessor grant for ", row.lane, ": ", why], "") }
        }
      failed => failed
    }
  )
}

fn fleet_accessor_grants_converge_with_supplied_token() -> ProcessExit
{
  match read_supplied_access_token() {
    SuppliedTokenUnavailable { cause: c } => exit_failure(reason: c as String)
    SuppliedTokenReady { token: t } => fleet_accessor_grants_ensure(token_source: OperatorSuppliedToken { token: t })
  }
}
