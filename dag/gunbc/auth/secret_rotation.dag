module gunbc.auth.secret_rotation


// The rotation kernel for a secret held in a version store, parameterized by the subject rather
// than written per credential. The sequence is: observe the current version, obtain a replacement,
// add it EXACTLY ONCE, read back the exact new version, verify the payload is the one written,
// verify the named consumers against that exact version, disable the prior version, optionally
// destroy it, and emit a receipt. The ORDER is the content, because each step is the evidence the
// next one is entitled to. This module names no BMC, no host, and no specific credential: the same
// kernel must later rotate service administrator passwords, serving API keys and model-hub tokens
// without an edit, so anything that would have to change per credential is a parameter on the
// intent and anything specific to one credential lives in a consumer module beside it, never here.
// Version identity and payload decoding are IMPORTED from extdeps.cloud.gcp.secret_manager —
// `decode_sm_resolved_version_identity_wire`, `decode_sm_access_version_wire_response`,
// `SmResolvedVersionIdentity` and their typed refusals — and this module deliberately defines no
// parsing of its own. A second decoder would be a fork of the one authority that says what a
// resolved version IS, and the two would disagree the first time either was fixed. The refusals
// arrive already typed, so this module's job is to decide what a rotation DOES about them, never
// to re-derive them. Note in particular that nothing here matches a decode refusal and binds its
// cause to `_`: a refusal reaching this kernel stops the rotation and is carried into the receipt
// with its cause intact, because the failure this whole lane exists to prevent was a production
// path that matched a typed refusal, discarded the cause, and returned a fabricated credential as
// though authentication had succeeded — every witness green, the code still dangerous.
// ---------------------------------------------------------------------------
// The intent
// ---------------------------------------------------------------------------

// How the replacement value is obtained, as a closed choice, because it is the axis on which a
// rotation is most tempting to make convenient and most dangerous when it is. Neither arm carries
// the value. A generated replacement names its generator so the entropy source is a modeled fact
// rather than whatever the actuator happened to call; a received one names the channel it arrives
// on. What no arm admits is a literal, and that absence is the point: there is no shape in this
// type that a payload can be written into, so a replacement cannot enter source by any spelling a
// caller can reach. The same rule follows the value everywhere downstream — argv, logs, workflow
// artifacts, PR bodies and the receipt — and this lane exists because that rule was broken.
type ReplacementPayloadStrategy
  = GeneratedInWorkflow { generator: std.types.NonEmptyStr, entropy_bits: std.measure.BitWidth }
  | ReceivedOutOfBand { channel: std.types.NonEmptyStr }

// The verification requirement is a named roster and there is deliberately no arm meaning `do not
// verify`. A rotation that retires a credential without proving anything accepts the new one is
// guessing, and the guess is only ever discovered by an outage. Where a subject genuinely has no
// consumer to prove, the honest expression is an empty roster — which the destroy gate then
// refuses as CensusReachedNoOne rather than silently treating as satisfied, so `nobody consumes
// this` has to be established rather than assumed.
type ConsumerVerificationRequirement {
  consumers: List<RotationConsumer>
}

// Disable and destroy are separate policy positions rather than one `cleanup` flag, because they
// differ in reversibility and therefore in what evidence they are owed. DisableOnly is the
// conservative default and is complete on its own: the prior version stops answering, and if that
// turns out to be wrong a single enable undoes it. DisableThenDestroy additionally erases the
// bytes, is not undoable by anything, and consequently has to clear the no-consumer confirmation.
// A policy naming destroy without disable is not offered, because the disabled interval IS the
// experiment whose quiet the destroy depends on.
type RetirementPolicy
  = DisableOnly
  | DisableThenDestroy

type SecretRotationIntent {
  intent_id: std.types.NonEmptyStr
  subject: extdeps.cloud.gcp.secret_ref.SecretRef
  prior_version: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity
  replacement: ReplacementPayloadStrategy
  verification: ConsumerVerificationRequirement
  retirement: RetirementPolicy
}

// ---------------------------------------------------------------------------
// Version identity: the alias is the discriminating fact
// ---------------------------------------------------------------------------

// SecretRef.version is a NonEmptyStr and upstream admits exactly two kinds of value in it — a
// version number, or the moving alias `latest`. Those are not two spellings of one thing, and the
// difference is what makes a rotation provable at all: a number denotes ONE immutable payload
// forever, while `latest` denotes whatever the most recent enabled version happens to be at the
// instant it is resolved, so the same string means a different secret before and after an add-
// version. Two arms and no third: a malformed selector is not a state this classifier can
// helpfully invent, because the imported identity decoder already refuses a malformed resolved
// name with a located, typed cause, and a second weaker validator here would be a fork of that
// decision.
type SecretVersionSelector
  = ExactVersion { number: std.types.NonEmptyStr }
  | AliasLatest

data latest_alias_literal: std.types.NonEmptyStr = "latest"

fn classify_version_selector(version: std.types.NonEmptyStr) -> SecretVersionSelector {
  if (version as String) == (latest_alias_literal as String) {
    AliasLatest
  } else {
    ExactVersion { number: version }
  }
}

fn secret_ref_selector(ref: extdeps.cloud.gcp.secret_ref.SecretRef) -> SecretVersionSelector {
  classify_version_selector(version: ref.version)
}

fn selector_is_alias(selector: SecretVersionSelector) -> Bool {
  match selector {
    AliasLatest => true
    ExactVersion { number: _ } => false
  }
}

fn selector_resolves_to(selector: SecretVersionSelector, secret: extdeps.cloud.gcp.secret_ref.SecretRef, identity: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity) -> Bool {
  match selector {
    ExactVersion { number: n } =>
      version_resource_of(secret: secret, version: n) == (identity as String)
    AliasLatest => false
  }
}

fn selector_version_label(selector: SecretVersionSelector) -> std.types.NonEmptyStr {
  match selector {
    ExactVersion { number: n } => n
    AliasLatest => latest_alias_literal
  }
}

// ---------------------------------------------------------------------------
// Resource names, built rather than parsed
// ---------------------------------------------------------------------------

// The join between a version number a caller holds and the resolved identity upstream reports is
// performed by CONSTRUCTING the expected name and comparing, never by splitting the reported one.
// The imported decoder owns the question of whether a reported name is well formed; this module
// only asks whether a well-formed name is the one it meant, and construction answers that totally
// while a split would need an arm for a name carrying no separator. Building also keeps the result
// in the form the operations take, since disable and destroy are addressed by resolved identity.
fn secret_version_at(secret: extdeps.cloud.gcp.secret_ref.SecretRef, version: std.types.NonEmptyStr) -> extdeps.cloud.gcp.secret_ref.SecretRef {
  extdeps.cloud.gcp.secret_ref.SecretRef {
    project: secret.project,
    secret: secret.secret,
    version: version,
    hash_state: secret.hash_state,
  }
}

fn version_resource_of(secret: extdeps.cloud.gcp.secret_ref.SecretRef, version: std.types.NonEmptyStr) -> String {
  secret_ref_version_resource(ref: secret_version_at(secret: secret, version: version))
}

fn identity_is(identity: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity, other: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity) -> Bool {
  (identity as String) == (other as String)
}

fn listed_identity_is(listed: extdeps.cloud.gcp.secret_manager.GcpSecretVersion, other: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity) -> Bool {
  identity_is(identity: listed.name, other: other)
}

// A version this rotation intends to disable or destroy is carried as its resolved identity PLUS
// the etag observed with it, and the etag is required here even though upstream makes it optional.
// That split is the layer rule working rather than a disagreement with the dependency: `{ etag:
// string }` really is optional on disable and destroy — upstream states that omitting it simply
// succeeds — so extdeps models it optional because what extdeps owns is the contract. Requiring it
// is POLICY, and it exists because omitting it changes what the operation is ABOUT. With an etag,
// disable means `disable the version I observed`; without one it means `disable whatever is at
// that name now`, a different subject and the same moving-target failure the `latest` alias
// produces one layer up. The window is real: between listing versions and destroying one, another
// actor can add or re-enable at a name this rotation already decided about, and the no-consumer
// confirmation was computed against the store as it read BEFORE that.
type VersionTarget {
  identity: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity
  etag: String
}

fn version_has_etag(listed: extdeps.cloud.gcp.secret_manager.GcpSecretVersion) -> Bool {
  match listed.etag {
    Present { value: e } => string_length(s: e) > 0
    Absent => false
  }
}

fn version_etag_or_empty(listed: extdeps.cloud.gcp.secret_manager.GcpSecretVersion) -> String {
  match listed.etag {
    Present { value: e } => e
    Absent => ""
  }
}

fn version_target_of(listed: extdeps.cloud.gcp.secret_manager.GcpSecretVersion) -> VersionTarget {
  VersionTarget { identity: listed.name, etag: version_etag_or_empty(listed: listed) }
}

// ---------------------------------------------------------------------------
// Consumers and the evidence they produce
// ---------------------------------------------------------------------------

// Consumer identity is branded rather than a free NonEmptyStr. The census is an identity JOIN, so
// the thing being joined on has to be a kind of name and not merely a string that happens to be
// non-empty — with a free string, a roster entry and an evidence row are matched by two unrelated
// values that typecheck against each other by accident, and every list of names in this module
// (roster, missing, refusal subjects) has the same type as every message and label. The brand does
// not make the join correct, but it makes the join's operands nameable, so a future construction
// wall over WHERE consumer ids come from has something to attach to.
type ConsumerId = std.types.NonEmptyStr where brand("RotationConsumerId")

type RotationConsumer {
  id: ConsumerId
  selector: SecretVersionSelector
}

// What a consumer can tell a rotation, as three distinguishable answers rather than a Bool. The
// middle arm is the one this kernel exists to refuse: a consumer reporting that it authenticated
// successfully but never naming the version it read has produced a green compatible with EVERY
// version of the secret, including the one about to be retired. Collapsing it into the first would
// rest the rotation's central claim on evidence that cannot distinguish the new version from the
// old. The third arm stays separate from a negative answer because a consumer that could not be
// reached has not reported that it is fine, and a rotation reading silence as assent retires a
// version nobody proved was unused.
type ConsumerVersionEvidence
  = ResolvedVersionObserved { consumer: ConsumerId, resolved: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity }
  | ConsumerReportedSuccessOnly { consumer: ConsumerId }
  | ConsumerUnreachable { consumer: ConsumerId, cause: std.types.NonEmptyStr }

fn evidence_consumer(evidence: ConsumerVersionEvidence) -> ConsumerId {
  match evidence {
    ResolvedVersionObserved { consumer: c, resolved: _ } => c
    ConsumerReportedSuccessOnly { consumer: c } => c
    ConsumerUnreachable { consumer: c, cause: _ } => c
  }
}

type ConsumerProofRefusal
  = ResolvedVersionUnobserved { consumer: ConsumerId }
  | ConsumerOnOtherVersion { consumer: ConsumerId, observed: String, expected: String }
  | ConsumerObservationFailed { consumer: ConsumerId, cause: std.types.NonEmptyStr }
  | ConsumerEvidenceMissing { consumer: ConsumerId }
  | ConsumerEvidenceAmbiguous { consumer: ConsumerId, report_count: Int }

type ConsumerProofOutcome
  = ConsumerProven { consumer: ConsumerId, on_version: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity }
  | ConsumerProofRefused { cause: ConsumerProofRefusal }

// The proof rule, and its case split is over what the evidence can DISTINGUISH rather than over
// whether the evidence is positive. A consumer naming the version it resolved is proven or refuted
// directly, whatever it selects with — an alias-pinned consumer reporting that it resolved version
// 3 really is on version 3, and refusing it for the shape of its pin would refuse a fact that was
// actually observed. A consumer reporting only success is proven exactly when its own selector is
// an exact pin resolving to the added version, because then success against that pin IS a
// statement about that version and nothing else. The single remaining combination — success-only
// through the moving alias — carries no version information at all and is refused. The refusal
// names the consumer so the remedy is locatable, and the remedy is to change the consumer, never
// to weaken the rule.
fn prove_consumer_on_version(
  consumer: RotationConsumer,
  evidence: ConsumerVersionEvidence,
  secret: extdeps.cloud.gcp.secret_ref.SecretRef,
  added: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity,
) -> ConsumerProofOutcome {
  match evidence {
    ConsumerUnreachable { consumer: c, cause: cause } =>
      ConsumerProofRefused { cause: ConsumerObservationFailed { consumer: c, cause: cause } }
    ResolvedVersionObserved { consumer: c, resolved: r } =>
      if identity_is(identity: r, other: added) {
        ConsumerProven { consumer: c, on_version: r }
      } else {
        ConsumerProofRefused {
          cause: ConsumerOnOtherVersion {
            consumer: c,
            observed: r as String,
            expected: added as String,
          },
        }
      }
    ConsumerReportedSuccessOnly { consumer: c } =>
      if selector_resolves_to(selector: consumer.selector, secret: secret, identity: added) {
        ConsumerProven { consumer: c, on_version: added }
      } else {
        if selector_is_alias(selector: consumer.selector) {
          ConsumerProofRefused { cause: ResolvedVersionUnobserved { consumer: c } }
        } else {
          ConsumerProofRefused {
            cause: ConsumerOnOtherVersion {
              consumer: c,
              observed: selector_version_label(selector: consumer.selector) as String,
              expected: added as String,
            },
          }
        }
      }
  }
}

fn proof_is_proven(outcome: ConsumerProofOutcome) -> Bool {
  match outcome {
    ConsumerProven { consumer: _, on_version: _ } => true
    ConsumerProofRefused { cause: _ } => false
  }
}

// ---------------------------------------------------------------------------
// The census: an identity join over a closed roster, never a count
// ---------------------------------------------------------------------------

// Completeness over the consumer roster is an identity join and not a count. Comparing how many
// consumers reported against how many were declared passes whenever one consumer reports twice and
// another not at all — and the silent one is precisely whose credential the retirement is about to
// break. So the census asks, per declared consumer NAME, whether that consumer produced evidence,
// and reports the missing ones by name. The roster is the closed subject universe the join runs
// over, which is what makes the join mean anything: an empty result over an EMPTY roster is not a
// finding that nothing consumes the secret, it is a finding that nobody wrote the roster down.
// These are three copies of one fold, and the duplication is deliberate rather than an oversight.
// The generic form — first_of<T>(items: List<T>) -> T? — was written first and is the shape this
// file wants; it does not survive inference, because the T? return is resolved to T, so every
// `match` over its result then sees the bare element type and reports Present/Absent as missing
// variants of it. That failure is silent at the call site and only surfaces as a variant-not-found
// error attributed to the ELEMENT type's declaration, which is a long way from the generic that
// caused it. Until generic Optional returns infer, a monomorphic copy per element type is the
// honest realization: it is redundant, it is marked as redundant here, and it dissolves the day
// the generic typechecks.
fn first_evidence(items: List<ConsumerVersionEvidence>) -> ConsumerVersionEvidence? {
  v2.std.algebra.fold_list(
    xs: items,
    empty: none,
    cons: fn(acc, x) {
      match acc {
        Present { value: v } => Present { value: v }
        Absent => Present { value: x }
      }
    }
  )
}

fn first_listed_version(items: List<extdeps.cloud.gcp.secret_manager.GcpSecretVersion>) -> extdeps.cloud.gcp.secret_manager.GcpSecretVersion? {
  v2.std.algebra.fold_list(
    xs: items,
    empty: none,
    cons: fn(acc, x) {
      match acc {
        Present { value: v } => Present { value: v }
        Absent => Present { value: x }
      }
    }
  )
}

fn first_string(items: List<String>) -> String? {
  v2.std.algebra.fold_list(
    xs: items,
    empty: none,
    cons: fn(acc, x) {
      match acc {
        Present { value: v } => Present { value: v }
        Absent => Present { value: x }
      }
    }
  )
}

fn evidence_for_consumer(
  evidence: List<ConsumerVersionEvidence>,
  name: ConsumerId,
) -> List<ConsumerVersionEvidence> {
  filter(evidence, e => (gunbc.auth.secret_rotation.evidence_consumer(evidence: e) as String) == (name as String))
}

// Selecting a consumer's evidence classifies rather than picks. The obvious implementation takes
// the first matching report, and first-wins is silently wrong in the case that matters most: two
// reports for one consumer, one saying it resolved the added version and one saying it resolved
// the prior, is a CONFLICT — the fleet disagrees with itself about where that consumer is — and
// first-wins answers whichever the list happened to order first, turning a contradiction into a
// verdict. Ambiguity is therefore its own arm with its own refusal, distinct from missing, because
// their remedies differ: missing means go and observe that consumer, ambiguous means find out
// which of two observations is stale or which two things are both answering to one name. Neither
// is a proof, and neither is silently resolved.
type ConsumerEvidenceSelection
  = EvidenceUnique { evidence: ConsumerVersionEvidence }
  | EvidenceMissing { consumer: ConsumerId }
  | EvidenceAmbiguous { consumer: ConsumerId, report_count: Int }

fn select_consumer_evidence(
  evidence: List<ConsumerVersionEvidence>,
  id: ConsumerId,
) -> ConsumerEvidenceSelection {
  let mine = evidence_for_consumer(evidence: evidence, name: id)
  let n = mine |> count
  if n == 0 {
    EvidenceMissing { consumer: id }
  } else {
    if n > 1 {
      EvidenceAmbiguous { consumer: id, report_count: n }
    } else {
      match first_evidence(items: mine) {
        Present { value: e } => EvidenceUnique { evidence: e }
        Absent => EvidenceMissing { consumer: id }
      }
    }
  }
}

fn consumer_reported(evidence: List<ConsumerVersionEvidence>, name: ConsumerId) -> Bool {
  (evidence_for_consumer(evidence: evidence, name: name) |> count) > 0
}

fn census_missing_consumers(
  requirement: ConsumerVerificationRequirement,
  evidence: List<ConsumerVersionEvidence>,
) -> List<ConsumerId> {
  filter(
    map(requirement.consumers, c => c.id),
    n => !consumer_reported(evidence: evidence, name: n),
  )
}

fn census_is_complete(
  requirement: ConsumerVerificationRequirement,
  evidence: List<ConsumerVersionEvidence>,
) -> Bool {
  (census_missing_consumers(requirement: requirement, evidence: evidence) |> count) == 0
}

fn prove_consumer_for(
  consumer: RotationConsumer,
  evidence: List<ConsumerVersionEvidence>,
  secret: extdeps.cloud.gcp.secret_ref.SecretRef,
  added: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity,
) -> ConsumerProofOutcome {
  match select_consumer_evidence(evidence: evidence, id: consumer.id) {
    EvidenceUnique { evidence: e } =>
      prove_consumer_on_version(consumer: consumer, evidence: e, secret: secret, added: added)
    EvidenceMissing { consumer: c } =>
      ConsumerProofRefused { cause: ConsumerEvidenceMissing { consumer: c } }
    EvidenceAmbiguous { consumer: c, report_count: n } =>
      ConsumerProofRefused { cause: ConsumerEvidenceAmbiguous { consumer: c, report_count: n } }
  }
}

fn all_consumer_proofs(
  requirement: ConsumerVerificationRequirement,
  evidence: List<ConsumerVersionEvidence>,
  secret: extdeps.cloud.gcp.secret_ref.SecretRef,
  added: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity,
) -> List<ConsumerProofOutcome> {
  map(
    requirement.consumers,
    c => prove_consumer_for(consumer: c, evidence: evidence, secret: secret, added: added),
  )
}

fn first_refusal_cause(outcomes: List<ConsumerProofOutcome>) -> ConsumerProofRefusal? {
  v2.std.algebra.fold_list(
    xs: outcomes,
    empty: none,
    cons: fn(acc, o) {
      match acc {
        Present { value: v } => Present { value: v }
        Absent => match o {
          ConsumerProofRefused { cause: c } => Present { value: c }
          ConsumerProven { consumer: _, on_version: _ } => Absent
        }
      }
    }
  )
}

// ---------------------------------------------------------------------------
// Version inventory: a page is not the population
// ---------------------------------------------------------------------------

// A truncated version list is a REFUSAL and not a shorter answer. ListVersions returns a page plus
// a continuation token, so a caller reading one page and asking which versions are still enabled
// has computed that answer over a prefix — and the versions likeliest to fall off the end are the
// OLDEST, exactly the retirement candidates. Rendering a truncated read as a complete inventory
// silently changes the question to `which versions did I happen to see` while the answer is still
// reported as `which versions exist`.
type VersionInventory
  = InventoryComplete { versions: List<extdeps.cloud.gcp.secret_manager.GcpSecretVersion> }
  | InventoryTruncated { seen: Int }

fn inventory_from_list_response(response: extdeps.cloud.gcp.secret_manager.ListSecretVersionsResponse) -> VersionInventory {
  match response.next_page_token {
    Present { value: token } =>
      if string_length(s: token) > 0 {
        InventoryTruncated { seen: response.versions |> count }
      } else {
        InventoryComplete { versions: response.versions }
      }
    Absent => InventoryComplete { versions: response.versions }
  }
}

fn version_is_enabled(listed: extdeps.cloud.gcp.secret_manager.GcpSecretVersion) -> Bool {
  match listed.state {
    SmEnabled => true
    SmDisabled => false
    SmDestroyed => false
  }
}

fn inventory_enabled_versions(inventory: VersionInventory) -> List<extdeps.cloud.gcp.secret_manager.GcpSecretVersion> {
  match inventory {
    InventoryComplete { versions: vs } => filter(vs, v => version_is_enabled(listed: v))
    InventoryTruncated { seen: _ } => []
  }
}

// ---------------------------------------------------------------------------
// AddVersion exactly once: retry identity comes from the attempt, never a re-add
// ---------------------------------------------------------------------------

// THE wall on the one operation that cannot be retried. AddVersion is not idempotent — every
// successful call mints a NEW version — so `retry by calling it again` does not converge, it
// sprawls, and each spurious version is a second live credential nobody is tracking. Retry
// identity therefore comes from a PERSISTED attempt record plus the resolved version identity,
// never from re-issuing the call. The state that matters is the third one: an attempt whose add
// was ISSUED but whose outcome was never seen. That is not `not started` and not `added`, and
// collapsing it into either is a real incident — collapsed into not-started it re-adds and
// sprawls, collapsed into added it invents an identity it never read. Its only correct resolution
// is to OBSERVE the store and find out what actually happened, which is why resolve_issued_attempt
// takes an inventory and refuses when the inventory cannot settle the question.
type RotationAttempt
  = AttemptNotStarted { intent_id: std.types.NonEmptyStr }
  | AttemptAddIssued { intent_id: std.types.NonEmptyStr }
  | AttemptAdded { intent_id: std.types.NonEmptyStr, added: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity }
  | AttemptCompleted { intent_id: std.types.NonEmptyStr, added: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity }

type AddAuthorization
  = AddVersionAuthorized { intent_id: std.types.NonEmptyStr }
  | AddVersionRefused { cause: AddRefusal }

type AddRefusal
  = AlreadyRotated { added: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity }
  | AddAlreadyIssued { intent_id: std.types.NonEmptyStr }
  | AddAlreadySucceeded { added: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity }

// Re-running a COMPLETED rotation answers AlreadyRotated carrying the version it produced, and
// does not mint another. This is the arm an operator hits by re-triggering a workflow they were
// not sure had run, and the naive behaviour — do the steps again — costs a spurious version and a
// second live credential every time. AlreadyRotated is a success-shaped answer rather than an
// error because nothing is wrong: the requested end state holds. It is nonetheless not `Rotated`,
// because saying so would claim this invocation established something it only found already true.
fn authorize_add_version(attempt: RotationAttempt) -> AddAuthorization {
  match attempt {
    AttemptNotStarted { intent_id: id } => AddVersionAuthorized { intent_id: id }
    AttemptAddIssued { intent_id: id } => AddVersionRefused { cause: AddAlreadyIssued { intent_id: id } }
    AttemptAdded { intent_id: _, added: a } => AddVersionRefused { cause: AddAlreadySucceeded { added: a } }
    AttemptCompleted { intent_id: _, added: a } => AddVersionRefused { cause: AlreadyRotated { added: a } }
  }
}

type IssuedAttemptResolution
  = IssuedAttemptDidAdd { added: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity }
  | IssuedAttemptDidNotAdd
  | IssuedAttemptUnresolvable { cause: std.types.NonEmptyStr }

// Resolving an add whose outcome was never seen, by observation rather than by assumption. The
// store is the only authority that knows whether the call landed, and the question it can answer
// is whether a version exists that this attempt would have created. A truncated inventory cannot
// answer it — the version may be on a page nobody read — so it refuses rather than reporting `did
// not add`, which would be the empty-observation narrow in the place it does the most damage: a
// false `did not add` authorizes a second AddVersion, which is exactly the sprawl this section
// exists to prevent.
fn resolve_issued_attempt(
  inventory: VersionInventory,
  expected: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity,
) -> IssuedAttemptResolution {
  match inventory {
    InventoryTruncated { seen: _ } =>
      IssuedAttemptUnresolvable {
        cause: "version inventory truncated; cannot establish whether the issued add landed" as std.types.NonEmptyStr,
      }
    InventoryComplete { versions: vs } =>
      match first_listed_version(items: filter(vs, v => listed_identity_is(listed: v, other: expected))) {
        Present { value: v } => IssuedAttemptDidAdd { added: v.name }
        Absent => IssuedAttemptDidNotAdd
      }
  }
}

// ---------------------------------------------------------------------------
// Read-back: the added version, and that its payload is the one written
// ---------------------------------------------------------------------------

// STATED PROPERTY OF THIS KERNEL, unconditional and not a judgement call: no rotation artifact
// stores a payload digest, for any subject, at any hash strength. The reasoning starts from low
// entropy — a hash of a short or published string is recovered by guessing, so a digest of it is
// credential material wearing a hash — but the rule is deliberately NOT scoped to low-entropy
// subjects, because scoping it that way would require the workflow to CLASSIFY the entropy of a
// value it is not supposed to be looking at, and a wrong classification publishes a crackable
// digest silently. There is no arm of PayloadIdentityVerdict that carries bytes or a digest, so
// the unsafe artifact has no representation to be written into rather than a rule someone must
// remember. What a later reader actually needs is not the value's fingerprint but whether the
// read-back matched what was written, and that verdict is unconditionally safe to keep.
// Verifying the replacement landed means reading the new version back and confirming its payload
// is the one written — and the verdict is what is kept. The comparison happens in flight, where
// both sides are already held, and only its verdict survives. PayloadIdentityUnverified is
// separate from a mismatch because they are different situations: a mismatch means the store holds
// something other than what was written and the rotation must stop, while unverified means the
// check did not run and nothing at all is known — and treating the second as the first would
// report a rotation as broken when it is merely unobserved, while treating the first as the second
// would let it proceed.
type PayloadIdentityVerdict
  = PayloadMatchesWritten
  | PayloadDiffersFromWritten
  | PayloadIdentityUnverified { cause: std.types.NonEmptyStr }

type ReadBackOutcome
  = ReadBackConfirmed { added: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity, payload: PayloadIdentityVerdict }
  | ReadBackRefused { cause: ReadBackRefusal }

type ReadBackRefusal
  = ReadBackIdentityRefused { cause: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentityRefusal }
  | ReadBackPayloadRefused { cause: extdeps.cloud.gcp.secret_manager.SmAccessVersionPayloadRefusal }
  | ReadBackIdentityMismatch { observed: String, expected: String }
  | ReadBackPayloadMismatch
  | ReadBackPayloadUnverified { cause: std.types.NonEmptyStr }

// Every refusal arm here BINDS its cause and carries it outward; none matches a typed refusal and
// drops it to `_`. That is stated as a rule because its violation is the incident this lane was
// created by: a production decode path matched the imported refusal, bound the cause to `_`, and
// returned a fabricated Secret as though the read had succeeded — so the caller could not tell a
// real credential from an invented one, and every witness over that code was true. The decode
// outcomes arriving from extdeps are already typed and located; the only way to lose that is to
// throw it away here.
fn verify_read_back(
  decoded: extdeps.cloud.gcp.secret_manager.SmAccessVersionWireDecodeOutcome,
  expected: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity,
  payload: PayloadIdentityVerdict,
) -> ReadBackOutcome {
  match decoded {
    SmAccessVersionWireDecodeRefused { identity_cause: ic, payload_cause: pc } =>
      match ic {
        Present { value: cause } => ReadBackRefused { cause: ReadBackIdentityRefused { cause: cause } }
        Absent =>
          match pc {
            Present { value: cause } => ReadBackRefused { cause: ReadBackPayloadRefused { cause: cause } }
            Absent =>
              ReadBackRefused {
                cause: ReadBackPayloadUnverified {
                  cause: "wire decode refused without naming a cause" as std.types.NonEmptyStr,
                },
              }
          }
      }
    SmAccessVersionWireDecoded { identity: identity, payload: _ } =>
      if !identity_is(identity: identity, other: expected) {
        ReadBackRefused {
          cause: ReadBackIdentityMismatch {
            observed: identity as String,
            expected: expected as String,
          },
        }
      } else {
        match payload {
          PayloadMatchesWritten =>
            ReadBackConfirmed { added: identity, payload: PayloadMatchesWritten }
          PayloadDiffersFromWritten => ReadBackRefused { cause: ReadBackPayloadMismatch }
          PayloadIdentityUnverified { cause: c } =>
            ReadBackRefused { cause: ReadBackPayloadUnverified { cause: c } }
        }
      }
  }
}

// ---------------------------------------------------------------------------
// Retirement: disable, then optionally destroy
// ---------------------------------------------------------------------------

// Disable precedes destroy because it is the REVERSIBLE form of it, and that is what turns the no-
// consumer confirmation into an observation instead of an assumption. A consumer nobody knew
// about, still holding the prior version, fails visibly the moment that version is disabled — and
// is restored by a single enable, which is why EnableVersion is modeled in extdeps rather than
// left out as unused. The disabled interval is an experiment whose quiet is the evidence a destroy
// depends on; running that experiment with destroy produces the same signal and no way back. It is
// also why disable is not skipped when every proof passes: the proofs cover the DECLARED roster,
// and the disabled interval is the only thing here that covers consumers the roster does not know
// about.
// A failed consumer check leaves the prior version ENABLED and refuses retirement. Stated as its
// own rule because the tempting shape is to disable anyway and watch what breaks — which is a
// rotation using production as its test harness, on a credential whose failure mode is losing
// access to the thing it authenticates. authorize_retirement returns no target at all on refusal,
// so there is nothing for a caller to pass to disable; the refusal cannot be mistaken for a target
// list of length zero, which would read as `nothing to disable` and be indistinguishable from
// success.
type RetirementAuthorization
  = RetirementAuthorized { targets: List<VersionTarget>, destroy_permitted: Bool }
  | RetirementRefused { cause: RetirementRefusal }

type RetirementRefusal
  = ConsumerNotProvenOnAddedVersion { cause: ConsumerProofRefusal }
  | ConsumerCensusIncomplete { missing: List<ConsumerId> }
  | InventoryIncomplete { seen: Int }
  | AddedVersionNotEnabled { added: String }
  | VersionEtagUnobserved { version: String }

fn authorize_retirement(
  intent: SecretRotationIntent,
  added: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity,
  evidence: List<ConsumerVersionEvidence>,
  inventory: VersionInventory,
) -> RetirementAuthorization {
  let missing = census_missing_consumers(requirement: intent.verification, evidence: evidence)
  if (missing |> count) > 0 {
    RetirementRefused { cause: ConsumerCensusIncomplete { missing: missing } }
  } else {
    match first_refusal_cause(
      outcomes: all_consumer_proofs(
        requirement: intent.verification,
        evidence: evidence,
        secret: intent.subject,
        added: added,
      ),
    ) {
      Present { value: cause } =>
        RetirementRefused { cause: ConsumerNotProvenOnAddedVersion { cause: cause } }
      Absent =>
        match inventory {
          InventoryTruncated { seen: seen } =>
            RetirementRefused { cause: InventoryIncomplete { seen: seen } }
          InventoryComplete { versions: versions } => {
            let enabled = filter(versions, v => version_is_enabled(listed: v))
            if (filter(enabled, v => listed_identity_is(listed: v, other: added)) |> count) == 0 {
              RetirementRefused { cause: AddedVersionNotEnabled { added: added as String } }
            } else {
              let prior = filter(enabled, v => !listed_identity_is(listed: v, other: added))
              match first_listed_version(items: filter(prior, v => !version_has_etag(listed: v))) {
                Present { value: v } =>
                  RetirementRefused { cause: VersionEtagUnobserved { version: v.name as String } }
                Absent =>
                  RetirementAuthorized {
                    targets: map(prior, v => version_target_of(listed: v)),
                    destroy_permitted: retirement_permits_destroy(policy: intent.retirement),
                  }
              }
            }
          }
        }
    }
  }
}

fn retirement_permits_destroy(policy: RetirementPolicy) -> Bool {
  match policy {
    DisableOnly => false
    DisableThenDestroy => true
  }
}

// Retirement refuses when the added version is not among the enabled ones, and the arm earns its
// own variant by what it catches: an add that silently did not take, or took against a different
// secret, would otherwise let the rotation disable every enabled version it CAN see — which is
// every version the consumers are actually using — leaving the subject with nothing enabled at
// all. The consumer proofs do not cover this, because a consumer proven on a version by an exact-
// pin success says nothing about whether that version is enabled in the store as it reads now. Two
// observations of one subject that were never joined is the presupposition failure this fleet has
// hit before, so the join is performed rather than assumed.
// ---------------------------------------------------------------------------
// The destroy gate: silence is not confirmation
// ---------------------------------------------------------------------------

// The gate on the one irreversible step, written as an obstacle SEARCH so its failure names what
// is missing rather than returning false. The inventory must be complete, or the versions being
// destroyed were chosen from a page. No version this rotation disabled may be observed enabled
// again, because something re-enabling a disabled version is a consumer signalling need in the
// loudest form available. The census must be complete with every consumer proven on the added
// version. And the policy must actually permit destruction, so a DisableOnly intent cannot reach
// it by any path. The arm carrying the point is the one that fires when the census reached nobody:
// a census contacting no one produces no complaints, so a gate reading `no consumer reported a
// problem` as `no consumer exists` is maximally confident exactly when it is maximally ignorant.
type NoConsumerObstacle
  = DestroyNotPermittedByPolicy
  | InventoryWasTruncated { seen: Int }
  | PriorVersionReEnabled { version: String }
  | CensusReachedNoOne { roster_size: Int }
  | CensusMissedConsumers { missing: List<ConsumerId> }
  | ConsumerNotProvenForDestroy { cause: ConsumerProofRefusal }

fn re_enabled_prior_version(
  inventory: VersionInventory,
  disabled: List<VersionTarget>,
) -> String? {
  let enabled = inventory_enabled_versions(inventory: inventory)
  first_string(
    items: map(
      filter(
        disabled,
        d => (filter(enabled, v => listed_identity_is(listed: v, other: d.identity)) |> count) > 0,
      ),
      d => d.identity as String,
    ),
  )
}

fn first_no_consumer_obstacle(
  intent: SecretRotationIntent,
  evidence: List<ConsumerVersionEvidence>,
  inventory: VersionInventory,
  added: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity,
  disabled: List<VersionTarget>,
) -> NoConsumerObstacle? {
  if !retirement_permits_destroy(policy: intent.retirement) {
    Present { value: DestroyNotPermittedByPolicy }
  } else {
    match inventory {
      InventoryTruncated { seen: seen } => Present { value: InventoryWasTruncated { seen: seen } }
      InventoryComplete { versions: _ } =>
        match re_enabled_prior_version(inventory: inventory, disabled: disabled) {
          Present { value: v } => Present { value: PriorVersionReEnabled { version: v } }
          Absent => {
            let roster_size = intent.verification.consumers |> count
            if roster_size == 0 {
              Present { value: CensusReachedNoOne { roster_size: 0 } }
            } else {
              if (evidence |> count) == 0 {
                Present { value: CensusReachedNoOne { roster_size: roster_size } }
              } else {
                let missing = census_missing_consumers(
                  requirement: intent.verification,
                  evidence: evidence,
                )
                if (missing |> count) > 0 {
                  Present { value: CensusMissedConsumers { missing: missing } }
                } else {
                  match first_refusal_cause(
                    outcomes: all_consumer_proofs(
                      requirement: intent.verification,
                      evidence: evidence,
                      secret: intent.subject,
                      added: added,
                    ),
                  ) {
                    Present { value: c } => Present { value: ConsumerNotProvenForDestroy { cause: c } }
                    Absent => Absent
                  }
                }
              }
            }
          }
        }
    }
  }
}

type DestroyAuthorization
  = DestroyAuthorized { targets: List<VersionTarget> }
  | DestroyRefused { cause: NoConsumerObstacle }

fn authorize_destroy(
  intent: SecretRotationIntent,
  evidence: List<ConsumerVersionEvidence>,
  inventory: VersionInventory,
  added: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity,
  disabled: List<VersionTarget>,
) -> DestroyAuthorization {
  match first_no_consumer_obstacle(
    intent: intent,
    evidence: evidence,
    inventory: inventory,
    added: added,
    disabled: disabled,
  ) {
    Present { value: o } => DestroyRefused { cause: o }
    Absent => DestroyAuthorized { targets: disabled }
  }
}

// ---------------------------------------------------------------------------
// Standings: what is true afterwards, kept apart
// ---------------------------------------------------------------------------

// Branch cleanliness and credential revocation are SEPARATE standings and neither implies the
// other. Removing a value from a branch, a history, or a build artifact changes what a future
// reader can find; it does nothing whatever to a credential that upstream still accepts, and
// anyone who already read it still holds it. Conversely a revoked credential can sit in history
// forever and be harmless. They are carried as two fields precisely so that no projection can
// quietly compute one from the other, because the failure they guard against is a report that says
// `cleaned` and is read as `safe`. CredentialStandingUnknown is not a middle value between live
// and revoked — it means nobody looked, and it is deliberately not satisfiable by the absence of
// evidence.
type BranchStanding
  = BranchCleaned
  | BranchNotCleaned
  | BranchStandingUnknown { cause: std.types.NonEmptyStr }

type CredentialStanding
  = PriorCredentialDisabled
  | PriorCredentialDestroyed
  | PriorCredentialStillLive
  | CredentialStandingUnknown { cause: std.types.NonEmptyStr }

// ---------------------------------------------------------------------------
// The receipt
// ---------------------------------------------------------------------------

// The receipt records identities, verdicts and standings — and no payload, in any encoding, at any
// strength, per the stated no-digest property above. It carries the resolved identity of the
// version added and of the versions retired, because those are names rather than secrets; it
// carries the payload-identity VERDICT; and it carries the two standings separately. A receipt is
// written to be read later by someone deciding whether this rotation is finished, which is exactly
// the audience that must not be handed the value.
type SecretRotationOutcome
  = Rotated { receipt: SecretRotationReceipt }
  | RotationAlreadyComplete { added: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity }
  | RotationRefused { cause: RotationRefusal }

type RotationRefusal
  = AddRefused { cause: AddRefusal }
  | ReadBackFailed { cause: ReadBackRefusal }
  | RetirementNotAuthorized { cause: RetirementRefusal }
  | DestroyNotAuthorized { cause: NoConsumerObstacle }
  | IssuedAddUnresolved { cause: std.types.NonEmptyStr }

type SecretRotationReceipt {
  intent_id: std.types.NonEmptyStr
  subject: extdeps.cloud.gcp.secret_ref.SecretRef
  prior_version: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity
  added_version: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity
  payload_identity: PayloadIdentityVerdict
  consumer_proofs: List<ConsumerProofOutcome>
  disabled_versions: List<extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity>
  destroyed_versions: List<extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity>
  credential_standing: CredentialStanding
  branch_standing: BranchStanding
}

fn rotation_is_rotated(outcome: SecretRotationOutcome) -> Bool {
  match outcome {
    Rotated { receipt: _ } => true
    RotationAlreadyComplete { added: _ } => false
    RotationRefused { cause: _ } => false
  }
}

// Whether a retirement was APPLIED is a different fact from whether it was authorized, and this
// type is the one that must not be assertable. An authorization is a PLAN — it says which versions
// may be retired — and a plan cannot be evidence that anything happened. So RetirementApplied is
// reachable only through receipts, and a receipt is admitted only from an operation response that
// CONFIRMS the state it claims: a disable receipt whose observed state is not SmDisabled is
// refused, and a destroy receipt whose observed state is not SmDestroyed is refused. That is what
// stops `we asked, therefore it is done` — the failure mode of every retirement step that reports
// success from having issued a call rather than from having observed its result. HONEST RESIDUAL,
// the same one this repository's other construction walls carry: .dag has no visibility modifiers
// today, so a caller can hand-write a receipt record with a state field that says SmDisabled. That
// is a deliberate lie rather than an accident, and it closes when node/subtree visibility grants
// make these constructors private to this module.
type DisableReceipt {
  version: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity
  observed_state: extdeps.cloud.gcp.secret_manager.SmVersionState
}

type DestroyReceipt {
  version: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity
  observed_state: extdeps.cloud.gcp.secret_manager.SmVersionState
}

fn admit_disable_receipt(
  version: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity,
  observed_state: extdeps.cloud.gcp.secret_manager.SmVersionState,
) -> DisableReceipt? {
  match observed_state {
    SmDisabled => Present { value: DisableReceipt { version: version, observed_state: observed_state } }
    SmEnabled => Absent
    SmDestroyed => Absent
  }
}

fn admit_destroy_receipt(
  version: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity,
  observed_state: extdeps.cloud.gcp.secret_manager.SmVersionState,
) -> DestroyReceipt? {
  match observed_state {
    SmDestroyed => Present { value: DestroyReceipt { version: version, observed_state: observed_state } }
    SmEnabled => Absent
    SmDisabled => Absent
  }
}

type RetirementEffect
  = RetirementApplied { disabled: List<DisableReceipt>, destroyed: List<DestroyReceipt> }
  | RetirementNotAttempted { cause: std.types.NonEmptyStr }

fn credential_standing_for_effect(effect: RetirementEffect) -> CredentialStanding {
  match effect {
    RetirementNotAttempted { cause: _ } => PriorCredentialStillLive
    RetirementApplied { disabled: disabled, destroyed: destroyed } =>
      if (destroyed |> count) > 0 {
        PriorCredentialDestroyed
      } else {
        if (disabled |> count) > 0 {
          PriorCredentialDisabled
        } else {
          CredentialStandingUnknown {
            cause: "retirement reported applied but carried no effect receipt" as std.types.NonEmptyStr,
          }
        }
      }
  }
}

fn retirement_disabled_versions(effect: RetirementEffect) -> List<extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity> {
  match effect {
    RetirementApplied { disabled: disabled, destroyed: _ } => map(disabled, d => d.version)
    RetirementNotAttempted { cause: _ } => []
  }
}

fn retirement_destroyed_versions(effect: RetirementEffect) -> List<extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity> {
  match effect {
    RetirementApplied { disabled: _, destroyed: destroyed } => map(destroyed, d => d.version)
    RetirementNotAttempted { cause: _ } => []
  }
}

// The receipt is ASSEMBLED here rather than declared and left for a caller to fill, so that every
// field is populated from something the rotation actually established and none can be supplied by
// hand at the call site. It takes the confirmed read-back rather than a bare identity, which is
// what ties the added version and its payload verdict to the same observation — a receipt whose
// added version and payload verdict came from two unrelated places would be exactly the unjoined-
// observations failure this kernel refuses elsewhere. Nothing here reads a payload, and there is
// no parameter through which one could be passed.
fn emit_rotation_receipt(
  intent: SecretRotationIntent,
  read_back: ReadBackOutcome,
  proofs: List<ConsumerProofOutcome>,
  effect: RetirementEffect,
  branch: BranchStanding,
) -> SecretRotationOutcome {
  match read_back {
    ReadBackRefused { cause: c } => RotationRefused { cause: ReadBackFailed { cause: c } }
    ReadBackConfirmed { added: added, payload: payload } =>
      Rotated {
        receipt: SecretRotationReceipt {
          intent_id: intent.intent_id,
          subject: intent.subject,
          prior_version: intent.prior_version,
          added_version: added,
          payload_identity: payload,
          consumer_proofs: proofs,
          disabled_versions: retirement_disabled_versions(effect: effect),
          destroyed_versions: retirement_destroyed_versions(effect: effect),
          credential_standing: credential_standing_for_effect(effect: effect),
          branch_standing: branch,
        },
      }
  }
}

// ---------------------------------------------------------------------------
// The forbidden arms, written down so a gate can reject them
// ---------------------------------------------------------------------------

// The forbidden arm as an executable declaration: destroy gated on the ABSENCE of a complaint. Run
// the census, and if nothing came back saying a consumer is still on a prior version, destroy. It
// is not a strawman — it is what a hand-run rotation does, because an operator who checks the two
// services they remember and sees both working has performed exactly this fold. The divergence
// from the authority is one arm and it is invisible at the call site: this and authorize_destroy
// agree on every input where the census reached someone, and part company precisely where it
// reached no one, which is where this one is most confident.
fn destroy_on_silence_sketch(
  intent: SecretRotationIntent,
  evidence: List<ConsumerVersionEvidence>,
  added: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity,
) -> Bool {
  let complaints = filter(
    intent.verification.consumers,
    c => match select_consumer_evidence(evidence: evidence, id: c.id) {
      EvidenceUnique { evidence: e } =>
        !proof_is_proven(
          outcome: prove_consumer_on_version(
            consumer: c,
            evidence: e,
            secret: intent.subject,
            added: added,
          ),
        )
      _ => false
    },
  )
  (complaints |> count) == 0
}

// The second forbidden arm: take a consumer's success as proof it is on the added version without
// asking which version it read. A rotation built on this advances from verify to retire having
// established only that the secret still works — a fact equally true before the new version
// existed. Written down because the wall in prove_consumer_on_version is demonstrably a decision
// only if the thing it decides against is expressible.
fn alias_success_is_proof_sketch(evidence: ConsumerVersionEvidence) -> Bool {
  match evidence {
    ResolvedVersionObserved { consumer: _, resolved: _ } => true
    ConsumerReportedSuccessOnly { consumer: _ } => true
    ConsumerUnreachable { consumer: _, cause: _ } => false
  }
}

// The third forbidden arm, and the one that costs money and live credentials rather than
// confidence: retry by calling AddVersion again. It looks like every other retry in the fleet and
// it is the only one that mints a new object each time it runs, so an issued-but-unconfirmed
// attempt retried this way leaves two new versions where the operator believes there is one.
// Written down beside authorize_add_version so the refusal there is provably a decision.
fn retry_by_re_adding_sketch(attempt: RotationAttempt) -> Bool {
  match attempt {
    AttemptNotStarted { intent_id: _ } => true
    AttemptAddIssued { intent_id: _ } => true
    AttemptAdded { intent_id: _, added: _ } => true
    AttemptCompleted { intent_id: _, added: _ } => true
  }
}

// ---------------------------------------------------------------------------
// Realization frontier
// ---------------------------------------------------------------------------
// The fourth forbidden arm, and it is the incident this lane replaces rather than a hypothetical:
// match the imported decode refusal, discard the cause, and answer as though the read succeeded.
// Written as a Bool over the decode outcome — `did I get something usable` — answering true on
// both arms, which is precisely what a production path does when it binds a typed refusal to `_`
// and returns a fabricated credential. Every witness over such a path can be true while the path
// is dangerous, so the control exists to be measured against verify_read_back, which answers
// differently on the refusal arm.
// What is modeled here is the SEQUENCE, its authorizations and its refusals; the actuation is
// declared, not stubbed. The extdeps operations the steps correspond to exist — AddVersion already
// did, and ListVersions, GetVersion, DisableVersion, EnableVersion and DestroyVersion landed
// beside it with this module — and the wire decoding is imported rather than re-derived. What does
// not exist yet on origin/main is the workload-identity federation authority actuation must bind
// to: `gunbc.github_actions_wif` is ABSENT from main (measured 2026-08-13). It exists only on
// origin/session/pi-reach-0, whose PR #7971 (PI-REACH-0) is CLOSED with mergedAt=null — the lane is
// dead, not in flight. The prior note claiming an "unmerged branch" you could wait on was stale.
// Revival onto a live branch versus authoring fresh rows is an OPERATOR decision; this module
// names the symbols actuation must import from `gunbc.github_actions_wif` once that authority
// exists (`github_actions_wif_pool`, `github_actions_wif_provider`,
// `github_actions_wif_provider_resource`, `github_actions_wif_attribute_condition`,
// `github_actions_wif_principal_set`) and deliberately does NOT copy them here. Until that
// authority exists on main, actuation on OPERATOR WORKSTATIONS (local gunbc run / dashboard
// dispatch — hosts with gcloud user session) uses `GcloudPrintToken` via
// `gunbc.auth.secret_rotation_actuate`. GHA self-hosted runner slots do NOT carry gcloud; rotation
// actuation there must bind `gunbc.github_actions_wif` once that authority lands — never
// `GcloudPrintToken`, never a pasted operator token (ACCESS_TOKEN_TYPE_UNSUPPORTED upstream).
// The other absence is consumer evidence: fleet consumers must report
// `ResolvedVersionObserved` from credential fetch paths — see `gunbc.spark.credential_workflow`.
// Both absences are loud rather than defaulted.
fn decode_refusal_is_usable_sketch(decoded: extdeps.cloud.gcp.secret_manager.SmAccessVersionWireDecodeOutcome) -> Bool {
  match decoded {
    SmAccessVersionWireDecoded { identity: _, payload: _ } => true
    SmAccessVersionWireDecodeRefused { identity_cause: _, payload_cause: _ } => true
  }
}
