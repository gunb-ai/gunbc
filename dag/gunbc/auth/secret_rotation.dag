module gunbc.auth.secret_rotation

import std.types { String, NonEmptyStr, Bool, Int, List }
import extdeps.cloud.gcp.secret_ref { SecretRef, secret_ref_version_resource }
import extdeps.cloud.gcp.secret_manager {
  GcpSecretVersion,
  ListSecretVersionsResponse,
  SmVersionState,
  SmEnabled,
  SmDisabled,
  SmDestroyed,
}

data secret_rotation_authority_note: String = "The rotation lifecycle for a WIF-backed secret, held once and parameterized by the secret rather than written per credential. The four steps are add a version, prove the consumers are on it, disable what they were on before, and destroy that only after confirming nothing consumes it — and the ORDER is the whole content, because each step is the evidence the next one needs. What the model carried before this was the two ends and not the sequence: extdeps.cloud.gcp.secret_manager could add a version and gunbc.auth.materialized_secret could bracket a use of one, while disable, destroy and list did not exist as operations at all and every rotation this fleet has performed was hand-run. This module is the workflow half; the interface half is the version lifecycle now carried in extdeps beside AddVersion, per the layer rule that extdeps owns the dependency's contract while which consumers must be proven, and how completely, is a workflow fact."

data rotation_is_not_a_schedule_note: String = "Deliberately NOT modeled here: when to rotate. extdeps.cloud.gcp.secret_manager.SmRotationSchedule already carries the upstream's own next_rotation_time and rotation_period_seconds, and a second cadence authority in this module would be nicknaming applied to time. What this module owns is the SAFETY of a rotation once one is underway, which is orthogonal to its trigger — an emergency rotation after a leak and a scheduled ninety-day one traverse identical stages gated by identical evidence."

// ---------------------------------------------------------------------------
// Version identity: the alias is the discriminating fact
// ---------------------------------------------------------------------------

data version_selector_note: String = "SecretRef.version is a NonEmptyStr and upstream admits exactly two kinds of value in it — a version number, or the moving alias `latest`. Those are not two spellings of one thing, and the difference is what makes a rotation provable at all: a number denotes ONE immutable payload forever, while `latest` denotes whatever the most recent enabled version happens to be at the instant it is resolved, so the same string means a different secret before and after an add-version. Two arms and no third: a malformed selector is not a state this classifier can helpfully invent, because upstream answers an unknown version name with a 404 that is already loud and located, and minting an `UnrecognizedSelector` arm here would stand a second, weaker validator in front of a refusal the transport already performs correctly."

type SecretVersionSelector
  = ExactVersion { number: NonEmptyStr }
  | AliasLatest

data latest_alias_literal: NonEmptyStr = "latest"

fn classify_version_selector(version: NonEmptyStr) -> SecretVersionSelector {
  if (version as String) == (latest_alias_literal as String) {
    AliasLatest
  } else {
    ExactVersion { number: version }
  }
}

fn secret_ref_selector(ref: SecretRef) -> SecretVersionSelector {
  classify_version_selector(version: ref.version)
}

fn selector_is_alias(selector: SecretVersionSelector) -> Bool {
  match selector {
    AliasLatest => true
    ExactVersion { number: _ } => false
  }
}

fn selector_pins_version(selector: SecretVersionSelector, version: NonEmptyStr) -> Bool {
  match selector {
    ExactVersion { number: n } => (n as String) == (version as String)
    AliasLatest => false
  }
}

fn selector_version_label(selector: SecretVersionSelector) -> NonEmptyStr {
  match selector {
    ExactVersion { number: n } => n
    AliasLatest => latest_alias_literal
  }
}

// ---------------------------------------------------------------------------
// Version resource names, built rather than parsed
// ---------------------------------------------------------------------------

data version_resource_join_note: String = "The join between a version number a caller holds and the full resource path upstream reports is performed by CONSTRUCTING the expected name, never by splitting the reported one. Both directions would decide the same question and only one of them is total: `projects/p/secrets/s/versions/3` is built from its parts by a function that cannot fail, while recovering `3` from it requires a split that has to answer what to do with a name carrying no separator — an arm that exists only because the direction was chosen wrongly. Building also keeps the RESULT in the form the operations need, since DisableVersion and DestroyVersion take the full resource name as their subject, so the disabled list this module carries forward is already the argument the destroy step passes rather than a number some later step has to re-expand."

fn secret_version_at(secret: SecretRef, version: NonEmptyStr) -> SecretRef {
  SecretRef {
    project: secret.project,
    secret: secret.secret,
    version: version,
    hash_state: secret.hash_state,
  }
}

fn version_resource_of(secret: SecretRef, version: NonEmptyStr) -> String {
  secret_ref_version_resource(ref: secret_version_at(secret: secret, version: version))
}

fn version_named(listed: GcpSecretVersion, secret: SecretRef, version: NonEmptyStr) -> Bool {
  listed.name == version_resource_of(secret: secret, version: version)
}

// ---------------------------------------------------------------------------
// Consumers and the evidence they produce
// ---------------------------------------------------------------------------

type RotationConsumer {
  name: NonEmptyStr
  selector: SecretVersionSelector
}

data consumer_evidence_note: String = "What a consumer can tell a rotation, as three distinguishable answers rather than a Bool. The middle arm is the one this module exists to refuse: a consumer that reports it authenticated successfully but never names the version it read has produced a green compatible with EVERY version of the secret, including the one the rotation is about to disable. Collapsing that arm into the first would rest a rotation's central claim — the consumer is on the new version — on evidence that cannot distinguish the new version from the old. The third arm stays separate from a negative answer for the reason the empty-observation narrow names: a consumer that could not be reached has not reported that it is fine, and a rotation reading silence as assent destroys a version nobody proved was unused."

type ConsumerVersionEvidence
  = ResolvedVersionObserved { consumer: NonEmptyStr, resolved: NonEmptyStr }
  | ConsumerReportedSuccessOnly { consumer: NonEmptyStr }
  | ConsumerUnreachable { consumer: NonEmptyStr, cause: NonEmptyStr }

fn evidence_consumer(evidence: ConsumerVersionEvidence) -> NonEmptyStr {
  match evidence {
    ResolvedVersionObserved { consumer: c, resolved: _ } => c
    ConsumerReportedSuccessOnly { consumer: c } => c
    ConsumerUnreachable { consumer: c, cause: _ } => c
  }
}

type ConsumerProofRefusal
  = ResolvedVersionUnobserved { consumer: NonEmptyStr }
  | ConsumerOnOtherVersion { consumer: NonEmptyStr, observed: NonEmptyStr, expected: NonEmptyStr }
  | ConsumerObservationFailed { consumer: NonEmptyStr, cause: NonEmptyStr }

type ConsumerProofOutcome
  = ConsumerProven { consumer: NonEmptyStr, on_version: NonEmptyStr }
  | ConsumerProofRefused { cause: ConsumerProofRefusal }

data consumer_proof_note: String = "The proof rule, and its case split is over what the evidence can DISTINGUISH rather than over whether the evidence is positive. A consumer that names the version it resolved is proven or refuted directly, whatever it selects with — an alias-pinned consumer reporting that it resolved version 3 really is on version 3, and refusing it for the shape of its pin would refuse a fact that was actually observed. A consumer reporting only success is proven exactly when its own selector is an exact pin on the added version, because then success against that pin IS a statement about that version and nothing else. The single remaining combination — success-only, selected through `latest` — carries no version information at all and is refused. That combination is not hypothetical: it is the shape every consumer of this fleet's BMC credential has today. The refusal names the consumer so the remedy is locatable, and the remedy is to change the consumer, never to weaken the rule."

fn prove_consumer_on_version(
  consumer: RotationConsumer,
  evidence: ConsumerVersionEvidence,
  added: NonEmptyStr,
) -> ConsumerProofOutcome {
  match evidence {
    ConsumerUnreachable { consumer: c, cause: cause } =>
      ConsumerProofRefused { cause: ConsumerObservationFailed { consumer: c, cause: cause } }
    ResolvedVersionObserved { consumer: c, resolved: r } =>
      if (r as String) == (added as String) {
        ConsumerProven { consumer: c, on_version: r }
      } else {
        ConsumerProofRefused {
          cause: ConsumerOnOtherVersion { consumer: c, observed: r, expected: added },
        }
      }
    ConsumerReportedSuccessOnly { consumer: c } =>
      if selector_pins_version(selector: consumer.selector, version: added) {
        ConsumerProven { consumer: c, on_version: added }
      } else {
        if selector_is_alias(selector: consumer.selector) {
          ConsumerProofRefused { cause: ResolvedVersionUnobserved { consumer: c } }
        } else {
          ConsumerProofRefused {
            cause: ConsumerOnOtherVersion {
              consumer: c,
              observed: selector_version_label(selector: consumer.selector),
              expected: added,
            },
          }
        }
      }
  }
}

fn proof_is_proven(outcome: ConsumerProofOutcome) -> Bool {
  match outcome {
    ConsumerProven { consumer: _, on_version: _ } => true
    ConsumerProofRefused { cause: _ } => false
  }
}

// ---------------------------------------------------------------------------
// The census: an identity join over a closed roster, never a count
// ---------------------------------------------------------------------------

data census_identity_join_note: String = "Completeness over the consumer roster is an identity join and not a count, which is the rule this repository applies to any population oracle. Comparing how many consumers reported against how many were declared passes whenever one consumer reports twice and another not at all — and the silent one is precisely the consumer whose credential the destroy is about to break. So the census asks, per declared consumer NAME, whether that consumer produced evidence, and reports the missing ones by name. The roster is the closed subject universe the join runs over, which is what makes the join mean anything: an empty result from a census over an EMPTY roster is not a finding that nothing consumes the secret, it is a finding that nobody wrote the roster down, and the destroy gate treats those two as different states."

type RotationConsumerRoster {
  secret: SecretRef
  consumers: List<RotationConsumer>
}

fn consumer_evidence_matches(evidence: ConsumerVersionEvidence, name: NonEmptyStr) -> Bool {
  (evidence_consumer(evidence: evidence) as String) == (name as String)
}

fn evidence_for_consumer(
  evidence: List<ConsumerVersionEvidence>,
  name: NonEmptyStr,
) -> List<ConsumerVersionEvidence> {
  filter(evidence, e => consumer_evidence_matches(evidence: e, name: name))
}

fn first_of<T>(items: List<T>) -> T? {
  fold_list(
    xs: items,
    empty: none,
    cons: fn(acc, x) {
      match acc {
        Present { value: v } => Present { value: v }
        Absent => Present { value: x }
      }
    }
  )
}

fn first_evidence(items: List<ConsumerVersionEvidence>) -> ConsumerVersionEvidence? {
  first_of(items: items)
}

fn consumer_reported(evidence: List<ConsumerVersionEvidence>, name: NonEmptyStr) -> Bool {
  (evidence_for_consumer(evidence: evidence, name: name) |> count) > 0
}

fn census_missing_consumers(
  roster: RotationConsumerRoster,
  evidence: List<ConsumerVersionEvidence>,
) -> List<NonEmptyStr> {
  filter(
    map(roster.consumers, c => c.name),
    n => !consumer_reported(evidence: evidence, name: n),
  )
}

fn census_is_complete(
  roster: RotationConsumerRoster,
  evidence: List<ConsumerVersionEvidence>,
) -> Bool {
  (census_missing_consumers(roster: roster, evidence: evidence) |> count) == 0
}

fn prove_consumer_for(
  consumer: RotationConsumer,
  evidence: List<ConsumerVersionEvidence>,
  added: NonEmptyStr,
) -> ConsumerProofOutcome {
  match first_evidence(items: evidence_for_consumer(evidence: evidence, name: consumer.name)) {
    Present { value: e } =>
      prove_consumer_on_version(consumer: consumer, evidence: e, added: added)
    Absent =>
      ConsumerProofRefused {
        cause: ConsumerObservationFailed {
          consumer: consumer.name,
          cause: "consumer produced no evidence in this census" as NonEmptyStr,
        },
      }
  }
}

fn all_consumer_proofs(
  roster: RotationConsumerRoster,
  evidence: List<ConsumerVersionEvidence>,
  added: NonEmptyStr,
) -> List<ConsumerProofOutcome> {
  map(roster.consumers, c => prove_consumer_for(consumer: c, evidence: evidence, added: added))
}

fn first_refusal_cause(outcomes: List<ConsumerProofOutcome>) -> ConsumerProofRefusal? {
  fold_list(
    xs: outcomes,
    empty: none,
    cons: fn(acc, o) {
      match acc {
        Present { value: v } => Present { value: v }
        Absent => match o {
          ConsumerProofRefused { cause: c } => Present { value: c }
          ConsumerProven { consumer: _, on_version: _ } => Absent
        }
      }
    }
  )
}

// ---------------------------------------------------------------------------
// Version inventory: a page is not the population
// ---------------------------------------------------------------------------

data inventory_truncation_note: String = "A truncated version list is a REFUSAL and not a shorter answer. ListVersions returns a page plus a continuation token, so a caller that reads one page and asks which versions are still enabled has computed that answer over a prefix — and the versions likeliest to fall off the end of a page are the OLDEST ones, exactly the ones a rotation is deciding whether to destroy. Rendering a truncated read as a complete inventory is the empty-observation narrow with pagination as its mechanism: the question silently becomes `which enabled versions did I happen to see` while the answer is still reported as `which enabled versions exist`."

type VersionInventory
  = InventoryComplete { versions: List<GcpSecretVersion> }
  | InventoryTruncated { seen: Int }

fn inventory_from_list_response(response: ListSecretVersionsResponse) -> VersionInventory {
  match response.next_page_token {
    Present { value: token } =>
      if string_length(s: token) > 0 {
        InventoryTruncated { seen: response.versions |> count }
      } else {
        InventoryComplete { versions: response.versions }
      }
    Absent => InventoryComplete { versions: response.versions }
  }
}

fn version_is_enabled(listed: GcpSecretVersion) -> Bool {
  match listed.state {
    SmEnabled => true
    SmDisabled => false
    SmDestroyed => false
  }
}

fn inventory_enabled_versions(inventory: VersionInventory) -> List<GcpSecretVersion> {
  match inventory {
    InventoryComplete { versions: vs } => filter(vs, v => version_is_enabled(listed: v))
    InventoryTruncated { seen: _ } => []
  }
}

// ---------------------------------------------------------------------------
// The staged rotation
// ---------------------------------------------------------------------------

type RotationStage
  = VersionAdded { added: NonEmptyStr }
  | ConsumersProven { added: NonEmptyStr, proofs: List<ConsumerProofOutcome> }
  | PriorDisabled { added: NonEmptyStr, disabled: List<String> }
  | PriorDestroyed { added: NonEmptyStr, destroyed: List<String> }

data stage_out_of_order_note: String = "StageOutOfOrder exists because the alternative was worse and it was written the worse way first. An advance handed a stage it does not accept has to refuse, and the tempting shortcut is to reuse whichever refusal is nearest to hand — the first draft answered a wrong-stage destroy with `census reached no one`, which is a fabricated finding about the census from a function that never looked at one. That is the state-space conflation this module spends its length arguing against, committed in its own control flow: two conditions with entirely different remedies (fix the caller's sequencing / go collect consumer evidence) rendered as one diagnostic. The variant carries which stage was expected so the refusal locates the caller's mistake rather than sending someone to look at the fleet."

type RotationRefusal
  = ConsumerNotProvenOnAddedVersion { cause: ConsumerProofRefusal }
  | ConsumerCensusIncomplete { missing: List<NonEmptyStr> }
  | InventoryIncomplete { seen: Int }
  | AddedVersionNotEnabled { added: NonEmptyStr }
  | DestroyWithoutNoConsumerConfirmation { cause: NoConsumerObstacle }
  | StageOutOfOrder { expected: NonEmptyStr }

type RotationAdvance
  = RotationAdvanced { stage: RotationStage }
  | RotationRefused { cause: RotationRefusal }

data stage_advance_note: String = "Each advance takes the PREVIOUS stage as an argument rather than a flag, so the sequence is carried by the type instead of by a caller remembering the order. A destroy cannot be reached from a rotation that has not disabled, because advance_to_destroyed accepts only a PriorDisabled stage and nothing produces one except a successful disable, which in turn accepts only ConsumersProven. That is the construction move the materialization bracket makes, applied to an ordering: the sequence is not re-checked at each step, it is the only shape the steps compose in. The honest residual is the same one that module records — .dag has no visibility modifiers today, so a caller can hand-write PriorDisabled { .. } and skip straight to the destroy gate. That is a deliberate lie rather than a slip, since it means naming the stage and building it, and it closes when node/subtree visibility grants land and these constructors become private."

fn advance_to_proven(
  stage: RotationStage,
  roster: RotationConsumerRoster,
  evidence: List<ConsumerVersionEvidence>,
) -> RotationAdvance {
  match stage {
    VersionAdded { added: added } => {
      let missing = census_missing_consumers(roster: roster, evidence: evidence)
      if (missing |> count) > 0 {
        RotationRefused { cause: ConsumerCensusIncomplete { missing: missing } }
      } else {
        let proofs = all_consumer_proofs(roster: roster, evidence: evidence, added: added)
        match first_refusal_cause(outcomes: proofs) {
          Present { value: cause } =>
            RotationRefused { cause: ConsumerNotProvenOnAddedVersion { cause: cause } }
          Absent =>
            RotationAdvanced { stage: ConsumersProven { added: added, proofs: proofs } }
        }
      }
    }
    _ => RotationRefused { cause: StageOutOfOrder { expected: "VersionAdded" as NonEmptyStr } }
  }
}

data disable_is_the_reversible_probe_note: String = "Disable sits between prove and destroy because it is the REVERSIBLE form of destroy, and that is what turns the no-consumer confirmation into an observation instead of an assumption. A consumer nobody knew about, still holding the prior version, fails visibly the moment that version is disabled — and is restored by a single enable, which is why EnableVersion is modeled in extdeps beside it rather than left out as unused. So the disabled interval is an experiment whose quiet is the evidence destroy needs. Running the same experiment with destroy would produce an identical signal and no way back. This is also why the step cannot be skipped when every proof passes: the proofs cover the DECLARED roster, and the disabled interval is the only thing in this sequence that covers the consumers the roster does not know about."

fn advance_to_disabled(stage: RotationStage, secret: SecretRef, inventory: VersionInventory) -> RotationAdvance {
  match stage {
    ConsumersProven { added: added, proofs: _ } =>
      match inventory {
        InventoryTruncated { seen: seen } =>
          RotationRefused { cause: InventoryIncomplete { seen: seen } }
        InventoryComplete { versions: versions } => {
          let enabled = filter(versions, v => version_is_enabled(listed: v))
          let added_live = filter(
            enabled,
            v => version_named(listed: v, secret: secret, version: added),
          )
          if (added_live |> count) == 0 {
            RotationRefused { cause: AddedVersionNotEnabled { added: added } }
          } else {
            let prior = filter(
              enabled,
              v => !version_named(listed: v, secret: secret, version: added),
            )
            RotationAdvanced {
              stage: PriorDisabled { added: added, disabled: map(prior, v => v.name) },
            }
          }
        }
      }
    _ => RotationRefused { cause: StageOutOfOrder { expected: "ConsumersProven" as NonEmptyStr } }
  }
}

data added_version_not_enabled_note: String = "Disable refuses when the added version is not among the enabled ones, and the arm is worth its own variant because of what it catches: a rotation whose add-version silently did not take, or took against a different secret, would otherwise proceed to disable every enabled version it CAN see — which is every version the consumers are actually using — leaving the secret with nothing enabled at all. The proofs do not cover this, because a consumer proven on version 3 by an exact-pin success says nothing about whether version 3 is enabled in the store the rotation is now reading. Two observations of the same subject that were never joined is the presupposition failure this fleet has hit before, so the join is performed here rather than assumed."

// ---------------------------------------------------------------------------
// The destroy gate: silence is not confirmation
// ---------------------------------------------------------------------------

data no_consumer_confirmation_note: String = "The gate on the one irreversible step, written as an obstacle SEARCH rather than a satisfaction test so its failure arm names what is missing instead of returning false. Three things must hold together and each is a different way the confirmation can be hollow. The inventory must be complete, or the versions being destroyed were chosen from a page. No version this rotation disabled may be observed enabled again, because something re-enabling a disabled version is a consumer signalling need in the loudest form available — and reading that as noise would destroy the version whose absence was just demonstrated to matter. And the census must be complete over the roster with every consumer proven on the added version. The arm carrying this module's whole point is the one that fires when the census reached nobody: a census that contacted no one produces no negative reports, so a gate reading `no consumer reported a problem` as `no consumer exists` is maximally confident exactly when it is maximally ignorant."

type NoConsumerObstacle
  = InventoryWasTruncated { seen: Int }
  | PriorVersionReEnabled { version: String }
  | CensusReachedNoOne { roster_size: Int }
  | CensusMissedConsumers { missing: List<NonEmptyStr> }
  | ConsumerNotProvenForDestroy { cause: ConsumerProofRefusal }

fn re_enabled_prior_version(
  inventory: VersionInventory,
  disabled: List<String>,
) -> String? {
  let enabled_names = map(inventory_enabled_versions(inventory: inventory), v => v.name)
  first_of(
    items: filter(disabled, d => (filter(enabled_names, n => n == d) |> count) > 0),
  )
}

fn first_no_consumer_obstacle(
  roster: RotationConsumerRoster,
  evidence: List<ConsumerVersionEvidence>,
  inventory: VersionInventory,
  added: NonEmptyStr,
  disabled: List<String>,
) -> NoConsumerObstacle? {
  match inventory {
    InventoryTruncated { seen: seen } => Present { value: InventoryWasTruncated { seen: seen } }
    InventoryComplete { versions: _ } =>
      match re_enabled_prior_version(inventory: inventory, disabled: disabled) {
        Present { value: v } => Present { value: PriorVersionReEnabled { version: v } }
        Absent => {
          let roster_size = roster.consumers |> count
          if roster_size == 0 {
            Present { value: CensusReachedNoOne { roster_size: 0 } }
          } else {
            if (evidence |> count) == 0 {
              Present { value: CensusReachedNoOne { roster_size: roster_size } }
            } else {
              let missing = census_missing_consumers(roster: roster, evidence: evidence)
              if (missing |> count) > 0 {
                Present { value: CensusMissedConsumers { missing: missing } }
              } else {
                match first_refusal_cause(
                  outcomes: all_consumer_proofs(roster: roster, evidence: evidence, added: added),
                ) {
                  Present { value: c } =>
                    Present { value: ConsumerNotProvenForDestroy { cause: c } }
                  Absent => Absent
                }
              }
            }
          }
        }
      }
  }
}

fn advance_to_destroyed(
  stage: RotationStage,
  roster: RotationConsumerRoster,
  evidence: List<ConsumerVersionEvidence>,
  inventory: VersionInventory,
) -> RotationAdvance {
  match stage {
    PriorDisabled { added: added, disabled: disabled } =>
      match first_no_consumer_obstacle(
        roster: roster,
        evidence: evidence,
        inventory: inventory,
        added: added,
        disabled: disabled,
      ) {
        Present { value: o } =>
          RotationRefused { cause: DestroyWithoutNoConsumerConfirmation { cause: o } }
        Absent =>
          RotationAdvanced { stage: PriorDestroyed { added: added, destroyed: disabled } }
      }
    _ => RotationRefused { cause: StageOutOfOrder { expected: "PriorDisabled" as NonEmptyStr } }
  }
}

fn rotation_advanced(advance: RotationAdvance) -> Bool {
  match advance {
    RotationAdvanced { stage: _ } => true
    RotationRefused { cause: _ } => false
  }
}

fn advance_stage(advance: RotationAdvance) -> RotationStage? {
  match advance {
    RotationAdvanced { stage: s } => Present { value: s }
    RotationRefused { cause: _ } => Absent
  }
}

// ---------------------------------------------------------------------------
// The forbidden arms, written down so a gate can reject them
// ---------------------------------------------------------------------------

data destroy_on_silence_red_control_note: String = "The forbidden arm as an executable declaration, in the shape gunbc.auth.materialized_secret uses for its existence-only widen. This is destroy gated on the ABSENCE of a complaint: run the census, and if nothing came back saying a consumer is still on the prior version, destroy. It is not a strawman — it is what a hand-run rotation does, because an operator who checks the two services they remember and sees both working has performed exactly this fold. The divergence from the authority is one arm and it is invisible at the call site: this function and advance_to_destroyed agree on every input where the census actually reached someone, and part company precisely when it reached no one, which is the case where this one is most confident."

fn destroy_on_silence_sketch(
  roster: RotationConsumerRoster,
  evidence: List<ConsumerVersionEvidence>,
  added: NonEmptyStr,
) -> Bool {
  let complaints = filter(
    roster.consumers,
    c => match first_evidence(items: evidence_for_consumer(evidence: evidence, name: c.name)) {
      Present { value: e } =>
        !proof_is_proven(
          outcome: prove_consumer_on_version(consumer: c, evidence: e, added: added),
        )
      Absent => false
    },
  )
  (complaints |> count) == 0
}

data alias_proof_red_control_note: String = "The second forbidden arm: take a consumer's success as proof it is on the added version without asking which version it read. This is the shape every consumer of this fleet's BMC credential reports today, and a rotation built on it would advance from prove to disable having established only that the secret still works — a fact equally true before the new version existed. Written down because the wall in prove_consumer_on_version is demonstrably a decision only if the thing it decides against is expressible."

fn alias_success_is_proof_sketch(evidence: ConsumerVersionEvidence) -> Bool {
  match evidence {
    ResolvedVersionObserved { consumer: _, resolved: _ } => true
    ConsumerReportedSuccessOnly { consumer: _ } => true
    ConsumerUnreachable { consumer: _, cause: _ } => false
  }
}

// ---------------------------------------------------------------------------
// Realization frontier and the first discriminating consumer
// ---------------------------------------------------------------------------

data secret_rotation_realization_frontier_note: String = "What is modeled here is the SEQUENCE and its refusals; the actuation is declared, not stubbed. The extdeps operations the stages correspond to now exist — AddVersion already did, and ListVersions, GetVersion, DisableVersion, EnableVersion and DestroyVersion landed beside it with this module — but nothing in this tree drives them, for the reason gunbc.auth.materialized_secret records about its own binding leg: reaching Secret Manager at all still depends on the hand-pasted operator token the A2 reach-secrets gap names, and the consumer evidence this module folds over has no producer, because no consumer in this fleet reports the secret version it resolved. Both absences are loud rather than defaulted. A rotation driven today refuses at the prove stage for every consumer, which is the correct answer and not a hole in this model: the consumers cannot currently substantiate the claim a rotation has to make about them."

data first_discriminating_consumer_note: String = "bmc-srv3-admin is the first consumer that discriminates, and it discriminates by FAILING the wall rather than passing it. Its SecretRef pins `latest` and the BMC login it feeds through gunbc.srv3_bmc_credential_resolve reports an HTTP status with no version in it, so its evidence is ConsumerReportedSuccessOnly against an AliasLatest selector — the single combination prove_consumer_on_version refuses. That is the discriminating observation: the model says this credential cannot currently be rotated to v3 safely, and says so for a specific, locatable, fixable reason rather than out of general reluctance. The two remedies the refusal admits are both real work on the consumer and neither is a change to this module — pin the ref to an exact version so a success means something, or have the login path report the version it resolved. Recorded as a row rather than narrated in a plan so that the day the consumer changes, the thing that flips is a witness."

data bmc_srv3_admin_rotation_consumer: RotationConsumer = RotationConsumer {
  name: "bmc_assimilate_srv3" as NonEmptyStr,
  selector: AliasLatest,
}

data bmc_srv3_admin_target_version: NonEmptyStr = "3"

data bmc_srv3_admin_today_evidence: ConsumerVersionEvidence = ConsumerReportedSuccessOnly {
  consumer: "bmc_assimilate_srv3" as NonEmptyStr,
}

fn bmc_srv3_admin_proof_today() -> ConsumerProofOutcome {
  prove_consumer_on_version(
    consumer: bmc_srv3_admin_rotation_consumer,
    evidence: bmc_srv3_admin_today_evidence,
    added: bmc_srv3_admin_target_version,
  )
}
