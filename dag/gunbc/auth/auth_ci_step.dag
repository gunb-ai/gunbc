module gunbc.auth.auth_ci_step

// THE CI RUN-STEP LEAF OF THE AUTH DOMAIN'S GRANT AND IAM MODES: the `gunbc run` target and
// invoke of the gcp_iam converge/bootstrap-delta steps and the branch_run_grant request,
// await and apply steps, beside the domain whose entry modules they invoke
// (gunbc.auth.gcp_iam_converge_run, gunbc.auth.gcp_iam_bootstrap_delta_run,
// gunbc.auth.branch_run_grant). The shared run-step machinery is
// v2.workflow.gunbc_invoke_step_emit, gunbc.ci.ci_layer_roots and
// gunbc.ci.ci_run_step_target; the one shared key prelude is gunbc.auth.approval_ci_step.
// The roster stays in gunbc.ci.ci_spec, which imports these targets. A step module imports
// the shared machinery, never ci_spec.

import std.types { String }
import v2.workflow.gunbc_invoke_step_emit {
  gunbc_run_step_script_for_target,
}
import gunbc.ci.ci_run_step_target {
  gunbc_run_step_target,
  GunbcRunStepTarget,
}
import gunbc.ci.ci_layer_roots { witness_layer_roots }
import gunbc.auth.approval_ci_step { gunbc_ci_submission_key_invoke }

data gunbc_ci_branch_run_grant_request_target: GunbcRunStepTarget = gunbc_run_step_target(
  module: "gunbc.auth.branch_run_grant",
  function: "branch_run_grant_request_wet",
)

data gunbc_ci_branch_run_grant_apply_target: GunbcRunStepTarget = gunbc_run_step_target(
  module: "gunbc.auth.branch_run_grant",
  function: "branch_run_grant_apply_wet",
)

data gunbc_ci_branch_run_grant_await_target: GunbcRunStepTarget = gunbc_run_step_target(
  module: "gunbc.auth.branch_run_grant_await",
  function: "await_grant",
)

data gunbc_ci_gcp_iam_converge_request_target: GunbcRunStepTarget = gunbc_run_step_target(
  module: "gunbc.auth.gcp_iam_converge_run",
  function: "gcp_iam_converge_request_wet",
)

data gunbc_ci_gcp_iam_converge_apply_target: GunbcRunStepTarget = gunbc_run_step_target(
  module: "gunbc.auth.gcp_iam_converge_run",
  function: "gcp_iam_converge_apply_wet",
)

data gunbc_ci_gcp_iam_bootstrap_delta_request_target: GunbcRunStepTarget = gunbc_run_step_target(
  module: "gunbc.auth.gcp_iam_bootstrap_delta_run",
  function: "gcp_iam_bootstrap_delta_request_wet",
)

data gunbc_ci_gcp_iam_bootstrap_delta_apply_target: GunbcRunStepTarget = gunbc_run_step_target(
  module: "gunbc.auth.gcp_iam_bootstrap_delta_run",
  function: "gcp_iam_bootstrap_delta_apply_wet",
)

fn gunbc_ci_branch_run_grant_request_invoke() -> String {
  gunbc_run_step_script_for_target(
    source_roots: witness_layer_roots,
    target: gunbc_ci_branch_run_grant_request_target,
    claim_run: false,
    receipt_rel: none
  )
}

fn gunbc_ci_branch_run_grant_apply_invoke() -> String {
  gunbc_run_step_script_for_target(
    source_roots: witness_layer_roots,
    target: gunbc_ci_branch_run_grant_apply_target,
    claim_run: false,
    receipt_rel: none
  )
}

fn gunbc_ci_branch_run_grant_await_invoke() -> String {
  gunbc_run_step_script_for_target(
    source_roots: witness_layer_roots,
    target: gunbc_ci_branch_run_grant_await_target,
    claim_run: false,
    receipt_rel: none
  )
}

// THE D0 DOOR'S PRELUDE materializes the submission MAC key alone (the door signs one filing; it
// holds no BMC credential and no capability key): the shared auth header and SM decode, one
// pinned secret version to a 0600 file under RUNNER_TEMP, the trap armed before it touches disk.
// THE KEY IS FIRST-RUN-ONLY, SO ITS ABSENCE DOES NOT STOP THE DOOR: a lifecycle that already holds
// its durable claim resumes under the recorded decision and signs nothing, and the recovery #11555
// made total must not narrow to "recoverable while Secret Manager answers". A fetch that fails
// leaves the key path env unset and the door decides -- a run that must file refuses there with a
// typed cause (gunbc.auth.approval_gate approval_file_stored_request), a resume proceeds. The
// transport is the one shared fetch (gunbc_ci_sm_secret_to_dest_file_command), bounded inside the
// prelude allowance.

fn gunbc_ci_gcp_iam_converge_request_invoke() -> String {
  gunbc_ci_submission_key_invoke(stem: "gcp-iam-converge", target: gunbc_ci_gcp_iam_converge_request_target)
}

fn gunbc_ci_gcp_iam_bootstrap_delta_request_invoke() -> String {
  gunbc_ci_submission_key_invoke(stem: "gcp-iam-bootstrap-delta", target: gunbc_ci_gcp_iam_bootstrap_delta_request_target)
}

// THE APPLY STEP READS NO SECRET: both tokens arrive by the workflow's auth-step variables, and the
// recorded approval is read over the approval client's loopback status route.
fn gunbc_ci_gcp_iam_bootstrap_delta_apply_invoke() -> String {
  gunbc_run_step_script_for_target(
    source_roots: witness_layer_roots,
    target: gunbc_ci_gcp_iam_bootstrap_delta_apply_target,
    claim_run: false,
    receipt_rel: none
  )
}

fn gunbc_ci_gcp_iam_converge_apply_invoke() -> String {
  gunbc_run_step_script_for_target(
    source_roots: witness_layer_roots,
    target: gunbc_ci_gcp_iam_converge_apply_target,
    claim_run: false,
    receipt_rel: none
  )
}
