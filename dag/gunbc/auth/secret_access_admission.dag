module gunbc.auth.secret_access_admission

// LEAST PRIVILEGE IS DECIDED HERE, NOT AT THE WRITE. gunbc.auth.gcp_secret_access takes a
// SecretAccessGrant whose role is an open String, because the provider representation legitimately
// carries any role name Google has -- an IAM binding must be able to REPRESENT roles this fleet
// would never request, or the reconciler could not preserve a foreign binding it does not own.
//
// What must never happen is that representation being mistaken for permission. A request names the
// OPERATION it needs; this module decides which binding may be written for it. The role is
// DERIVED from an admitted request rather than accepted alongside one, so "which access" stops
// being a String a caller supplies and becomes an answer this module gives.
//
// THE TEST THAT SEPARATES THIS FROM A SUFFICIENCY CHECK, and the reason the excess arm exists:
// a role that grants the required permission AND ALSO grants setIamPolicy, destroy or add is
// SUFFICIENT and is not MINIMAL. Checking only that the role includes what the effect needs would
// admit roles/secretmanager.admin for a read, because admin does include versions.access. That is
// the whole failure this module exists to refuse, so the excess is computed and returned rather
// than the check stopping at sufficiency.
//
// THE PERMISSIONS COME FROM AN OBSERVATION, NEVER A TABLE. extdeps.cloud.gcp.iam states that a
// role's permission set is a Google-owned fact that changes without our involvement, and refuses to
// carry a hand-authored roster for exactly that reason. So this module consumes
// RolePermissionAuthority and inherits its three-valued verdict: an unobserved role is
// UNDETERMINED, never "does not grant", and undetermined refuses.
//
// RUNG: STRUCTURALLY GUARANTEED ON THE SOURCE-TO-.dag ACCEPTANCE PATH, via sole_constructor.
//
// AN EARLIER REVISION OF THIS PARAGRAPH CLAIMED THE OPPOSITE AND WAS WRONG. It said this could only
// be mechanically preventable because .dag has no module-private declaration, so nothing could stop
// a caller writing the admitted record literal by hand. That is false: `sole_constructor` exists and
// does exactly this job, and gunbc.durable_cas_file_store VerifiedCasAttempt is the precedent --
// "sole_constructor is the wall: admit_cas_attempt is the only mint, so no caller in any other
// module can produce a VerifiedCasAttempt by writing the record literal". The mechanism was in the
// tree the whole time; the claim was made from absence of recall rather than from a search, which is
// the same evidentiary mistake as reading absence-of-usage as absence-of-capability.
//
// So AdmittedSecretAccessGrant is sole_constructor and admit_secret_access is its only mint. A
// caller cannot hand-build one, cannot widen the role after admission, and cannot reach the write
// with a grant no admission produced -- the invalid state has no constructor rather than being
// checked for.
//
// AND THE CEILING IS SCOPED, following that same precedent rather than overclaiming past it: this is
// NOT claimed for the emitted-Rust path, where DESIGN records by execution that a sole_constructor
// type's emitted mirror is forgeable. That is a known gap in the wall itself and not a property of
// this carrier.
import extdeps.cloud.gcp.iam {
  RolePermissionAuthority, RolePermissionsObserved, RolePermissionsUnobserved,
}
import extdeps.cloud.gcp.secret_manager {
  SecretManagerEffect,
  secret_manager_effect_required_permissions,
  secret_manager_effect_secret,
}
import extdeps.cloud.gcp.secret_ref { SecretRef }
import gunbc.auth.gcp_secret_access { SecretAccessGrant, secret_access_ensure_for }
import gunbc.auth.access_token_source { AccessTokenSource }
import std.resources { Network }
import std.process { ProcessExit }
import std.types { NonEmptyStr, String, List }
import std.logic { Bool }

// The request states the EFFECT and the beneficiary. It does not state a role: naming one here
// would put the answer in the question, which is how an admin request gets to look like a read.
type SecretAccessRequest {
  effect: SecretManagerEffect
  target: SecretRef
  beneficiary: String
}

// WHY THE ADMITTED ARM CARRIES THE GRANT AND THE REQUEST TOGETHER. The consumer needs the binding
// to write; the reviewer of an incident needs to know which request produced it. Returning only the
// grant would make the binding traceable to nothing, and every later question about why a cell
// exists would be answered by guessing.
// WHAT SEALING THIS RECORD DOES AND DOES NOT ESTABLISH. sole_constructor means it cannot be built
// outside this module, so a caller holding a SecretAccessGrant it assembled itself cannot turn it
// into one of these: an arbitrary role has no route to a policy THROUGH THIS TYPE.
//
// It does NOT establish that every policy write is admitted. gcp_secret_access
// secret_access_ensure_for still takes a bare SecretAccessGrant and is still reachable -- the two
// operator-run control-plane converges call it directly, deliberately. So the honest claim is
// "admission is the only route on the REQUEST path", not "all writes require admission", and a
// broker built on this must not be given the second reading.
type AdmittedSecretAccessGrant sole_constructor {
  grant: SecretAccessGrant
  request: SecretAccessRequest
}

type SecretAccessAdmission
  = SecretAccessAdmitted { admitted: AdmittedSecretAccessGrant }
  | SecretAccessRoleInsufficient { role: String, missing: List<String> }
  | SecretAccessRoleGrantsExcessAuthority { role: String, excess: List<String> }
  | SecretAccessRoleUndetermined { role: String, cause: NonEmptyStr }
  | SecretAccessRoleScopeUnclassified { role: String, unclassified: List<String> }
  | SecretAccessBeneficiaryUnnamed
  | SecretAccessEffectResourceMismatch { effect_secret: String, target_secret: String }

fn permission_in(xs: List<String>, needle: String) -> Bool {
  fold(xs, init: false, f: (acc, x) => acc || x == needle)
}

// Required-but-absent. Sufficiency.
fn missing_permissions(required: List<String>, granted: List<String>) -> List<String> {
  required |> filter(p => !permission_in(xs: granted, needle: p))
}

// ── EXCESS IS MEASURED AT THE BOUND RESOURCE, NOT OVER THE WHOLE PERMISSION LIST ──────────────
// AN EARLIER REVISION OF THIS MODULE COMPUTED EXCESS AS granted-minus-required OVER THE RAW LIST,
// AND THAT WOULD HAVE REFUSED THE ONE ROLE IT EXISTS TO ADMIT. Google's real
// roles/secretmanager.secretAccessor carries resourcemanager.projects.get and
// resourcemanager.projects.list beside secretmanager.versions.access. Flat subtraction reports those
// two as excess authority over the secret and refuses the legitimate role.
//
// The first draft did not fail, which is the part worth recording: its fixture declared the accessor
// role with a single permission. A fabricated observation made a wrong rule look right -- the same
// defect class as the conditioned version-1 policy fixture corrected in gunbc#10514, in new code,
// one PR later. The rule is fixed here and the fixtures now carry the role as Google reports it.
//
// WHAT REPLACES IT is Google's own scoping rule: a role's permissions apply to the bound resource
// and its descendants, never to peer or higher-level resources. Binding a role AT ONE SECRET grants
// no project-level authority, so a project-scoped permission in the role is not authority over that
// secret and is not excess. Excess is the SECRET-SCOPED authority beyond what the effect requires.
//
// AND THE CLASSIFICATION FAILS CLOSED. A permission this model cannot place is not assumed harmless:
// PermissionScopeUnclassified is its own arm and refuses admission, because treating an unrecognised
// permission as out-of-scope is exactly the widening that would let a future service's
// secret-reaching permission through unread.
type PermissionResourceScope
  = PermissionScopedToSecret
  | PermissionScopedAboveSecret
  | PermissionScopeUnclassified

// GCP permission identifiers are service.resource.verb, which is structure Google publishes rather
// than a shape guessed here. secretmanager.* reaches the secret; resourcemanager.* addresses the
// project the binding is not made at. Anything else is unplaced and refuses.
fn permission_resource_scope(permission: String) -> PermissionResourceScope {
  if permission.starts_with("secretmanager.") {
    PermissionScopedToSecret
  } else if permission.starts_with("resourcemanager.") {
    PermissionScopedAboveSecret
  } else {
    PermissionScopeUnclassified
  }
}

fn permissions_with_scope(
  granted: List<String>,
  scope: PermissionResourceScope
) -> List<String> {
  granted |> filter(p => permission_scope_eq(a: permission_resource_scope(permission: p), b: scope))
}

fn permission_scope_eq(a: PermissionResourceScope, b: PermissionResourceScope) -> Bool {
  match a {
    PermissionScopedToSecret =>
      match b { PermissionScopedToSecret => true  PermissionScopedAboveSecret => false  PermissionScopeUnclassified => false }
    PermissionScopedAboveSecret =>
      match b { PermissionScopedToSecret => false  PermissionScopedAboveSecret => true  PermissionScopeUnclassified => false }
    PermissionScopeUnclassified =>
      match b { PermissionScopedToSecret => false  PermissionScopedAboveSecret => false  PermissionScopeUnclassified => true }
  }
}

// Secret-scoped authority the effect did not ask for. This is the minimum-privilege half.
fn excess_permissions(required: List<String>, granted: List<String>) -> List<String> {
  permissions_with_scope(granted: granted, scope: PermissionScopedToSecret)
    |> filter(p => !permission_in(xs: required, needle: p))
}

fn unclassified_permissions(granted: List<String>) -> List<String> {
  permissions_with_scope(granted: granted, scope: PermissionScopeUnclassified)
}

// THE EFFECT AND THE TARGET ARE TWO SEPARATE FIELDS, SO THEY CAN DISAGREE. A request may carry the
// effect "access a version of secret A" beside the target "secret B", and nothing upstream joins
// them: secret_manager_effect_required_permissions discards the effect's secret name on every arm,
// because the permission an effect needs does not depend on which secret it runs against. So the
// role derivation reads the EFFECT while the written binding reads the TARGET, and a disagreement
// between them produced a grant on B justified by a need on A -- silently, since every other arm of
// this function was satisfied. The mismatch is authorable, so it is refused rather than reconciled:
// picking either field as the winner would be a guess about which half of the request was the typo.
fn admit_secret_access(
  request: SecretAccessRequest,
  authority: RolePermissionAuthority
) -> SecretAccessAdmission {
  let effect_secret = secret_manager_effect_secret(e: request.effect)
  if request.beneficiary == "" {
    SecretAccessBeneficiaryUnnamed
  } else if (effect_secret as String) != (request.target.secret as String) {
    SecretAccessEffectResourceMismatch {
      effect_secret: effect_secret as String,
      target_secret: request.target.secret as String
    }
  } else {
    admit_observed_role(request: request, authority: authority)
  }
}

fn admit_observed_role(
  request: SecretAccessRequest,
  authority: RolePermissionAuthority
) -> SecretAccessAdmission {
  let required = secret_manager_effect_required_permissions(e: request.effect)
  match authority {
    RolePermissionsUnobserved { role_name: rn, cause: c } =>
      SecretAccessRoleUndetermined { role: rn as String, cause: c }
    RolePermissionsObserved { role: r, observed_at_revision: _ } => {
      let missing = missing_permissions(required: required, granted: r.included_permissions)
      let excess = excess_permissions(required: required, granted: r.included_permissions)
      let unplaced = unclassified_permissions(granted: r.included_permissions)
      if count(unplaced) > 0 {
        SecretAccessRoleScopeUnclassified { role: r.name, unclassified: unplaced }
      } else if count(missing) > 0 {
        SecretAccessRoleInsufficient { role: r.name, missing: missing }
      } else if count(excess) > 0 {
        SecretAccessRoleGrantsExcessAuthority { role: r.name, excess: excess }
      } else {
        SecretAccessAdmitted {
          admitted: AdmittedSecretAccessGrant {
            grant: SecretAccessGrant {
              target: request.target,
              role: r.name,
              condition: none
            },
            request: request
          }
        }
      }
    }
  }
}

// THE ONE ROUTE FROM AN ADMITTED GRANT TO A POLICY WRITE. gunbc.auth.gcp_secret_access
// secret_access_ensure_for takes a bare SecretAccessGrant, and it must keep doing so: the two
// operator-run control-plane converges are deliberate, reviewed, unconditioned accessor bindings
// that predate admission, and rewriting them to observe roles.get first would make a working
// convergence depend on a live API call for a fact already settled by review.
//
// What this entry adds is the route the REQUEST path takes, where the role is not settled in
// advance because a human is being asked to approve one. Its argument cannot be assembled by a
// caller, so nothing reaching this function carries a role that admission did not derive from an
// observation.
func secret_access_ensure_admitted(
  admitted: AdmittedSecretAccessGrant,
  token_source: AccessTokenSource
) -> ProcessExit
  uses net: Network
{
  secret_access_ensure_for(grant: admitted.grant, token_source: token_source)
}
