// ── A FLEET-CONVERGE RUN FROM A BRANCH, ADMITTED ONE RUN AT A TIME ─────────────────────────────
// The main-only federation (gunbc.auth.fleet_convergence_federation) keeps every account it reaches
// away from unreviewed code by pinning the workflow file and ref at main. That is the right wall for
// an account holding the fleet's secrets, and the wrong one for iterating on a controller: every
// change would need a merge before it could touch the thing it changes (operator, 2026-10-09).
//
// THIS POOL ADMITS A DISPATCH FROM ANY BRANCH AND GRANTS NOTHING BY ITSELF. Its provider pins the
// repository, its owner and a workflow_dispatch event, and maps the run id. No account binds the
// pool: a run-scoped federation's account (heal_publisher_provision RunScopedImpersonation) holds
// no standing impersonation cell. A run becomes able to act as the account only when
// gunbc.auth.branch_run_grant -- reviewed code, at main, as iam-converge -- writes a cell naming that
// run's id, under an IAM condition that expires, after the operator approved that exact run (its
// branch, its commit, its mode, read from GitHub rather than from the run) over ntfy.
//
// SO A BRANCH CAN NOT SKIP THE APPROVAL BY EDITING ITS WORKFLOW: the approval is not a step in the
// branch's run; without the cell no token from that run can be exchanged for the account at all.
//
// ONE ACCOUNT PER CAPABILITY. What an approved branch run reaches is only what its account holds, so
// a mistaken approval costs that capability and nothing else. The first is the Hetzner Cloud
// project token; another capability that needs branch iteration gets its own account here, never a
// widening of this one.
data branch_dispatch_wif_pool_id: NonEmptyStr = "github-fleet-converge-dispatch"

data branch_dispatch_wif_provider_id: NonEmptyStr = "gh-fleet-converge-dispatch-oidc"

data branch_dispatch_attribute_mapping: Map<String, String> = {
  "google.subject": "assertion.sub",
  "attribute.repository_id": "assertion.repository_id",
  "attribute.run": "assertion.run_id + '-' + assertion.run_attempt"
}

// THE REPOSITORY AND THE EVENT, AND NOT THE REF: the ref is the point of this pool. The repository
// pins are the main-only federation's own (one authority for the repository's numeric identity).
fn branch_dispatch_claim_pins() -> List<OidcClaimPin> {
  concat(
    filter(fleet_converge_workflow_claim_pins(), p => (p.claim as String) == "repository_id" || (p.claim as String) == "repository_owner_id"),
    [oidc_equals(claim: "event_name", value: workflow_dispatch_event_name)],
  )
}

fn branch_dispatch_attribute_condition() -> String {
  claim_pins_attribute_condition(pins: branch_dispatch_claim_pins())
}

fn branch_dispatch_provider() -> WifProvider {
  WifProvider {
    name: branch_dispatch_wif_provider_id,
    pool: branch_dispatch_wif_pool_id,
    issuer_uri: github_wif_issuer_uri,
    attribute_mapping: Present { value: branch_dispatch_attribute_mapping },
    attribute_condition: Present { value: branch_dispatch_attribute_condition() },
  }
}

fn branch_dispatch_provider_resource() -> String {
  wif_provider_resource(project_number: fleet_secrets_project_number, provider: branch_dispatch_provider())
}

// THE ONE RUN ATTEMPT A GRANT NAMES. GitHub keeps run_id across a re-run and increments run_attempt
// (both are claims of its OIDC token), so the provider maps their join and a grant names the join: a
// re-run of an approved run is a new subject and needs its own approval.
fn branch_run_key(run_id: GitHubWorkflowRunId, run_attempt: Int) -> String {
  join([github_workflow_run_id_wire_text(id: run_id), "-", to_string(run_attempt)], "")
}

fn branch_run_principal_set(run_id: GitHubWorkflowRunId, run_attempt: Int) -> String {
  join([
    "principalSet://iam.googleapis.com/",
    wif_pool_resource(project_number: fleet_secrets_project_number, pool_id: branch_dispatch_wif_pool_id as String),
    "/attribute.run/", branch_run_key(run_id: run_id, run_attempt: run_attempt),
  ], "")
}

// THE CELL A GRANT WRITES on a run-scoped account: that run attempt may act as the account until the
// instant the approval named. The condition is IAM's own, so expiry takes effect with no cleanup;
// the title prefix marks the cells gunbc.auth.branch_run_grant owns, which is what lets each grant
// remove the lapsed ones and leave every other binding alone.
data branch_run_grant_condition_title_prefix: String = "gunbc-branch-run-"

data branch_run_expiry_expression_prefix: String = "request.time < timestamp('"

data branch_run_expiry_expression_suffix: String = "')"

fn branch_run_impersonation_cell(run_id: GitHubWorkflowRunId, run_attempt: Int, expires_at: Timestamp) -> GcpIamBindingCell {
  GcpIamBindingCell {
    role: role_iam_workload_identity_user,
    member: branch_run_principal_set(run_id: run_id, run_attempt: run_attempt),
    condition: Present { value: IamCondition {
      title: concat(branch_run_grant_condition_title_prefix, branch_run_key(run_id: run_id, run_attempt: run_attempt)),
      description: Present { value: "One approved fleet-converge branch run attempt; granted by gunbc.auth.branch_run_grant after operator approval." },
      expression: join([branch_run_expiry_expression_prefix, expires_at as String, branch_run_expiry_expression_suffix], ""),
    } },
  }
}

// THE ONE NAME THE GRANT RUN IS DISPATCHED WITH: the run and its attempt, joined as branch_run_key
// joins them, carried in the existing transaction_nonce input (GitHub admits at most 25 dispatch
// inputs, so the grant adds none). The broker reads both halves from GitHub's workflow_run event
// (gunbc.auth.branch_run_grant_broker), never from the branch's own run; the grant then reads the
// run's mode from GitHub and the account from run_scoped_modes below.
data branch_run_key_variable: NonEmptyStr = "BRANCH_RUN_KEY"

// WHICH FLEET-CONVERGE MODE NEEDS WHICH RUN-SCOPED ACCOUNT. The mode is read from the run's title,
// which the branch's own workflow file renders, so it is the branch's claim; this table is main's, so
// a branch can only ever reach an account a mode here maps to, and the operator reads both in the
// request.
//
// THIS TABLE IS THE ONE RELATION OVER FLEET-CONVERGE MODES THAT SAYS WHICH ONES A BRANCH MAY RUN. The
// generated workflow (gunbc.fleet.fleet_converge_workflow) derives its grant-wait, branch-pool
// sign-in and main-only fleet sign-in from these rows and from nothing else; a mode with no row keeps
// the main-only route, so coverage can only widen by a row here. main_route says what the same mode
// does when dispatched at main: MainUsesFleetIdentity signs in through the main-only fleet pool,
// MainUsesGrantedAccount keeps the grant at every ref, MainUsesSelectedSource leaves the choice to the
// mode's own job (the boot job's select_boot_credential_source).
//
// dashboard_deploy IS DELIBERATELY NOT A ROW. Its job holds no cloud credential, so there is nothing for
// IAM to refuse and an approval would be enforced only by the branch's own workflow text, which the
// branch can delete. A row is admitted only where the grant gates a credential the branch cannot obtain
// without it. Trigger to add it: an enforcement point outside the branch's workflow text (a main-side
// gate, or a verified environment protection on srv1-production).
//
type RunScopedMainRoute = MainUsesGrantedAccount | MainUsesFleetIdentity | MainUsesSelectedSource

type RunScopedMode {
  mode: NonEmptyStr
  account_id: NonEmptyStr
  main_route: RunScopedMainRoute
}

fn run_scoped_account_id(m: RunScopedMode) -> NonEmptyStr {
  m.account_id
}

data mtcollins1_boot_mode_name: NonEmptyStr = "mtcollins1_boot"

fn run_scoped_modes() -> List<RunScopedMode> {
  [
    RunScopedMode { mode: "hetzner_cloud_server_read", account_id: hetzner_cloud_control_service_account_id, main_route: MainUsesGrantedAccount },
    RunScopedMode { mode: mtcollins1_boot_mode_name, account_id: mtcollins1_boot_run_scoped_service_account_id, main_route: MainUsesSelectedSource },
    RunScopedMode { mode: "plan", account_id: fleet_plan_run_scoped_service_account_id, main_route: MainUsesFleetIdentity },
    RunScopedMode { mode: "apply", account_id: fleet_apply_run_scoped_service_account_id, main_route: MainUsesFleetIdentity },
  ]
}

fn run_scoped_mode_named(mode: String) -> RunScopedMode? {
  filter(run_scoped_modes(), m => (m.mode as String) == mode).first()
}

// THE ONE MODE/REF ELIGIBILITY RULE, shared by the broker prefilter and the grant planner. A mode is
// eligible for a run-scoped grant on a ref only if it maps in run_scoped_modes and, for the boot mode,
// the credential selection for THAT REF names the run-scoped source: the boot is refused on the reviewed
// default branch (the dedicated identity applies there), and it needs no grant at all off main at a ref
// the code roster holds, because there it federates the approval-free branch identity instead.
//
// ASKING THE SELECTION BY REF, not by ref class, is what keeps the broker honest. Read by class alone, a
// rostered branch boot would still look grant-eligible, so the broker would still dispatch a grant run for
// a boot that never waits for one -- spending a srv1-constrained converge run to authorize a boot that does
// not need it, which is the shape of the 2026-10-23 deadlock (boot run 39895480515 holding srv1-01 while its
// grant run 39895564897 queued for that same runner). A mode that needs no credential needs no grant, and
// this is now the single place that decides both.
//
// ONLY THE SELECTED-SOURCE ROUTE IS REF-GATED THIS WAY: every other mode, and host_reset_return above all,
// keeps the class rule it has always had, at every ref. The roster opens mtcollins1_boot and nothing else.
fn run_scoped_mode_eligible(mode: String, branch: String) -> RunScopedMode? {
  let on_main = branch == (gunbc_default_branch_name as String)
  match run_scoped_mode_named(mode: mode) {
    Absent => none
    Present { value: m } => match m.main_route {
      MainUsesSelectedSource =>
        if on_main { none } else if boot_grant_required_at_ref(on_reviewed_main: false, branch: branch) { Present { value: m } } else { none }
      MainUsesGrantedAccount => run_scoped_mode_eligible_on(mode: mode, on_reviewed_main: on_main)
      MainUsesFleetIdentity => run_scoped_mode_eligible_on(mode: mode, on_reviewed_main: on_main)
    }
  }
}

// THE SAME RULE READ BY REF CLASS, for a reader that knows whether the dispatch is at reviewed main but
// holds no branch name (gunbc.fleet.fleet_converge_workflow fleet_converge_grant_required).
fn run_scoped_mode_eligible_on(mode: String, on_reviewed_main: Bool) -> RunScopedMode? {
  match run_scoped_mode_named(mode: mode) {
    Absent => none
    Present { value: m } => match m.main_route {
      MainUsesGrantedAccount => Present { value: m }
      MainUsesFleetIdentity => if on_reviewed_main { none } else { Present { value: m } }
      MainUsesSelectedSource =>
        match select_boot_credential_source(on_reviewed_main: on_reviewed_main) {
          BootCredentialSourceSelected { source: RunScopedApprovedGrant } => Present { value: m }
          BootCredentialSourceSelected { source: ReviewedMainDedicatedFederation } => none
          BootCredentialSourceRefused { cause: _ } => none
        }
    }
  }
}

// THE KEY BACK INTO ITS RUN AND ATTEMPT: exactly two decimal halves, or nothing.
type BranchRunKey {
  run_id: GitHubWorkflowRunId
  run_attempt: Int
}

fn parse_branch_run_key(key: String) -> BranchRunKey? {
  let parts = key.split(delimiter: "-")
  if parts.length() != 2 { none } else {
    match github_workflow_run_id_from_wire_text(text: match parts.first() { Present { value: h } => h  Absent => "" }) {
      Absent => none
      Present { value: id } => match parse_int(s: match parts.last() { Present { value: t } => t  Absent => "" }) {
        Absent => none
        Present { value: attempt } => if attempt > 0 { Present { value: BranchRunKey { run_id: id, run_attempt: attempt } } } else { none }
      }
    }
  }
}

// THE RUN'S MODE AS ITS TITLE CARRIES IT: fleet-converge's run-name renders
// "fleet-converge <mode> <host> nonce=<nonce>", so the mode is the second word.
fn mode_of_run_title(title: String) -> String {
  match title.split(delimiter: " ").skip(n: 1).first() { Present { value: w } => w  Absent => "" }
}

// ── the branch run, as GitHub records it ─────────────────────────────────────────────────────
// ONE JUDGMENT OF A RUN'S RECORD, read by the broker that asks for a grant
// (gunbc.auth.branch_run_grant_broker) and by the grant that writes one (gunbc.auth.branch_run_grant):
// both take the run id from GitHub's workflow_run event or a dispatch input, and neither may trust that
// the id names a live fleet-converge dispatch until GitHub's own record of the run says so.

type BranchRunFacts {
  run_id: GitHubWorkflowRunId
  run_attempt: Int
  mode: String
  branch: String
  head_sha: CommitSha
  dispatched_by: String
  created_at: Timestamp
}

type BranchRunReading
  = BranchRunAdmitted { facts: BranchRunFacts }
  | BranchRunRefused { reason: NonEmptyStr }

// THE RUN MUST BE A LIVE DISPATCH OF THE FLEET-CONVERGE WORKFLOW, AT THE ATTEMPT ASKED ABOUT: another
// workflow, another event, a finished run, or a run GitHub has since re-run is refused, so an approval
// can only ever reach the one attempt of the file this grant is for.
fn judge_branch_run(run_id: GitHubWorkflowRunId, run_attempt: Int, run: WorkflowRun) -> BranchRunReading {
  let path = match run.path { Present { value: p } => p  Absent => "" }
  if github_workflow_run_id_of_wire(n: run.id) != run_id {
    BranchRunRefused { reason: concat("GitHub answered about another run: ", int_to_decimal_string(value: run.id)) as NonEmptyStr }
  } else if run.run_attempt != run_attempt {
    BranchRunRefused { reason: join(["the run is at attempt ", to_string(run.run_attempt), ", not the attempt asked about (", to_string(run_attempt), ")"], "") as NonEmptyStr }
  } else if path != artifact_path(a: FleetConvergeYamlArtifact) {
    BranchRunRefused { reason: concat("the run is not a fleet-converge run: ", path) as NonEmptyStr }
  } else if run.event != workflow_dispatch_event_name {
    BranchRunRefused { reason: concat("the run was not dispatched: ", run.event) as NonEmptyStr }
  } else if (run.status == Completed) {
    BranchRunRefused { reason: "the run has already completed" as NonEmptyStr }
  } else {
    BranchRunAdmitted { facts: BranchRunFacts {
      run_id: run_id,
      run_attempt: run_attempt,
      mode: mode_of_run_title(title: match run.display_title { Present { value: t } => t  Absent => "" }),
      branch: match run.head_branch { Present { value: b } => b  Absent => "(no branch)" },
      head_sha: run.head_sha,
      dispatched_by: match run.triggering_actor { Present { value: u } => u.login as String  Absent => "(unknown)" },
      created_at: run.created_at,
    } }
  }
}

// ── the run-scoped accounts ──────────────────────────────────────────────────────────────────

data hetzner_cloud_control_service_account_id: NonEmptyStr = "hetzner-cloud-control"

data hetzner_cloud_control_service_account: ServiceAccountEmail = "hetzner-cloud-control@gunbai-secrets.iam.gserviceaccount.com"

// THE HETZNER CLOUD CONTROLLER'S ACCOUNT: it reads the project token and nothing else.
fn hetzner_cloud_control_federation() -> DedicatedFederation {
  DedicatedFederation {
    label: "hetzner cloud control (approved branch runs)",
    pool_id: branch_dispatch_wif_pool_id,
    pool_display_name: "Fleet converge (branch runs)",
    provider_id: branch_dispatch_wif_provider_id,
    attribute_mapping: branch_dispatch_attribute_mapping,
    attribute_condition: branch_dispatch_attribute_condition(),
    impersonation: RunScopedImpersonation,
    service_account: hetzner_cloud_control_service_account,
    service_account_id: hetzner_cloud_control_service_account_id,
    service_account_display_name: "Hetzner Cloud control (WIF-only, run-scoped, no keys)",
    service_account_member: federated_service_account_member(email: hetzner_cloud_control_service_account),
    secret_grants: hetzner_cloud_api_grants(),
  }
}

// THE MT. COLLINS BOOT'S RUN-SCOPED ACCOUNT: same pool as Hetzner, own account, grants taken from
// the admitted boot federation's one secret_grants list (BMC published version and fleet key
// version). A second pin on this account is unwritable because there is no second list. Rotation
// of either version is one edit on ManagedHostBootFederation, one converge, both SAs.
data mtcollins1_boot_run_scoped_service_account_id: NonEmptyStr = "mtcollins1-boot-run"

data mtcollins1_boot_run_scoped_service_account: ServiceAccountEmail = "mtcollins1-boot-run@gunbai-secrets.iam.gserviceaccount.com"

fn mtcollins1_boot_run_scoped_federation_for(f: ManagedHostBootFederation) -> DedicatedFederation {
  DedicatedFederation {
    label: "mtcollins1 boot (approved branch runs)",
    pool_id: branch_dispatch_wif_pool_id,
    pool_display_name: "Fleet converge (branch runs)",
    provider_id: branch_dispatch_wif_provider_id,
    attribute_mapping: branch_dispatch_attribute_mapping,
    attribute_condition: branch_dispatch_attribute_condition(),
    impersonation: RunScopedImpersonation,
    service_account: mtcollins1_boot_run_scoped_service_account,
    service_account_id: mtcollins1_boot_run_scoped_service_account_id,
    service_account_display_name: "Mt. Collins boot (run-scoped, WIF-only, no keys)",
    service_account_member: federated_service_account_member(email: mtcollins1_boot_run_scoped_service_account),
    secret_grants: f.secret_grants,
  }
}

fn mtcollins1_boot_run_scoped_federations() -> List<DedicatedFederation> {
  match provisioned_federation_of(s: boot_federation_for(host: operator_host_mtcollins1)) {
    Present { value: f } => [mtcollins1_boot_run_scoped_federation_for(f: f)]
    Absent => []
  }
}

fn mtcollins1_boot_run_scoped_federation() -> DedicatedFederation? {
  mtcollins1_boot_run_scoped_federations().first()
}

// THE FLEET-CONVERGE MODES THAT RUN AS THE FLEET'S OWN ACCOUNTS FROM A BRANCH (operator, relayed
// 2026-10-17): plan reads through the existing fleet-cloud-convergence account, which holds no secret
// grant of its own here; apply gets a narrow account holding only the fleet
// SSH key version, so a mistaken approval costs that key for one run and nothing else. Every account
// is reached only through a per-attempt cell, never a standing one.
data fleet_plan_run_scoped_service_account_id: NonEmptyStr = "fleet-cloud-convergence"

data fleet_apply_run_scoped_service_account_id: NonEmptyStr = "fleet-apply-run"

data fleet_apply_run_scoped_service_account: ServiceAccountEmail = "fleet-apply-run@gunbai-secrets.iam.gserviceaccount.com"

fn fleet_run_scoped_federation(label: String, account_id: NonEmptyStr, email: ServiceAccountEmail, display: String, grants: List<SecretAccessGrant>) -> DedicatedFederation {
  DedicatedFederation {
    label: label,
    pool_id: branch_dispatch_wif_pool_id,
    pool_display_name: "Fleet converge (branch runs)",
    provider_id: branch_dispatch_wif_provider_id,
    attribute_mapping: branch_dispatch_attribute_mapping,
    attribute_condition: branch_dispatch_attribute_condition(),
    impersonation: RunScopedImpersonation,
    service_account: email,
    service_account_id: account_id,
    service_account_display_name: display,
    service_account_member: federated_service_account_member(email: email),
    secret_grants: grants,
  }
}

// The plan row's account is the existing standing fleet account: its policy is already a converge
// target (fleet_convergence_federation), so this federation only lets the grant planner derive a
// per-run cell on it; it is not a second target.
fn fleet_plan_run_scoped_federation() -> DedicatedFederation {
  fleet_run_scoped_federation(label: "fleet plan (approved branch runs)", account_id: fleet_plan_run_scoped_service_account_id, email: fleet_cloud_convergence_sa_email, display: "Fleet cloud convergence (WIF-only, no keys)", grants: [])
}

fn fleet_apply_run_scoped_federation() -> DedicatedFederation {
  fleet_run_scoped_federation(label: "fleet apply (approved branch runs)", account_id: fleet_apply_run_scoped_service_account_id, email: fleet_apply_run_scoped_service_account, display: "Fleet apply (run-scoped, WIF-only, no keys)", grants: [secret_accessor_grant(target: fleet_automation_ssh_privkey_secret)])
}

// The accounts this table's rows need provisioned; the plan row reuses an account that is already a target.
fn fleet_run_scoped_new_federations() -> List<DedicatedFederation> {
  [fleet_apply_run_scoped_federation()]
}

fn run_scoped_federations() -> List<DedicatedFederation> {
  concat(concat([hetzner_cloud_control_federation(), fleet_plan_run_scoped_federation()], fleet_run_scoped_new_federations()), mtcollins1_boot_run_scoped_federations())
}

fn run_scoped_federation_named(account_id: String) -> DedicatedFederation? {
  filter(run_scoped_federations(), f => (f.service_account_id as String) == account_id).first()
}

// WHICH WIF SOURCE THE BOOT JOB'S ONE CREDENTIAL SEAM TAKES. This is not a second decision
// algebra: the privileged effect's characteristics (whether the dedicated pool can bind this ref)
// go through select_authorization_pattern. FederatedScopedGrant is the dedicated standing
// identity on reviewed main. Off main that identity is unbindable (STS admits only refs/heads/main),
// so the unique survivor is OperatorApprovedCapability -- the run-scoped grant -- and IAM still
// federates as mtcollins1-boot-run only after that cell exists. github.ref in the workflow file
// is not the wall.
type BootCredentialSource
  = ReviewedMainDedicatedFederation
  | RunScopedApprovedGrant
  // THE APPROVAL-FREE BRANCH BOOT (operator rulings 2026-10-22 and 2026-10-23, carried in full by
  // gunbc.auth.mtcollins1_branch_boot_trust). A same-repository branch dispatch of mtcollins1_boot whose
  // ref the code-declared roster holds federates as a DEDICATED branch boot account, through a pool and
  // provider of its own whose WIF condition pins the ref and the job environment. It waits for no grant
  // run. It is not the grant route bypassed -- it is a different, STANDING IAM-side trust, and every
  // other mode, host_reset_return included, still selects RunScopedApprovedGrant off main.
  | TrustedBranchBootIdentity

type BootCredentialStanding
  = BootCredentialSourceSelected { source: BootCredentialSource }
  | BootCredentialSourceRefused { cause: NonEmptyStr }

// Emitted into the boot job's WIF fields when select_boot_credential_source is Refused, so
// google-github-actions/auth fails instead of federating a fabricated identity. Not a merge-blocking
// drift gate: the required job does not compare this YAML to its .dag (review 80563).
data boot_credential_source_emit_refused_poison: String = "__GUNBC_BOOT_CREDENTIAL_SOURCE_REFUSED__"

fn dedicated_boot_workload_identity() -> WorkloadIdentityStanding {
  match provisioned_federation_of(s: boot_federation_for(host: operator_host_mtcollins1)) {
    Present { value: f } => WorkloadIdentityBindable { member: boot_federation_service_account_member(f: f) as NonEmptyStr }
    Absent => WorkloadIdentityUnbindable {
      cause: "no admitted boot federation, so no dedicated identity to bind" as NonEmptyStr,
    }
  }
}

fn boot_credential_effect(on_reviewed_main: Bool) -> PrivilegedEffect {
  PrivilegedEffect {
    subject: "the boot job's one credential seam: federate as the dedicated boot account on reviewed main; otherwise wait for this run's grant and federate as the run-scoped boot account. Both accounts hold only the admitted boot federation's pinned fleet-key and BMC versions" as NonEmptyStr,
    frequency: if on_reviewed_main { EveryProvision } else { EveryOperatorRequest },
    reversibility: ReversibleByReapply,
    surface: ApiSurface,
    workload_identity: if on_reviewed_main {
      dedicated_boot_workload_identity()
    } else {
      WorkloadIdentityUnbindable {
        cause: "the dedicated boot pool's attribute condition admits only refs/heads/main; a branch run cannot bind that identity" as NonEmptyStr,
      }
    },
    minted_reach: MintsNoCredential,
    billing: NoBillingConsequence,
    witness_discharge: NoWitnessDischarge,
  }
}

fn boot_credential_effect_on_reviewed_main() -> PrivilegedEffect {
  boot_credential_effect(on_reviewed_main: true)
}

fn boot_credential_effect_off_reviewed_main() -> PrivilegedEffect {
  boot_credential_effect(on_reviewed_main: false)
}

fn boot_credential_source_from_pattern(on_reviewed_main: Bool, p: AuthorizationPattern) -> BootCredentialStanding {
  match p {
    FederatedScopedGrant =>
      if on_reviewed_main {
        BootCredentialSourceSelected { source: ReviewedMainDedicatedFederation }
      } else {
        BootCredentialSourceRefused { cause: "FederatedScopedGrant is the reviewed-main dedicated identity; a branch run cannot bind it" as NonEmptyStr }
      }
    OperatorApprovedCapability =>
      if on_reviewed_main {
        BootCredentialSourceRefused { cause: "OperatorApprovedCapability is the run-scoped grant; reviewed main uses the dedicated identity" as NonEmptyStr }
      } else {
        BootCredentialSourceSelected { source: RunScopedApprovedGrant }
      }
    HumanOnlyStep { step: _ } => BootCredentialSourceRefused { cause: "the selection named a human-only step, which no workflow credential can perform" as NonEmptyStr }
    OperatorOwnSession => BootCredentialSourceRefused { cause: "the selection named the operator's own session, which a workflow run does not hold" as NonEmptyStr }
    AdministratorEdge => BootCredentialSourceRefused { cause: "the selection named the administrator edge, which a boot credential does not use" as NonEmptyStr }
    ApprovedConvergenceGrant => BootCredentialSourceRefused { cause: "the selection named a convergence-inherited approval, which no boot credential source realizes" as NonEmptyStr }
  }
}

fn boot_credential_source_from_selection(on_reviewed_main: Bool, s: AuthorizationPatternSelection) -> BootCredentialStanding {
  match s {
    PatternSelected { pattern: p, receipt: _ } => boot_credential_source_from_pattern(on_reviewed_main: on_reviewed_main, p: p)
    ManualStepRequired { step: _, receipt: _ } => BootCredentialSourceRefused { cause: "authorization selection requires a manual step" as NonEmptyStr }
    NoAdmissiblePattern { causes: _, scope: _ } => BootCredentialSourceRefused { cause: "authorization selection found no admissible pattern" as NonEmptyStr }
    PatternSelectionNeedsEvidence { needs: _ } => BootCredentialSourceRefused { cause: "authorization selection needs evidence it does not have" as NonEmptyStr }
    PatternSelectionNeedsPolicy { survivors: _ } => BootCredentialSourceRefused { cause: "authorization selection left several survivors and no policy to choose" as NonEmptyStr }
    PatternSelectionRefused { defects: _ } => BootCredentialSourceRefused { cause: "authorization selection refused the effect" as NonEmptyStr }
  }
}

fn select_boot_credential_source(on_reviewed_main: Bool) -> BootCredentialStanding {
  boot_credential_source_from_selection(on_reviewed_main: on_reviewed_main, s: select_authorization_pattern(e: boot_credential_effect(on_reviewed_main: on_reviewed_main)))
}

// THE APPROVAL-FREE BRANCH BOOT AS A CENSUS ROW, the third boot-credential effect beside the reviewed-main
// and off-main rows above, and the row gunbc.auth.privileged_effect_census carries with the operator's
// rulings quoted (2026-10-22 "is not sensitive"; 2026-10-23 "permission to boot it endlessly" and a
// non-main integration branch "shouldn't need an approval", extending the 2026-09-23/25 rulings).
//
// IT IS A NO-APPROVAL SELECTION, NOT A SECOND APPROVAL ROUTE (gunbc.design_ruling
// one_approval_route_for_every_privileged_action). That ruling binds an effect "that a human can attend"
// to the one approval-broker route and keeps the administrator edge only for an UNATTENDED
// MintsHostRootReach. A BMC power cycle is neither: no human attends it (the operator's consent is
// STANDING and recorded in code, exactly as the 2026-09-23/25 rulings recorded it for the main-dispatched
// twin), and it mints resource-scoped reads, not host root. So this effect goes through the SAME
// selection algebra as every other effect here -- no second broker, no second consent object -- and its
// selection lands on FederatedScopedGrant, the pattern that needs no human action per effect.
fn branch_boot_credential_effect_approval_free() -> PrivilegedEffect {
  PrivilegedEffect {
    subject: "drive the mtcollins1 BMC directly as a same-repository branch dispatch of mtcollins1_boot: power-cycle it and mount its virtual CD, federating as the dedicated branch boot account through the branch boot pool" as NonEmptyStr,
    frequency: EveryOperatorRequest,
    reversibility: ReversibleByReapply,
    surface: ApiSurface,
    workload_identity: branch_boot_workload_identity(),
    minted_reach: MintsResourceScopedCredential,
    billing: NoBillingConsequence,
    // THE ACT IS NOT NEW, AND NEITHER IS ITS DISCHARGE. This effect is the SAME destructive act the
    // 2026-09-23/25 ruling already discharges -- same power cycle, same media mount, same BMC -- reached
    // through a different credential. Its irreversibility is discharged by that ruling at the boot's own
    // site (gunbc.machine_intake.mtcollins1_boot_run::mtcollins1_boot_wet), which is interlocked against
    // the unit hold; this row's site is the CREDENTIAL SEAM, and a credential seam that mints a
    // resource-scoped token, bills nothing and is not break-glass owes no witness of its own. Marking it
    // StandingRulingUnderInterlock with a NEW ruling would invent a second discharge for one act, and the
    // census's own join (rulings_without_a_rostered_interlock) reads discharges, not rows -- so the second
    // ruling would have to be rostered as if it were a new authority over the act. It is not: it is the
    // operator's standing permission for the CREDENTIAL, carried as text in
    // gunbc.auth.privileged_effect_census mtcollins1_branch_boot_operator_ruling_text and as the IAM trust
    // in gunbc.auth.mtcollins1_branch_boot_trust.
    witness_discharge: NoWitnessDischarge,
  }
}

// THE BINDING FACT, same shape as dedicated_boot_workload_identity for the other row: the branch account
// is bindable exactly while its federation is provisioned, and unbindable -- so unselectable -- when it
// is not. Nothing can be federated that was never admitted.
fn branch_boot_workload_identity() -> WorkloadIdentityStanding {
  match mtcollins1_boot_branch_federation() {
    Present { value: f } => WorkloadIdentityBindable { member: f.service_account_member as NonEmptyStr }
    Absent => WorkloadIdentityUnbindable {
      cause: "no provisioned branch boot identity, so no branch boot credential to bind" as NonEmptyStr,
    }
  }
}

// THE RENDER FOR THE BRANCH EFFECT, through the SAME selection algebra (the pattern must be admissible
// for the effect, not merely named) and its own arm, because off reviewed main FederatedScopedGrant means
// the dedicated main-only identity and refuses a branch. A branch outside the roster never reaches this:
// select_boot_credential_source_at_ref asks the roster first, and every other ref falls through to the
// per-run grant. So host_reset_return and every other mode keep their grant.
fn boot_credential_source_from_branch_selection(s: AuthorizationPatternSelection) -> BootCredentialStanding {
  match s {
    PatternSelected { pattern: FederatedScopedGrant, receipt: _ } =>
      match mtcollins1_boot_branch_federation() {
        Absent => BootCredentialSourceRefused { cause: "the branch boot identity is unprovisioned: no branch boot credential" as NonEmptyStr }
        Present { value: _ } => BootCredentialSourceSelected { source: TrustedBranchBootIdentity }
      }
    PatternSelected { pattern: _, receipt: _ } => BootCredentialSourceRefused { cause: "the branch boot selected a pattern that mints no branch boot credential" as NonEmptyStr }
    ManualStepRequired { step: _, receipt: _ } => BootCredentialSourceRefused { cause: "the branch boot selection requires a manual step" as NonEmptyStr }
    NoAdmissiblePattern { causes: _, scope: _ } => BootCredentialSourceRefused { cause: "no pattern is admissible for the branch boot effect" as NonEmptyStr }
    PatternSelectionNeedsEvidence { needs: _ } => BootCredentialSourceRefused { cause: "the branch boot selection needs evidence it does not have" as NonEmptyStr }
    PatternSelectionNeedsPolicy { survivors: _ } => BootCredentialSourceRefused { cause: "the branch boot selection left several survivors and no policy to choose" as NonEmptyStr }
    PatternSelectionRefused { defects: _ } => BootCredentialSourceRefused { cause: "the branch boot selection refused the effect" as NonEmptyStr }
  }
}

// THE SELECTION FOR A DISPATCH AT A GIVEN REF: the same law, asked with the branch it runs on. On
// reviewed main nothing changes at all. Off main, ONLY a ref the code-declared roster holds selects the
// approval-free branch identity; every other ref -- a fork, an unrostered branch, a branch that renamed
// its own environment -- keeps the run-scoped grant, because the roster is the one door and it opens for
// this mode alone.
//
// WHY THIS IS NOT A WORKFLOW-TEXT BYPASS. This function only chooses which IAM identity to federate as.
// That identity is admitted solely by a WIF condition GCP evaluates over issuer-signed claims
// (gunbc.auth.mtcollins1_branch_boot_trust mtcollins1_boot_branch_attribute_condition), which pins the
// same roster, the repository's NUMERIC identity, the fleet-converge workflow file, and the job's
// environment name -- none of which a branch can change from inside fleet-converge.yml, which is precisely
// why the 2026-09-23 ruling put the authority on the IAM side. A branch that rewrites this workflow file
// and asks for the approval-free source gets a token its own provider refuses.
fn select_boot_credential_source_at_ref(on_reviewed_main: Bool, branch: String) -> BootCredentialStanding {
  if !on_reviewed_main && mtcollins1_boot_branch_is_trusted(branch: branch) {
    boot_credential_source_from_branch_selection(s: select_authorization_pattern(e: branch_boot_credential_effect_approval_free()))
  } else {
    select_boot_credential_source(on_reviewed_main: on_reviewed_main)
  }
}

// DOES A BOOT AT THIS REF NEED A PER-RUN GRANT? The workflow's grant wait asks this, so a rostered branch
// boot never queues behind a grant run it does not need -- which is also what keeps that boot off the srv1
// slot a grant run may be waiting for (the 2026-10-23 deadlock: the boot held the only srv1 runner while
// its own grant run queued behind it for that same runner). Every other ref, and every other mode at
// every ref, still needs the grant and still waits for it.
fn boot_grant_required_at_ref(on_reviewed_main: Bool, branch: String) -> Bool {
  match select_boot_credential_source_at_ref(on_reviewed_main: on_reviewed_main, branch: branch) {
    BootCredentialSourceSelected { source: s } => match s { TrustedBranchBootIdentity => false  _ => true }
    BootCredentialSourceRefused { cause: _ } => true
  }
}

// ── the table, read as the workflow's coverage ───────────────────────────────────────────────
// Which rows a fleet-converge job's shared prelude routes, by what each does at main. The workflow
// generator reads these two and the table itself; it holds no per-mode list of its own.
fn run_scoped_modes_with_route(route: RunScopedMainRoute) -> List<RunScopedMode> {
  filter(run_scoped_modes(), m => m.main_route == route)
}
