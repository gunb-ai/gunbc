module gunbc.auth.gcp_secret_access

// WHY THIS MODULE IS NOT IN gunbc.spark. The ensure below was written for
// spark-administrator-password and lived at gunbc.spark.secret_access_ensure, so the module path
// named its FIRST CONSUMER rather than the fact it owns. That stopped being true when the gunbai-ci
// App key needed the same binding and the target became a parameter: a second caller in a different
// domain reaches into the spark namespace for a fact that was never about spark. §3 says a fact's
// home is its LAYER, so the reconciler moves to the auth layer it always belonged to and the spark
// module keeps a wrapper binding its own target. The move is the whole point -- leaving it where it
// was would keep a module name asserting something false about ownership.
//
// WHICH PRINCIPAL THIS ACTS AS. The FIRST binding still cannot be self-granted:
// principal_role_admits_operation gives the convergence principal SmSetIamPolicy => false as a hard
// ceiling, and no_principal_can_both_grant_and_read executes the property, because a principal that
// can grant and read can escalate itself to every secret in the project. This ensure acts as
// FleetCloudGrantAdministratorPrincipal, the modeled control plane, whose admitted operations are
// exactly the two this module performs.
//
// AND THE MODEL STILL DOES NOT REPRESENT THE IDENTITY THAT ACTUALLY RUNS IT. FleetCloudPrincipalKey
// enumerates exactly two arms, neither an operator session, so no_principal_can_both_grant_and_read
// quantifies over a universe the operator identity is not in. The property is SILENT about that
// identity, not endorsing it; reporting silence as endorsement is rung inflation on the security
// claim. The ROLE is modeled and its operation ceiling executed; the REALIZATION of that role is an
// operator gcloud session, and the binding between the two is convention, not structure. Next rung:
// enrol the grant administrator as a real federated identity.
import extdeps.cloud.gcp.iam {
  GcpPolicy, GcpIamBindingCell, GcpIamOwnedCellUniverse, IamCondition,
  GcpPolicyAlreadyConverged, GcpPolicyDeltaRequired, GcpPolicyRepresentationLossy,
  reconcile_gcp_policy, gcp_policy_cells, gcp_cell_in, gcp_policy_from_wire,
  no_gcp_cells, condition_mangled_roles,
  role_secretmanager_secret_accessor
}
import extdeps.cloud.gcp.secret_manager
import extdeps.cloud.gcp.secret_ref { SecretRef }
import gunbc.spark.bootstrap_provision {
  fleet_cloud_principal_standing,
  CloudPrincipalAllocated, CloudPrincipalReported, CloudPrincipalUnallocated,
  FleetCloudPrincipalKey, FleetCloudConvergencePrincipal, FleetCloudGrantAdministratorPrincipal,
  FleetCloudConvergence, FleetCloudGrantAdministrator,
  SecretManagerOperation, SmGetIamPolicy, SmSetIamPolicy,
  principal_role_admits_operation,
}
import gunbc.auth.access_token_source {
  AccessTokenSource, AccessTokenReady, AccessTokenUpsertRequired, AccessTokenEnsureRefused,
  OperatorSuppliedToken,
  access_token_upsert_required_reason, ensure_access_token,
}
import std.types { NonEmptyStr, String, Secret }
import std.logic { Bool }
import std.resources { Network }
import std.process { ProcessExit, ExitSuccess, exit_failure }

// THE CELL IS THE UNIT OF REQUEST, which is why role and condition sit beside the target rather
// than being fixed constants inside the ensure. A human-in-the-loop grant may name exactly what the
// reconcilers already know how to own, and this record IS that nameable thing: one secret, one
// role, one condition. Fixing the role to accessor inside the ensure -- as the first revision did --
// made least privilege a property of the source rather than of the request, so a request for a
// different role had nowhere to be represented and would have arrived as an argv literal instead.
type SecretAccessGrant {
  target: SecretRef
  role: String
  condition: IamCondition?
}

// The binding both current callers want, named once. An unconditioned accessor cell is the
// status-quo grant, and spelling it here keeps the two entry points from each re-deriving it.
fn secret_accessor_grant(target: SecretRef) -> SecretAccessGrant {
  SecretAccessGrant { target: target, role: role_secretmanager_secret_accessor, condition: none }
}

// ── The member is RESOLVED, never spelled ────────────────────────────────────────────────────
// spark_bootstrap_cloud_principal_member() exists and returns a String, and using it here would be
// a defect: its CloudPrincipalUnallocated arm answers the PROSE "the run's WIF identity (no
// allocated member is recorded)", fine in a report and catastrophic in an IAM policy -- it would
// author a binding for a member that cannot exist, and setIamPolicy is a whole-policy replace, so
// the write would land beside the real bindings. So this module consumes the STANDING and refuses
// the unallocated arm: an ensure that cannot name its subject must not write a policy.
type GrantMemberResolution
  = GrantMemberResolved { member: String }
  | GrantMemberUnresolved { cause: String }

fn grant_member_resolution() -> GrantMemberResolution {
  match fleet_cloud_principal_standing() {
    CloudPrincipalAllocated { principal: _, member: m, readback: _ } =>
      GrantMemberResolved { member: m }
    CloudPrincipalReported { principal: _, reported_member: m, source: _ } =>
      GrantMemberResolved { member: m }
    CloudPrincipalUnallocated { principal: _ } =>
      GrantMemberUnresolved {
        cause: "no allocated member is recorded for the fleet cloud principal, so this ensure cannot name the subject it would grant; refusing rather than writing a policy naming a member that does not exist"
      }
  }
}

// ── Desired and owned are two facts, not one ─────────────────────────────────────────────────
// DESIRED is what must be present. OWNED is the population this model may REMOVE. Here they are
// deliberately the same single cell, the conservative reading: a binding this model did not author
// is preserved even when its member is one we recognise, because it may exist for a reason this
// caller cannot see. Widening owned_universe is how an ensure starts deleting other people's
// access, so it grows only with a reason.
fn secret_access_desired_cells(member: String, grant: SecretAccessGrant) -> List<GcpIamBindingCell> {
  [GcpIamBindingCell { role: grant.role, member: member, condition: grant.condition }]
}

fn secret_access_owned_universe(member: String, grant: SecretAccessGrant) -> GcpIamOwnedCellUniverse {
  GcpIamOwnedCellUniverse { cells: secret_access_desired_cells(member: member, grant: grant) }
}

fn first_or_empty(xs: List<String>) -> String {
  fold(xs, init: "", f: (acc, x) => if acc == "" { x } else { acc })
}

// Whether a policy carries the granted cell. It is applied to three different policies, and only
// one of them can decide convergence: the first read (the AlreadyConverged check), the write
// response (application evidence, reported and never decisive) and the independent post-write re-read
// (the verdict). See secret_access_assess_readback.
fn secret_access_grant_present(policy: GcpPolicy, member: String, grant: SecretAccessGrant) -> Bool {
  gcp_cell_in(
    c: GcpIamBindingCell { role: grant.role, member: member, condition: grant.condition },
    xs: gcp_policy_cells(p: policy)
  )
}

// ── A TIME-BOUNDED CELL NOBODY REQUESTED IS DRIFT, NOT A NEIGHBOUR ───────────────────────────
// The preserve rule above is correct for UNCONDITIONED foreign cells: a plain binding this model
// did not author may exist for a reason this caller cannot see, so removing it would be the ensure
// deleting other people's access. A CONDITIONED cell is a different fact. In this fleet an IAM
// condition is how an expiring, human-approved grant is written, so a conditioned cell is a claim
// that some request authorized it until some instant. If no live grant matches it, that claim has
// no issuer -- either the request it came from is gone and the reverse ensure never ran, or nobody
// asked for it at all.
//
// Preserving it silently is the absorbing fallback §5 names: the ensure cannot tell "approved" from
// "unexplained", so it widens to keep everything and the discrepancy stops being observable. The
// grant would then outlive its request with nothing counting it, which is exactly the drift the
// fleet surface is supposed to show. So conditioned cells are partitioned against the granted set
// and the unmatched ones are RETURNED as a located population, countable by a caller.
//
// This REPORTS; it does not remove. Removal is a policy decision belonging to the broker that owns
// the request set, and an ensure that deleted conditioned cells on the strength of a set it was
// handed would be one bad argument away from revoking every expiring grant in the project.
fn conditioned_cell_is_ungranted(c: GcpIamBindingCell, granted: List<GcpIamBindingCell>) -> Bool {
  match c.condition {
    Absent => false
    Present { value: _ } =>
      if gcp_cell_in(c: c, xs: granted) { false } else { true }
  }
}

fn conditioned_cells_without_grant(
  observed: GcpPolicy,
  granted: List<GcpIamBindingCell>
) -> List<GcpIamBindingCell> {
  fold(
    gcp_policy_cells(p: observed),
    init: no_gcp_cells,
    f: (acc, c) =>
      if conditioned_cell_is_ungranted(c: c, granted: granted) {
        acc |> list_push(c)
      } else {
        acc
      }
  )
}

// ── The terminal is TYPED; ProcessExit is only its CLI-edge projection ───────────────────────
// A process exit code is not a verdict. It collapses "refused before anything was read", "already
// converged, nothing written", "written and independently observed" and "written and NOT observed"
// into one bit. Those have different remedies, and a caller that has to act on the difference
// (a roster fold, an approval-key provision) can only get it from this type, never from an exit.
//
// WHAT THE WRITE RESPONSE IS, AND WHAT IT IS NOT. setIamPolicy returns the policy the server says
// it installed. That is real APPLICATION EVIDENCE: it separates a write the server accepted but
// reshaped (the cell is missing from its own reply) from one that landed as sent. It is NOT an
// observation of the secret's policy. It is the actuation's own account of itself, and DESIGN §3d
// is explicit that a successful actuation return cannot mint convergence. So the response is kept
// in SecretAccessApplication, reported beside the verdict, and never consulted to decide it. Only
// an independent getIamPolicy issued after the write can reach SecretAccessConvergedAfterWrite.
type SecretAccessApplication {
  written_at_etag: String
  response: GcpPolicy
  response_carries_cell: Bool
}

// What the independent re-read failed to show. Both fields are reported together, not
// short-circuited: a readback missing the granted cell AND a foreign cell is two facts, and
// reporting the first alone would hide the second (a write that dropped someone else's access).
type SecretAccessReadbackDeficit {
  granted_cell_present: Bool
  preserved_cells_missing: List<GcpIamBindingCell>
}

type SecretAccessReconciliation
  = SecretAccessRefused { cause: String }
  | SecretAccessObservationLossy { conditional_roles: List<String> }
  | SecretAccessConvergenceClaimUnseen { observed: GcpPolicy }
  | SecretAccessAlreadyConverged { observed: GcpPolicy }
  | SecretAccessConvergedAfterWrite { application: SecretAccessApplication, readback: GcpPolicy }
  | SecretAccessNotConvergedAfterWrite {
      application: SecretAccessApplication
      readback: GcpPolicy
      deficit: SecretAccessReadbackDeficit
    }
  | SecretAccessReadbackLossy { application: SecretAccessApplication, conditional_roles: List<String> }

fn secret_access_application(written_at_etag: String, response: GcpPolicy, member: String, grant: SecretAccessGrant) -> SecretAccessApplication {
  SecretAccessApplication {
    written_at_etag: written_at_etag,
    response: response,
    response_carries_cell: secret_access_grant_present(policy: response, member: member, grant: grant)
  }
}

// THE ASSESSMENT OF THE INDEPENDENT READ. `application` is a parameter so it can be REPORTED, and
// no branch below reads it: whatever the write response claimed, the verdict is a function of
// `readback` alone. That is the property the witnesses pin with a response that carries the cell
// and a readback that does not.
//
// The readback owes the same representation check as the first read. A version-1 document of a
// conditional policy has condition-mangled role names, and looking for a cell in it can answer
// "present" or "absent" for the wrong reason, so it refuses rather than being assessed.
//
// A preserved cell (a foreign binding the reconcile kept) missing from the readback is a deficit
// even when the granted cell is present. Either the write dropped someone else's access or a
// concurrent writer replaced the policy under us. This ensure cannot tell which, and neither is
// convergence.
//
// STALE ETAG AND CONCURRENT REPLACEMENT. The write carries the etag it was reconciled at, so a
// policy changed since the first read is refused by the server with 412, and that raises: the
// line stops. A replacement landing AFTER the write is caught here, because the readback is the
// state that exists now, not the state the write produced.
fn secret_access_assess_readback(
  member: String,
  grant: SecretAccessGrant,
  preserved: List<GcpIamBindingCell>,
  application: SecretAccessApplication,
  readback: GcpPolicy
) -> SecretAccessReconciliation {
  let mangled = condition_mangled_roles(p: readback)
  if count(mangled) > 0 {
    SecretAccessReadbackLossy { application: application, conditional_roles: mangled }
  } else {
    let readback_cells = gcp_policy_cells(p: readback)
    let missing = preserved |> filter(c => !gcp_cell_in(c: c, xs: readback_cells))
    let present = secret_access_grant_present(policy: readback, member: member, grant: grant)
    if present && count(missing) == 0 {
      SecretAccessConvergedAfterWrite { application: application, readback: readback }
    } else {
      SecretAccessNotConvergedAfterWrite {
        application: application,
        readback: readback,
        deficit: SecretAccessReadbackDeficit { granted_cell_present: present, preserved_cells_missing: missing }
      }
    }
  }
}

// ── The ensure ───────────────────────────────────────────────────────────────────────────────
// THIS IS A func, NOT A pattern, AND THAT IS THE WHOLE POINT OF THE SHAPE. The `pattern`/`node`
// form cannot branch on a verdict: gunbc.assimilate.bmc_bootstrap_provision records that as a
// KNOWN BYPASS, where GcpPolicyAlreadyConverged is computed and DISCARDED because the call site
// cannot skip its own effect, so a converged policy is written anyway and the etag advances -- a
// re-run that changed nothing looks like it changed something. A func can match, call the
// operation inside the arm, and return early, so the converged case performs NO WRITE. The no-op
// is structural rather than promised, which is why reconcile_gcp_policy's AlreadyConverged is
// consumed as its own arm rather than a delta that happens to be empty.
//
// GET -> reconcile -> set -> GET AGAIN -> assess the second GET. The second read costs exactly
// one getIamPolicy per APPLY (the AlreadyConverged arm writes nothing and reads once), so a
// converging run makes 3 calls instead of 2. That is paid unconditionally; there is no switch to
// skip it.
//
// AN UNREADABLE RE-READ STOPS THE PROCESS, AND THAT IS A DECLARED LOSS, NOT A TYPED REFUSAL.
// GetSecretIamPolicy declares no RestOutcome, so the interpreter's dispatch_rest raises a non-2xx
// as a located "HTTP <status>: <body>" type error instead of returning a value. No path from that
// failure reaches secret_access_assess_readback, so the write response is never used in its place.
// But a caller gets a stopped process, not a typed, located refusal it could reconcile, and this
// result deliberately has no inaccessible-readback arm: production could never construct one, and
// a constructor nothing builds is a decoration that would be cited as coverage.
//
// WHAT HAS BEEN EXECUTED, AND WHAT HAS NOT. That a no-outcome REST operation raises on non-2xx is
// executed for the mechanism by test.claim.rest_exchange_replay_test
// rest_operation_without_outcome_still_refuses. It has NOT been executed for THIS fold's re-read.
// Replay keys a fixture by exact invocation, and the first read and the re-read are the same
// invocation, so no fixture set can answer 200 to one and 403 to the other. The invocation's
// input_digest is also minted host-side over the bound inputs and has no .dag constructor to
// author it from. So the stop is a claim resting on the mechanism, not a measurement of this route.
//
// RESTORATION TRIGGER, NAMING THE CAPABILITY: GetSecretIamPolicy carries a typed RestOutcome AND
// every caller can branch on it. Concretely, gunbc.assimilate.bmc_bootstrap_provision's `node`
// pattern becomes an EffectPlan step that can refuse. Adding the outcome field alone must NOT be
// read as satisfying this. Today that pattern would receive a failed read as an empty policy with
// etag "" and hand it to SetSecretIamPolicy: an unconditional overwrite driven by a read that
// failed, which is strictly worse than the defect this readback repairs.
fn secret_access_reconcile_for(grant: SecretAccessGrant, token_source: AccessTokenSource) -> SecretAccessReconciliation
  uses net: Network
{
  match grant_member_resolution() {
    GrantMemberUnresolved { cause: c } => return SecretAccessRefused { cause: c }
    GrantMemberResolved { member: member } =>
      match ensure_access_token(source: token_source) {
        AccessTokenUpsertRequired { plan: upsert_plan } =>
          return SecretAccessRefused { cause: access_token_upsert_required_reason(plan: upsert_plan) }
        AccessTokenEnsureRefused { reason: reason } =>
          return SecretAccessRefused { cause: reason as String }
        AccessTokenReady { token: token } => {
          observed = gcp.SecretManager.GetSecretIamPolicy(
            access_token: token,
            project_id: grant.target.project,
            secret: grant.target.secret
          )
          let observed_policy = gcp_policy_from_wire(bindings: observed.bindings, etag: observed.etag, version: observed.version)
          match reconcile_gcp_policy(
            observed: observed_policy,
            desired_owned: secret_access_desired_cells(member: member, grant: grant),
            owned_universe: secret_access_owned_universe(member: member, grant: grant)
          ) {
            GcpPolicyRepresentationLossy { conditional_roles: rs } =>
              SecretAccessObservationLossy { conditional_roles: rs }
            GcpPolicyAlreadyConverged { policy: p } =>
              if secret_access_grant_present(policy: p, member: member, grant: grant) {
                SecretAccessAlreadyConverged { observed: p }
              } else {
                SecretAccessConvergenceClaimUnseen { observed: p }
              }
            GcpPolicyDeltaRequired { policy: desired_policy, added: _, removed: _, preserved: preserved } => {
              written = gcp.SecretManager.SetSecretIamPolicy(
                access_token: token,
                project_id: grant.target.project,
                secret: grant.target.secret,
                policy: desired_policy
              )
              let application = secret_access_application(
                written_at_etag: desired_policy.etag,
                response: gcp_policy_from_wire(bindings: written.bindings, etag: written.etag, version: written.version),
                member: member,
                grant: grant
              )
              reread = gcp.SecretManager.GetSecretIamPolicy(
                access_token: token,
                project_id: grant.target.project,
                secret: grant.target.secret
              )
              secret_access_assess_readback(
                member: member,
                grant: grant,
                preserved: preserved,
                application: application,
                readback: gcp_policy_from_wire(bindings: reread.bindings, etag: reread.etag, version: reread.version)
              )
            }
          }
        }
      }
  }
}

// The CLI edge. Every arm but the two convergences is a failure, and each failure keeps the cause
// its typed arm carried.
fn secret_access_reconciliation_exit(r: SecretAccessReconciliation) -> ProcessExit {
  match r {
    SecretAccessRefused { cause: c } => exit_failure(reason: c)
    SecretAccessObservationLossy { conditional_roles: rs } =>
      exit_failure(
        reason: concat(
          "secret access ensure: the observed policy carries condition-mangled role names, so it was read at representation version 1 while containing conditional bindings. Reconciling against it would replace somebody's restricted access with an unconditional grant. Refusing; the read must request options.requestedPolicyVersion=3. First mangled role: ",
          first_or_empty(xs: rs)
        )
      )
    SecretAccessConvergenceClaimUnseen { observed: _ } =>
      exit_failure(reason: "secret access ensure: reconciliation reported the policy already converged, but the granted cell is absent from the policy it reported. Refusing rather than reporting a convergence this run cannot see")
    SecretAccessAlreadyConverged { observed: _ } => ExitSuccess
    SecretAccessConvergedAfterWrite { application: _, readback: _ } => ExitSuccess
    SecretAccessNotConvergedAfterWrite { application: a, readback: _, deficit: d } =>
      exit_failure(
        reason: concat(
          concat(
            if d.granted_cell_present {
              "secret access ensure: setIamPolicy returned 200 and the independent re-read carries the granted cell, but it has lost cells this ensure preserved (a foreign binding was dropped or the policy was replaced concurrently). Not converged."
            } else {
              "secret access ensure: setIamPolicy returned 200 but the independent re-read does not carry the granted cell. Not converged."
            },
            if a.response_carries_cell { " The write response DID carry the cell; it is application evidence, not observation." } else { " The write response did not carry the cell either." }
          ),
          concat(" Etag written at: ", a.written_at_etag)
        )
      )
    SecretAccessReadbackLossy { application: _, conditional_roles: rs } =>
      exit_failure(
        reason: concat(
          "secret access ensure: the post-write re-read carries condition-mangled role names, so its representation cannot establish the cell. Refusing. First mangled role: ",
          first_or_empty(xs: rs)
        )
      )
  }
}

fn secret_access_ensure_for(grant: SecretAccessGrant, token_source: AccessTokenSource) -> ProcessExit
  uses net: Network
{
  secret_access_reconciliation_exit(r: secret_access_reconcile_for(grant: grant, token_source: token_source))
}

// The operation ceiling, stated so a witness executes it instead of a comment asserting it. These
// are the two operations this ensure performs, and the pair is the subject of both checks below.
fn secret_access_ensure_operations() -> List<SecretManagerOperation> {
  [SmGetIamPolicy, SmSetIamPolicy]
}

fn principal_admits_every_ensure_operation(principal: FleetCloudPrincipalKey) -> Bool {
  fold(
    secret_access_ensure_operations(),
    init: true,
    f: (acc, op) => acc && principal_role_admits_operation(principal: principal, op: op)
  )
}

fn principal_admits_any_ensure_operation(principal: FleetCloudPrincipalKey) -> Bool {
  fold(
    secret_access_ensure_operations(),
    init: false,
    f: (acc, op) => acc || principal_role_admits_operation(principal: principal, op: op)
  )
}

fn ensure_control_plane_principal() -> FleetCloudPrincipalKey {
  FleetCloudGrantAdministratorPrincipal { role: FleetCloudGrantAdministrator {} }
}

fn ensure_workload_principal() -> FleetCloudPrincipalKey {
  FleetCloudConvergencePrincipal { role: FleetCloudConvergence {} }
}
