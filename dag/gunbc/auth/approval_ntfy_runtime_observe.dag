module gunbc.auth.approval_ntfy_runtime_observe

import std.types { NonEmptyStr, String, Int, List }
import v2.std.algebra { any }
import extdeps.languages.json.emit { JsonValue, JsonKeyValue, JsonNull, JsonBool, JsonNumber, JsonString, JsonArray, JsonObject, json_kv, json_string, json_int, json_array, json_object, serialize_json }
import extdeps.languages.json.parse {
  parse_json_document, JsonDocumentParse, JsonDocumentParsed, JsonDocumentUnreadable, json_document_gap_text,
  json_object_members_named, json_field, json_field_int, json_field_string, json_field_string_list,
  json_field_value, json_field_cause,
}
import gunbc.auth.approval_ntfy_deployment { approval_ntfy_principal_name, approval_ntfy_unit_name }
import std.algebra { trim }
import std.measure { Second, second }
import std.resources { Network }
import std.process { ExitSuccess }
import gunbc.cli_wire { CliWireResponse, CliWirePrintable }
import gunbc.command_runner { run_shell_command_observe_outcome }
import extdeps.exec.command { ArgvCommand, LocalExec }
import extdeps.shell.exec { ProcessRunOutcome, ProcessRan, ProcessNotSpawned }
import extdeps.systemd { ActiveState, MainPID }
import extdeps.systemd.systemctl { systemctl_show_properties_command, systemctl_show_property_value }
import extdeps.tools.gnu_coreutils { cat_command, readlink_command, ls_one_per_line_command, timeout_command }
import extdeps.tools.stat { stat_dereferenced_inode_command }
import extdeps.linux.procfs { procfs_pid_file_path }
import extdeps.linux.proc_pid_stat { proc_pid_stat_start_time, StartTimeObserved }

// THE CONTRACT OF THE NTFY RUNTIME-OBSERVATION HELPER, and only the contract. The enrolment-code
// verb (gunbc.auth.approval_device_routes issue_device_enrolment_code, #12077) must join its ACL
// readback to the LIVE ntfy process: its actual environment, its exe, and its open fds (the auth
// file and the 127.0.0.1:2586 listening socket). Those are /proc/<MainPID> reads that only the
// process's own uid (gunbc-ntfy) or root can make. The verb runs as the operator's account, so it
// crosses to gunbc-ntfy through ONE exact sudoers grant for ONE released invocation of this entry.
//
// WHY AN ENTRY OF THE RELEASED BINARY AND NOT A SCRIPT OR A PER-PID ARGV. A per-PID `sudo -u
// gunbc-ntfy cat /proc/<pid>/environ` needs a wildcard in sudoers to cover a PID that changes on
// every restart, and a wildcard is refused. An authored `sh -c` helper was refused by review 70354.
// This entry is modeled .dag run by the broker's own released gunbc
// (gunbc.live_deploy.emit approval_broker_ntfy_runtime_observe_operation), with no arguments. So
// the sudoers line is that exact argv and leaves the grantee nothing to choose.
//
// WHAT LIVES WHERE. This module owns: the entry's identity (file and function), the principal it
// runs as, the typed observation, and its wire codec. That codec is the only way the observation
// crosses the process boundary, and both directions of it are defined here. The release-scoped argv
// and the grant are owned by gunbc.live_deploy.emit, because they are functions of the release
// locus. This module cannot import emit: emit imports this module, and the import graph is acyclic.
// The entry FUNCTION BODY -- the reads themselves -- is approval_ntfy_runtime_observe below. The
// four joins over its result are the verb's, in gunbc.auth.approval_ntfy_access_readback.

data approval_ntfy_runtime_observe_entry_rel: NonEmptyStr = "dag/gunbc/auth/approval_ntfy_runtime_observe.dag"
data approval_ntfy_runtime_observe_function: NonEmptyStr = "approval_ntfy_runtime_observe"

// THE PRINCIPAL IS THE NTFY SERVER'S OWN ACCOUNT, read from the deployment that creates it, so the
// grant's run-as and the account the unit runs under are one value.
fn approval_ntfy_runtime_observe_run_as() -> NonEmptyStr {
  approval_ntfy_principal_name
}

// ONE OPEN FD OF THE MAINPID, as ONE record. Not two parallel lists: an index alignment between
// targets and inodes would be an invariant every producer had to keep and every consumer had to
// trust. A record makes the pairing structural.
//
//   target        `readlink /proc/<MainPID>/fd/<n>`, VERBATIM. That includes `socket:[N]`,
//                 `pipe:[N]`, `anon_inode:[eventfd]`, and a trailing ` (deleted)` on an unlinked
//                 file. None of them is normalized. A deleted auth file must stay visible so the
//                 join refuses it.
//   target_inode  `stat -L -c %i /proc/<MainPID>/fd/<n>`: the inode of the object the fd refers to.
//                 For a regular file, it is that file's inode (still reported when the file is
//                 deleted). For `socket:[N]` and `pipe:[N]` it is N, the same number the link text
//                 carries, because sockfs and pipefs report their own inode. For an
//                 `anon_inode:[...]` target it is the anon_inode filesystem's ONE shared inode, so
//                 it identifies nothing and must not be joined on. Every fd yields an inode. An
//                 unreadable stat refuses the whole observation instead of dropping the fd.
type NtfyOpenFd {
  target: String
  target_inode: Int
}

// THE RAW READINGS OF ONE PROCESS. The helper reads MainPID itself and brackets its reads with the
// process's starttime, before and after. So every field describes one process incarnation, or the
// helper refuses. It returns readings, not verdicts. The joins (no NTFY_* names; exe == the declared
// binary; auth-file inode in the fd set; the 2586 socket inode in the fd set) are the verb's.
//
//   main_pid            systemd's MainPID for gunbc-ntfy.service. The helper REFUSES if the unit is
//                       not active or MainPID is 0. It never reports pid 0.
//   start_ticks_*       field 22 of /proc/<MainPID>/stat, read first and last. The verb joins both
//                       against its own bracket. Unequal values here are still reported, not refused,
//                       because the verb owns that comparison.
//   environment_names   the NAMES in /proc/<MainPID>/environ, in file order. Values are not carried:
//                       they may hold secrets, and the join needs only the names.
//   exe_target          `readlink /proc/<MainPID>/exe`, VERBATIM, ` (deleted)` included.
//   exe_inode           `stat -L -c %i /proc/<MainPID>/exe`.
type NtfyRuntimeProcessObservation {
  main_pid: Int
  start_ticks_before: Int
  start_ticks_after: Int
  environment_names: List<String>
  exe_target: String
  exe_inode: Int
  open_fds: List<NtfyOpenFd>
}

// `read` names the read that failed (for example `unit`, `environ`, `fd`), and `cause` is its
// diagnostic. A refusal is an outcome of the helper, not a transport failure. A helper that could
// not run at all (no grant, no binary, resolve failure) reaches the verb as a nonzero exit.
type NtfyRuntimeObserveOutcome
  = NtfyRuntimeObserved { observation: NtfyRuntimeProcessObservation }
  | NtfyRuntimeObserveRefused { read: String, cause: String }

// ── THE WIRE: THE MODELED JSON GRAMMAR, AND ONE KEY TABLE PER OUTCOME ─────────────────────────
// The observation crosses the process boundary as one JSON object, written by
// extdeps.languages.json.emit serialize_json and read by extdeps.languages.json.parse
// parse_json_document. That grammar is already modeled in both directions, so this module adds no
// second lexical grammar and does no escaping of its own. A target containing a newline, a quote or
// `=` is carried verbatim, because JSON string escaping carries every code point.
//
// WHICH KEYS AN OUTCOME MAY CARRY IS ONE TABLE, READ BY BOTH DIRECTIONS. The encoder emits exactly
// the keys ntfy_runtime_wire_keys names for its arm. The decoder refuses an object that carries any
// other member: the other arm's keys, an unknown key, or a duplicate. So an `observed` object with
// refusal members, or a `refused` object with observation members, is undecodable. It is never read
// as whichever arm the `outcome` member happens to name (review 70435).

data ntfy_runtime_wire_outcome: String = "outcome"
data ntfy_runtime_wire_observed: String = "observed"
data ntfy_runtime_wire_refused: String = "refused"
data ntfy_runtime_wire_main_pid: String = "main_pid"
data ntfy_runtime_wire_start_before: String = "start_ticks_before"
data ntfy_runtime_wire_start_after: String = "start_ticks_after"
data ntfy_runtime_wire_environment_names: String = "environment_names"
data ntfy_runtime_wire_exe_target: String = "exe_target"
data ntfy_runtime_wire_exe_inode: String = "exe_inode"
data ntfy_runtime_wire_open_fds: String = "open_fds"
data ntfy_runtime_wire_fd_target: String = "target"
data ntfy_runtime_wire_fd_target_inode: String = "target_inode"
data ntfy_runtime_wire_read: String = "read"
data ntfy_runtime_wire_cause: String = "cause"

type NtfyRuntimeWireArm
  = WireArmObserved
  | WireArmRefused
  | WireArmOpenFd

fn ntfy_runtime_wire_keys(arm: NtfyRuntimeWireArm) -> List<String> {
  match arm {
    WireArmObserved => [
      ntfy_runtime_wire_outcome,
      ntfy_runtime_wire_main_pid,
      ntfy_runtime_wire_start_before,
      ntfy_runtime_wire_start_after,
      ntfy_runtime_wire_environment_names,
      ntfy_runtime_wire_exe_target,
      ntfy_runtime_wire_exe_inode,
      ntfy_runtime_wire_open_fds,
    ]
    WireArmRefused => [ntfy_runtime_wire_outcome, ntfy_runtime_wire_read, ntfy_runtime_wire_cause]
    WireArmOpenFd => [ntfy_runtime_wire_fd_target, ntfy_runtime_wire_fd_target_inode]
  }
}

// THE ENCODER'S MEMBERS ARE THE KEY TABLE MAPPED THROUGH ONE VALUE FUNCTION, so the population the
// encoder writes and the population the decoder admits are the same list, not two lists kept in
// step. A key a value function does not recognise encodes as null. The decoder refuses null for
// every member, so a table row with no encoding cannot round-trip silently.
fn ntfy_open_fd_value(fd: NtfyOpenFd, key: String) -> JsonValue {
  if key == ntfy_runtime_wire_fd_target { json_string(s: fd.target) }
  else if key == ntfy_runtime_wire_fd_target_inode { json_int(n: fd.target_inode) }
  else { JsonNull }
}

fn ntfy_open_fd_json(fd: NtfyOpenFd) -> JsonValue {
  json_object(members: map(ntfy_runtime_wire_keys(arm: WireArmOpenFd), k => json_kv(key: k, value: ntfy_open_fd_value(fd: fd, key: k))))
}

fn ntfy_runtime_observed_value(o: NtfyRuntimeProcessObservation, key: String) -> JsonValue {
  if key == ntfy_runtime_wire_outcome { json_string(s: ntfy_runtime_wire_observed) }
  else if key == ntfy_runtime_wire_main_pid { json_int(n: o.main_pid) }
  else if key == ntfy_runtime_wire_start_before { json_int(n: o.start_ticks_before) }
  else if key == ntfy_runtime_wire_start_after { json_int(n: o.start_ticks_after) }
  else if key == ntfy_runtime_wire_environment_names { json_array(elements: map(o.environment_names, n => json_string(s: n))) }
  else if key == ntfy_runtime_wire_exe_target { json_string(s: o.exe_target) }
  else if key == ntfy_runtime_wire_exe_inode { json_int(n: o.exe_inode) }
  else if key == ntfy_runtime_wire_open_fds { json_array(elements: map(o.open_fds, f => ntfy_open_fd_json(fd: f))) }
  else { JsonNull }
}

fn ntfy_runtime_refused_value(read: String, cause: String, key: String) -> JsonValue {
  if key == ntfy_runtime_wire_outcome { json_string(s: ntfy_runtime_wire_refused) }
  else if key == ntfy_runtime_wire_read { json_string(s: read) }
  else if key == ntfy_runtime_wire_cause { json_string(s: cause) }
  else { JsonNull }
}

fn ntfy_runtime_observe_json(outcome: NtfyRuntimeObserveOutcome) -> JsonValue {
  match outcome {
    NtfyRuntimeObserveRefused { read: r, cause: c } =>
      json_object(members: map(ntfy_runtime_wire_keys(arm: WireArmRefused), k => json_kv(key: k, value: ntfy_runtime_refused_value(read: r, cause: c, key: k))))
    NtfyRuntimeObserved { observation: o } =>
      json_object(members: map(ntfy_runtime_wire_keys(arm: WireArmObserved), k => json_kv(key: k, value: ntfy_runtime_observed_value(o: o, key: k))))
  }
}

// TOTAL: every outcome has an encoding.
fn ntfy_runtime_observe_encode(outcome: NtfyRuntimeObserveOutcome) -> String {
  serialize_json(v: ntfy_runtime_observe_json(outcome: outcome))
}

// ── DECODE: TOTAL, AND EVERY MISMATCH IS A TYPED REFUSAL ──────────────────────────────────────
type NtfyRuntimeObserveReading
  = NtfyRuntimeReadingDecoded { outcome: NtfyRuntimeObserveOutcome }
  | NtfyRuntimeReadingUndecodable { cause: String }

// The first member whose key is not in the arm's table, or appears twice. Absent means the object
// carries only keys from the table, each at most once. Presence and type of each key are checked
// by the field reads that follow.
fn ntfy_runtime_wire_stray_member(v: JsonValue, arm: NtfyRuntimeWireArm) -> String? {
  match v {
    JsonObject { members: ms } =>
      fold(ms, init: none, f: (acc, m) =>
        match acc {
          Present { value: k } => Present { value: k }
          Absent =>
            if !any(ntfy_runtime_wire_keys(arm: arm), k => k == m.key) {
              Present { value: concat("member not carried by this outcome: ", m.key) }
            } else if count(json_object_members_named(members: ms, key: m.key)) > 1 {
              Present { value: concat("member repeated: ", m.key) }
            } else {
              none
            }
        }
      )
    JsonNull => Present { value: "not an object" }
    JsonBool { value: _ } => Present { value: "not an object" }
    JsonNumber { lexeme: _ } => Present { value: "not an object" }
    JsonString { value: _ } => Present { value: "not an object" }
    JsonArray { elements: _ } => Present { value: "not an object" }
  }
}

// FieldAbsent (missing or null) is a refusal for every field here: no member of either arm is
// optional.
fn ntfy_runtime_required_cause(key: String, cause: String?) -> String {
  match cause {
    Present { value: c } => c
    Absent => concat("missing ", key)
  }
}

fn ntfy_runtime_wire_read_open_fd(v: JsonValue) -> NtfyOpenFd? {
  match ntfy_runtime_wire_stray_member(v: v, arm: WireArmOpenFd) {
    Present { value: _ } => none
    Absent =>
      match json_field_value(r: json_field_string(obj: v, key: ntfy_runtime_wire_fd_target)) {
        Absent => none
        Present { value: t } =>
          match json_field_value(r: json_field_int(obj: v, key: ntfy_runtime_wire_fd_target_inode)) {
            Absent => none
            Present { value: n } => Present { value: NtfyOpenFd { target: t, target_inode: n } }
          }
      }
  }
}

fn ntfy_runtime_wire_open_fd_elements(elements: List<JsonValue>) -> List<NtfyOpenFd>? {
  fold(elements, init: Present { value: [] }, f: (acc, e) =>
    match acc {
      Absent => none
      Present { value: fds } =>
        match ntfy_runtime_wire_read_open_fd(v: e) {
          Absent => none
          Present { value: fd } => Present { value: concat(fds, [fd]) }
        }
    }
  )
}

fn ntfy_runtime_wire_read_open_fds(v: JsonValue) -> List<NtfyOpenFd>? {
  match json_field_value(r: json_field(obj: v, key: ntfy_runtime_wire_open_fds)) {
    Absent => none
    Present { value: arr } =>
      match arr {
        JsonArray { elements: es } => ntfy_runtime_wire_open_fd_elements(elements: es)
        JsonNull => none
        JsonBool { value: _ } => none
        JsonNumber { lexeme: _ } => none
        JsonString { value: _ } => none
        JsonObject { members: _ } => none
      }
  }
}

fn ntfy_runtime_wire_int(v: JsonValue, key: String) -> Int? {
  json_field_value(r: json_field_int(obj: v, key: key))
}

fn ntfy_runtime_decode_observed(v: JsonValue) -> NtfyRuntimeObserveReading {
  match ntfy_runtime_wire_int(v: v, key: ntfy_runtime_wire_main_pid) {
    Absent => NtfyRuntimeReadingUndecodable { cause: ntfy_runtime_required_cause(key: ntfy_runtime_wire_main_pid, cause: json_field_cause(r: json_field_int(obj: v, key: ntfy_runtime_wire_main_pid))) }
    Present { value: pid } =>
      match ntfy_runtime_wire_int(v: v, key: ntfy_runtime_wire_start_before) {
        Absent => NtfyRuntimeReadingUndecodable { cause: ntfy_runtime_required_cause(key: ntfy_runtime_wire_start_before, cause: json_field_cause(r: json_field_int(obj: v, key: ntfy_runtime_wire_start_before))) }
        Present { value: before } =>
          match ntfy_runtime_wire_int(v: v, key: ntfy_runtime_wire_start_after) {
            Absent => NtfyRuntimeReadingUndecodable { cause: ntfy_runtime_required_cause(key: ntfy_runtime_wire_start_after, cause: json_field_cause(r: json_field_int(obj: v, key: ntfy_runtime_wire_start_after))) }
            Present { value: after } =>
              match json_field_value(r: json_field_string_list(obj: v, key: ntfy_runtime_wire_environment_names)) {
                Absent => NtfyRuntimeReadingUndecodable { cause: ntfy_runtime_required_cause(key: ntfy_runtime_wire_environment_names, cause: json_field_cause(r: json_field_string_list(obj: v, key: ntfy_runtime_wire_environment_names))) }
                Present { value: names } =>
                  match json_field_value(r: json_field_string(obj: v, key: ntfy_runtime_wire_exe_target)) {
                    Absent => NtfyRuntimeReadingUndecodable { cause: ntfy_runtime_required_cause(key: ntfy_runtime_wire_exe_target, cause: json_field_cause(r: json_field_string(obj: v, key: ntfy_runtime_wire_exe_target))) }
                    Present { value: exe } =>
                      match ntfy_runtime_wire_int(v: v, key: ntfy_runtime_wire_exe_inode) {
                        Absent => NtfyRuntimeReadingUndecodable { cause: ntfy_runtime_required_cause(key: ntfy_runtime_wire_exe_inode, cause: json_field_cause(r: json_field_int(obj: v, key: ntfy_runtime_wire_exe_inode))) }
                        Present { value: exe_inode } =>
                          match ntfy_runtime_wire_read_open_fds(v: v) {
                            Absent => NtfyRuntimeReadingUndecodable { cause: "open_fds is missing, or an element is not exactly a target string plus a target_inode integer" }
                            Present { value: fds } =>
                              if pid <= 0 {
                                NtfyRuntimeReadingUndecodable { cause: "main_pid is not positive: an observed outcome never carries pid 0" }
                              } else {
                                NtfyRuntimeReadingDecoded { outcome: NtfyRuntimeObserved { observation: NtfyRuntimeProcessObservation {
                                  main_pid: pid,
                                  start_ticks_before: before,
                                  start_ticks_after: after,
                                  environment_names: names,
                                  exe_target: exe,
                                  exe_inode: exe_inode,
                                  open_fds: fds,
                                } } }
                              }
                          }
                      }
                  }
              }
          }
      }
  }
}

fn ntfy_runtime_decode_refused(v: JsonValue) -> NtfyRuntimeObserveReading {
  match json_field_value(r: json_field_string(obj: v, key: ntfy_runtime_wire_read)) {
    Absent => NtfyRuntimeReadingUndecodable { cause: ntfy_runtime_required_cause(key: ntfy_runtime_wire_read, cause: json_field_cause(r: json_field_string(obj: v, key: ntfy_runtime_wire_read))) }
    Present { value: r } =>
      match json_field_value(r: json_field_string(obj: v, key: ntfy_runtime_wire_cause)) {
        Absent => NtfyRuntimeReadingUndecodable { cause: ntfy_runtime_required_cause(key: ntfy_runtime_wire_cause, cause: json_field_cause(r: json_field_string(obj: v, key: ntfy_runtime_wire_cause))) }
        Present { value: c } => NtfyRuntimeReadingDecoded { outcome: NtfyRuntimeObserveRefused { read: r, cause: c } }
      }
  }
}

// THE ARM IS CHOSEN BY `outcome`, AND THEN THE WHOLE OBJECT MUST BELONG TO THAT ARM.
fn ntfy_runtime_decode_arm(v: JsonValue, arm: NtfyRuntimeWireArm) -> NtfyRuntimeObserveReading {
  match ntfy_runtime_wire_stray_member(v: v, arm: arm) {
    Present { value: why } => NtfyRuntimeReadingUndecodable { cause: why }
    Absent =>
      match arm {
        WireArmObserved => ntfy_runtime_decode_observed(v: v)
        WireArmRefused => ntfy_runtime_decode_refused(v: v)
        WireArmOpenFd => NtfyRuntimeReadingUndecodable { cause: "an open_fd record is not an outcome" }
      }
  }
}

fn ntfy_runtime_observe_decode(text: String) -> NtfyRuntimeObserveReading {
  match parse_json_document(s: text) {
    JsonDocumentUnreadable { gap: g } => NtfyRuntimeReadingUndecodable { cause: concat("not one JSON document: ", json_document_gap_text(gap: g)) }
    JsonDocumentParsed { value: v } =>
      match json_field_value(r: json_field_string(obj: v, key: ntfy_runtime_wire_outcome)) {
        Absent => NtfyRuntimeReadingUndecodable { cause: ntfy_runtime_required_cause(key: ntfy_runtime_wire_outcome, cause: json_field_cause(r: json_field_string(obj: v, key: ntfy_runtime_wire_outcome))) }
        Present { value: o } =>
          if o == ntfy_runtime_wire_observed {
            ntfy_runtime_decode_arm(v: v, arm: WireArmObserved)
          } else if o == ntfy_runtime_wire_refused {
            ntfy_runtime_decode_arm(v: v, arm: WireArmRefused)
          } else {
            NtfyRuntimeReadingUndecodable { cause: concat("unknown outcome ", o) }
          }
      }
  }
}

// ── THE ENTRY: the reads, as the server's own principal ─────────────────────────────────────
// Run only through the per-release grant (gunbc.live_deploy.emit approval_ntfy_runtime_observe_helper_argv),
// so it runs as gunbc-ntfy and can read /proc/<MainPID>/{environ,exe,fd}. It accepts nothing: the
// MainPID is systemd's, read here, and the verb joins it against its own reading of the unit.
//
// EVERY READ IS AN extdeps ARGV UNDER THE SAME TIMEOUT THE VERB'S READS USE, and every failure is the
// NtfyRuntimeObserveRefused arm naming that read. Nothing is skipped: an fd that closes between the
// listing of fd/ and its readlink refuses the whole observation rather than dropping out of the set,
// because a set with a hole in it cannot answer "is the auth file among them". The operator re-runs.
// The outcome is ALWAYS printed and the exit is ALWAYS success: a refusal is an observation of the
// process, and only a helper that could not run at all reaches the verb as a nonzero exit.
data ntfy_runtime_observe_read_timeout: Second = second(count: 10)
data ntfy_runtime_observe_read_kill_after: Second = second(count: 2)

type NtfyObservedText
  = NtfyTextRead { stdout: String }
  | NtfyTextRefused { read: String, cause: String }

fn ntfy_runtime_observe_read(read: String, command: ArgvCommand) -> NtfyObservedText
  uses net: Network
{
  match run_shell_command_observe_outcome(
    command: timeout_command(duration: ntfy_runtime_observe_read_timeout, kill_after: ntfy_runtime_observe_read_kill_after, command: command),
    transport: LocalExec,
  ) {
    ProcessNotSpawned { program: p, cause: c } => NtfyTextRefused { read: read, cause: "'" + (p as String) + "' could not be spawned: " + (c as String) }
    ProcessRan { observation: o } =>
      if o.exit_code != 0 { NtfyTextRefused { read: read, cause: "exit " + to_string(o.exit_code) + ": " + trim(s: o.stderr) } }
      else { NtfyTextRead { stdout: o.stdout } }
  }
}

// readlink(1) ends its line with one newline; exactly that one is removed, so the target is otherwise
// VERBATIM (a ` (deleted)` suffix stays).
fn readlink_target(stdout: String) -> String {
  if ends_with(s: stdout, suffix: "\n") { substring(s: stdout, start: 0, end: string_length(s: stdout) - 1) } else { stdout }
}

// /proc/<pid>/environ: NAME=value entries, each NUL-terminated. Only the names are kept, in order.
fn environ_names(text: String) -> List<String> {
  map(filter(split(s: text, delimiter: "\x00"), e => e != ""), e => match first(split(s: e, delimiter: "=")) { Present { value: n } => n  Absent => e })
}

fn ntfy_observe_refused(read: String, cause: String) -> NtfyRuntimeObserveOutcome {
  NtfyRuntimeObserveRefused { read: read, cause: cause }
}

// The unit's MainPID when the unit is active and names a process; otherwise the refusal cause.
type NtfyUnitPid
  = NtfyUnitPidFound { pid: Int }
  | NtfyUnitPidRefused { cause: String }

fn ntfy_unit_main_pid(text: String) -> NtfyUnitPid {
  match systemctl_show_property_value(text: text, key: "ActiveState") {
    Absent => NtfyUnitPidRefused { cause: "no ActiveState= line" }
    Present { value: state } =>
      if state != "active" { NtfyUnitPidRefused { cause: "unit is '" + state + "', not active" } }
      else { match systemctl_show_property_value(text: text, key: "MainPID") {
        Absent => NtfyUnitPidRefused { cause: "no MainPID= line" }
        Present { value: p } => match parse_int(s: p) {
          Absent => NtfyUnitPidRefused { cause: "MainPID '" + p + "' is not an integer" }
          Present { value: n } => if n <= 0 { NtfyUnitPidRefused { cause: "MainPID is " + p + ": no main process" } } else { NtfyUnitPidFound { pid: n } }
        }
      } }
  }
}

fn ntfy_start_ticks(text: String) -> Int? {
  match proc_pid_stat_start_time(content: text) {
    StartTimeObserved { ticks_since_boot: t } => Present { value: t }
    _ => none
  }
}

fn approval_ntfy_runtime_observe() -> CliWireResponse
  uses net: Network
{
  CliWirePrintable { bytes: ntfy_runtime_observe_encode(outcome: approval_ntfy_runtime_observation()) + "\n", exit: ExitSuccess }
}

fn approval_ntfy_runtime_observation() -> NtfyRuntimeObserveOutcome
  uses net: Network
{
  match ntfy_runtime_observe_read(read: "unit", command: systemctl_show_properties_command(unit: approval_ntfy_unit_name, properties: [ActiveState, MainPID])) {
    NtfyTextRefused { read: r, cause: c } => ntfy_observe_refused(read: r, cause: c)
    NtfyTextRead { stdout: unit } => match ntfy_unit_main_pid(text: unit) {
      NtfyUnitPidRefused { cause: c } => ntfy_observe_refused(read: "unit", cause: c)
      NtfyUnitPidFound { pid: pid } => ntfy_observe_process(pid: to_string(pid), main_pid: pid)
    }
  }
}

fn ntfy_observe_process(pid: String, main_pid: Int) -> NtfyRuntimeObserveOutcome
  uses net: Network
{
  match ntfy_runtime_observe_read(read: "stat", command: cat_command(path: procfs_pid_file_path(pid: pid, file: "stat"))) {
    NtfyTextRefused { read: r, cause: c } => ntfy_observe_refused(read: r, cause: c)
    NtfyTextRead { stdout: stat_before } => match ntfy_start_ticks(text: stat_before) {
      Absent => ntfy_observe_refused(read: "stat", cause: "no starttime field")
      Present { value: before } => match ntfy_runtime_observe_read(read: "environ", command: cat_command(path: procfs_pid_file_path(pid: pid, file: "environ"))) {
        NtfyTextRefused { read: r, cause: c } => ntfy_observe_refused(read: r, cause: c)
        NtfyTextRead { stdout: environ } => match ntfy_runtime_observe_read(read: "exe", command: readlink_command(path: procfs_pid_file_path(pid: pid, file: "exe"))) {
          NtfyTextRefused { read: r, cause: c } => ntfy_observe_refused(read: r, cause: c)
          NtfyTextRead { stdout: exe } => match ntfy_runtime_observe_read(read: "exe inode", command: stat_dereferenced_inode_command(path: procfs_pid_file_path(pid: pid, file: "exe"))) {
            NtfyTextRefused { read: r, cause: c } => ntfy_observe_refused(read: r, cause: c)
            NtfyTextRead { stdout: exe_inode_text } => match parse_int(s: trim(s: exe_inode_text)) {
              Absent => ntfy_observe_refused(read: "exe inode", cause: "not an integer: " + trim(s: exe_inode_text))
              Present { value: exe_inode } => match ntfy_observe_fds(pid: pid) {
                NtfyFdsRefused { read: r, cause: c } => ntfy_observe_refused(read: r, cause: c)
                NtfyFdsRead { fds: fds } => match ntfy_runtime_observe_read(read: "stat", command: cat_command(path: procfs_pid_file_path(pid: pid, file: "stat"))) {
                  NtfyTextRefused { read: r, cause: c } => ntfy_observe_refused(read: r, cause: c)
                  NtfyTextRead { stdout: stat_after } => match ntfy_start_ticks(text: stat_after) {
                    Absent => ntfy_observe_refused(read: "stat", cause: "no starttime field (last)")
                    Present { value: after } => NtfyRuntimeObserved { observation: NtfyRuntimeProcessObservation {
                      main_pid: main_pid,
                      start_ticks_before: before,
                      start_ticks_after: after,
                      environment_names: environ_names(text: environ),
                      exe_target: readlink_target(stdout: exe),
                      exe_inode: exe_inode,
                      open_fds: fds,
                    } }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

type NtfyFdsObserved
  = NtfyFdsRead { fds: List<NtfyOpenFd> }
  | NtfyFdsRefused { read: String, cause: String }

type NtfyFdObserved
  = NtfyFdRead { fd: NtfyOpenFd }
  | NtfyFdRefused { read: String, cause: String }

fn ntfy_observe_fd(pid: String, n: String) -> NtfyFdObserved
  uses net: Network
{
  let path = procfs_pid_file_path(pid: pid, file: "fd/" + n)
  match parse_int(s: n) {
    Absent => NtfyFdRefused { read: "fd", cause: "fd/ entry '" + n + "' is not a descriptor number" }
    Present { value: _ } => match ntfy_runtime_observe_read(read: "fd " + n, command: readlink_command(path: path)) {
      NtfyTextRefused { read: r, cause: c } => NtfyFdRefused { read: r, cause: c }
      NtfyTextRead { stdout: target } => match ntfy_runtime_observe_read(read: "fd " + n + " inode", command: stat_dereferenced_inode_command(path: path)) {
        NtfyTextRefused { read: r, cause: c } => NtfyFdRefused { read: r, cause: c }
        NtfyTextRead { stdout: inode_text } => match parse_int(s: trim(s: inode_text)) {
          Absent => NtfyFdRefused { read: "fd " + n + " inode", cause: "not an integer: " + trim(s: inode_text) }
          Present { value: i } => NtfyFdRead { fd: NtfyOpenFd { target: readlink_target(stdout: target), target_inode: i } }
        }
      }
    }
  }
}

fn ntfy_observe_fds(pid: String) -> NtfyFdsObserved
  uses net: Network
{
  match ntfy_runtime_observe_read(read: "fd", command: ls_one_per_line_command(path: procfs_pid_file_path(pid: pid, file: "fd"))) {
    NtfyTextRefused { read: r, cause: c } => NtfyFdsRefused { read: r, cause: c }
    NtfyTextRead { stdout: listing } => {
      let observed = map(filter(split(s: listing, delimiter: "\n"), l => l != ""), n => ntfy_observe_fd(pid: pid, n: n))
      match first(filter(observed, o => match o { NtfyFdRefused { read: _, cause: _ } => true  NtfyFdRead { fd: _ } => false })) {
        Present { value: NtfyFdRefused { read: r, cause: c } } => NtfyFdsRefused { read: r, cause: c }
        _ => NtfyFdsRead { fds: flat_map(observed, o => match o { NtfyFdRead { fd: fd } => [fd]  NtfyFdRefused { read: _, cause: _ } => [] }) }
      }
    }
  }
}
