// WIP DRAFT -- NOT A SOURCE FILE ON PURPOSE (extension .wip), NOT VALIDATED, DO NOT MERGE.
// Starting point for the mint-after-decision split (see the handoff in the commit message and the pinned
// plan). The three legs are lifted from heal_publication's in-process exchange; the FIELD SET AND THE
// REFUSAL SHAPES BELOW ARE INVENTED and several names do not exist in the model -- it has never been
// resolved. Rename to federated_workload_credential.dag only when you are ready to compile it, and expect
// to fix: DedicatedFederation is NOT in the mint path (delete it), env_value / rest_refusal_text are
// file-local in heal_publication.dag (lines 122 and 263) so the mint must own them or return typed
// refusals, and the lifetime ceiling must come from token_lifetime_within_ordinary_maximum BEFORE any send.
module gunbc.auth.federated_workload_credential

// ONE FEDERATION, ONE MINT. A runner that needs a short-lived Google credential for one request has one
// honest way to get it: ask the Actions OIDC sidecar for an assertion, exchange it at Cloud STS for a
// federated token, and impersonate the workload's own service account for the lifetime the request
// actually needs -- so the token's age starts at its own mint, one call above the request that spends it.
// gunbc.heal_publication built this route under #16160 after run 41951465805 minted at 02:07:18Z, spent
// the credential at 02:14:54.435Z, and used 456 s of a 300 s token because 273.6 s of interpreter
// front-end and 71 s of git fetch sat between the two. gunbc.fleet.printer_operator_approval is the
// SECOND workload to need it -- its delivery credential is what caps the printer's operator card below the
// approval policy row -- and per gunbc.design_argument::root_generalization the second user is the
// trigger to generalize, so the protocol lives here and neither workload owns it. What stays with each
// workload is only what is genuinely its own: which service account, which audiences, which scope, which
// lifetime -- the fields of FederatedWorkloadMint below, supplied from rows in the asking module.
//
// WHY THE IMPERSONATION GOES THROUGH THE API MODEL. `acquire_impersonated_access` is the one place that
// reads the clock BEFORE the send, decodes the response's own `expireTime` through the shared RFC 3339
// parse, and returns a credential whose validity is the issuer's statement rather than nothing. Calling
// gcp.IAM.GenerateAccessToken here would keep the token and throw the expiry away -- the defect DESIGN
// names for optional_impersonation -- and would leave every caller's safety resting on two calls
// happening to sit next to each other. The credential is CARRIED out of this module, never unpacked: the
// caller spends it through a presentation that consumes the returned expiry at the instant of use
// (std.credential_admission), which is what makes "minted at the point of use" a checked property rather
// than a claim about adjacency.
//
// WHAT THIS MODULE IS NOT. It is not a credential cache, not a refresh loop, and not a way to hold a
// token longer: the ceiling below is asked BEFORE any send, and a request past the lifetime Google grants
// without the organization-policy constraint this runner cannot observe is refused for free rather than
// sent and read as a 400. The token lives in this process's memory only -- never in the environment (the
// step-env entry this replaces was masked in the log but real in every child process), never in argv,
// never in a file, never in a receipt.

import std.types { NonEmptyStr, String, Optional }
import std.optional { Present, Absent }
import std.resources { Network }
import std.measure { Second }
import extdeps.cloud.gcp.sts
import extdeps.cloud.gcp.iam {
  token_lifetime_wire, token_lifetime_within_ordinary_maximum, acquire_impersonated_access,
  GcpImpersonatedAccessCredential, GcpImpersonatedAccessAcquired, GcpImpersonatedAccessClockUnread,
  GcpImpersonatedAccessRefused,
}
import extdeps.github.actions { github_actions_runtime }
import extdeps.transports.rest { RestAnswered, RestRefused, rest_refusal_text }
import gunbc.auth.heal_publisher_provision { DedicatedFederation }

// WHAT THE ASKING WORKLOAD SUPPLIES. `caller` is not decoration: it is the name every refusal carries,
// because a refusal read out of a log has to say whose credential it is -- the publisher's healing of a
// release note and the printer's delivery of a bed-clear print fail very differently. `federation` is the
// workload's own provisioned identity, and the impersonation target is read from it rather than passed
// beside it: a mint that could name a service account other than the one its federation provisions is a
// mint that can be pointed at somebody else's.
type FederatedWorkloadMint {
  caller: NonEmptyStr
  federation: DedicatedFederation
  assertion_audience: NonEmptyStr
  exchange_audience: NonEmptyStr
  scope: String
  lifetime: Second
}

// MINTED, OR NOT AT ALL. There is no third arm: no half-credential, no token without its expiry, no
// "assume it worked". A refusal is text a human reads, and the run decides what to do with it.
type FederatedWorkloadCredential
  = FederatedWorkloadCredentialMinted { credential: GcpImpersonatedAccessCredential }
  | FederatedWorkloadCredentialNotMinted { cause: String }

// THE CEILING IS ASKED BEFORE THE EXCHANGE, not discovered after it. Three federated round trips cost
// seconds and burn an OIDC assertion, so asking for a lifetime Google will not issue is a refusal the
// caller should compute for free first. The bound is the ORDINARY maximum and it is READ from the API
// model (extdeps.cloud.gcp.iam::token_lifetime_within_ordinary_maximum), never restated here: the extended
// maximum is reachable only under a condition this tree represents no allowlist for, so the ordinary
// maximum is the only ceiling decidable without observing organization policy.
fn federated_workload_lifetime_ceiling_refusal(mint: FederatedWorkloadMint) -> Optional<NonEmptyStr> {
  if token_lifetime_within_ordinary_maximum(s: mint.lifetime) {
    Absent
  } else {
    Present {
      value: concat(
        concat(concat("FederatedWorkloadLifetimeBeyondOrdinaryMaximum: ", mint.caller), " asked for "),
        concat(
          concat(token_lifetime_wire(s: mint.lifetime), " of credential, past the lifetime Google grants without the organization-policy constraint this runner cannot observe; nothing was exchanged"),
          "",
        ),
      )
    }
  }
}

// THE THREE LEGS, in order, with the ceiling first. Nothing that can fail before the mint may be moved
// below it, and nothing here writes the token anywhere but memory.
fn federated_workload_credential(
  mint: FederatedWorkloadMint
) -> FederatedWorkloadCredential uses net: Network, clk: std.resources.Clock {
  match federated_workload_lifetime_ceiling_refusal(mint: mint) {
    Present { value: reason } => FederatedWorkloadCredentialNotMinted { cause: reason }
    Absent => match env_value(name: github_actions_runtime.oidc_request_url_env) {
      Absent => FederatedWorkloadCredentialNotMinted {
        cause: concat(
          concat("FederatedWorkloadFederationMissing: ", mint.caller),
          " found ACTIONS_ID_TOKEN_REQUEST_URL unset, so the runner has no sidecar to mint the assertion the federation starts from",
        )
      }
      Present { value: url } => match env_value(name: github_actions_runtime.oidc_request_token_env) {
        Absent => FederatedWorkloadCredentialNotMinted {
          cause: concat(
            concat("FederatedWorkloadFederationMissing: ", mint.caller),
            " found ACTIONS_ID_TOKEN_REQUEST_TOKEN unset, so the sidecar at that URL cannot be authenticated to",
          )
        }
        Present { value: request_token } => match github.OIDC.GetToken(
            audience: mint.assertion_audience,
            request_url: url,
            request_token: request_token as Secret,
          ) {
          RestRefused { refusal } => FederatedWorkloadCredentialNotMinted {
            cause: concat(
              concat("FederatedWorkloadAssertionRefused: ", mint.caller),
              concat("'s runner sidecar refused the assertion: ", rest_refusal_text(o: refusal)),
            )
          }
          RestAnswered { answer } =>
            // The omitted-fields leg is deliberate and verified: #16185 named subject_token_type /
            // requested_token_type explicitly because field defaults used to resolve in the CALLER's scope;
            // #16196 moved those defaults to the declaring module, so the `= Jwt` / `= RequestAccessToken`
            // defaults in extdeps.cloud.gcp.sts now bind here, and the omitted-fields and explicit-fields
            // Exchange legs are byte-identical (same bound target and host input_digest).
            match gcp.STS.Exchange(
                subject_token: answer.subject_token,
                audience: mint.exchange_audience,
              ) {
              RestRefused { refusal } => FederatedWorkloadCredentialNotMinted {
                cause: concat(
                  concat("FederatedWorkloadFederationRefused: Cloud STS refused ", mint.caller),
                  concat("'s assertion: ", rest_refusal_text(o: refusal)),
                )
              }
              RestAnswered { answer: federated } => match acquire_impersonated_access(
                  source_token: federated.access_token,
                  target_service_account: mint.federation.service_account,
                  scopes: [mint.scope],
                  lifetime: token_lifetime_wire(s: mint.lifetime),
                ) {
                GcpImpersonatedAccessClockUnread { detail: d } =>
                  FederatedWorkloadCredentialNotMinted {
                    cause: concat(
                      concat("FederatedWorkloadAcquisitionClockUnread: ", mint.caller),
                      concat(" cannot date its own credential, so it cannot bound its use: ", d),
                    )
                  }
                GcpImpersonatedAccessRefused { refusal: refusal } =>
                  FederatedWorkloadCredentialNotMinted {
                    cause: concat(
                      concat("FederatedWorkloadImpersonationRefused: iamcredentials refused ", mint.caller),
                      concat("'s service account: ", rest_refusal_text(o: refusal)),
                    )
                  }
                GcpImpersonatedAccessAcquired { credential: issued } =>
                  FederatedWorkloadCredentialMinted { credential: issued }
              }
            }
          }
        }
    }
  }
}
