module gunbc.auth.approval_ntfy_deployment

import std.types { NonEmptyStr, String, Port }
import std.logic { Bool }
import std.human_intervention {
  HumanIntervention, HumanInterventionFrequency, FleetOnce, DeviceOnce, EveryProvision,
  BreakGlassOnly, ProvisioningHumanBurden, HumanInterventionIdentity,
  InterventionCompletionEvidence, NoDischargeSiteModeled,
}
import gunbc.auth.approval_notification { approval_ntfy_topic }
import extdeps.uri { Uri, Https }
import std.types { Secret }
import gunbc.executor_privileged_operation {
  ExecutorPrivilegedOperation, EnsureSystemAccount, executor_privileged_operation_converge_command,
}
import gunbc.fleet_posix_accounts { fleet_posix_nologin_shell_path }
import gunbc.managed_directory { DeclaredDirectoryMode, DirectoryOwnerAllGroupTraverse }
import extdeps.cloud.gcp.secret_ref { SecretRef, secret_ref_version_resource }
import gunbc.secret_provision { fleet_secret_ref, secret_ref_pin_version }

// ── The self-hosted notification server on srv1 ──────────────────────────────────────────────
// It follows gunbc-publication exactly: its own system account, its own state directory owned by
// that account, and a unit whose User= is that principal rather than the service user. That is not
// stylistic symmetry -- it is the only pattern in this deployment where a unit runs as something
// the dispatched sessions are not, and the approval loop needs precisely that property.
data approval_ntfy_principal_name: NonEmptyStr = "gunbc-ntfy"
data approval_ntfy_state_root: NonEmptyStr = "/var/lib/gunbc-ntfy"
// THE DIRECTORY IS THE AUTHORITY AND THE FILE PATH DERIVES FROM IT, not the other way round: a
// dirname would be a second computation over the same fact, and the converge roster needs the
// directory to ensure ownership on it.
data approval_ntfy_config_dir: NonEmptyStr = "/etc/gunbc-ntfy"

// THE MODE OF THE DIRECTORIES THIS DEPLOYMENT OWNS, DECLARED ONCE AND HERE. It sits with the
// deployment rather than with a converge because it is a fact about what this service needs, not
// about who is installing it -- and there are two installers. gunbc.auth.approval_ntfy_converge
// ensures the config directory for the server's config; gunbc.host_credential_custody_converge
// ensures THE SAME DIRECTORY for the publisher token that lives in it. Each previously named its
// own octal, so one directory had two authorities for its mode and two converges could flap it on
// every run; the arm is now stated once and both read it.
//
// GROUP-TRAVERSABLE IS THE REQUIREMENT, not a taste. The server runs as approval_ntfy_principal_name
// and must enter the directory to read a config it may never rewrite, and the publisher token
// beneath it is group-readable -- a group-readable file under a directory the group cannot enter is
// unreadable, which is the refusal the custody admission gate exists to raise.
data approval_ntfy_dir_mode: DeclaredDirectoryMode = DirectoryOwnerAllGroupTraverse
data approval_ntfy_config_file_name: NonEmptyStr = "server.yml"
data approval_ntfy_config_path: NonEmptyStr = join([approval_ntfy_config_dir as String, "/", approval_ntfy_config_file_name as String], "") as NonEmptyStr
// The server's auth database, under its state root. Declared so the config's auth-file is checked
// against it and so the one elevated stat of it is an exact sudoers argv rather than a pattern.
//
// IT STAYS A DECLARATION, NOT A VALUE READ FROM THE CONFIG, because both of its consumers need a path
// fixed before the read. The stat runs through `sudo -n` at an exact argv that an operator-installed
// sudoers line must name, and a path taken from the config at runtime could only be covered by a
// pattern grant. The readback then refuses unless the running config names exactly this path, so the
// config is checked rather than trusted.
//
// THE FILE NAME WAS A GUESS, AND srv1 FALSIFIED IT. It read `user.db`. The server srv1 runs was
// installed with `auth-file: /var/lib/gunbc-ntfy/auth.db` in /etc/gunbc-ntfy/server.yml, and that file
// exists while user.db does not. proud-deer-538 read this on 2026-09-29 running
// issue_device_enrolment_code by hand against release 02568b3046, and the readback refused before
// minting. The name is now the observed one, and it changes the exact stat argv that this module's
// human step asks the operator to grant.
//
// THAT GRANT DOES NOT EXIST ON srv1 TODAY, and the stat still runs. proud-deer-538 read srv1 on
// 2026-09-29: sudoers.d holds only the broker-helpers grant, and the stat of auth.db succeeds under
// the operator account's own broader sudo. The narrow, exact-argv grant this module asks for is
// therefore an unmet posture, not a failing read. The earlier refusal was the missing user.db, not a
// missing grant. Nothing installs this server or that grant from the model yet
// (gunbc.auth.approval_ntfy_converge names the server as outside its roster). This row becomes that
// installer's destination when one exists, and the grant becomes its sudoers member.
data approval_ntfy_auth_file_path: NonEmptyStr = join([approval_ntfy_state_root as String, "/auth.db"], "") as NonEmptyStr
data approval_ntfy_unit_name: NonEmptyStr = "gunbc-ntfy.service"

// THE TWO ntfy USERS THE ACCESS LIST MAY NAME, declared so the ACL readback
// (gunbc.auth.approval_ntfy_access_readback) can compare against them and so the mint and grant
// interventions below say which names to create. The publisher is the broker's credential and may
// only WRITE the topic; the operator is the phone's sign-in and may only READ it. A server whose
// users carry other names reads back as a deviation and enrolment-code issuance refuses -- loudly,
// never by guessing which user is which.
//
// THE NAMES ARE THE ONES srv1's SERVER CARRIES, AND THE PREVIOUS ONES WERE NEVER CREATED. They read
// gunbc-approval-publisher and gunbc-approval-operator, names chosen here that no step on the host
// used. The live `ntfy access` that proud-deer-538 read on srv1 on 2026-09-29, running
// issue_device_enrolment_code by hand, lists publisher `gunbc-broker` (write-only on the topic) and
// operator `briansrls` (read-only), with anonymous access denied. Those accounts already carry the
// broker's publisher token and the operator's phone subscription, so the declaration follows them
// rather than asking for both credentials to be minted again. These stay declarations: the readback
// compares the live list against them and refuses any other shape. Nothing creates these users from
// the model yet. The ntfy installation vertical owns that, and these rows become its contract.
data approval_ntfy_publisher_user: NonEmptyStr = "gunbc-broker"
data approval_ntfy_operator_user: NonEmptyStr = "briansrls"
// THE SERVER BINARY THE HOST ACTUALLY RUNS. Absolute because it runs under sudo as the server's
// principal; an absent binary is a failed readback, which refuses. The readback compares the running
// process's executable against THIS row, and that comparison is only a check because the row is not
// read from the host it checks: deriving it from the unit's ExecStart would admit a swapped unit.
//
// THE PREVIOUS VALUE WAS A BET ABOUT THE PACKAGING, and the host falsified it. It read "/usr/bin/ntfy"
// on the ground that the upstream .deb installs there. But no model member installs this binary
// (gunbc.auth.approval_ntfy_converge names it as outside its roster), and srv1's server was installed
// 2026-09-07 at /usr/local/bin/ntfy. gunbc-ntfy.service ExecStart names that path, as read on the host
// by proud-deer-538 on 2026-09-28 while running issue_device_enrolment_code by hand. The readback then
// refused before minting by stat-ing a path the server does not run. So the row is the observed install,
// and it stays a declaration: an install moved elsewhere refuses loudly here until the row moves with
// it, which is the intended wall. Its dissolution is an installer member that places the binary, at
// which point this row is that member's destination rather than a transcription of the host.
data approval_ntfy_binary_path: NonEmptyStr = "/usr/local/bin/ntfy"

// LOOPBACK, AND THAT IS THE SECURITY BOUNDARY RATHER THAN A DEFAULT. The server binds 127.0.0.1
// and reaches the tailnet only through tailscale serve, which is what makes the tailnet identity
// on an approval request meaningful: a header injected by the proxy is trustworthy exactly
// insofar as the proxy is the only route in. A server listening on 0.0.0.0 would let anything on
// the host reach the topic directly and forge that header on the neighbouring approval route.
data approval_ntfy_listen_address: NonEmptyStr = "127.0.0.1"
data approval_ntfy_listen_port: Port = 2586


// THE UPSTREAM RELAY, AND WHAT IT COSTS. An iPhone is woken by APNs and only Apple can send an
// APNs push, so a self-hosted server forwards a poll request upstream and the app fetches the body
// from us. The upstream sees a hashed topic and a message id -- never the topic name, the body, or
// the approval URL -- so the credential stays on the tailnet and the residual disclosure is
// timing. gunbc.auth.approval_notification carries that argument in full.
data approval_ntfy_upstream_base_url: NonEmptyStr = "https://ntfy.sh"

// ── The acquisition facts this install owes ─────────────────────────────────────────────────
// merry-ibex-741 (2026-09-07) asked that the acquisition facts be recorded at install time rather
// than re-derived later from a host already changed, because they are the fields a modeled
// EnsureDependency row will carry. They are NOT declared here yet, and their absence is the honest
// state: no release tag has been chosen and no artifact has been fetched or hashed, so a version
// row would be a guess and a digest row would read as verification that never happened.
//
// What the hand install owes, before it counts as complete: the exact release tag, the artifact
// URL for srv1's architecture, and the sha256 of the bytes actually installed -- added here as
// data rows, at which point they become the transcription an EnsureDependency row copies. Source:
// github.com/binwiederhier/ntfy/releases.

// ── What a person has to do, typed rather than written in a commit message ───────────────────
// Every step below is one a machine in this repository cannot take, and each says so for a
// different reason. They are HumanIntervention rows so they are countable, priced by frequency,
// and visible to anything that asks what this deployment costs a person -- rather than prose in a
// PR body that the next reader has to find.
//
// completion_evidence is NoDischargeSiteModeled on all of them, honestly: this repository has no
// per-intervention discharge carrier yet, and filling the field with a nearby declaration would be
// a placeholder wearing the shape of evidence. std.human_intervention makes that arm explicit for
// exactly this reason.
fn approval_ntfy_intervention(
  identity: NonEmptyStr,
  frequency: HumanInterventionFrequency,
  subject: NonEmptyStr,
  instruction: NonEmptyStr,
) -> HumanIntervention {
  HumanIntervention {
    identity: identity as HumanInterventionIdentity,
    frequency: frequency,
    subject: subject,
    instruction: instruction,
    completion_evidence: NoDischargeSiteModeled,
  }
}

// DECLARING A PRINCIPAL IS NOT CREATING AN ACCOUNT, and conflating the two is how a runbook comes
// to be missing the step that actually blocks. gunbc.fleet_posix_accounts now carries
// FleetAccountNotificationService -- its login policy, its empty sudo grant set, and its persistent
// realization standing -- which fixes WHAT the principal is. But the useradd that MAKES it on srv1
// is rendered today only by the live_deploy member that creates gunbc-publication, and no member
// renders one for this principal yet. So the account is a human step for now, and it says so.
//
// THE MEMBER NOW EXISTS; THE READBACK DOES NOT. gunbc.auth.approval_ntfy_converge
// NtfyServiceAccount renders EnsureSystemAccount for this principal, so the earlier wording here --
// "no converged member renders it for this principal yet" -- became false the moment that family
// landed, and two answers to "is the account modeled for convergence" is a §3 meaning fork inside
// one change.
//
// What keeps this a human step is narrower and worth stating exactly: nothing OBSERVES the host, so
// applying the member cannot establish that the account exists afterwards. An operation exiting
// zero over an absent account is indistinguishable from success.
//
// dissolve-on, as a CAPABILITY rather than an artifact (§4b(3)): this row retires when a
// convergence both applies this member AND establishes by post-apply readback that the principal
// is present -- the ConvergedEffect half of std.realization_reconcile. A member that emits the
// argv, which now exists, is explicitly NOT sufficient.
// THE ARGV IS RENDERED, NOT TRANSCRIBED, AND IT IS THE SAME RENDERER THE CONVERGED MEMBER USES.
// An earlier revision called executor_privileged_operation_shell_command here while
// gunbc.auth.approval_ntfy_converge called executor_privileged_operation_converge_command, so this
// annotation's claim that the two were "one authority by construction" was FALSE: the hand-run
// form lacked the `id -u ... ||` precondition and would exit 9 on a host that already had the
// account. Both now call the converge renderer, which is what makes the claim true rather than
// aspirational.
fn approval_ntfy_account_operation() -> ExecutorPrivilegedOperation {
  EnsureSystemAccount {
    login: approval_ntfy_principal_name,
    shell: fleet_posix_nologin_shell_path,
  }
}

fn approval_ntfy_account_command() -> String {
  executor_privileged_operation_converge_command(op: approval_ntfy_account_operation())
}

fn approval_ntfy_account_intervention() -> HumanIntervention {
  approval_ntfy_intervention(
    identity: "approval-ntfy-account",
    frequency: FleetOnce,
    subject: "gunbc-ntfy system account",
    instruction: join([
      "On srv1, run: ",
      approval_ntfy_account_command(),
      " -- this is the SAME command gunbc.auth.approval_ntfy_converge NtfyServiceAccount renders,",
      " from the same authority, so it cannot go stale against the declared login or shell and it",
      " carries the precondition that makes re-running it a no-op. The member exists; what does not",
      " exist is any observation of the host, so applying it cannot establish that the account is",
      " present afterwards. TEMPORARY: retires when a convergence both applies this member and",
      " confirms the principal by post-apply readback -- never merely because the member renders.",
    ], "") as NonEmptyStr,
  )
}

// THE SERVER BINARY ITSELF IS ALSO A HUMAN STEP TODAY, for a different and more durable reason:
// this repository models the ntfy PROTOCOL surface (extdeps.ntfy.ntfy) and the deployment's shape,
// but it does not package third-party binaries. gunbc.package_delivery is where that would land.
// THE INSTRUCTION IS DERIVED FROM THE DECLARED VALUES, not written beside them. An earlier
// revision spelled the port, the state root and the config path as English inside this string
// while declaring them as data three screens up -- one fact in two places, where only the prose is
// what a person actually follows, so a drift in the declarations would be invisible (DESIGN 3, and
// 3c: those declarations had no consumer at all). Joining them here makes the declarations
// load-bearing: the operator reads values the model owns, and a witness can check the two agree.
fn approval_ntfy_endpoint() -> String {
  join([approval_ntfy_listen_address as String, ":", to_string(approval_ntfy_listen_port)], "")
}

fn approval_ntfy_server_install_intervention() -> HumanIntervention {
  approval_ntfy_intervention(
    identity: "approval-ntfy-server-install",
    frequency: FleetOnce,
    subject: "ntfy server binary and unit on srv1",
    instruction: join([
      "Install the ntfy server on srv1 and run it as ",
      approval_ntfy_principal_name as String,
      " under a systemd unit named ",
      approval_ntfy_unit_name as String,
      ", configured at ",
      approval_ntfy_config_path as String,
      " with listen-http set to ",
      approval_ntfy_endpoint(),
      ", base-url set to srv1's tailnet name, cache-file and attachment-cache-dir under ",
      approval_ntfy_state_root as String,
      ", auth-default-access set to deny, and upstream-base-url set to ",
      approval_ntfy_upstream_base_url as String,
      " so iOS push works. The loopback bind is load-bearing rather than conventional: it is what",
      " makes tailscale serve the sole route in, and the sole route is what makes the identity",
      " header on the approval route trustworthy -- a 0.0.0.0 bind would let anything on the host",
      " reach the backend directly and assert whatever identity it liked.",
      " TEMPORARY, AND IT IS TWO CAPABILITIES RATHER THAN ONE: this row retires only when",
      " convergence acquires the verified ntfy binary (a modeled EnsureDependency carrying this",
      " version and digest) AND converges the unit that runs it, each confirmed by post-apply",
      " readback -- the binary alone leaves a host that looks provisioned and serves nothing.",
    ], "") as NonEmptyStr,
  )
}

// THE PUBLISHER TOKEN'S HOME IS SECRET MANAGER, AND DELIVERY IS NOT A HUMAN STEP. It reaches srv1
// through gunbc.host_credential_custody_converge ApprovalNtfyPublisherToken -- root:gunbc-ntfy 0640
// in a root:gunbc-ntfy 0750 directory, read back -- so the earlier row that had an operator write
// the token where the unit could read it is DELETED, not narrowed beside the custody row.
//
// `latest`, NOT A PIN, and deliberately unlike the approval MAC keys: a pin protects signatures in
// flight from a rotation, and a publisher token signs nothing -- a rotation re-delivered by the
// custody mode is the whole remedy.
data approval_ntfy_publisher_token_secret_ref: SecretRef = secret_ref_pin_version(
  ref: fleet_secret_ref(secret_id: "approval-ntfy-publisher-token"),
  version: "latest",
)

// WHAT STAYS HUMAN IS THE MINT, and it is a different fact from delivery. ntfy issues the token to a
// user that must first exist on the server, and the token must not be minted by anything the
// requester can read; so a person creates the user, issues the token, and adds it as a version of
// the secret above. Delivery then runs from the model.
fn approval_ntfy_publisher_token_mint_intervention() -> HumanIntervention {
  approval_ntfy_intervention(
    identity: "approval-ntfy-publisher-token-mint",
    frequency: FleetOnce,
    subject: "gunbc-ntfy publisher credential, minted into Secret Manager",
    instruction: join([
      "On srv1, create the ntfy user '",
      approval_ntfy_publisher_user as String,
      "' the broker publishes as and issue its access token; add the",
      " token as a new version of ",
      secret_ref_version_resource(ref: approval_ntfy_publisher_token_secret_ref),
      " and nowhere else -- not committed, not in the unit's Environment=, not on any argv",
      " (gunbc.credential_argv_exposure). Delivery to srv1 is NOT part of this step: dispatch",
      " fleet-converge mode host_credential_custody_converge with credential",
      " approval_ntfy_publisher_token on srv1, after the accessor row in",
      " gunbc.auth.fleet_secret_accessor_roster has been ensured. A machine cannot mint because the",
      " token does not exist until a person creates it on the server.",
    ], "") as NonEmptyStr,
  )
}

fn approval_ntfy_subscriber_grant_intervention() -> HumanIntervention {
  approval_ntfy_intervention(
    identity: "approval-ntfy-subscriber-grant",
    frequency: FleetOnce,
    subject: "gunbc-ntfy topic access policy",
    instruction: join([
      "Set the server's default access to deny, grant write-only on topic '",
      approval_ntfy_topic as String,
      "' to '",
      approval_ntfy_publisher_user as String,
      "' and read-only ONLY to the operator's ntfy user '",
      approval_ntfy_operator_user as String,
      "', and create no other users. Enrolment-code issuance reads this list back with `ntfy access`",
      " and refuses on any other shape (gunbc.auth.approval_ntfy_access_readback), so this step is",
      " checked rather than trusted. Six of its reads (four distinct argv) run as '",
      approval_ntfy_principal_name as String,
      "' and one as root, each via `sudo -n` at an exact argv (gunbc.auth.approval_ntfy_access_readback",
      " approval_ntfy_read_command: stat identity and cat of the config, stat identity of the auth file,",
      " ntfy access under /usr/bin/env -i; and tailscale serve status --json), so the broker's POSIX",
      " user needs one sudoers line for each of those five argv and nothing else; without them every",
      " issuance refuses. The listing is then bound to the running process itself by the per-release",
      " runtime-observation helper (gunbc.auth.approval_ntfy_runtime_observe), which the broker",
      " release install places under root and grants the verb's account to run as '",
      approval_ntfy_principal_name as String,
      "' by one further exact sudoers line (gunbc.live_deploy.emit approval_broker_helper_sudoers_line);",
      " without that release installed and granted, every issuance refuses. The server must run as",
      " the unit's main process: `",
      approval_ntfy_binary_path as String,
      " serve --config ",
      approval_ntfy_config_path as String,
      "` with auth-file ",
      approval_ntfy_auth_file_path as String,
      ", no NTFY_* variable and no EnvironmentFile in its unit or the manager's environment, no",
      " auth-access-cache, the config and the auth file each a REGULAR file at its declared path (not a",
      " symlink), its config written and its auth file created before it starts (restart it",
      " once after first creating the auth file), and no tailscale Funnel on the node. ntfy's documented default is read-write, so a topic",
      " left at the default is publishable and readable by anyone who learns its name -- and the",
      " approval URL is a credential, so a readable topic is a spendable approval. Publisher",
      " authentication alone does not close this: it protects who may SEND, and the leak is on the",
      " READ side.",
    ], "") as NonEmptyStr,
  )
}

fn approval_ntfy_phone_subscription_intervention() -> HumanIntervention {
  approval_ntfy_intervention(
    identity: "approval-ntfy-phone-subscription",
    frequency: DeviceOnce,
    subject: "operator iPhone ntfy subscription",
    instruction: join([
      "Install the ntfy iOS app, add the self-hosted server as a custom server, sign in as the",
      " operator user, and subscribe to topic '",
      approval_ntfy_topic as String,
      "'. Subscribing to any other topic receives nothing, silently -- which is why the topic is",
      " joined from its declaration here rather than spelled in prose. Tailscale must be up on the",
      " phone: the app fetches each message body from srv1 over the tailnet, and the approval link",
      " opens there too. DeviceOnce rather than FleetOnce because a replacement phone pays it again.",
    ], "") as NonEmptyStr,
  )
}

// BREAK-GLASS IS NOT A ROUTINE STEP, and std.human_intervention deliberately keeps it out of the
// routine burden comparison: an emergency path is not cheaper for being rare, and pricing it as
// routine would let a design buy a better score by moving work into it.
fn approval_ntfy_relay_withdrawal_intervention() -> HumanIntervention {
  approval_ntfy_intervention(
    identity: "approval-ntfy-relay-withdrawal",
    frequency: BreakGlassOnly,
    subject: "upstream APNs relay",
    instruction: "If the upstream relay must stop being trusted with even the timing of approval requests, remove upstream-base-url from the server config and converge. iOS push stops working: notifications then arrive only while the app is foregrounded, so the operator must be told, and the durable pending request becomes the only reliable route to a decision. This is a deliberate loss of delivery, not a configuration tweak.",
  )
}

fn approval_ntfy_human_burden() -> ProvisioningHumanBurden {
  ProvisioningHumanBurden {
    interventions: [
      approval_ntfy_account_intervention(),
      approval_ntfy_server_install_intervention(),
      approval_ntfy_publisher_token_mint_intervention(),
      approval_ntfy_subscriber_grant_intervention(),
      approval_ntfy_phone_subscription_intervention(),
      approval_ntfy_relay_withdrawal_intervention(),
    ],
  }
}
