module gunbc.auth.approval_device_enrolment_code_issue

import std.types { NonEmptyStr, String, List, Bool, CommitSha }
import std.algebra { trim }
import std.process { ProcessExit, ExitSuccess, ExitFailure, exit_failure }
import std.resources { Network }
import gunbc.cli_wire { CliWireResponse, CliWirePrintable, CliWireUnprintable }
import extdeps.sudo.elevation { sudo_elevate }
import extdeps.systemd.systemd_run { SystemdRunProperty, systemd_run_system_scope_argv }
import extdeps.tools.util_linux_setpriv { setpriv_reuid_regid_argv }
import extdeps.systemd { MemoryMax, MemoryHigh }
import std.measure { byte_size_count }
import gunbc.live_deploy.slice_bounds { approval_broker_slice_memory_max, approval_broker_slice_memory_high }
import extdeps.tools.env { env_prefixed_argv }
import v2.std.orchestration { EnvSet }
import gunbc.cli_run_workspace_root_scaffold { gunbc_workspace_root_env_name }
import gunbc.fleet_host_identity { operator_host_srv1 }
import gunbc.actions_run_binding {
  actions_variable_read, ActionsVariablePresent, ActionsVariableAbsent, fleet_converge_expected_host_env_name,
  read_expected_revision, ExpectedRevisionPresent, ExpectedRevisionAbsent,
}
import gunbc.fleet_bootstrap_principal { executor_bootstrap_principal }
import gunbc.fleet_posix_accounts { fleet_posix_operator_user }
import gunbc.fleet_reach_endpoint { fleet_probe_endpoint_for }
import gunbc.fleet_known_hosts_anchor { SshTarget, FleetSshExecutionContext }
import gunbc.fleet_ssh_locus { prepare_fleet_ssh_agent_context, FleetSshContextReady, FleetSshContextRefused }
import gunbc.typed_argv_exec { typed_argv_exec_over_fleet_ssh, TypedArgvExecConverged, TypedArgvExecRefused }
import gunbc.host_layout { srv1_gunbc_approval_broker_root }
import gunbc.live_deploy.release_locus {
  approval_broker_release_dir,
  approval_broker_release_binary_path,
  ReleaseRevisionBinding,
  RevisionBoundAtEmission,
  release_revision_execstart_text,
}

// ── THE OPERATOR'S CODE-ISSUING VERB, over the fleet SSH administrator edge ──────────────────
// A FleetConvergeWorkflowMode step (ApprovalDeviceEnrolmentCodeIssue) run on the host-pinned
// runner, exactly as gunbc.auth.approval_keyring_converge reaches srv1: the job prepares the fleet
// SSH context, connects to srv1 as the bootstrap principal, and elevates to the OPERATOR'S POSIX
// USER -- the owner of approval_device_store_root and a reader of the ntfy publisher token -- to
// run gunbc.auth.approval_device_enrolment_code issue_device_enrolment_code from the broker's admitted
// release tree. The remote verb writes the code's slot and delivers the code over the operator's
// ntfy topic. The verb itself refuses before minting unless its own live read on the host shows
// the channel private and bound to the running server (gunbc.auth.approval_ntfy_access_readback),
// so this step carries no second check beside it. What comes back over SSH, and what this step
// prints, is the delivery receipt
// only (decision msg_a1d8d1b9: the code never appears in a step log or a receipt artifact).
//
// THE RELEASE IS NAMED BY THE DISPATCH: expected_revision selects the broker release directory,
// so the verb runs the same sources the broker serves, and is passed to the verb as `revision`, which
// names the per-release observation helper its channel reading runs; a revision that is not installed is a
// missing binary and a loud remote failure, never a fallback to another tree.
data approval_device_enrolment_code_issue_attempt_raw: String = "approval-device-enrolment-code-issue-ci"

fn enrolment_code_issue_ssh_target() -> SshTarget {
  SshTarget {
    endpoint: fleet_probe_endpoint_for(host: operator_host_srv1 as String) as NonEmptyStr,
    principal: executor_bootstrap_principal.login,
  }
}

// The remote argv: as the operator's user, the release's own binary over the release's own tree,
// WITH THE RELEASE DIRECTORY AS ITS CHECKOUT ROOT. The seed resolves its workspace root before
// any verb runs, from gunbc.cli_run_workspace_root_scaffold gunbc_workspace_root_env_name when set
// and otherwise by walking up from the working directory. Over SSH the working directory is the login
// principal's home, which is no checkout, so the first run of this mode refused before minting
// (fleet-converge run 36415852659: "no workspace root: none of the current directory /home/ubuntu's
// ancestors is a git checkout"). Absolute --source-root paths did not help, because the root is
// resolved first. The release locus is not a checkout either. Every other process that execs a
// gunbc binary from a release locus receives that root at spawn from the same row
// (gunbc.live_deploy.emit release_locus_workspace_root_environment, for the broker's serve unit and
// the microVM slot unit), and this verb is one more such process. The binding rides inside the
// elevation through env(1), because sudo's env_reset would drop a variable set outside it.
// The elevated principal is the operator's POSIX user as modeled; /home/ubuntu in that refusal was
// the SSH login's working directory, which sudo keeps, not the account the verb ran as.
//
// AND IT RUNS IN A MEMORY-BOUNDED SCOPE, because the seed refuses to resolve without one. Its
// typed-module cache cap is derived from the cgroup's memory.high/memory.max, and with neither bound
// it refuses HostBudgetUnreadable rather than guessing (fleet-converge run 36556990543). An SSH
// session binds no such limit. The scope is a system-manager transient scope (extdeps.systemd.systemd_run
// systemd_run_system_scope_argv) around the account drop below. A user
// scope would need that account's session bus, which the elevated command lacks. The bounds are the
// broker's own slice rows (gunbc.live_deploy.slice_bounds approval_broker_slice_memory_max and _high).
// The verb resolves the broker's routes closure, the same program the broker boots, so the same
// measured demand bounds it. It gets its OWN scope rather than joining the broker's slice, because
// joining would split one budget between the running broker and this run and put the broker at risk.
fn enrolment_code_issue_scope_properties() -> List<SystemdRunProperty> {
  [
    SystemdRunProperty { property: MemoryMax, value: to_string(byte_size_count(b: approval_broker_slice_memory_max)) as NonEmptyStr },
    SystemdRunProperty { property: MemoryHigh, value: to_string(byte_size_count(b: approval_broker_slice_memory_high)) as NonEmptyStr },
  ]
}

// THE VERB RUNS AS THE OPERATOR'S ACCOUNT WITH THAT ACCOUNT'S OWN GROUP GRANTS. It reads the ntfy
// publisher token from a directory gated on the gunbc-ntfy group, so the drop must initialise the
// supplementary groups; systemd-run's own --uid/--gid did not, and every code was minted and then
// refused delivery (fleet-converge run 37098981121). The drop sits inside the scope so the bound
// still covers the whole verb.
fn enrolment_code_issue_remote_argv(revision: ReleaseRevisionBinding) -> List<String> {
  let root = srv1_gunbc_approval_broker_root as String
  let release_dir = approval_broker_release_dir(root: root, revision: revision)
  let account = fleet_posix_operator_user.name
  let verb = env_prefixed_argv(bindings: [
    EnvSet { name: gunbc_workspace_root_env_name, value: release_dir },
  ], command_argv: [
    approval_broker_release_binary_path(root: root, revision: revision),
    "run",
    "--source-root", release_dir + "/dag",
    "--source-root", release_dir + "/src/v2",
    "--entry", release_dir + "/dag/gunbc/auth/approval_device_enrolment_code.dag",
    "--function", "issue_device_enrolment_code",
    "--arg", "revision=" + release_revision_execstart_text(binding: revision),
  ])
  let as_account = setpriv_reuid_regid_argv(user: account, group: account, init_groups: true, command_argv: verb)
  let inv = sudo_elevate(command: systemd_run_system_scope_argv(properties: enrolment_code_issue_scope_properties(), command_argv: as_account))
  concat([inv.bin_path], inv.args)
}

fn enrolment_code_issue_refuses_off_srv1(host: String) -> ProcessExit {
  if host == (operator_host_srv1 as String) { ExitSuccess }
  else { exit_failure(reason: "approval device enrolment code: refuses host '" + host + "': the store lives on the machine that serves /approve, which is " + (operator_host_srv1 as String)) }
}

fn enrolment_code_issue_remote(revision: ReleaseRevisionBinding) -> CliWireResponse
  uses net: Network
{
  match prepare_fleet_ssh_agent_context(attempt_raw: approval_device_enrolment_code_issue_attempt_raw) {
    FleetSshContextRefused { cause: c } => CliWireUnprintable { cause: ("approval device enrolment code: " + c) as NonEmptyStr }
    FleetSshContextReady { context: context, receipt: _ } =>
      match typed_argv_exec_over_fleet_ssh(target: enrolment_code_issue_ssh_target(), context: context, argv: enrolment_code_issue_remote_argv(revision: revision)) {
        TypedArgvExecRefused { reason: why } => CliWireUnprintable { cause: ("approval device enrolment code: remote invocation refused: " + why) as NonEmptyStr }
        TypedArgvExecConverged { result: r } =>
          if r.success { CliWirePrintable { bytes: r.stdout, exit: ExitSuccess } }
          else { CliWireUnprintable { cause: ("approval device enrolment code: remote exit=" + to_string(r.exit_code) + " " + trim(s: r.stderr)) as NonEmptyStr } }
      }
  }
}

// THE STEP ENTRY: one host per run, named by the dispatch and required to be srv1; one release,
// named by the dispatch.
fn approval_device_enrolment_code_issue_wet() -> CliWireResponse
  uses net: Network
{
  match actions_variable_read(name: fleet_converge_expected_host_env_name) {
    ActionsVariableAbsent { variable: v, detail: d } => CliWireUnprintable { cause: ("approval device enrolment code: " + v + " " + d + "; one host per run, named by the dispatch") as NonEmptyStr }
    ActionsVariablePresent { value: host } =>
      match enrolment_code_issue_refuses_off_srv1(host: host) {
        ExitSuccess =>
          match read_expected_revision() {
            ExpectedRevisionAbsent { variable: v, detail: d } => CliWireUnprintable { cause: ("approval device enrolment code: " + v + " " + d + "; the release to run is named by the dispatch") as NonEmptyStr }
            ExpectedRevisionPresent { revision: rev } => enrolment_code_issue_remote(revision: RevisionBoundAtEmission { revision: rev as CommitSha })
          }
        ExitFailure { code: _, reason: why } => CliWireUnprintable { cause: why as NonEmptyStr }
      }
  }
}
