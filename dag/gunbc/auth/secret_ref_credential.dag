module gunbc.auth.secret_ref_credential

import std.resources { Network }
import std.types { Secret }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.cloud.gcp.gcp
import extdeps.cloud.gcp.secret_ref { SecretRef }
import extdeps.cloud.gcp.secret_manager
import extdeps.cloud.gcp.secret_manager { utf8_secret_from_access_payload }

data secret_ref_credential_authority: DeclarationRef = DeclarationRef {
  module_path: "gunbc.auth.secret_ref_credential",
  decl_name: "secret_ref_credential",
  field: WholeDeclaration
}

pattern secret_ref_credential(secret_ref: SecretRef) -> { credential: Secret }
  uses net: Network
{
  node auth: shell.GCloud.AuthPrintAccessToken()

  node access: gcp.SecretManager.AccessVersion(
    access_token: auth.access_token,
    project_id: secret_ref.project,
    secret: secret_ref.secret,
    version: secret_ref.version
  )

  return { credential: utf8_secret_from_access_payload(payload: access.payload) }
}

func fetch_secret_ref_credential(secret_ref: SecretRef) -> Secret
  uses net: Network
{
  auth = shell.GCloud.AuthPrintAccessToken()
  access = gcp.SecretManager.AccessVersion(
    access_token: auth.access_token,
    project_id: secret_ref.project,
    secret: secret_ref.secret,
    version: secret_ref.version
  )
  utf8_secret_from_access_payload(payload: access.payload)
}
