module gunbc.auth.secret_ref_credential

import std.resources { Network }
import std.types { NonEmptyStr, Secret, String }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.cloud.gcp.secret_ref {
  SecretRef,
  SecretRefVersionResolution,
  SecretRefVersionResolvedExact,
  SecretRefVersionResolvedAlias,
  SecretRefVersionResolutionRefused,
  resolve_returned_version,
}
import gunbc.auth.github_gcp_federation { fleet_secrets_project_number }
import extdeps.cloud.gcp.secret_manager
import extdeps.cloud.gcp.secret_manager {
  decode_sm_access_version_wire_response,
  SmAccessVersionWireDecoded,
  SmAccessVersionWireDecodeRefused,
  SmResolvedVersionIdentity,
  utf8_secret_from_access_payload,
}
import gunbc.auth.access_token_source {
  AccessEnsurePlan,
  AccessTokenSource,
  AccessTokenEnsureRefused,
  AccessTokenReady,
  AccessTokenUpsertRequired,
  ensure_access_token,
}

data secret_ref_credential_authority: DeclarationRef = DeclarationRef {
  module_path: "gunbc.auth.secret_ref_credential",
  decl_name: "fetch_secret_ref_credential",
  field: WholeDeclaration
}

// THE FETCH MUST PROVE THE ANSWER IS ABOUT WHAT IT ASKED, and until now it did not. It requested a
// version, decoded the returned identity, and handed the payload back while merely REPORTING that
// identity in resolved_version -- so a transport realization, provider surprise, or wiring defect
// that answered about version M to a request for version N would have delivered M's bytes as the
// printer credential, with the disagreement recorded rather than refused.
//
// THIS IS THE SAME REQUEST/RESPONSE AVERAGING CLASS closed in add_initial_version, arriving here on
// the AUTHENTICATION path, which is worse: the credential is spent before anything downstream can
// notice. Preserving the returned identity in a later receipt does not help, because authentication
// has already happened by then.
//
// THE JOIN IS ASKED OF ONE AUTHORITY AND ANSWERS WITH THE VERSION IT SERVED. resolve_returned_version
// lives beside the resource-name builder in extdeps.cloud.gcp.secret_ref: it proves the response
// names THIS project -- in either of the two fully qualified spellings the service answers in, since
// AccessVersion returns "projects/<number>/secrets/<id>/versions/<n>" for a request addressed by
// project ID -- and THIS secret, and only then decides about the version according to what the
// request actually selected. An exact request is refused on any other number. An alias request,
// which is what BOTH rows of the host credential custody roster name, is admitted only when the
// answer is a resolved upstream version number, and that number comes back in the resolution so the
// receipt -- resolved_version, which is now PROVEN rather than merely reported -- says which
// generation of the credential was spent. The number is not carried a second time beside that
// identity: a resolved name IS "projects/P/secrets/S/versions/V", and a receipt holding V twice is
// one that can disagree with itself.
//
// ASKING IT AS A PREDICATE IS WHAT SHIPPED THE DEFECT. The join used to be a Bool built from the
// REQUESTED version segment in both spellings, so an alias request compared a numeric answer
// against ".../versions/latest" and was false on every run -- there was nowhere for a correctly
// resolved alias to say what it resolved to, so a resolution and a mismatch were the same answer.
// Comparing project, secret and version as three separate fields here instead would be a second
// spelling of the resource name that drifts the moment either side learns a new segment, which is
// the duplication that authority exists to prevent.

// SecretCredentialResolvedVersionMismatch IS ITS OWN ARM BECAUSE IT IS ITS OWN FACT. "The response
// claimed a different version than the request named" is not "the wire did not decode": collapsing
// it into the decode refusal would report a parsing problem for a response that parsed perfectly
// and simply answered about something else, sending the reader to inspect an encoder that is fine.
type SecretCredentialFetch
  = SecretCredentialReady {
      credential: Secret
      resolved_version: SmResolvedVersionIdentity
    }
  | SecretCredentialAccessUpsertRequired { plan: AccessEnsurePlan }
  | SecretCredentialWireDecodeRefused {
      identity_cause: SmResolvedVersionIdentityRefusal?
      payload_cause: SmAccessVersionPayloadRefusal?
    }
  | SecretCredentialFetchRefused { reason: NonEmptyStr }
  | SecretCredentialResolvedVersionMismatch { requested: String, resolved: String }

// THE ENSURE AND THE READ ARE TWO STEPS, AND A CALLER THAT NEEDS THE TOKEN AFTERWARDS MAY HOLD IT.
// fetch_secret_ref_credential runs the access ensure and then throws the token away, which is right
// for a caller whose whole business is one read. A caller that reads a credential and then performs
// its OWN Secret Manager writes under the same identity -- the R2 mint reads the bootstrap token and
// then creates the custody container and adds its version -- had no way to say so, so it resolved a
// token itself and handed it in as OperatorSuppliedToken. That worked only because the token really
// was an operator's. Passing a workload-federated token through an arm spelled "operator" would be a
// meaning fork (§3): one spelling carrying two materially different identities, and the receipts
// would name the wrong one. So the read is exposed over an ALREADY-RESOLVED token, and the ensure
// stays in exactly one place -- the caller's -- rather than being run twice or lied about once.
fn fetch_secret_ref_credential_with_token(
  secret_ref: SecretRef,
  access_token: Secret,
) -> SecretCredentialFetch
  uses net: Network
{
  access = gcp.SecretManager.AccessVersion(
    access_token: access_token,
    project_id: secret_ref.project,
    secret: secret_ref.secret,
    version: secret_ref.version
  )
  match decode_sm_access_version_wire_response(
    name: access.name as String,
    data_b64: access.data_b64
  ) {
    SmAccessVersionWireDecoded { identity: identity, payload: payload } =>
      match resolve_returned_version(
        returned: identity,
        ref: secret_ref,
        project_number: fleet_secrets_project_number
      ) {
        SecretRefVersionResolutionRefused { requested: requested, returned: returned } =>
          SecretCredentialResolvedVersionMismatch { requested: requested, resolved: returned }
        SecretRefVersionResolvedExact { version: _ } =>
          SecretCredentialReady {
            credential: utf8_secret_from_access_payload(payload: payload),
            resolved_version: identity,
          }
        SecretRefVersionResolvedAlias { alias: _, version: _ } =>
          SecretCredentialReady {
            credential: utf8_secret_from_access_payload(payload: payload),
            resolved_version: identity,
          }
      }
    SmAccessVersionWireDecodeRefused { identity_cause: identity_cause, payload_cause: payload_cause } =>
      SecretCredentialWireDecodeRefused {
        identity_cause: identity_cause,
        payload_cause: payload_cause,
      }
  }
}

fn fetch_secret_ref_credential(
  secret_ref: SecretRef,
  token_source: AccessTokenSource,
) -> SecretCredentialFetch
  uses net: Network
{
  match ensure_access_token(source: token_source) {
    AccessTokenUpsertRequired { plan: plan } =>
      SecretCredentialAccessUpsertRequired { plan: plan }
    AccessTokenEnsureRefused { reason: reason } =>
      SecretCredentialFetchRefused { reason: reason }
    AccessTokenReady { token: token } =>
      fetch_secret_ref_credential_with_token(secret_ref: secret_ref, access_token: token)
  }
}
