module gunbc.auth.secret_ref_credential

import std.resources { Network }
import std.types { NonEmptyStr, Secret }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.cloud.gcp.secret_ref { SecretRef }
import extdeps.cloud.gcp.secret_manager
import extdeps.cloud.gcp.secret_manager {
  utf8_secret_from_access_payload,
}
import gunbc.auth.access_token_source {
  AccessEnsurePlan,
  AccessTokenSource,
  AccessTokenEnsureRefused,
  AccessTokenReady,
  AccessTokenUpsertRequired,
  ensure_access_token,
}

data secret_ref_credential_authority: DeclarationRef = DeclarationRef {
  module_path: "gunbc.auth.secret_ref_credential",
  decl_name: "fetch_secret_ref_credential",
  field: WholeDeclaration
}

type SecretCredentialFetch
  = SecretCredentialReady { credential: Secret }
  | SecretCredentialAccessUpsertRequired { plan: AccessEnsurePlan }
  | SecretCredentialFetchRefused { reason: NonEmptyStr }

func fetch_secret_ref_credential(
  secret_ref: SecretRef,
  token_source: AccessTokenSource,
) -> SecretCredentialFetch
  uses net: Network
{
  match ensure_access_token(source: token_source) {
    AccessTokenUpsertRequired { plan: plan } =>
      SecretCredentialAccessUpsertRequired { plan: plan }
    AccessTokenEnsureRefused { reason: reason } =>
      SecretCredentialFetchRefused { reason: reason }
    AccessTokenReady { token: token } => {
      access = gcp.SecretManager.AccessVersion(
        access_token: token,
        project_id: secret_ref.project,
        secret: secret_ref.secret,
        version: secret_ref.version
      )
      SecretCredentialReady {
        credential: utf8_secret_from_access_payload(payload: access.payload),
      }
    }
  }
}
