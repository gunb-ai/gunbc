module gunbc.auth.secret_ref_credential


data secret_ref_credential_authority: std.decl_ref.DeclarationRef = std.decl_ref.DeclarationRef {
  module_path: "gunbc.auth.secret_ref_credential",
  decl_name: "fetch_secret_ref_credential",
  field: std.decl_ref.WholeDeclaration
}

type SecretCredentialFetch
  = SecretCredentialReady {
      credential: Secret
      resolved_version: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity
    }
  | SecretCredentialAccessUpsertRequired { plan: gunbc.auth.access_token_source.AccessEnsurePlan }
  | SecretCredentialWireDecodeRefused {
      identity_cause: SmResolvedVersionIdentityRefusal?
      payload_cause: SmAccessVersionPayloadRefusal?
    }
  | SecretCredentialFetchRefused { reason: std.types.NonEmptyStr }

func fetch_secret_ref_credential(
  secret_ref: extdeps.cloud.gcp.secret_ref.SecretRef,
  token_source: gunbc.auth.access_token_source.AccessTokenSource,
) -> SecretCredentialFetch
  uses net: std.resources.Network
{
  match gunbc.auth.access_token_source.ensure_access_token(source: token_source) {
    gunbc.auth.access_token_source.AccessTokenUpsertRequired { plan: plan } =>
      SecretCredentialAccessUpsertRequired { plan: plan }
    gunbc.auth.access_token_source.AccessTokenEnsureRefused { reason: reason } =>
      SecretCredentialFetchRefused { reason: reason }
    gunbc.auth.access_token_source.AccessTokenReady { token: token } => {
      access = gcp.SecretManager.AccessVersion(
        access_token: token,
        project_id: secret_ref.project,
        secret: secret_ref.secret,
        version: secret_ref.version
      )
      match extdeps.cloud.gcp.secret_manager.decode_sm_access_version_wire_response(
        name: access.name as String,
        data_b64: access.data_b64
      ) {
        extdeps.cloud.gcp.secret_manager.SmAccessVersionWireDecoded { identity: identity, payload: payload } =>
          SecretCredentialReady {
            credential: extdeps.cloud.gcp.secret_manager.utf8_secret_from_access_payload(payload: payload),
            resolved_version: identity,
          }
        extdeps.cloud.gcp.secret_manager.SmAccessVersionWireDecodeRefused { identity_cause: identity_cause, payload_cause: payload_cause } =>
          SecretCredentialWireDecodeRefused {
            identity_cause: identity_cause,
            payload_cause: payload_cause,
          }
      }
    }
  }
}
