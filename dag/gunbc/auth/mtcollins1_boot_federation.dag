module gunbc.auth.mtcollins1_boot_federation

import std.types { Bool, List, Map, NonEmptyStr, String }
import v2.std.optional { Present }
import extdeps.cloud.gcp.gcp { ServiceAccountEmail, WifPool, WifProvider, wif_provider_resource, wif_pool_resource }
import extdeps.cloud.gcp.iam { IamCondition, role_secretmanager_secret_accessor }
import extdeps.cloud.gcp.secret_ref { SecretRef, gcp_version_resource_by_number }
import gunbc.auth.github_gcp_federation {
  fleet_secrets_project_id, fleet_secrets_project_number, github_wif_issuer_uri, federated_service_account_member,
}
import gunbc.auth.gcp_secret_access { SecretAccessGrant }
import gunbc.secret_provision { mtcollins1_bmc_gunbc_secret_ref }
import gunbc.fleet_ssh_access { fleet_automation_ssh_privkey_secret }
import gunbc.auth.oidc_claim_pins { OidcClaimPin, claim_pins_attribute_condition, claim_pins_admit, fleet_converge_job_claim_pins, fleet_converge_workflow_ref_at_main }

// ── THE MT. COLLINS BOOT'S OWN FEDERATION (operator ruling 2026-09-23) ─────────────────────────
//
// The boot is a recurring automated effect, so gunbc.auth.privileged_effect_census derives
// FederatedScopedGrant for it: the run's own workload identity, holding one cell per secret it
// reads, with no human per run. The grant must be scoped to THIS job -- this repository, the
// fleet-converge workflow file at main, a workflow_dispatch on refs/heads/main, the mtcollins1-boot
// job -- and never repo-wide.
//
// WHY NOT gunbc.auth.github_gcp_federation github_wif_provider (option B and C, refused). That pool's
// one provider admits every job in the repository (`assertion.repository == 'gunb-ai/gunbc'`), and a
// WIF principal is POOL-scoped: principal://.../workloadIdentityPools/<pool>/subject/<sub> names the
// same identity whichever provider in the pool minted it. So a binding scoped to the boot job's
// subject inside the repo pool is reachable by any other provider or claim path in that pool that
// can produce the subject, and a mapped attribute added to the shared provider would change the
// token exchange of every workflow in the repository. gunbc#10887 is the receipt: a heal job
// reached an App key through exactly that repo-wide path, which is why
// gunbc.auth.heal_publisher_federation has its own pool. This module inhabits that precedent rather
// than forking it: a DEDICATED POOL WITH ONE PROVIDER whose attribute condition is the whole
// membership rule, and one service account reachable only from that pool.
//
// THE JOB IS PINNED BY THE ENVIRONMENT CLAIM. OIDC tokens are minted per job and carry no job id;
// the one job-grain claim GitHub asserts is `environment`, present only for a job that declares one.
// The boot job declares mtcollins1-boot (gunbc.fleet_converge_workflow), so the condition pins it
// beside the workflow file, the ref and the event. The honest residue: any job in fleet-converge.yml
// AT MAIN that declared the same environment would also be admitted -- membership is a reviewed-main
// fact, which is the same trust the workflow file itself carries.
//
// THE RUNNER IS NOT PINNED, and that differs from the heal publisher on purpose: the boot must run on
// the srv1 self-hosted runner (the unit hold store and the BMC route are there), so
// `runner_environment == 'github-hosted'` would refuse the job this admits. What the heal publisher
// bought with that pin -- no pull-request code on the runner presents the identity -- is bought here
// by workflow_ref at main plus workflow_dispatch: a pull request cannot cause either.

data mtcollins1_boot_wif_pool_id: NonEmptyStr = "github-mtcollins1-boot"

// Under the 32-character ceiling createWorkloadIdentityPool enforces (measured on the heal pool).
data mtcollins1_boot_wif_pool_display_name: NonEmptyStr = "Mt. Collins boot (one job)"

data mtcollins1_boot_wif_provider_id: NonEmptyStr = "github-mtcollins1-boot-oidc"

data mtcollins1_boot_service_account_id: NonEmptyStr = "mtcollins1-boot"

data mtcollins1_boot_service_account: ServiceAccountEmail = "mtcollins1-boot@gunbai-secrets.iam.gserviceaccount.com"

data mtcollins1_boot_service_account_display_name: NonEmptyStr = "Mt. Collins boot (WIF-only, pinned versions, no keys)"

data mtcollins1_boot_environment: NonEmptyStr = "mtcollins1-boot"

fn mtcollins1_boot_workflow_ref() -> String {
  fleet_converge_workflow_ref_at_main()
}

// The pin list and both of its projections are gunbc.auth.oidc_claim_pins's.
fn mtcollins1_boot_claim_pins() -> List<OidcClaimPin> {
  fleet_converge_job_claim_pins(environment: mtcollins1_boot_environment)
}

fn mtcollins1_boot_wif_attribute_condition() -> String {
  claim_pins_attribute_condition(pins: mtcollins1_boot_claim_pins())
}

fn mtcollins1_boot_claims_admitted(claims: List<OidcClaimPin>) -> Bool {
  claim_pins_admit(pins: mtcollins1_boot_claim_pins(), claims: claims)
}

data mtcollins1_boot_wif_attribute_mapping: Map<String, String> = {
  "google.subject": "assertion.sub",
  "attribute.repository_id": "assertion.repository_id",
  "attribute.workflow_ref": "assertion.workflow_ref"
}

data mtcollins1_boot_wif_pool: WifPool = WifPool {
  name: mtcollins1_boot_wif_pool_id
  project: fleet_secrets_project_id as String
  display_name: Present { value: mtcollins1_boot_wif_pool_display_name }
  disabled: false
}

data mtcollins1_boot_wif_provider: WifProvider = WifProvider {
  name: mtcollins1_boot_wif_provider_id
  pool: mtcollins1_boot_wif_pool_id
  issuer_uri: github_wif_issuer_uri
  attribute_mapping: Present { value: mtcollins1_boot_wif_attribute_mapping }
  attribute_condition: Present { value: mtcollins1_boot_wif_attribute_condition() }
}

fn mtcollins1_boot_wif_provider_resource() -> String {
  wif_provider_resource(project_number: fleet_secrets_project_number, provider: mtcollins1_boot_wif_provider)
}

// Who may impersonate the service account: every identity in the dedicated pool, which is exactly
// the identities the one provider's condition admitted.
fn mtcollins1_boot_wif_principal_set() -> String {
  join([
    "principalSet://iam.googleapis.com/",
    wif_pool_resource(project_number: fleet_secrets_project_number, pool_id: mtcollins1_boot_wif_pool_id as String),
    "/*"
  ], "")
}

fn mtcollins1_boot_service_account_member() -> String {
  federated_service_account_member(email: mtcollins1_boot_service_account)
}

// ── THE CELLS: EXACTLY THE PINNED VERSIONS THE RUN READS ──────────────────────────────────────
// The BMC credential (the attach, boot-device, power and SOL all present it) and the fleet key (the
// census medium readback on srv2 runs over fleet ssh). The approval submission MAC key is NOT here:
// it existed in this run only to sign the approval filing, which the ruling removed. Each cell is
// conditioned on its one version resource, so a rotation to a new version is refused until the pin
// and the cell move together.
// THE LABELS ARE PARAMETERS because a second dedicated job (gunbc.auth.gcp_iam_converge) pins its own
// version the same way; the title prefix and description are the job's, the condition construction
// is one. They are parameters rather than derived from one job name because the boot's cells are
// PROVISIONED with the strings below, and a condition whose description changed is a different cell
// to reconcile_gcp_policy -- re-deriving them would add a duplicate binding on the next converge.
fn pinned_version_accessor_grant_for(title_prefix: String, description: String, target: SecretRef) -> SecretAccessGrant {
  let resource = gcp_version_resource_by_number(project_number: fleet_secrets_project_number, secret: target.secret, version: target.version)
  SecretAccessGrant {
    target: target,
    role: role_secretmanager_secret_accessor,
    condition: Present { value: IamCondition {
      title: join([title_prefix, " pinned ", target.secret as String, " v", target.version as String], ""),
      expression: join(["resource.name == \"", resource, "\""], ""),
      description: Present { value: description },
    } },
  }
}

fn pinned_version_accessor_grant(target: SecretRef) -> SecretAccessGrant {
  pinned_version_accessor_grant_for(
    title_prefix: "mtcollins1-boot",
    description: "gunbc.auth.mtcollins1_boot_federation: the one version the mtcollins1 boot job reads",
    target: target,
  )
}

fn mtcollins1_boot_secret_grants() -> List<SecretAccessGrant> {
  [
    pinned_version_accessor_grant(target: mtcollins1_bmc_gunbc_secret_ref),
    pinned_version_accessor_grant(target: fleet_automation_ssh_privkey_secret),
  ]
}
