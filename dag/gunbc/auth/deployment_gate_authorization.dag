// THE INSTANT COMES FROM THE CLOCK THE AUTHORITY ALREADY OWNS, not from a String a caller wrote.
// approval_instant_from_probe is its one canonical gate (a probe reading that is not canonical UTC, or
// is absent, yields nothing); reusing it here is what keeps this module from minting a second calendar
// rule to disagree with the first (§2).
import gunbc.auth.approval_gate { approval_instant_from_probe }
import gunbc.auth.authorization_pattern_selection {
  OperatorApprovedCapability,
  AuthorizationPattern,
  PatternSelected,
  PrivilegedEffect,
