  // here would be a second authority over a route the substrate owns: rename the route upstream and
  // the copy stays green while the broker's real address moves.
  human_review_endpoint_path,
  
  
  the_two_review_surfaces_are_distinguishable,
  // WHAT THE UPSTREAM DOES NOT PROMISE ABOUT COMPOSITION, consumed below rather than paraphrased.
  gate_composition_documented_guarantee,
  protection_rules_are_binding_guarantee,
  DocumentedGuarantee,
  GuaranteeDocumented,
  GuaranteeUndocumented,
  rule_delivery_citation,
  PendingDeploymentWait,
  pending_wait_environment_name,
  EnabledDeploymentProtectionRule,
  // THE RULE-ID CARRIER (review 83825, folded per warm-crane-219's split). rule_id is this type
  // everywhere in this module -- the receipt's, the observation's, the trial arms', and every refusal
  // payload that names a rule. Not Int: with Int, a run id (still Int, until its own migration) typed
  // into a rule-id slot COMPILED, and the mint then compared a run's digits against a rule's digits.
  // §5: make that unwritable, not validated.
  GitHubDeploymentProtectionRuleId,
  review_call_succeeded,
  custom_rule_response_timeout,
  rule_gate_approval_ceiling,
  wait_minutes_as_seconds,
  wait_timer_maximum,
  rule_delivery_documented_guarantee,
  review_endpoint_path_built_for,
  review_call,
  RoutePathBuildRefusal,
  BuiltRoutePath,
  BuiltRoutePathOk,
  BuiltRoutePathRefused,
  RoutePathSegment,
}
