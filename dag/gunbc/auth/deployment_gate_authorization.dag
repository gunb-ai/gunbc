module gunbc.auth.deployment_gate_authorization

// WHICH AUTHORIZATION PERFORMS THE PRIVILEGED EFFECT "answer a pending environment gate for a run",
// and everything that decision needs: which credential kind may make the review call, what the broker
// must confirm before it posts, and what must be witnessed before a human reviewer is removed.
//
// WHY THIS FILE EXISTS RATHER THAN THOSE ANSWERS SITTING IN extdeps.github.
// DESIGN.md §3 splits interface, realization and policy three ways, and §3b's External facts boundary
// puts product policy and this repository's own observations in the consuming layer. The upstream model
// says what GitHub ACCEPTS; a decision made here can change without editing a dependency model, and a
// reader of the upstream file is not told what our broker does. Concretely: GitHub accepts an operator
// OAuth/PAT call at this endpoint, and REFUSING it is our policy, not GitHub's — so the refusal is
// here and the accepted set is there.
//
// AND WHY NOTHING IN IT IS A TEST OR A FIXTURE. On main no dag/gunbc/auth module carries a `test fn`;
// the tests for this file live in test.claim.deployment_gate_authorization_witness, which is
// where fixtures belong. A production module that ships fixtures ships values someone can mistake for
// observations, and a typed prerequisite built from a fixture is the prose guard it replaced wearing a
// type. What is kept here are types, folds, and the one frontier row that says "not yet".
//
// WHAT THIS FILE DOES NOT DO. It grants nothing, touches no GitHub setting, and cannot be executed
// against GitHub. It is the model stage-2 code is written against.

import std.types {
  String,
  Int,
  List,
  Bool,
  NonEmptyStr,
  HttpStatus,
}
import std.measure {
  Second,
  second_count,
}
import std.optional {
  Present,
  Absent,
  Optional,
}
import std.scoped_authorization { AttemptIdentity }
import extdeps.github.deployment_protection_rule {
  ReviewCredential,
  InstallationAccessToken,
  OAuthClassicWithRepoScope,
  review_credential_is_documented,
  review_accepted_token_type,
  DeploymentProtectionRuleReview,
  ReviewState,
  Approved,
  Rejected,
  review_decision,
  review_releases_environment,
  review_documented_example_body,
  PendingDeploymentWait,
  pending_wait_environment_name,
  EnvironmentRuleOwnership,
  OwnedByGateApp,
  NotOwnedByGateApp,
  EnabledDeploymentProtectionRule,
  rule_ownership_from_readback,
  review_call_succeeded,
  custom_rule_response_timeout,
  custom_rule_timeout_run_conclusion,
  rule_gate_approval_ceiling,
  wait_minutes_as_seconds,
  wait_timer_maximum,
  rule_delivery_documented_guarantee,
}
import extdeps.github.app {
  GitHubPermissionAxis,
  GitHubAppPermission,
  ActionsAxis,
  DeploymentsAxis,
  ContentsAxis,
  AdministrationAxis,
  PullRequestsAxis,
  SecurityEventsAxis,
  WorkflowsAxis,
  IdTokenAxis,
  AppAccessRead,
  AppAccessWrite,
}
import extdeps.github.actions_runs {
  RunConclusion,
  RunFailure,
  RunSettlement,
  RunSettlementInFlight,
  RunSettled,
  WorkflowRunRecord,
  workflow_run_settlement,
}
import gunbc.auth.github_deployment_environment { srv1_production_environment_name }
import gunbc.auth.approval_capability {
  ApprovalCapability,
  ProposedDecision,
  ProposeApprove,
  ProposeDeny,
}
import gunbc.auth.authorization_pattern_selection {
  AuthorizationPattern,
  PatternSelected,
  PrivilegedEffect,
  ReversibleByReapply,
  ApiSurface,
  WorkloadIdentityUnbindable,
  MintsResourceScopedCredential,
  NoBillingConsequence,
  NoWitnessDischarge,
  select_authorization_pattern,
  pattern_label,
}
import std.human_intervention { FleetOnce }

// ---------------------------------------------------------------------------
// 1. THE EFFECT AND THE PATTERN THAT PERFORMS IT — a §3d decision
// ---------------------------------------------------------------------------

// THE EFFECT BEING AUTHORISED, in the vocabulary the selection authority consumes. Answering a pending
// gate releases srv1 root mutation, so it is a privileged effect and it goes through
// gunbc.auth.authorization_pattern_selection like every other one. There is deliberately NO row here
// asserting which pattern wins: the selector derives it from these fields, and a second representation
// of that answer (§5) is a row that can disagree with the authority it cites. Where a consumer needs
// the answer it asks for_answer_pending_gate(), and if the selection ever fails to produce one, that is
// a refusal rather than a fallback to a remembered answer.
data answer_pending_gate_effect: PrivilegedEffect = PrivilegedEffect {
  subject: "post a custom deployment protection rule review for a gated fleet-converge run",
  frequency: FleetOnce,
  reversibility: ReversibleByReapply,
  surface: ApiSurface,
  workload_identity: WorkloadIdentityUnbindable {
    cause: "the reviewer is a repository App installation, not a workload identity this repo federates into",
  },
  minted_reach: MintsResourceScopedCredential,
  billing: NoBillingConsequence,
  witness_discharge: NoWitnessDischarge,
}

// The pattern for this effect, READ from the selector. Absent means the selection authority declined
// to select one, and a declined selection must stop the broker — not be papered over by a row that
// asserts what the selector was expected to say.
fn for_answer_pending_gate() -> AuthorizationPattern? {
  match select_authorization_pattern(e: answer_pending_gate_effect) {
    PatternSelected { pattern: p, receipt: _ } => Present { value: p }
    _ => none
  }
}

// The capability-mediated pattern is the only one under which a review may be posted: a pattern that is
// not a redeemed human decision means nothing was tapped, and nothing tapped means nothing to post.
fn gate_pattern_redeems_a_human_decision() -> Bool {
  match for_answer_pending_gate() {
    Present { value: p } => (pattern_label(p: p) as String) == "operator-approved-capability"
    Absent => false
  }
}

// ---------------------------------------------------------------------------
// 2. THE CREDENTIAL — the refusal lives here, not in the upstream model
// ---------------------------------------------------------------------------

// THE REFUSAL. Upstream accepts two credential kinds at this endpoint (see
// extdeps.github.deployment_protection_rule.ReviewCredential); gunbc permits ONE. An installation
// access token is minted per installation, expires within an hour, and is scoped to what the App was
// granted — the resource-scoped, capability-mediated shape the selection scores highest, and the arm
// the REST reference itself lists first. The other arm is the operator's own credential sitting where a
// service can reach it: the second rejected alternative in the plan carrier, and the pattern the
// selection's hard constraints already exclude.
// THE REFUSAL AS A VALUE. `match credential { A => true, B => false }` threw away the one thing a
// caller has to be able to show: WHICH kind was refused, and that it was refused because it is a
// person's credential. The arm carries the kind, so a witness can require the refusal to name the
// operator-owned arm — a fold that refused the wrong arm would now go red instead of still returning
// false. Absent is the permitted arm; there is no Bool standing between the sum and its consumer.
type CredentialRefusal = OperatorOwnedCredential { kind: ReviewCredential }

fn gate_credential_refusal(credential: ReviewCredential) -> Optional<CredentialRefusal> {
  match credential {
    InstallationAccessToken => none
    OAuthClassicWithRepoScope => Present { value: OperatorOwnedCredential { kind: OAuthClassicWithRepoScope } }
  }
}

// The permitted arm is a documented one, so the policy cannot drift into inventing a credential kind
// GitHub does not accept.
fn gate_credential_is_documented() -> Bool {
  review_credential_is_documented(token_type: review_accepted_token_type)
}

// ---------------------------------------------------------------------------
// 3. WHAT THE GATE APP MAY HOLD — our limit on a credential GitHub would grant more of
// ---------------------------------------------------------------------------

// Axes an operator must NOT grant this App. GitHub will grant any of them; the upstream model
// enumerates the axes, and holding this list is our position on least privilege for the identity that
// releases the srv1 root boundary. Compared by AXIS VALUE, so widening a description cannot help:
// IdToken in particular would let the reviewer identity federate into a cloud role, which is the WIF
// boundary this whole feature is supposed to stay behind.
data rule_app_forbidden_axes: List<GitHubPermissionAxis> = [
  ContentsAxis,
  AdministrationAxis,
  PullRequestsAxis,
  SecurityEventsAxis,
  WorkflowsAxis,
  IdTokenAxis,
]

// WHAT OUR REVIEWER IDENTITY IS ALLOWED TO HOLD. Upstream states only a MINIMUM for one endpoint
// (extdeps.github.deployment_protection_rule.review_required_permission: Deployments, write) — that is
// a property of GitHub's API. WHICH axes the gate App is granted is our decision about a credential of
// ours, which is why this row sits here and not beside the endpoint model: changing our grant must never
// require editing a model of GitHub. Actions is read because the broker has to read the run's own record
// to answer a gate; nothing else is asked for, and every other axis is refused by name below rather than
// merely absent.
data gate_app_permissions: List<GitHubAppPermission> = [
  GitHubAppPermission { name: ActionsAxis, access: AppAccessRead },
  GitHubAppPermission { name: DeploymentsAxis, access: AppAccessWrite },
]

// ONE MEANING PER NAME (§3, meaning fork). This used to be two functions with ONE name in two modules,
// answering differently: the extdeps copy asked "are both documented axes present", this one also
// required "and nothing else". A caller could not tell from the name which contract it got. The extdeps
// copy is deleted, and the surviving pair says in its name what it asks — `..._is_admissible` asks only
// that no axis is forbidden; `..._is_exact` additionally requires both documented rows and no third.
fn gate_app_axis_is_not_forbidden(permission: GitHubAppPermission) -> Bool {
  !(rule_app_forbidden_axes |> any(a => a == permission.name))
}

fn gate_app_permission_set_is_admissible() -> Bool {
  gate_app_permissions |> all(p => gate_app_axis_is_not_forbidden(permission: p))
}

fn gate_app_permission_set_is_exact() -> Bool {
  (gate_app_permissions |> count) == 2
    && (gate_app_permissions |> any(p => p.name == ActionsAxis && p.access == AppAccessRead))
    && (gate_app_permissions
        |> any(p => p.name == DeploymentsAxis && p.access == AppAccessWrite))
}

// ---------------------------------------------------------------------------
// 4. THE ROUTE, AND THE OPEN QUESTION THE ROUTE RESTS ON
// ---------------------------------------------------------------------------

// THE UPSTREAM SAYS NOTHING, and that silence is the fact the upstream model is allowed to state
// (extdeps.github.deployment_protection_rule.rule_delivery_documented_guarantee). Everything below is
// OUR position on that silence: an inference, the observation that would settle it, and the route
// selected while it is open. All three are receipts and policy, so all three live here.
//
// THE INFERENCE, TYPED AS AN INFERENCE (DESIGN §4d): GitHub accepts an App's review for a run whose
// deployment_protection_rule webhook the App never received. It is not documented either way, so it is
// carried with the read that would settle it — never as a fact.
type DeliveryIndependenceStanding
  = StandingUntested { read_obligation: NonEmptyStr }
  | StandingConfirmed { witnessed_run_id: Int }
  | StandingRefuted { refused_because: NonEmptyStr }

data rule_delivery_independence: DeliveryIndependenceStanding = StandingUntested {
  read_obligation: "Enable the gate App's rule on a non-privileged environment with no reachable receiver, trigger one gated dispatch, and POST the review. Accepted => StandingConfirmed with that run id; refused => StandingRefuted, and the webhook relay route becomes the selection.",
}

// NO UNPROVEN/PROVEN FOLD. Three arms, three different things to do with: an untested standing carries
// a read obligation someone owes, a confirmed one carries the run id that settled it, a refuted one
// carries the reason the relay becomes the route. A Bool would flatten all three into "false" and
// discard the receipt, so callers match the sum — which is also the only honest way to consume a
// standing, since the branch you take depends on which receipt you hold.

// THE ROUTE, as a closed sum that the standing above decides between — not a string compared to
// itself. The broker is tailnet-only, so a public GitHub webhook would be a NEW INBOUND EXPOSURE;
// the no-webhook route adds none and is selected while the standing is untested. The relay arm is the
// fallback if the trial refutes the inference, and it is the arm that has to be built honestly rather
// than bolted onto a broker that was designed never to be addressed.
type GateDiscoveryRoute
  = NoWebhookPollAndSubmit
  | WebhookRelayFallback { relay_ingress: NonEmptyStr }

// NO ADDS-NO-INBOUND FOLD, for the same reason: the relay arm carries the ingress it opens, and a
// predicate that returns false throws that away. Callers match, and the relay arm's own field is what
// has to be reviewed when it is selected.

// THE SELECTED ROUTE, derived from the standing rather than asserted beside it: untested or confirmed
// keeps the no-webhook route, refuted selects the relay. A route that could not be re-derived from the
// evidence is a route nobody can explain after the fact.
// THE MAPPING, EXPOSED AS A FUNCTION OF THE STANDING so a witness can walk every arm of it. If only
// the selected route were reachable, a test of the relay arm would have to re-implement this match in
// the test — which is a second authority over the routing decision, and the kind of thing that passes
// when the two copies agree by construction.
fn gate_route_for(standing: DeliveryIndependenceStanding) -> GateDiscoveryRoute {
  match standing {
    StandingRefuted { refused_because: _ } =>
      WebhookRelayFallback { relay_ingress: "tailscale-relay:approval-broker" }
    StandingUntested { read_obligation: _ } => NoWebhookPollAndSubmit
    StandingConfirmed { witnessed_run_id: _ } => NoWebhookPollAndSubmit
  }
}

fn selected_gate_route() -> GateDiscoveryRoute {
  gate_route_for(standing: rule_delivery_independence)
}

// The operator's webhook step has to say something, and this is what it says: while the standing is
// untested there is NO receiver, so the App's webhook is left pointed at a disabled endpoint. A step
// that configured a real public receiver would be adding the inbound exposure the route was chosen to
// avoid — and if the trial refutes the inference, it is this row that changes.
// THE RECEIVER AS A VALUE. The old form collapsed the route sum to "is it the no-webhook arm", which
// both dropped the relay's address and let the operator step's wording stand in for the fact. Absent
// means the App's webhook stays pointed at a disabled endpoint — the exposure the route was chosen to
// avoid. Present carries WHERE the relay listens, so the step's instruction can name it instead of
// describing it.
fn operator_webhook_receiver() -> Optional<NonEmptyStr> {
  match selected_gate_route() {
    NoWebhookPollAndSubmit => none
    WebhookRelayFallback { relay_ingress: r } => Present { value: r }
  }
}

// ---------------------------------------------------------------------------
// 5. WHAT THE BROKER MUST CONFIRM BEFORE IT ANSWERS
// ---------------------------------------------------------------------------

// WHAT THE WORKFLOW CLAIMS, from the approval request an earlier UNGATED job filed. A claim, not a
// fact: the workflow that filed it is the workflow waiting behind the gate, and its word on which
// environment it waits for is exactly what is worth doubting. Everything the broker acts on is
// re-derived from GitHub — including the run itself, which arrives as GitHub's record and not as an id.
type GateRequestClaim {
  run_id: Int,
  environment: NonEmptyStr,
  escalation_id: NonEmptyStr,
  request_revision: NonEmptyStr,
  attempt: AttemptIdentity,
}

// THE BINDING THE OPERATOR TAPPED. The capability authenticates a decision about an escalation at a
// revision, for an attempt — it does not itself name a GitHub environment. So the tap's reach is
// established by the claim the filing job wrote, and the review is answerable only where the
// capability's authenticated claims and that claim agree. A broker that compared the review against the
// claim alone checked the workflow's word, not the operator's.
fn capability_binds_request(
  capability: ApprovalCapability,
  claim: GateRequestClaim
) -> Bool {
  (capability.claims.escalation_id as String) == (claim.escalation_id as String)
    && (capability.claims.request_revision as String) == (claim.request_revision as String)
    && capability.claims.attempt == claim.attempt
}

fn capability_decision(capability: ApprovalCapability) -> ProposedDecision {
  capability.claims.decision
}

// THE PRE-ANSWER CHECK, in upstream's own order of authority. Nothing about the run is taken on trust:
//
//   THE RUN  — the caller supplies GitHub's OWN record of the run, and its run id must be the id that
//     was submitted. Taking `verified_run_id: Int` beside `claim.run_id: Int` was the mistake this
//     replaces: a caller that passed the claim's id straight through "verified" it, which is a
//     self-comparison with the word verification in its signature.
//   THE SETTLEMENT — a run GitHub reports as already concluded is not answered. That check is COMPOSED
//     IN HERE rather than offered beside the fold, because a fold whose caller must remember a second
//     check is a fold that will be called without it.
//   THE GATE, THREE NAMES ONE VALUE — the environment GitHub says is waiting, the environment the
//     workflow submitted, and the environment the enabled-rule readback attributes to this App.
//   THE TAP — the capability's own authenticated escalation, revision and attempt.
// A wait naming any human reviewer is refused too: that is a required-reviewer wait, and an App has no
// business answering it.
fn broker_may_answer(
  wait: PendingDeploymentWait,
  run: WorkflowRunRecord,
  claim: GateRequestClaim,
  capability: ApprovalCapability,
  ownership: EnvironmentRuleOwnership
) -> Bool {
  run.run_id == claim.run_id
    && (match answer_refusal_from_settlement(settlement: workflow_run_settlement(record: run)) {
          none => true
          Present { value: _ } => false
        })
    && pending_wait_environment_name(wait: wait) == claim.environment
    // THE OWNERSHIP SUM, CONSUMED WHERE IT IS CONSUMED. `rule_ownership_is_established` used to answer
    // this with true/false beside `ownership_names_environment`, which asked the same question of the
    // same value and already refused the NotOwned arm — a second predicate over one sum is a second
    // authority over it (§3), and the Bool version threw the typed `because:` away. One match, and the
    // environment it names is the one that has to agree.
    && (match ownership {
          OwnedByGateApp { rule_id: _, app_id: _, app_slug: _, environment_name: owned } =>
            owned == pending_wait_environment_name(wait: wait)
          NotOwnedByGateApp { because: _ } => false
        })
    && !pending_wait_carries_a_human_reviewer(wait: wait)
    && capability_binds_request(capability: capability, claim: claim)
}

// The third of the three names. A refusal that names no environment CANNOT name this one, so the
// unchecked-readback arm falls out of the same match — there is no "unknown environment" value to paper
// over a missing read, and no empty string pretending to be a name.
fn ownership_names_environment(
  ownership: EnvironmentRuleOwnership,
  environment: NonEmptyStr
) -> Bool {
  match ownership {
    OwnedByGateApp { rule_id: _, app_id: _, app_slug: _, environment_name: e } => e == environment
    NotOwnedByGateApp { because: _ } => false
  }
}

// A run GitHub reports as concluded is not answered — its deployment has settled, and a review posted
// now changes nothing while looking like it did. The settlement is GitHub's own sum, so "we did not
// look" is a value rather than a skipped call. Reached only through the record, which is why the fold
// above cannot be satisfied by an id.
// "We refused a run that had already concluded" and "we refused a run that had already FAILED" are
// different facts to record, and a Bool cannot tell them apart — so the conclusion survives in the
// refusal instead of being matched away.
type AnswerRefusal = RunAlreadyConcluded { conclusion: RunConclusion }

fn answer_refusal_from_settlement(settlement: RunSettlement) -> Optional<AnswerRefusal> {
  match settlement {
    RunSettlementInFlight => none
    RunSettled { conclusion: c } => Present { value: RunAlreadyConcluded { conclusion: c } }
  }
}

// THE OWNERSHIP READBACK, as the consumer calls it. The enabled-rules endpoint is the one that can
// answer (the integrations endpoint lists what COULD be enabled and carries no rule id or enabled
// flag), it needs only read access, and it returns an App id and slug — never an installation id. The
// installation the token is minted for is the configured fact below, matched against the operator's own
// record of the App.
fn ownership_by_readback(
  rules: List<EnabledDeploymentProtectionRule>,
  environment_name: NonEmptyStr,
  gate_app_id: Int
) -> EnvironmentRuleOwnership {
  rule_ownership_from_readback(
    rules: rules, environment_name: environment_name, gate_app_id: gate_app_id
  )
}

// THE TOKEN IDENTITY, AS A CONFIGURED FACT — deliberately not a field of any readback, because no
// readback in this feature returns one. It is the installation the App was installed as, recorded by
// the operator at the install step, and a review call cannot be made without it.
type GateInstallation {
  installation_id: Int,
  app_id: Int,
}

// ---------------------------------------------------------------------------
// 6. THE REVIEW BODY AGAINST THE TAP
// ---------------------------------------------------------------------------

// THE BODY-MUTATION FOLD, and the reason the check is here rather than after the response: a 204 comes
// back for a review that releases some other environment just as happily as for one that releases
// srv1-production. The response cannot tell them apart, so the only place the distinction can be
// enforced is before the call.
fn review_answers_capability(
  review: DeploymentProtectionRuleReview,
  claim: GateRequestClaim,
  capability: ApprovalCapability
) -> Bool {
  review_releases_environment(review: review) == claim.environment
    && capability_binds_request(capability: capability, claim: claim)
    && review_matches_decision(review: review, decision: capability_decision(capability: capability))
}

fn review_matches_decision(review: DeploymentProtectionRuleReview, decision: ProposedDecision) -> Bool {
  match decision {
    ProposeApprove => review_decision(review: review) == Approved
    ProposeDeny => review_decision(review: review) == Rejected
  }
}

// 204 and nothing else, on the App's endpoint. The two pending_deployments calls answer 200 with a
// body; reading a poll's 200 as an accepted review reports an approval that was never given.
fn review_was_accepted(status: HttpStatus) -> Bool {
  review_call_succeeded(status: status)
}

// ---------------------------------------------------------------------------
// 7. WHAT MUST BE WITNESSED BEFORE A HUMAN REVIEWER IS REMOVED
// ---------------------------------------------------------------------------

// ONE OBSERVED RULE REVIEW, and the readback that is the only way to obtain one. A typed prerequisite
// is only stronger than the prose it replaces if its value comes from an observation: as a free record
// with three fields, RemovalAdmitted could be built from literals in a call and the removal performed
// on a Tuesday with nothing having happened. So an ObservedRuleReview is not a record anyone fills in —
// it is produced by observed_review_from_readback, from GitHub's record of the run plus the
// pending_deployments readback, and it is REFUSED when those two do not corroborate the state claimed.
//
// WHAT CORROBORATES WHAT. Upstream records a rule review by what it does to the waiting job: approving
// lets the job proceed, rejecting fails it. So:
//   Approved  — the environment must no longer be waiting AND the run must not have concluded as a
//               failure. A job that failed at the gate was not released by an approval.
//   Rejected  — the environment must no longer be waiting AND the run must have concluded as a failure.
//               A job that carried on was not refused.
// The two arms require mutually exclusive evidence, which is what makes one dispatch incapable of
// satisfying both halves of the pair.
type ObservedRuleReview sole_constructor {
  run_id: Int,
  environment_name: NonEmptyStr,
  state: ReviewState,
}

type ObservedReviewRefusal {
  reason: NonEmptyStr,
}

fn observed_review_from_readback(
  run: WorkflowRunRecord,
  environment_still_waiting: Bool,
  claimed: ReviewState,
  environment_name: NonEmptyStr
) -> ObservedRuleReview? {
  if environment_still_waiting {
    none
  } else {
    match workflow_run_settlement(record: run) {
      RunSettlementInFlight => match claimed {
        Approved =>
          Present {
            value: ObservedRuleReview {
              run_id: run.run_id,
              environment_name: environment_name,
              state: Approved,
            },
          }
        Rejected => none
      }
      RunSettled { conclusion: c } => match claimed {
        Approved => none
        Rejected => match c {
          RunFailure =>
            Present {
              value: ObservedRuleReview {
                run_id: run.run_id,
                environment_name: environment_name,
                state: Rejected,
              },
            }
          _ => none
        }
      }
    }
  }
}

// THE TRIALS THAT COUNT: both states, both on the gated environment, and the approve and the reject
// seen on DIFFERENT runs. An approval and a rejection of the same dispatch is one dispatch, and one
// dispatch cannot show that the broker refuses when it should — which is the half of the gate that
// stops being tested the moment the human reviewer goes away.
type DeploymentGateTrialEvidence sole_constructor {
  run_id_approved: Int,
  run_id_rejected: Int,
  environment_name: NonEmptyStr,
}


// THE RUNG, STATED AT WHAT EXECUTES IT (§4b meta-obligation 1: the reported rung equals the rung
// established by executed evidence, and rung inflation is worse than sitting low).
//
//   STRUCTURAL, ENFORCED BY THE COMPILER. ObservedRuleReview and DeploymentGateTrialEvidence are
//   sole_constructor, so OUTSIDE THIS MODULE a literal for either is refused at the name
//   (SoleConstructorViolation — executed as a probe red by
//   test.claim.deployment_gate_authorization_witness). That is what makes "remove the reviewer
//   without both trials" unrepresentable AS SOURCE: there is no value of the admitted arm an outside
//   caller can supply, because there is no value of the evidence type it could carry.
//
//   RUNTIME, FOR THE ONE PROPERTY THE TYPE CANNOT HOLD. That the two trials name DIFFERENT runs and
//   the gated environment is checked by admit_reviewer_removal below at the moment of minting, because
//   the record keeps the two run ids as plain Ints and no type here says "different". So the pair is
//   minted-or-refused, and the coherence check runs at the mint rather than at each call site — a
//   caller cannot re-check it wrongly, and cannot mint it wrongly either.
//
// NEXT RUNG, AND ITS TRIGGER: the check moves from the mint into the type when the corpus grows a
// distinct run-id carrier that carries inequality in its own construction; until then this is rung 4
// on construction and a checked mint on coherence, and no stronger claim is made anywhere in this file.
// WHY the removal is not yet performable, as a closed sum. A paragraph here would be read by nobody
// but a test comparing sentences; a refusal an operator can act on is a name.
type RemovalRefusalReason
  = NoApprovingReview
  | NoRejectingReview
  | ApprovingArmWasNotAnApproval
  | RejectingArmWasNotARejection
  | BothArmsOneDispatch
  | EvidenceFromAnotherEnvironment

type ReviewerRemovalAdmission
  = RemovalAdmitted { evidence: DeploymentGateTrialEvidence }
  | RemovalRefused { missing: RemovalRefusalReason }

// THE ONLY WAY AN ADMISSION COMES INTO EXISTENCE. Both arms arrive here, and the arms are the point:
// anything that is not exactly one corroborated approve plus one corroborated reject on the gated
// environment comes back as a refusal naming what is missing. Witnesses do not construct an admitted
// admission; they call this with what their readbacks returned.
fn admit_reviewer_removal(
  approved: ObservedRuleReview?,
  rejected: ObservedRuleReview?
) -> ReviewerRemovalAdmission {
  match approved {
    Present { value: a } => match rejected {
      Present { value: r } =>
        if a.state != Approved {
          RemovalRefused { missing: ApprovingArmWasNotAnApproval }
        } else if r.state != Rejected {
          RemovalRefused { missing: RejectingArmWasNotARejection }
        } else if a.environment_name != srv1_production_environment_name {
          RemovalRefused { missing: EvidenceFromAnotherEnvironment }
        } else if r.environment_name != srv1_production_environment_name {
          RemovalRefused { missing: EvidenceFromAnotherEnvironment }
        } else if a.run_id == r.run_id {
          RemovalRefused { missing: BothArmsOneDispatch }
        } else {
          RemovalAdmitted {
            evidence: DeploymentGateTrialEvidence {
              run_id_approved: a.run_id,
              run_id_rejected: r.run_id,
              environment_name: a.environment_name,
            },
          }
        }
      none => RemovalRefused { missing: NoRejectingReview }
    }
    none => RemovalRefused { missing: NoApprovingReview }
  }
}

// What the removal act asks, and all it can ask: the admission is the whole precondition, and the act
// has no other way to be performed.
// THE OBSTACLE AS A VALUE, because the refusal is the half the operator acts on: WHICH trial is
// missing says what to run next. The Bool that stood here kept the reason in a type and then dropped it
// (`RemovalRefused { missing: _ } => false`), so the model could state six distinct blockers and report
// only "no". Consumers that want yes/no ask THIS and match it; nothing re-implements the arm test.
fn reviewer_removal_obstacle(admission: ReviewerRemovalAdmission) -> Optional<RemovalRefusalReason> {
  match admission {
    RemovalAdmitted { evidence: _ } => none
    RemovalRefused { missing: m } => Present { value: m }
  }
}

// THE FRONTIER, AS A VALUE. Stage 1 models the admission and its refusals; it cannot produce the
// evidence, because no rule is enabled and no dispatch has been witnessed. This row is what "not yet"
// reads as in the model, and the removal act has no admitted value until stage 4 witnesses both arms on
// a real fleet-converge dispatch — each one through observed_review_from_readback, so the day it
// changes it changes because GitHub said so.
// Minted, not written out: the frontier refusal is what the mint returns when no readback has
// corroborated either arm. A stage-1 module cannot fabricate an admitted admission, and it cannot even
// fabricate this refusal — it asks the mint, and the mint says what is missing.
data reviewer_removal_admission: ReviewerRemovalAdmission = admit_reviewer_removal(
  approved: none,
  rejected: none,
)

fn reviewer_removal_is_performable() -> Bool {
  match reviewer_removal_obstacle(admission: reviewer_removal_admission) {
    none => true
    Present { value: _ } => false
  }
}

// ---------------------------------------------------------------------------
// 8. OBSERVATIONS THIS REPOSITORY MAKES ABOUT AN UPSTREAM ARTEFACT
// ---------------------------------------------------------------------------

// GitHub's worked example posts prod-eus. It is not this repository's gate; conflating the two posts a
// review that releases nothing we care about while reading as a success. The comparison is an
// observation gunbc makes about an upstream artefact, so it is here and not in the upstream model.
fn documented_example_is_not_the_gated_environment() -> Bool {
  review_releases_environment(review: review_documented_example_body)
    != srv1_production_environment_name
}

// ---------------------------------------------------------------------------
// 9. THE CEILING, AS A CONSUMER READS IT
// ---------------------------------------------------------------------------

// The break-glass question is how long a job has been WAITING, and it cannot be answered here: the
// corpus has no timestamp parser (std.types declares Timestamp = String), so elapsed time has no
// carrier. What IS modelled is the ceiling a wait must stay inside, and the fact that the environment's
// CONFIGURED wait_timer is not that quantity — it is a configured delay in minutes, capped by upstream
// at exactly this ceiling, so comparing the two could never fire. The elapsed-wait seam is owed by
// stage 2: a real clock observation, a parse of GitHub's ISO-8601, and a subtraction in Second.
fn gate_ceiling_in_seconds() -> Int {
  second_count(s: custom_rule_response_timeout())
}

fn documented_timer_maximum_in_seconds() -> Int {
  second_count(s: wait_minutes_as_seconds(minutes: wait_timer_maximum))
}

// The ceiling itself: 30 days, from the duration carrier rather than from an Int whose unit survives
// only in its name. Two independent upstream statements, one magnitude, and a divergence between them
// would show up here.
fn gate_ceilings_agree() -> Bool {
  gate_ceiling_in_seconds() == second_count(s: rule_gate_approval_ceiling())
    && custom_rule_timeout_run_conclusion == RunFailure
}
