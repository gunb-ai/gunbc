  gcp_iam_observe_wif_pool_id, gcp_iam_observe_wif_pool_display_name, gcp_iam_observe_wif_provider_id,
  gcp_iam_observe_wif_attribute_mapping, gcp_iam_observe_wif_attribute_condition, gcp_iam_observe_wif_principal_set,
