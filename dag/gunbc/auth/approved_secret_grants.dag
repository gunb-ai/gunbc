module gunbc.auth.approved_secret_grants

import std.types { String, NonEmptyStr, List, Bool }
import std.algebra { trim }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.measure { second }
import std.content_hash { as_content_hash_cryptographic, sha256_hex_digest }
import std.bytes { bytes_octets, utf8_encode_bytes }
import extdeps.crypto.sha2 { sha256_hex }
import std.effect_grant { Write, NamespacePosition, ServiceOpTree }
import std.scoped_authorization { AuthorizationRequest, AuthorizationScope, AttemptIdentity }
import extdeps.languages.json.emit { JsonValue, json_object, json_array, json_kv, json_string, json_null, serialize_json }
import extdeps.cloud.gcp.secret_ref { secret_ref_secret_resource }
import gunbc.auth.gcp_secret_access { SecretAccessGrant, grant_member_resolution, GrantMemberResolved, GrantMemberUnresolved, secret_access_reconcile_with_token, secret_access_reconciliation_exit }
import gunbc.auth.approval_run_identity { run_attempt }
import gunbc.auth.approved_gcp_access { approved_gcp_access_for_request, approved_gcp_file_request, ApprovedGcpAccessReady, ApprovedGcpAccessRefused }
import gunbc.auth.approval_gate { approval_instant_now, approval_expires_at, ApprovalFiled, ApprovalFilingRefused }

// Only the reviewed workflow's post-approval auth step supplies this credential.
data secret_grant_token_variable: NonEmptyStr = "SECRET_GRANT_ACCESS_TOKEN"

fn secret_grant_intent_json(grant: SecretAccessGrant, member: String) -> JsonValue {
  json_object(members: [
    json_kv(key: "secret", value: json_string(s: secret_ref_secret_resource(ref: grant.target))),
    json_kv(key: "member", value: json_string(s: member)),
    json_kv(key: "role", value: json_string(s: grant.role)),
    json_kv(key: "condition", value: match grant.condition {
      Absent => json_null()
      Present { value: c } => json_object(members: [
        json_kv(key: "title", value: json_string(s: c.title)),
        json_kv(key: "expression", value: json_string(s: c.expression)),
        json_kv(key: "description", value: match c.description { Absent => json_null() Present { value: description } => json_string(s: description) }),
      ])
    }),
  ])
}

// The full exact grant batch is bound to one run attempt. Secret payloads never enter this plan.
// THE INTENT is everything the approval binds -- the attempt, and each grant's target, role and
// member. It is derived once here, and the request below only digests it, so what an approval is
// bound to is decidable without paying the digest.
fn secret_grants_intent(grants: List<SecretAccessGrant>, member: String, attempt: AttemptIdentity) -> String? {
  if count(grants) == 0 || trim(s: member) == "" { none }
  else {
    Present { value: serialize_json(v: json_object(members: [
      json_kv(key: "attempt", value: json_string(s: attempt as String)),
      json_kv(key: "grants", value: json_array(elements: map(grants, grant => secret_grant_intent_json(grant: grant, member: member)))),
    ])) }
  }
}

fn secret_grants_approval_request(grants: List<SecretAccessGrant>, member: String, attempt: AttemptIdentity) -> AuthorizationRequest<NonEmptyStr>? {
  match secret_grants_intent(grants: grants, member: member, attempt: attempt) {
    Absent => none
    Present { value: intent } =>
    match sha256_hex_digest(hex: sha256_hex(message: bytes_octets(b: utf8_encode_bytes(s: intent)))) {
      Absent => none
      Present { value: digest } => Present { value: AuthorizationRequest {
        escalation_id: join(["secret-grants-", digest.hex as String, "-", attempt as String], "") as NonEmptyStr,
        scopes: map(grants, grant => AuthorizationScope { verb: Write,
          resource: NamespacePosition { tree: ServiceOpTree { service: "secretmanager.googleapis.com" }, path: split(s: secret_ref_secret_resource(ref: grant.target), delimiter: "/") },
          action: "gunbc.secret-access.ensure-grant" }),
        subject: intent as NonEmptyStr,
        purpose: concat("Ensure only these Secret Manager access bindings, preserving foreign policy cells: ", intent) as NonEmptyStr,
        attempt: attempt, intent_hash: as_content_hash_cryptographic(digest: digest), destructive: false,
      } }
    }
  }
}

// Both phases derive the same plan. Apply rechecks the live approval before every secret write.
fn secret_grants_via_approval(grants: List<SecretAccessGrant>, request_only: Bool) -> ProcessExit {
  match run_attempt() {
    Absent => exit_failure(reason: "Secret access requires a reviewed convergence run identity; use the approval workflow, not a GCP login code or operator token file")
    Present { value: attempt } => match grant_member_resolution() {
      GrantMemberUnresolved { cause } => exit_failure(reason: cause)
      GrantMemberResolved { member } => match secret_grants_approval_request(grants: grants, member: member, attempt: attempt) {
        Absent => exit_failure(reason: "Secret grant plan is empty or unreadable")
        Present { value: request } => if request_only {
          match approval_instant_now() {
            Absent => exit_failure(reason: "Approval clock unreadable")
            Present { value: now } => match approved_gcp_file_request(request: request, issued_at: now,
              expires_at: approval_expires_at(issued: now, window: second(count: 1800)), body_file_name: "secret-grants-request.json") {
              ApprovalFiled => ExitSuccess
              ApprovalFilingRefused { reason } => exit_failure(reason: reason)
            }
          }
        } else {
          fold(grants, init: ExitSuccess, f: (prior, grant) => match prior {
            ExitSuccess => match approved_gcp_access_for_request(request: request, token_variable: secret_grant_token_variable) {
              ApprovedGcpAccessRefused { reason } => exit_failure(reason: reason)
              ApprovedGcpAccessReady { authorization: _, token } => secret_access_reconciliation_exit(r: secret_access_reconcile_with_token(grant: grant, member: member, token: token))
            }
            failed => failed
          })
        }
      }
    }
  }
}
