  approval_submission_mac_key_path,
}
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.tools.sha256sum { sha256sum_file_digest_via_shell, Sha256FileDigest, Sha256FileDigestUnavailable }
import extdeps.sudo.elevation { sudo_elevate }
import extdeps.tools.chown { chown_argv, ChownOwnerNames }
import extdeps.posix.identity { PosixOwnerNames }
import gunbc.fleet_intent_network { operator_host_srv1 }
import gunbc.actions_run_binding { actions_variable_read, ActionsVariablePresent, ActionsVariableAbsent, fleet_converge_expected_host_env_name, actions_variable_trimmed }
import gunbc.auth.approval_keyring_pins {
  approval_submission_mac_key_path_env,
  approval_capability_mac_key_path_env,
  approval_mac_key_payload_sha256_prefix,
  approval_submission_mac_key_payload_sha256_prefix,
}
import gunbc.fleet_bootstrap_principal { executor_bootstrap_principal }
import gunbc.fleet_posix_accounts { fleet_posix_root_user, fleet_posix_operator_user, fleet_posix_ci_runner_user, fleet_usermod_binary_path }
import gunbc.auth.approval_ntfy_deployment { approval_ntfy_principal_name }
import gunbc.live_deploy.spec { gunbc_roadmap_unit_name }
