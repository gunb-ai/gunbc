module gunbc.auth.approval_keyring_converge

import std.types { Bool, NonEmptyStr, String }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import gunbc.auth.approval_decision_store { approval_mac_key_secret_ref, approval_mac_key_path }
import gunbc.auth.approval_request_submission {
  approval_submission_mac_key_path,
  approval_submission_mac_key_secret_ref,
}
import extdeps.cloud.gcp.secret_ref { secret_ref_access_url }
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.tools.sha256sum { sha256sum_file_digest_via_shell, Sha256FileDigest, Sha256FileDigestUnavailable }
import gunbc.fleet_intent_network { operator_host_srv1 }
import gunbc.fleet_converge_receipt { fleet_converge_expected_host_env_name }
import gunbc.actions_run_binding { actions_variable_read, ActionsVariablePresent, ActionsVariableAbsent }

data approval_keyring_config_dir: NonEmptyStr = "/etc/gunbc-roadmap"

data approval_submission_mac_key_path_env: NonEmptyStr = "GUNBC_APPROVAL_SUBMISSION_MAC_KEY_FILE"

data approval_mac_key_payload_sha256_prefix: NonEmptyStr = "113a3274bd95"

data approval_keyring_file_mode: NonEmptyStr = "0640"

data approval_keyring_file_owner: NonEmptyStr = "root"

data approval_keyring_file_group: NonEmptyStr = "briansrls"

fn approval_capability_mac_access_url() -> String {
  secret_ref_access_url(ref: approval_mac_key_secret_ref)
}

fn approval_submission_mac_access_url() -> String {
  secret_ref_access_url(ref: approval_submission_mac_key_secret_ref)
}

type KeyringSha256Compare
  = Sha256PrefixMatches { prefix: NonEmptyStr }
  | Sha256PrefixMismatch { expected: NonEmptyStr, observed: NonEmptyStr }
  | Sha256Unavailable { detail: NonEmptyStr }

fn sha256_prefix_compare(observed_hex: String, expected_prefix: NonEmptyStr) -> KeyringSha256Compare {
  let n = expected_prefix.length()
  if observed_hex.length() < n {
    Sha256Unavailable { detail: "observed digest shorter than the modeled prefix" }
  } else {
    let prefix = substring(s: observed_hex, start: 0, end: n)
    let expected = expected_prefix as String
    if prefix == expected {
      Sha256PrefixMatches { prefix: expected_prefix }
    } else {
      Sha256PrefixMismatch {
        expected: expected_prefix,
        observed: prefix as NonEmptyStr,
      }
    }
  }
}

fn approval_capability_digest_standing(observed_hex: String) -> ProcessExit {
  match sha256_prefix_compare(observed_hex: observed_hex, expected_prefix: approval_mac_key_payload_sha256_prefix) {
    Sha256PrefixMatches { prefix: _ } => ExitSuccess
    Sha256PrefixMismatch { expected: e, observed: o } =>
      exit_failure(reason: concat("approval keyring: capability MAC key sha256 prefix mismatch (expected ", concat(e as String, concat(", observed ", o as String)), ")"))
    Sha256Unavailable { detail: d } =>
      exit_failure(reason: concat("approval keyring: capability MAC key digest unusable: ", d as String))
  }
}

fn keyring_host_must_be_srv1(host: String) -> Bool {
  host == operator_host_srv1 as String
}

fn approval_keyring_converge_refuses_off_srv1(host: String) -> ProcessExit {
  if keyring_host_must_be_srv1(host: host) {
    ExitSuccess
  } else {
    exit_failure(reason: concat("approval keyring converge refuses host '", concat(host, concat("': the files live on the machine that serves /approve, which is ", operator_host_srv1 as String))))
  }
}

fn approval_keyring_converge_wet() -> ProcessExit {
  match actions_variable_read(name: fleet_converge_expected_host_env_name) {
    ActionsVariableAbsent { variable: v, detail: d } =>
      exit_failure(reason: concat("approval keyring converge: ", concat(v, concat(" ", concat(d, "; one host per run, named by the dispatch")))))
    ActionsVariablePresent { value: host } =>
      match approval_keyring_converge_refuses_off_srv1(host: host) {
    ExitSuccess => {
      let cap = Filesystem.Read(path: approval_mac_key_path as String)
      let sub = Filesystem.Read(path: approval_submission_mac_key_path as String)
      if !cap.success {
        exit_failure(reason: concat("approval keyring: capability MAC key unreadable at ", concat(approval_mac_key_path as String, concat(": ", cap.error))))
      } else if !sub.success {
        exit_failure(reason: concat("approval keyring: submission MAC key unreadable at ", concat(approval_submission_mac_key_path as String, concat(": ", sub.error))))
      } else {
        match sha256sum_file_digest_via_shell(path: approval_mac_key_path) {
          Sha256FileDigestUnavailable { path: _, reason: r } =>
            exit_failure(reason: concat("approval keyring: could not digest the installed capability MAC key: ", r))
          Sha256FileDigest { digest: d } => approval_capability_digest_standing(observed_hex: d.hex as String)
        }
      }
    }
    other => other
      }
  }
}
