module gunbc.auth.branch_run_grant_await

import std.types { Bool, Int, List, NonEmptyStr, String, Timestamp }
import std.optional { Present, Absent }
import std.measure { Second, second, second_count }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import extdeps.tools.sleep { sleep_delay_seconds_second_carrier_projection }
import extdeps.github.actions_environment { github_run_id_variable_name, github_run_attempt_variable_name }
import extdeps.github.workflow_runs
import extdeps.github.workflow_runs { WorkflowRun, Completed, Success }
import extdeps.transports.rest { RestAnswered, RestRefused }
import gunbc.repository { gunbc_repository }
import gunbc.generated_artifact { artifact_name, FleetConvergeYamlArtifact }
import gunbc.actions_run_binding { actions_variable_trimmed }
import gunbc.auth.heal_publisher_provision { rest_refusal_text }
import gunbc.auth.oidc_claim_pins { workflow_dispatch_event_name }
import gunbc.auth.branch_dispatch_federation { branch_run_key }
import gunbc.auth.branch_run_grant_broker { branch_run_grant_dispatch_ref }

// ── THE REQUESTING RUN'S SIDE OF A RUN-SCOPED GRANT ─────────────────────────────────────────────
// A fleet-converge run whose mode needs a run-scoped account waits here, BEFORE its auth step, for
// the grant run main's broker dispatched for it (gunbc.auth.branch_run_grant_broker). It asks for
// nothing and holds no credential that could: its token reads runs and nothing else. It finds the
// grant run by the run key in that run's title and waits for it to finish. A refused, denied or
// expired grant fails this step and the auth step never runs; a forged "grant" -- any run whose title
// merely matches -- grants nothing either, because the auth step is refused by IAM unless the cell
// exists. This step only decides when to try.

data branch_run_grant_wait: Second = second(count: 2400)

data branch_run_grant_poll: Second = second(count: 15)

// IAM POLICY CHANGES PROPAGATE, THEY DO NOT LAND ATOMICALLY: Google documents that a changed
// allow policy usually takes effect within two minutes and can take up to seven
// (cloud.google.com/iam/docs/access-change-propagation). The auth step after this one is the
// loud failure if propagation outruns this wait; it is never retried silently.
data branch_run_grant_propagation: Second = second(count: 120)

type GrantRunWait
  = GrantRunSucceeded
  | GrantRunFailed { detail: String }
  | GrantRunTimedOut

// THE GRANT RUN FOR THIS KEY: a dispatch of fleet-converge on main whose title ends with the key.
fn is_grant_run_for(run: WorkflowRun, key: String) -> Bool {
  let title = match run.display_title { Present { value: t } => t  Absent => "" }
  run.event == workflow_dispatch_event_name
    && match run.head_branch { Present { value: b } => b == branch_run_grant_dispatch_ref  Absent => false }
    && title.ends_with(concat(" nonce=", key))
    && title.contains(" branch_run_grant ")
}

fn grant_run_conclusion(run: WorkflowRun) -> GrantRunWait {
  match run.conclusion {
    Present { value: c } => if (c == Success) { GrantRunSucceeded } else { GrantRunFailed { detail: concat("the grant run did not succeed: ", run.html_url as String) } }
    Absent => GrantRunFailed { detail: concat("the grant run completed with no conclusion: ", run.html_url as String) }
  }
}

fn wait_on_runs(key: String, since: Timestamp, remaining: Int, runs: List<WorkflowRun>) -> GrantRunWait {
  match filter(runs, r => is_grant_run_for(run: r, key: key)).first() {
    Present { value: r } =>
      if (r.status == Completed) { grant_run_conclusion(run: r) }
      else { pace_and_retry(key: key, since: since, remaining: remaining) }
    Absent => pace_and_retry(key: key, since: since, remaining: remaining)
  }
}

fn pace_and_retry(key: String, since: Timestamp, remaining: Int) -> GrantRunWait {
  let paced = sleep_delay_seconds_second_carrier_projection(duration: branch_run_grant_poll)
  wait_for_grant_run(key: key, since: since, remaining: remaining - 1)
}

fn wait_for_grant_run(key: String, since: Timestamp, remaining: Int) -> GrantRunWait {
  if remaining <= 0 {
    GrantRunTimedOut
  } else {
    match github.WorkflowRuns.ListWorkflowRuns(auth_token: "", owner: gunbc_repository.owner, repo: gunbc_repository.name, workflow_name: artifact_name(a: FleetConvergeYamlArtifact), event: workflow_dispatch_event_name, created_range: concat(">=", since as String)) {
      RestRefused { refusal } => GrantRunFailed { detail: concat("the grant runs could not be listed: ", rest_refusal_text(o: refusal)) }
      RestAnswered { answer: got } => wait_on_runs(key: key, since: since, remaining: remaining, runs: got.result.workflow_runs)
    }
  }
}

// `gunbc run --source-root dag --source-root src/v2 --entry dag/gunbc/auth/branch_run_grant_await.dag --function await_grant`
fn await_grant() -> ProcessExit {
  let me = actions_variable_trimmed(name: github_run_id_variable_name as NonEmptyStr)
  match parse_int(s: me) {
    Absent => exit_failure(reason: "branch run grant: GITHUB_RUN_ID is unset; this entry runs only in a fleet-converge job")
    Present { value: run_id } => match parse_int(s: actions_variable_trimmed(name: github_run_attempt_variable_name as NonEmptyStr)) {
      Absent => exit_failure(reason: "branch run grant: GITHUB_RUN_ATTEMPT is unset")
      Present { value: attempt } => match github.WorkflowRuns.GetRun(auth_token: "", owner: gunbc_repository.owner, repo: gunbc_repository.name, run_id: me) {
        RestRefused { refusal } => exit_failure(reason: concat("branch run grant: this run could not be read: ", rest_refusal_text(o: refusal)))
        RestAnswered { answer: got } => {
          let key = branch_run_key(run_id: run_id, run_attempt: attempt)
          match wait_for_grant_run(key: key, since: got.run.created_at, remaining: second_count(s: branch_run_grant_wait) / second_count(s: branch_run_grant_poll)) {
            GrantRunTimedOut => exit_failure(reason: concat("branch run grant: no grant run finished within the wait for ", key))
            GrantRunFailed { detail: d } => exit_failure(reason: concat("branch run grant: refused or denied, nothing granted: ", d))
            GrantRunSucceeded => {
              let propagated = sleep_delay_seconds_second_carrier_projection(duration: branch_run_grant_propagation)
              ExitSuccess
            }
          }
        }
      }
    }
  }
}
