module gunbc.auth.approval_google_enrolment

import std.types { NonEmptyStr, String, Timestamp, Bool, List }
import std.decl_ref { decl_ref }
import std.error_primitives { pure_dag_seam_unreachable_string }
import std.encoding { base64_encode, base64_octets, UrlSafe }
import std.integer { QualifiedOctetsReady, QualifiedOctetsRefused }
import std.bytes { utf8_encode_bytes, bytes_octets }
import extdeps.crypto.sha2 { sha256 }
import extdeps.crypto.signature { VerifyingKey }
import extdeps.auth.jwt { JwtStringOrUri, JwtBareString, JwtAudience, JwtAudienceSingle, JwtAudienceMultiple, NumericDate, jwt_string_or_uri_wire }
import extdeps.auth.oidc { OidcIdTokenClaims, OidcIdTokenSignature, OidcIdTokenVerified, OidcIdTokenRefused, OidcIdTokenRefusal, OidcIdTokenVerdictPolicy, verify_oidc_id_token }
import extdeps.apple.app_attest { AttestKeyId, AttestationVerification, AttestationVerified, AttestationRefused, AttestationRefusal }
import gunbc.auth.google_workspace_login { google_workspace_issuer, gunb_ai_hosted_domain }
import gunbc.auth.approval_device_wire { MobilePlatform, MobileIos, MobileAndroid, platform_wire, framed }
import gunbc.auth.tracker_web_oauth_client { approve_ios_oauth_client }
import gunbc.auth.approval_decision_store { approval_google_approver_emails }
import gunbc.auth.approval_device_redemption { VerifiedPlatformEvidence, IosAttestedAppInstance, AndroidAttestedDecisionKey }

// ── GOOGLE SIGN-IN IS ENROLMENT (ruling gunbc.design_ruling approval_enrolment_is_google_sign_in) ──
// The phone signs in with Google once. In the same step it creates its Secure-Enclave decision key
// and its App Attest key, and one POST registers both under the verified Google identity. There is
// no code, no second step, and no state the phone must recover: the POST is idempotent, so an
// unanswered POST is resent, and a failed sign-in is "sign in again". The plan carrier is
// gunbc.plans.approval_google_enrolment; this module is the authority for what admits an enrolment.
//
// THREE SEALED STAGES, each consuming the carrier only the stage before it mints, so no caller can
// reach an enrolment write with facts it assembled itself:
//   1. admit_google_approver: takes the UNVERIFIED claims, the signature realization's verdict and
//      the submitted keys, runs the verdict fold itself under this module's policy, and mints
//      VerifiedGoogleApprover. Caller-sealed (admit_callers), because the signature input is the
//      realization seam: whoever may call this may assert a verified signature.
//   2. join_subject_pin: the route's create-or-read of the email's subject pin, joined to the
//      presented subject, mints SubjectPinnedToPresentedSubject.
//   3. google_enrolment_admission: from that carrier and the attestation, decides write, replay
//      (joined to the stored record field by field) or refusal.
//
// Every check is a fact an earlier authority already owns, and this module joins them:
//   - the ID token's verdict is extdeps.auth.oidc verify_oidc_id_token, its signature the
//     production JWKS realization gunbc.auth.oidc_id_token_verification;
//   - issuer and hosted domain are gunbc.auth.google_workspace_login's (hd == gunb.ai);
//   - the audience is the approve-ios OAuth client, one row here (an iOS-type client: a web client
//     cannot serve a native redirect, and admitting the dashboard client's audience would let a
//     dashboard login token enrol a device);
//   - who may enrol is the approver roster, matched on the verified Workspace email, and the
//     Google subject is pinned per email before anything is written;
//   - the App Attest verdict is extdeps.apple.app_attest's, kept as VerifiedPlatformEvidence.

// ── THE TRANSCRIPT, AND WHY THE NONCE IS ITS HASH ──────────────────────────────────────────────
// The app builds the transcript BEFORE sign-in from the keys it just created, and passes
// nonce = base64url(sha256(transcript)) to Google. The server rebuilds the transcript from the
// submitted keys, so the token's nonce commits Google's assertion to exactly these keys. A token
// replayed beside a different decision key or attest key yields a different transcript and refuses
// at the verdict's nonce arm; no server-side nonce store exists, because the nonce is DERIVED, never
// issued. The App Attest attestation is made over the same transcript, so the two proofs name one
// set of keys.
data approval_google_enrolment_protocol: NonEmptyStr = "gunbc.approval-google-enrolment.v1" as NonEmptyStr

fn google_enrolment_transcript(platform: MobilePlatform, decision_key: VerifyingKey, attest_key_id: AttestKeyId) -> NonEmptyStr {
  framed(fields: [
    approval_google_enrolment_protocol as String,
    platform_wire(p: platform) as String,
    decision_key.point_b64url as String,
    attest_key_id as String,
  ])
}

// sha256's output is 32 in-range octets, so the qualifying refusal arm is unreachable, and it
// diverges rather than fabricating a digest.
fn sha256_b64url(text: NonEmptyStr) -> NonEmptyStr {
  match base64_octets(values: sha256(message: bytes_octets(b: utf8_encode_bytes(s: text as String)))) {
    QualifiedOctetsReady { value: qualified } => base64_encode(octets: qualified, variant: UrlSafe) as NonEmptyStr
    QualifiedOctetsRefused { observed: _ } => pure_dag_seam_unreachable_string() as NonEmptyStr
  }
}

fn google_enrolment_nonce(transcript: NonEmptyStr) -> NonEmptyStr {
  sha256_b64url(text: transcript)
}

// ── THE AUDIENCE, EXACTLY ──────────────────────────────────────────────────────────────────────
// The audience is gunbc.auth.tracker_web_oauth_client approve_ios_oauth_client, the iOS client the
// operator registered, read from the registration and never passed in. The generic verdict admits a
// token whose aud INTERSECTS the admitted list and does not read azp; enrolment needs more, so this
// module adds an exact check after the verdict: aud names the approve-ios client and nothing else,
// and azp, when present, is that client too. A token whose aud also names the dashboard client (or
// whose authorized party is the dashboard) was minted for a flow that is not this one, and refuses.
fn approve_ios_audience() -> JwtStringOrUri {
  JwtBareString { value: approve_ios_oauth_client.client_id }
}

fn approval_google_enrolment_policy(transcript: NonEmptyStr, observed_at: NumericDate) -> OidcIdTokenVerdictPolicy {
  OidcIdTokenVerdictPolicy {
    expected_issuer: google_workspace_issuer(),
    admitted_audiences: [approve_ios_audience()],
    expected_hosted_domain: gunb_ai_hosted_domain,
    expected_nonce: Present { value: google_enrolment_nonce(transcript: transcript) },
    observed_at: observed_at,
  }
}

fn audience_is_exactly_approve_ios(aud: JwtAudience) -> Bool {
  match aud {
    JwtAudienceSingle { value: v } => v == approve_ios_audience()
    JwtAudienceMultiple { values: vs } => all(vs, v => v == approve_ios_audience())
  }
}

fn authorized_party_admitted(azp: JwtStringOrUri?) -> Bool {
  match azp {
    Absent => true
    Present { value: v } => v == approve_ios_audience()
  }
}

// ── THE SUBMITTED KEYS ─────────────────────────────────────────────────────────────────────────
// What the phone submits beside its token. The approver carrier binds them, so the keys a later
// stage admits are exactly the keys the token's nonce was checked against.
type GoogleEnrolmentKeys {
  platform: MobilePlatform
  decision_key: VerifyingKey
  attest_key_id: AttestKeyId
}

fn google_enrolment_keys_transcript(k: GoogleEnrolmentKeys) -> NonEmptyStr {
  google_enrolment_transcript(platform: k.platform, decision_key: k.decision_key, attest_key_id: k.attest_key_id)
}

// ── STAGE 1: THE APPROVER ──────────────────────────────────────────────────────────────────────
type VerifiedGoogleApprover sole_constructor {
  email: NonEmptyStr
  subject: NonEmptyStr
  keys: GoogleEnrolmentKeys
}

type GoogleEnrolmentRefusal
  = GoogleEnrolmentTokenRefused { cause: OidcIdTokenRefusal }
  | GoogleEnrolmentAudienceNotExact
  | GoogleEnrolmentAuthorizedPartyNotAdmitted
  | GoogleEnrolmentEmailAbsent
  | GoogleEnrolmentNotAnApprover { email: NonEmptyStr }
  | GoogleEnrolmentSubjectMismatch { email: NonEmptyStr }
  | GoogleEnrolmentAttestationRefused { cause: AttestationRefusal }
  | GoogleEnrolmentAttestationForOtherBytes
  | GoogleEnrolmentAttestKeyMismatch
  | GoogleEnrolmentAndroidUnrealized
  | GoogleEnrolmentRevokedKey
  | GoogleEnrolmentStoredMismatch { field: NonEmptyStr }
  | GoogleEnrolmentStoreUnreadable { detail: NonEmptyStr }

type GoogleApproverAdmission
  = GoogleApproverAdmitted { approver: VerifiedGoogleApprover }
  | GoogleApproverRefused { cause: GoogleEnrolmentRefusal }

fn email_on_roster(email: NonEmptyStr, roster: List<NonEmptyStr>) -> Bool {
  any(roster, e => (e as String) == (email as String))
}

// The fold over a supplied roster. Sealed to the production wrapper below and to the witness
// fixture that supplies its own roster; child A's enrol route joins the production wrapper's roster.
fn admit_google_approver_on_roster(
  roster: List<NonEmptyStr>,
  claims: OidcIdTokenClaims,
  signature: OidcIdTokenSignature,
  keys: GoogleEnrolmentKeys,
  observed_at: NumericDate,
) -> GoogleApproverAdmission
  admit_callers: [
    decl_ref(module_path: "gunbc.auth.approval_google_enrolment", decl_name: "admit_google_approver"),
    decl_ref(module_path: "test.claim.approval_google_enrolment_witness", decl_name: "fx_approver_admission"),
  ]
{
  match verify_oidc_id_token(claims: claims, signature: signature, policy: approval_google_enrolment_policy(transcript: google_enrolment_keys_transcript(k: keys), observed_at: observed_at)) {
    OidcIdTokenRefused { cause: c } => GoogleApproverRefused { cause: GoogleEnrolmentTokenRefused { cause: c } }
    OidcIdTokenVerified { claims: verified } =>
      if !audience_is_exactly_approve_ios(aud: verified.audience) {
        GoogleApproverRefused { cause: GoogleEnrolmentAudienceNotExact }
      } else if !authorized_party_admitted(azp: verified.azp) {
        GoogleApproverRefused { cause: GoogleEnrolmentAuthorizedPartyNotAdmitted }
      } else {
        match verified.standard.email {
          Absent => GoogleApproverRefused { cause: GoogleEnrolmentEmailAbsent }
          Present { value: email_value } =>
            let email = email_value as NonEmptyStr
            if !email_on_roster(email: email, roster: roster) {
              GoogleApproverRefused { cause: GoogleEnrolmentNotAnApprover { email: email } }
            } else {
              GoogleApproverAdmitted { approver: VerifiedGoogleApprover { email: email, subject: jwt_string_or_uri_wire(value: verified.subject), keys: keys } }
            }
        }
      }
  }
}

// THE PRODUCTION ADMISSION, on the one roster row. Its admit_callers roster is the witness wrapper
// today; child A's enrol route is the production caller it admits next (a declared frontier, named
// in gunbc.plans.approval_google_enrolment section 4).
fn admit_google_approver(claims: OidcIdTokenClaims, signature: OidcIdTokenSignature, keys: GoogleEnrolmentKeys, observed_at: NumericDate) -> GoogleApproverAdmission
  admit_callers: [
    decl_ref(module_path: "test.claim.approval_google_enrolment_witness", decl_name: "fx_production_approver_admission"),
  ]
{
  admit_google_approver_on_roster(roster: approval_google_approver_emails, claims: claims, signature: signature, keys: keys, observed_at: observed_at)
}

// ── STAGE 2: THE SUBJECT PIN, BEFORE ANY WRITE ─────────────────────────────────────────────────
// One create-once slot per approver email holds the Google subject of the first account that
// enrolled under it. The route attempts the create with the presented subject; if the CAS is lost
// (the slot exists, or a concurrent enrolment won it) it REREADS the slot. That observation is the
// only input here, and a write or a replay requires the carrier this stage mints, so two accounts
// racing under one address cannot both reach an enrolment: the loser rereads the winner's subject
// and refuses.
type SubjectPinCreateOrRead
  = SubjectPinCreatedForPresented
  | SubjectPinReread { subject: NonEmptyStr }
  | SubjectPinUnreadable { detail: NonEmptyStr }

type SubjectPinnedToPresentedSubject sole_constructor {
  approver: VerifiedGoogleApprover
}

type SubjectPinJoin
  = SubjectPinJoined { pinned: SubjectPinnedToPresentedSubject }
  | SubjectPinRefused { cause: GoogleEnrolmentRefusal }

fn join_subject_pin(approver: VerifiedGoogleApprover, observed: SubjectPinCreateOrRead) -> SubjectPinJoin {
  match observed {
    SubjectPinUnreadable { detail: d } => SubjectPinRefused { cause: GoogleEnrolmentStoreUnreadable { detail: d } }
    SubjectPinCreatedForPresented => SubjectPinJoined { pinned: SubjectPinnedToPresentedSubject { approver: approver } }
    SubjectPinReread { subject: pinned } =>
      if (pinned as String) == (approver.subject as String) {
        SubjectPinJoined { pinned: SubjectPinnedToPresentedSubject { approver: approver } }
      } else {
        SubjectPinRefused { cause: GoogleEnrolmentSubjectMismatch { email: approver.email } }
      }
  }
}

// ── STAGE 3: THE ENROLMENT ─────────────────────────────────────────────────────────────────────
// enrollment_id = hash(subject, decision key): the same Google subject with the same key is the
// same enrolment, so a resent POST lands on the same slot and is answered from it. A new key under
// the same subject is a new device, which is exactly what notifies the operator.
fn google_enrollment_id(subject: NonEmptyStr, decision_key: VerifyingKey) -> NonEmptyStr {
  let digest = sha256_b64url(text: framed(fields: [approval_google_enrolment_protocol as String, subject as String, decision_key.point_b64url as String]))
  join(["genr-", digest as String], "") as NonEmptyStr
}

type GoogleDeviceEnrollment sole_constructor {
  enrollment_id: NonEmptyStr
  google_subject: NonEmptyStr
  google_email: NonEmptyStr
  platform: MobilePlatform
  decision_key: VerifyingKey
  evidence: VerifiedPlatformEvidence
  enrolled_at: Timestamp
}

// The enrolment slot the route read at google_enrollment_id(subject, key): absent, enrolled
// (generation 1), or revoked (generation 2).
type GoogleEnrolmentSlot
  = GoogleEnrolmentAbsent
  | GoogleEnrolmentActive { enrollment: GoogleDeviceEnrollment }
  | GoogleEnrolmentRevoked { enrollment: GoogleDeviceEnrollment, revoked_at: Timestamp }
  | GoogleEnrolmentUnreadable { detail: NonEmptyStr }

// Write: a new enrolment, after which the route publishes the new-device notice. Replay: the stored
// enrolment IS this request's (every field joined below), answered with no write and no notice.
type GoogleEnrolmentAdmission
  = GoogleEnrolmentWrites { enrollment: GoogleDeviceEnrollment }
  | GoogleEnrolmentReplays { enrollment: GoogleDeviceEnrollment }
  | GoogleEnrolmentRefused { cause: GoogleEnrolmentRefusal }

fn stored_attest_key_id(e: GoogleDeviceEnrollment) -> String {
  match e.evidence {
    IosAttestedAppInstance { attest_key_id: k, attest_public_key_b64url: _, receipt_b64: _ } => k as String
    AndroidAttestedDecisionKey => ""
  }
}

// THE REPLAY JOIN: a stored record answers this request only if it is this request's enrolment in
// every field the request determines. The first field that disagrees is named, so a slot read at
// the wrong key or a record that drifted refuses rather than being echoed back.
fn stored_enrolment_disagreement(e: GoogleDeviceEnrollment, a: VerifiedGoogleApprover) -> NonEmptyStr? {
  if (e.enrollment_id as String) != (google_enrollment_id(subject: a.subject, decision_key: a.keys.decision_key) as String) { Present { value: "enrollment_id" as NonEmptyStr } }
  else if (e.google_subject as String) != (a.subject as String) { Present { value: "google_subject" as NonEmptyStr } }
  else if (e.google_email as String) != (a.email as String) { Present { value: "google_email" as NonEmptyStr } }
  else if (e.decision_key.point_b64url as String) != (a.keys.decision_key.point_b64url as String) { Present { value: "decision_key" as NonEmptyStr } }
  else if e.platform != a.keys.platform { Present { value: "platform" as NonEmptyStr } }
  else if stored_attest_key_id(e: e) != (a.keys.attest_key_id as String) { Present { value: "attest_key_id" as NonEmptyStr } }
  else { none }
}

fn google_enrolment_admission(
  pinned: SubjectPinnedToPresentedSubject,
  attestation: AttestationVerification,
  slot: GoogleEnrolmentSlot,
  observed_at: Timestamp,
) -> GoogleEnrolmentAdmission {
  let a = pinned.approver
  match a.keys.platform {
    MobileAndroid => GoogleEnrolmentRefused { cause: GoogleEnrolmentAndroidUnrealized }
    MobileIos =>
      match attestation {
        AttestationRefused { cause: r } => GoogleEnrolmentRefused { cause: GoogleEnrolmentAttestationRefused { cause: r } }
        AttestationVerified { verified: v } =>
          if (v.key_id as String) != (a.keys.attest_key_id as String) {
            GoogleEnrolmentRefused { cause: GoogleEnrolmentAttestKeyMismatch }
          } else if v.client_data != google_enrolment_keys_transcript(k: a.keys) {
            GoogleEnrolmentRefused { cause: GoogleEnrolmentAttestationForOtherBytes }
          } else {
            match slot {
              GoogleEnrolmentUnreadable { detail: d } => GoogleEnrolmentRefused { cause: GoogleEnrolmentStoreUnreadable { detail: d } }
              GoogleEnrolmentRevoked { enrollment: e, revoked_at: _ } =>
                match stored_enrolment_disagreement(e: e, a: a) {
                  Present { value: f } => GoogleEnrolmentRefused { cause: GoogleEnrolmentStoredMismatch { field: f } }
                  Absent => GoogleEnrolmentRefused { cause: GoogleEnrolmentRevokedKey }
                }
              GoogleEnrolmentActive { enrollment: e } =>
                match stored_enrolment_disagreement(e: e, a: a) {
                  Present { value: f } => GoogleEnrolmentRefused { cause: GoogleEnrolmentStoredMismatch { field: f } }
                  Absent => GoogleEnrolmentReplays { enrollment: e }
                }
              GoogleEnrolmentAbsent =>
                GoogleEnrolmentWrites {
                  enrollment: GoogleDeviceEnrollment {
                    enrollment_id: google_enrollment_id(subject: a.subject, decision_key: a.keys.decision_key),
                    google_subject: a.subject,
                    google_email: a.email,
                    platform: MobileIos,
                    decision_key: a.keys.decision_key,
                    evidence: IosAttestedAppInstance { attest_key_id: v.key_id, attest_public_key_b64url: v.public_key_point_b64url, receipt_b64: v.receipt_b64 },
                    enrolled_at: observed_at,
                  },
                }
            }
          }
      }
  }
}

// ── WHO MAY DECIDE, AND REVOCATION ─────────────────────────────────────────────────────────────
// Only an ACTIVE slot answers an enrolment to the redemption path. Revocation is one CAS from
// generation 1 to 2, issued by an authenticated dashboard session of a rostered approver; a revoked
// key cannot re-enrol (GoogleEnrolmentRevokedKey), so the phone must create a new key, sign in
// again, and the operator is notified of that device.
fn deciding_google_enrollment(slot: GoogleEnrolmentSlot) -> GoogleDeviceEnrollment? {
  match slot {
    GoogleEnrolmentActive { enrollment: e } => Present { value: e }
    GoogleEnrolmentAbsent => none
    GoogleEnrolmentRevoked { enrollment: _, revoked_at: _ } => none
    GoogleEnrolmentUnreadable { detail: _ } => none
  }
}

// THE NEW-DEVICE NOTICE: emitted only on GoogleEnrolmentWrites, never on a replay, so one device
// notifies once however often its POST is resent.
type NewDeviceNotice {
  enrollment_id: NonEmptyStr
  google_email: NonEmptyStr
  attest_key_id: AttestKeyId
  enrolled_at: Timestamp
}

fn new_device_notice(a: GoogleEnrolmentAdmission) -> NewDeviceNotice? {
  match a {
    GoogleEnrolmentWrites { enrollment: e } =>
      match e.evidence {
        IosAttestedAppInstance { attest_key_id: k, attest_public_key_b64url: _, receipt_b64: _ } =>
          Present { value: NewDeviceNotice { enrollment_id: e.enrollment_id, google_email: e.google_email, attest_key_id: k, enrolled_at: e.enrolled_at } }
        AndroidAttestedDecisionKey => none
      }
    GoogleEnrolmentReplays { enrollment: _ } => none
    GoogleEnrolmentRefused { cause: _ } => none
  }
}
