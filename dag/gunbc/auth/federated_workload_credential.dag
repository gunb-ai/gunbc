module gunbc.auth.federated_workload_credential

// THE ONE FEDERATED WORKLOAD CREDENTIAL MINT.
//
// A GitHub Actions job has no long-lived cloud key, so any gunbc entry that needs a short-lived Google
// access token reaches it the same three legs: the runner's OIDC sidecar mints an assertion for a
// workload audience, Cloud STS exchanges that assertion for a federated token, and
// `acquire_impersonated_access` impersonates one service account with one scope and one lifetime.
// `gunbc.heal_publication` grew those legs first; the printer needs the same ones now. Carrying them in
// two files would be the fork DESIGN forbids -- `gunbc.design_argument::single_authority`: the same
// federation decided twice, so the two drift the first time one is fixed. This module is the single
// home, and every workload that federates supplies its own row through `FederatedWorkloadCredentialMint`
// rather than re-encoding a leg.
//
// WHAT THE MINT DOES NOT DECIDE. It takes the ceiling seriously and first: the lifetime is admitted
// through `admit_token_lifetime` before ANY leg sends, so a request past the ordinary maximum never
// touches the sidecar, STS, or iamcredentials -- the guarantee that lives in
// `gunbc.heal_publication`'s comment on the admitted mint and that no caller may bypass. It does not
// pick a refusal's words: it returns the refusal of the leg that failed as a TYPED value, and each
// caller renders it in its own cause prefix (`heal_publication::rest_refusal_text` stays the one place
// that turns a `RestRefusal` into prose for heal-publish; the printer formats its own). That is what
// keeps this mint workload-neutral while the redaction witness still guards the exact text at each
// boundary. There is deliberately no dedicated-federation row and no provider here -- a mint authenticates
// to the runner's own Actions identity and impersonates a service account; it never manages an IAM
// federation configuration.
//
// HOW TO READ IT. `federated_workload_credential(mint:)` runs the ceiling and then, strictly in order,
// the two env reads that locate the runner's sidecar, the assertion, the exchange, and the impersonation.
// Each `Absent`/`RestRefused`/`ClockUnread` arm returns its refusal without evaluating a later one, so a
// leg is never reached out of order and never reached after it has already been refused.

import std.types { NonEmptyStr, String, Secret }
import std.measure { Second }
import std.algebra { trim }
import std.optional { Present, Absent }
import std.resources { Network }
import extdeps.shell
import extdeps.cloud.gcp.sts
import extdeps.cloud.gcp.gcp { ServiceAccountEmail }
import extdeps.cloud.gcp.iam {
  admit_token_lifetime,
  acquire_impersonated_access,
  GcpImpersonatedAccessCredential,
  GcpImpersonatedAccessAcquired,
  GcpImpersonatedAccessClockUnread,
  GcpImpersonatedAccessRefused,
}
import extdeps.github.actions { github_actions_runtime }
import extdeps.transports.rest { RestAnswered, RestRefused, RestRefusal }

// WHAT THE MINT NEEDS. One field per thing only the calling workload can say: which audience its
// assertion is minted for, which audience the exchange targets, which single service account it
// impersonates, the one scope the credential carries, and the lifetime asked for. There is no refusal
// prefix here: the mint renders no prose, so there is nothing for a prefix to belong to (adding one would
// be a declaration with no consumer, which `gunbc.design_argument::consumption` refuses).
type FederatedWorkloadCredentialMint {
  assertion_audience: NonEmptyStr,
  exchange_audience: NonEmptyStr,
  service_account: ServiceAccountEmail,
  scope: String,
  lifetime: Second,
}

// THE OUTCOME, one arm per decision the mint can stop at. The refusals carry the raw fact the failed leg
// reported (a `RestRefusal`, or the clock's own detail) so the caller can render it in its boundary's
// words; none of them carries a pre-formatted cause, because formatting belongs to the caller.
type FederatedWorkloadCredential
  = FederatedWorkloadCredentialMinted { credential: GcpImpersonatedAccessCredential }
  | FederatedWorkloadCredentialLifetimeBeyondOrdinary {}
  | FederatedWorkloadCredentialAssertionEndpointMissing {}
  | FederatedWorkloadCredentialAssertionAuthMissing {}
  | FederatedWorkloadCredentialAssertionRefused { refusal: RestRefusal }
  | FederatedWorkloadCredentialExchangeRefused { refusal: RestRefusal }
  | FederatedWorkloadCredentialClockUnread { detail: String }
  | FederatedWorkloadCredentialImpersonationRefused { refusal: RestRefusal }

// THE ONE ENV READ. Reads an environment value and treats an empty one as absent: a runner that exports
// ACTIONS_ID_TOKEN_REQUEST_URL="" is not a runner that has a sidecar, so the empty string must not reach
// the OIDC leg as if it were a URL. This is the single home; a workload that federates reads the sidecar
// coordinates through here rather than re-opening `shell.Env.Get` and re-deciding what "set" means.
fn env_value(name: NonEmptyStr) -> String? {
  match shell.Env.Get(name: name).value {
    Absent => none
    Present { value: raw } => if trim(s: raw) == "" { none } else { Present { value: trim(s: raw) } }
  }
}

fn federated_workload_credential(
  mint: FederatedWorkloadCredentialMint,
) -> FederatedWorkloadCredential uses net: Network, clk: std.resources.Clock
{
  // THE CEILING BEFORE ANY SEND. The lifetime is admitted through the API model's one checked constructor
  // first, so an over-long request is refused without touching the sidecar, STS, or iamcredentials; the
  // admitted value is the only lifetime that can reach `acquire_impersonated_access`, whose parameter is
  // the sealed `AccessTokenLifetime` whose sole constructor is `admit_token_lifetime`.
  match admit_token_lifetime(s: mint.lifetime) {
    Absent => FederatedWorkloadCredentialLifetimeBeyondOrdinary {}
    Present { value: lifetime } =>
      match env_value(name: github_actions_runtime.oidc_request_url_env) {
        Absent => FederatedWorkloadCredentialAssertionEndpointMissing {}
        Present { value: url } =>
          match env_value(name: github_actions_runtime.oidc_request_token_env) {
            Absent => FederatedWorkloadCredentialAssertionAuthMissing {}
            Present { value: request_token } =>
              match github.OIDC.GetToken(
                audience: mint.assertion_audience,
                request_url: url,
                request_token: request_token as Secret,
              ) {
                RestRefused { refusal } => FederatedWorkloadCredentialAssertionRefused { refusal: refusal }
                RestAnswered { answer } =>
                  // The `= Jwt`/`= RequestAccessToken` field defaults in `extdeps.cloud.gcp.sts` bind at
                  // the declaring module, so the omitted fields are byte-identical to spelling them.
                  match gcp.STS.Exchange(
                    subject_token: answer.subject_token,
                    audience: mint.exchange_audience,
                  ) {
                    RestRefused { refusal } => FederatedWorkloadCredentialExchangeRefused { refusal: refusal }
                    RestAnswered { answer: federated } =>
                      // THE IMPERSONATION GOES THROUGH THE API MODEL, not the bare operation:
                      // `acquire_impersonated_access` reads the clock before the send, decodes the
                      // response's own `expireTime` through the shared RFC 3339 parse, and hands back a
                      // credential whose validity is the issuer's statement. Calling
                      // `gcp.IAM.GenerateAccessToken` here would keep the token and throw the expiry away.
                      match acquire_impersonated_access(
                        source_token: federated.access_token,
                        target_service_account: mint.service_account,
                        scopes: [mint.scope],
                        lifetime: lifetime,
                      ) {
                        GcpImpersonatedAccessClockUnread { detail: d } =>
                          FederatedWorkloadCredentialClockUnread { detail: d }
                        GcpImpersonatedAccessRefused { refusal: refusal } =>
                          FederatedWorkloadCredentialImpersonationRefused { refusal: refusal }
                        GcpImpersonatedAccessAcquired { credential: issued } =>
                          FederatedWorkloadCredentialMinted { credential: issued }
                      }
                  }
              }
          }
      }
  }
}
