module gunbc.auth.private_secret_file

import std.types { Bool, FilePath, NonEmptyStr, PathSegment, Secret, String, path_segment_is_safe }
import std.algebra { trim }
import std.optional { Absent, Present }
import extdeps.shell
import extdeps.filesystem.filesystem_io { Filesystem }

// A SECRET A TRANSPORT CAN ONLY READ FROM A PATH, HELD FOR EXACTLY ONE BRACKET. Prefer a route with no
// file at all: a request body goes to curl on stdin (extdeps.bmc.http SetAccountPassword). This
// bracket is for the transports that offer no such route, such as curl --netrc-file, or a described
// command run through a host-effect transport with no stdin channel.
//
// ONE BRACKET, AND THE COPIES IT REPLACED ARE DELETED. Three realizations of this one rule had grown
// apart. gunbc.auth.materialized_secret with_materialized_ssh_key_file wrote owner-only and shredded
// the file, but left its private root behind and did not remove a partial file when the write
// failed. gunbc.auth.netrc_binding place_netrc_binding_privately plus shred_netrc_binding removed the
// file but left the mktemp directory behind. The BMC tools and the srv3 bmcweb login wrote fixed /tmp
// names and removed nothing. The mechanics now live here once: a fresh 0700 directory per call, the
// file created owner-only with O_EXCL (Filesystem.WriteOwnerOnly, never write-then-chmod), `use`
// called with the path, and then the file removed with `rm -f` and the directory with `rmdir`.
// with_materialized_ssh_key_file and place_netrc_binding_privately are deleted, their consumers call
// this bracket, and gunbc.auth.netrc_binding with_private_netrc_binding is this bracket with a netrc
// as the content.
//
// WHY THIS IS NOT INSIDE gunbc.auth.materialized_secret, the SshKeyFile leg's former home. That module
// owns the SecretRef lifecycle and imports gunbc.host.host_phase_status, whose closure reaches the
// fleet and host-standup models. Every holder of a file-only credential (a BMC tool, the printer,
// a witness) would inherit that closure; a witness that did so was measured past 15 GiB resident.
// The file leg needs only the shell and the filesystem, so it lives where those are its whole
// closure, and materialized_secret's bindings name this bracket as their file leg.
//
// THE DIRECTORY IS UNDER RUNNER_TEMP WHEN THAT IS SET, as the SshKeyFile leg's was, so a CI job's
// secret stays inside the space the runner owns and cleans; otherwise it is a plain `mktemp -d`.
//
// THE REMOVAL IS THE CHECK. rmdir succeeds only on an empty directory, so a removal that answers true
// means the directory and everything in it are gone. `rm -f` alone answers true for a path that never
// existed, so it could not say that.
//
// THE FOUR ARMS ARE FOUR REMEDIES. NotEntered: `use` never ran and nothing remains, so a retry is
// safe. NotEnteredResidueRemains: `use` never ran but material may remain, so clean up first.
// CompletedResidueRemains carries `use`'s result, because the effect has already happened (a password
// may have been changed, a session opened) and a caller that dropped the result could not say so.
// No arm carries the path: a path that dereferences to a secret is a secret locator, and the arm
// that most wants to print it is the one where the removal failed (see gunbc.auth.netrc_binding).
//
// WHAT THIS DOES NOT CLOSE: a process killed inside `use` reaches no removal
// (gunbc.recurring_failure_mode a_killed_run_leaves_its_credential_file_behind). The private
// directory bounds that residue to one run's 0700 directory rather than a shared fixed name.
type PrivateSecretFileBracket<R>
  = PrivateSecretFileCompleted { value: R }
  | PrivateSecretFileCompletedResidueRemains { value: R }
  | PrivateSecretFileNotEntered { cause: NonEmptyStr }
  | PrivateSecretFileNotEnteredResidueRemains { cause: NonEmptyStr }

fn private_secret_dir_created(success: Bool, path: FilePath) -> FilePath? {
  if success { Present { value: trim(s: path as String) as FilePath } } else { none }
}

fn create_private_secret_dir() -> FilePath? {
  match shell.Env.Get(name: "RUNNER_TEMP" as NonEmptyStr).value {
    Present { value: raw } =>
      if trim(s: raw) == "" {
        let d = shell.Mktemp.Dir()
        private_secret_dir_created(success: d.success, path: d.path)
      } else {
        let d = shell.Mktemp.DirWithTemplate(template: concat(trim(s: raw), "/gunbc-private.XXXXXX") as FilePath)
        private_secret_dir_created(success: d.success, path: d.path)
      }
    Absent => {
      let d = shell.Mktemp.Dir()
      private_secret_dir_created(success: d.success, path: d.path)
    }
  }
}

fn remove_private_secret_file(dir: FilePath, file: FilePath) -> Bool {
  let file_removed = shell.Remove.FileForce(path: file).success
  file_removed && shell.Remove.EmptyDirectory(path: dir).success
}

// THE FILE NAME IS ONE PATH SEGMENT, CHECKED BEFORE ANYTHING IS CREATED. The path is the private
// directory joined with the name, and the same path is what the write targets and what the
// removal rm -f's. A name of "../outside" would put the secret outside the 0700 directory, and if
// that file already existed the O_EXCL write would refuse and the failed-write cleanup would
// rm -f an unrelated file the caller named. PathSegment is the type, but the brand is a refined
// alias any module can mint with a cast (test.probe.branded_path_segment_forgery_probe), so the
// guard is std.types path_segment_is_safe, run here before the directory exists; an unsafe name
// refuses as NotEntered, and nothing is created, written or removed.
fn with_private_secret_file<R>(
  file_name: PathSegment,
  content: Secret,
  use: fn(NonEmptyStr) -> R,
) -> PrivateSecretFileBracket<R>
{
  if path_segment_is_safe(raw: file_name as String) == false {
    return PrivateSecretFileNotEntered {
      cause: "the secret file name is not one safe path segment, so nothing was created",
    }
  }
  match create_private_secret_dir() {
    Absent =>
      PrivateSecretFileNotEntered {
        cause: "no private directory could be created for the secret, so none was written",
      }
    Present { value: dir } => {
      let file = concat(dir as String, concat("/", file_name as String)) as FilePath
      if Filesystem.WriteOwnerOnly(path: file as String, content: content as String).success {
        let result = use(file as NonEmptyStr)
        if remove_private_secret_file(dir: dir, file: file) {
          PrivateSecretFileCompleted { value: result }
        } else {
          PrivateSecretFileCompletedResidueRemains { value: result }
        }
      } else if remove_private_secret_file(dir: dir, file: file) {
        PrivateSecretFileNotEntered {
          cause: "the owner-only file could not be created; any partial file and its private directory were removed, so no secret is on disk",
        }
      } else {
        PrivateSecretFileNotEnteredResidueRemains {
          cause: "the owner-only file could not be created AND it or its private directory could not be removed, so material may remain and requires cleanup",
        }
      }
    }
  }
}
