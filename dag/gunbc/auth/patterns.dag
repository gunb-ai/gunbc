module gunbc.auth.patterns


type AuthRuntime
  = GitHubActions { runtime: extdeps.github.actions.GitHubActionsRuntime }
  | GcpMetadata { runtime: extdeps.cloud.gcp.sts.MetadataRuntime }
  | LocalDev { runtime: extdeps.runtime.local.LocalDevRuntime }

type CredentialChainOutcome
  = CredentialChainReady { token: std.types.AccessToken }
  | CredentialChainWireDecodeRefused {
      identity_cause: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentityRefusal?
      payload_cause: extdeps.cloud.gcp.secret_manager.SmAccessVersionPayloadRefusal?
    }

pattern acquire_subject_token(
  runtime: AuthRuntime,
  audience: std.types.NonEmptyStr
) -> { token: Secret } {
  node token = match runtime {
    GitHubActions { runtime: github_actions } => github_oidc(audience: audience, runtime: github_actions)
    GcpMetadata { runtime: _ } => metadata_oidc(audience: audience)
    LocalDev { runtime: _ } => metadata_oidc(audience: audience)
  }
  return { token: token.token }
}

fn build_token(payload: Secret, scheme: std.types.AuthScheme, header_name: String, source_id: String, required_scopes: List<String>) -> std.types.AccessToken {
  { token: payload, scheme: scheme, expires_at: none }
}

pattern credential_chain(
  runtime: AuthRuntime,
  audience: std.types.NonEmptyStr,
  service_account: extdeps.cloud.gcp.gcp.ServiceAccountEmail?,
  secret_name: std.types.NonEmptyStr,
  project_id: extdeps.cloud.gcp.gcp.GcpProjectId,
  header_name: String?,
  source_id: std.types.NonEmptyStr,
  required_scopes: List<String>,
  lifetime_seconds: Int where range(min: 1, max: 3600)= 3600
) -> CredentialChainOutcome
  uses net: std.resources.Network

{
  node subject: acquire_subject_token(runtime: runtime, audience: audience)

  node access: gcp.STS.Exchange(
    subject_token: subject.token,
    audience: audience
  )

  node impersonated: optional_impersonation(
    access_token: access.access_token as Secret,
    service_account: service_account,
    lifetime_seconds: lifetime_seconds
  )

  node secret: gcp.SecretManager.AccessVersion(
    access_token: impersonated.token,
    project_id: project_id,
    secret: secret_name
  )

  return match decode_sm_access_version_wire_response(
    name: secret.name as String,
    data_b64: secret.data_b64
  ) {
    SmAccessVersionWireDecoded { identity: _, payload: payload } =>
      CredentialChainReady {
        token: build_token(
          payload: utf8_secret_from_access_payload(payload: payload),
          scheme: Bearer,
          header_name: header_name,
          source_id: source_id,
          required_scopes: required_scopes
        ),
      }
    SmAccessVersionWireDecodeRefused { identity_cause: identity_cause, payload_cause: payload_cause } =>
      CredentialChainWireDecodeRefused {
        identity_cause: identity_cause,
        payload_cause: payload_cause,
      }
  }
}

func github_oidc(audience: String, runtime: extdeps.github.actions.GitHubActionsRuntime) -> { token: Secret }
  uses net: std.resources.Network
{
  url = shell.Env.Get(name: runtime.oidc_request_url_env)
  auth = shell.Env.Get(name: runtime.oidc_request_token_env)

  response = github.OIDC.GetToken(
    audience: audience,
    request_url: url.value,
    request_token: auth.value
  )
  return { token: response.subject_token as String }
}

func metadata_oidc(audience: String) -> { token: Secret }
  uses net: std.resources.Network
{
  response = gcp.Metadata.GetIdentityToken(audience: audience)
  return { token: response.subject_token as String }
}
