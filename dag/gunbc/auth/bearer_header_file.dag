module gunbc.auth.bearer_header_file

import std.types { String, List }
import v2.std.node { Node }
import v2.extdeps.languages.bash_build {
  bash_build_command_with_words,
  bash_build_word_concat_from_nodes,
  bash_build_word_lit,
  bash_build_word_var,
  bash_build_with_redir_to_file
}

// The bearer-header file: how a workload-identity access token reaches an HTTP client as a
// header without becoming an argv word of any process. Consumed by the fleet key agent
// (gunbc.fleet.fleet_key_agent), the release-bins key fetch, the fabric blob shell and the CI
// preludes that remain in gunbc.ci.ci_spec. Moved out of gunbc.ci.ci_spec unchanged
// (gunbc.plans.closure_consolidation P1), so a consumer of the header rule no longer loads the
// whole CI composition.

// THE TOKEN IS WRITTEN BY A SHELL BUILTIN, AND THAT IS THE WHOLE MECHANISM. Both preludes below
// used `curl -H "Authorization: Bearer $WIF_ACCESS_TOKEN"`, which the shell expands BEFORE exec, so
// the GCP access token became a word in curl's argv — readable by any unprivileged `ps` for the
// life of the request. On these runners that audience is real: /proc carries no hidepid,
// /proc/PID/cmdline is mode 0444, and runner slots are ordinary host systemd services in the host
// pid namespace, so a job payload sees every process on the machine. curl reads a header from a
// file with `-H @FILE` (>=7.55; the runners carry 7.88), moving the value out of curl's argv.
// Writing the file with any EXTERNAL command would merely relocate the token into that command's
// argv; `printf` is a bash BUILTIN, forks nothing and creates no command line, so the token exists
// only in the shell's own memory and the file, never in any process table. The mode is set BEFORE
// the content exists: both preludes run `umask 077`, so the redirect creates the file 0600 at
// creation, with no window at a wider mode.
//
// THE TRAP IS NOT WHAT RETIRES THE TOKEN IN THE FLEET PRELUDE, and an earlier revision said it was
// ("Each prelude's existing trap removes HDR_FILE on exit alongside the other credential material
// it already cleans up"). That holds for the spark prelude, whose trap stays armed through step
// exit. It is FALSE for the fleet prelude, which DISARMS its trap (`trap - EXIT`) so the ssh-agent
// survives into later steps — after removing only KEY_FILE, so the bearer token was left in
// RUNNER_TEMP for the rest of the job. Moving the token out of argv and leaving it on disk is the
// same exposure at a different address; found in review of gunbc#9230 (review 56110).
//
// THE FIX IS LIFETIME, NOT CLEANUP. HDR_FILE is consumed by exactly one curl, so it is removed on
// the line after that curl rather than added to a later rm — the credential ceases to exist the
// moment its only consumer is done, a shorter window than any exit path offers and independent of
// which trap is armed at step end. The trap still covers the failure arm between creation and that
// removal, where the file can outlive the shell.
//
// WHAT IS NOT CLAIMED: this is a repair at two call sites, not a wall. Nothing refuses the next
// prelude that interpolates a credential into a command string — these bodies are hand-authored
// shell text, not declared operation argv, so std.operation_argv's binding wall cannot see them.
// The class stays mitigatable here; the trigger is the one extdeps.bmc.http names: credentials
// modeled as declared inputs whose type the binder can refuse.
//
// WHY THIS PAYLOAD IS SHELL TEXT AND WHAT WOULD CHANGE THAT (review 55857 asked for a bash-emit
// scaffold marker here; recorded rather than marked, because the marker would assert the wrong
// thing). This prelude is NOT the unmigrated medium-as-string form the two scaffolds in this module
// carry a dissolution trigger for — those mark *_script functions that concat-build a whole script,
// and their trigger text says so. gunbc_ci_fleet_key_agent_script builds a typed Pipeline of
// PipelineStep and emits it through v2.workflow.gunbc_invoke_step_emit, which IS the orchestration
// emit those triggers name as their terminal state; gunbc.fleet.fleet_ssh_credential_verify
// fleet_ssh_credential_shell_verification_supersession_note records that migration. Marking one
// command payload as a scaffold while its twenty peers in the same function carry none would claim
// this line is unmigrated debt when it sits in the migrated construction. The residue the review is
// right about: a Run's `command` is still shell text, corpus-wide, tracked by bash-emit rather than
// per line. No modeled actuator was available HERE because of a boundary, not a preference — this
// prelude executes as raw shell in a FOREIGN EXECUTOR (GitHub Actions `run:`) before gunbc runs at
// all, so Filesystem.WriteOwnerOnly, which this same change uses for the netrc on the BMC path, is
// unreachable at this point in a job. Choosing printf is not declining a modeled route; there is
// none on that side of the boundary yet, which is exactly what bash-emit would change.
// The bearer-header format, one row for the string-built runners and the bash_build one.
data gunbc_ci_auth_header_format: String = "Authorization: Bearer %s\\n"

fn gunbc_ci_auth_header_file_write_command() -> String {
  gunbc_ci_auth_header_file_write_command_to(header_file: "HDR_FILE")
}

/// The same write into a caller-named header file, so a step whose file is not `$HDR_FILE` still
/// takes the header from `gunbc_ci_auth_header_format` rather than re-spelling it.
fn gunbc_ci_auth_header_file_write_command_to(header_file: String) -> String {
  join(["printf '", gunbc_ci_auth_header_format, "' \"$WIF_ACCESS_TOKEN\" > \"$", header_file, "\""], "")
}

// THE SAME RULE AS A NODE BUILDER, so a step assembled from bash_build nodes takes the same
// authority as a string-built one: the header reaches its file through the shell's own printf
// builtin — a builtin forks nothing, so the token never becomes an argv word of any process — and
// the consumer reads it back with `-H @<file>`. A caller takes the pair: the write statement
// before the consumer, and the argument pair where the consumer's '-H' word belongs. Removal is
// the caller's, because only the caller knows both outcomes of its own fetch.
fn gunbc_ci_auth_header_file_write_statement(header_path: Node, token_env: String) -> Node {
  bash_build_with_redir_to_file(
    inner: bash_build_command_with_words(words: [
      bash_build_word_lit(text: "printf"),
      bash_build_word_lit(text: gunbc_ci_auth_header_format),
      bash_build_word_var(name: token_env),
    ]),
    path: header_path,
  )
}

fn gunbc_ci_auth_header_file_args(header_path: Node) -> List<Node> {
  [
    bash_build_word_lit(text: "-H"),
    bash_build_word_concat_from_nodes(parts: [bash_build_word_lit(text: "@"), header_path]),
  ]
}
