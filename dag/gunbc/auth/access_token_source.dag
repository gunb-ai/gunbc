module gunbc.auth.access_token_source

import std.types { Secret, NonEmptyStr, Bool, String }
import std.resources { Network }
import std.upsert_decision {
  Absent,
  Apply,
  Converged,
  Noop,
  Refuse,
  UnknownRefused,
  UpsertClassification,
}
import extdeps.shell
import extdeps.cloud.gcp.gcp

type AccessTokenSource
  = GcloudPrintToken
  | OperatorSuppliedToken { token: Secret }

type GoogleCloudInteractiveAuthenticationRequired {}

type AccessEnsurePlan = GoogleCloudInteractiveAuthenticationRequired

type AccessTokenResolution
  = AccessTokenReady { token: Secret }
  | AccessTokenUpsertRequired { plan: AccessEnsurePlan }
  | AccessTokenEnsureRefused { reason: NonEmptyStr }

data gcloud_human_auth_pause_note: String = "Human gcloud authentication is the current REALIZER of an access ENSURE upsert, never a fleet phase or unconditional preflight. A selected operation first has to require a Secret Manager read/write; that effect requires an access token; only then does GcloudPrintToken OBSERVE the access capability. A successful print classifies Converged/Noop and continues without exposing the token. A missing or expired session classifies Absent/Apply(GoogleCloudInteractiveAuthenticationRequired), and re-driving after the upsert resumes the same operation. OperatorSuppliedToken remains an explicit compatibility handler. A future workload-identity/OAuth handler can realize the same ensure without changing BMC convergence."

data ensure_access_token_eager_bootstrap_fork_dissolve_on: String = "🟡 dissolve-on: gunbc.assimilate.bmc_bootstrap_provision bmc_bootstrap_provision_srv3 still eagerly calls shell.GCloud.AuthPrintAccessToken() at node auth (pre-existing, out of #7423 scope) — a second §3 authority beside ensure_access_token for the same access-token concept. DISSOLVES WHEN bootstrap provision acquires tokens only through ensure_access_token(source: GcloudPrintToken) (or a typed wrapper that routes through it) and deletes the direct shell.GCloud node."

fn gcloud_auth_print_access_token_is_auth_deficit(stderr: String) -> Bool {
  string_contains(s: stderr, pattern: "Reauthentication")
    || string_contains(s: stderr, pattern: "not currently have an active account")
    || string_contains(s: stderr, pattern: "Could not load the default credentials")
    || string_contains(s: stderr, pattern: "default credentials were not found")
    || string_contains(s: stderr, pattern: "invalid_grant")
    || string_contains(s: stderr, pattern: "RefreshError")
    || string_contains(s: stderr, pattern: "not logged in")
}

fn gcloud_access_ensure_refusal_reason(stderr: String) -> NonEmptyStr {
  if string_length(s: stderr) > 0 {
    stderr as NonEmptyStr
  } else {
    "gcloud auth print-access-token failed without observable authentication deficit" as NonEmptyStr
  }
}

fn gcloud_access_ensure_classification(
  success: Bool,
  stderr: String,
) -> UpsertClassification<AccessEnsurePlan> {
  if success {
    UpsertClassification {
      verdict: Converged,
      decision: Noop,
    }
  } else if gcloud_auth_print_access_token_is_auth_deficit(stderr: stderr) {
    UpsertClassification {
      verdict: Absent,
      decision: Apply {
        plan: GoogleCloudInteractiveAuthenticationRequired {},
      },
    }
  } else {
    UpsertClassification {
      verdict: UnknownRefused,
      decision: Refuse {
        reason: gcloud_access_ensure_refusal_reason(stderr: stderr),
      },
    }
  }
}

fn gcloud_access_token_resolution(
  success: Bool,
  stderr: String,
  token: Secret,
) -> AccessTokenResolution {
  match gcloud_access_ensure_classification(success: success, stderr: stderr) {
    UpsertClassification { verdict: _, decision: Noop } =>
      AccessTokenReady { token: token }
    UpsertClassification { verdict: _, decision: Apply { plan: plan } } =>
      AccessTokenUpsertRequired { plan: plan }
    UpsertClassification { verdict: _, decision: Refuse { reason: reason } } =>
      AccessTokenEnsureRefused { reason: reason }
  }
}

fn access_token_upsert_required_reason(plan: AccessEnsurePlan) -> String {
  match plan {
    GoogleCloudInteractiveAuthenticationRequired {} =>
      "access ensure requires Google Cloud interactive authentication by a human operator authorized for the fleet secrets project"
  }
}

func ensure_access_token(source: AccessTokenSource) -> AccessTokenResolution
  uses net: Network
{
  match source {
    GcloudPrintToken => {
      let printed = shell.GCloud.AuthPrintAccessToken()
      gcloud_access_token_resolution(
        success: printed.success,
        stderr: printed.stderr,
        token: printed.access_token,
      )
    }
    OperatorSuppliedToken { token: t } => AccessTokenReady { token: t }
  }
}
