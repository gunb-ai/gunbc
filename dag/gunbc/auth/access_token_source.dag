module gunbc.auth.access_token_source

import std.dissolution { DissolutionCondition, unbound_dissolution }

import std.types { Secret, NonEmptyStr, Bool, String }
import std.algebra { trim }
import std.resources { Network }
import std.upsert_decision {
  Absent,
  Apply,
  Converged,
  Noop,
  Refuse,
  UnknownRefused,
  UpsertClassification,
}
import extdeps.shell
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.cloud.gcp.auth_print_access_token {
  gcloud_stderr_auth_deficit,
}

type AccessTokenSource
  = GcloudPrintToken
  | OperatorSuppliedToken { token: Secret }
  | WorkloadIdentityToken

type GoogleCloudInteractiveAuthenticationRequired {}

type AccessEnsurePlan = GoogleCloudInteractiveAuthenticationRequired

type AccessTokenResolution
  = AccessTokenReady { token: Secret }
  | AccessTokenUpsertRequired { plan: AccessEnsurePlan }
  | AccessTokenEnsureRefused { reason: NonEmptyStr }

// Human gcloud authentication is the current REALIZER of an access ENSURE upsert, never a fleet
// phase or unconditional preflight. A selected operation first has to require a Secret Manager
// read/write; that effect requires an access token; only then does GcloudPrintToken OBSERVE the
// access capability. A successful print classifies Converged/Noop and continues without exposing
// the token. A missing or expired session classifies
// Absent/Apply(GoogleCloudInteractiveAuthenticationRequired) only when stderr carries an observed
// authentication deficit; missing binary, network, or other infrastructure failures classify Refuse
// with the stderr detail preserved. Re-driving after the upsert resumes the same operation.
// OperatorSuppliedToken remains an explicit compatibility handler. WorkloadIdentityToken is the
// third realizer of the same ensure -- added, not planned -- and it changed no BMC convergence,
// which is the property this paragraph predicted and the arm below now executes.

// THE WORKLOAD ARM EXISTS SO A TYPED EFFECT CAN RUN IN CI AT ALL. Until it landed this coproduct
// had exactly two arms, both operator-shaped: GcloudPrintToken needs an interactive human session
// and OperatorSuppliedToken needs a human to have put a token somewhere. So every typed
// gcp.SecretManager.* effect in the tree was unreachable from a workflow run, and CI reached Secret
// Manager the only way left to it -- hand-written shell preludes that curl the REST API with the
// WIF step's token. That is one fact with two realizations (§3): the modeled effect and the
// prelude answer the same question, and only the prelude ever runs.
//
// This arm is the missing realization, not a new capability. GitHub OIDC -> Workload Identity
// Federation already gives the run a GCP identity and the workflow already exports the access token
// it mints; what was absent was any way for ensure_access_token to SAY so. With the arm present the
// typed effects run under the run's own identity, and the preludes have somewhere to dissolve into.
//
// THE TOKEN ARRIVES BY VALUE HERE, AND THAT IS A DEPARTURE WORTH STATING. The OperatorSuppliedToken
// realizer below takes its token by PATH because an environment variable holding a secret leaks into any
// diagnostic that dumps the environment. That rule is not relaxed: the hazard it was written against
// is argv and receipts, and gunbc.credential_argv_exposure measures the concrete incident -- a
// `curl -H "Authorization: Bearer $WIF_ACCESS_TOKEN"` whose shell expansion put the token in a
// runner-readable argv word. This arm reads the variable in-process and passes a Secret; it never
// interpolates it into a command line. The variable is set by the WIF auth step and its lifetime is
// the job, so the value is already in the job environment whatever this module does -- reading it
// here removes an argv exposure rather than creating an environment one.
data workload_identity_token_env: NonEmptyStr = "WIF_ACCESS_TOKEN" as NonEmptyStr

// PURE, so the arms are witnessable without an environment. An absent variable and an empty one are
// two different operator situations -- the workflow did not run the auth step, versus the auth step
// ran and produced nothing -- and collapsing them to one message would send the reader to the wrong
// half of the workflow.
fn workload_identity_token_resolution(present: Bool, raw: String) -> AccessTokenResolution {
  if present == false {
    AccessTokenEnsureRefused {
      reason: join([
        "no ", workload_identity_token_env as String,
        " in the environment: this run has no workload identity token, so the Workload Identity Federation auth step did not run or did not export one. Refusing rather than falling back to an operator credential, which a workflow run must never hold.",
      ], "") as NonEmptyStr,
    }
  } else {
    let token = trim(s: raw)
    if token == "" {
      AccessTokenEnsureRefused {
        reason: join([
          workload_identity_token_env as String,
          " is set but empty: the Workload Identity Federation auth step ran and exported no token, which is never a usable bearer token.",
        ], "") as NonEmptyStr,
      }
    } else {
      AccessTokenReady { token: token as Secret }
    }
  }
}

fn gcloud_access_ensure_refusal_reason(stderr: String) -> NonEmptyStr {
  if string_length(s: stderr) > 0 {
    stderr as NonEmptyStr
  } else {
    "gcloud auth print-access-token failed without observable authentication deficit" as NonEmptyStr
  }
}

fn gcloud_access_ensure_classification(
  success: Bool,
  stderr: String,
) -> UpsertClassification<AccessEnsurePlan> {
  if success {
    UpsertClassification {
      verdict: Converged,
      decision: Noop,
    }
  } else {
    match gcloud_stderr_auth_deficit(stderr: stderr) {
      Present { value: _ } =>
        UpsertClassification {
          verdict: Absent,
          decision: Apply {
            plan: GoogleCloudInteractiveAuthenticationRequired {},
          },
        }
      Absent =>
        UpsertClassification {
          verdict: UnknownRefused,
          decision: Refuse {
            reason: gcloud_access_ensure_refusal_reason(stderr: stderr),
          },
        }
    }
  }
}

fn gcloud_access_token_resolution(
  success: Bool,
  stderr: String,
  token: Secret,
) -> AccessTokenResolution {
  match gcloud_access_ensure_classification(success: success, stderr: stderr) {
    UpsertClassification { verdict: _, decision: Noop } =>
      AccessTokenReady { token: token }
    UpsertClassification { verdict: _, decision: Apply { plan: plan } } =>
      AccessTokenUpsertRequired { plan: plan }
    UpsertClassification { verdict: _, decision: Refuse { reason: reason } } =>
      AccessTokenEnsureRefused { reason: reason }
  }
}

fn access_token_upsert_required_reason(plan: AccessEnsurePlan) -> String {
  match plan {
    GoogleCloudInteractiveAuthenticationRequired {} =>
      "access ensure requires Google Cloud interactive authentication by a human operator authorized for the fleet secrets project"
  }
}

func ensure_access_token(source: AccessTokenSource) -> AccessTokenResolution
  uses net: Network
{
  match source {
    GcloudPrintToken => {
      let printed = shell.GCloud.AuthPrintAccessToken()
      gcloud_access_token_resolution(
        success: printed.success,
        stderr: printed.stderr,
        token: printed.access_token,
      )
    }
    OperatorSuppliedToken { token: t } => AccessTokenReady { token: t }
    WorkloadIdentityToken =>
      match shell.Env.Get(name: workload_identity_token_env).value {
        Absent => workload_identity_token_resolution(present: false, raw: "")
        Present { value: raw } => workload_identity_token_resolution(present: true, raw: raw)
      }
  }
}

data ensure_access_token_eager_bootstrap_fork_dissolve_on: DissolutionCondition = unbound_dissolution(description: "🟡 dissolve-on: gunbc.assimilate.bmc_bootstrap_provision bmc_bootstrap_provision_srv3 still eagerly calls shell.GCloud.AuthPrintAccessToken() at node auth (pre-existing, out of #7423 scope) — a second §3 authority beside ensure_access_token for the same access-token concept. DISSOLVES WHEN bootstrap provision acquires tokens only through ensure_access_token(source: GcloudPrintToken) (or a typed wra")

// THE TOKEN ARRIVES BY PATH, NEVER BY VALUE, for the reason gunbc.spark.grant_privileged_operation
// spark_grant_credential_path_env states: an environment
// variable holding a SECRET leaks into any diagnostic that dumps the environment, and this
// repository's receipts do dump argv. A token is a bearer credential for the whole project, so it
// gets the administrator password's treatment: the environment carries a PATH, the file carries
// the bytes, and the value never reaches argv or a receipt.
//
// THIS IS THE REALIZER OF THE OperatorSuppliedToken ARM, AND IT NOW LIVES BESIDE THE ARM. It was
// authored in gunbc.auth.gcp_secret_access, whose own annotation said it "realizes the
// OperatorSuppliedToken arm, which gunbc.auth.access_token_source already carries" -- a realizer
// one module away from the coproduct it inhabits, which is why every entry that wanted an operator
// token imported it from the GRANT ENSURE's module to build a source the ensure never sees. The
// consequence was mechanical: eight entry points each re-authored read_supplied_access_token() ->
// OperatorSuppliedToken, so no run could resolve any OTHER arm, and the workload arm below was
// unreachable from every one of them. With the realizer here, select_access_token_source is
// authorable at all.
//
// It lets a token arrive where gcloud does not exist -- a container, a CI runner -- rather than
// only on a workstation.
data secret_access_token_path_env: NonEmptyStr = "GUNBC_GCP_ACCESS_TOKEN_FILE" as NonEmptyStr

type SuppliedTokenResolution
  = SuppliedTokenReady { token: Secret }
  | SuppliedTokenUnavailable { cause: NonEmptyStr }

fn classify_supplied_token(success: Bool, error: String, content: String) -> SuppliedTokenResolution {
  if success == false {
    SuppliedTokenUnavailable {
      cause: join(["the access token file could not be read: ", error], "") as NonEmptyStr,
    }
  } else {
    let token = trim(s: content)
    if token == "" {
      SuppliedTokenUnavailable {
        cause: "the access token file is empty, which is never a usable bearer token" as NonEmptyStr,
      }
    } else {
      SuppliedTokenReady { token: token as Secret }
    }
  }
}

func read_supplied_access_token() -> SuppliedTokenResolution {
  match shell.Env.Get(name: secret_access_token_path_env).value {
    Absent =>
      SuppliedTokenUnavailable {
        cause: join([
          "no ", secret_access_token_path_env as String,
          " in the environment: this entry needs a path to a file holding an access token",
        ], "") as NonEmptyStr,
      }
    Present { value: raw } => {
      let path = trim(s: raw)
      if path == "" {
        SuppliedTokenUnavailable {
          cause: join([
            secret_access_token_path_env as String, " is set but empty, which is not a path",
          ], "") as NonEmptyStr,
        }
      } else {
        let read = Filesystem.Read(path: path)
        classify_supplied_token(success: read.success, error: read.error, content: read.content)
      }
    }
  }
}

// ── WHICH ARM A RUN HAS, DECIDED ONCE ────────────────────────────────────────────────────────
// THE SELECTION IS THE FACT THAT WAS MISSING, NOT THE ARMS. ensure_access_token has carried three
// realizers for some time, and no entry point in the tree could reach more than one of them,
// because every entry chose its arm by CONSTRUCTION: read_supplied_access_token() then
// OperatorSuppliedToken, spelled at eight call sites. An arm chosen at the call site is not a
// selection, it is a binding, so a workflow run and a workstation run of the same entry were two
// different programs and only one of them existed.
//
// This fold is the selection. It reads the environment the run is actually in and names the arm
// that environment supports, and every entry that wants "whatever credential this run has" calls
// it instead of re-deriving one. GcloudPrintToken is deliberately NOT reachable from here: it is
// an INTERACTIVE authentication, correct for an operator ceremony that binds itself by name (see
// gunbc.spark.secret_access_ensure spark_secret_access_converge), and an automatic fold that could
// fall back to it would make an unattended run block on a human prompt it cannot answer.
//
// THE WORKLOAD ARM WINS ON PRESENCE, NOT ON SUCCESS, and that is what keeps this fail-closed (§5).
// WIF_ACCESS_TOKEN is exported by the Workload Identity Federation auth step and by nothing else,
// so its presence IS the statement "this is a federated workflow run". If it is present and empty
// the run refuses through the workload arm rather than reaching for an operator file: a workflow
// run must never resolve an operator credential, and a fallback here would be the absorbing
// fallback -- a broken federation silently answered by whatever else happened to be on the runner.
type AccessTokenSourceSelection
  = AccessTokenSourceSelected { source: AccessTokenSource }
  | AccessTokenSourceUnavailable { cause: NonEmptyStr }

fn no_access_token_source_cause() -> NonEmptyStr {
  join([
    "this run has no access token source: neither ", workload_identity_token_env as String,
    " (set by the Workload Identity Federation auth step of a federated workflow run) nor ",
    secret_access_token_path_env as String,
    " (a path to a file holding an operator access token) is in the environment. A workflow run is missing its auth step; a session run needs an operator token written to a file and that variable set to its path.",
  ], "") as NonEmptyStr
}

func select_access_token_source() -> AccessTokenSourceSelection {
  match shell.Env.Get(name: workload_identity_token_env).value {
    Present { value: _ } => AccessTokenSourceSelected { source: WorkloadIdentityToken }
    Absent =>
      match shell.Env.Get(name: secret_access_token_path_env).value {
        Absent => AccessTokenSourceUnavailable { cause: no_access_token_source_cause() }
        Present { value: _ } =>
          match read_supplied_access_token() {
            SuppliedTokenUnavailable { cause: c } => AccessTokenSourceUnavailable { cause: c }
            SuppliedTokenReady { token: t } =>
              AccessTokenSourceSelected { source: OperatorSuppliedToken { token: t } }
          }
      }
  }
}
