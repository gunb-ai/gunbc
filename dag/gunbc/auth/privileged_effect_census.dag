  PrivilegedEffect, ProviderSurface, ApiSurface, HumanSurfaceOnly,
  WorkloadIdentityStanding, WorkloadIdentityBindable, WorkloadIdentityUnbindable,
  MintsNoCredential, MintsResourceScopedCredential, MintsAccountWideCredential,
  ReversibleByReapply, IrreversibleEffect,
