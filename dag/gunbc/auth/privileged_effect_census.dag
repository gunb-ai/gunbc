  // THE TWO IN-BAND RECOVERY WRITES (gunbc.machine_intake.bmc_recovery_route). A locked BMC is
  // brought back by two writes made from the machine's own rescue OS, and both are classified here
  // rather than described in prose: the temporary Administrator password that makes an authenticated
  // in-band session possible, and the ResetToDefaults that wipes the unknown password. The reset is
  // the destructive half -- ResetAll returns every account, every password and the user table to
  // factory state on a board being inducted. Both rows realize the operator-approved capability, but for
  // DIFFERENT forces that each row states in its own profile: the reset by its irreversibility, the
  // password write by the credential it brings into existence and cannot withdraw by reapplying. Neither
  // row is claiming a pattern the other's effect forced. recovery_reset_operator_ruling states the ruling
  // the run acts under; the recovery route refuses its handoff without the post-reset readback (its own
  // domain law), so neither row can realize a pattern its effect rules out.
  PrivilegedEffectSite {
    site: site(module_path: "gunbc.machine_intake.bmc_recovery_route", decl_name: "admit_recovery_in_band_password_write"),
    effect: recovery_in_band_set_user_password_effect(),
    realized: RealizedApprovalCapability,
    divergence_reason: none,
  },
  PrivilegedEffectSite {
