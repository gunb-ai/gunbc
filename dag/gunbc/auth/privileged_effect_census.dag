// ── EVERY PRIVILEGED-EFFECT SITE IN dag/, CLASSIFIED BY EXECUTING THE SELECTION ──────────────
//
// THE VERDICT IS DERIVED, NOT AUTHORED. Each row supplies the site (module and symbol), the
// effect's characteristics, and what the site REALIZES today; the fold runs
// gunbc.auth.authorization_pattern_selection over the characteristics and compares. A row's author
// may state a reason for a divergence; the author may not state the verdict. That is §3b's
// three-valued answer made mechanical: conforms when the realized pattern is the selected one;
// diverges-with-reason when they differ and the row says why; diverges when they differ and the
// row is silent. Only the third is red, and the witness makes it red.
//
// THE POPULATION IS THE SITES THAT CHOOSE A CREDENTIAL. Kernels parameterized by a token source
// (gunbc.auth.gcp_secret_access secret_access_ensure_for, gunbc.auth.secret_ref_credential
// fetch_secret_ref_credential, gunbc.auth.secret_rotation, gunbc.secret_provision_actuator,
// gunbc.fleet.fleet_printer_access) choose nothing and are not rows; the entries that bind their
// token_source are. Module names below were read from each file's `module` line, not from its path
// (gunbc.fleet.fleet_printer_access lives under dag/gunbc/fleet/ and is not gunbc.fleet.*).
//
// COMPLETENESS IS NOT CLAIMED BY THIS ROSTER. The population was enumerated by grepping every
// gcp.SecretManager.*, gcp.STS.*, gcp.IAM.*, shell.GCloud.*, cloudflare.AccountTokens.* and
// access_token_source consumer in dag/ on 2026-09-19; a discovery join that refuses an unrostered
// site is the next rung, and it is the same trigger gunbc.host_convergence_census names for itself.

// WHAT A SITE REALIZES TODAY, read off its token-source binding.
//   RealizedRunSelected -- gunbc.auth.access_token_source select_access_token_source /
//     resolve_access_token: the federated arm in a dispatched run, the operator's file in a session.
//     Classified as the federated pattern, because that is the arm that executes unattended and the
//     file arm is the operator's own workstation realization of the same entry.
//   RealizedUnauthorized -- the site performs the effect under no credential that names it: the
//     write reaches its store on the executor's host access alone. It matches no pattern, so a row
//     realizing it is red unless it states why and what retires the reason.
type OperatorSessionArm
  = GcloudInteractive
  | OperatorTokenFile

type RealizedAuthorization
  = RealizedFederatedGrant
  | RealizedRunSelected
  | RealizedApprovalCapability
  | RealizedHumanStep
  | RealizedAdministratorEdge
  | RealizedOperatorSession { arm: OperatorSessionArm }
  | RealizedUnauthorized

// A REASON IS A STATEMENT PLUS THE CONDITION UNDER WHICH IT STOPS BEING ONE. A bare string moved a
// site out of the debt roster for as long as anyone left it there (review 68720): no bound, no
// trigger, nothing joined to anything. The trigger is the whole content of a reason (§4b(3): a drop
// is retired by its trigger and by nothing else), so it is carried in std.dissolution's vocabulary.
// A bound trigger names a declaration whose retirement fires it; the required floor refuses a
// decl_ref to a declaration that does not exist (CITED-DECLARATION-ABSENT), so deleting the
// trigger's subject fails this module at the gate rather than leaving a fired reason standing. An unbound trigger names the CAPABILITY that would retire it, because a
// forward citation to a declaration nobody has written is the fabricated-citation class the floor
// refuses, and that is the honest shape for an adapter that does not exist yet.
type DivergenceReason {
  statement: NonEmptyStr
  dissolution: DissolutionCondition
}

type PrivilegedEffectSite {
  site: DeclarationRef
  effect: PrivilegedEffect
  realized: RealizedAuthorization
  divergence_reason: DivergenceReason?
}

type SiteConformance
  = Conforms
  | DivergesWithReason { reason: DivergenceReason }
  | Diverges
  | SiteNotDecidable { standing: AuthorizationPatternSelection }

type SiteVerdict {
  site: DeclarationRef
  selection: AuthorizationPatternSelection
  conformance: SiteConformance
}

fn realized_matches(selected: AuthorizationPattern, realized: RealizedAuthorization) -> Bool {
  match selected {
    FederatedScopedGrant =>
      match realized {
        RealizedFederatedGrant => true
        RealizedRunSelected => true
        RealizedApprovalCapability => false
        RealizedHumanStep => false
        RealizedOperatorSession { arm: _ } => false
        RealizedUnauthorized => false
        RealizedAdministratorEdge => false
      }
    OperatorApprovedCapability =>
      match realized {
        RealizedApprovalCapability => true
        RealizedFederatedGrant => false
        RealizedRunSelected => false
        RealizedHumanStep => false
        RealizedOperatorSession { arm: _ } => false
        RealizedUnauthorized => false
        RealizedAdministratorEdge => false
      }
    HumanOnlyStep { step: _ } =>
      match realized {
        RealizedHumanStep => true
        RealizedFederatedGrant => false
        RealizedRunSelected => false
        RealizedApprovalCapability => false
        RealizedOperatorSession { arm: _ } => false
        RealizedUnauthorized => false
        RealizedAdministratorEdge => false
      }
    AdministratorEdge =>
      match realized {
        RealizedAdministratorEdge => true
        RealizedFederatedGrant => false
        RealizedRunSelected => false
        RealizedApprovalCapability => false
        RealizedHumanStep => false
        RealizedOperatorSession { arm: _ } => false
        RealizedUnauthorized => false
      }
    OperatorOwnSession =>
      match realized {
        RealizedOperatorSession { arm: _ } => true
        RealizedFederatedGrant => false
        RealizedRunSelected => false
        RealizedApprovalCapability => false
        RealizedHumanStep => false
        RealizedUnauthorized => false
        RealizedAdministratorEdge => false
      }
  }
}

fn divergence(row: PrivilegedEffectSite) -> SiteConformance {
  match row.divergence_reason {
    Present { value: r } => DivergesWithReason { reason: r }
    Absent => Diverges
  }
}

fn site_conformance(row: PrivilegedEffectSite, selection: AuthorizationPatternSelection) -> SiteConformance {
  match selection {
    PatternSelected { pattern: p, receipt: _ } =>
      if realized_matches(selected: p, realized: row.realized) { Conforms } else { divergence(row: row) }
    ManualStepRequired { step: s, receipt: _ } =>
      if realized_matches(selected: HumanOnlyStep { step: s }, realized: row.realized) { Conforms } else { divergence(row: row) }
    NoAdmissiblePattern { causes: _, scope: _ } => SiteNotDecidable { standing: selection }
    PatternSelectionNeedsEvidence { needs: _ } => SiteNotDecidable { standing: selection }
    PatternSelectionNeedsPolicy { survivors: _ } => SiteNotDecidable { standing: selection }
    PatternSelectionRefused { defects: _ } => SiteNotDecidable { standing: selection }
  }
}

fn site_verdict(row: PrivilegedEffectSite) -> SiteVerdict {
  let selection = select_authorization_pattern(e: row.effect)
  SiteVerdict { site: row.site, selection: selection, conformance: site_conformance(row: row, selection: selection) }
}

// ── Shared characteristics ───────────────────────────────────────────────────────────────────
fn site(module_path: String, decl_name: String) -> DeclarationRef {
  decl_ref(module_path: module_path, decl_name: decl_name)
}

// THE MEMBER IS RESOLVED FROM THE STANDING, never spelled: an unallocated principal is an
// unbindable identity, which is the truthful input to the selection rather than a member string
// that cannot exist (the same refusal gunbc.auth.gcp_secret_access makes before writing a policy).
fn convergence_principal() -> WorkloadIdentityStanding {
  match fleet_cloud_principal_standing() {
    CloudPrincipalAllocated { principal: _, member: m, readback: _ } => WorkloadIdentityBindable { member: m as NonEmptyStr }
    CloudPrincipalReported { principal: _, reported_member: m, source: _ } => WorkloadIdentityBindable { member: m as NonEmptyStr }
    CloudPrincipalUnallocated { principal: _ } =>
      WorkloadIdentityUnbindable { cause: "no allocated member is recorded for the fleet cloud principal" as NonEmptyStr }
  }
}

// THE GRANT ADMINISTRATOR IS UNBINDABLE BY CONSTRUCTION, not by omission: a principal that can both
// grant and read escalates itself to every secret in the project.
data grant_administrator_unbindable: WorkloadIdentityStanding = WorkloadIdentityUnbindable {
  cause: "setIamPolicy is FleetCloudGrantAdministrator's operation and the workload may not hold it (gunbc.spark.bootstrap_provision no_principal_can_both_grant_and_read)" as NonEmptyStr,
}

// A credential READ that a converge performs every time it runs.
fn recurring_credential_read(subject: NonEmptyStr) -> PrivilegedEffect {
  PrivilegedEffect {
    subject: subject,
    frequency: EveryProvision,
    reversibility: ReversibleByReapply,
    surface: ApiSurface,
    workload_identity: convergence_principal(),
    minted_reach: MintsNoCredential,
    billing: NoBillingConsequence,
    witness_discharge: NoWitnessDischarge,
  }
}

// THE BMC EXPORT HOST'S READER ROWS (gunbc.host.export_host_reader_converge): root writes under /etc/ssh, a
// system account and an sshd reload on srv2. FleetOnce (set up once, re-applied on a key rotation),
// reversible (the rollback removes the drop-in; the account and key file are removable rows), and host-root
// reach a human can attend, so the selection is the operator-approved capability (gunbc.design_ruling
// one_approval_route_for_every_privileged_action). It is realized as every fleet host file converge is: a
// fleet-converge dispatch at main over the administrator edge, which diverges with the reason below.
data export_host_rows_beside_unlanded_host_file_adapter: DivergenceReason = DivergenceReason {
  statement: "the approval broker has no authority adapter that applies a fleet host's declared file rows under a redeemed capability, so the export host's reader rows are applied by a fleet-converge dispatch at main over the administrator edge, the route every fleet host file converge already takes; the dispatch is the operator's, and the rows are the reviewed main tree's" as NonEmptyStr,
  dissolution: unbound_dissolution(description: "an authority adapter, registered against gunbc.auth.approval_broker redeem_capability, that applies a FleetHostFileDesired row set and its sshd validate/reload/readback/rollback fold under a redeemed ApprovalCapability bound to the rows' digest, so the converge requests the capability (gunbc.auth.access_request) instead of running on the dispatch alone. NOT satisfied by an environment reviewer gate" as NonEmptyStr),
}

fn export_host_reader_rows_effect() -> PrivilegedEffect {
  PrivilegedEffect {
    subject: "on the BMC export host, as its administrator: create the unprivileged boot-medium-reader account, write its root-owned authorized_keys file forced to one sha256sum, add an sshd_config.d AuthorizedKeysFile drop-in, validate with sshd -t and sshd -T, reload ssh, read back a fresh fleet-automation login, and roll the drop-in back if that login fails" as NonEmptyStr,
    frequency: FleetOnce,
    reversibility: ReversibleByReapply,
    surface: ApiSurface,
    workload_identity: WorkloadIdentityUnbindable { cause: "no cloud workload identity names a root write on a fleet host; the identity that reaches it is the administrator principal over SSH" as NonEmptyStr },
    minted_reach: MintsHostRootReach,
    billing: NoBillingConsequence,
    witness_discharge: NoWitnessDischarge,
  }
}

// THE BOOT MEDIUM READER KEY'S MINT (gunbc.host.boot_medium_reader_key_mint). FleetOnce: one key for the
// export host, minted again only to rotate it, which also makes it reversible. Its reach is one resource:
// the key is authorized on the export host forced to a single sha256sum of the served link
// (gunbc.host.boot_medium_reader_key), so MintsResourceScopedCredential. A human can attend it and owes no
// witness, and the fleet identity at main is bindable, so the selection is the federated grant: the run
// adds the version under its versionAdder cell, whose binding is the converge's approved apply.
fn boot_medium_reader_key_mint_effect() -> PrivilegedEffect {
  PrivilegedEffect {
    subject: "as the fleet identity at main, generate an ed25519 keypair in the run and add its private half as a version of boot-medium-reader-ssh-key; the receipt names only the public key, its fingerprint and the version" as NonEmptyStr,
    frequency: FleetOnce,
    reversibility: ReversibleByReapply,
    surface: ApiSurface,
    workload_identity: convergence_principal(),
    minted_reach: MintsResourceScopedCredential,
    billing: NoBillingConsequence,
    witness_discharge: NoWitnessDischarge,
  }
}

// A one-off accessor-cell grant (getIamPolicy + setIamPolicy on one secret).
fn accessor_grant(subject: NonEmptyStr) -> PrivilegedEffect {
  PrivilegedEffect {
    subject: subject,
    frequency: FleetOnce,
    reversibility: ReversibleByReapply,
    surface: ApiSurface,
    workload_identity: grant_administrator_unbindable,
    minted_reach: MintsNoCredential,
    billing: NoBillingConsequence,
    witness_discharge: NoWitnessDischarge,
  }
}

// THE MT. COLLINS BOOT (operator ruling 2026-09-23), with its parameters stated as they are.
// RECURRING: dispatched every time the unit is re-censused, with nobody at the end of it --
// EveryProvision, which the selection reads as "must run unattended".
// IRREVERSIBLE, AND SAID SO: a power cycle destroys the unit's RAM and whatever session it held, and
// no reapply restores that. An earlier revision of this row declared ReversibleByReapply, and its own
// mutation claim showed that label was what selected federation -- a relabel standing where a
// decision belonged (side-chat review 5286225278).
// THE DECISION IS THE OPERATOR'S, AND IT IS STATED HERE WITH NO RUN-TIME APPROVAL (operator rulings
// 2026-09-23 and 2026-09-25). #12101 had every run read a stored approval of the ruling's words before
// the unit hold; the operator declined to file one and asked for the check to be removed, so the
// ruling is this one value: its words, the effect, the roots it covers and the interlock it is
// conditional on. It discharges the per-instance witness for irreversibility and nothing else; the
// interlock is rostered in privileged_effect_interlocks below, and a ruling whose interlock is not
// rostered against its site is red (rulings_without_a_rostered_interlock).
// MINTS NO CREDENTIAL: it reads the pinned BMC credential and the pinned fleet key.
// WORKLOAD IDENTITY: the admitted boot federation's dedicated account
// (gunbc.auth.managed_host_boot_federation) for the boot, unbindable when the pair is unprovisioned;
// the fleet-converge run's principal for host reset-return.
data mtcollins1_operator_ruling: StandingDestructiveAuthorization = StandingDestructiveAuthorization {
  ruling_text: "the fleet-converge mtcollins1_boot and host_reset_return modes, dispatched from gunb-ai/gunbc main under their workload identity, may attach media to, set the boot device of, power-cycle and capture the console of Mt. Collins unit 1 on every dispatch with no per-run or standing approval, provided each run first takes the unit's maintenance hold. Operator chat rulings 2026-09-23 ('we technically don't even need my approval - would you mind getting rid of that step or making WIF just trust this workflow') and 2026-09-25 ('no I don't want that - can you just remove that check asap')" as NonEmptyStr,
  effect_subject: "mtcollins1 destructive controller effect: BMC virtual-media attach, one-shot boot-device set, power cycle and SOL capture" as NonEmptyStr,
  interlock: InterlockedBy { hold: decl_ref(module_path: "gunbc.host.managed_host_unit_hold", decl_name: "UnitHoldProof") },
}

data mtcollins1_operator_ruling_roots: List<DeclarationRef> = [
  decl_ref(module_path: "gunbc.machine_intake.mtcollins1_boot_run", decl_name: "mtcollins1_boot_wet"),
  decl_ref(module_path: "gunbc.host.host_reset_return_run", decl_name: "host_reset_return_wet"),
]

// THE TWO IN-BAND RECOVERY WRITES, CLASSIFIED. Both are DeviceOnce: each actuation is one physical
// occasion at one chassis, not a recurring control-plane operation, and neither is a read.
//
// THE PASSWORD WRITE, CLASSIFIED BY WHAT IT ACTUALLY DOES. Its subject says the write happens "so an
// authenticated in-band session can be opened", and that sentence is the classification: the write puts a
// password into one controller's ADMINISTRATOR account and thereby brings a device-scoped credential into
// existence. So minted_reach is MintsResourceScopedCredential, not MintsNoCredential -- it was the row
// that was wrong, not its `realized` field, and making the profile honest is what makes the
// operator-approved capability the pattern selection derives rather than a grant the row then has to
// explain away (DESIGN §3b: a divergence with no reason is the only red, because it forks the authority).
//
// ReversibleByReapply would have been the comfortable choice and is false here, for the same reason
// route_qualification_effect above is classified irreversible: writing a password that the run then hands
// to nobody, over a channel with no credential on either side, leaves an enabled account holding a secret
// the run never stored. Setting the password again does not close the window in which anything on that
// host's IPMI queue could have read it; the account's later removal by the reset is a different actuation,
// not a reapply. So: irreversible, undischarged, which forces a witness -- and OperatorApprovedCapability
// is what the selection admits for a witnessed, attended, device-scoped write.
//
// WHY "no -I option" IS GONE FROM THIS SENTENCE. ipmitool does not run with no interface: it defaults to
// `open` (upstream configure.ac DEFAULT_INTF_NO_ENV), which is the OpenIPMI driver over /dev/ipmi0. The
// passwordlessness that matters is that no credential appears on the command line and no network
// authentication happens -- not the absence of an option, which was never true. Likewise the in-band
// transport is named by its arm in extdeps.bmc.ipmi (InBandHostTransport), and SSIF is recorded where it
// is a fact: the kernel module under /dev/ipmi0 in the capture, not the interface ipmitool was told to use.
fn recovery_in_band_set_user_password_effect() -> PrivilegedEffect {
  PrivilegedEffect {
    subject: "from the rescue host OS, over the in-band host interface (/dev/ipmi0, ipmi_ssif behind it, with no credential on the command line and no network authentication), write one temporary password to the BMC's ADMINISTRATOR account, so an authenticated in-band session can be opened against a controller whose existing password is unknown" as NonEmptyStr,
    frequency: DeviceOnce,
    reversibility: IrreversibleEffect {
      what_is_lost: "an enabled ADMINISTRATOR account left holding a password this run never stored; the exposure window is not undone by setting the password again, and its later removal is a separate actuation rather than a reapply" as NonEmptyStr,
    },
    surface: ApiSurface,
    workload_identity: convergence_principal(),
    minted_reach: MintsResourceScopedCredential,
    billing: NoBillingConsequence,
    witness_discharge: NoWitnessDischarge,
  }
}

// The reset is the destructive half, and its classification is what decides the authorization pattern.
// ResetType=ResetAll -- the DMTF-published parameter name for this action, declared in
// extdeps/bmc/redfish -- restores every user account, every password and the network
// configuration to factory state on a board being brought into the fleet rather than serviced: nothing
// re-applies the prior user table, so the loss is not undone by a reapply. Irreversible, therefore
// OperatorApprovedCapability -- the operator approval on this write is not a courtesy, it is what the
// characteristics force.
fn recovery_manager_reset_to_defaults_effect() -> PrivilegedEffect {
  PrivilegedEffect {
    subject: "against the BMC controller over Redfish, POST Manager.ResetToDefaults with ResetType=ResetAll, returning every account, password and the user table to factory state, on a board being brought into the fleet rather than serviced" as NonEmptyStr,
    frequency: DeviceOnce,
    reversibility: IrreversibleEffect {
      what_is_lost: "the prior user table and every password on the controller: a reset to factory state cannot be reapplied to bring them back, which is exactly why this write cannot be used to install a credential of our own" as NonEmptyStr,
    },
    surface: ApiSurface,
    workload_identity: convergence_principal(),
    minted_reach: MintsNoCredential,
    billing: NoBillingConsequence,
    witness_discharge: NoWitnessDischarge,
  }
}

// ONE EFFECT SHAPE PER ROOT OF THE RULING, differing only in the root's own identity: both are the
// recurring, irreversible, standing-ruled Mt. Collins destructive controller effect.
fn mtcollins1_destructive_controller_effect(root_subject: NonEmptyStr, identity: WorkloadIdentityStanding) -> PrivilegedEffect {
  PrivilegedEffect {
    subject: join([mtcollins1_operator_ruling.effect_subject as String, " -- by ", root_subject as String], "") as NonEmptyStr,
    frequency: EveryProvision,
    reversibility: IrreversibleEffect { what_is_lost: "a power cycle destroys the unit's RAM and the session it was running; no reapply restores it" as NonEmptyStr },
    surface: ApiSurface,
    workload_identity: identity,
    minted_reach: MintsNoCredential,
    billing: NoBillingConsequence,
    witness_discharge: StandingRulingUnderInterlock { ruling: mtcollins1_operator_ruling },
  }
}

fn mtcollins1_boot_effect() -> PrivilegedEffect {
  mtcollins1_destructive_controller_effect(
    root_subject: "the mtcollins1_boot mode (attach, boot device, power, SOL; census medium readback over the pinned fleet key)" as NonEmptyStr,
    identity: match boot_federation_for(host: operator_host_mtcollins1) {
      BootFederationProvisioned { federation: f } => WorkloadIdentityBindable { member: boot_federation_service_account_member(f: f) as NonEmptyStr }
      BootFederationProvisionedUnderDeclaredDrop { federation: f, drop: _, standing_subject: _, current_subject: _ } =>
        WorkloadIdentityBindable { member: boot_federation_service_account_member(f: f) as NonEmptyStr }
      BootFederationUnprovisioned { host: _, cause: _ } =>
        WorkloadIdentityUnbindable { cause: "mtcollins1 has no admitted boot federation (gunbc.auth.managed_host_boot_federation boot_federation_for)" as NonEmptyStr }
    },
  )
}

// HOST RESET-RETURN reads the BMC credential through the repository federation (the convergence
// principal), not the boot's dedicated identity; that residue is stated in the PR and unchanged here.
fn mtcollins1_host_reset_effect() -> PrivilegedEffect {
  mtcollins1_destructive_controller_effect(
    root_subject: "the host_reset_return mode (boot device, power)" as NonEmptyStr,
    identity: convergence_principal(),
  )
}

// ROTATION ROUTE QUALIFICATION (cut O1a). Grounding a controller's account-write route is its own
// effect, separate from the rotation Apply that consumes the route: one executed account-write
// request per controller and build. IRREVERSIBLE, AND SAID SO: an account write over an unqualified
// route can leave an account enabled holding a password nobody stored, and the exposure window it
// opens is not undone by a reapply (artifacts/bmc/mtcollins1-bmc-user3-route-2026-09-13.txt, steps
// b1 and b1r). It applies a credential to one controller account, so its reach is one resource. No
// dispatched run carries it: in this cut it is modeled, with a dry realization only. The realization
// takes an operator-approved capability (gunbc.auth.approval_broker Redemption) bound to the exact
// controller, build and request, which is what the selection is expected to return.
fn route_qualification_effect() -> PrivilegedEffect {
  PrivilegedEffect {
    subject: "qualify a BMC account-write route: execute one account-write request on one controller at one firmware build and read it back" as NonEmptyStr,
    frequency: DeviceOnce,
    reversibility: IrreversibleEffect { what_is_lost: "an account write over an unqualified route can leave an account enabled holding an unstored password; the exposure window is not undone by a reapply" as NonEmptyStr },
    surface: ApiSurface,
    workload_identity: WorkloadIdentityUnbindable { cause: "no dispatched run carries route qualification; in cut O1a it is modeled with a dry realization only" as NonEmptyStr },
    minted_reach: MintsResourceScopedCredential,
    billing: NoBillingConsequence,
    witness_discharge: NoWitnessDischarge,
  }
}

// OPENING AN OPERATOR-KEY SSH LEG TO A RENTED NODE (gunbc.serving.rented_host_grant). The effect runs on a
// host the fleet has never seen, once per qualification or placement attempt, and is undone by closing
// the leg: reversible, no credential minted (the private key stays in the operator's ssh-agent), and no
// bill of its own (the rental is billed by the provider whether or not a leg opens). No dispatched run
// carries it and the rental host is no cloud principal, so the identity is unbindable and the selection
// falls to the per-attempt operator approval, realized as a std.scoped_authorization grant.
fn rented_host_ssh_effect() -> PrivilegedEffect {
  PrivilegedEffect {
    subject: "open an operator-key SSH leg to a rented node and run the observation and launch commands of one qualification or placement attempt on it" as NonEmptyStr,
    frequency: EveryOperatorRequest,
    reversibility: ReversibleByReapply,
    surface: ApiSurface,
    workload_identity: WorkloadIdentityUnbindable { cause: "a rented host is not a cloud principal and no dispatched run carries the qualification, so no workload identity can be bound to it" as NonEmptyStr },
    minted_reach: MintsNoCredential,
    billing: NoBillingConsequence,
    witness_discharge: NoWitnessDischarge,
  }
}

// ROTATION ROUTE QUALIFICATION, CHANNEL-ACCESS SHAPE (cut O1a-2). The same qualification effect
// executed for an IPMI Set User Access request: one per controller and build. Its characteristics
// are stated as they are rather than copied from the password row. IRREVERSIBLE, AND SAID SO: a
// privilege write to the wrong user or channel can remove the last administrator's access over the
// LAN, and getting it back needs hands on the unit (a host-side interface or a reflash), which no
// reapply over the network can do. It applies NO credential: it changes a privilege limit, not a
// password. No dispatched run carries it; in this cut it is modeled with a dry realization only.
fn route_qualification_channel_access_effect() -> PrivilegedEffect {
  PrivilegedEffect {
    subject: "qualify a BMC channel-access route: execute one IPMI Set User Access request in its privilege-limit-only form on one controller at one firmware build and read it back with Get User Access" as NonEmptyStr,
    frequency: DeviceOnce,
    reversibility: IrreversibleEffect { what_is_lost: "a privilege write to the wrong user or channel can remove the last administrator's LAN access; recovering it needs hands on the unit, not a reapply" as NonEmptyStr },
    surface: ApiSurface,
    workload_identity: WorkloadIdentityUnbindable { cause: "no dispatched run carries route qualification; in cut O1a-2 it is modeled with a dry realization only" as NonEmptyStr },
    minted_reach: MintsNoCredential,
    billing: NoBillingConsequence,
    witness_discharge: NoWitnessDischarge,
  }
}

// BMCSECURE ACCOUNT ROTATION (cut O1b, discharge O1c-3). The Apply arm of the state-shaped BmcSecure:
// set the managed account to a stored and exact-fetched generation and retire the published account
// to a break-glass generation, each write over a route admitted by admit_rotation_apply.
// IRREVERSIBLE, AND SAID SO: the value each write replaces is gone, and the published factory value is
// not restorable by a reapply (artifacts/bmc/mtcollins1-user2-retire-2026-09-13.txt). One controller's
// accounts, so its reach is one resource. arrival_converge_wet federates the archive door; it does
// not invoke BmcSecure Apply, so this effect stays WorkloadIdentityUnbindable. Irreversibility is
// discharged by the mtjade1 live-ops standing ruling's StandingBmcSecureAccountWrite arm (InterlockedBy
// admit_rotation_apply via standing_ruling_with_arm_interlock), not grant-grain InterlockPending.
// A write still needs a grounded route. Operator-approved capability remains the selected pattern
// while the workload identity is unbindable, and is the fallback when the grant does not cover the host.
fn bmc_secure_account_rotation_effect() -> PrivilegedEffect {
  PrivilegedEffect {
    subject: "rotate a BMC's managed account to a stored generation and retire its published account, over admitted routes on one controller at one firmware build" as NonEmptyStr,
    frequency: DeviceOnce,
    reversibility: IrreversibleEffect { what_is_lost: "each account write replaces the value it overwrites; the published factory value is not restored by a reapply" as NonEmptyStr },
    surface: ApiSurface,
    workload_identity: WorkloadIdentityUnbindable { cause: "arrival_converge_wet does not invoke BmcSecure Apply; account rotation stays capability-selected until a held writer lands in that door" as NonEmptyStr },
    minted_reach: MintsResourceScopedCredential,
    billing: NoBillingConsequence,
    witness_discharge: StandingRulingUnderInterlock {
      ruling: standing_ruling_with_arm_interlock(g: mtjade1_live_standing_grant, e: StandingBmcSecureAccountWrite),
    },
  }
}

// ── INTERLOCKS: the state an effect's parameters are honest only under ─────────────────────────
// A row's reversibility can depend on a fact about the world rather than about the call: the boot
// above is reversible by reapply only while nobody is working on the unit. That condition is not a
// selection input (the selection is about who may authorize), so it is carried here, joined to the
// census by site identity, naming the hold the site must acquire and the fold that refuses under it.
// The witness asserts every interlocked site is a census row and that the refusal fires under an
// active hold.
type PrivilegedEffectInterlock {
  site: DeclarationRef
  hold: DeclarationRef?
  refusal: DeclarationRef
  premise: NonEmptyStr
  hold_owning_roots: List<InterlockRoot>
}

fn privileged_effect_interlock_hold(interlock: StandingRulingInterlock) -> DeclarationRef? {
  match interlock {
    InterlockedBy { hold: i } => Present { value: i }
    InterlockPending { obligation: _ } => none
  }
}

// EVERY PRODUCTION ROOT THAT REACHES A GATED WRITE ON THE UNIT, and the live acquire it owns. The set
// is closed by the compiler rather than by this list: the BMC write wrappers take a sole_constructor
// UnitHoldProof, and the generic operations beneath them are admit_callers-sealed to the callers named
// in sealed_by (oob_boot_handoff -> boot_drive_handoff and host_reset_return_issue_and_watch;
// megarac_attach_remote_image -> megarac_attach_boot_image; the SOL release and activate to
// the boot's SOL acquire). A new caller refuses at compile time (ConstructorCallAdmissionRefused), so
// adding a root means editing a seal, which is where this row is read.
type InterlockRoot {
  root: DeclarationRef
  acquires_at: DeclarationRef
  operations: List<NonEmptyStr>
  sealed_by: List<DeclarationRef>
}

data mtcollins1_hold_owning_roots: List<InterlockRoot> = [
  InterlockRoot {
    root: site(module_path: "gunbc.machine_intake.mtcollins1_boot_run", decl_name: "mtcollins1_boot_wet"),
    acquires_at: site(module_path: "gunbc.machine_intake.mtcollins1_boot_run", decl_name: "mtcollins1_boot_under_live_unit_hold"),
    operations: ["SOL deactivate/activate" as NonEmptyStr, "virtual-media attach" as NonEmptyStr, "boot-device set" as NonEmptyStr, "power cycle" as NonEmptyStr],
    sealed_by: [
      site(module_path: "gunbc.machine_intake.mtcollins1_boot_run", decl_name: "mtcollins1_sol_release"),
      site(module_path: "gunbc.machine_intake.mtcollins1_boot_run", decl_name: "mtcollins1_sol_activate_held"),
      site(module_path: "gunbc.machine_intake.megarac_boot_media_attach", decl_name: "megarac_attach_boot_image"),
      site(module_path: "gunbc.machine_intake.megarac_media_attach", decl_name: "megarac_attach_remote_image"),
      site(module_path: "gunbc.host.managed_host_boot_handoff", decl_name: "boot_drive_handoff"),
      site(module_path: "gunbc.machine_intake.oob_boot_handoff", decl_name: "oob_boot_handoff"),
    ],
  },
  InterlockRoot {
    root: site(module_path: "gunbc.host.host_reset_return_run", decl_name: "host_reset_return_wet"),
    acquires_at: site(module_path: "gunbc.host.host_reset_return_run", decl_name: "host_reset_return_wet"),
    operations: ["boot-device set" as NonEmptyStr, "power cycle" as NonEmptyStr],
    sealed_by: [
      site(module_path: "gunbc.machine_intake.oob_boot_handoff", decl_name: "oob_boot_handoff"),
      site(module_path: "gunbc.machine_intake.oob_boot_handoff", decl_name: "oob_power_cycle_after_confirmed_selection"),
    ],
  },
]

// THE RULING THE RECOVERY RESET IS ACTUATED UNDER. The destructive half of bringing a locked BMC back
// is not a standing the route carries of its own: it runs under a named operator ruling covering
// exactly the reset site, and a RecoveryInBandRoute carries that ruling's declaration reference
// (RecoveryInBandRoute::operator_approval) instead of a boolean saying "approved". The effect is
// irreversible, which is what makes selection demand an approval rather than a federation grant; the
// ruling's words state the terms the approval is filed against. No per-instance hold is claimed, so
// this is an operator ruling and not a discharge: the route's own readback law stays in the recovery
// module, where the standing that needs it is minted.
data recovery_reset_operator_ruling: StandingDestructiveAuthorization = StandingDestructiveAuthorization {
  // THE CHANNEL EACH WRITE TRAVELS IS STATED, BECAUSE THE TWO WRITES DO NOT TRAVEL THE SAME ONE. The
  // captured bytes are the authority here, not convenience: 01_summary.txt records the reset as
  // `POST .../Actions/Manager.ResetToDefaults` against the BMC, whose firmware required the body
  // parameter spelled `ResetToDefaultsType` where DMTF publishes `ResetType` (01_summary.txt records both the
  // 400 for the published spelling and the 200 for its own). That mismatch is a REPORTED OBSERVATION about
  // this specimen and is quoted here as one; the spelling the interface publishes is unchanged by it (§3: an
  // observation this repository makes is a receipt downstream, never a property of the upstream). The
  // reset went to the controller's own LAN address (192.168.1.250 per the capture), so the reset went out-of-band over the management
  // interface, and only the temporary password write used the in-band SSIF channel (01_summary.txt's
  // "PRIVILEGED WRITE 1 -- set temp admin password over the in-band SSIF channel"). §4d: "Do not assert as
  // deduced what is only inferred" -- and this text is what a per-effect operator approval is FILED
  // AGAINST, so scoping the wipe to a channel it never used would have the operator approve a different
  // actuation from the one being admitted. §3: the ruling and the effect row it governs may not name
  // different channels for the same write.
  ruling_text: "an arrival unit whose BMC ADMINISTRATOR password is unknown and whose rescue host OS is reachable may be returned to factory state by Redfish Manager.ResetToDefaults (ResetType=ResetAll, the arm DMTF publishes as returning every account and password to factory state) issued over the BMC's out-of-band management interface, one unit at a time, under a per-effect operator approval filed against this ruling; the in-band system interface is used only to write the temporary Administrator password, never for the reset; the route may not use the reset to install a credential of its own and terminates by handing the factory credential to the existing factory-login-then-rotate path" as NonEmptyStr,
  effect_subject: "recovery reset: Redfish Manager.ResetToDefaults ResetType=ResetAll over the BMC's out-of-band management interface, on one arrival unit's BMC controller" as NonEmptyStr,
  // THE HOLD IS THE SEALED PROOF, NOT THE ACQUIRE FUNCTION. Both other interlocked rulings in this file
  // name gunbc.host.managed_host_unit_hold::UnitHoldProof, and the premise below says so: the two
  // admission gates refuse unless the UnitHoldProof they are handed names the same unit. Naming
  // unit_hold_acquire here would have the ruling interlock a call site, which is what the refusal
  // position is for (the mtcollins rows put unit_hold_acquire in `refusal:`); the witness claim
  // the_reset_interlock_rosters_no_root_the_fold_cannot_show reads this field as the proof type and was
  // red, correctly.
  interlock: InterlockedBy { hold: decl_ref(module_path: "gunbc.host.managed_host_unit_hold", decl_name: "UnitHoldProof") },
}

data privileged_effect_interlocks: List<PrivilegedEffectInterlock> = [
  PrivilegedEffectInterlock {
    site: site(module_path: "gunbc.machine_intake.bmc_recovery_route", decl_name: "admit_recovery_manager_reset_to_defaults"),
    hold: privileged_effect_interlock_hold(interlock: recovery_reset_operator_ruling.interlock),
    refusal: site(module_path: "gunbc.machine_intake.bmc_recovery_route", decl_name: "admit_recovery_manager_reset_to_defaults"),
    premise: "WHEN A ROOT EXISTS IT MUST ACQUIRE THE HOLD BEFORE EITHER WRITE. The two admission gates refuse unless the UnitHoldProof they are handed names the SAME unit as the recovery subject, so a ResetAll cannot be actuated on a chassis another run is driving. No production root is rostered, because none exists yet: converge_in_band_recovery receives both admissions as PARAMETERS and calls neither gunbc.host.managed_host_unit_hold's acquire nor either admission, so rostering it as a hold-owning root would be the census attesting to a pairing the code does not perform. The obligation is rostered as a frontier row -- gunbc.machine_intake.bmc_recovery_route_frontier's bmc_recovery_route_pairing_frontier_rows, whose bound trigger is the fold that pairs subject, hold proof and admission -- and the roster is filled in when that fold lands. This follows the runner_qualification_dispatch precedent, which rostered an empty root list for the same reason and named its owed root in the premise" as NonEmptyStr,
    hold_owning_roots: [] as List<InterlockRoot>,
  },
  PrivilegedEffectInterlock {
    site: site(module_path: "gunbc.runner.runner_qualification_dispatch", decl_name: "dispatch_qualification_floor"),
    hold: privileged_effect_interlock_hold(interlock: runner_lifecycle_operator_ruling.interlock),
    refusal: site(module_path: "gunbc.runner.runner_qualification_dispatch", decl_name: "dispatch_qualification_floor"),
    premise: "the dispatch takes the slot host's unit hold proof and refuses DispatchHoldForAnotherHost unless the proof's admitted host is the slot's own; the root that acquires it is the route fold the dispatch leg owes (LegAuthorityImplemented wiring_owed), so no production root is rostered yet" as NonEmptyStr,
    hold_owning_roots: [] as List<InterlockRoot>,
  },
  PrivilegedEffectInterlock {
    site: site(module_path: "gunbc.machine_intake.mtcollins1_boot_run", decl_name: "mtcollins1_boot_wet"),
    hold: privileged_effect_interlock_hold(interlock: mtcollins1_operator_ruling.interlock),
    refusal: site(module_path: "gunbc.host.managed_host_unit_hold", decl_name: "unit_hold_acquire"),
    premise: "the boot takes the unit's one durable exclusive hold before any BMC write and refuses FileHoldOccupied naming the holder" as NonEmptyStr,
    hold_owning_roots: mtcollins1_hold_owning_roots,
  },
  PrivilegedEffectInterlock {
    site: site(module_path: "gunbc.host.host_reset_return_run", decl_name: "host_reset_return_wet"),
    hold: privileged_effect_interlock_hold(interlock: mtcollins1_operator_ruling.interlock),
    refusal: site(module_path: "gunbc.host.managed_host_unit_hold", decl_name: "unit_hold_acquire"),
    premise: "host reset-return takes the same unit hold before it sets the boot device or power-cycles the unit" as NonEmptyStr,
    hold_owning_roots: mtcollins1_hold_owning_roots,
  },
  PrivilegedEffectInterlock {
    site: site(module_path: "gunbc.machine_intake.bmc_secure", decl_name: "plan_bmc_account_action"),
    hold: Present { value: decl_ref(module_path: "gunbc.machine_intake.bmc_rotation_route", decl_name: "admit_rotation_apply") },
    refusal: site(module_path: "gunbc.machine_intake.arrival_converge", decl_name: "grant_discharges_bmc_secure_account_write"),
    premise: "BmcSecure Apply discharges the mtjade1 standing ruling only when admit_rotation_apply is rostered against this site; InterlockPending never discharges, and a named hold that is not this site's rostered interlock does not discharge" as NonEmptyStr,
    hold_owning_roots: [] as List<InterlockRoot>,
  },
  PrivilegedEffectInterlock {
    site: site(module_path: "gunbc.auth.mtjade1_arrival_federation", decl_name: "mtjade1_arrival_archive_effect"),
    hold: Present { value: decl_ref(module_path: "gunbc.machine_intake.arrival_interlock", decl_name: "arrival_archive_slot_acquire") },
    refusal: site(module_path: "gunbc.machine_intake.arrival_interlock", decl_name: "arrival_archive_slot_acquire"),
    premise: "the wet arrival door takes the subject's exclusive slot (file_hold_acquire) and, while ArrivalArchiveSlotHeld, calls arrival_wet_prefix_from_unobserved_world which refuses; it does not fold converge_mtjade1_arrival_prefix or write the prior-life archive until an observed BMC/archive world is bound" as NonEmptyStr,
    hold_owning_roots: [
      InterlockRoot {
        root: site(module_path: "gunbc.machine_intake.arrival_run", decl_name: "arrival_converge_wet"),
        acquires_at: site(module_path: "gunbc.machine_intake.arrival_interlock", decl_name: "arrival_archive_slot_acquire"),
        operations: ["typed refusal of unobserved PriorLifeBoundary" as NonEmptyStr],
        sealed_by: [
          site(module_path: "gunbc.machine_intake.arrival_interlock", decl_name: "arrival_archive_slot_release"),
        ],
