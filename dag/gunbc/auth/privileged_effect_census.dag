// ── EVERY PRIVILEGED-EFFECT SITE IN dag/, CLASSIFIED BY EXECUTING THE SELECTION ──────────────
//
// THE VERDICT IS DERIVED, NOT AUTHORED. Each row supplies the site (module and symbol), the
// effect's characteristics, and what the site REALIZES today; the fold runs
// gunbc.auth.authorization_pattern_selection over the characteristics and compares. A row's author
// may state a reason for a divergence; the author may not state the verdict. That is §3b's
// three-valued answer made mechanical: conforms when the realized pattern is the selected one;
// diverges-with-reason when they differ and the row says why; diverges when they differ and the
// row is silent. Only the third is red, and the witness makes it red.
//
// THE POPULATION IS THE SITES THAT CHOOSE A CREDENTIAL. Kernels parameterized by a token source
// (gunbc.auth.gcp_secret_access secret_access_ensure_for, gunbc.auth.secret_ref_credential
// fetch_secret_ref_credential, gunbc.auth.secret_rotation, gunbc.secret_provision_actuator,
// gunbc.fleet_printer_access) choose nothing and are not rows; the entries that bind their
// token_source are. Module names below were read from each file's `module` line, not from its path
// (gunbc.fleet_printer_access lives under dag/gunbc/fleet/ and is not gunbc.fleet.*).
//
// COMPLETENESS IS NOT CLAIMED BY THIS ROSTER. The population was enumerated by grepping every
// gcp.SecretManager.*, gcp.STS.*, gcp.IAM.*, shell.GCloud.*, cloudflare.AccountTokens.* and
// access_token_source consumer in dag/ on 2026-09-19; a discovery join that refuses an unrostered
// site is the next rung, and it is the same trigger gunbc.host_convergence_census names for itself.

// WHAT A SITE REALIZES TODAY, read off its token-source binding.
//   RealizedRunSelected -- gunbc.auth.access_token_source select_access_token_source /
//     resolve_access_token: the federated arm in a dispatched run, the operator's file in a session.
//     Classified as the federated pattern, because that is the arm that executes unattended and the
//     file arm is the operator's own workstation realization of the same entry.
type OperatorSessionArm
  = GcloudInteractive
  | OperatorTokenFile

type RealizedAuthorization
  = RealizedFederatedGrant
  | RealizedRunSelected
  | RealizedApprovalCapability
  | RealizedHumanStep
  | RealizedOperatorSession { arm: OperatorSessionArm }

// A REASON IS A STATEMENT PLUS THE CONDITION UNDER WHICH IT STOPS BEING ONE. A bare string moved a
// site out of the debt roster for as long as anyone left it there (review 68720): no bound, no
// trigger, nothing joined to anything. The trigger is the whole content of a reason (§4b(3): a drop
// is retired by its trigger and by nothing else), so it is carried in std.dissolution's vocabulary.
// A bound trigger names a declaration whose retirement fires it; the required floor refuses a
// decl_ref to a declaration that does not exist (CITED-DECLARATION-ABSENT), so deleting the
// trigger's subject fails this module at the gate rather than leaving a fired reason standing. An unbound trigger names the CAPABILITY that would retire it, because a
// forward citation to a declaration nobody has written is the fabricated-citation class the floor
// refuses, and that is the honest shape for an adapter that does not exist yet.
type DivergenceReason {
  statement: NonEmptyStr
  dissolution: DissolutionCondition
}

type PrivilegedEffectSite {
  site: DeclarationRef
  effect: PrivilegedEffect
  realized: RealizedAuthorization
  divergence_reason: DivergenceReason?
}

type SiteConformance
  = Conforms
  | DivergesWithReason { reason: DivergenceReason }
  | Diverges
  | SiteNotDecidable { standing: AuthorizationPatternSelection }

type SiteVerdict {
  site: DeclarationRef
  selection: AuthorizationPatternSelection
  conformance: SiteConformance
}

fn realized_matches(selected: AuthorizationPattern, realized: RealizedAuthorization) -> Bool {
  match selected {
    FederatedScopedGrant =>
      match realized {
        RealizedFederatedGrant => true
        RealizedRunSelected => true
        RealizedApprovalCapability => false
        RealizedHumanStep => false
        RealizedOperatorSession { arm: _ } => false
      }
    OperatorApprovedCapability =>
      match realized {
        RealizedApprovalCapability => true
        RealizedFederatedGrant => false
        RealizedRunSelected => false
        RealizedHumanStep => false
        RealizedOperatorSession { arm: _ } => false
      }
    HumanOnlyStep { step: _ } =>
      match realized {
        RealizedHumanStep => true
        RealizedFederatedGrant => false
        RealizedRunSelected => false
        RealizedApprovalCapability => false
        RealizedOperatorSession { arm: _ } => false
      }
    OperatorOwnSession =>
      match realized {
        RealizedOperatorSession { arm: _ } => true
        RealizedFederatedGrant => false
        RealizedRunSelected => false
        RealizedApprovalCapability => false
        RealizedHumanStep => false
      }
    PastedOperatorToken => false
  }
}

fn divergence(row: PrivilegedEffectSite) -> SiteConformance {
  match row.divergence_reason {
    Present { value: r } => DivergesWithReason { reason: r }
    Absent => Diverges
  }
}

fn site_conformance(row: PrivilegedEffectSite, selection: AuthorizationPatternSelection) -> SiteConformance {
  match selection {
    PatternSelected { pattern: p, receipt: _ } =>
      if realized_matches(selected: p, realized: row.realized) { Conforms } else { divergence(row: row) }
    ManualStepRequired { step: s, receipt: _ } =>
      if realized_matches(selected: HumanOnlyStep { step: s }, realized: row.realized) { Conforms } else { divergence(row: row) }
    NoAdmissiblePattern { causes: _, scope: _ } => SiteNotDecidable { standing: selection }
    PatternSelectionNeedsEvidence { needs: _ } => SiteNotDecidable { standing: selection }
    PatternSelectionNeedsPolicy { survivors: _ } => SiteNotDecidable { standing: selection }
    PatternSelectionRefused { defects: _ } => SiteNotDecidable { standing: selection }
  }
}

fn site_verdict(row: PrivilegedEffectSite) -> SiteVerdict {
  let selection = select_authorization_pattern(e: row.effect)
  SiteVerdict { site: row.site, selection: selection, conformance: site_conformance(row: row, selection: selection) }
}

// ── Shared characteristics ───────────────────────────────────────────────────────────────────
fn site(module_path: String, decl_name: String) -> DeclarationRef {
  decl_ref(module_path: module_path, decl_name: decl_name)
}

// THE MEMBER IS RESOLVED FROM THE STANDING, never spelled: an unallocated principal is an
// unbindable identity, which is the truthful input to the selection rather than a member string
// that cannot exist (the same refusal gunbc.auth.gcp_secret_access makes before writing a policy).
fn convergence_principal() -> WorkloadIdentityStanding {
  match fleet_cloud_principal_standing() {
    CloudPrincipalAllocated { principal: _, member: m, readback: _ } => WorkloadIdentityBindable { member: m as NonEmptyStr }
    CloudPrincipalReported { principal: _, reported_member: m, source: _ } => WorkloadIdentityBindable { member: m as NonEmptyStr }
    CloudPrincipalUnallocated { principal: _ } =>
      WorkloadIdentityUnbindable { cause: "no allocated member is recorded for the fleet cloud principal" as NonEmptyStr }
  }
}

// THE GRANT ADMINISTRATOR IS UNBINDABLE BY CONSTRUCTION, not by omission: a principal that can both
// grant and read escalates itself to every secret in the project.
data grant_administrator_unbindable: WorkloadIdentityStanding = WorkloadIdentityUnbindable {
  cause: "setIamPolicy is FleetCloudGrantAdministrator's operation and the workload may not hold it (gunbc.spark.bootstrap_provision no_principal_can_both_grant_and_read)" as NonEmptyStr,
}

// A credential READ that a converge performs every time it runs.
fn recurring_credential_read(subject: NonEmptyStr) -> PrivilegedEffect {
  PrivilegedEffect {
    subject: subject,
    frequency: EveryProvision,
    reversibility: ReversibleByReapply,
    surface: ApiSurface,
    workload_identity: convergence_principal(),
    minted_reach: MintsNoCredential,
    billing: NoBillingConsequence,
    witness_discharge: NoWitnessDischarge,
  }
}

// A one-off accessor-cell grant (getIamPolicy + setIamPolicy on one secret).
fn accessor_grant(subject: NonEmptyStr) -> PrivilegedEffect {
  PrivilegedEffect {
    subject: subject,
    frequency: FleetOnce,
    reversibility: ReversibleByReapply,
    surface: ApiSurface,
    workload_identity: grant_administrator_unbindable,
    minted_reach: MintsNoCredential,
    billing: NoBillingConsequence,
    witness_discharge: NoWitnessDischarge,
  }
}

// THE MT. COLLINS BOOT (operator ruling 2026-09-23), with its parameters stated as they are.
// RECURRING: dispatched every time the unit is re-censused, with nobody at the end of it --
// EveryProvision, which the selection reads as "must run unattended".
// IRREVERSIBLE, AND SAID SO: a power cycle destroys the unit's RAM and whatever session it held, and
// no reapply restores that. An earlier revision of this row declared ReversibleByReapply, and its own
// mutation claim showed that label was what selected federation -- a relabel standing where a
// decision belonged (side-chat review 5286225278).
// THE DECISION IS THE OPERATOR'S, AND IT IS ATTESTED BY THE OPERATOR, NOT BY THIS ROW (review 70369):
// the ruling's words are filed once through the approval loop and every boot reads the stored
// approval of those exact words before the unit hold (gunbc.machine_intake_mtcollins1_standing_ruling),
// refusing if it is absent, denied or for other words. It is conditional on the unit's durable
// maintenance hold being released before any BMC write. It discharges the per-instance witness for irreversibility and nothing else; the
// interlock it names is rostered in privileged_effect_interlocks below, and a ruling whose interlock
// is not rostered against its site is red (rulings_without_a_rostered_interlock).
// MINTS NO CREDENTIAL: it reads the pinned BMC credential and the pinned fleet key.
// WORKLOAD IDENTITY: the dedicated account of gunbc.auth.mtcollins1_boot_federation.
// DERIVED FROM THE ONE RULING VALUE (side-chat review 5288466573): the census does not re-author the
// words, the effect or the interlock -- it reads them off gunbc.machine_intake_mtcollins1_standing_ruling
// mtcollins1_boot_standing_ruling, the same value the runtime digests and files.
fn standing_authorization_of(r: StandingRuling) -> StandingDestructiveAuthorization {
  StandingDestructiveAuthorization {
    ruling_text: r.text,
    effect_subject: r.effect_subject,
    interlock: r.interlock,
    confirmation_read: site(module_path: "gunbc.machine_intake_mtcollins1_standing_ruling", decl_name: "mtcollins1_boot_standing_ruling_read"),
  }
}

// ONE EFFECT SHAPE PER ROOT OF THE RULING, differing only in the root's own identity: both are the
// recurring, irreversible, standing-ruled Mt. Collins destructive controller effect.
fn mtcollins1_destructive_controller_effect(root_subject: NonEmptyStr, identity: WorkloadIdentityStanding) -> PrivilegedEffect {
  PrivilegedEffect {
    subject: join([mtcollins1_boot_standing_ruling.effect_subject as String, " -- by ", root_subject as String], "") as NonEmptyStr,
    frequency: EveryProvision,
    reversibility: IrreversibleEffect { what_is_lost: "a power cycle destroys the unit's RAM and the session it was running; no reapply restores it" as NonEmptyStr },
    surface: ApiSurface,
    workload_identity: identity,
    minted_reach: MintsNoCredential,
    billing: NoBillingConsequence,
    witness_discharge: StandingRulingUnderInterlock { ruling: standing_authorization_of(r: mtcollins1_boot_standing_ruling) },
  }
}

fn mtcollins1_boot_effect() -> PrivilegedEffect {
  mtcollins1_destructive_controller_effect(
    root_subject: "the mtcollins1_boot mode (attach, boot device, power, SOL; census medium readback over the pinned fleet key)" as NonEmptyStr,
    identity: WorkloadIdentityBindable { member: mtcollins1_boot_service_account_member() as NonEmptyStr },
  )
}

// HOST RESET-RETURN reads the BMC credential through the repository federation (the convergence
// principal), not the boot's dedicated identity; that residue is stated in the PR and unchanged here.
fn mtcollins1_host_reset_effect() -> PrivilegedEffect {
  mtcollins1_destructive_controller_effect(
    root_subject: "the host_reset_return mode (boot device, power)" as NonEmptyStr,
    identity: convergence_principal(),
  )
}

// ── INTERLOCKS: the state an effect's parameters are honest only under ─────────────────────────
// A row's reversibility can depend on a fact about the world rather than about the call: the boot
// above is reversible by reapply only while nobody is working on the unit. That condition is not a
// selection input (the selection is about who may authorize), so it is carried here, joined to the
// census by site identity, naming the hold the site must acquire and the fold that refuses under it.
// The witness asserts every interlocked site is a census row and that the refusal fires under an
// active hold.
type PrivilegedEffectInterlock {
  site: DeclarationRef
  hold: DeclarationRef
  refusal: DeclarationRef
  premise: NonEmptyStr
  hold_owning_roots: List<InterlockRoot>
}

// EVERY PRODUCTION ROOT THAT REACHES A GATED WRITE ON THE UNIT, and the live acquire it owns. The set
// is closed by the compiler rather than by this list: the BMC write wrappers take a sole_constructor
// UnitHoldProof, and the generic operations beneath them are admit_callers-sealed to the callers named
// in sealed_by (oob_boot_handoff -> mtcollins1_drive_handoff and host_reset_return_issue_and_watch;
// megarac_attach_remote_image -> mtcollins1_attach_diskless_image; the SOL release and activate to
// the boot's SOL acquire). A new caller refuses at compile time (ConstructorCallAdmissionRefused), so
// adding a root means editing a seal, which is where this row is read.
type InterlockRoot {
  root: DeclarationRef
  acquires_at: DeclarationRef
  operations: List<NonEmptyStr>
  sealed_by: List<DeclarationRef>
}

data mtcollins1_hold_owning_roots: List<InterlockRoot> = [
  InterlockRoot {
    root: site(module_path: "gunbc.machine_intake_mtcollins1_boot_run", decl_name: "mtcollins1_boot_wet"),
    acquires_at: site(module_path: "gunbc.machine_intake_mtcollins1_boot_run", decl_name: "mtcollins1_boot_under_live_unit_hold"),
    operations: ["SOL deactivate/activate" as NonEmptyStr, "virtual-media attach" as NonEmptyStr, "boot-device set" as NonEmptyStr, "power cycle" as NonEmptyStr],
    sealed_by: [
      site(module_path: "gunbc.machine_intake_mtcollins1_boot_run", decl_name: "mtcollins1_sol_release"),
      site(module_path: "gunbc.machine_intake_mtcollins1_boot_run", decl_name: "mtcollins1_sol_activate_held"),
      site(module_path: "gunbc.machine_intake_mtcollins1_media_attach", decl_name: "mtcollins1_attach_diskless_image"),
      site(module_path: "gunbc.machine_intake_megarac_media_attach", decl_name: "megarac_attach_remote_image"),
      site(module_path: "gunbc.machine_intake_mtcollins1_actuate", decl_name: "mtcollins1_drive_handoff"),
      site(module_path: "gunbc.machine_intake_oob_boot_handoff", decl_name: "oob_boot_handoff"),
    ],
  },
  InterlockRoot {
    root: site(module_path: "gunbc.host_reset_return_run", decl_name: "host_reset_return_wet"),
    acquires_at: site(module_path: "gunbc.host_reset_return_run", decl_name: "host_reset_return_wet"),
    operations: ["boot-device set" as NonEmptyStr, "power cycle" as NonEmptyStr],
    sealed_by: [
      site(module_path: "gunbc.machine_intake_oob_boot_handoff", decl_name: "oob_boot_handoff"),
      site(module_path: "gunbc.machine_intake_oob_boot_handoff", decl_name: "oob_power_cycle_after_confirmed_selection"),
    ],
  },
]

data privileged_effect_interlocks: List<PrivilegedEffectInterlock> = [
  PrivilegedEffectInterlock {
    site: site(module_path: "gunbc.machine_intake_mtcollins1_boot_run", decl_name: "mtcollins1_boot_wet"),
    hold: mtcollins1_boot_standing_ruling.interlock,
    refusal: site(module_path: "gunbc.machine_intake_mtcollins1_maintenance_hold", decl_name: "unit_hold_acquire"),
    premise: "the boot takes the unit's one durable exclusive hold before any BMC write and refuses FileHoldOccupied naming the holder" as NonEmptyStr,
    hold_owning_roots: mtcollins1_hold_owning_roots,
  },
  PrivilegedEffectInterlock {
    site: site(module_path: "gunbc.host_reset_return_run", decl_name: "host_reset_return_wet"),
    hold: mtcollins1_boot_standing_ruling.interlock,
    refusal: site(module_path: "gunbc.machine_intake_mtcollins1_maintenance_hold", decl_name: "unit_hold_acquire"),
    premise: "host reset-return reads the same standing ruling and takes the same unit hold before it sets the boot device or power-cycles the unit" as NonEmptyStr,
    hold_owning_roots: mtcollins1_hold_owning_roots,
  },
]

// A STANDING RULING IS HONORED ONLY BESIDE ITS INTERLOCK: for every census row whose effect carries
// one, the ruling's interlock must be the hold of an interlock rostered against that same site.
fn ruling_interlock_is_rostered(site_ref: DeclarationRef, interlock: DeclarationRef) -> Bool {
  any(privileged_effect_interlocks, i => declaration_ref_eq(a: i.site, b: site_ref) && declaration_ref_eq(a: i.hold, b: interlock))
}

fn rulings_without_a_rostered_interlock() -> List<DeclarationRef> {
  flat_map(privileged_effect_census, row =>
    match row.effect.witness_discharge {
      NoWitnessDischarge => []
      StandingRulingUnderInterlock { ruling: r } =>
        if ruling_interlock_is_rostered(site_ref: row.site, interlock: r.interlock) { [] } else { [row.site] }
    })
}

// RUNTIME AND CENSUS CANNOT DISAGREE ON THE ROOT POPULATION: the census sites that carry this ruling's
// discharge, and the ruling's own roots, are the same set (identity join, both directions).
fn discharged_by_ruling(v: PrivilegedEffectSite) -> Bool {
  match v.effect.witness_discharge {
    NoWitnessDischarge => false
    StandingRulingUnderInterlock { ruling: r } => (r.ruling_text as String) == (mtcollins1_boot_standing_ruling.text as String)
  }
}

fn ruling_roots_missing_from_census() -> List<DeclarationRef> {
  let sites = map(filter(privileged_effect_census, row => discharged_by_ruling(v: row)), row => row.site)
  filter(mtcollins1_boot_standing_ruling.roots, r => !declaration_ref_in_list(target: r, refs: sites))
}

fn census_sites_outside_ruling_roots() -> List<DeclarationRef> {
  filter(map(filter(privileged_effect_census, row => discharged_by_ruling(v: row)), row => row.site), s => !declaration_ref_in_list(target: s, refs: mtcollins1_boot_standing_ruling.roots))
}

fn interlocked_sites_missing_from_census() -> List<DeclarationRef> {
  let rostered = map(privileged_effect_census, row => row.site)
  filter(map(privileged_effect_interlocks, i => i.site), s => !declaration_ref_in_list(target: s, refs: rostered))
}

// THE DIVERGENCE REASONS THAT RECUR, each stated once with its dissolution.
data interim_gcp_iam_adapter_unlanded: DivergenceReason = DivergenceReason {
  statement: "the approval loop's authority adapter for GCP IAM and Secret Manager effects is not landed on main (gunbc#11484 carried the approval loop's first executing consumer); until it lands the grant administrator's own session on the grant administrator's own workstation is the interim realization, and relaying that token through chat or a message is the refused pattern" as NonEmptyStr,
  dissolution: unbound_dissolution(description: "an approval-loop authority adapter that performs getIamPolicy/setIamPolicy and Secret Manager create/addVersion under a redeemed capability, executing as the grant administrator identity on the roadmap server; owner: this lane (nimble-otter-774), sequenced after gunbc#11734 and gunbc#11484" as NonEmptyStr),
}

data interim_cloudflare_adapter_unlanded: DivergenceReason = DivergenceReason {
  statement: "the approval loop has no authority adapter for Cloudflare account-token mints; the operator's workflow_dispatch of the mint stood as the informal witness on 2026-09-19, and the token this run resolved in a session was relayed into its file from chat -- the refused pattern, invisible to the file arm" as NonEmptyStr,
  dissolution: unbound_dissolution(description: "an approval-loop authority adapter that performs cloudflare.AccountTokens.Create for a one-off mint under a redeemed capability, so gunbc.cloudflare.r2_token_mint_run resolves no operator credential in any run; owner: this lane (nimble-otter-774), PR 2b after gunbc#11721 merges" as NonEmptyStr),
}

// STRUCTURAL, AND BOUND TO THE THING THAT MAKES IT STRUCTURAL: the reason retires only if the
// approval loop stops having a provisioned submission MAC key to bootstrap.
data approval_bootstrap_circularity: DivergenceReason = DivergenceReason {
  statement: "the approval loop's own MAC keys cannot be provisioned by the approval loop; this is the one ceremony that is structurally the operator's, and it ran once on 2026-09-17" as NonEmptyStr,
  dissolution: retires_dissolution(ref: decl_ref(module_path: "gunbc.auth.approval_request_submission", decl_name: "approval_submission_mac_key_secret_ref")),
}

// BOUND TO THE DECLARED FORK ROW: when that dissolution row retires, the fork it names is gone and
// this reason with it.
data eager_bootstrap_fork_declared: DivergenceReason = DivergenceReason {
  statement: "gunbc.auth.access_token_source ensure_access_token_eager_bootstrap_fork_dissolve_on declares this eager gcloud call as a §3 fork with its dissolution condition" as NonEmptyStr,
  dissolution: retires_dissolution(ref: decl_ref(module_path: "gunbc.auth.access_token_source", decl_name: "ensure_access_token_eager_bootstrap_fork_dissolve_on")),
}

// THE DECLARATIONS THE BOUND TRIGGERS NAME, PRESENT BY CITATION. Each decl_ref here is checked by
// the required floor against the corpus, so a trigger whose subject was deleted cannot stay in this
// list. dissolution_status over it therefore answers Pending for every bound reason while its
// subject exists, and the witness asserts none is Fired -- the fold that replaces the sentence.
fn present_trigger_declarations() -> List<DeclarationRef> {
  [
    decl_ref(module_path: "gunbc.auth.approval_request_submission", decl_name: "approval_submission_mac_key_secret_ref"),
    decl_ref(module_path: "gunbc.auth.access_token_source", decl_name: "ensure_access_token_eager_bootstrap_fork_dissolve_on"),
  ]
}

// ── The roster ───────────────────────────────────────────────────────────────────────────────
// Read in groups, in order: the (a) exemplars (dispatched runs under the federated identity); the
// run-selected reads (federated in a dispatched run, the operator's own file in a session); the
// trigger itself, gunbc.cloudflare.r2_token_mint_run -- irreversible and value-returned-once, so a
// human witnesses it, and the run resolved the federated arm when dispatched and a relayed token in
// a session; the one-off accessor-cell grants, which are the grant administrator's session and never
// the workload; the entries with interactive gcloud bound at the call site -- the binding
// gunbc.auth.access_token_source names as "not a selection", each a follow-up now that the federated
// arm exists (two of them, managed_access_apply and fleet_multi_principal_probe, once carried
// gunbc.spark.credential_workflow spark_credential_access_token_frontier_note as a reason; its
// trigger has fired, and a reason whose trigger has fired is not a reason -- review 68577); and the
// (c) exemplar, the Cloudflare bootstrap token, which has no API. The first row is the approval broker's per-release helper grant
// (#12124): a recurring automated effect, realized by the dispatched run under the runner's own host
// principal and its roster-scoped sudo drop-in, with no human token relayed, so it is classified as
// the scoped-grant pattern. What it mints is resource-scoped: one exact argv, as one account, for
// one release. Annotations sit here rather than
// beside the rows because §4c admits them only at module-item grain.
// THE RUNNER-GROUP CREATE (gunbc.runner_group_restriction_ensure_run microvm_runner_group_after_gate)
// IS THE FIRST SITE REALIZED THROUGH THE APPROVAL CAPABILITY. The reach is the performing credential's:
// a gunbai-ci installation token holding organization self-hosted-runners write, which administers
// every runner group in the organization. That the dispatch_jit_mint row classifies the same token
// mint as resource-scoped is filed as gunbc.recurring_failure_mode
// one_credential_mint_classified_at_two_reaches and not changed here.
data privileged_effect_census: List<PrivilegedEffectSite> = [
  PrivilegedEffectSite {
    site: site(module_path: "gunbc.live_deploy.emit", decl_name: "approval_broker_helper_grant_steps"),
    effect: PrivilegedEffect {
      subject: "on every broker release, install one exact NOPASSWD grant letting the operator's account run that release's root-owned ntfy runtime-observe helper as gunbc-ntfy, replacing the previous release's grant" as NonEmptyStr,
      frequency: EveryProvision,
      reversibility: ReversibleByReapply,
      surface: ApiSurface,
