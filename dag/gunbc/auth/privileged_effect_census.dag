]

// A STANDING RULING IS HONORED ONLY BESIDE ITS INTERLOCK. InterlockPending never discharges and is
// always a defect. InterlockedBy discharges only when that hold is rostered against the same site.
fn ruling_interlock_is_rostered(site_ref: DeclarationRef, interlock: DeclarationRef) -> Bool {
  any(privileged_effect_interlocks, i =>
    declaration_ref_eq(a: i.site, b: site_ref)
      && match i.hold {
        Present { value: h } => declaration_ref_eq(a: h, b: interlock)
        Absent => false
      })
}

fn ruling_discharge_interlock_defect(site_ref: DeclarationRef, ruling: StandingDestructiveAuthorization) -> DeclarationRef? {
  match ruling.interlock {
    InterlockPending { obligation: _ } => Present { value: site_ref }
    InterlockedBy { hold: i } =>
      if ruling_interlock_is_rostered(site_ref: site_ref, interlock: i) { none } else { Present { value: site_ref } }
  }
}

fn rulings_without_a_rostered_interlock() -> List<DeclarationRef> {
  flat_map(privileged_effect_census, row =>
    match row.effect.witness_discharge {
      NoWitnessDischarge => []
      StandingRulingUnderInterlock { ruling: r } =>
        match ruling_discharge_interlock_defect(site_ref: row.site, ruling: r) {
          Absent => []
          Present { value: s } => [s]
        }
    })
}

// THE RULING AND THE CENSUS CANNOT DISAGREE ON THE ROOT POPULATION: the census sites that carry this ruling's
// discharge, and the ruling's own roots, are the same set (identity join, both directions).
fn discharged_by_ruling(v: PrivilegedEffectSite) -> Bool {
  match v.effect.witness_discharge {
    NoWitnessDischarge => false
    StandingRulingUnderInterlock { ruling: r } => (r.ruling_text as String) == (mtcollins1_operator_ruling.ruling_text as String)
  }
}

fn ruling_roots_missing_from_census() -> List<DeclarationRef> {
  let sites = map(filter(privileged_effect_census, row => discharged_by_ruling(v: row)), row => row.site)
  filter(mtcollins1_operator_ruling_roots, r => !declaration_ref_in_list(target: r, refs: sites))
}

fn census_sites_outside_ruling_roots() -> List<DeclarationRef> {
  filter(map(filter(privileged_effect_census, row => discharged_by_ruling(v: row)), row => row.site), s => !declaration_ref_in_list(target: s, refs: mtcollins1_operator_ruling_roots))
}

fn interlocked_sites_missing_from_census() -> List<DeclarationRef> {
  let rostered = map(privileged_effect_census, row => row.site)
  filter(map(privileged_effect_interlocks, i => i.site), s => !declaration_ref_in_list(target: s, refs: rostered))
}

// THE DIVERGENCE REASONS THAT RECUR, each stated once with its dissolution.
data interim_gcp_iam_adapter_unlanded: DivergenceReason = DivergenceReason {
  statement: "the approval loop's authority adapter for GCP IAM and Secret Manager effects is not landed on main (gunbc#11484 carried the approval loop's first executing consumer); until it lands the grant administrator's own session on the grant administrator's own workstation is the interim realization, and relaying that token through chat or a message is the refused pattern" as NonEmptyStr,
  dissolution: unbound_dissolution(description: "an approval-loop authority adapter that performs getIamPolicy/setIamPolicy and Secret Manager create/addVersion under a redeemed capability, executing as the grant administrator identity on the roadmap server; owner: this lane (nimble-otter-774), sequenced after gunbc#11734 and gunbc#11484" as NonEmptyStr),
}

data interim_cloudflare_adapter_unlanded: DivergenceReason = DivergenceReason {
  statement: "the approval loop has no authority adapter for Cloudflare account-token mints; the operator's workflow_dispatch of the mint stood as the informal witness on 2026-09-19, and the token this run resolved in a session was relayed into its file from chat -- the refused pattern, invisible to the file arm" as NonEmptyStr,
  dissolution: unbound_dissolution(description: "an approval-loop authority adapter that performs cloudflare.AccountTokens.Create for a one-off mint under a redeemed capability, so gunbc.cloudflare.r2_token_mint_run resolves no operator credential in any run; owner: this lane (nimble-otter-774), PR 2b after gunbc#11721 merges" as NonEmptyStr),
}

// THE GCP IAM CONVERGE'S RUNG, STATED WHERE THE CENSUS CAN SEE IT (operator decision B, 2026-09-25).
// The selection asks for an operator-approved capability; what is realized is a federated grant to
// iam-converge for one pinned job, with the approval enforced by that job's reviewed code refusing
// before it impersonates. That is a divergence, and this is its reason: approval-necessity lives in
// reviewed main code, not in the credential layer. The declared upgrade is the capability named in
// the dissolution; a keyed minter on srv1 was the other route and was withdrawn because the
// credential may not hard-depend on srv1.
data gcp_iam_approval_enforced_in_reviewed_code: DivergenceReason = DivergenceReason {
  statement: "the GCP IAM converge federates to iam-converge through a pool pinned to fleet-converge.yml at refs/heads/main, a workflow_dispatch on main and the gcp-iam-converge environment, and refuses before impersonating unless a recorded approval matches the re-derived diff. select_authorization_pattern still sees FederatedScopedGrant: frequency EveryProvision, reversible, ApiSurface, bindable workload identity, minted_reach MintsNoCredential (this site mints no new credential; it impersonates iam-converge). The git-ref pin is STS equality at reviewed main (operator 2026-10-10: not branch-dispatchable). Approval-necessity is enforced by the job's YAML on that reviewed file, not by STS -- a skipped gate on a branch YAML cannot federate because workflow_ref is not main. One pool serves both iam-observe and iam-converge: a second pool pinned to the same claims would add no separation" as NonEmptyStr,
  dissolution: unbound_dissolution(description: "a keyless GCP-hosted minter that verifies a device-signed approval against the enrolled key before issuing an iam-converge token, so that no federated workload identity holds a path to iam-converge without the operator's signature" as NonEmptyStr),
}

// STRUCTURAL, AND BOUND TO THE THING THAT MAKES IT STRUCTURAL: the reason retires only if the
// approval loop stops having a provisioned submission MAC key to bootstrap.
// THE GUNBAI-CI APP KEY IS A CEREMONY TRUST ROOT (gunbc.auth.gcp_iam_trust_roots gate_app_root_reason,
// ceremony OrgAdminAppKeyAccessConverge), so its binder is the ceremony's and no approval adapter may
// replace it: the dissolution is the gate App decision, not an adapter landing.
data gate_app_key_ceremony_trust_root: DivergenceReason = DivergenceReason {
  statement: "the gunbai-ci App private key may answer the gcp-iam-bootstrap deployment protection rule, so it is a ceremony trust root and only the first-time root ceremony binds its accessor cell; an approval-gated route binding it could open the gate it answers" as NonEmptyStr,
  dissolution: unbound_dissolution(description: "gunbc.auth.deployment_gate_authorization names the gate App on main; if that App is not gunbai-ci, this key leaves gunbc.auth.gcp_iam_trust_roots and its cell joins the converge's grant sets, and this row's site is deleted" as NonEmptyStr),
}

// THE ROOT CEREMONY IS STRUCTURALLY THE OPERATOR'S: it binds the identities and cells every approval
// is checked against or answered by (gunbc.auth.gcp_iam_trust_roots IamBootstrapApply), so no
// approval-gated route may perform it; it binds only root cells (gunbc.auth.gcp_iam_bootstrap_model
// iam_bootstrap_root_ceremony_bindings), and every other cell is the delta's.
data iam_bootstrap_root_ceremony_residual: DivergenceReason = DivergenceReason {
  statement: "the first-time root ceremony binds the cells that verify and answer approvals, so it cannot itself run under an approval; it binds only root cells, never a delta cell" as NonEmptyStr,
  dissolution: unbound_dissolution(description: "residual by construction (gunbc.auth.gcp_iam_bootstrap header); it narrows, cell by cell, as a root cell gains a tag-conditioned deny the delta identity cannot cross (gunbc.rung_drop gcp_iam_bootstrap_trust_root_wall_in_code)" as NonEmptyStr),
}

data approval_bootstrap_circularity: DivergenceReason = DivergenceReason {
  statement: "the approval loop's own MAC keys cannot be provisioned by the approval loop; this is the one ceremony that is structurally the operator's, and it ran once on 2026-09-17. All three are ceremony trust roots (gunbc.auth.gcp_iam_trust_roots, ceremony ApprovalMacKeyProvision), so no approval-gated route may bind their readers" as NonEmptyStr,
  dissolution: retires_dissolution(ref: decl_ref(module_path: "gunbc.auth.approval_request_submission", decl_name: "approval_submission_mac_key_secret_ref")),
}

// BOUND TO THE DECLARED FORK ROW: when that dissolution row retires, the fork it names is gone and
// this reason with it.
data arrival_archive_prefix_unobserved_world: DivergenceReason = DivergenceReason {
  statement: "the arrival wet door acquires the archive slot then refuses unobserved PriorLifeBoundary (arrival_wet_prefix_from_unobserved_world); it does not fold the PriorLifeBoundary prefix or write the archive, so RealizedFederatedGrant would claim a write this job does not perform" as NonEmptyStr,
  dissolution: unbound_dissolution(description: "NAMED CONSUMER: arrival_converge_under_archive_interlock. TRIGGER: that door binds an observed BMC/archive world and folds converge_mtjade1_arrival_prefix while holding ArrivalArchiveSlotHeld from arrival_archive_slot_acquire, then arrival_archive_slot_release. SUFFICIENT FOR retiring this reason and overlaying the archive census as RealizedFederatedGrant" as NonEmptyStr),
}

data firmware_qualification_writer_unlanded: DivergenceReason = DivergenceReason {
  statement: "the arrival wet door acquires the archive slot then refuses unobserved PriorLifeBoundary; firmware qualification has no writer under ArrivalArchiveSlotHeld, so RealizedFederatedGrant would claim a write this job does not perform" as NonEmptyStr,
  dissolution: unbound_dissolution(description: "NAMED CONSUMER: arrival_converge_under_archive_interlock. TRIGGER: a successor of converge_mtjade1_arrival_prefix performs the MegaRAC per-build qualification write while holding ArrivalArchiveSlotHeld from arrival_archive_slot_acquire, then arrival_archive_slot_release. SUFFICIENT FOR retiring this reason and overlaying StandingJadeFirmwareQualification as InterlockedBy arrival_archive_slot_acquire" as NonEmptyStr),
}

data eager_bootstrap_fork_declared: DivergenceReason = DivergenceReason {
  statement: "gunbc.auth.access_token_source ensure_access_token_eager_bootstrap_fork_dissolve_on declares this eager gcloud call as a §3 fork with its dissolution condition" as NonEmptyStr,
  dissolution: retires_dissolution(ref: decl_ref(module_path: "gunbc.auth.access_token_source", decl_name: "ensure_access_token_eager_bootstrap_fork_dissolve_on")),
}

// THE RENTED-HOST SSH PERMIT CHECKS A CALLER-SUPPLIED ScopedAuthorization, NOT A REDEEMED APPROVAL (review 79089). rented_host_permit runs
// std.scoped_authorization authorize over the authorizations it is handed, and its production list is empty, so nothing files an
// AccessRequest or redeems an ApprovalCapability for this effect yet; claiming the selected pattern as realized would be the inflation §4b(1) forbids.
data rented_host_permit_unredeemed: DivergenceReason = DivergenceReason {
  statement: "gunbc.serving.rented_host_grant rented_host_permit authorizes the rented-host SSH effect against caller-supplied ScopedAuthorizations (rented_host_authorizations is empty in production); no AccessRequest is filed and no ApprovalCapability is redeemed through gunbc.auth.approval_broker redeem_capability, so the selected OperatorApprovedCapability pattern is not the one the site enforces; production stays fail-closed only because the authorization population is empty and the clock is unread, so a change that supplies a usable authorization or a clock reading before approval filing and redemption land makes this site enforce the wrong pattern" as NonEmptyStr,
  dissolution: unbound_dissolution(description: "the rental-record handover (C4b) files an AccessRequest for the rented-host SSH effect and the permit is minted only from a capability redeemed through gunbc.auth.approval_broker redeem_capability, so rented_host_authorizations is derived from a redemption rather than supplied" as NonEmptyStr),
}

// THE FABRIC STORE'S PROTECTED HEADS ARE WRITTEN UNDER HOST ACCESS ALONE (operator ruling A,
// 2026-09-27, relayed by proud-deer-538). The pair-serving authority partitions, the host-placement
// partition and the D0 consent slots are advanced by whoever reaches the fabric DB -- the placed
// host in process, every other host through the served door -- and the store verifies no grant for
// the operation. The rows below carry what each writer's selection asks for, so the door that
// verifies it has a derived answer per writer rather than one grant vocabulary for all of them.
// D0's door does gate on an approval before it writes, but the effect a row counts is the STORE
// write, and the store does not see that approval: any writer reaching the DB performs the same
// advance without it, so D0's row realizes RealizedUnauthorized like the rest (review 71933).
// THE DISSOLUTION IS UNBOUND ON PURPOSE. The store-operation wall (now named at its home,
// gunbc.fabric.fabric_store_operation_admission, since D0 was deleted) is not retired when the capability
// lands -- it is flipped to StoreOperationWallRestored -- so retires_dissolution over it would fire
// on the row's deletion, an artifact, while the capability stayed dead (§4b(3)).
data fabric_store_write_unverified: DivergenceReason = DivergenceReason {
  statement: "the fabric DB admits an advance of a pair-serving authority partition, the host-placement partition or a consent slot on the writer's host access alone: the placed host writes in process (FabricStorageLocalFiles) and the served door carries no grant, so the pattern selected for this writer is not the one the store enforces" as NonEmptyStr,
  dissolution: unbound_dissolution(description: "one fabric store door every writer passes, the placed host included, that admits an advance of a protected head only under the credential this writer's selected pattern names, verified by the store for that operation -- that is, gunbc.fabric.fabric_store_operation_admission admit_store_operation enforcing on every write path, the placed host's in-process writes included (D0, which first named this wall, was deleted with Group A on 2026-10-07; the per-operation door it named is that module)" as NonEmptyStr),
}

// THE DECLARATIONS THE BOUND TRIGGERS NAME, PRESENT BY CITATION. Each decl_ref here is checked by
// the required floor against the corpus, so a trigger whose subject was deleted cannot stay in this
// list. dissolution_status over it therefore answers Pending for every bound reason while its
// subject exists, and the witness asserts none is Fired -- the fold that replaces the sentence.
fn present_trigger_declarations() -> List<DeclarationRef> {
  [
    decl_ref(module_path: "gunbc.auth.approval_request_submission", decl_name: "approval_submission_mac_key_secret_ref"),
    decl_ref(module_path: "gunbc.auth.access_token_source", decl_name: "ensure_access_token_eager_bootstrap_fork_dissolve_on"),
  ]
}

// ── The roster ───────────────────────────────────────────────────────────────────────────────
// Read in groups, in order: the (a) exemplars (dispatched runs under the federated identity); the
// run-selected reads (federated in a dispatched run, the operator's own file in a session); the
// trigger itself, gunbc.cloudflare.r2_token_mint_run -- irreversible and value-returned-once, so a
// human witnesses it, and the run resolved the federated arm when dispatched and a relayed token in
// a session; the one-off accessor-cell grants, which are the grant administrator's session and never
// the workload; the entries with interactive gcloud bound at the call site -- the binding
// gunbc.auth.access_token_source names as "not a selection", each a follow-up now that the federated
// arm exists (two of them, managed_access_apply and fleet_multi_principal_probe, once carried
// gunbc.spark.credential_workflow spark_credential_access_token_frontier_note as a reason; its
// trigger has fired, and a reason whose trigger has fired is not a reason -- review 68577); and the
// (c) exemplar, the Cloudflare bootstrap token, which has no API. The first row is the approval broker's per-release helper grant
// (#12124): a recurring automated effect, realized by the dispatched run under the runner's own host
// principal and its roster-scoped sudo drop-in, with no human token relayed, so it is classified as
// the scoped-grant pattern. What it mints is resource-scoped: one exact argv, as one account, for
// one release. Annotations sit here rather than
// beside the rows because §4c admits them only at module-item grain.
// THE RUNNER-GROUP CREATE (gunbc.runner.runner_group_restriction_ensure_run microvm_runner_group_after_gate)
// IS THE FIRST SITE REALIZED THROUGH THE APPROVAL CAPABILITY. The reach is the performing credential's:
// a gunbai-ci installation token holding organization self-hosted-runners write, which administers
// every runner group in the organization. That the dispatch_jit_mint row classifies the same token
// mint as resource-scoped is filed as gunbc.recurring_failure_mode
// one_credential_mint_classified_at_two_reaches and not changed here.
// THE D0 RELEASE UNDER THE GROUP A STANDING GRANT (review 74624) is its own row, site
// gunbc.spark.pair_serving_d0_door d0_standing_grant_for: the same door as pair_serving_d0_ci_wet, a
// different effect and a different authorization route. A release-to-fleet whose group and every host the
// committed standing grant covers is admitted by that grant, never filed to the broker. The selection
// decides the pattern from the effect's parameters with the ruling as the witness discharge, conditional on
// its interlock (D0's durable claim, rostered in privileged_effect_interlocks); the census does not assert it.
// Printing spends material and moves hardware. A federated secret read alone is not
// the selected authority for that irreversible effect; the common start gate also
// verifies approval, observes IDLE and atomically claims the approved escalation.
fn printer_start_effect() -> PrivilegedEffect {
 PrivilegedEffect {subject:"start one digest-bound physical printer job",frequency:EveryOperatorRequest,
  reversibility:IrreversibleEffect {what_is_lost:"filament and the prior physical bed state"},surface:ApiSurface,
  workload_identity:WorkloadIdentityBindable {member:federated_service_account_member(email:printer_service_account) as NonEmptyStr},
  minted_reach:MintsNoCredential,billing:NoBillingConsequence,witness_discharge:NoWitnessDischarge}
}
data printer_approval_enforced_in_reviewed_code: DivergenceReason = DivergenceReason {
 statement:"The dedicated WIF reader authenticates the printer workflow, while reviewed code enforces the signed ntfy approval, fresh IDLE observation and fixed durable claim before start. The provider credential itself does not require redemption of that print capability.",
 dissolution:unbound_dissolution(description:"A printer credential/effect broker that cryptographically requires the device-approved intent and consumes its durable claim before issuing the exact start, independent of caller code; owner: printer workflow lane.")
}
data publication_helper_host_key_mint: DivergenceReason = DivergenceReason {
  statement: "select_authorization_pattern selects FederatedScopedGrant (EveryProvision, bindable identity, resource-scoped mint). The helper realizes a host-file mint: fleet-converge places agent-github-app-private-key on srv1, and gunbc-publication signs from that file. That is not in-process WIF. The host key can mint ANY permission the gunbai-bot installation holds, not only the narrowed token. Environments share the PROD App (gunbc.auth.github_apps publication_environments_share_prod_gunbai_bot)." as NonEmptyStr,
  dissolution: unbound_dissolution(description: "NAMED CAPABILITY: the publication helper mints through a federated, per-environment App whose key never rests as a host file that can request the installation's full grant. SUFFICIENT FOR deleting this reason. NOT satisfied by narrowing the minted token while the host key remains, nor by keeping gunbai-bot for every environment. Owner: this publication-helper lane."),
}

data printer_operator_token_transition: DivergenceReason = DivergenceReason {
 statement:"The explicit operator compatibility entries bind an operator token file while the printer federation and guarded dispatch are unlanded. A local file is not evidence that the credential was never relayed. The physical start still requires the shared approval/IDLE/durable-claim gate; observation grants no start. This route is classified as operator session, not disguised as federation.",
 dissolution:unbound_dissolution(description:"Retire the operator-token printer entries after the main-pinned printer workflow and LAN host state are deployed and an approved print is observed under its dedicated WIF identity; owner: printer workflow lane.")
}
// THE OPERATOR'S 2026-10-03 RUNNER-LIFECYCLE RULING, VERBATIM, AND THE OPERATOR'S 2026-10-05 SCOPE
// RULING BESIDE IT. The 10-03 text names registration and deregistration and is never rewritten to
// say more. Its scope beyond those words is the operator's own second ruling, decided through
// escalation msg_5756a200-fcb5-470a-87eb-40867bfe9cdb: no agent's reading discharges a site (review
// 76234, DESIGN §5: approval is external to the diff, so the row cites where the operator decided).
// covers is the single source of the operator's scope: no census row may take the 10-03 discharge
// unless covers names its site. The converse does not hold, on purpose: a covered site whose effect
// the selection already federates on its own parameters -- registration, deregistration and the
// reversible branch create and delete -- does not consume the discharge, and only a consumer owes a
// rostered interlock. The dispatch, being irreversible, is the one consumer.
// THE DEDICATED GROUP'S SELECTED-WORKFLOW PIN IS NOT UNDER EITHER RULING. ensure_qualification_ref_pin
// is listed for its branch create; the group pin it performs in the same function is authorized by
// its own federated standing -- the census row's own parameters, selected without any discharge --
// and the 10-03 and 10-05 rulings say nothing about it (eager-gull-22, 2026-10-05). The interlock is the
// host-generic unit hold (gunbc.host.managed_host_unit_hold UnitHoldProof): the dispatch takes the proof
// and refuses unless it is the slot's own host's.
data runner_lifecycle_operator_ruling: StandingDestructiveAuthorization = StandingDestructiveAuthorization {
  ruling_text: "Runner registration and deregistration are PRE-APPROVED. Approval moves up to the workflow dispatcher (the fleet-converge run's own authorization). There is no per-registration approval step. Classify this through gunbc.auth.authorization_pattern_selection, recording that ruling rather than a per-effect ntfy approval. (operator decision, 2026-10-03)" as NonEmptyStr,
  effect_subject: "ephemeral JIT runner lifecycle: registration and deregistration" as NonEmptyStr,
  interlock: InterlockedBy { hold: decl_ref(module_path: "gunbc.host.managed_host_unit_hold", decl_name: "UnitHoldProof") },
}

type OperatorScopeRuling {
  ruling: StandingDestructiveAuthorization
  scope_text: NonEmptyStr
  decided_on: NonEmptyStr
  decided_through: NonEmptyStr
  covers: List<DeclarationRef>
}

data runner_lifecycle_scope_ruling: OperatorScopeRuling = OperatorScopeRuling {
  ruling: runner_lifecycle_operator_ruling,
  scope_text: "decision: 'Yes, confirm the wider scope' (operator, 2026-10-05). Scope as relayed with it by quiet-stag-623 (msg_24760d96-078a-46cf-809e-2c92968dba31): the 2026-10-03 runner pre-approval covers registration, deregistration, the qualification CreateDispatch on that attempt's runner, and the per-attempt qualification/<attempt> branch create and delete" as NonEmptyStr,
  decided_on: "2026-10-05" as NonEmptyStr,
  decided_through: "escalation msg_5756a200-fcb5-470a-87eb-40867bfe9cdb" as NonEmptyStr,
  covers: [
    decl_ref(module_path: "gunbc.runner.runner_jit_perform", decl_name: "dispatch_jit_mint"),
    decl_ref(module_path: "gunbc.runner.runner_jit_deregistration", decl_name: "ensure_jit_runner_deregistered"),
    decl_ref(module_path: "gunbc.runner.runner_qualification_dispatch", decl_name: "dispatch_qualification_floor"),
    decl_ref(module_path: "gunbc.runner.runner_qualification_ref_pin", decl_name: "ensure_qualification_ref_pin"),
    decl_ref(module_path: "gunbc.runner.runner_qualification_ref_pin", decl_name: "remove_qualification_ref_pin"),
  ],
}

// A SITE IS DISCHARGED BY THE RULING ONLY WHILE THE OPERATOR'S SCOPE RULING NAMES IT. Removing a site
// from covers turns its discharge into NoWitnessDischarge, and the selection then decides it afresh.
fn ruling_discharge_for(scope: OperatorScopeRuling, site_ref: DeclarationRef) -> WitnessDischarge {
  if declaration_ref_in_list(target: site_ref, refs: scope.covers) {
    StandingRulingUnderInterlock { ruling: scope.ruling }
  } else {
    NoWitnessDischarge
  }
}

// ── THE srv1 JOB USER'S WHOLE-BINARY SUDO GRANTS (gunbc.plans.srv1_deploy_principal_split) ─────────
// Each row below is an effect the deploy performs through ghrunner's whole-binary NOPASSWD sudo
// (gunbc.ci.ci_deploy_sudoers rendering gunbc.fleet.fleet_posix_accounts fleet_posix_ci_runner_sudo_grants).
// The effect is characterized by the reach IT needs, not by the reach of the grant that happens to
// carry it; the grant is what makes the realization RealizedUnauthorized (no credential names the
// effect) and is the divergence this reason states. One reason covers the rows because one
// transition retires them all.
data interim_job_user_whole_binary_grants: DivergenceReason = DivergenceReason {
  statement: "the effect runs under the CI job user's path-only whole-binary sudo grant, which is root-equivalent and held by the account every srv1 job runs as, so the effect is authorized by no credential that names it (rung drop the_job_user_holds_a_path_unrestricted_root_grant)" as NonEmptyStr,
  dissolution: unbound_dissolution(description: "NAMED CAPABILITY: the srv1 deploy route runs its host-root effects under the administrator edge from a main-pinned dispatch and the whole-binary rows are deleted from ci_runner_sudo_binaries (plan stage 2), gated by deploy_route_switch_admitted. SUFFICIENT FOR overlaying these rows as RealizedAdministratorEdge (host-root rows) or RealizedFederatedGrant (the argv-pinned systemctl row)" as NonEmptyStr),
}

// THE CONTROLLER INSTALL HAS NO GRANT AT ALL, which is not the whole-binary case: dd and install into
// /etc/systemd/system are named by no rendered or live sudoers line, so the effect is refused at its
// first write (recurring failure mode a_plan_emits_a_privileged_argv_its_hosts_grants_do_not_authorize,
// run 39284886844). Granting it to the job user would make that account root-equivalent.
data controller_install_holds_no_grant: DivergenceReason = DivergenceReason {
  statement: "the effect's root writes (dd/install into /etc/systemd/system and /usr/local) are authorized by no grant, so the apply is refused at its first privileged line; the only realization that exists is the operator running it locally" as NonEmptyStr,
  dissolution: unbound_dissolution(description: "NAMED CAPABILITY: the controller install runs its host-root writes under the administrator edge from the main-pinned deploy slot, gated by deploy_route_switch_admitted (plan gunbc.plans.srv1_deploy_principal_split, controller-install scope addition). Sufficient only when the install's argv are emitted through the edge and no job-user sudoers line names them." as NonEmptyStr),
}

fn srv1_host_root_effect(subject: NonEmptyStr) -> PrivilegedEffect {
  PrivilegedEffect {
    subject: subject,
    frequency: EveryProvision,
    reversibility: ReversibleByReapply,
    surface: ApiSurface,
    workload_identity: WorkloadIdentityUnbindable { cause: "no cloud workload identity names a root write on a fleet host; the identity that reaches it is the administrator principal over SSH" as NonEmptyStr },
    minted_reach: MintsHostRootReach,
    billing: NoBillingConsequence,
    witness_discharge: NoWitnessDischarge,
  }
}

// ── THE MANUAL-STEP CENSUS (gunbc node adhoc-28759c44-922) ───────────────────────────────────
// Sites where the effect has an API or a modeled member and is nevertheless performed by an
// operator's hand today. The selection asks for the approval route (or the administrator edge);
// what is realized is a person following an instruction. Each reason names the capability whose
// arrival moves the site onto the route, so the divergence is counted and retired by its trigger.
data manual_api_effect_beside_unlanded_approval_adapter: DivergenceReason = DivergenceReason {
  statement: "the effect has an API surface, but the approval loop has no authority adapter that performs it under a redeemed capability, so an operator performs it by hand in their own session and the instruction text is the only record that it happened (completion_evidence is NoDischargeSiteModeled or a dashboard act no fold observes)" as NonEmptyStr,
  dissolution: unbound_dissolution(description: "an authority adapter, registered against gunbc.auth.approval_broker redeem_capability, that performs this one effect under a redeemed ApprovalCapability and reads the result back, so the step's entry point requests the capability (gunbc.auth.access_request) instead of emitting an instruction. NOT satisfied by modeling the instruction, nor by a converge member that applies without post-apply readback" as NonEmptyStr),
}

data review_sheet_writer_cell_outside_the_converge_projects: DivergenceReason = DivergenceReason {
  statement: "the cell sits on review-sheet-writer's policy in gunbai-sheets, and every role the approval-gated IAM converge and its bootstrap delta hold is a project custom role of the fleet secrets project, which cannot be bound on a resource in another project; so no approval route reaches it, and the operator writes it once in their own session (stern-ram-763, 2026-10-25: chosen over giving iam-converge standing reach into gunbai-sheets)" as NonEmptyStr,
  dissolution: unbound_dissolution(description: "an approval-gated route whose actuator may write the writer's policy without standing project reach in gunbai-sheets -- an organization-level custom role bound on that one account, or an authority adapter under a redeemed ApprovalCapability -- that writes this one cell and reads it back under an independent observer" as NonEmptyStr),
}

data github_environment_gate_is_not_the_approval_route: DivergenceReason = DivergenceReason {
  statement: "a GitHub environment's required-reviewer gate is a human click in the GitHub UI: it authorizes a whole job rather than one effect, binds no device-signed consent to the effect's parameters, and leaves its protection setting (reviewers, deployment branch rule) as a repository-settings fact the workflow file cannot carry or observe" as NonEmptyStr,
  dissolution: unbound_dissolution(description: "the job requests an access_request for its re-derived effect and proceeds only on a redeemed ApprovalCapability (gunbc.auth.approval_broker redeem_capability) delivered by the iOS approval app, with the environment reduced to a branch rule. NOT satisfied by adding reviewers to the environment" as NonEmptyStr),
}

fn manual_srv1_root_effect(subject: NonEmptyStr, step: HumanIntervention) -> PrivilegedEffect {
  PrivilegedEffect {
    subject: subject,
    frequency: step.frequency,
    reversibility: ReversibleByReapply,
    surface: ApiSurface,
    workload_identity: WorkloadIdentityUnbindable { cause: "no cloud workload identity names a root write on a fleet host; the identity that reaches it is the administrator principal over SSH" as NonEmptyStr },
    minted_reach: MintsHostRootReach,
    billing: NoBillingConsequence,
    witness_discharge: NoWitnessDischarge,
  }
}

// THE srv1 ROOT STEPS THE OPERATOR RUNS BY HAND AND THE PER-DISPATCH ENVIRONMENT GATE. Operator ruling
// 2026-10-22 (gunbc.design_ruling one_approval_route_for_every_privileged_action): host-root reach that a
// human can attend is approved through the broker route alone, so each row selects
// OperatorApprovedCapability and diverges because the realization is a person or a GitHub click.
data srv1_root_step_by_hand_beside_the_broker_route: DivergenceReason = DivergenceReason {
  statement: "the effect is a host-root write on srv1 that the operator performs by hand over ssh from rendered instructions; the operator ruling of 2026-10-22 names the approval broker route as its only approval, and no authority adapter requests a capability for it, so the instruction text is the only record that it happened" as NonEmptyStr,
  dissolution: unbound_dissolution(description: "NAMED CAPABILITY: the step's entry point files an access_request (gunbc.auth.access_request) for its re-derived effect and the host-root write executes only on a redeemed ApprovalCapability (gunbc.auth.approval_broker redeem_capability) delivered by the iOS approval app, with post-apply readback. NOT satisfied by modeling the instruction or by the administrator edge" as NonEmptyStr),
}

// THE FLEET HOST FILE CONVERGE (gunbc.runner.runner_host_file_converge). Its root writes -- the teardown and
// depriv drop-ins, the needrestart deferral, the unit fragment, the slot caps and the job user's sudoers, each
// with mode and owner readback -- and the cap bracket's mask, restart and release run as the declared
// administrator (gunbc.fleet.fleet_bootstrap_principal executor_bootstrap_principal) over the fleet SSH edge.
// The fleet key reaches the job only through the fleet identity, whose pins are reviewed main and
// workflow_dispatch (gunbc.auth.oidc_claim_pins fleet_converge_workflow_claim_pins), and the mode is not a
// run-scoped branch mode (gunbc.auth.branch_dispatch_federation run_scoped_modes), so what is realized is the
// administrator edge as pattern_label states it. The mode is reached only by a workflow_dispatch in which the
// operator names the host (gunbc.fleet.fleet_converge_workflow fleet_converge_runner_host_file_step), so the
// effect is EveryOperatorRequest: a human attends every instance. Under the 2026-10-22 ruling the selection
// therefore names the approval capability and not the edge, and the row diverges. The edge predates the
// ruling; this states the gap and does not change the realization.
data fleet_host_file_converge_edge_beside_the_broker_route: DivergenceReason = DivergenceReason {
  statement: "the fleet host file converge writes root-evaluated files and masks, restarts and re-admits runner slots as the administrator over the fleet SSH edge, under a key released only to a main-pinned dispatch; every instance is a dispatch in which the operator names the host, so a human attends it, and the operator ruling of 2026-10-22 names the approval broker route as the only approval for attendable host-root reach. No authority adapter requests a capability for this mode, so the dispatch click and the merge to main are its only consent" as NonEmptyStr,
  dissolution: unbound_dissolution(description: "NAMED CAPABILITY: the runner_host_file_converge mode files an access_request (gunbc.auth.access_request) for its re-derived per-host write and actuation set and executes them only on a redeemed ApprovalCapability (gunbc.auth.approval_broker redeem_capability), with the existing post-apply readback. NOT satisfied by a GitHub environment reviewer gate or by the administrator edge alone. A converge that stops being operator-dispatched and runs unattended on every provision is a different effect: its frequency changes, the selection re-derives the edge, and this reason no longer applies" as NonEmptyStr),
}

fn fleet_host_root_effect_on_dispatch(subject: NonEmptyStr) -> PrivilegedEffect {
  PrivilegedEffect {
    subject: subject,
    frequency: EveryOperatorRequest,
    reversibility: ReversibleByReapply,
    surface: ApiSurface,
    workload_identity: WorkloadIdentityUnbindable { cause: "no cloud workload identity names a root write on a fleet host; the identity that reaches it is the administrator principal over SSH" as NonEmptyStr },
    minted_reach: MintsHostRootReach,
    billing: NoBillingConsequence,
    witness_discharge: NoWitnessDischarge,
  }
}

fn manual_operator_api_effect(subject: NonEmptyStr, step: HumanIntervention, cause: NonEmptyStr, reach: MintedCredentialReach) -> PrivilegedEffect {
  PrivilegedEffect {
    subject: subject,
    frequency: step.frequency,
    reversibility: ReversibleByReapply,
    surface: ApiSurface,
    workload_identity: WorkloadIdentityUnbindable { cause: cause },
    minted_reach: reach,
    billing: NoBillingConsequence,
    witness_discharge: NoWitnessDischarge,
  }
}

// A step with no API. Frequency is read from the intervention the corpus already models, and the
// cause and billing are the caller's facts: a console act and a billed dashboard signup are different
// effects, so neither is fixed here.
fn manual_no_api_effect(subject: NonEmptyStr, step: HumanIntervention, cause: NonEmptyStr, billing: BillingConsequence) -> PrivilegedEffect {
  PrivilegedEffect {
    subject: subject,
    frequency: step.frequency,
    reversibility: ReversibleByReapply,
    surface: HumanSurfaceOnly { step: step },
    workload_identity: WorkloadIdentityUnbindable { cause: cause },
    minted_reach: MintsNoCredential,
    billing: billing,
    witness_discharge: NoWitnessDischarge,
  }
}

fn manual_physical_effect(subject: NonEmptyStr, step: HumanIntervention) -> PrivilegedEffect {
  manual_no_api_effect(subject: subject, step: step, cause: "the act happens at the machine's console; no API reaches it" as NonEmptyStr, billing: NoBillingConsequence)
}

data privileged_effect_census: List<PrivilegedEffectSite> = [
  PrivilegedEffectSite {
    site: site(module_path: "gunbc.auth.approval_ntfy_deployment", decl_name: "approval_ntfy_account_intervention"),
    effect: manual_srv1_root_effect(step: approval_ntfy_account_intervention(), subject: "create the gunbc-ntfy system account on srv1 (operator runs the rendered command over ssh)" as NonEmptyStr),
    realized: RealizedHumanStep,
    divergence_reason: Present { value: srv1_root_step_by_hand_beside_the_broker_route },
