// ── THE FOLLOW-UPS, RANKED, AS A MONOTONE DEBT CONTRACT AT IDENTITY GRAIN ────────────────────
// The unreasoned divergences the census finds today are rostered here BY SITE IDENTITY and in the
// order they should be worked (widest credential first, then the recurring reads bound to an
// interactive session). The witness joins this roster against the census in both directions: a new
// site that diverges with no reason and is not rostered is red, and a rostered site that no longer
// diverges is red until its row is removed with the migration that fixed it. That is DESIGN §5's
// admitted debt shape -- an independently enumerated, closed subject universe, membership at
// identity grain, every removal carried by the change that earns it -- and not a count.
data follow_up_sites: List<DeclarationRef> = [
  site(module_path: "gunbc.gcp_estate_read_instrument", decl_name: "gcloud_read_argv"),
  site(module_path: "gunbc.auth.credentials", decl_name: "gcp_secret_credential"),
  site(module_path: "gunbc.bmc_fan_converge", decl_name: "bmc_fan_run"),
  site(module_path: "gunbc.srv3_bmc_credential_resolve", decl_name: "materialize_bmc_login_password"),
  site(module_path: "gunbc.tools.bmc_onboard", decl_name: "srv3_converge_credential"),
  site(module_path: "gunbc.spark.managed_access_apply", decl_name: "spark_managed_access_apply_wet"),
  site(module_path: "gunbc.fleet_multi_principal_probe", decl_name: "fleet_multi_principal_probe_with_attempt"),
  site(module_path: "gunbc.fleet.printer_delivery_wet_run", decl_name: "run"),
  site(module_path: "tools.fabric_m0_origin_object_probe", decl_name: "probe_token_source"),
]

// ── Consumers ────────────────────────────────────────────────────────────────────────────────
fn census_verdicts() -> List<SiteVerdict> {
  map(privileged_effect_census, row => site_verdict(row: row))
}

fn verdict_is_unreasoned_divergence(v: SiteVerdict) -> Bool {
  match v.conformance {
    Diverges => true
    Conforms => false
    DivergesWithReason { reason: _ } => false
    SiteNotDecidable { standing: _ } => false
  }
}

fn verdict_is_undecidable(v: SiteVerdict) -> Bool {
  match v.conformance {
    SiteNotDecidable { standing: _ } => true
    Conforms => false
    DivergesWithReason { reason: _ } => false
    Diverges => false
  }
}

fn unreasoned_divergences() -> List<SiteVerdict> {
  filter(census_verdicts(), v => verdict_is_unreasoned_divergence(v: v))
}

fn undecidable_sites() -> List<SiteVerdict> {
  filter(census_verdicts(), v => verdict_is_undecidable(v: v))
}

// THE IDENTITY JOIN between what the census finds unreasoned and what the follow-up roster admits.
// Both directions: a found site the roster does not name is undeclared debt; a rostered site the
// census no longer finds is a paid debt whose row was not retired. Both are executed by
// test.claim.authorization_pattern_selection_witness, which is the census's consumer.
fn unrostered_unreasoned_divergences() -> List<DeclarationRef> {
  filter(map(unreasoned_divergences(), v => v.site), s => !declaration_ref_in_list(target: s, refs: follow_up_sites))
}

fn rostered_but_not_diverging() -> List<DeclarationRef> {
  let found = map(unreasoned_divergences(), v => v.site)
  filter(follow_up_sites, s => !declaration_ref_in_list(target: s, refs: found))
}

// ── The reasoned side of the debt: every stated reason's trigger, checked ────────────────────
type ReasonedDivergence {
  site: DeclarationRef
  reason: DivergenceReason
}

fn reasoned_divergences() -> List<ReasonedDivergence> {
  flat_map(census_verdicts(), v =>
    match v.conformance {
      DivergesWithReason { reason: r } => [ReasonedDivergence { site: v.site, reason: r }]
      Conforms => []
      Diverges => []
      SiteNotDecidable { standing: _ } => []
    })
}

fn reason_trigger_fired(r: ReasonedDivergence) -> Bool {
  match dissolution_status(condition: r.reason.dissolution, present_decls: present_trigger_declarations()) {
    DissolutionFired => true
    DissolutionPending => false
    DissolutionUnbound => false
  }
}

// A REASON WHOSE TRIGGER HAS FIRED IS NOT A REASON (review 68577), now as a fold rather than a
// sentence: such a site belongs in follow_up_sites, not behind a statement.
fn reasoned_divergences_with_fired_triggers() -> List<ReasonedDivergence> {
  filter(reasoned_divergences(), r => reason_trigger_fired(r: r))
}

// THE FREQUENCY DIVERGENCE IS A DECLARED STALL, AND THIS IS ITS CARRIER (review 69643). The census
// row for app_registration_submit_intervention reads FleetOnce while the step it embeds reads
// EveryProvision. That is a STATED divergence rather than an oversight (DESIGN §3b: the middle value
// is admitted, the unstated one is the red), and the two answer different questions through one
// shared type: the step's axis is burden multiplicity -- how this human cost scales -- while the
// row's is an attendance premise.
//
// THE CONSEQUENCE OF NOT DIVERGING WAS MEASURED, NOT GUESSED. With the row deriving its frequency
// from the step, select_authorization_pattern returns NoAdmissiblePattern and the site lands in
// undecidable_sites: EVERY candidate, HumanOnlyStep included, violates
// constraint_unattended_required, because no pattern completes an effect with no API and no human.
// That verdict would be the selection faithfully reporting a premise this row does not hold -- an
// effect GitHub requires an owner to perform is not one that must run unattended -- so adopting the
// step's value would assert something false about the effect in order to make two fields agree.
//
// THIS PARAGRAPH USED TO SIT INSIDE THE CENSUS LIST, BESIDE THE ROW, AND THAT WAS TWO DEFECTS AT
// ONCE. It put the whole stall where no Accepted program could read it -- DESIGN §6 says the mark on
// the CARRIER is the authority rather than a parallel ledger, and §4c says an annotation is never
// evidence that a machine claim holds. And an annotation inside a declaration body is not modeled at
// all: the module carried a parse refusal for it, which this move clears. The reasoning survives
// here because it is irreducible rationale about why the construction has its shape; the CLAIM that
// the stall is declared, and the capability that retires it, now live on the row below.
//
// divergence_reason STAYS none ON THE ROW, and that is not an oversight. That field carries
// realized-vs-selected, where RealizedHumanStep and HumanOnlyStep genuinely do agree; the frequency
// question is a different axis, which is precisely why it needs its own carrier instead of being
// pressed into a field that answers something else.
data human_intervention_frequency_frontier_rows: List<FrontierRow> = [
  frontier_row_decl(
    ref: decl_ref(module_path: "std.human_intervention", decl_name: "HumanInterventionFrequency"),
    reason: "one type answers two questions, so two honest readings of the same effect disagree by construction. The intervention roster reads HumanInterventionFrequency as BURDEN MULTIPLICITY -- how many times an operator performs this -- and unattended_required reads it as an ATTENDANCE PREMISE -- whether the effect must complete with nobody present. Registering the census App is once per fleet on the first reading and requires an owner in a browser on the second, so the census row and the step it embeds carry different values of one type without either being wrong. No consumer can currently tell which reading it is getting",
    dissolution: unbound_dissolution(
      description: "NAMED CAPABILITY: HumanInterventionFrequency is split into the two questions it conflates, so burden multiplicity and attendance premise are separate declared facts and every consumer names which one it reads. SUFFICIENT FOR a privileged-effect row and the human step it embeds to agree by construction rather than by a stated divergence, and for select_authorization_pattern to evaluate unattended_required against the attendance fact instead of against a multiplicity count. NOT satisfied by adopting the step's value on this row, which would assert that an effect GitHub requires an owner to perform must run unattended; nor by widening divergence_reason, which carries realized-vs-selected and answers a different question"
    )
  )
]
