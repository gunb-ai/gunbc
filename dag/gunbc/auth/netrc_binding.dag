module gunbc.auth.netrc_binding

import std.types { NonEmptyStr, String, Bool, Secret, FilePath }
import extdeps.shell
import extdeps.filesystem.filesystem_io

// A CREDENTIAL BINDING: THE ONE SANCTIONED WAY A SECRET REACHES A SUBPROCESS ON THIS FLEET.
//
// WHY THIS MODULE EXISTS RATHER THAN A SECOND COPY OF THE SAME TEN LINES. gunbc.credential_argv_exposure
// records, as a measured incident rather than as hygiene, that an argv word on these hosts is readable
// by any job payload on a runner slot: /proc carries no hidepid, /proc/PID/cmdline is mode 0444, and the
// runner slots sit in the host pid namespace. The repair adopted for Redfish was to delete the
// `-u {username}:{password}` arms entirely and authenticate through a 0600 netrc. When the printer FTPS
// channel needed the same thing, the tempting move was to copy netrc_content across -- which would have
// made the mode, the creation flag, and the shred order three facts with two homes, so that hardening one
// silently leaves the other behind. Two consumers is exactly the point at which the shared authority is
// justified, and this is it.
//
// THE BINDING IS SEALED, WHICH IS THE WHOLE GUARANTEE. If a command builder took a plain FilePath, a
// caller could hand it any path at all -- one written with the ambient umask, one belonging to another
// user, one that does not exist -- and the builder would emit an argv that looks identical to the safe
// one. sole_constructor means the only way to obtain a NetrcBinding is to have gone through
// place_netrc_binding, so possessing the value IS the evidence that the bytes were created owner-only.
// The type is not a label asserting the property; it is unreachable without it.
// WHAT THE SEAL DOES NOT ESTABLISH, said plainly because the alternative is a wrapper that reads
// stronger than it is. sole_constructor makes "these bytes were created owner-only" a MINT-TIME fact.
// It does not bound the binding's LIFETIME: nothing in the substrate stops a holder from carrying the
// value past its shred and spending it later, at which point the path may have been replaced, chmod-ed
// or emptied, and the seal would still read as evidence. That is the same verified-once-spent-later
// decay this lane has already met twice, and prose asserting "the handle cannot escape" would not make
// it true -- .dag has no linear or region types to enforce it.
//
// So the honest rung here is MITIGATION, not construction: every consumer shreds on every arm out of
// the bracket, and the window is one function body. The next-rung trigger is a real no-escape
// mechanism -- a bracket whose callback cannot return the binding, which needs a linearity or region
// capability the language does not yet have. Naming that capability is what keeps this from sitting
// below its ceiling unnoticed.
type NetrcBinding sole_constructor {
  path: FilePath
}

fn netrc_binding_path(binding: NetrcBinding) -> FilePath { binding.path }

type NetrcPlacement
  = NetrcBindingPlaced { binding: NetrcBinding }
  | NetrcBindingRefused { cause: NonEmptyStr }

fn netrc_content(machine: NonEmptyStr, login: NonEmptyStr, password: Secret) -> String {
  concat(
    concat("machine ", concat(machine as String, " login ")),
    concat(login as String, concat(" password ", concat(password as String, "\n"))),
  )
}

// THE SHRED PRECEDES THE WRITE, AND THAT ORDER IS DERIVED RATHER THAN CAUTIOUS. WriteOwnerOnly creates
// with O_EXCL at mode 0600 -- rather than writing and then chmod-ing, which would leave a window in which
// the credential exists at the ambient umask -- and O_EXCL REFUSES an existing path. Removing first is
// therefore what makes a legitimate rewrite within one run the ordinary case instead of a failure, and it
// also destroys a netrc left behind by an interrupted earlier run before this one authenticates, rather
// than silently reusing material that may since have been rotated.
//
// THE WRITE IS CHECKED. A silently-failed placement leaves the consumer authenticating with nothing,
// whose 530 reads exactly like a wrong password -- sending the next reader to rotate a credential that
// was never the problem.
func place_netrc_binding(
  path: FilePath,
  machine: NonEmptyStr,
  login: NonEmptyStr,
  password: Secret,
) -> NetrcPlacement
{
  let _ = shell.Remove.FileForce(path: path)
  if Filesystem.WriteOwnerOnly(
    path: path as String,
    content: netrc_content(machine: machine, login: login, password: password)
  ).success {
    NetrcBindingPlaced { binding: NetrcBinding { path: path } }
  } else {
    NetrcBindingRefused {
      cause: "the owner-only netrc could not be created, so no credential was placed for the subprocess to use",
    }
  }
}

// SHREDDING IS UNCONDITIONAL AT THE CALL SITE, INCLUDING ON THE FAILING ARM. A refused transfer that
// leaves the credential on disk has converted a transient failure into a standing exposure, so the
// consumer calls this on every path out of the bracket rather than only on success.
func shred_netrc_binding(binding: NetrcBinding) -> Bool {
  shell.Remove.FileForce(path: binding.path).success
}
