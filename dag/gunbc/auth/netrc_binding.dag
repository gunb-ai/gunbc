module gunbc.auth.netrc_binding

import std.types { NonEmptyStr, String, Bool, Secret, FilePath }
import extdeps.shell
import extdeps.filesystem.filesystem_io

// A CREDENTIAL BINDING: THE ONE SANCTIONED WAY A SECRET REACHES A SUBPROCESS ON THIS FLEET.
//
// WHY THIS MODULE EXISTS RATHER THAN A SECOND COPY OF THE SAME TEN LINES. gunbc.credential_argv_exposure
// records, as a measured incident rather than as hygiene, that an argv word on these hosts is readable
// by any job payload on a runner slot: /proc carries no hidepid, /proc/PID/cmdline is mode 0444, and the
// runner slots sit in the host pid namespace. The repair adopted for Redfish was to delete the
// `-u {username}:{password}` arms entirely and authenticate through a 0600 netrc. When the printer FTPS
// channel needed the same thing, the tempting move was to copy netrc_content across -- which would have
// made the mode, the creation flag, and the shred order three facts with two homes, so that hardening one
// silently leaves the other behind. Two consumers is exactly the point at which the shared authority is
// justified, and this is it.
//
// THE BINDING IS SEALED, WHICH IS THE WHOLE GUARANTEE. If a command builder took a plain FilePath, a
// caller could hand it any path at all -- one written with the ambient umask, one belonging to another
// user, one that does not exist -- and the builder would emit an argv that looks identical to the safe
// one. sole_constructor means the only way to obtain a NetrcBinding is to have gone through
// place_netrc_binding, so possessing the value IS the evidence that the bytes were created owner-only.
// The type is not a label asserting the property; it is unreachable without it.
// WHAT THE SEAL DOES NOT ESTABLISH, said plainly because the alternative is a wrapper that reads
// stronger than it is. sole_constructor makes "these bytes were created owner-only" a MINT-TIME fact.
// It does not bound the binding's LIFETIME: nothing in the substrate stops a holder from carrying the
// value past its shred and spending it later, at which point the path may have been replaced, chmod-ed
// or emptied, and the seal would still read as evidence. That is the same verified-once-spent-later
// decay this lane has already met twice, and prose asserting "the handle cannot escape" would not make
// it true -- .dag has no linear or region types to enforce it.
//
// So the honest rung here is MITIGATION, not construction: every consumer shreds on every arm out of
// the bracket, and the window is one function body. The next-rung trigger is a real no-escape
// mechanism -- a bracket whose callback cannot return the binding, which needs a linearity or region
// capability the language does not yet have. Naming that capability is what keeps this from sitting
// below its ceiling unnoticed.
type NetrcBinding sole_constructor {
  path: FilePath
}

fn netrc_binding_path(binding: NetrcBinding) -> FilePath { binding.path }

// A FAILED WRITE IS NOT THE SAME AS NOTHING HAVING BEEN WRITTEN. WriteOwnerOnly reports only
// success, so a write that failed partway leaves an owner-only file holding some prefix of a netrc
// -- and the credential is the LAST field on the line, so a truncated one is the likelier shape.
// The old refusal said "no credential was placed", which is a claim about the disk that the return
// value could not support. The placement now removes the path on failure and, when removal also
// fails, says so WITHOUT naming the file -- see the note above NetrcPlacement. The path is a per-call mktemp location,
// not the credential; nothing here puts an access code in a diagnostic.
// THE RESIDUE LOCATOR IS SEALED, BECAUSE A PATH THAT DEREFERENCES TO A CREDENTIAL IS A CREDENTIAL
// LOCATOR AND THE RULE DOES NOT CARE THAT THE PATHNAME ITSELF IS NOT THE SECRET. The first version
// of this arm carried the path as a printable NonEmptyStr, the delivery layer concatenated it into
// a refusal cause as "(at <path>)", and the wet-run actuator prints delivery causes -- so precisely
// on the arm where the shred FAILED, a diagnostic named the file still holding a printer access
// code. The annotation beside it asserted that naming the path "leaks nothing", which is the same
// shape of failure this branch keeps meeting: a justification supplied next to the thing it is
// meant to justify, and never checked against the rule it claims to satisfy.
//
// THE FIRST REPAIR WAS A SEAL AND THE SEAL DID NOT HOLD. A sole_constructor CredentialResidueLocus
// was introduced here on the theory that restricting construction also prevents rendering. It does
// not: a control that cast the sealed value with `as String` and asked whether the result contained
// the fixture path COMPILED AND ANSWERED TRUE. sole_constructor governs where a value can come
// FROM, not what a holder may do with it -- the same distinction this file already records for
// NetrcBinding, where the seal is a mint-time fact that does not bound the value's lifetime. Having
// written that paragraph, I then relied on a seal for a property it does not provide.
//
// So the locator is not carried at all. A value that does not hold the path cannot be made to
// render it, by any consumer, under any cast -- which is the structural version of the property the
// seal only appeared to give. The refusal states that credential material may remain and requires
// cleanup; the path stays inside this module, where the placement that created it already has it in
// scope, and that is precisely the authority able to act on it.

type NetrcPlacement
  = NetrcBindingPlaced { binding: NetrcBinding }
  | NetrcBindingRefused { cause: NonEmptyStr }
  | NetrcBindingRefusedResidueRemains { cause: NonEmptyStr }

fn netrc_content(machine: NonEmptyStr, login: NonEmptyStr, password: Secret) -> String {
  concat(
    concat("machine ", concat(machine as String, " login ")),
    concat(login as String, concat(" password ", concat(password as String, "\n"))),
  )
}

// THE SHRED PRECEDES THE WRITE, AND THAT ORDER IS DERIVED RATHER THAN CAUTIOUS. WriteOwnerOnly creates
// with O_EXCL at mode 0600 -- rather than writing and then chmod-ing, which would leave a window in which
// the credential exists at the ambient umask -- and O_EXCL REFUSES an existing path. Removing first is
// therefore what makes a legitimate rewrite within one run the ordinary case instead of a failure, and it
// also destroys a netrc left behind by an interrupted earlier run before this one authenticates, rather
// than silently reusing material that may since have been rotated.
//
// THE WRITE IS CHECKED. A silently-failed placement leaves the consumer authenticating with nothing,
// whose 530 reads exactly like a wrong password -- sending the next reader to rotate a credential that
// was never the problem.
// THE WRITE-FAILURE CLASSIFICATION IS PURE, for the same reason the delivery ones are: reaching its
// residue arm through the effect would need a path that O_EXCL refuses AND rm -f cannot delete, and
// a witness that manufactures one has to chmod a directory and can leave it behind in CI. The two
// discriminating facts are Bools, so both arms are reachable from a fixture. NO LOCATOR LEAVES THIS
// MODULE -- see the note above NetrcPlacement for why the earlier "naming it leaks nothing" claim
// was wrong, and why a seal was not sufficient to fix it either.
fn netrc_write_refusal(
  path: FilePath,
  cleared_before_write: Bool,
  removed_after_failure: Bool,
) -> NetrcPlacement {
  if removed_after_failure {
    NetrcBindingRefused {
      cause: "the owner-only netrc could not be created; any partial file was removed, so no credential is on disk for the subprocess to use",
    }
  } else if cleared_before_write {
    NetrcBindingRefusedResidueRemains {
      cause: "the owner-only netrc could not be created AND the partial file could not be removed, so credential material may remain and requires cleanup",
    }
  } else {
    NetrcBindingRefusedResidueRemains {
      cause: "a pre-existing file could not be removed, which is why the O_EXCL create refused, and it could not be removed afterwards either, so material of unknown origin remains and requires cleanup",
    }
  }
}

func place_netrc_binding(
  path: FilePath,
  machine: NonEmptyStr,
  login: NonEmptyStr,
  password: Secret,
) -> NetrcPlacement
{
  let cleared = shell.Remove.FileForce(path: path).success
  if Filesystem.WriteOwnerOnly(
    path: path as String,
    content: netrc_content(machine: machine, login: login, password: password)
  ).success {
    NetrcBindingPlaced { binding: NetrcBinding { path: path } }
  } else {
    netrc_write_refusal(
      path: path,
      cleared_before_write: cleared,
      removed_after_failure: shell.Remove.FileForce(path: path).success)
  }
}

// A PRIVATE DIRECTORY PER PLACEMENT, because a fixed path is a substitution race with no attacker in
// it. The printer path previously used one process-global name, so two deliveries running together
// would delete and replace each other's credentials between mint and use: place_netrc_binding does
// remove-then-write, so delivery A's netrc can vanish after A minted its binding and before A's curl
// reads it, and A then authenticates with B's access code or with nothing. mktemp -d creates a fresh
// 0700 directory per call, which makes the collision unspellable rather than unlikely.
func place_netrc_binding_privately(
  machine: NonEmptyStr,
  login: NonEmptyStr,
  password: Secret,
) -> NetrcPlacement
{
  let created = shell.Mktemp.Dir()
  if created.success == false {
    NetrcBindingRefused {
      cause: "no private directory could be created for the credential, so none was placed",
    }
  } else {
    place_netrc_binding(
      path: concat(created.path as String, "/netrc") as FilePath,
      machine: machine,
      login: login,
      password: password
    )
  }
}

// SHREDDING IS UNCONDITIONAL AT THE CALL SITE, INCLUDING ON THE FAILING ARM. A refused transfer that
// leaves the credential on disk has converted a transient failure into a standing exposure, so the
// consumer calls this on every path out of the bracket rather than only on success.
func shred_netrc_binding(binding: NetrcBinding) -> Bool {
  shell.Remove.FileForce(path: binding.path).success
}
