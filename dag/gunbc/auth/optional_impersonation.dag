module gunbc.auth.optional_impersonation

import extdeps.transports.rest { RestResult, RestAnswered, RestRefused, RestRefusal }
import extdeps.cloud.gcp.iam

// The token a caller proceeds with, or the refusal of the impersonation it asked for. With no
// service account the operator token is the answer and no call is made; with one, the token exists
// only when GenerateAccessToken answered, and its refusal is carried as the transport reported it.
type OptionalImpersonation
  = OptionalImpersonationToken { token: Secret }
  | OptionalImpersonationRefused { refusal: RestRefusal }

pattern optional_impersonation(
  access_token: Secret,
  service_account: ServiceAccountEmail?,
  lifetime_seconds: Int where range(min: 1, max: 3600)= 3600
) -> OptionalImpersonation {
  impersonated = gcp.IAM.GenerateAccessToken(
    access_token: access_token,
    target_sa: service_account,
    lifetime: concat(to_string(lifetime_seconds), "s")
  ) [when service_account != none]
  return match service_account {
    Present { value: _sa } =>
      match impersonated {
        RestAnswered { answer } => OptionalImpersonationToken { token: answer.access_token }
        RestRefused { refusal } => OptionalImpersonationRefused { refusal: refusal }
      }
    Absent => OptionalImpersonationToken { token: access_token }
  }
}
