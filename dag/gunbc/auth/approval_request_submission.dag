  read_mac_keyring,
}

// THE FILING HALF OF THE APPROVAL LOOP: how a request reaches the store and the operator's phone.
// gunbc.auth.approval_decision_store owns what happens once a link is tapped; this module owns the
// step before it -- a workflow run asks, the roadmap server files and publishes -- and it is a
// separate module because the two run on different clocks and hold different keys.
//
// WHY THE FILER IS THE ROADMAP SERVER AND NOT THE RUNNER. The store's generations are 0600 and one
// process owns them; the runner on srv1 is a different POSIX user (ghrunner) from the roadmap unit
// (briansrls), and srv1 is a TAGGED tailnet node, so a workflow run has no user login to present to
// the identity gate. So the run files over HTTP -- POST /approvals -- and the server writes.
//
// WHY THE FILING IS AUTHENTICATED BY A MAC AND NOT A LOGIN. gunbc.auth.approval_broker
// admit_submission asks whether the REQUESTER IS ENROLLED before the operator is ever notified
// (submission_is_not_approval_note: a requester able to reach the operator with anything it names
// is the failure). Enrolment here is possession of the submission key: the run signs the canonical
// request bytes with approval-submission-mac-key, materialized in-run over WIF exactly as the fleet
// key is, and the server verifies with the same key. It is the symmetric-issuance law of
// extdeps.crypto.mac applied to enrolment -- whoever holds the key may file -- and it is a SECOND
// key, never the capability key: the capability key mints consent, and a runner must not be able
// to mint what it asks for.
//
// THE SIGNED BYTES ARE THE CANONICAL RECORD. The envelope is {"tag": <hex>, "request": <record>}
// and the tag is over stored_request_json(request) -- the ONE emitter the store already uses for
// its generation-1 payload -- re-derived by the server from the parsed record. There is no second
// serializer, so a request cannot be authenticated under one rendering and filed under another.

// ── the submission key ─────────────────────────────────────────────────────────────────────────

// MINTED 2026-09-17 THROUGH gunbc.auth.approval_mac_key_provision under the operator's token: the
// container was created for attempt approval-mac-keys-2026-09-16, version 1 added from a
// digested snapshot and read back (payload sha256 prefix owned by
// gunbc.auth.approval_keyring_pins approval_submission_mac_key_payload_sha256_prefix). Pinned to that version
// for the same reason the capability key is: a keyring following `latest` would let a rotation
// invalidate filings in flight, and the provisioning run refuses to add a version beside a pin.
data approval_submission_mac_key_secret_ref: SecretRef = secret_ref_pin_version(
  ref: fleet_secret_ref(secret_id: "approval-submission-mac-key"),
  version: "1",
)

data approval_submission_mac_key_id: MacKeyId = "approval-submission-mac-key/1" as MacKeyId

data approval_submission_mac_key_path: NonEmptyStr = "/etc/gunbc-roadmap/approval-submission-mac-key"

// THE PUBLISHER TOKEN IS THE NTFY SERVER'S, AT THE PATH ITS DEPLOYMENT WROTE
// (gunbc.auth.approval_ntfy_deployment approval_ntfy_publisher_token_intervention): root:gunbc-ntfy
// 0640 today, so the roadmap unit's user cannot read it until the converge step (part D) admits
// that user to the group. An unreadable token is a typed refusal below, never a fabricated publish.
data approval_publisher_token_path: NonEmptyStr = "/etc/gunbc-ntfy/publisher-token"

fn read_submission_keyring() -> ApprovalKeyringRead {
  read_mac_keyring(path: approval_submission_mac_key_path, key_id: approval_submission_mac_key_id)
}

type PublisherTokenRead
  = PublisherTokenLoaded { token: Secret }
  | PublisherTokenUnavailable { path: NonEmptyStr, detail: String }

fn read_publisher_token() -> PublisherTokenRead {
  let read = Filesystem.Read(path: approval_publisher_token_path as String)
  match filesystem_exact_read(path: approval_publisher_token_path as String, content: read.content, success: read.success, error: read.error, error_kind: read.error_kind) {
    FilesystemExactPathRead { path: _, content: c } =>
      if c == "" { PublisherTokenUnavailable { path: approval_publisher_token_path, detail: "empty" } }
      else { PublisherTokenLoaded { token: trim(c) as Secret } }
    FilesystemExactPathAbsent { path: _ } => PublisherTokenUnavailable { path: approval_publisher_token_path, detail: "absent" }
    FilesystemExactPathUnreadable { path: _, kind: _, error: e } => PublisherTokenUnavailable { path: approval_publisher_token_path, detail: e }
    FilesystemExactPathKindUnrecognized { path: _, observed: o, error: e } => PublisherTokenUnavailable { path: approval_publisher_token_path, detail: concat(o, concat(": ", e)) }
  }
}

// ── the envelope ───────────────────────────────────────────────────────────────────────────────

fn submission_message(request: StoredApprovalRequest) -> NonEmptyStr {
  stored_request_json(r: request) as NonEmptyStr
}

// THE CLIENT SIDE: sign the canonical bytes and wrap them. A workflow run calls this with the key
// it materialized; the server never does.
fn sign_submission(key: MacKey, request: StoredApprovalRequest) -> MacSigning {
  mac_sign(key: key, message: submission_message(request: request))
}

fn submission_envelope_json(request: StoredApprovalRequest, tag_hex: NonEmptyStr) -> String {
  serialize_json(v: json_object(members: [
    json_kv(key: "tag", value: json_string(s: tag_hex as String)),
    json_kv(key: "request", value: JsonString { value: stored_request_json(r: request) }),
  ]))
}

type SubmissionEnvelopeParse
  = SubmissionEnvelopeParsed { tag_hex: NonEmptyStr, request: StoredApprovalRequest }
  | SubmissionEnvelopeUnreadable { detail: NonEmptyStr }

fn json_member_string(v: JsonValue, key: String) -> String? {
  match json_object_unique_member(v: v, key: key) {
    JsonMemberFound { value: JsonString { value: s } } => if s == "" { none } else { Present { value: s } }
    JsonMemberFound { value: _ } => none
    JsonMemberAbsent => none
    JsonMemberDuplicated { count: _ } => none
    JsonMemberNotAnObject => none
  }
}

// THE RECORD TRAVELS AS THE EXACT STRING THAT WAS SIGNED, nested as a JSON string rather than an
// object, so the server verifies the bytes it received and only then parses them -- the same
// authenticate-before-interpret order the capability verifier keeps.
fn parse_submission_envelope(text: String) -> SubmissionEnvelopeParse {
  match parse_json_document(s: text) {
    JsonDocumentUnreadable { gap: _ } => SubmissionEnvelopeUnreadable { detail: "submission is not a JSON document" }
    JsonDocumentParsed { value: v } => match json_member_string(v: v, key: "tag") {
      Absent => SubmissionEnvelopeUnreadable { detail: "submission lacks tag" }
      Present { value: tag } => match json_member_string(v: v, key: "request") {
        Absent => SubmissionEnvelopeUnreadable { detail: "submission lacks request" }
        Present { value: record } => match parse_stored_record(text: record) {
          StoredRequestParsed { request: r } =>
            if stored_request_json(r: r) != record {
              SubmissionEnvelopeUnreadable { detail: "submission record is not in canonical form; the signed bytes would not be the filed bytes" }
            } else {
              SubmissionEnvelopeParsed { tag_hex: tag as NonEmptyStr, request: r }
            }
          StoredDecisionParsed { decision: _ } => SubmissionEnvelopeUnreadable { detail: "submission carries a decision record, not a request" }
          StoredRecordUnreadable { detail: d } => SubmissionEnvelopeUnreadable { detail: d }
        }
      }
    }
  }
}

// ── admission ──────────────────────────────────────────────────────────────────────────────────

// ONE RULE, INVOKED HERE BEFORE NOTIFICATION (approval_broker admit_twice_one_rule_note): the
// requester is enrolled iff the tag verifies under the submission key, and the authority is the one
// this store brokers for. The operator is shown nothing that fails either.
type SubmissionVerdict
  = SubmissionVerified { request: StoredApprovalRequest }
  | SubmissionNotAdmitted { refusal: SubmissionRefusal }

// THE REFUSALS ARE THEIR OWN COPRODUCT so that an outcome carrying a refusal cannot carry the
// success arm: the filing outcome below embeds SubmissionRefusal, never SubmissionVerdict, and so
// owes no rendering and no status for "refused because verified".
type SubmissionRefusal
  = SubmissionUnreadable { detail: NonEmptyStr }
  | SubmissionKeyUnavailable { cause: ApprovalKeyringRefusal }
  | SubmissionNotEnrolled { detail: String }
  | SubmissionAuthorityRefused { requester: NonEmptyStr, authority: NonEmptyStr }

fn admit_parsed_submission(tag_hex: NonEmptyStr, request: StoredApprovalRequest, keyring: ApprovalKeyringRead) -> SubmissionVerdict {
  match keyring {
    ApprovalKeyringRefused { cause: c } => SubmissionNotAdmitted { refusal: SubmissionKeyUnavailable { cause: c } }
    ApprovalKeyLoaded { key: key } => {
      let verification: MacVerification = mac_verify(key: key, message: submission_message(request: request), tag_hex: tag_hex)
      let enrolled = match verification { MacVerified { verified: v } => v.message == submission_message(request: request)  _ => false }
      match admit_submission(requester: request.requester, authority: approval_capability_authority, requester_enrolled: enrolled, authority_permitted: approval_submission_authority_permitted) {
        SubmissionRequesterNotEnrolled { requester: _ } => SubmissionNotAdmitted { refusal: SubmissionNotEnrolled { detail: mac_verification_reason(v: verification) } }
        SubmissionAuthorityNotPermittedForRequester { requester: rq, authority: a } => SubmissionNotAdmitted { refusal: SubmissionAuthorityRefused { requester: rq, authority: a } }
        SubmissionAdmitted { requester: _, authority: _ } => SubmissionVerified { request: request }
      }
    }
  }
}

// ── the links and the notification ─────────────────────────────────────────────────────────────

// THE LINK BASE IS THE ROADMAP SERVER'S TAILNET NAME, the same composition the ntfy address uses
// (gunbc.auth.approval_ntfy_deployment srv1_tailnet_base_url_from) at the default TLS port, where
// tailscale serve proxies / to the roadmap server; the approve route is served there by
// gunbc.roadmap.roadmap_serve. The undeclared-domain arm and its `.invalid` reasoning live with
// that function and are not restated here.
fn approval_link_base_url() -> NonEmptyStr {
  srv1_tailnet_base_url_from(domain: fleet_intent_network.tailnet_domain, port: none)
}

fn approval_link(base: NonEmptyStr, request: StoredApprovalRequest, decision: ProposedDecision, tag_hex: NonEmptyStr) -> NonEmptyStr {
  join([base as String, "/approve/", capability_path_segment(escalation_id: request.escalation_id, decision: decision, tag_hex: tag_hex) as String], "") as NonEmptyStr
}

type LinkIssuance
  = LinksIssued { approve: NonEmptyStr, deny: NonEmptyStr }
  | LinksNotIssued { key_id: MacKeyId }

fn issue_links(capability_key: MacKey, base: NonEmptyStr, request: StoredApprovalRequest) -> LinkIssuance {
  match mac_sign(key: capability_key, message: approval_capability_signing_input(c: claims_for(request: request, decision: ProposeApprove))) {
    MacKeyMaterialNotHex { key_id: k } => LinksNotIssued { key_id: k }
    MacSigned { tag: approve_tag } =>
      match mac_sign(key: capability_key, message: approval_capability_signing_input(c: claims_for(request: request, decision: ProposeDeny))) {
        MacKeyMaterialNotHex { key_id: k } => LinksNotIssued { key_id: k }
        MacSigned { tag: deny_tag } => LinksIssued {
          approve: approval_link(base: base, request: request, decision: ProposeApprove, tag_hex: approve_tag.hex),
          deny: approval_link(base: base, request: request, decision: ProposeDeny, tag_hex: deny_tag.hex),
        }
      }
  }
}

// WHAT THE OPERATOR READS: who asks, for what, whether it is destructive, and until when. The
// approve link is the tap target; the deny link is in the body so denying is one tap too.
fn approval_message(request: StoredApprovalRequest, links: LinkIssuance) -> NtfyMessage? {
  match links {
    LinksNotIssued { key_id: _ } => none
    LinksIssued { approve: a, deny: d } => Present { value: approval_notification(
      title: join(["Approve: ", request.escalation_id as String], "") as NonEmptyStr,
      body: join([
        request.purpose as String,
        if request.destructive { "\n\nDESTRUCTIVE." } else { "" },
        "\nrequested by ", request.requester as String,
        "\nattempt ", request.attempt as String,
        "\nlink expires ", request.expires_at,
        "\n\nDeny: ", d as String,
      ], "") as NonEmptyStr,
      approval_url: a,
    ) }
  }
}

// ── filing and publishing ──────────────────────────────────────────────────────────────────────

type SubmissionOutcome
  = SubmissionFiledAndNotified { escalation_id: NonEmptyStr, message_id: NonEmptyStr }
  | SubmissionFiledNotNotified { escalation_id: NonEmptyStr, publish: NtfyPublishOutcome }
  | SubmissionFiledPublisherTokenUnavailable { escalation_id: NonEmptyStr, detail: String }
  | SubmissionFiledLinksNotIssued { escalation_id: NonEmptyStr, key_id: MacKeyId }
  | SubmissionAlreadyFiled { escalation_id: NonEmptyStr }
  | SubmissionStoreRefused { detail: NonEmptyStr }
  | SubmissionRefused { refusal: SubmissionRefusal }
  | SubmissionFiledCapabilityKeyUnavailable { escalation_id: NonEmptyStr, cause: ApprovalKeyringRefusal }

fn submission_outcome_admits_poll(o: SubmissionOutcome) -> Bool {
  match o {
    SubmissionFiledAndNotified { escalation_id: _, message_id: _ } => true
    SubmissionFiledNotNotified { escalation_id: _, publish: _ } => true
    SubmissionFiledPublisherTokenUnavailable { escalation_id: _, detail: _ } => true
    SubmissionFiledLinksNotIssued { escalation_id: _, key_id: _ } => false
    SubmissionAlreadyFiled { escalation_id: _ } => true
    SubmissionFiledCapabilityKeyUnavailable { escalation_id: _, cause: _ } => false
    SubmissionStoreRefused { detail: _ } => false
    SubmissionRefused { refusal: _ } => false
  }
}

fn submission_outcome_http_body(o: SubmissionOutcome) -> String {
  submission_filed_text(filed: submission_outcome_admits_poll(o: o), reason: concat("approval submission: ", submission_outcome_reason(o: o)))
}

fn submission_outcome_reason(o: SubmissionOutcome) -> String {
  match o {
    SubmissionFiledAndNotified { escalation_id: e, message_id: m } => join(["filed ", e as String, " and notified (ntfy message ", m as String, ")"], "")
    SubmissionFiledNotNotified { escalation_id: e, publish: p } => join(["filed ", e as String, " but the notification did not publish: ", match p {
      NtfyPublished { message_id: _ } => "published"
      NtfyPublishRefused { status: s, detail: d } => join(["refused ", to_string(s), " ", d], "")
      NtfyPublishUnreached { cause: c } => join(["unreached: ", c], "")
      NtfyPublishUndecodable { status: s, cause: c } => join(["undecodable ", to_string(s), ": ", c], "")
    }], "")
    SubmissionFiledPublisherTokenUnavailable { escalation_id: e, detail: d } => join(["filed ", e as String, " but the publisher token is unavailable: ", d], "")
    SubmissionFiledLinksNotIssued { escalation_id: e, key_id: k } => join(["filed ", e as String, " but no link could be issued under key ", k as String], "")
    SubmissionAlreadyFiled { escalation_id: e } => join(["escalation ", e as String, " is already filed"], "")
    SubmissionStoreRefused { detail: d } => join(["approval store refused the filing: ", d as String], "")
    SubmissionRefused { refusal: v } => match v {
      SubmissionUnreadable { detail: d } => join(["submission unreadable: ", d as String], "")
      SubmissionKeyUnavailable { cause: _ } => "the submission key is unavailable on this host"
      SubmissionNotEnrolled { detail: d } => join(["requester not enrolled: ", d], "")
      SubmissionAuthorityRefused { requester: r, authority: a } => join(["authority ", a as String, " is not permitted for ", r as String], "")
    }
    SubmissionFiledCapabilityKeyUnavailable { escalation_id: e, cause: _ } => join(["filed ", e as String, " but the capability key is unavailable on this host, so no link could be minted; resubmit the same bytes once it is"], "")
  }
}

// THE FILING IS DURABLE BEFORE THE NOTIFICATION IS SENT, and a failed publish is reported beside
// the filed escalation rather than rolling it back. The retry path is the SAME submission again:
// the slot is occupied, so the fold reads it back, and a pending record whose canonical bytes equal
// the resubmission is notified again -- the links are re-derived from the stored claims under the
// capability key, so nothing needs storing and a second publish carries the same bearer links as
// the first. A decided slot, or a pending one holding a different request, is 409: the operator
// is never re-notified for a request that already has an answer or that this filer did not sign.
// The links themselves never leave this fold except inside the message -- they are bearer
// authority and the HTTP response to the filer carries only the escalation id.
fn notify_filed(
  capability_keyring: ApprovalKeyringRead,
  publisher: PublisherTokenRead,
  request: StoredApprovalRequest,
) -> SubmissionOutcome {
  match capability_keyring {
    ApprovalKeyringRefused { cause: c } => SubmissionFiledCapabilityKeyUnavailable { escalation_id: request.escalation_id, cause: c }
    ApprovalKeyLoaded { key: key } => match issue_links(capability_key: key, base: approval_link_base_url(), request: request) {
      LinksNotIssued { key_id: k } => SubmissionFiledLinksNotIssued { escalation_id: request.escalation_id, key_id: k }
      links => match approval_message(request: request, links: links) {
        Absent => SubmissionFiledLinksNotIssued { escalation_id: request.escalation_id, key_id: key.id }
        Present { value: message } => match publisher {
          PublisherTokenUnavailable { path: _, detail: d } => SubmissionFiledPublisherTokenUnavailable { escalation_id: request.escalation_id, detail: d }
          PublisherTokenLoaded { token: t } => {
            let sent = ntfy.Publish.PublishMessage(
              access_token: t,
              topic: message.topic,
              title: message.title,
              body: message.body,
              priority: ntfy_priority_wire(p: message.priority),
              click: message.click,
              cache: ntfy_cache_wire(c: message.cache),
            )
            match ntfy_publish_outcome_of(rest: sent.outcome, message_id: sent.message_id) {
              NtfyPublished { message_id: m } => SubmissionFiledAndNotified { escalation_id: request.escalation_id, message_id: m }
              other => SubmissionFiledNotNotified { escalation_id: request.escalation_id, publish: other }
            }
          }
        }
      }
    }
  }
}

// AN OCCUPIED SLOT IS ONE OF FOUR ANSWERS, NONE COLLAPSED (review 67404): pending with the same
// bytes re-notifies; pending with other bytes or already decided is a conflict; a slot the store
// could not read is the store's refusal, on the 503 channel, never a 409 that would tell the filer
// its request is safely on file; and not-filed after StoreSlotOccupied is a store that changed
// under the write, also a refusal.
type OccupiedSlotStanding
  = OccupiedRenotifiable
  | OccupiedConflict
  | OccupiedUnreadable { detail: NonEmptyStr }

fn occupied_slot_standing(slot: EscalationSlot, request: StoredApprovalRequest) -> OccupiedSlotStanding {
  match slot {
    EscalationPending { request: stored } =>
      if stored_request_json(r: stored) == stored_request_json(r: request) { OccupiedRenotifiable } else { OccupiedConflict }
    EscalationDecided { decision: _ } => OccupiedConflict
    EscalationUnreadable { detail: d } => OccupiedUnreadable { detail: d }
    EscalationNotFiled => OccupiedUnreadable { detail: "the slot was occupied at the write and absent at the read that followed" }
  }
}

fn file_and_notify(
  root: NonEmptyStr,
  capability_keyring: ApprovalKeyringRead,
  publisher: PublisherTokenRead,
  request: StoredApprovalRequest,
) -> SubmissionOutcome {
  match file_approval_request(root: root, request: request) {
    StoreSlotOccupied =>
      match occupied_slot_standing(slot: observe_escalation(root: root, escalation_id: request.escalation_id), request: request) {
        OccupiedRenotifiable => notify_filed(capability_keyring: capability_keyring, publisher: publisher, request: request)
        OccupiedConflict => SubmissionAlreadyFiled { escalation_id: request.escalation_id }
        OccupiedUnreadable { detail: d } => SubmissionStoreRefused { detail: d }
      }
    StoreRefused { detail: d } => SubmissionStoreRefused { detail: d }
    StoreWritten => notify_filed(capability_keyring: capability_keyring, publisher: publisher, request: request)
  }
}

// THE ORDER BEHIND POST /approvals, held by the handler (gunbc.roadmap_serve
// approval_submit_response): parse the envelope, then read the submission key and admit, and only
// past admission read the capability key and the publisher token, write, and publish -- so an
// unreadable body costs no host read, a refused filer costs one key read and no write, and the
// hermetic witness can reach the route. This fold is the same order for callers that already hold
// the three reads (the live probe supplies fixtures for all three); it is not what the handler
// runs, because a caller with the reads in hand has already spent them.
fn submit_parsed_submission(
  root: NonEmptyStr,
  submission_keyring: ApprovalKeyringRead,
  capability_keyring: ApprovalKeyringRead,
  publisher: PublisherTokenRead,
  tag_hex: NonEmptyStr,
  request: StoredApprovalRequest,
) -> SubmissionOutcome {
  match admit_parsed_submission(tag_hex: tag_hex, request: request, keyring: submission_keyring) {
    SubmissionVerified { request: r } => file_and_notify(root: root, capability_keyring: capability_keyring, publisher: publisher, request: r)
    SubmissionNotAdmitted { refusal: refused } => SubmissionRefused { refusal: refused }
  }
}

// ── reading a filed escalation back ────────────────────────────────────────────────────────────

// WHAT A POLLING RUN MAY LEARN OVER HTTP: the slot's standing and, once decided, who decided and
// when. Not the purpose, not the requester -- the run filed those and does not need them back --
// and never a link. The grant join is grant_from_approved_decision over these fields: the runner
// never opens the 0600 store.
// THE STATUS A POLLING RUN READS, with its wire status beside it: an answer about the slot --
// not filed, pending, decided -- is 200, and a store that could not be read is 503, because the
// HTTP status is the channel the filer reads first and a failed read on the success channel is
// a warning where a refusal was owed. The BODY is the kv grammar of approval_status_wire.
type EscalationStatus {
  status: HttpStatus
  body: String
}

fn filed_status_of_slot(slot: EscalationSlot) -> FiledApprovalStatus {
  match slot {
    EscalationNotFiled => StatusNotFiled
    EscalationUnreadable { detail: d } => StatusUnreadable { detail: d }
    EscalationPending { request: r } => StatusPending { expires_at: r.expires_at }
    EscalationDecided { decision: d } => match d {
      BrokerApproved { escalation_id: _, revision: rev, decided_by: by, decided_at: at, obligation: o } =>
        StatusApproved { revision: rev, decided_by: by, decided_at: at, execute_by: o.execute_by }
      BrokerDenied { escalation_id: _, revision: rev, decided_by: by, decided_at: at, reason: why } =>
        StatusDenied { revision: rev, decided_by: by, decided_at: at, reason: why }
    }
  }
}

fn escalation_status_of(slot: EscalationSlot) -> EscalationStatus {
  match slot {
    EscalationUnreadable { detail: _ } => EscalationStatus { status: 503, body: filed_approval_status_text(status: filed_status_of_slot(slot: slot)) }
    _ => EscalationStatus { status: 200, body: filed_approval_status_text(status: filed_status_of_slot(slot: slot)) }
  }
}

fn escalation_status(root: NonEmptyStr, escalation_id: NonEmptyStr) -> EscalationStatus {
  escalation_status_of(slot: observe_escalation(root: root, escalation_id: escalation_id))
}

// ── the frontier ───────────────────────────────────────────────────────────────────────────────

// THE AUTHORITY-PERMISSION HALF OF ADMISSION IS A CONSTANT TODAY, AND THIS ROW SAYS SO. The
// store brokers exactly one authority (approval_capability_authority) and a stored request cannot
// name another, so requester->authority policy has one cell and admit_submission's
// authority_permitted parameter is wired to it as a row rather than a literal at the call site.
// SubmissionAuthorityNotPermittedForRequester therefore has no authorable RED on the live route
// yet (DESIGN 4b: a check whose RED cannot be written is a decoration) -- it is kept because the
// broker's rule (approval_broker submission_is_not_approval_note) is the reason the arm exists,
// and it becomes a wall when this frontier dissolves.
data approval_submission_authority_permitted: Bool = true

data approval_submission_authority_policy_frontier: DissolutionCondition = unbound_dissolution(
  description: "a requester -> authority policy roster (which enrolled filers may put which brokered authority in front of the operator) consumed by admit_parsed_submission in place of approval_submission_authority_permitted, with a witness whose unrostered requester answers SubmissionAuthorityRefused -- SUFFICIENT FOR the authority half of admission to refuse on the live route; triggered by the first second brokered authority or the first filer class other than the fleet-converge runner",
)

// THE FILING ROUTES ARE NOW ON THE SERVE TABLE (POST /approvals, GET /approvals/\{escalation_id\}).
// Remaining dissolution is the same path used by every approval-gated fleet action, not one host's boot.
data approval_submission_client_frontier: DissolutionCondition = unbound_dissolution(
  description: "every approval-gated fleet action files through POST /approvals and GET /approvals/ plus the escalation id, then joins the grant with grant_from_approved_decision over those standing fields; SUFFICIENT FOR that HTTP client path (runners never open the 0600 store), not one host's boot and not grant_from_store; the srv3 source-declared grant dissolves into the same run.",
)
