module gunbc.auth.heal_publisher_federation

import std.types { NonEmptyStr, String, Int, List, Map, Bool }
import std.optional { Present }
import extdeps.cloud.gcp.gcp { ServiceAccountEmail, GcpProjectId, WifPool, WifProvider, wif_provider_resource, wif_pool_resource }
import extdeps.cloud.gcp.secret_ref { SecretRef, HashPending }
import gunbc.auth.github_apps { gunbai_bot_app_pem_secret }
import gunbc.auth.github_gcp_federation {
  fleet_secrets_project_id, fleet_secrets_project_number, github_wif_issuer_uri, federated_service_account_member
}
import extdeps.github.github { Repository }
import gunbc.repository {
  gunbc_repository, gunbc_repository_numeric_identity, RepositoryNumericIdentity,
  gunbc_private_repository, gunbc_private_repository_numeric_identity
}

import extdeps.github.app { permission_axis_wire_name, permission_access_wire_name }
import extdeps.github.effect { contents_write }
import extdeps.cloud.gcp.secret_ref { secret_ref_version_resource }
import extdeps.languages.json.emit { json_object, json_array, json_kv, json_string, serialize_json }
// THE WORKFLOW THIS POOL ADMITS NO LONGER EXISTS (operator ruling 2026-10-09: the heal publisher
// was deleted with the v1 lanes, because nothing seals a repair candidate for it to publish). The
// pool's attribute condition still names the file's path, so the path is carried here as the
// retired literal the condition was pinned to rather than derived from a registry row that is
// gone. The estate is DEAD, not deleted: no job can present this claim, the pool and its
// secret-accessor binding stand until retired by hand, and that is an external-estate obligation
// recorded beside gunbc.rung_drop v1_required_lanes_withdrawn.
data heal_publisher_workflow_path_retired: String = ".github/workflows/heal-publish.yml"


// THE PUBLISHER'S OWN FEDERATION, AND WHY IT IS NOT THE REPOSITORY'S.
//
// gunbc.auth.github_gcp_federation is one pool whose provider admits any job in this repository
// (`assertion.repository == 'gunb-ai/gunbc'`). That is the right grain for the fleet's own domains,
// and it is the WRONG grain for a key that can write to this repository: a pull request's job is a
// job in this repository, so a pull-request-controlled workflow could federate through that provider
// and read whatever it may read. gunbc#10887 is the receipt -- that is exactly how its heal job
// reached the App private key.
//
// So the publisher gets its OWN POOL with ONE PROVIDER, whose attribute condition pins every claim
// that distinguishes the protected publisher from anything a pull request can cause: the repository
// BY NUMERIC ID (a name can be released and re-registered; an id cannot), the owner by numeric id,
// the workflow file AND the ref it runs from, the event that may trigger it, and a GitHub-hosted
// runner -- no self-hosted runner of ours may present this identity, because those runners also
// execute pull-request code. Nothing else may enter the pool, so a binding to the pool is a binding
// to that one job.
//
// THE SERVICE ACCOUNT HOLDS ONE ROLE ON ONE SECRET, and the secret is the EXISTING gunbai-bot App
// key (operator ruling, 2026-09-17). No new App is registered: GitHub requires a human to create and
// install one, and this key already exists labelled purpose=ci-heal-push, put there on 2026-09-09 by
// the effort that was meant to build this publisher and stopped before wiring it. The account is
// reachable only by the pool above -- no keys exist or may be minted for it -- so it is a door that
// only the pinned job can open.
//
// WHY THIS APP AND NOT THE ORG-ADMINISTRATIVE ONE, STATED AT THE EVIDENCE LEVEL IT ACTUALLY HAS.
// gunbai-ci was the first choice and was withdrawn because its key is an ORG-ADMINISTRATIVE App's:
// a holder can mint installation tokens across the org, where gunbai-bot's is the programming-agent
// App whose key was already provisioned labelled purpose=ci-heal-push. The difference bought is in
// what the KEY can do, and that is the whole of it.
//
// AN EARLIER DRAFT OF THIS PARAGRAPH CLAIMED MORE AND WAS WRONG. It argued the ci key was also more
// REACHABLE, being readable by fleet-cloud-convergence through a provider conditioned only on
// `assertion.repository == 'gunb-ai/gunbc'`. Reading the live policy on 2026-09-17 showed
// fleet-cloud-convergence holds secretAccessor on the BOT key too, so both keys sit behind the same
// repository-wide path and the reachability argument applies equally to both. It is corrected rather
// than deleted because the next reader will otherwise re-derive the same plausible claim.
//
// THE RESIDUAL, NAMED: both App keys remain readable by an identity any job in this repository
// holding id-token:write can assume. This change neither creates that nor removes it. The publisher's
// OWN path does not inherit it -- it federates through the pinned pool above, not that one.
//
// THE PROVIDER CONDITION IS STILL LOAD-BEARING, and that is not a formality. A KEY can mint more than
// the token taken through it, so the wall is not the mint request -- it is that this account is
// reachable from one workflow, on one ref, by one event, on a hosted runner. That is the grain
// gunbc.auth.github_gcp_federation does NOT admit, and the grain gunbc#10887 was exploited at.

// ONE PUBLISHER FEDERATION PER PUBLISHING REPOSITORY, AS A RECORD. The paragraphs above argue for a
// pool whose single provider pins one job; gunbc-private publishes its own drifted projections and
// needs the same wall around the same key, pinned to ITS repository and ITS publisher workflow. A
// second provider in the public pool was the other shape and is declined: the impersonation member
// is the whole pool (`/*`, gunbc.auth.heal_publisher_provision impersonation_cell), so a second
// provider there would let either repository's job act as one account, and the provisioning
// classifier refuses a pool holding more than one provider precisely to keep that from happening
// silently. So each repository gets its own pool, provider and account, and everything that
// distinguishes them is this record -- the condition, the pool resource and the down-scoped token
// body are derived from it rather than restated per repository.
type HealPublisherFederation {
  repository: Repository
  numeric_identity: RepositoryNumericIdentity
  workflow_path: String
  pool_id: NonEmptyStr
  pool_display_name: NonEmptyStr
  provider_id: NonEmptyStr
  service_account_id: NonEmptyStr
  service_account: ServiceAccountEmail
  service_account_display_name: NonEmptyStr
  provision_remedy: NonEmptyStr
  runner_environment: String
}

data heal_publisher_wif_pool_id: NonEmptyStr = "github-heal-publisher"

// 31 CHARACTERS, AND THE CEILING IS THE UPSTREAM'S: createWorkloadIdentityPool answers HTTP 400
// INVALID_ARGUMENT for a display name over 32. Measured 2026-09-17, not read from a doc -- the first
// provisioning run refused on it. The witness beside this row holds the length so the next author
// finds it at claim time rather than in a failed provisioning run.
data heal_publisher_wif_pool_display_name: NonEmptyStr = "Heal publisher (protected push)"

data heal_publisher_wif_provider_id: NonEmptyStr = "github-heal-publisher-oidc"

data heal_publisher_service_account_id: NonEmptyStr = "heal-publisher"

data heal_publisher_service_account: ServiceAccountEmail = "heal-publisher@gunbai-secrets.iam.gserviceaccount.com"

data heal_publisher_service_account_display_name: NonEmptyStr = "Heal publisher (WIF-only, one secret, no keys)"

fn public_heal_publisher_federation() -> HealPublisherFederation {
  HealPublisherFederation {
    repository: gunbc_repository,
    numeric_identity: gunbc_repository_numeric_identity,
    workflow_path: heal_publisher_workflow_path_retired,
    pool_id: heal_publisher_wif_pool_id,
    pool_display_name: heal_publisher_wif_pool_display_name,
    provider_id: heal_publisher_wif_provider_id,
    service_account_id: heal_publisher_service_account_id,
    service_account: heal_publisher_service_account,
    service_account_display_name: heal_publisher_service_account_display_name,
    runner_environment: heal_publisher_wif_runner_environment,
    provision_remedy: "run gunbc.auth.heal_publisher_provision heal_publisher_federation_provision_with_supplied_token, which creates that identity and binds roles/secretmanager.secretAccessor on the key for that service account only after reading the federation back.",
  }
}

// THE PRIVATE PUBLISHER'S FILE IS AT THE SAME PATH AS THIS ONE'S, and gunbc-private's emitter
// imports this row as its output path, so the condition and the file it names have one authority.
fn heal_publisher_private_workflow_path() -> String {
  heal_publisher_workflow_path_retired
}

// Every id is under its upstream ceiling: pool id 4-32, provider id 4-32, account id 6-30, pool
// display name 32 (the measured one above).
fn private_heal_publisher_federation() -> HealPublisherFederation {
  HealPublisherFederation {
    repository: gunbc_private_repository,
    numeric_identity: gunbc_private_repository_numeric_identity,
    workflow_path: heal_publisher_private_workflow_path(),
    pool_id: "github-heal-publisher-private",
    pool_display_name: "Heal publisher private (push)",
    provider_id: "gh-heal-publisher-private-oidc",
    service_account_id: "heal-publisher-private",
    service_account: "heal-publisher-private@gunbai-secrets.iam.gserviceaccount.com",
    service_account_display_name: "Private heal publisher (WIF-only, one secret, no keys)",
    runner_environment: heal_publisher_wif_runner_environment,
    provision_remedy: "dispatch fleet-converge in mode gcp_iam_converge and approve the diff it files; gunbc.auth.gcp_iam_converge creates that identity and binds roles/secretmanager.secretAccessor on the key for that service account under that one approval.",
  }
}

fn heal_publisher_federation_pool(f: HealPublisherFederation) -> WifPool {
  WifPool {
    name: f.pool_id
    project: fleet_secrets_project_id as String
    display_name: Present { value: f.pool_display_name }
    disabled: false
  }
}

data heal_publisher_wif_pool: WifPool = heal_publisher_federation_pool(f: public_heal_publisher_federation())

// The workflow_ref claim GitHub puts in the OIDC token for the publisher's own job: the repository's
// publisher workflow file, at its default branch. It is derived from the artifact registry and the
// repository authority, so a renamed workflow file or a renamed default branch moves the condition
// with it rather than leaving a stale literal that admits nothing (or, worse, something else).
fn heal_publisher_federation_workflow_ref(f: HealPublisherFederation) -> String {
  join([f.repository.full_name, "/", f.workflow_path, "@refs/heads/", f.repository.default_branch], "")
}

fn heal_publisher_workflow_ref() -> String {
  heal_publisher_federation_workflow_ref(f: public_heal_publisher_federation())
}

data heal_publisher_wif_event_name: String = "workflow_run"

data heal_publisher_wif_runner_environment: String = "github-hosted"

// THE PRIVATE PUBLISHER IS HEADED FOR OUR microVMs, AND ITS PIN STAYS github-hosted UNTIL THE WALL
// THAT WOULD JUSTIFY WIDENING IT EXISTS (operator 2026-09-29; review 72445). GitHub's
// runner_environment claim is only github-hosted or self-hosted, so pinning self-hosted admits every
// self-hosted runner, including the srv slots that execute pull-request code. What would keep
// pull-request code off the machine is the runner group gunbc.runner_group_restriction_ensure
// private_heal_publisher_runner_group_subject -- restricted to exactly this workflow and repository
// -- together with a controller that mints one guest per job into that group only after reading the
// restriction back. The group is modelled; the minting path is not. So the field is per record and
// the private record still says github-hosted: a publish job placed on a microVM label today cannot
// federate at all, which refuses rather than widens. The flip to self-hosted lands in ONE change with
// the controller path that mints into that group, and with the live provider's condition update.


// job_workflow_ref IS DELIBERATELY NOT PINNED, AND ITS EARLIER PRESENCE WAS A DEFECT THAT WOULD HAVE
// REFUSED THE VERY JOB THIS ADMITS. GitHub documents that claim as "For jobs using a reusable
// workflow, the ref path to the reusable workflow" -- heal-publish declares an ordinary job directly,
// so the claim is ABSENT from its token and a condition requiring it can never be satisfied.
//
// THE READBACK THAT "VERIFIED" THIS DID NOT CATCH IT, which is the transferable part: reading the
// provider back confirms what condition is STORED, not that the condition ADMITS anything. A stored
// condition and an admitting condition are different facts, and only a real token exchange
// distinguishes them. The wet vertical is what establishes this route, not the provisioning readback.
//
// WHAT STILL PINS THE JOB: repository and owner by numeric id, workflow_ref (the workflow file AND
// the ref it runs from), event_name, and a GitHub-hosted runner. A pull request cannot cause a
// workflow_run event on the default branch from this file.
fn heal_publisher_federation_attribute_condition(f: HealPublisherFederation) -> String {
  join([
    "assertion.repository_id == '", to_string(f.numeric_identity.repository_id), "'",
    " && assertion.repository_owner_id == '", to_string(f.numeric_identity.owner_id), "'",
    " && assertion.workflow_ref == '", heal_publisher_federation_workflow_ref(f: f), "'",
    " && assertion.ref == 'refs/heads/", f.repository.default_branch, "'",
    " && assertion.event_name == '", heal_publisher_wif_event_name, "'",
    " && assertion.runner_environment == '", f.runner_environment, "'"
  ], "")
}

fn heal_publisher_wif_attribute_condition() -> String {
  heal_publisher_federation_attribute_condition(f: public_heal_publisher_federation())
}

data heal_publisher_wif_attribute_mapping: Map<String, String> = {
  "google.subject": "assertion.sub",
  "attribute.repository_id": "assertion.repository_id",
  "attribute.workflow_ref": "assertion.workflow_ref"
}

fn heal_publisher_federation_provider(f: HealPublisherFederation) -> WifProvider {
  WifProvider {
    name: f.provider_id
    pool: f.pool_id
    issuer_uri: github_wif_issuer_uri
    attribute_mapping: Present { value: heal_publisher_wif_attribute_mapping }
    attribute_condition: Present { value: heal_publisher_federation_attribute_condition(f: f) }
  }
}

data heal_publisher_wif_provider: WifProvider = heal_publisher_federation_provider(f: public_heal_publisher_federation())

fn heal_publisher_federation_provider_resource(f: HealPublisherFederation) -> String {
  wif_provider_resource(project_number: fleet_secrets_project_number, provider: heal_publisher_federation_provider(f: f))
}

fn heal_publisher_wif_provider_resource() -> String {
  heal_publisher_federation_provider_resource(f: public_heal_publisher_federation())
}

// EVERY IDENTITY IN THE POOL, which is the point of the pool being its own: the provider's condition
// is the whole membership rule, so this member names exactly the job that satisfied it.
fn heal_publisher_federation_principal_set(f: HealPublisherFederation) -> String {
  join([
    "principalSet://iam.googleapis.com/",
    wif_pool_resource(project_number: fleet_secrets_project_number, pool_id: f.pool_id as String),
    "/*"
  ], "")
}

fn heal_publisher_wif_principal_set() -> String {
  heal_publisher_federation_principal_set(f: public_heal_publisher_federation())
}

fn heal_publisher_federation_service_account_member(f: HealPublisherFederation) -> String {
  federated_service_account_member(email: f.service_account)
}

fn heal_publisher_service_account_member() -> String {
  heal_publisher_federation_service_account_member(f: public_heal_publisher_federation())
}

// ── What the publisher's token may do, and what to say when the mint cannot happen ──────────

// THE INSTALLATION TOKEN IS DOWN-SCOPED AT THE MINT, not merely by what the App was granted. Even
// with an App installed on one repository with one permission, the request names both again: the
// token that exists for the publication is the smallest one that can perform it, so a leaked token
// is a contents write on this repository for one hour and nothing else, ever.
fn heal_publisher_installation_token_request_body() -> String {
  heal_publisher_federation_installation_token_request_body(f: public_heal_publisher_federation())
}

fn heal_publisher_federation_installation_token_request_body(f: HealPublisherFederation) -> String {
  serialize_json(v: json_object(members: [
    json_kv(key: "repositories", value: json_array(elements: [json_string(s: f.repository.name)])),
    json_kv(key: "permissions", value: json_object(members: [
      json_kv(
        key: permission_axis_wire_name(axis: contents_write.name) as String,
        value: json_string(s: permission_access_wire_name(access: contents_write.access) as String)
      )
    ]))
  ]))
}

// THE REMEDY IS THE RECORD'S, because the two federations are provisioned by different routes. It used to spell an entry that did not exist
// (heal_publisher_key_provision_with_supplied_token), so the one instruction a reader of this
// failure gets pointed at nothing.
fn heal_publisher_key_unreadable_message(http_status: String) -> String {
  heal_publisher_federation_key_unreadable_message(f: public_heal_publisher_federation(), http_status: http_status)
}

fn heal_publisher_federation_key_unreadable_message(f: HealPublisherFederation, http_status: String) -> String {
  join([
    "HealPublisherAppKeyUnreadable: Secret Manager answered HTTP ", http_status, " for ",
    secret_ref_version_resource(ref: gunbai_bot_app_pem_secret),
    " to the ", f.service_account as String, " principal. 403 means the version exists and is not readable OR does not exist",
    " -- REMEDY: ", f.provision_remedy as String,
    " Minting NO token, so nothing is published."
  ], "")
}

fn heal_publisher_token_refused_message(status_line: String) -> String {
  join([
    "HealPublisherInstallationTokenRefused: GitHub answered ", status_line,
    " for the publisher App's installation; a revoked key, a removed installation, or a Contents permission",
    " that is no longer write each look like this -- inspect the App's installation on this repository"
  ], "")
}
