module gunbc.auth.heal_publisher_federation

import std.types { NonEmptyStr, String, Int, List, Map, Bool }
import v2.std.optional { Present }
import extdeps.cloud.gcp.gcp { ServiceAccountEmail, GcpProjectId, WifPool, WifProvider, wif_provider_resource, wif_pool_resource }
import extdeps.cloud.gcp.secret_ref { SecretRef, HashPending }
import gunbc.auth.github_apps { gunbai_bot_app_pem_secret }
import gunbc.auth.github_gcp_federation {
  fleet_secrets_project_id, fleet_secrets_project_number, github_wif_issuer_uri, federated_service_account_member
}
import gunbc.repository { gunbc_repository, gunbc_repository_numeric_identity }
import gunbc.generated_artifact { artifact_path, HealPublisherWorkflowYamlArtifact }
import gunbc.repo_identity { gunbc_default_branch_name }
import extdeps.github.app { permission_axis_wire_name, permission_access_wire_name }
import extdeps.github.effect { contents_write }
import extdeps.cloud.gcp.secret_ref { secret_ref_version_resource }
import extdeps.languages.json.emit { json_object, json_array, json_kv, json_string, serialize_json }

// THE PUBLISHER'S OWN FEDERATION, AND WHY IT IS NOT THE REPOSITORY'S.
//
// gunbc.auth.github_gcp_federation is one pool whose provider admits any job in this repository
// (`assertion.repository == 'gunb-ai/gunbc'`). That is the right grain for the fleet's own domains,
// and it is the WRONG grain for a key that can write to this repository: a pull request's job is a
// job in this repository, so a pull-request-controlled workflow could federate through that provider
// and read whatever it may read. gunbc#10887 is the receipt -- that is exactly how its heal job
// reached the App private key.
//
// So the publisher gets its OWN POOL with ONE PROVIDER, whose attribute condition pins every claim
// that distinguishes the protected publisher from anything a pull request can cause: the repository
// BY NUMERIC ID (a name can be released and re-registered; an id cannot), the owner by numeric id,
// the workflow file AND the ref it runs from, the event that may trigger it, and a GitHub-hosted
// runner -- no self-hosted runner of ours may present this identity, because those runners also
// execute pull-request code. Nothing else may enter the pool, so a binding to the pool is a binding
// to that one job.
//
// THE SERVICE ACCOUNT HOLDS ONE ROLE ON ONE SECRET, and the secret is the EXISTING gunbai-bot App
// key (operator ruling, 2026-09-17). No new App is registered: GitHub requires a human to create and
// install one, and this key already exists labelled purpose=ci-heal-push, put there on 2026-09-09 by
// the effort that was meant to build this publisher and stopped before wiring it. The account is
// reachable only by the pool above -- no keys exist or may be minted for it -- so it is a door that
// only the pinned job can open.
//
// WHY THIS APP AND NOT THE ORG-ADMINISTRATIVE ONE, STATED AT THE EVIDENCE LEVEL IT ACTUALLY HAS.
// gunbai-ci was the first choice and was withdrawn because its key is an ORG-ADMINISTRATIVE App's:
// a holder can mint installation tokens across the org, where gunbai-bot's is the programming-agent
// App whose key was already provisioned labelled purpose=ci-heal-push. The difference bought is in
// what the KEY can do, and that is the whole of it.
//
// AN EARLIER DRAFT OF THIS PARAGRAPH CLAIMED MORE AND WAS WRONG. It argued the ci key was also more
// REACHABLE, being readable by fleet-cloud-convergence through a provider conditioned only on
// `assertion.repository == 'gunb-ai/gunbc'`. Reading the live policy on 2026-09-17 showed
// fleet-cloud-convergence holds secretAccessor on the BOT key too, so both keys sit behind the same
// repository-wide path and the reachability argument applies equally to both. It is corrected rather
// than deleted because the next reader will otherwise re-derive the same plausible claim.
//
// THE RESIDUAL, NAMED: both App keys remain readable by an identity any job in this repository
// holding id-token:write can assume. This change neither creates that nor removes it. The publisher's
// OWN path does not inherit it -- it federates through the pinned pool above, not that one.
//
// THE PROVIDER CONDITION IS STILL LOAD-BEARING, and that is not a formality. A KEY can mint more than
// the token taken through it, so the wall is not the mint request -- it is that this account is
// reachable from one workflow, on one ref, by one event, on a hosted runner. That is the grain
// gunbc.auth.github_gcp_federation does NOT admit, and the grain gunbc#10887 was exploited at.

data heal_publisher_wif_pool_id: NonEmptyStr = "github-heal-publisher"

// 31 CHARACTERS, AND THE CEILING IS THE UPSTREAM'S: createWorkloadIdentityPool answers HTTP 400
// INVALID_ARGUMENT for a display name over 32. Measured 2026-09-17, not read from a doc -- the first
// provisioning run refused on it. The witness beside this row holds the length so the next author
// finds it at claim time rather than in a failed provisioning run.
data heal_publisher_wif_pool_display_name: NonEmptyStr = "Heal publisher (protected push)"

data heal_publisher_wif_provider_id: NonEmptyStr = "github-heal-publisher-oidc"

data heal_publisher_service_account_id: NonEmptyStr = "heal-publisher"

data heal_publisher_service_account: ServiceAccountEmail = "heal-publisher@gunbai-secrets.iam.gserviceaccount.com"

data heal_publisher_service_account_display_name: NonEmptyStr = "Heal publisher (WIF-only, one secret, no keys)"

data heal_publisher_wif_pool: WifPool = WifPool {
  name: heal_publisher_wif_pool_id
  project: fleet_secrets_project_id as String
  display_name: Present { value: heal_publisher_wif_pool_display_name }
  disabled: false
}

// The workflow_ref claim GitHub puts in the OIDC token for the publisher's own job: this repository's
// publisher workflow file, at the default branch. It is derived from the artifact registry and the
// repository authority, so a renamed workflow file or a renamed default branch moves the condition
// with it rather than leaving a stale literal that admits nothing (or, worse, something else).
fn heal_publisher_workflow_ref() -> String {
  join([
    gunbc_repository.full_name as String, "/",
    artifact_path(a: HealPublisherWorkflowYamlArtifact),
    "@refs/heads/", gunbc_default_branch_name
  ], "")
}

data heal_publisher_wif_event_name: String = "workflow_run"

data heal_publisher_wif_runner_environment: String = "github-hosted"

fn heal_publisher_wif_attribute_condition() -> String {
  join([
    "assertion.repository_id == '", to_string(gunbc_repository_numeric_identity.repository_id), "'",
    " && assertion.repository_owner_id == '", to_string(gunbc_repository_numeric_identity.owner_id), "'",
    " && assertion.workflow_ref == '", heal_publisher_workflow_ref(), "'",
    " && assertion.job_workflow_ref == '", heal_publisher_workflow_ref(), "'",
    " && assertion.ref == 'refs/heads/", gunbc_default_branch_name, "'",
    " && assertion.event_name == '", heal_publisher_wif_event_name, "'",
    " && assertion.runner_environment == '", heal_publisher_wif_runner_environment, "'"
  ], "")
}

data heal_publisher_wif_attribute_mapping: Map<String, String> = {
  "google.subject": "assertion.sub",
  "attribute.repository_id": "assertion.repository_id",
  "attribute.workflow_ref": "assertion.workflow_ref"
}

data heal_publisher_wif_provider: WifProvider = WifProvider {
  name: heal_publisher_wif_provider_id
  pool: heal_publisher_wif_pool_id
  issuer_uri: github_wif_issuer_uri
  attribute_mapping: Present { value: heal_publisher_wif_attribute_mapping }
  attribute_condition: Present { value: heal_publisher_wif_attribute_condition() }
}

fn heal_publisher_wif_provider_resource() -> String {
  wif_provider_resource(project_number: fleet_secrets_project_number, provider: heal_publisher_wif_provider)
}

// EVERY IDENTITY IN THE POOL, which is the point of the pool being its own: the provider's condition
// is the whole membership rule, so this member names exactly the job that satisfied it.
fn heal_publisher_wif_principal_set() -> String {
  join([
    "principalSet://iam.googleapis.com/",
    wif_pool_resource(project_number: fleet_secrets_project_number, pool_id: heal_publisher_wif_pool_id as String),
    "/*"
  ], "")
}

fn heal_publisher_service_account_member() -> String {
  federated_service_account_member(email: heal_publisher_service_account)
}

// ── The App this publishes as ───────────────────────────────────────────────────────────────

// THE PUBLISHER PUBLISHES AS gunbai-ci, WHICH IS ALREADY REGISTERED AND INSTALLED. An earlier
// revision carried its own HealPublisherAppRegistration coproduct whose Pending arm made the
// workflow REFUSE TO EMIT until an operator created a dedicated App -- correct while that App was a
// fact nobody had established, and a decoration once the answer is a row this corpus already holds.
// A gate whose refusing arm is unreachable is permanently green by construction and worse than
// absent, because it will be cited as coverage (DESIGN section 4b).
//
// So the app and installation are read from gunbc.auth.github_apps, which is their single authority
// and is already consumed by the org-admin prelude. Restating them here would be a second home for a
// forge fact, and the id is not ours to restate: it is observed, not chosen.

// ── What the publisher's token may do, and what to say when the mint cannot happen ──────────

// THE INSTALLATION TOKEN IS DOWN-SCOPED AT THE MINT, not merely by what the App was granted. Even
// with an App installed on one repository with one permission, the request names both again: the
// token that exists for the publication is the smallest one that can perform it, so a leaked token
// is a contents write on this repository for one hour and nothing else, ever.
fn heal_publisher_installation_token_request_body() -> String {
  serialize_json(v: json_object(members: [
    json_kv(key: "repositories", value: json_array(elements: [json_string(s: gunbc_repository.name as String)])),
    json_kv(key: "permissions", value: json_object(members: [
      json_kv(
        key: permission_axis_wire_name(axis: contents_write.name) as String,
        value: json_string(s: permission_access_wire_name(access: contents_write.access) as String)
      )
    ]))
  ]))
}

fn heal_publisher_key_unreadable_message(http_status: String) -> String {
  join([
    "HealPublisherAppKeyUnreadable: Secret Manager answered HTTP ", http_status, " for ",
    secret_ref_version_resource(ref: gunbai_bot_app_pem_secret),
    " to the ", heal_publisher_service_account as String, " principal. 403 means the version exists and is not readable OR does not exist",
    " -- REMEDY: run gunbc.auth.heal_publisher_provision heal_publisher_key_provision_with_supplied_token, which provisions the key into that secret and binds roles/secretmanager.secretAccessor for that service account only after reading the version back.",
    " Minting NO token, so nothing is published."
  ], "")
}

fn heal_publisher_token_refused_message(status_line: String) -> String {
  join([
    "HealPublisherInstallationTokenRefused: GitHub answered ", status_line,
    " for the publisher App's installation; a revoked key, a removed installation, or a Contents permission",
    " that is no longer write each look like this -- inspect the App's installation on this repository"
  ], "")
}
