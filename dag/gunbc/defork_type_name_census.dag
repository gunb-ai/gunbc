module gunbc.defork_type_name_census

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, decl_ref, declaration_ref_display_key }
import std.markdown { MarkdownBlock, TableBlock, AlignNone }
import gunbc.plan { PlanDerivation, PlanDerived, PlanDerivationRefused }
import gunbc.plans.md_helpers { h2, p, cell, row }
import v2.std.decl_index { DeclFact, decl_facts, TypeItem, FnItem, DataItem, ServiceItem, OtherItem }
import v2.std.decl_ref_resolution { resolve_declaration_ref_live, declaration_ref_resolution_is_resolved }

// THE SHARED TYPE-NAME CENSUS OF THE dag/std <-> src/v2/std FORK, DERIVED RATHER THAN TRANSCRIBED.
//
// The population -- every type name declared under both standard-library roots -- is a fact about
// the live tree, so it is read from the namespace (`v2.std.decl_index` `decl_facts`) and never
// written down (DESIGN §6: name the instrument, never transcribe its output; §5: a measurement
// copied from the current tree is not an oracle). What IS authored is what a person decided about
// each name: its disposition. The two meet in an IDENTITY JOIN by name, refused in both directions
// -- a derived name no row disposes of, and a row naming a pair that no longer exists -- so the
// authored half cannot drift from the derived half without the plan's generation refusing, and
// with it the required generated-artifact drift gate.
//
// "Declares a type" is the seed's item kind: `TypeItem` (a record or coproduct) or `OtherItem` (a
// declaration with no connective, transport or body -- on these two roots, exactly the `type`
// aliases). The node kind cannot be used instead: a function's declaration node is its signature,
// a TypeNode. Any over-inclusion by `OtherItem` fails CLOSED: a non-type declaration entering the
// population is a name no disposition row carries, and that refuses.
data defork_census_dag_root: String = "dag/std"
data defork_census_v2_root: String = "src/v2/std"

type SharedTypeName {
  name: String
  dag_files: List<String>
  v2_files: List<String>
}

fn census_declares_type(f: DeclFact) -> Bool {
  match f.kind {
    TypeItem => true
    OtherItem => true
    FnItem => false
    DataItem => false
    ServiceItem => false
  }
}

fn census_under(f: DeclFact, root: String) -> Bool {
  starts_with(f.rel_path, concat(root, "/"))
}

fn census_names_of(facts: List<DeclFact>) -> List<String> {
  census_names_of_strings(xs: map(facts, x => x.name))
}

fn census_files_named(facts: List<DeclFact>, name: String) -> List<String> {
  map(filter(facts, x => x.name == name), x => x.rel_path)
}

// Pure over the facts it is handed, so a claim can supply a planted fixture pool and the plan can
// supply the live one: one derivation, two callers, no second walker.
fn shared_type_names(facts: List<DeclFact>, dag_root: String, v2_root: String) -> List<SharedTypeName> {
  let types = filter(facts, f => census_declares_type(f: f))
  let dag_side = filter(types, f => census_under(f: f, root: dag_root))
  let v2_side = filter(types, f => census_under(f: f, root: v2_root))
  let v2_names = census_names_of(facts: v2_side)
  map(
    filter(census_names_of(facts: dag_side), n => v2_names.contains(n)),
    n => SharedTypeName {
      name: n,
      dag_files: census_files_named(facts: dag_side, name: n),
      v2_files: census_files_named(facts: v2_side, name: n)
    }
  )
}

// WHAT EACH SIDE'S BODY RESOLVES TO IS AUTHORED HERE, AND IS TYPED AS AUTHORED. The census's
// classification compares resolved referents, not body text, and no module-scoped type-reference
// resolution over the live pool is consumable from .dag today (import facts carry the target
// module and never the imported names; the pool-wide bare-name read is not scope-aware). Hand-
// rolling one here would be a second resolver beside the compiler's. So the reading is a person's,
// recorded with the frontier below, and it is rendered under a heading that says so.
type AuthoredResolutionReading {
  dag_side: String
  v2_side: String
  class: String
}

type ReferentResolutionFrontier {
  capability: NonEmptyStr
  candidate_home: DeclarationRef
}

data defork_census_referent_frontier: ReferentResolutionFrontier = ReferentResolutionFrontier {
  capability: "module-scoped type-reference resolution over the live pool, consumable from .dag: for a type declaration, each name its body references resolved to the declaration it binds in that module's scope (its own declarations, else its imports). When it lands, the three reading columns of every row here are derived from it and the authored readings are deleted; nothing else retires this frontier.",
  candidate_home: decl_ref(module_path: "v2.compiler.name_resolve", decl_name: "resolve_with_admission")
}

type SharedTypeNameDisposition
  = ForkOpen { reason: String }
  | ForkAwaitingRuling { question: String }
  | ForkNeedsDecisionRecord { family: String }

type SharedTypeNameRow {
  names: List<String>
  reading: AuthoredResolutionReading
  disposition: SharedTypeNameDisposition
}

// A name the fork shared and no longer does. It is not a disposition of a live pair -- there is no
// pair left to key on -- but the inverse obligation: the name must STAY absent from the derived
// population, so a re-fork refuses by name.
type ForkResolution
  = ResolvedByRenamingV2 { renamed_to: String, citation: String }
  | ResolvedByDeletingV2 { reason: String }
  | ResolvedByRenamingDag { renamed_to: String, citation: String }

type ResolvedSharedTypeName {
  names: List<String>
  resolution: ForkResolution
  change: Int
}

type DeforkCensusFinding
  = UndisposedSharedTypeName { name: String }
  | StaleDisposition { name: String }
  | DuplicateDisposition { name: String }
  | ResolvedNameReforked { name: String, change: Int }

fn census_row_names(rows: List<SharedTypeNameRow>) -> List<String> {
  fold(rows, init: [], f: fn(acc, r) { concat(acc, r.names) })
}

fn census_resolved_names(resolved: List<ResolvedSharedTypeName>) -> List<String> {
  fold(resolved, init: [], f: fn(acc, r) { concat(acc, r.names) })
}

fn census_count(xs: List<String>, x: String) -> Int {
  length(xs: filter(xs, y => y == x))
}

fn defork_census_findings(
  shared: List<SharedTypeName>,
  rows: List<SharedTypeNameRow>,
  resolved: List<ResolvedSharedTypeName>
) -> List<DeforkCensusFinding> {
  let live = map(shared, s => s.name)
  let disposed = census_row_names(rows: rows)
  let undisposed = map(filter(live, n => !disposed.contains(n)), n => UndisposedSharedTypeName { name: n })
  let stale = map(filter(disposed, n => !live.contains(n)), n => StaleDisposition { name: n })
  let duplicate = map(
    filter(census_names_of_strings(xs: disposed), n => census_count(xs: disposed, x: n) > 1),
    n => DuplicateDisposition { name: n }
  )
  let reforked = fold(resolved, init: [], f: fn(acc, r) {
    concat(acc, map(filter(r.names, n => live.contains(n)), n => ResolvedNameReforked { name: n, change: r.change }))
  })
  concat(concat(concat(undisposed, stale), duplicate), reforked)
}

fn census_names_of_strings(xs: List<String>) -> List<String> {
  fold(xs, init: [], f: fn(acc, x) { if acc.contains(x) { acc } else { concat(acc, [x]) } })
}

fn defork_census_finding_text(f: DeforkCensusFinding) -> String {
  match f {
    UndisposedSharedTypeName { name } =>
      concat(concat("UndisposedSharedTypeName: ", name), " is declared as a type under both roots and no disposition row names it")
    StaleDisposition { name } =>
      concat(concat("StaleDisposition: a disposition row names ", name), ", which is no longer declared as a type under both roots")
    DuplicateDisposition { name } =>
      concat(concat("DuplicateDisposition: ", name), " is named by more than one disposition row")
    ResolvedNameReforked { name, change } =>
      concat(concat(concat(concat("ResolvedNameReforked: ", name), " was resolved by #"), change as String), " and is declared under both roots again")
  }
}

fn defork_census_findings_text(findings: List<DeforkCensusFinding>) -> String {
  fold(findings, init: "", f: fn(acc, x) {
    if acc == "" { defork_census_finding_text(f: x) } else { concat(concat(acc, "; "), defork_census_finding_text(f: x)) }
  })
}

