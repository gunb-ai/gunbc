data defork_census_resolved: List<ResolvedSharedTypeName> = [
  ResolvedSharedTypeName {
    names: ["ProjectionKind"],
    resolution: ResolvedByDeletingV2 { reason: "`v2.std.projection` (compiler lens kinds) had zero importers; `std.planar_projection` keeps the name for drawing views" },
    change: 12252
  },
  ResolvedSharedTypeName {
    names: ["AlgebraCarrier"],
    resolution: ResolvedByDeletingV2 { reason: "`v2.std.rust_leaf_model_claim` type and datum were never read; `std.algebra` `AlgebraProfile` `OrderedRingProfile` already names that structure" },
    change: 12252
  },
  ResolvedSharedTypeName {
    names: ["ApproximateField"],
    resolution: ResolvedByDeletingV2 { reason: "`v2.std.algebra` ops record had zero consumers; ops come from inhabitance (DESIGN §4)" },
    change: 12252
  },
  ResolvedSharedTypeName {
    names: ["EffectRequest"],
    resolution: ResolvedByRenamingV2 { renamed_to: "OperationCall", citation: "Plotkin–Pretnar, *Handling Algebraic Effects* (LMCS 2013): `op(v; y.c)` is an operation call" },
    change: 12252
  },
  ResolvedSharedTypeName {
    names: ["Float32", "Float64"],
    resolution: ResolvedByRenamingV2 { renamed_to: "Binary32 / Binary64", citation: "IEEE 754-2019 §3.6 interchange-format names" },
    change: 12252
  },
  ResolvedSharedTypeName {
    names: ["RankingDimension"],
    resolution: ResolvedByRenamingV2 { renamed_to: "RankingComponent", citation: "Ben-Amram & Genaim, *Ranking Functions for Linear-Constraint Loops* (JACM 2014): a lexicographic ranking function's components" },
    change: 12252
  },
  ResolvedSharedTypeName {
    names: ["TestClaim"],
    resolution: ResolvedByRenamingDag { renamed_to: "AssertionClaim", citation: "a name collision resolved by renaming apart, not a grounding merge" },
    change: 5640
  },
]

fn census_names_text(names: List<String>) -> String {
  fold(names, init: "", f: fn(acc, n) {
    let q = concat(concat("`", n), "`")
    if acc == "" { q } else { concat(concat(acc, ", "), q) }
  })
}

fn census_disposition_text(d: SharedTypeNameDisposition) -> String {
  match d {
    ForkOpen { reason } => concat("OPEN — ", reason)
    ForkAwaitingRuling { question } => concat("AWAITING OPERATOR RULING — ", question)
    ForkNeedsDecisionRecord { family } => concat(concat("NEEDS A DECISION RECORD (", family), ")")
  }
}

fn census_resolution_text(r: ForkResolution) -> String {
  match r {
    ResolvedByRenamingV2 { renamed_to, citation } => concat(concat(concat("v2 side renamed `", renamed_to), "` — "), citation)
    ResolvedByDeletingV2 { reason } => concat("v2 side deleted — ", reason)
    ResolvedByRenamingDag { renamed_to, citation } => concat(concat(concat("dag side renamed `", renamed_to), "` — "), citation)
  }
}

fn census_declared_in(shared: List<SharedTypeName>, names: List<String>) -> String {
  let files = fold(filter(shared, s => names.contains(s.name)), init: [], f: fn(acc, s) { concat(concat(acc, s.dag_files), s.v2_files) })
  census_names_text(names: census_names_of_strings(xs: files))
}

fn defork_census_blocks(shared: List<SharedTypeName>, rows: List<SharedTypeNameRow>, resolved: List<ResolvedSharedTypeName>) -> List<MarkdownBlock> {
  [
    h2(text: "2D. The shared type-name census (the one list): the population is derived, the dispositions are authored"),
    p(text: concat(concat(concat(concat(
      "**Derived:** every name declared as a `type` (record, coproduct or alias) under both `dag/std` and `src/v2/std`, read from the namespace by `gunbc.defork_type_name_census` `shared_type_names` at generation — **",
      length(xs: shared) as String),
      " names** in this projection. **Authored:** each row's disposition, and — until the frontier below lands — the reading of what each side's body RESOLVES to. The two meet in an identity join by name, refused in both directions (a derived name no row disposes of; a row naming a pair that no longer exists), so this section cannot be generated from a stale disposition. Resolution, not body text, is what separates the classes: `Float = Float64` was byte-identical on both sides and bound two different `Float64`s. A **meaning fork** is one name for materially different concepts (DESIGN §3), resolved by renaming or deleting one side at its declaration, delete-first with no alias, the new name taken from the cited framework. **Frontier:** "),
      defork_census_referent_frontier.capability as String),
      concat(concat(" Candidate home: `", declaration_ref_display_key(ref: defork_census_referent_frontier.candidate_home)), "`.")
    )),
    TableBlock {
      header: row(cells: [cell(text: "name(s)"), cell(text: "declared in (derived)"), cell(text: "dag/std side (authored reading)"), cell(text: "src/v2/std side (authored reading)"), cell(text: "class (authored)"), cell(text: "disposition")]),
      alignments: [AlignNone, AlignNone, AlignNone, AlignNone, AlignNone, AlignNone],
      rows: map(rows, r => row(cells: [
        cell(text: census_names_text(names: r.names)),
        cell(text: census_declared_in(shared: shared, names: r.names)),
        cell(text: r.reading.dag_side),
        cell(text: r.reading.v2_side),
        cell(text: r.reading.class),
        cell(text: census_disposition_text(d: r.disposition))
      ])),
    },
    p(text: "**Resolved — each name must stay absent from the derived population; a name here that is declared under both roots again refuses by name:**"),
    TableBlock {
      header: row(cells: [cell(text: "name(s)"), cell(text: "resolution"), cell(text: "change")]),
      alignments: [AlignNone, AlignNone, AlignNone],
      rows: map(resolved, r => row(cells: [
        cell(text: census_names_text(names: r.names)),
        cell(text: census_resolution_text(r: r.resolution)),
        cell(text: concat("#", r.change as String))
      ])),
    },
  ]
}

fn defork_census_derivation_over(
  shared: List<SharedTypeName>,
  rows: List<SharedTypeNameRow>,
  resolved: List<ResolvedSharedTypeName>
) -> PlanDerivation {
  let findings = defork_census_findings(shared: shared, rows: rows, resolved: resolved)
  if length(xs: findings) > 0 {
    PlanDerivationRefused { reason: defork_census_findings_text(findings: findings) }
  } else {
    PlanDerived { blocks: defork_census_blocks(shared: shared, rows: rows, resolved: resolved) }
  }
}

// The live route, called only where the plan's bytes are generated. It also refuses a frontier
// whose candidate home no longer resolves: a citation that fails to resolve is a §3 defect, and
// this is the one place it is read.
fn defork_census_derivation() -> PlanDerivation {
  let roots = [defork_census_dag_root, defork_census_v2_root]
  if !declaration_ref_resolution_is_resolved(
    resolution: resolve_declaration_ref_live(ref: defork_census_referent_frontier.candidate_home, pool_roots: ["src/v2/compiler"])
  ) {
    PlanDerivationRefused {
      reason: concat("the referent-resolution frontier's candidate home does not resolve: ", declaration_ref_display_key(ref: defork_census_referent_frontier.candidate_home))
    }
  } else {
    defork_census_derivation_over(
      shared: shared_type_names(facts: decl_facts(pool_roots: roots), dag_root: defork_census_dag_root, v2_root: defork_census_v2_root),
      rows: defork_census_rows,
      resolved: defork_census_resolved
    )
  }
}
