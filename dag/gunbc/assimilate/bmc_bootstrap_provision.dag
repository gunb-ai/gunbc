module gunbc.assimilate.bmc_bootstrap_provision

// GcpPolicy and merge_policy_bindings are named explicitly rather than reached as bare references:
// policy assembly now comes from the IAM authority, and a bare reference to it would resolve only
// when some unrelated module in the closure happened to drag that definer into the pool.
import extdeps.cloud.gcp.iam { GcpPolicy, GcpBinding, merge_policy_bindings }


data bmc_assimilate_service_deps: List<GcpService> = [
  GcpServiceUsage,
  GcpIam,
  GcpIamCredentials,
  GcpSts,
  GcpSecretManager
]

data bmc_required_gcp_apis: List<String> = map(bmc_assimilate_service_deps, s => gcp_service_api_id(service: s))

fn bmc_secret_iam_bindings() -> List<GcpBinding> {
  [
    GcpBinding {
      role: role_secretmanager_secret_accessor,
      members: [bmc_assimilator_sa_member()]
    },
    GcpBinding {
      role: role_secretmanager_secret_version_adder,
      members: [bmc_assimilator_sa_member()]
    }
  ]
}

data bmc_bootstrap_provision_eager_auth_print_access_token_fork: String = "🟡 dissolve-on: node auth calls shell.GCloud.AuthPrintAccessToken() directly instead of gunbc.auth.access_token_source.ensure_access_token(source: GcloudPrintToken). DISSOLVES WHEN this pattern routes token acquisition through ensure_access_token and deletes the shell.GCloud node. Authority cross-ref: ensure_access_token_eager_bootstrap_fork_dissolve_on in gunbc.auth.access_token_source."

pattern bmc_bootstrap_provision_srv3() -> {
  sa_email: ServiceAccountEmail,
  secret_binding_etag: String,
  pool_op: String,
  provider_op: String
}
  uses net: std.resources.Network
{
  node auth: shell.GCloud.AuthPrintAccessToken()

  node enabled: gcp.ServiceUsage.BatchEnableServices(
    access_token: auth.access_token,
    project_id: bmc_secrets_project_id,
    service_ids: bmc_required_gcp_apis
  )

  node sa: gcp.IamAdmin.CreateServiceAccount(
    access_token: auth.access_token,
    project_id: bmc_secrets_project_id,
    account_id: bmc_assimilator_account_id,
    display_name: bmc_assimilator_display_name
  )

  node observed_policy: gcp.SecretManager.GetSecretIamPolicy(
    access_token: auth.access_token,
    project_id: bmc_secrets_project_id,
    secret: bmc_srv3_secret_name
  )

  node bind: gcp.SecretManager.SetSecretIamPolicy(
    access_token: auth.access_token,
    project_id: bmc_secrets_project_id,
    secret: bmc_srv3_secret_name,
    policy: merge_policy_bindings(
      observed: GcpPolicy { bindings: observed_policy.bindings, etag: observed_policy.etag, version: observed_policy.version },
      desired: bmc_secret_iam_bindings()
    )
  )

  node pool: gcp.IamAdmin.CreateWorkloadIdentityPool(
    access_token: auth.access_token,
    project_id: bmc_secrets_project_id,
    pool_id: bmc_wif_pool_id,
    display_name: bmc_wif_pool_display_name
  )

  node provider: gcp.IamAdmin.CreateWorkloadIdentityPoolProvider(
    access_token: auth.access_token,
    project_id: bmc_secrets_project_id,
    pool_id: bmc_wif_pool_id,
    provider_id: bmc_wif_provider_id,
    issuer_uri: bmc_wif_issuer_uri,
    attribute_mapping: bmc_wif_attribute_mapping,
    attribute_condition: bmc_wif_attribute_condition()
  )

  return {
    sa_email: sa.email,
    secret_binding_etag: bind.etag,
    pool_op: pool.operation_name,
    provider_op: provider.operation_name
  }
}