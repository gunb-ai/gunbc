module gunbc.assimilate.bmc_bootstrap_provision

// The IAM reconciliation authority is named explicitly rather than reached as bare references:
// policy assembly now comes from the IAM authority, and a bare reference to it would resolve only
// when some unrelated module in the closure happened to drag that definer into the pool.
import extdeps.cloud.gcp.iam {
  GcpPolicy, GcpBinding, GcpIamBindingCell, GcpIamOwnedCellUniverse,
  GcpPolicyReconciliation, GcpPolicyAlreadyConverged, GcpPolicyDeltaRequired,
  reconcile_gcp_policy, gcp_binding_cells, no_gcp_cells, GcpPolicyRepresentationLossy, gcp_policy_from_wire
}
import extdeps.transports.rest { RestResult, RestAnswered, RestRefused, RestRefusal }
import std.types { Secret }

data bmc_assimilate_service_deps: List<GcpService> = [
  GcpServiceUsage,
  GcpIam,
  GcpIamCredentials,
  GcpSts,
  GcpSecretManager
]

data bmc_required_gcp_apis: List<String> = map(bmc_assimilate_service_deps, s => gcp_service_api_id(service: s))

fn bmc_secret_iam_bindings() -> List<GcpBinding> {
  [
    GcpBinding {
      role: role_secretmanager_secret_accessor,
      members: [bmc_assimilator_sa_member()]
    },
    GcpBinding {
      role: role_secretmanager_secret_version_adder,
      members: [bmc_assimilator_sa_member()]
    }
  ]
}

// 🟡 dissolve-on: node auth calls shell.GCloud.AuthPrintAccessToken() directly instead of
// gunbc.auth.access_token_source.ensure_access_token(source: GcloudPrintToken). DISSOLVES WHEN this
// pattern routes token acquisition through ensure_access_token and deletes the shell.GCloud node.
// Authority: gunbc.auth.access_token_source ensure_access_token.

pattern bmc_bootstrap_provision_srv3() -> BmcBootstrapProvision
  uses net: std.resources.Network
{
  node auth: shell.GCloud.AuthPrintAccessToken()

  node enabled: gcp.ServiceUsage.BatchEnableServices(
    access_token: auth.access_token,
    project_id: bmc_secrets_project_id,
    service_ids: bmc_required_gcp_apis
  )

  return match enabled {
    RestRefused { refusal } =>
      BmcBootstrapProvisionRefused { step: BmcBootstrapEnableServices, refusal: refusal }
    RestAnswered { answer: _ } =>
      bmc_bootstrap_create_service_account(access_token: auth.access_token)
  }
}

// ONE REST STEP PER PATTERN, EACH REACHED ONLY FROM THE ANSWERED ARM OF THE STEP BEFORE IT. A node
// inside one pattern is unconditional, so a chain written as six nodes would perform every later
// effect after an earlier one refused. Each continuation below therefore holds exactly one node,
// receives what the earlier steps answered as parameters, and is invoked from the RestAnswered arm
// alone; a RestRefused arm ends the chain with the step named and the refusal as the transport
// reported it. The order is the order the single pattern had: enable services, create service
// account, read secret policy, set secret policy, create pool, create provider.
//
// THE REFUSED ARM CLAIMS NOTHING ABOUT WHETHER A MUTATION COMMITTED. It carries the RestRefusal and
// the step; whether a refused write may have landed is the reader's classification
// (extdeps.transports.rest classify_rest_refusal), not a fact this result asserts.
type BmcBootstrapStep
  = BmcBootstrapEnableServices
  | BmcBootstrapCreateServiceAccount
  | BmcBootstrapReadSecretPolicy
  | BmcBootstrapSetSecretPolicy
  | BmcBootstrapCreatePool
  | BmcBootstrapCreateProvider

type BmcBootstrapProvision
  = BmcBootstrapProvisioned {
      sa_email: ServiceAccountEmail
      secret_binding_etag: String
      pool_op: String
      provider_op: String
    }
  | BmcBootstrapProvisionRefused { step: BmcBootstrapStep, refusal: RestRefusal }

pattern bmc_bootstrap_create_service_account(access_token: Secret) -> BmcBootstrapProvision
  uses net: std.resources.Network
{
  node sa: gcp.IamAdmin.CreateServiceAccount(
    access_token: access_token,
    project_id: bmc_secrets_project_id,
    account_id: bmc_assimilator_account_id,
    display_name: bmc_assimilator_display_name
  )

  return match sa {
    RestRefused { refusal } =>
      BmcBootstrapProvisionRefused { step: BmcBootstrapCreateServiceAccount, refusal: refusal }
    RestAnswered { answer } =>
      bmc_bootstrap_read_secret_policy(access_token: access_token, sa_email: answer.email)
  }
}

pattern bmc_bootstrap_read_secret_policy(
  access_token: Secret,
  sa_email: ServiceAccountEmail
) -> BmcBootstrapProvision
  uses net: std.resources.Network
{
  node observed_policy: gcp.SecretManager.GetSecretIamPolicy(
    access_token: access_token,
    project_id: bmc_secrets_project_id,
    secret: bmc_srv3_secret_name
  )

  return match observed_policy {
    RestRefused { refusal } =>
      BmcBootstrapProvisionRefused { step: BmcBootstrapReadSecretPolicy, refusal: refusal }
    RestAnswered { answer } =>
      bmc_bootstrap_set_secret_policy(
        access_token: access_token,
        sa_email: sa_email,
        observed: gcp_policy_from_wire(bindings: answer.bindings, etag: answer.etag, version: answer.version)
      )
  }
}

pattern bmc_bootstrap_set_secret_policy(
  access_token: Secret,
  sa_email: ServiceAccountEmail,
  observed: GcpPolicy
) -> BmcBootstrapProvision
  uses net: std.resources.Network
{
  node bind: gcp.SecretManager.SetSecretIamPolicy(
    access_token: access_token,
    project_id: bmc_secrets_project_id,
    secret: bmc_srv3_secret_name,
    policy: bmc_secret_iam_bindings_reconciled_policy(observed: observed)
  )

  return match bind {
    RestRefused { refusal } =>
      BmcBootstrapProvisionRefused { step: BmcBootstrapSetSecretPolicy, refusal: refusal }
    RestAnswered { answer } =>
      bmc_bootstrap_create_pool(
        access_token: access_token,
        sa_email: sa_email,
        secret_binding_etag: answer.etag
      )
  }
}

pattern bmc_bootstrap_create_pool(
  access_token: Secret,
  sa_email: ServiceAccountEmail,
  secret_binding_etag: String
) -> BmcBootstrapProvision
  uses net: std.resources.Network
{
  node pool: gcp.IamAdmin.CreateWorkloadIdentityPool(
    access_token: access_token,
    project_id: bmc_secrets_project_id,
    pool_id: bmc_wif_pool_id,
    display_name: bmc_wif_pool_display_name
  )

  return match pool {
    RestRefused { refusal } =>
      BmcBootstrapProvisionRefused { step: BmcBootstrapCreatePool, refusal: refusal }
    RestAnswered { answer } =>
      bmc_bootstrap_create_provider(
        access_token: access_token,
        sa_email: sa_email,
        secret_binding_etag: secret_binding_etag,
        pool_op: answer.operation_name
      )
  }
}

pattern bmc_bootstrap_create_provider(
  access_token: Secret,
  sa_email: ServiceAccountEmail,
  secret_binding_etag: String,
  pool_op: String
) -> BmcBootstrapProvision
  uses net: std.resources.Network
{
  node provider: gcp.IamAdmin.CreateWorkloadIdentityPoolProvider(
    access_token: access_token,
    project_id: bmc_secrets_project_id,
    pool_id: bmc_wif_pool_id,
    provider_id: bmc_wif_provider_id,
    issuer_uri: bmc_wif_issuer_uri,
    attribute_mapping: bmc_wif_attribute_mapping,
    attribute_condition: bmc_wif_attribute_condition()
  )

  return match provider {
    RestRefused { refusal } =>
      BmcBootstrapProvisionRefused { step: BmcBootstrapCreateProvider, refusal: refusal }
    RestAnswered { answer } =>
      BmcBootstrapProvisioned {
        sa_email: sa_email,
        secret_binding_etag: secret_binding_etag,
        pool_op: pool_op,
        provider_op: answer.operation_name
      }
  }
}

// THIS CALLER'S OWNED CELLS, stated explicitly. Whole-role replacement is not a safe default: it
// drops any member under an authored role that this caller did not author. Naming the owned
// universe is what lets reconcile_gcp_policy preserve those members while still retiring cells this
// caller genuinely owns and no longer desires.
fn bmc_secret_iam_bindings_owned_cells() -> List<GcpIamBindingCell> {
  fold(bmc_secret_iam_bindings(), init: no_gcp_cells, f: (acc, b) =>
    fold(gcp_binding_cells(b: b), init: acc, f: (inner, c) => inner |> list_push(c)))
}

// THE LOSSY ARM RETURNS THE OBSERVATION UNCHANGED, WHICH IS STRICTLY SAFER THAN THIS SITE'S PRIOR
// BEHAVIOUR AND STILL NOT A REFUSAL. A version-1 read of a conditional policy comes back with
// condition-mangled role names; before that arm existed this call site would have taken the delta
// path, computed that its unconditional cell was missing, and written it -- replacing somebody's
// restricted access with an unconditional grant. Returning the observation means this site proposes
// no change at all when it cannot see what it is changing.
//
// It is NOT a refusal, and the difference is the bypass named below: a `node bind:` pattern cannot
// skip its own effect, so the write still happens, now with the mangled document the read produced.
// That is a policy GCP is unlikely to accept, but "the provider will probably reject it" is a
// boundary hope and not a modeled guarantee, so it is recorded as the honest state rather than
// counted as safety. The class and its dissolution are unchanged: it retires with the same EffectPlan
// migration the paragraph below names, at which point the verdict selects whether the write step
// exists and this arm becomes a real refusal.
//
// KNOWN BYPASS, named rather than hidden. Both arms below return the policy, so a CONVERGED
// policy is still written: the GcpPolicyAlreadyConverged arm is computed and discarded here, which
// means the no-op protection the reconcile authority provides does NOT reach this call site. That
// is a real gap, not a cosmetic one -- an unnecessary setIamPolicy advances the etag, so a
// convergent re-run looks like it changed something.
//
// It is not repaired in place because the caller is a `node bind:` pattern invocation, which
// cannot branch on a verdict to skip its own effect: once bmc_bootstrap_set_secret_policy is
// entered its write happens. The verdict would have to be consumed one step earlier, where the
// read's answered arm selects that continuation, and that selection is not made today.
// DISSOLVE-ON: the BMC bootstrap patterns become EffectPlan steps, at which point the reconcile
// verdict selects whether the SetSecretIamPolicy step is present at all, and this wrapper is
// deleted rather than returning a policy the caller was never meant to write.
fn bmc_secret_iam_bindings_reconciled_policy(observed: GcpPolicy) -> GcpPolicy {
  match reconcile_gcp_policy(
    observed: observed,
    desired_owned: bmc_secret_iam_bindings_owned_cells(),
    owned_universe: GcpIamOwnedCellUniverse { cells: bmc_secret_iam_bindings_owned_cells() }
  ) {
    GcpPolicyRepresentationLossy { conditional_roles: _ } => observed
    GcpPolicyAlreadyConverged { policy: p } => p
    GcpPolicyDeltaRequired { policy: p, added: _, removed: _, preserved: _ } => p
  }
}
