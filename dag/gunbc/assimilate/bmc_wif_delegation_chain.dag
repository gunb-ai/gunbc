module gunbc.assimilate.bmc_wif_delegation_chain


data bmc_srv3_admin_secret_ref: extdeps.cloud.gcp.secret_ref.SecretRef = extdeps.cloud.gcp.secret_ref.SecretRef {
  project: gunbc.assimilate.bmc_token_federation.bmc_secrets_project_id,
  secret: gunbc.assimilate.bmc_token_federation.bmc_srv3_secret_name as std.types.NonEmptyStr,
  version: "latest",
  hash_state: extdeps.cloud.gcp.secret_ref.HashPending
}

data wif_canary_secret_name: std.types.NonEmptyStr = "wif-canary"

data wif_canary_secret_ref: extdeps.cloud.gcp.secret_ref.SecretRef = extdeps.cloud.gcp.secret_ref.SecretRef {
  project: gunbc.assimilate.bmc_token_federation.bmc_secrets_project_id,
  secret: wif_canary_secret_name,
  version: "latest",
  hash_state: extdeps.cloud.gcp.secret_ref.HashPending
}

fn bmc_wif_designated_job_id() -> std.types.NonEmptyStr {
  gunbc.assimilate.bmc_token_federation.bmc_token_smoke_job().id as std.types.NonEmptyStr
}

fn bmc_wif_grant_principal() -> gunbc.auth.secret_access_grant.GrantPrincipal {
  gunbc.auth.secret_access_grant.GrantPrincipal {
    service_account: gunbc.assimilate.bmc_token_federation.bmc_assimilator_sa_email,
    condition: gunbc.auth.secret_access_grant.GrantPrincipalCondition {
      workflow_or_job: bmc_wif_designated_job_id(),
      attribute_condition: gunbc.assimilate.bmc_token_federation.bmc_wif_attribute_condition() as std.types.NonEmptyStr
    }
  }
}

data bmc_wif_canary_grant: gunbc.auth.secret_access_grant.SecretAccessGrant = gunbc.auth.secret_access_grant.SecretAccessGrant {
  secret_ref: wif_canary_secret_ref,
  principal: bmc_wif_grant_principal(),
  role: "roles/secretmanager.secretAccessor",
  consumer: "bmc_token_smoke",
  justification: "prove the WIF chain resolves keylessly against a worthless value before any real secret is bound",
  signoff: gunbc.auth.secret_access_grant.Signed { signed_by: "operator", note: "canary-only, no sensitive value" },
  provenance: gunbc.auth.secret_access_grant.DeclaredInModel
}

data bmc_srv3_admin_access_grant: gunbc.auth.secret_access_grant.SecretAccessGrant = gunbc.auth.secret_access_grant.SecretAccessGrant {
  secret_ref: bmc_srv3_admin_secret_ref,
  principal: bmc_wif_grant_principal(),
  role: "roles/secretmanager.secretAccessor",
  consumer: "bmc_assimilate_srv3",
  justification: "srv3 BMC admin credential readback for the assimilate/rotate flow",
  signoff: gunbc.auth.secret_access_grant.Unsigned,
  provenance: gunbc.auth.secret_access_grant.DeclaredInModel
}

data bmc_srv3_admin_legacy_binding: gunbc.auth.secret_access_grant.SecretAccessGrant = gunbc.auth.secret_access_grant.SecretAccessGrant {
  secret_ref: bmc_srv3_admin_secret_ref,
  principal: bmc_wif_grant_principal(),
  role: "roles/secretmanager.secretAccessor",
  consumer: "bmc_bootstrap_provision_srv3",
  justification: "already bound and proven live against gunbai-secrets on 2026-06-24, predates this grant model (docs/runbooks/bmc-assimilator-wif-setup.md); Signed = operator affirms keep, Unsigned = flagged pending an explicit keep-or-retire decision, neither state is applied by this codebase",
  signoff: gunbc.auth.secret_access_grant.Unsigned,
  provenance: gunbc.auth.secret_access_grant.AppliedOutOfBand {
    applied_at: "2026-06-24",
    note: "gunbc.assimilate.bmc_bootstrap_provision.bmc_bootstrap_provision_srv3, bmc_secret_iam_bindings()"
  }
}

data bmc_wif_all_grants: List<gunbc.auth.secret_access_grant.SecretAccessGrant> = [
  bmc_wif_canary_grant,
  bmc_srv3_admin_access_grant
]

data bmc_wif_legacy_grants: List<gunbc.auth.secret_access_grant.SecretAccessGrant> = [
  bmc_srv3_admin_legacy_binding
]

fn bmc_wif_signed_grants() -> List<gunbc.auth.secret_access_grant.SecretAccessGrant> {
  gunbc.auth.secret_access_grant.signed_grants_only(grants: bmc_wif_all_grants)
}

fn bmc_wif_bootstrap_bindings() -> List<extdeps.cloud.gcp.iam.GcpBinding> {
  gunbc.auth.secret_access_grant.signed_grant_bindings(grants: bmc_wif_all_grants)
}

type CredentialDelegationStep
  = GhaOidcIssuance { audience: std.types.NonEmptyStr, designated_job: std.types.NonEmptyStr }
  | WifTokenExchange { pool: extdeps.cloud.gcp.gcp.WifPool, provider: extdeps.cloud.gcp.gcp.WifProvider, attribute_condition: std.types.NonEmptyStr }
  | ServiceAccountImpersonation { impersonated_sa: extdeps.cloud.gcp.gcp.ServiceAccountEmail, granted_roles: List<String> }
  | SecretVersionAccess { secret_ref: extdeps.cloud.gcp.secret_ref.SecretRef }

type WifDelegationChain {
  steps: List<CredentialDelegationStep>
}

fn bmc_wif_delegation_chain(secret_ref: extdeps.cloud.gcp.secret_ref.SecretRef, granted_roles: List<String>) -> WifDelegationChain {
  WifDelegationChain {
    steps: [
      GhaOidcIssuance {
        audience: extdeps.cloud.gcp.gcp.wif_provider_resource(project_number: gunbc.assimilate.bmc_token_federation.bmc_secrets_project_number, provider: gunbc.assimilate.bmc_token_federation.bmc_wif_provider) as std.types.NonEmptyStr,
        designated_job: bmc_wif_designated_job_id()
      },
      WifTokenExchange {
        pool: gunbc.assimilate.bmc_token_federation.bmc_wif_pool,
        provider: gunbc.assimilate.bmc_token_federation.bmc_wif_provider,
        attribute_condition: gunbc.assimilate.bmc_token_federation.bmc_wif_attribute_condition() as std.types.NonEmptyStr
      },
      ServiceAccountImpersonation {
        impersonated_sa: gunbc.assimilate.bmc_token_federation.bmc_assimilator_sa_email,
        granted_roles: granted_roles
      },
      SecretVersionAccess { secret_ref: secret_ref }
    ]
  }
}

data bmc_wif_canary_delegation_chain: WifDelegationChain = bmc_wif_delegation_chain(
  secret_ref: wif_canary_secret_ref,
  granted_roles: ["roles/secretmanager.secretAccessor"]
)

type Srv3CredentialPathOption
  = OperatorOneHourToken
  | ActorPinnedWorkflowDispatch { allowed_actor: std.types.NonEmptyStr }
  | DedicatedActuatorIdentity { note: std.types.NonEmptyStr }
  | ExistingAssimilatorSaBinding { legacy_grant: gunbc.auth.secret_access_grant.SecretAccessGrant }

data srv3_credential_path_options: List<Srv3CredentialPathOption> = [
  OperatorOneHourToken,
  ActorPinnedWorkflowDispatch { allowed_actor: "briansrls" },
  DedicatedActuatorIdentity { note: "separate SA from the CI federation SA, scoped to srv1 actuation only" },
  ExistingAssimilatorSaBinding { legacy_grant: bmc_srv3_admin_legacy_binding }
]

type SecretReadCapability
  = MergeToMainAuthorViaDesignatedJobEdit
  | CodeExecOnRunnerHostDuringJobWindow

data bound_secret_read_capabilities: List<SecretReadCapability> = [
  MergeToMainAuthorViaDesignatedJobEdit,
  CodeExecOnRunnerHostDuringJobWindow
]
