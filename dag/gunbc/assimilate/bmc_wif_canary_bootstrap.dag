module gunbc.assimilate.bmc_wif_canary_bootstrap

// The IAM reconciliation authority is named explicitly rather than reached as bare references:
// policy assembly now comes from the IAM authority, and a bare reference to it would resolve only
// when some unrelated module in the closure happened to drag that definer into the pool.


data bmc_wif_bootstrap_service_deps: List<extdeps.cloud.gcp.gcp.GcpService> = [
  GcpServiceUsage,
  GcpIam,
  GcpIamCredentials,
  GcpSts,
  GcpSecretManager
]

data bmc_wif_bootstrap_required_apis: List<String> = map(bmc_wif_bootstrap_service_deps, s => gcp_service_api_id(service: s))

pattern bmc_wif_canary_bootstrap() -> {
  sa_email: extdeps.cloud.gcp.gcp.ServiceAccountEmail,
  canary_secret_name: String,
  canary_binding_etag: String,
  pool_op: String,
  provider_op: String
}
  uses net: std.resources.Network
{
  node auth: shell.GCloud.AuthPrintAccessToken()

  node enabled: gcp.ServiceUsage.BatchEnableServices(
    access_token: auth.access_token,
    project_id: bmc_secrets_project_id,
    service_ids: bmc_wif_bootstrap_required_apis
  )

  node sa: gcp.IamAdmin.CreateServiceAccount(
    access_token: auth.access_token,
    project_id: bmc_secrets_project_id,
    account_id: bmc_assimilator_account_id,
    display_name: bmc_assimilator_display_name
  )

  node canary: gcp.SecretManager.CreateSecret(
    access_token: auth.access_token,
    project_id: bmc_secrets_project_id,
    secret_id: wif_canary_secret_name
  )

  node observed_policy: gcp.SecretManager.GetSecretIamPolicy(
    access_token: auth.access_token,
    project_id: bmc_secrets_project_id,
    secret: wif_canary_secret_name
  )

  node bind: gcp.SecretManager.SetSecretIamPolicy(
    access_token: auth.access_token,
    project_id: bmc_secrets_project_id,
    secret: wif_canary_secret_name,
    policy: bmc_wif_bootstrap_bindings_reconciled_policy(
      observed: extdeps.cloud.gcp.iam.GcpPolicy { bindings: observed_policy.bindings, etag: observed_policy.etag, version: observed_policy.version }
    )
  )

  node pool: gcp.IamAdmin.CreateWorkloadIdentityPool(
    access_token: auth.access_token,
    project_id: bmc_secrets_project_id,
    pool_id: bmc_wif_pool_id,
    display_name: bmc_wif_pool_display_name
  )

  node provider: gcp.IamAdmin.CreateWorkloadIdentityPoolProvider(
    access_token: auth.access_token,
    project_id: bmc_secrets_project_id,
    pool_id: bmc_wif_pool_id,
    provider_id: bmc_wif_provider_id,
    issuer_uri: bmc_wif_issuer_uri,
    attribute_mapping: bmc_wif_attribute_mapping,
    attribute_condition: bmc_wif_attribute_condition()
  )

  return {
    sa_email: sa.email,
    canary_secret_name: canary.name,
    canary_binding_etag: bind.etag,
    pool_op: pool.operation_name,
    provider_op: provider.operation_name
  }
}


// THIS CALLER'S OWNED CELLS, stated explicitly. Whole-role replacement is not a safe default: it
// drops any member under an authored role that this caller did not author. Naming the owned
// universe is what lets reconcile_gcp_policy preserve those members while still retiring cells this
// caller genuinely owns and no longer desires.
fn bmc_wif_bootstrap_bindings_owned_cells() -> List<extdeps.cloud.gcp.iam.GcpIamBindingCell> {
  fold(bmc_wif_bootstrap_bindings(), init: no_gcp_cells, f: (acc, b) =>
    fold(gcp_binding_cells(b: b), init: acc, f: (inner, c) => inner |> list_push(c)))
}

// KNOWN BYPASS, named rather than hidden. Both arms below return the policy, so a CONVERGED
// policy is still written: the GcpPolicyAlreadyConverged arm is computed and discarded here, which
// means the no-op protection the reconcile authority provides does NOT reach this call site. That
// is a real gap, not a cosmetic one -- an unnecessary setIamPolicy advances the etag, so a
// convergent re-run looks like it changed something.
//
// It is not repaired in place because the caller is a `node bind:` pattern invocation, which
// cannot branch on a verdict to skip its own effect; making the write conditional requires the
// call site to become an effect-plan step that can be selected or not.
// DISSOLVE-ON: the BMC bootstrap patterns become EffectPlan steps, at which point the reconcile
// verdict selects whether the SetSecretIamPolicy step is present at all, and this wrapper is
// deleted rather than returning a policy the caller was never meant to write.
fn bmc_wif_bootstrap_bindings_reconciled_policy(observed: extdeps.cloud.gcp.iam.GcpPolicy) -> extdeps.cloud.gcp.iam.GcpPolicy {
  match reconcile_gcp_policy(
    observed: observed,
    desired_owned: bmc_wif_bootstrap_bindings_owned_cells(),
    owned_universe: extdeps.cloud.gcp.iam.GcpIamOwnedCellUniverse { cells: bmc_wif_bootstrap_bindings_owned_cells() }
  ) {
    GcpPolicyAlreadyConverged { policy: p } => p
    GcpPolicyDeltaRequired { policy: p, added: _, removed: _, preserved: _ } => p
  }
}
