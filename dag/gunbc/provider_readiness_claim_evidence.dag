module gunbc.provider_readiness_claim_evidence

import std.types { NonEmptyStr, RunKey }
import std.claim_evidence {
  RecordedFact,
  Claim,
  InferenceRuleId,
  EvidenceProvenance,
  EvidenceFreshness,
  EvidenceFidelity,
  EvidenceSupports,
  EvidenceChallenges,
  EvidenceLink,
  EvidenceInsufficiency,
  EvidenceInference,
  insufficient_evidence_inference,
}
import extdeps.external_authority { ExternalAuthority }
import extdeps.llm.cli_lifecycle {
  ProviderInstance,
  ProviderKind,
  ProviderReadiness,
  ProviderCredentialsRecordedUnverified,
  ProviderRefreshFailed,
  ProviderAuthenticated,
  codex_cli_auth_external_authority,
}
import gunbc.readback_independence {
  ReadBackProbe,
  ProbeInert,
}
import gunbc.claim_evidence_probe_rule { infer_probe_evidence }

type ProviderReadinessClaim = Claim<ProviderInstance, ProviderInstance, ProviderReadiness, ProviderKind, RunKey>

type ProviderReadinessObservation
  = ProviderLoginStatusObserved {
      provider: ProviderInstance,
      bound: RunKey,
      readiness: ProviderReadiness,
      response: NonEmptyStr,
    }
  | ProviderLiveRequestObserved {
      provider: ProviderInstance,
      bound: RunKey,
      readiness: ProviderReadiness,
      response: NonEmptyStr,
    }

type ProviderReadinessEvidenceLink = EvidenceLink<ProviderReadinessObservation, ProviderReadinessClaim, ExternalAuthority, ProviderReadiness, ReadBackProbe>

type ProviderReadinessEvidenceInference = EvidenceInference<ProviderReadinessObservation, ProviderReadinessClaim, ExternalAuthority, ProviderReadiness, ReadBackProbe>

data provider_login_status_probe: ReadBackProbe = ReadBackProbe {
  label: "codex login status",
  subject: "credential material is recorded for one provider instance",
  effect_on_subject: ProbeInert,
}

data provider_live_request_probe: ReadBackProbe = ReadBackProbe {
  label: "one live provider model request",
  subject: "the provider accepts or refuses one request for this instance",
  effect_on_subject: ProbeInert,
}

fn provider_credential_recorded_claim(
  provider: ProviderInstance,
  bound: RunKey,
) -> ProviderReadinessClaim {
  Claim {
    id: "provider-credential-recorded",
    subject: provider,
    target: provider,
    proposition: ProviderCredentialsRecordedUnverified,
    scope: provider.kind,
    bound: bound,
  }
}

fn provider_ready_claim(
  provider: ProviderInstance,
  bound: RunKey,
) -> ProviderReadinessClaim {
  Claim {
    id: "provider-live-request-ready",
    subject: provider,
    target: provider,
    proposition: ProviderAuthenticated,
    scope: provider.kind,
    bound: bound,
  }
}

fn provider_observation_insufficient(
  fact: RecordedFact<ProviderReadinessObservation>,
  claim: ProviderReadinessClaim,
  inference_rule: InferenceRuleId,
  probe: ReadBackProbe,
  reason: NonEmptyStr,
) -> ProviderReadinessEvidenceInference {
  insufficient_evidence_inference(
    insufficiency: EvidenceInsufficiency {
      fact: fact,
      claim: claim,
      inference_rule: inference_rule,
      probe_independence: probe,
      reason: reason,
    },
  )
}

fn provider_login_status_support(
  fact: RecordedFact<ProviderReadinessObservation>,
  claim: ProviderReadinessClaim,
  readiness: ProviderReadiness,
) -> ProviderReadinessEvidenceInference {
  infer_probe_evidence(
    fact: fact,
    direction: EvidenceSupports,
    inference_rule: "provider-login-status-records-credential-only",
    authority: codex_cli_auth_external_authority,
    provenance: EvidenceProvenance {
      entity: "provider-login-status-output",
      activity: "provider-login-status-request",
      agent: "codex-cli",
    },
    freshness: EvidenceFreshness {
      maximum_conclusion: claim,
      basis: "captured inside the named provider attempt",
    },
    fidelity: EvidenceFidelity {
      boundary: readiness,
      losses: [
        "refresh acceptance is not exercised",
        "live model request capability is not exercised",
      ],
    },
    probe: provider_login_status_probe,
  )
}

fn provider_live_request_challenge(
  fact: RecordedFact<ProviderReadinessObservation>,
  claim: ProviderReadinessClaim,
  readiness: ProviderReadiness,
) -> ProviderReadinessEvidenceInference {
  infer_probe_evidence(
    fact: fact,
    direction: EvidenceChallenges,
    inference_rule: "provider-live-request-refresh-refusal",
    authority: codex_cli_auth_external_authority,
    provenance: EvidenceProvenance {
      entity: "provider-live-request-refusal",
      activity: "provider-model-request",
      agent: "codex-cli",
    },
    freshness: EvidenceFreshness {
      maximum_conclusion: claim,
      basis: "provider response belongs to the named request attempt",
    },
    fidelity: EvidenceFidelity {
      boundary: readiness,
      losses: [],
    },
    probe: provider_live_request_probe,
  )
}

fn provider_live_request_support(
  fact: RecordedFact<ProviderReadinessObservation>,
  claim: ProviderReadinessClaim,
  readiness: ProviderReadiness,
) -> ProviderReadinessEvidenceInference {
  infer_probe_evidence(
    fact: fact,
    direction: EvidenceSupports,
    inference_rule: "provider-live-request-succeeded",
    authority: codex_cli_auth_external_authority,
    provenance: EvidenceProvenance {
      entity: "provider-live-request-success",
      activity: "provider-model-request",
      agent: "codex-cli",
    },
    freshness: EvidenceFreshness {
      maximum_conclusion: claim,
      basis: "provider response belongs to the named request attempt",
    },
    fidelity: EvidenceFidelity {
      boundary: readiness,
      losses: [],
    },
    probe: provider_live_request_probe,
  )
}

fn provider_login_status_inference(
  observed_fact: RecordedFact<ProviderReadinessObservation>,
  provider: ProviderInstance,
  bound: RunKey,
) -> ProviderReadinessEvidenceInference {
  let claim = provider_credential_recorded_claim(
    provider: provider,
    bound: bound,
  )
  match observed_fact.value {
    ProviderLoginStatusObserved {
      provider: observed_provider,
      bound: observed_bound,
      readiness,
      response: _,
    } =>
      if (observed_provider == provider
        && observed_bound == bound
        && readiness == ProviderCredentialsRecordedUnverified) {
        provider_login_status_support(
          fact: observed_fact,
          claim: claim,
          readiness: readiness,
        )
      } else {
        provider_observation_insufficient(
          fact: observed_fact,
          claim: claim,
          inference_rule: "provider-login-status-records-credential-only",
          probe: provider_login_status_probe,
          reason: "login-status fact does not belong to this provider attempt or does not record credentials",
        )
      }
    ProviderLiveRequestObserved {
      provider: _,
      bound: _,
      readiness: _,
      response: _,
    } =>
      provider_observation_insufficient(
        fact: observed_fact,
        claim: claim,
        inference_rule: "provider-login-status-records-credential-only",
        probe: provider_login_status_probe,
        reason: "a live-request observation is not a login-status observation",
      )
  }
}

fn provider_live_request_failed_inference(
  observed_fact: RecordedFact<ProviderReadinessObservation>,
  provider: ProviderInstance,
  bound: RunKey,
) -> ProviderReadinessEvidenceInference {
  let claim = provider_ready_claim(provider: provider, bound: bound)
  match observed_fact.value {
    ProviderLiveRequestObserved {
      provider: observed_provider,
      bound: observed_bound,
      readiness,
      response: _,
    } =>
      match readiness {
        ProviderRefreshFailed { reason: _ } =>
          if observed_provider == provider && observed_bound == bound {
            provider_live_request_challenge(
              fact: observed_fact,
              claim: claim,
              readiness: readiness,
            )
          } else {
            provider_observation_insufficient(
              fact: observed_fact,
              claim: claim,
              inference_rule: "provider-live-request-refresh-refusal",
              probe: provider_live_request_probe,
              reason: "live-request refusal does not belong to this provider attempt",
            )
          }
        _ => provider_observation_insufficient(
          fact: observed_fact,
          claim: claim,
          inference_rule: "provider-live-request-refresh-refusal",
          probe: provider_live_request_probe,
          reason: "live-request fact is not a refresh refusal",
        )
      }
    ProviderLoginStatusObserved {
      provider: _,
      bound: _,
      readiness: _,
      response: _,
    } =>
      provider_observation_insufficient(
        fact: observed_fact,
        claim: claim,
        inference_rule: "provider-live-request-refresh-refusal",
        probe: provider_live_request_probe,
        reason: "login status cannot challenge live-request readiness",
      )
  }
}

fn provider_live_request_succeeded_inference(
  observed_fact: RecordedFact<ProviderReadinessObservation>,
  provider: ProviderInstance,
  bound: RunKey,
) -> ProviderReadinessEvidenceInference {
  let claim = provider_ready_claim(provider: provider, bound: bound)
  match observed_fact.value {
    ProviderLiveRequestObserved {
      provider: observed_provider,
      bound: observed_bound,
      readiness,
      response: _,
    } =>
      if (observed_provider == provider
        && observed_bound == bound
        && readiness == ProviderAuthenticated) {
        provider_live_request_support(
          fact: observed_fact,
          claim: claim,
          readiness: readiness,
        )
      } else {
        provider_observation_insufficient(
          fact: observed_fact,
          claim: claim,
          inference_rule: "provider-live-request-succeeded",
          probe: provider_live_request_probe,
          reason: "live-request fact does not belong to this provider attempt or did not authenticate",
        )
      }
    ProviderLoginStatusObserved {
      provider: _,
      bound: _,
      readiness: _,
      response: _,
    } =>
      provider_observation_insufficient(
        fact: observed_fact,
        claim: claim,
        inference_rule: "provider-live-request-succeeded",
        probe: provider_live_request_probe,
        reason: "login status cannot establish live-request success",
      )
  }
}
