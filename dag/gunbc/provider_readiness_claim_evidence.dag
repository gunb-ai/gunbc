module gunbc.provider_readiness_claim_evidence


type ProviderReadinessClaim = std.claim_evidence.Claim<extdeps.llm.cli_lifecycle.ProviderInstance, extdeps.llm.cli_lifecycle.ProviderInstance, extdeps.llm.cli_lifecycle.ProviderReadiness, extdeps.llm.cli_lifecycle.ProviderKind, std.types.RunKey>

type ProviderReadinessOperationResult
  = ProviderLoginCredentialRecorded { response: std.types.NonEmptyStr }
  | ProviderLoginCredentialAbsent { response: std.types.NonEmptyStr }
  | ProviderLoginStatusUnrecognized { response: std.types.NonEmptyStr }
  | ProviderLiveModelResponseReceived { response: std.types.NonEmptyStr }
  | ProviderLiveRefreshRefused { reason: std.types.NonEmptyStr }
  | ProviderLiveRequestRefused { reason: std.types.NonEmptyStr }

type ProviderReadinessObservation {
  provider: extdeps.llm.cli_lifecycle.ProviderInstance
  bound: std.types.RunKey
  result: ProviderReadinessOperationResult
}

type ProviderReadinessEvidenceLink = std.claim_evidence.EvidenceLink<ProviderReadinessObservation, ProviderReadinessClaim, extdeps.external_authority.ExternalAuthority, extdeps.llm.cli_lifecycle.ProviderReadiness, gunbc.readback_independence.ReadBackProbe>

type ProviderReadinessEvidenceInference = std.claim_evidence.EvidenceInference<ProviderReadinessObservation, ProviderReadinessClaim, extdeps.external_authority.ExternalAuthority, extdeps.llm.cli_lifecycle.ProviderReadiness, gunbc.readback_independence.ReadBackProbe>

data provider_login_status_probe: gunbc.readback_independence.ReadBackProbe = gunbc.readback_independence.ReadBackProbe {
  label: "codex login status",
  subject: "credential material is recorded for one provider instance",
  effect_on_subject: gunbc.readback_independence.ProbeInert,
}

data provider_live_request_probe: gunbc.readback_independence.ReadBackProbe = gunbc.readback_independence.ReadBackProbe {
  label: "one live provider model request",
  subject: "the provider accepts or refuses one request for this instance",
  effect_on_subject: gunbc.readback_independence.ProbeInert,
}

fn provider_credential_recorded_claim(
  provider: extdeps.llm.cli_lifecycle.ProviderInstance,
  bound: std.types.RunKey,
) -> ProviderReadinessClaim {
  std.claim_evidence.Claim {
    id: "provider-credential-recorded",
    subject: provider,
    target: provider,
    proposition: extdeps.llm.cli_lifecycle.ProviderCredentialsRecordedUnverified,
    scope: provider.kind,
    bound: bound,
  }
}

fn provider_ready_claim(
  provider: extdeps.llm.cli_lifecycle.ProviderInstance,
  bound: std.types.RunKey,
) -> ProviderReadinessClaim {
  std.claim_evidence.Claim {
    id: "provider-live-request-ready",
    subject: provider,
    target: provider,
    proposition: extdeps.llm.cli_lifecycle.ProviderAuthenticated,
    scope: provider.kind,
    bound: bound,
  }
}

fn provider_readiness_evidence_link(
  fact: std.claim_evidence.RecordedFact<ProviderReadinessObservation>,
  direction: std.claim_evidence.EvidenceDirection,
  inference_rule: std.claim_evidence.InferenceRuleId,
  authority: extdeps.external_authority.ExternalAuthority,
  provenance: std.claim_evidence.EvidenceProvenance,
  freshness: std.claim_evidence.EvidenceFreshness<ProviderReadinessClaim>,
  fidelity: std.claim_evidence.EvidenceFidelity<extdeps.llm.cli_lifecycle.ProviderReadiness>,
  probe: gunbc.readback_independence.ReadBackProbe,
) -> ProviderReadinessEvidenceLink {
  std.claim_evidence.EvidenceLink {
    fact: fact,
    direction: direction,
    inference_rule: inference_rule,
    authority: authority,
    provenance: provenance,
    freshness: freshness,
    fidelity: fidelity,
    probe_independence: probe,
  }
}

fn provider_observation_insufficient(
  fact: std.claim_evidence.RecordedFact<ProviderReadinessObservation>,
  claim: ProviderReadinessClaim,
  inference_rule: std.claim_evidence.InferenceRuleId,
  probe: gunbc.readback_independence.ReadBackProbe,
  reason: std.types.NonEmptyStr,
) -> ProviderReadinessEvidenceInference {
  std.claim_evidence.insufficient_evidence_inference(
    insufficiency: std.claim_evidence.EvidenceInsufficiency {
      fact: fact,
      claim: claim,
      inference_rule: inference_rule,
      probe_independence: probe,
      reason: reason,
    },
  )
}

fn provider_login_status_support(
  fact: std.claim_evidence.RecordedFact<ProviderReadinessObservation>,
  claim: ProviderReadinessClaim,
) -> ProviderReadinessEvidenceInference {
  gunbc.claim_evidence_probe_rule.infer_probe_evidence(
    fact: fact,
    direction: std.claim_evidence.EvidenceSupports,
    inference_rule: "provider-login-status-records-credential-only",
    authority: extdeps.llm.cli_lifecycle.codex_cli_auth_external_authority,
    provenance: std.claim_evidence.EvidenceProvenance {
      entity: "provider-login-status-output",
      activity: "provider-login-status-request",
      agent: "codex-cli",
    },
    freshness: std.claim_evidence.EvidenceFreshness {
      maximum_conclusion: claim,
      basis: "captured inside the named provider attempt",
    },
    fidelity: std.claim_evidence.EvidenceFidelity {
      boundary: extdeps.llm.cli_lifecycle.ProviderCredentialsRecordedUnverified,
      losses: [
        "refresh acceptance is not exercised",
        "live model request capability is not exercised",
      ],
    },
    probe: provider_login_status_probe,
  )
}

fn provider_live_request_challenge(
  fact: std.claim_evidence.RecordedFact<ProviderReadinessObservation>,
  claim: ProviderReadinessClaim,
  reason: std.types.NonEmptyStr,
) -> ProviderReadinessEvidenceInference {
  gunbc.claim_evidence_probe_rule.infer_probe_evidence(
    fact: fact,
    direction: std.claim_evidence.EvidenceChallenges,
    inference_rule: "provider-live-request-refresh-refusal",
    authority: extdeps.llm.cli_lifecycle.codex_cli_auth_external_authority,
    provenance: std.claim_evidence.EvidenceProvenance {
      entity: "provider-live-request-refusal",
      activity: "provider-model-request",
      agent: "codex-cli",
    },
    freshness: std.claim_evidence.EvidenceFreshness {
      maximum_conclusion: claim,
      basis: "provider response belongs to the named request attempt",
    },
    fidelity: std.claim_evidence.EvidenceFidelity {
      boundary: extdeps.llm.cli_lifecycle.ProviderRefreshFailed { reason: reason },
      losses: [],
    },
    probe: provider_live_request_probe,
  )
}

fn provider_live_request_support(
  fact: std.claim_evidence.RecordedFact<ProviderReadinessObservation>,
  claim: ProviderReadinessClaim,
) -> ProviderReadinessEvidenceInference {
  gunbc.claim_evidence_probe_rule.infer_probe_evidence(
    fact: fact,
    direction: std.claim_evidence.EvidenceSupports,
    inference_rule: "provider-live-request-succeeded",
    authority: extdeps.llm.cli_lifecycle.codex_cli_auth_external_authority,
    provenance: std.claim_evidence.EvidenceProvenance {
      entity: "provider-live-request-success",
      activity: "provider-model-request",
      agent: "codex-cli",
    },
    freshness: std.claim_evidence.EvidenceFreshness {
      maximum_conclusion: claim,
      basis: "provider response belongs to the named request attempt",
    },
    fidelity: std.claim_evidence.EvidenceFidelity {
      boundary: extdeps.llm.cli_lifecycle.ProviderAuthenticated,
      losses: [],
    },
    probe: provider_live_request_probe,
  )
}

fn provider_login_status_inference(
  observed_fact: std.claim_evidence.RecordedFact<ProviderReadinessObservation>,
  provider: extdeps.llm.cli_lifecycle.ProviderInstance,
  bound: std.types.RunKey,
) -> ProviderReadinessEvidenceInference {
  let claim = provider_credential_recorded_claim(
    provider: provider,
    bound: bound,
  )
  let observation = observed_fact.value
  match observation.result {
    ProviderLoginCredentialRecorded { response: _ } =>
      if (observation.provider == provider
        && observation.bound == bound) {
        provider_login_status_support(
          fact: observed_fact,
          claim: claim,
        )
      } else {
        provider_observation_insufficient(
          fact: observed_fact,
          claim: claim,
          inference_rule: "provider-login-status-records-credential-only",
          probe: provider_login_status_probe,
          reason: "login-status fact does not belong to this provider attempt or does not record credentials",
        )
      }
    ProviderLoginCredentialAbsent { response: _ } =>
      provider_observation_insufficient(
        fact: observed_fact,
        claim: claim,
        inference_rule: "provider-login-status-records-credential-only",
        probe: provider_login_status_probe,
        reason: "login-status operation did not report recorded credentials",
      )
    ProviderLoginStatusUnrecognized { response: _ } =>
      provider_observation_insufficient(
        fact: observed_fact,
        claim: claim,
        inference_rule: "provider-login-status-records-credential-only",
        probe: provider_login_status_probe,
        reason: "login-status operation result was not classified",
      )
    _ =>
      provider_observation_insufficient(
        fact: observed_fact,
        claim: claim,
        inference_rule: "provider-login-status-records-credential-only",
        probe: provider_login_status_probe,
        reason: "a live-request observation is not a login-status observation",
      )
  }
}

fn provider_live_request_failed_inference(
  observed_fact: std.claim_evidence.RecordedFact<ProviderReadinessObservation>,
  provider: extdeps.llm.cli_lifecycle.ProviderInstance,
  bound: std.types.RunKey,
) -> ProviderReadinessEvidenceInference {
  let claim = provider_ready_claim(provider: provider, bound: bound)
  let observation = observed_fact.value
  match observation.result {
    ProviderLiveRefreshRefused { reason } =>
      if observation.provider == provider && observation.bound == bound {
        provider_live_request_challenge(
          fact: observed_fact,
          claim: claim,
          reason: reason,
        )
      } else {
        provider_observation_insufficient(
          fact: observed_fact,
          claim: claim,
          inference_rule: "provider-live-request-refresh-refusal",
          probe: provider_live_request_probe,
          reason: "live-request refusal does not belong to this provider attempt",
        )
      }
    _ =>
      provider_observation_insufficient(
        fact: observed_fact,
        claim: claim,
        inference_rule: "provider-live-request-refresh-refusal",
        probe: provider_live_request_probe,
        reason: "operation result is not a live refresh refusal",
      )
  }
}

fn provider_live_request_succeeded_inference(
  observed_fact: std.claim_evidence.RecordedFact<ProviderReadinessObservation>,
  provider: extdeps.llm.cli_lifecycle.ProviderInstance,
  bound: std.types.RunKey,
) -> ProviderReadinessEvidenceInference {
  let claim = provider_ready_claim(provider: provider, bound: bound)
  let observation = observed_fact.value
  match observation.result {
    ProviderLiveModelResponseReceived { response: _ } =>
      if (observation.provider == provider
        && observation.bound == bound) {
        provider_live_request_support(
          fact: observed_fact,
          claim: claim,
        )
      } else {
        provider_observation_insufficient(
          fact: observed_fact,
          claim: claim,
          inference_rule: "provider-live-request-succeeded",
          probe: provider_live_request_probe,
          reason: "live-request fact does not belong to this provider attempt or did not authenticate",
        )
      }
    _ =>
      provider_observation_insufficient(
        fact: observed_fact,
        claim: claim,
        inference_rule: "provider-live-request-succeeded",
        probe: provider_live_request_probe,
        reason: "operation result is not a live model response",
      )
  }
}

fn provider_readiness_fact_claim(
  fact: std.claim_evidence.RecordedFact<ProviderReadinessObservation>,
  claim: ProviderReadinessClaim,
) -> Bool {
  fact.value.provider == claim.subject
    && fact.value.provider == claim.target
    && fact.value.provider.kind == claim.scope
    && fact.value.bound == claim.bound
}

fn provider_readiness_rule_claim(
  rule: std.claim_evidence.InferenceRuleId,
  claim: ProviderReadinessClaim,
) -> Bool {
  (rule == "provider-login-status-records-credential-only"
      && claim.proposition == extdeps.llm.cli_lifecycle.ProviderCredentialsRecordedUnverified)
    || ((rule == "provider-live-request-refresh-refusal"
        || rule == "provider-live-request-succeeded")
      && claim.proposition == extdeps.llm.cli_lifecycle.ProviderAuthenticated)
}

fn provider_readiness_authority_claim(
  authority: extdeps.external_authority.ExternalAuthority,
  _: ProviderReadinessClaim,
) -> Bool {
  authority == extdeps.llm.cli_lifecycle.codex_cli_auth_external_authority
}

fn provider_readiness_provenance_claim(
  provenance: std.claim_evidence.EvidenceProvenance,
  _: ProviderReadinessClaim,
) -> Bool {
  provenance.agent == "codex-cli"
    && (
      (provenance.entity == "provider-login-status-output"
        && provenance.activity == "provider-login-status-request")
      || (provenance.entity == "provider-live-request-refusal"
        && provenance.activity == "provider-model-request")
      || (provenance.entity == "provider-live-request-success"
        && provenance.activity == "provider-model-request")
    )
}

fn provider_readiness_freshness_claim(
  freshness: std.claim_evidence.EvidenceFreshness<ProviderReadinessClaim>,
  claim: ProviderReadinessClaim,
) -> Bool {
  freshness.maximum_conclusion == claim
}

fn provider_readiness_fidelity_claim(
  fidelity: std.claim_evidence.EvidenceFidelity<extdeps.llm.cli_lifecycle.ProviderReadiness>,
  _: ProviderReadinessClaim,
) -> Bool {
  match fidelity.boundary {
    extdeps.llm.cli_lifecycle.ProviderCredentialsRecordedUnverified => fidelity.losses.length() == 2
    extdeps.llm.cli_lifecycle.ProviderAuthenticated => fidelity.losses.length() == 0
    extdeps.llm.cli_lifecycle.ProviderRefreshFailed { reason: _ } => fidelity.losses.length() == 0
    _ => false
  }
}

fn provider_readiness_independence_claim(
  probe: gunbc.readback_independence.ReadBackProbe,
  _: ProviderReadinessClaim,
  _: std.claim_evidence.EvidenceDirection,
) -> Bool {
  gunbc.readback_independence.readback_probe_is_independent(p: probe)
}

fn provider_readiness_link_relation(
  link: ProviderReadinessEvidenceLink,
  claim: ProviderReadinessClaim,
) -> Bool {
  let supports = std.claim_evidence.evidence_direction_fold(
    direction: link.direction,
    fold: std.claim_evidence.EvidenceDirectionFold {
      supports: true,
      challenges: false,
    },
  )
  match link.fact.value.result {
    ProviderLoginCredentialRecorded { response: _ } =>
      supports
        && link.inference_rule == "provider-login-status-records-credential-only"
        && claim == provider_credential_recorded_claim(
          provider: link.fact.value.provider,
          bound: link.fact.value.bound,
        )
        && link.fidelity.boundary == extdeps.llm.cli_lifecycle.ProviderCredentialsRecordedUnverified
    ProviderLiveRefreshRefused { reason } =>
      !supports
        && link.inference_rule == "provider-live-request-refresh-refusal"
        && claim == provider_ready_claim(
          provider: link.fact.value.provider,
          bound: link.fact.value.bound,
        )
        && link.fidelity.boundary == extdeps.llm.cli_lifecycle.ProviderRefreshFailed { reason: reason }
    ProviderLiveModelResponseReceived { response: _ } =>
      supports
        && link.inference_rule == "provider-live-request-succeeded"
        && claim == provider_ready_claim(
          provider: link.fact.value.provider,
          bound: link.fact.value.bound,
        )
        && link.fidelity.boundary == extdeps.llm.cli_lifecycle.ProviderAuthenticated
    _ => false
  }
}

fn provider_readiness_evidence_admission_policy(
) -> std.claim_evidence.EvidenceAdmissionPolicy<ProviderReadinessObservation, ProviderReadinessClaim, extdeps.external_authority.ExternalAuthority, extdeps.llm.cli_lifecycle.ProviderReadiness, gunbc.readback_independence.ReadBackProbe> {
  std.claim_evidence.EvidenceAdmissionPolicy {
    fact_claim: provider_readiness_fact_claim,
    inference_rule_claim: provider_readiness_rule_claim,
    authority_claim: provider_readiness_authority_claim,
    provenance_claim: provider_readiness_provenance_claim,
    freshness_claim: provider_readiness_freshness_claim,
    fidelity_claim: provider_readiness_fidelity_claim,
    independence_claim: provider_readiness_independence_claim,
    relation: provider_readiness_link_relation,
  }
}
