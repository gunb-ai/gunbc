// THE HOME OF A PERFORMED GitHubEffect. extdeps.github.effect is the effect SHAPE; the services in
// extdeps.github.* are REST realizations bound to it (gunbc#10923); this module is the workflow
// layer that PERFORMS one -- it sequences the realizations, holds the credentials between them, and
// hands back a typed performance. Policy about WHICH effect to perform stays with its caller (DESIGN
// §3: interface, realization and policy are three facts). Its first effect is the organization JIT
// mint, whose dispatch gunbc.runner.runner_jit_perform already decides; a second effect lands here
// as a second perform function, not as a second module.
//
// THE MINT IS THE TWO-STEP APP PATH gunbc.runner.runner_jit_admission names, all on the HOST:
//   1. sign an App JWT (extdeps.auth.jws over extdeps.github.org_admin_auth's claims) with the App
//      key, realized by openssl reading a key FILE the controller alone can read;
//   2. POST /app/installations/{id}/access_tokens with that JWT for an installation token;
//   3. POST /orgs/{org}/actions/runners/generate-jitconfig with that token.
// The JWT and the token are Secrets that live only inside this call. Neither is returned, written,
// or rendered into an argv, and the key never leaves the file openssl reads -- so nothing this
// function produces is a path from a guest to the App key.

// §3c, STATED SO A GREEN WITNESS IS NOT READ AS A WORKING MINT. perform_organization_jit_mint is
// the realization gunbc.runner.runner_jit_perform's old transport frontier asked for, and it is
// consumed by NO production route in this change: the caller is the per-attempt lifecycle controller
// (gunbc.runner_microvm VmmUnderLifecycleController), which is another lane's to land, and the floor
// job does not select the microVM path. Its witnesses supply RestOutcomes and establish the
// decision, never that GitHub has minted through it. The same holds for
// gunbc.runner_attempt_launch stage_bootstrap_device. The trigger is the CAPABILITY, not an import.
data jit_mint_lifecycle_controller_consumer_frontier: DissolutionCondition = unbound_dissolution(description: "NAMED CONSUMER: the per-attempt lifecycle controller (gunbc.runner_microvm VmmUnderLifecycleController) calling gunbc.github_effect_perform perform_organization_jit_mint and gunbc.runner_attempt_launch stage_bootstrap_device on a host. TRIGGER: one attempt on srv1 mints through it with the controller-custodied App key, stages exactly one device, and a runner registers under the attempt's unit name, with a receipt. SUFFICIENT FOR deleting this row. NOT satisfied by a witness over supplied RestOutcomes, nor by an import of these functions." as NonEmptyStr)

// THE KEY THE MINT SIGNS WITH IS ONE MODELED PATH, NOT A CALLER PARAMETER. It is deliberately NOT
// gunbc.runner_unit_file runner_host_app_pem_path: that file is owned by the runner user, which is
// the principal whose processes run jobs today. The lifecycle controller's copy is root-owned and
// readable by the controller alone, outside every jail root (gunbc.runner_microvm_attempt roots all
// attempt storage under the fabric cell's attempt root, and /etc is not under it). Its delivery and
// ownership readback are a converge entry, not this module; until that entry lands the path names a
// file no converge has produced, and perform refuses at the signer (openssl cannot open it) rather
// than falling back to the runner-owned key.
data lifecycle_controller_app_key: JwsSigningKeyRef = HostKeyFile {
  path: "/etc/gunbc/microvm-controller/app.pem",
}

// THE KEY IS ONE APP'S. The JWT's iss comes from the dispatch's App and the signature from this key,
// so they must name the same App; a dispatch for any other App is refused BEFORE signing, as its own
// arm, rather than reaching GitHub as a JWT signed by the wrong key and coming back a 401.
data lifecycle_controller_app: DeclaredGitHubApp = gunbai_ci_declared

type JitMintStep
  = InstallationAccessTokenStep
  | GenerateJitConfigStep

// EVERY NON-DELIVERY IS ITS OWN ARM. In particular a generate-jitconfig whose response never
// arrived is RestExchangeCommitAmbiguous, NOT a refusal: GitHub may have created the registration,
// and calling that a refusal would assert a fact nobody observed. That classification is correct
// and is the part worth keeping.
//
// WHAT THE ARM DOES NOT CARRY, corrected from an earlier claim here: JitMintStepNotSucceeded holds
// only the step and the performance. It DROPS the attempt, the JIT runner name, the dispatch and
// the organization, so it does not give an operator what reconciling a possibly-created
// registration needs, and the earlier sentence promising reconciliation BY RUNNER NAME was not
// backed by the value.
//
// No live orphan can result while no PRODUCTION route consumes this function.
// Before such a consumer lands, this arm must retain a reconciliation subject:
// preferably the authorized dispatch, or an equivalent sealed carrier containing
// at least the attempt, the organization, and the runner name derived from that
// attempt.
type JitMintPerformance
  = JitMintReceived { delivery: JitCredentialDelivery }
  | JitMintAppKeyNotCustodied { app: DeclaredGitHubApp }
  | JitMintClockUnread { detail: String }
  | JitMintAppJwtUnsigned { detail: String }
  | JitMintStepNotSucceeded { step: JitMintStep, performance: RestExchangePerformance }
  | JitMintTokenForAnotherInstallation { app: DeclaredGitHubApp, installation: GitHubAppInstallationId }

fn app_jwt_for(dispatch_app_id: Int, key: JwsSigningKeyRef, now_epoch_secs: EpochSecs) -> JitMintAppJwt {
  match jws_rs256_signing_input(
    payload_json: github_app_jwt_claims_json(app_id: dispatch_app_id, now_epoch_secs: now_epoch_secs),
  ) {
    JwsEncodeNotOctets { observed: o } =>
      AppJwtUnsigned { detail: concat("the signing input carried a member outside octet range: ", to_string(o)) }
    JwsEncoded { text: jws_signing_text } => {
      let signing_input = jws_signing_text as NonEmptyStr
      match jws_rs256_sign(signing_input: signing_input, key: key) {
        JwsSignRefused { detail: d } => AppJwtUnsigned { detail: d }
        JwsSigned { signature: sig } =>
          match jws_compact_serialization(signing_input: signing_input, signature: sig) {
            JwsSignatureNotOctets { observed: o } =>
              AppJwtUnsigned { detail: concat("the signer returned a member outside octet range: ", to_string(o)) }
            JwsSerialized { jwt: jwt } => AppJwtSigned { jwt: jwt }
          }
      }
    }
  }
}

type JitMintAppJwt
  = AppJwtSigned { jwt: JwtCompactSerialization }
  | AppJwtUnsigned { detail: String }

// THE GENERATE STEP'S ANSWER, DECIDED WITHOUT I/O so the decision is witnessable on supplied
// RestOutcomes (DESIGN §3: a witness discriminates at one interface). A 2xx decodes through the
// same jit_config_mint_outcome every status goes through, so an empty blob under 201 is still
// refused there; a non-2xx the remote DECIDED is a JitConfigMintOutcome refusal; an answer that
// never arrived is commit-ambiguous and is NOT reported as a refusal.
fn jit_mint_performance_of_generate(
  dispatch: JitMintDispatch,
  outcome: RestOutcome,
  created: JitConfigCreatedBody,
) -> JitMintPerformance {
  match classify_rest_outcome(standing: RestMutationExchange { rest: outcome }) {
    RestExchangeSucceeded =>
      JitMintReceived {
        delivery: receive_jit_mint(
          dispatch: dispatch,
          outcome: jit_config_mint_outcome(
            status: jit_config_created_status,
            encoded: created.encoded_jit_config,
            runner_id: created.runner.id,
            error_body: "",
          ),
        ),
      }
    RestExchangeStatusRefused { status: s, body: b } =>
      JitMintReceived {
        delivery: receive_jit_mint(
          dispatch: dispatch,
          outcome: jit_config_mint_outcome(status: s, encoded: "", runner_id: 0, error_body: b),
        ),
      }
    other => JitMintStepNotSucceeded { step: GenerateJitConfigStep, performance: other }
  }
}

// THE INSTALLATION TOKEN IS MINTED ONCE PER ATTEMPT, BEFORE THE MINT IS PLANNED, because the plan
// needs a reading only that token can make: the controller reads the organization's runner groups
// with it (gunbc.runner_microvm_slot_controller mint_attempt_credential) and hands the observed
// standing to gunbc.runner_jit_mint plan_jit_mint, and the same token then performs the generate.
// One credential, one mint; reading with a second token would pay the App JWT and the exchange
// twice for one attempt.
//
// The token is a sole_constructor carrier that names the App and installation it was minted for, so
// the generate step can refuse a dispatch for any other installation rather than present a token
// GitHub would answer with a 401. The App JWT stays JwtCompactSerialization until the exchange,
// whose Bearer input is a Secret; that call is the single place the brand is shed.
type ControllerInstallationToken sole_constructor {
  app: DeclaredGitHubApp
  installation: GitHubAppInstallationId
  token: Secret
}

type ControllerTokenMint
  = ControllerTokenMinted { token: ControllerInstallationToken }
  | ControllerTokenNotMinted { performance: JitMintPerformance }

fn mint_controller_installation_token(installation: GitHubAppInstallationId) -> ControllerTokenMint uses net: Network {
  match clock_unix_millis_read() {
    ClockUnixMillisRefused { detail: d } => ControllerTokenNotMinted { performance: JitMintClockUnread { detail: d } }
    ClockUnixMillisObserved { millis: ms } =>
      match app_jwt_for(dispatch_app_id: lifecycle_controller_app.app_id.value, key: lifecycle_controller_app_key, now_epoch_secs: epoch_secs_of_millis(millis: ms)) {
        AppJwtUnsigned { detail: d } => ControllerTokenNotMinted { performance: JitMintAppJwtUnsigned { detail: d } }
        AppJwtSigned { jwt: jwt } => {
          let token = github.AppInstallationAccessTokens.Create(
            app_jwt: jwt as Secret,
            installation_id: installation.value,
          )
          match classify_rest_outcome(standing: RestMutationExchange { rest: token.outcome }) {
            RestExchangeSucceeded => ControllerTokenMinted { token: ControllerInstallationToken {
              app: lifecycle_controller_app,
              installation: installation,
              token: token.token,
            } }
            other => ControllerTokenNotMinted { performance: JitMintStepNotSucceeded { step: InstallationAccessTokenStep, performance: other } }
          }
        }
      }
  }
}

// WHAT A DISPATCH ANSWERS BEFORE ANY TOKEN IS PRESENTED, decided without I/O and decided ONCE: a
// refused plan comes back as its refusal, an authorized dispatch for an App whose key this
// controller does not custody is refused as its own arm, and only the remaining case carries what
// the generate step needs. perform_organization_jit_mint matches on this and nothing else, so it
// has no second copy of these arms and no unreachable one (review 70883).
type JitMintGenerateGate
  = JitMintDecidedBeforeGenerate { performance: JitMintPerformance }
  | JitMintProceedsToGenerate {
      app: DeclaredGitHubApp
      installation: GitHubAppInstallationId
      organization: GitHubOrganizationRef
      request: JitRunnerConfigRequest
    }

fn jit_mint_generate_gate(dispatch: JitMintDispatch) -> JitMintGenerateGate {
  match dispatch {
    JitMintDispatchRefused { refusal: r } =>
      JitMintDecidedBeforeGenerate { performance: JitMintReceived { delivery: JitCredentialNotDispatched { refusal: r } } }
    JitMintDispatchAuthorized { dispatch: d } =>
      if d.app != lifecycle_controller_app {
        JitMintDecidedBeforeGenerate { performance: JitMintAppKeyNotCustodied { app: d.app } }
      } else {
        JitMintProceedsToGenerate { app: d.app, installation: d.installation, organization: d.organization, request: d.request }
      }
  }
}

fn perform_organization_jit_mint(dispatch: JitMintDispatch, token: ControllerInstallationToken) -> JitMintPerformance uses net: Network {
  match jit_mint_generate_gate(dispatch: dispatch) {
    JitMintDecidedBeforeGenerate { performance: p } => p
    JitMintProceedsToGenerate { app: app, installation: installation, organization: organization, request: request } =>
      if app != token.app || installation != token.installation {
        JitMintTokenForAnotherInstallation { app: token.app, installation: token.installation }
      } else {
        let minted = github.ActionsJitRunners.GenerateOrganizationJitConfig(
          installation_token: token.token,
          org: organization.login,
          name: request.name.value,
          runner_group_id: request.runner_group_id.value,
          labels: map(request.labels, l => jit_runner_label_wire(l: l)),
          work_folder: request.work_folder.value,
        )
        jit_mint_performance_of_generate(
          dispatch: dispatch,
          outcome: minted.outcome,
          created: minted.result,
        )
      }
  }
}

// THE CONTROLLER'S READ OF THE ORGANIZATION'S RUNNER GROUPS is the one read every consumer shares
// (gunbc.fleet.org_actions_inspection read_runner_groups), under the same installation token the
// generate step will use.
fn read_runner_groups_with(token: ControllerInstallationToken, organization: NonEmptyStr) -> RunnerGroupListDecode uses net: Network {
  read_runner_groups(token: token.token, organization: organization)
}

// THE DEREGISTRATION'S TWO EXCHANGES, under the same controller installation token that minted the
// registration (gunbc.runner.runner_jit_deregistration ensure_jit_runner_deregistered). The token's
// Secret is shed here and nowhere else, as for the mint; the answers are classified at their own
// grain -- the listing a read, the delete a mutation -- and the decision over them is the
// deregistration module's, taken without I/O.
// SEALED, AND IT CARRIES ITS QUERY SUBJECT: the organization and runner name it asked about and the
// App and installation of the token it asked with. A listing is evidence only about what it was
// asked -- an empty answer for another name proves nothing about this one -- so the deregistration
// receipt path compares this subject to its registration before reading the answer
// (gunbc.runner.runner_jit_deregistration readback_subject_refusal).
type OrganizationRunnerListRead sole_constructor {
  organization: NonEmptyStr
  name: NonEmptyStr
  app: DeclaredGitHubApp
  installation: GitHubAppInstallationId
  performance: RestExchangePerformance
  body: OrganizationRunnerListWire
}

fn list_runners_by_name_with(token: ControllerInstallationToken, organization: NonEmptyStr, name: NonEmptyStr) -> OrganizationRunnerListRead
  uses net: Network
{
  let listed = github.ActionsSelfHostedRunners.ListOrganizationRunnersByName(installation_token: token.token, org: organization, name: name)
  OrganizationRunnerListRead {
    organization: organization,
    name: name,
    app: token.app,
    installation: token.installation,
    performance: classify_rest_outcome(standing: RestReadExchange { rest: listed.outcome }), body: listed.result }
}

fn delete_runner_with(token: ControllerInstallationToken, organization: NonEmptyStr, runner_id: Int) -> RestExchangePerformance
  uses net: Network
{
  let deleted = github.ActionsSelfHostedRunners.DeleteOrganizationRunner(installation_token: token.token, org: organization, runner_id: runner_id)
  classify_rest_outcome(standing: RestMutationExchange { rest: deleted.outcome })
}

// THE QUALIFICATION DISPATCH AND ITS READBACK, under the same controller installation token
// (gunbc.runner.runner_qualification_dispatch). The dispatch is a mutation and is classified as one,
// so a 5xx, a lost response or an undecodable 200 is commit-ambiguous rather than refused; the two
// reads are reads. Each answer is sealed so the decision module receives only what GitHub returned.
type WorkflowDispatchAnswer sole_constructor {
  performance: RestExchangePerformance
  receipt: WorkflowDispatchReceipt
}

fn dispatch_workflow_with(
  token: ControllerInstallationToken,
  owner: NonEmptyStr,
  repo: NonEmptyStr,
  workflow_id: NonEmptyStr,
  git_ref: NonEmptyStr,
  inputs: Map<String, String>,
) -> WorkflowDispatchAnswer uses net: Network {
  let answered = github.Workflows.CreateDispatch(
    auth_token: token.token,
    owner: owner as String,
    repo: repo as String,
    workflow_id: workflow_id as String,
    ref: git_ref as String,
    inputs: inputs,
  )
  WorkflowDispatchAnswer {
    performance: classify_rest_outcome(standing: RestMutationExchange { rest: answered.outcome }),
    receipt: WorkflowDispatchReceipt { workflow_run_id: answered.workflow_run_id, run_url: answered.run_url, html_url: answered.html_url },
  }
}

type WorkflowRunRead sole_constructor {
  performance: RestExchangePerformance
  run: WorkflowRun
}

fn read_run_with(token: ControllerInstallationToken, owner: NonEmptyStr, repo: NonEmptyStr, run_id: Int) -> WorkflowRunRead uses net: Network {
  let read = github.WorkflowRuns.GetRun(auth_token: token.token, owner: owner as String, repo: repo as String, run_id: run_id as String)
  WorkflowRunRead { performance: classify_rest_outcome(standing: RestReadExchange { rest: read.outcome }), run: read.run }
}

type WorkflowAttemptJobsRead sole_constructor {
  performance: RestExchangePerformance
  jobs: WorkflowJobRunList
}

fn read_attempt_jobs_with(token: ControllerInstallationToken, owner: NonEmptyStr, repo: NonEmptyStr, run_id: Int, attempt: Int) -> WorkflowAttemptJobsRead uses net: Network {
  let read = github.WorkflowRuns.ListAttemptJobs(auth_token: token.token, owner: owner as String, repo: repo as String, run_id: run_id as String, attempt_number: attempt)
  WorkflowAttemptJobsRead { performance: classify_rest_outcome(standing: RestReadExchange { rest: read.outcome }), jobs: read.result }
}

// THE QUALIFICATION RUN'S OUTPUTS, READ UNDER THE SAME CONTROLLER TOKEN AS THE RUN ITSELF. One job's
// log (actions/download-job-logs-for-workflow-run, followed through its redirect by the bound REST
// handler), the run's artifact listing, and one artifact's archive. Each answer is sealed beside its
// classified performance, like the run and job reads above, so a consumer cannot pair a body with a
// performance it did not come with. The archive is Bytes and today's handler reads bodies as text,
// so a real download answers RestExchangeUndecodable (extdeps.github.actions_artifacts).
type WorkflowJobLogRead sole_constructor {
  performance: RestExchangePerformance
  job_id: Int
  log: String
}

fn read_job_log_with(token: ControllerInstallationToken, owner: NonEmptyStr, repo: NonEmptyStr, job_id: Int) -> WorkflowJobLogRead uses net: Network {
  let read = github.WorkflowRuns.DownloadJobLogsForWorkflowRun(auth_token: token.token, owner: owner as String, repo: repo as String, job_id: job_id as String)
  WorkflowJobLogRead { performance: classify_rest_outcome(standing: RestReadExchange { rest: read.outcome }), job_id: job_id, log: read.log }
}

type WorkflowRunArtifactsRead sole_constructor {
  performance: RestExchangePerformance
  listed: ActionsArtifactList
}

fn list_run_artifacts_with(token: ControllerInstallationToken, owner: NonEmptyStr, repo: NonEmptyStr, run_id: Int) -> WorkflowRunArtifactsRead uses net: Network {
  let read = github.Artifacts.ListWorkflowRunArtifacts(auth_token: token.token, owner: owner as String, repo: repo as String, run_id: run_id as String)
  WorkflowRunArtifactsRead { performance: classify_rest_outcome(standing: RestReadExchange { rest: read.outcome }), listed: read.result }
}

type ArtifactArchiveRead sole_constructor {
  performance: RestExchangePerformance
  artifact_id: Int
}

fn download_artifact_with(token: ControllerInstallationToken, owner: NonEmptyStr, repo: NonEmptyStr, artifact_id: Int) -> ArtifactArchiveRead uses net: Network {
  let read = github.Artifacts.DownloadArtifact(auth_token: token.token, owner: owner as String, repo: repo as String, artifact_id: artifact_id as String)
  ArtifactArchiveRead { performance: classify_rest_outcome(standing: RestReadExchange { rest: read.outcome }), artifact_id: artifact_id }
}
