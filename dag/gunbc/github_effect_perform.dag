module gunbc.github_effect_perform

import std.types { NonEmptyStr, Secret, HttpStatus }
import std.resources { Network }
import std.dissolution { DissolutionCondition, unbound_dissolution }
import extdeps.transports.rest {
  classify_rest_outcome,
  RestExchangeSucceeded, RestExchangeUndecodable, RestExchangePerformance,
}
import extdeps.github.users
import extdeps.github.github { GitHubUser }

// RUNG, HONEST. Classification of a RestOutcome is mechanically preventable on the required
// hermetic path via classify_rest_outcome. perform_github_authenticated_user_read is also
// reachable hermetically: the GetAuthenticatedUser mock publishes the decoded-200 shape whose
// login is the fixture identity, not a live GitHub account. That green is not a live 401. Live
// GET /user is not executed in this change. The next-rung trigger is a required-lane route that
// may perform network effects against a real credential. JIT mint and R2 mint are not callers in
// this change. This is not structural: an invalid RestOutcome is still writable.

// DECLARED FRONTIER (§3c). perform_github_authenticated_user_read has no production caller in
// this change; the hermetic witness is not a consumer. classify_rest_outcome is consumed by
// create_secret_for_attempt, add_initial_version, and delete_observed_secret. NAMED CONSUMER for
// the read perform: a production func that calls it. TRIGGER: that import and call exist outside
// test.claim. SUFFICIENT FOR deleting this row. NOT satisfied by another witness.
data github_effect_perform_consumer_frontier: DissolutionCondition = unbound_dissolution(description: "NAMED CONSUMER: a production func that calls perform_github_authenticated_user_read. TRIGGER: that import and call exist outside test.claim. SUFFICIENT FOR deleting this row. NOT satisfied by another witness importing it." as NonEmptyStr)

type GitHubAuthenticatedUserRead
  = GitHubAuthenticatedUserObserved { user: GitHubUser }
  | GitHubAuthenticatedUserRefused { performance: RestExchangePerformance }

func perform_github_authenticated_user_read(auth_token: Secret) -> GitHubAuthenticatedUserRead uses net: Network {
  let got = github.Users.GetAuthenticatedUser(auth_token: auth_token)
  match classify_rest_outcome(rest: got.outcome, mutation: false) {
    RestExchangeSucceeded =>
      if got.user.login == "" {
        GitHubAuthenticatedUserRefused {
          performance: RestExchangeUndecodable {
            status: 200,
            cause: "GitHub answered 200 with an empty login; no authenticated user was observed" as NonEmptyStr,
          }
        }
      } else {
        GitHubAuthenticatedUserObserved { user: got.user }
      }
    other => GitHubAuthenticatedUserRefused { performance: other }
  }
}
