module gunbc.ci_fleet_host_quarantine

import extdeps.github.actions { RunnerSpec, SelfHosted }
import product.placement_supply { HostIdentity }
import gunbc.fleet_intent_network { operator_host_srv1 }

data ci_fleet_admission_label: String = "ci-fleet-admit"

data ci_fleet_quarantined_hosts: List<HostIdentity> = [operator_host_srv1]

data ci_fleet_host_quarantine_note: String = "Fleet CI host quarantine (Lane E, 2026-08-06): GitHub Actions runner matching is positive-only — a job cannot express 'not srv1'. When ci_fleet_quarantined_hosts is non-empty, gunbc_ci_selected_runner_spec appends ci_fleet_admission_label so only runners carrying that label admit generic CI work. OPERATOR ACTION REQUIRED ON MERGE: ensure srv2/srv3/srv4 fleet runners carry ci-fleet-admit; ensure srv1 fleet runners do NOT carry it (or disable them). Deploy stages stay srv1-pinned via gunbc_ci_deploy_srv1_runner_spec and are unaffected. DISSOLVE-ON: srv1 build-cache placement converges (gunbc.host_build_cache_provision provision_build_cache_widen_sketch_note — stranded sccache server pid 3975946 in retired slot srv1-10 cgroup repaired), srv1 removed from this list, admission label drops from the CI projection."

data ci_fleet_srv1_noncompletion_root_cause_note: String = "ROOT CAUSE RECEIPT — srv1 CI non-completions and capacity absorption (Lane E, revised 2026-08-06). SYMPTOM CLASS: cold-compile wall exceeds the modeled envelope — cargo check -p v1-compiler-tests --tests killed at the 15m step ceiling (gunbc_ci_v1_compiler_tests_compile_gate_timeout_minutes) while still compiling v1-compiler. HARM MEASURE (corrected): count long-duration cancelled jobs as absorption, not only conclusion=failure — a 14m cancelled build costs the same slot-hours as a 15m killed build; the label differs, absorbed capacity does not. EXECUTED EVIDENCE (failure): run 31060400858 on main (runner srv1-05, killed at 15m mid-Compiling v1-compiler); run 31060543168 on session/snappy-otter-650 (runner srv1-01, same). EXECUTED EVIDENCE (absorption): srv1-02 build cancelled at 14m (still-bat-561 sample, last 40 repo runs). SLOT DISCRIMINANT (revised): srv1 is NOT uniformly broken — the failure is a property of the cold-compile path on the host, not the host label alone. still-bat-561 measured srv1-04 build success in 1m and srv1-03 regen success in the same window srv1-01/05 failed at 15m; warm-cache fleet runs complete the compile gate in ~50s–1m (gunbc_ci_v1_compiler_tests_compile_gate_timeout_note). MECHANISM: host-scoped — one CI sccache endpoint per host; cache-miss compiles are children of the server process. srv1's server is stranded in retired slot srv1-10's cgroup (provision_build_cache_widen_sketch_note: pid 3975946, 31+ days, memory.max breaches and oom_kills); live slots 01–05 still route through it on cache miss. Quarantine as modeled is host-scoped and over-applies if warm slots are kept productive; slot-scoped admission is expressible via per-runner labels but does not isolate the shared cold path. Raising the timeout alone (session/lively-crab-41-pr2, not merged) treats the symptom, not the stranded-server cause."

fn ci_fleet_admission_runner_spec(base: RunnerSpec) -> RunnerSpec {
  if ci_fleet_quarantined_hosts.length() > 0 {
    match base {
      SelfHosted { labels: labels } =>
        SelfHosted { labels: concat(labels, [ci_fleet_admission_label]) }
      other => other
    }
  } else {
    base
  }
}
