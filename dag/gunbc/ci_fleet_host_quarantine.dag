module gunbc.ci_fleet_host_quarantine

import extdeps.github.actions { RunnerSpec, SelfHosted }
import product.placement_supply { HostIdentity }
import gunbc.fleet_intent_network { operator_host_srv1 }

data ci_fleet_admission_label: String = "ci-fleet-admit"

data ci_fleet_quarantined_hosts: List<HostIdentity> = [operator_host_srv1]

data ci_fleet_host_quarantine_note: String = "Fleet CI host quarantine (Lane E, 2026-08-06): GitHub Actions runner matching is positive-only — a job cannot express 'not srv1'. When ci_fleet_quarantined_hosts is non-empty, gunbc_ci_selected_runner_spec appends ci_fleet_admission_label so only runners carrying that label admit generic CI work. OPERATOR ACTION REQUIRED ON MERGE: ensure srv2/srv3/srv4 fleet runners carry ci-fleet-admit; ensure srv1 fleet runners do NOT carry it (or disable them). Deploy stages stay srv1-pinned via gunbc_ci_deploy_srv1_runner_spec and are unaffected. DISSOLVE-ON: srv1 build-cache placement converges (gunbc.host_build_cache_provision provision_build_cache_widen_sketch_note — stranded sccache server pid 3975946 in retired slot srv1-10 cgroup repaired), srv1 removed from this list, admission label drops from the CI projection."

data ci_fleet_srv1_noncompletion_root_cause_note: String = "ROOT CAUSE RECEIPT — srv1 15-minute CI non-completions (Lane E, 2026-08-06). SYMPTOM: cargo check -p v1-compiler-tests --tests killed at the 15m step ceiling (gunbc_ci_v1_compiler_tests_compile_gate_timeout_minutes) while still compiling v1-compiler. EXECUTED EVIDENCE: run 31060400858 on main (runner srv1-05, step started 2026-08-05T00:52:48Z, killed 2026-08-05T01:07:48Z at 'Compiling v1-compiler'); run 31060543168 on session/snappy-otter-650 (runner srv1-01, same compile-gate step killed at 15m). WARM CONTRAST: gunbc_ci_v1_compiler_tests_compile_gate_timeout_note — warm-cache fleet runs complete the same step in ~50s–1m. MECHANISM: srv1 cold-compile wall exceeds the modeled envelope because the host's sccache server is stranded in retired slot srv1-10's cgroup (provision_build_cache_widen_sketch_note: pid 3975946, 31+ days, memory.max breaches and oom_kills while active slots 01–05 bound every compile). Quarantine routes generic CI away from srv1 until placement converges; raising the timeout alone (session/lively-crab-41-pr2 auto-heal 15m→20m, not merged) treats the symptom, not the stranded-server cause."

fn ci_fleet_admission_runner_spec(base: RunnerSpec) -> RunnerSpec {
  if ci_fleet_quarantined_hosts.length() > 0 {
    match base {
      SelfHosted { labels: labels } =>
        SelfHosted { labels: concat(labels, [ci_fleet_admission_label]) }
      other => other
    }
  } else {
    base
  }
}
