module gunbc.cli_services

import std.types { FilePath, String }
import gunbc.cli_invoke {
  claim_executor_run_plan_transport_argv,
  claim_executor_verify_artifacts_transport_argv,
  gunbc_run_transport_argv
}

service gunbc.Cli {
  operation Run {
    input {
      workdir: FilePath
      bin_path: FilePath
      source_roots: List<String>
      entry: String
      function: String
      claim_run: Bool = false
    }
    output {
      success: Bool from "exit_success"
      exit_code: Int from "exit_code"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: [
        "env",
        "-C",
        "{workdir}",
        "{bin_path}",
        gunbc_run_transport_argv(
          source_roots: source_roots,
          entry: entry,
          function: function,
          claim_run: claim_run
        )
      ]
    }
    exit {
      0 => Unit
      nonzero => String "gunbc run exited nonzero"
    }
  }
}

service claim_executor.Executor {
  operation RunPlan {
    input {
      workdir: FilePath
      bin_path: FilePath
      source_roots: List<String>
      plan_entry: String
      plan_function: String
      notice_title: String?
    }
    output {
      success: Bool from "exit_success"
      exit_code: Int from "exit_code"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: [
        "env",
        "-C",
        "{workdir}",
        "{bin_path}",
        claim_executor_run_plan_transport_argv(
          source_roots: source_roots,
          plan_entry: plan_entry,
          plan_function: plan_function,
          notice_title: notice_title
        )
      ]
    }
    exit {
      0 => Unit
      nonzero => String "claim_executor plan run exited nonzero"
    }
  }

  operation VerifyBuildArtifacts {
    input { workdir: FilePath, bin_path: FilePath, artifact_paths: List<String> }
    output {
      success: Bool from "exit_success"
      exit_code: Int from "exit_code"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: [
        "env",
        "-C",
        "{workdir}",
        "{bin_path}",
        claim_executor_verify_artifacts_transport_argv(artifact_paths: artifact_paths)
      ]
    }
    exit {
      0 => Unit
      nonzero => String "claim_executor build-artifact verification failed"
    }
  }
}
