module gunbc.cli_services

import std.types { FilePath, Unit }
import std.string_type { String }
import gunbc.cli_invoke {
  claim_executor_verify_artifacts_transport_argv,
  gunbc_run_transport_argv
}

// `gunbc.Cli.RunningVersion`: THE RUNNING INTERPRETER REPORTS WHICH SOURCE COMMIT BUILT IT, AND NOTHING ELSE CAN ANSWER FOR IT.
//
// `Run` above takes `bin_path`, so what it observes is whichever file the CALLER named. That is
// the wrong shape for a provenance join: an assessment that must prove the executable it is
// running under was built from the selected revision cannot take the executable's identity from
// a path, because a path is a claim about a file and the join is about a process. This operation
// therefore takes NO INPUT. Its argv is fixed at the Linux procfs magic link. THE PATH IS A LITERAL
// HERE BY THE EXECUTABLE-POSITION WALL: v2.std.operation_argv refuses any argv[0] that is not a
// literal in the declaration (ExecutablePositionNotLiteral), so neither `procfs_path_literal(p:
// ProcSelfExe)` nor a module-scope name bound from it may stand in this position -- measured, both
// were tried (gunbc#11693). The roster (extdeps.linux.procfs ProcSelfExe) remains the one place
// the fact is SPELLED; this literal is held equal to it by the enrolled claim
// test.claim.build_provenance_join_witness
// the_running_version_operation_materializes_to_the_magic_link_and_version_flag, which
// materializes this declaration through the same fold the argv corpus witness uses and compares
// argv[0] to the roster's rendering. The shell transport forks and execs argv[0] directly
// (no intermediate shell), and the kernel resolves /proc/self/exe in the forked child before the
// exec, so the program that answers is the same image the interpreter evaluating the call is
// running -- not the file at target/release/gunbc, not a binary a caller pointed at, and still
// the same image if that file was replaced after the interpreter started.
//
// The line it prints is `gunbc <identity>`, rendered by the generated clap surface from
// GUNBC_BUILD_IDENTITY (gunbc.cli_dispatch_surface gunbc_cli_version_text), and it is read back
// through that module's `gunbc_cli_version_line_parse` so render and parse stay one grammar.
//
// NO mock_response, deliberately. A hermetic caller receives a typed refusal rather than an
// identity that no build produced: a fabricated commit here would be the fabricated plausible
// output DESIGN section 5 forbids, wearing the name of the wall built to catch it.
service gunbc.Cli {
  operation Run {
    input {
      workdir: FilePath
      bin_path: FilePath
      source_roots: List<String>
      entry: String
      function: String
      claim_run: Bool = false
    }
    output {
      success: Bool from "exit_success"
      exit_code: Int from "exit_code"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: [
        "env",
        "-C",
        "{workdir}",
        "{bin_path}",
        gunbc_run_transport_argv(
          source_roots: source_roots,
          entry: entry,
          function: function,
          claim_run: claim_run
        )
      ]
    }
    exit {
      0 => Unit
      nonzero => String "gunbc run exited nonzero"
    }
  }

  operation RunningVersion {
    input {}
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    readonly
    transport shell { argv: ["/proc/self/exe", "--version"] }
    exit {
      0 => Unit
      nonzero => String "the running gunbc did not report its version"
    }
  }
}

service claim_executor.Executor {
  operation VerifyBuildArtifacts {
    input { workdir: FilePath, bin_path: FilePath, artifact_paths: List<String> }
    output {
      success: Bool from "exit_success"
      exit_code: Int from "exit_code"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: [
        "env",
        "-C",
        "{workdir}",
        "{bin_path}",
        claim_executor_verify_artifacts_transport_argv(artifact_paths: artifact_paths)
      ]
    }
    exit {
      0 => Unit
      nonzero => String "claim_executor build-artifact verification failed"
    }
  }
}
