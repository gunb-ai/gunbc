module gunbc.ci_deploy_sudoers



data deploy_sudoers_note: String = "Wave C envelope: /etc/sudoers.d/gunbc-deploy is EMITTED from the roster grants (never hand-managed). visudo -c gates install. Generic movers (rsync/chown) are refused in the roster — #7011 realization routes tree sync through gunbc-tree-sync.service and ownership through install -o/-g. Sudo-grant lint allow-list is DERIVED from fleet_posix_ci_runner_sudo_grants() command_path rows — never a parallel path list."

data deploy_sudoers_shell_emit_dissolution_trigger: std.dissolution.DissolutionCondition = unbound_dissolution(description: "🟡 dissolve-on: gunbc.ci_deploy_sudoers — concat-built bash for sudoers dropin install and visudo gates; DISSOLVES WHEN live_deploy_emit_shell_dissolution_trigger retires (bash-emit #5828 / shell-intent Phase 2 realizes deploy shell through orchestration emit without medium-as-string here-docs).")

data deploy_sudoers_shell_emit_scaffold: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.ci_deploy_sudoers",
    decl_name: "deploy_sudoers_shell_emit_dissolution_trigger",
    field: WholeDeclaration,
  }
}

data refused_generic_mover_paths: List<std.types.NonEmptyStr> = [
  "/usr/bin/rsync",
  "/usr/bin/chown",
]

fn posix_sudo_grant_is_refused_generic_mover(g: gunbc.fleet_posix_accounts.PosixSudoGrant) -> Bool {
  any(refused_generic_mover_paths, p => p == g.command_path)
}

fn posix_sudo_grant_command_paths_match(row: gunbc.fleet_posix_accounts.PosixSudoGrant, g: gunbc.fleet_posix_accounts.PosixSudoGrant) -> Bool {
  row.command_path == g.command_path
}

fn posix_sudo_grant_is_allowed_roster_command(g: gunbc.fleet_posix_accounts.PosixSudoGrant) -> Bool {
  any(
    fleet_posix_ci_runner_sudo_grants(),
    row => posix_sudo_grant_command_paths_match(row: row, g: g)
  )
}

fn posix_sudo_grant_generic_mover_lint_ok(g: gunbc.fleet_posix_accounts.PosixSudoGrant) -> Bool {
  if posix_sudo_grant_is_refused_generic_mover(g: g) {
    false
  } else {
    posix_sudo_grant_is_allowed_roster_command(g: g)
  }
}

fn deploy_access_sudo_grants_lint_ok(access: gunbc.ci_deploy_access.DeployAccess) -> Bool {
  v2.std.algebra.fold_list(
    xs: access.principal.sudo_grants,
    empty: true,
    cons: (acc, g) =>
      if !acc {
        false
      } else {
        posix_sudo_grant_generic_mover_lint_ok(g: g)
      }
  )
}

fn deploy_sudoers_dropin_header() -> String {
  "# GENERATED by dag/gunbc/ci_deploy_sudoers.dag — do not hand-edit\n"
}

fn deploy_sudoers_line_for_grant(access: gunbc.ci_deploy_access.DeployAccess, g: gunbc.fleet_posix_accounts.PosixSudoGrant) -> String {
  deploy_access_sudoers_line(
    access: access,
    cmd: posix_sudo_grant_to_privileged(g: g)
  )
}

fn deploy_sudoers_dropin_body(access: gunbc.ci_deploy_access.DeployAccess) -> String {
  v2.std.algebra.fold_list(
    xs: access.principal.sudo_grants,
    empty: "",
    cons: (acc, g) =>
      concat(
        acc,
        concat(deploy_sudoers_line_for_grant(access: access, g: g), "\n")
      )
  )
}

fn deploy_sudoers_dropin_content(access: gunbc.ci_deploy_access.DeployAccess) -> String {
  concat(deploy_sudoers_dropin_header(), deploy_sudoers_dropin_body(access: access))
}

fn deploy_sudoers_install_shell(access: gunbc.ci_deploy_access.DeployAccess) -> String {
  join([
    "cat > \"$_gunbc_stage/gunbc-deploy.sudoers\" <<'GUNBC_SUDOERS_EOF'\n",
    deploy_sudoers_dropin_content(access: access),
    "GUNBC_SUDOERS_EOF\n",
    "sudo -n ", fleet_visudo_binary_path as String, " -cf \"$_gunbc_stage/gunbc-deploy.sudoers\"\n",
    "sudo -n install -m 0440 \"$_gunbc_stage/gunbc-deploy.sudoers\" ",
    gunbc_deploy_sudoers_dropin as String,
    "\n",
    "sudo -n ", fleet_visudo_binary_path as String, " -cf ", gunbc_deploy_sudoers_dropin as String,
  ], "")
}
