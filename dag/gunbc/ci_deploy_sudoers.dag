module gunbc.ci_deploy_sudoers

import std.types { String, NonEmptyStr, List, Bool }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import v2.std.algebra { fold_list, any }
import gunbc.ci_deploy_access {
  DeployAccess,
  PrivilegedCommand,
  gunbc_deploy_sudoers_dropin,
  deploy_access_sudoers_line,
}
import gunbc.fleet_posix_accounts {
  PosixSudoGrant,
  gunbc_deploy_privileged_helper_path,
  fleet_posix_ci_runner_sudo_grants,
}

data deploy_sudoers_note: String = "Wave C envelope: /etc/sudoers.d/gunbc-deploy is EMITTED from the roster grants (never hand-managed). visudo -c gates install. Generic movers (rsync/chown) are refused in the roster — #7011 realization routes tree sync through gunbc-tree-sync.service and ownership through install -o/-g. Sudo-grant lint allow-list is DERIVED from fleet_posix_ci_runner_sudo_grants() command_path rows — never a parallel path list. deploy_blessed_helper_* rows are dissolution scaffolds only (helper grant dropped post-#7011)."

data deploy_sudoers_shell_emit_dissolution_trigger: String = "🟡 dissolve-on: gunbc.ci_deploy_sudoers — concat-built bash for sudoers dropin install, visudo gates, and blessed-helper heredoc body; DISSOLVES WHEN live_deploy_emit_shell_dissolution_trigger retires (bash-emit #5828 / shell-intent Phase 2 realizes deploy shell through orchestration emit without medium-as-string here-docs)."

data deploy_sudoers_shell_emit_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.ci_deploy_sudoers",
    decl_name: "deploy_sudoers_shell_emit_dissolution_trigger",
    field: WholeDeclaration,
  }
}

data refused_generic_mover_paths: List<NonEmptyStr> = [
  "/usr/bin/rsync",
  "/usr/bin/chown",
]

fn posix_sudo_grant_is_refused_generic_mover(g: PosixSudoGrant) -> Bool {
  any(refused_generic_mover_paths, p => p == g.command_path)
}

fn posix_sudo_grant_is_allowed_roster_command(g: PosixSudoGrant) -> Bool {
  any(
    fleet_posix_ci_runner_sudo_grants(),
    row => row.command_path == g.command_path
  )
}

fn posix_sudo_grant_generic_mover_lint_ok(g: PosixSudoGrant) -> Bool {
  if posix_sudo_grant_is_refused_generic_mover(g: g) {
    false
  } else {
    posix_sudo_grant_is_allowed_roster_command(g: g)
  }
}

fn deploy_access_sudo_grants_lint_ok(access: DeployAccess) -> Bool {
  fold_list(
    xs: access.principal.sudo_grants,
    empty: true,
    cons: (acc, g) =>
      if !acc {
        false
      } else {
        posix_sudo_grant_generic_mover_lint_ok(g: g)
      }
  )
}

fn deploy_sudoers_dropin_header() -> String {
  "# GENERATED by dag/gunbc/ci_deploy_sudoers.dag — do not hand-edit\n"
}

fn deploy_sudoers_line_for_grant(access: DeployAccess, g: PosixSudoGrant) -> String {
  deploy_access_sudoers_line(
    access: access,
    cmd: PrivilegedCommand { path: g.command_path, check: g.check_argv }
  )
}

fn deploy_sudoers_dropin_body(access: DeployAccess) -> String {
  fold_list(
    xs: access.principal.sudo_grants,
    empty: "",
    cons: (acc, g) =>
      concat(
        acc,
        concat(deploy_sudoers_line_for_grant(access: access, g: g), "\n")
      )
  )
}

fn deploy_sudoers_dropin_content(access: DeployAccess) -> String {
  concat(deploy_sudoers_dropin_header(), deploy_sudoers_dropin_body(access: access))
}

fn deploy_sudoers_install_shell(access: DeployAccess) -> String {
  join([
    "cat > \"$_gunbc_stage/gunbc-deploy.sudoers\" <<'GUNBC_SUDOERS_EOF'\n",
    deploy_sudoers_dropin_content(access: access),
    "GUNBC_SUDOERS_EOF\n",
    "sudo -n visudo -cf \"$_gunbc_stage/gunbc-deploy.sudoers\"\n",
    "sudo -n install -m 0440 \"$_gunbc_stage/gunbc-deploy.sudoers\" ",
    gunbc_deploy_sudoers_dropin as String,
    "\n",
    "sudo -n visudo -cf ", gunbc_deploy_sudoers_dropin as String,
  ], "")
}

fn deploy_sudoers_converge_verify_shell(access: DeployAccess) -> String {
  concat(
    "cmp -s \"$_gunbc_stage/gunbc-deploy.sudoers\" ",
    concat(gunbc_deploy_sudoers_dropin as String, " || { echo deploy_sudoers: converge mismatch; exit 1; }")
  )
}

fn deploy_blessed_helper_body() -> String {
  join([
    "#!/bin/bash\n",
    "set -euo pipefail\n",
    "case \"${1:-}\" in\n",
    "  probe)\n",
    "    exit 0\n",
    "    ;;\n",
    "  rsync-tree)\n",
    "    shift\n",
    "    rsync \"$@\"\n",
    "    ;;\n",
    "  chown-owned)\n",
    "    shift\n",
    "    chown \"$@\"\n",
    "    ;;\n",
    "  rmdir-empty)\n",
    "    shift\n",
    "    rmdir \"$@\"\n",
    "    ;;\n",
    "  rm-tree)\n",
    "    shift\n",
    "    rm -rf \"$@\"\n",
    "    ;;\n",
    "  *)\n",
    "    echo \"gunbc-deploy-privileged: refused unknown subcommand ${1:-}\" >&2\n",
    "    exit 1\n",
    "    ;;\n",
    "esac\n",
  ], "")
}

fn deploy_blessed_helper_install_shell() -> String {
  join([
    "cat > \"$_gunbc_stage/gunbc-deploy-privileged\" <<'GUNBC_PRIV_HELPER_EOF'\n",
    deploy_blessed_helper_body(),
    "GUNBC_PRIV_HELPER_EOF\n",
    "sudo -n install -d -m 0755 /opt/gunbc/bin\n",
    "sudo -n install -m 0755 \"$_gunbc_stage/gunbc-deploy-privileged\" ",
    gunbc_deploy_privileged_helper_path as String,
  ], "")
}

fn posix_sudo_grant_is_blessed_helper(g: PosixSudoGrant) -> Bool {
  g.command_path == gunbc_deploy_privileged_helper_path
}

fn deploy_blessed_helper_grant_present(access: DeployAccess) -> Bool {
  any(
    access.principal.sudo_grants,
    g => posix_sudo_grant_is_blessed_helper(g: g)
  )
}
