module gunbc.required_regen_derivation_trigger_census

import std.types { Int, String, Bool }
import std.decl_ref { DeclarationRef, decl_ref }

// WHAT THIS MODULE IS, AND WHAT IT DELIBERATELY IS NOT.
//
// It records a measured CONTRADICTION between two authorities in this corpus, and it records
// nothing else. It is not a repair, not a plan, and not a proposal for the Wave 4 work. Resolving
// the contradiction means editing DESIGN against a plan, which is an operator decision; naming it
// is the whole deliverable. The module gates nothing and no consumer reads it -- stated plainly so
// that its presence is never miscounted as coverage (DESIGN section 4b: a carrier named for a
// wall while occupying none is inflation).
//
// THE CONTRADICTION. DESIGN records the regen host's hand-written ordering at *mitigatable* with
// "the host being derived from the carrier rather than written beside it" as its next-rung
// trigger. `gunbc.plans.cli_run_hollowing_plan` carries a row whose subject is exactly that pair
// -- area "Regen oracle & self-host scope", authority `v2.workflow.required_regen` /
// `v1_compiler.required_regen_host` -- and dispositions it `delete-with-v1`, trigger "Wave 4
// real-fixpoint cutover (5-real-fixpoint)", with the body adding "bulk GENERATED cutover, not
// piecemeal". One authority asserts a climb, the other schedules a deletion, neither cites the
// other, and nothing in the corpus refuses over the pair.
//
// WHY THAT IS WORSE THAN AN UNTRACKED STALL RATHER THAN EQUIVALENT TO ONE. DESIGN section 4b(2)
// exists to separate three states: cannot climb further, can climb after one grounding, and can
// climb now but unbuilt. Only the first is permanent. This row READS as the third -- a named
// trigger someone could pick up -- while being the first, so it will never rank for work and will
// never retire. A declared stall is visible; a trigger nobody can satisfy is camouflage.
type PreconditionOutcome
  = PreconditionHolds
  | PreconditionFalse { evidence: String }

type TriggerPrecondition {
  precondition: String
  outcome: PreconditionOutcome
}

// EACH OF THESE WAS FOUND ONLY BY ATTEMPTING THE STEP THE PREVIOUS ONE UNBLOCKED, which is the
// reusable half: a precondition check is not a thing you do once before starting. Every step that
// changes the shape of the work can expose the next wall, and all three of these were invisible
// from the trigger's own wording.
data required_regen_derivation_preconditions: List<TriggerPrecondition> = [
  TriggerPrecondition {
    precondition: "the carrier is reachable by the regen emitted closure",
    outcome: PreconditionFalse {
      evidence: "regen_source_roots() is a closed two-variant enum -- src/v1 and dag -- so src/v2 is not a regen root. Measured by reading line 2 of every emitted stage0 .rs: ZERO declare a v2.* source module. The exclusion is deliberate rather than an omission; dag/std/trait_derive_shape.dag states it, on the ground that stage0 IS the v1 seed and a seed reaching into src/v2 would depend on the successor it bootstraps toward."
    }
  },
  TriggerPrecondition {
    precondition: "relocating the carrier into dag/ would place it in the closure",
    outcome: PreconditionFalse {
      evidence: "Closure membership is by IMPORT FROM A SEED MODULE, not by residence under dag/. A relocated vocabulary with no seed-side importer is not emitted, so the host still has no generated type to name. See required_regen_closure_membership_controls below for the measurement in both directions."
    }
  },
  TriggerPrecondition {
    precondition: "a seed-side consumer exists that would import the carrier",
    outcome: PreconditionFalse {
      evidence: "Nothing under src/v1 consumes regen refusals: the adjudication is hand-written Rust. The only honest candidate consumer is the regen host itself, which is hand-written and which the plan row schedules for deletion at the same gate. An import added to a seed module that does not use the type would be an edge authored purely to force emission -- a scaffold by the DESIGN section 6 tell (a new artifact with no consumer), and refused on that ground rather than attempted."
    }
  }
]

// DERIVED, NEVER STORED. There is no field anywhere in this module holding a verdict about the
// trigger, so a transcribed or stale verdict is unrepresentable rather than merely discouraged
// (DESIGN section 4b, Stage 1's derived-disposition rule).
fn required_regen_derivation_trigger_is_satisfiable() -> Bool {
  (required_regen_derivation_preconditions |> any(p => match p.outcome {
    PreconditionFalse { evidence: _ } => true
    PreconditionHolds => false
  })) == false
}

type ClosureMembershipObservation {
  module_path: String
  seed_importers: Int
  emitted: Bool
}

// THE NEGATIVE CONTROLS ARE THE POINT OF THIS TABLE. A positive-only list would establish that
// imported modules are emitted and would leave "would an unimported one be emitted anyway?"
// unanswered -- which is the exact question precondition two turns on. Three modules with zero
// seed importers, none emitted, against two with importers that are, makes the rule checkable by
// the next reader instead of re-derivable only by trying it.
data required_regen_closure_membership_controls: List<ClosureMembershipObservation> = [
  ClosureMembershipObservation { module_path: "extdeps.cargo", seed_importers: 2, emitted: true },
  ClosureMembershipObservation { module_path: "gunbc.cli_dispatch_surface", seed_importers: 1, emitted: true },
  ClosureMembershipObservation { module_path: "gunbc.ci_spec", seed_importers: 0, emitted: false },
  ClosureMembershipObservation { module_path: "gunbc.commit_workflow", seed_importers: 0, emitted: false },
  ClosureMembershipObservation { module_path: "gunbc.doc_graph_roots", seed_importers: 0, emitted: false }
]

data required_regen_comment_held_authority_note: String = "THE CARRIER IS NOT EXECUTED BY ANYTHING IN PRODUCTION, AND THIS IS THE FINDING THAT EXPLAINS THE OTHERS. `v2.workflow.required_regen` `required_regen_run` and `required_regen_sync_admission` are described throughout the corpus as the authority that the regen host MIRRORS. Measured across all of src/v1/stage0/src/*.rs, the two names occur exactly ONCE, and the occurrence is a COMMENT naming the carrier as authority for an ordering. No production Rust calls into it. Its only executor in the repository is its own witness test.\n\nSo the relationship is held by a sentence, not by a call, a shared type, or an execution. That is DESIGN section 5's specification-without-execution on the production path -- and specifically its LLM-facing form, since a typechecking, grep-passing, well-cited carrier is exactly the artifact that looks finished without running.\n\nWHAT IT EXPLAINS. The two ends carry different refusal vocabularies: the host has 23 production refusal sites covering roughly 21 distinct states, and the carrier names SIX of those states (EmptyEmitResult, EmptyCommittedPopulation, MirrorMissingForEmittedSurface, CommittedMirrorNoLongerEmitted, MirrorMissingShadowsHandMaintainedSource, CandidateTreeAbsent), while three of the carrier's eleven declared variants (CompileRefused, CandidateTreeAbsent, FormatterUnavailable) have no producer anywhere. The site count and the state count are deliberately reported separately: two states are refused at two sites each, so a site total read as a state total overstates the divergence. The tempting reading is that the host's Vec<String> refusal channel let names get lost, and that typing the channel would close it. That reading is downstream of the real cause: NOTHING EVER FORCED THE TWO TOGETHER. A comment-held correspondence produces exactly this divergence given time, and it would have produced it through a typed channel too, because no execution path compares them.\n\nWHAT IS NOT CLAIMED: the three unproduced variants are REACHABLE, not dead. compile_stage0 returns an error precisely when a self-compile refusal fires, which is regen refusing because a compile refused, and both regen entry points reach it. Zero producers is occupancy, and occupancy is not reachability -- deleting them would remove live walls while looking principled."

data required_regen_absence_oracle_note: String = "HOW THE ZERO-PRODUCER COUNT WAS ESTABLISHED, recorded because the method is invalid by default and the reason it holds here is specific. The count came from grepping variant NAMES, which is a terminal-constructor search; using one as an ABSENCE oracle normally proves nothing, because a wrapper or synthesizing path can reach a constructor without spelling its name. It is legitimate here for a structural reason: constructing a .dag coproduct variant requires the literal variant name, and a check for reflective construction (construct_variant / variant_by_name / make_variant) returns nothing anywhere in the corpus. So for the .dag side the terminal-constructor vocabulary IS the producer-path vocabulary.\n\nThe general law, worth more than this instance: an exclusion oracle needs a closed PRODUCER-PATH vocabulary, not merely a closed terminal-constructor vocabulary. Where that does not hold, a producer may publish the positives it found and may not publish 'no X exists'. The host-side claims in this module are therefore scoped to what was read directly rather than extended by the same grep."

data required_regen_derivation_trigger_census_scope_note: String = "SCOPE, so the census is not read as wider than it is. Subject: ONE trigger, on ONE authority pair. It says nothing about how many other next-rung triggers in this corpus carry false preconditions, and the population of such triggers is UNMEASURED -- deliberately, because a specimen count taken while establishing the mechanism would be mistaken for the bound (DESIGN's bound-shaped-closure tell: before a number discharges a requirement, ask what the producer does after it has enough to answer).\n\nWhat licenses generalizing the MECHANISM and not the RATE: nothing in the corpus can refuse over a trigger, because a trigger has no executable dependents. Deleting a function breaks its callers; declaring an unsatisfiable trigger breaks nothing. So the fail-closed census that normally surfaces a load-bearing defect loudly is structurally silent for this entire class, and the only mechanism that finds one is somebody attempting the work. That is a property of triggers in general, established here on one specimen."

data required_regen_derivation_trigger_census_authorities: List<DeclarationRef> = [
  decl_ref(module_path: "v2.workflow.required_regen", decl_name: "required_regen_run"),
  decl_ref(module_path: "v2.workflow.required_regen", decl_name: "required_regen_sync_admission"),
  decl_ref(module_path: "v2.workflow.required_regen", decl_name: "RequiredRegenRefusal"),
  decl_ref(module_path: "gunbc.plans.cli_run_hollowing_plan", decl_name: "cli_run_hollowing_plan_body")
]
