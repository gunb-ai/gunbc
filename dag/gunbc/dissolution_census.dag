module gunbc.dissolution_census

import std.roster_frontier {
  FrontierRow,
  FrontierExpiryReport,
  fold_frontier_expiry,
  frontier_expiry_clean,
  frontier_rows_well_formed,
}
import std.dissolution { DissolutionCondition, dissolution_is_bound }
import std.decl_ref { DeclarationRef }
import gunbc.census_closure_frontier { census_closure_frontier_rows }

fn dissolution_census_report() -> FrontierExpiryReport {
  fold_frontier_expiry(rows: census_closure_frontier_rows(), present_decls: [])
}

fn dissolution_census_report_against(present_decls: List<DeclarationRef>) -> FrontierExpiryReport {
  fold_frontier_expiry(rows: census_closure_frontier_rows(), present_decls: present_decls)
}

fn dissolution_census_unbound_count() -> Int {
  dissolution_census_report().unbound_count
}

fn dissolution_census_pending_count() -> Int {
  dissolution_census_report().pending_count
}

fn dissolution_census_fired_still_present_count() -> Int {
  dissolution_census_report().fired_still_present_count
}

fn dissolution_census_total() -> Int {
  let r = dissolution_census_report()
  r.unbound_count + r.pending_count + r.fired_still_present_count
}

fn dissolution_census_holds() -> Bool {
  frontier_rows_well_formed(rows: census_closure_frontier_rows())
    && frontier_expiry_clean(report: dissolution_census_report())
}

fn frontier_rows_bound_count(rows: List<FrontierRow>) -> Int {
  fold(rows, init: 0, f: fn(acc, row) {
    if dissolution_is_bound(condition: row.dissolution) { acc + 1 } else { acc }
  })
}
