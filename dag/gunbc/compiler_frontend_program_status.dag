module gunbc.compiler_frontend_program_status

import std.types { NonEmptyStr }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import extdeps.filesystem.filesystem_io { Filesystem }
import std.witness_admission {
  WitnessConsumerCadence,
  witness_cadence_has_scheduled_route,
}
import gunbc.compiler_frontend_program_interlock {
  ProgramMilestone,
  SelfHostWholeCorpusPopulationDerived,
  SelfHostCargoPhaseEnrolled,
  SelfHostRatchetObservationEnrolled,
  SelfHostRatchetGateEnrolled,
  NamespaceWaveAdmissionEnrolled,
  NamespaceBaselineObservationComplete,
  NamespaceFirstSemanticWave,
  NamespaceFixForwardComplete,
  NamespaceGrammarRetired,
  SelfHostCorpusEmitsCleanly,
  SelfHostBehavioralEquivalenceReestablished,
  SelfHostEmitterProducesEveryRetainedArtifact,
  SelfHostSuccessorPromotionAdmitted,
  SelfHostSeedRetirement,
  milestone_label,
  milestone_prerequisites,
}
import gunbc.cli_dispatch_surface { gunbc_cli_emitter_gap }
import gunbc.emit_subject_clean_frontier { emit_ratchet_runner_cadence }
import v2.compiler.self_host.stage0_crate_layout { emitter_produced_divergent_registrations }

// WHY THIS IS A SEPARATE MODULE FROM THE INTERLOCK IT READS. The interlock carries a RELATION --
// which milestone precedes which -- and that relation is a closed, pure fact with no dependency on
// any mechanism. This module carries an OBSERVATION over the corpus, so it must import the
// mechanisms whose populations it reads. Fusing the two would put every one of those mechanisms
// into the import closure of both plan carriers that cite the interlock, which today cite it for
// the ordering alone. The two facts also move on different clocks: the relation changes when an
// operator rules on sequencing, the observation changes whenever a population does.

// THE ONE FAILURE THIS FILE IS BUILT NOT TO COMMIT. DESIGN section 4b names a status ledger's
// "DONE" as rung inflation -- a carrier claiming a state it has not earned -- and calls it worse
// than sitting low, because an inflated class never ranks for climbing. A progress carrier is the
// single most likely artifact in this repository to commit it. So no milestone here is ticked.
// Its standing is DERIVED from a population the corpus itself carries, or it is NotDerivable.
//
// NotDerivable IS A RESULT, not a failure to report. A milestone nobody can currently answer names
// a missing instrument, and naming eleven of them is the report that cannot be obtained today. The
// state this file must never produce is a milestone that reads pending when in truth nothing could
// ever answer it, or one that reads clear because a pull request merged. A MERGED PR IS NOT A
// MILESTONE, and no arm below consults one.
type MilestoneStandingClass
  = ClassClear
  | ClassOutstanding
  | ClassNotDerivable

// EVIDENCE IS MINTED FROM A POPULATION, NEVER AUTHORED. `sole_constructor` means no module but this
// one can build a MilestoneEvidence, so a consumer cannot hand itself a zero-outstanding evidence
// value and read Clear off it. Inside this module the mint takes the outstanding LIST rather than a
// count, which is DESIGN section 5's oracle rule: completeness is an identity join, and a count
// would go green the moment two rows moved in opposite directions.
//
// WHAT THIS DOES NOT CLAIM, stated at the grain the seal actually holds. `sole_constructor` closes
// forgery of the RECORD; it does not close a caller handing the mint an empty list, and the mint is
// exported because the witness beside this module needs to author both a clear and an outstanding
// fixture population -- an unexported mint would have forced a test-only construction path, which
// DESIGN section 5 calls an escape hatch wearing a better name. So what is structurally guaranteed
// is narrower than "Clear cannot be wrong": it is that NO MilestoneStanding EXISTS WITHOUT A NAMED
// SUBJECT AND AN OBSERVED POPULATION -- there is no spelling of a bare tick. The rung for the
// standings themselves is MECHANICALLY PREVENTABLE, and the mechanism is the witness, which asserts
// the live outstanding identities by name and reds if an arm stops reading its population.
// NEXT-RUNG TRIGGER: a mint that consumes the producing declaration itself rather than a list a
// caller derived, at which point the empty-literal spelling stops existing at all.
type MilestoneEvidence sole_constructor {
  subject: NonEmptyStr
  outstanding: List<String>
}

fn observe_outstanding(subject: NonEmptyStr, outstanding: List<String>) -> MilestoneEvidence {
  MilestoneEvidence { subject: subject, outstanding: outstanding }
}

type MilestoneStanding
  = Clear { evidence: MilestoneEvidence }
  | Outstanding { evidence: MilestoneEvidence }
  | NotDerivable { missing_instrument: NonEmptyStr }

// THE ONLY ROUTE TO Clear. It is a fold over an observed population and takes no other input, so
// "clear" cannot be said about a milestone without naming the population it is clear OF.
fn standing_from_evidence(e: MilestoneEvidence) -> MilestoneStanding {
  if count(e.outstanding) == 0 {
    Clear { evidence: e }
  } else {
    Outstanding { evidence: e }
  }
}

fn standing_class(s: MilestoneStanding) -> MilestoneStandingClass {
  match s {
    Clear { evidence: _ } => ClassClear
    Outstanding { evidence: _ } => ClassOutstanding
    NotDerivable { missing_instrument: _ } => ClassNotDerivable
  }
}

fn standing_class_label(c: MilestoneStandingClass) -> String {
  match c {
    ClassClear => "CLEAR"
    ClassOutstanding => "OUTSTANDING"
    ClassNotDerivable => "NOT-DERIVABLE"
  }
}

// ---------------------------------------------------------------------------------------------
// THE DERIVATIONS.
//
// THE ADMISSION TEST FOR WRITING ONE, and it is the trigger-sufficiency rule applied to a status
// carrier: an arm may derive a standing only where the population it reads IS the milestone's
// definition, not a necessary condition of it. A population that is necessary and not sufficient
// must return NotDerivable, because an empty necessary population yields Clear and Clear then means
// something weaker than the milestone's own label. That is the same shape as a restoration trigger
// naming less than the capability it restores: satisfied while the thing stays undone.
// ---------------------------------------------------------------------------------------------

// DEFINITIONAL, quoting the interlock's own label: "no EmitterProducedDivergentRegistration
// remains -- the emitter can produce every artifact the seed retains, the CLI entry point
// included". The population is the union of two rosters because the surviving divergent row's own
// restoration trigger names both halves: the row must be gone AND `gunbc_cli_emitter_gap` must
// return empty. Reading only the registrations would return Clear the moment the row was deleted,
// while the CLI surface it stands for was still unemitted.
fn emitter_retained_artifact_outstanding() -> List<String> {
  concat(
    emitter_produced_divergent_registrations
      |> map(row => concat("stage0-divergent:", row.basename)),
    gunbc_cli_emitter_gap() |> map(name => concat("cli-emitter-gap:", name))
  )
}

// DEFINITIONAL for the OBSERVATION half only. The milestone is that the ratchet runner is enrolled
// as something that runs; `std.witness_admission` is the single authority for whether a cadence has
// a scheduled route, and `emit_subject_clean_frontier` is the single authority for which cadence
// the runner declares. This module consults them rather than minting a second "does anything run
// this" vocabulary beside them.
//
// IT DOES NOT REACH THE GATE HALF, which is why S4b stays NotDerivable below: one cadence row
// cannot distinguish "taken and persisted" from "merge-blocking", so deriving both from it would
// let enrolling an observation read as enrolling a gate -- the fused-variant defect the interlock
// was split four times to remove, committed by its reader instead.
fn ratchet_observation_outstanding(cadence: WitnessConsumerCadence) -> List<String> {
  if witness_cadence_has_scheduled_route(cadence: cadence) {
    []
  } else {
    ["tools.emit_subject_clean_ratchet: declared cadence has no scheduled route"]
  }
}

fn milestone_status(m: ProgramMilestone) -> MilestoneStanding {
  match m {
    SelfHostWholeCorpusPopulationDerived =>
      NotDerivable {
        missing_instrument: "no persisted whole-corpus emission board exists. tools.emission_entry_instrument measure_entry_emission answers PER ENTRY, and the union of per-entry closures is not the corpus. Derivable once a whole-corpus run's typed measurement is persisted in a carrier this module can read." as NonEmptyStr
      }
    SelfHostCargoPhaseEnrolled =>
      NotDerivable {
        missing_instrument: "the --required-ci phase roster lives in host Rust (RequiredCiPhase) and gunbc.witness_floor_workflow models LANES, not phases, so no .dag authority states which phases a lane owns. Derivable once the phase roster is a substrate carrier the workflow emission reads." as NonEmptyStr
      }
    SelfHostRatchetObservationEnrolled =>
      standing_from_evidence(
        e: observe_outstanding(
          subject: "self-host S4a: ratchet enrolled as an observation" as NonEmptyStr,
          outstanding: ratchet_observation_outstanding(cadence: emit_ratchet_runner_cadence)
        )
      )
    SelfHostRatchetGateEnrolled =>
      NotDerivable {
        missing_instrument: "a gate is meaningless without the identity-grain population it gates against, and S2's population has no producer. The cadence row that answers S4a cannot answer this one: it cannot distinguish an observation from a merge-blocking gate. Derivable once S2's population is persisted AND the ratchet's merge-blocking enrolment is a fact distinct from its cadence." as NonEmptyStr
      }
    NamespaceWaveAdmissionEnrolled =>
      NotDerivable {
        missing_instrument: "the wave-admission wall does not exist yet, so there is nothing to cite. gunbc.compiler_frontend_program_interlock records the admission partition as prose precisely because a partition with no consumer is a guess. Derivable once the wall exists and classifies deltas, at which point its unadjudicated-delta population is this milestone's own." as NonEmptyStr
      }
    NamespaceBaselineObservationComplete =>
      NotDerivable {
        missing_instrument: "v2.workflow.legacy_binding_observation can ADMIT a complete legacy observation, but whether one has been TAKEN over an exact base is a run fact and no carrier holds it. Derivable once an admitted CompleteLegacyObservation is persisted against a named base commit." as NonEmptyStr
      }
    NamespaceFirstSemanticWave =>
      NotDerivable {
        missing_instrument: "the milestone is the DELETION of the import-name universe, and absence of a symbol is not a population this module can read -- a citation to a deleted declaration refuses at ingestion rather than answering false. Derivable once gunbc.namespace_cut_landing_order carries the remaining per-step subject population as rows." as NonEmptyStr
      }
    NamespaceFixForwardComplete =>
      NotDerivable {
        missing_instrument: "same shape as the first wave: Steps 2-4 are fix-forward over a class-grain population that no carrier enumerates. Derivable once the unrepaired classes are rows rather than a description." as NonEmptyStr
      }
    NamespaceGrammarRetired =>
      NotDerivable {
        missing_instrument: "the milestone is a grammar and parse deletion, and the same absence-is-not-a-population limit applies. Derivable once the grammar productions scheduled for deletion are an enumerated roster whose members refuse when they stop being reachable." as NonEmptyStr
      }
    SelfHostCorpusEmitsCleanly =>
      NotDerivable {
        missing_instrument: "this is S2's population driven to zero, and S2 has no producer. Any figure quoted for the current rustc population today is unsourced -- the 2026-08-24 measurement bankruptcy deleted the boards and the instrument was restored without one. Derivable exactly when S2 is." as NonEmptyStr
      }
    SelfHostBehavioralEquivalenceReestablished =>
      NotDerivable {
        missing_instrument: "the behavioral-receipt phases were among the five deleted from the required run on 2026-08-21, so the measurement is not currently taken. The capability survives at --behavioral-receipt-census, which no workflow invokes. Derivable once a behavioral receipt over a discriminating corpus is persisted." as NonEmptyStr
      }
    SelfHostEmitterProducesEveryRetainedArtifact =>
      standing_from_evidence(
        e: observe_outstanding(
          subject: "self-host: emitter produces every retained artifact" as NonEmptyStr,
          outstanding: emitter_retained_artifact_outstanding()
        )
      )
    SelfHostSuccessorPromotionAdmitted =>
      NotDerivable {
        missing_instrument: "v2.compiler.self_host.promotion_admission admit_promotion is a decision procedure over a SelfHostCandidate; whether it has ever returned a promotion for a real candidate is a run fact and no carrier holds one. Derivable once an admitted PromotionOutcome over a named candidate is persisted -- which is also the point at which the procedure stops being an inert mechanism." as NonEmptyStr
      }
    SelfHostSeedRetirement =>
      NotDerivable {
        missing_instrument: "the irreversible step. Its own population -- the hand-written seed families -- is readable, but that population is NECESSARY AND NOT SUFFICIENT: emptying it would read Clear while the three conditions the interlock places in front of it stayed unmeasured. Derivable only when its prerequisites are, which is why no arm here reads the seed rosters." as NonEmptyStr
      }
  }
}

// ---------------------------------------------------------------------------------------------
// STARTABILITY: THE PREREQUISITE CLOSURE, FAIL-CLOSED.
//
// A milestone is startable when every direct prerequisite is CLEAR. The load-bearing arm is the
// third one: if any prerequisite is NotDerivable, startability is NOT "blocked" and NOT "ready" --
// it is NotDerivable too. Collapsing an unanswerable prerequisite into "blocked" would report a
// missing instrument as ordinary pending work, and collapsing it into "ready" would authorize work
// on a precondition nobody has measured. The prerequisites are the interlock's DIRECT edges, so
// this walks one level; the transitive reading is obtained by asking about the prerequisites in
// turn, and is deliberately not restated here (DESIGN section 2).
// ---------------------------------------------------------------------------------------------
type Startability
  = StartablePrerequisitesClear
  | BlockedOnPrerequisites { blocking: List<String> }
  | StartabilityNotDerivable { unanswerable: List<String> }

fn prerequisite_names_by_class(m: ProgramMilestone, want: MilestoneStandingClass) -> List<String> {
  fold(milestone_prerequisites(m: m), init: [], f: fn(acc, p) {
    if standing_class_label(c: standing_class(s: milestone_status(m: p)))
       == standing_class_label(c: want) {
      concat(acc, [milestone_label(m: p)])
    } else {
      acc
    }
  })
}

fn milestone_startability(m: ProgramMilestone) -> Startability {
  let unanswerable = prerequisite_names_by_class(m: m, want: ClassNotDerivable)
  let blocking = prerequisite_names_by_class(m: m, want: ClassOutstanding)
  if count(unanswerable) > 0 {
    StartabilityNotDerivable { unanswerable: unanswerable }
  } else {
    if count(blocking) > 0 {
      BlockedOnPrerequisites { blocking: blocking }
    } else {
      StartablePrerequisitesClear
    }
  }
}

fn startability_label(s: Startability) -> String {
  match s {
    StartablePrerequisitesClear => "startable"
    BlockedOnPrerequisites { blocking } =>
      concat("blocked on ", join_names(names: blocking))
    StartabilityNotDerivable { unanswerable } =>
      concat("startability not derivable -- unanswerable prerequisite: ", join_names(names: unanswerable))
  }
}

fn join_names(names: List<String>) -> String {
  fold(names, init: "", f: fn(acc, n) {
    if acc == "" { n } else { concat(acc, concat("; ", n)) }
  })
}

// ---------------------------------------------------------------------------------------------
// THE REPORT. The operator's question is "where are we", and the point of this entry point is that
// it is a question they can RUN rather than a paragraph someone maintains:
//
//   gunbc run --source-root dag --source-root src/v2 \
//     --entry dag/gunbc/compiler_frontend_program_status.dag --function where_are_we \
//     --arg out=/tmp/program-standing.txt
//
// Every line is recomputed from the populations above on every invocation. Nothing in it is stored,
// so there is no spelling in which this report can be stale with respect to the tree that produced
// it -- which is the whole difference between this and the status ledger it replaces.
//
// THE REPORT IS WRITTEN RATHER THAN RETURNED, for the reason `tools.emit_subject_clean_ratchet`
// already records at its own surface: `gunbc run` maps a returned value to an exit STATUS and has
// no value-printing verb, so a String-returning entry is refused by the host rather than printed.
//
// AND THE EXIT STATUS ANSWERS ONE QUESTION THAT IS NOT THE ONE A READER EXPECTS: could the standing
// be derived and written. A report full of OUTSTANDING and NotDerivable exits SUCCESS, because
// those ARE the answer and they belong in the artifact a human reads. What exits FAILURE is being
// unable to produce the report at all. Collapsing those would make the CI-visible channel say
// "the program is not done", which is a fact nobody needs a gate for, while hiding the one thing a
// gate can usefully catch -- that the instrument itself stopped working.
// ---------------------------------------------------------------------------------------------
data program_milestones: List<ProgramMilestone> = [
  SelfHostWholeCorpusPopulationDerived,
  SelfHostCargoPhaseEnrolled,
  SelfHostRatchetObservationEnrolled,
  SelfHostRatchetGateEnrolled,
  NamespaceWaveAdmissionEnrolled,
  NamespaceBaselineObservationComplete,
  NamespaceFirstSemanticWave,
  NamespaceFixForwardComplete,
  NamespaceGrammarRetired,
  SelfHostCorpusEmitsCleanly,
  SelfHostBehavioralEquivalenceReestablished,
  SelfHostEmitterProducesEveryRetainedArtifact,
  SelfHostSuccessorPromotionAdmitted,
  SelfHostSeedRetirement,
]

fn standing_detail(s: MilestoneStanding) -> String {
  match s {
    Clear { evidence } =>
      concat("no outstanding member of: ", evidence.subject)
    Outstanding { evidence } =>
      concat("outstanding: ", join_names(names: evidence.outstanding))
    NotDerivable { missing_instrument } =>
      concat("missing instrument: ", missing_instrument)
  }
}

fn milestone_report_line(m: ProgramMilestone) -> String {
  let s = milestone_status(m: m)
  concat("- [",
  concat(standing_class_label(c: standing_class(s: s)),
  concat("] ",
  concat(milestone_label(m: m),
  concat("\n    ", concat(standing_detail(s: s),
  concat("\n    ", startability_label(s: milestone_startability(m: m)))))))))
}

fn report() -> String {
  concat("compiler frontend program -- milestone standing, derived\n\n",
    fold(program_milestones, init: "", f: fn(acc, m) {
      concat(acc, concat(milestone_report_line(m: m), "\n"))
    })
  )
}

fn where_are_we(out: String) -> ProcessExit {
  if out == "" {
    exit_failure(reason: "where_are_we: --arg out=<path> is required — the standing is written, not printed")
  } else {
    if Filesystem.Write(path: out, content: report()).success {
      ExitSuccess
    } else {
      exit_failure(reason: concat("where_are_we: the standing was derived and could not be written to ", out))
    }
  }
}
