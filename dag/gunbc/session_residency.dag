module gunbc.session_residency


data session_residency_authority_disposition: std.disposition.Disposition = Terminal {
  reason: "Single authority for WHICH FLEET HOSTS RUN INTERACTIVE AGENT SESSIONS. It is a fleet-topology fact — where session containers are placed — and it is the fact that justifies charging a host a sessions reservation out of its RAM budget. Nothing declared it before; consumers inferred it from whatever nearby row happened to correlate."
}

data why_this_is_not_derived_from_the_build_cache_roster_note: String = "THE PROXY THIS REPLACES WAS ONE EDIT FROM CAUSING THE BUG IT WAS WRITTEN TO PREVENT, and the near-miss is the argument for the row. gunbc.ci_runner_placement decided whether a host owes a sessions reservation by asking whether gunbc.build_cache_instance.build_cache_desired_instances listed an InteractiveSessionCompiles instance for it. That correlated — srv1 and srv2 had session sccache instances, srv3 and srv4 did not — and correlation was the whole of it.\n\nOn 2026-08-06 the unit backing those instances was deleted from srv1 and srv2 as dead: ctrl-sccache.service had served 29MB in 45 days, held zero connections, and had zero cache writes in the preceding week, because session containers set SCCACHE_DIR to their own in-container path and never used it. The natural follow-up — dropping the now-meaningless session rows from the desired roster — would have silently stopped charging srv1 and srv2 their 20GiB sessions reservation. The conservation wall would then have admitted 7 slots on each, overcommitting them by roughly 17GiB, and returning true while doing it. That is precisely the defect the sessions charge was added to close, reintroduced by a tidy-up two files away, with no test able to see the connection.\n\nTHE REAL FACT IS RESIDENCY, NOT CACHING. Session containers consume host RAM whether or not a shared build cache exists for them: measured 2026-08-06, srv1 and srv2 were each running NINETEEN containers under sessions.slice while the session cache they supposedly depended on had been dead for weeks. A host's sessions reservation follows from sessions living there, and from nothing else."

type SessionResidency
  = HostsInteractiveSessions
  | NoInteractiveSessions

data session_residency_evidence_note: String = "THE VERDICT AND THE EVIDENCE FOR IT ARE DIFFERENT FACTS, and collapsing them is what made the first draft of this module unable to say what it knew. That draft answered only HostsInteractiveSessions | NoInteractiveSessions, so 'srv2 was counted running nineteen session containers this morning' and 'the operator states srv3 has none, because nobody could log in to check' produced the identical row. The asymmetry then had to live in prose beside the function, where no consumer and no witness can read it.\n\nIT MATTERS BECAUSE THE TWO NEGATIVE ARMS GRANT CAPACITY. A host classified session-free is charged no reservation and is admitted more runner slots, so the difference between a counted zero and an unobserved zero is the difference between a derived width and a borrowed premise — the same distinction gunbc.ci_floor_measurement enforces when it refuses to lend one host's overhead measurement to another. SessionsOperatorDeclaredAbsent is an override, honestly named as one; SessionsObservedAbsent is a receipt; and SessionsUnobserved is neither, which is why it charges."

type SessionResidencyEvidence
  = SessionsObservedPresent { observed_on: std.types.NonEmptyStr, container_count: Int }
  | SessionsObservedAbsent { observed_on: std.types.NonEmptyStr }
  | SessionsOperatorDeclaredAbsent { reason: String }
  | SessionsUnobserved { reason: String }

fn host_session_evidence(host: product.placement_supply.HostIdentity) -> SessionResidencyEvidence {
  if (host as String) == (operator_host_srv1 as String) {
    SessionsObservedPresent { observed_on: "2026-08-06", container_count: 19 }
  } else if (host as String) == (operator_host_srv2 as String) {
    SessionsObservedPresent { observed_on: "2026-08-06", container_count: 19 }
  } else if (host as String) == (operator_host_srv3 as String) {
    SessionsOperatorDeclaredAbsent {
      reason: "operator states srv3 carries no interactive sessions; NOT observed by the session that wrote this row, because the fleet-automation key is authorized for no user on srv3 (the B2 gap in gunbc.plans.fleet_subsumption_manual_gaps) and a direct login was refused. The fleet's own history agrees: srv3 was stood up through the modeled path as a CI host and has never carried a dashboard instance."
    }
  } else if (host as String) == (operator_host_srv4 as String) {
    SessionsOperatorDeclaredAbsent {
      reason: "operator states srv4 carries no interactive sessions; NOT observed, because srv4 failed host-key verification from this session. Same standing history as srv3 — stood up as a CI host through the modeled path, never a dashboard instance."
    }
  } else {
    SessionsUnobserved {
      reason: "host is not classified in gunbc.session_residency, so whether interactive session containers live on it is unknown rather than known to be no"
    }
  }
}

data session_residency_observation_note: String = "GROUNDING, with its asymmetry stated rather than smoothed over. The two POSITIVE rows are observed: on 2026-08-06 srv1 and srv2 each showed 19 container cgroups under /sys/fs/cgroup/sessions.slice/, counted directly on the hosts. The dashboard deploy job is also pinned to srv1 alone (.github/workflows/ci.yml deploy_dashboard_srv1, runs-on includes the srv1 label), which is consistent.\n\nThe two NEGATIVE rows are OPERATOR-DECLARED, not observed by the session that wrote this row: srv3 refused a direct key login (the fleet-automation key is authorized for no user there — the B2 gap in gunbc.plans.fleet_subsumption_manual_gaps) and srv4 failed host-key verification, so neither could be counted. The operator states srv3 and srv4 carry no sessions, and the fleet's own history agrees — both were stood up through the modeled path as CI hosts and neither has ever had a dashboard instance.\n\nWhy that asymmetry is acceptable HERE and would not be everywhere: the negative rows are the ones that GRANT capacity. A host wrongly marked NoInteractiveSessions is charged nothing and gets more runner slots, so an error in that direction overcommits — which means these two rows should be the first thing re-checked when srv3/srv4 become reachable, and they carry a dissolve-on saying so."

data session_residency_is_projected_note: String = "THE VERDICT IS A PROJECTION OF THE EVIDENCE, not a second hand-authored table beside it. Both were authored per host in the first draft, which is two representations of one fact (DESIGN section 2): flipping srv3 to observed-present without also flipping its verdict would have left the module asserting a contradiction that nothing could see. Here the only per-host authoring is the evidence, and the verdict cannot disagree with it because it is computed from it."

fn host_session_residency(host: product.placement_supply.HostIdentity) -> SessionResidency {
  match host_session_evidence(host: host) {
    SessionsObservedPresent { observed_on: _, container_count: _ } => HostsInteractiveSessions
    SessionsObservedAbsent { observed_on: _ } => NoInteractiveSessions
    SessionsOperatorDeclaredAbsent { reason: _ } => NoInteractiveSessions
    SessionsUnobserved { reason: _ } => HostsInteractiveSessions
  }
}

data unknown_host_defaults_to_hosting_sessions_note: String = "THE UNKNOWN ARM CHARGES RATHER THAN EXEMPTS, and it is the one place in this lane where the fail-closed direction is the OPPOSITE of the usual one. Everywhere else an unclassified host refuses — gunbc.ci_floor_measurement returns HostFixedOverheadUnmeasured, gunbc.runner_slot_allocation returns zero slots — because refusing to derive is safer than deriving from a borrowed premise.\n\nHere refusing is not available: this function answers a Bool-shaped question with no third state, and the consumer needs an answer to size a budget. So the question becomes which WRONG answer is survivable. Saying a host hosts sessions when it does not costs runner slots on that host — visible, recoverable, an under-use of hardware. Saying it does not when it does removes the largest non-runner claim from the conservation sum and overcommits the machine, which is the srv4 OOM shape and is not recoverable inside CI. The expensive direction is the safe default, so an unclassified host is charged until someone classifies it.\n\nA host that never appears here is also not enrolled in gunbc.fleet_intent and takes no fleet work at all, so this arm is unreachable in practice today. It is written for the enrollment that has not happened yet."

fn host_carries_interactive_sessions(host: product.placement_supply.HostIdentity) -> Bool {
  match host_session_residency(host: host) {
    HostsInteractiveSessions => true
    NoInteractiveSessions => false
  }
}

data observed_session_container_counts_note: String = "THE COUNTS RIDE ON THE EVIDENCE ARM AND NOWHERE ELSE. An earlier revision carried them a second time, in a standalone session_container_observations list beside the verdict table — two authorings of one measurement, which is the parallel ledger DESIGN section 2 forbids and which a witness had to police by cross-checking the two against each other. The count now exists only inside SessionsObservedPresent, so the observation and the classification it supports cannot disagree.\n\nThe number itself is a SNAPSHOT and is not the authority for anything: session containers come and go continuously, and 19 is what two hosts happened to be running at one moment on 2026-08-06. What it establishes is the qualitative fact this module carries — that sessions are resident on srv1 and srv2 in quantity — which is stable in a way the number is not. A consumer wanting a live count should observe it."

data session_residency_scaffold_bind_note: String = "A SCAFFOLD BIND IS A FORWARD REFERENCE, and getting that backwards cost this row two revisions. v2.lens.disposition_redundancy reads the bind as the SUCCESSOR: a scaffold whose bind target is present is redundant debt that must dissolve, and an absent target is the normal outstanding state. So binding to anything already in this module — the observation list, or the count function below — declares the debt paid while it plainly is not.\n\nThe first draft got the direction right by accident and the name wrong: session_container_observations_srv3_srv4 named nothing anyone had planned to author, which is a forward reference to a fiction rather than to a successor.\n\nWHAT ACTUALLY CLOSES THIS is a MODELED PRODUCER of session-residency observations — the same thing gunbc.host_swap_backing is waiting for and refuses to fake, on the same reasoning: a probe run by a person is not a producer, and hand-entering the result would rebuild the parallel ledger rather than close the gap. session_residency_observed_producer is that successor, deliberately not authored here, and when it exists srv3 and srv4 stop being SessionsOperatorDeclaredAbsent and this scaffold dissolves. operator_declared_absent_host_count is the observable proxy for the same condition — 2 today, 0 when closed — and the witness pins it; it is NOT the bind, precisely because it exists."

fn host_absence_is_operator_declared(host: product.placement_supply.HostIdentity) -> Bool {
  match host_session_evidence(host: host) {
    SessionsOperatorDeclaredAbsent { reason: _ } => true
    SessionsObservedPresent { observed_on: _, container_count: _ } => false
    SessionsObservedAbsent { observed_on: _ } => false
    SessionsUnobserved { reason: _ } => false
  }
}

fn operator_declared_absent_host_count() -> Int {
  count(
    filter(
      [operator_host_srv1, operator_host_srv2, operator_host_srv3, operator_host_srv4],
      h => host_absence_is_operator_declared(host: h)
    )
  )
}

data session_residency_negative_rows_dissolve_on: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.host_effect",
    decl_name: "HostEffectTransport",
    field: WholeDeclaration,
  }
}

// Interim transport gate — NOT the scaffold successor. session_residency_observed_producer (cgroup
// census via host_effect_apply) is the real successor named in session_residency_scaffold_bind_note;
// this fn only gates on shell transport and refuses until that lands.

fn session_residency_shell_gated_census(host: product.placement_supply.HostIdentity) -> SessionResidencyEvidence {
  match fleet_shell_transport_observation(host: host) {
    ShellTransportSucceeded { observed_on: _, principal: _, detail: _ } =>
      SessionsUnobserved {
        reason: "shell transport available but sessions.slice container census has no host_effect producer yet; dissolve-on HostEffectTransport cgroup walk",
      }
    ShellTransportReachRefused { observed_on: _, principal: _, detail: d, gap: _ } =>
      SessionsUnobserved {
        reason: concat("session cgroup census refused: shell transport failed: ", d as String),
      }
    ShellTransportUnobserved { reason: r } =>
      SessionsUnobserved { reason: concat("session cgroup census unobserved: ", r) }
  }
}
