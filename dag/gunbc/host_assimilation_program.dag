module gunbc.host_assimilation_program

import std.types { String, NonEmptyStr, Bool, Int, List }
import gunbc.host_standup {
  HostStandupStep,
  HostStandupPhase,
  Prefix,
  Assimilation,
  HostStandupPrefixPhase,
  HostStandupAssimilationPhase,
  BmcCredentialConverge,
  OsInstallMechanismResolved,
  OsInstallActuated,
  HostConvergePolicyDerived,
  HostIdentityConverge,
  ReachSecretsNetwork,
  RunnerDeploySlot,
  BuildCacheProvision,
  ComputeFabricEnroll,
  GreenPlaceReadiness,
  SessionPlacementEnrollment,
  StandupAssimilationComplete,
  host_standup_spine,
  GreenPlacePinCoherentWitness,
  GreenPlaceFromGunbcGate,
  GreenPlacePinRefused,
  GreenPlacePinGap,
  green_place_pin_coherent_satisfied,
  host_standup_p3_green_place_input_witness,
  host_standup_p5_default_green_place_gate_verdict,
  host_standup_p5_green_place_noop_gate_authority,
  host_standup_p5_green_place_marker_gate_authority,
  host_standup_p5_desired_pin_authority,
  host_standup_p3_gunbc_pinned_tree_landed,
  host_standup_p3_gunbc_pinned_tree_landing_gate,
}
import product.placement_supply { HostIdentity }

data host_assimilation_program_note: String = "WHY THIS EXISTS: host_standup_spine is ONE universal list, and gunbc.host_phase_status crossed every enrolled host with all of it. That was correct while every enrolled host was the same kind of thing -- srv1 through srv4 are Ampere Altra CI runner hosts, provisioned through BMC and virtual media, hosting GitHub Actions runner slots and a build cache. It stops being correct the moment a host of a DIFFERENT KIND is enrolled: two NVIDIA DGX Spark inference appliances (srv5, srv6) have no BMC to converge, no virtual-media OS install, no runner user, no Actions slots and no build cache, so crossing them with the universal spine would manufacture obligations that can never be satisfied and can never honestly be marked converged. A fleet-completeness number computed over invented obligations is worse than no number. THE CORRECTION IS PROGRAM SCOPING, NOT AN APPLICABILITY VERDICT: an Applicable-or-NotApplicable arm on the cell would keep the false cells and label them, which is the parallel-representation shape (DESIGN section 3) and leaves every consumer to remember to filter. A host's participation instead SELECTS which obligations exist at all, so an obligation that does not apply is not a cell with a label -- it is not a cell."

data host_participation_axis_note: String = "Participation is what a host DOES for the fleet, and it is a LIST because the axes are independent rather than exclusive: nothing in the model forbids a host that both runs CI and serves inference, and a coproduct would have forced a third fused variant the first time that happened. It is deliberately NOT a host KIND enum (AltraRunner | SparkAppliance) -- kind is hardware, participation is role, and binding obligations to hardware would mean a future Altra dedicated to serving inherits BMC obligations because of what it is made of rather than what it is for. srv5 and srv6 stay opaque host identities for the same reason: the identity survives a role change or a hardware replacement, and DGX Spark remains a product fact recorded elsewhere, never part of the host's permanent name."

type FleetParticipation
  = CiRunnerParticipation
  | InferenceServingParticipation

fn fleet_participation_label(p: FleetParticipation) -> String {
  match p {
    CiRunnerParticipation => "ci-runner"
    InferenceServingParticipation => "inference-serving"
  }
}

fn fleet_participation_eq(a: FleetParticipation, b: FleetParticipation) -> Bool {
  fleet_participation_label(p: a) == fleet_participation_label(p: b)
}

type HostEnrollmentIntent {
  host: HostIdentity
  participation: List<FleetParticipation>
}

data host_phase_participation_classification_note: String = "The one place a standup phase is bound to the participations that require it, kept HERE rather than as a field on HostStandupStep on purpose. Adding the field would reshape fourteen rows in host_standup.dag, which is load-bearing, and that module's own gap-ledger note has already ruled that its row-reshaping change stays separable from its status-axis change so the two are reviewable apart -- this is the third change in that neighbourhood and it obeys the same ruling. The match below is EXHAUSTIVE over both closed phase enums, so a newly added phase does not silently default into or out of any program: the compiler refuses until its participations are stated. That is the construction half (DESIGN section 5) -- there is no unclassified phase to detect after the fact, because an unclassified phase does not compile."

data host_phase_prefix_participation_note: String = "Every PREFIX phase is CI-runner only. BMC credential convergence and virtual-media OS installation are the Ampere Altra provisioning path and have no analogue on an appliance that self-provisions through its own first-boot flow; HostConvergePolicyDerived is grouped with them because the policy it derives is that installation path's policy. A DGX Spark absolutely HAS arrival obligations -- physical binding, network convergence, baseline observation -- but they are its OWN obligations, authored where that arrival is modeled, and inheriting a differently-shaped host's provisioning steps because they sound generic is precisely the false-obligation defect this module exists to prevent."

fn prefix_phase_participations(p: HostStandupPrefixPhase) -> List<FleetParticipation> {
  match p {
    BmcCredentialConverge => [CiRunnerParticipation]
    OsInstallMechanismResolved => [CiRunnerParticipation]
    OsInstallActuated => [CiRunnerParticipation]
    HostConvergePolicyDerived => [CiRunnerParticipation]
  }
}

data host_phase_assimilation_participation_note: String = "HostIdentityConverge and ReachSecretsNetwork are shared: every enrolled host needs a converged identity and an admitted reach path whatever it does for the fleet. ComputeFabricEnroll is shared because both kinds offer capacity, though of different shapes -- hardware threads for a runner, an inference envelope for an appliance -- and that is the fit-predicate work downstream, not a reason to fork the phase. StandupAssimilationComplete is shared because every program needs a terminal obligation. RunnerDeploySlot, BuildCacheProvision, GreenPlaceReadiness and SessionPlacementEnrollment are CI-runner only: Actions runner slots, an sccache build cache, dashboard green-place pinning and session placement are all facts about executing CI work, and an inference appliance that acquired them would be competing with its own serving."

fn assimilation_phase_participations(p: HostStandupAssimilationPhase) -> List<FleetParticipation> {
  match p {
    HostIdentityConverge => [CiRunnerParticipation, InferenceServingParticipation]
    ReachSecretsNetwork => [CiRunnerParticipation, InferenceServingParticipation]
    RunnerDeploySlot => [CiRunnerParticipation]
    BuildCacheProvision => [CiRunnerParticipation]
    ComputeFabricEnroll => [CiRunnerParticipation, InferenceServingParticipation]
    GreenPlaceReadiness => [CiRunnerParticipation]
    SessionPlacementEnrollment => [CiRunnerParticipation]
    StandupAssimilationComplete => [CiRunnerParticipation, InferenceServingParticipation]
  }
}

fn host_phase_participations(phase: HostStandupPhase) -> List<FleetParticipation> {
  match phase {
    Prefix { phase: p } => prefix_phase_participations(p: p)
    Assimilation { phase: p } => assimilation_phase_participations(p: p)
  }
}

fn participation_list_contains(ps: List<FleetParticipation>, wanted: FleetParticipation) -> Bool {
  fold_list(
    xs: ps,
    empty: false,
    cons: fn(acc, p) { if acc { true } else { fleet_participation_eq(a: p, b: wanted) } }
  )
}

fn step_serves_participation(step: HostStandupStep, wanted: FleetParticipation) -> Bool {
  participation_list_contains(ps: host_phase_participations(phase: step.phase), wanted: wanted)
}

fn step_serves_any(step: HostStandupStep, wanted: List<FleetParticipation>) -> Bool {
  fold_list(
    xs: wanted,
    empty: false,
    cons: fn(acc, w) { if acc { true } else { step_serves_participation(step: step, wanted: w) } }
  )
}

type HostAssimilationProgram {
  identity: NonEmptyStr
  steps: List<HostStandupStep>
}

data host_assimilation_program_derivation_note: String = "The program is DERIVED from the spine by participation, never a second hand-authored step list. A hand-authored inference program would be a parallel representation of the spine and would drift the first time a phase changed, which is the defect the host_standup gap ledger already records against itself. Deriving also gives the refactor its identity guarantee for free: a host enrolled for CI participation alone selects every step in the spine, because every phase in the spine today exists to serve runner hosts, so srv1 through srv4 keep byte-identical cells rather than merely similar ones. That identity is asserted by an executing witness rather than argued here."

fn assimilation_program_for(intent: HostEnrollmentIntent) -> HostAssimilationProgram {
  HostAssimilationProgram {
    identity: host_enrollment_program_identity(intent: intent),
    steps: filter(host_standup_spine, s => step_serves_any(step: s, wanted: intent.participation)),
  }
}

fn host_enrollment_program_identity(intent: HostEnrollmentIntent) -> NonEmptyStr {
  join(
    map(intent.participation, p => fleet_participation_label(p: p)),
    "+"
  ) as NonEmptyStr
}

fn program_step_count(program: HostAssimilationProgram) -> Int {
  program.steps.length()
}

data ci_runner_program_identity_note: String = "The CI-runner program is the identity anchor for the refactor: it must select the WHOLE spine, because every phase authored to date exists to serve runner hosts. If a later phase is added that no participation claims, or one that CI does not claim, this equality breaks and the witness reds -- which is the intended alarm, not a maintenance burden. It is the discriminating control that distinguishes 'the refactor preserved srv1-srv4 exactly' from 'the refactor produced a plausible-looking matrix'."

data ci_runner_enrollment_participation: List<FleetParticipation> = [CiRunnerParticipation]

data inference_serving_enrollment_participation: List<FleetParticipation> = [InferenceServingParticipation]

type AssimilationCompletionObligation
  = SpinePhaseFinished { label: String }
  | NodeRegistration
  | ResourcesPresent
  | GreenPlacePinGateCoherent
  | RunnerSlotHealthy

type AssimilationObligationWitness
  = ObligationSatisfied
  | ObligationRefused { reason: String }
  | ObligationGap { interim_realization: String }
  | GreenPlaceWitness { w: GreenPlacePinCoherentWitness }

type AssimilationObligationRow {
  obligation: AssimilationCompletionObligation
  witness: AssimilationObligationWitness
}

type AssimilationCompleteGate {
  obligations: List<AssimilationObligationRow>
}

type AssimilationCompleteVerdict
  = AssimilationComplete
  | AssimilationIncomplete { obligation: AssimilationCompletionObligation, reason: String }

data assimilation_completion_gate_note: String = "HOST-1: the completion gate is a DERIVED LIST of obligations, not a fixed product of four named fields. A fixed product silently omits new spine prerequisites -- BuildCacheProvision at P1b never entered the old AND(node_registered, resources_present, green_place_pin_coherent, runner_slot_healthy) gate, so adding a phase to the spine did not add a completion obligation until someone edited the product by hand. The roster is derived from the assimilation program: every prerequisite spine step (all program steps before StandupAssimilationComplete) plus participation-scoped extrinsic checks that are not spine phases (node registration, resources-present) and sub-checks that are stricter than phase-finished (green-place gunbc gate verdict, runner-slot health). An inference enrollment derives fewer obligations because its program is smaller; a CI enrollment derives the whole spine plus extrinsic checks. Adding a phase to the spine and classifying it in the participation tables automatically extends the roster -- construction, not validation."

fn standup_step_is_terminal(step: HostStandupStep) -> Bool {
  match step.phase {
    Assimilation { phase: StandupAssimilationComplete } => true
    Prefix { phase: _ } => false
    Assimilation { phase: _ } => false
  }
}

fn ci_runner_extrinsic_completion_obligations(participation: List<FleetParticipation>) -> List<AssimilationCompletionObligation> {
  if participation_list_contains(ps: participation, wanted: CiRunnerParticipation) {
    [NodeRegistration, ResourcesPresent, GreenPlacePinGateCoherent, RunnerSlotHealthy]
  } else {
    []
  }
}

fn assimilation_completion_obligations_for(intent: HostEnrollmentIntent) -> List<AssimilationCompletionObligation> {
  let program = assimilation_program_for(intent: intent)
  let spine_obligations = map(
    filter(program.steps, s => !standup_step_is_terminal(step: s)),
    s => SpinePhaseFinished { label: s.label as String }
  )
  spine_obligations ++ ci_runner_extrinsic_completion_obligations(participation: intent.participation)
}

fn assimilation_completion_obligation_count(intent: HostEnrollmentIntent) -> Int {
  assimilation_completion_obligations_for(intent: intent).length()
}

fn obligation_witness_satisfied(obligation: AssimilationCompletionObligation, witness: AssimilationObligationWitness) -> Bool {
  match witness {
    ObligationSatisfied => true
    ObligationRefused { reason: _ } => false
    ObligationGap { interim_realization: _ } => false
    GreenPlaceWitness { w: pin } =>
      match obligation {
        GreenPlacePinGateCoherent => green_place_pin_coherent_satisfied(w: pin)
        SpinePhaseFinished { label: _ } => false
        NodeRegistration => false
        ResourcesPresent => false
        RunnerSlotHealthy => false
      }
  }
}

fn green_place_pin_obligation_failure(w: GreenPlacePinCoherentWitness) -> AssimilationCompleteVerdict? {
  match w {
    GreenPlaceFromGunbcGate { gate_verdict: false, noop_satisfied_authority: _, marker_satisfied_authority: _, desired_pin_authority: _ } =>
      Present {
        value: AssimilationIncomplete {
          obligation: GreenPlacePinGateCoherent,
          reason: "host_standup:P5:green_place_pin_coherent: gunbc gate verdict false or unread — fail-closed, no pin re-derivation in spine"
        }
      }
    GreenPlaceFromGunbcGate { gate_verdict: true, noop_satisfied_authority: _, marker_satisfied_authority: _, desired_pin_authority: _ } => Absent
    GreenPlacePinRefused { reason: r } =>
      Present { value: AssimilationIncomplete { obligation: GreenPlacePinGateCoherent, reason: r } }
    GreenPlacePinGap { interim_realization: path } =>
      Present {
        value: AssimilationIncomplete {
          obligation: GreenPlacePinGateCoherent,
          reason: concat("host_standup:P5:gap-refused:", path)
        }
      }
  }
}

fn obligation_row_failure(row: AssimilationObligationRow) -> AssimilationCompleteVerdict? {
  match row.obligation {
    GreenPlacePinGateCoherent =>
      match row.witness {
        GreenPlaceWitness { w: pin } => green_place_pin_obligation_failure(w: pin)
        ObligationSatisfied => Absent
        ObligationRefused { reason: r } =>
          Present { value: AssimilationIncomplete { obligation: row.obligation, reason: r } }
        ObligationGap { interim_realization: path } =>
          Present {
            value: AssimilationIncomplete {
              obligation: row.obligation,
              reason: concat("host_standup:P5:gap-refused:", path)
            }
          }
      }
    SpinePhaseFinished { label: _ } | NodeRegistration | ResourcesPresent | RunnerSlotHealthy =>
      match row.witness {
        ObligationSatisfied => Absent
        ObligationRefused { reason: r } =>
          Present { value: AssimilationIncomplete { obligation: row.obligation, reason: r } }
        ObligationGap { interim_realization: path } =>
          Present {
            value: AssimilationIncomplete {
              obligation: row.obligation,
              reason: concat("host_standup:P5:gap-refused:", path)
            }
          }
        GreenPlaceWitness { w: _ } =>
          Present {
            value: AssimilationIncomplete {
              obligation: row.obligation,
              reason: "host_standup:P5:witness-shape-mismatch"
            }
          }
      }
  }
}

fn assimilation_complete_first_failure(gate: AssimilationCompleteGate) -> AssimilationCompleteVerdict? {
  fold_list(
    xs: gate.obligations,
    empty: Absent,
    cons: fn(acc, row) {
      if match acc {
        Present { value: _ } => true
        Absent => false
      } {
        acc
      } else {
        match obligation_row_failure(row: row) {
          Present { value: v } => Present { value: v }
          Absent => Absent
        }
      }
    }
  )
}

fn assimilation_complete(gate: AssimilationCompleteGate) -> AssimilationCompleteVerdict {
  match assimilation_complete_first_failure(gate: gate) {
    Present { value: v } => v
    Absent => AssimilationComplete
  }
}

fn assimilation_complete_all_satisfied(gate: AssimilationCompleteGate) -> Bool {
  fold_list(
    xs: gate.obligations,
    empty: true,
    cons: fn(acc, row) =>
      acc && obligation_witness_satisfied(obligation: row.obligation, witness: row.witness)
  )
}

fn default_unsatisfied_obligation_witness(obligation: AssimilationCompletionObligation) -> AssimilationObligationWitness {
  match obligation {
    GreenPlacePinGateCoherent => GreenPlaceWitness { w: host_standup_p3_green_place_input_witness() }
    NodeRegistration => ObligationGap { interim_realization: "ctrl:node_registry.mjs" }
    ResourcesPresent => ObligationGap { interim_realization: "ctrl:resources-present-unmodeled" }
    RunnerSlotHealthy => ObligationGap { interim_realization: "gunbc.runner_slot_enforcement until P1 converged" }
    SpinePhaseFinished { label: _ } => ObligationGap { interim_realization: "host_standup:phase-not-finished" }
  }
}

fn default_obligation_row(obligation: AssimilationCompletionObligation) -> AssimilationObligationRow {
  AssimilationObligationRow {
    obligation: obligation,
    witness: default_unsatisfied_obligation_witness(obligation: obligation),
  }
}

fn host_standup_assimilation_gate_unsatisfied(intent: HostEnrollmentIntent) -> AssimilationCompleteGate {
  AssimilationCompleteGate {
    obligations: map(
      assimilation_completion_obligations_for(intent: intent),
      o => default_obligation_row(obligation: o)
    ),
  }
}

data default_ci_assimilation_intent: HostEnrollmentIntent = HostEnrollmentIntent {
  host: operator_host_srv3,
  participation: ci_runner_enrollment_participation,
}

fn host_standup_default_assimilation_gate_unsatisfied() -> AssimilationCompleteGate {
  host_standup_assimilation_gate_unsatisfied(intent: default_ci_assimilation_intent)
}

fn host_standup_p3_fail_closed_blocks_complete() -> Bool {
  !host_standup_p3_gunbc_pinned_tree_landed
    && match assimilation_complete(gate: host_standup_default_assimilation_gate_unsatisfied()) {
      AssimilationIncomplete { obligation: GreenPlacePinGateCoherent, reason: r } =>
        string_contains(s: r, pattern: "#5948")
      AssimilationComplete => false
      AssimilationIncomplete { obligation: _, reason: _ } => true
    }
}

fn obligation_row_satisfied(obligation: AssimilationCompletionObligation) -> AssimilationObligationRow {
  AssimilationObligationRow {
    obligation: obligation,
    witness: ObligationSatisfied,
  }
}
