module gunbc.branch_protection

import extdeps.github.branch_protection {
  BranchProtectionState, RequiredStatusChecks, PushAllowance
}
import std.realization_schedule { string_list_eq }

data branch_protection_authority_note: String = "Single .dag authority for gunb-ai/gunbc main branch protection (ci-chores lane, operator-directed 2026-07-23: 'configuring branch protection from dag'). The DESIRED state below is the substrate authority; a converge host-effect (gunbc.branch_protection_converge, audit-only until armed) reconciles GitHub's live protection to match it. This is the mechanism that makes the chore consumer's heal-push LEGITIMATE BY DECLARATION: whether the heal bot may push to a protected main is push_allowance.apps below, not a GitHub-settings click. CAPTURE-THEN-OWN (fail-closed, DESIGN §5): the literal values here are the PROPOSED target and MUST be reconciled against a live BranchProtection.Get before the converge is armed — arming with an unverified desired state could overwrite real settings, so branch_protection_converge_armed defaults false (audit-only: report drift, write nothing). POLICY BOUNDARIES not decided by this PR: required_status_checks.contexts (whether `ci` becomes a REQUIRED merge check) is the ts-merge-gate decision — left as the proposed target but inert while audit-only; required_approving_review_count is GitHub-native reviews, DISTINCT from the dashboard's 2-approval api-review gate (the dashboard gate is not GitHub-native, so this native count may legitimately differ from 2 — capture the live value). The load-bearing field for THIS lane is push_allowance.apps containing the heal identity."

data heal_bot_app_slug: String = "gunbai-bot"

data main_branch_protection_desired: BranchProtectionState = BranchProtectionState {
  required_status_checks: RequiredStatusChecks {
    strict: false,
    contexts: ["ci"]
  },
  enforce_admins: false,
  required_approving_review_count: 2,
  push_restricted: true,
  push_allowance: PushAllowance {
    users: [],
    teams: [],
    apps: [heal_bot_app_slug]
  }
}

type ProtectionReconcile
  = ProtectionInSync
  | ProtectionDrifted { needs: BranchProtectionState }
  | ProtectionObservedUnknown { reason: String }

fn required_checks_eq(a: RequiredStatusChecks, b: RequiredStatusChecks) -> Bool {
  (a.strict == b.strict) && string_list_eq(left: a.contexts, right: b.contexts)
}

fn push_allowance_eq(a: PushAllowance, b: PushAllowance) -> Bool {
  string_list_eq(left: a.users, right: b.users)
    && string_list_eq(left: a.teams, right: b.teams)
    && string_list_eq(left: a.apps, right: b.apps)
}

fn protection_eq(a: BranchProtectionState, b: BranchProtectionState) -> Bool {
  required_checks_eq(a: a.required_status_checks, b: b.required_status_checks)
    && (a.enforce_admins == b.enforce_admins)
    && (a.required_approving_review_count == b.required_approving_review_count)
    && (a.push_restricted == b.push_restricted)
    && push_allowance_eq(a: a.push_allowance, b: b.push_allowance)
}

fn reconcile_branch_protection_observed(
  desired: BranchProtectionState,
  observed: BranchProtectionState
) -> ProtectionReconcile {
  if protection_eq(a: desired, b: observed) {
    ProtectionInSync
  } else {
    ProtectionDrifted { needs: desired }
  }
}

fn reconcile_branch_protection(
  desired: BranchProtectionState,
  observed_ok: Bool,
  observed: BranchProtectionState,
  observe_error: String
) -> ProtectionReconcile {
  if observed_ok {
    reconcile_branch_protection_observed(desired: desired, observed: observed)
  } else {
    ProtectionObservedUnknown { reason: observe_error }
  }
}

data branch_protection_converge_armed: Bool = false

data branch_protection_converge_arm_note: String = "AUDIT-ONLY frontier (DESIGN §5 construction-over-validation, and the no-escape-hatch rule). While false, the converge REPORTS drift (ProtectionDrifted is surfaced, counted) and writes NOTHING — no BranchProtection.Update is dispatched. Flipping to true is the operator-gated arm: it requires (a) main_branch_protection_desired reconciled against a live Get (capture-then-own), and (b) the heal identity's token provisioned. Arming is a DECLARED authority change, not a silent toggle — a converge that PUTs is one reviewable line, and the audit-only default means an unverified desired state can never overwrite live protection."

fn heal_bot_may_push(desired: BranchProtectionState) -> Bool {
  fold(desired.push_allowance.apps, init: false, f: fn(acc, app) { acc || (app == heal_bot_app_slug) })
}
