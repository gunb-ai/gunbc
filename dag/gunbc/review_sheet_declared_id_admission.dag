module gunbc.review_sheet_declared_id_admission

import std.types { NonEmptyStr, String, Bool, List }
import std.resources { Network }
import extdeps.transports.rest {
  RestReadExchange,
  RestExchangeSucceeded,
  RestExchangeStatusRefused,
  RestExchangeUnreached,
  RestExchangeUndecodable,
  RestExchangeCommitAmbiguous,
  classify_rest_outcome,
}
import extdeps.google.drive
import extdeps.google.drive { DriveFile, google_sheet_mime_type }
import gunbc.review_sheet_identity {
  ReviewSheetIdentitySubject,
  LegacyFileSelection,
  ReviewSheetIdentityDisposition,
  ReviewSheetIdentityAbsent,
  ReviewSheetSingleLineage,
  ReviewSheetLegacyOnlyLineage,
  ReviewSheetConflictingLineages,
  CurrentMarkerObservedLegacyExtentUnresolved,
  ReviewSheetIdentityUnreadable,
  LegacyExtentVerdict,
  LegacyExtentSettledEmpty,
  LegacyExtentFound,
  LegacyExtentUnsettled,
}
import gunbc.review_sheet_legacy_extent_producer {
  OperatorLegacyDeclaration,
  OperatorDeclaredLegacyAbsent,
  OperatorDeclaredLegacyFileSelected,
  OperatorLegacyDeclarationUnavailable,
}

// THE DECLARED-ID ADMISSION. An operator may name the file that is really the review sheet, and
// this module decides whether that naming may be acted on. It is the only consumer of
// gunbc.review_sheet_identity's LegacyFileSelection, and it exists because a selection is not
// evidence: selecting file A establishes which file the operator selected and nothing else, so it
// has to be reconciled against what was actually observed before anything adopts it.
//
// FOUR THINGS ARE RECONCILED, AND THE ORDER IS THE CHEAP-REFUSAL-FIRST ORDER. The intended SUBJECT,
// because a selection written about another drive or another marker generation is not about this
// one; the STANDING, because a selection is an adjudication and there has to be something to
// adjudicate; a CONTRADICTING OBSERVATION, because naming a file no observation returned is not a
// choice between lineages but an assertion about a file nobody saw; and only then an exact
// FILE-BY-ID PREFLIGHT, which costs a request and is therefore last.
//
// THE REFUSAL THIS MODULE EXISTS FOR IS THE ONE PEOPLE WILL WANT TO WIDEN. A selection beside an
// UNRESOLVED extent stays unresolved. It is tempting to read the selection as settling the
// question -- the operator has looked, after all -- but the operator has said which file they
// choose, not that no other lineage exists, and the whole incident this lane closes is a
// conclusion assigned to a reading that had not established it. Admitting here would be that
// failure with a human's name on it.

type DeclaredIdCandidacy
  = SelectionStandsForAdjudication { file_id: NonEmptyStr }
  | SelectionNotOffered
  | SelectionRejected { cause: NonEmptyStr }

type DeclaredIdAdmission
  = DeclaredIdAdmitted { file_id: NonEmptyStr }
  | DeclaredIdRefused { cause: NonEmptyStr }
  | NoDeclaredIdOffered

// AN ABSENCE DECLARATION IS NOT A SELECTION AND IS NOT THIS MODULE'S BUSINESS. It has its own
// consumer -- it becomes LegacyExtentAbsentByOperator and settles the extent -- so it arrives here
// as "nothing was selected" rather than as a refusal, and a run carrying one takes the ordinary
// converge path.
fn declared_id_candidacy(
  subject: ReviewSheetIdentitySubject,
  disposition: ReviewSheetIdentityDisposition,
  declaration: OperatorLegacyDeclaration,
) -> DeclaredIdCandidacy {
  match declaration {
    OperatorLegacyDeclarationUnavailable { cause: _ } => SelectionNotOffered
    OperatorDeclaredLegacyAbsent { subject: _, basis: _ } => SelectionNotOffered
    OperatorDeclaredLegacyFileSelected { selection: sel } =>
      if subject == sel.subject {
        selection_against_standing(selection: sel, disposition: disposition)
      } else {
        SelectionRejected {
          cause: join(
            [
              "the operator declaration selects file ",
              sel.file_id as String,
              " for a different identity subject, so it establishes nothing about this one; a declaration that outlives its subject still reads as authoritative, which is why the subject is carried in its content",
            ],
            "",
          ) as NonEmptyStr,
        }
      }
  }
}

// WHICH STANDINGS ADMIT A SELECTION AT ALL. Only one does: two or more lineages were OBSERVED and
// an operator is choosing between them. Everything else either has nothing to adjudicate or has
// not established enough for a choice to mean anything.
fn selection_against_standing(
  selection: LegacyFileSelection,
  disposition: ReviewSheetIdentityDisposition,
) -> DeclaredIdCandidacy {
  match disposition {
    ReviewSheetConflictingLineages { current_file_ids: current, legacy: legacy } =>
      if lineage_ids_name(ids: current, file_id: selection.file_id)
        || lineage_ids_name(ids: settled_legacy_ids(legacy: legacy), file_id: selection.file_id) {
        SelectionStandsForAdjudication { file_id: selection.file_id }
      } else {
        SelectionRejected {
          cause: join(
            [
              "the operator declaration selects file ",
              selection.file_id as String,
              ", which no observation saw: neither the current-marker observation [",
              join(current, ", "),
              "] nor the superseded-marker one, ",
              legacy_observed_ids_text(legacy: legacy),
              ". Choosing between observed lineages is an adjudication; naming a file no observation returned is an assertion this converge cannot check against anything",
            ],
            "",
          ) as NonEmptyStr,
        }
      }
    CurrentMarkerObservedLegacyExtentUnresolved { file_id: f, cause: c } =>
      SelectionRejected {
        cause: join(
          [
            "the operator declaration selects file ",
            selection.file_id as String,
            " while the superseded-marker extent is unresolved (",
            c as String,
            "), and a current-marked file ",
            f as String,
            " was found. A selection says which file the operator chose, never that no other lineage exists, so it cannot settle an extent no reading settled. Declare the extent absent for this subject if that is what you can establish",
          ],
          "",
        ) as NonEmptyStr,
      }
    ReviewSheetIdentityUnreadable { cause: c } =>
      SelectionRejected {
        cause: join(
          [
            "the operator declaration selects file ",
            selection.file_id as String,
            " against an identity that could not be read: ",
            c as String,
            ". A selection is an adjudication between observed lineages and there is no observation here to adjudicate",
          ],
          "",
        ) as NonEmptyStr,
      }
    ReviewSheetIdentityAbsent =>
      SelectionRejected {
        cause: join(
          [
            "the operator declaration selects file ",
            selection.file_id as String,
            ", and both marker generations were read as holding nothing. The selection and the observations contradict each other, and a declaration does not overrule a settled reading",
          ],
          "",
        ) as NonEmptyStr,
      }
    ReviewSheetSingleLineage { file_id: f } =>
      selection_against_sole_observed_file(selection: selection, observed: f)
    ReviewSheetLegacyOnlyLineage { file_id: f } =>
      selection_against_sole_observed_file(selection: selection, observed: f)
  }
}

// ONE LINEAGE WAS OBSERVED, SO A SELECTION EITHER AGREES WITH IT OR CONTRADICTS IT. Agreement is
// admitted and is a no-op in substance -- the converge would have adopted that file anyway -- and
// the arm exists so an operator who declares the id they can see is not refused for saying
// something true. Disagreement refuses: the declaration names a file the observation did not
// return, and preferring the declaration there is exactly how a converge comes to act on a file
// nobody looked at.
fn selection_against_sole_observed_file(
  selection: LegacyFileSelection,
  observed: NonEmptyStr,
) -> DeclaredIdCandidacy {
  if (selection.file_id as String) == (observed as String) {
    SelectionStandsForAdjudication { file_id: selection.file_id }
  } else {
    SelectionRejected {
      cause: join(
        [
          "the operator declaration selects file ",
          selection.file_id as String,
          " while the only observed review sheet is ",
          observed as String,
          "; the declaration contradicts the observation rather than adjudicating between lineages",
        ],
        "",
      ) as NonEmptyStr,
    }
  }
}

// THE OBSERVED POPULATION A SELECTION MAY CHOOSE FROM, derived from the verdict rather than from a
// second reading of the evidence. An UNSETTLED legacy side contributes no ids, which is correct and
// is the property that keeps the conflict arm from admitting a file the superseded search never
// returned.
fn lineage_ids_name(ids: List<String>, file_id: NonEmptyStr) -> Bool {
  count(filter(ids, i => i == (file_id as String))) > 0
}

// THE IDS THE SUPERSEDED SIDE ACTUALLY RETURNED, and an UNSETTLED side returns none. That is the
// property keeping the conflict arm from admitting a file the superseded search never saw: an
// unread generation is not a source of candidates, and treating it as one would let a selection
// be justified by the very silence this lane exists to refuse.
fn settled_legacy_ids(legacy: LegacyExtentVerdict) -> List<String> {
  match legacy {
    LegacyExtentFound { file_ids: ids } => ids
    LegacyExtentSettledEmpty => []
    LegacyExtentUnsettled { cause: _ } => []
  }
}

// THE TWO SIDES ARE NAMED SEPARATELY IN THE REFUSAL RATHER THAN CONCATENATED, because an operator
// reading it needs to know WHICH observation failed to return their file, and because "the
// superseded side was unread" is a different sentence from "the superseded side returned nothing".
fn legacy_observed_ids_text(legacy: LegacyExtentVerdict) -> String {
  match legacy {
    LegacyExtentFound { file_ids: ids } => join(["which returned [", join(ids, ", "), "]"], "")
    LegacyExtentSettledEmpty => "which was declared to hold nothing"
    LegacyExtentUnsettled { cause: c } =>
      join(["which was never settled (", c as String, ") and so offers no file to select"], "")
  }
}

// ── THE EXACT FILE-BY-ID PREFLIGHT ────────────────────────────────────────────────────────────

type DeclaredIdPreflight
  = PreflightFileRead { file: DriveFile }
  | PreflightFileUnreadable { cause: NonEmptyStr }

// A SEARCH AND AN EXACT READ ARE DIFFERENT QUESTIONS, which is why this preflight is a GetFile and
// not another ListFiles. The search answers what matches a query this client can write; the read
// answers whether this id names a file this credential can actually open. The selection is an id,
// so the read is the question that matches it.
fn preflight_file_by_id(file_id: NonEmptyStr) -> DeclaredIdPreflight uses net: Network {
  let read = drive.Files.GetFile(file_id: file_id as String)
  match classify_rest_outcome(standing: RestReadExchange { rest: read.outcome }) {
    RestExchangeSucceeded => PreflightFileRead { file: read.file }
    RestExchangeStatusRefused { status, body } =>
      PreflightFileUnreadable {
        cause: join(["the file-by-id preflight for ", file_id as String, " refused with status ", to_string(status), ": ", body], "") as NonEmptyStr
      }
    RestExchangeUnreached { cause } =>
      PreflightFileUnreadable {
        cause: join(["the file-by-id preflight for ", file_id as String, " never reached Drive: ", cause as String], "") as NonEmptyStr
      }
    RestExchangeUndecodable { status, cause } =>
      PreflightFileUnreadable {
        cause: join(["the file-by-id preflight for ", file_id as String, " answered ", to_string(status), " with an unreadable body: ", cause as String], "") as NonEmptyStr
      }
    RestExchangeCommitAmbiguous { detail } =>
      PreflightFileUnreadable {
        cause: join(["the file-by-id preflight for ", file_id as String, " reported commit ambiguity, which a read may not: ", detail], "") as NonEmptyStr
      }
  }
}

// THE READBACK IS BOUND TO THE ID, NOT TO A SUCCESS CODE. A 200 says the request worked; it does
// not say it worked on the file that was asked for, and a response whose id differs from the
// requested one is exactly the shape a redirect, a proxy or a shortcut resolution produces. The
// mime type is checked for the same reason the search query carries it: adopting a folder or a doc
// as the review sheet is a silent wrong answer.
fn admit_preflighted_file(file_id: NonEmptyStr, file: DriveFile) -> DeclaredIdAdmission {
  if file.id != (file_id as String) {
    DeclaredIdRefused {
      cause: join(
        ["the file-by-id preflight for ", file_id as String, " answered for a different file (", file.id, "), so nothing here establishes that the selected id names a readable file"],
        "",
      ) as NonEmptyStr
    }
  } else if file.mimeType != (google_sheet_mime_type as String) {
    DeclaredIdRefused {
      cause: join(
        ["the operator declaration selects ", file_id as String, ", which is a ", file.mimeType, " and not ", google_sheet_mime_type as String],
        "",
      ) as NonEmptyStr
    }
  } else {
    DeclaredIdAdmitted { file_id: file_id }
  }
}

// THE WHOLE ADMISSION, AND THE NETWORK CALL HAPPENS ONLY AFTER EVERY FREE REFUSAL HAS BEEN TAKEN.
// A declaration that names another subject, or that stands against a standing this module cannot
// adjudicate, is refused without spending a request discovering that.
fn admit_declared_id(
  subject: ReviewSheetIdentitySubject,
  disposition: ReviewSheetIdentityDisposition,
  declaration: OperatorLegacyDeclaration,
) -> DeclaredIdAdmission uses net: Network {
  match declared_id_candidacy(subject: subject, disposition: disposition, declaration: declaration) {
    SelectionNotOffered => NoDeclaredIdOffered
    SelectionRejected { cause: c } => DeclaredIdRefused { cause: c }
    SelectionStandsForAdjudication { file_id: f } =>
      match preflight_file_by_id(file_id: f) {
        PreflightFileUnreadable { cause: c } => DeclaredIdRefused { cause: c }
        PreflightFileRead { file: file } => admit_preflighted_file(file_id: f, file: file)
      }
  }
}
