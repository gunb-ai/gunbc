// ONE CODEX SUBSCRIPTION CREDENTIAL, READ FROM gunbai-secrets AND WRITTEN BACK WHEN CODEX ROTATES IT.
// The ambient route binds a CODEX_HOME someone logged into on the host; nothing in it says where the
// login came from or who else holds a copy. This route takes the login from ONE secret,
// codex-auth-harness, whose payload is the auth.json a ChatGPT login wrote, byte for byte.
//
// Why a lease and a write-back rather than a read-only materialization: extdeps.llm.codex_auth
// codex_source_refresh_persistence records that codex rewrites auth.json about once an hour while it
// runs, replacing the refresh token with whatever the issuer returned, and that the issuer refuses a
// reused refresh token. A copy codex refreshed from is spent. So exactly one process may hold the
// credential at a time, and the token it ends with must go back into the store before anyone else
// reads it. The lease is std.durable_exclusive_hold realized by
// gunbc.durable_exclusive_hold_file_store; the write-back is Secret Manager AddVersion.
//
// Why this does not go through gunbc.auth.materialized_secret with_materialized_secret: that bracket
// admits a materialization only after an INDEPENDENT liveness probe has observed the credential live,
// and for a rotating OAuth refresh token the only liveness probe is to exchange it, which rotates it
// (a ProbeMayEstablish probe the bracket rightly refuses). Liveness here is observed by the turn's
// own account/read standing receipt instead, after codex has exchanged the token. The divergence is
// in the gate, not in the hygiene: the file is still written owner-only inside the same
// gunbc-private materialization directory the bracket's realizations use, and removed on every
// exit path.
//
// The operator rulings this follows (relayed by swift-ibex-601, 2026-10-05): subscription (chatgpt)
// mode, not API-key mode; never codex's upstream-labelled-internal external-token login; persist the
// rotated token under the lease. Write-back happens at turn end. Codex refreshing mid-turn and the
// host dying before the turn ends loses the rotated token: the next acquire then reads a spent token,
// codex reports the login as required, and dispatch refuses that credential until the operator logs in
// again. That window is the length of one turn.

data codex_auth_harness_secret_id: NonEmptyStr = "codex-auth-harness" as NonEmptyStr

// latest, because the credential moves: every write-back mints the next version. The fetch resolves
// the alias to an exact version and the receipt carries that version.
data codex_auth_harness_secret_ref: SecretRef = secret_ref_pin_version(
  ref: fleet_secret_ref(secret_id: codex_auth_harness_secret_id),
  version: "latest",
)

data codex_auth_harness_hold_slot: NonEmptyStr = "codex-auth-harness" as NonEmptyStr

// WHAT THE HARNESS NEEDS FROM auth.json, AND NOTHING ELSE. The refresh token decides whether a
// write-back is owed; the account id decides whether the file still belongs to the account the secret
// holds. The whole document is what gets written back, so nothing else needs reading.
type CodexHarnessAuthIdentity {
  account_id: NonEmptyStr
  refresh_token: Secret
}

type CodexHarnessAuthFileRefusal
  = CodexHarnessAuthFileUnparseable
  | CodexHarnessAuthModeNotChatgpt { observed: String }
  | CodexHarnessAuthModeAbsent
  | CodexHarnessAuthMemberMissing { member: NonEmptyStr }

type CodexHarnessAuthRead
  = CodexHarnessAuthAdmitted { identity: CodexHarnessAuthIdentity }
  | CodexHarnessAuthRefused { cause: CodexHarnessAuthFileRefusal }

fn codex_harness_string_member(v: JsonValue, key: NonEmptyStr) -> String? {
  match json_object_unique_member(v: v, key: key as String) {
    JsonMemberFound { value } =>
      match value {
        JsonString { value: s } => if s == "" { none } else { Present { value: s } }
        _ => none
      }
    JsonMemberAbsent => none
    JsonMemberDuplicated { count: _ } => none
    JsonMemberNotAnObject => none
  }
}

fn codex_harness_member_missing(key: NonEmptyStr) -> CodexHarnessAuthRead {
  CodexHarnessAuthRefused { cause: CodexHarnessAuthMemberMissing { member: key } }
}

fn codex_harness_tokens_identity(tokens: JsonValue) -> CodexHarnessAuthRead {
  match codex_harness_string_member(v: tokens, key: codex_auth_file_refresh_token_key) {
    Absent => codex_harness_member_missing(key: codex_auth_file_refresh_token_key)
    Present { value: refresh } =>
      match codex_harness_string_member(v: tokens, key: codex_auth_file_account_id_key) {
        Absent => codex_harness_member_missing(key: codex_auth_file_account_id_key)
        Present { value: account } =>
          CodexHarnessAuthAdmitted {
            identity: CodexHarnessAuthIdentity {
              account_id: account as NonEmptyStr,
              refresh_token: refresh as Secret,
            },
          }
      }
  }
}

fn codex_harness_chatgpt_identity(doc: JsonValue) -> CodexHarnessAuthRead {
  match json_object_unique_member(v: doc, key: codex_auth_file_tokens_key as String) {
    JsonMemberFound { value: tokens } => codex_harness_tokens_identity(tokens: tokens)
    JsonMemberAbsent => codex_harness_member_missing(key: codex_auth_file_tokens_key)
    JsonMemberDuplicated { count: _ } => codex_harness_member_missing(key: codex_auth_file_tokens_key)
    JsonMemberNotAnObject => CodexHarnessAuthRefused { cause: CodexHarnessAuthFileUnparseable }
  }
}

// THE PAYLOAD FORMAT IS CHECKED BEFORE ANY TURN RUNS. An API-key auth.json, or anything that is not
// an auth.json, refuses here with the reason, rather than starting codex against a file it will reject.
fn codex_harness_auth_read(content: String) -> CodexHarnessAuthRead {
  match parse_json_document(s: content) {
    JsonDocumentUnreadable { gap: _ } => CodexHarnessAuthRefused { cause: CodexHarnessAuthFileUnparseable }
    JsonDocumentParsed { value: doc } =>
      match codex_harness_string_member(v: doc, key: codex_auth_file_auth_mode_key) {
        Absent => CodexHarnessAuthRefused { cause: CodexHarnessAuthModeAbsent }
        Present { value: wire } =>
          match codex_auth_mode_of_wire(raw: wire) {
            Present { value: mode } =>
              match mode {
                CodexChatGptMode => codex_harness_chatgpt_identity(doc: doc)
                CodexApiKeyMode => CodexHarnessAuthRefused { cause: CodexHarnessAuthModeNotChatgpt { observed: wire } }
              }
            Absent => CodexHarnessAuthRefused { cause: CodexHarnessAuthModeNotChatgpt { observed: wire } }
          }
      }
  }
}

// THE WRITE-BACK DECISION, from the identity that was materialized and the file read back after the
// turn. A changed refresh token owes a new version carrying the whole file. An unchanged one owes
// nothing. A file that now names a different account, or that cannot be read, is refused rather than
// written: storing it would replace the operator's credential with something this run cannot vouch
// for, and NOT storing it is only safe because the refusal is reported.
type CodexHarnessWriteBackRefusal
  = CodexHarnessReadBackUnobservable { detail: String }
  | CodexHarnessReadBackAbsent
  | CodexHarnessReadBackRefused { cause: CodexHarnessAuthFileRefusal }
  | CodexHarnessReadBackAccountChanged { materialized: NonEmptyStr, read_back: NonEmptyStr }

type CodexHarnessWriteBackDecision
  = CodexHarnessWriteBackNotOwed
  | CodexHarnessWriteBackOwed { payload: Secret }
  | CodexHarnessWriteBackRefused { cause: CodexHarnessWriteBackRefusal }

fn codex_harness_write_back_decision(
  materialized: CodexHarnessAuthIdentity,
  read_back: FilesystemFileObservation,
) -> CodexHarnessWriteBackDecision {
  match read_back {
    FilesystemFileAbsent(_) => CodexHarnessWriteBackRefused { cause: CodexHarnessReadBackAbsent }
    FilesystemFileIndeterminate { cause } =>
      CodexHarnessWriteBackRefused { cause: CodexHarnessReadBackUnobservable { detail: cause } }
    FilesystemFileObservationsDisagree { path: _, cause } =>
      CodexHarnessWriteBackRefused { cause: CodexHarnessReadBackUnobservable { detail: cause } }
    FilesystemFileSubjectRefused { directory: _, name: _, cause } =>
      CodexHarnessWriteBackRefused { cause: CodexHarnessReadBackUnobservable { detail: cause } }
    FilesystemFileRead { path: _, content } =>
      match codex_harness_auth_read(content: content) {
        CodexHarnessAuthRefused { cause } =>
          CodexHarnessWriteBackRefused { cause: CodexHarnessReadBackRefused { cause: cause } }
        CodexHarnessAuthAdmitted { identity: after } =>
          if (after.account_id as String) != (materialized.account_id as String) {
            CodexHarnessWriteBackRefused {
              cause: CodexHarnessReadBackAccountChanged {
                materialized: materialized.account_id,
                read_back: after.account_id,
              },
            }
          } else if (after.refresh_token as String) == (materialized.refresh_token as String) {
            CodexHarnessWriteBackNotOwed
          } else {
            CodexHarnessWriteBackOwed { payload: content as Secret }
          }
      }
  }
}

// WHAT HAPPENED TO THE STORE, as a receipt the outcome carries. VersionAddAmbiguous is the case worth
// naming: the store may or may not hold the rotated token, so the next acquire may read a spent one.
type CodexHarnessWriteBackReceipt
  = CodexHarnessStoreUnchanged
  | CodexHarnessVersionAdded { version_name: String }
  | CodexHarnessVersionAddRefused { detail: String }
  | CodexHarnessVersionAddAmbiguous { detail: NonEmptyStr }
  | CodexHarnessWriteBackWithheld { cause: CodexHarnessWriteBackRefusal }

type CodexHarnessRefusal
  = CodexHarnessHoldOccupied { holder: DurableHoldOwnerRef }
  | CodexHarnessHoldUnavailable { detail: NonEmptyStr }
  | CodexHarnessSecretUnreadable { detail: NonEmptyStr }
  | CodexHarnessSecretPayloadRefused { cause: CodexHarnessAuthFileRefusal }
  | CodexHarnessMaterializationRefused { detail: NonEmptyStr }

type CodexHarnessHoldRelease
  = CodexHarnessHoldReleased
  | CodexHarnessHoldReleaseFailed { detail: NonEmptyStr }

type CodexHarnessCredentialOutcome<R>
  = CodexHarnessTurnRan {
      value: R,
      resolved_version: String,
      write_back: CodexHarnessWriteBackReceipt,
      hold_release: CodexHarnessHoldRelease,
    }
  | CodexHarnessCredentialRefused { cause: CodexHarnessRefusal }

fn codex_harness_secret_fetch_detail(fetch: SecretCredentialFetch) -> NonEmptyStr {
  match fetch {
    SecretCredentialReady { credential: _, resolved_version: _ } => "codex-auth-harness fetched" as NonEmptyStr
    SecretCredentialAccessUpsertRequired { plan: _ } =>
      "codex-auth-harness: Secret Manager access needs an upsert this run cannot perform" as NonEmptyStr
    SecretCredentialWireDecodeRefused { identity_cause: _, payload_cause: _ } =>
      "codex-auth-harness: Secret Manager response did not decode" as NonEmptyStr
    SecretCredentialFetchRefused { reason } => reason
    SecretCredentialResolvedVersionMismatch { requested: _, resolved: _ } =>
      "codex-auth-harness: Secret Manager resolved a version other than the one requested" as NonEmptyStr
  }
}

fn codex_harness_add_version(token_source: AccessTokenSource, payload: Secret) -> CodexHarnessWriteBackReceipt {
  match ensure_access_token(source: token_source) {
    AccessTokenUpsertRequired { plan: _ } =>
      CodexHarnessVersionAddRefused { detail: "no Secret Manager access token: access upsert required" }
    AccessTokenEnsureRefused { reason } =>
      CodexHarnessVersionAddRefused { detail: reason as String }
    AccessTokenReady { token } => {
      let added = gcp.SecretManager.AddVersion(
        access_token: token,
        secret_name: secret_ref_secret_resource(ref: codex_auth_harness_secret_ref),
        payload_b64: encode_sm_access_version_payload_wire(credential: payload),
      )
      match classify_rest_outcome(standing: RestMutationExchange { rest: added.outcome }) {
        RestExchangeSucceeded => CodexHarnessVersionAdded { version_name: added.name as String }
        RestExchangeStatusRefused { status: _, body } => CodexHarnessVersionAddRefused { detail: body }
        RestExchangeCommitAmbiguous { detail } => CodexHarnessVersionAddAmbiguous { detail: detail }
        RestExchangeUnreached { cause } => CodexHarnessVersionAddAmbiguous { detail: cause }
        RestExchangeUndecodable { status: _, cause } => CodexHarnessVersionAddAmbiguous { detail: cause }
      }
    }
  }
}

fn codex_harness_settle_write_back(
  token_source: AccessTokenSource,
  materialized: CodexHarnessAuthIdentity,
  auth_path: String,
) -> CodexHarnessWriteBackReceipt {
  match codex_harness_write_back_decision(
    materialized: materialized,
    read_back: filesystem_file_observation_of_path(path: auth_path),
  ) {
    CodexHarnessWriteBackNotOwed => CodexHarnessStoreUnchanged
    CodexHarnessWriteBackRefused { cause } => CodexHarnessWriteBackWithheld { cause: cause }
    CodexHarnessWriteBackOwed { payload } => codex_harness_add_version(token_source: token_source, payload: payload)
  }
}

fn codex_harness_release(
  lease_root: NonEmptyStr,
  owner: DurableHoldOwnerRef,
  generation: CasGeneration,
) -> CodexHarnessHoldRelease {
  match file_hold_release_assess(
    root: lease_root,
    slot_key: codex_auth_harness_hold_slot,
    owner: owner,
    acquired_generation: generation,
    released_by: concat("codex-turn-ended:", owner as String) as DurableHoldReleaseRef,
  ) {
    FileHoldReleaseNotEligible { slot_key: _, refusal: _ } =>
      CodexHarnessHoldReleaseFailed { detail: "codex-auth-harness hold no longer held by this turn at release" as NonEmptyStr }
    FileHoldReleasePlanned { plan } =>
      match file_hold_release_commit(plan: plan) {
        FileHoldReleased { slot_key: _, generation: _ } => CodexHarnessHoldReleased
        FileHoldReleaseLost { slot_key: _ } =>
          CodexHarnessHoldReleaseFailed { detail: "codex-auth-harness hold moved between release assessment and commit" as NonEmptyStr }
        FileHoldReleaseStoreUnavailable { slot_key: _, cause: _ } =>
          CodexHarnessHoldReleaseFailed { detail: "codex-auth-harness hold store unavailable at release" as NonEmptyStr }
        FileHoldReleaseKeyNotSlotAddressable { slot_key: _ } =>
          CodexHarnessHoldReleaseFailed { detail: "codex-auth-harness hold slot key not addressable" as NonEmptyStr }
      }
  }
}

// MATERIALIZE, RUN, SETTLE, REMOVE. Runs while the hold is held; every exit after the directory
// exists removes it.
fn codex_harness_materialized_run<R>(
  token_source: AccessTokenSource,
  payload: Secret,
  identity: CodexHarnessAuthIdentity,
  resolved_version: String,
  lease_root: NonEmptyStr,
  owner: DurableHoldOwnerRef,
  generation: CasGeneration,
  use: fn(AmbientCodexCredentialContext) -> R,
) -> CodexHarnessCredentialOutcome<R> {
  match private_scoped_materialization_root() {
    Absent => {
      let _ = codex_harness_release(lease_root: lease_root, owner: owner, generation: generation)
      CodexHarnessCredentialRefused {
        cause: CodexHarnessMaterializationRefused { detail: "no private scoped materialization root" as NonEmptyStr },
      }
    }
    Present { value: root } => {
      let made = ensure_gunbc_private_materialization_dir(root: root)
      let codex_home = concat(gunbc_private_materialization_dir(root: root) as String, "/codex-home") as FilePath
      let home_made = made && shell.Mkdir.Parents(path: codex_home).success
        && shell.Chmod.OwnerOnlyDirectory(path: codex_home).success
      let auth_path = concat(codex_home as String, concat("/", codex_auth_file_relative as String))
      let written = home_made && Filesystem.WriteOwnerOnly(path: auth_path, content: payload as String).success
      if !written {
        let _ = shell.Remove.RecursiveForce(path: codex_home)
        let _ = codex_harness_release(lease_root: lease_root, owner: owner, generation: generation)
        CodexHarnessCredentialRefused {
          cause: CodexHarnessMaterializationRefused { detail: "owner-only CODEX_HOME/auth.json could not be written" as NonEmptyStr },
        }
      } else {
        let value = use(AmbientCodexCredentialContext { codex_home: codex_home })
        let write_back = codex_harness_settle_write_back(
          token_source: token_source,
          materialized: identity,
          auth_path: auth_path,
        )
        let _ = shell.Remove.RecursiveForce(path: codex_home)
        CodexHarnessTurnRan {
          value: value,
          resolved_version: resolved_version,
          write_back: write_back,
          hold_release: codex_harness_release(lease_root: lease_root, owner: owner, generation: generation),
        }
      }
    }
  }
}

fn codex_harness_fetched_run<R>(
  token_source: AccessTokenSource,
  lease_root: NonEmptyStr,
  owner: DurableHoldOwnerRef,
  generation: CasGeneration,
  use: fn(AmbientCodexCredentialContext) -> R,
) -> CodexHarnessCredentialOutcome<R> {
  let fetch = fetch_secret_ref_credential(secret_ref: codex_auth_harness_secret_ref, token_source: token_source)
  match fetch {
    SecretCredentialReady { credential, resolved_version } =>
      match codex_harness_auth_read(content: credential as String) {
        CodexHarnessAuthRefused { cause } => {
          let _ = codex_harness_release(lease_root: lease_root, owner: owner, generation: generation)
          CodexHarnessCredentialRefused { cause: CodexHarnessSecretPayloadRefused { cause: cause } }
        }
        CodexHarnessAuthAdmitted { identity } =>
          codex_harness_materialized_run(
            token_source: token_source,
            payload: credential,
            identity: identity,
            resolved_version: resolved_version as String,
            lease_root: lease_root,
            owner: owner,
            generation: generation,
            use: use,
          )
      }
    _ => {
      let _ = codex_harness_release(lease_root: lease_root, owner: owner, generation: generation)
      CodexHarnessCredentialRefused {
        cause: CodexHarnessSecretUnreadable { detail: codex_harness_secret_fetch_detail(fetch: fetch) },
      }
    }
  }
}

// THE ENTRY. owner is the turn's client command id, so a hold left by a dead turn names the turn.
fn with_codex_harness_credential<R>(
  token_source: AccessTokenSource,
  lease_root: NonEmptyStr,
  owner: DurableHoldOwnerRef,
  use: fn(AmbientCodexCredentialContext) -> R,
) -> CodexHarnessCredentialOutcome<R> {
  match file_hold_acquire(root: lease_root, slot_key: codex_auth_harness_hold_slot, requested_owner: owner) {
    FileHoldAcquired { slot_key: _, owner: _, generation } =>
      codex_harness_fetched_run(
        token_source: token_source,
        lease_root: lease_root,
        owner: owner,
        generation: generation,
        use: use,
      )
    FileHoldOccupied { slot_key: _, holder, generation: _ } =>
      CodexHarnessCredentialRefused { cause: CodexHarnessHoldOccupied { holder: holder } }
    FileHoldAcquireLost { slot_key: _ } =>
      CodexHarnessCredentialRefused { cause: CodexHarnessHoldUnavailable { detail: "codex-auth-harness hold acquire lost a race" as NonEmptyStr } }
    FileHoldAcquireStoreUnavailable { slot_key: _, cause: _ } =>
      CodexHarnessCredentialRefused { cause: CodexHarnessHoldUnavailable { detail: "codex-auth-harness hold store unavailable" as NonEmptyStr } }
    FileHoldSlotUndecodable { slot_key: _, generation: _, detail } =>
      CodexHarnessCredentialRefused { cause: CodexHarnessHoldUnavailable { detail: detail } }
    FileHoldKeyNotSlotAddressable { slot_key: _ } =>
      CodexHarnessCredentialRefused { cause: CodexHarnessHoldUnavailable { detail: "codex-auth-harness hold slot key not addressable" as NonEmptyStr } }
  }
}
