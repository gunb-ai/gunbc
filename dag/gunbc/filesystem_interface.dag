module gunbc.filesystem_interface

import std.types { Bool, Int, String }
import extdeps.filesystem.filesystem_io { Filesystem }

// THE FILESYSTEM OPERATIONS THE DURABLE CAS STORE USES, AS ONE DECLARED INTERFACE RECORD. The store's
// compare-and-set logic is written once, over this record, so the realization that answers it is a
// value and not a fork of the logic (DESIGN section 3: interface, realization and policy are three
// facts). Every field is one operation of `extdeps.filesystem.filesystem_io` `Filesystem`, with that
// operation's own name and its own output channels, so a realization is judged against the operation's
// declared shape and not against a second vocabulary.
//
// The answer records carry the operation's scalar channels unfolded: the consumer folds them through
// the interface authority's admission (`filesystem_exact_read`, `filesystem_create_new`,
// `filesystem_listing_observation`), exactly as it folds the ambient operation's result. A realization
// that cannot answer a channel does not invent it: `Filesystem.WriteOwnerOnly` declares no `error_kind`,
// so its answer carries none.
// DECLARED FRONTIER (DESIGN section 3c). `local_filesystem` is this interface's only value in this change. The
// named consumer of the seam is the ssh realization `remote_filesystem(target, context) -> FilesystemInterface`,
// routed through `gunbc.typed_remote_file_write` `typed_remote_file_step` into `ssh.Session.ExecPortableWords`,
// which the PR2b slot-host durable hold takes. Trigger: this change lands; the store refactor is its own change by
// operator ruling, and the hold work does not open until the cap-bracket admission change has landed.
//
// The answer records restate the `Filesystem` operations' output channels because a service operation declares
// channels, not a record type, and a function-typed field needs one return type; no upstream record exists to reuse.
type FilesystemReadAnswer { content: String, success: Bool, error: String, error_kind: String }
type FilesystemListAnswer { entries: String, success: Bool, error: String, error_kind: String }
type FilesystemDeleteAnswer { success: Bool, error: String, error_kind: String }
type FilesystemCreateNewAnswer { success: Bool, bytes_written: Int, path: String, error: String, error_kind: String }
type FilesystemWriteOwnerOnlyAnswer { success: Bool, bytes_written: Int, path: String, error: String }

type FilesystemInterface {
  read: fn(String) -> FilesystemReadAnswer
  list: fn(String) -> FilesystemListAnswer
  delete: fn(String) -> FilesystemDeleteAnswer
  write_create_new: fn(String, String) -> FilesystemCreateNewAnswer
  write_create_new_with_mode: fn(String, String, Int) -> FilesystemCreateNewAnswer
  write_owner_only: fn(String, String) -> FilesystemWriteOwnerOnlyAnswer
}

// THE LOCAL REALIZATION IS THE AMBIENT OPERATIONS, ANSWERED UNCHANGED. Each field forwards its inputs to
// the operation of the same name and projects its declared outputs; nothing is added, defaulted or
// reordered, so a caller that used the ambient operation observes the same thing through this record.
data local_filesystem: FilesystemInterface = FilesystemInterface {
  read: fn(path) {
    let r = Filesystem.Read(path: path)
    FilesystemReadAnswer { content: r.content, success: r.success, error: r.error, error_kind: r.error_kind }
  }
  list: fn(path) {
    let r = Filesystem.List(path: path)
    FilesystemListAnswer { entries: r.entries, success: r.success, error: r.error, error_kind: r.error_kind }
  }
  delete: fn(path) {
    let r = Filesystem.Delete(path: path)
    FilesystemDeleteAnswer { success: r.success, error: r.error, error_kind: r.error_kind }
  }
  write_create_new: fn(path, content) {
    let r = Filesystem.WriteCreateNew(path: path, content: content)
    FilesystemCreateNewAnswer { success: r.success, bytes_written: r.bytes_written, path: r.path, error: r.error, error_kind: r.error_kind }
  }
  write_create_new_with_mode: fn(path, content, mode) {
    let r = Filesystem.WriteCreateNewWithMode(path: path, content: content, mode: mode)
    FilesystemCreateNewAnswer { success: r.success, bytes_written: r.bytes_written, path: r.path, error: r.error, error_kind: r.error_kind }
  }
  write_owner_only: fn(path, content) {
    let r = Filesystem.WriteOwnerOnly(path: path, content: content)
    FilesystemWriteOwnerOnlyAnswer { success: r.success, bytes_written: r.bytes_written, path: r.path, error: r.error }
  }
}
