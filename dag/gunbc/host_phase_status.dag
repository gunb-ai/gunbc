module gunbc.host_phase_status

type HostPhaseCellMemberAt = String

data host_phase_status_authority_note: String = "THE per-(host x phase) status axis for the host-standup spine. It exists because the spine could describe itself but not its RELATIONSHIP TO THE LIVE FLEET: every phase carried a PhaseDisposition (is there a modeled authority?) and nothing carried an observation (does this host actually agree with it?). Answering 'where does subsumption stand' therefore meant a session reconstruction — hand ssh probes, prose transcription — and the answer went stale the moment it was written. Two axes, kept ORTHOGONAL on purpose, because collapsing them is the state-space conflation this lane keeps paying for: the MODELED axis is PhaseDisposition, a property of the phase, the same for every host; the LIVE axis is std.upsert_decision.ObservationVerdict, a property of the (host, phase) CELL. A phase can be fully modeled AND Inaccessible on a given host — that is exactly srv1/srv2 for the build-cache phase today — and a single fused enum could not say it. Note what is NOT minted here: no Converged|Diverged|Unreachable|Unmodeled verdict of our own. ObservationVerdict already carries Converged/Absent/Drifted/Conflict/Inaccessible/UnknownRefused, which is STRICTLY FINER on the diverged and unreachable axes, and it is already consumed by twelve modules including host_standup itself; a parallel four-arm verdict beside it would be the §3 nickname, duplicated again in everything derived from it. 'Unmodeled' is likewise not an observation and does not become a verdict arm — it stays on PhaseDisposition, carried on the cell beside the observation and derived from the spine, never authored. CORRECTION, found by execution 2026-07-25: the cell was FIRST written as a SUM (StatusUnmodeled | StatusObserved), which forced the two axes to be mutually exclusive and made the fold discard the observation on any DeclaredGap phase. The witness caught it immediately, because the single cell that CARRIES AN OBSERVATION today is (srv3, prefix:os-install-actuated) — a DeclaredGap phase — so live-observation coverage computed as 0 while a real Converged verdict sat one branch away. The sum was the very conflation this note claims to avoid, written into the type by the same hand that wrote the warning. The cell is now a PRODUCT of both axes, which also gives the lane a state it could not previously say: observed Converged on an unmodeled phase means the host is in the desired condition by means the model cannot reproduce — true of srv3's OS install, and exactly the kind of fact that should never round to either 'modeled' or 'gap'."

data host_phase_cell_grain_note: String = "The cell is keyed by (host, phase_label) and NOT by (host, phase) structurally, because phase_label is already the spine's own stable identity for a step (it is what the gap ledger keyed on, what the refusal strings name, and what an operator reads). Keying on the label keeps ONE identity for a phase across the spine, this matrix, and every refusal message, rather than introducing a second notion of phase identity that could disagree with the first. key_of returns identity, never content (membership_reconcile's R2 contract): a cell whose STATUS changes is Modified — the same cell re-derived — not Removed+Added, which would read as a host leaving and rejoining the fleet."

type HostPhaseCell {
  host: product.placement_supply.HostIdentity
  phase_label: String
}

type HostPhaseCellStatus {
  cell: HostPhaseCell
  disposition: gunbc.host_standup.PhaseDisposition
  observation: std.upsert_decision.ObservationVerdict?
}

data host_phase_no_producer_is_unknown_not_converged_note: String = "THE fail-closed hinge of this module (DESIGN §5). When a modeled phase has NO live observation producer for a host, the derived verdict is UnknownRefused — never Converged, and never silently omitted from the matrix. The tempting arm is the absorbing fallback in its purest form: nothing is known to be wrong, so report converged; the matrix goes green, the coverage deficit's frequency drops to zero by construction, and the status read becomes a fabricated plausible output exactly like a stats probe that auto-starts the server it is measuring (the DaemonUnsupervised finding, #7213). It is also why UnknownRefused and Inaccessible must stay DISTINCT arms rather than one 'not converged': Inaccessible means we asked the host and could not reach it (remedy: fix reach — the A1 materialized-secret lane); UnknownRefused means we have no way to ask at all (remedy: build the producer). Different states, different owners, different work — and the count of each is the honest measure of how far subsumption actually is. host_phase_verdict_absorbing_fallback_widen_sketch models the forbidden arm as a RED control so the fold cannot drift back into it unnoticed. Note the separation this correction forced: 'has a live producer' is now read from the OBSERVATION being Present, not from the verdict being something other than UnknownRefused — a producer that runs and honestly refuses (an unreadable lease table) is coverage, while no producer at all is not, and the earlier version conflated the two."

fn host_phase_verdict_from(observation: std.upsert_decision.ObservationVerdict?) -> std.upsert_decision.ObservationVerdict {
  match observation {
    Present { value: v } => v
    Absent => UnknownRefused
  }
}

fn host_phase_verdict_absorbing_fallback_widen_sketch(
  observation: std.upsert_decision.ObservationVerdict?,
) -> std.upsert_decision.ObservationVerdict {
  match observation {
    Present { value: v } => v
    Absent => std.upsert_decision.Converged
  }
}

fn host_phase_verdict_gate_accepts(
  verdict: std.upsert_decision.ObservationVerdict,
  observation: std.upsert_decision.ObservationVerdict?,
) -> Bool {
  match observation {
    Present { value: _ } => true
    Absent =>
      match verdict {
        std.upsert_decision.Converged => false
        std.upsert_decision.Absent => true
        std.upsert_decision.Drifted => true
        Conflict => true
        Inaccessible => true
        UnknownRefused => true
      }
  }
}

fn host_phase_cell_verdict(c: HostPhaseCellStatus) -> std.upsert_decision.ObservationVerdict {
  host_phase_verdict_from(observation: c.observation)
}

fn host_phase_cell_is_modeled(c: HostPhaseCellStatus) -> Bool {
  match c.disposition {
    ModeledCompose { authorities: _ } => true
    DeclaredGap { interim_realization: _, refusal: _ } => false
  }
}

fn host_phase_cell_has_live_producer(c: HostPhaseCellStatus) -> Bool {
  match c.observation {
    Present { value: _ } => true
    Absent => false
  }
}

data host_phase_observation_frontier_note: String = "The live-observation producer registry, and deliberately a TYPED, COUNTABLE FRONTIER rather than a table of hand-written facts (the self-host frontier shape, DESIGN §7: each cell is either produced or it is a declared absence, never a silent assumption). Exactly one cell carries an observation today — (srv3, prefix:os-install-actuated), which deduces its verdict through gunbc.host_standup_assimilation_deduction; that deduction was ALREADY host-parameterized (deduce_os_install_actuation_verdict takes fleet_slot: HostIdentity), so generalizing it was reading the parameter it already had, not writing new machinery. CORRECTED 2026-08-09, by execution: this sentence previously called that cell a REAL PRODUCER, and it is not one. Its DHCP lease table is srv3_post_install_lease_table_fixture, an authored data constant in gunbc.network_identity_subsumption whose one dynamic row carries the placeholder MAC 00:00:00:00:00:00 — no effect anywhere in the tree produces a DhcpLeaseTableObservation. So host_phase_observation_coverage_count, which this note designates as the number that measures the debt, counts one covered cell and that cell is authored, overstating coverage by its entire population; and host_phase_cell_has_live_producer tests only that the observation is Present, never that anything executed. The rule below was already written and was simply not enforceable — nothing would have reddened had a second host been wired the same way, which is precisely what Spark collector-fact enrollment for srv5/srv6 was about to do. NEXT-RUNG TRIGGER, named rather than silently stalled (DESIGN §4b): observation provenance becomes a carried fact so authored and executed are different states, and coverage counts only the executed one. Until then the honest reading of the coverage number is ZERO. Controls: test.claim.host_phase_status witness_covered_cell_verdict_is_selected_by_authorship_alone and witness_every_covered_cell_today_is_the_authored_one. Every other cell returns Absent, which host_phase_verdict_from renders UnknownRefused. What must NOT happen here is the shape this module exists to kill: hand-entering an observation because someone ssh'd a host once. A probe run by a person is not a modeled producer — encoding its result as a data row would rebuild the parallel ledger the gap-ledger dissolution just removed, and it would go stale in exactly the same way. A cell earns a row here when an effect produces its verdict by execution; until then UnknownRefused is the honest answer and host_phase_observation_coverage_count is the number that measures the debt."

// THE canonical observation seam (operator directive 2026-08-08): every lifecycle-phase
// observation for every host routes through observe_host_phase — never a parallel
// per-program observer beside it (a spark_* sibling would be the reconcile-spine §3
// fork). The subject is the host's enrollment intent, so a producer can read what the
// host is enrolled FOR without a second roster. Producers are PURE deductions over
// committed typed observations (the srv3 lease-table pattern; gunbc.host_reach_identity_probe
// for the two P0 cells) — the matrix never executes a transport, and observation never
// repairs anything. A phase with no producer row returns none, which the verdict fold
// renders UnknownRefused: absence of a producer is a counted debt, never a silent green.
fn observe_host_phase(
  subject: gunbc.host_assimilation_program.HostEnrollmentIntent,
  host: product.placement_supply.HostIdentity,
  phase_label: String,
) -> std.upsert_decision.ObservationVerdict? {
  if phase_label == "prefix:os-install-actuated" {
    if host == operator_host_srv3 {
      Present { value: srv3_post_install_actuation_verdict(elapsed: millisecond(count: 0)) }
    } else {
      none
    }
  } else {
    if phase_label == "P0:host-identity-converge" {
      observe_host_identity_converge(host: host)
    } else {
      if phase_label == "P0:reach-secrets-network" {
        observe_reach_secrets_network(host: host)
      } else {
        none
      }
    }
  }
}

fn host_phase_observation(subject: gunbc.host_assimilation_program.HostEnrollmentIntent, host: product.placement_supply.HostIdentity, step: gunbc.host_standup.HostStandupStep) -> std.upsert_decision.ObservationVerdict? {
  observe_host_phase(subject: subject, host: host, phase_label: step.label as String)
}

fn host_phase_cell_status(subject: gunbc.host_assimilation_program.HostEnrollmentIntent, host: product.placement_supply.HostIdentity, step: gunbc.host_standup.HostStandupStep) -> HostPhaseCellStatus {
  HostPhaseCellStatus {
    cell: HostPhaseCell { host: host, phase_label: step.label as String },
    disposition: step.disposition,
    observation: host_phase_observation(subject: subject, host: host, step: step),
  }
}

data host_phase_program_scoping_note: String = "The cells of a host are the steps of ITS OWN assimilation program, not the universal spine. The previous shape crossed every enrolled host with host_standup_spine, which was right while every enrolled host was the same kind of thing and becomes a fabrication the moment one is not: an inference appliance has no BMC to converge and no Actions runner slot to deploy, so those cells could never be satisfied and could never honestly be marked converged. The global-spine path is DELETED rather than kept beside this one -- a retained cross-product would be an inert second answer that some consumer eventually reads (DESIGN section 6, coverage by illusion). A host enrolled for CI participation alone still selects the entire spine, so srv1 through srv4 are unchanged; that is asserted by an executing witness, not assumed here."

fn host_phase_cells_for_enrollment(intent: gunbc.host_assimilation_program.HostEnrollmentIntent) -> List<HostPhaseCellStatus> {
  map(
    assimilation_program_for(intent: intent).steps,
    s => host_phase_cell_status(subject: intent, host: intent.host, step: s),
  )
}

fn host_fleet_phase_matrix(enrollments: List<gunbc.host_assimilation_program.HostEnrollmentIntent>) -> List<HostPhaseCellStatus> {
  flat_map(enrollments, e => host_phase_cells_for_enrollment(intent: e))
}

data fleet_subsumption_hosts_note: String = "The enrolled fleet, read from gunbc.fleet_intent_network's host rows rather than re-listed here — the matrix must never be able to disagree with the intent about WHICH hosts exist. This is also the enrollment prerequisite the srv4 OOM incident priced (fleet_subsumption_manual_gaps section C): a host takes no fleet work until it is an intent row, so a host absent from this list has no cells at all, and one that appears gains a full column of UnknownRefused cells — the work becoming visible the moment the host is enrolled, which is the behaviour the incident wanted."

data fleet_subsumption_enrollments: List<gunbc.host_assimilation_program.HostEnrollmentIntent> = [
  gunbc.host_assimilation_program.HostEnrollmentIntent { host: operator_host_srv1, participation: ci_runner_enrollment_participation },
  gunbc.host_assimilation_program.HostEnrollmentIntent { host: operator_host_srv2, participation: ci_runner_enrollment_participation },
  gunbc.host_assimilation_program.HostEnrollmentIntent { host: operator_host_srv3, participation: ci_runner_enrollment_participation },
  gunbc.host_assimilation_program.HostEnrollmentIntent { host: operator_host_srv4, participation: ci_runner_enrollment_participation },
  gunbc.host_assimilation_program.HostEnrollmentIntent { host: operator_host_srv5, participation: inference_serving_enrollment_participation },
  gunbc.host_assimilation_program.HostEnrollmentIntent { host: operator_host_srv6, participation: inference_serving_enrollment_participation },
]

data fleet_subsumption_hosts_projection_note: String = "The bare host list is DERIVED from the enrollments, never authored beside them. Consumers that legitimately care only about WHICH hosts exist -- toolchain components, network diagnosis, swap backing -- keep reading a List of HostIdentity and are untouched by program scoping, while the enrollment rows stay the single authority for who is in the fleet and what they are in it for. Authoring both lists would rebuild the parallel representation this refactor removes."

data fleet_subsumption_hosts: List<product.placement_supply.HostIdentity> = map(
  fleet_subsumption_enrollments,
  e => e.host,
)

fn host_phase_cell_key(c: HostPhaseCellStatus) -> String {
  join([c.cell.host as String, "|", c.cell.phase_label], "")
}

fn host_phase_cell_key_eq(a: String, b: String) -> Bool {
  a == b
}

fn host_phase_status_eq(a: HostPhaseCellStatus, b: HostPhaseCellStatus) -> Bool {
  let modeled_agrees = host_phase_cell_is_modeled(c: a) == host_phase_cell_is_modeled(c: b)
  let verdict_agrees = observation_verdict_eq(
    a: host_phase_cell_verdict(c: a),
    b: host_phase_cell_verdict(c: b),
  )
  modeled_agrees && verdict_agrees
}

fn observation_verdict_eq(a: std.upsert_decision.ObservationVerdict, b: std.upsert_decision.ObservationVerdict) -> Bool {
  observation_verdict_rank(v: a) == observation_verdict_rank(v: b)
}

fn observation_verdict_rank(v: std.upsert_decision.ObservationVerdict) -> Int {
  match v {
    std.upsert_decision.Converged => 0
    std.upsert_decision.Absent => 1
    std.upsert_decision.Drifted => 2
    Conflict => 3
    Inaccessible => 4
    UnknownRefused => 5
  }
}

fn host_phase_cell_status_eq(a: HostPhaseCellStatus, b: HostPhaseCellStatus) -> Bool {
  let same_cell = host_phase_cell_key(c: a) == host_phase_cell_key(c: b)
  same_cell && host_phase_status_eq(a: a, b: b)
}

fn host_phase_cell_ownership(c: HostPhaseCellStatus) -> gunbc.ownership.Ownership? {
  Present { value: gunbc.ownership.Owned }
}

data host_phase_reconcile_instantiation_note: String = "The status matrix reconciled as a MEMBERSHIP DIFF — one more (key_of, key_eq, value_eq, ownership_of) bundle handed to the single generic gunbc.membership_reconcile.membership_reconcile, never a forked diff (a forked reconcile means the genericity bought nothing). Desired is every cell modeled AND observed Converged: that is the end state of the whole subsumption lane — every phase modeled AND every enrolled host converged on it — so a Modified hunk is precisely one unit of remaining work, and membership_write_count is the answer to 'how much is left' as a NUMBER rather than a prose reconstruction. Removed is a real arm, not a degenerate pole: a cell observed for a host no longer in fleet_intent is a host that left the fleet, and cells are Owned, so it tears down rather than refusing. The witness exercises that arm synthetically because the live fleet has no departed host today — an instantiation whose interesting hunks are all unreachable in practice is an instantiation nobody has actually tested."

fn host_phase_desired(enrollments: List<gunbc.host_assimilation_program.HostEnrollmentIntent>) -> List<HostPhaseCellStatus> {
  map(
    host_fleet_phase_matrix(enrollments: enrollments),
    c => HostPhaseCellStatus {
      cell: c.cell,
      disposition: host_phase_desired_disposition(),
      observation: Present { value: std.upsert_decision.Converged },
    },
  )
}

data host_phase_desired_disposition_note: String = "Desired pins BOTH axes to their end state, not just the verdict: a modeled authority AND an observed Converged. Pinning only the verdict would make a DeclaredGap phase whose host happens to be Converged compare equal to desired — which is exactly srv3 and prefix:os-install-actuated today, a host that IS installed while the actuation that installed it is not reproducible. That cell is real remaining work (the model cannot rebuild the host), so it must produce a hunk; a desired row that ignored the disposition would silently retire it."

fn host_phase_desired_disposition() -> gunbc.host_standup.PhaseDisposition {
  gunbc.host_standup.ModeledCompose {
    authorities: [
      std.decl_ref.DeclarationRef {
        module_path: "gunbc.host_phase_status",
        decl_name: "host_phase_desired_disposition",
        field: WholeDeclaration,
      },
    ]
  }
}

fn host_phase_reconcile(
  desired: List<HostPhaseCellStatus>,
  observed: List<HostPhaseCellStatus>,
) -> MembershipPlan<HostPhaseCellStatus, HostPhaseCellMemberAt> {
  membership_plan_admitting_outcome(
    outcome: membership_reconcile(
      desired: desired,
      observed: observed,
      key_of: host_phase_cell_key,
      key_eq: host_phase_cell_key_eq,
      value_eq: host_phase_cell_status_eq,
      ownership_of: host_phase_cell_ownership,
    ),
  )
}

fn host_phase_fleet_reconcile(enrollments: List<gunbc.host_assimilation_program.HostEnrollmentIntent>) -> MembershipPlan<HostPhaseCellStatus, HostPhaseCellMemberAt> {
  host_phase_reconcile(
    desired: host_phase_desired(enrollments: enrollments),
    observed: host_fleet_phase_matrix(enrollments: enrollments),
  )
}

fn host_phase_remaining_work_count(enrollments: List<gunbc.host_assimilation_program.HostEnrollmentIntent>) -> Int {
  membership_write_count(plan: host_phase_fleet_reconcile(enrollments: enrollments))
}

fn host_phase_observation_coverage_count(enrollments: List<gunbc.host_assimilation_program.HostEnrollmentIntent>) -> Int {
  filter(host_fleet_phase_matrix(enrollments: enrollments), c => host_phase_cell_has_live_producer(c: c)).length()
}

fn host_phase_cell_is_converged(c: HostPhaseCellStatus) -> Bool {
  match host_phase_cell_verdict(c: c) {
    std.upsert_decision.Converged => true
    std.upsert_decision.Absent => false
    std.upsert_decision.Drifted => false
    Conflict => false
    Inaccessible => false
    UnknownRefused => false
  }
}

fn host_phase_converged_cell_count(enrollments: List<gunbc.host_assimilation_program.HostEnrollmentIntent>) -> Int {
  filter(host_fleet_phase_matrix(enrollments: enrollments), c => host_phase_cell_is_converged(c: c)).length()
}

data host_phase_finished_note: String = "FINISHED is both axes at their end state — a modeled authority AND an observed Converged — and it is deliberately stricter than converged. A host that is in the desired condition by unmodeled means is not finished: nothing can rebuild it, so the next host repeats the toil, which is the entire cost this lane exists to remove. srv3's OS install is that cell today. Counting it as done would make the lane's own progress number flatter than the truth in exactly the direction that feels good."

fn host_phase_cell_is_finished(c: HostPhaseCellStatus) -> Bool {
  host_phase_cell_is_modeled(c: c) && host_phase_cell_is_converged(c: c)
}

fn host_phase_finished_cell_count(enrollments: List<gunbc.host_assimilation_program.HostEnrollmentIntent>) -> Int {
  filter(host_fleet_phase_matrix(enrollments: enrollments), c => host_phase_cell_is_finished(c: c)).length()
}

fn host_phase_unmodeled_count(enrollments: List<gunbc.host_assimilation_program.HostEnrollmentIntent>) -> Int {
  filter(host_fleet_phase_matrix(enrollments: enrollments), c => !host_phase_cell_is_modeled(c: c)).length()
}
