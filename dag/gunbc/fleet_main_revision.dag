module gunbc.fleet_main_revision

import std.types { String, NonEmptyStr, Bool }
import extdeps.git.object_store { GitObjectId }
import extdeps.git.publication_transport {
  GitRemoteRefExpectation,
  RemoteRefMustBeAbsent,
  RemoteRefMustEqual,
}

// fleet-main-revision-authority (arc item 3, operator directive 2026-08-08): the fleet's
// desired revision derives from MERGED, FLOOR-GREEN main — never from a CLI argument, a
// session's checkout, or raw HEAD. Hosts follow ONE admitted ref; "submitted" means
// "survived the floor", not "was pushed". Git-ref polling over service polling is the
// anti-entropy property being bought: a host that cannot reach the control plane keeps
// converging toward last-known-good, and a returning host converges from the admitted
// ref without a new commit or a human step.
data fleet_desired_ref_name: String = "refs/fleet/desired"

// What a host (or the fold) knows about the admitted desired revision after observing
// the ref. Unobserved is a typed state with a cause — a host that cannot read the ref
// holds last-known-good and says so; it never fabricates a target and never treats
// "could not read" as "nothing desired" (the empty-observation narrow).
// FOUR OBSERVATIONS, FOUR REMEDIES -- and the split exists because ONE of them licenses a write.
//
// This carried two variants: admitted, or "unobserved" with a cause string. That collapsed three
// situations `ls-remote` genuinely distinguishes, and the collapse is the empty-observation
// narrow: an origin that advertises NO such ref is an ANSWER about the remote, while a refused
// transport is the ABSENCE of an answer, and both rendered as FleetDesiredUnobserved. A consumer
// asking "may I create this ref?" cannot tell them apart, so the only safe reading of the old
// type was "never create", which is why first creation was not expressible at all.
//
//   FleetDesiredAdmitted    the ref is at a decodable oid   -> advance FROM it
//   FleetDesiredAbsent      origin advertises no such ref   -> create it, and ONLY here
//   FleetDesiredUndecodable the ref exists and is garbage   -> alarm; never write over it
//   FleetDesiredUnobserved  no answer at all                -> refuse; claim nothing
//
// Undecodable is not folded into Unobserved even though both refuse a write, because their
// remedies differ: an undecodable advertisement means the ref EXISTS holding something we cannot
// read, which a retry will not fix and a write would destroy; an unobserved ref means we failed
// to ask. Merging them would let a corrupt ref be retried forever as if it were a network fault.

type FleetDesiredRevision
  = FleetDesiredAdmitted { revision: GitObjectId }
  | FleetDesiredAbsent
  | FleetDesiredUndecodable { advertised: String }
  | FleetDesiredUnobserved { cause: String }

fn fleet_desired_revision_target(d: FleetDesiredRevision) -> GitObjectId? {
  match d {
    FleetDesiredAdmitted { revision: r } => Present { value: r }
    FleetDesiredAbsent => none
    FleetDesiredUndecodable { advertised: _ } => none
    FleetDesiredUnobserved { cause: _ } => none
  }
}

// THE OBSERVATION-TO-EXPECTATION SEAM, and the only place an advance learns what it may claim
// about the remote.
//
// A compare-and-swap needs a claim about the CURRENT state of the ref it is moving. Only two
// observations support one: the ref is at a decodable oid, or origin advertises no such ref.
// Everything else supports NO claim, and refusing is not a default -- it is the answer.
//
// THE REFUSAL CARRIES ITS CAUSE, AND AN EARLIER REVISION OF THIS SEAM DID NOT. It returned
// `GitRemoteRefExpectation?`, projecting Undecodable and Unobserved to the same `none`. That is
// safe in the narrow sense that neither authorizes a write, and it is exactly the flattening
// this module split the type to prevent: the whole reason those two are separate variants is
// that their remedies differ -- a corrupt advertisement needs repair and will not improve on
// retry, an unobserved ref needs connectivity or credentials. A consumer holding only `none`
// cannot choose, so it would have to rematch the original observation, putting a second
// decision site beside this one. Both arms refusing is what made the flattening look
// conservative; the defect was that the refusal stopped preserving the remedy (raised in
// side-chat review, 2026-08-21).
//
// Rendering "I could not read the ref" as RemoteRefMustBeAbsent would turn a network fault into
// a ref CREATION, and rendering it as RemoteRefMustEqual would need an oid nobody observed.
// Both are the empty-observation narrow pointed at an actuator.
type FleetDesiredExpectationRefusal
  = FleetDesiredRefUndecodable { advertised: String }
  | FleetDesiredRefUnobserved { cause: String }

type FleetDesiredExpectationDecision
  = FleetDesiredExpectationReady { expectation: GitRemoteRefExpectation }
  | FleetDesiredExpectationRefused { cause: FleetDesiredExpectationRefusal }

fn fleet_desired_advance_expectation(observed: FleetDesiredRevision) -> FleetDesiredExpectationDecision {
  match observed {
    FleetDesiredAdmitted { revision: r } =>
      FleetDesiredExpectationReady { expectation: RemoteRefMustEqual { oid: r } }
    FleetDesiredAbsent => FleetDesiredExpectationReady { expectation: RemoteRefMustBeAbsent }
    FleetDesiredUndecodable { advertised: line } =>
      FleetDesiredExpectationRefused { cause: FleetDesiredRefUndecodable { advertised: line } }
    FleetDesiredUnobserved { cause: c } =>
      FleetDesiredExpectationRefused { cause: FleetDesiredRefUnobserved { cause: c } }
  }
}

// THE ADMISSION GATE, AND WHY IT NAMES AN EXPECTATION RATHER THAN A PRIOR OID.
//
// Two independent facts must hold before the desired ref moves, and neither implies the
// other: the candidate revision's floor is green (the revision is PROVEN), and the ref's
// current state was OBSERVED (the write is SAFE to attempt). Admitting on the first alone
// is how an unproven revision bricks the fleet; admitting on the second alone is how a
// concurrent admission gets silently overwritten.
//
// The prior was a `GitObjectId?`, and that Option was the same collapse the observation
// type above was split to remove, surviving one layer down. `none` there meant BOTH "origin
// advertises no such ref, so create it" and "we could not observe the ref" -- and the arm
// took the SAME action for both, so a transport failure rendered as a ref CREATION. That is
// the empty-observation narrow with an actuator on the end of it. The gate therefore consumes
// the decision, not a raw oid: FleetDesiredExpectationDecision has already refused the two
// observations that license nothing, so no unobservable state can reach an admitted advance.
//
// AdvanceAdmitted carries a GitRemoteRefExpectation because that is precisely what the
// compare-and-swap consumes (git.PublicationTransport PushRefUpdateWithLease). Note the
// earlier revision of this comment cited `git update-ref <ref> <new> <old>`: that is the
// WRONG OPERATION, and wrongly in the direction that fails by succeeding -- refs/fleet/desired
// lives on origin and is read with ls-remote, so update-ref would move a LOCAL ref, exit 0,
// and leave the fleet's desired state untouched while reporting an advance.
//
// REFUSAL ORDERING IS DELIBERATE AND UNDER TEST: an unproven candidate is refused as
// unproven even when the expectation is ALSO unavailable. The floor fact is intrinsic to the
// candidate and is not fixed by retrying the network, so reporting the transport cause there
// would send the reader to the wrong remedy.
type FleetDesiredAdvanceRefusal
  = AdvanceFloorNotGreen
  | AdvanceExpectationUnavailable { cause: FleetDesiredExpectationRefusal }

type FleetDesiredAdvance
  = AdvanceAdmitted { expected: GitRemoteRefExpectation, to: GitObjectId }
  | AdvanceRefused { cause: FleetDesiredAdvanceRefusal }

fn admit_fleet_desired_advance(
  candidate: GitObjectId,
  floor_green: Bool,
  expectation: FleetDesiredExpectationDecision,
) -> FleetDesiredAdvance {
  if floor_green {
    match expectation {
      FleetDesiredExpectationReady { expectation: e } =>
        AdvanceAdmitted { expected: e, to: candidate }
      FleetDesiredExpectationRefused { cause: c } =>
        AdvanceRefused { cause: AdvanceExpectationUnavailable { cause: c } }
    }
  } else {
    AdvanceRefused { cause: AdvanceFloorNotGreen }
  }
}

// Converge target derivation — the seam that retires the CLI argument as the source of
// desired state. The converge circuit asks THIS function what revision it is converging
// toward; an unobserved ref yields none and the caller refuses (typed, located), it
// does not fall back to "whatever tree I was invoked from".
fn converge_target_revision(observed: FleetDesiredRevision) -> GitObjectId? {
  fleet_desired_revision_target(d: observed)
}
