module gunbc.fleet_main_revision

import std.types { String, NonEmptyStr, Bool, Int }
import extdeps.git.object_store { GitObjectId, git_object_id_eq, git_object_id_from_untagged_hex }
import extdeps.git.publication_transport {
  GitRemoteRefExpectation,
  RemoteRefMustBeAbsent,
  RemoteRefMustEqual,
}
import gunbc.live_deploy.revision {
  DeployRevisionRelation,
  SameRevision,
  DeployedIsAncestor,
  CandidateIsAncestor,
  UnrelatedHistories,
  RelationUnverifiable,
}
import gunbc.fleet_revision_acceptance { AcceptedFleetRevision }

// fleet-main-revision-authority (arc item 3, operator directive 2026-08-08): the fleet's
// desired revision derives from MERGED, FLOOR-GREEN main — never from a CLI argument, a
// session's checkout, or raw HEAD. Hosts follow ONE admitted ref; "submitted" means
// "survived the floor", not "was pushed". Git-ref polling over service polling is the
// anti-entropy property being bought: a host that cannot reach the control plane keeps
// converging toward last-known-good, and a returning host converges from the admitted
// ref without a new commit or a human step.
data fleet_desired_ref_name: String = "refs/fleet/desired"

// What a host (or the fold) knows about the admitted desired revision after observing
// the ref. Unobserved is a typed state with a cause — a host that cannot read the ref
// holds last-known-good and says so; it never fabricates a target and never treats
// "could not read" as "nothing desired" (the empty-observation narrow).
// FOUR OBSERVATIONS, FOUR REMEDIES -- and the split exists because ONE of them licenses a write.
//
// This carried two variants: admitted, or "unobserved" with a cause string. That collapsed three
// situations `ls-remote` genuinely distinguishes, and the collapse is the empty-observation
// narrow: an origin that advertises NO such ref is an ANSWER about the remote, while a refused
// transport is the ABSENCE of an answer, and both rendered as FleetDesiredUnobserved. A consumer
// asking "may I create this ref?" cannot tell them apart, so the only safe reading of the old
// type was "never create", which is why first creation was not expressible at all.
//
//   FleetDesiredAdmitted    the ref is at a decodable oid   -> advance FROM it
//   FleetDesiredAbsent      origin advertises no such ref   -> create it, and ONLY here
//   FleetDesiredUndecodable the ref exists and is garbage   -> alarm; never write over it
//   FleetDesiredUnobserved  no answer at all                -> refuse; claim nothing
//
// Undecodable is not folded into Unobserved even though both refuse a write, because their
// remedies differ: an undecodable advertisement means the ref EXISTS holding something we cannot
// read, which a retry will not fix and a write would destroy; an unobserved ref means we failed
// to ask. Merging them would let a corrupt ref be retried forever as if it were a network fault.

type FleetDesiredRevision
  = FleetDesiredAdmitted { revision: GitObjectId }
  | FleetDesiredAbsent
  | FleetDesiredUndecodable { advertised: String }
  | FleetDesiredUnobserved { cause: String }

fn fleet_desired_revision_target(d: FleetDesiredRevision) -> GitObjectId? {
  match d {
    FleetDesiredAdmitted { revision: r } => Present { value: r }
    FleetDesiredAbsent => none
    FleetDesiredUndecodable { advertised: _ } => none
    FleetDesiredUnobserved { cause: _ } => none
  }
}

// THE OBSERVATION-TO-EXPECTATION SEAM, and the only place an advance learns what it may claim
// about the remote.
//
// A compare-and-swap needs a claim about the CURRENT state of the ref it is moving. Only two
// observations support one: the ref is at a decodable oid, or origin advertises no such ref.
// Everything else supports NO claim, and refusing is not a default -- it is the answer.
//
// THE REFUSAL CARRIES ITS CAUSE, AND AN EARLIER REVISION OF THIS SEAM DID NOT. It returned
// `GitRemoteRefExpectation?`, projecting Undecodable and Unobserved to the same `none`. That is
// safe in the narrow sense that neither authorizes a write, and it is exactly the flattening
// this module split the type to prevent: the whole reason those two are separate variants is
// that their remedies differ -- a corrupt advertisement needs repair and will not improve on
// retry, an unobserved ref needs connectivity or credentials. A consumer holding only `none`
// cannot choose, so it would have to rematch the original observation, putting a second
// decision site beside this one. Both arms refusing is what made the flattening look
// conservative; the defect was that the refusal stopped preserving the remedy (raised in
// side-chat review, 2026-08-21).
//
// Rendering "I could not read the ref" as RemoteRefMustBeAbsent would turn a network fault into
// a ref CREATION, and rendering it as RemoteRefMustEqual would need an oid nobody observed.
// Both are the empty-observation narrow pointed at an actuator.
type FleetDesiredExpectationRefusal
  = FleetDesiredRefUndecodable { advertised: String }
  | FleetDesiredRefUnobserved { cause: String }

type FleetDesiredExpectationDecision
  = FleetDesiredExpectationReady { expectation: GitRemoteRefExpectation }
  | FleetDesiredExpectationRefused { cause: FleetDesiredExpectationRefusal }

fn fleet_desired_advance_expectation(observed: FleetDesiredRevision) -> FleetDesiredExpectationDecision {
  match observed {
    FleetDesiredAdmitted { revision: r } =>
      FleetDesiredExpectationReady { expectation: RemoteRefMustEqual { oid: r } }
    FleetDesiredAbsent => FleetDesiredExpectationReady { expectation: RemoteRefMustBeAbsent }
    FleetDesiredUndecodable { advertised: line } =>
      FleetDesiredExpectationRefused { cause: FleetDesiredRefUndecodable { advertised: line } }
    FleetDesiredUnobserved { cause: c } =>
      FleetDesiredExpectationRefused { cause: FleetDesiredRefUnobserved { cause: c } }
  }
}

// THE ADMISSION GATE. A LEASE MAKES THE WRITE ATOMIC; IT DOES NOT MAKE IT MONOTONE.
//
// This is the correction that shapes the whole decision below, because it is the thing most
// easily assumed. A compare-and-swap naming the observed prior refuses a CONCURRENT modification
// -- someone else moved the ref while we were deciding -- and it says NOTHING about direction. A
// perfectly valid lease against a correctly observed prior will move the ref BACKWARDS to an
// older revision without complaint, and every check upstream of it will have passed: the
// revision was proven, the floor was green, the observation was real, the lease matched. Nothing
// in the CAS is capable of noticing. Forward-only motion is a SEPARATE property and it needs its
// own evidence, which is what the relation observation supplies.
//
// WHAT THE INPUTS USED TO BE, AND WHY NONE OF THEM SURVIVES:
//
//   candidate: GitObjectId  -- a target nameable independently of any evidence about it, so a
//                              caller could present proof about revision A and advance onto B.
//   floor_green: Bool       -- unfalsifiable at the call site. It asserts that SOME floor was
//                              green and binds that greenness to no revision at all.
//   current: GitObjectId?   -- `none` meant both "no such ref, create it" and "could not observe
//                              it", and the arm took the SAME action for both, so a transport
//                              failure actuated a ref CREATION.
//
// All three are replaced by carriers that cannot express the bad state rather than by checks
// that detect it. AcceptedFleetRevision is constructible only from two exact positive facts
// about ONE revision, so there is no candidate left beside it to substitute and no Bool standing
// in for "which revision was proven". FleetDesiredExpectationDecision has already refused the
// observations that license nothing.
//
// THE RELATION IS SUBJECT-BOUND, AND THE BINDING IS CHECKED RATHER THAN TRUSTED. A bare
// `DeployedIsAncestor` is not evidence: it does not say WHICH TWO revisions were compared, so a
// relation computed for some other pair would satisfy a decision about this one. The observation
// therefore carries both endpoints, and this function refuses when they are not the exact pair
// under decision. Without that check the subject-binding would be a naming convention rather
// than a wall -- which is the same distinction between a carrier that says a thing and a carrier
// that enforces it that the rest of this file exists to make.

type FleetRevisionRelationObservation
  = FleetRevisionRelationObserved {
      current: GitObjectId,
      accepted: GitObjectId,
      relation: DeployRevisionRelation,
    }
  | FleetRevisionRelationRefused {
      current: GitObjectId,
      accepted: GitObjectId,
      cause: NonEmptyStr,
    }

// THE ANCESTRY OBSERVATION, SPLIT SO THE DECIDABLE HALF IS ACTUALLY TESTABLE.
//
// This fold is PURE: it takes the wire facts a merge-base probe returns and produces the
// subject-bound relation. The effect that obtains those facts lives at the workflow edge, and the
// split is not tidiness -- git.Inspect.MergeBase carries no mock_response, so ANY witness that
// reaches it refuses under the hermetic floor envelope rather than running. Folding the decision
// into the effect would therefore make the entire ancestry policy unwitnessable, and the tree has
// already paid for that lesson once (stage0_rust_host_observation_live_witness_test records a
// single unmocked operation taking down a 105-row batch). Here the policy is hermetic and total,
// and only the reading of two commits is not.
//
// EXIT 1 AND EXIT 128 ARE THE WHOLE REASON THIS TAKES AN EXIT CODE. `git merge-base` exits 1 when
// the pair genuinely shares no merge base -- unrelated histories, a FACT about the pair -- and 128
// when a ref is invalid or this is not a repository, which is a failure to look. Both are
// `exit_success = false`. A consumer holding only that Bool must either refuse both, discarding a
// real answer, or admit both, which reads an unreadable repository as proof that two revisions are
// unrelated and then refuses an advance that should have been admitted. The distinction was always
// declared on the operation and was simply never surfaced.
//
// A MERGE BASE THAT IS NEITHER ENDPOINT MEANS THE HISTORIES DIVERGED, and it folds to
// UnrelatedHistories to match the semantics the existing probe fold already assigns that variant
// (gunbc.live_deploy.revision deploy_revision_relation_from_probes: neither-is-ancestor yields
// UnrelatedHistories). Reusing that vocabulary rather than minting a Diverged variant keeps one
// authority for "how do these two revisions relate"; the name is the deploy lane's, and it means
// neither-is-an-ancestor rather than share-no-history.
data merge_base_exit_ok: Int = 0

data merge_base_exit_no_merge_base: Int = 1

fn fleet_revision_relation_from_merge_base(
  current: GitObjectId,
  accepted: GitObjectId,
  exit_code: Int,
  base_hex: String,
  stderr: String,
) -> FleetRevisionRelationObservation {
  if git_object_id_eq(left: current, right: accepted) {
    FleetRevisionRelationObserved { current: current, accepted: accepted, relation: SameRevision }
  } else {
    if exit_code == merge_base_exit_no_merge_base {
      FleetRevisionRelationObserved {
        current: current,
        accepted: accepted,
        relation: UnrelatedHistories,
      }
    } else {
      if exit_code == merge_base_exit_ok {
        match git_object_id_from_untagged_hex(hex: base_hex) {
          Present { value: base } =>
            FleetRevisionRelationObserved {
              current: current,
              accepted: accepted,
              relation: relation_from_merge_base_oid(current: current, accepted: accepted, base: base),
            }
          none =>
            FleetRevisionRelationRefused {
              current: current,
              accepted: accepted,
              cause: concat("git merge-base succeeded but its output is not a decodable object id: ", base_hex),
            }
        }
      } else {
        FleetRevisionRelationRefused {
          current: current,
          accepted: accepted,
          cause: concat("git merge-base could not answer for this pair: ", stderr),
        }
      }
    }
  }
}

// One merge base decides both directions, so no second probe is needed: a commit is an ancestor of
// another exactly when it IS their merge base.
fn relation_from_merge_base_oid(
  current: GitObjectId,
  accepted: GitObjectId,
  base: GitObjectId,
) -> DeployRevisionRelation {
  if git_object_id_eq(left: base, right: current) {
    DeployedIsAncestor
  } else {
    if git_object_id_eq(left: base, right: accepted) {
      CandidateIsAncestor
    } else {
      UnrelatedHistories
    }
  }
}

type FleetDesiredAdvanceRefusal
  = AdvanceExpectationUnavailable { cause: FleetDesiredExpectationRefusal }
  | AdvanceHistoriesUnrelated { current: GitObjectId, accepted: GitObjectId }
  | AdvanceRelationUnobservable { current: GitObjectId, accepted: GitObjectId, cause: NonEmptyStr }
  | AdvanceRelationIsAboutAnotherPair {
      relation_current: GitObjectId,
      relation_accepted: GitObjectId,
      actual_current: GitObjectId,
      actual_accepted: GitObjectId,
    }

// FIVE TERMINAL STATES, AND TWO OF THEM ARE SUCCESSES THAT WRITE NOTHING.
//
// AlreadyConverged and SupersededNoOp are not failures and must not be rendered as operational
// red. A late result for an older revision arriving after a newer one has already been admitted
// is the NORMAL consequence of runs finishing out of order; the desired state is already correct
// and more advanced, so the work is done. Reporting it as a failure trains an operator to ignore
// the channel, which is how a real refusal later goes unread.
//
// NO `to:` FIELD SITS BESIDE accepted.revision. A second writable name for the target would
// immediately recreate the substitution this cut removed -- the two could then disagree, and the
// one the actuator read would decide what actually happened.
//
// THE ADMITTED ARMS CARRY THE SHAPE OF THEIR LEASE, NOT A GENERAL EXPECTATION. A create carries
// no prior because there is none, and an advance carries exactly the prior it verified. Handing
// both a general GitRemoteRefExpectation would let a create arm carry MustEqual and an advance
// arm carry MustBeAbsent -- the clobbering pair -- which is representable in the general type and
// unrepresentable here.
type FleetDesiredAdvanceDecision<E, M>
  = FleetDesiredCreateAdmitted { accepted: AcceptedFleetRevision<E, M> }
  | FleetDesiredAdvanceAdmitted {
      accepted: AcceptedFleetRevision<E, M>,
      expected_prior: GitObjectId,
    }
  | FleetDesiredAlreadyConverged { accepted: AcceptedFleetRevision<E, M> }
  | FleetDesiredSupersededNoOp {
      accepted: AcceptedFleetRevision<E, M>,
      current: GitObjectId,
    }
  | FleetDesiredAdvanceRefused { cause: FleetDesiredAdvanceRefusal }

// The lease each admitted arm implies. Derived rather than stored, so the arm and its lease
// cannot drift apart: there is exactly one way to get an expectation out of a decision.
fn fleet_desired_admitted_expectation<E, M>(
  decision: FleetDesiredAdvanceDecision<E, M>,
) -> GitRemoteRefExpectation? {
  match decision {
    FleetDesiredCreateAdmitted { accepted: _ } => Present { value: RemoteRefMustBeAbsent }
    FleetDesiredAdvanceAdmitted { accepted: _, expected_prior: prior } =>
      Present { value: RemoteRefMustEqual { oid: prior } }
    FleetDesiredAlreadyConverged { accepted: _ } => none
    FleetDesiredSupersededNoOp { accepted: _, current: _ } => none
    FleetDesiredAdvanceRefused { cause: _ } => none
  }
}

fn decide_fleet_desired_advance<E, M>(
  accepted: AcceptedFleetRevision<E, M>,
  expectation: FleetDesiredExpectationDecision,
  relation: FleetRevisionRelationObservation,
) -> FleetDesiredAdvanceDecision<E, M> {
  match expectation {
    FleetDesiredExpectationRefused { cause: c } =>
      FleetDesiredAdvanceRefused { cause: AdvanceExpectationUnavailable { cause: c } }
    FleetDesiredExpectationReady { expectation: e } =>
      match e {
        RemoteRefMustBeAbsent => FleetDesiredCreateAdmitted { accepted: accepted }
        RemoteRefMustEqual { oid: current } =>
          decide_against_observed_current(
            accepted: accepted,
            current: current,
            relation: relation,
          )
      }
  }
}

// Split out so the subject-binding check reads as the precondition it is, rather than as another
// level of nesting inside the expectation match.
fn decide_against_observed_current<E, M>(
  accepted: AcceptedFleetRevision<E, M>,
  current: GitObjectId,
  relation: FleetRevisionRelationObservation,
) -> FleetDesiredAdvanceDecision<E, M> {
  match relation {
    FleetRevisionRelationRefused { current: rc, accepted: ra, cause: cause } =>
      if relation_is_about(
        relation_current: rc,
        relation_accepted: ra,
        actual_current: current,
        actual_accepted: accepted.revision,
      ) {
        FleetDesiredAdvanceRefused {
          cause: AdvanceRelationUnobservable {
            current: current,
            accepted: accepted.revision,
            cause: cause,
          },
        }
      } else {
        FleetDesiredAdvanceRefused {
          cause: AdvanceRelationIsAboutAnotherPair {
            relation_current: rc,
            relation_accepted: ra,
            actual_current: current,
            actual_accepted: accepted.revision,
          },
        }
      }
    FleetRevisionRelationObserved { current: rc, accepted: ra, relation: rel } =>
      if relation_is_about(
        relation_current: rc,
        relation_accepted: ra,
        actual_current: current,
        actual_accepted: accepted.revision,
      ) {
        classify_admitted_relation(accepted: accepted, current: current, rel: rel)
      } else {
        FleetDesiredAdvanceRefused {
          cause: AdvanceRelationIsAboutAnotherPair {
            relation_current: rc,
            relation_accepted: ra,
            actual_current: current,
            actual_accepted: accepted.revision,
          },
        }
      }
  }
}

fn relation_is_about(
  relation_current: GitObjectId,
  relation_accepted: GitObjectId,
  actual_current: GitObjectId,
  actual_accepted: GitObjectId,
) -> Bool {
  git_object_id_eq(left: relation_current, right: actual_current)
    && git_object_id_eq(left: relation_accepted, right: actual_accepted)
}

// The relation vocabulary is reused from gunbc.live_deploy.revision rather than re-coined: the
// question "how do these two revisions relate" is one concept, and a second five-variant enum
// beside it would be the §3 nickname. Its variant names carry the deploy lane's roles, so the
// mapping is stated once here: `deployed` is the CURRENT desired ref, `candidate` is the newly
// ACCEPTED revision.
fn classify_admitted_relation<E, M>(
  accepted: AcceptedFleetRevision<E, M>,
  current: GitObjectId,
  rel: DeployRevisionRelation,
) -> FleetDesiredAdvanceDecision<E, M> {
  match rel {
    SameRevision => FleetDesiredAlreadyConverged { accepted: accepted }
    DeployedIsAncestor =>
      FleetDesiredAdvanceAdmitted { accepted: accepted, expected_prior: current }
    CandidateIsAncestor =>
      FleetDesiredSupersededNoOp { accepted: accepted, current: current }
    UnrelatedHistories =>
      FleetDesiredAdvanceRefused {
        cause: AdvanceHistoriesUnrelated { current: current, accepted: accepted.revision },
      }
    RelationUnverifiable { cause: c } =>
      FleetDesiredAdvanceRefused {
        cause: AdvanceRelationUnobservable {
          current: current,
          accepted: accepted.revision,
          cause: c,
        },
      }
  }
}

// Converge target derivation — the seam that retires the CLI argument as the source of
// desired state. The converge circuit asks THIS function what revision it is converging
// toward; an unobserved ref yields none and the caller refuses (typed, located), it
// does not fall back to "whatever tree I was invoked from".
fn converge_target_revision(observed: FleetDesiredRevision) -> GitObjectId? {
  fleet_desired_revision_target(d: observed)
}
