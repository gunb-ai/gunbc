module gunbc.bach_double_slit_observation

import std.types { Bool, Int, List }
import std.integer { NonNegativeInt }
import v2.std.algebra { list_map, list_head, list_tail, HeadFound, HeadAbsent, TailFound, TailAbsent }
import extdeps.physics.bach_et_al_2013_double_slit {
  BachEtAl2013DoubleSlitExperiment,
  bach_et_al_2013_double_slit,
  BachDistributionObservation,
  bach_distribution_observations,
  BachBuildupObservationRow,
  bach_buildup_observations,
  PatternStatus,
  PatternNotYetDiscernible,
  PatternDiscernible,
  PatternClearlyVisible,
  SlitOneSingleSlitDiffractionObserved,
  SlitTwoSingleSlitDiffractionObserved,
  BothSlitsDoubleSlitDiffractionObserved,
}

data bach_observation_layer_note: String = "Observing-layer receipts for Bach et al. 2013. Buildup progression derives structural properties from extdeps.physics.bach_et_al_2013_double_slit.bach_buildup_observations — sole population authority, no parallel copy."

data which_path_coverage_obligation_note: String = "Which-path distinguishability evidence is absent from cited Bach et al. 2013; obligation recorded here per DESIGN section 3."

data bach_quantitative_path_additivity_gap_note: String = "Authored coverage gap (explicit gap rung, not a derived readiness verdict): cited Bach et al. 2013 does not supply a raw matched-exposure per-band arrival triplet for N_both = N_slit_one + N_slit_two."

data bach_which_path_evidence_gap_note: String = "Authored coverage gap (explicit gap rung, not a derived readiness verdict): cited Bach et al. 2013 controlled which slits were open, not whether which-path information existed."

data bach_raw_count_triplet_coverage_dissolve_on: String = "DISSOLVE-ON: extdeps carries raw matched-exposure arrival rows at a grain that supports left, right, and both counts under one exposure identity; then bach_quantitative_path_additivity_gap may gain a positive cited counterpart."

data bach_which_path_evidence_dissolve_on: String = "DISSOLVE-ON: a cited upstream authority for which-path distinguishability evidence lands; then bach_which_path_evidence_gap may gain a positive cited counterpart."

type BachRawCountPathAdditivityGap
  = BachRawCountTripletCoverageAbsent {}

type BachWhichPathEvidenceGap
  = BachWhichPathAuthorityAbsent {}

fn bach_quantitative_path_additivity_gap() -> BachRawCountPathAdditivityGap {
  BachRawCountTripletCoverageAbsent {}
}

fn bach_which_path_evidence_gap() -> BachWhichPathEvidenceGap {
  BachWhichPathAuthorityAbsent {}
}

type BachObservedApparatus
  = BachCitedDoubleSlitApparatus { subject: BachEtAl2013DoubleSlitExperiment }
  | BachNonCitedApparatus {}

type BachBuildupProgressionRow {
  apparatus: BachObservedApparatus
  detected_electrons: NonNegativeInt
  pattern_status: PatternStatus
}

fn bach_cited_buildup_row_from_extdeps(row: BachBuildupObservationRow) -> BachBuildupProgressionRow {
  BachBuildupProgressionRow {
    apparatus: BachCitedDoubleSlitApparatus { subject: row.apparatus },
    detected_electrons: row.detected_electrons,
    pattern_status: row.pattern_status,
  }
}

fn bach_cited_buildup_progression_rows() -> List<BachBuildupProgressionRow> {
  list_map(
    xs: bach_buildup_observations,
    f: fn(row) {
      bach_cited_buildup_row_from_extdeps(row: row)
    },
  )
}

fn bach_pattern_status_rank(status: PatternStatus) -> Int {
  match status {
    PatternNotYetDiscernible => 0
    PatternDiscernible => 1
    PatternClearlyVisible => 2
  }
}

fn bach_pattern_status_never_regresses_from(
  previous: PatternStatus,
  next: PatternStatus,
) -> Bool {
  bach_pattern_status_rank(status: next) >= bach_pattern_status_rank(status: previous)
}

type StrictIncreaseFoldAcc {
  previous_count: NonNegativeInt
  has_previous: Bool
  valid: Bool
}

fn fold_strict_increase_count(
  acc: StrictIncreaseFoldAcc,
  row: BachBuildupObservationRow,
) -> StrictIncreaseFoldAcc {
  if !acc.valid {
    acc
  } else {
    if acc.has_previous {
      if row.detected_electrons > acc.previous_count {
        StrictIncreaseFoldAcc {
          previous_count: row.detected_electrons,
          has_previous: true,
          valid: true,
        }
      } else {
        StrictIncreaseFoldAcc {
          previous_count: row.detected_electrons,
          has_previous: true,
          valid: false,
        }
      }
    } else {
      StrictIncreaseFoldAcc {
        previous_count: row.detected_electrons,
        has_previous: true,
        valid: true,
      }
    }
  }
}

fn bach_buildup_counts_strictly_increase(
  rows: List<BachBuildupObservationRow>,
) -> Bool {
  let folded = fold(
    rows,
    init: StrictIncreaseFoldAcc {
      previous_count: 0,
      has_previous: false,
      valid: true,
    },
    f: fn(acc, row) {
      fold_strict_increase_count(acc: acc, row: row)
    },
  )
  folded.valid && folded.has_previous
}

type PatternStatusMonotonicFoldAcc {
  previous_status: PatternStatus
  has_previous: Bool
  valid: Bool
}

fn fold_pattern_status_monotonic(
  acc: PatternStatusMonotonicFoldAcc,
  row: BachBuildupObservationRow,
) -> PatternStatusMonotonicFoldAcc {
  if !acc.valid {
    acc
  } else {
    if acc.has_previous {
      if bach_pattern_status_never_regresses_from(
        previous: acc.previous_status,
        next: row.pattern_status,
      ) {
        PatternStatusMonotonicFoldAcc {
          previous_status: row.pattern_status,
          has_previous: true,
          valid: true,
        }
      } else {
        PatternStatusMonotonicFoldAcc {
          previous_status: row.pattern_status,
          has_previous: true,
          valid: false,
        }
      }
    } else {
      PatternStatusMonotonicFoldAcc {
        previous_status: row.pattern_status,
        has_previous: true,
        valid: true,
      }
    }
  }
}

fn bach_buildup_pattern_status_never_regresses(
  rows: List<BachBuildupObservationRow>,
) -> Bool {
  let folded = fold(
    rows,
    init: PatternStatusMonotonicFoldAcc {
      previous_status: PatternNotYetDiscernible,
      has_previous: false,
      valid: true,
    },
    f: fn(acc, row) {
      fold_pattern_status_monotonic(acc: acc, row: row)
    },
  )
  folded.valid && folded.has_previous
}

type DiscernibleBeforeClearlyVisibleAcc {
  seen_discernible: Bool
  valid: Bool
}

fn fold_discernible_before_clearly_visible(
  acc: DiscernibleBeforeClearlyVisibleAcc,
  row: BachBuildupObservationRow,
) -> DiscernibleBeforeClearlyVisibleAcc {
  if !acc.valid {
    acc
  } else {
    match row.pattern_status {
      PatternClearlyVisible =>
        if acc.seen_discernible {
          DiscernibleBeforeClearlyVisibleAcc {
            seen_discernible: acc.seen_discernible,
            valid: true,
          }
        } else {
          DiscernibleBeforeClearlyVisibleAcc {
            seen_discernible: acc.seen_discernible,
            valid: false,
          }
        }
      PatternDiscernible =>
        DiscernibleBeforeClearlyVisibleAcc {
          seen_discernible: true,
          valid: true,
        }
      PatternNotYetDiscernible =>
        acc
    }
  }
}

fn bach_buildup_discernible_precedes_clearly_visible(
  rows: List<BachBuildupObservationRow>,
) -> Bool {
  let folded = fold(
    rows,
    init: DiscernibleBeforeClearlyVisibleAcc {
      seen_discernible: false,
      valid: true,
    },
    f: fn(acc, row) {
      fold_discernible_before_clearly_visible(acc: acc, row: row)
    },
  )
  folded.valid
}

type LastBuildupRowAcc
  = LastBuildupRowAbsent
  | LastBuildupRowPresent { row: BachBuildupObservationRow }

fn fold_track_last_buildup_row(
  acc: LastBuildupRowAcc,
  row: BachBuildupObservationRow,
) -> LastBuildupRowAcc {
  LastBuildupRowPresent { row: row }
}

fn bach_buildup_final_row_clearly_visible(
  rows: List<BachBuildupObservationRow>,
) -> Bool {
  match fold(
    rows,
    init: LastBuildupRowAbsent,
    f: fn(acc, row) {
      fold_track_last_buildup_row(acc: acc, row: row)
    },
  ) {
    LastBuildupRowPresent { row: final_row } =>
      final_row.pattern_status == PatternClearlyVisible
    LastBuildupRowAbsent => false
  }
}

fn bach_buildup_progression_holds_for(
  rows: List<BachBuildupObservationRow>,
) -> Bool {
  bach_buildup_counts_strictly_increase(rows: rows)
    && bach_buildup_pattern_status_never_regresses(rows: rows)
    && bach_buildup_discernible_precedes_clearly_visible(rows: rows)
    && bach_buildup_final_row_clearly_visible(rows: rows)
}

fn bach_cited_buildup_progression_holds() -> Bool {
  bach_buildup_progression_holds_for(rows: bach_buildup_observations)
}

fn bach_distribution_observations_complete_for(
  observations: List<BachDistributionObservation>,
) -> Bool {
  (observations |> count) == 3
    && observations |> any(o => o == SlitOneSingleSlitDiffractionObserved)
    && observations |> any(o => o == SlitTwoSingleSlitDiffractionObserved)
    && observations |> any(o => o == BothSlitsDoubleSlitDiffractionObserved)
}

fn bach_distribution_observations_complete() -> Bool {
  bach_distribution_observations_complete_for(observations: bach_distribution_observations)
}

fn bach_double_slit_interference_evidence_holds() -> Bool {
  bach_cited_buildup_progression_holds()
    && bach_distribution_observations_complete()
}

fn bach_double_slit_interference_evidence_rejects_for_distribution(
  observations: List<BachDistributionObservation>,
) -> Bool {
  !bach_cited_buildup_progression_holds()
    || !bach_distribution_observations_complete_for(observations: observations)
}

fn bach_buildup_progression_rejects_non_increasing_counts(
  rows: List<BachBuildupObservationRow>,
) -> Bool {
  !bach_buildup_counts_strictly_increase(rows: rows)
}

fn bach_buildup_progression_rejects_status_regression(
  rows: List<BachBuildupObservationRow>,
) -> Bool {
  !bach_buildup_pattern_status_never_regresses(rows: rows)
}

fn bach_buildup_progression_rejects_missing_discernible_before_clearly_visible(
  rows: List<BachBuildupObservationRow>,
) -> Bool {
  !bach_buildup_discernible_precedes_clearly_visible(rows: rows)
}

fn bach_buildup_progression_rejects_final_not_clearly_visible(
  rows: List<BachBuildupObservationRow>,
) -> Bool {
  !bach_buildup_final_row_clearly_visible(rows: rows)
}
