module gunbc.bach_double_slit_observation

import std.types { Bool, Int, List }
import std.integer { NonNegativeInt }
import v2.std.algebra { list_head, list_tail, HeadFound, HeadAbsent, TailFound, TailAbsent }
import extdeps.physics.bach_et_al_2013_double_slit {
  BachEtAl2013DoubleSlitExperiment,
  bach_et_al_2013_double_slit,
  BachDistributionObservation,
  bach_distribution_observations,
  BachBuildupObservationRow,
  bach_buildup_observations,
  PatternStatus,
  PatternNotYetDiscernible,
  PatternDiscernible,
  PatternClearlyVisible,
  SlitOneSingleSlitDiffractionObserved,
  SlitTwoSingleSlitDiffractionObserved,
  BothSlitsDoubleSlitDiffractionObserved,
}

data bach_observation_layer_note: String = "Observing-layer receipts for Bach et al. 2013. Verdicts derive from extdeps rows — not constant Bool assertions."

data which_path_coverage_obligation_note: String = "Which-path distinguishability evidence is absent from cited Bach et al. 2013; obligation recorded here per DESIGN section 3."

data bach_raw_count_triplet_coverage_dissolve_on: String = "DISSOLVE-ON: extdeps carries raw matched-exposure arrival rows at a grain that supports left, right, and both counts under one exposure identity; then bach_quantitative_path_additivity_gap may gain a positive readiness counterpart derived from triplet coverage."

data bach_which_path_evidence_dissolve_on: String = "DISSOLVE-ON: a cited upstream authority for which-path distinguishability evidence lands; then bach_which_path_evidence_gap may gain a positive cited counterpart."

type BachRawCountPathAdditivityGap
  = BachRawCountTripletCoverageAbsent {}

type BachWhichPathEvidenceGap
  = BachWhichPathAuthorityAbsent {}

fn bach_quantitative_path_additivity_gap() -> BachRawCountPathAdditivityGap {
  BachRawCountTripletCoverageAbsent {}
}

fn bach_which_path_evidence_gap() -> BachWhichPathEvidenceGap {
  BachWhichPathAuthorityAbsent {}
}

type BachObservedApparatus
  = BachCitedDoubleSlitApparatus { subject: BachEtAl2013DoubleSlitExperiment }
  | BachNonCitedApparatus {}

type BachBuildupProgressionRow {
  apparatus: BachObservedApparatus
  detected_electrons: NonNegativeInt
  pattern_status: PatternStatus
}

fn bach_cited_buildup_row_from_extdeps(row: BachBuildupObservationRow) -> BachBuildupProgressionRow {
  BachBuildupProgressionRow {
    apparatus: BachCitedDoubleSlitApparatus { subject: row.apparatus },
    detected_electrons: row.detected_electrons,
    pattern_status: row.pattern_status,
  }
}

fn bach_cited_buildup_progression_rows() -> List<BachBuildupProgressionRow> {
  fold(
    bach_buildup_observations,
    init: [],
    f: fn(acc, row) {
      acc |> append(bach_cited_buildup_row_from_extdeps(row: row))
    },
  )
}

fn bach_distribution_observations_complete_for(
  observations: List<BachDistributionObservation>,
) -> Bool {
  (observations |> count) == 3
    && observations |> any(o => o == SlitOneSingleSlitDiffractionObserved)
    && observations |> any(o => o == SlitTwoSingleSlitDiffractionObserved)
    && observations |> any(o => o == BothSlitsDoubleSlitDiffractionObserved)
}

fn bach_distribution_observations_complete() -> Bool {
  bach_distribution_observations_complete_for(observations: bach_distribution_observations)
}

fn bach_ensemble_interference_holds_for_distribution(
  observations: List<BachDistributionObservation>,
) -> Bool {
  bach_cited_buildup_matches_source_population()
    && bach_distribution_observations_complete_for(observations: observations)
}

fn bach_buildup_fold_derives_ensemble_interference() -> Bool {
  bach_ensemble_interference_holds_for_distribution(observations: bach_distribution_observations)
}

fn bach_ensemble_interference_rejects_missing_both_open(
  observations: List<BachDistributionObservation>,
) -> Bool {
  !bach_ensemble_interference_holds_for_distribution(observations: observations)
}

fn bach_buildup_row_is_canonical_apparatus(row: BachBuildupProgressionRow) -> Bool {
  match row.apparatus {
    BachCitedDoubleSlitApparatus { subject: cited_subject } =>
      cited_subject == bach_et_al_2013_double_slit
    BachNonCitedApparatus {} => false
  }
}

type BachBuildupPopulationExpectation {
  detected_electrons: NonNegativeInt
  expected_status: PatternStatus
}

data bach_source_buildup_population_fixture: List<BachBuildupPopulationExpectation> = [
  BachBuildupPopulationExpectation {
    detected_electrons: 2,
    expected_status: PatternNotYetDiscernible,
  },
  BachBuildupPopulationExpectation {
    detected_electrons: 7,
    expected_status: PatternNotYetDiscernible,
  },
  BachBuildupPopulationExpectation {
    detected_electrons: 209,
    expected_status: PatternNotYetDiscernible,
  },
  BachBuildupPopulationExpectation {
    detected_electrons: 1004,
    expected_status: PatternDiscernible,
  },
  BachBuildupPopulationExpectation {
    detected_electrons: 6235,
    expected_status: PatternClearlyVisible,
  },
]

data bach_source_buildup_population_fixture_note: String = "Controlled fixture for Figure 3 panels a-e (doi 10.1088/1367-2630/15/3/033018): 2/7/209 NotYet, 1004 first Discernible, 6235 ClearlyVisible."

fn bach_buildup_row_matches_fixture_entry(
  row: BachBuildupProgressionRow,
  expectation: BachBuildupPopulationExpectation,
) -> Bool {
  bach_buildup_row_is_canonical_apparatus(row: row)
    && row.detected_electrons == expectation.detected_electrons
    && row.pattern_status == expectation.expected_status
}

type OrderedPopulationMatchAcc {
  remaining_rows: List<BachBuildupProgressionRow>
  valid: Bool
}

fn fold_ordered_population_expectation(
  acc: OrderedPopulationMatchAcc,
  expectation: BachBuildupPopulationExpectation,
) -> OrderedPopulationMatchAcc {
  if !acc.valid {
    acc
  } else {
    match list_head(xs: acc.remaining_rows) {
      HeadFound { value: head_row } =>
        match list_tail(xs: acc.remaining_rows) {
          TailFound { tail: tail_rows } =>
            if bach_buildup_row_matches_fixture_entry(row: head_row, expectation: expectation) {
              OrderedPopulationMatchAcc {
                remaining_rows: tail_rows,
                valid: true,
              }
            } else {
              OrderedPopulationMatchAcc {
                remaining_rows: tail_rows,
                valid: false,
              }
            }
          TailAbsent =>
            if bach_buildup_row_matches_fixture_entry(row: head_row, expectation: expectation) {
              OrderedPopulationMatchAcc {
                remaining_rows: [],
                valid: true,
              }
            } else {
              OrderedPopulationMatchAcc {
                remaining_rows: [],
                valid: false,
              }
            }
        }
      HeadAbsent =>
        OrderedPopulationMatchAcc {
          remaining_rows: [],
          valid: false,
        }
    }
  }
}

fn bach_buildup_matches_ordered_source_population(
  rows: List<BachBuildupProgressionRow>,
  fixture: List<BachBuildupPopulationExpectation>,
) -> Bool {
  let acc = fold(
    fixture,
    init: OrderedPopulationMatchAcc {
      remaining_rows: rows,
      valid: true,
    },
    f: fn(a, exp) {
      fold_ordered_population_expectation(acc: a, expectation: exp)
    },
  )
  acc.valid && (acc.remaining_rows |> count) == 0
}

fn bach_cited_buildup_matches_source_population() -> Bool {
  bach_buildup_matches_ordered_source_population(
    rows: bach_cited_buildup_progression_rows(),
    fixture: bach_source_buildup_population_fixture,
  )
}

fn bach_buildup_population_rejects_planted_rows(
  rows: List<BachBuildupProgressionRow>,
) -> Bool {
  !bach_buildup_matches_ordered_source_population(
    rows: rows,
    fixture: bach_source_buildup_population_fixture,
  )
}

fn bach_buildup_progression_rejects_clearly_visible_at_low_count(
  rows: List<BachBuildupProgressionRow>,
) -> Bool {
  bach_buildup_population_rejects_planted_rows(rows: rows)
}

fn bach_buildup_progression_rejects_not_yet_at_max_count(
  rows: List<BachBuildupProgressionRow>,
) -> Bool {
  bach_buildup_population_rejects_planted_rows(rows: rows)
}

fn bach_buildup_progression_rejects_foreign_apparatus(
  rows: List<BachBuildupProgressionRow>,
) -> Bool {
  bach_buildup_population_rejects_planted_rows(rows: rows)
}

fn bach_buildup_progression_rejects_reversed_order(
  rows: List<BachBuildupProgressionRow>,
) -> Bool {
  bach_buildup_population_rejects_planted_rows(rows: rows)
}
