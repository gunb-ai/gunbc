module gunbc.bach_double_slit_observation

import std.types { Bool, List }
import std.integer { NonNegativeInt }
import extdeps.physics.bach_et_al_2013_double_slit {
  BachEtAl2013DoubleSlitExperiment,
  bach_et_al_2013_double_slit,
  BachDistributionObservation,
  bach_distribution_observations,
  BachBuildupObservationRow,
  bach_buildup_observations,
  bach_et_al_2013_raw_count_observations,
  PatternStatus,
  PatternNotYetDiscernible,
  PatternDiscernible,
  PatternClearlyVisible,
  SlitOneSingleSlitDiffractionObserved,
  SlitTwoSingleSlitDiffractionObserved,
  BothSlitsDoubleSlitDiffractionObserved,
}

data bach_observation_layer_note: String = "Observing-layer receipts for Bach et al. 2013. Verdicts derive from extdeps rows — not constant Bool assertions."

data which_path_coverage_obligation_note: String = "Which-path distinguishability evidence is absent from cited Bach et al. 2013; obligation recorded here per DESIGN section 3."

type BachObservationCapability
  = RawMatchedExposureCountRowsPresent
  | WhichPathAuthorityCited

type BachRawCountPathAdditivityRefusalCause
  = BachRawCountObservationRowsAbsent

type BachWhichPathEvidenceRefusalCause
  = BachWhichPathAuthorityAbsent

type BachRawCountPathAdditivityReadiness
  = BachRawCountPathAdditivityNotEvaluable { cause: BachRawCountPathAdditivityRefusalCause }
  | BachRawCountPathAdditivityReady {}

type BachWhichPathEvidenceReadiness
  = BachWhichPathEvidenceUncited { cause: BachWhichPathEvidenceRefusalCause }
  | BachWhichPathEvidenceCited {}

fn bach_observation_capabilities_from_extdeps() -> List<BachObservationCapability> {
  if (bach_et_al_2013_raw_count_observations |> count) > 0 {
    [RawMatchedExposureCountRowsPresent]
  } else {
    []
  }
}

fn bach_quantitative_evidence_readiness(
  capabilities: List<BachObservationCapability>,
) -> BachRawCountPathAdditivityReadiness {
  let has_raw_rows = capabilities |> any(c =>
    match c {
      RawMatchedExposureCountRowsPresent => true
      WhichPathAuthorityCited => false
    },
  )
  if has_raw_rows {
    BachRawCountPathAdditivityReady {}
  } else {
    BachRawCountPathAdditivityNotEvaluable {
      cause: BachRawCountObservationRowsAbsent,
    }
  }
}

fn bach_quantitative_path_additivity_readiness_derived() -> BachRawCountPathAdditivityReadiness {
  bach_quantitative_evidence_readiness(
    capabilities: bach_observation_capabilities_from_extdeps(),
  )
}

fn bach_which_path_evidence_readiness(
  capabilities: List<BachObservationCapability>,
) -> BachWhichPathEvidenceReadiness {
  let cited = capabilities |> any(c =>
    match c {
      WhichPathAuthorityCited => true
      RawMatchedExposureCountRowsPresent => false
    },
  )
  if cited {
    BachWhichPathEvidenceCited {}
  } else {
    BachWhichPathEvidenceUncited {
      cause: BachWhichPathAuthorityAbsent,
    }
  }
}

fn bach_which_path_evidence_readiness_derived() -> BachWhichPathEvidenceReadiness {
  bach_which_path_evidence_readiness(
    capabilities: bach_observation_capabilities_from_extdeps(),
  )
}

fn bach_distribution_observations_complete() -> Bool {
  (bach_distribution_observations |> count) == 3
    && bach_distribution_observations |> any(o => o == SlitOneSingleSlitDiffractionObserved)
    && bach_distribution_observations |> any(o => o == SlitTwoSingleSlitDiffractionObserved)
    && bach_distribution_observations |> any(o => o == BothSlitsDoubleSlitDiffractionObserved)
}

type BuildupFoldAcc {
  max_electrons: NonNegativeInt
  saw_not_yet: Bool
  saw_discernible: Bool
  saw_clearly_visible: Bool
}

fn fold_buildup_acc(acc: BuildupFoldAcc, row: BachBuildupObservationRow) -> BuildupFoldAcc {
  let max_electrons = if row.detected_electrons > acc.max_electrons {
    row.detected_electrons
  } else {
    acc.max_electrons
  }
  let saw_not_yet = acc.saw_not_yet || (row.pattern_status == PatternNotYetDiscernible)
  let saw_discernible = acc.saw_discernible || (row.pattern_status == PatternDiscernible)
  let saw_clearly_visible = acc.saw_clearly_visible || (row.pattern_status == PatternClearlyVisible)
  BuildupFoldAcc {
    max_electrons: max_electrons,
    saw_not_yet: saw_not_yet,
    saw_discernible: saw_discernible,
    saw_clearly_visible: saw_clearly_visible,
  }
}

fn bach_buildup_fold_derives_ensemble_interference() -> Bool {
  let acc = fold(
    bach_buildup_observations,
    init: BuildupFoldAcc {
      max_electrons: 0,
      saw_not_yet: false,
      saw_discernible: false,
      saw_clearly_visible: false,
    },
    f: fn(a, row) { fold_buildup_acc(acc: a, row: row) },
  )
  acc.saw_not_yet
    && acc.saw_discernible
    && acc.saw_clearly_visible
    && acc.max_electrons == 6235
}
