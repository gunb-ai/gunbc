module gunbc.roadmap_site_healthz_validate

import extdeps.shell
import extdeps.filesystem.filesystem_io { Filesystem }
import gunbc.roadmap_static_site { roadmap_site_healthz_body, sh_single_quote }

data roadmap_site_healthz_parse_scratch: String = "/tmp/gunbc_roadmap_site_healthz.json"

type JsonTextParseResult {
  end: Int
  ok: Bool
}

fn roadmap_site_healthz_body_trim_trailing_lf(body: String) -> String {
  if ends_with(s: body, suffix: "\n") {
    substring(s: body, start: 0, end: string_length(s: body) - 1)
  } else {
    body
  }
}

fn json_text_len(s: String) -> Int {
  string_length(s: s)
}

fn json_text_char(s: String, i: Int) -> String {
  if i < 0 || i >= json_text_len(s: s) { "" } else { char_at(s: s, i: i) }
}

fn json_text_is_ws(c: String) -> Bool {
  c == " " || c == "\n" || c == "\r" || c == "\t"
}

fn json_text_skip_ws(s: String, i: Int) -> Int {
  if i >= json_text_len(s: s) { i }
  else if json_text_is_ws(c: json_text_char(s: s, i: i)) {
    json_text_skip_ws(s: s, i: i + 1)
  } else {
    i
  }
}

fn json_text_parse_fail(end: Int) -> JsonTextParseResult {
  JsonTextParseResult { end: end, ok: false }
}

fn json_text_parse_ok(end: Int) -> JsonTextParseResult {
  JsonTextParseResult { end: end, ok: true }
}

fn json_text_starts_with_at(s: String, i: Int, lit: String) -> Bool {
  substring(s: s, start: i, end: i + json_text_len(s: lit)) == lit
}

fn json_text_parse_string_inner(s: String, i: Int) -> JsonTextParseResult {
  if i >= json_text_len(s: s) {
    json_text_parse_fail(end: i)
  } else {
    let c = json_text_char(s: s, i: i)
    if c == "\"" {
      json_text_parse_ok(end: i + 1)
    } else if c == "\\" {
      if i + 1 >= json_text_len(s: s) {
        json_text_parse_fail(end: i)
      } else {
        json_text_parse_string_inner(s: s, i: i + 2)
      }
    } else {
      json_text_parse_string_inner(s: s, i: i + 1)
    }
  }
}

fn json_text_parse_string(s: String, i: Int) -> JsonTextParseResult {
  if json_text_char(s: s, i: i) != "\"" {
    json_text_parse_fail(end: i)
  } else {
    json_text_parse_string_inner(s: s, i: i + 1)
  }
}

fn json_text_is_digit(c: String) -> Bool {
  string_contains(s: "0123456789", pattern: c)
}

fn json_text_parse_number_digits(s: String, i: Int) -> Int {
  if i >= json_text_len(s: s) || !json_text_is_digit(c: json_text_char(s: s, i: i)) {
    i
  } else {
    json_text_parse_number_digits(s: s, i: i + 1)
  }
}

fn json_text_parse_number(s: String, i: Int) -> JsonTextParseResult {
  let start = i
  let after_minus = if json_text_char(s: s, i: i) == "-" { i + 1 } else { i }
  let after_int = json_text_parse_number_digits(s: s, i: after_minus)
  if after_int == after_minus && json_text_char(s: s, i: after_minus) != "-" {
    json_text_parse_fail(end: start)
  } else {
    let after_frac = if json_text_char(s: s, i: after_int) == "." {
      let d = json_text_parse_number_digits(s: s, i: after_int + 1)
      if d == after_int + 1 { after_int } else { d }
    } else {
      after_int
    }
    let end = if json_text_char(s: s, i: after_frac) == "e" || json_text_char(s: s, i: after_frac) == "E" {
      let exp = after_frac + 1
      let signed = if json_text_char(s: s, i: exp) == "+" || json_text_char(s: s, i: exp) == "-" { exp + 1 } else { exp }
      json_text_parse_number_digits(s: s, i: signed)
    } else {
      after_frac
    }
    if end > after_minus { json_text_parse_ok(end: end) } else { json_text_parse_fail(end: start) }
  }
}

fn json_text_parse_literal(s: String, i: Int, lit: String) -> JsonTextParseResult {
  if json_text_starts_with_at(s: s, i: i, lit: lit) {
    json_text_parse_ok(end: i + json_text_len(s: lit))
  } else {
    json_text_parse_fail(end: i)
  }
}

fn json_text_parse_array_values(s: String, i: Int) -> JsonTextParseResult {
  let p = json_text_skip_ws(s: s, i: i)
  if json_text_char(s: s, i: p) == "]" {
    json_text_parse_ok(end: p + 1)
  } else {
    let v = json_text_parse_value(s: s, i: p)
    if !v.ok { v } else {
      let q = json_text_skip_ws(s: s, i: v.end)
      if json_text_char(s: s, i: q) == "]" {
        json_text_parse_ok(end: q + 1)
      } else if json_text_char(s: s, i: q) == "," {
        json_text_parse_array_values(s: s, i: q + 1)
      } else {
        json_text_parse_fail(end: q)
      }
    }
  }
}

fn json_text_parse_array(s: String, i: Int) -> JsonTextParseResult {
  if json_text_char(s: s, i: i) != "[" {
    json_text_parse_fail(end: i)
  } else {
    json_text_parse_array_values(s: s, i: i + 1)
  }
}

fn json_text_parse_object_members(s: String, i: Int) -> JsonTextParseResult {
  let p = json_text_skip_ws(s: s, i: i)
  if json_text_char(s: s, i: p) == "}" {
    json_text_parse_ok(end: p + 1)
  } else {
    let key = json_text_parse_string(s: s, i: p)
    if !key.ok { key } else {
      let c = json_text_skip_ws(s: s, i: key.end)
      if json_text_char(s: s, i: c) != ":" {
        json_text_parse_fail(end: c)
      } else {
        let v = json_text_parse_value(s: s, i: c + 1)
        if !v.ok { v } else {
          let q = json_text_skip_ws(s: s, i: v.end)
          if json_text_char(s: s, i: q) == "}" {
            json_text_parse_ok(end: q + 1)
          } else if json_text_char(s: s, i: q) == "," {
            json_text_parse_object_members(s: s, i: q + 1)
          } else {
            json_text_parse_fail(end: q)
          }
        }
      }
    }
  }
}

fn json_text_parse_object(s: String, i: Int) -> JsonTextParseResult {
  if json_text_char(s: s, i: i) != "{" {
    json_text_parse_fail(end: i)
  } else {
    json_text_parse_object_members(s: s, i: i + 1)
  }
}

fn json_text_parse_value(s: String, i: Int) -> JsonTextParseResult {
  let p = json_text_skip_ws(s: s, i: i)
  if p >= json_text_len(s: s) {
    json_text_parse_fail(end: p)
  } else {
    let c = json_text_char(s: s, i: p)
    if c == "{" { json_text_parse_object(s: s, i: p) }
    else if c == "[" { json_text_parse_array(s: s, i: p) }
    else if c == "\"" { json_text_parse_string(s: s, i: p) }
    else if c == "t" { json_text_parse_literal(s: s, i: p, lit: "true") }
    else if c == "f" { json_text_parse_literal(s: s, i: p, lit: "false") }
    else if c == "n" { json_text_parse_literal(s: s, i: p, lit: "null") }
    else if c == "-" || json_text_is_digit(c: c) { json_text_parse_number(s: s, i: p) }
    else { json_text_parse_fail(end: p) }
  }
}

fn roadmap_site_healthz_json_text_is_valid_json(body: String) -> Bool {
  let parsed = json_text_parse_value(s: body, i: 0)
  parsed.ok && json_text_skip_ws(s: body, i: parsed.end) == json_text_len(s: body)
}

fn roadmap_site_healthz_json_string_parses(body: String) -> Bool {
  roadmap_site_healthz_json_text_is_valid_json(
    body: roadmap_site_healthz_body_trim_trailing_lf(body: body)
  )
}

fn roadmap_site_healthz_json_parse_script(path: String) -> String {
  concat(
    concat("node -e ", sh_single_quote(s: "JSON.parse(require('fs').readFileSync(process.argv[1],'utf8'))")),
    concat(" ", sh_single_quote(s: path))
  )
}

fn roadmap_site_healthz_json_string_parses_via_node(body: String) -> Bool {
  let normalized = roadmap_site_healthz_body_trim_trailing_lf(body: body)
  let w = Filesystem.Write(path: roadmap_site_healthz_parse_scratch, content: normalized)
  let result = shell.Exec.Run(script: roadmap_site_healthz_json_parse_script(path: roadmap_site_healthz_parse_scratch))
  w.success && result.success
}

fn roadmap_site_healthz_body_parses() -> Bool {
  let body = roadmap_site_healthz_body()
  roadmap_site_healthz_json_string_parses(body: body)
    && roadmap_site_healthz_json_string_parses_via_node(body: body)
}
