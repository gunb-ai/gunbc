module gunbc.code_change_workflow

type CodeChangeActiveStage
  = ChangeOpen
  | ChangeUnderReview
  | ChangeMergeReady

type CodeChangeTerminalStage
  = ChangeMerged
  | ChangeClosed

type CodeChangeStage
  = CodeChangeActive { stage: CodeChangeActiveStage }
  | CodeChangeTerminal { stage: CodeChangeTerminalStage }

type CodeChangeBinding {
  node_id: ProcessNodeId
  change_ref: NonEmptyStr
}

type CodeChangeFacts {
  binding: CodeChangeBinding
  stage: CodeChangeStage
  head_sha: CommitSha?
  marked_ready_at: Timestamp?
  merge_ready_at: Timestamp?
  merged_at: Timestamp?
  closed_at: Timestamp?
}

type CodeChangeRefusal
  = CodeChangeAlreadyTerminal { stage: CodeChangeStage }
  | ChangeDraftBlocksReview
  | ChangeNotOpen
  | CodeChangeMissingHeadSha
  | CodeChangeHeadShaMismatch { expected: CommitSha, actual: CommitSha }
  | CodeChangeMissingReviewTally
  | CodeChangeMissingDigestVerdict
  | CodeChangeDigestNotReady { first_reason: String }
  | CodeChangeTallyRequestChanges { count: Int }
  | CodeChangeTallyBlockingFindings { count: Int }
  | CodeChangeNotMergeableClean
  | CodeChangePolicyNotPermitted
  | CodeChangeInvalidSuccessor { from: CodeChangeStage, event: CodeChangeEventTag }

type CodeChangeEventTag
  = MarkReadyForReview
  | RecordMergeReady
  | RecordMerged
  | RecordClosed

type CodeChangeDecision
  = CanTransition { to: CodeChangeStage }
  | TransitionRefused { refusal: CodeChangeRefusal }

type CodeChangeGithubPrContext {
  pr: extdeps.github.pulls.PullRequest
}

type CodeChangeTransitionRequest {
  facts: CodeChangeFacts
  event: CodeChangeEventTag
  github_pr: CodeChangeGithubPrContext?
  digest: MergeReadinessVerdict?
  tally: MergeReadinessTally?
  policy_permitted: Bool?
}

fn successor_stage(
  from: CodeChangeActiveStage,
  event: CodeChangeEventTag,
) -> CodeChangeStage? {
  match from {
    ChangeOpen =>
      match event {
        MarkReadyForReview =>
          Present { value: CodeChangeActive { stage: ChangeUnderReview } }
        RecordClosed =>
          Present { value: CodeChangeTerminal { stage: ChangeClosed } }
        RecordMergeReady => Absent
        RecordMerged => Absent
      }
    ChangeUnderReview =>
      match event {
        RecordMergeReady =>
          Present { value: CodeChangeActive { stage: ChangeMergeReady } }
        RecordClosed =>
          Present { value: CodeChangeTerminal { stage: ChangeClosed } }
        MarkReadyForReview => Absent
        RecordMerged => Absent
      }
    ChangeMergeReady =>
      match event {
        RecordMerged =>
          Present { value: CodeChangeTerminal { stage: ChangeMerged } }
        RecordClosed =>
          Present { value: CodeChangeTerminal { stage: ChangeClosed } }
        MarkReadyForReview => Absent
        RecordMergeReady => Absent
      }
  }
}

fn github_pr_terminal_anchor(pr: extdeps.github.pulls.PullRequest) -> CodeChangeStage? {
  match pr.merged_at {
    Present { value: _ } =>
      Present { value: CodeChangeTerminal { stage: ChangeMerged } }
    Absent =>
      match pr.state {
        Closed =>
          Present { value: CodeChangeTerminal { stage: ChangeClosed } }
        Open => Absent
      }
  }
}

fn evaluate_mark_ready_for_review(
  facts: CodeChangeFacts,
  github_pr: CodeChangeGithubPrContext?,
) -> CodeChangeDecision {
  match facts.stage {
    CodeChangeTerminal { stage: _ } =>
      return TransitionRefused {
        refusal: CodeChangeAlreadyTerminal { stage: facts.stage }
      }
    CodeChangeActive { stage: active } => {
      match successor_stage(from: active, event: MarkReadyForReview) {
        Absent =>
          return TransitionRefused {
            refusal: CodeChangeInvalidSuccessor {
              from: facts.stage,
              event: MarkReadyForReview,
            }
          }
        Present { value: to } => {}
      }
    }
  }
  match github_pr {
    Absent => {}
    Present { value: ctx } => {
      if ctx.pr.draft {
        return TransitionRefused { refusal: ChangeDraftBlocksReview }
      }
      match ctx.pr.state {
        Open => {}
        Closed =>
          return TransitionRefused { refusal: ChangeNotOpen }
      }
      match facts.head_sha {
        Present { value: head_sha } =>
          if ctx.pr.head.sha != head_sha {
            return TransitionRefused {
              refusal: CodeChangeHeadShaMismatch {
                expected: head_sha,
                actual: ctx.pr.head.sha,
              }
            }
          }
        Absent => {}
      }
    }
  }
  match facts.head_sha {
    Present { value: _ } => {}
    Absent =>
      return TransitionRefused { refusal: CodeChangeMissingHeadSha }
  }
  CanTransition { to: CodeChangeActive { stage: ChangeUnderReview } }
}

fn evaluate_record_merge_ready(
  facts: CodeChangeFacts,
  github_pr: CodeChangeGithubPrContext?,
  digest: MergeReadinessVerdict?,
  tally: MergeReadinessTally?,
  policy_permitted: Bool?,
) -> CodeChangeDecision {
  match facts.stage {
    CodeChangeTerminal { stage: _ } =>
      return TransitionRefused {
        refusal: CodeChangeAlreadyTerminal { stage: facts.stage }
      }
    CodeChangeActive { stage: active } => {
      match successor_stage(from: active, event: RecordMergeReady) {
        Absent =>
          return TransitionRefused {
            refusal: CodeChangeInvalidSuccessor {
              from: facts.stage,
              event: RecordMergeReady,
            }
          }
        Present { value: to } => {}
      }
    }
  }
  match github_pr {
    Absent => {}
    Present { value: ctx } => {
      if ctx.pr.draft {
        return TransitionRefused { refusal: ChangeDraftBlocksReview }
      }
      match ctx.pr.state {
        Open => {}
        Closed =>
          return TransitionRefused { refusal: ChangeNotOpen }
      }
      match facts.head_sha {
        Present { value: head_sha } =>
          if ctx.pr.head.sha != head_sha {
            return TransitionRefused {
              refusal: CodeChangeHeadShaMismatch {
                expected: head_sha,
                actual: ctx.pr.head.sha,
              }
            }
          }
        Absent => {}
      }
    }
  }
  match facts.head_sha {
    Absent =>
      return TransitionRefused { refusal: CodeChangeMissingHeadSha }
    Present { value: head_sha } => {}
  }
  match digest {
    Absent =>
      return TransitionRefused { refusal: CodeChangeMissingDigestVerdict }
    Present { value: verdict } =>
      match verdict {
        Ready => {}
        NotReady { first_reason, more_reasons: _ } =>
          return TransitionRefused {
            refusal: CodeChangeDigestNotReady { first_reason: first_reason }
          }
      }
  }
  match tally {
    Absent =>
      return TransitionRefused { refusal: CodeChangeMissingReviewTally }
    Present { value: t } => {
      match facts.head_sha {
        Present { value: head_sha } =>
          if t.head_sha != head_sha {
            return TransitionRefused {
              refusal: CodeChangeHeadShaMismatch {
                expected: head_sha,
                actual: t.head_sha,
              }
            }
          }
        Absent => {}
      }
      if t.request_changes_count > 0 {
        return TransitionRefused {
          refusal: CodeChangeTallyRequestChanges { count: t.request_changes_count }
        }
      }
      if t.blocking_finding_count > 0 {
        return TransitionRefused {
          refusal: CodeChangeTallyBlockingFindings { count: t.blocking_finding_count }
        }
      }
      if !t.mergeable_clean {
        return TransitionRefused { refusal: CodeChangeNotMergeableClean }
      }
    }
  }
  match policy_permitted {
    Absent =>
      return TransitionRefused { refusal: CodeChangePolicyNotPermitted }
    Present { value: permitted } =>
      if !permitted {
        return TransitionRefused { refusal: CodeChangePolicyNotPermitted }
      }
  }
  CanTransition { to: CodeChangeActive { stage: ChangeMergeReady } }
}

fn evaluate_terminal_record(
  facts: CodeChangeFacts,
  event: CodeChangeEventTag,
  to: CodeChangeTerminalStage,
) -> CodeChangeDecision {
  match facts.stage {
    CodeChangeTerminal { stage: _ } =>
      return TransitionRefused {
        refusal: CodeChangeAlreadyTerminal { stage: facts.stage }
      }
    CodeChangeActive { stage: active } => {
      match successor_stage(from: active, event: event) {
        Absent =>
          return TransitionRefused {
            refusal: CodeChangeInvalidSuccessor { from: facts.stage, event: event }
          }
        Present { value: expected } =>
          match expected {
            CodeChangeTerminal { stage: terminal } =>
              if terminal != to {
                return TransitionRefused {
                  refusal: CodeChangeInvalidSuccessor { from: facts.stage, event: event }
                }
              }
            CodeChangeActive { stage: _ } =>
              return TransitionRefused {
                refusal: CodeChangeInvalidSuccessor { from: facts.stage, event: event }
              }
          }
      }
    }
  }
  CanTransition { to: CodeChangeTerminal { stage: to } }
}

fn classify_github_pr_terminal_anchor(pr: extdeps.github.pulls.PullRequest) -> CodeChangeStage? {
  github_pr_terminal_anchor(pr: pr)
}

fn decide_code_change_transition(request: CodeChangeTransitionRequest) -> CodeChangeDecision {
  match request.event {
    MarkReadyForReview =>
      evaluate_mark_ready_for_review(
        facts: request.facts,
        github_pr: request.github_pr,
      )
    RecordMergeReady =>
      evaluate_record_merge_ready(
        facts: request.facts,
        github_pr: request.github_pr,
        digest: request.digest,
        tally: request.tally,
        policy_permitted: request.policy_permitted,
      )
    RecordMerged =>
      evaluate_terminal_record(
        facts: request.facts,
        event: RecordMerged,
        to: ChangeMerged,
      )
    RecordClosed =>
      evaluate_terminal_record(
        facts: request.facts,
        event: RecordClosed,
        to: ChangeClosed,
      )
  }
}

service gunbc.CodeChangeWorkflow {
  operation ClassifyGithubPrTerminalAnchor {
    input {
      pr: extdeps.github.pulls.PullRequest
    }
    output {
      anchor: CodeChangeStage?
    }
    readonly
  }

  operation DecideTransition {
    input {
      request: CodeChangeTransitionRequest
    }
    output {
      decision: CodeChangeDecision
    }
    readonly
  }
}
