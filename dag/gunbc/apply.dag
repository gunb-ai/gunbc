module gunbc.apply


data apply_dispatcher_note: String = "TOP-LEVEL gunbc.apply dispatcher. gunbc.live_deploy.apply remains the srv1 dashboard child workflow only. RunnerCapacity plan half is PR A (#7939 runner_capacity_plan); ADD execution routes through gunbc.runner_capacity_realize (PR C) into shared HostEffect arms from PR B (#7946)."

type ApplyWorkflow
  = DashboardSrv1
  | RunnerCapacity

type ApplyMode
  = Plan
  | Apply

type ApplyWorkflowParse
  = WorkflowParsed { workflow: ApplyWorkflow }
  | WorkflowParseRefused { reason: String }

type ApplyModeParse
  = ModeParsed { mode: ApplyMode }
  | ModeParseRefused { reason: String }

fn parse_apply_workflow(value: String) -> ApplyWorkflowParse {
  if value == "runner-capacity" {
    WorkflowParsed { workflow: RunnerCapacity }
  } else if value == "dashboard-srv1" {
    WorkflowParsed { workflow: DashboardSrv1 }
  } else {
    WorkflowParseRefused { reason: concat("unknown apply workflow: ", value) }
  }
}

fn parse_apply_mode(value: String) -> ApplyModeParse {
  if value == "plan" {
    ModeParsed { mode: Plan }
  } else if value == "apply" {
    ModeParsed { mode: Apply }
  } else {
    ModeParseRefused { reason: concat("unknown apply mode: ", value) }
  }
}

fn runner_capacity_plan_exit(plan: gunbc.runner_capacity_plan.RunnerCapacityPlan) -> std.process.ProcessExit {
  match plan {
    gunbc.runner_capacity_plan.PlanReady { hosts: _ } => std.process.ExitSuccess
    gunbc.runner_capacity_plan.PlanRefused { reason: r } => std.process.exit_failure(reason: r)
  }
}

fn apply_runner_capacity_plan(
  srv3_width: String,
  srv4_width: String,
  mode: String,
) -> std.process.ProcessExit {
  match parse_apply_mode(value: mode) {
    ModeParseRefused { reason: r } => std.process.exit_failure(reason: r)
    ModeParsed { mode: Apply } =>
      match gunbc.runner_capacity_plan.parse_positive_width(value: srv3_width) {
        Absent => std.process.exit_failure(reason: "srv3_width must be a positive integer")
        Present { value: w3 } =>
          match gunbc.runner_capacity_plan.parse_positive_width(value: srv4_width) {
            Absent => std.process.exit_failure(reason: "srv4_width must be a positive integer")
            Present { value: w4 } => gunbc.runner_capacity_realize.runner_capacity_apply_wet_exit(srv3_width: w3, srv4_width: w4)
          }
      }
    ModeParsed { mode: Plan } =>
      match gunbc.runner_capacity_plan.parse_positive_width(value: srv3_width) {
        Absent => std.process.exit_failure(reason: "srv3_width must be a positive integer")
        Present { value: w3 } =>
          match gunbc.runner_capacity_plan.parse_positive_width(value: srv4_width) {
            Absent => std.process.exit_failure(reason: "srv4_width must be a positive integer")
            Present { value: w4 } =>
              runner_capacity_plan_exit(
                plan: gunbc.runner_capacity_plan.runner_capacity_plan(
                  srv3_width: w3,
                  srv4_width: w4,
                  roster: gunbc.fleet_runner_connectivity.organization_runner_roster_evidence(),
                )
              )
          }
      }
  }
}

fn apply_dispatch(
  workflow: String,
  srv3_width: String,
  srv4_width: String,
  mode: String,
) -> std.process.ProcessExit {
  match parse_apply_workflow(value: workflow) {
    WorkflowParseRefused { reason: r } => std.process.exit_failure(reason: r)
    WorkflowParsed { workflow: DashboardSrv1 } =>
      if mode == "apply" {
        gunbc.live_deploy.apply.live_deploy_apply_srv1_wet()
      } else {
        std.process.exit_failure(reason: "dashboard-srv1 supports mode=apply only in this increment")
      }
    WorkflowParsed { workflow: RunnerCapacity } =>
      apply_runner_capacity_plan(srv3_width: srv3_width, srv4_width: srv4_width, mode: mode)
  }
}

func apply_wet(workflow: String, srv3_width: String, srv4_width: String, mode: String) -> std.process.ProcessExit {
  apply_dispatch(workflow: workflow, srv3_width: srv3_width, srv4_width: srv4_width, mode: mode)
}
