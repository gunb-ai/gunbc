module gunbc.apply

import std.types { String, Bool, List }
import std.algebra { length }
import std.apply_mode { Plan, Apply, ModeParsed, ModeParseRefused, parse_apply_mode }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import gunbc.live_deploy.apply { live_deploy_apply_prod_role_wet, approval_broker_dark_install_wet }
import gunbc.runner.runner_capacity_plan {
  RunnerCapacityPlan,
  PlanReady,
  PlanRefused,
  HostCapacityPlanOutcome,
  HostCapacityPlanRefused,
  runner_capacity_plan,
}
import gunbc.fleet.organization_runner_roster_read { organization_runner_roster_live_read }
import gunbc.runner.runner_capacity_realize { runner_capacity_apply_wet_exit }
import gunbc.runner.runner_user_session_receipt_observed { runner_user_session_receipt_observed }

// TOP-LEVEL gunbc.apply dispatcher. gunbc.live_deploy.apply remains the srv1 dashboard child
// workflow only. RunnerCapacity plan half is PR A (#7939 runner_capacity_plan); ADD execution
// routes through gunbc.runner.runner_capacity_realize (PR C) into shared HostEffect arms from PR B
// (#7946).

// approval-broker-dark IS A WORKFLOW RATHER THAN A MODE ON dashboard-srv1, because a mode would
// have made an additive install one argument away from a release deploy at the exact moment roadmap
// redeploys are frozen (operator directive 2026-09-19). It installs the broker's slice and unit on
// its one port and starts one unit; it writes nothing the roadmap deployment owns, and the unit it
// starts holds no writer authority until the cutover transfers it.
type ApplyWorkflow
  = DashboardSrv1
  | RunnerCapacity
  | ApprovalBrokerDark

type ApplyWorkflowParse
  = WorkflowParsed { workflow: ApplyWorkflow }
  | WorkflowParseRefused { reason: String }

fn parse_apply_workflow(value: String) -> ApplyWorkflowParse {
  if value == "runner-capacity" {
    WorkflowParsed { workflow: RunnerCapacity }
  } else if value == "dashboard-srv1" {
    WorkflowParsed { workflow: DashboardSrv1 }
  } else if value == "approval-broker-dark" {
    WorkflowParsed { workflow: ApprovalBrokerDark }
  } else {
    WorkflowParseRefused { reason: concat("unknown apply workflow: ", value) }
  }
}

fn plan_refusal_reason(rs: List<HostCapacityPlanOutcome>) -> String {
  fold(
    rs,
    init: "plan refused for hosts: ",
    f: (acc, r) =>
      match r {
        HostCapacityPlanRefused { host: h, reason: rr } =>
          concat(concat(concat(acc, h as String), ": "), rr)
        HostCapacityPlanReady { plan: _ } => acc
      },
  )
}

fn runner_capacity_plan_exit(plan: RunnerCapacityPlan) -> ProcessExit {
  match plan {
    PlanReady { hosts: _, refusals: rs } =>
      if length(rs) > 0 {
        exit_failure(reason: plan_refusal_reason(refusals: rs))
      } else {
        ExitSuccess
      }
    PlanRefused { reason: r } => exit_failure(reason: r)
  }
}

fn apply_runner_capacity_plan(mode: String) -> ProcessExit {
  match parse_apply_mode(value: mode) {
    ModeParseRefused { reason: r } => exit_failure(reason: r)
    ModeParsed { mode: Apply } =>
      runner_capacity_apply_wet_exit()
    ModeParsed { mode: Plan } =>
      runner_capacity_plan_exit(
        plan: runner_capacity_plan(
          roster: organization_runner_roster_live_read(),
          receipt_for: h => runner_user_session_receipt_observed(host: h),
        )
      )
  }
}

fn apply_dispatch(
  workflow: String,
  mode: String,
) -> ProcessExit {
  match parse_apply_workflow(value: workflow) {
    WorkflowParseRefused { reason: r } => exit_failure(reason: r)
    WorkflowParsed { workflow: DashboardSrv1 } =>
      if mode == "apply" {
        live_deploy_apply_prod_role_wet()
      } else {
        exit_failure(reason: "dashboard-srv1 supports mode=apply only in this increment")
      }
    WorkflowParsed { workflow: ApprovalBrokerDark } =>
      if mode == "apply" {
        approval_broker_dark_install_wet()
      } else {
        exit_failure(reason: "approval-broker-dark supports mode=apply only: there is no plan pole for an additive unit install, and a plan arm that printed the script without a preflight would be a second, ungated path to the same mutation")
      }
    WorkflowParsed { workflow: RunnerCapacity } =>
      apply_runner_capacity_plan(mode: mode)
  }
}

fn apply_wet(workflow: String, mode: String) -> ProcessExit {
  apply_dispatch(workflow: workflow, mode: mode)
}
