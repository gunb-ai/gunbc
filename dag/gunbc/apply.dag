module gunbc.apply

import std.types { String, Bool, List }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import gunbc.live_deploy.apply { live_deploy_apply_srv1_wet }
import gunbc.runner_capacity_plan {
  RunnerCapacityPlan,
  PlanReady,
  PlanRefused,
  parse_width_input,
  WidthParsed,
  WidthInvalidSyntax,
  WidthNegative,
  runner_capacity_plan,
}
import gunbc.fleet_runner_connectivity {
  organization_runner_roster_for_apply_plan,
  unit_active_width_for_apply_plan,
}
import gunbc.fleet_intent_network { operator_host_srv3, operator_host_srv4 }

data apply_dispatcher_note: String = "TOP-LEVEL gunbc.apply dispatcher. gunbc.live_deploy.apply remains the srv1 dashboard child workflow only — it is not converted into a multipurpose module. RunnerCapacity is a separate child whose plan half lives here and whose realizer is PR B (vivid-otter-718). mode=apply refuses as RunnerCapacityRealizerUnavailable until the realizer lands."

type ApplyWorkflow
  = DashboardSrv1
  | RunnerCapacity

type ApplyMode
  = Plan
  | Apply

type ApplyWorkflowParse
  = WorkflowParsed { workflow: ApplyWorkflow }
  | WorkflowParseRefused { reason: String }

type ApplyModeParse
  = ModeParsed { mode: ApplyMode }
  | ModeParseRefused { reason: String }

fn parse_apply_workflow(value: String) -> ApplyWorkflowParse {
  if value == "runner-capacity" {
    WorkflowParsed { workflow: RunnerCapacity }
  } else if value == "dashboard-srv1" {
    WorkflowParsed { workflow: DashboardSrv1 }
  } else {
    WorkflowParseRefused { reason: concat("unknown apply workflow: ", value) }
  }
}

fn parse_apply_mode(value: String) -> ApplyModeParse {
  if value == "plan" {
    ModeParsed { mode: Plan }
  } else if value == "apply" {
    ModeParsed { mode: Apply }
  } else {
    ModeParseRefused { reason: concat("unknown apply mode: ", value) }
  }
}

fn runner_capacity_realizer_unavailable_exit() -> ProcessExit {
  exit_failure(reason: "RunnerCapacityRealizerUnavailable: mode=apply is refused in PR A; PR B owns execution")
}

fn runner_capacity_plan_exit(plan: RunnerCapacityPlan) -> ProcessExit {
  match plan {
    PlanReady { hosts: _ } => ExitSuccess
    PlanRefused { reason: r } => exit_failure(reason: r)
  }
}

fn apply_runner_capacity_plan(
  srv3_width: String,
  srv4_width: String,
  mode: String,
) -> ProcessExit {
  match parse_apply_mode(value: mode) {
    ModeParseRefused { reason: r } => exit_failure(reason: r)
    ModeParsed { mode: Apply } => runner_capacity_realizer_unavailable_exit()
    ModeParsed { mode: Plan } =>
      match parse_width_input(value: srv3_width) {
        WidthInvalidSyntax => exit_failure(reason: "srv3_width must be a non-negative integer")
        WidthNegative { value: _ } => exit_failure(reason: "srv3_width must be non-negative")
        WidthParsed { value: w3 } =>
          match parse_width_input(value: srv4_width) {
            WidthInvalidSyntax => exit_failure(reason: "srv4_width must be a non-negative integer")
            WidthNegative { value: _ } => exit_failure(reason: "srv4_width must be non-negative")
            WidthParsed { value: w4 } =>
              match organization_runner_roster_for_apply_plan() {
                Absent =>
                  exit_failure(
                    reason: "roster read absent — refusing runner capacity plan until live org roster binds"
                  )
                Present { value: roster } =>
                  match unit_active_width_for_apply_plan(host: operator_host_srv3) {
                    Absent =>
                      exit_failure(
                        reason: "unit-active width read absent — refusing runner capacity plan until live local width binds"
                      )
                    Present { value: obs3 } =>
                      match unit_active_width_for_apply_plan(host: operator_host_srv4) {
                        Absent =>
                          exit_failure(
                            reason: "unit-active width read absent — refusing runner capacity plan until live local width binds"
                          )
                        Present { value: obs4 } =>
                          runner_capacity_plan_exit(
                            plan: runner_capacity_plan(
                              srv3_width: w3,
                              srv4_width: w4,
                              roster: roster,
                              observed_srv3_unit_active_width: obs3,
                              observed_srv4_unit_active_width: obs4
                            )
                          )
                      }
                  }
              }
          }
      }
  }
}

fn apply_dispatch(
  workflow: String,
  srv3_width: String,
  srv4_width: String,
  mode: String,
) -> ProcessExit {
  match parse_apply_workflow(value: workflow) {
    WorkflowParseRefused { reason: r } => exit_failure(reason: r)
    WorkflowParsed { workflow: DashboardSrv1 } =>
      if mode == "apply" {
        live_deploy_apply_srv1_wet()
      } else {
        exit_failure(reason: "dashboard-srv1 supports mode=apply only in this increment")
      }
    WorkflowParsed { workflow: RunnerCapacity } =>
      apply_runner_capacity_plan(srv3_width: srv3_width, srv4_width: srv4_width, mode: mode)
  }
}

func apply_wet(workflow: String, srv3_width: String, srv4_width: String, mode: String) -> ProcessExit {
  apply_dispatch(workflow: workflow, srv3_width: srv3_width, srv4_width: srv4_width, mode: mode)
}
