module gunbc.cli_run_repo_grant


data cli_run_repo_grant_note: String = "P-B repo-tree grant authority (docs/plans/effect-namespace-grants.md 6): dissolves the hand-rolled workspace_root containment gate in src/v1/stage0/src/cli_run.rs (repo_relative_path / repo_relative_path_normalized) into the landed std.effect_grant model. The process workspace is Read+Write under an abstract repo subtree; paths that escape (absolute outside repo, or a `..` path segment) are located std.access.Deny refusals from the EffectRequest profile, never widened (DESIGN 5). HAND-RUST until Chunk F (docs/plans/cli-run-reconcile-defork.md, seed-shrink-census Chunk F — scheduled, not indefinite): Rust gate and this authority must not diverge; pinned by dag/test/claim/cli_run_repo_grant_hand_rust_equivalence_witness_test.dag + cli_run.rs cli_run_repo_grant_equivalence_tests. dissolve-on = cli_run.rs Chunk F lands (GENERATED workflow host-effect apply) OR ROADMAP 5-dissolve-patches retires HAND path handling."

data cli_run_repo_frame: std.materialization_ladder.Frame = std.materialization_ladder.Frame {
  name: "cli-run-repo",
  kind: std.materialization_ladder.SharedStateFrame
}

data cli_run_repo_root: std.effect_grant.NamespacePosition = std.effect_grant.filesystem_position(path: ["repo"])

fn cli_run_repo_envelope() -> std.effect_grant.Envelope {
  std.effect_grant.Envelope {
    frame: cli_run_repo_frame,
    grants: [
      std.effect_grant.Grant {
        verb: std.effect_grant.Read,
        root: cli_run_repo_root,
        binding: std.effect_grant.RealTransport,
        lifecycle: std.effect_grant.LifecycleByConstruction
      },
      std.effect_grant.Grant {
        verb: std.effect_grant.Write,
        root: cli_run_repo_root,
        binding: std.effect_grant.RealTransport,
        lifecycle: std.effect_grant.LifecycleByConstruction
      },
    ]
  }
}

fn cli_run_repo_path_admissible(rel: String, verb: std.effect_grant.Verb) -> std.access.AccessDecision {
  std.effect_grant.admit_effect(
    env: cli_run_repo_envelope(),
    verb: verb,
    target: std.filesystem_path_grant.repo_rel_path_position(rel: rel)
  )
}

fn cli_run_repo_write_admissible(rel: String) -> std.access.AccessDecision {
  cli_run_repo_path_admissible(rel: rel, verb: std.effect_grant.Write)
}

fn cli_run_repo_read_admissible(rel: String) -> std.access.AccessDecision {
  cli_run_repo_path_admissible(rel: rel, verb: std.effect_grant.Read)
}
