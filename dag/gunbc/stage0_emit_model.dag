fn list_contains_string(xs: List<String>, needle: String) -> Bool {
  any(xs, x => x == needle)
}

fn stage0_module_emit_basename(module_path: String) -> String {
  module_path |> split(delimiter: ".") |> join(separator: "_")
}

fn stage0_module_emit_filename(module_path: String) -> String {
  concat(stage0_module_emit_basename(module_path: module_path), ".rs")
}

fn is_generated_stage0_file(basename: String) -> Bool {
  list_contains_string(xs: generated_stage0_files, needle: basename)
}

fn generated_stage0_file_count() -> Int {
  generated_stage0_files.length()
}
