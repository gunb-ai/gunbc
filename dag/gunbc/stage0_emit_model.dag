module gunbc.stage0_emit_model

import gunbc.generated_artifact { committed_generated_artifact_paths }
import gunbc.stage0_emit_plan { stage0_canonical_repo_path, stage0_module_emit_basename, stage0_module_emit_filename }

data stage0_generated_membership_grounding_note: String = "MEMBERSHIP IS ASKED OF THE GENERATED-ARTIFACT REGISTRY, NOT OF A ROSTER. This module formerly read gunbc.stage0_emit_plan_generated.generated_stage0_files — a 142-entry hand-shaped list that regen_stage0 re-authored on every heal. The v1 cut deleted the src/v1 .dag authority and the regen loop, so that roster had no producer; running the heal against the cut tree re-authored it as a two-entry husk, which is the regrowth trap (a corpse re-grown by the loop that was supposed to die with it). The roster and its artifact variant are retired whole.

WHAT REPLACES IT IS NOT A SHORTER LIST. The question 'is this stage0 .rs generated' has exactly one honest answer post-cut: a file is generated if and only if something can still re-derive it, and the single authority for that is gunbc.generated_artifact — so membership is now a lookup in committed_generated_artifact_paths() at the canonical stage0 path, with no second representation to drift against. The population it returns is therefore SMALL and derived rather than large and asserted: the stage0 .rs that remain registry artifacts in their own right, and nothing else. Every other file under src/v1/stage0/src is frozen hand-owned seed source, which is precisely what the freeze means and what the sibling lanes deleting hand Rust there are acting on.

The prior fork this dissolves is recorded on gunbc.roster_registry, which had already caught the roster drifting 98 against the Rust const's 101 and named 'regen_stage0 reads the .dag rows and the const is deleted' as the close. The fork closes here by the other end: the reader is deleted."

fn is_generated_stage0_file(basename: String) -> Bool {
  any(
    committed_generated_artifact_paths(),
    path => path == stage0_canonical_repo_path(basename: basename)
  )
}

data stage0_src_repo_prefix: String = "src/v1/stage0/src/"

fn generated_stage0_files() -> List<String> {
  committed_generated_artifact_paths()
    |> filter(path => starts_with(s: path, prefix: stage0_src_repo_prefix))
    |> map(path => replace(path, stage0_src_repo_prefix, ""))
}

fn generated_stage0_file_count() -> Int {
  length(generated_stage0_files())
}
