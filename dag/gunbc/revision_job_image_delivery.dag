module gunbc.revision_job_image_delivery

import std.types { String }
import std.process { ProcessExit, ExitSuccess, ExitFailure, exit_failure }
import extdeps.tools.mkdir { mkdir_parents_command }
import gunbc.guest_image_delivery { guest_image_stage_inputs, guest_image_write_digest_receipt }
import gunbc.runner.microvm_guest_artifacts {
  runner_guest_kernel_artifact, runner_guest_base_rootfs_artifact, revision_job_rust_dist_artifact, runner_guest_base_artifact_path,
}
import extdeps.os.ubuntu_ports_archive { ubuntu_archive_keyring_path }
import gunbc.runner.runner_revision_job_unit { revision_job_image_staging_root }
import gunbc.runner.runner_revision_job_image { revision_job_image_path, revision_job_toolchain_receipt_path, revision_job_image_build_core }
import gunbc.runner.runner_revision_job_toolchain { prove_toolchain_rows, ToolchainRowsProven, ToolchainRowsRefused }

// THE REVISION-JOB IMAGE'S CI DELIVERY, the workspace image's pattern (gunbc.workspace_image_delivery)
// applied to its sibling: built inside an existing job from digest-pinned inputs (kernel, base rootfs,
// Rust dist, and the closure debs the signed-index receipt admits), uploaded with its digest receipt,
// and downloaded by the controller install, which verifies the installed copies against the reviewed
// pin (gunbc.runner.runner_revision_job_unit revision_job_image_pinned_sha256).
data revision_job_image_artifact_name: String = "revision-job-image"
data revision_job_image_build_receipt: String = "target/revision-job-image-artifact/build-receipt.txt"

fn revision_job_image_artifact_paths() -> String {
  join([revision_job_image_path(root: revision_job_image_staging_root),
    runner_guest_base_artifact_path(root: revision_job_image_staging_root, artifact: runner_guest_kernel_artifact),
    revision_job_toolchain_receipt_path(root: revision_job_image_staging_root),
    revision_job_image_build_receipt], "\n")
}

// Run the whole entry under fakeroot, so ownership survives extraction and mke2fs -d.
fn revision_job_image_build_wet() -> ProcessExit {
  let root = revision_job_image_staging_root
  let store = concat(root, "/closure-store")
  let index = concat(root, "/toolchain-index")
  match guest_image_stage_inputs(root: root, label: "RevisionJobImageBuildRefused",
    prepare: [mkdir_parents_command(path: store), mkdir_parents_command(path: index),
      mkdir_parents_command(path: concat(root, "/rust-dist")), mkdir_parents_command(path: concat(root, "/debs"))],
    downloads: [runner_guest_base_rootfs_artifact, revision_job_rust_dist_artifact]) {
    ExitFailure { code, reason } => ExitFailure { code: code, reason: reason }
    ExitSuccess => match prove_toolchain_rows(store: store, dir: index, keyring: ubuntu_archive_keyring_path) {
      ToolchainRowsRefused { reasons } => exit_failure(reason: concat("RevisionJobImageBuildRefused: toolchain rows unproven:\n", join(reasons, "\n")))
      ToolchainRowsProven { receipt: _ } => match revision_job_image_build_core(root: root, rust_dist_dir: concat(root, "/rust-dist"), store: store, debs: concat(root, "/debs")) {
        ExitFailure { code, reason } => ExitFailure { code: code, reason: reason }
        ExitSuccess => guest_image_write_digest_receipt(image_path: revision_job_image_path(root: root),
          receipt_path: revision_job_image_build_receipt, key: "revision-job-image-sha256")
      }
    }
  }
}
