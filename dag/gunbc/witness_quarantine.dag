fn witness_quarantine_row_matches(
  row: WitnessQuarantineRow,
  entry: String,
  function: String
) -> Bool {
  (row.entry == entry) && (row.function == function)
}

fn witness_quarantine_covers(entry: String, function: String) -> Bool {
  fold(
    known_red_probe_frontier,
    init: false,
    f: fn(found, row) {
      found || witness_quarantine_row_matches(row: row, entry: entry, function: function)
    }
  )
}

fn witness_quarantine_covers_entry(entry: String) -> Bool {
  fold(
    known_red_probe_frontier,
    init: false,
    f: fn(found, row) { found || (row.entry == entry) }
  )
}

fn witness_quarantine_row_well_formed(row: WitnessQuarantineRow) -> Bool {
  !(row.entry == "")
    && !(row.function == "")
    && !(row.reason == "")
    && !(row.dissolve_on == "")
}

fn witness_quarantine_rows_well_formed() -> Bool {
  fold(
    known_red_probe_frontier,
    init: true,
    f: fn(ok, row) { ok && witness_quarantine_row_well_formed(row: row) }
  )
}

data witness_quarantine_grain_note: String = "The row is (entry, function) and the predicate compares both fields with ==, so a quarantine never reaches a sibling and never reaches a same-named function in another file. witness_quarantine_covers_entry exists for exactly one purpose — the anti-dual well-formedness rule in v2.workflow.witness_admission, which refuses a witness_exclusion_frontier pattern row that re-states a quarantine at path grain — and must not be used to make an admission decision, because deciding at entry grain is the imprecision this authority replaced."
