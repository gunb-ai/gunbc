// INSTALLING THE GRANT THE RECONCILE FOUND MISSING, which is the step that turns a receipt naming a
// gap into a process that closes it. Until this existed the only way a grant reached a host was an
// operator at a keyboard -- out-of-band actuation, manual application not committed as source, and
// the reason the reboot leg had no remedy but to ask a human.
//
// SUDOERS IS VALIDATED BEFORE IT IS INSTALLED, not after, and this ordering is the whole safety
// argument. A malformed drop-in file in /etc/sudoers.d does not fail that file alone: sudo refuses
// to parse the entire sudoers set and every privileged operation on the host stops, including the
// one that would repair it. So `visudo -c -f` runs against the STAGED copy, and the file reaches
// /etc/sudoers.d only after sudo itself has said it parses. A validation that ran afterwards would
// be reporting the damage rather than preventing it.
//
// The file lands via `install` rather than `mv` because sudo refuses to read a drop-in that is
// group- or world-writable, and ownership and mode are then facts of the command that placed it
// rather than of whatever umask the staging write happened to run under.

type SparkGrantInstallPlan
  = SparkGrantInstallSteps { grant: SparkManagedGrant, first: PlannedRemoteStep, more: List<PlannedRemoteStep> }
  | SparkGrantInstallRefused { grant: SparkManagedGrant, cause: NonEmptyStr }

// STAGED IN THE INSTALLER'"'"'S OWN HOME, not the grantee'"'"'s. The first cut of this took the executor
// home as a constant, so a run connecting as the operator tried to write into the automation
// account'"'"'s directory and got Permission denied at the far side -- a failure that reads as a broken
// installer rather than as the wrong account being named. Whose home it is follows from who is doing
// the writing, which is exactly the fact the transport principal already carries.
fn spark_grant_staging_path(grant: SparkManagedGrant, principal: NonEmptyStr) -> FilePath {
  join([
    spark_managed_principal_home(login: principal) as String, "/.gunbc-staged-sudoers-",
    spark_managed_grant_dropin_name(grant: grant) as String,
  ], "") as FilePath
}

fn spark_grant_install_step_identity(grant: SparkManagedGrant, phase: String) -> NonEmptyStr {
  join([phase, "-", spark_managed_grant_dropin_name(grant: grant) as String], "") as NonEmptyStr
}

fn spark_grant_admit_argv(identity: NonEmptyStr, raws: List<String>) -> PlannedRemoteStep? {
  match portable_remote_words(raws: raws) {
    Absent => none
    Present { value: words } => Present {
      value: PlannedRemoteStep {
        identity: identity,
        operation: RemoteArgv { argv: portable_remote_words_strings(words: words) },
      },
    }
  }
}

fn spark_grant_install_plan(grant: SparkManagedGrant, principal: NonEmptyStr) -> SparkGrantInstallPlan {
  let staged = spark_grant_staging_path(grant: grant, principal: principal)
  match typed_remote_file_write_seal(
    path: staged,
    content: spark_managed_grant_sudoers_content(grant: grant),
    allowed_scope: FileTreeScope { root_path: spark_managed_principal_home(login: principal) },
  ) {
    TypedRemoteFileWriteAdmissionRefused { cause: why } =>
      SparkGrantInstallRefused { grant: grant, cause: why }
    TypedRemoteFileWriteAdmitted { write: w } => {
      let stage = PlannedRemoteStep {
        identity: spark_grant_install_step_identity(grant: grant, phase: "stage"),
        operation: RemoteFileBytes { write: w, mode: RemoteFileModeOwnerReadWrite },
      }
      match spark_grant_admit_argv(
        identity: spark_grant_install_step_identity(grant: grant, phase: "validate"),
        raws: ["sudo", "-n", "visudo", "-c", "-f", staged as String],
      ) {
        Absent =>
          SparkGrantInstallRefused {
            grant: grant,
            cause: "the sudoers validation argv is not portable under the far-side re-parse" as NonEmptyStr,
          }
        Present { value: validate } =>
          match spark_grant_admit_argv(
            identity: spark_grant_install_step_identity(grant: grant, phase: "install"),
            raws: [
              "sudo", "-n", "install", "-m", "0440", "-o", "root", "-g", "root",
              staged as String,
              spark_managed_grant_dropin_path(grant: grant) as String,
            ],
          ) {
            Absent =>
              SparkGrantInstallRefused {
                grant: grant,
                cause: "the sudoers install argv is not portable under the far-side re-parse" as NonEmptyStr,
              }
            Present { value: install } =>
              match spark_grant_admit_argv(
                identity: spark_grant_install_step_identity(grant: grant, phase: "unstage"),
                raws: ["rm", "-f", staged as String],
              ) {
                Absent =>
                  SparkGrantInstallRefused {
                    grant: grant,
                    cause: "the staging cleanup argv is not portable under the far-side re-parse" as NonEmptyStr,
                  }
                Present { value: unstage } =>
                  SparkGrantInstallSteps {
                    grant: grant,
                    first: stage,
                    more: [validate, install, unstage],
                  }
              }
          }
      }
    }
  }
}

fn spark_grant_install_steps(plan: SparkGrantInstallPlan) -> List<PlannedRemoteStep> {
  match plan {
    SparkGrantInstallRefused { grant: _, cause: _ } => []
    SparkGrantInstallSteps { grant: _, first: f, more: m } => concat([f], m)
  }
}

// VALIDATION PRECEDES INSTALLATION, asserted as a property of the plan rather than left to the order
// the steps happen to be written in. A plan that installed first would be one edit away and would
// look identical in a diff.
// A single forward scan carrying one state, because the question is about ORDER and a pair of
// independent "was it seen" flags cannot answer it: both are true either way round.
//   0 = neither seen yet · 1 = validate seen · 2 = install reached before any validate (refuses)
fn spark_grant_install_validates_before_installing(plan: SparkGrantInstallPlan) -> Bool {
  fold(
    map(spark_grant_install_steps(plan: plan), s => s.identity as String),
    init: 0,
    f: fn(state, id) {
      if state == 2 {
        2
      } else if string_contains(id, "validate-") {
        1
      } else if string_contains(id, "install-") && state == 0 {
        2
      } else {
        state
      }
    },
  ) == 1
}

fn spark_grant_install_plan_wire(plan: SparkGrantInstallPlan) -> String {
  match plan {
    SparkGrantInstallRefused { grant: g, cause: c } =>
      join([
        "  grant-install grant=", spark_managed_grant_wire(grant: g) as String,
        " REFUSED cause=", c as String, "\n",
      ], "")
    SparkGrantInstallSteps { grant: g, first: _, more: _ } =>
      join([
        "  grant-install grant=", spark_managed_grant_wire(grant: g) as String,
        " steps=", join(map(spark_grant_install_steps(plan: plan), s => s.identity as String), ","),
        "\n",
      ], "")
  }
}

// ── Actuation ───────────────────────────────────────────────────────────────────────────────────

// THE PRINCIPAL IS A PARAMETER OF THE PLAN, not a constant of this module, because installing a
// grant is exactly the operation the grantee cannot perform for itself. The automation account holds
// enable-linger and nothing else, so it can neither write /etc/sudoers.d nor run visudo; a bootstrap
// that assumed otherwise would fail with a password demand and no statement of who could have done
// it instead. Naming the transport principal makes "who installs privilege" a modeled fact rather
// than an assumption buried in a target constructor.
fn spark_grant_install_transport(
  context: FleetSshExecutionContext,
  host: HostIdentity,
  principal: NonEmptyStr,
) -> HostEffectTransport {
  FleetSsh {
    target: SshTarget {
      endpoint: fleet_probe_endpoint_for(host: host as String) as NonEmptyStr,
      principal: principal,
    },
    context: context,
  }
}

// AWAITING A CREDENTIAL IS NOT A FLOOR, and calling it one was the error this arm is named for. An
// earlier revision called this BlockedOnRootOfTrust and rendered a sudoers recipe for a human to
// apply -- reasoning that privilege cannot be self-granted, therefore the mutation must be manual.
// The first half is true and the second does not follow: software cannot manufacture root authority,
// but the input that resolves that is AUTHORIZATION, not MUTATION. Supplying a credential once and
// hand-authoring host state are different acts, and only the first is unavoidable.
//
// The cost of the confusion was real: the process asked an operator to reproduce a plan it had
// already frozen, on a host it could already reach, and the result would then be unobserved by the
// thing that needed it. This arm now means exactly "no credential was supplied", and its remedy is
// the credential the authorization model has specified all along.
// AN INSTALL THAT REPORTED SUCCESS IS NOT A HOST THAT HOLDS THE GRANT, and the gap between those two
// sentences is where this whole vertical started: a sudoers line applied by hand converged nothing
// the process could see. `install` exiting zero says a file was placed; whether sudo now grants the
// command is a separate fact that only sudo can state, and it can disagree -- a drop-in with the
// wrong account name, a syntactically valid rule for a path that does not exist, or a sudoers set
// whose earlier entry takes precedence all place a file successfully and grant nothing.
//
// So the install re-reads the enumeration through the grantee's own principal and requires the grant
// to appear. Not attempted when nothing was installed, because a readback of an install that never
// ran would report the pre-existing state as the result.
type SparkGrantReadback
  = GrantReadbackConfirmed
  | GrantReadbackDisagreed { standing: NonEmptyStr }
  | GrantReadbackNotAttempted

type SparkGrantInstallOutcome
  = SparkGrantInstallAwaitingOperatorCredential {
      host: HostIdentity
      grant: SparkManagedGrant
      principal: NonEmptyStr
    }
  | SparkGrantInstallExecuted {
      host: HostIdentity
      grant: SparkManagedGrant
      standings: List<RemoteStepStanding>
      privileged: List<PrivilegedStepOutcome>
      readback: SparkGrantReadback
    }
  | SparkGrantInstallNotAttempted {
      host: HostIdentity
      grant: SparkManagedGrant
      cause: NonEmptyStr
    }

// THE SEQUENCE IS MIXED, AND DELIBERATELY NOT HOMOGENEOUS. Staging and cleanup are ordinary
// unprivileged operations; validation and installation are credential-bound. Running all four
// through one sequencer would have required a RemoteOperation that carries a credential, which is
// the generic { argv, stdin } carrier the ruling forbids -- it would reopen arbitrary script bodies
// through stdin under root. So the two privileged steps are their own operation with their own
// closed argv set, and the fold below halts across both kinds.
//
// The order is load-bearing and is asserted separately as a property of the plan: validation runs
// against the STAGED copy before anything reaches /etc/sudoers.d, because a malformed drop-in there
// stops every privileged operation on the host including the one that would repair it.
func spark_grant_install_execute(
  context: FleetSshExecutionContext,
  host: HostIdentity,
  principal: NonEmptyStr,
  administrator: SparkCredentialStanding,
  grant: SparkManagedGrant,
) -> SparkGrantInstallOutcome
  uses net: Network
{
  let plan = spark_grant_install_plan(grant: grant, principal: principal)
  match plan {
    SparkGrantInstallRefused { grant: g, cause: c } =>
      SparkGrantInstallNotAttempted { host: host, grant: g, cause: c }
    SparkGrantInstallSteps { grant: g, first: staged_step, more: _ } =>
      if spark_grant_install_validates_before_installing(plan: plan) == false {
        SparkGrantInstallNotAttempted {
          host: host,
          grant: g,
          cause: "the plan would install a sudoers drop-in before validating it, which can lock every privileged operation on the host" as NonEmptyStr,
        }
      } else {
        {
          let lease = spark_bootstrap_credential_lease(
            host: host,
            administrator: administrator,
            grant: g,
            attempt_identity: spark_grant_install_ci_attempt_raw as NonEmptyStr,
          )
          let staged = spark_serving_run_step_sequence(
            steps: [staged_step],
            transport: spark_grant_install_transport(context: context, host: host, principal: principal),
          )
          if spark_serving_step_sequence_failed(standings: staged) {
            SparkGrantInstallExecuted {
              host: host, grant: g, standings: staged, privileged: [],
              readback: GrantReadbackNotAttempted,
            }
          } else {
            {
              let validated = run_privileged_step(
                context: context,
                host: host,
                lease: lease,
                command: ValidateStagedSudoers {
                  staged_path: spark_grant_staging_path(grant: g, principal: principal) as NonEmptyStr,
                },
              )
              if privileged_step_succeeded(outcome: validated) == false {
                spark_grant_install_from_privileged(
                  host: host, grant: g, principal: principal, staged: staged,
                  outcomes: [validated], readback: GrantReadbackNotAttempted,
                )
              } else {
                {
                  let installed = run_privileged_step(
                    context: context,
                    host: host,
                    lease: lease,
                    command: InstallStagedSudoers {
                      staged_path: spark_grant_staging_path(grant: g, principal: principal) as NonEmptyStr,
                      dropin_path: spark_managed_grant_dropin_path(grant: g),
                    },
                  )
                  {
                    let readback = if privileged_step_succeeded(outcome: installed) {
                      spark_grant_read_back(context: context, host: host, grant: g)
                    } else {
                      GrantReadbackNotAttempted
                    }
                    spark_grant_install_from_privileged(
                      host: host, grant: g, principal: principal, staged: staged,
                      outcomes: [validated, installed], readback: readback,
                    )
                  }
                }
              }
            }
          }
        }
      }
  }
}

// A CREDENTIAL THAT WAS NEVER ENROLLED IS NOT A FAILED INSTALL, and separating the two is what keeps
// "nobody has supplied authorization yet" from reading like "the installer is broken". Every other
// privileged failure stays an executed-and-failed install, because something was actually attempted.
fn spark_grant_install_from_privileged(
  host: HostIdentity,
  grant: SparkManagedGrant,
  principal: NonEmptyStr,
  staged: List<RemoteStepStanding>,
  outcomes: List<PrivilegedStepOutcome>,
  readback: SparkGrantReadback,
) -> SparkGrantInstallOutcome {
  if any(outcomes, o => match o {
    CredentialNotEnrolled { lease: _ } => true
    CredentialRejected { lease: _ } => false
    PrivilegedCommandFailed { command: _, exit_code: _, stderr: _ } => false
    PrivilegedCommandSucceeded { command: _ } => false
  }) {
    SparkGrantInstallAwaitingOperatorCredential { host: host, grant: grant, principal: principal }
  } else {
    SparkGrantInstallExecuted {
      host: host, grant: grant, standings: staged, privileged: outcomes, readback: readback,
    }
  }
}

// THE READBACK IS THE GRANTEE'S OWN ENUMERATION, not the installer's. sudo answers "may THIS account
// run THIS command", and the account that matters is the one the serving lane will use -- asking as
// the installing principal would confirm a grant for the wrong subject entirely.
func spark_grant_read_back(
  context: FleetSshExecutionContext,
  host: HostIdentity,
  grant: SparkManagedGrant,
) -> SparkGrantReadback
  uses net: Network
{
  let outcome = spark_grant_probe_outcome(context: context, host: host)
  match spark_managed_grant_standing_from_outcome(grant: grant, outcome: outcome) {
    GrantHeld { grant: _ } => GrantReadbackConfirmed
    GrantNotHeld { grant: _ } =>
      GrantReadbackDisagreed {
        standing: "the install reported success and the grantee's own sudo enumeration does not name the command" as NonEmptyStr,
      }
    GrantStandingUnobserved { grant: _, cause: c } =>
      GrantReadbackDisagreed {
        standing: join(["the grant could not be re-observed after installing it: ", c as String], "") as NonEmptyStr,
      }
  }
}

// A SEQUENCE THAT HALTED IS NOT AN INSTALL. The steps stage, validate, install and unstage; any halt
// leaves the drop-in absent and the staged file behind, and reporting that as installed would put a
// grant in the receipt that the host does not hold -- the exact confusion the reconcile exists to
// end. Convergence is re-established by the next observation, never by this exit code.
fn spark_grant_install_succeeded(outcome: SparkGrantInstallOutcome) -> Bool {
  match outcome {
    SparkGrantInstallAwaitingOperatorCredential { host: _, grant: _, principal: _ } => false
    SparkGrantInstallNotAttempted { host: _, grant: _, cause: _ } => false
    SparkGrantInstallExecuted { host: _, grant: _, standings: st, privileged: pr, readback: rb } =>
      spark_serving_step_sequence_failed(standings: st) == false
        && pr.length() > 0
        && fold(pr, init: true, f: fn(acc, o) { acc && privileged_step_succeeded(outcome: o) })
        && match rb {
             GrantReadbackConfirmed => true
             GrantReadbackDisagreed { standing: _ } => false
             GrantReadbackNotAttempted => false
           }
  }
}

// WHAT THE PROCESS NEEDS, NOT WHAT A HUMAN SHOULD TYPE. This function used to render the sudoers
// line, its mode and its path as instructions to apply by hand -- and that was the defect, not the
// wording. The unavoidable external input at this seam is AUTHORIZATION; the MUTATION is the
// process's job, and telling an operator to reproduce a frozen plan by hand both asks them to do
// work convergence owns and leaves the result unobserved by the thing that needed it.
//
// So the remedy named here is the credential the authorization model has always specified:
// OperatorBootstrapCredentialRequired, whose own secret_purpose says one-time, through the modeled
// secret boundary, not retained, not a serving requirement. The operator answers "may this exact
// grant be installed on this host", and supplies a credential. They never author host state.
fn spark_grant_credential_requirement(host: HostIdentity, grant: SparkManagedGrant) -> String {
  let l = spark_bootstrap_credential_lease(
    host: host,
    administrator: CredentialMaterializationPending,
    grant: grant,
    attempt_identity: spark_grant_install_ci_attempt_raw as NonEmptyStr,
  )
  join([
    "REQUIRED: an administrator credential for ", l.bootstrap_principal as String,
    " on ", l.host as String,
    match lease_secret_resource(lease: l) {
      Absent => " (no secret is enrolled for this host yet; its name is supplied, never derived)"
      Present { value: r } => join([", enrolled at ", r], "")
    },
    ". Authorized purpose: ", l.authorized_purpose as String,
    ". The credential is materialized only for this step, delivered over stdin, and never enters an",
    " argv, a plan artifact, a workflow input or this receipt. Supplying it is the whole of the",
    " external input -- the mutation itself stays inside convergence and is read back independently.",
  ], "")
}

fn spark_grant_install_outcome_wire(outcome: SparkGrantInstallOutcome) -> String {
  match outcome {
    SparkGrantInstallAwaitingOperatorCredential { host: h, grant: g, principal: p } =>
      join([
        "grant-install host=", h as String,
        " grant=", spark_managed_grant_wire(grant: g) as String,
        " AWAITING-OPERATOR-CREDENTIAL installer=", p as String,
        " -- no credential was supplied, so the privileged step could not be attempted\n    ",
        spark_grant_credential_requirement(host: h, grant: g), "\n",
      ], "")
    SparkGrantInstallNotAttempted { host: h, grant: g, cause: c } =>
      join([
        "grant-install host=", h as String,
        " grant=", spark_managed_grant_wire(grant: g) as String,
        " NOT-ATTEMPTED cause=", c as String, "\n",
      ], "")
    SparkGrantInstallExecuted { host: h, grant: g, standings: st, privileged: pr, readback: rb } =>
      join([
        "grant-install host=", h as String,
        " grant=", spark_managed_grant_wire(grant: g) as String,
        " steps=", spark_serving_step_sequence_wire(standings: st),
        match spark_grant_install_first_failure_cause(standings: st) {
          Absent => ""
          Present { value: c } => join([" cause=", c], "")
        },
        "\n",
        join(map(pr, o => privileged_step_outcome_wire(outcome: o)), ""),
        match rb {
          GrantReadbackConfirmed => "    grant-readback CONFIRMED by the grantee's own sudo enumeration\n"
          GrantReadbackDisagreed { standing: why } =>
            join(["    grant-readback DISAGREED ", why as String, "\n"], "")
          GrantReadbackNotAttempted => "    grant-readback not attempted: nothing was installed\n"
        },
      ], "")
  }
}

fn spark_grant_install_first_failure_cause(standings: List<RemoteStepStanding>) -> String? {
  fold(standings, init: none, f: fn(acc, st) {
    match acc {
      Present { value: _ } => acc
      Absent => remote_step_failure_cause(standing: st)
    }
  })
}

// ── The entry ───────────────────────────────────────────────────────────────────────────────────

data spark_grant_install_receipt_path: String = "target/spark-grant-install-receipt.txt"

data spark_grant_install_ci_attempt_raw: String = "spark-grant-install-ci"

// THE GAP IS MEASURED BEFORE IT IS CLOSED, on the same run, and only the measured-missing grants are
// installed. Installing the whole desired population unconditionally would be cheaper to write and
// would be the absorbing fallback: it cannot tell a host that needs one grant from a host we could
// not read at all, and it would rewrite a correct drop-in on every run so no receipt could ever say
// nothing was needed.
type SparkGrantInstallRun {
  standing_report: String
  outcomes: List<SparkGrantInstallOutcome>
}

func spark_grant_install_host(
  context: FleetSshExecutionContext,
  host: HostIdentity,
  principal: NonEmptyStr,
  administrator: SparkCredentialStanding,
) -> SparkGrantInstallRun
  uses net: Network
{
  let outcome = spark_grant_probe_outcome(context: context, host: host)
  SparkGrantInstallRun {
    standing_report: spark_managed_grant_report(host: host, outcome: outcome),
    outcomes: map(spark_managed_grants_to_install(outcome: outcome), g =>
      spark_grant_install_execute(
        context: context, host: host, principal: principal,
        administrator: administrator, grant: g,
      )),
  }
}

fn spark_grant_install_run_text(run: SparkGrantInstallRun) -> String {
  join(concat(
    [run.standing_report],
    map(run.outcomes, o => spark_grant_install_outcome_wire(outcome: o)),
  ), "")
}

// THE VERDICT COMES FROM THE VARIANTS, never from the receipt text. This module'"'"'s sibling records
// exactly this defect landing once already: an exit status decided by string_contains(body,
// "REFUSED") passed a run whose refusal arm spells "probe-refused" in lower case. Text is a
// projection of the outcomes; a projection cannot be the thing decided upon.
//
// An empty outcome list is SUCCESS here and only here: it means the reconcile found nothing missing,
// which the standing report states in its own words. The reconcile has already refused to put an
// unobserved grant in the install set, so "nothing to install" cannot arrive from ignorance.
fn spark_grant_install_run_succeeded(run: SparkGrantInstallRun) -> Bool {
  fold(run.outcomes, init: true, f: fn(acc, o) {
    acc && spark_grant_install_succeeded(outcome: o)
  })
}

// The grant reading, taken through the transport that will do the installing rather than a separate
// one: a standing measured as one principal and acted on as another is two facts wearing one name.
func spark_grant_probe_outcome(
  context: FleetSshExecutionContext,
  host: HostIdentity,
) -> SparkGrantOutcome
  uses net: Network
{
  match run_typed_argv_transport(
    argv: ["sudo", "-n", "-l"],
    transport: spark_grant_install_transport(
      context: context,
      host: host,
      principal: spark_managed_executor_login as NonEmptyStr,
    ),
  ) {
    TypedArgvExecRefused { reason: why } => GrantProbeRefused { cause: why }
    TypedArgvExecConverged { result: r } =>
      if r.success {
        GrantEnumerated { listing: r.stdout }
      } else {
        GrantAbsent { detail: join(["exit=", to_string(r.exit_code), " stderr=", trim(s: r.stderr)], "") }
      }
  }
}

// THE INSTALL NAMES ITS TARGET OR IT DOES NOT RUN, the same rule the reboot probe applies to itself
// and for the same reason: writing sudoers across a whole fleet from an unset variable is a fan-out
// nobody asked for, and the observe entry's all-hosts arm exists for reading, not writing.
func spark_grant_install_ci_wet() -> ProcessExit
  uses net: Network
{
  match prepare_spark_serving_agent_context(attempt_raw: spark_grant_install_ci_attempt_raw) {
    SparkServingContextRefused { cause: cause } => exit_failure(reason: cause)
    SparkServingContextReady { context: context, receipt: context_receipt } =>
      match spark_converge_target_selection(execute_apply: true) {
        SparkConvergeTargetRefused { reason: why } => exit_failure(reason: why)
        SparkConvergeTargetAllObserveOnly =>
          exit_failure(
            reason: "spark_grant_install_ci_wet: SPARK_CONVERGE_TARGET names no host, and installing sudoers must never fan out across the fleet from an unset variable",
          )
        SparkConvergeTargetSingle { host: only } => {
          let now = clock_now_probed_at()
          let run = spark_grant_install_host(
            context: context,
            host: only,
            principal: spark_grant_install_principal(),
            administrator: spark_grant_install_administrator_standing(),
          )
          let body = join([
            "spark_grant_install_ci_wet probed_at=", now as String, "\n",
            context_receipt,
            spark_grant_install_run_text(run: run),
          ], "")
          let w = Filesystem.Write(path: spark_grant_install_receipt_path, content: body)
          if w.success == false {
            exit_failure(reason: join(["grant install receipt write failed: ", w.error], ""))
          } else if spark_grant_install_run_succeeded(run: run) == false {
            exit_failure(reason: body)
          } else {
            ExitSuccess
          }
        }
      }
  }
}

// WHICH PRINCIPAL INSTALLS PRIVILEGE, stated once. The automation account is the GRANTEE and cannot
// install its own sudoers entries, so the honest default is the operator account the bootstrap model
// already names as the transport for privileged effects. If that account cannot do it either, the
// run refuses with sudo's own diagnostic rather than leaving a human to guess who could.
fn spark_grant_install_principal() -> NonEmptyStr {
  spark_operator_bootstrap_login as NonEmptyStr
}

// THE STANDING IS PENDING UNTIL A SECRET IS AUTHORED, and this row is the honest state rather than a
// deficiency. Secret names are CARRIED, never derived (operator ruling 2026-08-07), and creating the
// secret is SECRET-MATERIALIZE-0'"'"'s subject -- so a reference authored here would be a claim about
// Secret Manager'"'"'s contents that this lane never checked. The row becomes CredentialMaterialized
// with an explicit ref the day the administrator credential is enrolled, and until then every
// privileged step refuses with "no credential enrolled" rather than attempting one.
fn spark_grant_install_administrator_standing() -> SparkCredentialStanding {
  CredentialMaterializationPending
}
