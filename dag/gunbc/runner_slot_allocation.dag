data gunbc_runner_slot_allocation_srv4_admission_note: String = "srv4 commits 6 slots at the memory axis (7 before the 2026-08-17 16GiB ruling) (no interactive sessions, per gunbc_runner_slot_width_ruling_note). Disk binding is NOT folded into gunbc_runner_slots_per_host anymore: the historical five-slot row pin is retired, and apply-time disk preflight in gunbc.runner_lifecycle refuses insufficient or unobservable headroom rather than absorbing to width 5. srv4_runner_host_deploy.runner_count and this roster both name 6 as the materialization target; vivid-eagle-131's apply_wet path must run runner_width_disk_preflight before ADD on srv4."

data gunbc_runner_slot_allocation_srv4: HostRunnerSlotAllocation = gunbc_committed_host_runner_slot_allocation(
  host: operator_host_srv4
)

