module gunbc.runner_slot_allocation

import std.types { Int, String, List, Bool }
import std.measure { ByteSize, byte_size, byte_size_count, HardwareThreadCount, hardware_thread_count, hardware_thread_count_value }
import std.disposition { Disposition, Terminal, SingleAuthority, Scaffold }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import product.placement_supply { HostIdentity }
import gunbc.fleet_intent_network {
  operator_host_srv1, operator_host_srv2, operator_host_srv3, operator_host_srv4,
}
import gunbc.ci_failure_class { FloorOutcome, NoFailure, FloorFailed, Structural, floor_outcome_blocks_merge }

type RunnerSlotLabels {
  github_labels: List<String>
}

type RunnerSlotDesired {
  memory_max: ByteSize
  memory_swap_max: ByteSize
  memory_high: ByteSize
  tasks_max: Int
  cpu_weight: Int
  labels: RunnerSlotLabels
}

type HostRunnerSlotAllocation {
  host: HostIdentity
  slots_per_host: Int
  cores_per_slot: HardwareThreadCount
  runner_slice_cap: ByteSize
  per_slot: RunnerSlotDesired
}

data gunbc_runner_slot_allocation_authority_disposition: Disposition = Terminal {
  reason: "Single authority for fleet runner-slot desired allocation (operator rulings 2026-07-10 superseding the 2026-07-05 brief; MemoryHigh-emit + swap-provisioning 2026-07-11; srv3 host-standup converge 2026-07-21; PER-HOST WIDTH + 14GiB slot 2026-08-05). Fleet-uniform per-slot row: 8 cores · 14GiB MemoryMax · 13GiB MemoryHigh (the authored max−1GiB relation, its own emitted knob per the 2026-07-11 ruling — a hit at 14GiB spills to swap after throttling at 13) · 32GiB MemorySwapMax · TasksMax 512 · cpu_weight 100. PER-HOST width: MEMORY admits 5/5/7/7 for srv1/srv2/srv3/srv4, and the COMMITTED width is the minimum over resolved axes, so srv4 commits 5 under its declared disk cap (width_is_a_minimum_over_axes_note) and the fleet commits 22, not 24. GUARANTEED mode is now STRUCTURAL rather than checked — runner_slice_cap is DERIVED as slots × MemoryMax instead of being a second literal, so Σ per-slot MemoryMax ≤ slice_cap holds by construction and an oversubscribed slice has no representation here (DESIGN 5 construction-over-validation; the prior 80GiB literal was kept coherent with 5 × 16GiB by hand, which the old note admitted when it called them 'coherent by construction at these values' — a coincidence maintained by an author, not a derivation). The real remaining constraint is CONSERVATION against host RAM, which is not this module's to check: gunbc.ci_runner_placement holds it, now against OS-usable RAM with the per-host session slice and per-host fixed overhead charged. Per-axis targets are operator-set; never reconcile this row toward live readback (live is not automatically truth — the 32-vs-0 swap fork existed precisely because the apply was assumed rather than readback-proven). Downstream: gunbc.ci_floor_measurement (declared vs live cap fork), gunbc.ci_runner_placement, gunbc.host_converge, gunbc.host_standup (prefix:host-converge + P1:runner-deploy-slot), gunbc.runner_slot_enforcement, gunbc.fleet_show_effective_read. Host-side convergence applies through modeled host-effect ensure rows; gunbc emits converge — never apply from this module."
}

data gunbc_runner_slot_memory_max_ruling_note: String = "WHY 14GiB AND NOT 16, measured rather than preferred (operator ruling 2026-08-05). 186 floor-job cgroup peaks from 2026-08-05 plus five sampled days back to 2026-07-16, read from the [calibration] floor_peak_post receipts the ci job emits: successful runs peak at p50 10.32GiB and max 10.96GiB, and NOT ONE run in the sample reached the 16GiB MemoryMax. Four of 186 reached 15.0GiB, which is the 15GiB MemoryHigh exactly — those are throttle pins, censored lower bounds rather than demand, and they are why the cap does not fall further.\n\nTHE FLOOR UNDER IT IS ALREADY MEASURED AND IT IS 12GiB: gunbc_floor_minimum_viable_armed_budget in this module, enforced by claim_executor as an arm-time refusal. MemoryHigh is what the run-time governor arms against, so MemoryHigh is the axis that number constrains — 13GiB leaves exactly 1GiB of margin over it, and clears the worst p90 in the three-week sample (12.94GiB on 2026-07-30). Going to 13/12 to buy an eighth slot on the managed hosts would put the throttle line ON the measured refusal floor with zero margin, and the 2026-07-30 distribution says that day would have spent most of its runs in swap.\n\nWHAT MOVING 16 TO 14 IS NOT: it is not oversubscription and does not touch the guaranteed-mode property. Every slot still owns its ceiling outright. The ceilings are simply sized closer to what the workload was measured to want, which is what freed the width."

data gunbc_runner_slot_width_ruling_note: String = "WHY srv3/srv4 GET 7 AND srv1/srv2 STAY AT 5 — the width difference is DERIVED from two per-host facts, not granted by preference. First, sessions: gunbc.session_residency host_session_residency places interactive session containers on srv1 and srv2 and on neither managed host, so srv1/srv2 owe a sessions reservation out of the same host RAM and srv3/srv4 do not. Second, fixed overhead: gunbc.ci_floor_measurement carries a measured upper bound for the managed hosts and an operator allowance for the legacy pair, which differ by 10.4GiB per host.\n\nRun the conservation arithmetic with both charged and the MEMORY admissions fall out — srv3/srv4 admit 7 slots at 14GiB and refuse 8 (an eighth would need 112GiB against ~111.6GiB available, over by less than a gibibyte), srv1/srv2 admit 5 and refuse 6. Neither number is authored here as a target; both are the largest width gunbc.ci_runner_placement's wall will pass, and if either per-host fact is corrected the admissible width moves with it.\n\nMEMORY ADMISSION IS NOT THE COMMITMENT. This note explains one axis; the committed width is the minimum over every resolved axis and is derived in gunbc_runner_slots_per_host. srv4 is the case where they differ — memory admits 7, its declared disk cap admits 5, and it commits 5.\n\nTHE SESSIONS FACT IS RESIDENCY, AND SAYING SO HERE IS LOAD-BEARING. An earlier revision of this note derived the same widths from gunbc.build_cache_instance instead — whether a host carried an InteractiveSessionCompiles cache instance — which merely CORRELATED with sessions living there. That proxy is the defect this change removes, and gunbc.session_residency why_this_is_not_derived_from_the_build_cache_roster_note records how close it came: the session cache on srv1 and srv2 was found provably dead on 2026-08-06 and deleted, so dropping its now-meaningless roster rows would have stopped charging both hosts their reservation and admitted 7 slots each on a wall returning true. A note still reasoning from the roster would invite exactly that edit, which is why it is corrected rather than left as harmless prose.\n\nTHE FLEET-UNIFORM ROW IS WHY THIS COULD NOT BE EXPRESSED BEFORE. gunbc_committed_host_runner_slot_allocation took a host and then read three globals, so 'this host is different' had nowhere to live and the only way to raise srv3/srv4 was to raise all four — which on srv1/srv2 would have overcommitted by 17GiB against a wall that could not see the sessions it was overcommitting against."

fn gunbc_runner_slot_desired() -> RunnerSlotDesired {
  RunnerSlotDesired {
    memory_max: byte_size(15032385536),
    memory_swap_max: byte_size(34359738368),
    memory_high: byte_size(13958643712),
    tasks_max: 512,
    cpu_weight: 100,
    labels: RunnerSlotLabels { github_labels: ["self-hosted", "linux", "arm64", "gunbc-heavy"] }
  }
}

data gunbc_runner_slots_per_host_unknown_note: String = "Unknown hosts refuse rather than defaulting. A width is a claim about a specific machine's RAM, and handing an unclassified host the managed pair's 7 would be the same borrowed-premise failure the fixed-overhead fallback carries (gunbc.ci_floor_measurement gunbc_ci_host_fixed_overhead_unknown_host_note) — worse here, because width multiplies the per-slot ceiling. Zero slots is the fail-closed answer: gunbc.ci_runner_placement's any_unfit arm already refuses a plan that admits zero runners on an enrolled host, so an unclassified host produces a located PlanUnsound rather than a silent five."

data srv4_disk_admitted_slot_width: Int = 5

data srv4_disk_admitted_slot_width_note: String = "srv4's MATERIALIZED width stays disk-pinned at 5 while MEMORY admits 7, and the gap is a declared disk constraint rather than a disagreement about RAM. Its NVMe is a Samsung 970 EVO 500GB against 2TB on srv1-3, and every ephemeral runner keeps a _work tree plus caches, so disk — not memory — is what binds this host. gunbc.ci_runner_placement models RAM only; until a per-host disk-headroom term folds into runner_deployment_plan, the solver cannot see the constraint that actually decides srv4's width, and srv4_disk_admitted_slot_width is where that fact is carried without citing the retired ctrl installer.\n\ndissolve-on: fold a per-host disk-headroom term into runner_deployment_plan so the cap is solver-derived, at which point srv4_disk_admitted_slot_width and this note retire."

data width_is_a_minimum_over_axes_note: String = "A HOST'S WIDTH IS THE MINIMUM OVER ITS CONSTRAINTS, and until this row existed the function below returned the MEMORY verdict under a name that read as the commitment. That is the defect that made srv4 report 7 while every other authority in the tree said 5: srv4_disk_admitted_slot_width pins it at 5 on a declared disk constraint, gunbc_runner_slot_allocation_srv4_admission_note said in prose that slots 06/07 must not be provisioned on the solver's word, and the roster nevertheless published 7 — so the disagreement lived between a number and a paragraph, where no consumer can see it.\n\nCollapsing 'one constraint admits this width' into 'this host should run this width' is the same conflation gunbc.ci_floor_measurement refuses for overhead: an axis nobody resolved is not an axis that permits everything. So memory admission and disk admission are separate answers, and the committed width is their minimum — which makes srv4's 5 a DERIVATION rather than a caveat, and moves it the moment either axis moves.\n\nHONEST RESIDUAL, because this is only two axes: a host with no declared disk cap has its disk UNCONSTRAINED here, not measured, and that is a fail-open on the disk axis for srv1-3. It is the status quo rather than a new hole — those three are not widened by this change and have run their present widths for weeks on four times srv4's disk — but it is why DiskWidthUnconstrained carries a reason string instead of being an absence. Dissolve-on is the one named on srv4_disk_admitted_slot_width_note: a per-host disk-headroom term folded into runner_deployment_plan, at which point both hosts' disk widths are derived and this arm disappears."

fn host_memory_admitted_width(host: HostIdentity) -> Int {
  if (host as String) == (operator_host_srv1 as String) {
    5
  } else if (host as String) == (operator_host_srv2 as String) {
    5
  } else if (host as String) == (operator_host_srv3 as String) {
    7
  } else if (host as String) == (operator_host_srv4 as String) {
    7
  } else {
    0
  }
}

type HostDiskWidthConstraint
  = DiskAdmitsWidth { slots: Int, provenance: String }
  | DiskWidthUnconstrained { reason: String }

fn host_disk_admitted_width(host: HostIdentity) -> HostDiskWidthConstraint {
  if (host as String) == (operator_host_srv4 as String) {
    DiskAdmitsWidth {
      slots: srv4_disk_admitted_slot_width,
      provenance: "gunbc.runner_slot_allocation srv4_disk_admitted_slot_width, the declared disk cap recorded in srv4_disk_admitted_slot_width_note: a 500GB Samsung 970 EVO against 2TB on srv1-3, with every ephemeral runner holding a _work tree plus caches"
    }
  } else {
    DiskWidthUnconstrained {
      reason: "no per-host disk cap is declared for this host and no disk-headroom term is modeled, so its disk admits no stated width and does not lower the minimum: an unmeasured axis, not a measured all-clear"
    }
  }
}

fn gunbc_runner_slots_per_host(host: HostIdentity) -> Int {
  let by_memory = host_memory_admitted_width(host: host)
  match host_disk_admitted_width(host: host) {
    DiskAdmitsWidth { slots: d, provenance: _ } => if d < by_memory { d } else { by_memory }
    DiskWidthUnconstrained { reason: _ } => by_memory
  }
}

fn gunbc_runner_cores_per_slot() -> HardwareThreadCount {
  hardware_thread_count(count: 8)
}

fn gunbc_runner_slice_cap_declared(host: HostIdentity) -> ByteSize {
  gunbc_runner_slot_demand_sum_memory_max(
    slots: gunbc_runner_slots_per_host(host: host),
    per_slot: gunbc_runner_slot_desired().memory_max
  )
}

fn gunbc_runner_slot_demand_sum_memory_max(slots: Int, per_slot: ByteSize) -> ByteSize {
  byte_size(byte_size_count(b: per_slot) * slots)
}

fn gunbc_runner_slot_oversubscription_within_slice(slots: Int, per_slot: ByteSize, slice_cap: ByteSize) -> Bool {
  byte_size_count(b: gunbc_runner_slot_demand_sum_memory_max(slots: slots, per_slot: per_slot)) <=
    byte_size_count(b: slice_cap)
}

fn gunbc_committed_host_runner_slot_allocation(host: HostIdentity) -> HostRunnerSlotAllocation {
  let per_slot = gunbc_runner_slot_desired()
  let slots = gunbc_runner_slots_per_host(host: host)
  HostRunnerSlotAllocation {
    host: host,
    slots_per_host: slots,
    cores_per_slot: gunbc_runner_cores_per_slot(),
    runner_slice_cap: gunbc_runner_slice_cap_declared(host: host),
    per_slot: per_slot
  }
}

data gunbc_runner_slot_allocation_srv1: HostRunnerSlotAllocation = gunbc_committed_host_runner_slot_allocation(
  host: operator_host_srv1
)

data gunbc_runner_slot_allocation_srv2: HostRunnerSlotAllocation = gunbc_committed_host_runner_slot_allocation(
  host: operator_host_srv2
)

data gunbc_runner_slot_allocation_srv3: HostRunnerSlotAllocation = gunbc_committed_host_runner_slot_allocation(
  host: operator_host_srv3
)

data gunbc_runner_slot_allocation_srv4_admission_note: String = "srv4 JOINS THE COMMITTED ROSTER, and its absence until now was a live fork rather than an oversight. srv4 has been carrying fleet work since 2026-07-22 — five slots srv4-01..05, evenly loaded, visible in any run's job census — while this roster listed srv1/srv2/srv3 only. So the host that OOM-killed live CI for being outside the model (gunbc.plans.fleet_subsumption_manual_gaps section C) was re-enrolled in gunbc.fleet_intent and in the compute offers, and then left out of the one authority that says what its slots are supposed to be. Its per-slot caps existed on the box as an interim hand-apply, legitimate at the time only because srv4 and srv1 are the same board at the same RAM, which made the derived values EQUAL rather than transplanted.\n\nEqual-by-coincidence is exactly what stops being true here: srv4's MEMORY admission moves to 7 while srv1 stays at 5, so a roster that omits srv4 no longer merely lags the fleet, it disagrees with it. That memory difference is derived from srv4 hosting no interactive sessions, per gunbc_runner_slot_width_ruling_note.\n\nSRV4 NEVERTHELESS COMMITS 5, AND IT IS NOW DERIVED RATHER THAN WARNED ABOUT. An earlier revision of this note said in prose that slots 06 and 07 must not be provisioned on the solver's word while gunbc_runner_slots_per_host published 7 to every consumer — a paragraph disagreeing with a number, which is the weaker half losing. host_disk_admitted_width now reads srv4_disk_admitted_slot_width and the committed width is the minimum of the two axes, so srv4 commits 5 by construction. When the disk term is modeled and the cap rises, the width rises with it and no note needs editing.\n\nSTILL OPEN AND DELIBERATELY NOT CLOSED HERE: srv4's NVMe is a 500GB Samsung 970 EVO against 2TB on srv1-3, and srv4_disk_admitted_slot_width_note records disk as its binding constraint at 5 runners. 7 ephemeral _work trees on a 500GB disk is a real question this change does not answer. The conservation wall models RAM only; a per-host disk-headroom term is the named dissolution trigger on that note, and it is the gate on srv4 actually running the seventh slot."

data gunbc_runner_slot_allocation_srv4: HostRunnerSlotAllocation = gunbc_committed_host_runner_slot_allocation(
  host: operator_host_srv4
)

fn gunbc_committed_runner_slot_allocations() -> List<HostRunnerSlotAllocation> {
  [
    gunbc_runner_slot_allocation_srv1,
    gunbc_runner_slot_allocation_srv2,
    gunbc_runner_slot_allocation_srv3,
    gunbc_runner_slot_allocation_srv4,
  ]
}

fn gunbc_runner_slot_enforcement_expected_cap() -> ByteSize {
  gunbc_runner_slot_desired().memory_max
}

data gunbc_runner_slot_allocation_wall_oracle_note: String = "WHAT THIS WALL USED TO ASSERT WAS ITS OWN INPUT. Three of its five conjuncts compared gunbc_runner_slot_desired's fields to byte literals retyped from that same declaration twenty lines above, in the same file — measure() == measure() with the equality maintained by hand, which the 2026-08-01 test-oracle ruling names exactly: automate the literal's update and the assertion collapses to nothing, so the manual update WAS the assertion's entire content. It could only ever fail when someone edited one copy and forgot the other, and it would have gone red on this change for that reason and no other.\n\nThe conjuncts that replace them are relations between INDEPENDENTLY derived quantities, so each can fail for a reason worth knowing. The max−1GiB relation is the authored MemoryHigh law from the 2026-07-11 ruling and it is checkable without naming either number. The MemoryHigh ≥ floor conjunct is the load-bearing one and it is NEW: gunbc_floor_minimum_viable_armed_budget is a MEASURED refusal threshold (12GiB, from the doomed-witness receipts below) that claim_executor enforces at arm time, and MemoryHigh is precisely the budget the run-time governor arms against — so shrinking the slot cap below it would ship a fleet on which every floor run refuses itself. Nothing connected those two rows before; the 14GiB ruling is what made the distance between them small enough to matter.\n\nGuaranteed mode is deliberately NOT asserted here any more. runner_slice_cap is derived as slots × MemoryMax, so Σ ≤ cap is true by construction and a check of it would be the vacuous restatement DESIGN 5 says to prefer construction over. gunbc_runner_slot_oversubscription_within_slice survives as the general relation for callers holding two independent numbers."

fn gunbc_runner_slot_allocation_wall_holds() -> Bool {
  let per_slot = gunbc_runner_slot_desired()
  let gibibyte_bytes = 1073741824
  (hardware_thread_count_value(t: gunbc_runner_cores_per_slot()) == 8)
    && (byte_size_count(b: per_slot.memory_high) + gibibyte_bytes == byte_size_count(b: per_slot.memory_max))
    && (byte_size_count(b: per_slot.memory_high) >= byte_size_count(b: gunbc_floor_minimum_viable_armed_budget))
    && (byte_size_count(b: per_slot.memory_swap_max) > byte_size_count(b: per_slot.memory_max))
    && all(
      gunbc_committed_runner_slot_allocations(),
      a =>
        a.slots_per_host > 0
          && gunbc_runner_slot_oversubscription_within_slice(
               slots: a.slots_per_host,
               per_slot: a.per_slot.memory_max,
               slice_cap: a.runner_slice_cap
             )
    )
}

data gunbc_runner_slot_allocation_live_cap_dissolve_on: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.runner_slot_allocation",
    decl_name: "gunbc_runner_slot_desired",
    field: WholeDeclaration
  }
}

data gunbc_floor_armed_budget_doomed_exit_137_outcome: FloorOutcome = FloorFailed {
  class: Structural { reason: "Process completed with exit code 137." }
}

type FloorArmedBudgetDoomedWitness
  = FloorArmedBudgetDoomedMeasured {
      run_id: String,
      runner_unit: String,
      armed_budget: ByteSize,
      budget_source: String,
      floor_outcome: FloorOutcome,
    }
  | FloorArmedBudgetDoomedUnmeasured

type FloorArmedBudgetSuccessClassWitness
  = FloorArmedBudgetSuccessClassMeasured {
      run_id: String,
      runner_unit: String,
      armed_budget: ByteSize,
      floor_peak_post: ByteSize,
      floor_outcome: FloorOutcome,
    }
  | FloorArmedBudgetSuccessClassUnmeasured

data gunbc_floor_armed_budget_doomed_witness_receipts: List<FloorArmedBudgetDoomedWitness> = [
  FloorArmedBudgetDoomedMeasured {
    run_id: "29834380839",
    runner_unit: "srv3-05",
    armed_budget: byte_size(6987137024),
    budget_source: "/proc/meminfo MemAvailable",
    floor_outcome: gunbc_floor_armed_budget_doomed_exit_137_outcome,
  },
  FloorArmedBudgetDoomedMeasured {
    run_id: "29845210061",
    runner_unit: "srv3-02",
    armed_budget: byte_size(5971566592),
    budget_source: "/proc/meminfo MemAvailable",
    floor_outcome: gunbc_floor_armed_budget_doomed_exit_137_outcome,
  },
]

data gunbc_floor_armed_budget_success_class_receipt: FloorArmedBudgetSuccessClassWitness = FloorArmedBudgetSuccessClassMeasured {
  run_id: "29835983525",
  runner_unit: "srv1-05",
  armed_budget: byte_size(16106127360),
  floor_peak_post: byte_size(16108544000),
  floor_outcome: NoFailure,
}

data gunbc_floor_minimum_viable_armed_budget: ByteSize = byte_size(12884901888)

data gunbc_floor_minimum_viable_armed_budget_disposition: Disposition = Terminal {
  reason: "MEASURED minimum viable armed budget for the CI floor (operator ruling 2026-07-21, post-#6995): 12GiB (12884901888 bytes) is the conservative lower bound of the healthy capped-box success class (~12.5-16GiB floor_peak_post), NOT the typical peak. Derivation: doomed witnesses gunbc_floor_armed_budget_doomed_witness_receipts prove armed budgets 5.97-6.99GiB at arm time (MemAvailable on crowded uncapped srv3) cannot complete the floor walk - runs 29834380839 and 29845210061 died in batch witness phase after ~30min; success-class receipt gunbc_floor_armed_budget_success_class_receipt (run 29835983525 post-#6995, srv1-05, armed_budget=15GiB memory.high, floor_peak_post=16108544000) proves the healthy class sits above this bound. bright-seal #6999 fill-deferral is perf-only (entry-closure memo); coordinate via gunbc_floor_minimum_viable_armed_budget_dissolve_on if a future change cuts mature index residency. Consumed by claim_executor arm-time FloorBudgetBelowMinimumFootprint refusal (fail-fast, requeue-able)."
}

data gunbc_floor_minimum_viable_armed_budget_dissolve_on: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.runner_slot_allocation",
    decl_name: "gunbc_floor_minimum_viable_armed_budget",
    field: WholeDeclaration
  }
}

fn gunbc_floor_minimum_viable_armed_budget_bytes() -> ByteSize {
  gunbc_floor_minimum_viable_armed_budget
}

fn witness_floor_minimum_viable_above_doomed_receipts() -> Bool {
  all(
    gunbc_floor_armed_budget_doomed_witness_receipts,
    r =>
      match r {
        FloorArmedBudgetDoomedMeasured { run_id: _, runner_unit: _, armed_budget: budget, budget_source: _, floor_outcome: _ } =>
          byte_size_count(b: budget) < byte_size_count(b: gunbc_floor_minimum_viable_armed_budget)
        FloorArmedBudgetDoomedUnmeasured => false
      }
  )
}

fn witness_floor_minimum_viable_below_success_class() -> Bool {
  match gunbc_floor_armed_budget_success_class_receipt {
    FloorArmedBudgetSuccessClassMeasured { run_id: _, runner_unit: _, armed_budget: budget, floor_peak_post: _, floor_outcome: _ } =>
      byte_size_count(b: budget) >= byte_size_count(b: gunbc_floor_minimum_viable_armed_budget)
    FloorArmedBudgetSuccessClassUnmeasured => false
  }
}

fn witness_floor_armed_budget_doomed_outcomes_are_failures() -> Bool {
  all(
    gunbc_floor_armed_budget_doomed_witness_receipts,
    r =>
      match r {
        FloorArmedBudgetDoomedMeasured { run_id: _, runner_unit: _, armed_budget: _, budget_source: _, floor_outcome: o } =>
          floor_outcome_blocks_merge(o: o)
        FloorArmedBudgetDoomedUnmeasured => false
      }
  )
}

fn witness_floor_armed_budget_success_outcome_is_no_failure() -> Bool {
  match gunbc_floor_armed_budget_success_class_receipt {
    FloorArmedBudgetSuccessClassMeasured { run_id: _, runner_unit: _, armed_budget: _, floor_peak_post: _, floor_outcome: o } =>
      match o {
        NoFailure => true
        FloorFailed { class: _ } => false
      }
    FloorArmedBudgetSuccessClassUnmeasured => false
  }
}

fn gunbc_floor_minimum_viable_armed_budget_wall_holds() -> Bool {
  witness_floor_minimum_viable_above_doomed_receipts()
    && witness_floor_minimum_viable_below_success_class()
    && witness_floor_armed_budget_doomed_outcomes_are_failures()
    && witness_floor_armed_budget_success_outcome_is_no_failure()
    && byte_size_count(b: gunbc_floor_minimum_viable_armed_budget) == byte_size_count(b: byte_size(12884901888))
}
