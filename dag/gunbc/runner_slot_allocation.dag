  [
    gunbc_runner_slot_allocation_srv1,
    gunbc_runner_slot_allocation_srv2,
    gunbc_runner_slot_allocation_srv3,
    gunbc_runner_slot_allocation_srv4,
  ]
}

fn gunbc_runner_slot_enforcement_expected_cap() -> ByteSize {
  gunbc_runner_slot_desired().memory_max
}

type RunnerSlotEffectiveCapObservation
  = RunnerSlotEffectiveCapMeasured {
      runner_unit: String,
      memory_max: ByteSize,
      memory_high: ByteSize,
      probed_at: String,
    }
  | RunnerSlotEffectiveCapUnmeasured

data gunbc_runner_slot_effective_readback_refusal_note: String = "EFFECTIVE KERNEL CAPS ARE NOT THIS MODULE'S INPUT. gunbc_runner_slot_desired is the single authority for the fleet per-slot row; per-axis targets are operator-set and never reconciled toward live readback — live is not automatically truth, and the 32-vs-0 swap fork existed precisely because apply was assumed rather than readback-proven.\n\nTHE 16GiB/15GiB ROW IS OBSERVATION-DERIVED FROM A DIFFERENT SUBJECT: the 2026-08-17 floor-peak ruling superseding the 2026-08-05 floor_peak_post calibration in gunbc_runner_slot_memory_max_ruling_note (186 cgroup peaks, p50 10.32GiB, max 10.96GiB). That derivation is complete; a per-slot systemctl show on an unconverged host is evidence of CONVERGENCE DEBT, not a second numeric source for the declaration.\n\nsrv2-03 WAS the discriminating specimen and has stopped being one: the declaration moved to 16GiB/15GiB and its observation now matches, so runner_slot_effective_cap_drifts_from_declaration is FALSE on it (gunbc_srv2_03_drift_dissolved_by_ruling_note). gunbc_synthetic_drifted_cap_observation is the replacement discriminating input, deliberately synthetic so no convergence can green it — the repair is host_axis_caps deploy apply (author derived drop-ins, shadow revert), never editing gunbc_runner_slot_desired toward the observation. Until apply lands, memory_governor arms against the live cgroup on that slot (15GiB throttle), while placement and ci_budget_tree size against the declared MemoryHigh — the honest residual in gunbc_ci_runner_slot_memory_max_live_source. THAT ENVELOPE QUESTION IS NOW CLOSED: gunbc_srv2_03_converge_floor_fit_note records that the floor's compliance with the superseded 14GiB/13GiB budget was measured and FAILED — an uncensored 15509315584-byte peak above the old max, plus srv1's two pinned slots after it was actually converged there. The floor lane no longer needs coordinating before a converge on srv2-03, because srv2-03 has nothing to converge on this axis."

data gunbc_srv2_03_effective_cap_observation: RunnerSlotEffectiveCapObservation = RunnerSlotEffectiveCapMeasured {
  runner_unit: "actions-runner@srv2-03.service",
  memory_max: byte_size(17179869184),
  memory_high: byte_size(16106127360),
  probed_at: "2026-08-16",
}

