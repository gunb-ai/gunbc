data gunbc_floor_minimum_viable_armed_budget: ByteSize = byte_size(12884901888)

data gunbc_floor_minimum_viable_armed_budget_disposition: Disposition = Terminal {
  reason: "MEASURED minimum viable armed budget for the CI floor (operator ruling 2026-07-21, post-#6995): 12GiB (12884901888 bytes) is the conservative lower bound of the healthy capped-box success class (~12.5-16GiB floor_peak_post), NOT the typical peak. Derivation: doomed witnesses gunbc_floor_armed_budget_doomed_witness_receipts prove armed budgets 5.97-6.99GiB at arm time (MemAvailable on crowded uncapped srv3) cannot complete the floor walk - runs 29834380839 and 29845210061 died in batch witness phase after ~30min; success-class receipt gunbc_floor_armed_budget_success_class_receipt (run 29835983525 post-#6995, srv1-05, armed_budget=15GiB memory.high, floor_peak_post=16108544000) proves the healthy class sits above this bound. bright-seal #6999 fill-deferral is perf-only (entry-closure memo); coordinate via gunbc_floor_minimum_viable_armed_budget_dissolve_on if a future change cuts mature index residency. Consumed by claim_executor arm-time FloorBudgetBelowMinimumFootprint refusal (fail-fast, requeue-able)."
}

data gunbc_floor_minimum_viable_armed_budget_dissolve_on: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.runner_slot_allocation",
    decl_name: "gunbc_floor_minimum_viable_armed_budget",
    field: WholeDeclaration
  }
}

fn gunbc_floor_minimum_viable_armed_budget_bytes() -> ByteSize {
  gunbc_floor_minimum_viable_armed_budget
}

fn witness_floor_minimum_viable_above_doomed_receipts() -> Bool {
  all(
    gunbc_floor_armed_budget_doomed_witness_receipts,
    r =>
      match r {
        FloorArmedBudgetDoomedMeasured { run_id: _, runner_unit: _, armed_budget: budget, budget_source: _, floor_outcome: _ } =>
          byte_size_count(b: budget) < byte_size_count(b: gunbc_floor_minimum_viable_armed_budget)
        FloorArmedBudgetDoomedUnmeasured => false
      }
  )
}

fn witness_floor_minimum_viable_below_success_class() -> Bool {
  match gunbc_floor_armed_budget_success_class_receipt {
    FloorArmedBudgetSuccessClassMeasured { run_id: _, runner_unit: _, armed_budget: budget, floor_peak_post: _, floor_outcome: _ } =>
      byte_size_count(b: budget) >= byte_size_count(b: gunbc_floor_minimum_viable_armed_budget)
    FloorArmedBudgetSuccessClassUnmeasured => false
  }
}

fn witness_floor_armed_budget_doomed_outcomes_are_failures() -> Bool {
  all(
    gunbc_floor_armed_budget_doomed_witness_receipts,
    r =>
      match r {
        FloorArmedBudgetDoomedMeasured { run_id: _, runner_unit: _, armed_budget: _, budget_source: _, floor_outcome: o } =>
          floor_outcome_blocks_merge(o: o)
        FloorArmedBudgetDoomedUnmeasured => false
      }
  )
}

fn witness_floor_armed_budget_success_outcome_is_no_failure() -> Bool {
  match gunbc_floor_armed_budget_success_class_receipt {
    FloorArmedBudgetSuccessClassMeasured { run_id: _, runner_unit: _, armed_budget: _, floor_peak_post: _, floor_outcome: o } =>
      match o {
        NoFailure => true
        FloorFailed { class: _ } => false
      }
    FloorArmedBudgetSuccessClassUnmeasured => false
  }
}

fn gunbc_floor_minimum_viable_armed_budget_wall_holds() -> Bool {
  witness_floor_minimum_viable_above_doomed_receipts()
    && witness_floor_minimum_viable_below_success_class()
    && witness_floor_armed_budget_doomed_outcomes_are_failures()
    && witness_floor_armed_budget_success_outcome_is_no_failure()
    && byte_size_count(b: gunbc_floor_minimum_viable_armed_budget) == byte_size_count(b: byte_size(12884901888))
}
