module gunbc.guarantee_measurement

import std.types { String, NonEmptyStr, Bool, Int, List, CommitSha }
import std.nat { Nat }
import gunbc.guarantee_rung { GuaranteeRung, MechanicallyPreventable, OutsideTheLadder, guarantee_rung_index }
import std.content_hash { Fnv1a64Structural, content_hash_atom, content_hash_tagged_structural, content_hash_combine_structural }

// STAGE 0 OF THE GUARANTEE SPINE: the vocabulary probes and claims meet through, and nothing else
// (operator spine verdict 2026-08-01; roadmap node ladder-measurement-schema; gap analysis sec 12
// Stage 0). Without this stage the probe corpus and the claims carrier each invent the receipt
// shape and meet in a protocol cycle - probes cannot emit rows the carrier has not defined, the
// carrier cannot derive dispositions from receipts that do not exist. So this module carries
// identity brands, the path row, the receipt row, and the joins that make a receipt REFUSE when it
// names an unknown subject - and deliberately nothing that claims anything about the compiler: no
// class population, no probe executes here, no disposition, no rung. Those arrive with
// ladder-probe-corpus and ladder-claims-carrier, which consume this vocabulary instead of minting
// temporary string keys.

// The axis enums are CLOSED AND MINIMAL, grounded on the paths real measurements exercise (DESIGN
// 4b names source-to-interpretation, source-to-each-emission-target, and
// phase-carrier-to-phase-carrier as independently measured paths): CompileAccept and RuntimeRun are
// the merged v1 walls' seams - RuntimeRun is deliberately realization-agnostic: the run happens IN
// the path's realization, so WHICH runtime (the interpreter arm or an emitted binary) is the
// realization axis's fact, never the boundary's, and an emitted-run path (the divergence probes'
// subject) is expressible rather than contradictory; InferToEval is the phase boundary gunbc#7485
// landed (Eval refuses underived facts) and InferToTranslate is the boundary the containment
// workstream closes (operator verdict 2026-08-01: the fact stays grounding-was-not-derived, and the
// phase that consumes it is named by the PATH, never by a second diagnostic). A new variant lands
// WITH the first real path row that needs it, never speculatively - an earlier draft carried a
// generic PhaseCarrierAcceptance arm, deleted for exactly that reason: an unused axis variant is
// vocabulary claiming coverage nothing measures. The same rule deleted the compile_mode axis
// (review 46308): every landed control determines its pipeline from its boundary (the v1 walls'
// seams are v1, the phase boundaries are v2), so a stored mode was a second representation of a
// derivable fact (DESIGN 2) whose only writable novelty was the contradiction, and the axes that
// remain are fully orthogonal - the two constructible contradictions the review named are now
// unwritable, one dissolved by the RuntimeRun reading, one by this deletion. The axis returns as a
// stored fact WITH the first path row measured under two pipelines at one boundary, and enumerating
// valid families as a coproduct was rejected for that future: family rows restate the orthogonal
// axes per combination (the N-by-M shape DESIGN 2 folds into axes). GuaranteeTargetName is a
// receipt-vocabulary brand, not a language authority: it keeps a target name from being passed
// where a probe id belongs, and its grounding to the real per-language authority is deliberately
// deferred - dissolve-on the primitive-identity join reaching target-realization rows
// (v2-target-realization-gate lane), at which point this brand re-grounds on that authority and
// this sentence deletes.

type GuaranteeClassId = NonEmptyStr where brand("GuaranteeClassId")
type GuaranteePathId = NonEmptyStr where brand("GuaranteePathId")
type GuaranteeProbeId = NonEmptyStr where brand("GuaranteeProbeId")
type GuaranteeTargetName = NonEmptyStr where brand("GuaranteeTargetName")

type SubjectGrain
  = SyntheticProgram
  | CorpusModule
  | WholeCorpus

type AcceptanceBoundary
  = CompileAccept
  | RuntimeRun
  | InferToEval
  | InferToTranslate

type PathRealization
  = InterpreterRealization
  | EmittedTarget { language: GuaranteeTargetName }

type GuaranteePath {
  id: GuaranteePathId
  subject_grain: SubjectGrain
  acceptance_boundary: AcceptanceBoundary
  realization_target: PathRealization
}

// The RAW executed observation, never the judgment: dispositions (Unmeasured, BelowFloor,
// FrontierAccepted, OnLadder, OutsideModeledGuarantee) are DERIVED by the claims carrier from
// receipts, so storing one here would be the transcribed-rung defect the carrier stage exists to
// make unrepresentable. ProbeNotRunnable is a separate arm because could-not-measure is not a
// verdict about the subject (DESIGN 5: top-as-answer conflated with top-as-ignorance is the
// absorbing fallback) - a probe that failed to execute must never be readable as the subject
// passing or failing. diagnostic_class names a compiler diagnostic variant as prose at this stage;
// the diagnostic-taxonomy join is carrier-stage grounding, and a brand here would claim a join this
// stage does not own. On query shape (review 46075, review 46159): probe_observation_fold is the
// sum's canonical elimination (the std.change KeyedLeafVerdictFold idiom) and owns the ONLY match
// over ProbeObservation; observed_is_verdict derives through it, so a per-query hand-match has no
// form to accumulate - a new query is a ProbeObservationFold row. Review 46075's interim carry had
// named exactly this fold as its dissolution trigger with the claims carrier as second consumer; a
// catamorphism's shape is sum-determined, so the trigger executed with review 46159 rather than
// waiting, and the carrier's disposition derivation consumes the same fold when it lands. Counts
// are Nat because a diagnostic count is a cardinal fact (review 46287), measured with the same
// honesty as the brand seam: an executed control shows today's checker still ACCEPTING a negative
// at the Nat field, so the carrier states the cardinal and the refusal belongs to the
// numeric-refinement acceptance class the probe corpus carries - not yet a wall here.

type ProbeObservation
  = RefusedTyped { diagnostic_class: NonEmptyStr, count: Nat }
  | AcceptedClean
  | AcceptedCounted { diagnostic_class: NonEmptyStr, count: Nat }
  | ExecutionDiverged { description: NonEmptyStr }
  | ProbeNotRunnable { cause: NonEmptyStr }

type ProbeObservationFold<R> {
  refused: fn(NonEmptyStr, Nat) -> R
  accepted_clean: R
  accepted_counted: fn(NonEmptyStr, Nat) -> R
  diverged: fn(NonEmptyStr) -> R
  not_runnable: fn(NonEmptyStr) -> R
}

fn probe_observation_fold<R>(o: ProbeObservation, fold: ProbeObservationFold<R>) -> R {
  match o {
    RefusedTyped { diagnostic_class: d, count: c } => fold.refused(d, c)
    AcceptedClean => fold.accepted_clean
    AcceptedCounted { diagnostic_class: d, count: c } => fold.accepted_counted(d, c)
    ExecutionDiverged { description: d } => fold.diverged(d)
    ProbeNotRunnable { cause: c } => fold.not_runnable(c)
  }
}

fn observed_is_verdict(o: ProbeObservation) -> Bool {
  probe_observation_fold(
    o: o,
    fold: ProbeObservationFold {
      refused: fn(_, _) { true },
      accepted_clean: true,
      accepted_counted: fn(_, _) { true },
      diverged: fn(_) { true },
      not_runnable: fn(_) { false },
    },
  )
}

type MeasurementRevision
  = GitRevision { commit: CommitSha }
  | ContentFingerprint { digest: Fnv1a64Structural }

// subject_revision and harness_revision name what was measured, not interchangeable commit-shaped
// strings. GitRevision carries a cited git commit (the baseline stage's anchor). ContentFingerprint
// carries an fnv1a64 structural digest of measured subject or harness material — honest for
// SyntheticProgram witnesses until real revision anchors land; it must never be cast to CommitSha.
// Downstream consumers discriminate by variant rather than inferring family from hex width.

type GuaranteeMeasurementReceipt {
  class: GuaranteeClassId
  path: GuaranteePathId
  probe: GuaranteeProbeId
  subject_revision: MeasurementRevision
  harness_revision: MeasurementRevision
  probe_set_digest: Fnv1a64Structural
  observed: ProbeObservation
}

data receipt_identity_note: String = "Every field is REQUIRED - no Optional arms - so a receipt missing an identity component or a revision is unwritable at construction rather than caught by a check (DESIGN 5 construction over validation; the roadmap node red_control names this). The three revisions answer the three-way ambiguity the baseline stage names: subject_revision names what compiler artifacts were measured, harness_revision names what probe harness ran, probe_set_digest is the content address of the exact probe set - a baseline is the anchor's subject under today's harness and probe set, and without all three 'the baseline at commit X' names three different measurements. Each revision is a MeasurementRevision coproduct (GitRevision | ContentFingerprint) so git commits and content fingerprints are not conflated at the type. Enforcement of required-field construction is itself an open census class (floor-record-construction-wall); this module states the intent by shape and the wall, when it lands, is what makes the shape load-bearing corpus-wide."

// The registry MECHANISM without a registry POPULATION: uniqueness and exactly-one resolution are
// folds over caller-supplied rows, witnessed here against synthetic rows only. The real class and
// path populations arrive with the carrier and probe stages; this module supplying them would be
// Stage 0 claiming compiler coverage it does not have. Resolution mirrors gunbc.roadmap_identity:
// exactly-one, never first-pick - a duplicate registry answered with a plausible first row is the
// fabricated-output arm, and it fails at exactly the moment the registry is corrupt. The lookup key
// is the branded GuaranteePathId end-to-end, through the refusal variants, and join_receipt_to_path
// passes receipt.path without erasing it to String (review 46179). Measured honestly rather than
// assumed (DESIGN 4b: a brand is cosmetic until construction and acceptance enforce the
// distinction): today's checker ACCEPTS a bare String at both a branded parameter and a branded
// record field - two executed controls, both accepted - so this threading is model-correctness and
// erasure-removal, not yet a wall. Brand acceptance-enforcement is its own guarantee class for the
// probe corpus to carry (below floor, with those controls as its discriminating probes), and this
// seam hardens for free when that class climbs.

type GuaranteePathResolution
  = PathResolved { path: GuaranteePath }
  | PathUnknown { wanted: GuaranteePathId }
  | PathDuplicate { wanted: GuaranteePathId, matches: Int }

fn resolve_guarantee_path(paths: List<GuaranteePath>, wanted: GuaranteePathId) -> GuaranteePathResolution {
  let hits = paths |> filter(p => (p.id as String) == (wanted as String))
  if count(hits) == 0 {
    PathUnknown { wanted: wanted }
  } else if count(hits) > 1 {
    PathDuplicate { wanted: wanted, matches: count(hits) }
  } else {
    match hits |> first {
      Present { value: p } => PathResolved { path: p }
      Absent => PathUnknown { wanted: wanted }
    }
  }
}

type ReceiptJoin
  = ReceiptJoined { path: GuaranteePath }
  | ReceiptPathUnknown { receipt_path: GuaranteePathId }
  | ReceiptPathDuplicate { receipt_path: GuaranteePathId, matches: Int }

fn join_receipt_to_path(receipt: GuaranteeMeasurementReceipt, paths: List<GuaranteePath>) -> ReceiptJoin {
  match resolve_guarantee_path(paths: paths, wanted: receipt.path) {
    PathResolved { path: p } => ReceiptJoined { path: p }
    PathUnknown { wanted: w } => ReceiptPathUnknown { receipt_path: w }
    PathDuplicate { wanted: w, matches: m } => ReceiptPathDuplicate { receipt_path: w, matches: m }
  }
}

fn distinct_string_count(values: List<String>) -> Int {
  count(fold(values, init: [], f: fn(acc, v) {
    if any(acc, e => e == v) { acc } else { append(acc, [v]) }
  }))
}

fn guarantee_class_ids_unique(ids: List<GuaranteeClassId>) -> Bool {
  distinct_string_count(values: ids |> map(i => i as String)) == count(ids)
}

fn guarantee_path_ids_unique(paths: List<GuaranteePath>) -> Bool {
  distinct_string_count(values: paths |> map(p => p.id as String)) == count(paths)
}

fn guarantee_probe_ids_unique(ids: List<GuaranteeProbeId>) -> Bool {
  distinct_string_count(values: ids |> map(i => i as String)) == count(ids)
}

// Content address of the exact probe set a receipt ran under, folded in the caller's list order:
// canonical ordering is the PROBE stage's obligation (it owns the probe roster and its canonical
// enumeration), so this fn is deterministic exactly when the caller's order is - stated rather than
// silently sorted here, because a sort would need an order authority this stage does not own and a
// host-order sort would be the determinism leak std.determinism refuses.

fn probe_set_digest(probe_ids: List<GuaranteeProbeId>) -> Fnv1a64Structural {
  fold(probe_ids, init: content_hash_atom(value: "guarantee-probe-set" as NonEmptyStr), f: fn(acc, id) {
    content_hash_combine_structural(left: acc, right: content_hash_tagged_structural(tag: "probe" as NonEmptyStr, payload: content_hash_atom(value: id as NonEmptyStr)))
  })
}

// ============================================================================================
// THE CLAIM SIDE: A REQUIREMENT, AND A DISPOSITION DERIVED PER PATH AND NEVER STORED.
//
// The measurement side above answers "what did this probe observe". It deliberately stops there:
// dispositions are "DERIVED by the claims carrier from receipts, so storing one here would be the
// transcribed-rung defect the carrier stage exists to make unrepresentable". This section is that
// carrier, in the same module because it keys on the same identities - a separate module would put
// the join between class identity and its own vocabulary across an authority edge for no fact.
//
// THE ROADMAP NODE SPECIFIES FOUR CARRIERS AND TWO OF THEM ALREADY EXIST HERE. GuaranteePath is
// declared above; GuaranteeMeasurement is GuaranteeMeasurementReceipt above. What was missing is
// GuaranteeRequirement and GuaranteeDisposition, and those are what this section adds - not a
// partial realization of the set elsewhere, but the absent half landing beside the present half.
//
// THERE IS NO current_rung FIELD, AND THAT IS THE POINT. A stored rung is a number someone typed,
// which is the rung inflation DESIGN section 4b(1) names: the reported rung must EQUAL the rung
// established by executed evidence. Here the only way to obtain a rung is to fold receipts, so a
// transcribed one is not merely discouraged, it is unwritable.

// THE CEILING'S REASON IS TYPED because DESIGN section 4b derives the attainable ceiling rather
// than asserting it, and the derivation differs by KIND: a decidable fully-modeled class may reach
// impossibility; a decidable class missing its authority is section 5's wall-after-grounding; a
// class blocked on a language capability names that capability; an undecidable property honestly
// stays a ratchet; an external fact stays a boundary obligation. A String reason would let all five
// be spelled the same way and none of them be folded.
type GuaranteeCeilingReason
  = DecidableAndFullyModeled
  | WallAfterGrounding { missing_authority: NonEmptyStr }
  | BlockedOnCapability { capability: NonEmptyStr }
  | UndecidableProperty { property: NonEmptyStr }
  | ExternalBoundaryObligation { boundary: NonEmptyStr }

// A REQUIREMENT IS WHAT IS OWED FOR ONE CLASS, and every field is required: a class whose harm is
// unstated cannot be prioritised, and a ceiling without its reason is an assertion. next_rung_trigger
// carries section 4b(2)'s "no untracked stall" - a class below its ceiling must name what would move
// it, separating cannot-climb from can-climb-after-one-grounding from can-climb-now-but-unbuilt.
type GuaranteeRequirement {
  class: GuaranteeClassId
  domain: NonEmptyStr
  harm: NonEmptyStr
  ceiling: GuaranteeRung
  ceiling_reason: GuaranteeCeilingReason
  next_rung_trigger: NonEmptyStr
}

// THE DISPOSITION OF ONE CLASS ON ONE PATH. OutsideModeledGuarantee is DESIGN's column that is
// deliberately not a rung - external reality, undecidable properties, undeclared intent - and it is
// carried here so that "we do not model this" can be said without masquerading as a weak rung.
type GuaranteeDisposition
  = Unmeasured
  | BelowFloor
  | FrontierAccepted
  | OnLadder { rung: GuaranteeRung }
  | OutsideModeledGuarantee

// A RUNG NEEDS A PAIR OF OBSERVATIONS, NOT ONE, and this is the load-bearing shape of the whole
// carrier. DESIGN section 4b(1): the rung must equal what is established by "a discriminating RED
// refused on the real acceptance path plus an accepted positive control". One observation cannot
// establish it in either direction - a gate that refuses everything refuses the planted red too, and
// a gate that accepts everything accepts the positive control too. So a path's evidence is the pair,
// and the two failure directions are different facts with the same disposition:
//   - the RED was ACCEPTED  => the wall did not fire on the state it exists for.
//   - the GREEN was REFUSED => the wall refuses a correct program.
// Both are BelowFloor, and both are worth distinguishing to a reader, which is what the cause is for.
type PathEvidence {
  path: GuaranteePathId
  red_probe: ProbeObservation
  green_probe: ProbeObservation
}

type BelowFloorCause
  = PlantedRedAccepted
  | PositiveControlRefused
  | ObservationDiverged

fn probe_is_not_runnable(o: ProbeObservation) -> Bool {
  match o {
    ProbeNotRunnable { cause: _ } => true
    RefusedTyped { diagnostic_class: _, count: _ } => false
    AcceptedClean => false
    AcceptedCounted { diagnostic_class: _, count: _ } => false
    ExecutionDiverged { description: _ } => false
  }
}

fn probe_diverged(o: ProbeObservation) -> Bool {
  match o {
    ExecutionDiverged { description: _ } => true
    ProbeNotRunnable { cause: _ } => false
    RefusedTyped { diagnostic_class: _, count: _ } => false
    AcceptedClean => false
    AcceptedCounted { diagnostic_class: _, count: _ } => false
  }
}

fn probe_refused(o: ProbeObservation) -> Bool {
  match o {
    RefusedTyped { diagnostic_class: _, count: _ } => true
    AcceptedClean => false
    AcceptedCounted { diagnostic_class: _, count: _ } => false
    ExecutionDiverged { description: _ } => false
    ProbeNotRunnable { cause: _ } => false
  }
}

fn probe_accepted_with_counted_residue(o: ProbeObservation) -> Bool {
  match o {
    AcceptedCounted { diagnostic_class: _, count: _ } => true
    AcceptedClean => false
    RefusedTyped { diagnostic_class: _, count: _ } => false
    ExecutionDiverged { description: _ } => false
    ProbeNotRunnable { cause: _ } => false
  }
}

// PROBE EVIDENCE CAPS AT MechanicallyPreventable, AND SAYING SO IS THE WHOLE HONESTY OF THIS FOLD.
// A pair of probes can establish that a gate EXECUTES and DISCRIMINATES, which is exactly DESIGN's
// rung 2: "a generated test, lens, or gate reliably exposes and blocks it, but the invalid state
// remains writable and safety depends on that mechanism executing and staying enrolled". Rungs 3 and
// 4 are claims about what no Accepted program CAN contain and what has no constructor at all - they
// are properties of the model, not of any finite set of probe runs, and no number of green probes
// can witness them. A derivation that returned StructurallyGuaranteed from probe observations would
// be manufacturing the inflation this carrier exists to prevent.
fn probe_pair_rung() -> GuaranteeRung {
  MechanicallyPreventable
}

fn disposition_for_path(evidence: PathEvidence) -> GuaranteeDisposition {
  if probe_is_not_runnable(o: evidence.red_probe)
    || probe_is_not_runnable(o: evidence.green_probe) {
    Unmeasured
  } else {
    if probe_diverged(o: evidence.red_probe) || probe_diverged(o: evidence.green_probe) {
      BelowFloor
    } else {
      if !probe_refused(o: evidence.red_probe) {
        BelowFloor
      } else {
        if probe_refused(o: evidence.green_probe) {
          BelowFloor
        } else {
          if probe_accepted_with_counted_residue(o: evidence.green_probe) {
            FrontierAccepted
          } else {
            OnLadder { rung: probe_pair_rung() }
          }
        }
      }
    }
  }
}

// WHY A BELOW-FLOOR PATH IS NAMED RATHER THAN ONLY COUNTED: the two directions send a repair to
// different places. A RED that was accepted means the wall is missing or misaimed; a GREEN that was
// refused means the wall is wrong about correct programs, which is the more expensive defect
// because it stops honest work.
fn below_floor_cause(evidence: PathEvidence) -> BelowFloorCause {
  if probe_diverged(o: evidence.red_probe) || probe_diverged(o: evidence.green_probe) {
    ObservationDiverged
  } else {
    if !probe_refused(o: evidence.red_probe) { PlantedRedAccepted } else { PositiveControlRefused }
  }
}

// THE FOLD ACROSS PATHS, IN THE ORDER THE ROADMAP FIXES: below-floor dominance, then frontier, then
// unmeasured, then the MINIMUM rung across paths. The order is not a preference and each step is a
// separate law:
//   - BELOW-FLOOR DOMINATES because a class that fails its floor on any path is below the floor,
//     full stop; averaging a failing path against passing ones is the compensating-errors defect.
//   - FRONTIER BEFORE UNMEASURED because an accepted-with-residue path is a MEASURED fact, and
//     reporting it as unmeasured would discard evidence that exists.
//   - UNMEASURED BEFORE A RUNG because an unmeasured path is ignorance, and a rung reported over it
//     would be a claim about a path nobody looked at.
//   - MINIMUM, NEVER MAXIMUM OR AVERAGE, because section 4b(1) says a class's rung is the minimum
//     across its in-scope paths: citing the strongest path while another stays silent is inflation.
// OutsideModeledGuarantee contributes no rung: a path outside the modeled guarantee is not a weak
// rung, so it is skipped in the minimum, and a class ALL of whose paths are outside is outside.
fn disposition_is_below_floor(d: GuaranteeDisposition) -> Bool {
  match d {
    BelowFloor => true
    Unmeasured => false
    FrontierAccepted => false
    OnLadder { rung: _ } => false
    OutsideModeledGuarantee => false
  }
}

fn disposition_is_frontier(d: GuaranteeDisposition) -> Bool {
  match d {
    FrontierAccepted => true
    BelowFloor => false
    Unmeasured => false
    OnLadder { rung: _ } => false
    OutsideModeledGuarantee => false
  }
}

fn disposition_is_unmeasured(d: GuaranteeDisposition) -> Bool {
  match d {
    Unmeasured => true
    BelowFloor => false
    FrontierAccepted => false
    OnLadder { rung: _ } => false
    OutsideModeledGuarantee => false
  }
}

fn disposition_rung_index(d: GuaranteeDisposition) -> Int {
  match d {
    OnLadder { rung: r } => guarantee_rung_index(r: r)
    BelowFloor => guarantee_rung_index(r: OutsideTheLadder)
    Unmeasured => guarantee_rung_index(r: OutsideTheLadder)
    FrontierAccepted => guarantee_rung_index(r: OutsideTheLadder)
    OutsideModeledGuarantee => guarantee_rung_index(r: OutsideTheLadder)
  }
}

fn minimum_on_ladder(dispositions: List<GuaranteeDisposition>) -> GuaranteeDisposition {
  fold(dispositions, init: OutsideModeledGuarantee, f: fn(acc, d) {
    match d {
      OnLadder { rung: r } =>
        match acc {
          OnLadder { rung: current } =>
            if guarantee_rung_index(r: r) < guarantee_rung_index(r: current) {
              OnLadder { rung: r }
            } else {
              acc
            }
          _ => OnLadder { rung: r }
        }
      _ => acc
    }
  })
}

fn fold_dispositions(dispositions: List<GuaranteeDisposition>) -> GuaranteeDisposition {
  if any(dispositions, d => disposition_is_below_floor(d: d)) {
    BelowFloor
  } else {
    if any(dispositions, d => disposition_is_frontier(d: d)) {
      FrontierAccepted
    } else {
      if any(dispositions, d => disposition_is_unmeasured(d: d)) {
        Unmeasured
      } else {
        minimum_on_ladder(dispositions: dispositions)
      }
    }
  }
}

fn class_disposition(evidence: List<PathEvidence>) -> GuaranteeDisposition {
  fold_dispositions(dispositions: map(evidence, e => disposition_for_path(evidence: e)))
}

// A CLASS AT ITS CEILING IS DONE; A CLASS BELOW IT OWES ITS TRIGGER. This is the one place the
// requirement and the disposition meet, and it is a comparison rather than a stored state: below
// the ceiling is a correctness gap, never optional elegance (DESIGN section 4b).
fn disposition_is_at_ceiling(r: GuaranteeRequirement, d: GuaranteeDisposition) -> Bool {
  disposition_rung_index(d: d) >= guarantee_rung_index(r: r.ceiling)
}
