module gunbc.review_sheet_spreadsheet_actuator

import std.types { NonEmptyStr, String, Bool }
import std.resources { Network }
import std.upsert_decision { UpsertDecision, Noop, Apply, Refuse }
import gunbc.ensure { EnsurePolicy }
import extdeps.transports.rest {
  RestReadExchange,
  RestMutationExchange,
  RestExchangeSucceeded,
  RestExchangeStatusRefused,
  RestExchangeUnreached,
  RestExchangeUndecodable,
  RestExchangeCommitAmbiguous,
  classify_rest_outcome,
}
import extdeps.google.drive
import extdeps.google.drive { google_sheet_mime_type }
import gunbc.review_sheet_drive_converge {
  ReviewSpreadsheetObservation,
  SheetObservedOne,
  SheetAbsent,
  SheetDuplicated,
  SheetSearchIncomplete,
  SheetPageIncomplete,
  SheetSearchUnreadable,
  SpreadsheetCreatePlan,
  SpreadsheetMarkerMigrationPlan,
  SpreadsheetPlan,
  SpreadsheetCreate,
  SpreadsheetMigrateMarker,
  SupersededSearchReading,
  SupersededNotConsulted,
  SupersededRead,
  spreadsheet_from_file_list,
  ensure_review_spreadsheet,
  review_sheet_search_query,
  review_sheet_superseded_search_query,
}

// THE HARDER AMBIGUITY, AND THE REASON THE KEY IS CHOSEN BEFORE THE CALL. A lost answer from
// files.create may have minted a spreadsheet whose id this process never saw. Nothing in the
// response recovers it, because there was no response -- so the only way back to that file is a
// property written ONTO it at creation time, which is exactly what marker_property_key is. The
// recovery read is therefore not a nicety: it is the whole reason a create is allowed at all.
//
// Membership had the same shape but a milder consequence: a lost permissions.create leaves a
// principal that may or may not be a member, and re-reading settles it. A lost files.create leaves
// a FILE, and without the key the next pass would find nothing and mint a second one, with the
// first invisible and holding whatever was written to it.

type SpreadsheetConvergeOutcome
  = SpreadsheetAdopted { file_id: NonEmptyStr }
  | SpreadsheetCreatedAndVerified { file_id: NonEmptyStr }
  | SpreadsheetCreateUnverified { cause: NonEmptyStr }
  | SpreadsheetMarkerMigratedAndVerified { file_id: NonEmptyStr }
  | SpreadsheetMarkerMigrationUnverified { cause: NonEmptyStr }
  | SpreadsheetConvergeRefused { cause: NonEmptyStr }

// THE QUERY IS A PARAMETER NOW, BECAUSE TWO QUESTIONS SHARE ONE READ. Both the current-marker and
// the superseded-marker searches are files.list over one drive differing only in the q string, and
// every arm of the outcome classification below is identical for the two. Forking this function per
// marker generation would duplicate five refusal arms to vary one argument.
fn read_spreadsheet(
  drive_id: NonEmptyStr,
  query: String,
) -> ReviewSpreadsheetObservation uses net: Network {
  let read = drive.Files.ListFiles(
    drive_id: drive_id as String,
    query: query,
  )
  match classify_rest_outcome(standing: RestReadExchange { rest: read.outcome }) {
    RestExchangeSucceeded => spreadsheet_from_file_list(list: read.list)
    RestExchangeStatusRefused { status, body } =>
      SheetSearchUnreadable {
        reason: join(["files.list refused with status ", to_string(status), ": ", body], "") as NonEmptyStr
      }
    RestExchangeUnreached { cause } =>
      SheetSearchUnreadable {
        reason: join(["files.list never reached Drive: ", cause as String], "") as NonEmptyStr
      }
    RestExchangeUndecodable { status, cause } =>
      SheetSearchUnreadable {
        reason: join(["files.list answered ", to_string(status), " with an unreadable body: ", cause as String], "") as NonEmptyStr
      }
    RestExchangeCommitAmbiguous { detail } =>
      SheetSearchUnreadable {
        reason: join(["files.list reported commit ambiguity, which a read may not: ", detail], "") as NonEmptyStr
      }
  }
}

// THE RECOVERY READ. After a create -- successful or ambiguous -- the question is not what the
// create said but what the drive now holds under our key. Exactly one is the answer in both cases:
// after a success it is the file just made, and after an ambiguity it is the file the lost answer
// made. Two is a refusal even here, because a duplicate found at this moment is a duplicate the
// operator must adjudicate, not one this converge may quietly pick from.
fn verify_created_spreadsheet(
  drive_id: NonEmptyStr,
  marker_value: NonEmptyStr,
  create_detail: NonEmptyStr,
) -> SpreadsheetConvergeOutcome uses net: Network {
  match read_spreadsheet(drive_id: drive_id, query: review_sheet_search_query(marker_value: marker_value)) {
    SheetObservedOne { file_id: id } => SpreadsheetCreatedAndVerified { file_id: id }
    SheetAbsent =>
      SpreadsheetCreateUnverified {
        cause: join(
          ["no file carries the key after ", create_detail as String, "; the create did not take and was not refused"],
          "",
        ) as NonEmptyStr
      }
    SheetDuplicated { file_ids: ids } =>
      SpreadsheetConvergeRefused {
        cause: join(
          ["after ", create_detail as String, " two or more files carry the key (", join(ids, ", "), "); an earlier create also landed and only an operator can say which is real"],
          "",
        ) as NonEmptyStr
      }
    SheetSearchIncomplete =>
      SpreadsheetCreateUnverified {
        cause: join([create_detail as String, ", and the verifying search was incomplete, so nothing may be reported as created"], "") as NonEmptyStr
      }
    SheetPageIncomplete { next_page_token: _ } =>
      SpreadsheetCreateUnverified {
        cause: join([create_detail as String, ", and the verifying search returned one page of a longer list; a page is not the list, so a second file carrying the key may sit unread on the next page"], "") as NonEmptyStr
      }
    SheetSearchUnreadable { reason: r } =>
      SpreadsheetCreateUnverified {
        cause: join([create_detail as String, ", and the verifying read could not settle it: ", r as String], "") as NonEmptyStr
      }
  }
}

fn perform_spreadsheet_create(
  plan: SpreadsheetCreatePlan,
) -> SpreadsheetConvergeOutcome uses net: Network {
  let created = drive.Files.CreateFile(
    name: plan.name as String,
    mime_type: google_sheet_mime_type as String,
    parent_id: plan.drive_id as String,
    marker_property_value: plan.marker_property_value as String,
  )
  match classify_rest_outcome(standing: RestMutationExchange { rest: created.outcome }) {
    RestExchangeSucceeded =>
      verify_created_spreadsheet(
        drive_id: plan.drive_id,
        marker_value: plan.marker_property_value,
        create_detail: "files.create answered success" as NonEmptyStr,
      )
    RestExchangeCommitAmbiguous { detail } =>
      verify_created_spreadsheet(
        drive_id: plan.drive_id,
        marker_value: plan.marker_property_value,
        create_detail: join(["files.create left the write ambiguous (", detail, ")"], "") as NonEmptyStr,
      )
    RestExchangeStatusRefused { status, body } =>
      SpreadsheetConvergeRefused {
        cause: join(["files.create refused with status ", to_string(status), ": ", body], "") as NonEmptyStr
      }
    RestExchangeUnreached { cause } =>
      SpreadsheetConvergeRefused {
        cause: join(["files.create never reached Drive: ", cause as String], "") as NonEmptyStr
      }
    RestExchangeUndecodable { status, cause } =>
      SpreadsheetConvergeRefused {
        cause: join(["files.create answered ", to_string(status), " with an unreadable body: ", cause as String], "") as NonEmptyStr
      }
  }
}

// THE READBACK IS A SEARCH, NOT THE PATCH'S OWN ANSWER, AND IT ASSERTS THE ID RATHER THAN A COUNT.
// files.update answering 200 establishes that Drive accepted a write; it does not establish that a
// search on the current marker now reaches this file, which is the only property the migration
// exists to produce. So the verification re-asks the ORIGINAL question -- the current-marker query
// that found nothing before the write -- and requires the answer to be the file we patched.
//
// EXACTLY-ONE IS NOT ENOUGH HERE and the difference is not pedantic: a concurrent create elsewhere
// would also answer exactly-one, and adopting it would hand this converge a different spreadsheet
// than the one holding the operator's data -- the original defect with the roles reversed. The id
// comparison is what makes the readback about this actuation rather than about the drive.
fn verify_marker_migration(
  drive_id: NonEmptyStr,
  marker_value: NonEmptyStr,
  expected_file_id: NonEmptyStr,
  migration_detail: NonEmptyStr,
) -> SpreadsheetConvergeOutcome uses net: Network {
  match read_spreadsheet(drive_id: drive_id, query: review_sheet_search_query(marker_value: marker_value)) {
    SheetObservedOne { file_id: id } =>
      if (id as String) == (expected_file_id as String) {
        SpreadsheetMarkerMigratedAndVerified { file_id: id }
      } else {
        SpreadsheetConvergeRefused {
          cause: join(
            [
              migration_detail as String,
              ", and the current marker now reaches ",
              id as String,
              " rather than the file it was written onto (",
              expected_file_id as String,
              "); another file answers for this identity and only an operator can say which is real",
            ],
            "",
          ) as NonEmptyStr
        }
      }
    SheetAbsent =>
      SpreadsheetMarkerMigrationUnverified {
        cause: join(
          [migration_detail as String, ", and no file carries the current marker afterwards; the write did not take and was not refused"],
          "",
        ) as NonEmptyStr
      }
    SheetDuplicated { file_ids: ids } =>
      SpreadsheetConvergeRefused {
        cause: join(
          [migration_detail as String, ", and two or more files now carry the current marker (", join(ids, ", "), "); a second lineage exists and only an operator can say which is real"],
          "",
        ) as NonEmptyStr
      }
    SheetSearchIncomplete =>
      SpreadsheetMarkerMigrationUnverified {
        cause: join([migration_detail as String, ", and the verifying search was incomplete, so the migration may not be reported as done"], "") as NonEmptyStr
      }
    SheetPageIncomplete { next_page_token: _ } =>
      SpreadsheetMarkerMigrationUnverified {
        cause: join([migration_detail as String, ", and the verifying search returned one page of a longer list; a page is not the list"], "") as NonEmptyStr
      }
    SheetSearchUnreadable { reason: r } =>
      SpreadsheetMarkerMigrationUnverified {
        cause: join([migration_detail as String, ", and the verifying read could not settle it: ", r as String], "") as NonEmptyStr
      }
  }
}

// AN AMBIGUOUS COMMIT VERIFIES RATHER THAN REFUSES, FOR THE SAME REASON THE CREATE PATH DOES: the
// question after a lost answer is not what the call said but what the drive now holds. Unlike the
// create path this write is IDEMPOTENT -- writing one properties key twice leaves the same file in
// the same state -- so a lost answer here cannot have minted anything, and re-reading settles it.
fn perform_marker_migration(
  drive_id: NonEmptyStr,
  plan: SpreadsheetMarkerMigrationPlan,
) -> SpreadsheetConvergeOutcome uses net: Network {
  let patched = drive.Files.UpdateFileProperties(
    file_id: plan.file_id as String,
    marker_property_value: plan.marker_property_value as String,
  )
  match classify_rest_outcome(standing: RestMutationExchange { rest: patched.outcome }) {
    RestExchangeSucceeded =>
      verify_marker_migration(
        drive_id: drive_id,
        marker_value: plan.marker_property_value,
        expected_file_id: plan.file_id,
        migration_detail: join(["files.update answered success for ", plan.file_id as String], "") as NonEmptyStr,
      )
    RestExchangeCommitAmbiguous { detail } =>
      verify_marker_migration(
        drive_id: drive_id,
        marker_value: plan.marker_property_value,
        expected_file_id: plan.file_id,
        migration_detail: join(["files.update left the write ambiguous for ", plan.file_id as String, " (", detail, ")"], "") as NonEmptyStr,
      )
    RestExchangeStatusRefused { status, body } =>
      SpreadsheetConvergeRefused {
        cause: join(["files.update refused with status ", to_string(status), ": ", body], "") as NonEmptyStr
      }
    RestExchangeUnreached { cause } =>
      SpreadsheetConvergeRefused {
        cause: join(["files.update never reached Drive: ", cause as String], "") as NonEmptyStr
      }
    RestExchangeUndecodable { status, cause } =>
      SpreadsheetConvergeRefused {
        cause: join(["files.update answered ", to_string(status), " with an unreadable body: ", cause as String], "") as NonEmptyStr
      }
  }
}

// THE SECOND SEARCH IS ISSUED ONLY WHERE ITS ANSWER CAN CHANGE THE DECISION, WHICH IS ALSO WHERE IT
// IS SAFE TO SKIP IT. An adopted sheet settles the identity, so the steady state -- every run after
// the first -- issues exactly the one files.list it issued before this change, and the refusing arms
// have already refused for a reason that a superseded-marker file could not repair.
fn read_superseded_marker(
  drive_id: NonEmptyStr,
  marker_value: NonEmptyStr,
  observed: ReviewSpreadsheetObservation,
) -> SupersededSearchReading uses net: Network {
  match observed {
    SheetAbsent =>
      SupersededRead {
        observation: read_spreadsheet(
          drive_id: drive_id,
          query: review_sheet_superseded_search_query(marker_value: marker_value),
        )
      }
    SheetObservedOne { file_id: _ } => SupersededNotConsulted
    SheetDuplicated { file_ids: _ } => SupersededNotConsulted
    SheetSearchIncomplete => SupersededNotConsulted
    SheetPageIncomplete { next_page_token: _ } => SupersededNotConsulted
    SheetSearchUnreadable { reason: _ } => SupersededNotConsulted
  }
}

fn converge_review_spreadsheet(
  drive_id: NonEmptyStr,
  sheet_name: NonEmptyStr,
  marker_value: NonEmptyStr,
  policy: EnsurePolicy,
) -> SpreadsheetConvergeOutcome uses net: Network {
  let observed = read_spreadsheet(
    drive_id: drive_id,
    query: review_sheet_search_query(marker_value: marker_value),
  )
  let superseded = read_superseded_marker(
    drive_id: drive_id,
    marker_value: marker_value,
    observed: observed,
  )
  match ensure_review_spreadsheet(
    policy: policy,
    observed: observed,
    superseded: superseded,
    drive_id: drive_id,
    sheet_name: sheet_name,
    marker_value: marker_value,
  ) {
    Noop => spreadsheet_noop_outcome(observed: observed)
    Refuse { reason: r } => SpreadsheetConvergeRefused { cause: r }
    Apply { plan: p } =>
      match p {
        SpreadsheetCreate { create: c } => perform_spreadsheet_create(plan: c)
        SpreadsheetMigrateMarker { migrate: m } =>
          perform_marker_migration(drive_id: drive_id, plan: m)
      }
  }
}

fn spreadsheet_noop_outcome(observed: ReviewSpreadsheetObservation) -> SpreadsheetConvergeOutcome {
  match observed {
    SheetObservedOne { file_id: id } => SpreadsheetAdopted { file_id: id }
    SheetAbsent =>
      SpreadsheetConvergeRefused {
        cause: "converged on an absent spreadsheet, which no arm of ensure_review_spreadsheet produces" as NonEmptyStr
      }
    SheetDuplicated { file_ids: _ } =>
      SpreadsheetConvergeRefused {
        cause: "converged on duplicated spreadsheets, which no arm of ensure_review_spreadsheet produces" as NonEmptyStr
      }
    SheetSearchIncomplete =>
      SpreadsheetConvergeRefused {
        cause: "converged on an incomplete search, which no arm of ensure_review_spreadsheet produces" as NonEmptyStr
      }
    SheetPageIncomplete { next_page_token: _ } =>
      SpreadsheetConvergeRefused {
        cause: "converged on one page of a longer file list, which no arm of ensure_review_spreadsheet produces" as NonEmptyStr
      }
    SheetSearchUnreadable { reason: r } =>
      SpreadsheetConvergeRefused {
        cause: join(["converged on an unreadable search: ", r as String], "") as NonEmptyStr
      }
  }
}

fn spreadsheet_outcome_text(o: SpreadsheetConvergeOutcome) -> String {
  match o {
    SpreadsheetMarkerMigratedAndVerified { file_id: id } =>
      join(["adopted sheet ", id as String, " and migrated it from the superseded marker to the current one"], "")
    SpreadsheetMarkerMigrationUnverified { cause: c } =>
      join(["marker migration UNVERIFIED: ", c as String], "")
    SpreadsheetAdopted { file_id: id } => join(["adopted existing sheet ", id as String], "")
    SpreadsheetCreatedAndVerified { file_id: id } =>
      join(["created and verified by readback: ", id as String], "")
    SpreadsheetCreateUnverified { cause: c } => join(["UNVERIFIED: ", c as String], "")
    SpreadsheetConvergeRefused { cause: c } => join(["REFUSED: ", c as String], "")
  }
}
