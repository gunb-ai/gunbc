module gunbc._scratch_argv_call_probe

import std.types { String, List }
import std.process { ProcessExit, ExitSuccess }

type ScratchMode
  = ModeA
  | ModeB

fn scratch_argv_tokens(mode: ScratchMode) -> List<String> {
  match mode {
    ModeA => ["hello-a"]
    ModeB => ["hello-b", "extra"]
  }
}

service scratch.Probe {
  operation Echo {
    input { mode: ScratchMode }
    output { stdout: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell { argv: ["echo", scratch_argv_tokens(mode: mode)] }
    exit {
      0 => Unit
      nonzero => String "echo failed"
    }
  }
}

fn scratch_probe_argv_call() -> ProcessExit {
  let a = scratch.Probe.Echo(mode: ModeA)
  let b = scratch.Probe.Echo(mode: ModeB)
  ExitSuccess { message: concat(a.stdout, "|", b.stdout) }
}
