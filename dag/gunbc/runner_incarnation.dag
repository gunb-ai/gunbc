module gunbc.runner_incarnation

import std.types { String, NonEmptyStr, Bool }
import std.nat { Nat }
import std.disposition { Disposition, SingleAuthority }
import product.placement_supply { HostIdentity }
import gunbc.build_cache_instance { RunnerSlotIdentity }

data runner_incarnation_authority_disposition: Disposition = SingleAuthority

data runner_incarnation_process_identity_note: String = "LocalRunnerSlotIncarnation deliberately carries NO process/PID field today. Staleness for ReplaceRunnerIncarnation is expressed through slot, unit, unit_active, and registration_name until gunbc.runner_lifecycle ObserveRunnerLocalState grounds a live process identity producer. Adding a phantom process field without that producer would be specification-without-execution (DESIGN section 5). The seam witness proves the modeled fields survive HostEffect projection; a dedicated process identity lands with ObserveRunnerLocalState wet read-back."

data runner_slot_installation_state_note: String = "INSTALLATION STATES (operator corrections 2026-08-07): SlotAbsent | SlotMaterializedNotActive | SlotCurrentlyActive. Materialized-not-active is ONE actionable state whether or not a stale .runner exists — run.sh --jitconfig rewrites .runner every incarnation start (srv1-01 measured: .runner mtime 09:19:21, unit ActiveEnterTimestamp 09:19:20). srv3-06/07 stale Jul-21 .runner files are harmless; ADD does NOT need IncarnationReplace. Startable when install tree complete AND unit disabled+inactive; converged when unit active. When materialized, ADD may need only set-property caps + daemon-reload + start (scope UNRULED). Digest/extract only for SlotAbsent. Never refuse or re-extract complete trees."

data runner_slot_stale_runner_dot_note: String = "stale_runner_dot_present records HISTORY only (never-activated vs previously-activated). It must NOT fork the plan or block activation. Measured: jit-runner.sh does not clean .runner/.credentials before start; run.sh overwrites them."

type RunnerSlotInstallationState
  = SlotAbsent {}
  | SlotMaterializedNotActive {
      install_tree_complete: Bool
      unit_active: Bool
      stale_runner_dot_present: Bool
    }
  | SlotCurrentlyActive {}

fn runner_slot_add_requires_incarnation_replace(state: RunnerSlotInstallationState) -> Bool {
  match state {
    SlotAbsent {} => false
    SlotMaterializedNotActive { install_tree_complete: _, unit_active: _, stale_runner_dot_present: _ } => false
    SlotCurrentlyActive {} => false
  }
}

fn runner_slot_installation_is_ready_to_activate(state: RunnerSlotInstallationState) -> Bool {
  match state {
    SlotAbsent {} => false
    SlotMaterializedNotActive { install_tree_complete: complete, unit_active: active, stale_runner_dot_present: _ } =>
      complete && !active
    SlotCurrentlyActive {} => false
  }
}

fn runner_slot_installation_is_converged(state: RunnerSlotInstallationState) -> Bool {
  match state {
    SlotAbsent {} => false
    SlotMaterializedNotActive { install_tree_complete: _, unit_active: active, stale_runner_dot_present: _ } => active
    SlotCurrentlyActive {} => true
  }
}

fn runner_slot_installation_must_not_reextract(state: RunnerSlotInstallationState) -> Bool {
  match state {
    SlotAbsent {} => false
    SlotMaterializedNotActive { install_tree_complete: complete, unit_active: _, stale_runner_dot_present: _ } =>
      complete
    SlotCurrentlyActive {} => true
  }
}

type LocalRunnerSlotIncarnation {
  slot: RunnerSlotIdentity
  unit: NonEmptyStr
  unit_active: Bool
  registration_name: NonEmptyStr
}

fn slot_suffix(slot_index: Nat) -> String {
  if slot_index == 1 {
    "01"
  } else if slot_index == 2 {
    "02"
  } else if slot_index == 3 {
    "03"
  } else if slot_index == 4 {
    "04"
  } else if slot_index == 5 {
    "05"
  } else if slot_index == 6 {
    "06"
  } else if slot_index == 7 {
    "07"
  } else {
    "00"
  }
}

fn runner_slot_incarnation(
  host: HostIdentity,
  slot_index: Nat,
  unit_active: Bool,
) -> LocalRunnerSlotIncarnation {
  let registration_name = join([host as String, "-", slot_suffix(slot_index: slot_index)], "") as NonEmptyStr
  LocalRunnerSlotIncarnation {
    slot: RunnerSlotIdentity { host: host, slot_index: slot_index },
    unit: join(["actions-runner@", registration_name as String, ".service"], "") as NonEmptyStr,
    unit_active: unit_active,
    registration_name: registration_name,
  }
}

fn local_runner_slot_incarnation_fields_match(
  left: LocalRunnerSlotIncarnation,
  right: LocalRunnerSlotIncarnation,
) -> Bool {
  (left.slot.host as String) == (right.slot.host as String)
    && left.slot.slot_index == right.slot.slot_index
    && left.unit == right.unit
    && left.unit_active == right.unit_active
    && left.registration_name == right.registration_name
}
