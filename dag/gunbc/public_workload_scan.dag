module gunbc.public_workload_scan

import std.types { Bool, Int, List, NonEmptyStr, Secret, String }
import std.resources { Network }
import extdeps.github.github { max_per_page }
import extdeps.github.code_search { CodeSearchHit, CodeSearchPage, CodeSearchRepository }
import extdeps.transports.rest { RestExchangePerformance }
import gunbc.ci_workflow_source_read {
  CodeSearchPageRead, CodeSearchPageComplete, CodeSearchPageTruncated, CodeSearchPageRefused,
  HitRevisionResolution, RepositoryHeadResolution,
  perform_code_search_page, perform_repository_head_resolution, perform_hit_read_at_repository_head,
}

// A BOUNDED, READ-ONLY WALK OF GITHUB CODE SEARCH, AND THE RECEIPT THAT SAYS WHAT IT COVERED.
//
// Code search is a declared-incomplete instrument (extdeps.github.code_search): a query is capped
// upstream, a page may come back truncated, and the index lags the repositories it points at. So
// the output of a walk is never "the repositories that match". It is a population produced under a
// stated policy, and the receipt is what lets a reader tell a small population from a short walk:
// every query records exactly why it stopped, every page records how many items it actually
// delivered, every individual sighting records which query found which file on which page at which
// position, and every distinct file carries its resolution outcome, including the ones that refused.
//
// EACH QUERY IS BOUNDED ON ITS OWN. An earlier revision spent one scan-wide distinct-hit budget in
// query order, so the first queries filled it and the later ones made no request at all - a
// population shaped by where a label happened to sit in the roster. Every admitted query now receives
// its own pages and its own distinct-hit bound; a file found by several queries is read once.
//
// NOTHING HERE CONTACTS ANYONE OR RUNS ANYTHING. It pages search, then for each distinct file
// resolves the repository's default-branch head and reads the workflow file at that exact commit.
// No outreach admission, trial authorization or third-party execution is reachable from this module.
//
// A HIT THAT DID NOT COME BACK IS NOT A FACT ABOUT ITS REPOSITORY. A consumer comparing two
// receipts must not conclude that a repository missing from the later one stopped using a runner:
// the later walk may have stopped earlier, been truncated, or been served a different slice of the
// index. The receipt carries the stops precisely so that conclusion is refused rather than drawn.

type ScanQueryPolicy {
  query_id: NonEmptyStr
  query: NonEmptyStr
  per_page: Int
  max_pages: Int
  max_distinct_hits: Int
}

type WorkloadScanPolicy {
  queries: List<ScanQueryPolicy>
}

// WHY A QUERY STOPPED. Each arm has a different reading of the population it left behind:
//   PagesExhausted  -- a page delivered fewer items than asked for; the walk reached the end of what
//                      the endpoint would serve for this query (itself capped upstream);
//   PageLimit       -- the query's page bound was reached with pages still being delivered full;
//   HitLimit        -- the query's distinct-hit bound was reached, possibly mid-page;
//   Truncated       -- upstream said it gave up (incomplete_results); what came back is a lower
//                      bound of unknown tightness and the walk does not page past it;
//   PageRefused     -- the request itself failed; nothing is known past the last delivered page.
type ScanQueryStop
  = ScanQueryPagesExhausted
  | ScanQueryPageLimit
  | ScanQueryHitLimit
  | ScanQueryTruncated { page: Int, cause: NonEmptyStr }
  | ScanQueryPageRefused { page: Int, performance: RestExchangePerformance }

type ScanPageReceipt {
  page: Int
  items_delivered: Int
}

// ONE SIGHTING PER DELIVERED ITEM, including items past the query's distinct-hit bound: an item the
// bound declined was still delivered, and dropping it would make the page counts and the sightings
// disagree about what the endpoint returned. `admitted` says whether it counted toward the bound.
type HitSighting {
  query_id: NonEmptyStr
  query: NonEmptyStr
  page: Int
  position: Int
  hit: CodeSearchHit
  admitted: Bool
}

type ScanQueryReceipt {
  policy: ScanQueryPolicy
  pages: List<ScanPageReceipt>
  stop: ScanQueryStop
}

type ScanHitReceipt {
  hit: CodeSearchHit
  resolution: HitRevisionResolution
}

type WorkloadScanReceipt {
  queries: List<ScanQueryReceipt>
  sightings: List<HitSighting>
  hits: List<ScanHitReceipt>
}

// A policy that cannot bound anything is refused before any request is made.
type WorkloadScanPolicyAdmission
  = WorkloadScanPolicyAdmitted { policy: WorkloadScanPolicy }
  | WorkloadScanPolicyRefused { cause: NonEmptyStr }

fn query_policy_refusal(q: ScanQueryPolicy) -> String {
  if q.per_page < 1 || q.per_page > max_per_page {
    join(["query ", q.query_id as String, ": per_page must be between 1 and the endpoint's maximum of ", to_string(value: max_per_page), "; got ", to_string(value: q.per_page)], "")
  } else if q.max_pages < 1 {
    join(["query ", q.query_id as String, ": max_pages must be at least 1"], "")
  } else if q.max_distinct_hits < 1 {
    join(["query ", q.query_id as String, ": max_distinct_hits must be at least 1"], "")
  } else {
    ""
  }
}

fn admit_workload_scan_policy(policy: WorkloadScanPolicy) -> WorkloadScanPolicyAdmission {
  let ids = map(policy.queries, q => q.query_id as String)
  let refusals = filter(map(policy.queries, q => query_policy_refusal(q: q)), r => r != "")
  if count(policy.queries) == 0 {
    WorkloadScanPolicyRefused { cause: "a scan with no queries has nothing to walk" }
  } else if any(ids, id => count(filter(ids, other => other == id)) > 1) {
    WorkloadScanPolicyRefused { cause: "query ids must be distinct: a sighting names its query by id, so two queries sharing one id could not be told apart in the receipt" }
  } else {
    match refusals |> first {
      Present { value: cause } => WorkloadScanPolicyRefused { cause: cause as NonEmptyStr }
      Absent => WorkloadScanPolicyAdmitted { policy: policy }
    }
  }
}

// ---------------------------------------------------------------------------------------------
// One page, decided. PURE: the walk's every stop is a function of the query's policy, the state before
// the page, and what the page read observed, so a witness drives each stop through the real decision.

fn hit_identity_eq(a: CodeSearchHit, b: CodeSearchHit) -> Bool {
  a.repository.id == b.repository.id && a.path == b.path
}

type ScanWalkState {
  pages: List<ScanPageReceipt>
  admitted: List<CodeSearchHit>
  sightings: List<HitSighting>
}

type ScanPageStep
  = ScanPageContinue { state: ScanWalkState }
  | ScanPageStop { state: ScanWalkState, stop: ScanQueryStop }

type PageAdmission {
  admitted: List<CodeSearchHit>
  sightings: List<HitSighting>
  declined: Int
}

// Items are admitted one at a time against the query's distinct-hit bound, so a bound reached
// mid-page stops there rather than admitting the rest of the page and overshooting the policy.
fn admit_page_items(policy: ScanQueryPolicy, page: Int, before: ScanWalkState, items: List<CodeSearchHit>) -> PageAdmission {
  fold(enumerate(items), init: PageAdmission { admitted: before.admitted, sightings: before.sightings, declined: 0 }, f: fn(acc, pair) {
    let hit = pair.second
    let known = any(acc.admitted, h => hit_identity_eq(a: h, b: hit))
    let room = count(acc.admitted) < policy.max_distinct_hits
    PageAdmission {
      admitted: if !known && room { concat(acc.admitted, [hit]) } else { acc.admitted },
      sightings: concat(acc.sightings, [HitSighting { query_id: policy.query_id, query: policy.query, page: page, position: pair.first + 1, hit: hit, admitted: known || room }]),
      declined: if known || room { acc.declined } else { acc.declined + 1 },
    }
  })
}

fn scan_page_step(policy: ScanQueryPolicy, page: Int, before: ScanWalkState, read: CodeSearchPageRead) -> ScanPageStep {
  match read {
    CodeSearchPageRefused { performance } =>
      ScanPageStop { state: before, stop: ScanQueryPageRefused { page: page, performance: performance } }
    CodeSearchPageTruncated { page: p, hits_read, cause } => {
      let a = admit_page_items(policy: policy, page: page, before: before, items: p.items)
      ScanPageStop {
        state: ScanWalkState { pages: concat(before.pages, [ScanPageReceipt { page: page, items_delivered: hits_read }]), admitted: a.admitted, sightings: a.sightings },
        stop: ScanQueryTruncated { page: page, cause: cause },
      }
    }
    CodeSearchPageComplete { page: p, hits_read } => {
      let a = admit_page_items(policy: policy, page: page, before: before, items: p.items)
      let after = ScanWalkState { pages: concat(before.pages, [ScanPageReceipt { page: page, items_delivered: hits_read }]), admitted: a.admitted, sightings: a.sightings }
      if a.declined > 0 {
        ScanPageStop { state: after, stop: ScanQueryHitLimit }
      } else if hits_read < policy.per_page {
        ScanPageStop { state: after, stop: ScanQueryPagesExhausted }
      } else if page >= policy.max_pages {
        ScanPageStop { state: after, stop: ScanQueryPageLimit }
      } else if count(after.admitted) >= policy.max_distinct_hits {
        ScanPageStop { state: after, stop: ScanQueryHitLimit }
      } else {
        ScanPageContinue { state: after }
      }
    }
  }
}

// ---------------------------------------------------------------------------------------------
// The walk. Pages are numbered from 1, as the endpoint numbers them.

type ScanQueryWalk {
  receipt: ScanQueryReceipt
  state: ScanWalkState
}

func walk_query_from(auth_token: Secret, policy: ScanQueryPolicy, page: Int, state: ScanWalkState) -> ScanQueryWalk uses net: Network {
  let read = perform_code_search_page(auth_token: auth_token, q: policy.query as String, per_page: policy.per_page, page: page)
  match scan_page_step(policy: policy, page: page, before: state, read: read) {
    ScanPageStop { state: s, stop } =>
      ScanQueryWalk { receipt: ScanQueryReceipt { policy: policy, pages: s.pages, stop: stop }, state: s }
    ScanPageContinue { state: s } =>
      walk_query_from(auth_token: auth_token, policy: policy, page: page + 1, state: s)
  }
}

func walk_query(auth_token: Secret, policy: ScanQueryPolicy) -> ScanQueryWalk uses net: Network {
  walk_query_from(auth_token: auth_token, policy: policy, page: 1, state: ScanWalkState { pages: [], admitted: [], sightings: [] })
}

// ---------------------------------------------------------------------------------------------
// Resolution: one repository and branch read per distinct repository, then one file read per
// distinct (repository id, path) across every query.

fn repository_eq(a: CodeSearchRepository, b: CodeSearchRepository) -> Bool {
  a.id == b.id && a.name == b.name && a.full_name == b.full_name && a.private == b.private && a.fork == b.fork
}

type RepositoryResolutionEntry {
  repository: CodeSearchRepository
  resolution: RepositoryHeadResolution
}

type HitResolutionAccumulated {
  heads: List<RepositoryResolutionEntry>
  receipts: List<ScanHitReceipt>
}

fn distinct_files(admitted: List<CodeSearchHit>) -> List<CodeSearchHit> {
  fold(admitted, init: [], f: fn(acc, h) { if any(acc, a => hit_identity_eq(a: a, b: h)) { acc } else { concat(acc, [h]) } })
}

// One fold: a hit whose repository already has an entry reuses it, and a hit whose repository does
// not resolves it and adds the entry in the same step, so no hit can reach a lookup that misses.
func resolve_distinct_hits(auth_token: Secret, hits: List<CodeSearchHit>) -> List<ScanHitReceipt> uses net: Network {
  fold(hits, init: HitResolutionAccumulated { heads: [], receipts: [] }, f: fn(acc, hit) {
    match filter(acc.heads, e => repository_eq(a: e.repository, b: hit.repository)) |> first {
      Present { value: e } => HitResolutionAccumulated {
        heads: acc.heads,
        receipts: concat(acc.receipts, [ScanHitReceipt { hit: hit, resolution: perform_hit_read_at_repository_head(auth_token: auth_token, hit: hit, resolution: e.resolution) }]),
      }
      Absent => {
        let resolved = perform_repository_head_resolution(auth_token: auth_token, hit: hit)
        HitResolutionAccumulated {
          heads: concat(acc.heads, [RepositoryResolutionEntry { repository: hit.repository, resolution: resolved }]),
          receipts: concat(acc.receipts, [ScanHitReceipt { hit: hit, resolution: perform_hit_read_at_repository_head(auth_token: auth_token, hit: hit, resolution: resolved) }]),
        }
      }
    }
  }).receipts
}

type ScanWalkAccumulated {
  receipts: List<ScanQueryReceipt>
  admitted: List<CodeSearchHit>
  sightings: List<HitSighting>
}

type WorkloadScan
  = WorkloadScanCompleted { receipt: WorkloadScanReceipt }
  | WorkloadScanNotStarted { cause: NonEmptyStr }

func perform_workload_scan(auth_token: Secret, policy: WorkloadScanPolicy) -> WorkloadScan uses net: Network {
  match admit_workload_scan_policy(policy: policy) {
    WorkloadScanPolicyRefused { cause } => WorkloadScanNotStarted { cause: cause }
    WorkloadScanPolicyAdmitted { policy: admitted } => {
      let walked = fold(admitted.queries, init: ScanWalkAccumulated { receipts: [], admitted: [], sightings: [] }, f: fn(acc, q) {
        let w = walk_query(auth_token: auth_token, policy: q)
        ScanWalkAccumulated {
          receipts: concat(acc.receipts, [w.receipt]),
          admitted: concat(acc.admitted, w.state.admitted),
          sightings: concat(acc.sightings, w.state.sightings),
        }
      })
      WorkloadScanCompleted {
        receipt: WorkloadScanReceipt {
          queries: walked.receipts,
          sightings: walked.sightings,
          hits: resolve_distinct_hits(auth_token: auth_token, hits: distinct_files(admitted: walked.admitted)),
        },
      }
    }
  }
}
