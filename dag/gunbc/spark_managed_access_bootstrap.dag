module gunbc.spark_managed_access_bootstrap


// WHAT THE PROBE ESTABLISHED, AND WHAT FOLLOWS FROM IT.
//
// The credential-bound probe measured, on both Sparks: the fleet key authenticates as briansrls;
// ubuntu, ghrunner and root refuse; `sudo -n -l` as briansrls requires a password. Those are facts
// about a HUMAN BOOTSTRAP ACCOUNT that the operator created by hand, and the standing they produce
// is deliberately not "access grounded":
//
//   human bootstrap access      OBSERVED
//   managed executor account    ABSENT
//   -> managed access bootstrap REQUIRED
//
// Evidence gathered as briansrls may never satisfy a requirement about FleetAccountAutomation. That
// is not caution -- it is what the account model already says: an occurrence is (host x principal),
// so an observation of one principal is silent about another by construction. The reason it needs
// saying at all is that both are reached with the SAME KEY, so a receipt that recorded only "the
// fleet key works on srv5" would read as though automation access existed.

// The standing a host holds with respect to MANAGED access, distinct from whether anything reached
// it. BootstrapRequired carries the account it is missing rather than a flag, because the next step
// needs to name an occurrence and a flag would make the reader re-derive it.
type SparkManagedAccessStanding
  = ManagedAccessGrounded { occurrence: gunbc.fleet_posix_accounts.PosixAccountOccurrence }
  | ManagedAccessBootstrapRequired {
      host: product.placement_supply.HostIdentity
      missing: gunbc.fleet_posix_accounts.PosixAccountOccurrence
      bootstrap_transport: gunbc.fleet_posix_accounts.PosixAccountOccurrence
    }
  | ManagedAccessUnobserved { host: product.placement_supply.HostIdentity }

// THE OBSERVED INPUT, at the grain the probe actually measures: one host, one principal, one
// authentication outcome, one privilege outcome. Deliberately NOT a host-grained record with a field
// per capability -- that shape lets an observation of one principal satisfy a question about
// another, which is the single defect that would make every conclusion below unsound.
type PrincipalReachObservation {
  host: product.placement_supply.HostIdentity
  principal_login_name: std.types.NonEmptyStr
  credential_identity: std.content_hash.ContentHash
  authenticated: Bool
  holds_any_passwordless_grant: Bool
}

// THE FIELD IS NAMED FOR WHAT IT MEASURES, and the rename is a repair rather than a preference.
// It was `passwordless_privilege`, measured by `sudo -n -l` -- which exits 0 whenever the account
// holds ANY nopasswd entry, including a single-command grant. The name promised a general capability
// the measurement never established, and I acted on the name: I read it as "can perform privileged
// installs", reported the serving install unblocked, and was refuted by enumerating the actual
// grant (one command, `loginctl enable-linger`, on both Sparks).
//
// This is the record's OWN stated defect arriving one level down. The comment above explains that a
// host-grained shape would let one principal's evidence answer another's question; a field named
// more broadly than its measurement does the same thing along a different axis -- it lets one
// question's evidence answer a bigger question -- and a Bool cannot be narrowed by its reader.
//
// So the name now states exactly what a successful `sudo -n -l` proves and nothing beyond it. What
// commands the account may actually run is a POPULATION, not a Bool, and reducing it is what caused
// the error; that enumeration is reported verbatim by fleet_multi_principal_probe
// spark_exact_grant_probe_wet. Any consumer asking "may this account perform effect X" must join
// against that population -- this field cannot answer it and no longer appears to.

fn observation_for(
  observations: List<PrincipalReachObservation>,
  host: product.placement_supply.HostIdentity,
  login: std.types.NonEmptyStr,
) -> PrincipalReachObservation? {
  fold(observations, init: none, f: fn(acc, o) {
    match acc {
      Present { value: _ } => acc
      Absent => if (o.host as String) == (host as String) && (o.principal_login_name as String) == (login as String) {
        Present { value: o }
      } else { none }
    }
  })
}

// The managed executor's login name on a Spark. Named here rather than discovered, because which
// account is THE managed executor is a modeling decision, and a bootstrap that adopted whatever
// automation-looking account it found would be inferring intent from the host.
data spark_managed_executor_login: String = "gunbc-automation"
data spark_operator_bootstrap_login: String = "briansrls"

// DERIVING THE STANDING. Absence of an observation is ManagedAccessUnobserved, never
// BootstrapRequired: "nobody looked" and "we looked and it is not there" have different remedies,
// and collapsing them would let a probe that never ran authorize account creation.
// Absence of a MANAGED observation falls through to asking whether anything reaches the host at all,
// because a bootstrap needs a transport: with no reachable principal there is nothing to bootstrap
// THROUGH, so the honest standing is unobserved rather than a plan that could not be executed.
fn derive_spark_managed_access_standing(
  host: product.placement_supply.HostIdentity,
  observations: List<PrincipalReachObservation>,
) -> SparkManagedAccessStanding {
  let managed = gunbc.fleet_posix_accounts.PosixAccountOccurrence { host: host, principal: FleetAccountAutomation }
  let bootstrap = gunbc.fleet_posix_accounts.PosixAccountOccurrence { host: host, principal: FleetAccountOperator }
  match gunbc.spark_managed_access_bootstrap.observation_for(observations: observations, host: host, login: spark_managed_executor_login as std.types.NonEmptyStr) {
    Present { value: m } =>
      if m.authenticated {
        ManagedAccessGrounded { occurrence: managed }
      } else {
        ManagedAccessBootstrapRequired { host: host, missing: managed, bootstrap_transport: bootstrap }
      }
    Absent =>
      match gunbc.spark_managed_access_bootstrap.observation_for(observations: observations, host: host, login: spark_operator_bootstrap_login as std.types.NonEmptyStr) {
        Present { value: b } =>
          if b.authenticated {
            ManagedAccessBootstrapRequired { host: host, missing: managed, bootstrap_transport: bootstrap }
          } else {
            ManagedAccessUnobserved { host: host }
          }
        Absent => ManagedAccessUnobserved { host: host }
      }
  }
}

// THE EFFECT POPULATION, exact and ordered. Each effect names the privilege it requires, which is
// what makes privilege an OUTPUT of the plan rather than an input to it: nobody asks "does this need
// root" -- the plan is derived, and whether it contains a privileged effect is then a fact about it.
type SparkBootstrapEffect
  = CreateManagedAccount { occurrence: gunbc.fleet_posix_accounts.PosixAccountOccurrence, login: std.types.NonEmptyStr }
  | InstallFleetAuthorizedKey { occurrence: gunbc.fleet_posix_accounts.PosixAccountOccurrence, public_material_identity: std.content_hash.ContentHash }
  | ProveKeyOnlyAuthentication { occurrence: gunbc.fleet_posix_accounts.PosixAccountOccurrence }
  | InstallNarrowPrivilegeGrant { occurrence: gunbc.fleet_posix_accounts.PosixAccountOccurrence, grant: std.types.NonEmptyStr }
  | CreateNoLoginServiceIdentity { occurrence: gunbc.fleet_posix_accounts.PosixAccountOccurrence, login: std.types.NonEmptyStr }

// Whether an effect can be performed by the bootstrap transport itself or needs privilege it does
// not hold. Derived per effect from what the effect DOES, not assigned per plan: creating an account
// writes /etc/passwd and /etc/shadow; writing another account's authorized_keys is that account's
// file rather than the transport's; installing a grant edits sudoers; creating the no-login identity
// is another account creation. Only the authentication proof is an ordinary unprivileged connection,
// which is exactly why it is in the plan -- it is the step that CHECKS the privileged ones landed.
fn bootstrap_effect_requires_privilege(effect: SparkBootstrapEffect) -> Bool {
  match effect {
    CreateManagedAccount { occurrence: _, login: _ } => true
    InstallFleetAuthorizedKey { occurrence: _, public_material_identity: _ } => true
    ProveKeyOnlyAuthentication { occurrence: _ } => false
    InstallNarrowPrivilegeGrant { occurrence: _, grant: _ } => true
    CreateNoLoginServiceIdentity { occurrence: _, login: _ } => true
  }
}

// THE PLAN. Head-plus-tail so an empty bootstrap has no constructor: "bootstrap required" that
// derives no effects is a contradiction, and representing it would let a caller report a plan while
// holding nothing to apply.
type SparkBootstrapPlan {
  host: product.placement_supply.HostIdentity
  transport: gunbc.fleet_posix_accounts.PosixAccountOccurrence
  first: SparkBootstrapEffect
  more: List<SparkBootstrapEffect>
}

fn spark_bootstrap_plan_effects(plan: SparkBootstrapPlan) -> List<SparkBootstrapEffect> {
  concat([plan.first], plan.more)
}

// The narrow grant, stated as exactly what the serving realization needs rather than a general
// privilege. Which grant is required is a function of the SELECTED REALIZATION -- a user unit under
// lingering needs `loginctl enable-linger` for its own account and nothing else, which is why this
// is one named grant and not sudo.
data spark_managed_narrow_grant: String = "loginctl enable-linger for this account only"

fn derive_spark_bootstrap_plan(
  standing: SparkManagedAccessStanding,
  fleet_public_material_identity: std.content_hash.ContentHash,
) -> SparkBootstrapPlan? {
  match standing {
    ManagedAccessGrounded { occurrence: _ } => none
    ManagedAccessUnobserved { host: _ } => none
    ManagedAccessBootstrapRequired { host: h, missing: m, bootstrap_transport: t } => Present {
      value: SparkBootstrapPlan {
        host: h,
        transport: t,
        first: CreateManagedAccount { occurrence: m, login: spark_managed_executor_login as std.types.NonEmptyStr },
        more: [
          InstallFleetAuthorizedKey { occurrence: m, public_material_identity: fleet_public_material_identity },
          ProveKeyOnlyAuthentication { occurrence: m },
          InstallNarrowPrivilegeGrant { occurrence: m, grant: spark_managed_narrow_grant as std.types.NonEmptyStr },
          CreateNoLoginServiceIdentity {
            occurrence: gunbc.fleet_posix_accounts.PosixAccountOccurrence { host: h, principal: FleetAccountInferenceService },
            login: "gunbc-inference" as std.types.NonEmptyStr,
          },
        ],
      }
    }
  }
}

// WHAT THE PLAN DEMANDS OF THE OPERATOR, derived rather than asked. The credential is requested only
// when the derived effect population actually contains privileged effects, and the request NAMES
// them -- so the operator is answering "may these five things happen on srv5", not "does this need
// root", which is a question nobody can evaluate.
//
// This is the shape that keeps privilege an output. A one-time credential is not a property of
// serving, and nothing here concludes that the serving runtime needs privilege: what needs it is
// account creation, which happens once and is then irreversible in the direction that matters.
type SparkBootstrapAuthorization
  = BootstrapProceedsUnprivileged { plan: SparkBootstrapPlan }
  | OperatorBootstrapCredentialRequired {
      host: product.placement_supply.HostIdentity
      first_privileged: SparkBootstrapEffect
      more_privileged: List<SparkBootstrapEffect>
      secret_purpose: std.types.NonEmptyStr
    }

fn authorize_spark_bootstrap(plan: SparkBootstrapPlan) -> SparkBootstrapAuthorization {
  let privileged = filter(spark_bootstrap_plan_effects(plan: plan), e => bootstrap_effect_requires_privilege(effect: e))
  match list_head_of_effects(effects: privileged) {
    Absent => BootstrapProceedsUnprivileged { plan: plan }
    Present { value: first } => OperatorBootstrapCredentialRequired {
      host: plan.host,
      first_privileged: first,
      more_privileged: list_tail_of_effects(effects: privileged),
      secret_purpose: "one-time administrator credential on this host, used solely to apply the named privileged effects through the modeled secret boundary; not retained, not a serving requirement" as std.types.NonEmptyStr,
    }
  }
}

fn list_head_of_effects(effects: List<SparkBootstrapEffect>) -> SparkBootstrapEffect? {
  match v2.std.algebra.list_head(effects) {
    HeadFound { value: e } => Present { value: e }
    HeadAbsent => none
  }
}

fn list_tail_of_effects(effects: List<SparkBootstrapEffect>) -> List<SparkBootstrapEffect> {
  match v2.std.algebra.list_tail(effects) {
    TailFound { tail: t } => t
    TailAbsent => []
  }
}

fn spark_bootstrap_effect_label(effect: SparkBootstrapEffect) -> String {
  match effect {
    CreateManagedAccount { occurrence: _, login: l } => join(["create-managed-account login=", l as String], "")
    InstallFleetAuthorizedKey { occurrence: _, public_material_identity: i } =>
      join(["install-fleet-authorized-key public_material_identity=", serialize_content_hash(hash: i) as String], "")
    ProveKeyOnlyAuthentication { occurrence: _ } => "prove-key-only-authentication"
    InstallNarrowPrivilegeGrant { occurrence: _, grant: g } => join(["install-narrow-privilege-grant grant=", g as String], "")
    CreateNoLoginServiceIdentity { occurrence: _, login: l } => join(["create-no-login-service-identity login=", l as String], "")
  }
}
