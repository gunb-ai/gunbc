module gunbc.stage0_crate_layout

import std.types { List, String, Bool }

data stage0_crate_layout_note: String = "Stage0 crate-organization projection for the v1 regen compile closure (src/v1 + dag). Self-emitted compiler module registration is derived on v2.compiler.self_host.frontier (compiler_frontier_self_emitted_stage0_mod_basenames); this module composes that derived set with the seed-retained intrinsic kernel + pilot scaffolds for emit_lib_rs and regen_stage0. Dissolve-on: regen compile roots include src/v2 and v1.compiler.emit_rust imports frontier directly — then delete this projection module."

data seed_retained_intrinsic_pub_mod_basenames: List<String> = [
  "v1_interpreter",
  "cli_run",
  "coproduct_reflection",
  "resolved_graph_cache",
  "shared_typecheck_store",
  "recorded_fixture",
  "module_path_index",
  "memory_governor"
]

data seed_retained_scaffold_pub_mod_basenames: List<String> = [
  "usv_pilot_v2_std_algebra",
  "usv_pilot_v2_std_collection",
  "usv_pilot_v2_std_node"
]

data seed_retained_intrinsic_stage0_files: List<String> = [
  "cli_run.rs",
  "coproduct_reflection.rs",
  "recorded_fixture.rs",
  "resolved_graph_cache.rs",
  "shared_typecheck_store.rs",
  "main.rs",
  "v1_interpreter.rs",
  "phase_profile.rs",
  "memory_governor.rs"
]

data seed_retained_scaffold_stage0_files: List<String> = [
  "usv_pilot_v2_std_algebra.rs",
  "usv_pilot_v2_std_collection.rs",
  "usv_pilot_v2_std_node.rs"
]

data hand_maintained_stage0_dirs: List<String> = ["module_path_index"]

fn basename_to_pub_mod_decl(basename: String) -> String {
  concat("pub mod ", basename, ";")
}

fn format_pub_mod_declarations(basenames: List<String>) -> String {
  let lines = basenames |> map(basename_to_pub_mod_decl)
  concat("\n", lines |> join(separator: "\n"))
}

fn basename_to_stage0_filename(basename: String) -> String {
  concat(basename, ".rs")
}

fn basenames_to_stage0_filenames(basenames: List<String>) -> List<String> {
  basenames |> map(basename_to_stage0_filename)
}

fn hand_maintained_pub_mod_basenames(self_emitted_basenames: List<String>) -> List<String> {
  concat(
    concat(seed_retained_intrinsic_pub_mod_basenames, seed_retained_scaffold_pub_mod_basenames),
    self_emitted_basenames
  )
}

fn hand_maintained_pub_mod_block(self_emitted_basenames: List<String>) -> String {
  format_pub_mod_declarations(
    basenames: hand_maintained_pub_mod_basenames(self_emitted_basenames: self_emitted_basenames)
  )
}

fn hand_maintained_stage0_filenames(self_emitted_basenames: List<String>) -> List<String> {
  concat(
    concat(seed_retained_intrinsic_stage0_files, seed_retained_scaffold_stage0_files),
    basenames_to_stage0_filenames(basenames: self_emitted_basenames)
  )
}

data stage0_self_emitted_mod_basenames_v1_projection: List<String> = [
  "v2_compiler_use_site_verdict"
]

fn stage0_self_emitted_mod_basenames_v1() -> List<String> {
  stage0_self_emitted_mod_basenames_v1_projection
}

fn emit_hand_maintained_pub_mod_block() -> String {
  hand_maintained_pub_mod_block(self_emitted_basenames: stage0_self_emitted_mod_basenames_v1())
}

fn stage0_hand_maintained_stage0_filenames_v1() -> List<String> {
  hand_maintained_stage0_filenames(self_emitted_basenames: stage0_self_emitted_mod_basenames_v1())
}
