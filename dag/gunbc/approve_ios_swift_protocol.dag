fn approve_ios_replace(e: SwiftExpr, of: String, with: String) -> SwiftExpr {
  sw_call(f: sw_mem(b: e, m: "replacingOccurrences"), a: [sw_arg(l: "of", v: sw_str(s: of)), sw_arg(l: "with", v: sw_str(s: with))])
}

data approve_ios_protocol_header: List<String> = [
  "gunbc.auth.approval_device_wire, realized in Swift. Every constant, framing rule and field order",
  "here is a transcription of that module; the .dag is the authority and this file invents nothing.",
  "The bytes the builders produce are checked against vectors the .dag witness emits (ApproveTests).",
  "The HTTP spelling of these records (JSON bodies, headers, paths) is Wire.swift.",
  "GENERATED from gunbc.approve_ios_swift_protocol by v2.extdeps.languages.swift.print; do not edit.",
]

fn approve_ios_protocol_swift_file() -> SwiftSourceFile {
  SwiftSourceFile { declarations: append([sw_cmt(c: approve_ios_protocol_header, d: sw_import(n: "Foundation")), approve_ios_protocol_enum()], items: approve_ios_protocol_carriers()) }
}

fn expected_approve_ios_protocol_swift() -> String {
  print_swift_source_file(f: approve_ios_protocol_swift_file())
}
