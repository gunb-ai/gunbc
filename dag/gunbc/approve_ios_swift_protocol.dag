// apps/approve-ios/Approve/Protocol.swift AS A SWIFT SYNTAX TREE (v2.extdeps.languages.swift.syntax),
// emitted through the Swift grammar rows (v2.extdeps.languages.swift.rows) into the committed file (gunbc.generated_artifact
// ApproveIosProtocolSwiftArtifact; the drift gate refuses a hand edit). The tree is transcribed from
// the hand-written file it replaces. The protocol constants and the suite/encoding spellings are READ from
// gunbc.auth.approval_device_wire (no restated literal); framing, field order and carriers are still transcribed
// (gunbc.approve_ios_app approve_ios_transcribed_swift_frontier).

fn approve_ios_framed_call(fields: List<SwiftExpr>) -> SwiftExpr {
  sw_call(f: sw_path(b: "Protocol", m: "framed"), a: [sw_pos(v: sw_arr(e: fields))])
}

fn approve_ios_protocol_enum() -> SwiftDecl {
  sw_enum(n: "Protocol", i: [], m: [
    sw_doc(c: ["gunbc.auth.approval_google_enrolment approval_google_enrolment_protocol."], d: sw_static_let(n: "googleEnrolmentProtocol", e: sw_str(s: approval_google_enrolment_protocol as String))),
    sw_doc(c: ["gunbc.auth.approval_device_wire approval_redemption_protocol."], d: sw_static_let(n: "redemptionProtocol", e: sw_str(s: approval_redemption_protocol as String))),
    sw_doc(c: ["gunbc.auth.approval_device_wire approval_device_read_protocol."], d: sw_static_let(n: "readProtocol", e: sw_str(s: approval_device_read_protocol as String))),
    sw_doc(c: ["gunbc.auth.approval_device_wire approval_device_push_protocol."], d: sw_static_let(n: "pushProtocol", e: sw_str(s: approval_device_push_protocol as String))),
    sw_doc(c: ["gunbc.auth.approval_device_wire approval_device_audience."], d: sw_static_let(n: "audience", e: sw_str(s: approval_device_audience as String))),
    sw_doc(
      c: [
        "framed_field: \"<n>:<field>,\" where n is the field's length in Unicode code points",
        "(string_length in .dag = String.unicodeScalars.count here), the comma part of the frame.",
      ],
      d: sw_func(m: [SwiftStaticModifier], n: "framedField", p: [sw_p_(n: "f", t: sw_t(n: "String"))], th: false, r: Present { value: sw_t(n: "String") }, b: [
        sw_expr(e: sw_interp(p: [sw_si(e: sw_mem(b: sw_path(b: "f", m: "unicodeScalars"), m: "count")), sw_st(s: ":"), sw_si(e: sw_id(n: "f")), sw_st(s: ",")])),
      ])
    ),
    sw_doc(
      c: [
        "framed: the frames concatenated with nothing between them. Injective for any field content,",
        "which a separator join is not (capability_text is itself a 0x1F join). Bytes are UTF-8.",
      ],
      d: sw_func(m: [SwiftStaticModifier], n: "framed", p: [sw_p_(n: "fields", t: sw_tarr(e: sw_t(n: "String")))], th: false, r: Present { value: sw_t(n: "Data") }, b: [
        sw_expr(e: sw_calln(f: "Data", a: [sw_pos(v: sw_mem(b: sw_call(f: sw_mem(b: sw_call(f: sw_path(b: "fields", m: "map"), a: [sw_pos(v: sw_id(n: "framedField"))]), m: "joined"), a: []), m: "utf8"))])),
      ])
    ),
  ])
}

fn approve_ios_protocol_carriers() -> List<SwiftDecl> {
  [
    sw_doc(c: ["gunbc.auth.approval_device_wire MobilePlatform, spelled by platform_wire."], d: sw_enum(n: "MobilePlatform", i: [sw_t(n: "String")], m: [sw_cases(n: ["ios", "android"])])),
    sw_doc(c: ["gunbc.auth.approval_capability ProposedDecision, spelled by proposed_decision_name."], d: sw_enum(n: "ProposedDecision", i: [sw_t(n: "String")], m: [sw_cases(n: ["approve", "deny"])])),
    sw_doc(c: ["gunbc.auth.approval_device_wire GoogleEnrolmentRefusalWire, spelled by google_enrolment_refusal_wire_label: every label the enrol route may refuse with. The app acts on none of them (any refusal leaves the phone signed out); the list is the admitted set the refusal decoder checks."], d: sw_enum(n: "GoogleEnrolmentRefusal", i: [], m: [sw_static_let(n: "labels", e: sw_arr(e: map(google_enrolment_refusal_kinds(), k => sw_str(s: google_enrolment_refusal_wire_label(k: k) as String))))])),
    SwiftCommentedDecl {
      comments: [
        SwiftDocLineComment { text: "extdeps.crypto.signature VerifyingKey. The suite and encoding travel explicitly" },
        SwiftDocLineComment { text: "(signature_suite_wire, public_key_encoding_wire) and are the enclave's only values" },
        SwiftDocLineComment { text: "(extdeps.apple.secure_enclave secure_enclave_signing_suite / secure_enclave_public_key_encoding)." },
        SwiftLineComment { text: "Codable only for the local keychain record; the wire spelling is WireEncode.verifyingKey" },
      ],
      decl: sw_struct(n: "VerifyingKey", i: [sw_t(n: "Equatable"), sw_t(n: "Codable")], m: [
        sw_static_let(n: "suite", e: sw_str(s: signature_suite_wire(s: EcdsaP256Sha256) as String)),
        sw_static_let(n: "encoding", e: sw_str(s: public_key_encoding_wire(e: Sec1Uncompressed) as String)),
        sw_field(n: "point_b64url", t: sw_t(n: "String")),
      ]),
    },
    sw_doc(
      c: [
        "extdeps.crypto.signature SignatureBytes: fixed-width r||s, 64 octets (CryptoKit rawRepresentation),",
        "with its suite and encoding explicit (signature_encoding_wire).",
      ],
      d: sw_struct(n: "SignatureBytes", i: [sw_t(n: "Equatable")], m: [
        sw_static_let(n: "suite", e: sw_str(s: signature_suite_wire(s: EcdsaP256Sha256) as String)),
        sw_static_let(n: "encoding", e: sw_str(s: signature_encoding_wire(e: P1363FixedWidth) as String)),
        sw_field(n: "b64url", t: sw_t(n: "String")),
      ])
    ),
    sw_doc(
      c: [
        "gunbc.auth.approval_google_enrolment google_enrolment_transcript = framed([protocol, platform_wire,",
        "point_b64url, attest_key_id]). Both device keys exist before it is built; the Google nonce and the",
        "App Attest clientDataHash are both derived from these bytes.",
      ],
      d: sw_func(m: [], n: "googleEnrolmentTranscript", p: [sw_p(n: "decisionKey", t: sw_t(n: "VerifyingKey")), sw_p(n: "platform", t: sw_t(n: "MobilePlatform")), sw_p(n: "attestKeyId", t: sw_t(n: "String"))], th: false, r: Present { value: sw_t(n: "Data") }, b: [
        sw_expr(e: approve_ios_framed_call(fields: [
          sw_path(b: "Protocol", m: "googleEnrolmentProtocol"),
          sw_path(b: "platform", m: "rawValue"),
          sw_path(b: "decisionKey", m: "point_b64url"),
          sw_id(n: "attestKeyId"),
        ])),
      ])
    ),
    sw_doc(
      c: [
        "gunbc.auth.approval_google_enrolment google_enrolment_nonce = base64url(sha256(transcript)): the nonce",
        "Google signs into the ID token, so the token is bound to the keys the transcript names.",
      ],
      d: sw_func(m: [], n: "googleEnrolmentNonce", p: [sw_p_(n: "transcript", t: sw_t(n: "Data"))], th: false, r: Present { value: sw_t(n: "String") }, b: [
        sw_expr(e: sw_call(f: sw_path(b: "Base64Url", m: "encode"), a: [sw_pos(v: sw_call(f: sw_id(n: "Data"), a: [sw_pos(v: sw_call(f: sw_path(b: "SHA256", m: "hash"), a: [sw_arg(l: "data", v: sw_id(n: "transcript"))]))]))])),
      ])
    ),
    sw_doc(
      c: ["gunbc.auth.tracker_web_oauth_client approve_ios_oauth_client: the iOS client the ID token's audience is. No server client id is configured, so aud is this client alone."],
      d: sw_enum(n: "GoogleClient", i: [], m: [
        sw_static_let(n: "clientID", e: sw_str(s: approve_ios_oauth_client.client_id as String)),
      ])
    ),
    sw_doc(
      c: [
        "gunbc.auth.approval_device_wire RedemptionChallenge: stateless. nonce_hex is the server's",
        "MAC over redemption_challenge_message(escalation_id, request_revision, enrollment_id, expires_at);",
        "the app carries both back untouched.",
      ],
      d: sw_struct(n: "RedemptionChallenge", i: [sw_t(n: "Equatable")], m: [
        sw_field(n: "expires_at", t: sw_t(n: "String")),
        sw_field(n: "nonce_hex", t: sw_t(n: "String")),
      ])
    ),
    sw_doc(
      c: ["gunbc.auth.approval_device_wire DeviceRedemptionSigningInput, field for field."],
      d: sw_struct(n: "DeviceRedemptionSigningInput", i: [sw_t(n: "Equatable")], m: [
        sw_field(n: "audience", t: sw_t(n: "String")),
        sw_field(n: "enrollment_id", t: sw_t(n: "String")),
        sw_field(n: "challenge", t: sw_t(n: "RedemptionChallenge")),
        sw_field(n: "escalation_id", t: sw_t(n: "String")),
        sw_field(n: "request_revision", t: sw_t(n: "String")),
        sw_doc(c: ["stored_request_json of the record displayed, byte for byte as the server returned it."], d: sw_field(n: "stored_request_text", t: sw_t(n: "String"))),
        sw_field(n: "decision", t: sw_t(n: "ProposedDecision")),
        sw_field(n: "capability_text", t: sw_t(n: "String")),
        sw_doc(c: ["The capability's canonical base64url tag exactly as issued."], d: sw_field(n: "capability_tag_b64url", t: sw_t(n: "String"))),
      ])
    ),
    sw_doc(
      c: [
        "device_redemption_signing_input = framed([...]). Order is the .dag's: the challenge contributes",
        "expires_at then nonce_hex, in that position.",
      ],
      d: sw_func(m: [], n: "deviceRedemptionSigningInput", p: [sw_p_(n: "i", t: sw_t(n: "DeviceRedemptionSigningInput"))], th: false, r: Present { value: sw_t(n: "Data") }, b: [
        sw_expr(e: approve_ios_framed_call(fields: [
          sw_path(b: "Protocol", m: "redemptionProtocol"),
          sw_path(b: "i", m: "audience"),
          sw_path(b: "i", m: "enrollment_id"),
          sw_mem(b: sw_path(b: "i", m: "challenge"), m: "expires_at"),
          sw_mem(b: sw_path(b: "i", m: "challenge"), m: "nonce_hex"),
          sw_path(b: "i", m: "escalation_id"),
          sw_path(b: "i", m: "request_revision"),
          sw_path(b: "i", m: "stored_request_text"),
          sw_mem(b: sw_path(b: "i", m: "decision"), m: "rawValue"),
          sw_path(b: "i", m: "capability_text"),
          sw_path(b: "i", m: "capability_tag_b64url"),
        ])),
      ])
    ),
    sw_doc(
      c: [
        "device_read_client_data = framed([protocol, path, enrollment_id, requested_at]): what the App",
        "Attest assertion on an authenticated GET commits to (no Face ID — reading is not deciding).",
      ],
      d: sw_func(m: [], n: "deviceReadClientData", p: [sw_p(n: "path", t: sw_t(n: "String")), sw_p(n: "enrollmentId", t: sw_t(n: "String")), sw_p(n: "requestedAt", t: sw_t(n: "String"))], th: false, r: Present { value: sw_t(n: "Data") }, b: [
        sw_expr(e: approve_ios_framed_call(fields: [sw_path(b: "Protocol", m: "readProtocol"), sw_id(n: "path"), sw_id(n: "enrollmentId"), sw_id(n: "requestedAt")])),
      ])
    ),
    sw_doc(
      c: [
        "device_push_update_client_data = framed([protocol, push path, enrollment_id, requested_at,",
        "push_update_json]): the token is inside the client data, so an assertion made for one token",
        "cannot carry another.",
      ],
      d: sw_func(m: [], n: "devicePushUpdateClientData", p: [sw_p(n: "enrollmentId", t: sw_t(n: "String")), sw_p(n: "requestedAt", t: sw_t(n: "String")), sw_p(n: "pushBodyJson", t: sw_t(n: "String"))], th: false, r: Present { value: sw_t(n: "Data") }, b: [
        sw_expr(e: approve_ios_framed_call(fields: [sw_path(b: "Protocol", m: "pushProtocol"), sw_path(b: "Route", m: "push"), sw_id(n: "enrollmentId"), sw_id(n: "requestedAt"), sw_id(n: "pushBodyJson")])),
      ])
    ),
    sw_doc(c: ["PlatformRedemptionProof, iOS arm (wire kind \"ios_app_attest_assertion\")."], d: sw_struct(n: "IosAppAttestAssertion", i: [sw_t(n: "Equatable")], m: [
      sw_field(n: "assertion_b64", t: sw_t(n: "String")),
    ])),
    sw_doc(c: ["gunbc.auth.approval_device_wire SignedRedemption: the POST /approve/device/redeem body."], d: sw_struct(n: "SignedRedemption", i: [sw_t(n: "Equatable")], m: [
      sw_field(n: "signing_input", t: sw_t(n: "DeviceRedemptionSigningInput")),
      sw_field(n: "signature", t: sw_t(n: "SignatureBytes")),
      sw_field(n: "platform_proof", t: sw_t(n: "IosAppAttestAssertion")),
    ])),
    sw_doc(c: ["PresentedEnrollmentEvidence, iOS arm: IosAppAttestAttestation (wire kind \"ios_app_attest\")."], d: sw_struct(n: "IosAppAttestBoundDecisionKey", i: [sw_t(n: "Equatable")], m: [
      sw_field(n: "attest_key_id", t: sw_t(n: "String")),
      sw_field(n: "attestation_b64", t: sw_t(n: "String")),
    ])),
    sw_doc(c: ["PushRegistration ApnsRegistration arm (wire kind \"apns\"); environment is apns_environment_wire."], d: sw_struct(n: "ApnsRegistration", i: [sw_t(n: "Equatable")], m: [
      sw_field(n: "environment", t: sw_t(n: "String")),
      sw_field(n: "topic", t: sw_t(n: "String")),
      sw_field(n: "token", t: sw_t(n: "String")),
    ])),
    sw_doc(c: ["gunbc.auth.approval_device_wire ApprovalPushHint: one opaque locator, nothing that is decided."], d: sw_struct(n: "ApprovalPushHint", i: [sw_t(n: "Equatable")], m: [
      sw_field(n: "notification_id", t: sw_t(n: "String")),
    ])),
    // base64url WITH '=' padding: the encoder of std base64_encode UrlSafe, which every .dag crossing
    // (google_enrolment_nonce, point_b64url, signatures) uses; vectors.json is emitted from it.
    sw_enum(n: "Base64Url", i: [], m: [
      sw_func(m: [SwiftStaticModifier], n: "encode", p: [sw_p_(n: "d", t: sw_t(n: "Data"))], th: false, r: Present { value: sw_t(n: "String") }, b: [
        sw_expr(e: approve_ios_replace(e: approve_ios_replace(e: sw_call(f: sw_path(b: "d", m: "base64EncodedString"), a: []), of: "+", with: "-"), of: "/", with: "_")),
      ]),
    ]),
  ]
}

fn approve_ios_replace(e: SwiftExpr, of: String, with: String) -> SwiftExpr {
  sw_call(f: sw_mem(b: e, m: "replacingOccurrences"), a: [sw_arg(l: "of", v: sw_str(s: of)), sw_arg(l: "with", v: sw_str(s: with))])
}

data approve_ios_protocol_header: List<String> = [
  "gunbc.auth.approval_device_wire, realized in Swift. Every constant, framing rule and field order",
  "here is a transcription of that module; the .dag is the authority and this file invents nothing.",
  "The bytes the builders produce are checked against vectors the .dag witness emits (ApproveTests).",
  "The HTTP spelling of these records (JSON bodies, headers, paths) is Wire.swift.",
  "GENERATED from gunbc.approve_ios_swift_protocol from the Swift grammar rows (v2.extdeps.languages.swift.rows); do not edit.",
]

fn approve_ios_protocol_swift_file() -> SwiftSourceFile {
  SwiftSourceFile { declarations: list_append(left: [sw_cmt(c: approve_ios_protocol_header, d: sw_import(n: "Foundation")), sw_import(n: "CryptoKit"), approve_ios_protocol_enum()], right: approve_ios_protocol_carriers()) }
}

fn expected_approve_ios_protocol_swift() -> SwiftRowEmission {
  swift_rows_emit_source_file(f: approve_ios_protocol_swift_file())
}
