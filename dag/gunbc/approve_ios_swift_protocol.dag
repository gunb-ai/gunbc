  sw_enum(n: "Protocol", i: [], m: [
    sw_doc(c: ["gunbc.auth.approval_device_wire approval_enrolment_protocol."], d: sw_static_let(n: "enrolmentProtocol", e: sw_str(s: "gunbc.approval-enrolment.v1"))),
    sw_doc(c: ["gunbc.auth.approval_device_wire approval_redemption_protocol."], d: sw_static_let(n: "redemptionProtocol", e: sw_str(s: "gunbc.approval-redemption.v1"))),
    sw_doc(c: ["gunbc.auth.approval_device_wire approval_device_read_protocol."], d: sw_static_let(n: "readProtocol", e: sw_str(s: "gunbc.approval-device-read.v1"))),
    sw_doc(c: ["gunbc.auth.approval_device_wire approval_device_push_protocol."], d: sw_static_let(n: "pushProtocol", e: sw_str(s: "gunbc.approval-device-push.v1"))),
    sw_doc(c: ["gunbc.auth.approval_device_wire approval_device_audience."], d: sw_static_let(n: "audience", e: sw_str(s: "gunbc.roadmap_serve/device-redemption"))),
    sw_doc(
      c: [
        "framed_field: \"<n>:<field>,\" where n is the field's length in Unicode code points",
        "(string_length in .dag = String.unicodeScalars.count here), the comma part of the frame.",
      ],
      d: sw_func(m: [SwiftStaticModifier], n: "framedField", p: [sw_p_(n: "f", t: sw_t(n: "String"))], th: false, r: Present { value: sw_t(n: "String") }, b: [
        sw_expr(e: sw_interp(p: [sw_si(e: sw_mem(b: sw_path(b: "f", m: "unicodeScalars"), m: "count")), sw_st(s: ":"), sw_si(e: sw_id(n: "f")), sw_st(s: ",")])),
      ])
    ),
    sw_doc(
      c: [
        "framed: the frames concatenated with nothing between them. Injective for any field content,",
        "which a separator join is not (capability_text is itself a 0x1F join). Bytes are UTF-8.",
      ],
      d: sw_func(m: [SwiftStaticModifier], n: "framed", p: [sw_p_(n: "fields", t: sw_tarr(e: sw_t(n: "String")))], th: false, r: Present { value: sw_t(n: "Data") }, b: [
        sw_expr(e: sw_calln(f: "Data", a: [sw_pos(v: sw_mem(b: sw_call(f: sw_mem(b: sw_call(f: sw_path(b: "fields", m: "map"), a: [sw_pos(v: sw_id(n: "framedField"))]), m: "joined"), a: []), m: "utf8"))])),
      ])
    ),
  ])
}

fn approve_ios_protocol_carriers() -> List<SwiftDecl> {
  [
    sw_doc(c: ["gunbc.auth.approval_device_wire MobilePlatform, spelled by platform_wire."], d: sw_enum(n: "MobilePlatform", i: [sw_t(n: "String")], m: [sw_cases(n: ["ios", "android"])])),
    sw_doc(c: ["gunbc.auth.approval_capability ProposedDecision, spelled by proposed_decision_name."], d: sw_enum(n: "ProposedDecision", i: [sw_t(n: "String")], m: [sw_cases(n: ["approve", "deny"])])),
    SwiftCommentedDecl {
      comments: [
        SwiftDocLineComment { text: "extdeps.crypto.signature VerifyingKey. The suite and encoding travel explicitly" },
        SwiftDocLineComment { text: "(signature_suite_wire, public_key_encoding_wire) and are the enclave's only values" },
        SwiftDocLineComment { text: "(extdeps.apple.secure_enclave secure_enclave_signing_suite / secure_enclave_public_key_encoding)." },
        SwiftLineComment { text: "Codable only for the local keychain record; the wire spelling is WireEncode.verifyingKey" },
      ],
      decl: sw_struct(n: "VerifyingKey", i: [sw_t(n: "Equatable"), sw_t(n: "Codable")], m: [
        sw_static_let(n: "suite", e: sw_str(s: "ECDSA-P256-SHA256")),
        sw_static_let(n: "encoding", e: sw_str(s: "SEC1-uncompressed")),
        sw_field(n: "point_b64url", t: sw_t(n: "String")),
      ]),
    },
    sw_doc(
      c: [
        "extdeps.crypto.signature SignatureBytes: fixed-width r||s, 64 octets (CryptoKit rawRepresentation),",
        "with its suite and encoding explicit (signature_encoding_wire).",
      ],
      d: sw_struct(n: "SignatureBytes", i: [sw_t(n: "Equatable")], m: [
        sw_static_let(n: "suite", e: sw_str(s: "ECDSA-P256-SHA256")),
        sw_static_let(n: "encoding", e: sw_str(s: "P1363-fixed-width")),
        sw_field(n: "b64url", t: sw_t(n: "String")),
      ])
    ),
    sw_doc(
      c: [
        "enrolment_transcript = framed([protocol, code, platform_wire, point_b64url]). The one-time code",
        "the operator types IS the challenge identifier; the login is NOT here — the server derives it.",
      ],
      d: sw_func(m: [], n: "enrolmentTranscript", p: [sw_p(n: "code", t: sw_t(n: "String")), sw_p(n: "decisionKey", t: sw_t(n: "VerifyingKey")), sw_p(n: "platform", t: sw_t(n: "MobilePlatform"))], th: false, r: Present { value: sw_t(n: "Data") }, b: [
        sw_expr(e: approve_ios_framed_call(fields: [
