      ])
    ),
    sw_doc(
      c: [
        "gunbc.auth.approval_device_wire enrollment_id_for_code: the enrolment an accepted code produces is",
        "named by the code, so a lost enrolment answer costs nothing the app cannot re-derive.",
      ],
      d: sw_func(m: [], n: "enrollmentIdForCode", p: [sw_p_(n: "code", t: sw_t(n: "String"))], th: false, r: Present { value: sw_t(n: "String") }, b: [
        sw_expr(e: sw_add(l: sw_str(s: "enr-"), r: sw_id(n: "code"))),
      ])
    ),
    sw_doc(
      c: [
        "gunbc.auth.approval_device_wire RedemptionChallenge: stateless. nonce_hex is the server's",
        "MAC over redemption_challenge_message(escalation_id, request_revision, enrollment_id, expires_at);",
        "the app carries both back untouched.",
      ],
      d: sw_struct(n: "RedemptionChallenge", i: [sw_t(n: "Equatable")], m: [
        sw_field(n: "expires_at", t: sw_t(n: "String")),
        sw_field(n: "nonce_hex", t: sw_t(n: "String")),
      ])
    ),
    sw_doc(
      c: ["gunbc.auth.approval_device_wire DeviceRedemptionSigningInput, field for field."],
      d: sw_struct(n: "DeviceRedemptionSigningInput", i: [sw_t(n: "Equatable")], m: [
        sw_field(n: "audience", t: sw_t(n: "String")),
        sw_field(n: "enrollment_id", t: sw_t(n: "String")),
        sw_field(n: "challenge", t: sw_t(n: "RedemptionChallenge")),
        sw_field(n: "escalation_id", t: sw_t(n: "String")),
        sw_field(n: "request_revision", t: sw_t(n: "String")),
        sw_doc(c: ["stored_request_json of the record displayed, byte for byte as the server returned it."], d: sw_field(n: "stored_request_text", t: sw_t(n: "String"))),
        sw_field(n: "decision", t: sw_t(n: "ProposedDecision")),
        sw_field(n: "capability_text", t: sw_t(n: "String")),
        sw_doc(c: ["The capability's canonical base64url tag exactly as issued."], d: sw_field(n: "capability_tag_b64url", t: sw_t(n: "String"))),
      ])
    ),
    sw_doc(
      c: [
        "device_redemption_signing_input = framed([...]). Order is the .dag's: the challenge contributes",
        "expires_at then nonce_hex, in that position.",
      ],
      d: sw_func(m: [], n: "deviceRedemptionSigningInput", p: [sw_p_(n: "i", t: sw_t(n: "DeviceRedemptionSigningInput"))], th: false, r: Present { value: sw_t(n: "Data") }, b: [
        sw_expr(e: approve_ios_framed_call(fields: [
          sw_path(b: "Protocol", m: "redemptionProtocol"),
          sw_path(b: "i", m: "audience"),
          sw_path(b: "i", m: "enrollment_id"),
          sw_mem(b: sw_path(b: "i", m: "challenge"), m: "expires_at"),
          sw_mem(b: sw_path(b: "i", m: "challenge"), m: "nonce_hex"),
          sw_path(b: "i", m: "escalation_id"),
          sw_path(b: "i", m: "request_revision"),
          sw_path(b: "i", m: "stored_request_text"),
          sw_mem(b: sw_path(b: "i", m: "decision"), m: "rawValue"),
          sw_path(b: "i", m: "capability_text"),
          sw_path(b: "i", m: "capability_tag_b64url"),
        ])),
      ])
    ),
    sw_doc(
      c: [
        "device_read_client_data = framed([protocol, path, enrollment_id, requested_at]): what the App",
        "Attest assertion on an authenticated GET commits to (no Face ID — reading is not deciding).",
      ],
      d: sw_func(m: [], n: "deviceReadClientData", p: [sw_p(n: "path", t: sw_t(n: "String")), sw_p(n: "enrollmentId", t: sw_t(n: "String")), sw_p(n: "requestedAt", t: sw_t(n: "String"))], th: false, r: Present { value: sw_t(n: "Data") }, b: [
        sw_expr(e: approve_ios_framed_call(fields: [sw_path(b: "Protocol", m: "readProtocol"), sw_id(n: "path"), sw_id(n: "enrollmentId"), sw_id(n: "requestedAt")])),
      ])
    ),
    sw_doc(
      c: [
        "device_push_update_client_data = framed([protocol, push path, enrollment_id, requested_at,",
        "push_update_json]): the token is inside the client data, so an assertion made for one token",
        "cannot carry another.",
      ],
      d: sw_func(m: [], n: "devicePushUpdateClientData", p: [sw_p(n: "enrollmentId", t: sw_t(n: "String")), sw_p(n: "requestedAt", t: sw_t(n: "String")), sw_p(n: "pushBodyJson", t: sw_t(n: "String"))], th: false, r: Present { value: sw_t(n: "Data") }, b: [
        sw_expr(e: approve_ios_framed_call(fields: [sw_path(b: "Protocol", m: "pushProtocol"), sw_path(b: "Route", m: "push"), sw_id(n: "enrollmentId"), sw_id(n: "requestedAt"), sw_id(n: "pushBodyJson")])),
      ])
    ),
    sw_doc(c: ["PlatformRedemptionProof, iOS arm (wire kind \"ios_app_attest_assertion\")."], d: sw_struct(n: "IosAppAttestAssertion", i: [sw_t(n: "Equatable")], m: [
      sw_field(n: "assertion_b64", t: sw_t(n: "String")),
    ])),
    sw_doc(c: ["gunbc.auth.approval_device_wire SignedRedemption: the POST /approve/device/redeem body."], d: sw_struct(n: "SignedRedemption", i: [sw_t(n: "Equatable")], m: [
      sw_field(n: "signing_input", t: sw_t(n: "DeviceRedemptionSigningInput")),
      sw_field(n: "signature", t: sw_t(n: "SignatureBytes")),
      sw_field(n: "platform_proof", t: sw_t(n: "IosAppAttestAssertion")),
    ])),
    sw_doc(c: ["PresentedEnrollmentEvidence, iOS arm: IosAppAttestAttestation (wire kind \"ios_app_attest\")."], d: sw_struct(n: "IosAppAttestBoundDecisionKey", i: [sw_t(n: "Equatable")], m: [
      sw_field(n: "attest_key_id", t: sw_t(n: "String")),
      sw_field(n: "attestation_b64", t: sw_t(n: "String")),
    ])),
    sw_doc(c: ["PushRegistration ApnsRegistration arm (wire kind \"apns\"); environment is apns_environment_wire."], d: sw_struct(n: "ApnsRegistration", i: [sw_t(n: "Equatable")], m: [
      sw_field(n: "environment", t: sw_t(n: "String")),
