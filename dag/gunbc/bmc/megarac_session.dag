module gunbc.bmc.megarac_session

import std.types { Bool, FilePath, NonEmptyStr, String }
import extdeps.languages.json.parse {
  JsonDocumentParsed,
  JsonDocumentUnreadable,
  JsonValue,
  parse_json_document,
}
import gunbc.bmc.megarac_http_realization {
  MegaRacJarBearer,
  MegaRacJarEmpty,
  MegaRacJarHoldsBearer,
  MegaRacJarUnreadable,
  MegaRacScratchStaged,
  MegaRacScratchStaging,
  MegaRacScratchStagingFailed,
  json_number_member,
  json_string_member,
  megarac_discard_credential,
  megarac_discard_scratch,
  megarac_jar_bearer,
  megarac_stage_scratch,
}

// THE SESSION LIFETIME, AS A FOLD OVER THE REALIZATION BELOW IT. Acquisition, use and teardown are
// this module's subject; how a request is actually issued is gunbc.bmc.megarac_http_realization's,
// and what one controller build was measured doing is gunbc.bmc.megarac_observed_behavior's. Those
// three were one file in extdeps, which is how single-build tactics came to be advertised as
// family-grain firmware semantics.
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// THE SESSION, AS A SCOPE RATHER THAN THREE LOOSE STRINGS
// ─────────────────────────────────────────────────────────────────────────────────────────────────

// A SESSION IS A RESOURCE WITH A LIFETIME, and the first modeled caller of this API treated it as a
// bag of parameters — a host, a jar path and a token passed separately to every operation. That
// shape has no place to put acquisition or release, so both ended up as the caller's problem, and
// the caller got them wrong in the specific way this section exists to prevent: a login that
// SUCCEEDED and then failed to yield a readable CSRF token returned an outcome named
// "release not attempted", which asserts no session exists while one is open on the controller.
// The session table is finite and this lane has already exhausted one service's share of it.
//
// SO THE SCOPE IS THE UNIT, NOT THE TOKEN. Everything an acquisition creates — the scratch
// directory holding the credential, the cookie jar that is the actual bearer, the host it was
// obtained against — is carried in one value that release consumes. There is no arm of acquisition
// that creates state and returns a value which cannot release it.
type MegaRacSessionScope sole_constructor {
  bmc_host: NonEmptyStr
  scratch_dir: NonEmptyStr
  cookie_jar: NonEmptyStr
}

type MegaRacSession sole_constructor {
  scope: MegaRacSessionScope
  csrf_token: NonEmptyStr
}

// MegaRacSessionAllocationEffectUnresolved IS TERMINAL AND CANNOT BECOME A CONFIRMED RELEASE, which
// is the whole reason it is a separate arm rather than a flavour of unusable.
//
// THE UNSOUNDNESS IT REPLACES: if the controller allocated a session and the reply carrying
// Set-Cookie was lost, the local jar holds no bearer. A teardown issued with that jar cannot name
// the session, and the follow-up probe answers "unauthenticated" -- which the release decoder would
// read as a confirmed release. That is a confirmation about the JAR being reported as a fact about
// the CONTROLLER. The probe proves only that this jar does not authenticate; it says nothing about
// whether an orphan session exists.
//
// SO THERE IS NO LOCAL EVIDENCE THAT CAN DISCHARGE IT. It is discharged by a server-side session
// census or termination facility, or by an explicitly modeled expiry policy for this build -- and
// this lane has neither. Carrying it as its own terminal standing keeps the possible orphan
// countable instead of laundering it into a clean run.
//
// MegaRacSessionUnusable CARRIES THE SCOPE, and that is the whole point of its existence. It is the
// login-succeeded-token-unreadable case, which is a session that exists and cannot be used — so it
// must still be released, and it can be: the release measurement below shows teardown does not
// require the token. Modelling it as a plain refusal would drop the jar on the floor.
type MegaRacSessionAcquisition
  = MegaRacSessionAcquired { session: MegaRacSession }
  | MegaRacSessionDenied { detail: String }
  | MegaRacSessionUnusable { scope: MegaRacSessionScope, detail: String }
  | MegaRacSessionStagingFailed { detail: String }
  | MegaRacSessionAllocationEffectUnresolved {
      attempted_endpoint: NonEmptyStr
      scratch_dir: NonEmptyStr
      detail: String
    }

// THE RELEASE OUTCOME IS DECIDED BY A PROBE, NEVER BY THE DELETE'S STATUS, and that is a measured
// requirement rather than belt-and-braces. Controlled runs against this controller on 2026-09-06,
// each with a positive control confirming the session answered 200 before teardown:
//
//   DELETE carrying the CSRF header   -> HTTP 200, session subsequently 401  (released)
//   DELETE with no CSRF header        -> HTTP 401, session subsequently 401  (RELEASED ANYWAY)
//
// The second row is the finding. A 401 on the teardown request accompanied a teardown that took
// effect, which is the same status-is-not-outcome behaviour this firmware already shows on writes,
// now confirmed for session lifetime. Keying release on the DELETE's exit would have reported a leak
// that did not happen — and, worse, would have taught a caller to retry a teardown that had already
// succeeded.
//
// IT ALSO SETTLES WHETHER THE UNUSABLE ARM CAN CLEAN UP: the no-CSRF row released, so a session
// whose token could not be read is recoverable rather than a permanent leak.
//
// MegaRacSessionStillLive IS THE LOUD ONE. It means the probe authenticated AFTER teardown, so a
// session really is stranded on the controller. That is the state the finite session table cares
// about, and it is reported as its own arm rather than folded into an unverified outcome, because
// the two license opposite actions: one is "look at the controller", the other is "look at the
// probe".
type MegaRacSessionRelease
  = MegaRacSessionReleaseConfirmed
  | MegaRacSessionStillLive { scope: MegaRacSessionScope, detail: String }
  | MegaRacSessionReleaseUnverifiable { scope: MegaRacSessionScope, detail: String }
  | MegaRacSessionNeverOpened

// THE SCRATCH DIRECTORY IS NOT ALWAYS DISCARDED, and treating it as unconditional cleanup destroyed
// the only thing that could fix a leak. That directory holds the COOKIE JAR, which is the bearer.
// When the probe says a session is still live, removing the jar removes the sole credential capable
// of issuing another authenticated teardown -- so the previous version reliably converted a
// recoverable leak into a permanent one, at exactly the moment it had detected the leak. When the
// probe is unverifiable it destroys the evidence needed to resolve the uncertainty instead.
//
// SO ONLY A CONFIRMED RELEASE LICENSES THE DELETE. Retention is a reported outcome rather than a
// silent omission, because a retained scratch directory holds a live bearer on local disk and
// someone has to know to come back for it.
type MegaRacScratchCleanup
  = MegaRacScratchDiscarded
  | MegaRacScratchRetained { scratch_dir: NonEmptyStr, reason: String }
  | MegaRacScratchDiscardFailed { scratch_dir: NonEmptyStr }

// TEARDOWN IS A PRODUCT, NOT A SUM, because the remote session and the local scratch are independent
// facts and every caller needs both. The previous renderer examined the release standing only when
// the attach had succeeded, so on any attach refusal the stranded-session signal was dropped -- the
// exact resource-accounting loss this abstraction exists to prevent, reintroduced one layer up.
type MegaRacSessionTeardown {
  standing: MegaRacSessionRelease
  cleanup: MegaRacScratchCleanup
}

// THE CLASSIFICATION IS SEPARATE FROM THE EFFECT so the three outcomes can be reasoned about
// without a controller. The distinction that matters is between DENIED and UNUSABLE: denied means
// no session was created and there is nothing to release, unusable means one was created and its
// token could not be read. Collapsing them is precisely the defect this replaces — the earlier form
// reported the second as "release not attempted", a phrase that reads as "nothing to clean up".
// THE JAR IS CONSULTED BEFORE THE BODY, because whether a bearer was received decides which
// failures are recoverable. An acquisition holding a bearer can always tear down; one holding none
// cannot, no matter what the body said.
fn megarac_classify_acquisition(
  scope: MegaRacSessionScope,
  bearer: MegaRacJarBearer,
  body: String,
  reached: Bool,
) -> MegaRacSessionAcquisition {
  match bearer {
    MegaRacJarUnreadable { detail: d } =>
      MegaRacSessionAllocationEffectUnresolved {
        attempted_endpoint: scope.bmc_host,
        scratch_dir: scope.scratch_dir,
        detail: concat("the cookie jar could not be read, so whether a bearer was received is unknown and no local observation can settle whether the controller allocated a session: ", d),
      }
    MegaRacJarEmpty =>
      megarac_classify_bearerless(scope: scope, body: body, reached: reached)
    MegaRacJarHoldsBearer =>
      megarac_classify_with_bearer(scope: scope, body: body, reached: reached)
  }
}

// NO BEARER MEANS NO LOCAL EVIDENCE ABOUT THE CONTROLLER, with exactly one exception: a clean,
// exactly-shaped denial. A controller that answered "Could not login" and issued no cookie has told
// us it allocated nothing, and that is the only body permitted to reach the denied arm. Every other
// bearerless outcome -- a transport that did not complete, an unparseable body, a success-shaped
// reply whose cookie never arrived -- leaves allocation genuinely unresolved.
fn megarac_classify_bearerless(
  scope: MegaRacSessionScope,
  body: String,
  reached: Bool,
) -> MegaRacSessionAcquisition {
  if reached == false {
    MegaRacSessionAllocationEffectUnresolved {
      attempted_endpoint: scope.bmc_host,
      scratch_dir: scope.scratch_dir,
      detail: "the session request did not complete and no bearer was received; the controller may still have allocated a session, and nothing observable from here can decide it",
    }
  } else {
    match parse_json_document(s: body) {
      JsonDocumentUnreadable { gap: _ } =>
        MegaRacSessionAllocationEffectUnresolved {
          attempted_endpoint: scope.bmc_host,
          scratch_dir: scope.scratch_dir,
          detail: concat("no bearer was received and the response was not JSON, so whether a session was allocated is unknown: ", body),
        }
      JsonDocumentParsed { value: doc } =>
        if megarac_denial_shape(doc: doc) {
          MegaRacSessionDenied { detail: megarac_denial_message(doc: doc) }
        } else {
          MegaRacSessionAllocationEffectUnresolved {
            attempted_endpoint: scope.bmc_host,
            scratch_dir: scope.scratch_dir,
            detail: concat("no bearer was received and the response is not the exact denial shape, so it cannot be read as proof that nothing was allocated: ", body),
          }
        }
    }
  }
}

// THE DENIAL SHAPE IS EXACT, for the same reason the release shape is. The previous form treated any
// response carrying any string-valued error as a denial, dropped the scope and deleted the scratch
// -- so an error accompanying an allocated session would have been discarded along with its bearer.
fn megarac_denial_shape(doc: JsonValue) -> Bool {
  let has_error = match json_string_member(doc: doc, key: "error") {
    Absent => false
    Present { value: _ } => true
  }
  let has_token = match json_string_member(doc: doc, key: "CSRFToken") {
    Absent => false
    Present { value: _ } => true
  }
  has_error && (has_token == false)
}

fn megarac_denial_message(doc: JsonValue) -> String {
  match json_string_member(doc: doc, key: "error") {
    Absent => "the controller denied the login"
    Present { value: e } => e
  }
}

// A BEARER IS IN HAND, so every failure below is recoverable: teardown can name the session even
// when the body could not be read. The distinction that matters here is between DENIED and
// UNUSABLE -- denied means nothing was created, unusable means something was and cannot be used.
// Collapsing them is the defect this replaces: the earlier form reported the second as "release not
// attempted", a phrase that reads as "nothing to clean up".
fn megarac_classify_with_bearer(
  scope: MegaRacSessionScope,
  body: String,
  reached: Bool,
) -> MegaRacSessionAcquisition {
  if reached == false {
    MegaRacSessionUnusable { scope: scope, detail: "the session request did not complete, but a bearer was received, so a session exists and can be torn down" }
  } else {
    match parse_json_document(s: body) {
      JsonDocumentUnreadable { gap: _ } =>
        MegaRacSessionUnusable { scope: scope, detail: concat("the session response was not JSON: ", body) }
      JsonDocumentParsed { value: doc } =>
        match json_string_member(doc: doc, key: "CSRFToken") {
          Present { value: token } =>
            if token.length() == 0 {
              MegaRacSessionUnusable { scope: scope, detail: "the session response carried an empty CSRFToken" }
            } else {
              MegaRacSessionAcquired {
                session: MegaRacSession { scope: scope, csrf_token: token as NonEmptyStr },
              }
            }
          Absent =>
            MegaRacSessionUnusable { scope: scope, detail: concat("a bearer was issued but the response carried no CSRFToken, so the session exists and cannot be used: ", body) }
        }
    }
  }
}

// THE CONFIRMED SHAPE IS EXACT, and accepting any error field was an absorbing arm pointed at the
// leak this probe exists to find. The measured unauthenticated response is
// { "cc": 7, "error": "Invalid Authentication" } -- so a 500 answering { "error": "internal
// failure" } previously read as a confirmed logout, and a contradictory body carrying both an error
// and authenticated fields took the confirmed arm because the error test ran first. Confirmation now
// requires the exact code, the exact message, AND the absence of an authenticated marker;
// everything else is unverifiable, which is the arm that keeps a possible leak visible.
fn megarac_release_confirmed_shape(doc: JsonValue) -> Bool {
  let code_ok = match json_number_member(doc: doc, key: "cc") {
    Absent => false
    Present { value: c } => c == "7"
  }
  let message_ok = match json_string_member(doc: doc, key: "error") {
    Absent => false
    Present { value: e } => e == "Invalid Authentication"
  }
  let authenticated_marker = match json_number_member(doc: doc, key: "id") {
    Absent => false
    Present { value: _ } => true
  }
  code_ok && message_ok && (authenticated_marker == false)
}

// AN UNREACHED PROBE IS UNVERIFIABLE, NOT RELEASED. The probe is the only thing that decides this
// outcome, so a probe that did not happen decides nothing -- reporting release on a failed probe
// would make a network partition look like successful cleanup, which is the absorbing arm that
// destroys the signal the finite session table depends on.
fn megarac_classify_release(scope: MegaRacSessionScope, body: String, reached: Bool) -> MegaRacSessionRelease {
  if reached == false {
    MegaRacSessionReleaseUnverifiable { scope: scope, detail: "the validity probe did not complete, so whether the session was released is unknown" }
  } else {
    match parse_json_document(s: body) {
      JsonDocumentUnreadable { gap: _ } =>
        MegaRacSessionReleaseUnverifiable { scope: scope, detail: concat("the validity probe returned a body that is not JSON: ", body) }
      JsonDocumentParsed { value: doc } =>
        if megarac_release_confirmed_shape(doc: doc) {
          MegaRacSessionReleaseConfirmed
        } else {
          match json_number_member(doc: doc, key: "id") {
            Present { value: _ } =>
              MegaRacSessionStillLive { scope: scope, detail: "the cookie still authenticates after teardown; a session is stranded on the controller and the jar is RETAINED so it can be torn down again" }
            Absent =>
              MegaRacSessionReleaseUnverifiable { scope: scope, detail: concat("the validity probe returned a body matching neither the exact unauthenticated shape nor the authenticated one: ", body) }
          }
        }
    }
  }
}

// RELEASE TEARS DOWN, VERIFIES, AND ONLY THEN DECIDES WHETHER IT MAY DISCARD. The probe runs before
// any removal because the jar is the probe's input: deleting it first leaves the verification unable
// to run, which is how a cleanup step destroys its own evidence.
func megarac_release_session(scope: MegaRacSessionScope) -> MegaRacSessionTeardown
  uses net: std.resources.Network
{
  closed = megarac.Session.Close(bmc_host: scope.bmc_host, cookie_jar: scope.cookie_jar)

  probed = megarac.Session.Probe(bmc_host: scope.bmc_host, cookie_jar: scope.cookie_jar)
  let standing = megarac_classify_release(scope: scope, body: probed.body, reached: probed.success)

  return match standing {
    MegaRacSessionReleaseConfirmed =>
      MegaRacSessionTeardown { standing: standing, cleanup: megarac_discard_scratch(scratch_dir: scope.scratch_dir) }
    MegaRacSessionNeverOpened =>
      MegaRacSessionTeardown { standing: standing, cleanup: megarac_discard_scratch(scratch_dir: scope.scratch_dir) }
    MegaRacSessionStillLive { scope: _, detail: _ } =>
      MegaRacSessionTeardown {
        standing: standing,
        cleanup: MegaRacScratchRetained { scratch_dir: scope.scratch_dir, reason: "the session is still live and this directory holds the only bearer that can tear it down" },
      }
    MegaRacSessionReleaseUnverifiable { scope: _, detail: _ } =>
      MegaRacSessionTeardown {
        standing: standing,
        cleanup: MegaRacScratchRetained { scratch_dir: scope.scratch_dir, reason: "whether the session was released is unknown, and this directory holds the bearer needed to find out" },
      }
  }
}


// THE ACQUISITION IS NOW A FOLD OVER STAGED SCRATCH rather than the thing that makes it. The
// credential is discarded as soon as the login has been issued: nothing after Open needs the
// password, so holding it for the attach's lifetime widened its exposure for no purpose.
func megarac_acquire_session(
  bmc_host: NonEmptyStr,
  username: NonEmptyStr,
  password: NonEmptyStr,
) -> MegaRacSessionAcquisition
  uses net: std.resources.Network
{
  return match megarac_stage_scratch(password: password) {
    MegaRacScratchStagingFailed { detail: d } => MegaRacSessionStagingFailed { detail: d }
    MegaRacScratchStaged { scratch_dir: dir, credential_path: cred, cookie_jar: jar } =>
      megarac_open_over_staged_scratch(
        bmc_host: bmc_host,
        username: username,
        credential_path: cred,
        scope: MegaRacSessionScope { bmc_host: bmc_host, scratch_dir: dir, cookie_jar: jar },
      )
  }
}

func megarac_open_over_staged_scratch(
  bmc_host: NonEmptyStr,
  username: NonEmptyStr,
  credential_path: NonEmptyStr,
  scope: MegaRacSessionScope,
) -> MegaRacSessionAcquisition
  uses net: std.resources.Network
{
  opened = megarac.Session.Open(
    bmc_host: bmc_host,
    username: username,
    password_file: credential_path,
    cookie_jar: scope.cookie_jar,
  )
  let credential_gone = megarac_discard_credential(credential_path: credential_path)
  let bearer = megarac_jar_bearer(cookie_jar: scope.cookie_jar)
  let classified = megarac_classify_acquisition(scope: scope, bearer: bearer, body: opened.body, reached: opened.success)
  return megarac_discard_scratch_when_terminal(acquisition: classified, scratch_dir: scope.scratch_dir)
}

// AN ARM THAT WILL NEVER BE RELEASED CLEANS UP HERE, because nothing else can. Teardown owns the
// scratch directory for every arm that hands one out, but MegaRacSessionDenied deliberately carries
// no scope -- there is no controller session to tear down -- and the first version of this fold
// returned it with the staged credential still on disk. Measured: a wrong-password run left
// /tmp/tmp.XXXX/credential in place, correctly 0600 and indefinitely.
func megarac_discard_scratch_when_terminal(
  acquisition: MegaRacSessionAcquisition,
  scratch_dir: NonEmptyStr,
) -> MegaRacSessionAcquisition
  uses net: std.resources.Network
{
  match acquisition {
    MegaRacSessionDenied { detail: _ } => {
      discarded = megarac_discard_scratch(scratch_dir: scratch_dir)
      return acquisition
    }
    MegaRacSessionAllocationEffectUnresolved { attempted_endpoint: _, scratch_dir: _, detail: _ } =>
      return acquisition
    _ => return acquisition
  }
}
