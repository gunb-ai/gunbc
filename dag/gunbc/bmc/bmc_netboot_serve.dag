type BmcNetbootServePlan {
  bmc_host: NonEmptyStr
  serve_port: Port
  netboot_dir: NonEmptyStr
  boot_interface: NonEmptyStr
  // THE HOST THIS EDGE INSTALLS. The plan's subject is a typed fact, not an inference: the BMC at
  // bmc_host is the management interface OF this host, and the netboot client the served seed is
  // keyed on is THIS host's boot NIC (gunbc.host.host_network_diagnosis.boot_nic_of), never "the
  // interface that happens to be measured nearby". A plan whose subject has no boot-NIC row cannot
  // name its client and refuses before staging anything.
  subject_host: HostIdentity
  bulk_iso_url: Uri
  autoinstall: UbuntuAutoinstallPayload
}

data srv4_bmc_netboot_serve_plan: BmcNetbootServePlan = BmcNetbootServePlan {
  bmc_host: "192.168.1.195",
  serve_port: 8080,
  netboot_dir: "/tmp/netboot",
  boot_interface: "eth2",
  // The typed statement of what this edge is for: 192.168.1.195 is srv4's BMC
  // (gunbc.fleet.fleet_intent_network srv4_bmc_endpoint, subject EndpointHost srv4), so the host
  // this serve plan installs is srv4, and its client MAC is srv4's boot NIC from the inventory —
  // derived from the plan's subject, not hard-wired to srv4's interface row.
  subject_host: operator_host_srv4,
  bulk_iso_url: Uri {
    scheme: Https,
    locator: "cdimage.ubuntu.com/ubuntu/releases/24.04/release/ubuntu-24.04.3-live-server-arm64.iso",
  },
  autoinstall: srv4_ubuntu_autoinstall_on_iso,
}

fn bmc_netboot_host_port(plan: BmcNetbootServePlan) -> NonEmptyStr {
  join([plan.bmc_host as String, ":", to_string(plan.serve_port)], "") as NonEmptyStr
}

fn bmc_netboot_uri(plan: BmcNetbootServePlan, path: NonEmptyStr) -> Uri {
  Uri {
    scheme: Http,
    locator: join([bmc_netboot_host_port(plan: plan) as String, path as String], "") as NonEmptyStr,
  }
}

// The seed's ds= argument through the one NoCloud token builder (extdeps.os.ubuntu_autoinstall).
fn bmc_netboot_seed_kernel_arg(plan: BmcNetbootServePlan) -> KernelCmdlineArg {
  nocloud_seedfrom_kernel_arg(datasource: "nocloud-net", seedfrom: uri_wire(uri: bmc_netboot_uri(plan: plan, path: "/nocloud/")) as String)
}

fn bmc_netboot_kernel_cmdline(plan: BmcNetbootServePlan) -> List<KernelCmdlineArg> {
  [
    KernelKeyValue { key: "ip", value: "dhcp" },
    KernelKeyValue { key: "url", value: uri_wire(uri: plan.bulk_iso_url) },
    KernelFlag { name: "autoinstall" },
    bmc_netboot_seed_kernel_arg(plan: plan),
    KernelFlag { name: "---" },
  ]
}

fn bmc_netboot_grub_config(plan: BmcNetbootServePlan) -> GrubConfig {
  GrubConfig {
    timeout_seconds: 1,
    default_entry: 0,
    entries: [
      GrubMenuEntry {
        title: "gunbc netboot install",
        linux_image: "/vmlinuz",
        linux_cmdline: bmc_netboot_kernel_cmdline(plan: plan),
        initrd_image: "/initrd",
      },
    ],
  }
}

fn bmc_netboot_grub_cfg_text(plan: BmcNetbootServePlan) -> String {
  grub_config_render(cfg: bmc_netboot_grub_config(plan: plan))
}

fn bmc_netboot_http_boot_entry(plan: BmcNetbootServePlan) -> UefiHttpBootEntry {
  UefiHttpBootEntry {
    description: "gunbc-bmc-netboot",
    boot_file_uri: bmc_netboot_uri(plan: plan, path: "/grubaa64.efi"),
    interface_name: plan.boot_interface,
  }
}

// THE SERVED SEED IS THE ADMITTED PUBLIC SEED, NOT A RENDERING. This payload leaves the repository
// over a network — httpd at the plan's BMC edge serves the volume to whatever NIC netboots — so the
// document that reaches it must be the one the fleet's public-seed contract signs: the same
// admit_public_nocloud_seed that governs a site PXE edge binding, over the SAME document tree the
// emitter renders (autoinstall_user_data_document; never a re-parse of rendered text). Nothing
// that does not pass is staged, and this module renders no seed of its own any more: the admitted
// seed's user_data and meta_data bytes are what the staged puts carry. An identity section (a
// password or not), an allow-pw that is not false, or a non-canonical key refuses by name here
// (dashboard node adhoc-dfa3a487; the finding came from #15136's public-seed audit).
//
// THE CLIENT MAC IS THE PLAN'S SUBJECT HOST'S BOOT NIC. The instance-id rule this module defers to
// derives the field from the netbooting client's MAC, so the plan carries a SUBJECT (subject_host)
// and the MAC comes from gunbc.host.host_network_diagnosis.boot_nic_of(subject) — the inventory
// that answers "which NIC does THIS host PXE from" with the row that measured it. That is a
// derivation from the plan's own subject, not a hard-wire to any one host's interface row: a plan
// whose subject has no boot-NIC assignment cannot name its client, and refuses below before any op
// is prepared (a borrowed MAC would mint an instance-id for the wrong machine, which is exactly
// what the contract's MAC-derived instance-id exists to prevent). The parse can still fail — the
// row's mac is a NonEmptyStr whose bytes upstream chose — and that refusal says so too.
// The client-MAC verdict, in this module's own vocabulary (§5: a typed, located refusal): either
// the plan's subject names a measured boot NIC whose bytes parse, or a reason that names the host
// and the missing/bad row.
type NetbootClientMacVerdict
  = ClientMacNamed { mac: Eui48Address }
  | ClientMacUnnameable { reason: NonEmptyStr }

fn seed_client_mac_verdict(plan: BmcNetbootServePlan) -> NetbootClientMacVerdict {
  match boot_nic_of(host: plan.subject_host) {
    Absent => ClientMacUnnameable {
      reason: join(
        [
          "bmc-netboot cannot name its netboot client: ",
          plan.subject_host as String,
          " has no boot-NIC assignment in gunbc.host.host_network_diagnosis.boot_nic_inventory",
        ],
        "",
      ) as NonEmptyStr,
    }
    Present { value: nic } =>
      match parse_mac_address(text: nic.mac as String) {
        MacParseFailed { error: _ } => ClientMacUnnameable {
          reason: join(
            [
              "bmc-netboot cannot name its netboot client: ",
              plan.subject_host as String,
              " boot NIC ",
              nic.name as String,
              " has a mac that does not parse",
            ],
            "",
          ) as NonEmptyStr,
        }
        MacParsed { address: client_mac } => ClientMacNamed { mac: client_mac }
      }
  }
}

fn bmc_netboot_user_seed_admission(plan: BmcNetbootServePlan) -> PublicSeedAdmission {
  match seed_client_mac_verdict(plan: plan) {
    ClientMacUnnameable { reason: why } => PublicSeedRefused {
      findings: FreeSemigroup {
        head: SeedRenderRefused { document: SeedUserData, reason: why },
        tail: [],
      },
    }
    ClientMacNamed { mac: client_mac } => admit_public_nocloud_seed(
      client_mac: client_mac,
      user_data: autoinstall_user_data_document(payload: plan.autoinstall),
    )
  }
}

// The BMC fleet this module targets ships OpenBMC/Dropbear (gunbc.remote_shell_command
// openbmc_dropbear_interpretation_note), so the interpretation is a determined fact of THIS
// deployment, not Unknown -- named explicitly on SshExec rather than left for
// command_over_transport to guess (DESIGN 5).

fn bmc_transport(plan: BmcNetbootServePlan) -> CommandTransport {
  SshExec {
    ssh_target: join(["root@", plan.bmc_host as String], "") as NonEmptyStr,
    interpretation: openbmc_dropbear_interpretation,
  }
}

fn bmc_ssh_target(plan: BmcNetbootServePlan) -> NonEmptyStr {
  join(["root@", plan.bmc_host as String], "") as NonEmptyStr
}

data bmc_netboot_bootstrap_artifact_dir: NonEmptyStr = "/var/lib/gunbc/artifacts/netboot"

fn bmc_netboot_artifact(name: NonEmptyStr) -> NonEmptyStr {
  join([bmc_netboot_bootstrap_artifact_dir as String, "/", name as String], "") as NonEmptyStr
}

fn bmc_netboot_staged_path(plan: BmcNetbootServePlan, name: NonEmptyStr) -> NonEmptyStr {
  join([plan.netboot_dir as String, "/", name as String], "") as NonEmptyStr
}

// ---- THE SEMANTIC OPERATIONS (the shell-typed-invocation shape, applied to this lane) ----

// The BMC netboot provision is described as WHAT IT DOES TO THE TARGET, not as the commands that
// do it: make a directory under the serve root, put a file there (from a local artifact, from
// text rendered from a typed payload, or -- not realizable here -- from a uri), launch the serve.
// Each put carries a NAME relative to the plan's own netboot_dir -- never a hand-spelled absolute
// path -- so where the file lands is DERIVED from the plan at staging, exactly as the configfs
// staging derives both link endpoints from the gadget's own record. The serve launch carries NO
// fields at all: everything it needs (document root, port, the busybox binary the put ops stage)
// is the plan's own record, so an op that serves from somewhere else or on another port is not
// authorable. The three put arms are the SOURCES, split at the op rather than carried in a
// sub-sum: preparation narrows them, so a source this lane has not realized (PutFromUri) is not
// representable in a prepared operation at all, and the realization match has no dead arm.
type BmcNetbootOp
  = BmcNetbootMakeDir { name: NonEmptyStr }
  | BmcNetbootPutArtifact { name: NonEmptyStr, artifact: NonEmptyStr }
  | BmcNetbootPutText { name: NonEmptyStr, text: String }
  | BmcNetbootPutFromUri { name: NonEmptyStr, source: Uri }
  | BmcNetbootLaunchServe

// A staged name is a RELATIVE path under the plan's netboot_dir: no absolute spelling, no empty
// segment (`//`, a leading or trailing `/`), no dot segment. Staging derives the remote path from
// it, so a name that is not relative would aim the derived path outside the serve root exactly as
// a hand-written absolute path would -- the same law configfs staging enforces on link names,
// widened from "one segment" to "relative, well-formed", because THIS manifest legitimately
// stages into a subdirectory (`nocloud/user-data`).
type BmcNetbootStagedPathVerdict
  = BmcNetbootStagedPathWellFormed { name: NonEmptyStr }
  | BmcNetbootStagedPathNotRelative { name: NonEmptyStr }

fn bmc_netboot_path_has_bad_segment(path: String) -> Bool {
  any(split(s: path, delimiter: "/"), seg => seg == "" || seg == "." || seg == "..")
}

fn bmc_netboot_staged_path_verdict(name: NonEmptyStr) -> BmcNetbootStagedPathVerdict {
  let n = name as String
  if starts_with(s: n, prefix: "/") || bmc_netboot_path_has_bad_segment(path: n) {
    BmcNetbootStagedPathNotRelative { name: name }
  } else {
    BmcNetbootStagedPathWellFormed { name: name }
  }
}

// THE VALIDATED SEMANTIC OPERATIONS staging returns: the same operations with their remote paths
// DERIVED from the plan's own record (proven under the serve root by construction), and with no
// process form in them at all -- a prepared operation says what the provision will do, never
// which program spells it. The variants are the PUBLIC descriptive sum; consumers match them
// freely. The unrealizable source is GONE here, not refused beside the others: preparation
// narrowed the authored sum to the two sources that can act, so a prepared put from a uri has no
// constructor to reach.
type BmcNetbootPreparedDisposition
  = BmcNetbootPreparedMakeDir { remote_path: NonEmptyStr }
  | BmcNetbootPreparedPutArtifact { remote_path: NonEmptyStr, local_path: NonEmptyStr }
  | BmcNetbootPreparedPutText { remote_path: NonEmptyStr, text: String }
  | BmcNetbootPreparedLaunchServe { serve_root: NonEmptyStr, serve_port: Port, busybox_path: NonEmptyStr }

// THE SEALED STAGED VALUE. A bare public sum is constructible by anyone, so "staged" would be a
// claim a caller could author rather than a fact staging minted: another module could write a
// prepared put by hand with a remote path it chose, and the relative-path verdict would never
// have run. The disposition stays public because it is descriptive; the wrapper is a
// sole_constructor -- construction is confined to THIS file, so the only route to a
// `BmcNetbootPreparedOp` is `bmc_netboot_op_prepared`, behind that verdict. The executor takes
// the sealed value and nothing else; no open command sum is ever an authorization.
type BmcNetbootPreparedOp sole_constructor { disposition: BmcNetbootPreparedDisposition }

// THE STAGED RESULT: the validated semantic operations to hand the executor, or the WHOLE
// staging refused. There is no state in which a refused op sits beside prepared ones, so a bad
// argument cannot act while the ops around it are skipped past -- the refusal is a stop at the
// grain a caller consumes. READY, not RAN: no operation has run yet; the name names what the
// value IS. The old provision ran its mkdir first and discovered an unrealizable put (the
// PutFromUri arm's typed refusal) MID-FOLD, after the mkdir and every earlier scp had already
// executed against the BMC; as a staging verdict it refuses before anything runs at all.
type BmcNetbootStaging
  = BmcNetbootStagingReady { operations: List<BmcNetbootPreparedOp> }
  | BmcNetbootStagingRefused { reason: NonEmptyStr }

fn bmc_netboot_staging_refused_path(bad_name: String) -> BmcNetbootStaging {
  BmcNetbootStagingRefused {
    reason: join(
      ["bmc-netboot staged name is not a relative path under the serve root: ", bad_name],
      "",
    ) as NonEmptyStr,
  }
}

fn bmc_netboot_staging_refused_transport(name: String) -> BmcNetbootStaging {
  BmcNetbootStagingRefused {
    reason: join(
      ["bmc-netboot staged file has no realized transport: ", name],
      "",
    ) as NonEmptyStr,
  }
}

fn bmc_netboot_staging_refused_seed(cause: String) -> BmcNetbootStaging {
  BmcNetbootStagingRefused {
    reason: join(
      ["bmc-netboot staged no seed: ", cause],
      "",
    ) as NonEmptyStr,
  }
}

// One op prepared alone: the validated semantic operation, or the refusal of the staging it
// would have joined. Path-carrying ops validate their names and derive the remote path from the
// plan, which is what makes "lands under the plan's serve root" structural rather than checked.
fn bmc_netboot_op_prepared(plan: BmcNetbootServePlan, op: BmcNetbootOp) -> BmcNetbootStaging {
  match op {
    BmcNetbootMakeDir { name: n } =>
      match bmc_netboot_staged_path_verdict(name: n) {
        BmcNetbootStagedPathNotRelative { name: bad } =>
          bmc_netboot_staging_refused_path(bad_name: bad as String)
        BmcNetbootStagedPathWellFormed { name: _ } =>
          BmcNetbootStagingReady {
            operations: [BmcNetbootPreparedOp {
              disposition: BmcNetbootPreparedMakeDir { remote_path: bmc_netboot_staged_path(plan: plan, name: n) },
            }],
          }
      }
    BmcNetbootPutArtifact { name: n, artifact: a } =>
      match bmc_netboot_staged_path_verdict(name: n) {
        BmcNetbootStagedPathNotRelative { name: bad } =>
          bmc_netboot_staging_refused_path(bad_name: bad as String)
        BmcNetbootStagedPathWellFormed { name: _ } =>
          BmcNetbootStagingReady {
            operations: [BmcNetbootPreparedOp {
              disposition: BmcNetbootPreparedPutArtifact {
                remote_path: bmc_netboot_staged_path(plan: plan, name: n),
                local_path: a,
              },
            }],
          }
      }
    BmcNetbootPutText { name: n, text: t } =>
      match bmc_netboot_staged_path_verdict(name: n) {
        BmcNetbootStagedPathNotRelative { name: bad } =>
          bmc_netboot_staging_refused_path(bad_name: bad as String)
        BmcNetbootStagedPathWellFormed { name: _ } =>
          BmcNetbootStagingReady {
            operations: [BmcNetbootPreparedOp {
              disposition: BmcNetbootPreparedPutText {
                remote_path: bmc_netboot_staged_path(plan: plan, name: n),
                text: t,
              },
            }],
          }
      }
    BmcNetbootPutFromUri { name: n, source: _ } =>
      bmc_netboot_staging_refused_transport(name: n as String)
    BmcNetbootLaunchServe =>
      BmcNetbootStagingReady {
        operations: [BmcNetbootPreparedOp {
          disposition: BmcNetbootPreparedLaunchServe {
            serve_root: plan.netboot_dir,
            serve_port: plan.serve_port,
            busybox_path: bmc_netboot_staged_path(plan: plan, name: "busybox"),
          },
        }],
      }
  }
}

// The staged provision: fold the ops, refusing the WHOLE staging at the first op that does not
// prepare. Ops before a refusal never become observable -- a refused staging carries no
// operation list at all, so a caller cannot act on the good prefix and skip the bad op past it.
fn bmc_netboot_staging_of(plan: BmcNetbootServePlan, ops: List<BmcNetbootOp>) -> BmcNetbootStaging {
  fold(
    ops,
    init: BmcNetbootStagingReady { operations: [] },
    f: (acc, op) =>
      match acc {
        BmcNetbootStagingRefused { reason: r } => BmcNetbootStagingRefused { reason: r },
        BmcNetbootStagingReady { operations: os } =>
          match bmc_netboot_op_prepared(plan: plan, op: op) {
            BmcNetbootStagingRefused { reason: r } => BmcNetbootStagingRefused { reason: r },
            BmcNetbootStagingReady { operations: minted } =>
              BmcNetbootStagingReady { operations: list_append(left: os, right: minted) },
          },
      },
  )
}

// THE STAGED PROVISION, ONE AUTHORITY: the directory, the seven staged files (five from the
// artifact dir, grub.cfg rendered from the typed plan, and the two nocloud seed documents —
// ADMITTED BY THE PUBLIC-SEED CONTRACT, never rendered freehand here), and the serve launch, in
// the order they must act. This replaces the old hand-unrolled sequence -- a separate
// mkdir run, then a per-file fold, then a serve launch gated on the fold's exit code -- whose
// three argv call sites each reached the transport on their own.
//
// THE TWO SEED FILES ARE THE CONTRACT'S OWN BYTES. meta-data used to write the plan's identity
// hostname as its instance-id; that route died with the identity section, and its replacement is
// NOT a reinvention here: the admitted seed's meta_data is exactly
// public_nocloud_seed_meta_data — "instance-id: iid-<the client MAC, hyphenated, lowercase>" —
// the one cited rule for the field, applied to the measured srv4 NIC row. The bytes staged are
// the bytes that passed; re-deriving them here would put a second copy of the format in this
// module, where the next contract change edits one and forgets the other.
fn seed_document_name(document: SeedDocument) -> String {
  match document {
    SeedUserData => "user-data"
    SeedMetaData => "meta-data"
  }
}

fn seed_finding_cause(finding: PublicSeedFinding) -> String {
  match finding {
    SeedKeyNotAdmitted { document: d, path: p } => join([seed_document_name(document: d), ": field '", p, "' is not a public-seed field"], "")
    SeedCredentialField { document: d, path: p } => join([seed_document_name(document: d), ": credential field '", p, "' has no place in a seed served to the network"], "")
    SeedValueNotAdmitted { document: d, path: p } => join([seed_document_name(document: d), ": the value at '", p, "' is not an admitted one"], "")
    SeedPasswordSshEnabled { document: d, path: p } => join([seed_document_name(document: d), ": password authentication is enabled at '", p, "'"], "")
    SeedAuthorizedKeyNotPublic { document: d, path: p } => join([seed_document_name(document: d), ": the authorized key at '", p, "' is not a canonical public key line"], "")
    SeedCredentialShapedValue { document: d, path: p } => join([seed_document_name(document: d), ": the value at '", p, "' is shaped like a credential"], "")
    SeedRenderRefused { document: d, reason: r } => join([seed_document_name(document: d), " could not render: ", r], "")
  }
}

fn seed_findings_text(findings: FreeSemigroup<PublicSeedFinding>) -> String {
  fold(
    concat([findings.head], findings.tail),
    init: "",
    f: (acc, finding) =>
      if acc == "" {
        seed_finding_cause(finding: finding)
      } else {
        join([acc, "; ", seed_finding_cause(finding: finding)], "")
      },
  )
}

fn seed_admission_cause(findings: FreeSemigroup<PublicSeedFinding>) -> NonEmptyStr {
  let note = "bmc-netboot refuses to stage: the seed is not admitted by gunbc.provisioning.public_nocloud_seed"
  let rendered = seed_findings_text(findings: findings)
  if rendered == "" { note as NonEmptyStr } else { join([note, ": ", rendered], "") as NonEmptyStr }
}

fn bmc_netboot_staging_ops(
  plan: BmcNetbootServePlan,
  user_seed: String,
  meta_seed: String,
) -> List<BmcNetbootOp> {
  [
    BmcNetbootMakeDir { name: "nocloud" },
    BmcNetbootPutArtifact { name: "busybox", artifact: bmc_netboot_artifact(name: "busybox") },
    BmcNetbootPutArtifact { name: "vmlinuz", artifact: bmc_netboot_artifact(name: "vmlinuz") },
    BmcNetbootPutArtifact { name: "initrd", artifact: bmc_netboot_artifact(name: "initrd") },
    BmcNetbootPutArtifact { name: "grubaa64.efi", artifact: bmc_netboot_artifact(name: "grubaa64.efi") },
    BmcNetbootPutText { name: "grub.cfg", text: bmc_netboot_grub_cfg_text(plan: plan) },
    BmcNetbootPutText { name: "nocloud/user-data", text: user_seed },
    BmcNetbootPutText { name: "nocloud/meta-data", text: meta_seed },
    BmcNetbootLaunchServe,
  ]
}

fn bmc_netboot_provision_staging(plan: BmcNetbootServePlan) -> BmcNetbootStaging {
  // THE SEED IS ADMITTED BEFORE ANY OP IS PREPARED, so a document the public-seed contract
  // refuses stages NOTHING rather than staging a file whose credential field or instance-id was
  // made up. The refusal carries no operation list at all, which is how this module already says
  // "none of this becomes observable".
  match bmc_netboot_user_seed_admission(plan: plan) {
    PublicSeedRefused { findings: f } => bmc_netboot_staging_refused_seed(cause: seed_admission_cause(findings: f))
    PublicSeedAdmitted { seed: admitted } => bmc_netboot_staging_of(
      plan: plan,
      ops: bmc_netboot_staging_ops(
        plan: plan,
        user_seed: public_nocloud_seed_user_data(seed: admitted),
        meta_seed: public_nocloud_seed_meta_data(seed: admitted),
      ),
    )
  }
}

// ---- THE REALIZATION BOUNDARY ----

// A prepared semantic operation lowers here to what acts: a command that runs ON THE BMC (over
// this plan's ssh transport), a file transfer pushed from here, or a file staged locally and
// then transferred. The boundary is ENFORCED one rung up, at the sealed staged value --
// realization accepts only a `BmcNetbootPreparedOp`, and only staging constructs one -- so
// "lowered" is a fact about a value staging minted, not a claim about a visibility keyword this
// language does not have. The executing consumer is the executor below and the tool-realization
// witness reads past this point at argv grain; the domain witness stops at the staged value.
// The local path of a staged-text put is DERIVED from the prepared op's own remote path, so the
// write-then-transfer pair cannot disagree about which file they mean.
type BmcNetbootOpCommand
  = BmcNetbootOpRunsOnBmc { command: ArgvCommand }
  | BmcNetbootOpTransfersFile { local_path: NonEmptyStr, remote_path: NonEmptyStr }
  | BmcNetbootOpStagesFile { local_path: NonEmptyStr, content: String, remote_path: NonEmptyStr }

// The BMC's mkdir is a PATH-resolved BusyBox applet, deliberately not an absolute path: this
// repository has never read that image's filesystem (extdeps.tools.mkdir
// mkdir_parents_command_at, extdeps.exec.command program_spelling_is_an_observation_claim).
data bmc_path_resolved_mkdir_applet: NonEmptyStr = "mkdir"

// Text put locally first, at a name derived from the remote path it will land at: two staged
// texts must not overwrite one another's local file, and the basename pairing is the derivation.
data bmc_netboot_local_staging_prefix: NonEmptyStr = "/tmp/gunbc-bmc-"

fn bmc_staged_file_basename(remote_path: NonEmptyStr) -> String {
  fold(
    split(s: remote_path as String, delimiter: "/"),
    init: "",
    f: (acc, segment) => segment,
  )
}

fn bmc_netboot_local_staging_path(remote_path: NonEmptyStr) -> NonEmptyStr {
  join([bmc_netboot_local_staging_prefix as String, bmc_staged_file_basename(remote_path: remote_path)], "") as NonEmptyStr
}

fn bmc_netboot_prepared_realization(op: BmcNetbootPreparedOp) -> BmcNetbootOpCommand {
  match op.disposition {
    BmcNetbootPreparedMakeDir { remote_path: p } =>
      BmcNetbootOpRunsOnBmc {
        command: mkdir_parents_command_at(mkdir_binary: bmc_path_resolved_mkdir_applet, path: p as String),
      }
    BmcNetbootPreparedPutArtifact { remote_path: p, local_path: l } =>
      BmcNetbootOpTransfersFile { local_path: l, remote_path: p }
    BmcNetbootPreparedPutText { remote_path: p, text: t } =>
      BmcNetbootOpStagesFile {
        local_path: bmc_netboot_local_staging_path(remote_path: p),
        content: t,
        remote_path: p,
      }
    BmcNetbootPreparedLaunchServe { serve_root: root, serve_port: port, busybox_path: bin } =>
      BmcNetbootOpRunsOnBmc {
        command: busybox_httpd_command(busybox_bin: bin, document_root: root, port: port),
      }
  }
}

// ---- THE EXECUTOR ----

// THE ONE PLACE AN ARM BECOMES A RUN. The executor consumes the SEALED staged value: it matches
// the realization out of the wrapper staging minted and runs it over the transport the arm
// names -- on-Bmc commands over this plan's ssh transport, transfers from here over local exec.
// The old provision had three call sites reaching the transport independently (run_bmc, put_path,
// the serve launch); with one executor, "which transport acts" is a fact of the arm, read once.
// This is the seam host_effect_apply's typed binding replaces (the dissolution trigger below):
// when it lands, these arms fold onto typed staging effects and run_shell_command retires.
fn bmc_netboot_transfer(plan: BmcNetbootServePlan, local: NonEmptyStr, remote_path: NonEmptyStr) -> ProcessExit {
  let remote_target = join([bmc_ssh_target(plan: plan) as String, ":", remote_path as String], "") as NonEmptyStr
  run_shell_command(command: scp_command(local_path: local, remote_target: remote_target), transport: LocalExec)
}

fn bmc_netboot_apply_prepared(plan: BmcNetbootServePlan, op: BmcNetbootPreparedOp) -> ProcessExit {
  match bmc_netboot_prepared_realization(op: op) {
    BmcNetbootOpRunsOnBmc { command: c } =>
      run_shell_command(command: c, transport: bmc_transport(plan: plan))
    BmcNetbootOpTransfersFile { local_path: l, remote_path: p } =>
      bmc_netboot_transfer(plan: plan, local: l, remote_path: p)
    BmcNetbootOpStagesFile { local_path: l, content: t, remote_path: p } => {
      let w = Filesystem.Write(path: l as String, content: t)
      if w.success == false {
        return exit_failure(reason: concat("bmc-netboot: local write failed for ", p as String))
      }
      bmc_netboot_transfer(plan: plan, local: l, remote_path: p)
    }
  }
}

// A refused staging is a refusal with NOTHING RAN -- the reason says so, because the difference
// between "refused before acting" and "failed part-way" is the fact a caller needs.
fn bmc_netboot_staging_refused_exit(reason: String) -> ProcessExit {
  exit_failure(reason: concat("bmc-netboot: staging refused, nothing ran: ", reason))
}

fn bmc_netboot_apply_staging(plan: BmcNetbootServePlan, staging: BmcNetbootStaging) -> ProcessExit {
  match staging {
    BmcNetbootStagingRefused { reason: r } => bmc_netboot_staging_refused_exit(reason: r as String)
    BmcNetbootStagingReady { operations: os } =>
      fold(
        os,
        init: ExitSuccess,
        f: (acc, op) =>
          match acc {
            ExitFailure { code: _, reason: _ } => acc
            ExitSuccess => bmc_netboot_apply_prepared(plan: plan, op: op)
          },
      )
  }
}

fn bmc_netboot_provision(plan: BmcNetbootServePlan) -> ProcessExit {
  bmc_netboot_apply_staging(plan: plan, staging: bmc_netboot_provision_staging(plan: plan))
}

fn srv4_bmc_netboot_provision() -> ProcessExit {
  bmc_netboot_provision(plan: srv4_bmc_netboot_serve_plan)
}

data bmc_netboot_provision_scaffold: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.bmc.bmc_netboot_serve",
    decl_name: "bmc_netboot_provision_dissolution_trigger",
    field: WholeDeclaration,
  }
}

data bmc_netboot_provision_dissolution_trigger: DissolutionCondition = unbound_dissolution(description: "🟡 dissolve-on: bmc_netboot_provision — the staging manifest IS the driver, and since 2026-09-30 it is ONE TYPED STAGING: provision folds its ops (BmcNetbootMakeDir / BmcNetbootPutArtifact / BmcNetbootPutText / BmcNetbootPutFromUri / BmcNetbootLaunchServe) through bmc_netboot_staging_of into one BmcNetbootStaging — the prepared operations, or the whole staging refused — and a refused staging runs nothing, so a bad argument cannot act while the ops around it are skipped past. Preparation also NARROWS the sources: the unrealizable uri source refuses as a staging verdict (the old provision ran its mkdir first and discovered the unrealizable put MID-FOLD, after the mkdir and every earlier scp had already executed against the BMC) and has no prepared constructor at all, so the realization match carries no dead arm. The three scattered run_shell_command call sites are gone (bmc_netboot_run_bmc, bmc_netboot_put_path, and the serve launch each reached the transport independently; that was three bridge sites duplicating one pattern): one executor, bmc_netboot_apply_staging, consumes the SEALED staged value (BmcNetbootPreparedOp is a sole_constructor minted only behind the relative-path verdict, so a hand-authored prepared op with a remote path its author chose is a compile-time refusal, proven by the domain witness's cross-module probe) and alone turns an arm into a run. The serve command's rendered-text surface (bmc_netboot_serve_command_text, BmcNetbootServeCommandTextBuilt/Refused) is deleted — the witness reads argv fields now, not scraped shell text. HISTORY, for the stale-citation discipline: this clause previously recorded the heredoc-bridge hop through command_runner's shell_exec_via_bash/retained_runtime, then its deletion when command_runner asked command_over_transport once and handed the result straight to shell.Exec.RunArgv, then the SshExec arm's RFC-4254 fold in extdeps.exec.command (cited IEEE 1003.1-2017 section 2.2.2) — each correction rewritten when it landed, not left standing. Remaining debt, scoped: command_runner_dissolution_trigger's own first clause — host_effect_apply has not yet bound ArgvCommand execution, so the executor's three arms (mkdir on the BMC, the scp transfers, the busybox-httpd launch) still lower through gunbc.command_runner.run_shell_command, which this module inherits rather than duplicates. DISSOLVES WHEN host_effect_apply binds ArgvCommand execution (mkdir / scp / busybox-httpd-launch) as typed staging effects, and dag/gunbc/bmc/bmc_netboot_serve.dag retires command_runner.run_shell_command in its favor — the sealed staged value is already the shape that binding would consume")
