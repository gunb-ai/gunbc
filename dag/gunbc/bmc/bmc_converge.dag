type ApprovedBmcFirmwareArtifact {
  firmware: BmcFirmwareVersion
  board: BaseboardModel
  image_uri: Uri
  digest: Digest
}

type BmcFirmwareUpdatePlan {
  host: HostIdentity
  observed: BmcFirmwareObservation
  artifact: ApprovedBmcFirmwareArtifact
  update_service: BmcUpdateServiceObservation
}

type BmcFanPolicyApplyPlan {
  host: HostIdentity
  observed: BmcFanPolicyObservation
  desired_curve: BmcFanCurve
  config_path: NonEmptyStr
  controller_service: NonEmptyStr
  projection: BmcFanPolicyProjectionCapability
}

type BmcFanConfigPersistenceApplyRefusalCause
  = BmcFanConfigPersistenceSubstrateNotGrounded
  | BmcFanConfigPersistenceSubstrateUnsupported { detail: NonEmptyStr }

type FanPolicySuitabilityRefusalCause
  = FanPolicyFirmwareMustConvergeBeforeRealizer
  | FanPolicyInstalledTachTopologyDiffersFromIntent
  | FanPolicyTachExpectationAbsentForHost
  | FanPolicyTachExpectationDuplicateForHost
  | FanPolicyTachExpectationHeaderDuplicated
  | FanPolicyProjectionCapabilityRefused {
      cause: BmcFanProjectionApplyRefusalCause,
    }
  | FanPolicyRealizerSubstrateUnobserved
  | FanPolicyPersistenceApplyRefused {
      cause: BmcFanConfigPersistenceApplyRefusalCause,
    }
  | FanPolicyDurabilityCommitBarrierMissing

type BmcFanPolicySuitability
  = FanPolicySuitable
  | FanPolicySuitabilityRefused { cause: FanPolicySuitabilityRefusalCause }

// THREE STANDINGS, BECAUSE A REFUSAL TO BUILD EVIDENCE IS NOT AN ABSENCE OF EVIDENCE.
// The gate previously folded a refused construction into the same arm as `Absent` -- run the
// qualification over a silently shortened evidence list -- so a durability question could be
// answered from whatever evidence happened to survive. That is the absorbing-fallback shape
// (DESIGN 5): the failure arm widened instead of refusing, and the deficit left no count.
// bmc_fan_policy_classification already answers this exact input with a typed refusal, so the
// third standing makes the gate agree with the policy its own module carries.
type BmcFanPolicyDurabilityGate
  = BmcFanPolicyDurabilityQualified {
      qualification: StateDurabilityQualification<HostIdentity, BmcFanConfigReadbackSubject>,
    }
  | BmcFanPolicyDurabilityRefused {
      cause: StateDurabilityRefusal<HostIdentity, BmcFanConfigReadbackSubject>,
    }
  | BmcFanPolicyDurabilityEvidenceConstructionRefused {
      cause: BmcFanDurabilityEvidenceConstructionRefusal,
    }

type BmcFanConfigPersistenceApplySuitability
  = BmcFanConfigPersistenceApplySuitable
  | BmcFanConfigPersistenceApplyRefused {
      cause: BmcFanConfigPersistenceApplyRefusalCause,
    }

fn bmc_fan_config_persistence_unsupported_detail(reason: String) -> NonEmptyStr {
  if string_length(s: reason) > 0 {
    reason as NonEmptyStr
  } else {
    "bmc config persistence unsupported without detail" as NonEmptyStr
  }
}

fn bmc_fan_config_persistence_apply_refusal_reason(
  cause: BmcFanConfigPersistenceApplyRefusalCause,
) -> String {
  match cause {
    BmcFanConfigPersistenceSubstrateNotGrounded =>
      "bmc fan realizer is not grounded by the observed overlay, SquashFS lower, writable JFFS2 upper, exact firmware, and config path"
    BmcFanConfigPersistenceSubstrateUnsupported { detail: detail } =>
      concat("bmc config persistence unsupported: ", detail as String)
  }
}

fn bmc_fan_policy_suitability_refusal_reason(
  cause: FanPolicySuitabilityRefusalCause,
) -> String {
  match cause {
    FanPolicyFirmwareMustConvergeBeforeRealizer =>
      "bmc firmware must converge and be re-observed before selecting a version-specific fan-policy realizer"
    FanPolicyInstalledTachTopologyDiffersFromIntent =>
      "bmc fan projection installed-tach topology differs from this host's declared tach expectation"
    FanPolicyTachExpectationAbsentForHost =>
      "bmc fan apply refused: no fan tach expectation is declared for this host, so which headers must report is unknown"
    FanPolicyTachExpectationDuplicateForHost =>
      "bmc fan apply refused: this host carries more than one fan tach expectation, so which headers must report is decided by authoring order"
    FanPolicyTachExpectationHeaderDuplicated =>
      "bmc fan apply refused: this host's fan tach expectation authors one header twice, so the required list is a broken row rather than a topology"
    FanPolicyProjectionCapabilityRefused { cause: cause } =>
      match cause {
        BmcFanProjectionAlignmentStandingAbsent =>
          "bmc fan apply refused: no alignment standing is declared for this host, so nothing establishes that the intent describes what it runs"
        BmcFanProjectionAlignmentStandingDuplicate =>
          "bmc fan apply refused: this host carries more than one alignment standing, so which one governs is decided by authoring order"
        BmcFanProjectionObservedProgramNotAdopted =>
          "bmc fan apply refused: nobody has adopted this host's observed fan control program, so agreement with the intent is unestablished rather than confirmed"
        BmcFanProjectionObservedProgramNotRepresentable =>
          "bmc fan apply refused: the host runs a fan control program the intent cannot represent, so applying would partially revert it"
        BmcFanProjectionObservedProgramRepresentableNotAdopted =>
          "bmc fan apply refused: the intent can represent this host's observed fan control program, but nobody has adopted that interpretation as intent, so agreement is unestablished rather than confirmed"
        BmcFanProjectionBoardMismatch =>
          "bmc fan projection capability board does not match the observed board"
        BmcFanProjectionFirmwareMismatch =>
          "bmc fan projection capability firmware does not match the observed firmware"
        BmcFanProjectionCurveMismatch =>
          "bmc fan projection capability curve does not match fleet intent"
        BmcFanProjectionConfigPathMismatch =>
          "bmc fan projection capability config path does not match the observed config path"
        BmcFanProjectionControllerServiceMismatch =>
          "bmc fan projection capability controller service does not match the observed controller service"
      }
    FanPolicyRealizerSubstrateUnobserved =>
      "bmc fan realizer lifetime cannot be evaluated because its current filesystem substrate has not been observed"
    FanPolicyPersistenceApplyRefused { cause: cause } =>
      bmc_fan_config_persistence_apply_refusal_reason(cause: cause)
    FanPolicyDurabilityCommitBarrierMissing =>
      "bmc fan projection lacks a synchronized durability commit barrier"
  }
}

// BMC and Ubuntu convergence share std.upsert_decision for observe/classify/plan and
// std.realization_reconcile for apply/read-back. Fan-policy reconciliation is three separable
// questions: apply suitability, post-apply durability qualification, and ordinary convergence after
// qualification. Apply may proceed without prior durability evidence; Noop requires qualification
// plus a live canonical digest equal to the admitted digest.
fn bmc_firmware_intent_mismatch_reason(
  required: BmcFirmwareTrack,
  observed: BmcFirmwareVersion,
) -> String {
  concat(
    "bmc firmware observation does not satisfy declared track: required major ",
    required.major_version as String,
    ", observed major ",
    observed.version.major as String,
    " minor ",
    observed.version.minor as String,
    " patch ",
    observed.version.patch as String,
  )
}

fn bmc_firmware_classification(
  host: HostIdentity,
  board: BaseboardModel,
  intent: BmcFirmwareIntent,
  observation: BmcFirmwareObservation?,
  artifact: ApprovedBmcFirmwareArtifact?,
  update_service: BmcUpdateServiceObservation?,
) -> UpsertClassification<BmcFirmwareUpdatePlan> {
  match observation {
    Absent =>
      UpsertClassification {
        verdict: UnknownRefused,
        decision: Refuse {
          reason: "bmc firmware observation absent; refuse both noop and update",
        },
      }
    Present { value: observed } =>
      match bmc_firmware_observation_intent_verdict(
        intent: intent,
        observation: observed,
      ) {
        BmcFirmwareIntentSatisfied =>
          UpsertClassification {
            verdict: Converged,
            decision: Noop,
          }
        BmcFirmwareIntentMismatch { required: required, observed: mismatch_observed } =>
          match artifact {
            Absent =>
              UpsertClassification {
                verdict: Drifted,
                decision: Refuse {
                  reason: concat(
                    "bmc firmware drift observed, but no exact approved board-compatible image artifact is available: ",
                    bmc_firmware_intent_mismatch_reason(
                      required: required,
                      observed: mismatch_observed,
                    ),
                  ),
                },
              }
            Present { value: approved } =>
              if approved.board != board {
                UpsertClassification {
                  verdict: Conflict,
                  decision: Refuse {
                    reason: concat(
                      "approved bmc firmware artifact does not match the target board and declared firmware track: ",
                      bmc_firmware_intent_mismatch_reason(
                        required: required,
                        observed: mismatch_observed,
                      ),
                    ),
                  },
                }
              } else {
                match bmc_firmware_version_intent_verdict(
                  firmware: approved.firmware,
                  intent: intent,
                ) {
                  BmcFirmwareIntentMismatch { required: _, observed: _ } =>
                    UpsertClassification {
                      verdict: Conflict,
                      decision: Refuse {
                        reason: concat(
                          "approved bmc firmware artifact does not match the target board and declared firmware track: ",
                          bmc_firmware_intent_mismatch_reason(
                            required: required,
                            observed: mismatch_observed,
                          ),
                        ),
                      },
                    }
                  BmcFirmwareIntentSatisfied =>
                    match update_service {
                      Absent =>
                        UpsertClassification {
                          verdict: Drifted,
                          decision: Refuse {
                            reason: concat(
                              "bmc firmware drift and approved artifact are known, but the current UpdateService surface has not been observed: ",
                              bmc_firmware_intent_mismatch_reason(
                                required: required,
                                observed: mismatch_observed,
                              ),
                            ),
                          },
                        }
                      Present { value: update_surface } =>
                        if update_surface.firmware.endpoint == observed.endpoint
                          && update_surface.firmware.firmware == observed.firmware
                          && update_surface.active_bmc_image_updateable {
                          UpsertClassification {
                            verdict: Drifted,
                            decision: Apply {
                              plan: BmcFirmwareUpdatePlan {
                                host: host,
                                observed: observed,
                                artifact: approved,
                                update_service: update_surface,
                              },
                            },
                          }
                        } else {
                          UpsertClassification {
                            verdict: Conflict,
                            decision: Refuse {
                              reason: concat(
                                "observed UpdateService does not identify an updateable active image for the exact target controller and firmware: ",
                                bmc_firmware_intent_mismatch_reason(
                                  required: required,
                                  observed: mismatch_observed,
                                ),
                              ),
                            },
                          }
                        }
                    }
                }
              }
          }
      }
  }
}

fn bmc_fan_config_persistence_apply_suitability(
  observation: BmcConfigPersistenceObservation,
  expected_firmware: BmcFirmwareVersion,
  config_path: NonEmptyStr,
) -> BmcFanConfigPersistenceApplySuitability {
  match observation {
    BmcOverlayConfigObserved {
      firmware: firmware,
      config_path: observed_path,
      overlay: overlay,
      writable: writable,
      upper_override_present: _,
      available_bytes: _,
      observed_at: _,
    } =>
      if firmware == expected_firmware
        && writable
        && observed_path == config_path
        && linux_overlay_observation_is_flash_backed(
          observation: overlay,
        ) {
        BmcFanConfigPersistenceApplySuitable
      } else {
        BmcFanConfigPersistenceApplyRefused {
          cause: BmcFanConfigPersistenceSubstrateNotGrounded,
        }
      }
    BmcConfigPersistenceUnsupported {
      firmware: _,
      config_path: _,
      reason: reason,
      observed_at: _,
    } =>
      BmcFanConfigPersistenceApplyRefused {
        cause: BmcFanConfigPersistenceSubstrateUnsupported {
          detail: bmc_fan_config_persistence_unsupported_detail(reason: reason),
        },
      }
  }
}

fn bmc_fan_policy_apply_suitability(
  standings: List<HostBmcFanAlignmentStanding>,
  host: HostIdentity,
  board: BaseboardModel,
  intent: BmcControlPlaneIntent,
  observation: BmcFanPolicyObservation,
  persistence: BmcConfigPersistenceObservation?,
  projection: BmcFanPolicyProjectionCapability,
) -> BmcFanPolicySuitability {
  if bmc_fan_firmware_blocks_realizer(
    intent_firmware: intent.firmware,
    observed_firmware: observation.firmware,
  ) {
    FanPolicySuitabilityRefused {
      cause: FanPolicyFirmwareMustConvergeBeforeRealizer,
    }
  } else {
    match host_fan_tach_expectation_admission(host: host) {
      HostFanTachExpectationAbsent =>
        FanPolicySuitabilityRefused {
          cause: FanPolicyTachExpectationAbsentForHost,
        }
      HostFanTachExpectationDuplicate { count } =>
        FanPolicySuitabilityRefused {
          cause: FanPolicyTachExpectationDuplicateForHost,
        }
      HostFanTachExpectationHeaderDuplicated { header } =>
        FanPolicySuitabilityRefused {
          cause: FanPolicyTachExpectationHeaderDuplicated,
        }
      HostFanTachExpectationEstablished { expectation } =>
    if projection.required_tach_inputs != expected_tach_headers(expectation: expectation) {
      FanPolicySuitabilityRefused {
        cause: FanPolicyInstalledTachTopologyDiffersFromIntent,
      }
    } else {
      match bmc_fan_policy_projection_apply_suitability(
        capability: projection,
        board: board,
        desired_curve: intent.fan_policy.curve,
        observation: observation,
        host: host,
        standings: standings,
      ) {
        BmcFanProjectionApplyRefused { cause: cause } =>
          FanPolicySuitabilityRefused {
            cause: FanPolicyProjectionCapabilityRefused { cause: cause },
          }
        BmcFanProjectionApplySuitable =>
          match persistence {
            Absent =>
              FanPolicySuitabilityRefused {
                cause: FanPolicyRealizerSubstrateUnobserved,
              }
            Present { value: storage } =>
              match bmc_fan_config_persistence_apply_suitability(
                observation: storage,
                expected_firmware: observation.firmware,
                config_path: observation.board_config_path,
              ) {
                BmcFanConfigPersistenceApplyRefused { cause: cause } =>
                  FanPolicySuitabilityRefused {
                    cause: FanPolicyPersistenceApplyRefused { cause: cause },
                  }
                BmcFanConfigPersistenceApplySuitable =>
                  match bmc_fan_policy_projection_durability_capability(
                    capability: projection,
                  ).commit_barrier {
                    NoDurabilityCommitBarrier =>
                      FanPolicySuitabilityRefused {
                        cause: FanPolicyDurabilityCommitBarrierMissing,
                      }
                    SynchronizedCommit => FanPolicySuitable
                  }
              }
          }
      }
    }
    }
  }
}

// IT TAKES THE REFUSAL, NOT THE VERDICT. Reading the whole verdict forced an arm for
// `StateDurabilityQualified`, and the only thing that arm could answer was the empty string --
// a fabricated reason for something that was not refused. The empty string then travelled into
// a caller-built sentence, where it reads as "refused, reason blank" rather than "not refused".
fn bmc_fan_durability_refusal_reason(
  cause: StateDurabilityRefusal<HostIdentity, BmcFanConfigReadbackSubject>,
) -> String {
  match cause {
    DurabilityDefinitionLinkageUnavailable {
      assertions: assertions,
      count: count,
    } =>
      concat(
        "caller-asserted definition linkages cannot qualify durable lifetime (count ",
        count as String,
        ")",
      )
    DurabilityEvidenceMissing { admission: admission, boundary: _ } =>
      concat(
        "selected realization has no exact evidence for target, desired state, realization, capability version, perturbation generation, readback subject, and boundary: ",
        admission.realization.realization_id as String,
      )
    DurabilityEvidenceAmbiguous { admission: admission, boundary: _, count: _ } =>
      concat(
        "selected realization has duplicate or conflicting exact durability evidence: ",
        admission.realization.realization_id as String,
      )
    DurabilityIntentUnspecified =>
      "bmc fan durability intent is unspecified"
    DurabilityCapabilityMissing =>
      "bmc fan durability capability is missing"
    DurabilityCapabilityAdmissionMismatch {
      expected_realization: expected_realization,
      observed_realization: observed_realization,
      expected_capability_version: _,
      observed_capability_version: _,
    } =>
      concat(
        "bmc fan durability capability admission mismatch: expected ",
        expected_realization.realization_id as String,
        ", observed ",
        observed_realization.realization_id as String,
      )
    DurabilityCommitBarrierMissing { realization: realization } =>
      concat(
        "bmc fan realization lacks a durability commit barrier: ",
        realization.realization_id as String,
      )
    DurabilityBoundaryUnsupported { realization: realization, boundary: _ } =>
      concat(
        "bmc fan realization does not support the requested durability boundary: ",
        realization.realization_id as String,
      )
    DurabilityDesiredStateMismatch {
      desired: _,
      before: _,
      after: _,
    } =>
      "bmc fan readback digest does not match the admitted desired state"
    DurabilityRequirementDuplicate { boundary: _, count: count } =>
      concat(
        "bmc fan durability requirement duplicated for boundary (count ",
        count as String,
        ")",
      )
    DurabilityPerturbationTargetMismatch {
      expected: expected,
      observed: observed,
    } =>
      concat(
        "bmc fan durability perturbation target mismatch: expected ",
        expected as String,
        ", observed ",
        observed as String,
      )
    DurabilityPerturbationBoundaryMismatch {
      expected: _,
      observed: _,
    } =>
      "bmc fan durability perturbation boundary mismatch"
    DurabilityPerturbationGenerationMismatch {
      expected: expected,
      observed: observed,
    } =>
      concat(
        "bmc fan durability perturbation generation mismatch: expected ",
        expected as String,
        ", observed ",
        observed as String,
      )
    DurabilityReadbackReceiptLinkMismatch {
      position: _,
      expected_receipt_id: expected_receipt_id,
      observed_receipt_id: observed_receipt_id,
    } =>
      concat(
        concat(
          "bmc fan durability readback receipt link mismatch: expected ",
          expected_receipt_id as String,
        ),
        concat(", observed ", observed_receipt_id as String),
      )
    DurabilityReadbackTargetMismatch {
      position: _,
      expected: expected,
      observed: observed,
    } =>
      concat(
        "bmc fan durability readback target mismatch: expected ",
        concat(expected as String, concat(", observed ", observed as String)),
      )
    DurabilityReadbackSubjectMismatch {
      position: _,
      expected: expected,
      observed: observed,
    } =>
      concat(
        "bmc fan durability readback subject mismatch: expected ",
        concat(
          expected.config_path as String,
          concat(", observed ", observed.config_path as String),
        ),
      )
    DurabilityActivationReceiptLinkMismatch {
      expected_receipt_id: expected_receipt_id,
      observed_receipt_id: observed_receipt_id,
    } =>
      concat(
        concat(
          "bmc fan durability activation receipt link mismatch: expected ",
          expected_receipt_id as String,
        ),
        concat(", observed ", observed_receipt_id as String),
      )
    DurabilityActivationScopeMismatch {
      expected: _,
      observed: _,
    } =>
      "bmc fan durability activation scope mismatch"
    DurabilityActivationUnverified { reason: reason } =>
      concat("bmc fan durability activation unverified: ", reason)
    DurabilityStateLost { before: _, after: _, reason: reason } =>
      concat("bmc fan durable state lost across boundary: ", reason)
    DurabilityObservationRefused { reason: reason } =>
      concat("bmc fan durability observation refused: ", reason)
  }
}

fn bmc_fan_policy_durability_qualification(
  intent: BmcControlPlaneIntent,
  host: HostIdentity,
  projection: BmcFanPolicyProjectionCapability,
  durability_generation: StatePerturbationGeneration,
  durability_evidence: List<BmcFanDurabilityEvidence>,
) -> StateDurabilityVerdict<HostIdentity, BmcFanConfigReadbackSubject> {
  state_durability_verdict(
    intent: intent.fan_policy.durability,
    admission: bmc_fan_policy_projection_durability_admission(
      host: host,
      capability: projection,
      perturbation_generation: durability_generation,
    ),
    capability: Present {
      value: bmc_fan_policy_projection_durability_capability(
        capability: projection,
      ),
    },
    evidence: durability_evidence,
  )
}

fn bmc_fan_policy_ordinary_convergence(
  host: HostIdentity,
  observation: BmcFanPolicyObservation,
  desired_curve: BmcFanCurve,
  projection: BmcFanPolicyProjectionCapability,
) -> UpsertClassification<BmcFanPolicyApplyPlan> {
  match bmc_fan_policy_drift_assessment(
    desired_curve: desired_curve,
    observation: observation,
    projection: projection,
  ) {
    BmcFanPolicyDrifted { cause: _ } =>
      UpsertClassification {
        verdict: Drifted,
        decision: Apply {
          plan: BmcFanPolicyApplyPlan {
            host: host,
            observed: observation,
            desired_curve: desired_curve,
            config_path: observation.board_config_path,
            controller_service: observation.controller_service,
            projection: projection,
          },
        },
      }
    BmcFanPolicyConverged =>
      UpsertClassification {
        verdict: Converged,
        decision: Noop,
      }
  }
}

fn bmc_fan_policy_durability_gate(
  intent: BmcControlPlaneIntent,
  host: HostIdentity,
  projection: BmcFanPolicyProjectionCapability,
  durability_generation: StatePerturbationGeneration,
  durability_evidence_construction: BmcFanDurabilityEvidenceConstruction?,
  durability_evidence: List<BmcFanDurabilityEvidence>,
) -> BmcFanPolicyDurabilityGate {
  match durability_evidence_construction {
    Present {
      value: BmcFanDurabilityEvidenceConstructionRefused { cause: cause },
    } =>
      BmcFanPolicyDurabilityEvidenceConstructionRefused { cause: cause }
    Present {
      value: BmcFanDurabilityEvidenceBuilt { evidence: evidence },
    } =>
      bmc_fan_policy_durability_gate_over_evidence(
        intent: intent,
        host: host,
        projection: projection,
        durability_generation: durability_generation,
        durability_evidence: append([evidence], items: durability_evidence),
      )
    Absent =>
      bmc_fan_policy_durability_gate_over_evidence(
        intent: intent,
        host: host,
        projection: projection,
        durability_generation: durability_generation,
        durability_evidence: durability_evidence,
      )
  }
}

fn bmc_fan_policy_durability_gate_over_evidence(
  intent: BmcControlPlaneIntent,
  host: HostIdentity,
  projection: BmcFanPolicyProjectionCapability,
  durability_generation: StatePerturbationGeneration,
  durability_evidence: List<BmcFanDurabilityEvidence>,
) -> BmcFanPolicyDurabilityGate {
  let durability = bmc_fan_policy_durability_qualification(
    intent: intent,
    host: host,
    projection: projection,
    durability_generation: durability_generation,
    durability_evidence: durability_evidence,
  )
  match durability {
    StateDurabilityRefused { cause: cause } =>
      BmcFanPolicyDurabilityRefused { cause: cause }
    StateDurabilityQualified { qualification: qualification } =>
      BmcFanPolicyDurabilityQualified { qualification: qualification }
  }
}

fn bmc_fan_policy_durability_gated_convergence(
  host: HostIdentity,
  observed: BmcFanPolicyObservation,
  desired_curve: BmcFanCurve,
  projection: BmcFanPolicyProjectionCapability,
  durability_gate: BmcFanPolicyDurabilityGate,
) -> UpsertClassification<BmcFanPolicyApplyPlan> {
  match durability_gate {
    BmcFanPolicyDurabilityEvidenceConstructionRefused { cause: cause } =>
      UpsertClassification {
        verdict: UnknownRefused,
        decision: Refuse {
          reason: concat(
            "bmc fan durability evidence construction refused: ",
            bmc_fan_durability_evidence_construction_refusal_reason(cause: cause),
          ),
        },
      }
    BmcFanPolicyDurabilityRefused { cause: cause } =>
      UpsertClassification {
        verdict: UnknownRefused,
        decision: Refuse {
          reason: concat(
            "bmc fan realizer does not satisfy the declared state lifetime: ",
            bmc_fan_durability_refusal_reason(cause: cause),
          ),
        },
      }
    BmcFanPolicyDurabilityQualified { qualification: _ } =>
      match bmc_fan_policy_projection_live_digest_suitability(
        capability: projection,
        observation: observed,
      ) {
        BmcFanProjectionLiveDigestRefused { cause: cause } =>
          UpsertClassification {
            verdict: UnknownRefused,
            decision: Refuse {
              reason: bmc_fan_projection_live_digest_refusal_reason(
                cause: cause,
              ),
            },
          }
        BmcFanProjectionLiveDigestMatches =>
          bmc_fan_policy_ordinary_convergence(
            host: host,
            observation: observed,
            desired_curve: desired_curve,
            projection: projection,
          )
      }
  }
}

fn bmc_fan_policy_durability_gated_convergence_from_inputs(
  intent: BmcControlPlaneIntent,
  host: HostIdentity,
  observed: BmcFanPolicyObservation,
  desired_curve: BmcFanCurve,
  projection: BmcFanPolicyProjectionCapability,
  durability_generation: StatePerturbationGeneration,
  durability_evidence_construction: BmcFanDurabilityEvidenceConstruction?,
  durability_evidence: List<BmcFanDurabilityEvidence>,
) -> UpsertClassification<BmcFanPolicyApplyPlan> {
  bmc_fan_policy_durability_gated_convergence(
    host: host,
    observed: observed,
    desired_curve: desired_curve,
    projection: projection,
    durability_gate: bmc_fan_policy_durability_gate(
      intent: intent,
      host: host,
      projection: projection,
      durability_generation: durability_generation,
      durability_evidence_construction: durability_evidence_construction,
      durability_evidence: durability_evidence,
    ),
  )
}

// The fan realizer needs a firmware-matched projection (its config bytes and digest are
// firmware-version-specific). It does NOT require the fleet to pin a single firmware track: an
// unpinned firmware intent is admitted, and each host qualifies against a projection matching its
// observed firmware (bmc_fan_policy_apply_suitability rejects a mismatch). What is refused is a
// PINNED track the host has not yet converged to (FanPolicyFirmwareMustConvergeBeforeRealizer) -- a
// firmware update would replace the flash and wipe the fan config, so fans must not be realized
// until it lands. Unpinned means no update is intended, so realization is safe.

fn bmc_fan_firmware_blocks_realizer(
  intent_firmware: BmcFirmwareIntent,
  observed_firmware: BmcFirmwareVersion,
) -> Bool {
  match intent_firmware {
    BmcFirmwareUnpinned => false
    BmcFirmwareTrackRequired { track: _ } =>
      match bmc_firmware_version_intent_verdict(
        firmware: observed_firmware,
        intent: intent_firmware,
      ) {
        BmcFirmwareIntentMismatch { required: _, observed: _ } => true
        BmcFirmwareIntentSatisfied => false
      }
  }
}

fn bmc_fan_policy_qualify_with_projection(
  standings: List<HostBmcFanAlignmentStanding>,
  host: HostIdentity,
  board: BaseboardModel,
  intent: BmcControlPlaneIntent,
  observed: BmcFanPolicyObservation,
  persistence: BmcConfigPersistenceObservation?,
  projection: BmcFanPolicyProjectionCapability?,
  durability_generation: StatePerturbationGeneration,
  durability_evidence_construction: BmcFanDurabilityEvidenceConstruction?,
  durability_evidence: List<BmcFanDurabilityEvidence>,
) -> UpsertClassification<BmcFanPolicyApplyPlan> {
  let desired = intent.fan_policy.curve
  match projection {
                Absent =>
                  UpsertClassification {
                    verdict: UnknownRefused,
                    decision: Refuse {
                      reason: "bmc fan state cannot converge without an exact board-and-firmware projection for both curve and installed-tach topology",
                    },
                  }
                Present { value: projector } =>
                  match bmc_fan_policy_apply_suitability(
                    standings: standings,
                    host: host,
                    board: board,
                    intent: intent,
                    observation: observed,
                    persistence: persistence,
                    projection: projector,
                  ) {
                    FanPolicySuitabilityRefused { cause: cause } =>
                      UpsertClassification {
                        verdict: UnknownRefused,
                        decision: Refuse {
                          reason: bmc_fan_policy_suitability_refusal_reason(
                            cause: cause,
                          ),
                        },
                      }
                    FanPolicySuitable =>
                      match bmc_fan_policy_drift_assessment(
                        desired_curve: desired,
                        observation: observed,
                        projection: projector,
                      ) {
                        BmcFanPolicyDrifted { cause: _ } =>
                          bmc_fan_policy_ordinary_convergence(
                            host: host,
                            observation: observed,
                            desired_curve: desired,
                            projection: projector,
                          )
                        BmcFanPolicyConverged =>
                        match durability_evidence_construction {
                          Present {
                            value: BmcFanDurabilityEvidenceConstructionRefused { cause: cause },
                          } =>
                            UpsertClassification {
                              verdict: UnknownRefused,
                              decision: Refuse {
                                reason: concat(
                                  "bmc fan durability evidence construction refused: ",
                                  bmc_fan_durability_evidence_construction_refusal_reason(
                                    cause: cause,
                                  ),
                                ),
                              },
                            }
                          Present {
                            value: BmcFanDurabilityEvidenceBuilt { evidence: _ },
                          } =>
                            bmc_fan_policy_durability_gated_convergence_from_inputs(
                              intent: intent,
                              host: host,
                              observed: observed,
                              desired_curve: desired,
                              projection: projector,
                              durability_generation: durability_generation,
                              durability_evidence_construction: durability_evidence_construction,
                              durability_evidence: durability_evidence,
                            )
                          Absent =>
                            bmc_fan_policy_durability_gated_convergence_from_inputs(
                              intent: intent,
                              host: host,
                              observed: observed,
                              desired_curve: desired,
                              projection: projector,
                              durability_generation: durability_generation,
                              durability_evidence_construction: durability_evidence_construction,
                              durability_evidence: durability_evidence,
                            )
                        }
                      }
                  }
              }
}

// THE ROSTER IS A PARAMETER HERE AND CLOSED AT THE WET EDGE, a correction to where the closure was
// first put. Closing it inside the projection seam meant every fixture exercising a DOWNSTREAM
// distinction -- durability linkage, topology drift, live digest -- was answered by the alignment
// gate instead, because srv4's real standing refuses. Nine such tests went red, and rightly: the
// pipeline's order had changed under them and they could no longer reach their subject.
//
// A confinement belongs at the boundary where production enters, not mid-pipeline where it also
// excludes every fixture. bmc_fan_converge_with_credential and bmc_fan_observe_only_with_credential
// pass the fleet roster and take no roster argument; a fixture supplies its own and reaches the arm
// it is testing.
fn bmc_fan_policy_classification(
  standings: List<HostBmcFanAlignmentStanding>,
  host: HostIdentity,
  board: BaseboardModel,
  intent: BmcControlPlaneIntent,
  observation: BmcFanPolicyObservation?,
  persistence: BmcConfigPersistenceObservation?,
  projection: BmcFanPolicyProjectionCapability?,
  durability_generation: StatePerturbationGeneration,
  durability_evidence_construction: BmcFanDurabilityEvidenceConstruction?,
  durability_evidence: List<BmcFanDurabilityEvidence>,
) -> UpsertClassification<BmcFanPolicyApplyPlan> {
  match observation {
    Absent =>
      UpsertClassification {
        verdict: UnknownRefused,
        decision: Refuse {
          reason: "bmc fan-policy observation absent; Redfish InitialDuty is not curve evidence",
        },
      }
    Present { value: observed } =>
      if bmc_fan_firmware_blocks_realizer(
        intent_firmware: intent.firmware,
        observed_firmware: observed.firmware,
      ) {
        UpsertClassification {
          verdict: Conflict,
          decision: Refuse {
            reason: bmc_fan_policy_suitability_refusal_reason(
              cause: FanPolicyFirmwareMustConvergeBeforeRealizer,
            ),
          },
        }
      } else {
        bmc_fan_policy_qualify_with_projection(
          standings: standings,
          host: host,
          board: board,
          intent: intent,
          observed: observed,
          persistence: persistence,
          projection: projection,
          durability_generation: durability_generation,
          durability_evidence_construction: durability_evidence_construction,
          durability_evidence: durability_evidence,
        )
      }
  }
}
