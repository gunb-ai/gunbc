module gunbc.bmc_fan_program_observation_witness

import std.types { Bool }
import extdeps.filesystem.filesystem_io { Filesystem }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.types { String }
import gunbc.bmc_fan_program_capture { srv3_captured_program, srv4_captured_program }
import gunbc.bmc_fan_program_observation {
  ArtifactByteCountDisagrees,
  ArtifactJsonValueObserved,
  ArtifactNotParseable,
  json_value_observation_is_idempotent,
  observe_artifact_content,
  observe_captured_program,
  srv3_program_json,
  srv4_program_json,
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// EXECUTED DIRECTLY, NOT ENROLLED. This witness reads the committed artifacts, so today's floor
// planner declines it by file before the interpreter classifies the effect. It is run by hand
// through the ordinary interpreter and is NOT required-floor coverage; see the parent module for
// why that distinction is stated rather than assumed, and why the remedy is gunbc#9106 rather than
// a new admission bridge.
//
// THE POSITIVE ARM ALONE WOULD BE NEARLY CONTENTLESS, so both refusals are exercised against the
// real files. A byte count that disagrees and a path that is not a JSON document must each produce
// their own arm, because the reason they fail decides who fixes them: a count mismatch means the
// committed artifact drifted from what the capture recorded, and an unparseable document means the
// bytes are not what this observer thinks they are at all.

// THE EXPECTED COUNTS ARE READ OFF THE CAPTURE, not retyped here. Asserting == 5212 in the witness
// would restore the defect the observation module just removed one level up: three copies of one
// number agreeing because one author typed them, with nothing joining any of them.
fn both_hosts_observe_and_round_trip() -> Bool {
  match srv3_program_json {
    ArtifactJsonValueObserved { artifact_path, byte_count, document } =>
      byte_count == srv3_captured_program.program.artifact_byte_count
    other => false
  }
    && match srv4_program_json {
      ArtifactJsonValueObserved { artifact_path, byte_count, document } =>
        byte_count == srv4_captured_program.program.artifact_byte_count
      other => false
    }
    && json_value_observation_is_idempotent(observation: srv3_program_json)
    && json_value_observation_is_idempotent(observation: srv4_program_json)
}

// THE COUNT IS THE READ'S SUCCESS TEST TOO, AND THIS IS ASSERTED AT BOTH GRAINS BECAUSE THEY ARE
// DIFFERENT CLAIMS. The kernel half says empty content refuses rather than parsing as an empty
// document. The route half says a path that does not exist actually PRODUCES empty content under
// this filesystem surface -- which is the fact the kernel half depends on and cannot establish,
// since `success` is not populated here and cannot be consulted.
fn an_empty_read_refuses_rather_than_parsing_empty() -> Bool {
  match observe_artifact_content(
    artifact_path: "artifacts/bmc/no-such-capture.json",
    content: "",
    expected_byte_count: 5212,
  ) {
    ArtifactByteCountDisagrees { artifact_path, expected, observed } =>
      expected == 5212 && observed == 0
    other => false
  }
}

fn a_missing_path_reads_as_empty_content() -> Bool {
  Filesystem.Read(path: "artifacts/bmc/no-such-capture.json").content.length() == 0
    && Filesystem.Read(path: "artifacts/bmc/srv3-config-asrr.json").content.length()
      == srv3_captured_program.program.artifact_byte_count
}

fn a_wrong_expected_count_refuses() -> Bool {
  match observe_artifact_content(
    artifact_path: "artifacts/bmc/srv3-config-asrr.json",
    content: "{}",
    expected_byte_count: 5211,
  ) {
    ArtifactByteCountDisagrees { artifact_path, expected, observed } =>
      expected == 5211 && observed == 2
    other => false
  }
}

// THE NOT-PARSEABLE ARM, REACHED AT LAST. The previous control read DESIGN.md with an expected
// count of 0, so the byte-count comparison fired and returned BEFORE parsing was attempted -- the
// arm was unreachable from this witness while appearing to be tested. An inline malformed document
// whose length is stated correctly walks past the count check and into the parse.
fn a_malformed_document_refuses_at_the_parse() -> Bool {
  match observe_artifact_content(
    artifact_path: "fixture: malformed",
    content: "\{not json",
    expected_byte_count: 9,
  ) {
    ArtifactNotParseable { artifact_path } => artifact_path == "fixture: malformed"
    other => false
  }
}

// AND THE COUNT CHECK STILL FIRES FIRST when both are wrong, which is the ordering the missing-file
// case depends on: a file that is absent returns empty content, and empty must refuse as a count
// disagreement rather than reaching the parser at all.
fn the_count_check_precedes_the_parse() -> Bool {
  match observe_artifact_content(
    artifact_path: "fixture: malformed and short",
    content: "\{not json",
    expected_byte_count: 99,
  ) {
    ArtifactByteCountDisagrees { artifact_path, expected, observed } =>
      expected == 99 && observed == 9
    other => false
  }
}

fn bmc_fan_program_observation_witness() -> ProcessExit {
  if both_hosts_observe_and_round_trip()
    && an_empty_read_refuses_rather_than_parsing_empty()
    && a_missing_path_reads_as_empty_content()
    && a_wrong_expected_count_refuses()
    && a_malformed_document_refuses_at_the_parse()
    && the_count_check_precedes_the_parse() {
    ExitSuccess
  } else {
    exit_failure(
      reason: "BMC fan program syntax observation: the committed artifacts, their byte counts, semantic idempotence, or a refusal arm changed",
    )
  }
}
