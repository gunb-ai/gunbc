module gunbc.bmc.megarac_media

import std.types { Bool, Int, List, NonEmptyStr, String }
import extdeps.languages.json.parse { JsonValue }
import gunbc.bmc.megarac_session { MegaRacSession, MegaRacSessionScope }
import extdeps.bmc.megarac { MegaRacImageRedirectionOn, megarac_image_redirection_wire }
import gunbc.bmc.megarac_http_realization { json_number_member, json_string_member, megarac_start_body }

// THE MEDIA STATE MACHINE, over an acquired session. It sits beside the session fold rather than
// inside the extdeps module for the same reason the session fold does: what this asks the
// controller is the cited API's shape, but WHICH reads it trusts, and in what order, is a
// consequence of what one build was measured doing -- recorded in
// gunbc.bmc.megarac_observed_behavior.
// ─────────────────────────────────────────────────────────────────────────────────────────────────
// REMOTE MEDIA, OVER AN ACQUIRED SESSION
// ─────────────────────────────────────────────────────────────────────────────────────────────────

// THERE IS NO REFUSED ARM FOR THE START, AND ITS ABSENCE IS THE POINT. The previous version returned
// MegaRacStartRefused whenever start-media exited non-zero and the configurations did not yet name
// the image -- while its own prose said that exact combination is PENDING. This firmware answers
// HTTP 500 on writes that take effect (measured twice: PUT media/general code 16425 with the share
// re-mounting anyway, stop-media code 1411 with the following attach succeeding), and the session
// work in this module has now confirmed the same for DELETE. A terminal refusal derived from that
// status is a fabricated negative, and the specific harm is that it invites a caller to retry a
// write whose effect is already underway.
//
// SO THE STATUS BECOMES EVIDENCE, NOT A VERDICT. It rides inside the indeterminate arm for a human
// to read; nothing branches on it. What decides is the read-back, and when the read-back does not
// yet confirm, the honest answer is that the outcome is unknown.
//
// MegaRacPresentationUnreadable EXISTS SO NO WRITE FOLLOWS AN UNREADABLE READ. Previously a
// malformed configurations body folded to an empty row list, which is indistinguishable from "not
// attached", after which the code issued start-media. That is a write chosen on the basis of a state
// nobody could read.
type MegaRacAttachOutcome
  = MegaRacAlreadyPresented { image_name: NonEmptyStr }
  | MegaRacAttached { image_name: NonEmptyStr, image_index: String }
  | MegaRacPresentationUnreadable { detail: String }
  | MegaRacImagesUnreadable { detail: String }
  | MegaRacImageListingUnparseable { detail: String }
  | MegaRacImageListingEmpty
  | MegaRacImageNotEnumerated { image_name: NonEmptyStr }
  | MegaRacImageAmbiguous { image_name: NonEmptyStr, occurrences: Int }
  | MegaRacAttachIndeterminate { image_name: NonEmptyStr, transport_completed: Bool, evidence: String }

fn megarac_json_elements(body: String) -> List<JsonValue>? {
  match parse_json_document(s: body) {
    JsonDocumentUnreadable { gap: _ } => none
    JsonDocumentParsed { value: v } =>
      match v {
        JsonArray { elements: es } => Present { value: es }
        _ => none
      }
  }
}

// PRESENTING IS DECIDED BY THE VALUES ACTUALLY OBSERVED, not by a nonzero test. The previous form
// read any redirection_status other than "0" as active, which promotes an entire unread value space
// to "this image is presented" -- an inference about codes nobody has seen, in the predicate that
// decides whether a host's boot medium is already in place. The two presenting values measured on
// this build are 1 and 100 (gunbc.bmc.megarac_observed_behavior
// megarac_redirection_status_observed_values); anything else refuses, which sends a caller to look
// at the controller rather than proceeding on a guess.
//
// THE INDEX IS DELIBERATELY NOT COMPARED against the configurations row. An earlier check read
// image_index there, which is absent, so every genuine attachment reported unconfirmed -- caught
// only because the check failed closed. Re-reading it as media_index passed and was still wrong:
// media_index is the virtual CD DEVICE SLOT, beside session_index, not a position in the image
// enumeration. It agreed with the resolved image_index only because this unit presents a single CD
// device, so both are 0. Joining them is nicknaming, and it would begin refusing on any controller
// offering a second slot while blaming the image.
// A ROW IS READ AT ROW GRAIN, AND AN UNREADABLE ROW REFUSES. The previous predicate answered Bool,
// so a row missing image_name, carrying a wrong-typed media_type, or holding an unrecognised
// redirection_status all folded to `false` -- indistinguishable from "this image is not presented",
// after which the caller proceeded to write. That is the same defect the document-grain refusal
// closed, one level down: the top-level array was protected while every row inside it could still
// turn "I cannot read this" into "there is nothing here".
type MegaRacRowReading
  = MegaRacRowPresentsImage
  | MegaRacRowPresentsOther
  | MegaRacRowUnreadable { detail: String }

fn megarac_row_reading(row: JsonValue, image_name: NonEmptyStr) -> MegaRacRowReading {
  match json_string_member(doc: row, key: "image_name") {
    Absent => MegaRacRowUnreadable { detail: "a presented-media row carries no image_name" }
    Present { value: n } =>
      if n == (image_name as String) {
        megarac_row_activity(row: row)
      } else {
        MegaRacRowPresentsOther
      }
  }
}

// PRESENTING IS DECIDED BY THE VALUES ACTUALLY OBSERVED, not by a nonzero test. The previous form
// read any redirection_status other than "0" as active, which promotes an entire unread value space
// to "this image is presented" -- an inference about codes nobody has seen, inside the predicate
// deciding whether a host's boot medium is already in place. The two presenting values measured on
// this build are 1 and 100 (gunbc.bmc.megarac_observed_behavior
// megarac_redirection_status_observed_values); 0 was never seen on a presenting row. Anything else
// is unreadable and refuses, which sends a caller to look at the controller rather than proceed on
// a guess.
fn megarac_row_activity(row: JsonValue) -> MegaRacRowReading {
  match json_number_member(doc: row, key: "media_type") {
    Absent => MegaRacRowUnreadable { detail: "the row naming this image carries no media_type" }
    Present { value: mt } =>
      if mt != "1" {
        MegaRacRowUnreadable { detail: concat("the row naming this image is media_type ", mt, ", not the CD media this operation attaches") }
      } else {
        match json_number_member(doc: row, key: "redirection_status") {
          Absent => MegaRacRowUnreadable { detail: "the row naming this image carries no redirection_status" }
          Present { value: st } =>
            if (st == "1") || (st == "100") {
              MegaRacRowPresentsImage
            } else {
              if st == "0" {
                MegaRacRowPresentsOther
              } else {
                MegaRacRowUnreadable { detail: concat("the row naming this image carries redirection_status ", st, ", which is outside the values observed on this build (0 not presenting; 1 and 100 presenting)") }
              }
            }
        }
      }
  }
}

type MegaRacPresentationReading
  = MegaRacImagePresented
  | MegaRacImageNotPresented
  | MegaRacPresentationRowUnreadable { detail: String }

// ONE UNREADABLE ROW REFUSES THE WHOLE READING, rather than being skipped so the others can answer.
// A row this fold cannot interpret may BE the image, described in a way it does not understand, and
// skipping it would let an unreadable presentation become a write.
fn megarac_presentation_reading(rows: List<JsonValue>, image_name: NonEmptyStr) -> MegaRacPresentationReading {
  fold(rows, init: MegaRacImageNotPresented, f: (acc, row) =>
    match acc {
      MegaRacPresentationRowUnreadable { detail: _ } => acc
      _ =>
        match megarac_row_reading(row: row, image_name: image_name) {
          MegaRacRowUnreadable { detail: d } => MegaRacPresentationRowUnreadable { detail: d }
          MegaRacRowPresentsImage => MegaRacImagePresented
          MegaRacRowPresentsOther => acc
        }
    }
  )
}

// TWO ROWS NAMING ONE IMAGE IS AMBIGUITY, NOT A CHOICE. The previous fold kept the first match and
// attached it. If a controller enumerates one name twice, the two rows have different indices and
// nothing here can say which file either denotes -- so picking one is a coin flip that selects a
// boot medium. This has never been observed on this build; it refuses rather than being handled,
// because a silent policy for an unobserved state is how a wrong boot happens once and is never
// explained.
type MegaRacIndexLookup
  = MegaRacIndexResolved { image_index: String }
  | MegaRacIndexAbsent
  | MegaRacIndexAmbiguous { occurrences: Int }
  | MegaRacIndexRowUnreadable { detail: String }

fn megarac_named_rows(elements: List<JsonValue>, image_name: String) -> List<JsonValue> {
  elements |> filter(e =>
    match json_string_member(doc: e, key: "image_name") {
      Absent => false
      Present { value: n } => n == image_name
    }
  )
}

fn megarac_index_of_named(elements: List<JsonValue>, image_name: String) -> MegaRacIndexLookup {
  let matches = megarac_named_rows(elements: elements, image_name: image_name)
  let n = matches |> count
  if n == 0 {
    MegaRacIndexAbsent
  } else {
    if n > 1 {
      MegaRacIndexAmbiguous { occurrences: n }
    } else {
      match get(xs: matches, index: 0) {
        Absent => MegaRacIndexRowUnreadable { detail: "the single matching row could not be read back" }
        Present { value: row } =>
          match json_number_member(doc: row, key: "image_index") {
            Absent => MegaRacIndexRowUnreadable { detail: "the row naming this image carries no image_index" }
            Present { value: idx } => MegaRacIndexResolved { image_index: idx }
          }
      }
    }
  }
}

func megarac_attach_image(session: MegaRacSession, image_name: NonEmptyStr) -> MegaRacAttachOutcome
  uses net: std.resources.Network
{
  presented = megarac.Media.Configurations(
    bmc_host: session.scope.bmc_host,
    cookie_jar: session.scope.cookie_jar,
    csrf_token: session.csrf_token,
  )
  if presented.success == false {
    return MegaRacPresentationUnreadable { detail: "the presented-media listing could not be read, so whether anything is attached is unknown; refusing to write over an unknown state" }
  }
  match megarac_json_elements(body: presented.body) {
    Absent =>
      return MegaRacPresentationUnreadable { detail: concat("the presented-media listing was not a JSON array: ", presented.body) }
    Present { value: rows } =>
      match megarac_presentation_reading(rows: rows, image_name: image_name) {
        MegaRacPresentationRowUnreadable { detail: d } =>
          return MegaRacPresentationUnreadable { detail: concat("a presented-media row could not be read, so whether this image is already attached is unknown: ", d) }
        MegaRacImagePresented => return MegaRacAlreadyPresented { image_name: image_name }
        MegaRacImageNotPresented => return megarac_resolve_then_start(session: session, image_name: image_name)
      }
  }
}

// REACHABLE ONLY WHEN THE PRESENTED SET WAS READ AND DID NOT CONTAIN THE IMAGE, which is what keeps
// the write behind a successful read rather than merely after one.
func megarac_resolve_then_start(session: MegaRacSession, image_name: NonEmptyStr) -> MegaRacAttachOutcome
  uses net: std.resources.Network
{
  images = megarac.Media.Images(
    bmc_host: session.scope.bmc_host,
    cookie_jar: session.scope.cookie_jar,
    csrf_token: session.csrf_token,
  )
  if images.success == false {
    return MegaRacImagesUnreadable { detail: "the available-image listing could not be read" }
  }
  match megarac_json_elements(body: images.body) {
    Absent => return MegaRacImageListingUnparseable { detail: images.body }
    Present { value: elements } =>
      if (elements |> count) == 0 {
        return MegaRacImageListingEmpty
      } else {
        match megarac_index_of_named(elements: elements, image_name: image_name as String) {
          MegaRacIndexAbsent => return MegaRacImageNotEnumerated { image_name: image_name }
          MegaRacIndexAmbiguous { occurrences: n } =>
            return MegaRacImageAmbiguous { image_name: image_name, occurrences: n }
          MegaRacIndexRowUnreadable { detail: d } =>
            return MegaRacImageListingUnparseable { detail: d }
          MegaRacIndexResolved { image_index: idx } =>
            return megarac_start_then_confirm(session: session, image_name: image_name, image_index: idx)
        }
      }
  }
}

func megarac_start_then_confirm(
  session: MegaRacSession,
  image_name: NonEmptyStr,
  image_index: String,
) -> MegaRacAttachOutcome
  uses net: std.resources.Network
{
  started = megarac.Media.Start(
    bmc_host: session.scope.bmc_host,
    cookie_jar: session.scope.cookie_jar,
    csrf_token: session.csrf_token,
    json_body: megarac_start_body(image_name: image_name, image_index: image_index),
  )

  confirmed = megarac.Media.Configurations(
    bmc_host: session.scope.bmc_host,
    cookie_jar: session.scope.cookie_jar,
    csrf_token: session.csrf_token,
  )
  if confirmed.success == false {
    return MegaRacAttachIndeterminate {
      image_name: image_name,
      transport_completed: started.success,
      evidence: "start-media was issued and the confirming read could not be taken",
    }
  }
  match megarac_json_elements(body: confirmed.body) {
    Absent =>
      return MegaRacAttachIndeterminate {
        image_name: image_name,
        transport_completed: started.success,
        evidence: concat("start-media was issued and the confirming listing was unreadable: ", confirmed.body),
      }
    Present { value: rows } =>
      match megarac_presentation_reading(rows: rows, image_name: image_name) {
        MegaRacImagePresented =>
          return MegaRacAttached { image_name: image_name, image_index: image_index }
        _ =>
          return MegaRacAttachIndeterminate {
          image_name: image_name,
          transport_completed: started.success,
          evidence: concat("start-media was issued and the image is not yet presented; the mount daemon is asynchronous so this may still be settling. start body: ", started.body, " | configurations: ", confirmed.body),
        }
      }
  }
}
