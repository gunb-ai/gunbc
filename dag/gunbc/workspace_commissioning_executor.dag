module gunbc.workspace_commissioning_executor

import std.types { String, Bool }
import v2.std.orchestration { Pipeline, FailFast }
import v2.workflow.orchestration_bash_emit_support { orch_bash_do, orch_bash_emit_pipeline }


// Native transport only. The installed helper is a reviewed root-owned artifact, not a browser
// or workflow supplied command. prepare must durably bind the reviewed plan, fleet generation,
// mutation lease, submitting systemd invocation and prior slot invocation BEFORE returning start.
// On uncertain prior submission it must refuse or recover that submission, never return start.
// settle/complete are permitted only from recorded post-readback obligations; they skip the
// old controller wait because the slot may already have been legitimately reused. The helper
// must verify the durable release/generation receipts, not reconstruct them from live guest state.
// The controller claims its invocation in the journal before any commissioning effect. After
// it exits, bind confirms that invocation (or records a controller that failed before claiming).
// This ordering keeps the controller and bind interpreter out of the same bounded slice at once.
// finish owns strong readback, credential removal,
// mutation settlement and generation publication (including recovery after publication).
// None of these helpers is called in the waiting loop. The systemd-owned executor retains the
// existing fleet flock even when the workflow disconnects. Failure NEVER releases the durable
// mutation guard; the next prepare must discharge the prior actor/job recovery obligations.
// This transport is not installed until those production helper and unit authorities are wired.
// The poll-count authority also bounds each lock/helper wait in seconds. Helper timeout kills
// its process group after a five-second grace; failure closes the flock without settling the journal.
// These are per-operation bounds, not a single wall-clock deadline for the entire transaction.
// argv: installed helper, exact slot unit, existing fleet lock, bounded poll count, systemctl.
// The last argument permits an executable boundary double in controls; production installation
// must derive it from the existing systemctl tool authority. No eval/source of helper output.
data workspace_executor_admit_transport: String = join([
  "set -euo pipefail",
  "umask 077",
  "[[ $# == 5 ]] || exit 64",
  "executor_helper=$1",
  "executor_unit=$2",
  "executor_lock=$3",
  "executor_polls=$4",
  "executor_systemctl=$5",
  "[[ $executor_helper == /* && $executor_lock == /* && $executor_systemctl == /* ]] || exit 64",
  "[[ $executor_polls =~ ^[1-9][0-9]\{0,4}$ ]] || exit 64",
  "[[ $\{INVOCATION_ID:-} =~ ^[a-f0-9]\{32}$ ]] || exit 64",
  "exec 9< \"$executor_lock\"",
  "flock -w \"$executor_polls\" -x 9 || exit 70",
  "executor_decision=$(timeout --kill-after=5s \"$\{executor_polls}s\" \"$executor_helper\" prepare \"$INVOCATION_ID\")",
  "[[ $executor_decision =~ ^(start|wait|settle|complete|drain):([a-f0-9]\{32}|none)$ ]] || exit 65",
  "executor_action=$\{executor_decision%%:*}",
  "executor_expected=$\{executor_decision#*:}",
], "\n")

data workspace_executor_read_systemd: String = join([
  "executor_observe() \{",
  "  local output key value",
  "  output=$(timeout --kill-after=5s 30s \"$executor_systemctl\" show \"$executor_unit\" --property=Id --property=LoadState --property=ActiveState --property=MainPID --property=InvocationID --property=Job) || return 1",
  "  local -A fields=()",
  "  while IFS='=' read -r key value; do",
  "    [[ -n $key && ! -v fields[$key] ]] || return 1",
  "    case $key in Id|LoadState|ActiveState|MainPID|InvocationID|Job) fields[$key]=$value ;; *) return 1 ;; esac",
  "  done <<< \"$output\"",
  "  [[ $\{#fields[@]} == 6 ]] || return 1",
  "  [[ $\{fields[Id]} == \"$executor_unit\" && $\{fields[LoadState]} == loaded ]] || return 1",
  "  executor_seen=$\{fields[InvocationID]}",
  "  executor_active=$\{fields[ActiveState]}",
  "  executor_pid=$\{fields[MainPID]}",
  "  executor_job=$\{fields[Job]}",
  "}",
], "\n")

// The protected journal fence precedes StopUnit. A controller that already won CAS is never
// stopped by this branch. Blocking stop replaces conflicting pending jobs; the rearm helper
// independently reobserves quiescence and fresh admission before publishing a new submitter.
data workspace_executor_drain_submission: String = join([
  "if [[ $executor_action == drain ]]; then",
  "  timeout --kill-after=5s \"$\{executor_polls}s\" \"$executor_systemctl\" stop \"$executor_unit\"",
  "  executor_observe || exit 66",
  "  [[ $executor_active == inactive || $executor_active == failed ]] || exit 67",
  "  [[ $executor_pid == 0 && -z $executor_job ]] || exit 67",
  "  executor_decision=$(timeout --kill-after=5s \"$\{executor_polls}s\" \"$executor_helper\" rearm \"$INVOCATION_ID\")",
  "  [[ $executor_decision =~ ^start:([a-f0-9]\{32}|none)$ ]] || exit 65",
  "  executor_action=start",
  "  executor_expected=$\{executor_decision#*:}",
  "fi",
], "\n")

data workspace_executor_submit_once: String = join([
  "if [[ $executor_action == start ]]; then",
  "  executor_observe || exit 66",
  "  [[ $\{executor_seen:-none} == \"$executor_expected\" ]] || exit 67",
  "  [[ $executor_active == inactive || $executor_active == failed ]] || exit 67",
  "  [[ $executor_pid == 0 && -z $executor_job ]] || exit 67",
  "  timeout --kill-after=5s 30s \"$executor_systemctl\" start \"$executor_unit\"",
  "  executor_observe || exit 66",
  "  [[ $executor_seen =~ ^[a-f0-9]\{32}$ && $executor_seen != \"$executor_expected\" ]] || exit 67",
  "  executor_expected=$executor_seen",
  "fi",
], "\n")

data workspace_executor_await_invocation: String = join([
  "[[ $executor_expected =~ ^[a-f0-9]\{32}$ ]] || exit 65",
  "if [[ $executor_action == start || $executor_action == wait ]]; then",
  "executor_terminated=false",
  "for ((executor_poll=0; executor_poll<executor_polls; executor_poll++)); do",
  "  executor_observe || exit 66",
  "  [[ $executor_seen == \"$executor_expected\" ]] || exit 67",
  "  if [[ $executor_active == inactive || $executor_active == failed ]]; then",
  "    [[ $executor_pid == 0 && -z $executor_job ]] || exit 67",
  "    executor_observe || exit 66",
  "    [[ $executor_seen == \"$executor_expected\" && $executor_pid == 0 && -z $executor_job ]] || exit 67",
  "    [[ $executor_active == inactive || $executor_active == failed ]] || exit 67",
  "    executor_terminated=true",
  "    break",
  "  fi",
  "  [[ $executor_active == active || $executor_active == activating || $executor_active == deactivating ]] || exit 67",
  "  sleep 1",
  "done",
  "[[ $executor_terminated == true ]] || exit 68",
  "fi",
], "\n")

data workspace_executor_settle: String = join([
  "executor_terminal=$(timeout --kill-after=5s \"$\{executor_polls}s\" \"$executor_helper\" finish \"$INVOCATION_ID\" \"$executor_expected\")",
  "[[ $executor_terminal == 'commissioning-fleet-generation-committed' ]] || exit 69",
  "printf '%s\\n' \"$executor_terminal\"",
], "\n")

// The bounded wait already proved this exact invocation quiescent. bind independently rereads
// systemd and the held mutation, so replacement between the wait and this helper still refuses.
// A disconnected submitter retains the same unbound-submission fence/drain recovery obligation.
data workspace_executor_bind_completed_invocation: String = join([
  "if [[ $executor_action == start ]]; then",
  "  timeout --kill-after=5s \"$\{executor_polls}s\" \"$executor_helper\" bind \"$INVOCATION_ID\" \"$executor_expected\"",
  "fi",
], "\n")

// The interpreter emits the transport once when building the reviewed artifact, not while
// waiting on a host. Foreign command leaves contain transport mechanics only; no readiness,
// reservation, provenance or fleet-generation policy is implemented in these Bash commands.
fn workspace_commissioning_executor_script() -> String {
  orch_bash_emit_pipeline(p: Pipeline {
    steps: [
      orch_bash_do(command: workspace_executor_admit_transport),
      orch_bash_do(command: workspace_executor_read_systemd),
      orch_bash_do(command: workspace_executor_drain_submission),
      orch_bash_do(command: workspace_executor_submit_once),
      orch_bash_do(command: workspace_executor_await_invocation),
      orch_bash_do(command: workspace_executor_bind_completed_invocation),
      orch_bash_do(command: workspace_executor_settle),
    ],
    on_failure: FailFast,
  }, refused_poison: "__WORKSPACE_EXECUTOR_EMISSION_REFUSED__")
}


fn workspace_executor_terminal_admitted(text: String) -> Bool {
  text == "commissioning-fleet-generation-committed"
}
