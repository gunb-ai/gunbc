module gunbc.membership_reconcile

import std.types { String, List, Bool, Int }
import std.keyed_row { KeyedRow }
import std.key_relation {
  KeyRelation,
  ScopedKey,
  key_relation_scoped_key,
  key_relation_scoped_key_eq,
}
import std.change {
  KeyedPatch, KeyedDiffHunk,
  KeyedDiffAddedHunk, KeyedDiffRemovedHunk, KeyedDiffModifiedHunk,
  keyed_patch_monoid,
}
import gunbc.ownership { Ownership, Owned, Ensured }
import std.disposition { Disposition, Scaffold, RealizationDispatch }
import std.decl_ref { DeclarationRef, WholeDeclaration }

type TeardownRefusalCause = MemberNotOwned | OwnershipUnknown

type MemberAction<M>
  = MemberAdded { to: M }
  | MemberChanged { from: M, to: M }
  | MemberRemoved { from: M }
  | MemberRemovalRefused { from: M, cause: TeardownRefusalCause }

type MembershipPlan<M> {
  actions: List<MemberAction<M>>
}

type MemberEffect<M>
  = EffectAdd { to: M }
  | EffectReplace { from: M, to: M }
  | EffectRemove { from: M }

type MemberRefusal<M> {
  member: M
  cause: TeardownRefusalCause
}

type EffectsOrRefusal<M>
  = EffectsReady { effects: List<MemberEffect<M>> }
  | ApplyRefused { refusals: List<MemberRefusal<M>> }

data membership_reconcile_authority_note: String = "THE grain-agnostic membership-diff reconcile (R2/R3/R5/R9). Desired set vs observed set keyed by member identity under a DECLARED KeyRelation (std.key_relation) — naming the relation, NOT enforcing that key_of returns identity rather than content (std.key_relation key_relation_authority_note; the wall is a declared next-rung trigger, not this PR): Added -> add, Modified -> change, Removed -> remove (owned-only) or refuse, Unchanged -> noop (absence of a hunk). Add and change are DISTINCT arms and are NOT collapsed into one 'upsert': an add creates where nothing was, a change carries BOTH sides of a surviving occurrence. Only REMOVAL consults ownership, and that asymmetry is deliberate rather than an oversight — gunbc.ownership defines Ensured as 'requires present but does NOT own (never torn down)', a constraint on removal specifically. Converging a drifted member the model does not own is the intended behavior of an Ensured member, not a violation of it: tool_readiness exists precisely to re-install a pin whose observed version drifted from desired, and refusing that would break the module rather than protect anything. Generic over member type M, scope S, and key K: a member may be a service/unit/host OR a Session — consumers NAME their KeyRelation bundle, they NEVER copy-adapt this fn (one fn, N relations — a Realization; a forked reconcile means the genericity bought nothing). Reuses std.change keyed patch machinery but keys rows as std.key_relation ScopedKey (scope+key projected together via key_relation_scoped_key; equality via key_relation_scoped_key_eq) — an unscoped key_of at this seam is unwritable. R5 removal-owned-only is a CONSTRUCTION WALL: a Removed non-owned member yields MemberRemovalRefused, which has NO effect arm in any apply dispatch, so the bad state is unwritable — never a post-check, never 'assume owned' (the absorbing fallback DESIGN §5 forbids). Consumers SHOULD declare key_fiber_unique_per_scope (via key_relation_global) on relations intended for this seam; many-subjects-per-key populations belong on a different keyed lookup surface (JSON member lookup is the cited precedent), not membership_reconcile."

fn member_rows<M, Relation, Scope, K>(
  members: List<M>,
  relation: KeyRelation<Relation, M, Scope, K>,
) -> List<KeyedRow<ScopedKey<Relation, Scope, K>, M>> {
  map(members, m =>
    KeyedRow {
      row_key: key_relation_scoped_key(relation: relation, subject: m),
      value: m,
    }
  )
}

fn membership_scoped_row_find<M, Relation, Scope, K>(
  rows: List<KeyedRow<ScopedKey<Relation, Scope, K>, M>>,
  wanted_key: ScopedKey<Relation, Scope, K>,
  relation: KeyRelation<Relation, M, Scope, K>,
) -> KeyedRow<ScopedKey<Relation, Scope, K>, M>? {
  fold(rows, init: none, f: fn(acc, row) {
    if key_relation_scoped_key_eq(relation: relation, a: row.row_key, b: wanted_key) {
      Present { value: row }
    } else {
      acc
    }
  })
}

fn membership_scoped_union_keys<M, Relation, Scope, K>(
  left: List<KeyedRow<ScopedKey<Relation, Scope, K>, M>>,
  right: List<KeyedRow<ScopedKey<Relation, Scope, K>, M>>,
  relation: KeyRelation<Relation, M, Scope, K>,
) -> List<ScopedKey<Relation, Scope, K>> {
  reverse(fold(concat(left, right), init: [], f: fn(acc, row) {
    if fold(acc, init: false, f: fn(found, k) {
      found || key_relation_scoped_key_eq(relation: relation, a: k, b: row.row_key)
    }) {
      acc
    } else {
      concat([row.row_key], acc)
    }
  }))
}

fn membership_scoped_two_way_row<M, Relation, Scope, K>(
  wanted_key: ScopedKey<Relation, Scope, K>,
  left: List<KeyedRow<ScopedKey<Relation, Scope, K>, M>>,
  right: List<KeyedRow<ScopedKey<Relation, Scope, K>, M>>,
  relation: KeyRelation<Relation, M, Scope, K>,
  value_eq: fn(M, M) -> Bool,
) -> KeyedDiffHunk<ScopedKey<Relation, Scope, K>, M>? {
  let l = membership_scoped_row_find(rows: left, wanted_key: wanted_key, relation: relation)
  let r = membership_scoped_row_find(rows: right, wanted_key: wanted_key, relation: relation)
  match l {
    Present { value: lr } => match r {
      Present { value: rr } =>
        if value_eq(lr.value, rr.value) {
          none
        } else {
          Present {
            value: KeyedDiffModifiedHunk {
              hunk_key: wanted_key,
              from: lr.value,
              to: rr.value,
            }
          }
        }
      Absent =>
        Present {
          value: KeyedDiffRemovedHunk {
            hunk_key: wanted_key,
            from: lr.value,
          }
        }
    }
    Absent => match r {
      Present { value: rr } =>
        Present {
          value: KeyedDiffAddedHunk {
            hunk_key: wanted_key,
            to: rr.value,
          }
        }
      Absent => none
    }
  }
}

fn membership_scoped_two_way_diff<M, Relation, Scope, K>(
  left: List<KeyedRow<ScopedKey<Relation, Scope, K>, M>>,
  right: List<KeyedRow<ScopedKey<Relation, Scope, K>, M>>,
  relation: KeyRelation<Relation, M, Scope, K>,
  value_eq: fn(M, M) -> Bool,
) -> KeyedPatch<ScopedKey<Relation, Scope, K>, M> {
  let keys = membership_scoped_union_keys(left: left, right: right, relation: relation)
  let monoid = keyed_patch_monoid()
  fold(keys, init: monoid.identity, f: fn(acc, wanted_key) {
    match membership_scoped_two_way_row(
      wanted_key: wanted_key,
      left: left,
      right: right,
      relation: relation,
      value_eq: value_eq,
    ) {
      Present { value: hunk } => monoid.op(acc, KeyedPatch { hunks: [hunk] })
      Absent => acc
    }
  })
}

data member_changed_both_sides_note: String = "WHY MemberChanged carries `from` as well as `to`. The prior shape collapsed a Modified hunk into an upsert of the `to` side and DISCARDED `from`, which is lossy in a load-bearing way rather than merely untidy: the prior value is what every safe realization of a change needs. An SCM ref update is a compare-and-swap that names the expected prior (git update-ref <ref> <new> <old>), so without `from` the only reachable realization is the unconditional write and the atomicity the capability already offers cannot be used. A host resource whose address moved must retire the prior endpoint, and `from` is the only place that endpoint survives. gunbc.change_realization is the table that consumes both sides. A NOTE ON WHAT THIS IS NOT: an earlier draft of this change also refused a Modified hunk whose `from` was not Owned, on the reading that replacement is destruction. That was withdrawn — it over-fires on every Ensured consumer and contradicts gunbc.ownership, where Ensured constrains teardown only. Ownership gates removal; it does not gate convergence."

type RemovalAdmission
  = RemovalAdmitted
  | RemovalRefused { cause: TeardownRefusalCause }

fn removal_admission<M>(existing: M, ownership_of: fn(M) -> Ownership?) -> RemovalAdmission {
  match ownership_of(existing) {
    Present { value: own } =>
      match own {
        Owned => RemovalAdmitted
        Ensured => RemovalRefused { cause: MemberNotOwned }
      }
    Absent => RemovalRefused { cause: OwnershipUnknown }
  }
}

fn hunk_to_action<M, Relation, Scope, K>(
  hunk: KeyedDiffHunk<ScopedKey<Relation, Scope, K>, M>,
  ownership_of: fn(M) -> Ownership?,
) -> MemberAction<M> {
  match hunk {
    KeyedDiffAddedHunk { hunk_key: _, to: m } => MemberAdded { to: m }
    KeyedDiffModifiedHunk { hunk_key: _, from: f, to: t } => MemberChanged { from: f, to: t }
    KeyedDiffRemovedHunk { hunk_key: _, from: m } =>
      match removal_admission(existing: m, ownership_of: ownership_of) {
        RemovalAdmitted => MemberRemoved { from: m }
        RemovalRefused { cause: c } => MemberRemovalRefused { from: m, cause: c }
      }
  }
}

fn membership_reconcile<M, Relation, Scope, K>(
  desired: List<M>,
  observed: List<M>,
  relation: KeyRelation<Relation, M, Scope, K>,
  value_eq: fn(M, M) -> Bool,
  ownership_of: fn(M) -> Ownership?,
) -> MembershipPlan<M> {
  let patch = membership_scoped_two_way_diff(
    left: member_rows(members: observed, relation: relation),
    right: member_rows(members: desired, relation: relation),
    relation: relation,
    value_eq: value_eq,
  )
  MembershipPlan {
    actions: map(patch.hunks, h => hunk_to_action(hunk: h, ownership_of: ownership_of))
  }
}

data membership_effects_note: String = "The APPLY-grain projection of a plan: partitions a MembershipPlan into effects (add/replace/remove) OR a wholesale refusal. EffectReplace carries BOTH sides because an apply handler that replaces a member must be able to retire the prior realization, not merely write the new one over it; an EffectAdd carries one side because there is nothing there to retire. EffectsOrRefusal is a SUM, not a product: the ApplyRefused arm carries NO effects, so a plan with any refusal is UN-EMITTABLE — a consumer can obtain a List<MemberEffect> only from the EffectsReady arm, making drop-and-proceed (emit the effects, ignore the refusals) unrepresentable, not merely discouraged (DESIGN §5 construction-over-validation). Refused is PRESERVED and surfaced as MemberRefusal (member+cause: typed+located+counted), never dropped — the spine keeps producing it (plan grain), the apply grain refuses wholesale on it. flat_map (not a concat-in-fold) builds each list in one pass — no accumulator-copy. See membership_effects_wholesale_refuse_policy_trigger for the deliberate scope-dependent policy."

fn membership_effects<M>(plan: MembershipPlan<M>) -> EffectsOrRefusal<M> {
  let refusals = flat_map(plan.actions, a =>
    match a {
      MemberRemovalRefused { from: m, cause: c } => [MemberRefusal { member: m, cause: c }]
      MemberAdded { to: _ } => []
      MemberChanged { from: _, to: _ } => []
      MemberRemoved { from: _ } => []
    }
  )
  if count(refusals) > 0 {
    ApplyRefused { refusals: refusals }
  } else {
    EffectsReady {
      effects: flat_map(plan.actions, a =>
        match a {
          MemberAdded { to: m } => [EffectAdd { to: m }]
          MemberChanged { from: f, to: t } => [EffectReplace { from: f, to: t }]
          MemberRemoved { from: m } => [EffectRemove { from: m }]
          MemberRemovalRefused { from: _, cause: _ } => []
        }
      )
    }
  }
}

type MembershipTally {
  adds: Int
  changes: Int
  removals: Int
  refusals: Int
}

data membership_tally_note: String = "The counts-monoid of a plan (zero = all-zero, combine = componentwise +). ONE catamorphism over the actions computes all four counts in a single pass; the membership_added/change/removal/refusal_count fns are its projections (was three separate folds — DESIGN §2 one-concept, the elegant fold the diff is). The accumulator is a fixed-size record (O(1)/step), not a growing list, so no copy cost."

fn membership_tally<M>(plan: MembershipPlan<M>) -> MembershipTally {
  fold(plan.actions, init: MembershipTally { adds: 0, changes: 0, removals: 0, refusals: 0 }, f: (acc, a) =>
    match a {
      MemberAdded { to: _ } =>
        MembershipTally { adds: acc.adds + 1, changes: acc.changes, removals: acc.removals, refusals: acc.refusals }
      MemberChanged { from: _, to: _ } =>
        MembershipTally { adds: acc.adds, changes: acc.changes + 1, removals: acc.removals, refusals: acc.refusals }
      MemberRemoved { from: _ } =>
        MembershipTally { adds: acc.adds, changes: acc.changes, removals: acc.removals + 1, refusals: acc.refusals }
      MemberRemovalRefused { from: _, cause: _ } =>
        MembershipTally { adds: acc.adds, changes: acc.changes, removals: acc.removals, refusals: acc.refusals + 1 }
    }
  )
}

fn membership_added_count<M>(plan: MembershipPlan<M>) -> Int {
  membership_tally(plan: plan).adds
}

fn membership_change_count<M>(plan: MembershipPlan<M>) -> Int {
  membership_tally(plan: plan).changes
}

data membership_write_count_note: String = "adds + changes — the count of members this plan will WRITE, which is what the former membership_upsert_count actually answered for its consumers ('how much work is left'). It is kept as a DERIVED projection over the two separate tally fields, never as a stored merged counter: an add and a change have different realizations (gunbc.change_realization), so a single stored 'upserts' number is the conflation this change removed and re-storing it would reinstate it. A consumer that genuinely cares which kind of write it is reads adds and changes directly."

fn membership_write_count<M>(plan: MembershipPlan<M>) -> Int {
  let t = membership_tally(plan: plan)
  t.adds + t.changes
}

fn membership_removal_count<M>(plan: MembershipPlan<M>) -> Int {
  membership_tally(plan: plan).removals
}

fn membership_refusal_count<M>(plan: MembershipPlan<M>) -> Int {
  membership_tally(plan: plan).refusals
}

data membership_effects_wholesale_refuse_policy_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.membership_reconcile",
    decl_name: "membership_effects",
    field: WholeDeclaration,
  }
}

data membership_effects_wholesale_refuse_policy_note: String = "WHOLESALE-REFUSE is a deliberate, SCOPE-DEPENDENT execution policy (pass-2 review, calm-ferret + royal-carp) — this counted mark is its single authority (§6 carrier-is-authority; the design doc glosses it, does not own it). membership_effects encodes a POLICY, not only a type: any refusal => the WHOLE apply emits nothing. This is separable from the PLAN grain, where 'siblings continue' (membership_reconcile still produces every per-member action and counts refusals — an owned teardown is recorded next to a non-owned refuse). The correct policy turns on the future real observed-provider's SCOPE: observed = owned-artifacts-only => a refusal is a genuine anomaly => wholesale-refuse is the right conservative halt (stop the line); observed = everything-on-host => foreign members are normal => wholesale-refuse would let any foreign thing block our owned teardown, and siblings-continue would be wanted instead. MOOT for the pass-2 deploy poles (apply pole has no Removed; retract pole observes owned-only) — no refusal arises today, so this is a safety backstop for a future non-degenerate observed provider. DISSOLVES when that real observed-provider design lands AND someone makes the conscious wholesale-vs-siblings-continue call (editing membership_effects); until then the type must NOT be silently taken to lock the choice."
