// THE PULL REQUEST'S OWN HALF OF HEAL, IN ITS OWN WORKFLOW (gunbc#10958 Phase A).
//
// IT HOLDS NO WRITE AUTHORITY AND PUSHES NOTHING. Until this cut, this job checked out the branch,
// regenerated, committed and pushed with the Actions job credential -- and GitHub holds the
// pull_request run that such a push causes (docs: a push made with GITHUB_TOKEN creates workflow runs
// in an approval-required state), so every healed head waited for a human. The repair now leaves as a
// CANDIDATE ARTIFACT, and gunbc.heal_publisher_workflow publishes it from the default branch under an
// App installation token, whose pushes run without approval.
//
// WHY A SEPARATE WORKFLOW RATHER THAN A LANE OF `witnesses`. The publisher is triggered by
// workflow_run on THIS workflow's completion, and a workflow_run fires when the whole run finishes.
// Left inside `witnesses`, publication would wait for the required floor of a head the repair is
// about to supersede. Heal was never a required lane -- it remediates, the build lane's
// generated-artifact phase adjudicates -- so nothing of the gate moves with it.
//
// THE CHECKOUT IS THE EXACT HEAD, NOT THE BRANCH NAME. The candidate describes the commit it was
// derived from, and the publisher refuses any candidate whose expected head is not the branch's
// current head; taking the sha the event names keeps the run's subject and the candidate's subject
// the same value rather than two reads of a moving ref.

// A DISPATCH CARRIES NO PULL REQUEST, so the operator supplies what the event does not. The retained
// manual path checked out github.event.pull_request.head.sha and handed the candidate producer that
// object's number, head ref and base ref: on a dispatch every one of them is empty, so the run would
// have sealed a candidate describing nothing. These four inputs are the same four facts, asked for
// instead of assumed, and they are required because a repair against an unnamed head is not a repair.
data heal_dispatch_pull_number_input: DispatchInput = DispatchInput {
  name: "pull_number",
  description: Present { value: "Pull request this manual repair describes" },
  required: true,
  default: none,
  type: InputString
}

data heal_dispatch_head_sha_input: DispatchInput = DispatchInput {
  name: "head_sha",
  description: Present { value: "Exact head commit the candidate is sealed against" },
  required: true,
  default: none,
  type: InputString
}

data heal_dispatch_head_ref_input: DispatchInput = DispatchInput {
  name: "head_ref",
  description: Present { value: "Head branch the repair would fast-forward" },
  required: true,
  default: none,
  type: InputString
}

data heal_dispatch_base_ref_input: DispatchInput = DispatchInput {
  name: "base_ref",
  description: Present { value: "Base branch of that pull request" },
  required: true,
  default: none,
  type: InputString
}

// The commit `base_ref` pointed at when this repair was dispatched, for a manual run that has no
// pull_request context to read it from. A 40-hex commit, not a branch name -- see
// heal_base_sha_read for why the round's authority is a commit.
data heal_dispatch_base_sha_input: DispatchInput = DispatchInput {
  name: "base_sha",
  description: Present { value: "Base commit (40-hex) of that pull request" },
  required: true,
  default: none,
  type: InputString
}

// THE ROUND'S OWN BOOTSTRAP AUTHORITY, its own name. `HEAL_BASE_REF` already belongs to the
// candidate step (gunbc.heal_candidate heal_candidate_base_ref_env) and carries a BRANCH NAME for
// a different purpose; the round's seed needs a COMMIT and must not read a name another step owns.
data heal_round_base_mirror_env: String = "HEAL_BASE_MIRROR_COMMIT"

// THE HEAL JOB'S NAME, ID AND TIMEOUT COME FROM THE REPOSITORY'S CI PROFILE ROW: a repository that
// commits no generated mirror deletes the heal row and this file with it, and a repository that does
// keeps them - with one description of the job rather than this module and the profile each carrying one.
// The committed bytes are the evidence, and the comparison belongs to the authority that owns generated
// artifacts (dag/gunbc/instruments/tier_o_drift_check.dag, repaired by generated_artifact_gate.dag main_wet);
// a claim holding a second copy of this file's text would only be another thing to keep equal.
data heal_workflow_required_bins: List<String> = ["gunbc", "claim_executor"]

data heal_build_step_name: String = "Build the regenerator this job runs against its own checkout"

data heal_candidate_artifact_retention_days: Int = 3

// SAME-REPOSITORY PULL REQUESTS ONLY, AND NOT DEPENDABOT. A fork's head is not a branch this
// repository can publish to, and the publisher independently refuses a candidate whose run reports a
// head repository other than this one; the guard here is what keeps the job from running at all.
data heal_same_repository_clause: String = "github.event.pull_request.head.repo.full_name == github.repository"

data heal_not_dependabot_clause: String = "github.actor != 'dependabot[bot]'"

// A DISPATCH CARRIES NO PULL REQUEST, so the fork clauses would read null and skip it. The manual
// route holds write access already, which is the authority the fork clauses establish for a pull
// request. A FORK PULL REQUEST IS NOT SILENT: heal_fork_notice_step runs on exactly the runs this
// condition skips the job for, in a sibling job that holds no checkout and no credential.
fn heal_workflow_job_condition() -> String {
  concat("github.event_name == 'workflow_dispatch' || (", heal_same_repository_clause, " && ", heal_not_dependabot_clause, ")")
}

fn heal_fork_notice_condition() -> String {
  concat("github.event_name == 'pull_request' && ", "github.event.pull_request.head.repo.full_name != github.repository")
}

// THE TRIGGER PATHS ARE DERIVED, NOT LISTED. The stage0 mirrors are a function of the .dag corpus the
// layer roots name and of the seed that reads them (src/v1); the seed-build artifacts are named by
// gunbc.seed_build_artifact_emit. A new root or a new seed-build artifact moves this set with no edit here.
fn heal_trigger_paths() -> List<String> {
  concat(
    concat(
      list_map(xs: witness_layer_roots, f: fn(root) { concat(root, "/**") }),
      ["src/v1/**"]
    ),
    list_map(xs: seed_build_artifacts(), f: fn(a) { artifact_path(a: a) })
  )
}

// persist-credentials: false is the load-bearing input. The job has no write grant to persist, and
// saying so in the checkout keeps a later editor from inheriting one by default.
fn heal_checkout_step() -> Step {
  UsesStep {
    name: Present { value: "Checkout the exact pull request head this candidate will describe" },
    id: none,
    uses: checkout_action,
    with: Present {
      value: [
        kv(key: "fetch-depth", value: yaml_int(n: 0)),
        checkout_ref_entry(ref_expression: heal_checkout_ref),
        kv(key: "persist-credentials", value: yaml_bool(b: false))
      ]
    },
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

// ROUND 1 SEEDS FROM THE BASE REF'S COMMITTED MIRROR (DESIGN §5, `gunbc.recurring_failure_mode`
// `heal_round_one_bootstraps_from_the_mirror_the_change_must_repair`, RFM PR #14963). The commit is
// this step's ENVIRONMENT VALUE -- never argv -- because it is pull-request-controlled text:
// spliced into a command word it would be shell, and the invoke-step admit gate refuses any argv
// word containing `${{`. It is the IMMUTABLE `base.sha`, not `base.ref`: a branch name is a moving
// name that a local branch and its remote-tracking ref can disagree about, and the round's seed
// must be one commit that GitHub already resolved for this pull request. The step asks for the
// base mirror UNCONDITIONALLY on every heal run; nothing here branches on a previous failure, and
// the round's receipt names the base COMMIT it seeded from. THE SCOPE IS THE WHOLE CRATE (`src/v1/stage0`:
// mirrors at any depth, hand-maintained files, Cargo.toml, build.rs), not the generated top level --
// a nested partition or a hand-maintained file left at the head beside base's definitions is a crate
// that is neither base nor head, which is how #15175 (E0599) and #14876 (26 E0308/E0282 in
// `v1-stage0-std-core`) refused in round 1.
fn heal_stage0_round_step() -> Step {
  RunStep {
    name: Present { value: "Converge the stage0 mirrors to the seed's own fixed point" },
    id: none,
    run: gunbc_ci_stage0_round_invoke(),
    shell: none,
    env: Present {
      value: [
        kv(key: heal_round_base_mirror_env as String, value: yaml_string(s: heal_base_sha_read))
      ]
    },
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn heal_stage0_overlap_step() -> Step {
  RunStep {
    name: Present { value: "Refuse when the stage0 round wrote a file the seed-build writer owns" },
    id: none,
    run: gunbc_ci_heal_stage0_overlap_invoke(),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn heal_seed_build_artifacts_step() -> Step {
  RunStep {
    name: Present { value: "Regenerate the seed-build artifacts without loading the registry" },
    id: none,
    run: gunbc_ci_seed_build_artifacts_regen_invoke(),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

// THE ROUND'S OWN RECORD OF HOW IT ENDED, WRITTEN OUTSIDE THE CHECKOUT AND UPLOADED UNDER ITS OWN
// ARTIFACT NAME. This module's upload step is correctly unconditional about the CANDIDATE -- the
// producer writes a manifest even for a clean tree -- but every other step in this job is gated on the
// round having produced a candidate, so a round that stops before writing one ends with no trace of
// what it did. That is the producer half of the sighting recorded in
// gunbc.recurring_failure_mode.a_refused_round_uploads_no_candidate_and_its_emission_is_lost: a round
// can write blob files, refuse at a later phase, and its emission dies with the runner. Two transports,
// two names: this record can never be a publishable candidate, because the publisher's build, admit,
// federation and publication steps are gated on the candidate artifact under its own name and on blob
// files under theirs.
data heal_round_outcome_producer_directory: String = "${{ runner.temp }}/" + heal_round_outcome_directory_name as String

data heal_round_outcome_producer_file: String = heal_round_outcome_producer_directory + "/" + heal_round_outcome_file_name as String

// WHERE THE MATCHING PATHS GO BEFORE THEY ARE COUNTED. It sits BESIDE the record directory, not in it:
// the record directory is the uploaded artifact, and the artifact carries the record and nothing else.
data heal_round_outcome_blob_list_file: String = "${{ runner.temp }}/" + heal_round_outcome_directory_name as String + "-blob-list"

// SEEDED BEFORE THE ROUND RUNS, AND DELIBERATELY WITHOUT THE FIELD LINE: the surviving file then answers
// one of two questions -- how many blobs the round left behind, or that the round ended without closing
// its record. A seed that carried the field would make an unclosed record read as a closed one, and a
// round killed between the seed and its finalisation would be reported as a clean tree. The trailing
// backslash-n is what printf in the emitted script turns into a newline (v2.test.claim.bash_program_fold
// ::bash_program_fold_sample_set_e_golden spells its own line ends the same way).
data heal_round_outcome_seed_line: String = heal_round_outcome_not_closed_marker as String + "\\n"

// COUNTED IN THE ROUND'S OWN SHELL, NOT IN THE WORKFLOW EXPRESSION LANGUAGE: a count is arithmetic over
// real files and the expression language has no arithmetic. This is why the candidate command is built
// the same way, through the bash fold.
fn heal_round_outcome_count_statements() -> List<Node> {
  [
    // THE COUNT IS TAKEN WITH FIND'S OWN PATTERN MATCHING, NOT THE SHELL'S. The bash emitter quotes every
    // literal word (v2.test.claim.bash_program_fold ::bash_program_metachars_quoted_matches_golden_holds),
    // so an unquoted `dir/blob-*` would reach `ls` as text and match nothing: a record that always says
    // zero is worse than no record, because the publisher would read a LOST emission as a clean tree. With
    // `-name`, the quoted pattern is matched by find itself, which is what it means.
    bash_build_if_else_from_stmts(
      cond: bash_build_test_bracket(words: [
        bash_build_word_lit(text: "-d"),
        bash_build_word_lit(text: heal_candidate_directory),
      ]),
      then_stmts: [
        bash_build_with_redir_to_file(
          inner: bash_build_command_with_words(words: [
            bash_build_word_lit(text: "find"),
            bash_build_word_lit(text: heal_candidate_directory),
            bash_build_word_lit(text: "-maxdepth"),
            bash_build_word_lit(text: "1"),
            bash_build_word_lit(text: "-name"),
            bash_build_word_lit(text: heal_repair_candidate_blob_file_prefix as String + "*"),
          ]),
          path: bash_build_word_lit(text: heal_round_outcome_blob_list_file),
        ),
      ],
      // NO CANDIDATE DIRECTORY IS THE ORDINARY CLEAN CASE, not an error: the round refused before writing
      // anything. The list is still written, empty, so the count below is a real zero and not a missing
      // file the record would have to guess about.
      else_stmts: [
        bash_build_with_redir_to_file(
          inner: bash_build_command_with_words(words: [bash_build_word_lit(text: "printf")]),
          path: bash_build_word_lit(text: heal_round_outcome_blob_list_file),
        ),
      ],
    ),
    bash_build_assign(
      name: "heal_round_outcome_blobs",
      value: bash_build_word_cmdsubst(body: bash_build_with_redir_from_file(
        inner: bash_build_command_with_words(words: [
          bash_build_word_lit(text: "wc"),
          bash_build_word_lit(text: "-l"),
        ]),
        path: bash_build_word_lit(text: heal_round_outcome_blob_list_file),
      )),
    ),
    // THE FIELD IS WRITTEN BY CONCATENATION, NOT BY A SHELL EXPANSION INSIDE A LITERAL: a literal word
    // carrying `${...}` is emitted quoted and would land in the record as the text `${...}`.
    bash_build_with_redir_to_file(
      inner: bash_build_command_with_words(words: [
        bash_build_word_lit(text: "printf"),
        bash_build_word_lit(text: "%s\\n"),
        bash_build_word_concat_from_nodes(parts: [
          bash_build_word_lit(text: heal_round_outcome_blobs_field as String),
          bash_build_word_var(name: "heal_round_outcome_blobs"),
        ]),
      ]),
      path: bash_build_word_lit(text: heal_round_outcome_producer_file),
    ),
  ]
}

// `always()` IS THE POINT. Every other step in this job is gated on the round having produced a
// candidate, which is right for publishing and fatal for knowing: when that gate closes the job ends
// with no record of the round. This step runs whatever the round did to it, and re-raises the round's
// own exit code so the record never rewrites history -- a round that failed still fails.
fn heal_round_outcome_write_step() -> Step {
  RunStep {
    name: Present { value: "Close the round outcome record" },
    id: none,
    run: heal_round_outcome_rendered(statements: heal_round_outcome_count_statements(), set_e: true),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: Present { value: "always()" },
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn heal_round_outcome_seed_step() -> Step {
  RunStep {
    name: Present { value: "Open the round outcome record" },
    id: none,
    run: heal_round_outcome_rendered(statements: [
      bash_build_command_with_words(words: [bash_build_word_lit(text: "mkdir"), bash_build_word_lit(text: "-p"), bash_build_word_lit(text: heal_round_outcome_producer_directory)]),
      bash_build_with_redir_to_file(
        inner: bash_build_command_with_words(words: [bash_build_word_lit(text: "printf"), bash_build_word_lit(text: heal_round_outcome_seed_line)]),
        path: bash_build_word_lit(text: heal_round_outcome_producer_file),
      ),
    ], set_e: true),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

// A SECOND ARTIFACT, UPLOADED UNCONDITIONALLY, UNDER A NAME THE PUBLICATION STEPS NEVER MATCH.
// THE RECORD TRAVELS THE SAME TRANSPORT AS THE CANDIDATE, AND ITS ABSENCE IS AN ERROR, NOT A SIGNAL —
// the one authority for that choice is gunbc.ci.workflow_artifact_upload ArtifactAbsence, whose policy is
// that an upload finding no files fails (gunbc#15522's own reasoning: an upload that collects a producer's
// receipt under always() is exactly where a producer that passed without writing it is caught). The seed
// step runs first and ungated, so a missing record means the record route itself broke; a round that
// cannot state what it left behind is not a green round. There is therefore no continue_on_error here.
fn heal_round_outcome_upload_step() -> Step {
  UsesStep {
    name: Present { value: "Upload the round outcome record" },
    id: none,
    uses: upload_artifact_action,
    with: Present {
      value: workflow_artifact_upload_with(
        name: heal_round_outcome_artifact_name as String,
        path: heal_round_outcome_producer_directory,
        retention_days: Present { value: heal_candidate_artifact_retention_days },
        compression_level: none,
        absence: AbsenceRefused,
      )
    },
    env: none,
    if_condition: Present { value: "always()" },
    continue_on_error: none,
    timeout_minutes: none
  }
}

// THE SUBJECT FACTS ARRIVE AS ENVIRONMENT VALUES, NEVER INTERPOLATED INTO A SCRIPT. A branch name is
// pull-request-controlled text; spliced into a command it would be shell, and read from the
// environment it is a value the producer refuses if it is empty.
fn heal_candidate_step() -> Step {
  RunStep {
    name: Present { value: "Produce the sealed repair candidate" },
    id: none,
    run: gunbc_ci_heal_candidate_stage0_invoke(),
    shell: none,
    env: Present {
      value: [
        kv(key: heal_candidate_repository_env as String, value: yaml_string(s: heal_repository_read)),
        kv(key: heal_candidate_pull_number_env as String, value: yaml_string(s: heal_pull_number_read)),
        kv(key: heal_candidate_head_ref_env as String, value: yaml_string(s: heal_head_ref_read)),
        kv(key: heal_candidate_base_ref_env as String, value: yaml_string(s: heal_base_ref_read)),
        kv(key: heal_candidate_run_id_env as String, value: yaml_string(s: heal_run_id_read))
      ]
    },
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

// THE UPLOAD IS OWED ON EVERY SUCCESSFUL RUN, SO A MISSING FILE IS AN ERROR RATHER THAN A SIGNAL.
// gunbc.heal_candidate writes a manifest whether or not anything drifted -- a clean tree is an empty
// entries list, not an absent file -- so `if-no-files-found: ignore` would now hide a producer that
// failed to write rather than describe a tree that was clean. Retention is short because a candidate
// is only meaningful while its expected head is still the branch head.
fn heal_candidate_upload_step() -> Step {
  UsesStep {
    name: Present { value: "Upload the sealed repair candidate" },
    id: none,
    uses: upload_artifact_action,
    with: Present {
      value: workflow_artifact_upload_with(
        name: heal_repair_candidate_artifact_name as String,
        path: heal_candidate_directory,
        retention_days: Present { value: heal_candidate_artifact_retention_days },
        compression_level: none,
        absence: AbsenceRefused,
      )
    },
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

type HealBoundStep {
  step: Step
  role: StepCapabilityRole
  step_name: String
}

fn heal_workflow_bound_steps() -> List<HealBoundStep> {
  [
    HealBoundStep {
      step: heal_checkout_step(),
      role: capability_neutral,
      step_name: "Checkout the exact pull request head this candidate will describe",
    },
    HealBoundStep {
      step: toolchain_home_isolation_step(),
      role: capability_neutral,
      step_name: "Isolate toolchain homes",
    },
    HealBoundStep {
      step: witness_floor_toolchain_step(),
      role: provides_only(capabilities: [CargoCapability, RustcCapability, RustfmtCapability, RustupCapability]),
      step_name: "Install Rust toolchain",
    },
    HealBoundStep {
      step: toolchain_pin_rustup_default_step(),
      role: consumes_only(capabilities: [RustupCapability, CargoCapability]),
      step_name: "Pin rustup default (isolated RUSTUP_HOME has no default toolchain)",
    },
    HealBoundStep {
      step: witness_floor_build_step(step_name: heal_build_step_name, build_script: repo_self_build_command(bins: heal_workflow_required_bins)),
      role: consumes_only(capabilities: [CargoCapability]),
      step_name: heal_build_step_name,
    },
    HealBoundStep {
      step: heal_stage0_round_step(),
      role: consumes_only(capabilities: [CargoCapability]),
      step_name: "Converge the stage0 mirrors to the seed's own fixed point",
    },
    HealBoundStep {
      step: heal_stage0_overlap_step(),
      role: capability_neutral,
      step_name: "Refuse when the stage0 round wrote a file the seed-build writer owns",
    },
    HealBoundStep {
      step: heal_seed_build_artifacts_step(),
      role: capability_neutral,
      step_name: "Regenerate the seed-build artifacts without loading the registry",
    },
    HealBoundStep {
      step: heal_round_outcome_seed_step(),
      role: capability_neutral,
      step_name: "Open the round outcome record",
    },
    HealBoundStep {
      step: heal_candidate_step(),
      role: capability_neutral,
      step_name: "Produce the sealed repair candidate",
    },
    HealBoundStep {
      step: heal_candidate_upload_step(),
      role: capability_neutral,
      step_name: "Upload the sealed repair candidate",
    },
    HealBoundStep {
      step: heal_round_outcome_write_step(),
      role: capability_neutral,
      step_name: "Close the round outcome record",
    },
    HealBoundStep {
      step: heal_round_outcome_upload_step(),
      role: capability_neutral,
      step_name: "Upload the round outcome record",
    },
  ]
}

fn heal_workflow_capability_closure_holds() -> Bool {
  capability_closure_is_closed(
    v: workflow_job_capability_closure(
      steps: list_map(
        xs: heal_workflow_bound_steps(),
        f: fn(b) { CapabilityAnnotatedStep { step_name: b.step_name, role: b.role } },
      )
    ),
  )
}

// contents: READ. The job reads its own checkout and writes an artifact; the artifact upload is
// authorized by the runtime token, not by this grant. Every other axis is None by omission.
data heal_workflow_job_permissions: WorkflowPermissions = WorkflowPermissions {
  contents: Present { value: PermRead },
  pull_requests: none,
  issues: none,
  actions: none,
  id_token: none
}

fn heal_workflow_job(job: HealWorkflowPolicy) -> Job {
  Job {
    id: job.job_id as String,
    name: none,
    runner: ci_runner_target_spec(target: job.runner),
    environment: none,
    steps: list_map(xs: heal_workflow_bound_steps(), f: fn(b) { b.step }),
    needs: [],
    env: none,
    outputs: none,
    if_condition: Present { value: heal_workflow_job_condition() },
    timeout_minutes: Present { value: minute_count(m: job.timeout) },
    continue_on_error: none,
    concurrency: none,
    permissions: Present { value: heal_workflow_job_permissions }
  }
}

data heal_fork_notice_job_id: String = "heal-fork-skipped"

// A FORK PULL REQUEST GETS A VISIBLE NOTICE, NEVER SILENCE. The job holds no checkout and no grant
// beyond the workflow's read; it exists only so the skip is an annotation on the run.
fn heal_fork_notice_job(job: HealWorkflowPolicy) -> Job {
  Job {
    id: heal_fork_notice_job_id,
    name: none,
    // The notice job shares the heal job's machine class: it is the same workflow's second job, and
    // splitting a workflow across machine classes is a decision its profile row should say so in.
    runner: ci_runner_target_spec(target: job.runner),
    environment: none,
    steps: [RunStep {
      name: Present { value: "Say that a fork pull request is not repaired" },
      id: none,
      run: "echo \"::notice title=heal skipped::fork pull request: this repository cannot push to a fork's branch, so stage0 mirrors and seed-build artifacts are not regenerated here. Regenerate them locally and push.\"",
      shell: none,
      env: none,
      working_directory: none,
      if_condition: none,
      continue_on_error: none,
      timeout_minutes: none
    }],
    needs: [],
    env: none,
    outputs: none,
    if_condition: Present { value: heal_fork_notice_condition() },
    timeout_minutes: Present { value: 5 },
    continue_on_error: none,
    concurrency: none,
    permissions: Present { value: heal_workflow_job_permissions }
  }
}

// A SUPERSEDED HEAL IS CANCELLED, WHICH IS RIGHT FOR A REMEDIATOR AND WOULD BE WRONG FOR A VERDICT.
// A candidate describes one head; when the author pushes another, the in-flight run is producing a
// candidate the publisher would refuse as stale, and the successor run produces the one that can
// land. Nothing here reports a verdict about a revision, so cancelling loses no judgment.
data heal_workflow_concurrency: ConcurrencySpec = ConcurrencyMappingQueueNotMax {
  group: serialize_template(template: heal_workflow_group_template),
  cancel_in_progress: Present { value: CancelInProgressBool { value: true } },
  explicit_single: none
}

// THIS WORKFLOW NO LONGER RUNS ON A PULL REQUEST. Its work -- declare, regenerate, seal the
// candidate -- is the repair path of the consolidated required job
// (gunbc.witness.compiler_gate_workflow), which runs it only on the push where the drift gate refused.
// Leaving the pull_request trigger here would pay heal's four whole-corpus invocations (22.7 of
// its 26.4 minutes, measured on run 35475373850) again on every push, for the same repair.
// The workflow stays registered, committed and dispatchable so an operator can still run a repair
// by hand; the emitted file is unchanged apart from its trigger.
fn heal_workflow_of(job: HealWorkflowPolicy) -> Workflow {
  Workflow {
  name: job.workflow_name as String,
  run_name: none,
  on: [PullRequest { branches: [gunbc_default_branch_name], types: [Opened, Synchronize, Reopened], paths: heal_trigger_paths() }, WorkflowDispatch { inputs: [
    heal_dispatch_pull_number_input,
    heal_dispatch_head_sha_input,
    heal_dispatch_head_ref_input,
    heal_dispatch_base_ref_input,
    heal_dispatch_base_sha_input
  ] }],
  concurrency: Present { value: heal_workflow_concurrency },
  env: Present {
    value: [
      kv(key: "CARGO_TERM_COLOR", value: yaml_string(s: "always")),
      kv(key: "MALLOC_ARENA_MAX", value: yaml_string(s: "2"))
    ]
  },
  permissions: Present {
    value: WorkflowPermissions {
      contents: Present { value: PermRead },
      pull_requests: none,
      issues: none,
      actions: none,
      id_token: none
    }
  },
  jobs: [heal_workflow_job(job: job), heal_fork_notice_job(job: job)]
}
}

// ── The isolation invariant, asked of the emitted job ────────────────────────────────────────

// THE CANDIDATE PHASE MUST HOLD NOTHING THAT COULD PUBLISH. This reads the job that will actually
// run: any write grant, an id-token grant it could federate with, or a federation step at all makes
// the answer true, and the emitter refuses rather than producing a workflow that violates the
// boundary. gunbc#10887 is the receipt for why this is checked rather than reviewed.
fn permission_is_write(p: PermissionLevel?) -> Bool {
  match p {
    Absent => false
    Present { value: level } =>
      match level {
        PermWrite => true
        PermRead => false
        PermNone => false
      }
  }
}

fn job_permissions_carry_write(permissions: WorkflowPermissions?) -> Bool {
  match permissions {
    Absent => true
    Present { value: p } =>
      permission_is_write(p: p.contents)
        || permission_is_write(p: p.pull_requests)
        || permission_is_write(p: p.issues)
        || permission_is_write(p: p.actions)
        || permission_is_write(p: p.id_token)
  }
}

fn step_uses_action(step: Step, action: ActionRelease) -> Bool {
  match step {
    RunStep { name: _, id: _, run: _, shell: _, env: _, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => false
    UsesStep { name: _, id: _, uses: u, with: _, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => action_release_same_producer(a: u, b: action)
  }
}

fn job_federates_to_a_cloud_identity(job: Job) -> Bool {
  any(job.steps, s => step_uses_action(step: s, action: google_auth_action))
}

fn heal_job_holds_publication_credential(job: HealWorkflowPolicy) -> Bool {
  let candidate = heal_workflow_job(job: job)
  job_permissions_carry_write(permissions: candidate.permissions)
    || job_federates_to_a_cloud_identity(job: candidate)
}

type HealWorkflowGenerationOutcome
  = HealWorkflowGenerated { content: String }
  | HealWorkflowGenerationRefused { reason: String }

data heal_workflow_credential_refusal_reason: String = "REFUSED gunbc.heal_workflow: the candidate job carries a write grant or federates to a cloud identity, which is the credential placement gunbc.heal_publication_boundary forbids for the phase that executes pull-request code. No workflow yaml was emitted."

data heal_workflow_capability_refusal_reason: String = "REFUSED gunbc.heal_workflow: the job's capability closure does not hold. No workflow yaml was emitted. Fix the step roles in the job's annotations, or the order of the steps themselves."

// THE HEAL EMITTER, REFUSING BEFORE IT RENDERS. There is no fabricated heal row to fall back to: the
// emitter matches on its repository's declared row and refuses when the row is absent, so a repository that
// commits no generated mirror has no heal.yml because the emitter cannot produce one, not because a branch
// was remembered. The row then threads through every builder, which is what makes the workflow's identity
// (name, job id, runner, timeout) a single read of that row.
data heal_workflow_no_row_refusal_reason: String = "REFUSED gunbc.heal_workflow: this repository's gunbc.ci.repository_ci_profile row declares no heal job, so there is nothing to regenerate and no candidate to seal. Declare heal: Present { value: HealWorkflowPolicy { ... } } if this repository commits generated mirrors; delete heal.yml if it does not."

fn expected_heal_workflow_yml() -> HealWorkflowGenerationOutcome {
  heal_workflow_yml_for(profile: gunbc_repository_ci_profile())
}

fn heal_workflow_yml_for(profile: RepositoryCiProfile) -> HealWorkflowGenerationOutcome {
  // THE ROW IT WAS HANDED IS ADMITTED BEFORE A BYTE IS RENDERED, and it is the SAME row the builders read:
  // an emitter that admitted one repository's profile while rendering another's would commit a workflow its
  // own data refuses - a runner group no census declared, a heal with nothing to publish it, a duration that
  // is not positive - and the admission would be theatre. One match, on the parameter, at the entrypoint.
  match repository_ci_profile_refusal(profile: profile) {
    Present { value: reason } => HealWorkflowGenerationRefused { reason: reason as String }
    Absent => heal_workflow_yml_of_admitted_row(profile: profile)
  }
}

// THE RENDER PATH, REACHABLE ONLY FOR AN ADMITTED ROW. It takes the profile rather than a job so every
// fact - identity, runner, timeout - is one read of the row the admission just accepted.
fn heal_workflow_yml_of_admitted_row(profile: RepositoryCiProfile) -> HealWorkflowGenerationOutcome {
  match profile.heal {
    Absent => HealWorkflowGenerationRefused { reason: heal_workflow_no_row_refusal_reason }
    Present { value: job } =>
      match admit_workflow_checkout_refs(workflow: heal_workflow_of(job: job), declared: [heal_checkout_ref]) {
    WorkflowCheckoutRefsRefused { refusals: crs } =>
      HealWorkflowGenerationRefused { reason: workflow_checkout_refs_refusal_reason(workflow_module: "gunbc.heal_workflow", refusals: crs) }
    WorkflowCheckoutRefsAdmitted =>
      match admit_workflow_toolchain_homes(workflow: heal_workflow_of(job: job)) {
    WorkflowToolchainHomeRefused { job_id: j, refusal: r } =>
      HealWorkflowGenerationRefused { reason: toolchain_home_refusal_reason(job_id: j, refusal: r) }
    WorkflowToolchainHomesAdmitted =>
      if heal_job_holds_publication_credential(job: job) {
        HealWorkflowGenerationRefused { reason: heal_workflow_credential_refusal_reason }
      } else if !heal_workflow_capability_closure_holds() {
        HealWorkflowGenerationRefused { reason: heal_workflow_capability_refusal_reason }
      } else {
        match emit_yaml(v: project_workflow_to_yaml(workflow: heal_workflow_of(job: job))) {
          EmittedYaml { text: t } => HealWorkflowGenerated { content: t }
          YamlEmitRefused { path: p, reason: r } => HealWorkflowGenerationRefused { reason: yaml_emit_refusal_text(module_path: "gunbc.heal_workflow", path: p, reason: r) }
        }
      }
  }
  }
  }
}

// The commit the heal dispatch names; a declared revision input (gunbc.action_use_admission).
data heal_checkout_ref: Expression = LogicalOr {
  left: ContextAccess { context: Github, path: ["event", "pull_request", "head", "sha"] },
  right: ContextAccess { context: Inputs, path: [heal_dispatch_head_sha_input.name] }
}

// THE CANDIDATE STAGE READS THE PULL REQUEST COORDINATES THROUGH THE TYPED EXPRESSION MODEL (the
// same carrier as heal_checkout_ref above; review 85263, DESIGN section 6b: the same rule at
// sibling sites). Each read below is a ContextAccess over github or an `event.pull_request.X ||
// inputs.Y` LogicalOr whose fallback names a declared dispatch input, and the ${{ }} medium exists
// only in extdeps.github.expressions interpolate. The input names are read from the DispatchInput
// rows, so a coordinate is spelled once (section 3).
data heal_repository_read: String =
  interpolate(expression: ContextAccess { context: Github, path: ["repository"] })

data heal_run_id_read: String =
  interpolate(expression: ContextAccess { context: Github, path: ["run_id"] })

data heal_pull_number_fallback: Expression = LogicalOr {
  left: ContextAccess { context: Github, path: ["event", "pull_request", "number"] },
  right: ContextAccess { context: Inputs, path: [heal_dispatch_pull_number_input.name] }
}

data heal_pull_number_read: String = interpolate(expression: heal_pull_number_fallback)

data heal_head_ref_read: String = interpolate(expression: LogicalOr {
  left: ContextAccess { context: Github, path: ["event", "pull_request", "head", "ref"] },
  right: ContextAccess { context: Inputs, path: [heal_dispatch_head_ref_input.name] }
})

data heal_base_ref_read: String = interpolate(expression: LogicalOr {
  left: ContextAccess { context: Github, path: ["event", "pull_request", "base", "ref"] },
  right: ContextAccess { context: Inputs, path: [heal_dispatch_base_ref_input.name] }
})

// THE BASE COMMIT, IMMUTABLE. The round's bootstrap authority is read from `base.sha`, never from
// `base.ref`: a branch is a moving name that two remotes can disagree about (a checkout's local
// `main` can sit behind `origin/main`), and a receipt that named such a pick "the base commit"
// would be recording a fact it did not establish -- DESIGN §3, each fact lives in exactly one
// place, and §5, no plausible output is fabricated. The commit GitHub already resolved for this
// pull request IS the fact; the name is a lookup of it, so the seed never performs one.
data heal_base_sha_read: String = interpolate(expression: LogicalOr {
  left: ContextAccess { context: Github, path: ["event", "pull_request", "base", "sha"] },
  right: ContextAccess { context: Inputs, path: [heal_dispatch_base_sha_input.name] }
})

// THE GROUP PREFIX IS THE ONLY TEXT THIS MODEL OWNS for the group; the per-pull coordinate is the
// typed read above, and serialize_template spells the whole value.
data heal_workflow_group_prefix: String = "heal-pr-"

data heal_workflow_group_template: ExpressionTemplate = {
  segments: [
    LiteralText { text: heal_workflow_group_prefix },
    Interpolation { expression: heal_pull_number_fallback }
  ]
}

// THE STRING SEAM for the record scripts, with its own marker. The record scripts are built as bash
// grammar trees and rendered by v2.workflow.bash_emit, but a step's run: field is a plain String, so a
// refused render has to become text. It becomes a marker that is not valid shell, carrying why: the
// discipline of v2.workflow.bash_emit bash_emit_program_sequence_refused_poison and
// gunbc.machine_intake.sol_hold ::sol_hold_rendered. This module mints its OWN token rather than
// borrowing theirs, for the reason sol_hold records -- a borrowed constant drags the borrower's closure
// into every consumer. These are plain-String refusal seams of the kind gunbc.shell_command_text names
// in its next-rung trigger (carry a typed refusal Outcome through the seam, so no artifact is ever
// written carrying a marker); recorded here rather than remembered.
data heal_round_outcome_render_refused_poison: String = "__GUNBC_HEAL_ROUND_OUTCOME_RENDER_REFUSED__ v2.workflow.bash_emit bash_emit_stmts refused a gunbc.heal_workflow round-outcome script; this marker is not valid shell, so the round fails loudly rather than running a partial record (DESIGN 5: refuse, never widen)\n"

fn heal_round_outcome_rendered(statements: List<Node>, set_e: Bool) -> String {
  match bash_emit_stmts(statements: statements, set_e: set_e) {
    Accepted { value: text, diagnostics: _ } => text
    Rejected { diagnostics: ds } =>
      join([heal_round_outcome_render_refused_poison, " reasons: ", diagnostics_reason_lexemes(diagnostics: ds)], "")
  }
}
