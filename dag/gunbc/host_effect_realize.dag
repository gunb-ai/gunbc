) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let binding = host_effect_nbd_proxy_serve_session_binding(intent: intent, lease_key: lease_key)
  match host_effect_nbd_proxy_serve_apply(binding: binding, transport: transport) {
    NbdProxyServeApplyConverged { stdout: out } =>
      reconcile_grounded(
        apply_effect: intent_record,
        show_read: ReadObserved {
          value: ShellExecObserved {
            exit_code: 0,
            success: true,
            stdout: out,
            stderr: "",
          },
        },
        grounding: Grounds {
          evidence: ShellEffectApplied { exit_code: 0, stdout: out, stderr: "" },
        },
      )
    NbdProxyServeApplyRefused { reason: why } =>
      NotConverged { reason: why, applied: intent_record }
  }
}

data candidate_observation_locus_note: String = "THE CANDIDATE WAS OBSERVED IN THE DEPLOYING CHECKOUT, SO IT MAY ONLY LABEL A TREE THAT IS THAT CHECKOUT. observe_candidate_release reads git HEAD where the deploy program runs. On LocalShell the observation locus and the mutation locus are the same filesystem — the CI job installs from its own workspace — so the revision it read is the revision it installs, and baking that value into ExecStart is a true statement about the resulting process.\\n\\nOver SshShell they are two different machines. The revision came from the LOCAL checkout while the unit is written on the REMOTE host, whose tree arrived by some other path and at some other time; nothing in this fold establishes that they agree. Emitting the local sha there would produce a process that CONFIDENTLY REPORTS a release it may not be running, and readiness would then compare that fabricated label against the expectation that produced it and agree — a self-consistent false green, which is worse than no identity at all because the wrongness is invisible to every downstream check.\\n\\nSo the SSH arm REFUSES rather than labels. This is not a transport allow-list standing in for a model; the admission that is genuinely missing is the agreement between candidate observation locus, source transfer locus, and mutation locus, and until a source transfer is modeled that PROVES the remote tree is this candidate, refusing is the only honest arm (DESIGN section 5: a failure arm must refuse, never widen). EmitArtifactThenThinRun refuses for the same reason, one step further removed.\\n\\nRetract is deliberately not restricted here: it installs no release, carries no candidate, and therefore has no locus to agree about. DISSOLVES WHEN a modeled source transfer establishes remote-tree identity, at which point this arm carries the transferred candidate instead of refusing."

fn live_deploy_apply_candidate_locus_refusal(transport: HostEffectTransport) -> String {
  match transport {
    LocalShell => ""
    SshShell { ssh_host: h } =>
      join([
        "live_deploy apply refused over ssh host=", h,
        ": the candidate release was observed in the LOCAL deploying checkout, and no modeled source transfer proves the remote tree is that candidate. ",
        "Emitting the local revision into the remote unit would publish a release identity the process may not be running.",
      ], "")
    FleetSsh { target: t, context: _ } =>
      join([
        "live_deploy apply refused over fleet ssh endpoint=", t.endpoint as String,
        ": the candidate release was observed in the LOCAL deploying checkout, and no modeled source transfer proves the remote tree is that candidate. ",
        "Emitting the local revision into the remote unit would publish a release identity the process may not be running.",
      ], "")
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      "live_deploy apply refused over EmitArtifactThenThinRun: the candidate release was observed in the local deploying checkout and no modeled source transfer proves the executing tree is that candidate."
  }
}

fn realize_live_deploy_apply_on_host(
  spec: DeploymentSpec,
  candidate: CandidateRelease,
  transport: HostEffectTransport,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let locus_refusal = live_deploy_apply_candidate_locus_refusal(transport: transport)
  if locus_refusal != "" {
    NotConverged { reason: locus_refusal, applied: intent }
  } else {
    realize_shell_on_host(
      script: retained_srvn(
        body: live_deploy_apply_script_for(
          spec: spec,
          revision: RevisionBoundAtEmission { revision: candidate.revision },
        ),
        reason: "live_deploy apply (unit install + start)",
      ),
      transport: transport,
      intent: intent,
    )
  }
}

