fn host_effect_apply(target: NodeControlPlane, effect: HostEffect, evidence: IdempotencyEvidence, transport: HostEffectTransport) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let intent = HostEffectIntent {
    target: target,
    effect: effect,
    evidence: evidence,
    transport: transport,
    privilege_denial: none,
  }
  match resolve_host_effect_cell(target: target, effect: effect) {
    ShellOnHost { node: _, script: s } => realize_shell_on_host(script: s, transport: transport, intent: intent)
    ConvergeOnHost { node: _, host_converge: hc } =>
      realize_converge_on_host(host_converge: hc, transport: transport, intent: intent)
    TypedReconcileOnHost { node: _, kind: k } => realize_srv3_typed_reconcile(kind: k, transport: transport, intent: intent)
    OsInstallActuatorToolchainOnHost { node: _ } =>
      realize_os_install_actuator_toolchain_ensure(effect_intent: intent)
    ProvisionBuildCacheOnHost { node: _, desired: _ } =>
      realize_provision_build_cache(effect_intent: intent)
    ProvisionCodexRuntimeOnHost { node: _ } =>
      realize_provision_codex_runtime(effect_intent: intent)
    HostnameOnHost { node: _, hostnamectl_path: p, base: b, desired: d } =>
      realize_set_hostname_cas_on_host(hostnamectl_path: p, base: b, desired: d, transport: transport, intent: intent)
    HostnameReadOnHost { node: _ } =>
      realize_hostname_read_on_host(transport: transport, intent: intent)
    NbdProxySessionOnHost { node: _, intent: i, lease_key: k } =>
      realize_nbd_proxy_session_on_host(intent: i, lease_key: k, transport: transport, intent_record: intent)
    CodexSupervisedWorkerTurnOnHost { node: _, intent: i, lease_key: k } =>
      realize_codex_supervised_worker_turn_on_host(intent: i, lease_key: k, transport: transport, intent_record: intent)
    ReceiptEmitOnHost { node: _, lines: lines } =>
      realize_receipt_emit_on_host(lines: lines, intent: intent)
    BootOnceReadBackSleepOnHost { node: _ } =>
      realize_boot_once_read_back_sleep_on_host(transport: transport, intent: intent)
    SeededInstallMediaToolchainOnHost { node: _ } =>
      realize_seeded_install_media_toolchain_ensure_on_host(transport: transport, intent: intent)
    BmcwebSessionLoginOnHost { node: _ } =>
      realize_bmcweb_session_login_on_host(transport: transport, intent: intent)
    BmcwebTokenExtractOnHost { node: _ } =>
      realize_bmcweb_token_extract_on_host(transport: transport, intent: intent)
    EffectivePrincipalReadOnHost { node: _, read: r } =>
      realize_effective_principal_read_on_host(read: r, transport: transport, intent: intent)
    SudoNopasswdExecuteProbeOnHost { node: _, probe: p } =>
      realize_sudo_nopasswd_execute_probe_on_host(probe: p, transport: transport, intent: intent)
    SudoNopasswdGrantListProbeOnHost { node: _, probe: p } =>
      realize_sudo_nopasswd_grant_list_probe_on_host(probe: p, transport: transport, intent: intent)
    LiveDeployApplyOnHost { node: _, spec: s, candidate: c } =>
      realize_live_deploy_apply_on_host(spec: s, candidate: c, transport: transport, intent: intent)
    LiveDeployRetractOnHost { node: _, spec: s } =>
      realize_live_deploy_retract_on_host(spec: s, transport: transport, intent: intent)
    LiveDeployEnsureDependencyOnHost { node: _, dep: d } =>
      realize_live_deploy_ensure_dependency_on_host(dep: d, transport: transport, intent: intent)
    LiveDeployDigestReadbackOnHost { node: _, port: p } =>
      realize_live_deploy_digest_readback_on_host(port: p, transport: transport, intent: intent)
    EnsureActionsRunnerReleaseOnHost { node: _, runner_release: _ } =>
      runner_lifecycle_realize_ensure_actions_runner_release(intent: intent)
    EnsureRunnerSlotDirectoryOnHost { node: _, slot: _, artifact: _ } =>
      runner_lifecycle_realize_ensure_runner_slot_directory(intent: intent)
    EnsureRunnerJitWrapperOnHost { node: _, host_label: _ } =>
      runner_lifecycle_realize_ensure_runner_jit_wrapper(intent: intent)
    EnsureRunnerSystemdTemplateOnHost { node: _, host_label: _ } =>
      runner_lifecycle_realize_ensure_runner_systemd_template(intent: intent)
    EnsureRunnerMemoryCapsOnHost { node: _, slot: _ } =>
      runner_lifecycle_realize_ensure_runner_memory_caps(intent: intent)
    ActivateRunnerSlotOnHost { node: _, slot: _ } =>
      runner_lifecycle_realize_activate_runner_slot(intent: intent)
    ReplaceRunnerIncarnationOnHost { node: _, from: _, cause: _ } =>
      runner_lifecycle_realize_replace_runner_incarnation(intent: intent)
    ObserveRunnerLocalStateOnHost { node: _, slot: _ } =>
      runner_lifecycle_realize_observe_runner_local_state(intent: intent)
    ObserveGitHubRunnerRegistrationOnHost { node: _, slot: _, organization: _ } =>
      runner_lifecycle_realize_observe_github_runner_registration(intent: intent)
    RedfishOnBmc { node: _, action: _ } =>
      NotConverged { reason: "host_effect_apply: RedfishAction realization is a fail-closed Unimplemented stub in Phase A; neat-boar-71 realizes it over RedfishRest in Phase C. No plausible no-op for a power/boot action (DESIGN section 5).", applied: intent }
    IncompatibleCell { reason: why } => NotConverged { reason: why, applied: intent }
  }
}

fn host_effect_privilege_verdict(
  access: DeployAccess,
  fixture_actor: DeployAccessActor?
) -> AccessDecision {
  match fixture_actor {
    Present { value: actor } => deploy_access_check(access: access, actor: actor)
    Absent => deploy_access_check_observed(access: access)
  }
}

fn deploy_access_host_target(access: DeployAccess) -> NodeControlPlane {
  HostOs { node: access.host }
}

fn deploy_access_shell_apply_success_stdout(
  access: DeployAccess,
  effect: HostEffect,
) -> String? {
  match host_effect_apply(
    target: deploy_access_host_target(access: access),
    effect: effect,
    evidence: host_effect_read_evidence,
    transport: access.transport,
  ) {
    Converged { evidence: e, applied: _ } =>
      match e {
        ShellEffectApplied { stdout: out, exit_code: code, stderr: _ } =>
          if code == 0 {
            Present { value: out }
          } else {
            none
          }
        ConvergePlanApplied { stdout: _, exit_code: _ } => Absent
      }
    NotConverged { reason: _, applied: _ } => Absent
  }
}

fn deploy_access_observed_principal(access: DeployAccess) -> NonEmptyStr? {
  match deploy_access_shell_apply_success_stdout(
    access: access,
    effect: deploy_access_read_principal_effect(),
  ) {
    Present { value: stdout } => deploy_access_principal_line(success: true, stdout: stdout)
    Absent => Absent
  }
}

fn deploy_access_sudo_check_cmd(access: DeployAccess, cmd: PrivilegedCommand) -> Bool {
  match deploy_access_shell_apply_success_stdout(
    access: access,
    effect: deploy_access_sudo_probe_effect(cmd: cmd),
  ) {
    Present { value: _ } => true
    Absent => false
  }
}

fn deploy_access_sudo_all_granted(access: DeployAccess) -> Bool {
  fold_list(
    xs: access.privileged_commands,
    empty: true,
    cons: (acc, cmd) => if !acc { false } else { deploy_access_sudo_check_cmd(access: access, cmd: cmd) }
  )
}

fn deploy_access_observed_actor(access: DeployAccess) -> DeployAccessActor? {
  match deploy_access_observed_principal(access: access) {
    Present { value: observed_name } =>
      Present {
        value: DeployAccessActor {
          observed_name: observed_name,
          sudo_granted: deploy_access_sudo_all_granted(access: access),
        }
      }
    Absent => Absent
  }
}

fn deploy_access_check_observed(access: DeployAccess) -> AccessDecision {
  match deploy_access_observed_actor(access: access) {
    Present { value: actor } => deploy_access_check(access: access, actor: actor)
    Absent =>
      access_policy_refusal(
        profile: "deploy-access-observation", subject: "unobserved", action: "execute", object: "host-effect",
        reason: concat(
            deploy_access_refusal_prefix,
            " — could not observe principal (ReadEffectivePosixPrincipal failed)"
          ),
      )
  }
}

fn host_effect_apply_gated(
  access: DeployAccess,
  target: NodeControlPlane,
  effect: HostEffect,
  evidence: IdempotencyEvidence,
  transport: HostEffectTransport,
  fixture_actor: DeployAccessActor?
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let intent = HostEffectIntent {
    target: target,
    effect: effect,
    evidence: evidence,
    transport: transport,
    privilege_denial: none,
  }
  let verdict = host_effect_privilege_verdict(access: access, fixture_actor: fixture_actor)
  match verdict {
    Permit =>
      match resolve_host_effect_cell(target: target, effect: effect) {
        ShellOnHost { node: _, script: s } => realize_shell_on_host(script: s, transport: transport, intent: intent)
        ConvergeOnHost { node: _, host_converge: hc } =>
          realize_converge_on_host(host_converge: hc, transport: transport, intent: intent)
        TypedReconcileOnHost { node: _, kind: k } => realize_srv3_typed_reconcile(kind: k, transport: transport, intent: intent)
        OsInstallActuatorToolchainOnHost { node: _ } =>
          realize_os_install_actuator_toolchain_ensure(effect_intent: intent)
        ProvisionBuildCacheOnHost { node: _, desired: _ } =>
          realize_provision_build_cache(effect_intent: intent)
        ProvisionCodexRuntimeOnHost { node: _ } =>
          realize_provision_codex_runtime(effect_intent: intent)
        HostnameOnHost { node: _, hostnamectl_path: p, base: b, desired: d } =>
          realize_set_hostname_cas_on_host(hostnamectl_path: p, base: b, desired: d, transport: transport, intent: intent)
        HostnameReadOnHost { node: _ } =>
          realize_hostname_read_on_host(transport: transport, intent: intent)
        NbdProxySessionOnHost { node: _, intent: i, lease_key: k } =>
          realize_nbd_proxy_session_on_host(intent: i, lease_key: k, transport: transport, intent_record: intent)
        CodexSupervisedWorkerTurnOnHost { node: _, intent: i, lease_key: k } =>
          realize_codex_supervised_worker_turn_on_host(intent: i, lease_key: k, transport: transport, intent_record: intent)
        ReceiptEmitOnHost { node: _, lines: lines } =>
          realize_receipt_emit_on_host(lines: lines, intent: intent)
        BootOnceReadBackSleepOnHost { node: _ } =>
          realize_boot_once_read_back_sleep_on_host(transport: transport, intent: intent)
        SeededInstallMediaToolchainOnHost { node: _ } =>
          realize_seeded_install_media_toolchain_ensure_on_host(transport: transport, intent: intent)
        BmcwebSessionLoginOnHost { node: _ } =>
          realize_bmcweb_session_login_on_host(transport: transport, intent: intent)
        BmcwebTokenExtractOnHost { node: _ } =>
          realize_bmcweb_token_extract_on_host(transport: transport, intent: intent)
        EffectivePrincipalReadOnHost { node: _, read: r } =>
          realize_effective_principal_read_on_host(read: r, transport: transport, intent: intent)
        SudoNopasswdExecuteProbeOnHost { node: _, probe: p } =>
          realize_sudo_nopasswd_execute_probe_on_host(probe: p, transport: transport, intent: intent)
        SudoNopasswdGrantListProbeOnHost { node: _, probe: p } =>
          realize_sudo_nopasswd_grant_list_probe_on_host(probe: p, transport: transport, intent: intent)
        LiveDeployApplyOnHost { node: _, spec: s, candidate: c } =>
          realize_live_deploy_apply_on_host(spec: s, candidate: c, transport: transport, intent: intent)
        LiveDeployRetractOnHost { node: _, spec: s } =>
          realize_live_deploy_retract_on_host(spec: s, transport: transport, intent: intent)
        LiveDeployEnsureDependencyOnHost { node: _, dep: d } =>
          realize_live_deploy_ensure_dependency_on_host(dep: d, transport: transport, intent: intent)
        LiveDeployDigestReadbackOnHost { node: _, port: p } =>
          realize_live_deploy_digest_readback_on_host(port: p, transport: transport, intent: intent)
        EnsureActionsRunnerReleaseOnHost { node: _, runner_release: _ } =>
          runner_lifecycle_realize_ensure_actions_runner_release(intent: intent)
        EnsureRunnerSlotDirectoryOnHost { node: _, slot: _, artifact: _ } =>
          runner_lifecycle_realize_ensure_runner_slot_directory(intent: intent)
        EnsureRunnerJitWrapperOnHost { node: _, host_label: _ } =>
          runner_lifecycle_realize_ensure_runner_jit_wrapper(intent: intent)
        EnsureRunnerSystemdTemplateOnHost { node: _, host_label: _ } =>
          runner_lifecycle_realize_ensure_runner_systemd_template(intent: intent)
        EnsureRunnerMemoryCapsOnHost { node: _, slot: _ } =>
          runner_lifecycle_realize_ensure_runner_memory_caps(intent: intent)
        ActivateRunnerSlotOnHost { node: _, slot: _ } =>
          runner_lifecycle_realize_activate_runner_slot(intent: intent)
        ReplaceRunnerIncarnationOnHost { node: _, from: _, cause: _ } =>
          runner_lifecycle_realize_replace_runner_incarnation(intent: intent)
        ObserveRunnerLocalStateOnHost { node: _, slot: _ } =>
          runner_lifecycle_realize_observe_runner_local_state(intent: intent)
        ObserveGitHubRunnerRegistrationOnHost { node: _, slot: _, organization: _ } =>
          runner_lifecycle_realize_observe_github_runner_registration(intent: intent)
        RedfishOnBmc { node: _, action: _ } =>
          NotConverged { reason: "host_effect_apply: RedfishAction realization is a fail-closed Unimplemented stub in Phase A; neat-boar-71 realizes it over RedfishRest in Phase C. No plausible no-op for a power/boot action (DESIGN section 5).", applied: intent }
        IncompatibleCell { reason: why } => NotConverged { reason: why, applied: intent }
      }
    Deny { refusal: _ } =>
      NotConverged {
        reason: deploy_access_decision_reason(d: verdict),
        applied: HostEffectIntent {
          target: target,
          effect: effect,
          evidence: evidence,
          transport: transport,
          privilege_denial: Present { value: verdict },
        },
      }
  }
}

type ConvergeDirective = Settled | ReDrive | Refused { reason: String }

fn not_converged_directive(drive: Drive) -> ConvergeDirective {
  match drive {
    OneShot => Settled
    ConvergeLoop => ReDrive
  }
}

fn host_effect_drive_directive(r: Reconciliation<HostEffectIntent, HostEffectEvidence>) -> ConvergeDirective {
  match r {
    Converged { evidence: _, applied: _ } => Settled
    NotConverged { reason: why, applied: intent } =>
      match intent.privilege_denial {
        Present { value: Deny { refusal: _ } } => Refused { reason: why }
        Present { value: Permit } => not_converged_directive(drive: host_effect_drive(intent: intent))
        Absent =>
          match resolve_host_effect_cell(target: intent.target, effect: intent.effect) {
            IncompatibleCell { reason: inner_why } => Refused { reason: inner_why }
            ShellOnHost { node: _, script: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            ConvergeOnHost { node: _, host_converge: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            TypedReconcileOnHost { node: _, kind: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            OsInstallActuatorToolchainOnHost { node: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            ProvisionBuildCacheOnHost { node: _, desired: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            ProvisionCodexRuntimeOnHost { node: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            HostnameOnHost { node: _, hostnamectl_path: _, base: _, desired: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            HostnameReadOnHost { node: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            NbdProxySessionOnHost { node: _, intent: _, lease_key: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            CodexSupervisedWorkerTurnOnHost { node: _, intent: _, lease_key: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            ReceiptEmitOnHost { node: _, lines: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            BootOnceReadBackSleepOnHost { node: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            SeededInstallMediaToolchainOnHost { node: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            BmcwebSessionLoginOnHost { node: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            BmcwebTokenExtractOnHost { node: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            EffectivePrincipalReadOnHost { node: _, read: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            SudoNopasswdExecuteProbeOnHost { node: _, probe: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            SudoNopasswdGrantListProbeOnHost { node: _, probe: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            LiveDeployApplyOnHost { node: _, spec: _, candidate: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            LiveDeployRetractOnHost { node: _, spec: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            LiveDeployEnsureDependencyOnHost { node: _, dep: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            LiveDeployDigestReadbackOnHost { node: _, port: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            EnsureActionsRunnerReleaseOnHost { node: _, runner_release: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            EnsureRunnerSlotDirectoryOnHost { node: _, slot: _, artifact: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            EnsureRunnerJitWrapperOnHost { node: _, host_label: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            EnsureRunnerSystemdTemplateOnHost { node: _, host_label: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            EnsureRunnerMemoryCapsOnHost { node: _, slot: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            ActivateRunnerSlotOnHost { node: _, slot: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            ReplaceRunnerIncarnationOnHost { node: _, from: _, cause: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            ObserveRunnerLocalStateOnHost { node: _, slot: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            ObserveGitHubRunnerRegistrationOnHost { node: _, slot: _, organization: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
            RedfishOnBmc { node: _, action: _ } => not_converged_directive(drive: host_effect_drive(intent: intent))
          }
      }
  }
}

data provision_observes_before_it_acts_note: String = "THE PREFLIGHT IS NOW THE GATE, AND WHAT IT REPLACED WAS AN UNCONDITIONAL WRITE. Until this landed, realize_provision_build_cache had exactly one check ahead of it -- the catalog gate, which is pure id validation in a third module and never observes a host at all -- and then rendered the unit, installed it, and restarted it on every pass. The two authorities that were supposed to decide whether that was safe (gunbc.build_cache_ensure admit_ensure_build_cache_instance, gunbc.host_build_cache_provision placement_verdict) had zero production callers, so the refusal named as the remedy for a measured CI-capacity incident was computed by nothing. That is the rung inflation DESIGN section 4b calls worse than sitting low: the witnesses were green, and their greenness established that the fold was correct, not that the class was guarded.\n\nTHE ORDER IS OBSERVE, ADMIT, ACT, AND IT IS LOAD-BEARING RATHER THAN TIDY. Observing after acting would read back the state we just wrote, which is the same fabricated evidence gunbc.host_build_cache_provision build_cache_supervision_observation_note measured on srv3: a probe that greens on what it produced rather than on the state the lane exists to establish. Every read here happens BEFORE the first mutation, and the admission decides from those reads alone.\n\nWHAT THIS CHANGES ON A LIVE HOST, in the two arms that matter. A host whose managed unit already owns the endpoint AND IS OBSERVED LISTENING ON IT now converges WITHOUT reinstalling and restarting it (ownership alone is not enough, and was not enough here even before it was written down: gunbc.build_cache_ensure ensure_is_a_reconcile_not_an_install_note records the 2026-08-22 correction, under which our own unit holding its socket open without listening REFUSES with the unit named instead of converging over an unreachable cache) -- the most expensive possible no-op, which used to fire on every convergence pass and re-cold every compile on the host. And a host whose endpoint is owned by a runner slot -- srv1 on 2026-08-01, srv1-02 again on 2026-08-07 -- now REFUSES with the owner located, where it previously wrote a unit beside the stranded server and reported success."

fn build_cache_host_read(command: ArgvCommand, transport: HostEffectTransport) -> HostRead {
  match build_cache_host_read_observed(command: command, transport: transport) {
    BuildCacheReadRan { observed: o } =>
      if o.success == true {
        HostReadText { text: o.stdout }
      } else {
        HostReadFailed {
          detail: join(
            [
              "the read exited ",
              to_string(o.exit_code),
              ": ",
              if o.stderr == "" { o.stdout } else { o.stderr },
            ],
            "",
          ) as NonEmptyStr,
        }
      }
    BuildCacheReadRefused { reason: why } => HostReadFailed { detail: why as NonEmptyStr }
  }
}

type BuildCacheReadResult
  = BuildCacheReadRan { observed: ShellExecObserved }
  | BuildCacheReadRefused { reason: String }

data every_read_is_one_argv_note: String = "EVERY READ BELOW IS ONE ARGV, NO SHELL. That is not stylistic: this module's build-cache surface is a shell-to-dag census A5 row whose standing constraint is that its emitted shell may shrink and must not grow, so an observation added as a concat-built bash body would have grown precisely the surface #5828 exists to dissolve. Routing the reads through the typed argv seam instead means the observation lands in the direction the dissolve-on points, and the remaining concat-shell body -- the ensure step, still unconverted -- is strictly smaller as a share of what this effect does than it was."

// IT TAKES A COMMAND RATHER THAN A WORD LIST, for the same reason bmc_netboot_run_bmc now does: a
// List<String> parameter is a place an argv can be hand-spelled, and one of this function's callers
// was doing exactly that ("stat", "-c", "%i", ...). The ssh arms still need the flat vector, which
// they derive here with argv_words instead of receiving pre-flattened.
fn build_cache_host_read_observed(
  command: ArgvCommand,
  transport: HostEffectTransport,
) -> BuildCacheReadResult {
  match transport {
    LocalShell =>
      match run_shell_command_capture(
        command: command,
        transport: LocalExec,
      ) {
        ProcessOutputPresent { text: t } =>
          BuildCacheReadRan {
            observed: ShellExecObserved { exit_code: 0, success: true, stdout: t, stderr: "" },
          }
        ProcessOutputAbsent =>
          BuildCacheReadRan {
            observed: ShellExecObserved { exit_code: 0, success: true, stdout: "", stderr: "" },
          }
        ProcessRefused { exit_code: code, stderr: err } =>
          BuildCacheReadRan {
            observed: ShellExecObserved { exit_code: code, success: false, stdout: "", stderr: err },
          }
      }
    SshShell { ssh_host: _ } => build_cache_typed_argv_read(argv: argv_words(command: command), transport: transport)
    FleetSsh { target: _, context: _ } => build_cache_typed_argv_read(argv: argv_words(command: command), transport: transport)
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      BuildCacheReadRefused {
        reason: "host_effect_apply: EnsureBuildCacheInstance cannot observe an endpoint over EmitArtifactThenThinRun; typed mismatch.",
      }
  }
}

fn build_cache_typed_argv_read(
  argv: List<String>,
  transport: HostEffectTransport,
) -> BuildCacheReadResult {
  match run_typed_argv_transport(argv: argv, transport: transport) {
    TypedArgvExecConverged { result: r } =>
      BuildCacheReadRan {
        observed: ShellExecObserved { exit_code: r.exit_code, success: r.success, stdout: r.stdout, stderr: r.stderr },
      }
    TypedArgvExecRefused { reason: why } => BuildCacheReadRefused { reason: why }
  }
}

fn build_cache_path_kind_read(
  instance: BuildCacheInstance,
  transport: HostEffectTransport,
) -> EndpointPathKind {
  match instance.endpoint {
    SccacheServerTcpPort { port: _ } => PathKindNoFilesystemPath
    SccacheServerUnixSocket { path: p } =>
      match build_cache_host_read_observed(command: endpoint_path_kind_command(path: p), transport: transport) {
        BuildCacheReadRefused { reason: why } =>
          path_kind_of_stat_read(read: HostReadFailed { detail: why as NonEmptyStr }, exit_success: true)
        BuildCacheReadRan { observed: o } =>
          path_kind_of_stat_read(
            read: HostReadText { text: o.stdout },
            exit_success: o.success,
          )
      }
  }
}

data unread_owner_facts_are_failures_not_blanks_note: String = "WHEN NO OWNER RESOLVES, THE OWNER READS ARE NOT PERFORMED AND SAY SO. The alternative -- issuing cat /proc//cgroup against a pid that does not exist and letting it fail -- would reach the same arms by accident and cost four round trips per pass to do it. Filling them with a positively-named HostReadFailed keeps the decode on one path (gunbc.build_cache_endpoint_observe unreachable_is_a_read_state_not_a_short_circuit_note makes the same move for an unreachable host) while making the reason for the absence readable rather than inferred from a contrived errno."

data owner_facts_unread_detail: NonEmptyStr = "no single listening owner resolved at the endpoint, so the owner's cgroup, start time, principal and executable were not read"

data tcp_endpoint_observation_is_unmodeled_note: String = "A TCP-ENDPOINT INSTANCE REFUSES RATHER THAN BEING OBSERVED THROUGH THE UNIX CHAIN. /proc/net/unix answers for unix sockets only; the TCP equivalent is /proc/net/tcp with its own hex-encoded address columns and its own decode, which nothing in this repository has modeled. No BuildCacheInstance in the tree carries a TCP endpoint today -- both ci_cache_instance and session_cache_instance are unix sockets -- so this is an unbuilt arm rather than a live gap, and it is a POSITIVE typed refusal so that the day one is authored it stops the line instead of being silently classified through a table that cannot see it. An earlier revision reached ss for both shapes, which appeared to support TCP and was never exercised against one; an untested arm that answers is worse than one that refuses."

fn build_cache_listen_inode_read(
  instance: BuildCacheInstance,
  transport: HostEffectTransport,
) -> EndpointInodeLookup {
  match instance.endpoint {
    SccacheServerTcpPort { port: _ } =>
      InodeLookupUndecided {
        detail: "this instance's endpoint is a TCP port; endpoint ownership for TCP would be read from /proc/net/tcp, which this repository has not modeled. Refusing rather than reporting an unobserved placement." as NonEmptyStr,
      }
    SccacheServerUnixSocket { path: p } =>
      listen_inode_at_path(
        read: build_cache_host_read(command: proc_net_unix_read_command(), transport: transport),
        path: p,
      )
  }
}

fn build_cache_fd_holder_read(
  listen_inode: EndpointInodeLookup,
  instance: BuildCacheInstance,
  transport: HostEffectTransport,
) -> EndpointListenerRead {
  match listen_inode {
    InodeLookupUndecided { detail: d } => ListenerUndecided { detail: d }
    ListenInodeFound { inode: n } =>
      fd_holder_of_find_output(read: build_cache_socket_holder_read(inode: n, transport: transport))
    NoListenEntryAtPath =>
      match instance.endpoint {
        SccacheServerTcpPort { port: _ } => ListenerNone
        SccacheServerUnixSocket { path: p } =>
          match build_cache_socket_inode_at_path(path: p, transport: transport) {
            Absent => ListenerNone
            Present { value: n } =>
              fd_holder_of_find_output(read: build_cache_socket_holder_read(inode: n, transport: transport))
          }
      }
  }
}

data holder_walk_runs_on_the_unlistened_socket_too_note: String = "WHEN THERE IS NO LISTEN ENTRY THE WALK STILL RUNS, against the inode read off the FILE rather than off /proc/net/unix, and that is the whole of clause (3). A socket with no LISTEN entry is either stale (nothing holds it) or held open by a process that is not listening (unlinking severs it). Those two states are indistinguishable without asking whether any descriptor resolves to the file's inode, so skipping the walk here because 'nothing is listening' would collapse them -- and collapse them in the direction that unlinks a live process's socket."

fn build_cache_socket_inode_at_path(path: NonEmptyStr, transport: HostEffectTransport) -> NonEmptyStr? {
  match build_cache_host_read_observed(command: stat_inode_command(path: path as String), transport: transport) {
    BuildCacheReadRefused { reason: _ } => none
    BuildCacheReadRan { observed: o } =>
      if o.success == true {
        match trim(o.stdout) {
          "" => none
          inode => Present { value: inode as NonEmptyStr }
        }
      } else {
        none
      }
  }
}

fn build_cache_socket_holder_read(inode: NonEmptyStr, transport: HostEffectTransport) -> HostRead {
  match transport {
    LocalShell => {
      let r = shell.Find.SocketInodeHolders(inode: inode)
      if r.success {
        HostReadText { text: r.stdout }
      } else {
        HostReadFailed {
          detail: concat("the /proc fd walk for this endpoint's socket inode failed: ", r.stderr) as NonEmptyStr,
        }
      }
    }
    SshShell { ssh_host: _ } => build_cache_host_read(argv: socket_inode_holder_argv(inode: inode), transport: transport)
    FleetSsh { target: _, context: _ } => build_cache_host_read(argv: socket_inode_holder_argv(inode: inode), transport: transport)
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      HostReadFailed {
        detail: "EnsureBuildCacheInstance cannot walk /proc over EmitArtifactThenThinRun; typed mismatch." as NonEmptyStr,
      }
  }
}

fn socket_inode_holder_argv(inode: NonEmptyStr) -> List<String> {
  ["find", "/proc", "-maxdepth", "3", "-path", "*/fd/*", "-lname", concat("socket:?", concat(inode as String, "?"))]
}

fn build_cache_endpoint_reads(
  instance: BuildCacheInstance,
  transport: HostEffectTransport,
) -> BuildCacheEndpointReads {
  let boot_id = build_cache_host_read(command: boot_id_read_command(), transport: transport)
  let path_kind = build_cache_path_kind_read(instance: instance, transport: transport)
  let listen_inode = build_cache_listen_inode_read(instance: instance, transport: transport)
  let listener = build_cache_fd_holder_read(listen_inode: listen_inode, instance: instance, transport: transport)
  match listener {
    ListenerOwnerPid { pid: pid } =>
      BuildCacheEndpointReads {
        boot_id: boot_id,
        path_kind: path_kind,
        listen_inode: listen_inode,
        listener: listener,
        owner_cgroup: build_cache_host_read(argv: owner_cgroup_argv(pid: pid), transport: transport),
        owner_proc_stat: build_cache_host_read(argv: owner_proc_stat_argv(pid: pid), transport: transport),
        owner_principal: build_cache_host_read(argv: owner_principal_argv(pid: pid), transport: transport),
        owner_executable: build_cache_host_read(argv: owner_executable_argv(pid: pid), transport: transport),
      }
    ListenerNone =>
      build_cache_reads_without_owner(boot_id: boot_id, path_kind: path_kind, listen_inode: listen_inode, listener: listener)
    ListenerAmbiguous { candidate_count: _ } =>
      build_cache_reads_without_owner(boot_id: boot_id, path_kind: path_kind, listen_inode: listen_inode, listener: listener)
    ListenerUndecided { detail: _ } =>
      build_cache_reads_without_owner(boot_id: boot_id, path_kind: path_kind, listen_inode: listen_inode, listener: listener)
  }
}

fn build_cache_reads_without_owner(
  boot_id: HostRead,
  path_kind: EndpointPathKind,
  listen_inode: EndpointInodeLookup,
  listener: EndpointListenerRead,
) -> BuildCacheEndpointReads {
  BuildCacheEndpointReads {
    boot_id: boot_id,
    path_kind: path_kind,
    listen_inode: listen_inode,
    listener: listener,
    owner_cgroup: HostReadFailed { detail: owner_facts_unread_detail },
    owner_proc_stat: HostReadFailed { detail: owner_facts_unread_detail },
    owner_principal: HostReadFailed { detail: owner_facts_unread_detail },
    owner_executable: HostReadFailed { detail: owner_facts_unread_detail },
  }
}

data unlink_is_a_separate_admitted_step_note: String = "THE UNLINK RUNS AS ITS OWN COMMAND BEFORE THE ENSURE, WHICH IS WHAT gunbc.build_cache_endpoint_path no_unconditional_execstartpre_note REQUIRES. Folding it into the unit as ExecStartPre would unlink in every path state rather than the one state where unlinking is correct -- harmless under an absent path, destructive under a conflict, and silently fatal under a live listener. Here it is reached only from EndpointClearedByUnlink, which admit_stale_socket_unlink produces only from an observed stale socket under a current boot id, and a failure to remove the file refuses the whole effect rather than proceeding into a bind that error 98 would fail anyway."

fn build_cache_unlink_then_ensure(
  instance: BuildCacheInstance,
  preflight: EndpointPreflight,
  transport: HostEffectTransport,
  effect_intent: HostEffectIntent,
  observed_path: EndpointPathState,
  currency: ObservationCurrency,
  token: NonEmptyStr,
  digest: Digest,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match preflight {
    EndpointClearForBind =>
      build_cache_ensure_step(
        instance: instance, transport: transport, effect_intent: effect_intent,
        token: token, digest: digest,
      )
    EndpointClearedByUnlink { stale_detail: _ } =>
      match stale_socket_unlink_command(
        admission: admit_stale_socket_unlink(instance: instance, observed: observed_path, currency: currency),
      ) {
        StaleSocketUnlinkCommandRefused { reason: why } =>
          NotConverged {
            reason: join(
              ["host_effect_apply: EnsureBuildCacheInstance was admitted behind a stale-socket unlink that then refused to build a command -- ", why as String],
              "",
            ),
            applied: effect_intent,
          }
        StaleSocketUnlinkCommandReady { command: cmd } =>
          match build_cache_host_read_observed(command: cmd, transport: transport) {
            BuildCacheReadRefused { reason: why } =>
              NotConverged {
                reason: join(["host_effect_apply: EnsureBuildCacheInstance could not run the admitted stale-socket unlink -- ", why], ""),
                applied: effect_intent,
              }
            BuildCacheReadRan { observed: o } =>
              if o.success == true {
                build_cache_ensure_step(
                  instance: instance, transport: transport, effect_intent: effect_intent,
                  token: token, digest: digest,
                )
              } else {
                NotConverged {
                  reason: join(
                    [
                      "host_effect_apply: EnsureBuildCacheInstance refused -- the admitted stale-socket unlink exited ",
                      to_string(o.exit_code),
                      ", so the endpoint path is still occupied and a bind would fail with address-in-use: ",
                      o.stderr,
                    ],
                    "",
                  ),
                  applied: effect_intent,
                }
              }
          }
      }
  }
}

data both_authorities_are_consumed_and_neither_is_duplicated_note: String = "TWO AUTHORITIES, TWO DIFFERENT QUESTIONS, ONE EACH SIDE OF THE ACT. gunbc.build_cache_ensure admit_ensure_build_cache_instance is the PRECONDITION -- may this host be written to at all, given who owns the endpoint and what is at the path -- and it runs before the first mutation. gunbc.host_build_cache_provision provision_build_cache_verdict is the POSTCONDITION -- given what the ensure produced, is this host converged -- and it runs after. The shell-to-dag census C-note found both unconsumed and called them one wiring job; they are, and this is that job, but they are not one check applied twice: the precondition can refuse a host the postcondition would never see, and the postcondition catches the case that motivated it, an ensure that reports success while the endpoint ends up owned by something other than the unit just written.\n\nTHE PLACEMENT IN THE POSTCONDITION IS RE-OBSERVED, NOT CARRIED FORWARD FROM THE PREFLIGHT. Reusing the preflight's placement would be asserting a fact measured before the mutation about the state after it, which is the read-back that greens on evidence it produced, one step removed. So the endpoint is surveyed again and the second survey is what the verdict folds -- which is also what makes the check discriminating: the whole point is that the pre-state and the post-state can differ.\n\nONE RESIDUE, NAMED RATHER THAN DISCOVERED IN PRODUCTION: the post-survey races the unit start. systemctl restart returns when the unit is active, and the server binds its endpoint during its own startup, so there is a window in which the endpoint has no listener yet and the post-survey reads ServerPlacementAbsent -- a FALSE RefusalDaemonAbsent. It is bounded in the right direction: the failure is a loud refusal on an idempotent operation, so the next converge pass reads the settled state and converges, and no host is left silently misreported. It is NOT fixed here because fixing it properly means waiting on an observable readiness condition rather than sleeping, and a readiness predicate for this endpoint is its own piece of modeling. DISSOLVE-ON: an endpoint-readiness observation the ensure step can wait on, at which point the post-survey runs after it rather than after systemctl returns."

fn build_cache_daemon_observation_of_receipt(
  observed: ShellExecObserved,
  placement: BuildCacheServerPlacement,
) -> BuildCacheDaemonObservation {
  if string_contains(s: observed.stdout, pattern: "observe=misconfigured fragment=") {
    DaemonMisconfigured {
      matched_fragment: "observe=misconfigured",
      detail: observed.stdout as NonEmptyStr,
    }
  } else if observed.success && string_contains(s: observed.stdout, pattern: "read_back=ok") {
    DaemonStatsOk { stats_line: observed.stdout, placement: placement }
  } else if observed.success == true {
    DaemonUnresponsive {
      detail: "the build-cache ensure exited zero without printing its read_back=ok receipt, so the daemon was never confirmed to answer after the ensure" as NonEmptyStr,
    }
  } else {
    DaemonUnresponsive {
      detail: join(
        [
          "the build-cache ensure exited ",
          to_string(observed.exit_code),
          ": ",
          if observed.stderr == "" { observed.stdout } else { observed.stderr },
        ],
        "",
      ) as NonEmptyStr,
    }
  }
}

fn build_cache_ensure_step(
  instance: BuildCacheInstance,
  transport: HostEffectTransport,
  effect_intent: HostEffectIntent,
  token: NonEmptyStr,
  digest: Digest,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let observed = run_shell_transport(
    script: retained_srvn(
      body: build_cache_provision_shell_script(instance: instance, arch_token: token, digest: digest),
      reason: "srvN build-cache provisioning (sccache daemon ensure)",
    ),
    transport: transport,
  )
  let after = survey_build_cache_endpoint(
    instance: instance,
    reads: build_cache_endpoint_reads(instance: instance, transport: transport),
  )
  match provision_build_cache_verdict(
    catalog_id: instance.implementation,
    observed: build_cache_daemon_observation_of_receipt(observed: observed, placement: after.placement),
  ) {
    BuildCacheProvisionRefused { cause: _, reason: why } =>
      NotConverged {
        reason: join(
          ["host_effect_apply: EnsureBuildCacheInstance ran its ensure and the read-back refused -- ", why as String],
          "",
        ),
        applied: effect_intent,
      }
    BuildCacheProvisionConverged { catalog_id: _, stats_line: _ } =>
      provision_build_cache_reconcile(observed: observed, intent: effect_intent)
  }
}

data already_converged_evidence_is_the_observation_note: String = "THE ALREADY-CONVERGED ARM RETURNS ShellEffectApplied WITH exit_code 0 AND NO SHELL HAVING RUN, and that is worth stating because it looks like a fabricated receipt and is not. HostEffectEvidence has two arms and neither names an observation, so the evidence carrier cannot yet distinguish 'a command ran and succeeded' from 'a read established that nothing needed to run'. What the receipt carries is the observation itself -- the unit found owning the endpoint -- rather than invented command output, so a reader sees WHY it converged. DISSOLVE-ON: a HostEffectEvidence arm for an observation-grounded convergence, at which point this arm names it and the exit_code 0 goes away. Until then the honest thing is to say so here rather than let the zero read as a process exit."

fn build_cache_already_converged(
  unit: NonEmptyStr,
  effect_intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  Converged {
    evidence: ShellEffectApplied {
      exit_code: 0,
      stdout: join(
        [
          "BuildCacheProvisionReceipt: already_converged unit=",
          unit as String,
          " (observed owning AND listening on the configured endpoint; no unit written, no restart issued)",
        ],
        "",
      ),
      stderr: "",
    },
    applied: effect_intent,
  }
}
