}

fn realize_codex_supervised_worker_turn_on_host(
  intent: CodexAppServerStdioSessionIntent,
  lease_key: NonEmptyStr,
  transport: HostEffectTransport,
  intent_record: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let cmd_id_read = Filesystem.Read(path: intent.client_command_id_path)
  if cmd_id_read.success == false || cmd_id_read.content == "" {
    NotConverged {
      reason: "CodexSupervisedWorkerTurn: client_command_id unreadable at persisted path before session apply",
      applied: intent_record,
    }
  } else {
    match host_effect_codex_supervised_turn_apply(
      intent: intent,
      lease_key: lease_key,
      client_command_id: cmd_id_read.content as NonEmptyStr,
      transport: transport,
    ) {
      CodexSupervisedSessionApplyConverged {
        stdout: out,
        stderr: err,
        exit_code: code,
      } =>
        reconcile_shell_exec_observed(
          observed: ShellExecObserved {
            exit_code: code,
            success: code == 0,
            stdout: out,
            stderr: err,
          },
          intent: intent_record,
        )
      CodexSupervisedSessionApplyRefused { reason: why } =>
        NotConverged { reason: why, applied: intent_record }
    }
  }
}

