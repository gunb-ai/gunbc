// THE VERDICT IS PRODUCED BEFORE THE WRITE, NOT CHECKED AFTER IT (DESIGN §5).
// This extraction ran a `jq -r` filter of `.token` falling back to `empty` via jq's
// alternative operator (two literal slashes in the filter text, elided here so this
// comment itself stays parseable), and that alternative makes an ABSENT or NULL
// `.token` a run that prints nothing and exits 0 — indistinguishable, at the exit
// status the caller reads, from a token that was found. The realization then wrote
// jq_run.stdout to srv3_bmcweb_token_path unconditionally and reconciled on the WRITE's
// success, so a rejected or malformed BMC login produced an EMPTY CREDENTIAL FILE reported
// as Converged: the fabricated plausible output DESIGN §5 forbids, at a credential seam.
// BmcwebTokenExtraction, not the flag, is the wall. `-e` is loudness at the transport — jq
// exits 1 on a null/false last output and 4 when the filter produced none, so jq itself
// reports the absence instead of leaving the caller to infer it from empty output — but it
// is deliberately NOT what this fold relies on, for two reasons. `-e` reads the LAST OUTPUT,
// so on an arbitrary filter it would convert a legitimate `false` or `null` extraction into
// a failure; that is why it belongs at this site, where a token is required to be a nonempty
// string, and not as a blanket flag on a general extraction operation. And `-e` still admits
// the EMPTY STRING, which is a token this seam must refuse — so the blank arm below is
// load-bearing and the flag is defence in depth. Absence has no path to Filesystem.Write
// under either. The fix is not a
// non-empty check after the write, because such a check concedes the empty file is writable
// and was in fact satisfied by editing nothing (it lived in gunbc.srv3_os_install_actuate
// `srv3_bmcweb_login` as a shell.Test.IsNonEmpty on the file this fold had just produced,
// and is deleted with this climb per DESIGN §4b dissolution-on-climb).
type BmcwebTokenExtraction =
  | BmcwebTokenExtracted { token: NonEmptyStr }
  | BmcwebTokenExtractRefused { reason: String }

fn bmcweb_token_extract_jq_args(response_path: String) -> List<String> {
  ["-e", "-r", ".token", response_path]
}

fn bmcweb_token_extraction_verdict(jq_success: Bool, jq_stdout: String) -> BmcwebTokenExtraction {
  if jq_success {
    let token = trim(s: jq_stdout)
    if token == "" {
      BmcwebTokenExtractRefused {
        reason: "host_effect_apply: Srv3BmcwebTokenExtract jq -e exited zero but produced no token text for `.token` in the bmcweb login response; fail-closed, no token file written.",
      }
    } else {
      BmcwebTokenExtracted { token: token as NonEmptyStr }
    }
  } else {
    BmcwebTokenExtractRefused {
      reason: "host_effect_apply: Srv3BmcwebTokenExtract jq -e refused: `.token` is absent, null or false in the bmcweb login response (a rejected or malformed BMC login); fail-closed, no token file written.",
    }
  }
}

fn realize_bmcweb_token_extract_body(
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match srv3_tool_bin_path(tool_name: jq_cli_tool.name, transport: LocalShell) {
    Srv3TokenObserved { value: jq_path } => {
      let jq_run = gunbc.WitnessBin.Run(
        workdir: "/",
        bin_path: jq_path,
        args: bmcweb_token_extract_jq_args(response_path: srv3_bmcweb_login_response_path),
      )
      match bmcweb_token_extraction_verdict(jq_success: jq_run.success, jq_stdout: jq_run.stdout) {
        BmcwebTokenExtracted { token: token } => {
          let write = Filesystem.Write(path: srv3_bmcweb_token_path, content: token as String)
          srv3_shell_reconcile(
            observed: ShellExecObserved {
              exit_code: if write.success { 0 } else { 1 },
              success: write.success,
              stdout: "",
              stderr: if write.success {
                ""
              } else {
                "host_effect_apply: Srv3BmcwebTokenExtract token write failed; fail-closed"
              },
            },
            intent: intent,
          )
        }
        BmcwebTokenExtractRefused { reason: why } =>
          srv3_shell_reconcile(
            observed: ShellExecObserved {
              exit_code: 1,
              success: false,
              stdout: "",
              stderr: why,
            },
            intent: intent,
          )
      }
    }
    Srv3TokenAbsent =>
      srv3_shell_reconcile(
        observed: ShellExecObserved {
          exit_code: 1,
          success: false,
          stdout: "",
          stderr: "host_effect_apply: Srv3BmcwebTokenExtract jq not found; fail-closed",
        },
        intent: intent,
      )
    Srv3TokenUnobserved { reason: why } =>
      NotConverged {
        reason: concat(
          "host_effect_apply: Srv3BmcwebTokenExtract could not observe jq, so no extraction was attempted and no token file is claimed: ",
          why,
        ),
        applied: intent,
      }
  }
}

fn realize_bmcweb_token_extract_on_host(
  transport: HostEffectTransport,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match transport {
    LocalShell =>
      realize_bmcweb_token_extract_body(intent: intent)
    SshShell { ssh_host: _ } =>
      NotConverged {
        reason: "host_effect_apply: Srv3BmcwebTokenExtract runs typed jq argv + Filesystem.Write on the executor host; SshShell transport is a fail-closed Unimplemented stub until remote extract+write is realized with structured bin invocation.",
        applied: intent,
      }
    FleetSsh { target: _, context: _ } =>
      NotConverged {
        reason: "host_effect_apply: Srv3BmcwebTokenExtract runs typed jq argv + Filesystem.Write on the executor host; SshShell transport is a fail-closed Unimplemented stub until remote extract+write is realized with structured bin invocation.",
        applied: intent,
      }
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      NotConverged {
        reason: "host_effect_apply: Srv3BmcwebTokenExtract cannot use EmitArtifactThenThinRun transport; typed mismatch.",
        applied: intent,
      }
  }
}

data toolchain_ensure_reconcile_located_note: String = "The refusal names the effect that produced it. This fold was written for OsInstallActuatorToolchainEnsure and hardcoded that effect in its failure header; when ProvisionBuildCache started reusing it (P1b:build-cache-provision), every build-cache refusal reported itself as an OS-install-actuator failure — a located diagnostic pointing at the wrong location, which is the §5 'typed, located' bar failing at the second half. The header is now a parameter supplied by each realize arm."

fn toolchain_ensure_reconcile(
  observed: ShellExecObserved,
  intent: HostEffectIntent,
  effect_label: String,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let grounding = if observed.success {
      Grounds { evidence: ShellEffectApplied { exit_code: observed.exit_code, stdout: observed.stdout, stderr: observed.stderr } }
    } else {
      DoesNotGround {
        reason: shell_exec_failure_reason_headered(
          observed: observed,
          header: join(
            [
              "host_effect_apply: ",
              effect_label,
              " synthesized receipt from typed per-tool ensure results; fail-closed",
            ],
            "",
          ),
        ),
      }
    }
  reconcile_grounded(
    apply_effect: intent,
    show_read: ReadObserved { value: observed },
    grounding: grounding
  )
}

fn srv3_toolchain_ensure_reconcile(
  observed: ShellExecObserved,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  toolchain_ensure_reconcile(
    observed: observed,
    intent: intent,
    effect_label: "OsInstallActuatorToolchainEnsure",
  )
}

fn provision_build_cache_reconcile(
  observed: ShellExecObserved,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  toolchain_ensure_reconcile(
    observed: observed,
    intent: intent,
    effect_label: "EnsureBuildCacheInstance",
  )
}

data provision_codex_runtime_typed_step_note: String = "ProvisionCodexRuntime observe/materialize/read-back replaced the concat-built bash body of the now-deleted host_codex_runtime_provision_script.dag with three typed single-command steps: LocalShell dispatches through the existing typed argv services gunbc.WitnessBin.Run (observe/read-back) and gunbc.Cli.Run (materialize) — argv arrays, not a shell string, so there is no branching or receipt-marker text to construct or parse; SshShell/FleetSsh dispatch through run_typed_argv_transport with the same argv shape built by gunbc.host_codex_runtime_provision_verdict codex_runtime_observe_argv and gunbc.cli_invoke gunbc_run_transport_argv. The mkdir-release-parent step the old shell body ran before materialize is dropped: gunbc.package_delivery release_codex_runtime_bundle_immutable already runs shell.Mkdir.Parents on release_parent inside materialize_codex_runtime_bundle's own call chain, so a second mkdir ahead of it was redundant work (DESIGN §2), not preserved behavior. Read-back reuses the observe step verbatim — 'we ran materialize' is never treated as 'it is installed'; only a second successful --version probe that satisfies codex_runtime_version_identity_satisfied converges."

type CodexRuntimeStepResult
  = CodexRuntimeStepRan { observed: ShellExecObserved }
  | CodexRuntimeStepRefused { reason: String }

fn codex_runtime_typed_argv_step(
  argv: List<String>,
  transport: HostEffectTransport,
) -> CodexRuntimeStepResult {
  match run_typed_argv_transport(argv: argv, transport: transport) {
    TypedArgvExecConverged { result: r } =>
      CodexRuntimeStepRan {
        observed: ShellExecObserved { exit_code: r.exit_code, success: r.success, stdout: r.stdout, stderr: r.stderr },
      }
    TypedArgvExecRefused { reason: why } => CodexRuntimeStepRefused { reason: why }
  }
}

fn codex_runtime_observe_step(
  transport: HostEffectTransport,
  executable: FilePath,
) -> CodexRuntimeStepResult {
  match transport {
    LocalShell => {
      let r = gunbc.WitnessBin.Run(workdir: "/" as FilePath, bin_path: executable, args: ["--version"])
      CodexRuntimeStepRan {
        observed: ShellExecObserved { exit_code: r.exit_code, success: r.success, stdout: r.stdout, stderr: r.stderr },
      }
    }
    SshShell { ssh_host: _ } =>
      codex_runtime_typed_argv_step(
        argv: codex_runtime_observe_argv(executable: executable as String),
        transport: transport,
      )
    FleetSsh { target: _, context: _ } =>
      codex_runtime_typed_argv_step(
        argv: codex_runtime_observe_argv(executable: executable as String),
        transport: transport,
      )
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      CodexRuntimeStepRefused {
        reason: "host_effect_apply: ProvisionCodexRuntime cannot use EmitArtifactThenThinRun transport; typed mismatch.",
      }
  }
}

data codex_runtime_materialize_source_roots: List<String> = ["dag", "src/v2"]
data codex_runtime_materialize_entry: String = "dag/gunbc/host_codex_runtime_provision.dag"
data codex_runtime_materialize_function: String = "materialize_codex_runtime_on_local_host"

fn codex_runtime_materialize_step(
  transport: HostEffectTransport,
  gunbc_binary: FilePath,
  gunbc_repo: FilePath,
) -> CodexRuntimeStepResult {
  match transport {
    LocalShell => {
      let r = gunbc.Cli.Run(
        workdir: gunbc_repo,
        bin_path: gunbc_binary,
        source_roots: codex_runtime_materialize_source_roots,
        entry: codex_runtime_materialize_entry,
        function: codex_runtime_materialize_function,
        claim_run: false,
      )
      CodexRuntimeStepRan {
        observed: ShellExecObserved { exit_code: r.exit_code, success: r.success, stdout: r.stdout, stderr: r.stderr },
      }
    }
    SshShell { ssh_host: _ } =>
      codex_runtime_typed_argv_step(
        argv: concat(
          [gunbc_binary as String],
          gunbc_run_transport_argv(
            source_roots: codex_runtime_materialize_source_roots,
            entry: codex_runtime_materialize_entry,
            function: codex_runtime_materialize_function,
            claim_run: false,
          ),
        ),
        transport: transport,
      )
    FleetSsh { target: _, context: _ } =>
      codex_runtime_typed_argv_step(
        argv: concat(
          [gunbc_binary as String],
          gunbc_run_transport_argv(
            source_roots: codex_runtime_materialize_source_roots,
            entry: codex_runtime_materialize_entry,
            function: codex_runtime_materialize_function,
            claim_run: false,
          ),
        ),
        transport: transport,
      )
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      CodexRuntimeStepRefused {
        reason: "host_effect_apply: ProvisionCodexRuntime cannot use EmitArtifactThenThinRun transport; typed mismatch.",
      }
  }
}

fn provision_codex_runtime_refuse(
  host: HostIdentity,
  observed: CodexRuntimeObservation,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match provision_codex_runtime_verdict(host: host, observed: observed) {
    ProvisionConverged { executable: _, version_line: _ } =>
      NotConverged {
        reason: "host_effect_apply: ProvisionCodexRuntime verdict unexpectedly converged from a refusal-classified observation; fail-closed.",
        applied: intent,
      }
    ProvisionRefused { cause: _, reason: reason } =>
      NotConverged { reason: reason as String, applied: intent }
  }
}

fn provision_codex_runtime_reconcile(
  host: HostIdentity,
  executable: FilePath,
  gunbc_binary: FilePath,
  gunbc_repo: FilePath,
  transport: HostEffectTransport,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match codex_runtime_observe_step(transport: transport, executable: executable) {
    CodexRuntimeStepRefused { reason: why } =>
      provision_codex_runtime_refuse(
        host: host,
        observed: CodexRuntimeTransportRefused { reason: why },
        intent: intent,
      )
    CodexRuntimeStepRan { observed: observe_result } =>
      if observe_result.success && codex_runtime_version_identity_satisfied(combined_output: observe_result.stdout) {
        toolchain_ensure_reconcile(observed: observe_result, intent: intent, effect_label: "ProvisionCodexRuntime")
      } else {
        match codex_runtime_materialize_step(transport: transport, gunbc_binary: gunbc_binary, gunbc_repo: gunbc_repo) {
          CodexRuntimeStepRefused { reason: why } =>
            provision_codex_runtime_refuse(
              host: host,
              observed: CodexRuntimeTransportRefused { reason: why },
              intent: intent,
            )
          CodexRuntimeStepRan { observed: materialize_result } =>
            if !materialize_result.success {
              provision_codex_runtime_refuse(
                host: host,
                observed: CodexRuntimeMaterializationFailed { reason: materialize_result.stderr },
                intent: intent,
              )
            } else {
              match codex_runtime_observe_step(transport: transport, executable: executable) {
                CodexRuntimeStepRefused { reason: why } =>
                  provision_codex_runtime_refuse(
                    host: host,
                    observed: CodexRuntimeTransportRefused { reason: why },
                    intent: intent,
                  )
                CodexRuntimeStepRan { observed: read_back_result } =>
                  if read_back_result.success
                    && codex_runtime_version_identity_satisfied(combined_output: read_back_result.stdout)
                  {
                    toolchain_ensure_reconcile(
                      observed: read_back_result,
                      intent: intent,
                      effect_label: "ProvisionCodexRuntime",
                    )
                  } else {
                    provision_codex_runtime_refuse(
                      host: host,
                      observed: CodexRuntimeIdentityMismatch {
                        observed_output: concat(read_back_result.stdout, concat(" ", read_back_result.stderr)),
                      },
                      intent: intent,
                    )
                  }
              }
            }
        }
      }
  }
}

fn provision_codex_runtime_target_host(effect_intent: HostEffectIntent) -> HostIdentity? {
  match effect_intent.target {
    HostOs { node: n } => Present { value: n.identity }
    BmcController { node: _ } => none
  }
}

fn realize_provision_codex_runtime_body(
  transport: HostEffectTransport,
  effect_intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match provision_codex_runtime_target_host(effect_intent: effect_intent) {
    Absent =>
      NotConverged {
        reason: "host_effect_apply: ProvisionCodexRuntime requires HostOs target with a fleet host identity; fail-closed.",
        applied: effect_intent,
      }
    Present { value: host } =>
      match codex_bundled_executable_for_host(host: host) {
        Absent =>
          NotConverged {
            reason: join(
              [
                "host_effect_apply: ProvisionCodexRuntime refused — no bundled executable placement for host ",
                host as String,
                "; fail-closed.",
              ],
              "",
            ),
            applied: effect_intent,
          }
        Present { value: executable } =>
          match provider_runtime_placement_for_host(host: host) {
            Absent =>
              NotConverged {
                reason: join(
                  [
                    "host_effect_apply: ProvisionCodexRuntime refused — no provider runtime placement for host ",
                    host as String,
                    "; fail-closed.",
                  ],
                  "",
                ),
                applied: effect_intent,
              }
            Present { value: _ } =>
              provision_codex_runtime_reconcile(
                host: host,
                executable: executable,
                gunbc_binary: srv1_gunbc_serve_binary,
                gunbc_repo: srv1_gunbc_repo_root,
                transport: transport,
                intent: effect_intent,
              )
          }
      }
  }
}

fn realize_provision_codex_runtime(
  effect_intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match effect_intent.effect {
    ProvisionCodexRuntime {} =>
      match effect_intent.transport {
        LocalShell =>
          realize_provision_codex_runtime_body(
            transport: effect_intent.transport,
            effect_intent: effect_intent,
          )
        SshShell { ssh_host: _ } =>
          realize_provision_codex_runtime_body(
            transport: effect_intent.transport,
            effect_intent: effect_intent,
          )
        FleetSsh { target: _, context: _ } =>
          realize_provision_codex_runtime_body(
            transport: effect_intent.transport,
            effect_intent: effect_intent,
          )
        EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
          NotConverged {
            reason: "host_effect_apply: ProvisionCodexRuntime cannot use EmitArtifactThenThinRun transport; typed mismatch.",
            applied: effect_intent,
          }
      }
    _ =>
      NotConverged {
        reason: "host_effect_apply: realize_provision_codex_runtime requires ProvisionCodexRuntime effect",
        applied: effect_intent,
      }
  }
}

data srv3_actuator_toolchain_emit_artifact_transport_helper_note: String = "realize_os_install_actuator_toolchain_ensure refuses EmitArtifactThenThinRun at entry; srv3_actuator_toolchain_emit_artifact_transport_helper_refused false arms are fail-closed backstop only — not a silent widen (DESIGN §5). EmitArtifactThenThinRun defers execution to a materialized artifact run elsewhere, so an inline bin-witness probe has no host to observe; refusing here is a permanent boundary of that transport, not unmigrated debt.\\n\\nThe five probe leaves that used to build a concatenated shell command string (bin-witness success, test -x, which-based tool presence, which-based tool bin path, chown) now carry typed operation_argv rows and route SshShell and FleetSsh through typed_argv_exec_over_ssh / typed_argv_exec_over_fleet_ssh (gunbc.typed_argv_exec), the same wall the principal, sudo-probe and grant-list leaves already used. FleetSsh is admitted at realize_os_install_actuator_toolchain_ensure's entry gate.\\n\\nRUNG, STATED HONESTLY BECAUSE THE OBVIOUS READING OVERSTATES IT. The FleetSsh arms are compile-verified only: the match is exhaustive and each arm demonstrably reaches typed dispatch, but NO EXECUTING WITNESS DISCRIMINATES THEM, and the reason is structural rather than an omission. A FleetSshExecutionContext is reachable only through materialize_fleet_known_hosts_anchor, which is a `func` using Network, and the KnownHostsAnchor seal admits that one declaration alone -- so a pure `test fn` cannot construct the transport these arms match on. THE SEAL THAT MAKES A FLEET CONTEXT UNFORGEABLE ALSO MAKES IT UNFIXTURABLE. That is a real cost of the wall and it is recorded here rather than paid down by widening the wall, because admitting a test declaration to the seal to make one's own change testable is the trade a reviewer should refuse. NEXT-RUNG TRIGGER: a fixture route to a context that does not weaken the production seal -- an effect-level test harness for the materializer, not a second minter."


// THE THREE-VALUED COLLAPSE IS CLOSED. This is where the roster of five collapse sites and six
// consumers stood, together with its dissolution condition: "DISSOLVES WHEN the sites return an
// observation that preserves TypedArgvExecRefused". They do now -- Srv3HostPredicate and
// Srv3ObservedToken carry Unobserved with the reason the refusal already had -- so the roster and its
// shape check are deleted rather than left standing beside the thing they described.
//
// What the roster was right about, and what it could not make unwritable: it said a repair that
// changed the sites without changing the consumers would only move the collapse one call deeper.
// That is exactly what the first draft of this cut did, using a Bool projection to satisfy the
// typechecker at a call site. The projection is gone; the consumers match all three arms, and
// exhaustiveness is what keeps them matching them.


// A host probe answers one of three things, and the third is not a shade of the second:
// the predicate held, the predicate failed, or the transport could not carry the probe at all.
// Collapsing Unobserved into Fails is what let a refused probe read as "the tool is absent" and
// fall through to a privileged install on a host that had never been reached (DESIGN §5,
// fabricated negative; the empty-observation narrow in the failure-mode list).
type Srv3HostPredicate
  = Srv3PredicateHolds
  | Srv3PredicateFails
  | Srv3PredicateUnobserved { reason: String }

fn srv3_predicate_from_typed_argv(outcome: TypedArgvExecOutcome) -> Srv3HostPredicate {
  match outcome {
    TypedArgvExecConverged { result: r } =>
      if r.success { Srv3PredicateHolds } else { Srv3PredicateFails }
    TypedArgvExecRefused { reason: why } => Srv3PredicateUnobserved { reason: why }
  }
}

// The same three states for a probe whose answer is a VALUE rather than a verdict -- a resolved
// tool path, a uid, a gid: whatever single token the probe printed. Absent and Unobserved differ
// in remedy: the first says the host answered and had nothing, the second says the question was
// never put to the host.
//
// Named for the token and not for the tool path, because two consumers carry numeric ids through
// it. A carrier named Srv3ToolPath with a uid in its `path` field is a name that lies about its
// contents, which is the §3 concern applied to a field rather than a module (review 54189).
type Srv3ObservedToken
  = Srv3TokenObserved { value: String }
  | Srv3TokenAbsent
  | Srv3TokenUnobserved { reason: String }

fn srv3_observed_token_from_typed_argv(outcome: TypedArgvExecOutcome) -> Srv3ObservedToken {
  match outcome {
    TypedArgvExecConverged { result: r } =>
      if r.success {
        let out = trim(s: r.stdout)
        if out == "" { Srv3TokenAbsent } else { Srv3TokenObserved { value: out } }
      } else {
        Srv3TokenAbsent
      }
    TypedArgvExecRefused { reason: why } => Srv3TokenUnobserved { reason: why }
  }
}

data srv3_nonroot_workdir_unobservable_reason: String = "typed_argv_exec over ssh/fleet_ssh carries a bare argv with no working-directory channel, so a non-root workdir cannot be honoured and the probe is not run"

// Same cost shape, same fix as extdeps.sudo.elevation: one append rather than a snoc per element.
fn srv3_argv_with_bin(bin_path: String, args: List<String>) -> List<String> {
  list_append(left: [bin_path], right: args)
}


data srv3_transport_witness_bin_nonroot_workdir_note: String = "typed_argv_exec_over_\{ssh,fleet_ssh} carries a bare argv with no shell to `cd` first, so a non-root workdir has no typed form to hand it. Every in-tree caller passes workdir: \"/\" (checked at review time), so this arm is unreachable dead debt today -- named rather than folded into the workdir == \"/\" condition so a non-root workdir renders as a located refusal instead of an indistinguishable-from-measured `false` (DESIGN §5, fabricated negative). DISSOLVES WHEN a typed remote cd/chdir primitive lands and this reroutes to it, or when workdir is dropped from the signature because no caller ever varies it."

fn srv3_transport_witness_bin_success(
  transport: HostEffectTransport,
  workdir: String,
  bin_path: String,
  args: List<String>,
) -> Srv3HostPredicate
  admit_callers: [
    decl_ref(module_path: "gunbc.host_effect_realize", decl_name: "srv3_elevated_witness_bin_success"),
    decl_ref(module_path: "gunbc.host_effect_realize", decl_name: "srv3_apt_tool_version_ok"),
    decl_ref(module_path: "gunbc.host_effect_realize", decl_name: "srv3_run_tool_by_name"),
    decl_ref(module_path: "gunbc.host_effect_realize", decl_name: "websocat_stage_download"),
    decl_ref(module_path: "gunbc.host_effect_realize", decl_name: "srv3_transport_argv_success"),
  ]
{
  match transport {
    LocalShell =>
      if gunbc.WitnessBin.Run(workdir: workdir, bin_path: bin_path, args: args).success {
        Srv3PredicateHolds
      } else {
        Srv3PredicateFails
      }
    SshShell { ssh_host: h } =>
      if workdir == "/" {
        srv3_predicate_from_typed_argv(
          outcome: typed_argv_exec_over_ssh(
            host: h,
            argv: srv3_argv_with_bin(bin_path: bin_path, args: args),
          ),
        )
      } else {
        Srv3PredicateUnobserved { reason: srv3_nonroot_workdir_unobservable_reason }
      }
    FleetSsh { target: t, context: c } =>
      if workdir == "/" {
        srv3_predicate_from_typed_argv(
          outcome: typed_argv_exec_over_fleet_ssh(
            target: t,
            context: c,
            argv: srv3_argv_with_bin(bin_path: bin_path, args: args),
          ),
        )
      } else {
        Srv3PredicateUnobserved { reason: srv3_nonroot_workdir_unobservable_reason }
      }
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      Srv3PredicateUnobserved {
        reason: "EmitArtifactThenThinRun transport has no arm that can run a witness binary",
      }
  }
}

fn srv3_transport_test_executable(path: String, transport: HostEffectTransport) -> Srv3HostPredicate {
  match transport {
    LocalShell =>
      if shell.Test.IsExecutable(path: path).executable {
        Srv3PredicateHolds
      } else {
        Srv3PredicateFails
      }
    SshShell { ssh_host: h } =>
      srv3_predicate_from_typed_argv(
        outcome: typed_argv_exec_over_ssh(host: h, argv: shell_test_is_executable_argv(path: path)),
      )
    FleetSsh { target: t, context: c } =>
      srv3_predicate_from_typed_argv(
        outcome: typed_argv_exec_over_fleet_ssh(
          target: t,
          context: c,
          argv: shell_test_is_executable_argv(path: path),
        ),
      )
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      Srv3PredicateUnobserved {
        reason: "EmitArtifactThenThinRun transport has no arm that can test an executable",
      }
  }
}

fn srv3_apt_tool_present(tool_name: NonEmptyStr, transport: HostEffectTransport) -> Srv3HostPredicate {
  match transport {
    LocalShell =>
      if shell.PosixCommandV.Check(command: tool_name).exists {
        Srv3PredicateHolds
      } else {
        Srv3PredicateFails
      }
    SshShell { ssh_host: h } =>
      srv3_predicate_from_typed_argv(
        outcome: typed_argv_exec_over_ssh(host: h, argv: posix_command_v_check_argv(command: tool_name)),
      )
    FleetSsh { target: t, context: c } =>
      srv3_predicate_from_typed_argv(
        outcome: typed_argv_exec_over_fleet_ssh(
          target: t,
          context: c,
          argv: posix_command_v_check_argv(command: tool_name),
        ),
      )
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      Srv3PredicateUnobserved {
        reason: "EmitArtifactThenThinRun transport has no arm that can probe tool presence",
      }
  }
}

fn srv3_tool_bin_path(tool_name: NonEmptyStr, transport: HostEffectTransport) -> Srv3ObservedToken {
  match transport {
    LocalShell => {
      let found = shell.PosixCommandV.Check(command: tool_name)
      if found.exists {
        match found.path {
          Present { value: tool_path } => Srv3TokenObserved { value: tool_path as String }
          Absent => Srv3TokenAbsent
        }
      } else {
        Srv3TokenAbsent
      }
    }
    SshShell { ssh_host: h } =>
      srv3_observed_token_from_typed_argv(
        outcome: typed_argv_exec_over_ssh(host: h, argv: posix_command_v_check_argv(command: tool_name)),
      )
    FleetSsh { target: t, context: c } =>
      srv3_observed_token_from_typed_argv(
        outcome: typed_argv_exec_over_fleet_ssh(
          target: t,
          context: c,
          argv: posix_command_v_check_argv(command: tool_name),
        ),
      )
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      Srv3TokenUnobserved {
        reason: "EmitArtifactThenThinRun transport has no arm that can resolve a tool path",
      }
  }
}

// One place where "resolve the tool, then run it" is written, so the three states survive the
// composition instead of being flattened once per call site.
fn srv3_run_tool_by_name(
  tool_name: NonEmptyStr,
  args: List<String>,
  transport: HostEffectTransport,
) -> Srv3HostPredicate {
  match srv3_tool_bin_path(tool_name: tool_name, transport: transport) {
    Srv3TokenUnobserved { reason: why } => Srv3PredicateUnobserved { reason: why }
    Srv3TokenAbsent => Srv3PredicateFails
    Srv3TokenObserved { value: resolved } =>
      srv3_transport_witness_bin_success(
        transport: transport,
        workdir: "/",
        bin_path: resolved,
        args: args,
      )
  }
}

fn srv3_apt_tool_version_ok(tool_name: NonEmptyStr, transport: HostEffectTransport) -> Srv3HostPredicate {
  match srv3_tool_bin_path(tool_name: tool_name, transport: transport) {
    Srv3TokenObserved { value: tool_path } =>
      srv3_transport_witness_bin_success(
        transport: transport,
        workdir: "/",
        bin_path: tool_path,
        args: ["--version"],
      )
    Srv3TokenAbsent => Srv3PredicateFails
    Srv3TokenUnobserved { reason: why } => Srv3PredicateUnobserved { reason: why }
  }
}

// ONE TRANSPORT-AWARE SINGLE-TOKEN READ, given a full argv. srv3_tool_bin_path and the `id`
// probes each had their own transport match over the same four arms; the stat probes this cut adds
// would have made a third. The argv is the parameter because that is exactly what differs --
// everything else about "run this readonly command and take its one line of output" is identical.
// WHAT MAY BE ASKED, not what may be run. Every token read this realizer performs is one of four
// questions about the host, so the caller names the QUESTION and the argv is derived here. Before
// this type existed the entry point took a List<String> and would run whatever it was handed --
// the semantic request and the command serialization were one fact, so a new probe was authored by
// passing a new argv rather than by declaring a new subject, and nothing distinguished a modeled
// read from an arbitrary one.
type Srv3TokenSubject
  = Srv3EffectiveUserId
  | Srv3EffectiveGroupId
  | Srv3PathOwnerUser { path: String }
  | Srv3PathOwnerGroup { path: String }

// The single public token read. The argv never crosses this boundary in either direction: callers
// hand in a subject and receive a typed observation.
fn srv3_read_token(
  subject: Srv3TokenSubject,
  transport: HostEffectTransport,
) -> Srv3ObservedToken {
  srv3_transport_token(argv: srv3_token_argv(subject: subject), transport: transport)
}

// The serialization half, private to the two decls above by admission rather than by convention.
fn srv3_token_argv(subject: Srv3TokenSubject) -> List<String>
  admit_callers: [
    decl_ref(module_path: "gunbc.host_effect_realize", decl_name: "srv3_read_token"),
    decl_ref(module_path: "test.claim.srv3_token_subject_witness", decl_name: "effective_owner_subjects_derive_the_cited_id_argv"),
    decl_ref(module_path: "test.claim.srv3_token_subject_witness", decl_name: "path_owner_subjects_derive_the_cited_stat_argv"),
    decl_ref(module_path: "test.claim.srv3_token_subject_witness", decl_name: "owner_halves_do_not_derive_the_same_command"),
    decl_ref(module_path: "test.claim.srv3_token_subject_witness", decl_name: "the_path_subject_carries_its_own_path"),
  ]
{
  match subject {
    Srv3EffectiveUserId => id_uid_argv_absolute()
    Srv3EffectiveGroupId => id_gid_argv_absolute()
    Srv3PathOwnerUser { path: p } => stat_owner_user_argv(path: p)
    Srv3PathOwnerGroup { path: p } => stat_owner_group_argv(path: p)
  }
}

// SEALED TO THE ONE SUBJECT-TAKING CALLER. This is the arm that will run any argv it is given, so
// admission is what stops a future probe from re-opening the untyped surface: adding a read means
// adding a Srv3TokenSubject variant, not calling through here with a fresh vector.
fn srv3_transport_token(argv: List<String>, transport: HostEffectTransport) -> Srv3ObservedToken
  admit_callers: [
    decl_ref(module_path: "gunbc.host_effect_realize", decl_name: "srv3_read_token"),
  ]
{
  match transport {
    LocalShell => srv3_local_token_from_argv(argv: argv)
    SshShell { ssh_host: h } =>
      srv3_observed_token_from_typed_argv(outcome: typed_argv_exec_over_ssh(host: h, argv: argv))
    FleetSsh { target: t, context: c } =>
      srv3_observed_token_from_typed_argv(
        outcome: typed_argv_exec_over_fleet_ssh(target: t, context: c, argv: argv),
      )
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      Srv3TokenUnobserved {
        reason: "EmitArtifactThenThinRun transport has no arm that can read a command's output",
      }
  }
}

// The local witness-bin surface takes a binary and its tail separately, so the argv is split here
// rather than at every caller. An empty argv names no binary and is refused rather than run.
fn srv3_local_token_from_argv(argv: List<String>) -> Srv3ObservedToken {
  match argv {
    Empty =>
      Srv3TokenUnobserved { reason: "srv3 token read: an empty argv names no binary to run" }
    Cons { head: bin, tail: rest } => {
      let r = gunbc.WitnessBin.Run(workdir: "/", bin_path: bin, args: rest)
      srv3_token_from_run(success: r.success, stdout: r.stdout)
    }
  }
}

// EMPTY STDOUT IS ABSENT, NOT AN OBSERVATION OF "". A probe that exits zero having printed nothing
// has not answered the question it was asked, and the caller must decide what that means rather
// than receive an empty token that compares unequal to everything.
//
// LOCAL READS GO THROUGH THE SAME TRIM THE SSH ARMS USE. The local chown arm previously consumed
// `.stdout` raw, so a trailing newline -- which `id` emits and every other arm trims -- was
// concatenated straight into a privileged chown argument.
fn srv3_token_from_run(success: Bool, stdout: String) -> Srv3ObservedToken {
  if success {
    let out = trim(s: stdout)
    if out == "" { Srv3TokenAbsent } else { Srv3TokenObserved { value: out } }
  } else {
    Srv3TokenAbsent
  }
}

// THE GID PROBE SITS INSIDE THE UID ARM, not beside it in a second `let`. Both are readonly, so
// the harm is small, but the shape is the one that produced this file's two worst defects: an
// effectful call outside the branch that decides whether it should happen runs anyway, and nothing
// in the signature says so.
fn srv3_effective_owner(transport: HostEffectTransport) -> Srv3EffectiveOwner {
  match srv3_read_token(subject: Srv3EffectiveUserId, transport: transport) {
    Srv3TokenUnobserved { reason: why } => Srv3EffectiveOwnerUnobserved { reason: why }
    Srv3TokenAbsent =>
      Srv3EffectiveOwnerUnobserved { reason: "srv3 owner: `id -u` produced no output" }
    Srv3TokenObserved { value: uid_text } =>
      match srv3_read_token(subject: Srv3EffectiveGroupId, transport: transport) {
        Srv3TokenUnobserved { reason: why } => Srv3EffectiveOwnerUnobserved { reason: why }
        Srv3TokenAbsent =>
          Srv3EffectiveOwnerUnobserved { reason: "srv3 owner: `id -g` produced no output" }
        Srv3TokenObserved { value: gid_text } =>
          srv3_owner_from_texts(uid_text: uid_text, gid_text: gid_text)
      }
  }
}

// The absolute-path spellings. extdeps.tools.id's bare argv rows resolve through PATH, which is
// right for a remote shell; the local witness-bin surface takes a binary path, and a sudoers rule
// matches on one, so both spellings are real and neither is the other's nickname.
fn id_uid_argv_absolute() -> List<String> {
  [id_binary_path as String, "-u"]
}

fn id_gid_argv_absolute() -> List<String> {
  [id_binary_path as String, "-g"]
}

type Srv3EffectiveOwner
  = Srv3EffectiveOwnerObserved { owner: PosixOwnerSpec }
  | Srv3EffectiveOwnerUnobserved { reason: String }

// AN UNDECODABLE ID REFUSES; IT IS NOT CHOWNED TO. `id` printed SOMETHING and it is not a POSIX
// id, which is a different state from "id printed nothing" and from "id was never run" -- and the
// remedy differs: unparseable output means the probe's assumption about the host is wrong, and
// retrying will produce the same text.
fn srv3_owner_from_texts(uid_text: String, gid_text: String) -> Srv3EffectiveOwner {
  match posix_user_id_from_text(text: uid_text) {
    Absent =>
      Srv3EffectiveOwnerUnobserved {
        reason: concat("srv3 owner: `id -u` output is not a POSIX user id: ", uid_text),
      }
    Present { value: user } =>
      match posix_group_id_from_text(text: gid_text) {
        Absent =>
          Srv3EffectiveOwnerUnobserved {
            reason: concat("srv3 owner: `id -g` output is not a POSIX group id: ", gid_text),
          }
        Present { value: group } =>
          Srv3EffectiveOwnerObserved {
            owner: PosixOwnerSpec { user: user, group: group },
          }
      }
  }
}

// THE PATH'S CURRENT OWNER, read independently of anything this process did to it.
fn srv3_observe_path_owner(path: String, transport: HostEffectTransport) -> PathOwnershipObservation {
  match srv3_read_token(subject: Srv3PathOwnerUser { path: path }, transport: transport) {
    Srv3TokenUnobserved { reason: why } => PathOwnerUnobserved { reason: why }
    Srv3TokenAbsent =>
      PathOwnerUnobserved {
        reason: concat("srv3 owner: `stat -c %u` produced no output for ", path),
      }
    Srv3TokenObserved { value: uid_text } =>
      match srv3_read_token(subject: Srv3PathOwnerGroup { path: path }, transport: transport) {
        Srv3TokenUnobserved { reason: why } => PathOwnerUnobserved { reason: why }
        Srv3TokenAbsent =>
          PathOwnerUnobserved {
            reason: concat("srv3 owner: `stat -c %g` produced no output for ", path),
          }
        Srv3TokenObserved { value: gid_text } =>
          srv3_path_owner_from_texts(uid_text: uid_text, gid_text: gid_text, path: path)
      }
  }
}

fn srv3_path_owner_from_texts(
  uid_text: String,
  gid_text: String,
  path: String,
) -> PathOwnershipObservation {
  match srv3_owner_from_texts(uid_text: uid_text, gid_text: gid_text) {
    Srv3EffectiveOwnerUnobserved { reason: why } =>
      PathOwnerUnobserved { reason: concat(concat("srv3 owner of ", path), concat(": ", why)) }
    Srv3EffectiveOwnerObserved { owner: o } => PathOwnerObserved { owner: o }
  }
}

// OWNERSHIP IS ENSURED BY READBACK, NOT BY EXIT STATUS -- and this is the stage where that
// distinction was previously absent. The predecessor ran an elevated chown and returned
// Holds/Fails from the process result, so "the chown exited zero" and "the directory is owned by
// us" were the same claim. They are not: a chown that followed a symlink, or that raced a replaced
// path, or that ran under a sudoers rule permitting the binary but not the target, can exit zero
// having converged nothing.
//
// The chown's own result is deliberately not consulted for the verdict. It cannot be: the verdict
// comes from path_ownership_verdict, which takes the readback and the desired owner and has
// nowhere to put a process result. A failed chown surfaces as the readback disagreeing.
fn srv3_ensure_directory_owned_by_current_user(
  path: String,
  transport: HostEffectTransport,
) -> Srv3HostPredicate {
  match srv3_effective_owner(transport: transport) {
    Srv3EffectiveOwnerUnobserved { reason: why } => Srv3PredicateUnobserved { reason: why }
    Srv3EffectiveOwnerObserved { owner: desired } =>
      srv3_converge_path_owner(
        desired: desired,
        decision: path_ownership_decision(
          desired: desired,
          observed: srv3_observe_path_owner(path: path, transport: transport),
        ),
        path: path,
        transport: transport,
      )
  }
}

// THE ALREADY-SATISFIED ARM PERFORMS NO PRIVILEGED INVOCATION AT ALL, which on a converge that has
// already run is every invocation this stage would have made.
fn srv3_converge_path_owner(
  desired: PosixOwnerSpec,
  decision: PathOwnershipDecision,
  path: String,
  transport: HostEffectTransport,
) -> Srv3HostPredicate {
  match decision {
    OwnershipDecisionRefused { reason: why } => Srv3PredicateUnobserved { reason: why }
    OwnershipAlreadySatisfied { owner: _ } => Srv3PredicateHolds
    OwnershipMutationRequired { current: _, desired: target } =>
      srv3_chown_then_read_back(desired: target, path: path, transport: transport)
  }
}

// THE MUTATION IS SEQUENCED BY A `let` INSIDE THIS ARM, NOT BY ARGUMENT POSITION. An earlier
// revision passed the chown as an argument and defended it in a comment as "deliberately
// load-bearing eagerness". That reinstates exactly the footgun this sequence of cuts exists to
// remove: implicit evaluation order is not a sequencing authority, and the fact that eagerness
// happened to be what I wanted this time does not make it one -- the next reader cannot tell a
// deliberate one from the accident that put a privileged apt install in an argument (side-chat
// review of #8760).
fn srv3_chown_then_read_back(
  desired: PosixOwnerSpec,
  path: String,
  transport: HostEffectTransport,
) -> Srv3HostPredicate {
  let attempt = srv3_chown_attempt(
    outcome: srv3_elevated_witness_bin_success(
      transport: transport,
      command: chown_argv(owner: desired, path: path),
    ),
  )
  srv3_readback_after_attempt(
    desired: desired,
    attempt: attempt,
    path: path,
    transport: transport,
  )
}

fn srv3_chown_attempt(outcome: Srv3HostPredicate) -> ChownAttemptObservation {
  match outcome {
    Srv3PredicateHolds => ChownReportedSuccess
    Srv3PredicateFails => ChownReportedFailure
    Srv3PredicateUnobserved { reason: why } => ChownNotDispatched { cause: why }
  }
}

// A CHOWN THAT WAS NEVER DISPATCHED SKIPS THE READBACK. Not as an optimization: a readback there
// would describe a host nobody touched, and reporting its answer as the result of an ensure that
// never ran is the fabrication in miniature. Both DISPATCHED arms read back, and identically --
// a reported failure is no more evidence about the filesystem than a reported success.
fn srv3_readback_after_attempt(
  desired: PosixOwnerSpec,
  attempt: ChownAttemptObservation,
  path: String,
  transport: HostEffectTransport,
) -> Srv3HostPredicate {
  match attempt {
    ChownNotDispatched { cause: why } => Srv3PredicateUnobserved { reason: why }
    ChownReportedSuccess =>
      srv3_path_owner_readback(desired: desired, attempt: attempt, path: path, transport: transport)
    ChownReportedFailure =>
      srv3_path_owner_readback(desired: desired, attempt: attempt, path: path, transport: transport)
  }
}

fn srv3_path_owner_readback(
  desired: PosixOwnerSpec,
  attempt: ChownAttemptObservation,
  path: String,
  transport: HostEffectTransport,
) -> Srv3HostPredicate {
  srv3_predicate_from_ownership_outcome(
    outcome: path_ownership_verdict(
      desired: desired,
      attempt: attempt,
      readback: srv3_observe_path_owner(path: path, transport: transport),
    ),
  )
}

fn srv3_predicate_from_ownership_outcome(outcome: PathOwnershipEnsureOutcome) -> Srv3HostPredicate {
  match outcome {
    PathAlreadyOwned { owner: _ } => Srv3PredicateHolds
    PathOwnershipConvergedAfterAttempt { owner: _, attempt: _ } => Srv3PredicateHolds
    PathOwnershipEnsureRefused { reason: why } => Srv3PredicateUnobserved { reason: why }
  }
}

// EVERY PRIVILEGED LEAF IN THIS FILE GOES THROUGH HERE, so sudo's calling convention is stated
// once. Four call sites each carried `bin_path: "/usr/bin/sudo"` beside an args list beginning
// with a bare "-n"; the binary and the flag are facts about sudo, not about chown, mkdir or
// apt-get, and extdeps.sudo.elevation is where they belong.
// THE EXECUTION SURFACE IS SEALED TO ITS NAMED CALLERS, and the seal's REACH IS MEASURED RATHER
// THAN ASSERTED, because the obvious reading of `admit_callers` overstates what it does.
//
// WHAT IS CLOSED, confirmed by execution: no OTHER MODULE can run an argv on a transport, elevated
// or not. A foreign caller refuses at resolve with a diagnostic naming the permitted set --
// "constructor call admission refused: 'gunbc.host_effect_realize.srv3_elevated_witness_bin_success'
// refuses call from 'test.claim.srv3_seal_probe.a_foreign_module_may_not_run_a_privileged_argv' --
// permitted callers: [...]". That is the property this cut is for: a caller outside this module can
// name a semantic operation (ensure this tool, ensure this owner) and cannot name the machinery
// that executes it.
//
// WHAT IS NOT CLOSED, and this is the part a reader would get wrong: the wall does NOT confine
// SAME-MODULE callers. A probe function added to this very module, absent from the admitted list,
// calling srv3_elevated_witness_bin_success with ["/bin/rm", "-rf", "/"], typechecked and resolved
// with no diagnostic at all. Both halves were measured on the same build; reporting only the
// refusal would be the rung inflation DESIGN section 4b names as worse than sitting low.
//
// So the rung is MECHANICALLY PREVENTABLE at the module boundary and NOTHING at all within it. The
// admitted lists below are therefore two facts at once: an enforced wall against foreign callers,
// and a declaration of intent for in-module ones that no mechanism currently checks. NEXT-RUNG
// TRIGGER: admission checked per caller rather than per module. Until that lands, an in-module
// caller added to either of these functions is caught by review or by nothing.
//
// The lists were derived by walking the module rather than by reading the call sites: my first
// hand-read attributed two calls to the wrong enclosing function and invented a fifth caller that
// does not exist. Nothing would have caught that -- an in-module list the compiler does not check
// is a list nothing verifies, which is the second reason the next-rung trigger matters.
// THE ARGV-SHAPED SIBLING. Every extdeps tool row returns a complete argv, and the witness-bin
// surface takes a binary and its tail separately, so each caller was splitting the argv back apart
// by hand at the call site -- or, more often, not building one at all and passing a literal binary
// beside a literal args list. This splits it once.
fn srv3_transport_argv_success(
  transport: HostEffectTransport,
  argv: List<String>,
) -> Srv3HostPredicate
  admit_callers: [
    decl_ref(module_path: "gunbc.host_effect_realize", decl_name: "websocat_stage_ensure_executable_mode"),
  ]
{
  match argv {
    Empty =>
      Srv3PredicateUnobserved { reason: "srv3 exec: an empty argv names no binary to run" }
    Cons { head: bin, tail: rest } =>
      srv3_transport_witness_bin_success(
        transport: transport,
        workdir: "/",
        bin_path: bin,
        args: rest,
      )
  }
}

fn srv3_elevated_witness_bin_success(
  transport: HostEffectTransport,
  command: List<String>,
) -> Srv3HostPredicate
  admit_callers: [
    decl_ref(module_path: "gunbc.host_effect_realize", decl_name: "srv3_privileged_apt_install"),
    decl_ref(module_path: "gunbc.host_effect_realize", decl_name: "srv3_chown_then_read_back"),
    decl_ref(module_path: "gunbc.host_effect_realize", decl_name: "websocat_stage_ensure_directory"),
  ]
{
  let elevated = sudo_elevate(command: command)
  srv3_transport_witness_bin_success(
    transport: transport,
    workdir: "/",
    bin_path: elevated.bin_path,
    args: elevated.args,
  )
}

fn srv3_privileged_apt_install(package: NonEmptyStr, transport: HostEffectTransport) -> Srv3HostPredicate {
  srv3_elevated_witness_bin_success(
    transport: transport,
    command: srv3_actuator_toolchain_apt_install_command(package: package),
  )
}

// THE COMMAND, NOT THE ELEVATED INVOCATION. This is the argv apt-get would take unprivileged;
// elevation is applied to it rather than spelled inside it, so "which flag makes sudo
// non-interactive" is not a fact this function has an opinion about.
fn srv3_actuator_toolchain_apt_install_command(package: NonEmptyStr) -> List<String> {
  [
    apt_get_binary_path as String,
    "install",
    "-y",
    package as String,
  ]
}

fn srv3_actuator_toolchain_websocat_release_download_url() -> String {
  websocat_github_release_download_url(
    tag: websocat_github_tag,
    asset: websocat_asset_aarch64,
  )
}

fn srv3_actuator_toolchain_realizer_apt_install_is_privileged_gated() -> Bool {
  let elevated = sudo_elevate(command: srv3_actuator_toolchain_apt_install_command(package: package_curl))
  elevated.bin_path == sudo_binary_path as String &&
    elevated.args == ["-n", apt_get_binary_path as String, "install", "-y", package_curl as String]
}

fn srv3_actuator_toolchain_realizer_websocat_uses_github_release_not_apt() -> Bool {
  string_contains(
    s: srv3_actuator_toolchain_websocat_release_download_url(),
    pattern: "github.com/vi/websocat/releases/download/",
  )
    && string_contains(s: websocat_install_path as String, pattern: gunbc_bin_dir as String)
}

fn srv3_actuator_toolchain_realizer_websocat_installs_to_modeled_path_with_namespace_upsert() -> Bool {
  string_contains(s: websocat_install_path as String, pattern: concat(gunbc_bin_dir as String, "/"))
}

// THE ARM THIS FUNCTION MUST NOT TAKE is the install arm on an unobserved probe. Previously the
// presence probe returned `Bool`, so a transport that could not run the probe at all answered
// `false` and fell straight through to srv3_privileged_apt_install -- a privileged mutation of a
// host whose current state was never established. `Srv3PredicateUnobserved` now refuses instead,
// carrying the reason the probe could not be made.
// THE INSTALL MUST SIT IN A BRANCH, NEVER IN AN ARGUMENT POSITION.
//
// This body once read srv3_version_gate_then(verdict: ..., otherwise: srv3_apt_install_then_reprobe(...)),
// which reads correctly and is wrong: an argument is evaluated to build the call, so the PRIVILEGED
// APT INSTALL RAN ON EVERY ENSURE of a present, correctly-versioned tool. The pre-cut code
// short-circuited through if/else and never had this defect; the regression came from moving the
// install out of a branch and into a parameter while every type stayed identical. A match arm is a
// branch, so only the selected arm evaluates.
fn srv3_ensure_apt_tool(
  tool_name: NonEmptyStr,
  package: NonEmptyStr,
  require_version_probe: Bool,
  transport: HostEffectTransport,
) -> Srv3HostPredicate {
  match srv3_apt_tool_present(tool_name: tool_name, transport: transport) {
    Srv3PredicateUnobserved { reason: why } => Srv3PredicateUnobserved { reason: why }
    Srv3PredicateHolds =>
      if require_version_probe == false {
        Srv3PredicateHolds
      } else {
        match srv3_apt_tool_version_ok(tool_name: tool_name, transport: transport) {
          Srv3PredicateHolds => Srv3PredicateHolds
          Srv3PredicateUnobserved { reason: why } => Srv3PredicateUnobserved { reason: why }
          Srv3PredicateFails =>
            srv3_apt_install_then_reprobe(
              tool_name: tool_name,
              package: package,
              require_version_probe: require_version_probe,
              transport: transport,
            )
        }
      }
    Srv3PredicateFails =>
      srv3_apt_install_then_reprobe(
        tool_name: tool_name,
        package: package,
        require_version_probe: require_version_probe,
        transport: transport,
      )
  }
}

fn srv3_probe_present_then_version(
  tool_name: NonEmptyStr,
  transport: HostEffectTransport,
) -> Srv3HostPredicate {
  match srv3_apt_tool_present(tool_name: tool_name, transport: transport) {
    Srv3PredicateUnobserved { reason: why } => Srv3PredicateUnobserved { reason: why }
    Srv3PredicateFails => Srv3PredicateFails
    Srv3PredicateHolds =>
      match srv3_apt_tool_version_ok(tool_name: tool_name, transport: transport) {
        Srv3PredicateHolds => Srv3PredicateHolds
        Srv3PredicateUnobserved { reason: why } => Srv3PredicateUnobserved { reason: why }
        Srv3PredicateFails => Srv3PredicateFails
      }
  }
}

fn srv3_apt_install_then_reprobe(
  tool_name: NonEmptyStr,
  package: NonEmptyStr,
  require_version_probe: Bool,
  transport: HostEffectTransport,
) -> Srv3HostPredicate {
  match srv3_privileged_apt_install(package: package, transport: transport) {
    Srv3PredicateUnobserved { reason: why } => Srv3PredicateUnobserved { reason: why }
    Srv3PredicateFails => Srv3PredicateFails
    Srv3PredicateHolds =>
      match srv3_apt_tool_present(tool_name: tool_name, transport: transport) {
        Srv3PredicateUnobserved { reason: why } => Srv3PredicateUnobserved { reason: why }
        Srv3PredicateFails => Srv3PredicateFails
        Srv3PredicateHolds =>
          if require_version_probe == false {
            Srv3PredicateHolds
          } else {
            match srv3_apt_tool_version_ok(tool_name: tool_name, transport: transport) {
              Srv3PredicateHolds => Srv3PredicateHolds
              Srv3PredicateUnobserved { reason: why } => Srv3PredicateUnobserved { reason: why }
              Srv3PredicateFails => Srv3PredicateFails
            }
          }
      }
  }
}


// THE SEQUENCE IS A VALUE, SO THE EVIDENCE CAN ASSERT WHAT RAN.
//
// The defect this replaces: srv3_ensure_websocat bound mkdir, chown, curl and chmod as four lets
// and then handed the results to srv3_predicate_all. In a strict language a let executes when it
// is bound, so ALL FOUR MUTATIONS RAN REGARDLESS OF EACH OTHER -- a failed mkdir still downloaded
// the file and chmod'd it -- and the readback sat in the argument list, so it ran after any of
// them failed. srv3_predicate_all then classified the batch correctly AFTER THE FACT. The value
// was right and the execution was wrong, which is why no witness in this file saw it: they all
// assert the returned coproduct, and this class never changes it.
//
// Four of those unconditional mutations predate the three-valued cut; the eagerly-evaluated
// readback was introduced by it. Both are closed here.
//
// The repair separates the SEQUENCING DECISION from the EXECUTION. websocat_after is a pure
// total function -- given a stage and its outcome, what happens next -- so a test can assert the
// whole transition table without a host. The driver performs effects and consumes that single
// authority, which is what keeps the tested decision and the executed decision the same one.
type WebsocatStage
  = ObserveInstalled
  | ResolveCurl
  | EnsureDirectory
  | EnsureOwnership
  | Download
  | EnsureExecutableMode
  | Readback

type WebsocatStep
  = WebsocatContinue { next: WebsocatStage }
  | WebsocatStop { verdict: Srv3HostPredicate }
  | WebsocatAlreadySatisfied

// A stage advances ONLY on Holds. Fails and Unobserved both stop, and they stop carrying their
// own verdict rather than a shared one -- an unreachable host and a genuinely failed mkdir are
// different states with different remedies, which is the distinction the three-valued carrier
// exists to preserve.
// Advancing and stopping are the same two shapes at every stage but the first and last, so they
// are named once. `next` is a pure stage value, not an effect -- passing it as an argument is
// safe, and the distinction is worth stating in a file whose defects were all about effects in
// argument position: eager evaluation only matters when evaluating causes something to happen.
fn websocat_advance(outcome: Srv3HostPredicate, next: WebsocatStage) -> WebsocatStep {
  match outcome {
    Srv3PredicateHolds => WebsocatContinue { next: next }
    Srv3PredicateFails => WebsocatStop { verdict: Srv3PredicateFails }
    Srv3PredicateUnobserved { reason: why } =>
      WebsocatStop { verdict: Srv3PredicateUnobserved { reason: why } }
  }
}

fn websocat_terminal(outcome: Srv3HostPredicate) -> WebsocatStep {
  match outcome {
    Srv3PredicateHolds => WebsocatStop { verdict: Srv3PredicateHolds }
    Srv3PredicateFails => WebsocatStop { verdict: Srv3PredicateFails }
    Srv3PredicateUnobserved { reason: why } =>
      WebsocatStop { verdict: Srv3PredicateUnobserved { reason: why } }
  }
}

// ObserveInstalled IS THE ONLY STAGE WHERE Fails MEANS PROCEED. "Is it already installed"
// answering no is the whole reason to install, so that arm continues; every other stage's Fails is
// a real failure and stops. Unobserved stops at every stage including that one -- a host that could
// not be asked whether the binary exists must not be handed an install.
fn websocat_after(stage: WebsocatStage, outcome: Srv3HostPredicate) -> WebsocatStep {
  match stage {
    ObserveInstalled =>
      match outcome {
        Srv3PredicateHolds => WebsocatAlreadySatisfied
        Srv3PredicateFails => WebsocatContinue { next: ResolveCurl }
        Srv3PredicateUnobserved { reason: why } =>
          WebsocatStop { verdict: Srv3PredicateUnobserved { reason: why } }
      }
    ResolveCurl => websocat_advance(outcome: outcome, next: EnsureDirectory)
    EnsureDirectory => websocat_advance(outcome: outcome, next: EnsureOwnership)
    EnsureOwnership => websocat_advance(outcome: outcome, next: Download)
    Download => websocat_advance(outcome: outcome, next: EnsureExecutableMode)
    EnsureExecutableMode => websocat_advance(outcome: outcome, next: Readback)
    Readback => websocat_terminal(outcome: outcome)
  }
}

// THE ACTION TRACE, derived from the same transition function the driver uses. Given the outcome
// each stage would produce, this yields exactly the stages that execute -- so a witness can assert
// "a failed mkdir means Download never runs" as a claim about EXECUTION rather than about the
// value that came back.
//
// The walk CARRIES the next stage rather than re-deriving it from what already ran. An earlier
// draft of this file derived it, which put the stage order in two places -- websocat_after and the
// deriving function -- and that is the §3 fork this module keeps being about. websocat_after is
// the only thing that knows what follows what.
type WebsocatWalk {
  stages: List<WebsocatStage>
  current: WebsocatStage?
  verdict: Srv3HostPredicate
}

data websocat_walk_start: WebsocatWalk = WebsocatWalk {
  stages: [],
  current: Present { value: ObserveInstalled },
  verdict: Srv3PredicateFails,
}

fn websocat_walk_step(walk: WebsocatWalk, outcome: Srv3HostPredicate) -> WebsocatWalk {
  match walk.current {
    Absent => walk
    Present { value: stage } => {
      let ran = list_snoc_item(xs: walk.stages, item: stage)
      match websocat_after(stage: stage, outcome: outcome) {
        WebsocatAlreadySatisfied =>
          WebsocatWalk { stages: ran, current: none, verdict: Srv3PredicateHolds }
        WebsocatStop { verdict: v } =>
          WebsocatWalk { stages: ran, current: none, verdict: v }
        WebsocatContinue { next: n } =>
          WebsocatWalk { stages: ran, current: Present { value: n }, verdict: walk.verdict }
      }
    }
  }
}

fn websocat_trace_from_outcomes(outcomes: List<Srv3HostPredicate>) -> WebsocatWalk {
  fold_list(
    xs: outcomes,
    empty: websocat_walk_start,
    cons: fn(acc, outcome) { websocat_walk_step(walk: acc, outcome: outcome) },
  )
}

fn websocat_stage_label(stage: WebsocatStage) -> String {
  match stage {
    ObserveInstalled => "observe-installed"
    ResolveCurl => "resolve-curl"
    EnsureDirectory => "ensure-directory"
    EnsureOwnership => "ensure-ownership"
    Download => "download"
    EnsureExecutableMode => "ensure-executable-mode"
    Readback => "readback"
  }
}

fn websocat_trace_labels(walk: WebsocatWalk) -> List<String> {
  list_map(xs: walk.stages, f: fn(st) { websocat_stage_label(stage: st) })
}

// THE DRIVER. Every effect sits inside a match arm, so it executes only when the preceding stage
// held. Nothing is bound with `let` before its turn, and nothing effectful appears in an argument
// or list position -- those were the two shapes that made the previous body run mutations it had
// no business running.
//
// The chain is not a fold: each stage needs a different effect and some need values the previous
// stage produced (the resolved curl path), so a uniform step function would have to carry a union
// of every stage's inputs. The sequencing decision IS folded -- that is websocat_after, which this
// driver and the trace witness both consume.
// THE DRIVER DEPENDS ON THE STAGE websocat_after NAMED, rather than assuming it. This closes a
// real fork that the first cut left open and the first mutation could not see: every driver site
// matched `WebsocatContinue { next: _ }` and then ran the stage it expected, so websocat_after was
// the sole authority for STOP-OR-CONTINUE while the stage EDGE was hardcoded a second time in the
// driver. Rewriting an edge -- EnsureDirectory continuing to Download instead of EnsureOwnership --
// would have reddened the trace, which follows `next`, while production carried on in its original
// order. Two authorities agreeing today is not one authority (raised in side-chat review).
//
// Comparison goes through websocat_stage_label because that fold is already the total, exhaustive
// projection of the stage type; adding a second equality over the same coproduct would be the fork
// this function exists to remove.
fn websocat_edge_admits(actual: WebsocatStage, expected: WebsocatStage) -> Bool {
  websocat_stage_label(stage: actual) == websocat_stage_label(stage: expected)
}

// A DISAGREEMENT REFUSES; IT DOES NOT PROCEED AND IT DOES NOT GUESS. The driver cannot honour a
// transition it does not implement, and running the stage it happens to have code for would be the
// absorbing fallback -- carrying on because carrying on is available.
fn websocat_edge_disagreement(actual: WebsocatStage, expected: WebsocatStage) -> Srv3HostPredicate {
  Srv3PredicateUnobserved {
    reason: join([
      "srv3 websocat: the sequence authority named stage ",
      websocat_stage_label(stage: actual),
      " but this driver site implements ",
      websocat_stage_label(stage: expected),
      " -- the walk and the driver disagree about the stage order, so no host was touched",
    ], ""),
  }
}

fn srv3_ensure_websocat(transport: HostEffectTransport) -> Srv3HostPredicate {
  let install_path = websocat_install_path as String
  match websocat_after(
    stage: ObserveInstalled,
    outcome: srv3_transport_test_executable(path: install_path, transport: transport),
  ) {
    WebsocatAlreadySatisfied => Srv3PredicateHolds
    WebsocatStop { verdict: v } => v
    WebsocatContinue { next: n } =>
      match websocat_edge_admits(actual: n, expected: ResolveCurl) {
        false => websocat_edge_disagreement(actual: n, expected: ResolveCurl)
        true =>
          match srv3_tool_bin_path(tool_name: curl_cli_tool.name, transport: transport) {
            Srv3TokenUnobserved { reason: why } => Srv3PredicateUnobserved { reason: why }
            Srv3TokenAbsent => Srv3PredicateFails
            Srv3TokenObserved { value: curl_path } =>
              srv3_websocat_install_from(
                curl_path: curl_path,
                install_path: install_path,
                transport: transport,
              )
          }
      }
  }
}

// ONE FUNCTION PER STAGE, rather than one function nesting five matches. The nesting was not a
// style problem: at depth five, adding the edge check to each site pushed the effect bodies far
// enough right that the thing being guarded stopped being visible beside its guard. Each stage now
// runs its own effect, consults the sequence authority, checks that the authority named the stage
// this chain implements next, and calls it. The stage order therefore appears exactly once as data
// (in websocat_after) and once as a call graph that refuses when the two disagree.
fn srv3_websocat_install_from(
  curl_path: String,
  install_path: String,
  transport: HostEffectTransport,
) -> Srv3HostPredicate {
  websocat_stage_ensure_directory(
    curl_path: curl_path,
    install_path: install_path,
    transport: transport,
  )
}

fn websocat_stage_ensure_directory(
  curl_path: String,
  install_path: String,
  transport: HostEffectTransport,
) -> Srv3HostPredicate {
  let bin_dir = gunbc_bin_dir as String
  match websocat_after(
    stage: EnsureDirectory,
    outcome: srv3_elevated_witness_bin_success(
      transport: transport,
      command: mkdir_parents_argv(path: bin_dir),
    ),
  ) {
    WebsocatAlreadySatisfied => Srv3PredicateHolds
    WebsocatStop { verdict: v } => v
    WebsocatContinue { next: n } =>
      match websocat_edge_admits(actual: n, expected: EnsureOwnership) {
        false => websocat_edge_disagreement(actual: n, expected: EnsureOwnership)
        true =>
          websocat_stage_ensure_ownership(
            curl_path: curl_path,
            install_path: install_path,
            transport: transport,
          )
      }
  }
}

fn websocat_stage_ensure_ownership(
  curl_path: String,
  install_path: String,
  transport: HostEffectTransport,
) -> Srv3HostPredicate {
  match websocat_after(
    stage: EnsureOwnership,
    outcome: srv3_ensure_directory_owned_by_current_user(
      path: gunbc_bin_dir as String,
      transport: transport,
    ),
  ) {
    WebsocatAlreadySatisfied => Srv3PredicateHolds
    WebsocatStop { verdict: v } => v
    WebsocatContinue { next: n } =>
      match websocat_edge_admits(actual: n, expected: Download) {
        false => websocat_edge_disagreement(actual: n, expected: Download)
        true =>
          websocat_stage_download(
            curl_path: curl_path,
            install_path: install_path,
            transport: transport,
          )
      }
  }
}

fn websocat_stage_download(
  curl_path: String,
  install_path: String,
  transport: HostEffectTransport,
) -> Srv3HostPredicate {
  match websocat_after(
    stage: Download,
    outcome: srv3_transport_witness_bin_success(
      transport: transport,
      workdir: "/",
      bin_path: curl_path,
      args: [
        "-fsSL",
        srv3_actuator_toolchain_websocat_release_download_url(),
        "-o",
        install_path,
      ],
    ),
  ) {
    WebsocatAlreadySatisfied => Srv3PredicateHolds
    WebsocatStop { verdict: v } => v
    WebsocatContinue { next: n } =>
      match websocat_edge_admits(actual: n, expected: EnsureExecutableMode) {
        false => websocat_edge_disagreement(actual: n, expected: EnsureExecutableMode)
        true =>
          websocat_stage_ensure_executable_mode(
            install_path: install_path,
            transport: transport,
          )
      }
  }
}

fn websocat_stage_ensure_executable_mode(
  install_path: String,
  transport: HostEffectTransport,
) -> Srv3HostPredicate {
  match websocat_after(
    stage: EnsureExecutableMode,
    outcome: srv3_transport_argv_success(
      transport: transport,
      argv: chmod_add_executable_argv(path: install_path),
    ),
  ) {
    WebsocatAlreadySatisfied => Srv3PredicateHolds
    WebsocatStop { verdict: v } => v
    WebsocatContinue { next: n } =>
      match websocat_edge_admits(actual: n, expected: Readback) {
        false => websocat_edge_disagreement(actual: n, expected: Readback)
        true =>
          websocat_after_readback(
            outcome: srv3_transport_test_executable(
              path: install_path,
              transport: transport,
            ),
          )
      }
  }
}

// The readback is the ONLY thing that admits convergence. A successful chmod is not evidence the
// binary is executable; the previous body treated the batch as the answer and re-observed only as
// one more element of it.
fn websocat_after_readback(outcome: Srv3HostPredicate) -> Srv3HostPredicate {
  match websocat_after(stage: Readback, outcome: outcome) {
    WebsocatAlreadySatisfied => Srv3PredicateHolds
    WebsocatStop { verdict: v } => v
    WebsocatContinue { next: n } => websocat_edge_disagreement(actual: n, expected: Readback)
  }
}

// CONJUNCTION THAT DOES NOT LOSE THE THIRD STATE. `&&` over Bool answered false whether a step
// failed or could not be run; this reports Unobserved if ANY step could not be observed, and
// Fails only when every step was actually observed and one of them said no.
// A SUMMARY, NOT A SEQUENCER, and the name now says so. It folds observations that have ALREADY
// been made independently -- four separate tool ensures, none of which gates another -- and it
// cannot sequence anything, because by the time a list reaches it every element has been
// evaluated. Reading it as "run these in order, stopping on failure" is what let the websocat
// path run four mutations unconditionally. Sequencing lives in websocat_after and nowhere else.
fn srv3_summarize_independent_observations(steps: List<Srv3HostPredicate>) -> Srv3HostPredicate {
  fold_list(
    xs: steps,
    empty: Srv3PredicateHolds,
    cons: fn(acc, step) {
      match acc {
        Srv3PredicateUnobserved { reason: why } => Srv3PredicateUnobserved { reason: why }
        _ =>
          match step {
            Srv3PredicateUnobserved { reason: why } => Srv3PredicateUnobserved { reason: why }
            Srv3PredicateFails => Srv3PredicateFails
            Srv3PredicateHolds => acc
          }
      }
    },
  )
}

// Total over all three states, so a receipt line can never render Unobserved as "fail".
fn srv3_predicate_label(p: Srv3HostPredicate) -> String {
  match p {
    Srv3PredicateHolds => "ok"
    Srv3PredicateFails => "fail"
    Srv3PredicateUnobserved { reason: _ } => "unobserved"
  }
}

fn srv3_toolchain_observed(success: Bool, stdout: String) -> ShellExecObserved {
  ShellExecObserved {
    exit_code: if success { 0 } else { 1 },
    success: success,
    stdout: stdout,
    stderr: if success { "" } else { "actuator-toolchain-ensure: one or more tools failed ensure" },
  }
}

// HOW A TOOL IS ACQUIRED IS A ROW, NOT A CALL SITE. Four hand-written ensures sat here, three
// calling the apt path and one calling the websocat path, so "which mechanism installs this tool"
// was expressed only by which function the author happened to call -- and the receipt that reports
// them was a hand-built concat chain naming each tool twice, once as a literal and once as a
// variable. Adding a tool meant editing three places and remembering the fourth.
//
// require_version_probe lives INSIDE the apt variant rather than beside the acquisition, because
// the release path has no version probe to require. As a peer field it was a value one variant
// ignored -- a state the type admitted and the code silently dropped.
type Srv3ToolAcquisition
  = AcquireViaAptPackage { package: NonEmptyStr, require_version_probe: Bool }
  | AcquireViaWebsocatRelease

type Srv3ToolRow {
  tool_name: NonEmptyStr
  acquisition: Srv3ToolAcquisition
}

// THE DISPATCH IS THE ONLY PLACE A MECHANISM IS CHOSEN, and it is total over the acquisition
// coproduct: a new mechanism is a variant, and this match refuses to compile until it is answered.
fn srv3_ensure_tool(row: Srv3ToolRow, transport: HostEffectTransport) -> Srv3HostPredicate {
  match row.acquisition {
    AcquireViaAptPackage { package: p, require_version_probe: needs_version } =>
      srv3_ensure_apt_tool(
        tool_name: row.tool_name,
        package: p,
        require_version_probe: needs_version,
        transport: transport,
      )
    AcquireViaWebsocatRelease => srv3_ensure_websocat(transport: transport)
  }
}

fn srv3_toolchain_rows() -> List<Srv3ToolRow> {
  [
    Srv3ToolRow {
      tool_name: curl_cli_tool.name,
      acquisition: AcquireViaAptPackage { package: package_curl, require_version_probe: true },
    },
    Srv3ToolRow {
      tool_name: nbdkit_cli_tool.name,
      acquisition: AcquireViaAptPackage { package: package_nbdkit, require_version_probe: true },
    },
    Srv3ToolRow {
      tool_name: socat_cli_tool.name,
      acquisition: AcquireViaAptPackage { package: package_socat, require_version_probe: false },
    },
    Srv3ToolRow {
      tool_name: websocat_cli_tool.name,
      acquisition: AcquireViaWebsocatRelease,
    },
  ]
}

type Srv3ToolObservation {
  tool_name: NonEmptyStr
  verdict: Srv3HostPredicate
}

// THE RECEIPT IS DERIVED FROM THE SAME ROWS THE ENSURE WALKED, so a tool cannot appear in one and
// not the other, and its label cannot disagree with its row.
fn srv3_tool_receipt_entry(observation: Srv3ToolObservation) -> String {
  concat(
    concat(observation.tool_name as String, "="),
    srv3_predicate_label(p: observation.verdict),
  )
}

fn srv3_toolchain_receipt(observations: List<Srv3ToolObservation>) -> String {
  concat(
    "OsInstallActuatorToolchainReceipt: ",
    join(list_map(xs: observations, f: fn(o) { srv3_tool_receipt_entry(observation: o) }), " "),
  )
}

fn srv3_realize_os_install_actuator_toolchain_ensure_body(
  transport: HostEffectTransport,
  effect_intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let observations = list_map(
    xs: srv3_toolchain_rows(),
    f: fn(row) {
      Srv3ToolObservation {
        tool_name: row.tool_name,
        verdict: srv3_ensure_tool(row: row, transport: transport),
      }
    },
  )
  let verdict = srv3_summarize_independent_observations(
    steps: list_map(xs: observations, f: fn(o) { o.verdict }),
  )
  let stdout = srv3_toolchain_receipt(observations: observations)
  match verdict {
    Srv3PredicateUnobserved { reason: why } =>
      NotConverged {
        reason: concat(
          concat(
            "host_effect_apply: Srv3OsInstallActuatorToolchainEnsure could not observe one or more tools on this transport, so no ensure verdict is claimed: ",
            why,
          ),
          concat(" | ", stdout),
        ),
        applied: effect_intent,
      }
    Srv3PredicateHolds =>
      srv3_toolchain_ensure_reconcile(
        observed: srv3_toolchain_observed(success: true, stdout: stdout),
        intent: effect_intent,
      )
    Srv3PredicateFails =>
      srv3_toolchain_ensure_reconcile(
        observed: srv3_toolchain_observed(success: false, stdout: stdout),
        intent: effect_intent,
      )
  }
}

fn realize_os_install_actuator_toolchain_ensure(
  effect_intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match effect_intent.transport {
    LocalShell =>
      srv3_realize_os_install_actuator_toolchain_ensure_body(
        transport: effect_intent.transport,
        effect_intent: effect_intent,
      )
    SshShell { ssh_host: _ } =>
      srv3_realize_os_install_actuator_toolchain_ensure_body(
        transport: effect_intent.transport,
        effect_intent: effect_intent,
      )
    FleetSsh { target: _, context: _ } =>
      srv3_realize_os_install_actuator_toolchain_ensure_body(
        transport: effect_intent.transport,
        effect_intent: effect_intent,
      )
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      NotConverged {
        reason: "host_effect_apply: OsInstallActuatorToolchainEnsure cannot use EmitArtifactThenThinRun transport; typed mismatch.",
        applied: effect_intent,
      }
  }
}

data build_cache_install_authority_note: String = "The ensure arm installs sccache by calling the cited authority extdeps.cache.sccache.sccache_install_script (pinned release, per-arch sha256 verified, landing at sccache_installed_binary_path) — it does NOT hand-roll a package-manager install. Until 2026-07-24 this module ran `sudo -n apt-get install -y sccache` and wrote a unit with ExecStart=/usr/bin/sccache, a §3 fork of the same concept: P1:runner-deploy-slot installs the pinned tarball to /usr/local/bin and then P1b:build-cache-provision pointed its unit at a path that install never creates, so the daemon could not start and the read-back refused. Both the install and the unit now read ONE path row, so the two phases cannot disagree."

data build_cache_ensure_scope_swap_note: String = "This ensure body writes a SYSTEM-scope unit (/etc/systemd/system/<intended_unit>, WantedBy=multi-user.target, per render_build_cache_unit) rather than the user-scope unit (~/.config/systemd/user, enable-linger) the deleted gunbc.host_build_cache_provision_script builder used. That earlier form needed `sudo -n loginctl enable-linger \"$USER\"` to survive the provisioning ssh connection closing, which is real shell this render's system scope makes unnecessary — a `systemd --user` manager has no login to outlive when the unit is system-scoped. This is a consequence of the A5 grain swap (EnsureBuildCacheInstance { desired: BuildCacheInstance }), not an independently decided handler choice: BuildCacheInstance.intended_unit is a single row (\"gunbc-build-cache-ci.service\", WantedBy=multi-user.target) already grounded on a live srv1 capture, and the render is the single authority for the unit body, so writing it anywhere but where the render says WantedBy points is a second representation of the same fact. The install/enable/restart sequence reuses gunbc.live_deploy.operations' existing typed-argv-backed command builders (systemctl_daemon_reload_command / systemctl_enable_command / systemctl_restart_command, each privileged: true) rather than hand-spelling new sudo -n systemctl strings, matching the idiom already established in gunbc.live_deploy.emit and gunbc.host_axis_caps — a further §3 de-fork consistent with why this swap exists."

fn build_cache_unit_system_path(instance: BuildCacheInstance) -> String {
  concat("/etc/systemd/system/", instance.intended_unit as String)
}

fn build_cache_observe_stats_body() -> String {
  join([
    "stats_out=\"\"",
    "stats_rc=0",
    join(["if [ -x '", sccache_installed_binary_path, "' ]; then"], ""),
    join(["  stats_out=\"$('", sccache_installed_binary_path, "' --show-stats 2>&1)\" || stats_rc=$?"], ""),
    "else",
    "  printf '%s\\n' \"BuildCacheProvisionReceipt: observe=absent\"",
    "  stats_rc=127",
    "fi",
    "if [ \"$stats_rc\" -eq 0 ]; then",
    "  printf '%s\\n' \"BuildCacheProvisionReceipt: observe=ok\"",
    "  printf '%s\\n' \"$stats_out\"",
    "  exit 0",
    "fi",
    "",
  ], "\n")
}

fn build_cache_fragment_word(fragment: String) -> String {
  join(["'", fragment, "'"], "")
}

fn build_cache_fragment_words() -> String {
  join(
    map(sccache_misconfigured_log_fragments, f => build_cache_fragment_word(fragment: f)),
    " ",
  )
}

data build_cache_classify_fold_note: String = "The misconfigured-fragment classifier is a FOLD over the cited roster extdeps.cache.sccache.sccache_misconfigured_log_fragments, not one emitted branch per fragment. The roster is data the loop iterates: adding a fragment upstream changes the emitted word list and nothing else. Fragments are single-quoted as shell words, which is total only while no fragment contains a single quote — build_cache_fragment_words_are_shell_safe() is the construction check that keeps it so."

fn build_cache_classify_failure_body() -> String {
  join([
    "observe_class=unresponsive",
    "observe_fragment=\"\"",
    join(["for frag in ", build_cache_fragment_words(), "; do"], ""),
    "  if printf '%s' \"$stats_out\" | grep -Fq \"$frag\"; then",
    "    observe_class=misconfigured",
    "    observe_fragment=\"$frag\"",
    "    break",
    "  fi",
    "done",
    "if [ \"$observe_class\" = misconfigured ]; then",
    "  printf '%s\\n' \"BuildCacheProvisionReceipt: observe=misconfigured fragment=$observe_fragment\"",
    "else",
    "  printf '%s\\n' \"BuildCacheProvisionReceipt: observe=unresponsive\"",
    "fi",
    "",
  ], "\n")
}

fn build_cache_ensure_daemon_body(instance: BuildCacheInstance, arch_token: NonEmptyStr, digest: Digest) -> String {
  join([
    join(["if [ ! -x '", sccache_installed_binary_path, "' ]; then"], ""),
    sccache_install_script(rel: sccache_release_0_15_0, arch: arch_token, digest: digest),
    "fi",
    "_gunbc_stage=\"$(mktemp -d)\"",
    "trap 'rm -rf \"$_gunbc_stage\"' EXIT",
    join(["cat > \"$_gunbc_stage/", instance.intended_unit as String, "\" <<'__GUNBC_SCCACHE_UNIT__'"], ""),
    join(render_build_cache_unit(instance: instance), "\n"),
    "__GUNBC_SCCACHE_UNIT__",
    join(["sudo -n install -m 0644 \"$_gunbc_stage/", instance.intended_unit as String, "\" ", build_cache_unit_system_path(instance: instance)], ""),
    systemctl_daemon_reload_command(privileged: true),
    systemctl_enable_command(unit: instance.intended_unit, privileged: true),
    systemctl_restart_command(unit: instance.intended_unit, privileged: true),
    "",
  ], "\n")
}

fn build_cache_read_back_body(binary: String) -> String {
  join([
    join(["if stats_out=\"$('", binary, "' --show-stats 2>&1)\"; then"], ""),
    "  printf '%s\\n' \"BuildCacheProvisionReceipt: read_back=ok\"",
    "  printf '%s\\n' \"$stats_out\"",
    "  exit 0",
    "else",
    "  printf '%s\\n' \"BuildCacheProvisionReceipt: read_back=FAILED sccache unhealthy after ensure\"",
    "  printf '%s\\n' \"$stats_out\"",
    "  exit 1",
    "fi",
    "",
  ], "\n")
}

fn build_cache_provision_script_body(instance: BuildCacheInstance, arch_token: NonEmptyStr, digest: Digest) -> String {
  join([
    "set -euo pipefail",
    build_cache_observe_stats_body(),
    build_cache_classify_failure_body(),
    "printf '%s\\n' \"BuildCacheProvisionReceipt: ensure=starting\"",
    build_cache_ensure_daemon_body(instance: instance, arch_token: arch_token, digest: digest),
    build_cache_read_back_body(binary: sccache_installed_binary_path),
  ], "\n")
}

fn build_cache_provision_shell_script(instance: BuildCacheInstance, arch_token: NonEmptyStr, digest: Digest) -> String {
  shell_exec_via_bash(
    body: build_cache_provision_script_body(instance: instance, arch_token: arch_token, digest: digest),
  )
}

data build_cache_provision_shell_script_dissolution_trigger: DissolutionCondition = unbound_dissolution(description: "dissolve-on: gunbc.host_effect_realize.build_cache_provision_shell_script (relocated here, unchanged in kind, from the deleted gunbc.host_build_cache_provision_script) — concat-built systemd/sccache ensure shell run over shell_exec_via_bash transport; DISSOLVES WHEN bash-emit (#5828) realizes EnsureBuildCacheInstance observe/ensure/read-back as typed host-effect argv and realize_provision_build_cache retires this shell_exec_via_bash transport.")

data build_cache_provision_shell_script_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.host_effect_realize",
    decl_name: "build_cache_provision_shell_script_dissolution_trigger",
    field: WholeDeclaration,
  }
}

fn build_cache_provision_read_back_fails_closed() -> Bool {
  let body = build_cache_read_back_body(binary: sccache_installed_binary_path)
  string_contains(s: body, pattern: "read_back=FAILED")
    && string_contains(s: body, pattern: "exit 1")
    && !string_contains(s: body, pattern: "stats_rc")
}

fn build_cache_fragment_words_are_shell_safe() -> Bool {
  fold(
    sccache_misconfigured_log_fragments,
    init: true,
    f: (acc, frag) => acc && !string_contains(s: frag, pattern: "'"),
  )
}

fn build_cache_install_is_cited_not_package_manager() -> Bool {
  let body = build_cache_provision_script_body(
    instance: ci_cache_instance(host: srv1_host.identity),
    arch_token: "aarch64" as NonEmptyStr,
    digest: sccache_release_0_15_0.digest_aarch64,
  )
  string_contains(s: body, pattern: "github.com/mozilla/sccache/releases/download/")
    && string_contains(s: body, pattern: sccache_release_0_15_0.version as String)
    && !string_contains(s: body, pattern: "apt-get install")
    && !string_contains(s: body, pattern: "/usr/bin/sccache")
}

fn build_cache_classifier_covers_every_cited_fragment() -> Bool {
  fold(
    sccache_misconfigured_log_fragments,
    init: true,
    f: (acc, frag) =>
      acc && string_contains(s: build_cache_classify_failure_body(), pattern: frag),
  )
}

data provision_build_cache_arch_derivation_note: String = "The provisioning script is a function of the TARGET HOST's architecture, not a constant: the cited release publishes one musl tarball plus one sha256 per arch, so emitting a script at all requires knowing which. Arch comes from the effect target's own ComputeHost (compute_host_primary_cpu -> CpuFacts.architecture) and the token/digest selectors in extdeps.cache.sccache are partial over the Architecture coproduct — a host whose CPU is unreadable, or whose arch the release does not publish, yields NO script and a typed NotConverged. There is no default arch: shipping an aarch64 binary to an unlisted host is precisely the fabricated-plausible-output §5 forbids."

fn provision_build_cache_host_arch(effect_intent: HostEffectIntent) -> Architecture? {
  match effect_intent.target {
    HostOs { node: host } =>
      match compute_host_primary_cpu(host: host) {
        Present { value: cpu } => Present { value: cpu.catalog.architecture }
        Absent => none
      }
    BmcController { node: _ } => none
  }
}

fn realize_provision_build_cache_body(
  instance: BuildCacheInstance,
  transport: HostEffectTransport,
  effect_intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match provision_build_cache_host_arch(effect_intent: effect_intent) {
    Absent =>
      NotConverged {
        reason: "host_effect_apply: EnsureBuildCacheInstance cannot derive a target architecture from the effect target (no primary CPU on the ComputeHost, or the target is not HostOs); fail-closed, no default arch.",
        applied: effect_intent,
      }
    Present { value: arch } =>
      match sccache_release_arch_token(arch: arch) {
        Absent =>
          NotConverged {
            reason: join(
              [
                "host_effect_apply: EnsureBuildCacheInstance refused — the cited sccache release ",
                sccache_release_0_15_0.version as String,
                " publishes no musl tarball for architecture ",
                architecture_diagnostic_name(arch: arch) as String,
                "; fail-closed, no default arch.",
              ],
              "",
            ),
            applied: effect_intent,
          }
        Present { value: token } =>
          match sccache_release_digest(rel: sccache_release_0_15_0, arch: arch) {
            Absent =>
              NotConverged {
                reason: join(
                  [
                    "host_effect_apply: EnsureBuildCacheInstance refused — no pinned sha256 in the cited release row for architecture ",
                    architecture_diagnostic_name(arch: arch) as String,
                    "; fail-closed, never install unverified.",
                  ],
                  "",
                ),
                applied: effect_intent,
              }
            Present { value: digest } => {
              let survey = survey_build_cache_endpoint(
                instance: instance,
                reads: build_cache_endpoint_reads(instance: instance, transport: transport),
              )
              let admission = admit_ensure_build_cache_instance(
                desired: instance,
                placement: survey.placement,
                observed_path: survey.path,
                currency: survey.currency,
              )
              match admission {
                EnsureAlreadyConverged { desired: _, unit: u } =>
                  build_cache_already_converged(unit: u, effect_intent: effect_intent)
                EnsureBuildCacheRefused { instance: _, reason: _ } =>
                  NotConverged {
                    reason: join(
                      [
                        "host_effect_apply: EnsureBuildCacheInstance refused before writing anything -- ",
                        ensure_admission_refusal_reason(admission: admission),
                      ],
                      "",
                    ),
                    applied: effect_intent,
                  }
                EnsureBuildCacheAdmitted { desired: _, preflight: pf, unit_lines: _ } =>
                  build_cache_unlink_then_ensure(
                    instance: instance,
                    preflight: pf,
                    transport: transport,
                    effect_intent: effect_intent,
                    observed_path: survey.path,
                    currency: survey.currency,
                    token: token,
                    digest: digest,
                  )
              }
            }
          }
      }
  }
}

fn realize_provision_build_cache(
  effect_intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match effect_intent.effect {
    EnsureBuildCacheInstance { desired: instance } =>
      match provision_build_cache_catalog_gate_verdict(catalog_id: instance.implementation) {
        ProvisionBuildCacheCatalogRefused { reason: reason } =>
          NotConverged { reason: reason as String, applied: effect_intent }
        ProvisionBuildCacheCatalogRealizable =>
          match effect_intent.transport {
            LocalShell =>
              realize_provision_build_cache_body(
                instance: instance,
                transport: effect_intent.transport,
                effect_intent: effect_intent,
              )
            SshShell { ssh_host: _ } =>
              realize_provision_build_cache_body(
                instance: instance,
                transport: effect_intent.transport,
                effect_intent: effect_intent,
              )
            FleetSsh { target: _, context: _ } =>
              realize_provision_build_cache_body(
                instance: instance,
                transport: effect_intent.transport,
                effect_intent: effect_intent,
              )
            EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
              NotConverged {
                reason: "host_effect_apply: EnsureBuildCacheInstance cannot use EmitArtifactThenThinRun transport; typed mismatch.",
                applied: effect_intent,
              }
          }
      }
    _ =>
      NotConverged {
        reason: "host_effect_apply: realize_provision_build_cache requires EnsureBuildCacheInstance effect",
        applied: effect_intent,
      }
  }
}

fn provision_build_cache_witness_intent() -> HostEffectIntent {
  HostEffectIntent {
    target: HostOs { node: srv1_host },
    effect: EnsureBuildCacheInstance { desired: ci_cache_instance(host: srv1_host.identity) },
    evidence: host_effect_identity_evidence,
    transport: LocalShell,
    privilege_denial: none,
  }
}

data provision_build_cache_arch_unknown_fixture_note: String = "A host the fleet knows by identity but whose processor inventory is empty — the shape a freshly-racked srvN has before its BMC read lands (srv4 carried exactly this deferral for memory). Realization must REFUSE it, because 'which binary do I install' has no answer. The fixture deliberately does NOT fabricate a CPU catalog row for an arch the cited release omits: minting a machine that does not exist to test a refusal would be its own §3 violation, so the not-published arm is witnessed at the selector (sccache_release_arch_token over Riscv64/Wasm32) instead."

fn provision_build_cache_arch_unknown_host_fixture() -> ComputeHost {
  ComputeHost {
    identity: srv1_host.identity,
    baseboard: none,
    processors: [],
    memory: [],
    storage: [],
    network_interfaces: [],
  }
}

fn provision_build_cache_arch_unknown_intent_fixture() -> HostEffectIntent {
  HostEffectIntent {
    target: HostOs { node: provision_build_cache_arch_unknown_host_fixture() },
    effect: EnsureBuildCacheInstance {
      desired: ci_cache_instance(host: provision_build_cache_arch_unknown_host_fixture().identity),
    },
    evidence: host_effect_identity_evidence,
    transport: LocalShell,
    privilege_denial: none,
  }
}

fn provision_build_cache_reconcile_shell_observed(
  observed: ShellExecObserved,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  provision_build_cache_reconcile(
    observed: observed,
    intent: provision_build_cache_witness_intent(),
  )
}

fn run_shell_transport(script: RetainedShellScript, transport: HostEffectTransport) -> ShellExecObserved {
  match transport {
    LocalShell => {
      let result = shell.Exec.Run(script: retained_shell_script_to_transport(rss: script), expect: OutcomeIsData)
      ShellExecObserved {
        exit_code: result.exit_code,
        success: result.success,
        stdout: result.stdout,
        stderr: result.stderr,
      }
    }
    SshShell { ssh_host: h } => {
      if script.body == "" {
        ShellExecObserved {
          exit_code: 1,
          success: false,
          stdout: "host_effect_apply: empty shell script over SshShell; fail-closed",
          stderr: "",
        }
      } else {
        let result = ssh_session_exec_script(host: h, script: script.body)
        ShellExecObserved {
          exit_code: result.exit_code,
          success: result.success,
          stdout: result.stdout,
          stderr: result.stderr,
        }
      }
    }
    FleetSsh { target: t, context: _ } =>
      ShellExecObserved {
        exit_code: 1,
        success: false,
        stdout: join([
          "host_effect_apply: run_shell_transport refuses the FleetSsh transport for endpoint=",
          t.endpoint as String,
          ". This carrier is a shell script BODY -- a command string, not argv -- and the fleet path admits",
          " only portable remote words, so there is no shaping that preserves the script's meaning. The refusal",
          " is the carrier's shape surfacing, not a missing case: the residue dissolves when the effect reaches",
          " this seam as a typed Do effect rather than as text (DESIGN, shell -> intent).",
        ], ""),
        stderr: "",
      }
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      ShellExecObserved {
        exit_code: 1,
        success: false,
        stdout: "host_effect_apply: ShellCommand cannot use EmitArtifactThenThinRun transport; typed mismatch — reserved for ConvergePlan (host-effect Phase D).",
        stderr: "",
      }
  }
}

fn realize_converge_in_process(host_converge: HostConverge, intent: HostEffectIntent) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match interpret_host_converge(host_converge: host_converge) {
    ConvergeHostRefused { reason: why } =>
      NotConverged { reason: why, applied: intent }
    ConvergeHostInterpreted { knob_count: n, stdout: out } =>
      if n == 0 {
        NotConverged { reason: converge_host_no_knobs_reason, applied: intent }
      } else {
        let observed = run_shell_transport(script: retained_srvn(body: out, reason: "host converge in-process apply (interpreted knob script)"), transport: LocalShell)
        if observed.success {
          reconcile_grounded(
            apply_effect: intent,
            show_read: ReadObserved { value: observed.stdout },
            grounding: Grounds { evidence: ConvergePlanApplied { exit_code: observed.exit_code, stdout: observed.stdout } }
          )
        } else {
          NotConverged {
            reason: concat("host_effect: converge apply failed (nonzero exit); stderr: ", observed.stderr),
            applied: intent,
          }
        }
      }
  }
}

fn realize_converge_on_host(host_converge: HostConverge, transport: HostEffectTransport, intent: HostEffectIntent) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match transport {
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      match gunbc_apply_mode_for_host(host: host_converge.identity) {
        FreshStandup =>
          NotConverged {
            reason: "host_effect_apply: EmitArtifactThenThinRun fresh-standup bootstrap+thin-run is fail-closed Unimplemented until bootstrap_fragment_script_carrier_scaffold and thin_invocation_argv_carrier_scaffold dissolve via bash-emit (#5828 / shell-emission slice 1+2).",
            applied: intent,
          }
        ExistingHostQuiescentReload =>
          realize_converge_in_process(host_converge: host_converge, intent: intent)
      }
    LocalShell =>
      realize_converge_in_process(host_converge: host_converge, intent: intent)
    SshShell { ssh_host: _ } =>
      NotConverged {
        reason: "host_effect_apply: ConvergePlan over SshShell is a fail-closed Unimplemented stub; use EmitArtifactThenThinRun or LocalShell for the converge lane.",
        applied: intent,
      }
    FleetSsh { target: _, context: _ } =>
      NotConverged {
        reason: "host_effect_apply: ConvergePlan over SshShell is a fail-closed Unimplemented stub; use EmitArtifactThenThinRun or LocalShell for the converge lane.",
        applied: intent,
      }
  }
}

fn realize_install_media_fetch_in_process(intent: HostEffectIntent) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match install_media_fetch_reconcile(artifact: srv3_ubuntu_install_media_artifact) {
    InstallMediaFetchAlreadyPresent { path: p } =>
      reconcile_grounded(
        apply_effect: intent,
        show_read: ReadObserved { value: p as String },
        grounding: Grounds {
          evidence: ConvergePlanApplied {
            exit_code: 0,
            stdout: concat("install-media-fetch: already present at ", p as String),
          }
        }
      )
    InstallMediaFetchFetched { path: p, mirror_url: u } =>
      reconcile_grounded(
        apply_effect: intent,
        show_read: ReadObserved { value: p as String },
        grounding: Grounds {
          evidence: ConvergePlanApplied {
            exit_code: 0,
            stdout: concat(concat("install-media-fetch: fetched from ", u as String), concat(" to ", p as String)),
          }
        }
      )
    InstallMediaFetchRefused { reason: why } =>
      NotConverged { reason: concat("install-media-fetch: ", why as String), applied: intent }
  }
}

fn realize_install_media_remaster_in_process(intent: HostEffectIntent) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match install_media_remaster_reconcile(artifact: srv3_seeded_install_media_artifact) {
    InstallMediaRemasterAlreadyPresent { path: p } =>
      reconcile_grounded(
        apply_effect: intent,
        show_read: ReadObserved { value: p as String },
        grounding: Grounds {
          evidence: ConvergePlanApplied {
            exit_code: 0,
            stdout: concat("install-media-remaster: already present at ", p as String),
          }
        }
      )
    InstallMediaRemasterRemastered { path: p } =>
      reconcile_grounded(
        apply_effect: intent,
        show_read: ReadObserved { value: p as String },
        grounding: Grounds {
          evidence: ConvergePlanApplied {
            exit_code: 0,
            stdout: concat("install-media-remaster: remastered at ", p as String),
          }
        }
      )
    InstallMediaRemasterRefused { reason: why } =>
      NotConverged { reason: concat("install-media-remaster: ", why as String), applied: intent }
  }
}

fn realize_srv3_typed_reconcile(kind: TypedReconcileKind, transport: HostEffectTransport, intent: HostEffectIntent) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match transport {
    LocalShell =>
      match kind {
        TypedReconcileFetch => realize_install_media_fetch_in_process(intent: intent)
        TypedReconcileRemaster => realize_install_media_remaster_in_process(intent: intent)
      }
    SshShell { ssh_host: _ } =>
      NotConverged {
        reason: "host_effect_apply: TypedReconcileOnHost runs in-process on the executor's own host; SshShell transport is a fail-closed Unimplemented stub until the typed reconcile is realized over a remote-observe/apply transport.",
        applied: intent,
      }
    FleetSsh { target: _, context: _ } =>
      NotConverged {
        reason: "host_effect_apply: TypedReconcileOnHost runs in-process on the executor's own host; SshShell transport is a fail-closed Unimplemented stub until the typed reconcile is realized over a remote-observe/apply transport.",
        applied: intent,
      }
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      NotConverged {
        reason: "host_effect_apply: TypedReconcileOnHost runs in-process on the executor's own host; EmitArtifactThenThinRun is a fail-closed Unimplemented stub for this cell until the typed reconcile is realized over that transport.",
        applied: intent,
      }
  }
}

fn reconcile_shell_exec_observed(
  observed: ShellExecObserved,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let grounding = if observed.success {
      Grounds { evidence: ShellEffectApplied { exit_code: observed.exit_code, stdout: observed.stdout, stderr: observed.stderr } }
    } else {
      DoesNotGround { reason: shell_exec_failure_reason(observed: observed) }
    }
  reconcile_grounded(
    apply_effect: intent,
    show_read: ReadObserved { value: observed },
    grounding: grounding
  )
}

fn reconcile_ssh_argv_exec_outcome(
  outcome: TypedArgvExecOutcome,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  match outcome {
    TypedArgvExecConverged { result: r } =>
      reconcile_shell_exec_observed(
        observed: ShellExecObserved {
          exit_code: r.exit_code,
          success: r.success,
          stdout: r.stdout,
          stderr: r.stderr,
        },
        intent: intent,
      )
    TypedArgvExecRefused { reason: why } =>
      NotConverged { reason: why, applied: intent }
  }
}

data run_typed_argv_transport_authority_note: String = "Executor→target typed remote argv transport binding (codex_runtime_converge_local_shell_locus dissolve-on class; review 51883). SshShell routes through typed_argv_exec_over_ssh on the transport endpoint; FleetSsh routes through typed_argv_exec_over_fleet_ssh with sealed context. LocalShell refuses — remote argv requires a transport that names the target host. Shell script bodies use host_effect_realize run_shell_transport instead."

fn run_typed_argv_transport(
  argv: List<String>,
  transport: HostEffectTransport,
) -> TypedArgvExecOutcome {
  match transport {
    LocalShell =>
      TypedArgvExecRefused {
        reason: "run_typed_argv_transport: LocalShell has no remote target — use SshShell or FleetSsh when executor and subject host differ",
      }
    SshShell { ssh_host: h } =>
      typed_argv_exec_over_ssh(host: h, argv: argv)
    FleetSsh { target: t, context: c } =>
      typed_argv_exec_over_fleet_ssh(target: t, context: c, argv: argv)
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      TypedArgvExecRefused {
        reason: "run_typed_argv_transport: EmitArtifactThenThinRun is not a typed argv transport",
      }
  }
}

fn realize_effective_principal_read_on_host(
  read: EffectivePosixPrincipalRead,
  transport: HostEffectTransport,
  intent: HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let argv = posix_effective_principal_read_argv()
  match transport {
    LocalShell => {
      let result = effective_posix_principal_read(read: read)
      reconcile_shell_exec_observed(
        observed: ShellExecObserved {
          exit_code: result.exit_code,
          success: result.success,
          stdout: result.stdout,
          stderr: result.stderr,
        },
        intent: intent,
      )
    }
    SshShell { ssh_host: h } =>
      reconcile_ssh_argv_exec_outcome(
        outcome: typed_argv_exec_over_ssh(host: h, argv: argv),
        intent: intent,
      )
    FleetSsh { target: t, context: c } =>
      reconcile_ssh_argv_exec_outcome(
        outcome: typed_argv_exec_over_fleet_ssh(target: t, context: c, argv: argv),
        intent: intent,
      )
    EmitArtifactThenThinRun { bootstrap: _, invocation: _ } =>
      NotConverged {
        reason: "host_effect_apply: ReadEffectivePosixPrincipal cannot use EmitArtifactThenThinRun transport; typed mismatch.",
        applied: intent,
      }
  }
}

fn realize_sudo_nopasswd_execute_probe_on_host(
  probe: SudoNopasswdExecuteProbeShape,
  transport: HostEffectTransport,
