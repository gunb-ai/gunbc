module gunbc.systemd_unit_run_identity

import std.types { String, NonEmptyStr, Int, Bool, EpochSecs }
import std.optional { Present, Absent }
import extdeps.uuid { Uuid }
import extdeps.systemd.invocation_id { SystemdInvocationId, systemd_invocation_id_of }
import extdeps.linux.kernel_random { kernel_boot_id_of }
import extdeps.linux.proc_stat { proc_stat_boot_time, BootTimeObserved, BootTimeLineAbsent, BootTimeUnparseable, BootTimeBeforeEpoch }

// THE OBSERVED IDENTITY OF ONE RUN OF A SYSTEMD UNIT: (which manager, which boot, which InvocationID).
// Every component is read from the host and none is asserted by the caller:
//   - boot: extdeps.linux.kernel_random kernel_boot_id_of over /proc/sys/kernel/random/boot_id, and the boot's START
//     INSTANT (extdeps.linux.proc_stat proc_stat_boot_time, /proc/stat btime, whole seconds, so a consumer
//     comparing it with another clock owns the skew bound). The instant is evidence beside the id, not part of
//     run equality: it is derived from the boot and can wobble with clock steps, the id cannot;
//   - invocation: extdeps.systemd.invocation_id systemd_invocation_id_of over the unit's InvocationID
//     property, or $INVOCATION_ID inside the unit as the manager exports it;
//   - manager: the instance the reading was taken from (the system manager, or one user's).
// The id alone does not name a run: managers draw ids independently and a reboot ends every run of the boot,
// so equality is over the whole triple (unit_run_same).
//
// A MISSING OR MALFORMED COMPONENT IS A TYPED REFUSAL, never a default: UnitRunUnreadable carries the located
// cause, so "the run is gone" (an observed different run) and "the run could not be asked" are never one value.
// CONSUMERS (§3c): the slot-unit create-once request binding (bold-dove-340, executor follow-up to #15310) and the
// srv1 session-memory lease holder-death proof (snappy-carp-24) are declared frontiers, each adopting this
// carrier in its own change; gunbc.systemd_unit_invocation_liveness and gunbc.workspace_acquisition_invocation
// still key on a bare InvocationID and are the third and fourth sites to migrate. This change consumes the
// carrier in the witness and the live observation only.
type SystemdManagerInstance
  = SystemManager
  | UserManager { uid: Int }

type UnitRunIdentity {
  manager: SystemdManagerInstance
  boot_id: Uuid
  boot_started_at: EpochSecs
  invocation_id: SystemdInvocationId
}

type UnitRunReading
  = UnitRunRead { run: UnitRunIdentity }
  | UnitRunUnreadable { cause: NonEmptyStr }

fn systemd_manager_same(a: SystemdManagerInstance, b: SystemdManagerInstance) -> Bool {
  match a {
    SystemManager => match b { SystemManager => true  UserManager { uid: _ } => false }
    UserManager { uid: x } => match b { SystemManager => false  UserManager { uid: y } => x == y }
  }
}

fn unit_run_same(recorded: UnitRunIdentity, observed: UnitRunIdentity) -> Bool {
  systemd_manager_same(a: recorded.manager, b: observed.manager)
    && (recorded.boot_id as String) == (observed.boot_id as String)
    && (recorded.invocation_id as String) == (observed.invocation_id as String)
}

type UnitRunStanding
  = UnitRunIsRecordedRun
  | UnitRunIsDifferentRun { differs: NonEmptyStr }
  | UnitRunStandingUnobservable { cause: NonEmptyStr }

// The first differing component is named so a refusal is located. An unreadable observation is never folded
// into "different run": it may well be the same run.
fn unit_run_standing(recorded: UnitRunIdentity, observed: UnitRunReading) -> UnitRunStanding {
  match observed {
    UnitRunUnreadable { cause: c } => UnitRunStandingUnobservable { cause: c }
    UnitRunRead { run: o } =>
      if !systemd_manager_same(a: recorded.manager, b: o.manager) {
        UnitRunIsDifferentRun { differs: "manager" as NonEmptyStr }
      } else if (recorded.boot_id as String) != (o.boot_id as String) {
        UnitRunIsDifferentRun { differs: "boot_id" as NonEmptyStr }
      } else if (recorded.invocation_id as String) != (o.invocation_id as String) {
        UnitRunIsDifferentRun { differs: "invocation_id" as NonEmptyStr }
      } else { UnitRunIsRecordedRun }
  }
}

// ADMISSION from the three raw readings. Each decode refuses on its own wire shape.
fn unit_run_reading(manager: SystemdManagerInstance, boot_id_text: String, proc_stat_text: String, invocation_text: String) -> UnitRunReading {
  match kernel_boot_id_of(text: boot_id_text) {
    Absent => UnitRunUnreadable { cause: "boot_id is not a UUID (random(4))" as NonEmptyStr }
    Present { value: boot } => match systemd_invocation_id_of(text: invocation_text) {
      Absent => UnitRunUnreadable { cause: "InvocationID is not 32 lowercase hex digits (systemd.exec(5)), or the unit has not run" as NonEmptyStr }
      Present { value: inv } => match proc_stat_boot_time(content: proc_stat_text) {
        BootTimeObserved { epoch_seconds: t } => UnitRunRead { run: UnitRunIdentity { manager: manager, boot_id: boot, boot_started_at: t, invocation_id: inv } }
        BootTimeLineAbsent => UnitRunUnreadable { cause: "/proc/stat has no btime line" as NonEmptyStr }
        BootTimeUnparseable { field: _ } => UnitRunUnreadable { cause: "/proc/stat btime is not an integer" as NonEmptyStr }
        BootTimeBeforeEpoch { field: _ } => UnitRunUnreadable { cause: "/proc/stat btime precedes the epoch" as NonEmptyStr }
      }
    }
  }
}
