data sole_ctor_forged_red_probe: GuaranteeProbeId = "sole-constructor-cross-module-forged-red" as GuaranteeProbeId
data sole_ctor_green_probe: GuaranteeProbeId = "sole-constructor-cross-module-green-control" as GuaranteeProbeId
data sole_ctor_mint_fn_hole_probe: GuaranteeProbeId = "sole-constructor-mint-fn-cross-module-hole" as GuaranteeProbeId
// The CAST construction form. It was the named unknown in the capability audit (`casts like
// as TransportScript`) and it was a real hole: validate_cast judges only casts whose source and target
// both sit in std.coercion's primitive domain, so a cast into a sealed record was unjudged entirely.
// The probe casts a bare Int into the sealed fixture record from another module — a shape whose SOURCE
// is a cast-domain type and whose TARGET is not, so nothing but the sole_constructor check can refuse
// it, which is what makes it discriminating rather than incidentally red.
data sole_ctor_cast_red_probe: GuaranteeProbeId = "sole-constructor-cross-module-cast-red" as GuaranteeProbeId
// The CALLER-SEALED mint. sole_constructor confines construction to the definer; admit_callers confines
// who may call the definer's exported mint. The two are the wall only together: without the second, a
// sealed type with any exported mint is sealed in name only. This probe calls the sealed fixture mint
// from a module its admit_callers list does not name; the green counterpart is the admitted caller.
data sole_ctor_unadmitted_caller_red_probe: GuaranteeProbeId = "sole-constructor-unadmitted-caller-red" as GuaranteeProbeId
data sole_ctor_admitted_caller_green_probe: GuaranteeProbeId = "sole-constructor-admitted-caller-green-control" as GuaranteeProbeId

data v2_frontier_red_probe: GuaranteeProbeId = "v2-self-grounding-frontier-value-red" as GuaranteeProbeId
data v2_frontier_green_probe: GuaranteeProbeId = "v2-self-grounding-frontier-derived-green" as GuaranteeProbeId

// ExpectSilentAcceptanceHole IS NOT ExpectZeroDiagnostics WITH A COMMENT. Both hold on exactly
// the same observation -- AcceptedClean -- and that coincidence is precisely why they must be two
// variants rather than one: a green control's silence is the guarantee, a hole's silence IS the
// defect, and the two have opposite owners and opposite repairs (DESIGN, not-applicable-rendered-
// as-malformed, read in the other direction). Collapsing them would make the corpus unable to
// answer "how many of these greens are walls?" -- the question the sec 4b rung census asks of it.
// invalid_state names the state that compiles today and must not; when the wall lands the probe
// flips RED and its row is rewritten as ExpectBlockingRefusal naming the class that then fires.
// It does not retire at that point: per sec 4b meta-obligation 4 it becomes the permanent
// regression control that the higher rung stays real.
type ProbeExpectation
  = ExpectBlockingRefusal { diagnostic_class: NonEmptyStr }
  | ExpectZeroDiagnostics
  | ExpectAcceptedCounted { diagnostic_class: NonEmptyStr }
  | ExpectSilentAcceptanceHole { invalid_state: NonEmptyStr }

type ProbeExpectationFold<R> {
  blocking_refusal: fn(NonEmptyStr) -> R
  zero_diagnostics: R
  accepted_counted: fn(NonEmptyStr) -> R
  silent_acceptance_hole: fn(NonEmptyStr) -> R
}

fn probe_expectation_fold<R>(e: ProbeExpectation, fold: ProbeExpectationFold<R>) -> R {
  match e {
    ExpectBlockingRefusal { diagnostic_class: d } => fold.blocking_refusal(d)
    ExpectZeroDiagnostics => fold.zero_diagnostics
    ExpectAcceptedCounted { diagnostic_class: d } => fold.accepted_counted(d)
    ExpectSilentAcceptanceHole { invalid_state: s } => fold.silent_acceptance_hole(s)
  }
}

fn probe_expectation_is_below_floor_hole(e: ProbeExpectation) -> Bool {
  probe_expectation_fold(
    e: e,
    fold: ProbeExpectationFold {
      blocking_refusal: fn(_) { false },
      zero_diagnostics: false,
      accepted_counted: fn(_) { false },
      silent_acceptance_hole: fn(_) { true },
    },
  )
}

fn guarantee_probe_below_floor_hole_rows() -> List<GuaranteeProbeRow> {
  guarantee_probe_rows() |> filter(row => probe_expectation_is_below_floor_hole(e: row.expectation))
}

fn harness_digest_from_material_and_expectation(
  harness_material: NonEmptyStr,
  expectation: ProbeExpectation,
) -> Fnv1a64Structural {
  content_hash_combine_structural(
    left: content_hash_atom(value: harness_material),
    right: expectation_harness_digest(e: expectation),
  )
}

data v1_compile_harness_source_paths_note: String = "v1_compile_harness_source_paths is the measured authority for compile_dag_diagnostic_census harness revision: probe-corpus bridge, guarantee_measurement folds, census vocabulary, the host builtin seam, and the v1 CompileAccept→Rust pipeline stages whose edits change which diagnostics a synthetic subject provokes. dissolve-on ladder-baseline stage supplies GitRevision harness anchors."

fn v1_compile_harness_source_paths() -> List<String> {
  [
    "dag/gunbc/guarantee_probe_corpus.dag",
    "dag/gunbc/guarantee_measurement.dag",
    "dag/gunbc/compile_diagnostic_census.dag",
    "src/v1/stage0/src/cli_run.rs",
    "src/v1/compile.dag",
    "src/v1/02_parse.dag",
    "src/v1/04_infer.dag",
    "src/v1/04_method.dag",
    "src/v1/04_types.dag",
    "dag/extdeps/uri.dag",
  ]
}

fn v2_infer_eval_harness_source_paths() -> List<String> {
  [
    "dag/gunbc/guarantee_probe_corpus.dag",
    "dag/gunbc/guarantee_measurement.dag",
    "src/v2/compiler/04_infer.dag",
    "src/v2/test/claim/infer_self_grounding_wall_test.dag",
  ]
}

fn v1_compile_harness_revision(
  probe: GuaranteeProbeId,
  expectation: ProbeExpectation,
  harness_source: NonEmptyStr,
) -> MeasurementRevision {
  synthetic_program_harness_revision_from_digest(
    probe: probe,
    digest: harness_digest_from_material_and_expectation(
      harness_material: harness_source,
      expectation: expectation,
    ),
  )
}

fn v2_infer_eval_harness_revision(
  probe: GuaranteeProbeId,
  expectation: ProbeExpectation,
  harness_source: NonEmptyStr,
) -> MeasurementRevision {
  synthetic_program_harness_revision_from_digest(
    probe: probe,
    digest: harness_digest_from_material_and_expectation(
      harness_material: harness_source,
      expectation: expectation,
    ),
  )
}

fn expectation_harness_digest(e: ProbeExpectation) -> Fnv1a64Structural {
  probe_expectation_fold(
    e: e,
    fold: ProbeExpectationFold {
      blocking_refusal: fn(d) {
        content_hash_tagged_structural(
          tag: "blocking-refusal" as NonEmptyStr,
          payload: content_hash_atom(value: d),
        )
      },
      zero_diagnostics: content_hash_atom(value: "zero-diagnostics" as NonEmptyStr),
      accepted_counted: fn(d) {
        content_hash_tagged_structural(
          tag: "accepted-counted" as NonEmptyStr,
          payload: content_hash_atom(value: d),
        )
      },
      silent_acceptance_hole: fn(s) {
        content_hash_tagged_structural(
          tag: "silent-acceptance-hole" as NonEmptyStr,
          payload: content_hash_atom(value: s),
        )
      },
    },
  )
}

fn synthetic_program_harness_revision_from_digest(probe: GuaranteeProbeId, digest: Fnv1a64Structural) -> MeasurementRevision {
  ContentFingerprint {
    digest: content_hash_tagged_structural(
      tag: "guarantee-probe-harness-v1" as NonEmptyStr,
      payload: content_hash_combine_structural(
        left: content_hash_atom(value: probe as NonEmptyStr),
        right: digest,
      ),
    ),
  }
}

fn infer_eval_node_structural_hash(node: Node) -> Fnv1a64Structural {
  structural_content_hash(digest: content_hash(n: node).digest as Fnv1a64StructuralDigestHex)
}

fn synthetic_infer_eval_subject_revision_from_node(node: Node) -> MeasurementRevision {
  ContentFingerprint {
    digest: content_hash_tagged_structural(
      tag: "v2-infer-eval-subject-node-v1" as NonEmptyStr,
      payload: infer_eval_node_structural_hash(node: node),
    ),
  }
}

type DarkSuiteWitnessDisposition
  = MigratedToEnrolledDagProbe {
      rust_witness: NonEmptyStr,
      dag_probes: List<GuaranteeProbeId>,
      rust_retained_until: NonEmptyStr,
    }

data guarantee_probe_dark_suite_disposition_note: String = "Slice 1 MIGRATES landed wall REDs into enrolled .dag probes without dissolving the dark Rust suite (gap-analysis sec 11 item 9 operator ruling): each row names the executing .dag probe(s), the retained Rust witness they replace on the floor, and the finite-classification gate that must disposition the Rust copy before deletion. MIGRATE never duplicate means one enrolled measurement authority per class — not silent parallel maintenance forever."

fn guarantee_probe_dark_suite_dispositions() -> List<DarkSuiteWitnessDisposition> {
  [
    MigratedToEnrolledDagProbe {
      rust_witness: "call_shape_wall_witness" as NonEmptyStr,
      dag_probes: [call_deficit_red_probe, call_shape_green_probe, call_mislabel_red_probe, call_surplus_red_probe],
      rust_retained_until: "gap-analysis-sec-11-item-9-finite-classification" as NonEmptyStr,
    },
    MigratedToEnrolledDagProbe {
      rust_witness: "call_shape_duplicate_wall_witness" as NonEmptyStr,
      dag_probes: [call_duplicate_red_probe, call_duplicate_green_probe],
      rust_retained_until: "gap-analysis-sec-11-item-9-finite-classification" as NonEmptyStr,
    },
    MigratedToEnrolledDagProbe {
      rust_witness: "method_existence_wall_witness" as NonEmptyStr,
      dag_probes: [method_missing_red_probe, method_green_probe],
      rust_retained_until: "gap-analysis-sec-11-item-9-finite-classification" as NonEmptyStr,
    },
    MigratedToEnrolledDagProbe {
      rust_witness: "declared_type_conformance_witness" as NonEmptyStr,
      dag_probes: [conformance_scalar_red_probe, conformance_green_probe],
      rust_retained_until: "gap-analysis-sec-11-item-9-finite-classification" as NonEmptyStr,
    },
    MigratedToEnrolledDagProbe {
      rust_witness: "sole_constructor_violation_outside_module" as NonEmptyStr,
      dag_probes: [sole_ctor_forged_red_probe, sole_ctor_green_probe],
      rust_retained_until: "gap-analysis-sec-11-item-9-finite-classification" as NonEmptyStr,
    },
  ]
}

type GuaranteeProbeRow {
  probe: GuaranteeProbeId
  class: GuaranteeClassId
  path: GuaranteePathId
  expectation: ProbeExpectation
}

type V1CompileProbeRow {
  probe: GuaranteeProbeId
  class: GuaranteeClassId
  expectation: ProbeExpectation
}

type V2InferEvalProbeRow {
  probe: GuaranteeProbeId
  class: GuaranteeClassId
  expectation: ProbeExpectation
}

type ProbeRowResolution
  = ProbeRowResolved { row: GuaranteeProbeRow }
  | ProbeRowUnknown { wanted: GuaranteeProbeId }
  | ProbeRowDuplicate { wanted: GuaranteeProbeId, matches: Int }

