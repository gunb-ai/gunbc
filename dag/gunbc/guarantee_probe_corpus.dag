      expectation: ExpectBlockingRefusal { diagnostic_class: "CallArgumentNameUnknown" as std.types.NonEmptyStr },
    },
    GuaranteeProbeRow {
      probe: call_surplus_red_probe,
      class: call_label_surplus_class,
      path: v1_compile_rust_path_id,
      expectation: ExpectBlockingRefusal { diagnostic_class: "CallPositionalSurplus" as std.types.NonEmptyStr },
    },
    GuaranteeProbeRow {
      probe: conformance_green_probe,
      class: declared_conformance_ground_class,
      path: v1_compile_rust_path_id,
      expectation: ExpectZeroDiagnostics,
    },
    GuaranteeProbeRow {
