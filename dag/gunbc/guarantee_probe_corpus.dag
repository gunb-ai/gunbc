      expectation: ExpectBlockingRefusal { diagnostic_class: "TypeMismatch" as std.types.NonEmptyStr },
    },
    GuaranteeProbeRow {
      probe: direct_call_arg_type_ordinary_module_red_probe,
      class: direct_call_argument_type_class,
      path: v1_compile_rust_path_id,
      expectation: ExpectBlockingRefusal { diagnostic_class: "TypeMismatch" as NonEmptyStr },
    },
    GuaranteeProbeRow {
      probe: direct_call_arg_type_v2_green_control_probe,
      class: direct_call_argument_type_class,
      path: v1_compile_rust_path_id,
      expectation: ExpectZeroDiagnostics,
    },
    GuaranteeProbeRow {
      probe: direct_call_arg_type_v2_module_red_probe,
      class: direct_call_argument_type_class,
      path: v1_compile_rust_path_id,
      expectation: ExpectBlockingRefusal { diagnostic_class: "TypeMismatch" as NonEmptyStr },
    },
    GuaranteeProbeRow {
      probe: method_green_probe,
      class: method_established_surface_class,
      path: v1_compile_rust_path_id,
      expectation: ExpectZeroDiagnostics,
    },
    GuaranteeProbeRow {
      probe: method_missing_red_probe,
      class: method_established_surface_class,
      path: v1_compile_rust_path_id,
      expectation: ExpectBlockingRefusal { diagnostic_class: "MethodNotFound" as std.types.NonEmptyStr },
    },
    GuaranteeProbeRow {
      probe: sole_ctor_admitted_caller_green_probe,
      class: sole_constructor_cross_module_class,
      path: v1_compile_rust_path_id,
      expectation: ExpectZeroDiagnostics,
    },
    GuaranteeProbeRow {
      probe: sole_ctor_cast_red_probe,
      class: sole_constructor_cross_module_class,
      path: v1_compile_rust_path_id,
      expectation: ExpectBlockingRefusal { diagnostic_class: "SoleConstructorViolation" as std.types.NonEmptyStr },
    },
    GuaranteeProbeRow {
      probe: sole_ctor_forged_red_probe,
      class: sole_constructor_cross_module_class,
      path: v1_compile_rust_path_id,
      expectation: ExpectBlockingRefusal { diagnostic_class: "SoleConstructorViolation" as std.types.NonEmptyStr },
    },
    GuaranteeProbeRow {
      probe: sole_ctor_green_probe,
      class: sole_constructor_cross_module_class,
      path: v1_compile_rust_path_id,
      expectation: ExpectZeroDiagnostics,
    },
    GuaranteeProbeRow {
      probe: sole_ctor_mint_fn_hole_probe,
      class: sole_constructor_cross_module_class,
      path: v1_compile_rust_path_id,
      expectation: ExpectBlockingRefusal { diagnostic_class: "SoleConstructorViolation" as std.types.NonEmptyStr },
    },
    GuaranteeProbeRow {
      probe: sole_ctor_unadmitted_caller_red_probe,
      class: sole_constructor_cross_module_class,
      path: v1_compile_rust_path_id,
      expectation: ExpectBlockingRefusal { diagnostic_class: "ConstructorCallAdmissionRefused" as std.types.NonEmptyStr },
    },
    GuaranteeProbeRow {
      probe: v2_frontier_green_probe,
      class: v2_self_grounding_frontier_class,
      path: v2_infer_eval_path_id,
      expectation: ExpectZeroDiagnostics,
    },
    GuaranteeProbeRow {
      probe: v2_frontier_red_probe,
      class: v2_self_grounding_frontier_class,
      path: v2_infer_eval_path_id,
      expectation: ExpectAcceptedCounted { diagnostic_class: "infer_grounding_not_derived" as std.types.NonEmptyStr },
    },
  ]
}

fn guarantee_probe_ids() -> std.types.List<gunbc.guarantee_measurement.GuaranteeProbeId> {
  guarantee_probe_rows() |> map(row => row.probe)
}

fn resolve_guarantee_probe_row(rows: std.types.List<GuaranteeProbeRow>, wanted: gunbc.guarantee_measurement.GuaranteeProbeId) -> ProbeRowResolution {
  let hits = rows |> filter(row => (row.probe as String) == (wanted as String))
  if count(hits) == 0 {
    ProbeRowUnknown { wanted: wanted }
  } else if count(hits) > 1 {
    ProbeRowDuplicate { wanted: wanted, matches: count(hits) }
  } else {
    match hits |> first {
      Present { value: row } => ProbeRowResolved { row: row }
      Absent => ProbeRowUnknown { wanted: wanted }
    }
  }
}

fn resolve_canonical_probe_row(wanted: gunbc.guarantee_measurement.GuaranteeProbeId) -> ProbeRowResolution {
  resolve_guarantee_probe_row(rows: guarantee_probe_rows(), wanted: wanted)
}

fn canonical_probe_row_resolution_refuses_duplicate_population() -> Bool {
  match active_probe_row(probe: call_mislabel_red_probe) {
    Present { value: row } =>
      match resolve_guarantee_probe_row(rows: guarantee_probe_rows(), wanted: call_mislabel_red_probe) {
        ProbeRowResolved { row: _ } =>
          match resolve_guarantee_probe_row(
            rows: append(guarantee_probe_rows(), items: [row]),
            wanted: call_mislabel_red_probe,
          ) {
            ProbeRowDuplicate { wanted: _, matches: 2 } => true
            _ => false
          }
        _ => false
      }
    Absent => false
  }
}

fn active_probe_row(probe: gunbc.guarantee_measurement.GuaranteeProbeId) -> GuaranteeProbeRow? {
  match resolve_guarantee_probe_row(rows: guarantee_probe_rows(), wanted: probe) {
    ProbeRowResolved { row: row } => v2.std.optional.Present { value: row }
    ProbeRowUnknown { wanted: _ } => none
    ProbeRowDuplicate { wanted: _, matches: _ } => none
  }
}

fn v1_compile_probe_row_from_registry(row: GuaranteeProbeRow) -> V1CompileProbeRow? {
  if (row.path as String) == (v1_compile_rust_path_id as String) {
    v2.std.optional.Present {
      value: V1CompileProbeRow {
        probe: row.probe,
        class: row.class,
        expectation: row.expectation,
      },
    }
  } else {
    none
  }
}

fn v2_infer_eval_probe_row_from_registry(row: GuaranteeProbeRow) -> V2InferEvalProbeRow? {
  if (row.path as String) == (v2_infer_eval_path_id as String) {
    v2.std.optional.Present {
      value: V2InferEvalProbeRow {
        probe: row.probe,
        class: row.class,
        expectation: row.expectation,
      },
    }
  } else {
    none
  }
}

fn active_v1_compile_probe_row(probe: gunbc.guarantee_measurement.GuaranteeProbeId) -> V1CompileProbeRow? {
  match active_probe_row(probe: probe) {
    Present { value: row } => v1_compile_probe_row_from_registry(row: row)
    Absent => none
  }
}

fn active_v2_infer_eval_probe_row(probe: gunbc.guarantee_measurement.GuaranteeProbeId) -> V2InferEvalProbeRow? {
  match active_probe_row(probe: probe) {
    Present { value: row } => v2_infer_eval_probe_row_from_registry(row: row)
    Absent => none
  }
}

fn executed_probe_ids_for_probe(probe: gunbc.guarantee_measurement.GuaranteeProbeId) -> std.types.List<gunbc.guarantee_measurement.GuaranteeProbeId> {
  [probe]
}

fn guarantee_probe_id_strings() -> std.types.List<String> {
  fold(
    guarantee_probe_ids(),
    init: [],
    f: fn(acc, id) { append(acc, items: [id as String]) },
  )
}

type ProbeLexWalk {
  prev: String?
  ok: Bool
}

fn probe_ids_are_lexicographically_ordered(ids: std.types.List<gunbc.guarantee_measurement.GuaranteeProbeId>) -> Bool {
  let walked = fold(ids, init: ProbeLexWalk { prev: none, ok: true }, f: fn(acc, id) {
    let current = id as String
    if !acc.ok {
      acc
    } else {
      match acc.prev {
        Absent => ProbeLexWalk { prev: v2.std.optional.Present { value: current }, ok: true }
        Present { value: prev } =>
          if std.string_type.string_is_lexicographically_before(left: prev, right: current) {
            ProbeLexWalk { prev: v2.std.optional.Present { value: current }, ok: true }
          } else {
            ProbeLexWalk { prev: v2.std.optional.Present { value: current }, ok: false }
          }
      }
    }
  })
  walked.ok
}

fn non_empty_diagnostics_count_reason(nes: v2.std.diagnostic.NonEmptyDiagnostics, reason: v2.std.node.Symbol) -> std.nat.Nat {
  let head_count = if nes.head.reason == reason { 1 } else { 0 }
  v2.std.algebra.fold_list(
    xs: nes.tail,
    empty: head_count,
    cons: fn(acc, d) {
      if d.reason == reason { acc + 1 } else { acc }
    },
  )
}

fn probe_observation_from_accepted_infer_diagnostics(diagnostics: v2.std.diagnostic.Diagnostics) -> gunbc.guarantee_measurement.ProbeObservation {
  match diagnostics {
    None => gunbc.guarantee_measurement.AcceptedClean
    Some { diagnostics: nes } =>
      gunbc.guarantee_measurement.AcceptedCounted {
        diagnostic_class: nes.head.reason as std.types.NonEmptyStr,
        count: non_empty_diagnostics_count_reason(nes: nes, reason: nes.head.reason),
      }
  }
}

fn census_row_count(rows: std.types.List<gunbc.compile_diagnostic_census.CompileDiagnosticCensusRow>) -> Int {
  count(rows)
}

fn census_blocking_count_for_class(census: gunbc.compile_diagnostic_census.CompileDiagnosticCensus, wanted: String) -> Int? {
  match census {
    CensusObserved { rows: rows } =>
      v2.std.optional.Present {
        value: gunbc.compile_diagnostic_census.census_total_count(rows: gunbc.compile_diagnostic_census.census_rows_of_class(rows: gunbc.compile_diagnostic_census.census_blocking_rows(rows: rows), wanted: wanted))
      }
    CensusNotRunnable { cause: _ } => none
  }
}

fn census_any_count_for_class(census: gunbc.compile_diagnostic_census.CompileDiagnosticCensus, wanted: String) -> Int? {
  match census {
    CensusObserved { rows: rows } =>
      v2.std.optional.Present { value: gunbc.compile_diagnostic_census.census_total_count(rows: gunbc.compile_diagnostic_census.census_rows_of_class(rows: rows, wanted: wanted)) }
    CensusNotRunnable { cause: _ } => none
  }
}

fn observation_is_blocking_refusal(o: gunbc.guarantee_measurement.ProbeObservation, wanted: std.types.NonEmptyStr) -> Bool {
  gunbc.guarantee_measurement.probe_observation_fold(
    o: o,
    fold: gunbc.guarantee_measurement.ProbeObservationFold {
      refused: fn(d, _) { d == wanted },
      accepted_clean: false,
      accepted_counted: fn(_, _) { false },
      diverged: fn(_) { false },
      not_runnable: fn(_) { false },
    },
  )
}

fn observation_is_clean(o: gunbc.guarantee_measurement.ProbeObservation) -> Bool {
  gunbc.guarantee_measurement.probe_observation_fold(
    o: o,
    fold: gunbc.guarantee_measurement.ProbeObservationFold {
      refused: fn(_, _) { false },
      accepted_clean: true,
      accepted_counted: fn(_, _) { false },
      diverged: fn(_) { false },
      not_runnable: fn(_) { false },
    },
  )
}

fn probe_expectation_holds(census: gunbc.compile_diagnostic_census.CompileDiagnosticCensus, expectation: ProbeExpectation) -> Bool {
  probe_row_observation_holds(
    observation: probe_observation_from_census(census: census),
    expectation: expectation,
  )
}

fn probe_row_expectation_holds(census: gunbc.compile_diagnostic_census.CompileDiagnosticCensus, row: GuaranteeProbeRow) -> Bool {
  probe_row_observation_holds(
    observation: probe_observation_from_census(census: census),
    expectation: row.expectation,
  )
}

fn observation_is_accepted_counted(o: gunbc.guarantee_measurement.ProbeObservation, wanted: std.types.NonEmptyStr) -> Bool {
  gunbc.guarantee_measurement.probe_observation_fold(
    o: o,
    fold: gunbc.guarantee_measurement.ProbeObservationFold {
      refused: fn(_, _) { false },
      accepted_clean: false,
      accepted_counted: fn(cls, _) { cls == wanted },
      diverged: fn(_) { false },
      not_runnable: fn(_) { false },
    },
  )
}

fn probe_row_observation_holds(observation: gunbc.guarantee_measurement.ProbeObservation, expectation: ProbeExpectation) -> Bool {
  probe_expectation_fold(
    e: expectation,
    fold: ProbeExpectationFold {
      blocking_refusal: fn(wanted) { observation_is_blocking_refusal(o: observation, wanted: wanted) },
      zero_diagnostics: observation_is_clean(o: observation),
      accepted_counted: fn(wanted) { observation_is_accepted_counted(o: observation, wanted: wanted) },
    },
  )
}

fn probe_row_observation_holds_for_row(observation: gunbc.guarantee_measurement.ProbeObservation, row: GuaranteeProbeRow) -> Bool {
  probe_row_observation_holds(observation: observation, expectation: row.expectation)
}

fn receipt_matches_probe_row(receipt: gunbc.guarantee_measurement.GuaranteeMeasurementReceipt, row: GuaranteeProbeRow) -> Bool {
  (receipt.probe as String) == (row.probe as String)
    && (receipt.class as String) == (row.class as String)
    && (receipt.path as String) == (row.path as String)
}

fn receipt_matches_v1_compile_probe_row(receipt: gunbc.guarantee_measurement.GuaranteeMeasurementReceipt, row: V1CompileProbeRow) -> Bool {
  (receipt.probe as String) == (row.probe as String)
    && (receipt.class as String) == (row.class as String)
    && (receipt.path as String) == (v1_compile_rust_path_id as String)
}

fn receipt_matches_v2_infer_eval_probe_row(receipt: gunbc.guarantee_measurement.GuaranteeMeasurementReceipt, row: V2InferEvalProbeRow) -> Bool {
  (receipt.probe as String) == (row.probe as String)
    && (receipt.class as String) == (row.class as String)
    && (receipt.path as String) == (v2_infer_eval_path_id as String)
}

fn observation_refused_count(o: gunbc.guarantee_measurement.ProbeObservation) -> Int {
  gunbc.guarantee_measurement.probe_observation_fold(
    o: o,
    fold: gunbc.guarantee_measurement.ProbeObservationFold {
      refused: fn(_, c) { c },
      accepted_clean: 0,
      accepted_counted: fn(_, _) { 0 },
      diverged: fn(_) { 0 },
      not_runnable: fn(_) { 0 },
    },
  )
}

fn census_primary_observation(rows: std.types.List<gunbc.compile_diagnostic_census.CompileDiagnosticCensusRow>) -> gunbc.guarantee_measurement.ProbeObservation {
  let blocking = gunbc.compile_diagnostic_census.census_blocking_rows(rows: rows)
  if census_row_count(rows: blocking) >= 1 {
    match blocking |> first {
      Present { value: r } =>
        gunbc.guarantee_measurement.RefusedTyped {
          diagnostic_class: r.diagnostic_class,
          count: gunbc.compile_diagnostic_census.census_total_count(
            rows: gunbc.compile_diagnostic_census.census_rows_of_class(rows: blocking, wanted: r.diagnostic_class as String),
          ),
        }
      Absent => gunbc.guarantee_measurement.AcceptedClean
    }
  } else if census_row_count(rows: rows) == 0 {
    gunbc.guarantee_measurement.AcceptedClean
  } else {
    match rows |> first {
      Present { value: r } =>
        gunbc.guarantee_measurement.AcceptedCounted { diagnostic_class: r.diagnostic_class, count: r.count }
      Absent => gunbc.guarantee_measurement.AcceptedClean
    }
  }
}

fn probe_observation_from_census(census: gunbc.compile_diagnostic_census.CompileDiagnosticCensus) -> gunbc.guarantee_measurement.ProbeObservation {
  match census {
    CensusNotRunnable { cause: c } => gunbc.guarantee_measurement.ProbeNotRunnable { cause: c }
    CensusObserved { rows: rows } => census_primary_observation(rows: rows)
  }
}

fn build_v1_compile_receipt(
  row: V1CompileProbeRow,
  census: gunbc.compile_diagnostic_census.CompileDiagnosticCensus,
  subject_revision: gunbc.guarantee_measurement.MeasurementRevision,
  harness_revision: gunbc.guarantee_measurement.MeasurementRevision,
) -> gunbc.guarantee_measurement.GuaranteeMeasurementReceipt {
  let executed_probe_ids = executed_probe_ids_for_probe(probe: row.probe)
  gunbc.guarantee_measurement.GuaranteeMeasurementReceipt {
    class: row.class,
    path: v1_compile_rust_path_id,
    probe: row.probe,
    subject_revision: subject_revision,
    harness_revision: harness_revision,
    probe_set_digest: gunbc.guarantee_measurement.probe_set_digest(probe_ids: executed_probe_ids),
    observed: probe_observation_from_census(census: census),
  }
}

fn receipt_joins_v1_compile_path(receipt: gunbc.guarantee_measurement.GuaranteeMeasurementReceipt) -> Bool {
  match gunbc.guarantee_measurement.join_receipt_to_path(receipt: receipt, paths: guarantee_probe_paths()) {
    ReceiptJoined { path: p } => (p.id as String) == (v1_compile_rust_path_id as String)
    ReceiptPathUnknown { receipt_path: _ } => false
    ReceiptPathDuplicate { receipt_path: _, matches: _ } => false
  }
}

fn build_v2_infer_eval_receipt(
  row: V2InferEvalProbeRow,
  observed: gunbc.guarantee_measurement.ProbeObservation,
  subject_revision: gunbc.guarantee_measurement.MeasurementRevision,
  harness_revision: gunbc.guarantee_measurement.MeasurementRevision,
) -> gunbc.guarantee_measurement.GuaranteeMeasurementReceipt {
  let executed_probe_ids = executed_probe_ids_for_probe(probe: row.probe)
  gunbc.guarantee_measurement.GuaranteeMeasurementReceipt {
    class: row.class,
    path: v2_infer_eval_path_id,
    probe: row.probe,
    subject_revision: subject_revision,
    harness_revision: harness_revision,
    probe_set_digest: gunbc.guarantee_measurement.probe_set_digest(probe_ids: executed_probe_ids),
    observed: observed,
  }
}
