data guarantee_probe_corpus_charter_note: String = "STAGE 1a SLICE 1 OF THE GUARANTEE SPINE (roadmap node ladder-probe-corpus): the landed wall controls from gunbc#7519 (call-label-and-surplus), gunbc#7484 (method-established-surface + declared-conformance-ground-fragment), gunbc#7485 (InferToEval self-grounding frontier), and gunbc#7555 (InferToTranslate underived-refusal, in flight — identities reserved, executing translate probes coordinate with merry-cat-407) migrated onto gunbc.guarantee_measurement identities — MIGRATE, never duplicate beside the dark-suite originals. Each row carries a GuaranteeClassId, GuaranteePathId, and GuaranteeProbeId; receipts name subject_revision, harness_revision, and probe_set_digest per the Stage-0 schema. This slice owns the identity registry, canonical probe ordering, and the census-to-observation bridge for the v1 compile path. v2 InferToEval executing evidence joins the registry from src/v2/test/claim/infer_self_grounding_wall_test.dag; InferToTranslate identities are declared here but executing probes land with #7555. No disposition, no rung, no claims carrier — those arrive with ladder-claims-carrier."

data guarantee_probe_corpus_path_scope_note: String = "THREE PATHS FOR THE LANDED WALLS: v1-compile-rust is subject_grain SyntheticProgram, acceptance_boundary CompileAccept, realization_target EmittedTarget { language: rust } — the path compile_diagnostic_census measures. v2-infer-eval is the same subject grain with acceptance_boundary InferToEval and realization_target InterpreterRealization — the path gunbc#7485's GroundingNotDerived frontier diagnostic lives on. v2-infer-translate is the same subject grain with acceptance_boundary InferToTranslate and realization_target InterpreterRealization — the path gunbc#7555's translate-underived-refusal diagnostic lives on. A receipt keyed to one path must not claim coverage the other measures (DESIGN 4b minimum-across-paths discipline)."

data guarantee_probe_corpus_probe_order_note: String = "CANONICAL PROBE ORDERING OBLIGATION (probe_set_digest note): guarantee_probe_ids lists probes in stable lexicographic order by branded id string. Callers must not re-sort; the roster order here IS the probe-set digest authority for this stage."

data guarantee_probe_corpus_revision_note: String = "subject_revision and harness_revision are REQUIRED on every receipt. build_v1_compile_receipt and build_v2_phase_receipt take both from the caller — witness fixtures own placeholder revisions until the baseline stage names real commits; the corpus module does not fabricate provenance inside the builders."

data v1_compile_rust_path_id: GuaranteePathId = "v1-compile-rust" as GuaranteePathId
data v2_infer_eval_path_id: GuaranteePathId = "v2-infer-eval" as GuaranteePathId
data v2_infer_translate_path_id: GuaranteePathId = "v2-infer-translate" as GuaranteePathId

fn v1_compile_rust_path() -> GuaranteePath {
  GuaranteePath {
    id: v1_compile_rust_path_id,
    subject_grain: SyntheticProgram,
    acceptance_boundary: CompileAccept,
    realization_target: EmittedTarget { language: "rust" as GuaranteeTargetName },
  }
}

fn v2_infer_eval_path() -> GuaranteePath {
  GuaranteePath {
    id: v2_infer_eval_path_id,
    subject_grain: SyntheticProgram,
    acceptance_boundary: InferToEval,
    realization_target: InterpreterRealization,
  }
}

fn v2_infer_translate_path() -> GuaranteePath {
  GuaranteePath {
    id: v2_infer_translate_path_id,
    subject_grain: SyntheticProgram,
    acceptance_boundary: InferToTranslate,
    realization_target: InterpreterRealization,
  }
}

fn guarantee_probe_paths() -> List<GuaranteePath> {
  [v1_compile_rust_path(), v2_infer_eval_path(), v2_infer_translate_path()]
}

data call_label_surplus_class: GuaranteeClassId = "call-label-and-surplus" as GuaranteeClassId
data method_established_surface_class: GuaranteeClassId = "method-established-surface" as GuaranteeClassId
data declared_conformance_ground_class: GuaranteeClassId = "declared-conformance-ground-fragment" as GuaranteeClassId
data v2_self_grounding_frontier_class: GuaranteeClassId = "v2-self-grounding-frontier" as GuaranteeClassId
data v2_translate_underived_refusal_class: GuaranteeClassId = "v2-translate-underived-refusal" as GuaranteeClassId

fn guarantee_probe_class_ids() -> List<GuaranteeClassId> {
  [
    call_label_surplus_class,
    declared_conformance_ground_class,
    method_established_surface_class,
    v2_self_grounding_frontier_class,
    v2_translate_underived_refusal_class,
  ]
}

data call_mislabel_red_probe: GuaranteeProbeId = "call-label-surplus-mislabel-red" as GuaranteeProbeId
data call_surplus_red_probe: GuaranteeProbeId = "call-label-surplus-surplus-red" as GuaranteeProbeId
data call_shape_green_probe: GuaranteeProbeId = "call-label-surplus-green-control" as GuaranteeProbeId

data method_missing_red_probe: GuaranteeProbeId = "method-established-surface-missing-red" as GuaranteeProbeId
data method_green_probe: GuaranteeProbeId = "method-established-surface-green-control" as GuaranteeProbeId

data conformance_scalar_red_probe: GuaranteeProbeId = "declared-conformance-ground-scalar-red" as GuaranteeProbeId
data conformance_green_probe: GuaranteeProbeId = "declared-conformance-ground-green-control" as GuaranteeProbeId

data v2_frontier_red_probe: GuaranteeProbeId = "v2-self-grounding-frontier-value-red" as GuaranteeProbeId
data v2_frontier_green_probe: GuaranteeProbeId = "v2-self-grounding-frontier-derived-green" as GuaranteeProbeId
data v2_translate_underived_red_probe: GuaranteeProbeId = "v2-translate-underived-refusal-conj-red" as GuaranteeProbeId
data v2_translate_underived_green_probe: GuaranteeProbeId = "v2-translate-underived-refusal-derived-green" as GuaranteeProbeId

fn guarantee_probe_ids() -> List<GuaranteeProbeId> {
  [
    call_shape_green_probe,
    call_mislabel_red_probe,
    call_surplus_red_probe,
    conformance_green_probe,
    conformance_scalar_red_probe,
    method_green_probe,
    method_missing_red_probe,
    v2_frontier_green_probe,
    v2_frontier_red_probe,
    v2_translate_underived_red_probe,
    v2_translate_underived_green_probe,
  ]
}

data canonical_probe_id_strings: List<String> = [
  "call-label-surplus-green-control",
  "call-label-surplus-mislabel-red",
  "call-label-surplus-surplus-red",
  "declared-conformance-ground-green-control",
  "declared-conformance-ground-scalar-red",
  "method-established-surface-green-control",
  "method-established-surface-missing-red",
  "v2-self-grounding-frontier-derived-green",
  "v2-self-grounding-frontier-value-red",
  "v2-translate-underived-refusal-conj-red",
  "v2-translate-underived-refusal-derived-green",
]

type ProbeOrderWalk {
  index: Int
  ok: Bool
}

fn probe_ids_match_canonical_order(ids: List<GuaranteeProbeId>) -> Bool {
  let walked = fold(ids, init: ProbeOrderWalk { index: 0, ok: true }, f: fn(acc, id) {
    if !acc.ok {
      acc
    } else {
      match list_at_optional(xs: canonical_probe_id_strings, index: acc.index) {
        Present { value: exp } =>
          if (id as String) == exp {
            ProbeOrderWalk { index: acc.index + 1, ok: true }
          } else {
            ProbeOrderWalk { index: acc.index, ok: false }
          }
        Absent => ProbeOrderWalk { index: acc.index, ok: false }
      }
    }
  })
  walked.ok && count(ids) == count(canonical_probe_id_strings)
}

type ProbeExpectation
  = ExpectBlockingRefusal { diagnostic_class: NonEmptyStr }
  | ExpectZeroDiagnostics

fn census_row_count(rows: List<CompileDiagnosticCensusRow>) -> Int {
  count(rows)
}

fn census_blocking_count_for_class(census: CompileDiagnosticCensus, wanted: String) -> Int {
  match census {
    CensusObserved { rows: rows } =>
      census_total_count(rows: census_rows_of_class(rows: census_blocking_rows(rows: rows), wanted: wanted))
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}

fn census_any_count_for_class(census: CompileDiagnosticCensus, wanted: String) -> Int {
  match census {
    CensusObserved { rows: rows } =>
      census_total_count(rows: census_rows_of_class(rows: rows, wanted: wanted))
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}

fn observation_is_blocking_refusal(o: ProbeObservation, wanted: NonEmptyStr) -> Bool {
  probe_observation_fold(
    o: o,
    fold: ProbeObservationFold {
      refused: fn(d, _) { d == wanted },
      accepted_clean: false,
      accepted_counted: fn(_, _) { false },
      diverged: fn(_) { false },
      not_runnable: fn(_) { false },
    },
  )
}

fn observation_is_clean(o: ProbeObservation) -> Bool {
  probe_observation_fold(
    o: o,
    fold: ProbeObservationFold {
      refused: fn(_, _) { false },
      accepted_clean: true,
      accepted_counted: fn(_, _) { false },
      diverged: fn(_) { false },
      not_runnable: fn(_) { false },
    },
  )
}

fn probe_expectation_holds(census: CompileDiagnosticCensus, expectation: ProbeExpectation) -> Bool {
  let obs = probe_observation_from_census(census: census, expectation: expectation)
  match expectation {
    ExpectZeroDiagnostics => observation_is_clean(o: obs)
    ExpectBlockingRefusal { diagnostic_class: wanted } =>
      observation_is_blocking_refusal(o: obs, wanted: wanted)
  }
}

fn observation_refused_count(o: ProbeObservation) -> Int {
  probe_observation_fold(
    o: o,
    fold: ProbeObservationFold {
      refused: fn(_, c) { c },
      accepted_clean: 0,
      accepted_counted: fn(_, _) { 0 },
      diverged: fn(_) { 0 },
      not_runnable: fn(_) { 0 },
    },
  )
}

fn probe_observation_from_census(census: CompileDiagnosticCensus, expectation: ProbeExpectation) -> ProbeObservation {
  match census {
    CensusNotRunnable { cause: c } => ProbeNotRunnable { cause: c }
    CensusObserved { rows: rows } =>
      match expectation {
        ExpectZeroDiagnostics =>
          if census_row_count(rows: rows) == 0 {
            AcceptedClean
          } else {
            let first = rows |> first
            match first {
              Present { value: r } =>
                if r.blocking {
                  RefusedTyped { diagnostic_class: r.diagnostic_class, count: r.count }
                } else {
                  AcceptedCounted { diagnostic_class: r.diagnostic_class, count: r.count }
                }
              Absent => AcceptedClean
            }
          }
        ExpectBlockingRefusal { diagnostic_class: wanted } =>
          let blocking = census_blocking_count_for_class(census: census, wanted: wanted as String)
          if blocking >= 1 {
            RefusedTyped { diagnostic_class: wanted, count: blocking }
          } else {
            let advisory = census_any_count_for_class(census: census, wanted: wanted as String)
            if advisory >= 1 {
              AcceptedCounted { diagnostic_class: wanted, count: advisory }
            } else {
              AcceptedClean
            }
          }
      }
  }
}

fn build_v1_compile_receipt(
  class: GuaranteeClassId,
  probe: GuaranteeProbeId,
  census: CompileDiagnosticCensus,
  expectation: ProbeExpectation,
  subject_revision: CommitSha,
  harness_revision: CommitSha,
) -> GuaranteeMeasurementReceipt {
  GuaranteeMeasurementReceipt {
    class: class,
    path: v1_compile_rust_path_id,
    probe: probe,
    subject_revision: subject_revision,
    harness_revision: harness_revision,
    probe_set_digest: probe_set_digest(probe_ids: guarantee_probe_ids()),
    observed: probe_observation_from_census(census: census, expectation: expectation),
  }
}

fn receipt_joins_v1_compile_path(receipt: GuaranteeMeasurementReceipt) -> Bool {
  match join_receipt_to_path(receipt: receipt, paths: guarantee_probe_paths()) {
    ReceiptJoined { path: p } => (p.id as String) == (v1_compile_rust_path_id as String)
    ReceiptPathUnknown { receipt_path: _ } => false
    ReceiptPathDuplicate { receipt_path: _, matches: _ } => false
  }
}

fn build_v2_phase_receipt(
  class: GuaranteeClassId,
  path: GuaranteePathId,
  probe: GuaranteeProbeId,
  observed: ProbeObservation,
  subject_revision: CommitSha,
  harness_revision: CommitSha,
) -> GuaranteeMeasurementReceipt {
  GuaranteeMeasurementReceipt {
    class: class,
    path: path,
    probe: probe,
    subject_revision: subject_revision,
    harness_revision: harness_revision,
    probe_set_digest: probe_set_digest(probe_ids: guarantee_probe_ids()),
    observed: observed,
  }
}
