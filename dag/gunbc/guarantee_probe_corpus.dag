data guarantee_probe_corpus_charter_note: String = "STAGE 1a SLICE 1 OF THE GUARANTEE SPINE (roadmap node ladder-probe-corpus): the landed wall controls from the THREE MERGED PRs gunbc#7519 (call-label-and-surplus), gunbc#7484 (method-established-surface + declared-conformance-ground-fragment), and gunbc#7485 (InferToEval self-grounding frontier) migrated onto gunbc.guarantee_measurement identities — MIGRATE, never duplicate beside the dark-suite originals. gunbc#7555 (InferToTranslate underived-refusal) is OPEN on main (merry-cat-407): class/path/probe identities are RESERVED here for layout, but no control is copied from that branch and executing translate probes are excluded from guarantee_probe_ids until #7555 merges. Each migrated row carries a GuaranteeClassId, GuaranteePathId, and GuaranteeProbeId; receipts name subject_revision, harness_revision, and probe_set_digest per the Stage-0 schema. This slice owns the identity registry, canonical probe ordering, and the census-to-observation bridge for the v1 compile path. v2 InferToEval executing evidence joins the registry from src/v2/test/claim/infer_self_grounding_wall_test.dag (frontier value-red and derived-green receipt joins). No disposition, no rung, no claims carrier — those arrive with ladder-claims-carrier."

data guarantee_probe_corpus_path_scope_note: String = "THREE PATHS FOR THE LANDED WALLS: v1-compile-rust is subject_grain SyntheticProgram, acceptance_boundary CompileAccept, realization_target EmittedTarget { language: rust } — the path compile_diagnostic_census measures. v2-infer-eval is the same subject grain with acceptance_boundary InferToEval and realization_target InterpreterRealization — the path gunbc#7485's GroundingNotDerived frontier diagnostic lives on. v2-infer-translate is the same subject grain with acceptance_boundary InferToTranslate and realization_target InterpreterRealization — reserved for gunbc#7555 (OPEN; merry-cat-407), whose translate-underived-refusal control migrates only after that PR merges to main. A receipt keyed to one path must not claim coverage the other measures (DESIGN 4b minimum-across-paths discipline)."

data guarantee_probe_corpus_probe_order_note: String = "CANONICAL PROBE ORDERING OBLIGATION (probe_set_digest note): guarantee_probe_ids lists the slice-1 MIGRATED probes in stable lexicographic order by branded id string. guarantee_probe_ids_reserved holds OPEN follow-on identities (gunbc#7555) outside the digest until their control merges. Callers must not re-sort; the active roster order here IS the probe-set digest authority for this stage."

data guarantee_probe_corpus_revision_note: String = "subject_revision and harness_revision are REQUIRED on every receipt. build_v1_compile_receipt and build_v2_infer_eval_receipt take a path-typed probe row plus the caller-supplied executed_probe_ids roster (probe_set_digest is derived from exactly that list, never silently widened to the full active registry). Witness fixtures own placeholder revisions until the baseline stage names real commits."

data v1_compile_rust_path_id: GuaranteePathId = "v1-compile-rust" as GuaranteePathId
data v2_infer_eval_path_id: GuaranteePathId = "v2-infer-eval" as GuaranteePathId
data v2_infer_translate_path_id: GuaranteePathId = "v2-infer-translate" as GuaranteePathId

fn v1_compile_rust_path() -> GuaranteePath {
  GuaranteePath {
    id: v1_compile_rust_path_id,
    subject_grain: SyntheticProgram,
    acceptance_boundary: CompileAccept,
    realization_target: EmittedTarget { language: "rust" as GuaranteeTargetName },
  }
}

fn v2_infer_eval_path() -> GuaranteePath {
  GuaranteePath {
    id: v2_infer_eval_path_id,
    subject_grain: SyntheticProgram,
    acceptance_boundary: InferToEval,
    realization_target: InterpreterRealization,
  }
}

fn v2_infer_translate_path() -> GuaranteePath {
  GuaranteePath {
    id: v2_infer_translate_path_id,
    subject_grain: SyntheticProgram,
    acceptance_boundary: InferToTranslate,
    realization_target: InterpreterRealization,
  }
}

fn guarantee_probe_paths() -> List<GuaranteePath> {
  [v1_compile_rust_path(), v2_infer_eval_path(), v2_infer_translate_path()]
}

data call_label_surplus_class: GuaranteeClassId = "call-label-and-surplus" as GuaranteeClassId
data method_established_surface_class: GuaranteeClassId = "method-established-surface" as GuaranteeClassId
data declared_conformance_ground_class: GuaranteeClassId = "declared-conformance-ground-fragment" as GuaranteeClassId
data v2_self_grounding_frontier_class: GuaranteeClassId = "v2-self-grounding-frontier" as GuaranteeClassId
data v2_translate_underived_refusal_class: GuaranteeClassId = "v2-translate-underived-refusal" as GuaranteeClassId

fn guarantee_probe_class_ids() -> List<GuaranteeClassId> {
  [
    call_label_surplus_class,
    declared_conformance_ground_class,
    method_established_surface_class,
    v2_self_grounding_frontier_class,
    v2_translate_underived_refusal_class,
  ]
}

data call_mislabel_red_probe: GuaranteeProbeId = "call-label-surplus-mislabel-red" as GuaranteeProbeId
data call_surplus_red_probe: GuaranteeProbeId = "call-label-surplus-surplus-red" as GuaranteeProbeId
data call_shape_green_probe: GuaranteeProbeId = "call-label-surplus-green-control" as GuaranteeProbeId

data method_missing_red_probe: GuaranteeProbeId = "method-established-surface-missing-red" as GuaranteeProbeId
data method_green_probe: GuaranteeProbeId = "method-established-surface-green-control" as GuaranteeProbeId

data conformance_scalar_red_probe: GuaranteeProbeId = "declared-conformance-ground-scalar-red" as GuaranteeProbeId
data conformance_green_probe: GuaranteeProbeId = "declared-conformance-ground-green-control" as GuaranteeProbeId

data v2_frontier_red_probe: GuaranteeProbeId = "v2-self-grounding-frontier-value-red" as GuaranteeProbeId
data v2_frontier_green_probe: GuaranteeProbeId = "v2-self-grounding-frontier-derived-green" as GuaranteeProbeId
data v2_translate_underived_red_probe: GuaranteeProbeId = "v2-translate-underived-refusal-conj-red" as GuaranteeProbeId
data v2_translate_underived_green_probe: GuaranteeProbeId = "v2-translate-underived-refusal-derived-green" as GuaranteeProbeId

type ProbeExpectation
  = ExpectBlockingRefusal { diagnostic_class: NonEmptyStr }
  | ExpectZeroDiagnostics
  | ExpectAcceptedCounted { diagnostic_class: NonEmptyStr }

type GuaranteeProbeRow {
  probe: GuaranteeProbeId
  class: GuaranteeClassId
  path: GuaranteePathId
  expectation: ProbeExpectation
}

type V1CompileProbeRow {
  probe: GuaranteeProbeId
  class: GuaranteeClassId
  expectation: ProbeExpectation
}

type V2InferEvalProbeRow {
  probe: GuaranteeProbeId
  class: GuaranteeClassId
  expectation: ProbeExpectation
}

type ProbeRowResolution
  = ProbeRowResolved { row: GuaranteeProbeRow }
  | ProbeRowUnknown { wanted: GuaranteeProbeId }
  | ProbeRowDuplicate { wanted: GuaranteeProbeId, matches: Int }

fn guarantee_probe_rows() -> List<GuaranteeProbeRow> {
  [
    GuaranteeProbeRow {
      probe: call_shape_green_probe,
      class: call_label_surplus_class,
      path: v1_compile_rust_path_id,
      expectation: ExpectZeroDiagnostics,
    },
    GuaranteeProbeRow {
      probe: call_mislabel_red_probe,
      class: call_label_surplus_class,
      path: v1_compile_rust_path_id,
      expectation: ExpectBlockingRefusal { diagnostic_class: "CallArgumentNameUnknown" as NonEmptyStr },
    },
    GuaranteeProbeRow {
      probe: call_surplus_red_probe,
      class: call_label_surplus_class,
      path: v1_compile_rust_path_id,
      expectation: ExpectBlockingRefusal { diagnostic_class: "CallPositionalSurplus" as NonEmptyStr },
    },
    GuaranteeProbeRow {
      probe: conformance_green_probe,
      class: declared_conformance_ground_class,
      path: v1_compile_rust_path_id,
      expectation: ExpectZeroDiagnostics,
    },
    GuaranteeProbeRow {
      probe: conformance_scalar_red_probe,
      class: declared_conformance_ground_class,
      path: v1_compile_rust_path_id,
      expectation: ExpectBlockingRefusal { diagnostic_class: "TypeMismatch" as NonEmptyStr },
    },
    GuaranteeProbeRow {
      probe: method_green_probe,
      class: method_established_surface_class,
      path: v1_compile_rust_path_id,
      expectation: ExpectZeroDiagnostics,
    },
    GuaranteeProbeRow {
      probe: method_missing_red_probe,
      class: method_established_surface_class,
      path: v1_compile_rust_path_id,
      expectation: ExpectBlockingRefusal { diagnostic_class: "MethodNotFound" as NonEmptyStr },
    },
    GuaranteeProbeRow {
      probe: v2_frontier_green_probe,
      class: v2_self_grounding_frontier_class,
      path: v2_infer_eval_path_id,
      expectation: ExpectZeroDiagnostics,
    },
    GuaranteeProbeRow {
      probe: v2_frontier_red_probe,
      class: v2_self_grounding_frontier_class,
      path: v2_infer_eval_path_id,
      expectation: ExpectAcceptedCounted { diagnostic_class: "infer_grounding_not_derived" as NonEmptyStr },
    },
  ]
}

fn guarantee_probe_rows_reserved() -> List<GuaranteeProbeRow> {
  [
    GuaranteeProbeRow {
      probe: v2_translate_underived_red_probe,
      class: v2_translate_underived_refusal_class,
      path: v2_infer_translate_path_id,
      expectation: ExpectAcceptedCounted { diagnostic_class: "infer_grounding_not_derived" as NonEmptyStr },
    },
    GuaranteeProbeRow {
      probe: v2_translate_underived_green_probe,
      class: v2_translate_underived_refusal_class,
      path: v2_infer_translate_path_id,
      expectation: ExpectZeroDiagnostics,
    },
  ]
}

fn guarantee_probe_ids() -> List<GuaranteeProbeId> {
  guarantee_probe_rows() |> map(row => row.probe)
}

fn guarantee_probe_ids_reserved() -> List<GuaranteeProbeId> {
  guarantee_probe_rows_reserved() |> map(row => row.probe)
}

fn resolve_guarantee_probe_row(rows: List<GuaranteeProbeRow>, wanted: GuaranteeProbeId) -> ProbeRowResolution {
  let hits = rows |> filter(row => (row.probe as String) == (wanted as String))
  if count(hits) == 0 {
    ProbeRowUnknown { wanted: wanted }
  } else if count(hits) > 1 {
    ProbeRowDuplicate { wanted: wanted, matches: count(hits) }
  } else {
    match hits |> first {
      Present { value: row } => ProbeRowResolved { row: row }
      Absent => ProbeRowUnknown { wanted: wanted }
    }
  }
}

fn resolve_canonical_probe_row(wanted: GuaranteeProbeId) -> ProbeRowResolution {
  match resolve_guarantee_probe_row(rows: guarantee_probe_rows(), wanted: wanted) {
    ProbeRowResolved { row: row } => ProbeRowResolved { row: row }
    ProbeRowUnknown { wanted: w } =>
      resolve_guarantee_probe_row(rows: guarantee_probe_rows_reserved(), wanted: w)
    ProbeRowDuplicate { wanted: w, matches: m } => ProbeRowDuplicate { wanted: w, matches: m }
  }
}

fn active_probe_row(probe: GuaranteeProbeId) -> GuaranteeProbeRow? {
  match resolve_guarantee_probe_row(rows: guarantee_probe_rows(), wanted: probe) {
    ProbeRowResolved { row: row } => Present { value: row }
    ProbeRowUnknown { wanted: _ } => none
    ProbeRowDuplicate { wanted: _, matches: _ } => none
  }
}

fn v1_compile_probe_row_from_registry(row: GuaranteeProbeRow) -> V1CompileProbeRow? {
  if (row.path as String) == (v1_compile_rust_path_id as String) {
    Present {
      value: V1CompileProbeRow {
        probe: row.probe,
        class: row.class,
        expectation: row.expectation,
      },
    }
  } else {
    none
  }
}

fn v2_infer_eval_probe_row_from_registry(row: GuaranteeProbeRow) -> V2InferEvalProbeRow? {
  if (row.path as String) == (v2_infer_eval_path_id as String) {
    Present {
      value: V2InferEvalProbeRow {
        probe: row.probe,
        class: row.class,
        expectation: row.expectation,
      },
    }
  } else {
    none
  }
}

fn active_v1_compile_probe_row(probe: GuaranteeProbeId) -> V1CompileProbeRow? {
  match active_probe_row(probe: probe) {
    Present { value: row } => v1_compile_probe_row_from_registry(row: row)
    Absent => none
  }
}

fn active_v2_infer_eval_probe_row(probe: GuaranteeProbeId) -> V2InferEvalProbeRow? {
  match active_probe_row(probe: probe) {
    Present { value: row } => v2_infer_eval_probe_row_from_registry(row: row)
    Absent => none
  }
}

fn executed_probe_ids_for_probe(probe: GuaranteeProbeId) -> List<GuaranteeProbeId> {
  [probe]
}

fn guarantee_probe_id_strings() -> List<String> {
  fold(
    guarantee_probe_ids(),
    init: [],
    f: fn(acc, id) { append(acc, items: [id as String]) },
  )
}

type ProbeLexWalk {
  prev: String?
  ok: Bool
}

fn probe_ids_are_lexicographically_ordered(ids: List<GuaranteeProbeId>) -> Bool {
  let walked = fold(ids, init: ProbeLexWalk { prev: none, ok: true }, f: fn(acc, id) {
    let current = id as String
    if !acc.ok {
      acc
    } else {
      match acc.prev {
        Absent => ProbeLexWalk { prev: Present { value: current }, ok: true }
        Present { value: prev } =>
          if string_is_lexicographically_before(left: prev, right: current) {
            ProbeLexWalk { prev: Present { value: current }, ok: true }
          } else {
            ProbeLexWalk { prev: Present { value: current }, ok: false }
          }
      }
    }
  })
  walked.ok
}

fn non_empty_diagnostics_count_reason(nes: NonEmptyDiagnostics, reason: Symbol) -> Nat {
  let head_count = if nes.head.reason == reason { 1 } else { 0 }
  fold_list(
    xs: nes.tail,
    empty: head_count,
    cons: fn(acc, d) {
      if d.reason == reason { acc + 1 } else { acc }
    },
  )
}

fn probe_observation_from_accepted_infer_diagnostics(diagnostics: Diagnostics) -> ProbeObservation {
  match diagnostics {
    None => AcceptedClean
    Some { diagnostics: nes } =>
      AcceptedCounted {
        diagnostic_class: nes.head.reason as NonEmptyStr,
        count: non_empty_diagnostics_count_reason(nes: nes, reason: nes.head.reason),
      }
  }
}

fn census_row_count(rows: List<CompileDiagnosticCensusRow>) -> Int {
  count(rows)
}

fn census_blocking_count_for_class(census: CompileDiagnosticCensus, wanted: String) -> Int? {
  match census {
    CensusObserved { rows: rows } =>
      Present {
        value: census_total_count(rows: census_rows_of_class(rows: census_blocking_rows(rows: rows), wanted: wanted))
      }
    CensusNotRunnable { cause: _ } => none
  }
}

fn census_any_count_for_class(census: CompileDiagnosticCensus, wanted: String) -> Int? {
  match census {
    CensusObserved { rows: rows } =>
      Present { value: census_total_count(rows: census_rows_of_class(rows: rows, wanted: wanted)) }
    CensusNotRunnable { cause: _ } => none
  }
}

fn observation_is_blocking_refusal(o: ProbeObservation, wanted: NonEmptyStr) -> Bool {
  probe_observation_fold(
    o: o,
    fold: ProbeObservationFold {
      refused: fn(d, _) { d == wanted },
      accepted_clean: false,
      accepted_counted: fn(_, _) { false },
      diverged: fn(_) { false },
      not_runnable: fn(_) { false },
    },
  )
}

fn observation_is_clean(o: ProbeObservation) -> Bool {
  probe_observation_fold(
    o: o,
    fold: ProbeObservationFold {
      refused: fn(_, _) { false },
      accepted_clean: true,
      accepted_counted: fn(_, _) { false },
      diverged: fn(_) { false },
      not_runnable: fn(_) { false },
    },
  )
}

fn probe_expectation_holds(census: CompileDiagnosticCensus, expectation: ProbeExpectation) -> Bool {
  probe_row_observation_holds(
    observation: probe_observation_from_census(census: census),
    expectation: expectation,
  )
}

fn probe_row_expectation_holds(census: CompileDiagnosticCensus, row: GuaranteeProbeRow) -> Bool {
  probe_row_observation_holds(
    observation: probe_observation_from_census(census: census),
    expectation: row.expectation,
  )
}

fn observation_is_accepted_counted(o: ProbeObservation, wanted: NonEmptyStr) -> Bool {
  probe_observation_fold(
    o: o,
    fold: ProbeObservationFold {
      refused: fn(_, _) { false },
      accepted_clean: false,
      accepted_counted: fn(cls, _) { cls == wanted },
      diverged: fn(_) { false },
      not_runnable: fn(_) { false },
    },
  )
}

fn probe_row_observation_holds(observation: ProbeObservation, expectation: ProbeExpectation) -> Bool {
  match expectation {
    ExpectZeroDiagnostics => observation_is_clean(o: observation)
    ExpectBlockingRefusal { diagnostic_class: wanted } =>
      observation_is_blocking_refusal(o: observation, wanted: wanted)
    ExpectAcceptedCounted { diagnostic_class: wanted } =>
      observation_is_accepted_counted(o: observation, wanted: wanted)
  }
}

fn probe_row_observation_holds_for_row(observation: ProbeObservation, row: GuaranteeProbeRow) -> Bool {
  probe_row_observation_holds(observation: observation, expectation: row.expectation)
}

fn receipt_matches_probe_row(receipt: GuaranteeMeasurementReceipt, row: GuaranteeProbeRow) -> Bool {
  (receipt.probe as String) == (row.probe as String)
    && (receipt.class as String) == (row.class as String)
    && (receipt.path as String) == (row.path as String)
}

fn receipt_matches_v1_compile_probe_row(receipt: GuaranteeMeasurementReceipt, row: V1CompileProbeRow) -> Bool {
  (receipt.probe as String) == (row.probe as String)
    && (receipt.class as String) == (row.class as String)
    && (receipt.path as String) == (v1_compile_rust_path_id as String)
}

fn receipt_matches_v2_infer_eval_probe_row(receipt: GuaranteeMeasurementReceipt, row: V2InferEvalProbeRow) -> Bool {
  (receipt.probe as String) == (row.probe as String)
    && (receipt.class as String) == (row.class as String)
    && (receipt.path as String) == (v2_infer_eval_path_id as String)
}

fn observation_refused_count(o: ProbeObservation) -> Int {
  probe_observation_fold(
    o: o,
    fold: ProbeObservationFold {
      refused: fn(_, c) { c },
      accepted_clean: 0,
      accepted_counted: fn(_, _) { 0 },
      diverged: fn(_) { 0 },
      not_runnable: fn(_) { 0 },
    },
  )
}

fn census_primary_observation(rows: List<CompileDiagnosticCensusRow>) -> ProbeObservation {
  let blocking = census_blocking_rows(rows: rows)
  if census_row_count(rows: blocking) >= 1 {
    match blocking |> first {
      Present { value: r } =>
        RefusedTyped {
          diagnostic_class: r.diagnostic_class,
          count: census_total_count(
            rows: census_rows_of_class(rows: blocking, wanted: r.diagnostic_class as String),
          ),
        }
      Absent => AcceptedClean
    }
  } else if census_row_count(rows: rows) == 0 {
    AcceptedClean
  } else {
    match rows |> first {
      Present { value: r } =>
        AcceptedCounted { diagnostic_class: r.diagnostic_class, count: r.count }
      Absent => AcceptedClean
    }
  }
}

fn probe_observation_from_census(census: CompileDiagnosticCensus) -> ProbeObservation {
  match census {
    CensusNotRunnable { cause: c } => ProbeNotRunnable { cause: c }
    CensusObserved { rows: rows } => census_primary_observation(rows: rows)
  }
}

fn build_v1_compile_receipt(
  row: V1CompileProbeRow,
  census: CompileDiagnosticCensus,
  executed_probe_ids: List<GuaranteeProbeId>,
  subject_revision: CommitSha,
  harness_revision: CommitSha,
) -> GuaranteeMeasurementReceipt {
  GuaranteeMeasurementReceipt {
    class: row.class,
    path: v1_compile_rust_path_id,
    probe: row.probe,
    subject_revision: subject_revision,
    harness_revision: harness_revision,
    probe_set_digest: probe_set_digest(probe_ids: executed_probe_ids),
    observed: probe_observation_from_census(census: census),
  }
}

fn receipt_joins_v1_compile_path(receipt: GuaranteeMeasurementReceipt) -> Bool {
  match join_receipt_to_path(receipt: receipt, paths: guarantee_probe_paths()) {
    ReceiptJoined { path: p } => (p.id as String) == (v1_compile_rust_path_id as String)
    ReceiptPathUnknown { receipt_path: _ } => false
    ReceiptPathDuplicate { receipt_path: _, matches: _ } => false
  }
}

fn build_v2_infer_eval_receipt(
  row: V2InferEvalProbeRow,
  observed: ProbeObservation,
  executed_probe_ids: List<GuaranteeProbeId>,
  subject_revision: CommitSha,
  harness_revision: CommitSha,
) -> GuaranteeMeasurementReceipt {
  GuaranteeMeasurementReceipt {
    class: row.class,
    path: v2_infer_eval_path_id,
    probe: row.probe,
    subject_revision: subject_revision,
    harness_revision: harness_revision,
    probe_set_digest: probe_set_digest(probe_ids: executed_probe_ids),
    observed: observed,
  }
}
