// THE DIRECT-CALL ARGUMENT-TYPE SEAM, and specifically the seam's behaviour for a caller whose
// module name begins with "v2." -- which v1.compiler.infer module_skips_direct_call_arg_check
// exempts from this judgment for the entire active v2 corpus.
//
// THE EXEMPTION IS STILL STANDING. These rows are enrolled BEFORE its deletion rather than after,
// and that is the point of them: the deletion is blocked (gunbc#8886) behind a resolve change that
// was declined at the layer that would own it, so without an enrolled row the class becomes
// invisible again -- which is strictly worse than never having measured it, because the corpus
// would not know what we now know is there. DESIGN 4b(4) keeps a climb's evidence enrolled when
// the climb completes; the same reasoning holds when the climb is BLOCKED, and the roster is what
// makes a blocked class countable instead of forgotten.
//
// direct_call_arg_type_v2_module_red_probe is THE DISCRIMINATING RED and it CANNOT PASS while the
// exemption stands, so it is enrolled in v2.workflow.floor_expected_red as a known red with its
// trigger named. It is not a broken witness: it is the class, counted. The day the exemption is
// deleted it flips to a permanent regression control and comes OFF that roster -- and a reviewer
// who sees it green while still rostered is looking at a coherence failure, which is what the
// expected-red coherence witness exists to catch.
//
// Its source differs from the ordinary-module row below in exactly one byte-run -- the module name
// -- so the pair isolates the exemption and nothing else. That is what makes the red interpretable
// at all: a red on the v2 row alone cannot distinguish "the judgment is switched off for v2
// callers" from "the harness reds on anything", and the ordinary-module row is the paired nonzero
// that separates them. It PASSES today, on main, with the exemption in place, because the
// exemption never covered it.
//
// direct_call_arg_type_v2_green_control_probe holds the other side: a CORRECT call in a v2.-named
// module compiles clean. Without it, a seam refusing every argument in a v2.* module would satisfy
// both reds. It also passes today.
//
// So two of the three are live evidence now and one is a counted, triggered known-red. That
// asymmetry IS the class's shape and the roster records it rather than averaging it away.
data direct_call_arg_type_v2_module_red_probe: gunbc.guarantee_measurement.GuaranteeProbeId = "direct-call-argument-type-v2-module-red" as gunbc.guarantee_measurement.GuaranteeProbeId
data direct_call_arg_type_ordinary_module_red_probe: gunbc.guarantee_measurement.GuaranteeProbeId = "direct-call-argument-type-ordinary-module-red" as gunbc.guarantee_measurement.GuaranteeProbeId
data direct_call_arg_type_v2_green_control_probe: gunbc.guarantee_measurement.GuaranteeProbeId = "direct-call-argument-type-v2-green-control" as gunbc.guarantee_measurement.GuaranteeProbeId

data sole_ctor_forged_red_probe: gunbc.guarantee_measurement.GuaranteeProbeId = "sole-constructor-cross-module-forged-red" as gunbc.guarantee_measurement.GuaranteeProbeId
data sole_ctor_green_probe: gunbc.guarantee_measurement.GuaranteeProbeId = "sole-constructor-cross-module-green-control" as gunbc.guarantee_measurement.GuaranteeProbeId
data sole_ctor_mint_fn_hole_probe: gunbc.guarantee_measurement.GuaranteeProbeId = "sole-constructor-mint-fn-cross-module-hole" as gunbc.guarantee_measurement.GuaranteeProbeId
// The CAST construction form. It was the named unknown in the capability audit (`casts like
// as TransportScript`) and it was a real hole: validate_cast judges only casts whose source and target
// both sit in std.coercion's primitive domain, so a cast into a sealed record was unjudged entirely.
// The probe casts a bare Int into the sealed fixture record from another module — a shape whose SOURCE
// is a cast-domain type and whose TARGET is not, so nothing but the sole_constructor check can refuse
// it, which is what makes it discriminating rather than incidentally red.
data sole_ctor_cast_red_probe: gunbc.guarantee_measurement.GuaranteeProbeId = "sole-constructor-cross-module-cast-red" as gunbc.guarantee_measurement.GuaranteeProbeId
// The CALLER-SEALED mint. sole_constructor confines construction to the definer; admit_callers confines
// who may call the definer's exported mint. The two are the wall only together: without the second, a
// sealed type with any exported mint is sealed in name only. This probe calls the sealed fixture mint
// from a module its admit_callers list does not name; the green counterpart is the admitted caller.
data sole_ctor_unadmitted_caller_red_probe: gunbc.guarantee_measurement.GuaranteeProbeId = "sole-constructor-unadmitted-caller-red" as gunbc.guarantee_measurement.GuaranteeProbeId
data sole_ctor_admitted_caller_green_probe: gunbc.guarantee_measurement.GuaranteeProbeId = "sole-constructor-admitted-caller-green-control" as gunbc.guarantee_measurement.GuaranteeProbeId

data v2_frontier_red_probe: gunbc.guarantee_measurement.GuaranteeProbeId = "v2-self-grounding-frontier-value-red" as gunbc.guarantee_measurement.GuaranteeProbeId
data v2_frontier_green_probe: gunbc.guarantee_measurement.GuaranteeProbeId = "v2-self-grounding-frontier-derived-green" as gunbc.guarantee_measurement.GuaranteeProbeId

type ProbeExpectation
  = ExpectBlockingRefusal { diagnostic_class: std.types.NonEmptyStr }
  | ExpectZeroDiagnostics
  | ExpectAcceptedCounted { diagnostic_class: std.types.NonEmptyStr }

type ProbeExpectationFold<R> {
  blocking_refusal: fn(std.types.NonEmptyStr) -> R
  zero_diagnostics: R
  accepted_counted: fn(std.types.NonEmptyStr) -> R
}

fn probe_expectation_fold<R>(e: ProbeExpectation, fold: ProbeExpectationFold<R>) -> R {
  match e {
    ExpectBlockingRefusal { diagnostic_class: d } => fold.blocking_refusal(d)
    ExpectZeroDiagnostics => fold.zero_diagnostics
    ExpectAcceptedCounted { diagnostic_class: d } => fold.accepted_counted(d)
  }
}

fn harness_digest_from_material_and_expectation(
  harness_material: std.types.NonEmptyStr,
  expectation: ProbeExpectation,
) -> std.content_hash.Fnv1a64Structural {
  std.content_hash.content_hash_combine_structural(
    left: std.content_hash.content_hash_atom(value: harness_material),
    right: expectation_harness_digest(e: expectation),
  )
}

data v1_compile_harness_source_paths_note: String = "v1_compile_harness_source_paths is the measured authority for compile_dag_diagnostic_census harness revision: probe-corpus bridge, guarantee_measurement folds, census vocabulary, the host builtin seam, and the v1 CompileAccept→Rust pipeline stages whose edits change which diagnostics a synthetic subject provokes. dissolve-on ladder-baseline stage supplies GitRevision harness anchors."

fn v1_compile_harness_source_paths() -> std.types.List<String> {
  [
    "dag/gunbc/guarantee_probe_corpus.dag",
    "dag/gunbc/guarantee_measurement.dag",
    "dag/gunbc/compile_diagnostic_census.dag",
    "src/v1/stage0/src/cli_run.rs",
    "src/v1/compile.dag",
    "src/v1/02_parse.dag",
    "src/v1/04_infer.dag",
    "src/v1/04_method.dag",
    "src/v1/04_types.dag",
    "dag/extdeps/uri.dag",
  ]
}

fn v2_infer_eval_harness_source_paths() -> std.types.List<String> {
  [
    "dag/gunbc/guarantee_probe_corpus.dag",
    "dag/gunbc/guarantee_measurement.dag",
    "src/v2/compiler/04_infer.dag",
    "src/v2/test/claim/infer_self_grounding_wall_test.dag",
  ]
}

fn v1_compile_harness_revision(
  probe: gunbc.guarantee_measurement.GuaranteeProbeId,
  expectation: ProbeExpectation,
  harness_source: std.types.NonEmptyStr,
) -> gunbc.guarantee_measurement.MeasurementRevision {
  synthetic_program_harness_revision_from_digest(
    probe: probe,
    digest: harness_digest_from_material_and_expectation(
      harness_material: harness_source,
      expectation: expectation,
    ),
  )
}

fn v2_infer_eval_harness_revision(
  probe: gunbc.guarantee_measurement.GuaranteeProbeId,
  expectation: ProbeExpectation,
  harness_source: std.types.NonEmptyStr,
) -> gunbc.guarantee_measurement.MeasurementRevision {
  synthetic_program_harness_revision_from_digest(
    probe: probe,
    digest: harness_digest_from_material_and_expectation(
      harness_material: harness_source,
      expectation: expectation,
    ),
  )
}

fn expectation_harness_digest(e: ProbeExpectation) -> std.content_hash.Fnv1a64Structural {
  probe_expectation_fold(
    e: e,
    fold: ProbeExpectationFold {
      blocking_refusal: fn(d) {
        std.content_hash.content_hash_tagged_structural(
          tag: "blocking-refusal" as std.types.NonEmptyStr,
          payload: std.content_hash.content_hash_atom(value: d),
        )
      },
      zero_diagnostics: std.content_hash.content_hash_atom(value: "zero-diagnostics" as std.types.NonEmptyStr),
      accepted_counted: fn(d) {
        std.content_hash.content_hash_tagged_structural(
          tag: "accepted-counted" as std.types.NonEmptyStr,
          payload: std.content_hash.content_hash_atom(value: d),
        )
      },
    },
  )
}

fn synthetic_program_harness_revision_from_digest(probe: gunbc.guarantee_measurement.GuaranteeProbeId, digest: std.content_hash.Fnv1a64Structural) -> gunbc.guarantee_measurement.MeasurementRevision {
  gunbc.guarantee_measurement.ContentFingerprint {
    digest: std.content_hash.content_hash_tagged_structural(
      tag: "guarantee-probe-harness-v1" as std.types.NonEmptyStr,
      payload: std.content_hash.content_hash_combine_structural(
        left: std.content_hash.content_hash_atom(value: probe as std.types.NonEmptyStr),
        right: digest,
      ),
    ),
  }
}

fn infer_eval_node_structural_hash(node: v2.std.node.Node) -> std.content_hash.Fnv1a64Structural {
  std.content_hash.structural_content_hash(digest: v2.std.node.content_hash(n: node).digest as std.content_hash.Fnv1a64StructuralDigestHex)
}

fn synthetic_infer_eval_subject_revision_from_node(node: v2.std.node.Node) -> gunbc.guarantee_measurement.MeasurementRevision {
  gunbc.guarantee_measurement.ContentFingerprint {
    digest: std.content_hash.content_hash_tagged_structural(
      tag: "v2-infer-eval-subject-node-v1" as std.types.NonEmptyStr,
      payload: infer_eval_node_structural_hash(node: node),
    ),
  }
}

type DarkSuiteWitnessDisposition
  = MigratedToEnrolledDagProbe {
      rust_witness: std.types.NonEmptyStr,
      dag_probes: std.types.List<gunbc.guarantee_measurement.GuaranteeProbeId>,
      rust_retained_until: std.types.NonEmptyStr,
    }

data guarantee_probe_dark_suite_disposition_note: String = "Slice 1 MIGRATES landed wall REDs into enrolled .dag probes without dissolving the dark Rust suite (gap-analysis sec 11 item 9 operator ruling): each row names the executing .dag probe(s), the retained Rust witness they replace on the floor, and the finite-classification gate that must disposition the Rust copy before deletion. MIGRATE never duplicate means one enrolled measurement authority per class — not silent parallel maintenance forever."

fn guarantee_probe_dark_suite_dispositions() -> std.types.List<DarkSuiteWitnessDisposition> {
  [
    MigratedToEnrolledDagProbe {
      rust_witness: "call_shape_wall_witness" as std.types.NonEmptyStr,
      dag_probes: [call_deficit_red_probe, call_shape_green_probe, call_mislabel_red_probe, call_surplus_red_probe],
      rust_retained_until: "gap-analysis-sec-11-item-9-finite-classification" as std.types.NonEmptyStr,
    },
    MigratedToEnrolledDagProbe {
      rust_witness: "call_shape_duplicate_wall_witness" as std.types.NonEmptyStr,
      dag_probes: [call_duplicate_red_probe, call_duplicate_green_probe],
      rust_retained_until: "gap-analysis-sec-11-item-9-finite-classification" as std.types.NonEmptyStr,
    },
    MigratedToEnrolledDagProbe {
      rust_witness: "method_existence_wall_witness" as std.types.NonEmptyStr,
      dag_probes: [method_missing_red_probe, method_green_probe],
      rust_retained_until: "gap-analysis-sec-11-item-9-finite-classification" as std.types.NonEmptyStr,
    },
    MigratedToEnrolledDagProbe {
      rust_witness: "declared_type_conformance_witness" as std.types.NonEmptyStr,
      dag_probes: [conformance_scalar_red_probe, conformance_green_probe],
      rust_retained_until: "gap-analysis-sec-11-item-9-finite-classification" as std.types.NonEmptyStr,
    },
    MigratedToEnrolledDagProbe {
      rust_witness: "sole_constructor_violation_outside_module" as std.types.NonEmptyStr,
      dag_probes: [sole_ctor_forged_red_probe, sole_ctor_green_probe],
      rust_retained_until: "gap-analysis-sec-11-item-9-finite-classification" as std.types.NonEmptyStr,
    },
  ]
}

type GuaranteeProbeRow {
  probe: gunbc.guarantee_measurement.GuaranteeProbeId
  class: gunbc.guarantee_measurement.GuaranteeClassId
  path: gunbc.guarantee_measurement.GuaranteePathId
  expectation: ProbeExpectation
}

type V1CompileProbeRow {
  probe: gunbc.guarantee_measurement.GuaranteeProbeId
  class: gunbc.guarantee_measurement.GuaranteeClassId
  expectation: ProbeExpectation
}

type V2InferEvalProbeRow {
  probe: gunbc.guarantee_measurement.GuaranteeProbeId
  class: gunbc.guarantee_measurement.GuaranteeClassId
  expectation: ProbeExpectation
}

type ProbeRowResolution
  = ProbeRowResolved { row: GuaranteeProbeRow }
  | ProbeRowUnknown { wanted: gunbc.guarantee_measurement.GuaranteeProbeId }
  | ProbeRowDuplicate { wanted: gunbc.guarantee_measurement.GuaranteeProbeId, matches: Int }

fn guarantee_probe_rows() -> std.types.List<GuaranteeProbeRow> {
  [
    GuaranteeProbeRow {
      probe: bare_none_collection_red_probe,
      class: bare_none_field_admission_class,
      path: v1_compile_rust_path_id,
      expectation: ExpectBlockingRefusal { diagnostic_class: "BareNoneNotAdmittedByFieldType" as std.types.NonEmptyStr },
    },
    GuaranteeProbeRow {
      probe: bare_none_green_probe,
      class: bare_none_field_admission_class,
      path: v1_compile_rust_path_id,
      expectation: ExpectZeroDiagnostics,
    },
    GuaranteeProbeRow {
      probe: bare_none_scalar_red_probe,
      class: bare_none_field_admission_class,
      path: v1_compile_rust_path_id,
      expectation: ExpectBlockingRefusal { diagnostic_class: "BareNoneNotAdmittedByFieldType" as std.types.NonEmptyStr },
    },
    GuaranteeProbeRow {
      probe: call_deficit_red_probe,
      class: call_label_surplus_class,
      path: v1_compile_rust_path_id,
      expectation: ExpectBlockingRefusal { diagnostic_class: "CallPositionalDeficit" as std.types.NonEmptyStr },
    },
    GuaranteeProbeRow {
      probe: call_duplicate_green_probe,
      class: call_label_surplus_class,
      path: v1_compile_rust_path_id,
      expectation: ExpectZeroDiagnostics,
    },
    GuaranteeProbeRow {
      probe: call_duplicate_red_probe,
      class: call_label_surplus_class,
      path: v1_compile_rust_path_id,
      expectation: ExpectBlockingRefusal { diagnostic_class: "CallArgumentDuplicate" as std.types.NonEmptyStr },
    },
    GuaranteeProbeRow {
      probe: call_shape_green_probe,
      class: call_label_surplus_class,
      path: v1_compile_rust_path_id,
      expectation: ExpectZeroDiagnostics,
    },
    GuaranteeProbeRow {
