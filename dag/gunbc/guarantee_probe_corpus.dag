fn guarantee_probe_ids() -> List<GuaranteeProbeId> {
  guarantee_probe_rows() |> map(row => row.probe)
}

fn resolve_guarantee_probe_row(rows: List<GuaranteeProbeRow>, wanted: GuaranteeProbeId) -> ProbeRowResolution {
  let hits = rows |> filter(row => (row.probe as String) == (wanted as String))
  if count(hits) == 0 {
    ProbeRowUnknown { wanted: wanted }
  } else if count(hits) > 1 {
    ProbeRowDuplicate { wanted: wanted, matches: count(hits) }
  } else {
    match hits |> first {
      Present { value: row } => ProbeRowResolved { row: row }
      Absent => ProbeRowUnknown { wanted: wanted }
    }
  }
}

fn resolve_canonical_probe_row(wanted: GuaranteeProbeId) -> ProbeRowResolution {
  resolve_guarantee_probe_row(rows: guarantee_probe_rows(), wanted: wanted)
}

fn canonical_probe_row_resolution_refuses_duplicate_population() -> Bool {
  match active_probe_row(probe: call_mislabel_red_probe) {
    Present { value: row } =>
      match resolve_guarantee_probe_row(rows: guarantee_probe_rows(), wanted: call_mislabel_red_probe) {
        ProbeRowResolved { row: _ } =>
          match resolve_guarantee_probe_row(
            rows: append(guarantee_probe_rows(), items: [row]),
            wanted: call_mislabel_red_probe,
          ) {
            ProbeRowDuplicate { wanted: _, matches: 2 } => true
            _ => false
          }
        _ => false
      }
    Absent => false
  }
}

fn active_probe_row(probe: GuaranteeProbeId) -> GuaranteeProbeRow? {
  match resolve_guarantee_probe_row(rows: guarantee_probe_rows(), wanted: probe) {
    ProbeRowResolved { row: row } => Present { value: row }
    ProbeRowUnknown { wanted: _ } => none
    ProbeRowDuplicate { wanted: _, matches: _ } => none
  }
}

fn v1_compile_probe_row_from_registry(row: GuaranteeProbeRow) -> V1CompileProbeRow? {
  if (row.path as String) == (v1_compile_rust_path_id as String) {
    Present {
      value: V1CompileProbeRow {
        probe: row.probe,
        class: row.class,
        expectation: row.expectation,
      },
    }
  } else {
    none
  }
}

fn v2_infer_eval_probe_row_from_registry(row: GuaranteeProbeRow) -> V2InferEvalProbeRow? {
  if (row.path as String) == (v2_infer_eval_path_id as String) {
    Present {
      value: V2InferEvalProbeRow {
        probe: row.probe,
        class: row.class,
        expectation: row.expectation,
      },
    }
  } else {
    none
  }
}

fn active_v1_compile_probe_row(probe: GuaranteeProbeId) -> V1CompileProbeRow? {
  match active_probe_row(probe: probe) {
    Present { value: row } => v1_compile_probe_row_from_registry(row: row)
    Absent => none
  }
}

fn active_v2_infer_eval_probe_row(probe: GuaranteeProbeId) -> V2InferEvalProbeRow? {
  match active_probe_row(probe: probe) {
    Present { value: row } => v2_infer_eval_probe_row_from_registry(row: row)
    Absent => none
  }
}

fn executed_probe_ids_for_probe(probe: GuaranteeProbeId) -> List<GuaranteeProbeId> {
  [probe]
}

fn guarantee_probe_id_strings() -> List<String> {
  fold(
    guarantee_probe_ids(),
    init: [],
    f: fn(acc, id) { append(acc, items: [id as String]) },
  )
}

type ProbeLexWalk {
  prev: String?
  ok: Bool
}

fn probe_ids_are_lexicographically_ordered(ids: List<GuaranteeProbeId>) -> Bool {
  let walked = fold(ids, init: ProbeLexWalk { prev: none, ok: true }, f: fn(acc, id) {
    let current = id as String
    if !acc.ok {
      acc
    } else {
      match acc.prev {
        Absent => ProbeLexWalk { prev: Present { value: current }, ok: true }
        Present { value: prev } =>
          if string_is_lexicographically_before(left: prev, right: current) {
            ProbeLexWalk { prev: Present { value: current }, ok: true }
          } else {
            ProbeLexWalk { prev: Present { value: current }, ok: false }
          }
      }
    }
  })
  walked.ok
}

fn non_empty_diagnostics_count_reason(nes: NonEmptyDiagnostics, reason: Symbol) -> Nat {
  let head_count = if nes.head.reason == reason { 1 } else { 0 }
  fold_list(
    xs: nes.tail,
    empty: head_count,
    cons: fn(acc, d) {
      if d.reason == reason { acc + 1 } else { acc }
    },
  )
}

fn probe_observation_from_accepted_infer_diagnostics(diagnostics: Diagnostics) -> ProbeObservation {
  match diagnostics {
    None => AcceptedClean
    Some { diagnostics: nes } =>
      AcceptedCounted {
        diagnostic_class: nes.head.reason as NonEmptyStr,
        count: non_empty_diagnostics_count_reason(nes: nes, reason: nes.head.reason),
      }
  }
}

fn census_row_count(rows: List<CompileDiagnosticCensusRow>) -> Int {
  count(rows)
}

fn census_blocking_count_for_class(census: CompileDiagnosticCensus, wanted: String) -> Int? {
  match census {
    CensusObserved { rows: rows } =>
      Present {
        value: census_total_count(rows: census_rows_of_class(rows: census_blocking_rows(rows: rows), wanted: wanted))
      }
    CensusNotRunnable { cause: _ } => none
  }
}

fn census_any_count_for_class(census: CompileDiagnosticCensus, wanted: String) -> Int? {
  match census {
    CensusObserved { rows: rows } =>
      Present { value: census_total_count(rows: census_rows_of_class(rows: rows, wanted: wanted)) }
    CensusNotRunnable { cause: _ } => none
  }
}

fn observation_is_blocking_refusal(o: ProbeObservation, wanted: NonEmptyStr) -> Bool {
  probe_observation_fold(
    o: o,
    fold: ProbeObservationFold {
      refused: fn(d, _) { d == wanted },
      accepted_clean: false,
      accepted_counted: fn(_, _) { false },
      diverged: fn(_) { false },
      not_runnable: fn(_) { false },
    },
  )
}

fn observation_is_clean(o: ProbeObservation) -> Bool {
  probe_observation_fold(
    o: o,
    fold: ProbeObservationFold {
      refused: fn(_, _) { false },
      accepted_clean: true,
      accepted_counted: fn(_, _) { false },
      diverged: fn(_) { false },
      not_runnable: fn(_) { false },
    },
  )
}

fn probe_expectation_holds(census: CompileDiagnosticCensus, expectation: ProbeExpectation) -> Bool {
  probe_row_observation_holds(
    observation: probe_observation_from_census(census: census),
    expectation: expectation,
  )
}

fn probe_row_expectation_holds(census: CompileDiagnosticCensus, row: GuaranteeProbeRow) -> Bool {
  probe_row_observation_holds(
    observation: probe_observation_from_census(census: census),
    expectation: row.expectation,
  )
}

fn observation_is_accepted_counted(o: ProbeObservation, wanted: NonEmptyStr) -> Bool {
  probe_observation_fold(
    o: o,
    fold: ProbeObservationFold {
      refused: fn(_, _) { false },
      accepted_clean: false,
      accepted_counted: fn(cls, _) { cls == wanted },
      diverged: fn(_) { false },
      not_runnable: fn(_) { false },
    },
  )
}

fn probe_row_observation_holds(observation: ProbeObservation, expectation: ProbeExpectation) -> Bool {
  probe_expectation_fold(
    e: expectation,
    fold: ProbeExpectationFold {
      blocking_refusal: fn(wanted) { observation_is_blocking_refusal(o: observation, wanted: wanted) },
      zero_diagnostics: observation_is_clean(o: observation),
      accepted_counted: fn(wanted) { observation_is_accepted_counted(o: observation, wanted: wanted) },
      silent_acceptance_hole: fn(_) { observation_is_clean(o: observation) },
    },
  )
}

fn probe_row_observation_holds_for_row(observation: ProbeObservation, row: GuaranteeProbeRow) -> Bool {
  probe_row_observation_holds(observation: observation, expectation: row.expectation)
}

fn receipt_matches_probe_row(receipt: GuaranteeMeasurementReceipt, row: GuaranteeProbeRow) -> Bool {
  (receipt.probe as String) == (row.probe as String)
    && (receipt.class as String) == (row.class as String)
    && (receipt.path as String) == (row.path as String)
}

fn receipt_matches_v1_compile_probe_row(receipt: GuaranteeMeasurementReceipt, row: V1CompileProbeRow) -> Bool {
  (receipt.probe as String) == (row.probe as String)
    && (receipt.class as String) == (row.class as String)
    && (receipt.path as String) == (v1_compile_rust_path_id as String)
}

fn receipt_matches_v2_infer_eval_probe_row(receipt: GuaranteeMeasurementReceipt, row: V2InferEvalProbeRow) -> Bool {
  (receipt.probe as String) == (row.probe as String)
    && (receipt.class as String) == (row.class as String)
    && (receipt.path as String) == (v2_infer_eval_path_id as String)
}

fn observation_refused_count(o: ProbeObservation) -> Int {
  probe_observation_fold(
    o: o,
    fold: ProbeObservationFold {
      refused: fn(_, c) { c },
      accepted_clean: 0,
      accepted_counted: fn(_, _) { 0 },
      diverged: fn(_) { 0 },
      not_runnable: fn(_) { 0 },
    },
  )
}

fn census_primary_observation(rows: List<CompileDiagnosticCensusRow>) -> ProbeObservation {
  let blocking = census_blocking_rows(rows: rows)
  if census_row_count(rows: blocking) >= 1 {
    match blocking |> first {
      Present { value: r } =>
        RefusedTyped {
          diagnostic_class: r.diagnostic_class,
          count: census_total_count(
            rows: census_rows_of_class(rows: blocking, wanted: r.diagnostic_class as String),
          ),
        }
      Absent => AcceptedClean
    }
  } else if census_row_count(rows: rows) == 0 {
    AcceptedClean
  } else {
    match rows |> first {
      Present { value: r } =>
        AcceptedCounted { diagnostic_class: r.diagnostic_class, count: r.count }
      Absent => AcceptedClean
    }
  }
}

fn probe_observation_from_census(census: CompileDiagnosticCensus) -> ProbeObservation {
  match census {
    CensusNotRunnable { cause: c } => ProbeNotRunnable { cause: c }
    CensusObserved { rows: rows } => census_primary_observation(rows: rows)
  }
}

fn build_v1_compile_receipt(
  row: V1CompileProbeRow,
  census: CompileDiagnosticCensus,
  subject_revision: MeasurementRevision,
  harness_revision: MeasurementRevision,
) -> GuaranteeMeasurementReceipt {
  let executed_probe_ids = executed_probe_ids_for_probe(probe: row.probe)
  GuaranteeMeasurementReceipt {
    class: row.class,
    path: v1_compile_rust_path_id,
    probe: row.probe,
    subject_revision: subject_revision,
    harness_revision: harness_revision,
    probe_set_digest: probe_set_digest(probe_ids: executed_probe_ids),
    observed: probe_observation_from_census(census: census),
  }
}

fn receipt_joins_v1_compile_path(receipt: GuaranteeMeasurementReceipt) -> Bool {
  match join_receipt_to_path(receipt: receipt, paths: guarantee_probe_paths()) {
    ReceiptJoined { path: p } => (p.id as String) == (v1_compile_rust_path_id as String)
    ReceiptPathUnknown { receipt_path: _ } => false
    ReceiptPathDuplicate { receipt_path: _, matches: _ } => false
  }
}

fn build_v2_infer_eval_receipt(
  row: V2InferEvalProbeRow,
  observed: ProbeObservation,
  subject_revision: MeasurementRevision,
  harness_revision: MeasurementRevision,
) -> GuaranteeMeasurementReceipt {
  let executed_probe_ids = executed_probe_ids_for_probe(probe: row.probe)
  GuaranteeMeasurementReceipt {
    class: row.class,
    path: v2_infer_eval_path_id,
    probe: row.probe,
    subject_revision: subject_revision,
    harness_revision: harness_revision,
    probe_set_digest: probe_set_digest(probe_ids: executed_probe_ids),
    observed: observed,
  }
}
