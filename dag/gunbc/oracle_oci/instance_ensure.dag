import v2.std.algebra { any }
import extdeps.languages.json.emit { JsonValue, json_object, json_kv, json_string, json_bool, json_int, serialize_json }
import extdeps.cloud.oracle_oci_request_signing { OciPostJson }
import extdeps.cloud.oracle_oci { VmStandardA1Flex, VmStandardE21Micro, OnDemandCapacity, oci_shape_wire_name }
import extdeps.ssh { ssh_public_key_line }
import extdeps.uri { uri_percent_encode_component, UriPercentComponentEncoded, UriPercentComponentRefused }
import product.supplier.oracle_oci {
  OciPlannedInstance, OciInstanceSize, A1FlexSize, E2MicroSize,
  InHomeRegion, InMicroEligibleDomain,
  OciAllowanceFit, FitsAlwaysFree, ExceedsAlwaysFree, OciAllowanceBreach,
  oci_always_free_fit, oci_always_free_fit_beside, oci_instance_shape,
}
import gunbc.oracle_oci.tenancy_usage { oci_tenancy_usage, TenancyUsageObserved, TenancyUsageRefused }
import gunbc.fleet_ssh_access { fleet_automation_ssh_key, operator_macbook_ssh_key }
