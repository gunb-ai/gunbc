module gunbc.portable_value_canonical_order_seed_growth

import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.types { String }
import gunbc.roadmap_model { RoadmapNodeId }
import gunbc.seed_growth { SeedGrowthJustification }

// Seed-growth obligation for the portable value form's canonical entry order (recurring failure
// mode portable_value_map_order_is_process_random).
data portable_value_canonical_order_seed_growth_justification: SeedGrowthJustification = SeedGrowthJustification {
  hand_authored_declarations: [
    DeclarationRef { module_path: "v1_compiler.v1_interpreter", decl_name: "portable_value_cmp", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.v1_interpreter", decl_name: "portable_canonical_order_tests", field: WholeDeclaration }
  ],
  reason: "WHY RUST: the portable value form (PortableValue, portable_value_from_ctx_at) is the interpreter's own host representation of a value leaving a frame. It exists only as host Rust, and no .dag carrier names it. Its entry order came from a host hash map seeded per process (im HashMap with RandomState), and value_hash hashed variant names by address, so the repair has to sit where the host representation is built. The change is a total content order over that representation, plus two controls: a two-process digest equality and a spelling-not-address hash check. WHY ADMITTED AGAINST THE v1 FREEZE (gunbc.v1_maintenance_standing v1_seed_standing): by PURPOSE. It removes silent cross-run nondeterminism from values the floor's producer-grain differentials and the type_env plan's content-keyed invariants compare across processes on the v2 self-host path. It adds no language behaviour, no flag, and no admission row. In-process results are unchanged, because equality there was already structural.",
  owning_dissolution_lane: "v1-hand-queue-drain" as RoadmapNodeId,
  trigger: "Deletes when the cross-claim store and its portable form are realized from a .dag model of a portable value (a declared canonical encoding with its order fact) rather than a host type, so that the order is a modeled property of the encoding and the comparator is a fold. A Rust comparator kept behind a .dag wrapper does not satisfy it.",
  current_boundary: "src/v1/stage0/src/v1_interpreter.rs (portable_value_cmp, the sort in portable_value_from_ctx_at, value_hash's variant-name arm, portable_canonical_order_tests); dag/gunbc/portable_value_canonical_order_seed_growth.dag"
}
