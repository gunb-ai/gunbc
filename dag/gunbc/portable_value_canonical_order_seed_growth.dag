module gunbc.portable_value_canonical_order_seed_growth

import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.types { String }
import gunbc.roadmap_model { RoadmapNodeId }
import gunbc.seed_growth { SeedGrowthJustification }

// Seed-growth obligation for the portable value form's canonical entry order (recurring failure
// mode portable_value_map_order_is_process_random).
data portable_value_canonical_order_seed_growth_justification: SeedGrowthJustification = SeedGrowthJustification {
  hand_authored_declarations: [
    DeclarationRef { module_path: "v1_compiler.v1_interpreter", decl_name: "portable_value_cmp", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.v1_interpreter", decl_name: "portable_canonical_order_tests", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.v1_interpreter", decl_name: "ContentKind", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.v1_interpreter", decl_name: "ContentView", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.v1_interpreter", decl_name: "CanonicalContent", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.v1_interpreter", decl_name: "NoContentOrder", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.v1_interpreter", decl_name: "seq_cmp", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.v1_interpreter", decl_name: "canonical_entries", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.v1_interpreter", decl_name: "canonical_field_order", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.v1_interpreter", decl_name: "canonical_content_cmp", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.v1_interpreter", decl_name: "admit_emitted_ord_keys", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.v1_interpreter", decl_name: "DebugEntries", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.v1_interpreter", decl_name: "canonical_render_order_tests", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.v1_interpreter", decl_name: "detach_portable_children", field: WholeDeclaration }
  ],
  reason: "WHY RUST: the portable value form (PortableValue, portable_value_from_ctx_at) is the interpreter's own host representation of a value leaving a frame. It exists only as host Rust, and no .dag carrier names it. Its entry order came from a host hash map seeded per process (im HashMap with RandomState), and value_hash hashed variant names by address, so the repair has to sit where the host representation is built. The change is a total content order over that representation, plus two controls: a two-process digest equality and a spelling-not-address hash check. WHY ADMITTED AGAINST THE v1 FREEZE (gunbc.v1_maintenance_standing v1_seed_standing): by PURPOSE. It removes silent cross-run nondeterminism from values the floor's producer-grain differentials and the type_env plan's content-keyed invariants compare across processes on the v2 self-host path. It adds no language behaviour, no flag, and no admission row. In-process results are unchanged, because equality there was already structural. RENDERING (node adhoc-77383faf-d07): the same order now serves Display and Debug of Value::Map, through one ContentView that Value and PortableValue both expose, so portable_value_cmp is a one-line call into canonical_content_cmp rather than a second comparator; admit_emitted_ord_keys is the one admission sorted_map_keys and sort_by share, and cmp_values (an Equal-for-unrecognised-pairs fallback) is DELETED. WHY RUST: Display for Value is the host rendering of a host value, so the order has to be applied where it renders. The declared authority is std.algebra TotalOrder; this comparator is its interpreter realization, checked by the carrier differential and the native-Ord control rather than derived. WHY ADMITTED AGAINST THE v1 FREEZE: gunbc.v1_maintenance_standing v1_seed_standing admits work serving the v2 self-host, and the self-host's evidence is byte equality -- a per-process rendering makes every byte oracle over a rendered map (the floor's warm-row digests among them) unable to tell CHANGED from REORDERED.",
  owning_dissolution_lane: "v1-hand-queue-drain" as RoadmapNodeId,
  trigger: "Deletes when THE CANONICAL CONTENT ORDER IS DERIVED FROM std.algebra TotalOrder AND CONSUMED BY BOTH THE INTERPRETER AND THE EMITTED COMPARE -- the order declared as .dag (kind rank, IEEE 754-2019 totalOrder for floats, spelling then payload for records and variants, then owner identity once gunbc.guarantee_stall variant_owner_identity_stall resolves) and realized as a fold in both places, so neither realization carries a hand comparator. The derivation lands with its FIRST REAL CONSUMER, whichever comes first: the emitted canonical compare (emitted compound ordering, today a declared frontier refused by v1_rt CanonicalOrdKey) or the .dag model of a portable value (a declared canonical encoding with its order fact, so the cross-claim store's PortableValue is realized from it). A Rust comparator kept behind a .dag wrapper does not satisfy it, and neither does rule rows nothing consumes (DESIGN section 3c). Until then the one-order property is held by EXECUTED agreement, enrolled as test.claim.canonical_order_enrolled_witness (neat-boar-16, gunbc#12925)",
  current_boundary: "src/v1/stage0/src/v1_interpreter.rs (canonical_content_cmp and its ContentView carriers, Display and Debug of Value::Map, admit_emitted_ord_keys, canonical_render_order_tests, portable_value_cmp, the sort in portable_value_from_ctx_at, value_hash's variant-name arm, portable_canonical_order_tests); dag/gunbc/portable_value_canonical_order_seed_growth.dag"
}
