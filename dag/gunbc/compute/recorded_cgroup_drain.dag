module gunbc.compute.recorded_cgroup_drain

import std.types { Bool, String, NonEmptyStr }
import std.algebra { trim }
import extdeps.systemd {
  SystemdUnitProperty, ControlGroup, ActiveState, InvocationIDProperty, systemd_unit_property_wire,
  SystemdUnitActiveState, Active, Inactive, Activating, Deactivating, Reloading, Failed, parse_systemd_unit_active_state,
}
import extdeps.systemd.systemctl
import extdeps.linux.cgroup_v2 {
  cgroup_v2_mount_point, cgroup_v2_events_path,
  CgroupEventsDecoded, CgroupEventsUnparseable, decode_cgroup_events_populated,
}
import extdeps.filesystem.filesystem_io {
  Filesystem,
  FilesystemExactRead, FilesystemExactPathRead, FilesystemExactPathAbsent,
  FilesystemExactPathUnreadable, FilesystemExactPathKindUnrecognized,
  filesystem_exact_read,
}

type RecordedInvocationStanding
  = RecordedInvocationStillCurrent
  | RecordedInvocationEnded

type RecordedCgroupPathStanding
  = RecordedPathAbsent
  | RecordedPathPopulated
  | RecordedPathEmpty
  | RecordedPathUnreadable { detail: String }

type RecordedCgroupDrain
  = RecordedCgroupPreserve { detail: String }
  | RecordedCgroupMaySeal { detail: String }

fn recorded_invocation_standing(recorded_id: String, current_id: String, unit_inactive: Bool) -> RecordedInvocationStanding {
  if unit_inactive || current_id != recorded_id {
    RecordedInvocationEnded
  } else {
    RecordedInvocationStillCurrent
  }
}

fn recorded_cgroup_drain(invocation: RecordedInvocationStanding, path: RecordedCgroupPathStanding) -> RecordedCgroupDrain {
  match invocation {
    RecordedInvocationStillCurrent =>
      RecordedCgroupPreserve { detail: "the recorded invocation is still the current one" }
    RecordedInvocationEnded =>
      match path {
        RecordedPathAbsent =>
          RecordedCgroupMaySeal { detail: "ENOENT on the recorded ControlGroup path" }
        RecordedPathEmpty =>
          RecordedCgroupMaySeal { detail: "cgroup.events populated 0" }
        RecordedPathPopulated =>
          RecordedCgroupPreserve { detail: "cgroup.events populated 1" }
        RecordedPathUnreadable { detail: d } =>
          RecordedCgroupPreserve { detail: d }
      }
  }
}

fn recorded_cgroup_may_seal(d: RecordedCgroupDrain) -> Bool {
  match d {
    RecordedCgroupMaySeal { detail: _ } => true
    RecordedCgroupPreserve { detail: _ } => false
  }
}

fn recorded_cgroup_drain_detail(d: RecordedCgroupDrain) -> String {
  match d {
    RecordedCgroupMaySeal { detail: s } => s
    RecordedCgroupPreserve { detail: s } => s
  }
}

fn systemd_unit_inactive_family(state: SystemdUnitActiveState) -> Bool {
  match state {
    Inactive => true
    Failed => true
    Active => false
    Activating => false
    Deactivating => false
    Reloading => false
  }
}

fn recorded_path_standing_from_events_error(error: String) -> RecordedCgroupPathStanding {
  if string_contains(s: error, pattern: "ENOENT") {
    RecordedPathAbsent
  } else {
    RecordedPathUnreadable { detail: error }
  }
}

fn recorded_path_standing_from_events_body(body: String) -> RecordedCgroupPathStanding {
  match decode_cgroup_events_populated(body: body) {
    CgroupEventsDecoded { populated: p } => if p { RecordedPathPopulated } else { RecordedPathEmpty }
    CgroupEventsUnparseable { cause: c } => RecordedPathUnreadable { detail: c }
  }
}

fn recorded_path_standing_from_exact_read(read: FilesystemExactRead) -> RecordedCgroupPathStanding {
  match read {
    FilesystemExactPathRead { path: _, content: body } => recorded_path_standing_from_events_body(body: body)
    FilesystemExactPathAbsent { path: _ } => RecordedPathAbsent
    FilesystemExactPathUnreadable { path: _, kind: _, error: e } => recorded_path_standing_from_events_error(error: e)
    FilesystemExactPathKindUnrecognized { path: _, observed: o, error: e } =>
      RecordedPathUnreadable { detail: join([o, ": ", e], "") }
  }
}

fn observe_system_unit_property(unit: NonEmptyStr, property: SystemdUnitProperty) -> String? {
  let shown = systemd.Systemctl.ShowProperty(unit: unit, property: systemd_unit_property_wire(property: property))
  if shown.success {
    Present { value: trim(s: shown.value) }
  } else {
    none
  }
}

fn observe_recorded_cgroup_path(control_group: String) -> RecordedCgroupPathStanding {
  if trim(s: control_group) == "" {
    RecordedPathUnreadable { detail: "the unit reported an empty ControlGroup; without a recorded path that is unobservable" }
  } else {
    let events_path = cgroup_v2_events_path(cgroup_path: join([cgroup_v2_mount_point as String, trim(s: control_group)], "") as NonEmptyStr)
    let raw = Filesystem.Read(path: events_path as String)
    recorded_path_standing_from_exact_read(
      read: filesystem_exact_read(
        path: events_path as String,
        content: raw.content,
        success: raw.success,
        error: raw.error,
        error_kind: raw.error_kind))
  }
}

fn observe_recorded_invocation_cgroup_drain(unit: NonEmptyStr, recorded_id: String, recorded_control_group: String) -> RecordedCgroupDrain {
  match observe_system_unit_property(unit: unit, property: ActiveState) {
    Absent =>
      RecordedCgroupPreserve { detail: join(["ActiveState of ", unit as String, " could not be read"], "") }
    Present { value: active_raw } =>
      match parse_systemd_unit_active_state(raw: active_raw) {
        Absent =>
          RecordedCgroupPreserve { detail: join(["ActiveState of ", unit as String, " was unparseable: ", active_raw], "") }
        Present { value: state } =>
          match observe_system_unit_property(unit: unit, property: InvocationIDProperty) {
            Absent =>
              RecordedCgroupPreserve { detail: join(["InvocationID of ", unit as String, " could not be read"], "") }
            Present { value: current_id } =>
              recorded_cgroup_drain(
                invocation: recorded_invocation_standing(
                  recorded_id: recorded_id,
                  current_id: current_id,
                  unit_inactive: systemd_unit_inactive_family(state: state)),
                path: observe_recorded_cgroup_path(control_group: recorded_control_group))
          }
      }
  }
}

fn observe_belt_unit_cgroup_drain(unit: NonEmptyStr) -> RecordedCgroupDrain {
  match observe_system_unit_property(unit: unit, property: ActiveState) {
    Absent =>
      RecordedCgroupPreserve { detail: join(["ActiveState of ", unit as String, " could not be read"], "") }
    Present { value: active_raw } =>
      match parse_systemd_unit_active_state(raw: active_raw) {
        Absent =>
          RecordedCgroupPreserve { detail: join(["ActiveState of ", unit as String, " was unparseable: ", active_raw], "") }
        Present { value: state } =>
          match observe_system_unit_property(unit: unit, property: InvocationIDProperty) {
            Absent =>
              RecordedCgroupPreserve { detail: join(["InvocationID of ", unit as String, " could not be read"], "") }
            Present { value: current_id } => {
              let invocation = recorded_invocation_standing(
                recorded_id: current_id,
                current_id: current_id,
                unit_inactive: systemd_unit_inactive_family(state: state))
              match observe_system_unit_property(unit: unit, property: ControlGroup) {
                Absent =>
                  recorded_cgroup_drain(
                    invocation: invocation,
                    path: RecordedPathUnreadable { detail: join(["ControlGroup of ", unit as String, " could not be read"], "") })
                Present { value: cg } =>
                  recorded_cgroup_drain(invocation: invocation, path: observe_recorded_cgroup_path(control_group: cg))
              }
            }
          }
      }
  }
}
