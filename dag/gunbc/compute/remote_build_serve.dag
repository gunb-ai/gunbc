// ── THE SERVING ENTRY: WHAT THE REMOTE-BUILD KEY'S FORCED COMMAND RUNS ──────────────────────────────
//
// sshd runs this, and only this, whenever the remote-build key authenticates (gunbc.compute.remote_build
// key custody). It runs as the remote-build account (gunbc.fleet.fleet_posix_accounts
// fleet_posix_remote_build_user), whose authorized_keys holds the key. The forced command names the HOST
// it serves, because the serving instance's paths are the same on every host; the request arrives only
// as SSH_ORIGINAL_COMMAND and is decoded by gunbc.compute.remote_build, never handed to a shell.
//
//   <serve binary> run --source-root <repo>/dag --source-root <repo>/src/v2
//     --entry <repo>/dag/gunbc/compute/remote_build_serve.dag --function remote_build_serve_cli
//     --arg host=<host>
//
// Steps, each answering with the ending the shared contract names (header line, then document):
//   1. the host is on the roster, which yields its serving instance and the ledger it reserves in;
//   2. the process is the remote-build account, holds its declared groups and no root-equivalent one,
//      and the ledger group lists the ledger's service user -- the owner of the capacity home the ledger
//      lives in, the same carrier step 1's subject resolves through, never a second lookup -- read back
//      from /proc/self/status and /etc/group (a key installed under any other account serves nothing);
//   3. a probe ("remote-build-v1 probe") is answered ready here, before any operation is read, so a
//      probe can never follow a started producer;
//   4. the request decodes;
//   5. the source ref is fetched from the public origin into the same ref name, and its commit is
//      the one the request names;
//   6. the gunbc build of that commit is asked for first and answers by its own outcome; only a
//      build that succeeded goes on;
//   7. the provider runs the operation on that commit, exactly as the local route would;
//   8. the header, the provider's document, and the ending's exit code.


// The host is resolved first only because the principal check needs the ledger's service user; nothing
// is read from the request until the principal is admitted. WHO THE LEDGER BELONGS TO IS NOT A SECOND
// QUESTION beside where it lives: this asks the same authority the ledger subject itself resolves
// through (gunbc.compute.host_capacity host_capacity_home_for_host). Asking a dashboard-instance lookup
// instead let one host answer twice -- the subject at the host home under the host's service root, the
// principal from an instance row that need not exist -- so srv3 and srv4, serving hosts with no dashboard
// instance of their own, refused the ledger they were writing.
// THE HOST-SIDE WALL BOUND, carried from the front door. The ceiling is the leg's wall budget, carried as
// the std.measure Second the fleet authority mints for HostBuildLeg (projected to a count only in the
// forced command's word); the accept instant is the door's own host-clock reading at the moment it accepted,
// carried as std.types EpochSecs -- a host-clock instant is never a bare Int (gunbc.spark.awaited_incarnation,
// review 76436). Both are host-local (no cross-host skew). The wall carries ONE absolute deadline (accept +
// ceiling): every unit derives its run bound from THAT deadline, so the wait-before-start bound and the run
// bound are the SAME budget spent once by construction -- there is no second remaining to drift -- and a
// request can never hold a seat past the instant its own client stopped waiting.
type RemoteBuildWall {
  ceiling: Second
  accepted_at: EpochSecs
}

// THE BOUND IS PARSED, NOT ASSUMED. A ceiling or accept instant that does not parse, a non-positive
// ceiling, or a pre-epoch accept instant is no bound at all: the entry refuses rather than running a
// request it cannot stop. The typed carriers are minted by their sanctioned checked crossings
// (checked_int_to_nat for the duration, checked_int_to_epoch_secs for the instant), never by a cast.
fn remote_build_wall_of_arguments(leg_ceiling: String, accept_instant: String) -> RemoteBuildWall? {
  match parse_int(s: trim(s: leg_ceiling)) {
    Absent => none
    Present { value: ceiling } =>
      if ceiling <= 0 {
        none
      } else {
        match checked_int_to_nat(n: ceiling) {
          Absent => none
          Present { value: ceiling_n } =>
            match parse_int(s: trim(s: accept_instant)) {
              Absent => none
              Present { value: accepted } =>
                match checked_int_to_epoch_secs(n: accepted) {
                  Absent => none
                  Present { value: accepted_at } =>
                    Present { value: RemoteBuildWall { ceiling: second(count: ceiling_n), accepted_at: accepted_at } }
                }
            }
        }
      }
  }
}

// THE ONE ABSOLUTE DEADLINE: the instant the request must finish by, derived once from the accept instant
// and the ceiling (EpochSecs + a Second projected to a count, the retry-law instant+duration shape). This
// is the single budget; both units are bounded by it, so "spent once" is structural, not two recomputations.
fn remote_build_deadline(wall: RemoteBuildWall) -> EpochSecs {
  wall.accepted_at + (second_count(s: wall.ceiling) as Int)
}

// THE RUN CEILING FOR A UNIT LAUNCHED NOW, or Absent when the request has already spent its whole leg
// budget (the caller reads Absent as refuse-to-start). The remaining is the deadline less the launch
// instant (EpochSecs - EpochSecs lands in Int); a non-positive remaining is Absent before any crossing,
// and the positive remaining crosses to Nat through std.checked_arithmetic's sanctioned checked_int_to_nat
// (an `as Nat` cast over an arbitrary Int is refused by the checker, std.coercion refinement_cast_rules).
fn remote_build_runtime_max_at(wall: RemoteBuildWall, launch_now: EpochSecs) -> Second? {
  let remaining = remote_build_deadline(wall: wall) - launch_now
  if remaining <= 0 {
    none
  } else {
    match checked_int_to_nat(n: remaining) {
      Absent => none
      Present { value: k } => Present { value: second(count: k) }
    }
  }
}

// THE HOST CLOCK AT A UNIT LAUNCH, or the honest reason it could not be read. A clock the host cannot
// read is NOT a request that waited past its budget -- it is the host failing to bound the request at
// all, and it gets its own typed answer (gunbc.design_argument::fail_closed: no plausible cause is
// fabricated). The instant crosses as the clock's own millis-to-seconds conversion.
type RemoteBuildLaunchClock
  = LaunchClockAt { at: EpochSecs }
  | LaunchClockUnreadable { detail: String }

fn remote_build_launch_clock() -> RemoteBuildLaunchClock {
  match clock_unix_millis_read() {
    ClockUnixMillisRefused { detail } => LaunchClockUnreadable { detail: detail }
    ClockUnixMillisObserved { millis } => LaunchClockAt { at: epoch_secs_of_millis(millis: millis) }
  }
}

// THE CLOCK-UNREADABLE ANSWER. The host could not read its own clock, so it cannot bound the run; it
// declines with the cannot-serve ending (the request moves to a host that can read its clock), carrying
// the clock's own detail -- never the wait-bound refusal, which would claim a wait that did not happen
// and a retry allowance the host never granted.
fn remote_build_clock_unreadable_refusal(detail: String) -> CliWireResponse {
  remote_build_serve_answer(
    ending: ServeHostCannotServe,
    text: concat("remote-build: the serving host cannot read its clock to bound the request: ", detail),
  )
}

// THE REFUSE-TO-START RECEIPT. The wait-bound decline is the room/readiness ending (ServeHostFull), which
// MOVES the request to the next host -- a host whose queue ran past its own bound has spoken about itself,
// not about the request, so it is the room-not-work class, never the final ServeRequestRefused that would
// stop the whole roster. It is a CAPACITY-LIMITED, RETRY-ALLOWED answer: the body carries a retry allowance
// (the declared minimum back-off, since the door holds no queue estimate) as the first line, which the
// client reads back as a std.retry_law RetryHint on HostCapacityFull -- the same shape the serving router
// gives its caller (operator direction 2026-11-26, first step toward gunbc.plans.fabric_serving_router).
// The bound rides in the detail as the count it was minted in, the way the client's own leg-overrun detail
// spells its ceiling.
fn remote_build_wait_bound_refusal(wall: RemoteBuildWall) -> CliWireResponse {
  remote_build_serve_answer(
    ending: ServeHostFull,
    text: remote_build_capacity_body(
      retry_after: remote_build_capacity_retry_floor,
      detail: join(["remote-build: the request waited past its ", nat_to_decimal_string(value: second_count(s: wall.ceiling)), "s host leg budget before its unit could start; the seat is released and the request moves on"], ""),
    ),
  )
}

fn remote_build_serve_cli(host: String, leg_ceiling: String, accept_instant: String) -> CliWireResponse {
  match remote_build_wall_of_arguments(leg_ceiling: leg_ceiling, accept_instant: accept_instant) {
    Absent => remote_build_serve_answer(ending: ServeHostCannotServe, text: "remote-build: the front door handed the request entry no usable leg ceiling and accept instant")
    Present { value: wall } => match remote_build_candidate_for_host(host: host) {
      Absent => remote_build_serve_answer(ending: ServeHostCannotServe, text: concat("remote-build: the roster has no serving instance for host ", host))
      Present { value: candidate } =>
        match remote_build_serve_ledger_owner(host: host) {
          ServeLedgerOwnerUndeclared { host: h } => remote_build_serve_answer(ending: ServeHostCannotServe, text: concat("remote-build: no capacity home is declared for host ", h))
          ServeLedgerOwnerDeclared { service_user: owner } =>
            match remote_build_serve_principal(service_user: owner) {
              RemoteBuildServePrincipalRefused { reason } =>
                remote_build_serve_answer(ending: ServeHostCannotServe, text: concat("remote-build: not serving as this principal: ", reason))
              RemoteBuildServePrincipalAdmitted => remote_build_serve_on(instance: candidate.instance, wall: wall)
            }
        }
    }
  }
}

// WHO MAY WRITE THIS HOST'S LEDGER, read off the carrier that says where that ledger lives.
// gunbc.compute.host_capacity host_capacity_home_for_host is the one decision: a rostered serving host's
// home is the host-scoped area under the host's service root, whose declared directory owner is the
// ledger's service user; a host that runs a dashboard instance takes that instance's home and owner
// instead, exactly as before; a host with neither has no ledger to authorize, and that is a refusal
// rather than a default. The serving converge declares that same owner as a member of the compute-ledger
// group (gunbc.compute.remote_build_serving_setup serving_ledger_service_user reads it back off the ledger
// area's own ownership), so a converged host admits here and a host whose group file predates that share
// refuses with the reason named.
type RemoteBuildServeLedgerOwner
  = ServeLedgerOwnerDeclared { service_user: NonEmptyStr }
  | ServeLedgerOwnerUndeclared { host: String }

fn remote_build_serve_ledger_owner(host: String) -> RemoteBuildServeLedgerOwner {
  match host_capacity_home_for_host(host: host as NonEmptyStr) {
    HostCapacityHomeUnknown { host: h } => ServeLedgerOwnerUndeclared { host: h as String }
    HostCapacityHomeFound { home: home } => ServeLedgerOwnerDeclared { service_user: home.directory_owner.user }
  }
}

fn remote_build_serve_on(instance: HostDashboardInstance, wall: RemoteBuildWall) -> CliWireResponse {
  match shell.Env.Get(name: remote_build_ssh_command_variable).value {
    Absent => remote_build_serve_answer(ending: ServeRequestRefused, text: "remote-build: no request (SSH_ORIGINAL_COMMAND is unset)")
    Present { value: text } =>
      if remote_build_leg_is_probe(raw: text) {
        // THE PROBE IS ANSWERED AT THE FRONT DOOR, AND ONLY THERE. "ready" is the client's licence to
        // send work, and it must mean "the entry that answers this is the entry whose closure stops at
        // the probe" -- an entry that carries the whole request path may not mint it (the cost this
        // route paid was exactly a probe that resolved the request closure: srv1, 2026-11-25). The
        // ending is the one the client reads as "ask the next host", never an absence: a host whose
        // authorized_keys still names THIS entry has not converged the front door, and the walk must
        // move on rather than treat a stale install as a ready host.
        remote_build_serve_answer(ending: ServeHostCannotServe, text: "remote-build: the probe is answered by the front door (gunbc.compute.remote_build_serve_front_door)")
      } else {
        match remote_build_decode_request(text: text) {
          RemoteBuildRequestRefused { cause } =>
            remote_build_serve_answer(ending: ServeRequestRefused, text: concat("remote-build: ", remote_build_request_refusal_text(cause: cause)))
          RemoteBuildWorkDecoded { work } => remote_build_serve_request(instance: instance, work: work, wall: wall)
        }
      }
  }
}

fn remote_build_candidate_for_host(host: String) -> RemoteBuildCandidate? {
  remote_build_candidates() |> filter(c => c.host as String == host) |> first
}


fn remote_build_git(instance: HostDashboardInstance, args: List<String>) -> ComputeExec {
  compute_exec(
    program: dispatch_capability_program(environment: instance.execution_environment, cap: GitWorkspaceCapability),
    workdir: instance.repo_root as String,
    args: args,
  )
}

// The origin is fetched BY URL, from the repository row, so the serving repo needs no remote named
// for it and its own remotes are untouched. The fetch is anonymous, which is admitted only because
// the row says the repository is public; a private row refuses here rather than failing at fetch.
fn remote_build_fetch_argv(work: RemoteBuildWork) -> List<String> {
  let name = remote_build_source_ref_name(r: work.source) as String
  ["fetch", "--no-tags", "--no-write-fetch-head", github_https_clone_url(repo: gunbc_repository) as String, join(["+", name, ":", name], "")]
}

fn remote_build_serve_request(instance: HostDashboardInstance, work: RemoteBuildWork, wall: RemoteBuildWall) -> CliWireResponse {
  if gunbc_repository.private {
    remote_build_serve_answer(ending: ServeHostCannotServe, text: "remote-build: the repository row is private, so the anonymous source fetch is not admitted")
  } else {
    match remote_build_git(instance: instance, args: remote_build_fetch_argv(work: work)) {
      ComputeExecFailed { exit_code, stdout: _, stderr } =>
        remote_build_serve_answer(ending: ServeHostCannotServe, text: join(["remote-build: fetching ", remote_build_source_ref_name(r: work.source) as String, " failed (exit ", to_string(value: exit_code), "): ", stderr], ""))
      ComputeExecOk { stdout: _, stderr: _ } =>
        match remote_build_git(instance: instance, args: ["rev-parse", "--verify", "--quiet", concat(remote_build_source_ref_name(r: work.source) as String, "^\{commit\}")]) {
          ComputeExecFailed { exit_code: _, stdout: _, stderr } =>
            remote_build_serve_answer(ending: ServeRequestRefused, text: concat("remote-build: the fetched source ref names no commit: ", stderr))
          ComputeExecOk { stdout, stderr: _ } =>
            match git_object_id_from_untagged_hex(hex: trim(stdout)) {
              Absent => remote_build_serve_answer(ending: ServeHostCannotServe, text: concat("remote-build: rev-parse printed no object id: ", stdout))
              Present { value: fetched } =>
                match remote_build_admit_fetched_source(work: work, fetched: fetched) {
                  RemoteBuildSourceMoved { requested, fetched: seen } =>
                    remote_build_serve_answer(ending: ServeRequestRefused, text: join(["remote-build: the source ref moved: requested ", requested as String, ", fetched ", seen as String], ""))
                  RemoteBuildSourceMatches => remote_build_serve_provide(instance: instance, work: work, wall: wall)
                }
            }
        }
    }
  }
}

fn remote_build_provide_on(instance: HostDashboardInstance, work: RemoteBuildWork, op: WorkOperation, runtime_max: Second?) -> ProvideResult {
  compute_provide(
    instance: instance,
    owner: DirectInvocation { why: "remote-build: a request arriving over the remote-build key invoked the provider directly" },
    commit: git_object_id_wire_hex(oid: work.commit) as String,
    op: op,
    target: TargetIsExecutingHost,
    runtime_max: runtime_max,
  )
}

// THE DEPENDENCY RULE DECIDES THE SHAPE OF THE RUN, and it is decided in gunbc.compute.remote_build,
// not read off the request here. A request that depends on the seed build gets THE BUILD FIRST, answered
// by its own typed outcome: a failed build is the work's answer, a full pool or a build in flight is
// that, and only a build that succeeded (produced or attached) goes on to the operation, which then
// attaches to it. A request that carries its own seed build goes to its operation directly, because for
// it the attached binary is the wrong answer and the second reservation is a second door to refuse.
//
// THE SERVING BINARY'S IDENTITY applies to whichever shape ran: the question "which binary served this"
// is asked of the serve, not of the operation, so the tail that turns a provided attempt into a wire
// answer is shared by both -- one authority on what a completed serve attests (remote_build_serve_settled),
// not two copies that can drift.
fn remote_build_serve_provide(instance: HostDashboardInstance, work: RemoteBuildWork, wall: RemoteBuildWall) -> CliWireResponse {
  match remote_build_dependency_rule(op: work.operation) {
    RemoteBuildCarriesItsOwnSeedBuild =>
      match remote_build_launch_clock() {
        LaunchClockUnreadable { detail } => remote_build_clock_unreadable_refusal(detail: detail)
        LaunchClockAt { at: now } => match remote_build_runtime_max_at(wall: wall, launch_now: now) {
          Absent => remote_build_wait_bound_refusal(wall: wall)
          Present { value: runtime_max } => remote_build_serve_settled(
            instance: instance,
            result: remote_build_provide_on(instance: instance, work: work, op: remote_build_work_operation(op: work.operation), runtime_max: Present { value: runtime_max }),
          )
        }
      }
    RemoteBuildBuildsTheSeedFirst =>
      match remote_build_launch_clock() {
        LaunchClockUnreadable { detail } => remote_build_clock_unreadable_refusal(detail: detail)
        LaunchClockAt { at: build_now } => match remote_build_runtime_max_at(wall: wall, launch_now: build_now) {
          Absent => remote_build_wait_bound_refusal(wall: wall)
          Present { value: build_max } =>
            let build = remote_build_provide_on(instance: instance, work: work, op: remote_build_dependency_operation(), runtime_max: Present { value: build_max })
            match remote_build_ending_of_provide(r: build) {
              ServeServed =>
                // The operation launches after the build, so its bound is what remains of the SAME deadline
                // at its own launch instant: the wall carries one deadline, both units are bounded by it, and
                // the operation is refused rather than started past it. One budget, spent once.
                match remote_build_launch_clock() {
                  LaunchClockUnreadable { detail } => remote_build_clock_unreadable_refusal(detail: detail)
                  LaunchClockAt { at: work_now } => match remote_build_runtime_max_at(wall: wall, launch_now: work_now) {
                    Absent => remote_build_wait_bound_refusal(wall: wall)
                    Present { value: work_max } => remote_build_serve_settled(
                      instance: instance,
                      result: remote_build_provide_on(instance: instance, work: work, op: remote_build_work_operation(op: work.operation), runtime_max: Present { value: work_max }),
                    )
                  }
                }
              // The dependency build did not serve: its ending IS the work's answer, identity aside.
              _ => remote_build_serve_answer(ending: remote_build_ending_of_provide(r: build), text: provide_result_document(r: build))
            }
        }
      }
  }
}

// THE TAIL ONE PROVIDED ATTEMPT DESERVES, ONCE ITS SHAPE IS CHOSEN.
//
// Only a run the serving binary COMPLETED gets an identity folded in -- it is the answer to "which binary
// served this", and the one outcome the identity machinery may touch. A damaged sidecar then REFUSES that
// success claim (you cannot attest a clean serve you cannot vouch for); no build outcome is lost, because
// the only ending it can overwrite is the success it attests.
//
// Not served (unsuccessful, refused, host full, in flight): the work's OWN typed outcome is the answer,
// untouched. The serving binary never attested a success here, so there is nothing to vouch for and a
// present-but-broken identity file must not overwrite the work's verdict.
fn remote_build_serve_settled(instance: HostDashboardInstance, result: ProvideResult) -> CliWireResponse {
  let work_ending = remote_build_ending_of_provide(r: result)
  match work_ending {
    ServeServed => remote_build_serve_identity_answer(
      ending: ServeServed,
      document: provide_result_document(r: result),
      identity: read_serve_binary_identity(serve_binary: instance.serve_binary as String),
    )
    _ => remote_build_serve_answer(ending: work_ending, text: provide_result_document(r: result))
  }
}
// THE SERVING BINARY'S IDENTITY, read from the sidecar the converge step writes beside the binary.
// A receipt that does not say WHICH binary served it lets a stale or substituted serve binary pass for
// the dispatched one, so the receipt names the dispatched revision and the binary's own sha256. The
// bytes live at `<serve_binary>.identity`, written by the fleet-converge RecordServeIdentity step
// (gunbc.compute.remote_build_serving_converge); this slice only READS them. The format is one JSON
// object carrying string members `revision` and `sha256`; PR-1b writes exactly this, and the reader
// here is the one authority on it.
//
// The three readings are distinct and never collapsed (gunbc.design_argument::fail_closed): the file
// being ABSENT is the honest "no identity yet" (the member is simply absent, never fabricated), while a
// file that is present but unreadable or not the documented object is REFUSED -- reading it as "absent"
// would let a damaged identity file pass for a freshly-installed binary with none.
type ServeBinaryIdentity
  = ServeIdentityAbsent
  | ServeIdentityObserved { revision: String, sha256: String }
  | ServeIdentityRefused { cause: String }

// One string member of an already-parsed JSON object, or none when it is absent, duplicated, or not a
// string. Shared by the two members the identity file must carry.
fn serve_identity_string_member(doc: JsonValue, key: String) -> String? {
  match json_object_unique_member(v: doc, key: key) {
    JsonMemberFound { value: JsonString { value: s } } => Present { value: s }
    _ => Absent
  }
}

// Parse the identity file's bytes. The file is present (the caller has already established that), so
// anything short of the documented two-string object is a refusal, never an absent reading.
fn parse_serve_binary_identity(content: String) -> ServeBinaryIdentity {
  match parse_json_document(s: content) {
    JsonDocumentUnreadable { gap: gap } => ServeIdentityRefused { cause: concat("identity file is not readable JSON: ", json_document_gap_text(gap: gap)) }
    JsonDocumentParsed { value: doc } =>
      match serve_identity_string_member(doc: doc, key: "revision") {
        Absent => ServeIdentityRefused { cause: "identity file carries no string `revision`" }
        Present { value: revision } =>
          match serve_identity_string_member(doc: doc, key: "sha256") {
            Absent => ServeIdentityRefused { cause: "identity file carries no string `sha256`" }
            Present { value: sha256 } => ServeIdentityObserved { revision: revision, sha256: sha256 }
          }
      }
  }
}

// Read the sidecar beside the serving binary. Only the host's own absent answer is read as absent; an
// unreadable path or an unexpected kind refuses with its own cause (extdeps.filesystem.filesystem_io
// types the failure by the host, and a present-but-broken file is not the absent file).
fn read_serve_binary_identity(serve_binary: String) -> ServeBinaryIdentity {
  match source_root_read_file(path: concat(serve_binary, ".identity")) {
    FilesystemExactPathRead { path: _, content: content } => parse_serve_binary_identity(content: content)
    FilesystemExactPathAbsent { path: _ } => ServeIdentityAbsent
    FilesystemExactPathUnreadable { path: unreadable, kind: _, error: error } =>
      ServeIdentityRefused { cause: concat("identity file unreadable (", unreadable, "): ", error) }
    FilesystemExactPathKindUnrecognized { path: unrecognized, observed: observed, error: error } =>
      ServeIdentityRefused { cause: concat("identity file is not a regular file (", unrecognized, " is ", observed, "): ", error) }
  }
}

// A receipt is the work's own JSON object; the identity is folded in as one top-level member. The
// absent identity leaves the document untouched (member absent, never a null or a guess); a refused
// identity refuses the whole answer rather than emitting a receipt that silently omits who served it.
type ServeReceiptAugment = ReceiptAugmented { document: String } | ReceiptRefused { cause: String }

fn serve_receipt_with_identity(document: String, identity: ServeBinaryIdentity) -> ServeReceiptAugment {
  match identity {
    ServeIdentityAbsent => ReceiptAugmented { document: document }
    ServeIdentityRefused { cause: cause } => ReceiptRefused { cause: cause }
    ServeIdentityObserved { revision: revision, sha256: sha256 } =>
      match parse_json_document(s: document) {
        JsonDocumentUnreadable { gap: gap } => ReceiptRefused { cause: concat("receipt is not readable JSON: ", json_document_gap_text(gap: gap)) }
        JsonDocumentParsed { value: doc } => match doc {
          JsonObject { members: members } => ReceiptAugmented {
            document: serialize_json(v: json_object(members: concat(members, [json_kv(key: "serve_binary", value: json_object(members: [
              json_kv(key: "revision", value: json_string(s: revision)),
              json_kv(key: "sha256", value: json_string(s: sha256)),
            ]))]))),
          }
          _ => ReceiptRefused { cause: "receipt is not a JSON object" }
        }
      }
  }
}

// Reached ONLY for a completed serve (the caller gates on ServeServed), so the one ending a refused
// identity can overwrite is the success the identity attests. A damaged sidecar is answered as
// ServeRequestRefused rather than a clean receipt that omits who served it, and rather than a silent
// re-use of ServeServed: a serve you cannot vouch for is not a serve (gunbc.design_argument::fail_closed).
fn remote_build_serve_identity_answer(ending: RemoteBuildServeEnding, document: String, identity: ServeBinaryIdentity) -> CliWireResponse {
  match serve_receipt_with_identity(document: document, identity: identity) {
    ReceiptAugmented { document: text } => remote_build_serve_answer(ending: ending, text: text)
    ReceiptRefused { cause: cause } => remote_build_serve_answer(ending: ServeRequestRefused, text: concat("serve binary identity: ", cause))
  }
}

// A LOST HOST RECORD IS NOT A CLEAN RUN, the same reading gunbc.compute.test_run gives it: the work's
// own ending is in the document, but the run is answered as unsuccessful so the loss is heard.
fn remote_build_ending_of_provide(r: ProvideResult) -> RemoteBuildServeEnding {
  let ending = match r {
    ProvideFresh { outcome, document: _, host_record: _ } => remote_build_ending_of_outcome(o: outcome)
    // An attached run carries its stored ending as the provider's wire spelling; the provider's own
    // reading of it (provide_result_succeeded) is the one authority, not a literal restated here.
    ProvideAttached { identity: _, ending: _, document: _, host_record: _ } =>
      if provide_result_succeeded(r: r) { ServeServed } else { ServeWorkEndedUnsuccessfully }
  }
  match ending {
    ServeServed => if host_record_was_written(h: provide_result_host_record(r: r)) { ServeServed } else { ServeWorkEndedUnsuccessfully }
    _ => ending
  }
}

// ── THE AUTHORIZED ENTRY EACH ROSTER HOST INSTALLS ──────────────────────────────────────────────────
//
// The forced command is derived from the roster candidate, so the serving binary and repo root have one
// authority (gunbc.compute.remote_build remote_build_serving_instance) and the host it names is the
// candidate's. The line goes in the remote-build account's authorized_keys, never the operator's: the
// serving entry refuses any other principal (remote_build_serve_principal). The command is rendered by
// gunbc.remote_shell_command, whose single quotes the extdeps.ssh.keys constructor admits. `restrict`
// disables forwarding, the pty, X11 and the user rc; the forced command replaces whatever the client
// asked to run.

// EVERY LEG ARRIVES HERE FIRST, AT THE FRONT DOOR: the words name
// gunbc.compute.remote_build_serve_front_door, which answers a probe from its own tiny closure and hands
// a request to the serving entry (that module says why an entry that carries the request path may not
// answer a probe). The words are the wire module's one rendering, shared with the hand-off, so the two
// can never drift to different binaries or checkouts.
//
// THE COMMAND STARTS IN THE SERVING CHECKOUT. sshd runs a forced command as the account's login shell
// with -c (extdeps.ssh.openssh_remote_command openssh_remote_command_execution), from the account's
// home, and `gunbc run` binds its workspace root by discovery from the directory it starts in, refusing
// when no ancestor is a checkout. The home is not the checkout, so the command names its directory
// (gunbc.remote_shell_command ShellCommandInDirectory) and every request starts there; without it every
// request was refused "no workspace root" before the serving function ran (observed on srv1,
// 2026-11-15, by the first live probe). The directory and the words are rendered by that module's one
// quoting rule, never spliced as shell text here (review 95657).
fn remote_build_forced_command_words(candidate: RemoteBuildCandidate) -> List<NonEmptyStr> {
  // THE HOST-DECLARED CEILING RIDES IN THE FORCED COMMAND, taken from the same authority the client arms
  // its leg with (fleet_leg_wall_deadline, HostBuildLeg). It is rendered here, at converge time, into the
  // authorized_keys line -- so an old client cannot bypass it, and changing the ceiling needs a reconverge
  // to reach the installed line.
  remote_build_serve_front_door_run_words(
    serve_binary: candidate.instance.serve_binary as NonEmptyStr,
    repo_root: candidate.instance.repo_root as NonEmptyStr,
    host: candidate.host as String,
    leg_ceiling: nat_to_decimal_string(value: second_count(s: fleet_leg_wall_deadline(kind: HostBuildLeg))) as NonEmptyStr,
  )
}

fn remote_build_forced_command_text(candidate: RemoteBuildCandidate) -> NonEmptyStr {
  emit_remote_shell_in_directory(c: ShellCommandInDirectory {
    directory: candidate.instance.repo_root as NonEmptyStr,
    command: ShellSimpleCommand { words: remote_build_forced_command_words(candidate: candidate), redirections: [] },
  })
}

// The rendered text sits inside the authorized_keys command="..." value, so a word whose quoting needs
// a backslash (one holding a single quote) or a double quote has no forced command and the host is
// reported unrenderable (extdeps.ssh.keys authorized_key_forced_command).
fn remote_build_forced_command(candidate: RemoteBuildCandidate) -> AuthorizedKeyForcedCommand? {
  authorized_key_forced_command(text: remote_build_forced_command_text(candidate: candidate) as String)
}

// CONSUMPTION (gunbc.design_argument::consumption): a declared frontier. The installer is the host
// change that writes these lines into the provider account's authorized_keys on each roster host, applied
// through the fleet converge with operator approval; until it lands the line is read only by the
// witness and by the operator's install.
//
// THE PRIMITIVE: one (candidate, key) pair renders one AuthorizedKeyEntry with restrict + forced command.
// The serving account's authorized_keys is the admitted list rendered through this primitive and NOTHING
// ELSE — no hand-added keys (gunbc.design_ruling::remote_build_ssh_dispatch_is_an_admitted_scaffold).
fn remote_build_authorized_entry(candidate: RemoteBuildCandidate, client_key: RemoteBuildClientKey) -> AuthorizedKeyEntry? {
  match remote_build_forced_command(candidate: candidate) {
    Absent => none
    Present { value: c } => Present { value: AuthorizedKeyEntry { options: [RestrictOption, ForcedCommandOption { command: c }], key: client_key.public_key } }
  }
}

// Render every admitted key for a given candidate host. Returns none (the candidate is unrenderable) when
// the forced command itself cannot be built; otherwise the list has one entry per admitted key.
fn remote_build_admitted_entries(candidate: RemoteBuildCandidate) -> Optional<List<AuthorizedKeyEntry>> {
  match remote_build_forced_command(candidate: candidate) {
    Absent => none
    Present { value: _ } => {
      let entries = map(remote_build_admitted_client_keys, k => remote_build_authorized_entry(candidate: candidate, client_key: k))
      let rendered = flat_map(entries, e => match e { Absent => [], Present { value: v } => [v] })
      Present { value: rendered }
    }
  }
}

// THE LINES TO INSTALL, rendered from the model so the operator's install copies them rather than
// retyping them: one "<host>: <authorized_keys line>" per roster host, or a refusal naming the host
// whose forced command could not be rendered.
//   gunbc run --source-root dag --source-root src/v2 --entry dag/gunbc/compute/remote_build_serve.dag
//     --function remote_build_authorized_keys_lines
// EACH CANDIDATE IS RENDERED ONCE, into a typed result: a host either has its entries (one per admitted
// key) or is named as unrenderable, and the printed lines are read off the rendered arm, so there is no
// second render and no fallback value for one that failed (review 95529).
type RemoteBuildRenderedEntry
  = RemoteBuildEntryRendered { candidate: RemoteBuildCandidate, entries: List<AuthorizedKeyEntry> }
  | RemoteBuildEntryUnrenderable { candidate: RemoteBuildCandidate }

fn remote_build_render_entry(candidate: RemoteBuildCandidate) -> RemoteBuildRenderedEntry {
  match remote_build_admitted_entries(candidate: candidate) {
    Absent => RemoteBuildEntryUnrenderable { candidate: candidate }
    Present { value: es } => RemoteBuildEntryRendered { candidate: candidate, entries: es }
  }
}

fn remote_build_unrenderable_line(r: RemoteBuildRenderedEntry) -> List<String> {
  match r {
    RemoteBuildEntryRendered { candidate: _, entries: _ } => []
    RemoteBuildEntryUnrenderable { candidate } => [join([candidate.host as String, ": the forced command could not be rendered; nothing to install"], "")]
  }
}

fn remote_build_installable_line(r: RemoteBuildRenderedEntry) -> List<String> {
  match r {
    RemoteBuildEntryUnrenderable { candidate: _ } => []
    RemoteBuildEntryRendered { candidate, entries } =>
      map(entries, e => join([candidate.host as String, " (", candidate.instance.directory_owner.user as String, "@", candidate.instance.repo_root as String, "): ", authorized_key_entry_line(e: e)], ""))
  }
}

// A REFUSAL PRINTS NO INSTALLABLE LINE AT ALL and exits non-zero, so a partial set can be neither
// mistaken for a complete one nor pasted (review 95515).
fn remote_build_authorized_keys_lines() -> CliWireResponse {
  let rendered = map(remote_build_candidates(), c => remote_build_render_entry(candidate: c))
  let refused = flat_map(rendered, r => remote_build_unrenderable_line(r: r))
  if count(refused) > 0 {
    CliWirePrintable { bytes: concat(join(refused, "\n"), "\n"), exit: ExitFailure { code: 2, reason: "" } }
  } else {
    CliWirePrintable { bytes: concat(join(flat_map(rendered, r => remote_build_installable_line(r: r)), "\n"), "\n"), exit: ExitSuccess }
  }
}
