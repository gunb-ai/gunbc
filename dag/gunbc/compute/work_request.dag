module gunbc.compute.work_request

import std.types { String, Bool, Int, List, NonEmptyStr, FilePath }
import std.algebra { trim }
import std.measure { Kibibyte, kibibyte_count }
import std.content_hash { Fnv1a64Structural }
import extdeps.systemd.systemd_run { SystemdRunOptionWordsRefusedCause, systemd_run_option_words_refused_cause_detail }
import extdeps.git.object_store { GitObjectId, git_object_id_wire_hex }
import extdeps.languages.json.emit {
  JsonValue, json_object, json_kv, json_string, json_int, json_array, serialize_json,
}
import extdeps.languages.json.parse {
  parse_json_document, JsonDocumentParsed, JsonDocumentUnreadable, json_document_gap_text,
  json_object_unique_member, JsonMemberFound, JsonMemberAbsent, JsonMemberDuplicated, JsonMemberNotAnObject,
  JsonString,
}

// THE EXACT WORK CONTRACT, FIRST SLICE (roadmap row compute-exact-work-contract). A request names
// the exact tree it applies to, the operation, and the toolchain that will serve it; the answer is
// one of five endings and never a sixth. This module is pure: it decides identity and shape. The
// provider that runs work lives beside it (gunbc.compute.work_provider_local) and is one of N.
//
// WHY THIS EXISTS NOW: a roadmap worker's only tool is `timeout N /bin/sh -c` in its worktree, so
// every worker that wants to check its work runs its own cargo build and its own gunbc compile into
// its own target directory, and verify runs them again. One identity per (tree, operation,
// toolchain) is what lets two callers share one build and lets a host cap how many cold builds it
// carries; the identity is content, so a branch name or a working directory can never be a subject.

// A subject is a git TREE, never a commit message, branch or path: two commits with the same tree
// are the same work. The provider resolves the tree from the commit a caller holds and checks the
// commit out, but the identity is the tree's.
type WorkSubject = ExactTree { tree: GitObjectId }

type CargoProfile = CargoRelease | CargoDebug

fn cargo_profile_wire(p: CargoProfile) -> String {
  match p {
    CargoRelease => "release"
    CargoDebug => "debug"
  }
}

// THE BINARIES A COMPUTE BUILD MAY PRODUCE ARE A CLOSED SET. Each is a declared output of the build's
// record with its own output id (std.materialization_provider compute_work_binary_output), so which
// part is which binary is a variant, never a name recovered from a string; and a bin name that is not
// one of these has no constructor, so it cannot reach a command line or a key.
type GunbcBinary = GunbcDriver | ClaimBatchRunner

fn gunbc_binary_name(b: GunbcBinary) -> NonEmptyStr {
  match b {
    GunbcDriver => "gunbc" as NonEmptyStr
    ClaimBatchRunner => "claim_batch" as NonEmptyStr
  }
}

// Where cargo writes one binary under the target root for one profile.
fn work_binary_declared_path(profile: CargoProfile, b: GunbcBinary) -> String {
  join([cargo_profile_wire(p: profile), "/", gunbc_binary_name(b: b) as String], "")
}

// The three operations a worker may ask for. Each declares its outputs; a run whose declared output
// is absent is WorkOutputMismatch, not success (compute-artifact-return-and-materialization's red).
type WorkOperation
  = BuildGunbcBinaries { profile: CargoProfile, bins: List<GunbcBinary> }
  | CompileEntry { entry: FilePath }
  | RunClaims { entry: FilePath, functions: NonEmptyStr, hermetic: Bool, window: ClaimDiffWindow? }

fn work_operation_kind(op: WorkOperation) -> String {
  match op {
    BuildGunbcBinaries { profile: _, bins: _ } => "build"
    CompileEntry { entry: _ } => "compile"
    RunClaims { entry: _, functions: _, hermetic: _, window: _ } => "claims"
  }
}

// THE AFFECTED-SET WINDOW A CLAIM RUN READS. A claim that reads GUNBC_DIFF_WINDOW_PATH answers
// relative to that window -- the same tree under a different target generation is a different
// question -- so the window is a DECLARED INPUT of the run: its identity (the window's own derived
// window_identity, gunbc.git_diff_change_window GitExactDiffWindow) is in the canonical text, and its
// path is only where the unit finds the file, a location that keys nothing.
type ClaimDiffWindow {
  identity: Fnv1a64Structural
  path: FilePath
}

// Canonical text of an operation: the identity's payload, so any argument that changes what runs
// changes the identity, and nothing else does.
fn work_operation_canonical(op: WorkOperation) -> String {
  match op {
    BuildGunbcBinaries { profile, bins } =>
      join(["build:", cargo_profile_wire(p: profile), ":", join(map(bins, b => gunbc_binary_name(b: b) as String), ",")], "")
    CompileEntry { entry } => join(["compile:", entry as String], "")
    RunClaims { entry, functions, hermetic, window } =>
      join(["claims:", entry as String, ":", functions as String, ":", if hermetic { "hermetic" } else { "wet" },
        match window { Present { value: w } => join([":window=", w.identity.digest as String], "")  Absent => "" }], "")
  }
}

// The binaries the default build produces: the compiler driver and the claim runner, which the
// compile and claims operations of the SAME subject consume.
data work_default_bins: List<GunbcBinary> = [GunbcDriver, ClaimBatchRunner]

fn work_default_build() -> WorkOperation {
  BuildGunbcBinaries { profile: CargoRelease, bins: work_default_bins }
}

// The outputs an operation declares, each relative to a named root: cargo writes binaries under the
// TARGET root the provider shares per host (CARGO_TARGET_DIR), not under the checkout -- the first wet
// run declared them under the checkout and reported a mismatch on a build that had succeeded, which
// is the mismatch arm doing its job and the declaration being wrong. Checking operations declare
// none: their result is the verdict.
type WorkOutputRoot = CheckoutRoot | TargetRoot

type DeclaredOutput {
  root: WorkOutputRoot
  path: String
}

fn work_declared_outputs(op: WorkOperation) -> List<DeclaredOutput> {
  match op {
    BuildGunbcBinaries { profile, bins } =>
      map(bins, b => DeclaredOutput { root: TargetRoot, path: work_binary_declared_path(profile: profile, b: b) })
    CompileEntry { entry: _ } => []
    RunClaims { entry: _, functions: _, hermetic: _, window: _ } => []
  }
}

// THE EXECUTION HALF OF THE IDENTITY: everything that can change what the same tree and operation
// produce on a host, OBSERVED rather than spelled. Hidden fleet uniformity is not an identity axis
// (ruling on gunbc#13072, item 4): two hosts with the same rustc release line can still target
// different triples, run a different cargo, or interpret the operation through a different provider.
//   rustc_verbose     -- `rustc -vV` whole: release, commit hash, LLVM version and host triple
//   target_triple     -- the `host:` line of that output, the platform every built binary targets
//   cargo_version     -- `cargo --version` of the cargo the build actually runs
//   cache_release     -- the sccache release that wraps rustc
//   provider_revision -- the git tree of the compute provider's own source (dag/gunbc/compute) in the
//                        repository the provider runs from, which decides how an operation becomes a
//                        command without changing the subject tree
//
// THE PROVENANCE WALL IS NOT YET STRUCTURAL ON THE NATIVE ROUTE, and this says so rather than claiming
// a seal. sole_constructor and admit_callers are enforced by the seed; on the native route both are
// standing rung drops (gunbc.rung_drop admit_callers_discarded_on_the_native_route and
// g0_type_decl_modifier_parse_without_sealing_property), so there the mint below is callable by any
// declaration. The provider's observation fold is its only production caller.
type WorkToolchainIdentity sole_constructor {
  rustc_verbose: NonEmptyStr
  target_triple: NonEmptyStr
  cargo_version: NonEmptyStr
  cache_release: NonEmptyStr
  provider_revision: NonEmptyStr
}

fn work_toolchain_observed(
  rustc_verbose: NonEmptyStr,
  target_triple: NonEmptyStr,
  cargo_version: NonEmptyStr,
  cache_release: NonEmptyStr,
  provider_revision: NonEmptyStr,
) -> WorkToolchainIdentity
  admit_callers: [
    decl_ref(module_path: "gunbc.compute.work_provider_local", decl_name: "compute_toolchain_decide"),
    decl_ref(module_path: "test.claim.compute.work_request_witness_test", decl_name: "tc"),
    decl_ref(module_path: "test.claim.compute.attempt_lifecycle_wet_witness", decl_name: "fixture_toolchain"),
  ]
  = WorkToolchainIdentity {
    rustc_verbose: rustc_verbose,
    target_triple: target_triple,
    cargo_version: cargo_version,
    cache_release: cache_release,
    provider_revision: provider_revision,
  }

// The host triple a `rustc -vV` reports, read from its one `host: ` line; absent is a refusal.
fn rustc_verbose_host_triple(verbose: String) -> String? {
  match verbose.split(sep: "\n") |> filter(l => starts_with(s: l, prefix: "host: ")) |> first() {
    Present { value: l } => Present { value: trim(s: l.replace(from: "host: ", to: "")) }
    Absent => none
  }
}

// THERE IS NO work_identity HERE ANY MORE. It was a second key for one computation -- a private
// tagged hash beside std.materialization_provider's request_key -- and the identity of a compute
// request is now that provider's derived key over the ComputeWorkRequest family
// (gunbc.compute.work_provider_local compute_work_identity). This module keeps the work VOCABULARY;
// the materialization contract owns the key.

// One returned output: the declared path and the blob identity of its bytes (git's blob object id, a
// content hash the same authority every subject already uses). WHERE the bytes are held is not a
// field: it is a fact of one realization (the store's verified reading), and a location inside the
// committed record would make the record differ by where it was stored.
type WorkOutput {
  declared: String
  blob: String
}

// THE FIVE ENDINGS, and only five (compute-exact-work-contract's red control: a machine that killed
// the work cannot render as the work having failed). Every arm carries the identity so a caller can
// never attach a verdict to a different request.
// A CANCELLATION CARRIES WHY, and the arm was a bare identity until a real run made the gap
// visible. The only producer of this arm is a launch refused by the attempt gate -- somebody else
// ended this attempt before it spawned -- and an ending of "cancelled" with no cause cannot be
// told apart from any other cancellation by the caller who reads the document. The detail is in
// the durable outcome for the same reason every other arm's is: the next reader of this identity
// gets the same account the first caller got.
type WorkOutcome
  = WorkSucceeded { identity: String, outputs: List<WorkOutput>, log_path: String }
  | WorkFailed { identity: String, exit_code: Int, log_path: String }
  | WorkRefusedByInfrastructure { identity: String, cause: WorkInfrastructureRefusal }
  | WorkCancelled { identity: String, detail: String }
  | WorkOutputMismatch { identity: String, detail: String }

// Infrastructure refusals are typed and counted, never a widen: a producer already holds the lease
// (the caller attaches later, it does not start a second build), the host cannot back the memory
// this class reserves, the checkout or the store could not be prepared, or a dependency of this
// operation (the build the compile consumes) did not succeed.
//
// THE MEMORY ARMS CARRY Kibibyte, NOT Int FIELDS NAMED _kib. A unit in a field NAME on a bare Int
// is the unit modeled twice -- once in the name and once in the " KiB" this module then renders --
// and modeled nowhere the compiler can see. The producer already had it right
// (gunbc.compute.host_capacity ComputeHostBelowFloor carries Kibibyte) and the provider was calling
// kibibyte_count to STRIP the carrier on the way in, which is the tell (review 69624). The deleted
// arm this replaced, HostAtColdBuildCap { in_flight, cap }, was a dimensionless COUNT, so Int was
// right there and is not right here.
//
// THREE CAPACITY ARMS WHERE THERE USED TO BE ONE COUNT. HostAtColdBuildCap { in_flight, cap } is
// DELETED, and its disposition is that the fact it reported -- this host is already carrying as
// much as it may -- is now HostComputeCapacityFull, measured in the memory the pool actually
// appropriates rather than in producers. The other two are facts the count could not express at
// all and that a caller must not confuse with it: the machine's LIVE availability being below what
// this class needs is somebody else's memory, not this pool's commitments, and an unreadable
// ledger is a store repair. One arm for three remedies is the conflation DESIGN 5 forbids.
// A UNIT KILLED FOR MEMORY IS THE MACHINE ENDING THE WORK, NOT THE WORK FAILING, and it has its
// own arm for the reason this vocabulary has five endings rather than one: rendering an OOM kill as
// WorkFailed { exit_code: 137 } tells the caller to fix its code when the remedy is a larger
// reservation. The arm is reached only when no larger reservation remains -- a grant below the
// ceiling that is exceeded retries at the ceiling first (gunbc.compute.work_provider_local
// compute_run_opened), and that retry is counted per class.
type WorkInfrastructureRefusal
  = ProducerInFlight { lease_path: String }
  | HostComputeCapacityFull { wire: String }
  | HostBelowMemoryFloor { requested: Kibibyte, available: Kibibyte }
  | ComputeCapacityLedgerUnavailable { detail: String }
  | CheckoutUnavailable { detail: String }
  | StoreUnavailable { detail: String }
  | ToolchainUnobserved { detail: String }
  | DependencyNotSucceeded { dependency_identity: String, ending: String }
  | SubjectUnresolved { detail: String }
  | UnitMemoryGrantExceeded { class: String, granted: Kibibyte, peak_upper: Kibibyte?, grant_was_ceiling: Bool }
  | UnitEndingUnclassifiable { exit_code: Int, cause: String }
  | UnitLaunchRefused { cause: SystemdRunOptionWordsRefusedCause }

fn work_outcome_identity(o: WorkOutcome) -> String {
  match o {
    WorkSucceeded { identity, outputs: _, log_path: _ } => identity
    WorkFailed { identity, exit_code: _, log_path: _ } => identity
    WorkRefusedByInfrastructure { identity, cause: _ } => identity
    WorkCancelled { identity, detail: _ } => identity
    WorkOutputMismatch { identity, detail: _ } => identity
  }
}

// HOW A WORK OUTCOME ENDED, WITH ITS PAYLOAD DROPPED. It is the closed set the ending words were
// always drawn from, typed once so a reader that stores an ending (the attempt slot's terminal
// generation) decodes against the set rather than accepting any word. work_outcome_ending is its
// spelling, and work_ending_decode is the inverse of that one spelling, not a second vocabulary.
type WorkEnding
  = WorkEndedSucceeded
  | WorkEndedFailed
  | WorkEndedRefusedByInfrastructure
  | WorkEndedCancelled
  | WorkEndedOutputMismatch

fn work_outcome_ending_of(o: WorkOutcome) -> WorkEnding {
  match o {
    WorkSucceeded { identity: _, outputs: _, log_path: _ } => WorkEndedSucceeded
    WorkFailed { identity: _, exit_code: _, log_path: _ } => WorkEndedFailed
    WorkRefusedByInfrastructure { identity: _, cause: _ } => WorkEndedRefusedByInfrastructure
    WorkCancelled { identity: _, detail: _ } => WorkEndedCancelled
    WorkOutputMismatch { identity: _, detail: _ } => WorkEndedOutputMismatch
  }
}

fn work_ending_wire(e: WorkEnding) -> String {
  match e {
    WorkEndedSucceeded => "succeeded"
    WorkEndedFailed => "failed"
    WorkEndedRefusedByInfrastructure => "refused_by_infrastructure"
    WorkEndedCancelled => "cancelled"
    WorkEndedOutputMismatch => "output_mismatch"
  }
}

fn work_ending_decode(word: String) -> WorkEnding? {
  if word == work_ending_wire(e: WorkEndedSucceeded) { Present { value: WorkEndedSucceeded } }
  else if word == work_ending_wire(e: WorkEndedFailed) { Present { value: WorkEndedFailed } }
  else if word == work_ending_wire(e: WorkEndedRefusedByInfrastructure) { Present { value: WorkEndedRefusedByInfrastructure } }
  else if word == work_ending_wire(e: WorkEndedCancelled) { Present { value: WorkEndedCancelled } }
  else if word == work_ending_wire(e: WorkEndedOutputMismatch) { Present { value: WorkEndedOutputMismatch } }
  else { none }
}

fn work_outcome_ending(o: WorkOutcome) -> String {
  work_ending_wire(e: work_outcome_ending_of(o: o))
}

fn work_refusal_detail(r: WorkInfrastructureRefusal) -> String {
  match r {
    ProducerInFlight { lease_path } => join(["a producer already holds the lease at ", lease_path, "; attach later, do not start a second one"], "")
    HostComputeCapacityFull { wire } => join(["this host's compute memory pool has no room for another reservation: ", wire], "")
    HostBelowMemoryFloor { requested, available } => join(["this class reserves ", to_string(value: kibibyte_count(k: requested)), " KiB and the host reports only ", to_string(value: kibibyte_count(k: available)), " KiB available, so the reservation would not have been backed by the machine"], "")
    ComputeCapacityLedgerUnavailable { detail } => join(["the host's compute capacity ledger could not be transacted: ", detail], "")
    CheckoutUnavailable { detail } => join(["checkout unavailable: ", detail], "")
    StoreUnavailable { detail } => join(["store unavailable: ", detail], "")
    ToolchainUnobserved { detail } => join(["toolchain unobserved: ", detail], "")
    DependencyNotSucceeded { dependency_identity, ending } => join(["dependency ", dependency_identity, " ended ", ending], "")
    SubjectUnresolved { detail } => join(["subject unresolved: ", detail], "")
    UnitEndingUnclassifiable { exit_code, cause } =>
      join(["the unit exited ", to_string(value: exit_code), " and its ending could not be classified, so it is neither reported as failed nor as grant-exceeded: ", cause], "")
    UnitLaunchRefused { cause } =>
      join(["the unit was never launched: the systemd-run builder refused the invocation, so there is no exit to report: ", systemd_run_option_words_refused_cause_detail(cause: cause)], "")
    UnitMemoryGrantExceeded { class, granted, peak_upper, grant_was_ceiling } =>
      join(["the unit was OOM-killed at its memory grant: class ", class, " was granted ", to_string(value: kibibyte_count(k: granted)),
        " KiB and its manager reported a peak of ", match peak_upper { Present { value: k } => join(["at most ", to_string(value: kibibyte_count(k: k)), " KiB"], "")  Absent => "NOTHING (no Memory peak line was reported)" },
        if grant_was_ceiling { "; the grant was this host's ceiling, so no larger reservation exists to retry under" } else { "; the grant was below the ceiling and the retry at the ceiling was not taken -- the consumption record says why" }], "")
  }
}

fn work_output_json(o: WorkOutput) -> JsonValue {
  json_object(members: [
    json_kv(key: "declared", value: json_string(s: o.declared)),
    json_kv(key: "blob", value: json_string(s: o.blob)),
  ])
}

// The durable outcome document: what the store keeps beside the outputs and what the CLI prints.
fn work_outcome_json(o: WorkOutcome, subject: WorkSubject, op: WorkOperation) -> JsonValue {
  let tree = match subject { ExactTree { tree } => git_object_id_wire_hex(oid: tree) as String }
  let base = [
    json_kv(key: "ending", value: json_string(s: work_outcome_ending(o: o))),
    json_kv(key: "identity", value: json_string(s: work_outcome_identity(o: o))),
    json_kv(key: "subject_tree", value: json_string(s: tree)),
    json_kv(key: "operation", value: json_string(s: work_operation_canonical(op: op))),
  ]
  json_object(members: concat(base, match o {
    WorkSucceeded { identity: _, outputs, log_path } => [
      json_kv(key: "outputs", value: json_array(elements: map(outputs, x => work_output_json(o: x)))),
      json_kv(key: "log_path", value: json_string(s: log_path)),
    ]
    WorkFailed { identity: _, exit_code, log_path } => [
      json_kv(key: "exit_code", value: json_int(n: exit_code)),
      json_kv(key: "log_path", value: json_string(s: log_path)),
    ]
    WorkRefusedByInfrastructure { identity: _, cause } => [
      json_kv(key: "cause", value: json_string(s: work_refusal_detail(r: cause))),
    ]
    WorkCancelled { identity: _, detail } => [
      json_kv(key: "detail", value: json_string(s: detail)),
    ]
    WorkOutputMismatch { identity: _, detail } => [
      json_kv(key: "detail", value: json_string(s: detail)),
    ]
  }))
}

fn work_outcome_wire(o: WorkOutcome, subject: WorkSubject, op: WorkOperation) -> String {
  serialize_json(v: work_outcome_json(o: o, subject: subject, op: op))
}

// Reading a stored outcome back: what an attaching caller needs is the ending and the identity, and
// a document that does not carry both is unreadable, never "no outcome".
type StoredOutcomeRead
  = StoredOutcomeFound { ending: String, identity: String, document: String }
  | StoredOutcomeUnreadable { reason: String }

fn stored_outcome_member(doc: JsonValue, key: String) -> String? {
  match json_object_unique_member(v: doc, key: key) {
    JsonMemberFound { value } => match value { JsonString { value: s } => Present { value: s }  JsonNull => none  JsonBool { value: _ } => none  JsonNumber { lexeme: _ } => none  JsonArray { elements: _ } => none  JsonObject { members: _ } => none }
    JsonMemberAbsent => none
    JsonMemberDuplicated => none
    JsonMemberNotAnObject => none
  }
}

fn stored_outcome_decode(text: String) -> StoredOutcomeRead {
  match parse_json_document(s: text) {
    JsonDocumentUnreadable { gap } => StoredOutcomeUnreadable { reason: json_document_gap_text(gap: gap) }
    JsonDocumentParsed { value: doc } =>
      match stored_outcome_member(doc: doc, key: "ending") {
        Absent => StoredOutcomeUnreadable { reason: "stored outcome carries no string `ending`" }
        Present { value: ending } =>
          match stored_outcome_member(doc: doc, key: "identity") {
            Absent => StoredOutcomeUnreadable { reason: "stored outcome carries no string `identity`" }
            Present { value: identity } => StoredOutcomeFound { ending: ending, identity: identity, document: text }
          }
      }
  }
}

fn stored_outcome_is_success(r: StoredOutcomeRead) -> Bool {
  match r {
    StoredOutcomeFound { ending, identity: _, document: _ } => ending == "succeeded"
    StoredOutcomeUnreadable { reason: _ } => false
  }
}

// The exact tree a stored outcome document names. A verification receipt cites it, so the verified
// head and the compute subject are joined by the document the work itself wrote, not restated.
fn stored_outcome_subject_tree(document: String) -> String? {
  match parse_json_document(s: document) {
    JsonDocumentUnreadable { gap: _ } => none
    JsonDocumentParsed { value: doc } => stored_outcome_member(doc: doc, key: "subject_tree")
  }
}
