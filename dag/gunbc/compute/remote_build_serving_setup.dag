module gunbc.compute.remote_build_serving_setup

// PR 5 of the remote-build scaffold: the DESIRED STATE of the remote-build serving
// setup on one roster host, derived purely from the admitted model. This module owns
// NO SSH and NO actuation; it is the model the converger observes against and the
// witness claims against. The wet entrypoints that run observe/apply over fleet SSH
// live in gunbc.compute.remote_build_serving_converge and call into here.
//
// WHY A SEPARATE MODULE. clever-raven-401 performed this setup by hand on srv1 on
// 2026-11-15 (group, user, ledger, toolchain, checkout, seed binary, store, and the
// forced-command authorized_keys line). Those hand steps become a desired-state
// derivation here so the converger can ADOPT an existing correct host (plan shows
// no-op) and CONVERGE a fresh one, from one source of truth.
//
// EVERY FIELD IS READ FROM AN EXISTING AUTHORITY, never restated as a literal:
//   account  -> gunbc.fleet.fleet_posix_accounts (uid/gid/shell/home/supplementary)
//   paths    -> gunbc.compute.remote_build::remote_build_serving_instance
//   ledger   -> gunbc.compute.host_capacity::host_capacity_home_directories (PR 4)
//   ak line  -> gunbc.compute.remote_build_serve forced-command render (per host)
// The serve-time principal check (remote_build_serve_principal) is the contract the
// account shape must satisfy; a host whose forced-command line will not render is
// `none` here exactly as `remote_build_authorized_keys_lines` refuses it there.

import std.types { String, Bool, Int, List, NonEmptyStr }
import std.optional { Present, Absent }
import std.list { first_where }
import std.algebra { trim, skip }
import extdeps.linux.etc_group { etc_group_entries, etc_group_entry_named }

import product.host_identity { HostIdentity }
import gunbc.fleet.fleet_posix_accounts {
  fleet_posix_remote_build_user,
  fleet_posix_remote_build_home,
  fleet_posix_compute_ledger_group_name,
  fleet_posix_compute_ledger_group_gid,
  fleet_posix_remote_build_supplementary_groups,
}
import gunbc.compute.remote_build { remote_build_serving_instance, remote_build_candidates }
import gunbc.compute.host_capacity { host_capacity_home_directories }
import gunbc.owned_directory { OwnedDirectoryTarget, owned_directory_owner }
import gunbc.compute.remote_build_serve { remote_build_render_entry, RemoteBuildEntryRendered }
import extdeps.ssh.keys { authorized_key_entry_line }

// ---------------------------------------------------------------------------
// verdict vocabulary
// ---------------------------------------------------------------------------

// One item of the serving setup, judged against what was observed on the host.
// `Met` is a no-op; `Drifted`/`Missing` are the drift the apply must write; `Refused`
// is a host the converger must NOT touch (an unrenderable principal or forced command,
// a missing authority) — refuse, never guess.
type ServingItemVerdict
  = Met
  | Drifted { desired: String, observed: String }
  | Missing { desired: String }
  | Refused { reason: String }

fn serving_verdict_settled(v: ServingItemVerdict) -> Bool {
  match v {
    Met => true
    _ => false
  }
}

// Compare an observed string against the desired string: equal -> Met, unequal ->
// Drifted, unobserved -> Missing. The discriminating control for the witness lives in
// the caller: a wrong observed MUST yield Drifted, never Met.
fn serving_compare_string(desired: String, observed: String?) -> ServingItemVerdict {
  match observed {
    Absent => Missing { desired: desired }
    Present { value: o } => match o == desired {
      true => Met
      false => Drifted { desired: desired, observed: o }
    }
  }
}

// ---------------------------------------------------------------------------
// desired state, per host
// ---------------------------------------------------------------------------

// The full desired state of the remote-build serving setup on ONE host. Built only
// from the admitted model + a host identity; nothing here depends on SSH.
type RemoteBuildServingDesired {
  host: HostIdentity

  // component 1+2: the serving principal and its group.
  account_name: String
  account_uid: Int
  account_gid: Int
  account_home: String
  group_name: String
  group_gid: Int
  // gunbc-compute's required members: the host ledger's service user, then the account.
  group_members: List<String>
  // the account's supplementary groups, from the fleet's declared set.
  supplementary_groups: List<NonEmptyStr>

  // component 3: the host-scoped compute-capacity ledger (root + 03770 areas).
  ledger_dirs: List<OwnedDirectoryTarget>
  ledger_service_user: String

  // component 4: the rustup toolchain homes under the account home.
  cargo_home: String
  rustup_home: String

  // component 5: the public-repo checkout, https, detached at the admitted revision.
  checkout_dir: String
  // component 6: the seed binary installed for THIS host's architecture.
  serve_binary: String
  // component 7: the materialization store root + its staging sibling, 0755.
  store_root: String
  store_staging: String

  // component 8: the account's authorized_keys (mode 0600), and the single
  // forced-command line the host must carry. none when the host's line is
  // unrenderable — exactly the serve-time refusal, surfaced at plan time so a host
  // that cannot serve is refused, not half-written at apply.
  authorized_keys_path: String
  forced_command_line: String?
}

// The service user that must share the ledger group is read off the ledger's own area
// ownership (the first shared 03770 area is service-user : gunbc-compute owned), so the
// group membership and the ledger owner can never drift apart in the model.
fn serving_ledger_service_user(dirs: List<OwnedDirectoryTarget>) -> String {
  match first_where(dirs, _ => true) {
    Present { value: d } => owned_directory_owner(t: d).user as String
    Absent => ""
  }
}

// Render the account's authorized_keys forced-command line for the host, none when no
// candidate exists (an unadmitted host has no candidate, as the serve CLI skips it) or
// when the render itself refuses (unresolvable instance / repo).
fn serving_forced_command_line(host: HostIdentity) -> String? {
  let mine = filter(remote_build_candidates(), c => c.host == host)
  match first_where(mine, _ => true) {
    Absent => Absent
    Present { value: c } => match remote_build_render_entry(candidate: c) {
      RemoteBuildEntryRendered { entry } => Present { value: authorized_key_entry_line(e: entry) }
      _ => Absent
    }
  }
}

fn remote_build_serving_desired(host: HostIdentity) -> RemoteBuildServingDesired {
  let instance = remote_build_serving_instance(host: host)
  let home = fleet_posix_remote_build_home() as String
  let ledger = host_capacity_home_directories(host: host)
  let service_user = serving_ledger_service_user(dirs: ledger)
  {
    host: host,
    account_name: fleet_posix_remote_build_user.name as String,
    account_uid: fleet_posix_remote_build_user.uid,
    account_gid: fleet_posix_remote_build_user.gid,
    account_home: home,
    group_name: fleet_posix_compute_ledger_group_name as String,
    group_gid: fleet_posix_compute_ledger_group_gid,
    group_members: [service_user, fleet_posix_remote_build_user.name as String],
    supplementary_groups: fleet_posix_remote_build_supplementary_groups,
    ledger_dirs: ledger,
    ledger_service_user: service_user,
    cargo_home: concat(home, "/.cargo"),
    rustup_home: concat(home, "/.rustup"),
    checkout_dir: instance.repo_root as String,
    serve_binary: instance.serve_binary as String,
    store_root: concat(instance.instance_root as String, "/materialization-store"),
    store_staging: concat(instance.instance_root as String, "/materialization-store-staging"),
    authorized_keys_path: concat(home, "/.ssh/authorized_keys"),
    forced_command_line: serving_forced_command_line(host: host),
  }
}

// ---------------------------------------------------------------------------
// observation -> plan (the observe-only mode's core; consumed by the
// RemoteBuildServingObserve wet entrypoint, whose consumer is the plan receipt)
// ---------------------------------------------------------------------------

// What an observe pass READS off the host over fleet SSH. Every field is optional so
// an unobserved fact is distinguishable from an observed-but-wrong one (Missing vs
// Drifted) — the plan must never read "I did not look" as "it is correct".
type ServingObserved {
  account_uid: Int?
  account_gid: Int?
  // the members the host lists for the ledger group (from `getent group gunbc-compute`).
  group_members: List<String>?
  // the single forced-command line currently in authorized_keys.
  authorized_keys_line: String?
  store_root_present: Bool?
  store_staging_present: Bool?
  serve_binary_present: Bool?
  checkout_present: Bool?
  toolchain_present: Bool?
}

type ServingPlanItem { item: String, verdict: ServingItemVerdict }

fn serving_compare_int(desired: Int, observed: Int?) -> ServingItemVerdict {
  match observed {
    Absent => Missing { desired: "int" }
    Present { value: v } => match v == desired {
      true => Met
      false => Drifted { desired: "int", observed: "int" }
    }
  }
}

// A present-desired item (store dirs, seed binary, checkout, toolchain): unobserved ->
// Missing, observed-absent -> Drifted, observed-present -> Met.
fn serving_compare_present(observed: Bool?) -> ServingItemVerdict {
  match observed {
    Absent => Missing { desired: "present" }
    Present { value: p } => match p {
      true => Met
      false => Drifted { desired: "present", observed: "absent" }
    }
  }
}

// The ledger group must list EXACTLY the required members (service user + account):
// same membership and same count, so neither an extra nor a missing member reads Met.
fn serving_membership_verdict(members: List<String>, observed: List<String>?) -> ServingItemVerdict {
  match observed {
    Absent => Missing { desired: join(members, ",") }
    Present { value: ms } =>
      match all(members, m => any(ms, o => o == m)) && count(ms) == count(members) {
        true => Met
        false => Drifted { desired: join(members, ","), observed: join(ms, ",") }
      }
  }
}

// The forced-command line: a host whose line is unrenderable is REFUSED outright (a
// host that cannot serve must not be half-written); otherwise exact string equality.
fn serving_authorized_keys_verdict(desired: String?, observed: String?) -> ServingItemVerdict {
  match desired {
    Absent => Refused { reason: "the host's forced-command line is unrenderable; a host that cannot serve is refused, never written" }
    Present { value: d } => serving_compare_string(desired: d, observed: observed)
  }
}

// The plan: each serving component judged against the observation. A host srv1 already
// matches yields all-Met (the ADOPT case the converger must not rebuild); drift is the
// work the converge mode (PR5 b) will write.
fn serving_plan(d: RemoteBuildServingDesired, o: ServingObserved) -> List<ServingPlanItem> {
  [
    ServingPlanItem { item: "account.uid", verdict: serving_compare_int(desired: d.account_uid, observed: o.account_uid) },
    ServingPlanItem { item: "account.gid", verdict: serving_compare_int(desired: d.account_gid, observed: o.account_gid) },
    ServingPlanItem { item: "group.members", verdict: serving_membership_verdict(members: d.group_members, observed: o.group_members) },
    ServingPlanItem { item: "authorized_keys.forced_command", verdict: serving_authorized_keys_verdict(desired: d.forced_command_line, observed: o.authorized_keys_line) },
    ServingPlanItem { item: "store.root", verdict: serving_compare_present(o.store_root_present) },
    ServingPlanItem { item: "store.staging", verdict: serving_compare_present(o.store_staging_present) },
    ServingPlanItem { item: "seed.serve_binary", verdict: serving_compare_present(o.serve_binary_present) },
    ServingPlanItem { item: "checkout", verdict: serving_compare_present(o.checkout_present) },
    ServingPlanItem { item: "toolchain", verdict: serving_compare_present(o.toolchain_present) },
  ]
}

// Settled (all Met) is the no-op plan — an already-correct host is ADOPTED unchanged.
fn serving_plan_settled(plan: List<ServingPlanItem>) -> Bool {
  all(plan, i => serving_verdict_settled(i.verdict))
}

// Any refused item makes the whole host a refuse — never a partial write.
fn serving_plan_refused(plan: List<ServingPlanItem>) -> Bool {
  any(plan, i => match i.verdict { Refused { reason } => true, _ => false })
}

// ---------------------------------------------------------------------------
// readback: raw host reads -> the value-shaped ServingObserved
// ---------------------------------------------------------------------------
//
// The observe mode reads, over fleet SSH as the administrator principal, four raw
// facts the plan needs VALUE-compared (not merely present): /etc/passwd, /etc/group,
// and the account's authorized_keys, plus `test -d/-x` exit codes for the present-
// style items. It feeds them through THIS pure function so the wet receipt and the
// witness exercise one parsing code path — a host whose account exists with the wrong
// uid, or whose ledger group omits a member, cannot read Met here (a presence-only
// reading would; the serve entry would then refuse it at runtime, which is exactly the
// receipt-that-lies the design forbids). Parsers are the ones the serve path already
// trusts: etc_group for /etc/group, ':'-split + parse_int for /etc/passwd.

// The first ':'-separated field of a passwd row is the login name.
fn serving_passwd_row_is(login: String, name: String) -> Bool {
  match first(split(s: login, delimiter: ":")) {
    Present { value: f0 } => f0 == name
    Absent => false
  }
}

// The ':'-separated field at `index` of a passwd row, parsed to Int (uid is field 2,
// gid is field 3). Absent when the row or field is missing or is not a number.
fn serving_passwd_int_at(line: String, index: Int) -> Int? {
  match first(split(s: line, delimiter: ":") |> skip(n: index)) {
    Absent => Absent
    Present { value: raw } => parse_int(s: trim(s: raw))
  }
}

fn serving_passwd_uid(text: String?, name: String) -> Int? {
  match text {
    Absent => Absent
    Present { value: t } => match first(filter(split(s: t, delimiter: "\n"), l => serving_passwd_row_is(login: l, name: name))) {
      Absent => Absent
      Present { value: l } => serving_passwd_int_at(line: l, index: 2)
    }
  }
}

fn serving_passwd_gid(text: String?, name: String) -> Int? {
  match text {
    Absent => Absent
    Present { value: t } => match first(filter(split(s: t, delimiter: "\n"), l => serving_passwd_row_is(login: l, name: name))) {
      Absent => Absent
      Present { value: l } => serving_passwd_int_at(line: l, index: 3)
    }
  }
}

// The ledger group's members as observed: its /etc/group user_list. Both required
// members (the service user and the account) hold gunbc-compute as a SUPPLEMENTARY
// group, so — unlike a primary-group membership that may be omitted — both MUST appear
// in this list for the plan to read Met; that is what makes the membership comparison
// discriminating rather than permissive.
fn serving_group_members(text: String?, name: String) -> List<String>? {
  match text {
    Absent => Absent
    Present { value: t } => match etc_group_entry_named(entries: etc_group_entries(text: t), name: name as NonEmptyStr) {
      Absent => Absent
      Present { value: e } => Present { value: map(e.members, m => m as String) }
    }
  }
}

// The authorized_keys file, normalized to its trimmed content: the account must carry
// exactly the one forced-command line, so a trailing newline is not drift but a second
// line (or stray key) is, and both are caught by the exact equality the caller applies.
fn serving_authorized_keys_line(text: String?) -> String? {
  match text {
    Absent => Absent
    Present { value: t } => match trim(s: t) == "" {
      true => Absent
      false => Present { value: trim(s: t) }
    }
  }
}

// Assemble the observation from the raw reads. `passwd_text`/`group_text`/
// `authorized_keys_text` are the `cat` stdout of those files (Absent when the read
// itself failed, which must read Missing, never Met); the presence flags are the exit-
// code booleans of the observe `test` legs. Pure and total: no SSH, no effects.
fn serving_observed_from_reads(
  passwd_text: String?,
  group_text: String?,
  authorized_keys_text: String?,
  store_root_present: Bool?,
  store_staging_present: Bool?,
  serve_binary_present: Bool?,
  checkout_present: Bool?,
  toolchain_present: Bool?,
  account_name: String,
  group_name: String,
) -> ServingObserved {
  {
    account_uid: serving_passwd_uid(text: passwd_text, name: account_name),
    account_gid: serving_passwd_gid(text: passwd_text, name: account_name),
    group_members: serving_group_members(text: group_text, name: group_name),
    authorized_keys_line: serving_authorized_keys_line(text: authorized_keys_text),
    store_root_present: store_root_present,
    store_staging_present: store_staging_present,
    serve_binary_present: serve_binary_present,
    checkout_present: checkout_present,
    toolchain_present: toolchain_present,
  }
}
