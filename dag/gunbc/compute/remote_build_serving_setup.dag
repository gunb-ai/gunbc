import extdeps.tools.uname { uname_linux_machine_architecture }
import gunbc.fabric.fabric_executor_class { executor_host_architecture, HostArchitecture, HostArchitectureKnown, HostArchitectureUnclassified }
import extdeps.linux.etc_passwd { etc_passwd_entries, etc_passwd_entry_named }

import product.host_identity { HostIdentity }
// B2: the serve_binary_dir owner is READ from the instance root's owning authority (the service
// principal that owns /opt/gunbc), never restated as a literal here.
import gunbc.roadmap.roadmap_dashboard_instance { capacity_ledger_directory_owner }
import gunbc.fleet.fleet_posix_accounts {
  fleet_posix_remote_build_user,
  fleet_posix_remote_build_home,
  fleet_posix_compute_ledger_group_name,
  fleet_posix_compute_ledger_group_gid,
  fleet_posix_remote_build_supplementary_groups,
}
import gunbc.compute.remote_build { remote_build_serving_instance, RemoteBuildCandidate }
// The candidate row moved to the module that owns host membership for the serving route, so the live
// dispatch gate and the provisioned-candidate row are read side by side and host_capacity can answer the
// ledger posture from the same row (it cannot import THIS module: the setup reaches host_capacity).
import gunbc.compute.remote_build_hosts { remote_build_host_is_serving_candidate }
import gunbc.compute.host_capacity { host_capacity_home_directories_admitted, user_work_slice_memory_max_for_host, compute_root }
// The user-work slice ceiling authority (the reservation row, never a seat count) and the reader's own
// cgroup-cap judgment (unit_bounds::user_work_slice_cgroup_admission → observed_cgroup_bound) that
// serving_user_work_slice_deviations settles on, plus the slice's canonical unit name.
import gunbc.compute.unit_bounds { user_work_slice_cgroup_admission, UserWorkSliceAdmission, SliceCapped, SliceUncapped, SliceUnknown, UserWorkSliceUncappedReason, WhichMax, WhichHigh, WhichSwap }
import extdeps.linux.cgroup_v2_memory { CgroupMemoryLimitValue, CgroupMemoryLimited, CgroupMemoryUnlimited, CgroupMemoryLimitUnparseable }
import gunbc.live_deploy.slice_bounds { user_work_slice_unit_name, user_work_slice_memory_high_of, UserWorkSliceHighDerived, UserWorkSliceHighGapExceedsMax }
import std.measure { ByteSize, byte_size_count }
import gunbc.owned_directory { OwnedDirectoryTarget, owned_directory_owner, owned_directory_path, owned_directory_mode, owned_directory_mode_matches, OwnedDirectoryMode, OwnedDirectoryModeResolved, OwnedDirectoryModeRefused }
import extdeps.access.posix { file_mode_of_octal_text, file_mode_octal, FileMode, PosixLoginShell, LoginShellObserved, LoginShellUnobserved }
import gunbc.compute.remote_build_serve { remote_build_render_entry, RemoteBuildEntryRendered }
import gunbc.fleet.fleet_host_identity { operator_host_srv1, operator_host_srv2, operator_host_srv3, operator_host_srv4, operator_host_e2d4b7 }
