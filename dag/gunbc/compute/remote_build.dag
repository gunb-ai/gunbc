// ── REMOTE BUILD: RUN THE EXISTING LOCAL PROVIDER ON ANOTHER HOST ────────────────────────────────────
//
// WHAT THIS IS. A session's build, compile or claim run is served today only by the host the session
// is on: gunbc.compute.test_run snapshots the worktree to a commit and hands it to
// gunbc.compute.work_provider_local compute_provide with TargetIsExecutingHost. Everything that makes
// that provider safe -- subject resolution, toolchain admission, a memory reservation out of the host's
// ComputeBuildPool, a unit capped at that reservation, deduplication by work identity, a typed outcome
// and receipt -- is a property of the provider, not of where its caller sits. This module is the
// contract for asking the SAME provider on a different host: what is sent, to which hosts, and how the
// answer is read. It adds no second provider and no second capacity ledger.
//
// IT IS AN ADMITTED SCAFFOLD (gunbc.design_ruling::remote_build_ssh_dispatch_is_an_admitted_scaffold).
// The terminal route is the work-execution-redesign program's durable route (roadmap node
// work-exec-2-durable-route-first-consumer): durable acceptance, a fenced attempt on a scheduler, and a
// bound receipt. What dissolves when that lands is the TRANSPORT and the HOST ORDER below -- one SSH
// call per request against a fixed roster, tried in order. The request vocabulary, the source-shipping
// rule and the provider it reaches are meant to survive into that route.
//
// CONFORMANCE, STATED (gunbc.design_argument::conformance). Fabric / compute owns selection and
// placement of compute (product.fabric.selection select_supply). This module DIVERGES WITH A REASON:
// it picks the first roster host whose own provider admits the work, and a host's refusal for capacity
// sends the request to the next. That is not a selection over priced offers and does not claim to be;
// the selection belongs to the scheduler work-exec-1 chooses, and this order is deleted with the
// transport. The capacity authority is NOT bypassed: each host's ComputeBuildPool reservation, made by
// the provider on that host, is what admits or refuses.

// ── WHAT IS ASKED FOR ────────────────────────────────────────────────────────────────────────────────
//
// THE OPERATIONS A REMOTE REQUEST MAY CARRY are the two the session-side test and compile routes run
// (gunbc.compute.test_run): a hermetic claim run with no diff window, and a compile of one entry. They
// map onto gunbc.compute.work_request WorkOperation one-to-one below, so the provider sees exactly the
// operation the local route would have sent. BuildGunbcBinaries is not offered: its outputs are host
// binaries for the far host's architecture, and nothing on the requesting side consumes them.
//
// THE GATE SUBJECT IS THE THIRD, and it is the reason the route exists: the required CI gate's subject
// step for one gate row, run on a serving host. Its label is admitted as a typed Label by
// gunbc.emitted_subject_build_gate -- the module that OWNS the rows -- so a request cannot name a
// subject the gate does not have, and this adapter cannot be talked into running something else under
// the gate's name.
type RemoteBuildOperation
  = RemoteCompileEntry { entry: FilePath }
  | RemoteRunClaims { entry: FilePath, functions: List<NonEmptyStr> }
  | RemoteGateSubject { label: Label }

fn remote_build_work_operation(op: RemoteBuildOperation) -> WorkOperation {
  match op {
    RemoteCompileEntry { entry } => CompileEntry { entry: entry }
    RemoteRunClaims { entry, functions } =>
      RunClaims { entry: entry, functions: join(map(functions, f => f as String), ",") as NonEmptyStr, hermetic: true, window: none }
    RemoteGateSubject { label: l } => TestGateSubject { label: l }
  }
}

// THE SOURCE TRAVELS THROUGH ORIGIN, NOT THROUGH THE SSH CHANNEL. The provider never fetches: it
// resolves a commit that is already in its repo_root (gunbc.compute.work_provider_local
// compute_resolve_subject). The requester pushes its snapshot commit to a hidden ref on origin,
// refs/remote-build/<id>, and the serving host fetches that ref by name and admits it only if it
// resolves to the commit the request names. gunb-ai/gunbc is a public repository, so the fetch needs no
// credential on the serving host, and the SSH channel carries only words. Pushing the snapshot
// publishes the worktree's tracked and unignored files exactly as pushing a branch does.
type RemoteBuildSourceRef sole_constructor { id: NonEmptyStr }

data remote_build_source_ref_namespace: NonEmptyStr = "refs/remote-build/"

// An id is one portable word with no '/', so the ref it names is exactly one level under the
// namespace and cannot climb out of it.
fn remote_build_source_ref(id: String) -> RemoteBuildSourceRef? {
  if id.length() > 0 && typed_argv_portable_argv_token(token: id) && !id.contains("/") && id != "." && id != ".." {
    Present { value: RemoteBuildSourceRef { id: id as NonEmptyStr } }
  } else {
    none
  }
}

fn remote_build_source_ref_name(r: RemoteBuildSourceRef) -> NonEmptyStr {
  concat(remote_build_source_ref_namespace as String, r.id as String) as NonEmptyStr
}

// WHAT THE WORDS CARRY: the identity of the work to serve -- which commit, which source, which
// operation. It names no machine and asks no question about one, and it is what the serving host
// fetches and runs. This is the type the forced command's string decodes INTO, because a decode can
// only produce what the words carry.
type RemoteBuildWork {
  commit: GitObjectId
  source: RemoteBuildSourceRef
  operation: RemoteBuildOperation
}

// THE REQUEST, WHICH IS THE WORK PLUS WHAT RUNNING IT REQUIRES.
//
// A work's requirements are product.fabric.work's own record, not a remote-build re-spelling of it:
// the axes are already named there (product.fabric.work::ExecutionRequirements, whose envelope carries
// the instruction set as an extdeps.toolchain.types::Architecture), and a second carrier here would be
// a second place to be wrong about the same fact.
//
// THE REQUIREMENTS ARE NOT ON THE WIRE, AND THAT IS DELIBERATE. The serving side runs the account's
// installed bin/gunbc (gunbc.compute.remote_build_serve::remote_build_serve_request), NOT a binary
// built from the commit being fetched, so the words both sides speak are versioned by the account
// install and not by the request. Adding a word would make every host whose install predates the
// change refuse every request, which is a deployment skew dressed up as a protocol. The requirements
// are read where they are decided -- the client, before it places the request -- by
// gunbc.fabric.fabric_executor_class::admit_execution_class; what the serving host owes is its own
// admission, which its install already carries.
type RemoteBuildRequest {
  commit: GitObjectId
  source: RemoteBuildSourceRef
  operation: RemoteBuildOperation
  requirements: ExecutionRequirements
}

// THE WORDS' PROJECTION OF A REQUEST. The requirements are dropped exactly because the protocol does
// not carry them; nothing here may read the projection as the whole request.
fn remote_build_request_work(r: RemoteBuildRequest) -> RemoteBuildWork {
  RemoteBuildWork { commit: r.commit, source: r.source, operation: r.operation }
}

// WHAT A REMOTE BUILD REQUIRES, AUTHORED WHERE THE BUILD IS ASKED FOR.
//
// THE FLEET WRITES THIS, NOT THE HOST. It is our own claim about our own work -- a build of the corpus,
// under the control-plane account, in its own fresh worktree -- and it is the input
// gunbc.fabric.fabric_executor_class::admit_execution_class joins against the host's execution class.
// A host is never asked what it can do in order to be told what to require of it.
//
// THE ARCHITECTURE IS THE CALLER'S TO STATE, AND THE ONLY AXES HERE ARE THE ONES WITH A DECISION BEHIND
// THEM:
//
// - ControlPlaneCapacity, because a remote build compiles the corpus under the control-plane account
//   (remote_build_account) and runs no tenant's code: it is the fleet working on itself, which is what
//   gunbc.fabric.fabric_capacity_class_gap says belongs to control-plane and not to a marketplace class.
// - One thread, which is a FLOOR and not the build's width. What a build actually gets is its host's
//   build-pool reservation (remote_build_serving_instance's compute_build_memory_ceiling,
//   belt_max_concurrent), a fact of the instance row; stating a core count here would be a second,
//   contradicting reservation authored in the wrong place.
// - FreshWritableRoot, the one isolation guarantee the path actually gives: every attempt gets its own
//   worktree under the account's own home, so no build shares a working tree with another. No namespace
//   and no dedicated kernel is claimed, because nothing on the shared-OS serving path enforces one, and
//   a requirement written to look stronger than the mechanism is how a work item starts passing checks
//   nobody is performing.
// - RevocationAccepted: a build that never landed is disposable, and saying so keeps it out of the way
//   of work that cannot be interrupted.
//
// A caller that needs the artifact to be FOR a particular instruction set -- building a serve binary on
// one host to run on another is exactly that -- passes the architecture; a caller whose artifact runs
// where it was built passes Absent and any classified host may carry it.
fn remote_build_execution_requirements(architecture: Architecture?) -> ExecutionRequirements {
  ExecutionRequirements {
    capacity_class: ControlPlaneCapacity,
    shape: Shape {
      hard: HardRequirements { threads: hardware_thread_count(count: 1) },
      envelope: ResourceEnvelope {
        cpu: Present { value: CpuRequirement { min_threads: hardware_thread_count(count: 1), architecture: architecture } },
        gpu: none,
        memory: none,
        storage: none,
        network: none,
      },
    },
    capabilities: linux_rust_toolchain_capability,
    trust_domain: gunbc_internal_fleet_trust_domain,
    isolation: IsolationProfile { guarantees: [FreshWritableRoot] },
    revocation: RevocationAccepted,
  }
}

// ── THE WIRE: WORDS, BECAUSE A FORCED COMMAND RECEIVES ONE STRING ────────────────────────────────────
//
// sshd runs the key's forced command and hands the client's request to it only as
// SSH_ORIGINAL_COMMAND (extdeps.ssh.keys). So a request is a sequence of words joined by single spaces,
// every word admitted by gunbc.typed_argv_exec typed_argv_portable_argv_token: no space, quote,
// separator or expansion can appear in one, so splitting on " " is the exact inverse of joining, and
// the serving side never hands the string to a shell. Claim functions are separate words for the same
// reason (',' is outside the portable set).
//
//   remote-build-v1 <commit hex> <source ref id> compile <entry>
//   remote-build-v1 <commit hex> <source ref id> claims <entry> <function> [<function> ...]
//   remote-build-v1 <commit hex> <source ref id> gate <label>
//
// A gate label is ONE word: extdeps.bazel.label's grammar admits exactly the characters the portable
// set admits, so the canonical rendering of a Label is always one portable word, and a label that
// needs quoting was never a label.

data remote_build_compile_word: NonEmptyStr = "compile"
data remote_build_claims_word: NonEmptyStr = "claims"
data remote_build_gate_word: NonEmptyStr = "gate"

fn remote_build_operation_words(op: RemoteBuildOperation) -> List<String> {
  match op {
    RemoteCompileEntry { entry } => [remote_build_compile_word as String, entry as String]
    RemoteRunClaims { entry, functions } => concat([remote_build_claims_word as String, entry as String], map(functions, f => f as String))
    RemoteGateSubject { label } => [remote_build_gate_word as String, render_label(l: label)]
  }
}

fn remote_build_request_words(r: RemoteBuildWork) -> List<String> {
  concat(
    [remote_build_protocol_word as String, git_object_id_wire_hex(oid: r.commit) as String, r.source.id as String],
    remote_build_operation_words(op: r.operation),
  )
}

fn remote_build_request_text(r: RemoteBuildWork) -> String {
  join(remote_build_request_words(r: r), " ")
}

type RemoteBuildRequestRefusal
  = RequestNotThisProtocol { first_word: String }
  | RequestWordNotPortable { word: String }
  | RequestTooShort { word_count: Int }
  | RequestCommitNotAnObjectId { text: String }
  | RequestSourceRefInvalid { text: String }
  | RequestOperationUnknown { word: String }
  | RequestEntryOutsideCorpus { entry: String }
  | RequestCompileTakesOneEntry { word_count: Int }
  | RequestClaimsNameNoFunction
  // A gate request's operand is a LABEL, and two separate facts can be wrong about it: it may not be
  // a label at all (extdeps.bazel.label's grammar refuses it), or it may be a well-formed label that
  // is NOT a row of the required gate. Only the second is a statement about the gate's contents, so
  // they are separate causes, and neither is a silent substitution for the other.
  | RequestGateTakesOneLabel { word_count: Int }
  | RequestGateLabelUnparsable { text: String }
  | RequestGateLabelNotAGateRow { text: String }
  | RequestGateLabelAmbiguousRows { text: String, count: Int }

type RemoteBuildRequestDecode
  = RemoteBuildWorkDecoded { work: RemoteBuildWork }
  | RemoteBuildRequestRefused { cause: RemoteBuildRequestRefusal }

fn remote_build_word_at(words: List<String>, i: Int) -> String {
  match words |> skip(n: i) |> first {
    Present { value: w } => w
    Absent => ""
  }
}

// AN ENTRY IS A .dag FILE UNDER THE CORPUS ROOT, named relative to the repository, with no '..'
// segment: the serving side resolves it inside a worktree of the fetched commit and must not be able
// to name anything outside it.
fn remote_build_entry_admitted(entry: String) -> Bool {
  starts_with(s: entry, prefix: "dag/")
    && ends_with(s: entry, suffix: ".dag")
    && !(split(s: entry, delimiter: "/") |> any(seg => seg == ".." || seg == "." || seg == ""))
}

fn remote_build_first_unportable_word(words: List<String>) -> String? {
  words |> filter(w => !typed_argv_portable_argv_token(token: w)) |> first
}

fn remote_build_decode_request(text: String) -> RemoteBuildRequestDecode {
  let words = split(s: trim(text), delimiter: " ")
  match remote_build_first_unportable_word(words: words) {
    Present { value: w } => RemoteBuildRequestRefused { cause: RequestWordNotPortable { word: w } }
    Absent =>
      if count(words) < 5 {
        RemoteBuildRequestRefused { cause: RequestTooShort { word_count: count(words) } }
      } else {
        remote_build_decode_words(words: words)
      }
  }
}

fn remote_build_decode_words(words: List<String>) -> RemoteBuildRequestDecode {
  let protocol = remote_build_word_at(words: words, i: 0)
  let commit_text = remote_build_word_at(words: words, i: 1)
  let source_text = remote_build_word_at(words: words, i: 2)
  if protocol != (remote_build_protocol_word as String) {
    RemoteBuildRequestRefused { cause: RequestNotThisProtocol { first_word: protocol } }
  } else {
    match git_object_id_from_untagged_hex(hex: commit_text) {
      Absent => RemoteBuildRequestRefused { cause: RequestCommitNotAnObjectId { text: commit_text } }
      Present { value: commit } =>
        match remote_build_source_ref(id: source_text) {
          Absent => RemoteBuildRequestRefused { cause: RequestSourceRefInvalid { text: source_text } }
          Present { value: source } =>
            match remote_build_decode_operation(words: words |> skip(n: 3)) {
              RemoteBuildOperationRefused { cause } => RemoteBuildRequestRefused { cause: cause }
              RemoteBuildOperationDecoded { operation } =>
                RemoteBuildWorkDecoded { work: RemoteBuildWork { commit: commit, source: source, operation: operation } }
            }
        }
    }
  }
}

type RemoteBuildOperationDecode
  = RemoteBuildOperationDecoded { operation: RemoteBuildOperation }
  | RemoteBuildOperationRefused { cause: RemoteBuildRequestRefusal }

// THE VERB IS DISPATCHED FIRST, and the operand's SHAPE is adjudicated under its own verb. The entry
// corpus rule used to run ahead of the verb because every verb took an entry; a gate request's operand
// is a LABEL, and no .dag corpus rule can be applied to one. Keeping the entry check where it was would
// have refused a well-formed gate request with `the entry is not a .dag file`, which is not the fact
// about it -- and the ordering of the two remaining checks inside each verb is unchanged, so the
// existing red controls (a climbing path under compile, an unknown verb) still refuse as they did.
fn remote_build_decode_operation(words: List<String>) -> RemoteBuildOperationDecode {
  let verb = remote_build_word_at(words: words, i: 0)
  let entry = remote_build_word_at(words: words, i: 1)
  if verb == (remote_build_gate_word as String) {
    remote_build_decode_gate_subject(words: words, operand: entry)
  } else if !remote_build_entry_admitted(entry: entry) {
    RemoteBuildOperationRefused { cause: RequestEntryOutsideCorpus { entry: entry } }
  } else if verb == (remote_build_compile_word as String) {
    if count(words) == 2 {
      RemoteBuildOperationDecoded { operation: RemoteCompileEntry { entry: entry as FilePath } }
    } else {
      RemoteBuildOperationRefused { cause: RequestCompileTakesOneEntry { word_count: count(words) } }
    }
  } else if verb == (remote_build_claims_word as String) {
    let functions = words |> skip(n: 2)
    if count(functions) == 0 {
      RemoteBuildOperationRefused { cause: RequestClaimsNameNoFunction }
    } else {
      RemoteBuildOperationDecoded { operation: RemoteRunClaims { entry: entry as FilePath, functions: map(functions, f => f as NonEmptyStr) } }
    }
  } else {
    RemoteBuildOperationRefused { cause: RequestOperationUnknown { word: verb } }
  }
}

// A GATE SUBJECT IS ADOPTED ONLY BY THE MODULE THAT OWNS THE ROWS. Three separate facts can fail, and
// they are three causes because a requester needs to know which one moved: the verb took more or fewer
// than one operand; the operand is not a label at all under extdeps.bazel.label's grammar; or it is a
// well-formed label that is NOT a row of the required gate. The third is the one the gate's own
// authority answers -- gunbc.emitted_subject_build_gate::emitted_subject_build_rows is what says which
// subjects the gate has -- so this adapter never decides for itself what counts as a gate subject, and
// a label that is a perfectly good INSTRUMENT but not a gate ROW is refused here rather than run.
fn remote_build_decode_gate_subject(words: List<String>, operand: String) -> RemoteBuildOperationDecode {
  if count(words) != 2 {
    RemoteBuildOperationRefused { cause: RequestGateTakesOneLabel { word_count: count(words) } }
  } else {
    match parse_label(text: operand) {
      LabelRefused { cause: _ } => RemoteBuildOperationRefused { cause: RequestGateLabelUnparsable { text: operand } }
      LabelParsed { label: label } =>
        match remote_build_gate_row_refusal(text: render_label(l: label), lookup: emitted_subject_build_row_for_label(l: label)) {
          Present { value: cause } => RemoteBuildOperationRefused { cause: cause }
          Absent => RemoteBuildOperationDecoded { operation: RemoteGateSubject { label: label } }
        }
    }
  }
}

// WHICH REFUSAL A ROW LOOKUP MEANS, ANSWERED WHERE THE LOOKUP'S ARMS CAN BE SEPARATE. The lookup has
// three answers and the request side must be able to tell a label the gate does not have from a gate
// that names one subject twice: the first is the requester's fact, the second is THIS repository's
// defect, and collapsing them blames the wrong party. Split out as a function so the distinction has a
// witness of its own -- the duplicate cannot be provoked from outside a closed table.
fn remote_build_gate_row_refusal(text: String, lookup: EmittedSubjectRowLookup) -> RemoteBuildRequestRefusal? {
  match lookup {
    EmittedSubjectOneRow { row: _ } => none
    EmittedSubjectNoRow => Present { value: RequestGateLabelNotAGateRow { text: text } }
    EmittedSubjectDuplicateRows { count } => Present { value: RequestGateLabelAmbiguousRows { text: text, count: count } }
  }
}

fn remote_build_request_refusal_text(cause: RemoteBuildRequestRefusal) -> String {
  match cause {
    RequestNotThisProtocol { first_word } => concat("not a remote-build-v1 request; first word: ", first_word)
    RequestWordNotPortable { word } => concat("a request word is outside the portable set [A-Za-z0-9._-/@:=]: ", word)
    RequestTooShort { word_count } => concat("a request needs at least five words; saw ", to_string(value: word_count))
    RequestCommitNotAnObjectId { text } => concat("the commit word is not a git object id: ", text)
    RequestSourceRefInvalid { text } => concat("the source ref id is not one portable word without '/': ", text)
    RequestOperationUnknown { word } => concat("unknown operation (compile, claims or gate): ", word)
    RequestEntryOutsideCorpus { entry } => concat("the entry is not a .dag file under dag/ without '.' or '..' segments: ", entry)
    RequestCompileTakesOneEntry { word_count } => concat("compile takes exactly one entry; operation words: ", to_string(value: word_count))
    RequestClaimsNameNoFunction => "a claims request names no function"
    RequestGateTakesOneLabel { word_count } => concat("a gate request takes exactly one label; operation words: ", to_string(value: word_count))
    RequestGateLabelUnparsable { text } => concat("the gate operand is not a canonical //package:target label: ", text)
    RequestGateLabelNotAGateRow { text } => concat("the label is not a row of the required gate's emitted subject rows: ", text)
    RequestGateLabelAmbiguousRows { text, count } => concat("the gate's rows name this label ", to_string(value: count), " times -- a defect in the gate table, not in the request: ", text)
  }
}

// THE FETCHED REF MUST BE THE COMMIT ASKED FOR. A ref on origin can be moved by anyone who can push;
// the request's commit is what the requester snapshotted, so the serving side runs that commit or
// refuses, never whatever the ref points at by the time it is fetched.
type RemoteBuildSourceAdmission
  = RemoteBuildSourceMatches
  | RemoteBuildSourceMoved { requested: NonEmptyStr, fetched: NonEmptyStr }

// WHAT THE SERVING HOST MAY TRUST IT FETCHED. The work's identity is what the words named and what the
// fetch produced; the requirements are not here, because the serving host does not place work and has no
// use for them (see RemoteBuildRequest for why they are not on the wire).
fn remote_build_admit_fetched_source(work: RemoteBuildWork, fetched: GitObjectId) -> RemoteBuildSourceAdmission {
  if git_object_id_eq(left: work.commit, right: fetched) {
    RemoteBuildSourceMatches
  } else {
    RemoteBuildSourceMoved { requested: git_object_id_wire_hex(oid: work.commit), fetched: git_object_id_wire_hex(oid: fetched) }
  }
}

// ── WHO SERVES ───────────────────────────────────────────────────────────────────────────────────────
//
// THE ROSTER IS ONE SERVING INSTANCE PER SERVING HOST, OWNED BY THE REMOTE-BUILD ACCOUNT. A request runs
// as gunbc.fleet.fleet_posix_accounts fleet_posix_remote_build_user, never as the operator (operator,
// 2026-11-15), so the instance it is served from is that account's: its own checkout, store, toolchain
// and binary under its home. Which hosts serve is gunbc.compute.remote_build_hosts, the row the host's
// capacity ledger reads too, so a host on the roster is a host whose ledger admits this account.
//
// srv3, srv4, srv14 (butch) and srv15 (bobo) join by joining that row, once their ledger has a home this
// account can reach (remote_build_hosts says why srv2 and they do not yet), and each will carry its own
// build-pool reservation carved from its CI runner width.
type RemoteBuildHostRow {
  instance: HostDashboardInstance
}

// THE SERVING INSTANCE. It follows the fleet hermetic compute row (gunbc.roadmap.roadmap_dashboard_instance
// fleet_compute_hermetic_dashboard_instance_at), the existing instance that serves the provider and no
// dashboard, and DIVERGES from it only where this one is durable: the store is a persistent workspace,
// not a frame. Like that row it is not a public built-in, so no host, repo-root or id lookup resolves it;
// the serving entry finds it on this roster by host. CONFORMANCE, stated: HostDashboardInstance also
// carries a dashboard's serving fields (listen port, serve function, tmux server, provider state), which
// this instance never serves -- it is observe-only and nothing listens -- and they are filled as the
// hermetic row fills them, inert, rather than by a second instance type the provider does not take.
//
// THE TOOLCHAIN is the account's own rustup homes, read through the hermetic row's constructor, which
// derives every Rust shim from the two homes and names no PATH. The serve binary is the account's own
// build, installed under its instance root.
fn remote_build_account_home() -> FilePath {
  fleet_posix_remote_build_home() as FilePath
}

fn remote_build_serving_instance_id(host: HostIdentity) -> NonEmptyStr {
  join(["remote-build-", host as String], "") as NonEmptyStr
}

fn remote_build_serving_deployment(host: HostIdentity) -> DeploymentId {
  deployment_id(name: remote_build_serving_instance_id(host: host))
}

fn remote_build_serving_instance(host: HostIdentity) -> HostDashboardInstance {
  let instance_root = persistent_instance_scope_root(scope: RemoteBuildServing) as FilePath
  let repo_root = dashboard_instance_child(root: remote_build_account_home(), child: "gunbc")
  let toolchain = fleet_compute_hermetic_toolchain(homes: IsolatedJobToolchainHomes {
    cargo_home: dashboard_instance_child(root: remote_build_account_home(), child: ".cargo"),
    rustup_home: dashboard_instance_child(root: remote_build_account_home(), child: ".rustup"),
  })
  let serve_binary = dashboard_instance_child(root: instance_root, child: "bin/gunbc")
  let id = remote_build_serving_instance_id(host: host)
  HostDashboardInstance {
    deployment: remote_build_serving_deployment(host: host),
    instance_id: id,
    host_identity: host as String as NonEmptyStr,
    provision_parent_root: dashboard_instance_child(root: remote_build_account_home(), child: ".local/share"),
    instance_root: instance_root,
    local_origin_root: repo_root,
    local_origin_publish_ref: "refs/heads/main" as NonEmptyStr,
    repo_root: repo_root,
    dispatch_base_ref: "origin/main" as NonEmptyStr,
    publication_base_branch: "main" as NonEmptyStr,
    dispatch_state_scope: DispatchStateInstanceOwned {
      worktree_child: "attempts" as NonEmptyStr,
      attempt_state_child: "attempt-state" as NonEmptyStr,
    },
    execution_environment: dashboard_execution_environment_for_toolchain(toolchain: toolchain, serve_binary: serve_binary),
    provider_state: DashboardExistingProviderState {
      root: dashboard_instance_child(root: instance_root, child: "codex"),
      executable: none,
      binding: admitted_single_session_binding(selection: CodexDefaultAccount, evidence: codex_roadmap_account_evidence),
    },
    serve_binary: serve_binary,
    // The name the serving route runs, read from the wire module that renders the command which carries
    // it -- the two spellings cannot now drift apart.
    serve_function: remote_build_serve_cli_function,
    listen_host: "127.0.0.1" as NonEmptyStr,
    listen_port: 18085,
    tmux_server: dashboard_named_tmux_server(instance_id: id),
    actuation: DashboardObserveOnly,
    actuator_host: host as String as NonEmptyStr,
    source_seed: DashboardExistingRepo { anchor_ref: "origin/main" as NonEmptyStr },
    admitted_revision: fleet_admitted_revision_source,
    toolchain: toolchain,
    dispatch_worker_memory_max: dispatch_worker_memory_ceiling,
    compute_build_memory_ceiling: compute_build_memory_ceiling_default,
    belt_obligation_memory_max: belt_obligation_memory_max_default,
    belt_reviewer_memory_max: belt_reviewer_memory_max_default,
    belt_max_concurrent: belt_max_concurrent_default,
    directory_owner: PosixOwnerNames { user: fleet_posix_remote_build_user.name, group: fleet_posix_remote_build_user.name },
    worker: WorkerIsServiceUser,
    materialization_store_root: Present { value: PersistentInstanceWorkspace { scope: RemoteBuildServing } },
  }
}

fn remote_build_host_rows() -> List<RemoteBuildHostRow> {
  remote_build_serving_hosts() |> map(h => RemoteBuildHostRow { instance: remote_build_serving_instance(host: h) })
}

type RemoteBuildCandidate {
  host: HostIdentity
  instance: HostDashboardInstance
}

type RemoteBuildHostStanding
  = RemoteBuildHostAdmitted { candidate: RemoteBuildCandidate }
  | RemoteBuildHostWithoutStore { host: HostIdentity, instance_id: String }

fn remote_build_host_standing(row: RemoteBuildHostRow) -> RemoteBuildHostStanding {
  match row.instance.materialization_store_root {
    Absent => RemoteBuildHostWithoutStore { host: row.instance.host_identity as HostIdentity, instance_id: row.instance.instance_id as String }
    Present { value: _ } => RemoteBuildHostAdmitted { candidate: RemoteBuildCandidate { host: row.instance.host_identity as HostIdentity, instance: row.instance } }
  }
}

fn remote_build_candidates() -> List<RemoteBuildCandidate> {
  remote_build_host_rows()
    |> map(row => remote_build_host_standing(row: row))
    |> flat_map(s => remote_build_admitted_candidates(standing: s))
}

fn remote_build_admitted_candidates(standing: RemoteBuildHostStanding) -> List<RemoteBuildCandidate> {
  match standing {
    RemoteBuildHostAdmitted { candidate } => [candidate]
    RemoteBuildHostWithoutStore { host: _, instance_id: _ } => []
  }
}

// THE HOST PIN -- an operator's or a hosted runner's choice to send ONE request to ONE named
// host, rather than letting the walk pick. It is a typed refusal carrier: resolving a pin either
// lands the host on the DISPATCH roster (remote_build_serving_hosts -- the live dispatch gate,
// gunbc.design_ruling::remote_build_ssh_dispatch_is_an_admitted_scaffold) or it does not, and a
// host that is NOT on that roster is refused by name -- NEVER silently widened back out to the
// whole roster. A host that is only on the CANDIDATE row (remote_build_serving_candidate_hosts)
// is exactly such a refusal: it may hold a checkout, but the dispatch gate does not admit it, so
// pinning to it must stop AT the pin rather than fall through to srv3/srv4.
type RemoteBuildHostPin
  = PinRostered { host: HostIdentity }
  | PinOffRoster { pin: String, roster: List<HostIdentity> }

// Resolve an optional `--arg host=` against the DISPATCH roster, the ONLY authority that says a
// host may be dispatched to. Absent text means no pin -- the ordinary roster walk. A host the
// roster admits becomes PinRostered so exactly it is tried; anything else -- a candidate-only host
// (srv1/srv2/ken), a typo, a name not on the roster at all -- is PinOffRoster, which the caller
// turns into a self-explaining refusal. It is a carrier, not a throw: the caller must handle both.
fn remote_build_host_pin(text: String?) -> RemoteBuildHostPin? {
  match text {
    Absent => none
    Present { value: pinned } =>
      let roster = remote_build_serving_hosts()
      match roster |> filter(h => h as String == pinned) |> first {
        Present { value: admitted } => Present { value: PinRostered { host: admitted } }
        Absent => Present { value: PinOffRoster { pin: pinned, roster: roster } }
      }
  }
}

// THE ROSTER WALKED FOR ONE REQUEST. No pin walks the whole roster, in roster order -- identical
// to remote_build_candidates(), so the existing selection claims keep their route. A rostered pin
// walks EXACTLY that one host (never the whole roster, never a second host); an off-roster pin
// walks nothing at all, so even if a caller forgot to refuse it first the walk can never dispatch.
fn remote_build_pinned_candidates(pin: RemoteBuildHostPin?) -> List<RemoteBuildCandidate> {
  let roster = remote_build_candidates()
  match pin {
    Absent => roster
    Present { value: PinRostered { host } } => roster |> filter(c => c.host == host)
    Present { value: PinOffRoster { pin: _, roster: _ } } => []
  }
}

// THE REFUSAL, self-explaining on the receipt: it names BOTH the pin that was refused AND the
// roster that was checked, so a reader sees which host was asked for and against which gate it
// failed -- without having to re-derive the roster from the source.
fn remote_build_pin_refusal(pin: String, roster: List<HostIdentity>) -> String {
  let names = roster |> map(h => h as String) |> join(", ")
  join(["host pin \"", pin, "\" is not on the remote-build DISPATCH roster (", names,
        "); a pinned host must be on the roster itself -- pinning never falls through to the whole roster"], "")
}

// ── WHICH HOST NEXT ──────────────────────────────────────────────────────────────────────────────────
//
// What one host answered. A full pool, a host that cannot serve (its checkout, store or toolchain) and
// an unreachable host send the request on; everything else is the answer. Unreachable and cannot-serve
// are only ever concluded BEFORE work could have started (the probe, below); once a request has been
// sent, a transport that cannot say what happened is HostOutcomeUnknown, which is final -- the first
// host may still be producing, and a second host would be a second producer (side-chat review F2). A compile or claim FAILURE
// is the work's own result and is never retried elsewhere (the same work fails the same way); the same
// work already in flight on a host is answered there, because starting it elsewhere would be a second
// producer of one identity; and a refusal the request itself caused is final.
type RemoteBuildHostAnswer
  = HostServed { receipt: String }
  | HostWorkFailed { receipt: String }
  | HostWorkInFlight { receipt: String }
  | HostCapacityFull { detail: String }
  | HostCannotServe { detail: String }
  | HostUnreachable { detail: String }
  | HostRefusedRequest { detail: String }
  | HostOutcomeUnknown { detail: String }
  // A LEG THAT RAN OUT OF ITS WALL CLOCK. This arm exists because an overrun is not an answer: the
  // transport's own exit code after a kill (ssh answers 255) must never be routed as though the host
  // had replied, which is what a client reading raw exit codes does (review 96994). It is only ever
  // produced by a PROBE leg -- a probe names no work, so nothing can have started, and the host is
  // simply not established reachable within the ceiling it was given. A REQUEST leg that overruns is
  // HostOutcomeUnknown, because the work may have started there.
  // The ceiling is carried as std.measure's Second, the unit the authority mints it in: an Int here
  // would flatten a measured quantity into an unqualified number at the boundary between the model and
  // its receipt (review 96999).
  | HostLegOverran { deadline: Second }
  // THE EXECUTOR CLASS REFUSED THE REQUEST BEFORE IT WAS TOUCHED. This is the only answer here that
  // is concluded from the request's REQUIREMENTS rather than from anything the host said: nothing was
  // probed, nothing was connected to, nothing was pushed. It carries fabric's own verdict, not a
  // string the walk invented, so a reader can see which architecture the work asked for and which the
  // host runs; the detail is that verdict rendered for the ledger, produced by
  // gunbc.fabric.fabric_executor_class::execution_class_admission_wire and never re-spelled here.
  | HostExecutionClassRefused { admission: ExecutionClassAdmission, detail: String }

type RemoteBuildAttempt {
  host: HostIdentity
  answer: RemoteBuildHostAnswer
}

type RemoteBuildStep
  = RemoteBuildTryHost { candidate: RemoteBuildCandidate }
  | RemoteBuildAnswered { host: HostIdentity, answer: RemoteBuildHostAnswer }
  | RemoteBuildNoHostAvailable { attempts: List<RemoteBuildAttempt> }

fn remote_build_answer_moves_on(a: RemoteBuildHostAnswer) -> Bool {
  match a {
    HostServed { receipt: _ } => false
    HostWorkFailed { receipt: _ } => false
    HostWorkInFlight { receipt: _ } => false
    HostCapacityFull { detail: _ } => true
    HostCannotServe { detail: _ } => true
    HostUnreachable { detail: _ } => true
    HostRefusedRequest { detail: _ } => false
    HostOutcomeUnknown { detail: _ } => false
    // Nothing was sent on a probe that overran, so the next candidate is tried; the overrun is in the
    // attempt record either way.
    HostLegOverran { deadline: _ } => true
    // A host that cannot execute the work says nothing about the NEXT host, which is exactly why the
    // roster exists. The wrong-architecture refusal moves on; it is not the request's fault and the
    // work has not started anywhere.
    HostExecutionClassRefused { admission: _, detail: _ } => true
  }
}

// The step is a pure reading of what has been tried, so the client's loop is "ask, then step" and
// the order has one home. Candidates are tried once each, in roster order.
fn remote_build_next_step(candidates: List<RemoteBuildCandidate>, attempts: List<RemoteBuildAttempt>) -> RemoteBuildStep {
  match attempts |> filter(a => !remote_build_answer_moves_on(a: a.answer)) |> first {
    Present { value: settled } => RemoteBuildAnswered { host: settled.host, answer: settled.answer }
    Absent =>
      match candidates |> skip(n: count(attempts)) |> first {
        Present { value: c } => RemoteBuildTryHost { candidate: c }
        Absent => RemoteBuildNoHostAvailable { attempts: attempts }
      }
  }
}

// ── WHERE A REQUEST MAY BE PLACED ────────────────────────────────────────────────────────────────────
//
// THE FABRIC CHECK, APPLIED TO ONE CANDIDATE BEFORE ANYTHING IS ASKED OF IT. A host whose
// gunbc.fabric.fabric_executor_class execution row refuses the request's requirements is answered
// without a probe, a connection or a push; every other candidate is left alone for the walk to try as
// it always has.
//
// This is the whole of the placement policy this lane adds, and it is a REFUSAL and not a choice: it
// removes hosts the fleet's own authority says cannot run the work, and never ranks, prefers, or
// reorders what remains. Which of the admitted hosts goes first stays the roster order under
// gunbc.design_ruling::remote_build_ssh_dispatch_is_an_admitted_scaffold, until work-exec-2's
// select_supply replaces both.
fn remote_build_host_placement(
  requirements: ExecutionRequirements,
  classes: List<ExecutorExecutionClass>,
  host: HostIdentity,
) -> Optional<RemoteBuildHostAnswer> {
  let admission = admit_execution_class(requirements: requirements, roster: classes, host: host)
  match admission {
    // The host executes what the work needs; nothing to say about it, and the walk proceeds as it
    // always has -- this function adds a refusal, never a permission the roster did not already give.
    ExecutionClassAdmitted { host: _, host_arch: _ } => Absent
    // The verdict is carried, not paraphrased: the answer holds fabric's own admission and the ledger
    // line rendered FROM it, so the walk cannot restate the reason into something softer.
    _ =>
      Present {
        value: HostExecutionClassRefused {
          admission: admission,
          detail: execution_class_admission_wire(admission: admission),
        },
      }
  }
}

// THE HOSTS THE WALK MAY TOUCH, in roster order. The refused ones are not hidden: the walk records a
// typed refusal for each, and this function only answers the question the run asks before it pushes.
fn remote_build_admissible_hosts(
  requirements: ExecutionRequirements,
  classes: List<ExecutorExecutionClass>,
  hosts: List<HostIdentity>,
) -> List<HostIdentity> {
  hosts |> filter(h => match remote_build_host_placement(requirements: requirements, classes: classes, host: h) {
    Absent => true
    Present { value: _ } => false
  })
}

// IS THERE ANYWHERE TO PLACE THIS AT ALL? Answered before the snapshot is pushed, because a run that
// can only end in a refusal by every host on the roster should not have published a commit to get
// there: no ref, no push, no connection, no snapshot on any host.
fn remote_build_any_host_admits(
  requirements: ExecutionRequirements,
  classes: List<ExecutorExecutionClass>,
  hosts: List<HostIdentity>,
) -> Bool {
  count(remote_build_admissible_hosts(requirements: requirements, classes: classes, hosts: hosts)) > 0
}

// ── THE KEY ──────────────────────────────────────────────────────────────────────────────────────────
//
// A DEDICATED KEY, NOT THE FLEET ROSTER. gunbc.fleet.fleet_ssh_access fleet_authorized_keys admits a
// principal on every installed machine with administrator reach and carries no options, so a session
// key there would be an administrator key handed to branch code. This key is authorized only on the
// roster hosts' provider accounts, with a forced command that runs the serving entry and nothing else
// (extdeps.ssh.keys ForcedCommandOption, as gunbc.host.boot_medium_reader_key does).
//
// MINTED BY THE OPERATOR, 2026-11-14. The private half is in Secret Manager under this name, and a copy is
// at ~/.ssh/gunbc-remote-build on the session hosts (srv1, srv2), mounted read-only into sessions; the
// operator relayed the public half and its fingerprint, and the session-side file was read here to the
// same fingerprint. The secret VERSION was not relayed and is not guessed: it stays pending until a read
// of the secret names it. Secret Manager names a project by number or by id interchangeably
// (extdeps.cloud.gcp.secret_ref), so this row is matched by secret name, never by its project string.
data remote_build_ssh_privkey_secret: SecretRef = SecretRef {
  project: fleet_secrets_gcp_project,
  secret: "gunbc-remote-build-ssh-key" as NonEmptyStr,
  version: "pending",
  hash_state: HashPending,
}

data remote_build_key_comment: String = "gunbc-remote-build"

data remote_build_ssh_key: SshPublicKey = SshPublicKey {
  algorithm: Ed25519,
  material: "AAAAC3NzaC1lZDI1NTE5AAAAICKSfnSqPrsJkFqMLKfJ8UsxmrwpghUJD89PGp/tZWk1",
  comment: remote_build_key_comment,
}

// The fingerprint as the operator relayed it and as ssh-keygen -lf printed it for the session copy;
// a witness derives it from the material, so a mistyped key and a mistyped fingerprint cannot agree.
data remote_build_ssh_key_fingerprint: NonEmptyStr = "SHA256:k67OfQZ5M/BbWBDP2QqAPPPpqs8xW21IA2VsgF81aW8"

// ── ADMITTED REMOTE-BUILD CLIENT KEYS ─────────────────────────────────────────────────────────────────
//
// The gunbc-build forced-command account admits a CLOSED LIST of client keys. Each renders through the
// same restrict + forced-command entry (gunbc.compute.remote_build_serve::remote_build_authorized_entry);
// the account's authorized_keys is that list rendered and NOTHING ELSE (no hand-added keys). This is the
// admitted-scaffold path (gunbc.design_ruling::remote_build_ssh_dispatch_is_an_admitted_scaffold) — NOT
// the fleet roster (fleet_ssh_access.dag): these keys must never grant fleet admin reach.
//
// WHO MINTS EACH KEY:
//   operator  — the operator host (the existing key, minted outside any custody system before this model)
//   session   — ctrl mints; the private half never leaves ctrl's custody; gentle-crab-832 owns provisioning
//   hosted-ci — ctrl minted it (gentle-crab-832); the operator stores the private half in Secret Manager
//               (remote_build_ci_ssh_privkey_secret). NEVER a GitHub Actions secret; see the custody note.
//
// Each new member lands in the change that carries its REAL public half (clever-raven-401, 2026-11-19:
// a placeholder public key is a fabricated value; an admission list carrying one is worse than a shorter
// list — gunbc.design_argument::fail_closed).
type RemoteBuildClientKey {
  label: NonEmptyStr
  public_key: SshPublicKey
  fingerprint: NonEmptyStr
}

// The operator key — the existing scaffold key (see the provenance doc on remote_build_ssh_key above).
data remote_build_client_key_operator: RemoteBuildClientKey = RemoteBuildClientKey {
  label: "operator",
  public_key: remote_build_ssh_key,
  fingerprint: remote_build_ssh_key_fingerprint,
}

// The session key — minted by ctrl (gentle-crab-832), private half in the dashboard secret store,
// provisioned per-container by the ctrl session image at $HOME/.config/ctrl/remote-build/id_ed25519.
data remote_build_client_key_session: RemoteBuildClientKey = RemoteBuildClientKey {
  label: "session",
  public_key: SshPublicKey {
    algorithm: Ed25519,
    material: "AAAAC3NzaC1lZDI1NTE5AAAAIPIuf7p1w+jsp+zluvCE/IOtG1rHrZW3iIsuhhqbwCzY",
    comment: "gunbc-remote-build-session",
  },
  fingerprint: "SHA256:/ufkCsksYwFQOdqvHgaKCYA1LrLuLtxyvB1iGbjO1Fo",
}

// The hosted-CI key — MINTED 2026-11-20 04:23Z by session gentle-crab-832 (ssh-keygen in its container),
// because swift-bear-417's handoff claimed a CI key existed while none had been minted. Its public half was
// admitted here and converged onto srv1/srv3/srv4 by fleet-converge's remote_build_serving_converge
// (srv3 44697398771, srv4 44699734546, srv1 44706597108, all success), and it authenticates as gunbc-build
// (forced command) on all three — on srv1 rechecked through plain sshd after Tailscale SSH was turned off.
// The PRIVATE HALF IS NOT a GitHub Actions secret: the GitHub secret GUNBC_REMOTE_BUILD_CI_SSH_KEY was
// NEVER SET and the key has never been in GitHub. The operator stored the private half 2026-11-20 ~19:35Z
// in Secret Manager (remote_build_ci_ssh_privkey_secret below) and the session copy was shredded 19:40Z.
// The material and fingerprint below are the relayed REAL values, admitted per the rule that a member lands
// only in the change carrying its real public half (fail_closed — no placeholder). ssh-keygen -lf over this
// material prints exactly this fingerprint, and the serve witness
// (test.claim.compute.remote_build_serve_witness::the_ci_key_has_the_relayed_fingerprint) re-derives it
// from the material, so a mistyped key and a mistyped fingerprint cannot both stand.
data remote_build_client_key_ci: RemoteBuildClientKey = RemoteBuildClientKey {
  label: "hosted-ci",
  public_key: SshPublicKey {
    algorithm: Ed25519,
    material: "AAAAC3NzaC1lZDI1NTE5AAAAIJensE0/BGahkF3Duz42EBwvWg9h0NUEcOiHjY1cyoUk",
    comment: "gunbc-remote-build-ci",
  },
  fingerprint: "SHA256:Xy1UDMurH15SRT6Uhp5STj2YcIjPzW/OzPtEidv7ioM",
}

// THE HOSTED-CI PRIVATE HALF — ITS SINGLE HOME, SECRET MANAGER.
//
// PROVENANCE (verified by gentle-crab-832, 2026-11-20; cited, not re-derived here). Minted 2026-11-20
// 04:23Z by session gentle-crab-832 with ssh-keygen in its container, because swift-bear-417's handoff
// claimed a CI key existed while none had been minted. The public half was admitted as
// remote_build_client_key_ci in remote_build_admitted_client_keys (gunbc #16770, merged 088e6446) and
// converged onto srv1/srv3/srv4 by fleet-converge's remote_build_serving_converge (srv3 44697398771,
// srv4 44699734546, srv1 44706597108, all success); it authenticates as gunbc-build (forced command) on
// all three, on srv1 rechecked through plain sshd after Tailscale SSH was turned off. The OPERATOR stored
// the private half 2026-11-20 ~19:35Z as projects/582015116396/secrets/remote-build-ci-ssh-key in OpenSSH
// private-key format; the session copy was shredded 19:40Z. THE KEY HAS NEVER BEEN IN GITHUB and the
// GitHub Actions secret GUNBC_REMOTE_BUILD_CI_SSH_KEY WAS NEVER SET — the earlier note that named it was
// wrong and is corrected here.
//
// This is the custody ledger's row for the secret; the session key's row (remote_build_ssh_privkey_secret)
// is the pattern. Like that row, matched by secret name against fleet_secrets_gcp_project (Secret Manager
// names a project by number or id interchangeably, extdeps.cloud.gcp.secret_ref). The secret VERSION is
// not in the EARLIER relayed facts, so the row kept "pending" per review 95989 (a version written before
// it is read is a guess). THE OPERATOR RELAYED IT ON 2026-11-20 (gcloud secrets versions list: v1, enabled,
// created 2026-11-20T19:36:30Z; nothing newer exists). The ONE pin site is the constant
// hosted_ci_ssh_key_secret_version in gunbc.auth.hosted_ci_secrets_federation, feeding both the accessor
// grant and the gate's fetch URL; this row stays "pending" so the version is never decided twice
// (review 97015 — two pin sites fork).
//
// WHO READS IT (the single consumer): the hosted-runner shadow gate
// (gunbc.witness.hosted_runner_shadow_gate_workflow), over GitHub→GCP workload identity as the dedicated
// low-privilege hosted-ci-secrets service account (gunbc.hosted_ci_secrets_federation), which holds a
// pinned-version secretmanager.secretAccessor grant for THIS secret. It is not read from a GitHub Actions
// secret.
//
// ROTATION. If this key is lost or leaked: (1) mint a new ed25519 pair (ssh-keygen -t ed25519 -C
// gunbc-remote-build-ci); (2) update remote_build_client_key_ci's material AND fingerprint to the new
// public half (the serve witness re-derives the fingerprint from the material, so a mismatch is caught);
// (3) re-converge the forced-command authorized_keys onto srv1, srv3 and srv4 with
// fleet-converge's remote_build_serving_converge and re-run the live gunbc-build authentication check;
// (4) add the new private half as a NEW VERSION of projects/582015116396/secrets/remote-build-ci-ssh-key
// (never overwrite history), then re-point the pinned accessor grant to that version; (5) destroy/ disable
// the leaked version.
data remote_build_ci_ssh_privkey_secret: SecretRef = SecretRef {
  project: fleet_secrets_gcp_project,
  secret: "remote-build-ci-ssh-key" as NonEmptyStr,
  version: "pending",
  hash_state: HashPending,
}

// THE CLOSED LIST. Three members: operator, session, and hosted-ci. Each joins in the change that
// carries its REAL public half — never a placeholder (a placeholder is a fabricated value; an admission
// list carrying one is worse than a shorter list — gunbc.design_argument::fail_closed). The hosted-ci key
// landed with its public half on 2026-11-19 (admitted in gunbc #16770, merged 088e6446); its private half
// is the Secret Manager secret remote_build_ci_ssh_privkey_secret, NOT a GitHub Actions secret.
data remote_build_admitted_client_keys: List<RemoteBuildClientKey> = [
  remote_build_client_key_operator,
  remote_build_client_key_session,
  remote_build_client_key_ci,
]

// The admitted public keys projected out of the closed list, for client-side verification. The client
// accepts its identity file iff the derived public half matches any admitted key.
data remote_build_admitted_public_keys: List<SshPublicKey> = map(remote_build_admitted_client_keys, k => k.public_key)



type RemoteBuildProbe
  = ProbeReady
  | ProbeUnreachable { detail: String }
  | ProbeCannotServe { detail: String }

fn remote_build_probe_from_exit(exit_code: Int, stdout: String, stderr: String) -> RemoteBuildProbe {
  let answer = remote_build_split_answer(stdout: stdout)
  match remote_build_ending_of_answer(stdout: stdout) {
    Present { value: ServeReady } =>
      if exit_code == remote_build_serve_exit_code(e: ServeReady) {
        ProbeReady
      } else {
        ProbeCannotServe { detail: join(["the probe answered ready but exited ", to_string(value: exit_code), ": ", stderr], "") }
      }
    Present { value: other } =>
      ProbeCannotServe { detail: join(["the probe answered ", remote_build_serve_ending_word(e: other) as String, " (exit ", to_string(value: exit_code), "): ", answer.body, stderr], "") }
    Absent =>
      if exit_code == openssh_connection_failed_exit_code {
        ProbeUnreachable { detail: stderr }
      } else {
        ProbeCannotServe { detail: join(["the probe exited ", to_string(value: exit_code), " without a remote-build answer: ", stderr], "") }
      }
  }
}

// The attempt a failed probe records; a ready probe records nothing and the request is sent.
fn remote_build_probe_answer(p: RemoteBuildProbe) -> RemoteBuildHostAnswer? {
  match p {
    ProbeReady => none
    ProbeUnreachable { detail } => Present { value: HostUnreachable { detail: detail } }
    ProbeCannotServe { detail } => Present { value: HostCannotServe { detail: detail } }
  }
}

// ── THE ANSWER TO A SENT REQUEST ─────────────────────────────────────────────────────────────────────
//
// Admitted only when the header is present and its ending's code is the exit code. Anything else --
// no header at any code (the binary's own refusal, a crash, a dropped connection: review 95521), a
// header whose code disagrees, 255 after a received header -- cannot establish whether the host started
// or finished the work, so it is HostOutcomeUnknown and final. The probe already established that this
// host runs the contract, so a missing answer here is not evidence that the work did not start.
fn remote_build_answer_from_exit(exit_code: Int, stdout: String, stderr: String) -> RemoteBuildHostAnswer {
  let answer = remote_build_split_answer(stdout: stdout)
  match remote_build_ending_of_answer(stdout: stdout) {
    Absent =>
      HostOutcomeUnknown { detail: join(["the request was sent and the serving command exited ", to_string(value: exit_code), " without a remote-build answer: ", stderr], "") }
    Present { value: ending } =>
      if remote_build_serve_exit_code(e: ending) != exit_code {
        HostOutcomeUnknown { detail: join(["the serving command answered ", remote_build_serve_ending_word(e: ending) as String, " but the request exited ", to_string(value: exit_code), ": ", answer.body, stderr], "") }
      } else {
        remote_build_answer_of_ending(ending: ending, body: answer.body, stderr: stderr)
      }
  }
}

fn remote_build_answer_of_ending(ending: RemoteBuildServeEnding, body: String, stderr: String) -> RemoteBuildHostAnswer {
  match ending {
    ServeServed => HostServed { receipt: body }
    ServeWorkEndedUnsuccessfully => HostWorkFailed { receipt: body }
    ServeRequestRefused => HostRefusedRequest { detail: concat(body, stderr) }
    ServeHostFull => HostCapacityFull { detail: concat(body, stderr) }
    ServeWorkInFlight => HostWorkInFlight { receipt: body }
    ServeHostCannotServe => HostCannotServe { detail: concat(body, stderr) }
    ServeReady => HostOutcomeUnknown { detail: "a work request was answered as a probe" }
  }
}

// WHICH ENDING A PROVIDER OUTCOME IS. Room and the host's own readiness move the request on; anything
// the work itself produced -- a failure, a cancellation, a mismatch, a unit killed at the ceiling -- is
// the answer, because another host with the same ceiling and the same commit would reach it again.
//
// THE COMPILER DEPENDENCY IS ESTABLISHED FIRST, BY ITS OWN OUTCOME (side-chat review F1). Compile and
// claim runs depend on the gunbc build of the same commit, and the provider reports any non-success of
// that build as DependencyNotSucceeded, which does not keep whether the build FAILED or could not RUN
// (a full pool, a build in flight). So the serving entry asks for the build (work_default_build, the
// one the provider's dependent route resolves) before the operation and classifies the build's own
// typed outcome with this table. The operation's later DependencyNotSucceeded can then only be this
// host failing to hand over a build it just produced or attached, which is the host, not the work.
fn remote_build_dependency_operation() -> WorkOperation {
  work_default_build()
}

// WHETHER THE REQUEST NEEDS THE SEED BUILD AS A SEPARATE OPERATION. Compile and claims depend on the
// gunbc binary of the commit and ATTACH to it, which is why the build is asked for first: its own
// typed outcome is what distinguishes "the build failed" from "this host could not run it".
//
// THE GATE SUBJECT IS THE EXCEPTION, AND THE GUARD IS WHY. `gunbc test` measures the binary it is
// running against the dep-info beside it and refuses one whose inputs are not this checkout's, so the
// attached binary -- a verified blob out of the materialization store -- is exactly what that guard
// cannot judge; the operation carries its own seed build in its argv instead (work_provider_local's
// arm for it). And the build-first shape would hold two reservations on one request: the build's and
// the gate profile's, which on a host whose build pool is one CI slot divided into seats do not both
// fit, so the gate would read capacity-full from its own preceding step.
type RemoteBuildDependencyRule
  = RemoteBuildBuildsTheSeedFirst
  | RemoteBuildCarriesItsOwnSeedBuild

fn remote_build_dependency_rule(op: RemoteBuildOperation) -> RemoteBuildDependencyRule {
  match op {
    RemoteCompileEntry { entry: _ } => RemoteBuildBuildsTheSeedFirst
    RemoteRunClaims { entry: _, functions: _ } => RemoteBuildBuildsTheSeedFirst
    RemoteGateSubject { label: _ } => RemoteBuildCarriesItsOwnSeedBuild
  }
}

fn remote_build_ending_of_refusal(cause: WorkInfrastructureRefusal) -> RemoteBuildServeEnding {
  match cause {
    ProducerInFlight { lease_path: _ } => ServeWorkInFlight
    HostComputeCapacityFull { wire: _ } => ServeHostFull
    HostBelowMemoryFloor { requested: _, available: _ } => ServeHostFull
    ComputeCapacityLedgerUnavailable { detail: _ } => ServeHostCannotServe
    CheckoutUnavailable { detail: _ } => ServeHostCannotServe
    StoreUnavailable { detail: _ } => ServeHostCannotServe
    MaterializationStoreUndeclared { instance_id: _ } => ServeHostCannotServe
    ToolchainUnobserved { detail: _ } => ServeHostCannotServe
    ToolchainMismatchRefused { field: _, declared: _, observed: _ } => ServeHostCannotServe
    SubjectUnresolved { detail: _ } => ServeHostCannotServe
    ClaimRequestSubjectUnnameable { entry: _, function: _, reason: _ } => ServeRequestRefused
    UnitLaunchRefused { cause: _ } => ServeHostCannotServe
    SeatStopObservationUnrenderable { detail: _ } => ServeHostCannotServe
    DependencyNotSucceeded { dependency_identity: _, ending: _ } => ServeHostCannotServe
    UnitMemoryGrantExceeded { class: _, granted: _, peak_upper: _, grant_was_ceiling: _ } => ServeWorkEndedUnsuccessfully
    UnitEndingUnclassifiable { exit_code: _, cause: _ } => ServeWorkEndedUnsuccessfully
  }
}

fn remote_build_ending_of_outcome(o: WorkOutcome) -> RemoteBuildServeEnding {
  match o {
    WorkSucceeded { identity: _, outputs: _, log_path: _ } => ServeServed
    WorkFailed { identity: _, exit_code: _, log_path: _ } => ServeWorkEndedUnsuccessfully
    WorkRefusedByInfrastructure { identity: _, cause } => remote_build_ending_of_refusal(cause: cause)
    WorkCancelled { identity: _, detail: _ } => ServeWorkEndedUnsuccessfully
    WorkOutputMismatch { identity: _, detail: _ } => ServeWorkEndedUnsuccessfully
  }
}
