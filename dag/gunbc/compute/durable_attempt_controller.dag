module gunbc.compute.durable_attempt_controller

import std.types { String, NonEmptyStr, Bool, EpochSecs }
import std.optional { Present, Absent }
import std.content_hash { content_hash_of_value, serialize_content_hash }
import std.durable_compare_and_set {
  CasGeneration, cas_generation, cas_generation_count, ExpectSlotAbsent,
  CasCommitted, CasPreconditionFailed, CasStoreRefused,
  CasObservedReadable, CasObservedUnreadable, CasReadableAbsent, CasReadablePresent,
}
import std.durable_exclusive_hold { DurableHoldSubject, DurableHoldRef, DurableHoldOwnerRef }
import gunbc.durable_cas_file_store { SlotStore, file_slot_store, slot_observe, slot_commit, admit_cas_attempt, CasAttemptAdmitted, DefaultAccessCreateOnly }
import std.durable_compare_and_set { cas_attempt }
import gunbc.durable_handoff_host { HostAcceptedRequest, host_request_identity_wire }
import product.fabric.work { Work }
import product.fabric.work_restore { work_restore, work_persist, WorkRestored, WorkRestoreRefused, WorkPersisted, WorkPersistRefused }
import gunbc.compute.attempt_lifecycle {
  AttemptRecord, AttemptState, AttemptReserved, AttemptPayloadCodec, AttemptFencedCodec,
  AttemptPayloadReading, AttemptPayloadHeld, AttemptPayloadAbsent, AttemptPayloadUnreadable,
  AttemptTransition, AttemptAdvanced, AttemptLostRace, AttemptTransitionRefused,
  AttemptFencedAction, AttemptFencedPreparation, attempt_fenced_prepare,
  attempt_record_wire, attempt_record_decode, attempt_record_with_state,
  attempt_member, attempt_member_int, attempt_payload_read, attempt_open_payload,
}
import extdeps.languages.json.emit { json_object, json_kv, json_string, json_int, serialize_json }
import extdeps.languages.json.parse { parse_json_document, JsonDocumentParsed, JsonDocumentUnreadable }

// This record is the delegated request's one active ownership authority.
// The immutable request slot stores only its initial intent/link. Its owner is
// NOT copied into a second claim record. PR4/5 consumes committed attempt intent;
// this module does not spawn or equate a reservation with an ExecutionGrant.
type ControllerAttempt sole_constructor {
  request: NonEmptyStr
  work_wire: NonEmptyStr
  record: AttemptRecord
  claim: DurableHoldSubject?
}

// The service supplies principal independently of bytes being restored. Root is
// trusted service configuration, not a pathname accepted from submitted work.
// This interface assumes that authenticated ingress/storage boundary; it does
// not claim that Work's consistency hash authenticates an attacker-written file.
type ControllerStore sole_constructor {
  requests: SlotStore
  attempts: SlotStore
  principal: NonEmptyStr
}

fn controller_store(root: NonEmptyStr, principal: NonEmptyStr) -> ControllerStore {
  ControllerStore {
    requests: file_slot_store(root: join([root as String, "/requests"], "") as NonEmptyStr),
    attempts: file_slot_store(root: join([root as String, "/attempts"], "") as NonEmptyStr),
    principal: principal,
  }
}

fn controller_attempt_wire(r: ControllerAttempt) -> String {
  // Preserve the canonical wire admitted by PR2b; no second serialization/hash.
  serialize_json(v: json_object(members: [
    json_kv(key: "schema", value: json_string(s: "gunbc.controller_attempt/1")),
    json_kv(key: "request", value: json_string(s: r.request as String)),
    json_kv(key: "work", value: json_string(s: r.work_wire as String)),
    json_kv(key: "attempt", value: json_string(s: attempt_record_wire(r: r.record))),
    json_kv(key: "claim_kind", value: json_string(s: match r.claim { Absent => "free" Present { value: _ } => "held" })),
    json_kv(key: "claim_hold", value: json_string(s: match r.claim { Absent => "" Present { value: c } => c.hold as String })),
    json_kv(key: "claim_owner", value: json_string(s: match r.claim { Absent => "" Present { value: c } => c.holder as String })),
    json_kv(key: "claim_epoch", value: json_int(n: match r.claim { Absent => 0 Present { value: c } => cas_generation_count(g: c.generation) })),
  ]))
}

fn controller_attempt_decode(text: String, principal: NonEmptyStr) -> ControllerAttempt? {
  match parse_json_document(s: text) {
    JsonDocumentUnreadable { gap: _ } => none
    JsonDocumentParsed { value: doc } =>
      match attempt_member(doc: doc, key: "schema") {
        Absent => none
        Present { value: schema } =>
      match attempt_member(doc: doc, key: "request") {
        Absent => none
        Present { value: request } =>
      match attempt_member(doc: doc, key: "work") {
        Absent => none
        Present { value: wire } =>
      match attempt_member(doc: doc, key: "attempt") {
        Absent => none
        Present { value: attempt } =>
      match attempt_member(doc: doc, key: "claim_kind") {
        Absent => none
        Present { value: kind } =>
      match attempt_member(doc: doc, key: "claim_hold") {
        Absent => none
        Present { value: hold } =>
      match attempt_member(doc: doc, key: "claim_owner") {
        Absent => none
        Present { value: owner } =>
      match attempt_member_int(doc: doc, key: "claim_epoch") {
        Absent => none
        Present { value: epoch } =>
      if schema != "gunbc.controller_attempt/1" || request == "" { none } else {
        match work_restore(wire: wire, expected_principal: principal) {
          WorkRestoreRefused { cause: _ } => none
          WorkRestored { work } => match attempt_record_decode(text: attempt) {
            Absent => none
            Present { value: record } =>
              if kind == "free" && hold == "" && owner == "" && epoch == 0 {
                Present { value: ControllerAttempt { request: request as NonEmptyStr, work_wire: wire as NonEmptyStr, record: record, claim: none } }
              } else if kind == "held" && hold != "" && owner != "" {
                match cas_generation(n: epoch) {
                  Absent => none
                  Present { value: generation } => Present { value: ControllerAttempt { request: request as NonEmptyStr, work_wire: wire as NonEmptyStr, record: record,
                    claim: Present { value: DurableHoldSubject { hold: hold as DurableHoldRef, holder: owner as DurableHoldOwnerRef, generation: generation } } } }
                }
              } else { none }
          }
        }
      }
      }
      }
      }
      }
      }
      }
      }
      }
  }
}

fn controller_reference(r: ControllerAttempt) -> String { r.record.reference }
fn controller_state(r: ControllerAttempt) -> AttemptState { r.record.state }
fn controller_opened(r: ControllerAttempt) -> EpochSecs { r.record.opened_at }
fn controller_deadline(r: ControllerAttempt) -> EpochSecs { r.record.launch_deadline }
fn controller_claim(r: ControllerAttempt) -> DurableHoldSubject? { r.claim }
fn controller_with_state(r: ControllerAttempt, state: AttemptState) -> ControllerAttempt {
  ControllerAttempt { request: r.request, work_wire: r.work_wire, record: attempt_record_with_state(r: r.record, state: state), claim: r.claim }
}
fn controller_with_claim(r: ControllerAttempt, claim: DurableHoldSubject?) -> ControllerAttempt {
  ControllerAttempt { request: r.request, work_wire: r.work_wire, record: r.record, claim: claim }
}
fn controller_payload_codec(principal: NonEmptyStr) -> AttemptPayloadCodec<ControllerAttempt> {
  AttemptPayloadCodec {
    encode: controller_attempt_wire,
    decode: fn(text) { controller_attempt_decode(text: text, principal: principal) },
    reference_of: controller_reference, state_of: controller_state,
    with_state: controller_with_state, opened_at: controller_opened, launch_deadline: controller_deadline,
  }
}
fn controller_bound_codec(delegation: ControllerDelegation) -> AttemptPayloadCodec<ControllerAttempt> {
  AttemptPayloadCodec {
    encode: controller_attempt_wire,
    decode: fn(text) { match controller_attempt_decode(text: text, principal: delegation.store.principal) {
      Absent => none
      Present { value: r } => if controller_attempt_wire(r: controller_with_claim(r: controller_with_state(r: r, state: AttemptReserved), claim: none)) == controller_attempt_wire(r: delegation.initial) {
        Present { value: r }
      } else { none }
    } },
    reference_of: controller_reference, state_of: controller_state,
    with_state: controller_with_state, opened_at: controller_opened, launch_deadline: controller_deadline,
  }
}
fn controller_fenced_codec(delegation: ControllerDelegation) -> AttemptFencedCodec<ControllerAttempt> {
  AttemptFencedCodec { payload: controller_bound_codec(delegation: delegation), claim_of: controller_claim, with_claim: controller_with_claim }
}

// The link seals the CAS-selected initial intent. Losing a delegation race
// returns the WINNER after exact request/payload comparison, never the loser's
// proposed reference. Opening it repeatedly reconciles the existing attempt.
type ControllerDelegation sole_constructor {
  store: ControllerStore
  initial: ControllerAttempt
}
type ControllerDelegationResult
  = ControllerDelegated { delegation: ControllerDelegation }
  | ControllerDelegationRefused { detail: String }

fn controller_delegation_key(request: HostAcceptedRequest) -> NonEmptyStr {
  serialize_content_hash(hash: content_hash_of_value(value: host_request_identity_wire(identity: request.identity) as NonEmptyStr)) as NonEmptyStr
}

fn controller_delegate(store: ControllerStore, request: HostAcceptedRequest, proposed: AttemptRecord) -> ControllerDelegationResult {
  if (request.identity.principal as String) != (store.principal as String) {
    ControllerDelegationRefused { detail: "accepted request is outside the independently configured principal" }
  } else { match work_restore(wire: request.payload as String, expected_principal: store.principal) {
    WorkRestoreRefused { cause: _ } => ControllerDelegationRefused { detail: "accepted payload is not a canonical supported Work" }
    WorkRestored { work } => {
      let initial = ControllerAttempt { request: host_request_identity_wire(identity: request.identity) as NonEmptyStr, work_wire: request.payload,
        record: attempt_record_with_state(r: proposed, state: AttemptReserved), claim: none }
      let bytes = controller_attempt_wire(r: initial) as NonEmptyStr
      match admit_cas_attempt(attempt: cas_attempt(key: controller_delegation_key(request: request), expected: ExpectSlotAbsent, proposed: bytes, proposed_content: content_hash_of_value(value: bytes))) {
        CasAttemptAdmitted { verified } => match slot_commit(store: store.requests, publication: DefaultAccessCreateOnly, verified: verified) {
          CasCommitted { committed: _ } => ControllerDelegated { delegation: ControllerDelegation { store: store, initial: initial } }
          CasStoreRefused { cause: _ } => ControllerDelegationRefused { detail: "request delegation store refused publication" }
          CasPreconditionFailed { expected: _, observed } => match observed {
            CasReadableAbsent => ControllerDelegationRefused { detail: "request delegation disappeared" }
            CasReadablePresent { version } => match controller_attempt_decode(text: version.value as String, principal: store.principal) {
              Absent => ControllerDelegationRefused { detail: "request delegation is undecodable" }
              Present { value: prior } => if (prior.request as String) == (initial.request as String) &&
                (prior.work_wire as String) == (request.payload as String) {
                ControllerDelegated { delegation: ControllerDelegation { store: store, initial: prior } }
              } else { ControllerDelegationRefused { detail: "request identity already delegates a different payload" } }
            }
          }
        }
        _ => ControllerDelegationRefused { detail: "request delegation is not slot-addressable" }
      }
    }
  } }
}

fn controller_attempt_open(delegation: ControllerDelegation) -> AttemptTransition {
  let d = delegation
  let codec = controller_payload_codec(principal: d.store.principal)
  match attempt_open_payload(store: d.store.attempts, record: d.initial, codec: codec) {
    AttemptLostRace { expected, observed } => match controller_attempt_read(delegation: d) {
      AttemptPayloadHeld { record, generation } =>
        if (record.request as String) == (d.initial.request as String) &&
          controller_attempt_wire(r: controller_with_claim(r: controller_with_state(r: record, state: AttemptReserved), claim: none)) == controller_attempt_wire(r: d.initial) {
          AttemptAdvanced { state: record.record.state, generation: generation }
        } else { AttemptTransitionRefused { detail: "existing attempt does not match the delegated immutable intent" } }
      _ => AttemptTransitionRefused { detail: "existing delegated attempt cannot be read" }
    }
    other => other
  }
}
fn controller_attempt_read(delegation: ControllerDelegation) -> AttemptPayloadReading<ControllerAttempt> {
  attempt_payload_read(store: delegation.store.attempts, reference: delegation.initial.record.reference as NonEmptyStr,
    codec: controller_bound_codec(delegation: delegation))
}
fn controller_attempt_prepare(delegation: ControllerDelegation, action: AttemptFencedAction) -> AttemptFencedPreparation {
  attempt_fenced_prepare(store: delegation.store.attempts, reference: delegation.initial.record.reference as NonEmptyStr,
    codec: controller_fenced_codec(delegation: delegation), action: action)
}
