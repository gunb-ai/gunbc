module gunbc.compute.remote_build_serving_converge

// PR 5(a): the OBSERVE arm of the remote-build serving converger. It is read-only: it
// reads one roster host's serving setup over fleet SSH as the administrator principal
// (the fleet automation key the CI job holds; sessions do not), value-compares it against
// the desired state derived by gunbc.compute.remote_build_serving_setup as a single
// std.goal_assessment::GoalAssessment, and writes a plan receipt naming the terminal state
// (settled / drift / indeterminate / refused) and each unmet item by name — never a secret
// value. An unread leg makes the host indeterminate and the run REFUSES, rather than
// reporting drift that an apply could wrongly act on. It mutates NOTHING — the converge
// (apply) arm is PR 5(b) and goes through the fleet-converge plan -> apply spine only after
// the manager's GO. It is a fleet-converge workflow mode, main-only (a new mode cannot be dispatched at a branch ref without an IAM/WIF change), so the
// per-host receipt is produced by dispatching this mode on main after PR 5(a) merges.
//
// ONE HOST PER RUN, NAMED BY THE DISPATCH, exactly as gunbc.runner.runner_host_file_converge
// does: the host arrives in FLEET_CONVERGE_EXPECTED_HOST and an unset name refuses rather
// than fanning a read across the fleet from an empty variable.

import std.types { Bool, String }
import std.optional { Present, Absent }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import extdeps.filesystem.filesystem_io { Filesystem }
import product.host_identity { HostIdentity }
import gunbc.clock_read { clock_now_probed_at, probed_at_word }
import gunbc.actions_run_binding { actions_variable_read, ActionsVariablePresent, ActionsVariableAbsent, fleet_converge_expected_host_env_name }
import gunbc.fleet.fleet_known_hosts_anchor { FleetSshExecutionContext, SshTargetResolution, SshTargetResolved, SshTargetRefused, SshTarget }
import gunbc.fleet.fleet_ssh_locus { prepare_fleet_ssh_agent_context, FleetSshContextReady, FleetSshContextRefused }
import gunbc.typed_argv_exec { typed_argv_exec_over_fleet_ssh, TypedArgvExecConverged, TypedArgvExecRefused }
import gunbc.runner.runner_host_file_converge { administrator_ssh_target }
import gunbc.compute.remote_build_serving_setup {
  remote_build_serving_desired, RemoteBuildServingDesired, ServingObserved,
  serving_observed_from_reads, serving_assess, ServingAssessment,
  serving_assessment_settled, serving_assessment_runnable, serving_assessment_receipt_text,
  ServingLegFailure,
}
import std.goal_assessment { ObservationAttempt, ObservationEstablished, ObservationRefused }

data remote_build_serving_observe_attempt_raw: String = "remote-build-serving-observe-ci"
// Repo-relative (under the CI checkout's target/, which the build creates), mirroring the
// sibling runner_host_file converge receipt. The generated workflow step cats "$ROOT/<this>",
// so an absolute path here would double-prefix and miss; it must stay repo-relative.
data gunbc_ci_remote_build_serving_observe_receipt_path: String = "target/remote-build-serving-plan-receipt.txt"

// Only the desired/observation PAIR is needed downstream; carried together so the entry
// computes the plan once and renders and decides from the same result.
type ServingObservedView { desired: RemoteBuildServingDesired, observed: ServingObserved }

// ── the far-side reads ─────────────────────────────────────────────────────────────
//
// The administrator principal is the declared fleet administrator (`ubuntu`, NOPASSWD
// sudo, declared for srv1..srv4 by gunbc.fleet.fleet_bootstrap_principal). /etc/passwd
// and /etc/group are world-readable, but the serving account's authorized_keys is 0600
// and its instance tree lives under a private home, so every read goes through
// `sudo -n` for uniformity and to reach the 0600 / private-home facts the plan needs.
// A read that does not exit 0 is NOT read as "absent" here: for a `cat` leg a non-zero
// exit yields Absent (the file is missing/unreadable, which the plan reports Missing);
// for a `test` leg exit 0 is present, exit 1 is a real not-present, and any other exit
// or a refused leg is unobservable (Absent), so the plan reads Missing rather than a
// false not-Met or a false Met.

fn serving_leg_read(item: String, target: SshTarget, context: FleetSshExecutionContext, argv: List<String>) -> ObservationAttempt<String, ServingLegFailure> {
  match typed_argv_exec_over_fleet_ssh(target: target, context: context, argv: argv) {
    TypedArgvExecRefused { reason: reason } => ObservationRefused { cause: ServingLegFailure { item: item, cause: concat("ssh refused: ", reason) } }
    TypedArgvExecConverged { result: r } => match r.exit_code == 0 {
      true => ObservationEstablished { observed: r.stdout }
      false => ObservationRefused { cause: ServingLegFailure { item: item, cause: concat("cat exit ", to_string(r.exit_code)) } }
    }
  }
}

// A `test <predicate> <path>` leg: exit 0 -> established PRESENT, exit 1 -> established
// ABSENT (a confirmed not-present the apply may create), any other exit or a refused leg ->
// unobservable (a ServingUnknown), never a proven absence.
fn serving_leg_test(item: String, target: SshTarget, context: FleetSshExecutionContext, predicate: String, path: String) -> ObservationAttempt<Bool, ServingLegFailure> {
  match typed_argv_exec_over_fleet_ssh(target: target, context: context, argv: ["sudo", "-n", "test", predicate, path]) {
    TypedArgvExecRefused { reason: reason } => ObservationRefused { cause: ServingLegFailure { item: item, cause: concat("ssh refused: ", reason) } }
    TypedArgvExecConverged { result: r } => match r.exit_code == 0 {
      true => ObservationEstablished { observed: true }
      false => match r.exit_code == 1 {
        true => ObservationEstablished { observed: false }
        false => ObservationRefused { cause: ServingLegFailure { item: item, cause: concat("test exit ", to_string(r.exit_code)) } }
      }
    }
  }
}

// authorized_keys: `test -f` FIRST, so a missing file (exit 1) is a CONFIRMED absence (the
// established content is "", read as "no forced command") — while a present-but-unreadable
// file, or an errored/SSH-refused leg, is ObservationRefused (unobservable), not a false
// "no key". Only a confirmed-present file is then `cat`-read.
fn serving_leg_authorized_keys(item: String, target: SshTarget, context: FleetSshExecutionContext, path: String) -> ObservationAttempt<String, ServingLegFailure> {
  match typed_argv_exec_over_fleet_ssh(target: target, context: context, argv: ["sudo", "-n", "test", "-f", path]) {
    TypedArgvExecRefused { reason: reason } => ObservationRefused { cause: ServingLegFailure { item: item, cause: concat("ssh refused (test -f): ", reason) } }
    TypedArgvExecConverged { result: t } => match t.exit_code == 1 {
      true => ObservationEstablished { observed: "" }
      false => match t.exit_code == 0 {
        false => ObservationRefused { cause: ServingLegFailure { item: item, cause: concat("test -f exit ", to_string(t.exit_code)) } }
        true => serving_leg_read(item: item, target: target, context: context, argv: serving_cat_sudo(path))
      }
    }
  }
}

fn serving_cat_sudo(path: String) -> List<String> { ["sudo", "-n", "cat", path] }

fn observe_host_reads(target: SshTarget, context: FleetSshExecutionContext, d: RemoteBuildServingDesired) -> ServingObservedView {
  let o = serving_observed_from_reads(
    passwd: serving_leg_read(item: "account", target: target, context: context, argv: serving_cat_sudo("/etc/passwd")),
    group: serving_leg_read(item: "group.members", target: target, context: context, argv: serving_cat_sudo("/etc/group")),
    authorized_keys: serving_leg_authorized_keys(item: "authorized_keys.forced_command", target: target, context: context, path: d.authorized_keys_path),
    store_root: serving_leg_test(item: "store.root", target: target, context: context, predicate: "-d", path: d.store_root),
    store_staging: serving_leg_test(item: "store.staging", target: target, context: context, predicate: "-d", path: d.store_staging),
    serve_binary: serving_leg_test(item: "seed.serve_binary", target: target, context: context, predicate: "-x", path: d.serve_binary),
    checkout: serving_leg_test(item: "checkout", target: target, context: context, predicate: "-d", path: d.checkout_dir),
    toolchain: serving_leg_test(item: "toolchain", target: target, context: context, predicate: "-d", path: d.rustup_home),
  )
  ServingObservedView { desired: d, observed: o }
}

// ── the plan receipt ───────────────────────────────────────────────────────────────
//
// The receipt lists every managed item and its verdict KIND, plus a terminal state. It
// deliberately does NOT print host file contents (authorized_keys, /etc/passwd rows):
// a plan receipt names what changes, it does not exfiltrate the host's secret material.
// The full desired/observed values live in the witness, which is where they are proved.

fn serving_receipt_body(host_name: String, probed_at: String, context_receipt: String, assessment: ServingAssessment) -> String {
  join([
    "remote_build_serving_observe host=", host_name, " probed_at=", probed_at, "\n",
    context_receipt,
    serving_assessment_receipt_text(a: assessment),
  ], "")
}

// ── the CI entry ───────────────────────────────────────────────────────────────────

fn remote_build_serving_observe_ci_wet_hosted(host: String?) -> ProcessExit {
  match host {
    Absent =>
      exit_failure(reason: "remote_build_serving_observe: the host was not named; one host per run, named by the dispatch in FLEET_CONVERGE_EXPECTED_HOST")
    Present { value: raw_host } => {
      let hi = raw_host as HostIdentity
      match administrator_ssh_target(host: hi) {
        SshTargetRefused { endpoint: e, refusal: _ } =>
          exit_failure(reason: join(["remote_build_serving_observe: no anchored ssh target for ", e, "; refusing to read a host the anchor does not name\n"], ""))
        SshTargetResolved { target: target } =>
          match prepare_fleet_ssh_agent_context(attempt_raw: remote_build_serving_observe_attempt_raw) {
            FleetSshContextRefused { cause: c } => exit_failure(reason: c)
            FleetSshContextReady { context: context, receipt: context_receipt } => {
              let view = observe_host_reads(target: target, context: context, d: remote_build_serving_desired(host: hi))
              let assessment = serving_assess(d: view.desired, o: view.observed)
              let body = serving_receipt_body(host_name: raw_host, probed_at: probed_at_word(reading: clock_now_probed_at()) as String, context_receipt: context_receipt, assessment: assessment)
              let w = Filesystem.Write(path: gunbc_ci_remote_build_serving_observe_receipt_path, content: body)
              if w.success == false {
                exit_failure(reason: join(["remote_build_serving_observe: receipt write failed: ", w.error, "\n", body], ""))
              } else if serving_assessment_runnable(a: assessment) == false {
                // Indeterminate (a declared fact could not be read) or refused (an unrenderable
                // forced-command line): the observe produced NO usable judgement, so it exits
                // failure — it never reports a plan the apply could act on for a host it could
                // not read (std.goal_assessment paragraph ONE; gunbc.design_argument::fail_closed).
                exit_failure(reason: body)
              } else {
                // settled (adopted) or a reportable divergence: a faithful receipt, exit success.
                ExitSuccess
              }
            }
          }
      }
    }
  }
}

fn remote_build_serving_observe_ci_wet() -> ProcessExit {
  remote_build_serving_observe_ci_wet_hosted(host: match actions_variable_read(name: fleet_converge_expected_host_env_name) {
    ActionsVariablePresent { value: v } => Present { value: v }
    ActionsVariableAbsent => none
  })
}
