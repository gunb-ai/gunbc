module gunbc.compute.compute_seat_ensure

import std.types { String, Bool, Int, List, NonEmptyStr, EpochSecs }
import std.upsert_decision { UpsertDecision, Noop, Apply, Refuse, UpsertClassification, ObservationVerdict, Converged, Drifted, Inaccessible, UnknownRefused }
import std.list { distinct_by_key }
import std.measure { Kibibyte, kibibyte_count }
import gunbc.durable_cas_file_store { cas_slot_keys, CasSlotKeysListed, CasSlotKeysListingRefused, CasSlotKeysSubjectRefused }
import gunbc.fabric.fabric_event_log_host { now_epoch_seconds }
import gunbc.compute.attempt_lifecycle {
  AttemptRecord, DispatchOwned, OwnerUnrecorded,
  UnitLifecycle, UnitLifecycleUnknown,
  RecoveryTrigger, RecoveryMayTerminate, RecoveryTooEarly, RecoveryUnitNotEnded, RecoveryStateNotRecoverable,
  recovery_trigger,
  AttemptSlotReading, AttemptSlotAbsent, AttemptSlotHeld, AttemptSlotUnreadable, attempt_slot_read,
}
import gunbc.compute.host_capacity {
  ComputeCapacitySubject, ComputeCapacityStanding, ComputeCapacityStandingRead, ComputeCapacityStandingUnread, compute_capacity_standing_on,
}
import gunbc.compute.work_provider_local {
  ComputeRecovery, RecoveryReleased, RecoveryNothingHeld, RecoverySettledButHeld, RecoveryDeclined, RecoveryRefused,
  UnitLifecycleSource, unit_lifecycle_from_source, compute_recover_attempt_in, compute_recovery_wire,
}
import gunbc.roadmap.roadmap_attempt_exit_spool {
  AttemptUnitRole, AttemptWorkerRole, attempt_unit_role_token,
  AttemptExitStageListing, AttemptExitStageNames, AttemptExitStageUnreadable, attempt_exit_stage_listings,
  AttemptExitEntryDecoded, AttemptExitEntryMalformed, attempt_exit_entry_decode,
}
import extdeps.filesystem.filesystem_io {
  Filesystem, FilesystemDirectoryListed, FilesystemDirectoryListingRefused, FilesystemDirectorySubjectRefused,
  filesystem_listing_observation, filesystem_listing_entry_names,
}

// A COMPUTE SEAT HELD BY AN ATTEMPT THAT ENDED IS ENSURED RETURNED, THROUGH THE ONE DISCHARGE DOOR
// (gunbc.recurring_failure_mode a_held_compute_seat_has_no_in_corpus_discharge).
//
// This is an ensure over std.upsert_decision, not a second release path: the decision is made here, the
// ACTION is gunbc.compute.work_provider_local compute_recover_attempt_in, which re-proves unit
// termination itself and releases through the ledger's own release. Selection precedes convergence
// (DESIGN 3d): which references to ensure is chosen by the driver below, from the attempt records.
//
//   live owner (deadline not reached / unit not ended) -> Noop, seat kept
//   owner proven ended and the seat still held          -> Apply (the door)
//   slot unreadable / slot absent / lifecycle unknown   -> Refuse, the charge is KEPT
//
// Readback is independent of the door's own report: the ledger's committed figure is read before and
// after, and a release only counts when committed fell by exactly the attempt's grant.
// RecoverySettledButHeld, or a release the readback does not confirm, is SeatEnsureRed -- never success.
type SeatEnsureOutcome
  = SeatEnsureNoop { reference: String, why: String }
  | SeatEnsureReleased { reference: String, committed_before: Kibibyte, committed_after: Kibibyte }
  | SeatEnsureRefused { reference: String, reason: String }
  | SeatEnsureRed { reference: String, reason: String }

fn seat_ensure_refuse(verdict: ObservationVerdict, reason: String) -> UpsertClassification<String> {
  UpsertClassification { verdict: verdict, decision: Refuse { reason: reason as NonEmptyStr } }
}

fn seat_ensure_apply(reference: String) -> UpsertClassification<String> {
  UpsertClassification { verdict: Drifted, decision: Apply { plan: reference } }
}

// THE PURE DECISION: slot reading + observed lifecycle + clock in, classification out.
fn compute_seat_classify(reading: AttemptSlotReading, lifecycle: UnitLifecycle, now: EpochSecs?) -> UpsertClassification<String> {
  match reading {
    AttemptSlotUnreadable { detail: d } => seat_ensure_refuse(verdict: Inaccessible, reason: join(["the attempt slot could not be read (", d, "); the charge is kept"], ""))
    AttemptSlotAbsent => seat_ensure_refuse(verdict: UnknownRefused, reason: "no attempt slot names this reference; the charge is kept")
    AttemptSlotHeld { record: rec, generation: _ } =>
      match rec.owner {
        OwnerUnrecorded { why: w } => seat_ensure_refuse(verdict: UnknownRefused, reason: join(["the record names no owner (", w, "), so its end cannot be derived from an owner's end; the charge is kept"], ""))
        _ => seat_classify_owned(rec: rec, lifecycle: lifecycle, now: now)
      }
  }
}

fn seat_classify_owned(rec: AttemptRecord, lifecycle: UnitLifecycle, now: EpochSecs?) -> UpsertClassification<String> {
  {
      match now {
        Absent => seat_ensure_refuse(verdict: UnknownRefused, reason: "the clock could not be read; the charge is kept")
        Present { value: t } =>
          match recovery_trigger(record: rec, lifecycle: lifecycle, now: t) {
            RecoveryMayTerminate { reason: _ } => seat_ensure_apply(reference: rec.reference)
            RecoveryStateNotRecoverable { state: _ } => seat_ensure_apply(reference: rec.reference)
            RecoveryTooEarly { deadline: _, now: _ } => UpsertClassification { verdict: Converged, decision: Noop }
            RecoveryUnitNotEnded { lifecycle: u } =>
              match u {
                UnitLifecycleUnknown { detail: d } => seat_ensure_refuse(verdict: UnknownRefused, reason: join(["the unit's lifecycle is unknown (", d, "); the charge is kept"], ""))
                _ => UpsertClassification { verdict: Converged, decision: Noop }
              }
          }
      }
  }
}

fn seat_committed(subject: ComputeCapacitySubject) -> Kibibyte? {
  match compute_capacity_standing_on(subject: subject) {
    ComputeCapacityStandingRead { committed: c, ceiling: _, headroom: _, observed_available: _, observed_total: _ } => Present { value: c }
    ComputeCapacityStandingUnread { detail: _ } => none
  }
}

fn seat_granted_of(reading: AttemptSlotReading) -> Int {
  match reading {
    AttemptSlotHeld { record: rec, generation: _ } => kibibyte_count(k: rec.granted)
    _ => 0
  }
}

fn seat_apply(attempts_root: NonEmptyStr, subject: ComputeCapacitySubject, reference: NonEmptyStr, source: UnitLifecycleSource, granted: Int) -> SeatEnsureOutcome {
  match seat_committed(subject: subject) {
    Absent => SeatEnsureRefused { reference: reference as String, reason: "the capacity ledger could not be read before the release; nothing was released" }
    Present { value: before } =>
      match compute_recover_attempt_in(attempts_root: attempts_root, subject: subject, reference: reference, source: source) {
        RecoverySettledButHeld { reference: r, verdict: _, seat: s } => SeatEnsureRed { reference: r, reason: join(["settled but still charged: ", s], "") }
        RecoveryRefused { detail: d } => SeatEnsureRefused { reference: reference as String, reason: d }
        RecoveryDeclined { reference: r, why: w } => SeatEnsureNoop { reference: r, why: w }
        RecoveryNothingHeld { reference: r, verdict: _, detail: d } =>
          match seat_committed(subject: subject) {
            Absent => SeatEnsureRed { reference: r, reason: "the door reported nothing held but the ledger could not be read back" }
            Present { value: after } =>
              if kibibyte_count(k: before) == kibibyte_count(k: after) {
                SeatEnsureNoop { reference: r, why: join(["the ledger reported it held nothing for this reference, and the committed figure did not move: ", d], "") }
              } else {
                SeatEnsureRed { reference: r, reason: "the ledger reported it held nothing but the committed figure moved during the ensure" }
              }
          }
        RecoveryReleased { reference: r, verdict: _, seat: _ } =>
          match seat_committed(subject: subject) {
            Absent => SeatEnsureRed { reference: r, reason: "the door reported a release but the ledger could not be read back" }
            Present { value: after } =>
              if kibibyte_count(k: before) - kibibyte_count(k: after) == granted {
                SeatEnsureReleased { reference: r, committed_before: before, committed_after: after }
              } else {
                SeatEnsureRed { reference: r, reason: "the door reported a release and the ledger's committed figure did not fall by the attempt's grant" }
              }
          }
      }
  }
}

fn compute_seat_ensure_in(attempts_root: NonEmptyStr, subject: ComputeCapacitySubject, reference: NonEmptyStr, source: UnitLifecycleSource) -> SeatEnsureOutcome {
  let reading = attempt_slot_read(root: attempts_root, reference: reference)
  let lifecycle = match reading {
    AttemptSlotHeld { record: rec, generation: _ } => unit_lifecycle_from_source(source: source, unit: rec.unit as NonEmptyStr)
    _ => UnitLifecycleUnknown { detail: "no attempt record to observe a unit for" }
  }
  let c = compute_seat_classify(reading: reading, lifecycle: lifecycle, now: now_epoch_seconds())
  match c.decision {
    Noop => SeatEnsureNoop { reference: reference as String, why: "the owner is live or its launch deadline has not passed" }
    Refuse { reason: r } => SeatEnsureRefused { reference: reference as String, reason: r as String }
    Apply { plan: _ } => seat_apply(attempts_root: attempts_root, subject: subject, reference: reference, source: source, granted: seat_granted_of(reading: reading))
  }
}

// THE DRIVER. Who calls the ensure: the dispatch attempt's exit record is the TRIGGER (a worker whose
// exit was recorded may have ended its units). The attempt's own compute seats are DERIVED FROM ITS
// RECORD DIRECTORY -- a seat's compute attempt slot lives under the dispatch attempt it belongs to
// (work_provider_local compute_seat_dir), so the attempt reads its own directory and the cost is
// proportional to the attempt, not to the host's slots. There is no corpus scan to discover seats.
// The exit record is not the proof -- the door re-proves termination from the unit itself. The belt
// executes this as an event-triggered obligation but is only the executor: the ownership authority is
// the location the owner's seat was recorded at, written by the slot's exclusive create before the
// reservation exists.
type SeatDischargePass
  = SeatDischargeSkipped { why: String }
  | SeatDischargeRan { outcomes: List<SeatEnsureOutcome> }
  | SeatDischargeRefused { reason: String }

fn seat_discharge_outcomes(p: SeatDischargePass) -> List<SeatEnsureOutcome> {
  match p {
    SeatDischargeRan { outcomes: os } => os
    SeatDischargeSkipped { why: _ } => [] as List<SeatEnsureOutcome>
    SeatDischargeRefused { reason: r } => [SeatEnsureRefused { reference: "", reason: r }]
  }
}

fn seat_outcome_is_red(o: SeatEnsureOutcome) -> Bool {
  match o {
    SeatEnsureRed { reference: _, reason: _ } => true
    _ => false
  }
}

fn seat_discharge_pass_has_red(p: SeatDischargePass) -> Bool {
  match p {
    SeatDischargeRan { outcomes } => any(outcomes, o => seat_outcome_is_red(o: o))
    _ => false
  }
}

// A DIRECTORY THAT DOES NOT EXIST IS "NO SEATS", A DIRECTORY THAT COULD NOT BE LISTED IS NOT. The
// absence is established from the PARENT's listing (a name that is not there), never from the failure
// text of the child's listing.
fn seat_dir_provably_absent(attempts_dir: String, attempt_key: String) -> Bool {
  let listed = Filesystem.List(path: attempts_dir)
  match filesystem_listing_observation(directory: attempts_dir, success: listed.success, entries: listed.entries, error: listed.error) {
    FilesystemDirectoryListed(admitted) => !any(filesystem_listing_entry_names(listing: admitted), n => n == join(["dispatch-", attempt_key], ""))
    FilesystemDirectoryListingRefused { directory: _, error: _ } => false
    FilesystemDirectorySubjectRefused { directory: _, cause: _ } => false
  }
}

fn compute_seat_discharge_owned(attempts_dir: String, subject: ComputeCapacitySubject, node_id: String, attempt_key: String, source: UnitLifecycleSource) -> SeatDischargePass {
  let seats = compute_seat_dir(attempts_dir: attempts_dir, owner: DispatchOwned { node_id: node_id, attempt_key: attempt_key })
  match cas_slot_keys(root: seats) {
    CasSlotKeysListed { keys } =>
      SeatDischargeRan { outcomes: keys |> map(k => compute_seat_ensure_in(attempts_root: seats, subject: subject, reference: k, source: source)) }
    CasSlotKeysListingRefused { root: _, detail: d } =>
      if seat_dir_provably_absent(attempts_dir: attempts_dir, attempt_key: attempt_key) {
        SeatDischargeSkipped { why: "the attempt opened no seat directory" }
      } else {
        SeatDischargeRefused { reason: join(["the attempt's seat directory could not be listed: ", d], "") }
      }
    CasSlotKeysSubjectRefused { root: _, cause: c } => SeatDischargeRefused { reason: join(["the attempt's seat directory could not be listed: ", c], "") }
  }
}

type SeatOwnerKey {
  node_id: String
  attempt_key: String
}

fn seat_worker_exit_owners(listings: List<AttemptExitStageListing>) -> List<SeatOwnerKey> {
  distinct_by_key(
    xs: listings |> flat_map(l => match l {
      AttemptExitStageNames { names } => names
      AttemptExitStageUnreadable { reason: _ } => [] as List<String>
    }) |> flat_map(name => match attempt_exit_entry_decode(entry_name: name) {
      AttemptExitEntryDecoded { record } =>
        if record.role == attempt_unit_role_token(role: AttemptWorkerRole) { [SeatOwnerKey { node_id: record.node_id, attempt_key: record.attempt_key }] } else { [] as List<SeatOwnerKey> }
      AttemptExitEntryMalformed { entry_name: _, reason: _ } => [] as List<SeatOwnerKey>
    }),
    key: fn(o) { join([o.node_id, "\n", o.attempt_key], "") })
}

fn seat_exit_listings_unreadable(listings: List<AttemptExitStageListing>) -> List<String> {
  listings |> flat_map(l => match l {
    AttemptExitStageUnreadable { reason: r } => [r]
    AttemptExitStageNames { names: _ } => [] as List<String>
  })
}

// ONE PASS OVER THE ATTEMPTS WHOSE WORKER EXIT WAS RECORDED. A stage that cannot be read refuses the
// whole pass: "I could not look" is never "there is no exit".
fn compute_seat_discharge_all(instance_root: String, attempts_dir: String, subject: ComputeCapacitySubject, source: UnitLifecycleSource) -> SeatDischargePass {
  let listings = attempt_exit_stage_listings(instance_root: instance_root)
  match seat_exit_listings_unreadable(listings: listings).first() {
    Present { value: why } => SeatDischargeRefused { reason: why }
    Absent =>
      SeatDischargeRan {
        outcomes: seat_worker_exit_owners(listings: listings)
          |> flat_map(o => seat_discharge_outcomes(p: compute_seat_discharge_owned(attempts_dir: attempts_dir, subject: subject, node_id: o.node_id, attempt_key: o.attempt_key, source: source))),
      }
  }
}
