module gunbc.witness_family_fanout

import std.types { String, Int, List }
import v2.std.node { Symbol }

data witness_family_fanout_doc: String = "Witness-family fan-out partition (v1_deletion_plan witness_family_fanout). Lane 4 (wise-fox-351): meet_join + variant_construct + classical_not_ingested emit-on-demand native witnesses on the #6879 kernel. Dissolve-on: every enrolled lane ACCEPT witness green + ci_floor_cutover routes native."

type WitnessFamilyKind
  = EmitHostExecutionFamily
  | ClaimFamily

type WitnessFamilyLane {
  lane_id: Symbol,
  lane_number: Int,
  kind: WitnessFamilyKind,
  title: String,
  scope_note: String,
  witness_entry: String,
  witness_function: String,
  lane_state: String
}

data witness_family_fanout_lanes: List<WitnessFamilyLane> = [
  WitnessFamilyLane {
    lane_id: ^witness_family_lane_meet_join,
