module gunbc.heal_repair_declaration

import std.types { String }

// THE PATH IS DECLARED ONCE AND CONSUMED BY BOTH ENDS. The gate WRITES this file and the heal commit
// step READS it; if each spelled its own literal the two would drift and the failure would be
// silent -- heal would commit with no trailer and nothing would say the declaration had been written
// somewhere nobody looked. It lives under target/ because that directory is ignored, so the
// declaration cannot itself become a committed artifact the drift gate then has to adjudicate.
// It has its own module so heal's import of it reaches no ledger roster (planning consolidation,
// gunbc.design_ruling::plans_reset_and_audit_recommendations_2026_11_08).
data heal_repair_declaration_artifact_path: String = "target/heal-repair-declaration.txt"
