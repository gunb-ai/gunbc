module gunbc.guarantee_rung_drop

import std.types { String, List, Bool, Int }
import v2.std.algebra { fold_list }

// THE TYPED CARRIER FOR A DESIGN section 4b(3) RUNG DROP.
//
// DESIGN section 4b(3) states the obligation: "a change may lower a rung only by declaring
// previous rung, temporary rung, reason, bounded population, and restoration trigger". Those are
// five fields of one record. Written as a paragraph they are five facts no consumer can read, and
// section 4c is explicit that a ruling, a status or a dissolution condition captured as free-form
// String commentary is misplaced data. This module exists so a rung drop is declared once, in a
// shape that can be counted, joined and rendered, rather than narrated per site.
//
// WHAT IS TYPED AND WHAT IS NOT, stated rather than left to be discovered. The ladder itself is a
// closed vocabulary and is modeled as one, so an unrepresentable rung cannot be written and a
// census over rung drops is a fold rather than a text scan. The REASON is a closed coproduct too,
// because the reasons a rung falls are a small named set and naming them is what lets the same
// class be recognised twice. The population and the restoration trigger carry cited names as
// data: a symbol name is a citation (DESIGN section 3 -- cite the symbol), not commentary, and
// the distinction this module enforces is between a fact a consumer reads and a paragraph it
// cannot. Irreducible rationale about WHY a particular drop has its shape stays where rationale
// belongs, in an annotation beside the row.

type GuaranteeRung
  = OutsideTheLadder
  | Mitigatable
  | MechanicallyPreventable
  | StructurallyGuaranteed
  | StructurallyImpossible

// LostAsPassenger is the class this carrier was first written for: nothing deleted the subject,
// something the subject rode on was deleted. A deletion census accounts for what it deleted and
// never for what was riding on it, so this reason is invisible to the cut that causes it and the
// carrier it names is the thing whose own re-add will NOT restore the passenger.
type RungDropReason
  = LostAsPassenger { carrier: String }
  | DeletedWithoutReplacement
  | ReplacementStaged { replacement: String }

type GuaranteeRungDrop {
  subject: String
  previous: GuaranteeRung
  temporary: GuaranteeRung
  reason: RungDropReason
  population: List<String>
  restoration_trigger: String
}

fn guarantee_rung_label(r: GuaranteeRung) -> String {
  match r {
    OutsideTheLadder => "outside the ladder"
    Mitigatable => "mitigatable"
    MechanicallyPreventable => "mechanically preventable"
    StructurallyGuaranteed => "structurally guaranteed"
    StructurallyImpossible => "structurally impossible"
  }
}

fn rung_drop_reason_label(r: RungDropReason) -> String {
  match r {
    LostAsPassenger { carrier: c } => concat("lost as a passenger of ", c)
    DeletedWithoutReplacement => "deleted without replacement"
    ReplacementStaged { replacement: r2 } => concat("replacement staged: ", r2)
  }
}

fn rung_drop_population_render(names: List<String>) -> String {
  fold_list(
    xs: names,
    empty: "",
    cons: fn(acc, n) { if acc == "" { n } else { concat(acc, concat(", ", n)) } },
  )
}

// THE ONE RENDERING, so a refusal arm never restates the row beside it. A gate that spelled its
// own message would be a second authority for the same fact (DESIGN section 3), and the two would
// drift in the ordinary way: someone updates the row and the refusal keeps telling the reader
// something that stopped being true.
fn rung_drop_refusal_message(d: GuaranteeRungDrop) -> String {
  concat(
    concat(d.subject, concat(": RUNG DROP, ", guarantee_rung_label(r: d.previous))),
    concat(
      concat(" -> ", concat(guarantee_rung_label(r: d.temporary), concat(" (", rung_drop_reason_label(r: d.reason)))),
      concat(
        concat("). Population: ", rung_drop_population_render(names: d.population)),
        concat(". Restored when: ", concat(d.restoration_trigger, "."))
      )
    )
  )
}

fn rung_drop_is_off_ladder(d: GuaranteeRungDrop) -> Bool {
  match d.temporary {
    OutsideTheLadder => true
    Mitigatable => false
    MechanicallyPreventable => false
    StructurallyGuaranteed => false
    StructurallyImpossible => false
  }
}

// THE PEER CARRIER FOR A DESIGN section 4b(2) STALL, and it is a different fact from the drop
// above rather than a variant of it. A DROP is an event: something that held a rung stopped
// holding it, and the fields record what was lost. A STALL is a standing state: a class sits
// below its attainable ceiling and has not moved, and section 4b(2) obliges it to say WHY it has
// not -- separating "cannot climb further" from "can climb after one grounding" from "can climb
// now but unbuilt", because only the first is permanent. Nothing was lost when a stall begins, so
// a drop's previous/temporary/reason fields have no answer, and forcing one would fabricate an
// event that did not happen.
//
// WHY THIS EXISTS AT ALL, measured before it was written. The obligation is real and universally
// observed in PROSE: a corpus sweep found 133 sites across 95 modules naming a next-rung or
// restoration trigger, of which 79 sit inside `//` annotations and 54 inside String bodies. Not
// one of them is reachable by a fold. The annotation half is out of reach of any PROGRAM CLAIM --
// DESIGN section 4c is explicit that an annotation is never evidence a machine claim holds, because
// no Accepted program reads one -- and the String half has no identity to key on, so a count over
// it counts phrase occurrences rather than classes. Stated precisely rather than as a blanket
// impossibility, because the overclaim would be checkable and wrong: annotations ARE captured, into
// std.source_annotation SourceAnnotationGraph, so an annotation lens could in principle scan their
// text. That does not rescue the population. Such a lens matches the literal phrase "NEXT-RUNG
// TRIGGER", which is the grep DESIGN section 6 says a lens replaces; it cannot tell a class from a
// mention of one; and every row it read would be modeling debt by that carrier's own standing law.
// The only route to a countable population is authoring the fact as data from here forward.
//
// THE ONE MECHANISM THAT TOUCHES THE CLASS TODAY confirms that reading from the other direction:
// test.claim.stage0_rust_source_lifecycle_scaffold_witness_test asserts string_contains over
// gunbc.stage0_rust_source_lifecycle_scaffold unclassified_axis_rung_note for the literal phrase
// "NEXT-RUNG TRIGGER". It is a real, executing check, and what it can establish is that one prose
// row still contains a phrase -- not that the class it belongs to named a trigger, and not that
// any other class did.
//
// WHAT THIS CARRIER ACTUALLY GUARANTEES, at its honest rung and no higher. next_rung_trigger is a
// REQUIRED field, so a stall declared through this type WITHOUT a trigger has no spelling -- for
// rows that use it, section 4b(2) is structurally impossible to violate rather than checked. It
// makes nothing unwritable about prose: a class stalling in an annotation stays exactly as
// writable as it was, and nothing detects one. That is a scope statement, not a climb, and stating
// it here is what keeps a reader from counting this module as coverage it does not provide.

// THE THREE-WAY DISTINCTION section 4b(2) NAMES, modeled as a closed coproduct because that is
// what makes "only the first is permanent" a fold rather than a reading. AwaitsOneGrounding
// carries the authority it waits on: a stall that cannot name what it is waiting for is not
// waiting, it is unbuilt, and the two rank differently for work.
type ClimbBlocker
  = CannotClimbFurther { why: String }
  | AwaitsOneGrounding { grounding: String }
  | ClimbableButUnbuilt

// A POPULATION MAY BE HONESTLY UNCOUNTABLE, and that must be a state rather than an empty list.
// DESIGN itself carries rows whose exposure is unbounded and says so; rendering those as
// `population: []` would read as "nothing is affected", which is the empty-observation narrow the
// failure-mode list already names -- bottom-as-answer conflated with bottom-as-ignorance.
type StallPopulation
  = BoundedPopulation { members: List<String> }
  | UncountedNotEnumerable { reason: String }

type GuaranteeStall {
  subject: String
  current: GuaranteeRung
  ceiling: GuaranteeRung
  blocker: ClimbBlocker
  population: StallPopulation
  next_rung_trigger: String
}

// THE LADDER'S ORDER, which is a property of the closed vocabulary and not a preference. It exists
// so "below its ceiling" is decided by a fold instead of by a reader comparing two labels.
fn guarantee_rung_index(r: GuaranteeRung) -> Int {
  match r {
    OutsideTheLadder => 0
    Mitigatable => 1
    MechanicallyPreventable => 2
    StructurallyGuaranteed => 3
    StructurallyImpossible => 4
  }
}

// A STALL WHOSE CURRENT RUNG EQUALS ITS CEILING IS NOT A STALL. The type cannot forbid writing one
// -- that would need a dependent pair over the two rungs -- so this is validation standing where
// construction is not available, declared as such rather than presented as a wall.
fn stall_is_below_ceiling(s: GuaranteeStall) -> Bool {
  guarantee_rung_index(r: s.current) < guarantee_rung_index(r: s.ceiling)
}

fn stall_is_permanent(s: GuaranteeStall) -> Bool {
  match s.blocker {
    CannotClimbFurther { why: _ } => true
    AwaitsOneGrounding { grounding: _ } => false
    ClimbableButUnbuilt => false
  }
}

fn climb_blocker_label(b: ClimbBlocker) -> String {
  match b {
    CannotClimbFurther { why: w } => concat("cannot climb further: ", w)
    AwaitsOneGrounding { grounding: g } => concat("awaits one grounding: ", g)
    ClimbableButUnbuilt => "climbable now but unbuilt"
  }
}

fn stall_population_render(p: StallPopulation) -> String {
  match p {
    BoundedPopulation { members: ms } => rung_drop_population_render(names: ms)
    UncountedNotEnumerable { reason: r } => concat("UNCOUNTED, not enumerable: ", r)
  }
}

// ONE RENDERING, for the reason the drop's renderer already gives: a consumer that spelled its own
// message would be a second authority for the row's own fields and the two would drift.
fn stall_report_message(s: GuaranteeStall) -> String {
  concat(
    concat(s.subject, concat(": STALLED at ", guarantee_rung_label(r: s.current))),
    concat(
      concat(", ceiling ", concat(guarantee_rung_label(r: s.ceiling), concat(" (", climb_blocker_label(b: s.blocker)))),
      concat(
        concat("). Population: ", stall_population_render(p: s.population)),
        concat(". Climbs when: ", concat(s.next_rung_trigger, "."))
      )
    )
  )
}

// THE FIRST ROW IS THIS MODULE'S OWN CLASS, and it is homed here for the reason every other row is
// homed with its class: the stall is in the ladder machinery itself, whose authority is this file.
// The population is UncountedNotEnumerable rather than the 133 sites the sweep found, deliberately.
// A measured figure copied into a row is a transcription of an instrument's output, which this
// repository rules against, and it would additionally be the wrong number: 133 counts PHRASE
// OCCURRENCES, and a class that mentions its trigger three times is one stall, while a witness
// asserting the phrase is none. The population has no identity to count at, and that is the finding
// rather than a gap in the sweep.
// A REFERENCE THAT RESOLVES UNDER ONE IMPORT LIST AND REFUSES UNDER A SUPERSET OF IT.
// Filed as a class because the specimen is user-visible and nobody had filed it: adding an import
// of an UNRELATED module silently breaks a bare reference that resolved without it. The failure is
// loud at the reference -- an undefined-variable diagnostic -- but the CAUSAL relation is
// unreachable from it, since nothing in the message connects the new import line to the broken
// name and no author's model of what an import does predicts it. Loud failure with an unreachable
// cause is the shape that costs the most time per incident.
//
// MECHANISM, measured rather than inferred. cli_run build_both_closure_edge_index skips a file
// before populating bare_out for it when source_declares_import_lines is true, and the struct
// field's own doc calls bare_scan_eligible the import-stripped files that may originate
// bare-reference edges. So a bare reference is a closure edge ONLY from a zero-import file.
// Confirmed by discriminator rather than by reading the predicate: one four-file fixture, one
// binary, one line varied -- with no import the provider is pulled and the name resolves clean;
// with one import of an unrelated carrier the provider is not pulled and the name refuses.
//
// WHY THE CEILING IS GUARANTEED AND NOT IMPOSSIBLE: eligibility is decided from the file text the
// compiler already holds, so a closure relation that does not vary with import-declaration is
// derivable. It is not IMPOSSIBLE, because both programs remain writable -- the source can express
// a file with imports and one without; what a repair removes is the DIVERGENCE between them, not
// the ability to author either.
// ON THE GROUNDING FIELD, recorded because the first version of this row got it wrong in a way
// nothing in this repository would have caught. It cited "the ClosureBoundResolution ruling" as
// the authority the class waits on. No such authority exists: the name was coined in cross-session
// correspondence and its only occurrences in the tree were this row and its own trigger. That is
// DESIGN section 3's cite-the-symbol violation in its purest form -- a citation naming a symbol
// that does not resolve -- and it is the exposure the 2026-08-23 cited-symbol drop declared as
// unbounded, arriving inside two days of the census being decommissioned. Caught by review 55910,
// which is the mitigation that drop names and is strictly weaker than the wall it replaced.
//
// THE FINDING DOES NOT CARRY THE RECLASSIFICATION IT PROPOSED, and the distinction is the point of
// the coproduct. The review concluded that an unauthored authority makes this ClimbableButUnbuilt.
// It does not: waiting on a DECISION and waiting on CONSTRUCTION rank differently for work, and
// this class genuinely waits on the first -- the repair direction is undetermined, so building is
// not merely unstarted but unspecifiable. What the finding correctly kills is the pretence that
// the decision had a home. A blocker may name an open question; it may not name a phantom ruling.

data import_eligibility_resolution_stall: GuaranteeStall = GuaranteeStall {
  subject: "a bare reference resolves under one import list and refuses under a superset of it, because bare-reference closure edges originate only from zero-import files",
  current: Mitigatable,
  ceiling: StructurallyGuaranteed,
  blocker: AwaitsOneGrounding {
    grounding: "an undecided QUESTION, stated here rather than cited, because no authority in this tree answers it yet: is candidacy for a subject asked against the CENSUS population or the CLOSURE population. The class cannot climb until that is decided, because the repair direction depends on the answer -- bounding lookup leaves the loader still admitting providers by bare reference, and bounding load changes which files enter the subject at all. So this stall waits on a DECISION rather than on construction, which is what separates it from ClimbableButUnbuilt -- and the separation is structural rather than a matter of degree: the two answers land in DIFFERENT LANES, bounding lookup being a semantic-authority repair and bounding load a proof-authority one, so the answer decides WHO BUILDS as well as WHAT. That is why the work here is not merely unstarted but UNSPECIFIABLE, and why filing this as ClimbableButUnbuilt would be worse than imprecise: it would tell a reader to go build something at a moment when no owner can be named, converting a blocked decision into misdirected effort. The question was coined in cross-session correspondence under a name that has no carrier here, and naming it as though a ruling existed would have been a citation to a symbol that does not resolve"
  },
  population: UncountedNotEnumerable {
    reason: "the AFFECTED population is references whose resolution would change, and nothing enumerates them -- a reference that resolves today emits no diagnostic to count and a reference that refuses is indistinguishable in the message from a genuinely absent declaration. What IS measured is the ELIGIBLE FILE count, 650 of 3933 .dag files carrying no import line at the time of filing, and that is a denominator for where the mechanism can originate rather than a count of what it affects. Quoting the eligible count as the class size is the conflation this row exists to prevent. The eligible count is also RISING by construction: the namespace cut takes modules to zero imports, so each wave switches bare-edge origination on for the modules it strips"
  },
  next_rung_trigger: "the census-or-closure candidacy question is decided AND its answer lands as a namespace-cut PREREQUISITE rather than a post-cut repair, bounding which modules may supply a resolution candidate for a subject. Reclassified from post-cut to prerequisite because the cut is what makes the mechanism universal -- a repair scheduled after the event that generalises it is scheduled backwards. Not satisfied by bounding lookup alone: the closure constructor extends by bare reference to a fixpoint before any lookup runs, so a wall placed only at lookup sits downstream of the door that already opened"
}

data next_rung_trigger_enforcement_stall: GuaranteeStall = GuaranteeStall {
  subject: "DESIGN section 4b(2) next-rung trigger enforcement",
  current: Mitigatable,
  ceiling: MechanicallyPreventable,
  blocker: ClimbableButUnbuilt,
  population: UncountedNotEnumerable {
    reason: "a next-rung trigger is authored as prose, so it has no identity to count at. The majority of sites sit inside // annotations, which DESIGN section 4c makes unreadable to any Accepted program, so no lens can enumerate them however it is written -- the shortfall is the representation, not the sweep"
  },
  next_rung_trigger: "every class this repository declares below its ceiling declares it through gunbc.guarantee_rung_drop GuaranteeStall rather than in prose, at which point the population becomes a fold over rows and a stall missing its trigger has no spelling. Not satisfied by this carrier existing: one row is a carrier with a consumer, not a migrated population, and the 4b(2) obligation stays review diligence for every class still stalling in an annotation"
}
