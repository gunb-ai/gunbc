module gunbc.local_tidy_spec


data local_tidy_checks: List<LocalTidyCheck> = project_local_tidy_checks(roster: commit_gate_roster)

data githooks_pre_push_emit_scaffold: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.githooks_pre_push_emit",
    decl_name: "expected_githooks_pre_push_sh",
    field: WholeDeclaration
  }
}

fn layer_root_glob_prefixes() -> List<String> {
  map(witness_layer_roots, r => concat(r, "/*"))
}

fn suffix_to_glob_pattern(suffix: String) -> String {
  if starts_with(s: suffix, prefix: ".") {
    concat("*", suffix)
  } else {
    suffix
  }
}

fn doc_reachability_trigger_globs() -> List<String> {
  concat(
    concat(layer_root_glob_prefixes(), ["docs/*", "ROADMAP.md", "DESIGN.md"]),
    ["*.md", "*.dag"]
  )
}

fn cargo_fmt_trigger_globs() -> List<String> {
  map(rust_monolith_suffixes(), s => suffix_to_glob_pattern(suffix: s))
}

fn local_tidy_trigger_globs(check: LocalTidyCheck) -> List<String> {
  match check {
    LocalTidyWitnessCheck { entry: _, check_fns: _ } => doc_reachability_trigger_globs()
    LocalTidyCargoFmtCheck => cargo_fmt_trigger_globs()
  }
}

fn local_tidy_path_matches_glob(path: String, glob: String) -> Bool {
  if ends_with(s: glob, suffix: "/*") {
    let prefix = substring(s: glob, start: 0, end: length(glob) - 1)
    starts_with(s: path, prefix: prefix)
  } else if starts_with(s: glob, prefix: "*") {
    let suffix = substring(s: glob, start: 1, end: length(glob))
    ends_with(s: path, suffix: suffix)
  } else {
    starts_with(s: path, prefix: glob)
  }
}

fn local_tidy_path_matches_trigger(path: String, check: LocalTidyCheck) -> Bool {
  match check {
    LocalTidyCargoFmtCheck => path_is_rust_monolith(path: path)
    _ => any(
      local_tidy_trigger_globs(check: check),
      g => local_tidy_path_matches_glob(path: path, glob: g)
    )
  }
}

