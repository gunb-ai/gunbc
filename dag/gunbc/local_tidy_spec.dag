module gunbc.local_tidy_spec


data local_tidy_checks: List<gunbc.commit_workflow.LocalTidyCheck> = gunbc.commit_workflow.project_local_tidy_checks(roster: gunbc.commit_workflow.commit_gate_roster)

data githooks_pre_push_emit_scaffold: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: std.disposition.RealizationDispatch,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.githooks_pre_push_emit",
    decl_name: "expected_githooks_pre_push_sh",
    field: std.decl_ref.WholeDeclaration
  }
}

fn layer_root_glob_prefixes() -> List<String> {
  map(gunbc.ci_layer_roots.witness_layer_roots, r => concat(r, "/*"))
}

fn suffix_to_glob_pattern(suffix: String) -> String {
  if starts_with(s: suffix, prefix: ".") {
    concat("*", suffix)
  } else {
    suffix
  }
}

fn doc_reachability_trigger_globs() -> List<String> {
  concat(
    concat(layer_root_glob_prefixes(), ["docs/*", "ROADMAP.md", "DESIGN.md"]),
    ["*.md", "*.dag"]
  )
}

fn cargo_fmt_trigger_globs() -> List<String> {
  map(tools.rust_stage0_gates.rust_monolith_suffixes(), s => suffix_to_glob_pattern(suffix: s))
}

fn local_tidy_trigger_globs(check: gunbc.commit_workflow.LocalTidyCheck) -> List<String> {
  match check {
    gunbc.commit_workflow.LocalTidyWitnessCheck { entry: _, check_fns: _ } => doc_reachability_trigger_globs()
    gunbc.commit_workflow.LocalTidyCargoFmtCheck => cargo_fmt_trigger_globs()
  }
}

fn local_tidy_path_matches_glob(path: String, glob: String) -> Bool {
  if ends_with(s: glob, suffix: "/*") {
    let prefix = substring(s: glob, start: 0, end: length(glob) - 1)
    starts_with(s: path, prefix: prefix)
  } else if starts_with(s: glob, prefix: "*") {
    let suffix = substring(s: glob, start: 1, end: length(glob))
    ends_with(s: path, suffix: suffix)
  } else {
    starts_with(s: path, prefix: glob)
  }
}

fn local_tidy_path_matches_trigger(path: String, check: gunbc.commit_workflow.LocalTidyCheck) -> Bool {
  match check {
    gunbc.commit_workflow.LocalTidyCargoFmtCheck => tools.rust_stage0_gates.path_is_rust_monolith(path: path)
    _ => any(
      local_tidy_trigger_globs(check: check),
      g => local_tidy_path_matches_glob(path: path, glob: g)
    )
  }
}

type LocalTidyFmtOutcome
  = FmtClean
  | FmtDrift
  | FmtToolUnavailable { program: String, cause: String }

data local_tidy_fmt_outcome_note: String = "A tool that COULD NOT RUN is not a negative finding about the work. The pre-commit hook, the pre-push hook, and the pre_push.rs transport each collapsed a non-zero cargo-fmt exit into 'drift', so a missing cargo printed 'rustfmt drift — run: cargo fmt --all' — a remedy that runs the very binary whose absence caused the message (operator receipt 2026-07-30: hit three times in one session, on both hooks). This is the DESIGN section 5 absorbing fallback read on the answer lattice: 'the tree is unformatted' and 'I could not determine whether the tree is formatted' are different states whose remedies differ, and conflating them zeroes the deficit's observable frequency. The split is decidable from the exit status alone, so it is a construction wall rather than a check: only FmtDrift can reach a drift recipe, because local_tidy_fmt_outcome_recipe routes FmtToolUnavailable to a message that names the program and proposes no remedy depending on it. Resolution is a SEPARATE and independent axis owned by ROADMAP toolchain-single-resolver / toolchain-rust-hermetic (seed carrier InterpError::HostToolUnresolved, deleted at that lane's handback): even a perfectly hermetic cargo leaves this conflation wrong whenever the binary is unreadable, mid-install, or the wrong architecture, which is why the split lands here and does not fork a second resolver."

data local_tidy_fmt_exit_partition_note: String = "Grounded in the observed contract of cargo fmt --all --check, pinned by execution 2026-07-30: 0 = clean, 1 = rustfmt reported diffs (the only exit that is a finding about the work), 127 = the shell could not locate cargo, 126 = located but not executable (wrong architecture, lost permission bit), 101 = cargo ran but has no fmt subcommand (rustfmt component absent mid-install). Every status other than 0 and 1 therefore says the check did not produce a verdict, so the partition is exactly clean / drift / could-not-run. The residue arm is fail-closed by refusal, never by widening: an unrecognized status still stops the line with a non-zero exit, and only the MESSAGE changes, so no unverified push is admitted."

data local_tidy_fmt_pre_push_drift_recipe: String = "rustfmt drift — run: cargo fmt --all   (then commit and re-push, or 'git push --no-verify' to skip)"

data local_tidy_fmt_pre_commit_drift_recipe: String = "fmt drift in staged Rust — run: cargo fmt --all && git add -u, then re-commit."

data local_tidy_fmt_drift_recipe_defork_note: String = "local_tidy_fmt_pre_push_drift_recipe was authored byte-identically in BOTH gunbc.githooks_pre_push_emit and gunbc.githooks_pre_push_plan — one string, two authorities, free to drift (DESIGN section 3). Both now import this row. The pre-commit and pre-push drift recipes stay two rows because they are two genuinely different remedies (git add -u then re-commit, versus commit and re-push), not one concept spelled twice."

data local_tidy_fmt_unavailable_advertises_no_bypass_note: String = "The could-not-run message deliberately advertises NO bypass (review 45175). An earlier draft closed it with 'git's --no-verify skips this hook', which is an escape hatch in exactly the arm that has the least information: a toggle whose only effect is to proceed as if the refusal had not fired, offered at the moment the check could not determine anything (DESIGN section 5, operator ruling 2026-07-05). The only remedy this arm may propose is the one that makes the check able to report — install the toolchain. The DRIFT recipe keeps its pre-existing --no-verify mention untouched, and that asymmetry is the point rather than an oversight: on drift the developer has been told the actual state of the tree and is choosing to skip a known finding, whereas on could-not-run there is no finding to weigh, so advertising the bypass would convert a refusal into a documented default. witness_unavailable_recipe_advertises_no_bypass is the RED control."

fn local_tidy_fmt_tool_unavailable_recipe(program: String, cause: String) -> String {
  concat(
    concat(program, " could not be run ("),
    concat(
      cause,
      ") — the fmt check DID NOT RUN, so this is not a formatting finding. Install a Rust toolchain so this check can report, then re-run."
    )
  )
}

fn local_tidy_fmt_outcome_recipe(
  outcome: LocalTidyFmtOutcome,
  drift_recipe: String
) -> String {
  match outcome {
    FmtClean => ""
    FmtDrift => drift_recipe
    FmtToolUnavailable { program, cause } =>
      local_tidy_fmt_tool_unavailable_recipe(program: program, cause: cause)
  }
}

fn local_tidy_fmt_outcome_of_exit_status(program: String, status: Int) -> LocalTidyFmtOutcome {
  if status == 0 {
    FmtClean
  } else if status == 1 {
    FmtDrift
  } else {
    FmtToolUnavailable {
      program: program,
      cause: concat("exit status ", to_string(status))
    }
  }
}

fn local_tidy_fmt_outcome_blocks(outcome: LocalTidyFmtOutcome) -> Bool {
  match outcome {
    FmtClean => false
    FmtDrift => true
    FmtToolUnavailable { program: _, cause: _ } => true
  }
}

