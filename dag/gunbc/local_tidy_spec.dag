module gunbc.local_tidy_spec

import std.disposition { Disposition, Scaffold, RealizationDispatch }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.ci.ci_layer_roots { witness_layer_roots }
import gunbc.commit_workflow {
  LocalTidyCheck, LocalTidyWitnessCheck, LocalTidyCargoFmtCheck,
  commit_gate_roster,
  project_local_tidy_checks,
  doc_reachability_witness_entry
}
import gunbc.instruments.rust_stage0_gates { rust_monolith_suffixes, path_is_rust_monolith }

data local_tidy_checks: List<LocalTidyCheck> = project_local_tidy_checks(roster: commit_gate_roster)

data githooks_pre_push_emit_scaffold: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.githooks.githooks_pre_push_emit",
    decl_name: "expected_githooks_pre_push_sh",
    field: WholeDeclaration
  }
}

data generated_artifact_merge_driver_emit_scaffold: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.generated_artifact_merge_driver",
    decl_name: "expected_generated_artifact_merge_driver_sh",
    field: WholeDeclaration
  }
}

fn layer_root_glob_prefixes() -> List<String> {
  map(witness_layer_roots, r => concat(r, "/*"))
}

fn suffix_to_glob_pattern(suffix: String) -> String {
  if starts_with(s: suffix, prefix: ".") {
    concat("*", suffix)
  } else {
    suffix
  }
}

fn doc_reachability_trigger_globs() -> List<String> {
  concat(
    concat(layer_root_glob_prefixes(), ["docs/*", "ROADMAP.md", "DESIGN.md"]),
    ["*.md", "*.dag"]
  )
}

fn cargo_fmt_trigger_globs() -> List<String> {
  map(rust_monolith_suffixes(), s => suffix_to_glob_pattern(suffix: s))
}

fn local_tidy_trigger_globs(check: LocalTidyCheck) -> List<String> {
  match check {
    LocalTidyWitnessCheck { entry: _, check_fns: _ } => doc_reachability_trigger_globs()
    LocalTidyCargoFmtCheck => cargo_fmt_trigger_globs()
  }
}

fn local_tidy_path_matches_glob(path: String, glob: String) -> Bool {
  if ends_with(s: glob, suffix: "/*") {
    let prefix = substring(s: glob, start: 0, end: length(glob) - 1)
    starts_with(s: path, prefix: prefix)
  } else if starts_with(s: glob, prefix: "*") {
    let suffix = substring(s: glob, start: 1, end: length(glob))
    ends_with(s: path, suffix: suffix)
  } else {
    starts_with(s: path, prefix: glob)
  }
}

fn local_tidy_path_matches_trigger(path: String, check: LocalTidyCheck) -> Bool {
  match check {
    LocalTidyCargoFmtCheck => path_is_rust_monolith(path: path)
    LocalTidyWitnessCheck { entry: _, check_fns: _ } => any(
      local_tidy_trigger_globs(check: check),
      g => local_tidy_path_matches_glob(path: path, glob: g)
    )
  }
}

type LocalTidyFmtOutcome
  = FmtClean
  | FmtDrift
  | FmtToolUnavailable { program: String, cause: String }

// A tool that COULD NOT RUN is not a negative finding about the work. The pre-commit hook, the
// pre-push hook, and the pre_push.rs transport each collapsed a non-zero cargo-fmt exit into
// 'drift', so a missing cargo printed 'rustfmt drift — run: cargo fmt --all' — a remedy that runs
// the very binary whose absence caused the message (operator receipt 2026-07-30: hit three times in
// one session, on both hooks). This is the gunbc.design_argument::fail_closed absorbing fallback read on the answer
// lattice: 'the tree is unformatted' and 'I could not determine whether the tree is formatted' are
// different states whose remedies differ, and conflating them zeroes the deficit's observable
// frequency. The split is decidable from the exit status alone, so it is a construction wall rather
// than a check: only FmtDrift can reach a drift recipe, because local_tidy_fmt_outcome_recipe
// routes FmtToolUnavailable to a message that names the program and proposes no remedy depending on
// it. Resolution is a SEPARATE and independent axis owned by ROADMAP toolchain-single-resolver /
// toolchain-rust-hermetic (seed carrier InterpError::HostToolUnresolved, deleted at that lane's
// handback): even a perfectly hermetic cargo leaves this conflation wrong whenever the binary is
// unreadable, mid-install, or the wrong architecture, which is why the split lands here and does
// not fork a second resolver.

data local_tidy_fmt_exit_partition_note: String = "Grounded in the observed contract of cargo fmt --all --check, pinned by execution 2026-07-30: 0 = clean, 1 = rustfmt reported diffs (the only exit that is a finding about the work), 127 = the shell could not locate cargo, 126 = located but not executable (wrong architecture, lost permission bit), 101 = cargo ran but has no fmt subcommand (rustfmt component absent mid-install). Every status other than 0 and 1 therefore says the check did not produce a verdict, so the partition is exactly clean / drift / could-not-run. The residue arm is fail-closed by refusal, never by widening: an unrecognized status still stops the line with a non-zero exit, and only the MESSAGE changes, so no unverified push is admitted."

data local_tidy_fmt_pre_push_drift_recipe: String = "rustfmt drift — HOLD this push and report it to your lane manager. Do not push past this refusal and do not reformat files this branch does not own."

data local_tidy_fmt_pre_commit_drift_recipe: String = "fmt drift in staged Rust — run: cargo fmt --all && git add -u, then re-commit."

// local_tidy_fmt_pre_push_drift_recipe was authored byte-identically in BOTH
// gunbc.githooks.githooks_pre_push_emit and gunbc.githooks.githooks_pre_push_plan — one string, two authorities, free
// to drift (gunbc.design_argument::single_authority). Both now import this row. The pre-commit and pre-push drift recipes
// stay two rows because they are two genuinely different remedies (git add -u then re-commit,
// versus commit and re-push), not one concept spelled twice.

// BOTH fmt-failure arms deliberately advertise NO bypass, and both now answer to the live
// fail_closed position rather than to a dated ruling. The could-not-run arm: an earlier draft closed
// it with 'git's --no-verify skips this hook', an escape hatch in exactly the arm with the least
// information — a toggle whose only effect is to proceed as if the refusal had not fired, offered at
// the moment the check could determine nothing. That is the fail_closed position itself:
// gunbc.design_argument::fail_closed, data fail_closed: DesignRow at dag/gunbc/design_argument.dag:745,
// whose review tells list verbatim "a toggle, env var or flag whose only effect is to skip a refusal".
// The only remedy this arm may propose is the one that makes the check able to report — install the
// toolchain — and its wording ('the fmt check DID NOT RUN ... not a formatting finding') is
// load-bearing: it keeps 'the tree is unformatted' distinct from 'the check could not run', so the
// deficit stays observable. witness_unavailable_recipe_advertises_no_bypass is its RED control.
//
// STALE CITATION, STATED NOT REPEATED. An earlier version of this note attributed the could-not-run
// no-bypass position to "operator ruling 2026-07-05", but that ruling resolves to no row in
// gunbc.design_ruling — the roster whose whole stated purpose is a dated operator ruling, "when, and
// on whose words" (measured at this base: 189 DesignRuling rows; 0 decided 2026-07; the decided-date
// distribution is 2026-09 = 9, 2026-10 = 59, 2026-11 = 121; the single line matching fmt/hook/bypass/
// no-verify is a fleet-key enrolment, not fmt). The design authority it gestures at — fail_closed —
// is real and cited above; only the dated-ruling label dangled. NO DesignRuling row is authored to
// fill it: that roster records dated OPERATOR rulings, this change is not one, and writing a
// manager's ruling as an operator row is precisely the fabricated provenance the roster exists to
// prevent.
//
// The DRIFT arm formerly kept a 'git push --no-verify to skip' clause, and the earlier note defended
// that asymmetry ('on drift the developer is choosing to skip a known finding'). neat-badger-614
// (2026-11-25) withdrew it. The asymmetry was the author's argument, and its premise — drift is
// caught elsewhere, so skipping only defers a finding CI catches anyway — is dead:
// gunbc.githooks.githooks_pre_push_emit:20 records that the 2026-08-15 floor cut deleted the fmt
// build job and that neither required lane of the emitted .github/workflows/witnesses.yml runs fmt,
// so "this hook is now the only surface that runs fmt at all." A --no-verify clause there is exactly
// the fail_closed tell above — a flag whose only effect is to skip a refusal — standing on the fleet's
// ONLY fmt gate. The drift recipe now says to HOLD the push and report it to the lane manager, and
// proposes no bypass and no fleet-wide reformat (a branch reformatting files it does not own collides
// with the lane that owns them). This TIGHTENS toward the live fail_closed position; it reverses no
// operator words. witness_drift_recipe_advertises_no_bypass and
// witness_emitted_pre_push_drift_text_advertises_no_bypass are the RED controls: each reads the OLD
// '--no-verify' spelling and goes red if the clause returns.

fn local_tidy_fmt_tool_unavailable_recipe(program: String, cause: String) -> String {
  concat(
    concat(program, " could not be run ("),
    concat(
      cause,
      ") — the fmt check DID NOT RUN, so this is not a formatting finding. Install a Rust toolchain so this check can report, then re-run."
    )
  )
}

fn local_tidy_fmt_outcome_recipe(
  outcome: LocalTidyFmtOutcome,
  drift_recipe: String
) -> String {
  match outcome {
    FmtClean => ""
    FmtDrift => drift_recipe
    FmtToolUnavailable { program, cause } =>
      local_tidy_fmt_tool_unavailable_recipe(program: program, cause: cause)
  }
}

fn local_tidy_fmt_outcome_of_exit_status(program: String, status: Int) -> LocalTidyFmtOutcome {
  if status == 0 {
    FmtClean
  } else if status == 1 {
    FmtDrift
  } else {
    FmtToolUnavailable {
      program: program,
      cause: concat("exit status ", to_string(status))
    }
  }
}

fn local_tidy_fmt_outcome_blocks(outcome: LocalTidyFmtOutcome) -> Bool {
  match outcome {
    FmtClean => false
    FmtDrift => true
    FmtToolUnavailable { program: _, cause: _ } => true
  }
}
