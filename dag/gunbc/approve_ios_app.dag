module gunbc.approve_ios_app

import std.types { NonEmptyStr, Timestamp, Int, List }
import std.dissolution { DissolutionCondition, unbound_dissolution }
import std.roster_frontier { FrontierRow, frontier_row_path }
import std.optional { Optional, Present, Absent }
import extdeps.apple.xcode { XcodeRelease }

// THE iOS APPROVAL APP IS SWIFT, PART PRINTED FROM MODELED SYNTAX TREES AND PART HAND-AUTHORED (operator ruling: apps/approve-ios/ in
// this repository, SwiftUI, iOS 17+). It is a realization of gunbc.auth.approval_device_wire (the
// byte contract) and gunbc.auth.approval_device_redemption (the server's admission)
// and of extdeps.apple.{secure_enclave, app_attest, apns}; it declares no wire fact of its own. Its
// byte builders are CHECKED against vectors the .dag witness emits into
// dag/test/fixture/approval_device_redemption/vectors.json, which apps/approve-ios/project.yml
// carries into the test bundle -- one authority, read from two sides, nothing hand-copied. THE
// STANDING OF THAT CHECK, honestly (DESIGN 4b(1)): the XCTest is AUTHORED and UN-ENROLLED. No lane
// in this repository compiles Swift, so it executes only when an operator runs it on a MacBook, and
// nothing on the merge path has ever compiled the Swift under apps/approve-ios. The equivalence is
// therefore a claim at the mitigation rung whose only evidence is operator-executed, not an
// established hold; approve_ios_vector_check_unenrolled_frontier names what would enrol it. Every
// section the suite reads is emitted by gunbc.auth.approval_device_redemption_fixtures (the
// stored_request section by stored_request_specimens; the outcome envelopes through
// redemption_response_of), so a fixture regenerated from that module carries all of it.
//
// WHY THE SWIFT IS NOT YET DERIVED, stated as the §7 frontier row requires. The Swift is in two
// standings (operator direction 2026-09-25: hand-concatenated text, then a modeled form that is
// emitted, then derived -- the shell-to-argv path). Protocol.swift, Wire.swift and
// ProtocolVectorTests.swift are the MODELED stage: symbolic syntax trees
// (v2.extdeps.languages.swift.syntax) transcribed from the files they replaced, emitted through the Swift
// grammar rows (v2.extdeps.languages.swift.rows) and drift-gated, so a hand edit is refused. Their
// constants and shapes are still transcribed rather than derived from gunbc.auth.approval_device_wire
// (approve_ios_transcribed_swift_frontier), except the tests' surface-name set, which is generated
// from the fixture's own rows. The other five files are still hand-authored text
// (approve_ios_retained_swift_rows).
// The vector check's own next-rung trigger, separate from the hand-authoring trigger below because
// the two dissolve differently: this one ends when the check EXECUTES on the merge path, which can
// happen while the Swift is still hand-authored. Either arm of the trigger is sufficient.
data approve_ios_vector_check_unenrolled_frontier: DissolutionCondition = unbound_dissolution(
  description: "ApproveTests (apps/approve-ios/ApproveTests/ProtocolVectorTests.swift) checks the app's byte builders and wire envelopes against dag/test/fixture/approval_device_redemption/vectors.json but is executed by no lane: the witness_floor_workflow job roster is closed to growth and has no macOS runner, so the check runs only when an operator presses run on a MacBook. DISSOLVES WHEN either (a) an operator-admitted lane on a macOS runner compiles apps/approve-ios and runs ApproveTests on every pull request, SUFFICIENT FOR a drifted builder or envelope to red the merge path, or (b) the Swift target's emit transforms land and the emitter's own equivalence evidence covers the protocol layer, retiring approve_ios_retained_swift_rows and this row together",
)

// THE HAND-AUTHORED SWIFT, AS TYPED ROWS (std.roster_frontier FrontierRow, the existing retained-row
// shape: subject, reason, dissolution). It replaces one prose condition naming five files. Every .swift
// file under apps/approve-ios is joined to EXACTLY ONE of a registered generated artifact or one of
// these rows by gunbc.approve_ios_swift_join; a file in neither is a finding (the live read of the real tree is an operator instrument, gunbc.guarantee_stall approve_ios_swift_join_live_off_the_merge_path_stall).
//
// PLATFORM GLUE: the file is a call-shape realization of an Apple framework. Its trigger names the
// CAPABILITY that would move it, not the file.
data approve_ios_views_retained: FrontierRow = frontier_row_path(
  path: "apps/approve-ios/Approve/Views.swift",
  reason: "SwiftUI view composition: layout, navigation and bindings of the approval screens are expressed in SwiftUI's own view builder, which no model in this repository describes",
  dissolution: unbound_dissolution(description: "DISSOLVES WHEN extdeps.apple holds a SwiftUI view model (view, modifier and binding shapes with their builder semantics) and the Swift target prints views from it, SUFFICIENT FOR a drifted view declaration to be refused by the drift gate"),
)

data approve_ios_app_entry_retained: FrontierRow = frontier_row_path(
  path: "apps/approve-ios/Approve/ApproveApp.swift",
  reason: "process entry glue: the SwiftUI App, the UIApplicationDelegate APNs registration callbacks and the UNUserNotificationCenter delegate are platform lifecycle entry points whose call shapes are Apple's",
  dissolution: unbound_dissolution(description: "DISSOLVES WHEN extdeps.apple models the App, UIApplicationDelegate and UNUserNotificationCenter call shapes (extdeps.apple.apns is the server side only) and the Swift target prints the entry point from them, SUFFICIENT FOR a drifted lifecycle callback to be refused by the drift gate"),
)

data approve_ios_device_keys_retained: FrontierRow = frontier_row_path(
  path: "apps/approve-ios/Approve/DeviceKeys.swift",
  reason: "device key custody glue: CryptoKit Secure Enclave key generation and signing, DCAppAttestService attestation and assertion, and Keychain storage are Apple call shapes executed on the phone",
  dissolution: unbound_dissolution(description: "DISSOLVES WHEN extdeps.apple binds the CryptoKit Secure Enclave, DCAppAttestService and Keychain call shapes (extdeps.apple.secure_enclave and app_attest model the verified artifacts, not the calling API) and the Swift target prints the custody calls from them, SUFFICIENT FOR a drifted call shape to be refused by the drift gate"),
)

// NOT GLUE: these hold the enrolment payload and UI state, which is a model fact still hand-written.
// The trigger is the enrolment payload model (Charter 5 L4, session smart-lark-63), not an Apple capability.
data approve_ios_enrolment_state_frontier: List<FrontierRow> = [
  frontier_row_path(
    path: "apps/approve-ios/Approve/EnrolmentState.swift",
    reason: "enrolment payload persistence is hand-written because the enrolment payload is not yet a model the Swift target can print",
    dissolution: unbound_dissolution(description: "DISSOLVES WHEN the enrolment payload model of Charter 5 L4 (session smart-lark-63) lands and this file is printed from it, SUFFICIENT FOR a drifted payload field to be refused by the drift gate"),
  ),
  frontier_row_path(
    path: "apps/approve-ios/Approve/AppState.swift",
    reason: "app state glues the printed enrolment machine to the UI and payload persistence, and its payload half is the same unmodeled enrolment payload",
    dissolution: unbound_dissolution(description: "DISSOLVES WHEN the enrolment payload model of Charter 5 L4 (session smart-lark-63) lands and this file is printed from it, SUFFICIENT FOR a drifted payload field to be refused by the drift gate"),
  ),
]

data approve_ios_retained_swift_rows: List<FrontierRow> = concat(
  [approve_ios_views_retained, approve_ios_app_entry_retained, approve_ios_device_keys_retained],
  approve_ios_enrolment_state_frontier
)

data approve_ios_transcribed_swift_frontier: DissolutionCondition = unbound_dissolution(
  description: "the Swift syntax trees for apps/approve-ios (gunbc.approve_ios_swift_protocol, gunbc.approve_ios_swift_wire, gunbc.approve_ios_swift_protocol_vector_tests) are transcribed: their wire member names, sum arms, routes and record fields restate gunbc.auth.approval_device_wire rather than being derived from it (the protocol strings and the suite/encoding spellings of gunbc.approve_ios_swift_protocol are READ from it), so a wire change is caught only by the XCTest vectors on an operator's Mac. DISSOLVES WHEN the v2 emit route renders a module's records, coproducts and folds into Swift (the swift_decl rows through the closure-emit door, gunbc#12218) SUFFICIENT FOR the protocol layer's constants, record shapes and byte builders to be emitted from approval_device_wire, so that no approve-ios tree names a wire fact the .dag does not supply",
)

data approve_ios_bodied_member_frontier: DissolutionCondition = unbound_dissolution(
  description: "gunbc.approve_ios_swift_protocol prints the byte builders (Protocol.framedField, Protocol.framed, the transcript and client-data functions, Base64Url.encode) from AUTHORED SwiftDecl/SwiftExpr trees through the Swift rows, not through the decl door, because the decl door has no bodied member kind and so no member-gap rule (a blank line between members when either has a body, swl_gap_items in v2.extdeps.languages.swift.rows). DISSOLVES WHEN (a) the SwiftExpr/SwiftStmt families that Protocol.swift uses (string interpolation, map/joined, member access, .utf8, replacingOccurrences, array literals) are printed through swift.dag productions (migration steps 3-4 under ruling A, after the swift_expr_door of gunbc#14458 lands), and (b) the shared decl surface gains a bodied-member kind with a typed member-gap column in v2.std.compilers.semantic_decl_emission, SUFFICIENT FOR Protocol.swift's enum and struct bodies to print byte-identically through the door with the gap rule as rows and a RED that drops the gap row and reds the drift gate. Not blocked on Charter 6",
)

// WHAT IS DERIVED AND WHAT IS HAND-AUTHORED, at file grain (operator ruling 2026-09-24: model it durably):
//   DERIVED, drift-gated: apps/approve-ios/project.yml (gunbc.approve_ios_project, which also fixes
//     every Info.plist key and build setting -- XcodeGen writes Approve/Info.plist from it, so the
//     plist is derived one step further, on the Mac), and
//     dag/test/fixture/approval_device_redemption/vectors.json (gunbc.auth.approval_device_redemption_fixtures).
//   PRINTED FROM A MODELED SYNTAX TREE, drift-gated: apps/approve-ios/Approve/Protocol.swift,
//     Approve/Wire.swift and ApproveTests/ProtocolVectorTests.swift (gunbc.approve_ios_swift_protocol,
//     gunbc.approve_ios_swift_wire, gunbc.approve_ios_swift_protocol_vector_tests); the trees are
//     transcribed, named by approve_ios_transcribed_swift_frontier above.
//   PRINTED FROM A MODEL'S EVALUATION, drift-gated: Approve/EnrolmentMachine.swift (the enrolment
//     transition table) and ApproveTests/EnrolmentMachineTests.swift, both from
//     gunbc.approve_ios_swift_enrolment_machine over gunbc.approve_ios_enrolment_machine. AppState.swift
//     and EnrolmentState.swift keep only the UI glue and payload persistence, and call that table.
//     Likewise Approve/OperationErrors.swift (the error lifetime: one current error per operation,
//     cleared by its next success or by leaving the phases it is relevant in) and
//     ApproveTests/OperationErrorsTests.swift, from gunbc.approve_ios_swift_operation_errors over
//     gunbc.approve_ios_operation_errors; AppState.swift and Views.swift record every outcome into it.
//   HAND-AUTHORED REALIZATION: the other .swift files under apps/approve-ios/Approve, named by
//     approve_ios_retained_swift_rows above, and the operator-local Config/Team.xcconfig,
//     which is operator identity, not a model fact.
//
// THE iOS BUILD'S STANDING. The derived settings make warnings errors (SWIFT_TREAT_WARNINGS_AS_ERRORS,
// GCC_TREAT_WARNINGS_AS_ERRORS, SWIFT_STRICT_CONCURRENCY complete), so a build that EXECUTES cannot
// pass with a warning reintroduced. But nothing on the merge path executes it: the runners are Linux.
// So the build is evidenced only by operator-run receipts, carried below as OBSERVATIONS with
// provenance -- a row is the output of one run (the xcresult bundle it came from, the commit it
// built), never a figure retyped from a chat. A receipt is evidence for the commit it names and no
// other; it does not green a later change.

type IosTestOutcome
  = IosTestsPassed { passed: Int }
  | IosTestsFailed { failed: Int, total: Int }
  | IosTestsNotRun

type IosDeviceInstallOutcome
  = InstalledOnDevice { device_model: NonEmptyStr }
  | DeviceInstallFailed { reason: NonEmptyStr }
  | DeviceInstallNotAttempted

type IosBuildObservationProvenance {
  observer: NonEmptyStr
  built_commit: NonEmptyStr
  result_bundle_sha256: NonEmptyStr
}

type ApproveIosBuildReceipt {
  xcode: XcodeRelease
  xcode_build_number: NonEmptyStr
  sdk: NonEmptyStr
  configuration: NonEmptyStr
  warnings: Int
  tests: IosTestOutcome
  device_install: IosDeviceInstallOutcome
  observed_at: Timestamp
  provenance: IosBuildObservationProvenance
}

// EMPTY UNTIL THE FIRST RECEIPT IS OBSERVED. The Mac verification of 2026-09-24 (0 warnings,
// ApproveTests 18/18 on a simulator) reached this lane as a relayed sentence, without its result
// bundle, SDK, build number or commit -- so it is not entered: a row without its provenance would be
// exactly the transcription this carrier exists to refuse.
data approve_ios_build_receipts: List<ApproveIosBuildReceipt> = []

type ApproveIosBuildStanding
  = NotExecutedByAnyRequiredLane { latest_receipt: Optional<ApproveIosBuildReceipt>, trigger: DissolutionCondition }

fn approve_ios_build_standing() -> ApproveIosBuildStanding {
  NotExecutedByAnyRequiredLane {
    latest_receipt: fold(approve_ios_build_receipts, init: Absent, f: (acc, r) => Present { value: r }),
    trigger: approve_ios_build_unexecuted_frontier,
  }
}

data approve_ios_build_unexecuted_frontier: DissolutionCondition = unbound_dissolution(
  description: "the iOS build is not executed by any required lane: apps/approve-ios builds only on an operator's Mac, so a Swift or project change can land without ever compiling, and approve_ios_build_receipts evidences only the commits it names. DISSOLVES WHEN a macOS runner executes the derived project build (xcodegen generate over gunbc.approve_ios_project, then xcodebuild build and test with the derived warnings-as-errors settings) on the required gate, SUFFICIENT FOR a warning, a compile error or a failing ApproveTests case to red the merge path; this also discharges arm (a) of approve_ios_vector_check_unenrolled_frontier",
)
