module gunbc.stage0_emit_plan

import gunbc.stage0_crate_layout_generated { generated_stage0_filenames }
import extdeps.languages.rust.emit {
  rust_qualified_module_mod_basename,
  rust_qualified_module_mod_filename
}
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.disposition { Disposition, RealizationDispatch, Scaffold }
import std.types { List, String }

type Stage0SourceTree
  = V1SourceTree
  | DagSourceTree

type Stage0SourceIdentityProvenance
  = ParsedFromRegenSourceClosure
  | SourceIdentityUnavailable

type Stage0SourceModuleIdentity {
  module_path: String
  storage_path: String
  source_tree: Stage0SourceTree
  provenance: Stage0SourceIdentityProvenance
}

type Stage0ProducedFileKind
  = ModuleProjection
  | CompilerSupportProjection

type Stage0ProducedFileIdentity {
  producer_identity: String
  basename: String
  kind: Stage0ProducedFileKind
}

type Stage0ProjectionDisposition
  = GeneratedProjection
  | HandMaintainedCandidate

type Stage0EmissionPlanRow {
  produced: Stage0ProducedFileIdentity
  disposition: Stage0ProjectionDisposition
  canonical_repo_path: String
}

data stage0_projection_disposition_authority_note: String = "GeneratedProjection versus HandMaintainedCandidate derives from gunbc.stage0_crate_layout_generated.generated_stage0_filenames, the enrolled projection of v2.compiler.self_host.frontier seed-retained facts. This module never owns a second exclusion list."

data stage0_source_identity_supply_scaffold_note: String = "DECLARED SCAFFOLD. stage0_emission_source_identities_host observes SOURCE only: the Rust seed walks gunbc.cli_run.regen_input_sources and parses every row through the source-authority-aligned module binding parser. It must never observe EmitResult or share the emit-output path. DISSOLVE-ON: generated_artifact_gate accepts a v2.compiler.source_authority.ModuleStorageIndex; then this host builtin and this scaffold carrier delete, and the same pure folds consume that index directly."

data stage0_source_identity_non_seed_refusal_note: String = "The authored body is Empty deliberately: the native seed intercepts this scaffold spelling before evaluation; a realization without that declared host supply derives only the three compiler-support rows and fails the generated-count/exact-agreement walls. It never fabricates plausible source identities."

data stage0_source_identity_supply_disposition: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.stage0_emit_plan",
    decl_name: "stage0_emission_source_identities_host",
    field: WholeDeclaration
  }
}

data stage0_source_identity_supply_dissolution_trigger: String = "dissolve-on: generated_artifact_gate accepts a v2.compiler.source_authority.ModuleStorageIndex; then stage0_emission_source_identities_host and its Rust interpreter arm delete, and stage0_emission_plan_from_source consumes the supplied index projection directly."

fn stage0_emission_source_identities_host() -> List<Stage0SourceModuleIdentity> {
  []
}

fn stage0_module_emit_basename(module_path: String) -> String {
  rust_qualified_module_mod_basename(qualified_module: module_path)
}

fn stage0_module_emit_filename(module_path: String) -> String {
  rust_qualified_module_mod_filename(qualified_module: module_path)
}

fn module_produced_file(identity: Stage0SourceModuleIdentity) -> Stage0ProducedFileIdentity {
  Stage0ProducedFileIdentity {
    producer_identity: identity.module_path,
    basename: stage0_module_emit_filename(module_path: identity.module_path),
    kind: ModuleProjection
  }
}

data stage0_compiler_support_file_identities: List<Stage0ProducedFileIdentity> = [
  Stage0ProducedFileIdentity {
    producer_identity: "rust-crate-library-root",
    basename: "lib.rs",
    kind: CompilerSupportProjection
  },
  Stage0ProducedFileIdentity {
    producer_identity: "rust-runtime-support",
    basename: "v1_rt.rs",
    kind: CompilerSupportProjection
  },
  Stage0ProducedFileIdentity {
    producer_identity: "compiler-test-harness",
    basename: "compiler_tests.rs",
    kind: CompilerSupportProjection
  }
]

fn stage0_produced_file_identities_from_source(
  identities: List<Stage0SourceModuleIdentity>
) -> List<Stage0ProducedFileIdentity> {
  concat(
    identities |> map(identity => module_produced_file(identity: identity)),
    stage0_compiler_support_file_identities
  ) |> sort_by(row => row.basename)
}

fn stage0_file_disposition(basename: String) -> Stage0ProjectionDisposition {
  if generated_stage0_filenames |> any(file => file == basename) {
    HandMaintainedCandidate
  } else {
    GeneratedProjection
  }
}

fn stage0_canonical_repo_path(basename: String) -> String {
  concat("src/v1/stage0/src/", basename)
}

fn stage0_emission_plan_from_source(
  identities: List<Stage0SourceModuleIdentity>
) -> List<Stage0EmissionPlanRow> {
  stage0_produced_file_identities_from_source(identities: identities)
    |> map(produced => Stage0EmissionPlanRow {
         produced: produced,
         disposition: stage0_file_disposition(basename: produced.basename),
         canonical_repo_path: stage0_canonical_repo_path(basename: produced.basename)
       })
}

fn stage0_emission_plan() -> List<Stage0EmissionPlanRow> {
  stage0_emission_plan_from_source(identities: stage0_emission_source_identities_host())
}

fn empty_stage0_string_list() -> List<String> {
  []
}

fn generated_stage0_files_from_plan_rows(rows: List<Stage0EmissionPlanRow>) -> List<String> {
  fold(rows, init: empty_stage0_string_list(), f: fn(acc, row) {
    match row.disposition {
      GeneratedProjection => concat(acc, [row.produced.basename])
      HandMaintainedCandidate => acc
    }
  })
}

fn generated_stage0_paths_from_plan_rows(rows: List<Stage0EmissionPlanRow>) -> List<String> {
  fold(rows, init: empty_stage0_string_list(), f: fn(acc, row) {
    match row.disposition {
      GeneratedProjection => concat(acc, [row.canonical_repo_path])
      HandMaintainedCandidate => acc
    }
  })
}

fn generated_stage0_files_from_emission_plan() -> List<String> {
  generated_stage0_files_from_plan_rows(rows: stage0_emission_plan())
}

fn generated_stage0_paths_from_emission_plan() -> List<String> {
  generated_stage0_paths_from_plan_rows(rows: stage0_emission_plan())
}

fn stage0_generated_output_sets_agree(
  modeled: List<String>,
  observed: List<String>
) -> Bool {
  (modeled |> sort_by(path => path)) == (observed |> sort_by(path => path))
}
