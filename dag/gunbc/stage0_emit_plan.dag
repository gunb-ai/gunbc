module gunbc.stage0_emit_plan


type Stage0SourceTree
  = V1SourceTree
  | DagSourceTree

type Stage0SourceIdentityProvenance
  = ParsedFromRegenSourceClosure
  | SourceIdentityUnavailable

type Stage0SourceModuleIdentity {
  module_path: String
  storage_path: String
  source_tree: Stage0SourceTree
  provenance: Stage0SourceIdentityProvenance
}

type Stage0SourceIdentitySupply
  = Stage0SourceIdentitySupplyAvailable { identities: List<Stage0SourceModuleIdentity> }
  | Stage0SourceIdentitySupplyUnavailable { cause: String }

type Stage0ProducedFileKind
  = ModuleProjection
  | CompilerSupportProjection

type Stage0ProducedFileIdentity {
  producer_identity: String
  basename: String
  kind: Stage0ProducedFileKind
}

type Stage0ProjectionDisposition
  = GeneratedProjection
  | HandMaintainedCandidate

type Stage0EmissionPlanRow {
  produced: Stage0ProducedFileIdentity
  disposition: Stage0ProjectionDisposition
  canonical_repo_path: String
}

type Stage0EmissionPlanRefusalCause
  = SourceIdentitySupplyUnavailableRefusal { cause: String }
  | SourceIdentityUnavailableRefusal {
      module_path: String,
      storage_path: String
    }
  | Stage0OutputPathCollision {
      path: String,
      first_producer: String,
      duplicate_producer: String
    }

type Stage0EmissionPlanOutcome
  = Stage0EmissionPlanAccepted { rows: List<Stage0EmissionPlanRow> }
  | Stage0EmissionPlanRefused { cause: Stage0EmissionPlanRefusalCause }

type GeneratedStage0FilesOutcome
  = GeneratedStage0FilesAvailable { files: List<String> }
  | GeneratedStage0FilesRefused { cause: Stage0EmissionPlanRefusalCause }

data stage0_projection_disposition_authority_note: String = "GeneratedProjection versus HandMaintainedCandidate derives from gunbc.stage0_crate_layout_generated.generated_stage0_filenames, the enrolled projection of v2.compiler.self_host.stage0_crate_layout hand-maintained filename facts (carved out of the deleted self-host frontier roster, which is where this projection used to source them). This module never owns a second exclusion list."

data stage0_source_identity_supply_scaffold_note: String = "DECLARED SCAFFOLD. stage0_emission_source_identities_host observes SOURCE only: the Rust seed walks gunbc.cli_run.regen_input_sources and parses every row through the source-authority-aligned module binding parser. It must never observe EmitResult or share the emit-output path. DISSOLVE-ON: generated_artifact_gate accepts a v2.compiler.source_authority.ModuleStorageIndex; then this host builtin and this scaffold carrier delete, and the same pure folds consume that index directly."

data stage0_source_identity_non_seed_refusal_note: String = "The authored body is explicitly Unavailable: absence of the native source-side realization flows as a typed refusal through planning and artifact generation, and is structurally incapable of producing bytes for main_wet to write."

data stage0_source_identity_supply_disposition: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.stage0_emit_plan",
    decl_name: "stage0_emission_source_identities_host",
    field: WholeDeclaration
  }
}

data stage0_source_identity_supply_dissolution_trigger: DissolutionCondition = unbound_dissolution(description: "dissolve-on: generated_artifact_gate accepts a v2.compiler.source_authority.ModuleStorageIndex; then stage0_emission_source_identities_host and its Rust interpreter arm delete, and stage0_emission_plan_from_source consumes the supplied index projection directly.")

data stage0_source_identity_supply_hand_rust_receipt: String = "HAND-RUST GATE — one checkable EXPLICIT-DEFERRAL receipt for this declared source-supply scaffold and its execution evidence. WHAT GROWS: src/v1/stage0/src/cli_run.rs adds the Stage0EmissionSourceIdentity transport, cache, and stage0_emission_source_identities; src/v1/stage0/src/v1_interpreter.rs adds the matching builtin arm; src/v1/stage0/src/bin/regen_stage0.rs adds the second-direction exact-set RED and repoints its projection-reader test; src/v1/stage0/src/module_path_index/index.rs adds the source-binding parser witness. At this increment, `git diff --numstat origin/main -- src/v1/stage0/src/bin/regen_stage0.rs src/v1/stage0/src/cli_run.rs src/v1/stage0/src/module_path_index/index.rs src/v1/stage0/src/v1_interpreter.rs` reports 37/17, 65/0, 11/0, and 46/0 respectively, and the same four-file diff piped to `grep -cE '^\\+.*\\bfn '` reports 3: this is counted hand-Rust growth including tests, not a flat-census claim. EXPLICIT DEFERRAL: ROADMAP node v1-zero-hand-maintained-rust, modeled as ZeroHandMaintainedRust in gunbc.v1_deletion_plan.v1_exit_finish_lines. CONCRETE DISSOLUTION: when generated_artifact_gate accepts v2.compiler.source_authority.ModuleStorageIndex, the Rust transport, cache, and interpreter arm delete and stage0_emission_plan_from_source consumes the index projection directly, exactly as stage0_source_identity_supply_dissolution_trigger states; the two Rust tests remain only until their asserted seams are expressed as substrate witnesses."

fn stage0_emission_source_identities_host() -> Stage0SourceIdentitySupply {
  Stage0SourceIdentitySupplyUnavailable { cause: "source identity host supply unavailable" }
}

fn stage0_module_emit_basename(module_path: String) -> String {
  rust_qualified_module_mod_basename(qualified_module: module_path)
}

fn stage0_module_emit_filename(module_path: String) -> String {
  rust_qualified_module_mod_filename(qualified_module: module_path)
}

fn module_produced_file(identity: Stage0SourceModuleIdentity) -> Stage0ProducedFileIdentity {
  Stage0ProducedFileIdentity {
    producer_identity: identity.module_path,
    basename: stage0_module_emit_filename(module_path: identity.module_path),
    kind: ModuleProjection
  }
}

data stage0_compiler_support_file_identities: List<Stage0ProducedFileIdentity> = [
  Stage0ProducedFileIdentity {
    producer_identity: "rust-crate-library-root",
    basename: "lib.rs",
    kind: CompilerSupportProjection
  },
  Stage0ProducedFileIdentity {
    producer_identity: "rust-runtime-support",
    basename: "v1_rt.rs",
    kind: CompilerSupportProjection
  },
  Stage0ProducedFileIdentity {
    producer_identity: "compiler-test-harness",
    basename: "compiler_tests.rs",
    kind: CompilerSupportProjection
  }
]

fn stage0_file_disposition(basename: String) -> Stage0ProjectionDisposition {
  if generated_stage0_filenames |> any(file => file == basename) {
    HandMaintainedCandidate
  } else {
    GeneratedProjection
  }
}

fn stage0_canonical_repo_path(basename: String) -> String {
  concat("src/v1/stage0/src/", basename)
}

fn stage0_emission_plan_row(produced: Stage0ProducedFileIdentity) -> Stage0EmissionPlanRow {
  Stage0EmissionPlanRow {
    produced: produced,
    disposition: stage0_file_disposition(basename: produced.basename),
    canonical_repo_path: stage0_canonical_repo_path(basename: produced.basename)
  }
}

fn append_stage0_plan_row_or_refuse(
  outcome: Stage0EmissionPlanOutcome,
  row: Stage0EmissionPlanRow
) -> Stage0EmissionPlanOutcome {
  match outcome {
    Stage0EmissionPlanRefused { cause } => Stage0EmissionPlanRefused { cause: cause }
    Stage0EmissionPlanAccepted { rows } => {
      let first = fold(rows, init: "", f: fn(found, existing) {
        if found == "" && existing.canonical_repo_path == row.canonical_repo_path {
          existing.produced.producer_identity
        } else { found }
      })
      if first == "" {
        Stage0EmissionPlanAccepted { rows: concat(rows, [row]) }
      } else {
        Stage0EmissionPlanRefused {
          cause: Stage0OutputPathCollision {
            path: row.canonical_repo_path,
            first_producer: first,
            duplicate_producer: row.produced.producer_identity
          }
        }
      }
    }
  }
}

fn stage0_module_plan_rows_or_refuse(
  identities: List<Stage0SourceModuleIdentity>
) -> Stage0EmissionPlanOutcome {
  fold(
    identities,
    init: Stage0EmissionPlanAccepted { rows: [] },
    f: fn(acc, identity) {
      match acc {
        Stage0EmissionPlanRefused { cause } => Stage0EmissionPlanRefused { cause: cause }
        Stage0EmissionPlanAccepted { rows } => match identity.provenance {
          SourceIdentityUnavailable => Stage0EmissionPlanRefused {
            cause: SourceIdentityUnavailableRefusal {
              module_path: identity.module_path,
              storage_path: identity.storage_path
            }
          }
          ParsedFromRegenSourceClosure => append_stage0_plan_row_or_refuse(
            outcome: Stage0EmissionPlanAccepted { rows: rows },
            row: stage0_emission_plan_row(produced: module_produced_file(identity: identity))
          )
        }
      }
    }
  )
}

fn stage0_emission_plan_from_source(
  identities: List<Stage0SourceModuleIdentity>
) -> Stage0EmissionPlanOutcome {
  match stage0_module_plan_rows_or_refuse(identities: identities) {
    Stage0EmissionPlanRefused { cause } => Stage0EmissionPlanRefused { cause: cause }
    Stage0EmissionPlanAccepted { rows } => match fold(
      stage0_compiler_support_file_identities,
      init: Stage0EmissionPlanAccepted { rows: rows },
      f: fn(acc, produced) { append_stage0_plan_row_or_refuse(outcome: acc, row: stage0_emission_plan_row(produced: produced)) }
    ) {
      Stage0EmissionPlanRefused { cause } => Stage0EmissionPlanRefused { cause: cause }
      Stage0EmissionPlanAccepted { rows } => Stage0EmissionPlanAccepted { rows: rows |> sort_by(row => row.produced.basename) }
    }
  }
}

fn stage0_emission_plan_from_supply(supply: Stage0SourceIdentitySupply) -> Stage0EmissionPlanOutcome {
  match supply {
    Stage0SourceIdentitySupplyUnavailable { cause } => Stage0EmissionPlanRefused {
      cause: SourceIdentitySupplyUnavailableRefusal { cause: cause }
    }
    Stage0SourceIdentitySupplyAvailable { identities } => stage0_emission_plan_from_source(identities: identities)
  }
}

fn stage0_emission_plan() -> Stage0EmissionPlanOutcome {
  stage0_emission_plan_from_supply(supply: stage0_emission_source_identities_host())
}

fn empty_stage0_string_list() -> List<String> {
  []
}

fn generated_stage0_files_from_plan_rows(rows: List<Stage0EmissionPlanRow>) -> List<String> {
  fold(rows, init: empty_stage0_string_list(), f: fn(acc, row) {
    match row.disposition {
      GeneratedProjection => concat(acc, [row.produced.basename])
      HandMaintainedCandidate => acc
    }
  })
}

fn generated_stage0_paths_from_plan_rows(rows: List<Stage0EmissionPlanRow>) -> List<String> {
  fold(rows, init: empty_stage0_string_list(), f: fn(acc, row) {
    match row.disposition {
      GeneratedProjection => concat(acc, [row.canonical_repo_path])
      HandMaintainedCandidate => acc
    }
  })
}

fn generated_stage0_files_from_emission_plan() -> GeneratedStage0FilesOutcome {
  match stage0_emission_plan() {
    Stage0EmissionPlanRefused { cause } => GeneratedStage0FilesRefused { cause: cause }
    Stage0EmissionPlanAccepted { rows } => GeneratedStage0FilesAvailable {
      files: generated_stage0_files_from_plan_rows(rows: rows)
    }
  }
}

fn stage0_generated_output_sets_agree(
  modeled: List<String>,
  observed: List<String>
) -> Bool {
  (modeled |> sort_by(path => path)) == (observed |> sort_by(path => path))
}
