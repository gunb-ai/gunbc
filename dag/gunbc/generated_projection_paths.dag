module gunbc.generated_projection_paths


type GeneratedProjectionPathSource
  = CommittedGeneratedArtifact
  | Stage0EmittedRust

type GeneratedProjectionPathRow {
  path: String
  source: GeneratedProjectionPathSource
}

type GeneratedProjectionPathsRefusal
  = GeneratedProjectionPathCollision {
      path: String,
      first_source: GeneratedProjectionPathSource,
      duplicate_source: GeneratedProjectionPathSource
    }
  | GeneratedProjectionStage0PlanRefused { cause: gunbc.stage0_emit_plan.Stage0EmissionPlanRefusalCause }

type GeneratedProjectionPathsOutcome
  = GeneratedProjectionPathsAccepted { paths: List<String> }
  | GeneratedProjectionPathsRefused { cause: GeneratedProjectionPathsRefusal }

type GeneratedProjectionPathFoldOutcome
  = GeneratedProjectionPathRowsAccepted { rows: List<GeneratedProjectionPathRow> }
  | GeneratedProjectionPathRowsRefused { cause: GeneratedProjectionPathsRefusal }

fn deterministic_generated_projection_paths_from_rows(
  rows: List<GeneratedProjectionPathRow>
) -> GeneratedProjectionPathsOutcome {
  let outcome = fold(rows, init: GeneratedProjectionPathRowsAccepted { rows: [] }, f: fn(acc, row) {
    match acc {
      GeneratedProjectionPathRowsRefused { cause } => GeneratedProjectionPathRowsRefused { cause: cause }
      GeneratedProjectionPathRowsAccepted { rows: accepted } => {
        if accepted |> any(candidate => candidate.path == row.path) {
          let first_source = fold(accepted, init: row.source, f: fn(found, candidate) {
            if candidate.path == row.path { candidate.source } else { found }
          })
          GeneratedProjectionPathRowsRefused {
            cause: GeneratedProjectionPathCollision {
              path: row.path,
              first_source: first_source,
              duplicate_source: row.source
            }
          }
        } else {
          GeneratedProjectionPathRowsAccepted { rows: concat(accepted, [row]) }
        }
      }
    }
  })
  match outcome {
    GeneratedProjectionPathRowsRefused { cause } => GeneratedProjectionPathsRefused { cause: cause }
    GeneratedProjectionPathRowsAccepted { rows } => GeneratedProjectionPathsAccepted {
      paths: rows |> map(row => row.path) |> sort_by(path => path)
    }
  }
}

fn deterministic_generated_projection_paths_from_stage0_plan(
  outcome: gunbc.stage0_emit_plan.Stage0EmissionPlanOutcome
) -> GeneratedProjectionPathsOutcome {
  let committed = committed_generated_artifact_paths()
    |> map(path => GeneratedProjectionPathRow { path: path, source: CommittedGeneratedArtifact })
  match outcome {
    Stage0EmissionPlanRefused { cause } => GeneratedProjectionPathsRefused {
      cause: GeneratedProjectionStage0PlanRefused { cause: cause }
    }
    Stage0EmissionPlanAccepted { rows } => {
      let stage0 = generated_stage0_paths_from_plan_rows(rows: rows)
        |> map(path => GeneratedProjectionPathRow { path: path, source: Stage0EmittedRust })
      deterministic_generated_projection_paths_from_rows(rows: concat(committed, stage0))
    }
  }
}

fn deterministic_generated_projection_paths() -> GeneratedProjectionPathsOutcome {
  deterministic_generated_projection_paths_from_stage0_plan(outcome: stage0_emission_plan())
}
