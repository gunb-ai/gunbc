module gunbc.generated_projection_paths

import gunbc.generated_artifact { committed_generated_artifact_paths }
import std.types { List, String }

data generated_projection_stage0_retirement_note: String = "THE STAGE0 RUST HALF OF THIS JOIN IS RETIRED WITH THE v1 CUT, AND THE SOURCE AXIS IS NOW SINGLE-VALUED. It formerly joined committed generated artifacts with plan-derived stage0 Rust paths, refusing duplicates across the two. That second half was derived from gunbc.stage0_emit_plan over parse-derived src/v1 source identities — the regen loop's own output roster — and the v1 cut deleted both the src/v1 .dag authority and regen_stage0. A path is a generated projection because something can re-derive it; with no generator, src/v1/stage0/src/**.rs is frozen seed source, so its merge=generated-artifact policy rows and their auto-resolve licence retire rather than migrate (the same fact that retired the stage0 half of the heal job's skew-guard exclusion set). RECEIPT, at identity grain: 140 stage0 rows left .gitattributes through this live derivation with no hand edit, and the two survivors — compiler_tests.rs and bootstrap_stage0_crate_layout_generated.rs — remain only because they are registry artifacts in their own right, not because they are stage0. The collision refusal below is KEPT: it is a property of the path set, not of the second source, and it stays discriminating under synthetic rows.

THE SOURCE AXIS IS DISSOLVED RATHER THAN LEFT ONE-VALUED, and the substrate is what settled it. The first cut of this retirement kept GeneratedProjectionPathSource as a single-variant coproduct on the theory that the axis is where a future second source re-enters. It does not typecheck: `type A = B` with one arm is an ALIAS, so the compiler read it as an alias to an undefined type and refused with `unresolved type CommittedGeneratedArtifact` — a one-valued discriminant has no constructor form to be written in. That is the right answer independently of the diagnostic: a field with one inhabitant carries no information and is the anemic axis DESIGN §2 says to remove, so the row is now just a path. A second source re-enters by re-introducing the axis with both its arms at once, which is when it first means anything."

type GeneratedProjectionPathRow {
  path: String
}

type GeneratedProjectionPathsRefusal
  = GeneratedProjectionPathCollision { path: String }

type GeneratedProjectionPathsOutcome
  = GeneratedProjectionPathsAccepted { paths: List<String> }
  | GeneratedProjectionPathsRefused { cause: GeneratedProjectionPathsRefusal }

type GeneratedProjectionPathFoldOutcome
  = GeneratedProjectionPathRowsAccepted { rows: List<GeneratedProjectionPathRow> }
  | GeneratedProjectionPathRowsRefused { cause: GeneratedProjectionPathsRefusal }

fn deterministic_generated_projection_paths_from_rows(
  rows: List<GeneratedProjectionPathRow>
) -> GeneratedProjectionPathsOutcome {
  let outcome = fold(rows, init: GeneratedProjectionPathRowsAccepted { rows: [] }, f: fn(acc, row) {
    match acc {
      GeneratedProjectionPathRowsRefused { cause } => GeneratedProjectionPathRowsRefused { cause: cause }
      GeneratedProjectionPathRowsAccepted { rows: accepted } => {
        if accepted |> any(candidate => candidate.path == row.path) {
          GeneratedProjectionPathRowsRefused {
            cause: GeneratedProjectionPathCollision { path: row.path }
          }
        } else {
          GeneratedProjectionPathRowsAccepted { rows: concat(accepted, [row]) }
        }
      }
    }
  })
  match outcome {
    GeneratedProjectionPathRowsRefused { cause } => GeneratedProjectionPathsRefused { cause: cause }
    GeneratedProjectionPathRowsAccepted { rows } => GeneratedProjectionPathsAccepted {
      paths: rows |> map(row => row.path) |> sort_by(path => path)
    }
  }
}

fn deterministic_generated_projection_paths() -> GeneratedProjectionPathsOutcome {
  deterministic_generated_projection_paths_from_rows(
    rows: committed_generated_artifact_paths()
      |> map(path => GeneratedProjectionPathRow { path: path })
  )
}
