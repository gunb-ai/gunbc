module gunbc.host_custody_export_receipt

import std.types { NonEmptyStr, String, Bool, Int, List }
import std.optional { Present, Absent }
import std.algebra { trim }
import std.content_hash { Sha256DigestHex, sha256_hex_digest }
import std.dissolution { DissolutionCondition, bound_dissolution }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import product.host_identity { HostIdentity }
import extdeps.cloud.gcp.secret_ref { SecretRef }
import extdeps.cloud.gcp.secret_manager {
  SmResolvedVersionIdentity,
  decode_sm_resolved_version_identity_wire,
  SmResolvedVersionIdentityDecoded,
  SmResolvedVersionIdentityDecodeRefused,
}

data host_custody_export_receipt_suffix: String = ".gunbc-export-receipt"

fn host_custody_export_receipt_path(placed_path: NonEmptyStr) -> NonEmptyStr {
  concat(placed_path as String, host_custody_export_receipt_suffix) as NonEmptyStr
}

data host_custody_export_generation_standing: String = "the exact generation deployed by managed custody"

data host_custody_export_receipt_header: String = "HostCustodyExportReceipt"

type HostCustodyExportReceipt {
  sm_version: SmResolvedVersionIdentity
  host: HostIdentity
  placement: NonEmptyStr
  reader: NonEmptyStr
  publisher: NonEmptyStr
  content_sha256: Sha256DigestHex
}

fn host_custody_export_receipt_wire(receipt: HostCustodyExportReceipt) -> String {
  join([
    host_custody_export_receipt_header, "\n",
    "sm_version=", receipt.sm_version as String, "\n",
    "host=", receipt.host as String, "\n",
    "placement=", receipt.placement as String, "\n",
    "reader=", receipt.reader as String, "\n",
    "publisher=", receipt.publisher as String, "\n",
    "content_sha256=", receipt.content_sha256 as String, "\n",
    "generation_standing=", host_custody_export_generation_standing, "\n",
  ], "")
}

type HostCustodyExportReceiptDecodeRefusal
  = ReceiptWireMissingHeader
  | ReceiptWireMissingField { field: NonEmptyStr }
  | ReceiptWireDuplicatedField { field: NonEmptyStr }
  | ReceiptWireUnknownField { field: String }
  | ReceiptWireDigestNotSha256
  | ReceiptWireVersionNotIdentity
  | ReceiptWireGenerationStandingMismatch

type HostCustodyExportReceiptDecode
  = HostCustodyExportReceiptDecoded { receipt: HostCustodyExportReceipt }
  | HostCustodyExportReceiptDecodeRefused { cause: HostCustodyExportReceiptDecodeRefusal }

data receipt_wire_keys: List<String> = [
  "sm_version",
  "host",
  "placement",
  "reader",
  "publisher",
  "content_sha256",
  "generation_standing",
]

fn receipt_wire_lines(text: String) -> List<String> {
  filter(map(split(s: text, delimiter: "\n"), l => trim(s: l)), l => l != "")
}

fn receipt_wire_line_key(line: String) -> String? {
  match split(s: line, delimiter: "=") |> first {
    Absent => none
    Present { value: k } =>
      if k == line {
        none
      } else {
        Present { value: k }
      }
  }
}

fn receipt_wire_line_value(line: String) -> String {
  match split(s: line, delimiter: "=") |> skip(n: 1) |> first {
    Absent => ""
    Present { value: rest } => join(split(s: line, delimiter: "=") |> skip(n: 1), "=")
  }
}

fn receipt_wire_key_count(lines: List<String>, key: String) -> Int {
  count(filter(lines, l => starts_with(s: l, prefix: concat(key, "="))))
}

fn receipt_wire_value(lines: List<String>, key: String) -> String {
  match filter(lines, l => starts_with(s: l, prefix: concat(key, "="))) |> first {
    Absent => ""
    Present { value: line } => receipt_wire_line_value(line: line)
  }
}

fn receipt_wire_key_known(key: String) -> Bool {
  any(receipt_wire_keys, k => k == key)
}

fn receipt_wire_first_unknown(lines: List<String>) -> String? {
  fold(lines, init: none, f: (acc, line) =>
    match acc {
      Present { value: _ } => acc
      Absent =>
        if line == host_custody_export_receipt_header {
          none
        } else {
          match receipt_wire_line_key(line: line) {
            Absent => Present { value: line }
            Present { value: k } =>
              if receipt_wire_key_known(key: k) {
                none
              } else {
                Present { value: k }
              }
          }
        }
    }
  )
}

fn receipt_wire_first_duplicate(lines: List<String>) -> String? {
  fold(receipt_wire_keys, init: none, f: (acc, key) =>
    match acc {
      Present { value: _ } => acc
      Absent =>
        if receipt_wire_key_count(lines: lines, key: key) > 1 {
          Present { value: key }
        } else {
          none
        }
    }
  )
}

fn receipt_wire_first_missing(lines: List<String>) -> String? {
  fold(receipt_wire_keys, init: none, f: (acc, key) =>
    match acc {
      Present { value: _ } => acc
      Absent =>
        if receipt_wire_key_count(lines: lines, key: key) == 0 {
          Present { value: key }
        } else {
          none
        }
    }
  )
}

fn host_custody_export_receipt_decode(text: String) -> HostCustodyExportReceiptDecode {
  let lines = receipt_wire_lines(text: text)
  match lines |> first {
    Absent => HostCustodyExportReceiptDecodeRefused { cause: ReceiptWireMissingHeader }
    Present { value: first_line } =>
      if first_line != host_custody_export_receipt_header {
        HostCustodyExportReceiptDecodeRefused { cause: ReceiptWireMissingHeader }
      } else {
        match receipt_wire_first_unknown(lines: lines) {
          Present { value: k } => HostCustodyExportReceiptDecodeRefused { cause: ReceiptWireUnknownField { field: k } }
          Absent =>
            match receipt_wire_first_duplicate(lines: lines) {
              Present { value: k } => HostCustodyExportReceiptDecodeRefused { cause: ReceiptWireDuplicatedField { field: k as NonEmptyStr } }
              Absent =>
                match receipt_wire_first_missing(lines: lines) {
                  Present { value: k } => HostCustodyExportReceiptDecodeRefused { cause: ReceiptWireMissingField { field: k as NonEmptyStr } }
                  Absent => host_custody_export_receipt_decode_fields(lines: lines)
                }
            }
        }
      }
  }
}

fn host_custody_export_receipt_decode_fields(lines: List<String>) -> HostCustodyExportReceiptDecode {
  let standing = receipt_wire_value(lines: lines, key: "generation_standing")
  if standing != host_custody_export_generation_standing {
    HostCustodyExportReceiptDecodeRefused { cause: ReceiptWireGenerationStandingMismatch }
  } else {
    let host_text = receipt_wire_value(lines: lines, key: "host")
    let placement_text = receipt_wire_value(lines: lines, key: "placement")
    let reader_text = receipt_wire_value(lines: lines, key: "reader")
    let publisher_text = receipt_wire_value(lines: lines, key: "publisher")
    if host_text == "" || placement_text == "" || reader_text == "" || publisher_text == "" {
      HostCustodyExportReceiptDecodeRefused { cause: ReceiptWireMissingField { field: "nonempty" as NonEmptyStr } }
    } else {
      match decode_sm_resolved_version_identity_wire(name: receipt_wire_value(lines: lines, key: "sm_version")) {
        SmResolvedVersionIdentityDecodeRefused { cause: _ } =>
          HostCustodyExportReceiptDecodeRefused { cause: ReceiptWireVersionNotIdentity }
        SmResolvedVersionIdentityDecoded { identity } =>
          match sha256_hex_digest(hex: receipt_wire_value(lines: lines, key: "content_sha256")) {
            Absent => HostCustodyExportReceiptDecodeRefused { cause: ReceiptWireDigestNotSha256 }
            Present { value: d } =>
              HostCustodyExportReceiptDecoded {
                receipt: HostCustodyExportReceipt {
                  sm_version: identity,
                  host: host_text as HostIdentity,
                  placement: placement_text as NonEmptyStr,
                  reader: reader_text as NonEmptyStr,
                  publisher: publisher_text as NonEmptyStr,
                  content_sha256: d.hex,
                },
              }
          }
      }
    }
  }
}

type SnapshotCustodyDeclaration {
  path: NonEmptyStr
  secret: SecretRef
  host: HostIdentity
  reader: NonEmptyStr
  publisher: NonEmptyStr
}

data host_custody_export_receipt_reader_frontier: DissolutionCondition = bound_dissolution(
  ref: DeclarationRef {
    module_path: "gunbc.dispatch_credential_snapshot" as NonEmptyStr,
    decl_name: "dispatch_credential_snapshot_take" as NonEmptyStr,
    field: WholeDeclaration,
  },
)
