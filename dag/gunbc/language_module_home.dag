data legacy_flat_module_note: String = "THE EXACT FINITE FRONTIER. Four rows, enumerated by walking dag/extdeps/languages for files sitting directly in it rather than in a target directory, verified against the live tree on 2026-08-05 rather than transcribed from a report. Each row names the file as it exists today, the target whose surface it implements, and the address a move should land at. The roster is EXACT and the wall reads it by equality, so this is not a prefix or a pattern: a flat module absent from these four rows refuses. That is what makes the frontier finite rather than a category that can quietly grow — the failure mode the scope frontier's own frozen manifest exists to prevent, applied one directory down."

type LegacyLanguageModuleHome {
  file_path: String
  module_path: String
  target: std.decl_ref.DeclarationRef
  moves_to: String
  dissolution: std.dissolution.DissolutionCondition
}

