type LanguageDirectoryWithoutRegisteredTarget {
  prefix: String
  reason: String
}

data unregistered_target_directory_note: String = "DIRECTORIES UNDER languages/ WHOSE TARGET D0 NEVER REGISTERED, declared so the wall admits them instead of refusing legitimate work. These are NOT homes — a home carries a DeclarationRef and these have no registered subject to carry — and saying so is the point: the gate must not refuse a file under dag/extdeps/languages/gpu/ merely because WGSL is absent from the registry. Enumerated by walking the live tree against the home roster on 2026-08-05: three directories were uncovered, and dag/ turned out to have a registered target after all (the project-grounded .dag language), leaving these two. THEY ARE ALSO A REGISTRY FINDING, which is the more useful reading: each names a language this repository carries surfaces for and has no cited subject declaration for, so they are candidates for the same treatment D0 gave the other twenty-five rather than permanent exceptions. That is why each row states what the directory is for rather than merely naming it."

data unregistered_target_directories: List<LanguageDirectoryWithoutRegisteredTarget> = [
  LanguageDirectoryWithoutRegisteredTarget {
    prefix: "dag/extdeps/languages/gpu/",
    reason: "holds a wgsl subtree; WGSL is a W3C shading language with its own upstream and no registered subject in this repository, so it has no home row to be checked against"
  },
  LanguageDirectoryWithoutRegisteredTarget {
    prefix: "dag/extdeps/languages/simd/",
    reason: "holds a SIMD kernel surface; the kernel vocabulary has no single independently governed upstream identified for it and no registered subject, so it has no home row to be checked against"
  }
]

data legacy_flat_module_note: String = "THE EXACT FINITE FRONTIER. Four rows, enumerated by walking dag/extdeps/languages for files sitting directly in it rather than in a target directory, verified against the live tree on 2026-08-05 rather than transcribed from a report. Each row names the file as it exists today, the target whose surface it implements, and the address a move should land at. The roster is EXACT and the wall reads it by equality, so this is not a prefix or a pattern: a flat module absent from these four rows refuses. That is what makes the frontier finite rather than a category that can quietly grow — the failure mode the scope frontier's own frozen manifest exists to prevent, applied one directory down."

type LegacyLanguageModuleHome {
  file_path: String
  module_path: String
  target: DeclarationRef
  moves_to: String
  dissolves_on: String
}

