  }
]

type FlatModuleVerdict
  = FlatModuleOnFrontier { file_path: String, moves_to: String }
  | FlatModuleRefused { file_path: String }


data flat_module_refusal_note: String = "THE WALL, AND WHY ITS FAILURE ARM REFUSES RATHER THAN WIDENS. A flat language module is admitted ONLY by exact membership in the frontier above; anything else is FlatModuleRefused carrying the offending path, which is typed and located rather than a Bool. There is no arm that admits an unrecognised flat module, no allowance keyed on a name pattern, and no toggle — the three shapes DESIGN section 5 rules out. THE CONSEQUENCE, ENFORCED RATHER THAN INTENDED: a new target-specific module authored flat beside the target directories cannot land, so the population this frontier freezes can only shrink, because tools.extdeps_scope_placement_gate calls added_language_paths_refused on the paths this change adds and exits failure naming them. AN EARLIER REVISION CLAIMED THAT CONSEQUENCE WHILE NOTHING CALLED THE PREDICATE (cursor review 48516, and the parent lane found it independently). That is the coverage-by-illusion tier DESIGN section 6 names — machinery exists, nothing gates on it, and an inert lens is itself a lie — with the sentence asserting the wall being the only thing that made it look otherwise. Caught in review, not by me. A module inside a target directory is not a flat module and is never consulted here, which is the whole point — the wall constrains where NEW surfaces go without touching the twenty-five directories D0 created."

fn classify_flat_module(file_path: String) -> FlatModuleVerdict {
  fold(
    legacy_language_module_homes,
    init: FlatModuleRefused { file_path: file_path },
    f: fn(acc, r) {
      if r.file_path == file_path {
        FlatModuleOnFrontier { file_path: r.file_path, moves_to: r.moves_to }
      } else {
        acc
      }
    }
  )
}

fn flat_module_admitted(file_path: String) -> Bool {
  match classify_flat_module(file_path: file_path) {
    FlatModuleOnFrontier { file_path: _, moves_to: _ } => true,
    FlatModuleRefused { file_path: _ } => false
  }
}

fn every_flat_module_is_on_the_frontier(walked_flat_paths: List<String>) -> Bool {
  all(walked_flat_paths, p => flat_module_admitted(file_path: p))
}

data language_root_prefix: String = "dag/extdeps/languages/"

data added_path_admission_note: String = "THE GATE PREDICATE. A path added under dag/extdeps/languages/ is ADMITTED if it sits inside some declared target directory or is one of the four exact legacy frontier rows; everything else under that root REFUSES. Paths outside that root are not judged here at all, and that is now stated rather than left as an accident of the prefix test. THE SHAPE IS AN ADMISSION AGAINST DECLARED ROSTERS, NOT A FLATNESS TEST, deliberately: deciding whether a path is 'flat' from a string means splitting it into segments and then reasoning about what a segment denotes, which is one step from reading a target off a directory name. Admission reaches the same outcome without the identity question ever being asked. WHAT IT ENFORCES, EXACTLY: a new module authored directly in dag/extdeps/languages/ refuses, and a new directory under that root refuses until a home for its target is declared in the same change. WHAT IT DOES NOT ENFORCE: which of the declared directories a given module belongs in. It admits membership in SOME declared home because a path string is all it receives."

fn path_under_any_declared_home(file_path: String) -> Bool {
  fold(language_target_homes, init: false, f: fn(acc, h) {
    acc || starts_with(s: file_path, prefix: h.canonical_prefix)
  })
}

fn added_language_path_admitted(file_path: String) -> Bool {
  if starts_with(s: file_path, prefix: language_root_prefix) {
    path_under_any_declared_home(file_path: file_path)
      || flat_module_admitted(file_path: file_path)
  } else {
    true
  }
}

fn added_language_paths_refused(added: List<String>) -> List<String> {
  fold(added, init: [], f: fn(acc, p) {
    if added_language_path_admitted(file_path: p) { acc } else { concat(acc, [p]) }
  })
}

fn legacy_flat_module_count() -> Int {
  fold(legacy_language_module_homes, init: 0, f: fn(acc, r) { acc + 1 })
}

data language_module_home_maximum_conclusion: String = "MAXIMUM CONCLUSION — what a green check here establishes and what it cannot. IT ESTABLISHES that every path this change adds under dag/extdeps/languages/ lies inside a declared target directory or is an exact legacy frontier row, so a new flat module and a new undeclared target directory both refuse. IT DOES NOT ESTABLISH THAT A FILE SITS UNDER THE RIGHT TARGET'S DIRECTORY — the gate receives path strings and no module's declared subject, so an emitter for one language placed under another language's directory passes. That is the wall's edge, not a hidden arm: closing it requires a placement observation carrying (file_path, target) resolved from the file's own extdeps_model_scope, which is a separate change. IT DOES NOT ESTABLISH that the four frontier rows are the complete flat population of the live tree: the gate reads what a change ADDS at merge-base grain, so it governs what enters and says nothing about what already sits there. NOR DOES IT ESTABLISH that any target's surfaces are complete or correctly grouped. The construction-side end state is the one the module-identity-versus-storage lane names: when a module's home is derived from the containment tree rather than declared beside it, this frontier and its predicate both delete."
