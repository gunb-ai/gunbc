// THE EXACT FINITE FRONTIER. Four rows, enumerated by walking dag/extdeps/languages for files
// sitting directly in it rather than in a target directory, verified against the live tree on
// 2026-08-05 rather than transcribed from a report. Each row names the file as it exists today, the
// target whose surface it implements, and the address a move should land at. The wall reads the
// roster by equality, not prefix or pattern: a flat module absent from these four rows refuses.
// That keeps the frontier finite rather than a category that can quietly grow — the scope
// frontier's frozen manifest, applied one directory down.

type LegacyLanguageModuleHome {
  file_path: String
  module_path: String
  target: DeclarationRef
  moves_to: String
  dissolution: DissolutionCondition
}

data legacy_language_module_homes: List<LegacyLanguageModuleHome> = [
  LegacyLanguageModuleHome {
    file_path: "dag/extdeps/languages/html.dag",
    module_path: "extdeps.languages.html",
    target: html_language_subject_ref,
    moves_to: "dag/extdeps/languages/html/medium.dag",
    dissolution: unbound_dissolution(description: "a typed move receipt records the file at its canonical address and this row deletes")
  },
  LegacyLanguageModuleHome {
    file_path: "dag/extdeps/languages/html_fragment.dag",
    module_path: "extdeps.languages.html_fragment",
    target: html_language_subject_ref,
    moves_to: "dag/extdeps/languages/html/fragment.dag",
    dissolution: unbound_dissolution(description: "a typed move receipt records the file at its canonical address and this row deletes")
  },
  LegacyLanguageModuleHome {
    file_path: "dag/extdeps/languages/markdown.dag",
    module_path: "extdeps.languages.markdown",
    target: commonmark_format_subject_ref,
    moves_to: "dag/extdeps/languages/markdown/commonmark_emit.dag",
    dissolution: unbound_dissolution(description: "a typed move receipt records the file at its canonical address and this row deletes")
  },
  LegacyLanguageModuleHome {
    file_path: "dag/extdeps/languages/react_jsx.dag",
    module_path: "extdeps.languages.react_jsx",
    target: jsx_language_subject_ref,
    moves_to: "dag/extdeps/languages/jsx/emit.dag",
    dissolution: unbound_dissolution(description: "a typed move receipt records the file at its canonical address and this row deletes; the module name drops React, which names a framework this repository does not target, in favour of the JSX subject D0 registered")
  }
]

type FlatModuleVerdict
  = FlatModuleOnFrontier { file_path: String, moves_to: String }
  | FlatModuleRefused { file_path: String }

// THE WALL, AND WHY ITS FAILURE ARM REFUSES RATHER THAN WIDENS. A flat language module is admitted
// ONLY by exact membership in the frontier above; anything else is FlatModuleRefused carrying the
// offending path, typed and located rather than a Bool. No arm admits an unrecognised flat module,
// no allowance is keyed on a name pattern, and there is no toggle — the three shapes DESIGN section
// 5 rules out. THE CONSEQUENCE, ENFORCED RATHER THAN INTENDED: a new target-specific module
// authored flat beside the target directories cannot land, so this population can only shrink,
// because tools.extdeps_scope_placement_gate calls added_language_paths_refused on the paths a
// change adds and exits failure naming them. AN EARLIER REVISION CLAIMED THAT CONSEQUENCE WHILE
// NOTHING CALLED THE PREDICATE (cursor review 48516, and the parent lane found it independently) —
// the coverage-by-illusion tier DESIGN section 6 names: machinery exists, nothing gates on it, an
// inert lens is itself a lie. Caught in review, not by me. A module inside a target directory is
// never consulted here: the wall constrains where NEW surfaces go without touching the twenty-five
// directories D0 created.

fn classify_flat_module(file_path: String) -> FlatModuleVerdict {
  fold(
    legacy_language_module_homes,
    init: FlatModuleRefused { file_path: file_path },
    f: fn(acc, r) {
      if r.file_path == file_path {
        FlatModuleOnFrontier { file_path: r.file_path, moves_to: r.moves_to }
      } else {
        acc
      }
    }
  )
}

fn flat_module_admitted(file_path: String) -> Bool {
  match classify_flat_module(file_path: file_path) {
    FlatModuleOnFrontier { file_path: _, moves_to: _ } => true,
    FlatModuleRefused { file_path: _ } => false
  }
}

fn every_flat_module_is_on_the_frontier(walked_flat_paths: List<String>) -> Bool {
  all(walked_flat_paths, p => flat_module_admitted(file_path: p))
}

data language_root_prefix: String = "dag/extdeps/languages/"

// THE GATE PREDICATE. A path added under dag/extdeps/languages/ is ADMITTED if it sits inside some
// declared target directory or is one of the four exact legacy frontier rows; everything else under
// that root REFUSES. Paths outside that root are not judged here, stated rather than left as an
// accident of the prefix test. THE SHAPE IS AN ADMISSION AGAINST DECLARED ROSTERS, NOT A FLATNESS
// TEST: deciding 'flat' from a string means splitting segments and reasoning about what one
// denotes, one step from reading a target off a directory name. Admission reaches the same outcome
// without asking the identity question. WHAT IT ENFORCES, EXACTLY: a new module directly in
// dag/extdeps/languages/ refuses, and a new directory under that root refuses until a home for its
// target is declared in the same change. WHAT IT DOES NOT ENFORCE: which declared directory a
// given module belongs in — it admits membership in SOME declared home because a path string is
// all it receives.

fn path_under_any_declared_home(file_path: String) -> Bool {
  fold(language_target_homes, init: false, f: fn(acc, h) {
    acc || starts_with(s: file_path, prefix: h.canonical_prefix)
  })
}

fn added_language_path_admitted(file_path: String) -> Bool {
  if starts_with(s: file_path, prefix: language_root_prefix) {
    path_under_any_declared_home(file_path: file_path)
      || flat_module_admitted(file_path: file_path)
  } else {
    true
  }
}

fn added_language_paths_refused(added: List<String>) -> List<String> {
  fold(added, init: [], f: fn(acc, p) {
    if added_language_path_admitted(file_path: p) { acc } else { concat(acc, [p]) }
  })
}

// MAXIMUM CONCLUSION — what a green check establishes and what it cannot. IT ESTABLISHES that every
// path this change adds under dag/extdeps/languages/ lies inside a declared target directory or is
// an exact legacy frontier row, so a new flat module and a new undeclared target directory both
// refuse. IT DOES NOT ESTABLISH THAT A FILE SITS UNDER THE RIGHT TARGET'S DIRECTORY — the gate
// receives path strings and no declared subject, so an emitter for one language placed under
// another's directory passes. That is the wall's edge, not a hidden arm: closing it requires a
// placement observation carrying (file_path, target) resolved from the file's own
// extdeps_model_scope, a separate change. IT DOES NOT ESTABLISH that the four frontier rows are the
// complete flat population of the live tree: the gate reads what a change ADDS at merge-base
// grain, governing what enters and not what already sits there. NOR that any target's surfaces are
// complete or correctly grouped. The construction-side end state is the one the
// module-identity-versus-storage lane names: when a module's home is derived from the containment
// tree rather than declared beside it, this frontier and its predicate both delete.

fn legacy_flat_module_count() -> Int {
  fold(legacy_language_module_homes, init: 0, f: fn(acc, r) { acc + 1 })
}
