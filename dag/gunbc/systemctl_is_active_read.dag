module gunbc.systemctl_is_active_read



type UnitIsActiveCapture =
    UnitIsActiveCaptured { state: std.types.NonEmptyStr, active: Bool }
  | UnitIsActiveCaptureRefused { reason: String }

fn unit_is_active_capture_from_result(state: String, active: Bool) -> UnitIsActiveCapture {
  let trimmed = std.algebra.trim(state)
  if trimmed == "" {
    UnitIsActiveCaptureRefused { reason: "systemctl is-active returned empty stdout" }
  } else {
    UnitIsActiveCaptured { state: trimmed as std.types.NonEmptyStr, active: active }
  }
}

// THE READ SAYS WHERE AND WHAT, NEVER HOW. The four transport arms that used to live here -- local
// call, ssh argv, fleet argv, emit refusal -- are gone: they were this file's copy of a dispatch that
// belongs in the realization layer, and gunbc.host_operation_exec now owns it once for every seam.
// What remains is this file's real content: the decoder that turns one observation into a typed capture.
fn systemctl_is_active_read(transport: gunbc.host_effect.HostEffectTransport, unit: std.types.NonEmptyStr) -> UnitIsActiveCapture {
  match gunbc.host_operation_exec.host_operation_exec(transport: transport, operation: gunbc.host_operation_exec.SystemctlIsActive { unit: unit }) {
    gunbc.host_operation_exec.HostOperationObserved { stdout: out, success: ok, stderr: _ } =>
      unit_is_active_capture_from_result(state: out, active: ok)
    gunbc.host_operation_exec.HostOperationRefused { operation: _, reason: why } =>
      UnitIsActiveCaptureRefused { reason: why }
  }
}

// THE OPERATION'S IDENTITY IS NO LONGER SPELLED HERE. The path/service/operation rows and the argv
// materializer that read them moved to gunbc.host_operation_exec, where the identity is DERIVED from
// the operation rather than stored beside it -- keeping a copy here would have left the same
// operation named in two files, the section 3 fork this cut exists to close. This witness
// materializes through the same derivation the read executes, so it cannot pass against an identity
// the read does not use, and it is what would red if that derivation named the wrong operation.
fn systemctl_is_active_operation_argv_matches_authority(unit: std.types.NonEmptyStr) -> Bool {
  let authority = ["systemctl", "is-active", unit as String]
  match gunbc.host_operation_exec.host_operation_materialize_argv(operation: gunbc.host_operation_exec.SystemctlIsActive { unit: unit }) {
    v2.std.operation_argv.ArgvMaterialized { argv: materialized } => join(materialized, " ") == join(authority, " ")
    v2.std.operation_argv.ArgvMaterializationRefused { at: _, cause: _ } => false
  }
}
