module gunbc.systemctl_is_active_read

import std.algebra { trim }

import std.types { String, NonEmptyStr, List, Bool }
import gunbc.host_effect { HostEffectTransport }
import v2.std.operation_argv { ArgvMaterialized, ArgvMaterializationRefused }
import gunbc.host_operation_exec {
  HostOperationObserved,
  HostOperationRefused,
  host_operation_exec,
  host_operation_materialize_argv,
  systemctl_is_active_host_operation,
}

type UnitIsActiveCapture =
    UnitIsActiveCaptured { state: NonEmptyStr, active: Bool }
  | UnitIsActiveCaptureRefused { reason: String }

fn unit_is_active_capture_from_result(state: String, active: Bool) -> UnitIsActiveCapture {
  let trimmed = trim(state)
  if trimmed == "" {
    UnitIsActiveCaptureRefused { reason: "systemctl is-active returned empty stdout" }
  } else {
    UnitIsActiveCaptured { state: trimmed as NonEmptyStr, active: active }
  }
}

// THE READ SAYS WHERE AND WHAT, NEVER HOW. The four transport arms that used to live here -- local
// call, ssh argv, fleet argv, emit refusal -- are gone: they were this file's copy of a dispatch that
// belongs in the realization layer, and gunbc.host_operation_exec now owns it once for every seam.
// What remains is this file's real content: the decoder that turns one observation into a typed capture.
fn systemctl_is_active_read(transport: HostEffectTransport, unit: NonEmptyStr) -> UnitIsActiveCapture {
  match host_operation_exec(transport: transport, operation: systemctl_is_active_host_operation(unit: unit)) {
    HostOperationObserved { stdout: out, success: ok, stderr: _ } =>
      unit_is_active_capture_from_result(state: out, active: ok)
    HostOperationRefused { operation: _, reason: why } =>
      UnitIsActiveCaptureRefused { reason: why }
  }
}

// THE OPERATION'S IDENTITY IS NO LONGER SPELLED HERE. The path/service/operation rows and the argv
// materializer that read them moved to gunbc.host_operation_exec with the operation row itself --
// keeping a copy beside this decoder would have left the same operation named in two files, which is
// the section 3 fork this cut exists to close. This witness now materializes through the same row the
// read executes, so it can no longer pass against an identity the read does not use.
fn systemctl_is_active_operation_argv_matches_authority(unit: NonEmptyStr) -> Bool {
  let authority = ["systemctl", "is-active", unit as String]
  match host_operation_materialize_argv(operation: systemctl_is_active_host_operation(unit: unit)) {
    ArgvMaterialized { argv: materialized } => join(materialized, " ") == join(authority, " ")
    ArgvMaterializationRefused { at: _, cause: _ } => false
  }
}
