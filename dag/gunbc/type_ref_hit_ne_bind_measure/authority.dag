module gunbc.type_ref_hit_ne_bind_measure.authority

import std.dissolution { DissolutionCondition, dissolution_description, unbound_dissolution }

import std.types { String, NonEmptyStr }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data type_ref_hit_ne_bind_measure_charter_note: String = "N1a (swift-fox-347 extraction; quiet-hawk-219 / operator 2026-08-02): EXECUTING DISCRIMINATOR for the type-ref fail-open class — pool-present lookup hit is not binding authority. Under measurement mode only, a masked leaf use-site without measure-authority emits typed UnresolvedType (same construction as absent-from-pool) instead of fabricating Product(<anon>). This is NOT a corpus refusal wall, NOT construction, and NOT an admission/compatibility layer. Default compile-clean / resolve / run / emit stay on main's fail-open path (measure off). Arming surface: compile_dag_diagnostic_census sets v1_rt::type_ref_hit_ne_bind_measure (host bracket, same shape as name_resolution_policy) for the nested synthetic compile only."

data type_ref_measure_binding_authority_note: String = "MEASUREMENT-ONLY predicate type_ref_measure_binding_authority. Zero production consumers: no compile-clean gate, no resolve/run/serve/emit softening, nothing consults it unless type_ref_hit_ne_bind_measure_active. Its answer is three-valued (v1.compiler.infer_env TypeRefMeasureBinding): Bound, Unbound, or DisagreesWithProduction. Body: (1) bare — exact key in str_bindings ∪ ancestry_str_bindings; (1b) bare unit variant — the leaf resolves under v1.compiler.infer_env lookup_unit_variant_phantom_type, the resolver's exact-one judgment over the observed unit_variant_index (sum of visible contributions == 1), so the measure binds exactly what resolve resolves; zero, many or a shadow-emptied key answer unbound, and an unobserved index answers unbound; (2) qualified — symbol_index_lookup(full name) hits AND the qualifier is (a) a containment ancestor of env.module_path (leading-segment prefix) or (b) a module this module imports, read from the import record (env.parents, one interface env per resolved import), never from the spelling; a SELECTIVE import and a WHOLE import both count, because either one puts that module in the importing module's closure and production binds the qualified name to the same declaration either way. A qualified name whose exact hit holds but whose qualifier is neither (a) nor (b) answers DisagreesWithProduction, and the resolver emits the blocking TypeRefMeasureBindingDisagreement, never UnresolvedType: production binds it through v1.compiler.infer_env lookup_qualified_module_projection to that same declaration, so charging it to UnresolvedType lied about the cause (gunbc#15097: extdeps.transports.rest's std.effect_grant.Verb, imported selectively, read as unresolved, which stopped emit for every census fixture importing rest; gunbc.recurring_failure_mode a_census_measurement_mode_changes_whether_emit_runs). A qualified name with no exact hit answers Unbound and stays UnresolvedType. Same-authored-leaf × (same-file OR same-span) OR-arm is dead (operator: false positives not tolerated). Dissolve-on: N2 routes TypeReference through namespace-reference-derived-closure → occurrence_binding_from_candidates → OccurrenceBindingResult; this predicate and the measure arm delete."

data type_ref_hit_ne_bind_measure_dissolve_trigger: DissolutionCondition = unbound_dissolution(description: "DISSOLVE when N2 lands TypeReference on namespace-reference-derived-closure → occurrence_binding_from_candidates → OccurrenceBindingResult (docs/plans/containment-binding-cross-module-type-references-design.md). Then delete: type_ref_hit_ne_bind_measure_active arming, type_ref_measure_binding_authority, the masked measure UnresolvedType branch in v1.compiler.infer_resolve, this carrier, and dag/test/claim/type_ref_hit_ne_bind_measure_witness.dag (or flip its REDs to permanent regression controls under the canonical fold).")

data type_ref_hit_ne_bind_measure_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.type_ref_hit_ne_bind_measure.authority" as NonEmptyStr,
    decl_name: "type_ref_hit_ne_bind_measure_dissolve_trigger" as NonEmptyStr,
    field: WholeDeclaration
  }
}

data type_ref_hit_ne_bind_measure_rung_note: String = "§4b honesty: N1a establishes an executing discriminator (fixture GREEN/RED via compile_dag_diagnostic_census), not a guarantee ladder climb for the open corpus. Grandfathered corpus sites remain on the fail-open production path while measure is off. Do not report N1a as refusal or construction for that population."
