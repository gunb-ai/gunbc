module gunbc.hermetic_mock_fidelity

import std.types { String, List, Bool, Int }
import gunbc.guarantee_rung_drop { GuaranteeRung, Mitigatable, OutsideTheLadder, StructurallyGuaranteed }
import v2.std.algebra { fold_list }

// A DISCOVERED ERROR CLASS, FILED AS DESIGN section 4b REQUIRES: an operation whose hermetic
// mock_response answers with ONE unconditional value, so every hermetic caller receives a
// success the operation never performed.
//
// THE INVALID STATE. `service shell.Exec` declares `operation Run` with a single mock arm,
// `0 => { exit_code: 0, success: true, stdout: "", stderr: "" }`. The arm is keyed on an exit
// status the mock itself supplies, so it is not a function of the input at all: in hermetic
// mode `bash -s` running `exit 1` and `bash -s` running `true` return the SAME value.
// `operation RunArgv` and `operation Check` carry the same shape.
//
// THE HARM. Not a witness that fails -- a witness that PASSES against a fabricated exit status.
// Every hermetically-executed claim downstream of a shell effect is asserting about the mock,
// and a claim whose subject is "this fails closed" cannot be satisfied at all. That is DESIGN
// section 5's central prohibition (no fabricated plausible output), and the floor's own CI
// clause already names this exact case: mocking the refusal "would pass it against a fabricated
// exit status, the exact fabricated-plausible-output failure the witness exists to catch".
//
// THE DISCRIMINATING FACTS, measured rather than reasoned -- required floor run 32645296251 on
// main sha 183e59729995e2ac93a84aa721d8f0642bb27903, from the run's own per-identity output.
// Two witnesses in ONE module, differing in one string:
//   test.claim.host_effect_apply_witness.witness_shell_on_host_success_converges
//     script "true"   -> host_effect_apply converged      -> PASSED
//   test.claim.host_effect_apply_witness.witness_shell_on_host_failure_fails_closed
//     script "exit 1" -> host_effect_apply converged too  -> KNOWN-RED (held)
// Same call, same transport, same evidence, same code path. Only the script differs, and the
// failing script behaves exactly as the succeeding one did. No new instrument was built to
// observe this: it is two lines of a required run, and the pair is what makes it a finding
// rather than a reading of the declaration.
//
// THE RUNG. Below the floor, so `OutsideTheLadder` rather than `Mitigatable`: nothing refuses,
// nothing counts, nothing is logged, and the fabricated value is indistinguishable from a real
// one at every consumer. The attainable ceiling is `StructurallyGuaranteed` and the class is
// fully decidable -- an operation either has a response that varies with its declared input or
// it does not -- so nothing but a decision stands between here and there.
//
// THE REMEDY IS NOT MINE TO APPLY, and this module deliberately changes no behaviour. Deleting
// the unconditional arms makes the interpreter refuse (`HermeticEffectGround.NoMockResponse`,
// already implemented) instead of fabricating, which is the honest arm -- but ~75 call sites
// across ~30 modules reach these three operations, every currently-passing witness downstream
// of one is passing against the same fabrication, and `route_gap_unenrolled` must stay 0 or the
// required floor reds. That is one measured motion on a green tree, escalated to the operator
// on 2026-08-23 and NOT taken here. Recording it is what stops the tree claiming coverage it
// does not have while the decision is made.
//
// WHY THIS ROW IS AN OBSERVATION AND NOT AN AUTHORITY. The discrimination fact below is
// DERIVABLE from the operation's own declaration -- count the mock arms, ask whether any names
// an input field -- so a hand-authored copy of it is a second representation (DESIGN section 2)
// and will go stale the moment someone edits `extdeps/shell/exec.dag`. It is authored here
// because nothing reads operation declarations for this question today. NEXT TRIGGER, and it is
// the same trigger that closes the class: a check over the ingested operation declarations that
// refuses an unconditional mock arm at ingest, at which point this roster derives from that
// check and these rows delete.

type MockArmDiscrimination
  = UnconditionalArm
  | InputDiscriminating
  | NoMockArm

type HermeticMockRow {
  operation: String
  discrimination: MockArmDiscrimination
  rung: GuaranteeRung
  ceiling: GuaranteeRung
  next_trigger: String
}

data hermetic_mock_fidelity_trigger: String = "a check over ingested operation declarations refuses a mock_response arm that does not vary with the operation's declared input; this roster then derives from that check and deletes"

fn hermetic_mock_fidelity_rows() -> List<HermeticMockRow> {
  [
    HermeticMockRow {
      operation: "shell.Exec.Run",
      discrimination: UnconditionalArm {},
      rung: OutsideTheLadder {},
      ceiling: StructurallyGuaranteed {},
      next_trigger: hermetic_mock_fidelity_trigger
    },
    HermeticMockRow {
      operation: "shell.Exec.RunArgv",
      discrimination: UnconditionalArm {},
      rung: OutsideTheLadder {},
      ceiling: StructurallyGuaranteed {},
      next_trigger: hermetic_mock_fidelity_trigger
    },
    HermeticMockRow {
      operation: "shell.Exec.Check",
      discrimination: UnconditionalArm {},
      rung: OutsideTheLadder {},
      ceiling: StructurallyGuaranteed {},
      next_trigger: hermetic_mock_fidelity_trigger
    }
  ]
}

fn mock_arm_is_fabricating(d: MockArmDiscrimination) -> Bool {
  match d {
    UnconditionalArm => true
    InputDiscriminating => false
    NoMockArm => false
  }
}

// A FABRICATING ROW MUST CARRY A TRIGGER. DESIGN section 4b(2) forbids an untracked stall: a
// class below its ceiling names what would let it climb, or it is not being tracked at all. The
// RED here is authorable -- a row with an empty trigger -- so this is a check that can fail
// rather than a decoration.
fn hermetic_mock_row_is_tracked(r: HermeticMockRow) -> Bool {
  !mock_arm_is_fabricating(d: r.discrimination) || !(r.next_trigger == "")
}

fn hermetic_mock_fidelity_all_tracked() -> Bool {
  fold_list(
    xs: hermetic_mock_fidelity_rows(),
    empty: true,
    cons: fn(acc, r) { acc && hermetic_mock_row_is_tracked(r: r) }
  )
}

fn hermetic_mock_fabricating_count() -> Int {
  fold_list(
    xs: hermetic_mock_fidelity_rows(),
    empty: 0,
    cons: fn(acc, r) { if mock_arm_is_fabricating(d: r.discrimination) { acc + 1 } else { acc } }
  )
}
