module gunbc.runner_lifecycle_realize



// All nine runner_lifecycle HostEffect realize arms delegate here until wet transport lands.
// Honest scaffold: typed, located NotConverged — not an absorbing fallback and not a converged receipt.
// Dissolves when the add path is bound through LocalShell on an in-band job targeted at the host
// label AND the executing principal holds the enumerated sudo grants (ReadEffectivePosixPrincipal +
// SudoNopasswdGrantListProbe), AND host_effect_apply routes each arm through HostEffectTransport
// with independent read-back (org-roster for registration observe; local unit/process facts for
// ObserveRunnerLocalState; release digest before extract for ADD arms).

data runner_lifecycle_realize_wet_transport_dissolve_on: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "gunbc.host_effect",
    decl_name: "HostEffectTransport",
    field: WholeDeclaration,
  }
}

data runner_lifecycle_realize_scaffold_dissolution_note: String = "See runner_lifecycle_realize_scaffold_dissolution_note_dissolve_on for the lifecycle condition this row's rationale accompanies."

data runner_lifecycle_realize_scaffold_dissolve_on: std.dissolution.DissolutionCondition = unbound_dissolution(description: "DISSOLUTION TRIGGER (section 6): each runner_lifecycle_realize_* arm retires when (1) the add path is bound through LocalShell on an in-band GHA job labelled for the target host AND the executing principal holds passwordless sudo for runner-root mkdir, systemd unit install, daemon-reload, and unit start (verified via ReadEffectivePosixPrincipal + SudoNopasswdGrantListProbe — srv1 observed 2026-08-07; srv3/srv4 pending in-band probe), (2) host_effect_apply binds the arm through HostEffectTransport instead of this scaffold, and (3) the bound handler performs independent read-back before claiming Converged (org-roster for ObserveGitHubRunnerRegistration; local unit/process for ObserveRunnerLocalState; digest-verified release before extract for EnsureActionsRunnerRelease). Until then every arm returns NotConverged citing runner_lifecycle_realize_wet_transport_dissolve_on — provisions nothing.")

fn runner_lifecycle_realize_scaffold(
  effect_label: String,
  intent: gunbc.host_effect.HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  std.realization_reconcile.NotConverged {
    reason: join(
      [
        "host_effect_apply: ",
        effect_label,
        " realization scaffold (NotConverged) — dissolve-on runner_lifecycle_realize_wet_transport_dissolve_on: LocalShell in-band transport + enumerated sudo grants + HostEffectTransport binding; gunbc-owned realization (read live ctrl installer for shape, never invoke from gunbc run)",
      ],
      "",
    ),
    applied: intent,
  }
}

fn runner_lifecycle_realize_ensure_actions_runner_release(
  intent: gunbc.host_effect.HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  runner_lifecycle_realize_scaffold(effect_label: "EnsureActionsRunnerRelease", intent: intent)
}

fn runner_lifecycle_realize_ensure_runner_slot_directory(
  intent: gunbc.host_effect.HostEffectIntent,
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  runner_lifecycle_realize_scaffold(effect_label: "EnsureRunnerSlotDirectory", intent: intent)
}

