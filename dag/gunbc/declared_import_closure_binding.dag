module gunbc.declared_import_closure_binding

import std.types { String, NonEmptyStr, Bool, Int }
import std.optional { Optional, Present, Absent }
import gunbc.compile_clean_diagnostic_policy {
  UnlistedImportBindingSource,
  ListedImport,
  PoolCoincidence,
  DefinerResolvable,
  AmbiguousLeaf
}

// THE CLASS B OBSERVATION SURFACE for declared-import-closure binding (#6985). Its .dag builtin
// (observe_declared_import_closure_symbol_binding) had no caller and was deleted; the host
// classifier v1_compiler.cli_run declared_import_closure_binding_observation_from_resolved remains
// and its unit tests produce this shape. What it observed: compile an entry under primary-precedence
// pool_roots using ONLY its declared import-edge closure (no reference-derived widening), then
// report whether consumer_module binds symbol and through which UnlistedImportBindingSource arm.
// MEASUREMENT ONLY — callers judge ListedImport vs PoolCoincidence vs refusal.
// ObservationProductionRefused is distinct from BindingObserved refusal so could-not-measure, setup
// failure, compile graph:None (parse/frontend refusal — P1(b)), and any hard diagnostic on the
// compile (untrustworthy observation — producer refuses before populating the carrier) never read
// as the subject passing (DESIGN §5). BindingObserved requires a successfully ingested graph with
// zero hard diagnostics.
// Verdict partition: total match, no wildcard, over BindingObserved vs BindingNotRunnable and over
// UnlistedImportBindingSource. Callers still read the three Bool projections.

type DeclaredImportClosureBindingObservation
  = BindingObserved {
      binding_source: Optional<UnlistedImportBindingSource>,
      definer_module: String,
      symbol_resolves: Bool,
      blocking_hard_diagnostic_count: Int
    }
  | BindingNotRunnable { cause: NonEmptyStr }

type DeclaredImportClosureBindingObservationOutcome
  = ObservationProduced { observation: DeclaredImportClosureBindingObservation }
  | ObservationProductionRefused { phase: NonEmptyStr, cause: NonEmptyStr }

type ClassBBindingProjectionClass
  = ClassBListedImport
  | ClassBPoolCoincidence
  | ClassBSeamRefusal
  | ClassBOther

fn class_b_binding_projection_from_source(
  source: UnlistedImportBindingSource,
  symbol_resolves: Bool,
  clean: Bool
) -> ClassBBindingProjectionClass {
  match source {
    ListedImport =>
      match symbol_resolves {
        true =>
          match clean {
            true => ClassBListedImport
            false => ClassBOther
          }
        false =>
          match clean {
            true => ClassBSeamRefusal
            false => ClassBOther
          }
      }
    PoolCoincidence =>
      match symbol_resolves {
        true =>
          match clean {
            true => ClassBPoolCoincidence
            false => ClassBOther
          }
        false =>
          match clean {
            true => ClassBSeamRefusal
            false => ClassBOther
          }
      }
    DefinerResolvable =>
      match symbol_resolves {
        true =>
          match clean {
            true => ClassBOther
            false => ClassBOther
          }
        false =>
          match clean {
            true => ClassBSeamRefusal
            false => ClassBOther
          }
      }
    AmbiguousLeaf =>
      match symbol_resolves {
        true =>
          match clean {
            true => ClassBOther
            false => ClassBOther
          }
        false =>
          match clean {
            true => ClassBSeamRefusal
            false => ClassBOther
          }
      }
  }
}

fn class_b_binding_projection_from_observed(
  binding_source: Optional<UnlistedImportBindingSource>,
  symbol_resolves: Bool,
  blocking_hard_diagnostic_count: Int
) -> ClassBBindingProjectionClass {
  let clean = blocking_hard_diagnostic_count == 0
  match binding_source {
    Absent =>
      match symbol_resolves {
        true =>
          match clean {
            true => ClassBOther
            false => ClassBOther
          }
        false =>
          match clean {
            true => ClassBSeamRefusal
            false => ClassBOther
          }
      }
    Present { value } =>
      class_b_binding_projection_from_source(
        source: value,
        symbol_resolves: symbol_resolves,
        clean: clean
      )
  }
}

fn class_b_binding_projection(obs: DeclaredImportClosureBindingObservation) -> ClassBBindingProjectionClass {
  match obs {
    BindingNotRunnable { cause: _ } => ClassBOther
    BindingObserved {
      binding_source,
      definer_module: _,
      symbol_resolves,
      blocking_hard_diagnostic_count
    } =>
      class_b_binding_projection_from_observed(
        binding_source: binding_source,
        symbol_resolves: symbol_resolves,
        blocking_hard_diagnostic_count: blocking_hard_diagnostic_count
      )
  }
}

fn binding_source_is_listed_import(obs: DeclaredImportClosureBindingObservation) -> Bool {
  match class_b_binding_projection(obs: obs) {
    ClassBListedImport => true
    ClassBPoolCoincidence => false
    ClassBSeamRefusal => false
    ClassBOther => false
  }
}

fn binding_source_is_pool_coincidence(obs: DeclaredImportClosureBindingObservation) -> Bool {
  match class_b_binding_projection(obs: obs) {
    ClassBListedImport => false
    ClassBPoolCoincidence => true
    ClassBSeamRefusal => false
    ClassBOther => false
  }
}

fn binding_refused_at_intended_seam(obs: DeclaredImportClosureBindingObservation) -> Bool {
  match class_b_binding_projection(obs: obs) {
    ClassBListedImport => false
    ClassBPoolCoincidence => false
    ClassBSeamRefusal => true
    ClassBOther => false
  }
}

fn row4_pool_coincidence_or_refuse(obs: DeclaredImportClosureBindingObservation) -> Bool {
  binding_refused_at_intended_seam(obs: obs) || binding_source_is_pool_coincidence(obs: obs)
}

fn row3_stripped_refuses_binding(outcome: DeclaredImportClosureBindingObservationOutcome) -> Bool {
  match outcome {
    ObservationProductionRefused { phase: _, cause: _ } => false
    ObservationProduced { observation } => binding_refused_at_intended_seam(obs: observation)
  }
}

fn row4_stripped_pool_coincidence_or_refuse(outcome: DeclaredImportClosureBindingObservationOutcome) -> Bool {
  match outcome {
    ObservationProductionRefused { phase: _, cause: _ } => false
    ObservationProduced { observation } => row4_pool_coincidence_or_refuse(obs: observation)
  }
}
