module gunbc.declared_import_closure_binding

import std.types { String, NonEmptyStr, Bool, Int, List }
import v2.std.optional { Optional, Present, Absent }
import gunbc.compile_clean_diagnostic_policy { UnlistedImportBindingSource, ListedImport, PoolCoincidence }

data declared_import_closure_binding_charter_note: String = "THE CLASS B OBSERVATION SURFACE for declared-import-closure binding (#6985). Host twin of observe_declared_import_closure_symbol_binding: compile an entry under primary-precedence pool_roots using ONLY its declared import-edge closure (no reference-derived widening), then report whether consumer_module binds symbol and through which UnlistedImportBindingSource arm. MEASUREMENT ONLY — callers judge ListedImport vs PoolCoincidence vs refusal."

type DeclaredImportClosureBindingObservation
  = BindingObserved {
      binding_source: Optional<UnlistedImportBindingSource>,
      definer_module: String,
      symbol_resolves: Bool,
      blocking_hard_diagnostic_count: Int
    }
  | BindingNotRunnable { cause: NonEmptyStr }

fn binding_source_is_listed_import(obs: DeclaredImportClosureBindingObservation) -> Bool {
  match obs {
    BindingObserved {
      binding_source: Present { value: ListedImport },
      symbol_resolves: true,
      blocking_hard_diagnostic_count: 0,
      definer_module: _
    } => true
    _ => false
  }
}

fn binding_source_is_pool_coincidence(obs: DeclaredImportClosureBindingObservation) -> Bool {
  match obs {
    BindingObserved {
      binding_source: Present { value: PoolCoincidence },
      symbol_resolves: true,
      definer_module: _,
      blocking_hard_diagnostic_count: _
    } => true
    _ => false
  }
}

fn binding_refuses(obs: DeclaredImportClosureBindingObservation) -> Bool {
  match obs {
    BindingNotRunnable { cause: _ } => false
    BindingObserved { symbol_resolves: false, blocking_hard_diagnostic_count: _, binding_source: _, definer_module: _ } => true
    BindingObserved { symbol_resolves: true, blocking_hard_diagnostic_count: n, binding_source: _, definer_module: _ } => n > 0
  }
}

fn row4_pool_coincidence_or_refuse(obs: DeclaredImportClosureBindingObservation) -> Bool {
  binding_refuses(obs: obs) || binding_source_is_pool_coincidence(obs: obs)
}

test fn binding_refuses_not_runnable_is_false() -> Bool {
  !binding_refuses(obs: BindingNotRunnable { cause: "could-not-measure" as NonEmptyStr })
}

test fn row4_not_runnable_is_false() -> Bool {
  !row4_pool_coincidence_or_refuse(obs: BindingNotRunnable { cause: "could-not-measure" as NonEmptyStr })
}
