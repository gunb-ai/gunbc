module gunbc.v1_deletion_plan

import std.types { String, Int, List }
import v2.std.node { Symbol }

data v1_deletion_plan_doc: String = "Roadmap to v2-self-hosted with v1 deleted (operator target 2026-07-19: ~2 weeks). THIS FILE IS THE PLAN AUTHORITY — the self-host artifact (selfhost-dashboard.html) is a PROJECTION of it (delta-first: edit here, re-render there; DESIGN section 3 single authority). The bar is THREE GATES: v1 deletes when ALL THREE read done — Gate 1 (GateEmitterFixedPoint) = the emitter re-emits itself as a behavioral 2-generation fixed point, NOT byte identity; Gate 2 (GateHonestFrontier) = every compiler module is SelfEmitted or SeedRetained(reason, migration_trigger), wall-enforced, no orphaned-enrollment lie; Gate 3 (GateLedgerGreen) = the proactive verification ledger green BY EXECUTION (cold whole-corpus v1-vs-v2 parity + compile-clean parity + regen fixed point + per-family receipts), no calendar soak. GateDeletion holds the cutover + delete actions downstream of all three. This is NOT '27/27 modules flipped' — some modules stay SeedRetained by necessity (the host-effect/bootstrap kernel, self_host.dag flips last). Each milestone is a BRICK placed under a gate; brick_state = Placed | InFlight | Gated; every brick carries a ConfidenceBasis (basis = why we believe it closes, risk = what would falsify it, antagonize = the probe/receipt that attacks it) so the plan is attackable item by item — that is the deliverable. A milestone is a node; a PlanDependency edge means the earlier must LAND before the later can COMPLETE (not before it can START — overlap is the point). parallelism: ForciblySerial = one lane on the critical path; FanOutWide = width-many concurrent lanes once prereqs land; DecisionGate = zero-cost operator ruling. Estimates are lane-days low..high, honest not promised."

type PlanParallelism = ForciblySerial | FanOutWide | DecisionGate

type PlanGate = GateEmitterFixedPoint | GateHonestFrontier | GateLedgerGreen | GateDeletion

type BrickState = Placed | InFlight | Gated

type ConfidenceBasis {
  basis: String,
  risk: String,
  antagonize: String
}

type PlanGateSpec {
  gate: PlanGate,
  name: String,
  proves: String
}

type PlanMilestone {
  id: Symbol,
  title: String,
  gate: PlanGate,
  brick_state: BrickState,
  parallelism: PlanParallelism,
  fan_width: Int,
  days_low: Int,
  days_high: Int,
  lane_state: String,
  confidence: ConfidenceBasis
}

type PlanDependency {
  before: Symbol,
  after: Symbol
}

data v1_deletion_gates: List<PlanGateSpec> = [
  PlanGateSpec { gate: GateEmitterFixedPoint, name: "Gate 1 — the emitter re-emits itself", proves: "The v2 .dag emitter, emitted to Rust and rebuilt, is behaviorally equivalent to the seed on a discriminating corpus (a 2-generation fixed point, not byte identity — byte-fixpoint is an explicit non-goal because it would cement the seed's warts). This is THE critical path: until the emitter can emit itself, there is no v2 to delete v1 in favor of." },
  PlanGateSpec { gate: GateHonestFrontier, name: "Gate 2 — honest typed frontier", proves: "Every one of the 27 compiler modules is a typed row: SelfEmitted (green by execution) or SeedRetained(reason, migration_trigger) (countable, prioritizable). No silent escape hatch, and no orphaned enrollment (a receipt enrolled but never executed is a lie the wall must catch). The point is not that all 27 self-emit — it is that the frontier tells the TRUTH about which do and why the rest do not." },
  PlanGateSpec { gate: GateLedgerGreen, name: "Gate 3 — verification ledger green by execution", proves: "The proactive verification ledger is green because deliberate runs were EXECUTED — whole-corpus cold v1-vs-v2 witness parity with zero unexplained divergence, compile-clean parity, regen behavioral fixed point, and per-family equals receipts — never because a calendar interval elapsed. No soak: the operator is explicitly suspicious of soaking time as a substitute for a run." },
  PlanGateSpec { gate: GateDeletion, name: "Cutover and delete", proves: "Downstream of all three gates: CI floor runs on the v2-emitted path, the seed crates are frozen off the build path (products still build), and finally src/v1 + stage0 are deleted. These are actions that FIRE once the bar reads done; they prove nothing on their own." }
]

data v1_deletion_milestones: List<PlanMilestone> = [
  PlanMilestone { id: ^wrap_decision_predicate, title: "ONE structural Rc wrap-decision predicate in the emitter (ownership-fact derived, never a name roster) — the gate on every Rc-heavy deep module", gate: GateEmitterFixedPoint, brick_state: Placed, parallelism: ForciblySerial, fan_width: 1, days_low: 3, days_high: 7, lane_state: "LANDED #6776 (wrap_decision_gate, fail-closed Rc ownership wrapping) + UseSiteVerdict catalog #6877; verified by execution 2026-07-20 (valiant-dove-723: claim_batch wrap_decision_predicate_witness_holds 7 sub-witnesses + gate smoke green on main; 06_translate routes type_shell and value_expression through the gate, WrapGateInapplicable passes through unchanged — no silent Rc default)", confidence: ConfidenceBasis { basis: "By execution — 7 sub-witnesses green on main plus the gate smoke; the predicate is ownership-fact-derived so the bad Rc wrap is UNWRITABLE (construction), not flagged after the fact", risk: "A use-site whose ownership the derivation mis-classifies silently falls to a wrap default", antagonize: "wrap_decision_predicate_witness_holds runs over the corpus; a mis-wrap reds it — the RED control is the discriminating fixture" } },
  PlanMilestone { id: ^std_dup_assembly_fix, title: "One harness fix: cssl std-seed-link closure assembly collides dag/std with the seed std (E0255) — single root; post-discharge census 2026-07-19 puts ~13 modules on this fix (3 Gate-A + 10 tail); the 6 formerly-unresolved modules cleared emit via KeySource but stay on a separate cargo UNRESOLVED bucket", gate: GateEmitterFixedPoint, brick_state: Placed, parallelism: ForciblySerial, fan_width: 1, days_low: 1, days_high: 3, lane_state: "LANDED+CAPTURED 2026-07-19 (#6876)", confidence: ConfidenceBasis { basis: "Single root (cssl closure assembly collided dag/std with seed std, E0255); the post-discharge census placed ~13 modules on the one fix", risk: "A module the census missed carries a second assembly collision not on this root", antagonize: "the cssl closure-assembly probe over the flip candidate set surfaces a residual collision" } },
  PlanMilestone { id: ^emit_import_closure_root, title: "ONE comprehensive emit import-closure derivation: the emitted module import set = the transitive closure of every type/module name any emitted construct references (params, body, inferred, nested-record struct literals AND their sibling-module field types, carrier types, referenced modules). Replaces the per-face gates (faithful-carrier, struct-field StructRepr-only, module-manifest). FreeMonoid was ONE layer of this, not the whole gate", gate: GateEmitterFixedPoint, brick_state: InFlight, parallelism: ForciblySerial, fan_width: 1, days_low: 2, days_high: 5, lane_state: "SINGLE CHAIN-A GATE (operator 2026-07-20: root-cause the closure into ONE derivation, do NOT peel face-by-face; cargo-green + witness-green at ALL times, no mid-peel merges). #6919 (neat-swift-795) pivoted to the comprehensive derivation; DRAFT until representative cargo-green (>=1 nested-struct module + materialization_carriers) AND witness-green (regen --verify divergence 0, witness families stay green). #6906 landed FreeMonoid + std_measure + partial nested-struct (mid-peel; main green, no module flipped)", confidence: ConfidenceBasis { basis: "The closure is a mechanical transitive walk over names the emitted constructs already reference; the representative bar is by-execution on real modules, not first_error", risk: "A residual reference class the walk misses — rustc masks downstream layers behind first_error, so a new layer can surface AFTER the representative bar (FreeMonoid was one layer, falsified as the whole gate)", antagonize: "neat-swift ships the FULL residual rustc histogram (every E-code + count on 02_parse + materialization_carriers) on each layer-clear push, not just first_error; the confidence-probe throwaway branch peels AHEAD past the closure to force-expose layer N+1 before we commit" } },
  PlanMilestone { id: ^generic_t_rendering, title: "Generic-type rendering fix: an unbound TypeVariable in an applied type must REFUSE, not render — root is the fold acc-type fallback path (emit_rust_fold_method_call -> lambda_acc_type_str/lambda_param_type_strs with fold_acc_uses_fallback) plus render_rust_type not refusing an unbound T inside an applied type. A DISTINCT class from import-closure (generic rendering, not a missing import); blocks 04_infer/06_translate/05_emit; same family as #6881 fn_generic_param_names threading", gate: GateEmitterFixedPoint, brick_state: InFlight, parallelism: ForciblySerial, fan_width: 1, days_low: 1, days_high: 3, lane_state: "IN FLIGHT (quiet-bee-205, Pole A-2). E0425 unbound T in 04_infer. Scoped SEPARATELY from emit_import_closure_root (operator 2026-07-20: distinct root). Root located; fix = thread the generic param names into the fold acc-type + refuse an unbound TypeVariable in render_rust_type (construction, never a string-scan of the emitted text)", confidence: ConfidenceBasis { basis: "Root located to the fold acc-type fallback plus render_rust_type; the threading shape is the same as the already-landed #6881 fn_generic_param_names", risk: "Generic-T interleaves with import-closure on the same modules (a fix-order coupling), or is deeper than the 04_infer surface it first showed on", antagonize: "quiet-bee ships the full residual histogram on clear; the peel-ahead branch stacks generic-T ON TOP of the import closure to expose interaction before either commits" } },
  PlanMilestone { id: ^unresolved_error_diagnosis, title: "Diagnose-then-fix the 6 unresolved_compiler_error modules (00_compile, materialization_carriers, program_assembly, source_authority, 02_parse, 03_ingest) from the census probe output", gate: GateEmitterFixedPoint, brick_state: Placed, parallelism: FanOutWide, fan_width: 3, days_low: 0, days_high: 1, lane_state: "DIAGNOSIS COMPLETE + PARTIAL FIX LANDED 2026-07-20 (#6906): all 6 emit 0-diagnostics; FreeMonoid + std_measure module-manifest + partial nested-struct import closure merged (mid-peel). The remaining import-closure layers are absorbed into emit_import_closure_root — this milestone's DIAGNOSIS deliverable is done; the fix continues under that gate", confidence: ConfidenceBasis { basis: "All 6 modules emit 0-diagnostics; the diagnosis deliverable is complete and the residual work is folded into emit_import_closure_root", risk: "0-diagnostics emit is NOT evidence of correct call-shape — a runtime call-shape defect can hide behind a clean compile (compile-clean is arity-blind)", antagonize: "require an EXECUTING-consumer receipt on signature changes, never the 0-diagnostics count alone" } },
  PlanMilestone { id: ^emit_representation_mismatch, title: "Emit representation-mismatch layer: after import-closure + generic-T clear, each deep module still shows ~4400 E0308 type mismatches (04_infer E0308x4261; 06_translate + 05_emit E0308x4422) — the model-vs-realization fork surfacing in emit (modeled coproduct types where native Rust/Value types are expected, and vice versa). The largest emitter peel layer and likely the deepest root (the 'ground each primitive into its realization' open thread at scale)", gate: GateEmitterFixedPoint, brick_state: Gated, parallelism: ForciblySerial, fan_width: 1, days_low: 3, days_high: 8, lane_state: "EXPOSED 2026-07-20 by the confidence-probe antagonizing (quiet-bee #6924 residual histogram once generic-T cleared): E0308 is the dominant residual (~4400/deep module, uniform shape across all three) and was MASKED behind rustc first_error until import-closure + generic-T peeled it open. Owner TBD; couples to the numeric-tower grounding (#5428) generalized to every primitive. This is the layer that makes emitter_fixed_point depth genuinely uncertain — sizing it (E0308 bucketed by mismatching type-pair) is the active antagonizing", confidence: ConfidenceBasis { basis: "The class is identified — E0308 type-mismatch, ~4400/module, UNIFORM shape across 04_infer/06_translate/05_emit, so a single root signature not scattered noise", risk: "It is the model-vs-realization fork (a known deep open thread) surfacing at scale; grounding every primitive into its realization may exceed the 2-week window, so this brick could DOMINATE Gate 1", antagonize: "bucket the ~4400 E0308 by the type pair that mismatches (which modeled type vs which native) to size the true root count — a few root pairs x many sites (tractable) or many roots (deep); quiet-bee producing this next" } },
  PlanMilestone { id: ^deep_module_lanes, title: "Self-emit lanes for the Rc-heavy core: 04_infer, 06_translate, the 05_emit family — fan out in parallel with the flip wave once import-closure + generic-T + representation-mismatch reach cargo-green", gate: GateEmitterFixedPoint, brick_state: Gated, parallelism: FanOutWide, fan_width: 4, days_low: 3, days_high: 6, lane_state: "GATED on emit_representation_mismatch (which is itself gated on emit_import_closure_root + generic_t_rendering) (wrap_decision #6776 + std_dup #6876 already cleared). Baseline TSVs #6916 (sharp-ferret-568): all 8 deep modules (04_infer, 06_translate, whole 05_emit family) emit clean + cargo-refuse on the SAME import-closure root as the flip wave. Fans out IN PARALLEL with probe_flip_fanout on root-fix cargo-green", confidence: ConfidenceBasis { basis: "All 8 deep modules already emit 0-diagnostics and refuse on the SAME root as the flip wave (TSVs #6916), so the root fix is expected to clear them wholesale, not one-by-one", risk: "A deep module (especially 04_infer, the generic-heavy one) hits a THIRD layer past import-closure + generic-T", antagonize: "the confidence-probe peel-ahead hacks past both known roots on a throwaway branch to surface layer 3 BEFORE the lanes commit" } },
  PlanMilestone { id: ^emitter_fixed_point, title: "The emitted emitter re-emits itself: behavioral 2-generation fixed point on the v2 side (not byte identity)", gate: GateEmitterFixedPoint, brick_state: Gated, parallelism: ForciblySerial, fan_width: 1, days_low: 2, days_high: 4, lane_state: "GATED on deep_module_lanes. Byte-fixpoint is an explicit NON-goal (it would force v2 to reproduce the seed's warts); the bar is behavioral equivalence on a discriminating corpus", confidence: ConfidenceBasis { basis: "Behavioral equivalence on a discriminating corpus is the operator-set bar; the emit machinery is already proven on the shallow modules that self-emit today", risk: "The emitted emitter diverges from the seed on a discriminating input the corpus does not cover", antagonize: "regen_stage0 --emit-fresh + --verify divergence 0 plus a discriminating RED that goes red when the re-emit is wrong" } },
  PlanMilestone { id: ^typed_frontier, title: "The self-host frontier is a typed row per module: SelfEmitted | SeedRetained(reason, migration_trigger) — no silent escape hatch (the DecodeFidelity/Lossless boundary)", gate: GateHonestFrontier, brick_state: Placed, parallelism: ForciblySerial, fan_width: 1, days_low: 0, days_high: 0, lane_state: "LANDED (src/v2/compiler/self_host/frontier.dag). Each compiler module is a FrontierQualifiedModuleBinding with a disposition; SeedRetained carries reason + migration_trigger, so a seed-retained module is countable and prioritizable, never a silent hole", confidence: ConfidenceBasis { basis: "frontier.dag exists and every module is a typed row with a disposition; the Lossless boundary is modeled", risk: "The disposition enum admits a state that reads honest but is not (SelfEmitted with a dead receipt, or a stale SeedRetained reason)", antagonize: "the no_frontier_lies wall plus the frontier audit (confidence-probe Phase 2) attack exactly that gap" } },
  PlanMilestone { id: ^frontier_dispositioned, title: "All 27 compiler modules dispositioned: 6 SelfEmitted (03_body_producer, 03_normalize, 07_target_carriers, discovery_enumeration, parse_engine_hooks, use_site_verdict) + 21 SeedRetained, each with a reason + trigger. The bar is NOT 27/27 SelfEmitted — some stay SeedRetained by necessity", gate: GateHonestFrontier, brick_state: Placed, parallelism: ForciblySerial, fan_width: 1, days_low: 0, days_high: 0, lane_state: "LANDED — 27/27 rows present in frontier.dag (count SelfEmitted vs SeedRetained there for the live number). The host-effect kernel, bootstrap, and self_host.dag itself stay SeedRetained by necessity; the flip wave (probe_flip_fanout) grows the SelfEmitted count but is seed-shrink beyond the minimum, not a bar-brick", confidence: ConfidenceBasis { basis: "27 rows counted in frontier.dag; the 6 SelfEmitted are verified by execution", risk: "A SeedRetained reason is stale (the module could self-emit now, so the frontier UNDERSTATES progress) or a SelfEmitted receipt is orphaned (OVERSTATES it)", antagonize: "the frontier audit samples SeedRetained rows for false-retention AND verifies every one of the 6 SelfEmitted receipts actually executes" } },
  PlanMilestone { id: ^no_frontier_lies, title: "No orphaned enrollment: every frontier receipt names an EXECUTING consumer; an enrolled-but-never-run receipt itself reds (the #6856 coverage-by-illusion class)", gate: GateHonestFrontier, brick_state: Placed, parallelism: ForciblySerial, fan_width: 1, days_low: 0, days_high: 0, lane_state: "LANDED — the admission invariant (module-identity-storage-binding Phase 0): SelfEmitted receipts run on the falsifier wet cadence; quarantined known-red rows run on a probe cadence EXPECTING red so greening is a counted un-quarantine event. 'Enrolled, zero executions' reds", confidence: ConfidenceBasis { basis: "The wall is executable and runs over the corpus, not a grep", risk: "The wall itself goes inert (coverage-by-illusion one level up — a lens that exists but nothing gates on)", antagonize: "the executable hygiene backstop keeps every lens wired-or-deleted; the frontier audit confirms the wall actually fires" } },
  PlanMilestone { id: ^trigger_renegotiation, title: "DECISION: namespace-gated modules (03_resolve, 03_name_resolve) + body-producer tail — renegotiate migration triggers to emit under the current design (accept a later re-emit), or exclude from the 2-week scope", gate: GateHonestFrontier, brick_state: InFlight, parallelism: DecisionGate, fan_width: 1, days_low: 0, days_high: 0, lane_state: "RESOLVED 2026-07-20 (operator): do NOT wait on the namespace terminal — it is dragging. Renegotiate 03_resolve/03_name_resolve + body-producer tail triggers to emit under the current design with a declared later re-emit; the frontier-row renegotiation rides the flip-wave refresh", confidence: ConfidenceBasis { basis: "Operator-decided; the decision is made, only the mechanical frontier-row update remains", risk: "The row update lags and leaves a stale trigger on the frontier", antagonize: "the flip-wave refresh updates the rows and the no_frontier_lies wall catches a stale trigger" } },
  PlanMilestone { id: ^probe_flip_fanout, title: "Probe + flip the std_dup-gated modules (~13 at cargo stage after the 2026-07-19 re-probe); each probe/flip is an independent lane once the import-closure root reaches cargo-green. Seed-shrink beyond the fixed-point minimum", gate: GateHonestFrontier, brick_state: Gated, parallelism: FanOutWide, fan_width: 13, days_low: 2, days_high: 5, lane_state: "GATED on emit_import_closure_root (+ generic_t_rendering for the generic-heavy candidates). The emitter fixed point (Gate 1) only needs the emitter modules to self-emit, so the flip wave GROWS the SelfEmitted count but is not itself a bar-brick. 2026-07-19 re-probe (TSVs #6891) read 18 of 19 candidates as import-closure-only. Fans out IN PARALLEL with deep_module_lanes on root-fix cargo-green. Flip PR #6881 HELD DRAFT; the flip set refreshes to the actual green set on root-fix merge", confidence: ConfidenceBasis { basis: "18 of 19 candidates read as import-closure-only after the re-probe; each flip is an independent lane once the root clears", risk: "The re-probe read only first_error, so a candidate may hide a second layer past import-closure", antagonize: "the full residual histogram per candidate on clear; each flip lands by-execution (cargo-green + witness-green), never on a probe prediction" } },
  PlanMilestone { id: ^witness_realization_kernel, title: "v2 execution path kernel: emit a witness to native code + run harness + scheduler (the piece that replaces the v1 interpreter for CI) — serial kernel, then families fan out", gate: GateLedgerGreen, brick_state: Placed, parallelism: ForciblySerial, fan_width: 1, days_low: 3, days_high: 5, lane_state: "LANDED 2026-07-19 #6879 (da0e7c3d) at full bar; kernel handoff (partition, seams, traps) and the six-family diagnosis table durable as comments on the PR; stern-lark-430 closed out clean", confidence: ConfidenceBasis { basis: "Landed at full bar by execution; the kernel runs a family end-to-end", risk: "The kernel's partition/seams do not generalize to a family the diagnosis table did not cover", antagonize: "the 9 family lanes all exercised it and all went green — the generalization is proven, not assumed" } },
  PlanMilestone { id: ^witness_family_fanout, title: "Per-witness-family realization lanes (claim families, wet receipts, lens gates) once the kernel runs one family end-to-end", gate: GateLedgerGreen, brick_state: Placed, parallelism: FanOutWide, fan_width: 5, days_low: 4, days_high: 8, lane_state: "DONE 2026-07-20 — all 9 witness families GREEN with trustworthy controls. #6912 (eval-repair consolidation) + #6917 (fold closure-arg: structural RuntimeClosure at edge grain, both oracle legs real, un-quarantine receipt) + #6918 (field_access RED-control fail-open fix — the wrong-fixture control could not go red when behavior was wrong; section-5 coverage-by-illusion, now discriminating). Emitter was CLEAN across all 9; every fix was eval/harness-side (the side v1-deletion removes)", confidence: ConfidenceBasis { basis: "All 9 families green by execution WITH discriminating RED controls (the #6918 fix made the field_access control able to go red on a wrong fixture)", risk: "A family's green rests on a non-discriminating control (the exact #6918 class recurring elsewhere)", antagonize: "each control was checked to go red on a wrong fixture; ledger_projection (Pole B) re-derives the dispositions from the probe_red carrier so a silent regression reds" } },
  PlanMilestone { id: ^ledger_modeled, title: "The proactive verification ledger is modeled: 3 spine receipts (cold parity, compile-clean, regen fixed point) + 9 family receipts, typed dispositions, no fabricated green", gate: GateLedgerGreen, brick_state: Placed, parallelism: ForciblySerial, fan_width: 1, days_low: 1, days_high: 2, lane_state: "LANDED #6915 (proactive_verification_ledger.dag). Typed dispositions; no soak — every receipt is a deliberate executed run, not an elapsed-time claim", confidence: ConfidenceBasis { basis: "proactive_verification_ledger.dag exists with typed receipt rows for the 3 spine + 9 family checks", risk: "A disposition is a hand-declared literal that goes stale — exactly the Pole B defect: 5 family dispositions were hand-literals, lying after the eval PRs greened them", antagonize: "ledger_projection (Pole B #6923) projects dispositions from the probe_red carrier so they self-update; until it lands, the hand-literals ARE the attack surface" } },
  PlanMilestone { id: ^ledger_projection, title: "The ledger self-updates: project family dispositions from the ci_layer_roots.dag probe_red carrier instead of hand-declared literals (DESIGN section 3 single authority)", gate: GateLedgerGreen, brick_state: InFlight, parallelism: ForciblySerial, fan_width: 1, days_low: 1, days_high: 2, lane_state: "IN FLIGHT (gentle-bee, Pole B #6923). The genuinely-ORTHOGONAL Gate-3 lane runnable NOW (no Gate-1 dependency). Fixes the section-3 defect: 5 KnownRedPendingUnquarantine literals stale/lying after #6912/#6917/#6918 greened them", confidence: ConfidenceBasis { basis: "Root located — the probe_red carrier already holds the truth; the fix projects from it (single authority) rather than re-declaring the dispositions", risk: "The carrier does not cover every family, leaving a residue still hand-declared", antagonize: "gentle-bee executes the projection over all 9 families; a coverage gap reds it" } },
  PlanMilestone { id: ^cold_parity_receipt, title: "Spine receipt: whole-corpus COLD v1-vs-v2 witness parity with zero unexplained divergence — a deliberate executed run, not a soak", gate: GateLedgerGreen, brick_state: Gated, parallelism: ForciblySerial, fan_width: 1, days_low: 2, days_high: 4, lane_state: "GATED on emitter_fixed_point (no v2 emission = no cold parity to run). The falsifier cadence already carries the deterministic whole-tree cold control (GUNBC_CI_COMPILE_CLEAN_COLD_CONTROL); this brick is the deliberate v1-vs-v2 comparison over it", confidence: ConfidenceBasis { basis: "The cold-control mechanism already exists in the falsifier cadence; this receipt is a comparison, not new machinery", risk: "Cannot execute until Gate 1 lands — the deepest cross-gate dependency, so a divergence would surface late", antagonize: "run it the moment the emitter fixed point lands, counted per-family, with no elapsed-time substitute permitted" } },
  PlanMilestone { id: ^compile_clean_parity_receipt, title: "Spine receipt: compile-clean parity — the v2-emitted path compiles the corpus clean, matching v1", gate: GateLedgerGreen, brick_state: Gated, parallelism: ForciblySerial, fan_width: 1, days_low: 1, days_high: 2, lane_state: "GATED on emitter_fixed_point. Compile-clean is already the CI gate for v1; the receipt runs it on the v2 path", confidence: ConfidenceBasis { basis: "Compile-clean is already the v1 CI gate; the receipt just runs it on the v2-emitted path", risk: "0-diagnostics compile is arity-blind — clean does not imply behaviorally equal", antagonize: "paired with cold_parity_receipt (the behavioral leg), never standing alone as the equality claim" } },
  PlanMilestone { id: ^regen_fixed_point_receipt, title: "Spine receipt: regen behavioral fixed point — regen_stage0 on the v2-emitted sources reproduces a behaviorally-equivalent emitter", gate: GateLedgerGreen, brick_state: Gated, parallelism: ForciblySerial, fan_width: 1, days_low: 1, days_high: 2, lane_state: "GATED on emitter_fixed_point. The self-host fixed-point step executed as a ledger receipt, scoped at its own closure (regen skip authority)", confidence: ConfidenceBasis { basis: "regen_stage0 --emit-fresh + --verify is the existing self-host proof harness", risk: "The fixed point holds for the emitter but a downstream module regresses", antagonize: "--verify divergence 0 over the FULL regen input set, never a sampled subset" } },
  PlanMilestone { id: ^ci_floor_cutover, title: "CI floor runs on v2-emitted execution; PROACTIVE falsifier parity against the v1 path — deliberately executed cold v1-vs-v2 runs with counted divergence (operator 2026-07-20: no passive soak; verify by execution, not elapsed time)", gate: GateDeletion, brick_state: Gated, parallelism: ForciblySerial, fan_width: 1, days_low: 2, days_high: 4, lane_state: "GATED on emitter_fixed_point + probe_flip_fanout (the v2-emitted-execution half) + the ledger receipts. witness_family_fanout DONE. This is the cutover ACTION: CI stops using the v1 interpreter and runs the v2-emitted path", confidence: ConfidenceBasis { basis: "The ledger bricks supply the parity evidence; the cutover is the switch once they are green", risk: "The cutover exposes a CI-only path the per-family receipts did not cover", antagonize: "cold_parity_receipt runs the FULL corpus cold, not just the enrolled families" } },
  PlanMilestone { id: ^v1_quarantine, title: "v1 off the build path: seed crates frozen as a bootstrap artifact, nothing in CI or products depends on them — the products-can-build milestone", gate: GateDeletion, brick_state: Gated, parallelism: ForciblySerial, fan_width: 1, days_low: 1, days_high: 2, lane_state: "blocked on emitter_fixed_point + ci_floor_cutover + unresolved_error_diagnosis + trigger_renegotiation (all three gates reading done)", confidence: ConfidenceBasis { basis: "Quarantine is a build-path change (freeze the seed crates, ensure nothing depends on them) once all three gates read done", risk: "A product or CI step still references a seed crate", antagonize: "the products-can-build check — verify nothing in CI or products depends on src/v1 before flipping" } },
  PlanMilestone { id: ^v1_delete, title: "Delete src/v1 + stage0 when the PROACTIVE VERIFICATION LEDGER is green by execution — no calendar soak (operator 2026-07-20: suspicious of soaking; test/verify proactively). Ledger = enumerated executed receipts, each a deliberate run, none an elapsed-time claim", gate: GateDeletion, brick_state: Gated, parallelism: ForciblySerial, fan_width: 1, days_low: 1, days_high: 1, lane_state: "blocked on v1_quarantine + the executed verification ledger (cold parity + compile-clean + regen fixed point + per-family receipts, all green by execution)", confidence: ConfidenceBasis { basis: "A mechanical removal once quarantine holds and the ledger is green BY EXECUTION", risk: "Deleting too early on a soak-substituted green (the operator's explicit worry)", antagonize: "gate on the enumerated executed receipts, never elapsed time — the ledger is the wall" } }
]

data v1_deletion_dependencies: List<PlanDependency> = [
  PlanDependency { before: ^std_dup_assembly_fix, after: ^probe_flip_fanout },
  PlanDependency { before: ^std_dup_assembly_fix, after: ^deep_module_lanes },
  PlanDependency { before: ^wrap_decision_predicate, after: ^deep_module_lanes },
  PlanDependency { before: ^emit_import_closure_root, after: ^probe_flip_fanout },
