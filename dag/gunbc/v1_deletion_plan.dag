module gunbc.v1_deletion_plan

import std.types { String, Int, List }
import v2.std.node { Symbol }

data v1_deletion_plan_doc: String = "Dependency graph for reaching v2-self-hosted with v1 deleted (operator target 2026-07-19: ~2 weeks). A milestone is a node; a PlanDependency edge means the earlier milestone must land before the later can complete (not before it can START — overlap is the point). parallelism names what is forcibly serial vs fan-out-wide: ForciblySerial = one lane, its duration is on the critical path; FanOutWide = width-many lanes concurrently once its prerequisites land; DecisionGate = zero-cost operator ruling that unblocks scope. Estimates are lane-days low..high, honest not promised. This file is the plan authority; the chat/prose rendering is a projection of it (delta-first: edit here)."

type PlanParallelism = ForciblySerial | FanOutWide | DecisionGate

type PlanMilestone {
  id: Symbol,
  title: String,
  parallelism: PlanParallelism,
  fan_width: Int,
  days_low: Int,
  days_high: Int,
  lane_state: String
}

type PlanDependency {
  before: Symbol,
  after: Symbol
}

data v1_deletion_milestones: List<PlanMilestone> = [
  PlanMilestone { id: ^std_dup_assembly_fix, title: "One harness fix: cssl std-seed-link closure assembly collides dag/std with the seed std (E0255) — single root; post-discharge census 2026-07-19 puts ~13 modules on this fix (3 Gate-A + 10 tail at first census); the 6 formerly-unresolved modules cleared emit via KeySource but remain on a separate cargo UNRESOLVED bucket", parallelism: ForciblySerial, fan_width: 1, days_low: 1, days_high: 3, lane_state: "LANDED+CAPTURED 2026-07-19 (#6876)" },
  PlanMilestone { id: ^probe_flip_fanout, title: "Probe + flip the std_dup-gated modules (~13 at cargo stage after 2026-07-19 re-probe); each probe/flip is an independent lane once the assembly fix lands", parallelism: FanOutWide, fan_width: 13, days_low: 2, days_high: 5, lane_state: "SINGLE GATE — 2026-07-19 re-probe on merged main (TSVs #6891): 18 of 19 candidates FreeMonoid-import-emission ONLY (13 tail + 5 bucket); materialization_carriers adds v2_std_text closure-manifest (same class, manifest grain, same package). Measure LANDED #6888; std_dup all 3 faces LANDED (#6885/#6886/#6883). FreeMonoid pass EXECUTING (neat-swift-795: instance-patch both grains + dissolve-on naming build_shared_types/emit_faithful_text_carrier_import_lines and the pub-mod closure list as derivation targets). Flip PR #6881 HELD DRAFT until per-module receipts green; flip set refreshes to the actual green set on pass merge" },
  PlanMilestone { id: ^wrap_decision_predicate, title: "ONE structural Rc wrap-decision predicate in the emitter (ownership-fact derived, never a name roster) — the gate on every Rc-heavy deep module", parallelism: ForciblySerial, fan_width: 1, days_low: 3, days_high: 7, lane_state: "LANDED — predicate merged as #6776 (wrap_decision_gate, fail-closed Rc ownership wrapping) + UseSiteVerdict catalog #6877; this row was STALE (still said running) until verified by execution 2026-07-20 (valiant-dove-723: claim_batch wrap_decision_predicate_witness_holds 7 sub-witnesses + gate smoke green on main; 06_translate routes type_shell and value_expression through wrap_decision_gate, WrapGateInapplicable passes through unchanged — no silent Rc default)" },
  PlanMilestone { id: ^deep_module_lanes, title: "Self-emit lanes for the Rc-heavy core: 04_infer, 06_translate, the 05_emit family — fan out after the predicate lands (also need std_dup fixed)", parallelism: FanOutWide, fan_width: 4, days_low: 3, days_high: 6, lane_state: "UNBLOCKED on the predicate axis 2026-07-20 (wrap_decision LANDED #6776, verified by execution) + std_dup LANDED #6876; fan-out fires when the FreeMonoid pass merges (emitter files locked until then); probe baseline TSVs for the 4 deep lanes in preparation (valiant-dove-723)" },
  PlanMilestone { id: ^unresolved_error_diagnosis, title: "Diagnose-then-fix the 6 unresolved_compiler_error modules (00_compile, materialization_carriers, program_assembly, source_authority, 02_parse, 03_ingest) from the census probe output", parallelism: FanOutWide, fan_width: 3, days_low: 0, days_high: 1, lane_state: "DIAGNOSIS COMPLETE 2026-07-19: all 6 emit 0-diagnostics post-KeySource; 5/6 cargo-gated on FreeMonoid only; materialization_carriers = emitter closure-manifest gap (emits crate::v2_std_text:: refs, omits module from closure lib.rs — verified by execution, harness projects faithfully). Both roots ride the FreeMonoid package (neat-swift-795), two distinct receipts" },
  PlanMilestone { id: ^emitter_fixed_point, title: "The emitted emitter re-emits itself: behavioral fixed point on the v2 side (2-generation equivalence, not byte identity)", parallelism: ForciblySerial, fan_width: 1, days_low: 2, days_high: 4, lane_state: "blocked on deep_module_lanes" },
  PlanMilestone { id: ^witness_realization_kernel, title: "v2 execution path kernel: emit a witness to native code + run harness + scheduler (the piece that replaces the v1 interpreter for CI) — serial kernel, then families fan out", parallelism: ForciblySerial, fan_width: 1, days_low: 3, days_high: 5, lane_state: "LANDED 2026-07-19 #6879 (da0e7c3d) at full bar; kernel handoff (partition, seams, traps) and the six-family diagnosis table durable as comments on the PR; stern-lark-430 closed out clean" },
  PlanMilestone { id: ^witness_family_fanout, title: "Per-witness-family realization lanes (claim families, wet receipts, lens gates) once the kernel runs one family end-to-end", parallelism: FanOutWide, fan_width: 5, days_low: 4, days_high: 8, lane_state: "DISPATCHED 2026-07-19 on kernel merge: lane 1 emit_host_add landed with the kernel; family scaffolds #6893/#6894/#6895 MERGED (match+loop genuine agreement; fold/meet_join/variant_construct/field_access/complement quarantined typed+counted). Consolidated diagnosis: emitter CLEAN across all 9 families — every gap is eval/harness-side (the side v1-deletion removes). Eval-repair arc on ONE owner (swift-stag-662): field_access+complement (meet_join un-quarantines by consumption) -> fold closure-arg support -> hand-roster tripwire decides enumerate-vs-derive-from-ingest before variant_construct" },
  PlanMilestone { id: ^trigger_renegotiation, title: "DECISION: namespace-gated modules (03_resolve, 03_name_resolve) + body-producer tail — renegotiate migration triggers to emit under the current design (accept later re-emit), or exclude from the 2-week scope", parallelism: DecisionGate, fan_width: 1, days_low: 0, days_high: 0, lane_state: "RESOLVED 2026-07-20 (operator): do NOT wait on the namespace terminal — it is dragging. Renegotiate 03_resolve/03_name_resolve + body-producer tail triggers to emit under the current design with a declared later re-emit; the frontier-row renegotiation rides the flip-wave refresh" },
  PlanMilestone { id: ^ci_floor_cutover, title: "CI floor runs on v2-emitted execution; PROACTIVE falsifier parity against the v1 path — deliberately executed cold v1-vs-v2 runs with counted divergence (operator 2026-07-20: no passive soak; verify by execution, not elapsed time)", parallelism: ForciblySerial, fan_width: 1, days_low: 2, days_high: 4, lane_state: "blocked on witness_family_fanout + probe_flip_fanout" },
  PlanMilestone { id: ^v1_quarantine, title: "v1 off the build path: seed crates frozen as bootstrap artifact, nothing in CI or products depends on them — the products-can-build milestone", parallelism: ForciblySerial, fan_width: 1, days_low: 1, days_high: 2, lane_state: "blocked on emitter_fixed_point + ci_floor_cutover + unresolved_error_diagnosis + trigger_renegotiation" },
  PlanMilestone { id: ^v1_delete, title: "Delete src/v1 + stage0 when the PROACTIVE VERIFICATION LEDGER is green by execution — no calendar soak (operator 2026-07-20: suspicious of soaking times; test/verify proactively). Ledger = enumerated executed receipts: whole-corpus cold v1-vs-v2 witness parity with zero unexplained divergence, compile-clean parity, regen behavioral fixed point, per-family equals receipts — each a deliberate run, none an elapsed-time claim", parallelism: ForciblySerial, fan_width: 1, days_low: 1, days_high: 1, lane_state: "blocked on v1_quarantine + the executed verification ledger" }
]

data v1_deletion_dependencies: List<PlanDependency> = [
  PlanDependency { before: ^std_dup_assembly_fix, after: ^probe_flip_fanout },
  PlanDependency { before: ^std_dup_assembly_fix, after: ^deep_module_lanes },
  PlanDependency { before: ^wrap_decision_predicate, after: ^deep_module_lanes },
  PlanDependency { before: ^deep_module_lanes, after: ^emitter_fixed_point },
  PlanDependency { before: ^witness_realization_kernel, after: ^witness_family_fanout },
  PlanDependency { before: ^witness_family_fanout, after: ^ci_floor_cutover },
  PlanDependency { before: ^probe_flip_fanout, after: ^ci_floor_cutover },
  PlanDependency { before: ^emitter_fixed_point, after: ^v1_quarantine },
  PlanDependency { before: ^ci_floor_cutover, after: ^v1_quarantine },
  PlanDependency { before: ^unresolved_error_diagnosis, after: ^v1_quarantine },
  PlanDependency { before: ^trigger_renegotiation, after: ^v1_quarantine },
  PlanDependency { before: ^v1_quarantine, after: ^v1_delete }
]

data v1_deletion_critical_path_note: String = "Two serial chains dominate the calendar and they RUN IN PARALLEL with each other: (A) deep_module_lanes -> emitter_fixed_point (5..10 lane-days remaining; wrap_decision_predicate already LANDED #6776 — see CORRECTION below) and (B) witness_family_fanout -> ci_floor_cutover (6..12 lane-days remaining; witness_realization_kernel LANDED #6879). Everything else fans out beside them. v1_quarantine lands when BOTH chains finish (original projection: day ~12 optimistic, day ~17 realistic). v1_delete = quarantine + executed verification ledger green (no calendar soak). UPDATE 2026-07-19 (cycle-2): std_dup_assembly_fix LANDED+CAPTURED (#6876); ~13 std_dup modules unblocked for flip-wave pending emitter prereqs (Measure neat-swift in flight, FreeMonoid queued, Optional proud-deer); 6 unresolved cargo residue distinct (ROOT-CAUSED emitter-gap). Chain B (stern-lark-430) dispatched. UPDATE 2026-07-20 (cycle-3): chain B serial segment DONE — kernel #6879 merged, family scaffolds #6893/#6894/#6895 merged, six-family diagnosis says emitter clean everywhere / gaps all eval-side, eval-repair arc consolidated on one owner; chain A single gate = FreeMonoid pass executing, flip wave up to 19 modules behind it; module-identity tasks 1-5 all merged (#6889/#6890/#6892/#6898), task 4 at bar (#6899). Operator rulings 2026-07-20: trigger_renegotiation RESOLVED (do not wait on namespace terminal); NO SOAK — v1_delete gates on the executed proactive-verification ledger, never elapsed time. CORRECTION 2026-07-20: wrap_decision_predicate was ALREADY LANDED (#6776 + #6877) — the running row was stale; verified by execution on main. Chain A therefore has ONE remaining serial gate (FreeMonoid pass), after which the flip wave AND the deep-module fan-out both fire."
