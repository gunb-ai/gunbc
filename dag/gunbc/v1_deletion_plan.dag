module gunbc.v1_deletion_plan

import gunbc.roadmap_model { RoadmapNodeId }

data v1_exit_model_doc: String = "COMPACT V1 EXIT MODEL (operator verdict 2026-07-28, retiring this file's second-mutable-roadmap role). This file owns exactly one thing: the identity and meaning of the four v1 finish lines and the roadmap node each binds to. It owns nothing else. The dependency graph is gunbc.roadmap_authority (RoadmapEdge rows); per-node acceptance criteria live on the roadmap tickets themselves (TicketFields red_control/handback — restating them here would be a second representation); acceptance is a gunbc.roadmap_model RoadmapAcceptanceReceipt row in the authority, so a finish line is reached exactly when its bound node is accepted, never by an assertion in this file. The prior three-gate brick ledger (PlanGate/PlanMilestone/BrickState/ConfidenceBasis rows, lane_state execution prose, day estimates; cycle-5 remodel 2026-07-20) is retired: probe receipts and execution state live in their natural carriers (docs/probes/*, the witness corpus, gunbc.proactive_verification_ledger, the self-host frontier), and the full brick history remains in git history at this path. The four-line split replaces the single overloaded 'delete v1' terminal: interpreter deletion is a link-grain no-consumer claim that does not wait on unrelated hand-Rust or v1 test migration; product v1-freedom and repository-wide zero hand-maintained Rust are separate downstream claims with their own bars."

type V1FinishLine
  = CompilerFixedPoint
  | InterpreterDeleted
  | ProductsV1Free
  | ZeroHandMaintainedRust

type V1FinishLineSpec {
  line: V1FinishLine
  name: String
  claim: String
  node: RoadmapNodeId
}

fn v1_exit_node_id(s: String) -> RoadmapNodeId { s }

fn v1_finish_line_key(l: V1FinishLine) -> String {
  match l {
    CompilerFixedPoint => "compiler-fixed-point"
    InterpreterDeleted => "interpreter-deleted"
    ProductsV1Free => "products-v1-free"
    ZeroHandMaintainedRust => "zero-hand-maintained-rust"
  }
}

fn v1_exit_finish_lines() -> List<V1FinishLineSpec> {
  [
    V1FinishLineSpec {
      line: CompilerFixedPoint,
      name: "Compiler fixed point",
      claim: "The v2 emitter re-emits and rebuilds itself for two generations with behavioral equivalence on the discriminating corpus; byte identity with the seed is a non-goal.",
      node: v1_exit_node_id(s: "v1-emitter-fixed-point"),
    },
    V1FinishLineSpec {
      line: InterpreterDeleted,
      name: "Interpreter deleted",
      claim: "No product or required execution surface links or routes through the v1 interpreter, and the interpreter source is deleted; unrelated hand-maintained Rust and v1 compiler tests are not part of this claim.",
      node: v1_exit_node_id(s: "v1-interpreter-delete"),
    },
    V1FinishLineSpec {
      line: ProductsV1Free,
      name: "Products v1-free",
      claim: "Every product builds and runs with src/v1 absent from its build path; a typed terminal-kernel pin with a reason is the only admissible residue.",
      node: v1_exit_node_id(s: "v1-products-v1-free"),
    },
    V1FinishLineSpec {
      line: ZeroHandMaintainedRust,
      name: "Zero hand-maintained Rust",
      claim: "Every tracked Rust source in the repository is emitted from cited .dag models or deleted; hand maintenance is a transitional frontier, never a terminus.",
      node: v1_exit_node_id(s: "v1-zero-hand-maintained-rust"),
    },
  ]
}

fn v1_finish_line_accepted(spec: V1FinishLineSpec, accepted: List<RoadmapNodeId>) -> Bool {
  accepted |> any(id => id == spec.node)
}

fn v1_finish_lines_accepted_count(accepted: List<RoadmapNodeId>) -> Int {
  count(v1_exit_finish_lines() |> filter(s => v1_finish_line_accepted(spec: s, accepted: accepted)))
}
