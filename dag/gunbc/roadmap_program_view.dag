module gunbc.roadmap_program_view

import gunbc.roadmap_model {
  RoadmapNode, RoadmapEdge, RoadmapNodeId, RoadmapAcceptanceReceipt,
  roadmap_parent_ids,
  receipts_for_node, receipt_matches_node,
}
import gunbc.roadmap_execution_contract { contract_has_closing_validation }
import gunbc.roadmap_focus { roadmap_dependency_graph }
import gunbc.roadmap_status { line_ticket }
import gunbc.v1_deletion_plan { V1FinishLine, V1FinishLineSpec, v1_exit_finish_lines, v1_finish_line_key }
import std.graph { reverse_adjacency }

data roadmap_program_view_doc: String = "THE PROGRAM-NAVIGATION PROJECTION AUTHORITY, V0 (operator requirements 2026-08-02): the derived model that answers, for one program, what are we doing / where are we exactly / how much remains / why is it taking this long — before any renderer exists. Every fact here is DERIVED: topology from the roadmap authority's RoadmapEdge rows, acceptance from RoadmapAcceptanceReceipt rows only (a merged pull request accepts nothing — gunbc.roadmap_model node_accepted is the single wall), startability from parents x acceptance, in-flight from caller-supplied observations, and the proposed plane from a carrier that does not exist yet and is therefore typed absent rather than scraped from planning prose. The module is PURE and parameterized — it imports no live authority data — so every derivation is provable on planted fixtures and the six red controls from the requirements execute against synthetic graphs instead of pinning tree-copied measurements (the DESIGN section 5 oracle rule). The one heuristic-shaped choice, tie-breaking the primary constraint, is declared: ties resolve to declaration order, which is the authority's own authored order, never a hidden score. What this V0 deliberately does not model, each with its trigger: decision-held work (needs a typed operator-decision marker on the node; today a decision node is only prose), evidence-refusal constraints (needs the verification-receipt join — gunbc.roadmap_verification_receipt is test-only until the belt wiring seam lands), and proposed-graph overlays (needs a typed proposal carrier; see proposed_plane_note). The camera layers — depth, mode, tuning — are the V1 interaction seam and are deliberately absent here: this module is the world those cameras look at, per the presentation seam design's law that the graph is the world and the UI is a camera."

data program_view_seam_placement_note: String = "Placement (carrier reconciliation, 2026-08-02): this module SITS BESIDE gunbc.roadmap_presentation rather than inside it because the two project different subjects — roadmap_presentation decides how one workspace row renders (lifecycle, activity, disclosure), this module decides what one PROGRAM looks like across its whole dependency graph. It consumes the same upstream authorities (roadmap_model receipts, roadmap_status tickets, roadmap_focus's graph fold, v1_deletion_plan finish lines) and mints nothing those modules already own: ObligationState deliberately does NOT replace WorkLifecycle or WorkScheduling — lifecycle narrates one row's review journey (PRs merged, awaiting acceptance), ObligationState narrates a node's position in the program's dependency algebra (accepted / held / contract-missing / workable), and the in-flight overlay mirrors the lifecycle-x-activity split roadmap_presentation already established rather than fusing state planes into one enum."

type V1ConvergenceFront
  = NamespacePDeriveFront
  | V2GenerationFront
  | HonestFrontierFront
  | MaterializationCutoverFront
  | TestMigrationTailFront

fn program_front_key(front: V1ConvergenceFront) -> String {
  match front {
    NamespacePDeriveFront => "namespace-pderive"
    V2GenerationFront => "v2-generation"
    HonestFrontierFront => "honest-frontier"
    MaterializationCutoverFront => "materialization-cutover"
    TestMigrationTailFront => "test-migration-tail"
  }
}

type ConvergenceFrontSpec {
  front: V1ConvergenceFront
  name: String
  purpose: String
  gates: List<RoadmapNodeId>
}

data v1_convergence_front_rows_note: String = "AUTHORED LIKE FINISH LINES, DERIVED LIKE EVERYTHING ELSE (the gunbc.v1_deletion_plan pattern): a front row states only its identity, its meaning, and the GATE nodes whose acceptance closes it — the operator's own planning decomposition of the v1-deletion program (requirements, 2026-08-02). Membership is never authored: a front's population is the ancestor closure of its gates, walked over the authority's own edges, so adding or removing a prerequisite in the roadmap moves the front automatically and a hand-maintained member list cannot drift (the requirements' forbidden 'hand-maintained lane membership'). Contribution is never authored either: a front contributes to a finish line exactly when one of its gates is an ancestor of that line's node, so the front-to-outcome map is a fact of the graph. Fronts are PROJECTIONS, not a partition — the materialization-cutover front's ancestor closure legitimately overlaps the honest-frontier front's, because the cutover gate genuinely depends on the frontier — and a misspelled gate id refuses the whole projection with a located cause rather than deriving a silently smaller front (program_view_refusal_note)."

fn v1_convergence_fronts() -> List<ConvergenceFrontSpec> {
  [
    ConvergenceFrontSpec {
      front: NamespacePDeriveFront,
      name: "Namespace / P-derive",
      purpose: "Names resolve from one containment authority and P-derive binds source slots on it, producing the receipt the emitter fixed point consumes.",
      gates: [ "pderive-error-movement-receipt" as RoadmapNodeId ],
    },
    ConvergenceFrontSpec {
      front: V2GenerationFront,
      name: "V2 generation and admission",
      purpose: "The new compiler generates real modules through the direct Rust door and bootstraps natively from its own output.",
      gates: [ "v2-emitter-native-bootstrap" as RoadmapNodeId ],
    },
    ConvergenceFrontSpec {
      front: HonestFrontierFront,
      name: "Honest frontier / hand queue",
      purpose: "Every tracked Rust path carries an honest disposition and the hand-maintained queue drains to zero.",
      gates: [ "v1-hand-queue-drain" as RoadmapNodeId ],
    },
    ConvergenceFrontSpec {
      front: MaterializationCutoverFront,
      name: "Materialization, verification, cutover",
      purpose: "Exact prior results are reusable, verification reads the ledger, and the CI floor cuts over to the new path.",
      gates: [ "v1-ci-floor-cutover" as RoadmapNodeId ],
    },
    ConvergenceFrontSpec {
      front: TestMigrationTailFront,
      name: "Test migration and the namespace tail",
      purpose: "The old compiler's tests migrate or retire with coverage receipts, the seed honesty decision lands, and the import grammar deletes.",
      gates: [
        "v1-test-migration" as RoadmapNodeId,
        "v1-seed-honesty-decision" as RoadmapNodeId,
        "namespace-import-deletion" as RoadmapNodeId,
      ],
    },
  ]
}

type ObligationState
  = ObligationAccepted
  | ObligationDependencyHeld { unmet: List<RoadmapNodeId> }
  | ObligationContractHeld
  | ObligationStartable

data obligation_state_note: String = "One node's position in the program's dependency algebra, decided in a fixed order: an acceptance receipt wins outright; otherwise unmet prerequisites hold it; otherwise a missing closing validation holds it (the same single authority the closing-contract task projection reads — gunbc.roadmap_execution_contract contract_has_closing_validation — so this module and the daily frontier can never disagree about boundness); otherwise it is workable now. In-flight is deliberately NOT an arm: work observed on a node is an overlay fact orthogonal to its dependency position — an attempt can run on a held node — and fusing them would be the state-space conflation DESIGN section 5 names. The requirements' partial-work controls land here by construction: nothing in this coproduct reads pull requests, so a merged PR, a partial wave, or a contract-only slice cannot reach ObligationAccepted — only a matching receipt can."

type NodeStanding {
  node: RoadmapNodeId
  state: ObligationState
  in_flight: Bool
  unsized: Bool
}

fn program_find_node(nodes: List<RoadmapNode>, id: RoadmapNodeId) -> RoadmapNode? {
  fold(nodes, init: none, f: (acc, n) =>
    if (n.node as String) == (id as String) {
      Present { value: n }
    } else {
      acc
    })
}

fn program_accepted_ids(nodes: List<RoadmapNode>, receipts: List<RoadmapAcceptanceReceipt>) -> List<String> {
  receipts
    |> filter(r =>
      count(receipts_for_node(receipts: receipts, id: r.node)) == 1
        && match program_find_node(nodes: nodes, id: r.node) {
          Present { value: n } => receipt_matches_node(r: r, rn: n)
          Absent => false
        })
    |> map(r => r.node as String)
}

fn program_node_standing(
  n: RoadmapNode,
  parent_index: Map<String, List<String>>,
  accepted: List<String>,
  in_flight: List<String>,
) -> NodeStanding {
  let id = n.node as String
  let unmet = program_parent_ids_index(index: parent_index, node: id)
    |> filter(p => !(accepted |> any(a => a == p)))
    |> map(p => p as RoadmapNodeId)
  let state = if accepted |> any(a => a == id) {
    ObligationAccepted
  } else {
    if count(unmet) > 0 {
      ObligationDependencyHeld { unmet: unmet }
    } else {
      if contract_has_closing_validation(contract: n.execution) {
        ObligationStartable
      } else {
        ObligationContractHeld
      }
    }
  }
  NodeStanding {
    node: n.node,
    state: state,
    in_flight: in_flight |> any(f => f == id),
    unsized: match n.sizing {
      Unsized => true
      Sized { intricacy: _, volume: _, repo: _, acceptance: _ } => false
    },
  }
}

type RemainingShape {
  sequential_depth: Int
  open_fronts: Int
  startable_now: Int
  in_flight: Int
  dependency_held: Int
  contract_held: Int
  unsized: Int
}

data remaining_shape_note: String = "HOW MUCH REMAINS, WITHOUT A PERCENTAGE. The program contains incomparable work — a sequential compiler spine, broad classification frontiers, contract authoring — so one completion fraction would fabricate commensurability, and the presentation seam design already prohibits a progress_percent field outright. The shape instead carries exact populations over the subject's ancestor closure: sequential_depth is the longest chain of unaccepted obligations ending at the subject (a topological measure, never a calendar claim — duration lives in gunbc.roadmap_forecast, which owns calibrated time and refuses without samples); open_fronts counts contributing fronts not yet closed; the remaining counts partition the closure's unaccepted population by ObligationState with in-flight and unsized as overlay counts. Deferred fields, named so the gap is countable: decision_held waits on a typed operator-decision marker, and evidence_held (verification refused or stale) waits on the verification-receipt join reaching production. Both land as new fields on this record, never as reinterpretations of existing ones."

fn program_shape_counts(
  standings: List<NodeStanding>,
  sequential_depth: Int,
  open_fronts: Int,
) -> RemainingShape {
  RemainingShape {
    sequential_depth: sequential_depth,
    open_fronts: open_fronts,
    startable_now: count(standings |> filter(s => match s.state {
      ObligationStartable => !s.in_flight
      ObligationAccepted => false
      ObligationDependencyHeld { unmet: _ } => false
      ObligationContractHeld => false
    })),
    in_flight: count(standings |> filter(s => s.in_flight && match s.state {
      ObligationAccepted => false
      ObligationStartable => true
      ObligationDependencyHeld { unmet: _ } => true
      ObligationContractHeld => true
    })),
    dependency_held: count(standings |> filter(s => match s.state {
      ObligationDependencyHeld { unmet: _ } => true
      ObligationAccepted => false
      ObligationStartable => false
      ObligationContractHeld => false
    })),
    contract_held: count(standings |> filter(s => match s.state {
      ObligationContractHeld => true
      ObligationAccepted => false
      ObligationStartable => false
      ObligationDependencyHeld { unmet: _ } => false
    })),
    unsized: count(standings |> filter(s => s.unsized && match s.state {
      ObligationAccepted => false
      ObligationStartable => true
      ObligationDependencyHeld { unmet: _ } => true
      ObligationContractHeld => true
    })),
  }
}

type DepthRow {
  id: String
  depth: Int
}

data program_sequential_depth_note: String = "The longest unaccepted chain, computed as a bounded relaxation over the dependency DAG: each node's depth is its own weight (one if unaccepted, zero if accepted) plus the maximum parent depth, iterated to a fixpoint with the node count as the termination bound — a DAG's longest chain cannot exceed its node population, so the bound is structural, not a tuning knob. Relaxation is chosen over naive recursion deliberately: memoless recursion over a diamond-shaped DAG re-walks shared ancestors exponentially (the cost-shape class the bare-minimum-cost rule forbids at any n), while relaxation is O(passes x nodes x edges) with an early exit on the first unchanged pass. Accepted nodes carry weight zero but stay in the walk, so a chain that passes through accepted work counts only its unaccepted links — accepting a mid-chain node shortens the measured depth by exactly one, which is the requirements' collapse red control, executed on fixtures."

fn program_int_max(a: Int, b: Int) -> Int {
  if a > b { a } else { b }
}

fn program_depth_lookup_map(depths: Map<String, Int>, id: String) -> Int {
  match map_get(depths, id) {
    Present { value: d } => d
    Absent => 0
  }
}

fn program_depth_rows(depth_map: Map<String, Int>, ids: List<String>) -> List<DepthRow> {
  ids |> map(id => DepthRow {
    id: id,
    depth: program_depth_lookup_map(depths: depth_map, id: id),
  })
}

fn program_depth_lookup(rows: List<DepthRow>, id: String) -> Int {
  fold(rows, init: 0, f: (acc, r) => if r.id == id { r.depth } else { acc })
}

fn program_depth_weight(accepted: List<String>, id: String) -> Int {
  if accepted |> any(a => a == id) { 0 } else { 1 }
}

fn program_parent_index_step(
  acc: Map<String, List<String>>,
  edge: RoadmapEdge,
) -> Map<String, List<String>> {
  let child = edge.child as String
  let parent = edge.parent as String
  match map_get(acc, child) {
    Present { value: parents } => map_insert(acc, child, concat(parents, [parent]))
    Absent => map_insert(acc, child, [parent])
  }
}

fn program_parent_index(edges: List<RoadmapEdge>) -> Map<String, List<String>> {
  edges |> fold(init: empty_map(), f: program_parent_index_step)
}

fn program_parent_ids_index(index: Map<String, List<String>>, node: String) -> List<String> {
  match map_get(index, node) {
    Present { value: parents } => parents
    Absent => []
  }
}

type ProgramDfsAcc {
  visited: Set<String>
  members: List<String>
}

fn program_dfs_collect(
  node: String,
  reverse_adj: Map<String, List<String>>,
  acc: ProgramDfsAcc,
) -> ProgramDfsAcc {
  if set_contains(acc.visited, node) {
    acc
  } else {
    let next_visited = set_insert(acc.visited, node)
    let next_members = concat(acc.members, [node])
    let neighbors = match map_get(reverse_adj, node) {
      Present { value: ns } => ns
      Absent => []
    }
    neighbors |> fold(
      init: ProgramDfsAcc { visited: next_visited, members: next_members },
      f: (inner, neighbor) => program_dfs_collect(node: neighbor, reverse_adj: reverse_adj, acc: inner),
    )
  }
}

fn program_reverse_reachable_members(
  reverse_adj: Map<String, List<String>>,
  start: String,
) -> List<String> {
  let reached = program_dfs_collect(
    node: start,
    reverse_adj: reverse_adj,
    acc: ProgramDfsAcc { visited: empty_set(), members: [] },
  )
  reached.members |> filter(member => member != start)
}

fn program_relax_once(
  depth_map: Map<String, Int>,
  ids: List<String>,
  parent_index: Map<String, List<String>>,
  accepted: List<String>,
) -> Map<String, Int> {
  ids |> fold(init: empty_map(), f: (acc, id) => {
    let depth = program_depth_weight(accepted: accepted, id: id) +
      fold(
        program_parent_ids_index(index: parent_index, node: id),
        init: 0,
        f: (pacc, p) => program_int_max(
          a: pacc,
          b: program_depth_lookup_map(depths: depth_map, id: p),
        ),
      )
    map_insert(acc, id, depth)
  })
}

fn program_depths_equal_map(
  a: Map<String, Int>,
  b: Map<String, Int>,
  ids: List<String>,
) -> Bool {
  all(ids, id => program_depth_lookup_map(depths: a, id: id) == program_depth_lookup_map(depths: b, id: id))
}

fn program_relax_to_fixpoint(
  depth_map: Map<String, Int>,
  ids: List<String>,
  parent_index: Map<String, List<String>>,
  accepted: List<String>,
  remaining_passes: Int,
) -> Map<String, Int> {
  if remaining_passes <= 0 {
    depth_map
  } else {
    let next = program_relax_once(
      depth_map: depth_map,
      ids: ids,
      parent_index: parent_index,
      accepted: accepted,
    )
    if program_depths_equal_map(a: next, b: depth_map, ids: ids) {
      next
    } else {
      program_relax_to_fixpoint(
        depth_map: next,
        ids: ids,
        parent_index: parent_index,
        accepted: accepted,
        remaining_passes: remaining_passes - 1,
      )
    }
  }
}

fn program_sequential_depth_map(
  ids: List<String>,
  parent_index: Map<String, List<String>>,
  accepted: List<String>,
) -> Map<String, Int> {
  let init = ids |> fold(init: empty_map(), f: (acc, id) =>
    map_insert(acc, id, program_depth_weight(accepted: accepted, id: id)))
  program_relax_to_fixpoint(
    depth_map: init,
    ids: ids,
    parent_index: parent_index,
    accepted: accepted,
    remaining_passes: count(ids),
  )
}

fn program_depths_equal(a: List<DepthRow>, b: List<DepthRow>) -> Bool {
  count(a) == count(b)
    && all(a, r => program_depth_lookup(rows: b, id: r.id) == r.depth)
}

fn program_relax_to_fixpoint_rows(
  rows: List<DepthRow>,
  ids: List<String>,
  edges: List<RoadmapEdge>,
  accepted: List<String>,
  remaining_passes: Int,
) -> List<DepthRow> {
  if remaining_passes <= 0 {
    rows
  } else {
    let next = program_relax_once_rows(
      rows: rows, ids: ids, edges: edges, accepted: accepted,
    )
    if program_depths_equal(a: next, b: rows) {
      next
    } else {
      program_relax_to_fixpoint_rows(
        rows: next, ids: ids, edges: edges, accepted: accepted,
        remaining_passes: remaining_passes - 1,
      )
    }
  }
}

fn program_relax_once_rows(
  rows: List<DepthRow>,
  ids: List<String>,
  edges: List<RoadmapEdge>,
  accepted: List<String>,
) -> List<DepthRow> {
  ids |> map(id => DepthRow {
    id: id,
    depth: program_depth_weight(accepted: accepted, id: id) +
      fold(
        roadmap_parent_ids(edges: edges, node: id as RoadmapNodeId),
        init: 0,
        f: (acc, p) => program_int_max(a: acc, b: program_depth_lookup(rows: rows, id: p as String)),
      ),
  })
}

fn program_sequential_depths(
  ids: List<String>,
  edges: List<RoadmapEdge>,
  accepted: List<String>,
) -> List<DepthRow> {
  let init = ids |> map(id => DepthRow {
    id: id,
    depth: program_depth_weight(accepted: accepted, id: id),
  })
  program_relax_to_fixpoint_rows(
    rows: init, ids: ids, edges: edges, accepted: accepted,
    remaining_passes: count(ids),
  )
}

fn program_dedupe_ids(xs: List<String>) -> List<String> {
  fold(xs, init: [], f: (acc, x) =>
    if acc |> any(a => a == x) { acc } else { concat(acc, [x]) })
}

fn program_ancestors_or_self(
  reverse_adj: Map<String, List<String>>,
  id: String,
) -> List<String> {
  concat(
    program_reverse_reachable_members(reverse_adj: reverse_adj, start: id),
    [id],
  )
}

type ConstraintKind
  = ImplementationConstraint
  | ContractConstraint

data constraint_kind_note: String = "WHAT SORT OF DIFFICULTY THE PRIMARY CONSTRAINT IS. Only the kinds this module can DERIVE exist as arms — an enum arm nothing can produce is specification without execution. ImplementationConstraint: the node is workable and its closing contract exists; what remains is doing the work (whether an attempt is currently observed rides on the in_flight overlay). ContractConstraint: the node is workable but nothing can check its completion — authoring the closing validation is the unblocking act, the same fact the daily workspace's closing-contract family surfaces. Dependency-held is deliberately NOT a primary-constraint kind: the primary constraint is found by walking to the workable frontier, so a held node's cause is always some frontier node upstream, and reporting the held node instead of its cause would be the old explanation the requirements' why-mode exists to kill. Deferred kinds with named triggers: DecisionConstraint (typed operator-decision marker), EvidenceConstraint (verification-refusal join), CapabilityGap and PopulationFrontier (typed carriers on the guarantee-claims lane)."

type ConstraintView {
  subject: RoadmapNodeId
  kind: ConstraintKind
  headline: String
  in_flight: Bool
  depth: Int
}

fn program_node_headline(nodes: List<RoadmapNode>, id: String) -> String {
  fold(nodes, init: id, f: (acc, n) =>
    if (n.node as String) == id {
      match line_ticket(item: n.line) {
        Present { value: t } => t.headline
        Absent => id
      }
    } else { acc })
}

data program_primary_constraint_note: String = "The nearest unresolved constraint, derived: among the subject's unaccepted ancestor closure, the candidates are the WORKABLE frontier — nodes every prerequisite of which is accepted (ObligationStartable or ObligationContractHeld, in-flight or not) — and the primary is the candidate with the greatest sequential depth, because the deepest workable node heads the longest unresolved chain and is therefore the current best candidate for the binding path. That claim is deliberately modest: it names the best CURRENT candidate from topology alone, never a critical path in the scheduling sense — duration evidence lives in the forecast module and this view does not pretend to it. Ties resolve to the first candidate in declaration order, which is the authority's authored order: deterministic, inspectable, and free of hidden scoring. An accepted subject has no constraint, and a subject whose entire closure is accepted or held-with-no-workable-frontier yields none honestly — in a DAG the second case implies the first, since every nonempty unaccepted closure has a minimal element."

fn program_constraint_take(acc: ConstraintView?, depth: Int) -> Bool {
  match acc {
    Absent => true
    Present { value: best } => depth > best.depth
  }
}

fn program_constraint_of(
  s: NodeStanding,
  depth_map: Map<String, Int>,
  nodes: List<RoadmapNode>,
) -> ConstraintView {
  ConstraintView {
    subject: s.node,
    kind: match s.state {
      ObligationContractHeld => ContractConstraint
      ObligationStartable => ImplementationConstraint
      ObligationAccepted => ImplementationConstraint
      ObligationDependencyHeld { unmet: _ } => ImplementationConstraint
    },
    headline: program_node_headline(nodes: nodes, id: s.node as String),
    in_flight: s.in_flight,
    depth: program_depth_lookup_map(depths: depth_map, id: s.node as String),
  }
}

fn program_constraint_step(
  acc: ConstraintView?,
  s: NodeStanding,
  depth_map: Map<String, Int>,
  nodes: List<RoadmapNode>,
) -> ConstraintView? {
  if program_constraint_take(
    acc: acc,
    depth: program_depth_lookup_map(depths: depth_map, id: s.node as String),
  ) {
    Present { value: program_constraint_of(s: s, depth_map: depth_map, nodes: nodes) }
  } else {
    acc
  }
}

fn program_primary_constraint(
  scope: List<String>,
  standings: List<NodeStanding>,
  depth_map: Map<String, Int>,
  nodes: List<RoadmapNode>,
) -> ConstraintView? {
  let candidates = standings
    |> filter(s => scope |> any(id => id == (s.node as String)))
    |> filter(s => match s.state {
      ObligationStartable => true
      ObligationContractHeld => true
      ObligationAccepted => false
      ObligationDependencyHeld { unmet: _ } => false
    })
  fold(candidates, init: none, f: (acc, s) =>
    program_constraint_step(acc: acc, s: s, depth_map: depth_map, nodes: nodes))
}

type ProposedPlane
  = | ProposedCarrierAbsent

data proposed_plane_note: String = "THE PROPOSED PLANE HAS NO CARRIER, AND SAYS SO IN ITS TYPE. Proposed work — graph additions or changes not yet admitted to the roadmap authority — has no typed home today: it lives in planning documents and conversations, and scraping those would author topology in the viewer, the exact drift the requirements' red controls forbid. So the plane is a single-arm type carrying nothing: a proposed node cannot appear in any plane of this view because no constructor exists that could hold one — the requirements' ghost-plane red control discharged by construction rather than by a witness watching a writable state. DISSOLVES ON a typed proposal carrier landing (the operator's source-intent lane owns the nearest candidate shape), at which point this type gains a ProposedRows arm whose rows render as the requirements' outlined-ghost grammar and are structurally excluded from the accepted and in-flight planes by carrying their own type."

type FrontView {
  front: V1ConvergenceFront
  key: String
  name: String
  purpose: String
  gates: List<RoadmapNodeId>
  gates_total: Int
  gates_accepted: Int
  closed: Bool
  remaining: RemainingShape
  constraint: ConstraintView?
}

type FinishLineView {
  line: V1FinishLine
  key: String
  name: String
  claim: String
  node: RoadmapNodeId
  accepted: Bool
  contributing_fronts: List<V1ConvergenceFront>
  remaining: RemainingShape
  constraint: ConstraintView?
}

type V1DeletionProgramView {
  finish_lines: List<FinishLineView>
  fronts: List<FrontView>
  remaining: RemainingShape
  proposed: ProposedPlane
}

type ProgramViewRefusalCause
  = FinishLineNodeUnresolved { line_key: String, node: RoadmapNodeId }
  | FrontGateUnresolved { front_key: String, gate: RoadmapNodeId }

type V1ProgramViewResult
  = ProgramViewDerived { view: V1DeletionProgramView }
  | ProgramViewRefused { causes: List<ProgramViewRefusalCause> }

data program_view_refusal_note: String = "IDENTITY RESOLUTION IS A WALL, NOT A FILTER. A finish-line node or front gate that names no declared node is a modeling defect — the requirements' misspelled-R1 red control — and the projection REFUSES with every located cause rather than deriving around the hole: a silently smaller front would zero the defect's frequency and misreport every count downstream, the absorbing-fallback shape DESIGN section 5 forbids. The causes list carries all failures, not the first, so one repair round sees the whole population."

fn program_view(
  lines: List<V1FinishLineSpec>,
  fronts: List<ConvergenceFrontSpec>,
  nodes: List<RoadmapNode>,
  edges: List<RoadmapEdge>,
  receipts: List<RoadmapAcceptanceReceipt>,
  in_flight: List<String>,
) -> V1ProgramViewResult {
  let ids = nodes |> map(n => n.node as String)
  let line_causes = lines
    |> filter(l => !(ids |> any(id => id == (l.node as String))))
    |> map(l => FinishLineNodeUnresolved { line_key: v1_finish_line_key(l: l.line), node: l.node })
  let gate_causes = fold(fronts, init: [], f: (acc, fs) => concat(acc,
    fs.gates
      |> filter(g => !(ids |> any(id => id == (g as String))))
      |> map(g => FrontGateUnresolved { front_key: program_front_key(front: fs.front), gate: g })))
  let causes = concat(line_causes, gate_causes)
  if count(causes) > 0 {
    ProgramViewRefused { causes: causes }
  } else {
    let graph = roadmap_dependency_graph(edges: edges)
    let reverse_adj = reverse_adjacency(names: ids, graph: graph)
    let parent_index = program_parent_index(edges: edges)
    let accepted = program_accepted_ids(nodes: nodes, receipts: receipts)
    let depth_map = program_sequential_depth_map(
      ids: ids,
      parent_index: parent_index,
      accepted: accepted,
    )
    let depths = program_depth_rows(depth_map: depth_map, ids: ids)
    let standings = nodes |> map(n =>
      program_node_standing(
        n: n,
        parent_index: parent_index,
        accepted: accepted,
        in_flight: in_flight,
      ))
    let front_views = fronts |> map(fs => program_front_view(
      spec: fs,
      reverse_adj: reverse_adj,
      accepted: accepted,
      standings: standings,
      depth_map: depth_map,
      nodes: nodes))
    let line_views = lines |> map(l => program_finish_line_view(
      l: l,
      fronts: fronts,
      front_views: front_views,
      reverse_adj: reverse_adj,
      accepted: accepted,
      standings: standings,
      depth_map: depth_map,
      nodes: nodes))
    let program_scope = program_dedupe_ids(
      fold(lines, init: [], f: (acc, l) => concat(acc,
        program_ancestors_or_self(reverse_adj: reverse_adj, id: l.node as String))))
    ProgramViewDerived { view: V1DeletionProgramView {
      finish_lines: line_views,
      fronts: front_views,
      remaining: program_shape_counts(
        standings: standings |> filter(s => program_scope |> any(id => id == (s.node as String))),
        sequential_depth: fold(lines, init: 0, f: (acc, l) =>
          program_int_max(
            a: acc,
            b: program_depth_lookup_map(depths: depth_map, id: l.node as String),
          )),
        open_fronts: count(front_views |> filter(fv => !fv.closed)),
      ),
      proposed: ProposedCarrierAbsent,
    } }
  }
}

fn program_front_view(
  spec: ConvergenceFrontSpec,
  reverse_adj: Map<String, List<String>>,
  accepted: List<String>,
  standings: List<NodeStanding>,
  depth_map: Map<String, Int>,
  nodes: List<RoadmapNode>,
) -> FrontView {
  let scope = program_dedupe_ids(
    fold(spec.gates, init: [], f: (acc, g) => concat(acc,
      program_ancestors_or_self(reverse_adj: reverse_adj, id: g as String))))
  let gates_accepted = count(spec.gates |> filter(g => accepted |> any(a => a == (g as String))))
  let closed = gates_accepted == count(spec.gates)
  FrontView {
    front: spec.front,
    key: program_front_key(front: spec.front),
    name: spec.name,
    purpose: spec.purpose,
    gates: spec.gates,
    gates_total: count(spec.gates),
    gates_accepted: gates_accepted,
    closed: closed,
    remaining: program_shape_counts(
      standings: standings |> filter(s => scope |> any(id => id == (s.node as String))),
      sequential_depth: fold(spec.gates, init: 0, f: (acc, g) =>
        program_int_max(
          a: acc,
          b: program_depth_lookup_map(depths: depth_map, id: g as String),
        )),
      open_fronts: if closed { 0 } else { 1 },
    ),
    constraint: program_primary_constraint(
      scope: scope,
      standings: standings,
      depth_map: depth_map,
      nodes: nodes,
    ),
  }
}

data front_contribution_note: String = "A front contributes to a finish line exactly when one of its GATES is an ancestor of the line's node (or the node itself): the gate is the front's output, so contribution means the front's product flows into the outcome, not merely that the two share deep ancestors — a member-overlap rule would connect every front to every downstream outcome and discriminate nothing. Derived over the authority's edges, so the contribution sets shift exactly when someone edits the authored graph, which is when a human should be looking."

fn program_finish_line_view(
  l: V1FinishLineSpec,
  fronts: List<ConvergenceFrontSpec>,
  front_views: List<FrontView>,
  reverse_adj: Map<String, List<String>>,
  accepted: List<String>,
  standings: List<NodeStanding>,
  depth_map: Map<String, Int>,
  nodes: List<RoadmapNode>,
) -> FinishLineView {
  let scope = program_ancestors_or_self(reverse_adj: reverse_adj, id: l.node as String)
  let contributing = fronts
    |> filter(fs => fs.gates |> any(g => scope |> any(id => id == (g as String))))
    |> map(fs => fs.front)
  let line_accepted = accepted |> any(a => a == (l.node as String))
  FinishLineView {
    line: l.line,
    key: v1_finish_line_key(l: l.line),
    name: l.name,
    claim: l.claim,
    node: l.node,
    accepted: line_accepted,
    contributing_fronts: contributing,
    remaining: program_shape_counts(
      standings: standings |> filter(s => scope |> any(id => id == (s.node as String))),
      sequential_depth: program_depth_lookup_map(depths: depth_map, id: l.node as String),
      open_fronts: count(front_views
        |> filter(fv => !fv.closed)
        |> filter(fv => contributing |> any(c => program_front_key(front: c) == fv.key))),
    ),
    constraint: if line_accepted { none } else {
      program_primary_constraint(
        scope: scope,
        standings: standings,
        depth_map: depth_map,
        nodes: nodes,
      )
    },
  }
}

fn v1_program_view(
  nodes: List<RoadmapNode>,
  edges: List<RoadmapEdge>,
  receipts: List<RoadmapAcceptanceReceipt>,
  in_flight: List<String>,
) -> V1ProgramViewResult {
  program_view(
    lines: v1_exit_finish_lines(),
    fronts: v1_convergence_fronts(),
    nodes: nodes,
    edges: edges,
    receipts: receipts,
    in_flight: in_flight,
  )
}
