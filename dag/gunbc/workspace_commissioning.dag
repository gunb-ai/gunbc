module gunbc.workspace_commissioning

import std.types { String, NonEmptyStr, Int, List }
import std.measure { ByteSize, HardwareThreadCount, byte_size_count, hardware_thread_count_value }
import gunbc.workspace_commissioning_evidence { WorkspaceInitialReadinessPermit, workspace_initial_readiness_permit }
import gunbc.workspace_allocation { workspace_profile_vcpus, LargeWorkspace }
import gunbc.runner_slot_allocation { gunbc_microvm_shakedown_slot_memory_max }
import gunbc.build_cache_instance { RunnerSlotIdentity, runner_slot_instance_name }
import gunbc.fleet_host_budget { HostAllocationVerdict, HostAllocationConserves, HostAllocationOversubscribed, HostAllocationUnchargeable }
import product.fabric.sanitation { CellId, CellReady, CellQuarantined, SanitationObservation, SlotScopedNetwork, cell_readiness_from_observations }

// This is administrator commissioning intent bound to an existing convergence artifact. It is
// not inferred from a missing directory or a failed unit. No current observation mints authorization; the effect may select WIF or app approval.
type WorkspaceCommissioningAuthority
  = WorkspaceCommissioningUnapproved
  | WorkspaceCommissioningAuthorizedPlan { slot: RunnerSlotIdentity, plan_hash: NonEmptyStr }

type WorkspacePriorPurpose
  = WorkspacePriorPurposeWithdrawn
  | WorkspacePriorPurposeActive
  | WorkspacePriorPurposeUnknown

// Missing stores cannot supply this census. Existing obligations must be recovered, and their
// generations retained, before a new initial-cell record can be published.
type WorkspaceObligationCensus
  = WorkspaceNoPriorObligations { settled_generation: Int }
  | WorkspacePriorObligationsRemain { reason: String }
  | WorkspaceObligationHistoryUnreadable { reason: String }

type WorkspaceCommissionedSlot sole_constructor {
  slot: RunnerSlotIdentity
  cpu_budget: HardwareThreadCount
  attempt_envelope: ByteSize
  commissioning_plan_hash: NonEmptyStr
  settled_generation: Int
  initial_readiness: WorkspaceInitialReadinessPermit
}

type WorkspaceCommissioningAdmission
  = WorkspaceCommissioningReady { commissioned: WorkspaceCommissionedSlot }
  | WorkspaceCommissioningRefused { reason: String }

// The fixed demo envelope is a capacity commitment, not a projection from the submitted guest.
// Host conservation must already account for this entire envelope plus the separate controller.
fn workspace_commissioning_admit(
  slot: RunnerSlotIdentity, authority: WorkspaceCommissioningAuthority,
  budget: HostAllocationVerdict, cpu_budget: HardwareThreadCount, attempt_envelope: ByteSize,
  prior_purpose: WorkspacePriorPurpose, obligations: WorkspaceObligationCensus,
  sanitation: List<SanitationObservation>,
) -> WorkspaceCommissioningAdmission {
  match authority {
    WorkspaceCommissioningUnapproved => WorkspaceCommissioningRefused { reason: "reviewed convergence commissioning provenance is absent; missing stores do not prove an unused slot" }
    WorkspaceCommissioningAuthorizedPlan { slot: approved_slot, plan_hash: approved_plan } => if approved_slot != slot {
      WorkspaceCommissioningRefused { reason: "administrator commissioning names a different slot" }
    } else { match budget {
      HostAllocationOversubscribed => WorkspaceCommissioningRefused { reason: "host budget cannot conserve the dedicated envelope" }
      HostAllocationUnchargeable { cause: detail } => WorkspaceCommissioningRefused { reason: detail }
      HostAllocationConserves => if hardware_thread_count_value(t: cpu_budget) < workspace_profile_vcpus(profile: LargeWorkspace) || byte_size_count(b: attempt_envelope) != byte_size_count(b: gunbc_microvm_shakedown_slot_memory_max) {
        WorkspaceCommissioningRefused { reason: "commissioning must reserve at least four vCPUs and exactly the existing 28GiB attempt envelope" }
      } else { match prior_purpose {
        WorkspacePriorPurposeActive => WorkspaceCommissioningRefused { reason: "competing slot purpose remains active" }
        WorkspacePriorPurposeUnknown => WorkspaceCommissioningRefused { reason: "competing slot purpose withdrawal is unobserved" }
        WorkspacePriorPurposeWithdrawn => match obligations {
          WorkspacePriorObligationsRemain { reason: detail } => WorkspaceCommissioningRefused { reason: detail }
          WorkspaceObligationHistoryUnreadable { reason: detail } => WorkspaceCommissioningRefused { reason: detail }
          WorkspaceNoPriorObligations { settled_generation: generation } => if generation != 0 {
            WorkspaceCommissioningRefused { reason: "initial commissioning requires an observed never-recorded slot; nonzero history must be recovered" }
          } else { match cell_readiness_from_observations(cell: runner_slot_instance_name(slot: slot) as CellId, network_scope: SlotScopedNetwork, observations: sanitation) {
            CellQuarantined { cell: _, unproven: _ } => WorkspaceCommissioningRefused { reason: "initial cell sanitation is incomplete; no initial readiness may be published" }
            CellReady { cell: _ } => WorkspaceCommissioningReady { commissioned: WorkspaceCommissionedSlot {
              slot: slot, cpu_budget: cpu_budget, attempt_envelope: attempt_envelope,
              commissioning_plan_hash: approved_plan, settled_generation: generation,
              initial_readiness: workspace_initial_readiness_permit(cell: runner_slot_instance_name(slot: slot) as CellId, settled_generation: generation),
            } }
          } }
        }
      } }
    } }
  }
}
