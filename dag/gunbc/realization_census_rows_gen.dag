  CensusModuleClass,
  CensusClassRung,
  DimensionReading,
  ModuleCensusReading,
  FindingCensusReading,
  ClassCensusReading,
  DimensionStorage,
  DimensionCaching,
  DimensionAccess,
  DimensionAuthz,
  DimensionPlacement,
  DimensionOther,
  SiteNone,
  SiteHome,
  SitePassed,
  SiteRederived,
  SiteLiteral,
  SiteForked,
  SiteOther,
  LevelL0,
  LevelL1,
  LevelL2,
  LevelL3,
  LevelL4,
  LevelL5,
  ClassProduction,
  ClassSeedGenerated,
  ClassSeed,
  ClassRoster,
  ClassTest,
  ClassExtdeps,
  RungUnmodeled,
  RungOnLadder,
  decision_site_text,
  realization_level_text,
  realization_dimension_text,
