module gunbc.gunbhub_serve_html


fn sample_html_page() -> std.markup.Fragment {
  std.markup.Element {
    tag: "p",
    attributes: [],
    children: [ std.markup.FragmentText { content: "gunbhub" } ],
  }
}

fn witness_html_consumer_serializes() -> Bool {
  match extdeps.languages.html.try_serialize_html_source(node: sample_html_page()) {
    extdeps.languages.html.EmitOk { html: h } => h == "<p>gunbhub</p>"
    extdeps.languages.html.EmitRejected { reason: _ } => false
  }
}

fn gunbhub_html_render_keystone_holds() -> Bool {
  witness_html_consumer_serializes()
}
