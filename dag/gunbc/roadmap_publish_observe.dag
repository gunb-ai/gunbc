module gunbc.roadmap_publish_observe

import std.types { String, NonEmptyStr, Int, Bool, List, CommitSha }
import extdeps.git
import extdeps.git {
  AdvertisedRef,
  AdvertisedRefScan, AdvertisedRefsRead, AdvertisedRefLineUnparsed,
  scan_advertised_refs,
  advertised_ref_branch_name,
}
import gunbc.roadmap_publish {
  RemoteBranch,
  RemoteBranchObservation, RemoteBranchesRead, RemoteBranchesUnreadable,
  RemoteBranchReadFailure,
  RefAdvertisementRefused, AdvertisedLineUnparsed, AdvertisedRefProjectsEmptyBranch,
}

data observer_role_note: String = "THIS IS THE HALF THAT TOUCHES THE NETWORK, SEPARATED FROM THE HALF THAT JUDGES. gunbc.roadmap_publish adjudicates observations a caller already holds, which is what makes every one of its arms reachable from constructed values in a witness. That property is worth keeping, so the reading lives here instead: this module calls the transport, decides what was learned, and hands back an ordinary value. The split is the reason the refusal arms are constructible at all - a function that called the service itself could not build them, because a transport failure there is not a value.\\n\\nWhat this module must never become is a second adjudicator. It reports what it saw and refuses when it could not see; which outcome that implies is roadmap_publish's business."

data remote_branch_observation_note: String = "THE REFUSAL IS BUILT FROM A VALUE, NOT CAUGHT. git.Core.LsRemoteHeads declares success/exit_code/stderr as outputs, so a failed ref advertisement arrives as an ordinary record this function can match on. That is not true of every transport in the corpus - the REST dispatch raises on a non-2xx rather than returning one - and the difference is exactly why the remote-branch half of publication can be observed today and the pull-request half cannot."

fn advertised_ref_to_remote_branch(r: AdvertisedRef, remote: NonEmptyStr) -> RemoteBranch {
  RemoteBranch {
    remote: remote,
    branch: advertised_ref_branch_name(ref_name: r.ref_name) as NonEmptyStr,
    head_sha: r.object_id,
  }
}

data empty_branch_projection_note: String = "WHY AN EMPTY PROJECTED BRANCH NAME REFUSES INSTEAD OF BEING CAST. RemoteBranch.branch is NonEmptyStr, and a refinement brand in this corpus is NOT construction-enforced - `as NonEmptyStr` will happily mint an empty one. parse_advertised_ref_line already refuses an empty ref field, so the remaining way to reach an empty branch is an advertisement whose ref_name is exactly the heads prefix and nothing more: advertised_ref_branch_name strips the prefix and returns the empty string, which would then be cast into a type whose whole content is a promise that it is not empty. The consumer downstream compares that branch against the one it asked about, so a silently-empty name matches nothing and the answer becomes `not published` about a branch that is published. Checking before the cast is the only place the class is decidable, since the brand itself does not check."

data degenerate_ref_identity_note: String = "COUNTING THE OFFENDERS THREW AWAY WHICH ONES THEY WERE. This returned an Int, the caller compared it to zero, and the refusal it built could say only that some head ref projected to an empty branch name. The identity was in hand at the moment of the test and discarded before the refusal was constructed, so a reader of the refusal had to re-run the projection over the whole advertisement to learn which ref caused it.\\n\\nRETURNING THE REFS THEMSELVES IS ALSO STRICTLY LESS WORK, which is the tell that the count was never the cheaper choice: the filter already built the offending set and count() then collapsed it. The caller now branches on whether that set is empty, so the same single filter decides the question AND supplies the evidence.\\n\\nTHE SET, NOT THE FIRST OF IT. This module's no_silent_pick_note bans reaching for the head of a list whose length was never established, and an advertisement may in principle carry more than one degenerate ref. Carrying every offender keeps the refusal 0/1/many-honest without adjudicating a uniqueness nobody established, and the arm is constructed only when the set is nonempty."

fn advertised_refs_projecting_empty_branch(refs: List<AdvertisedRef>) -> List<AdvertisedRef> {
  filter(refs, r => advertised_ref_branch_name(ref_name: r.ref_name) == "")
}

data transport_shim_split_note: String = "THE READING IS PURE; ONLY THE CALL IS NOT. remote_branch_observation_of takes exactly the four values git.Core.LsRemoteHeads returns and decides everything from them, so every arm - refused, unparseable line, empty projected branch, read - is reachable in a hermetic witness with no remote and no credentials. observe_remote_branches is then a projection with no branches of its own.\\n\\nThe split exists because the alternative is a function whose refusal arms can only be reached by having a real remote fail in a real way, which is to say never reached in CI and therefore never proven. Keeping the decision above the transport is what makes the evidence executable rather than aspirational."

fn remote_branch_observation_of(
  remote: NonEmptyStr,
  success: Bool,
  exit_code: Int,
  stderr: String,
  advertised: List<String>,
) -> RemoteBranchObservation {
  if !success {
    RemoteBranchesUnreadable {
      cause: RefAdvertisementRefused {
        remote: remote,
        exit_code: exit_code,
        stderr: stderr,
      },
    }
  } else {
    match scan_advertised_refs(lines: advertised) {
      AdvertisedRefLineUnparsed { line, index } =>
        RemoteBranchesUnreadable {
          cause: AdvertisedLineUnparsed {
            remote: remote,
            index: index,
            line: line,
          },
        }
      AdvertisedRefsRead { refs } =>
        let degenerate = advertised_refs_projecting_empty_branch(refs: refs)
        if count(degenerate) > 0 {
          RemoteBranchesUnreadable {
            cause: AdvertisedRefProjectsEmptyBranch {
              remote: remote,
              ref_names: map(degenerate, r => r.ref_name),
            },
          }
        } else {
          RemoteBranchesRead {
            branches: map(refs, r => advertised_ref_to_remote_branch(r: r, remote: remote)),
          }
        }
    }
  }
}

fn observe_remote_branches(remote: NonEmptyStr) -> RemoteBranchObservation {
  let result = git.Core.LsRemoteHeads(remote: remote as String)
  remote_branch_observation_of(
    remote: remote,
    success: result.success,
    exit_code: result.exit_code,
    stderr: result.stderr,
    advertised: result.advertised,
  )
}
