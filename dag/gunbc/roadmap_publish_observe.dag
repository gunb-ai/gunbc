module gunbc.roadmap_publish_observe

import std.types { String, NonEmptyStr, Int, Bool, List, CommitSha }
import std.credentials { CredentialSource }
import extdeps.git
import extdeps.git {
  AdvertisedRef,
  AdvertisedRefScan, AdvertisedRefsRead, AdvertisedRefLineUnparsed,
  scan_advertised_refs,
  advertised_ref_branch_name,
}
import gunbc.roadmap_publish {
  RemoteBranch,
  RemoteBranchObservation, RemoteBranchesRead, RemoteBranchesUnreadable,
  RemoteBranchReadFailure,
  RefAdvertisementRefused, AdvertisedLineUnparsed, AdvertisedRefProjectsEmptyBranch,
  PullRequestObservation, PullRequestsRead, PullRequestsUnreadable,
  PublicationOutcome,
  PublicationSubject,
  publication_subject_remote,
  adjudicate_publication,
}
import extdeps.github.github { Repository, github_https_clone_url }
import extdeps.github.pulls

data observer_role_note: String = "THIS IS THE HALF THAT TOUCHES THE NETWORK, SEPARATED FROM THE HALF THAT JUDGES. gunbc.roadmap_publish adjudicates observations a caller already holds, which is what makes every one of its arms reachable from constructed values in a witness. That property is worth keeping, so the reading lives here instead: this module calls the transport, decides what was learned, and hands back an ordinary value. The split is the reason the refusal arms are constructible at all - a function that called the service itself could not build them, because a transport failure there is not a value.\\n\\nWhat this module must never become is a second adjudicator. It reports what it saw and refuses when it could not see; which outcome that implies is roadmap_publish's business."

data remote_branch_observation_note: String = "THE REFUSAL IS BUILT FROM A VALUE, NOT CAUGHT. git.Core.LsRemoteHeads declares exit_code/stderr as outputs, so a failed ref advertisement arrives as an ordinary record this function can match on. That is not true of every transport in the corpus - the REST dispatch raises on a non-2xx rather than returning one - and the difference is exactly why the remote-branch half of publication can be observed today and the pull-request half cannot.\\n\\nTHE TERMINATION FACT IS THE EXIT CODE, NOT A SUCCESS BOOL. An earlier cut of the operation declared both, and this function branched on the Bool - so a caller could pass a true success beside a nonzero exit code and a failed read would be reported as an ordinary negative result. The Bool is gone from the operation and from this signature, so that pair is unwritable rather than merely discouraged; see ls_remote_reports_termination_not_success_note in extdeps.git for the derivation and the 148-sibling census."

fn advertised_ref_to_remote_branch(r: AdvertisedRef, remote: NonEmptyStr) -> RemoteBranch {
  RemoteBranch {
    remote: remote,
    branch: advertised_ref_branch_name(ref_name: r.ref_name) as NonEmptyStr,
    head_sha: r.object_id,
  }
}

data empty_branch_projection_note: String = "WHY AN EMPTY PROJECTED BRANCH NAME REFUSES INSTEAD OF BEING CAST. RemoteBranch.branch is NonEmptyStr, and a refinement brand in this corpus is NOT construction-enforced - `as NonEmptyStr` will happily mint an empty one. parse_advertised_ref_line already refuses an empty ref field, so the remaining way to reach an empty branch is an advertisement whose ref_name is exactly the heads prefix and nothing more: advertised_ref_branch_name strips the prefix and returns the empty string, which would then be cast into a type whose whole content is a promise that it is not empty. The consumer downstream compares that branch against the one it asked about, so a silently-empty name matches nothing and the answer becomes `not published` about a branch that is published. Checking before the cast is the only place the class is decidable, since the brand itself does not check."

data degenerate_ref_identity_note: String = "COUNTING THE OFFENDERS THREW AWAY WHICH ONES THEY WERE. This returned an Int, the caller compared it to zero, and the refusal it built could say only that some head ref projected to an empty branch name. The identity was in hand at the moment of the test and discarded before the refusal was constructed, so a reader of the refusal had to re-run the projection over the whole advertisement to learn which ref caused it.\\n\\nRETURNING THE REFS THEMSELVES IS ALSO STRICTLY LESS WORK, which is the tell that the count was never the cheaper choice: the filter already built the offending set and count() then collapsed it. The caller now branches on whether that set is empty, so the same single filter decides the question AND supplies the evidence.\\n\\nTHE SET, NOT THE FIRST OF IT. This module's no_silent_pick_note bans reaching for the head of a list whose length was never established, and an advertisement may in principle carry more than one degenerate ref. Carrying every offender keeps the refusal 0/1/many-honest without adjudicating a uniqueness nobody established, and the arm is constructed only when the set is nonempty."

fn advertised_refs_projecting_empty_branch(refs: List<AdvertisedRef>) -> List<AdvertisedRef> {
  filter(refs, r => advertised_ref_branch_name(ref_name: r.ref_name) == "")
}

data transport_shim_split_note: String = "THE READING IS PURE; ONLY THE CALL IS NOT. remote_branch_observation_of takes exactly the three values git.Core.LsRemoteHeads returns and decides everything from them, so every arm - refused, unparseable line, empty projected branch, read - is reachable in a hermetic witness with no remote and no credentials. observe_remote_branches is then a projection with no branches of its own.\\n\\nThe split exists because the alternative is a function whose refusal arms can only be reached by having a real remote fail in a real way, which is to say never reached in CI and therefore never proven. Keeping the decision above the transport is what makes the evidence executable rather than aspirational."

fn remote_branch_observation_of(
  remote: NonEmptyStr,
  exit_code: Int,
  stderr: String,
  advertised: List<String>,
) -> RemoteBranchObservation {
  if exit_code != 0 {
    RemoteBranchesUnreadable {
      cause: RefAdvertisementRefused {
        remote: remote,
        exit_code: exit_code,
        stderr: stderr,
      },
    }
  } else {
    match scan_advertised_refs(lines: advertised) {
      AdvertisedRefLineUnparsed { line, index } =>
        RemoteBranchesUnreadable {
          cause: AdvertisedLineUnparsed {
            remote: remote,
            index: index,
            line: line,
          },
        }
      AdvertisedRefsRead { refs } =>
        let degenerate = advertised_refs_projecting_empty_branch(refs: refs)
        if count(degenerate) > 0 {
          RemoteBranchesUnreadable {
            cause: AdvertisedRefProjectsEmptyBranch {
              remote: remote,
              ref_names: map(degenerate, r => r.ref_name),
            },
          }
        } else {
          RemoteBranchesRead {
            branches: map(refs, r => advertised_ref_to_remote_branch(r: r, remote: remote)),
          }
        }
    }
  }
}

fn observe_remote_branches(remote: NonEmptyStr) -> RemoteBranchObservation {
  let result = git.Core.LsRemoteHeads(remote: remote as String)
  remote_branch_observation_of(
    remote: remote,
    exit_code: result.exit_code,
    stderr: result.stderr,
    advertised: result.advertised,
  )
}

data pull_observation_transport_bound_note: String = "THE FAILURE PATH IS CLOSED ON THE SIDE THAT IS DECIDABLE HERE AND OPEN ON THE SIDE THAT IS NOT, and the boundary between them is stated rather than blurred.\\n\\nCLOSED: NO CREDENTIAL. A publication read without a usable token is not a failed read, it is a read that must not be attempted. Sending an empty bearer token produces a 401 whose only content is that we sent nothing, so calling in order to discover what we already know converts a decidable local fact into a transport failure - and the REST path turns transport failures into raises, so the decidable fact would arrive as the least tractable kind of event. PublicationCredential makes the fact a value before the call, and the arm is reachable in a hermetic witness by construction. This is the failure mode a fresh host actually hits.\\n\\nOPEN: NON-2XX FROM A REAL CALL. github.Pulls.List declares 200/401/404/422/5xx, and the realization honours only 200. dispatch_rest in the v1 seed returns Err(InterpError::TypeError) for any status at or above 400, so control never returns to this function and PullRequestsUnreadable cannot be constructed from a failed call - only by a caller that already holds one. That is a REALIZATION gap, not a modeling gap: the response table is declared and the handler ignores it.\\n\\nWHY IT IS NOT CLOSED HERE. Two moves would close it and both are worse than the gap. Realizing the response table is a v1 seed change, which is the direction the seed is supposed to shrink in and does not belong inside a publication slice. Reading pull requests through a second operation whose failure IS a value - a gh CLI shell op beside the REST op - forks one dependency operation once per transport, which is the exact N-transport fork DESIGN 3 names; the corpus has no gh model today and this lane must not be the reason it gains a forked one.\\n\\nSo the residual is one class, named: a non-2xx pull-request read raises instead of refusing. Dissolve-on: the REST response-table realization, after which observe_pull_requests matches the declared statuses and this note's OPEN half deletes.\\n\\nWhy the arm still exists in the type: a caller CAN hold a refusal - an absent credential, a prior read that failed, a cached observation, a receipt decoded from disk - and the adjudicator must answer it. Deleting the arm because one producer cannot reach it through one transport would push the ignorance-as-answer conflation back into every other producer."

type PublicationCredential
  = PublicationCredentialPresent { source: CredentialSource }
  | PublicationCredentialAbsent { reason: String }

fn observe_pull_requests(
  credential: PublicationCredential,
  repo: Repository,
) -> PullRequestObservation {
  match credential {
    PublicationCredentialAbsent { reason } =>
      PullRequestsUnreadable {
        detail: join([
          "the pull requests of ",
          repo.full_name,
          " were not read because no usable credential was available: ",
          reason,
        ], ""),
      }
    PublicationCredentialPresent { source } => {
      let result = github.Pulls.List(
        auth_token: source,
        owner: repo.owner,
        repo: repo.name,
      )
      PullRequestsRead { pulls: result.pulls }
    }
  }
}

data repository_bound_observation_note: String = "BOTH READS NAME THE SAME REPOSITORY BY CONSTRUCTION, WHICH IS THE WHOLE REASON THIS FUNCTION EXISTS RATHER THAN TWO CALLS AT A CALL SITE. The remote is projected from the same Repository that supplies owner and name to the pull-request read, so there is no arrangement of arguments in which the ref advertisement and the pull request list describe different repositories.\\n\\nThe alternative that this deliberately forecloses is reading refs from the local alias `origin` while reading pull requests from an owner/name pair. Those two reads are only COINCIDENTALLY about one repository: `origin` is a fact about one checkout's configuration, and a checkout whose origin points elsewhere would produce a publication judgment that looks entirely ordinary and is about the wrong subject. Nothing in either result would reveal it. See repository_remote_url_note in extdeps.github.github for the projection and its citation.\\n\\nIT TAKES THE SUBJECT, NOT FOUR LOOSE FIELDS. The four arguments this function used to take are exactly four of PublicationSubject's six, so a caller could observe against one repository and one head while writing a receipt whose subject named others - and both values would look entirely ordinary. Taking the subject makes the observation and the receipt provably about the same question, because there is only one value.\\n\\nThis function calls the transport and adjudicates in one breath, which the observer note above otherwise warns against - so the boundary is stated: it performs no judgment of its own. It reads, and hands both observations to adjudicate_publication unchanged. Every arm of the result is decided there, over values, and remains reachable in a hermetic witness through that function directly."

fn observe_publication_for_subject(
  credential: PublicationCredential,
  subject: PublicationSubject,
) -> PublicationOutcome {
  let remote = publication_subject_remote(subject: subject)
  adjudicate_publication(
    pulls: observe_pull_requests(
      credential: credential,
      repo: subject.repository,
    ),
    remotes: observe_remote_branches(remote: remote),
    remote: remote,
    branch: subject.branch,
    expected_base: subject.expected_base,
    expected_head: subject.expected_head,
  )
}

data gunbc_repository_single_authority_note: String = "ONE VALUE FOR THE REPOSITORY THIS PROJECT LIVES IN, because there were already three spellings of it and this lane would have made a fourth. gunbc.runner_host_deploy carries `org: gunb-ai`, gunbc.tools.review defaults a parameter to `owner: gunb-ai`, and gunbc.tools.review_codex declares `owner` and `repo` as separate data rows. Each is correct today and each can drift alone; none of them is a Repository, so none can be handed to github.Pulls.List or projected to a clone URL without re-pairing the two halves by hand.\\n\\nWHAT THIS DOES AND DOES NOT CLAIM: it is the authority for THIS lane, and the three sites above are not migrated here - that is a separate change touching deploy and review tooling, and folding it into a publication slice would bury it. What it does prevent is the publication lane adding a fourth. Dissolve-on: the three existing sites consume this value and their local spellings delete."

fn gunbc_repository() -> Repository {
  Repository {
    owner: "gunb-ai",
    name: "gunbc",
    full_name: "gunb-ai/gunbc",
    private: false,
    default_branch: "main",
  }
}
