module gunbc.roadmap_acceptance_history_observation



data roadmap_acceptance_history_authority_repo_path: String = "dag/gunbc/roadmap_authority.dag"

data roadmap_acceptance_history_prior_history_next_rung_trigger: String = "DISSOLVED: merge-base prior_history parses dag/gunbc/roadmap_acceptance_event_history.jsonl via gunbc.roadmap_acceptance_history_carrier when the carrier exists at merge-base; when absent (carrier introduction on main) the typed bootstrap projects inline authority history via gunbc.roadmap_acceptance_history_projection. A changed carrier without a valid merge-base observation refuses AcceptanceHistoryIntegrityRefusedPriorHistoryObservation — never prior_history = []. git_show_path_absent_at_ref substring-matches both git stderr shapes for path absent at ref (tree miss: does not exist in; worktree-present-but-not-in-commit: exists on disk, but not in) until extdeps.git carries a typed path-absent-at-ref disposition. Remaining dissolve-on: delete both seed bridges when a modeled revision-addressed carrier ingest lands."

type RoadmapAcceptanceHistoryPriorObservation
  = PriorHistoryObserved { prior: List<gunbc.roadmap_model.RoadmapAcceptanceEvent> }
  | PriorHistoryGitObservationRefused { detail: String }

fn git_refusal_detail(operation: String, stderr: String) -> String {
  let detail = trim(stderr)
  if detail == "" {
    concat(operation, " refused without stderr")
  } else {
    concat(operation, concat(": ", detail))
  }
}

fn git_show_path_absent_at_ref(stderr: String) -> Bool {
  let trimmed = trim(stderr)
  string_contains(s: trimmed, pattern: "does not exist in")
    || string_contains(s: trimmed, pattern: "exists on disk, but not in")
}

fn prior_history_from_carrier_text(carrier_text: String) -> RoadmapAcceptanceHistoryPriorObservation {
  match parse_roadmap_acceptance_event_history_carrier(text: carrier_text) {
    RoadmapAcceptanceEventHistoryParsed { events: events } =>
      PriorHistoryObserved { prior: events }
    RoadmapAcceptanceEventHistoryParseRefused { detail: detail } =>
      PriorHistoryGitObservationRefused {
        detail: concat("merge-base carrier parse refused: ", detail),
      }
  }
}

fn prior_history_from_authority_text(authority_text: String) -> RoadmapAcceptanceHistoryPriorObservation {
  match project_roadmap_acceptance_event_history_from_authority_text(authority_text: authority_text) {
    RoadmapAcceptanceHistoryProjected { events: events } =>
      PriorHistoryObserved { prior: events }
    RoadmapAcceptanceHistoryProjectionRefused { detail: detail } =>
      PriorHistoryGitObservationRefused {
        detail: concat("merge-base authority projection refused: ", detail),
      }
  }
}

fn prior_history_from_merge_base_carrier_or_authority_bootstrap(
  authority_repo_path: String,
  baseline_sha: String,
  carrier_stderr: String,
) -> RoadmapAcceptanceHistoryPriorObservation {
  let base_authority = git.Core.Show(
    ref: baseline_sha as std.types.GitRef,
    path: authority_repo_path,
    expect: ExpectSuccess,
  )
  if !base_authority.success {
    PriorHistoryGitObservationRefused {
      detail: git_refusal_detail(
        operation: "git.Core.Show(merge-base carrier and authority)",
        stderr: concat(carrier_stderr, concat("; ", base_authority.stderr)),
      ),
    }
  } else {
    prior_history_from_authority_text(authority_text: base_authority.content)
  }
}

fn observe_roadmap_acceptance_history_prior(
  current_history: List<gunbc.roadmap_model.RoadmapAcceptanceEvent>,
  carrier_repo_path: String,
  authority_repo_path: String,
  base_ref: String,
) -> RoadmapAcceptanceHistoryPriorObservation {
  let head = git.Inspect.HeadCommit(expect: ExpectSuccess)
  if !head.success || (head.sha as String) == "" {
    PriorHistoryGitObservationRefused {
      detail: "git.Inspect.HeadCommit refused or returned an empty revision",
    }
  } else {
    let revision = head.sha as String
    let baseline = git.Inspect.MergeBase(
      left: revision as std.types.GitRef,
      right: base_ref as std.types.GitRef,
      expect: ExpectSuccess,
    )
    if !baseline.success || (baseline.sha as String) == "" {
      PriorHistoryGitObservationRefused {
        detail: git_refusal_detail(operation: "git.Inspect.MergeBase", stderr: baseline.stderr),
      }
    } else {
      let head_manifest = git.Core.Show(
        ref: revision as std.types.GitRef,
        path: carrier_repo_path,
        expect: ExpectSuccess,
      )
      if !head_manifest.success {
        PriorHistoryGitObservationRefused {
          detail: git_refusal_detail(operation: "git.Core.Show(HEAD carrier)", stderr: head_manifest.stderr),
        }
      } else {
        let base_manifest = git.Core.Show(
          ref: baseline.sha as std.types.GitRef,
          path: carrier_repo_path,
          expect: ExpectSuccess,
        )
        if !base_manifest.success {
          if git_show_path_absent_at_ref(stderr: base_manifest.stderr) {
            prior_history_from_merge_base_carrier_or_authority_bootstrap(
              authority_repo_path: authority_repo_path,
              baseline_sha: baseline.sha as String,
              carrier_stderr: base_manifest.stderr,
            )
          } else {
            PriorHistoryGitObservationRefused {
              detail: git_refusal_detail(
                operation: "git.Core.Show(merge-base carrier)",
                stderr: base_manifest.stderr,
              ),
            }
          }
        } else {
          let head_identity = content_hash_atom(value: head_manifest.content)
          let base_identity = content_hash_atom(value: base_manifest.content)
          if content_hash_eq_structural(left: head_identity, right: base_identity) {
            prior_history_from_carrier_text(carrier_text: head_manifest.content)
          } else {
            prior_history_from_carrier_text(carrier_text: base_manifest.content)
          }
        }
      }
    }
  }
}

// A function, not top-level data, so importing this module cannot reach git.Inspect.HeadCommit by import alone (gunbc.stage0_rust_host_observation host_observation_invocation_note). When HEAD and merge-base carrier identities match, prior_history is parsed from git.Core.Show(HEAD carrier) — not the working-tree load — so uncommitted local carrier edits refuse against the committed prior rather than self-matching.
fn current_roadmap_acceptance_history_prior_observation(
  current_history: List<gunbc.roadmap_model.RoadmapAcceptanceEvent>,
) -> RoadmapAcceptanceHistoryPriorObservation {
  observe_roadmap_acceptance_history_prior(
    current_history: current_history,
    carrier_repo_path: roadmap_acceptance_event_history_carrier_repo_path,
    authority_repo_path: roadmap_acceptance_history_authority_repo_path,
    base_ref: gunbc_merge_target_ref as String,
  )
}

fn acceptance_history_integrity_verdict_from_prior_observation(
  observation: RoadmapAcceptanceHistoryPriorObservation,
  history: List<gunbc.roadmap_model.RoadmapAcceptanceEvent>,
) -> gunbc.roadmap_model.AcceptanceHistoryIntegrityVerdict {
  match observation {
    PriorHistoryGitObservationRefused { detail: detail } =>
      AcceptanceHistoryIntegrityRefusedPriorHistoryObservation { detail: detail }
    PriorHistoryObserved { prior: prior } =>
      acceptance_history_integrity_verdict(
        history: history,
        prior_history: prior,
      )
  }
}

fn acceptance_history_integrity_holds_from_prior_observation_with_prior(
  observation: RoadmapAcceptanceHistoryPriorObservation,
  history: List<gunbc.roadmap_model.RoadmapAcceptanceEvent>,
) -> Bool {
  match acceptance_history_integrity_verdict_from_prior_observation(
    observation: observation,
    history: history,
  ) {
    AcceptanceHistoryIntegrityHolds => true
    AcceptanceHistoryIntegrityRefusedReplay => false
    AcceptanceHistoryIntegrityRefusedVanishedWithoutRevocation { receipt: _ } => false
    AcceptanceHistoryIntegrityRefusedPriorPrefix { index: _ } => false
    AcceptanceHistoryIntegrityRefusedPriorHistoryObservation { detail: _ } => false
  }
}

data roadmap_acceptance_history_observation_bootstrap_compat_note: String = "SCAFFOLD (carrier-introduction window only): merge-base authority overlay still imports the sealed-prefix observation entry points deleted on HEAD. Bootstrap projection compiles that overlay against HEAD's transitive closure solely to evaluate roadmap_acceptance_event_history(); these compat rows satisfy the import surface and ignore sealed_event_count/sealed_chain_digest — prefix law is enforced by acceptance_history_integrity_verdict on observed prior, not the retired seal columns. Dissolve-on: modeled revision-addressed carrier ingest deletes the projection seed and these compat rows together."

fn acceptance_history_integrity_holds_from_prior_observation(
  observation: RoadmapAcceptanceHistoryPriorObservation,
  history: List<gunbc.roadmap_model.RoadmapAcceptanceEvent>,
  sealed_event_count: Int,
  sealed_chain_digest: std.content_hash.Fnv1a64Structural,
) -> Bool {
  let _ = sealed_event_count
  let _ = sealed_chain_digest
  acceptance_history_integrity_holds_from_prior_observation_with_prior(
    observation: observation,
    history: history,
  )
}
