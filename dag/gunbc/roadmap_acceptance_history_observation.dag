module gunbc.roadmap_acceptance_history_observation

import extdeps.git.inspect
import extdeps.git
import gunbc.output_policy { ExpectSuccess }
import gunbc.repo_identity { gunbc_merge_target_ref }
import gunbc.roadmap_model {
  RoadmapAcceptanceEvent,
  AcceptanceHistoryIntegrityVerdict,
  AcceptanceHistoryIntegrityHolds,
  AcceptanceHistoryIntegrityRefusedReplay,
  AcceptanceHistoryIntegrityRefusedVanishedWithoutRevocation,
  AcceptanceHistoryIntegrityRefusedSealedPrefixDigest,
  AcceptanceHistoryIntegrityRefusedPriorPrefix,
  AcceptanceHistoryIntegrityRefusedPriorHistoryObservation,
  acceptance_history_integrity_verdict,
}
import std.content_hash { Fnv1a64Structural, content_hash_atom, content_hash_eq_structural }
import std.types { CommitSha, GitRef, String }
import v2.std.collection { List }

data roadmap_acceptance_history_authority_repo_path: String = "dag/gunbc/roadmap_authority.dag"

data roadmap_acceptance_history_prior_history_next_rung_trigger: String = "NEXT RUNG: evaluate roadmap_acceptance_event_history at the merge-base revision (git.Inspect.MergeBase between HEAD and gunbc_merge_target_ref, then project the authority module at that revision) so prior_history is the observed base-side event list. Until that substrate exists, this module compares revision-addressed authority file content identity only: an unchanged file at merge-base admits prior_history = current; a changed file without revision evaluation returns PriorHistoryRevisionEvaluationRequired and the live integrity path keeps prior_history empty so acceptance_history_extends_prior does not execute on production yet. PriorHistoryGitObservationRefused is a typed refusal on the integrity verdict (AcceptanceHistoryIntegrityRefusedPriorHistoryObservation) — never fabricated prior_history. Witness tests continue to supply non-empty prior_history fixtures for the deletion arms."

type RoadmapAcceptanceHistoryPriorObservation
  = PriorHistoryObserved { prior: List<RoadmapAcceptanceEvent> }
  | PriorHistoryRevisionEvaluationRequired { detail: String }
  | PriorHistoryGitObservationRefused { detail: String }

fn git_refusal_detail(operation: String, stderr: String) -> String {
  let detail = trim(stderr)
  if detail == "" {
    concat(operation, " refused without stderr")
  } else {
    concat(operation, concat(": ", detail))
  }
}

fn observe_roadmap_acceptance_history_prior(
  current_history: List<RoadmapAcceptanceEvent>,
  authority_repo_path: String,
  base_ref: String,
) -> RoadmapAcceptanceHistoryPriorObservation {
  let head = git.Inspect.HeadCommit(expect: ExpectSuccess)
  if !head.success || (head.sha as String) == "" {
    PriorHistoryGitObservationRefused {
      detail: "git.Inspect.HeadCommit refused or returned an empty revision",
    }
  } else {
    let revision = head.sha as String
    let baseline = git.Inspect.MergeBase(
      left: revision as GitRef,
      right: base_ref as GitRef,
      expect: ExpectSuccess,
    )
    if !baseline.success || (baseline.sha as String) == "" {
      PriorHistoryGitObservationRefused {
        detail: git_refusal_detail(operation: "git.Inspect.MergeBase", stderr: baseline.stderr),
      }
    } else {
      let head_manifest = git.Core.Show(
        ref: revision as GitRef,
        path: authority_repo_path,
        expect: ExpectSuccess,
      )
      if !head_manifest.success {
        PriorHistoryGitObservationRefused {
          detail: git_refusal_detail(operation: "git.Core.Show(HEAD authority)", stderr: head_manifest.stderr),
        }
      } else {
        let base_manifest = git.Core.Show(
          ref: baseline.sha as GitRef,
          path: authority_repo_path,
          expect: ExpectSuccess,
        )
        if !base_manifest.success {
          PriorHistoryGitObservationRefused {
            detail: git_refusal_detail(
              operation: "git.Core.Show(merge-base authority)",
              stderr: base_manifest.stderr,
            ),
          }
        } else {
          let head_identity = content_hash_atom(value: head_manifest.content)
          let base_identity = content_hash_atom(value: base_manifest.content)
          if content_hash_eq_structural(left: head_identity, right: base_identity) {
            PriorHistoryObserved { prior: current_history }
          } else {
            PriorHistoryRevisionEvaluationRequired {
              detail: concat(
                "authority file changed between merge-base ",
                concat(baseline.sha as String, concat(" and HEAD ", revision)),
              ),
            }
          }
        }
      }
    }
  }
}

data roadmap_acceptance_history_observation_invocation_note: String = "A function, not top-level data, so importing this module cannot reach git.Inspect.HeadCommit by import alone (gunbc.stage0_rust_host_observation host_observation_invocation_note)."

fn current_roadmap_acceptance_history_prior_observation(
  current_history: List<RoadmapAcceptanceEvent>,
) -> RoadmapAcceptanceHistoryPriorObservation {
  observe_roadmap_acceptance_history_prior(
    current_history: current_history,
    authority_repo_path: roadmap_acceptance_history_authority_repo_path,
    base_ref: gunbc_merge_target_ref as String,
  )
}

fn acceptance_history_integrity_verdict_from_prior_observation(
  observation: RoadmapAcceptanceHistoryPriorObservation,
  history: List<RoadmapAcceptanceEvent>,
  sealed_event_count: Int,
  sealed_chain_digest: Fnv1a64Structural,
) -> AcceptanceHistoryIntegrityVerdict {
  match observation {
    PriorHistoryGitObservationRefused { detail: detail } =>
      AcceptanceHistoryIntegrityRefusedPriorHistoryObservation { detail: detail }
    PriorHistoryRevisionEvaluationRequired { detail: _ } =>
      acceptance_history_integrity_verdict(
        history: history,
        sealed_event_count: sealed_event_count,
        sealed_chain_digest: sealed_chain_digest,
        prior_history: [],
      )
    PriorHistoryObserved { prior: prior } =>
      acceptance_history_integrity_verdict(
        history: history,
        sealed_event_count: sealed_event_count,
        sealed_chain_digest: sealed_chain_digest,
        prior_history: prior,
      )
  }
}

fn acceptance_history_integrity_holds_from_prior_observation(
  observation: RoadmapAcceptanceHistoryPriorObservation,
  history: List<RoadmapAcceptanceEvent>,
  sealed_event_count: Int,
  sealed_chain_digest: Fnv1a64Structural,
) -> Bool {
  match acceptance_history_integrity_verdict_from_prior_observation(
    observation: observation,
    history: history,
    sealed_event_count: sealed_event_count,
    sealed_chain_digest: sealed_chain_digest,
  ) {
    AcceptanceHistoryIntegrityHolds => true
    AcceptanceHistoryIntegrityRefusedReplay => false
    AcceptanceHistoryIntegrityRefusedVanishedWithoutRevocation { receipt: _ } => false
    AcceptanceHistoryIntegrityRefusedSealedPrefixDigest => false
    AcceptanceHistoryIntegrityRefusedPriorPrefix => false
    AcceptanceHistoryIntegrityRefusedPriorHistoryObservation { detail: _ } => false
  }
}
