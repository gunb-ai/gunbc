module gunbc.falsifier_lane

import std.types { String, NonEmptyStr, Bool, List, list_length }
import std.nat { Nat }
import gunbc.floor_component_receipt {
  FloorComponentRow,
  floor_component_row_index,
  floor_component_row_is_done,
  floor_component_row_of
}
import std.realization_schedule { SelectionApplied }
import std.observation { Done, Failed }
import std.measure { millisecond }

data falsifier_lane_note: String = "The falsifier's per-component LANE identity, and the two things derived from it: a totality receipt (did every planned component report?) and a routing verdict (which lane owns a failing component?). WHY IT EXISTS, priced: gunbc.floor_component_receipt made the alert read per-component state instead of inferring one causal story from the overall conclusion, but it left the component ANONYMOUS. The label the seed stamps on a discovery batch is generated from the runnable's shape — claim_executor formats 'discovery-corpus[N root(s)+M explicit, adaptive width]' — so two lanes with the same root/entry arithmetic are indistinguishable in the receipt, and no label names the roster that failed. Triage therefore still ends at 'a batch was red', which is the same blindness one level down. THE FIX IS ATTRIBUTION, NOT A SECOND LABEL: the plan already knows which lane each batch is, because each batch is built by a named function over a named roster; that fact is simply discarded when the schedule flattens to List<List<Runnable>>. This module carries the lane vocabulary and the enrollment-ordered projection, and ci_floor_plan derives BOTH the batch schedule and the planned-component roster from one enrollment list — so an added lane cannot appear in the schedule without appearing in the attribution (DESIGN section 3: one authority, no fork to drift)."

data falsifier_lane_index_join_note: String = "The join key is the 1-based batch INDEX, and that is not in tension with floor_component_receipt_role_note's rule against keying on indices. That rule forbids treating an index as a STABLE NAME across runs — 'batch 4 is the silent-pick gate' relocates a hardcoded assumption, because gunbc_falsifier_ordinary_batches composes conditionally on enrollment flags and one flip shifts every later index. Here the index is used only WITHIN ONE RUN, to join a receipt against the very plan that produced it: both sides are projections of the same enrollment state, evaluated for the same run, so the correspondence is exact by construction rather than assumed. What crosses runs is the LANE, which is a name and stays one. The index is the join; the lane is the identity."

data falsifier_lane_receipt_wiring_dissolve_on: String = "dissolve-on: the falsifier receipt document carries these blocks. Today the seed calls gunbc.floor_component_receipt floor_component_receipt_document_with_selection with rows only, and that function is SHARED with the per-PR floor, which has no lane roster — so adding a lane block there unconditionally would fabricate lane identity for components that have none. Wiring is therefore a falsifier-specific document entry point taking the planned roster alongside the rows, and one added seed call site beside write_floor_component_receipt_at; at that point .github/workflows/falsifier-alert.yml reads routed_components instead of rendering the anonymous label, and this row deletes. Until then the algebra here is proven by execution on fixtures and the plan-agreement wall below runs against the live plan — the attribution is derived and witnessed, and what remains unbuilt is its transport into the JSON, named rather than silent (DESIGN section 4b, no untracked stall)."

type FalsifierLane
  = LanePredictOnly
  | LaneSelfHostWet
  | LaneSelfHostWetKnownRed
  | LaneKnownRedProbe
  | LaneSilentPickGate
  | LaneRehomedBinWet
  | LaneSubstrateLongLane
  | LaneCadenceWitness
  | LaneGates

fn falsifier_lane_name(l: FalsifierLane) -> String {
  match l {
    LanePredictOnly => "predict_only"
    LaneSelfHostWet => "self_host_wet"
    LaneSelfHostWetKnownRed => "self_host_wet_known_red"
    LaneKnownRedProbe => "known_red_probe"
    LaneSilentPickGate => "silent_pick_gate"
    LaneRehomedBinWet => "rehomed_bin_wet"
    LaneSubstrateLongLane => "substrate_long_lane"
    LaneCadenceWitness => "cadence_witness"
    LaneGates => "gates"
  }
}

fn falsifier_lane_eq(left: FalsifierLane, right: FalsifierLane) -> Bool {
  falsifier_lane_name(l: left) == falsifier_lane_name(l: right)
}

type FalsifierLaneEnrollment {
  lane: FalsifierLane
  enrolled: Bool
}

type FalsifierPlannedComponent {
  index: Nat
  lane: FalsifierLane
}

fn falsifier_planned_components(enrollments: List<FalsifierLaneEnrollment>) -> List<FalsifierPlannedComponent> {
  fold(enrollments, init: [], f: fn(acc, e) {
    if e.enrolled {
      concat(acc, [FalsifierPlannedComponent { index: list_length(items: acc) + 1, lane: e.lane }])
    } else {
      acc
    }
  })
}

fn falsifier_planned_indices(planned: List<FalsifierPlannedComponent>) -> List<Nat> {
  planned |> map(p => p.index)
}

fn falsifier_reported_indices(rows: List<FloorComponentRow>) -> List<Nat> {
  rows |> map(r => floor_component_row_index(row: r))
}

fn index_occurrence_count(xs: List<Nat>, target: Nat) -> Nat {
  fold(xs, init: 0, f: fn(acc, x) { if x == target { acc + 1 } else { acc } })
}

fn list_contains_index(xs: List<Nat>, target: Nat) -> Bool {
  index_occurrence_count(xs: xs, target: target) > 0
}

fn duplicated_indices(xs: List<Nat>) -> List<Nat> {
  fold(xs, init: [], f: fn(acc, x) {
    if (index_occurrence_count(xs: xs, target: x) > 1) && !list_contains_index(xs: acc, target: x) {
      concat(acc, [x])
    } else {
      acc
    }
  })
}

data falsifier_totality_axes_note: String = "Three defect axes, each an exact index SET and each required to be explicitly empty — never a count equality between planned and reported (DESIGN section 5: completeness is an identity join, and count(planned) == count(reported) is satisfied by one missing component alongside one surplus one). MISSING is the axis the receipt cannot currently express on its own: the seed pads batches the stop policy never reached with an explicit not_reached Skipped row, so a gap in the reported set is not an unreached batch — it is the executor and the plan disagreeing about what the run consisted of, which is precisely the state no existing check can see. SURPLUS is its mirror. DUPLICATE catches two rows claiming one component, which would make routing ambiguous rather than merely incomplete. PlanEmpty fails closed rather than reporting a vacuous total: the falsifier always plans at least the predict-only sweep, so an empty planned roster means the projection did not run, not that there was nothing to run."

type FalsifierTotalityVerdict
  = FalsifierTotal { component_count: Nat }
  | FalsifierMissingComponents { missing_indices: List<Nat> }
  | FalsifierSurplusComponents { surplus_indices: List<Nat> }
  | FalsifierDuplicateComponents { duplicated_indices: List<Nat> }
  | FalsifierPlanEmpty { cause: NonEmptyStr }

fn falsifier_totality_verdict_from(
  planned: List<FalsifierPlannedComponent>,
  rows: List<FloorComponentRow>
) -> FalsifierTotalityVerdict {
  let planned_ix = falsifier_planned_indices(planned: planned)
  let reported_ix = falsifier_reported_indices(rows: rows)
  if list_length(items: planned_ix) == 0 {
    FalsifierPlanEmpty {
      cause: "no planned falsifier components — the lane projection did not run, and a vacuous total would report that as success" as NonEmptyStr
    }
  } else {
    let missing = filter(xs: planned_ix, f: fn(i) { !list_contains_index(xs: reported_ix, target: i) })
    let surplus = filter(xs: reported_ix, f: fn(i) { !list_contains_index(xs: planned_ix, target: i) })
    let duplicated = duplicated_indices(xs: reported_ix)
    if list_length(items: missing) > 0 {
      FalsifierMissingComponents { missing_indices: missing }
    } else if list_length(items: surplus) > 0 {
      FalsifierSurplusComponents { surplus_indices: surplus }
    } else if list_length(items: duplicated) > 0 {
      FalsifierDuplicateComponents { duplicated_indices: duplicated }
    } else {
      FalsifierTotal { component_count: list_length(items: planned_ix) }
    }
  }
}

fn falsifier_totality_is_total(v: FalsifierTotalityVerdict) -> Bool {
  match v {
    FalsifierTotal { component_count: n } => true
    FalsifierMissingComponents { missing_indices: xs } => false
    FalsifierSurplusComponents { surplus_indices: xs } => false
    FalsifierDuplicateComponents { duplicated_indices: xs } => false
    FalsifierPlanEmpty { cause: c } => false
  }
}

data falsifier_routing_note: String = "Routing REFUSES rather than defaulting. An unattributable component yields RoutingRefused with its index and cause; there is no catch-all lane and no 'general' owner, because a default owner is the absorbing fallback DESIGN section 5 forbids in its cheapest disguise — every alert would route somewhere, the misroute frequency would be zero by construction, and the missing attribution would never rank for fixing. A refusal is counted and located, so a lane that stops being attributable surfaces as a diagnostic instead of as someone else's pager."

type FalsifierRouting
  = RoutedToLane { index: Nat, lane: FalsifierLane }
  | RoutingRefused { index: Nat, cause: NonEmptyStr }

fn falsifier_lane_of_index(planned: List<FalsifierPlannedComponent>, index: Nat) -> FalsifierLane? {
  fold(planned, init: none, f: fn(acc, p) {
    match acc {
      Present { value: l } => Present { value: l }
      Absent => if p.index == index { Present { value: p.lane } } else { none }
    }
  })
}

fn falsifier_route_row(
  planned: List<FalsifierPlannedComponent>,
  row: FloorComponentRow
) -> FalsifierRouting {
  let ix = floor_component_row_index(row: row)
  match falsifier_lane_of_index(planned: planned, index: ix) {
    Present { value: l } => RoutedToLane { index: ix, lane: l }
    Absent => RoutingRefused {
      index: ix,
      cause: "component index is not in the planned falsifier lane roster — no owning lane, and no default owner exists" as NonEmptyStr
    }
  }
}

fn falsifier_unsuccessful_routings(
  planned: List<FalsifierPlannedComponent>,
  rows: List<FloorComponentRow>
) -> List<FalsifierRouting> {
  rows
    |> filter(r => !floor_component_row_is_done(row: r))
    |> map(r => falsifier_route_row(planned: planned, row: r))
}

fn falsifier_routing_is_routed(r: FalsifierRouting) -> Bool {
  match r {
    RoutedToLane { index: i, lane: l } => true
    RoutingRefused { index: i, cause: c } => false
  }
}

fn falsifier_all_routed(rs: List<FalsifierRouting>) -> Bool {
  fold(rs, init: true, f: fn(acc, r) { acc && falsifier_routing_is_routed(r: r) })
}

data falsifier_lane_witness_note: String = "Witness functions live in the carrier and are imported by dag/test/claim/falsifier_lane_witness_test.dag, the same shape tools.dag_compile_clean_shard_totality uses. Every red control is SYNTHETIC — hand-built planned rosters and fixture component rows — so each defect axis is exercised by a discriminating input that goes red when the algebra is wrong, never by waiting for a real cadence run to misbehave (DESIGN section 5: green by execution plus a discriminating red). The fixture rows are built through floor_component_row_of, the receipt's own constructor, so a change to the row shape breaks these witnesses rather than letting them drift onto a private copy."

fn falsifier_witness_row(index: Nat, done: Bool) -> FloorComponentRow {
  floor_component_row_of(
    run_id: "witness" as NonEmptyStr,
    index: index,
    label: "discovery-corpus[2 root(s)+0 explicit, adaptive width]" as NonEmptyStr,
    selection: SelectionApplied,
    witnesses: 0,
    outcome: if done { Done } else { Failed { error: "synthetic red" as NonEmptyStr, output: "" } },
    wall: millisecond(count: 0)
  )
}

fn falsifier_witness_planned_three() -> List<FalsifierPlannedComponent> {
  falsifier_planned_components(enrollments: [
    FalsifierLaneEnrollment { lane: LanePredictOnly, enrolled: true },
    FalsifierLaneEnrollment { lane: LaneKnownRedProbe, enrolled: true },
    FalsifierLaneEnrollment { lane: LaneSilentPickGate, enrolled: true }
  ])
}

fn witness_planned_components_skip_unenrolled_and_renumber() -> Bool {
  let planned = falsifier_planned_components(enrollments: [
    FalsifierLaneEnrollment { lane: LanePredictOnly, enrolled: true },
    FalsifierLaneEnrollment { lane: LaneSelfHostWet, enrolled: false },
    FalsifierLaneEnrollment { lane: LaneKnownRedProbe, enrolled: true }
  ])
  (list_length(items: planned) == 2)
    && match falsifier_lane_of_index(planned: planned, index: 1) {
         Present { value: l } => falsifier_lane_eq(left: l, right: LanePredictOnly)
         Absent => false
       }
    && match falsifier_lane_of_index(planned: planned, index: 2) {
         Present { value: l } => falsifier_lane_eq(left: l, right: LaneKnownRedProbe)
         Absent => false
       }
}

fn witness_totality_green_on_matching_plan() -> Bool {
  let verdict = falsifier_totality_verdict_from(
    planned: falsifier_witness_planned_three(),
    rows: [
      falsifier_witness_row(index: 1, done: true),
      falsifier_witness_row(index: 2, done: true),
      falsifier_witness_row(index: 3, done: true)
    ]
  )
  match verdict {
    FalsifierTotal { component_count: n } => n == 3
    _ => false
  }
}

fn witness_totality_reds_on_missing_component() -> Bool {
  let verdict = falsifier_totality_verdict_from(
    planned: falsifier_witness_planned_three(),
    rows: [
      falsifier_witness_row(index: 1, done: true),
      falsifier_witness_row(index: 2, done: true)
    ]
  )
  match verdict {
    FalsifierMissingComponents { missing_indices: xs } =>
      (list_length(items: xs) == 1) && (xs.first() == 3)
    _ => false
  }
}

fn witness_totality_reds_on_surplus_component() -> Bool {
  let planned = falsifier_planned_components(enrollments: [
    FalsifierLaneEnrollment { lane: LanePredictOnly, enrolled: true },
    FalsifierLaneEnrollment { lane: LaneKnownRedProbe, enrolled: true }
  ])
  let verdict = falsifier_totality_verdict_from(
    planned: planned,
    rows: [
      falsifier_witness_row(index: 1, done: true),
      falsifier_witness_row(index: 2, done: true),
      falsifier_witness_row(index: 3, done: true)
    ]
  )
  match verdict {
    FalsifierSurplusComponents { surplus_indices: xs } =>
      (list_length(items: xs) == 1) && (xs.first() == 3)
    _ => false
  }
}

fn witness_totality_reds_on_duplicate_component() -> Bool {
  let planned = falsifier_planned_components(enrollments: [
    FalsifierLaneEnrollment { lane: LanePredictOnly, enrolled: true },
    FalsifierLaneEnrollment { lane: LaneKnownRedProbe, enrolled: true }
  ])
  let verdict = falsifier_totality_verdict_from(
    planned: planned,
    rows: [
      falsifier_witness_row(index: 1, done: true),
      falsifier_witness_row(index: 2, done: true),
      falsifier_witness_row(index: 2, done: false)
    ]
  )
  match verdict {
    FalsifierDuplicateComponents { duplicated_indices: xs } =>
      (list_length(items: xs) == 1) && (xs.first() == 2)
    _ => false
  }
}

fn witness_totality_fails_closed_on_empty_plan() -> Bool {
  let verdict = falsifier_totality_verdict_from(
    planned: [],
    rows: [falsifier_witness_row(index: 1, done: true)]
  )
  match verdict {
    FalsifierPlanEmpty { cause: c } => !falsifier_totality_is_total(v: verdict)
    _ => false
  }
}

data falsifier_equal_count_witness_note: String = "The axis that proves this is an identity join and not a count oracle: three planned components against three reported rows whose index set is {1, 2, 4}. Every count agrees — a count equality check reports total — while component 3 never reported and component 4 was never planned. The verdict must name the missing index."

fn witness_totality_reds_when_counts_agree_but_identities_do_not() -> Bool {
  let verdict = falsifier_totality_verdict_from(
    planned: falsifier_witness_planned_three(),
    rows: [
      falsifier_witness_row(index: 1, done: true),
      falsifier_witness_row(index: 2, done: true),
      falsifier_witness_row(index: 4, done: true)
    ]
  )
  match verdict {
    FalsifierMissingComponents { missing_indices: xs } =>
      (list_length(items: xs) == 1) && (xs.first() == 3)
    _ => false
  }
}

fn witness_routing_attributes_failing_component_to_lane() -> Bool {
  let planned = falsifier_witness_planned_three()
  match falsifier_route_row(planned: planned, row: falsifier_witness_row(index: 3, done: false)) {
    RoutedToLane { index: i, lane: l } => (i == 3) && falsifier_lane_eq(left: l, right: LaneSilentPickGate)
    RoutingRefused { index: i, cause: c } => false
  }
}

fn witness_routing_refuses_unattributable_component() -> Bool {
  let planned = falsifier_witness_planned_three()
  match falsifier_route_row(planned: planned, row: falsifier_witness_row(index: 9, done: false)) {
    RoutedToLane { index: i, lane: l } => false
    RoutingRefused { index: i, cause: c } => i == 9
  }
}

fn witness_unsuccessful_routings_exclude_done_rows() -> Bool {
  let planned = falsifier_witness_planned_three()
  let routings = falsifier_unsuccessful_routings(
    planned: planned,
    rows: [
      falsifier_witness_row(index: 1, done: true),
      falsifier_witness_row(index: 2, done: false),
      falsifier_witness_row(index: 3, done: true)
    ]
  )
  (list_length(items: routings) == 1)
    && falsifier_all_routed(rs: routings)
    && match routings.first() {
         Present { value: r } =>
           match r {
             RoutedToLane { index: i, lane: l } =>
               (i == 2) && falsifier_lane_eq(left: l, right: LaneKnownRedProbe)
             RoutingRefused { index: i, cause: c } => false
           }
         Absent => false
       }
}

fn witness_lane_names_are_distinct() -> Bool {
  let names = [
    falsifier_lane_name(l: LanePredictOnly),
    falsifier_lane_name(l: LaneSelfHostWet),
    falsifier_lane_name(l: LaneSelfHostWetKnownRed),
    falsifier_lane_name(l: LaneKnownRedProbe),
    falsifier_lane_name(l: LaneSilentPickGate),
    falsifier_lane_name(l: LaneRehomedBinWet),
    falsifier_lane_name(l: LaneSubstrateLongLane),
    falsifier_lane_name(l: LaneCadenceWitness),
    falsifier_lane_name(l: LaneGates)
  ]
  fold(names, init: true, f: fn(acc, n) {
    acc && (fold(names, init: 0, f: fn(c, m) { if m == n { c + 1 } else { c } }) == 1)
  })
}
