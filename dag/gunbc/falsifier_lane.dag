module gunbc.falsifier_lane

import std.dissolution { DissolutionCondition, unbound_dissolution }

import std.types { String, NonEmptyStr, Bool, List, list_length }
import std.nat { Nat }
import gunbc.floor_component_receipt {
  FloorComponentRow,
  ModeUnrecorded,
  floor_component_row_index,
  floor_component_row_is_done,
  floor_component_row_of,
  floor_component_row_of_failure_mode,
  floor_component_transition_outcome
}
import std.observation { Done, Refused, Failed, TimedOut, Skipped, Final }
import std.measure { millisecond }

data falsifier_lane_note: String = "The falsifier's per-component LANE identity, and the two things derived from it: a totality receipt (did every planned component report?) and a routing verdict (which lane owns a failing component?). WHY IT EXISTS, priced: gunbc.floor_component_receipt made the alert read per-component state instead of inferring one causal story from the overall conclusion, but it left the component ANONYMOUS. The label the seed stamps on a discovery batch is generated from the runnable's shape — claim_executor formats 'discovery-corpus[N root(s)+M explicit, adaptive width]' — so two lanes with the same root/entry arithmetic are indistinguishable in the receipt, and no label names the roster that failed. Triage therefore still ends at 'a batch was red', which is the same blindness one level down. THE FIX IS ATTRIBUTION, NOT A SECOND LABEL: the plan already knows which lane each batch is, because each batch is built by a named function over a named roster; that fact is simply discarded when the schedule flattens to List<List<Runnable>>. This module carries the lane vocabulary and the enrollment-ordered projection, and ci_floor_plan derives BOTH the batch schedule and the planned-component roster from one enrollment list — so an added lane cannot appear in the schedule without appearing in the attribution (DESIGN section 3: one authority, no fork to drift)."

data falsifier_lane_index_join_note: String = "The join key is the 1-based batch INDEX, and that is not in tension with floor_component_receipt_role_note's rule against keying on indices. That rule forbids treating an index as a STABLE NAME across runs — 'batch 4 is the silent-pick gate' relocates a hardcoded assumption, because gunbc_falsifier_ordinary_batches composes conditionally on enrollment flags and one flip shifts every later index. Here the index is used only WITHIN ONE RUN, to join a receipt against the very plan that produced it: both sides are projections of the same enrollment state, evaluated for the same run, so the correspondence is exact by construction rather than assumed. What crosses runs is the LANE, which is a name and stays one. The index is the join; the lane is the identity."

type FalsifierLane
  = LaneSelfHostWet
  | LaneSelfHostWetKnownRed
  | LaneKnownRedProbe
  | LaneSilentPickGate
  | LaneRehomedBinWet
  | LaneSubstrateLongLane
  | LaneCadenceWitness
  | LaneGates

fn falsifier_lane_name(l: FalsifierLane) -> String {
  match l {
    LaneSelfHostWet => "self_host_wet"
    LaneSelfHostWetKnownRed => "self_host_wet_known_red"
    LaneKnownRedProbe => "known_red_probe"
    LaneSilentPickGate => "silent_pick_gate"
    LaneRehomedBinWet => "rehomed_bin_wet"
    LaneSubstrateLongLane => "substrate_long_lane"
    LaneCadenceWitness => "cadence_witness"
    LaneGates => "gates"
  }
}

fn falsifier_lane_eq(left: FalsifierLane, right: FalsifierLane) -> Bool {
  falsifier_lane_name(l: left) == falsifier_lane_name(l: right)
}

type FalsifierLaneEnrollment {
  lane: FalsifierLane
  enrolled: Bool
}

type FalsifierPlannedComponent {
  index: Nat
  lane: FalsifierLane
}

fn falsifier_planned_components(enrollments: List<FalsifierLaneEnrollment>) -> List<FalsifierPlannedComponent> {
  fold(enrollments, init: [], f: fn(acc, e) {
    if e.enrolled {
      concat(acc, [FalsifierPlannedComponent { index: list_length(items: acc) + 1, lane: e.lane }])
    } else {
      acc
    }
  })
}

fn falsifier_planned_indices(planned: List<FalsifierPlannedComponent>) -> List<Nat> {
  planned |> map(p => p.index)
}

fn falsifier_reported_indices(rows: List<FloorComponentRow>) -> List<Nat> {
  rows |> map(r => floor_component_row_index(row: r))
}

fn index_occurrence_count(xs: List<Nat>, target: Nat) -> Nat {
  fold(xs, init: 0, f: fn(acc, x) { if x == target { acc + 1 } else { acc } })
}

fn list_contains_index(xs: List<Nat>, target: Nat) -> Bool {
  index_occurrence_count(xs: xs, target: target) > 0
}

fn duplicated_indices(xs: List<Nat>) -> List<Nat> {
  fold(xs, init: [], f: fn(acc, x) {
    if (index_occurrence_count(xs: xs, target: x) > 1) && !list_contains_index(xs: acc, target: x) {
      concat(acc, [x])
    } else {
      acc
    }
  })
}

data falsifier_run_standing_scope_note: String = "SCOPE, and the boundary that keeps this from being a second representation. This answers ONE question — did the falsifier job execute the components it planned — at BATCH grain. It does NOT answer whether any witness inside a component produced a verdict; that is the pending/current semantic evidence lifecycle signed on the witness-evidence-lifecycle model (docs/plans/witness-evidence-lifecycle-design.md, PR #7778), which is function-grain and is the single authority for enrollment-versus-execution. Nothing here may be read as evidence. The two are composed, never merged: run standing is a NECESSARY condition for the run having observed anything, and it is emphatically not a sufficient one — a component can report Done while every witness inside it was Interrupted and produced no verdict at all. falsifier_observed_health below is what enforces that composition structurally rather than by this note asking readers to remember it. Citation caveat carried per the coordinating directive: the FalsifierSubstrateLongLane cadence that model cites as its live specimen is currently dark."

data falsifier_run_standing_axes_note: String = "Three defect axes, each an exact index SET and each required to be explicitly empty — never a count equality between planned and reported (DESIGN section 5: completeness is an identity join, and count(planned) == count(reported) is satisfied by one missing component alongside one surplus one; witness_standing_reds_when_counts_agree_but_identities_do_not is the discriminating red for exactly that). MISSING is the axis the receipt cannot currently express on its own: the seed pads batches the stop policy never reached with an explicit not_reached Skipped row, so a gap in the reported set is not an unreached batch — it is the executor and the plan disagreeing about what the run consisted of, which is precisely the state no existing check can see. SURPLUS is its mirror. DUPLICATE catches two rows claiming one component, which would make attribution ambiguous rather than merely incomplete. StandingPlanEmpty fails closed rather than reporting a vacuous completeness: an empty planned roster means the projection did not run, not that there was nothing to run. (Until 2026-08-15 the guarantee that the roster is never legitimately empty rested on the predict-only sweep, which was unconditionally enrolled; that lane is deleted with affected-set selection, so every remaining lane is conditionally enrolled and an all-unenrolled plan is now reachable in principle. The arm is unchanged and still correct — it refuses — but it now refuses a state the enrollment flags can actually produce, rather than one they could not.)"

type FalsifierRunStanding
  = StandingComplete { component_count: Nat }
  | StandingMissingComponents { missing_indices: List<Nat> }
  | StandingSurplusComponents { surplus_indices: List<Nat> }
  | StandingDuplicateComponents { duplicated_indices: List<Nat> }
  | StandingPlanEmpty { cause: NonEmptyStr }

fn falsifier_run_standing_from(
  planned: List<FalsifierPlannedComponent>,
  rows: List<FloorComponentRow>
) -> FalsifierRunStanding {
  let planned_ix = falsifier_planned_indices(planned: planned)
  let reported_ix = falsifier_reported_indices(rows: rows)
  if list_length(items: planned_ix) == 0 {
    StandingPlanEmpty {
      cause: "no planned falsifier components — the lane projection did not run, and a vacuous completeness would report that as success" as NonEmptyStr
    }
  } else {
    let missing = filter(xs: planned_ix, predicate: fn(i) { !list_contains_index(xs: reported_ix, target: i) })
    let surplus = filter(xs: reported_ix, predicate: fn(i) { !list_contains_index(xs: planned_ix, target: i) })
    let duplicated = duplicated_indices(xs: reported_ix)
    if list_length(items: missing) > 0 {
      StandingMissingComponents { missing_indices: missing }
    } else if list_length(items: surplus) > 0 {
      StandingSurplusComponents { surplus_indices: surplus }
    } else if list_length(items: duplicated) > 0 {
      StandingDuplicateComponents { duplicated_indices: duplicated }
    } else {
      StandingComplete { component_count: list_length(items: planned_ix) }
    }
  }
}

data falsifier_run_standing_complete_is_not_health_note: String = "This predicate answers 'did every planned component report', and NOTHING else. It is deliberately not named *_is_healthy, *_is_green, or *_is_observed, because each of those would be the success-shaped value the combined finding names: three honest arms — admission honest about enrollment, standing honest about job completion, evidence honest about verdicts — composing into unobserved health because the first two return success while the third is unknown. StandingComplete is necessary and not sufficient, and the type below is what makes that structural instead of advisory."

fn falsifier_run_standing_is_complete(v: FalsifierRunStanding) -> Bool {
  match v {
    StandingComplete { component_count: n } => true
    StandingMissingComponents { missing_indices: xs } => false
    StandingSurplusComponents { surplus_indices: xs } => false
    StandingDuplicateComponents { duplicated_indices: xs } => false
    StandingPlanEmpty { cause: c } => false
  }
}

data falsifier_observed_health_note: String = "THE CONSTRUCTION WALL, and the reason this module ships a type with no success arm. The acceptance bar for F1 reaches past the run: if a control ran but a witness inside it produced no verdict, standing must not read as observed. A note saying so would be validation — a reader is asked to remember that StandingComplete is insufficient, and the first consumer that wants a green boolean will derive one anyway, because nothing stops it. So the green is made UNWRITABLE instead (DESIGN section 5, construction over validation): FalsifierObservedHealth has exactly two arms and neither of them is healthy. There is no constructor in this module, or reachable from it, that yields 'the falsifier observed its subject' — a consumer that wants to claim observation cannot get the value from here at all. WHAT IS MISSING IS NAMED, not silent (DESIGN section 4b, no untracked stall): the missing conjunct is the per-witness semantic evidence term, CurrentSemanticEvidence over every witness the completed components contain, owned by the witness-evidence-lifecycle model. Dissolve-on: that lifecycle exposes a per-run projection of its evidence status; a third arm ObservedHealthCurrent is added THERE, taking standing and the evidence term together, and this two-arm type becomes the pending half of it. Until then the honest answer to 'is the falsifier observing anything' is that this repository cannot yet compute it, and the type says so rather than a boolean guessing."

type FalsifierObservedHealth
  = ObservedHealthUndecided { standing: FalsifierRunStanding, missing_term: NonEmptyStr }
  | ObservedHealthRefused { standing: FalsifierRunStanding, cause: NonEmptyStr }

fn falsifier_observed_health(v: FalsifierRunStanding) -> FalsifierObservedHealth {
  if falsifier_run_standing_is_complete(v: v) {
    ObservedHealthUndecided {
      standing: v,
      missing_term: "per-witness semantic evidence: every planned component reported, but whether any witness inside them returned a verdict on this attempt is not decidable from batch-grain rows — see the witness-evidence-lifecycle CurrentSemanticEvidence authority" as NonEmptyStr
    }
  } else {
    ObservedHealthRefused {
      standing: v,
      cause: "run standing is not complete — the job did not execute the components it planned, so the run observed strictly less than it was scheduled to" as NonEmptyStr
    }
  }
}

data falsifier_routing_note: String = "Routing REFUSES rather than defaulting. There is no catch-all lane and no 'general' owner, because a default owner is the absorbing fallback DESIGN section 5 forbids in its cheapest disguise: every alert would route somewhere, the misroute frequency would be zero by construction, and the missing attribution would never rank for fixing. A refusal is counted and located, so a lane that stops being attributable surfaces as a diagnostic instead of as someone else's pager."

data falsifier_routing_two_unknowns_note: String = "TWO UNKNOWNS, TWO ARMS — they may not share one refusal (coordinating review, wise-ram-22 2026-08-04). RoutingLaneUndetermined means the component index is not in the planned roster at all: the run reported a component the plan does not know about, which is a MECHANISM gap, and its remedy is in the projection — the enrollment roster and the schedule have diverged, or the receipt is from a different plan. RoutingOwnerUndeclared means the lane IS determined and simply has no owner row: that is a ROUTING gap, and its remedy is authoring one row. Collapsing them would recreate the state-space conflation at the triage layer, which is the worst place for it — the person reading a triage refusal is by definition trying to find out who to talk to, and the two arms send them to entirely different places. Note the asymmetry that makes this more than bookkeeping: an owner-undeclared refusal still names the lane, so it is actionable without any further investigation, while a lane-undetermined refusal names nothing and is itself the bug."

data falsifier_lane_owner_roster_note: String = "The owner roster is DECLARED AND CURRENTLY EMPTY, and that is the honest state rather than an omission. The only owner fact in the tree today is the ALERT_MENTION constant in .github/workflows/falsifier-alert.yml — one handle for every failure, which is precisely the anonymous routing this module exists to replace. It became a named constant when the alert was found to be reaching that handle only once per incident: a mention notifies when it is CREATED, and only the issue body's first write is a creation, so the sustained-red heartbeat and the failing-set-changed comments — the artifacts that actually carry current state — notified nobody (issue #7737, four uncited comments across two days). The constant is now read by every notifying artifact, which is why it is one name rather than four literals. Copying it onto nine lane rows would fabricate eight ownership facts nobody has asserted (DESIGN section 5, no fabricated plausible output), and would look like attribution while carrying none. So the roster starts empty, every lane routes to RoutingOwnerUndeclared naming itself, and the gap is counted and located instead of papered over — a lane acquires an owner when someone actually owns it, by adding one row. This is deliberately a data roster and not a per-lane function so that authoring an owner never touches the routing algebra. Dissolve-on: the roster covers every lane in FalsifierLane, at which point RoutingOwnerUndeclared becomes unreachable in production and survives only as the witness's red control."

type FalsifierLaneOwner = LaneOwnerHandle { handle: NonEmptyStr }

type FalsifierLaneOwnerRow {
  lane: FalsifierLane
  owner: FalsifierLaneOwner
}

data falsifier_lane_owner_rows: List<FalsifierLaneOwnerRow> = []

fn falsifier_owner_of_lane(rows: List<FalsifierLaneOwnerRow>, lane: FalsifierLane) -> FalsifierLaneOwner? {
  fold(rows, init: none, f: fn(acc, r) {
    match acc {
      Present { value: o } => Present { value: o }
      Absent => if falsifier_lane_eq(left: r.lane, right: lane) { Present { value: r.owner } } else { none }
    }
  })
}

type FalsifierRouting
  = RoutedToOwner { index: Nat, lane: FalsifierLane, owner: FalsifierLaneOwner }
  | RoutingLaneUndetermined { index: Nat, cause: NonEmptyStr }
  | RoutingOwnerUndeclared { index: Nat, lane: FalsifierLane, cause: NonEmptyStr }

fn falsifier_lane_of_index(planned: List<FalsifierPlannedComponent>, index: Nat) -> FalsifierLane? {
  fold(planned, init: none, f: fn(acc, p) {
    match acc {
      Present { value: l } => Present { value: l }
      Absent => if p.index == index { Present { value: p.lane } } else { none }
    }
  })
}

fn falsifier_route_row(
  planned: List<FalsifierPlannedComponent>,
  owners: List<FalsifierLaneOwnerRow>,
  row: FloorComponentRow
) -> FalsifierRouting {
  let ix = floor_component_row_index(row: row)
  match falsifier_lane_of_index(planned: planned, index: ix) {
    Absent => RoutingLaneUndetermined {
      index: ix,
      cause: "component index is not in the planned falsifier lane roster — the run reported a component the plan does not know about, so the enrollment projection and the executed schedule have diverged" as NonEmptyStr
    }
    Present { value: l } =>
      match falsifier_owner_of_lane(rows: owners, lane: l) {
        Present { value: o } => RoutedToOwner { index: ix, lane: l, owner: o }
        Absent => RoutingOwnerUndeclared {
          index: ix,
          lane: l,
          cause: "lane is determined but has no owner row in falsifier_lane_owner_rows — attribution succeeded, ownership is unauthored" as NonEmptyStr
        }
      }
  }
}

fn falsifier_unsuccessful_routings(
  planned: List<FalsifierPlannedComponent>,
  owners: List<FalsifierLaneOwnerRow>,
  rows: List<FloorComponentRow>
) -> List<FalsifierRouting> {
  rows
    |> filter(r => !floor_component_row_is_done(row: r))
    |> map(r => falsifier_route_row(planned: planned, owners: owners, row: r))
}

fn falsifier_routing_lane_is_determined(r: FalsifierRouting) -> Bool {
  match r {
    RoutedToOwner { index: i, lane: l, owner: o } => true
    RoutingLaneUndetermined { index: i, cause: c } => false
    RoutingOwnerUndeclared { index: i, lane: l, cause: c } => true
  }
}

fn falsifier_routing_reaches_owner(r: FalsifierRouting) -> Bool {
  match r {
    RoutedToOwner { index: i, lane: l, owner: o } => true
    RoutingLaneUndetermined { index: i, cause: c } => false
    RoutingOwnerUndeclared { index: i, lane: l, cause: c } => false
  }
}

fn falsifier_all_lanes_determined(rs: List<FalsifierRouting>) -> Bool {
  fold(rs, init: true, f: fn(acc, r) { acc && falsifier_routing_lane_is_determined(r: r) })
}

data falsifier_failing_set_note: String = "THE PER-WINDOW FAILING SET — the projection the alert needs and does not have. Priced by a live incident (still-bat-561, 2026-08-04): issue #7737 is open and correct, and its BODY is thirty hours stale. It describes witness_committed_is_fixed_point at 5004ms against a 5000ms budget from run 30809682025; the falsifier stopped failing that way on 2026-08-03T17:53 and has since failed on five entirely different witnesses. Nothing lies — the alerter's heartbeat suppression is working as designed and the issue is genuinely still red — but an open issue READS as a live description of the current failure, and this one is a description of a failure that no longer occurs. The current failing set is derivable today only by downloading a two-hour run log and grepping falsifier-failure-class. So the defect is not detection and not a missing alert; it is that the failing set is not RE-DERIVED per window. This function is that re-derivation, over evidence that already exists: the component rows the receipt already emits, joined to the lane roster the plan already knows."

data falsifier_failure_class_note: String = "FAILURE CLASS IS CARRIED, because a red that CHANGES CLASS is a different incident from a red that persists, and rendering both as one unchanging open issue is what froze #7737. The two live classes are structurally different and want different responders: Class A (BudgetExceeded, three windows to 2026-08-03 14:46) is HOST-SENSITIVE — head 19cc776d4 passed on srv3-01 and failed on srv4-05 with identical content — while Class B (WitnessRed, seven windows since) is DETERMINISTIC, head 772d92d18 failing identically on two different hosts. A receipt reporting one undifferentiated 'falsifier red' state would conflate a flaky host with a real regression, which is the state-space conflation DESIGN section 5 forbids, at the layer where it costs the most triage time.

WHAT THIS CAN AND CANNOT DISTINGUISH, stated exactly rather than implied. ClassBudgetExceeded is exact: the seed's BudgetExceeded mode is the only one mapping to Refused. ClassFailedIndistinct is NOT exact and says so in its name — gunbc.floor_component_receipt floor_component_outcome_of_failure_mode maps BOTH WitnessRed AND Infra onto Failed { error, output }, so at component-row grain a genuine witness regression and a broken runner are the same value. That collapse is upstream of this module and is not repaired here; fabricating a split would be inventing a distinction the data does not carry. It is a real limitation of the current receipt for exactly the Class A/Class B question that priced this work, so it is named as a typed arm rather than left for a reader to discover. Dissolve-on: the failure mode reaches the row as a typed field instead of being collapsed into an outcome variant — the same seam floor_component_receipt_timed_out_frontier_note already names for TimedOut — at which point ClassFailedIndistinct splits into ClassWitnessRed and ClassInfra and this arm deletes.

THE STRENGTH OF THIS CLASSIFICATION, bounded honestly. Everything in THIS module keys on typed structure: the class is selected by matching ObservationOutcome's coproduct arms, never by reading the diagnostic or error text those arms carry, so the identity join over components is complete in the sense DESIGN section 5's oracle ruling means — a row cannot exist without its identity fields (boundary supplied by wise-ram-22, 2026-08-04: an identity anchor is the stronger one only WHERE IDENTITY IS STRUCTURALLY CARRIED, and a population of prose can restate a conclusion without its evidence and thereby escape such a join). But the chain does not begin here, and one layer up it is prose. claim_executor's falsifier_failure_mode reconstructs BudgetExceeded by testing whether a rendered diagnostic contains the substring 'eval budget exceeded', while the seed already HAS the typed InterpError::EvalBudgetExceeded { elapsed_ms, budget_ms } and destroys it in transit; that function's own comment reads 'THIS LIST IS A FORK, and that is the defect'. So ClassBudgetExceeded is exactly as sound as that substring match, and a reworded interpreter diagnostic would silently reclassify Class A as Class B — which is the class transition this module exists to make visible, arriving as a false one. That is inherited debt, not introduced here, and it is named rather than papered over because a classification presented as typed while resting on a grep is the specification-without-execution trap wearing this module's own clothes. The dissolve-on above is the same repair: carrying the typed mode through retires both the collapse AND the substring reconstruction."

type FalsifierFailureClass
  = ClassBudgetExceeded { diagnostic: NonEmptyStr }
  | ClassFailedIndistinct { error: NonEmptyStr }
  | ClassTimedOut
  | ClassNotReached { reason: NonEmptyStr }
  | ClassShownFailures { count: Nat }

fn falsifier_failure_class_of_row(row: FloorComponentRow) -> FalsifierFailureClass? {
  match floor_component_transition_outcome(t: row.event.transition) {
    Absent => none
    Present { value: o } =>
      match o {
        Done => none
        Refused { diagnostic: d } => Present { value: ClassBudgetExceeded { diagnostic: d } }
        Failed { error: e, output: out } => Present { value: ClassFailedIndistinct { error: e } }
        TimedOut { basis: _, budget: b, elapsed: el } => Present { value: ClassTimedOut }
        Skipped { reason: r } => Present { value: ClassNotReached { reason: r } }
        Final { shown_failures: n } =>
          if n == 0 { none } else { Present { value: ClassShownFailures { count: n } } }
      }
  }
}

fn falsifier_failure_class_name(c: FalsifierFailureClass) -> String {
  match c {
    ClassBudgetExceeded { diagnostic: d } => "budget_exceeded"
    ClassFailedIndistinct { error: e } => "failed_indistinct"
    ClassTimedOut => "timed_out"
    ClassNotReached { reason: r } => "not_reached"
    ClassShownFailures { count: n } => "shown_failures"
  }
}

type FalsifierFailingComponent {
  index: Nat
  routing: FalsifierRouting
  failure_class: FalsifierFailureClass
}

fn falsifier_failing_set(
  planned: List<FalsifierPlannedComponent>,
  owners: List<FalsifierLaneOwnerRow>,
  rows: List<FloorComponentRow>
) -> List<FalsifierFailingComponent> {
  fold(rows, init: [], f: fn(acc, row) {
    match falsifier_failure_class_of_row(row: row) {
      Absent => acc
      Present { value: c } => concat(acc, [FalsifierFailingComponent {
        index: floor_component_row_index(row: row),
        routing: falsifier_route_row(planned: planned, owners: owners, row: row),
        failure_class: c
      }])
    }
  })
}

data falsifier_failing_set_signature_note: String = "The class SIGNATURE of a window: the ordered failure-class names of its failing components. This is the minimum needed to answer the question that froze #7737 — did the failure change class, or is this the same red as last window — without carrying run identity, timestamps, or history, none of which belong in a pure projection. A consumer compares two windows' signatures; an inequality is a class transition and therefore a new incident, even when the issue stays open. Kept as a derived list rather than a stored digest so the comparison names WHICH position changed rather than only that something did."

fn falsifier_failing_class_signature(failing: List<FalsifierFailingComponent>) -> List<String> {
  failing |> map(f => falsifier_failure_class_name(c: f.failure_class))
}

data falsifier_lane_witness_note: String = "Witness functions live in the carrier and are imported by dag/test/claim/falsifier_lane_witness_test.dag, the same shape tools.dag_compile_clean_shard_totality uses. Every red control is SYNTHETIC — hand-built planned rosters and fixture component rows — so each defect axis is exercised by a discriminating input that goes red when the algebra is wrong, never by waiting for a real cadence run to misbehave (DESIGN section 5: green by execution plus a discriminating red). The fixture rows are built through floor_component_row_of, the receipt's own constructor, so a change to the row shape breaks these witnesses rather than letting them drift onto a private copy."

fn falsifier_witness_row(index: Nat, done: Bool) -> FloorComponentRow {
  floor_component_row_of(
    run_id: "witness" as NonEmptyStr,
    index: index,
    label: "discovery-corpus[2 root(s)+0 explicit, adaptive width]" as NonEmptyStr,
    witnesses: 0,
    outcome: if done { Done } else { Failed { error: "synthetic red" as NonEmptyStr, output: "" } },
    wall: millisecond(count: 0),
    failure_mode: ModeUnrecorded
  )
}

fn falsifier_witness_planned_three() -> List<FalsifierPlannedComponent> {
  falsifier_planned_components(enrollments: [
    FalsifierLaneEnrollment { lane: LaneSelfHostWetKnownRed, enrolled: true },
    FalsifierLaneEnrollment { lane: LaneKnownRedProbe, enrolled: true },
    FalsifierLaneEnrollment { lane: LaneSilentPickGate, enrolled: true }
  ])
}

fn witness_planned_components_skip_unenrolled_and_renumber() -> Bool {
  let planned = falsifier_planned_components(enrollments: [
    FalsifierLaneEnrollment { lane: LaneSelfHostWetKnownRed, enrolled: true },
    FalsifierLaneEnrollment { lane: LaneSelfHostWet, enrolled: false },
    FalsifierLaneEnrollment { lane: LaneKnownRedProbe, enrolled: true }
  ])
  (list_length(items: planned) == 2)
    && match falsifier_lane_of_index(planned: planned, index: 1) {
         Present { value: l } => falsifier_lane_eq(left: l, right: LaneSelfHostWetKnownRed)
         Absent => false
       }
    && match falsifier_lane_of_index(planned: planned, index: 2) {
         Present { value: l } => falsifier_lane_eq(left: l, right: LaneKnownRedProbe)
         Absent => false
       }
}

fn witness_standing_green_on_matching_plan() -> Bool {
  let verdict = falsifier_run_standing_from(
    planned: falsifier_witness_planned_three(),
    rows: [
      falsifier_witness_row(index: 1, done: true),
      falsifier_witness_row(index: 2, done: true),
      falsifier_witness_row(index: 3, done: true)
    ]
  )
  match verdict {
    StandingComplete { component_count: n } => n == 3
    _ => false
  }
}

fn witness_standing_reds_on_missing_component() -> Bool {
  let verdict = falsifier_run_standing_from(
    planned: falsifier_witness_planned_three(),
    rows: [
      falsifier_witness_row(index: 1, done: true),
      falsifier_witness_row(index: 2, done: true)
    ]
  )
  match verdict {
    StandingMissingComponents { missing_indices: xs } =>
      (list_length(items: xs) == 1) && (xs.first() == 3)
    _ => false
  }
}

fn witness_standing_reds_on_surplus_component() -> Bool {
  let planned = falsifier_planned_components(enrollments: [
    FalsifierLaneEnrollment { lane: LaneSelfHostWetKnownRed, enrolled: true },
    FalsifierLaneEnrollment { lane: LaneKnownRedProbe, enrolled: true }
  ])
  let verdict = falsifier_run_standing_from(
    planned: planned,
    rows: [
      falsifier_witness_row(index: 1, done: true),
      falsifier_witness_row(index: 2, done: true),
      falsifier_witness_row(index: 3, done: true)
    ]
  )
  match verdict {
    StandingSurplusComponents { surplus_indices: xs } =>
      (list_length(items: xs) == 1) && (xs.first() == 3)
    _ => false
  }
}

fn witness_standing_reds_on_duplicate_component() -> Bool {
  let planned = falsifier_planned_components(enrollments: [
    FalsifierLaneEnrollment { lane: LaneSelfHostWetKnownRed, enrolled: true },
    FalsifierLaneEnrollment { lane: LaneKnownRedProbe, enrolled: true }
  ])
  let verdict = falsifier_run_standing_from(
    planned: planned,
    rows: [
      falsifier_witness_row(index: 1, done: true),
      falsifier_witness_row(index: 2, done: true),
      falsifier_witness_row(index: 2, done: false)
    ]
  )
  match verdict {
    StandingDuplicateComponents { duplicated_indices: xs } =>
      (list_length(items: xs) == 1) && (xs.first() == 2)
    _ => false
  }
}

fn witness_standing_fails_closed_on_empty_plan() -> Bool {
  let verdict = falsifier_run_standing_from(
    planned: [],
    rows: [falsifier_witness_row(index: 1, done: true)]
  )
  match verdict {
    StandingPlanEmpty { cause: c } => !falsifier_run_standing_is_complete(v: verdict)
    _ => false
  }
}

data falsifier_equal_count_witness_note: String = "The axis that proves this is an identity join and not a count oracle: three planned components against three reported rows whose index set is {1, 2, 4}. Every count agrees — a count equality check reports total — while component 3 never reported and component 4 was never planned. The verdict must name the missing index."

fn witness_standing_reds_when_counts_agree_but_identities_do_not() -> Bool {
  let verdict = falsifier_run_standing_from(
    planned: falsifier_witness_planned_three(),
    rows: [
      falsifier_witness_row(index: 1, done: true),
      falsifier_witness_row(index: 2, done: true),
      falsifier_witness_row(index: 4, done: true)
    ]
  )
  match verdict {
    StandingMissingComponents { missing_indices: xs } =>
      (list_length(items: xs) == 1) && (xs.first() == 3)
    _ => false
  }
}

data falsifier_witness_owner_rows_note: String = "A FIXTURE owner roster, deliberately not the production one. The production falsifier_lane_owner_rows is empty by design, so witnessing RoutedToOwner against it would be impossible and the routed arm would be specification-without-execution — proven only by the type existing. Authoring a synthetic row here exercises the reached-owner path for real while leaving the production roster honest, and the empty-roster path gets its own witness below. The handle is plainly synthetic so it can never be mistaken for an ownership assertion about a person."

fn falsifier_witness_owner_rows() -> List<FalsifierLaneOwnerRow> {
  [FalsifierLaneOwnerRow {
    lane: LaneSilentPickGate,
    owner: LaneOwnerHandle { handle: "synthetic-witness-owner" as NonEmptyStr }
  }]
}

fn witness_routing_attributes_failing_component_to_owner() -> Bool {
  match falsifier_route_row(
    planned: falsifier_witness_planned_three(),
    owners: falsifier_witness_owner_rows(),
    row: falsifier_witness_row(index: 3, done: false)
  ) {
    RoutedToOwner { index: i, lane: l, owner: o } =>
      (i == 3)
        && falsifier_lane_eq(left: l, right: LaneSilentPickGate)
        && match o { LaneOwnerHandle { handle: h } => (h as String) == "synthetic-witness-owner" }
    _ => false
  }
}

data falsifier_two_unknowns_witness_note: String = "The discriminating pair for the two-unknowns split: the SAME planned roster and the SAME owner roster, differing only in which component is being routed. Index 9 is not planned at all and must yield RoutingLaneUndetermined; index 2 is planned as known_red_probe, which the fixture owner roster does not cover, and must yield RoutingOwnerUndeclared STILL NAMING ITS LANE. If the two arms were ever collapsed, one of these two witnesses goes red — which is what makes the split enforced rather than merely described."

fn witness_routing_refuses_lane_undetermined() -> Bool {
  match falsifier_route_row(
    planned: falsifier_witness_planned_three(),
    owners: falsifier_witness_owner_rows(),
    row: falsifier_witness_row(index: 9, done: false)
  ) {
    RoutingLaneUndetermined { index: i, cause: c } => i == 9
    _ => false
  }
}

fn witness_routing_refuses_owner_undeclared_but_names_lane() -> Bool {
  match falsifier_route_row(
    planned: falsifier_witness_planned_three(),
    owners: falsifier_witness_owner_rows(),
    row: falsifier_witness_row(index: 2, done: false)
  ) {
    RoutingOwnerUndeclared { index: i, lane: l, cause: c } =>
      (i == 2) && falsifier_lane_eq(left: l, right: LaneKnownRedProbe)
    _ => false
  }
}

fn witness_routing_empty_owner_roster_still_determines_lane() -> Bool {
  let r = falsifier_route_row(
    planned: falsifier_witness_planned_three(),
    owners: falsifier_lane_owner_rows,
    row: falsifier_witness_row(index: 3, done: false)
  )
  falsifier_routing_lane_is_determined(r: r) && !falsifier_routing_reaches_owner(r: r)
}

fn witness_unsuccessful_routings_exclude_done_rows() -> Bool {
  let routings = falsifier_unsuccessful_routings(
    planned: falsifier_witness_planned_three(),
    owners: falsifier_witness_owner_rows(),
    rows: [
      falsifier_witness_row(index: 1, done: true),
      falsifier_witness_row(index: 2, done: false),
      falsifier_witness_row(index: 3, done: true)
    ]
  )
  (list_length(items: routings) == 1)
    && falsifier_all_lanes_determined(rs: routings)
    && match routings.first() {
         Present { value: r } =>
           match r {
             RoutingOwnerUndeclared { index: i, lane: l, cause: c } =>
               (i == 2) && falsifier_lane_eq(left: l, right: LaneKnownRedProbe)
             _ => false
           }
         Absent => false
       }
}

fn falsifier_witness_row_with(index: Nat, mode: NonEmptyStr, detail: NonEmptyStr) -> FloorComponentRow? {
  floor_component_row_of_failure_mode(
    run_id: "witness" as NonEmptyStr,
    index: index,
    label: "discovery-corpus[2 root(s)+0 explicit, adaptive width]" as NonEmptyStr,
    witnesses: 0,
    failure_mode: mode,
    detail: detail,
    wall: millisecond(count: 0)
  )
}

fn falsifier_witness_class_of_mode(mode: NonEmptyStr) -> String {
  match falsifier_witness_row_with(index: 1, mode: mode, detail: "synthetic" as NonEmptyStr) {
    Absent => "row_not_built"
    Present { value: row } =>
      match falsifier_failure_class_of_row(row: row) {
        Absent => "not_failing"
        Present { value: c } => falsifier_failure_class_name(c: c)
      }
  }
}

data falsifier_class_split_witness_note: String = "The Class A / Class B control, driven through the seed's OWN failure-mode vocabulary rather than through hand-built outcomes, so it exercises the real mapping gunbc.floor_component_receipt performs. It asserts both what the receipt CAN distinguish and what it CANNOT: BudgetExceeded (Class A, host-sensitive) is separable and lands on budget_exceeded, while WitnessRed (Class B, deterministic) and Infra are BOTH failed_indistinct — the collapse named in falsifier_failure_class_note. Asserting the collapse rather than working around it is the point: if the receipt is later fixed to carry the mode through, this row goes red and is the trigger to split ClassFailedIndistinct, which is exactly the dissolution signal that note declares."

fn witness_failure_class_separates_budget_from_witness_red() -> Bool {
  (falsifier_witness_class_of_mode(mode: "BudgetExceeded" as NonEmptyStr) == "budget_exceeded")
    && (falsifier_witness_class_of_mode(mode: "WitnessRed" as NonEmptyStr) == "failed_indistinct")
    && (falsifier_witness_class_of_mode(mode: "not_reached" as NonEmptyStr) == "not_reached")
    && (falsifier_witness_class_of_mode(mode: "none" as NonEmptyStr) == "not_failing")
}

fn witness_failure_class_records_the_infra_collapse() -> Bool {
  falsifier_witness_class_of_mode(mode: "Infra" as NonEmptyStr) == falsifier_witness_class_of_mode(mode: "WitnessRed" as NonEmptyStr)
}

fn witness_failing_set_names_lane_and_class_per_component() -> Bool {
  let failing = falsifier_failing_set(
    planned: falsifier_witness_planned_three(),
    owners: falsifier_witness_owner_rows(),
    rows: [
      falsifier_witness_row(index: 1, done: true),
      falsifier_witness_row(index: 2, done: false),
      falsifier_witness_row(index: 3, done: false)
    ]
  )
  (list_length(items: failing) == 2)
    && match failing.first() {
         Present { value: f } =>
           (f.index == 2)
             && match f.routing {
                  RoutingOwnerUndeclared { index: i, lane: l, cause: c } =>
                    falsifier_lane_eq(left: l, right: LaneKnownRedProbe)
                  _ => false
                }
             && (falsifier_failure_class_name(c: f.failure_class) == "failed_indistinct")
         Absent => false
       }
}

data falsifier_signature_witness_note: String = "The stale-issue control, expressed as the property that would have caught #7737: two windows failing in the SAME components but for DIFFERENT reasons must not produce the same signature. If they did, a consumer comparing windows would see no transition and leave a thirty-hour-old description standing, which is the live defect this lane was reprioritized onto."

fn witness_class_signature_distinguishes_a_class_transition() -> Bool {
  let planned = falsifier_witness_planned_three()
  let owners = falsifier_witness_owner_rows()
  match falsifier_witness_row_with(index: 2, mode: "BudgetExceeded" as NonEmptyStr, detail: "class A" as NonEmptyStr) {
    Absent => false
    Present { value: window_a } =>
      match falsifier_witness_row_with(index: 2, mode: "WitnessRed" as NonEmptyStr, detail: "class B" as NonEmptyStr) {
        Absent => false
        Present { value: window_b } =>
          falsifier_failing_class_signature(
            failing: falsifier_failing_set(planned: planned, owners: owners, rows: [window_a])
          ) != falsifier_failing_class_signature(
            failing: falsifier_failing_set(planned: planned, owners: owners, rows: [window_b])
          )
      }
  }
}

fn witness_class_signature_stable_when_class_persists() -> Bool {
  let planned = falsifier_witness_planned_three()
  let owners = falsifier_witness_owner_rows()
  match falsifier_witness_row_with(index: 2, mode: "WitnessRed" as NonEmptyStr, detail: "first window" as NonEmptyStr) {
    Absent => false
    Present { value: window_a } =>
      match falsifier_witness_row_with(index: 2, mode: "WitnessRed" as NonEmptyStr, detail: "later window, different detail" as NonEmptyStr) {
        Absent => false
        Present { value: window_b } =>
          falsifier_failing_class_signature(
            failing: falsifier_failing_set(planned: planned, owners: owners, rows: [window_a])
          ) == falsifier_failing_class_signature(
            failing: falsifier_failing_set(planned: planned, owners: owners, rows: [window_b])
          )
      }
  }
}

data falsifier_no_green_arm_witness_note: String = "The construction wall's own control. It asserts a NEGATIVE — that a complete run standing still does not project to observed — which is the only shape available when the point is that a value cannot be constructed. It is deliberately weaker than the wall itself: the wall is that FalsifierObservedHealth has no healthy arm, which the typechecker enforces at every call site and no witness could ever establish more strongly. This row exists so that ADDING a green arm without also composing in the semantic evidence term breaks a test rather than passing silently (DESIGN section 4b, meta-obligation 4: the discriminating control stays enrolled after the climb)."

fn witness_complete_standing_does_not_project_to_observed() -> Bool {
  let standing = falsifier_run_standing_from(
    planned: falsifier_witness_planned_three(),
    rows: [
      falsifier_witness_row(index: 1, done: true),
      falsifier_witness_row(index: 2, done: true),
      falsifier_witness_row(index: 3, done: true)
    ]
  )
  falsifier_run_standing_is_complete(v: standing)
    && match falsifier_observed_health(v: standing) {
         ObservedHealthUndecided { standing: s, missing_term: t } =>
           falsifier_run_standing_is_complete(v: s)
         ObservedHealthRefused { standing: s, cause: c } => false
       }
}

fn witness_incomplete_standing_refuses_observed() -> Bool {
  let standing = falsifier_run_standing_from(
    planned: falsifier_witness_planned_three(),
    rows: [falsifier_witness_row(index: 1, done: true)]
  )
  match falsifier_observed_health(v: standing) {
    ObservedHealthRefused { standing: s, cause: c } => !falsifier_run_standing_is_complete(v: s)
    ObservedHealthUndecided { standing: s, missing_term: t } => false
  }
}

fn witness_lane_names_are_distinct() -> Bool {
  let names = [
    falsifier_lane_name(l: LaneSelfHostWet),
    falsifier_lane_name(l: LaneSelfHostWetKnownRed),
    falsifier_lane_name(l: LaneKnownRedProbe),
    falsifier_lane_name(l: LaneSilentPickGate),
    falsifier_lane_name(l: LaneRehomedBinWet),
    falsifier_lane_name(l: LaneSubstrateLongLane),
    falsifier_lane_name(l: LaneCadenceWitness),
    falsifier_lane_name(l: LaneGates)
  ]
  fold(names, init: true, f: fn(acc, n) {
    acc && (fold(names, init: 0, f: fn(c, m) { if m == n { c + 1 } else { c } }) == 1)
  })
}

data falsifier_lane_receipt_wiring_dissolve_on: DissolutionCondition = unbound_dissolution(description: "dissolve-on: the falsifier receipt document carries these blocks. Today the seed calls gunbc.floor_component_receipt floor_component_receipt_document_with_selection with rows only, and that function is SHARED with the per-PR floor, which has no lane roster — so adding a lane block there unconditionally would fabricate lane identity for components that have none. Wiring is therefore a falsifier-spe")
