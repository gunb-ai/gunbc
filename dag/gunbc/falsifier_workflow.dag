type FalsifierStepTimeoutBasis {
  single_step_cap_minutes: Int
  prior_cap_minutes: Int
  current_cap_minutes: Int
  measurement_github_actions_run_id: NonEmptyStr
  not_algebraically_closed_from: NonEmptyStr
  dissolution_trigger: NonEmptyStr
}

data gunbc_falsifier_step_timeout_basis: FalsifierStepTimeoutBasis = FalsifierStepTimeoutBasis {
  single_step_cap_minutes: 170,
  prior_cap_minutes: 120,
  current_cap_minutes: 170,
  measurement_github_actions_run_id: "29135185172",
  not_algebraically_closed_from: "gunbc.ci_spec floor batch-clamp overheads (per-batch wall at execution time; no composed sum closes to the single-step cap)",
  dissolution_trigger: "gunbc.ci_spec batch-clamp overheads algebraically compose to gunbc_falsifier_step_timeout_minutes, replacing the measured-envelope basis"
}

data gunbc_falsifier_step_timeout_minutes: Int = 170

fn gunbc_falsifier_step_timeout_basis_is_measured_not_composed() -> Bool {
  match gunbc_falsifier_step_timeout_basis {
    FalsifierStepTimeoutBasis {
      single_step_cap_minutes: cap,
      prior_cap_minutes: 120,
      current_cap_minutes: 170,
      measurement_github_actions_run_id: run,
      not_algebraically_closed_from: _,
      dissolution_trigger: _
    } =>
      cap == gunbc_falsifier_step_timeout_minutes
        && run == "29135185172"
        && gunbc_falsifier_step_timeout_minutes == 170
  }
}

data gunbc_falsifier_step_timeout_note: String = "120 -> 170 (2026-07-11, run 29135185172 receipt): the first corpus-reaching cold run was TIME-killed at the 120-min step ceiling with the corpus incomplete (1970 rows, closure 1396 modules, width 1) and floor peak 16146612224 bytes against a 16GiB slot budget, still growing - so 120 censored the measurement without bounding anything real (the memory cap is the true wall). 170 lets a nightly run reach either completion (exact-labeled receipt) or the cap kill (censored-labeled receipt); both are the falsifier doing its measurement job, and the job backstop DERIVES from this value so it stretches in step. Revisit down when the resolver graph-major module split (S2a move 2) shrinks cold-resolve wall and residency."

data falsifier_plan_function: String = plan_function_name(p: FalsifierPlan)

fn falsifier_invoke() -> String {
  concat(
    concat("ROOT=", concat(ci_repo_root_shell(), "\n")),
    claim_executor_run_plan_shell(
      source_roots: witness_layer_roots,
      plan_entry: "src/v2/workflow/ci_floor_plan.dag",
      plan_function: FalsifierPlan,
      notice_title: Absent,
      rooted: false
    )
  )
}

fn falsifier_step() -> Step {
  RunStep {
    name: Present { value: "affected-set falsifier (predict-only cold run)" },
    id: Present { value: "floor" },
    run: falsifier_invoke(),
    shell: none,
    env: Present {
      value: [
        kv(key: "GUNBC_CI_DIFF_BASE", value: yaml_string(s: "HEAD~20")),
        kv(key: "GUNBC_CI_DIFF_HEAD", value: yaml_string(s: "HEAD")),
        kv(key: ci_floor_phase_journal_env_name, value: yaml_string(s: ci_floor_phase_journal_path))
      ]
    },
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_falsifier_step_timeout_minutes }
  }
}

data falsifier_native_cache_cold_plan_target_note: String = "THE STEP WHOSE PLAN TARGET ESCAPED THE #7470 MIGRATION, kept as the receipt for why the target is now a typed variant instead of an argv token. Every other consumer derived its plan name from a constant, so the 2026-07-30 WalkPlan rename reached all four automatically; this step alone passed the inline literal \"gunbc_falsifier_native_cache_cold_batches\", derived from nothing, and was left behind returning a bare List<List<Runnable>>. The executor's strict parser then refused it on every one of the 8 falsifier runs that armed this step (0 successes), and it read as intermittent only because the step is skipped whenever the falsifier step fails first.\n\nThe first repair here added a naming constant beside the other four. That was still validation — it made the rename reach this site but left the next author free to type a fresh literal. The constant was therefore DELETED in the same change that introduced gunbc.cli_invoke PlanFunction: an inline literal at this argument is now a type error, so the roster is closed by construction and a String projection with no consumer would be exactly the inert carrier §2 forbids. Dissolution-on-climb (§4b): the wall replaces the lower-rung machinery rather than accumulating beside it."

data floor_component_receipt_upload_note: String = "Uploads the floor's per-component receipt so the alert workflow can READ which component failed instead of inferring one hardcoded story from the overall run conclusion (gunbc.floor_component_receipt carries the priced defect). if: always() is load-bearing and is the whole point: the receipt matters MOST on a red run, and a red floor step would otherwise skip the upload and leave the alert blind — which is the state that produced the false 'affected-set cold control is dark' claim on run 30509024051. It sits immediately after falsifier_step so it captures that step's receipt. F0 (2026-08-04): compile-clean and native-cache cold controls now use falsifier_control_prerequisite_if (always + release_build success) in gunbc.falsifier_run_control — they execute after the floor concludes, not only when it succeeds. if-no-files-found: error, because a silently absent receipt is the same blindness one layer down; the alert's own missing-artifact arm reports an explicit unknown rather than re-widening. Its transfer term joins gunbc_falsifier_job_backstop_timeout_minutes so the backstop stays the exact step-sum + prelude (the invariant falsifier_workflow_witness_test asserts)."

fn floor_component_receipt_upload_step() -> Step {
  UsesStep {
    name: Present { value: "Upload floor component receipt (read by falsifier-alert)" },
    id: none,
    uses: upload_artifact_action,
    with: Present {
      value: [
        kv(key: "name", value: yaml_string(s: floor_component_receipt_artifact_name)),
        kv(key: "path", value: yaml_string(s: floor_component_receipt_path)),
        kv(key: "if-no-files-found", value: yaml_string(s: "error")),
        kv(key: "retention-days", value: yaml_int(n: 30)),
        kv(key: "compression-level", value: yaml_int(n: 0))
      ]
    },
    env: none,
    if_condition: Present { value: "always()" },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_artifact_transfer_step_timeout_minutes }
  }
}

fn gunbc_falsifier_build_job_backstop_timeout_minutes() -> Int {
  gunbc_ci_release_build_step_timeout_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc_ci_artifact_transfer_step_timeout_minutes + gunbc_ci_prelude_allowance_minutes
}

fn gunbc_falsifier_selection_control_job_backstop_timeout_minutes() -> Int {
  gunbc_ci_artifact_transfer_step_timeout_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc_ci_selection_control_step_timeout_minutes + gunbc_ci_prelude_allowance_minutes
}

fn gunbc_falsifier_cold_corpus_job_backstop_timeout_minutes() -> Int {
  gunbc_ci_artifact_transfer_step_timeout_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc_falsifier_step_timeout_minutes + gunbc_ci_artifact_transfer_step_timeout_minutes + gunbc_falsifier_compile_clean_cold_control_timeout_minutes + gunbc_falsifier_native_cache_cold_control_timeout_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc_ci_prelude_allowance_minutes
}

fn gunbc_falsifier_aggregate_verdict_job_backstop_timeout_minutes() -> Int {
  gunbc_ci_artifact_transfer_step_timeout_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc_ci_prelude_allowance_minutes
}

fn falsifier_floor_component_receipt_download_step() -> Step {
  UsesStep {
    name: Present { value: "Download floor component receipt (cold-corpus execution witness)" },
    id: Present { value: "floor_component_receipt_download" },
    uses: download_artifact_action,
    with: Present {
      value: [
        kv(key: "name", value: yaml_string(s: floor_component_receipt_artifact_name)),
        kv(key: "path", value: yaml_string(s: "target"))
      ]
    },
    env: none,
    if_condition: none,
    continue_on_error: Present { value: true },
    timeout_minutes: Present { value: gunbc_ci_artifact_transfer_step_timeout_minutes }
  }
}

fn gunbc_falsifier_job_backstop_timeout_minutes() -> Int {
  gunbc_falsifier_build_job_backstop_timeout_minutes() + gunbc_falsifier_selection_control_job_backstop_timeout_minutes() + gunbc_falsifier_cold_corpus_job_backstop_timeout_minutes() + gunbc_falsifier_aggregate_verdict_job_backstop_timeout_minutes()
}

data gunbc_falsifier_job_split_note: String = "Four-job topology (2026-08-07, operator ruling proud-bear-834 adhoc-8b992195-d13; pre-authorized follow-up named in gunbc.falsifier_run_control falsifier_control_prerequisite_note): falsifier-build compiles and uploads release-bins ONLY; selection-control independently validates prediction machinery; cold-corpus runs whenever build artifacts are available — needs: [falsifier-build] alone, NOT selection-control — so a selector RED is a reason to run the broad backstop, not suppress it (specimen run 31181460723: selection failure skipped the entire corpus job). aggregate-verdict fails if either arm is red and emits gunbc.falsifier_cold_corpus_execution ColdCorpusExecution so CorpusNotRun is never read as 'falsifier found a regression'. Prior two-job split (2026-08-04) isolated cgroup peak for the floor path; this change isolates SELECTION from CORPUS scheduling."

data gunbc_falsifier_selection_control_relocation_note: String = "The affected-set selection control (ci_selection_control_step, authority gunbc.ci_workflow) rides this cadence as of 2026-07-29 — full rationale in gunbc_ci_selection_control_step_note. As of the 2026-08-07 four-job topology it lives in selection-control (needs: [falsifier-build]): AFTER artifact download/unpack, executes the release-built floor_skip_discovery_witness binary, in its own job cgroup separate from cold-corpus. cold-corpus brackets peak pre/post around falsifier_step only. Hermetic ~10m control still reds before the up-to-170m corpus walk."

data falsifier_aggregate_verdict_if: String = "always() && !cancelled()"

data falsifier_aggregate_verdict_shell_emit_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.falsifier_workflow",
    decl_name: "falsifier_aggregate_verdict_script",
    field: WholeDeclaration
  }
}

data falsifier_aggregate_verdict_shell_emit_dissolution_trigger: String = "🟡 dissolve-on: falsifier_aggregate_verdict_script — concat-built foreign-executor (GitHub Actions run:) aggregate cadence verdict shell; receipt JSON literals are derived from gunbc.falsifier_cold_corpus_execution classify_cold_corpus_execution / cold_corpus_execution_receipt_json, but the transport itself remains hand-shell; DISSOLVES WHEN bash-emit (#5828 / ROADMAP 6-shell-slice0 / shell→intent Phase 2) realizes the aggregate verdict step through orchestration emit or typed host_effect_apply without a medium-as-string concat scaffold"

fn falsifier_aggregate_verdict_write_receipt(json: String) -> String {
  concat(
    shell_printf_line(line: json),
    concat(" > ", concat(falsifier_cold_corpus_execution_receipt_path, "\n"))
  )
}

fn falsifier_aggregate_verdict_script() -> String {
  concat(
    concat("# ", concat(falsifier_aggregate_verdict_shell_emit_dissolution_trigger, "\n")),
    concat(
      "set -euo pipefail\n",
      concat(
        "mkdir -p target\n",
        concat(
          "BUILD_RESULT=\"${{ needs.falsifier-build.result }}\"\n",
          concat(
            "SELECTION_RESULT=\"${{ needs.selection-control.result }}\"\n",
            concat(
              "COLD_RESULT=\"${{ needs.cold-corpus.result }}\"\n",
              concat(
                concat(
                  "if [ \"$\{BUILD_RESULT}\" = \"cancelled\" ]; then\n",
                  concat(
                    falsifier_aggregate_verdict_write_receipt(json: aggregate_shell_receipt_build_cancelled()),
                    concat(
                      "  printf '%s\\n' \"::error::Cold corpus did not run — build cancelled; infrastructure, not a falsifier regression finding\"\n",
                      concat(
                        "  exit 1\n",
                        concat(
                          "fi\n",
                          concat(
                            concat(
                              "if [ \"$\{BUILD_RESULT}\" = \"skipped\" ]; then\n",
                              concat(
                                falsifier_aggregate_verdict_write_receipt(json: aggregate_shell_receipt_build_skipped()),
                                concat(
                                  "  printf '%s\\n' \"::error::Cold corpus did not run — build skipped; infrastructure, not a falsifier regression finding\"\n",
                                  concat(
                                    "  exit 1\n",
                                    concat(
                                      "fi\n",
                                      concat(
                                        concat(
                                          "if [ \"$\{BUILD_RESULT}\" != \"success\" ]; then\n",
                                          concat(
                                            falsifier_aggregate_verdict_write_receipt(json: aggregate_shell_receipt_build_failed()),
                                            concat(
                                              "  printf '%s\\n' \"::error::Cold corpus did not run — build unavailable ($\{BUILD_RESULT}); infrastructure, not a falsifier regression finding\"\n",
                                              concat(
                                                "  exit 1\n",
                                                concat(
                                                  "fi\n",
                                                  concat(
                                                    concat(
                                                      "if [ \"$\{COLD_RESULT}\" = \"skipped\" ]; then\n",
                                                      concat(
                                                        falsifier_aggregate_verdict_write_receipt(json: aggregate_shell_receipt_cold_skipped()),
                                                        concat(
                                                          "  printf '%s\\n' \"::error::Cold corpus skipped despite successful build — topology violation\"\n",
                                                          concat(
                                                            "  exit 1\n",
                                                            concat(
                                                              "fi\n",
                                                              concat(
                                                                concat(
                                                                  "if [ \"$\{COLD_RESULT}\" = \"cancelled\" ]; then\n",
                                                                  concat(
                                                                    falsifier_aggregate_verdict_write_receipt(json: aggregate_shell_receipt_cold_cancelled()),
                                                                    concat(
                                                                      "  printf '%s\\n' \"::error::Cold corpus cancelled — environment unavailability\"\n",
                                                                      concat(
                                                                        "  exit 1\n",
                                                                        concat(
                                                                          "fi\n",
                                                                          concat(
                                                                            concat(
                                                                              "FLOOR_RECEIPT_PRESENT=false\n",
                                                                              concat(
                                                                                concat(
                                                                                  "if [ -f target/floor-component-receipt.json ] && grep -q ",
                                                                                  concat(
                                                                                    floor_component_receipt_schema,
                                                                                    concat(
                                                                                      " target/floor-component-receipt.json ]; then\n",
                                                                                      concat(
                                                                                        "  FLOOR_RECEIPT_PRESENT=true\n",
                                                                                        concat(
                                                                                          "fi\n",
                                                                                          concat(
                                                                                            concat(
                                                                                              "if [ \"$\{FLOOR_RECEIPT_PRESENT}\" != true ]; then\n",
                                                                                              concat(
                                                                                                concat(
                                                                                                  "  if [ \"$\{COLD_RESULT}\" = \"success\" ]; then\n",
                                                                                                  concat(
                                                                                                    concat(
                                                                                                      "    ",
                                                                                                      concat(
                                                                                                        falsifier_aggregate_verdict_write_receipt(json: aggregate_shell_receipt_cold_receipt_artifact_absent()),
                                                                                                        concat(
                                                                                                          "    printf '%s\\n' \"::error::Cold corpus succeeded but floor-component receipt artifact absent — transport or emit failure, not a falsifier regression finding\"\n",
                                                                                                          concat(
                                                                                                            "    exit 1\n",
                                                                                                            concat(
                                                                                                              "  fi\n",
                                                                                                              concat(
                                                                                                                concat(
                                                                                                                  "  ",
                                                                                                                  concat(
                                                                                                                    falsifier_aggregate_verdict_write_receipt(json: aggregate_shell_receipt_cold_failed_before_receipt()),
                                                                                                                    concat(
                                                                                                                      "  printf '%s\\n' \"::error::Cold corpus did not produce floor-component receipt (cold=$\{COLD_RESULT}) — infrastructure, not a falsifier regression finding\"\n",
                                                                                                                      concat(
                                                                                                                        "  exit 1\n",
                                                                                                                        concat(
                                                                                                                          "fi\n",
                                                                                                                          concat(
                                                                                                                            concat(
                                                                                                                              "  ",
                                                                                                                              concat(
                                                                                                                                falsifier_aggregate_verdict_write_receipt(json: aggregate_shell_receipt_corpus_executed()),
                                                                                                                                concat(
                                                                                                                                  "if [ \"$\{SELECTION_RESULT}\" != \"success\" ] || [ \"$\{COLD_RESULT}\" != \"success\" ]; then\n",
                                                                                                                                  concat(
                                                                                                                                    "  printf '%s\\n' \"::error::Falsifier cadence red — selection=$\{SELECTION_RESULT} cold=$\{COLD_RESULT} (corpus executed; see target/falsifier-cold-corpus-execution.json)\"\n",
                                                                                                                                    concat(
                                                                                                                                      "  exit 1\n",
                                                                                                                                      concat(
                                                                                                                                        "fi\n",
                                                                                                                                        "printf '%s\\n' \"FalsifierCadenceVerdict: cadence-green\"\n"
                                                                                                                                      )
                                                                                                                                    )
                                                                                                                                  )
                                                                                                                                )
                                                                                                                              )
                                                                                                                            )
                                                                                                                          )
                                                                                                                        )
                                                                                                                      )
                                                                                                                    )
                                                                                                                  )
                                                                                                                )
                                                                                                              )
                                                                                                            )
                                                                                                          )
                                                                                                        )
                                                                                                      )
                                                                                                    )
                                                                                                  )
                                                                                                )
                                                                                              )
                                                                                            )
                                                                                          )
                                                                                        )
                                                                                      )
                                                                                    )
                                                                                  )
                                                                                )
                                                                              )
                                                                            )
                                                                          )
                                                                        )
                                                                      )
                                                                    )
                                                                  )
                                                                )
                                                              )
                                                            )
                                                          )
                                                        )
                                                      )
                                                    )
                                                  )
                                                )
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
}

fn falsifier_aggregate_verdict_shell_body() -> String {
  falsifier_aggregate_verdict_script()
}

fn falsifier_aggregate_verdict_step() -> Step {
  RunStep {
    name: Present { value: "Aggregate falsifier cadence verdict (typed cold-corpus execution)" },
    id: Present { value: "aggregate_verdict" },
    run: falsifier_aggregate_verdict_shell_body(),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_aux_step_timeout_minutes }
  }
}

fn falsifier_build_job() -> Job {
  Job {
    id: "falsifier-build",
    name: none,
    runner: gunbc_ci_selected_runner_spec(),
    steps: concat(ci_prelude_steps(), [ci_release_build_step(), ci_release_bins_pack_step(), ci_release_bins_upload_step()]),
    needs: [],
    env: none,
    outputs: none,
    if_condition: none,
    timeout_minutes: Present { value: gunbc_falsifier_build_job_backstop_timeout_minutes() },
    continue_on_error: none,
    concurrency: none,
    permissions: none
  }
}

fn falsifier_selection_control_job() -> Job {
  Job {
    id: "selection-control",
    name: none,
    runner: gunbc_ci_selected_runner_spec(),
    steps: concat(ci_floor_job_prelude_steps(), [ci_release_bins_download_step(), ci_release_bins_unpack_verify_step(), ci_selection_control_step()]),
    needs: ["falsifier-build"],
    env: none,
    outputs: none,
    if_condition: none,
    timeout_minutes: Present { value: gunbc_falsifier_selection_control_job_backstop_timeout_minutes() },
    continue_on_error: none,
    concurrency: none,
    permissions: none
