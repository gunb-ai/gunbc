type FalsifierStepTimeoutBasis {
  single_step_cap_minutes: Int
  prior_cap_minutes: Int
  current_cap_minutes: Int
  measurement_github_actions_run_id: NonEmptyStr
  not_algebraically_closed_from: NonEmptyStr
  dissolution_trigger: NonEmptyStr
}

data gunbc_falsifier_step_timeout_basis: FalsifierStepTimeoutBasis = FalsifierStepTimeoutBasis {
  single_step_cap_minutes: 170,
  prior_cap_minutes: 120,
  current_cap_minutes: 170,
  measurement_github_actions_run_id: "29135185172",
  not_algebraically_closed_from: "gunbc.ci_spec floor batch-clamp overheads (per-batch wall at execution time; no composed sum closes to the single-step cap)",
  dissolution_trigger: "gunbc.ci_spec batch-clamp overheads algebraically compose to gunbc_falsifier_step_timeout_minutes, replacing the measured-envelope basis"
}

data gunbc_falsifier_step_timeout_minutes: Int = 170

fn gunbc_falsifier_step_timeout_basis_is_measured_not_composed() -> Bool {
  match gunbc_falsifier_step_timeout_basis {
    FalsifierStepTimeoutBasis {
      single_step_cap_minutes: cap,
      prior_cap_minutes: 120,
      current_cap_minutes: 170,
      measurement_github_actions_run_id: run,
      not_algebraically_closed_from: _,
      dissolution_trigger: _
    } =>
      cap == gunbc_falsifier_step_timeout_minutes
        && run == "29135185172"
        && gunbc_falsifier_step_timeout_minutes == 170
  }
}

data gunbc_falsifier_receipt_flush_allowance_minutes: Int = 3

fn gunbc_falsifier_soft_deadline_minutes() -> Int {
  gunbc_falsifier_step_timeout_minutes - gunbc_falsifier_receipt_flush_allowance_minutes
}

fn gunbc_falsifier_soft_deadline_precedes_the_hard_kill() -> Bool {
  gunbc_falsifier_soft_deadline_minutes() < gunbc_falsifier_step_timeout_minutes
    && gunbc_falsifier_receipt_flush_allowance_minutes > 0
    && gunbc_falsifier_soft_deadline_minutes() > 0
}

data gunbc_falsifier_soft_deadline_note: String = "THE INTERNAL DEADLINE, DERIVED FROM THE FOREIGN ONE — never a second independently authored number. gunbc_falsifier_step_timeout_minutes is a GitHub Actions step timeout: a SIGKILL delivered by the runner, which the executor cannot catch, cannot log, and cannot conclude through. Crossing it destroyed the run's evidence (the receipt was written once, after every batch), so the one failure mode most in need of a diagnosis was the one that erased its own. The checkpoint now keeps completed components' state on disk; this row is the other half — stop ADMITTING work early enough that the walk concludes itself, on its own terms, with a typed disposition per component, instead of vanishing mid-flight. The allowance is what the walk needs after its last batch to finish the receipt and let the artifact upload step run: the receipt write is a resolve (memoized, so paid once earlier in the run) plus a document eval over single-digit component rows, which is seconds, and 3 minutes is that with room for a loaded runner rather than a measured envelope. THE SUBTRACTION IS THE POINT: raising the step cap moves the soft deadline with it and the two can never cross, which is what makes this a derivation rather than the tuned second knob a bare 167 would be. IT IS NOT A COST BOUND AND MUST NOT BE READ AS ONE. Reaching it means the corpus did not finish in the time the lane has — a DeadlineReached disposition on every unadmitted component, counted, with the run red. That is a measurement of a cost problem, not a resolution of one, and the remedy stays what DESIGN's five-minute-CI-gate lane says it is: remove redundant computation, never raise the cap first."

data gunbc_falsifier_step_timeout_note: String = "120 -> 170 (2026-07-11, run 29135185172 receipt): the first corpus-reaching cold run was TIME-killed at the 120-min step ceiling with the corpus incomplete (1970 rows, closure 1396 modules, width 1) and floor peak 16146612224 bytes against a 16GiB slot budget, still growing - so 120 censored the measurement without bounding anything real (the memory cap is the true wall). 170 lets a nightly run reach either completion (exact-labeled receipt) or the cap kill (censored-labeled receipt); both are the falsifier doing its measurement job, and the job backstop DERIVES from this value so it stretches in step. Revisit down when the resolver graph-major module split (S2a move 2) shrinks cold-resolve wall and residency."

data falsifier_plan_function: String = plan_function_name(p: FalsifierPlan)

fn falsifier_invoke() -> String {
  concat(
    concat("ROOT=", concat(ci_repo_root_shell(), "\n")),
    claim_executor_run_plan_shell(
      source_roots: witness_layer_roots,
      plan_entry: "src/v2/workflow/ci_floor_plan.dag",
      plan_function: FalsifierPlan,
      notice_title: Absent,
      rooted: false
    )
  )
}

fn falsifier_step() -> Step {
  RunStep {
    name: Present { value: "affected-set falsifier (predict-only cold run)" },
    id: Present { value: "floor" },
    run: falsifier_invoke(),
    shell: none,
    env: Present {
      value: [
        kv(key: "GUNBC_CI_DIFF_BASE", value: yaml_string(s: "HEAD~20")),
        kv(key: "GUNBC_CI_DIFF_HEAD", value: yaml_string(s: "HEAD")),
        kv(key: ci_floor_phase_journal_env_name, value: yaml_string(s: ci_floor_phase_journal_path))
      ]
    },
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_falsifier_step_timeout_minutes }
  }
}

data falsifier_native_cache_cold_plan_target_note: String = "THE STEP WHOSE PLAN TARGET ESCAPED THE #7470 MIGRATION, kept as the receipt for why the target is now a typed variant instead of an argv token. Every other consumer derived its plan name from a constant, so the 2026-07-30 WalkPlan rename reached all four automatically; this step alone passed the inline literal \"gunbc_falsifier_native_cache_cold_batches\", derived from nothing, and was left behind returning a bare List<List<Runnable>>. The executor's strict parser then refused it on every one of the 8 falsifier runs that armed this step (0 successes), and it read as intermittent only because the step is skipped whenever the falsifier step fails first.\n\nThe first repair here added a naming constant beside the other four. That was still validation — it made the rename reach this site but left the next author free to type a fresh literal. The constant was therefore DELETED in the same change that introduced gunbc.cli_invoke PlanFunction: an inline literal at this argument is now a type error, so the roster is closed by construction and a String projection with no consumer would be exactly the inert carrier §2 forbids. Dissolution-on-climb (§4b): the wall replaces the lower-rung machinery rather than accumulating beside it."

data floor_component_receipt_upload_note: String = "Uploads the floor's per-component receipt so the alert workflow can READ which component failed instead of inferring one hardcoded story from the overall run conclusion (gunbc.floor_component_receipt carries the priced defect). if: always() is load-bearing and is the whole point: the receipt matters MOST on a red run, and a red floor step would otherwise skip the upload and leave the alert blind — which is the state that produced the false 'affected-set cold control is dark' claim on run 30509024051. It sits immediately after falsifier_step so it captures that step's receipt. F0 (2026-08-04): compile-clean and native-cache cold controls now use falsifier_control_prerequisite_if (always + release_build success) in gunbc.falsifier_run_control — they execute after the floor concludes, not only when it succeeds. if-no-files-found: error, because a silently absent receipt is the same blindness one layer down; the alert's own missing-artifact arm reports an explicit unknown rather than re-widening. Its transfer term joins gunbc_falsifier_job_backstop_timeout_minutes so the backstop stays the exact step-sum + prelude (the invariant falsifier_workflow_witness_test asserts)."

fn floor_component_receipt_upload_step() -> Step {
  UsesStep {
    name: Present { value: "Upload floor component receipt (read by falsifier-alert)" },
    id: none,
    uses: upload_artifact_action,
    with: Present {
      value: [
        kv(key: "name", value: yaml_string(s: floor_component_receipt_artifact_name)),
        kv(key: "path", value: yaml_string(s: floor_component_receipt_path)),
        kv(key: "if-no-files-found", value: yaml_string(s: "error")),
        kv(key: "retention-days", value: yaml_int(n: 30)),
        kv(key: "compression-level", value: yaml_int(n: 0))
      ]
    },
    env: none,
    if_condition: Present { value: "always()" },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_artifact_transfer_step_timeout_minutes }
  }
}

fn gunbc_falsifier_build_job_backstop_timeout_minutes() -> Int {
  gunbc_ci_release_build_step_timeout_minutes + gunbc_ci_selection_control_step_timeout_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc_ci_artifact_transfer_step_timeout_minutes + gunbc_ci_prelude_allowance_minutes
}

fn gunbc_falsifier_floor_job_backstop_timeout_minutes() -> Int {
  gunbc_ci_artifact_transfer_step_timeout_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc_falsifier_step_timeout_minutes + gunbc_ci_artifact_transfer_step_timeout_minutes + gunbc_falsifier_compile_clean_cold_control_timeout_minutes + gunbc_falsifier_native_cache_cold_control_timeout_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc_ci_prelude_allowance_minutes
}

fn gunbc_falsifier_job_backstop_timeout_minutes() -> Int {
  gunbc_falsifier_build_job_backstop_timeout_minutes() + gunbc_falsifier_floor_job_backstop_timeout_minutes()
}

data gunbc_falsifier_job_split_note: String = "Two-job split (2026-08-04, falsifier-memory-root-cause diagnosis): the monolith job pinned cgroup peak at the 15 GiB memory.high line because ~9.5 GiB from release build + selection control stayed resident in the job cgroup before claim_executor started (floor_peak_pre reset=unsupported pre_peak=10219753472, run 30935833427). Mirrors the 2026-07-11 ci build→ci serial split (gunbc_ci_job_backstop_timeout_disposition): falsifier-build compiles, runs the selection control, packs, and uploads release-bins; falsifier downloads + verifies in a fresh job cgroup so peak pre/post bracket ONLY the floor path. Dissolve-on: persistent content-keyed node store removes the per-entry cold resolve class and makes the double whole-pool index payment optional — not a substitute for job-grain cgroup isolation."

data gunbc_falsifier_selection_control_relocation_note: String = "The affected-set selection control (ci_selection_control_step, authority gunbc.ci_workflow) rides this cadence as of 2026-07-29, demoted from the per-PR ci job — full rationale, measurement, and return trigger in gunbc_ci_selection_control_step_note. Placement is load-bearing on three counts. (1) AFTER ci_release_build_step in falsifier-build: the control executes the release-built floor_skip_discovery_witness binary. (2) BEFORE ci_floor_peak_pre_step in falsifier (floor job): the peak pre/post pair brackets the floor's cgroup measurement — with the 2026-08-04 job split the control's ~9.5 GiB carry-in lives in falsifier-build's cgroup, not the floor job's. (3) BEFORE falsifier_step: the control is hermetic and ~10m, the falsifier step is up to 170m, so a broken selector reds in minutes instead of after the corpus walk. Its 15m term is in gunbc_falsifier_build_job_backstop_timeout_minutes; the floor job backstop carries only the floor path."

fn falsifier_build_job() -> Job {
  Job {
    id: "falsifier-build",
    name: none,
    runner: gunbc_ci_selected_runner_spec(),
    steps: concat(ci_prelude_steps(), [ci_release_build_step(), ci_selection_control_step(), ci_release_bins_pack_step(), ci_release_bins_upload_step()]),
    needs: [],
    env: none,
    outputs: none,
    if_condition: none,
    timeout_minutes: Present { value: gunbc_falsifier_build_job_backstop_timeout_minutes() },
    continue_on_error: none,
    concurrency: none,
    permissions: none
  }
}

fn falsifier_floor_job() -> Job {
  Job {
    id: "falsifier",
    name: none,
    runner: gunbc_ci_selected_runner_spec(),
    steps: concat(ci_floor_job_prelude_steps(), [ci_release_bins_download_step(), ci_release_bins_unpack_verify_step(), ci_floor_peak_pre_step(), falsifier_step(), floor_component_receipt_upload_step(), compile_clean_cold_control_step(), native_cache_cold_control_step(), ci_floor_peak_post_step()]),
    needs: ["falsifier-build"],
    env: none,
    outputs: none,
    if_condition: none,
    timeout_minutes: Present { value: gunbc_falsifier_floor_job_backstop_timeout_minutes() },
    continue_on_error: none,
    concurrency: none,
    permissions: none
  }
}

data falsifier_cadence_note: String = "nightly (0 7 * * *) -> every 4h (operator ruling 2026-07-14): a once-daily divergence receipt goes unread; a 4h cadence makes the cold-run receipt a same-day dial. Overlap is handled structurally, not assumed away: the job backstop (230-min class) can tail past a 240-min period, so the workflow carries a queue-not-cancel concurrency group - a scheduled run firing while one is live QUEUES rather than killing a measuring run mid-corpus."

data falsifier_cadence_cron: CronSchedule = CronSchedule {
  minute: Exact { value: 0 },
  hour: Listed { values: [0, 4, 8, 12, 16, 20] },
  day_of_month: Wildcard,
  month: Wildcard,
  day_of_week: Wildcard
}

data falsifier_workflow: Workflow = {
  name: "affected-set-falsifier",
  on: [
    WorkflowDispatch { inputs: [] },
    Schedule { cron: falsifier_cadence_cron }
  ],
  concurrency: Present {
    value: ConcurrencyMappingQueueNotMax {
      group: "affected-set-falsifier",
      cancel_in_progress: Present { value: CancelInProgressBool { value: false } },
      explicit_single: none
    }
  },
  env: Present {
    value: [kv(key: "CARGO_TERM_COLOR", value: yaml_string(s: "always"))]
  },
  permissions: Present {
    value: WorkflowPermissions {
      contents: Present { value: PermRead },
      pull_requests: none,
      issues: none,
      actions: none,
      id_token: none
    }
  },
  jobs: [falsifier_build_job(), falsifier_floor_job()]
}

fn expected_falsifier_yml() -> String {
  serialize_yaml(v: project_workflow_to_yaml(workflow: falsifier_workflow))
}
