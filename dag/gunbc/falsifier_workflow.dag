fn falsifier_aggregate_verdict_job() -> Job {
  Job {
    id: "aggregate-verdict",
    name: none,
    runner: gunbc_ci_selected_runner_spec(),
    steps: [falsifier_floor_component_receipt_download_step(), falsifier_aggregate_verdict_step()],
