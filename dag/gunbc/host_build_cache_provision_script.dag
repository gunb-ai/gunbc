module gunbc.host_build_cache_provision_script

import std.types { String, Bool }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.shell_bash_runner { shell_exec_via_bash }
import extdeps.cache.sccache {
  sccache_fatal_error_log_fragment,
  sccache_rustc_wrapper_exit_254_log_fragment,
  sccache_failed_to_execute_compile_log_fragment,
}

data host_build_cache_provision_script_dissolution_trigger: String = "🟡 dissolve-on: host_build_cache_provision_script — concat-built systemd/sccache ensure shell; DISSOLVES WHEN bash-emit (#5828) realizes ProvisionBuildCache observe/ensure/read-back as typed host-effect argv and realize_provision_build_cache retires shell_exec_via_bash transport."

data host_build_cache_provision_script_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.host_build_cache_provision_script",
    decl_name: "host_build_cache_provision_script_dissolution_trigger",
    field: WholeDeclaration,
  }
}

data build_cache_systemd_user_unit_path: String = ".config/systemd/user/sccache.service"

data build_cache_systemd_user_unit_body: String = "[Unit]\nDescription=sccache compiler cache (gunbc host standup)\nAfter=network.target\n\n[Service]\nType=simple\nExecStart=/usr/bin/sccache --start-server\nRestart=on-failure\n\n[Install]\nWantedBy=default.target\n"

data build_cache_placement_observe_doc: String = "PLACEMENT IS OBSERVED, NOT ASSUMED. A responsive server proves nothing about where it runs: the srv1 incident had a perfectly responsive server answering --show-stats from dead slot srv1-10's cgroup while every compile on the host inherited that slot's 16G cap. So a stats-ok observation is NOT a success exit — it is followed by reading the server's own cgroup out of /proc and comparing it to the managed slice. Unreadable placement REFUSES (exit 1) rather than assuming unit-owned: an unobservable placement is ignorance, not evidence of correctness. AMBIGUITY REFUSES RATHER THAN GUESSING: the sccache binary is ALSO the client, so under RUSTC_WRAPPER an in-flight compile leaves several processes named 'sccache'. Taking an arbitrary one would read a transient client's cgroup and produce a FALSE refusal. So the arm requires EXACTLY ONE candidate and refuses (counted, with the observed count) otherwise. This observation runs at provisioning/converge time, when no compile should be in flight, so exactly-one is the expected state and >1 is genuine ambiguity. A port-listener probe (SCCACHE_SERVER_PORT, cited in extdeps) would be strictly more precise and is the intended successor; it is NOT used here because `ss` is absent in the container this was verified in, and an unexecutable probe is worse than an imprecise verified one."

data build_cache_managed_slice_unit: String = "gunbc-compile-pool.slice"

fn build_cache_observe_placement_body() -> String {
  concat(
    concat(
      "sccache_pids=\"$(pgrep -x sccache 2>/dev/null || true)\"\n",
      concat(
        "sccache_count=\"$(printf '%s' \"$sccache_pids\" | grep -c . || true)\"\n",
        concat(
          "if [ \"$sccache_count\" -gt 1 ]; then\n",
          concat(
            "  printf '%s\\n' \"BuildCacheProvisionReceipt: placement=unknown detail=ambiguous-multiple-sccache-processes count=$sccache_count\"\n",
            concat(
              "  printf '%s\\n' \"REFUSED: the sccache binary is also the client, so a compile in flight yields several processes named sccache; refusing rather than reading an arbitrary one's cgroup\"\n  exit 1\n",
              "fi\nserver_pid=\"$(printf '%s' \"$sccache_pids\" | head -1)\"\n",
            )
          )
        )
      )
    ),
    concat(
      "if [ -z \"$server_pid\" ]; then\n",
      concat(
        "  printf '%s\\n' \"BuildCacheProvisionReceipt: placement=unknown detail=no-sccache-server-process\"\n  exit 1\n",
        concat(
          "fi\n",
          concat(
            "server_cgroup=\"$(cat /proc/$server_pid/cgroup 2>/dev/null | head -1 || true)\"\n",
            concat(
              "if [ -z \"$server_cgroup\" ]; then\n",
              concat(
                "  printf '%s\\n' \"BuildCacheProvisionReceipt: placement=unknown detail=cgroup-unreadable\"\n  exit 1\n",
                concat(
                  "fi\n",
                  concat(
                    concat("if printf '%s' \"$server_cgroup\" | grep -Fq \"", build_cache_managed_slice_unit, "\"; then\n"),
                    concat(
                      concat("  printf '%s\\n' \"BuildCacheProvisionReceipt: placement=unit_owned slice=", build_cache_managed_slice_unit, "\"\n  exit 0\n"),
                      "else\n  printf '%s\\n' \"BuildCacheProvisionReceipt: placement=lazy_spawned cgroup=$server_cgroup\"\n  printf '%s\\n' \"REFUSED: sccache server is responsive but not unit-owned; cache-miss compiles execute as its children, so this cgroup's caps bound every compile on the host\"\n  exit 1\nfi\n",
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
}

fn build_cache_observe_stats_body() -> String {
  concat(
    "stats_rc=0\n",
    concat(
      "stats_out=\"$(sccache --show-stats 2>&1)\" || stats_rc=$?\n",
      concat(
        "if [ \"$stats_rc\" -eq 0 ]; then\n",
        concat(
          "  printf '%s\\n' \"BuildCacheProvisionReceipt: observe=ok\"\n",
          concat(
            "  printf '%s\\n' \"$stats_out\"\n",
            concat(
              build_cache_observe_placement_body(),
              "fi\n",
            )
          )
        )
      )
    )
  )
}

fn build_cache_classify_failure_body() -> String {
  concat(
    concat(
      concat(
        "if printf '%s' \"$stats_out\" | grep -Fq ",
        concat("\"", sccache_fatal_error_log_fragment),
      ),
      "\"; then\n",
    ),
    concat(
      concat(
        concat(
          "  printf '%s\\n' \"BuildCacheProvisionReceipt: observe=misconfigured fragment=",
          sccache_fatal_error_log_fragment,
        ),
        "\"\n",
      ),
      concat(
        concat(
          concat(
            "elif printf '%s' \"$stats_out\" | grep -Fq ",
            concat("\"", sccache_rustc_wrapper_exit_254_log_fragment),
          ),
          "\"; then\n",
        ),
        concat(
          concat(
            concat(
              "  printf '%s\\n' \"BuildCacheProvisionReceipt: observe=misconfigured fragment=",
              sccache_rustc_wrapper_exit_254_log_fragment,
            ),
            "\"\n",
          ),
          concat(
            concat(
              concat(
                "elif printf '%s' \"$stats_out\" | grep -Fq ",
                concat("\"", sccache_failed_to_execute_compile_log_fragment),
              ),
              "\"; then\n",
            ),
            concat(
              concat(
                concat(
                  "  printf '%s\\n' \"BuildCacheProvisionReceipt: observe=misconfigured fragment=",
                  sccache_failed_to_execute_compile_log_fragment,
                ),
                "\"\n",
              ),
              "else\n  printf '%s\\n' \"BuildCacheProvisionReceipt: observe=unresponsive\"\nfi\n"
            )
          )
        )
      )
    )
  )
}

fn build_cache_ensure_daemon_body() -> String {
  concat(
    "if ! command -v sccache >/dev/null 2>&1; then\n",
    concat(
      "  sudo -n apt-get update -qq && sudo -n apt-get install -y sccache\n",
      concat(
        "fi\n",
        concat(
          concat("mkdir -p \"$(dirname ", build_cache_systemd_user_unit_path, ")\""),
          concat(
            "\n",
            concat(
              concat("cat > ", build_cache_systemd_user_unit_path, " <<'__GUNBC_SCCACHE_UNIT__'\n"),
              concat(
                build_cache_systemd_user_unit_body,
                concat(
                  "__GUNBC_SCCACHE_UNIT__\n",
                  "systemctl --user daemon-reload\nsystemctl --user enable --now sccache.service\n",
                )
              )
            )
          )
        )
      )
    )
  )
}

fn build_cache_read_back_body() -> String {
  concat(
    "if stats_out=\"$(sccache --show-stats 2>&1)\"; then\n",
    concat(
      "  printf '%s\\n' \"BuildCacheProvisionReceipt: read_back=ok\"\n",
      concat(
        "  printf '%s\\n' \"$stats_out\"\n",
        concat(
          "  exit 0\n",
          concat(
            "else\n",
            concat(
              "  printf '%s\\n' \"BuildCacheProvisionReceipt: read_back=FAILED sccache unhealthy after ensure\"\n",
              concat(
                "  printf '%s\\n' \"$stats_out\"\n",
                "  exit 1\nfi\n",
              )
            )
          )
        )
      )
    )
  )
}

fn build_cache_provision_script_body() -> String {
  concat(
    "set -euo pipefail\n",
    concat(
      build_cache_observe_stats_body(),
      concat(
        build_cache_classify_failure_body(),
        concat(
          "printf '%s\\n' \"BuildCacheProvisionReceipt: ensure=starting\"\n",
          concat(
            build_cache_ensure_daemon_body(),
            build_cache_read_back_body(),
          )
        )
      )
    )
  )
}

fn build_cache_provision_read_back_fails_closed() -> Bool {
  string_contains(
    s: build_cache_read_back_body(),
    pattern: "read_back=FAILED",
  ) && string_contains(
    s: build_cache_read_back_body(),
    pattern: "exit 1",
  ) && !string_contains(
    s: build_cache_read_back_body(),
    pattern: "stats_rc",
  )
}

fn build_cache_provision_placement_fails_closed() -> Bool {
  string_contains(s: build_cache_observe_placement_body(), pattern: "placement=lazy_spawned")
    && string_contains(s: build_cache_observe_placement_body(), pattern: "placement=unknown detail=cgroup-unreadable")
    && string_contains(s: build_cache_observe_placement_body(), pattern: "placement=unknown detail=no-sccache-server-process")
    && string_contains(s: build_cache_observe_placement_body(), pattern: "placement=unknown detail=ambiguous-multiple-sccache-processes")
    && string_contains(s: build_cache_observe_placement_body(), pattern: "/proc/$server_pid/cgroup")
}

fn build_cache_provision_stats_ok_is_not_success_alone() -> Bool {
  string_contains(s: build_cache_observe_stats_body(), pattern: "observe=ok")
    && string_contains(s: build_cache_observe_stats_body(), pattern: "placement=lazy_spawned")
}

fn build_cache_provision_shell_script() -> String {
  shell_exec_via_bash(body: build_cache_provision_script_body())
}
