module gunbc.host_build_cache_provision_script

import std.types { String, NonEmptyStr, Bool, List }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.crypto.hash { Digest }
import gunbc.shell_bash_runner { shell_exec_via_bash }
import extdeps.cache.sccache {
  sccache_misconfigured_log_fragments,
  sccache_installed_binary_path,
  sccache_install_script,
  sccache_release_0_15_0,
  sccache_start_server_env_assignment,
  sccache_no_daemon_env_assignment,
  sccache_idle_timeout_never_env_assignment,
}

data host_build_cache_provision_script_dissolution_trigger: String = "🟡 dissolve-on: host_build_cache_provision_script — concat-built systemd/sccache ensure shell; DISSOLVES WHEN bash-emit (#5828) realizes ProvisionBuildCache observe/ensure/read-back as typed host-effect argv and realize_provision_build_cache retires shell_exec_via_bash transport."

data host_build_cache_provision_script_census_row_note: String = "CENSUS STANDING: docs/plans/shell-to-dag-residual-census-and-arc-completion.md §4.A keys this file as the builder for host_effect_realize.ProvisionBuildCache, action DECOMPOSE, sub-class A5 (srv* cluster, deferred by operator 2026-07-22 — real debt, NOT done; un-defer trigger is the operator). This site is RUNTIME-PRESENT (it realizes through host_effect_apply_gated on LocalShell/SshShell), so per that doc's routing decision its end state is a typed effect-plan with NO bash emitted — the six *_body builders below are the debt, not the design. Standing constraint while the row is deferred, stated precisely (review 42401 sharpened this): NEW emitted shell must be either a DEDUCTION or a cited-de-fork SWAP — never an unbounded, uncited addition. Two exact deltas this PR made, both accounted: (1) the sccache DE-FORK swap — `apt-get install sccache` + an `ExecStart=/usr/bin/sccache` unit went OUT, and the cited-tarball install invocation (sccache_install_script, one authority row) came IN; that is the §3 fork removal this PR exists to make, a swap that de-duplicates rather than grows. (2) `sudo -n loginctl enable-linger \"$USER\"` is genuinely NEW shell, not a swap — acknowledged here as growth rather than hidden: it is the one primitive that makes the already-selected user-scope systemd handler viable at all (a `--user` manager is torn down with the login otherwise), justified in build_cache_user_service_linger_note, and it is bounded (a single fixed leaf, not a corpus-denominated fold). What must NOT grow is the PATH-shadow OBSERVATION: the judgement went to gunbc.host_build_cache_provision (DaemonPathShadowed / RefusalPathShadowed + verdict fold, witnessed against a synthetic observation), and its live shell observation is STAGED, NOT emitted here — an earlier attempt folded `command -v sccache` lines into the two existing bodies, which kept the builder count at six but still grew the shell surface (review 42343 rejected that as a census regression). The observation lands when ProvisionBuildCache realizes as typed argv (dissolve-on #5828). Adding a *_body, or an uncited emitted-shell leaf that is neither a deduction nor a de-fork swap, is a census regression even when the behaviour it adds is correct. FOLLOW-UP #7206 delta (correctness swap, accounted): the unit's `ExecStart=... --start-server` became bare `ExecStart=...` + two `Environment=` lines (SCCACHE_START_SERVER=1 / SCCACHE_NO_DAEMON=1) — net +1 line, and NOT uncited growth: it is a swap toward the production ctrl-sccache.service invocation (the single authority the whole lane converges on), replacing a form live execution on srv3 proved is a Type=simple no-op (build_cache_unit_foreground_supervision_note). A correctness swap toward the cited production authority is the sanctioned shape, exactly like delta (1). FOLLOW-UP #7 delta (DEDUCTION, accounted): one further `Environment=` line, SCCACHE_IDLE_TIMEOUT=0, net +1 emitted line. This one is NOT a swap toward production — srv1/srv2 do not set the knob either — so it is accounted as the other sanctioned shape, a DEDUCTION: it follows from the cited upstream authority (Configuration.md, extdeps.cache.sccache.sccache_server_lifetime_note) plus the srv3 receipt that the foreground unit exits 0 after 10min 8s idle, and it is the minimal line that makes Type=simple supervision hold at all. It also SHRINKS this file's ownership of vocabulary it does not own: all three Environment values now come from extdeps rows (sccache_start_server_env_assignment / sccache_no_daemon_env_assignment / sccache_idle_timeout_never_env_assignment) instead of bare literals spelled here, so gunbc is no longer a second authority for sccache env var names (§3). The supervision OBSERVATION (`systemctl --user is-active`) is STAGED, not emitted, on exactly the PATH-shadow precedent — the judgement lives in gunbc.host_build_cache_provision (DaemonUnsupervised / RefusalDaemonUnsupervised, witnessed against a synthetic observation) and the live producer waits for typed argv (dissolve-on #5828)."

data host_build_cache_provision_script_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.host_build_cache_provision_script",
    decl_name: "host_build_cache_provision_script_dissolution_trigger",
    field: WholeDeclaration,
  }
}

data build_cache_install_authority_note: String = "The ensure arm installs sccache by calling the cited authority extdeps.cache.sccache.sccache_install_script (pinned release, per-arch sha256 verified, landing at sccache_installed_binary_path) — it does NOT hand-roll a package-manager install. Until 2026-07-24 this module ran `sudo -n apt-get install -y sccache` and wrote a unit with ExecStart=/usr/bin/sccache, a §3 fork of the same concept: P1:runner-deploy-slot installs the pinned tarball to /usr/local/bin and then P1b:build-cache-provision pointed its unit at a path that install never creates, so the daemon could not start and the read-back refused. Both the install and the unit now read ONE path row, so the two phases cannot disagree."

data build_cache_systemd_user_unit_path: String = "$HOME/.config/systemd/user/sccache.service"

fn build_cache_systemd_user_unit_body() -> String {
  join([
    "[Unit]",
    "Description=sccache compiler cache (gunbc host standup)",
    "After=network.target",
    "",
    "[Service]",
    "Type=simple",
    join(["Environment=", sccache_start_server_env_assignment()], ""),
    join(["Environment=", sccache_no_daemon_env_assignment()], ""),
    join(["ExecStart=", sccache_installed_binary_path], ""),
    "Restart=on-failure",
    "",
    "[Install]",
    "WantedBy=default.target",
    "",
  ], "\n")
}

data build_cache_path_authority_note: String = "The PATH-shadow JUDGEMENT lives in the model — gunbc.host_build_cache_provision.DaemonPathShadowed / RefusalPathShadowed and the verdict fold that refuses it, proven by design_witness_path_shadow_refuses_fail_closed against a synthetic DaemonPathShadowed observation. Its LIVE OBSERVATION is STAGED, deliberately NOT emitted as hand-shell here: this file is an A5 `decompose` scaffold that the census pledges may SHRINK but must not GROW (dissolve-on #5828), and a `command -v sccache` observation folded into the bodies still GROWS the emitted shell surface — a census regression even though the model verdict it feeds is correct (review 42343 caught this; the earlier 'folded in, count six' defense counted *_body builders, not the shell surface). The observation lands when ProvisionBuildCache realizes as typed host-effect argv (this module's own dissolve-on): the resolve becomes a typed op (shell.Which.Check) and the comparison a typed predicate over captured values (the deploy-preflight `whoami` precedent: a negated StrEq, never a minted StrNeq). Until then the model carries the state and its refusal; only the live producer is deferred."

fn build_cache_observe_stats_body() -> String {
  join([
    "stats_out=\"\"",
    "stats_rc=0",
    join(["if [ -x '", sccache_installed_binary_path, "' ]; then"], ""),
    join(["  stats_out=\"$('", sccache_installed_binary_path, "' --show-stats 2>&1)\" || stats_rc=$?"], ""),
    "else",
    "  printf '%s\\n' \"BuildCacheProvisionReceipt: observe=absent\"",
    "  stats_rc=127",
    "fi",
    "if [ \"$stats_rc\" -eq 0 ]; then",
    "  printf '%s\\n' \"BuildCacheProvisionReceipt: observe=ok\"",
    "  printf '%s\\n' \"$stats_out\"",
    "  exit 0",
    "fi",
    "",
  ], "\n")
}

fn build_cache_fragment_word(fragment: String) -> String {
  join(["'", fragment, "'"], "")
}

fn build_cache_fragment_words() -> String {
  join(
    map(sccache_misconfigured_log_fragments, f => build_cache_fragment_word(fragment: f)),
    " ",
  )
}

data build_cache_classify_fold_note: String = "The misconfigured-fragment classifier is a FOLD over the cited roster extdeps.cache.sccache.sccache_misconfigured_log_fragments, not one emitted branch per fragment. It was a hand-unrolled 3-way if/elif chain until 2026-07-24, which meant the emitter named each cited fragment individually and a fourth citation could not take effect without an edit here. The roster is now data the loop iterates: adding a fragment upstream changes the emitted word list and nothing else. Fragments are single-quoted as shell words, which is total only while no fragment contains a single quote — build_cache_fragment_words_are_shell_safe() is the construction check that keeps it so."

fn build_cache_classify_failure_body() -> String {
  join([
    "observe_class=unresponsive",
    "observe_fragment=\"\"",
    join(["for frag in ", build_cache_fragment_words(), "; do"], ""),
    "  if printf '%s' \"$stats_out\" | grep -Fq \"$frag\"; then",
    "    observe_class=misconfigured",
    "    observe_fragment=\"$frag\"",
    "    break",
    "  fi",
    "done",
    "if [ \"$observe_class\" = misconfigured ]; then",
    "  printf '%s\\n' \"BuildCacheProvisionReceipt: observe=misconfigured fragment=$observe_fragment\"",
    "else",
    "  printf '%s\\n' \"BuildCacheProvisionReceipt: observe=unresponsive\"",
    "fi",
    "",
  ], "\n")
}

fn build_cache_ensure_daemon_body(arch_token: NonEmptyStr, digest: Digest) -> String {
  join([
    join(["if [ ! -x '", sccache_installed_binary_path, "' ]; then"], ""),
    sccache_install_script(rel: sccache_release_0_15_0, arch: arch_token, digest: digest),
    "fi",
    join(["mkdir -p \"$(dirname \"", build_cache_systemd_user_unit_path, "\")\""], ""),
    join(["cat > \"", build_cache_systemd_user_unit_path, "\" <<'__GUNBC_SCCACHE_UNIT__'"], ""),
    build_cache_systemd_user_unit_body(),
    "__GUNBC_SCCACHE_UNIT__",
    "sudo -n loginctl enable-linger \"$USER\"",
    "systemctl --user daemon-reload",
    "systemctl --user enable --now sccache.service",
    "",
  ], "\n")
}

data build_cache_user_service_linger_note: String = "A `systemd --user` manager is torn down when the user's last session ends, so on a headless runner host an enabled user unit stops the moment the provisioning ssh connection closes — the daemon would be observed healthy by the read-back in the same connection and be gone before the first CI job. enable-linger keeps the manager running without a login, which is what makes the user-scope handler viable at all. It does NOT settle open question 1 of the srvN build-cache design (user service vs system service for the shared daemon) — that handler choice is still operator-open; this only makes the handler already selected in tree behave as modeled."

fn build_cache_read_back_body(binary: String) -> String {
  join([
    join(["if stats_out=\"$('", binary, "' --show-stats 2>&1)\"; then"], ""),
    "  printf '%s\\n' \"BuildCacheProvisionReceipt: read_back=ok\"",
    "  printf '%s\\n' \"$stats_out\"",
    "  exit 0",
    "else",
    "  printf '%s\\n' \"BuildCacheProvisionReceipt: read_back=FAILED sccache unhealthy after ensure\"",
    "  printf '%s\\n' \"$stats_out\"",
    "  exit 1",
    "fi",
    "",
  ], "\n")
}

fn build_cache_provision_script_body(arch_token: NonEmptyStr, digest: Digest) -> String {
  join([
    "set -euo pipefail",
    build_cache_observe_stats_body(),
    build_cache_classify_failure_body(),
    "printf '%s\\n' \"BuildCacheProvisionReceipt: ensure=starting\"",
    build_cache_ensure_daemon_body(arch_token: arch_token, digest: digest),
    build_cache_read_back_body(binary: sccache_installed_binary_path),
  ], "\n")
}

fn build_cache_provision_read_back_fails_closed() -> Bool {
  let body = build_cache_read_back_body(binary: sccache_installed_binary_path)
  string_contains(s: body, pattern: "read_back=FAILED")
    && string_contains(s: body, pattern: "exit 1")
    && !string_contains(s: body, pattern: "stats_rc")
}

fn build_cache_fragment_words_are_shell_safe() -> Bool {
  fold(
    sccache_misconfigured_log_fragments,
    init: true,
    f: (acc, frag) => acc && !string_contains(s: frag, pattern: "'"),
  )
}

fn build_cache_install_is_cited_not_package_manager() -> Bool {
  let body = build_cache_provision_script_body(
    arch_token: "aarch64" as NonEmptyStr,
    digest: sccache_release_0_15_0.digest_aarch64,
  )
  string_contains(s: body, pattern: "github.com/mozilla/sccache/releases/download/")
    && string_contains(s: body, pattern: sccache_release_0_15_0.version as String)
    && !string_contains(s: body, pattern: "apt-get install")
    && !string_contains(s: body, pattern: "/usr/bin/sccache")
}

fn build_cache_unit_execstart_matches_install_path() -> Bool {
  string_contains(
    s: build_cache_systemd_user_unit_body(),
    pattern: join(["ExecStart=", sccache_installed_binary_path], ""),
  )
}

data build_cache_unit_foreground_supervision_note: String = "The unit is Type=simple, so systemd tracks the ExecStart process AS the service — it MUST stay in the foreground. `sccache --start-server` DAEMONIZES and returns 0, so under Type=simple systemd sees the ExecStart exit cleanly and marks the unit `inactive (dead)` the instant it starts; the backgrounded server then idle-times-out unsupervised and Restart=on-failure never fires (the exit was success). Proven live on srv3 2026-07-25: the earlier `--start-server` form left the unit inactive with no sccache process, the daemon surviving only via sccache's own per-invocation auto-start — i.e. the unit was a no-op. This is the §5 specification-without-execution trap: the string witness that ExecStart equals the install path was green while the unit did nothing. The foreground form matches the production ctrl-sccache.service invocation (bare ExecStart + SCCACHE_START_SERVER=1 SCCACHE_NO_DAEMON=1 env, verified running month+ on srv1/srv2), reducing the §3 fork between the modeled unit and production rather than inventing a third shape. build_cache_unit_is_foreground_supervised makes the defective combo (Type=simple paired with a backgrounding --start-server) UNWRITABLE; the runtime is-active proof is the live srv3 re-provision (systemd --user is not runnable in the hermetic CI container, so the construction wall carries the CI grain and live execution carries the runtime grain)."

fn build_cache_unit_is_foreground_supervised() -> Bool {
  let body = build_cache_systemd_user_unit_body()
  string_contains(s: body, pattern: "Type=simple")
    && string_contains(s: body, pattern: sccache_start_server_env_assignment())
    && string_contains(s: body, pattern: sccache_no_daemon_env_assignment())
    && !string_contains(s: body, pattern: "--start-server")
}

data build_cache_unit_daemon_self_exit_note: String = "Foregrounding the server was necessary and NOT sufficient — this is the SAME defect one level deeper, found by the live read-back #7206's own note called for. sccache exits on its own after SCCACHE_IDLE_TIMEOUT seconds of no compile requests (default 600, cited in extdeps.cache.sccache.sccache_server_lifetime_note), so the foreground process under Type=simple terminates with status 0 on the first quiet ten minutes and systemd marks the unit `inactive (dead)`; Restart=on-failure does not fire, because a clean exit is not a failure. Measured on srv3 2026-07-25: `Duration: 10min 8.215s`, `Main PID: 3377939 (code=exited, status=0/SUCCESS)`, no sccache process left. The host then reverts to sccache's own per-invocation auto-start — i.e. back to the unit being a no-op, which is exactly the state the foreground form was introduced to remove. Two notes on the shape of the fix. (1) The fix is the cited env knob, not Restart=always: flipping the restart policy would make a clean exit INVISIBLE by relaunching through it, which is DESIGN §5's absorbing fallback (the arm widens instead of refusing, and the deficit's frequency drops to zero by construction). With the idle timeout disabled, a status-0 exit is unreachable by configuration, so Restart=on-failure is the honest policy and a unit found dead is a real, observable, refusable state. (2) The construction check names each required assignment through its extdeps row INDIVIDUALLY rather than folding a roster: a fold over a shared list would go vacuously green the moment the idle-timeout row were dropped from that list, since the emitter and the check would lose it together — the §5 tell of a check satisfiable by editing the declaration while the realization lies."

fn build_cache_unit_body_runs_until_stopped(body: String) -> Bool {
  string_contains(s: body, pattern: sccache_idle_timeout_never_env_assignment())
}

fn build_cache_unit_daemon_runs_until_stopped() -> Bool {
  build_cache_unit_body_runs_until_stopped(body: build_cache_systemd_user_unit_body())
}

fn build_cache_classifier_covers_every_cited_fragment() -> Bool {
  fold(
    sccache_misconfigured_log_fragments,
    init: true,
    f: (acc, frag) =>
      acc && string_contains(s: build_cache_classify_failure_body(), pattern: frag),
  )
}

fn build_cache_provision_shell_script(arch_token: NonEmptyStr, digest: Digest) -> String {
  shell_exec_via_bash(
    body: build_cache_provision_script_body(arch_token: arch_token, digest: digest),
  )
}
