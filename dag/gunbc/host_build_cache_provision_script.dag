module gunbc.host_build_cache_provision_script


data host_build_cache_provision_script_dissolution_trigger: String = "🟡 dissolve-on: host_build_cache_provision_script — concat-built systemd/sccache ensure shell; DISSOLVES WHEN bash-emit (#5828) realizes ProvisionBuildCache observe/ensure/read-back as typed host-effect argv and realize_provision_build_cache retires shell_exec_via_bash transport."

data host_build_cache_provision_script_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.host_build_cache_provision_script",
    decl_name: "host_build_cache_provision_script_dissolution_trigger",
    field: WholeDeclaration,
  }
}

data build_cache_systemd_user_unit_path: String = ".config/systemd/user/sccache.service"

data build_cache_systemd_user_unit_body: String = "[Unit]\nDescription=sccache compiler cache (gunbc host standup)\nAfter=network.target\n\n[Service]\nType=simple\nExecStart=/usr/bin/sccache --start-server\nRestart=on-failure\n\n[Install]\nWantedBy=default.target\n"

fn build_cache_observe_stats_body() -> String {
  concat(
    "stats_rc=0\n",
    concat(
      "stats_out=\"$(sccache --show-stats 2>&1)\" || stats_rc=$?\n",
      concat(
        "if [ \"$stats_rc\" -eq 0 ]; then\n",
        concat(
          "  printf '%s\\n' \"BuildCacheProvisionReceipt: observe=ok\"\n",
          concat(
            "  printf '%s\\n' \"$stats_out\"\n",
            "  exit 0\n",
          )
        )
      )
    )
  )
}

fn build_cache_classify_failure_body() -> String {
  concat(
    concat(
      concat(
        "if printf '%s' \"$stats_out\" | grep -Fq ",
        concat("\"", sccache_fatal_error_log_fragment),
      ),
      "\"; then\n",
    ),
    concat(
      concat(
        concat(
          "  printf '%s\\n' \"BuildCacheProvisionReceipt: observe=misconfigured fragment=",
          sccache_fatal_error_log_fragment,
        ),
        "\"\n",
      ),
      concat(
        concat(
          concat(
            "elif printf '%s' \"$stats_out\" | grep -Fq ",
            concat("\"", sccache_rustc_wrapper_exit_254_log_fragment),
          ),
          "\"; then\n",
        ),
        concat(
          concat(
            concat(
              "  printf '%s\\n' \"BuildCacheProvisionReceipt: observe=misconfigured fragment=",
              sccache_rustc_wrapper_exit_254_log_fragment,
            ),
            "\"\n",
          ),
          concat(
            concat(
              concat(
                "elif printf '%s' \"$stats_out\" | grep -Fq ",
                concat("\"", sccache_failed_to_execute_compile_log_fragment),
              ),
              "\"; then\n",
            ),
            concat(
              concat(
                concat(
                  "  printf '%s\\n' \"BuildCacheProvisionReceipt: observe=misconfigured fragment=",
                  sccache_failed_to_execute_compile_log_fragment,
                ),
                "\"\n",
              ),
              "else\n  printf '%s\\n' \"BuildCacheProvisionReceipt: observe=unresponsive\"\nfi\n"
            )
          )
        )
      )
    )
  )
}

fn build_cache_ensure_daemon_body() -> String {
  concat(
    "if ! command -v sccache >/dev/null 2>&1; then\n",
    concat(
      "  sudo -n apt-get update -qq && sudo -n apt-get install -y sccache\n",
      concat(
        "fi\n",
        concat(
          concat("mkdir -p \"$(dirname ", build_cache_systemd_user_unit_path, ")\""),
          concat(
            "\n",
            concat(
              concat("cat > ", build_cache_systemd_user_unit_path, " <<'__GUNBC_SCCACHE_UNIT__'\n"),
              concat(
                build_cache_systemd_user_unit_body,
                concat(
                  "__GUNBC_SCCACHE_UNIT__\n",
                  "systemctl --user daemon-reload\nsystemctl --user enable --now sccache.service\n",
                )
              )
            )
          )
        )
      )
    )
  )
}

fn build_cache_read_back_body() -> String {
  concat(
    "if stats_out=\"$(sccache --show-stats 2>&1)\"; then\n",
    concat(
      "  printf '%s\\n' \"BuildCacheProvisionReceipt: read_back=ok\"\n",
      concat(
        "  printf '%s\\n' \"$stats_out\"\n",
        concat(
          "  exit 0\n",
          concat(
            "else\n",
            concat(
              "  printf '%s\\n' \"BuildCacheProvisionReceipt: read_back=FAILED sccache unhealthy after ensure\"\n",
              concat(
                "  printf '%s\\n' \"$stats_out\"\n",
                "  exit 1\n",
              )
            )
          )
        )
      )
    )
  )
}

fn build_cache_provision_script_body() -> String {
  concat(
    "set -euo pipefail\n",
    concat(
      build_cache_observe_stats_body(),
      concat(
        build_cache_classify_failure_body(),
        concat(
          "printf '%s\\n' \"BuildCacheProvisionReceipt: ensure=starting\"\n",
          concat(
            build_cache_ensure_daemon_body(),
            build_cache_read_back_body(),
          )
        )
      )
    )
  )
}

fn build_cache_provision_read_back_fails_closed() -> Bool {
  string_contains(
    s: build_cache_read_back_body(),
    pattern: "read_back=FAILED",
  ) && string_contains(
    s: build_cache_read_back_body(),
    pattern: "exit 1",
  ) && !string_contains(
    s: build_cache_read_back_body(),
    pattern: "stats_rc",
  )
}

fn build_cache_provision_shell_script() -> String {
  shell_exec_via_bash(body: build_cache_provision_script_body())
}
