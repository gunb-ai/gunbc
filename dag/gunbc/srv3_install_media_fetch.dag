module gunbc.srv3_install_media_fetch


data gunbc_srv3_install_media_fetch_scope_disposition: std.disposition.Disposition = Terminal {
  reason: "srv3 Ubuntu 24.04.3 live-server arm64 ISO acquisition — CreateIfAbsent keyed on content_sha256; N mirror transport handlers on one cited artifact row; runnable on srv1 actuator host before nbd-proxy serve."
}

data srv3_install_media_fetch_shell_runner_scaffold: std.disposition.Disposition = Terminal {
  reason: "srv3_install_media_fetch() routes through host_effect_apply to install_media_fetch_reconcile() in-process (TypedReconcileOnHost cell, dag/gunbc/host_effect_realize.dag) - no shell script is built, serialized, or run for this effect"
}

data srv3_ubuntu_install_media_install_path: std.types.NonEmptyStr = ubuntu_install_media_install_path(
  artifact: srv3_ubuntu_install_media_artifact,
)

data install_media_fetch_effect_shape: EffectShape<std.effects.KeySource> = std.effects.CreateEffect {
  cause: std.effects.CreateIfAbsent { key_source: std.effects.InputField { field: "content_sha256" } },
}

type InstallMediaPresenceObservation
  = Absent
  | Present { observed_sha256: std.types.Sha256 }

type InstallMediaFetchVerdict
  = AlreadyPresent {
      install_path: std.types.NonEmptyStr
      content_sha256: std.types.Sha256
    }
  | FetchRequired {
      install_path: std.types.NonEmptyStr
      mirror_order: List<extdeps.provisioning.ubuntu_install_media.UbuntuInstallMediaMirrorRow>
    }
  | HashMismatchRefusal {
      install_path: std.types.NonEmptyStr
      expected_sha256: std.types.Sha256
      observed_sha256: std.types.Sha256
    }

type InstallMediaFetchReceipt {
  artifact_version: std.types.NonEmptyStr
  mirror_used: extdeps.provisioning.ubuntu_install_media.UbuntuInstallMediaMirrorHost?
  sha256_verified: std.types.Sha256
  bytes: std.measure.ByteSize
  duration_ms: std.types.Milliseconds
  outcome: InstallMediaFetchOutcome
}

type InstallMediaFetchOutcome
  = AlreadyPresentOutcome
  | FetchedOutcome

fn classify_install_media_fetch(
  observation: InstallMediaPresenceObservation,
  artifact: extdeps.provisioning.ubuntu_install_media.UbuntuInstallMediaArtifactRow,
) -> InstallMediaFetchVerdict {
  let install_path = ubuntu_install_media_install_path(artifact: artifact)
  match observation {
    Absent =>
      FetchRequired {
        install_path: install_path,
        mirror_order: ubuntu_install_media_mirror_rows,
      }
    Present { observed_sha256: observed } =>
      if observed == artifact.content_sha256 {
        AlreadyPresent {
          install_path: install_path,
          content_sha256: artifact.content_sha256,
        }
      } else {
        HashMismatchRefusal {
          install_path: install_path,
          expected_sha256: artifact.content_sha256,
          observed_sha256: observed,
        }
      }
  }
}

fn install_media_fetch_verdict_is_idempotent_skip(verdict: InstallMediaFetchVerdict) -> Bool {
  match verdict {
    AlreadyPresent { install_path: _, content_sha256: _ } => true
    FetchRequired { install_path: _, mirror_order: _ } => false
    HashMismatchRefusal { install_path: _, expected_sha256: _, observed_sha256: _ } => false
  }
}

fn install_media_fetch_first_mirror_url(artifact: extdeps.provisioning.ubuntu_install_media.UbuntuInstallMediaArtifactRow) -> std.types.NonEmptyStr {
  let first = ubuntu_install_media_mirror_rows.first()
  ubuntu_install_media_mirror_url(artifact: artifact, mirror: first)
}

fn srv3_install_media_fetch_actuator_host() -> gunbc.fleet_intent.ComputeHost {
  srv3_os_install_actuator_host
}

func srv3_install_media_fetch() -> std.process.ProcessExit
  uses net: std.cache_interface.Network
{
  srv3_reconciliation_to_process_exit(
    r: srv3_install_media_fetch_apply(),
    failure_prefix: "install-media-fetch: ",
  )
}

fn srv3_install_media_fetch_install_path_is_versioned() -> Bool {
  string_contains(
    s: srv3_ubuntu_install_media_install_path as String,
    pattern: "ubuntu-24.04.3-live-server-arm64.iso",
  )
}

fn srv3_install_media_fetch_actuator_host_is_srv1() -> Bool {
  srv3_install_media_fetch_actuator_host() == srv1_host
}
