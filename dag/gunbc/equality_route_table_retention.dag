module gunbc.equality_route_table_retention

import std.types { String }

// WHY THE DERIVED-EQUALITY ROUTING TABLE LIVES IN THE SEED. The table is v1.compiler.infer equality_route_declarations
// (src/v1/04_infer.dag); this row cites it by symbol and does not copy its rows, because a copy of the table is a
// second authority for the same fact (DESIGN section 3). Its carriers, routing functions and root standing are read
// from that declaration.
//
// A retention is "a declared row with reason and migration trigger, never a silent escape hatch" (DESIGN section 7).
// THE MOVE, when it happens, is one change: the table lands in v2.std.node beside the carriers it routes and the seed
// table is deleted, so it is never in both trees.

type EqualityRouteTableRetention {
  // Why the table sits in the seed rather than beside its carriers.
  reason: String
  // What moves it, and where it moves to.
  migration_trigger: String
  migration_destination: String
  // The rung drop that keeps it here, so a reader of either row finds the other.
  blocker_rung_drop: String
}

data equality_route_table_retention: EqualityRouteTableRetention = EqualityRouteTableRetention {
  reason: "The only consumer that reads the table is the seed's own equality check; a second copy in v2.std.node with no reader would be a fork, and a table with no consumer at all would be dangling",
  migration_trigger: "the v2 checker computes the equality plan",
  migration_destination: "v2.std.node",
  blocker_rung_drop: "gunbc.rung_drop native_equality_operand_judgment",
}
