// THE DOOR IS ITS OWN OBLIGATION AND IT IS THE ROW THAT SUBSUMES THE OTHER EIGHT. The two rosters
// above fire on every validate_then_compile call regardless of caller-supplied lenses — which is a
// true and complete statement about a function whose only callers in the corpus are its own
// fixtures. A grep for the symbol outside src/v2/compiler/00_compile.dag reaches three test entries
// and one line of roadmap prose. No production path hands a real module to this door, so the
// question the whole roster answers is asked only about trees its own witnesses built.
data compile_door_obligation: V2CompileObligation = V2CompileObligation {
  identity: "validate_then_compile_door" as NonEmptyStr,
  kind: CompileDoor,
  home: decl_ref(module_path: "v2.compiler.compile", decl_name: "validate_then_compile"),
  claimed_rung: MechanicallyPreventable,
  discriminating_red: "a real corpus module carrying a violation of any enrolled lens, handed to the door, which must be Rejected before compile-core" as NonEmptyStr,
  positive_control: "the same module with the violation removed, which must reach compile-core (src/v2/test/lens_application/rejecting_lens_blocks_before_compile_test.dag holds the fixture-grain pair)" as NonEmptyStr,
  interpreted: NoWitnessNamesIt {
    note: "no production consumer calls this door. Its callers are src/v2/test/lens_application (two entries, outside witness_discovery_scan_dirs), src/v2/test/claim/manual/validate_then_compile_public_terminal.dag, and src/v2/test/claim/long/accumulator_copy_compile_gate_test.dag. A roster that fires on every call of a function nothing calls fires never" as NonEmptyStr
  },
  native: lens_native_execution,
  ceiling: StructurallyGuaranteed,
  next_trigger: "the acceptance path that compiles the corpus routes modules through validate_then_compile, so the two rosters are asked about authored source rather than about fixtures" as NonEmptyStr,
  seed_escape: SeedEscapeOpen {
    what_the_seed_does: "the seed compiles and accepts the entire corpus without ever calling this door, so every lens enrolled behind it is silent on every module the repository actually builds" as NonEmptyStr
  },
  related_drops: ["required_gate_bankruptcy" as NonEmptyStr, "source_root_ingest_gate_rung_drop" as NonEmptyStr],
}

// THE PRIMITIVE ROWS ARE THE DENOMINATOR THE DETERMINISM GATE RANGES OVER, AND ONLY THE OPEN
// MEMBERS ARE CARRIED. std.primitive_identity declares seventeen PrimitiveTraversalOrderFact rows
// and the closure wall makes a declared primitive with no fact refuse, which is a real construction
// and is not re-litigated here. What this census carries is the three members whose DECLARED answer
// leaves a program's determinism open: two HostUnspecifiedOrder and the one
// TraversalOrderUnclassified. Restating the other fourteen would be the fork this module exists to
// avoid — they are reachable from primitive_declared_traversal_facts and carry no open question.
data primitive_index_by_obligation: V2CompileObligation = V2CompileObligation {
  identity: "primitive_index_by_traversal_unclassified" as NonEmptyStr,
  kind: DeclaredPrimitiveTraversalFact,
  home: decl_ref(module_path: "std.primitive_identity", decl_name: "primitive_index_by_traversal"),
  // Unclassified is IGNORANCE, and the gate refuses fail-closed on it — so the claim here is the
  // refusal, not a determinism guarantee.
  claimed_rung: MechanicallyPreventable,
  discriminating_red: "any call reaching index_by in a tree handed to the determinism gate, which must refuse because nobody has answered the order question" as NonEmptyStr,
  positive_control: "the same tree with sorted_map_keys in place of index_by, which must be accepted as CanonicalOrder" as NonEmptyStr,
  interpreted: OutsideDiscoveryScope {
    scope_authority: discovery_scope_authority,
    home_dir: "the refusal only fires through v2.lens.determinism, whose witnesses are all outside the scope" as NonEmptyStr
  },
  native: lens_native_execution,
  ceiling: StructurallyGuaranteed,
  next_trigger: "index_by's realization is read and the row is replaced by a classified order, at which point this census row deletes rather than being marked closed" as NonEmptyStr,
  seed_escape: SeedEscapeOpen {
    what_the_seed_does: "the seed calls its own index_by realization directly with no gate between, so an unclassified order is consumed rather than refused" as NonEmptyStr
  },
  related_drops: ["determinism_transitive_reachability" as NonEmptyStr],
}

