// THE ONLY WallNow IN THE ROSTER, AND THE ONLY ROW WHOSE CLAIM AND EVIDENCE ARE THE FURTHEST
// APART. Its construction_justification declares WallNow with mandatory_tag_compile_gate as the
// authority — a wall standing NOW — while every one of its twelve gate witnesses, including
// mandatory_tag_enrolled_in_root_roster_rejects_violating_module (the one whose entire job is the
// root-roster enrollment this claim rests on), is a frozen path deferral under test/claim/long.
// Frozen means declared never-executed. So the strongest claim in the roster is the one with no
// executing evidence anywhere, which is DESIGN section 4b(1) rung inflation exactly.
data mandatory_tag_obligation: V2CompileObligation = V2CompileObligation {
  identity: "mandatory_tag_root_lens" as NonEmptyStr,
  kind: RequiredRootLens,
  home: HomeAuthority { authority: decl_ref(module_path: "v2.lens.mandatory_tag", decl_name: "mandatory_tag_compile_gate") },
  claimed_rung: StructurallyGuaranteed,
  discriminating_red: "a module declaring a mandatory tag with a missing, misnamed, wrongly typed or bogus-scheme value, at parse grain and again at normalized grain, which the gate must reject" as NonEmptyStr,
  positive_control: "the clean and the off-region fixtures, which must be accepted at both grains" as NonEmptyStr,
  witnesses: [
    witness_subject(entry: "src/v2/test/claim/long/mandatory_tag_gate_witness_test.dag", function: "mandatory_tag_enrolled_in_root_roster_rejects_violating_module"),
    witness_subject(entry: "src/v2/test/claim/long/mandatory_tag_gate_witness_test.dag", function: "mandatory_tag_parse_grain_clean_accepts"),
    witness_subject(entry: "src/v2/test/claim/long/mandatory_tag_extdeps_corpus_test.dag", function: "mandatory_tag_extdeps_corpus_wall_holds"),
  ],
  native: lens_native_execution,
  route_reach: lens_native_route_reach,
  ceiling: StructurallyGuaranteed,
  next_trigger: "THE CAPABILITY IS AN EXECUTING HOME FOR THIS GATE'S WITNESSES, and it is guarded twice over so a single edit satisfies nothing. The twelve gate functions must leave gunbc.witness_deferral_freeze — a freeze row is a declaration that the identity executes nowhere, and deleting it while the entry stays under the 'test/claim/long/' exclusion pattern would swap one silence for another — AND that exclusion must retire on its own terms, which means the corpus-grain walk these witnesses perform becomes affordable on the fold that would run it. Only then does mandatory_tag_enrolled_in_root_roster_rejects_violating_module refuse on a required run, and only then does the WallNow this row records have any executing evidence at all" as NonEmptyStr,
  seed_escape: SeedEscapeOpen {
    what_the_seed_does: "stage0 Rust carries no mandatory-tag surface at all, so the seed cannot violate the rule and cannot demonstrate it either" as NonEmptyStr
  },
  related_drops: [],
}

