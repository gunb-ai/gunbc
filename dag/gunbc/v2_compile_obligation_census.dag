  next_trigger: "a production caller hands emitting trees to validate_then_compile, so a map_keys call on an emission path refuses instead of being classified by non-membership" as NonEmptyStr,
  seed_escape: SeedEscapeOpen {
    what_the_seed_does: "the seed calls map_keys directly in emission and ordering code with no gate between. THE OBSERVED PUB-USE DIVERGENCE IS NOT THIS ROW AND THE ATTRIBUTION IS WITHDRAWN RATHER THAN SOFTENED: the first cut named that incident here, and measurement on gunbc#10941 found the nondeterministic re-export walk to be v1.05_emit_core_support unique_strings, a fold over a membership map, not a call to this primitive. A fit that survives a plausibility read is not a diagnosis, and leaving it standing would have aimed every repair at a primitive nobody measured. The incident is carried by its own row, determinism_non_primitive_order_exposing_fold" as NonEmptyStr
  },
  related_drops: [],
}

data primitive_map_values_obligation: V2CompileObligation = V2CompileObligation {
  identity: "primitive_map_values_traversal_host_unspecified" as NonEmptyStr,
  kind: DeclaredPrimitiveTraversalFact,
