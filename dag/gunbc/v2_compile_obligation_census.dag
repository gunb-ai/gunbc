}

// MEASURED, NOT READ. hollow_alias_blocked_via_always_required_lenses_holds was executed directly
// against this tree and returned true — the hollow-alias tree is rejected with reason
// fact_density_hollow_alias_locus through the always_required_lenses roster. That establishes the
// assertion HOLDS. It establishes nothing about coverage, and the interpreted column below is why.
data fact_density_obligation: V2CompileObligation = V2CompileObligation {
  identity: "fact_density_subtree_lens" as NonEmptyStr,
  kind: RequiredSubtreeLens,
  home: HomeAuthority { authority: decl_ref(module_path: "v2.lens.fact_density", decl_name: "fact_density_hollow_alias_gate") },
  claimed_rung: MechanicallyPreventable,
  discriminating_red: "a hollow alias node whose fact bundle names no fact, which run_required_lens_gates must reject with reason fact_density_hollow_alias_locus" as NonEmptyStr,
  positive_control: "the named fact-bundle fixture in the same directory, which must pass the same roster" as NonEmptyStr,
  witnesses: [
    witness_subject(entry: "src/v2/test/lens_fact_density/hollow_alias_blocked_via_always_required_lenses_test.dag", function: "hollow_alias_blocked_via_always_required_lenses_holds"),
    witness_subject(entry: "src/v2/test/lens_fact_density/fact_bundle_compile_lens_passes_test.dag", function: "fact_bundle_compile_lens_passes_holds"),
  ],
  native: lens_native_execution,
  route_reach: lens_native_route_reach,
  ceiling: StructurallyGuaranteed,
  next_trigger: native_door_entry_trigger,
  seed_escape: SeedEscapeOpen {
    what_the_seed_does: "stage0 Rust type aliases carry no fact bundle, so a hollow alias in the seed is not a state this gate can see" as NonEmptyStr
  },
  related_drops: [],
}

