  claimed_rung: MechanicallyPreventable,
  discriminating_red: "a tree calling map_keys, whose result order is a function of the per-process hash seed and not of the input, which the gate must refuse per leaking call node" as NonEmptyStr,
  positive_control: "the same tree calling sorted_map_keys, which must be accepted" as NonEmptyStr,
  interpreted: OutsideDiscoveryScope {
    scope_authority: discovery_scope_authority,
    home_dir: "the refusal only fires through v2.lens.determinism, whose witnesses are all outside the scope" as NonEmptyStr
  },
  native: lens_native_execution,
  ceiling: StructurallyGuaranteed,
  next_trigger: "a production caller hands emitting trees to validate_then_compile, so a map_keys call on an emission path refuses instead of being classified by non-membership" as NonEmptyStr,
  seed_escape: SeedEscapeOpen {
    what_the_seed_does: "this is the live specimen: the seed emitter orders pub-use lines from a set traversal, producing different bytes from the same sha, and the gate that would classify it NonDeterministic is never handed the emitter" as NonEmptyStr
  },
  related_drops: [],
}

data primitive_map_values_obligation: V2CompileObligation = V2CompileObligation {
  identity: "primitive_map_values_traversal_host_unspecified" as NonEmptyStr,
  kind: DeclaredPrimitiveTraversalFact,
  home: decl_ref(module_path: "std.primitive_identity", decl_name: "primitive_map_values_traversal"),
  claimed_rung: MechanicallyPreventable,
  discriminating_red: "a tree calling map_values, which exposes the same host order as map_keys and must refuse" as NonEmptyStr,
  positive_control: "a tree whose values are read through a sorted key list, which must be accepted" as NonEmptyStr,
  interpreted: OutsideDiscoveryScope {
    scope_authority: discovery_scope_authority,
    home_dir: "the refusal only fires through v2.lens.determinism, whose witnesses are all outside the scope" as NonEmptyStr
  },
