module gunbc.v2_compile_obligation_census

import std.types { Bool, Int, List, NonEmptyStr, list_length }
import std.decl_ref { DeclarationRef, decl_ref }
import gunbc.guarantee_rung { GuaranteeRung, Mitigatable, MechanicallyPreventable, StructurallyGuaranteed }

// WHY THIS CENSUS EXISTS, IN ONE SENTENCE THE OPERATOR ASKED FOR (2026-09-10): v2 exists so that
// classes like nondeterministic emission are UNWRITABLE, and this roster says, per compile-time
// obligation v2 declares, whether that is true ON THE ROUTE THAT ACTUALLY ACCEPTS SOURCE or only
// claimed in a declaration nobody executes.
//
// IT IS A JOIN, NOT A SECOND VOCABULARY. Every rung drop, frozen deferral and recurring failure
// mode this census reaches is named BY ITS EXISTING IDENTITY (related_drops below) and never
// restated here; every home is a DeclarationRef into the authority that owns the obligation. The
// only facts this module adds are the three columns nothing else carries: what executes the
// obligation on the interpreted per-PR route, what executes it on the emitted-native route, and
// what the v1 seed does OUTSIDE the obligation's reach.
//
// THE THREE COLUMNS ARE DIFFERENT QUESTIONS AND THE CENSUS EXISTS BECAUSE THEY DISAGREE. DESIGN
// section 4b(1): a class's rung is the MINIMUM across its in-scope paths, and a type name, a lens
// declaration, or a plan establishes nothing. Direct execution of a witness is evidence that its
// assertion HOLDS; it is never evidence that any required run reaches it, and conflating those two
// is the inflation this census measures.

// WHAT THE OBLIGATION IS. RequiredRootLens and RequiredSubtreeLens are the two enrolled rosters in
// v2.compiler.compile; CompileDoor is the door itself, which is an obligation in its own right
// because a roster that fires on every call of a function nothing calls fires never;
// DeclaredPrimitiveTraversalFact is one row of the closed denominator v2.lens.determinism ranges
// over, and it is carried per-primitive only for the members whose declared order leaves the
// question open.
type ObligationKind
  = CompileDoor
  | RequiredRootLens
  | RequiredSubtreeLens
  | DeclaredPrimitiveTraversalFact

// WHERE AN OBLIGATION EXECUTES ON ONE ROUTE, AND WHY THE NON-EXECUTING ARMS ARE FOUR AND NOT ONE.
// Collapsing them would reproduce exactly the failure gunbc.recurring_failure_mode names as
// non-execution undifferentiated by what it silenced: a witness outside the discovery scope, a
// witness inside the scope but frozen, a witness with no consumer at all, and a receipt family
// whose route produces evidence nothing can spend are four different repairs with four different
// owners, and a single Absent arm would rank none of them.
type PathExecution
  // The obligation runs on this route on a required run. instrument NAMES THE PRODUCER that
  // re-derives the observation (DESIGN section 6) and never transcribes its output.
  = ExecutedOnPath { instrument: NonEmptyStr }
  // A witness exists and passes when invoked by hand, but its home directory is outside the
  // discovery scope the required run walks, so no required run ever reaches it.
  | OutsideDiscoveryScope { scope_authority: DeclarationRef, home_dir: NonEmptyStr }
  // Enrolled in the frozen legacy population: declared never-executed, admitted with no executing
  // consumer. Mitigatable at best, by construction of the roster it sits in.
  | FrozenPathDeferred { roster: DeclarationRef }
  // A receipt family exists for this route but publishes no evidence the required acceptance path
  // can consume.
  | RouteGapHeld { stall: DeclarationRef }
  // No witness names this obligation on this route at all.
  | NoWitnessNamesIt { note: NonEmptyStr }

// WHAT THE v1 SEED DOES OUTSIDE THE OBLIGATION'S REACH — the column that motivates the census. The
// seed is compiled by stage0 and by rustc; it is not a tree v2's compile door was ever handed, so
// every gate above is silent about it. An escape is CLOSED only when a named declaration brings the
// seed inside the obligation's reach, never when the obligation is merely stated more strongly.
type SeedEscape
  = SeedEscapeOpen { what_the_seed_does: NonEmptyStr }
  | SeedEscapeClosed { by: DeclarationRef }

type V2CompileObligation {
  identity: NonEmptyStr
  kind: ObligationKind
  home: DeclarationRef
  // The rung the obligation's own declaration claims for itself, read off that declaration.
  claimed_rung: GuaranteeRung
  // The input that makes the obligation refuse, and the input that must still be accepted beside
  // it. A refusal with no positive control is satisfied by a mechanism that refuses everything.
  discriminating_red: NonEmptyStr
  positive_control: NonEmptyStr
  interpreted: PathExecution
  native: PathExecution
  ceiling: GuaranteeRung
  next_trigger: NonEmptyStr
  seed_escape: SeedEscape
  // Identities of gunbc.rung_drop rows that already govern part of this obligation. Joined by
  // identity; the rows are NOT restated here.
  related_drops: List<NonEmptyStr>
}

// THE ONE FACT EVERY ROW SHARES, HELD ONCE. The required run walks
// gunbc.ci_layer_roots witness_discovery_scan_dirs and nothing else, so a *_test.dag outside those
// three directories is not discovered however green it is when run by hand.
data discovery_scope_authority: DeclarationRef = decl_ref(
  module_path: "gunbc.ci_layer_roots",
  decl_name: "witness_discovery_scan_dirs"
)

data frozen_roster_authority: DeclarationRef = decl_ref(
  module_path: "gunbc.witness_deferral_freeze",
  decl_name: "frozen_path_deferrals"
)

data self_host_route_stall: DeclarationRef = decl_ref(
  module_path: "gunbc.guarantee_stall.self_host_wet_route_receipt_lifetime_stall",
  decl_name: "self_host_wet_route_receipt_lifetime_stall"
)

// THE NATIVE ARM IS THE SAME VALUE ON EVERY LENS ROW AND THAT IS THE FINDING, NOT AN ABBREVIATION.
// The only behavioral receipt the emitted crate publishes for v2.compiler.compile is the
// self_host_00_compile shim, and it compares ONE VALUE — required_lens_grain_note, the prose string
// describing the two roster grains — between the emitted module and the seed. Not one gate is
// invoked. The seed side of that comparison is v1_compiler::v2_compiler_compile, a nine-line module
// whose entire content is that same string, so the receipt's strongest possible verdict is that two
// copies of a sentence about lenses agree. And the receipt itself is in the route_gap_held
// population, so even that verdict reaches no acceptance path.
data lens_native_execution: PathExecution = RouteGapHeld { stall: self_host_route_stall }

// THE SEED IS OUTSIDE EVERY ROW'S REACH FOR ONE STRUCTURAL REASON, stated once here rather than
// repeated per row: v2's gates read the InferredTree the compile door is handed, and the seed is
// never handed to that door — it is stage0 Rust compiled by rustc. So the reach of every obligation
// below stops at the corpus v2 compiles, which is today the fixtures its own witnesses build. Each
// row's what_the_seed_does states the specific escape that reach leaves open, not this general fact.

data accumulator_copy_obligation: V2CompileObligation = V2CompileObligation {
  identity: "accumulator_copy_root_lens" as NonEmptyStr,
  kind: RequiredRootLens,
  home: decl_ref(
    module_path: "v2.lens.complexity_accumulator_copy.compile_gate",
    decl_name: "accumulator_copy_compile_gate"
  ),
  claimed_rung: MechanicallyPreventable,
  discriminating_red: "a rooted tree threading a copied accumulator through a fold, which the gate must reject with a located diagnostic rather than a widened pass" as NonEmptyStr,
  positive_control: "the resolved add fixture, which threads no copy and must pass the root-required roster unchanged (src/v2/test/claim/long/accumulator_copy_compile_gate_test.dag)" as NonEmptyStr,
  interpreted: FrozenPathDeferred { roster: frozen_roster_authority },
  native: lens_native_execution,
  ceiling: StructurallyGuaranteed,
  next_trigger: "the compile-gate and roster-gate witnesses move under a directory gunbc.ci_layer_roots witness_discovery_scan_dirs walks AND their gunbc.witness_deferral_freeze rows delete, so a required run refuses on the copied-accumulator tree" as NonEmptyStr,
  seed_escape: SeedEscapeOpen {
    what_the_seed_does: "the seed's own folds are never presented to this gate, so a copied accumulator authored in stage0 Rust is invisible to the complexity lens that exists to make it unwritable" as NonEmptyStr
  },
  related_drops: ["lens_enforcement_censuses" as NonEmptyStr],
}

data determinism_obligation: V2CompileObligation = V2CompileObligation {
  identity: "determinism_root_lens" as NonEmptyStr,
  kind: RequiredRootLens,
  home: decl_ref(module_path: "v2.lens.determinism", decl_name: "determinism_compile_gate"),
  claimed_rung: MechanicallyPreventable,
  discriminating_red: "a tree whose call joins a PrimitiveIdentity carrying HostUnspecifiedOrder or TraversalOrderUnclassified, which the gate must refuse per leaking call node" as NonEmptyStr,
  positive_control: "a tree over CanonicalOrder and OrderFreeResult primitives, which must still compile" as NonEmptyStr,
  interpreted: OutsideDiscoveryScope {
    scope_authority: discovery_scope_authority,
    home_dir: "src/v2/test/claim, src/v2/test/claim/enforcement and src/v2/test/lens_determinism, none of which the required run walks" as NonEmptyStr
  },
  native: lens_native_execution,
  ceiling: StructurallyGuaranteed,
  next_trigger: "the determinism witnesses are homed inside witness_discovery_scan_dirs AND a production caller hands the corpus to v2.compiler.compile validate_then_compile, so the gate is asked about a real module rather than a fixture" as NonEmptyStr,
  seed_escape: SeedEscapeOpen {
    what_the_seed_does: "the seed emitter iterates a set when ordering pub-use lines, which this gate would classify NonDeterministic; the class is live and observed as same-sha emission divergence, and the gate never sees the emitter because the emitter is stage0 Rust" as NonEmptyStr
  },
  related_drops: ["determinism_transitive_reachability" as NonEmptyStr],
}

data machine_shape_obligation: V2CompileObligation = V2CompileObligation {
  identity: "machine_shape_root_lens" as NonEmptyStr,
  kind: RequiredRootLens,
  home: decl_ref(module_path: "v2.lens.machine_shape", decl_name: "machine_shape_compile_gate"),
  claimed_rung: MechanicallyPreventable,
  discriminating_red: "a tree carrying a flat machine-shape scalar where the modeled carrier is required, which the gate must reject" as NonEmptyStr,
  positive_control: "the modeled-carrier fixture in src/v2/test/claim/machine_shape_construction_wall_test.dag, which must pass" as NonEmptyStr,
  interpreted: OutsideDiscoveryScope {
    scope_authority: discovery_scope_authority,
    home_dir: "src/v2/test/claim, which the required run does not walk. THE TWO MACHINE-SHAPE WITNESSES THAT ARE INSIDE THE SCOPE ARE A DIFFERENT SUBJECT: dag/test/claim/machine_shape_witness_test.dag and its catalog sibling import std.machine_shape and the extdeps catalogs, never v2.lens.machine_shape, so reading the scope for this name finds green witnesses that exercise none of this gate" as NonEmptyStr
  },
  native: lens_native_execution,
  ceiling: StructurallyGuaranteed,
  next_trigger: "a witness that imports v2.lens.machine_shape machine_shape_compile_gate is homed inside witness_discovery_scan_dirs" as NonEmptyStr,
  seed_escape: SeedEscapeOpen {
    what_the_seed_does: "stage0 Rust declares machine widths as host integer types with no modeled carrier, and no gate asks" as NonEmptyStr
  },
  related_drops: [],
}

data mandatory_tag_obligation: V2CompileObligation = V2CompileObligation {
  identity: "mandatory_tag_root_lens" as NonEmptyStr,
  kind: RequiredRootLens,
  home: decl_ref(module_path: "v2.lens.mandatory_tag", decl_name: "mandatory_tag_compile_gate"),
  // THE ONLY WallNow IN THE ROSTER, AND THE ONLY ROW WHOSE CLAIM AND EVIDENCE ARE THE FURTHEST
  // APART. Its construction_justification declares WallNow with mandatory_tag_compile_gate as the
  // authority — a wall standing NOW — while every one of its twelve gate witnesses, including
  // mandatory_tag_enrolled_in_root_roster_rejects_violating_module (the one whose entire job is the
  // root-roster enrollment this claim rests on), is a frozen path deferral under test/claim/long.
  // Frozen means declared never-executed. So the strongest claim in the roster is the one with no
  // executing evidence anywhere, which is DESIGN section 4b(1) rung inflation exactly.
  claimed_rung: StructurallyGuaranteed,
  discriminating_red: "a module declaring a mandatory tag with a missing, misnamed, wrongly typed or bogus-scheme value, at parse grain and again at normalized grain, which the gate must reject" as NonEmptyStr,
  positive_control: "the clean and the off-region fixtures, which must be accepted at both grains" as NonEmptyStr,
  interpreted: FrozenPathDeferred { roster: frozen_roster_authority },
  native: lens_native_execution,
  ceiling: StructurallyGuaranteed,
  next_trigger: "the twelve mandatory_tag gate functions leave gunbc.witness_deferral_freeze AND their entries are homed inside witness_discovery_scan_dirs, so the enrolled-in-root-roster refusal executes on a required run" as NonEmptyStr,
  seed_escape: SeedEscapeOpen {
    what_the_seed_does: "stage0 Rust carries no mandatory-tag surface at all, so the seed cannot violate the rule and cannot demonstrate it either" as NonEmptyStr
  },
  related_drops: [],
}

