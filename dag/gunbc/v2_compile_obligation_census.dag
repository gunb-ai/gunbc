module gunbc.v2_compile_obligation_census

import std.types { Bool, Int, List, NonEmptyStr, String, list_length }
import std.decl_ref { DeclarationRef, decl_ref, declaration_ref_eq }
import std.dissolution { DissolutionCondition, unbound_dissolution }
import gunbc.guarantee_stall { NextRungTrigger, climbs_when, next_rung_trigger_render }
import gunbc.guarantee_rung {
  GuaranteeRung,
  guarantee_rung_label,
  guarantee_rung_index,
  OutsideTheLadder,
  Mitigatable,
  MechanicallyPreventable,
  StructurallyGuaranteed
}
import gunbc.witness_deferral_freeze { frozen_path_deferral_covers }
import gunbc.ci_layer_roots { WitnessExclusionRow, witness_exclusion_frontier }
import v2.workflow.required_floor { required_gate_prefixes }
import gunbc.witness_v2_native_route { native_route_universe_member }

// WHY THIS CENSUS EXISTS, IN ONE SENTENCE THE OPERATOR ASKED FOR (2026-09-10): v2 exists so that
// classes like nondeterministic emission are UNWRITABLE, and this roster says, per compile-time
// obligation it carries, whether that is true ON A ROUTE THAT EXECUTES or only claimed in a
// declaration nobody runs.
//
// WHAT THE ROSTER IS, AND WHAT IT IS NOT: IT IS NOT PROVEN COMPLETE. The rows were enumerated by
// hand from v2.compiler.compile's two enrolled lens rosters, std.primitive_identity's declared
// traversal facts, and two classes surfaced by measurement — and nothing here joins that set to
// those authorities at identity grain, because the enrolled rosters are the CONTENTS of two list
// literals and no reader available to this module can walk them. So a lens de-enrolled from
// always_required_root_lenses, or one added to it, leaves this roster stale and silent.
//
// THE CENSUS THEREFORE CLAIMS COVERAGE OF ITS OWN ROWS AND NOT OF v2's OBLIGATIONS AS A WHOLE, and
// every count below is denominated in obligations_claimed rather than in a population anyone has
// proved closed. Reading these numbers as "v2's obligations" is the completeness inflation this
// module would otherwise commit in its own headline — the same shape it measures. The closure is a
// declared frontier, not a silence: it lands when the roster is derived from those authorities
// rather than authored beside them.
//
// THE DISPOSITIONS ARE DERIVED, NOT AUTHORED, AND THE FIRST CUT OF THIS MODULE PROVED WHY. That cut
// hand-wrote each row's interpreted standing from a reading of gunbc.ci_layer_roots
// witness_discovery_scan_dirs, and the reading was WRONG: that declaration has exactly one consumer
// in v1_compiler.cli_run and it is inside a cfg(test) module asserting the authority's own value.
// The walk that actually discovers witnesses takes every *_test.dag under witness_layer_roots
// (dag, src/v2) and subtracts gunbc.ci_layer_roots witness_exclusion_frontier by substring. So six
// obligations this census reported as unreachable are discovered and running, and the error was
// invisible precisely because the disposition was a sentence rather than a question put to the
// authority that owns it. DESIGN section 3: a fork is a correctness concern, not a style one — and
// the correctness it cost here was the census's headline number.
//
// TWO FINDINGS THIS CENSUS SURFACED THAT ARE NOT ROWS. Both are filed as their own classes under
// dag/gunbc/recurring_failure_mode/ — stale_present_tense_coverage_claim_in_the_authority_consulted_first
// and receipt_subject_is_the_prose_about_the_mechanism — because DESIGN section 4b requires a
// discovered error class to file a row in that ledger, and an annotation is not a row. They are
// named here only so a reader of the census reaches them; the ledger files carry the facts.
//
// WHAT EACH ROW AUTHORS IS THEREFORE ONLY WHAT NO AUTHORITY OWNS: which witnesses exercise the
// obligation, what makes them red, and what the seed does outside the obligation's reach. Whether
// those witnesses execute is ASKED, every time the census is folded.

// WHAT THE OBLIGATION IS. RequiredRootLens and RequiredSubtreeLens are the two enrolled rosters in
// v2.compiler.compile; CompileDoor is the door itself, an obligation in its own right because a
// roster is only as reachable as the door it is enrolled behind; DeclaredPrimitiveTraversalFact is
// one row of the closed denominator v2.lens.determinism ranges over, carried per-primitive only for
// the members whose declared order leaves the question open; RealizationCostFidelity is the one
// obligation here that no authority declares at all.
type ObligationKind
  = CompileDoor
  | RequiredRootLens
  | RequiredSubtreeLens
  | DeclaredPrimitiveTraversalFact
  | RealizationCostFidelity

// A WITNESS THIS OBLIGATION IS EXERCISED BY, AT EVERY GRAIN THE THREE AUTHORITIES ANSWER IN. The
// freeze roster keys on ENTRY PATH plus FUNCTION, the exclusion frontier on ENTRY PATH, and the
// required floor's gate closure on MODULE PATH — so a subject that named fewer than all three could
// not be joined against all three. This is the one place the census authors a fact, and it authors
// the keys rather than the answers.
type WitnessSubject {
  entry: NonEmptyStr
  function: NonEmptyStr
  module_path: NonEmptyStr
}

// WHERE AN OBLIGATION EXECUTES ON ONE ROUTE, AND WHY THE NON-EXECUTING ARMS ARE FOUR AND NOT ONE.
// Collapsing them would reproduce exactly the failure gunbc.recurring_failure_mode names as
// non-execution undifferentiated by what it silenced: a witness carved out of discovery by a
// declared exclusion row, a witness frozen as never-executed, an obligation no witness names, and a
// receipt family whose route publishes nothing the acceptance path can spend are four different
// repairs with four different owners, and a single Absent arm would rank none of them.
// THE ARMS, IN ORDER. ExecutedOnPath: discovered by the walk, subtracted by nothing, and its entry
// verified to exist. ExecutedPendingEntryVerification: the same, MINUS the verification — the arm
// every derived row currently takes, and it is a separate arm rather than a footnote on the first
// one because the premise it carries is the one way this derivation can be wrong. ExcludedFromDiscovery: carved out by a gunbc.ci_layer_roots
// witness_exclusion_frontier pattern — the row that does it is derivable from the entry, and
// storing a copy of the pattern here would be the fork this module was rebuilt to remove.
// FrozenPathDeferred: enrolled in the frozen legacy population, declared never-executed and
// admitted with no executing consumer, so Mitigatable at best by construction of the roster it
// sits in. RouteGapHeld: a receipt family exists for this route but publishes nothing the
// acceptance path can spend. NoWitnessNamesIt: no witness names this obligation on this route.
type PathExecution
  = ExecutedOnPath { instrument: NonEmptyStr }
  | ExecutedPendingVerification { instrument: NonEmptyStr, unverified_premises: List<DeclarationRef> }
  | DeclinedOutsideGateClosure { gate: DeclarationRef }
  | RouteOffTheMergePath { drop: DeclarationRef }
  | ExcludedFromDiscovery { frontier: DeclarationRef }
  | FrozenPathDeferred { roster: DeclarationRef }
  | RouteGapHeld { stall: DeclarationRef }
  | NoWitnessNamesIt { note: NonEmptyStr }

// AN OBLIGATION WITH NO HOME IS A MODELING OBLIGATION, NOT A CENSUS ROW WITH A BLANK FIELD. DESIGN
// section 3b draws that line for conformance domains and it applies here: a domain whose home
// authority does not exist is not something to check, it is something to model, and a DeclarationRef
// to a declaration nobody has authored would be a citation defect wearing the shape of coverage.
// NoHomeExists carries the NEAREST authority — the declaration a reader would reach for — with the
// reason it does not own the obligation, so the modeling work has a starting point.
type Home
  = HomeAuthority { authority: DeclarationRef }
  | NoHomeExists { nearest: DeclarationRef, why_it_is_not_the_home: NonEmptyStr }

// THE REACHED-BY-ROUTE AXIS IS DELETED, AND THE RULE THAT DELETED IT IS THIS MODULE'S OWN. It asked
// which EXECUTING route names an obligation's door as a consumer, and it existed to separate two
// facts that really were different while the required-v2-native lane ran: a door a route names, and
// a door a route actually reaches. gunbc#11003 deleted that lane. With no required route naming the
// door, ReachedByNativeRoute had no constructor anywhere in the tree, the predicate was constant
// false, and census_counts published a permanently-zero column.
//
// KEEPING IT WOULD HAVE BEEN THE DECORATION DESIGN section 4b NAMES -- permanently green by
// construction, carrying no information, and worse than absent because it would be cited as
// coverage -- and this same change had already deleted the unread-verdict premise on exactly that
// ground one column over. An earlier cut kept the axis and wrote an annotation CONCEDING it had gone
// constant, which is the rule stated and then not applied; review 63691 named that correctly as the
// module applying its own deletion rule inconsistently.
//
// IT RETURNS WITH THE LANE, from gunbc.rung_drop v2_native_route_off_the_merge_path, which is the
// authority for when a required route names the door again. Until then the native standing carries
// the whole of what this census can say about that route.
// WHAT THE v1 SEED DOES OUTSIDE THE OBLIGATION'S REACH — the column that motivates the census. v2's
// gates read the InferredTree the compile door is handed, and the seed is never handed to that door:
// it is stage0 Rust compiled by rustc. So the reach of every obligation below stops at the corpus v2
// compiles. An escape is CLOSED only when a named declaration brings the seed inside that reach,
// never when the obligation is merely stated more strongly.
type SeedEscape
  = SeedEscapeOpen { what_the_seed_does: NonEmptyStr }
  | SeedEscapeClosed { by: DeclarationRef }

// THE FIELDS THAT ARE NOT SELF-EXPLANATORY. claimed_rung is the rung the obligation's own
// declaration claims for itself, read off that declaration and never off this census. witnesses are
// the entries that exercise it, and their standing is DERIVED rather than stored — see
// interpreted_standing. discriminating_red and positive_control are the input that makes the
// obligation refuse and the input that must still be accepted beside it, both required because a
// refusal with no positive control is satisfied by a mechanism that refuses everything.
// related_drops carries gunbc.rung_drop identities and never restates those rows.
//
// THE native ARM STAYS AUTHORED, and that asymmetry is a finding rather than an oversight: no
// authority in this repository publishes a per-obligation native execution standing to ask, which
// is exactly why the native column is the one this census cannot self-correct the way the
// interpreted column now corrects itself.
type V2CompileObligation {
  identity: NonEmptyStr
  kind: ObligationKind
  home: Home
  claimed_rung: GuaranteeRung
  witnesses: List<WitnessSubject>
  discriminating_red: NonEmptyStr
  positive_control: NonEmptyStr
  ceiling: GuaranteeRung
  next_trigger: NextRungTrigger
  seed_escape: SeedEscape
  related_drops: List<DeclarationRef>
}

data frozen_roster_authority: DeclarationRef = decl_ref(
  module_path: "gunbc.witness_deferral_freeze",
  decl_name: "frozen_path_deferrals"
)

data exclusion_frontier_authority: DeclarationRef = decl_ref(
  module_path: "gunbc.ci_layer_roots",
  decl_name: "witness_exclusion_frontier"
)

data self_host_route_stall: DeclarationRef = decl_ref(
  module_path: "gunbc.guarantee_stall.self_host_wet_route_receipt_lifetime_stall",
  decl_name: "self_host_wet_route_receipt_lifetime_stall"
)

// THE EXCLUSION JOIN REPRODUCES THE HOST RULE EXACTLY RATHER THAN APPROXIMATING IT. The deferred
// discovery walk in v1_compiler.cli_run selects a *_test.dag whose repo-relative path CONTAINS an
// exclusion pattern (`rel.contains(sub)`); string_contains is that same predicate, so this is the
// rule itself asked again, not a second rule that happens to agree today.
fn witness_subject_is_excluded_in(rows: List<WitnessExclusionRow>, w: WitnessSubject) -> Bool {
  fold(
    rows,
    init: false,
    f: fn(found, row) { found || string_contains(s: w.entry, pattern: row.pattern) }
  )
}

fn witness_subject_is_excluded(w: WitnessSubject) -> Bool {
  witness_subject_is_excluded_in(rows: witness_exclusion_frontier, w: w)
}

fn witness_subject_is_frozen(w: WitnessSubject) -> Bool {
  frozen_path_deferral_covers(entry: w.entry, function: w.function)
}

data required_gate_authority: DeclarationRef = decl_ref(
  module_path: "v2.workflow.required_floor",
  decl_name: "required_gate_prefixes"
)

fn witness_subject_is_inside_gate_closure_in(prefixes: List<String>, w: WitnessSubject) -> Bool {
  fold(
    prefixes,
    init: false,
    f: fn(found, prefix) { found || starts_with(s: w.module_path, prefix: prefix) }
  )
}

fn witness_subject_is_inside_gate_closure(w: WitnessSubject) -> Bool {
  witness_subject_is_inside_gate_closure_in(prefixes: required_gate_prefixes(), w: w)
}

// WHAT IS DERIVED, WHAT IS ASSUMED, AND WHY THE ASSUMPTION IS A NAMED ARM RATHER THAN A COMMENT.
// Every entry below is a *_test.dag under dag/ or src/v2/, which is the whole of the discovery
// walk's positive selection, so the remaining questions are exactly the three subtractions — the
// freeze roster, the exclusion frontier, and the required floor's gate closure — and all three are
// ASKED here, of the authorities that own them.
//
// THE THIRD ONE WAS MISSING FROM THE FIRST THREE CUTS, and its absence was the same defect as the
// widen below wearing a bigger coat: the derivation reduced per-PR standing to two questions and
// then reported discovery-reach as execution, while v2.workflow.required_floor
// required_gate_prefixes declines every witness whose MODULE is outside the prepared closure. It
// changes no row's value today — every witness below is under v2.test., which the roster admits —
// and that is precisely why it had to be asked rather than assumed: a subtraction that happens to
// be satisfied is not a subtraction that was checked.
//
// THE PREFIX TEST IS A PREFIX TEST. Two cuts of this module used string_contains here and declared
// the imprecision as debt — first discharged onto the wrong trigger, then given its own. Both were
// answers to a question with a better answer: starts_with IS in the substrate, and
// gunbc.witness_v2_native_route native_route_universe_member calls it for exactly this purpose one
// module over. A declared debt for a capability that already exists is not honesty, it is a
// permanent excuse with a receipt attached — so the premise, its trigger and its number are DELETED
// rather than kept as documentation of a problem that no longer exists.
//
// WHAT IS NOT ASKED is whether the entry file still exists at that path. A moved or deleted entry is
// covered by neither roster, so "not frozen and not excluded" would answer EXECUTING for a witness
// that cannot run — a widen toward coverage at exactly the moment the derivation stops being able to
// decide, which DESIGN section 5 forbids as a failure arm that widens instead of refusing.
//
// SO THE ARM IS LOUD, BOUNDED, AND CARRIES ITS TRIGGER, which is the one carve-out section 5 allows.
// LOUD: the standing is ExecutedPendingEntryVerification, a distinct arm naming the unverified
// premise, never plain ExecutedOnPath — and obligations_executing_on_an_unverified_entry counts it,
// so the debt has a number beside the coverage number rather than hiding inside it. BOUNDED: the
// population is the entries of the rows in this file and nothing else -- obligations_claimed is its
// size -- and it cannot grow with
// the corpus. TRIGGER: entry_existence_verification_trigger below, a typed DissolutionCondition
// naming the capability that retires it — not a sentence in a comment.
//
// AN EARLIER CUT OF THIS PARAGRAPH SAID THE TRIGGER WAS "named on the census's own next_trigger
// below" WHEN NO SUCH DECLARATION EXISTED. That is precisely
// stale_present_tense_coverage_claim_in_the_authority_consulted_first, the class this same change
// files in the ledger, committed inside the module that files it. The repair is the declaration,
// not a softer sentence.
// The three subtractions this module CAN decide. Entry existence is deliberately not folded in here:
// it is a different question with a different owner, and conflating them is what produced the widen.
fn witness_subject_survives_every_subtraction(w: WitnessSubject) -> Bool {
  !witness_subject_is_frozen(w: w)
    && !witness_subject_is_excluded(w: w)
    && witness_subject_is_inside_gate_closure(w: w)
}

// UNBOUND RATHER THAN BOUND, AND NOT BY PREFERENCE. A bound trigger names a declaration whose
// appearance retires the obligation, which is the stronger arm and the one this row wants. It is
// unavailable: v2.compiler.self_host.compile_obligation_activation is being authored separately and
// no module declares it yet, so the citation refuses at the declarations phase as
// CITED-MODULE-ABSENT — a forward reference to a DECLARATION inside an existing module is admitted,
// a reference to a module that does not exist is not. Binding to some other module that happens to
// exist, so the citation resolves, would be a checkable trigger impersonating a decision: it would
// name a home the capability is not going to live in, and it would report fired on the day someone
// added an unrelated declaration there. gunbc.self_host_promotion_obligations reaches the same
// conclusion in its own words for the same reason. Unbound prose that cannot report itself fired is
// the honest arm until the module lands; it is still a typed DissolutionCondition and not a
// sentence in a comment, which is what the review asked for.
data entry_existence_verification_trigger: DissolutionCondition = unbound_dissolution(
  description: "v2.compiler.self_host.compile_obligation_activation declares a reader that answers, for one census row, whether its witness entry is still present in the tree at the path the row names — at which point ExecutedPendingEntryVerification splits into a verified arm and a typed refusal, and obligations_executing_on_an_unverified_entry falls to zero by construction rather than by anyone editing this file" as NonEmptyStr
)

data unverified_entry_premise: DeclarationRef = decl_ref(
  module_path: "gunbc.v2_compile_obligation_census",
  decl_name: "entry_existence_verification_trigger"
)

fn any_witness_survives_every_subtraction(ws: List<WitnessSubject>) -> Bool {
  fold(ws, init: false, f: fn(found, w) { found || witness_subject_survives_every_subtraction(w: w) })
}

fn all_witnesses_frozen(ws: List<WitnessSubject>) -> Bool {
  fold(ws, init: true, f: fn(ok, w) { ok && witness_subject_is_frozen(w: w) })
}

fn all_witnesses_outside_gate_closure(ws: List<WitnessSubject>) -> Bool {
  fold(ws, init: true, f: fn(ok, w) { ok && !witness_subject_is_inside_gate_closure(w: w) })
}

// THE DERIVED INTERPRETED STANDING. Executing wins over every non-executing arm because one
// discovered witness is coverage; among the non-executing arms, frozen is reported only when EVERY
// witness is frozen, so a mixed row reads as excluded rather than claiming a stronger declared
// never-executed standing than its population supports.
fn interpreted_standing(o: V2CompileObligation) -> PathExecution {
  if list_length(items: o.witnesses) == 0 {
    NoWitnessNamesIt {
      note: "no witness in the corpus names this obligation" as NonEmptyStr
    }
  } else {
    if any_witness_survives_every_subtraction(ws: o.witnesses) {
      ExecutedPendingVerification {
        instrument: "claim_executor --required-ci --source-root dag --source-root src/v2: the discovery walk reaches this entry, no exclusion row and no freeze row subtracts it, and its module reads as inside the required floor's gate closure" as NonEmptyStr,
        unverified_premises: [unverified_entry_premise]
      }
    } else {
      if all_witnesses_frozen(ws: o.witnesses) {
        FrozenPathDeferred { roster: frozen_roster_authority }
      } else {
        if all_witnesses_outside_gate_closure(ws: o.witnesses) {
          DeclinedOutsideGateClosure { gate: required_gate_authority }
        } else {
          ExcludedFromDiscovery { frontier: exclusion_frontier_authority }
        }
      }
    }
  }
}

// THE NATIVE COLUMN IS NOW DERIVED TOO, AND THE ANSWER CHANGED. Every earlier cut of this module
// reported RouteGapHeld on every row, on the true observation that the self-host behavioral receipt
// family publishes nothing the acceptance path can spend. That is still true of THAT family and it
// is no longer the whole native story: gunbc#10882 landed the required-v2-native lane, whose subject
// is the emitted compiler binary executing a derived v2.test.* population through its own
// SourceRootEvalDriver and reaching a terminal NativeTestVerdict per identity. A lens gate exercised
// by one of those tests runs INSIDE THE EMITTED BINARY, which is native execution of the obligation
// in the only sense the census ever meant.
//
// SO THE ROSTER IS ASKED, NOT ASSUMED, exactly like the interpreted column: the lane declares its
// own universe predicate, gunbc.witness_v2_native_route native_route_universe_member, and this
// module calls it rather than re-deriving the prefix. A census that hand-authored "RouteGapHeld"
// after the lane landed would have been the stale present-tense coverage claim in reverse — a
// pessimistic one, which is not more honest, only wrong in the safer direction.
//
// WHAT THE LANE WOULD HAVE LEFT PENDING, AND WHY THAT QUESTION IS MOOT WHILE IT IS OFF THE MERGE
// PATH. When the lane was required, membership said the emitted binary executes the identity and said
// nothing about which verdict it reached, so the native arm carried an unread-verdict premise and a
// count beside the coverage number. That premise, its trigger and its fold are DELETED rather than
// kept: with no required invocation there is no execution to be pending about, and a premise nobody
// can reach is the dangling declaration DESIGN section 3c calls red -- machinery describing a state
// that cannot occur. They return with the lane, from the drop row that owns its return.
//
// THE SELF-HOST RECEIPT FAMILY IS WHY THE NON-MEMBER ARM IS RouteGapHeld AND NOT SOMETHING SOFTER —
// and it is now the arm for rows the lane does NOT reach, rather than for every row. The only
// behavioral receipt the emitted crate publishes for v2.compiler.compile is the self_host_00_compile
// shim, and its case list has ONE entry: required_lens_grain_note, the prose string describing the
// two roster grains, compared against a nine-line seed module whose whole content is that same
// string. Not one gate is invoked, so even a spendable receipt would not move if every gate were
// deleted. A row outside the lane's population has that and nothing else.
// THE DORMANCY GETS A TYPED TRIGGER TOO, because this module already ruled on exactly this
// asymmetry one premise over: the repair is the declaration, not a softer sentence. The census's
// only executing evidence is a witness that is DeclinedOutsideGateClosure on every required run and
// is otherwise selected only when the diff edits its own test functions -- so a later change to
// interpreted_standing, native_standing or witness_subject_in_native_lane runs no check at all. That
// was stated in prose while its two sibling premises carried DissolutionConditions, which is the
// same softer-sentence move, one layer up.
data witness_dormancy_trigger: DissolutionCondition = unbound_dissolution(
  description: "the census's derivation is checked by something a required run reaches: either test.claim.v2_compile_obligation_census_witness_test is admitted by a v2.workflow.required_floor required_gate_prefixes row -- which is an operator-priced roster this module may not grow on its own authority, and proposing it from inside the diff that benefits would be the move this census exists to object to -- or the obligation-coverage receipt that consumes census_counts lands on a required lane and takes the derivation with it. Until one of the two, editing the folds without editing the arms that check them is unguarded" as NonEmptyStr
)

// THE LANE LANDED AND WAS THEN DELETED, AND THE CENSUS FOLLOWED BOTH MOVES RATHER THAN ONE. gunbc#10882
// made the native column report execution and this module was rebuilt to say so; gunbc#11003 then
// deleted the required-v2-native JOB on an operator ruling -- the only full run on the real runner
// class took over four hours at 14.8 GB and the workflow's concurrency group never supersedes a
// running job, so every push added another claimant. The route model, harness and admission authority
// are unchanged and still reachable when someone invokes them; what left is the REQUIRED LANE.
//
// SO LANE MEMBERSHIP NO LONGER MEANS EXECUTION ON AN ACCEPTANCE PATH, and reporting it as executing
// would be this census's own headline defect for the second time in two days, in the same column,
// with the sign reversed: once when the lane landed and the module still said zero, once now when the
// lane is gone and the module would still say nine. The arm cites gunbc.rung_drop
// v2_native_route_off_the_merge_path, which is the authority for when the lane returns; this module
// does not restate its trigger.
data native_route_merge_path_drop: DeclarationRef = decl_ref(
  module_path: "gunbc.rung_drop.v2_native_route_off_the_merge_path",
  decl_name: "v2_native_route_off_the_merge_path"
)

// LANE MEMBERSHIP IS THE PREFIX INTERSECTED WITH FLOOR DISCOVERY, NOT THE PREFIX ALONE, and the
// first cut of this fold got it wrong in the direction that flatters. native_route_universe_member
// is the lane's PREDICATE over a module name; the lane's own header states that the population it
// applies to is "derived by the host harness from the floor's own discovery producer joined against
// each entry's authored module header". So an entry a gunbc.ci_layer_roots witness_exclusion_frontier
// pattern carves out of discovery never reaches the native harness either, however well its module
// name matches. Asking only the predicate reported 11 obligations executing natively and two of them
// — accumulator_copy and mandatory_tag — are exactly the rows carved out by "claim/complexity/
// accumulator_copy_roster_gate" and "test/claim/long/". Reporting those two as natively executing
// would have been this census's own headline defect, committed in the column the census exists to
// make honest, on the first fold written after the lane landed.
//
// FREEZE IS DELIBERATELY NOT APPLIED HERE. A gunbc.witness_deferral_freeze row is an admission fact
// about the required floor's execution standing, not about the discovery walk, so there is no
// warrant to assume the native harness consults it. It happens not to matter today — every frozen
// subject below is also excluded — and where a fact is not established the narrower claim is the
// honest one.
fn witness_subject_in_native_lane(w: WitnessSubject) -> Bool {
  !witness_subject_is_excluded(w: w) && native_route_universe_member(module_qn: w.module_path)
}

fn any_witness_in_native_lane(ws: List<WitnessSubject>) -> Bool {
  fold(ws, init: false, f: fn(found, w) { found || witness_subject_in_native_lane(w: w) })
}

fn native_standing(o: V2CompileObligation) -> PathExecution {
  if list_length(items: o.witnesses) == 0 {
    NoWitnessNamesIt {
      note: "no witness names this obligation, so the native lane has no identity to execute for it" as NonEmptyStr
    }
  } else {
    if any_witness_in_native_lane(ws: o.witnesses) {
      RouteOffTheMergePath { drop: native_route_merge_path_drop }
    } else {
      RouteGapHeld { stall: self_host_route_stall }
    }
  }
}

// A RUNG-DROP CITATION IS A TYPED REFERENCE, NOT A NAME. The first cut carried these as bare
// NonEmptyStr identities while every other citation in this module was a DeclarationRef, which is
// the exact shape this ledger files as unlanded_citation_indistinguishable_at_the_citing_end: a
// prose identity resolves today and nothing can tell when it stops. The row files are one
// declaration per module under gunbc.rung_drop, named for the identity they carry, so the reference
// is mechanical.
fn rung_drop_ref(identity: String) -> DeclarationRef {
  decl_ref(module_path: concat("gunbc.rung_drop.", identity), decl_name: identity)
}

// THE SIX ROWS WHOSE ONLY REMAINING WALL IS THE NATIVE DOOR SHARE ONE TRIGGER, for the same reason
// the shared native trigger is one capability, and six
// copies of it would drift on the first correction — five sites updated, one left behind, which is
// the failure this ledger already carries as declared_trigger_names_a_term_that_is_not_the_cause.
data native_door_entry_trigger: NextRungTrigger = climbs_when(capability: "the emitted native lane's admitted subjects stop refusing at resolve, so compile_source_root_ingest_with_admission actually enters validate_then_compile and this gate is asked about an authored module. THAT IS THE WHOLE REMAINING CAPABILITY FOR THIS ROW: its witnesses are already discovered and already run on the interpreted per-PR route, so no discovery, exclusion or freeze change moves it — the executed rung is held down by the native path alone, and DESIGN section 4b(1) takes the MINIMUM across paths. AND ENTERING THE DOOR IS NECESSARY BUT NOT SUFFICIENT: what this census can then report is route coverage, so the rung this row reaches on the ladder additionally needs v2.compiler.self_host.compile_obligation_activation to require red-and-green execution receipts before MechanicallyPreventable is reportable at all")

fn witness_subject(entry: String, function: String, module_path: String) -> WitnessSubject {
  WitnessSubject {
    entry: entry as NonEmptyStr,
    function: function as NonEmptyStr,
    module_path: module_path as NonEmptyStr
  }
}
