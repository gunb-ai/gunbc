  ceiling: StructurallyGuaranteed,
  next_trigger: "the same production routing that closes the map_keys row closes this one; they are one trigger and are written twice only because they are two declared primitives" as NonEmptyStr,
  seed_escape: SeedEscapeOpen {
    what_the_seed_does: "the seed reads map values directly in emission and ordering code with no gate between" as NonEmptyStr
  },
  related_drops: [],
}

data v2_compile_obligation_census: List<V2CompileObligation> = [
  compile_door_obligation,
  accumulator_copy_obligation,
  determinism_obligation,
  machine_shape_obligation,
  mandatory_tag_obligation,
  undecidable_verdict_collapse_obligation,
  fact_density_obligation,
  unit_modeling_obligation,
  lifecycle_carrier_obligation,
  primitive_index_by_obligation,
  primitive_map_keys_obligation,
  primitive_map_values_obligation,
]

// THE THREE NUMBERS THE OPERATOR ASKED FOR, DERIVED AND NEVER TRANSCRIBED. Each is a fold over the
// roster above, so a row added, removed or re-dispositioned moves the number and no second place
// records it.
fn obligations_claimed() -> Int {
  list_length(items: v2_compile_obligation_census)
}

fn obligation_executes_natively(o: V2CompileObligation) -> Bool {
  match o.native {
    ExecutedOnPath { instrument: _ } => true
    OutsideDiscoveryScope { scope_authority: _, home_dir: _ } => false
    FrozenPathDeferred { roster: _ } => false
    RouteGapHeld { stall: _ } => false
    NoWitnessNamesIt { note: _ } => false
  }
}

fn obligation_executes_interpreted(o: V2CompileObligation) -> Bool {
  match o.interpreted {
    ExecutedOnPath { instrument: _ } => true
    OutsideDiscoveryScope { scope_authority: _, home_dir: _ } => false
    FrozenPathDeferred { roster: _ } => false
    RouteGapHeld { stall: _ } => false
    NoWitnessNamesIt { note: _ } => false
  }
}

fn obligation_seed_escape_is_open(o: V2CompileObligation) -> Bool {
  match o.seed_escape {
    SeedEscapeOpen { what_the_seed_does: _ } => true
    SeedEscapeClosed { by: _ } => false
  }
}

fn obligations_executing_natively() -> Int {
  list_length(items: filter(v2_compile_obligation_census, o => obligation_executes_natively(o: o)))
}

fn obligations_executing_interpreted() -> Int {
  list_length(items: filter(v2_compile_obligation_census, o => obligation_executes_interpreted(o: o)))
}

fn obligations_with_open_seed_escape() -> Int {
  list_length(items: filter(v2_compile_obligation_census, o => obligation_seed_escape_is_open(o: o)))
}

// THE EXECUTED RUNG OF AN OBLIGATION IS THE MINIMUM ACROSS ITS IN-SCOPE PATHS (DESIGN section
// 4b(1)), and with both paths non-executing that minimum is Mitigatable regardless of what the
// obligation's own declaration claims. This function is the census's whole verdict: it reads the
// two path arms and NOT the claimed_rung field, so a row cannot raise its own executed rung by
// restating its claim.
fn obligation_executed_rung(o: V2CompileObligation) -> GuaranteeRung {
  if obligation_executes_natively(o: o) && obligation_executes_interpreted(o: o) {
    MechanicallyPreventable
  } else {
    Mitigatable
  }
}

// ROW WELL-FORMEDNESS IS STRUCTURALLY IMPOSSIBLE TO VIOLATE, AND THE CHECK FOR IT WAS DELETED
// RATHER THAN SHIPPED. The first cut of this module carried an obligation_row_is_well_formed
// predicate asserting that identity, discriminating_red, positive_control, next_trigger and each
// arm's authority were non-empty, with fixture reds handing it empty strings. Those reds do not
// compile: every one of those fields is NonEmptyStr, `"" as NonEmptyStr` is refused at typecheck,
// and DeclarationRef's own fields are NonEmptyStr too — so the invalid state has no constructor
// anywhere the check could run, in the accepted corpus OR at the fixture boundary. DESIGN section
// 4b names that exactly: a check whose RED is unauthorable is not a weak wall but a decoration,
// permanently green by construction, and worse than absent because it would be cited as coverage.
// The honest reading is that this class already sits at rung 4 and needs no validator. What DOES
// need one is the pair of judgments below, whose reds are authorable and are authored in
// test.claim.v2_compile_obligation_census_witness_test.

// TWO FINDINGS THIS CENSUS SURFACED THAT ARE NOT ROWS, RECORDED HERE RATHER THAN REPAIRED. The
// brief that produced this module is read-only measurement; both belong to the authorities that own
// them and are named so the owning lane can act.
//
// FINDING 1 — A STALE PRESENT-TENSE COVERAGE CLAIM IN THE COMPILE DOOR'S OWN ANNOTATION. The
// annotation above always_required_root_lenses in v2.compiler.compile explains that lens_module_gate
// was de-enrolled from the root roster and adds, present tense, that "enforcement is NOT reduced:
// the invariant executes per-PR via its honestly-stamped consumer
// v2.test.claim.enforcement.lens_module_gate_witness". That sentence is false on two independent
// grounds, either of which alone would be sufficient: the entry is enrolled in
// gunbc.witness_deferral_freeze, which means declared never-executed, AND src/v2/test/claim/enforcement
// is not one of the three directories gunbc.ci_layer_roots witness_discovery_scan_dirs walks. A
// reader consulting the door's own annotation to answer "is this invariant still covered" is told
// YES. This is the same class gunbc.ci_layer_roots excl_bin_wet_reason corrected on itself in
// 2026-08-19, appearing here in the authority a reader consults first.
//
// FINDING 2 — THE NATIVE BEHAVIORAL RECEIPT FOR THE COMPILE DOOR COMPARES A PROSE STRING. The
// self_host_00_compile shim's case list has exactly one entry, required_lens_grain_note, and the
// seed side of that comparison is a nine-line Rust module whose whole content is the same sentence.
// The receipt is well built — it carries an --inject-fault arm and a real positive control — but its
// subject is the note ABOUT the lens rosters rather than any gate in them. So the strongest verdict
// the emitted crate can currently publish about v2's compile door is that two copies of a sentence
// agree, and the census's native column is RouteGapHeld on every row for a reason that is upstream
// of the route gap: even with a spendable receipt, nothing in that comparison would move if every
// gate were deleted.
