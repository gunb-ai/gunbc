// THE FIRST SPECIMEN WHERE A DECLARED DROP'S RESTORATION TRIGGER HAS A MEASURED CONSEQUENCE, and
// the reason the determinism obligation has TWO open escapes rather than one. Measured on
// gunbc#10941: the emitter's nondeterministic re-export walk is v1.05_emit_core_support
// unique_strings — a fold over a membership map — and NOT a call to any declared primitive. So the
// determinism gate would not have classified that site even if it covered the seed: the site is
// outside the declared-primitive denominator entirely, and it is classified safe BY
// NON-MEMBERSHIP, which is the door beside the wall that v2.lens.determinism compile_gate_law
// already names in its own terms.
//
// WHAT WOULD REACH IT IS EXACTLY THE DROPPED WALK. An order-exposing fold that is not a primitive
// is only reachable by following callee edges out of the declaration under test, and that traversal
// is gunbc.rung_drop determinism_transitive_reachability — currently DeletedWithoutReplacement,
// with a restoration trigger at cost-shape grain. This row is that drop's consequence stated as an
// obligation rather than as a note on the drop, because the drop's job is to record what was lost
// and this census's job is to record what is therefore unguarded.
//
// THE ESCAPE IS NOT SEED-ONLY, WHICH IS WHY IT IS A SEPARATE ROW AND NOT A SECOND SENTENCE ON THE
// DETERMINISM ROW. The seed-side escape is a program the gate is never handed. This one is a
// construct the gate would not classify even on a program it WAS handed, so it survives the day
// the door starts seeing authored modules. Two escapes, two repairs, two triggers.
data determinism_non_primitive_fold_obligation: V2CompileObligation = V2CompileObligation {
  identity: "determinism_non_primitive_order_exposing_fold" as NonEmptyStr,
  kind: RequiredRootLens,
  home: HomeAuthority { authority: decl_ref(module_path: "v2.lens.determinism", decl_name: "determinism_compile_gate") },
  claimed_rung: MechanicallyPreventable,
  discriminating_red: "a tree whose declaration calls an order-exposing fold that is not a declared primitive — v1.05_emit_core_support unique_strings is the measured specimen — which the gate must refuse rather than classify Deterministic by non-membership" as NonEmptyStr,
  positive_control: "the same fold rewritten over a sorted key list, which must be accepted; without it a gate that refused every fold would satisfy the red above" as NonEmptyStr,
  witnesses: [],
  native: lens_native_execution,
  route_reach: lens_native_route_reach,
  ceiling: StructurallyGuaranteed,
  next_trigger: "gunbc.rung_drop determinism_transitive_reachability is retired BY ITS OWN TRIGGER — a callee-edge walk whose cost is proportional to what it reaches rather than to the pool it is handed — so a non-primitive order-exposing fold is reachable from the declaration under test" as NonEmptyStr,
  seed_escape: SeedEscapeOpen {
    what_the_seed_does: "the seed emitter ran exactly this construct and produced different bytes from the same sha on the same host, 2 of 172 files. The class is live and observed, and it escapes on BOTH counts at once: the emitter is a program the gate is never handed, and unique_strings is a construct the gate would not classify even if it were" as NonEmptyStr
  },
  related_drops: [rung_drop_ref(identity: "determinism_transitive_reachability")],
}

// THE ONE OBLIGATION IN THIS CENSUS WITH NO HOME, AND THE ONLY ONE WHOSE ESCAPE RUNS IN BOTH
// DIRECTIONS. DESIGN section 4b lists "a realization that does not preserve modeled behavior" among
// the differentiating classes v2 exists to make impossible, and cost shape is modeled: std.algebra
// carries CostShape on its method templates. What is missing is the JOIN — no declaration anywhere
// says that an emitted realization must preserve the cost shape its authority declares, and nothing
// compares the two. So this is a modeling obligation (section 6), not a conformance row, and the
// home field says so rather than citing a declaration that would have to be invented to be cited.
//
// MEASURED, AND IT DIVERGES BOTH WAYS AT ONCE, which is what makes it a class rather than a bug.
// v2.std.algebra list_append is O(n) in the authority and O(n^2) in the seed-emitted Rust
// (fold_list_right with a clone and a Vec insert at position 0 per element); list_snoc_item is O(n)
// in the authority, because it is defined via list_append, and O(1) amortized in the emitted Rust,
// because the seed intercepts it to a push. Both directions defeat the lens for the same structural
// reason: the accumulator-copy lens reads the AUTHORITY, so it convicts the realization that is
// actually fast and is blind to the one that is actually quadratic. A lens that reads one side of a
// pair cannot police the pair.
//
// WHY IT IS FILED HERE RATHER THAN AS A BARE-MINIMUM-COST FINDING. DESIGN section 6's bare-minimum
// cost rule already says a proven cost-shape defect is always fixed regardless of realized n, and
// the list_append instance is being fixed under it. That rule governs the INSTANCE. This row is the
// CLASS: the rule cannot fire on a divergence nobody can see, and nothing in the corpus can see this
// one.
data realization_cost_fidelity_obligation: V2CompileObligation = V2CompileObligation {
  identity: "realization_preserves_modeled_cost_shape" as NonEmptyStr,
  kind: RealizationCostFidelity,
  home: NoHomeExists {
    nearest: decl_ref(module_path: "std.algebra", decl_name: "CostShape"),
    why_it_is_not_the_home: "CostShape declares what an operation's cost shape IS on the algebra template; nothing declares that a realization must preserve it, and no consumer compares an authority's declared shape to the shape of the code emitted for it. The nearest authority models one side of a comparison that has no second side" as NonEmptyStr
  },
  claimed_rung: OutsideTheLadder,
  discriminating_red: "a declaration whose authority declares one cost shape and whose emitted realization has another — v2.std.algebra list_append, O(n) declared and O(n^2) emitted, is the measured specimen — which some consumer must refuse" as NonEmptyStr,
  positive_control: "a declaration whose emitted realization matches its declared shape, which must be accepted; and the second specimen, list_snoc_item, whose realization is FASTER than its authority, must also be reported rather than silently passed, or the check is a one-sided ratchet rather than a fidelity comparison" as NonEmptyStr,
  witnesses: [],
  native: NoWitnessNamesIt {
    note: "same absence; the native route cannot execute a comparison nothing declares" as NonEmptyStr
  },
  route_reach: NotNamedByAnyExecutingRoute {
    note: "no door carries this obligation, so no route names it" as NonEmptyStr
  },
  ceiling: StructurallyGuaranteed,
  next_trigger: "a declaration is authored that joins an authority's declared CostShape to the cost shape of the realization emitted for it, at which point this row gets a home and stops being a modeling obligation" as NonEmptyStr,
  seed_escape: SeedEscapeOpen {
    what_the_seed_does: "the escape IS the seed's own intercept table — v1.05_emit_rust emit_typed_call builtins — which substitutes a host realization for the modeled one at emission time. That substitution is where both divergences are introduced, and it is the one place no lens reads" as NonEmptyStr
  },
  related_drops: [],
}

data v2_compile_obligation_census: List<V2CompileObligation> = [
  compile_door_obligation,
  accumulator_copy_obligation,
  determinism_obligation,
  determinism_non_primitive_fold_obligation,
  machine_shape_obligation,
  mandatory_tag_obligation,
  undecidable_verdict_collapse_obligation,
  fact_density_obligation,
  unit_modeling_obligation,
  lifecycle_carrier_obligation,
  primitive_index_by_obligation,
  primitive_map_keys_obligation,
  primitive_map_values_obligation,
  realization_cost_fidelity_obligation,
]

fn path_execution_is_executing(p: PathExecution) -> Bool {
  match p {
    ExecutedOnPath { instrument: _ } => true
    ExcludedFromDiscovery { frontier: _ } => false
    FrozenPathDeferred { roster: _ } => false
    RouteGapHeld { stall: _ } => false
    NoWitnessNamesIt { note: _ } => false
  }
}

fn obligation_executes_natively(o: V2CompileObligation) -> Bool {
  path_execution_is_executing(p: o.native)
}

fn obligation_executes_interpreted(o: V2CompileObligation) -> Bool {
  path_execution_is_executing(p: interpreted_standing(o: o))
}

fn obligation_is_reached_by_the_native_route(o: V2CompileObligation) -> Bool {
  match o.route_reach {
    ReachedByNativeRoute { driver: _, upstream_refusal: _ } => true
    NotNamedByAnyExecutingRoute { note: _ } => false
  }
}

fn obligation_seed_escape_is_open(o: V2CompileObligation) -> Bool {
  match o.seed_escape {
    SeedEscapeOpen { what_the_seed_does: _ } => true
    SeedEscapeClosed { by: _ } => false
  }
}

fn obligation_has_a_home(o: V2CompileObligation) -> Bool {
  match o.home {
    HomeAuthority { authority: _ } => true
    NoHomeExists { nearest: _, why_it_is_not_the_home: _ } => false
  }
}

fn obligations_claimed() -> Int {
  list_length(items: v2_compile_obligation_census)
}

fn obligations_executing_interpreted() -> Int {
  list_length(items: filter(v2_compile_obligation_census, o => obligation_executes_interpreted(o: o)))
}

fn obligations_executing_natively() -> Int {
  list_length(items: filter(v2_compile_obligation_census, o => obligation_executes_natively(o: o)))
}

fn obligations_reached_by_the_native_route() -> Int {
  list_length(
    items: filter(v2_compile_obligation_census, o => obligation_is_reached_by_the_native_route(o: o))
  )
}

fn obligations_with_open_seed_escape() -> Int {
  list_length(items: filter(v2_compile_obligation_census, o => obligation_seed_escape_is_open(o: o)))
}

// An obligation with no home is not a check that is failing; it is a model that does not exist, and
// it ranks against modeling work rather than against enforcement work.
fn obligations_without_a_home() -> Int {
  list_length(items: filter(v2_compile_obligation_census, o => !obligation_has_a_home(o: o)))
}

// THE EXECUTED RUNG IS THE MINIMUM ACROSS THE IN-SCOPE PATHS (DESIGN section 4b(1)), and this
// function reads the two path arms and NOT claimed_rung — so a row cannot raise its own executed
// rung by restating its claim. With the native arm non-executing on every row today, every executed
// rung here is Mitigatable however strongly the obligation's own declaration speaks.
fn obligation_executed_rung(o: V2CompileObligation) -> GuaranteeRung {
  if obligation_executes_natively(o: o) && obligation_executes_interpreted(o: o) {
    MechanicallyPreventable
  } else {
    Mitigatable
  }
}

// WHO CONSUMES THE COUNTS, STATED AS A DECLARED FRONTIER RATHER THAN LEFT IMPLICIT (DESIGN section
// 3c). Today the six counts have exactly one executing consumer and it is a human running
// census_counts; the WITNESS consumes the derivation beneath them — witness_subject_executes_per_pr,
// interpreted_standing and obligation_executes_natively all execute in
// test.claim.v2_compile_obligation_census_witness_test — but no required run reads a count. That is
// the admissible middle state of section 3c and not the red one only because the later consumer and
// its trigger are named here: the counts become a receipt line when the required floor publishes an
// obligation-coverage receipt alongside its claim results, at which point census_counts is that
// receipt's producer and this paragraph deletes.
//
// WHY THEY ARE NOT ROUTED INTO A REQUIRED RUN TODAY. Enrolling a count as its own gated row would
// put a second enrollment surface beside the witness that already executes the derivation, for a
// fact the witness already establishes — the section 3 duplication this module was rebuilt to
// remove, one layer up. The number is a projection of a checked derivation, not an independent
// claim, and a projection earns a gate when something consumes it, not before.

// THE COMPARISON THIS CENSUS IS NAMED FOR, AND IT WAS MISSING FROM THE FIRST TWO CUTS. Claimed
// versus executing is the whole point of the roster, and until this fold existed claimed_rung was
// authored on all fourteen rows and read by nothing — DESIGN section 3c's red arm, not its
// admissible middle, and a title the diff did not make true. Review 63176 named it.
//
// INFLATION IS A STRICT INEQUALITY, NOT A DISAGREEMENT. A row whose declaration claims LESS than its
// paths establish is not inflated — it is under-claimed, which is honest and costs nothing — so only
// claimed > executed counts. DESIGN section 4b(1): the reported rung must EQUAL the rung executed
// evidence establishes, and citing the stronger side while another path stays silent is the
// inflation, which is worse than sitting low because an inflated class never ranks for climbing.
fn guarantee_rung_rank(r: GuaranteeRung) -> Int {
  match r {
    OutsideTheLadder => 0
    Mitigatable => 1
    MechanicallyPreventable => 2
    StructurallyGuaranteed => 3
    StructurallyImpossible => 4
  }
}

fn obligation_rung_is_inflated(o: V2CompileObligation) -> Bool {
  guarantee_rung_rank(r: o.claimed_rung) > guarantee_rung_rank(r: obligation_executed_rung(o: o))
}

fn obligations_with_inflated_rung() -> Int {
  list_length(items: filter(v2_compile_obligation_census, o => obligation_rung_is_inflated(o: o)))
}

// A CEILING BELOW THE CLAIM IS AN INCOHERENT ROW, and it is checkable where emptiness was not. DESIGN
// section 4b makes the ceiling the highest honest rung a class's facts and decidability permit, so a
// row claiming above its own ceiling has asserted something its own record says is unreachable. The
// RED is authorable at the fixture boundary and is authored there.
fn obligation_claim_exceeds_its_ceiling(o: V2CompileObligation) -> Bool {
  guarantee_rung_rank(r: o.claimed_rung) > guarantee_rung_rank(r: o.ceiling)
}

fn obligations_claiming_above_their_ceiling() -> Int {
  list_length(
    items: filter(v2_compile_obligation_census, o => obligation_claim_exceeds_its_ceiling(o: o))
  )
}

fn obligation_kind_label(k: ObligationKind) -> String {
  match k {
    CompileDoor => "compile-door"
    RequiredRootLens => "root-lens"
    RequiredSubtreeLens => "subtree-lens"
    DeclaredPrimitiveTraversalFact => "primitive-traversal-fact"
    RealizationCostFidelity => "realization-cost-fidelity"
  }
}

fn path_execution_label(p: PathExecution) -> String {
  match p {
    ExecutedOnPath { instrument: _ } => "executes"
    ExcludedFromDiscovery { frontier: _ } => "excluded-from-discovery"
    FrozenPathDeferred { roster: _ } => "frozen-deferral"
    RouteGapHeld { stall: _ } => "route-gap-held"
    NoWitnessNamesIt { note: _ } => "no-witness-names-it"
  }
}

// THE REPORT IS THE RECORD'S CONSUMER, and it exists because a census whose fields nobody reads is
// the redundant work DESIGN section 2 prices. Every authored field that is not already folded by a
// count is rendered here — kind, claimed rung, the two path standings, the ceiling, the count of
// rung-drop citations, and the trigger — so a repair lane reads one line per obligation instead of
// the source. discriminating_red and positive_control are deliberately NOT rendered: they are
// paragraphs, and a report that inlined them would be the source with worse formatting. They are
// read at the row, which is where a lane that has already chosen its obligation is looking.
fn obligation_report_line(o: V2CompileObligation) -> String {
  concat(
    concat(concat(o.identity as String, " kind="), obligation_kind_label(k: o.kind)),
    concat(
      concat(" claimed=", guarantee_rung_label(r: o.claimed_rung)),
      concat(
        concat(" executed=", guarantee_rung_label(r: obligation_executed_rung(o: o))),
        concat(
          concat(" interpreted=", path_execution_label(p: interpreted_standing(o: o))),
          concat(
            concat(" native=", path_execution_label(p: o.native)),
            concat(
              concat(" ceiling=", guarantee_rung_label(r: o.ceiling)),
              concat(
                concat(" related_drops=", to_string(list_length(items: o.related_drops))),
                concat(" trigger=", o.next_trigger as String)
              )
            )
          )
        )
      )
    )
  )
}

// gunbc run --source-root dag --source-root src/v2 \
//   --entry dag/gunbc/v2_compile_obligation_census.dag --function census_report
fn census_report() -> String {
  fold(
    v2_compile_obligation_census,
    init: "",
    f: (acc, o) => concat(concat(acc, obligation_report_line(o: o)), "\n")
  )
}

// THE INSTRUMENT. One entry point that re-derives every number this census reports, so a reader
// spends one run rather than six and a citation names a producer rather than a table (DESIGN
// section 6). The folds above remain the authority; this is their projection and adds no fact.
//
//   gunbc run --source-root dag --source-root src/v2 \
//     --entry dag/gunbc/v2_compile_obligation_census.dag --function census_counts
//
// gunbc run refuses a non-ProcessExit return and PRINTS THE VALUE IN THE REFUSAL; read it there.
fn census_counts() -> String {
  concat(
    concat("claimed=", to_string(obligations_claimed())),
    concat(
      concat(" reached_by_native_route=", to_string(obligations_reached_by_the_native_route())),
      concat(
        concat(" executing_natively=", to_string(obligations_executing_natively())),
        concat(
          concat(" executing_interpreted=", to_string(obligations_executing_interpreted())),
          concat(
            concat(" seed_escape_open=", to_string(obligations_with_open_seed_escape())),
            concat(
              concat(" without_a_home=", to_string(obligations_without_a_home())),
              concat(
                concat(" inflated_rung=", to_string(obligations_with_inflated_rung())),
                concat(" claiming_above_ceiling=", to_string(obligations_claiming_above_their_ceiling()))
              )
            )
          )
        )
      )
    )
  )
}
