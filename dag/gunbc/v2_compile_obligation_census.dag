  claimed_rung: MechanicallyPreventable,
  discriminating_red: "a tree collapsing an undecidable verdict into a decided one, which the gate must refuse rather than absorb" as NonEmptyStr,
  positive_control: "a tree keeping the undecided arm distinct, which must compile" as NonEmptyStr,
  interpreted: OutsideDiscoveryScope {
    scope_authority: discovery_scope_authority,
    home_dir: "src/v2/test/claim" as NonEmptyStr
  },
  native: lens_native_execution,
