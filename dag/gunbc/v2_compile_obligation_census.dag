module gunbc.v2_compile_obligation_census

import std.types { Bool, Int, List, NonEmptyStr, String, list_length }
import std.decl_ref { DeclarationRef, decl_ref }
import gunbc.guarantee_rung {
  GuaranteeRung,
  guarantee_rung_label,
  OutsideTheLadder,
  Mitigatable,
  MechanicallyPreventable,
  StructurallyGuaranteed
}
import gunbc.witness_deferral_freeze { frozen_path_deferral_covers }
import gunbc.ci_layer_roots { WitnessExclusionRow, witness_exclusion_frontier }

// WHY THIS CENSUS EXISTS, IN ONE SENTENCE THE OPERATOR ASKED FOR (2026-09-10): v2 exists so that
// classes like nondeterministic emission are UNWRITABLE, and this roster says, per compile-time
// obligation v2 declares, whether that is true ON A ROUTE THAT EXECUTES or only claimed in a
// declaration nobody runs.
//
// THE DISPOSITIONS ARE DERIVED, NOT AUTHORED, AND THE FIRST CUT OF THIS MODULE PROVED WHY. That cut
// hand-wrote each row's interpreted standing from a reading of gunbc.ci_layer_roots
// witness_discovery_scan_dirs, and the reading was WRONG: that declaration has exactly one consumer
// in v1_compiler.cli_run and it is inside a cfg(test) module asserting the authority's own value.
// The walk that actually discovers witnesses takes every *_test.dag under witness_layer_roots
// (dag, src/v2) and subtracts gunbc.ci_layer_roots witness_exclusion_frontier by substring. So six
// obligations this census reported as unreachable are discovered and running, and the error was
// invisible precisely because the disposition was a sentence rather than a question put to the
// authority that owns it. DESIGN section 3: a fork is a correctness concern, not a style one — and
// the correctness it cost here was the census's headline number.
//
// TWO FINDINGS THIS CENSUS SURFACED THAT ARE NOT ROWS. Both are filed as their own classes under
// dag/gunbc/recurring_failure_mode/ — stale_present_tense_coverage_claim_in_the_authority_consulted_first
// and receipt_subject_is_the_prose_about_the_mechanism — because DESIGN section 4b requires a
// discovered error class to file a row in that ledger, and an annotation is not a row. They are
// named here only so a reader of the census reaches them; the ledger files carry the facts.
//
// WHAT EACH ROW AUTHORS IS THEREFORE ONLY WHAT NO AUTHORITY OWNS: which witnesses exercise the
// obligation, what makes them red, and what the seed does outside the obligation's reach. Whether
// those witnesses execute is ASKED, every time the census is folded.

// WHAT THE OBLIGATION IS. RequiredRootLens and RequiredSubtreeLens are the two enrolled rosters in
// v2.compiler.compile; CompileDoor is the door itself, an obligation in its own right because a
// roster is only as reachable as the door it is enrolled behind; DeclaredPrimitiveTraversalFact is
// one row of the closed denominator v2.lens.determinism ranges over, carried per-primitive only for
// the members whose declared order leaves the question open; RealizationCostFidelity is the one
// obligation here that no authority declares at all.
type ObligationKind
  = CompileDoor
  | RequiredRootLens
  | RequiredSubtreeLens
  | DeclaredPrimitiveTraversalFact
  | RealizationCostFidelity

// A WITNESS THIS OBLIGATION IS EXERCISED BY, AT THE GRAIN THE AUTHORITIES ANSWER IN. Both the
// freeze roster and the exclusion frontier key on the ENTRY PATH — the freeze additionally on the
// function — so a row that named only a module could not be joined against either. This is the one
// place the census authors a fact, and it authors the key rather than the answer.
type WitnessSubject {
  entry: NonEmptyStr
  function: NonEmptyStr
}

// WHERE AN OBLIGATION EXECUTES ON ONE ROUTE, AND WHY THE NON-EXECUTING ARMS ARE FOUR AND NOT ONE.
// Collapsing them would reproduce exactly the failure gunbc.recurring_failure_mode names as
// non-execution undifferentiated by what it silenced: a witness carved out of discovery by a
// declared exclusion row, a witness frozen as never-executed, an obligation no witness names, and a
// receipt family whose route publishes nothing the acceptance path can spend are four different
// repairs with four different owners, and a single Absent arm would rank none of them.
// THE ARMS, IN ORDER. ExecutedOnPath: discovered by the walk and subtracted by nothing, so the
// required per-PR fold reaches it. ExcludedFromDiscovery: carved out by a gunbc.ci_layer_roots
// witness_exclusion_frontier pattern — the row that does it is derivable from the entry, and
// storing a copy of the pattern here would be the fork this module was rebuilt to remove.
// FrozenPathDeferred: enrolled in the frozen legacy population, declared never-executed and
// admitted with no executing consumer, so Mitigatable at best by construction of the roster it
// sits in. RouteGapHeld: a receipt family exists for this route but publishes nothing the
// acceptance path can spend. NoWitnessNamesIt: no witness names this obligation on this route.
type PathExecution
  = ExecutedOnPath { instrument: NonEmptyStr }
  | ExcludedFromDiscovery { frontier: DeclarationRef }
  | FrozenPathDeferred { roster: DeclarationRef }
  | RouteGapHeld { stall: DeclarationRef }
  | NoWitnessNamesIt { note: NonEmptyStr }

// AN OBLIGATION WITH NO HOME IS A MODELING OBLIGATION, NOT A CENSUS ROW WITH A BLANK FIELD. DESIGN
// section 3b draws that line for conformance domains and it applies here: a domain whose home
// authority does not exist is not something to check, it is something to model, and a DeclarationRef
// to a declaration nobody has authored would be a citation defect wearing the shape of coverage.
// NoHomeExists carries the NEAREST authority — the declaration a reader would reach for — with the
// reason it does not own the obligation, so the modeling work has a starting point.
type Home
  = HomeAuthority { authority: DeclarationRef }
  | NoHomeExists { nearest: DeclarationRef, why_it_is_not_the_home: NonEmptyStr }

// REACHED-BY-ROUTE AND EXECUTED ARE TWO AXES, AND AN EARLIER CUT COLLAPSED THEM. It asserted that
// validate_then_compile has no production caller, on a grep restricted to files OTHER than
// 00_compile.dag. False: compile_source_root_ingest_with_admission and stage_translate both call the
// door from inside that module, each with lenses: [], and the root roster fires regardless of
// caller-supplied lenses — which is what required_lens_grain_note says. The emitted
// SourceRootEvalDriver on the required-v2-native lane executes the first of those.
//
// WHY THE NATIVE ZERO STILL STANDS, AND WHY IT IS A DIFFERENT ZERO. Executing-natively is 0 because
// every admitted subject on that lane refuses UPSTREAM of the door, at resolve, so no gate is asked
// and no gate RED is refused there. Unreached and reached-but-never-arrived-at are the same number
// and different facts: the second flips the day the closure refusals repair; the first would need a
// routing change nobody has planned.
type RouteReach
  = ReachedByNativeRoute { driver: NonEmptyStr, upstream_refusal: NonEmptyStr }
  | NotNamedByAnyExecutingRoute { note: NonEmptyStr }

// WHAT THE v1 SEED DOES OUTSIDE THE OBLIGATION'S REACH — the column that motivates the census. v2's
// gates read the InferredTree the compile door is handed, and the seed is never handed to that door:
// it is stage0 Rust compiled by rustc. So the reach of every obligation below stops at the corpus v2
// compiles. An escape is CLOSED only when a named declaration brings the seed inside that reach,
// never when the obligation is merely stated more strongly.
type SeedEscape
  = SeedEscapeOpen { what_the_seed_does: NonEmptyStr }
  | SeedEscapeClosed { by: DeclarationRef }

// THE FIELDS THAT ARE NOT SELF-EXPLANATORY. claimed_rung is the rung the obligation's own
// declaration claims for itself, read off that declaration and never off this census. witnesses are
// the entries that exercise it, and their standing is DERIVED rather than stored — see
// interpreted_standing. discriminating_red and positive_control are the input that makes the
// obligation refuse and the input that must still be accepted beside it, both required because a
// refusal with no positive control is satisfied by a mechanism that refuses everything.
// related_drops carries gunbc.rung_drop identities and never restates those rows.
//
// THE native ARM STAYS AUTHORED, and that asymmetry is a finding rather than an oversight: no
// authority in this repository publishes a per-obligation native execution standing to ask, which
// is exactly why the native column is the one this census cannot self-correct the way the
// interpreted column now corrects itself.
type V2CompileObligation {
  identity: NonEmptyStr
  kind: ObligationKind
  home: Home
  claimed_rung: GuaranteeRung
  witnesses: List<WitnessSubject>
  discriminating_red: NonEmptyStr
  positive_control: NonEmptyStr
  native: PathExecution
  route_reach: RouteReach
  ceiling: GuaranteeRung
  next_trigger: NonEmptyStr
  seed_escape: SeedEscape
  related_drops: List<DeclarationRef>
}

data frozen_roster_authority: DeclarationRef = decl_ref(
  module_path: "gunbc.witness_deferral_freeze",
  decl_name: "frozen_path_deferrals"
)

data exclusion_frontier_authority: DeclarationRef = decl_ref(
  module_path: "gunbc.ci_layer_roots",
  decl_name: "witness_exclusion_frontier"
)

data self_host_route_stall: DeclarationRef = decl_ref(
  module_path: "gunbc.guarantee_stall.self_host_wet_route_receipt_lifetime_stall",
  decl_name: "self_host_wet_route_receipt_lifetime_stall"
)

// THE EXCLUSION JOIN REPRODUCES THE HOST RULE EXACTLY RATHER THAN APPROXIMATING IT. The deferred
// discovery walk in v1_compiler.cli_run selects a *_test.dag whose repo-relative path CONTAINS an
// exclusion pattern (`rel.contains(sub)`); string_contains is that same predicate, so this is the
// rule itself asked again, not a second rule that happens to agree today.
fn witness_subject_is_excluded_in(rows: List<WitnessExclusionRow>, w: WitnessSubject) -> Bool {
  fold(
    rows,
    init: false,
    f: fn(found, row) { found || string_contains(s: w.entry, pattern: row.pattern) }
  )
}

fn witness_subject_is_excluded(w: WitnessSubject) -> Bool {
  witness_subject_is_excluded_in(rows: witness_exclusion_frontier, w: w)
}

fn witness_subject_is_frozen(w: WitnessSubject) -> Bool {
  frozen_path_deferral_covers(entry: w.entry, function: w.function)
}

// WHAT IS DERIVED AND WHAT IS ASSUMED, STATED WHERE THE ASSUMPTION LIVES. Every entry below is a
// *_test.dag under dag/ or src/v2/, which is the whole of the discovery walk's positive selection,
// so the remaining question is exactly the two subtractions — the freeze roster and the exclusion
// frontier — and both are asked here. What is NOT verified is that the entry file still exists
// under that path: no cheap reader available from this module can answer it, and a moved file would
// leave a stale key that both authorities would answer "not covered" for, reading as EXECUTING.
// That is the one direction this derivation can be wrong, it fails toward optimism, and its trigger
// is named on the census's own next_trigger below rather than left implicit.
fn witness_subject_executes_per_pr(w: WitnessSubject) -> Bool {
  !witness_subject_is_frozen(w: w) && !witness_subject_is_excluded(w: w)
}

fn any_witness_executes_per_pr(ws: List<WitnessSubject>) -> Bool {
  fold(ws, init: false, f: fn(found, w) { found || witness_subject_executes_per_pr(w: w) })
}

fn all_witnesses_frozen(ws: List<WitnessSubject>) -> Bool {
  fold(ws, init: true, f: fn(ok, w) { ok && witness_subject_is_frozen(w: w) })
}

// THE DERIVED INTERPRETED STANDING. Executing wins over every non-executing arm because one
// discovered witness is coverage; among the non-executing arms, frozen is reported only when EVERY
// witness is frozen, so a mixed row reads as excluded rather than claiming a stronger declared
// never-executed standing than its population supports.
fn interpreted_standing(o: V2CompileObligation) -> PathExecution {
  if list_length(items: o.witnesses) == 0 {
    NoWitnessNamesIt {
      note: "no witness in the corpus names this obligation" as NonEmptyStr
    }
  } else {
    if any_witness_executes_per_pr(ws: o.witnesses) {
      ExecutedOnPath {
        instrument: "claim_executor --required-ci --source-root dag --source-root src/v2, whose discovery walk reaches this entry and which no exclusion or freeze row subtracts" as NonEmptyStr
      }
    } else {
      if all_witnesses_frozen(ws: o.witnesses) {
        FrozenPathDeferred { roster: frozen_roster_authority }
      } else {
        ExcludedFromDiscovery { frontier: exclusion_frontier_authority }
      }
    }
  }
}

// EVERY LENS ROW SHARES THESE TWO NATIVE VALUES because every lens is enrolled behind one door and
// the door is reached by one driver; the refusal that stops short of the gates is upstream of all
// of them, so splitting it per row would be copies of one fact.
//
// THE NATIVE RECEIPT IS WEAKER THAN ITS ROUTE GAP, WHICH IS WHY THIS VALUE IS RouteGapHeld AND NOT
// SOMETHING SOFTER. The only behavioral receipt the emitted crate publishes for v2.compiler.compile
// is the self_host_00_compile shim, and its case list has ONE entry: required_lens_grain_note, the
// prose string describing the two roster grains, compared against a nine-line seed module whose
// whole content is that same string. Not one gate is invoked, so even a spendable receipt would not
// move if every gate were deleted.
data lens_native_execution: PathExecution = RouteGapHeld { stall: self_host_route_stall }

data lens_native_route_reach: RouteReach = ReachedByNativeRoute {
  driver: "the emitted SourceRootEvalDriver on the required-v2-native lane, which executes v2.compiler.compile compile_source_root_ingest_with_admission" as NonEmptyStr,
  upstream_refusal: "every admitted subject on that lane refuses at resolve, upstream of validate_then_compile, so the door is entered by no subject and no enrolled gate is asked" as NonEmptyStr
}

// A RUNG-DROP CITATION IS A TYPED REFERENCE, NOT A NAME. The first cut carried these as bare
// NonEmptyStr identities while every other citation in this module was a DeclarationRef, which is
// the exact shape this ledger files as unlanded_citation_indistinguishable_at_the_citing_end: a
// prose identity resolves today and nothing can tell when it stops. The row files are one
// declaration per module under gunbc.rung_drop, named for the identity they carry, so the reference
// is mechanical.
fn rung_drop_ref(identity: String) -> DeclarationRef {
  decl_ref(module_path: concat("gunbc.rung_drop.", identity), decl_name: identity)
}

// THE SIX ROWS WHOSE ONLY REMAINING WALL IS THE NATIVE DOOR SHARE ONE TRIGGER, for the same reason
// lens_native_execution and lens_native_route_reach are shared data: it is one capability, and six
// copies of it would drift on the first correction — five sites updated, one left behind, which is
// the failure this ledger already carries as declared_trigger_names_a_term_that_is_not_the_cause.
data native_door_entry_trigger: NonEmptyStr = "the emitted native lane's admitted subjects stop refusing at resolve, so compile_source_root_ingest_with_admission actually enters validate_then_compile and this gate is asked about an authored module. THAT IS THE WHOLE REMAINING CAPABILITY FOR THIS ROW: its witnesses are already discovered and already run on the interpreted per-PR route, so no discovery, exclusion or freeze change moves it — the executed rung is held down by the native path alone, and DESIGN section 4b(1) takes the MINIMUM across paths" as NonEmptyStr

fn witness_subject(entry: String, function: String) -> WitnessSubject {
  WitnessSubject { entry: entry as NonEmptyStr, function: function as NonEmptyStr }
}
data accumulator_copy_obligation: V2CompileObligation = V2CompileObligation {
  identity: "accumulator_copy_root_lens" as NonEmptyStr,
  kind: RequiredRootLens,
  home: HomeAuthority { authority: decl_ref(
    module_path: "v2.lens.complexity_accumulator_copy.compile_gate",
    decl_name: "accumulator_copy_compile_gate"
  ) },
  claimed_rung: MechanicallyPreventable,
  discriminating_red: "a rooted tree threading a copied accumulator through a fold, which the gate must reject with a located diagnostic rather than a widened pass" as NonEmptyStr,
  positive_control: "the resolved add fixture, which threads no copy and must pass the root-required roster unchanged (src/v2/test/claim/long/accumulator_copy_compile_gate_test.dag)" as NonEmptyStr,
  witnesses: [
    witness_subject(entry: "src/v2/test/claim/long/accumulator_copy_compile_gate_test.dag", function: "gate_red_quadratic_rejects"),
    witness_subject(entry: "src/v2/test/claim/long/accumulator_copy_compile_gate_test.dag", function: "gate_green_identity_accepts_clean"),
    witness_subject(entry: "src/v2/test/claim/complexity/accumulator_copy_roster_gate_test.dag", function: "roster_machine_code_zero_suspects_within_ratchet"),
  ],
  native: lens_native_execution,
  route_reach: lens_native_route_reach,
  ceiling: StructurallyGuaranteed,
  next_trigger: "TWO CAPABILITIES, AND NEITHER IS A FILE MOVE. First, the gate's own witnesses become affordable on the per-PR fold so the gunbc.ci_layer_roots witness_exclusion_frontier patterns 'claim/complexity/accumulator_copy_roster_gate' and 'test/claim/long/' retire on their own dissolution conditions rather than being edited around — the exclusion rows exist because the walks were priced out, so the trigger is the cost, not the pattern. Second, the native lane enters the door. Until the first lands no required run refuses on a copied-accumulator tree; until the second lands the executed rung stays Mitigatable however green the interpreted side becomes" as NonEmptyStr,
  seed_escape: SeedEscapeOpen {
    what_the_seed_does: "the seed's own folds are never presented to this gate, so a copied accumulator authored in stage0 Rust is invisible to the complexity lens that exists to make it unwritable" as NonEmptyStr
  },
  related_drops: [rung_drop_ref(identity: "lens_enforcement_censuses")],
}

data determinism_obligation: V2CompileObligation = V2CompileObligation {
  identity: "determinism_root_lens" as NonEmptyStr,
  kind: RequiredRootLens,
  home: HomeAuthority { authority: decl_ref(module_path: "v2.lens.determinism", decl_name: "determinism_compile_gate") },
  claimed_rung: MechanicallyPreventable,
  discriminating_red: "a tree whose call joins a PrimitiveIdentity carrying HostUnspecifiedOrder or TraversalOrderUnclassified, which the gate must refuse per leaking call node" as NonEmptyStr,
  positive_control: "a tree over CanonicalOrder and OrderFreeResult primitives, which must still compile" as NonEmptyStr,
  witnesses: [
    witness_subject(entry: "src/v2/test/claim/determinism_contract_test.dag", function: "determinism_perturbation_violation_is_nondeterministic"),
    witness_subject(entry: "src/v2/test/claim/determinism_contract_test.dag", function: "determinism_perturbation_consistent_is_deterministic"),
    witness_subject(entry: "src/v2/test/lens_determinism/reach_witness_test.dag", function: "determinism_flags_map_keys_reach"),
  ],
  native: lens_native_execution,
  route_reach: lens_native_route_reach,
  ceiling: StructurallyGuaranteed,
  next_trigger: native_door_entry_trigger,
  seed_escape: SeedEscapeOpen {
    what_the_seed_does: "the seed is never handed to this gate at all: it is stage0 Rust compiled by rustc, so every call it makes to a declared primitive carrying HostUnspecifiedOrder is consumed rather than refused, and no diagnostic exists to be absent. THE OBSERVED PUB-USE DIVERGENCE IS DELIBERATELY NOT CLAIMED HERE. This row previously named it, and the attribution is withdrawn on the same measurement that withdrew it from primitive_map_keys_obligation: gunbc#10941 found the nondeterministic re-export walk to be v1.05_emit_core_support unique_strings, a fold over a membership map and not a declared primitive, so this gate would not have classified that site even on a program it WAS handed. Carrying the incident here as well would give one measured event two answers inside one module. It has exactly one row, determinism_non_primitive_order_exposing_fold" as NonEmptyStr
  },
  related_drops: [rung_drop_ref(identity: "determinism_transitive_reachability")],
}

data machine_shape_obligation: V2CompileObligation = V2CompileObligation {
