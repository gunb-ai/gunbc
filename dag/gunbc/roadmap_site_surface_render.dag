module gunbc.roadmap_site_surface_render


data roadmap_site_health_path: std.types.NonEmptyStr = "/healthz"
data roadmap_site_roadmap_url_path: std.types.NonEmptyStr = "/ROADMAP.md"
data roadmap_site_dispatch_url_path: std.types.NonEmptyStr = "/target/roadmap-dispatch.json"
data roadmap_site_daily_url_path: std.types.NonEmptyStr = "/"
data roadmap_site_full_url_path: std.types.NonEmptyStr = "/roadmap"
data roadmap_site_service_name: String = "gunbc-roadmap"

data page_render_refusal_prefix: String = "page render refused: "

fn page_render_refusal_body(reason: String) -> String {
  join([page_render_refusal_prefix, reason, "\n"], "")
}

fn site_artifact_digest(body: String) -> std.content_hash.Fnv1a64Structural {
  std.content_hash.content_hash_atom(value: body as std.types.NonEmptyStr)
}

fn served_page_body(page: std.markup.Fragment) -> String {
  match extdeps.languages.html.try_serialize_html_source(node: page) {
    extdeps.languages.html.EmitOk { html: h } => h
    extdeps.languages.html.EmitRejected { reason: r } => page_render_refusal_body(reason: r)
  }
}

fn served_surface_digest_kv(url_path: std.types.NonEmptyStr, body: String) -> extdeps.languages.json.emit.JsonKeyValue {
  extdeps.languages.json.emit.json_kv(key: url_path as String, value: extdeps.languages.json.emit.json_string(s: site_artifact_digest(body: body).digest as String))
}

fn healthz_surface_members(
  roadmap: gunbc.roadmap_site_surface_types.RoadmapSiteSurfaceArtifact,
  dispatch: gunbc.roadmap_site_surface_types.RoadmapSiteSurfaceArtifact,
  daily: gunbc.roadmap_site_surface_types.RoadmapSiteSurfaceArtifact,
  full: gunbc.roadmap_site_surface_types.RoadmapSiteSurfaceArtifact,
  dispatch_js: gunbc.roadmap_site_surface_types.RoadmapSiteSurfaceArtifact,
) -> List<extdeps.languages.json.emit.JsonKeyValue> {
  [
    extdeps.languages.json.emit.json_kv(key: "status", value: extdeps.languages.json.emit.json_string(s: "ok")),
    extdeps.languages.json.emit.json_kv(key: "service", value: extdeps.languages.json.emit.json_string(s: roadmap_site_service_name)),
    extdeps.languages.json.emit.json_kv(key: "artifacts", value: extdeps.languages.json.emit.json_object(members: [
      extdeps.languages.json.emit.json_kv(key: roadmap.url_path as String, value: extdeps.languages.json.emit.json_string(s: roadmap.digest.digest as String)),
      extdeps.languages.json.emit.json_kv(key: dispatch.url_path as String, value: extdeps.languages.json.emit.json_string(s: dispatch.digest.digest as String)),
      served_surface_digest_kv(url_path: daily.url_path, body: daily.body),
      served_surface_digest_kv(url_path: full.url_path, body: full.body),
      served_surface_digest_kv(url_path: dispatch_js.url_path, body: dispatch_js.body),
    ])),
  ]
}

data healthz_surface_members_note: String = "THE SURFACE MEMBERS ARE FACTORED OUT SO THE SERVED DOCUMENT AND THE BUNDLE'S OWN healthz_body CANNOT DRIFT. The served /healthz body is these members PLUS the running process's release identity (gunbc.running_release_identity); the bundle's retained healthz_body is these members alone. One member list, two documents differing by exactly the launch-identity members — never two spellings of the surface, which is the dual-representation DESIGN section 3 forbids and which would let the deploy's freshness comparison go green against a document the route does not serve."

fn healthz_body_from_surface_artifacts(
  roadmap: gunbc.roadmap_site_surface_types.RoadmapSiteSurfaceArtifact,
  dispatch: gunbc.roadmap_site_surface_types.RoadmapSiteSurfaceArtifact,
  daily: gunbc.roadmap_site_surface_types.RoadmapSiteSurfaceArtifact,
  full: gunbc.roadmap_site_surface_types.RoadmapSiteSurfaceArtifact,
  dispatch_js: gunbc.roadmap_site_surface_types.RoadmapSiteSurfaceArtifact,
) -> String {
  extdeps.languages.json.emit.serialize_json(v: extdeps.languages.json.emit.json_object(members: healthz_surface_members(
    roadmap: roadmap,
    dispatch: dispatch,
    daily: daily,
    full: full,
    dispatch_js: dispatch_js,
  )))
}

fn healthz_body_with_release_identity(
  roadmap: gunbc.roadmap_site_surface_types.RoadmapSiteSurfaceArtifact,
  dispatch: gunbc.roadmap_site_surface_types.RoadmapSiteSurfaceArtifact,
  daily: gunbc.roadmap_site_surface_types.RoadmapSiteSurfaceArtifact,
  full: gunbc.roadmap_site_surface_types.RoadmapSiteSurfaceArtifact,
  dispatch_js: gunbc.roadmap_site_surface_types.RoadmapSiteSurfaceArtifact,
  release_revision: std.types.CommitSha,
  surface_bundle_identity: std.content_hash.Fnv1a64Structural,
) -> String {
  extdeps.languages.json.emit.serialize_json(v: extdeps.languages.json.emit.json_object(members: list_append(
    healthz_surface_members(
      roadmap: roadmap,
      dispatch: dispatch,
      daily: daily,
      full: full,
      dispatch_js: dispatch_js,
    ),
    gunbc.running_release_identity.running_release_healthz_members(
      revision: release_revision,
      surface_bundle_identity: surface_bundle_identity,
    ),
  )))
}

data healthz_body_with_release_identity_note: String = "THE SERVED DOCUMENT HAS EXACTLY ONE PRODUCER, AND THIS IS IT. The healthz handler renders it for the live bundle, the readiness healthy fixture renders it for a supplied bundle, and nothing else spells the document. That matters more here than in an ordinary factoring, because the readiness comparison decides whether a deploy converged: a second spelling of the served body would let the comparison agree with a document the route does not serve, which is the state-space the whole readiness contract exists to exclude.\\n\\nThe surface members come first and the identity members last, so the surface half of this document is a PREFIX of it in member order — but nothing downstream may depend on that, because the comparison projects members by KEY rather than by position (roadmap_site_healthz_surface_is_current). Order here is only the emitter's, not a contract."
