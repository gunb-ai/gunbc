module gunbc.host_convergence_census

import std.types { Bool, List }
import v2.std.collection { Present, Absent }
import v2.std.algebra { list_map, filter, length }
import std.decl_ref {
  DeclarationRef,
  decl_ref,
  declaration_ref_eq,
  declaration_ref_in_list,
}
import std.dissolution {
  DissolutionCondition,
  retires_dissolution,
}

// CONVERGENCE-ONE C0 registry. Cites the existing stack; does not rewire it.
// RUNG: mitigation.
// NEXT-RUNG TRIGGERS (two classes; completeness does not cover resolution):
// (1) completeness — a discovery join over independently enumerated host-effect
//     declarations so a missing mutation identity refuses.
// (2) citation resolution — `gunbc.dissolution_observation` `census_ref_verdict`
//     / `v2.std.decl_ref_resolution.resolve_declaration_ref` over this module's
//     `DeclarationRef` fields. This witness is SubstrateInputsOnly, so that join
//     is not authorable on the current path; a stale cite is currently silent.
// phases.mutates is derived from persistent_host_effect at census_row.
// deletion is std.dissolution: none when RetainAuthority, else retires_dissolution(identity).
// intended_authority is a fold over disposition: Retain -> current; Bind -> target;
// Rename -> canonical; Replace -> terminal or successor; Outside -> protocol.
type ProtocolPhases {
  selects: Bool
  observes: Bool
  assesses: Bool
  plans: Bool
  admits: Bool
  mutates: Bool
  reads_back: Bool
  checks_readiness: Bool
}

type HostConvergenceSubject
  = DesiredRealizationSelection
  | GoalBlindAssessment
  | RemedySelection
  | EffectReadbackClassification
  | CapabilityEnsureAdapter
  | FleetPlanAdmission
  | FleetApply
  | HostEffectActuation
  | DeploymentMemberObservation
  | DeploymentMemberAssessment
  | DeploymentApply
  | DeploymentReadiness
  | DeploymentSpecPopulation
  | FleetWorkflowMode
  | DashboardInstanceHostStack
  | RoadmapServeProviderReadiness
  | SparkHostGrants
  | SparkServing
  | SparkRuntimeImage
  | RunnerHostFiles
  | RunnerPasswordSessionTools
  | MicrovmControllerAppKey
  | MicrovmHost
  | GuestImage
  | Srv3InstallMedia
  | SrvBmcCredential
  | TypedRemoteFileBytes
  | HostToolchain
  | RunnerMemoryCaps
  | ContributorRepoLocalGitConfig
  | FleetHostKeyEnrollment

type PersistentHostEffectStatus
  = ReachesPersistentHostMutation
  | DoesNotMutateHost

type HostConvergenceDisposition
  = RetainAuthority
  | BindToAuthority { target: DeclarationRef }
  | RenameOutOfConvergence { canonical: DeclarationRef }
  | ReplaceAndDelete { successor: DeclarationRef, terminal: DeclarationRef? }
  | OutsideHostConvergence { protocol: DeclarationRef }

type HostConvergenceCensusRow {
  identity: DeclarationRef
  subject: HostConvergenceSubject
  phases: ProtocolPhases
  current_authority: DeclarationRef
  persistent_host_effect: PersistentHostEffectStatus
  disposition: HostConvergenceDisposition
  first_consumer: DeclarationRef
  deletion: DissolutionCondition?
}

type HostConvergenceCensusRefusal
  = DuplicateDeclaration { identity: DeclarationRef }
  | SelfSuccessor { identity: DeclarationRef }

type HostConvergenceCensus
  = CensusWellFormed { rows: List<HostConvergenceCensusRow> }
  | CensusMalformed { cause: HostConvergenceCensusRefusal }

type CensusIdentityJoin
  = IdentitiesCovered
  | IdentityMissingFromCensus { identity: DeclarationRef }
  | IdentityDuplicatedInCensus { identity: DeclarationRef }

fn none_phases() -> ProtocolPhases {
  ProtocolPhases {
    selects: false,
    observes: false,
    assesses: false,
    plans: false,
    admits: false,
    mutates: false,
    reads_back: false,
    checks_readiness: false,
  }
}

fn persistent_status_mutates(s: PersistentHostEffectStatus) -> Bool {
  match s {
    ReachesPersistentHostMutation => true
    DoesNotMutateHost => false
  }
}

fn protocol_phases(
  selects: Bool,
  observes: Bool,
  assesses: Bool,
  plans: Bool,
  admits: Bool,
  reads_back: Bool,
  checks_readiness: Bool,
) -> ProtocolPhases {
  ProtocolPhases {
    selects: selects,
    observes: observes,
    assesses: assesses,
    plans: plans,
    admits: admits,
    mutates: false,
    reads_back: reads_back,
    checks_readiness: checks_readiness,
  }
}

fn phases_with_host_effect(phases: ProtocolPhases, status: PersistentHostEffectStatus) -> ProtocolPhases {
  ProtocolPhases {
    selects: phases.selects,
    observes: phases.observes,
    assesses: phases.assesses,
    plans: phases.plans,
    admits: phases.admits,
    mutates: persistent_status_mutates(s: status),
    reads_back: phases.reads_back,
    checks_readiness: phases.checks_readiness,
  }
}

fn census_row(
  identity: DeclarationRef,
  subject: HostConvergenceSubject,
  phases: ProtocolPhases,
  current_authority: DeclarationRef,
  persistent_host_effect: PersistentHostEffectStatus,
  disposition: HostConvergenceDisposition,
  first_consumer: DeclarationRef,
) -> HostConvergenceCensusRow {
  HostConvergenceCensusRow {
    identity: identity,
    subject: subject,
    phases: phases_with_host_effect(phases: phases, status: persistent_host_effect),
    current_authority: current_authority,
    persistent_host_effect: persistent_host_effect,
    disposition: disposition,
    first_consumer: first_consumer,
    deletion: owed_dissolution(disposition: disposition, identity: identity),
  }
}

fn intended_authority(row: HostConvergenceCensusRow) -> DeclarationRef {
  match row.disposition {
    RetainAuthority => row.current_authority
    BindToAuthority { target: t } => t
    ReplaceAndDelete { successor: s, terminal: term } =>
      match term {
        Present { value: home } => home
        Absent => s
      }
    RenameOutOfConvergence { canonical: c } => c
    OutsideHostConvergence { protocol: p } => p
  }
}

fn disposition_is_retain(d: HostConvergenceDisposition) -> Bool {
  match d {
    RetainAuthority => true
    BindToAuthority { target: _ } => false
    RenameOutOfConvergence { canonical: _ } => false
    ReplaceAndDelete { successor: _, terminal: _ } => false
    OutsideHostConvergence { protocol: _ } => false
  }
}

fn owed_dissolution(
  disposition: HostConvergenceDisposition,
  identity: DeclarationRef,
) -> DissolutionCondition? {
  if disposition_is_retain(d: disposition) {
    none
  } else {
    Present { value: retires_dissolution(ref: identity) }
  }
}

fn row_is_well_formed(row: HostConvergenceCensusRow) -> HostConvergenceCensusRefusal? {
  match row.disposition {
    BindToAuthority { target: _ } =>
      if declaration_ref_eq(a: row.identity, b: intended_authority(row: row)) {
        Present { value: SelfSuccessor { identity: row.identity } }
      } else {
        none
      }
    RenameOutOfConvergence { canonical: _ } =>
      if declaration_ref_eq(a: row.identity, b: intended_authority(row: row)) {
        Present { value: SelfSuccessor { identity: row.identity } }
      } else {
        none
      }
    ReplaceAndDelete { successor: s, terminal: term } =>
      if declaration_ref_eq(a: row.identity, b: s) {
        Present { value: SelfSuccessor { identity: row.identity } }
      } else {
        match term {
          Present { value: home } =>
            if declaration_ref_eq(a: row.identity, b: home) {
              Present { value: SelfSuccessor { identity: row.identity } }
            } else {
              none
            }
          Absent => none
        }
      }
    _ => none
  }
}

fn admit_census_step(
  acc: HostConvergenceCensus,
  row: HostConvergenceCensusRow,
) -> HostConvergenceCensus {
  match acc {
    CensusMalformed { cause: c } => CensusMalformed { cause: c }
    CensusWellFormed { rows: seen } =>
      if declaration_ref_in_list(target: row.identity, refs: list_map(xs: seen, f: fn(r) { r.identity })) {
        CensusMalformed { cause: DuplicateDeclaration { identity: row.identity } }
      } else {
        match row_is_well_formed(row: row) {
          Present { value: cause } => CensusMalformed { cause: cause }
          Absent => CensusWellFormed { rows: concat(seen, [row]) }
        }
      }
  }
}

fn admit_host_convergence_census(rows: List<HostConvergenceCensusRow>) -> HostConvergenceCensus {
  fold(rows, init: CensusWellFormed { rows: [] }, f: fn(acc, row) {
    admit_census_step(acc: acc, row: row)
  })
}

fn census_is_well_formed(census: HostConvergenceCensus) -> Bool {
  match census {
    CensusWellFormed { rows: _ } => true
    CensusMalformed { cause: _ } => false
  }
}

fn census_identity_join(
  required: List<DeclarationRef>,
  rows: List<HostConvergenceCensusRow>,
) -> CensusIdentityJoin {
  fold(required, init: IdentitiesCovered, f: fn(acc, id) {
    match acc {
      IdentityMissingFromCensus { identity: m } => IdentityMissingFromCensus { identity: m }
      IdentityDuplicatedInCensus { identity: d } => IdentityDuplicatedInCensus { identity: d }
      IdentitiesCovered => {
        let hits = filter(xs: rows, predicate: fn(r) { declaration_ref_eq(a: r.identity, b: id) })
        if length(xs: hits) == 0 {
          IdentityMissingFromCensus { identity: id }
        } else {
          if length(xs: hits) > 1 {
            IdentityDuplicatedInCensus { identity: id }
          } else {
            IdentitiesCovered
          }
        }
      }
    }
  })
}

fn identity_join_covered(j: CensusIdentityJoin) -> Bool {
  match j {
    IdentitiesCovered => true
    IdentityMissingFromCensus { identity: _ } => false
    IdentityDuplicatedInCensus { identity: _ } => false
  }
}

fn cite(module_path: String, decl_name: String) -> DeclarationRef {
  decl_ref(module_path: module_path, decl_name: decl_name)
}

fn std_decision() -> DeclarationRef {
  cite(module_path: "std.decision", decl_name: "select_realization")
}

