module gunbc.adjudicate_measurement_receipt_cli_modes_seed_growth

import std.types { Bool, List }
import gunbc.roadmap.roadmap_model { RoadmapNodeId }
import gunbc.declaration_identity { DeclarationRef, decl_ref }
import gunbc.seed_growth { SeedGrowthJustification }

// HAND-WRITTEN v1 SEED GROWTH ADMITTED BY OPERATOR RULING. The three CLI modes below
// (`--adjudicate-measurement-receipt`, `--measurement-receipt`, and
// `--measurement-unreached-receipt` with its paired cause) are hand-written Rust in
// `src/v1/stage0/src/bin/claim_executor.rs`. They are thin adapters that parse a flag, call
// the existing library function (`adjudicate_required_ci_measurement_receipt_file`,
// `write_required_ci_measurement_receipt`), and exit 0 or 1 by its return. No new semantic
// decision is added to v1 -- the adjudication logic already exists in
// `v1_compiler::cli_run::required_ci_measurement` with eleven unit tests proving its
// correctness; the modes are the missing wire between an existing tested verdict and the
// process exit status the D0 adjudicate step requires.
//
// The ruling that admits this growth is
// `gunbc.design_ruling::v1_seed_growth_for_adjudicate_measurement_receipt_cli_modes_admitted`
// (2026-11-22, principal:google-oidc/accounts/116084671989231734979); its record holds the
// decision and the words, and this row cites that record rather than restating it.

data adjudicate_measurement_receipt_cli_modes_seed_growth_justification: SeedGrowthJustification =
  SeedGrowthJustification {
    hand_authored_declarations: [
      // `src/v1/stage0/src/bin/claim_executor.rs`: the `adjudicate_measurement_receipt_path`
      // variable and its `--adjudicate-measurement-receipt` parsing arm, plus the block that
      // calls `adjudicate_required_ci_measurement_receipt_file`, prints diagnostics, and returns
      // `Err(ExitCode::from(1))` on a refused receipt (exit 0 on admitted). This is the exit
      // mapping required by node://required-lane-exit-on-refused-phase.
      decl_ref(module_path: "v1_compiler.cli_run", decl_name: "adjudicate_required_ci_measurement_receipt_file"),
      // The `measurement_unreached_receipt_path` / `measurement_unreached_cause` variables and
      // their parsing arms, plus the block that writes a `MeasurementUnreached` receipt at the
      // given path (exit 2 when the cause flag is missing).
      decl_ref(module_path: "v1_compiler.cli_run", decl_name: "write_required_ci_measurement_receipt"),
      // The `measurement_receipt_path` variable and its parsing arm; the block inside
      // `if required_admitted_set_mode` that writes an ADMITTED or BLOCKING receipt based on
      // the ingestion outcome; and the guard that exits 2 when `--measurement-receipt` is used
      // outside `--required-ci`.
      decl_ref(module_path: "v1_compiler.cli_run.required_ci_measurement", decl_name: "RequiredCiMeasurementReceipt"),
      decl_ref(module_path: "v1_compiler.cli_run.required_ci_measurement", decl_name: "RequiredCiBlocker"),
    ],
    // Cites the ruling record; does not restate the quote.
    reason: "The D0 adjudicate step generated by required_ci_measurement_shell.dag calls three claim_executor modes that the binary does not handle. Without them the adjudicate step fails for the WRONG reason (unknown arg, exit 2) instead of correctly mapping a BLOCKING receipt verdict to exit 1. The fix wires the existing tested adjudication to a process exit code. It is not a capability addition -- it is the missing caller for a function that had no non-test consumer.",
    owning_dissolution_lane: "required-lane-exit-on-refused-phase" as RoadmapNodeId,
    // A CI run where the D0 adjudicate step must exit 1 on a BLOCKING receipt (refused phase)
    // and exit 0 on an ADMITTED receipt (clean lane).
    trigger: "a refused phase maps to exit 0 or a clean lane maps to exit 1",
    current_boundary: "three thin CLI adapter blocks in `src/v1/stage0/src/bin/claim_executor.rs`: the `--adjudicate-measurement-receipt` handler (~15 lines), the `--measurement-unreached-receipt` handler (~15 lines), and the `--measurement-receipt` integration inside `--required-ci` (~20 lines). Each calls an existing library function and returns an exit code. The guard that exits 2 when `--measurement-receipt` appears without `--required-ci` is 5 lines. Total 94 added lines in one file.",
  }
