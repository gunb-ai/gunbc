module gunbc.roadmap_instrument_tuner


data instrument_tuner_note: String = "THE OPERABLE V1-DELETION TUNER at /sandbox/instrument/tuner — the declared follow-on to the static study. The study at /sandbox/instrument renders one server-side camera state with no client program; this page loads the modeled client asset from gunbc.roadmap_component so the camera persists in localStorage, finish-line selection follows the production roadmap's parity rule, wheel and arrow keys admit one detent per admitted threshold (distant depth labels decompose into adjacent steps), and the depth/mode controls actually drive the pre-rendered reading rows. The world is still V0's live derived program view; only the camera is local instrument state."

fn cls(name: String) -> extdeps.languages.css.selectors.SelectorSubject {
  extdeps.languages.css.selectors.ClassSelector { name: name }
}

fn tuner_control_rules() -> List<gunbc.design.material.BuildRule> {
  [
    gunbc.design.material.StaticRule {
      selector: gunbc.roadmap_instrument_tuner.cls(name: instrument_depth_btn_class),
      decls: [
        decl(prop: FontFamily, value: scale_var(t: font_mono)),
        decl(prop: FontSize, value: scale_var(t: text_12)),
        decl(prop: Padding, value: scale_var(t: space_4)),
        decl(prop: Border, value: join(["1px solid ", role_var(r: BorderRole)], "")),
        decl(prop: BorderRadius, value: scale_var(t: radius_3)),
        decl(prop: Background, value: role_var(r: SurfaceRole)),
        decl(prop: Color, value: role_var(r: TextRole)),
        decl(prop: extdeps.languages.css.properties.Cursor, value: "pointer"),
      ],
    },
    gunbc.design.material.StaticRule {
      selector: gunbc.roadmap_instrument_tuner.cls(name: join([instrument_depth_btn_class, ".is-active"], "")),
      decls: [
        decl(prop: Border, value: join(["1px solid ", role_var(r: FocusRole)], "")),
      ],
    },
    gunbc.design.material.StaticRule {
      selector: gunbc.roadmap_instrument_tuner.cls(name: instrument_mode_btn_class),
      decls: [
        decl(prop: FontFamily, value: scale_var(t: font_mono)),
        decl(prop: FontSize, value: scale_var(t: text_12)),
        decl(prop: Padding, value: scale_var(t: space_4)),
        decl(prop: Border, value: join(["1px solid ", role_var(r: BorderRole)], "")),
        decl(prop: BorderRadius, value: scale_var(t: radius_3)),
        decl(prop: Background, value: role_var(r: SurfaceRole)),
        decl(prop: Color, value: role_var(r: TextRole)),
        decl(prop: extdeps.languages.css.properties.Cursor, value: "pointer"),
      ],
    },
    gunbc.design.material.StaticRule {
      selector: gunbc.roadmap_instrument_tuner.cls(name: join([instrument_mode_btn_class, ".is-active"], "")),
      decls: [
        decl(prop: Border, value: join(["1px solid ", role_var(r: FocusRole)], "")),
      ],
    },
    gunbc.design.material.StaticRule {
      selector: gunbc.roadmap_instrument_tuner.cls(name: instrument_subject_class),
      decls: [
        decl(prop: Display, value: "flex"),
        decl(prop: Gap, value: scale_var(t: space_6)),
        decl(prop: Padding, value: scale_var(t: space_2)),
        decl(prop: extdeps.languages.css.properties.Cursor, value: "pointer"),
      ],
    },
    gunbc.design.material.StaticRule {
      selector: gunbc.roadmap_instrument_tuner.cls(name: join([instrument_subject_class, ".instrument-subject-selected"], "")),
      decls: [
        decl(prop: Border, value: join(["1px solid ", role_var(r: FocusRole)], "")),
      ],
    },
  ]
}

fn instrument_tuner_css() -> String {
  join([instrument_css(), serialize_rules(rules: tuner_control_rules())], "\n")
}

fn all_focus_subjects() -> List<gunbc.design.instrument_camera.FocusSubject> {
  concat(
    [NoSubjectSelected],
    v1_exit_finish_lines() |> map(s => focus_finish_line(l: s.line)),
  )
}

fn cameras_for_focus(f: gunbc.design.instrument_camera.FocusSubject) -> List<gunbc.design.instrument_camera.ProgramCamera> {
  flat_map(program_depths(), d =>
    map(program_modes(), m => gunbc.design.instrument_camera.ProgramCamera { depth: d, mode: m, focus: f }))
}

fn all_cameras() -> List<gunbc.design.instrument_camera.ProgramCamera> {
  flat_map(all_focus_subjects(), f => cameras_for_focus(f: f))
}

fn instrument_tuner_camera_population_joined() -> Bool {
  count(all_cameras()) == count(program_depths()) * count(program_modes()) * count(all_focus_subjects())
    && count(all_focus_subjects()) == 1 + count(v1_exit_finish_lines())
}

fn remaining_text(r: gunbc.roadmap_program_view.RemainingShape) -> String {
  join([
    "depth ", to_string(r.sequential_depth),
    " · open fronts ", to_string(r.open_fronts),
    " · startable ", to_string(r.startable_now),
    " · in flight ", to_string(r.in_flight),
    " · dependency-held ", to_string(r.dependency_held),
    " · contract-held ", to_string(r.contract_held),
  ], "")
}

fn render_reading(label: String, r: gunbc.design.instrument_audition.ProgramReading) -> std.markup.Fragment {
  match r {
    ReadingNoSubject => fragment_row(cells: [ fragment_cell(s: label), fragment_cell(s: "no subject selected") ])
    ReadingProgramShape { remaining } =>
      fragment_row(cells: [ fragment_cell(s: label), fragment_cell(s: "whole program"), fragment_cell(s: gunbc.roadmap_instrument_tuner.remaining_text(r: remaining)) ])
    ReadingOutcomeStatus { name, node, accepted, open_fronts } => fragment_row(cells: [
      fragment_cell(s: label),
      fragment_cell(s: name),
      fragment_cell(s: node),
      fragment_cell(s: if accepted { "accepted" } else { "not accepted" }),
      fragment_cell(s: join([to_string(open_fronts), " open fronts"], "")),
    ])
    ReadingOutcomeRemaining { name, remaining } =>
      fragment_row(cells: [ fragment_cell(s: label), fragment_cell(s: name), fragment_cell(s: gunbc.roadmap_instrument_tuner.remaining_text(r: remaining)) ])
    ReadingConstraint { subject, kind, headline, in_flight, depth } => fragment_row(cells: [
      fragment_cell(s: label),
      fragment_cell(s: join([kind, " constraint"], "")),
      fragment_cell(s: subject),
      fragment_cell(s: headline),
      fragment_cell(s: if in_flight { "work observed" } else { "no work observed" }),
    ])
    ReadingNoConstraint { subject_key, reason } =>
      fragment_row(cells: [ fragment_cell(s: label), fragment_cell(s: subject_key), fragment_cell(s: reason) ])
    ReadingFront { key, name, closed, gates_accepted, gates_total } => fragment_row(cells: [
      fragment_cell(s: label),
      fragment_cell(s: name),
      fragment_cell(s: join([to_string(gates_accepted), " of ", to_string(gates_total), " gates accepted"], "")),
      fragment_cell(s: if closed { "closed" } else { "open" }),
    ])
    ReadingUnavailable { mode, subject_key, cause } =>
      el_class("div", instrument_refusal_class, [
        txt(join([label, " · ", subject_key, " — unavailable: ", cause], "")),
      ])
  }
}

fn reading_row(view: gunbc.roadmap_program_view.V1DeletionProgramView, camera: gunbc.design.instrument_camera.ProgramCamera) -> std.markup.Fragment {
  let key = camera_wire(c: camera)
  let label = join([program_depth_key(d: camera.depth), " / ", program_mode_key(m: camera.mode)], "")
  let initial = camera_wire(c: camera_initial) == key
  el_attrs("div", concat(
    [
      attr(name: "class", value: instrument_reading_class),
      attr(name: "data-reading-key", value: key),
    ],
    if initial { [] } else { [ attr(name: "hidden", value: "") ] },
  ), [
    gunbc.roadmap_instrument_tuner.render_reading(
      label: label,
      r: read_camera(camera: camera, view: view),
    ),
  ])
}

fn depth_button(d: gunbc.design.instrument_camera.ProgramDepth) -> std.markup.Fragment {
  el_attrs("button", [
    attr(name: "type", value: "button"),
    attr(name: "class", value: instrument_depth_btn_class),
    attr(name: "data-depth", value: program_depth_key(d: d)),
  ], [ txt(join([to_string(program_depth_index(d: d)), " · ", program_depth_key(d: d)], "")) ])
}

fn mode_button(m: gunbc.design.instrument_camera.ProgramMode) -> std.markup.Fragment {
  el_attrs("button", [
    attr(name: "type", value: "button"),
    attr(name: "class", value: instrument_mode_btn_class),
    attr(name: "data-mode", value: program_mode_key(m: m)),
  ], [ txt(program_mode_key(m: m)) ])
}

fn subject_row(spec: gunbc.v1_deletion_plan.V1FinishLineSpec) -> std.markup.Fragment {
  let key = v1_finish_line_key(l: spec.line)
  el_attrs("li", [
    attr(name: "class", value: instrument_subject_class),
    attr(name: "tabindex", value: "0"),
    attr(name: "data-subject-key", value: key),
  ], [
    fragment_cell(s: spec.name),
    fragment_cell(s: key),
    fragment_cell(s: spec.claim),
  ])
}

fn controls_section() -> std.markup.Fragment {
  el("section", [
    el("h2", [ txt("camera controls") ]),
    instrument_note(s: "Wheel and arrow keys admit one detent per threshold crossing; distant depth labels decompose into adjacent steps. Mode buttons switch reading projection."),
    el_class("div", instrument_row_class, map(instrument_user_depths(), d => depth_button(d: d))),
    el_class("div", instrument_row_class, map(program_modes(), m => mode_button(m: m))),
  ])
}

fn subjects_section() -> std.markup.Fragment {
  el("section", [
    el("h2", [ txt("finish lines") ]),
    instrument_note(s: "Selection follows the production roadmap: click the row, keyboard focus with focus-visible, re-select to clear, Escape clears. Controls on the row do not move selection."),
    el("ul", map(v1_exit_finish_lines(), s => subject_row(spec: s))),
  ])
}

fn readings_section(view: gunbc.roadmap_program_view.V1DeletionProgramView) -> std.markup.Fragment {
  el("section", [
    el("h2", [ txt("reading") ]),
    instrument_note(s: "One row per camera state, pre-rendered from the live derived world. The client program reveals the row that matches the persistent camera."),
    el("div", map(all_cameras(), c => reading_row(view: view, camera: c))),
  ])
}

fn tuner_main(view: gunbc.roadmap_program_view.V1DeletionProgramView) -> std.markup.Fragment {
  el_class("main", instrument_tuner_root_class, [
    controls_section(),
    subjects_section(),
    readings_section(view: view),
  ])
}

fn tuner_refusal_page(causes: List<String>) -> std.markup.Fragment {
  el_class("main", instrument_tuner_root_class, concat(
    [ el_class("div", instrument_refusal_class, [ txt("program view refused — the tuner draws nothing rather than a smaller program") ]) ],
    map(causes, c => el_class("div", instrument_refusal_class, [ txt(c) ])),
  ))
}

fn instrument_tuner_page() -> std.markup.Fragment {
  extdeps.browser.Element {
    tag: "html",
    attributes: [ attr(name: "lang", value: "en") ],
    children: [
      el("head", [
        std.markup.Element { tag: "meta", attributes: [ attr(name: "charset", value: "utf-8") ], children: [] },
        std.markup.Element {
          tag: "meta",
          attributes: [
            attr(name: "name", value: "viewport"),
            attr(name: "content", value: "width=device-width, initial-scale=1"),
          ],
          children: [],
        },
        el("style", [ txt(instrument_tuner_css()) ]),
        el("title", [ txt("gunbc — v1-deletion tuner") ]),
      ]),
      el("body", [
        el("header", [
          el_class("div", "header-inner", [
            el_class("span", "wordmark", [ txt("gunbc") ]),
            el("h1", [ txt("v1-deletion tuner") ]),
            el_attrs("a", [ attr(name: "href", value: instrument_motion_page_path) ], [ txt("motion lab") ]),
            el_attrs("button", [
              attr(name: "class", value: "sound-toggle"),
              attr(name: "type", value: "button"),
            ], [ txt("sound") ]),
            el_attrs("button", [
              attr(name: "class", value: "theme-toggle"),
              attr(name: "type", value: "button"),
            ], [ txt("theme · auto") ]),
          ]),
        ]),
        match live_program_view_result() {
          LiveViewRefused { causes } => tuner_refusal_page(causes: causes)
          LiveViewDerived { view } => tuner_main(view: view)
        },
        std.markup.Element {
          tag: "script",
          attributes: [
            attr(name: "src", value: instrument_tuner_asset_path),
            attr(name: "defer", value: ""),
          ],
          children: [],
        },
      ]),
    ],
  }
}
