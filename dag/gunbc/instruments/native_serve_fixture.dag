module gunbc.instruments.native_serve_fixture

import std.types { String, CommitSha }
import std.compiler_entry { CompilerEntryDriver, NativeServeDriver }
import extdeps.http.server { ServeWireResponse, ServeWireHeader, WireHeaderLocation }
import gunbc.native_serve { native_serve_text_plain }

// THE SMALLEST SERVICE THAT EXERCISES EVERY DECISION OF THE NATIVE SERVE DOOR, served by
// `gunbc test //gunbc/instruments:native-serve` (gunbc.native_serve_probe judges what it answers).
// Each route exists for one fact the door owes: /hello reads the identity header the door framed
// (sent in mixed case, so case-insensitive field names are exercised), /redirect sets a typed
// header the door writes, /split-header sets one whose value would split the header block (the door
// must answer 500, not write it), /split-content-type does the same through the content type, /echo reads exactly the body
// length the door framed, and every other path is the handler's own typed refusal. Nothing here is
// a production route; the approval broker is this arm's second consumer.
data compiler_pipeline_entry: CompilerEntryDriver = NativeServeDriver

fn fixture_text(status: Int, body: String) -> ServeWireResponse {
  ServeWireResponse { status: status, content_type_label: native_serve_text_plain, body: body, headers: [] }
}

fn native_serve_handle(method: String, path: String, body: String, tailscale_identity: String, release_revision: CommitSha) -> ServeWireResponse {
  if path == "/hello" && method == "GET" {
    fixture_text(status: 200, body: concat("hello, ", concat(tailscale_identity, "\n")))
  } else if path == "/redirect" && method == "GET" {
    ServeWireResponse { status: 303, content_type_label: native_serve_text_plain, body: "", headers: [ServeWireHeader { name: WireHeaderLocation, value: "/hello" }] }
  } else if path == "/split-header" && method == "GET" {
    ServeWireResponse { status: 303, content_type_label: native_serve_text_plain, body: "", headers: [ServeWireHeader { name: WireHeaderLocation, value: "/hello\r\nX-Injected: 1" }] }
  } else if path == "/split-content-type" && method == "GET" {
    ServeWireResponse { status: 200, content_type_label: "text/plain\r\nX-Injected: 1", body: "x", headers: [] }
  } else if path == "/echo" && method == "POST" {
    fixture_text(status: 200, body: body)
  } else {
    fixture_text(status: 404, body: concat("no route for ", concat(method, concat(" ", concat(path, "\n")))))
  }
}
