module gunbc.instruments.claim_operand

// THE LABEL RULE'S SINGLE HOME, PLACED BELOW THE host_prelude <-> roadmap_execution_contract
// CIRCLE. `claim_identity_operand` derives a claim's route label from a roster row's (module file,
// function) and refuses typed when the row is not addressable on the claim route. It lives here -- a
// module whose only imports are `extdeps.bazel.label` and `std.types` -- because BOTH `host_prelude`
// (its pooled argv builder) and `roadmap_execution_contract` (a validation arm that names a claim)
// need it, and `host_prelude` already reaches `roadmap_execution_contract` transitively: importing
// `host_prelude` into the roadmap model closed a dependency cycle and made every claim that imports
// host_prelude unobservable. The label authority itself is `gunbc.extdeps.bazel.label`; this module adds
// only the claim-universe gate over it. Callers that already import `host_prelude` for its other
// surface import these three names from here instead.

import std.types { String }
import extdeps.bazel.label { LabelParsed, LabelRefused, parse_label, render_label, label_refusal_text }

type ClaimOperandAdmission
  = ClaimOperand { label: String }
  | ClaimOperandUnnameable { entry: String, function: String, reason: String }

// THE CLAIM'S IDENTITY, AS THE ROUTE READS IT: `//test/claim/<module>:<function>`, rendered by
// `extdeps.bazel.label` `render_label` rather than by concatenation, so the label this instrument runs is the
// label the route reports on its result line and the label the corpus declares. Two shapes are refused before a
// child is paid for. An entry outside the route's universe -- `gunbc.discovery_census` `claim_route_universe`,
// the subtree `//test/claim/...` -- is not addressable through the claim route at all, and the out-of-universe
// shape a builder reaches for by mistake is a `src/v2/test/claim/...` module: the interpreter never sees a
// `//v2/...` label, so a row naming one refuses here rather than becoming a plausible-looking operand.
//
// THE ROOT IS NOT PART OF THE LABEL, AND THE SLASHES ARE. Which corpora the route reads is a separate option
// (`--source-root`), so the leading corpus root is dropped as a root while `test/claim/` is kept as identity --
// `dag/test/claim/nested/beta_witness.dag` is the claim `//test/claim/nested/beta_witness`, not
// `//dag/test/claim/nested/beta_witness`, which lies outside the universe and would exit 2 in a child minutes
// after the runner was paid for. The package path stays in slash form because that is the form the label
// authority parses (`gunbc.extdeps.bazel.label`, e.g. `//my/app/lib:lib`), and the label is rendered back by
// that authority rather than guessed at: a dotted hand-built label names a target no discovery row reports, and
// a folded result line would carry an identity no operand asked for.
//
// THE PATH IS REBUILT BY REPLACING, NOT SLICING. A list index in this language is optional and an off-by-one in
// a slice is silent, while `replace` on a marker just checked to occur exactly once is total; the count checks
// are what keep "exactly once" honest, because `replace` replaces every occurrence -- a module named `dag_x`
// under the root would otherwise lose its root marker too, and a name carrying `.dag` twice is a roster row
// this instrument should not be improvising an identity for.
fn claim_identity_operand(entry: String, function: String) -> ClaimOperandAdmission {
  let root = "dag/"
  let universe = "test/claim/"
  let root_count = count(entry.split(delimiter: root))
  if entry.starts_with(root) && root_count != 2 {
    ClaimOperandUnnameable {
      entry: entry,
      function: function,
      reason: "the module path carries the corpus root marker more than once",
    }
  } else {
    let after_root = if entry.starts_with(root) { entry.replace(from: root, to: "") } else { entry }
    if !after_root.starts_with(universe) {
      ClaimOperandUnnameable {
        entry: entry,
        function: function,
        reason: "the entry is not a module in the claim universe test/claim, the subtree the claim route addresses (gunbc.discovery_census claim_route_universe)",
      }
    } else if !entry.ends_with(".dag") {
      ClaimOperandUnnameable {
        entry: entry, function: function, reason: "the entry is not a .dag module path"
      }
    } else if count(after_root.split(delimiter: ".dag")) != 2 {
      ClaimOperandUnnameable {
        entry: entry,
        function: function,
        reason: "the module name carries more than one .dag suffix",
      }
    } else {
      let package_path = after_root.replace(from: ".dag", to: "")
      match parse_label(text: concat(concat(concat("//", package_path), ":"), function)) {
        // THE LABEL IS PARSED, NOT ASSUMED. `extdeps.bazel.label` is the authority on what a label is, and
        // it refuses the set forms (`TargetPattern`), a `.` segment, a relative path, a repository
        // qualifier. Asking it is what makes "the operands are exact labels" a property of the builder
        // rather than a hope about the roster: a row whose function was spelled `:all` -- the widening the
        // plan forbids a caller to do -- arrives here as a refusal with the authority's own reason.
        LabelParsed { label: label } => ClaimOperand { label: render_label(l: label) }
        LabelRefused { cause: cause } => ClaimOperandUnnameable {
          entry: entry, function: function, reason: label_refusal_text(r: cause)
        }
      }
    }
  }
}

