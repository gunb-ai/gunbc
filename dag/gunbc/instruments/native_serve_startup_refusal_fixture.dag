module gunbc.instruments.native_serve_startup_refusal_fixture

import std.types { String, Int, List, CommitSha }
import std.compiler_entry { CompilerEntryDriver, NativeServeDriver }
import extdeps.http.server { ServeWireResponse }
import gunbc.native_serve { native_serve_application_json, NativeServeStartup, NativeServeStartupPassed, NativeServeStartupRefused }
import gunbc.auth.approval_device_crypto_realization { DeviceCryptoObligation, DeviceCryptoHandlerReceipt, device_crypto_obligations, device_crypto_handler_identity }
import gunbc.auth.approval_device_crypto_receipt { device_crypto_receipt_startup }

// THE CONTROL SERVICE FOR THE STARTUP FOLD (gunbc.native_serve native_serve_startup_entry_function): a NativeServeDriver
// entry whose startup mints, for EACH obligation of device_crypto_obligations, a receipt that covers every OTHER
// obligation and asks the one receipt judge (gunbc.auth.approval_device_crypto_receipt device_crypto_receipt_startup)
// about it. When every one of those receipts refuses, the startup refuses, and the door must exit without binding; when
// any dropped obligation were admitted, the startup passes, the service binds and announces, and the reader
// (gunbc.instruments.native_serve_startup_refusal_probe) is red. So the control is discriminating twice: it establishes
// that dropping any one obligation makes the receipt refuse, and that a refusing startup fold blocks the bind.
// Its handler answers nothing the reader looks at.
data compiler_pipeline_entry: CompilerEntryDriver = NativeServeDriver

fn without_obligation(dropped: DeviceCryptoObligation) -> List<DeviceCryptoObligation> {
  filter(device_crypto_obligations, o => o != dropped)
}

fn dropped_refusal(dropped: DeviceCryptoObligation) -> String? {
  match device_crypto_receipt_startup(covered: without_obligation(dropped: dropped), exact_revision: "fixture-revision") {
    NativeServeStartupRefused { reason: why } => Present { value: why }
    NativeServeStartupPassed { line: _, value: _ } => none
  }
}

fn native_serve_startup(executable_octets: List<Int>) -> NativeServeStartup<DeviceCryptoHandlerReceipt> {
  let refusals = flat_map(device_crypto_obligations, o =>
    match dropped_refusal(dropped: o) {
      Present { value: why } => [why]
      Absent => []
    })
  if count(refusals) == count(device_crypto_obligations) {
    NativeServeStartupRefused { reason: join(refusals, " | ") }
  } else {
    NativeServeStartupPassed { line: "an obligation was dropped and its receipt was admitted", value: DeviceCryptoHandlerReceipt { handler_identity: device_crypto_handler_identity, exact_revision: "fixture-revision", covered: device_crypto_obligations } }
  }
}

fn native_serve_handle(method: String, path: String, body: String, tailscale_identity: String, release_revision: CommitSha, receipt: DeviceCryptoHandlerReceipt) -> ServeWireResponse {
  ServeWireResponse { status: 200, content_type_label: native_serve_application_json, body: "unreachable\n", headers: [] }
}
