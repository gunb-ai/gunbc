module gunbc.instruments.emit_value_shape_observation

import std.types { Bool, Int, List }
import std.realization_measurement { AllocationCounter, AllocationObservation, allocation_span_observation, allocation_provider_not_selected }
import std.compiler_entry { CompilerEntryDriver, NativeClaimDriver, NativeClaimReport, NativeClaimTerminal, NativeClaimHeld, NativeClaimNotHeld }
import gunbc.emit_copy_qualification { EmitCopyQualificationCaseId, CaseApplicability, CaseApplicable, CaseNotApplicable, StructuralInapplicability, PatternRequiresConsumingContract, PatternRequiresBorrowingContract, ScalarBasisRequiresCopyScalarCarrier, SizedBasisRequiresSizedCarrier, structural_inapplicability_slug, applicable_case_rows, row_is_applicable, case_slug }
import gunbc.emit_building_block_contracts { BuildingBlockContract, BuildingBlockFamily, ValueShapes, ControlFlow, Accumulator, Carriers, family_slug, building_block_contracts, contract_block_count, contracts_of_family, contract_verdict, case_in_applicable_roster, violating_form_slug, violating_form_exercised, contract_line, roster_membership_line, roster_membership_lines, MispairedProbe, mispaired_probes, probe_guard_holds, probe_lines , applicability_discriminates, applicability_refused_rows, applicability_accepted_probes }
// The eight observation renderers used to be imported from gunbc.instruments
// .native_allocation_observation. That module declares a compiler pipeline entry, so
// importing it put a SECOND entry in this closure and the emitter refused the whole
// crate with compile_error! at src/v1/stage0/src/v1_compiler_emit_rust.rs:46363
// (emit_ambiguous_compiler_pipeline_main_rs). The renderers are a vocabulary over
// std.realization_measurement types, so they are carried by the contract module below,
// which declares no entry. The peer module is untouched and its own copy stays its
// authority for its rows; this fork exists until the emitter chooses the subject's
// entry, and the row's handback names it as the blocker for this family.
import gunbc.emit_building_block_contracts { AllocationCase, case_line, is_observed, span_is_zero, operations_above, operations_within, span_text, count_text }
import gunbc.emit_state_threading_specimen { spec_build }

// THE VALUE-SHAPE GROUP OF THE BUILDING-BLOCK BATTERY, deliverable two of the roadmap row
// #gunbc.roadmap.roadmap_authority::declared_roadmap_nodes, id emission-building-block-realization.
// Its handback asks for "the building-block contracts, their executing specimens and violating
// variants, and the measured realization of each", and its red_control asks that "for each specimen
// a violating variant goes through the same path and goes red". This file carries the five blocks of
// family ValueShapes; each has its contract in gunbc.emit_building_block_contracts, one reading of
// the specimen, and one violating variant that runs the SAME path with one forbidden thing added.
//
// THE SHAPE IS CHOSEN FROM THIS ROW'S OWN PINNED COUNTER DATA, not from a parse-population profile
// (which does not exist at this base) and not by taste. The discriminating gap is the cloning control
// against the reference walk, 43711 ops / 21853472 bytes against 6112 ops / 1401008 bytes, in
// run3.log sha256 7d722dbb2a45942a8cbe85ef7714060d2e6af6c3ed90c3032474c1f34d29dd7f. A whole
// invocation's wall clock and RSS corroborate those magnitudes but cannot attribute them to a step.
// The counter arm sees OPERATIONS AND BYTES ONLY: no traversal count, no per-phase lifetime. Those
// gaps are still owed by the vocabulary work in gunbc.emit_ownership_facts and are not claimed here
// (gunbc.emit_copy_qualification copy_work_dimension_unavailable_cause).
//
// FOUR ANSWERS, NOT ONE VERDICT, borrowed from gunbc.instruments.native_allocation_observation,
// The renderers behind those four answers are carried by gunbc.emit_building_block_contracts,
// not imported from that instrument: importing a module that declares a compiler pipeline entry
// puts a second entry in this closure and the emitter refuses the crate (its main becomes a
// compile_error! at src/v1/stage0/src/v1_compiler_emit_rust.rs:46363).
// because a bound that reds when the repair succeeds punishes the repair:
//   AVAILABILITY  the selecting main registered the counting allocator before any read.
//   OBSERVATION   the meter worked: an empty window reads zero, a copying arm reads above it.
//   SUBJECT       the specimen's READING, taken. It holds when the reading was taken; a
//                 zero-allocation subject is a reading, not a failure. It is never a bound.
//   VIOLATION     the arm that must go red, judged against the contract arm on the same path.
//
// Counter counts do not measure copy work and establish no runtime win
// (gunbc.recurring_failure_mode by_value_record_widens_container_slots). They are read here to say
// which ownership and allocation facts the emitted Rust carries, not that they are optimal.

data compiler_pipeline_entry: CompilerEntryDriver = NativeClaimDriver

// Large enough that a per-step allocation cannot hide in it, small enough to read.
data specimen_cardinality: Int = 32

// THE NONTRIVIAL PAYLOAD. The boundary asks for a generic instance over a scalar AND over a
// nontrivial payload, so the payload is a record of a sequence, an index and a scalar: the smallest
// thing that is not a scalar.
type BbTriple {
  xs: List<Int>
  k: Int
  log: List<Int>
}

// A NONRECURSIVE VARIANT, one of the boundary's named blocks. No arm mentions BbVariant.
type BbVariant = VariantNumber { value: Int } | VariantWords { payload: BbTriple }

fn variant_total(v: BbVariant) -> Int {
  match v {
    VariantNumber { value: n } => n
    VariantWords { payload: p } => p.k
  }
}

// THE GENERIC INSTANCE. One body, instantiated at a scalar (Int) and at a nontrivial payload
// (BbTriple). The emitter decides whether the payload crosses by move or by clone; this file only
// reads what it decided.
fn bb_select<T>(first_value: T, second_value: T, take_first: Bool) -> T {
  if take_first { first_value } else { second_value }
}

type BbSubject =
    MeterEmpty
  | MeterKnownAllocation
  | ScalarRead
  | ScalarRetainAddedToObservation
  | RecordFieldRead
  | RecordRebuiltToReadOneField
  | VariantConsumedOnce
  | VariantPayloadCopiedToMatch
  | GenericScalarSelected
  | GenericPayloadSelected
  | GenericPayloadCopiedAtBoundary
  | GenericPayloadMaterializedPerInstantiation

fn bb_scalar_of(src: List<Int>) -> Int {
  fold(src, init: 0, f: (acc, x) => acc + x)
}

fn bb_payload_of(src: List<Int>) -> BbTriple {
  fold(src, init: BbTriple { xs: [], k: 0, log: [] }, f: (acc, x) =>
    BbTriple { xs: list_push(acc.xs, x), k: acc.k + x, log: list_push(acc.log, 1) })
}

// A record rebuild with one field changed, read straight back: the boundary's named block, and the
// row's third violating form ("a copy of the unchanged context") when it stands in for a field read.
fn bb_rebuild(p: BbTriple, k: Int) -> BbTriple {
  BbTriple { xs: p.xs, k: k, log: p.log }
}

// AN OWNING RETAIN ADDED TO AN OBSERVATION: the row's first violating form. The scalar is still read,
// and the shared payload is additionally retained through the generic instance.
fn bb_scalar_with_retain(payload: BbTriple) -> List<Int> {
  let retained = bb_select(first_value: payload, second_value: payload, take_first: true)
  list_push(list_push([], retained.k), retained.k)
}

// ONE PATH FOR EVERY ARM. Every subject runs inside this single body, so a violating variant and its
// contract arm differ only in the arm, never in the path around it, which is what the row's
// red_control means by "goes through the same path".
fn run_bb_subject(subject: BbSubject, src: List<Int>) -> List<Int> {
  let n = bb_scalar_of(src: src)
  let payload = bb_payload_of(src: src)
  match subject {
    MeterEmpty => []
    MeterKnownAllocation => list_push([], 4096)
    ScalarRead => list_push([], n)
    ScalarRetainAddedToObservation => bb_scalar_with_retain(payload: payload)
    RecordFieldRead => list_push([], payload.k)
    RecordRebuiltToReadOneField => list_push([], bb_rebuild(p: payload, k: payload.k + 1).k)
    VariantConsumedOnce => list_push([], variant_total(v: VariantNumber { value: n }))
    VariantPayloadCopiedToMatch => list_push([], variant_total(v: VariantWords {
      payload: bb_select(first_value: payload, second_value: payload, take_first: true) }))
    GenericScalarSelected => list_push([], bb_select(first_value: n, second_value: 0 - n, take_first: true))
    GenericPayloadSelected => list_push([], bb_select(first_value: payload, second_value: bb_payload_of(src: src), take_first: false).k)
    GenericPayloadCopiedAtBoundary => list_push([], bb_select(first_value: payload, second_value: bb_payload_of(src: src), take_first: true).k)
    GenericPayloadMaterializedPerInstantiation => list_push([], bb_select(first_value: bb_select(first_value: n, second_value: payload.k, take_first: true), second_value: n, take_first: true))
  }
}

type BbWindow {
  kept: List<Int>
  kept_len: Int
  observation: AllocationObservation
}

// The window is the carrier instrument's own shape (its window_around): read both axes, run, read
// both axes again, and if the provider was never selected, say so as its own answer rather than
// calling zero a result.
fn bb_window(subject: BbSubject, src: List<Int>) -> BbWindow uses counter: AllocationCounter {
  if observed_allocation_available("") {
    let ops_before = observed_allocation_operations("")
    let bytes_before = observed_allocation_bytes("")
    let kept = run_bb_subject(subject: subject, src: src)
    let kept_len = count(kept)
    let ops_after = observed_allocation_operations("")
    let bytes_after = observed_allocation_bytes("")
    BbWindow { kept: kept, kept_len: kept_len, observation: allocation_span_observation(operations_before: ops_before, operations_after: ops_after, bytes_before: bytes_before, bytes_after: bytes_after) }
  } else {
    let kept = run_bb_subject(subject: subject, src: src)
    BbWindow { kept: kept, kept_len: count(kept), observation: allocation_provider_not_selected() }
  }
}

fn reading(label: String, o: AllocationObservation) -> String {
  span_text(label: label, o: o)
}

fn readings(a_label: String, a: AllocationObservation, b_label: String, b: AllocationObservation) -> String {
  concat(reading(label: a_label, o: a), " ", reading(label: b_label, o: b))
}

// SUBJECT: a READING, so it holds when the reading was taken. Never a bound on the count.
fn subject_case(block_id: String, own: BbWindow) -> AllocationCase {
  AllocationCase {
    identity: concat("value_shape_", block_id, "_reading_taken"),
    held: is_observed(o: own.observation),
    observed: concat(reading(label: "own", o: own.observation), " ", count_text(label: "own_kept", n: own.kept_len))
  }
}

// The VIOLATING VARIANT against its contract arm, on the same path. This is the arm that goes red in
// the red entry and holds here.
fn violation_case(block_id: String, viol: BbWindow, contract_arm: BbWindow) -> AllocationCase {
  AllocationCase {
    identity: concat("value_shape_", block_id, "_violating_variant_above_contract_arm"),
    held: is_observed(o: viol.observation) && operations_above(a: viol.observation, b: contract_arm.observation),
    observed: concat(readings(a_label: "violating", a: viol.observation, b_label: "contract_arm", b: contract_arm.observation), " ", count_text(label: "violating_kept", n: viol.kept_len), " ", count_text(label: "contract_arm_kept", n: contract_arm.kept_len))
  }
}

// THE RED CONTROL, the same two observations judged the opposite way. False by construction, so the
// entry that carries it exits non-zero and prints the identical observed= text the green entry does.
fn violation_contract_holds_case(block_id: String, viol: BbWindow, contract_arm: BbWindow) -> AllocationCase {
  AllocationCase {
    identity: concat("value_shape_", block_id, "_violating_variant_within_contract_arm"),
    held: is_observed(o: viol.observation) && operations_within(a: viol.observation, b: contract_arm.observation),
    observed: concat(readings(a_label: "violating", a: viol.observation, b_label: "contract_arm", b: contract_arm.observation), " ", count_text(label: "violating_kept", n: viol.kept_len), " ", count_text(label: "contract_arm_kept", n: contract_arm.kept_len))
  }
}

// THE FIVE VALUE-SHAPE BLOCKS of the boundary: a Value (scalar, record, nonrecursive variant) and the
// two generic instances (over a scalar, over a nontrivial payload). Each pair is (contract arm,
// violating variant) and both arms are the SAME subject bodies from run_bb_subject.
// Each window is taken by its own `uses counter:` call, the way the carrier instrument takes its
// four (empty, known, specimen, reference). Nothing is indexed out of a list, because the language
// gives no indexed access and pretending otherwise would be an invented name.
fn value_shape_cases() -> List<AllocationCase> uses counter: AllocationCounter {
  let src = spec_build(n: specimen_cardinality)
  let empty = bb_window(subject: MeterEmpty, src: src)
  let empty_again = bb_window(subject: MeterEmpty, src: src)
  let known = bb_window(subject: MeterKnownAllocation, src: src)
  let scalar_read = bb_window(subject: ScalarRead, src: src)
  let scalar_retain = bb_window(subject: ScalarRetainAddedToObservation, src: src)
  let field_read = bb_window(subject: RecordFieldRead, src: src)
  let rebuilt = bb_window(subject: RecordRebuiltToReadOneField, src: src)
  let variant_once = bb_window(subject: VariantConsumedOnce, src: src)
  let variant_copied = bb_window(subject: VariantPayloadCopiedToMatch, src: src)
  let generic_scalar = bb_window(subject: GenericScalarSelected, src: src)
  let generic_materialized = bb_window(subject: GenericPayloadMaterializedPerInstantiation, src: src)
  let generic_selected = bb_window(subject: GenericPayloadSelected, src: src)
  let generic_copied = bb_window(subject: GenericPayloadCopiedAtBoundary, src: src)
  [
    AllocationCase { identity: "value_shape_availability_provider_registered_by_the_selecting_main", held: observed_allocation_available(""), observed: concat("available=", to_string(value: observed_allocation_available(""))) },
  // SUPERSEDED CLAIM, kept visible: this row was
  // `value_shape_observation_empty_window_reads_zero`, asserting an empty window reads zero.
  // Measurement refused that on srv1 (acquisition 9, head 859f8b97e93): the empty window
  // read 38 operations and 2,648 bytes, because the four counter reads and the span record
  // inside the window allocate that themselves -- zero is unreachable for any sampler that
  // allocates. It is redefined as floor-plus-difference: two empty windows must agree
  // exactly AND the known copying arm must sit strictly above that floor on BOTH counters.
  // Without the second conjunct a stuck or cached sampler would pass it, which is what
  // acquisition 9 showed (both arms of a retain pair read 75). The floor is printed, never
  // pinned: 38 and 2,648 are properties of the sampler and may move when it stops leaking.
    AllocationCase { identity: "value_shape_observation_calibrates_a_measured_floor_with_a_difference", held: spans_agree(a: empty.observation, b: empty_again.observation) && operations_above(a: known.observation, b: empty.observation) && bytes_above(a: known.observation, b: empty.observation), observed: concat(concat("floor_is_measured_not_assumed", span_text(label: "empty_a", o: empty.observation)), " ", span_text(label: "empty_b", o: empty_again.observation), " ", span_text(label: "known", o: known.observation), " ", count_text(label: "known_kept", n: known.kept_len), " ", count_text(label: "empty_kept", n: empty.kept_len)) },
    AllocationCase { identity: "value_shape_meter_discriminates_a_copying_arm_above_empty", held: operations_above(a: known.observation, b: empty.observation), observed: concat(readings(a_label: "known", a: known.observation, b_label: "empty", b: empty.observation), " ", count_text(label: "known_kept", n: known.kept_len), " ", count_text(label: "empty_kept", n: empty.kept_len)) },
    subject_case(block_id: "value_scalar", own: scalar_read),
    violation_case(block_id: "value_scalar", viol: scalar_retain, contract_arm: scalar_read),
    subject_case(block_id: "value_record", own: field_read),
    violation_case(block_id: "value_record", viol: rebuilt, contract_arm: field_read),
    subject_case(block_id: "value_nonrecursive_variant", own: variant_once),
    violation_case(block_id: "value_nonrecursive_variant", viol: variant_copied, contract_arm: variant_once),
    subject_case(block_id: "generic_instance_over_scalar", own: generic_scalar),
    violation_case(block_id: "generic_instance_over_scalar", viol: generic_materialized, contract_arm: generic_scalar),
    subject_case(block_id: "generic_instance_over_nontrivial_payload", own: generic_selected),
    violation_case(block_id: "generic_instance_over_nontrivial_payload", viol: generic_copied, contract_arm: generic_selected)
  ]
}

// THE MODULE ITSELF JUDGES THE POPULATION, not this file. Applicability is the carrier's verdict:
// `fn case_applicability` in gunbc.emit_copy_qualification chains `fn carrier_realized`,
// `fn basis_admits_carrier`, `fn pattern_admits_shape`, `fn pattern_admits_carrier` and
// `fn pattern_admits_contract`, and each case below asks that chain and prints what it said. A
// contract whose specimen never executed still reads unqualified, so nothing here claims
// qualification from applicability alone.
fn refusal_not_hit(name: String, refusal: StructuralInapplicability) -> AllocationCase {
  AllocationCase {
    identity: concat("contract_refusal_not_hit_by_the_population_", name),
    held: count(filter(building_block_contracts(), c => contract_verdict(c: c.case_id) == structural_inapplicability_slug(r: refusal))) == 0,
    observed: concat("refusal=", structural_inapplicability_slug(r: refusal), " judged_by=case_applicability")
  }
}

fn all_probes_refused() -> Bool {
  count(filter(mispaired_probes(), p => !probe_guard_holds(p: p))) == 0
}

// THE ROSTER IS CHECKED AGAINST SOMETHING OUTSIDE ITSELF. `fn contract_block_count` is
// `building_block_contracts() |> count`, so comparing the two would be `measure() == measure()` and
// would check nothing (gunbc.design_argument fail_closed; guarantee_ladder: a check whose forbidden
// state is expressible nowhere it runs is a decoration, green by construction and later cited as
// coverage). So the roster is joined against `fn declared_block_ids`, a set written by hand here and
// not derived from the module: it goes red if the roster drops a block, renames one, duplicates an id,
// or grows past the coverage the boundary pays for. `family_sum` is printed as a READING only, because
// it is derived from the same roster and structurally cannot fail.
fn declared_block_ids() -> List<String> {
  [ "value_scalar", "value_record", "value_nonrecursive_variant", "generic_over_scalar",
    "generic_over_payload", "transform", "branch", "bind", "match_owned_temporary",
    "match_borrowed_shared_sum", "loop_record_accumulator", "field_read", "record_rebuild_one_field",
    "local_closure", "escaping_closure", "sequence_build", "element_read", "sequential_traversal",
    "persistent_sequence_carrier_snapshot", "index_build", "index_lookup", "index_traversal",
    "persistent_map_carrier_snapshot" ]
}

fn roster_has_id(id: String) -> Bool {
  building_block_contracts() |> any(b => b.block == id)
}

fn id_occurrences(id: String) -> Int {
  count(building_block_contracts() |> filter(b => b.block == id))
}

fn missing_declared_count() -> Int {
  count(declared_block_ids() |> filter(id => !roster_has_id(id: id)))
}

fn duplicate_id_count() -> Int {
  count(declared_block_ids() |> filter(id => id_occurrences(id: id) > 1))
}

fn family_sum() -> Int {
  count(contracts_of_family(f: ValueShapes)) + count(contracts_of_family(f: ControlFlow)) + count(contracts_of_family(f: Accumulator)) + count(contracts_of_family(f: Carriers))
}

fn roster_against_declared_case() -> AllocationCase {
  AllocationCase {
    identity: "contract_roster_matches_the_declared_block_id_set",
    held: missing_declared_count() == 0 && duplicate_id_count() == 0 && count(declared_block_ids()) == count(building_block_contracts()),
    observed: concat(concat(concat(concat(count_text(label: "declared", n: count(declared_block_ids()))), concat(" roster=", count_text(label: "roster", n: count(building_block_contracts())))), concat(" missing=", count_text(label: "missing", n: missing_declared_count()))), concat(" duplicates=", count_text(label: "duplicates", n: duplicate_id_count())), concat(" family_sum_reading=", count_text(label: "family_sum", n: family_sum())))
  }
}

fn contract_audit_cases() -> List<AllocationCase> {
  let value_shapes = contracts_of_family(f: ValueShapes)
  [
    roster_against_declared_case(),
    AllocationCase { identity: "value_shape_family_roster_is_nonempty", held: count(value_shapes) > 0, observed: count_text(label: "value_shape_blocks", n: count(value_shapes)) },
    AllocationCase { identity: "every_value_shape_contract_is_carrier_applicable", held: count(filter(value_shapes, c => !case_in_applicable_roster(c: c.case_id))) == 0, observed: concat("judged_by=case_applicability first=", fold(value_shapes, init: "none", f: (acc, c) => if acc == "none" { contract_line(b: c) } else { acc })) },
    refusal_not_hit(name: "pattern_requires_consuming_contract", refusal: PatternRequiresConsumingContract),
    refusal_not_hit(name: "pattern_requires_borrowing_contract", refusal: PatternRequiresBorrowingContract),
    refusal_not_hit(name: "scalar_basis_requires_copy_scalar_carrier", refusal: ScalarBasisRequiresCopyScalarCarrier),
    refusal_not_hit(name: "sized_basis_requires_sized_carrier", refusal: SizedBasisRequiresSizedCarrier),
    AllocationCase { identity: "the_three_named_violating_forms_are_exercised", held: violating_form_exercised(slug: "owning_retain_added_to_observation") > 0 && violating_form_exercised(slug: "per_step_allocation") > 0 && violating_form_exercised(slug: "copy_of_unchanged_context") > 0, observed: concat(concat(concat(count_text(label: "retain", n: violating_form_exercised(slug: "owning_retain_added_to_observation"))), concat(" per_step=", count_text(label: "per_step", n: violating_form_exercised(slug: "per_step_allocation")))), concat(" unchanged_context=", count_text(label: "unchanged_context", n: violating_form_exercised(slug: "copy_of_unchanged_context")))) },
    AllocationCase { identity: "guard_fires_on_every_deliberate_mis_pairing", held: all_probes_refused(), observed: concat(count_text(label: "probes", n: count(mispaired_probes())), " ", fold(probe_lines(), init: "no_probes", f: (acc, line) => if acc == "no_probes" { line } else { acc })) }
  ]
}


// THE GREEN BATTERY. Everything in it is expected to hold; the red control rows travel with it so
// one log shows both sides of the same path.
// The carrier's per-contract membership reading, carried as a ROW: the report grammar
// (dag/gunbc/native_claim_program.dag native_claim_report_parse) admits one roster line and
// only `case` lines after it, so a line of free text refuses the whole report and every row in
// it -- including the counters -- reads unobserved. Held says the print covers every contract
// of the family, so a contract dropped from the membership print reddens this row.
fn roster_membership_case() -> AllocationCase {
  let printed = roster_membership_lines(f: ValueShapes)
  let total = count(contracts_of_family(f: ValueShapes))
  AllocationCase {
    identity: "carrier_roster_membership_printed_for_every_contract",
    held: count(printed) == total && total > 0,
    observed: concat(concat("printed=", count_text(label: "printed", n: count(printed))), " ", printed |> join(separator: "; "))
  }
}

fn native_claim_report() -> NativeClaimReport uses counter: AllocationCounter {
  let cases = concat(concat(concat(value_shape_cases(), contract_audit_cases()), red_control_cases()), value_shapes_discrimination_cases(), [roster_membership_case()])
  let failed = cases |> filter(c => !c.held) |> map(c => c.identity)
  let terminal = if (failed |> count) == 0 { NativeClaimHeld } else { NativeClaimNotHeld { reason: concat("not held: ", failed |> join(separator: ",")) } }
  let roster = concat("roster ", cases |> map(c => c.identity) |> join(separator: ","), "\n")
  NativeClaimReport { stdout: concat(roster, cases |> map(c => case_line(c: c)) |> join(separator: "")), terminal: terminal }
}

// THE RED ENTRY, deliberately red. The same observations, the same path, judged the opposite way, at
// the same sha. Its failure text is the text the green entry prints for the same rows.
fn red_control_cases() -> List<AllocationCase> uses counter: AllocationCounter {
  let src = spec_build(n: specimen_cardinality)
  let scalar_read = bb_window(subject: ScalarRead, src: src)
  let scalar_retain = bb_window(subject: ScalarRetainAddedToObservation, src: src)
  let field_read = bb_window(subject: RecordFieldRead, src: src)
  let rebuilt = bb_window(subject: RecordRebuiltToReadOneField, src: src)
  let variant_once = bb_window(subject: VariantConsumedOnce, src: src)
  let variant_copied = bb_window(subject: VariantPayloadCopiedToMatch, src: src)
  let generic_selected = bb_window(subject: GenericPayloadSelected, src: src)
  let generic_copied = bb_window(subject: GenericPayloadCopiedAtBoundary, src: src)
  [
    violation_contract_holds_case(block_id: "value_scalar", viol: scalar_retain, contract_arm: scalar_read),
    violation_contract_holds_case(block_id: "value_record", viol: rebuilt, contract_arm: field_read),
    violation_contract_holds_case(block_id: "value_nonrecursive_variant", viol: variant_copied, contract_arm: variant_once),
    violation_contract_holds_case(block_id: "generic_instance_over_nontrivial_payload", viol: generic_copied, contract_arm: generic_selected)
  ]
}

fn violation_contract_holds_when_violated() -> NativeClaimReport uses counter: AllocationCounter {
  let cases = red_control_cases()
  let failed = cases |> filter(c => !c.held) |> map(c => c.identity)
  let terminal = if (failed |> count) == 0 { NativeClaimHeld } else { NativeClaimNotHeld { reason: concat("not held: ", failed |> join(separator: ",")) } }
  let roster = concat("roster ", cases |> map(c => c.identity) |> join(separator: ","), "\n")
  NativeClaimReport { stdout: concat(roster, cases |> map(c => case_line(c: c)) |> join(separator: "")), terminal: terminal }
}

// THE DISCRIMINATOR for the applicability repair. `fn contract_is_applicable` replaced a battery comparing
// that judgement's own rendering to a literal of its own, which could never be true -- so a leg whose only
// source was that comparison was red by construction, not by measurement. This leg must be seen to refuse:
// the carrier refuses every planted mis-pairing, and a judgement that stopped asking the carrier would
// accept them and go red here, by name, in the same run as the rows it accepted. What each half means is
// decided once, in `fn applicability_discriminates` in gunbc.emit_building_block_contracts; nothing here
// judges, it only names the leg and prints the counts that were compared.
fn value_shapes_discrimination_cases() -> List<AllocationCase> {
  [AllocationCase {
    identity: "value_shapes_applicability_judgement_discriminates",
    held: applicability_discriminates(f: ValueShapes),
    observed: value_shapes_discrimination_line()
  }]
}

fn value_shapes_discrimination_line() -> String {
  let parts = [concat("family=", "value_shapes"),
               count_text(label: "family_rows", n: count(contracts_of_family(f: ValueShapes))),
               count_text(label: "rows_refused_by_carrier", n: applicability_refused_rows(f: ValueShapes)),
               count_text(label: "planted_mis_pairings_accepted", n: applicability_accepted_probes())]
  parts |> join(separator: " ")
}
