module gunbc.instruments.emit_value_shape_observation

import std.realization_measurement { AllocationCounter }
import std.compiler_entry { CompilerEntryDriver, NativeClaimDriver, NativeClaimReport }
import gunbc.emit_copy_qualification { PatternRequiresConsumingContract, PatternRequiresBorrowingContract, ScalarBasisRequiresCopyScalarCarrier, SizedBasisRequiresSizedCarrier }
import gunbc.emit_building_block_contracts { BuildingBlockFamily, ValueShapes }
import gunbc.instruments.allocation_battery { battery_report, audit_rows, refusal_not_hit_row, roster_membership_row, discrimination_row, execution_row, execution_mechanism_refuses_unproven_claims, ExecutionEvidence }
import gunbc.instruments.emit_value_shape_subjects { bb_measurement_rows }

// THE GREEN ENTRY of the value-shape family: a Value in its three named shapes and the generic instance
// over a scalar and over a nontrivial payload. Every row here is expected to hold, so its exit code means
// something; the red controls are their own target,
// #gunbc.instrument_targets::emit_value_shape_violation_label, because an entry carrying rows designed to
// fail can only exit non-zero and an exit that cannot vary measures nothing.
//
// Bodies and windows: #gunbc.instruments.emit_value_shape_subjects::bb_measurement_rows. Row shapes,
// calibration, audit and report grammar: #gunbc.instruments.allocation_battery::battery_report. The
// population judgements are the carrier's own, reached through
// #gunbc.emit_building_block_contracts::contract_verdict -- this battery never judges applicability
// itself, and the discrimination row below is what refuses if it ever stops asking.

data compiler_pipeline_entry: CompilerEntryDriver = NativeClaimDriver

// THE V2 OUTCOME OF THIS FAMILY, stated rather than omitted: nobody has asked the emitted-compiler door
// to emit this subject, so the result reads unqualified and names the refusal the door records today.
fn v2_subject_claim() -> String {
  "gunbc test //gunbc/instruments:v2-native-cli over subject dag/gunbc/instruments/emit_value_shape_subjects.dag"
}

fn v2_blocker() -> String {
  "v2 door has never been asked to emit this subject; the refusals it records for a closure are translate_rejected_grounding_not_derived and for a member body translate_arrow_body_not_a_type_expression, named in src/v1/stage0/src/cli_run/native_lane_runner.rs"
}

fn native_claim_report() -> NativeClaimReport uses counter: AllocationCounter {
  let measured = bb_measurement_rows()
  let audit = audit_rows(prefix: "value_shape", family: ValueShapes)
  let refusals = [
    refusal_not_hit_row(prefix: "value_shape", name: "pattern_requires_consuming_contract", refusal: PatternRequiresConsumingContract),
    refusal_not_hit_row(prefix: "value_shape", name: "pattern_requires_borrowing_contract", refusal: PatternRequiresBorrowingContract),
    refusal_not_hit_row(prefix: "value_shape", name: "scalar_basis_requires_copy_scalar_carrier", refusal: ScalarBasisRequiresCopyScalarCarrier),
    refusal_not_hit_row(prefix: "value_shape", name: "sized_basis_requires_sized_carrier", refusal: SizedBasisRequiresSizedCarrier)
  ]
  let qualified = [
    roster_membership_row(prefix: "value_shape", family: ValueShapes),
    discrimination_row(prefix: "value_shape", family: ValueShapes),
    execution_row(prefix: "value_shape", axis: "v2", block_id: "family", e: ExecutionEvidence { claim: v2_subject_claim(), executed: false, run_link: "", blocker: v2_blocker() }),
    execution_mechanism_refuses_unproven_claims(prefix: "value_shape")
  ]
  battery_report(concat(measured, concat(audit, concat(refusals, qualified))))
}
