// THE NAMESPACE-WAVE BINDING DIFF: `gunbc test //gunbc/instruments:namespace-wave-binding-diff`, run by
// a wave's author on the wave's own PR (no bystander is billed; the namespace-wave admission wall that
// gunbc.rung_drop.namespace_wave_admission_wall_removed records is NOT rebuilt -- this is a label, on no
// required path). It joins the occurrence-binding census of BASE to that of HEAD, occurrence by
// occurrence, and admits exactly one kind of change: an occurrence that was AMBIENT on base (a stopgap
// table answered it) and binds, on head, the declared HOME a row of gunbc.namespace_cut.ambient_name_home
// names for that spelling. Every other change REFUSES, naming the occurrence:
//
//   TargetChanged  the same occurrence binds something else on head -- a declared spelling that an
//                  added import now points at a different declaration (the namespace-wave wall's lost
//                  TargetChanged arm), or an ambient spelling that moved somewhere other than its home;
//   Appeared       head has an occurrence base did not;
//   Vanished       base had an occurrence head does not.
//
// THE KEY IS (module, authored spelling, ordinal) -- v2.compiler.occurrence_resolution_census says why the
// ordinal survives inserting an import and nothing else. ITS STABILITY IS ENFORCED HERE, NOT ASSUMED: an
// edit beyond import insertion that adds or removes an occurrence of a spelling shifts that spelling's
// ordinals, and every shifted occurrence surfaces as Appeared or Vanished (or as TargetChanged where two
// different targets now share an ordinal) and refuses. A wave PR therefore carries imports and the
// table deletion, and nothing that moves a body.
//
// A MODULE ONE SIDE DID NOT REACH is not a module with no bindings. Reached on one side and not the other
// is a binding-observation change in its own right and REFUSES, named (UnreachedOnOneSide). Unreached on
// BOTH sides is outside what either census observed: it is listed, never folded in as "no change", and
// a diff with any such module answers no observation (exit 2) over the population it could not see,
// even when every observed occurrence was admitted -- so that answer is read with its list, never as
// green. (The native route does not resolve the whole pool yet; that is NAMESPACE-XL's own subject.)
//
// THE POPULATION IS SCOPED (tidy-ant-251's ruling on PR #14112, 2026-10-16): each side is that side's
// ambient-name census, which reads the closures of its standing subjects and of every module the wave
// rewrites, one bounded run at a time (gunbc.instruments.ambient_name_census_reading). Only modules
// BOTH sides observed are compared. A rewritten module either side could not observe is listed BY NAME
// (unobserved_rewritten) and the answer is no observation (exit 2): a wave that edits outside what the
// census reads is not admitted until coverage exists. A module one side observed and the other side's
// population never held (neither observed nor listed unreached -- a new import pulled it into one
// closure) is listed as outside_other_population and is also exit 2, never compared as unchanged.

type BindingKey {
  module: String
  authored: String
  ordinal: String
}

type BindingTarget {
  source: String
  target: String
}

type BindingDelta
  = AmbientToDeclaredHome { key: BindingKey, home: String }
  | TargetChanged { key: BindingKey, before: BindingTarget, after: BindingTarget }
  | Appeared { key: BindingKey, after: BindingTarget }
  | Vanished { key: BindingKey, before: BindingTarget }

type BindingDiff {
  admitted: List<BindingDelta>
  refused: List<BindingDelta>
  unreached_one_side: List<String>
  unobserved_both_sides: List<String>
}

fn unreached_modules(stdout: String) -> List<String> {
  split(s: stdout, delimiter: "\n")
    |> filter(l => starts_with(s: l, prefix: "binding_unreached\t"))
    |> map(l => field_at(line: l, index: 1))
}

fn key_text(key: BindingKey) -> String {
  key.module + " " + key.authored + "#" + key.ordinal
}

fn line_key(line: String) -> BindingKey {
  BindingKey { module: field_at(line: line, index: 1), authored: field_at(line: line, index: 2), ordinal: field_at(line: line, index: 3) }
}

fn line_target(line: String) -> BindingTarget {
  BindingTarget { source: field_at(line: line, index: 4), target: field_at(line: line, index: 5) }
}

fn target_text(t: BindingTarget) -> String {
  t.source + " " + t.target
}

fn census_index_of(lines: List<String>) -> Map<String, String> {
  fold(lines, init: empty_map(), f: fn(m, l) { map_insert(m, key_text(key: line_key(line: l)), l) })
}

// AN AMBIENT OCCURRENCE THAT NOW BINDS ITS ROW'S HOME. The spelling's LEAF is the row's name (a
// qualified spelling `m.chars` is the same name reached by path), the base side was ambient, and the
// head side is a declared binding of exactly the home path.
fn row_admits(row: AmbientNameHome, key: BindingKey, before: BindingTarget, after: BindingTarget) -> Bool {
  let leaf = match last(split(s: key.authored, delimiter: ".")) {
    Present { value: l } => l
    Absent => key.authored
  }
  (leaf == (row.name as String))
    && starts_with(s: before.source, prefix: "ambient:")
    && (after.source == "declared")
    && (after.target == ambient_name_declaration(row: row))
}

fn classify_change(rows: List<AmbientNameHome>, key: BindingKey, before: BindingTarget, after: BindingTarget) -> BindingDelta {
  match first(rows |> filter(r => row_admits(row: r, key: key, before: before, after: after))) {
    Present { value: r } => AmbientToDeclaredHome { key: key, home: ambient_name_declaration(row: r) }
    Absent => TargetChanged { key: key, before: before, after: after }
  }
}

fn delta_admitted(d: BindingDelta) -> Bool {
  match d {
    AmbientToDeclaredHome { key: _, home: _ } => true
    TargetChanged { key: _, before: _, after: _ } => false
    Appeared { key: _, after: _ } => false
    Vanished { key: _, before: _ } => false
  }
}

fn delta_line(d: BindingDelta) -> String {
  match d {
    AmbientToDeclaredHome { key: k, home: h } => "admitted\tAmbientToDeclaredHome\t" + key_text(key: k) + "\t" + h
    TargetChanged { key: k, before: b, after: a } => "refused\tTargetChanged\t" + key_text(key: k) + "\t" + target_text(t: b) + " -> " + target_text(t: a)
    Appeared { key: k, after: a } => "refused\tAppeared\t" + key_text(key: k) + "\t" + target_text(t: a)
    Vanished { key: k, before: b } => "refused\tVanished\t" + key_text(key: k) + "\t" + target_text(t: b)
  }
}

// THE FOLD. Head's lines are walked once against base's index, then base's lines once against head's,
// so every occurrence on either side lands in exactly one delta or is unchanged.
fn observed_module_set(stdout: String) -> Map<String, Bool> {
  fold(split(s: stdout, delimiter: "\n") |> filter(l => starts_with(s: l, prefix: "binding_module\t")), init: empty_map(), f: fn(m, l) { map_insert(m, field_at(line: l, index: 1), true) })
}

fn module_in(set: Map<String, Bool>, module: String) -> Bool {
  match map_get(set, module) { Present { value: _ } => true  Absent => false }
}

fn rows_with_prefix(stdout: String, prefix: String) -> List<String> {
  split(s: stdout, delimiter: "\n") |> filter(l => starts_with(s: l, prefix: prefix))
}

fn distinct(xs: List<String>) -> List<String> {
  map_keys(fold(xs, init: empty_map(), f: fn(m, x) { map_insert(m, x, true) }))
}

// The rewritten modules either side's census could not observe, by name.
fn unobserved_rewritten_either(base_stdout: String, head_stdout: String) -> List<String> {
  distinct(xs: (rows_with_prefix(stdout: base_stdout, prefix: "unobserved_rewritten\t") + rows_with_prefix(stdout: head_stdout, prefix: "unobserved_rewritten\t"))
    |> map(l => field_at(line: l, index: 1)))
}

// Observed on one side, and on the other side neither observed nor listed unreached.
fn outside_other_population(base_stdout: String, head_stdout: String) -> List<String> {
  let base_obs = observed_module_set(stdout: base_stdout)
  let head_obs = observed_module_set(stdout: head_stdout)
  let base_unr = unreached_modules(stdout: base_stdout)
  let head_unr = unreached_modules(stdout: head_stdout)
  let only_base = map_keys(base_obs) |> filter(m => !module_in(set: head_obs, module: m) && count(head_unr |> filter(u => u == m)) == 0)
  let only_head = map_keys(head_obs) |> filter(m => !module_in(set: base_obs, module: m) && count(base_unr |> filter(u => u == m)) == 0)
  only_base + only_head
}

fn binding_diff(base_stdout: String, head_stdout: String, rows: List<AmbientNameHome>) -> BindingDiff {
  let base_unreached = unreached_modules(stdout: base_stdout)
  let head_unreached = unreached_modules(stdout: head_stdout)
  let base_obs = observed_module_set(stdout: base_stdout)
  let head_obs = observed_module_set(stdout: head_stdout)
  let both = base_unreached |> filter(m => count(head_unreached |> filter(h => h == m)) != 0)
  let one_side = (base_unreached |> filter(m => module_in(set: head_obs, module: m)))
    + (head_unreached |> filter(m => module_in(set: base_obs, module: m)))
  let compared = fn(l) { module_in(set: base_obs, module: field_at(line: l, index: 1)) && module_in(set: head_obs, module: field_at(line: l, index: 1)) }
  let observed_base = binding_lines(stdout: base_stdout) |> filter(l => compared(l))
  let observed_head = binding_lines(stdout: head_stdout) |> filter(l => compared(l))
  binding_diff_observed(base_lines: observed_base, head_lines: observed_head, rows: rows, one_side: one_side, both: both)
}

fn binding_diff_observed(base_lines: List<String>, head_lines: List<String>, rows: List<AmbientNameHome>, one_side: List<String>, both: List<String>) -> BindingDiff {
  let base = census_index_of(lines: base_lines)
  let head = census_index_of(lines: head_lines)
  let changed = head_lines |> fold(init: [], f: fn(acc, l) {
    let key = line_key(line: l)
    let after = line_target(line: l)
    match map_get(base, key_text(key: key)) {
      Absent => list_snoc_item(xs: acc, item: Appeared { key: key, after: after })
      Present { value: bl } =>
        let before = line_target(line: bl)
        if (before.source == after.source) && (before.target == after.target) {
          acc
        } else {
          list_snoc_item(xs: acc, item: classify_change(rows: rows, key: key, before: before, after: after))
        }
    }
  })
  let vanished = base_lines
    |> filter(l => match map_get(head, key_text(key: line_key(line: l))) { Present { value: _ } => false  Absent => true })
    |> map(l => Vanished { key: line_key(line: l), before: line_target(line: l) })
  let all = changed + vanished
  BindingDiff {
    admitted: all |> filter(d => delta_admitted(d: d)),
    refused: all |> filter(d => !delta_admitted(d: d)),
    unreached_one_side: one_side,
    unobserved_both_sides: both
  }
}

// ---------------------------------------------------------------------------------------------------
// THE CONTROLS. The RED is run on the REAL route: the host runs the native census-infer over two
// fixture roots that differ by ONE IMPORT EDIT -- `helper` imported from examples.a on base, from examples.b on head
// -- so an existing spelling re-binds a different declaration with no body edit; the diff must refuse it
// as TargetChanged naming `examples.uses helper#0`. The positive control is at the diff's own interface
// (supplied census lines, DESIGN section 3 "a witness discriminates at one interface"): an ambient
// `Int` that binds its row's home on head is admitted. Its inhabitance claim -- that the real producer
// emits an ambient kernel_type_spelling line of exactly this shape -- is the ambient-name-census
// fixture join (gunbc.instruments.ambient_name_census_reading), and the real route's last execution is
// the base-to-head diff itself.

type BindingDiffFixtureFile {
  path: String
  content: String
}

fn rebind_fixture_shared() -> List<BindingDiffFixtureFile> {
  [
    BindingDiffFixtureFile { path: "examples/a.dag", content: "module examples.a\n\nfn helper() -> Int {\n  1\n}\n" },
    BindingDiffFixtureFile { path: "examples/b.dag", content: "module examples.b\n\nfn helper() -> Int {\n  2\n}\n" }
  ]
}

fn binding_diff_rebind_base_files() -> List<BindingDiffFixtureFile> {
  rebind_fixture_shared() + [
    BindingDiffFixtureFile { path: "examples/uses.dag", content: "module examples.uses\n\nimport examples.a { helper }\n\nfn call() -> Int {\n  helper()\n}\n" }
  ]
}

fn binding_diff_rebind_head_files() -> List<BindingDiffFixtureFile> {
  rebind_fixture_shared() + [
    BindingDiffFixtureFile { path: "examples/uses.dag", content: "module examples.uses\n\nimport examples.b { helper }\n\nfn call() -> Int {\n  helper()\n}\n" }
  ]
}

fn rebind_red_failure(base_stdout: String, head_stdout: String) -> Optional<String> {
  let diff = binding_diff(base_stdout: base_stdout, head_stdout: head_stdout, rows: [])
  let refused = diff.refused
  if count(diff.unreached_one_side + diff.unobserved_both_sides) != 0 {
    optional_present(value: "the re-bind fixture was not observed: " + ((diff.unreached_one_side + diff.unobserved_both_sides) |> join(separator: ", ")))
  } else {
      if count(refused |> filter(d => delta_line(d: d) == "refused\tTargetChanged\texamples.uses helper#0\tdeclared examples.a.helper -> declared examples.b.helper")) == 1 {
        if count(refused) == 1 {
          optional_absent()
        } else {
          optional_present(value: "the re-bind fixture refused more than the one re-binding: " + (refused |> map(d => delta_line(d: d)) |> join(separator: "; ")))
        }
      } else {
        optional_present(value: "the re-bind fixture did not refuse examples.uses helper#0 as TargetChanged examples.a.helper -> examples.b.helper; refused: " + (refused |> map(d => delta_line(d: d)) |> join(separator: "; ")))
      }
  }
}

fn home_control_rows() -> List<AmbientNameHome> {
  [AmbientNameHome { name: "Int" as NonEmptyStr, home: "examples.home" as NonEmptyStr, table: KernelTypeSpellingTable, origin: ExistingDeclaration, retired_contract: optional_absent(), kit_probe: KitCallProbe { call: AmbientNameKitCall { params: [], result: kit_int() } } }]
}

fn home_control_failure() -> Optional<String> {
  let observed = "binding_module\texamples.uses\t1\t0\t0\t0\n"
  let before = "binding\texamples.uses\tInt\t0\tambient:kernel_type_spelling\tkernel:dag_binding_type_int\n" + observed
  let moved = "binding\texamples.uses\tInt\t0\tdeclared\texamples.home.Int\n" + observed
  let elsewhere = "binding\texamples.uses\tInt\t0\tdeclared\texamples.other.Int\n" + observed
  let home = binding_diff(base_stdout: before, head_stdout: moved, rows: home_control_rows())
  let not_home = binding_diff(base_stdout: before, head_stdout: elsewhere, rows: home_control_rows())
  if (count(home.admitted) != 1) || (count(home.refused) != 0) {
    optional_present(value: "an ambient Int moving to its row's home was not admitted alone")
  } else if (count(not_home.admitted) != 0) || (count(not_home.refused) != 1) {
    optional_present(value: "an ambient Int moving somewhere other than its home was not refused")
  } else {
    optional_absent()
  }
}

// THE FORMATTER-TO-READER CONTROL: a target-changing pair sent through the census's own formatter
// (census_observation_text) and then this diff must refuse. Without it the label could compare zero
// rows -- the formatter once dropped the binding_module lines this reader observes modules through --
// and a re-binding would reach success (side chat on PR #14112).
fn formatter_control_failure() -> Optional<String> {
  let base_tree = "binding_module\texamples.uses\t1\t0\t0\t0\nbinding\texamples.uses\thelper\t0\tdeclared\texamples.a.helper\n"
  let head_tree = "binding_module\texamples.uses\t1\t0\t0\t0\nbinding\texamples.uses\thelper\t0\tdeclared\texamples.b.helper\n"
  let diff = binding_diff(base_stdout: census_observation_text(tree_stdout: base_tree), head_stdout: census_observation_text(tree_stdout: head_tree), rows: [])
  if (count(diff.refused) != 1) || (count(diff.admitted) != 0) {
    optional_present(value: "a target-changing pair sent through the census formatter was not refused by the diff (the formatted output lost what the reader observes modules by)")
  } else {
    optional_absent()
  }
}

// ---------------------------------------------------------------------------------------------------
// THE WAVE-1 JOIN CONTROLS ON THE REAL CENSUS ROUTE. Four roots the host censuses with the native census-infer: a
// BASE module that still refuses resolve (`semver_version_parse` is declared nowhere) and uses `chars(s: ...)` unimported at
// four sites -- the shape of a real wave-1 module -- and three HEADS. The admit HEAD IS THE GENERATOR'S OWN RECOMPUTATION from the
// base text (wave_derived_head: roster_sweep_text_scoped + roster_applied to a fixed point), never typed by hand, so the byte-equality
// proof (gunbc.instruments.namespace_wave_occurrence_join edit_proof) holds for it and for nothing else:
//   admit       the recomputation: all four sites must join to std.host_text.chars and the verdict is success;
//   moved       a blank line added between the first two call lines: still four sites on each side, EQUAL COUNT, but the
//               head is not the generator's output, so the verdict is 1 (EditsNotGenerated);
//   wrong home  the import points at examples.other.chars: four sites resolve to the wrong declaration, not the generator's
//               output either: verdict 1.
// The same-line / equal-count wrong-CORRESPONDENCE controls (a relocated site, a wrong home on one of two sites of one line) are at the
// join's own interface in occurrence_join_controls_failure, where a head TEXT that is the recomputation is paired with census rows
// that disagree with it.

fn wave_join_shared() -> List<BindingDiffFixtureFile> {
  [
    BindingDiffFixtureFile { path: "std/host_text.dag", content: "module std.host_text\n\nfn chars(text: String) -> Int {\n  1\n}\n" },
    BindingDiffFixtureFile { path: "examples/anchor.dag", content: "module examples.anchor\n\nfn anchor() -> Int {\n  0\n}\n" },
    BindingDiffFixtureFile { path: "examples/other.dag", content: "module examples.other\n\nfn chars(text: String) -> Int {\n  2\n}\n" }
  ]
}

fn wave_base_text() -> String {
  "module examples.wave\n\nimport examples.anchor { anchor }\n"
    + "\nfn first() -> Int {\n  semver_version_parse(cps: chars(s: \"1.0.0\" as String))\n}\n"
    + "\nfn second() -> Int {\n  semver_version_parse(cps: chars(s: \"1.0.0-alpha\" as String))\n}\n"
    + "\nfn same_line() -> Int {\n  pair(a: chars(s: \"a\"), b: chars(s: \"b\"))\n}\n"
}

fn wave_scopes() -> List<RosterHomeScope> {
  [OneHome { home: qualified_name_from_dotted_string(dotted: "std.host_text"), rows: OnlyCall { call: "chars" } }]
}

fn wave_derived_head_with(prepared: PreparedGrammar, lex: PreparedLexRules, closures: List<RosterHomeClosure>) -> String {
  recompute_wave_text(path: "examples/wave.dag", base_text: wave_base_text(), prepared: prepared, lex: lex, scopes: wave_scopes(), closures: closures).text
}

fn wave_derived_head(closures: List<RosterHomeClosure>) -> String {
  match dag_prepared_grammar() {
    Rejected { diagnostics: _ } => ""
    Accepted { value: prepared, diagnostics: _ } => wave_derived_head_with(prepared: prepared, lex: dag_prepared_lex(), closures: closures)
  }
}

fn wave_moved_head(closures: List<RosterHomeClosure>) -> String {
  replace(wave_derived_head(closures: closures), "\nfn second()", "\n\nfn second()")
}

fn wave_wrong_home_head(closures: List<RosterHomeClosure>) -> String {
  replace(wave_derived_head(closures: closures), "import std.host_text { chars }", "import examples.other { chars }")
}

// THE HOST CALLS THIS ONCE PER RUN and threads the returned value to every wave entry point (the three head-file
// providers and the standing), so the acquisition door opens once instead of once per proof. Returns the filled
// home closures of every row's proof scope (rows_proof_scopes over ambient_name_homes(), which covers wave_scopes()'s
// chars row too); identical to every mint the carried value replaces.
fn wave_run_closures() -> List<RosterHomeClosure> {
  wave_roster_closures(scopes: rows_proof_scopes(rows: ambient_name_homes()))
}

// THE CARRY CONTROL: one carried closure serves TWO recomputations, and both must agree — the recompute no longer
// opens the acquisition door at all (no mint call site remains in it; the single mint is wave_run_closures, called
// once by the host), so a drift in the carried value shows up here as disagreement or an empty closure instead of
// quietly changing the standing. The fleet half of the acceptance (the substrate read once per run, not once per
// proof) is measured by the Filesystem.Read count in the instrument log.
fn wave_carry_control_failure(prepared: PreparedGrammar, lex: PreparedLexRules, closures: List<RosterHomeClosure>) -> Optional<String> {
  let first = recompute_wave_text(path: "examples/wave.dag", base_text: wave_base_text(), prepared: prepared, lex: lex, scopes: wave_scopes(), closures: closures)
  let second = recompute_wave_text(path: "examples/wave.dag", base_text: wave_base_text(), prepared: prepared, lex: lex, scopes: wave_scopes(), closures: closures)
  if count(closures) == 0 {
    optional_present(value: "the carried home closure is empty; every proof would resolve against nothing")
  } else if first.text != second.text || count(first.rounds) != count(second.rounds) {
    optional_present(value: "two recomputations on the ONE carried home closure disagree")
  } else {
    optional_absent()
  }
}

fn wave_files(head: String) -> List<BindingDiffFixtureFile> {
  wave_join_shared() + [BindingDiffFixtureFile { path: "examples/wave.dag", content: head }]
}

fn binding_diff_wave_base_files() -> List<BindingDiffFixtureFile> {
  wave_files(head: wave_base_text())
}

fn binding_diff_wave_head_files(closures: List<RosterHomeClosure>) -> List<BindingDiffFixtureFile> {
  wave_files(head: wave_derived_head(closures: closures))
}

fn binding_diff_wave_moved_head_files(closures: List<RosterHomeClosure>) -> List<BindingDiffFixtureFile> {
  wave_files(head: wave_moved_head(closures: closures))
}

fn binding_diff_wave_wrong_home_head_files(closures: List<RosterHomeClosure>) -> List<BindingDiffFixtureFile> {
  wave_files(head: wave_wrong_home_head(closures: closures))
}

fn verdict_code(r: CliWireResponse) -> Int {
  match r {
    CliWirePrintable { bytes: _, exit: e } =>
      match e {
        ExitSuccess => 0
        ExitFailure { code: c, reason: _ } => c
      }
    CliWireUnprintable { cause: _ } => 0 - 1
  }
}

// What a verdict actually printed, so a control can check a ROW rather than only an exit code. An unprintable
// verdict prints nothing, which no row-matching control may read as a row that happens to be absent.
fn verdict_bytes(r: CliWireResponse) -> String {
  match r {
    CliWirePrintable { bytes: b, exit: _ } => b
    CliWireUnprintable { cause: _ } => ""
  }
}

// The texts a verdict joins by: supplied by the controls, read from the two roots by the standing.
type WaveProof {
  evidence: Map<String, ModuleEvidence>
  prepared: PreparedGrammar
  lex: PreparedLexRules
  scopes: List<RosterHomeScope>
  // THE RUN'S ONE FILLED HOME CLOSURE, computed a single time and carried here so every proof-taking
  // join/verdict reuses it instead of re-opening the acquisition door (v2.compiler.module_acquisition
  // re-mints its empty memos per start; the fleet probe measured 21 starts x 10 substrate files per run).
  closures: List<RosterHomeClosure>
}

fn wave_proof(prepared: PreparedGrammar, lex: PreparedLexRules, head: String, closures: List<RosterHomeClosure>) -> WaveProof {
  WaveProof { evidence: map_insert(empty_map(), "examples.wave", ModuleEvidence { module: "examples.wave", base_text: wave_base_text(), head_text: head, readable: true }), prepared: prepared, lex: lex, scopes: wave_scopes(), closures: closures }
}

// What the ambient census prints beside the infer rows for a rewritten module refused at resolve, and the status 2 it answers.
// Fields 3 and 4 are the FIRST REFUSAL (the resolve reason's identity, and the site with its located position) as
// gunbc.instruments.ambient_name_census_reading prints them from the walk's own binding_unreached row; a wave receipt must
// carry them so a refusal is named by cause rather than only by the generic resolve stage. A refusal the walk located
// nowhere reads "-" " "- the absence is printed, not fabricated.
fn wave_refused_row() -> String {
  "refused_rewritten\texamples.wave\tresolve\tresolve_reason_unbound_symbol\tunbound_name=not_declared_anywhere line 12:3\n"
}

// A SUCCESSFUL JOIN CLEARS ITS OWN MODULE'S INCOMPLETENESS and nothing else's: the admitted wave answers 0 despite the
// census status 2 its refused module caused, but the same head with an unrelated unobserved_subject row stays 2.
fn wave_other_incompleteness_control_failure(base: String, admit: String, proof: WaveProof) -> Optional<String> {
  let got = verdict_code(r: binding_diff_verdict(base_stdout: base + wave_refused_row(), head_stdout: admit + wave_refused_row() + "unobserved_subject\tsome subject\n", base_status: 2, head_status: 2, proof: proof))
  if got == 2 { optional_absent() } else { optional_present(value: "a joined wave with another incomplete subject answered " + to_string(got) + ", not 2") }
}

// THE CAUSE TRAVELS BY IDENTITY. A wave receipt carries the refused module's FIRST REFUSAL, not only the generic
// resolve stage: the refused_rewritten row the reader prints is forwarded verbatim, so its cause symbol and located
// site must still be there, at the fields the reader prints them in. A refusal the walk located nowhere reads "-":
// the absence is printed, never a plausible cause.
fn refused_cause_identity_control_failure(base: String, admit: String, proof: WaveProof) -> Optional<String> {
  let got = split(s: verdict_bytes(r: binding_diff_verdict(base_stdout: base + wave_refused_row(), head_stdout: admit + wave_refused_row(), base_status: 2, head_status: 2, proof: proof)), delimiter: "\n")
    |> filter(l => starts_with(s: l, prefix: "head_incomplete\trefused_rewritten\t"))
    |> join(separator: "\n")
  let want = "head_incomplete\trefused_rewritten\texamples.wave\tresolve\tresolve_reason_unbound_symbol\tunbound_name=not_declared_anywhere line 12:3"
  if got == want { optional_absent() } else { optional_present(value: "a refused module's wave receipt does not name its first refusal by identity; want " + want + ", got " + got) }
}

fn wave_join_case(name: String, base: String, head: String, want: Int, proof: WaveProof) -> String {
  let got = verdict_code(r: binding_diff_verdict(base_stdout: base + wave_refused_row(), head_stdout: head + wave_refused_row(), base_status: 2, head_status: 2, proof: proof))
  if got == want { "" } else { "wave-1 join " + name + ": verdict " + to_string(got) + ", want " + to_string(want) + "\n" }
}

// The route must actually have observed the fixture: four unbound sites on base, and the partial-module row the join requires.
fn wave_join_route_failure(base: String, admit: String, moved: String, wrong_home: String, prepared: PreparedGrammar, lex: PreparedLexRules, closures: List<RosterHomeClosure>) -> Optional<String> {
  let sites = count(rows_with_prefix(stdout: base, prefix: "binding_unbound\texamples.wave\tchars\t"))
  let report = (if sites == 4 { "" } else { "wave-1 join base fixture: " + to_string(sites) + " unbound chars sites, want 4 (the census route did not print the loci)\n" })
    + wave_join_case(name: "admit (positive control)", base: base, head: admit, want: 0, proof: wave_proof(prepared: prepared, lex: lex, head: wave_derived_head_with(prepared: prepared, lex: lex, closures: closures), closures: closures))
    + wave_join_case(name: "equal-count moved site (RED)", base: base, head: moved, want: 1, proof: wave_proof(prepared: prepared, lex: lex, head: wave_moved_head(closures: closures), closures: closures))
    + wave_join_case(name: "wrong home (RED)", base: base, head: wrong_home, want: 1, proof: wave_proof(prepared: prepared, lex: lex, head: wave_wrong_home_head(closures: closures), closures: closures))
  if report == "" { optional_absent() } else { optional_present(value: report) }
}

// UNOBSERVED IS 2, ON THE FULL VERDICT: a head that names a rewritten module its census could not read, over otherwise
// admitted rows, must not answer success or 1.
fn wave_unobserved_control_failure(prepared: PreparedGrammar, lex: PreparedLexRules, closures: List<RosterHomeClosure>) -> Optional<String> {
  let observed = "binding_module\texamples.uses\t1\t0\t0\t0\n"
  let base = observed + "binding\texamples.uses\tInt\t0\tdeclared\texamples.home.Int\n"
  let head = base + "unobserved_rewritten\texamples.wave\n"
  let got = verdict_code(r: binding_diff_verdict(base_stdout: base, head_stdout: head, base_status: 0, head_status: 0, proof: wave_proof(prepared: prepared, lex: lex, head: wave_derived_head_with(prepared: prepared, lex: lex, closures: closures), closures: closures)))
  if got == 2 { optional_absent() } else { optional_present(value: "an unobserved rewritten module answered " + to_string(got) + ", not 2") }
}

fn drop_prefixed(stdout: String, prefix: String) -> String {
  split(s: stdout, delimiter: "\n") |> filter(l => !starts_with(s: l, prefix: prefix)) |> join(separator: "\n")
}

fn with_unreadable_partial(stdout: String) -> String {
  split(s: stdout, delimiter: "\n")
    |> map(l => if starts_with(s: l, prefix: "binding_partial_module\t") { field_at(line: l, index: 0) + "\t" + field_at(line: l, index: 1) + "\t" + field_at(line: l, index: 2) + "\t" + field_at(line: l, index: 3) + "\t1" } else { l })
    |> join(separator: "\n")
}

// THE JOIN'S OWN OBSERVATION GUARDS, on the full verdict over the admitted wave: a base with no partial-module row (a census
// older than the partial rows), a head whose partial observation recorded an unreadable spelling, and an unreadable text
// each answer 2 -- never 1 (an invented refusal) and never 0.
fn unobserved_guards_control_failure(base: String, admit: String, prepared: PreparedGrammar, lex: PreparedLexRules, closures: List<RosterHomeClosure>) -> Optional<String> {
  let proof = wave_proof(prepared: prepared, lex: lex, head: wave_derived_head_with(prepared: prepared, lex: lex, closures: closures), closures: closures)
  let unreadable_text = WaveProof { evidence: map_insert(empty_map(), "examples.wave", ModuleEvidence { module: "examples.wave", base_text: "", head_text: "", readable: false }), prepared: prepared, lex: lex, scopes: wave_scopes(), closures: closures }
  let report = wave_guard_case(name: "base without a partial-module row", base: drop_prefixed(stdout: base, prefix: "binding_partial_module\t"), head: admit, proof: proof)
    + wave_guard_case(name: "head with an unreadable spelling", base: base, head: with_unreadable_partial(stdout: admit), proof: proof)
    + wave_guard_case(name: "unreadable base/head text", base: base, head: admit, proof: unreadable_text)
  if report == "" { optional_absent() } else { optional_present(value: report) }
}

fn wave_guard_case(name: String, base: String, head: String, proof: WaveProof) -> String {
  let got = verdict_code(r: binding_diff_verdict(base_stdout: base + wave_refused_row(), head_stdout: head + wave_refused_row(), base_status: 2, head_status: 2, proof: proof))
  if got == 2 { "" } else { "wave-1 guard " + name + ": verdict " + to_string(got) + ", want 2\n" }
}


// THE DECLARATION-ROW CONTROL: the census also prints `binding_declaration` rows (the declared callables a
// module holds, for gunbc.instruments.ambient_operation_disposition_reading). This reader joins occurrences, so a
// declaration row must neither reach the observation it forwards nor change the verdict: the same
// target-changing pair, with declaration rows added to both sides, must refuse exactly as without them.
fn declaration_row_control_failure() -> Optional<String> {
  let decl = "binding_declaration\texamples.uses\thelper\tfn\t() -> Int\n"
  let base_tree = "binding_module\texamples.uses\t1\t0\t0\t0\nbinding\texamples.uses\thelper\t0\tdeclared\texamples.a.helper\n" + decl
  let head_tree = "binding_module\texamples.uses\t1\t0\t0\t0\nbinding\texamples.uses\thelper\t0\tdeclared\texamples.b.helper\n" + decl
  let forwarded = census_observation_text(tree_stdout: base_tree)
  let diff = binding_diff(base_stdout: forwarded, head_stdout: census_observation_text(tree_stdout: head_tree), rows: [])
  if count(split(s: forwarded, delimiter: "binding_declaration")) != 1 {
    optional_present(value: "a binding_declaration row reached the observation the diff reads")
  } else if (count(diff.refused) != 1) || (count(diff.admitted) != 0) {
    optional_present(value: "adding binding_declaration rows changed the diff's verdict on a target-changing pair")
  } else {
    optional_absent()
  }
}

// THE VERDICT. An incomplete side never yields success: a census that answered 2 (a rewritten module
// refused or unread, an incomplete subject run, an unreadable spelling) keeps that standing unless a
// stronger refusal (a re-binding, exit 1) applies. Each side's own 2-rows are carried into the output.
fn binding_diff_exit(refused: Int, unobserved: Int, outside: Int, unobserved_both: Int, base_status: Int, head_status: Int) -> ProcessExit {
  if refused != 0 {
    ExitFailure { code: 1, reason: to_string(refused) + " occurrence(s) or module(s) re-bound outside the wave's declared homes (refused rows above)" }
  } else if unobserved != 0 {
    ExitFailure { code: 2, reason: to_string(unobserved) + " rewritten module(s) the census did not observe (unobserved_rewritten rows above): not admitted until coverage exists" }
  } else if outside != 0 {
    ExitFailure { code: 2, reason: to_string(outside) + " module(s) observed on one side only (outside_other_population rows above): not compared" }
  } else if unobserved_both != 0 {
    ExitFailure { code: 2, reason: "no refusal among the observed modules, but " + to_string(unobserved_both) + " module(s) neither census reached or the join could not observe (unobserved rows above)" }
  } else if base_status == 2 {
    ExitFailure { code: 2, reason: "base: the base census answered 2 (base_incomplete rows above), so the diff is incomplete" }
  } else if head_status == 2 {
    ExitFailure { code: 2, reason: "head: the head census answered 2 (head_incomplete rows above), so the diff is incomplete" }
  } else {
    ExitSuccess
  }
}

// THE INCOMPLETE-SIDE CONTROL, the side chat's counterexample: a module absent on base and
// refused_rewritten on head leaves no row to compare and no refusal, and must still answer 2.
fn incomplete_side_control_failure() -> Optional<String> {
  match binding_diff_exit(refused: 0, unobserved: 0, outside: 0, unobserved_both: 0, base_status: 0, head_status: 2) {
    ExitFailure { code: c, reason: _ } =>
      if c == 2 { optional_absent() } else { optional_present(value: "an incomplete head side answered " + to_string(c) + ", not 2") }
    ExitSuccess => optional_present(value: "an incomplete head side (refused_rewritten, nothing else) yielded success")
  }
}

// THE SHARD MERGE'S CONTROLS, run over synthetic receipts: the full set joins (the positive control), and each way the
// identity join must refuse does: a dropped shard, a module proved twice (carried by a shard that does not own it), a
// module in the wrong shard, a receipt from another head, base, K or rewritten set, a stray file in the directory, a shared
// dependency whose rows the shards disagree on, and a module outside the rewritten set whose rows differ. The base
// receipt is checked against another base, head and rewritten set the same way.
fn control_result(module: String) -> ModuleResult {
  ModuleResult { module: module, lines: ["admitted\tUnboundToDeclaredHome\t1:0\tstd.host_text.chars"], refused: 0, conflicting: false, clean: true }
}

fn control_row(module: String, site: String) -> String {
  "binding\t" + module + "\t" + site + "\tUnboundToDeclaredHome"
}

fn control_key() -> BaseKey {
  BaseKey { base_rev: "b1", instr_rev: "i1" }
}

fn control_base_rows() -> String {
  "binding\ta.m1\t1:0\tx\nbinding\ta.m2\t1:0\tx\nbinding\ta.m3\t1:0\tx\n"
}

fn control_base_text() -> String {
  base_receipt_text(key: control_key(), status: 0, stdout: control_base_rows())
}

fn control_run(head_sha: String, base_id: String, wave: String, rewritten: String, k: Int) -> ShardRun {
  ShardRun { head_sha: head_sha, base_id: base_id, wave: wave, rewritten: rewritten, count: k }
}

fn control_receipt(run: ShardRun, index: Int, modules: List<String>, shared: String) -> String {
  shard_receipt_text(run: run, index: index, head_status: 0,
    head_stdout: ((modules |> map(m => control_row(module: m, site: "1:0"))) + ["binding\ta.dep\t" + shared + "\tUnboundToDeclaredHome"]) |> join(separator: "\n"),
    results: modules |> map(m => control_result(module: m)))
}

fn control_rewritten() -> List<String> {
  ["a.m1", "a.m2", "a.m3"]
}

fn control_listing() -> List<String> {
  [base_receipt_file(key: control_key()), shard_receipt_file(wave: "w", index: 0, shards: 2), shard_receipt_file(wave: "w", index: 1, shards: 2)]
}

fn control_base_run() -> ShardRun {
  control_run(head_sha: "h1", base_id: base_receipt_id(text: control_base_text()), wave: "w", rewritten: evidence_identity(evidence: control_rewritten()), k: 2)
}

fn merge_case(name: String, want_merged: Bool, evidence: List<String>, texts: List<String>, listing: List<String>) -> Optional<String> {
  let run = control_base_run()
  let outcome = match merge_head_rows(run: run, base_name: base_receipt_file(key: control_key()), texts: texts, listing: listing) {
    HeadMergeRefused { why: why } => MergeRefused { why: why }
    HeadMerged { head_stdout: _, head_status: _ } => merge_results(run: run, rewritten: control_rewritten(), evidence: evidence, texts: texts)
  }
  match outcome {
    Merged { results: rs } =>
      if want_merged && (count(rs) == 3) { optional_absent() } else { optional_present(value: name + ": merged " + to_string(count(rs)) + " module(s) where it must " + (if want_merged { "merge 3" } else { "refuse" })) }
    MergeRefused { why: why } =>
      if want_merged { optional_present(value: name + ": refused a correct set of receipts: " + why) } else { optional_absent() }
  }
}

fn base_case(name: String, want_held: Bool, key: BaseKey, text: String) -> Optional<String> {
  match base_receipt_refusal(key: key, text: text) {
    Absent => if want_held { optional_absent() } else { optional_present(value: name + ": a base receipt for another key was accepted") }
    Present { value: why } => if want_held { optional_present(value: name + ": a correct base receipt was refused: " + why) } else { optional_absent() }
  }
}

fn selection_case(name: String, want_held: Bool, listing: List<String>) -> Optional<String> {
  match base_selection_refusal(key: control_key(), listing: listing) {
    Absent => if want_held { optional_absent() } else { optional_present(value: name + ": the base file was selected from a directory that must refuse") }
    Present { value: why } => if want_held { optional_present(value: name + ": a correct directory was refused: " + why) } else { optional_absent() }
  }
}

fn coverage_case(name: String, want_uncovered: List<String>, owned: List<String>) -> Optional<String> {
  let got = uncovered_by_base(owned: owned, base_rows: control_base_rows())
  if (count(got) == count(want_uncovered)) && (count(got |> filter(m => count(want_uncovered |> filter(w => w == m)) == 0)) == 0) { optional_absent() } else { optional_present(value: name + ": base coverage named [" + join(got, separator: ",") + "], expected [" + join(want_uncovered, separator: ",") + "]") }
}

fn verdict_case(name: String, want_token: Bool, head_sha: String, text: String) -> Optional<String> {
  match verdict_admission(head_sha: head_sha, text: text) {
    Present { value: _ } => if want_token { optional_absent() } else { optional_present(value: name + ": a token was read from a verdict that is no token") }
    Absent => if want_token { optional_present(value: name + ": a complete verdict yielded no token") } else { optional_absent() }
  }
}

fn merged_rows_control_failure() -> Optional<String> {
  let run = control_base_run()
  let texts = [control_receipt(run: run, index: 0, modules: ["a.m1", "a.m3"], shared: "9:9"), control_receipt(run: run, index: 1, modules: ["a.m2"], shared: "9:9")]
  match merge_head_rows(run: run, base_name: base_receipt_file(key: control_key()), texts: texts, listing: control_listing()) {
    HeadMergeRefused { why: why } => optional_present(value: "merged-rows control: refused a correct set: " + why)
    HeadMerged { head_stdout: h, head_status: st } =>
      if (count(split(s: h, delimiter: "\n") |> filter(l => starts_with(s: l, prefix: "binding\t"))) != 4) || (st != 0) {
        optional_present(value: "merged-rows control: the whole-wave rows are not each module once (a shared dependency counted twice or dropped)")
      } else {
        optional_absent()
      }
  }
}

fn control_other(head_sha: String, base_id: String, wave: String, rewritten: String, k: Int) -> String {
  control_receipt(run: control_run(head_sha: head_sha, base_id: base_id, wave: wave, rewritten: rewritten, k: k), index: 1, modules: ["a.m2"], shared: "9:9")
}

fn shard_merge_control_failure() -> Optional<String> {
  let run = control_base_run()
  let ev = run.rewritten
  let r0 = control_receipt(run: run, index: 0, modules: ["a.m1", "a.m3"], shared: "9:9")
  let r1 = control_receipt(run: run, index: 1, modules: ["a.m2"], shared: "9:9")
  let listing = control_listing()
  let every = control_rewritten()
  let older_base = base_receipt_file(key: BaseKey { base_rev: "b0", instr_rev: "i1" })
  let complete = verdict_text(run: run, texts: [r0, r1], exit_code: 0)
  first_control_failure(controls: [
    merge_case(name: "shard merge positive control (every shard, each module once)", want_merged: true, evidence: every, texts: [r0, r1], listing: listing),
    merge_case(name: "shard merge RED: a missing shard", want_merged: false, evidence: every, texts: [r0, ""], listing: [base_receipt_file(key: control_key()), shard_receipt_file(wave: "w", index: 0, shards: 2)]),
    merge_case(name: "shard merge RED: a module proved twice", want_merged: false, evidence: every, texts: [r0, control_receipt(run: run, index: 1, modules: ["a.m2", "a.m3"], shared: "9:9")], listing: listing),
    merge_case(name: "shard merge RED: a module in the wrong shard (same count)", want_merged: false, evidence: every, texts: [control_receipt(run: run, index: 0, modules: ["a.m1", "a.m2"], shared: "9:9"), control_receipt(run: run, index: 1, modules: ["a.m3"], shared: "9:9")], listing: listing),
    merge_case(name: "shard merge RED: a duplicate shard (shard 0 again in slot 1)", want_merged: false, evidence: every, texts: [r0, control_receipt(run: run, index: 0, modules: ["a.m1", "a.m3"], shared: "9:9")], listing: listing),
    merge_case(name: "shard merge RED: a receipt listed twice in the directory", want_merged: false, evidence: every, texts: [r0, r1], listing: listing + [shard_receipt_file(wave: "w", index: 0, shards: 2)]),
    merge_case(name: "shard merge RED: a shard that consumed another base receipt", want_merged: false, evidence: every, texts: [r0, control_other(head_sha: "h1", base_id: "not-the-base", wave: "w", rewritten: ev, k: 2)], listing: listing),
    merge_case(name: "shard merge RED: one receipt from another head", want_merged: false, evidence: every, texts: [r0, control_other(head_sha: "h0", base_id: run.base_id, wave: "w", rewritten: ev, k: 2)], listing: listing),
    merge_case(name: "shard merge RED: one receipt from another wave", want_merged: false, evidence: every, texts: [r0, control_other(head_sha: "h1", base_id: run.base_id, wave: "v", rewritten: ev, k: 2)], listing: listing),
    merge_case(name: "shard merge RED: a receipt proved with another K", want_merged: false, evidence: every, texts: [r0, control_other(head_sha: "h1", base_id: run.base_id, wave: "w", rewritten: ev, k: 3)], listing: listing),
    merge_case(name: "shard merge RED: a receipt proved against another rewritten set", want_merged: false, evidence: every, texts: [r0, control_other(head_sha: "h1", base_id: run.base_id, wave: "w", rewritten: "a.m1,a.m2", k: 2)], listing: listing),
    merge_case(name: "shard merge RED: a stray file in the directory", want_merged: false, evidence: every, texts: [r0, r1], listing: listing + ["3-of-8.txt"]),
    merge_case(name: "shard merge RED: a base receipt from an older main revision beside the right one", want_merged: false, evidence: every, texts: [r0, r1], listing: listing + [older_base]),
    merge_case(name: "shard merge RED: shards disagree on a shared dependency's rows", want_merged: false, evidence: every, texts: [r0, control_receipt(run: run, index: 1, modules: ["a.m2"], shared: "7:7")], listing: listing),
    merge_case(name: "shard merge RED: a module outside the rewritten set has differing rows", want_merged: false, evidence: every + ["a.dep"], texts: [r0, r1], listing: listing),
    merged_rows_control_failure(),
    base_case(name: "base receipt positive control", want_held: true, key: control_key(), text: control_base_text()),
    base_case(name: "base receipt RED: from another main revision", want_held: false, key: control_key(), text: base_receipt_text(key: BaseKey { base_rev: "b0", instr_rev: "i1" }, status: 0, stdout: control_base_rows())),
    base_case(name: "base receipt RED: from another instrument revision", want_held: false, key: control_key(), text: base_receipt_text(key: BaseKey { base_rev: "b1", instr_rev: "i0" }, status: 0, stdout: control_base_rows())),
    base_case(name: "base receipt RED: from another census contract", want_held: false, key: control_key(), text: replace(control_base_text(), base_census_contract(), "another-contract")),
    base_case(name: "base receipt RED: no receipt", want_held: false, key: control_key(), text: ""),
    selection_case(name: "base selection positive control (the named file only)", want_held: true, listing: [base_receipt_file(key: control_key())]),
    selection_case(name: "base selection RED: only a base from an older main revision is present", want_held: false, listing: [older_base]),
    selection_case(name: "base selection RED: the named base beside an older one", want_held: false, listing: [base_receipt_file(key: control_key()), older_base]),
    selection_case(name: "base selection RED: no base file", want_held: false, listing: []),
    coverage_case(name: "base coverage positive control (every shard module has a base row)", want_uncovered: [], owned: ["a.m1", "a.m3"]),
    coverage_case(name: "base coverage RED: a rewritten module with no row in the base receipt", want_uncovered: ["a.zz"], owned: ["a.m1", "a.zz"]),
    verdict_case(name: "verdict positive control (complete population, exit 0)", want_token: true, head_sha: "h1", text: complete),
    verdict_case(name: "verdict RED: a verdict missing a shard is no token", want_token: false, head_sha: "h1", text: verdict_text(run: run, texts: [r0], exit_code: 0)),
    verdict_case(name: "verdict RED: a verdict of another head is no token", want_token: false, head_sha: "h2", text: complete),
    verdict_case(name: "verdict RED: a refused merge is no token", want_token: false, head_sha: "h1", text: verdict_text(run: run, texts: [r0, r1], exit_code: 1)),
    verdict_case(name: "verdict RED: no verdict is no token", want_token: false, head_sha: "h1", text: ""),
    shard_mode_control_failure()
  ])
}

fn shard_mode_control_failure() -> Optional<String> {
  let evidence = ["a.m1", "a.m2", "a.m3", "a.m4", "a.m5"]
  let shard0 = shard_modules(evidence: evidence, index: 0, shards: 2)
  let shard1 = shard_modules(evidence: evidence, index: 1, shards: 2)
  let reordered = shard_modules(evidence: ["a.m4", "a.m1", "a.m5", "a.m3", "a.m2"], index: 0, shards: 2)
  if (count(shard0) != 3) || (count(shard1) != 2) || (count(shard0 |> filter(m => count(shard1 |> filter(n => n == m)) != 0)) != 0) {
    optional_present(value: "shard membership does not partition the evidence set 3 + 2 without overlap")
  } else if count(reordered |> filter(m => count(shard0 |> filter(n => n == m)) == 0)) != 0 {
    optional_present(value: "shard membership follows read order, not the sorted identities")
  } else {
    match parse_shard_mode(text: "2/2") {
      ShardMalformed { why: _ } => optional_absent()
      ShardFull => optional_present(value: "shard index 2 of 2 parsed as the unsharded run")
      ShardOf { index: _, count: _ } => optional_present(value: "shard index 2 of 2 was admitted")
      ShardMerge { count: _ } => optional_present(value: "shard index 2 of 2 parsed as a merge")
      ShardBase => optional_present(value: "shard index 2 of 2 parsed as the base run")
    }
  }
}

// A side's own incomplete dispositions, carried into the diff's output under that side's name.
fn side_incomplete_rows(side: String, stdout: String) -> List<String> {
  (rows_with_prefix(stdout: stdout, prefix: "refused_rewritten\t") + rows_with_prefix(stdout: stdout, prefix: "unobserved_subject\t"))
    |> map(l => side + "_incomplete\t" + l)
}

fn first_control_failure(controls: List<Optional<String>>) -> Optional<String> {
  fold(controls, init: optional_absent(), f: fn(acc, c) {
    match acc {
      Present { value: _ } => acc
      Absent => c
    }
  })
}

// THE ACCEPTANCE KIT'S INHABITANCE CLAIM ON THE REAL PATH (gunbc.namespace_cut.migration_kit). The census label censuses
// each kit row's fixture pair with the real std and returns its rows as `kit_fixture` lines; here each row is judged
// against its OWN disposition, derived from ambient_name_homes(): a landed row must read KitMigrated (the no-import call
// is Unbound and the imported one binds exactly row.home.name) with no ambient route left; a candidate not yet landed must
// read KitNoImportDoesNotRefuse (its name still resolves ambiently), which is the RED firing as not-yet-migrated. Any other
// reading, including a pair the census never reached, is a failed control. A head that printed no binding rows is left
// to the observation checks below.
fn kit_fixture_lines(stdout: String) -> String {
  split(s: stdout, delimiter: "\n")
    |> filter(l => starts_with(s: l, prefix: "kit_fixture\t"))
    |> map(l => substring(s: l, start: 12, end: string_length(s: l)))
    |> join(separator: "\n") + "\n"
}

fn kit_row_failure(row: AmbientNameHome, kit_stdout: String, population_stdout: String) -> Optional<String> {
  let landed = count(ambient_name_homes() |> filter(h => h.name == row.name)) > 0
  let finding = kit_binding_finding(unimported_stdout: kit_stdout, imported_stdout: kit_stdout, row: row)
  // CHECK 6 over the REAL population (the head census's own binding rows, which exclude the kit_fixture rows): a fixture
  // pair cannot carry an ambient route for a migrated name, so counting it there would be green by construction.
  let routes = kit_ambient_route_count(stdout: population_stdout, spelling: row.name)
  if landed {
    match finding {
      KitNotRunnable { cause: _ } => optional_absent()
      KitMigrated => if routes == 0 { optional_absent() } else { optional_present(value: "kit row " + row.name + ": migrated but an ambient route still binds it") }
      _ => optional_present(value: "kit row " + row.name + ": landed in ambient_name_homes() but the census does not read it migrated")
    }
  } else {
    match finding {
      KitNotRunnable { cause: _ } => optional_absent()
      KitNoImportDoesNotRefuse => optional_absent()
      _ => optional_present(value: "kit row " + row.name + ": a candidate not yet landed must read as still ambient, or was not reached")
    }
  }
}

// A kit row whose fixture occurrences the census never printed is NOT OBSERVED, never a mis-read: the control above
// stays silent for it and this reports it, so the standing is exit 2 (no observation) instead of a failure or a green.
fn kit_fixtures_unreached(head_stdout: String) -> Bool {
  count(ambient_census_kit_rows() |> filter(r => match kit_binding_finding(unimported_stdout: kit_fixture_lines(stdout: head_stdout), imported_stdout: kit_fixture_lines(stdout: head_stdout), row: r) { KitNotRunnable { cause: _ } => true  _ => false })) > 0
}

// AN UNREACHED KIT ROW IS NO OBSERVATION, NEVER A SKIP (tidy-ant-251's ruling, 2026-10-24): over supplied lines, a head
// census that printed population rows but no kit_fixture row for the roster's rows must read unreached, which the
// standing turns into exit 2; and a head carrying a row's fixture records must not. The RED is the first case: a reader
// that treated a missing kit row as clean would answer false there.
fn kit_unreached_control_failure() -> Optional<String> {
  let population_only = "binding\texamples.uses\tInt\t0\tambient:kernel_type_spelling\tkernel:dag_binding_type_int\t6:15\n"
  let reached = ambient_census_kit_rows() |> map(r => "kit_fixture\tbinding_unbound\t" + ambient_census_kit_module(row: r, imported: false) + "\t" + (r.name as String) + "\t1:1\nkit_fixture\tbinding\t" + ambient_census_kit_module(row: r, imported: true) + "\t" + (r.name as String) + "\t0\tdeclared\t" + ambient_name_declaration(row: r) + "\t1:1\n") |> join(separator: "")
  if !kit_fixtures_unreached(head_stdout: population_only) {
    optional_present(value: "kit-unreached: a head census with no kit_fixture rows read as reached")
  } else if kit_fixtures_unreached(head_stdout: population_only + reached) {
    optional_present(value: "kit-unreached: a head census carrying every kit row's fixture records read as unreached")
  } else {
    optional_absent()
  }
}

// THE KIT'S TWO PROBE SHAPES WRITE THE FIXTURE THEIR ROW NEEDS (tidy-ant-251's ruling for type names, 2026-10-24),
// over supplied rows: a callable is called with its parameters forwarded; a type is mentioned once, as the annotation of
// the probe's one parameter, with its arguments' imports derived and its own import only on the imported side. The
// unimported type-use fixture is the type wave's check-1 RED: its one occurrence of the name has no import to bind it.
fn kit_probe_text_control_failure() -> Optional<String> {
  let type_row = AmbientNameHome { name: "Pair" as NonEmptyStr, home: "examples.home" as NonEmptyStr, table: KernelTypeSpellingTable, origin: ExistingDeclaration, retired_contract: optional_absent(), kit_probe: KitTypeUseProbe { arguments: [kit_int(), kit_int()] } }
  let call_row = AmbientNameHome { name: "count_of" as NonEmptyStr, home: "examples.home" as NonEmptyStr, table: KernelTypeSpellingTable, origin: ExistingDeclaration, retired_contract: optional_absent(), kit_probe: KitCallProbe { call: AmbientNameKitCall { params: [AmbientNameKitParam { name: "x" as NonEmptyStr, type_ref: kit_int() }], result: kit_int() } } }
  let type_unimported = "module examples.kit_Pair_unimported\nimport std.types { Int }\nfn probe(m: Pair<Int, Int>) -> Int { 0 }\n"
  let type_imported = "module examples.kit_Pair_imported\nimport std.types { Int }\nimport examples.home { Pair }\nfn probe(m: Pair<Int, Int>) -> Int { 0 }\n"
  let call_imported = "module examples.kit_count_of_imported\nimport std.types { Int }\nimport examples.home { count_of }\nfn probe(x: Int) -> Int { count_of(x) }\n"
  if ambient_census_kit_source(row: type_row, imported: false) != type_unimported {
    optional_present(value: "kit-probe: the unimported type-use fixture is " + ambient_census_kit_source(row: type_row, imported: false))
  } else if ambient_census_kit_source(row: type_row, imported: true) != type_imported {
    optional_present(value: "kit-probe: the imported type-use fixture is " + ambient_census_kit_source(row: type_row, imported: true))
  } else if ambient_census_kit_source(row: call_row, imported: true) != call_imported {
    optional_present(value: "kit-probe: the imported call fixture is " + ambient_census_kit_source(row: call_row, imported: true))
  } else {
    optional_absent()
  }
}

fn kit_fixture_control_failure(head_stdout: String) -> Optional<String> {
  if count(binding_lines(stdout: head_stdout)) == 0 {
    optional_absent()
  } else {
    first_control_failure(controls: ambient_census_kit_rows() |> map(r => kit_row_failure(row: r, kit_stdout: kit_fixture_lines(stdout: head_stdout), population_stdout: head_stdout)))
  }
}

type JoinedModule {
  module: String
  deltas: List<JoinDelta>
  conflicting: Bool
  unusable: Bool
}

fn partial_rows(module: String, stdout: String) -> List<String> {
  rows_with_prefix(stdout: stdout, prefix: "binding_partial_module\t" + module + "\t")
}

// A refused module's partial observation is unusable when either side recorded one occurrence with two different
// bindings (binding_partial_module's conflicting field, v2.compiler.occurrence_resolution_census occurrence_resolution_partial).
fn partial_conflicting(module: String, base_stdout: String, head_stdout: String) -> Bool {
  count((partial_rows(module: module, stdout: base_stdout) + partial_rows(module: module, stdout: head_stdout))
    |> filter(l => field_at(line: l, index: 3) != "0")) != 0
}

// ... and no observation when a side printed no partial-module row at all (a census older than the partial rows) or recorded a
// spelling it could not read (field 4): an absent or incomplete partial observation is never an empty one.
fn partial_unusable(module: String, base_stdout: String, head_stdout: String) -> Bool {
  (count(partial_rows(module: module, stdout: base_stdout)) == 0)
    || (count(partial_rows(module: module, stdout: head_stdout)) == 0)
    || (count((partial_rows(module: module, stdout: base_stdout) + partial_rows(module: module, stdout: head_stdout))
      |> filter(l => field_at(line: l, index: 4) != "0")) != 0)
}

// A census answers 2 while any rewritten module it reached was refused at resolve. A module the join judged at
// occurrence grain on both sides, admitted, is observed, so its refusal alone no longer makes the side incomplete.
// Any other cause of the 2 (an unobserved_subject or unobserved_rewritten row, a refused module the join did not
// admit, or no refused_rewritten row at all) keeps it.
fn side_status_after_join(status: Int, stdout: String, joined_ok: List<String>) -> Int {
  let refused = rows_with_prefix(stdout: stdout, prefix: "refused_rewritten\t") |> map(l => field_at(line: l, index: 1))
  let other = count(rows_with_prefix(stdout: stdout, prefix: "unobserved_subject\t")) + count(rows_with_prefix(stdout: stdout, prefix: "unobserved_rewritten\t"))
  if (status == 2) && (count(refused) != 0) && (other == 0) && (count(refused |> filter(m => count(joined_ok |> filter(j => j == m)) == 0)) == 0) { 0 } else { status }
}

fn join_one_module(m: String, base_stdout: String, head_stdout: String, base_grouped: Map<String, List<String>>, head_grouped: Map<String, List<String>>, proof: WaveProof) -> JoinedModule {
  JoinedModule {
    module: m,
    deltas: occurrence_join_module(rows: ambient_name_homes(), module: m, base_rows: module_rows(grouped: base_grouped, module: m), head_rows: module_rows(grouped: head_grouped, module: m), evidence: map_get(proof.evidence, m), prepared: proof.prepared, lex: proof.lex, scopes: proof.scopes, closures: proof.closures),
    conflicting: partial_conflicting(module: m, base_stdout: base_stdout, head_stdout: head_stdout),
    unusable: partial_unusable(module: m, base_stdout: base_stdout, head_stdout: head_stdout)
  }
}

fn joined_clean(j: JoinedModule) -> Bool {
  !j.conflicting && !j.unusable && (count(j.deltas |> filter(d => !join_delta_admitted(d: d))) == 0)
}

fn module_result_of(j: JoinedModule) -> ModuleResult {
  ModuleResult {
    module: j.module,
    lines: (j.deltas |> filter(d => join_delta_admitted(d: d)) |> map(d => join_delta_line(d: d)))
      + (j.deltas |> filter(d => !join_delta_admitted(d: d) && !join_delta_unobserved(d: d)) |> map(d => join_delta_line(d: d)))
      + (j.deltas |> filter(d => join_delta_unobserved(d: d)) |> map(d => join_delta_line(d: d))),
    refused: count(j.deltas |> filter(d => !join_delta_admitted(d: d) && !join_delta_unobserved(d: d))),
    conflicting: j.conflicting,
    clean: joined_clean(j: j)
  }
}

// THE JOIN OF THESE MODULES, in-process. A shard runs it over the modules it owns, the unsharded run over all of them.
fn join_modules(base_stdout: String, head_stdout: String, proof: WaveProof, modules: List<String>) -> List<ModuleResult> {
  let base_grouped = rows_by_module(stdout: base_stdout)
  let head_grouped = rows_by_module(stdout: head_stdout)
  modules |> map(m => module_result_of(j: join_one_module(m: m, base_stdout: base_stdout, head_stdout: head_stdout, base_grouped: base_grouped, head_grouped: head_grouped, proof: proof)))
}

fn binding_diff_verdict(base_stdout: String, head_stdout: String, base_status: Int, head_status: Int, proof: WaveProof) -> CliWireResponse {
  let diff = binding_diff(base_stdout: base_stdout, head_stdout: head_stdout, rows: ambient_name_homes())
  // A MODULE REFUSED ON BOTH SIDES is compared at occurrence grain by the verified join
  // (gunbc.instruments.namespace_wave_occurrence_join) over its partial and unbound rows, positions defined by the
  // generator's recomputed edit map.
  verdict_from_results(base_stdout: base_stdout, head_stdout: head_stdout, base_status: base_status, head_status: head_status, diff: diff,
    results: join_modules(base_stdout: base_stdout, head_stdout: head_stdout, proof: proof, modules: diff.unobserved_both_sides))
}

// THE VERDICT over the per-module join results, wherever they were computed (in this process, or carried by shard receipts
// the merge admitted). A module leaves the unobserved list only when its partial observation is usable on both sides (a row
// printed, nothing conflicting or unreadable), the proof held, and nothing refused.
fn verdict_from_results(base_stdout: String, head_stdout: String, base_status: Int, head_status: Int, diff: BindingDiff, results: List<ModuleResult>) -> CliWireResponse {
  let join_refused = results |> fold(init: 0, f: fn(acc, r) { acc + r.refused })
  let conflicting = results |> filter(r => r.conflicting) |> map(r => r.module)
  let still_unobserved = results |> filter(r => !r.clean) |> map(r => r.module)
  let joined_ok = results |> filter(r => r.clean) |> map(r => r.module)
  let unobserved = unobserved_rewritten_either(base_stdout: base_stdout, head_stdout: head_stdout)
  let outside = outside_other_population(base_stdout: base_stdout, head_stdout: head_stdout)
  let bytes = ((diff.admitted + diff.refused) |> map(d => delta_line(d: d)) |> join(separator: "\n")) + "\n"
    + (diff.unreached_one_side |> map(m => "refused\tUnreachedOnOneSide\t" + m) |> join(separator: "\n")) + "\n"
    + (results |> fold(init: [], f: fn(acc, r) { acc + r.lines }) |> join(separator: "\n")) + "\n"
    + (conflicting |> map(m => "refused\tPartialConflicting\t" + m) |> join(separator: "\n")) + "\n"
    + (still_unobserved |> map(m => "unobserved\t" + m) |> join(separator: "\n")) + "\n"
    + (unobserved |> map(m => "unobserved_rewritten\t" + m) |> join(separator: "\n")) + "\n"
    + (outside |> map(m => "outside_other_population\t" + m) |> join(separator: "\n")) + "\n"
    + ((side_incomplete_rows(side: "base", stdout: base_stdout) + side_incomplete_rows(side: "head", stdout: head_stdout)) |> join(separator: "\n")) + "\n"
  CliWirePrintable {
    bytes: bytes,
    exit: binding_diff_exit(
      refused: count(diff.refused) + count(diff.unreached_one_side) + join_refused + count(conflicting),
      unobserved: count(unobserved),
      outside: count(outside),
      unobserved_both: count(still_unobserved),
      base_status: side_status_after_join(status: base_status, stdout: base_stdout, joined_ok: joined_ok),
      head_status: side_status_after_join(status: head_status, stdout: head_stdout, joined_ok: joined_ok)
    )
  }
}

fn shard_dir(head_root: String) -> String {
  cargo_default_target_dir(build_root: head_root) + "/namespace-wave-binding-diff/shards"
}

fn shard_refusal(why: String) -> CliWireResponse {
  CliWirePrintable { bytes: "", exit: ExitFailure { code: 2, reason: "shard: " + why + ": not observed" } }
}

fn read_text(path: String) -> String {
  let r = Filesystem.Read(path: path)
  if r.success { r.content } else { "" }
}

// The wave's name in the receipt files: the identity of its rewritten set, which the head's git diff fixes.
fn wave_name(rewritten: String) -> String {
  "w" + substring(s: sha256_hex_of_text(text: rewritten), start: 0, end: 12)
}

// THE EDIT PROOF AND JOIN over `modules` (the whole evidence set, or one shard's), wherever the rows came from.
fn proved_results(base_stdout: String, head_stdout: String, modules: List<String>, base_root: String, head_root: String, prepared: PreparedGrammar, lex: PreparedLexRules, closures: List<RosterHomeClosure>) -> List<ModuleResult> {
  join_modules(base_stdout: base_stdout, head_stdout: head_stdout,
    proof: read_proof(modules: modules, base_root: base_root, head_root: head_root, prepared: prepared, lex: lex, closures: closures),
    modules: modules)
}

// THE SIDES' OWN CHECKS, shared by the unsharded run, a shard and the merge (the side that did not run for this mode is
// never checked): a side whose census did not hold its controls, or printed no binding row, is no observation.
fn sides_unobserved(base_stdout: String, head_stdout: String, base_status: Int, head_status: Int) -> Optional<CliWireResponse> {
  if (base_status != 0) && (base_status != 2) {
    optional_present(value: CliWirePrintable { bytes: base_stdout + "\n", exit: ExitFailure { code: 2, reason: "base: the base ambient-name census exited " + to_string(base_status) + " (its controls did not hold, or it did not run), so base was not observed" } })
  } else if (head_status != 0) && (head_status != 2) {
    optional_present(value: CliWirePrintable { bytes: head_stdout + "\n", exit: ExitFailure { code: 2, reason: "head: the head ambient-name census exited " + to_string(head_status) + " (its controls did not hold, or it did not run), so head was not observed" } })
  } else if count(binding_lines(stdout: base_stdout)) == 0 {
    optional_present(value: CliWirePrintable { bytes: base_stdout + "\n", exit: ExitFailure { code: 2, reason: "base: the base census printed no binding row (exit " + to_string(base_status) + "), so base was not observed; an empty side is no observation, never an empty diff" } })
  } else if count(binding_lines(stdout: head_stdout)) == 0 {
    optional_present(value: CliWirePrintable { bytes: head_stdout + "\n", exit: ExitFailure { code: 2, reason: "head: the head census printed no binding row, so head was not observed; an empty side is no observation, never an empty diff" } })
  } else {
    optional_absent()
  }
}

// THE SHARDED VERDICT. `shard_mode` is GUNBC_WAVE_SHARD verbatim (empty: the unsharded run). Three records:
//   base     the WaveBaseReceipt `base-<main rev>-<instrument rev>.txt`: base's census rows, keyed by the main revision and the
//            instrument revision only -- no head, no rewritten set -- so one run serves every wave on that main revision;
//   i/K      a WaveHeadShard `shard-<wave>-<i>-of-<K>.txt`: the SCOPED head census (its rewritten members and their closures)
//            joined against the base receipt it names by id, the edit proof of the modules it owns;
//   merge/K  no census: the base receipt and the K shard receipts reconstruct the whole-wave rows, and the WaveVerdict
//            `verdict-<wave>.txt` is written, the only admission token (verdict_admission).
// Any base file but the one this run's key names, a foreign shard, a rewritten module the base has no row for, a missing or
// duplicate shard, a stray file, or a differing row outside the rewritten set is exit 2, named.
fn binding_diff_sharded(base_stdout: String, head_stdout: String, base_status: Int, head_status: Int, base_root: String, head_root: String, head_sha: String, base_sha: String, instr_rev: String, rewritten_text: String, shard_mode: String, prepared: PreparedGrammar, lex: PreparedLexRules, closures: List<RosterHomeClosure>) -> CliWireResponse {
  let names = rewritten_names(text: rewritten_text)
  let rewritten = evidence_identity(evidence: names)
  let key = BaseKey { base_rev: base_sha, instr_rev: instr_rev }
  let dir = shard_dir(head_root: head_root)
  let base_path = dir + "/" + base_receipt_file(key: key)
  match parse_shard_mode(text: shard_mode) {
    ShardMalformed { why: why } => shard_refusal(why: why)
    ShardFull =>
      match sides_unobserved(base_stdout: base_stdout, head_stdout: head_stdout, base_status: base_status, head_status: head_status) {
        Present { value: r } => r
        Absent =>
          let diff = binding_diff(base_stdout: base_stdout, head_stdout: head_stdout, rows: ambient_name_homes())
          let evidence = evidence_at_ranks(evidence: evidence_modules(base_stdout: base_stdout, head_stdout: head_stdout), rank: 0, total: count(evidence_modules(base_stdout: base_stdout, head_stdout: head_stdout)))
          verdict_from_results(base_stdout: base_stdout, head_stdout: head_stdout, base_status: base_status, head_status: head_status, diff: diff,
            results: join_modules(base_stdout: base_stdout, head_stdout: head_stdout,
              proof: read_proof(modules: evidence, base_root: base_root, head_root: head_root, prepared: prepared, lex: lex, closures: closures), modules: diff.unobserved_both_sides))
      }
    ShardBase =>
      match sides_unobserved(base_stdout: base_stdout, head_stdout: base_stdout, base_status: base_status, head_status: 0) {
        Present { value: r } => r
        Absent =>
          let text = base_receipt_text(key: key, status: base_status, stdout: base_stdout)
          let written = Filesystem.Write(path: base_path, content: text)
          if written.success { CliWirePrintable { bytes: text, exit: ExitSuccess } } else { shard_refusal(why: "the base receipt could not be written under " + dir) }
      }
    ShardOf { index: i, count: k } =>
      let listing = Filesystem.List(path: dir)
      let entries = if listing.success && (listing.entries != "") { split(s: listing.entries, delimiter: "\n") } else { [] }
      let base_text = read_text(path: base_path)
      match base_selection_refusal(key: key, listing: entries) {
        Present { value: why } => shard_refusal(why: why)
        Absent =>
        match base_receipt_refusal(key: key, text: base_text) {
          Present { value: why } => shard_refusal(why: why)
          Absent =>
            let run = ShardRun { head_sha: head_sha, base_id: base_receipt_id(text: base_text), wave: wave_name(rewritten: rewritten), rewritten: rewritten, count: k }
            let base_rows = base_receipt_rows(text: base_text)
            let base_code = base_receipt_status(text: base_text)
            let owned = shard_modules(evidence: names, index: i, shards: k)
            let uncovered = uncovered_by_base(owned: owned, base_rows: base_rows)
            if count(uncovered) != 0 {
              shard_refusal(why: "the base receipt has no row for rewritten module(s) " + join(uncovered, separator: ",") + " (absent at base is not read as unchanged)")
            } else {
              match sides_unobserved(base_stdout: base_rows, head_stdout: head_stdout, base_status: base_code, head_status: head_status) {
                Present { value: r } => r
                Absent =>
                  let mine = evidence_modules(base_stdout: base_rows, head_stdout: head_stdout) |> filter(m => count(owned |> filter(o => o == m)) != 0)
                  let results = proved_results(base_stdout: base_rows, head_stdout: head_stdout, modules: mine, base_root: base_root, head_root: head_root, prepared: prepared, lex: lex, closures: closures)
                  let text = shard_receipt_text(run: run, index: i, head_status: head_status, head_stdout: head_stdout, results: results)
                  let written = Filesystem.Write(path: dir + "/" + shard_receipt_file(wave: run.wave, index: i, shards: k), content: text)
                  if written.success { CliWirePrintable { bytes: text, exit: ExitSuccess } } else { shard_refusal(why: "the receipt could not be written under " + dir) }
              }
            }
        }
      }
    ShardMerge { count: k } =>
      match merge_receipts_read(head_root: head_root, head_sha: head_sha, base_sha: base_sha, instr_rev: instr_rev, rewritten_text: rewritten_text, shards: k) {
        MergeReceiptsRefused { why: why } => shard_refusal(why: why)
        MergeReceiptsRead { run: run, texts: texts, base_text: base_text, merged_head: merged_head, merged_status: merged_status } =>
          let base_rows = base_receipt_rows(text: base_text)
          let base_code = base_receipt_status(text: base_text)
          let uncovered = uncovered_by_base(owned: names, base_rows: base_rows)
          if count(uncovered) != 0 {
            shard_refusal(why: "the base receipt has no row for rewritten module(s) " + join(uncovered, separator: ",") + " (absent at base is not read as unchanged)")
          } else {
            match sides_unobserved(base_stdout: base_rows, head_stdout: merged_head, base_status: base_code, head_status: merged_status) {
              Present { value: r } => r
              Absent =>
                let evidence = evidence_modules(base_stdout: base_rows, head_stdout: merged_head)
                match merge_results(run: run, rewritten: names, evidence: evidence, texts: texts) {
                  MergeRefused { why: why } => shard_refusal(why: why)
                  Merged { results: proved } =>
                    let diff = binding_diff(base_stdout: base_rows, head_stdout: merged_head, rows: ambient_name_homes())
                    let verdict = verdict_from_results(base_stdout: base_rows, head_stdout: merged_head, base_status: base_code, head_status: merged_status, diff: diff,
                      results: proved + join_modules(base_stdout: base_rows, head_stdout: merged_head, proof: read_proof(modules: [], base_root: base_root, head_root: head_root, prepared: prepared, lex: lex, closures: closures),
                        modules: diff.unobserved_both_sides |> filter(m => count(evidence |> filter(e => e == m)) == 0)))
                    let code = verdict_code(r: verdict)
                    let written = Filesystem.Write(path: dir + "/" + verdict_file(wave: run.wave), content: verdict_text(run: run, texts: texts, exit_code: code))
                    if written.success { verdict } else { shard_refusal(why: "the verdict could not be written under " + dir) }
                }
            }
          }
      }
  }
}

type MergeReceipts
  = MergeReceiptsRefused { why: String }
  | MergeReceiptsRead { run: ShardRun, texts: List<String>, base_text: String, merged_head: String, merged_status: Int }

// THE RECEIPT SET, READ AND JUDGED BEFORE ANY CENSUS OR FOLD: the directory listing, the one base receipt this run's key
// names, and the K shard receipts (count, identity, base id, duplicates, strays). It touches no module text and runs no
// compiler, so a merge with no receipts refuses 2 in the time it takes to list a directory. The sharded fold above and
// `binding_diff_merge_preflight` both read it here: one decision, two call sites.
fn merge_receipts_read(head_root: String, head_sha: String, base_sha: String, instr_rev: String, rewritten_text: String, shards: Int) -> MergeReceipts {
  let names = rewritten_names(text: rewritten_text)
  let rewritten = evidence_identity(evidence: names)
  let key = BaseKey { base_rev: base_sha, instr_rev: instr_rev }
  let dir = shard_dir(head_root: head_root)
  let base_path = dir + "/" + base_receipt_file(key: key)
  let listing = Filesystem.List(path: dir)
  let entries = if listing.success && (listing.entries != "") { split(s: listing.entries, delimiter: "\n") } else { [] }
  let base_text = read_text(path: base_path)
  if !listing.success {
    MergeReceiptsRefused { why: "the receipt directory " + dir + " could not be listed" }
  } else {
    match base_selection_refusal(key: key, listing: entries) {
      Present { value: why } => MergeReceiptsRefused { why: why }
      Absent =>
        match base_receipt_refusal(key: key, text: base_text) {
          Present { value: why } => MergeReceiptsRefused { why: why }
          Absent =>
            let run = ShardRun { head_sha: head_sha, base_id: base_receipt_id(text: base_text), wave: wave_name(rewritten: rewritten), rewritten: rewritten, count: shards }
            let texts = indices_below(n: shards) |> map(i => read_text(path: dir + "/" + shard_receipt_file(wave: run.wave, index: i, shards: shards)))
            match merge_head_rows(run: run, base_name: base_receipt_file(key: key), texts: texts, listing: entries) {
              HeadMergeRefused { why: why } => MergeReceiptsRefused { why: why }
              HeadMerged { head_stdout: merged_head, head_status: merged_status } =>
                MergeReceiptsRead { run: run, texts: texts, base_text: base_text, merged_head: merged_head, merged_status: merged_status }
            }
        }
    }
  }
}

// THE MERGE'S FIRST QUESTION, asked by the host before it runs anything: the receipt set is whole, or the run refuses 2 now.
fn merge_preflight_refusal(head_root: String, head_sha: String, base_sha: String, instr_rev: String, rewritten_text: String, shard_mode: String) -> Optional<CliWireResponse> {
  match parse_shard_mode(text: shard_mode) {
    ShardMerge { count: k } =>
      match merge_receipts_read(head_root: head_root, head_sha: head_sha, base_sha: base_sha, instr_rev: instr_rev, rewritten_text: rewritten_text, shards: k) {
        MergeReceiptsRefused { why: why } => optional_present(value: shard_refusal(why: why))
        MergeReceiptsRead { run: _, texts: _, base_text: _, merged_head: _, merged_status: _ } => optional_absent()
      }
    ShardFull => optional_absent()
    ShardBase => optional_absent()
    ShardOf { index: _, count: _ } => optional_absent()
    ShardMalformed { why: why } => optional_present(value: shard_refusal(why: why))
  }
}

fn binding_diff_merge_preflight_refused(head_root: String, head_sha: String, base_sha: String, instr_rev: String, rewritten: String, shard_mode: String) -> Bool {
  match merge_preflight_refusal(head_root: head_root, head_sha: head_sha, base_sha: base_sha, instr_rev: instr_rev, rewritten_text: rewritten, shard_mode: shard_mode) {
    Present { value: _ } => true
    Absent => false
  }
}

fn binding_diff_merge_preflight(head_root: String, head_sha: String, base_sha: String, instr_rev: String, rewritten: String, shard_mode: String) -> CliWireResponse {
  match merge_preflight_refusal(head_root: head_root, head_sha: head_sha, base_sha: base_sha, instr_rev: instr_rev, rewritten_text: rewritten, shard_mode: shard_mode) {
    Present { value: r } => r
    Absent => shard_refusal(why: "binding_diff_merge_preflight was asked for a refusal that does not exist")
  }
}

// ---------------------------------------------------------------------------------------------------
// THE TEXTS THE PROOF IS COMPUTED FROM, read in .dag from the two roots the host leaves in place (the base worktree and the
// head tree): module `a.b.c` is at `<root>/dag/a/b/c.dag`, a `v2.*` module at `<root>/src/v2/...` (gunbc.source_layout).
fn module_file(root: String, module: String) -> String {
  let rel = replace(module, ".", "/") + ".dag"
  if starts_with(s: module, prefix: "v2.") { root + "/src/" + rel } else { root + "/dag/" + rel }
}

fn read_module_evidence(base_root: String, head_root: String, module: String) -> ModuleEvidence {
  let b = Filesystem.Read(path: module_file(root: base_root, module: module))
  let h = Filesystem.Read(path: module_file(root: head_root, module: module))
  ModuleEvidence { module: module, base_text: b.content, head_text: h.content, readable: b.success && h.success }
}

// Only a module both sides reached whose rows DIFFER needs its texts: identical rows are no change and need no proof.
fn evidence_modules(base_stdout: String, head_stdout: String) -> List<String> {
  let base_grouped = rows_by_module(stdout: base_stdout)
  let head_grouped = rows_by_module(stdout: head_stdout)
  binding_diff(base_stdout: base_stdout, head_stdout: head_stdout, rows: []).unobserved_both_sides
    |> filter(m => !rows_multiset_equal(base_rows: module_rows(grouped: base_grouped, module: m), head_rows: module_rows(grouped: head_grouped, module: m)))
}

fn read_proof(modules: List<String>, base_root: String, head_root: String, prepared: PreparedGrammar, lex: PreparedLexRules, closures: List<RosterHomeClosure>) -> WaveProof {
  WaveProof {
    evidence: fold(modules, init: empty_map(), f: fn(m, name) { map_insert(m, name, read_module_evidence(base_root: base_root, head_root: head_root, module: name)) }),
    prepared: prepared,
    lex: lex,
    scopes: rows_proof_scopes(rows: ambient_name_homes()),
    closures: closures
  }
}

fn binding_diff_standing(
  rebind_base_stdout: String,
  rebind_head_stdout: String,
  base_stdout: String,
  base_status: Int,
  head_stdout: String,
  head_status: Int,
  wave_base_stdout: String,
  wave_admit_stdout: String,
  wave_moved_stdout: String,
  wave_wrong_home_stdout: String,
  base_root: String,
  head_root: String,
  head_sha: String,
  base_sha: String,
  instr_rev: String,
  rewritten: String,
  shard_mode: String,
  closures: List<RosterHomeClosure>
) -> CliWireResponse {
  match dag_prepared_grammar() {
    Rejected { diagnostics: _ } => CliWirePrintable { bytes: "", exit: ExitFailure { code: 2, reason: "the dag grammar could not be prepared, so no edit proof can be computed: not observed" } }
    Accepted { value: prepared, diagnostics: _ } => binding_diff_standing_prepared(rebind_base_stdout: rebind_base_stdout, rebind_head_stdout: rebind_head_stdout, base_stdout: base_stdout, base_status: base_status, head_stdout: head_stdout, head_status: head_status, wave_base_stdout: wave_base_stdout, wave_admit_stdout: wave_admit_stdout, wave_moved_stdout: wave_moved_stdout, wave_wrong_home_stdout: wave_wrong_home_stdout, base_root: base_root, head_root: head_root, head_sha: head_sha, base_sha: base_sha, instr_rev: instr_rev, rewritten: rewritten, shard_mode: shard_mode, prepared: prepared, lex: dag_prepared_lex(), closures: closures)
  }
}

fn binding_diff_standing_prepared(
  rebind_base_stdout: String,
  rebind_head_stdout: String,
  base_stdout: String,
  base_status: Int,
  head_stdout: String,
  head_status: Int,
  wave_base_stdout: String,
  wave_admit_stdout: String,
  wave_moved_stdout: String,
  wave_wrong_home_stdout: String,
  base_root: String,
  head_root: String,
  head_sha: String,
  base_sha: String,
  instr_rev: String,
  rewritten: String,
  shard_mode: String,
  prepared: PreparedGrammar,
  lex: PreparedLexRules,
  closures: List<RosterHomeClosure>
) -> CliWireResponse {
  match rebind_red_failure(base_stdout: rebind_base_stdout, head_stdout: rebind_head_stdout) {
    Present { value: why } => CliWirePrintable { bytes: rebind_base_stdout + "\n" + rebind_head_stdout + "\n", exit: ExitFailure { code: 1, reason: "re-bind RED: " + why } }
    Absent =>
      match first_control_failure(controls: [home_control_failure(), formatter_control_failure(), declaration_row_control_failure(), incomplete_side_control_failure(), kit_fixture_control_failure(head_stdout: head_stdout), kit_unreached_control_failure(), kit_probe_text_control_failure(), shard_merge_control_failure(), wave_carry_control_failure(prepared: prepared, lex: lex, closures: closures), occurrence_join_controls_failure(prepared: prepared, lex: lex, closures: closures), wave_unobserved_control_failure(prepared: prepared, lex: lex, closures: closures), unobserved_guards_control_failure(base: wave_base_stdout, admit: wave_admit_stdout, prepared: prepared, lex: lex, closures: closures), wave_other_incompleteness_control_failure(base: wave_base_stdout, admit: wave_admit_stdout, proof: wave_proof(prepared: prepared, lex: lex, head: wave_derived_head_with(prepared: prepared, lex: lex, closures: closures), closures: closures)), refused_cause_identity_control_failure(base: wave_base_stdout, admit: wave_admit_stdout, proof: wave_proof(prepared: prepared, lex: lex, head: wave_derived_head_with(prepared: prepared, lex: lex, closures: closures), closures: closures)), wave_join_route_failure(base: wave_base_stdout, admit: wave_admit_stdout, moved: wave_moved_stdout, wrong_home: wave_wrong_home_stdout, prepared: prepared, lex: lex, closures: closures)]) {
        Present { value: why } => CliWirePrintable { bytes: "", exit: ExitFailure { code: 1, reason: "control: " + why } }
        Absent =>
          // The kit fixtures ride the head census; a mode that ran no head census (no binding rows) is judged by the
          // shard verdicts, so the unreached check applies only where a head census printed rows.
          if (count(binding_lines(stdout: head_stdout)) > 0) && kit_fixtures_unreached(head_stdout: head_stdout) {
            CliWirePrintable { bytes: head_stdout + "\n", exit: ExitFailure { code: 2, reason: "head: the census printed no kit_fixture binding row for a kit row, so the kit fixtures were not observed" } }
          } else {
          binding_diff_sharded(base_stdout: base_stdout, head_stdout: head_stdout, base_status: base_status, head_status: head_status, base_root: base_root, head_root: head_root, head_sha: head_sha, base_sha: base_sha, instr_rev: instr_rev, rewritten_text: rewritten, shard_mode: shard_mode, prepared: prepared, lex: lex, closures: closures)
          }
      }
  }
}

// WHICH CENSUSES THIS MODE RUNS, read by the host (which only carries them out); the decisions are the shard module's.
fn binding_diff_runs_base_worktree(shard_mode: String) -> Bool {
  wave_runs_base_worktree(shard_mode: shard_mode)
}

fn binding_diff_runs_base_census(shard_mode: String) -> Bool {
  wave_runs_base_census(shard_mode: shard_mode)
}

fn binding_diff_runs_head_census(shard_mode: String) -> Bool {
  wave_runs_head_census(shard_mode: shard_mode)
}

// THE BASE A WAVE IS DIFFED AGAINST: the merge base of HEAD and this ref. A policy fact, so it lives here
// and the host receives it, rather than as a literal in the host's argv.
// THE NAMES the base receipt's population is chosen by: every name a wave row moves, one authority with the rows.
fn binding_diff_population_names() -> List<String> {
  ambient_name_homes() |> map(r => r.name as String)
}

fn binding_diff_base_ref() -> String {
  ambient_census_base_ref()
}
