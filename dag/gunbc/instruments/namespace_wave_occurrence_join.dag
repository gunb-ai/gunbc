module gunbc.instruments.namespace_wave_occurrence_join

import std.types { String, Bool, List, Int, Map }
import std.algebra { empty_map, map_insert, list_at_optional, list_snoc_item }
import std.optional { Optional, Present, Absent }
import gunbc.namespace_cut.ambient_name_home { AmbientNameHome, ExistingDeclaration, PrimitiveAuthorityTable }

// THE VERIFIED OCCURRENCE JOIN for a module resolve refuses on BOTH sides of a wave (the case NAMESPACE-XL wave 1
// is made of: a module that uses chars almost always still refuses on other ambient names after the wave). The
// ordinal-keyed diff (gunbc.instruments.namespace_wave_binding_diff) cannot see such a module: it has no complete
// binding row on either side. What each side does print, per occurrence, with its source locus
// (v2.compiler.source_root_eval native_census_binding_loci / native_census_unbound_lines):
//
//   binding_partial <module> <spelling> <ordinal> <source> <target> <line>:<col>   an occurrence the refused walk bound
//   binding_unbound <module> <spelling> <line>:<col>                               an occurrence it refused as unbound
//   binding_file    <module> <line count>
//
// THE CORRESPONDENCE IS A COORDINATE, NOT A COUNT. An occurrence's coordinate is (its line counted from the END of its
// file, its rank among the same spelling's occurrences on that line, left to right). The edits a wave makes leave every
// coordinate unchanged: an inserted or extended import sits above every body, and an argument-label rename changes
// columns on its own line but no line and no same-spelling order. Any other edit -- a moved line, an added or deleted
// occurrence, a reordering -- changes some coordinate, and the occurrence then has no partner and REFUSES by name. So
// equal per-spelling counts can never pair the wrong occurrences: the ordinal is not consulted at all.
//
// ADMITTED: an occurrence unbound on base whose spelling a home row names, and which binds exactly that row's home on
// head (UnboundToDeclaredHome); and an occurrence that is unchanged (same source and target). EVERYTHING ELSE REFUSES:
// TargetChanged (bound on both sides, differently, or unbound -> anything but the row's home), Appeared, Vanished,
// Unlocated (a module with no line count, or locus-less generated rows whose multiset differs; never placed by guess).

type JoinEntry {
  module: String
  spelling: String
  line: Int
  column: Int
  source: String
  target: String
}

type JoinDelta
  = JoinAdmitted { coordinate: String, spelling: String, home: String }
  | JoinRefused { cause: String, coordinate: String, detail: String }

fn join_field(line: String, index: Int) -> String {
  match list_at_optional(xs: split(s: line, delimiter: "\t"), index: index) {
    Present { value: f } => f
    Absent => ""
  }
}

fn join_int(text: String) -> Int {
  match parse_int(text) {
    Present { value: n } => n
    Absent => 0 - 1
  }
}

fn join_locus_line(locus: String) -> Int {
  join_int(text: join_field(line: replace(locus, ":", "\t"), index: 0))
}

fn join_locus_column(locus: String) -> Int {
  join_int(text: join_field(line: replace(locus, ":", "\t"), index: 1))
}

fn join_entries(stdout: String, module: String) -> List<JoinEntry> {
  let lines = split(s: stdout, delimiter: "\n")
  let partial = lines |> filter(l => starts_with(s: l, prefix: "binding_partial\t" + module + "\t"))
    |> map(l => JoinEntry { module: module, spelling: join_field(line: l, index: 2), line: join_locus_line(locus: join_field(line: l, index: 6)), column: join_locus_column(locus: join_field(line: l, index: 6)), source: join_field(line: l, index: 4), target: join_field(line: l, index: 5) })
  let unbound = lines |> filter(l => starts_with(s: l, prefix: "binding_unbound\t" + module + "\t"))
    |> map(l => JoinEntry { module: module, spelling: join_field(line: l, index: 2), line: join_locus_line(locus: join_field(line: l, index: 3)), column: join_locus_column(locus: join_field(line: l, index: 3)), source: "unbound", target: "-" })
  partial + unbound
}

fn join_line_count(stdout: String, module: String) -> Int {
  match first(split(s: stdout, delimiter: "\n") |> filter(l => starts_with(s: l, prefix: "binding_file\t" + module + "\t"))) {
    Present { value: l } => join_int(text: join_field(line: l, index: 2))
    Absent => 0 - 1
  }
}

// The coordinate text, `<module> <spelling> @<line from end>#<rank>`; Absent when the entry cannot be placed.
fn join_coordinate(entry: JoinEntry, all: List<JoinEntry>, line_count: Int) -> Optional<String> {
  if (entry.line < 1) || (entry.column < 1) || (line_count < entry.line) {
    Absent
  } else {
    let rank = count(all |> filter(o => (o.spelling == entry.spelling) && (o.line == entry.line) && (o.column < entry.column)))
    Present { value: entry.module + " " + entry.spelling + " @" + to_string(line_count - entry.line) + "#" + to_string(rank) }
  }
}

type JoinSide {
  placed: Map<String, JoinEntry>
  unlocated: List<JoinEntry>
  collided: List<String>
}

fn join_side(entries: List<JoinEntry>, line_count: Int) -> JoinSide {
  fold(entries, init: JoinSide { placed: empty_map(), unlocated: [], collided: [] }, f: fn(acc, e) {
    match join_coordinate(entry: e, all: entries, line_count: line_count) {
      Absent => JoinSide { placed: acc.placed, unlocated: list_snoc_item(xs: acc.unlocated, item: e), collided: acc.collided }
      Present { value: c } =>
        match map_get(acc.placed, c) {
          Present { value: _ } => JoinSide { placed: acc.placed, unlocated: acc.unlocated, collided: list_snoc_item(xs: acc.collided, item: c) }
          Absent => JoinSide { placed: map_insert(acc.placed, c, e), unlocated: acc.unlocated, collided: acc.collided }
        }
    }
  })
}

fn join_home_for(rows: List<AmbientNameHome>, spelling: String) -> Optional<String> {
  match first(rows |> filter(r => (r.name as String) == spelling)) {
    Present { value: r } => Present { value: r.home as String }
    Absent => Absent
  }
}

fn join_pair(rows: List<AmbientNameHome>, coordinate: String, before: JoinEntry, after: JoinEntry) -> Optional<JoinDelta> {
  if (before.source == after.source) && (before.target == after.target) {
    Absent
  } else {
    match join_home_for(rows: rows, spelling: before.spelling) {
      Present { value: home } =>
        if (before.source == "unbound") && (after.source == "declared") && (after.target == home) {
          Present { value: JoinAdmitted { coordinate: coordinate, spelling: before.spelling, home: home } }
        } else {
          Present { value: JoinRefused { cause: "TargetChanged", coordinate: coordinate, detail: before.source + " " + before.target + " -> " + after.source + " " + after.target } }
        }
      Absent => Present { value: JoinRefused { cause: "TargetChanged", coordinate: coordinate, detail: before.source + " " + before.target + " -> " + after.source + " " + after.target } }
    }
  }
}

// ONE MODULE, BOTH SIDES. Every placed coordinate of either side lands in exactly one delta or is unchanged.
fn occurrence_join_module(rows: List<AmbientNameHome>, module: String, base_stdout: String, head_stdout: String) -> List<JoinDelta> {
  let base_n = join_line_count(stdout: base_stdout, module: module)
  let head_n = join_line_count(stdout: head_stdout, module: module)
  if (base_n < 0) || (head_n < 0) {
    [JoinRefused { cause: "NoLineCount", coordinate: module, detail: "no binding_file line count on " + (if base_n < 0 { "base" } else { "head" }) }]
  } else {
    occurrence_join_entries(rows: rows, base: join_side(entries: join_entries(stdout: base_stdout, module: module), line_count: base_n), head: join_side(entries: join_entries(stdout: head_stdout, module: module), line_count: head_n))
  }
}

fn occurrence_join_entries(rows: List<AmbientNameHome>, base: JoinSide, head: JoinSide) -> List<JoinDelta> {
  let paired = map_keys(head.placed) |> fold(init: [], f: fn(acc, c) {
    match map_get(head.placed, c) {
      Absent => acc
      Present { value: after } =>
        match map_get(base.placed, c) {
          Absent => list_snoc_item(xs: acc, item: JoinRefused { cause: "Appeared", coordinate: c, detail: after.source + " " + after.target })
          Present { value: before } =>
            match join_pair(rows: rows, coordinate: c, before: before, after: after) {
              Present { value: d } => list_snoc_item(xs: acc, item: d)
              Absent => acc
            }
        }
    }
  })
  let vanished = map_keys(base.placed)
    |> filter(c => match map_get(head.placed, c) { Present { value: _ } => false  Absent => true })
    |> map(c => match map_get(base.placed, c) {
      Present { value: b } => JoinRefused { cause: "Vanished", coordinate: c, detail: b.source + " " + b.target }
      Absent => JoinRefused { cause: "Vanished", coordinate: c, detail: "-" }
    })
  let collided = (base.collided |> map(c => JoinRefused { cause: "Collided", coordinate: c, detail: "base" })) + (head.collided |> map(c => JoinRefused { cause: "Collided", coordinate: c, detail: "head" }))
  paired + vanished + collided + join_unlocated_multiset(base: base.unlocated, head: head.unlocated)
}

// A ROW WITH NO LOCUS is a compiler-generated reference (an elided record head, a list literal's generated head): it has
// no authored position to place. Such rows are compared as a multiset of (spelling, source, target): equal on both sides
// is no change; any difference refuses as Unlocated, naming the key and both counts. Never placed by guess.
fn join_unlocated_key(e: JoinEntry) -> String {
  e.module + " " + e.spelling + " " + e.source + " " + e.target
}

fn join_unlocated_multiset(base: List<JoinEntry>, head: List<JoinEntry>) -> List<JoinDelta> {
  let keys = map_keys(fold(base + head, init: empty_map(), f: fn(m, e) { map_insert(m, join_unlocated_key(e: e), true) }))
  keys |> fold(init: [], f: fn(acc, k) {
    let b = count(base |> filter(e => join_unlocated_key(e: e) == k))
    let h = count(head |> filter(e => join_unlocated_key(e: e) == k))
    if b == h { acc } else { list_snoc_item(xs: acc, item: JoinRefused { cause: "Unlocated", coordinate: k, detail: "base " + to_string(b) + " head " + to_string(h) }) }
  })
}

fn join_delta_line(d: JoinDelta) -> String {
  match d {
    JoinAdmitted { coordinate: c, spelling: _, home: h } => "admitted\tUnboundToDeclaredHome\t" + c + "\t" + h
    JoinRefused { cause: k, coordinate: c, detail: t } => "refused\t" + k + "\t" + c + "\t" + t
  }
}

fn join_delta_admitted(d: JoinDelta) -> Bool {
  match d {
    JoinAdmitted { coordinate: _, spelling: _, home: _ } => true
    JoinRefused { cause: _, coordinate: _, detail: _ } => false
  }
}

fn join_delta_unobserved(d: JoinDelta) -> Bool {
  match d {
    JoinAdmitted { coordinate: _, spelling: _, home: _ } => false
    JoinRefused { cause: c, coordinate: _, detail: _ } => c == "NoLineCount"
  }
}

// ---------------------------------------------------------------------------------------------------
// THE CONTROLS, at the join's own interface with supplied census lines (the census producer's route is the
// ambient-name-census fixture, which must print binding_unbound, binding_partial with a locus, and binding_file).
// base: a 30-line file with chars unbound at lines 10 and 20; head: the same file with one import line inserted.
//   admit:  head binds chars to its home at lines 11 and 21 -> two UnboundToDeclaredHome, nothing refused.
//   WRONG CORRESPONDENCE, EQUAL COUNT: head binds chars at lines 11 and 22 (one occurrence moved a line) -> two
//           occurrences on each side, but the coordinates disagree, so the join refuses (Appeared + Vanished), where a
//           per-spelling count equality would have admitted it.
//   other home: head binds chars at 11 and 21 but one to another declaration -> TargetChanged.
//   unlocated: a head row with locus `-` that base does not have -> Unlocated (multiset differs), and base's located
//              occurrence it replaced -> Vanished.

fn join_control_rows() -> List<AmbientNameHome> {
  [AmbientNameHome { name: "chars", home: "std.host_text.chars", table: PrimitiveAuthorityTable, origin: ExistingDeclaration }]
}

fn join_control_base() -> String {
  "binding_file\tm\t30\nbinding_unbound\tm\tchars\t10:5\nbinding_unbound\tm\tchars\t20:9\nbinding_partial\tm\tInt\t0\tambient:kernel_type_spelling\tkernel:dag_binding_type_int\t25:12\n"
}

fn join_control_head(first_line: String, second_line: String, second_target: String) -> String {
  "binding_file\tm\t31\nbinding_partial\tm\tchars\t0\tdeclared\tstd.host_text.chars\t" + first_line + "\nbinding_partial\tm\tchars\t1\tdeclared\t" + second_target + "\t" + second_line + "\nbinding_partial\tm\tInt\t0\tambient:kernel_type_spelling\tkernel:dag_binding_type_int\t26:12\n"
}

fn join_control_case(name: String, head: String, want_admitted: Int, want_refused: List<String>) -> String {
  let deltas = occurrence_join_module(rows: join_control_rows(), module: "m", base_stdout: join_control_base(), head_stdout: head)
  let admitted = count(deltas |> filter(d => join_delta_admitted(d: d)))
  let refused = deltas |> filter(d => !join_delta_admitted(d: d)) |> map(d => match d { JoinRefused { cause: k, coordinate: _, detail: _ } => k  JoinAdmitted { coordinate: _, spelling: _, home: _ } => "" })
  if (admitted == want_admitted) && (count(refused) == count(want_refused)) && (count(want_refused |> filter(w => count(refused |> filter(r => r == w)) != count(want_refused |> filter(x => x == w)))) == 0) {
    ""
  } else {
    "occurrence-join control " + name + ": admitted " + to_string(admitted) + ", refused [" + join(refused, separator: ",") + "]; want " + to_string(want_admitted) + " and [" + join(want_refused, separator: ",") + "]\n"
  }
}

// An unchanged body row (Int, line 25 of 30 -> 26 of 31) keeps its coordinate and contributes no delta in every case.
fn occurrence_join_controls_failure() -> Optional<String> {
  let report = join_control_case(name: "admit", head: join_control_head(first_line: "11:5", second_line: "21:9", second_target: "std.host_text.chars"), want_admitted: 2, want_refused: [])
    + join_control_case(name: "equal-count-wrong-correspondence", head: join_control_head(first_line: "11:5", second_line: "22:9", second_target: "std.host_text.chars"), want_admitted: 1, want_refused: ["Appeared", "Vanished"])
    + join_control_case(name: "other-home", head: join_control_head(first_line: "11:5", second_line: "21:9", second_target: "examples.elsewhere.chars"), want_admitted: 1, want_refused: ["TargetChanged"])
    + join_control_case(name: "unlocated", head: join_control_head(first_line: "11:5", second_line: "-", second_target: "std.host_text.chars"), want_admitted: 1, want_refused: ["Unlocated", "Vanished"])
  if report == "" { Absent } else { Present { value: report } }
}
