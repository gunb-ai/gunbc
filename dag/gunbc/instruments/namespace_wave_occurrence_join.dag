module gunbc.instruments.namespace_wave_occurrence_join

import std.types { String, Bool, List, Int, Map }
import std.algebra { empty_map, map_insert, list_at_optional, list_snoc_item, length, fold_list, list_init, list_reverse }
import std.bytes { bytes_octets, utf8_encode_bytes }
import std.optional { Optional, Present, Absent }
import gunbc.namespace_cut.ambient_name_home { AmbientNameHome, ExistingDeclaration, PrimitiveAuthorityTable }
import v2.compiler.parse { PreparedGrammar }
import v2.compiler.tokenize { PreparedLexRules }
import v2.std.qualified_name { qualified_name_from_dotted_string }
import v2.workflow.roster_import_sweep {
  RosterApplied,
  RosterApplyRefused,
  RosterApplyWritten,
  RosterClean,
  RosterEdit,
  RosterEditWithLabels,
  OneHome,
  RosterLabelEdit,
  RosterLabelEdits,
  RosterOutcome,
  RosterRefused,
  RosterHomeClosure,
  roster_applied,
  roster_home_closures,
  roster_sweep_text_scoped
}

// THE VERIFIED OCCURRENCE JOIN, one path for a module's complete rows and its partial rows. The census prints, per
// occurrence, with its source locus (v2.compiler.source_root_eval native_census_binding_loci / native_census_unbound_lines):
//
//   binding         <module> <spelling> <ordinal> <source> <target> <line>:<col>   an occurrence the walk bound
//   binding_partial <module> <spelling> <ordinal> <source> <target> <line>:<col>   the same, for a module resolve refused
//   binding_unbound <module> <spelling> <line>:<col>                               an occurrence it refused as unbound
//
// THE CORRESPONDENCE IS THE GENERATOR'S OWN EDIT MAP, NOT A GUESS (tidy-ant-251's ruling on PR #14324). A wave's edits
// are those of the roster sweep (v2.workflow.roster_import_sweep roster_sweep_text_scoped): an import inserted and an
// argument label renamed. The join RECOMPUTES them from the module's base text with that pure planning function, applies
// them with the generator's own splice (roster_applied), and requires the result to be BYTE-EQUAL to the head text. A head
// that differs by any other byte is not this wave's rewrite and REFUSES (EditsNotGenerated); a text that cannot be read, or
// that the generator refuses, is UNOBSERVED (exit 2). Only then is an occurrence's head position DEFINED: its base byte
// offset carried through the recorded extents (an edit that ends at or before it shifts it by that edit's length change; an
// extent that contains it refuses), then read back as a head line:column. Every base occurrence must find exactly one head
// occurrence of the same spelling at that position, and every head occurrence must be claimed; a count is never consulted.
//
// A COMPILER-GENERATED REFERENCE (an elided record head, a list literal's generated head) has locus `-` and no authored
// position: the census carries no causing authored locus for it (a named frontier). Under the proven byte-equality the
// edits are import lines and argument labels only, so no construct that causes a generated reference changed, and the
// generated rows are compared as a MULTISET of (spelling, source, target): admitted only on exact equality, and any
// differing triple refuses (GeneratedChanged). Without the proof they would stay unobserved. A deletion extent that
// removes a construct that causes a generated reference changes the multiset and refuses.
//
// ADMITTED: an occurrence unbound or ambient on base whose spelling a home row names, and which binds exactly that row's
// home on head (UnboundToDeclaredHome); and an occurrence that is unchanged. EVERYTHING ELSE REFUSES: TargetChanged,
// Appeared, Vanished, Collided, GeneratedChanged, EditCoversOccurrence, EditsNotGenerated.

type JoinEntry {
  module: String
  spelling: String
  locus: JoinLocus
  source: String
  target: String
}

// A census locus read ONCE (read_join_locus): a valid coordinate, the explicit `-` the census prints when no locus was
// recovered, or text that is neither (refused, never defaulted). Absence proves no provenance: a missing file or span
// index entry prints `-` too, so a generated reference is admitted only under the proven edit recomputation.
type JoinLocus
  = LocusAt { line: Int, column: Int }
  | LocusAbsent
  | LocusMalformed { text: String }

type JoinDelta
  = JoinAdmitted { coordinate: String, spelling: String, home: String }
  | JoinRefused { cause: String, coordinate: String, detail: String }
  | JoinUnobserved { coordinate: String, detail: String }

fn join_field(line: String, index: Int) -> String {
  match list_at_optional(xs: split(s: line, delimiter: "\t"), index: index) {
    Present { value: f } => f
    Absent => ""
  }
}

fn read_join_locus(text: String) -> JoinLocus {
  if text == "-" {
    LocusAbsent
  } else {
    let parts = split(s: text, delimiter: ":")
    if length(xs: parts) != 2 {
      LocusMalformed { text: text }
    } else {
      join_locus_by_parts(text: text, parts: parts)
    }
  }
}

fn join_locus_by_parts(text: String, parts: List<String>) -> JoinLocus {
  match list_at_optional(xs: parts, index: 0) {
    Absent => LocusMalformed { text: text }
    Present { value: l } =>
      match list_at_optional(xs: parts, index: 1) {
        Absent => LocusMalformed { text: text }
        Present { value: c } => join_locus_from_ints(text: text, line: parse_int(l), column: parse_int(c))
      }
  }
}

fn join_locus_from_ints(text: String, line: Optional<Int>, column: Optional<Int>) -> JoinLocus {
  match line {
    Absent => LocusMalformed { text: text }
    Present { value: l } =>
      match column {
        Absent => LocusMalformed { text: text }
        Present { value: c } => if (l >= 1) && (c >= 1) { LocusAt { line: l, column: c } } else { LocusMalformed { text: text } }
      }
  }
}

// ---------------------------------------------------------------------------------------------------
// THE EDIT PROOF.

// `replaced` / `replacement`: the bytes a replacement step takes out and puts in (a label or call-head rename), "" for an
// inserted import. Only a step that replaces EXACTLY an occurrence's own spelling, starting at it, can carry that occurrence
// (a rename); every other step that contains an occurrence still refuses EditCoversOccurrence.
type EditStep {
  start: Int
  end: Int
  new_len: Int
  replaced: String
  replacement: String
}

type EditProof
  = EditProven { rounds: List<List<EditStep>> }
  | EditNotGenerated { detail: String }
  | EditUnobserved { detail: String }

// What the generator wrote or could not, per module: one record the pure core and the controls read.
type ModuleEvidence {
  module: String
  base_text: String
  head_text: String
  readable: Bool
}

type ProofState {
  text: String
  rounds: List<List<EditStep>>
  done: Bool
  stuck: String
}

fn text_byte_length(text: String) -> Int {
  length(xs: bytes_octets(b: utf8_encode_bytes(s: text)))
}

fn label_step(edit: RosterLabelEdit) -> EditStep {
  EditStep { start: edit.start, end: edit.end, new_len: text_byte_length(text: edit.to), replaced: edit.from, replacement: edit.to }
}

fn outcome_steps(outcome: RosterOutcome) -> List<EditStep> {
  match outcome {
    RosterClean => []
    RosterRefused { reason: _ } => []
    RosterEdit { start: s, end: e, text: t, own_line: o } => [EditStep { start: s, end: e, new_len: text_byte_length(text: (if o { "\n" } else { "" }) + t), replaced: "", replacement: "" }]
    RosterLabelEdits { edits: es } => fold_list(xs: es, empty: [], cons: fn(acc, e) { list_snoc_item(xs: acc, item: label_step(edit: e)) })
    RosterEditWithLabels { start: s, end: e, text: t, own_line: o, labels: ls } => fold_list(xs: ls, empty: [EditStep { start: s, end: e, new_len: text_byte_length(text: (if o { "\n" } else { "" }) + t), replaced: "", replacement: "" }], cons: fn(acc, l) { list_snoc_item(xs: acc, item: label_step(edit: l)) })
  }
}

fn proof_apply(state: ProofState, outcome: RosterOutcome) -> ProofState {
  match roster_applied(before: state.text, outcome: outcome) {
    RosterApplyWritten { content: c } => ProofState { text: c, rounds: list_snoc_item(xs: state.rounds, item: outcome_steps(outcome: outcome)), done: false, stuck: "" }
    RosterApplyRefused { reason: _ } => ProofState { text: state.text, rounds: state.rounds, done: false, stuck: "the generator's own splice refused its edit" }
  }
}

fn proof_round(state: ProofState, path: String, prepared: PreparedGrammar, lex: PreparedLexRules, home: String, closures: List<RosterHomeClosure>) -> ProofState {
  if state.done || (state.stuck != "") {
    state
  } else {
    let outcome = roster_sweep_text_scoped(path: path, text: state.text, prepared: prepared, lex: lex, scope: OneHome { home: qualified_name_from_dotted_string(dotted: home) }, closures: closures)
    match outcome {
      RosterClean => ProofState { text: state.text, rounds: state.rounds, done: true, stuck: "" }
      RosterRefused { reason: _ } => ProofState { text: state.text, rounds: state.rounds, done: false, stuck: "the sweep generator refused the module" }
      RosterEdit { start: s, end: e, text: t, own_line: o } => proof_apply(state: state, outcome: outcome)
      RosterLabelEdits { edits: es } => proof_apply(state: state, outcome: outcome)
      RosterEditWithLabels { start: s, end: e, text: t, own_line: o, labels: ls } => proof_apply(state: state, outcome: outcome)
    }
  }
}

// THE GENERATOR'S OWN RECOMPUTATION from a base text: sweep, splice, repeat to a fixed point (the apply step converges the same way).
fn recompute_wave_text(path: String, base_text: String, prepared: PreparedGrammar, lex: PreparedLexRules, home: String) -> ProofState {
  let closures = roster_home_closures(root: "", scope: OneHome { home: qualified_name_from_dotted_string(dotted: home) })
  fold([0, 1, 2, 3], init: ProofState { text: base_text, rounds: [], done: false, stuck: "" }, f: fn(acc, i) {
    proof_round(state: acc, path: path, prepared: prepared, lex: lex, home: home, closures: closures)
  })
}

fn proof_verdict(end: ProofState, head_text: String) -> EditProof {
  if end.stuck != "" {
    EditUnobserved { detail: end.stuck }
  } else if !end.done {
    EditUnobserved { detail: "the sweep did not converge within 4 rounds" }
  } else if end.text == head_text {
    EditProven { rounds: end.rounds }
  } else {
    EditNotGenerated { detail: "head differs from the generator's recomputation from base" }
  }
}

fn edit_proof(evidence: ModuleEvidence, prepared: PreparedGrammar, lex: PreparedLexRules, home: String) -> EditProof {
  if !evidence.readable {
    EditUnobserved { detail: "the base or head text of the module could not be read" }
  } else if evidence.base_text == evidence.head_text {
    EditProven { rounds: [] }
  } else {
    proof_verdict(end: recompute_wave_text(path: evidence.module, base_text: evidence.base_text, prepared: prepared, lex: lex, home: home), head_text: evidence.head_text)
  }
}

// ---------------------------------------------------------------------------------------------------
// POSITIONS: a census locus is `<line>:<byte column>`, 1-based, in the side's own text.

type LineScan {
  next: Int
  starts: List<Int>
}

fn line_scan_starts(scan: LineScan) -> List<Int> {
  scan.starts
}

fn line_starts(text: String) -> List<Int> {
  line_scan_starts(scan: fold_list(xs: bytes_octets(b: utf8_encode_bytes(s: text)), empty: LineScan { next: 0, starts: [0] }, cons: fn(acc, o) {
    if o == 10 {
      LineScan { next: acc.next + 1, starts: list_snoc_item(xs: acc.starts, item: acc.next + 1) }
    } else {
      LineScan { next: acc.next + 1, starts: acc.starts }
    }
  }))
}

fn offset_at(starts: List<Int>, line: Int, column: Int) -> Int {
  match list_at_optional(xs: starts, index: line - 1) {
    Present { value: s } => s + column - 1
    Absent => 0 - 1
  }
}

fn locus_at(starts: List<Int>, offset: Int) -> String {
  let before = starts |> filter(s => s <= offset)
  match last(before) {
    Present { value: s } => to_string(count(before)) + ":" + to_string(offset - s + 1)
    Absent => "-"
  }
}

type MappedOffset
  = OffsetMapped { offset: Int }
  | OffsetRenamed { offset: Int, from: String, to: String }
  | OffsetCovered

fn step_covers(step: EditStep, offset: Int) -> Bool {
  (step.start <= offset) && (offset < step.end)
}

fn step_shift(acc: Int, step: EditStep) -> Int {
  acc + step.new_len - (step.end - step.start)
}

fn map_through_round(steps: List<EditStep>, offset: Int) -> MappedOffset {
  let covering = steps |> filter(s => step_covers(step: s, offset: offset))
  let shifted = offset + fold(steps |> filter(s => s.end <= offset), init: 0, f: fn(a, s) { step_shift(acc: a, step: s) })
  if count(covering) == 0 {
    OffsetMapped { offset: shifted }
  } else if count(covering) == 1 {
    match first(covering) {
      Present { value: s } => if (s.start == offset) && (s.replaced != "") { OffsetRenamed { offset: shifted, from: s.replaced, to: s.replacement } } else { OffsetCovered }
      Absent => OffsetCovered
    }
  } else {
    OffsetCovered
  }
}

fn map_through_rounds(rounds: List<List<EditStep>>, offset: Int) -> MappedOffset {
  fold(rounds, init: OffsetMapped { offset: offset }, f: fn(acc, steps) {
    match acc {
      OffsetCovered => OffsetCovered
      OffsetMapped { offset: o } => map_through_round(steps: steps, offset: o)
      // A renamed occurrence is carried through later rounds by position; a second rename of it is not one edit's fact.
      OffsetRenamed { offset: o, from: f, to: t } =>
        match map_through_round(steps: steps, offset: o) {
          OffsetMapped { offset: m } => OffsetRenamed { offset: m, from: f, to: t }
          OffsetRenamed { offset: _, from: _, to: _ } => OffsetCovered
          OffsetCovered => OffsetCovered
        }
    }
  })
}

// ---------------------------------------------------------------------------------------------------
// ENTRIES.

fn join_row_lines(stdout: String) -> List<String> {
  split(s: stdout, delimiter: "\n")
    |> filter(l => starts_with(s: l, prefix: "binding\t") || starts_with(s: l, prefix: "binding_partial\t") || starts_with(s: l, prefix: "binding_unbound\t"))
}

// A side's occurrence rows grouped by module, each module's rows in print order.
fn rows_by_module(stdout: String) -> Map<String, List<String>> {
  fold(join_row_lines(stdout: stdout), init: empty_map(), f: fn(m, l) {
    let key = join_field(line: l, index: 1)
    match map_get(m, key) {
      Present { value: xs } => map_insert(m, key, list_snoc_item(xs: xs, item: l))
      Absent => map_insert(m, key, [l])
    }
  })
}

type RowCounts {
  counts: Map<String, Int>
  ok: Bool
}

fn row_counts(rows: List<String>) -> Map<String, Int> {
  fold(rows, init: empty_map(), f: fn(m, r) {
    match map_get(m, r) {
      Present { value: n } => map_insert(m, r, n + 1)
      Absent => map_insert(m, r, 1)
    }
  })
}

// THE CENSUS PRINTS A MODULE'S ROWS IN A DIFFERENT ORDER FROM RUN TO RUN (measured: 1070 of 1331 modules differ between
// two runs of the same tree only by row order), so "the same rows" is multiset equality, never print-order equality.
// Equal lengths and no head row without a base row left to take it are together equality.
fn row_count_of(counts: Map<String, Int>, row: String) -> Int {
  match map_get(counts, row) {
    Present { value: n } => n
    Absent => 0
  }
}

fn rows_multiset_equal(base_rows: List<String>, head_rows: List<String>) -> Bool {
  if length(xs: base_rows) != length(xs: head_rows) {
    false
  } else {
    fold(head_rows, init: RowCounts { counts: row_counts(rows: base_rows), ok: true }, f: fn(acc, r) {
      match map_get(acc.counts, r) {
        Present { value: n } => RowCounts { counts: map_insert(acc.counts, r, n - 1), ok: acc.ok && (n > 0) }
        Absent => RowCounts { counts: acc.counts, ok: false }
      }
    }).ok
  }
}

fn module_rows(grouped: Map<String, List<String>>, module: String) -> List<String> {
  match map_get(grouped, module) {
    Present { value: xs } => xs
    Absent => []
  }
}

fn join_entry_row(l: String) -> JoinEntry {
  if starts_with(s: l, prefix: "binding_unbound\t") {
    JoinEntry { module: join_field(line: l, index: 1), spelling: join_field(line: l, index: 2), locus: read_join_locus(text: join_field(line: l, index: 3)), source: "unbound", target: "-" }
  } else {
    JoinEntry { module: join_field(line: l, index: 1), spelling: join_field(line: l, index: 2), locus: read_join_locus(text: join_field(line: l, index: 6)), source: join_field(line: l, index: 4), target: join_field(line: l, index: 5) }
  }
}

fn join_located(e: JoinEntry) -> Bool {
  match e.locus {
    LocusAt { line: _, column: _ } => true
    LocusAbsent => false
    LocusMalformed { text: _ } => false
  }
}

fn join_absent(e: JoinEntry) -> Bool {
  match e.locus {
    LocusAt { line: _, column: _ } => false
    LocusAbsent => true
    LocusMalformed { text: _ } => false
  }
}

fn join_locus_text(e: JoinEntry) -> String {
  match e.locus {
    LocusAt { line: l, column: c } => to_string(l) + ":" + to_string(c)
    LocusAbsent => "-"
    LocusMalformed { text: t } => t
  }
}

fn join_locus_line(e: JoinEntry) -> Int {
  match e.locus {
    LocusAt { line: l, column: _ } => l
    LocusAbsent => 0 - 1
    LocusMalformed { text: _ } => 0 - 1
  }
}

fn join_locus_column(e: JoinEntry) -> Int {
  match e.locus {
    LocusAt { line: _, column: c } => c
    LocusAbsent => 0 - 1
    LocusMalformed { text: _ } => 0 - 1
  }
}

// A locus that is neither a coordinate nor `-` is refused, never read as a position or as generated.
fn join_malformed(entries: List<JoinEntry>, module: String, side: String) -> List<JoinDelta> {
  entries
    |> filter(e => !join_located(e: e) && !join_absent(e: e))
    |> map(e => JoinRefused { cause: "MalformedLocus", coordinate: module + " " + e.spelling + " @" + side + " " + join_locus_text(e: e), detail: e.source + " " + e.target })
}

fn join_site_key(e: JoinEntry) -> String {
  e.spelling + " @" + join_locus_text(e: e)
}

fn join_leaf(spelling: String) -> String {
  match last(split(s: spelling, delimiter: ".")) {
    Present { value: l } => l
    Absent => spelling
  }
}

fn join_row_renames(r: AmbientNameHome) -> Bool {
  match r.authored_on_head {
    Present { value: _ } => true
    Absent => false
  }
}

fn join_row_head_spelling(r: AmbientNameHome) -> String {
  match r.authored_on_head {
    Present { value: h } => h as String
    Absent => r.name as String
  }
}

// The row that moves `spelling` WITHOUT renaming it. A renaming row never admits a same-spelling re-binding.
fn join_home_for(rows: List<AmbientNameHome>, spelling: String) -> Optional<String> {
  match first(rows |> filter(r => ((r.name as String) == join_leaf(spelling: spelling)) && !join_row_renames(r: r))) {
    Present { value: r } => Present { value: r.home as String }
    Absent => Absent
  }
}

fn join_unhomed(before: JoinEntry, after: JoinEntry) -> String {
  before.source + " " + before.target + " -> " + after.source + " " + after.target
}

fn join_pair(rows: List<AmbientNameHome>, coordinate: String, before: JoinEntry, after: JoinEntry) -> Optional<JoinDelta> {
  if (before.source == after.source) && (before.target == after.target) {
    Absent
  } else {
    match join_home_for(rows: rows, spelling: before.spelling) {
      Present { value: home } =>
        if ((before.source == "unbound") || starts_with(s: before.source, prefix: "ambient:")) && (after.source == "declared") && (after.target == home) {
          Present { value: JoinAdmitted { coordinate: coordinate, spelling: before.spelling, home: home } }
        } else {
          Present { value: JoinRefused { cause: "TargetChanged", coordinate: coordinate, detail: join_unhomed(before: before, after: after) } }
        }
      Absent => Present { value: JoinRefused { cause: "TargetChanged", coordinate: coordinate, detail: join_unhomed(before: before, after: after) } }
    }
  }
}

// THE RENAME ARM (tidy-ant-251's ruling on the map_get wave). A base occurrence the generator's own rename edit carried
// (OffsetRenamed: one replacement step starting at it whose `replaced` is the occurrence's spelling) pairs with the head
// occurrence of the replacement spelling at the carried position. It is admitted only when a row renames exactly this
// spelling to exactly that replacement, the base occurrence was bound by the primitive-authority table, and the head one
// binds the row's home as a declaration. Anything else refuses: RenameUnruled (no row renames from -> to),
// RenameTargetChanged (the binding is not ambient primitive authority -> the home), Vanished (no head occurrence there).
fn join_rename_row(rows: List<AmbientNameHome>, from: String, to: String) -> Optional<AmbientNameHome> {
  first(rows |> filter(r => join_row_renames(r: r) && ((r.name as String) == from) && (join_row_head_spelling(r: r) == to)))
}

fn join_respelled(spelling: String, to: String) -> String {
  let parts = split(s: spelling, delimiter: ".")
  if count(parts) <= 1 { to } else { join(list_init(xs: parts), separator: ".") + "." + to }
}

fn join_rename_pair(rows: List<AmbientNameHome>, coordinate: String, before: JoinEntry, after: JoinEntry, from: String, to: String) -> JoinDelta {
  match join_rename_row(rows: rows, from: from, to: to) {
    Absent => JoinRefused { cause: "RenameUnruled", coordinate: coordinate, detail: from + " -> " + to }
    Present { value: r } =>
      if (before.source == "ambient:primitive_authority") && (after.source == "declared") && (after.target == (r.home as String)) {
        JoinAdmitted { coordinate: coordinate, spelling: before.spelling, home: r.home as String }
      } else {
        JoinRefused { cause: "RenameTargetChanged", coordinate: coordinate, detail: join_unhomed(before: before, after: after) }
      }
  }
}

// AN OCCURRENCE A RENAMING ROW SHOULD HAVE MOVED BUT DID NOT: still the old spelling, bound by the primitive-authority
// table on base, and carried by position (no rename edit at it). The wave left one of its own call sites behind, which a
// per-occurrence diff must refuse rather than read as unchanged. Spellings the generator does not select -- a method
// `x.map_get`, a parameter, another module's declaration -- are bound otherwise on base, so they are untouched here.
fn join_rename_left_behind(rows: List<AmbientNameHome>, before: JoinEntry) -> Bool {
  (before.source == "ambient:primitive_authority")
    && (count(rows |> filter(r => join_row_renames(r: r) && ((r.name as String) == join_leaf(spelling: before.spelling)))) != 0)
}

type BaseStep {
  delta: Optional<JoinDelta>
  claimed: Optional<String>
}

fn base_step(rows: List<AmbientNameHome>, module: String, b: JoinEntry, head_index: Map<String, JoinEntry>, base_starts: List<Int>, head_starts: List<Int>, rounds: List<List<EditStep>>) -> BaseStep {
  let coordinate = module + " " + join_site_key(e: b)
  let o = offset_at(starts: base_starts, line: join_locus_line(e: b), column: join_locus_column(e: b))
  if o < 0 {
    BaseStep { delta: Present { value: JoinUnobserved { coordinate: coordinate, detail: "the census locus lies outside the base text" } }, claimed: Absent }
  } else {
    match map_through_rounds(rounds: rounds, offset: o) {
      OffsetCovered => BaseStep { delta: Present { value: JoinRefused { cause: "EditCoversOccurrence", coordinate: coordinate, detail: "an edit extent contains the occurrence" } }, claimed: Absent }
      OffsetMapped { offset: m } =>
        let key = b.spelling + " @" + locus_at(starts: head_starts, offset: m)
        match map_get(head_index, key) {
          Absent => BaseStep { delta: Present { value: JoinRefused { cause: "Vanished", coordinate: coordinate, detail: b.source + " " + b.target } }, claimed: Absent }
          Present { value: a } =>
            if join_rename_left_behind(rows: rows, before: b) {
              BaseStep { delta: Present { value: JoinRefused { cause: "RenameIncomplete", coordinate: coordinate, detail: b.source + " " + b.target } }, claimed: Present { value: key } }
            } else {
              BaseStep { delta: join_pair(rows: rows, coordinate: coordinate, before: b, after: a), claimed: Present { value: key } }
            }
        }
      OffsetRenamed { offset: m, from: f, to: t } =>
        if f != join_leaf(spelling: b.spelling) {
          BaseStep { delta: Present { value: JoinRefused { cause: "EditCoversOccurrence", coordinate: coordinate, detail: "a replacement starts at the occurrence but does not replace its spelling" } }, claimed: Absent }
        } else {
          let key = join_respelled(spelling: b.spelling, to: t) + " @" + locus_at(starts: head_starts, offset: m)
          match map_get(head_index, key) {
            Absent => BaseStep { delta: Present { value: JoinRefused { cause: "Vanished", coordinate: coordinate, detail: b.source + " " + b.target + " renamed to " + t } }, claimed: Absent }
            Present { value: a } => BaseStep { delta: Present { value: join_rename_pair(rows: rows, coordinate: coordinate, before: b, after: a, from: f, to: t) }, claimed: Present { value: key } }
          }
        }
    }
  }
}

fn present_deltas(steps: List<BaseStep>) -> List<JoinDelta> {
  fold(steps, init: [], f: fn(acc, s) {
    match s.delta {
      Present { value: d } => list_snoc_item(xs: acc, item: d)
      Absent => acc
    }
  })
}

fn claimed_set(steps: List<BaseStep>) -> Map<String, Bool> {
  fold(steps, init: empty_map(), f: fn(m, s) {
    match s.claimed {
      Present { value: k } => map_insert(m, k, true)
      Absent => m
    }
  })
}

fn site_key_counts(entries: List<JoinEntry>) -> Map<String, Int> {
  fold(entries, init: empty_map(), f: fn(m, e) {
    let k = join_site_key(e: e)
    match map_get(m, k) {
      Present { value: n } => map_insert(m, k, n + 1)
      Absent => map_insert(m, k, 1)
    }
  })
}

fn duplicate_sites(entries: List<JoinEntry>, side: String) -> List<JoinDelta> {
  let counts = site_key_counts(entries: entries)
  map_keys(counts)
    |> filter(k => match map_get(counts, k) { Present { value: n } => n > 1  Absent => false })
    |> map(k => JoinRefused { cause: "Collided", coordinate: k, detail: side })
}

// Generated rows (locus `-`): a multiset of (spelling, source, target), admitted only on exact equality.
fn join_generated_key(e: JoinEntry) -> String {
  e.module + " " + e.spelling + " " + e.source + " " + e.target
}

fn join_generated_multiset(base: List<JoinEntry>, head: List<JoinEntry>) -> List<JoinDelta> {
  let keys = map_keys(fold(base + head, init: empty_map(), f: fn(m, e) { map_insert(m, join_generated_key(e: e), true) }))
  let base_counts = row_counts(rows: base |> map(e => join_generated_key(e: e)))
  let head_counts = row_counts(rows: head |> map(e => join_generated_key(e: e)))
  keys |> fold(init: [], f: fn(acc, k) {
    let b = row_count_of(counts: base_counts, row: k)
    let h = row_count_of(counts: head_counts, row: k)
    if b == h { acc } else { list_snoc_item(xs: acc, item: JoinRefused { cause: "GeneratedChanged", coordinate: k, detail: "base " + to_string(b) + " head " + to_string(h) }) }
  })
}

fn occurrence_join_proven(rows: List<AmbientNameHome>, module: String, base: List<JoinEntry>, head: List<JoinEntry>, base_text: String, head_text: String, rounds: List<List<EditStep>>) -> List<JoinDelta> {
  let base_located = base |> filter(e => join_located(e: e))
  let head_located = head |> filter(e => join_located(e: e))
  let head_index = fold(head_located, init: empty_map(), f: fn(m, e) { map_insert(m, join_site_key(e: e), e) })
  let base_starts = line_starts(text: base_text)
  let head_starts = line_starts(text: head_text)
  let steps = base_located |> map(b => base_step(rows: rows, module: module, b: b, head_index: head_index, base_starts: base_starts, head_starts: head_starts, rounds: rounds))
  let claimed = claimed_set(steps: steps)
  let appeared = head_located
    |> filter(h => match map_get(claimed, join_site_key(e: h)) { Present { value: _ } => false  Absent => true })
    |> map(h => JoinRefused { cause: "Appeared", coordinate: module + " " + h.spelling + " @head " + join_locus_text(e: h), detail: h.source + " " + h.target })
  present_deltas(steps: steps)
    + appeared
    + duplicate_sites(entries: base_located, side: "base")
    + duplicate_sites(entries: head_located, side: "head")
    + join_generated_multiset(base: base |> filter(e => join_absent(e: e)), head: head |> filter(e => join_absent(e: e)))
    + join_malformed(entries: base, module: module, side: "base")
    + join_malformed(entries: head, module: module, side: "head")
}

// ONE MODULE, BOTH SIDES. Identical rows are no change and need no proof; otherwise the edit proof decides what the
// positions mean, and nothing is joined without it.
fn occurrence_join_module(rows: List<AmbientNameHome>, module: String, base_rows: List<String>, head_rows: List<String>, evidence: Optional<ModuleEvidence>, prepared: PreparedGrammar, lex: PreparedLexRules, home: String) -> List<JoinDelta> {
  if rows_multiset_equal(base_rows: base_rows, head_rows: head_rows) {
    []
  } else {
    match evidence {
      Absent => [JoinUnobserved { coordinate: module, detail: "no base/head text evidence for a module whose rows changed" }]
      Present { value: ev } => occurrence_join_with_proof(rows: rows, module: module, base_rows: base_rows, head_rows: head_rows, evidence: ev, proof: edit_proof(evidence: ev, prepared: prepared, lex: lex, home: home))
    }
  }
}

fn occurrence_join_with_proof(rows: List<AmbientNameHome>, module: String, base_rows: List<String>, head_rows: List<String>, evidence: ModuleEvidence, proof: EditProof) -> List<JoinDelta> {
  match proof {
    EditUnobserved { detail: d } => [JoinUnobserved { coordinate: module, detail: d }]
    EditNotGenerated { detail: d } => [JoinRefused { cause: "EditsNotGenerated", coordinate: module, detail: d }]
    EditProven { rounds: r } => occurrence_join_proven(rows: rows, module: module, base: base_rows |> map(l => join_entry_row(l: l)), head: head_rows |> map(l => join_entry_row(l: l)), base_text: evidence.base_text, head_text: evidence.head_text, rounds: r)
  }
}

fn join_delta_line(d: JoinDelta) -> String {
  match d {
    JoinAdmitted { coordinate: c, spelling: _, home: h } => "admitted\tUnboundToDeclaredHome\t" + c + "\t" + h
    JoinRefused { cause: k, coordinate: c, detail: t } => "refused\t" + k + "\t" + c + "\t" + t
    JoinUnobserved { coordinate: c, detail: t } => "unobserved_join\t" + c + "\t" + t
  }
}

fn join_delta_admitted(d: JoinDelta) -> Bool {
  match d {
    JoinAdmitted { coordinate: _, spelling: _, home: _ } => true
    JoinRefused { cause: _, coordinate: _, detail: _ } => false
    JoinUnobserved { coordinate: _, detail: _ } => false
  }
}

fn join_delta_unobserved(d: JoinDelta) -> Bool {
  match d {
    JoinAdmitted { coordinate: _, spelling: _, home: _ } => false
    JoinRefused { cause: _, coordinate: _, detail: _ } => false
    JoinUnobserved { coordinate: _, detail: _ } => true
  }
}

// ---------------------------------------------------------------------------------------------------
// THE CONTROLS, at the join's own interface with supplied texts and rows. Each head TEXT is the generator's own
// recomputation of the base text (so the proof holds), and every census row is derived from a text's own `chars(` sites,
// so no locus is typed by hand. The inhabitance claim -- that the real census prints rows of exactly this shape for these
// texts -- is the real-route wave fixture in gunbc.instruments.namespace_wave_binding_diff.
//   admit              every site binds the home at its carried position: nothing refused;
//   relocated          one same-line site is bound one column away from where the edit map puts it: equal counts on both
//                      sides, but no head occurrence at the mapped position (Vanished) and one unclaimed (Appeared);
//   wrong home         the second of two sites on one line binds another declaration: TargetChanged;
//   generated equal    a generated row present on both sides: admitted as a multiset;
//   generated differs  a generated row on one side only: GeneratedChanged;
//   deleted extent     an edit step that deletes the function holding a list literal (its generated head): GeneratedChanged;
//   covered            an edit step whose extent contains an occurrence: EditCoversOccurrence;
//   not generated      a head that is not the recomputation: EditsNotGenerated; unreadable texts: Unobserved.

// THE GENERATOR'S SCOPE FOR A WAVE, read off the ruled home row (`std.host_text.chars` -> `std.host_text`), so the
// edit proof recomputes against the same fact the join resolves against. The first row's home; a roster of several
// homes needs a per-row scope (declared frontier, trigger: wave 2 adds a row with another home).
fn rows_proof_scope(rows: List<AmbientNameHome>) -> String {
  match list_at_optional(xs: rows, index: 0) {
    Present { value: row } => join(list_init(xs: split(s: row.home as String, delimiter: ".")), separator: ".")
    Absent => ""
  }
}

fn join_control_rows() -> List<AmbientNameHome> {
  [AmbientNameHome { name: "chars", home: "std.host_text.chars", table: PrimitiveAuthorityTable, origin: ExistingDeclaration, authored_on_head: Absent }]
}

fn join_control_base_text() -> String {
  "module examples.m\n\nimport std.types { Int }\n\nfn a() -> Int {\n  first(x: chars(s: \"1\"))\n}\n\nfn b() -> Int {\n  pair(a: chars(s: \"a\"), b: chars(s: \"b\"))\n}\n"
}

// The 1-based columns at which `needle` starts on one line.
type SiteScan {
  pos: Int
  cols: List<Int>
}

fn site_scan_cols(scan: SiteScan) -> List<Int> {
  scan.cols
}

fn line_site_columns(line: String, needle: String) -> List<Int> {
  let parts = split(s: line, delimiter: needle)
  site_scan_cols(scan: fold(parts, init: SiteScan { pos: 0, cols: [] }, f: fn(acc, p) {
    if acc.pos == 0 {
      SiteScan { pos: string_length(s: p), cols: [] }
    } else {
      SiteScan { pos: acc.pos + string_length(s: needle) + string_length(s: p), cols: list_snoc_item(xs: acc.cols, item: acc.pos + 1) }
    }
  }))
}

// Every `needle` site of a text as `<line>:<column>`, in order.
fn text_sites(text: String, needle: String) -> List<String> {
  let lines = split(s: text, delimiter: "\n")
  site_sites_loci(s: fold(lines, init: SiteSites { line: 1, loci: [] }, f: fn(acc, l) {
    SiteSites { line: acc.line + 1, loci: acc.loci + (line_site_columns(line: l, needle: needle) |> map(c => to_string(acc.line) + ":" + to_string(c))) }
  }))
}

type SiteSites {
  line: Int
  loci: List<String>
}

fn site_sites_loci(s: SiteSites) -> List<String> {
  s.loci
}

fn join_control_base_rows() -> List<String> {
  text_sites(text: join_control_base_text(), needle: "chars(") |> map(locus => "binding_unbound\tm\tchars\t" + locus)
}

// The locus one column to the right, read through the one reader (a locus that does not read is returned as it was).
fn join_shifted_locus(locus: String) -> String {
  match read_join_locus(text: locus) {
    LocusAt { line: l, column: c } => to_string(l) + ":" + to_string(c + 1)
    LocusAbsent => locus
    LocusMalformed { text: _ } => locus
  }
}

// Head rows from the head's own sites; `target_for(i)` chooses each site's target, `shift_for(i)` its column shift.
fn join_control_head_rows(head_text: String, wrong_index: Int, shifted_index: Int) -> List<String> {
  let loci = text_sites(text: head_text, needle: "chars(")
  head_rows_rows(h: fold(loci, init: HeadRows { index: 0, rows: [] }, f: fn(acc, locus) {
    let target = if acc.index == wrong_index { "examples.elsewhere.chars" } else { "std.host_text.chars" }
    let at = if acc.index == shifted_index { join_shifted_locus(locus: locus) } else { locus }
    HeadRows { index: acc.index + 1, rows: list_snoc_item(xs: acc.rows, item: "binding_partial\tm\tchars\t" + to_string(acc.index) + "\tdeclared\t" + target + "\t" + at) }
  }))
}

type HeadRows {
  index: Int
  rows: List<String>
}

fn head_rows_rows(h: HeadRows) -> List<String> {
  h.rows
}

fn join_control_case(name: String, base_rows: List<String>, head_rows: List<String>, evidence: ModuleEvidence, prepared: PreparedGrammar, lex: PreparedLexRules, want_admitted: Int, want_refused: List<String>) -> String {
  let deltas = occurrence_join_module(rows: join_control_rows(), module: "m", base_rows: base_rows, head_rows: head_rows, evidence: Present { value: evidence }, prepared: prepared, lex: lex, home: rows_proof_scope(rows: join_control_rows()))
  join_control_verdict(name: name, deltas: deltas, want_admitted: want_admitted, want_refused: want_refused)
}

fn join_control_verdict(name: String, deltas: List<JoinDelta>, want_admitted: Int, want_refused: List<String>) -> String {
  let admitted = count(deltas |> filter(d => join_delta_admitted(d: d)))
  let refused = deltas |> filter(d => !join_delta_admitted(d: d)) |> map(d => match d { JoinRefused { cause: k, coordinate: _, detail: _ } => k  JoinUnobserved { coordinate: _, detail: _ } => "Unobserved"  JoinAdmitted { coordinate: _, spelling: _, home: _ } => "" })
  if (admitted == want_admitted) && (count(refused) == count(want_refused)) && (count(want_refused |> filter(w => count(refused |> filter(r => r == w)) != count(want_refused |> filter(x => x == w)))) == 0) {
    ""
  } else {
    "occurrence-join control " + name + ": admitted " + to_string(admitted) + ", refused [" + join(refused, separator: ",") + "]; want " + to_string(want_admitted) + " and [" + join(want_refused, separator: ",") + "]\n"
  }
}

fn occurrence_join_controls_failure(prepared: PreparedGrammar, lex: PreparedLexRules) -> Optional<String> {
  let base_text = join_control_base_text()
  let generated = recompute_wave_text(path: "m", base_text: base_text, prepared: prepared, lex: lex, home: rows_proof_scope(rows: join_control_rows()))
  let head_text = generated.text
  let evidence = ModuleEvidence { module: "m", base_text: base_text, head_text: head_text, readable: true }
  let base_rows = join_control_base_rows()
  let site_count = count(base_rows)
  if (site_count != 3) || (head_text == base_text) || (!generated.done) {
    Present { value: "occurrence-join control fixture: " + to_string(site_count) + " base sites, generator " + (if generated.done { "converged" } else { "stuck: " + generated.stuck }) + (if head_text == base_text { ", no edits made" } else { "" }) + "\n" }
  } else {
    let admit_rows = join_control_head_rows(head_text: head_text, wrong_index: 0 - 1, shifted_index: 0 - 1)
    let report = join_control_case(name: "admit", base_rows: base_rows, head_rows: admit_rows, evidence: evidence, prepared: prepared, lex: lex, want_admitted: 3, want_refused: [])
      + join_control_case(name: "equal-count-relocated-same-line-site", base_rows: base_rows, head_rows: join_control_head_rows(head_text: head_text, wrong_index: 0 - 1, shifted_index: 2), evidence: evidence, prepared: prepared, lex: lex, want_admitted: 2, want_refused: ["Appeared", "Vanished"])
      + join_control_case(name: "equal-count-wrong-home-same-line-site", base_rows: base_rows, head_rows: join_control_head_rows(head_text: head_text, wrong_index: 2, shifted_index: 0 - 1), evidence: evidence, prepared: prepared, lex: lex, want_admitted: 2, want_refused: ["TargetChanged"])
      + join_control_case(name: "head is not the recomputation", base_rows: base_rows, head_rows: admit_rows, evidence: ModuleEvidence { module: "m", base_text: base_text, head_text: head_text + "\n", readable: true }, prepared: prepared, lex: lex, want_admitted: 0, want_refused: ["EditsNotGenerated"])
      + join_control_case(name: "unreadable text", base_rows: base_rows, head_rows: admit_rows, evidence: ModuleEvidence { module: "m", base_text: "", head_text: "", readable: false }, prepared: prepared, lex: lex, want_admitted: 0, want_refused: ["Unobserved"])
      + join_control_case(name: "same rows in another print order (no change)", base_rows: base_rows, head_rows: list_reverse(xs: base_rows), evidence: evidence, prepared: prepared, lex: lex, want_admitted: 0, want_refused: [])
      + join_control_case(name: "malformed locus", base_rows: base_rows, head_rows: list_snoc_item(xs: admit_rows, item: "binding_partial\tm\tchars\t9\tdeclared\tstd.host_text.chars\t3:x"), evidence: evidence, prepared: prepared, lex: lex, want_admitted: 3, want_refused: ["MalformedLocus"])
      + generated_controls()
      + rename_controls()
    if report == "" { Absent } else { Present { value: report } }
  }
}

// GENERATED ROWS AND DELETION EXTENTS, at the proof-free core with a supplied proof (the generator makes no deletion,
// so a deletion step can only be supplied). The generated row stands for a list literal's generated head.
fn generated_row() -> String {
  "binding_partial\tm\tstd.algebra.FreeMonoid\t0\tgenerated\tstd.algebra.FreeMonoid\t-"
}

fn generated_controls() -> String {
  let text = "module m\n\nfn lit() -> List<Int> {\n  [1]\n}\n"
  let evidence = ModuleEvidence { module: "m", base_text: text, head_text: "module m\n", readable: true }
  let deleted = EditProven { rounds: [[EditStep { start: 10, end: text_byte_length(text: text), new_len: 0, replaced: "", replacement: "" }]] }
  let same = EditProven { rounds: [] }
  join_control_verdict(name: "generated rows equal", deltas: occurrence_join_with_proof(rows: join_control_rows(), module: "m", base_rows: [generated_row()], head_rows: [generated_row(), "binding_partial\tm\tInt\t0\tambient:kernel_type_spelling\tkernel:dag_binding_type_int\t-"], evidence: evidence, proof: same), want_admitted: 0, want_refused: ["GeneratedChanged"])
    + join_control_verdict(name: "generated rows identical multiset", deltas: occurrence_join_with_proof(rows: join_control_rows(), module: "m", base_rows: [generated_row(), generated_row()], head_rows: [generated_row(), generated_row()], evidence: evidence, proof: same), want_admitted: 0, want_refused: [])
    + join_control_verdict(name: "deleted extent holding a list literal", deltas: occurrence_join_with_proof(rows: join_control_rows(), module: "m", base_rows: [generated_row()], head_rows: [], evidence: evidence, proof: deleted), want_admitted: 0, want_refused: ["GeneratedChanged"])
    + join_control_verdict(name: "extent covers an occurrence", deltas: occurrence_join_with_proof(rows: join_control_rows(), module: "m", base_rows: ["binding_unbound\tm\tchars\t4:3"], head_rows: [], evidence: evidence, proof: EditProven { rounds: [[EditStep { start: 0, end: text_byte_length(text: text), new_len: 1, replaced: "", replacement: "" }]] }), want_admitted: 0, want_refused: ["EditCoversOccurrence"])
}

// ---------------------------------------------------------------------------------------------------
// THE RENAME ARM'S CONTROLS (tidy-ant-251 and sunny-bee-153's conditions on the map_get wave), at the proof-free core
// with a SUPPLIED proof: the rename step is the one the generator's RenameHead row plans (the head atom `map_get`
// replaced by `map_lookup`, then a zero-width `m: ` / `key: ` before each positional argument), and the head text is that
// proof applied to the base text, so every locus is read off a text, never typed. The real route -- the generator
// planning exactly these steps -- is v2.workflow.roster_import_sweep roster_rename_controls.
fn rename_rows() -> List<AmbientNameHome> {
  [AmbientNameHome { name: "map_get", home: "std.algebra.map_lookup", table: PrimitiveAuthorityTable, origin: ExistingDeclaration, authored_on_head: Present { value: "map_lookup" } }]
}

fn rename_unruled_rows() -> List<AmbientNameHome> {
  [AmbientNameHome { name: "map_get", home: "std.algebra.map_lookup", table: PrimitiveAuthorityTable, origin: ExistingDeclaration, authored_on_head: Absent }]
}

// One call `map_get(A, B)` at byte `o`: the head replacement and the two positional labels, in byte order.
fn rename_call_steps(text: String, o: Int) -> List<EditStep> {
  let open = o + string_length(s: "map_get(")
  let comma = open + string_length(s: first_arg(text: text, from: open))
  [
    EditStep { start: o, end: o + 7, new_len: 10, replaced: "map_get", replacement: "map_lookup" },
    EditStep { start: open, end: open, new_len: 3, replaced: "", replacement: "m: " },
    EditStep { start: comma + 2, end: comma + 2, new_len: 5, replaced: "", replacement: "key: " }
  ]
}

fn first_arg(text: String, from: Int) -> String {
  match first(split(s: substring(s: text, start: from, end: string_length(s: text)), delimiter: ",")) {
    Present { value: a } => a
    Absent => ""
  }
}

// The steps applied last-first (ASCII: byte offsets are character offsets).
fn rename_apply(text: String, steps: List<EditStep>) -> String {
  fold(list_reverse(xs: steps), init: text, f: fn(t, st) {
    substring(s: t, start: 0, end: st.start) + st.replacement + substring(s: t, start: st.end, end: string_length(s: t))
  })
}

fn rename_row(spelling: String, source: String, target: String, starts: List<Int>, offset: Int) -> String {
  "binding_partial\tm\t" + spelling + "\t0\t" + source + "\t" + target + "\t" + locus_at(starts: starts, offset: offset)
}

fn rename_case(name: String, rows: List<AmbientNameHome>, base_text: String, base_rows: List<String>, head_text: String, head_rows: List<String>, steps: List<EditStep>, want_admitted: Int, want_refused: List<String>) -> String {
  let evidence = ModuleEvidence { module: "m", base_text: base_text, head_text: head_text, readable: true }
  join_control_verdict(name: name, deltas: occurrence_join_with_proof(rows: rows, module: "m", base_rows: base_rows, head_rows: head_rows, evidence: evidence, proof: EditProven { rounds: [steps] }), want_admitted: want_admitted, want_refused: want_refused)
}

fn rename_ambient(starts: List<Int>, o: Int) -> String {
  rename_row(spelling: "map_get", source: "ambient:primitive_authority", target: "std.primitives.map_get_contract", starts: starts, offset: o)
}

fn rename_declared(starts: List<Int>, o: Int, target: String) -> String {
  rename_row(spelling: "map_lookup", source: "declared", target: target, starts: starts, offset: o)
}

fn rename_controls() -> String {
  // ONE CALL.
  let one = "module m\n\nfn f(m: Map<String, String>, k: String) -> Optional<String> {\n  map_get(m, k)\n}\n"
  let o1 = string_length(s: "module m\n\nfn f(m: Map<String, String>, k: String) -> Optional<String> {\n  ")
  let s1 = rename_call_steps(text: one, o: o1)
  let one_head = rename_apply(text: one, steps: s1)
  let b1 = line_starts(text: one)
  let h1 = line_starts(text: one_head)
  let base1 = [rename_ambient(starts: b1, o: o1)]
  let head1 = [rename_declared(starts: h1, o: o1, target: "std.algebra.map_lookup")]
  // TWO CALLS ON ONE LINE: the second call's head offset moves by the first call's three steps.
  let two = "module m\n\nfn f(m: Map<String, String>, k: String) -> String {\n  g(a: map_get(m, k), b: map_get(m, k))\n}\n"
  let o2a = string_length(s: "module m\n\nfn f(m: Map<String, String>, k: String) -> String {\n  g(a: ")
  let o2b = o2a + string_length(s: "map_get(m, k), b: ")
  let s2 = rename_call_steps(text: two, o: o2a) + rename_call_steps(text: two, o: o2b)
  let two_head = rename_apply(text: two, steps: s2)
  let b2 = line_starts(text: two)
  let h2 = line_starts(text: two_head)
  let shift_a = 3 + 3 + 5
  let base2 = [rename_ambient(starts: b2, o: o2a), rename_ambient(starts: b2, o: o2b)]
  let head2 = [rename_declared(starts: h2, o: o2a, target: "std.algebra.map_lookup"), rename_declared(starts: h2, o: o2b + shift_a, target: "std.algebra.map_lookup")]
  // ONLY THE FIRST OF THE TWO RENAMED: the second is left behind as map_get, still ambient on head.
  let s2_first = rename_call_steps(text: two, o: o2a)
  let partial_head = rename_apply(text: two, steps: s2_first)
  let hp = line_starts(text: partial_head)
  let head_partial = [rename_declared(starts: hp, o: o2a, target: "std.algebra.map_lookup"), rename_ambient(starts: hp, o: o2b + shift_a)]
  // A PRE-EXISTING map_lookup ON BASE, unchanged on head, beside the renamed call.
  let pre = "module m\n\nfn f(m: Map<String, String>, k: String) -> String {\n  g(a: map_lookup(m: m, key: k), b: map_get(m, k))\n}\n"
  let op_lookup = string_length(s: "module m\n\nfn f(m: Map<String, String>, k: String) -> String {\n  g(a: ")
  let op_get = op_lookup + string_length(s: "map_lookup(m: m, key: k), b: ")
  let sp = rename_call_steps(text: pre, o: op_get)
  let pre_head = rename_apply(text: pre, steps: sp)
  let bp = line_starts(text: pre)
  let hpre = line_starts(text: pre_head)
  let base_pre = [rename_declared(starts: bp, o: op_lookup, target: "std.algebra.map_lookup"), rename_ambient(starts: bp, o: op_get)]
  let head_pre = [rename_declared(starts: hpre, o: op_lookup, target: "std.algebra.map_lookup"), rename_declared(starts: hpre, o: op_get, target: "std.algebra.map_lookup")]
  rename_case(name: "rename admits ambient primitive authority -> the row's home", rows: rename_rows(), base_text: one, base_rows: base1, head_text: one_head, head_rows: head1, steps: s1, want_admitted: 1, want_refused: [])
    + rename_case(name: "rename to another home", rows: rename_rows(), base_text: one, base_rows: base1, head_text: one_head, head_rows: [rename_declared(starts: h1, o: o1, target: "examples.elsewhere.map_lookup")], steps: s1, want_admitted: 0, want_refused: ["RenameTargetChanged"])
    + rename_case(name: "rename of an occurrence not bound by primitive authority", rows: rename_rows(), base_text: one, base_rows: [rename_row(spelling: "map_get", source: "declared", target: "examples.m.map_get", starts: b1, offset: o1)], head_text: one_head, head_rows: head1, steps: s1, want_admitted: 0, want_refused: ["RenameTargetChanged"])
    + rename_case(name: "rename no row rules", rows: rename_unruled_rows(), base_text: one, base_rows: base1, head_text: one_head, head_rows: head1, steps: s1, want_admitted: 0, want_refused: ["RenameUnruled"])
    + rename_case(name: "renamed occurrence missing on head", rows: rename_rows(), base_text: one, base_rows: base1, head_text: one_head, head_rows: [], steps: s1, want_admitted: 0, want_refused: ["Vanished"])
    + rename_case(name: "renamed occurrence unlocated on head", rows: rename_rows(), base_text: one, base_rows: base1, head_text: one_head, head_rows: ["binding_partial\tm\tmap_lookup\t0\tdeclared\tstd.algebra.map_lookup\t-"], steps: s1, want_admitted: 0, want_refused: ["Vanished", "GeneratedChanged"])
    + rename_case(name: "REVERT ARM: the same texts without the rename step", rows: rename_rows(), base_text: one, base_rows: base1, head_text: one_head, head_rows: head1, steps: [], want_admitted: 0, want_refused: ["Vanished", "Appeared"])
    + rename_case(name: "two renames on one line", rows: rename_rows(), base_text: two, base_rows: base2, head_text: two_head, head_rows: head2, steps: s2, want_admitted: 2, want_refused: [])
    + rename_case(name: "one of two calls left behind", rows: rename_rows(), base_text: two, base_rows: base2, head_text: partial_head, head_rows: head_partial, steps: s2_first, want_admitted: 1, want_refused: ["RenameIncomplete"])
    + rename_case(name: "a pre-existing map_lookup beside the renamed call", rows: rename_rows(), base_text: pre, base_rows: base_pre, head_text: pre_head, head_rows: head_pre, steps: sp, want_admitted: 1, want_refused: [])
}
