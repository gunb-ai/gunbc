// THE VERIFIED OCCURRENCE JOIN, one path for a module's complete rows and its partial rows. The census prints, per
// occurrence, with its source locus (v2.compiler.source_root_eval native_census_binding_loci / native_census_unbound_lines):
//
//   binding         <module> <spelling> <ordinal> <source> <target> <line>:<col>   an occurrence the walk bound
//   binding_partial <module> <spelling> <ordinal> <source> <target> <line>:<col>   the same, for a module resolve refused
//   binding_unbound <module> <spelling> <line>:<col>                               an occurrence it refused as unbound
//
// THE CORRESPONDENCE IS THE GENERATOR'S OWN EDIT MAP, NOT A GUESS (tidy-ant-251's ruling on PR #14324). A wave's edits
// are those of the roster sweep (v2.workflow.roster_import_sweep roster_sweep_text_scoped): an import inserted and an
// argument label renamed. The join RECOMPUTES them from the module's base text with that pure planning function, applies
// them with the generator's own splice (roster_applied), and requires the result to be BYTE-EQUAL to the head text. A head
// that differs by any other byte is not this wave's rewrite and REFUSES (EditsNotGenerated); a text that cannot be read, or
// that the generator refuses, is UNOBSERVED (exit 2). Only then is an occurrence's head position DEFINED: its base byte
// offset carried through the recorded extents (an edit that ends at or before it shifts it by that edit's length change; an
// extent that contains it refuses), then read back as a head line:column. Every base occurrence must find exactly one head
// occurrence of the same spelling at that position, and every head occurrence must be claimed; a count is never consulted.
//
// A COMPILER-GENERATED REFERENCE (an elided record head, a list literal's generated head) has locus `-` and no authored
// position: the census carries no causing authored locus for it (a named frontier). Under the proven byte-equality the
// edits are import lines and argument labels only, so no construct that causes a generated reference changed, and the
// generated rows are compared as a MULTISET of (spelling, source, target): admitted only on exact equality, and any
// differing triple refuses (GeneratedChanged). Without the proof they would stay unobserved. A deletion extent that
// removes a construct that causes a generated reference changes the multiset and refuses.
//
// ADMITTED: an occurrence unbound or ambient on base whose spelling a home row names, and which binds exactly that row's
// home on head (UnboundToDeclaredHome); and an occurrence that is unchanged. EVERYTHING ELSE REFUSES: TargetChanged,
// Appeared, Vanished, Collided, GeneratedChanged, EditCoversOccurrence, EditsNotGenerated.

type JoinEntry {
  module: String
  spelling: String
  locus: JoinLocus
  source: String
  target: String
}

// A census locus read ONCE (read_join_locus): a valid coordinate, the explicit `-` the census prints when no locus was
// recovered, or text that is neither (refused, never defaulted). Absence proves no provenance: a missing file or span
// index entry prints `-` too, so a generated reference is admitted only under the proven edit recomputation.
type JoinLocus
  = LocusAt { line: Int, column: Int }
  | LocusAbsent
  | LocusMalformed { text: String }

type JoinDelta
  = JoinAdmitted { coordinate: String, spelling: String, home: String }
  | JoinRefused { cause: String, coordinate: String, detail: String }
  | JoinUnobserved { coordinate: String, detail: String }

// THE THREE ANSWERS of the controls run, as a sum — the wire matches on it; nothing reads a report prefix to tell an
// unobserved run from a failed control (review 87079; DESIGN §5 "every degradation is typed, located and countable").
// The fixture's own standing (site count, generator stuck, no edits) answers no observation: JoinControlsUnobserved.
// A per-control verdict is a located control failure: JoinControlsFailed. Both carry their report.
type JoinControlsOutcome
  = JoinControlsHeld
  | JoinControlsFailed { report: String }
  | JoinControlsUnobserved { report: String }

fn join_field(line: String, index: Int) -> String {
  match list_at_optional(xs: split(s: line, delimiter: "\t"), index: index) {
    Present { value: f } => f
    Absent => ""
  }
}

fn read_join_locus(text: String) -> JoinLocus {
  if text == "-" {
    LocusAbsent
  } else {
    let parts = split(s: text, delimiter: ":")
    if length(xs: parts) != 2 {
      LocusMalformed { text: text }
    } else {
      join_locus_by_parts(text: text, parts: parts)
    }
  }
}

fn join_locus_by_parts(text: String, parts: List<String>) -> JoinLocus {
  match list_at_optional(xs: parts, index: 0) {
    Absent => LocusMalformed { text: text }
    Present { value: l } =>
      match list_at_optional(xs: parts, index: 1) {
        Absent => LocusMalformed { text: text }
        Present { value: c } => join_locus_from_ints(text: text, line: parse_int(l), column: parse_int(c))
      }
  }
}

fn join_locus_from_ints(text: String, line: Optional<Int>, column: Optional<Int>) -> JoinLocus {
  match line {
    Absent => LocusMalformed { text: text }
    Present { value: l } =>
      match column {
        Absent => LocusMalformed { text: text }
        Present { value: c } => if (l >= 1) && (c >= 1) { LocusAt { line: l, column: c } } else { LocusMalformed { text: text } }
      }
  }
}

// ---------------------------------------------------------------------------------------------------
// THE EDIT PROOF.

// ONE STEP OF THE GENERATOR'S EDIT MAP, by what it does to the bytes (the kinds are a sum, and every length is derived,
// never stored beside the text it measures; carried from #14844, review 84836).
//   SpliceStep   the bytes [start, end) replaced by `text` -- an import block; what it removed is not carried, so it
//                can never carry an occurrence and any occurrence inside it refuses EditCoversOccurrence;
//   ReplaceStep  exactly the bytes of `from` at `start` replaced by `to` -- a label or call-head rename; its extent is
//                `from`'s own length, so a span that disagrees with the replaced text has no constructor;
//   InsertStep   `text` inserted at `at`, removing nothing -- a positional label;
//   RelocateHeadStep  a call head that changes position as well as spelling (a pipe `xs |> f(a)` rewritten to a direct
//                call `g(xs, a)`): ONE edit that removes exactly the bytes of `from` at `head_at` and writes `to` then
//                `suffix` at `insert_at` (the operand's start), so no second insertion shares that offset and the written
//                text is headed by the new name by construction (tidy-ant-251, 2026-10-25; the carrier mirrors the
//                generator's RosterHeadRelocation { insert_at, to, suffix }, review 86155). The head occurrence is carried
//                from head_at to insert_at, the first len(to) bytes; the operand's bytes are untouched and only shift
//                (ruling A2). DISSOLVES ON: a pipe into a declared function resolving natively
//                (gunbc.recurring_failure_mode pipe_into_a_declared_function_resolves_as_a_method), when pipe sites keep
//                their pipe and no head relocates.
type EditStep
  = SpliceStep { start: Int, end: Int, text: String }
  | ReplaceStep { start: Int, from: NonEmptyStr, to: String }
  | InsertStep { at: Int, text: String }
  | RelocateHeadStep { head_at: Int, from: NonEmptyStr, insert_at: Int, to: NonEmptyStr, suffix: String }

fn step_start(step: EditStep) -> Int {
  match step {
    SpliceStep { start: s, end: _, text: _ } => s
    ReplaceStep { start: s, from: _, to: _ } => s
    InsertStep { at: a, text: _ } => a
    RelocateHeadStep { head_at: _, from: _, insert_at: i, to: _, suffix: _ } => i
  }
}

fn step_end(step: EditStep) -> Int {
  match step {
    SpliceStep { start: _, end: e, text: _ } => e
    ReplaceStep { start: s, from: f, to: _ } => s + text_byte_length(text: f as String)
    InsertStep { at: a, text: _ } => a
    RelocateHeadStep { head_at: h, from: f, insert_at: _, to: _, suffix: _ } => h + text_byte_length(text: f as String)
  }
}

fn step_new_len(step: EditStep) -> Int {
  match step {
    SpliceStep { start: _, end: _, text: t } => text_byte_length(text: t)
    ReplaceStep { start: _, from: _, to: t } => text_byte_length(text: t)
    InsertStep { at: _, text: t } => text_byte_length(text: t)
    RelocateHeadStep { head_at: _, from: _, insert_at: _, to: t, suffix: x } => text_byte_length(text: (t as String) + x)
  }
}

type EditProof
  = EditProven { rounds: List<List<EditStep>> }
  | EditNotGenerated { detail: String }
  | EditUnobserved { detail: String }

// What the generator wrote or could not, per module: one record the pure core and the controls read.
type ModuleEvidence {
  module: String
  base_text: String
  head_text: String
  readable: Bool
}

type ProofState {
  text: String
  rounds: List<List<EditStep>>
  done: Bool
  stuck: String
}

fn text_byte_length(text: String) -> Int {
  length(xs: bytes_octets(b: utf8_encode_bytes(s: text)))
}

// The generator's label edit says what it removes in `from`; an empty `from` at a zero-width extent removes nothing.
// Any other label edit whose `from` is empty is not one this map can name, so it is a splice that carries nothing.
// A pipe site's head-removal edit carries its relocation (v2.workflow.roster_import_sweep RosterHeadRelocation): it maps
// to ONE RelocateHeadStep when it removes exactly its `from` and names a non-empty `to`; anything else is a splice, so a
// covered head refuses EditCoversOccurrence.
fn label_step(edit: RosterLabelEdit) -> EditStep {
  match edit.relocation {
    Present { value: r } =>
      if (edit.from != "") && ((edit.end - edit.start) == text_byte_length(text: edit.from)) && (r.to != "") {
        RelocateHeadStep { head_at: edit.start, from: edit.from as NonEmptyStr, insert_at: r.insert_at, to: r.to as NonEmptyStr, suffix: r.suffix }
      } else {
        SpliceStep { start: edit.start, end: edit.end, text: edit.to }
      }
    Absent => label_step_in_place(edit: edit)
  }
}

fn label_step_in_place(edit: RosterLabelEdit) -> EditStep {
  if edit.from == "" {
    if edit.start == edit.end { InsertStep { at: edit.start, text: edit.to } } else { SpliceStep { start: edit.start, end: edit.end, text: edit.to } }
  } else if (edit.end - edit.start) == text_byte_length(text: edit.from) {
    ReplaceStep { start: edit.start, from: edit.from as NonEmptyStr, to: edit.to }
  } else {
    SpliceStep { start: edit.start, end: edit.end, text: edit.to }
  }
}

fn outcome_steps(outcome: RosterOutcome) -> List<EditStep> {
  match outcome {
    RosterClean => []
    RosterRefused { reason: _ } => []
    RosterEdit { start: s, end: e, text: t, own_line: o } => [SpliceStep { start: s, end: e, text: (if o { "\n" } else { "" }) + t }]
    RosterLabelEdits { edits: es } => fold_list(xs: es, empty: [], cons: fn(acc, e) { list_snoc_item(xs: acc, item: label_step(edit: e)) })
    RosterEditWithLabels { start: s, end: e, text: t, own_line: o, labels: ls } => fold_list(xs: ls, empty: [SpliceStep { start: s, end: e, text: (if o { "\n" } else { "" }) + t }], cons: fn(acc, l) { list_snoc_item(xs: acc, item: label_step(edit: l)) })
  }
}

fn proof_apply(state: ProofState, outcome: RosterOutcome) -> ProofState {
  match roster_applied(before: state.text, outcome: outcome) {
    RosterApplyWritten { content: c } => ProofState { text: c, rounds: list_snoc_item(xs: state.rounds, item: outcome_steps(outcome: outcome)), done: false, stuck: "" }
    RosterApplyRefused { reason: _ } => ProofState { text: state.text, rounds: state.rounds, done: false, stuck: "the generator's own splice refused its edit" }
  }
}

// ONE ROUND: the first row scope (in roster order) whose sweep is not Clean is applied; every scope Clean is the fixed point.
fn proof_round(state: ProofState, path: String, prepared: PreparedGrammar, lex: PreparedLexRules, scopes: List<RosterHomeScope>, closures: List<RosterHomeClosure>) -> ProofState {
  if state.done || (state.stuck != "") {
    state
  } else {
    // Per scope, the same companions the apply step derives from that scope's rows (a RenameHead row's companion
    // import), so the recomputation reproduces exactly what the generator writes.
    let outcome = fold_list(xs: scopes, empty: RosterClean, cons: fn(acc, scope) {
      match acc {
        RosterClean =>
          let rows = roster_rows_for_scope(scope: scope)
          roster_sweep_text_scoped(sides: roster_home_sides(rows: rows), companions: roster_rename_companions(rows: rows, prepared: prepared, lex: lex), path: path, text: state.text, prepared: prepared, lex: lex, scope: scope, closures: closures)
        _ => acc
      }
    })
    match outcome {
      RosterClean => ProofState { text: state.text, rounds: state.rounds, done: true, stuck: "" }
      RosterRefused { reason: _ } => ProofState { text: state.text, rounds: state.rounds, done: false, stuck: "the sweep generator refused the module" }
      RosterEdit { start: s, end: e, text: t, own_line: o } => proof_apply(state: state, outcome: outcome)
      RosterLabelEdits { edits: es } => proof_apply(state: state, outcome: outcome)
      RosterEditWithLabels { start: s, end: e, text: t, own_line: o, labels: ls } => proof_apply(state: state, outcome: outcome)
    }
  }
}

// THE GENERATOR'S OWN RECOMPUTATION from a base text: sweep, splice, repeat to a fixed point (the apply step converges the same way).
// THE HOME CLOSURES ARE CARRIED IN, not re-minted: opening the acquisition door (v2.compiler.module_acquisition
// acquire_verified) re-mints its empty known/absent memos, so a run that recomputed the closures here on every proof
// re-read the whole substrate once per proof (fleet probe 39758520315: 21 door starts x 10 substrate files). One filled
// value is computed per run (wave_roster_closures) and threaded, so the door opens once.
fn recompute_wave_text(path: String, base_text: String, prepared: PreparedGrammar, lex: PreparedLexRules, scopes: List<RosterHomeScope>, closures: List<RosterHomeClosure>) -> ProofState {
  fold([0, 1, 2, 3], init: ProofState { text: base_text, rounds: [], done: false, stuck: "" }, f: fn(acc, i) {
    proof_round(state: acc, path: path, prepared: prepared, lex: lex, scopes: scopes, closures: closures)
  })
}

// THE RUN'S ONE FILLED HOME CLOSURE, computed a single time and threaded into every recompute_wave_text and edit_proof.
// The wave moves one ruled home, so this is the OneHome scope the generator has always used; the door reads the substrate
// here and nowhere else in a run.
fn wave_roster_closures(scopes: List<RosterHomeScope>) -> List<RosterHomeClosure> {
  fold_list(xs: scopes, empty: [], cons: fn(acc, scope) { list_append(left: acc, right: roster_home_closures(root: "", scope: scope)) })
}

fn proof_verdict(end: ProofState, head_text: String) -> EditProof {
  if end.stuck != "" {
    EditUnobserved { detail: end.stuck }
  } else if !end.done {
    EditUnobserved { detail: "the sweep did not converge within 4 rounds" }
  } else if end.text == head_text {
    EditProven { rounds: end.rounds }
  } else {
    EditNotGenerated { detail: "head differs from the generator's recomputation from base" }
  }
}

fn edit_proof(evidence: ModuleEvidence, prepared: PreparedGrammar, lex: PreparedLexRules, scopes: List<RosterHomeScope>, closures: List<RosterHomeClosure>) -> EditProof {
  if !evidence.readable {
    EditUnobserved { detail: "the base or head text of the module could not be read" }
  } else if evidence.base_text == evidence.head_text {
    EditProven { rounds: [] }
  } else {
    proof_verdict(end: recompute_wave_text(path: evidence.module, base_text: evidence.base_text, prepared: prepared, lex: lex, scopes: scopes, closures: closures), head_text: evidence.head_text)
  }
}

// ---------------------------------------------------------------------------------------------------
// POSITIONS: a census locus is `<line>:<byte column>`, 1-based, in the side's own text.

fn offset_at(starts: List<Int>, line: Int, column: Int) -> Int {
  match list_at_optional(xs: starts, index: line - 1) {
    Present { value: s } => s + column - 1
    Absent => 0 - 1
  }
}

// WHERE A BASE OFFSET LANDS ON HEAD under the generator's own plan: carried by position, carried by the one ReplaceStep that
// starts exactly at it (a call-head rename: the occurrence's spelling changes and its locus is the replacement's), or
// covered by an extent that removes it.
type MappedOffset
  = OffsetMapped { offset: Int }
  | OffsetRenamed { offset: Int, from: String, to: String }
  | OffsetCovered

// A step covers an offset when it removes the byte there. A RelocateHeadStep removes only its head's bytes; the span
// between its insertion and its head is untouched.
fn step_covers(step: EditStep, offset: Int) -> Bool {
  match step {
    RelocateHeadStep { head_at: h, from: f, insert_at: _, to: _, suffix: _ } => (h <= offset) && (offset < h + text_byte_length(text: f as String))
    _ => (step_start(step: step) <= offset) && (offset < step_end(step: step))
  }
}

// How far one step moves an offset it does not cover. A contiguous step moves only what lies at or after its end; a
// RelocateHeadStep adds its insertion to what lies at or after insert_at and removes its head from what lies after it.
fn step_delta(step: EditStep, offset: Int) -> Int {
  match step {
    RelocateHeadStep { head_at: h, from: f, insert_at: i, to: t, suffix: x } =>
      (if i <= offset { text_byte_length(text: (t as String) + x) } else { 0 }) - (if h + text_byte_length(text: f as String) <= offset { text_byte_length(text: f as String) } else { 0 })
    _ => if step_end(step: step) <= offset { step_new_len(step: step) - (step_end(step: step) - step_start(step: step)) } else { 0 }
  }
}

// Where a relocated head lands: its insertion offset, moved by every OTHER step that lies before it. No other zero-width
// insertion may share that offset (the generator's disjointness check refuses coincident edits), so any that did would
// already have refused upstream; here one at the same offset is not counted.
fn relocated_head_offset(steps: List<EditStep>, head_at: Int, insert_at: Int) -> Int {
  insert_at + fold(steps, init: 0, f: fn(a, s) {
    match s {
      RelocateHeadStep { head_at: h, from: _, insert_at: _, to: _, suffix: _ } => if h == head_at { a } else { a + step_delta(step: s, offset: insert_at) }
      InsertStep { at: at, text: _ } => if at < insert_at { a + step_delta(step: s, offset: insert_at) } else { a }
      _ => a + step_delta(step: s, offset: insert_at)
    }
  })
}

fn map_through_round(steps: List<EditStep>, offset: Int) -> MappedOffset {
  let covering = steps |> filter(s => step_covers(step: s, offset: offset))
  let shifted = offset + fold(steps, init: 0, f: fn(a, s) { a + step_delta(step: s, offset: offset) })
  if count(covering) == 0 {
    OffsetMapped { offset: shifted }
  } else if count(covering) == 1 {
    match first(covering) {
      Present { value: s } =>
        match s {
          ReplaceStep { start: st, from: f, to: t } => if st == offset { OffsetRenamed { offset: shifted, from: f as String, to: t } } else { OffsetCovered }
          SpliceStep { start: _, end: _, text: _ } => OffsetCovered
          InsertStep { at: _, text: _ } => OffsetCovered
          RelocateHeadStep { head_at: h, from: f, insert_at: i, to: t, suffix: _ } => if h == offset { OffsetRenamed { offset: relocated_head_offset(steps: steps, head_at: h, insert_at: i), from: f as String, to: t as String } } else { OffsetCovered }
        }
      Absent => OffsetCovered
    }
  } else {
    OffsetCovered
  }
}

fn map_through_rounds(rounds: List<List<EditStep>>, offset: Int) -> MappedOffset {
  fold(rounds, init: OffsetMapped { offset: offset }, f: fn(acc, steps) {
    match acc {
      OffsetCovered => OffsetCovered
      OffsetMapped { offset: o } => map_through_round(steps: steps, offset: o)
      // A renamed occurrence is carried through later rounds by position; a second rename of it is not one edit's fact.
      OffsetRenamed { offset: o, from: f, to: t } =>
        match map_through_round(steps: steps, offset: o) {
          OffsetMapped { offset: m } => OffsetRenamed { offset: m, from: f, to: t }
          OffsetRenamed { offset: _, from: _, to: _ } => OffsetCovered
          OffsetCovered => OffsetCovered
        }
    }
  })
}

// ---------------------------------------------------------------------------------------------------
// ENTRIES.

fn join_row_lines(stdout: String) -> List<String> {
  split(s: stdout, delimiter: "\n")
    |> filter(l => starts_with(s: l, prefix: "binding\t") || starts_with(s: l, prefix: "binding_partial\t") || starts_with(s: l, prefix: "binding_unbound\t"))
}

// A side's occurrence rows grouped by module, each module's rows in print order.
fn rows_by_module(stdout: String) -> Map<String, List<String>> {
  fold(join_row_lines(stdout: stdout), init: empty_map(), f: fn(m, l) {
    let key = join_field(line: l, index: 1)
    match map_get(m, key) {
      Present { value: xs } => map_insert(m, key, list_snoc_item(xs: xs, item: l))
      Absent => map_insert(m, key, [l])
    }
  })
}

type RowCounts {
  counts: Map<String, Int>
  ok: Bool
}

fn row_counts(rows: List<String>) -> Map<String, Int> {
  fold(rows, init: empty_map(), f: fn(m, r) {
    match map_get(m, r) {
      Present { value: n } => map_insert(m, r, n + 1)
      Absent => map_insert(m, r, 1)
    }
  })
}

// THE CENSUS PRINTS A MODULE'S ROWS IN A DIFFERENT ORDER FROM RUN TO RUN (measured: 1070 of 1331 modules differ between
// two runs of the same tree only by row order), so "the same rows" is multiset equality, never print-order equality.
// Equal lengths and no head row without a base row left to take it are together equality.
fn row_count_of(counts: Map<String, Int>, row: String) -> Int {
  match map_get(counts, row) {
    Present { value: n } => n
    Absent => 0
  }
}

fn rows_multiset_equal(base_rows: List<String>, head_rows: List<String>) -> Bool {
  if length(xs: base_rows) != length(xs: head_rows) {
    false
  } else {
    fold(head_rows, init: RowCounts { counts: row_counts(rows: base_rows), ok: true }, f: fn(acc, r) {
      match map_get(acc.counts, r) {
        Present { value: n } => RowCounts { counts: map_insert(acc.counts, r, n - 1), ok: acc.ok && (n > 0) }
        Absent => RowCounts { counts: acc.counts, ok: false }
      }
    }).ok
  }
}

fn module_rows(grouped: Map<String, List<String>>, module: String) -> List<String> {
  match map_get(grouped, module) {
    Present { value: xs } => xs
    Absent => []
  }
}

fn join_entry_row(l: String) -> JoinEntry {
  if starts_with(s: l, prefix: "binding_unbound\t") {
    JoinEntry { module: join_field(line: l, index: 1), spelling: join_field(line: l, index: 2), locus: read_join_locus(text: join_field(line: l, index: 3)), source: "unbound", target: "-" }
  } else {
    JoinEntry { module: join_field(line: l, index: 1), spelling: join_field(line: l, index: 2), locus: read_join_locus(text: join_field(line: l, index: 6)), source: join_field(line: l, index: 4), target: join_field(line: l, index: 5) }
  }
}

fn join_located(e: JoinEntry) -> Bool {
  match e.locus {
    LocusAt { line: _, column: _ } => true
    LocusAbsent => false
    LocusMalformed { text: _ } => false
  }
}

fn join_absent(e: JoinEntry) -> Bool {
  match e.locus {
    LocusAt { line: _, column: _ } => false
    LocusAbsent => true
    LocusMalformed { text: _ } => false
  }
}

fn join_locus_text(e: JoinEntry) -> String {
  match e.locus {
    LocusAt { line: l, column: c } => to_string(l) + ":" + to_string(c)
    LocusAbsent => "-"
    LocusMalformed { text: t } => t
  }
}

fn join_locus_line(e: JoinEntry) -> Int {
  match e.locus {
    LocusAt { line: l, column: _ } => l
    LocusAbsent => 0 - 1
    LocusMalformed { text: _ } => 0 - 1
  }
}

fn join_locus_column(e: JoinEntry) -> Int {
  match e.locus {
    LocusAt { line: _, column: c } => c
    LocusAbsent => 0 - 1
    LocusMalformed { text: _ } => 0 - 1
  }
}

// A locus that is neither a coordinate nor `-` is refused, never read as a position or as generated.
fn join_malformed(entries: List<JoinEntry>, module: String, side: String) -> List<JoinDelta> {
  entries
    |> filter(e => !join_located(e: e) && !join_absent(e: e))
    |> map(e => JoinRefused { cause: "MalformedLocus", coordinate: module + " " + e.spelling + " @" + side + " " + join_locus_text(e: e), detail: e.source + " " + e.target })
}

fn join_site_key(e: JoinEntry) -> String {
  e.spelling + " @" + join_locus_text(e: e)
}

fn join_leaf(spelling: String) -> String {
  match last(split(s: spelling, delimiter: ".")) {
    Present { value: l } => l
    Absent => spelling
  }
}

fn join_home_for(rows: List<AmbientNameHome>, spelling: String) -> Optional<String> {
  match first(rows |> filter(r => (r.name as String) == join_leaf(spelling: spelling))) {
    Present { value: r } => Present { value: ambient_name_declaration(row: r) }
    Absent => Absent
  }
}

fn join_unhomed(before: JoinEntry, after: JoinEntry) -> String {
  before.source + " " + before.target + " -> " + after.source + " " + after.target
}

fn join_pair(rows: List<AmbientNameHome>, coordinate: String, before: JoinEntry, after: JoinEntry) -> Optional<JoinDelta> {
  if (before.source == after.source) && (before.target == after.target) {
    Absent
  } else {
    match join_home_for(rows: rows, spelling: before.spelling) {
      Present { value: home } =>
        if ((before.source == "unbound") || starts_with(s: before.source, prefix: "ambient:")) && (after.source == "declared") && (after.target == home) {
          Present { value: JoinAdmitted { coordinate: coordinate, spelling: before.spelling, home: home } }
        } else {
          Present { value: JoinRefused { cause: "TargetChanged", coordinate: coordinate, detail: join_unhomed(before: before, after: after) } }
        }
      Absent => Present { value: JoinRefused { cause: "TargetChanged", coordinate: coordinate, detail: join_unhomed(before: before, after: after) } }
    }
  }
}

// THE RENAME ARM (tidy-ant-251's ruling, 2026-10-25; the design of #14844). A base occurrence the generator's own rename
// edit carried (OffsetRenamed: one ReplaceStep starting at it whose `from` is the occurrence's spelling) pairs with the
// head occurrence of the replacement spelling at the carried locus. The rule source is the generator's own roster
// (v2.workflow.roster_import_sweep roster_head_rows, its RenameHead rows), one declaration source for the plan and its
// admission: the pair is admitted only when a RenameHead row renames exactly this call spelling to exactly that
// replacement, the base occurrence was ambient, and the head one binds the row's home declaration. Anything else
// refuses: RenameUnruled (no row renames from -> to), RenameTargetChanged (not ambient -> the row's home declaration),
// Vanished (no head occurrence at the carried locus). A partial rename is ordinary: an occurrence the plan did not rename
// is carried by position and judged as unchanged, and the edit proof (head == the generator's recomputation) is what
// rules out a rename the plan did not make.
fn join_rename_target(renames: List<RosterHeadRow>, from: String, to: String) -> Optional<String> {
  fold_list(xs: renames, empty: Absent, cons: fn(acc, r) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        match r.head {
          KeepHead => Absent
          ExpandCatchAll { binder: _ } => Absent
          RenameHead { to: t, positional: _, appended: _ } => if (r.call == from) && (t == to) { Present { value: roster_qn_text(qn: r.home) + "." + t } } else { Absent }
        }
    }
  })
}

fn join_respelled(spelling: String, to: String) -> String {
  let parts = split(s: spelling, delimiter: ".")
  if count(parts) <= 1 { to } else { join(list_init(xs: parts), separator: ".") + "." + to }
}

fn join_rename_pair(renames: List<RosterHeadRow>, coordinate: String, before: JoinEntry, after: JoinEntry, from: String, to: String) -> JoinDelta {
  match join_rename_target(renames: renames, from: from, to: to) {
    Absent => JoinRefused { cause: "RenameUnruled", coordinate: coordinate, detail: from + " -> " + to }
    Present { value: target } =>
      if starts_with(s: before.source, prefix: "ambient:") && (after.source == "declared") && (after.target == target) {
        JoinAdmitted { coordinate: coordinate, spelling: before.spelling, home: target }
      } else {
        JoinRefused { cause: "RenameTargetChanged", coordinate: coordinate, detail: join_unhomed(before: before, after: after) }
      }
  }
}

type BaseStep {
  delta: Optional<JoinDelta>
  claimed: Optional<String>
}

fn base_step(rows: List<AmbientNameHome>, renames: List<RosterHeadRow>, module: String, b: JoinEntry, head_index: Map<String, JoinEntry>, base_starts: List<Int>, head_starts: List<Int>, rounds: List<List<EditStep>>) -> BaseStep {
  let coordinate = module + " " + join_site_key(e: b)
  let o = offset_at(starts: base_starts, line: join_locus_line(e: b), column: join_locus_column(e: b))
  if o < 0 {
    BaseStep { delta: Present { value: JoinUnobserved { coordinate: coordinate, detail: "the census locus lies outside the base text" } }, claimed: Absent }
  } else {
    match map_through_rounds(rounds: rounds, offset: o) {
      OffsetCovered => BaseStep { delta: Present { value: JoinRefused { cause: "EditCoversOccurrence", coordinate: coordinate, detail: "an edit extent contains the occurrence" } }, claimed: Absent }
      OffsetMapped { offset: m } =>
        let key = b.spelling + " @" + locus_at(starts: head_starts, offset: m)
        match map_get(head_index, key) {
          Absent => BaseStep { delta: Present { value: JoinRefused { cause: "Vanished", coordinate: coordinate, detail: b.source + " " + b.target } }, claimed: Absent }
          Present { value: a } => BaseStep { delta: join_pair(rows: rows, coordinate: coordinate, before: b, after: a), claimed: Present { value: key } }
        }
      OffsetRenamed { offset: m, from: f, to: t } =>
        if f != join_leaf(spelling: b.spelling) {
          BaseStep { delta: Present { value: JoinRefused { cause: "EditCoversOccurrence", coordinate: coordinate, detail: "a replacement starts at the occurrence but does not replace its spelling" } }, claimed: Absent }
        } else {
          let key = join_respelled(spelling: b.spelling, to: t) + " @" + locus_at(starts: head_starts, offset: m)
          match map_get(head_index, key) {
            Absent => BaseStep { delta: Present { value: JoinRefused { cause: "Vanished", coordinate: coordinate, detail: b.source + " " + b.target + " renamed to " + t } }, claimed: Absent }
            Present { value: a } => BaseStep { delta: Present { value: join_rename_pair(renames: renames, coordinate: coordinate, before: b, after: a, from: f, to: t) }, claimed: Present { value: key } }
          }
        }
    }
  }
}

fn present_deltas(steps: List<BaseStep>) -> List<JoinDelta> {
  fold(steps, init: [], f: fn(acc, s) {
    match s.delta {
      Present { value: d } => list_snoc_item(xs: acc, item: d)
      Absent => acc
    }
  })
}

fn claimed_set(steps: List<BaseStep>) -> Map<String, Bool> {
  fold(steps, init: empty_map(), f: fn(m, s) {
    match s.claimed {
      Present { value: k } => map_insert(m, k, true)
      Absent => m
    }
  })
}

fn site_key_counts(entries: List<JoinEntry>) -> Map<String, Int> {
  fold(entries, init: empty_map(), f: fn(m, e) {
    let k = join_site_key(e: e)
    match map_get(m, k) {
      Present { value: n } => map_insert(m, k, n + 1)
      Absent => map_insert(m, k, 1)
    }
  })
}

fn duplicate_sites(entries: List<JoinEntry>, side: String) -> List<JoinDelta> {
  let counts = site_key_counts(entries: entries)
  map_keys(counts)
    |> filter(k => match map_get(counts, k) { Present { value: n } => n > 1  Absent => false })
    |> map(k => JoinRefused { cause: "Collided", coordinate: k, detail: side })
}

// Generated rows (locus `-`): a multiset of (spelling, source, target), admitted only on exact equality.
fn join_generated_key(e: JoinEntry) -> String {
  e.module + " " + e.spelling + " " + e.source + " " + e.target
}

fn join_generated_multiset(base: List<JoinEntry>, head: List<JoinEntry>) -> List<JoinDelta> {
  let keys = map_keys(fold(base + head, init: empty_map(), f: fn(m, e) { map_insert(m, join_generated_key(e: e), true) }))
  let base_counts = row_counts(rows: base |> map(e => join_generated_key(e: e)))
  let head_counts = row_counts(rows: head |> map(e => join_generated_key(e: e)))
  keys |> fold(init: [], f: fn(acc, k) {
    let b = row_count_of(counts: base_counts, row: k)
    let h = row_count_of(counts: head_counts, row: k)
    if b == h { acc } else { list_snoc_item(xs: acc, item: JoinRefused { cause: "GeneratedChanged", coordinate: k, detail: "base " + to_string(b) + " head " + to_string(h) }) }
  })
}

fn occurrence_join_proven(rows: List<AmbientNameHome>, renames: List<RosterHeadRow>, module: String, base: List<JoinEntry>, head: List<JoinEntry>, base_text: String, head_text: String, rounds: List<List<EditStep>>) -> List<JoinDelta> {
  let base_located = base |> filter(e => join_located(e: e))
  let head_located = head |> filter(e => join_located(e: e))
  let head_index = fold(head_located, init: empty_map(), f: fn(m, e) { map_insert(m, join_site_key(e: e), e) })
  let base_starts = line_starts(text: base_text)
  let head_starts = line_starts(text: head_text)
  let steps = base_located |> map(b => base_step(rows: rows, renames: renames, module: module, b: b, head_index: head_index, base_starts: base_starts, head_starts: head_starts, rounds: rounds))
  let claimed = claimed_set(steps: steps)
  let appeared = head_located
    |> filter(h => match map_get(claimed, join_site_key(e: h)) { Present { value: _ } => false  Absent => true })
    |> map(h => JoinRefused { cause: "Appeared", coordinate: module + " " + h.spelling + " @head " + join_locus_text(e: h), detail: h.source + " " + h.target })
  present_deltas(steps: steps)
    + appeared
    + duplicate_sites(entries: base_located, side: "base")
    + duplicate_sites(entries: head_located, side: "head")
    + join_generated_multiset(base: base |> filter(e => join_absent(e: e)), head: head |> filter(e => join_absent(e: e)))
    + join_malformed(entries: base, module: module, side: "base")
    + join_malformed(entries: head, module: module, side: "head")
}

// ONE MODULE, BOTH SIDES. Identical rows are no change and need no proof; otherwise the edit proof decides what the
// positions mean, and nothing is joined without it.
fn occurrence_join_module(rows: List<AmbientNameHome>, module: String, base_rows: List<String>, head_rows: List<String>, evidence: Optional<ModuleEvidence>, prepared: PreparedGrammar, lex: PreparedLexRules, scopes: List<RosterHomeScope>, closures: List<RosterHomeClosure>) -> List<JoinDelta> {
  if rows_multiset_equal(base_rows: base_rows, head_rows: head_rows) {
    []
  } else {
    match evidence {
      Absent => [JoinUnobserved { coordinate: module, detail: "no base/head text evidence for a module whose rows changed" }]
      Present { value: ev } => occurrence_join_with_proof(rows: rows, renames: roster_head_rows(), module: module, base_rows: base_rows, head_rows: head_rows, evidence: ev, proof: edit_proof(evidence: ev, prepared: prepared, lex: lex, scopes: scopes, closures: closures))
    }
  }
}

fn occurrence_join_with_proof(rows: List<AmbientNameHome>, renames: List<RosterHeadRow>, module: String, base_rows: List<String>, head_rows: List<String>, evidence: ModuleEvidence, proof: EditProof) -> List<JoinDelta> {
  match proof {
    EditUnobserved { detail: d } => [JoinUnobserved { coordinate: module, detail: d }]
    EditNotGenerated { detail: d } => [JoinRefused { cause: "EditsNotGenerated", coordinate: module, detail: d }]
    EditProven { rounds: r } => occurrence_join_proven(rows: rows, renames: renames, module: module, base: base_rows |> map(l => join_entry_row(l: l)), head: head_rows |> map(l => join_entry_row(l: l)), base_text: evidence.base_text, head_text: evidence.head_text, rounds: r)
  }
}

fn join_delta_line(d: JoinDelta) -> String {
  match d {
    JoinAdmitted { coordinate: c, spelling: _, home: h } => "admitted\tUnboundToDeclaredHome\t" + c + "\t" + h
    JoinRefused { cause: k, coordinate: c, detail: t } => "refused\t" + k + "\t" + c + "\t" + t
    JoinUnobserved { coordinate: c, detail: t } => "unobserved_join\t" + c + "\t" + t
  }
}

fn join_delta_admitted(d: JoinDelta) -> Bool {
  match d {
    JoinAdmitted { coordinate: _, spelling: _, home: _ } => true
    JoinRefused { cause: _, coordinate: _, detail: _ } => false
    JoinUnobserved { coordinate: _, detail: _ } => false
  }
}

fn join_delta_unobserved(d: JoinDelta) -> Bool {
  match d {
    JoinAdmitted { coordinate: _, spelling: _, home: _ } => false
    JoinRefused { cause: _, coordinate: _, detail: _ } => false
    JoinUnobserved { coordinate: _, detail: _ } => true
  }
}

// ---------------------------------------------------------------------------------------------------
// THE CONTROLS, at the join's own interface with supplied texts and rows. Each head TEXT is the generator's own
// recomputation of the base text (so the proof holds), and every census row is derived from a text's own `chars(` sites,
// so no locus is typed by hand. The inhabitance claim -- that the real census prints rows of exactly this shape for these
// texts -- is the real-route wave fixture in gunbc.instruments.namespace_wave_binding_diff.
//   admit              every site binds the home at its carried position: nothing refused;
//   relocated          one same-line site is bound one column away from where the edit map puts it: equal counts on both
//                      sides, but no head occurrence at the mapped position (Vanished) and one unclaimed (Appeared);
//   wrong home         the second of two sites on one line binds another declaration: TargetChanged;
//   generated equal    a generated row present on both sides: admitted as a multiset;
//   generated differs  a generated row on one side only: GeneratedChanged;
//   deleted extent     an edit step that deletes the function holding a list literal (its generated head): GeneratedChanged;
//   covered            an edit step whose extent contains an occurrence: EditCoversOccurrence;
//   not generated      a head that is not the recomputation: EditsNotGenerated; unreadable texts: Unobserved.

// THE GENERATOR'S SCOPES FOR A WAVE, one per ruled row: the row's home module, selecting only the row's own name
// (OnlyCall, gunbc.recurring_failure_mode a_one_home_sweep_moves_every_row_of_that_home), so the edit proof recomputes
// exactly the rows the join resolves against and never another row of the same home. A landed wave's row recomputes
// Clean over a base it already converged, so the proof of the newest wave is unchanged by the rows before it.
fn rows_proof_scopes(rows: List<AmbientNameHome>) -> List<RosterHomeScope> {
  rows |> map(r => OneHome { home: qualified_name_from_dotted_string(dotted: r.home as String), rows: OnlyCall { call: r.name as String } })
}

fn join_control_rows() -> List<AmbientNameHome> {
  [AmbientNameHome { name: "chars", home: "std.host_text", table: PrimitiveAuthorityTable, origin: ExistingDeclaration, retired_contract: optional_present(value: "chars_contract" as NonEmptyStr), kit_probe: KitCallProbe { call: chars_kit_call() } }]
}

fn join_control_base_text() -> String {
  "module examples.m\n\nimport std.types { Int }\n\nfn a() -> Int {\n  first(x: chars(s: \"1\"))\n}\n\nfn b() -> Int {\n  pair(a: chars(s: \"a\"), b: chars(s: \"b\"))\n}\n"
}

// The 1-based columns at which `needle` starts on one line.
type SiteScan {
  pos: Int
  cols: List<Int>
}

fn site_scan_cols(scan: SiteScan) -> List<Int> {
  scan.cols
}

fn line_site_columns(line: String, needle: String) -> List<Int> {
  let parts = split(s: line, delimiter: needle)
  site_scan_cols(scan: fold(parts, init: SiteScan { pos: 0, cols: [] }, f: fn(acc, p) {
    if acc.pos == 0 {
      SiteScan { pos: string_length(s: p), cols: [] }
    } else {
      SiteScan { pos: acc.pos + string_length(s: needle) + string_length(s: p), cols: list_snoc_item(xs: acc.cols, item: acc.pos + 1) }
    }
  }))
}

// Every `needle` site of a text as `<line>:<column>`, in order.
fn text_sites(text: String, needle: String) -> List<String> {
  let lines = split(s: text, delimiter: "\n")
  site_sites_loci(s: fold(lines, init: SiteSites { line: 1, loci: [] }, f: fn(acc, l) {
    SiteSites { line: acc.line + 1, loci: acc.loci + (line_site_columns(line: l, needle: needle) |> map(c => to_string(acc.line) + ":" + to_string(c))) }
  }))
}

type SiteSites {
  line: Int
  loci: List<String>
}

fn site_sites_loci(s: SiteSites) -> List<String> {
  s.loci
}

fn join_control_base_rows() -> List<String> {
  text_sites(text: join_control_base_text(), needle: "chars(") |> map(locus => "binding_unbound\tm\tchars\t" + locus)
}

// The locus one column to the right, read through the one reader (a locus that does not read is returned as it was).
fn join_shifted_locus(locus: String) -> String {
  match read_join_locus(text: locus) {
    LocusAt { line: l, column: c } => to_string(l) + ":" + to_string(c + 1)
    LocusAbsent => locus
    LocusMalformed { text: _ } => locus
  }
}

// Head rows from the head's own sites; `target_for(i)` chooses each site's target, `shift_for(i)` its column shift.
fn join_control_head_rows(head_text: String, wrong_index: Int, shifted_index: Int) -> List<String> {
  let loci = text_sites(text: head_text, needle: "chars(")
  head_rows_rows(h: fold(loci, init: HeadRows { index: 0, rows: [] }, f: fn(acc, locus) {
    let target = if acc.index == wrong_index { "examples.elsewhere.chars" } else { "std.host_text.chars" }
    let at = if acc.index == shifted_index { join_shifted_locus(locus: locus) } else { locus }
    HeadRows { index: acc.index + 1, rows: list_snoc_item(xs: acc.rows, item: "binding_partial\tm\tchars\t" + to_string(acc.index) + "\tdeclared\t" + target + "\t" + at) }
  }))
}

type HeadRows {
  index: Int
  rows: List<String>
}

fn head_rows_rows(h: HeadRows) -> List<String> {
  h.rows
}

fn join_control_case(name: String, base_rows: List<String>, head_rows: List<String>, evidence: ModuleEvidence, prepared: PreparedGrammar, lex: PreparedLexRules, want_admitted: Int, want_refused: List<String>, closures: List<RosterHomeClosure>) -> String {
  let deltas = occurrence_join_module(rows: join_control_rows(), module: "m", base_rows: base_rows, head_rows: head_rows, evidence: Present { value: evidence }, prepared: prepared, lex: lex, scopes: rows_proof_scopes(rows: join_control_rows()), closures: closures)
  join_control_verdict(name: name, deltas: deltas, want_admitted: want_admitted, want_refused: want_refused)
}

fn join_control_verdict(name: String, deltas: List<JoinDelta>, want_admitted: Int, want_refused: List<String>) -> String {
  let admitted = count(deltas |> filter(d => join_delta_admitted(d: d)))
  let refused = deltas |> filter(d => !join_delta_admitted(d: d)) |> map(d => match d { JoinRefused { cause: k, coordinate: _, detail: _ } => k  JoinUnobserved { coordinate: _, detail: _ } => "Unobserved"  JoinAdmitted { coordinate: _, spelling: _, home: _ } => "" })
  if (admitted == want_admitted) && (count(refused) == count(want_refused)) && (count(want_refused |> filter(w => count(refused |> filter(r => r == w)) != count(want_refused |> filter(x => x == w)))) == 0) {
    ""
  } else {
    "occurrence-join control " + name + ": admitted " + to_string(admitted) + ", refused [" + join(refused, separator: ",") + "]; want " + to_string(want_admitted) + " and [" + join(want_refused, separator: ",") + "]\n"
  }
}

fn occurrence_join_controls_outcome(prepared: PreparedGrammar, lex: PreparedLexRules, closures: List<RosterHomeClosure>) -> JoinControlsOutcome {
  let base_text = join_control_base_text()
  let generated = recompute_wave_text(path: "m", base_text: base_text, prepared: prepared, lex: lex, scopes: rows_proof_scopes(rows: join_control_rows()), closures: closures)
  let head_text = generated.text
  let evidence = ModuleEvidence { module: "m", base_text: base_text, head_text: head_text, readable: true }
  let base_rows = join_control_base_rows()
  let site_count = count(base_rows)
  if (site_count != 3) || (head_text == base_text) || (!generated.done) {
    // The fixture's own standing is broken: no observation was made, so no control gets to hold or fail.
    JoinControlsUnobserved { report: "occurrence-join control fixture: " + to_string(site_count) + " base sites, generator " + (if generated.done { "converged" } else { "stuck: " + generated.stuck }) + (if head_text == base_text { ", no edits made" } else { "" }) + "\n" }
  } else {
    let admit_rows = join_control_head_rows(head_text: head_text, wrong_index: 0 - 1, shifted_index: 0 - 1)
    let report = join_control_case(name: "admit", base_rows: base_rows, head_rows: admit_rows, evidence: evidence, prepared: prepared, lex: lex, want_admitted: 3, want_refused: [], closures: closures)
      + join_control_case(name: "equal-count-relocated-same-line-site", base_rows: base_rows, head_rows: join_control_head_rows(head_text: head_text, wrong_index: 0 - 1, shifted_index: 2), evidence: evidence, prepared: prepared, lex: lex, want_admitted: 2, want_refused: ["Appeared", "Vanished"], closures: closures)
      + join_control_case(name: "equal-count-wrong-home-same-line-site", base_rows: base_rows, head_rows: join_control_head_rows(head_text: head_text, wrong_index: 2, shifted_index: 0 - 1), evidence: evidence, prepared: prepared, lex: lex, want_admitted: 2, want_refused: ["TargetChanged"], closures: closures)
      + join_control_case(name: "head is not the recomputation", base_rows: base_rows, head_rows: admit_rows, evidence: ModuleEvidence { module: "m", base_text: base_text, head_text: head_text + "\n", readable: true }, prepared: prepared, lex: lex, want_admitted: 0, want_refused: ["EditsNotGenerated"], closures: closures)
      + join_control_case(name: "unreadable text", base_rows: base_rows, head_rows: admit_rows, evidence: ModuleEvidence { module: "m", base_text: "", head_text: "", readable: false }, prepared: prepared, lex: lex, want_admitted: 0, want_refused: ["Unobserved"], closures: closures)
      + join_control_case(name: "same rows in another print order (no change)", base_rows: base_rows, head_rows: list_reverse(xs: base_rows), evidence: evidence, prepared: prepared, lex: lex, want_admitted: 0, want_refused: [], closures: closures)
      + join_control_case(name: "malformed locus", base_rows: base_rows, head_rows: list_snoc_item(xs: admit_rows, item: "binding_partial\tm\tchars\t9\tdeclared\tstd.host_text.chars\t3:x"), evidence: evidence, prepared: prepared, lex: lex, want_admitted: 3, want_refused: ["MalformedLocus"], closures: closures)
      + generated_controls()
      + rename_controls()
      + pipe_end_to_end_control(prepared: prepared, lex: lex, closures: closures)
    if report == "" { JoinControlsHeld } else { JoinControlsFailed { report: report } }
  }
}

// THE OPTIONAL PROJECTION, for the sibling instrument that composes this gate's controls with its own (its
// first_control_failure list wants Optional<String>). It FAILS on either non-held arm, exactly as before the sum
// existed: a broken fixture standing and a failed control are both "the gate did not say held". Only THIS file's
// wire distinguishes their answers, by matching the sum; nothing outside may read the report to tell them apart.
fn occurrence_join_controls_failure(prepared: PreparedGrammar, lex: PreparedLexRules, closures: List<RosterHomeClosure>) -> Optional<String> {
  match occurrence_join_controls_outcome(prepared: prepared, lex: lex, closures: closures) {
    JoinControlsHeld => Absent
    JoinControlsFailed { report: report } => Present { value: report }
    JoinControlsUnobserved { report: report } => Present { value: report }
  }
}

// GENERATED ROWS AND DELETION EXTENTS, at the proof-free core with a supplied proof (the generator makes no deletion,
// so a deletion step can only be supplied). The generated row stands for a list literal's generated head.
fn generated_row() -> String {
  "binding_partial\tm\tstd.algebra.FreeMonoid\t0\tgenerated\tstd.algebra.FreeMonoid\t-"
}

fn generated_controls() -> String {
  let text = "module m\n\nfn lit() -> List<Int> {\n  [1]\n}\n"
  let evidence = ModuleEvidence { module: "m", base_text: text, head_text: "module m\n", readable: true }
  let deleted = EditProven { rounds: [[SpliceStep { start: 10, end: text_byte_length(text: text), text: "" }]] }
  let same = EditProven { rounds: [] }
  join_control_verdict(name: "generated rows equal", deltas: occurrence_join_with_proof(rows: join_control_rows(), renames: [], module: "m", base_rows: [generated_row()], head_rows: [generated_row(), "binding_partial\tm\tInt\t0\tambient:kernel_type_spelling\tkernel:dag_binding_type_int\t-"], evidence: evidence, proof: same), want_admitted: 0, want_refused: ["GeneratedChanged"])
    + join_control_verdict(name: "generated rows identical multiset", deltas: occurrence_join_with_proof(rows: join_control_rows(), renames: [], module: "m", base_rows: [generated_row(), generated_row()], head_rows: [generated_row(), generated_row()], evidence: evidence, proof: same), want_admitted: 0, want_refused: [])
    + join_control_verdict(name: "deleted extent holding a list literal", deltas: occurrence_join_with_proof(rows: join_control_rows(), renames: [], module: "m", base_rows: [generated_row()], head_rows: [], evidence: evidence, proof: deleted), want_admitted: 0, want_refused: ["GeneratedChanged"])
    + join_control_verdict(name: "extent covers an occurrence", deltas: occurrence_join_with_proof(rows: join_control_rows(), renames: [], module: "m", base_rows: ["binding_unbound\tm\tchars\t4:3"], head_rows: [], evidence: evidence, proof: EditProven { rounds: [[SpliceStep { start: 0, end: text_byte_length(text: text), text: "x" }]] }), want_admitted: 0, want_refused: ["EditCoversOccurrence"])
}

// ---------------------------------------------------------------------------------------------------
// THE RENAME ARM'S CONTROLS (tidy-ant-251's REDs, 2026-10-25), at the proof-taking core with a SUPPLIED proof: the steps
// are exactly the ones the generator's RenameHead row plans for `map_get(A, B)` (the head atom replaced by `map_lookup`,
// then a zero-width `m: ` / `key: ` before each positional argument; v2.workflow.roster_import_sweep
// roster_rename_call_edits, whose own controls are the inhabitance claim that the generator emits these steps), and
// every head text is that proof applied to the base text, so each locus is read off a text, never typed.
fn rename_control_rows() -> List<RosterHeadRow> {
  [RosterHeadRow { call: "map_get", key: "map_get", import_name: "map_lookup", home: qualified_name_from_dotted_string(dotted: "std.algebra"), labels: [], head: RenameHead { to: "map_lookup", positional: ["m", "key"], appended: [] }, scope: AnySite }]
}

fn rename_unruled_rows() -> List<RosterHeadRow> {
  [RosterHeadRow { call: "map_get", key: "map_get", import_name: "map_get", home: qualified_name_from_dotted_string(dotted: "std.algebra"), labels: [], head: KeepHead, scope: AnySite }]
}

// One call `map_get(A, B)` at byte `o`: the head replacement and the two positional labels, in byte order.
fn rename_call_steps(text: String, o: Int) -> List<EditStep> {
  let open = o + string_length(s: "map_get(")
  let comma = open + string_length(s: rename_first_arg(text: text, from: open))
  [
    ReplaceStep { start: o, from: "map_get", to: "map_lookup" },
    InsertStep { at: open, text: "m: " },
    InsertStep { at: comma + 2, text: "key: " }
  ]
}

fn rename_first_arg(text: String, from: Int) -> String {
  match first(split(s: substring(s: text, start: from, end: string_length(s: text)), delimiter: ",")) {
    Present { value: a } => a
    Absent => ""
  }
}

fn rename_step_text(step: EditStep) -> String {
  match step {
    SpliceStep { start: _, end: _, text: t } => t
    ReplaceStep { start: _, from: _, to: t } => t
    InsertStep { at: _, text: t } => t
    RelocateHeadStep { head_at: _, from: _, insert_at: _, to: t, suffix: x } => (t as String) + x
  }
}

// The steps applied last-first (ASCII: byte offsets are character offsets).
fn rename_apply(text: String, steps: List<EditStep>) -> String {
  fold(list_reverse(xs: steps), init: text, f: fn(t, st) {
    match st {
      RelocateHeadStep { head_at: h, from: f, insert_at: i, to: nm, suffix: x } =>
        substring(s: t, start: 0, end: i) + (nm as String) + x + substring(s: t, start: i, end: h) + substring(s: t, start: h + string_length(s: f as String), end: string_length(s: t))
      _ => substring(s: t, start: 0, end: step_start(step: st)) + rename_step_text(step: st) + substring(s: t, start: step_end(step: st), end: string_length(s: t))
    }
  })
}

fn rename_row(spelling: String, source: String, target: String, starts: List<Int>, offset: Int) -> String {
  "binding_partial\tm\t" + spelling + "\t0\t" + source + "\t" + target + "\t" + locus_at(starts: starts, offset: offset)
}

fn rename_case(name: String, renames: List<RosterHeadRow>, base_text: String, base_rows: List<String>, head_text: String, head_rows: List<String>, steps: List<EditStep>, want_admitted: Int, want_refused: List<String>) -> String {
  let evidence = ModuleEvidence { module: "m", base_text: base_text, head_text: head_text, readable: true }
  join_control_verdict(name: name, deltas: occurrence_join_with_proof(rows: join_control_rows(), renames: renames, module: "m", base_rows: base_rows, head_rows: head_rows, evidence: evidence, proof: EditProven { rounds: [steps] }), want_admitted: want_admitted, want_refused: want_refused)
}

fn rename_ambient(starts: List<Int>, o: Int) -> String {
  rename_row(spelling: "map_get", source: "ambient:primitive_authority", target: "std.primitives.map_get_contract", starts: starts, offset: o)
}

fn rename_declared(starts: List<Int>, o: Int, target: String) -> String {
  rename_row(spelling: "map_lookup", source: "declared", target: target, starts: starts, offset: o)
}

fn rename_controls() -> String {
  let lead = "module m\n\nfn f(m: Map<String, String>, k: String) -> Optional<String> {\n  "
  // ONE CALL.
  let one = lead + "map_get(m, k)\n}\n"
  let o1 = string_length(s: lead)
  let s1 = rename_call_steps(text: one, o: o1)
  let one_head = rename_apply(text: one, steps: s1)
  let b1 = line_starts(text: one)
  let h1 = line_starts(text: one_head)
  let base1 = [rename_ambient(starts: b1, o: o1)]
  let head1 = [rename_declared(starts: h1, o: o1, target: "std.algebra.map_lookup")]
  // TWO CALLS ON ONE LINE: the second call's head offset moves by the first call's three steps.
  let lead2 = "module m\n\nfn f(m: Map<String, String>, k: String) -> String {\n  g(a: "
  let two = lead2 + "map_get(m, k), b: map_get(m, k))\n}\n"
  let o2a = string_length(s: lead2)
  let o2b = o2a + string_length(s: "map_get(m, k), b: ")
  let shift_a = string_length(s: "map_lookup") - string_length(s: "map_get") + string_length(s: "m: ") + string_length(s: "key: ")
  let s2 = rename_call_steps(text: two, o: o2a) + rename_call_steps(text: two, o: o2b)
  let two_head = rename_apply(text: two, steps: s2)
  let b2 = line_starts(text: two)
  let h2 = line_starts(text: two_head)
  let base2 = [rename_ambient(starts: b2, o: o2a), rename_ambient(starts: b2, o: o2b)]
  let head2 = [rename_declared(starts: h2, o: o2a, target: "std.algebra.map_lookup"), rename_declared(starts: h2, o: o2b + shift_a, target: "std.algebra.map_lookup")]
  // A PARTIAL RENAME: the plan renames only the first call; the second keeps its spelling and its ambient binding on both
  // sides, carried by position (the shape of a wave that renames only some census classes of a spelling).
  let s2_first = rename_call_steps(text: two, o: o2a)
  let partial_head = rename_apply(text: two, steps: s2_first)
  let hp = line_starts(text: partial_head)
  let head_partial = [rename_declared(starts: hp, o: o2a, target: "std.algebra.map_lookup"), rename_ambient(starts: hp, o: o2b + shift_a)]
  // A MOVED BODY: the renamed call's head occurrence sits one line below where the plan carries it.
  let moved_head = rename_apply(text: one, steps: s1)
  let hm = line_starts(text: "\n" + moved_head)
  rename_case(name: "rename admits ambient -> the row's home declaration", renames: rename_control_rows(), base_text: one, base_rows: base1, head_text: one_head, head_rows: head1, steps: s1, want_admitted: 1, want_refused: [])
    + rename_case(name: "RED rename to a different home", renames: rename_control_rows(), base_text: one, base_rows: base1, head_text: one_head, head_rows: [rename_declared(starts: h1, o: o1, target: "examples.elsewhere.map_lookup")], steps: s1, want_admitted: 0, want_refused: ["RenameTargetChanged"])
    + rename_case(name: "RED rename of an occurrence that was not ambient", renames: rename_control_rows(), base_text: one, base_rows: [rename_row(spelling: "map_get", source: "declared", target: "examples.m.map_get", starts: b1, offset: o1)], head_text: one_head, head_rows: head1, steps: s1, want_admitted: 0, want_refused: ["RenameTargetChanged"])
    + rename_case(name: "RED rename no RenameHead row rules", renames: rename_unruled_rows(), base_text: one, base_rows: base1, head_text: one_head, head_rows: head1, steps: s1, want_admitted: 0, want_refused: ["RenameUnruled"])
    + rename_case(name: "RED unplanned rename (the plan has no rename step)", renames: rename_control_rows(), base_text: one, base_rows: base1, head_text: one_head, head_rows: head1, steps: [], want_admitted: 0, want_refused: ["Vanished", "Appeared"])
    + rename_case(name: "RED moved body (the renamed occurrence is not at the carried locus)", renames: rename_control_rows(), base_text: one, base_rows: base1, head_text: one_head, head_rows: [rename_declared(starts: hm, o: o1 + 1, target: "std.algebra.map_lookup")], steps: s1, want_admitted: 0, want_refused: ["Vanished", "Appeared"])
    + rename_case(name: "RED renamed occurrence missing on head", renames: rename_control_rows(), base_text: one, base_rows: base1, head_text: one_head, head_rows: [], steps: s1, want_admitted: 0, want_refused: ["Vanished"])
    + rename_case(name: "two renames on one line", renames: rename_control_rows(), base_text: two, base_rows: base2, head_text: two_head, head_rows: head2, steps: s2, want_admitted: 2, want_refused: [])
    + rename_case(name: "partial rename: the unrenamed call is carried unchanged", renames: rename_control_rows(), base_text: two, base_rows: base2, head_text: partial_head, head_rows: head_partial, steps: s2_first, want_admitted: 1, want_refused: [])
    + relocate_controls()
}

// THE HEAD-RELOCATION CONTROLS (tidy-ant-251's ruling A2): a pipe `xs |> map_get(k)` rewritten to `map_lookup(xs, k)`
// with the head relocated to the operand's start and the operand's bytes untouched. Steps, all disjoint: the relocation
// (`map_get` at the head removed, `map_lookup(` inserted at the operand start), the connector ` |> ` removed, and the
// head's own `(` replaced by `, ` -- every operand byte is carried by shift.
fn relocate_controls() -> String {
  let lead = "module m\n\nfn f(xs: Map<String, String>, k: String) -> Optional<String> {\n  "
  let base = lead + "xs |> map_get(k)\n}\n"
  let o_xs = string_length(s: lead)
  let o_head = o_xs + string_length(s: "xs |> ")
  let steps = [
    RelocateHeadStep { head_at: o_head, from: "map_get", insert_at: o_xs, to: "map_lookup", suffix: "(" },
    ReplaceStep { start: o_xs + string_length(s: "xs"), from: " |> ", to: "" },
    ReplaceStep { start: o_head + string_length(s: "map_get"), from: "(", to: ", " }
  ]
  // The head text is written out, not derived from the steps, so the join's offset arithmetic is checked against a real text.
  let head = lead + "map_lookup(xs, k)\n}\n"
  let bs = line_starts(text: base)
  let hs = line_starts(text: head)
  let o_head_new = o_xs
  let o_xs_new = o_xs + string_length(s: "map_lookup(")
  let base_rows = [rename_ambient(starts: bs, o: o_head), rename_row(spelling: "xs", source: "declared", target: "m.f.xs", starts: bs, offset: o_xs)]
  let head_rows = [rename_declared(starts: hs, o: o_head_new, target: "std.algebra.map_lookup"), rename_row(spelling: "xs", source: "declared", target: "m.f.xs", starts: hs, offset: o_xs_new)]
  let covered = [RelocateHeadStep { head_at: o_head, from: "map_get", insert_at: o_xs, to: "map_lookup", suffix: "(" }, SpliceStep { start: o_xs, end: o_xs + string_length(s: "xs"), text: "(ys" }]
  let wrong_from = [RelocateHeadStep { head_at: o_head, from: "map_got", insert_at: o_xs, to: "map_lookup", suffix: "(" }]
  rename_case(name: "relocated head admitted, operand carried by shift", renames: rename_control_rows(), base_text: base, base_rows: base_rows, head_text: head, head_rows: head_rows, steps: steps, want_admitted: 1, want_refused: [])
    + rename_case(name: "RED relocated head to another home", renames: rename_control_rows(), base_text: base, base_rows: base_rows, head_text: head, head_rows: [rename_declared(starts: hs, o: o_head_new, target: "examples.elsewhere.map_lookup"), rename_row(spelling: "xs", source: "declared", target: "m.f.xs", starts: hs, offset: o_xs_new)], steps: steps, want_admitted: 0, want_refused: ["RenameTargetChanged"])
    + rename_case(name: "RED an operand occurrence covered by an edit", renames: rename_control_rows(), base_text: base, base_rows: base_rows, head_text: head, head_rows: head_rows, steps: covered, want_admitted: 1, want_refused: ["EditCoversOccurrence", "Appeared"])
    + rename_case(name: "RED a relocation whose from is not the occurrence's spelling", renames: rename_control_rows(), base_text: base, base_rows: [rename_ambient(starts: bs, o: o_head)], head_text: head, head_rows: [rename_declared(starts: hs, o: o_head_new, target: "std.algebra.map_lookup")], steps: wrong_from, want_admitted: 0, want_refused: ["EditCoversOccurrence", "Appeared"])
}

// THE PIPE CONTROL'S GENERATOR SCOPE, declared ONCE. The control recomputes over it and the wire fills the
// home closures the generator reads over it; a home a control recomputes over whose closure the wire did not
// fill is refused located by the door (roster_import_sweep.dag roster_cycle_refusal, home-closure-unread), so
// the two uses of this value are what keep the control's scope and the run's closures the same list (review
// of 13656990871: the wire derived closures from join_control_rows() alone, and this control's std.algebra
// home had no entry).
fn pipe_control_scopes() -> List<RosterHomeScope> {
  [OneHome { home: qualified_name_from_dotted_string(dotted: "std.algebra"), rows: OnlyCall { call: "map_get" } }]
}

// EVERY SCOPE THE CONTROLS RECOMPUTE OVER: the ruled rows' own scopes plus the pipe fixture's. THE WIRE FILLS
// CLOSURES OVER EXACTLY THIS LIST, so a control cannot ask the door for a home no closure was filled for.
fn controls_proof_scopes() -> List<RosterHomeScope> {
  list_append(left: rows_proof_scopes(rows: join_control_rows()), right: pipe_control_scopes())
}

// THE PIPE SITE END TO END (tidy-ant-251): the generator's REAL plan for a pipe into the production map_get RenameHead
// row (recompute_wave_text over its OnlyCall scope), then the join over that proof, on one fixture. The loci are read
// off the two texts: the renamed head on base, its relocated replacement on the generated head.
fn pipe_end_to_end_control(prepared: PreparedGrammar, lex: PreparedLexRules, closures: List<RosterHomeClosure>) -> String {
  let base = "module c.pipe\n\nimport std.algebra { Cons }\n\nfn f(xs: Map<String, String>, k: String) -> Optional<String> {\n  xs |> map_get(k)\n}\n"
  let scopes = pipe_control_scopes()
  let generated = recompute_wave_text(path: "c/pipe.dag", base_text: base, prepared: prepared, lex: lex, scopes: scopes, closures: closures)
  let head = generated.text
  if !generated.done || (head == base) {
    "occurrence-join control pipe end to end: generator " + (if generated.done { "made no edit" } else { "stuck: " + generated.stuck }) + "\n"
  } else {
    match first(text_sites(text: base, needle: "map_get(")) {
      Absent => "occurrence-join control pipe end to end: no base site\n"
      Present { value: bl } =>
        match first(text_sites(text: head, needle: "map_lookup(")) {
          Absent => "occurrence-join control pipe end to end: no relocated head in " + head + "\n"
          Present { value: hl } =>
            let base_rows = ["binding_partial\tc.pipe\tmap_get\t0\tambient:primitive_authority\tstd.primitives.map_get_contract\t" + bl]
            let head_rows = ["binding_partial\tc.pipe\tmap_lookup\t0\tdeclared\tstd.algebra.map_lookup\t" + hl]
            let evidence = ModuleEvidence { module: "c/pipe.dag", base_text: base, head_text: head, readable: true }
            join_control_verdict(name: "pipe end to end (generator plan, then join)", deltas: occurrence_join_with_proof(rows: join_control_rows(), renames: roster_head_rows(), module: "c.pipe", base_rows: base_rows, head_rows: head_rows, evidence: evidence, proof: edit_proof(evidence: evidence, prepared: prepared, lex: lex, scopes: scopes, closures: closures)), want_admitted: 1, want_refused: [])
        }
    }
  }
}

// THE GATED ENTRY: `gunbc test //gunbc/instruments:namespace-wave-occurrence-join-controls`
// (gunbc.instrument_targets namespace_wave_occurrence_join_controls_binding, a CliWireProgramProducer row). The gate's
// controls run HERE, not only inside the binding-diff instrument, so a broken join is caught at the join's own label.
// The bytes are the CONTROL REPORT, not a count copied from the tree: occurrence_join_controls_outcome concatenates
// the per-control verdicts, and an EMPTY report is the only evidence of standing -- so the held line claims nothing
// beyond "every verdict was empty" (DESIGN section 5: completeness is the identity join inside each verdict, never a
// number). WHICH ANSWER IT IS comes from matching the sum, never from reading the report's opening text (review 87079).
// THE EXIT IS THE STANDING, THREE-WAY like every instrument wire: 0 the join admits what it should and refuses what it
// should; 1 a located control failure (the report names the controls); 2 UNOBSERVED -- the grammar cannot be prepared or
// the fixture's own standing is broken (site count, generator convergence), so the gate answers nothing about a
// population it could not see (DESIGN section 5: no absorbing answer; the host maps a code-2 wire exit to status 2).
fn namespace_wave_occurrence_join_controls_wire() -> CliWireResponse {
  match dag_prepared_grammar() {
    Rejected { diagnostics: _ } =>
      CliWirePrintable { bytes: "occurrence-join controls UNOBSERVED: grammar-unprepared\n", exit: ExitFailure { code: 2, reason: "occurrence-join controls UNOBSERVED: grammar-unprepared" } }
    Accepted { value: prepared, diagnostics: _ } =>
      match occurrence_join_controls_outcome(prepared: prepared, lex: dag_prepared_lex(), closures: wave_roster_closures(scopes: controls_proof_scopes())) {
        JoinControlsHeld =>
          CliWirePrintable { bytes: "occurrence-join controls: every verdict empty\n", exit: ExitSuccess }
        JoinControlsFailed { report: report } =>
          // A located control failure: the report names its control, the exit says a control did not hold.
          CliWirePrintable { bytes: report, exit: exit_failure(reason: report) }
        JoinControlsUnobserved { report: report } =>
          // The fixture's own standing is broken (site count, generator stuck, no edits): no observation was
          // made, so this is Refused (exit 2), never an ordinary control failure.
          CliWirePrintable { bytes: report, exit: ExitFailure { code: 2, reason: report } }
      }
  }
}
