module tools.emitted_crate_harness_manifest

import std.logic { Bool }
import extdeps.filesystem.filesystem_io { Filesystem, FilesystemEstablishedAbsence, FilesystemFileObservation }
import gunbc.filesystem_file_observe { filesystem_file_observation_of_path }
import v2.std.text { String }

// A HARNESS MANIFEST IS THE EMITTED MANIFEST PLUS WHAT THE HARNESS ITSELF ADDS, AND NOTHING ELSE.
//
// The emission's Cargo workspace carries, at its root, the top package's Cargo.toml, rendered from
// the dependency demand of what it emitted (v1.compiler.stage0_crates emitted_crate_dependencies,
// written by cli_run::emitted_crate_workspace_host write_emitted_workspace). Every harness
// that then builds that crate used to OVERWRITE the file with its own literal [dependencies]
// roster, so one question -- what does this emitted crate link -- had one answer per harness, and
// a dependency the emitted runtime gained reached a harness only when someone remembered to copy
// it there. That is gunbc.recurring_failure_mode probe_manifest_overwrites_emitted_dependency_demand,
// and this module is its repair on the .dag harness routes: no function here names a registry
// crate, so there is no roster left to forget.
//
// WHY APPEND AND NOT PARSE. Each thing a harness adds is its own TOML table -- the [lib] name its
// driver addresses, the [[bin]] target it runs, the seed path dependency as the subtable
// [dependencies.v1-compiler] -- and a table header is position-independent, so the overlay is
// correct wherever the emitter put its own tables and needs no reader of the emitted text. If the
// emitter ever declares one of these tables itself, cargo refuses the duplicate by name; the
// harness cannot silently win.
type HarnessCrateTarget = WitnessBinTarget | ProbeLibTarget

type HarnessSeedLinkage
  = SeedLinked { root: String }
  | SeedAbsent

// THREE WORLDS, THREE ARMS. What the emitter wrote into crate_dir is OBSERVED, never guessed from a
// failed look: the bytes when the file was read, an absence ESTABLISHED by a listing that succeeded
// and did not name the file, or a typed refusal carrying why the observation could not be made. An
// unreadable-but-present path is the third world, not an absence claim about the candidate.
type HarnessEmittedManifestObservation
  = HarnessEmittedManifestRead { content: String }
  | HarnessEmittedManifestAbsent(FilesystemEstablishedAbsence)
  | HarnessEmittedManifestUnobservable { cause: String }

fn harness_emitted_manifest_observation_of(o: FilesystemFileObservation) -> HarnessEmittedManifestObservation {
  match o {
    FilesystemFileRead { path: _, content: content } =>
      HarnessEmittedManifestRead { content: content }
    FilesystemFileAbsent(e) =>
      HarnessEmittedManifestAbsent(e)
    FilesystemFileIndeterminate { cause: c } =>
      HarnessEmittedManifestUnobservable { cause: c }
    FilesystemFileObservationsDisagree { path: _, cause: c } =>
      HarnessEmittedManifestUnobservable { cause: c }
    FilesystemFileSubjectRefused { directory: _, name: _, cause: c } =>
      HarnessEmittedManifestUnobservable { cause: c }
  }
}

type HarnessManifestDerivation
  = HarnessManifestDerived { content: String }
  | EmittedManifestNotUsable { path: String }
  | EmittedManifestAbsent { path: String, established: FilesystemEstablishedAbsence }
  | EmittedManifestUnobservable { path: String, cause: String }
  | HarnessManifestWriteFailed { path: String }

// The emitted package is named by the emission (v1_compiled, or v1_compiler for a pipeline entry);
// witness drivers address the library as v1_compiled either way, so the library name is pinned
// here and the package table is left exactly as emitted.
fn harness_lib_target_table() -> String {
  "\n[lib]\nname = \"v1_compiled\"\npath = \"src/lib.rs\"\n"
}

fn harness_crate_target_tables(target: HarnessCrateTarget) -> String {
  match target {
    WitnessBinTarget => concat(harness_lib_target_table(), "\n[[bin]]\nname = \"witness\"\npath = \"src/main.rs\"\n")
    ProbeLibTarget => harness_lib_target_table()
  }
}

// The one dependency a harness owns: the seed crate a seed-linked receipt compares against. It is a
// fact about the harness and not about the emitted program, which is why it is not in the emitted
// manifest and is the only dependency spelled on this route. SeedAbsent adds nothing, so a
// seed-unavailable build cannot link the seed because no table names it.
fn harness_seed_link_dependency_table(linkage: HarnessSeedLinkage) -> String {
  match linkage {
    SeedLinked { root: root } => concat("\n[dependencies.v1-compiler]\npath = \"", concat(root, "/src/v1/stage0\"\n"))
    SeedAbsent => ""
  }
}

fn harness_manifest_over_emitted(emitted: String, target: HarnessCrateTarget, linkage: HarnessSeedLinkage) -> String {
  concat(
    emitted,
    concat(
      harness_crate_target_tables(target: target),
      harness_seed_link_dependency_table(linkage: linkage)
    )
  )
}

// THE DECISION, SEPARATE FROM THE OBSERVATION THAT FEEDS IT. Whether a harness manifest is planned
// is decided from what was observed, so a claim can supply that observation instead of performing
// it. A read that returned empty bytes is a genuine not-usable fact; an absence established by a
// succeeded listing is its own world; an observation that could not be made REFUSES with its cause
// and is never folded into either -- there is no fallback roster to write in their place, so a
// crate the emitter did not describe is not built under a description the harness made up. The
// plan's variants are named Plan* because a variant name cannot live in two coproducts: the
// derivation below carries the same worlds at its own grain, with the path attached.
type HarnessManifestPlan
  = HarnessManifestPlanned { content: String }
  | PlanEmittedNotUsable
  | PlanEmittedAbsentConfirmed(FilesystemEstablishedAbsence)
  | PlanEmittedUnobservable { cause: String }

fn plan_harness_manifest(
  emitted: HarnessEmittedManifestObservation,
  target: HarnessCrateTarget,
  linkage: HarnessSeedLinkage
) -> HarnessManifestPlan {
  match emitted {
    HarnessEmittedManifestRead { content: content } =>
      if content == "" {
        PlanEmittedNotUsable
      } else {
        HarnessManifestPlanned {
          content: harness_manifest_over_emitted(emitted: content, target: target, linkage: linkage)
        }
      }
    HarnessEmittedManifestAbsent(e) =>
      PlanEmittedAbsentConfirmed(e)
    HarnessEmittedManifestUnobservable { cause: c } =>
      PlanEmittedUnobservable { cause: c }
  }
}

// Observes the manifest the emission wrote into crate_dir and replaces it with the planned one. The
// write exists only on the planned arm, so a refusal leaves the directory as the emission left it.
fn derive_harness_manifest_in_place(
  crate_dir: String,
  target: HarnessCrateTarget,
  linkage: HarnessSeedLinkage
) -> HarnessManifestDerivation {
  let path = concat(crate_dir, "/Cargo.toml")
  let observed = harness_emitted_manifest_observation_of(o: filesystem_file_observation_of_path(path: path))
  match plan_harness_manifest(emitted: observed, target: target, linkage: linkage) {
    PlanEmittedNotUsable => EmittedManifestNotUsable { path: path }
    PlanEmittedAbsentConfirmed(e) => EmittedManifestAbsent { path: path, established: e }
    PlanEmittedUnobservable { cause: c } => EmittedManifestUnobservable { path: path, cause: c }
    HarnessManifestPlanned { content: content } => {
      let written = Filesystem.Write(path: path, content: content)
      if written.success {
        HarnessManifestDerived { content: content }
      } else {
        HarnessManifestWriteFailed { path: path }
      }
    }
  }
}

fn harness_manifest_derived(derivation: HarnessManifestDerivation) -> Bool {
  match derivation {
    HarnessManifestDerived { content: _ } => true
    EmittedManifestNotUsable { path: _ } => false
    EmittedManifestAbsent { path: _, established: _ } => false
    EmittedManifestUnobservable { path: _, cause: _ } => false
    HarnessManifestWriteFailed { path: _ } => false
  }
}
