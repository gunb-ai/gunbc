import std.types {List}

// The roster the witness folds. A step whose target is not in this list is not covered, which is
// why targets are declared here rather than inline: a new call site that re-inlines a literal pair
// is outside the join.
//
// THIS LIST IS ITSELF A HAND-MAINTAINED PARALLEL ENUMERATION, and naming only the inline hole
// understated the denominator problem. A target escapes this roster TWO ways, needing different
// mechanisms:
//
//   1. a `gunbc run` step spelling a literal entry/function pair inline, never declared as a
//      target -- invisible to any enumeration of declarations, because the pair is not a
//      declaration. Only a check over the emitted steps can see it.
//   2. a twentieth `data ..._target: GunbcRunStepTarget` declared correctly and simply NOT ADDED
//      HERE. It looks correct at its declaration site and silently under-reports on anything
//      that folds this list.
//
// The second is the open-denominator class already named and priced: `std.primitives`
// `primitive_contract_roster_note` records the identical shape over *_contract rows, its silent
// under-reporting, and its dissolution — derive the roster by enumerating the declarations once
// declaration introspection lands.
//
// That dissolution condition is SATISFIED for this roster: `decl_facts` is a registered builtin
// callable from ordinary `.dag`, so the roster entries can be derived by enumerating every module-scope
// `data` of type `GunbcRunStepTarget` in this module instead of being retyped here — at no extra
// cost to any consumer that already walks decl_facts, turning a fold over "the rows someone
// remembered to list" into a fold over "the rows that exist". Until that lands, hole 2 is open and
// this list is diligence, not a denominator.
//
// Counted at authoring (2026-07, in gunbc.ci.ci_spec): 33 declarations, 33 entries. Counted at
// closure_consolidation P5 (2026-11-16, here): 119 entries after the five unconsumed step
// targets died with their invokes. That equality with the declarations is the thing nothing checks.
fn gunbc_run_step_targets() -> List<GunbcRunStepTarget> {
  [
    gunbc_ci_fleet_converge_plan_target,
    gunbc_ci_fleet_converge_launch_environment_plan_target,
    gunbc_ci_fleet_converge_allocation_store_plan_target,
    gunbc_ci_fleet_converge_workspace_commissioning_plan_target,
    gunbc_ci_workspace_image_build_target,
    gunbc_ci_revision_job_image_build_target,
    gunbc_ci_workspace_allocation_plan_target,
    gunbc_ci_fleet_converge_apply_target,
    gunbc_ci_fleet_converge_plan_revision_target,
    gunbc_ci_fleet_converge_checkout_verify_target,
    gunbc_ci_admit_plan_run_pointer_target,
    gunbc_ci_admit_apply_run_pointer_target,
    gunbc_ci_admit_dashboard_deploy_inputs_target,
    gunbc_ci_assert_dashboard_deploy_receipts_target,
    gunbc_ci_record_plan_serve_entry_verdict_target,
    gunbc_ci_org_actions_inspect_target,
    gunbc_ci_r2_mint_preflight_target,
    gunbc_ci_r2_bucket_ensure_target,
    gunbc_ci_r2_bucket_admin_mint_target,
    gunbc_ci_r2_object_write_mint_target,
    gunbc_ci_r2_workspace_object_read_mint_target,
    gunbc_ci_r2_workspace_object_write_mint_target,
    gunbc_ci_r2_cache_object_read_mint_target,
    gunbc_ci_hetzner_cloud_server_read_target,
    gunbc_ci_export_host_reader_converge_target,
    gunbc_ci_boot_medium_reader_probe_target,
    gunbc_ci_flex_pass_target,
    gunbc_ci_flex_template_ensure_target,
    gunbc_ci_branch_run_grant_request_target,
    gunbc_ci_branch_run_grant_apply_target,
    gunbc_ci_branch_run_grant_await_target,
    gunbc_ci_branch_run_grant_broker_target,
    gunbc_ci_r2_cache_object_write_mint_target,
    gunbc_ci_r2_conditional_put_race_probe_target,
    gunbc_ci_workspace_source_pack_target,
    gunbc_ci_workspace_checkpoint_measure_target,
    gunbc_ci_workspace_checkpoint_restore_target,
    gunbc_ci_workspace_transcript_rate_observe_target,
    gunbc_ci_runner_guest_image_observe_target,
