module gunbc.instruments.dag_compile_clean_cli_floor_agreement

import gunbc.compile_clean_diagnostic_policy {
  compile_clean_unlisted_import_use_blocks,
  unlisted_import_use_blocks_compile_clean,
  compile_clean_unlisted_import_use_enforcement,
  FloorNotYet,
  Enforced
}

// THE AGREEMENT IS CARRIED BY THE THREE PREDICATES BELOW AND NOTHING ELSE (DESIGN §4c: a String
// declaration whose only purpose is commentary is commentary). A `cli_floor_agreement_note: String`
// stood here until the B1 follow-up pass deleted it: its sole consumer was a witness test grepping
// the note for the text "issue 11" -- commentary about commentary, which any edit to the prose
// would have broken without falsifying a single claim about the policy row. What the note SAID is
// here in typed form: both realizations read
// `gunbc.compile_clean_diagnostic_policy.compile_clean_unlisted_import_use_enforcement` (one import,
// one row, `witness_policy_row_drives_predicate`), the fork is a declared counted frontier rather
// than two silent opposites (`witness_policy_row_is_floor_not_yet`), and promoting the row to
// `Enforced` moves both consumers together (`witness_enforced_flip_red_control`, the RED control).
// The note's closing sentence recorded that the host builtin comparing two compile verdicts was
// deleted once the emit oracle left -- history, and it lives in the deletion's commit, not in a
// data row.

fn witness_policy_row_is_floor_not_yet() -> Bool {
  compile_clean_unlisted_import_use_enforcement == FloorNotYet
    && compile_clean_unlisted_import_use_blocks() == false
}

fn witness_policy_row_drives_predicate() -> Bool {
  compile_clean_unlisted_import_use_blocks() == unlisted_import_use_blocks_compile_clean(enforcement: compile_clean_unlisted_import_use_enforcement)
}

fn witness_enforced_flip_red_control() -> Bool {
  unlisted_import_use_blocks_compile_clean(enforcement: Enforced) == true
    && unlisted_import_use_blocks_compile_clean(enforcement: FloorNotYet) == false
}

fn witness_cli_floor_policy_agreement_holds() -> Bool {
  witness_policy_row_is_floor_not_yet()
    && witness_policy_row_drives_predicate()
    && witness_enforced_flip_red_control()
}
