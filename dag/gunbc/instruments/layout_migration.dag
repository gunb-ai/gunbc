    reason: "the issuer of an approval capability, a signed field"
  },
  IdentityLiteral {
    file: "dag/gunbc/auth/approval_device_redemption_fixtures.dag",
    text: spelled(segments: ["gunbc", "roadmap_serve"]),
    reason: "the issuer inside the capability text the redemption fixtures sign"
  },
  IdentityLiteral {
    file: "dag/gunbc/auth/approval_store_receipt.dag",
    text: spelled(segments: ["gunbc", "fabric_storage_serve"]),
    reason: "the audience of an approval store receipt, a signed field"
  },
  IdentityLiteral {
    file: "dag/gunbc/host/host_identity_adopt.dag",
    text: concat(spelled(segments: ["gunbc", "host_identity_adopt"]), ".v0"),
    reason: "the model marker a host identity content hash is derived from"
  },
  IdentityLiteral {
    file: "dag/gunbc/host/host_identity_assimilation.dag",
    text: concat(spelled(segments: ["gunbc", "host_identity_assimilation"]), ".v0"),
