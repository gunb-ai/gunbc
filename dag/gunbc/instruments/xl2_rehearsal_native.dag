module gunbc.instruments.xl2_rehearsal_native

import std.types { Bool, List, String }
import std.compiler_entry { CompilerEntryDriver, NativeClaimDriver, NativeClaimReport, NativeClaimTerminal, NativeClaimHeld, NativeClaimNotHeld }
import gunbc.namespace_cut.namespace_xl2_rehearsal_census {
  Xl2RehearsalObserved,
  Xl2RehearsalRun,
  Xl2ResidualChain,
  xl2_strip_members
}
import gunbc.namespace_cut.namespace_xl2_rehearsal_controls {
  xl2_clean_fixture, xl2_control_rehearse, xl2_provider_fixture, xl2_residual_fixture, xl2_unstripped
}

// THE XL-2 REHEARSAL AS A NATIVE CLAIM PROGRAM (std.compiler_entry NativeClaimDriver). The
// composition under it is gunbc.namespace_cut.namespace_xl2_rehearsal_census, executed from the
// emitted closure rather than interpreted: the interpreter's per-file front end was the binding cost
// of the whole-tree run, and the native route is two orders of magnitude cheaper per module.
//
// THE CONTROLS RUN FIRST, THROUGH THE SAME COMPOSITION, so a rehearsal whose native closure answered
// everything the same way fails a case whichever way it errs: the cut specimen must yield exactly
// its one residual row, and the SAME specimen unstripped must resolve with none.
data compiler_pipeline_entry: CompilerEntryDriver = NativeClaimDriver

type Xl2NativeCase {
  identity: String
  held: Bool
  observed: String
}

fn bool_text(b: Bool) -> String {
  if b { "true" } else { "false" }
}

fn residual_rows(run: Xl2RehearsalRun) -> Int {
  match run {
    Xl2RehearsalObserved { residual: residual } => count(residual)
    _ => -1
  }
}

fn resolved_modules(run: Xl2RehearsalRun) -> Int {
  match run {
    Xl2RehearsalObserved { resolved_module_count: n } => n
    _ => -1
  }
}

fn control_cases() -> List<Xl2NativeCase> {
  let cut = xl2_control_rehearse(strip: xl2_strip_members(sources: [xl2_provider_fixture(), xl2_residual_fixture(), xl2_clean_fixture()]))
  let pre_cut = xl2_control_rehearse(strip: xl2_unstripped(sources: [xl2_provider_fixture(), xl2_residual_fixture()]))
  [
    Xl2NativeCase { identity: "control_cut_yields_one_residual_row", held: residual_rows(run: cut) == 1, observed: to_string(value: residual_rows(run: cut)) },
    Xl2NativeCase { identity: "control_cut_resolves_provider_and_clean", held: resolved_modules(run: cut) == 2, observed: to_string(value: resolved_modules(run: cut)) },
    Xl2NativeCase { identity: "control_red_unstripped_resolves_with_no_residual", held: residual_rows(run: pre_cut) == 0 && resolved_modules(run: pre_cut) == 2, observed: to_string(value: residual_rows(run: pre_cut)) }
  ]
}

fn case_row(c: Xl2NativeCase) -> String {
  concat("case ", concat(c.identity, concat(if c.held { " held" } else { " not_held" }, concat(" observed=", concat(c.observed, "\n")))))
}

data xl2_native_expected_identities: List<String> = [
  "control_cut_yields_one_residual_row",
  "control_cut_resolves_provider_and_clean",
  "control_red_unstripped_resolves_with_no_residual"
]

fn native_claim_report() -> NativeClaimReport {
  let cases = control_cases()
  let roster = concat("roster ", concat(xl2_native_expected_identities |> join(separator: ","), "\n"))
  let failed = cases |> filter(c => !c.held) |> map(c => c.identity)
  let terminal = if (failed |> count) == 0 { NativeClaimHeld } else { NativeClaimNotHeld { reason: concat("not held: ", failed |> join(separator: ",")) } }
  NativeClaimReport { stdout: concat(roster, cases |> map(c => case_row(c: c)) |> join(separator: "")), terminal: terminal }
}
