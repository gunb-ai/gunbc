module gunbc.instruments.native_app_attest

import std.types { Int, List, String, Bool, NonEmptyStr }
import v2.std.algebra { filter }
import std.compiler_entry { CompilerEntryDriver, NativeClaimDriver, NativeClaimReport, NativeClaimTerminal, NativeClaimHeld, NativeClaimNotHeld }
import extdeps.standards.rfc_5280 { X509Certificate }
import extdeps.standards.webauthn_authenticator_data { AuthenticatorData }
import extdeps.apple.app_attest {
  AttestKeyId, AppIdPrefix, AppAttestDevelopment, AppAttestProduction, app_attest_app_id,
  AttestationExpectation, AttestationDecoded, AttestationDecode, AttestationDecodeOk, AttestationDecodeRefused,
  AttestationRefusal, AttestationFormatUnexpected, AttestationChainUntrusted, AttestationNonceMismatch,
  AttestationKeyIdMismatch, AttestationAppIdMismatch, AttestationCounterNonZero, AttestationEnvironmentUnexpected,
  AttestationCredentialIdMismatch, AttestationValidationCategoryAbsent, AttestationUndecodable,
  AttestationVerification, AttestationVerified, AttestationRefused,
  decode_attestation, attestation_refusal, verify_attestation, chain_link_verifies, base64_of,
  AttestationValidationCategoryRefused, AttestationBundleVersionAbsent, AttestationBundleVersionUnexpected,
  AssertionValidationCategoryRefused, AssertionBundleVersionAbsent, AssertionBundleVersionUnexpected, AssertionUndecodable,
  AssertionExpectation, AssertionVerification, AssertionAuthentic, AssertionRefused,
  AssertionRefusal, AssertionAppIdMismatch, AssertionValidationCategoryAbsent, AssertionSignatureInvalid,
  assertion_parts, AssertionPartsOk, AssertionPartsRefused, assertion_signature_verifies_for, verify_assertion,
}
import extdeps.apple.app_attest_sample_ios_14_4 {
  sample_attestation_octets, sample_assertion_octets, sample_key_id_b64, sample_client_data,
  sample_team_identifier, sample_bundle_identifier, sample_assertion_counter,
}

// THE NATIVE APP ATTEST PROGRAM: extdeps.apple.app_attest verify_attestation and verify_assertion --
// the folds #11989 authored, not a second fold -- executed over Apple's published iOS 14.4 sample
// (extdeps.apple.app_attest_sample_ios_14_4) as a NativeClaimDriver entry, the second row of the
// family gunbc.instruments.native_crypto_vectors opened. `gunbc test
// //gunbc/instruments:native-app-attest` emits this closure, builds it and runs it; nothing here is
// interpreted, which is the point: the two P-384 chain links (Apple's step 1) and the P-256
// assertion signature are the computations the interpreter cannot afford (gunbc#11645's cost shape),
// and they run here on the sample's real bytes. The report contract and its identity join are
// gunbc.native_claim_program's.
//
// THE SAMPLE'S EXPECTED VERDICT IS A REFUSAL, AND THAT IS NOT RELAXED. The 2021 sample predates
// apple_validation_category_01 / apple_bundle_version_01, so the whole fold refuses it with
// AttestationValidationCategoryAbsent (attestation) and AssertionValidationCategoryAbsent
// (assertion) -- reaching that arm is the evidence every earlier step passed on real bytes. The
// chain links, which the fold sequences after the structural steps, are therefore run at their
// own producer (chain_link_verifies) over the same decode. WHAT A WHOLE-FOLD POSITIVE CONTROL NEEDS,
// named as its trigger: an Apple attestation and assertion carrying both extensions -- a newer
// published sample, or the first object off the operator's enrolled phone -- pinned as an
// extdeps.apple row, at which point sample_verdict's expected arm becomes AttestationVerified /
// AssertionAuthentic for that object.
//
// THE ASSERTION COUNTER. Apple's step 5 (counter strictly greater than the stored one) is
// DELIBERATELY not claimed by AssertionAuthentic: gunbc.auth.approval_device_redemption
// platform_proof_disagreement states that the product's replay authority is its server-minted,
// expiring challenge, not the counter. So there is no non-increasing-counter refusal to red; what
// the fold owes is to carry the counter out unaltered, which the assertion counter case asserts
// against the corpus's published value.
data compiler_pipeline_entry: CompilerEntryDriver = NativeClaimDriver

// ONE ROW PER APPLE OBJECT PAIR, so a second capture is another row and not another program. The
// row carries the object's bytes (from its own extdeps module, never transcribed here), the
// caller's expectation for it, and THE VERDICT THE FOLD OWES that object -- a refusal arm for the
// 2021 sample, a success for a capture carrying the extension steps. Every case identity is
// prefixed with the row's name, so the roster join names which object a failure is about.
//
// PLANNED ROW, NOT YET AUTHORABLE: "operator_device_ios_26_6_2" -- an attestation and assertions
// produced by apps/approve-ios on the operator's iPhone (iOS 26.6.2) once gunbc#12000 lands,
// recorded as an OBSERVED ARTIFACT in its own extdeps.apple module with its provenance (device,
// OS version, app bundle, capture date), never transcribed from a message. Its expected verdicts are
// AttestationVerified and AssertionAuthentic; it is the whole-fold positive control the 14.4 row
// cannot be.
type AppAttestSample {
  name: String
  attestation: List<Int>
  assertion: List<Int>
  expectation: AttestationExpectation
  owed_attestation: OwedAttestationVerdict
  owed_assertion: OwedAssertionVerdict
  published_assertion_counter: Int
}

// WHAT A SAMPLE ROW OWES, AS A CLOSED SUM OVER THE FOLD'S OWN RESULT TYPES (review 71337): a row owes
// either the success arm or one named refusal arm of extdeps.apple.app_attest AttestationRefusal /
// AssertionRefusal. The owed refusal is carried AS that refusal type and compared by constructor
// in the matches below -- never as text -- so a reworded detail string cannot move a verdict.
type OwedAttestationVerdict
  = OwesAttestationVerified
  | OwesAttestationRefusedWith { refusal: AttestationRefusal }

type OwedAssertionVerdict
  = OwesAssertionAuthentic
  | OwesAssertionRefusedWith { refusal: AssertionRefusal }

fn ios_14_4_sample() -> AppAttestSample {
  AppAttestSample {
    name: "ios_14_4",
    attestation: sample_attestation_octets,
    assertion: sample_assertion_octets,
    expectation: sample_expectation(),
    owed_attestation: OwesAttestationRefusedWith { refusal: AttestationValidationCategoryAbsent },
    owed_assertion: OwesAssertionRefusedWith { refusal: AssertionValidationCategoryAbsent },
    published_assertion_counter: sample_assertion_counter,
  }
}

fn app_attest_samples() -> List<AppAttestSample> {
  [ios_14_4_sample()]
}

type AppAttestCase {
  identity: String
  held: Bool
  observed: String
}

// A CASE IS JUDGED BY A TYPED PREDICATE OVER THE FOLD'S RESULT; `observed` is report text only and
// never decides `held`.
fn judged(sample: AppAttestSample, identity: String, held: Bool, observed: String) -> AppAttestCase {
  AppAttestCase { identity: concat(sample.name, concat("_", identity)), held: held, observed: observed }
}

// Report text for a refusal, EXHAUSTIVE over the sum (no wildcard: a new refusal arm is a compile
// refusal here, not an "other").
fn attestation_refusal_name(c: AttestationRefusal) -> String {
  match c {
    AttestationFormatUnexpected { declared: d } => concat("format:", d)
    AttestationChainUntrusted { detail: d } => concat("chain:", d)
    AttestationNonceMismatch => "nonce"
    AttestationKeyIdMismatch { declared: _ } => "key-id"
    AttestationAppIdMismatch { expected_app_id: _ } => "app-id"
    AttestationCounterNonZero { counter: n } => concat("counter:", to_string(value: n))
    AttestationEnvironmentUnexpected { expected: _ } => "environment"
    AttestationCredentialIdMismatch { declared: _ } => "credential-id"
    AttestationValidationCategoryRefused { category: n } => concat("category-refused:", to_string(value: n))
    AttestationValidationCategoryAbsent => "category-absent"
    AttestationBundleVersionAbsent => "bundle-version-absent"
    AttestationBundleVersionUnexpected { declared: d } => concat("bundle-version:", d)
    AttestationUndecodable { cause: d } => concat("undecodable:", d)
  }
}

fn attestation_verdict(v: AttestationVerification) -> String {
  match v {
    AttestationVerified { verified: _ } => "verified"
    AttestationRefused { cause: c } => attestation_refusal_name(c: c)
  }
}

fn refusal_verdict(r: AttestationRefusal?) -> String {
  match r {
    Absent => "none"
    Present { value: c } => attestation_refusal_name(c: c)
  }
}

fn attestation_refusal_of(v: AttestationVerification) -> AttestationRefusal? {
  match v {
    AttestationVerified { verified: _ } => no_attestation_refusal()
    AttestationRefused { cause: c } => attestation_refusal_present(c: c)
  }
}

fn attestation_refusal_present(c: AttestationRefusal) -> AttestationRefusal? {
  Present { value: c }
}

fn no_attestation_refusal() -> AttestationRefusal? {
  Absent
}

// SAME CONSTRUCTOR, compared by arm and never by payload text: the owed refusal names which arm of
// AttestationRefusal the fold must answer. Exhaustive over the owed arm, so a new refusal
// constructor must be placed here before any row can owe it.
fn same_attestation_arm(owed: AttestationRefusal, got: AttestationRefusal) -> Bool {
  match owed {
    AttestationFormatUnexpected { declared: _ } => match got { AttestationFormatUnexpected { declared: _ } => true  _ => false }
    AttestationChainUntrusted { detail: _ } => match got { AttestationChainUntrusted { detail: _ } => true  _ => false }
    AttestationNonceMismatch => match got { AttestationNonceMismatch => true  _ => false }
    AttestationKeyIdMismatch { declared: _ } => match got { AttestationKeyIdMismatch { declared: _ } => true  _ => false }
    AttestationAppIdMismatch { expected_app_id: _ } => match got { AttestationAppIdMismatch { expected_app_id: _ } => true  _ => false }
    AttestationCounterNonZero { counter: _ } => match got { AttestationCounterNonZero { counter: _ } => true  _ => false }
    AttestationEnvironmentUnexpected { expected: _ } => match got { AttestationEnvironmentUnexpected { expected: _ } => true  _ => false }
    AttestationCredentialIdMismatch { declared: _ } => match got { AttestationCredentialIdMismatch { declared: _ } => true  _ => false }
    AttestationValidationCategoryRefused { category: _ } => match got { AttestationValidationCategoryRefused { category: _ } => true  _ => false }
    AttestationValidationCategoryAbsent => match got { AttestationValidationCategoryAbsent => true  _ => false }
    AttestationBundleVersionAbsent => match got { AttestationBundleVersionAbsent => true  _ => false }
    AttestationBundleVersionUnexpected { declared: _ } => match got { AttestationBundleVersionUnexpected { declared: _ } => true  _ => false }
    AttestationUndecodable { cause: _ } => match got { AttestationUndecodable { cause: _ } => true  _ => false }
  }
}

fn refused_with(owed: AttestationRefusal, got: AttestationRefusal?) -> Bool {
  match got {
    Absent => false
    Present { value: g } => same_attestation_arm(owed: owed, got: g)
  }
}

fn owed_attestation_holds(owed: OwedAttestationVerdict, v: AttestationVerification) -> Bool {
  match owed {
    OwesAttestationVerified => match v { AttestationVerified { verified: _ } => true  AttestationRefused { cause: _ } => false }
    OwesAttestationRefusedWith { refusal: r } => refused_with(owed: r, got: attestation_refusal_of(v: v))
  }
}

fn verifies(v: Bool?) -> Bool {
  match v {
    Present { value: b } => b
    Absent => false
  }
}

fn verifies_false(v: Bool?) -> Bool {
  match v {
    Present { value: b } => !b
    Absent => false
  }
}

fn chain_untrusted(got: AttestationRefusal?) -> Bool {
  match got {
    Absent => false
    Present { value: r } => match r { AttestationChainUntrusted { detail: _ } => true  _ => false }
  }
}

fn counter_refusal_is(n: Int, got: AttestationRefusal?) -> Bool {
  match got {
    Absent => false
    Present { value: r } => match r { AttestationCounterNonZero { counter: c } => c == n  _ => false }
  }
}

fn sample_app_id() -> NonEmptyStr {
  app_attest_app_id(prefix: sample_team_identifier as AppIdPrefix, bundle_id: sample_bundle_identifier)
}

fn sample_expectation() -> AttestationExpectation {
  AttestationExpectation {
    key_id: sample_key_id_b64 as AttestKeyId,
    client_data: sample_client_data,
    app_id: sample_app_id(),
    environment: AppAttestDevelopment,
    observed_at: "2021-01-23T12:13:35Z",
    admitted_validation_categories: [2, 3, 4],
    expected_bundle_version: "1" as NonEmptyStr,
  }
}

fn with_client_data(e: AttestationExpectation, c: NonEmptyStr) -> AttestationExpectation {
  AttestationExpectation { key_id: e.key_id, client_data: c, app_id: e.app_id, environment: e.environment, observed_at: e.observed_at, admitted_validation_categories: e.admitted_validation_categories, expected_bundle_version: e.expected_bundle_version }
}

fn with_app_id(e: AttestationExpectation, a: NonEmptyStr) -> AttestationExpectation {
  AttestationExpectation { key_id: e.key_id, client_data: e.client_data, app_id: a, environment: e.environment, observed_at: e.observed_at, admitted_validation_categories: e.admitted_validation_categories, expected_bundle_version: e.expected_bundle_version }
}

fn in_production(e: AttestationExpectation) -> AttestationExpectation {
  AttestationExpectation { key_id: e.key_id, client_data: e.client_data, app_id: e.app_id, environment: AppAttestProduction, observed_at: e.observed_at, admitted_validation_categories: e.admitted_validation_categories, expected_bundle_version: e.expected_bundle_version }
}

// The decode with authData's signCount replaced: the counter step reads the decoded field, so the
// RED mutates exactly the fact Apple's step names and nothing the nonce or RP ID hash covers.
fn with_counter(d: AttestationDecoded, n: Int) -> AttestationDecoded {
  AttestationDecoded { parts: d.parts, leaf: d.leaf, ca: d.ca, root: d.root, auth: AuthenticatorData { rp_id_hash: d.auth.rp_id_hash, flags: d.auth.flags, sign_count: n, attested_credential: d.auth.attested_credential, extensions: d.auth.extensions } }
}

// The decode with the pinned root replaced by the sample's own intermediate: a real secp384r1 key
// that is not Apple's root. The fold refuses it by the issuer name; the chain link refuses it by
// the P-384 signature itself, which is the case that matters -- a verifier that answered true for
// any P-384 key would pass the name check's twin and fail this one.
fn with_root(d: AttestationDecoded, root: X509Certificate) -> AttestationDecoded {
  AttestationDecoded { parts: d.parts, leaf: d.leaf, ca: d.ca, root: root, auth: d.auth }
}

fn attestation_cases(s: AppAttestSample, d: AttestationDecoded) -> List<AppAttestCase> {
  let e = s.expectation
  let whole = verify_attestation(object: s.attestation, e: e)
  let leaf_link = chain_link_verifies(subject: d.leaf, issuer: d.ca)
  let root_link = chain_link_verifies(subject: d.ca, issuer: d.root)
  let wrong_root_link = chain_link_verifies(subject: d.ca, issuer: d.ca)
  let wrong_root_fold = attestation_refusal(d: with_root(d: d, root: d.ca), e: e)
  let nonce = verify_attestation(object: s.attestation, e: with_client_data(e: e, c: "wurzelpfropg" as NonEmptyStr))
  let app_id = verify_attestation(object: s.attestation, e: with_app_id(e: e, a: "6MURL8TA57.de.other" as NonEmptyStr))
  let aaguid = verify_attestation(object: s.attestation, e: in_production(e: e))
  let counter = attestation_refusal(d: with_counter(d: d, n: 1), e: e)
  [
    judged(sample: s, identity: "attestation_verdict_is_the_owed_one", held: owed_attestation_holds(owed: s.owed_attestation, v: whole), observed: attestation_verdict(v: whole)),
    judged(sample: s, identity: "attestation_chain_leaf_to_intermediate_verifies_p384", held: verifies(v: leaf_link), observed: bool_verdict(v: leaf_link)),
    judged(sample: s, identity: "attestation_chain_intermediate_to_pinned_root_verifies_p384", held: verifies(v: root_link), observed: bool_verdict(v: root_link)),
    judged(sample: s, identity: "attestation_red_wrong_root_signature", held: verifies_false(v: wrong_root_link), observed: bool_verdict(v: wrong_root_link)),
    judged(sample: s, identity: "attestation_red_wrong_root_in_the_fold", held: chain_untrusted(got: wrong_root_fold), observed: refusal_verdict(r: wrong_root_fold)),
    judged(sample: s, identity: "attestation_red_tampered_nonce", held: refused_with(owed: AttestationNonceMismatch, got: attestation_refusal_of(v: nonce)), observed: attestation_verdict(v: nonce)),
    judged(sample: s, identity: "attestation_red_wrong_app_id", held: refused_with(owed: AttestationAppIdMismatch { expected_app_id: "6MURL8TA57.de.other" as NonEmptyStr }, got: attestation_refusal_of(v: app_id)), observed: attestation_verdict(v: app_id)),
    judged(sample: s, identity: "attestation_red_wrong_aaguid_environment", held: refused_with(owed: AttestationEnvironmentUnexpected { expected: AppAttestProduction }, got: attestation_refusal_of(v: aaguid)), observed: attestation_verdict(v: aaguid)),
    judged(sample: s, identity: "attestation_red_counter_nonzero", held: counter_refusal_is(n: 1, got: counter), observed: refusal_verdict(r: counter)),
  ]
}

fn assertion_refusal_name(c: AssertionRefusal) -> String {
  match c {
    AssertionSignatureInvalid => "signature"
    AssertionAppIdMismatch { expected_app_id: _ } => "app-id"
    AssertionValidationCategoryRefused { category: n } => concat("category-refused:", to_string(value: n))
    AssertionValidationCategoryAbsent => "category-absent"
    AssertionBundleVersionAbsent => "bundle-version-absent"
    AssertionBundleVersionUnexpected { declared: d } => concat("bundle-version:", d)
    AssertionUndecodable { cause: d } => concat("undecodable:", d)
  }
}

fn assertion_verdict(v: AssertionVerification) -> String {
  match v {
    AssertionAuthentic { authentic: _ } => "authentic"
    AssertionRefused { cause: c } => assertion_refusal_name(c: c)
  }
}

fn same_assertion_arm(owed: AssertionRefusal, got: AssertionRefusal) -> Bool {
  match owed {
    AssertionSignatureInvalid => match got { AssertionSignatureInvalid => true  _ => false }
    AssertionAppIdMismatch { expected_app_id: _ } => match got { AssertionAppIdMismatch { expected_app_id: _ } => true  _ => false }
    AssertionValidationCategoryRefused { category: _ } => match got { AssertionValidationCategoryRefused { category: _ } => true  _ => false }
    AssertionValidationCategoryAbsent => match got { AssertionValidationCategoryAbsent => true  _ => false }
    AssertionBundleVersionAbsent => match got { AssertionBundleVersionAbsent => true  _ => false }
    AssertionBundleVersionUnexpected { declared: _ } => match got { AssertionBundleVersionUnexpected { declared: _ } => true  _ => false }
    AssertionUndecodable { cause: _ } => match got { AssertionUndecodable { cause: _ } => true  _ => false }
  }
}

fn assertion_refused_with(owed: AssertionRefusal, v: AssertionVerification) -> Bool {
  match v {
    AssertionAuthentic { authentic: _ } => false
    AssertionRefused { cause: c } => same_assertion_arm(owed: owed, got: c)
  }
}

fn owed_assertion_holds(owed: OwedAssertionVerdict, v: AssertionVerification) -> Bool {
  match owed {
    OwesAssertionAuthentic => match v { AssertionAuthentic { authentic: _ } => true  AssertionRefused { cause: _ } => false }
    OwesAssertionRefusedWith { refusal: r } => assertion_refused_with(owed: r, v: v)
  }
}

fn bool_verdict(v: Bool?) -> String {
  match v {
    Present { value: b } => if b { "true" } else { "false" }
    Absent => "refused"
  }
}

// The assertion's key is the attestation's leaf key rendered by base64_of, so the
// attestation -> assertion join is one chain here as in the interpreted witness.
fn assertion_expectation(s: AppAttestSample, d: AttestationDecoded) -> AssertionExpectation? {
  match base64_of(octets: d.leaf.tbs.spki_public_key, url_safe: true) {
    Absent => no_assertion_expectation()
    Present { value: point } => assertion_expectation_of(e: AssertionExpectation {
      key_id: s.expectation.key_id,
      public_key_point_b64url: point as NonEmptyStr,
      client_data: s.expectation.client_data,
      app_id: s.expectation.app_id,
      admitted_validation_categories: s.expectation.admitted_validation_categories,
      expected_bundle_version: s.expectation.expected_bundle_version,
    })
  }
}

// Optional built through typed helpers, not Present/Absent literals in arms (the emit path does
// not unify those; the same shape gunbc.instruments.native_crypto_vectors verified_as uses).
fn assertion_expectation_of(e: AssertionExpectation) -> AssertionExpectation? {
  Present { value: e }
}

fn no_assertion_expectation() -> AssertionExpectation? {
  Absent
}

fn assertion_with(e: AssertionExpectation, client_data: NonEmptyStr, app_id: NonEmptyStr) -> AssertionExpectation {
  AssertionExpectation { key_id: e.key_id, public_key_point_b64url: e.public_key_point_b64url, client_data: client_data, app_id: app_id, admitted_validation_categories: e.admitted_validation_categories, expected_bundle_version: e.expected_bundle_version }
}

fn assertion_counter_of(s: AppAttestSample) -> Int? {
  match assertion_parts(object: s.assertion) {
    AssertionPartsOk { parts: p } => counter_present(n: p.auth.prefix.sign_count)
    AssertionPartsRefused { cause: _ } => no_counter()
  }
}

fn counter_present(n: Int) -> Int? {
  Present { value: n }
}

fn no_counter() -> Int? {
  Absent
}

fn counter_text(n: Int?) -> String {
  match n {
    Present { value: c } => to_string(value: c)
    Absent => "refused"
  }
}

fn counter_is(n: Int?, published: Int) -> Bool {
  match n {
    Present { value: c } => c == published
    Absent => false
  }
}

fn assertion_cases(s: AppAttestSample, d: AttestationDecoded) -> List<AppAttestCase> {
  match assertion_expectation(s: s, d: d) {
    Absent => [judged(sample: s, identity: "assertion_expectation_from_the_attested_leaf", held: false, observed: "leaf key not bytes")]
    Present { value: e } => {
      let whole = verify_assertion(object: s.assertion, e: e)
      let signature = assertion_signature_verifies_for(object: s.assertion, e: e)
      let nonce = assertion_signature_verifies_for(object: s.assertion, e: assertion_with(e: e, client_data: "wurzelpfropg" as NonEmptyStr, app_id: e.app_id))
      let app_id = verify_assertion(object: s.assertion, e: assertion_with(e: e, client_data: e.client_data, app_id: "6MURL8TA57.de.other" as NonEmptyStr))
      let counter = assertion_counter_of(s: s)
      [
        judged(sample: s, identity: "assertion_verdict_is_the_owed_one", held: owed_assertion_holds(owed: s.owed_assertion, v: whole), observed: assertion_verdict(v: whole)),
        judged(sample: s, identity: "assertion_signature_verifies_p256_under_the_attested_key", held: verifies(v: signature), observed: bool_verdict(v: signature)),
        judged(sample: s, identity: "assertion_red_tampered_nonce", held: verifies_false(v: nonce), observed: bool_verdict(v: nonce)),
        judged(sample: s, identity: "assertion_red_wrong_app_id", held: assertion_refused_with(owed: AssertionAppIdMismatch { expected_app_id: "6MURL8TA57.de.other" as NonEmptyStr }, v: app_id), observed: assertion_verdict(v: app_id)),
        judged(sample: s, identity: "assertion_counter_is_carried_out_as_published", held: counter_is(n: counter, published: s.published_assertion_counter), observed: counter_text(n: counter)),
      ]
    }
  }
}

fn sample_cases(s: AppAttestSample) -> List<AppAttestCase> {
  match decode_attestation(object: s.attestation) {
    AttestationDecodeRefused { cause: c } => [judged(sample: s, identity: "attestation_decodes", held: false, observed: attestation_refusal_name(c: c))]
    AttestationDecodeOk { decoded: d } => concat(attestation_cases(s: s, d: d), assertion_cases(s: s, d: d))
  }
}

fn native_app_attest_cases() -> List<AppAttestCase> {
  app_attest_samples() |> flat_map(s => sample_cases(s: s))
}

fn case_row(c: AppAttestCase) -> String {
  concat("case ", concat(c.identity, concat(if c.held { " held" } else { " not_held" }, concat(" observed=", concat(c.observed, "\n")))))
}

// THE EXPECTED IDENTITIES, DECLARED RATHER THAN DERIVED FROM THE CASES (the rule review 5311497200
// of gunbc#12250 set for this family). Each sample row owes every one of these, prefixed with its
// name; the roster is this declaration crossed with app_attest_samples(), never a projection of the
// computed cases, so a case that is dropped leaves its identity rostered with no row and the run is
// NO OBSERVATION. The two fallback identities a sample emits when its own decode fails
// (attestation_decodes, assertion_expectation_from_the_attested_leaf) are deliberately NOT here: if
// either appears it is an extra row, and the run refuses the same way.
data native_app_attest_expected_case_identities: List<String> = [
  "attestation_verdict_is_the_owed_one",
  "attestation_chain_leaf_to_intermediate_verifies_p384",
  "attestation_chain_intermediate_to_pinned_root_verifies_p384",
  "attestation_red_wrong_root_signature",
  "attestation_red_wrong_root_in_the_fold",
  "attestation_red_tampered_nonce",
  "attestation_red_wrong_app_id",
  "attestation_red_wrong_aaguid_environment",
  "attestation_red_counter_nonzero",
  "assertion_verdict_is_the_owed_one",
  "assertion_signature_verifies_p256_under_the_attested_key",
  "assertion_red_tampered_nonce",
  "assertion_red_wrong_app_id",
  "assertion_counter_is_carried_out_as_published"
]

fn native_app_attest_expected_identities() -> List<String> {
  app_attest_samples() |> flat_map(s => native_app_attest_expected_case_identities |> map(i => concat(s.name, concat("_", i))))
}

fn held_terminal() -> NativeClaimTerminal {
  NativeClaimHeld
}

fn not_held_terminal(reason: String) -> NativeClaimTerminal {
  NativeClaimNotHeld { reason: reason }
}

fn native_claim_report() -> NativeClaimReport {
  let cases = native_app_attest_cases()
  let roster = concat("roster ", concat(native_app_attest_expected_identities() |> join(separator: ","), "\n"))
  let failed = cases |> filter(c => !c.held) |> map(c => c.identity)
  let terminal = if (failed |> count) == 0 { held_terminal() } else { not_held_terminal(reason: concat("not held: ", failed |> join(separator: ","))) }
  NativeClaimReport { stdout: concat(roster, cases |> map(c => case_row(c: c)) |> join(separator: "")), terminal: terminal }
}
