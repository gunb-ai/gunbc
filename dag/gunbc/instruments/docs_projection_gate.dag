module gunbc.instruments.docs_projection_gate

import std.process { ProcessExit, ExitSuccess, ExitFailure, exit_failure }
import extdeps.filesystem.filesystem_io { Filesystem, filesystem_read_outcome, FilesystemReadSucceeded, FilesystemReadRefused }
import gunbc.generated_artifact_production { GeneratedArtifactProduction, ArtifactGenerated, ArtifactGenerationRefused }
import gunbc.generated_artifact { DocsArtifact, DocsProjection, docs_projections, artifact_path, artifact_is_committed, artifact_eq }
import gunbc.docs_production { docs_production }
import gunbc.instruments.docs_projection_agreement { docs_projection_bytes_agree }

fn committed_docs_projections() -> List<DocsProjection> {
  filter(docs_projections, p => artifact_is_committed(a: DocsArtifact { projection: p }))
}

fn docs_projection_resolutions(projections: List<DocsProjection>) -> List<DocsProjectionResolution> {
  map(projections, p => docs_projection_resolution(projection: p))
}

fn write_docs_projection(path: String, content: String) -> ProcessExit {
  let w = Filesystem.Write(path: path, content: content)
  if w.success {
    ExitSuccess
  } else {
    exit_failure(reason: concat(concat("write failed for ", path), concat(": ", w.error)))
  }
}

// THE FIRST FAILURE IS CARRIED, NOT THE LAST, AND NOTHING IS DISCARDED.
//
// A fold over ProcessExit has two wrong shapes and this is neither: taking the last outcome would
// let a later success erase an earlier refusal, and short-circuiting would report one drifted path
// when three had drifted. This keeps the earliest refusal so the diagnostic is stable across runs,
// and every path is still visited.
fn first_failure(acc: ProcessExit, next: ProcessExit) -> ProcessExit {
  match acc {
    ExitFailure { code, reason } => ExitFailure { code: code, reason: reason }
    ExitSuccess => next
  }
}

// THE BYTES AND THEIR PATH, OR THE GENERATOR'S NAMED REFUSAL. Both callers below need the same
// resolution and must refuse identically when it fails, so the resolution is one function and the
// two consumers differ only in what they do with bytes they have. A coproduct rather than an
// Optional because the refusing arm has to carry the path: a diagnostic that cannot say WHICH
// projection refused sends its reader to look at all of them.
type DocsProjectionResolution
  = DocsProjectionResolved { path: String, expected: String }
  | DocsProjectionGenerationRefused { path: String, reason: String }

fn docs_projection_resolution_of(projection: DocsProjection, production: GeneratedArtifactProduction) -> DocsProjectionResolution {
  let a = DocsArtifact { projection: projection }
  if !artifact_eq(a: production.artifact, b: a) {
    DocsProjectionGenerationRefused {
      path: artifact_path(a: a),
      reason: concat("the docs production matched to it generates ", artifact_path(a: production.artifact))
    }
  } else {
    match production.generate() {
      ArtifactGenerated { content } => DocsProjectionResolved { path: artifact_path(a: a), expected: content }
      ArtifactGenerationRefused { reason } => DocsProjectionGenerationRefused { path: artifact_path(a: a), reason: reason }
    }
  }
}

fn docs_projection_resolution(projection: DocsProjection) -> DocsProjectionResolution {
  docs_projection_resolution_of(projection: projection, production: docs_production(projection: projection))
}

fn write_one_resolution(r: DocsProjectionResolution) -> ProcessExit {
  match r {
    DocsProjectionResolved { path, expected } => write_docs_projection(path: path, content: expected)
    DocsProjectionGenerationRefused { path, reason } =>
      exit_failure(reason: concat(concat("docs projection generation refused for ", path), concat(": ", reason)))
  }
}

// THE CLEANLY-EXITING ACTUATOR FOR docs/*.md PROJECTIONS.
//
// gunbc.instruments.generated_artifact_gate main_wet folds the WHOLE committed registry, and resolving
// gunbc.generated_artifact_emit pulls every generator (workflows, CAD, stage0 mirrors). This entry
// reaches gunbc.generated_artifact for the docs family and gunbc.docs_production for its productions,
// never generated_artifact_emit. claim_executor --required-regen never owns these files:
// is_compared_generated_basename is ends_with .rs. That ownership gap is the motive.
//
// REGEN WRITES EVERY DOCS PROJECTION, COMMITTED OR NOT, so a NotCommitted projection is still
// written locally -- which is the existing behaviour for the failure-mode ledger and the reason
// regen's population is wider than main's.
fn regen() -> ProcessExit {
  fold(
    docs_projection_resolutions(projections: docs_projections),
    init: ExitSuccess,
    f: fn(acc, r) { first_failure(acc: acc, next: write_one_resolution(r: r)) }
  )
}

fn agree_one(path: String, expected: String) -> ProcessExit {
  let r = Filesystem.Read(path: path)
  match filesystem_read_outcome(content: r.content, success: r.success, error: r.error) {
    FilesystemReadRefused { error } => exit_failure(
      reason: concat(concat("docs projection unreadable: ", path), concat(": ", error))
    )
    FilesystemReadSucceeded { content } =>
      docs_projection_bytes_agree(path: path, expected: expected, committed: content)
  }
}

fn agree_one_resolution(r: DocsProjectionResolution) -> ProcessExit {
  match r {
    DocsProjectionResolved { path, expected } => agree_one(path: path, expected: expected)
    DocsProjectionGenerationRefused { path, reason } =>
      exit_failure(reason: concat(concat("docs projection generation refused for ", path), concat(": ", reason)))
  }
}

// MAIN AGREES EVERY COMMITTED DOCS PROJECTION.
//
// The population is the docs family filtered by the commit policy, so a
// NotCommitted projection is excluded by construction rather than by a hand-written exception.
// That is what the previous revision achieved with a comment: it did not call agree for the
// failure-mode ledger because there are no committed bytes to agree, and agreeing them would have
// been permanently green. The commit policy now answers that, and adding a committed docs
// projection enrolls it here with no edit to this function.
fn main() -> ProcessExit {
  fold(
    docs_projection_resolutions(projections: committed_docs_projections()),
    init: ExitSuccess,
    f: fn(acc, r) { first_failure(acc: acc, next: agree_one_resolution(r: r)) }
  )
}
