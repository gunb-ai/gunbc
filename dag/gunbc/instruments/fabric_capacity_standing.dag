// ── WHAT THIS DEPLOYMENT'S CAPACITY ACTUALLY IS, ASKED OF THE LIVE ENGINES ────────────────────
//
// Every capacity claim in this repository has so far been green by typecheck. This asks the fleet.
//
//   gunbc run --source-root dag --source-root src/v2 \
//     --entry dag/gunbc/instruments/fabric_capacity_standing.dag --function fabric_capacity_standing
//
// WHAT IT IS FOR. The expected answer today is that capacity is refused on every group, because
// the probe does not observe a vLLM source revision and will not stamp the modelled one, because it
// does not observe hash_block_size and will not stamp the scheduler block_size onto that field, and
// because even those two supplied would find empty groups. That is the point rather than a disappointment:
// knowing mechanically that we cannot establish capacity is worth more than reading a dashboard
// number that says 99% and means something else. The instrument earns its keep the day the answer
// changes without anyone intending it to.
//
// ONE ROUND TRIP PER GROUP. The head curls its own metrics and greps its own launch log. The two
// startup figures travel as the LAST matching LINE, not as a sed-extracted integer -- the carrier
// they inhabit exists so the only inhabitant is one the engine printed. The grep prefixes are
// interpolated from extdeps.vllm.log_lines vllm_startup_line_prefix; they are not a second spelling
// of the upstream surface. A field the far side cannot produce is a literal "-", which refuses
// here and never arrives as a zero.

data capacity_probe_script_brace_workaround_dissolution: DissolutionCondition = unbound_dissolution(description: "TRIGGER: a heads-only (or full) module index whose brace matching is token-aware. SUFFICIENT FOR: a --format template or a shell function body to inhabit a .dag string without flattening (gunbc.recurring_failure_mode.heads_only_index_counts_braces_inside_string_literals). Until then this script is flattened because the reader cannot tell a string from structure. Token-aware matching does not emit this program as typed argv." as NonEmptyStr)

data capacity_probe_script_shell_emit_dissolution: DissolutionCondition = unbound_dissolution(description: "TRIGGER: bash-emit (#5828 / shell-to-intent) realizes this remote inventory probe as typed orchestration intent (or typed host-effect argv) and group_report ships that realization rather than stdin_payload: capacity_probe_script(). SUFFICIENT FOR: emit_field and capacity_probe_script delete together; ExecPortableWordsWithStdin no longer carries a hand-assembled 12-field bash program. The which-prefix decision is already this module's: vllm_startup_line_prefix is interpolated into the payload. Until then this is the marked shell-as-string fact for transport and field order, not for the upstream log surface." as NonEmptyStr)

data observed_engine_revision_frontier: DissolutionCondition = unbound_dissolution(description: "TRIGGER: the live probe observes the engine's vLLM source revision as VllmSourceRevision (repository plus full git object), not /version and not the container image digest (extdeps.vllm.server), and group_report passes that Present value into readings_from_fields instead of none. SUFFICIENT FOR: the revision refuse arm is no longer the live path's first stop. ProbeReadingsReady still also needs observed_hash_block_size_frontier. Until then none is the honest observation, not a stamp of vllm_source_revision_read." as NonEmptyStr)

data observed_hash_block_size_frontier: DissolutionCondition = unbound_dissolution(description: "TRIGGER: the live probe observes hash_block_size as its own TokenCount from the engine (not cache-config block_size, which is the scheduler minimum). group_report passes that Present into readings_from_fields. SUFFICIENT FOR: layout_from_fields stamps the observed hash size, and a scheduler size that happens to equal it is coincidence rather than a second name for the same reading. Until then none is the honest observation." as NonEmptyStr)

// ONE ROSTER, BOTH ENDS. The far side prints one line per slot, in this list's order; decode looks
// slots up by name, so inserting a command cannot silently rebind unit_sha to the container id.
// That names the SLOT, not the captured bytes: a value that contains a newline still splits into
// extra lines, so decode refuses unless the line count equals the roster length. "-" means the
// host could not answer.
//
// The two launch figures are taken from the LAST matching line rather than the first: the log
// accumulates across restarts, and the engine serving now is the one that printed last.
//
// NO BRACE APPEARS IN THIS SCRIPT, and that is a constraint of the reader rather than of shell. The
// heads-only pass that indexes modules counts braces without knowing it is inside a string literal,
// so a `--format` template or a shell function body ends the enclosing declaration early and the
// module refuses to parse. Every field is therefore assigned, defaulted and printed in three plain
// commands, and the two docker templates are replaced by `-q` and a sed capture.
type ProbeFieldName
  = Invocation
  | UnitSha
  | Container
  | ImageSha
  | StartedAt
  | PoolLine
  | ConcurrencyLine
  | AllocatorBlocks
  | BlockSize
  | MaxModelLen
  | Running
  | Waiting

type CapacityProbeSlot {
  name: ProbeFieldName
  command: String
  missing: String
}

fn probe_field_key(n: ProbeFieldName) -> String {
  match n {
    Invocation => "invocation"
    UnitSha => "unit_sha"
    Container => "container"
    ImageSha => "image_sha"
    StartedAt => "started_at"
    PoolLine => "pool_line"
    ConcurrencyLine => "concurrency_line"
    AllocatorBlocks => "allocator_blocks"
    BlockSize => "block_size"
    MaxModelLen => "max_model_len"
    Running => "running"
    Waiting => "waiting"
  }
}

fn capacity_probe_slots() -> List<CapacityProbeSlot> {
  [
    CapacityProbeSlot { name: Invocation, command: "systemctl show $u -p InvocationID --value", missing: "the systemd invocation was not found" },
    CapacityProbeSlot { name: UnitSha, command: "systemctl cat $u | sha256sum | cut -d' ' -f1", missing: "the unit text digest was not found" },
    CapacityProbeSlot { name: Container, command: "docker ps -q --filter name=$c | head -1", missing: "the container id was not found" },
    CapacityProbeSlot { name: ImageSha, command: "docker inspect $c | sed -n 's/.*\"Image\": \"sha256:\\([0-9a-f]*\\)\".*/\\1/p' | head -1", missing: "the container image digest was not found" },
    CapacityProbeSlot { name: StartedAt, command: "date -d \"$(systemctl show $u -p ExecMainStartTimestamp --value)\" +%s", missing: "the unit start instant did not parse as epoch seconds" },
    CapacityProbeSlot { name: PoolLine, command: join(["grep -a '", vllm_startup_line_prefix(line: GpuKvCacheSize) as String, "' \"$log\" | tail -1"], ""), missing: "the engine's GPU KV cache size line was not found in the launch log" },
    CapacityProbeSlot { name: ConcurrencyLine, command: join(["grep -a '", vllm_startup_line_prefix(line: MaximumConcurrency) as String, "' \"$log\" | tail -1"], ""), missing: "the engine's maximum concurrency line was not found in the launch log" },
    CapacityProbeSlot { name: AllocatorBlocks, command: "printf '%s' \"$m\" | grep -o 'num_gpu_blocks=\"[0-9]*\"' | head -1 | tr -dc '0-9'", missing: "num_gpu_blocks was not present in the engine's cache-config metric" },
    CapacityProbeSlot { name: BlockSize, command: "printf '%s' \"$m\" | grep -o 'block_size=\"[0-9]*\"' | head -1 | tr -dc '0-9'", missing: "block_size was not present in the engine's cache-config metric" },
    CapacityProbeSlot { name: MaxModelLen, command: "curl -s --max-time 8 http://127.0.0.1:30000/v1/models | grep -o 'max_model_len\":[0-9]*' | tr -dc '0-9'", missing: "max_model_len was not readable from /v1/models" },
    CapacityProbeSlot { name: Running, command: "printf '%s' \"$m\" | grep '^vllm:num_requests_running' | head -1 | sed 's/.*. //; s/[.].*//'", missing: "num_requests_running was not present in the engine's metrics" },
    CapacityProbeSlot { name: Waiting, command: "printf '%s' \"$m\" | grep '^vllm:num_requests_waiting.engine' | head -1 | sed 's/.*. //; s/[.].*//'", missing: "num_requests_waiting was not present in the engine's metrics" },
  ]
}

type SlotScan {
  n: Nat
  hit: Nat?
}

fn slot_index(want: ProbeFieldName) -> Nat? {
  fold(capacity_probe_slots(), init: SlotScan { n: 0, hit: none }, f: (acc, slot) =>
    match acc.hit {
      Present { value: _ } => acc
      Absent =>
        if probe_field_key(n: slot.name) == probe_field_key(n: want) {
          SlotScan { n: acc.n + 1, hit: Present { value: acc.n } }
        } else {
          SlotScan { n: acc.n + 1, hit: none }
        }
    }).hit
}

fn slot_missing(name: ProbeFieldName) -> String {
  fold(capacity_probe_slots(), init: join(["the probe roster does not contain ", probe_field_key(n: name)], ""), f: (acc, slot) =>
    if probe_field_key(n: slot.name) == probe_field_key(n: name) { slot.missing } else { acc })
}

fn emit_field(command: String) -> String {
  join(["v=$(", command, " 2>/dev/null); [ -n \"$v\" ] || v=-; printf '%s\\n' \"$v\"\n"], "")
}

fn capacity_probe_script() -> String {
  join(concat([
    join(["set -u\nu=", spark_pair_head_unit_name as String, "\nlog=", spark_pair_head_log_path as String, "\nc=", spark_pair_container_name as String, "\n"], ""),
    "m=$(curl -s --max-time 8 http://127.0.0.1:30000/metrics)\n",
  ], map(capacity_probe_slots(), s => emit_field(command: s.command))), "")
}

type CapacityProbeFields {
  invocation: String
  unit_sha: String
  container: String
  image_sha: String
  started_at: Int
  pool_line: String
  concurrency_line: String
  allocator_blocks: AllocatorBlockCount
  block_size: TokenCount
  max_model_len: TokenCount
  running: Int
  waiting: Int
}

type CapacityProbeRead
  = ProbeFields { fields: CapacityProbeFields }
  | ProbeUnreadable { detail: String }

fn field_at(lines: List<String>, n: Nat) -> String {
  trim(s: lines.skip(n: n).first())
}

fn field_named(lines: List<String>, name: ProbeFieldName) -> String? {
  match slot_index(want: name) {
    Absent => none
    Present { value: n } => Present { value: field_at(lines: lines, n: n) }
  }
}

fn int_named(lines: List<String>, name: ProbeFieldName) -> Int? {
  match field_named(lines: lines, name: name) {
    Absent => none
    Present { value: s } => parse_int(s: s)
  }
}

fn captured_named(lines: List<String>, name: ProbeFieldName) -> String? {
  match field_named(lines: lines, name: name) {
    Absent => none
    Present { value: s } =>
      if s == "-" || s == "" {
        none
      } else {
        Present { value: s }
      }
  }
}

fn refuse_slot(name: ProbeFieldName) -> CapacityProbeRead {
  ProbeUnreadable { detail: slot_missing(name: name) }
}

fn decode_probe(stdout: String) -> CapacityProbeRead {
  let lines = split(s: trim(s: stdout), delimiter: "\n")
  let expected = list_length(items: capacity_probe_slots())
  if list_length(items: lines) != expected {
    ProbeUnreadable { detail: join(["the probe returned ", to_string(list_length(items: lines)), " lines, not the ", to_string(expected), " the script emits"], "") }
  } else {
    match int_named(lines: lines, name: StartedAt) {
      Absent => refuse_slot(name: StartedAt)
      Present { value: started } =>
        match captured_named(lines: lines, name: PoolLine) {
          Absent => refuse_slot(name: PoolLine)
          Present { value: pool_line } =>
            match captured_named(lines: lines, name: ConcurrencyLine) {
              Absent => refuse_slot(name: ConcurrencyLine)
              Present { value: conc_line } =>
                match int_named(lines: lines, name: AllocatorBlocks) {
                  Absent => refuse_slot(name: AllocatorBlocks)
                  Present { value: blocks } =>
                    match int_named(lines: lines, name: BlockSize) {
                      Absent => refuse_slot(name: BlockSize)
                      Present { value: bs } =>
                        match int_named(lines: lines, name: MaxModelLen) {
                          Absent => refuse_slot(name: MaxModelLen)
                          Present { value: ctx } =>
                            match int_named(lines: lines, name: Running) {
                              Absent => refuse_slot(name: Running)
                              Present { value: running } =>
                                match int_named(lines: lines, name: Waiting) {
                                  Absent => refuse_slot(name: Waiting)
                                  Present { value: waiting } =>
                                    match field_named(lines: lines, name: Invocation) {
                                      Absent => refuse_slot(name: Invocation)
                                      Present { value: invocation } =>
                                        match field_named(lines: lines, name: UnitSha) {
                                          Absent => refuse_slot(name: UnitSha)
                                          Present { value: unit_sha } =>
                                            match field_named(lines: lines, name: Container) {
                                              Absent => refuse_slot(name: Container)
                                              Present { value: container } =>
                                                match field_named(lines: lines, name: ImageSha) {
                                                  Absent => refuse_slot(name: ImageSha)
                                                  Present { value: image_sha } =>
                                                    ProbeFields { fields: CapacityProbeFields {
                                                      invocation: invocation,
                                                      unit_sha: unit_sha,
                                                      container: container,
                                                      image_sha: image_sha,
                                                      started_at: started,
                                                      pool_line: pool_line,
                                                      concurrency_line: conc_line,
                                                      allocator_blocks: allocator_block_count(count: blocks),
                                                      block_size: token_count(count: bs),
                                                      max_model_len: token_count(count: ctx),
                                                      running: running,
                                                      waiting: waiting,
                                                    } }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
  }
}

fn after_startup_prefix(line: String, kind: VllmStartupLine) -> String? {
  let parts = split(s: line, delimiter: vllm_startup_line_prefix(line: kind) as String)
  if list_length(items: parts) < 2 {
    none
  } else {
    Present { value: trim(s: field_at(lines: parts, n: 1)) }
  }
}

fn tokens_from_gpu_kv_cache_size_line(line: String) -> Int? {
  match after_startup_prefix(line: line, kind: GpuKvCacheSize) {
    Absent => none
    Present { value: after } =>
      parse_int(s: replace(s: trim(s: split(s: after, delimiter: " ").first()), from: ",", to: ""))
  }
}

fn hundredths_from_maximum_concurrency_line(line: String) -> Int? {
  match after_startup_prefix(line: line, kind: MaximumConcurrency) {
    Absent => none
    Present { value: after } => {
      let segs = split(s: after, delimiter: ":")
      if list_length(items: segs) < 2 {
        none
      } else {
        parse_int(s: replace(s: replace(s: trim(s: field_at(lines: segs, n: list_length(items: segs) - 1)), from: "x", to: ""), from: ".", to: ""))
      }
    }
  }
}

// ── THE LAUNCH IDENTITY, WHICH REFUSES RATHER THAN SUBSTITUTING ───────────────────────────────
//
// A digest that does not parse as 64 lower-hex is not a digest, and an incarnation assembled around
// a placeholder would join to anything. There is no fallback arm here on purpose.
type LaunchRead
  = LaunchIdentified { launch: VllmServingLaunch }
  | LaunchUnidentified { detail: String }

fn launch_from_fields(group: FabricGroup, head: HostIdentity, f: CapacityProbeFields) -> LaunchRead {
  match sha256_hex_digest(hex: f.image_sha) {
    Absent => LaunchUnidentified { detail: join(["the container image digest did not read as a sha256: ", f.image_sha], "") }
    Present { value: image } =>
      match sha256_hex_digest(hex: f.unit_sha) {
        Absent => LaunchUnidentified { detail: join(["the unit text digest did not read as a sha256: ", f.unit_sha], "") }
        Present { value: unit } =>
          if f.invocation == "-" || f.container == "-" {
            LaunchUnidentified { detail: "the systemd invocation or the container id was unavailable, so this launch cannot be named" }
          } else {
            LaunchIdentified { launch: vllm_serving_launch(
              group: group,
              head: head,
              systemd_invocation: f.invocation as NonEmptyStr,
              container_id: f.container as NonEmptyStr,
              executable_digest: Sha256Hash(image),
              unit_digest: Sha256Hash(unit),
              started_at: f.started_at,
            ) }
          }
      }
  }
}

// THE REVISION IS OBSERVED, NOT STAMPED. The first cut filled observed_at_revision and
// established_at_revision from vllm_source_revision_read, the constant naming the revision the
// LAWS were read from. That is the exact defect extdeps.vllm.log_lines already closed: every
// reading asserted it had been taken at the modelled revision, so revision_is_modelled could
// not say no. This probe does not observe a vLLM source revision (the container image digest is
// launch identity, not that fact; /version is a self-report and is not that fact). Until a caller
// supplies one, the readings refuse.
type ProbeReadings
  = ProbeReadingsReady { pool: VllmObservedKvPool, reported: VllmReportedCapacity, layout: ResolvedKvLayout }
  | ProbeReadingsRefused { cause: NonEmptyStr }

fn pool_from_fields(f: CapacityProbeFields, revision: VllmSourceRevision) -> VllmObservedKvPool? {
  match tokens_from_gpu_kv_cache_size_line(line: f.pool_line) {
    Absent => none
    Present { value: tokens } =>
      match vllm_observed_kv_pool_from_reading(
        tokens: token_count(count: tokens),
        reading: vllm_startup_reading(
          line: GpuKvCacheSize,
          captured_text: f.pool_line as NonEmptyStr,
          observed_at_revision: revision,
        ),
      ) {
        KvPoolAdmitted { pool: p } => Present { value: p }
        KvPoolRefused { cause: _ } => none
      }
  }
}

fn reported_from_fields(pool: VllmObservedKvPool, f: CapacityProbeFields, revision: VllmSourceRevision) -> VllmReportedCapacity? {
  match hundredths_from_maximum_concurrency_line(line: f.concurrency_line) {
    Absent => none
    Present { value: hundredths } =>
      match vllm_reported_capacity(
        pool: pool,
        max_concurrency: concurrent_request_hundredths(count: hundredths),
        reading: vllm_startup_reading(
          line: MaximumConcurrency,
          captured_text: f.concurrency_line as NonEmptyStr,
          observed_at_revision: revision,
        ),
      ) {
        ReportedCapacityAdmitted { capacity: c } => Present { value: c }
        ReportedCapacityRefused { cause: _ } => none
      }
  }
}

// GROUPS ARE EMPTY, AND THAT IS THE OBSERVATION. The engine's metadata does not carry layer count
// or page size, so there is nothing to put here and the receipt will refuse for exactly that
// reason. Filling it with a guess is the one move that would make this instrument lie.
//
// HASH BLOCK SIZE IS THE SAME KIND OF FACT. cache-config block_size is the scheduler minimum;
// hash_block_size is a separately named field on ResolvedKvLayout. Stamping the neighbour is
// fabrication. The caller supplies the observation, or this fold refuses.
fn layout_from_fields(f: CapacityProbeFields, revision: VllmSourceRevision, hash_block_size: TokenCount) -> ResolvedKvLayout {
  resolved_kv_layout(
    allocator_blocks: f.allocator_blocks,
    scheduler_block_size: f.block_size,
    hash_block_size: hash_block_size,
    max_model_len: f.max_model_len,
    groups: [],
    established_at_revision: revision,
  )
}

fn readings_from_fields(f: CapacityProbeFields, observed_revision: VllmSourceRevision?, observed_hash_block_size: TokenCount?) -> ProbeReadings {
  match observed_revision {
    Absent => ProbeReadingsRefused { cause: "the probe did not observe the engine's vLLM source revision, so it will not stamp the modelled revision onto the reading" as NonEmptyStr }
    Present { value: revision } =>
      match observed_hash_block_size {
        Absent => ProbeReadingsRefused { cause: "the probe did not observe hash_block_size, so it will not stamp the scheduler block_size onto that field" as NonEmptyStr }
        Present { value: hash_bs } =>
          match pool_from_fields(f: f, revision: revision) {
            Absent => ProbeReadingsRefused { cause: "the captured KV-cache-size reading was refused by its own carrier" as NonEmptyStr }
            Present { value: pool } =>
              match reported_from_fields(pool: pool, f: f, revision: revision) {
                Absent => ProbeReadingsRefused { cause: "the captured maximum-concurrency reading was refused by its own carrier" as NonEmptyStr }
                Present { value: reported } =>
                  ProbeReadingsReady { pool: pool, reported: reported, layout: layout_from_fields(f: f, revision: revision, hash_block_size: hash_bs) }
              }
          }
      }
  }
}

fn standing_wire(s: CapacityFloorStanding) -> String {
  match s {
    MeetsFloor { required_blocks: r, available_blocks: a } =>
      join(["meets floor (", to_string(allocator_block_count_value(c: r)), " required of ", to_string(allocator_block_count_value(c: a)), " blocks)"], "")
    BelowFloor { required_blocks: r, available_blocks: a } =>
      join(["BELOW FLOOR (", to_string(allocator_block_count_value(c: r)), " required, ", to_string(allocator_block_count_value(c: a)), " available)"], "")
    FloorUnestablished { cause: c } => join(["UNESTABLISHED: ", c as String], "")
  }
}

fn posture_wire(p: AdmissionPosture) -> String {
  match p {
    Admitting { available_blocks: a } => join(["admitting (", to_string(allocator_block_count_value(c: a)), " blocks)"], "")
    Withdrawn { cause: c } => join(["WITHDRAWN: ", c as String], "")
  }
}

// ONE PROBE PER GROUP, AND THE VERDICT TRAVELS WITH THE TEXT.
//
// The first cut returned a String and decided admittance by searching it for "posture: admitting".
// That was wrong twice over: it re-ran group_report to ask the question, so every group was probed
// over ssh TWICE per invocation — a duplicated side effect, visible in the run as two identical
// remote executions — and it recovered a decision from prose that the fold already knew. The
// standing carries both, so the effect happens once and the verdict is read rather than parsed.
type GroupStanding {
  text: String
  admitting: Bool
}

fn refused_standing(text: String) -> GroupStanding {
  GroupStanding { text: text, admitting: false }
}

fn group_report(group: FabricGroup) -> GroupStanding {
  let name = fabric_group_wire(g: group) as String
  let head = spark_pair_serving_head(group: group)
  match host_lan_address(host: head) {
    Absent => refused_standing(text: join([name, ": no LAN endpoint row for its head, so it was not probed"], ""))
    Present { value: address } => {
      let result = ssh.Session.ExecPortableWordsWithStdin(
        client_args: [
          "-o", "BatchMode=yes",
          "-o", "ConnectTimeout=10",
          join([spark_managed_login, "@", address as String], ""),
          "bash", "-s",
        ],
        stdin_payload: capacity_probe_script(),
      )
      if !result.success {
        refused_standing(text: join([name, ": the probe did not run on ", address as String, ": ", trim(s: result.stderr)], ""))
      } else {
        match decode_probe(stdout: result.stdout) {
          ProbeUnreadable { detail: d } => refused_standing(text: join([name, ": ", d], ""))
          ProbeFields { fields: f } =>
            match launch_from_fields(group: group, head: head, f: f) {
              LaunchUnidentified { detail: d } => refused_standing(text: join([name, ": the launch could not be identified, so nothing is joined to it -- ", d], ""))
              LaunchIdentified { launch: launch } =>
                match readings_from_fields(f: f, observed_revision: none, observed_hash_block_size: none) {
                  ProbeReadingsRefused { cause: c } => refused_standing(text: join([
                    name, " @ ", address as String, " invocation=", f.invocation, "\n",
                    "    engine: ", to_string(f.running), " running, ", to_string(f.waiting), " waiting; inventory ",
                    to_string(allocator_block_count_value(c: f.allocator_blocks)), " blocks of ", to_string(token_count_value(t: f.block_size)), "\n",
                    "    printed: ", f.pool_line, " / ", f.concurrency_line, "\n",
                    "    receipt: refused -- ", c as String,
                  ], ""))
                  ProbeReadingsReady { pool: _, reported: reported, layout: layout } => {
                    let receipt = admit_kv_layout(
                      launch: launch,
                      layout: layout,
                      reported: reported,
                      source_capture_digest: Fnv1a64(content_hash_atom(value: result.stdout as NonEmptyStr)),
                    )
                    let floor = capacity_floor_standing(receipt: receipt, floor: spark_pair_serving_minimum_cold_sessions)
                    let posture = admission_posture(standing: floor)
                    GroupStanding {
                      admitting: match posture { Admitting { available_blocks: _ } => true  Withdrawn { cause: _ } => false },
                      text: join([
                      name, " @ ", address as String, " invocation=", f.invocation, "\n",
                      "    engine: ", to_string(f.running), " running, ", to_string(f.waiting), " waiting; inventory ",
                      to_string(allocator_block_count_value(c: f.allocator_blocks)), " blocks of ", to_string(token_count_value(t: f.block_size)), "\n",
                      "    printed: ", f.pool_line, " / ", f.concurrency_line, "\n",
                      "    receipt: ", receipt_wire(r: receipt), "\n",
                      "    floor:   ", standing_wire(s: floor), "\n",
                      "    posture: ", posture_wire(p: posture),
                    ], ""),
                    }
                  }
                }
            }
        }
      }
    }
  }
}


// THE EXIT CODE IS THE VERDICT. Today this exits non-zero on both groups: the probe does not
// observe a vLLM source revision or hash_block_size, so it refuses to stamp either, and even both
// supplied would still find empty groups. That is a true statement about the deployment produced by
// executing against it, which is the thing none of the surrounding model could claim on its own.
fn fabric_capacity_standing() -> ProcessExit {
  let standings = map(spark_pair_serving_groups, g => group_report(group: g))
  if all(standings, st => st.admitting) {
    ExitSuccess
  } else {
    exit_failure(reason: join(concat(["fabric capacity standing"], map(standings, st => st.text)), "\n"))
  }
}
