module gunbc.instruments.native_emission_controls_optional_collision

import std.types { Int }

// A NON-KERNEL COPRODUCT THAT HAPPENS TO BE NAMED Optional, for the collision case in
// gunbc.instruments.native_emission_controls. Its data row has no `?`, so it must be serialized under
// its own wire policy like any other declared coproduct. A serializer that chose the native option by
// the parent's LEAF SPELLING would spell this row as its bare payload, which the emitted enum cannot
// parse (review on gunbc#13202).
type Optional
  = CollisionWrapped { value: Int }
  | CollisionEmpty

data collision_wrapped_row: Optional = CollisionWrapped { value: 7 }

fn collision_row_value(o: Optional) -> Int {
  match o {
    CollisionWrapped { value: v } => v
    CollisionEmpty => 0
  }
}
