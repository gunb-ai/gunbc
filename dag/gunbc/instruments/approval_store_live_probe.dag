module gunbc.instruments.approval_store_live_probe

import std.types { Bool, NonEmptyStr, String, Secret }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.scoped_authorization { AttemptIdentity }
import extdeps.crypto.mac { MacKey, HmacSha256, MacSigned, MacKeyMaterialNotHex }
import gunbc.auth.approval_apns_publish { DevicePushTargetsListed, ApnsSenderUnavailable }
import gunbc.auth.approval_request_submission {
  approval_submission_mac_key_id, sign_submission, submit_parsed_submission, submission_outcome_reason,
  SubmissionFiledNotNotified, SubmissionAlreadyFiled, SubmissionRefused, SubmissionNotEnrolled,
}
import gunbc.auth.approval_decision_store {
  ApprovalKeyLoaded, approval_mac_key_id,
  StoredApprovalRequest,
}

// THE LIVE RECEIPT FOR THE FILING HALF OF THE APPROVAL DECISION STORE, which the hermetic witness
// cannot reach: a real slot filed, re-notified and refused. Run it as
//
//   gunbc run --source-root dag --source-root src/v2 \
//     --entry dag/gunbc/instruments/approval_store_live_probe.dag --function approval_submission_live_probe \
//     --arg root=<an existing EMPTY directory>
//
// ITS REDEMPTION HALF WAS THE BEARER ROUTE'S and was deleted with it in the device cutover: a
// decision is now redeemed only under an enrolled device's signature
// (gunbc.auth.approval_device_redemption redeem_device_over_store), whose live receipt is a real
// phone approval reading back with decided_by naming the enrolled login.

// The capability key the hermetic witness uses, here only so a request signed with it is refused.
data probe_key_hex: String = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
data probe_escalation: NonEmptyStr = "esc-mtc1-boot-1"
data probe_revision: NonEmptyStr = "sha256:abababababababababababababababababababababababababababababababab"
data probe_attempt: AttemptIdentity = "mtc1-boot-attempt-1" as AttemptIdentity

fn probe_key() -> MacKey {
  MacKey { id: approval_mac_key_id, suite: HmacSha256, material: probe_key_hex as Secret }
}

fn probe_request() -> StoredApprovalRequest {
  StoredApprovalRequest {
    escalation_id: probe_escalation,
    request_revision: probe_revision,
    attempt: probe_attempt,
    requester: "eager-owl-205",
    purpose: "Boot Mt. Collins unit 1 once from the diskless image over BMC virtual media.",
    destructive: true,
    issued_at: "2026-09-16T20:00:00Z",
    expires_at: "2026-09-17T20:00:00Z",
    key_id: approval_mac_key_id,
  }
}

// THE FILING SIDE OVER A REAL STORE, push excepted: a run signs a request with the submission key,
// the server admits it and files generation 1; the SAME bytes filed again re-notify (the retry path
// for a failed push, so with no fixture device the answer is not-notified a second time), and
// DIFFERENT bytes under the same escalation id report the slot occupied. The device list is empty
// and the sender a fixture refusal, so no push leaves this probe. A request signed with the
// CAPABILITY key is refused as not enrolled, over the same store.
data probe_submission_key_hex: String = "fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210"

fn probe_submission_key() -> MacKey {
  MacKey { id: approval_submission_mac_key_id, suite: HmacSha256, material: probe_submission_key_hex as Secret }
}

type ProbeSubmitStanding
  = ProbeNotEnrolled
  | ProbeFiledNotNotified
  | ProbeAlreadyFiled
  | ProbeOther { reason: String }

// A SECOND REQUEST UNDER THE SAME ESCALATION ID WITH DIFFERENT BYTES: the slot is occupied by the
// first, and different bytes may not re-notify, so this is the input that reaches AlreadyFiled.
fn probe_request_other_bytes() -> StoredApprovalRequest {
  StoredApprovalRequest {
    escalation_id: probe_escalation,
    request_revision: probe_revision,
    attempt: "mtc1-boot-attempt-2" as AttemptIdentity,
    requester: "eager-owl-205",
    purpose: "Boot Mt. Collins unit 1 once from the diskless image over BMC virtual media.",
    destructive: true,
    issued_at: "2026-09-16T20:00:00Z",
    expires_at: "2026-09-17T20:00:00Z",
    key_id: approval_mac_key_id,
  }
}

fn probe_submit(root: NonEmptyStr, signer: MacKey, request: StoredApprovalRequest) -> ProbeSubmitStanding {
  match sign_submission(key: signer, request: request) {
    MacKeyMaterialNotHex { key_id: _ } => ProbeOther { reason: "unsigned" }
    MacSigned { tag: t } => {
      let outcome = submit_parsed_submission(
        root: root,
        submission_keyring: ApprovalKeyLoaded { key: probe_submission_key() },
        capability_keyring: ApprovalKeyLoaded { key: probe_key() },
        devices: DevicePushTargetsListed { targets: [], unregistered: [], unreadable: [] },
        sender: ApnsSenderUnavailable { detail: "probe fixture: no push leaves this probe" },
        tag_hex: t.hex,
        request: request,
      )
      match outcome {
        SubmissionRefused { refusal: SubmissionNotEnrolled { detail: _ } } => ProbeNotEnrolled
        SubmissionFiledNotNotified { escalation_id: _, devices: _ } => ProbeFiledNotNotified
        SubmissionAlreadyFiled { escalation_id: _ } => ProbeAlreadyFiled
        other => ProbeOther { reason: submission_outcome_reason(o: other) }
      }
    }
  }
}

fn probe_submit_word(s: ProbeSubmitStanding) -> String {
  match s {
    ProbeNotEnrolled => "not-enrolled"
    ProbeFiledNotNotified => "filed-not-notified"
    ProbeAlreadyFiled => "already-filed"
    ProbeOther { reason: r } => concat("other: ", r)
  }
}

fn approval_submission_live_probe(root: String) -> ProcessExit {
  if root == "" {
    exit_failure(reason: "approval submission live probe: --arg root=<empty directory> is required")
  } else {
    let r = root as NonEmptyStr
    let wrong_key = probe_submit(root: r, signer: probe_key(), request: probe_request())
    let filed = probe_submit(root: r, signer: probe_submission_key(), request: probe_request())
    let renotified = probe_submit(root: r, signer: probe_submission_key(), request: probe_request())
    let other_bytes = probe_submit(root: r, signer: probe_submission_key(), request: probe_request_other_bytes())
    let report = join(["wrong-key=", probe_submit_word(s: wrong_key), "\nfiled=", probe_submit_word(s: filed), "\nrenotified=", probe_submit_word(s: renotified), "\nother-bytes=", probe_submit_word(s: other_bytes)], "")
    let ok = match wrong_key { ProbeNotEnrolled => true  ProbeFiledNotNotified => false  ProbeAlreadyFiled => false  ProbeOther { reason: _ } => false }
      && match filed { ProbeFiledNotNotified => true  ProbeNotEnrolled => false  ProbeAlreadyFiled => false  ProbeOther { reason: _ } => false }
      && match renotified { ProbeFiledNotNotified => true  ProbeNotEnrolled => false  ProbeAlreadyFiled => false  ProbeOther { reason: _ } => false }
      && match other_bytes { ProbeAlreadyFiled => true  ProbeNotEnrolled => false  ProbeFiledNotNotified => false  ProbeOther { reason: _ } => false }
    if ok {
      ExitSuccess
    } else {
      exit_failure(reason: concat("approval submission live probe: a stage did not answer as the filing law requires\n", report))
    }
  }
}
