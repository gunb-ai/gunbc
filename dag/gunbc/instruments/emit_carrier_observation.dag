module gunbc.instruments.emit_carrier_observation

import std.realization_measurement { AllocationCounter }
import std.compiler_entry { CompilerEntryDriver, NativeClaimDriver, NativeClaimReport }
import gunbc.emit_building_block_contracts { BuildingBlockFamily, Carriers }
import gunbc.instruments.allocation_battery { battery_report, audit_rows, roster_membership_row, discrimination_row, execution_row, execution_mechanism_refuses_unproven_claims, ExecutionEvidence }
import gunbc.instruments.emit_carrier_subjects { car_measurement_rows }

// THE GREEN ENTRY of the carrier family: sequence build, element read and sequential traversal under
// PersistentSequenceCarrier, and index build, lookup and traversal under PersistentMapCarrier, each with
// its retained-snapshot block. Every row here is expected to hold, so its exit code means something; the
// red controls are their own target, #gunbc.instrument_targets::emit_carrier_violation_label, because an
// entry carrying rows designed to fail can only exit non-zero and an exit that cannot vary measures
// nothing.
//
// Bodies, windows and the family's finding row:
// #gunbc.instruments.emit_carrier_subjects::car_measurement_rows. Row shapes, calibration, audit and
// report grammar: #gunbc.instruments.allocation_battery::battery_report. The finding is the carrier's own
// disagreement -- the vocabulary calls the persistent carriers realized while the meter reads a wholesale
// copy -- and it is a row, not a comment, so a leg that comes back the other way is noticed.

data compiler_pipeline_entry: CompilerEntryDriver = NativeClaimDriver

// THE V2 OUTCOME OF THIS FAMILY, stated rather than omitted. Two blockers, both named: nobody has asked
// the emitted-compiler door to emit this subject, and under the SEED emitter this family had, at the
// commit this entry was written against, one specimen shape the emitter could not lower at all (the
// inline fold as a by-ref map_get argument, error[E0308] at its initialiser) -- recorded with its emitted
// lines in the subject module, repaired at the specimen, and left as a finding for the row that owns
// lowering.
fn v2_subject_claim() -> String {
  "gunbc test //gunbc/instruments:v2-native-cli over subject dag/gunbc/instruments/emit_carrier_subjects.dag"
}

fn v2_blocker() -> String {
  "v2 door has never been asked to emit this subject; the refusals it records for a closure are translate_rejected_grounding_not_derived and for a member body translate_arrow_body_not_a_type_expression, named in src/v1/stage0/src/cli_run/native_lane_runner.rs"
}

fn native_claim_report() -> NativeClaimReport uses counter: AllocationCounter {
  let measured = car_measurement_rows()
  let audit = audit_rows(prefix: "carrier", family: Carriers)
  let qualified = [
    roster_membership_row(prefix: "carrier", family: Carriers),
    discrimination_row(prefix: "carrier", family: Carriers),
    execution_row(prefix: "carrier", axis: "v2", block_id: "family", e: ExecutionEvidence { claim: v2_subject_claim(), executed: false, run_link: "", blocker: v2_blocker() }),
    execution_mechanism_refuses_unproven_claims(prefix: "carrier")
  ]
  battery_report(concat(measured, concat(audit, qualified)))
}
