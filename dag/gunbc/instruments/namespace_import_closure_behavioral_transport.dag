module tools.namespace_import_closure_behavioral_transport

import std.dissolution { DissolutionCondition, dissolution_description, unbound_dissolution }

import extdeps.shell
import extdeps.filesystem.filesystem_io
import extdeps.cargo_build
import extdeps.git
import extdeps.git.inspect
import extdeps.gunbc
import std.logic { Bool }
import v2.std.subject_evidence {
  EvidenceInstrumentRefused,
  EvidenceSubjectCompleted,
  EvidenceSubjectUnreached,
  SubjectEvidence,
  subject_evidence_establishes
}
import tools.host_prelude { witness_bin, witness_bin_ready, witness_bin_release_path }

data nic_doc: String = "Wet cargo-compiling receipt for the Gate-1 emit import-closure derivation (emit_import_closure_root, PR 6960): a NAMESPACE module — zero import statements, the v2 corpus shape after namespace wave-1 — that references cross-module names emits VALID, cargo-COMPILING Rust. The regression it guards: before the reference_derived_use_lines pass in v1.compiler.emit_rust, the seed emitter derived Rust use-lines ONLY from authored import name-lists, so an import-free module referencing a sibling emitted bare unqualified names with no use-line and no inline qualification — unresolvable Rust (E0425/E0433). Regen does NOT guard this class (the seed corpus is import-based, so its emit is unchanged by the pass), which is why this receipt is REQUIRED coverage rather than redundant with the self-host fixed point. Live host effects (real gunbc emit, cargo build), so it is CLASSIFIED onto the required floor's local-repo wet lane (LocalRepoWetLane) — rehomed from the dead FalsifierSelfHostWet cadence (falsifier.yml deleted 611fd02770/#8283, 2026-08-15) by dashboard node adhoc-cf84ab88-8dc (2026-09-06). Enrolled in v2.workflow.local_repo_wet_terminal local_repo_wet_schedule; measured wet before scheduling."

// DESIGN section 5 discriminating control — the receipt is an A/B on exactly one axis, not a lone
// green. Both arms write the SAME two file paths into the SAME scratch layout and run the SAME
// emit+build chain; the ONLY difference is whether the provider module actually DEFINES the names
// the consumer references. The green arm (nic_provider_source) defines PilotColor /
// pilot_provider_flag / pilot_provider_default and must cargo-build; the red arm
// (nic_provider_missing_names_source) defines unrelated names instead, so the consumer's
// cross-module references are unresolvable and the chain MUST refuse. Because the two arms differ
// in nothing but cross-module name availability, a green red-arm would mean the fixture never
// exercised cross-module resolution at all — the vacuity this control exists to catch. What this
// control does NOT prove is the pass itself: proving RED-without-the-pass needs a second gunbc
// built from the pre-pass emitter, which is not a committable artifact. THAT HALF IS CURRENTLY
// UNMECHANIZED — say it plainly rather than let a path imply coverage. It was staged by a hand-run
// dev script (scripts/namespace_import_closure_witness.sh, deleted 2026-07-23 with the rest of
// scripts/); a discriminating control whose only realization is a shell file nobody executes on any
// cadence is coverage by illusion, not a red control (DESIGN section 5), so the file's existence
// was never the proof its citation implied. The method, if reproducing by hand: build the control
// emitter from origin/main's v1_compiler_emit_rust.rs, emit the same fixture closure with each
// binary, and require the with-pass closure to cargo-build and the no-pass closure to fail on
// unresolved names (E0425/E0433). The realization that closes this honestly is the already-declared
// alternative — a modeled cargo-compiling wet witness enrolled in falsifier_self_host_wet_entries,
// which runs on a cadence and counts its own red — and the gap dissolves entirely when
// 04_resolve.dag promotes UnlistedImportUse to is_error_diagnostic=true and the
// reference_derived_use_lines pass is deleted.

data nic_scaffold_dissolution_trigger: DissolutionCondition = unbound_dissolution(description: "SCAFFOLD dissolve-on: nic_provider_source / nic_provider_missing_names_source / nic_consumer_source are hand-authored fixture module sources (String carriers), the meta-harness around the receipt rather than a forked emit path — the emit itself is the real gunbc binary on real bytes. They are embedded rather than committed as .dag files on purpose: the consumer deliberately references a sibling WITHOUT importing it, so committing it under a discovered source root would feed a deliberately-unresolved module to the whole-tree compile-clean gate. DISSOLVES WHEN the step-2 typed refusal lands in the resolver (v1 04_resolve: UnlistedImportUse promoted to an error, or the resolver emitting the use-line intent directly), which deletes the reference_derived_use_lines pass and this receipt with it.")

data nic_provider_source: String = "module witness.pilot.emit_provider\n\ntype PilotColor = PilotRed | PilotGreen | PilotBlue\n\ntype PilotWidget = PilotWidgetA | PilotWidgetB\n\nfn pilot_provider_flag() -> Bool \{ true \}\n\nfn pilot_provider_default() -> PilotColor \{ PilotRed \}\n\nfn pilot_provider_widget_default() -> PilotWidget \{ PilotWidgetA \}\n"

data nic_provider_missing_names_source: String = "module witness.pilot.emit_provider\n\ntype PilotUnrelated = PilotUnrelatedA | PilotUnrelatedB\n\nfn pilot_unrelated_flag() -> Bool \{ false \}\n"

data nic_consumer_source: String = "module witness.pilot.emit_consumer\n\nfn pilot_consumer_flag() -> Bool \{ pilot_provider_flag() \}\n\nfn pilot_consumer_default() -> PilotColor \{ pilot_provider_default() \}\n"

data nic_consumer_partial_import_source: String = "module witness.pilot.emit_consumer_partial\n\nimport witness.pilot.emit_provider { PilotColor }\n\nfn pilot_consumer_partial_default() -> PilotColor \{ pilot_provider_default() \}\n"

data nic_consumer_partial_import_type_source: String = "module witness.pilot.emit_consumer_partial_type\n\nimport witness.pilot.emit_provider { PilotColor }\n\nfn pilot_consumer_partial_type_default() -> PilotWidget \{ pilot_provider_widget_default() \}\n"

// Discriminating arm for the local-decl exclusion in reference_derived_use_lines (the E0255 std_dup
// emitter root, fixed 2026-07-23 smart-crane-730): the consumer DECLARES a type alias whose name
// collides with a provider enum (PilotColor — mirroring dag/std types.dag List/Map vs their
// src/v2/std twins) and references it bare in a signature. The bare-name registry row for
// PilotColor belongs to the provider, so before the exclusion the pass synthesized `pub use
// crate::witness_pilot_emit_provider::PilotColor;` INTO a module that also emits `pub type
// PilotColor = ...` — rustc E0255, cargo refuses. With the exclusion the module's own declaration
// wins and no use-line is synthesized. Verified by execution in both directions 2026-07-23:
// post-fix binary emits no PilotColor use-line and the crate builds; the pre-fix binary
// (origin/main control worktree) emits the self-colliding line. Regressing the exclusion turns this
// arm red by the same E0255.

data nic_consumer_local_homonym_source: String = "module witness.pilot.emit_consumer_local_homonym\n\ntype PilotColor = PilotWidget\n\nfn pilot_local_default() -> PilotColor \{ pilot_provider_widget_default() \}\n"

// The fixture SOURCE tree is mktemp'd under the workspace root (target/, already gitignored), not
// under /tmp, because the v1 CLI's repo-path grant refuses a source path outside the process
// workspace root (cli_run repo_relative_path_normalized, modeled by gunbc.cli_run_repo_grant) — a
// bare mktemp -d source root panics the emit. The OUTPUT dir has no such constraint and stays a
// plain mktemp. target/ rather than a fixed path so concurrent runs cannot collide and so a mid-run
// auto-commit can never capture the fixture (.gitignore is itself a generated artifact —
// hand-editing it drifts the artifact gate).

// THE FAIL-OPEN THIS MIGRATION CLOSES, AND IT IS THE RED ARM RATHER THAN THE GREEN ONES.
//
// This receipt's whole design is an A/B on one axis, and its red arm asserted `red_arm == false`.
// Under a Bool that is satisfied by the provider names being unresolvable AS INTENDED -- and equally
// by the scratch mktemp failing, either fixture write failing, the out-dir mkdir failing, or the
// gunbc process never spawning. Every one of those made the DISCRIMINATING CONTROL PASS. A control
// whose purpose is to catch vacuity was itself vacuous whenever the harness broke, and it would have
// reported green while proving nothing, which is strictly worse than a green arm doing the same.
//
// So the red arm no longer asks "is this false". It asks the two questions separately: was a verdict
// produced at all, and does that verdict decline to license a build. A harness failure answers the
// first with no, and the arm refuses instead of passing.
//
// WHERE THE RESIDUAL ALIASING WENT. A failed gunbc.WitnessBin.Run means EITHER the emitter refused
// the closure -- a real subject answer, and the expected one on the red arm -- OR the binary was
// absent and nothing ran. Both arrive as `emit.success == false` with nothing to tell them apart. It
// is therefore a NO-VERDICT below (NicEmitRunDidNotSucceed) rather than a subject outcome, so it
// cannot license the red arm's refusal claim. The reasoning is beside NicEmissionOutcome.
type NicNoVerdict
  = NicScratchDirNotMade
  | NicPilotDirNotMade
  | NicProviderNotWritten
  | NicConsumerNotWritten
  | NicOutDirNotMade
  | NicEmitRunDidNotSucceed

// THE EMITTER'S ANSWER, AND A FAILED EMIT RUN IS DELIBERATELY NOT ONE OF THEM.
//
// The obvious modelling puts "the emitter refused" here, because on the red arm a refusing emitter IS
// the expected answer. It is left out, and the reason is a hole that only became visible once the red
// arm was written as a positive claim: a failed gunbc.WitnessBin.Run means EITHER the emitter refused
// the closure OR the binary was absent and nothing ran, with nothing in the run record to tell them
// apart. Admitted as a subject outcome, that variant licenses the refusal claim -- so a missing binary
// would satisfy the red arm, which is the very fail-open this migration exists to close, re-entering
// through the outcome type instead of through the conjunction.
//
// So a failed emit run is NicEmitRunDidNotSucceed, a no-verdict. The trade is explicit: a genuine
// emitter refusal on the red arm now reports "subject unreached" and the arm goes RED rather than
// green. That is a false red, it is loud, and someone investigates -- which is the direction DESIGN
// section 5 requires when the alternative is a silent false green.
//
// DISSOLVES WHEN the emitter prints its own refusal marker, the way the self-host drivers already
// print theirs, at which point "refused" becomes observable rather than inferred from an exit status
// and moves back into this type as a real answer.
type NicEmissionOutcome
  = NicEmitProducedNoLib
  | NicCrateBuilds
  | NicCrateDoesNotBuild

fn nic_outcome_builds(outcome: NicEmissionOutcome) -> Bool {
  match outcome {
    NicCrateBuilds => true
    NicCrateDoesNotBuild => false
    NicEmitProducedNoLib => false
  }
}

// THE RED ARM'S LICENSING PREDICATE, INVERTED HERE RATHER THAN BY NEGATING THE CALL. This is the
// corpus form (v2.std.verdict verdict_establishes_divergence): the negative arm is expressed as a
// POSITIVE claim -- the comparison ran and it disagreed -- so the no-verdict standings answer false to
// this predicate and to the building one alike. A broken bench reaches neither claim and satisfies
// neither arm, and the conjunction is carried by the TYPE rather than by an author remembering to
// write a second assertion beside the first.
fn nic_outcome_declines_to_build(outcome: NicEmissionOutcome) -> Bool {
  match outcome {
    NicCrateDoesNotBuild => true
    NicEmitProducedNoLib => true
    NicCrateBuilds => false
  }
}

fn nic_emitted_crate_evidence(
  root: String,
  gunbc_bin: String,
  provider_source: String,
  consumer_source: String,
  consumer_rel: String
) -> SubjectEvidence<NicNoVerdict, NicEmissionOutcome> {
  let src = shell.Mktemp.DirWithTemplate(
    template: concat(root, "/target/namespace_import_closure_witness_XXXXXX")
  )
  if src.success {
    let pilot_dir = shell.Mkdir.Parents(path: concat(src.path, "/witness/pilot"))
    if pilot_dir.success {
      let provider = Filesystem.Write(
        path: concat(src.path, "/witness/pilot/emit_provider.dag"),
        content: provider_source
      )
      if provider.success {
        let consumer = Filesystem.Write(
          path: concat(src.path, consumer_rel),
          content: consumer_source
        )
        if consumer.success {
          let out = shell.Mktemp.Dir()
          if out.success {
            let emit = gunbc.WitnessBin.Run(
              workdir: root,
              bin_path: gunbc_bin,
              args: [
                "compile",
                "--source-root", src.path,
                "--entry", concat(src.path, consumer_rel),
                "--output-dir", out.path,
                "--target", "rust",
                "--dependency-pool-index", "primary-precedence"
              ]
            )
            if emit.success {
              let emitted_lib = shell.Test.IsFile(path: concat(out.path, "/src/lib.rs"))
              let outcome = if emitted_lib.is_file {
                let build = cargo.Build.BuildManifest(
                  workdir: out.path,
                  manifest_path: concat(out.path, "/Cargo.toml"),
                  target_dir: concat(out.path, "/target")
                )
                if build.success { NicCrateBuilds } else { NicCrateDoesNotBuild }
              } else {
                NicEmitProducedNoLib
              }
              let cleanup_src = shell.Remove.RecursiveForce(path: src.path)
              let cleanup_out = shell.Remove.RecursiveForce(path: out.path)
              EvidenceSubjectCompleted { outcome: outcome }
            } else {
              let cleanup_src = shell.Remove.RecursiveForce(path: src.path)
              let cleanup_out = shell.Remove.RecursiveForce(path: out.path)
              EvidenceSubjectUnreached { cause: NicEmitRunDidNotSucceed }
            }
          } else {
            EvidenceInstrumentRefused { cause: NicOutDirNotMade }
          }
        } else {
          EvidenceInstrumentRefused { cause: NicConsumerNotWritten }
        }
      } else {
        EvidenceInstrumentRefused { cause: NicProviderNotWritten }
      }
    } else {
      EvidenceInstrumentRefused { cause: NicPilotDirNotMade }
    }
  } else {
    EvidenceInstrumentRefused { cause: NicScratchDirNotMade }
  }
}

// A GREEN ARM: the subject answered, and its answer licenses a build.
fn nic_arm_builds(evidence: SubjectEvidence<NicNoVerdict, NicEmissionOutcome>) -> Bool {
  subject_evidence_establishes(evidence: evidence, licenses: fn(o) { nic_outcome_builds(outcome: o) })
}

// THE RED ARM AS A POSITIVE CLAIM. Not `!nic_arm_builds(...)` and not `... == false`: both of those
// are satisfied by a standing that never reached the subject, which is the vacuity. There is no
// negation anywhere in this expression, so there is no polarity for a future edit to get wrong.
fn nic_arm_refuses(evidence: SubjectEvidence<NicNoVerdict, NicEmissionOutcome>) -> Bool {
  subject_evidence_establishes(
    evidence: evidence,
    licenses: fn(o) { nic_outcome_declines_to_build(outcome: o) }
  )
}

fn nic_behavioral_receipt_holds() -> Bool {
  let root = git.Inspect.Toplevel()
  let gunbc_built = witness_bin_ready(root: root.path, bin: witness_bin(var_name: "GUNBC", bin_name: "gunbc"))
  let gunbc_bin = witness_bin_release_path(root: root.path, bin_name: "gunbc")

  let green_arm = nic_emitted_crate_evidence(
    root: root.path,
    gunbc_bin: gunbc_bin,
    provider_source: nic_provider_source,
    consumer_source: nic_consumer_source,
    consumer_rel: "/witness/pilot/emit_consumer.dag"
  )
  let partial_import_arm = nic_emitted_crate_evidence(
    root: root.path,
    gunbc_bin: gunbc_bin,
    provider_source: nic_provider_source,
    consumer_source: nic_consumer_partial_import_source,
    consumer_rel: "/witness/pilot/emit_consumer_partial.dag"
  )
  let partial_import_type_arm = nic_emitted_crate_evidence(
    root: root.path,
    gunbc_bin: gunbc_bin,
    provider_source: nic_provider_source,
    consumer_source: nic_consumer_partial_import_type_source,
    consumer_rel: "/witness/pilot/emit_consumer_partial_type.dag"
  )
  let local_homonym_arm = nic_emitted_crate_evidence(
    root: root.path,
    gunbc_bin: gunbc_bin,
    provider_source: nic_provider_source,
    consumer_source: nic_consumer_local_homonym_source,
    consumer_rel: "/witness/pilot/emit_consumer_local_homonym.dag"
  )
  let red_arm = nic_emitted_crate_evidence(
    root: root.path,
    gunbc_bin: gunbc_bin,
    provider_source: nic_provider_missing_names_source,
    consumer_source: nic_consumer_source,
    consumer_rel: "/witness/pilot/emit_consumer.dag"
  )

  gunbc_built
    && nic_arm_builds(evidence: green_arm)
    && nic_arm_builds(evidence: partial_import_arm)
    && nic_arm_builds(evidence: partial_import_type_arm)
    && nic_arm_builds(evidence: local_homonym_arm)
    && nic_arm_refuses(evidence: red_arm)
}
