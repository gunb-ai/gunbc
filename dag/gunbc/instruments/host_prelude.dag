module gunbc.instruments.host_prelude

import extdeps.shell
import extdeps.rust.cargo { cargo_default_release_dir }
import extdeps.rust.cargo_build
import extdeps.git
import extdeps.git.inspect
import extdeps.gunbc
import gunbc.cli_services
import gunbc.cli_invoke { source_root_transport_argv, invocation_words_bare }
import gunbc.gunbc_cli_command {
  TestBatchMode, HermeticBatch, WetBatch, RecordBatch, gunbc_test_batch_invocation_words
}
import extdeps.bazel.label { LabelParse, LabelParsed, LabelRefused, parse_label, render_label, label_refusal_text }
import gunbc.output_policy { OutcomeIsData }
import gunbc.ci.ci_release_bins { gunbc_release_bin_name, release_bin_is_enrolled }
import std.logic { Bool }
// THE ONE AUTHORITY FOR THE HERMETIC/WET/RECORD AXIS. The route a claim batch is asked on is not a
// boolean local to this builder: `std.execution_mode` owns that axis, and the harness's own parser
// (`claim_batch.rs`, the `--wet` / `--hermetic` / `--record` arms) reads the same three-valued thing.
import std.execution_mode { ExecutionMode, Hermetic, Record, Wet }
import std.optional { Optional, Present, Absent, optional_present }

data witness_invocation_doc: String = "Shared witness-binary invocation. A dag/gunbc/instruments transport states WHICH binaries must exist (WitnessBin: prereqs + the one to invoke) and its argv Strings; this module realizes that intent as TYPED service operations (shell.Test.IsExecutable, cargo.Build.Build, gunbc.WitnessBin.Run at the git.Inspect.Toplevel root) - no bash is serialized or executed on the run path, per the shell-emission-model rule that runtime-present sites are argv invocations wearing bash syntax and need no shell. The former ShellProgram builders (witness_bin_program, gunbc_claims_program) and ensure_bin_built_and_verified shell-stmt chain dissolved with the typed WitnessBin path (Phase D, 2026-07-14). This module no longer has a shell path at all: toolchain_provision_shell_exec was its last one, and it is deleted. Its three callers in gunbc.instruments.emit_host_transport now run shell.Exec.Run directly, because they need the script's STDOUT -- the byte count and probe marker they compare in-substrate -- and a helper returning only Bool is exactly the collapse those call sites exist to undo."

type WitnessBin {
  var_name: String
  bin_name: String
  features: String
}

fn witness_bin(var_name: String, bin_name: String) -> WitnessBin {
  WitnessBin { var_name: var_name, bin_name: bin_name, features: "" }
}

fn witness_bin_release_path(root: String, bin_name: String) -> String {
  // The release artifact lives under cargo's DEFAULT output tree for the repo build (the build
  // below runs without --target-dir, so cargo decides the location) -- the join is the fn's, not
  // spelled here, so build side and read-back side derive from one convention.
  join([cargo_default_release_dir(build_root: root), "/", bin_name], "")
}

fn witness_bin_build_args(bin: WitnessBin) -> List<String> {
  if bin.features == "" {
    ["-p", "v1-compiler", "--release", "--bin", bin.bin_name]
  } else {
    ["-p", "v1-compiler", "--release", "--features", bin.features, "--bin", bin.bin_name]
  }
}

data witness_bin_readiness_note: String = "Witness-binary readiness is a TYPED, LOCATED verdict, not a Bool. Before this carrier existed every prerequisite failure collapsed to one false, so 'the binary was never built', 'the build failed', 'the build reported success but produced nothing', and 'the artifact is a zero-byte stub' were indistinguishable at every call site — a state-space conflation on the diagnostic (gunbc.design_argument::fail_closed). Note precisely what it was NOT: the arm returned false and the gate failed, so the line STOPPED; a widen returns true. What was missing was the location, not the stop. The gate OUTCOME is unchanged by this typing — every non-Ready state still fails the gate — so this buys diagnosis, not permission.

Each refusal names the bin and the path it was looked for at, because the two incidents that price this distinction are both invisible under a bare false. (1) The sccache exit-0-no-binary flake: cargo returns success and writes no artifact, so build_ok is true and the release path is absent — WitnessBinArtifactAbsent, which under the old shape read identically to a compile error. (2) ctrl-build silently routing to the remote builder: it compiles COMMITTED code only, so a local edit appears to have no effect and the artifact on disk is stale or missing rather than wrong. A zero-byte artifact gets its own arm for the same reason — an executable-but-empty file is a distinct failure from a missing one, and collapsing them hides which of the two occurred.

The three-way probe is honest about what the shell can actually observe: shell.Test.IsFile separates absent from present, IsExecutable separates a present non-executable file from a runnable one, IsNonEmpty separates the zero-byte stub. No arm claims a distinction the probes cannot make."

type WitnessBinRefusalReason
  = WitnessBinNotEnrolled
  | WitnessBinBuildFailed
  | WitnessBinArtifactAbsent
  | WitnessBinArtifactNotExecutable
  | WitnessBinArtifactEmpty

type WitnessBinReadiness
  = WitnessBinReady { path: String }
  | WitnessBinRefused { bin_name: String, path: String, reason: WitnessBinRefusalReason }

// THE REFUSAL AS A CARRIED VALUE, for receipts whose own outcome is a std.subject_evidence
// SubjectEvidence: the refused arm becomes EvidenceInstrumentRefused { cause: WitnessBinRefusal },
// so a receipt that could not run its binary is a located instrument refusal and never a
// behavioral false. Each caller builds it only inside its match on a WitnessBinRefused arm, so its
// fields are that arm's, never a second observation.
type WitnessBinRefusal {
  bin_name: String
  path: String
  reason: WitnessBinRefusalReason
}

// The three probes below are annotated OutcomeIsData (operator ruling 2026-07-25). A non-zero exit
// from `test -f`/`-x`/`-s` here means SUBJECT ABSENT — an answer, not a fault — and it is ambient
// in BOTH of this helper's contexts: the production readiness path (witness_bin_run_if_ready,
// below) responds by building, and the build-artifact red controls respond by asserting the refusal
// arm. Because the arm is correct for every caller, it is annotatable HERE, once, with no
// expectation threaded through this production signature and no ambient frame left open.
// ADMISSIBILITY (the gunbc.design_argument::fail_closed guard in gunbc.output_policy outcome_is_data_note): this fn returns
// WitnessBinReadiness — a typed verdict whose arms ARE the adjudication — never unit, so the exit
// provably feeds a typed consumer. What stays anomalous is dispatch failure: if the probe itself
// cannot run, that is not an exit code and does not travel this arm.

fn witness_bin_artifact_readiness(bin_name: String, path: String) -> WitnessBinReadiness {
  let is_file = shell.Test.IsFile(path: path, expect: OutcomeIsData)
  if is_file.is_file {
    let exec = shell.Test.IsExecutable(path: path, expect: OutcomeIsData)
    if exec.executable {
      let nonempty = shell.Test.IsNonEmpty(path: path, expect: OutcomeIsData)
      if nonempty.nonempty {
        WitnessBinReady { path: path }
      } else {
        WitnessBinRefused { bin_name: bin_name, path: path, reason: WitnessBinArtifactEmpty }
      }
    } else {
      WitnessBinRefused { bin_name: bin_name, path: path, reason: WitnessBinArtifactNotExecutable }
    }
  } else {
    WitnessBinRefused { bin_name: bin_name, path: path, reason: WitnessBinArtifactAbsent }
  }
}

fn witness_bin_readiness_is_ready(readiness: WitnessBinReadiness) -> Bool {
  match readiness {
    WitnessBinReady { path: _ } => true
    WitnessBinRefused { bin_name: _, path: _, reason: _ } => false
  }
}

// The ONE rendering of a refusal for callers whose own outcome carries its cause as text
// (gunbc.instruments.emission_entry_instrument EmissionSubjectUnestablished). It names the bin, the path it was looked for at, and the arm, so a
// reader of that cause can tell an unbuilt binary from a failed build from a zero-byte stub.

fn witness_bin_refusal_reason_name(reason: WitnessBinRefusalReason) -> String {
  match reason {
    WitnessBinNotEnrolled => "not-enrolled"
    WitnessBinBuildFailed => "build-failed"
    WitnessBinArtifactAbsent => "artifact-absent"
    WitnessBinArtifactNotExecutable => "artifact-not-executable"
    WitnessBinArtifactEmpty => "artifact-empty"
  }
}

fn witness_bin_refusal_cause(bin_name: String, path: String, reason: WitnessBinRefusalReason) -> String {
  concat("witness binary ", concat(bin_name, concat(" refused (", concat(witness_bin_refusal_reason_name(reason: reason), concat(") at ", path)))))
}

// Enrollment wall first (gunbc.ci.ci_release_bins.release_bin_is_enrolled): an unenrolled bin_name
// refuses as WitnessBinNotEnrolled and never reaches cargo.Build — that is the construction close
// of the mid-floor cold-monolith absorption the release-bins pack exists to bound (roster
// dissolve_on for the former ci_floor_required_artifact_names hand list). The presence probe below
// is OutcomeIsData for the same reason as witness_bin_artifact_readiness: a non-zero `test -x`
// means NOT BUILT YET, which is the question this fn asks, and the production arm answers it by
// building while the red control answers it by asserting refusal. The cargo.Build.BuildInheritEnv
// call further down is DELIBERATELY NOT annotated, and the distinction is worth stating because
// both effects sit in the same typed fn. The gunbc.design_argument::fail_closed guard's LETTER admits both — this fn returns
// WitnessBinReadiness and the build's exit is folded into WitnessBinRefused. Its SPIRIT does not: a
// failing `cargo build` in the production path is a genuine fault an engineer wants shouted, not an
// observation about the subject's state. Silencing it would trade a fake anomaly (which the guard
// exists to remove) for a hidden real one (which is what the whole arc is about). So it stays loud
// pending an operator call; the residual ❌ that proves discrimination for
// no_fake_anomalies_witness_test is carried by typed_witness_bin_run_loud_failure_red_control_holds
// (unannotated WitnessBin.Run of /bin/false — cheap), not by the unenrolled WitnessBin path which
// now refuses before cargo.

fn witness_bin_ensure_built_typed(root: String, bin: WitnessBin) -> WitnessBinReadiness {
  let path = witness_bin_release_path(root: root, bin_name: bin.bin_name)
  if !release_bin_is_enrolled(bin_name: bin.bin_name) {
    WitnessBinRefused { bin_name: bin.bin_name, path: path, reason: WitnessBinNotEnrolled }
  } else {
    let present = shell.Test.IsExecutable(path: path, expect: OutcomeIsData)
    if present.executable {
      witness_bin_artifact_readiness(bin_name: bin.bin_name, path: path)
    } else {
      let built = cargo.Build.BuildInheritEnv(workdir: root, extra_args: witness_bin_build_args(bin: bin))
      if built.success {
        witness_bin_artifact_readiness(bin_name: bin.bin_name, path: path)
      } else {
        WitnessBinRefused { bin_name: bin.bin_name, path: path, reason: WitnessBinBuildFailed }
      }
    }
  }
}

// witness_bin_ready_seed is the fold IDENTITY for 'nothing has refused yet', not a claim that a
// binary at the empty path is ready. witness_bin_readiness_then only ever replaces it — the seed
// cannot escape a non-empty fold, and an empty prereq list falls straight through to the invoke
// bin's own check. The fold carries the FIRST refusal and stops probing after it: once a
// prerequisite has refused, checking the rest would build binaries for a run that cannot happen,
// and the first refusal is the one that located the fault.

fn witness_bin_ready_seed() -> WitnessBinReadiness {
  WitnessBinReady { path: "" }
}

fn witness_bin_readiness_then(acc: WitnessBinReadiness, root: String, bin: WitnessBin) -> WitnessBinReadiness {
  match acc {
    WitnessBinRefused { bin_name: _, path: _, reason: _ } => acc
    WitnessBinReady { path: _ } => witness_bin_ensure_built_typed(root: root, bin: bin)
  }
}

fn witness_bin_program_readiness(root: String, prereqs: List<WitnessBin>, invoke: WitnessBin) -> WitnessBinReadiness {
  let after_prereqs = fold(prereqs, init: witness_bin_ready_seed(), f: (acc, b) =>
    witness_bin_readiness_then(acc: acc, root: root, bin: b))
  witness_bin_readiness_then(acc: after_prereqs, root: root, bin: invoke)
}

fn run_witness_bin_ready_program(root: String, invoke: WitnessBin, args: List<String>) -> Bool {
  let result = gunbc.WitnessBin.Run(
    workdir: root,
    bin_path: witness_bin_release_path(root: root, bin_name: invoke.bin_name),
    args: args
  )
  result.success
}

fn run_witness_bin_program(invoke: WitnessBin, prereqs: List<WitnessBin>, args: List<String>) -> Bool {
  let root = git.Inspect.Toplevel()
  match witness_bin_program_readiness(root: root.path, prereqs: prereqs, invoke: invoke) {
    WitnessBinRefused { bin_name: _, path: _, reason: _ } => false
    WitnessBinReady { path: _ } =>
      run_witness_bin_ready_program(root: root.path, invoke: invoke, args: args)
  }
}

fn run_witness_bin(var_name: String, bin_name: String, args: List<String>) -> Bool {
  run_witness_bin_program(
    invoke: witness_bin(var_name: var_name, bin_name: bin_name),
    prereqs: [],
    args: args
  )
}

type ClaimRun {
  entry: String
  function: String
}

fn gunbc_claims_readiness() -> WitnessBinReadiness {
  let root = git.Inspect.Toplevel()
  witness_bin_ensure_built_typed(
    root: root.path,
    bin: witness_bin(var_name: "CLAIM_BATCH", bin_name: "claim_batch")
  )
}

// One child process per CALL, not per claim (2026-07-23, the floor redundant-work ledger's
// cold-child class — #7106 levers 2/3, corrected mechanism in the attribution doc section 9): the
// per-claim fold spawned one cold `gunbc run --claim-run` process per row, serial, each re-deriving
// the module index and closure resolve from scratch — the batch walls were the SUM of those
// children (~26/run, ~23 of 48 floor minutes), invisible to resolves_total by process boundary. The
// realization is now ONE `claim_batch` child per call carrying every row (claim_batch's own
// pre-existing pooled grammar: repeated --entry groups with --function rows, one shared
// MultiEntryIndex per process — srv1 counterfactual receipts: single cold child 47.2s; 12 claims
// pooled 93.4s vs 480s serial). The vehicle is deliberately a SEPARATE process, never in-executor
// evaluation: the executor is the 16GiB-pinned process of the 2026-07-23 crawl, and adding claim
// closures to its retention trades the time disease for the memory one; the child dies and frees.
// Verdict semantics preserved by claim_batch's own loop: every row runs (no short-circuit), each
// failure is NAMED per-function (PASS f / FAIL f lines), exit nonzero iff any failed — the same
// conjunction the per-process fold computed, with strictly more reporting. Residue — one pool build
// per call — dissolves on the cross-process content-keyed typed-module store
// (docs/plans/compile-wall-endgame.md W3).

fn claim_batch_claim_args(acc: List<String>, last_entry: String, c: ClaimRun) -> List<String> {
  if c.entry == last_entry {
    concat(acc, ["--function", c.function])
  } else {
    concat(acc, ["--entry", c.entry, "--function", c.function])
  }
}

fn claim_batch_claims_argv(source_roots: List<String>, claims: List<ClaimRun>) -> List<String> {
  claim_batch_claims_argv_route(source_roots: source_roots, claims: claims, mode: Wet)
}

// THE ARGV WITH ITS ROUTE CHOSEN BY THE CALLER. `claim_batch_claims_argv` has always appended `--wet`,
// which is correct for its own pooled call and for every caller that means "run the wet lane", but it
// hard-codes one roster's route onto every consumer. The known-red instrument must ask a wet-schedule
// subject on the wet route and a `floor_expected_red` roster-only subject on the HERMETIC route (the
// roster's own governing route), because a subject run on a route its expectation does not govern answers
// a question nobody asked. The route is a value the CALLER owns, so it is a parameter here, not a
// constant folded into the builder -- and it is `std.execution_mode`'s `ExecutionMode`, not a boolean of
// this module's own: the harness's own parser (`claim_batch.rs`) reads exactly this three-valued axis, so
// a two-valued spelling here would be a second name for one concept (gunbc.design_argument::minimize_redundancy, gunbc.design_argument::single_authority) and would silently
// collapse `Record`. Each variant maps to the flag the harness already gives it; Hermetic is the harness
// default, so it adds no flag rather than inventing one.
fn claim_batch_claims_argv_route(
  source_roots: List<String>,
  claims: List<ClaimRun>,
  mode: ExecutionMode
) -> List<String> {
  let grouped = fold(
    claims,
    init: ClaimBatchArgvAcc { args: [], last_entry: "" },
    f: fn(st, c) {
      ClaimBatchArgvAcc {
        args: claim_batch_claim_args(acc: st.args, last_entry: st.last_entry, c: c),
        last_entry: c.entry
      }
    }
  )
  let route_flags = match mode {
    Hermetic => ["--claim-run"]
    Wet => ["--claim-run", "--wet"]
    Record => ["--claim-run", "--record"]
  }
  concat(concat(source_root_transport_argv(roots: source_roots), grouped.args), route_flags)
}

// THE SAME REQUEST ON THE ONE ROUTE: `gunbc test` with one operand per claim, one mode, one corpus, ONE
// process. This is the invocation that replaces `claim_batch ... --claim-run` for the pooled prelude, and it is
// spelled by `gunbc.gunbc_cli_command` `gunbc_test_batch_invocation_words` rather than here -- this module's
// business is WHICH claims and on which route, never how the verb's flags are written (a call site that spelled
// its own `--wet` is how two entrypoints came to mean two things by the same roster).
//
// THE MEMORY BOUNDARY MOVES RATHER THAN DISAPPEARING. `claim_batch` ran the pooled set in one process of its
// own; the verb re-execs itself into the user work slice when it owes one (`target_invocation_host`
// `reexec_into_user_work_slice_if_owed`, then `apply_memory_cgroup_bind`), so the pooled batch keeps a child
// process with the envelope, and one process still: the operands are a list, not a loop over `gunbc test`.
//
// WHY AN OPERAND IS DERIVED FROM THE CLAIM RATHER THAN TYPED. `ClaimRun` is the roster's row: a module FILE and
// a function. The route names claims by LABEL, and a label typed at a call site can name a target that does not
// exist and still look like a conforming call -- so the derivation is one function, it is total, and a row whose
// entry is not a claim module is REFUSED loudly rather than rendered into a plausible-looking label.
type ClaimOperandAdmission
  = ClaimOperand { label: String }
  | ClaimOperandUnnameable { entry: String, function: String, reason: String }

// THE CLAIM'S IDENTITY, AS THE ROUTE READS IT: `//test/claim/<module>:<function>`, rendered by
// `extdeps.bazel.label` `render_label` rather than by concatenation, so the label this instrument runs is the
// label the route reports and the label the corpus declares. The entry must be a `test/claim/` module under the
// `dag/` root: that is where the route's universe lives (`claim_route_universe`), and an entry from anywhere
// else means the roster row is not a claim module -- which is refused, because the alternative is a wrong label
// that the child process refuses late with exit 2 after a runner has been paid for.
fn claim_identity_operand(entry: String, function: String) -> ClaimOperandAdmission {
  let prefix = "dag/test/claim/"
  if !entry.starts_with(prefix) {
    ClaimOperandUnnameable {
      entry: entry,
      function: function,
      reason: "the entry is not a module under the dag/test/claim claim universe",
    }
  } else if !entry.ends_with(".dag") {
    ClaimOperandUnnameable {
      entry: entry, function: function, reason: "the entry is not a .dag module path"
    }
  } else {
    // THE PATH IS REBUILT BY REPLACING, NOT SLICED. A list index in this language is optional and an
    // off-by-one in a slice is silent, while `replace` on a string that was just checked to carry the
    // marker once is total. The count check is what keeps "once" honest: `split` on the marker yields
    // n+1 pieces, so a module name carrying `.dag` twice is refused rather than guessed about -- and a
    // name like that is a roster row this instrument should not be improvising a label for.
    let rest = entry.replace(from: prefix, to: "")
    if count(rest.split(delimiter: ".dag")) != 2 {
      ClaimOperandUnnameable {
        entry: entry,
        function: function,
        reason: "the module name carries more than one .dag suffix",
      }
    } else {
      let package_path = rest.replace(from: ".dag", to: "").replace(from: "/", to: ".")
      match parse_label(text: concat(concat(concat("//", package_path), ":"), function)) {
        // THE LABEL IS PARSED, NOT ASSUMED. `extdeps.bazel.label` is the authority on what a label is, and
        // it refuses the set forms (`TargetPattern`), a `.` segment, a relative path, a repository
        // qualifier. Asking it is what makes "the operands are exact labels" a property of the builder
        // rather than a hope about the roster: a row whose function was spelled `:all` -- the widening the
        // plan forbids a caller to do -- arrives here as a refusal with the authority's own reason.
        LabelParsed { label: label } => ClaimOperand { label: render_label(l: label) }
        LabelRefused { cause: cause } => ClaimOperandUnnameable {
          entry: entry, function: function, reason: label_refusal_text(r: cause)
        }
      }
    }
  }
}

type TestClaimsArgv
  = TestClaimsArgvBuilt { argv: List<String> }
  | TestClaimsArgvRefused { entry: String, function: String, reason: String }

// THE POOLED REQUEST, ADMITTED BEFORE IT IS RUN. Every operand is derived first and the FIRST unnameable row
// refuses the whole batch: a batch that silently dropped a claim would report the pooled observation as complete
// while measuring less than the roster asked for, which is the failure this instrument exists to catch in other
// people's harnesses. Overlaps are the route's to resolve (it selects from the discovered corpus, so a claim two
// operands denote is enrolled once); this builder does not de-duplicate, because a roster that repeats a row is
// reporting its own shape and the fold's duplicate detector is the authority on what that means.
fn gunbc_test_claims_argv(
  source_roots: List<String>,
  claims: List<ClaimRun>,
  mode: TestBatchMode
) -> TestClaimsArgv {
  let admitted = fold(
    claims,
    init: TestClaimsOperandAcc { operands: [], refused: Absent },
    f: fn(st, c) {
      // THE FIRST UNNAMEABLE ROW IS KEPT AND THE REST ARE NOT EXAMINED FOR A VERDICT, though their operands
      // still accumulate: what the caller must see is the row that made the batch unrunnable, and `Absent`
      // rather than an empty string is what distinguishes "nothing was refused" from "something was refused
      // whose text happened to be empty" -- a refusal carried as a string would collapse the two.
      match st.refused {
        Present { value: row } => TestClaimsOperandAcc { operands: st.operands, refused: optional_present(value: row) }
        Absent => match claim_identity_operand(entry: c.entry, function: c.function) {
          ClaimOperand { label: label } =>
            TestClaimsOperandAcc { operands: concat(st.operands, [label]), refused: Absent }
          ClaimOperandUnnameable { entry: entry, function: function, reason: reason } =>
            TestClaimsOperandAcc {
              operands: st.operands,
              refused: optional_present(value: TestClaimsArgvRefusalParts {
                entry: entry, function: function, reason: reason
              }),
            }
        }
      }
    }
  )
  match admitted.refused {
    Present { value: parts } => TestClaimsArgvRefused {
      entry: parts.entry, function: parts.function, reason: parts.reason
    }
    Absent => TestClaimsArgvBuilt {
      argv: invocation_words_bare(
        words: gunbc_test_batch_invocation_words(
          operands: admitted.operands, mode: mode, source_roots: source_roots
        )
      )
    }
  }
}

// THE FOLD'S STATE. The refusal is an `Optional` over the operand list, not a list of refusals and not a string:
// a list needs an index to read (optional in this language, so the read would need its own refusal arm) and a
// string would let a row containing the separator look like a clean batch.
// WHAT THE FOLD REMEMBERS ABOUT A REFUSAL. The row's three facts are copied into their own record rather than
// carried as `ClaimOperandUnnameable`, because that sum has a second arm this fold can never store, and matching
// it again at the end would require an arm for a case whose only meaning is "the fold put the wrong thing in the
// slot" -- a branch that can only ever report a bug in the function that contains it. Matching the `Optional`
// alone is exhaustive, and the invariant is in the type instead of in a comment.
type TestClaimsArgvRefusalParts {
  entry: String
  function: String
  reason: String
}

type TestClaimsOperandAcc {
  operands: List<String>
  refused: Optional<TestClaimsArgvRefusalParts>
}

type ClaimBatchArgvAcc {
  args: List<String>
  last_entry: String
}

// THE POOLED PRELUDE CLAIM REQUEST, ON THE ONE ROUTE. One `gunbc test` process, one operand per roster
// row, WET: the mode the pooled lane has always run (`claim_batch_claims_argv` folded `--wet` in as a
// constant; here it is the value the call site names, so the lane's route is readable without opening the
// builder). `claim_batch_claims_argv` stays alive below for the callers that have not been migrated yet --
// the known-red subjects and three witnesses -- and the deletion of the legacy entrypoint is gated on
// those, not on this line. The executable is the roster's `gunbc_release_bin_name`, not a second literal
// for the same artifact: the pack's listing, the promotion check and this spawn must not be three
// spellings that happen to agree (`gunbc.ci.ci_release_bins` `gunbc_release_bin_name`).
//
// A REFUSED ROW FAILS THE PRELUDE, IT DOES NOT SILENTLY VANISH. Before this call site could name an
// operand, `claim_batch` took the roster's FILE and FUNCTION and ran whatever it found there; here a row
// that is not a module of the claim universe refuses with the row and a reason, and the gate gets `false`
// -- the same verdict a failing child gives, arriving without paying for a child that would only exit 2.
fn run_gunbc_claims_ready(source_roots: List<String>, claims: List<ClaimRun>) -> Bool {
  let root = git.Inspect.Toplevel()
  match gunbc_test_claims_argv(source_roots: source_roots, claims: claims, mode: WetBatch) {
    TestClaimsArgvRefused { entry: _, function: _, reason: _ } => false
    TestClaimsArgvBuilt { argv: argv } => {
      let result = gunbc.WitnessBin.Run(
        workdir: root.path,
        bin_path: witness_bin_release_path(root: root.path, bin_name: gunbc_release_bin_name),
        args: argv
      )
      result.success
    }
  }
}

fn run_gunbc_claims(source_roots: List<String>, claims: List<ClaimRun>) -> Bool {
  match gunbc_claims_readiness() {
    WitnessBinRefused { bin_name: _, path: _, reason: _ } => false
    WitnessBinReady { path: _ } =>
      run_gunbc_claims_ready(source_roots: source_roots, claims: claims)
  }
}
