module tools.seed_growth_change_population

import extdeps.git.inspect
import gunbc.rust_item_host_observation {
  observe_rust_item_change_against,
  RustItemChangeObserved, RustItemChangeUnattributed,
  RustItemChangeScanRefused, RustItemChangeHostRefused,
  item_declaration_ref, projected_declaration_refs, projected_refused_keys,
  projected_uncitable_keys,
  ItemDeclarationRefProjection,
  ItemDeclarationRefProjected, ItemDeclarationRefUncitable, ItemDeclarationRefRefused
}
import gunbc.rust_item_identity { rust_item_identity_key }
import gunbc.seed_growth_admission { seed_growth_unjustified_additions }
import gunbc.repo_identity { gunbc_merge_target_ref }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.types { List, String }
import v2.std.algebra { fold_list, length }

// THE POPULATION AN AUTHOR MUST NOT COUNT BY HAND.
//
// gunbc.seed_growth_admission seed_growth_forward_freeze_policy_note retired the authored hand-item
// and hand-LOC deltas on the ground that they are functions of the diff, and it names the remaining
// gap exactly: the join EXECUTES and is CALLABLE, and no required CI phase invokes it. This is the
// callable end -- the entry point that runs the join over the live change so a receipt's coverage is
// re-derived rather than transcribed. It is NOT the missing phase, and running it green here does
// not retire that trigger; a required-run phase that stops the line is what does.
//
// WHY THE JOIN AND NOT seed_growth_admit_change. The full verdict additionally demands an
// AuthorizedTemporarySeedBridge per added item -- gunbc.capability_origin's origin test, a separate
// obligation with its own evidence. Answering the roster-coverage question through a function that
// also refuses for a missing bridge would report one deficit under another's name.
//
// SCOPE, STATED SO A GREEN RUN IS NOT OVERREAD: this reports items whose DeclarationRef is absent
// from the roster, items no DeclarationRef can address at all, and items under a source tree
// rust_source_namespace_rows does not claim. It does not check that a row which EXISTS is true, well
// formed, or still needed.
//
// AND WHAT IT IS NOT, stated because the reverse claim was made and was wrong. This is the callable
// ROSTER-COVERAGE DIAGNOSTIC. A required admission phase may reuse its observation and coverage
// components, but must retain the full admission authority's obligations -- seed_growth_admit_change
// takes change, live, bridges and evidence, performs the origin checks, and preserves diagnostics
// this entry point deliberately omits, and the policy's next-rung trigger names stopping the line on
// SeedGrowthAdmissionRefused specifically. Scheduling THIS function would not establish that
// trigger.

fn item_key_lines(keys: List<String>) -> String {
  fold_list(xs: keys, empty: "", cons: fn(acc, k) { concat(acc, concat("  ", concat(k, "\n"))) })
}

// The enumeration, for an author writing or auditing a SeedGrowthJustification row. Inline modules
// are SCOPES and not leaves: gunbc.rust_item_host_observation item_declaration_ref_in folds
// enclosing_module into each member's module_path, so a module row does not cover its members and a
// roster naming only the module under-reports the change.
fn population_summary() -> String {
  match observe_rust_item_change_against(base_ref: gunbc_merge_target_ref as String) {
    RustItemChangeHostRefused { detail: d } => concat("HOST REFUSED: ", d)
    RustItemChangeUnattributed { repo_path: p, line: _, detail: d } =>
      concat("UNATTRIBUTED ", concat(p, concat(": ", d)))
    RustItemChangeScanRefused { repo_path: p, line: _, line_text: _, detail: d } =>
      concat("SCAN REFUSED ", concat(p, concat(": ", d)))
    RustItemChangeObserved {
      added_hand_items: added,
      modified_hand_items: modified,
      deleted_hand_items: _,
      generated_changes: _
    } =>
      concat(
        concat("ADDED HAND ITEMS:\n", item_key_lines(
          keys: added |> map(i => declaration_key_of(item_projection: item_declaration_ref(item: i)))
        )),
        concat("MODIFIED HAND ITEMS (disposition owed, not netted):\n", item_key_lines(
          keys: modified |> map(i => rust_item_identity_key(item: i))
        ))
      )
  }
}

fn declaration_key_of(item_projection: ItemDeclarationRefProjection) -> String {
  match item_projection {
    ItemDeclarationRefProjected { ref: r } => concat(r.module_path as String, concat("::", r.decl_name as String))
    ItemDeclarationRefUncitable { item_key: k, detail: _ } => concat("UNCITABLE ", k)
    ItemDeclarationRefRefused { item_key: k, detail: _ } => concat("UNADDRESSABLE ", k)
  }
}

// THE VERDICT HALF, AND ITS OWN PARTIAL-OBSERVER REPAIR.
//
// item_declaration_ref has THREE outcomes and a first cut of this function decided success from
// TWO. projected_declaration_refs excludes both uncitable and refused projections and
// projected_refused_keys collects only the refused ones, so an added item classified
// ItemDeclarationRefUncitable -- gunbc.rust_item_host_observation classifies RustImplMethod and
// RustImplBlock that way, since std.decl_ref cannot name a method on an impl block -- fell out of
// both lists and the run exited SUCCESS reporting neither the item nor the limitation. That is the
// same defect this branch exists to repair, committed by the instrument that measures it: a partial
// observer reporting its own reach as the population.
//
// THE THREE CAUSES ARE CARRIED TOGETHER RATHER THAN RANKED. An arm that reports the first
// non-empty list and stops would hide the others behind it, so the refusal carries all three and is
// complete only when every one is empty. They are genuinely different obligations: unaddressable is
// a source tree rust_source_namespace_rows does not claim, uncitable is an item no DeclarationRef
// can spell AT ALL -- not a row an author can add -- and unjustified is a missing roster row.
type RosterCoverageVerdict
  = RosterCoverageComplete
  | RosterCoverageRefused {
      unaddressable: List<String>,
      uncitable: List<String>,
      unjustified: List<String>
    }

// The decision, over projections alone, so a control can hand it a population no diff on this branch
// produces. main and every witness reach the verdict through THIS function.
fn roster_coverage_verdict(projections: List<ItemDeclarationRefProjection>) -> RosterCoverageVerdict {
  let unaddressable = projected_refused_keys(projections: projections)
  let uncitable = projected_uncitable_keys(projections: projections)
  let unjustified = seed_growth_unjustified_additions(
    added: projected_declaration_refs(projections: projections)
  )
  if length(xs: unaddressable) == 0 && length(xs: uncitable) == 0 && length(xs: unjustified) == 0 {
    RosterCoverageComplete
  } else {
    RosterCoverageRefused {
      unaddressable: unaddressable,
      uncitable: uncitable,
      unjustified: unjustified
    }
  }
}

fn labelled_keys(label: String, keys: List<String>) -> String {
  if length(xs: keys) == 0 {
    ""
  } else {
    concat(label, concat("\n", item_key_lines(keys: keys)))
  }
}

fn coverage_refusal_reason(verdict: RosterCoverageVerdict) -> String {
  match verdict {
    RosterCoverageComplete => ""
    RosterCoverageRefused {
      unaddressable: unaddressable,
      uncitable: uncitable,
      unjustified: unjustified
    } =>
      concat(
        labelled_keys(
          label: "added hand Rust item(s) live under a tree rust_source_namespace_rows does not claim:",
          keys: unaddressable
        ),
        concat(
          labelled_keys(
            label: "added hand Rust item(s) that NO DeclarationRef can address, so no roster row can cover them -- this is a citation-representation limit in std.decl_ref, not a row an author can add:",
            keys: uncitable
          ),
          labelled_keys(
            label: "added hand Rust item(s) lack a SeedGrowthJustification row:",
            keys: unjustified
          )
        )
      )
  }
}

// A refusal to OBSERVE is a refusal here too, never an empty population reported as coverage --
// that is the absorbing fallback DESIGN section 5 forbids.
func main() -> ProcessExit {
  match observe_rust_item_change_against(base_ref: gunbc_merge_target_ref as String) {
    RustItemChangeHostRefused { detail: d } =>
      exit_failure(reason: concat("the change population was not observed: ", d))
    RustItemChangeUnattributed { repo_path: p, line: _, detail: d } =>
      exit_failure(reason: concat("changed hand Rust could not be attributed to an item in ", concat(p, concat(": ", d))))
    RustItemChangeScanRefused { repo_path: p, line: _, line_text: _, detail: d } =>
      exit_failure(reason: concat("hand Rust source could not be read at item grain in ", concat(p, concat(": ", d))))
    RustItemChangeObserved {
      added_hand_items: added,
      modified_hand_items: _,
      deleted_hand_items: _,
      generated_changes: _
    } =>
      match roster_coverage_verdict(
        projections: added |> map(i => item_declaration_ref(item: i))
      ) {
        RosterCoverageComplete => ExitSuccess
        RosterCoverageRefused {
          unaddressable: unaddressable,
          uncitable: uncitable,
          unjustified: unjustified
        } =>
          exit_failure(reason: coverage_refusal_reason(
            verdict: RosterCoverageRefused {
              unaddressable: unaddressable,
              uncitable: uncitable,
              unjustified: unjustified
            }
          ))
      }
  }
}
