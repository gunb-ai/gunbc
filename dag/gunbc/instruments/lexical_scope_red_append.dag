
fn literal_and_qualified_subject() -> String {
  "module v2.test.subject\n\nfn subject() -> String {\n  \"v2.std.logic\"\n}\n\nfn uses() -> Bool {\n  v2.std.logic.and(a: true, b: true)\n}\n"
}

test fn a_dotted_string_literal_is_not_a_reference_site() -> Bool {
  head_of_site(content: literal_and_qualified_subject(), spelling: "v2.std.logic") == "no-site"
}
