module tools.dag_compile_clean_shard_transport

import extdeps.shell
import extdeps.git
import extdeps.git.inspect
import extdeps.gunbc
import std.logic { Bool }
import v2.std.subject_evidence { EvidenceInstrumentRefused, EvidenceSubjectCompleted, SubjectEvidence, subject_evidence_establishes }
import tools.host_prelude {
  WitnessBin,
  witness_bin,
  witness_bin_ensure_built_typed,
  WitnessBinReady,
  WitnessBinRefused,
  WitnessBinRefusal
}
import tools.dag_compile_clean_transport {
  dcc_fixture_only_compile_args
}

// The exemplar is carried as its directory and its file name, so the staged copy's --entry path is
// the declared file name rather than a segment recovered from a joined path.
data shard_a_exemplar_entry_dir: String = "dag/std"
data shard_a_exemplar_entry_file: String = "logic.dag"

fn shard_a_exemplar_entry_path() -> String {
  concat(shard_a_exemplar_entry_dir, concat("/", shard_a_exemplar_entry_file))
}

// The compiler binary is gated typed and first: an unready gunbc is an EvidenceInstrumentRefused
// carrying its WitnessBinRefusal, so "the compile never ran" no longer shares a value with "the
// module was unclean" at this site (gunbc.predicate_cause_aliasing_roster). The compiler is a
// parameter so the refusal arm is reachable by a control that supplies an unready binary
// (test.claim.dag_compile_clean_shard_a_witness), not only by breaking the real one.
fn single_module_shard_compile_typed(compiler: WitnessBin, entry_dir: String, entry_file: String) -> SubjectEvidence<WitnessBinRefusal, Bool> {
  let root = git.Inspect.Toplevel()
  match witness_bin_ensure_built_typed(root: root.path, bin: compiler) {
    WitnessBinRefused { bin_name: b, path: p, reason: r } =>
      EvidenceInstrumentRefused { cause: WitnessBinRefusal { bin_name: b, path: p, reason: r } }
    WitnessBinReady { path: gunbc_bin } => EvidenceSubjectCompleted {
      outcome: single_module_shard_compile_staged(root: root.path, gunbc_bin: gunbc_bin, entry_dir: entry_dir, entry_file: entry_file)
    }
  }
}

fn single_module_shard_compile_staged(root: String, gunbc_bin: String, entry_dir: String, entry_file: String) -> Bool {
  let stage = shell.Mktemp.Dir()
  if stage.success {
    let staged = shell.Copy.File(
      source: concat(root, concat("/", concat(entry_dir, concat("/", entry_file)))),
      destination: stage.path
    )
    let compile = gunbc.WitnessBin.Run(
      workdir: root,
      bin_path: gunbc_bin,
      args: dcc_fixture_only_compile_args(tmp: stage.path, entry_file: entry_file)
    )
    let cleaned_stage = shell.Remove.RecursiveForce(path: stage.path)
    staged.success && compile.success && cleaned_stage.success
  } else {
    false
  }
}

fn run_shard_a_exemplar_compile_evidence() -> SubjectEvidence<WitnessBinRefusal, Bool> {
  single_module_shard_compile_typed(
    compiler: witness_bin(var_name: "GUNBC", bin_name: "gunbc"),
    entry_dir: shard_a_exemplar_entry_dir,
    entry_file: shard_a_exemplar_entry_file
  )
}

// The receipt with a compiler that is not an enrolled release bin: witness_bin_ensure_built_typed
// refuses it as WitnessBinNotEnrolled before any cargo build, so this reaches the refusal arm of
// the real receipt route at the cost of one git toplevel and one enrollment lookup.
fn run_shard_a_exemplar_compile_with_unenrolled_compiler() -> SubjectEvidence<WitnessBinRefusal, Bool> {
  single_module_shard_compile_typed(
    compiler: witness_bin(var_name: "NO_SUCH", bin_name: "no_such_witness_bin_zzz"),
    entry_dir: shard_a_exemplar_entry_dir,
    entry_file: shard_a_exemplar_entry_file
  )
}

// The per-PR claims over these receipts keep a Bool surface that asserts the
// EvidenceSubjectCompleted arm through subject_evidence_establishes, so an unready compiler still
// cannot read as a pass; the typed evidence is each _evidence fn. The claim files are left
// unedited: their hermetic route gaps on IsExecutable (v2.workflow.floor_route_gap) and they have
// no wet route, so an edit plans them into a floor that cannot give them a verdict.
fn run_shard_a_exemplar_compile() -> Bool {
  subject_evidence_establishes(evidence: run_shard_a_exemplar_compile_evidence(), licenses: fn(held) { held })
}
