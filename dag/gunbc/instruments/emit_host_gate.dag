module tools.emit_host_gate

import std.process { ProcessExit, ExitSuccess, exit_failure }
import tools.emit_host_transport {
  run_rust_smoke,
  run_python_smoke,
  run_go_smoke,
  run_ts_smoke,
  run_node_http_serve_smoke,
  run_c_smoke
}

// The gate previously folded five smoke Bools into one refusal whose reason named no smoke —
// and the claim wrapper (emit_host_gate_passes = exit_ok(run_spec_gate)) discards the reason entirely,
// so a floor failure surfaced as bare Bool(false) and locating the failing language took log
// archaeology (receipt: the 2026-07-13 srv3 reprovisioning reds — five runs of forensics to name
// the ts/go/node toolchain gap, operator-signed fix same day). The failure arm now carries the
// per-smoke verdict line as the ExitFailure reason, and the claim path carries that reason typed
// end to end: `ClaimOutcome::ExitFailure` in the executor (cli_run.rs `run_claim`), printed on
// the claim_batch FAIL row, and published as the terminal ledger's detail field under the
// "exit-failure" tag (v2.workflow.floor_terminal_ledger_wire readback_disposition).
//
// NARRATION DISSOLVED 2026-09-13 (gentle-gull-238). The failure arm used to ALSO shell the
// verdict line out through shell.Exec.Run of shell_printf_line (the sanctioned printf-with-
// escaping builder in gunbc.shell_bash_runner — never naive echo concat) so it would surface in
// the claim executor's shell narration beside the FAIL row, because the claim path itself could
// not carry the reason. That scaffold (emit_host_verdict_narration_scaffold) and its dissolve-on
// (emit_host_verdict_narration_dissolution_trigger) are deleted with this edit: the trigger fired
// on its first named arm — "the claim path carries typed refusal reasons to the executor surface
// (ExitFailure.reason printed for gate-class claim rows)" — and the reason field is the single
// carrier. Narration was failure-arm-only (the floor log stays quiet on green, matching the
// typecheck-attribution threshold precedent); the reason preserves that property, since it exists
// only on the failure path. The residual wrapper-side gap is NOT this module's: the Bool witness
// emit_host_gate_passes still collapses the reason at exit_ok, governed by std.process's own
// comment and the floor_effect_gate_witness mute frontier (its declared receipt path is the
// <witness>_failure_receipt companion) — and no executing lane has claimed the wrapper since the
// emit_host_transport.dag census note recorded the gate consumerless (2026-07-26; re-verified by
// roster grep 2026-09-13).

fn smoke_verdict(name: String, ok: Bool) -> String {
  concat(name, if ok { "=pass" } else { "=FAIL" })
}

fn join_space(parts: List<String>) -> String {
  fold(parts, init: "", f: (acc, p) => match acc { "" => p _ => concat(acc, concat(" ", p)) })
}

fn smoke_verdict_line(rust: Bool, python: Bool, go: Bool, ts: Bool, node_http: Bool, c: Bool) -> String {
  concat("emit-host smoke verdicts: ", join_space(parts: [
    smoke_verdict(name: "rust", ok: rust),
    smoke_verdict(name: "python", ok: python),
    smoke_verdict(name: "go", ok: go),
    smoke_verdict(name: "ts", ok: ts),
    smoke_verdict(name: "node_http", ok: node_http),
    smoke_verdict(name: "c", ok: c)
  ]))
}

fn gate_failure_exit(rust: Bool, python: Bool, go: Bool, ts: Bool, node_http: Bool, c: Bool) -> ProcessExit {
  exit_failure(
    reason: smoke_verdict_line(rust: rust, python: python, go: go, ts: ts, node_http: node_http, c: c)
  )
}

fn run_emit_host_gate_body() -> ProcessExit {
  rust = run_rust_smoke()
  python = run_python_smoke()
  go = run_go_smoke()
  ts = run_ts_smoke()
  node_http = run_node_http_serve_smoke()
  c = run_c_smoke()
  return if rust && python && go && ts && node_http && c {
    ExitSuccess
  } else {
    gate_failure_exit(rust: rust, python: python, go: go, ts: ts, node_http: node_http, c: c)
  }
}

fn main() -> ProcessExit {
  run_emit_host_gate_body()
}

fn run_emit_host_ci_gate() -> ProcessExit {
  run_emit_host_gate_body()
}
