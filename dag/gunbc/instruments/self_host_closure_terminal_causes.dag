// THE QUERY THE REPAIR LANES RUN: the files one cause explains, and how many. Folds over the rows,
// never a second per-cause roster - a hand-authored list beside the rows is the fork this shape
// exists to avoid.
fn rows_for_cause(cause: Symbol) -> List<ClosureFileRow> {
  filter(xs: closure_refusal_rows, predicate: fn(row) { any(xs: row.causes, predicate: fn(c) { c == cause }) })
}

// The rows recorded for one path. A table is keyed by path, so this answering anything other than a
// one-element list is a defect of the table itself, and the witness over it asks exactly that - by
// COUNTING the rows for each path rather than by looking for a pair that disagrees, because two
// identical duplicate rows disagree about nothing and would slip past a disagreement test.
fn rows_for_path(path: String) -> List<ClosureFileRow> {
  filter(xs: closure_refusal_rows, predicate: fn(row) { row.path == path })
}

fn cause_population(cause: Symbol) -> Int {
  length(xs: rows_for_cause(cause: cause))
}

// THE TWO DIRECTIONS OF THE FILE-TO-CAUSE RELATION, as functions rather than as a transcribed
// number: no row is left without a cause, no rostered cause goes unnamed by any row, and no row
// names a cause the roster does not carry. All three are properties of THIS table, decidable from
// it alone, which is why a witness can assert them without re-measuring the tree - and why they
// stay true statements rather than a measure() == measure() change detector.
fn every_row_names_a_cause() -> Bool {
  !any(xs: closure_refusal_rows, predicate: fn(row) { length(xs: row.causes) == 0 })
}

fn every_cause_names_a_row() -> Bool {
  !any(xs: front_end_causes, predicate: fn(c) { cause_population(cause: c.key) == 0 })
}

// EVERY REFUSING PATH IS A CLOSURE MEMBER. This is the join that keeps the subject honest: the
// driver's context fold reports refusals for every source in whatever roots it was given, so a row
// whose path is not in the manifest is a row that leaked in from a wider run and the table is then
// measuring something other than the closure. Its red is authorable - a single foreign path in the
// rows turns it false - which a comparison of the row count against a pinned width was not.
fn every_refusing_path_is_a_closure_member() -> Bool {
  !any(xs: closure_refusal_rows, predicate: fn(row) {
    !any(xs: closure_module_manifest, predicate: fn(member) { member == row.path })
  })
}

// A ROW'S TERMINAL REASON MUST BE ONE ITS OWN NAMED CAUSES REPORTS. This is the table's central
// semantic claim asked of itself: terminal_reason is the diagnostic that actually refused the file,
// every cause record carries the terminal reason ITS defect produces, so a row naming only causes that
// refuse at some other stage is a mis-join - and a repair lane citing that key would go hunting the
// wrong defect in the right file. A row may name several causes and only one need match, because a
// file can carry defects that never got to speak: only the one that refused first is terminal.
fn row_terminal_reason_is_named_by_one_of_its_causes(row: ClosureFileRow) -> Bool {
  any(xs: row.causes, predicate: fn(c) {
    any(xs: front_end_causes, predicate: fn(rec) {
      rec.key == c && rec.terminal_reason == row.terminal_reason
    })
  })
}

fn every_row_terminal_reason_is_named_by_a_cause() -> Bool {
  !any(xs: closure_refusal_rows, predicate: fn(row) {
    !row_terminal_reason_is_named_by_one_of_its_causes(row: row)
  })
}

// THE MANIFEST IS A SET, and a repeated path would double-count the denominator every row is a
// fraction of. Quadratic over the manifest by construction; the fold's shape is what is priced, not
// the realized width.
fn every_closure_module_appears_once() -> Bool {
  !any(xs: closure_module_manifest, predicate: fn(m) {
    length(xs: filter(xs: closure_module_manifest, predicate: fn(x) { x == m })) != 1
  })
}

// THE CONTROL'S INPUT, WHICHEVER ARM IT CAME FROM. Every reader of a control goes through here, so
// every reader has eliminated the verdict - which is the point of carrying it as a constructor.
fn control_input(control: NearestAlternativeControl) -> String {
  match control {
    ControlThatAccepts { input: i } => i
    ControlThatRefusesIdentically { input: i } => i
  }
}

// WHAT THE CLOSURE-IDENTITY ARM CLAIMS, ASKED OF THE ROWS. That arm means the cause was joined to its
// files by an identity join over the whole closure with no exceptions - so every row carrying that
// cause's terminal reason must name it. The weaker signature arm claims nothing of the kind and is not
// asked for it. Red is authorable in both directions: move a cause onto the executed arm without that
// coverage, or drop the cause from one row of its class.
fn causes_joined_by_closure_identity() -> List<FrontEndCause> {
  filter(xs: front_end_causes, predicate: fn(c) {
    match c.join_evidence {
      JoinedByExecutedClosureIdentityJoin => true
      JoinedByExecutedNeutralizer => false
      JoinedBySignatureOverIsolatedDeclaration => false
    }
  })
}

fn every_closure_identity_cause_covers_its_class() -> Bool {
  !any(xs: causes_joined_by_closure_identity(), predicate: fn(c) {
    any(xs: closure_refusal_rows, predicate: fn(row) {
      row.terminal_reason == c.terminal_reason
        && !any(xs: row.causes, predicate: fn(k) { k == c.key })
    })
  })
}

// A NEAREST-ALTERNATIVE CONTROL THAT IS A COPY OF EITHER NAMED INPUT VARIES NOTHING, so its arm reads
// as separating evidence while separating nothing. Two records were authored that way and a reviewer
// caught them; this makes the shape unwritable in the carrier instead. It reads the control through
// control_input, so it eliminates the verdict arm on every record it checks.
fn no_cause_reuses_a_named_input_as_its_control() -> Bool {
  !any(xs: front_end_causes, predicate: fn(c) {
    control_input(control: c.discriminating_control) == c.positive_control
      || control_input(control: c.discriminating_control) == c.rejecting_reproducer
  })
}

fn every_row_cause_is_rostered() -> Bool {
  !any(xs: closure_refusal_rows, predicate: fn(row) {
    any(xs: row.causes, predicate: fn(c) {
      !any(xs: front_end_causes, predicate: fn(rostered) { rostered.key == c })
    })
  })
}
