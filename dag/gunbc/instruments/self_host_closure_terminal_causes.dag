// THE SHORTCUT RECEIPT. Three observations of the pinned head, and the two pairings that isolate one
// variable each. It carries identities and an outcome, never rows: the members themselves are the
// table above, and a second copy of them keyed by join would be the duplication this file exists to
// avoid.
type ObservationRoot
  = ClosureOnlyRoot
  | WholeTreeRoot

type ShortcutObservation {
  label: Symbol
  root: ObservationRoot
  driver_binary_digest: String
  order_insensitive_closure_digest: String
}

type IsolatedVariable
  = DriverBinaryIsolated
  | SourceRootIsolated

// A DISAGREEMENT MUST NAME ITS MEMBERS. An outcome that could say "they differed" without saying where
// would be the absorbing arm: unfalsifiable, unactionable, and indistinguishable from not having
// looked. The variant makes the members unskippable when the answer is not agreement.
type JoinOutcome
  = EveryMemberAgreed
  | MembersDisagreed { members: List<String> }

type ShortcutJoin {
  isolates: IsolatedVariable
  left: Symbol
  right: Symbol
  outcome: JoinOutcome
}

// ONE CLOSURE FILE THAT REFUSED, keyed by the path the driver reported. causes names every cause
// found in the file, so the lists are not disjoint and their lengths do not sum to the row count.
type ClosureFileRow {
  path: String
  terminal_reason: Symbol
  causes: List<Symbol>
}

data closure_observation_pin: ObservationPin = ObservationPin {
  head_sha: "2fb67b411aecfccfce1c2642ebc724df0a755585"
  emitted_closure_identity_as_reported: "c1136b4a6f89b4a20222f9341e997a47b05d483550db190678f9019229d94321"
  order_insensitive_closure_digest: "27d8a7018ec18c43371410a7c0b0d3beabbe0f9021ef81e9e8b2b70cb632c5b3"
  emitted_driver_binary_digest: "f939a936d39d504e320a0f6ab059b0ab7dc1432367536279c48304188a81c182"
  compiler_source_manifest_digest: "9a728cd46a611232fcefc66d7885f31f03e91fa522a01695131427b5bf8330ef"
  grammar_prepare_residue_total: 7
}

data front_end_causes: List<FrontEndCause> = [
  FrontEndCause {
    key: ^A
    id: ^where_refinement_clause
    terminal_reason: ^parse_g0_tokens_remain
