// THE QUERY THE REPAIR LANES RUN: the files one cause explains, and how many. Folds over the rows,
// never a second per-cause roster - a hand-authored list beside the rows is the fork this shape
// exists to avoid.
fn rows_for_cause(cause: Symbol) -> List<ClosureFileRow> {
  filter(xs: closure_refusal_rows, predicate: fn(row) { any(xs: row.causes, predicate: fn(c) { c == cause }) })
}

// The rows recorded for one path. A table is keyed by path, so this answering anything other than a
// one-element list is a defect of the table itself, and the witness over it asks exactly that - by
// COUNTING the rows for each path rather than by looking for a pair that disagrees, because two
// identical duplicate rows disagree about nothing and would slip past a disagreement test.
fn rows_for_path(path: String) -> List<ClosureFileRow> {
  filter(xs: closure_refusal_rows, predicate: fn(row) { row.path == path })
}

fn cause_population(cause: Symbol) -> Int {
  length(xs: rows_for_cause(cause: cause))
}

// THE TWO DIRECTIONS OF THE FILE-TO-CAUSE RELATION, as functions rather than as a transcribed
// number: no row is left without a cause, no rostered cause goes unnamed by any row, and no row
// names a cause the roster does not carry. All three are properties of THIS table, decidable from
// it alone, which is why a witness can assert them without re-measuring the tree - and why they
// stay true statements rather than a measure() == measure() change detector.
fn every_row_names_a_cause() -> Bool {
  !any(xs: closure_refusal_rows, predicate: fn(row) { length(xs: row.causes) == 0 })
}

fn every_cause_names_a_row() -> Bool {
  !any(xs: front_end_causes, predicate: fn(c) { cause_population(cause: c.key) == 0 })
}

fn every_row_cause_is_rostered() -> Bool {
  !any(xs: closure_refusal_rows, predicate: fn(row) {
    any(xs: row.causes, predicate: fn(c) {
      !any(xs: front_end_causes, predicate: fn(rostered) { rostered.key == c })
    })
  })
}
