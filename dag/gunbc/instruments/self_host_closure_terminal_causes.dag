// ONE CLOSURE FILE THAT REFUSED, keyed by the path the driver reported. causes names every cause
// found in the file, so the lists are not disjoint and their lengths do not sum to the row count.
type ClosureFileRow {
  path: String
  terminal_reason: Symbol
  causes: List<Symbol>
}

data closure_observation_pin: ObservationPin = ObservationPin {
  head_sha: "2fb67b411aecfccfce1c2642ebc724df0a755585"
  emitted_closure_identity_as_reported: "c1136b4a6f89b4a20222f9341e997a47b05d483550db190678f9019229d94321"
  order_insensitive_closure_digest: "2f926173a675387ec2cbbf1c2229ea23491dda72640578de64b1b567634831a0"
  emitted_driver_binary_digest: "f939a936d39d504e320a0f6ab059b0ab7dc1432367536279c48304188a81c182"
  compiler_source_manifest_digest: "9a728cd46a611232fcefc66d7885f31f03e91fa522a01695131427b5bf8330ef"
  grammar_prepare_residue_total: 7
}

data front_end_causes: List<FrontEndCause> = [
  FrontEndCause {
    key: ^A
    id: ^where_refinement_clause
    terminal_reason: ^parse_g0_tokens_remain
    rejecting_reproducer: "type A = NonEmptyStr where brand(\"A\")"
    positive_control: "type A = NonEmptyStr"
    discriminating_control: ControlThatRefusesIdentically { input: "type A = NonEmptyStr where true" }
    join_evidence: JoinedByExecutedNeutralizer
  },
  FrontEndCause {
    key: ^B
    id: ^module_body_without_a_function_declaration
    terminal_reason: ^namespace_graft_body_dissolved_refused
    rejecting_reproducer: "module m\\n\\ntype A {\\n  x: Int\\n}"
    positive_control: "module m\\n\\ntype A {\\n  x: Int\\n}\\n\\nfn f() -> Int {\\n  1\\n}"
    discriminating_control: ControlThatAccepts { input: "module m\\n\\ntest fn t() -> Bool {\\n  true\\n}" }
    join_evidence: JoinedByExecutedClosureIdentityJoin
  },
  FrontEndCause {
    key: ^C
    id: ^string_literal_containing_a_raw_newline
    terminal_reason: ^tokenize_lex_e1_unrecognized_char
    rejecting_reproducer: "data d: String = \"line one<RAW NEWLINE>line two\""
    positive_control: "data d: String = \"line one\\\\nline two\""
    discriminating_control: ControlThatAccepts { input: "data d: String = \"an em dash \\u2014 here\"" }
    join_evidence: JoinedByExecutedClosureIdentityJoin
  },
  FrontEndCause {
    key: ^D
    id: ^single_arm_match
    terminal_reason: ^body_lowering_reason_match_arm_navigation_refused
    rejecting_reproducer: "match t {\\n  _ => 1\\n}"
    positive_control: "match t {\\n  A => 1\\n  _ => 2\\n}"
    discriminating_control: ControlThatAccepts { input: "match t {\\n  A => 1\\n  B { x: v } => v\\n  _ => 3\\n}" }
    join_evidence: JoinedBySignatureOverIsolatedDeclaration
  },
  FrontEndCause {
    key: ^E
    id: ^token_between_a_type_name_and_its_body
    terminal_reason: ^parse_g0_tokens_remain
    rejecting_reproducer: "type S sole_constructor {\\n  x: Int\\n}"
    positive_control: "type S {\\n  x: Int\\n}"
    discriminating_control: ControlThatRefusesIdentically { input: "type S foo {\\n  x: Int\\n}" }
    join_evidence: JoinedByExecutedNeutralizer
  },
  FrontEndCause {
    key: ^F
    id: ^match_as_a_field_name
    terminal_reason: ^body_lowering_reason_match_arm_navigation_refused
    rejecting_reproducer: "type R {\\n  match: Int\\n}\\n\\nfn f(r: R) -> Int {\\n  r.match\\n}"
    positive_control: "type R {\\n  other: Int\\n}\\n\\nfn f(r: R) -> Int {\\n  r.other\\n}"
    discriminating_control: ControlThatAccepts { input: "type R {\\n  loop: Int\\n}\\n\\nfn f(r: R) -> Int {\\n  r.loop\\n}" }
    join_evidence: JoinedBySignatureOverIsolatedDeclaration
  },
  FrontEndCause {
    key: ^G
    id: ^expression_bodied_function
    terminal_reason: ^parse_g0_tokens_remain
    rejecting_reproducer: "fn f(a: Int) -> Int =\\n  a"
    positive_control: "fn f(a: Int) -> Int {\\n  a\\n}"
    discriminating_control: ControlThatRefusesIdentically { input: "fn f(c: Int) -> Int = c + 0" }
    join_evidence: JoinedByExecutedNeutralizer
  },
  FrontEndCause {
    key: ^H
    id: ^as_cast_outside_call_argument_position
    terminal_reason: ^parse_g0_tokens_remain
    rejecting_reproducer: "R { a: x as Hex }"
    positive_control: "R { a: x }"
    discriminating_control: ControlThatAccepts { input: "g(a: x as Hex)" }
    join_evidence: JoinedBySignatureOverIsolatedDeclaration
  },
  FrontEndCause {
    key: ^I
    id: ^match_as_an_infix_operand
    terminal_reason: ^parse_g0_tokens_remain
    rejecting_reproducer: "true && match x {\\n  true => true\\n  false => false\\n}"
    positive_control: "match x {\\n  true => true\\n  false => false\\n}"
    discriminating_control: ControlThatAccepts { input: "let y = match x {\\n  true => true\\n  false => false\\n}" }
    join_evidence: JoinedBySignatureOverIsolatedDeclaration
  },
  FrontEndCause {
    key: ^J
    id: ^numeric_literal_as_a_type_argument
    terminal_reason: ^parse_g0_tokens_remain
    rejecting_reproducer: "type A = MachineWidth<8>"
    positive_control: "type A = MachineWidth<Eight>"
    discriminating_control: ControlThatAccepts { input: "type A = Compose<Int, List<Int>>" }
    join_evidence: JoinedByExecutedNeutralizer
  },
  FrontEndCause {
    key: ^K
    id: ^leading_pipe_in_a_variant_declaration
    terminal_reason: ^parse_g0_tokens_remain
    rejecting_reproducer: "type A\\n  = | B\\n  | C"
    positive_control: "type A\\n  = B\\n  | C"
    discriminating_control: ControlThatAccepts { input: "type A =\\n  B\\n  | C" }
    join_evidence: JoinedByExecutedNeutralizer
  },
  FrontEndCause {
    key: ^L
    id: ^inline_record_type_alias
    terminal_reason: ^parse_g0_tokens_remain
    rejecting_reproducer: "type A = { a: Int, b: Int }"
    positive_control: "type A {\\n  a: Int\\n  b: Int\\n}"
    discriminating_control: ControlThatAccepts { input: "type A = Map<String, String>" }
    join_evidence: JoinedBySignatureOverIsolatedDeclaration
  },
  FrontEndCause {
    key: ^M
    id: ^payload_carrying_constructor
    terminal_reason: ^parse_g0_tokens_remain
    rejecting_reproducer: "type A\\n  = B(Int)\\n  | C"
    positive_control: "type A\\n  = B\\n  | C"
    discriminating_control: ControlThatAccepts { input: "match t {\\n  A(s) => 1\\n  B => 2\\n}" }
    join_evidence: JoinedBySignatureOverIsolatedDeclaration
  },
  FrontEndCause {
    key: ^N
    id: ^brace_literal_as_a_data_value
    terminal_reason: ^parse_g0_tokens_remain
    rejecting_reproducer: "data d: Map<String, String> = {\\n  \"a\": \"b\"\\n}"
    positive_control: "data d: Int = 1"
    discriminating_control: ControlThatAccepts { input: "fn f() -> R {\\n  R {\\n    a: 1\\n  }\\n}" }
    join_evidence: JoinedBySignatureOverIsolatedDeclaration
  },
  FrontEndCause {
    key: ^O
    id: ^negative_numeric_literal
    terminal_reason: ^parse_g0_tokens_remain
    rejecting_reproducer: "fn f() -> Int {\\n  -1\\n}"
    positive_control: "fn f() -> Int {\\n  1\\n}"
    discriminating_control: ControlThatAccepts { input: "fn f(a: Int) -> Int {\\n  a - 1\\n}" }
    join_evidence: JoinedByExecutedNeutralizer
  },
  FrontEndCause {
    key: ^P
    id: ^declaration_keyword_in_expression_position
    terminal_reason: ^parse_g0_tokens_remain
    rejecting_reproducer: "B { module: a }"
    positive_control: "B { thing: a }"
    discriminating_control: ControlThatAccepts { input: "fn f(module: Int) -> Int {\\n  1\\n}" }
    join_evidence: JoinedBySignatureOverIsolatedDeclaration
  },
  FrontEndCause {
    key: ^Q
    id: ^early_return_statement
    terminal_reason: ^parse_g0_tokens_remain
    rejecting_reproducer: "fn f(a: Bool) -> Int {\\n  if a {\\n    return 1\\n  }\\n  2\\n}"
    positive_control: "fn f(a: Bool) -> Int {\\n  if a {\\n    1\\n  } else {\\n    2\\n  }\\n}"
    discriminating_control: ControlThatAccepts { input: "fn f(a: Bool) -> Int {\\n  let x = 1\\n  x\\n}" }
    join_evidence: JoinedByExecutedNeutralizer
  },
  FrontEndCause {
    key: ^R
    id: ^function_value_in_a_data_record_field
    terminal_reason: ^normalized_tree_reason_wrapper_retention_not_normalized
    rejecting_reproducer: "data d: A = A {\\n  meet: (a, b) => a\\n}"
    positive_control: "data d: A = A {\\n  meet: 1\\n}"
    discriminating_control: ControlThatAccepts { input: "fn f() -> A {\\n  A {\\n    meet: (a, b) => a\\n  }\\n}" }
    join_evidence: JoinedBySignatureOverIsolatedDeclaration
  }
]

