module tools.fabric_ci_evidence

import std.types { Bool, Int, List, NonEmptyStr, String }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import v2.std.optional { Present, Absent }
import std.content_hash { ContentHash, content_hash_of_value }

data fabric_ci_evidence_contract_note: String = "FCI-EVIDENCE-0 is the one run-boundary contract inherited by every wet fabric gate. Values, process status and diagnostic rendering are three distinct channels. Assertion entries return ProcessExit. Transport entries return only the framed wire and never decide a verdict. The host driver sequences and checks statuses; semantic comparisons remain in .dag. Six uppercase hexadecimal digits encode each Unicode scalar. The alphabet cannot carry the apostrophe or newline delimiters owned by gunbc run's refusal diagnostic. Fixed width makes concatenation injective without a delimiter, and the decoder rejects bad width, bad digits, surrogate scalars and values beyond Unicode's maximum."

type FabricCiEvidenceRole
  = FabricCiAssertionRole
  | FabricCiTransportRole
  | FabricCiProjectionRole
  | FabricCiHostDriverRole

type FabricCiEvidenceContract {
  roles: List<FabricCiEvidenceRole>
  assertion_result: NonEmptyStr
  transport_status: Int
  projection_requirement: NonEmptyStr
  host_driver_authority: NonEmptyStr
}

data fabric_ci_evidence_contract: FabricCiEvidenceContract = {
  roles: [FabricCiAssertionRole, FabricCiTransportRole, FabricCiProjectionRole, FabricCiHostDriverRole]
  assertion_result: "ProcessExit"
  transport_status: 2
  projection_requirement: "total-distinct-framed-decodable"
  host_driver_authority: "status-and-sequence-only"
}

data fabric_ci_evidence_wire_prefix: NonEmptyStr = "FCIE0X"

type FabricCiEvidenceDecode
  = FabricCiEvidenceDecoded { value: NonEmptyStr }
  | FabricCiEvidenceUndecodable

fn fabric_ci_hex_digit(n: Int) -> String {
  if n == 0 { "0" } else if n == 1 { "1" } else if n == 2 { "2" } else if n == 3 { "3" }
  else if n == 4 { "4" } else if n == 5 { "5" } else if n == 6 { "6" } else if n == 7 { "7" }
  else if n == 8 { "8" } else if n == 9 { "9" } else if n == 10 { "A" } else if n == 11 { "B" }
  else if n == 12 { "C" } else if n == 13 { "D" } else if n == 14 { "E" } else { "F" }
}

fn fabric_ci_hex_scalar(cp: Int) -> String {
  join([
    fabric_ci_hex_digit(n: (cp / 1048576) % 16),
    fabric_ci_hex_digit(n: (cp / 65536) % 16),
    fabric_ci_hex_digit(n: (cp / 4096) % 16),
    fabric_ci_hex_digit(n: (cp / 256) % 16),
    fabric_ci_hex_digit(n: (cp / 16) % 16),
    fabric_ci_hex_digit(n: cp % 16),
  ], "")
}

fn fabric_ci_evidence_wire(value: NonEmptyStr) -> String {
  fold(chars(value as String), init: fabric_ci_evidence_wire_prefix as String, f: fn(acc, cp) {
    concat(acc, fabric_ci_hex_scalar(cp: cp))
  })
}

fn fabric_ci_framed_coordinate(value: NonEmptyStr) -> NonEmptyStr {
  join([to_string(value.length()), ":", value as String], "") as NonEmptyStr
}

fn fabric_ci_framed_coordinates(values: List<NonEmptyStr>) -> NonEmptyStr {
  fold(values, init: join(["coordinates:", to_string(values.length()), ":"], "") as NonEmptyStr, f: fn(acc, value) {
    concat(acc, fabric_ci_framed_coordinate(value: value)) as NonEmptyStr
  })
}

data fabric_ci_shell_crossing_hash_note: String = "The only content-hash entrance for shell-crossing coordinate collections. Callers first project every typed coordinate to its canonical NonEmptyStr wire; a List or record cannot reach content_hash_of_value through this signature."

fn fabric_ci_shell_crossing_coordinates_hash(values: List<NonEmptyStr>) -> ContentHash {
  content_hash_of_value(value: fabric_ci_framed_coordinates(values: values))
}

fn fabric_ci_hex_value(c: String) -> Int? {
  if c == "0" { Present { value: 0 } } else if c == "1" { Present { value: 1 } }
  else if c == "2" { Present { value: 2 } } else if c == "3" { Present { value: 3 } }
  else if c == "4" { Present { value: 4 } } else if c == "5" { Present { value: 5 } }
  else if c == "6" { Present { value: 6 } } else if c == "7" { Present { value: 7 } }
  else if c == "8" { Present { value: 8 } } else if c == "9" { Present { value: 9 } }
  else if c == "A" { Present { value: 10 } } else if c == "B" { Present { value: 11 } }
  else if c == "C" { Present { value: 12 } } else if c == "D" { Present { value: 13 } }
  else if c == "E" { Present { value: 14 } } else if c == "F" { Present { value: 15 } }
  else { none }
}

fn fabric_ci_decode_scalar(wire: String, at: Int) -> Int? {
  match fabric_ci_hex_value(c: char_at(s: wire, i: at)) {
    Absent => Absent
    Present { value: a } => match fabric_ci_hex_value(c: char_at(s: wire, i: at + 1)) {
      Absent => Absent
      Present { value: b } => match fabric_ci_hex_value(c: char_at(s: wire, i: at + 2)) {
        Absent => Absent
        Present { value: c } => match fabric_ci_hex_value(c: char_at(s: wire, i: at + 3)) {
          Absent => Absent
          Present { value: d } => match fabric_ci_hex_value(c: char_at(s: wire, i: at + 4)) {
            Absent => Absent
            Present { value: e } => match fabric_ci_hex_value(c: char_at(s: wire, i: at + 5)) {
              Absent => Absent
              Present { value: f } => Present { value: a * 1048576 + b * 65536 + c * 4096 + d * 256 + e * 16 + f }
            }
          }
        }
      }
    }
  }
}

type FabricCiDecodeState
  = FabricCiDecodeBuilding { value: String }
  | FabricCiDecodeRefused

fn fabric_ci_decode_step(wire: String, at: Int, stop: Int, state: FabricCiDecodeState) -> FabricCiDecodeState {
  match state {
    FabricCiDecodeRefused => FabricCiDecodeRefused
    FabricCiDecodeBuilding { value: value } =>
      if at == stop { FabricCiDecodeBuilding { value: value } } else {
        match fabric_ci_decode_scalar(wire: wire, at: at) {
          Absent => FabricCiDecodeRefused
          Present { value: cp } =>
            if cp > 1114111 || (cp >= 55296 && cp <= 57343) { FabricCiDecodeRefused }
            else { fabric_ci_decode_step(wire: wire, at: at + 6, stop: stop, state: FabricCiDecodeBuilding { value: concat(value, from_code_point(cp)) }) }
        }
      }
  }
}

fn decode_fabric_ci_evidence_wire(wire: String) -> FabricCiEvidenceDecode {
  let prefix_len = fabric_ci_evidence_wire_prefix.length()
  let payload_len = wire.length() - prefix_len
  if !starts_with(wire, prefix: fabric_ci_evidence_wire_prefix as String)
    || payload_len <= 0 || payload_len % 6 != 0 {
    FabricCiEvidenceUndecodable
  } else {
    match fabric_ci_decode_step(wire: wire, at: prefix_len, stop: wire.length(), state: FabricCiDecodeBuilding { value: "" }) {
      FabricCiDecodeRefused => FabricCiEvidenceUndecodable
      FabricCiDecodeBuilding { value: "" } => FabricCiEvidenceUndecodable
      FabricCiDecodeBuilding { value: value } => FabricCiEvidenceDecoded { value: value as NonEmptyStr }
    }
  }
}

type FabricCiCalibrationProjection
  = FabricCiCalibrationAlpha { payload: NonEmptyStr }
  | FabricCiCalibrationBeta { payload: NonEmptyStr }

data fabric_ci_calibration_projection_note: String = "Total and default-free: adding a variant makes fabric_ci_calibration_projection_wire fail to compile until it is framed."

fn fabric_ci_calibration_projection_wire(value: FabricCiCalibrationProjection) -> String {
  match value {
    FabricCiCalibrationAlpha { payload: payload } => join(["alpha|", fabric_ci_evidence_wire(value: payload)], "")
    FabricCiCalibrationBeta { payload: payload } => join(["beta|", fabric_ci_evidence_wire(value: payload)], "")
  }
}

func fabric_ci_calibration_assertion_success() -> ProcessExit { ExitSuccess }

func fabric_ci_calibration_bool_must_refuse() -> Bool { true }

func fabric_ci_calibration_raw_coproduct_must_not_cross() -> FabricCiCalibrationProjection {
  FabricCiCalibrationAlpha { payload: "raw-coproduct" }
}

func fabric_ci_calibration_transport() -> String {
  fabric_ci_evidence_wire(value: fabric_ci_calibration_projection_wire(value: FabricCiCalibrationAlpha { payload: "apostrophe-' newline-\n delimiter-|" }) as NonEmptyStr)
}

func fabric_ci_calibration_assert_transport(wire: String) -> ProcessExit {
  match decode_fabric_ci_evidence_wire(wire: wire) {
    FabricCiEvidenceUndecodable => exit_failure(reason: "FCI-EVIDENCE-0 transport undecodable")
    FabricCiEvidenceDecoded { value: decoded } =>
      if (decoded as String) == fabric_ci_calibration_projection_wire(value: FabricCiCalibrationAlpha { payload: "apostrophe-' newline-\n delimiter-|" }) {
        ExitSuccess
      } else { exit_failure(reason: "FCI-EVIDENCE-0 transported bytes changed") }
  }
}

func fabric_ci_calibration_collapsed_projection_must_red() -> ProcessExit {
  let alpha = fabric_ci_calibration_projection_wire(value: FabricCiCalibrationAlpha { payload: "same" })
  let beta = fabric_ci_calibration_projection_wire(value: FabricCiCalibrationBeta { payload: "same" })
  if alpha == beta || starts_with(alpha, prefix: beta) || starts_with(beta, prefix: alpha) {
    ExitSuccess
  } else { exit_failure(reason: "FCI-EVIDENCE-0 decisive red: projection arms remain distinct") }
}

func fabric_ci_calibration_transport_converted_to_exit() -> ProcessExit { ExitSuccess }
