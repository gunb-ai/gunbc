module gunbc.instruments.pattern_binder_capture_native

import std.types { Int, List, String, Bool }
import std.algebra { fold_list }
import std.optional { Optional, Present, Absent }
import std.compiler_entry { CompilerEntryDriver, NativeClaimDriver, NativeClaimReport, NativeClaimHeld, NativeClaimNotHeld }

// A PATTERN FIELD RENAMED IN AN ARM, WITH THE BODY READING A SAME-NAMED OUTER VARIABLE, ON THE EMITTED
// PATH (v1.compiler.emit_rust emit_pattern_rc_aware). The emitter renders a field binding's pattern under
// a NAME; the class this label fences is any rendering that binds the field under the MATCHED FIELD NAME
// while the arm declared a different variable: the arm body's references to a same-named variable from
// the enclosing scope are then captured by the shadowing pattern binding, and the emitted program reads
// a different variable than the .dag source declares. Confirmed instance (seed emission): both arms of
// v2.compiler.parse parse_expr_not_predicate_attempt -- the .dag binds `table: table1` and reads the
// OUTER parameter `table` for the furthest position; the emitted arm bound the field under `table` and
// aliased `let table1 = table.as_ref()`, so the body's `table.furthest` read the INNER table. The class
// compiles and RUNS -- it is silent, changing which variable is read, never whether it compiles -- so
// the witness must observe a VALUE, which is what this label does: each case holds when the emitted
// function returns what the .dag scoping declares; a lost outer value is a wrong value, and a wrong
// value is NativeClaimNotHeld.
//
//   renamed_bind_capture  the not_predicate_attempt shape itself: arm `AcceptedProbe { ..., table: table1 }`
//                         (renamed Bind leaf), body reads the parameter `table` AND `table1`: expected
//                         77*1000 + 13*10 + 4 + 1 = 77135; a captured outer reads the field and observes
//                         13*1000 + 13*10 + 4 + 1 = 13135.
//   shorthand_bind        the arm binds `table` plainly: binding the field under the field name IS the
//                         declared binding here, so this case holds before and after -- it fences the fix
//                         from over-reaching into shorthand arms.
//   nested_variant_rename the field is destructured with a nested variant pattern (`captured: ShallowProbe
//                         { stamp: s1, marks: _ }`) and NO same-named outer variable exists (the parameter
//                         is outer_payload): the let-else prelude must keep binding s1 correctly before
//                         and after the fix -- a regression guard, expected 5*100 + 2*10 + 1 = 521 on both
//                         legs.
//
// WHAT THIS LABEL DOES NOT REACH (verified by reading the gate, not by running): an arm is lowered by
// emit_pattern_rc_aware only when rc_pattern_analysis_with_box_fields leaves needs_rc_pattern true -- that
// is, when analyze_rc_pattern finds a field whose PATTERN is a variant pattern over a shared (Rc) type, or
// box_bound_fields_for_pattern finds a field whose declared TYPE needs a Box (a recursive type). Every
// fixture type here (ProbeResult, ProbePayload, ProbeSelector, ProbeTable) is non-recursive and
// non-shared, and a renamed Bind leaf never enters ref_bound_fields on its own, so all three arms take the
// ordinary emit_pattern path, which already bound the renamed field under the arm's declared name BEFORE
// the fix. So this label pins the renamed/shorthand/nested renderings at the value level; it is NOT the
// witness for the `field_needs_rc_ref` branch the fix changed. A fixture that reaches that branch needs a
// renamed field whose declared type is recursive (Box-wrapped) or nested over a shared type -- the shape the
// seed instance had (parse_expr_not_predicate_attempt over the Rc-shared parse types).
//
// MISSING EVIDENCE (restore): the two legs -- entry built at the PRE-FIX seed (the seed emission whose
// v2_compiler_parse.rs carries sha 188439f2, pre-fix src/v1/05_emit_rust.dag) exiting NOT-HELD (1), and at
// the fix exiting HELD (0) -- were never pinned on a final green-CI head, and no build runs in the session
// that restored this change. The fix's pair rule IS exercised by the heal regen at head: the seed's real
// rc-ref arms compile only when pattern and prelude share one binder (a half-renamed pair failed heal with
// rustc E0425 `__rc_view`). Nothing here re-executes the pre-fix leg.
//
// NOT ON THE REQUIRED PATH: this label is executed by host runs, not by the required job; the class rung
// is mechanical-by-label, not gate-enrolled (gunbc.recurring_failure_mode
// emitted_pattern_field_bound_under_its_own_name_captures_an_outer_binding).

data compiler_pipeline_entry: CompilerEntryDriver = NativeClaimDriver

type ProbeResult
  = AcceptedProbe { remaining: Int, captured: ProbePayload, diagnostics: List<Int>, table: ProbeTable }
  | RejectedProbe { diagnostics: List<Int>, table: ProbeTable }

type ProbePayload
  = DeepProbe { stamp: Int, marks: List<Int> }
  | ShallowProbe { stamp: Int, marks: List<Int> }

type ProbeTable {
  furthest: Int,
  refusal: Optional<Int>,
  layout: Optional<Int>,
  nullable: List<Int>,
  productions: List<Int>,
  first_rows: List<Int>
}

fn stamp(p: ProbePayload) -> Int {
  match p {
    DeepProbe { stamp: s, marks: _ } => s
    ShallowProbe { stamp: s, marks: _ } => s
  }
}

fn probe_table(furthest: Int) -> ProbeTable {
  ProbeTable { furthest: furthest, refusal: Absent, layout: Absent, nullable: [], productions: [], first_rows: [] }
}

// Case A: the not_predicate_attempt shape. The arm RENAMES `table` to `table1`; the body reads the
// PARAMETER `table` (the outer value the .dag scoping reaches) and the field binding `table1`.
fn observed_capture(table: ProbeTable, result: ProbeResult) -> Int {
  match result {
    AcceptedProbe { remaining: r, captured: cap, diagnostics: _, table: table1 } =>
      table.furthest * 1000 + table1.furthest * 10 + stamp(cap) + r
    RejectedProbe { diagnostics: _, table: table1 } => table1.furthest * 10 + 3
  }
}

// Case B: shorthand binding -- field name IS the declared variable; holds before and after the fix.
fn observed_shorthand(result: ProbeResult) -> Int {
  match result {
    AcceptedProbe { remaining: r, captured: cap, diagnostics: _, table } => table.furthest * 10 + stamp(cap) + r
    RejectedProbe { diagnostics: _, table } => table.furthest * 10 + 3
  }
}

// Case C: the field is destructured by a nested variant pattern (prelude machinery); NO same-named
// outer variable exists to capture (the parameter is named differently), so this case holds on both
// legs -- it fences the let-else prelude for ref-bound fields from regressing under the fix.
fn observed_nested(outer_payload: ProbePayload, result: ProbeResult) -> Int {
  match result {
    AcceptedProbe { remaining: r, captured: ShallowProbe { stamp: s1, marks: _ }, diagnostics: _, table: _ } =>
      stamp(outer_payload) * 100 + s1 * 10 + r
    AcceptedProbe { remaining: _, captured: _, diagnostics: _, table: _ } => 999
    RejectedProbe { diagnostics: _, table: _ } => 998
  }
}

type FixtureCase {
  name: String,
  observed: Int,
  expected: Int
}

fn outer_table() -> ProbeTable { probe_table(furthest: 77) }
fn field_table() -> ProbeTable { probe_table(furthest: 13) }
fn deep_cap() -> ProbePayload { DeepProbe { stamp: 4, marks: [] } }

fn fixture_cases() -> List<FixtureCase> {
  let accepted = AcceptedProbe { remaining: 1, captured: deep_cap(), diagnostics: [], table: field_table() }
  let accepted_c = AcceptedProbe { remaining: 1, captured: ShallowProbe { stamp: 2, marks: [] }, diagnostics: [], table: field_table() }
  [
    FixtureCase { name: "renamed_bind_capture", observed: observed_capture(table: outer_table(), result: accepted), expected: 77135 },
    FixtureCase { name: "shorthand_bind", observed: observed_shorthand(result: accepted), expected: 135 },
    FixtureCase { name: "nested_variant_rename", observed: observed_nested(DeepProbe { stamp: 5, marks: [] }, result: accepted_c), expected: 521 }
  ]
}

fn verdict_word(held: Bool) -> String { if held { "held" } else { "not_held" } }

fn case_line(c: FixtureCase) -> String {
  concat("case ", c.name, " ", verdict_word(held: c.observed == c.expected), " observed=", to_string(value: c.observed), " expected=", to_string(value: c.expected), "\n")
}

fn native_claim_report() -> NativeClaimReport {
  let cases = fixture_cases()
  let failed = count(filter(cases, c => c.observed != c.expected))
  let terminal = if failed > 0 { NativeClaimNotHeld { reason: concat(to_string(value: failed), " fixture(s) read the wrong variable: a pattern field binding captured an outer same-named variable") } } else { NativeClaimHeld }
  NativeClaimReport { stdout: concat("roster ", join(map(cases, c => c.name), ","), "\n", join(map(cases, c => case_line(c: c)), "")), terminal: terminal }
}
