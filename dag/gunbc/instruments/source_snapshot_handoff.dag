import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.fabric_storage {
  FabricObject,
  FabricObjectRef,
  FabricPut,
  FabricObjectStored,
  FabricPutRefused,
  fabric_object_ref_of,
  fabric_object_ref_wire,
}
import gunbc.fabric_storage_file_store {
  FabricStorageFileRoot,
  fabric_storage_file_root,
  fabric_storage_file_root_ensure,
  fabric_storage_object_path,
  fabric_storage_file_put,
  FabricStorageRootStanding,
  FabricStorageRootReady,
  FabricStorageRootRefused,
}
import gunbc.fabric_source_snapshot {
  SourceComposition,
  PublicOnlyComposition,
  PublicAndPrivateComposition,
  SnapshotInclusion,
  SnapshotCapture,
  SnapshotCaptured,
  SnapshotCaptureRefused,
  SnapshotCaptureRefusal,
  SnapshotFileUnreadable,
  SnapshotFileAbsent,
  SnapshotFileEmpty,
  SnapshotPathOutsideComposition,
  SnapshotPathNotRelative,
  SnapshotStoreRefusedObject,
  SnapshotManifestNotStored,
  SnapshotMaterialization,
  SnapshotMaterialized,
  SnapshotMaterializeRefused,
  SnapshotMaterializeRefusal,
  SnapshotManifestUnavailable,
  SnapshotCompositionMismatch,
  SnapshotEntryUnavailable,
  SnapshotEntryMalformed,
  SnapshotEntryOutsideComposition,
  SnapshotEntryPathNotRelative,
  SnapshotDuplicatePath,
  SnapshotDestinationNotCreated,
  ProviderWorkspace,
  ProviderWorkspaceAllocation,
  ProviderWorkspaceAllocated,
  ProviderWorkspaceRefused,
  ProviderRootAdmission,
  ProviderRootAdmitted,
  ProviderRootRefused,
  admit_provider_root,
  provider_root_default,
  allocate_provider_workspace,
  release_provider_workspace,
  provider_workspace_root,
  SnapshotDirectoryNotCreated,
  SnapshotFileNotWritten,
  snapshot_entry_object,
  snapshot_manifest_object,
  capture_source_snapshot,
  materialize_source_snapshot,
  snapshot_leaf_object,
  source_composition_wire,
}
import gunbc.ensure { EnsurePolicy, EnsureObserveOnly }
import gunbc.roadmap_execution_contract {
  ValidationOperation,
  GunbcClaimValidation,
  ClaimSourceRootLayout,
  PinnedPublicPlusLocalRoot,
  ExecutionCapability,
  GunbcClaimRunnerCapability,
  CapabilityRealization,
