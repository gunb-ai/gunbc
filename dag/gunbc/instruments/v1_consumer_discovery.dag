module tools.v1_consumer_discovery

import std.types { Bool, Int, List, String }
import std.decl_ref { DeclarationRef, decl_ref }
import v2.std.algebra { fold_list, list_append, list_snoc_item }
import v2.std.compilers.lexing { symbol_lexeme }
import v2.std.decl_index { DeclFact, decl_facts }
import v2.std.fn_index { atom_identities_in_node }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import v2.std.node { Node, NodeFold, Symbol, fold_node }
import gunbc.v1_consumer_census {
  ConsumerMedium, DagArgvRow,
  V1Subject, V1CompilerCrate, V1Cli, V1Interpreter, V1HostedCiBinary,
  V1ConsumerRow, DiscoveryProducer, discovery_producer,
  v1_row_key, v1cc_boundary,
  v1_consumers, v1_consumers_undisposed
}
import gunbc.replacement_cut { ConsumerDisposition, Undecided }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// THE JOINED PRODUCER gunbc.v1_consumer_census v1_consumer_census_next_rung_trigger names, built
// for the medium where the join is DERIVABLE and refusing to pretend for the rest. The census's
// first named hole is that no producer classifies the .dag argv rows: a v1 binary named in a
// string position inside a .dag declaration is a real consumer relation, and the seven hand sweeps
// that produced the roster read files rather than declarations, so the population was a list of
// what an author remembered to look at.
//
// WHY THE .dag MEDIUM IS THE ONE A SUBSTRATE INSTRUMENT CAN CLOSE, and why the others are not an
// omission this module hides. The census keys a relation at consumer x consumed-authority
// DECLARATION identity. For .dag source both halves are derivable: v2.std.decl_index decl_facts
// carries every declaration in the named roots WITH ITS NODE, so the consumer half is the
// declaration the literal occurs in -- not the file it was greppped out of -- and the literal
// itself names the authority. For Rust, Cargo manifests, committed mirrors and serialized artifact
// paths there is no declaration namespace a text hit can be attributed to at that grain, so a hit
// there cannot become a keyed row without an author inventing the consumer half. That is the
// fabricated-reference move the census already refuses through V1UncitableConsumer, and this
// module does not reopen it: it produces .dag rows and NOTHING ELSE, and says so as its scope
// rather than as a gap discovered later.
//
// IT MINTS NO SUBJECT, MEDIUM, DISPOSITION OR COMPLETENESS VOCABULARY. Every one of those is
// gunbc.v1_consumer_census's or gunbc.replacement_cut's and is imported; the only type declared
// here is the literal-to-authority signature table, which is producer machinery -- what a lexeme
// NAMES -- and answers none of those four questions. The key a discovered row carries is
// v1_row_key's, called rather than re-spelled, so a discovered key and a rostered key cannot
// disagree about their shape.
//
// EVERY DISCOVERED ROW IS Undecided BY CONSTRUCTION, and that is the point rather than a default
// this module was too lazy to improve. Discovery establishes that a relation EXISTS; what should
// happen to it is a judgement against the terminal design, which is the census's authored fact.
// Undecided is what admit_replacement_cut_plan refuses as UndispositionedConsumer, so a newly
// discovered relation BLOCKS the cutover until someone dispositions it in the roster -- the
// direction a census must fail in.

type V1LiteralSignature {
  lexeme: String
  authority: DeclarationRef
  medium: ConsumerMedium
  subject: V1Subject
}

// THE MATCH IS WHOLE-ATOM EQUALITY, NEVER A SUBSTRING, and the cost of that choice is declared
// rather than discovered. An argv row spells its binary as its own atom ("claim_executor", or
// "target/release/gunbc"); a prose data row that happens to mention the same word is a sentence and
// never equals one. Substring matching would have swept every note in the corpus into the consumer
// population, and a census that reports prose as a dependency is worse than one that reports less:
// its blocking column stops meaning anything. What whole-atom equality LOSES is a binary reached
// through a composed path -- concat("target/release/", bin) -- and that loss is exactly why the
// census's population stays PopulationMeasuredLowerBound after this module lands. It narrows the
// hole; it does not close the arm.
//
// THE BARE CLI NAME IS DELIBERATELY NOT A SIGNATURE. "gunbc" is the project's name as well as the
// v1 binary's, so a bare-"gunbc" atom carries no information about which of the two a declaration
// meant, and admitting it would fill the blocking column with rows nobody can disposition. The
// path-qualified spellings below are the discriminating ones. This is a declared lower bound on the
// V1Cli subject, not a claim that the CLI has no other .dag consumers.

fn v1cd_signature(lexeme: String, module_path: String, decl_name: String, subject: V1Subject) -> V1LiteralSignature {
  V1LiteralSignature {
    lexeme: lexeme,
    authority: decl_ref(module_path: module_path, decl_name: decl_name),
    medium: DagArgvRow,
    subject: subject,
  }
}

fn v1_literal_signatures() -> List<V1LiteralSignature> {
  [
    v1cd_signature(lexeme: "v1-compiler", module_path: "v1_compiler.lib", decl_name: "lib", subject: V1CompilerCrate),
    v1cd_signature(lexeme: "claim_executor", module_path: "v1_compiler.bin.claim_executor", decl_name: "main", subject: V1HostedCiBinary),
    v1cd_signature(lexeme: "claim_batch", module_path: "v1_compiler.bin.claim_batch", decl_name: "main", subject: V1Interpreter),
    v1cd_signature(lexeme: "regen_stage0", module_path: "v1_compiler.bin.regen_stage0", decl_name: "main", subject: V1HostedCiBinary),
    v1cd_signature(lexeme: "target/release/gunbc", module_path: "v1_compiler.main", decl_name: "main", subject: V1Cli),
    v1cd_signature(lexeme: "target/debug/gunbc", module_path: "v1_compiler.main", decl_name: "main", subject: V1Cli),
    v1cd_signature(lexeme: "target/release/claim_executor", module_path: "v1_compiler.bin.claim_executor", decl_name: "main", subject: V1HostedCiBinary),
    v1cd_signature(lexeme: "target/release/claim_batch", module_path: "v1_compiler.bin.claim_batch", decl_name: "main", subject: V1Interpreter),
  ]
}

// THE CONSUMER HALF IS DERIVED FROM THE DECLARATION FACT, never authored. decl_facts strips the
// leading "v2." from a qualified name for modules rooted under src/v2, and the census's rows carry
// the unstripped module path (DeclarationRef spellings like "v2.workflow.rust_crate_partition"), so
// the projection restores it from the fact's own rel_path. Doing it from rel_path rather than from
// a guess about the name is what keeps this a projection instead of a second naming scheme.

data v1cd_v2_root_prefix: String = "src/v2/"

// THE PROJECTION IS TAKEN OVER THE THREE FIELDS RATHER THAN OVER THE FACT so that it is
// executable without fabricating a declaration node. A witness that could only reach this rule
// through a real decl_facts row would be a witness nobody writes, and the re-prefixing rule is
// exactly the half that silently produces a key no rostered row can match.
fn v1cd_module_path_from(qualified_name: String, name: String, rel_path: String) -> String {
  let suffix_len = name.length() + 1
  let cut = qualified_name.length() - suffix_len
  let base = if cut > 0 { qualified_name.substring(start: 0, end: cut) } else { qualified_name }
  if rel_path.starts_with(prefix: v1cd_v2_root_prefix) {
    concat("v2.", base)
  } else {
    base
  }
}

fn v1cd_module_path_of(fact: DeclFact) -> String {
  v1cd_module_path_from(qualified_name: fact.qualified_name, name: fact.name, rel_path: fact.rel_path)
}

// THE DECLARED EXCLUSION, ASKABLE. The signature table's note says the bare CLI name is not a
// signature because it is a homonym of the project name; this predicate is that sentence in a form
// a witness can execute, so the exclusion cannot be quietly reversed by adding a row.
fn v1cd_signature_lexemes() -> List<String> {
  v1_literal_signatures() |> map(sig => sig.lexeme)
}

fn v1cd_lexeme_is_a_signature(lexeme: String) -> Bool {
  v1cd_signature_lexemes() |> any(x => x == lexeme)
}

fn v1cd_consumer_ref(fact: DeclFact) -> DeclarationRef {
  decl_ref(module_path: v1cd_module_path_of(fact: fact), decl_name: fact.name)
}

fn v1cd_producer(source_revision: String, source_tree_hex: String) -> DiscoveryProducer {
  discovery_producer(
    instrument: "tools.v1_consumer_discovery -- whole-atom join from v2.std.decl_index decl_facts declaration nodes to the v1 authority each literal names",
    command: "gunbc run --source-root dag --source-root src/v2 --entry dag/gunbc/instruments/v1_consumer_discovery.dag --function v1_discovery_report",
    source_revision: source_revision,
    source_tree_hex: source_tree_hex,
  )
}

fn v1cd_row(fact: DeclFact, sig: V1LiteralSignature, producer: DiscoveryProducer) -> V1ConsumerRow {
  V1ConsumerRow {
    boundary: v1cc_boundary(
      consumer: v1cd_consumer_ref(fact: fact),
      authority: sig.authority,
      disposition: Undecided,
    ),
    medium: sig.medium,
    subject: sig.subject,
    discovered_by: producer,
  }
}

fn v1cd_key_present(xs: List<V1ConsumerRow>, key: String) -> Bool {
  xs |> any(x => v1_row_key(r: x) == key)
}

fn v1cd_push_unique(xs: List<V1ConsumerRow>, item: V1ConsumerRow) -> List<V1ConsumerRow> {
  if v1cd_key_present(xs: xs, key: v1_row_key(r: item)) {
    xs
  } else {
    list_snoc_item(xs: xs, item: item)
  }
}

data v1cd_empty_rows: List<V1ConsumerRow> = []

fn v1cd_rows_for_lexeme(
  fact: DeclFact,
  text: String,
  producer: DiscoveryProducer,
  acc: List<V1ConsumerRow>
) -> List<V1ConsumerRow> {
  fold_list(xs: v1_literal_signatures(), empty: acc, cons: fn(inner, sig) {
    if text == sig.lexeme {
      v1cd_push_unique(xs: inner, item: v1cd_row(fact: fact, sig: sig, producer: producer))
    } else {
      inner
    }
  })
}

fn v1cd_rows_at_node(node: Node, fact: DeclFact, producer: DiscoveryProducer, acc: List<V1ConsumerRow>) -> List<V1ConsumerRow> {
  fold_list(xs: atom_identities_in_node(node: node), empty: acc, cons: fn(inner, sym) {
    v1cd_rows_for_lexeme(fact: fact, text: symbol_lexeme(sym: sym), producer: producer, acc: inner)
  })
}

fn v1cd_merge_rows(left: List<V1ConsumerRow>, right: List<V1ConsumerRow>) -> List<V1ConsumerRow> {
  fold_list(xs: right, empty: left, cons: fn(acc, row) { v1cd_push_unique(xs: acc, item: row) })
}

// ONE LINEAR PASS OVER THE DECLARATION TREE, not a materialized subtree list.
// v2.std.node node_subtree_nodes would answer the same population by concatenating a list at every
// node, which is the copied-accumulator cost shape DESIGN section 6 rules is always fixed
// regardless of realized n -- and n here is every declaration node in the corpus. atom_identities_in_node
// reads the atoms among a node's immediate children, so visiting every node covers every atom;
// the overlap is a repeat, and v1cd_push_unique already keys on the row identity.
fn v1cd_rows_in_fact(fact: DeclFact, producer: DiscoveryProducer) -> List<V1ConsumerRow> {
  fold_node(
    n: fact.node,
    algebra: NodeFold {
      init: fn(self) { v1cd_rows_at_node(node: self, fact: fact, producer: producer, acc: v1cd_empty_rows) },
      step: fn(acc, _edge, sub) { v1cd_merge_rows(left: acc, right: sub) }
    }
  )
}

// THE FOLD OVER THE UNIVERSE. The universe is the declarations decl_facts answers for the supplied
// roots -- independently discovered and closed in the sense DESIGN section 5 requires of an oracle:
// this module does not choose which declarations exist, and a declaration added tomorrow enters the
// population without anyone editing a roster.

fn v1_discovered_rows_for(
  pool_roots: List<String>,
  source_revision: String,
  source_tree_hex: String
) -> List<V1ConsumerRow> {
  let producer = v1cd_producer(source_revision: source_revision, source_tree_hex: source_tree_hex)
  fold_list(xs: decl_facts(pool_roots: pool_roots), empty: v1cd_empty_rows, cons: fn(acc, fact) {
    fold_list(xs: v1cd_rows_in_fact(fact: fact, producer: producer), empty: acc, cons: fn(inner, row) {
      v1cd_push_unique(xs: inner, item: row)
    })
  })
}

fn v1_discovered_keys_for(
  pool_roots: List<String>,
  source_revision: String,
  source_tree_hex: String
) -> List<String> {
  v1_discovered_rows_for(pool_roots: pool_roots, source_revision: source_revision, source_tree_hex: source_tree_hex)
    |> map(r => v1_row_key(r: r))
}

data v1cd_pool_roots: List<String> = ["dag", "src/v2"]

// THE REVISION IS A PARAMETER, NOT A CONSTANT THIS MODULE OBSERVES FOR ITSELF. A producer row
// records WHICH TREE was read, and a module that fills that field with a literal it carries would
// be asserting the observation rather than recording one. The runner supplies the head it stood on.

fn v1_discovery_rows_at(source_revision: String, source_tree_hex: String) -> List<V1ConsumerRow> {
  v1_discovered_rows_for(
    pool_roots: v1cd_pool_roots,
    source_revision: source_revision,
    source_tree_hex: source_tree_hex,
  )
}

fn v1_discovery_keys_at(source_revision: String, source_tree_hex: String) -> List<String> {
  v1_discovery_rows_at(source_revision: source_revision, source_tree_hex: source_tree_hex)
    |> map(r => v1_row_key(r: r))
}

// THE JOIN, AND IT LIVES HERE RATHER THAN IN THE CENSUS ON PURPOSE. gunbc.v1_consumer_census
// v1_consumers_undisposed takes the discovered population as a PARAMETER, because a census that
// supplies its own denominator asserts completeness by writing it down -- the change-detector shape
// DESIGN section 5 names, where automating the literal collapses the assertion to
// measure() == measure(). This module is the outside supplier that refusal was waiting for, so the
// join is performed at the one place that holds both halves and neither half can edit the other.
//
// A NON-EMPTY ANSWER IS THE FINDING, not a failure of this instrument: it is the list of .dag
// declarations that reach a v1 authority and carry no disposition in the roster. Each one is a row
// somebody has to write, and until they do the cutover is refused by construction.

fn v1_discovery_undisposed_at(source_revision: String, source_tree_hex: String) -> List<String> {
  v1_consumers_undisposed(
    discovered: v1_discovery_keys_at(source_revision: source_revision, source_tree_hex: source_tree_hex),
    rows: v1_consumers(),
  )
}

fn v1_discovery_report() -> List<String> {
  v1_discovery_undisposed_at(source_revision: "unobserved", source_tree_hex: "unobserved")
}

fn v1_discovery_all_keys() -> List<String> {
  v1_discovery_keys_at(source_revision: "unobserved", source_tree_hex: "unobserved")
}
