module gunbc.instruments.emit_accumulator_subjects

import std.types { Bool, Int, List }
import std.realization_measurement { AllocationCounter }
import gunbc.allocation_observation_render { AllocationCase }
import gunbc.instruments.allocation_battery { AllocationCase, BatteryRow, BatteryWindow, battery_window, battery_window_unavailable, subject_case, violation_case, violation_contract_holds_case, calibration_rows, availability_case, plain_row }
import gunbc.emit_state_threading_specimen { spec_build }

// THE ACCUMULATOR SUBJECTS of the building-block battery (roadmap row
// `declared_roadmap_nodes` in gunbc.roadmap.roadmap_authority, id emission-building-block-realization): a
// Loop with a record accumulator, a field read, a record rebuild with one field changed, and a local and
// an escaping closure. This module holds the SUBJECT BODIES and the metered pairs only -- no report, no
// pipeline entry -- so the family's green entry and its red entry measure the same bodies through the
// same bracket.
//
// This is the family the row's own displaced_cost names: "a reader cannot say what a record rebuild or a
// fold step costs in emitted Rust without reading generated code". The fold step and the rebuild are both
// here, each with the arm that does the unnecessary work beside the arm that does not.
//
// CLOSURES ARE WRITTEN THE WAY THE CORPUS WRITES THEM: a callable is a let-bound lambda invoked
// positionally, the spelling the corpus actually uses. This module declares no arrow type, because
// production spellings of a function-typed formal have no corpus precedent -- borrowing one would be
// inventing syntax, the failure this row exists to prevent.
//
// MEASURED CORRECTION TO AN EARLIER CLAIM OF THIS MODULE. The first executed run (srv1, run
// 20261127T010439Z-71423, head 8c4162d754185eb72648fa22cbd107f7463765a5) reported the cause of this
// family's zero executed rows as ".dag has no parameter-type annotation, so the emitted closure has no
// inferable type". That was an absence claim with no survey behind it, and the survey says it is too
// broad: the record-accumulator fold in this very module emitted with fully annotated parameters
// (`|acc: Rc<AccRecord>, x: i64|` in the generated source), and the corpus greps over dag/, src/v2/ and
// src/v1/ print these counts for fold spellings -- 8766 lines contain a `fold(` call, 4129 spell the step
// as an inline lambda (`f: (`), 1134 spell a fold's init as a record literal (`init: <Ctor> {`), 347 have
// a record constructor in a step body within two lines of an inline lambda, and 30 pass a named step
// function. A record-accumulator fold is therefore common and builds; a let-bound lambda whose parameter
// reaches only arithmetic is what does not. What actually failed was narrower and is now measured: the emitted file
// gunbc_instruments_emit_accumulator_subjects.rs carried exactly four sites annotated
// `|parameter: _|` -- lines 123, 130, 142 and 151, the four closure subjects below -- and the build
// reported exactly "4 previous errors", the first being `error[E0282]: type annotations needed` at
// 123:29. In every one of the four the parameter flowed only into bare arithmetic (`x + 1`, `x + bias`),
// so the emitter could not pick the integer path and left the parameter undetermined.
//
// THE CORPUS DOES NOT SPELL CLOSURES THAT WAY. A search for a let-bound lambda written on one line
// (`let <name> = (<params>) =>` or `let <name> = <param> =>`) over dag/ and src/v2/ finds 17 sites, 13 of
// them outside this module, and all 13 build in the required lane: every one puts its parameter in a
// TYPED POSITION -- `gunbc.test.claim.fleet.site_pxe_edge_converge_witness::image_at`
// coerces it (`p as NonEmptyStr`), `gunbc.test.claim.runner.runner_group_restriction_ensure_witness::admit`
// and `::g` pass it to a function with a declared formal, `gunbc.test.claim.runner.runner_service_slot_start_witness::would_start`
// flows it into a record field, and `gunbc.host.host_effect_realize::is_expected` and `::is_permitted`
// read a field off it. So the subjects below follow the corpus: each parameter flows through
// `acc_int_identity`, a function with a declared `Int` formal, which is a scalar-to-scalar identity and
// allocates nothing, and the closure subjects state their cost on the axis their contracts name.
// `acc_local_closure` additionally carries the seed application (the lambda applied once to the declared
// `acc_closure_seed`) so that one run distinguishes which of the two forces is sufficient: if the two
// typed-flow-only subjects compile, the typed position is sufficient and the seed application is
// redundant, which the emitted annotation will show.

data acc_cardinality: Int = 32

// THE RECORD ACCUMULATOR: one field changes per step, the context and the tag are carried unchanged.
// The context is a list rather than a string so the reading is about the payload, not about text layout.
type AccRecord {
  pos: Int
  total: Int
  context: List<Int>
  tag: Int
}

type AccRow {
  label: Int
  width: Int
  context: List<Int>
}

fn acc_init(context: List<Int>) -> AccRecord {
  AccRecord { pos: 0, total: 0, context: context, tag: 7 }
}

// THE LOOP WITH A RECORD ACCUMULATOR, contract arm: one accumulator threaded through the walk; `context`
// and `tag` are carried by reference to the enclosing value, so a step's cost is bounded by the field that
// changes. Same fold shape as the accepted specimen's `spec_walk_tokens` in gunbc.emit_state_threading_specimen.
fn acc_fold_step(seed: AccRecord, xs: List<Int>) -> Int {
  let end = fold(xs, init: seed, f: (acc, x) => if acc.pos > acc_cardinality { acc } else {
    AccRecord { pos: acc.pos + 1, total: acc.total + x, context: acc.context, tag: acc.tag }
  })
  end.total + end.pos
}

// THE LOOP, violating arm: a fresh accumulator is materialized every step from a
// fresh pass over the whole context, so the accumulator is allocated per step instead of moved per step.
// Same fold, same xs, same returned scalar; the only difference is that the carried value is rebuilt from
// the context each step.
fn acc_fold_allocates_per_step(seed: AccRecord, xs: List<Int>) -> Int {
  let end = fold(xs, init: seed, f: (acc, x) => if acc.pos > acc_cardinality { acc } else {
    let remade = fold(acc.context, init: acc_init(context: acc.context), f: (inner, c) => AccRecord { pos: inner.pos, total: inner.total + c, context: inner.context, tag: inner.tag })
    AccRecord { pos: acc.pos + 1, total: remade.total + x, context: acc.context, tag: acc.tag }
  })
  end.total + end.pos
}

// THE FIELD READ, contract arm: the enclosing row stays live and only a field is taken.
fn acc_field_read(row: AccRow) -> Int {
  row.width
}

// THE FIELD READ, violating arm: the whole enclosing record is rebuilt in order
// to read one field, so the unchanged context is copied through the read.
fn acc_field_read_rebuilds(row: AccRow) -> Int {
  let rebuilt = AccRow { label: row.label, width: row.width, context: row.context }
  rebuilt.width
}

// THE RECORD REBUILD, contract arm: one field changes, the context is carried.
fn acc_rebuild_one_field(row: AccRow) -> Int {
  let changed = AccRow { label: row.label, width: row.width + 1, context: row.context }
  changed.width
}

// THE RECORD REBUILD, violating arm: the field that does not change is pushed
// through an extra fold over the context before the rebuild, copying the unchanged context. The extra pass
// is the whole difference from the contract arm: same fields, same returned width, but the unchanged
// context is walked to make a value that is then multiplied by zero, so the work is real and the answer
// is not.
fn acc_rebuild_copies_context(row: AccRow) -> Int {
  let carried = fold(row.context, init: 0, f: (acc, c) => acc + c)
  let changed = AccRow { label: row.label, width: row.width + 1 + (carried * 0), context: row.context }
  changed.width
}

// THREE CANDIDATE FORCES for making a let-bound callable's parameter type determinable, each one a
// spelling the corpus already uses. `acc_int_identity` is the typed-position force (parameter into a
// function with a declared `Int` formal, as `gunbc.test.claim.runner.runner_group_restriction_ensure_witness::admit`
// does); `acc_field_of_scalar` is the record-field force (parameter flows into a record and is read back
// out, as `gunbc.test.claim.runner.runner_service_slot_start_witness::would_start` and
// `gunbc.host.host_effect_realize::is_expected` do); and the seed application in `acc_local_closure` is
// the force the row's manager proposed (apply the callable once to a declared value). All three are
// scalar-cost: no Rc, no list, so none of them can move an allocation reading. The arms below carry them
// in different combinations so ONE run attributes the cause: if the identity-only arms compile, the typed
// position is sufficient; if only the field-read arm compiles, the record read is what Rust needed; if
// only the seed-application arm compiles, neither body force was enough.
fn acc_int_identity(v: Int) -> Int {
  v
}

type AccScalar {
  value: Int
}

fn acc_field_of_scalar(row: AccScalar) -> Int {
  row.value
}

// A declared value the contract-arm closure is applied to once, so its parameter can be fixed at the
// seed as well as in the body.
data acc_closure_seed: Int = 0

// THE LOCAL CLOSURE, contract arm: built, applied to every element, never retained and never escapes the
// call. Invocation is positional, the corpus spelling. This arm carries two forces at once (typed
// position plus the seed application); `seeded * 0` keeps the returned value identical to the arm's own
// arithmetic, so the seed application cannot change what is claimed, only whether it compiles.
fn acc_local_closure(xs: List<Int>) -> Int {
  let scale = x => acc_int_identity(v: x) + 1
  let seeded = scale(acc_closure_seed)
  fold(xs, init: 0, f: (acc, x) => acc + scale(x)) + (seeded * 0)
}

// THE TWIN OF THE CONTRACT ARM WITHOUT THE SEED TERM, metered as a control the way `meter_empty` and
// `meter_known_allocation` are controls of this entry (control ids, not roster blocks). The seed term is
// multiplied by zero, which preserves the arm's ANSWER but not its METER: that application still runs, so
// what it costs has to be read rather than assumed to be zero. This row is that reading -- ops and bytes of
// the identity-only shape beside the seeded one, so the seed term's contribution is a visible delta and the
// instrument's own cost is never read as the specimen's. If the identity-only arms compile, the seed term is
// dropped from the delivery and this row retires with it.
fn acc_local_closure_identity_only(xs: List<Int>) -> Int {
  let scale = x => acc_int_identity(v: x) + 1
  fold(xs, init: 0, f: (acc, x) => acc + scale(x))
}

// THE LOCAL CLOSURE, violating arm: the same local computation, but a payload is materialized on every
// application of the closure instead of being read once, which is the block's typed violating form
// (PerStepAllocation) and is judged on operations and bytes. THE FIRST EXECUTED RUN MEASURED WHY THIS
// WORDING MOVED: the row's form used to say an owning retain while the arm allocated per step, and a
// retain judged on allocations witnesses an axis the contract does not speak about — the arm and the
// contract must agree by name, and the roster field is the single place the form is stated.
fn acc_local_closure_materializes_per_step(xs: List<Int>) -> Int {
  let scale = x => acc_int_identity(v: x) + acc_materialize(rows: xs)
  // identity force only: no seed application, so an extra per-step payload materialization is not paid to prove a type
  fold(xs, init: 0, f: (acc, x) => acc + scale(x))
}

// A payload materialization used as the retained object. Returns a scalar so nothing has to be stored.
fn acc_materialize(rows: List<Int>) -> Int {
  fold(rows, init: 0, f: (acc, x) => acc + x)
}

// THE ESCAPING CLOSURE, contract arm: the callable leaves this body and is applied by the callee; it
// captured the two scalars it reads and nothing else.
fn acc_escaping_closure(xs: List<Int>) -> Int {
  let bias = acc_field_read(row: acc_row_of(n: 3))
  let add = x => acc_int_identity(v: x) + bias
  fold(xs, init: 0, f: (acc, x) => acc + add(x))
}

// THE ESCAPING CLOSURE, violating arm: the escaping callable reads the unchanged
// context too, so escaping costs the whole payload rather than the scalar it returns.
fn acc_escaping_closure_copies_context(xs: List<Int>) -> Int {
  let row = acc_row_of(n: 3)
  let bias = acc_rebuild_copies_context(row: row)
  let add = x => acc_field_of_scalar(row: AccScalar { value: acc_int_identity(v: x) }) + bias + acc_field_read_rebuilds(row: row)
  // both body forces on this arm: typed position AND the record-field read, so if only this arm compiles the record read is what Rust needed
  fold(xs, init: 0, f: (acc, x) => acc + add(x))
}

fn acc_row_of(n: Int) -> AccRow {
  AccRow { label: n, width: n * 2, context: spec_build(n: n) }
}

type AccSubject =
    AccMeterEmpty
  | AccMeterKnownAllocation
  | AccFoldStep
  | AccFoldAllocatesPerStep
  | AccFieldRead
  | AccFieldReadRebuilds
  | AccRebuildOneField
  | AccRebuildCopiesContext
  | AccLocalClosure
  | AccLocalClosureIdentityOnly
  | AccLocalClosureMaterializesPerStep
  | AccEscapingClosure
  | AccEscapingClosureCopiesContext

// ONE PATH FOR EVERY ARM: same seed, same rows, same returned scalar; a violating arm differs from its
// contract arm only in the work it does inside the same body.
fn run_acc_subject(subject: AccSubject, src: List<Int>) -> List<Int> {
  let rows = spec_build(n: acc_cardinality)
  let context = spec_build(n: acc_cardinality)
  let seed = acc_init(context: context)
  let row = acc_row_of(n: 8)
  match subject {
    AccMeterEmpty => []
    AccMeterKnownAllocation => fold(src, init: [], f: (acc, x) => list_push(acc, x))
    AccFoldStep => list_push([], acc_fold_step(seed: seed, xs: rows))
    AccFoldAllocatesPerStep => list_push([], acc_fold_allocates_per_step(seed: seed, xs: rows))
    AccFieldRead => list_push([], acc_field_read(row: row))
    AccFieldReadRebuilds => list_push([], acc_field_read_rebuilds(row: row))
    AccRebuildOneField => list_push([], acc_rebuild_one_field(row: row))
    AccRebuildCopiesContext => list_push([], acc_rebuild_copies_context(row: row))
    AccLocalClosure => list_push([], acc_local_closure(xs: rows))
    AccLocalClosureIdentityOnly => list_push([], acc_local_closure_identity_only(xs: rows))
    AccLocalClosureMaterializesPerStep => list_push([], acc_local_closure_materializes_per_step(xs: rows))
    AccEscapingClosure => list_push([], acc_escaping_closure(xs: rows))
    AccEscapingClosureCopiesContext => list_push([], acc_escaping_closure_copies_context(xs: rows))
  }
}

// THE PAIR TAKEN UNDER THE METER, in the shared bracket.
fn acc_window(subject: AccSubject, src: List<Int>) -> BatteryWindow uses counter: AllocationCounter {
  if observed_allocation_available("") {
    let ops_before = observed_allocation_operations("")
    let bytes_before = observed_allocation_bytes("")
    let kept = run_acc_subject(subject: subject, src: src)
    let ops_after = observed_allocation_operations("")
    let bytes_after = observed_allocation_bytes("")
    battery_window(kept: kept, ops_before: ops_before, ops_after: ops_after, bytes_before: bytes_before, bytes_after: bytes_after)
  } else {
    battery_window_unavailable(kept: run_acc_subject(subject: subject, src: src))
  }
}

// THE GREEN MEASUREMENTS: availability, the meter's own two readings, the calibration pair, and one
// reading plus one discriminating pair per block. No red-control row appears here. The known arm of the
// calibration pair builds from the specimen input, never a closed term: a literal with no input to
// allocate from measures nothing, which is the specimen being free rather than the meter being blind.
fn acc_measurement_rows() -> List<BatteryRow> uses counter: AllocationCounter {
  let src = spec_build(n: acc_cardinality)
  let empty = acc_window(subject: AccMeterEmpty, src: src)
  let empty_again = acc_window(subject: AccMeterEmpty, src: src)
  let known = acc_window(subject: AccMeterKnownAllocation, src: src)
  let fold_step = acc_window(subject: AccFoldStep, src: src)
  let fold_alloc = acc_window(subject: AccFoldAllocatesPerStep, src: src)
  let field_read = acc_window(subject: AccFieldRead, src: src)
  let field_rebuilt = acc_window(subject: AccFieldReadRebuilds, src: src)
  let rebuild = acc_window(subject: AccRebuildOneField, src: src)
  let rebuild_copied = acc_window(subject: AccRebuildCopiesContext, src: src)
  let closure = acc_window(subject: AccLocalClosure, src: src)
  let closure_twin = acc_window(subject: AccLocalClosureIdentityOnly, src: src)
  let closure_per_step = acc_window(subject: AccLocalClosureMaterializesPerStep, src: src)
  let escaping = acc_window(subject: AccEscapingClosure, src: src)
  let escaping_copied = acc_window(subject: AccEscapingClosureCopiesContext, src: src)
  concat(concat(concat([plain_row(c: availability_case(prefix: "accumulator"))],
      [subject_case(prefix: "accumulator", block_id: "meter_empty", own: empty), subject_case(prefix: "accumulator", block_id: "meter_known_allocation", own: known)]),
      calibration_rows(prefix: "accumulator", empty: empty, empty_again: empty_again, known: known)),
    concat(concat(concat(
      [subject_case(prefix: "accumulator", block_id: "loop_record_accumulator", own: fold_step), violation_case(prefix: "accumulator", block_id: "loop_record_accumulator", viol: fold_alloc, contract_arm: fold_step)],
      [subject_case(prefix: "accumulator", block_id: "field_read", own: field_read), violation_case(prefix: "accumulator", block_id: "field_read", viol: field_rebuilt, contract_arm: field_read)]),
      concat(
      [subject_case(prefix: "accumulator", block_id: "record_rebuild_one_field", own: rebuild), violation_case(prefix: "accumulator", block_id: "record_rebuild_one_field", viol: rebuild_copied, contract_arm: rebuild)],
      [subject_case(prefix: "accumulator", block_id: "local_closure", own: closure), subject_case(prefix: "accumulator", block_id: "local_closure_identity_only_twin", own: closure_twin), violation_case(prefix: "accumulator", block_id: "local_closure", viol: closure_per_step, contract_arm: closure)])),
      [subject_case(prefix: "accumulator", block_id: "escaping_closure", own: escaping), violation_case(prefix: "accumulator", block_id: "escaping_closure", viol: escaping_copied, contract_arm: escaping)]))
}

// THE RED MEASUREMENTS: the same windows, the same path, judged the opposite way.
fn acc_red_rows() -> List<BatteryRow> uses counter: AllocationCounter {
  let src = spec_build(n: acc_cardinality)
  let fold_step = acc_window(subject: AccFoldStep, src: src)
  let fold_alloc = acc_window(subject: AccFoldAllocatesPerStep, src: src)
  let field_read = acc_window(subject: AccFieldRead, src: src)
  let field_rebuilt = acc_window(subject: AccFieldReadRebuilds, src: src)
  let rebuild = acc_window(subject: AccRebuildOneField, src: src)
  let rebuild_copied = acc_window(subject: AccRebuildCopiesContext, src: src)
  let closure = acc_window(subject: AccLocalClosure, src: src)
  let closure_per_step = acc_window(subject: AccLocalClosureMaterializesPerStep, src: src)
  let escaping = acc_window(subject: AccEscapingClosure, src: src)
  let escaping_copied = acc_window(subject: AccEscapingClosureCopiesContext, src: src)
  [
    violation_contract_holds_case(prefix: "accumulator", block_id: "loop_record_accumulator", viol: fold_alloc, contract_arm: fold_step),
    violation_contract_holds_case(prefix: "accumulator", block_id: "field_read", viol: field_rebuilt, contract_arm: field_read),
    violation_contract_holds_case(prefix: "accumulator", block_id: "record_rebuild_one_field", viol: rebuild_copied, contract_arm: rebuild),
    violation_contract_holds_case(prefix: "accumulator", block_id: "local_closure", viol: closure_per_step, contract_arm: closure),
    violation_contract_holds_case(prefix: "accumulator", block_id: "escaping_closure", viol: escaping_copied, contract_arm: escaping)
  ]
}

// THE ACCEPTED POSITIVES THE RED ENTRY CARRIES. `gunbc.design_argument::guarantee_ladder` asks a reported
// rung to rest on a red refused on the real acceptance path PLUS an accepted positive control, and the red
// entry had only the red rows: an exit 1 there could have meant a caught violation or a sampler that stopped
// reading. So the red entry meters its own empty floor and its own known copying arm, on windows of its own
// (a shared window would make the two entries one measurement, and neither could then contradict the other).
fn acc_control_rows() -> List<BatteryRow> uses counter: AllocationCounter {
  let src = spec_build(n: acc_cardinality)
  let empty = acc_window(subject: AccMeterEmpty, src: src)
  let empty_again = acc_window(subject: AccMeterEmpty, src: src)
  let known = acc_window(subject: AccMeterKnownAllocation, src: src)
  concat([plain_row(c: availability_case(prefix: "accumulator"))], calibration_rows(prefix: "accumulator", empty: empty, empty_again: empty_again, known: known))
}
