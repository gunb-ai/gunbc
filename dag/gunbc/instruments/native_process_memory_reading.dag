module gunbc.instruments.native_process_memory_reading

import std.types { String, Bool, Int }
import std.measure { ByteSize, byte_size, measure_count, Nanosecond, nanosecond_count }
import std.process { ExitSuccess, ExitFailure }
import std.realization_measurement { ResidencyObservation, ResidencyObserved, ResidencyUnobservable }
import extdeps.posix.rusage { RusageMaxrssObservation, RusageChildren, rusage_maxrss_bytes, rusage_maxrss_is_positive }
import extdeps.linux.rusage { linux_rusage_maxrss_unit }
import gunbc.cli_wire { CliWireResponse, CliWirePrintable }

// HOW `gunbc test //gunbc/instruments:native-process-memory-census` READS ITS RUNS. The subject is the
// NATIVE v2 BINARY'S OWN PROCESS, and nothing else: the seed's emission and cargo's build of the
// emitted crate run first and are outside the measurement. The slot memory receipt
// (gunbc.host.memory_envelope, cgroup memory.peak) answers for the whole step, and on the required
// path the whole step is the seed plus rustc, so before this reader nothing measured the native
// process alone.
//
// WHY wait4 AND NOT getrusage(RUSAGE_CHILDREN). RUSAGE_CHILDREN's ru_maxrss is the maximum over EVERY
// reaped descendant of the caller, so read in the instrument it is cargo's or rustc's peak whenever
// those were larger, and it cannot be narrowed to one child after the fact. The host reaps the native
// child with wait4, whose rusage describes that child (and anything it reaped) only. The reading is
// still RusageChildren-shaped in extdeps.posix.rusage terms -- a terminated child's usage, in Linux's
// kibibyte unit -- which is the existing model; it is not a second unit authority.
//
// AND WHY THROUGH A TRAMPOLINE. Linux seeds a process's ru_maxrss at exec from the high-water mark of
// the address space it replaces. Spawned straight from the seed -- which has just emitted the closure in
// process -- the native child inherited the seed's peak: the first real run reported one identical figure
// for a control that ended at once and for the whole-tree census, and this reader's control refused it. The host therefore
// spawns through the seed executable re-entered before it does any work, whose address space is small;
// that trampoline spawns and reaps the native child and hands back the child's rusage.
//
// THE CONTROL RUN IS THE DISCRIMINATING RED. The same prepared binary runs the same verb over a
// one-module control root first. If the measurement were not the native child's (a cumulative
// RUSAGE_CHILDREN reading, a cgroup peak, a constant), both runs would report the same dominating
// peak; a workload peak that does not exceed the control's is therefore refused with exit 1. No
// expected number is written anywhere (DESIGN section 5): the oracle is the order of two readings.
//
// Exit: 0 both peaks observed and the workload's exceeds the control's; 1 they do not discriminate;
// 2 no observation (a peak missing or zero, a child killed by a signal, or the workload unrealizable).

// WHICH NATIVE COMPUTATION WAS MEASURED. A baseline is a baseline for ONE workload, so the workload is
// part of the receipt's identity, never inferred from the label.
type NativeCensusVerb
  = NativeCensusFrontEnd
  | NativeCensusInfer

fn native_census_verb_argv(v: NativeCensusVerb) -> String {
  match v {
    NativeCensusFrontEnd => "census"
    NativeCensusInfer => "census-infer"
  }
}

// SELF-COMPILATION IS A DISTINCT WORKLOAD IN THE SAME SYSTEM, and a declared frontier today: the native
// binary cannot yet compile its own sources (v2.compiler.compile's SourceRootEvalDriver offers only the
// census and adjudicate verbs, and compile_cli refuses at parse_g0_tokens_remain on the
// service ... { operation ... } form). TRIGGER: when the native compile verb accepts the v2.compiler
// self-host closure, a label binds NativeSelfCompileWorkload through this same reading and its host
// arm spawns that verb; nothing else here changes. Until then the arm refuses with no observation,
// so a census baseline can never be reported as a self-compile figure.
type NativeMeasuredWorkload
  = NativeCensusWorkload { verb: NativeCensusVerb }
  | NativeSelfCompileWorkload

fn native_measured_workload_label(w: NativeMeasuredWorkload) -> String {
  match w {
    NativeCensusWorkload { verb: v } => "census verb=" + native_census_verb_argv(v: v)
    NativeSelfCompileWorkload => "self-compile"
  }
}

// HOW FAR THE MEASURED RUN GOT. A census that printed its complete terminal is a baseline for the whole
// census; one that stopped at a semantic refusal is a baseline only for the prefix it reached, and the
// receipt says which.
type NativeStageReached
  = NativeStageCompleted
  | NativeStageStoppedAtRefusal { terminal: String }
  | NativeStageNoTerminal

fn native_stage_reached(terminal: String) -> NativeStageReached {
  if terminal == "" {
    NativeStageNoTerminal
  } else if string_contains(s: terminal, pattern: "\"_terminal\":\"complete\"") {
    NativeStageCompleted
  } else {
    NativeStageStoppedAtRefusal { terminal: terminal }
  }
}

fn native_stage_reached_label(s: NativeStageReached) -> String {
  match s {
    NativeStageCompleted => "completed"
    NativeStageStoppedAtRefusal { terminal: t } => "stopped_at_refusal terminal=" + t
    NativeStageNoTerminal => "no_terminal"
  }
}

// ONE MEASURED CHILD, as the host reaped it. `peak` is wait4's ru_maxrss as extdeps.posix.rusage owns
// it (the bare kibibyte integer stays on the host's receipt line, as elapsed's nanoseconds do); `signal`
// is 0 when the child exited, else the terminating signal (then `exit_code` is meaningless).
type NativeChildReading {
  peak: RusageMaxrssObservation
  elapsed: Nanosecond
  exit_code: Int
  signal: Int
  terminal: String
}

// THE HOST'S ONE ENTRY INTO THE RUSAGE MODEL: wait4's raw ru_maxrss for a reaped child, in the unit the
// host's kernel reports. The unit is chosen here, not in the host.
fn native_child_maxrss(raw_value: Int) -> RusageMaxrssObservation {
  RusageMaxrssObservation { who: RusageChildren, raw_value: raw_value, unit: linux_rusage_maxrss_unit }
}

// THE PEAK, TYPED SO ABSENCE CANNOT READ AS A QUANTITY (std.realization_measurement). A zero or negative
// ru_maxrss is not a small process, it is a reading that was not taken.
fn native_child_peak(r: NativeChildReading) -> ResidencyObservation {
  if rusage_maxrss_is_positive(obs: r.peak) {
    ResidencyObserved { bytes: rusage_maxrss_bytes(obs: r.peak) }
  } else {
    ResidencyUnobservable { axis: "peak", reason: "wait4 ru_maxrss=" + to_string(r.peak.raw_value) + " is not a positive reading" }
  }
}

// CURRENT AND ALLOCATOR RESIDENCY ARE NOT OBSERVABLE FROM OUTSIDE A REAPED CHILD, and are said so rather
// than reported as zero. TRIGGER: the native binary prints std.realization_measurement
// NativeResidencySample rows at its NativeResidencyBoundary points; this reader then carries them.
fn native_child_current() -> ResidencyObservation {
  ResidencyUnobservable { axis: "current", reason: "the native binary emits no NativeResidencySample boundary rows; a reaped child has no current residency" }
}

fn native_child_allocator() -> ResidencyObservation {
  ResidencyUnobservable { axis: "allocator", reason: "the native binary emits no allocator residency observation" }
}

fn residency_render(o: ResidencyObservation) -> String {
  match o {
    ResidencyObserved { bytes: b } => to_string(measure_count(m: b))
    ResidencyUnobservable { axis: _, reason: why } => "unobservable(" + why + ")"
  }
}

fn native_child_receipt_line(role: String, r: NativeChildReading) -> String {
  "native_process_memory role=" + role
    + " peak_bytes=" + residency_render(o: native_child_peak(r: r))
    + " current_bytes=" + residency_render(o: native_child_current())
    + " allocator_bytes=" + residency_render(o: native_child_allocator())
    + " elapsed_ns=" + to_string(nanosecond_count(n: r.elapsed))
    + " exit=" + to_string(r.exit_code)
    + " signal=" + to_string(r.signal)
    + " stage=" + native_stage_reached_label(s: native_stage_reached(terminal: r.terminal))
}

fn peak_count(o: ResidencyObservation) -> Int {
  match o {
    ResidencyObserved { bytes: b } => measure_count(m: b)
    ResidencyUnobservable { axis: _, reason: _ } => 0
  }
}

fn no_observation(bytes: String, why: String) -> CliWireResponse {
  CliWirePrintable { bytes: bytes, exit: ExitFailure { code: 2, reason: why } }
}

// THE STANDING. The identities and envelope are the host's observations, passed through verbatim so the
// receipt names what ran, on what, under which bound.
fn native_process_memory_standing(
  workload: NativeMeasuredWorkload,
  binary_identity: String,
  input_identity: String,
  envelope: String,
  control: NativeChildReading,
  measured: NativeChildReading
) -> CliWireResponse {
  let bytes = "native_process_memory workload=" + native_measured_workload_label(w: workload)
    + " binary=" + binary_identity
    + " input=" + input_identity
    + " envelope=" + envelope + "\n"
    + native_child_receipt_line(role: "control", r: control) + "\n"
    + native_child_receipt_line(role: "workload", r: measured) + "\n"
  match workload {
    NativeSelfCompileWorkload => no_observation(bytes: bytes, why: "self-compile is a declared frontier: the native binary cannot yet compile its own sources")
    NativeCensusWorkload { verb: _ } =>
      if control.signal != 0 {
        no_observation(bytes: bytes, why: "control child terminated by signal " + to_string(control.signal))
      } else if measured.signal != 0 {
        no_observation(bytes: bytes, why: "workload child terminated by signal " + to_string(measured.signal) + "; a kill under the envelope is a lower bound, not a peak")
      } else if peak_count(o: native_child_peak(r: control)) == 0 {
        no_observation(bytes: bytes, why: "control child peak not observed")
      } else if peak_count(o: native_child_peak(r: measured)) == 0 {
        no_observation(bytes: bytes, why: "workload child peak not observed")
      } else if peak_count(o: native_child_peak(r: measured)) <= peak_count(o: native_child_peak(r: control)) {
        CliWirePrintable { bytes: bytes, exit: ExitFailure { code: 1, reason: "the workload peak does not exceed the one-module control's: the reading does not discriminate the native child's own work" } }
      } else {
        CliWirePrintable { bytes: bytes, exit: ExitSuccess }
      }
  }
}

// The control root: one module, so its peak is the binary's floor for this verb. The binary binds a
// source root only when its directory is named for a governed tree (v2.cli.repository_layout
// repository_tree_of_root_argument), so the control's root is a `dag` directory and its module lives in
// that tree's `test` namespace.
fn native_process_memory_control_tree() -> String {
  "dag"
}

fn native_process_memory_control_path() -> String {
  "test/native_process_memory_control.dag"
}

fn native_process_memory_control_content() -> String {
  "module test.native_process_memory_control\n\nfn one() -> Int {\n  1\n}\n"
}
