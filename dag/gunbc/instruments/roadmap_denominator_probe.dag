module gunbc.instruments.roadmap_denominator_probe

import std.types { Bool, List, String, Int, NonEmptyStr }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import extdeps.filesystem.filesystem_io { Filesystem }
import gunbc.roadmap.roadmap_model { RoadmapNode, WorkItemDispatch, Dispatchable, NotDispatchable }
import gunbc.roadmap.roadmap_status {
  RoadmapItem, TicketLine, AuthoredLine, PlainLine, DerivableLine,
  line_ticket, item_is_done, TicketFields,
}
import gunbc.roadmap.roadmap_authority {
  declared_roadmap_nodes, active_roadmap_nodes_projection,
  ActiveRoadmapNodesProjected, ActiveRoadmapNodesProjectionRefused,
  roadmap_retired_node_ids_load, RetiredNodeIdsLoaded, RetiredNodeIdsRefused,
  ManualAcceptance,
}

// WHICH ROADMAP ROWS ARE ON THE ACTIVE FRONTIER AND CANNOT BE ACTIVE WORK.
//
// THIS IS AN INSTRUMENT AND NOT A WITNESS. It asserts nothing; it prints the population, so a figure
// about the roadmap frontier is cited by naming a producer that re-derives it rather than by being
// transcribed into prose where it rots (gunbc.design_argument::how_to_work). It exists because reading the row
// constructors gave the WRONG repair: the two size/completeness witnesses in test.claim.roadmap.roadmap_authority
// walk the declared set while their predicate is named active_node_admissible, which reads as a
// denominator defect -- and repointing them at the active set does not repair it, because the active
// set itself carries superseded rows. Only the measurement separates those two stories.
//
// WHAT THE ROWS MEAN: `active retired` is rows the event log has RETIRED that the frontier still
// presents as work — the leak this probe exists to catch, and the measurement that makes step 1(b)
// checkable: a retirement now lives only in gunbc.roadmap.roadmap_event_log, so anything still
// standing in the active set while the log holds a Retired event for it is a projection that reads
// the old home. It must be zero. `active inadmissible` is every active row failing the admissibility
// the roadmap page assumes of what it renders.

fn line_kind(i: RoadmapItem) -> String {
  match i {
    TicketLine { ticket: _ } => "ticket"
    AuthoredLine { content: _ } => "authored"
    DerivableLine { prs: _, title: _, description: _ } => "derivable"
    PlainLine { content: _ } => "plain"
  }
}

fn dispatch_kind(d: WorkItemDispatch) -> String {
  match d {
    NotDispatchable => "not-dispatchable"
    Dispatchable { repo: r, acceptance: a } =>
      join(["dispatchable(", r, ",", if a == ManualAcceptance { "manual" } else { "other" }, ")"], "")
  }
}

fn ticket_complete(t: TicketFields) -> Bool {
  !(t.headline == "") && !(t.brief == "") && !(t.displaced_cost == "") && !(t.current_state == "")
    && !(t.first_slice == "") && !(t.red_control == "") && !(t.out_of_scope == "") && !(t.handback == "")
}

fn admissible(n: RoadmapNode) -> Bool {
  !item_is_done(item: n.line, merged: [])
    && (match line_ticket(item: n.line) { Present { value: t } => ticket_complete(t: t)  Absent => false })
    && count(n.carriers) > 0
    && !(n.owner == "")
    && (match n.dispatch {
      Dispatchable { repo: r, acceptance: a } => r == "gunbc" && a == ManualAcceptance
      NotDispatchable => false
    })
}

fn row_line(n: RoadmapNode) -> String {
  join([
    "  ", n.node as String,
    " line=", line_kind(i: n.line),
    " dispatch=", dispatch_kind(d: n.dispatch),
    " carriers=", to_string(count(n.carriers)),
    " owner=", if n.owner == "" { "(empty)" } else { n.owner },
    " done=", if item_is_done(item: n.line, merged: []) { "yes" } else { "no" },
    "\n",
  ], "")
}

// EVERY NUMBER THIS PROBE PRINTS IS ONE IT READ. Both readers answer with a verdict, and a verdict that
// refused is printed as the refusal it is — never as 0. gunbc.design_argument::fail_closed: "a failure arm
// refuses, never widens", and the stronger line under it, that making the wrong statement unwritable beats
// catching it. An instrument may show less than it was asked for; it may not show a fact it did not
// observe, because a `0` in a measurement line is read as a measurement. (The two `or_empty` helpers this
// replaces did exactly that — one of them added by this change, one pre-existing — and the comment on the
// retired one claimed the refusal was "stated in the file's own words above", which was not true anywhere in
// this file. The projections that gate real work have always refused: gunbc.roadmap.roadmap_authority
// frontier_sets_projection.)
fn probe() -> ProcessExit {
  let declared = declared_roadmap_nodes()
  let declared_bad = filter(declared, n => !admissible(n: n))
  let active = active_roadmap_nodes_projection()
  let retired = roadmap_retired_node_ids_load()
  let body = join([
    "ROADMAP DENOMINATOR PROBE\n",
    "  declared          ", to_string(count(declared)), "\n",
    "  declared inadmissible ", to_string(count(declared_bad)), "\n",
    match active {
      ActiveRoadmapNodesProjected { nodes: ns } => join([
        "  active            ", to_string(count(ns)), "\n",
        "  active inadmissible   ", to_string(count(filter(ns, n => !admissible(n: n)))), "\n",
        "  active retired        ", match retired {
          RetiredNodeIdsLoaded { ids: ids } =>
            to_string(count(filter(ns, n => any(ids, r => (r as String) == (n.node as String)))))
          RetiredNodeIdsRefused { detail: detail } => join([
            "REFUSED — ", detail,
            " (not measured: a 0 in this line would be a number this probe never read)"], "")
        }, "\n",
      ], "")
      ActiveRoadmapNodesProjectionRefused { detail: detail } => join([
        "  active            REFUSED — ", detail, "\n",
        "  active inadmissible   REFUSED — ", detail, "\n",
        "  active retired        REFUSED — ", detail,
        " (no active set was read, so none of the three active figures is a measurement)\n",
      ], "")
    },
    "ACTIVE AND INADMISSIBLE:\n",
    match active {
      ActiveRoadmapNodesProjected { nodes: ns } =>
        join(map(filter(ns, n => !admissible(n: n)), n => row_line(n: n)), "")
      ActiveRoadmapNodesProjectionRefused { detail: detail } => join([
        "  REFUSED — ", detail,
        " (the list would be empty because nothing was read, not because nothing is wrong)\n"], "")
    },
  ], "")
  let w = Filesystem.Write(path: "target/roadmap-denominator-probe.txt", content: body)
  if w.success { ExitSuccess } else { exit_failure(reason: body) }
}
