module gunbc.instruments.native_serve_startup_overrun_fixture

import std.types { String, Int, List, CommitSha }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.compiler_entry { CompilerEntryDriver, NativeIngressDriver, NativeIngressProgram, NativeIngressStartup }
import gunbc.http_ingress { HttpIngressAdmission, http_ingress_binding }
import std.measure { second }
import extdeps.http.server { ServeWireResponse }
import gunbc.native_serve { native_serve_text_plain, NativeServeStartup, NativeServeStartupPassed }

// THE CONTROL SERVICE FOR "A STARTUP PAST ITS OWN BOUND IS THE MODELED STARTUP REFUSAL" (the bound its program
// descriptor declares, std.compiler_entry NativeIngressStartup bound, which the rendered main waits on).
// It declares a 1 s startup bound and a startup of 3*10^10 spin steps (gunbc.instruments.native_serve_startup_slow_fixture
// states the step cost: about 60 s or more, thirty-plus times the bound, and the process is gone at the bound). The main must exit with
// native_serve_startup_refused_exit_code before it binds, and the reader
// (gunbc.instruments.native_serve_startup_overrun_probe) is red if the service ever announces.
data native_serve_startup_overrun_fixture_program: NativeIngressProgram = NativeIngressProgram {
  binding: DeclarationRef { module_path: "gunbc.instruments.native_serve_startup_overrun_fixture", decl_name: "native_serve_startup_overrun_fixture_ingress", field: WholeDeclaration },
  handler: DeclarationRef { module_path: "gunbc.instruments.native_serve_startup_overrun_fixture", decl_name: "native_serve_startup_overrun_fixture_handle", field: WholeDeclaration },
  startup: Present { value: NativeIngressStartup {
    fold: DeclarationRef { module_path: "gunbc.instruments.native_serve_startup_overrun_fixture", decl_name: "native_serve_startup_overrun_fixture_startup", field: WholeDeclaration },
    bound: second(count: 1),
  } },
}

data compiler_pipeline_entry: CompilerEntryDriver = NativeIngressDriver {
  program: DeclarationRef { module_path: "gunbc.instruments.native_serve_startup_overrun_fixture", decl_name: "native_serve_startup_overrun_fixture_program", field: WholeDeclaration },
}

fn native_serve_startup_overrun_fixture_ingress(handler: String, listener: String, release_revision: String, cpu_limit_ms: Int, wall_limit_ms: Int) -> HttpIngressAdmission {
  http_ingress_binding(
    handler_module: native_serve_startup_overrun_fixture_program.handler.module_path as String, handler: handler, listener: listener,
    release_revision: release_revision, cpu_limit_ms: cpu_limit_ms, wall_limit_ms: wall_limit_ms,
  )
}

// The same modular-hash countdown as gunbc.instruments.native_serve_fixture fixture_spin (the accumulator's modulus keeps
// the optimizer from folding it to a closed form), restated here because importing that module would make its
// compiler pipeline entry a second entry of this crate.
fn startup_spin(n: Int, acc: Int) -> Int {
  if n == 0 { acc } else { startup_spin(n: n - 1, acc: (acc * 31 + n) % 1000003) }
}

fn native_serve_startup_overrun_fixture_startup(executable_octets: List<Int>) -> NativeServeStartup<Int> {
  let spun = startup_spin(n: 30000000000, acc: 7)
  NativeServeStartupPassed { line: concat("overrun startup finished after a spin of ", to_string(value: spun)), value: spun }
}

fn native_serve_startup_overrun_fixture_handle(method: String, path: String, body: String, tailscale_identity: String, authorization: String, release_revision: CommitSha, spun: Int) -> ServeWireResponse {
  ServeWireResponse { status: 200, content_type_label: native_serve_text_plain, body: "unreachable\n", headers: [] }
}
