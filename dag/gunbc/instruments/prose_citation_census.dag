module tools.prose_citation_census

import std.types { Bool, Int, String, GitRef, List, Map }
import std.algebra { trim }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.disposition { Disposition, Terminal, Scaffold, SingleAuthority }
import v2.std.decl_index { DataDeclTypeFact, data_decl_type_facts }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.git.inspect
import gunbc.prose_row_frontier { ProseRowRef, prose_row_decl_name, prose_row_decl_suffix }
import tools.opaque_realization_census { is_identifier_code_point }

// THE PROSE-CITATION CENSUS.
//
// The prose-bankruptcy sweep converted module-scope `data NAME_note: String` commentary rows into
// section 4c annotations. The prose they carried survives; the NAME does not. Every other paragraph
// in the corpus that cited one of those names by the section 3 form now names a symbol that no longer
// exists, and nothing refuses it -- std.source_annotation deliberately declines to mint an identity
// for an annotation, so a retired prose row did not become a HARDER citation target, it became an
// unaddressable one. This module makes that population discoverable.
//
// IT IS AN INSTRUMENT. IT MEASURES AND DOES NOT JUDGE. Nothing it emits gates, no workflow invokes
// it, and it stores no counts. It reports where a prose citation names a retired row; it does not
// decide whether that citation is right, and it repoints nothing.
//
// NO SWEEP, EVER, AND THIS IS THE REASON RATHER THAN A PREFERENCE. Annotation attachment is
// POSITIONAL -- a leading block attaches to whatever declaration FOLLOWS it -- so the obvious remedy,
// repointing every site at the declaration its annotation now sits above, is not semantics-preserving.
// The measured specimen is gunbc.host.memory_stall_refusal: the prose retired as
// host_budget_unreadable_cgroup_receipt_note was module-level rationale about an absorbing-fallback
// deletion, and the declaration that now follows it is an unrelated seed-mirror scaffold disposition.
// Repointing there produces a citation that RESOLVES AND LIES, which is strictly worse than one that
// dangles loudly, because a resolving citation is never re-examined. A mechanical sweep would
// manufacture that outcome once per cross-file site. The disposition of the standing population is a
// per-site judgment or nothing.
//
// THE OPEN QUESTION IS DEFERRED, NOT DROPPED: whether prose-citation resolution is a capability the
// compiler should own at all -- a section 4c/4b design question -- is an operator ruling that has not
// been taken. It was deferred deliberately, on the ground that it would otherwise be decided against a
// number nobody could re-derive. This module is what makes it decidable; taking the ruling is the
// consumer this census is waiting on.
//
// THE SUBJECT UNIVERSE, AND WHY IT IS INDEPENDENTLY DISCOVERED AND CLOSED. DESIGN section 5 refuses a
// measurement copied from the same current tree as an oracle. The subject here is not copied from
// anything: it is the set of prose rows that a DECLARED BASELINE REF held and that HEAD does not. git
// supplies the first half as a versioned authority external to this tree, and v2.std.decl_index
// supplies the second half by walking the live corpus. Neither is a number an author wrote down, so
// the population re-derives on demand.
//
// IT READS THE BASELINE'S DECLARATIONS AND NOT A DIFF, and the first cut did read a diff. That cut was
// abandoned on a MEASUREMENT rather than a preference: `git diff -U0 <pre-sweep> HEAD` is 18 MB and
// refused against the 8 MB shell output limit, 13 MB even restricted to `*.dag`, because the size is
// driven by the distance to HEAD and not by the retirement being measured. The refusal was correct and
// is the reason this producer changed shape. Reading the baseline's own `data NAME: String` heads is
// 1.06 MB, seventeen times smaller, and it is the better question besides: "the baseline declared this
// row" is a direct observation of the baseline, while a diff infers it from everything that happened
// afterwards. A row moved, renamed or re-added between the two points is a confound for the diff and
// is not visible to this read at all, because only the two endpoints are consulted.
//
// MEMBERSHIP IS DECIDED BY gunbc.prose_row_frontier AND NOWHERE ELSE. That module is the single
// authority for what a prose row IS -- a module-scope `data` whose name ends in `_note` and whose
// right-hand side opens a string literal -- and this census reuses its diff fold rather than
// recognising removals a second way. The consequence is a REAL and STATED coverage boundary: a retired
// `data` declaration whose name does not end in that suffix is outside this census's subject.
// Measured against the three sweep slices, the boundary excludes roughly five percent of the rows they
// retired. It is named here rather than closed by widening the frontier's suffix, because that suffix
// is the recognition rule of a standing wall and widening it from inside a measurement lane is the
// self-authorized dissolution DESIGN already names.
// THE DISPOSITION IS SPLIT, BECAUSE THE MODULE IS NOT ONE ARTIFACT.
//
// The recogniser, the carrier split, the join and the census type are TERMINAL. They take a line of
// prose and a retired index and answer which retired rows that line names; nothing about that question
// changes when the compiler starts publishing annotation text, and the answer is consumed by the
// operator ruling this census exists to make decidable.
//
// The TEXT ACQUISITION is not terminal and is marked as a scaffold rather than argued out of one. It
// reads .dag sources through filesystem_read and decides carrier by inspecting raw line shape, which
// re-derives from text a fact the front end already computes and deliberately erases:
// std.source_annotation captures each leading block as a SourceAnnotationDebt carrying its text and
// the occurrence it attaches to, and the semantic projection then drops it, so no Accepted program can
// read one. That erasure is correct and this census does not propose reversing it -- what it needs is
// the captured graph published as a corpus-wide fact producer beside v2.std.decl_index, at which point
// prose_citation_scan_sources and prose_citation_line_carrier DELETE and the recogniser above is fed
// annotation text keyed by subject instead of by line shape.
//
// THIS ROW DOES NOT ADMIT THE SCAFFOLD; THE OPERATOR DID, FROM OUTSIDE THE ARTIFACT. The realization
// disposition for a new source-text recogniser is an operator judgment, and a row that granted its own
// admission would be the self-authorized dissolution this corpus names -- an author who can write a
// scaffold can equally write a row claiming it was approved. So the verdict below is RECORDED here and
// was not decided here. Relayed by bright-ram-778; this session cannot read the operator thread, so the
// relay is the carrier and is recorded as such rather than as a first-hand reading.
//
// OPERATOR DISPOSITION: ScaffoldAdmitted, 2026-09-01, bound to gunbc#9940 at head 4a14b72d1f3c.
//
// THIS IS A NEW DISPOSITION AND NOT AN EXTENSION OF AN OLDER ONE, which has to be said or a later
// reader will find two source-text recognisers standing under one admission.
// gunbc.bare_reference_scanner_admission lists "additional source-text recognizers" among the things it
// explicitly does NOT cover, RESERVING them for a fresh judgment rather than extending its own. This
// ruling supplies that judgment for this recogniser only. Nothing here borrows that admission.
//
// THE ADMITTED SCOPE, exactly:
//   git.Inspect.GrepMatchesAtRevision
//   tools.prose_citation_census's raw-source text acquisition
//   the pure citation recognizer, join, carrier, and report
//   the current executing witness population
//   manual/on-demand invocation with caller-supplied baseline and report
//
// THE BOUNDARY, exactly, each item requiring a NEW disposition:
//   no required or advisory workflow invocation
//   no merge gate
//   no automatic source rewrite or citation repointing
//   no widening of gunbc.prose_row_frontier membership
//   no reuse as a general source-language recognizer
//   no baked baseline or persisted count
//
// RENEWAL IS REQUIRED FOR: a new workflow consumer, automatic judgment, an additional source-text
// recognizer, or a materially broader scan. A review correction that preserves the scope is not a
// renewal.
//
// THE DISSOLUTION, in the terms the ruling used, because the wording is the whole guarantee: when
// annotation text AND ITS ATTACHMENT IDENTITY are published corpus-wide beside the declaration index,
// the raw-line acquisition DELETES. It does not survive as a fallback. A fallback is the failure mode
// this sentence exists to forbid -- a deleted-in-name acquisition that still answers whenever the
// published surface is unavailable would leave two authorities for one fact and retire nothing.
//
// TEXT ACQUISITION REMAINS Scaffold UNDER THIS ADMISSION. Being admitted is not being terminal: the
// ruling grants that it may stand, not that it should survive. Relabelling this row Terminal on the
// strength of the admission would convert a bounded exception into a permanent construction, which is
// the one move the dissolution sentence above forbids. The recogniser half stays Terminal on its own
// executed controls, which is a different claim about a different half.
//
// WHY IT COULD STAND UNADMITTED WHILE THE JUDGMENT WAS OUTSTANDING, kept because it is the argument
// that made the question answerable rather than a request for a blanket blessing: the census gates
// nothing, and an unadmitted INSTRUMENT costs a reader's attention, whereas an unadmitted WALL would be
// spending someone else's merges.
data prose_citation_text_acquisition_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "std.source_annotation",
    decl_name: "SourceAnnotationDebt",
    field: WholeDeclaration
  }
}

data prose_citation_recogniser_disposition: Disposition = Terminal {
  reason: "The line recogniser, the two-carrier split, the retired-index join and the census projection answer a question that survives the text-acquisition scaffold above: given a line of prose and the set of retired prose rows, which rows does it name. Publishing annotation text corpus-wide changes where the line comes from and nothing about the answer, so this half is not staged work waiting to be replaced. It is Terminal on the strength of the executed controls in test.claim.prose_citation_census_witness -- the twelve sampled corpus specimens, the two boundary arms, the semantic-position negative, and the counter pair shown non-constant in its retired index -- and not on the strength of this sentence."
}

data prose_citation_census_roots: List<String> = ["dag", "src/v1", "src/v2"]

// The live half of the join. data_decl_type_facts covers TEST modules as well as production ones,
// which matters here rather than being incidental: the subject is `data NAME: String` rows and the
// narrower decl_facts walk skips test .dag files, so a row surviving only in a test module would read
// as retired and every citation of it would be reported as dangling.
data prose_citation_live_facts: List<DataDeclTypeFact> = data_decl_type_facts(pool_roots: prose_citation_census_roots)

// LIVENESS IS KEYED BY QUALIFIED DECLARATION IDENTITY, NOT BY BARE NAME, and the first cut was keyed
// by name. Review 58234 named it and the correction is a COHERENCE repair rather than only a join
// repair: under a bare-name key, a row retired from its own module while the same spelling survives in
// another module reads as "still live" and leaves the census entirely. That is not a marginal miss --
// it is the MORE severe class, because such a citation still RESOLVES, to a declaration that is not
// the one the prose meant. A census whose own argument is that a citation which resolves and lies is
// worse than one that dangles loudly cannot be built so that exactly those sites are the ones it
// cannot see.
//
// MEASURED at the pre-sweep baseline: 4002 retired rows carry 4002 distinct names and 0 sites fall in
// that class TODAY, while 38 prose-row names in the same baseline are declared across more than one
// file over 119 rows. The spelling already collides in this corpus; only the retired subset happens
// not to. Zero-today is a fact about this tree and not about the construction.
fn prose_citation_qualified(module_path: String, decl_name: String) -> String {
  concat(module_path, concat(".", decl_name))
}

// Both sides of this join are the AUTHORED, UNSTRIPPED module name -- v2.std.decl_index records that
// `module_path` retains its `v2.` prefix, and the baseline read below takes the module line as
// written. Checked rather than assumed, because a silent prefix mismatch would make every src/v2 row
// read as retired.
fn prose_citation_live_qualified_names() -> Map<String, Bool> {
  fold(
    prose_citation_live_facts,
    init: empty_map(),
    f: (acc, f) => if f.type_name == "String" { map_insert(acc, prose_citation_qualified(module_path: f.module_path, decl_name: f.decl_name), true) } else { acc }
  )
}

// The bare-name index answers a DIFFERENT question and both are needed. A prose citation names a bare
// symbol, so whether the cited spelling resolves to anything at all is decided by name; whether the
// row the prose MEANT still exists is decided by qualified identity. Collapsing the two is what the
// first cut did.
fn prose_citation_live_bare_names() -> Map<String, Bool> {
  fold(
    prose_citation_live_facts,
    init: empty_map(),
    f: (acc, f) => if f.type_name == "String" { map_insert(acc, f.decl_name, true) } else { acc }
  )
}

// The pattern is deliberately WIDER than membership: it selects every `data NAME: String` head, and
// gunbc.prose_row_frontier then decides which of them is a prose row. A pattern narrowed to the `_note`
// suffix would put the membership rule in an argv string beside the module that owns it, so the two
// could drift and the argv would win silently.
data prose_citation_baseline_pattern: String = "^data [A-Za-z0-9_]+: String = \""

data prose_citation_baseline_pathspec: String = "*.dag"

// The module line of each baseline source, read at the same revision, so a baseline row can carry the
// qualified identity the join above needs. A file with no module line contributes no rows: its
// declarations have no qualified identity to compare, and inventing one from the path would be the
// positional naming DESIGN section 3 refuses.
data prose_citation_module_pattern: String = "^module [A-Za-z0-9_.]+"

// Each match arrives as `<ref>:<path>:data NAME: String = "`. Splitting on the FIRST TWO colons is
// wrong in general -- a ref can contain a colon -- but not here, because the ref this operation was
// handed is the ref that prefixes every line, so its length is known and the path begins after it.
fn prose_citation_strip_ref(line: String, ref_len: Int) -> String {
  if string_length(s: line) <= ref_len + 1 { "" } else { substring(s: line, start: ref_len + 1, end: string_length(s: line)) }
}

fn prose_citation_colon_index(s: String, i: Int, len: Int) -> Int {
  if i >= len {
    len
  } else if code_point(ch: char_at(s, i)) == 58 {
    i
  } else {
    prose_citation_colon_index(s: s, i: i + 1, len: len)
  }
}

// READING A MATCH LINE HAS FOUR OUTCOMES, NOT TWO, and collapsing them into an Optional is the same
// concealment review 58281 found on the module side. An `Optional<ProseRowRef>` says a line did not
// become a row; it cannot say WHY, so a line that git grep should never have produced is
// indistinguishable from one of the thousands of ordinary `data NAME: String` rows this census must
// not touch.
//
// THE THREE NON-ROW ARMS ARE MATERIALLY DIFFERENT:
//   - NotAProseRow is the census working correctly. Measured at the pre-sweep baseline, 3058 of the
//     7865 declaration lines carry program data rather than prose. Refusing on these would refuse on
//     every healthy run.
//   - Blank is the trailing element `split` yields for the final newline. It is an artifact of how the
//     output is cut, not a fact about the corpus -- and it MUST be its own arm, because it reaches the
//     no-separator test and would otherwise be read as malformed, firing the wall on every run.
//   - Unparsable is git grep output that is not shaped like git grep output. That is the acquisition
//     lying about its own format, and it is the only arm that is a refusal.
//
// The measured partition at 2afe322f closes exactly -- 4807 rows + 3058 non-prose = 7865 lines read,
// zero unparsable -- so the refusal below cannot fire on a healthy read. A count gap and a silent drop
// are indistinguishable from the gap alone, which is why the scan carries every arm's count and the
// witness asserts the four exhaust the input rather than asserting a filter exists.
type BaselineLineReading =
  BaselineRowRead { row: ProseRowRef }
  | BaselineLineNotAProseRow
  | BaselineLineBlank
  | BaselineLineUnparsable { line: String }

fn prose_citation_baseline_reading(line: String, ref_len: Int) -> BaselineLineReading {
  if string_length(s: trim(s: line)) == 0 {
    BaselineLineBlank
  } else {
    let rest = prose_citation_strip_ref(line: line, ref_len: ref_len)
    let n = string_length(s: rest)
    let colon = prose_citation_colon_index(s: rest, i: 0, len: n)
    if colon >= n {
      BaselineLineUnparsable { line: line }
    } else {
      let path = substring(s: rest, start: 0, end: colon)
      match prose_row_decl_name(line: substring(s: rest, start: colon + 1, end: n)) {
        Absent => BaselineLineNotAProseRow
        Present { value: name } => BaselineRowRead { row: ProseRowRef { path: path, decl_name: name } }
      }
    }
  }
}

fn prose_citation_module_of_line(line: String, ref_len: Int) -> ProseRowRef? {
  let rest = prose_citation_strip_ref(line: line, ref_len: ref_len)
  let n = string_length(s: rest)
  let colon = prose_citation_colon_index(s: rest, i: 0, len: n)
  if colon >= n {
    none
  } else {
    let decl = substring(s: rest, start: colon + 1, end: n)
    if !starts_with(s: decl, prefix: "module ") {
      none
    } else {
      Present { value: ProseRowRef { path: substring(s: rest, start: 0, end: colon), decl_name: substring(s: decl, start: 7, end: string_length(s: decl)) } }
    }
  }
}

fn prose_citation_module_index(matches: String, ref_len: Int) -> Map<String, String> {
  fold(
    split(s: matches, delimiter: "\n"),
    init: empty_map(),
    f: (acc, line) =>
      match prose_citation_module_of_line(line: line, ref_len: ref_len) {
        Absent => acc
        Present { value: row } => map_insert(acc, row.path, row.decl_name)
      }
  )
}

// EVERY LINE LANDS IN EXACTLY ONE ARM AND THE ARMS ARE COUNTED, so "nothing escaped" is a claim this
// scan can answer about itself rather than one a reader has to take on faith.
type ProseCitationBaselineScan {
  rows: List<ProseRowRef>
  non_prose_count: Int
  blank_count: Int
  unparsable: List<String>
}

fn prose_citation_baseline_scan(matches: String, ref_len: Int) -> ProseCitationBaselineScan {
  fold(
    split(s: matches, delimiter: "\n"),
    init: ProseCitationBaselineScan { rows: [], non_prose_count: 0, blank_count: 0, unparsable: [] },
    f: (acc, line) =>
      match prose_citation_baseline_reading(line: line, ref_len: ref_len) {
        BaselineRowRead { row: r } => ProseCitationBaselineScan { rows: concat(acc.rows, [r]), non_prose_count: acc.non_prose_count, blank_count: acc.blank_count, unparsable: acc.unparsable }
        BaselineLineNotAProseRow => ProseCitationBaselineScan { rows: acc.rows, non_prose_count: acc.non_prose_count + 1, blank_count: acc.blank_count, unparsable: acc.unparsable }
        BaselineLineBlank => ProseCitationBaselineScan { rows: acc.rows, non_prose_count: acc.non_prose_count, blank_count: acc.blank_count + 1, unparsable: acc.unparsable }
        BaselineLineUnparsable { line: l } => ProseCitationBaselineScan { rows: acc.rows, non_prose_count: acc.non_prose_count, blank_count: acc.blank_count, unparsable: concat(acc.unparsable, [l]) }
      }
  )
}

// A baseline row is RETIRED when its QUALIFIED identity is no longer declared. A row whose module is
// unknown at the baseline is NOT judged either way -- but it is also NOT DROPPED, and the difference
// between those two is the whole of this carrier.
//
// THE FIRST CUT DROPPED THEM, AND REVIEW 58281 IS RIGHT THAT IT WAS FAIL-OPEN. The module read is an
// acquisition, so it can fail; when it does the index is empty, EVERY baseline row is unidentified,
// and a silent drop renders that as "nothing was retired" -- an acquisition failure returned as a
// reassuring Observed census. That is the empty-observation narrow this module's own header argues
// against, introduced by me while fixing the previous review: I checked exit_code on the first git
// query and reasoned about it at length, then added a second query during the same rework and
// consumed its output inline with no outcome check at all.
//
// SO THE UNIDENTIFIED ROWS ARE COUNTED AND CARRIED, and the caller refuses on any of them. Measured
// at the pre-sweep baseline: 4807 prose rows against 4412 module lines, and ZERO rows without a
// module identity -- every .dag source declaring a row also declares its module. So this arm cannot
// fire spuriously on a healthy read; it fires exactly when the acquisition is broken, which is what
// makes it a wall rather than a nuisance.
type ProseCitationRetirementScan {
  retired: List<ProseRowRef>
  unidentified: List<ProseRowRef>
}

fn prose_citation_retirement_scan(baseline_rows: List<ProseRowRef>, modules: Map<String, String>, live_qualified: Map<String, Bool>) -> ProseCitationRetirementScan {
  fold(
    baseline_rows,
    init: ProseCitationRetirementScan { retired: [], unidentified: [] },
    f: (acc, row) =>
      match lookup(modules, row.path) {
        Absent => ProseCitationRetirementScan { retired: acc.retired, unidentified: concat(acc.unidentified, [row]) }
        Present { value: m } =>
          if map_contains_key(live_qualified, prose_citation_qualified(module_path: m, decl_name: row.decl_name)) {
            acc
          } else {
            ProseCitationRetirementScan { retired: concat(acc.retired, [row]), unidentified: acc.unidentified }
          }
      }
  )
}

// THE ORIGIN OF A RETIRED NAME IS NOT ALWAYS ONE PATH, and this carrier exists because the first cut
// assumed it was. That cut was a Map<String, String> built by map_insert, so two baseline rows sharing
// a name kept whichever the fold saw last and the loser vanished with no diagnostic -- a silent
// last-write-wins deciding an attribute a disposition turns on.
//
// MEASURED, so the fix is not priced on a hypothetical: at the pre-sweep baseline 4002 retired rows
// carry 4002 distinct names, so the collision population is ZERO TODAY. It is fixed anyway, because 38
// prose-row names in that same baseline ARE declared in more than one file across 119 rows -- the
// spelling collides in the corpus already and only the retired SUBSET happens not to. A realized n of
// zero is not a time-stable fact, and a census whose origin attribute silently depends on fold order
// is wrong in a way no future reader could see.
//
// AMBIGUITY IS CARRIED, NOT RESOLVED. Where a name was retired from several paths, this refuses to
// pick one: a prose citation names a bare symbol, so nothing in the site says which origin it meant,
// and choosing would fabricate the answer rather than report the state.
type ProseRowOrigin
  = RetiredFromOnePath { path: String }
  | RetiredFromSeveralPaths

fn prose_citation_merge_origin(existing: ProseRowOrigin, path: String) -> ProseRowOrigin {
  match existing {
    RetiredFromSeveralPaths => RetiredFromSeveralPaths {}
    RetiredFromOnePath { path: seen } => if seen == path { RetiredFromOnePath { path: seen } } else { RetiredFromSeveralPaths {} }
  }
}

fn prose_citation_retired_index(rows: List<ProseRowRef>) -> Map<String, ProseRowOrigin> {
  fold(
    rows,
    init: empty_map(),
    f: (acc, row) =>
      match lookup(acc, row.decl_name) {
        Absent => map_insert(acc, row.decl_name, RetiredFromOnePath { path: row.path })
        Present { value: seen } => map_insert(acc, row.decl_name, prose_citation_merge_origin(existing: seen, path: row.path))
      }
  )
}

// WHY THE SCAN SPLITS ON THE SUFFIX RATHER THAN TOKENISING EVERY WORD. Every name in the subject
// universe ends in gunbc.prose_row_frontier's prose_row_decl_suffix by the definition above, so the
// occurrences of that suffix are a COMPLETE COVER of the candidate positions and there are four orders
// of magnitude fewer of them than there are identifier tokens in the corpus. The split is one host
// call per line; what remains is a bounded backward walk per occurrence. Tokenising every word and
// joining against the retired set answers the identical question at a cost the substrate cannot pay,
// which is a cost-shape defect rather than a matter of taste.
fn prose_citation_ident_run_start(s: String, i: Int) -> Int {
  if i <= 0 {
    0
  } else if is_identifier_code_point(cp: code_point(ch: char_at(s, i - 1))) {
    prose_citation_ident_run_start(s: s, i: i - 1)
  } else {
    i
  }
}

fn prose_citation_trailing_identifier(s: String) -> String {
  let n = string_length(s: s)
  substring(s: s, start: prose_citation_ident_run_start(s: s, i: n), end: n)
}

// The trailing side of the boundary. `x_notebook` is not an occurrence of a name ending in the
// suffix, and reporting it would be the substring-for-token error opaque_realization_census already
// names in its own reader.
fn prose_citation_next_is_boundary(piece: String) -> Bool {
  if string_length(s: piece) == 0 {
    true
  } else {
    !is_identifier_code_point(cp: code_point(ch: substring(s: piece, start: 0, end: 1)))
  }
}

fn prose_citation_names_contain(names: List<String>, wanted: String) -> Bool {
  fold(names, init: false, f: (found, n) => found || n == wanted)
}

// One name occurring twice on one line is one citation of it, so the scan reduces to the distinct
// names on the line. The reduction is written here rather than taken from the `dedup` primitive
// because that primitive establishes no method surface on List<String> today; the shape is the same
// membership fold this module already uses, and it dissolves when the primitive is inhabited.
fn prose_citation_distinct(names: List<String>) -> List<String> {
  fold(names, init: [], f: (acc, n) => if prose_citation_names_contain(names: acc, wanted: n) { acc } else { concat(acc, [n]) })
}

type ProseNameScan {
  prev: String
  started: Bool
  names: List<String>
}

// The leading side of the boundary falls out of taking the whole identifier run before the suffix, so
// `foo_note` inside `bar_foo_note` yields `bar_foo_note` and never the shorter name.
fn prose_citation_names_in_line(line: String) -> List<String> {
  let scan = fold(
    split(s: line, delimiter: prose_row_decl_suffix),
    init: ProseNameScan { prev: "", started: false, names: [] },
    f: (acc, piece) =>
      if !acc.started {
        ProseNameScan { prev: piece, started: true, names: acc.names }
      } else {
        let head = prose_citation_trailing_identifier(s: acc.prev)
        ProseNameScan {
          prev: piece,
          started: true,
          names: if head != "" && prose_citation_next_is_boundary(piece: piece) { concat(acc.names, [concat(head, prose_row_decl_suffix)]) } else { acc.names }
        }
      }
  )
  prose_citation_distinct(names: scan.names)
}

// A citation sits in one of exactly two carriers, and the split is worth keeping because they have
// different futures: an annotation is unreadable to any Accepted program by construction (section 4c),
// while a surviving `String` row is prose the frontier has not swept yet and will.
type ProseCitationCarrier
  = InAnnotationBlock
  | InProseRowLiteral

data prose_citation_row_infix: String = ": String = \""

// A LINE THAT IS NEITHER CARRIER IS NOT A CITATION SITE. A retired name occurring in a semantic
// position -- an import, a reference, a declaration -- is a program fact that refuses on its own, and
// reporting it here would be this census answering a question the compiler already answers.
//
// THE MEASURED BOUNDARY, STATED RATHER THAN ASSUMED: a prose row is recognised on the line that opens
// its literal, so a citation on a CONTINUATION line of a multi-line string literal is outside the
// scan. Measured over the three sweep slices that population is ZERO -- every prose row in this corpus
// authors its literal on one line with escaped breaks, the same single-line shape
// gunbc.prose_row_frontier's own recogniser depends on. A zero measured today is not a zero guaranteed
// tomorrow, so the boundary is named; it dissolves with the frontier's single-line assumption and not
// separately.
fn prose_citation_line_carrier(line: String) -> ProseCitationCarrier? {
  if starts_with(s: trim(s: line), prefix: "//") {
    Present { value: InAnnotationBlock }
  } else if string_contains(s: line, pattern: prose_citation_row_infix) {
    Present { value: InProseRowLiteral }
  } else {
    none
  }
}

// A site is one (path, line, cited name). The line number is carried BESIDE the identity and is never
// the identity: DESIGN section 3 rules that a position decays under any edit above it, and this census
// re-derives on demand precisely so a consumer never has to trust a stored one.
//
// LOCALITY IS THE ONE DERIVED ATTRIBUTE AND IT IS THE ATTRIBUTE A DISPOSITION TURNS ON. A citation in
// the file the row was retired from can be read against the annotation that replaced it; a citation in
// another file cannot, because nothing in that file records what happened.
//
// IT IS THREE STATES AND NOT A Bool. A Bool has no spelling for "the name was retired from several
// paths, so which file this citation is local TO is not decidable from the site" -- and a Bool would
// have to answer that case true or false, which is ignorance rendered as an answer. The third arm is
// the refusal, carried into the census where it can be counted rather than absorbed into either of the
// other two.
type ProseCitationLocality
  = InRetiringFile
  | InAnotherFile
  | RetiringFileAmbiguous

// RESOLUTION IS THE SECOND DERIVED ATTRIBUTE AND IT IS THE ONE THIS MODULE'S OWN ARGUMENT TURNS ON.
// A citation whose spelling is declared nowhere cannot resolve, and a reader hits a dead name and
// knows it. A citation whose spelling survives in ANOTHER module resolves -- to a declaration that is
// not the one the prose meant. The second is the worse state for exactly the reason the no-sweep
// paragraph above gives: a resolving citation is never re-examined. Collapsing them, or dropping the
// second by keying liveness on the bare name, would make the census blind to its own thesis.
type ProseCitationResolution
  = CitedNameAbsentEverywhere
  | CitedNameSurvivesElsewhere

type ProseCitationSite {
  rel_path: String
  line: Int
  cited_name: String
  origin: ProseRowOrigin
  carrier: ProseCitationCarrier
  locality: ProseCitationLocality
  resolution: ProseCitationResolution
}

type ProseCitationLineScan {
  line_no: Int
  sites: List<ProseCitationSite>
}

fn prose_citation_locality_of(origin: ProseRowOrigin, rel_path: String) -> ProseCitationLocality {
  match origin {
    RetiredFromSeveralPaths => RetiringFileAmbiguous {}
    RetiredFromOnePath { path: home } => if home == rel_path { InRetiringFile {} } else { InAnotherFile {} }
  }
}

fn prose_citation_site_of(rel_path: String, line: Int, name: String, origin: ProseRowOrigin, carrier: ProseCitationCarrier, survives: Bool) -> ProseCitationSite {
  ProseCitationSite {
    rel_path: rel_path,
    line: line,
    cited_name: name,
    origin: origin,
    carrier: carrier,
    locality: prose_citation_locality_of(origin: origin, rel_path: rel_path),
    resolution: if survives { CitedNameSurvivesElsewhere {} } else { CitedNameAbsentEverywhere {} }
  }
}

// THE MEMBERSHIP TEST AND THE READ ARE ONE STEP, and that is not a tidiness point. Written as a
// filter on map_contains_key followed by a lookup, the read has an arm for a key the filter just
// proved present -- an unreachable state that still needs a value, and the tempting value is "".
// That empty string would then flow into locality as a path that equals nothing, reporting every
// site as being in another file. Matching the Optional once removes the arm rather than filling it: a name that
// is not in the retired index produces no site, and every site that exists carries a real path.
fn prose_citation_sites_in_line(rel_path: String, line_no: Int, line: String, retired: Map<String, ProseRowOrigin>, live_bare: Map<String, Bool>) -> List<ProseCitationSite> {
  match prose_citation_line_carrier(line: line) {
    Absent => []
    Present { value: carrier } =>
      fold(
        prose_citation_names_in_line(line: line),
        init: [],
        f: (acc, name) =>
          match lookup(retired, name) {
            Absent => acc
            Present { value: origin } =>
              concat(acc, [prose_citation_site_of(rel_path: rel_path, line: line_no, name: name, origin: origin, carrier: carrier, survives: map_contains_key(live_bare, name))])
          }
      )
  }
}

fn prose_citation_sites_in_source(rel_path: String, text: String, retired: Map<String, ProseRowOrigin>, live_bare: Map<String, Bool>) -> List<ProseCitationSite> {
  let scan = fold(
    split(s: text, delimiter: "\n"),
    init: ProseCitationLineScan { line_no: 0, sites: [] },
    f: (acc, line) =>
      ProseCitationLineScan {
        line_no: acc.line_no + 1,
        sites: concat(acc.sites, prose_citation_sites_in_line(rel_path: rel_path, line_no: acc.line_no + 1, line: line, retired: retired, live_bare: live_bare))
      }
  )
  scan.sites
}

type ProseCitationCensus {
  baseline: String
  retired_row_count: Int
  cited_name_count: Int
  site_count: Int
  annotation_site_count: Int
  prose_row_site_count: Int
  another_file_site_count: Int
  ambiguous_origin_site_count: Int
  absent_everywhere_site_count: Int
  survives_elsewhere_site_count: Int
  sites: List<ProseCitationSite>
}

// AN OBSERVATION THAT COULD NOT READ ITS INPUT IS NOT AN OBSERVATION OF ZERO. A failed diff read, a
// diff whose structure gunbc.prose_row_frontier refuses, and a corpus walk that returned nothing are
// three distinct states, and rendering any of them as "no dangling citations" is the empty-observation
// narrow: silently uncovered rather than merely expensive.
type ProseCitationCensusOutcome
  = ProseCitationCensusObserved { census: ProseCitationCensus }
  | ProseCitationCensusUnreadable { reason: String }

fn prose_citation_census_of(baseline: String, sites: List<ProseCitationSite>, retired_row_count: Int) -> ProseCitationCensus {
  ProseCitationCensus {
    baseline: baseline,
    retired_row_count: retired_row_count,
    cited_name_count: prose_citation_distinct(names: sites |> map(s => s.cited_name)) |> count,
    site_count: sites |> count,
    annotation_site_count: sites |> filter(s => match s.carrier { InAnnotationBlock => true, InProseRowLiteral => false }) |> count,
    prose_row_site_count: sites |> filter(s => match s.carrier { InAnnotationBlock => false, InProseRowLiteral => true }) |> count,
    another_file_site_count: sites |> filter(s => match s.locality { InAnotherFile => true, InRetiringFile => false, RetiringFileAmbiguous => false }) |> count,
    ambiguous_origin_site_count: sites |> filter(s => match s.locality { RetiringFileAmbiguous => true, InRetiringFile => false, InAnotherFile => false }) |> count,
    absent_everywhere_site_count: sites |> filter(s => match s.resolution { CitedNameAbsentEverywhere => true, CitedNameSurvivesElsewhere => false }) |> count,
    survives_elsewhere_site_count: sites |> filter(s => match s.resolution { CitedNameSurvivesElsewhere => true, CitedNameAbsentEverywhere => false }) |> count,
    sites: sites
  }
}

// The identity key a consumer joins on, and the only rendering of a site this module offers. Path and
// name are the identity; the line is carried for a human to find it and is deliberately last.
fn prose_citation_origin_text(origin: ProseRowOrigin) -> String {
  match origin {
    RetiredFromSeveralPaths => "SEVERAL-PATHS"
    RetiredFromOnePath { path: p } => p
  }
}

fn prose_citation_site_key(s: ProseCitationSite) -> String {
  concat(s.rel_path, concat(" ", concat(s.cited_name, concat(" retired-from ", concat(prose_citation_origin_text(origin: s.origin), concat(" :", to_string(s.line)))))))
}

fn prose_citation_render(census: ProseCitationCensus) -> String {
  concat(
    concat("prose citation census baseline=", census.baseline),
    concat(concat(" retired-rows=", to_string(census.retired_row_count)),
    concat(concat(" sites=", to_string(census.site_count)),
    concat(concat(" names=", to_string(census.cited_name_count)),
    concat(concat(" annotation=", to_string(census.annotation_site_count)),
    concat(concat(" prose-row=", to_string(census.prose_row_site_count)),
    concat(concat(" another-file=", to_string(census.another_file_site_count)),
    concat(concat(" ambiguous-origin=", to_string(census.ambiguous_origin_site_count)),
    concat(concat(" absent-everywhere=", to_string(census.absent_everywhere_site_count)),
           concat(" survives-elsewhere=", to_string(census.survives_elsewhere_site_count))))))))))
  )
}

// THE LIVE EDGE. Everything above is pure over (path, text, retired index) so the controls can run the
// real decision on specimens; this is the only part that reads the world, and it reads it twice --
// once for the baseline diff, once per source text.
//
// THE BASELINE IS A PARAMETER AND NOT A LITERAL. Three sweep slices merged as three commits, so the
// slice split a consumer wants is three runs of this function rather than three magic numbers written
// into it. A baseline named here would be a transcribed measurement of exactly the kind DESIGN section
// 6 refuses, and it would rot the first time another sweep landed.
//
// THE FILE ROSTER COMES FROM THE TREE LISTING AND NOT FROM THE DECLARATION INDEX, and the first cut
// got this wrong in the direction that makes a census look clean. That cut took the union of
// data_decl_type_facts and decl_facts rel_paths, reasoning that between them they cover every
// declaration kind and every module. They do not cover every FILE: a source with no `data` row is
// invisible to the first, and the second skips test .dag files, so a test module declaring only
// `test fn` rows appears in NEITHER. Measured against an independently written oracle, that lost NINE
// citation sites, every one of them in a test module with zero `data` declarations -- an
// empty-observation narrow arriving as a smaller and more reassuring number.
//
// A DECLARATION INDEX IS NOT A FILE ROSTER, which is the durable form of the mistake: it answers
// "which files declare something I can see", and this scan needs "which files exist". The tree listing
// answers the second by construction, so the roster cannot silently shrink when a file's declarations
// happen to fall outside an index's coverage.
//
// THE ROSTER IS THE TRACKED TREE AT HEAD, so a file in the working tree that git does not yet track is
// not scanned. That is the right boundary for a census whose other half is a git revision -- both ends
// then answer about the same committed history rather than about one author's uncommitted state -- but
// it is stated because it has a visible consequence: this module and its witness were invisible to
// their own census until they were committed, and the first run that includes them reports their prose
// among the sites.
fn prose_citation_dag_source_paths(paths_nul: String) -> List<String> {
  split(s: paths_nul, delimiter: from_code_point(cp: 0))
    |> filter(p => ends_with(s: p, suffix: ".dag") && prose_citation_path_under_roots(path: p))
}

fn prose_citation_path_under_roots(path: String) -> Bool {
  fold(prose_citation_census_roots, init: false, f: (found, root) => found || starts_with(s: path, prefix: concat(root, "/")))
}

fn prose_citation_scan_sources(paths: List<String>, retired: Map<String, ProseRowOrigin>, live_bare: Map<String, Bool>) -> List<ProseCitationSite> {
  fold(
    paths,
    init: [],
    f: (acc, path) => concat(acc, prose_citation_sites_in_source(rel_path: path, text: filesystem_read(path: path).content, retired: retired, live_bare: live_bare))
  )
}

// AN UNREADABLE REVISION, AN EMPTY MATCH SET AND A CORPUS WALK THAT RETURNED NOTHING ARE THREE
// DISTINCT STATES. git grep exits 1 for no matches, which is why the operation publishes exit_code
// rather than a Bool: a baseline that genuinely declared no prose rows and a baseline that could not
// be read must not render alike, and only the second is a refusal.
fn prose_citation_census_live(baseline: String) -> ProseCitationCensusOutcome {
  let found = git.Inspect.GrepMatchesAtRevision(
    pattern: prose_citation_baseline_pattern,
    ref: baseline as GitRef,
    pathspec: prose_citation_baseline_pathspec
  )
  if found.exit_code != 0 && found.exit_code != 1 {
    ProseCitationCensusUnreadable { reason: concat(concat("git grep could not read baseline ", baseline), concat(": ", found.stderr)) }
  } else {
    let scan_in = prose_citation_baseline_scan(matches: found.matches, ref_len: string_length(s: baseline))
    let baseline_rows = scan_in.rows
    if (scan_in.unparsable |> count) > 0 {
      ProseCitationCensusUnreadable { reason: concat(concat(concat("the baseline declaration read returned ", to_string(scan_in.unparsable |> count)), " line(s) not shaped like git grep output, so the acquisition is misreporting its own format and any row count from it is unsound; first: "), fold(scan_in.unparsable, init: "", f: (first, l) => if first == "" { l } else { first })) }
    } else if (baseline_rows |> count) == 0 {
      ProseCitationCensusUnreadable { reason: concat("baseline declared no prose rows at all, which is a read that found nothing rather than a retirement of nothing: ", baseline) }
    } else {
      let listed = git.Inspect.ListTreePathsAtRevision(ref: "HEAD" as GitRef)
      let paths = prose_citation_dag_source_paths(paths_nul: listed.paths_nul)
      if !listed.success || (paths |> count) == 0 {
        ProseCitationCensusUnreadable { reason: "the tree listing returned no .dag sources under the declared roots, so no citation site could be observed" }
      } else {
        let module_read = git.Inspect.GrepMatchesAtRevision(
          pattern: prose_citation_module_pattern,
          ref: baseline as GitRef,
          pathspec: prose_citation_baseline_pathspec
        )
        if module_read.exit_code != 0 {
          ProseCitationCensusUnreadable { reason: concat(concat("the baseline module read failed, so no baseline row carries a qualified identity and every retirement would read as absent: ", baseline), concat(": ", module_read.stderr)) }
        } else {
          let modules = prose_citation_module_index(matches: module_read.matches, ref_len: string_length(s: baseline))
          let scan = prose_citation_retirement_scan(baseline_rows: baseline_rows, modules: modules, live_qualified: prose_citation_live_qualified_names())
          if (scan.unidentified |> count) > 0 {
            ProseCitationCensusUnreadable { reason: concat(concat("the baseline module read covered only part of the corpus: ", to_string(scan.unidentified |> count)), " prose row(s) carry no module identity, and judging them either way would report an acquisition gap as a retirement answer") }
          } else {
            ProseCitationCensusObserved {
              census: prose_citation_census_of(
                baseline: baseline,
                sites: prose_citation_scan_sources(paths: paths, retired: prose_citation_retired_index(rows: scan.retired), live_bare: prose_citation_live_bare_names()),
                retired_row_count: scan.retired |> count
              )
            }
          }
        }
      }
    }
  }
}

fn prose_citation_census_report(baseline: String) -> String {
  match prose_citation_census_live(baseline: baseline) {
    ProseCitationCensusUnreadable { reason: r } => concat("prose citation census UNREADABLE: ", r)
    ProseCitationCensusObserved { census: c } => prose_citation_render(census: c)
  }
}

fn prose_citation_site_lines(sites: List<ProseCitationSite>) -> String {
  fold(sites, init: "", f: (acc, s) => concat(acc, concat(prose_citation_site_key(s: s), "\n")))
}

// THE MEASUREMENT IS WRITTEN, NOT PRINTED, and the report carries the SITE IDENTITIES rather than the
// totals alone. A consumer deciding the disposition of this population needs to join on identity; a
// consumer handed six integers can only quote them, which is how a re-derivable measurement turns back
// into the transcribed number this module exists to replace.
//
// THE UNREADABLE ARM REFUSES AND WRITES NOTHING. A report file holding a plausible zero is worse than
// no report file, because the next reader cannot tell the two apart.
fn prose_citation_census_write(baseline: String, report: String) -> ProcessExit {
  if baseline == "" {
    exit_failure(reason: "prose_citation_census_write: --arg baseline=<git ref held BEFORE the retirement> is required; the population is what that ref declared and HEAD does not")
  } else if report == "" {
    exit_failure(reason: "prose_citation_census_write: --arg report=<path> is required -- the measurement is written, not printed")
  } else {
    match prose_citation_census_live(baseline: baseline) {
      ProseCitationCensusUnreadable { reason: r } => exit_failure(reason: concat("prose citation census UNREADABLE, nothing written: ", r))
      ProseCitationCensusObserved { census: c } => {
        let written = Filesystem.Write(
          path: report,
          content: concat(prose_citation_render(census: c), concat("\n", prose_citation_site_lines(sites: c.sites)))
        )
        if written.success { ExitSuccess } else { exit_failure(reason: concat("prose citation census measured but could not write its report to ", report)) }
      }
    }
  }
}
