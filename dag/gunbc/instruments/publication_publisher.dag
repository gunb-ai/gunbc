module tools.publication_publisher

import std.types { Bool, List, NonEmptyStr, String }
import std.content_hash { serialize_content_hash }
import extdeps.git.hooks { PrePushStdinRow }
import gunbc.public_projection { PublicProjectionPlan, PublicProjectionSubject }
import gunbc.publication_admission_delta {
  ChangeLocalAdmissionRequest,
  ChangeLocalAdmissionOutcome,
  ChangeLocalAdmitted,
  ChangeLocalRefused,
  CandidateDigestInconsistent,
  WholeProjectionAuditRequired,
  ProjectionDeltaClass,
  NewlyPublic,
  admit_change_local_projection,
}
import gunbc.publication_decision {
  PublicationDecisionReceipt,
  PublicationAuthorityId,
  publication_decision_binds_content,
  publication_decision_authorizes_newly_public,
}

data publication_publisher_note: String = "Slice-1 sole modeled publisher (model + shadow only). Ordinary ModeledSessionId values are OrdinarySession and carry no PublicationAuthority. Exactly one sole_modeled_publisher_session may consume a change-locally admitted PublicProjectionPlan derived from PublicationPolicy — never a pathname census or placement-gate roster. Ordinary sessions do NOT yet lose live public-write capability in this slice; credentials and push machinery are unchanged."

type ModeledSessionId = NonEmptyStr where brand("ModeledSessionId")

type SessionPublicationPosture
  = OrdinarySession { session: ModeledSessionId }
  | SoleModeledPublisher { session: ModeledSessionId }

type AdmittedPublicProjection {
  plan: PublicProjectionPlan
  admission: ChangeLocalAdmissionOutcome
  decisions: List<PublicationDecisionReceipt>
}

type PublicationAuthority {
  publisher_session: ModeledSessionId
  authority_id: PublicationAuthorityId
  projection: AdmittedPublicProjection
}

type PublicWriteAdmission
  = PublicWriteAdmitted { authority: PublicationAuthority }
  | PublicWriteRefused {
      session: ModeledSessionId,
      cause: PublicWriteRefusal,
    }

type PublicWriteRefusal
  = NotTheSolePublisher {
      session: ModeledSessionId,
      sole_publisher: ModeledSessionId,
    }
  | ProjectionNotAdmitted {
      session: ModeledSessionId,
      detail: String,
    }
  | DecisionReceiptMissing {
      session: ModeledSessionId,
      subject_identity: String,
    }
  | DecisionReceiptNotAuthorizing {
      session: ModeledSessionId,
      subject_identity: String,
      detail: String,
    }
  | UnauthorizedPublicPush {
      session: ModeledSessionId,
      local_ref: String,
      local_sha: String,
      detail: String,
    }
  | NoPushedRefsPresented {
      session: ModeledSessionId,
    }

data sole_modeled_publisher_session: ModeledSessionId = "gunbc-publication-publisher" as ModeledSessionId

data sole_publication_authority_id: PublicationAuthorityId = "gunbc-publication-publisher" as PublicationAuthorityId

fn session_publication_posture(session: ModeledSessionId) -> SessionPublicationPosture {
  if session == sole_modeled_publisher_session {
    SoleModeledPublisher { session: session }
  } else {
    OrdinarySession { session: session }
  }
}

fn session_publication_posture_fold<T>(
  posture: SessionPublicationPosture,
  on_ordinary: fn(ModeledSessionId) -> T,
  on_sole_publisher: fn(ModeledSessionId) -> T,
) -> T {
  match posture {
    OrdinarySession { session: session } => on_ordinary(session)
    SoleModeledPublisher { session: session } => on_sole_publisher(session)
  }
}

fn change_local_admission_detail(outcome: ChangeLocalAdmissionOutcome) -> String {
  match outcome {
    ChangeLocalAdmitted { delta: delta, candidate: _ } =>
      join(["change-local admission admitted; delta_count=", to_string(count(delta))], "")
    ChangeLocalRefused { cause: cause } =>
      match cause {
        CandidateDigestInconsistent { expected: _, observed: _ } =>
          "change-local admission refused: candidate projection digest inconsistent"
        WholeProjectionAuditRequired { detail: detail } => detail
      }
  }
}

fn receipt_authorizes_newly_public(
  receipts: List<PublicationDecisionReceipt>,
  subject: PublicProjectionSubject,
  policy_version: NonEmptyStr,
  authority: PublicationAuthorityId,
) -> Bool {
  fold(receipts, init: false, f: fn(found, receipt) {
    found || publication_decision_authorizes_newly_public(
      receipt: receipt,
      subject: subject,
      policy_version: policy_version,
      authority: authority,
    )
  })
}

fn receipt_binds_subject_content(
  receipts: List<PublicationDecisionReceipt>,
  subject: PublicProjectionSubject,
) -> Bool {
  fold(receipts, init: false, f: fn(found, receipt) {
    found || publication_decision_binds_content(
      receipt: receipt,
      subject_identity: subject.subject_identity,
      content_identity: subject.content_identity,
    )
  })
}

fn newly_public_subject_receipt_refusal(
  delta: List<ProjectionDeltaClass>,
  decisions: List<PublicationDecisionReceipt>,
  policy_version: NonEmptyStr,
  authority: PublicationAuthorityId,
  session: ModeledSessionId,
) -> PublicWriteRefusal? {
  fold(delta, init: none, f: fn(acc, item) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        match item {
          NewlyPublic { subject: subject } =>
            if receipt_authorizes_newly_public(
              receipts: decisions,
              subject: subject,
              policy_version: policy_version,
              authority: authority,
            ) {
              none
            } else if receipt_binds_subject_content(receipts: decisions, subject: subject) {
              Present {
                value: DecisionReceiptNotAuthorizing {
                  session: session,
                  subject_identity: serialize_content_hash(hash: subject.subject_identity) as String,
                  detail: "decision receipt does not authorize newly public subject",
                },
              }
            } else {
              Present {
                value: DecisionReceiptMissing {
                  session: session,
                  subject_identity: serialize_content_hash(hash: subject.subject_identity) as String,
                },
              }
            }
          _ => none
        }
    }
  })
}

fn pushed_refs_match_candidate(
  pushed_refs: List<PrePushStdinRow>,
  candidate: PublicProjectionPlan,
) -> Bool {
  if count(pushed_refs) == 0 {
    false
  } else {
    fold(pushed_refs, init: true, f: fn(ok, push) {
      ok && push.local_sha == candidate.source_revision
    })
  }
}

fn unauthorized_push_detail(
  pushed_refs: List<PrePushStdinRow>,
  candidate: PublicProjectionPlan,
) -> String {
  join([
    "public write refused: pushed ref head does not match candidate source_revision; push_count=",
    to_string(count(pushed_refs)),
    "; candidate=",
    candidate.source_revision as String,
  ], "")
}

fn admit_public_write(
  session: ModeledSessionId,
  current: PublicProjectionPlan?,
  candidate: PublicProjectionPlan,
  decisions: List<PublicationDecisionReceipt>,
  pushed_refs: List<PrePushStdinRow>,
) -> PublicWriteAdmission {
  match session_publication_posture(session: session) {
    OrdinarySession { session: ordinary } =>
      PublicWriteRefused {
        session: ordinary,
        cause: NotTheSolePublisher {
          session: ordinary,
          sole_publisher: sole_modeled_publisher_session,
        },
      }
    SoleModeledPublisher { session: publisher } =>
      let admission = admit_change_local_projection(request: ChangeLocalAdmissionRequest {
        current: current,
        candidate: candidate,
      })
      match admission {
        ChangeLocalAdmitted { delta: delta, candidate: plan } =>
          match newly_public_subject_receipt_refusal(
            delta: delta,
            decisions: decisions,
            policy_version: plan.policy_version,
            authority: sole_publication_authority_id,
            session: publisher,
          ) {
            Present { value: cause } =>
              PublicWriteRefused {
                session: publisher,
                cause: cause,
              }
            Absent =>
              if count(pushed_refs) == 0 {
                PublicWriteRefused {
                  session: publisher,
                  cause: NoPushedRefsPresented { session: publisher },
                }
              } else if pushed_refs_match_candidate(pushed_refs: pushed_refs, candidate: plan) {
                PublicWriteAdmitted {
                  authority: PublicationAuthority {
                    publisher_session: publisher,
                    authority_id: sole_publication_authority_id,
                    projection: AdmittedPublicProjection {
                      plan: plan,
                      admission: admission,
                      decisions: decisions,
                    },
                  },
                }
              } else {
                PublicWriteRefused {
                  session: publisher,
                  cause: UnauthorizedPublicPush {
                    session: publisher,
                    local_ref: fold(pushed_refs, init: "", f: fn(acc, push) {
                      if acc == "" { push.local_ref } else { acc }
                    }),
                    local_sha: fold(pushed_refs, init: "", f: fn(acc, push) {
                      if acc == "" { push.local_sha } else { acc }
                    }),
                    detail: unauthorized_push_detail(
                      pushed_refs: pushed_refs,
                      candidate: plan,
                    ),
                  },
                }
              }
          }
        ChangeLocalRefused { cause: cause } =>
          PublicWriteRefused {
            session: publisher,
            cause: ProjectionNotAdmitted {
              session: publisher,
              detail: change_local_admission_detail(outcome: admission),
            },
          }
      }
  }
}

fn public_write_admission_fold<T>(
  admission: PublicWriteAdmission,
  on_admitted: fn(PublicationAuthority) -> T,
  on_refused: fn(ModeledSessionId, PublicWriteRefusal) -> T,
) -> T {
  match admission {
    PublicWriteAdmitted { authority: authority } => on_admitted(authority)
    PublicWriteRefused { session: session, cause: cause } => on_refused(session, cause)
  }
}

fn public_write_admitted(admission: PublicWriteAdmission) -> Bool {
  public_write_admission_fold(
    admission: admission,
    on_admitted: fn(authority) { true },
    on_refused: fn(session, cause) { false },
  )
}

fn ordinary_session_lacks_public_write_authority(session: ModeledSessionId) -> Bool {
  session_publication_posture_fold(
    posture: session_publication_posture(session: session),
    on_ordinary: fn(ordinary) { true },
    on_sole_publisher: fn(publisher) { false },
  )
}
