module tools.self_host_03_normalize_declared_source_refs

import v2.compiler.source_authority { SourceRef, source_ref_for_storage_path }
import v2.std.collection { List }

// declared_source_refs for the 03_normalize behavioral witness only (review 41433 fix): this list
// opts src/v2/compiler/03_normalize.dag's witness entry into the cli_run.rs affected-set selection
// axis (docs/plans/declared-source-ref-selection-design.md §4-5, §5.1 flagship). Homed in its OWN
// module, imported only by dag/test/claim/self_host_03_normalize_behavioral_witness_test.dag — not
// by tools.self_host_module_behavioral_transport_roster, which all 16 frontier witness entries
// share. cli_run.rs's declared_source_ref scan is closure-wide (every file in a witness entry's
// transitive import closure), so a declared_source_refs list living in the shared roster would leak
// this selection axis onto all 16 entries; a dedicated per-entry module keeps the axis scoped to
// 03_normalize alone, matching the roster row's module_path/driver_rel exactly.

data sn_source_ref: SourceRef = source_ref_for_storage_path(path: "src/v2/compiler/03_normalize.dag")

data sn_shim_driver_ref: SourceRef = source_ref_for_storage_path(path: "dag/gunbc/instruments/self_host_03_normalize_shims/witness_main.rs")

// Hand-verified completeness (docs/plans/declared-source-ref-selection-design.md §5.1 flagship):
// every storage path this transport reads from the repository is listed -- the entry .dag and the
// witness driver. It used to list a shim lib and thirteen shim writes as well; those hand Rust
// copies were deleted when every row moved to whole-closure assembly
// (tools.self_host_curated_seed_linked_harness), so the receipt now builds only emitted bytes.

// KNOWN INCOMPLETE, and NOT a read-completeness bug: the emitted closure is derived from every
// .dag module 03_normalize imports (src/v2/std/*.dag among them), and none of those is listed, so a
// change to v2.std.diagnostic does not select this witness even though it can break it. The shim
// half of that gap is gone -- there is no hand mirror left to drift from its authority -- but the
// closure half remains: closing it needs a correctness-dependency axis (entry -> import closure)
// distinct from the read axis. Until then the gap is stated here rather than papered over by adding
// closure paths to a list whose contract is reads.

data declared_source_refs: List<SourceRef> = [
  sn_source_ref,
  sn_shim_driver_ref
]
