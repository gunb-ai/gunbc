module gunbc.instruments.emit_control_flow_observation

import std.types { Int, List }
import std.realization_measurement { AllocationCounter }
import std.compiler_entry { CompilerEntryDriver, NativeClaimDriver, NativeClaimReport }
import gunbc.emit_copy_qualification { StructuralInapplicability, PatternRequiresBranchShape, PatternRequiresLoopShape }
import gunbc.emit_building_block_contracts { BuildingBlockFamily, ControlFlow }
import gunbc.instruments.allocation_battery { AllocationCase, BatteryWindow, battery_report, audit_rows, refusal_not_hit_row, roster_membership_row, discrimination_row, execution_row, execution_mechanism_refuses_unproven_claims, ExecutionEvidence }
import gunbc.instruments.emit_control_flow_subjects { cf_measurement_rows }

// THE GREEN ENTRY of the control-flow family: every row here is expected to hold, so its exit code means
// something. The red controls are NOT in this entry -- they are their own target,
// #gunbc.instrument_targets::emit_control_flow_violation_label, bound by its own binding row through
// #gunbc.instrument_targets::emit_control_flow_violation_binding -- because an entry that carries rows
// designed to fail can only ever exit non-zero, and a non-zero exit that happens whether the meter works
// or is broken carries no information. The pair is the instrument: green exits 0, red exits 1, and the
// two differ in exactly the rows they name.
//
// The subject bodies, the metered windows and both judgements come from
// #gunbc.instruments.emit_control_flow_subjects::cf_measurement_rows, the one home they have; the row
// shapes, the calibration pair, the audit rows and the report grammar come from
// #gunbc.instruments.allocation_battery::battery_report, which all four families compose and which
// declares no pipeline entry so that both of this family's entries can import it.
//
// OPERATIONS AND BYTES ONLY, the limit of the meter: no traversal count, no per-phase lifetime. Where a
// contract needs a traversal count to be stated, the contract says so in the carrier and this battery
// does not pretend to read it.

data compiler_pipeline_entry: CompilerEntryDriver = NativeClaimDriver

// THE V2 OUTCOME OF THIS FAMILY, stated rather than omitted. The row asks for each specimen "under the
// seed emitter and attempted under the v2 emitter (where v2 cannot yet execute it, the exact blocker is
// named and the v2 result reads unqualified)". Nobody has asked the emitted-compiler door to emit this
// subject, so the row reads unqualified and names the refusal the door records today, both of them named
// in src/v1/stage0/src/cli_run/native_lane_runner.rs by the constants the instrument that owns that door
// holds against (#gunbc.instrument_targets::v2_native_cli_label). The claim a later gate can run by name
// is that same registered label, over this family's subject module.
fn v2_subject_claim() -> String {
  "gunbc test //gunbc/instruments:v2-native-cli over subject dag/gunbc/instruments/emit_control_flow_subjects.dag"
}

fn v2_blocker() -> String {
  "v2 door has never been asked to emit this subject; the refusals it records for a closure are translate_rejected_grounding_not_derived and for a member body translate_arrow_body_not_a_type_expression, named in src/v1/stage0/src/cli_run/native_lane_runner.rs"
}

fn native_claim_report() -> NativeClaimReport uses counter: AllocationCounter {
  let measured = cf_measurement_rows()
  let audit = audit_rows(prefix: "control_flow", family: ControlFlow)
  let refusals = [
    refusal_not_hit_row(prefix: "control_flow", name: "pattern_requires_branch_shape", refusal: PatternRequiresBranchShape),
    refusal_not_hit_row(prefix: "control_flow", name: "pattern_requires_loop_shape", refusal: PatternRequiresLoopShape)
  ]
  let qualified = [
    roster_membership_row(prefix: "control_flow", family: ControlFlow),
    discrimination_row(prefix: "control_flow", family: ControlFlow),
    execution_row(prefix: "control_flow", axis: "v2", block_id: "family", e: ExecutionEvidence { claim: v2_subject_claim(), executed: false, run_link: "", blocker: v2_blocker() }),
    execution_mechanism_refuses_unproven_claims(prefix: "control_flow")
  ]
  battery_report(concat(concat(measured, audit), concat(refusals, qualified)))
}
