module gunbc.instruments.interp_recorded_fixture_witness_transport

import gunbc.instruments.host_prelude { run_witness_bin_program, witness_bin }
import std.logic { Bool }

// THE WITNESS SPAWNS THE ONE ROUTE, SO ITS PREREQ IS THE ONE BINARY. `claim_batch` is being
// deleted by this change; the harness used to stage it because the witness drove it directly.
// The witness now asks `gunbc test` for every claim, and `gunbc` is the binary the harness
// already builds for `invoke` -- no second release binary is demanded here.
fn run_interp_recorded_fixture_witness() -> Bool {
  run_witness_bin_program(
    invoke: witness_bin(var_name: "INTERP_RECORDED_FIXTURE_WITNESS", bin_name: "interp_recorded_fixture_witness"),
    prereqs: [],
    args: []
  )
}
