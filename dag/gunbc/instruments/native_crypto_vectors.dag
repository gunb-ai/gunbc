module gunbc.instruments.native_crypto_vectors

import std.types { Int, List, String, Bool }
import std.compiler_entry { CompilerEntryDriver, NativeClaimDriver, NativeClaimReport }
import std.process { ProcessExit, ExitSuccess, ExitFailure }
import std.integer { QualifiedOctetsReady, QualifiedOctetsRefused, uint8_octets_of_ints }
import std.bignat { BigNat, bignat_zero_limbs, bignat_one, bignat_sub }
import extdeps.numeric.base16 { base16_encode_lower }
import extdeps.crypto.sha2 { sha256_hex, sha384 }
import extdeps.crypto.nist_p256 { p256_ecdsa_verify_octets, p256_gx, p256_gy, p256_n, p256_double_scalar, p256_affine }
import extdeps.crypto.nist_prime_curve { jacobian_is_infinity }
import extdeps.standards.fips_180 { Fips180DigestVector, fips180_sha256_vectors, fips180_sha384_vectors }
import extdeps.standards.rfc_6979 {
  rfc6979_a25_p256_public_key, rfc6979_a25_message_sample, rfc6979_a25_message_test,
  rfc6979_a25_p256_sha256_sample_signature, rfc6979_a25_p256_sha256_test_signature,
}
import extdeps.standards.rfc_7515 { rfc7515_a3_es256_public_key }
import extdeps.wycheproof.ecdsa_secp256r1_sha256_p1363 {
  WycheproofEcdsaCase, WycheproofValid, WycheproofInvalid,
  wycheproof_p256_sha256_p1363_group1_public_key, wycheproof_p256_sha256_p1363_group1_message,
  wycheproof_p256_sha256_p1363_group1_cases,
}

// THE NATIVE CRYPTO INSTRUMENT'S PROGRAM: the emitted .dag verifiers executed over their published
// vectors, as a NativeClaimDriver entry (std.compiler_entry). `gunbc test
// //gunbc/instruments:native-crypto-vectors` emits this closure, builds it and runs it; nothing here
// is interpreted. Every case is a published vector from its own upstream module (FIPS 180, RFC 6979,
// RFC 7515, Wycheproof) or a RED CONSTRUCTED FROM ONE, so a verifier that answered everything the
// same way fails a case whichever way it errs. The one parameter fact verification does not
// establish is here too: n*G is the point at infinity for the published base point and order, with
// (n-1)*G as its discriminating control (gunbc.auth.approval_device_redemption
// ecdsa_verification_realization_frontier names both).
//
// THE OUTPUT IS JOINED BY IDENTITY, NOT COUNTED. The first line names every case identity the program
// will report, derived from the same case list the rows are; the producer refuses a run whose rows do
// not match that roster one-for-one, so a case that crashed or was skipped is a missing row and no
// observation, never a pass. Exit 0 means every case held and 1 means at least one did not; anything
// else -- a panic, a signal, a truncated report -- is the producer's "no observation".
data compiler_pipeline_entry: CompilerEntryDriver = NativeClaimDriver

type NativeCryptoCase {
  identity: String
  held: Bool
  observed: String
}

fn ascii_octets(s: String) -> List<Int> {
  s |> chars
}

fn octets_hex(octets: List<Int>) -> String {
  match uint8_octets_of_ints(values: octets) {
    QualifiedOctetsReady { value: q } => base16_encode_lower(octets: q)
    QualifiedOctetsRefused { observed: o } => concat("octet-out-of-range:", to_string(value: o))
  }
}

fn verdict_text(v: Bool?) -> String {
  match v {
    Present { value: b } => if b { "true" } else { "false" }
    Absent => "refused"
  }
}

// ── SHA-2: each published digest, and a RED per vector -- the same message with one octet appended
// must NOT hash to the published digest, so an implementation that ignored its input would fail.
fn sha256_cases(v: Fips180DigestVector) -> List<NativeCryptoCase> {
  let got = sha256_hex(message: ascii_octets(s: v.message))
  let mutated = sha256_hex(message: ascii_octets(s: concat(v.message, "!")))
  [
    NativeCryptoCase { identity: v.case_name, held: got == v.digest_hex, observed: got },
    NativeCryptoCase { identity: concat(v.case_name, "_red_one_octet_appended"), held: mutated != v.digest_hex, observed: mutated },
  ]
}

fn sha384_cases(v: Fips180DigestVector) -> List<NativeCryptoCase> {
  let got = octets_hex(octets: sha384(message: ascii_octets(s: v.message)))
  let mutated = octets_hex(octets: sha384(message: ascii_octets(s: concat(v.message, "!"))))
  [
    NativeCryptoCase { identity: v.case_name, held: got == v.digest_hex, observed: got },
    NativeCryptoCase { identity: concat(v.case_name, "_red_one_octet_appended"), held: mutated != v.digest_hex, observed: mutated },
  ]
}

// ── P-256 ECDSA. The expected answer is this verifier's contract, not the vector file's: true for a
// valid signature, false for a well-formed one that does not verify, and a refusal (absent) for a
// key off the curve or a signature outside the encoding or the scalar range.
fn p256_case(identity: String, v: Bool?, expected: Bool?) -> NativeCryptoCase {
  NativeCryptoCase { identity: identity, held: verdict_text(v: v) == verdict_text(v: expected), observed: verdict_text(v: v) }
}

// The RFC 6979 key with the low bit of its last octet flipped: still 65 octets with the 0x04 prefix,
// and no longer a point on the curve.
fn off_curve_key(key: List<Int>) -> List<Int> {
  key |> enumerate |> map(p => if p.first == 64 { if p.second % 2 == 1 { p.second - 1 } else { p.second + 1 } } else { p.second })
}

// Wycheproof publishes valid / invalid; which kind of invalid (false versus refused) is this
// verifier's fact, stated per tcId beside the reason it takes that form.
fn verified_as(b: Bool) -> Bool? {
  Present { value: b }
}

fn refused_verdict() -> Bool? {
  Absent
}

fn wycheproof_expected(c: WycheproofEcdsaCase) -> Bool? {
  match c.result {
    WycheproofValid => verified_as(b: true)
    WycheproofInvalid => if c.tc_id == 4 { verified_as(b: false) } else { refused_verdict() }
  }
}

fn wycheproof_case(c: WycheproofEcdsaCase) -> NativeCryptoCase {
  p256_case(
    identity: concat("p256_wycheproof_tc", to_string(value: c.tc_id)),
    v: p256_ecdsa_verify_octets(key: wycheproof_p256_sha256_p1363_group1_public_key, signature: c.signature, message: wycheproof_p256_sha256_p1363_group1_message),
    expected: wycheproof_expected(c: c)
  )
}

fn p256_cases() -> List<NativeCryptoCase> {
  let key = rfc6979_a25_p256_public_key
  let sample = ascii_octets(s: rfc6979_a25_message_sample)
  let test = ascii_octets(s: rfc6979_a25_message_test)
  concat(
    [
      p256_case(identity: "p256_rfc6979_sample", v: p256_ecdsa_verify_octets(key: key, signature: rfc6979_a25_p256_sha256_sample_signature, message: sample), expected: verified_as(b: true)),
      p256_case(identity: "p256_rfc6979_test", v: p256_ecdsa_verify_octets(key: key, signature: rfc6979_a25_p256_sha256_test_signature, message: test), expected: verified_as(b: true)),
      p256_case(identity: "p256_red_signature_for_a_different_message", v: p256_ecdsa_verify_octets(key: key, signature: rfc6979_a25_p256_sha256_sample_signature, message: test), expected: verified_as(b: false)),
      p256_case(identity: "p256_red_wrong_key_rfc7515_a3", v: p256_ecdsa_verify_octets(key: rfc7515_a3_es256_public_key, signature: rfc6979_a25_p256_sha256_sample_signature, message: sample), expected: verified_as(b: false)),
      p256_case(identity: "p256_red_key_off_the_curve", v: p256_ecdsa_verify_octets(key: off_curve_key(key: key), signature: rfc6979_a25_p256_sha256_sample_signature, message: sample), expected: refused_verdict()),
    ],
    wycheproof_p256_sha256_p1363_group1_cases |> map(c => wycheproof_case(c: c))
  )
}

// ── The order of the base point: n*G is the point at infinity, and (n-1)*G is not. The control is
// what makes the first case evidence: a scalar multiplication that always answered infinity would
// pass the first and fail the second.
fn order_n_cases() -> List<NativeCryptoCase> {
  let g = p256_affine(x: p256_gx, y: p256_gy)
  let zero = bignat_zero_limbs()
  let n_inf = jacobian_is_infinity(p: p256_double_scalar(u1: p256_n, g: g, u2: zero, q: g))
  let nm1_inf = match bignat_sub(a: p256_n, b: bignat_one()) {
    Present { value: nm1 } => verified_as(b: jacobian_is_infinity(p: p256_double_scalar(u1: nm1, g: g, u2: zero, q: g)))
    Absent => refused_verdict()
  }
  [
    NativeCryptoCase { identity: "p256_the_base_point_has_order_n", held: n_inf, observed: if n_inf { "infinity" } else { "finite" } },
    NativeCryptoCase { identity: "p256_red_n_minus_one_times_g_is_finite", held: verdict_text(v: nm1_inf) == "false", observed: verdict_text(v: nm1_inf) },
  ]
}

fn native_crypto_cases() -> List<NativeCryptoCase> {
  concat(
    concat(fips180_sha256_vectors |> flat_map(v => sha256_cases(v: v)), fips180_sha384_vectors |> flat_map(v => sha384_cases(v: v))),
    concat(p256_cases(), order_n_cases())
  )
}

fn case_row(c: NativeCryptoCase) -> String {
  concat("case ", concat(c.identity, concat(if c.held { " held" } else { " not_held" }, concat(" observed=", concat(c.observed, "\n")))))
}

fn native_claim_report() -> NativeClaimReport {
  let cases = native_crypto_cases()
  let roster = concat("roster ", concat(cases |> map(c => c.identity) |> join(separator: ","), "\n"))
  let failed = cases |> filter(c => !c.held) |> map(c => c.identity)
  let exit = if (failed |> count) == 0 { ExitSuccess } else { ExitFailure { code: 1, reason: concat("not held: ", failed |> join(separator: ",")) } }
  NativeClaimReport { stdout: concat(roster, cases |> map(c => case_row(c: c)) |> join(separator: "")), exit: exit }
}
