module gunbc.instruments.native_fleet_convergence_verdict

import std.types { Bool, Int, List, String }
import std.algebra { length }
import std.compiler_entry { CompilerEntryDriver, NativeClaimDriver, NativeClaimReport, NativeClaimTerminal, NativeClaimHeld, NativeClaimNotHeld }
import gunbc.fleet.fleet_host_identity { operator_host_srv1 }
import gunbc.fleet.fleet_enrollment { EnrollmentAdmission, EnrollmentRefused, fleet_enrollments, fleet_enrollment_refusals }
import gunbc.fleet.fleet_host_backing { OwnedProvisioning, NoOutOfBand, InstalledViaVirtualMedia }
import gunbc.fleet.fleet_converge_cli { ConvergeCliReceipt }
import gunbc.fleet.fleet_receipt_collector { CollectedHostReceipt, collected_receipts_only, fleet_verdict_line }
import gunbc.fleet.fleet_convergence_verdict {
  fleet_convergence_verdict,
  FleetConvergenceVerdict,
  FleetConverged,
  FleetNotConverged,
  FleetEnrollmentRefused,
  fleet_unobserved_cell_count,
}

// THE FLEET CONVERGENCE VERDICT, EMITTED, BUILT AND RUN as a NativeClaimDriver entry
// (std.compiler_entry). `gunbc test //gunbc/instruments:native-fleet-convergence-verdict` emits this
// closure, builds it and runs it; nothing here is interpreted.
//
// WHY IT EXISTS: the closure of gunbc.fleet.fleet_convergence_verdict lies outside both closures the
// required gate compiles (gunbc.emitted_subject_build_gate emitted_subject_build_rows), so on main
// d2b027b5f412 gunbc.host.host_identity_adopt could fail to resolve -- it carried one import line,
// which turned the seed's bare channel off for every other name in it (gunbc.recurring_failure_mode
// bare_reference_channel_declines_a_pull_in_silence) -- and every required check stayed green while
// the verdict's own RED could not execute. A closure that stops resolving here makes the emit refuse,
// so the label goes red rather than the case going missing. IT IS RUN BY NAME AND BLOCKS NO LANDING:
// it is not a row of emitted_subject_build_rows, so its red is seen only by whoever runs it.
//
// THE FIRST TWO CASES SUPPLY the verdict's inputs at its interface (DESIGN section 3, a witness
// discriminates at one interface); the third is the pairing obligation's inhabitance case: the real
// enrolment producers (gunbc.fleet.fleet_enrollment fleet_enrollments, fleet_enrollment_refusals)
// reach the verdict and the route it takes is asserted, not only its answer.
data compiler_pipeline_entry: CompilerEntryDriver = NativeClaimDriver

type NativeFleetVerdictCase {
  identity: String
  held: Bool
  observed: String
}

fn supplied_refused_verdict() -> FleetConvergenceVerdict {
  fleet_convergence_verdict(enrollments: [], refusals: [supplied_refusal()], receipts: no_receipts())
}

fn supplied_admitted_verdict() -> FleetConvergenceVerdict {
  fleet_convergence_verdict(enrollments: [], refusals: [], receipts: no_receipts())
}

// The collector's own route (gunbc.fleet.fleet_receipt_collector collect_fleet_convergence_wet) with
// every host collection failed: no collected receipt reaches the fold. Importing the collector puts its
// whole import closure in this program's, so the production route's closure is what must resolve.
fn live_roster_verdict() -> FleetConvergenceVerdict {
  let none_collected: List<CollectedHostReceipt> = []
  fleet_convergence_verdict(
    enrollments: fleet_enrollments,
    refusals: fleet_enrollment_refusals,
    receipts: collected_receipts_only(collected: none_collected),
  )
}

fn no_receipts() -> List<ConvergeCliReceipt> {
  []
}

fn supplied_refusal() -> EnrollmentAdmission {
  EnrollmentRefused { host: operator_host_srv1, provisioning: OwnedProvisioning { control: NoOutOfBand, delivery: InstalledViaVirtualMedia } }
}

// RED: a refused enrolment stops the line, naming the one refusal, instead of vanishing from the verdict.
fn a_refused_enrollment_stops_the_verdict() -> Bool {
  match supplied_refused_verdict() {
    FleetEnrollmentRefused { refusals: r } => length(r) == 1
    FleetConverged { host_count: _ } => false
    FleetNotConverged { standings: _ } => false
  }
}

// CONTROL: with no refusal the same inputs read convergence, and an empty fleet is not converged.
fn without_a_refusal_the_verdict_reads_convergence() -> Bool {
  match supplied_admitted_verdict() {
    FleetEnrollmentRefused { refusals: _ } => false
    FleetConverged { host_count: _ } => false
    FleetNotConverged { standings: _ } => true
  }
}

// INHABITANCE: the live roster's admitted and refused enrolments, from their real producers, reach the
// convergence reading through the collector's receipt filter (no refusal at this revision), and with
// nothing collected the fleet is not converged and counts a positive number of unobserved cells.
fn the_live_roster_reaches_the_convergence_reading() -> Bool {
  match live_roster_verdict() {
    FleetNotConverged { standings: ss } => length(ss) > 0 && fleet_unobserved_cell_count(standings: ss) > 0
    FleetConverged { host_count: _ } => false
    FleetEnrollmentRefused { refusals: _ } => false
  }
}

fn native_fleet_verdict_cases() -> List<NativeFleetVerdictCase> {
  [
    NativeFleetVerdictCase { identity: "a_refused_enrollment_stops_the_verdict", held: a_refused_enrollment_stops_the_verdict(), observed: fleet_verdict_line(verdict: supplied_refused_verdict()) },
    NativeFleetVerdictCase { identity: "without_a_refusal_the_verdict_reads_convergence", held: without_a_refusal_the_verdict_reads_convergence(), observed: fleet_verdict_line(verdict: supplied_admitted_verdict()) },
    NativeFleetVerdictCase { identity: "the_live_roster_reaches_the_convergence_reading", held: the_live_roster_reaches_the_convergence_reading(), observed: fleet_verdict_line(verdict: live_roster_verdict()) }
  ]
}

// THE ROSTER IS DECLARED, NOT DERIVED FROM THE CASES, for the reason
// gunbc.instruments.native_crypto_vectors states: a dropped case is a missing row, not a smaller green.
data native_fleet_verdict_identities: List<String> = [
  "a_refused_enrollment_stops_the_verdict",
  "without_a_refusal_the_verdict_reads_convergence",
  "the_live_roster_reaches_the_convergence_reading"
]

fn case_row(c: NativeFleetVerdictCase) -> String {
  concat("case ", concat(c.identity, concat(if c.held { " held" } else { " not_held" }, concat(" observed=", concat(c.observed, "\n")))))
}

fn native_claim_report() -> NativeClaimReport {
  let cases = native_fleet_verdict_cases()
  let roster = concat("roster ", concat(native_fleet_verdict_identities |> join(separator: ","), "\n"))
  let failed = cases |> filter(c => !c.held) |> map(c => c.identity)
  let terminal = if (failed |> count) == 0 { held_terminal() } else { not_held_terminal(reason: concat("not held: ", failed |> join(separator: ","))) }
  NativeClaimReport { stdout: concat(roster, cases |> map(c => case_row(c: c)) |> join(separator: "")), terminal: terminal }
}

fn held_terminal() -> NativeClaimTerminal {
  NativeClaimHeld
}

fn not_held_terminal(reason: String) -> NativeClaimTerminal {
  NativeClaimNotHeld { reason: reason }
}
