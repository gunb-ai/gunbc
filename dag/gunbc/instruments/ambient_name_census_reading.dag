// HOW `gunbc test //gunbc/instruments:ambient-name-census` READS ITS RUNS. The census is native: the
// emitted v2 compiler's census walk prints one `binding` line per module-level reference occurrence,
// read off resolve's one binding record (v2.compiler.occurrence_binding_census), and one
// `binding_module` line per module that resolved, or one `binding_unreached` line per module that did
// not. This module is the host-side reader the instrument row hands its runs to, and it decides:
//
//   1. the FIXTURE ROOT (ambient_census_fixture_files): every expected row present and no unexpected
//      row -- an identity join both ways, never a count;
//   2. EXACTLY ONE SOURCE PER OCCURRENCE, on the fixture and on every subject run: a module whose walk
//      recorded one occurrence with two different bindings (binding_module's duplicate field), or a
//      declaration reference with no record, refuses, naming the module;
//   3. the UNINDEXED ROOT: a module that does not resolve must leave the run with no observation
//      (status 2), never a run that held over a module with no binding record;
//   4. THE POPULATION (tidy-ant-251's ruling on PR #14112, 2026-10-16): the whole corpus does not fit
//      a bounded runner in one census (gunbc.recurring_failure_mode
//      whole_corpus_census_exceeds_the_memory_bound), so the population is exactly the UNION of the
//      SUBJECTS' closures: the roster below, plus every module the wave at this commit rewrites against
//      ambient_census_base_ref. It is read in ONE census-scoped run over all the subjects, so a module
//      two closures share is resolved once; the run's `binding_subject` lines attribute each member to
//      the subjects whose closure reaches it, and every observed module is printed with them as
//      `module_subjects`. Every rewritten module this checkout holds that the run did not observe is
//      printed BY NAME as `unobserved_rewritten`, and makes the run exit 2: a wave whose edits the
//      census did not read is not admitted. A module outside every subject's closure is not read at
//      all, and nothing here claims it was.
//
// Exit: 0 every control held and every rewritten module was observed; 1 a control did not hold; 2 a
// rewritten module or a subject run went unobserved (or nothing at all was observed). A module inside
// a closure that resolve refused is listed as `binding_unreached` and is a fact of the reading, not a
// failure of it: its refusal is the native census's to count.
//
// THE PRIMITIVE-AUTHORITY ARM IS NOT IN THE FIXTURE, and why: that tier binds a free name to its
// std.primitives contract row, which a one-root fixture cannot declare without std. Its evidence is
// each wave's own RED and positive control (an unimported use of a moved name refuses
// resolve_reason_unbound_symbol; the imported use binds the declared home), and on the whole tree.

type AmbientCensusFixtureFile {
  path: String
  content: String
}

// The fixture modules live in a namespace gunbc.source_layout_namespaces declares (`examples`): the
// driver lists a root's modules by the declared namespaces only, so a module in an undeclared one is
// never read and the run observes nothing.
fn ambient_census_fixture_files() -> List<AmbientCensusFixtureFile> {
  [
    AmbientCensusFixtureFile {
      path: "examples/decls.dag",
      content: "module examples.decls\n\nfn helper() -> Int {\n  1\n}\n\ntype Pair {\n  a: Int\n}\n\ntype PairAlias = Pair\n"
    },
    AmbientCensusFixtureFile {
      path: "std/algebra.dag",
      content: "module std.algebra\n\ntype FreeMonoid<T>\n  = Empty\n  | Cons { head: T, tail: FreeMonoid<T> }\n"
    },
    AmbientCensusFixtureFile {
      path: "examples/partial.dag",
      content: "module examples.partial\n\nimport examples.decls { helper }\n\nfn f() -> Int {\n  helper() + not_declared_anywhere()\n}\n"
    },
    AmbientCensusFixtureFile {
      path: "examples/uses.dag",
      content: "module examples.uses\n\nimport examples.decls { helper, PairAlias }\nimport std.algebra { FreeMonoid }\n\nfn twice() -> Int {\n  helper() + helper()\n}\n\nfn yes() -> Bool {\n  true\n}\n\ndata p: PairAlias = { a: 1 }\n\ndata xs: FreeMonoid<Int> = [1]\n"
    }
  ]
}

fn ambient_census_unindexed_files() -> List<AmbientCensusFixtureFile> {
  [
    AmbientCensusFixtureFile {
      path: "examples/broken.dag",
      content: "module examples.broken\n\nfn f() -> Int {\n  not_declared_anywhere()\n}\n"
    }
  ]
}

// The rows the fixture must produce, each as its whole printed line. examples.partial is the
// partial-record RED: its resolve refuses (not_declared_anywhere is unbound), so it prints
// binding_unreached and no binding row, and the references its accepted sites answered (the codomain's
// Int, the imported helper) appear as binding_partial rows, followed by its binding_partial_module validity
// line (two rows, no conflicting record, no unreadable spelling). The headless record `{ a: 1 }` under
// `PairAlias` is the elided-head RED: its head binds by the expected type, alias-unfolded to
// examples.decls.Pair, while the annotation's own occurrence binds examples.decls.PairAlias -- two rows,
// two targets, so a wave retargeting the alias is seen at the head. The list literal `[1]` is the
// generated-reference RED: its head is the compiler's reference to std.algebra.FreeMonoid, a row of its
// own (source generated) keyed by that path, beside the annotation's authored `FreeMonoid` row. Every
// declaration's declared-order head is one binding_unanswered row with its own ordinal: examples.uses
// holds four (twice, yes, p, xs), so a per-module dedupe that counted them once fails the join.
fn ambient_census_fixture_expected() -> List<String> {
  [
    "binding\texamples.decls\tInt\t0\tambient:kernel_type_spelling\tkernel:dag_binding_type_int\t3:16",
    "binding\texamples.decls\tInt\t1\tambient:kernel_type_spelling\tkernel:dag_binding_type_int\t8:6",
    "binding\texamples.decls\tPair\t0\tdeclared\texamples.decls.Pair\t11:18",
    "binding\texamples.uses\tPairAlias\t0\tdeclared\texamples.decls.PairAlias\t14:9",
    "binding\texamples.uses\tPairAlias\t1\texpected_type\texamples.decls.Pair\t-",
    "binding\texamples.uses\tInt\t0\tambient:kernel_type_spelling\tkernel:dag_binding_type_int\t6:15",
    "binding\texamples.uses\thelper\t0\tdeclared\texamples.decls.helper\t7:3",
    "binding\texamples.uses\thelper\t1\tdeclared\texamples.decls.helper\t7:14",
    "binding\texamples.uses\tBool\t0\tambient:kernel_type_spelling\tkernel:bool_node_symbol\t10:13",
    "binding\texamples.uses\tdag_token_kw_true\t0\tambient:kernel_canonical_symbol\tkernel:dag_token_kw_true\t11:3",
    "binding\texamples.uses\tFreeMonoid\t0\tdeclared\tstd.algebra.FreeMonoid\t16:10",
    "binding\texamples.uses\tInt\t1\tambient:kernel_type_spelling\tkernel:dag_binding_type_int\t16:21",
    "binding\texamples.uses\tstd.algebra.FreeMonoid\t0\tgenerated\tstd.algebra.FreeMonoid\t-",
    "binding\tstd.algebra\tFreeMonoid\t0\tdeclared\tstd.algebra.FreeMonoid\t5:27",
    "binding_unanswered\tstd.algebra\tstd.algebra.FreeMonoid\t0\tdeclared_order",
    "binding_partial\texamples.partial\tInt\t0\tambient:kernel_type_spelling\tkernel:dag_binding_type_int\t5:11",
    "binding_partial\texamples.partial\thelper\t0\tdeclared\texamples.decls.helper\t6:3",
    "binding_partial_module\texamples.partial\t2\t0\t0",
    "binding_unanswered\texamples.decls\tstd.algebra.FreeMonoid\t0\tdeclared_order",
    "binding_unanswered\texamples.uses\tstd.algebra.FreeMonoid\t0\tdeclared_order",
    "binding_unanswered\texamples.uses\tstd.algebra.FreeMonoid\t1\tdeclared_order",
    "binding_unanswered\texamples.uses\tstd.algebra.FreeMonoid\t2\tdeclared_order",
    "binding_unanswered\texamples.uses\tstd.algebra.FreeMonoid\t3\tdeclared_order",
    "binding_unbound\texamples.partial\tnot_declared_anywhere\t6:14",
    "binding_unbound_module\texamples.partial\t1\t0"
  ]
}

