module gunbc.instruments.ambient_name_census_reading

import std.types { String, Bool, List, Int, Map }
import std.algebra { Cons, Empty, empty_map, map_insert, list_at_optional }
import std.optional { Optional, Present, Absent }
import std.process { ProcessExit, ExitSuccess, ExitFailure }
import gunbc.cli_wire { CliWireResponse, CliWirePrintable }

// HOW `gunbc test //gunbc/instruments:ambient-name-census` READS ITS RUNS. The census is native: the
// emitted v2 compiler's census walk prints one `binding` line per module-level reference occurrence,
// read off resolve's one binding record (v2.compiler.occurrence_binding_census), and one
// `binding_module` line per module that resolved, or one `binding_unreached` line per module that did
// not. This module is the host-side reader the instrument row hands its runs to, and it decides:
//
//   1. the FIXTURE ROOT (ambient_census_fixture_files): every expected row present and no unexpected
//      row -- an identity join both ways, never a count;
//   2. EXACTLY ONE SOURCE PER OCCURRENCE, on the fixture and on every subject run: a module whose walk
//      recorded one occurrence with two different bindings (binding_module's duplicate field), or a
//      declaration reference with no record, refuses, naming the module;
//   3. the UNINDEXED ROOT: a module that does not resolve must leave the run with no observation
//      (status 2), never a run that held over a module with no binding record;
//   4. THE POPULATION (tidy-ant-251's ruling on PR #14112, 2026-10-16): the whole corpus does not fit
//      a bounded runner in one census (gunbc.recurring_failure_mode
//      whole_corpus_census_exceeds_the_memory_bound), so the population is exactly the UNION of the
//      SUBJECTS' closures: the roster below, plus every module the wave at this commit rewrites against
//      ambient_census_base_ref. It is read in ONE census-scoped run over all the subjects, so a module
//      two closures share is resolved once; the run's `binding_subject` lines attribute each member to
//      the subjects whose closure reaches it, and every observed module is printed with them as
//      `module_subjects`. Every rewritten module this checkout holds that the run did not observe is
//      printed BY NAME as `unobserved_rewritten`, and makes the run exit 2: a wave whose edits the
//      census did not read is not admitted. A module outside every subject's closure is not read at
//      all, and nothing here claims it was.
//
// Exit: 0 every control held and every rewritten module was observed; 1 a control did not hold; 2 a
// rewritten module or a subject run went unobserved (or nothing at all was observed). A module inside
// a closure that resolve refused is listed as `binding_unreached` and is a fact of the reading, not a
// failure of it: its refusal is the native census's to count.
//
// THE PRIMITIVE-AUTHORITY ARM IS NOT IN THE FIXTURE, and why: that tier binds a free name to its
// std.primitives contract row, which a one-root fixture cannot declare without std. Its evidence is
// each wave's own RED and positive control (an unimported use of a moved name refuses
// resolve_reason_unbound_symbol; the imported use binds the declared home), and on the whole tree.

type AmbientCensusFixtureFile {
  path: String
  content: String
}

// The fixture modules live in a namespace gunbc.source_layout_namespaces declares (`examples`): the
// driver lists a root's modules by the declared namespaces only, so a module in an undeclared one is
// never read and the run observes nothing.
fn ambient_census_fixture_files() -> List<AmbientCensusFixtureFile> {
  [
    AmbientCensusFixtureFile {
      path: "examples/decls.dag",
      content: "module examples.decls\n\nfn helper() -> Int {\n  1\n}\n\ntype Pair {\n  a: Int\n}\n\ntype PairAlias = Pair\n"
    },
    AmbientCensusFixtureFile {
      path: "std/algebra.dag",
      content: "module std.algebra\n\ntype FreeMonoid<T>\n  = Empty\n  | Cons { head: T, tail: FreeMonoid<T> }\n"
    },
    AmbientCensusFixtureFile {
      path: "examples/partial.dag",
      content: "module examples.partial\n\nimport examples.decls { helper }\n\nfn f() -> Int {\n  helper() + not_declared_anywhere()\n}\n"
    },
    AmbientCensusFixtureFile {
      path: "examples/uses.dag",
      content: "module examples.uses\n\nimport examples.decls { helper, PairAlias }\nimport std.algebra { FreeMonoid }\n\nfn twice() -> Int {\n  helper() + helper()\n}\n\nfn yes() -> Bool {\n  true\n}\n\ndata p: PairAlias = { a: 1 }\n\ndata xs: FreeMonoid<Int> = [1]\n"
    }
  ]
}

fn ambient_census_unindexed_files() -> List<AmbientCensusFixtureFile> {
  [
    AmbientCensusFixtureFile {
      path: "examples/broken.dag",
      content: "module examples.broken\n\nfn f() -> Int {\n  not_declared_anywhere()\n}\n"
    }
  ]
}

// The rows the fixture must produce, each as its whole printed line. examples.partial is the
// partial-record RED: its resolve refuses (not_declared_anywhere is unbound), so it prints
// binding_unreached and no binding row, and the references its accepted sites answered (the codomain's
// Int, the imported helper) appear as binding_partial rows, followed by its binding_partial_module validity
// line (two rows, no conflicting record, no unreadable spelling). The headless record `{ a: 1 }` under
// `PairAlias` is the elided-head RED: its head binds by the expected type, alias-unfolded to
// examples.decls.Pair, while the annotation's own occurrence binds examples.decls.PairAlias -- two rows,
// two targets, so a wave retargeting the alias is seen at the head. The list literal `[1]` is the
// generated-reference RED: its head is the compiler's reference to std.algebra.FreeMonoid, a row of its
// own (source generated) keyed by that path, beside the annotation's authored `FreeMonoid` row. Every
// declaration's declared-order head is one binding_unanswered row with its own ordinal: examples.uses
// holds four (twice, yes, p, xs), so a per-module dedupe that counted them once fails the join.
fn ambient_census_fixture_expected() -> List<String> {
  [
    "binding\texamples.decls\tInt\t0\tambient:kernel_type_spelling\tkernel:dag_binding_type_int\t3:16",
    "binding\texamples.decls\tInt\t1\tambient:kernel_type_spelling\tkernel:dag_binding_type_int\t8:6",
    "binding\texamples.decls\tPair\t0\tdeclared\texamples.decls.Pair\t11:18",
    "binding\texamples.uses\tPairAlias\t0\tdeclared\texamples.decls.PairAlias\t14:9",
    "binding\texamples.uses\tPairAlias\t1\texpected_type\texamples.decls.Pair\t-",
    "binding\texamples.uses\tInt\t0\tambient:kernel_type_spelling\tkernel:dag_binding_type_int\t6:15",
    "binding\texamples.uses\thelper\t0\tdeclared\texamples.decls.helper\t7:3",
    "binding\texamples.uses\thelper\t1\tdeclared\texamples.decls.helper\t7:14",
    "binding\texamples.uses\tBool\t0\tambient:kernel_type_spelling\tkernel:bool_node_symbol\t10:13",
    "binding\texamples.uses\tdag_token_kw_true\t0\tambient:kernel_canonical_symbol\tkernel:dag_token_kw_true\t11:3",
    "binding\texamples.uses\tFreeMonoid\t0\tdeclared\tstd.algebra.FreeMonoid\t16:10",
    "binding\texamples.uses\tInt\t1\tambient:kernel_type_spelling\tkernel:dag_binding_type_int\t16:21",
    "binding\texamples.uses\tstd.algebra.FreeMonoid\t0\tgenerated\tstd.algebra.FreeMonoid\t-",
    "binding\tstd.algebra\tFreeMonoid\t0\tdeclared\tstd.algebra.FreeMonoid\t5:27",
    "binding_unanswered\tstd.algebra\tstd.algebra.FreeMonoid\t0\tdeclared_order",
    "binding_partial\texamples.partial\tInt\t0\tambient:kernel_type_spelling\tkernel:dag_binding_type_int\t5:11",
    "binding_partial\texamples.partial\thelper\t0\tdeclared\texamples.decls.helper\t6:3",
    "binding_partial_module\texamples.partial\t2\t0\t0",
    "binding_unanswered\texamples.decls\tstd.algebra.FreeMonoid\t0\tdeclared_order",
    "binding_unanswered\texamples.uses\tstd.algebra.FreeMonoid\t0\tdeclared_order",
    "binding_unanswered\texamples.uses\tstd.algebra.FreeMonoid\t1\tdeclared_order",
    "binding_unanswered\texamples.uses\tstd.algebra.FreeMonoid\t2\tdeclared_order",
    "binding_unanswered\texamples.uses\tstd.algebra.FreeMonoid\t3\tdeclared_order",
    "binding_unbound\texamples.partial\tnot_declared_anywhere\t6:14",
    "binding_unbound_module\texamples.partial\t1\t0"
  ]
}

// The fixture stdout as one supplied value: the witnesses hand it to the standing fold as the boundary input,
// and the one list above stays the single authority for the rows.
fn ambient_census_fixture_stdout() -> String {
  join(ambient_census_fixture_expected(), separator: "\n")
}

// THE STANDING SUBJECTS: the native test target (native-seven; gunbc.instrument_targets
// v2_native_census_scoped_subject names the same module), whose closure is the population the
// NAMESPACE-XL waves are ranked over. A further subject is a further row.
fn ambient_census_subjects() -> List<String> {
  ["v2.test.claim.parse.expression_bodied_fn_decl_parse"]
}

// THE BASE A WAVE'S REWRITTEN MODULES ARE READ AGAINST: the merge base of the run's commit and this
// ref. A policy fact, owned here; the binding diff reads its base at the same ref.
fn ambient_census_base_ref() -> String {
  "origin/main"
}

fn binding_lines(stdout: String) -> List<String> {
  split(s: stdout, delimiter: "\n") |> filter(l => starts_with(s: l, prefix: "binding\t"))
}

fn line_fields(line: String) -> List<String> {
  split(s: line, delimiter: "\t")
}

fn field_at(line: String, index: Int) -> String {
  match list_at_optional(xs: line_fields(line: line), index: index) {
    Present { value: f } => f
    Absent => ""
  }
}

fn fixture_join_failure(stdout: String) -> Optional<String> {
  let lines = split(s: stdout, delimiter: "\n") |> filter(l => starts_with(s: l, prefix: "binding\t") || starts_with(s: l, prefix: "binding_unanswered\t") || starts_with(s: l, prefix: "binding_partial\t") || starts_with(s: l, prefix: "binding_partial_module\t") || starts_with(s: l, prefix: "binding_unbound\t") || starts_with(s: l, prefix: "binding_unbound_module\t"))
  let expected = ambient_census_fixture_expected()
  let missing = expected |> filter(e => count(lines |> filter(l => l == e)) == 0)
  let unexpected = lines |> filter(l => count(expected |> filter(e => e == l)) == 0)
  match first(missing) {
    Present { value: e } => Present { value: "fixture row missing: " + e }
    Absent =>
      match first(unexpected) {
        Present { value: l } => Present { value: "fixture printed an unexpected row: " + l }
        Absent => Absent
      }
  }
}

// binding_module <module> <rows> <duplicates> <unreadable> <unrecorded>
fn module_lines(stdout: String) -> List<String> {
  split(s: stdout, delimiter: "\n") |> filter(l => starts_with(s: l, prefix: "binding_module\t"))
}

// binding_module's fields: 3 the occurrences recorded with two different bindings, 5 the declaration references the resolved
// tree carries with no record at all. Either is a breach of exactly one source per occurrence.
fn duplicate_record_failure(stdout: String) -> Optional<String> {
  match first(module_lines(stdout: stdout) |> filter(l => field_at(line: l, index: 3) != "0")) {
    Present { value: l } => Present { value: "module " + field_at(line: l, index: 1) + " recorded " + field_at(line: l, index: 3) + " occurrence(s) with two different bindings: each occurrence must carry exactly one binding source" }
    Absent =>
      match first(module_lines(stdout: stdout) |> filter(l => field_at(line: l, index: 5) != "0")) {
        Present { value: l } =>
          let m = field_at(line: l, index: 1)
          let paths = split(s: stdout, delimiter: "\n") |> filter(u => starts_with(s: u, prefix: "binding_unrecorded\t" + m + "\t")) |> map(u => field_at(line: u, index: 2))
          Present { value: "module " + m + " has " + field_at(line: l, index: 5) + " declaration reference(s) with no binding record (" + join(paths, separator: ", ") + "): each occurrence must carry exactly one binding source" }
        Absent => Absent
      }
  }
}

fn unreached_lines(stdout: String) -> List<String> {
  split(s: stdout, delimiter: "\n") |> filter(l => starts_with(s: l, prefix: "binding_unreached\t"))
}

fn unreadable_modules(stdout: String) -> List<String> {
  module_lines(stdout: stdout) |> filter(l => field_at(line: l, index: 4) != "0")
}

// THE SUMMARY: per (table, spelling), its occurrence count over the modules observed.
fn ambient_summary_lines(stdout: String) -> List<String> {
  let ambient = binding_lines(stdout: stdout) |> filter(l => starts_with(s: field_at(line: l, index: 4), prefix: "ambient:"))
  let counts = fold(ambient, init: empty_map(), f: fn(m, l) {
    let key = field_at(line: l, index: 4) + "\t" + field_at(line: l, index: 2)
    map_insert(m, key, match map_get(m, key) { Present { value: n } => n + 1  Absent => 1 })
  })
  map(map_keys(counts), k => "ambient_summary\t" + k + "\t" + to_string(match map_get(counts, k) { Present { value: n } => n  Absent => 0 }))
}

fn distinct_lines(lines: List<String>) -> List<String> {
  let seen = fold(lines, init: empty_map(), f: fn(m, l) { map_insert(m, l, true) })
  map_keys(seen)
}

// Fields of the host's per-subject line: subject, then the exit status of the run that read it (one
// union run reads every subject, so every subject carries that run's status).
fn failed_subject_runs(tree_runs: String) -> List<String> {
  split(s: tree_runs, delimiter: "\n")
    |> filter(l => l != "")
    |> filter(l => (field_at(line: l, index: 1) != "0") && (field_at(line: l, index: 1) != "covered"))
}

// The subjects whose closure reaches each module, from the run's `binding_subject\t<subject>\t<module>` lines.
fn module_subject_attribution(tree_stdout: String) -> Map<String, List<String>> {
  fold(split(s: tree_stdout, delimiter: "\n") |> filter(l => starts_with(s: l, prefix: "binding_subject\t")), init: empty_map(), f: fn(m, l) {
    let module = field_at(line: l, index: 2)
    let subject = field_at(line: l, index: 1)
    map_insert(m, module, match map_get(m, module) { Present { value: xs } => list_push(xs, subject)  Absent => [subject] })
  })
}

fn module_subjects_text(attribution: Map<String, List<String>>, module: String) -> String {
  match map_get(attribution, module) { Present { value: xs } => join(distinct_lines(lines: xs), separator: ",")  Absent => "-" }
}

fn observed_modules(tree_stdout: String) -> Map<String, Bool> {
  fold(module_lines(stdout: tree_stdout), init: empty_map(), f: fn(m, l) { map_insert(m, field_at(line: l, index: 1), true) })
}

// A rewritten module this checkout holds that no subject run observed.
fn unobserved_rewritten(rewritten: String, tree_stdout: String) -> List<String> {
  let observed = observed_modules(tree_stdout: tree_stdout)
  split(s: rewritten, delimiter: "\n")
    |> filter(l => field_at(line: l, index: 1) == "present")
    |> filter(l => match map_get(observed, field_at(line: l, index: 0)) { Present { value: _ } => false  Absent => true })
    |> map(l => field_at(line: l, index: 0))
}

// One module read twice must read the same both times: the same compiler over the same bytes. The union
// run reads each member once, so this holds by construction there; it stays because tree_stdout is the
// concatenation of whatever runs the host made, and two different binding_module lines for one module
// are an inconsistent observation whoever made them.
fn inconsistent_module_failure(tree_stdout: String) -> Optional<String> {
  let distinct = distinct_lines(lines: module_lines(stdout: tree_stdout))
  let counts = fold(distinct, init: empty_map(), f: fn(m, l) {
    let k = field_at(line: l, index: 1)
    map_insert(m, k, match map_get(m, k) { Present { value: n } => n + 1  Absent => 1 })
  })
  match first(map_keys(counts) |> filter(k => match map_get(counts, k) { Present { value: n } => n > 1  Absent => false })) {
    Present { value: k } => Present { value: "module " + k + " read differently by two subject closures" }
    Absent => Absent
  }
}

// THE OBSERVATION HALF OF THE FORMATTED OUTPUT, which the namespace-wave binding diff reads back
// (gunbc.instruments.namespace_wave_binding_diff observed_module_set): every module-level binding row AND
// every binding_module line, forwarded as printed. A module is observed only through its binding_module
// line -- an observed module can hold zero binding rows -- so dropping these lines made the real label
// compare nothing (side chat on PR #14112); they are forwarded, never reconstructed from the rows.
fn census_observation_text(tree_stdout: String) -> String {
  (distinct_lines(lines: binding_lines(stdout: tree_stdout)) |> join(separator: "\n")) + "\n"
    + (distinct_lines(lines: module_lines(stdout: tree_stdout)) |> join(separator: "\n")) + "\n"
    + (distinct_lines(lines: partial_lines(stdout: tree_stdout)) |> join(separator: "\n")) + "\n"
}

// A REFUSED MODULE'S PARTIAL ROWS AND ITS binding_partial_module VALIDITY LINE (v2.compiler.occurrence_binding_census
// occurrence_binding_partial_lines), forwarded as printed. They never count as observation of the module:
// observed_modules reads only binding_module, and the module's binding_unreached line still stands. The
// validity line travels with the rows, so a later reader sees a conflicting count (rows withheld) and an
// unreadable count beside them rather than a silently shortened row set.
fn partial_lines(stdout: String) -> List<String> {
  split(s: stdout, delimiter: "\n") |> filter(l => starts_with(s: l, prefix: "binding_partial\t") || starts_with(s: l, prefix: "binding_partial_module\t") || starts_with(s: l, prefix: "binding_unbound\t") || starts_with(s: l, prefix: "binding_unbound_module\t"))
}

// THE REWRITTEN MODULES THE HEAD RUN REACHED AND REFUSED AT RESOLVE: what the host must probe at the merge base,
// with the SAME binary, to tell a module this wave broke from one already refused before it. A module with
// no binding rows is not observed, so this is the not-observed rewritten modules the refused map names.
fn ambient_census_probe_modules(tree_stdout: String, rewritten: String) -> List<String> {
  let refused = fold(distinct_lines(lines: unreached_lines(stdout: tree_stdout)), init: empty_map(), f: fn(m, l) { map_insert(m, field_at(line: l, index: 1), field_at(line: l, index: 2)) })
  unobserved_rewritten(rewritten: rewritten, tree_stdout: tree_stdout)
    |> filter(m => match map_get(refused, m) { Present { value: _ } => true  Absent => false })
}

// A head-refused rewritten module, judged against the merge base read by the same compiler over the base tree.
// NewlyRefused: the base resolved it, or the base does not hold it at all (a module the wave added). PreviouslyRefused:
// the base refused it too, so the wave did not break it. BaseUnread: the host probed it at the base and the probe
// printed neither a binding_module nor a binding_unreached line for it -- no observation, never a guess.
type RefusedStanding = NewlyRefused | PreviouslyRefused | BaseUnread

fn refused_standing(module: String, base_probed: String, base_stdout: String) -> RefusedStanding {
  let base_observed = observed_modules(tree_stdout: base_stdout)
  let base_refused = fold(distinct_lines(lines: unreached_lines(stdout: base_stdout)), init: empty_map(), f: fn(m, l) { map_insert(m, field_at(line: l, index: 1), true) })
  let probed = split(s: base_probed, delimiter: "\n") |> filter(l => l == module)
  match map_get(base_refused, module) {
    Present { value: _ } => PreviouslyRefused
    Absent =>
      match map_get(base_observed, module) {
        Present { value: _ } => NewlyRefused
        Absent => if count(probed) == 0 { NewlyRefused } else { BaseUnread }
      }
  }
}

fn refused_standing_text(standing: RefusedStanding) -> String {
  match standing { NewlyRefused => "newly_refused"  PreviouslyRefused => "previously_refused"  BaseUnread => "base_unread" }
}

fn ambient_name_census_standing(
  fixture_stdout: String,
  fixture_status: Int,
  unindexed_status: Int,
  tree_stdout: String,
  tree_runs: String,
  rewritten: String,
  base_stdout: String,
  base_probed: String
) -> CliWireResponse {
  // EVERY module-level row is printed, not only the ambient ones: this output is also the base or head
  // half the namespace-wave binding diff reads (gunbc.instruments.namespace_wave_binding_diff), which
  // must see a declared binding change target as well as an ambient one move home.
  let tree_rows = distinct_lines(lines: binding_lines(stdout: tree_stdout))
  let observed = observed_modules(tree_stdout: tree_stdout)
  let unreached = distinct_lines(lines: unreached_lines(stdout: tree_stdout))
    |> filter(l => match map_get(observed, field_at(line: l, index: 1)) { Present { value: _ } => false  Absent => true })
  // A rewritten module the run reached but whose resolve refused has no binding rows: it was read, and
  // refused, which is not the same fact as never read. Both leave the wave's edits unjudged at
  // occurrence grain, so both answer 2; they are named apart so the cause is not misreported.
  let refused_modules = fold(distinct_lines(lines: unreached_lines(stdout: tree_stdout)), init: empty_map(), f: fn(m, l) { map_insert(m, field_at(line: l, index: 1), field_at(line: l, index: 2)) })
  let not_observed = unobserved_rewritten(rewritten: rewritten, tree_stdout: tree_stdout)
  let refused_rewritten = not_observed |> filter(m => match map_get(refused_modules, m) { Present { value: _ } => true  Absent => false })
  let missing = not_observed |> filter(m => match map_get(refused_modules, m) { Present { value: _ } => false  Absent => true })
  let newly_refused = refused_rewritten |> filter(m => match refused_standing(module: m, base_probed: base_probed, base_stdout: base_stdout) { NewlyRefused => true  _ => false })
  let base_unread = refused_rewritten |> filter(m => match refused_standing(module: m, base_probed: base_probed, base_stdout: base_stdout) { BaseUnread => true  _ => false })
  // THE CARRIED SET (gunbc.rung_drop ambient_name_census_carried_refusals): refused at the head AND at the merge base,
  // re-derived by this identity join on every run and never copied, so it can only shrink -- a module that resolves
  // at the head leaves refused_rewritten, and a module the base did not refuse is newly_refused, not carried.
  let carried = refused_rewritten |> filter(m => match refused_standing(module: m, base_probed: base_probed, base_stdout: base_stdout) { PreviouslyRefused => true  _ => false })
  let failed = failed_subject_runs(tree_runs: tree_runs)
  let attribution = module_subject_attribution(tree_stdout: tree_stdout)
  let rewritten_lines = split(s: rewritten, delimiter: "\n") |> filter(l => l != "")
    |> map(l => "rewritten\t" + l + "\t" + module_subjects_text(attribution: attribution, module: field_at(line: l, index: 0)))
  let subject_lines = map_keys(observed) |> map(m => "module_subjects\t" + m + "\t" + module_subjects_text(attribution: attribution, module: m))
  // THE ONE SET-ASIDE CATEGORY (v2.compiler.occurrence_binding_census UnrecordedSplit): declared-order
  // heads no one resolves, printed by module and path and counted, never refused and never hidden.
  let unanswered = distinct_lines(lines: split(s: tree_stdout, delimiter: "\n") |> filter(l => starts_with(s: l, prefix: "binding_unanswered\t")))
  let bytes = census_observation_text(tree_stdout: tree_stdout)
    + (subject_lines |> join(separator: "\n")) + "\n"
    + (unreached |> join(separator: "\n")) + "\n"
    + (unanswered |> join(separator: "\n")) + "\n"
    + "unanswered_declared_order_count\t" + to_string(count(unanswered)) + "\n"
    + (rewritten_lines |> join(separator: "\n")) + "\n"
    + (refused_rewritten |> map(m => "refused_rewritten\t" + m + "\t" + (match map_get(refused_modules, m) { Present { value: stage } => stage  Absent => "-" }) + "\t" + refused_standing_text(standing: refused_standing(module: m, base_probed: base_probed, base_stdout: base_stdout))) |> join(separator: "\n")) + "\n"
    + (carried |> map(m => "carried_refused\t" + m) |> join(separator: "\n")) + "\n"
    + "carried_refused_count\t" + to_string(count(carried)) + "\n"
    + (if count(newly_refused) == 0 { "ambient-name-census: a ratchet, no module newly refused against the merge base; " + to_string(count(carried)) + " carried (refused at the base too, their edits not judged)\n" } else { "ambient-name-census: a ratchet, " + to_string(count(newly_refused)) + " module(s) newly refused against the merge base; " + to_string(count(carried)) + " carried\n" })
    + (missing |> map(m => "unobserved_rewritten\t" + m) |> join(separator: "\n")) + "\n"
    + (failed |> map(l => "unobserved_subject\t" + l) |> join(separator: "\n")) + "\n"
    + (ambient_summary_lines(stdout: tree_rows |> join(separator: "\n")) |> join(separator: "\n")) + "\n"
  match fixture_join_failure(stdout: fixture_stdout) {
    Present { value: why } => CliWirePrintable { bytes: fixture_stdout + "\n", exit: ExitFailure { code: 1, reason: "fixture control: " + why } }
    Absent =>
      match duplicate_record_failure(stdout: fixture_stdout + "\n" + tree_stdout) {
        Present { value: why } => CliWirePrintable { bytes: bytes, exit: ExitFailure { code: 1, reason: "exactly-one-source control: " + why } }
        Absent =>
          match inconsistent_module_failure(tree_stdout: tree_stdout) {
            Present { value: why } => CliWirePrintable { bytes: bytes, exit: ExitFailure { code: 1, reason: "consistency control: " + why } }
            Absent =>
              if unindexed_status != 2 {
                CliWirePrintable { bytes: bytes, exit: ExitFailure { code: 1, reason: "unindexed control: a module with no reference index must leave the run with no observation (status 2), got " + to_string(unindexed_status) } }
              } else if count(module_lines(stdout: tree_stdout)) == 0 {
                CliWirePrintable { bytes: bytes, exit: ExitFailure { code: 2, reason: "no subject run observed any module; an empty census is no observation, never a held one" } }
              } else if count(newly_refused) != 0 {
                CliWirePrintable { bytes: bytes, exit: ExitFailure { code: 1, reason: to_string(count(newly_refused)) + " rewritten module(s) refused at resolve that the merge base resolved or did not hold (refused_rewritten rows marked newly_refused above): " + join(newly_refused, separator: ", ") } }
              } else if count(missing) != 0 {
                CliWirePrintable { bytes: bytes, exit: ExitFailure { code: 2, reason: to_string(count(missing)) + " rewritten module(s) no subject run observed (unobserved_rewritten rows above): the wave's edits were not read" } }
              } else if count(base_unread) != 0 {
                CliWirePrintable { bytes: bytes, exit: ExitFailure { code: 2, reason: to_string(count(base_unread)) + " refused rewritten module(s) the merge-base probe did not observe (refused_rewritten rows marked base_unread above): whether the wave broke them was not judged" } }
              } else if count(failed) != 0 {
                CliWirePrintable { bytes: bytes, exit: ExitFailure { code: 2, reason: to_string(count(failed)) + " subject run(s) did not complete (unobserved_subject rows above)" } }
              } else if count(unreadable_modules(stdout: tree_stdout)) != 0 {
                CliWirePrintable { bytes: bytes, exit: ExitFailure { code: 2, reason: "a module has a reference whose authored spelling did not read" } }
              } else {
                CliWirePrintable { bytes: bytes, exit: ExitSuccess }
              }
          }
      }
  }
}
