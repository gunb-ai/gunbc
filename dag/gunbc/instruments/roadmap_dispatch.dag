module tools.roadmap_dispatch

import std.process { ProcessExit, ExitSuccess, exit_failure }
import extdeps.filesystem.filesystem_io { Filesystem }
import gunbc.roadmap_spawner { roadmap_dispatch_file_content }

data roadmap_dispatch_output_path: String = "target/roadmap-dispatch.json"

func main() -> ProcessExit {
  let w = Filesystem.Write(path: roadmap_dispatch_output_path, content: roadmap_dispatch_file_content())
  if w.success {
    ExitSuccess
  } else {
    exit_failure(reason: concat(concat("write failed for ", roadmap_dispatch_output_path), concat(": ", w.error)))
  }
}
