module gunbc.instruments.native_serve_startup_slow_twin

import std.types { String, Int, List }
import extdeps.http.server { ServeWireResponse, ServeRequestHeader }
import gunbc.native_serve { native_serve_text_plain, NativeServeStartup, NativeServeStartupRefused }

// THE HOMONYM TWIN of gunbc.instruments.native_serve_startup_slow_fixture's handler and startup: the same bare names in
// another module of the same closure. A native ingress main that resolved its handler or its startup by bare name rather
// than by the program descriptor's qualified reference would run these, and the slow-startup reader would be red: this
// startup refuses before any bind, and this handler answers 418.
data native_serve_startup_slow_twin_marker: String = "the homonym twin is in the closure"

fn slow_startup(executable_octets: List<Int>) -> NativeServeStartup<String> {
  NativeServeStartupRefused { reason: "the homonym twin's startup ran; the main resolved the startup by bare name" }
}

fn slow_handle(path: String, request_headers: List<ServeRequestHeader>, note: String) -> ServeWireResponse {
  ServeWireResponse { status: 418, content_type_label: native_serve_text_plain, body: "the homonym twin's handler answered\n", headers: [] }
}
