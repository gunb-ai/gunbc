module gunbc.instruments.rest_pulls_wire_receipt

import extdeps.github.auth { GitHubAuthTokenObserved, GitHubAuthTokenUnavailable, github_token, github_token_absent_refusal }
import std.types { Secret, String }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import gunbc.repository { gunbc_repository }
import extdeps.github.pulls { ListStateOpen }
import extdeps.transports.rest {
  RestResult, RestAnswered, RestRefused, RestStatusRefused, RestTransportRefused, RestCredentialRefused, rest_credential_refusal_cause, RestBodyUndecodable,
}

// Wet github.Pulls.List against gunbc_repository. RestAnswered is the live green; a 200 whose body
// does not inhabit the declared List is RestBodyUndecodable. An entry point rather than a shell
// script because DESIGN rules an ad-hoc .sh in this repository unmodeled realization: a
// measurement worth re-deriving is worth an entry point. Run it as
//
//   gunbc run --source-root dag --source-root src/v2 \
//     --entry dag/gunbc/instruments/rest_pulls_wire_receipt.dag \
//     --function list_open_pulls_wire_receipt
fn list_open_pulls_wire_receipt() -> ProcessExit {
  let result = match github_token() {
      GitHubAuthTokenObserved { token } => github.Pulls.List(
        auth_token: token.token,
        owner: gunbc_repository.owner,
        repo: gunbc_repository.name,
        state: ListStateOpen,
      )
      GitHubAuthTokenUnavailable { variable } => RestRefused { refusal: github_token_absent_refusal(variable: variable) }
    }
  match result {
    RestAnswered { answer: _ } => ExitSuccess
    RestRefused { refusal } => match refusal {
      RestBodyUndecodable { status: _, cause } =>
        exit_failure(reason: cause as String)
      RestStatusRefused { status: _, body } =>
        exit_failure(reason: body)
      RestTransportRefused { cause } =>
        exit_failure(reason: cause as String)
      RestCredentialRefused { refusal: credential_refusal } => {
        let cause = rest_credential_refusal_cause(refusal: credential_refusal)
        exit_failure(reason: cause as String)
      }
    }
  }
}
