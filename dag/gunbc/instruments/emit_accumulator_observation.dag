module gunbc.instruments.emit_accumulator_observation

import std.realization_measurement { AllocationCounter }
import std.compiler_entry { CompilerEntryDriver, NativeClaimDriver, NativeClaimReport }
import gunbc.emit_building_block_contracts { BuildingBlockFamily, Accumulator }
import gunbc.instruments.allocation_battery { battery_report, audit_rows, roster_membership_row, discrimination_row, execution_row, execution_mechanism_refuses_unproven_claims, ExecutionEvidence }
import gunbc.instruments.emit_accumulator_subjects { acc_measurement_rows }

// THE GREEN ENTRY of the accumulator family: a Loop with a record accumulator, a field read, a record
// rebuild with one field changed, and a local and an escaping closure. Every row here is expected to
// hold, so its exit code means something; the red controls are their own target,
// `emit_accumulator_violation_label` in gunbc.instrument_targets, because an entry carrying rows designed to
// fail can only exit non-zero, and an exit that cannot vary measures nothing.
//
// Bodies and windows: `acc_measurement_rows` in gunbc.instruments.emit_accumulator_subjects. Row shapes,
// calibration, audit and report grammar: `battery_report` in gunbc.instruments.allocation_battery, which
// all four families compose and which declares no pipeline entry so both entries of a family can import
// it. OPERATIONS AND BYTES ONLY: the meter states no traversal count and no per-phase lifetime.

data compiler_pipeline_entry: CompilerEntryDriver = NativeClaimDriver

// THE V2 OUTCOME OF THIS FAMILY, stated rather than omitted: nobody has asked the emitted-compiler door
// to emit this subject, so the result reads unqualified and names the refusal the door records today.
fn v2_subject_claim() -> String {
  "gunbc test //gunbc/instruments:v2-native-cli over subject dag/gunbc/instruments/emit_accumulator_subjects.dag"
}

fn v2_blocker() -> String {
  "v2 door has never been asked to emit this subject; the refusals it records for a closure are translate_rejected_grounding_not_derived and for a member body translate_arrow_body_not_a_type_expression, named in src/v1/stage0/src/cli_run/native_lane_runner.rs"
}

fn native_claim_report() -> NativeClaimReport uses counter: AllocationCounter {
  let measured = acc_measurement_rows()
  let audit = audit_rows(prefix: "accumulator", family: Accumulator)
  let qualified = [
    roster_membership_row(prefix: "accumulator", family: Accumulator),
    discrimination_row(prefix: "accumulator", family: Accumulator),
    execution_row(prefix: "accumulator", axis: "v2", block_id: "family", e: ExecutionEvidence { claim: v2_subject_claim(), executed: false, run_link: "", blocker: v2_blocker() }),
    execution_mechanism_refuses_unproven_claims(prefix: "accumulator")
  ]
  battery_report(concat(measured, concat(audit, qualified)))
}
