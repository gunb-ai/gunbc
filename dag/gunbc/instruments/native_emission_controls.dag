import std.compiler_entry { CompilerEntryDriver, NativeClaimDriver, NativeClaimReport, NativeClaimTerminal, NativeClaimHeld, NativeClaimNotHeld }

// THE NATIVE EMISSION CONTROLS: one small carrier per Rust-emitter rule, EMITTED, BUILT AND RUN as a
// NativeClaimDriver entry (std.compiler_entry). `gunbc test //gunbc/instruments:native-emission-controls`
// emits this closure, builds it and runs it; nothing here is interpreted. A textual witness over the
// emitted header (test.claim.generic_item_clone_bound_witness) says what the emitter PRINTED; only
// rustc says whether what it printed is a program, and only a run says whether that program answers
// correctly. So each rule's control is a carrier whose emission did not compile before the rule and
// a set of cases over it whose answers are decided here -- a positive and a red per carrier, because
// an impl that compiled and answered `true` for everything would pass a positive alone.
//
// A CONTROL THAT STOPS COMPILING IS NO OBSERVATION FOR THE WHOLE PROGRAM, and that is the intended
// reading: every carrier in this module is one that must emit as compilable Rust, so one refusal at
// rustc is a red on the label rather than a missing row.
//
// THE ROSTER IS DECLARED, NOT DERIVED FROM THE CASES, for the reason
// gunbc.instruments.native_crypto_vectors states: the reader joins rows to this list by identity, so
// a case that was dropped is a missing row and not a smaller green.
data compiler_pipeline_entry: CompilerEntryDriver = NativeClaimDriver

// RULE: a hand-written impl header carries the item header's bounds (v1.compiler.trait_derive_emit
// v1_set_impl_type_params / v1_freemonoid_impl_type_params). ControlContext<C, P> is the shape of
// std.authorization_profile PublicationContext: P reaches a Set only through ControlAudience<P>, so
// Debug and PartialEq leave the derive list and are written by hand with `P: Ord`, while the bare
// `context: C` field earns `C: Clone` on the struct header. The hand-written headers used to print
// `impl<C: PartialEq, P: Ord + PartialEq>`, which rustc refuses at `ControlContext<C, P>` (E0277:
// `C: Clone` is not satisfied). ControlDisclosure adds the List<F> field of DisclosureRequest, whose
// `==` needs `F: Clone` for the same reason.
type ControlAudience<P>
  = ControlEveryone
  | ControlListed { members: Set<P> }

type ControlContext<C, P> {
  audience: ControlAudience<P>
  context: C
}

type ControlDisclosure<P, F, C> {
  principal: P
  fields: List<F>
  audience: ControlAudience<P>
  context: C
}

// RULE: a type declaration is indexed by the DECLARATION, not by its leaf spelling
// (v1.compiler.infer_emit_info TypeDeclIndex). ControlSlot<A, B> here and ControlSlot<T> in
// gunbc.instruments.native_emission_controls_homonym share a leaf and nothing else. Both name
// ControlBoxed, whose header is Clone-bounded, so this one owes `A: Clone, B: Clone` and that one
// owes `T: Clone`. Keyed on the leaf, the Clone-bound fixpoint held one ControlSlot row and filtered
// the other declaration's parameters against it: that header printed bare and rustc refused its
// fields (E0277), in whichever order the two were folded. ControlSlotPair names this module's
// ControlSlot through a REFERENCE, so its own bounds depend on which declaration the reference
// resolves to.
type ControlSlot<A, B> {
  first: ControlBoxed<A>
  second: ControlBoxed<B>
}

type ControlSlotPair<A, B> {
  slot: ControlSlot<A, B>
}

type NativeEmissionCase {
  identity: String
  held: Bool
}

fn control_listed(names: List<String>) -> ControlAudience<String> {
  ControlListed { members: names |> fold(init: empty_set(), f: (acc, n) => set_insert(acc, n)) }
}

fn control_context(names: List<String>, context: String) -> ControlContext<String, String> {
  ControlContext { audience: control_listed(names: names), context: context }
}

fn control_disclosure(fields: List<String>, names: List<String>) -> ControlDisclosure<String, String, String> {
  ControlDisclosure { principal: "p", fields: fields, audience: control_listed(names: names), context: "c" }
}

fn wide_slot(first: String, second: String) -> ControlSlot<String, String> {
  ControlSlot { first: ControlBoxed { value: first }, second: ControlBoxed { value: second } }
}

fn wide_slot_pair(first: String, second: String) -> ControlSlotPair<String, String> {
  ControlSlotPair { slot: wide_slot(first: first, second: second) }
}

fn same_leaf_declaration_cases() -> List<NativeEmissionCase> {
  [
    NativeEmissionCase {
      identity: "same_leaf_two_param_declaration_keeps_both_fields",
      held: wide_slot(first: "a", second: "b").first.value == "a" && wide_slot(first: "a", second: "b").second.value == "b"
    },
    NativeEmissionCase {
      identity: "same_leaf_two_param_declaration_red_second_field_differs",
      held: !(wide_slot_pair(first: "a", second: "b") == wide_slot_pair(first: "a", second: "c"))
    },
    NativeEmissionCase {
      identity: "same_leaf_one_param_declaration_round_trips",
      held: narrow_slot_value(value: "n") == "n"
    },
    NativeEmissionCase {
      identity: "same_leaf_one_param_declaration_red_value_differs",
      held: !narrow_slots_equal(left: "n", right: "m")
    }
  ]
}

// RULE: a bare name that infer bound to a LOCAL (parameter, lambda parameter, match-arm binder) never
// consults the closure-wide declaration registry (v1.compiler.emit_rust lookup_item_for_value_ref).
// control_shadowed_leaf is declared by BOTH native_emission_controls_leaf_a and _leaf_b and imported
// from neither, so a registry lookup of the leaf is ambiguous; the emitter used to print a refusal
// expression in place of the local, and rustc refused the crate (E0614). The probes are read so both
// declarers are in the closure.
fn control_shadow_match_arm(found: Bool?) -> Int {
  match found {
    Present { value: control_shadowed_leaf } =>
      match control_shadowed_leaf {
        true => 5
        false => 3
      }
    Absent => 0
  }
}

fn control_shadow_lambda(flags: List<Bool>) -> Int {
  flags |> fold(init: 0, f: (acc, control_shadowed_leaf) => match control_shadowed_leaf {
    true => acc + 2
    false => acc
  })
}

// A top-level data declaration is a reference to a declaration, not a binder: it is emitted as a call
// (`control_shadow_table()`) even beside a local binder in the same fn. Classifying it as a local
// dropped the parens and rustc refused the iteration (E0599 on a fn item).
data control_shadow_table: List<Int> = [1, 2, 3]

fn control_shadow_table_beside_binder(found: Bool?) -> Int {
  match found {
    Present { value: control_shadowed_leaf } =>
      match control_shadowed_leaf {
        true => control_shadow_table |> fold(init: 0, f: (acc, n) => acc + n)
        false => 0
      }
    Absent => 0
  }
}

// A COPRODUCT whose arm spelling collides with the local binders below (DESIGN section 6b, the
// #15565 second link). v1.compiler.emit_info derive_variant_to_enum folds every coproduct arm in the
// closure into emit_info.variant_to_enum keyed by the BARE arm leaf, whichever module declared it, so
// the collision is decided by spelling alone. The carriers bind a LOCAL `Red` (function parameter or
// `let`) of an unrelated Int type and read it as a plain value. Before the fix,
// v1.compiler.emit_rust effective_variant_parent consulted that flat map before
// asking what the occurrence is bound to, and rendered `ShadowColor::Red` where the local was meant --
// a type error in an Int position, so the emitted program does not build, let alone answer correctly.
// The binder's own spelling is what must survive.
//
// WHY THE SPELLINGS LOOK LIKE THIS. Both sides must be equal as AUTHORED text while each still emits
// to lint-clean Rust, and the casing lints that decide this are NOT in v1.compiler.emit_rust
// generated_rust_lint_relaxations, so the native route's `-D warnings` build enforces them as errors:
//   * a variant is emitted VERBATIM, so a lowercase arm is a `non_camel_case_types` error -- the arms
//     are written UpperCamel.
//   * a binder is emitted with its first letter lower-cased (verified: `fn probe(Red: Int)` renders
//     `pub fn probe(red: i64)`), so an UpperCamel binder passes `non_snake_case` while its AUTHORED
//     name -- the string effective_variant_parent looks up -- is still the arm's spelling. A lowercase
//     binder could only collide with a lowercase arm, which the line above rules out.
//   * the arms CARRY PAYLOADS. A UNIT arm also owes a phantom ZST marker in its declaring module
//     (`pub struct Red;`, v1.compiler.emit_rust rust_phantom_zst_marker_def), and a module-level unit
//     struct is a Rust VALUE item, so rustc reads a same-spelled parameter / `let` / field PATTERN as
//     that struct rather than as a fresh binder (E0308, "interpreted as a unit struct, not a new
//     binding") -- a separate hazard, recorded in the census, that would swallow this one before the
//     link under test is ever reached. A payload arm emits as an enum variant with no module-level
//     value item of the arm's name, which isolates the registry read controlled here.
//
// THE GATE NAMES TWO KINDS AND ONLY ONE HAS A BUILDABLE COLLIDING FORM. A MATCH-BOUND binder cannot carry
// an UpperCamel authored spelling: v1 reads an uppercase PATTERN atom as a VARIANT, so
// `ControlRedBox { red: Red }` is refused as "missing required field 'rank' in literal of type 'Red'"
// instead of binding a variable, and a snake_case field binder could only collide with a lowercase arm --
// which the casing rule above rules out. The MatchBoundBinding arm of the gate is therefore defensive,
// unreachable in a program the native route can build; the third row below holds the other side of the
// gate instead, that a GENUINE arm reference still elects its parent.
type ShadowColor
  = Red { rank: Int }
  | Green { rank: Int }

fn control_arm_shadow_param(Red: Int) -> Int {
  Red + 1
}

fn control_arm_shadow_let() -> Int {
  let Red = 10
  Red + Red
}

fn control_arm_rank_of(shade: ShadowColor) -> Int {
  match shade {
    Red { rank: v } => v
    Green { rank: v } => 0
  }
}

fn control_arm_genuine_reference() -> Int {
  control_arm_rank_of(shade: Red { rank: 3 })
}

fn local_binder_shadows_coproduct_arm_cases() -> List<NativeEmissionCase> {
  [
    NativeEmissionCase { identity: "local_param_shadowing_a_coproduct_arm_renders_the_local", held: control_arm_shadow_param(Red: 41) == 42 },
    NativeEmissionCase { identity: "local_let_shadowing_a_coproduct_arm_renders_the_local", held: control_arm_shadow_let() == 20 },
    NativeEmissionCase { identity: "genuine_coproduct_arm_reference_still_elects_its_parent_beside_the_local_gate", held: control_arm_genuine_reference() == 3 }
  ]
}

fn local_binder_shadow_cases() -> List<NativeEmissionCase> {
  [
    NativeEmissionCase { identity: "local_binder_shadows_ambiguous_global_leaf_match_arm", held: control_shadow_match_arm(found: Present { value: true }) == 5 },
    NativeEmissionCase { identity: "local_binder_shadows_ambiguous_global_leaf_lambda_parameter", held: control_shadow_lambda(flags: [true, false, true]) == 4 },
    NativeEmissionCase { identity: "top_level_data_reference_beside_a_local_binder_is_a_call", held: control_shadow_table_beside_binder(found: Present { value: true }) == 6 },
    NativeEmissionCase { identity: "local_binder_shadows_ambiguous_global_leaf_red_not_the_global", held: control_shadow_match_arm(found: Present { value: false }) == 3 && control_leaf_a_probe() == 101 && control_leaf_b_probe() == 201 }
  ]
}

fn header_bound_cases() -> List<NativeEmissionCase> {
  [
    NativeEmissionCase {
      identity: "set_struct_eq_same_members_in_another_order",
      held: control_context(names: ["a", "b"], context: "x") == control_context(names: ["b", "a"], context: "x")
    },
    NativeEmissionCase {
      identity: "set_struct_eq_red_bare_field_differs",
      held: !(control_context(names: ["a", "b"], context: "x") == control_context(names: ["a", "b"], context: "y"))
    },
    NativeEmissionCase {
      identity: "set_struct_eq_red_set_member_differs",
      held: !(control_context(names: ["a", "b"], context: "x") == control_context(names: ["a", "c"], context: "x"))
    },
    NativeEmissionCase {
      identity: "set_struct_eq_red_everyone_is_not_a_listing",
      held: !(ControlContext { audience: ControlEveryone, context: "x" } == control_context(names: [], context: "x"))
    },
    NativeEmissionCase {
      identity: "set_and_list_struct_eq_same_fields",
      held: control_disclosure(fields: ["f", "g"], names: ["a"]) == control_disclosure(fields: ["f", "g"], names: ["a"])
    },
    NativeEmissionCase {
      identity: "set_and_list_struct_eq_red_list_order_differs",
      held: !(control_disclosure(fields: ["f", "g"], names: ["a"]) == control_disclosure(fields: ["g", "f"], names: ["a"]))
    }
  ]
}

// RULE: a generic fn stored as a function value forwards its bounds to the enclosing fn
// (v1.compiler.emit_rust v1_fn_result_fn_value_clone_forwarded_param_names). control_keying is the
// shape of std.key_relation key_relation_global: it stores the generic control_global_scope_of into
// an arrow field, which instantiates that fn at control_keying's own S. The callee emits
// `<T: Clone>` and the wrapper emitted `<S: 'static, K: 'static>`, which rustc refuses (E0277,
// `S: Clone`). Three spellings on purpose -- the callee's generic is T, the record's slot is
// Subject, the wrapper's is S -- so a join that read the reference's own type, or the
// declaration's uninstantiated field, would find a name the wrapper does not have and bound
// nothing here.
type ControlKeying<Subject, Key> {
  scope_of: fn(Subject) -> String
  key_of: fn(Subject) -> Key
}

fn control_global_scope_of<T>(_subject: T) -> String {
  "global"
}

fn control_keying<S, K>(key_of: fn(S) -> K) -> ControlKeying<S, K> {
  ControlKeying { scope_of: control_global_scope_of, key_of: key_of }
}

// The next hop: this fn stores nothing itself, it hands its own arrow to control_keying. Once
// control_keying owes `S: Clone`, this one owes it for A -- joined through the arrow's argument
// position, because an arrow-typed parameter has no head or type argument to match on.
fn control_keying_via<A, B>(key_of: fn(A) -> B) -> ControlKeying<A, B> {
  control_keying(key_of: key_of)
}

fn control_name_length(name: String) -> Int {
  string_length(s: name)
}

fn control_keying_scope(name: String) -> String {
  let keying = control_keying(key_of: control_name_length)
  let scope_of = keying.scope_of
  scope_of(name)
}

fn control_keying_key(name: String) -> Int {
  let keying = control_keying_via(key_of: control_name_length)
  let key_of = keying.key_of
  key_of(name)
}

fn fn_value_bound_cases() -> List<NativeEmissionCase> {
  [
    NativeEmissionCase {
      identity: "fn_value_stored_generic_fn_answers",
      held: control_keying_scope(name: "abc") == "global"
    },
    NativeEmissionCase {
      identity: "fn_value_red_stored_generic_fn_is_not_another_answer",
      held: !(control_keying_scope(name: "abc") == "abc")
    },
    NativeEmissionCase {
      identity: "fn_value_passed_fn_answers_beside_it",
      held: control_keying_key(name: "abc") == 3
    },
    NativeEmissionCase {
      identity: "fn_value_red_passed_fn_reads_its_argument",
      held: !(control_keying_key(name: "abcd") == 3)
    }
  ]
}

// RULE: an expression legal in value position is projected the same way in a branch condition. A
// filter -- a call taking a lambda -- in an if-condition was refused at emission
// (FilterInBranchCondition, deleted) on an unobserved premise that the guarded branch was dropped,
// which kept gunbc.auth.approval_store_receipt off the native broker route. The four carriers are the
// pipe, the free call, a filter inside a nested if used as the condition, and that receipt parser's
// own `count(filter(lines |> skip(n: 2), ...))` under `||`; each is asked on both arms, so a dropped
// or inverted branch is a red.
fn filter_guard_pipe(xs: List<Int>) -> Int {
  if (xs |> filter(x => x > 0) |> count) > 0 { 1 } else { 0 }
}

fn filter_guard_call(xs: List<Int>) -> Int {
  if (filter(xs, x => x > 0) |> count) > 0 { 1 } else { 0 }
}

fn filter_guard_nested(xs: List<Int>) -> Int {
  if (if (xs |> filter(x => x > 0) |> count) > 0 { true } else { false }) { 1 } else { 0 }
}

fn filter_guard_receipt_shape(tag: String, lines: List<String>) -> Int {
  if tag == "" || count(filter(lines |> skip(n: 2), l => l != "")) != 0 { 0 } else { 1 }
}

fn filter_in_branch_condition_cases() -> List<NativeEmissionCase> {
  [
    NativeEmissionCase { identity: "filter_guard_pipe_then_arm", held: filter_guard_pipe(xs: [0 - 1, 0, 3]) == 1 },
    NativeEmissionCase { identity: "filter_guard_pipe_else_arm", held: filter_guard_pipe(xs: [0 - 1, 0]) == 0 },
    NativeEmissionCase { identity: "filter_guard_call_then_arm", held: filter_guard_call(xs: [5]) == 1 },
    NativeEmissionCase { identity: "filter_guard_call_else_arm", held: filter_guard_call(xs: []) == 0 },
    NativeEmissionCase { identity: "filter_guard_nested_then_arm", held: filter_guard_nested(xs: [2]) == 1 },
    NativeEmissionCase { identity: "filter_guard_nested_else_arm", held: filter_guard_nested(xs: [0]) == 0 },
    NativeEmissionCase { identity: "filter_guard_receipt_blank_tail_accepts", held: filter_guard_receipt_shape(tag: "x", lines: ["h", "", ""]) == 1 },
    NativeEmissionCase { identity: "filter_guard_receipt_red_nonblank_tail_refuses", held: filter_guard_receipt_shape(tag: "x", lines: ["h", "", "", "y"]) == 0 },
    NativeEmissionCase { identity: "filter_guard_receipt_red_empty_tag_short_circuits", held: filter_guard_receipt_shape(tag: "", lines: ["h", "", ""]) == 0 }
  ]
}

// RULE: a data row keeps its declared `?`, in its signature and in its body (v1.compiler.emit_rust
// emit_data_def's named-refinement arm; v1.compiler.emit emit_optional_data_value_json). A
// where-refinement such as NonEmptyStr took the one arm of emit_data_def with no optional wrap, so
// gunbc.fleet.fleet_tailnet fleet_tailnet_domain (`NonEmptyStr? = Present { .. }`) was emitted
// `-> NonEmptyStr`; and the JSON body spelled Present as a tagged map the native option cannot
// parse.
// Both optional rows pass through a `T?`-typed parameter, so a dropped `?` stops this closure
// compiling, and a wrong body stops it at run time; the cases decide each row answers as declared.
data control_optional_brand_present: NonEmptyStr? = Present { value: "tailnet.example" }

data control_optional_brand_absent: NonEmptyStr? = none

fn control_optional_brand_value(d: NonEmptyStr?) -> String {
  match d {
    Present { value: v } => v
    Absent => ""
  }
}

fn optional_data_row_cases() -> List<NativeEmissionCase> {
  [
    NativeEmissionCase {
      identity: "optional_data_row_present_answers_its_value",
      held: control_optional_brand_value(d: control_optional_brand_present) == "tailnet.example"
    },
    NativeEmissionCase {
      identity: "optional_data_row_red_absent_answers_absent",
      held: control_optional_brand_value(d: control_optional_brand_absent) == ""
    }
  ]
}

// RULE: a data row takes the JSON serializer only when its value is a literal tree
// (v1.compiler.emit_rust data_value_is_json_literal_tree). A `"x" as NonEmptyStr` brand cast, bare or
// inside a record literal, and an operator inside a record literal used to reach the serializer and
// emit compile_error!("unsupported mock expression"); the literal-only record stays on the JSON path.
// Each carrier is read back, and each has a red asking for a value it does not hold.
type ControlBrandRow {
  name: NonEmptyStr
  width: Int
}

data control_brand_bare: NonEmptyStr = "brand-bare" as NonEmptyStr
data control_brand_in_record: ControlBrandRow = ControlBrandRow { name: "brand-in-record" as NonEmptyStr, width: 3 }
data control_operator_in_record: ControlBrandRow = ControlBrandRow { name: "op" as NonEmptyStr, width: 1 + 2 }
data control_literal_record: ControlBrandRow = ControlBrandRow { name: "lit", width: 7 }

fn data_literal_tree_cases() -> List<NativeEmissionCase> {
  let bare = control_brand_bare as String
  let in_record = control_brand_in_record.name as String
  [
    NativeEmissionCase { identity: "data_brand_cast_bare_reads_back", held: bare == "brand-bare" },
    NativeEmissionCase { identity: "data_brand_cast_bare_red_other_text", held: !(bare == "brand") },
    NativeEmissionCase { identity: "data_brand_cast_in_record_reads_back", held: in_record == "brand-in-record" && control_brand_in_record.width == 3 },
    NativeEmissionCase { identity: "data_brand_cast_in_record_red_other_text", held: !(in_record == "brand-bare") },
    NativeEmissionCase { identity: "data_operator_in_record_evaluates", held: control_operator_in_record.width == 3 },
    NativeEmissionCase { identity: "data_operator_in_record_red_not_concatenated", held: !(control_operator_in_record.width == 12) },
    NativeEmissionCase { identity: "data_literal_record_stays_on_json", held: control_literal_record.width == 7 }
  ]
}

// RULE: an effectful function's return type is rendered against the module's type environment
// (v1.compiler.emit_rust emit_func_inferred through render_rust_fn_sig_type), the same authority a
// pure function's return uses. It rendered with an empty emit info, so a type argument was judged
// against an unobserved unit-variant index and became a compile_error! -- gunbc.durable_cas_file_store
// `-> CasOutcome<NonEmptyStr>`. control_effectful_generic_return is effectful (it reads the
// filesystem), so this closure does not compile while that rule is broken; the cases then call it
// for real on a path no host provisions, and decide the same generic carrier answers its arms.
type ControlReadBox<T>
  = ControlReadFull { v: T }
  | ControlReadEmpty

fn control_effectful_generic_return(path: String) -> ControlReadBox<NonEmptyStr> {
  let read = Filesystem.Read(path: path)
  if read.success { ControlReadFull { v: read.content as NonEmptyStr } } else { ControlReadEmpty }
}

fn control_read_box_value(b: ControlReadBox<NonEmptyStr>) -> String {
  match b {
    ControlReadFull { v: v } => v
    ControlReadEmpty => ""
  }
}

fn effectful_generic_return_cases() -> List<NativeEmissionCase> {
  [
    NativeEmissionCase {
      identity: "generic_return_full_arm_answers_its_value",
      held: control_read_box_value(b: ControlReadFull { v: "x" as NonEmptyStr }) == "x"
    },
    NativeEmissionCase {
      identity: "generic_return_red_empty_arm_answers_empty",
      held: control_read_box_value(b: ControlReadEmpty) == ""
    },
    NativeEmissionCase {
      identity: "generic_return_effectful_call_answers_empty_on_absent_path",
      held: control_read_box_value(b: control_effectful_generic_return(path: "/gunbc-native-emission-controls-absent/none")) == ""
    }
  ]
}

// RULE: a list index is realized as the optional its type says it is. v1.compiler.infer_access
// check_index_access_node types `xs[i]` as `T?`, an out-of-range index having no element, and the
// Rust list_index template (v1.compiler.languages) used to print the bare `xs[i as usize].clone()`,
// which panics out of range and is no Option to match -- rustc refused every carrier below. It is
// now `.get(i as usize).cloned()`, so the elimination the type demands is a program and an absent
// index is the Absent arm (gunbc.recurring_failure_mode
// list_index_typed_optional_but_realized_as_the_bare_element). A negative index is out of range
// on the same footing: it has no element.
fn index_reads_value(xs: List<Int>, i: Int, want: Int) -> Bool {
  match xs[i] {
    Present { value: v } => v == want
    Absent => false
  }
}

fn index_reads_absent(xs: List<Int>, i: Int) -> Bool {
  match xs[i] {
    Present { value: _ } => false
    Absent => true
  }
}

fn list_index_cases() -> List<NativeEmissionCase> {
  [
    NativeEmissionCase { identity: "list_index_in_range_yields_the_element", held: index_reads_value(xs: [10, 20, 30], i: 1, want: 20) },
    NativeEmissionCase { identity: "list_index_red_in_range_is_not_another_element", held: !index_reads_value(xs: [10, 20, 30], i: 1, want: 10) },
    NativeEmissionCase { identity: "list_index_red_in_range_is_not_absent", held: !index_reads_absent(xs: [10, 20, 30], i: 2) },
    NativeEmissionCase { identity: "list_index_past_the_end_is_absent", held: index_reads_absent(xs: [10, 20, 30], i: 3) },
    NativeEmissionCase { identity: "list_index_negative_is_absent", held: index_reads_absent(xs: [10, 20, 30], i: 0 - 1) },
    NativeEmissionCase { identity: "list_index_into_empty_is_absent", held: index_reads_absent(xs: [], i: 0) }
  ]
}

// RULE: the NativeClaimDriver binds its declared Filesystem resource (std.compiler_entry
// NativeClaimDriver; v1.compiler.emit NativeEffectRealizationAdmission under native_claim_route_denominator). Reaching Filesystem
// makes native_claim_report effectful, so this whole program runs only if the rendered main binds
// the filesystem_io handler and awaits the report: remove the binding and the main calls an async,
// handler-taking report with neither, which rustc refuses -- the red is the label's, not a row's.
// The path sits under a root no host provisions, so the case decides the same way everywhere.
fn control_absent_path_read_is_refused() -> Bool {
  let read = Filesystem.Read(path: "/gunbc-native-emission-controls-absent/none")
  !read.success && read.error != ""
}

fn claim_driver_filesystem_cases() -> List<NativeEmissionCase> {
  [
    NativeEmissionCase { identity: "claim_driver_filesystem_absent_path_read_is_refused", held: control_absent_path_read_is_refused() }
  ]
}

// RULE: an empty-map turbofish whose type argument arrives erased defers to the target's inference
// (v1.compiler.emit_rust rust_empty_map_init_expr, type_node_carries_erased_type_argument), as an
// unbound formal already does. std.list duplicated_by_key builds `DuplicatedScan { firsts:
// empty_map(), .. }` whose field is `Map<String, T>`; infer leaves that T erased, it rendered as a
// compile_error!, and std.list did not compile. The cases call the real kernel:
// each repeated key's FIRST element once, in the order the keys were found to repeat, and nothing
// for a list without repeats.
fn generic_empty_map_turbofish_cases() -> List<NativeEmissionCase> {
  [
    NativeEmissionCase {
      identity: "generic_empty_map_duplicated_by_key_reports_each_repeat_once",
      held: duplicated_by_key(xs: ["a", "b", "a", "c", "b", "a"], key: x => x) == ["a", "b"]
    },
    NativeEmissionCase {
      identity: "generic_empty_map_red_no_repeat_reports_nothing",
      held: duplicated_by_key(xs: ["a", "b", "c"], key: x => x) == []
    }
  ]
}

// RULE: an effectful fold step is realized as a loop in the enclosing async frame
// (v1.compiler.emit_rust emit_rust_effectful_fold_loop). Iterator::fold takes its step as a
// synchronous closure, so a step that reaches an effectful callee put that callee's `.await?` inside
// it: E0728, the shape of gunbc.auth.approval_decision_store pending_escalations. The step here
// reads Filesystem for every element and accumulates a record, as that fold does. Every path sits
// under a root no host provisions, so each read is a typed refusal and the counts are decided
// everywhere; the red rows are the record's two fields and the empty list.
type ControlReadTally {
  refused: Int
  seen: Int
}

fn control_tally_absent_reads(paths: List<String>) -> ControlReadTally {
  fold(paths, init: ControlReadTally { refused: 0, seen: 0 }, f: (acc, p) =>
    let read = Filesystem.Read(path: p)
    ControlReadTally { refused: if read.success { acc.refused } else { acc.refused + 1 }, seen: acc.seen + 1 }
  )
}

fn control_absent_paths() -> List<String> {
  ["/gunbc-native-emission-controls-absent/a", "/gunbc-native-emission-controls-absent/b", "/gunbc-native-emission-controls-absent/c"]
}

fn effectful_fold_step_cases() -> List<NativeEmissionCase> {
  [
    NativeEmissionCase { identity: "effectful_fold_step_counts_every_refused_read", held: control_tally_absent_reads(paths: control_absent_paths()).refused == 3 },
    NativeEmissionCase { identity: "effectful_fold_step_red_seen_counts_elements", held: control_tally_absent_reads(paths: control_absent_paths()).seen == 3 },
    NativeEmissionCase { identity: "effectful_fold_step_red_empty_keeps_init", held: control_tally_absent_reads(paths: []).seen == 0 }
  ]
}

// RULE: every std name the emitter SYNTHESIZES is spelled fully qualified (v1.compiler.emit_rust: the
// effect-wrapper return `std::result::Result<_, std::boxed::Box<dyn std::error::Error>>`), so a name this
// module imports cannot capture it. This module imports the dag `Result` (std.error_primitives), which
// the emitter writes as `pub use ...::{Result}`; its effectful functions (Filesystem.Read above) were
// emitted `-> Result<_, Box<dyn Error>>`, resolving to the imported type (E0277 on `?`, #15310 handoff host).
fn control_imported_result_answer(n: Int) -> Result<Int, Int> {
  if n > 0 { Ok { value: n } } else { Err { value: n } }
}

fn imported_result_capture_cases() -> List<NativeEmissionCase> {
  [
    NativeEmissionCase { identity: "imported_result_does_not_capture_effect_wrapper", held: control_imported_result_answer(n: 1) == Ok { value: 1 } }
  ]
}

// RULE: the seed types a nullary generic with no expected type (`init: none`) as its bare declaration,
// so a fold's accumulator payload is open and the effectful loop emits `let mut __fold_acc = None;`,
// which rustc refuses (E0282; gunbc.recurring_failure_mode seed_fold_accumulator_declared_from_an_open_init).
// The authored source supplies the type: the init is a call with a declared return type (a `let` annotation does not reach the init), as
// gunbc.durable_cas_file_store cas_observe_window does. The step reads Filesystem, as that one does.
fn control_no_read() -> String? { none }

fn control_first_present_read(paths: List<String>) -> String? {
  let observed = fold(paths, init: control_no_read(), f: (acc, p) => match acc {
    Present { value: kept } => Present { value: kept }
    Absent =>
      let read = Filesystem.Read(path: p)
      if read.success { Present { value: p } } else { none }
  })
  observed
}

fn open_init_fold_cases() -> List<NativeEmissionCase> {
  [
    NativeEmissionCase { identity: "open_init_fold_declared_result_absent_reads_answer_absent", held: control_first_present_read(paths: control_absent_paths()) == none }
  ]
}

// RULE: a type parameter carries its own cardinality (v1.compiler.emit_rust rust_carrier_optional_wrap,
// gunbc.recurring_failure_mode optional_type_parameter_emitted_without_its_cardinality). `get: K?` on a
// generic record emitted `pub get: K`, so an Absent had no representation and this carrier's
// construction with Absent did not compile -- the red is the label's. The cases read the field back
// both ways, and each has a red asking for an answer it does not give.
type ControlOptionalParam<K> {
  get: K?
  pair: K
}

fn control_optional_param_absent() -> ControlOptionalParam<Int> {
  ControlOptionalParam { get: Absent, pair: 1 }
}

fn control_optional_param_present() -> ControlOptionalParam<Int> {
  ControlOptionalParam { get: Present { value: 7 }, pair: 2 }
}

fn optional_param_is_absent(c: ControlOptionalParam<Int>) -> Bool {
  match c.get {
    Present { value: _ } => false
    Absent => true
  }
}

fn optional_param_value_or_zero(c: ControlOptionalParam<Int>) -> Int {
  match c.get {
    Present { value: v } => v
    Absent => 0
  }
}

fn optional_type_parameter_cases() -> List<NativeEmissionCase> {
  [
    NativeEmissionCase { identity: "optional_type_param_holds_absent", held: optional_param_is_absent(c: control_optional_param_absent()) },
    NativeEmissionCase { identity: "optional_type_param_red_present_is_not_absent", held: !optional_param_is_absent(c: control_optional_param_present()) },
    NativeEmissionCase { identity: "optional_type_param_holds_present_value", held: optional_param_value_or_zero(c: control_optional_param_present()) == 7 },
    NativeEmissionCase { identity: "optional_type_param_red_absent_reads_no_value", held: optional_param_value_or_zero(c: control_optional_param_absent()) == 0 }
  ]
}

// RULE: a resource capability's output renders through the signature renderer
// (v1.compiler.emit_rust emit_capability_method). Its anonymous output product used to fall through
// to the env-less render_node_type, so a zero-parameter closed alias such as std.integer UInt8 =
// Compose<UInt, MachineWidth<8>> rendered as `UInt8<UInt, MachineWidth<>>` against a Rust alias
// declared with no parameters (E0107 on std.resources Entropy read_bytes). ControlOctetSource has
// the same output shape. A trait signature is a compile-time fact, so this rule's observation is the
// build of this program itself: under the old renderer it does not compile and every row is lost.
// The cases decide octets through the same alias's constructor so the carrier is used, not only
// declared.
resource ControlOctetSource {
  kind: Observation
  mode: Read
  acquire {}
  release {}

  capability read_octets {
    input { count: Int }
    output { octets: List<UInt8> }
  }
}

fn control_octet_in_range(value: Int) -> Bool {
  match uint8_of_int(value: value) {
    UInt8Ready { value: _ } => true
    UInt8OutOfRange { observed: _ } => false
  }
}

fn capability_alias_output_cases() -> List<NativeEmissionCase> {
  [
    NativeEmissionCase { identity: "capability_alias_output_octet_in_range", held: control_octet_in_range(value: 255) },
    NativeEmissionCase { identity: "capability_alias_output_red_octet_out_of_range", held: !control_octet_in_range(value: 256) }
  ]
}

// RULE: a fold accumulator never annotates a declaration's own formals (v1.compiler.emit_rust
// type_node_has_closure_unbound_generic_atom). A fold whose init is a bare constructor carries the
// parametric DECLARATION as its accumulator type, so the closure was annotated with its formals --
// `acc: Rc<ControlOutcome<ok, err>>`, E0425 on `ok` and `err`, the shape of extdeps.dns.domain_name
// parse_dns_label_list folding from `Ok { value: .. }`. The formals are lowercase on purpose: the
// rendered-string spurious-generic check only recognised single uppercase letters.
type ControlOutcome<ok, err> = ControlGood { value: ok } | ControlBad { value: err }

fn control_sum_until_negative(xs: List<Int>) -> ControlOutcome<Int, String> {
  fold(xs, init: ControlGood { value: 0 }, f: (acc, x) => match acc {
    ControlBad { value: e } => ControlBad { value: e }
    ControlGood { value: n } => if x < 0 { ControlBad { value: "negative" } } else { ControlGood { value: n + x } }
  })
}

fn control_outcome_good_value(o: ControlOutcome<Int, String>) -> Int {
  match o {
    ControlGood { value: n } => n
    ControlBad { value: _ } => 0 - 1
  }
}

fn control_outcome_is_bad(o: ControlOutcome<Int, String>) -> Bool {
  match o {
    ControlGood { value: _ } => false
    ControlBad { value: _ } => true
  }
}

// RULE: `std.algebra` `length` over HOST text (kernel `String`) lowers to
// `v1_rt::string_length`. Corpus `v2.std.text.String` is structural FreeMonoid and keeps the
// generic body. Without the host arm, kernel `String` at `request_field` is E0308; with a
// leaf-name arm, structural text at `string_split_step` is E0308 the other way.
fn control_algebra_length_of_string(s: String) -> Int {
  length(xs: s)
}

fn algebra_length_on_string_cases() -> List<NativeEmissionCase> {
  [
    NativeEmissionCase { identity: "algebra_length_of_a_string_counts_scalars", held: control_algebra_length_of_string(s: "abc") == 3 },
    NativeEmissionCase { identity: "algebra_length_of_a_string_red_is_not_another_count", held: control_algebra_length_of_string(s: "abc") != 4 },
    NativeEmissionCase { identity: "algebra_length_of_a_list_is_unchanged", held: length(xs: ["a", "b"]) == 2 }
  ]
}

fn fold_accumulator_formals_cases() -> List<NativeEmissionCase> {
  [
    NativeEmissionCase { identity: "fold_constructor_init_sums_all_nonnegative", held: control_outcome_good_value(o: control_sum_until_negative(xs: [1, 2, 3])) == 6 },
    NativeEmissionCase { identity: "fold_constructor_init_red_negative_switches_arm", held: control_outcome_is_bad(o: control_sum_until_negative(xs: [1, 0 - 2, 3])) },
    NativeEmissionCase { identity: "fold_constructor_init_red_empty_keeps_init", held: control_outcome_good_value(o: control_sum_until_negative(xs: [])) == 0 }
  ]
}

// RULE: A DUAL-FORM FREE-MONOID ARGUMENT IS TYPED BY ITS OWN SHAPE, never by the name of the
// operation: std.algebra `ReceiverElementOrSelf`, judged in v1.compiler.infer_types `unify_template`
// by the ONE predicate the Rust realization also reads at the lowered call seam (v1.compiler
// .emit_rust `type_node_is_ordered_element_run`), which is the type-level reading of what
// v1_interpreter's `method_call.concat` arm asks of the value. THE SHAPE IS
// `gunbc.guarantee_measurement` `distinct_string_count`: a fold seeded with the empty list, so the
// accumulator is declared NOWHERE and the step body is its only evidence, whose step deduplicates by
// `append(acc, [v])` -- a whole run landing at the dual position. The algebra row claimed
// `ReceiverElement`, so inference read the appended list as ONE ELEMENT and the fold's `acc` printed
// as `Rc<Vec<Rc<Vec<String>>>>`; rustc refused the emitted module twice over at that single
// annotation, E0308 comparing a run with a `String` at `e == v` and E0308 at the `rc_list_concat` of
// `acc` with the run `[v]`. The append LOWERING was right throughout -- list ++ list, as the
// interpreter's own arm does -- which is why the fix is the claim about the argument and not the
// bridge. `control_positive_flags` is the sibling the rule must also answer rather than a second
// special case: there the accumulator's element is not the receiver's element either, and the run the
// step appends is again the only place that element type is written down.
fn control_distinct_string_count(values: List<String>) -> Int {
  count(fold(values, init: [], f: fn(acc, v) { if any(acc, e => e == v) { acc } else { append(acc, [v]) } }))
}

fn control_positive_flags(values: List<Int>) -> List<Bool> {
  fold(values, init: [], f: fn(acc, v) { append(acc, [v > 0]) })
}

fn dual_form_append_accumulator_cases() -> List<NativeEmissionCase> {
  [
    NativeEmissionCase { identity: "dual_form_append_accumulator_counts_distinct_values", held: control_distinct_string_count(values: ["a", "b", "a", "c", "b"]) == 3 },
    NativeEmissionCase { identity: "dual_form_append_accumulator_red_repeats_are_not_counted_twice", held: control_distinct_string_count(values: ["a", "b", "a", "c", "b"]) != 5 },
    NativeEmissionCase { identity: "dual_form_append_accumulator_repeats_collapse_to_one", held: control_distinct_string_count(values: ["a", "a", "a"]) == 1 },
    NativeEmissionCase { identity: "dual_form_append_accumulator_empty_input_keeps_the_empty_seed", held: control_distinct_string_count(values: []) == 0 },
    NativeEmissionCase { identity: "dual_form_append_accumulator_takes_its_element_from_the_appended_run", held: control_positive_flags(values: [1, 0 - 1, 3]) == [true, false, true] },
    NativeEmissionCase { identity: "dual_form_append_accumulator_red_is_not_the_sign_of_the_sum", held: control_positive_flags(values: [1, 0 - 1, 3]) != [true, true, true] }
  ]
}

// RULE: a variant literal of a generic owner takes the expected application of that owner
// (v1.compiler.infer variant_literal_expected_application). Seeded with a bare constructor in result
// position, the fold's accumulator used to type as the uninstantiated declaration, so the payload
// binding `items` carried the formal and `items |> list_push(x)` emitted a `.list_push(` method no
// Rust type has -- E0599, extdeps.dns.domain_name parse_dns_label_list.
fn control_collect_nonempty(xs: List<String>) -> ControlOutcome<List<String>, String> {
  fold(xs, init: ControlGood { value: [] }, f: (acc, x) => match acc {
    ControlBad { value: e } => ControlBad { value: e }
    ControlGood { value: items } => if x == "" { ControlBad { value: "empty" } } else { ControlGood { value: items |> list_push(x) } }
  })
}

fn control_collected_count(o: ControlOutcome<List<String>, String>) -> Int {
  match o {
    ControlGood { value: items } => items |> count
    ControlBad { value: _ } => 0 - 1
  }
}

// RULE: a fold seeded with a bare variant of a declaration that its result type instantiates takes the
// result type as its accumulator (v1.compiler.infer inhabited_join_types), keyed by the declaration
// the arms resolve to. Seeded with `Absent`, the accumulator used to type as the kernel Optional
// declaration with its payload arm as the argument, `Option<Present<_>>`, which is no Rust type: the
// closure stops compiling. The corpus coproduct is the same shape through `Node.declaration`.
fn control_first_over(xs: List<Int>, floor: Int) -> Int? {
  fold(xs, init: Absent, f: (st, x) => match st {
    Present { value: v } => Present { value: v }
    Absent => if x > floor { Present { value: x } } else { Absent }
  })
}

fn control_first_over_or(xs: List<Int>, floor: Int) -> Int {
  match control_first_over(xs: xs, floor: floor) {
    Present { value: v } => v
    Absent => 0 - 1
  }
}

// RULE: a List<K> payload of a generic enum is the FreeMonoid carrier whatever its spelling
// (v1.compiler.trait_derive_emit v1_type_expr_is_free_monoid_carrier). std.observation_completeness
// ObservationCompleteness<K> is this shape: derive(Debug, PartialEq) over `keys: Rc<Vec<K>>` bounds
// only `K: Debug`, while im::Vector<K> needs `K: Clone`, so the emitted crate failed rustc (E0277 at the
// variant field) for every native closure reaching std.decision. The routing read the literal spelling
// "FreeMonoid" and so never saw `List`. ControlMissing<K> keeps the payload and control_missing_keys
// filters it with a closure that takes K by value, as the real fold does.
type ControlMissing<K>
  = ControlNoneMissing
  | ControlSomeMissing { keys: List<K> }

fn control_missing_keys<K>(expected: List<K>, observed: List<K>, key_eq: fn(K, K) -> Bool) -> ControlMissing<K> {
  let missing = expected |> filter(k => !(observed |> any(o => key_eq(o, k))))
  if (missing |> count) > 0 { ControlSomeMissing { keys: missing } } else { ControlNoneMissing }
}

fn control_int_eq(a: Int, b: Int) -> Bool { a == b }

fn list_payload_enum_cases() -> List<NativeEmissionCase> {
  [
    NativeEmissionCase { identity: "list_payload_enum_all_answered_is_none_missing", held: control_missing_keys(expected: [1, 2], observed: [2, 1], key_eq: control_int_eq) == ControlNoneMissing },
    NativeEmissionCase { identity: "list_payload_enum_red_unanswered_key_is_named", held: control_missing_keys(expected: [1, 2, 3], observed: [2], key_eq: control_int_eq) == ControlSomeMissing { keys: [1, 3] } },
    NativeEmissionCase { identity: "list_payload_enum_red_unanswered_is_not_none", held: !(control_missing_keys(expected: [1], observed: [], key_eq: control_int_eq) == ControlNoneMissing) }
  ]
}

// RULE: the Set carrier is recognised by the algebra roster too (v1_type_expr_is_finite_power_set_carrier):
// a direct Set<K> payload beside a List<K> field needs the FreeMonoid impls to keep K: Ord, on the struct
// and the enum route alike. The canonical FinitePowerSet<K> spelling is exercised beside it below -- same
// carrier, same realization (04_types node_is_finite_power_set_algebra_spelling).
type ControlMixedSetEnum<K> = ControlMixedSetNone | ControlMixedSetPresent { sequence: List<K>, members: Set<K> }
type ControlMixedSetRecord<K> { sequence: List<K> members: Set<K> }

type ControlOnlySetRecord<K> { members: Set<K> }

// ONE CARRIER, ONE RUST TYPE (DESIGN section 3): `FinitePowerSet<K>` is the canonical spelling of the
// declared alias `Set<K>` (std.types `type Set<element> = FinitePowerSet<element>`), so the two spellings
// lower to the SAME Rust type -- the target's OrdSet/BTreeSet realization -- and a value built at a `Set`
// position is accepted at a `FinitePowerSet` position with no conversion. Before the renderer asked the
// algebra roster, `Set` lowered to the OrdSet while the canonical name rendered the std.algebra profile
// RECORD (its own alias in std_types.rs read `pub type Set<Element> =
// Rc<crate::std_algebra::FinitePowerSet<Element>>`), so `control_forward_power(value: members)` below was
// E0308: expected FinitePowerSet<i64>, found BTreeSet<i64>. The keyed algebra's #14880 closed that fork for
// Map/FinitelySupportedFunction; this is the element half.
// One carrier is also one BOUND SET: a canonical-spelled payload owes its element generic the container's
// own Ord + Clone (rust_btree_set_supplemental_generic_bound_rows), on the struct route, on the enum route,
// and on the fn that only forwards it. The method call is the third consumer of the decision: `members |>
// count` must reach the FinitePowerSet templates, not the profile record's `count` arrow member -- the
// callable-field tier would emit `(members.count)()` against a BTreeSet (E0609), which is what the keyed
// tier had to be disabled for at #15037.
type ControlCanonicalSetRecord<K> { members: FinitePowerSet<K> }
type ControlCanonicalSetProbePair<K> { members: FinitePowerSet<K> other: FinitePowerSet<K> }
type ControlCanonicalMixedProbe<K> { members: FinitePowerSet<K> others: Set<K> }
type ControlCanonicalSetEnum<K> = ControlCanonicalSetNone | ControlCanonicalSetPresent { members: FinitePowerSet<K>, twin: Set<K> }

fn control_forward_power<K>(value: FinitePowerSet<K>) -> FinitePowerSet<K> {
  value
}

// The alias spelled at the parameter, the carrier name at the call: the argument is only well-typed if the
// two spellings lowered to one Rust type. `count` then runs on the generic payload, so the header owes K
// the Ord + Clone the container itself requires (E0277 on a header that stayed `<K>`).
fn control_canonical_set_size<K>(members: Set<K>) -> Int {
  (control_forward_power(value: members) |> count)
}

fn canonical_set_carrier_cases() -> List<NativeEmissionCase> {
  [
    NativeEmissionCase { identity: "canonical_set_spelling_counts_a_set_built_value", held: control_canonical_set_size(members: control_int_set(xs: [1, 1, 2])) == 2 },
    NativeEmissionCase { identity: "canonical_set_spelling_red_count_is_not_the_element_count", held: control_canonical_set_size(members: control_int_set(xs: [1, 1, 2])) != 3 },
    NativeEmissionCase { identity: "canonical_set_probe_pair_equal", held: ControlCanonicalSetProbePair { members: control_int_set(xs: [1, 2]), other: control_int_set(xs: [2, 1]) } == ControlCanonicalSetProbePair { members: control_int_set(xs: [2, 1]), other: control_int_set(xs: [1, 2]) } },
    NativeEmissionCase { identity: "canonical_set_probe_mixed_equal", held: ControlCanonicalMixedProbe { members: control_int_set(xs: [1, 2]), others: control_int_set(xs: [2, 1]) } == ControlCanonicalMixedProbe { members: control_int_set(xs: [2, 1]), others: control_int_set(xs: [1, 2]) } },
    NativeEmissionCase { identity: "canonical_set_struct_equal_members_in_another_order", held: ControlCanonicalSetRecord { members: control_int_set(xs: [1, 2]) } == ControlCanonicalSetRecord { members: control_int_set(xs: [2, 1]) } },
    NativeEmissionCase { identity: "canonical_set_struct_red_member_differs", held: !(ControlCanonicalSetRecord { members: control_int_set(xs: [1, 2]) } == ControlCanonicalSetRecord { members: control_int_set(xs: [1, 3]) }) },
    NativeEmissionCase { identity: "canonical_set_forwarded_payload_equals_the_alias", held: control_forward_power(value: control_int_set(xs: [1, 2])) == control_int_set(xs: [2, 1]) },
    NativeEmissionCase { identity: "canonical_set_forwarded_payload_red_dropped_a_member", held: !(control_forward_power(value: control_int_set(xs: [1, 2])) == control_int_set(xs: [1])) },
    NativeEmissionCase { identity: "canonical_set_enum_payloads_equal_across_spellings", held: ControlCanonicalSetPresent { members: control_int_set(xs: [1, 2]), twin: control_int_set(xs: [2, 1]) } == ControlCanonicalSetPresent { members: control_int_set(xs: [2, 1]), twin: control_int_set(xs: [1, 2]) } },
    NativeEmissionCase { identity: "canonical_set_enum_red_twin_differs", held: !(ControlCanonicalSetPresent { members: control_int_set(xs: [1, 2]), twin: control_int_set(xs: [1, 2]) } == ControlCanonicalSetPresent { members: control_int_set(xs: [1, 2]), twin: control_int_set(xs: [1, 3]) }) },
    NativeEmissionCase { identity: "canonical_set_appended_as_one_element_of_a_list_of_sets", held: control_canonical_set_append_shape() == 222 },
    NativeEmissionCase { identity: "alias_set_appended_as_one_element_of_a_list_of_sets", held: control_alias_set_append_shape() == 222 },
    NativeEmissionCase { identity: "canonical_and_alias_set_append_keep_the_same_shape", held: control_canonical_set_append_shape() == control_alias_set_append_shape() },
    NativeEmissionCase { identity: "canonical_set_append_red_is_not_a_concatenation", held: control_canonical_set_append_shape() != 321 },
  ]
}

// THE APPEND SEAM, BOTH SPELLINGS (v1 node_is_set_collection, which now reads the same algebra row as
// node_is_collection). A set is an ELEMENT of a List of sets, not a run to concatenate: appending one
// set onto a list of sets must keep the outer count and both inner memberships.
// rust_append_call_is_concat_form chooses push-one-element versus concat from
// v1.compiler.emit_rust.type_is_ordered_element_run, which excludes a set collection -- so a set whose
// registered spelling the set census did not recognise was classified as an ordered element RUN, and
// the alias-spelled row held while the canonical-spelled row merged the members into the outer list.
// Both fixtures are built from control_int_set, the one set constructor this file already has, so no
// row here waits on the empty_set() seed admission that lands separately.
fn control_canon_set(xs: List<Int>) -> FinitePowerSet<Int> {
  control_forward_power(value: control_int_set(xs: xs))
}

// The shape of a list of sets as one number: outer count, then the first two inner counts. Two
// spellings of the same carrier algebra must answer the same number, and a concatenation cannot
// produce 222 from two pairs.
fn control_set_append_shape_code(sets: List<Set<Int>>) -> Int {
  (sets |> count) * 100 + (sets[0] |> count) * 10 + (sets[1] |> count)
}

fn control_canonical_set_append_shape() -> Int {
  control_set_append_shape_code(sets: append([control_canon_set(xs: [1, 2])], control_canon_set(xs: [3, 4])))
}

fn control_alias_set_append_shape() -> Int {
  control_set_append_shape_code(sets: append([control_int_set(xs: [1, 2])], control_int_set(xs: [3, 4])))
}

fn control_int_set(xs: List<Int>) -> Set<Int> {
  xs |> fold(init: empty_set(), f: (acc, n) => set_insert(acc, n))
}

fn mixed_set_carrier_cases() -> List<NativeEmissionCase> {
  [
    NativeEmissionCase { identity: "mixed_set_enum_equal_members_in_another_order", held: ControlMixedSetPresent { sequence: [1], members: control_int_set(xs: [1, 2]) } == ControlMixedSetPresent { sequence: [1], members: control_int_set(xs: [2, 1]) } },
    NativeEmissionCase { identity: "mixed_set_enum_red_member_differs", held: !(ControlMixedSetPresent { sequence: [1], members: control_int_set(xs: [1, 2]) } == ControlMixedSetPresent { sequence: [1], members: control_int_set(xs: [1, 3]) }) },
    NativeEmissionCase { identity: "mixed_set_record_equal_members_in_another_order", held: ControlMixedSetRecord { sequence: [1], members: control_int_set(xs: [1, 2]) } == ControlMixedSetRecord { sequence: [1], members: control_int_set(xs: [2, 1]) } },
    NativeEmissionCase { identity: "only_set_record_equal_members_in_another_order", held: ControlOnlySetRecord { members: control_int_set(xs: [1, 2]) } == ControlOnlySetRecord { members: control_int_set(xs: [2, 1]) } },
    NativeEmissionCase { identity: "only_set_record_red_member_differs", held: !(ControlOnlySetRecord { members: control_int_set(xs: [1, 2]) } == ControlOnlySetRecord { members: control_int_set(xs: [1, 3]) }) },
    NativeEmissionCase { identity: "mixed_set_record_red_sequence_differs", held: !(ControlMixedSetRecord { sequence: [1], members: control_int_set(xs: [1, 2]) } == ControlMixedSetRecord { sequence: [2], members: control_int_set(xs: [1, 2]) }) },
  ]
}

// RULE: a heap reference carries its OWN Clone, so it bounds nothing behind it. Rc<T> and Arc<T>
// implement Clone for every T (impl<T: ?Sized> Clone for Rc<T>, cited at
// extdeps.languages.rust.derive_contracts std_rc_clone_impl_authority), so a field written
// `routes: List<Route<H>>` -- which this emitter lowers to Rc<Vec<Rc<Route<H>>>>, the handle at both
// levels -- asks NOTHING of H, and the item naming it must be declared bare.
// v1.compiler.trait_derive_emit v1_type_expr_clone_impl_needs_param used to descend through the handle
// as if it bounded its argument, so the row was emitted with `H: Clone` in its serde bound clause and
// in its hand-written Debug and PartialEq impl headers. The shape is the one that reached main and
// reddened the fleet lane: a generic enum carrying a generic struct whose field is a List of a generic
// enum (extdeps.http.server ServedRouteTable over ServedRoute), where the emitted approval crate
// refused with five E0277 and one E0369. The spelling side of that red is pinned in
// dag/test/claim/generic_item_clone_bound_witness.dag; what these cases hold is the BEHAVIOR through
// the handle -- the carrier is compared, counted and cloned with the parameter carrying a payload --
// and the owed side below, whose compile is the guard against relaxing too far: if the repair dropped
// a demand that is owed, the emitted field `Rc<Vec<Rc<ControlOwedLeaf<H>>>>` is ill-formed at rustc
// (ControlOwedLeaf's own declaration carries P: Clone) and this instrument stops building.
type ControlHeapRoute<H>
  = ControlHeapStatic { path_label: String }
  | ControlHeapDynamic { handler: H }

type ControlHeapRow<H> { routes: List<ControlHeapRoute<H>> }

type ControlHeapCarrier<H>
  = ControlHeapFilled { table: ControlHeapRow<H> }
  | ControlHeapEmpty

// The carrier is instantiated at Int. The control fns take it at a CONCRETE element on purpose: an enum
// arm or an empty list that carries no payload leaves a free type variable at the call site (rustc
// E0283), and this corpus will not unify a generic enum's payload variable with a declared product type
// inside a list literal. The point of these cases is the emitted generic type -- the carrier, the row and
// the route are generic declarations, so their bounds are emitted and compiled exactly as in the product
// -- and the owed side below, whose field is ill-formed if the repair over-relaxes.
fn control_heap_rows_equal(row_a: ControlHeapRow<Int>, row_b: ControlHeapRow<Int>) -> Bool {
  row_a == row_b
}

fn control_heap_carrier_is_filled(carrier: ControlHeapCarrier<Int>) -> Bool {
  match carrier {
    ControlHeapFilled { table: _ } => true
    ControlHeapEmpty => false
  }
}

fn control_heap_carrier_route_count(carrier: ControlHeapCarrier<Int>) -> Int {
  match carrier {
    ControlHeapFilled { table: t } => t.routes |> count
    ControlHeapEmpty => 0
  }
}

// THE OWED SIDE OF THE SAME RULE, which the repair must NOT relax. List requires Clone of its element
// when the element itself needs it: ControlOwedLeaf<P> has a bare P field, so its own declaration
// carries P: Clone, and naming ControlOwedLeaf<H> anywhere -- inside a List or not -- requires H: Clone
// for the field to be well-formed at all. This is the Vec<DeclaredType<H>> case with a real demand: the
// demand comes from the element type's own requirement, not from naming the parameter.
type ControlOwedLeaf<P> { value: P }

type ControlOwedRow<H> { leaves: List<ControlOwedLeaf<H>> }

fn control_owed_row_leaf_count(row: ControlOwedRow<Int>) -> Int {
  row.leaves |> count
}

fn heap_reference_carrier_cases() -> List<NativeEmissionCase> {
  [
    NativeEmissionCase { identity: "heap_carrier_filled_is_filled", held: control_heap_carrier_is_filled(carrier: ControlHeapFilled { table: ControlHeapRow { routes: [ControlHeapDynamic { handler: 7 }, ControlHeapStatic { path_label: "a" }] } }) },
    NativeEmissionCase { identity: "heap_carrier_red_empty_is_not_filled", held: !control_heap_carrier_is_filled(carrier: ControlHeapEmpty) },
    NativeEmissionCase { identity: "heap_carrier_routes_count_through_the_handle", held: control_heap_carrier_route_count(carrier: ControlHeapFilled { table: ControlHeapRow { routes: [ControlHeapDynamic { handler: 7 }, ControlHeapStatic { path_label: "a" }] } }) == 2 },
    NativeEmissionCase { identity: "heap_carrier_red_empty_row_counts_zero", held: control_heap_carrier_route_count(carrier: ControlHeapEmpty) == 0 },
    NativeEmissionCase { identity: "heap_row_compares_equal_through_the_handle", held: control_heap_rows_equal(row_a: ControlHeapRow { routes: [ControlHeapDynamic { handler: 1 }, ControlHeapStatic { path_label: "a" }] }, row_b: ControlHeapRow { routes: [ControlHeapDynamic { handler: 1 }, ControlHeapStatic { path_label: "a" }] }) },
    NativeEmissionCase { identity: "heap_row_red_labels_differ", held: !control_heap_rows_equal(row_a: ControlHeapRow { routes: [ControlHeapDynamic { handler: 1 }, ControlHeapStatic { path_label: "a" }] }, row_b: ControlHeapRow { routes: [ControlHeapDynamic { handler: 2 }, ControlHeapStatic { path_label: "a" }] }) },
    NativeEmissionCase { identity: "owed_leaf_element_still_owes_the_parameter", held: control_owed_row_leaf_count(row: ControlOwedRow { leaves: [ControlOwedLeaf { value: 1 }, ControlOwedLeaf { value: 2 }] }) == 2 },
    NativeEmissionCase { identity: "owed_leaf_red_empty_list_counts_zero", held: control_owed_row_leaf_count(row: ControlOwedRow { leaves: [] }) == 0 }
  ]
}

fn bare_variant_fold_init_cases() -> List<NativeEmissionCase> {
  [
    NativeEmissionCase { identity: "bare_init_fold_keeps_the_first_match", held: control_first_over_or(xs: [1, 5, 9], floor: 2) == 5 },
    NativeEmissionCase { identity: "bare_init_fold_red_is_not_the_last_match", held: control_first_over_or(xs: [1, 5, 9], floor: 2) != 9 },
    NativeEmissionCase { identity: "bare_init_fold_without_a_match_stays_absent", held: control_first_over_or(xs: [1, 2], floor: 2) == 0 - 1 }
  ]
}

fn variant_literal_application_cases() -> List<NativeEmissionCase> {
  [
    NativeEmissionCase { identity: "variant_literal_application_collects_every_element", held: control_collected_count(o: control_collect_nonempty(xs: ["a", "b", "c"])) == 3 },
    NativeEmissionCase { identity: "variant_literal_application_red_empty_element_refuses", held: control_collected_count(o: control_collect_nonempty(xs: ["a", "", "c"])) == 0 - 1 },
    NativeEmissionCase { identity: "variant_literal_application_red_empty_list_keeps_init", held: control_collected_count(o: control_collect_nonempty(xs: [])) == 0 }
  ]
}

// RULE: every match whose Rc scrutinee is dereferenced and cloned owes Clone on the generics it
// carries, wherever the match sits (v1.compiler.emit_rust v1_fn_body_rc_match_clone_bound_param_names).
// control_first_refusal has the shape of gunbc.product.data_class admit_data_effect: one generic
// (B) earns Clone elsewhere because the seed stores it by value, the other (A) is carried only in a
// phantom position (ControlTag<A>, as Sink<C>), and the step matches on the accumulator, a generic
// coproduct it clones out of its Rc. Read only at the fn body's top level, the bound was
// missed and the header stayed `<A, B: Clone>`: E0599, `clone` exists for ControlAdmission<A, B> but its
// trait bounds were not satisfied.
type ControlTag<A> {
  name: String
}

type ControlAdmission<A, B> = ControlAdmitted { tag: ControlTag<A>, value: B } | ControlRefused { cause: String }

fn control_admitted_seed<A, B>(tag: ControlTag<A>, value: B) -> ControlAdmission<A, B> {
  ControlAdmitted { tag: tag, value: value }
}

fn control_first_refusal<A, B>(tag: ControlTag<A>, value: B, causes: List<String>) -> ControlAdmission<A, B> {
  fold(causes, init: control_admitted_seed(tag: tag, value: value), f: (acc, c) => match acc {
    ControlAdmitted { tag: _, value: _ } => ControlRefused { cause: c }
    ControlRefused { cause: _ } => acc
  })
}

fn control_admitted_value(a: ControlAdmission<Int, Int>) -> Int {
  match a {
    ControlAdmitted { tag: _, value: v } => v
    ControlRefused { cause: _ } => 0 - 1
  }
}

fn control_refusal_cause(a: ControlAdmission<Int, Int>) -> String {
  match a {
    ControlAdmitted { tag: _, value: _ } => ""
    ControlRefused { cause: c } => c
  }
}

fn rc_match_clone_cases() -> List<NativeEmissionCase> {
  [
    NativeEmissionCase { identity: "rc_match_clone_no_refusal_keeps_the_seed", held: control_admitted_value(a: control_first_refusal(tag: ControlTag { name: "t" }, value: 7, causes: [])) == 7 },
    NativeEmissionCase { identity: "rc_match_clone_red_first_refusal_wins", held: control_refusal_cause(a: control_first_refusal(tag: ControlTag { name: "t" }, value: 7, causes: ["a", "b"])) == "a" },
    NativeEmissionCase { identity: "rc_match_clone_red_refused_is_not_admitted", held: control_admitted_value(a: control_first_refusal(tag: ControlTag { name: "t" }, value: 7, causes: ["x"])) == 0 - 1 }
  ]
}

// Reduced candidate for #15571's self-host failure at 383c6aa (CI 41268951168).
// The local enum arm is NOT either imported module's type alias. Both providers
// stay in the closure through real calls. Main is expected to refuse in the
// trait-bound signature walk; this reduced expectation has not yet executed.
// CONTROL: rename only the two foreign Shared aliases, retaining this enum,
// these calls, and every expected result. Run that mutation in a separate tree:
// putting both alias populations in one emitted closure would contaminate it.
type EnumMemberIdentity = Shared | Other

fn enum_member_identity_value(value: EnumMemberIdentity) -> Int {
  match value {
    Shared => enum_identity_foreign_a()
    Other => enum_identity_foreign_b()
  }
}

fn enum_member_identity_cases() -> List<NativeEmissionCase> {
  [
    NativeEmissionCase { identity: "enum_member_identity_shared_uses_its_local_arm", held: enum_member_identity_value(value: Shared) == 17 },
    NativeEmissionCase { identity: "enum_member_identity_other_uses_its_local_arm", held: enum_member_identity_value(value: Other) == 29 },
    NativeEmissionCase { identity: "enum_member_identity_shared_is_not_the_other_arm", held: enum_member_identity_value(value: Shared) != 29 }
  ]
}

