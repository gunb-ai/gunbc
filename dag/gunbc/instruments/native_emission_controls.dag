// RULE: a match whose only coverage of an outer variant is nested two levels deep is emitted
// exhaustively, not with every arm guarded (gunbc.recurring_failure_mode
// an_exhaustive_nested_variant_match_is_emitted_with_every_arm_guarded). The shape is
// v2.compiler.resolve type_parameter_binding_value_reading before it was split: Accepted over
// BoundInFrame over a kind variant, beside its enumerated sibling kinds, a unit variant and a Rejected arm.
// Guarded arms are invisible to rustc's exhaustiveness check, so the match used to refuse E0004 and
// this program did not compile -- the red is the label's.
type ControlFrameKind
  = ControlTypeFrame { width: Int }
  | ControlLexicalFrame { width: Int }
  | ControlParameterFrame { width: Int }

type ControlScopeBinding
  = ControlInFrame { canonical: String, kind: ControlFrameKind }
  | ControlAtRoot { canonical: String }
  | ControlScopeUnbound

type ControlLookup
  = ControlFound { value: ControlScopeBinding }
  | ControlMissing { reason: String }

fn control_nested_reading(l: ControlLookup) -> Int {
  match l {
    ControlFound { value: ControlInFrame { canonical: _, kind: ControlTypeFrame { width: w } } } => w
    ControlFound { value: ControlInFrame { canonical: _, kind: ControlLexicalFrame { width: _ } } } => 0 - 1
    ControlFound { value: ControlInFrame { canonical: _, kind: ControlParameterFrame { width: _ } } } => 0 - 5
    ControlFound { value: ControlAtRoot { canonical: _ } } => 0 - 2
    ControlFound { value: ControlScopeUnbound } => 0 - 3
    ControlMissing { reason: _ } => 0 - 4
  }
}

fn nested_variant_match_cases() -> List<NativeEmissionCase> {
  [
    NativeEmissionCase { identity: "nested_variant_match_reads_the_innermost_payload", held: control_nested_reading(l: ControlFound { value: ControlInFrame { canonical: "a", kind: ControlTypeFrame { width: 7 } } }) == 7 },
    NativeEmissionCase { identity: "nested_variant_match_red_other_kinds_are_not_the_payload", held: control_nested_reading(l: ControlFound { value: ControlInFrame { canonical: "a", kind: ControlLexicalFrame { width: 7 } } }) == 0 - 1 && control_nested_reading(l: ControlFound { value: ControlInFrame { canonical: "a", kind: ControlParameterFrame { width: 7 } } }) == 0 - 5 },
    NativeEmissionCase { identity: "nested_variant_match_red_sibling_variant_selects_its_own_arm", held: control_nested_reading(l: ControlFound { value: ControlAtRoot { canonical: "a" } }) == 0 - 2 && control_nested_reading(l: ControlFound { value: ControlScopeUnbound }) == 0 - 3 },
    NativeEmissionCase { identity: "nested_variant_match_red_outer_rejection_selects_its_own_arm", held: control_nested_reading(l: ControlMissing { reason: "r" }) == 0 - 4 }
  ]
}

// RULE: an untyped empty-map fold seed is emitted with its inferred application, never the bare head
// of an alias (gunbc.recurring_failure_mode an_untyped_empty_map_fold_seed_is_emitted_with_a_bare_alias_head).
// GUARD, not a proven discriminator: the RFM row records E0107 from pre-merge #14084 heads; these programs emit
// and compile on main and were not run against those heads, so whether they red when the defect returns is unmeasured.
// The map's value type is an alias of a generic (QualifiedName = FreeMonoid<Symbol>) and the seed carries no annotation.
// control_word_index_typed is the typed-let form of the same fold.
fn control_word_index(names: List<Symbol>) -> Map<Symbol, QualifiedName> {
  let p = qualified_name_from_dotted_string(dotted: "a.b")
  fold(names, init: empty_map(), f: fn(acc, name) {
    map_insert(acc, name, qualified_name_snoc(qn: p, segment: name))
  })
}

fn control_word_index_typed(names: List<Symbol>) -> Map<Symbol, QualifiedName> {
  let p = qualified_name_from_dotted_string(dotted: "a.b")
  let seed: Map<Symbol, QualifiedName> = empty_map()
  fold(names, init: seed, f: fn(acc, name) {
    map_insert(acc, name, qualified_name_snoc(qn: p, segment: name))
  })
}

fn control_word_index_cross_module(names: List<String>) -> Map<String, ControlWords> {
  fold(names, init: empty_map(), f: fn(acc, name) {
    map_insert(acc, name, control_words_of(name: name))
  })
}

type ControlDeclaring = ControlDeclaringAt { path: QualifiedName } | ControlDeclaringNothing

// The shape resolve.dag type_param_value_binders had: the untyped seed sits in a match arm over a payload-bound
// alias value, beside arms that return a bare empty_map().
fn control_declared_index(declaring: ControlDeclaring, names: List<Symbol>) -> Map<Symbol, QualifiedName> {
  match declaring {
    ControlDeclaringAt { path: path } =>
      fold(names, init: empty_map(), f: fn(acc, name) {
        map_insert(acc, name, qualified_name_snoc(qn: path, segment: name))
      })
    ControlDeclaringNothing => empty_map()
  }
}

fn alias_empty_map_seed_cases() -> List<NativeEmissionCase> {
  [
    NativeEmissionCase { identity: "alias_empty_map_seed_in_match_arm_indexes_each_name", held: map_keys(control_declared_index(declaring: ControlDeclaringAt { path: qualified_name_from_dotted_string(dotted: "a.b") }, names: [symbol_intern_lexeme(lexeme: "a"), symbol_intern_lexeme(lexeme: "b")])) |> count == 2 },
    NativeEmissionCase { identity: "alias_empty_map_seed_in_match_arm_nothing_is_empty", held: map_keys(control_declared_index(declaring: ControlDeclaringNothing, names: [symbol_intern_lexeme(lexeme: "a")])) |> count == 0 },
    NativeEmissionCase { identity: "alias_empty_map_seed_cross_module_indexes_each_name", held: map_keys(control_word_index_cross_module(names: ["a", "b"])) |> count == 2 },
    NativeEmissionCase { identity: "alias_empty_map_seed_indexes_each_name", held: map_keys(control_word_index(names: [symbol_intern_lexeme(lexeme: "a"), symbol_intern_lexeme(lexeme: "b")])) |> count == 2 },
    NativeEmissionCase { identity: "alias_empty_map_seed_empty_input_yields_empty_map", held: map_keys(control_word_index(names: [])) |> count == 0 },
    NativeEmissionCase { identity: "alias_empty_map_seed_typed_control_agrees", held: map_keys(control_word_index_typed(names: [symbol_intern_lexeme(lexeme: "a"), symbol_intern_lexeme(lexeme: "b")])) |> count == 2 }
  ]
}

// RULE: a grounded natural cast onto the kernel Int is realized from the grounding rows' declarations,
// never from rendered names (v1.compiler.emit cast_source_grounded_onto_target_carrier). std.nat Nat
// renders in Rust as its alias `Nat` and the kernel Int as `i64`; both are the kernel integer. Compared as rendered names the inclusion read as an
// unsupported cast and was emitted as a runtime panic, so extdeps.units.iso8601_calendar -- whose
// constants are Nat and whose arithmetic is Int -- aborted on its first call. The red is the next
// second: an inclusion that changed a value, or a calendar that ignored its argument, does not
// answer the decided text.
fn control_nat_as_int(n: Nat) -> Int {
  n as Int
}

fn nat_as_int_inclusion_cases() -> List<NativeEmissionCase> {
  [
    NativeEmissionCase { identity: "nat_as_int_inclusion_is_the_operand", held: control_nat_as_int(n: 7) == 7 },
    NativeEmissionCase { identity: "nat_as_int_inclusion_seconds_per_day", held: iso8601_seconds_per_day() == 86400 },
    NativeEmissionCase { identity: "nat_as_int_inclusion_utc_text", held: iso8601_utc_text(unix: 1700000000) == "2023-11-14T22:13:20Z" },
    NativeEmissionCase { identity: "nat_as_int_inclusion_red_utc_text_is_not_the_next_second", held: iso8601_utc_text(unix: 1700000001) != "2023-11-14T22:13:20Z" }
  ]
}

// RULE: an empty list literal cast to a list type is typed by the cast (v1.compiler.infer, ExprCast
// arm). Inferred alone it was List<empty_list_element>, and `init: [] as List<Int>` -- the fold
// seed extdeps.linux.cgroup_v2 writes -- emitted a panic in place of the seed. The red is the seed
// itself: a fold over nothing returns it, and it must be empty.
fn control_above_two(xs: List<Int>) -> List<Int> {
  fold(xs, init: [] as List<Int>, f: (acc, x) => if x > 2 { concat(acc, [x]) } else { acc })
}

fn empty_list_cast_cases() -> List<NativeEmissionCase> {
  [
    NativeEmissionCase { identity: "empty_list_cast_seeds_a_fold", held: (control_above_two(xs: [1, 2, 3, 4]) |> count) == 2 },
    NativeEmissionCase { identity: "empty_list_cast_red_seed_is_empty", held: (control_above_two(xs: []) |> count) == 0 }
  ]
}

// A catch-all binds the matched enum value after the scrutinee's shared layer
// has been opened. Reusing it as another variant's field must restore that layer.
type ControlNestedLookup
  = ControlNestedFound { value: Int }
  | ControlNestedMissing

type ControlNestedLookupOutcome
  = ControlNestedLookupRefused { cause: ControlNestedLookup }

fn control_nested_lookup_wrap(value: ControlNestedLookup) -> ControlNestedLookupOutcome {
  match value {
    ControlNestedFound { value: n } => ControlNestedLookupRefused { cause: ControlNestedFound { value: n } }
    other => ControlNestedLookupRefused { cause: other }
  }
}

type ControlRecursiveLookup
  = ControlRecursiveEnd
  | ControlRecursiveNext { next: ControlRecursiveLookup }

type ControlRecursiveLookupOutcome
  = ControlRecursiveLookupRefused { cause: ControlRecursiveLookup }

fn control_recursive_lookup_wrap(value: ControlRecursiveLookup) -> ControlRecursiveLookupOutcome {
  match value {
    ControlRecursiveEnd => ControlRecursiveLookupRefused { cause: ControlRecursiveEnd }
    other => ControlRecursiveLookupRefused { cause: other }
  }
}

// The recursive call is in the catch-all BODY, a route accepted by both parsers.
// Arm guards are not part of v2's grammar and are not this control's subject.
fn control_recursive_tco_body_wrap(value: ControlRecursiveLookup, remaining: Int) -> ControlRecursiveLookupOutcome {
  match value {
    other => if remaining > 0 {
      control_recursive_tco_body_wrap(value: other, remaining: remaining - 1)
    } else {
      ControlRecursiveLookupRefused { cause: other }
    }
  }
}

fn catchall_tco_body_cases() -> List<NativeEmissionCase> {
  [
    NativeEmissionCase {
      identity: "catchall_tco_body_restores_shared_carrier",
      held: match control_recursive_tco_body_wrap(value: ControlRecursiveNext { next: ControlRecursiveEnd }, remaining: 3) {
        ControlRecursiveLookupRefused { cause: ControlRecursiveNext { next: ControlRecursiveEnd } } => true
        _ => false
      },
    },
    NativeEmissionCase {
      identity: "catchall_tco_body_terminal_preserves_value",
      held: match control_recursive_tco_body_wrap(value: ControlRecursiveNext { next: ControlRecursiveEnd }, remaining: 0) {
        ControlRecursiveLookupRefused { cause: ControlRecursiveNext { next: ControlRecursiveEnd } } => true
        _ => false
      },
    },
  ]
}

fn nested_payload_catchall_cases() -> List<NativeEmissionCase> {
  [
    NativeEmissionCase {
      identity: "catchall_enum_payload_restores_shared_carrier",
      held: match control_nested_lookup_wrap(value: ControlNestedMissing) {
        ControlNestedLookupRefused { cause: ControlNestedMissing } => true
        _ => false
      },
    },
    NativeEmissionCase {
      identity: "explicit_enum_payload_keeps_its_value",
      held: match control_nested_lookup_wrap(value: ControlNestedFound { value: 47 }) {
        ControlNestedLookupRefused { cause: ControlNestedFound { value: n } } => n == 47
        _ => false
      },
    },
    NativeEmissionCase {
      identity: "catchall_recursive_payload_restores_shared_carrier",
      held: match control_recursive_lookup_wrap(value: ControlRecursiveNext { next: ControlRecursiveEnd }) {
        ControlRecursiveLookupRefused { cause: ControlRecursiveNext { next: ControlRecursiveEnd } } => true
        _ => false
      },
    },
  ]
}

fn native_emission_cases() -> List<NativeEmissionCase> {
  concat(enum_member_identity_cases(), concat(catchall_tco_body_cases(), concat(nested_payload_catchall_cases(), concat(imported_result_capture_cases(), concat(local_binder_shadow_cases(), concat(local_binder_shadows_coproduct_arm_cases(), concat(open_init_fold_cases(), concat(concat(nat_as_int_inclusion_cases(), empty_list_cast_cases()), concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(same_leaf_declaration_cases(), concat(concat(concat(concat(concat(concat(header_bound_cases(), fn_value_bound_cases()), filter_in_branch_condition_cases()), claim_driver_filesystem_cases()), effectful_fold_step_cases()), capability_alias_output_cases()), fold_accumulator_formals_cases())), list_index_cases()), optional_data_row_cases()), effectful_generic_return_cases()), generic_empty_map_turbofish_cases()), data_literal_tree_cases()), variant_literal_application_cases()), rc_match_clone_cases()), optional_type_parameter_cases()), algebra_length_on_string_cases()), nested_variant_match_cases()), alias_empty_map_seed_cases()), concat(bare_variant_fold_init_cases(), concat(dual_form_append_accumulator_cases(), concat(list_payload_enum_cases(), concat(concat(mixed_set_carrier_cases(), canonical_set_carrier_cases()), heap_reference_carrier_cases())))))))))))))
}

fn case_row(c: NativeEmissionCase) -> String {
  concat("case ", concat(c.identity, concat(if c.held { " held" } else { " not_held" }, concat(" observed=", concat(if c.held { "as_decided" } else { "other_answer" }, "\n")))))
}

fn native_claim_report() -> NativeClaimReport {
  let cases = native_emission_cases()
  let roster = concat("roster ", concat(native_emission_expected_identities |> join(separator: ","), "\n"))
  let failed = cases |> filter(c => !c.held) |> map(c => c.identity)
  let terminal = if (failed |> count) == 0 { held_terminal() } else { not_held_terminal(reason: concat("not held: ", failed |> join(separator: ","))) }
  NativeClaimReport { stdout: concat(roster, cases |> map(c => case_row(c: c)) |> join(separator: "")), terminal: terminal }
}

fn held_terminal() -> NativeClaimTerminal {
  NativeClaimHeld
}

fn not_held_terminal(reason: String) -> NativeClaimTerminal {
  NativeClaimNotHeld { reason: reason }
}
