import v2.std.node { Symbol, symbol_intern_lexeme }
import gunbc.instruments.native_emission_controls_alias { ControlWords, control_words_of }
import std.list { duplicated_by_key }
import gunbc.instruments.native_emission_controls_leaf_a { control_leaf_a_probe }
import gunbc.instruments.native_emission_controls_leaf_b { control_leaf_b_probe }
import gunbc.instruments.native_emission_controls_homonym { ControlBoxed, narrow_slot_value, narrow_slots_equal }
import std.resource_contract { Observation, Read }
import std.integer { UInt8, UInt8Ready, UInt8OutOfRange, uint8_of_int }
import extdeps.filesystem.filesystem_io { Filesystem }
