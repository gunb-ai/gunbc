module tools.merge_admission_capture

import std.algebra { trim }

import std.types { FilePath, GitRef, NonEmptyStr, String, Bool }
import extdeps.git.inspect
import extdeps.shell
import extdeps.filesystem.filesystem_io { Filesystem }
import gunbc.merge_admission_subject {
  TestedSubject,
  WalkAttemptId,
  compose_explicit_walk_attempt_id,
  compose_walk_attempt_id,
  merge_admission_attempt_dir,
  merge_admission_merge_base_ref,
  merge_admission_tested_subject_path,
  render_tested_subject_wire,
}

// This wet capture entry imports only the walk-attempt/tested-subject identity carrier plus typed
// git/filesystem services. Merge classification, commit-roster hashing, and CI failure taxonomy are
// deliberately downstream and absent from this closure. The entry runs in the plan's typed pre-walk
// claim_batch subprocess, so its evaluator arena dies before the ordinary floor and discovery
// cannot retain it.

// TYPED CAUSE ACROSS THE CLAIM BOUNDARY (review 47517, §5). The pre-walk transport's channel is a
// Bool claim result, which cannot carry the refusal cause — so the capture core returns the typed
// sum below, and the Bool projection durably writes the labeled cause to
// target/merge-admission-capture-refusal.txt (the floor-population-budget-refusal.txt pattern)
// BEFORE returning false. The wire is cleared at capture start so a stale cause from a prior
// attempt cannot masquerade as this attempt's; a false result with no wire is meant to be a
// distinct reported state (child died before writing), never silently folded into a generic
// failure.
//
// TWO CORRECTIONS TO THE PARAGRAPH ABOVE, both found by the 19-candidate discarded-effect census
// (#10574's out-of-scope remainder) and both left standing rather than quietly reworded, because
// each is a claim this module was making and cannot make today.
//
// FIRST, THE READER IS GONE. This text said claim_executor's run_pre_walk_execution reads the wire
// into a located PRE-WALK-REFUSED line. No such reader exists: neither relpath appears anywhere in
// src/, claim_executor references no pre_walk_execution at all, and the five merge-admission phases
// were deleted from required-CI by the 2026-08-21 ruling. Nor is there a producer -- no WalkPlan
// literal in dag/ constructs a TypedClaimSubprocess, the floor plan that would have scheduled this
// capture went with the 2026-08-15 floor cut, and capture_tested_subject has zero callers. So this
// module is dormant at both ends, and a note asserting an executor consumes it was the
// deleted-cadence-still-cited-as-enforcement shape.
//
// SECOND, THE GUARANTEE DEPENDS ON A DISCARDED OUTCOME. capture_tested_subject binds the clearing
// sweep's outcome to `_`, so "the wire was cleared" and "the clear failed and a prior attempt's
// cause survived" are spelled identically -- which is exactly the state the sentence above promises
// cannot occur. The same holds for the refusal write, whose Bool is also discarded: a write that
// FAILED is then indistinguishable from the child dying before writing, collapsing two of the three
// states this wire exists to separate. This is the census's OutcomeSemanticallyRequired class, and
// it is the only member of it outside the printer scope, together with its two siblings in
// tools.merge_admission_walk.
//
// THE REMEDY IS NOT TO CONSUME THOSE TWO BOOLS. Presence-and-freshness of a file cannot be made
// sound by a best-effort sweep; the wire must carry the walk attempt identity it is about, so a
// reader decides staleness from the CONTENT rather than from a clear having succeeded, at which
// point the pre-clear becomes honestly best-effort and the failed-write state stays distinct. That
// is a change to the wire format, so it lands with the reader that parses it. TRIGGER: the
// re-arming of a pre-walk capture stage -- a WalkPlan producer constructing TypedClaimSubprocess
// and an executor that reads this wire. Until then the defect is real, unreachable, and recorded
// here rather than repaired into a channel with no ends.

fn env_var(name: NonEmptyStr) -> String? {
  let env = shell.Env.Get(name: name)
  match env.value {
    Present { value: raw } =>
      let line = trim(raw)
      if line == "" { none } else { Present { value: line } }
    Absent => none
  }
}

fn capture_walk_attempt_id() -> WalkAttemptId? {
  match env_var(name: "GUNBC_WALK_ATTEMPT_ID") {
    Present { value: explicit } => compose_explicit_walk_attempt_id(explicit: explicit)
    Absent =>
      match env_var(name: "GITHUB_RUN_ID") {
        Absent => none
        Present { value: run_id } =>
          match env_var(name: "GITHUB_RUN_ATTEMPT") {
            Absent => none
            Present { value: run_attempt } =>
              match env_var(name: "GITHUB_JOB") {
                Absent => none
                Present { value: job } => compose_walk_attempt_id(
                  run_id: run_id,
                  run_attempt: run_attempt,
                  job: job
                )
              }
          }
      }
  }
}

fn tested_checkout_base_ref(event_name: String) -> GitRef {
  if (event_name == "pull_request") || (event_name == "merge_group") {
    "HEAD^1" as GitRef
  } else {
    "HEAD" as GitRef
  }
}

fn current_event_name() -> String {
  match env_var(name: "GITHUB_EVENT_NAME") {
    Present { value: event_name } => event_name
    Absent => "workflow_dispatch"
  }
}

type TestedSubjectCaptureRefusal
  = CaptureAttemptIdentityAbsent
  | CaptureHeadCommitRefused
  | CaptureBaseCommitRefused
  | CaptureAttemptDirClearRefused
  | CaptureAttemptDirCreateRefused
  | CaptureSubjectWriteRefused

type TestedSubjectCapture
  = TestedSubjectCaptured
  | TestedSubjectCaptureRefused { cause: TestedSubjectCaptureRefusal }

fn tested_subject_capture_refusal_label(cause: TestedSubjectCaptureRefusal) -> String {
  match cause {
    CaptureAttemptIdentityAbsent => "attempt-identity-absent"
    CaptureHeadCommitRefused => "head-commit-refused"
    CaptureBaseCommitRefused => "base-commit-refused"
    CaptureAttemptDirClearRefused => "attempt-dir-clear-refused"
    CaptureAttemptDirCreateRefused => "attempt-dir-create-refused"
    CaptureSubjectWriteRefused => "subject-write-refused"
  }
}

data merge_admission_capture_refusal_wire_relpath: String = "target/merge-admission-capture-refusal.txt"

// PAIRED LITERAL (review 47596): claim_executor.rs MERGE_ADMISSION_CAPTURE_REFUSAL_WIRE reads this
// exact relpath — the seed cannot import a .dag datum, so a rename here lands with the paired seed
// edit or the parent's read degrades to its loud wire-absent arm. Same pairing class as
// floor-population-budget-refusal.txt, under walk_plan_run_stage_claim_executor_seed_deferral.

func tested_subject_capture() -> TestedSubjectCapture {
  match capture_walk_attempt_id() {
    Absent => TestedSubjectCaptureRefused { cause: CaptureAttemptIdentityAbsent }
    Present { value: attempt_id } =>
      let head = git.Inspect.HeadCommit()
      if !head.success {
        TestedSubjectCaptureRefused { cause: CaptureHeadCommitRefused }
      } else {
        let base_ref = tested_checkout_base_ref(event_name: current_event_name())
        let base_commit = git.Inspect.ResolveRefCommit(ref: base_ref)
        if !base_commit.success {
          TestedSubjectCaptureRefused { cause: CaptureBaseCommitRefused }
        } else {
              let root = git.Inspect.Toplevel().path as String
              let attempt_dir = merge_admission_attempt_dir(root: root, attempt_id: attempt_id)
              let cleared = shell.Remove.RecursiveForce(path: attempt_dir as FilePath)
              if !cleared.success {
                TestedSubjectCaptureRefused { cause: CaptureAttemptDirClearRefused }
              } else {
                let ready = shell.Mkdir.Parents(path: attempt_dir as FilePath)
                if !ready.success {
                  TestedSubjectCaptureRefused { cause: CaptureAttemptDirCreateRefused }
                } else {
                  let subject = TestedSubject {
                    attempt_id: attempt_id,
                    head_sha: head.sha,
                    base_ref: merge_admission_merge_base_ref,
                    base_commit_sha: base_commit.sha,
                  }
                  let written = Filesystem.Write(
                    path: merge_admission_tested_subject_path(root: root, attempt_id: attempt_id),
                    content: render_tested_subject_wire(subject: subject)
                  )
                  if written.success {
                    TestedSubjectCaptured
                  } else {
                    TestedSubjectCaptureRefused { cause: CaptureSubjectWriteRefused }
                  }
                }
              }
        }
      }
  }
}

func capture_refusal_wire_path() -> FilePath {
  let root = git.Inspect.Toplevel().path as String
  concat(concat(root, "/"), merge_admission_capture_refusal_wire_relpath) as FilePath
}

func write_capture_refusal_wire(cause: TestedSubjectCaptureRefusal) -> Bool {
  Filesystem.Write(
    path: capture_refusal_wire_path(),
    content: concat(concat("cause=", tested_subject_capture_refusal_label(cause: cause)), "\n")
  ).success
}

func capture_tested_subject() -> Bool {
  let _ = shell.Remove.RecursiveForce(path: capture_refusal_wire_path())
  match tested_subject_capture() {
    TestedSubjectCaptured => true
    TestedSubjectCaptureRefused { cause: cause } =>
      let _ = write_capture_refusal_wire(cause: cause)
      false
  }
}
