// WAVE-0 B: drive the real compute_run_unit through a cold cargo release of work_default_build.
// Bus presence, refusal, and launcher_env bindings are THIS FOLD; the unit launch is
// gunbc.compute.work_provider_local compute_run_unit, not a copy. No bus is ExitFailure code 2
// (gunbc test: no observation). Each run's frame is its unix-millis reading, and its instance root
// is /tmp/gunbc_compute_<frame> (std.materialization_store_grant materialization_store_frame_root),
// so target_dir is empty at start and nothing the run writes lands in the persistent workspace.

// THE UNIT GRANT IS ONE BYTESIZE. compute_run_unit takes Kibibyte; the dispatch job cgroup must
// admit that grant PLUS the wet CliWire evaluator that launches systemd-run --user. Those two
// quantities are derived here so a later edit cannot retune the unit without the job wall, or
// size the job wall to the grant alone (review 79835).
data compute_run_unit_cold_unit_grant_bytes: ByteSize = gibibyte_to_byte_size(g: gibibyte(count: 16))

fn compute_run_unit_cold_unit_grant() -> Kibibyte {
  kibibyte_from_byte_size_floor(b: compute_run_unit_cold_unit_grant_bytes)
}

// POLICY BUDGET for the gunbc process and systemd-run --user that sit outside the unit MemoryMax.
// Not native_step_memory_headroom: that row is slot MemoryHigh minus the compiler trip, a different
// subject. One gibibyte, as a declared launcher reservation, not a measured RSS.
data compute_run_unit_cold_launcher_headroom: ByteSize = gibibyte_to_byte_size(g: gibibyte(count: 1))

fn compute_run_unit_cold_job_memory_demand() -> ByteSize {
  measure_add(a: compute_run_unit_cold_unit_grant_bytes, b: compute_run_unit_cold_launcher_headroom)
}

type HermeticUserSessionRuntime
  = HermeticUserSessionRuntimeBound { runtime_dir: FilePath }
  | HermeticUserSessionRuntimeAbsent

fn path_is_under_production_instance_root(path: String) -> Bool {
  let root = srv1_live_dashboard_instance().instance_root
  (path == root as String) || dashboard_path_is_under(path: path as FilePath, root: root)
}

fn observe_workspace(instance: HostDashboardInstance) -> String {
  match compute_exec(program: compute_program(instance: instance, cap: GitWorkspaceCapability), workdir: ".", args: ["rev-parse", "--show-toplevel"]) {
    ComputeExecOk { stdout, stderr: _ } => trim(s: stdout)
    ComputeExecFailed { exit_code: _, stdout: _, stderr: _ } => ""
  }
}

fn observe_run_frame() -> Int? {
  match clock_unix_millis_read() {
    ClockUnixMillisRefused { detail: _ } => none
    ClockUnixMillisObserved { millis } => Present { value: millis }
  }
}

fn observe_hermetic_user_session_runtime() -> HermeticUserSessionRuntime {
  let status = Filesystem.Read(path: "/proc/self/status")
  if !status.success {
    HermeticUserSessionRuntimeAbsent
  } else {
    match procfs_status_effective_uid(content: status.content) {
      Absent => HermeticUserSessionRuntimeAbsent
      Present { value: uid } => {
        let runtime_dir = join(["/run/user/", to_string(value: uid)], "")
        let listed = Filesystem.List(path: runtime_dir as FilePath)
        if listed.success && any(split(s: listed.entries, delimiter: "\n"), n => n == "bus") {
          HermeticUserSessionRuntimeBound { runtime_dir: runtime_dir as FilePath }
        } else {
          HermeticUserSessionRuntimeAbsent
        }
      }
    }
  }
}

fn hermetic_user_session_unit_setenv(runtime_dir: FilePath) -> List<SystemdSetenvBinding> {
  [
    SystemdSetenvBinding { name: "XDG_RUNTIME_DIR", value: runtime_dir as String as NonEmptyStr },
    SystemdSetenvBinding {
      name: "DBUS_SESSION_BUS_ADDRESS",
      value: join(["unix:path=", runtime_dir as String, "/bus"], "") as NonEmptyStr,
    },
  ]
}

fn observe_isolated_job_toolchain_homes() -> IsolatedJobToolchainHomes? {
  match shell.Env.Get(name: cargo_environment_variable_name(variable: CargoHomeEnv)).value {
    Absent => none
    Present { value: cargo_home } =>
      if trim(s: cargo_home) == "" {
        none
      } else {
        match shell.Env.Get(name: rustup_home_env_name).value {
          Absent => none
          Present { value: rustup_home } =>
            if trim(s: rustup_home) == "" {
              none
            } else {
              Present {
                value: IsolatedJobToolchainHomes {
                  cargo_home: cargo_home as FilePath,
                  rustup_home: rustup_home as FilePath,
                },
              }
            }
        }
      }
  }
}

fn hermetic_toolchain_unit_setenv(homes: IsolatedJobToolchainHomes) -> List<SystemdSetenvBinding> {
  [
    SystemdSetenvBinding {
      name: cargo_environment_variable_name(variable: CargoHomeEnv),
      value: homes.cargo_home as String as NonEmptyStr,
    },
    SystemdSetenvBinding {
      name: rustup_home_env_name,
      value: homes.rustup_home as String as NonEmptyStr,
    },
  ]
}

fn hermetic_user_session_launcher_env(runtime_dir: FilePath) -> List<EnvBinding> {
  [
    EnvSet { name: "XDG_RUNTIME_DIR", value: runtime_dir as String },
    EnvSet { name: "DBUS_SESSION_BUS_ADDRESS", value: join(["unix:path=", runtime_dir as String, "/bus"], "") },
  ]
}

fn mkdir_ok(instance: HostDashboardInstance, path: String) -> Bool {
  match compute_exec(program: instance.toolchain.directory_create as String, workdir: ".", args: ["-p", path]) {
    ComputeExecOk { stdout: _, stderr: _ } => true
    ComputeExecFailed { exit_code: _, stdout: _, stderr: _ } => false
  }
}

fn observe_head(instance: HostDashboardInstance, workdir: String) -> String {
  match compute_exec(program: compute_program(instance: instance, cap: GitWorkspaceCapability), workdir: workdir, args: ["rev-parse", "HEAD"]) {
    ComputeExecOk { stdout, stderr: _ } => trim(s: stdout)
    ComputeExecFailed { exit_code: _, stdout: _, stderr: _ } => ""
  }
}

fn target_dir_is_empty(path: String) -> Bool {
  let listed = Filesystem.List(path: path as FilePath)
  listed.success && (trim(s: listed.entries) == "")
}

fn unit_was_invoked(summary: SystemdRunWaitSummary) -> Bool {
  match summary.result {
    ServiceResultRead { result: _ } => true
    ServiceResultUnrecognized { wire: _ } => true
    ServiceResultFormatNotGrounded { standing: _ } => true
    ServiceResultNotReported { absence } => match absence {
      SummaryNoInvocation => false
      SummarySuppressedByQuietLauncher => true
      SummaryCaptureEmpty => true
      SummaryLineAbsent => true
    }
  }
}

fn prepare_checkout(instance: HostDashboardInstance, layout: ComputeLayout, head: String) -> String {
  match compute_exec(
    program: compute_program(instance: instance, cap: GitWorkspaceCapability),
    workdir: ".",
    args: shape_git_worktree_add_detached_argv(path: layout.checkout as FilePath, commit: head as GitRef),
  ) {
    ComputeExecOk { stdout: _, stderr: _ } => ""
    ComputeExecFailed { exit_code, stdout: _, stderr } =>
      join(["git worktree add exited ", to_string(value: exit_code), ": ", stderr], "")
  }
}

// THE COLD ARM'S SECOND HALF, DRIVEN ON THE REAL UNIT'S OWN OUTPUTS (pairing obligation: the
// supplied-outcome commit in test.claim.compute.attempt_lifecycle_wet_witness reuse_commit owes this
// inhabitance). The unit compute_run_unit just ran built the tree; its declared outputs are captured
// from THIS identity's owned target by compute_return_outputs, committed by compute_store_commit under
// the request the real toolchain and tree name, and the production leaf must then ATTACH to that
// record. Returns "" when all of that held, otherwise what stopped it. Deleting the commit makes the
// leaf enter production (ProvideFresh), which this refuses.
fn cold_commit_and_attach(instance: HostDashboardInstance, layout: ComputeLayout, head: String, exec_log: String) -> String {
  match compute_store(instance: instance) {
    Absent => "the hermetic instance declares no compute store"
    Present { value: store } =>
      match compute_observe_toolchain(instance: instance) {
        ToolchainObservationRefused { detail } => join(["toolchain unobserved: ", detail], "")
        ToolchainObserved { toolchain } =>
          match compute_resolve_subject(instance: instance, commit: head) {
            SubjectResolutionRefused { detail } => join(["subject unresolved: ", detail], "")
            SubjectResolved { subject } => {
              let op = work_default_build()
              let identity = compute_work_identity(subject: subject, op: op, toolchain: toolchain)
              // The hermetic frame root holds no store yet (a durable host volume is provisioned ahead of the first request).
              let staged = mkdir_ok(instance: instance, path: materialization_store_root_path(root: store.root)) && mkdir_ok(instance: instance, path: layout.staging_dir) && mkdir_ok(instance: instance, path: layout.leases_dir)
              let log = Filesystem.Write(path: layout.log_path, content: exec_log)
              if !(staged && log.success) { "staging or the run log could not be written" } else {
                match compute_return_outputs(instance: instance, layout: layout, declared: work_declared_outputs(op: op)) {
                  OutputsMismatch { detail } => join(["capture mismatched: ", detail], "")
                  OutputsReturned { outputs } => {
                    let outcome = WorkSucceeded { identity: identity, outputs: outputs, log_path: layout.log_path }
                    match compute_store_commit(
                      materialization: ComputeMaterialization { store: store, request: ComputeWorkRequest { subject: subject, operation: op, toolchain: toolchain }, plan: ComputeMemoized },
                      layout: layout, op: op, outcome: outcome,
                      document: work_outcome_wire(o: outcome, subject: subject, op: op),
                    ) {
                      ComputeCommitNotOwed => "the commit was not owed"
                      ComputeCommitRefused { detail } => join(["the commit was refused: ", detail], "")
                      ComputeCommitted =>
                        match compute_provide_leaf(store: store, instance: instance, owner: DirectInvocation { why: "compute-run-unit-cold" }, commit: head, subject: subject, op: op, toolchain: toolchain, dependency: NoComputeDependency) {
                          ProvideFresh { outcome: _, document: _, host_record: _ } => "the production leaf did not attach to the committed record"
                          ProvideAttached { identity: attached, ending: _, document: _, host_record: _ } =>
                            if attached == identity { "" } else { "the leaf attached to a different identity" }
                        }
                    }
                  }
                }
              }
            }
          }
      }
  }
}

fn no_observation(bytes: String, reason: String) -> CliWireResponse {
  CliWirePrintable { bytes: bytes, exit: ExitFailure { code: 2, reason: reason } }
}

fn compute_run_unit_cold_exit() -> CliWireResponse {
  match observe_hermetic_user_session_runtime() {
    HermeticUserSessionRuntimeAbsent =>
      no_observation(
        bytes: "compute-run-unit-cold: no observation: user session bus absent at /run/user/<uid>/bus (systemd-run --user cannot run)",
        reason: "user session bus absent",
      )
    HermeticUserSessionRuntimeBound { runtime_dir } =>
      match observe_isolated_job_toolchain_homes() {
        Absent =>
          CliWirePrintable {
            bytes: "compute-run-unit-cold: ToolchainHomesNotIsolated CARGO_HOME/RUSTUP_HOME unset or empty (job isolation did not run; refusing ambient PATH and developer-home cargo)",
            exit: ExitFailure { code: 1, reason: "ToolchainHomesNotIsolated" },
          }
        Present { value: toolchain_homes } =>
          match observe_run_frame() {
            Absent =>
              no_observation(
                bytes: "compute-run-unit-cold: no observation: clock unix millis unreadable, so this run has no frame",
                reason: "run frame unreadable",
              )
            Present { value: frame } => cold_two_identity_exit(runtime_dir: runtime_dir, toolchain_homes: toolchain_homes, first_frame: frame)
          }
      }
  }
}

fn observe_argv(program: String, args: List<String>) -> String {
  match compute_exec(program: program, workdir: ".", args: args) {
    ComputeExecOk { stdout, stderr } => join([stdout, stderr], "")
    ComputeExecFailed { exit_code, stdout, stderr } =>
      join(["exit=", to_string(value: exit_code), "\n", stdout, stderr], "")
  }
}

fn lines_with_needle(text: String, needle: String) -> String {
  join(filter(split(s: text, delimiter: "\n"), l => length(xs: split(s: l, delimiter: needle)) > 1), "\n")
}

fn ci_cache_uds_path() -> String? {
  match ci_cache_instance(host: operator_host_srv1).endpoint {
    SccacheServerUnixSocket { path } => Present { value: path as String }
    SccacheServerTcpPort { port: _ } => none
  }
}

fn observe_ci_cache_uds_stat() -> String {
  match ci_cache_uds_path() {
    Absent => "=== stat CI UDS ===\nCI endpoint is TCP; UDS stat not applicable\n"
    Present { value: uds } =>
      join([
        "=== stat CI UDS ", uds, " ===\n",
        observe_argv(program: stat_program().invocation as String, args: ["-c", "%U %u %a %n", uds]),
        "\n",
      ], "")
  }
}

fn observe_sccache_host_probe() -> String {
  let tcp_sport = join(["sport = :", to_string(value: sccache_server_default_tcp_port)], "")
  let user_mgr = systemctl_user_manager_probe_command()
  let id_out = observe_argv(program: id_binary_path as String, args: [])
  let host_out = observe_argv(program: hostname_program().invocation as String, args: [])
  let ps_out = observe_argv(program: ps_program().invocation as String, args: ps_user_uid_pid_args_listing_args())
  let ss_out = observe_argv(program: ss_binary_path as String, args: ["-ltnp", tcp_sport])
  let mgr_env = observe_argv(program: user_mgr.program.invocation as String, args: user_mgr.arguments)
  let ss_unix = observe_argv(program: ss_binary_path as String, args: ["-xlp"])
  join([
    "=== id ===\n", id_out, "\n",
    "=== hostname ===\n", host_out, "\n",
    "=== ps ", sccache_installed_binary_path, " (user,uid,pid,args) ===\n",
    lines_with_needle(text: ps_out, needle: sccache_installed_binary_path), "\n",
    "=== ss -ltnp ", tcp_sport, " ===\n", ss_out, "\n",
    "=== systemctl --user show-environment SCCACHE/RUSTC_WRAPPER ===\n",
    lines_with_needle(text: mgr_env, needle: "SCCACHE"), "\n",
    lines_with_needle(text: mgr_env, needle: "RUSTC_WRAPPER"), "\n",
    observe_ci_cache_uds_stat(),
    "=== ss -xlp sccache/server.sock ===\n",
    lines_with_needle(text: ss_unix, needle: "sccache"), "\n",
    lines_with_needle(text: ss_unix, needle: "server.sock"), "\n",
  ], "")
}

type UnitPrintenvObservation
  = UnitPrintenvObserved { text: String }
  | UnitPrintenvRefused { reason: String, text: String }

fn observe_unit_printenv(runtime_dir: FilePath, toolchain_homes: IsolatedJobToolchainHomes) -> UnitPrintenvObservation {
  match observe_run_frame() {
    Absent => UnitPrintenvRefused { reason: "run frame unreadable", text: "" }
    Present { value: frame } => {
  let identity = to_string(value: frame)
  let workspace = observe_workspace(
    instance: fleet_compute_hermetic_dashboard_instance_at(workspace: "." as FilePath, frame: frame, toolchain_homes: toolchain_homes),
  )
  if (workspace == "") || path_is_under_production_instance_root(path: workspace) {
    UnitPrintenvRefused { reason: "workspace unusable", text: "" }
  } else {
    let instance = fleet_compute_hermetic_dashboard_instance_at(workspace: workspace as FilePath, frame: frame, toolchain_homes: toolchain_homes)
    match compute_layout(instance: instance, identity_hex: identity) {
    Absent => UnitPrintenvRefused { reason: "no materialization store declared", text: "" }
    Present { value: layout } => {
    let roots_ok = mkdir_ok(instance: instance, path: instance.instance_root as String)
      && mkdir_ok(instance: instance, path: layout.work_dir)
      && mkdir_ok(instance: instance, path: layout.checkout)
      && mkdir_ok(instance: instance, path: layout.target_dir)
    if !roots_ok {
      UnitPrintenvRefused { reason: "layout directories were not created", text: "" }
    } else {
      match compute_run_unit(
        instance: instance,
        layout: layout,
        identity_hex: identity,
        argv: ["/usr/bin/printenv"],
        env: concat(
          hermetic_user_session_unit_setenv(runtime_dir: runtime_dir),
          hermetic_toolchain_unit_setenv(homes: toolchain_homes),
        ),
        launcher_env: hermetic_user_session_launcher_env(runtime_dir: runtime_dir),
        granted: kibibyte_from_byte_size_floor(b: gibibyte_to_byte_size(g: gibibyte(count: 1))),
        user_runtime_dir: runtime_dir,
        stop_observation: NoStopObservation,
      ) {
        ComputeUnitRunRefused { cause: _ } => UnitPrintenvRefused { reason: "unit launch refused", text: "" }
        ComputeUnitRunExecuted { run: unit_run } =>
          match unit_run.exec {
            ComputeExecOk { stdout, stderr: _ } => UnitPrintenvObserved {
              text: join([
                "=== unit printenv SCCACHE/RUSTC_WRAPPER (compute_run_unit declares UDS; SCCACHE_DIR unbound) ===\n",
                lines_with_needle(text: stdout, needle: "SCCACHE"),
                "\n",
                lines_with_needle(text: stdout, needle: "RUSTC_WRAPPER"),
                "\n",
              ], ""),
            }
            ComputeExecFailed { exit_code, stdout, stderr } => UnitPrintenvRefused {
              reason: "unit printenv exited non-zero",
              text: join(["exit=", to_string(value: exit_code), "\n", stdout, stderr], ""),
            }
          }
      }
    }
  }
    }
    }
    }
  }
}

fn compute_run_unit_sccache_probe_exit() -> CliWireResponse {
  let host = observe_sccache_host_probe()
  let head = join(["compute-run-unit-sccache-probe\n", host], "")
  match observe_hermetic_user_session_runtime() {
    HermeticUserSessionRuntimeAbsent =>
      no_observation(bytes: join([head, "no observation: user session bus absent\n"], ""), reason: "user session bus absent")
    HermeticUserSessionRuntimeBound { runtime_dir } =>
      match observe_isolated_job_toolchain_homes() {
        Absent => CliWirePrintable {
          bytes: join([head, "ToolchainHomesNotIsolated\n"], ""),
          exit: ExitFailure { code: 1, reason: "ToolchainHomesNotIsolated" },
        }
        Present { value: homes } =>
          match observe_unit_printenv(runtime_dir: runtime_dir, toolchain_homes: homes) {
            UnitPrintenvObserved { text } => CliWirePrintable { bytes: join([head, text], ""), exit: ExitSuccess }
            UnitPrintenvRefused { reason, text } => CliWirePrintable {
              bytes: join([head, "unit printenv refused: ", reason, "\n", text], ""),
              exit: ExitFailure { code: 1, reason: reason },
            }
          }
      }
  }
}


fn cold_unit_run(runtime_dir: FilePath, toolchain_homes: IsolatedJobToolchainHomes, frame: Int, stop_observation: ComputeUnitStopObservation) -> CliWireResponse {
      let identity = to_string(value: frame)
      let probe = fleet_compute_hermetic_dashboard_instance_at(workspace: "." as FilePath, frame: frame, toolchain_homes: toolchain_homes)
      let workspace = observe_workspace(instance: probe)
      if workspace == "" {
        CliWirePrintable {
          bytes: "compute-run-unit-cold: git toplevel (job workspace) could not be read",
          exit: ExitFailure { code: 1, reason: "workspace unreadable" },
        }
      } else if path_is_under_production_instance_root(path: workspace) {
        CliWirePrintable {
          bytes: join(["compute-run-unit-cold: workspace is host-shared production path ", workspace], ""),
          exit: ExitFailure { code: 1, reason: "workspace under the production instance root" },
        }
      } else {
        let instance = fleet_compute_hermetic_dashboard_instance_at(workspace: workspace as FilePath, frame: frame, toolchain_homes: toolchain_homes)
        let run_root = instance.instance_root as String
        match compute_layout(instance: instance, identity_hex: identity) {
          Absent =>
            CliWirePrintable {
              bytes: "compute-run-unit-cold: the hermetic instance declares no materialization store",
              exit: ExitFailure { code: 1, reason: "no materialization store declared" },
            }
          Present { value: layout } => {
        let root = compute_root(instance: instance) as String
        if path_is_under_production_instance_root(path: instance.instance_root as String) || path_is_under_production_instance_root(path: root) {
          CliWirePrintable {
            bytes: join(["compute-run-unit-cold: compute root resolved to host-shared path ", root], ""),
            exit: ExitFailure { code: 1, reason: "compute root under the production instance root" },
          }
        } else {
          let roots_ok = mkdir_ok(instance: instance, path: instance.instance_root as String)
            && mkdir_ok(instance: instance, path: layout.work_dir)
            && mkdir_ok(instance: instance, path: layout.target_dir)
            && mkdir_ok(instance: instance, path: layout.attempts_dir)
          if !roots_ok {
            CliWirePrintable {
              bytes: join(["compute-run-unit-cold: could not create layout under ", layout.root], ""),
              exit: ExitFailure { code: 1, reason: "layout directories were not created" },
            }
          } else {
            let target_empty_at_start = target_dir_is_empty(path: layout.target_dir)
            if !target_empty_at_start {
              CliWirePrintable {
                bytes: join(["compute-run-unit-cold: target_empty_at_start=false target_dir=", layout.target_dir], ""),
                exit: ExitFailure { code: 1, reason: "target directory was not empty at start" },
              }
            } else {
              let head = observe_head(instance: instance, workdir: workspace)
              if head == "" {
                CliWirePrintable {
                  bytes: "compute-run-unit-cold: HEAD could not be read from the invoking checkout",
                  exit: ExitFailure { code: 1, reason: "HEAD unreadable" },
                }
              } else {
                let wt = prepare_checkout(instance: instance, layout: layout, head: head)
                if wt != "" {
                  CliWirePrintable { bytes: wt, exit: ExitFailure { code: 1, reason: wt } }
                } else {
                  let op = work_default_build()
                  match compute_run_unit(
                    instance: instance,
                    layout: layout,
                    identity_hex: identity,
                    argv: compute_command_argv(instance: instance, layout: layout, op: op, dependency: NoComputeDependency),
                    env: concat(
                      concat(
                        concat(compute_operation_env(op: op), hermetic_user_session_unit_setenv(runtime_dir: runtime_dir)),
                        hermetic_toolchain_unit_setenv(homes: toolchain_homes),
                      ),
                      [SystemdSetenvBinding { name: "SCCACHE_LOG", value: "debug" as NonEmptyStr }],
                    ),
                    launcher_env: hermetic_user_session_launcher_env(runtime_dir: runtime_dir),
                    granted: compute_run_unit_cold_unit_grant(),
                    user_runtime_dir: runtime_dir,
                    stop_observation: stop_observation,
                  ) {
                    ComputeUnitRunRefused { cause: _ } =>
                      CliWirePrintable {
                        bytes: "compute-run-unit-cold: systemd-run option words refused",
                        exit: ExitFailure { code: 1, reason: "unit launch refused" },
                      }
                    ComputeUnitRunExecuted { run: unit_run } => {
                      let invoked = unit_was_invoked(summary: unit_run.summary)
                      let exec_ok = match unit_run.exec {
                        ComputeExecOk { stdout: _, stderr: _ } => true
                        ComputeExecFailed { exit_code: _, stdout: _, stderr: _ } => false
                      }
                      let bytes = join([
                        "compute-run-unit-cold identity=", identity, "\n",
                        "workspace=", workspace, "\n",
                        "run_root=", run_root, "\n",
                        "compute_root=", root, "\n",
                        "target_dir=", layout.target_dir, "\n",
                        "target_empty_at_start=", if target_empty_at_start { "true" } else { "false" }, "\n",
                        "checkout=", layout.checkout, "\n",
                        "user_runtime_dir=", runtime_dir as String, "\n",
                        "unit_invoked=", if invoked { "true" } else { "false" }, "\n",
                        "unit result: ", compute_summary_result_wire(summary: unit_run.summary), "\n",
                        "unit peak: ", compute_summary_peak_wire(summary: unit_run.summary), "\n",
                        match unit_run.exec {
                          ComputeExecOk { stdout, stderr } => join(["exec=ok\n", stdout, stderr], "")
                          ComputeExecFailed { exit_code, stdout, stderr } =>
                            join(["exec=failed exit=", to_string(value: exit_code), "\n", stdout, stderr], "")
                        },
                        "\n",
                      ], "")
                      let exec_log = match unit_run.exec {
                        ComputeExecOk { stdout, stderr } => join([stdout, stderr], "")
                        ComputeExecFailed { exit_code: _, stdout, stderr } => join([stdout, stderr], "")
                      }
                      let committed = if invoked && exec_ok { cold_commit_and_attach(instance: instance, layout: layout, head: head, exec_log: exec_log) } else { "" }
                      if invoked && exec_ok && (committed != "") {
                        CliWirePrintable { bytes: join([bytes, "cold arm: ", committed, "\n"], ""), exit: ExitFailure { code: 1, reason: join(["the cold arm's capture, commit or attach failed: ", committed], "") } }
                      } else if invoked && exec_ok {
                        CliWirePrintable { bytes: join([bytes, "cold arm: captured, committed and attached\n"], ""), exit: ExitSuccess }
                      } else {
                        CliWirePrintable {
                          bytes: bytes,
                          exit: ExitFailure {
                            code: 1,
                            reason: if !invoked {
                              "no systemd unit was invoked (SummaryNoInvocation)"
                            } else {
                              "the unit ran and the command failed"
                            },
                          },
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
          }
        }
      }
}

// WHAT THIS INSTRUMENT OBSERVES ABOUT REUSE. sccache hits, read from the SAME server the unit's
// cargo used (endpoint compute_user_sccache_server_uds, set on the unit by compute_run_unit); a bare
// `sccache --show-stats` from the launcher asks a different server. Result-store reuse and the
// VerifiedBuildBinaries handoff are NOT observed here: each identity gets a fresh target and
// checkout, so the only reuse this fold can see is sccache's.
type SccacheUnitReading
  = SccacheUnitServed { executed: Int, hits: Int, misses: Int }
  | SccacheUnitUnobserved { reason: String }

fn sccache_stat_value(text: String, label: String) -> Int? {
  fold(split(s: text, delimiter: "\n"), init: none, f: (acc, l) =>
    match acc {
      Present { value: _ } => acc
      Absent =>
        if length(xs: split(s: l, delimiter: label)) > 1 {
          parse_int(s: trim(s: join(split(s: l, delimiter: label), "")))
        } else {
          none
        }
    })
}

// The unit's sccache server is auto-spawned by the client inside the unit's cgroup and is reaped
// with it (KillMode=control-group, gunbc.compute.unit_bounds), and `sccache --show-stats` with no
// listener prints a plausible all-zero table. So the stats are read by the unit's own ExecStop=
// (systemd.service(5): always performed after a successful start, before the cgroup is reaped), with
// the unit's own SCCACHE_SERVER_UDS.
fn sccache_reading_from(text: String) -> SccacheUnitReading {
  match sccache_stat_value(text: text, label: "Compile requests executed") {
    Absent => SccacheUnitUnobserved { reason: "no 'Compile requests executed' line in the unit's own stats output" }
    Present { value: executed } =>
      match sccache_stat_value(text: text, label: "Cache hits") {
        Absent => SccacheUnitUnobserved { reason: "no 'Cache hits' count in the unit's own stats output" }
        Present { value: hits } =>
          match sccache_stat_value(text: text, label: "Cache misses") {
            Absent => SccacheUnitUnobserved { reason: "no 'Cache misses' count in the unit's own stats output" }
            Present { value: misses } => SccacheUnitServed { executed: executed, hits: hits, misses: misses }
          }
      }
  }
}

fn cold_run_succeeded(r: CliWireResponse) -> Bool {
  match r {
    CliWirePrintable { bytes: _, exit } =>
      match exit {
        ExitSuccess => true
        ExitFailure { code: _, reason: _ } => false
      }
    CliWireUnprintable { cause: _ } => false
  }
}

fn cold_run_bytes(r: CliWireResponse) -> String {
  match r {
    CliWirePrintable { bytes, exit: _ } => bytes
    CliWireUnprintable { cause } => cause as String
  }
}

fn sccache_reading_wire(label: String, r: SccacheUnitReading) -> String {
  match r {
    SccacheUnitServed { executed, hits, misses } =>
      join([label, ": executed=", to_string(value: executed), " hits=", to_string(value: hits), " misses=", to_string(value: misses), "\n"], "")
    SccacheUnitUnobserved { reason } => join([label, ": unobserved: ", reason, "\n"], "")
  }
}

// Two identities back to back in ONE dispatch: same slot, uid and cache directory. Only the second
// unit carries SccacheStatsAtStop, so its reading is that unit's own server's whole counters, not a difference.
fn cold_two_identity_exit(runtime_dir: FilePath, toolchain_homes: IsolatedJobToolchainHomes, first_frame: Int) -> CliWireResponse {
  let first = cold_unit_run(runtime_dir: runtime_dir, toolchain_homes: toolchain_homes, frame: first_frame, stop_observation: NoStopObservation)
  if !cold_run_succeeded(r: first) {
    first
  } else {
    match observe_run_frame() {
      Absent => no_observation(bytes: cold_run_bytes(r: first), reason: "second run frame unreadable")
      Present { value: second_frame } => {
        let second = cold_unit_run(runtime_dir: runtime_dir, toolchain_homes: toolchain_homes, frame: second_frame, stop_observation: SccacheStatsAtStop)
                let reading_2 = sccache_reading_from(text: cold_run_bytes(r: second))
        let bytes = join([
          cold_run_bytes(r: first), "\n=== second identity ===\n", cold_run_bytes(r: second), "\n",
          sccache_reading_wire(label: "sccache in second identity's unit", r: reading_2),
        ], "")
        if !cold_run_succeeded(r: second) {
          CliWirePrintable { bytes: bytes, exit: ExitFailure { code: 1, reason: "the second identity's run failed" } }
        } else {
          match reading_2 {
            SccacheUnitUnobserved { reason } => no_observation(bytes: bytes, reason: join(["no observation: ", reason], ""))
            SccacheUnitServed { executed, hits, misses: _ } =>
              if executed == 0 {
                no_observation(bytes: bytes, reason: "no observation: the second unit's own sccache stats show 0 compile requests")
              } else if hits > 0 {
                CliWirePrintable { bytes: bytes, exit: ExitSuccess }
              } else {
                CliWirePrintable { bytes: bytes, exit: ExitFailure { code: 1, reason: "the second identity had 0 sccache hits" } }
              }
          }
        }
      }
    }
  }
}
