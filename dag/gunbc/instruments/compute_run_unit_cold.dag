  sccache_installed_binary_path, sccache_server_default_tcp_port,
  SccacheServerUnixSocket, SccacheServerTcpPort,
}
import extdeps.tools.id { id_binary_path }
import extdeps.iproute2.ss { ss_binary_path }
import extdeps.tools.stat { stat_program }
import extdeps.systemd.systemctl { systemctl_user_manager_probe_command }
