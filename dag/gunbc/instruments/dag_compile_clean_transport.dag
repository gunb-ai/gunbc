module tools.dag_compile_clean_transport

import extdeps.shell
import extdeps.filesystem.filesystem_io
import extdeps.git
import extdeps.git.inspect
import extdeps.gunbc
import gunbc.ci_gate {
  GateReceipt, GateObserved, GateNotApplicable, GateNotRun, GateClean, GateFailed
}
import gunbc.ci_layer_roots { compile_clean_source_roots }
import gunbc.output_policy { ExpectFailure, ExpectSuccess }
import std.effect_grant { position_under }
import std.filesystem_path_grant { absolute_path_position }
import std.logic { Bool }
import std.types { NonEmptyStr }
import tools.host_prelude { witness_bin, witness_bin_ready, witness_bin_release_path }

// Compile-clean gate transports, typed. Each receipt is a composition of typed service operations
// (shell.Mktemp.Dir, Filesystem.Write, gunbc.WitnessBin.Run on the gunbc binary,
// shell.Remove.RecursiveForce) - no bash is serialized or executed. The former ShellProgram
// builders, their serialize-shape witnesses (shell_serializes_dcc_common_compile_invocation and the
// marker rows), and the two RealizationDispatch scaffold rows dissolved with the flip: the
// invocation facts are now carried by the typed args construction itself, so the spelling-drift
// class those witnesses validated is unwritable (DESIGN 5, construction over validation).

// Class C attribution (test-decomposition-wcf-cut.md, session nimble-ibex-483, 2026-07-25): run
// 30009199696 measured dag_compile_clean_perturb_receipts_holds at 53s; measured head ~141s — both
// are the SAME shape (four serial gunbc compile invocations each pulling
// compile_clean_source_roots: dag + src/v2 + src/v1). Per-compile wall grew with corpus size and
// the namespace-flip compile wall, NOT the #7205 per-entry fixture pipeline (Class F:
// fixture-shaped + slow by defect). Disposition Class C: mechanism RED arms (optional_skew,
// unresolved_import) need only a single-module fixture closure (dcc_fixture_only_compile_args);
// cross_tree_import and dag_shell_primary_precedence need the live-tree pool and ride
// falsifier_rehomed_bin_wet_entries.

// WHERE A SUBJECT IS STAGED. Every compile-clean transport writes its subject somewhere and hands
// that path to the compiler as --source-root. v1_compiler.cli_run refuses a primary source root
// that is not under the workspace root at the "root-admission" phase, BEFORE the subject, so a
// subject staged into the host temp namespace is never compiled at all. target/ is where this
// repository already keeps generated fixtures out of version control, and the root it hangs from is
// git.Inspect.Toplevel rather than a literal, so the staging path moves with the checkout.

fn dcc_staging_template(root: String, name: String) -> String {
  concat(root, concat("/target/", concat(name, "_XXXXXX")))
}

// The containment relation is std.effect_grant position_under over std.filesystem_path_grant
// absolute_path_position -- the one prefix authority the corpus already carries, segment-wise, so a
// sibling directory whose name merely shares a prefix with the root is not under it. It is asked
// here rather than inferred from the compiler's refusal text: cli_run's own consumer at
// v1_compiler.cli_run reads .contains("outside the workspace root"), and a second reader of that
// prose is a second authority for a relation that is decidable from the path alone.

fn dcc_staged_under_workspace(root: String, staged: String) -> Bool {
  position_under(
    target: absolute_path_position(path: staged),
    root: absolute_path_position(path: root)
  )
}

// THE REPORT COPRODUCT THE COMPILE-CLEAN TRANSPORTS FOLD TO, and the reason it is
// gunbc.ci_gate GateReceipt rather than a fresh sum: GateNotRun already means "the instrument did
// not arrive at its subject -- owner the instrument, remedy never 'fix the tree'", which is exactly
// refusal-before-subject, and that module hands back no Bool accessor, so a citing witness can only
// reach a verdict by matching the arm. Until this carrier landed these transports folded
// gunbc.WitnessBin.Run straight to a Bool, and a workspace-root admission refusal, a missing gunbc
// binary and a genuine subject verdict arrived at the citing report as the same Bool -- the
// instrument never reached its subject and the report read that as coverage.

fn dcc_refused_before_subject(cause: String) -> GateReceipt {
  GateNotRun { cause: cause as NonEmptyStr }
}

// AN ExpectFailure ARM CANNOT BE SATISFIED BY A REFUSAL-BEFORE-SUBJECT, by construction: the
// expectation is compared here, on the far side of the admission arms, so the only way to
// GateObserved is to have run the compiler over the staged subject. `met` is the expectation
// comparison, not the exit status -- a perturb expecting failure is GateClean when the subject
// refused.

fn dcc_subject_reached(met: Bool, detail: String) -> GateReceipt {
  if met {
    GateObserved { outcome: GateClean }
  } else {
    GateObserved { outcome: GateFailed { detail: detail as NonEmptyStr } }
  }
}

// Receipt-preserving conjunction: the first non-clean receipt is carried out whole, so a fold over
// several transports still names which one stopped and in whose vocabulary.

fn dcc_receipt_then(acc: GateReceipt, next: GateReceipt) -> GateReceipt {
  match acc {
    GateObserved { outcome: outcome } => match outcome {
      GateClean => next
      GateFailed { detail: _ } => acc
    }
    GateNotApplicable { reason: _ } => acc
    GateNotRun { cause: _ } => acc
  }
}

fn dcc_source_root_args() -> List<String> {
  fold(compile_clean_source_roots(), init: [], f: (acc, r) => concat(acc, ["--source-root", r]))
}

fn dcc_compile_tail_args(out_dir: String) -> List<String> {
  concat(
    dcc_source_root_args(),
    [
      "--dependency-pool-index", "primary-precedence",
      "--output-dir", out_dir,
      "--target", "dag"
    ]
  )
}

fn dcc_clean_tree_compile_args(out_dir: String) -> List<String> {
  concat(["compile"], dcc_compile_tail_args(out_dir: out_dir))
}

fn dcc_perturb_compile_args(tmp: String) -> List<String> {
  concat(
    ["compile", "--source-root", tmp],
    dcc_compile_tail_args(out_dir: concat(tmp, "/out"))
  )
}

fn dcc_fixture_only_compile_args(tmp: String) -> List<String> {
  [
    "compile",
    "--source-root", tmp,
    "--output-dir", concat(tmp, "/out"),
    "--target", "dag",
    "--dependency-pool-index", "primary-precedence"
  ]
}

fn dcc_gunbc_ready(root: String) -> Bool {
  witness_bin_ready(root: root, bin: witness_bin(var_name: "GUNBC", bin_name: "gunbc"))
}

fn dcc_gunbc_path(root: String) -> String {
  witness_bin_release_path(root: root, bin_name: "gunbc")
}

// The clean-tree arm stages only an OUTPUT directory, never a source root, so no admission arm
// applies to it -- but a missing gunbc binary is still a state in which this instrument never
// reached its subject, and it used to arrive at the fold as the same false a dirty tree produces.

fn run_clean_tree_compile_typed() -> GateReceipt {
  let root = git.Inspect.Toplevel()
  if !dcc_gunbc_ready(root: root.path) {
    dcc_refused_before_subject(cause: concat(
      "gunbc release binary is not ready, so no clean-tree compile ran at ", root.path
    ))
  } else {
    let out = shell.Mktemp.DirWithTemplate(
      template: dcc_staging_template(root: root.path, name: "dcc_clean_tree_out")
    )
    if !out.success {
      dcc_refused_before_subject(cause: concat(
        "clean-tree output directory could not be created under the workspace root at ", root.path
      ))
    } else {
      let compile = gunbc.WitnessBin.Run(
        workdir: root.path,
        bin_path: dcc_gunbc_path(root: root.path),
        args: dcc_clean_tree_compile_args(out_dir: out.path)
      )
      let cleaned = shell.Remove.RecursiveForce(path: out.path)
      dcc_subject_reached(
        met: compile.success && cleaned.success,
        detail: concat("clean-tree compile over the witness layer roots did not complete; stderr: ", compile.stderr)
      )
    }
  }
}

// The name is unchanged and the return type is not: this used to answer Bool via
// consume_floor_compile_clean_gate_verdict, which folded five host states into false and the scope
// disposition's skip into true. The builtin behind it is now spelled
// install_or_consume_floor_compile_clean_gate_receipt, a spelling carrying a fact the old one hid
// -- under the executor's lazy-install arm the FIRST call here RUNS THE WHOLE-TREE COMPILE. The
// predecessor was spelled consume_ and documented as reading the receipt only, so nothing at this
// call site said a boolean read could cost a whole-tree compile.

fn run_clean_tree_compile() -> GateReceipt {
  install_or_consume_floor_compile_clean_gate_receipt()
}

data perturb_module_source: String = "module test.perturb_compile_clean_red\nfn probe() -> String? {\n  match Present { value: \"x\" } {\n    Some { value: s } => Some { value: s }\n    None => none\n  }\n}"

data cross_tree_green_module_source: String = "module test.perturb_compile_clean_cross_tree_green\nimport v2.std.logic { Bool }\nfn probe() -> Bool { True }"

data dag_shell_primary_module_source: String = "module test.perturb_compile_clean_dag_shell_primary\nimport extdeps.shell\nfn probe() -> String? {\n  shell.Env.Get(name: \"PATH\")\n}"

data perturb_fixture_green_module_source: String = "module test.perturb_compile_clean_fixture_green\nfn probe() -> Int { 42 }"

data unresolved_import_perturb_source: String = "module test.perturb_compile_clean_unresolved_import\nimport totally.nonexistent.module { Foo }\nfn probe() -> Int { 42 }"

// THE ADMISSION IS ASKED BEFORE THE SUBJECT IS WRITTEN, not after the compiler has answered.
// A staging path outside the workspace root produces a receipt that says so in the instrument's
// own vocabulary, and there is no route from that arm to an expectation being met: the
// ExpectFailure perturbs previously read the root-admission refusal as the refusal they were
// looking for.

fn dcc_perturb_compile_with_args(
  tmp_path: String,
  compile_args: List<String>,
  module_file: String,
  source: String,
  expect_success: Bool
) -> GateReceipt {
  let root = git.Inspect.Toplevel()
  if !dcc_staged_under_workspace(root: root.path, staged: tmp_path) {
    dcc_refused_before_subject(cause: concat(
      "perturb subject staged outside the workspace root, so the compiler refuses at root-admission before reaching it: ",
      tmp_path
    ))
  } else {
    let wrote = Filesystem.Write(
      path: concat(tmp_path, concat("/", module_file)),
      content: source
    )
    if !wrote.success {
      dcc_refused_before_subject(cause: concat(
        concat("perturb subject could not be written, so no compile ran over ", module_file),
        concat(" under ", tmp_path)
      ))
    } else {
      let compile = gunbc.WitnessBin.Run(
        workdir: root.path,
        bin_path: dcc_gunbc_path(root: root.path),
        args: compile_args,
        expect: if expect_success { ExpectSuccess } else { ExpectFailure }
      )
      let cleaned = shell.Remove.RecursiveForce(path: tmp_path)
      if compile.success == expect_success {
        dcc_subject_reached(
          met: cleaned.success,
          detail: concat("perturb staging could not be removed after the subject compiled: ", tmp_path)
        )
      } else {
        dcc_subject_reached(
          met: false,
          detail: concat(
            concat(module_file, ": compile verdict did not match the expectation; stderr: "),
            compile.stderr
          )
        )
      }
    }
  }
}

fn dcc_perturb_compile_expecting(module_file: String, source: String, expect_success: Bool) -> GateReceipt {
  let root = git.Inspect.Toplevel()
  if !dcc_gunbc_ready(root: root.path) {
    dcc_refused_before_subject(cause: concat(
      "gunbc release binary is not ready, so no compile ran over ", module_file
    ))
  } else {
    let tmp = shell.Mktemp.DirWithTemplate(
      template: dcc_staging_template(root: root.path, name: "dcc_perturb_corpus")
    )
    if !tmp.success {
      dcc_refused_before_subject(cause: concat(
        "perturb staging directory could not be created under the workspace root for ", module_file
      ))
    } else {
      dcc_perturb_compile_with_args(
        tmp_path: tmp.path,
        compile_args: dcc_perturb_compile_args(tmp: tmp.path),
        module_file: module_file,
        source: source,
        expect_success: expect_success
      )
    }
  }
}

fn dcc_fixture_perturb_compile_expecting(module_file: String, source: String, expect_success: Bool) -> GateReceipt {
  let root = git.Inspect.Toplevel()
  if !dcc_gunbc_ready(root: root.path) {
    dcc_refused_before_subject(cause: concat(
      "gunbc release binary is not ready, so no compile ran over ", module_file
    ))
  } else {
    let tmp = shell.Mktemp.DirWithTemplate(
      template: dcc_staging_template(root: root.path, name: "dcc_perturb_fixture")
    )
    if !tmp.success {
      dcc_refused_before_subject(cause: concat(
        "fixture staging directory could not be created under the workspace root for ", module_file
      ))
    } else {
      dcc_perturb_compile_with_args(
        tmp_path: tmp.path,
        compile_args: dcc_fixture_only_compile_args(tmp: tmp.path),
        module_file: module_file,
        source: source,
        expect_success: expect_success
      )
    }
  }
}

fn run_perturb_optional_skew_red_receipt() -> GateReceipt {
  dcc_perturb_compile_expecting(
    module_file: "_perturb_compile_clean_red.dag",
    source: perturb_module_source,
    expect_success: false
  )
}

fn run_perturb_unresolved_import_red_receipt() -> GateReceipt {
  dcc_perturb_compile_expecting(
    module_file: "_perturb_compile_clean_unresolved_import.dag",
    source: unresolved_import_perturb_source,
    expect_success: false
  )
}

fn run_perturb_optional_skew_fixture_red_receipt() -> GateReceipt {
  dcc_fixture_perturb_compile_expecting(
    module_file: "_perturb_compile_clean_red.dag",
    source: perturb_module_source,
    expect_success: false
  )
}

fn run_perturb_unresolved_import_fixture_red_receipt() -> GateReceipt {
  dcc_fixture_perturb_compile_expecting(
    module_file: "_perturb_compile_clean_unresolved_import.dag",
    source: unresolved_import_perturb_source,
    expect_success: false
  )
}

fn run_perturb_fixture_green_receipt() -> GateReceipt {
  dcc_fixture_perturb_compile_expecting(
    module_file: "_perturb_compile_clean_fixture_green.dag",
    source: perturb_fixture_green_module_source,
    expect_success: true
  )
}

fn run_cross_tree_import_green_receipt() -> GateReceipt {
  dcc_perturb_compile_expecting(
    module_file: "_perturb_compile_clean_cross_tree_green.dag",
    source: cross_tree_green_module_source,
    expect_success: true
  )
}

fn run_dag_shell_primary_precedence_receipt() -> GateReceipt {
  dcc_perturb_compile_expecting(
    module_file: "_perturb_compile_clean_dag_shell_primary.dag",
    source: dag_shell_primary_module_source,
    expect_success: true
  )
}

fn run_dag_compile_clean_gate_shell() -> GateReceipt {
  dcc_receipt_then(
    acc: dcc_receipt_then(
      acc: dcc_receipt_then(
        acc: dcc_receipt_then(
          acc: run_clean_tree_compile_typed(),
          next: run_perturb_optional_skew_red_receipt()
        ),
        next: run_perturb_unresolved_import_red_receipt()
      ),
      next: run_cross_tree_import_green_receipt()
    ),
    next: run_dag_shell_primary_precedence_receipt()
  )
}

// THE RED CONTROL FOR THIS CLASS, AND IT STAYS ENROLLED AFTER THE FIX (DESIGN 4b meta-obligation
// 4). It stages a module that WOULD compile green outside the workspace root on purpose, which is
// the state the four false greens were in, and it asserts BOTH halves of the agreement: the
// modeled containment relation must say the staged root is not under the workspace root, AND the
// compiler invoked over that same staged root must refuse. Asserting only the first would make
// dcc_staged_under_workspace a second, unchecked authority for a rule v1_compiler.cli_run owns;
// asserting only the second would be the message-string read this change exists to avoid. A
// HOST FAULT IS NOT A PASS HERE: in this control the expected answer IS the refused-before-subject
// arm, so a staging failure answers GateFailed instead, or the control would green on never having
// run. The closure is the single-module fixture one, so if the compiler ever ADMITTED an outside
// root this control would report that in seconds rather than paying a whole-tree compile.
//
// THE POSITIVE CONTROL IS run_perturb_fixture_green_receipt: the same module source, staged under
// the workspace root by dcc_staging_template, reaching the subject and compiling green. The pair
// is what makes the arm discriminating rather than permanently one-sided.

data dcc_outside_root_control_module_file: String = "_dcc_outside_workspace_root_control.dag"

fn dcc_outside_workspace_staging_red_control() -> GateReceipt {
  let root = git.Inspect.Toplevel()
  if !dcc_gunbc_ready(root: root.path) {
    dcc_subject_reached(
      met: false,
      detail: concat("outside-root control could not run: gunbc release binary is not ready at ", root.path)
    )
  } else {
    let outside = shell.Mktemp.Dir()
    if !outside.success {
      dcc_subject_reached(
        met: false,
        detail: "outside-root control could not create a staging directory outside the workspace root"
      )
    } else {
      let wrote = Filesystem.Write(
        path: concat(outside.path, concat("/", dcc_outside_root_control_module_file)),
        content: perturb_fixture_green_module_source
      )
      let compile = gunbc.WitnessBin.Run(
        workdir: root.path,
        bin_path: dcc_gunbc_path(root: root.path),
        args: dcc_fixture_only_compile_args(tmp: outside.path),
        expect: ExpectFailure
      )
      let cleaned = shell.Remove.RecursiveForce(path: outside.path)
      if !wrote.success || !cleaned.success {
        dcc_subject_reached(
          met: false,
          detail: concat("outside-root control could not stage or clean its subject at ", outside.path)
        )
      } else if dcc_staged_under_workspace(root: root.path, staged: outside.path) {
        dcc_subject_reached(
          met: false,
          detail: concat(
            "outside-root control staged a path the containment relation reports as under the workspace root: ",
            outside.path
          )
        )
      } else if compile.success {
        dcc_subject_reached(
          met: false,
          detail: concat(
            "the compiler ADMITTED a primary source root outside the workspace root, so the containment relation this transport asks no longer matches cli_run's admission: ",
            outside.path
          )
        )
      } else {
        dcc_refused_before_subject(cause: concat(
          "outside-root control: the staged root is not under the workspace root and the compiler refused before the subject: ",
          outside.path
        ))
      }
    }
  }
}
