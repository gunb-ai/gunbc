module gunbc.instruments.instrument_registry_emit

// THE EMITTER OF THE HOST'S INSTRUMENT TABLE.
//
// `src/v1/stage0/src/target_invocation_host.rs` dispatched an instrument by reading a table it
// authored itself: 62 rows spelling each instrument's subject — the entry path it evaluates, the
// wire function it calls, the census verb it runs — beside the label. The same subjects are declared
// once in `gunbc.instrument_targets` `instrument_bindings()`, and the host file's own header says the
// registry "mirrors" that module. A subject written in two places where the dispatch reads the
// unbound copy is the fork DESIGN §3 forbids: the row the host reads can go stale and nothing
// refuses, because the authority it mirrors is never consulted. This module renders the table FROM
// the authority, so the subject is named once and the host reads it.
//
// WHAT MOVES THROUGH HERE AND WHAT DOES NOT. The label, the producer variant and the payload strings
// (entry, function, verb word) come from the binding rows and nothing else; the source-root lists are
// the instruments' own facts in the same module. Deliberately NOT rendered: the `NativeServeProbe` and
// the `Millisecond` deadline, which the host already reads from `gunbc.instrument_targets` AT SPAWN
// (`native_serve_probe_if_entry`, `native_claim_deadline_if_entry`) — baking them into a committed
// table would add a second copy of a fact that is already read from its authority.
//
// AN UNRENDERABLE ARM REFUSES; IT DOES NOT FALL BACK. A producer arm with no host counterpart
// (`RequiredFloorProducer`, `BazelProducer`) renders a sentinel that cannot compile, and
// `expected_instrument_registry_generated_rs` refuses the emission when the sentinel appears — a loud
// error where a plausible line would have been fabricated (DESIGN §5).

import extdeps.bazel.label { PackageName }
import extdeps.languages.rust.string_literal { escape_rust_cooked_string_literal_body }
import gunbc.instrument_targets {
  InstrumentSourceRootsRow,
  bare_reference_channel_source_roots,
  behavioral_receipt_source_roots,
  emitted_crate_workspace_source_roots,
  heads_reading_differential_source_roots,
  instrument_bindings,
  instrument_source_roots_rows,
  self_host_source_roots,
  v2_native_cli_source_roots
}
import gunbc.native_census_verb { native_census_verb_word }
import gunbc.target_binding { TargetBinding, TargetProducer }
import std.types { List, NonEmptyStr, String }

// WHETHER THE TABLE COULD BE RENDERED, AND WHY NOT. A refusal carries the reason, so the artifact is
// never committed as a plausible file: the same contract `expected_v1_interpreter_dispatch_generated_rs`
// keeps with `V1InterpreterDispatchGenerationRefused`.
type InstrumentRegistryGeneration
  = InstrumentRegistryGenerated { content: String }
  | InstrumentRegistryGenerationRefused { reason: String }

// A SENTINEL, NOT A RENDERING. It never appears in a committed table because no binding row uses the
// two arms that produce it; if one ever does, the emission refuses above and, if the refusal were
// bypassed, the host fails to compile a variant named `__GUNBC_INSTRUMENT_ARM_UNRENDERABLE`.
data instrument_arm_unrenderable_sentinel: String = "TargetProducer::__GUNBC_INSTRUMENT_ARM_UNRENDERABLE"

// THE GENERATED FILE'S TEXT, RENDERED FROM THE BINDING ROWS. `Label` and `TargetProducer` are the
// host's carriers; every string that names a subject is escaped rather than interpolated, so no
// binding value can close the literal. The rows keep the roster's order, which is the model's order.
fn instrument_registry_generated_rs(bindings: List<TargetBinding>, source_roots: List<InstrumentSourceRootsRow>) -> String {
  concat(
    concat(
      "// Generated by gunbc instruments.instrument_registry_emit — do not hand-edit.\n",
      "// Authority: gunbc.instrument_targets instrument_bindings() and instrument_source_roots_rows().\n// The subject an instrument runs — its entry path, its wire function, its census verb — is declared\n// there once, and the host reads it here instead of mirroring it: regenerate rather than edit.\n// The `NativeServeProbe` and the native-claim deadline are NOT rendered here; the host reads them\n// from gunbc.instrument_targets at spawn.\n\nuse crate::cli_run::target_invocation_host::\{Label, TargetProducer};\n\n",
    ),
    concat(
      "pub fn instrument_registry_rows() -> Vec<(Label, TargetProducer)> \{\n    vec![\n",
      concat(
        bindings.map(b => concat(instrument_registry_row_rust(binding: b), ",\n")).join(""),
        "    ]\n}\n\n",
      ),
    ),
  )
}

fn instrument_registry_row_rust(binding: TargetBinding) -> String {
  concat(
    concat(
      "        (\n            Label {\n                package_segments: ",
      package_segments_rust(package: binding.target.package),
      concat(
        ",\n                target: ",
        concat(
          rust_string_literal(value: binding.target.target.name),
          ".to_string(),\n            },\n            ",
        ),
      ),
    ),
    concat(instrument_producer_rust(producer: binding.producer), ",\n        )"),
  )
}

fn package_segments_rust(package: PackageName) -> String {
  match package {
    RootPackage => "vec![]"
    PackagePath { segments } => string_list_rust(values: segments)
  }
}

// THE PRODUCER EXPRESSION, ARM BY ARM. The arm name is the host's variant name with the `Producer`
// suffix removed — one rule, stated here once, so no per-instrument Rust spelling survives in the
// model and none is hand-copied into the host.
fn instrument_producer_rust(producer: TargetProducer) -> String {
  match producer {
    SelfHostProducer => "TargetProducer::SelfHost"
    V2NativeCliProducer => "TargetProducer::V2NativeCli"
    V2NativeFrontierProducer => "TargetProducer::V2NativeFrontier"
    EmittedCrateWorkspaceProducer => "TargetProducer::EmittedCrateWorkspace"
    HeadsReadingDifferentialProducer => "TargetProducer::HeadsReadingDifferential"
    BehavioralReceiptPlanProducer => "TargetProducer::BehavioralReceiptPlan"
    BehavioralReceiptCensusProducer => "TargetProducer::BehavioralReceiptCensus"
    BehavioralReceiptSelftestProducer => "TargetProducer::BehavioralReceiptSelftest"
    CompileCleanDiagnosticCensusProducer => "TargetProducer::CompileCleanDiagnosticCensus"
    EvaluationStoreAddressExactHeadProducer => "TargetProducer::EvaluationStoreAddressExactHead"
    TypedGraphExclusiveBytesProducer => "TargetProducer::TypedGraphExclusiveBytes"
    TypedGraphExclusiveBytesFloorSubjectProducer => "TargetProducer::TypedGraphExclusiveBytesFloorSubject"
    PrimitiveEgressCensusProducer => "TargetProducer::PrimitiveEgressCensus"
    PrimitiveEgressCensusV2Producer => "TargetProducer::PrimitiveEgressCensusV2"
    PrimitiveEgressCensusDagProducer => "TargetProducer::PrimitiveEgressCensusDag"
    PrimitiveEgressCensusSeedProducer => "TargetProducer::PrimitiveEgressCensusSeed"
    RequiredLaneResolutionCensusProducer => "TargetProducer::RequiredLaneResolutionCensus"
    BareReferenceChannelOutcomeProducer => "TargetProducer::BareReferenceChannelOutcome"
    SelfHostBehavioralEquivalenceProducer => "TargetProducer::SelfHostBehavioralEquivalence"
    NativeCensusVerbProducer { verb } => concat(
      "TargetProducer::NativeCensusVerb \{\n                verb: ",
      concat(rust_string_literal(value: native_census_verb_word(v: verb)), ",\n            }"),
    )
    SelfHostFrontierProducer => "TargetProducer::SelfHostFrontier"
    GenericIdentityCensusProducer => "TargetProducer::GenericIdentityCensus"
    InterpolationHoleCensusProducer => "TargetProducer::InterpolationHoleCensus"
    SharedTypeLeafCollisionCensusProducer => "TargetProducer::SharedTypeLeafCollisionCensus"
    CardinalityRealizationProducer => "TargetProducer::CardinalityRealization"
    RegenRoundCostProducer => "TargetProducer::RegenRoundCost"
    NativeClaimProgramProducer { entry, deadline } => concat(
      "TargetProducer::NativeClaimProgram \{\n                entry: ",
      concat(rust_string_literal(value: entry), ",\n            }"),
    )
    NativeServeProgramProducer { entry, probe } => concat(
      "TargetProducer::NativeServeProgram \{\n                entry: ",
      concat(rust_string_literal(value: entry), ",\n            }"),
    )
    CliWireProgramProducer { entry, function } => concat(
      "TargetProducer::CliWireProgram \{\n                entry: ",
      concat(
        rust_string_literal(value: entry),
        concat(",\n                function: ", concat(rust_string_literal(value: function), ",\n            }")),
      ),
    )
    RequiredFloorProducer => instrument_arm_unrenderable_sentinel
    BazelProducer => instrument_arm_unrenderable_sentinel
  }
}

fn rust_string_literal(value: String) -> String {
  concat("\"", concat(escape_rust_cooked_string_literal_body(s: value), "\""))
}

// A Rust `Vec<String>` literal. The elements carry `.to_string()` because the host's carriers own
// owned strings; a bare `&str` list would not typecheck against `Label` or a roots function.
fn string_list_rust(values: List<String>) -> String {
  concat(
    "vec![",
    concat(values.map(v => concat(rust_string_literal(value: v), ".to_string()")).join(", "), "]"),
  )
}

// THE SOURCE-ROOT SUBJECTS. Which corpus an instrument measures is the instrument's own fact
// (`gunbc.instrument_targets` `*_source_roots`); the host hand-listed the same lists and read its own
// copies. Each row becomes the host's per-instrument function, so a missing row is a missing function
// — a compile failure rather than an empty list that quietly measures nothing.
fn instrument_source_roots_generated_rs(rows: List<InstrumentSourceRootsRow>) -> String {
  concat(
    "// THE INSTRUMENTS' MEASURED CORPORA, rendered from\n",
    concat(
      "// gunbc.instrument_targets instrument_source_roots_rows(). A row is the instrument's own fact;\n// the host looks it up instead of listing it.\n\n",
      rows.map(row => concat(source_roots_fn_rust(row: row), "\n")).join("\n"),
    ),
  )
}

fn source_roots_fn_rust(row: InstrumentSourceRootsRow) -> String {
  concat(
    concat("pub fn ", concat(row.name, "_source_roots() -> Vec<String> \{\n    ")),
    concat(string_list_rust(values: row.roots), "\n}"),
  )
}

fn expected_instrument_registry_generated_rs() -> InstrumentRegistryGeneration {
  let rows = instrument_source_roots_rows()
  let table = instrument_registry_generated_rs(bindings: instrument_bindings(), source_roots: rows)
  if table.contains(instrument_arm_unrenderable_sentinel) {
    InstrumentRegistryGenerationRefused {
      reason: "gunbc.instruments.instrument_registry_emit cannot render a producer arm that has no host variant; the binding row names an arm the host TargetProducer does not carry",
    }
  } else {
    InstrumentRegistryGenerated { content: concat(table, instrument_source_roots_generated_rs(rows: rows)) }
  }
}

// THE RENDERED TEXT FOR THE TOOLING THAT WRITES THE FILE. `gunbc run` prints a String value, so the
// artifact's bytes come out of this entry. It is the SAME rendering as
// `expected_instrument_registry_generated_rs`, unwrapped -- not a second emitter -- and a refusal
// comes out as text the writer refuses to commit, never as a plausible file.
fn instrument_registry_generated_text() -> String {
  match expected_instrument_registry_generated_rs() {
    InstrumentRegistryGenerated { content } => content
    InstrumentRegistryGenerationRefused { reason } => concat("REFUSED: ", reason)
  }
}
