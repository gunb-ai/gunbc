
module tools.generated_artifact_gate

import std.process { ProcessExit, ExitSuccess, exit_failure }
import extdeps.filesystem.filesystem_io { Filesystem }
import gunbc.ci_gate { gate_receipt_failure_detail }
import gunbc.generated_artifact {
  GeneratedArtifact,
  committed_generated_artifacts,
  artifact_path
}
import gunbc.generated_artifact_emit {
  ArtifactGenerated,
  ArtifactGenerationRefused,
  artifact_generate
}
import gunbc.generated_artifact_observation {
  observe_generated_artifact_population
}
import v2.std.algebra { fold_list, length }
import gunbc.generated_artifact_assessment {
  generated_artifact_population_findings,
  generated_artifact_population_findings_empty,
  generated_artifact_population_findings_rendered
}

fn exit_ok(e: ProcessExit) -> Bool {
  match e { ExitSuccess => true  _ => false }
}

// THE REMEDY IS PER FINDING, NOT PER RUN, AND REMOVING THE GLOBAL SENTENCE IS THE POINT. This body
// used to append one closing instruction to every nonempty population -- do not hand-edit,
// regenerate via main_wet -- which is correct for a content difference and WRONG for every other
// class the carrier distinguishes. An expected observation that is missing means the observer or
// the population producer is incomplete and NOTHING was adjudicated for that artifact; regenerating
// cannot fix it and greening it that way would hide the completeness defect. An unknown observation
// means the registry and the tree disagree about whether the artifact should be committed at all,
// and DESIGN records the receipt for taking that instruction literally: this gate's first red
// included a markdown file DELETED ON PURPOSE by a commit whose entire subject was that the .dag
// carrier is the authority, and regenerating would have enforced the reverse of a decision already
// taken, permanently and silently. An extra-validation failure is a defect in the generated bytes
// themselves, so regeneration reproduces it. A carrier or generator refusal names an authority to
// repair and reached no verdict at all. One sentence sending all of them to main_wet is the
// absorbing fallback in remediation form -- a single widening arm standing where a typed, per-class
// answer was already available in the findings carrier -- so each rendered finding now carries its
// own remedy and the run-level sentence is gone. The producer is still named where it IS the
// remedy; it is simply no longer the default for classes it cannot repair.

// One live pass: observe_generated_artifact_population() reads each committed file and generates
// each artifact exactly once (gunbc.generated_artifact_observation). The pure group and leaf
// assessments, and the failure diagnostic, all read that SAME retained population — no
// re-invocation of the producer (operator ruling: cost and correctness must not ride on incidental
// memoization of a repeated producer call).

func run_generated_artifact_drift_gate_body() -> ProcessExit {
  let observations = observe_generated_artifact_population()
  let findings = generated_artifact_population_findings(expected: committed_generated_artifacts(), observations: observations)
  let all_ok = generated_artifact_population_findings_empty(f: findings)
  let reason = if all_ok {
    ""
  } else {
    concat("generated-artifact agreement failed: ", generated_artifact_population_findings_rendered(f: findings))
  }
  if all_ok {
    record_generated_artifact_drift_gate_clean()
  } else {
    record_generated_artifact_drift_gate_failure_detail(detail: reason)
  }
  return if all_ok {
    ExitSuccess
  } else {
    exit_failure(reason: reason)
  }
}

func main() -> ProcessExit {
  run_generated_artifact_drift_gate_body()
}

func run_generated_artifact_drift_gate() -> ProcessExit {
  run_generated_artifact_drift_gate_body()
}

// The loudness half: the floor witness collapses this gate's ProcessExit to Bool via
// tools.ci_gates.exit_ok, so a generated-artifact drift red reported only returned Bool(false)
// without the located path. The gate body records the reason from its single
// observe_generated_artifact_population pass; the failure-receipt companion consumes that retained
// detail instead of re-observing. THE BODY NOW RECORDS THE CLEAN SIDE TOO, and that is the whole
// point of the change rather than a tidy-up. Before it, only the FAILING side wrote, so the
// global's unset state carried two facts at once -- the body ran and found no drift, and the body
// never ran in this process -- and the companion papered the second over with the fabricated prose
// 'gate body did not run in this process' handed back as if it were a drift detail. Nothing
// downstream could tell an unguarded run from a clean one, which is DESIGN's execution-provenance
// rule exactly: a stage that can prevent an observation from executing must participate in the
// observation carrier, so refused-before-observing cannot inhabit the same state as
// observed-nothing. Recording the clean side is what makes GateNotRun mean only the thing it says.

fn generated_artifact_drift_failure_reason(exit: ProcessExit) -> String {
  match exit {
    ExitSuccess => ""
    ExitFailure { code: _, reason: reason } => reason
  }
}

func generated_artifact_drift_failure_receipt() -> String {
  gate_receipt_failure_detail(r: consume_generated_artifact_drift_gate_receipt())
}

// REGENERATING ONE ARTIFACT, AS A PROJECTION OF main_wet'S ROSTER AND NEVER A SECOND ROSTER.
//
// WHY IT EXISTS, AND IT IS NOT THE REASON I FIRST WROTE HERE. The first draft of this paragraph
// said the whole-roster fold had outgrown the sanctioned remote executor and that a smaller fold
// would fit. The first half is true; THE SECOND IS FALSE AND WAS MEASURED FALSE BEFORE THIS
// LANDED, which is why the corrected version is recorded rather than the tidy one.
//
// THE CEILING, stated at the grain that is actually true (by polling VmHWM to completion):
//   main_wet      -- all 35 artifacts -- peak RSS 7.55 GiB   (2026-08-31)
//   main_wet_one  -- exactly one      -- peak RSS 8.37 GiB   (2026-09-01, SUPERSEDES 7.54)
//   ctrl-build --remote runner VM     -- 7.86 GB TOTAL       (= 7.32 GiB)
//
// THE ONE-ARTIFACT FIGURE ROSE 0.83 GiB IN ONE DAY AND THE OLD ONE IS NOT AMENDED IN PLACE,
// because a ceiling that moves with the corpus is a different fact from a ceiling that was
// mismeasured, and only the dated pair shows which this is. 8.37 GiB was measured on
// 2026-09-01 by the same method as the row above it -- polling VmHWM, the kernel's own
// high-water mark, to completion -- so the two are comparable and the growth is real rather
// than an artifact of instrumentation. Re-derive it rather than trusting it: the poller is
// two lines of shell over /proc/<pid>/status, and the figure belongs to the tree it was
// measured on.
//
// WHY THE SUPERSESSION MATTERS MORE THAN THE 0.83: at 7.54 against a 7.86 GB VM the margin
// reads as thin-but-conceivable, which invites the "maybe with a tighter budget setting"
// attempt whose only outcome is an rc=137 twenty minutes in. At 8.37 GiB against 7.32 GiB
// the requirement is a full gigabyte OUTSIDE the whole VM and the question stops being
// tempting. A documented ceiling that UNDERSTATES the measured peak is worse than an
// unmeasured one, because it gets cited as the reason a thing is safe to try -- the §4b
// decoration shape pointed at a resource limit rather than at a check.
//
// gunbc.memory_stall_refusal bounds the same runner class from the other two sides: a
// TRUTHFUL budget declaration thrashes without completing, an OVERSTATED one is SIGKILLed at
// rc=137. With this figure the honest range there is not merely narrow, it is EMPTY, and the
// remedy is a runner exposing a real cgroup limit rather than any value of the budget
// variable.
// Regenerating one artifact costs what regenerating thirty-five costs. The generation fold is NOT
// where the memory goes: the shared WHOLE-TREE RESOLUTION is, and every path reaching the
// generation stage pays it in full, so ROSTER SIZE IS NOT THE VARIABLE. main_wet is SIGKILLed on
// that executor (RUN_EXIT=137) at every GUNBC_MEMORY_BUDGET_BYTES setting -- that variable gates
// the governor's ENTRY refusal and does not cap live allocation -- and THIS ENTRY WOULD BE KILLED
// THERE TOO. It does not restore remote regeneration and must not be cited as doing so. What
// shrinks whole-tree resolution retires this ceiling; nothing in this function does.
//
// SO WHAT THIS IS ACTUALLY FOR, priced smaller than its first draft claimed: BLAST RADIUS.
// main_wet rewrites all 35 artifacts whatever you came for, so it can silently resurrect a file
// someone deliberately deleted, or sweep in drift from an unrelated model that happens to be stale
// in the working tree. Those arrive with no conflict and no author error. A route that writes
// exactly the artifact named removes that class wherever it runs, which is a property of the route
// and not of the executor -- so it survives the ceiling being fixed, or not being fixed.
//
// WHAT MAKES IT A PROJECTION RATHER THAN A FORK. It selects from `committed_generated_artifacts()`
// -- the same list main_wet folds -- keyed by `artifact_path`, and generates through the same
// `artifact_generate`. There is no second producer selection and no second roster to drift from,
// so an artifact reachable by main_wet is reachable here by construction and a new registry row
// needs no edit in this function. main_wet REMAINS the whole-roster authority.
//
// THE UNROSTED ARM REFUSES AND DOES NOT REGENERATE NOTHING QUIETLY. A path the registry does not
// carry is a typed, located refusal naming the path and the roster size, never exit zero having
// written no file -- which would be strictly worse than the all-or-nothing fold, because a silent
// no-op LOOKS like a successful regeneration and would be cited as one. That is the
// empty-observation-narrow and absorbing-fallback pair from DESIGN's roster, and the failure arm
// here refuses rather than widening or defaulting.
//
// THE AMBIGUOUS ARM IS NOT DEAD CODE, and it is why selection counts rather than stopping at the
// first hit. Two registry rows claiming one path is a real defect -- main_wet would write both and
// the last would win silently -- so this entry refuses instead of picking. A `fold_list` that
// short-circuited on the first match could not see the second and would have made the defect
// unobservable from here.
type ArtifactSelection
  = ArtifactSelected { artifact: GeneratedArtifact, matches: Int }
  | ArtifactSelectionEmpty { matches: Int }

fn artifact_selection_for_path(path: String) -> ArtifactSelection {
  fold_list(
    xs: committed_generated_artifacts(),
    empty: ArtifactSelectionEmpty { matches: 0 },
    cons: fn(acc, a) {
      if artifact_path(a: a) == path {
        match acc {
          ArtifactSelectionEmpty { matches: n } => ArtifactSelected { artifact: a, matches: n + 1 }
          ArtifactSelected { artifact: prior, matches: n } => ArtifactSelected { artifact: prior, matches: n + 1 }
        }
      } else {
        acc
      }
    }
  )
}

func main_wet_one(path: String) -> ProcessExit {
  match artifact_selection_for_path(path: path) {
    ArtifactSelectionEmpty { matches: _ } => exit_failure(
      reason: concat(
        concat("GeneratedArtifactPathUnrostered: no committed generated artifact is declared at ", path),
        concat(
          concat(" -- gunbc.generated_artifact committed_generated_artifacts carries ", length(xs: committed_generated_artifacts()) as String),
          " row(s), and this path is not one of them; regenerating nothing and reporting success would report a repair that did not happen"
        )
      )
    )
    ArtifactSelected { artifact: a, matches: n } =>
      if n > 1 {
        exit_failure(
          reason: concat(
            concat("GeneratedArtifactPathAmbiguous: ", path),
            " is claimed by more than one registry row, so which producer owns it is undecided here; main_wet would write both and silently keep the last"
          )
        )
      } else {
        match artifact_generate(a: a) {
          ArtifactGenerationRefused { reason } => exit_failure(reason: concat(concat("generation refused for ", path), concat(": ", reason)))
          ArtifactGenerated { content } => {
            let w = Filesystem.Write(path: path, content: content)
            if w.success { ExitSuccess } else { exit_failure(reason: concat(concat("write failed for ", path), concat(": ", w.error))) }
          }
        }
      }
  }
}

func main_wet() -> ProcessExit {
  fold(committed_generated_artifacts(), init: ExitSuccess, f: fn(acc, a) {
    if exit_ok(e: acc) {
      match artifact_generate(a: a) {
        ArtifactGenerationRefused { reason } => exit_failure(reason: concat(concat("generation refused for ", artifact_path(a: a)), concat(": ", reason)))
        ArtifactGenerated { content } => {
          let w = Filesystem.Write(path: artifact_path(a: a), content: content)
          if w.success { ExitSuccess } else { exit_failure(reason: concat(concat("write failed for ", artifact_path(a: a)), concat(": ", w.error))) }
        }
      }
    } else {
      acc
    }
  })
}
